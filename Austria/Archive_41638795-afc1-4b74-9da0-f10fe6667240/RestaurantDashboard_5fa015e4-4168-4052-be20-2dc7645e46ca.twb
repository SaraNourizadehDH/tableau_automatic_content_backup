      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_3838D978CE294D6A92E4183AF63CBA2F'>
            <properties context=''>
              <relation connection='bigquery.1r7armn075kjtv19h46161v5zspd' name='Custom SQL Query' type='text'>WITH&#13;
  pd_orders AS (&#13;
  SELECT&#13;
    pd_orders.global_entity_id,&#13;
    pd_orders.created_at_local,&#13;
    pd_orders.uuid AS order_id,&#13;
    pd_orders.vendor_code,&#13;
    pd_orders.code,&#13;
    pd_orders.is_valid_order,&#13;
    pd_orders.delivery_address_city,&#13;
    pd_orders.is_own_delivery AS is_od_delivery,&#13;
    products.title AS product_title,&#13;
    products.quantity AS product_quantity,&#13;
    products.price_local as product_price ,&#13;
    products.pd_product_id AS product_id,&#13;
    variations.master_category_title AS master_category&#13;
  FROM&#13;
    `fulfillment-dwh-production.pandata_curated.pd_orders` pd_orders&#13;
  LEFT JOIN&#13;
    UNNEST(pd_orders.products) products&#13;
  LEFT JOIN&#13;
    `fulfillment-dwh-production.pandata_curated.ctl_products` pd_products&#13;
  ON&#13;
    pd_products.uuid = products.pd_product_uuid&#13;
  LEFT JOIN&#13;
    UNNEST(pd_products.variations) variations&#13;
  WHERE&#13;
    pd_orders.created_date_utc &gt;&gt;= DATE_SUB(CURRENT_DATE,INTERVAL 2 MONTH)&#13;
    AND pd_orders.global_entity_id = &apos;MJM_AT&apos;),&#13;
  pd_vendor AS (&#13;
  SELECT&#13;
    pd_vendors.global_entity_id AS vendor_global_entity_id,&#13;
    pd_vendors.vendor_code,&#13;
    pd_vendors.name AS vendor_name,&#13;
    pd_vendors.adjusted_chain_name AS chain_name,&#13;
    pd_vendors.vertical_type,&#13;
    primary_cuisine&#13;
  FROM&#13;
    `dha---bi-485.prod_tables.vendor_info` AS pd_vendors&#13;
  LEFT JOIN&#13;
    `fulfillment-dwh-production.pandata_report.regional_eu__pd_vendors_agg_menus` AS pd_vendors_agg_menus&#13;
  ON&#13;
    pd_vendors_agg_menus.uuid = pd_vendors.uuid&#13;
  WHERE&#13;
    pd_vendors.global_entity_id = &apos;MJM_AT&apos;&#13;
    AND NOT is_test&#13;
    AND pd_vendors.is_active&#13;
  GROUP BY&#13;
    1,&#13;
    2,&#13;
    3,&#13;
    4,&#13;
    5,&#13;
    6)&#13;
SELECT&#13;
  date(created_at_local) as date,&#13;
  pd_orders.order_id,&#13;
  pd_vendor.vendor_name,&#13;
  pd_vendor.vendor_code,&#13;
  pd_vendor.chain_name,&#13;
  pd_orders.delivery_address_city,&#13;
  pd_vendor.vertical_type,&#13;
  pd_vendor.primary_cuisine,&#13;
  master_category,&#13;
  product_id,&#13;
  product_title,&#13;
  product_quantity,&#13;
  product_price&#13;
FROM&#13;
  pd_orders&#13;
LEFT JOIN&#13;
  pd_vendor&#13;
ON&#13;
  pd_vendor.vendor_code = pd_orders.vendor_code&#13;
WHERE&#13;
  is_valid_order</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
