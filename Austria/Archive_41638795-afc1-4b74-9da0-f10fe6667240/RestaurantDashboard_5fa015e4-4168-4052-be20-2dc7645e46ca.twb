      <aliases enabled='yes' />
      <column caption='# Payment Failures' datatype='integer' name='[# Successful Orders (copy)_4860509949189984257]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([payment_failures])' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0gz3oe20081quq14flomj1t8g5dx].[avg:food_rating:qk]&quot;' value='Food Rating' />
          <alias key='&quot;[federated.0gz3oe20081quq14flomj1t8g5dx].[sum:customers_reordered_90d:qk]&quot;' value='# Customers Reordered 90d' />
          <alias key='&quot;[federated.0gz3oe20081quq14flomj1t8g5dx].[usr:Calculation_883268526156328961:qk]&quot;' value='% Fail Rate (excl. payment)' />
        </aliases>
      </column>
      <column caption='Vendor Food Rating' datatype='real' name='[Calculation_1507298568547368962]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vendor_food])/sum([reviewed_order_code])' />
      </column>
      <column caption='Food Rating' datatype='real' name='[Calculation_2053782173598126080]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([food_rating])/SUM([reviewed_order_code])' />
      </column>
      <column caption='Acquisitions 2' datatype='integer' name='[Calculation_2280017690043359232]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ INCLUDE [vendor_code] : SUM([acquisition])}' />
      </column>
      <column caption='Exclude Last month' datatype='boolean' name='[Calculation_2280017690489622529]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[date_month]&lt;DATETRUNC(&apos;month&apos;,TODAY())' />
      </column>
      <column caption='Avg GFV €' datatype='real' name='[Calculation_3148649508179230721]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_gfv_eur]) / SUM([successful_orders])' />
      </column>
      <column caption='90 Day Reorder Rate' datatype='real' name='[Calculation_3148649508186959874]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([customers_reordered_90d])/SUM([active_customers])' />
      </column>
      <column caption='% Well-dispatch Rate' datatype='real' name='[Calculation_883268526155333632]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [vendor_group]=&apos;own_delivery&apos; THEN [well_dispatched_orders] end)/sum(IF [vendor_group]=&apos;own_delivery&apos; THEN [successful_orders] end)' />
      </column>
      <column caption='% Total Fail Rate ' datatype='real' name='[Calculation_883268526156328961]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([failed_orders])/Sum([total_orders])' />
      </column>
      <column caption='% Online Payment' datatype='real' name='[Calculation_883268526156849154]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Sum([orders_paid_online])/Sum([successful_orders])' />
      </column>
      <column caption='month' datatype='integer' name='[Calculation_883268526159429635]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='month([date_month])' />
      </column>
      <column caption='Avg Basket Size €' datatype='real' name='[Calculation_883268526166466564]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Sum([total_products_local])/Sum([successful_orders])' />
      </column>
      <column caption='complete month?' datatype='boolean' name='[Calculation_883268526189645829]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [date_month], TODAY()) &gt; 0' />
      </column>
      <column caption='Rider Rating' datatype='real' name='[Food Rating (copy) (copy) (copy)_2053782173617410051]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([rider_review])/SUM([reviewed_order_code])' />
      </column>
      <column caption='Service Rating' datatype='real' name='[Food Rating (copy) (copy)_2053782173617401858]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([service])/SUM([reviewed_order_code])' />
      </column>
      <column caption='Packaging Rating' datatype='real' name='[Food Rating (copy)_2053782173617393665]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([packaging])/SUM([reviewed_order_code])' />
      </column>
