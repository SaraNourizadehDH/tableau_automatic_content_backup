      <aliases enabled='yes' />
      <column caption='mCVR3 ' datatype='real' name='[Calculation_3211418409935159296]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL(SUM([checkout_views])/SUM([menu_views]) ) THEN 0 ELSE SUM([checkout_views])/SUM([menu_views]) END' />
      </column>
      <column caption='Checkout Views per Vendor' datatype='real' name='[Calculation_3211418409938792449]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([checkout_views])/COUNTD([vendor_code])' />
      </column>
      <column caption='List Views per Vendor' datatype='real' name='[Calculation_3211418409938919426]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([list_views])/COUNTD([vendor_code])' />
      </column>
      <column caption='Menu Views per Vendor' datatype='real' name='[Calculation_3211418409938984963]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([menu_views])/COUNTD([vendor_code])' />
      </column>
      <column caption='Transactions per Vendor' datatype='real' name='[Calculation_3211418409939083268]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([transactions])/COUNTD([vendor_code])' />
      </column>
