            <aggregation>Sum</aggregation>
            <contains-null>true</contains-null>
            <_.fcp.ObjectModelEncapsulateLegacy.true...object-id>[_4DB4B8709F664D8BB745CBAAF9FDABD7]</_.fcp.ObjectModelEncapsulateLegacy.true...object-id>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>delivery_fee_local</remote-name>
            <remote-type>5</remote-type>
            <local-name>[delivery_fee_local]</local-name>
            <parent-name>[Custom SQL Query]</parent-name>
