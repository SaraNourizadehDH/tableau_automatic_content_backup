      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0q3hjyk0ohilou13a3eew0305tvl].[diff:sum:delivery_fee_local:qk]&quot;' value='Change in Delivery Fees' />
