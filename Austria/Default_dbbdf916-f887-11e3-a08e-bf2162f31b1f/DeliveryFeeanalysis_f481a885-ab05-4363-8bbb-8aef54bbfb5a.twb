      <datasource-dependencies datasource='Parameters'>
        <column caption='Select Date Dimension' datatype='string' name='[created_date_local Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
          <calculation class='tableau' formula='&quot;Monthly&quot;' />
        </column>
      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_4DB4B8709F664D8BB745CBAAF9FDABD7'>
            <properties context=''>
              <relation connection='bigquery.09rwgq40r23ufo161ii2h0u7zmrz' name='Custom SQL Query' type='text'><![CDATA[WITH
  pd_orders AS (
  SELECT
    pd_orders.global_entity_id,
    pd_orders.country_name,
    pd_orders.delivery_address_city AS order_delivery_address_city,
    DATE_TRUNC(pd_orders.created_date_local,month) AS order_month,
    DATE_TRUNC(pd_orders.created_date_local,day) AS order_day,
    DATE_TRUNC(pd_orders.created_date_local,week(monday)) AS order_week,

    pd_orders.created_date_local,
    pd_orders.uuid AS order_uuid,
    pd_orders.id AS order_id,
    pd_orders.pd_vendor_uuid,
    dwho.analytical_customer_id,
    pd_orders.code,
    -- billable_flag.is_billable,
    pd_orders.is_valid_order,


    pd_orders.total_value_local,
    pd_orders.delivery_fee_local,
    pd_orders.delivery_fee_original_local,
    o.df_user_paid_excl_vat_eur AS  delivery_fee_eur,
    accounting.delivery_fee_plus_vat_eur,

    dwho.is_acquisition is_acquisition,
    pd_orders_agg_accounting.gmv_eur AS gmv_eur,
    pd_orders_agg_accounting.gfv_eur AS gfv_eur,
    pd_orders_agg_vouchers.voucher.voucher_code,
    longitude as order_longitude,
    latitude as order_latitude,

 
  
  FROM
    `fulfillment-dwh-production.pandata_curated.pd_orders` AS pd_orders

  LEFT JOIN
    `fulfillment-dwh-production.pandata_curated.pd_payment_types` AS pd_payment_types
  ON
    pd_payment_types.uuid = pd_orders.pd_payment_type_uuid
  LEFT JOIN
    `fulfillment-dwh-production.curated_data_shared_central_dwh.orders` dwho
  ON
    dwho.order_id=pd_orders.code
    AND dwho.global_entity_id=pd_orders.global_entity_id
    AND dwho.placed_at_local>>=DATE_SUB(current_date, INTERVAL 3 month)
    AND DATE(dwho.placed_at)>>=DATE_SUB(current_date, INTERVAL 3 month)
  LEFT JOIN
    `fulfillment-dwh-production.pandata_report.regional_eu__pd_orders_agg_accounting` AS pd_orders_agg_accounting
  ON
    pd_orders_agg_accounting.uuid = pd_orders.uuid
    AND pd_orders_agg_accounting.created_date_utc >>= DATE_SUB(CURRENT_DATE, INTERVAL 3 MONTH),
    unnest(accounting) as accounting
  LEFT JOIN
    `fulfillment-dwh-production.pandata_report.agg_orders_eu` o
  ON
    pd_orders.code=o.order_code AND pd_orders.global_entity_id=o.global_entity_id
  LEFT JOIN
    `fulfillment-dwh-production.pandata_report.regional_eu__pd_orders_agg_vouchers` AS pd_orders_agg_vouchers
  ON
    pd_orders_agg_vouchers.uuid = pd_orders.uuid
    AND pd_orders_agg_vouchers.created_date_utc >>= DATE_SUB(CURRENT_DATE, INTERVAL 3 MONTH)
  WHERE
    pd_orders.global_entity_id = 'MJM_AT'
    AND pd_orders.created_date_utc <<>>current_date
    AND o.created_date_utc >>= DATE_SUB(CURRENT_DATE, INTERVAL 3 MONTH)    
    AND pd_orders.created_date_utc >>= DATE_SUB(CURRENT_DATE, INTERVAL 3 MONTH)
    -- AND billable_flag.created_date_utc >>= DATE_SUB(CURRENT_DATE, INTERVAL 3 MONTH) 
    ),
  pd_vendors AS(
  SELECT
   
    pd_vendors.global_entity_id AS vendor_global_entity_id,
    pd_vendors.vendor_code,
    pd_vendors.uuid AS vendor_uuid,
    pd_vendors.chain_code,
    pd_vendors.name AS vendor_name,
    pd_vendors.chain_name,
    pd_vendors.vertical_type,
    pd_vendors.street AS restaurant_street,
    pd_vendors.city AS restaurant_city,
    pd_vendors.postal_code AS restaurant_zip,
    pd_vendors.longitude,
    pd_vendors.latitude,
    CASE    
      WHEN pd_vendors.name LIKE '%Donald%' THEN 'McDonalds'
      WHEN pd_vendors.chain_code IN ('cy1dd', 'ch5me', 'cs3hp', 'cv1yp', 'cv5kr', 'cd0mi', 'ce0wk', 'cv2oo', 'cd0fr', 'ch6oj', 'cl1ok', 'cu1op', 'ce6wv') THEN "GFS"
      WHEN pd_vendors.chain_code IN ('cy1zy',
      'cl4df',
      'cc9ca',
      'ck9yw',
      'cd7bo',
      'ch9xl',
      'cz4kc',
      'cu0yk',
      'ck0ke',
      'cr1dc',
      'cz1ez',
      'cq2ml',
      'cn3ne',
      'cp5wm',
      'co7cn',
      'cg6vv',
      'cd4bs',
      'cl9ie',
      'co3pl',
      'cb6lp',
      'ct3xv',
      'ck1uq',
      'cw4go',
      'cq6ba',
      'cx5dk',
      'cm9fx',
      'cg8dy',
      'cc3xc',
      'cq2jy',
      'cz3ny',
      'cf3rb') THEN "KA"
      WHEN pd_vendors.vendor_code IN ('gmeg', 'eebs', 'b3wh', 'cbw8', 'e9sq', 'ebyl', 'g381', 'hc65', 'hkvh', 'k7dc', 'k8wb', 'k824', 'lx8n', 'rg8k', 'ribz', 'tjnt', 'vbuy', 'xk9p', 'yypa', 'mpdw', 'tqo2', 'jqr4', 'llmj', 'hzi0', 'akoi', 'dt2k', 'jgy3', 'd0y1', 'k883', 'j4ss', 'kzrr', 'cn1x', 'v2gn', 'fqvv', 'thi6', 'txqq', 'uc6g', 'g0kq', 'o2ip', 'x975', 'ksa1', 'cewf', 'qa6f', 'l40v', 'uy3f', 'llxp', 'b9u3', 'hpz1', 'mwmn', 'edfk', 'ibf7') THEN "KA"
    ELSE
    sf_accounts.gmv_class
  END
    AS gmv_vendor_grade,
    CASE
      WHEN pd_vendors.name LIKE '%Donald%' THEN TRUE
    ELSE
    FALSE
  END
    AS is_mcdonalds,
    -- pd_vendors.is_key_account,
    sf_addresses.postal_code AS postal_code,
     delivery_type
  FROM
    `dha---bi-485.prod_tables.vendor_info` AS pd_vendors
  LEFT JOIN
    `fulfillment-dwh-production.pandata_curated.sf_accounts` AS sf_accounts
  ON
    sf_accounts.vendor_code=pd_vendors.vendor_code
    AND sf_accounts.global_entity_id=pd_vendors.global_entity_id,
    UNNEST(sf_accounts.addresses) AS sf_addresses
  WHERE
    pd_vendors.global_entity_id = 'MJM_AT'
    AND NOT is_test
    AND is_active
     AND sf_addresses.address_type LIKE "%Restaurant Address%"
     )
     ,
    

main_metrics as (
  SELECT
pd_orders.order_day,
  pd_orders.order_week,
  pd_orders.order_month,

  pd_orders.order_uuid,
  pd_orders.code,


    pd_orders.order_delivery_address_city,
  
    pd_orders.created_date_local as order_created_date,
    pd_orders.pd_vendor_uuid,
   analytical_customer_id,
    pd_orders.is_valid_order,


    pd_orders.total_value_local,
    pd_orders.delivery_fee_local,
    pd_orders.delivery_fee_original_local,
   delivery_fee_eur,
delivery_fee_plus_vat_eur,
    
is_acquisition,
gmv_eur,
gfv_eur,
voucher_code,
ST_DISTANCE(ST_GEOGPOINT(pd_orders.order_longitude, pd_orders.order_latitude), ST_GEOGPOINT(pd_vendors.longitude, pd_vendors.latitude)) as delivery_distance 
,
    pd_vendors.*,
 

    CASE
          WHEN pd_vendors.chain_code IN ("ct3xv") AND pd_vendors.restaurant_city NOT IN ("Wien", "Klagenfurt am Wörthersee", "Innsbruck", "Linz", "Salzburg", "Graz") THEN 2.9
          --- L'Osteria, Starbucks, Nordsee, Subway ---
          WHEN pd_vendors.chain_code IN ("co3pl", "cw4go", "cx5dk", "cm9fx") THEN 2.9
          --- Swing Kitchen, Le Burger (1 Store) ---
          WHEN pd_vendors.chain_code IN ("cg8dy") OR pd_vendors.vendor_code IN ("ormv") THEN 3.5
          --- Le Burger (all but 1 Store) ---
          WHEN pd_vendors.chain_code IN ("cb6lp") AND pd_vendors.vendor_code NOT IN ("ormv") THEN 3.9
          --- KFC (2 Stores) ---
          WHEN pd_vendors.vendor_code IN ("sv9d", "xef4") THEN 1.5
          --- KFC (All but 2 Stores), Vapiano, Fat Monk, Burger King ----
          WHEN pd_vendors.chain_code IN ("cp5wm", "cc3xc", "cq2ml", "ch9xl") AND NOT pd_vendors.vendor_code IN ("sv9d", "xef4") THEN 4
          --- MPreis ---
          WHEN pd_vendors.vendor_code IN ("yyl4") THEN 2.49
          --- OMV - VIVA Shop ---
          WHEN pd_vendors.vendor_code IN ("xiu2", "upt2") THEN 2.9
          --- Various Shops ---
          WHEN pd_vendors.vendor_code IN ("cdb9", "u0qa", "xjr1", "fq8g", "lut2", "aka5", "bojz", "xopy", "hs5o", "thmt", "df6j", "s5xm", "nz5q", "c2hl", "nt8c", "n872", "j01j", "cdfh") THEN 3.9
          --- Spar/Shell/bp Various Shops ---
          WHEN pd_vendors.vendor_code IN ("ybvg", "r1ww", "ru38", "uhw6", "gkln", "a77o", "xy6j") OR pd_vendors.chain_code IN ("cs9ao", "cl9ps", "cf0dy") THEN 4.9
          --- Shops ---
          WHEN pd_vendors.vertical_type IN ("drinks", "convenience", "delicatessen", "supermarket") AND pd_vendors.vendor_code NOT IN ("h6sc", "szo0", "aubr", "sj6z", "up5l", "pid5", "qpn4", "s9e1") AND pd_vendors.chain_code NOT IN ("cq8kt", "ca5ej", "cl2ad", "cu2kg", "ck2mk") THEN 3.9
          --- Dmart ---
          WHEN pd_vendors.vertical_type IN ("darkstores") THEN 2.99
          ------ GFS ------
          WHEN pd_vendors.vendor_code IN ("i43r", "cmrz", "cc8b", "qdfk", "gy2r", "xsx6", "vlh6", "gbh9", "x3q4", "mbp4", "r3id", "gn7v", "g9xt", "c7sb", "muww", "syee", "axd3") AND  ST_DISTANCE(ST_GEOGPOINT(pd_orders.order_longitude, pd_orders.order_latitude), ST_GEOGPOINT(pd_vendors.longitude, pd_vendors.latitude))  <<= 350 THEN 0
          WHEN pd_vendors.vendor_code IN ("i43r", "cmrz", "cc8b", "qdfk", "gy2r", "xsx6", "vlh6", "gbh9", "x3q4", "mbp4", "r3id", "gn7v", "g9xt", "c7sb", "muww", "syee", "axd3") AND ST_DISTANCE(ST_GEOGPOINT(pd_orders.order_longitude, pd_orders.order_latitude), ST_GEOGPOINT(pd_vendors.longitude, pd_vendors.latitude)) >> 350 AND ST_DISTANCE(ST_GEOGPOINT(pd_orders.order_longitude, pd_orders.order_latitude), ST_GEOGPOINT(pd_vendors.longitude, pd_vendors.latitude)) <<= 1800 THEN 0.99
          WHEN pd_vendors.vendor_code IN ("i43r", "cmrz", "cc8b", "qdfk", "gy2r", "xsx6", "vlh6", "gbh9", "x3q4", "mbp4", "r3id", "gn7v", "g9xt", "c7sb", "muww", "syee", "axd3") AND ST_DISTANCE(ST_GEOGPOINT(pd_orders.order_longitude, pd_orders.order_latitude), ST_GEOGPOINT(pd_vendors.longitude, pd_vendors.latitude)) >> 1800 THEN 1.49
          WHEN pd_vendors.vendor_code IN ("z4x2", "mbvu", "kytx", "bb5b", "rrin", "ze7f", "m8j4") THEN 0.49
          WHEN pd_vendors.chain_code IN ("cv2oo", "cl1ok", "cu1op", "cd0fr", "cv1yp", "cd0mi", "cv5kr", "cy1dd", "ch5me", "cp8da", "ce0wk", "ci1tb") AND pd_vendors.restaurant_city = "Wien" AND ST_DISTANCE(ST_GEOGPOINT(pd_orders.order_longitude, pd_orders.order_latitude), ST_GEOGPOINT(pd_vendors.longitude, pd_vendors.latitude)) <<= 350 THEN 0.99
          WHEN pd_vendors.chain_code IN ("cv2oo", "cl1ok", "cu1op", "cd0fr", "cv1yp", "cd0mi", "cv5kr", "cy1dd", "ch5me", "cp8da", "ce0wk", "ci1tb") AND restaurant_city = "Wien" AND ST_DISTANCE(ST_GEOGPOINT(pd_orders.order_longitude, pd_orders.order_latitude), ST_GEOGPOINT(pd_vendors.longitude, pd_vendors.latitude)) between 350 AND 1800 THEN 1.49
          
          WHEN pd_vendors.chain_code IN ("cv2oo", "cl1ok", "cu1op", "cd0fr", "cv1yp", "cd0mi", "cv5kr", "cy1dd", "ch5me", "cp8da", "ce0wk", "ci1tb") AND pd_vendors.restaurant_city = "Wien" AND ST_DISTANCE(ST_GEOGPOINT(pd_orders.order_longitude, pd_orders.order_latitude), ST_GEOGPOINT(pd_vendors.longitude, pd_vendors.latitude)) >> 1800 THEN 2.49
          WHEN pd_vendors.chain_code IN ("ch6oj", "cs3hp") AND restaurant_city = "Wien" AND ST_DISTANCE(ST_GEOGPOINT(pd_orders.order_longitude, pd_orders.order_latitude), ST_GEOGPOINT(pd_vendors.longitude, pd_vendors.latitude)) <<= 350 THEN 1.49
          WHEN pd_vendors.chain_code IN ("ch6oj", "cs3hp") AND pd_vendors.restaurant_city = "Wien" AND ST_DISTANCE(ST_GEOGPOINT(pd_orders.order_longitude, pd_orders.order_latitude), ST_GEOGPOINT(pd_vendors.longitude, pd_vendors.latitude)) between 350 And 1800 THEN 2.49

          WHEN pd_vendors.chain_code IN ("ch6oj", "cs3hp") AND restaurant_city = "Wien" AND ST_DISTANCE(ST_GEOGPOINT(pd_orders.order_longitude, pd_orders.order_latitude), ST_GEOGPOINT(pd_vendors.longitude, pd_vendors.latitude)) >> 1800 THEN 3.99
          WHEN pd_vendors.chain_code IN ("cv2oo", "cl1ok", "cu1op", "cd0fr", "cs3hp", "ch6oj", "cv1yp", "cd0mi", "cv5kr", "cy1dd", "ch5me", "cp8da", "ce0wk", "ci1tb") AND restaurant_city IN ("Graz", "Innsbruck", "Linz", "Salzburg", "Klagenfurt") AND ST_DISTANCE(ST_GEOGPOINT(pd_orders.order_longitude, pd_orders.order_latitude), ST_GEOGPOINT(pd_vendors.longitude, pd_vendors.latitude)) <<= 600 THEN 0.49
          WHEN pd_vendors.chain_code IN ("cv2oo", "cl1ok", "cu1op", "cd0fr", "cs3hp", "ch6oj", "cv1yp", "cd0mi", "cv5kr", "cy1dd", "ch5me", "cp8da", "ce0wk", "ci1tb") AND restaurant_city IN ("Graz", "Innsbruck", "Linz", "Salzburg", "Klagenfurt") AND ST_DISTANCE(ST_GEOGPOINT(pd_orders.order_longitude, pd_orders.order_latitude), ST_GEOGPOINT(pd_vendors.longitude, pd_vendors.latitude)) between 600 AND 1800 THEN 0.99
          WHEN pd_vendors.chain_code IN ("ch6oj", "cs3hp") AND restaurant_city = "Wien" AND ST_DISTANCE(ST_GEOGPOINT(pd_orders.order_longitude, pd_orders.order_latitude), ST_GEOGPOINT(pd_vendors.longitude, pd_vendors.latitude)) >> 1800 THEN 1.49
          WHEN chain_code IN ("cv2oo", "cl1ok", "cu1op", "cd0fr", "cv1yp", "cd0mi", "cv5kr", "cy1dd", "ch5me", "cp8da", "ce0wk", "ci1tb") AND restaurant_city NOT IN ("Wien", "Graz", "Innsbruck", "Linz", "Salzburg", "Klagenfurt") THEN 0.99
          --- Wien and Klagenfurt DBDF ---
          WHEN restaurant_city IN ("Wien", "Klagenfurt") AND ST_DISTANCE(ST_GEOGPOINT(pd_orders.order_longitude, pd_orders.order_latitude), ST_GEOGPOINT(pd_vendors.longitude, pd_vendors.latitude)) <<= 400 THEN 0.99
          WHEN restaurant_city IN ("Wien", "Klagenfurt") AND ST_DISTANCE(ST_GEOGPOINT(pd_orders.order_longitude, pd_orders.order_latitude), ST_GEOGPOINT(pd_vendors.longitude, pd_vendors.latitude)) between 400 AND  1900 THEN 2.49
          WHEN restaurant_city IN ("Wien") AND ST_DISTANCE(ST_GEOGPOINT(pd_orders.order_longitude, pd_orders.order_latitude), ST_GEOGPOINT(pd_vendors.longitude, pd_vendors.latitude)) between 1900 AND 2600 THEN 3.99
          WHEN restaurant_city IN ("Wien") AND ST_DISTANCE(ST_GEOGPOINT(pd_orders.order_longitude, pd_orders.order_latitude), ST_GEOGPOINT(pd_vendors.longitude, pd_vendors.latitude)) >> 2600 THEN 4.99
          WHEN restaurant_city IN ("Klagenfurt") AND ST_DISTANCE(ST_GEOGPOINT(pd_orders.order_longitude, pd_orders.order_latitude), ST_GEOGPOINT(pd_vendors.longitude, pd_vendors.latitude)) >> 1900 THEN 3.99
          --- Innsbruck, Linz and Salzburg DBDF ---
          WHEN restaurant_city IN ("Innsbruck", "Linz", "Salzburg") AND ST_DISTANCE(ST_GEOGPOINT(pd_orders.order_longitude, pd_orders.order_latitude), ST_GEOGPOINT(pd_vendors.longitude, pd_vendors.latitude)) <<= 1000 THEN 0.99
          WHEN restaurant_city IN ("Innsbruck", "Linz", "Salzburg") AND ST_DISTANCE(ST_GEOGPOINT(pd_orders.order_longitude, pd_orders.order_latitude), ST_GEOGPOINT(pd_vendors.longitude, pd_vendors.latitude)) between 1000 AND  1700 THEN 2.99
          WHEN restaurant_city IN ("Innsbruck", "Linz", "Salzburg") AND ST_DISTANCE(ST_GEOGPOINT(pd_orders.order_longitude, pd_orders.order_latitude), ST_GEOGPOINT(pd_vendors.longitude, pd_vendors.latitude)) >> 1700 THEN 3.99
          --- Graz DBDF ---
          WHEN restaurant_city IN ("Graz") AND ST_DISTANCE(ST_GEOGPOINT(pd_orders.order_longitude, pd_orders.order_latitude), ST_GEOGPOINT(pd_vendors.longitude, pd_vendors.latitude)) <<= 700 THEN 0.99
          WHEN restaurant_city IN ("Graz") AND ST_DISTANCE(ST_GEOGPOINT(pd_orders.order_longitude, pd_orders.order_latitude), ST_GEOGPOINT(pd_vendors.longitude, pd_vendors.latitude))between 700 AND  1700 THEN 1.99
          WHEN restaurant_city  IN ("Graz") AND ST_DISTANCE(ST_GEOGPOINT(pd_orders.order_longitude, pd_orders.order_latitude), ST_GEOGPOINT(pd_vendors.longitude, pd_vendors.latitude))>> 1700 THEN 2.49
          
          --- Tier 3 DF ---
          WHEN restaurant_city  NOT IN ("Wien", "Klagenfurt am Wörthersee", "Innsbruck", "Linz", "Salzburg", "Graz") THEN 1.9
        END AS expected_to_be_delivery_fee
  FROM
    pd_vendors
  LEFT JOIN
    pd_orders
  ON
    pd_vendors.vendor_uuid = pd_orders.pd_vendor_uuid
    AND pd_vendors.vendor_global_entity_id = pd_orders.global_entity_id
    -- AND pd_vendors.date_month = pd_orders.date_local
    )

    select * from main_metrics]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='Actual vs Expected Delivery Fee'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#e15759' fontsize='10'>Supposed to be delivery fee are Distance based delivery fee, without any free delivery campaigns</run>
            <run>Æ&#10;</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (curated_data_shared)' name='federated.0q3hjyk0ohilou13a3eew0305tvl' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Date Dimension' datatype='string' name='[created_date_local Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0q3hjyk0ohilou13a3eew0305tvl'>
            <column caption='vendor_grade_group' datatype='string' name='[Calculation_1010776696780087299]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ([vertical_type (group)]) = &apos;Dmart&apos; then&apos;N/A&apos;&#13;&#10;elseif([vertical_type (group)]) = &apos;LocalShops&apos; then &apos;N/A&apos;&#13;&#10;&#13;&#10;&#13;&#10;elseIF &#13;&#10;[gmv_vendor_grade] in (&apos;A&apos;,&apos;B&apos;,&apos;C&apos;,&apos;D&apos;) and [vertical_type (group)]=&apos;Restaurants&apos;&#13;&#10;&#13;&#10; then &apos;NonKA&apos;&#13;&#10;else [gmv_vendor_grade]end' />
            </column>
            <column caption='Orders ' datatype='integer' name='[Calculation_1010776696821399557]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([order_uuid])' />
            </column>
            <column caption='Avg.Del fee' datatype='real' name='[Calculation_1010776696828665863]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([delivery_fee_local])/[Calculation_1010776696821399557]' />
            </column>
            <column caption='Date Dim' datatype='string' name='[Calculation_1010776697091960844]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[created_date_local Parameter]&#13;&#10;WHEN  &apos;Daily&apos; THEN STR([order_day])&#13;&#10;WHEN &apos;Weekly&apos; THEN STR([order_week])&#13;&#10;WHEN &apos;Monthly&apos; THEN STR([order_month])&#13;&#10;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='% diff from Supposed to be DF' datatype='real' name='[Calculation_1010776697194508304]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1010776696828665863]-[Supposed to be delivery fee (copy)_1606377749927350273])/[Calculation_1010776696828665863]' />
            </column>
            <column caption='Avg. Supposed  Delivery Fees' datatype='real' name='[Supposed to be delivery fee (copy)_1606377749927350273]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([expected_to_be_delivery_fee])/[Calculation_1010776696821399557]' />
            </column>
            <column caption='Actual delivery fee (Gross)' datatype='real' name='[delivery_fee_local]' role='measure' type='quantitative' />
            <column datatype='string' name='[delivery_type]' role='dimension' type='nominal' />
            <column caption='Supposed to be delivery fee' datatype='real' name='[expected_to_be_delivery_fee]' role='measure' type='quantitative' />
            <column datatype='string' name='[gmv_vendor_grade]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[is_valid_order]' role='dimension' type='nominal' />
            <column-instance column='[order_month]' derivation='MDY' name='[md:order_month:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_1010776696780087299]' derivation='None' name='[none:Calculation_1010776696780087299:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1010776697091960844]' derivation='None' name='[none:Calculation_1010776697091960844:nk]' pivot='key' type='nominal' />
            <column-instance column='[delivery_type]' derivation='None' name='[none:delivery_type:nk]' pivot='key' type='nominal' />
