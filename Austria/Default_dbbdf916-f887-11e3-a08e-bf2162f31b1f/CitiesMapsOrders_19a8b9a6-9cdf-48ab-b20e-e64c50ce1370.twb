            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dha-logistics-dwh-access' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='pandata_curated' server-oauth='' username='sirinthip.narula@deliveryhero.at' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0ahvgbr16zk5lr12vpyzi132zbuk' name='Custom_SQL_Query' type='text'><![CDATA[WITH
  food_characteristics AS (
  SELECT
    v.vendor_code,
    MAX(IFNULL(LOWER(c.title) LIKE '%lunch%',
        FALSE)) is_lunch,
    MAX(IFNULL(LOWER(c.title) LIKE '%münzen%',
        FALSE)) is_muenzen,
    MAX(IFNULL(LOWER(c.title) LIKE 'deals',
        FALSE)) is_deal
  FROM
    `fulfillment-dwh-production.pandata_curated.pd_vendors` v
  LEFT JOIN
    UNNEST(v.food_characteristics) c
  WHERE
    v.global_entity_id='MJM_AT'
    AND v.is_active
  GROUP BY
    1 )
SELECT
  o.code,
  o.created_date_local,
  o.vendor_code,
  v.name,
  v.chain_name,
  o.delivery_address_postcode,
  o.delivery_address_city,
  oa.gmv_eur,
  CASE
    WHEN (v.has_delivery_type_vendor_delivery AND (v.has_delivery_type_partner_delivery OR v.has_delivery_type_platform_delivery )) THEN "Both MP & OD"
    WHEN v.has_delivery_type_partner_delivery THEN "OD : Partner Delivery"
    WHEN v.has_delivery_type_platform_delivery THEN "OD : Platform Delivery"
    WHEN v.has_delivery_type_vendor_delivery THEN "MP"
END
  AS delivery_type,
  fc.is_lunch,
  fc.is_muenzen,
  fc.is_deal,
  v.location.street,
  v.location.city vendor_city,
  o.delivery_time_in_minutes,
  dwho.is_acquisition,
  o.delivery_fee_local as actual_delivery_fee_local,
  o.delivery_fee_original_local as original_delivery_fee_local,
  v.location.postal_code as vendor_post_code
FROM
  `fulfillment-dwh-production.pandata_curated.pd_orders` o
JOIN
  `fulfillment-dwh-production.pandata_report.regional_eu__pd_orders_agg_accounting` oa
ON
  oa.uuid=o.uuid
  AND oa.created_date_utc<<>>current_date
JOIN
  `fulfillment-dwh-production.pandata_curated.pd_vendors` v
ON
  o.pd_vendor_uuid=v.uuid
LEFT JOIN
  `fulfillment-dwh-production.curated_data_shared_central_dwh.orders` dwho
ON
  dwho.order_id=o.code
  AND dwho.global_entity_id=o.global_entity_id
  AND date_trunc(dwho.placed_at_local,month) >>= date_sub(date_trunc(current_date,month), interval 3 month)
LEFT JOIN
  food_characteristics fc
ON
  fc.vendor_code = v.vendor_code

WHERE
  o.global_entity_id = 'MJM_AT'
  AND o.created_date_utc >>= '2021-06-01'
  AND DATE_TRUNC(o.created_date_utc,month) >>= DATE_SUB(DATE_TRUNC(current_date,month), INTERVAL 3 month)
  AND o.is_valid_order]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
