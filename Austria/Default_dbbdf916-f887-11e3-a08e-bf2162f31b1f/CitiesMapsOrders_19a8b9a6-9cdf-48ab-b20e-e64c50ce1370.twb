      <aliases enabled='yes' />
      <column caption='Total GMV' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[# Orders (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Sum([gmv_eur])' />
      </column>
      <column caption='% Total GMV' datatype='real' default-format='p0.0%' name='[% Orders (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[# Orders (copy)] / TOTAL([# Orders (copy)])'>
          <table-calc ordering-field='[federated.0t3kagt012hcxz16791zl025r8l0].[Calculation_813673857293438977]' ordering-type='Field' />
        </calculation>
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0t3kagt012hcxz16791zl025r8l0].[avg:delivery_time_in_minutes:qk]&quot;' value='Avg. Delivery Time' />
          <alias key='&quot;[federated.0t3kagt012hcxz16791zl025r8l0].[usr:Calculation1:qk:5]&quot;' value='% Orders' />
        </aliases>
      </column>
      <column caption='% Orders' datatype='real' default-format='p0.0%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_7024137739564228608] / TOTAL([Calculation_7024137739564228608])'>
          <table-calc ordering-field='[federated.0t3kagt012hcxz16791zl025r8l0].[Calculation_813673857293438977]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='Monthly' datatype='string' name='[Calculation_6072048573904076800]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(YEAR([created_date_local])) + &apos;-&apos; + STR(MONTH([created_date_local]))' />
      </column>
      <column caption='Date' datatype='string' datatype-customized='true' name='[Calculation_6072048573904580610]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Migrated Data Parameter] = &apos;Monthly&apos; THEN [Calculation_6072048573904076800]&#10;ELSEIF [Parameters].[Migrated Data Parameter] = &apos;Weekly&apos; THEN [Monthly (copy)_6072048573904224257]&#13;&#10;ELSEIF [Parameters].[Migrated Data Parameter] = &apos;Daily&apos; THEN [Weekly (copy)_1109574409080238080]&#10;END' />
      </column>
      <column caption='# Orders' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_7024137739564228608]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([code])' />
      </column>
      <column caption='PLZ (Delivery)' datatype='integer' datatype-customized='true' default-format='*0000' name='[Calculation_813673857293438977]' role='dimension' semantic-role='[ZipCode].[Name]' type='ordinal'>
        <calculation class='tableau' formula='INT(LEFT([delivery_address_postcode] + &apos;Z&apos;,4))' />
      </column>
      <column caption='# Restaurants' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_813673857333485572]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([vendor_code])' />
      </column>
      <column caption='unq_restaurant_id' datatype='string' name='[Calculation_813673857337184261]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([source_id]) + &quot;-&quot; + STR([vendor_code])' />
