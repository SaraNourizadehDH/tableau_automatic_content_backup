          <alias key='&quot;[federated.1hm4r490g2cbko16bkx1l1luq5z4].[pcdf:sum:successful_orders:qk]&quot;' value='Mjam' />
          <alias key='&quot;[federated.1hm4r490g2cbko16bkx1l1luq5z4].[pcto:sum:local_shops_succesfull_order:qk]&quot;' value='% Local Shops' />
          <alias key='&quot;[federated.1hm4r490g2cbko16bkx1l1luq5z4].[sum:successful_orders:qk]&quot;' value='# Mjam Successful Orders' />
        </aliases>
      </column>
      <column caption='vertical type' datatype='boolean' name='[Calculation_1440588950593429505]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Date View (copy)]= [vertical_type] or ([Parameters].[Date View (copy)]= &apos;all(excl. restaunts and darkstores)&apos; and [vertical_type] &lt;&gt; &apos;restaurants&apos; and [vertical_type] &lt;&gt; &apos;darkstores&apos;)' />
      </column>
      <column caption='no_darkstore' datatype='boolean' name='[Calculation_1440588950611832834]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[vertical_type] &lt;&gt; &apos;darkstores&apos;' />
      </column>
      <column caption='darkstore_param' datatype='boolean' name='[Calculation_1440588950616420356]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[vertical type param (copy)] = [Calculation_1440588950611832834]' />
      </column>
      <column caption='Monthly View' datatype='boolean' name='[Calculation_1819032049497518081]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1] = &apos;Monthly&apos;' />
      </column>
      <column caption='Restaurants' datatype='integer' name='[Calculation_5244723252404699137]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([vendor_code])' />
      </column>
      <column caption='Month Dim' datatype='string' name='[Calculation_5244723252409987076]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([activated_at_local]) &lt; DATE(&apos;2020-11-01&apos;) THEN &apos;Before November 2020&apos;&#10;ELSE DATENAME(&apos;month&apos;,[activated_at_local])+ &apos; &apos;+ STR(YEAR([activated_at_local])) END' />
      </column>
      <column caption='Orders % of Total' datatype='real' name='[Calculation_5244723252411834374]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ INCLUDE [Calculation_9851632077504519] : SUM(IF [Calculation_9851632077504519] THEN [successful_orders] END) } / { EXCLUDE [Calculation_9851632077504519]:SUM([successful_orders])}' />
      </column>
      <column caption='Test' datatype='integer' name='[Calculation_6890437115018375169]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, ATTR([activated_at_local]), WINDOW_MIN(ATTR([activated_at_local])))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Weekly' datatype='string' datatype-customized='true' default-format='*yyyy\ \Www' name='[Calculation_9851632071843842]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(YEAR([date_local])) + &apos; - &apos; + STR(datepart(&apos;week&apos;, [date_local]))' />
      </column>
      <column caption='Local Shop Indicator' datatype='boolean' name='[Calculation_9851632077504519]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([vertical_type] &lt;&gt; &apos;restaurants&apos;, True, False)' />
        <aliases>
          <alias key='false' value='Not Local Shop' />
          <alias key='true' value='Local Shop' />
        </aliases>
      </column>
      <column caption='Restaurant city' datatype='boolean' name='[Monthly View (copy)_626844786903437314]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[restaurant_city Parameter]= [restaurant_city]  or ([Parameters].[restaurant_city Parameter]=&apos;all cities&apos;)' />
      </column>
      <column caption='Acqisitions % of Total' datatype='real' name='[Orders % of Total (copy)_5244723252413845511]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ INCLUDE [Calculation_9851632077504519] : SUM(IF [Calculation_9851632077504519] THEN [acquisitions] END) } / { EXCLUDE [Calculation_9851632077504519]:SUM([acquisitions])}' />
      </column>
