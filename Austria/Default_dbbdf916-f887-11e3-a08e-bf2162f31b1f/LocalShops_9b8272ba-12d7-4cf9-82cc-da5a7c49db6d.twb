      <column caption='Hard Fail Orders' datatype='real' name='[Calculation_275423285724725248]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn([orders_failed_response])&#10;+zn([orders_failed_rejection])&#10;+zn([orders_failed_cancellation])&#10;+zn([orders_failed_transmission])&#10;+zn([orders_failed_delivery])&#10;+zn([orders_failed_other])' />
