      <column caption='KPI % Delta (t-14) (String)' datatype='string' default-format='p0.0%' name='[KPI % Delta (t-7) (String) (copy)]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [KPI % Delta (t-7) (copy)]&gt;=0 THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;+ &apos; &apos; &#13;&#10;+ str(round([KPI % Delta (t-7) (copy)]*100,1))&#13;&#10;+ &apos;%&apos;'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='KPI % Delta (t-7) (String)' datatype='string' default-format='p0.0%' name='[KPI % Delta (t-7) (copy 2)]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [KPI % Delta (t-1) (copy)]&gt;=0 THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;+ &apos; &apos; &#13;&#10;+ str(round([KPI % Delta (t-1) (copy)]*100,1))&#13;&#10;+ &apos;%&apos;'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='KPI % Delta (t-14)' datatype='real' name='[KPI % Delta (t-7) (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_315040906667212800] - LOOKUP([Calculation_315040906667212800],14))/LOOKUP([Calculation_315040906667212800],14)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='KPI (absolute change from previous) +' datatype='string' name='[KPI (absolute change from previous) + (copy)]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_831758559082790922] &gt;= 0 &#13;&#10;THEN &apos;▼&apos; + str(ROUND(abs(LOOKUP([Calculation_315040906667212800],-1) - [Calculation_315040906667212800]),1)) &#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='KPI (perc change from previous) +' datatype='string' name='[KPI (absolute change from previous) - (copy)]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_831758559082790922] &gt;= 0 THEN &apos;▼&apos; + str(round(100*abs(LOOKUP([Calculation_315040906667212800],-1) - [Calculation_315040906667212800])/ LOOKUP([Calculation_315040906667212800],-1),1)) +&apos;%&apos; END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='KPI (absolute change from previous) -' datatype='string' name='[KPI (copy 6)]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_831758559082790922] &lt; 0 THEN &apos;▲&apos; + str(ROUND(ABS(LOOKUP([Calculation_315040906667212800],-1) - [Calculation_315040906667212800]),1)) END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='KPI (perc change from previous) -' datatype='string' name='[KPI (perc change from previous) - (copy)]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_831758559082790922] &lt; 0 THEN &apos;▲&apos; + str(round(100*abs(LOOKUP([Calculation_315040906667212800],-1) - [Calculation_315040906667212800])/ LOOKUP([Calculation_315040906667212800],-1),1))+&apos;%&apos; END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='KPIs (String)' datatype='string' name='[KPIs (copy)]' role='measure' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN 1 THEN STR(INT(SUM([orders_succ])))&#10;WHEN 2 THEN STR(ROUND(SUM([gmv_eur]),0))&#10;WHEN 3 THEN STR(SUM([acquisitions]))&#10;WHEN 4 THEN STR(ROUND([Calculation_6991486614294159360]*100,2)) + &apos; %&apos; &#10;WHEN 5 THEN STR(ROUND([Fail Rate (copy)]*100,2)) + &apos; %&apos; &#10;WHEN 6 THEN STR(ROUND([Calculation_6991486614300471299],2))&#10;WHEN 7 THEN STR(ROUND([Calculation_6991486614294556673],2))&#10;WHEN 8 THEN STR(ROUND([AVG Delivery Distance (copy)],2))&#10;END' />
      </column>
      <column caption='MP Orders Succ %' datatype='real' name='[MP Orders Succ (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([OD Orders Succ (copy 2)])&#10;/&#10;sum([orders_succ])' />
      </column>
      <column caption='MP AOV' datatype='real' name='[OD AOV (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([OD GMV (copy 2)])&#10;/&#10;SUM([OD Orders Succ (copy 2)])' />
      </column>
      <column caption='MP GMV' datatype='real' name='[OD GMV (copy 2)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_dh_delivery] = FALSE THEN [gmv_eur] END' />
      </column>
      <column caption='OD AOV' datatype='real' name='[OD GMV (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Is Shopping GMV (copy)])&#10;/&#10;SUM([Calculation_5063805250367447048])' />
      </column>
      <column caption='MP Orders Succ' datatype='real' name='[OD Orders Succ (copy 2)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_dh_delivery] = FALSE THEN [orders_succ] END' />
      </column>
      <column caption='OD Orders Succ %' datatype='real' name='[OD Orders Succ (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_5063805250367447048])&#10;/ &#10;sum([orders_succ])' />
      </column>
      <column caption='Order Date (date_exclusion)' datatype='boolean' name='[Order Date (copy)]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#10;WHEN &quot;Exclude MTD&quot; THEN [order_date] &lt; DATETRUNC(&apos;month&apos;,NOW())&#10;WHEN &quot;Exclude WTD&quot; THEN [order_date] &lt; DATETRUNC(&apos;week&apos;,NOW())&#10;ELSE 1=1&#10;END' />
      </column>
      <column caption='Orders Succ Previous Period (d,w,m)' datatype='real' name='[Orders Succ (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([orders_succ]) / LOOKUP(SUM([orders_succ]), -1)) -1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Orders per shop (daily)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Orders per shop (monthly) (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_succ])/SUM([restaurants_online])' />
