    <worksheet name='Verticals Comparison (Monthly)'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Monthly Datasource' name='federated.1gcwrs80x0quv312e5t5x0n3caj3' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='vertical type param' datatype='string' name='[Date View (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;all(excl. restaunts and darkstores)&quot;'>
              <calculation class='tableau' formula='&quot;all(excl. restaunts and darkstores)&quot;' />
            </column>
            <column caption='Date View' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1gcwrs80x0quv312e5t5x0n3caj3'>
            <column caption='vetical type ' datatype='boolean' name='[Calculation_1794965943840374787]' role='dimension' type='nominal'>
