      <column caption='Current Month' datatype='date' name='[Calculation_1393301149576310786]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE({ FIXED :MAX(DATETRUNC(&apos;month&apos;,[date_local]))})' />
      </column>
      <column caption='no_darkstore' datatype='boolean' name='[Calculation_1440588950612275203]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[vertical_type] &lt;&gt; &apos;darkstores&apos;' />
      </column>
      <column caption='darkstore_param' datatype='boolean' name='[Calculation_1440588950617182213]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[vertical type param (copy)]=[Calculation_1440588950612275203]' />
      </column>
      <column caption='weekly ' datatype='string' name='[Calculation_1794965943828295680]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(YEAR([date_local])) + &apos; - &apos; + STR(WEEK([date_local]))' />
      </column>
      <column caption='vetical type ' datatype='boolean' name='[Calculation_1794965943840374787]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Date View (copy)]= [vertical_type] or ([Parameters].[Date View (copy)]= &apos;all(excl. restaunts and darkstores)&apos; and [vertical_type] &lt;&gt; &apos;restaurants&apos; and [vertical_type] &lt;&gt; &apos;darkstores&apos;)' />
      </column>
      <column caption='Monthly View' datatype='boolean' name='[Calculation_1819032049497518081]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1] = &apos;Monthly&apos;' />
      </column>
      <column caption='Orders % of Total' datatype='real' name='[Calculation_5244723252411834374]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ INCLUDE [Calculation_9851632077504519] : SUM(IF [Calculation_9851632077504519] THEN [successful_orders] END) } / { EXCLUDE [Calculation_9851632077504519]:SUM([successful_orders])}*100' />
      </column>
      <column caption='Local Shop Indicator' datatype='boolean' name='[Calculation_9851632077504519]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([vertical_type] &lt;&gt; &apos;restaurants&apos;, True, False)' />
        <aliases>
          <alias key='false' value='Not Local Shop' />
          <alias key='true' value='Local Shop' />
        </aliases>
      </column>
      <column caption='restaurant city: True' datatype='boolean' name='[Monthly View (copy)_626844786902507521]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[restaurant_city Parameter]= [restaurant_city]  or ([Parameters].[restaurant_city Parameter]=&apos;all cities&apos;)' />
      </column>
      <column caption='Acqisitions % of Total' datatype='real' name='[Orders % of Total (copy)_5244723252413845511]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ INCLUDE [Calculation_9851632077504519] : SUM(IF [Calculation_9851632077504519] THEN [acquisitions] END) } / { EXCLUDE [Calculation_9851632077504519]:SUM([acquisitions])}' />
      </column>
      <column caption='Monthly' datatype='string' datatype-customized='true' default-format='*yyyy-mm' name='[Weekly (copy)_9851632071933955]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(YEAR([date_local])) + &apos; - &apos; + STR(MONTH([date_local]))' />
      </column>
