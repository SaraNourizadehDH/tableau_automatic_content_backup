      </column>
      <column caption='Date - Logistics View Totals (w,m)' datatype='string' name='[Calculation_2896096096857677824]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 8] = 1, &#10;    str(datepart(&apos;year&apos;, datetrunc(&apos;week&apos;,[order_date]))) + &apos;-&apos; + &#10;        iif(len(str(datepart(&apos;week&apos;, datetrunc(&apos;week&apos;,[order_date])))) = 1, &apos;0&apos;+ str(datepart(&apos;week&apos;, datetrunc(&apos;week&apos;,[order_date]))), str(datepart(&apos;week&apos;, datetrunc(&apos;week&apos;,[order_date])))),&#10;IIF([Parameters].[Parameter 8] = 2, &#10;    str(datepart(&apos;year&apos;, datetrunc(&apos;month&apos;,[order_date]))) + &apos;-&apos; + &#10;        iif(len(str(datepart(&apos;month&apos;, datetrunc(&apos;month&apos;,[order_date])))) = 1, &apos;0&apos;+ str(datepart(&apos;month&apos;, datetrunc(&apos;month&apos;,[order_date]))), str(datepart(&apos;month&apos;, datetrunc(&apos;month&apos;,[order_date]))))&#10;,NULL))' />
      </column>
      <column caption='KPIs' datatype='real' name='[Calculation_315040906667212800]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN 1 THEN SUM([orders_succ])&#10;WHEN 2 THEN SUM([gmv_eur])&#10;WHEN 3 THEN SUM([acquisitions])&#10;WHEN 4 THEN [Calculation_6991486614294159360]&#10;WHEN 5 THEN [Fail Rate (copy)]&#10;WHEN 6 THEN [Calculation_6991486614300471299]&#10;WHEN 7 THEN [Calculation_6991486614294556673]&#10;WHEN 8 THEN [AVG Delivery Distance (copy)]&#10;END' />
      </column>
      <column caption='Date Filter' datatype='boolean' name='[Calculation_315040906681180165]' role='measure' type='nominal'>
        <calculation class='tableau' formula='LOOKUP(MAX([order_date]),0) &gt;= DATEADD(&apos;day&apos;,-7,ATTR({ FIXED : MAX([order_date])}))&#10;OR (LOOKUP(MAX([order_date]),0) &gt; DATEADD(&apos;day&apos;,-15,ATTR({ FIXED : MAX([order_date])})))&#10;AND (LOOKUP(MAX([order_date]),0) &lt; DATEADD(&apos;day&apos;,-13,ATTR({ FIXED : MAX([order_date])})))'>
          <table-calc ordering-type='Rows' />
