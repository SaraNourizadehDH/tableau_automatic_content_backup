            <column-instance column='[Weekly (copy)_9851632071933955]' derivation='None' name='[none:Weekly (copy)_9851632071933955:nk]' pivot='key' type='nominal' />
            <column datatype='integer' name='[successful_orders]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_5244723252411834374]' derivation='Sum' name='[sum:Calculation_5244723252411834374:qk]' pivot='key' type='quantitative' />
            <column-instance column='[local_shops_succesfull_order]' derivation='Sum' name='[sum:local_shops_succesfull_order:qk]' pivot='key' type='quantitative' />
            <column-instance column='[successful_orders]' derivation='Sum' name='[sum:successful_orders:qk]' pivot='key' type='quantitative' />
