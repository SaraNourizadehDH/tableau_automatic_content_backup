          <datasource-dependencies datasource='federated.1frejf80nvweoe157f6mn08w439s'>
            <column caption='AVG Delivery Time' datatype='real' name='[AVG Delivery Distance (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_delivery_time_in_mins])/SUM([count_delivery_time])' />
            </column>
            <column caption='Time at Restaurant' datatype='real' name='[Calculation_1698701521240838144]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_at_restaurant_m])/SUM([count_at_restaurant_m])' />
            </column>
            <column caption='Fail Rate' datatype='real' default-format='p0.0%' name='[Calculation_6991486614294159360]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_fail])/(SUM([orders_fail]) + SUM([orders_succ]))' />
            </column>
            <column caption='AVG Delivery Distance' datatype='real' name='[Calculation_6991486614294556673]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_delivery_distance_km])/SUM([count_delivery_distance])' />
            </column>
            <column caption='Average Basket Size' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6991486614300471299]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_eur])/SUM([orders_succ])' />
            </column>
            <column caption='% Stacked Orders' datatype='real' default-format='p0.0%' name='[Calculation_6991486614543507464]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_succ_stacked])/SUM([orders_succ])' />
            </column>
            <column caption='Fail Rate (Rejected)' datatype='real' default-format='p0.0%' name='[Fail Rate (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_failed_rejection])/(SUM([orders_fail]) + SUM([orders_succ]))' />
            </column>
            <column caption='Orders per shop (daily)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Orders per shop (monthly) (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_succ])/SUM([restaurants_online])' />
            </column>
