    <worksheet name='Orders'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#4e79a7'>Grocery &lt;Sheet Name&gt; </run>
            <run fontcolor='#000000'>+</run>
            <run fontcolor='#4e79a7'>Æ </run>
            <run fontcolor='#f28e2b'>Share of Total Orders</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='raw dmart - monthly' name='federated.1frejf80nvweoe157f6mn08w439s' />
          </datasources>
          <datasource-dependencies datasource='federated.1frejf80nvweoe157f6mn08w439s'>
            <column caption='% Grocery Order Share [Selected Brands]' datatype='real' default-format='p0.0%' name='[% Grocery Order Share (copy 4)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_6991486614301339653])/SUM([orders_succ])' />
            </column>
            <column caption='Date Filter (Last 6 full months)' datatype='boolean' name='[Calculation_315040906990862351]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[order_date] &lt; DATETRUNC(&apos;month&apos;,{FIXED : MAX([order_date])})&#10;AND [order_date] &gt;= DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-7,{FIXED : MAX([order_date])}))' />
            </column>
            <column caption='FIXED Successful Orders' datatype='real' name='[Calculation_5063805250092052486]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED DATETRUNC(&apos;month&apos;,[order_date]): SUM({ FIXED DATETRUNC(&apos;month&apos;,[order_date]), [source_id] : SUM([orders_succ])})}' />
            </column>
            <column caption='Is Shopping Orders Succ' datatype='real' name='[Calculation_6991486614301339653]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_shopping] = TRUE THEN [orders_succ] END' />
            </column>
            <column caption='% Grocery Order Share [DH]' datatype='real' default-format='p0.0%' name='[Calculation_6991486614301540358]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_6991486614301339653])/SUM([Calculation_5063805250092052486])' />
            </column>
            <column caption='Brand Name' datatype='string' name='[brand_name]' role='dimension' type='nominal' />
            <column caption='City' datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Is Dh Delivery' datatype='boolean' name='[is_dh_delivery]' role='dimension' type='nominal' />
            <column caption='Is Shopping' datatype='boolean' name='[is_shopping]' role='dimension' type='nominal' />
            <column-instance column='[order_date]' derivation='MY' name='[my:order_date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_315040906990862351]' derivation='None' name='[none:Calculation_315040906990862351:nk]' pivot='key' type='nominal' />
            <column-instance column='[brand_name]' derivation='None' name='[none:brand_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[city]' derivation='None' name='[none:city:nk]' pivot='key' type='nominal' />
            <column-instance column='[is_dh_delivery]' derivation='None' name='[none:is_dh_delivery:nk]' pivot='key' type='nominal' />
            <column caption='Order Date' datatype='datetime' name='[order_date]' role='dimension' type='ordinal' />
            <column caption='Orders Succ' datatype='real' name='[orders_succ]' role='measure' type='quantitative' />
            <column aggregation='Sum' caption='Source Id' datatype='integer' name='[source_id]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_6991486614301339653]' derivation='Sum' name='[sum:Calculation_6991486614301339653:qk]' pivot='key' type='quantitative' />
            <column-instance column='[order_date]' derivation='Month-Trunc' name='[tmn:order_date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[% Grocery Order Share (copy 4)]' derivation='User' name='[usr:% Grocery Order Share (copy 4):qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_6991486614301540358]' derivation='User' name='[usr:Calculation_6991486614301540358:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1frejf80nvweoe157f6mn08w439s].[:Measure Names]'>
            <groupfilter function='union' user:op='manual'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1frejf80nvweoe157f6mn08w439s].[usr:Calculation_6991486614301540358:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1frejf80nvweoe157f6mn08w439s].[usr:\% Grocery Order Share (copy 4):qk]&quot;' />
            </groupfilter>
          </filter>
          <filter class='categorical' column='[federated.1frejf80nvweoe157f6mn08w439s].[my:order_date:ok]' filter-group='15'>
