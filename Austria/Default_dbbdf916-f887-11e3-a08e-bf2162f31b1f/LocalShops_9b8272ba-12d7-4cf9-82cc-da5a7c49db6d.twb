      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1hm4r490g2cbko16bkx1l1luq5z4].[avg:Calculation_5244723252411834374:qk]&quot;' value=' % Local shops' />
