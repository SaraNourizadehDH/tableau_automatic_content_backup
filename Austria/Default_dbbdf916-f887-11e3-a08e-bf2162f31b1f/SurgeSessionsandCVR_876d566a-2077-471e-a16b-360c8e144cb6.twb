      <column caption='MCVR1 &lt;=100%' datatype='boolean' name='[CVR &lt;=100% (copy)_3260183981961695233]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if([Calculation_240098219299282946]&lt;= 1) then true else false end' />
      </column>
      <column caption='CVR (transaction/list loaded) %' datatype='real' name='[Calculation_240098219299000321]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([count_of_transaction])/sum([count_of_shop_list_loaded])' />
      </column>
      <column caption='MCVR1 (menu loaded/list loaded)%' datatype='real' name='[Calculation_240098219299282946]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([count_of_shop_menu_loaded])/&#13;&#10;sum([count_of_shop_list_loaded])' />
      </column>
      <column caption='CVR &lt;=100%' datatype='boolean' name='[Calculation_240098219305295877]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if([Calculation_240098219299000321]&lt;= 1) then true else false end' />
      </column>
      <column caption='Menu Attractiveness (transaction/menu loaded) %' datatype='real' name='[Calculation_3260183981960429568]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([count_of_transaction])/sum([count_of_shop_menu_loaded])' />
      </column>
      <column caption='MCVR2 (add to cart/menu loaded)%' datatype='real' name='[MCVR1 (menu loaded/list loaded)% (copy)_240098219299545091]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([count_of_add_cart_clicked])/&#13;&#10;sum([count_of_shop_menu_loaded])' />
      </column>
      <column caption='MCVR3 (Transaction/add to cart)% ' datatype='real' name='[MCVR2 (add to cart/menu loaded)% (copy)_240098219299815428]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([count_of_transaction])/&#13;&#10;sum([count_of_add_cart_clicked])' />
      </column>
