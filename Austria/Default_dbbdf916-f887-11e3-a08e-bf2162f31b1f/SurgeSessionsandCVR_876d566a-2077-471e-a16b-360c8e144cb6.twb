      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_7450C5CA0AEA4E12A72226B2838CD982'>
            <properties context=''>
              <relation connection='bigquery.0rugntc1nq9zve12pxput1tvczko' name='Custom SQL Query' type='text'>SELECT&#13;
  global_entity_id,&#13;
  date_utc,&#13;
  CASE&#13;
    WHEN LOWER(city) IN (&apos;wien&apos;) THEN &apos;Wien&apos;&#13;
    WHEN LOWER(city) IN (&apos;klagenfurt&apos;,&#13;
    &apos;klagenfurt am wörthsee&apos;) THEN &apos;Klagenfurt&apos;&#13;
  ELSE&#13;
  city&#13;
END&#13;
  AS city,&#13;
  CASE&#13;
    WHEN LOWER(city) IN (&apos;wien&apos;, &apos;klagenfurt&apos;, &apos;salzburg&apos;, &apos;innsbruck&apos;, &apos;graz&apos;, &apos;klagenfurt am wörthsee&apos;, &apos;linz&apos;) THEN &apos;top 5&apos;&#13;
  ELSE&#13;
  &apos;others&apos;&#13;
END&#13;
  AS city_category,&#13;
  platform_type,&#13;
  channel_grouping,&#13;
  sessions,&#13;
  sessions_new,&#13;
  transactions,&#13;
  mcvr1_sum,&#13;
  mcvr1_count,&#13;
  mcvr2_sum,&#13;
  mcvr2_count,&#13;
  mcvr3_sum,&#13;
  mcvr3_count,&#13;
  mcvr4_sum,&#13;
  mcvr4_count&#13;
FROM&#13;
  `fulfillment-dwh-production.pandata_report.regional_eu__sessions_cvr`&#13;
WHERE&#13;
  date_utc &gt;&gt;= DATE_SUB(current_date,INTERVAL 5 month)&#13;
  AND global_entity_id = &apos;MJM_AT&apos;</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
