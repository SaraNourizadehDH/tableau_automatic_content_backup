    <datasource caption='regional_eu__sessions_cvr (pandata_report)' inline='true' name='federated.0he3bax0m5uxy012xa4f21e04tfm' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0rugntc1nq9zve12pxput1tvczko'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhh---analytics-eu' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='pandata_report' server-oauth='' username='sirinthip.narula@foodora.at' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0rugntc1nq9zve12pxput1tvczko' name='Custom SQL Query' type='text'>SELECT&#13;
  global_entity_id,&#13;
  date_utc,&#13;
  CASE&#13;
    WHEN LOWER(city) IN (&apos;wien&apos;) THEN &apos;Wien&apos;&#13;
    WHEN LOWER(city) IN (&apos;klagenfurt&apos;,&#13;
    &apos;klagenfurt am wörthsee&apos;) THEN &apos;Klagenfurt&apos;&#13;
  ELSE&#13;
  city&#13;
END&#13;
  AS city,&#13;
  CASE&#13;
    WHEN LOWER(city) IN (&apos;wien&apos;, &apos;klagenfurt&apos;, &apos;salzburg&apos;, &apos;innsbruck&apos;, &apos;graz&apos;, &apos;klagenfurt am wörthsee&apos;, &apos;linz&apos;) THEN &apos;top 5&apos;&#13;
  ELSE&#13;
  &apos;others&apos;&#13;
END&#13;
  AS city_category,&#13;
  platform_type,&#13;
  channel_grouping,&#13;
  sessions,&#13;
  sessions_new,&#13;
  transactions,&#13;
  mcvr1_sum,&#13;
  mcvr1_count,&#13;
  mcvr2_sum,&#13;
  mcvr2_count,&#13;
  mcvr3_sum,&#13;
  mcvr3_count,&#13;
  mcvr4_sum,&#13;
  mcvr4_count&#13;
FROM&#13;
  `fulfillment-dwh-production.pandata_report.regional_eu__sessions_cvr`&#13;
WHERE&#13;
  date_utc &gt;&gt;= DATE_SUB(current_date,INTERVAL 5 month)&#13;
  AND global_entity_id = &apos;MJM_AT&apos;</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0rugntc1nq9zve12pxput1tvczko' name='Custom SQL Query' type='text'>SELECT&#13;
