    <worksheet name='Shrinkage'>
      <layout-options>
        <title>
          <formatted-text>
            <run>% Time Shrinkage</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='bq log dashboard' name='federated.1p1ar821eg4i3w11cnco5194vebr' />
          </datasources>
          <datasource-dependencies datasource='federated.1p1ar821eg4i3w11cnco5194vebr'>
            <column caption='% Time Shrinkage' datatype='real' name='[% Time Closure (copy)_644014770191872004]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM([event_duration_min_shrink_sum])/SUM([opening_duration_mins]), 0)' />
            </column>
            <column caption='Completed Orders' datatype='integer' name='[Calculation_801640756487987200]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_completed_sum])' />
            </column>
            <column datatype='string' name='[City (group)]' role='dimension' semantic-role='[City].[Name]' type='nominal'>
              <calculation class='categorical-bin' column='[city_name]' new-bin='true'>
                <bin default-name='false' value='&quot;Wien&quot;'>
                  <value>&quot;Wien&quot;</value>
                  <value>&quot;Wien transdanube&quot;</value>
                </bin>
              </calculation>
            </column>
            <column-instance column='[zone_id]' derivation='Attribute' name='[attr:zone_id:qk]' pivot='key' type='quantitative' />
            <column caption='City' datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Event Duration Min Shrink Sum' datatype='integer' name='[event_duration_min_shrink_sum]' role='measure' type='quantitative' />
            <column-instance column='[promised_delivery_date]' derivation='MDY' name='[md:promised_delivery_date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[city_name]' derivation='None' name='[none:city_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[promised_delivery_date]' derivation='None' name='[none:promised_delivery_date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[promised_delivery_date]' derivation='None' name='[none:promised_delivery_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[zone_name]' derivation='None' name='[none:zone_name:nk]' pivot='key' type='nominal' />
            <column caption='Opening Duration Mins' datatype='integer' name='[opening_duration_mins]' role='measure' type='quantitative' />
            <column caption='Orders Completed Sum' datatype='integer' name='[orders_completed_sum]' role='measure' type='quantitative' />
            <column caption='Date' datatype='date' name='[promised_delivery_date]' role='dimension' type='ordinal' />
            <column-instance column='[% Time Closure (copy)_644014770191872004]' derivation='User' name='[usr:% Time Closure (copy)_644014770191872004:qk]' pivot='key' type='quantitative' />
