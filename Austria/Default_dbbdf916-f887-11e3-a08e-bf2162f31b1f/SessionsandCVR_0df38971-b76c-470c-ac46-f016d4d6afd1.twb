      <table>
        <view>
          <datasources>
            <datasource caption='regional_eu__sessions_cvr (pandata_report)' name='federated.0he3bax0m5uxy012xa4f21e04tfm' />
          </datasources>
          <datasource-dependencies datasource='federated.0he3bax0m5uxy012xa4f21e04tfm'>
            <column caption='CVR%' datatype='real' name='[Calculation_1262696806844182528]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([transactions])/sum([sessions])' />
