    <worksheet name='Shrinkage'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Shrinkage</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='bq log dashboard' name='federated.1p1ar821eg4i3w11cnco5194vebr' />
          </datasources>
          <datasource-dependencies datasource='federated.1p1ar821eg4i3w11cnco5194vebr'>
            <column caption='% Bike Deliveries' datatype='real' name='[% Car Deliveries (copy)_718605641877651466]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vehicle_name_bike_sum])/SUM([vehicle_profile_cnt])' />
            </column>
            <column caption='% Orders with CCR' datatype='real' name='[% Flawless Orders (copy)_-3249910051362148351]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_flawless_with_ccr_sum]) / SUM([orders_flawless_cnt])' />
            </column>
            <column caption='% Est. Lost Orders' datatype='real' name='[% Lost Orders - Closure (copy)_801640756515389456]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM([lost_order_total_sum])/(SUM([orders_completed_sum])+SUM([lost_order_total_sum])),0)' />
            </column>
            <column caption='% Order Early &gt; 10 min' datatype='real' default-format='p0.0%' name='[% Order Late &gt; 10 min (copy)_6688549192678993921]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_early_over_10_min_count])/SUM([order_early_cnt])' />
            </column>
            <column caption='% Vendor Late &gt; 10 min' datatype='real' name='[% Order Late &gt; 10 min (copy)_801640756491382792]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([late_vendor_over_10_min_count])/SUM([late_vendor_min_cnt])' />
            </column>
            <column caption='% Orders &gt; 45 min DT' datatype='real' default-format='p0.0%' name='[% Orders &gt; 35 min DT (copy)_4779585888010563584]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([actual_delivery_time_over_45_min_cnt]) / SUM([actual_delivery_time_cnt])' />
            </column>
            <column caption='% Time Surge' datatype='real' default-format='p0.0%' name='[% Time Closure (copy)_1460925515771506689]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM([event_duration_min_surge_sum])/SUM([opening_duration_mins]), 0)' />
            </column>
            <column caption='% Time Shrinkage' datatype='real' name='[% Time Closure (copy)_644014770191872004]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM([event_duration_min_shrink_sum])/SUM([opening_duration_mins]), 0)' />
            </column>
            <column caption='% Time Closure weighted' datatype='real' default-format='p0.0%' name='[% Time Closure (copy)_971299794523688963]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(&#10;&#10;        SUM([event_duration_min_close_sum] * (IFNULL([orders_completed_sum], 0)+IFNULL([lost_order_total_sum], 0)))&#10;        /&#10;        SUM([opening_duration_mins] * (IFNULL([orders_completed_sum], 0)+IFNULL([lost_order_total_sum], 0)))&#10;&#10;, 0)' />
            </column>
            <column caption='% Time Surge weighted' datatype='real' default-format='p0.0%' name='[% Time Closure weighted (copy)_1460925515771506688]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(&#10;&#10;        SUM([event_duration_min_surge_sum] * (IFNULL([orders_completed_sum], 0)+IFNULL([lost_order_total_sum], 0)))&#10;        /&#10;        SUM([opening_duration_mins] * (IFNULL([orders_completed_sum], 0)+IFNULL([lost_order_total_sum], 0)))&#10;&#10;, 0)' />
            </column>
            <column caption='% Time Shrinkage weighted' datatype='real' default-format='p0.0%' name='[% Time Closure weighted (copy)_971299794582712324]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(&#10;&#10;        SUM([event_duration_min_shrink_sum] * (IFNULL([orders_completed_sum], 0)+IFNULL([lost_order_total_sum], 0)))&#10;        /&#10;        SUM([opening_duration_mins] * (IFNULL([orders_completed_sum], 0)+IFNULL([lost_order_total_sum], 0)))&#10;&#10;, 0)' />
            </column>
            <column caption='% Rider Late &gt; 10 min' datatype='real' name='[% Vendor Late &gt; 10 min (copy)_801640756494004236]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([late_rider_over_10_min_count])/SUM([orders_completed_sum_excl_dmart])' />
            </column>
            <column caption='% Orders &gt; 35 min DT' datatype='real' default-format='p0.0%' name='[Calculation_-3249910051351425022]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([actual_delivery_time_over_35_min_cnt]) / SUM([actual_delivery_time_cnt])' />
            </column>
            <column caption='% Flawless Orders' datatype='real' default-format='p0.0%' name='[Calculation_-3249910051368525824]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_flawless_sum]) / SUM([orders_flawless_cnt])' />
            </column>
            <column caption='% Staffing Error' datatype='real' name='[Calculation_1188950346046930944]' role='measure' type='quantitative' visual-totals='Avg'>
              <calculation class='tableau' formula='SUM(IF [sum_riders_needed] &lt;&gt; 0 THEN [planned_hours] ELSE 0 END) &#10;    / &#10;    SUM([sum_riders_needed])&#10;    -1' />
            </column>
            <column caption='Worked Hours' datatype='real' name='[Calculation_1188950346721513474]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([worked_hours])' />
            </column>
            <column caption='% Idle Time' datatype='real' name='[Calculation_4047891688613019648]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([transition_working_time] - [transition_busy_time]) / SUM([transition_working_time])' />
            </column>
            <column caption='% Time Closure' datatype='real' name='[Calculation_644014770191142915]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM([event_duration_min_close_sum])/SUM([opening_duration_mins]), 0)' />
            </column>
            <column caption='Hold Back Time' datatype='real' name='[Calculation_644014770590052359]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([hold_back_time_min_sum])/SUM([hold_back_time_min_cnt])' />
            </column>
            <column caption='Rider Accepting Time' datatype='real' name='[Calculation_644014770590531592]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_accepting_time_min_sum])/SUM([rider_accepting_time_min_cnt])' />
            </column>
            <column caption='To Vendor Time' datatype='real' name='[Calculation_644014770593640457]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([to_vendor_time_min_sum])/SUM([to_vendor_time_min_cnt])' />
            </column>
            <column caption='At Vendor Time' datatype='real' name='[Calculation_644014770593787914]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([at_vendor_time_min_sum])/SUM([at_vendor_time_min_cnt])' />
            </column>
            <column caption='To Customer Time' datatype='real' name='[Calculation_644014770593878027]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([to_customer_time_min_sum])/SUM([to_customer_time_min_cnt])' />
            </column>
            <column caption='At Customer Time' datatype='real' name='[Calculation_644014770593959948]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([at_customer_time_min_sum])/SUM([at_customer_time_min_cnt])' />
            </column>
            <column caption='% Fill Rate' datatype='real' default-format='p0.0%' name='[Calculation_664914287980105729]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//sum([open_slots_assigned]) / sum([open_slots_size]) // old version (limited timeframe)&#10;&#10;SUM([planned_hours]) / (IFNULL(SUM([planned_hours]),0) + IFNULL(SUM([unassigned_hours]),0))' />
            </column>
            <column caption='% FC Error' datatype='real' name='[Calculation_718605641810001922]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_completed_sum]-[sum_orders_adjusted]+IFNULL([lost_order_total_sum], 0))/SUM([sum_orders_adjusted])' />
            </column>
            <column caption='% No-Shows' datatype='real' name='[Calculation_718605641825525764]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM([no_show_hours_total])/SUM([planned_hours]),0)' />
            </column>
            <column caption='Dropoff Distance' datatype='real' name='[Calculation_718605641855946758]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dropoff_distance_manhattan_sum])/SUM([dropoff_distance_manhattan_cnt])' />
            </column>
            <column caption='% Car Deliveries' datatype='real' name='[Calculation_718605641877299209]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vehicle_name_car_sum])/SUM([vehicle_profile_cnt])' />
            </column>
            <column caption='% Stacked Deliveries' datatype='real' name='[Calculation_718605641889554444]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([stacked_deliveries_sum])/SUM([stacked_deliveries_cnt])' />
            </column>
            <column caption='Completed Orders' datatype='integer' name='[Calculation_801640756487987200]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_completed_sum])' />
            </column>
            <column caption='% Cancelled Orders' datatype='real' name='[Calculation_801640756488503298]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_cancelled_sum])/SUM([orders_total])' />
            </column>
            <column caption='DT' datatype='real' name='[Calculation_801640756489674755]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([actual_delivery_time_sum])/SUM([actual_delivery_time_cnt])' />
            </column>
            <column caption='% Order Late &gt; 10 min' datatype='real' name='[Calculation_801640756490215429]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_delay_over_10_min_count])/SUM([order_delay_cnt])' />
            </column>
            <column caption='Est. Prep Time' datatype='real' name='[Calculation_801640756493324299]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([estimated_prep_time_min_sum])/SUM([estimated_prep_time_min_cnt])' />
            </column>
            <column caption='Bag Time' datatype='real' name='[Calculation_801640756495872013]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([bag_time_min_sum])/SUM([bag_time_min_cnt])' />
            </column>
            <column caption='UTR' datatype='real' name='[Calculation_801640756799496213]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_completed_sum]) / SUM([worked_hours])' />
            </column>
            <column caption='Log. Index' datatype='real' name='[Calculation_801640756819779606]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_801640756489674755]/[Calculation_801640756799496213]' />
            </column>
            <column caption='% Seamless Orders' datatype='real' default-format='p0.0%' name='[Calculation_971299794522877952]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([seamless_orders_seamless])/sum([seamless_orders_all])' />
            </column>
            <column caption='% Acceptance Rate' datatype='real' default-format='p0.0%' name='[Calculation_971299794523152385]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([deliveries_rider_accepted])/sum([deliveries_rider_notified])' />
            </column>
            <column caption='% Break Hours' datatype='real' default-format='p0.0%' name='[Calculation_971299794523381762]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([break_hours])/&#10;(ifnull(sum([worked_hours]),0) + ifnull(sum([break_hours]),0))' />
            </column>
            <column datatype='string' name='[City (group)]' role='dimension' semantic-role='[City].[Name]' type='nominal'>
              <calculation class='categorical-bin' column='[city_name]' new-bin='true'>
                <bin default-name='false' value='&quot;Wien&quot;'>
                  <value>&quot;Wien&quot;</value>
                  <value>&quot;Wien transdanube&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='PDT' datatype='real' name='[DT (copy)_801640756490010628]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([promised_delivery_time_sum])/SUM([promised_delivery_time_cnt])' />
            </column>
            <column caption='Vendor Late' datatype='real' name='[DT (copy)_801640756491694089]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([late_vendor_min_sum])/SUM([late_vendor_min_cnt])' />
            </column>
            <column caption='Pickup Distance' datatype='real' name='[Dropoff Distance (copy)_718605641857064967]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pickup_distance_manhattan_sum])/SUM([pickup_distance_manhattan_cnt])' />
            </column>
            <column caption='P-D Distance' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Pickup Distance (copy)_6688549192672563200]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_distance_sum])/SUM([delivery_distance_cnt])' />
            </column>
            <column caption='Rider Late' datatype='real' name='[Vendor Late (copy)_801640756491804682]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([late_rider_min_sum])/SUM([late_rider_min_cnt])' />
            </column>
            <column caption='Actual Delivery Time Cnt' datatype='integer' name='[actual_delivery_time_cnt]' role='measure' type='quantitative' />
            <column caption='Actual Delivery Time Over 35 Min Cnt' datatype='integer' name='[actual_delivery_time_over_35_min_cnt]' role='measure' type='quantitative' />
