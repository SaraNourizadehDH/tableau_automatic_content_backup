      <aliases enabled='yes' />
      <column caption='Avg DF user paid ' datatype='real' name='[Average DF original (copy)_632192864680128520]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([df_user_paid_incl_vat_eur])/sum([orders])' />
      </column>
      <column caption='Avg GMV ' datatype='real' name='[Average GFV original  (copy)_632192864664805381]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([gmv_eur])/sum([orders])' />
      </column>
      <column caption='Avg GMV user paid' datatype='real' name='[Average GMV  (copy)_632192864679702535]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([gmv_user_paid_eur])/sum([orders])' />
      </column>
      <column caption='% of user base ' datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([customers]) / TOTAL(SUM([customers]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% of customers' datatype='real' default-format='p0.00%' name='[Calculation3]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([customers]) / TOTAL(SUM([customers]))'>
          <table-calc ordering-type='RowInPane' />
        </calculation>
      </column>
      <column caption='% change of customers previous period' datatype='real' default-format='p0.00%' name='[Calculation4]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([customers])) - LOOKUP(ZN(SUM([customers])), -1)) / ABS(LOOKUP(ZN(SUM([customers])), -1))'>
          <table-calc ordering-type='RowInPane' />
        </calculation>
      </column>
      <column caption='threshold (2%)' datatype='real' name='[Calculation_1267200348433141766]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='0.02' />
      </column>
      <column caption='View Switched Dimension' datatype='real' name='[Calculation_1267200348709994503]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#13;&#10;when &apos;Avg delivery fee original&apos; then [Calculation_632192864664088579]&#13;&#10;when &apos;Avg delivery fee user paid&apos; then [Average DF original (copy)_632192864680128520]&#13;&#10;when &apos;Avg GMV&apos; then [Average GFV original  (copy)_632192864664805381]&#13;&#10;when &apos;Avg GMV user paid&apos; then [Average GMV  (copy)_632192864679702535]&#13;&#10;when  &apos;Customers&apos; THEN sum([customers])&#13;&#10;when &apos;Total GMV&apos; then sum([gmv_eur])&#13;&#10;when &apos;Total GMV user paid&apos; then sum([gmv_user_paid_eur])&#13;&#10;when &apos;Total Orders&apos; then sum([orders])&#13;&#10;when  &apos;Frequency&apos; then ([Calculation_1802284277010444288])&#13;&#10;end' />
      </column>
      <column caption='Frequency' datatype='real' name='[Calculation_1802284277010444288]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([orders])/sum([customers])' />
      </column>
      <column caption='Avg DF original' datatype='real' name='[Calculation_632192864664088579]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([df_original_incl_vat_eur])/sum([orders])' />
      </column>
      <column caption='Country' datatype='string' name='[Calculation_632192864672649222]' role='dimension' semantic-role='[Country].[Name]' type='nominal'>
        <calculation class='tableau' formula='&apos;Austria&apos;' />
      </column>
