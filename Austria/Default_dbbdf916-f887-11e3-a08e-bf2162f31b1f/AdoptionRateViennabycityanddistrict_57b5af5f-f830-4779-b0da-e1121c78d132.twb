      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_654AB64707604D4FB450D0FF8EF2F1E3'>
            <properties context=''>
              <relation connection='bigquery.1lvw1kl1ty4lec16j8uc71fhwhtz' name='Custom SQL Query' type='text'>SELECT &#13;
&#13;
*,&#13;
&#13;
case when &#13;
(sum(customers) over(partition by user_type,report_month,city,district)/sum(customers) over(partition by user_type,report_month))*100 &gt;&gt;=1 &#13;
then district &#13;
else &apos;other&apos; end as district_grouped&#13;
,&#13;
(sum(customers) over(partition by user_type,report_month,city,district)/sum(customers) over(partition by user_type,report_month))*100 as percent_of_user_base&#13;
&#13;
 FROM `dha---bi-485.report_tables.subscriber_adoption_citydistrict_kpi`</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
