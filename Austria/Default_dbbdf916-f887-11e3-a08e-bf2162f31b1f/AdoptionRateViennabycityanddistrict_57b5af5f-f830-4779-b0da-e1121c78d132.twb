        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1lvw1kl1ty4lec16j8uc71fhwhtz' name='Custom SQL Query' type='text'>SELECT &#13;
&#13;
*,&#13;
&#13;
case when &#13;
(sum(customers) over(partition by user_type,report_month,city,district)/sum(customers) over(partition by user_type,report_month))*100 &gt;&gt;=1 &#13;
then district &#13;
else &apos;other&apos; end as district_grouped&#13;
,&#13;
(sum(customers) over(partition by user_type,report_month,city,district)/sum(customers) over(partition by user_type,report_month))*100 as percent_of_user_base&#13;
&#13;
 FROM `dha---bi-485.report_tables.subscriber_adoption_citydistrict_kpi`</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1lvw1kl1ty4lec16j8uc71fhwhtz' name='Custom SQL Query' type='text'>SELECT &#13;
&#13;
*,&#13;
&#13;
case when &#13;
(sum(customers) over(partition by user_type,report_month,city,district)/sum(customers) over(partition by user_type,report_month))*100 &gt;&gt;=1 &#13;
then district &#13;
else &apos;other&apos; end as district_grouped&#13;
,&#13;
(sum(customers) over(partition by user_type,report_month,city,district)/sum(customers) over(partition by user_type,report_month))*100 as percent_of_user_base&#13;
&#13;
 FROM `dha---bi-485.report_tables.subscriber_adoption_citydistrict_kpi`</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
