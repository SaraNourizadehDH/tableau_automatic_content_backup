            <run fontcolor='#000000'> &amp; </run>
            <run fontcolor='#76b7b2'>Fail Rate</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_imd_daily_orders' name='federated.1dh6lf918m8ta01ghkpki0p0efye' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Date View' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1dh6lf918m8ta01ghkpki0p0efye'>
            <column caption='Date' datatype='date' default-format='*yyyy-mm-dd' name='[Calculation_457678357363400717]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE( &#13;&#10;IF [Parameters].[Parameter 1] = &quot;Daily&quot; THEN [order_date]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Weekly&quot; THEN DATETRUNC(&apos;week&apos;,[order_date],&apos;monday&apos;)&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Monthly&quot; THEN DATETRUNC(&apos;month&apos;,[order_date],&apos;monday&apos;)&#13;&#10;END&#13;&#10;)' />
            </column>
            <column caption='Fail Rate' datatype='real' default-format='p0.00%' name='[Share Reorders (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_orders_not_sent]) / (SUM([total_orders]) + SUM([total_orders_not_sent]))' />
            </column>
            <column aggregation='None' caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
