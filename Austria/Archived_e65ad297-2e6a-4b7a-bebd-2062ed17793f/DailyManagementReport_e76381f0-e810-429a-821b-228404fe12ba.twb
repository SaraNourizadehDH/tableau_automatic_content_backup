            <column-instance column='[subsidy_type]' derivation='None' name='[none:subsidy_type:nk]' pivot='key' type='nominal' />
            <column caption='Order Date' datatype='date' default-format='*yyyy-mm-dd' name='[order_date]' role='dimension' type='ordinal' />
            <column caption='Operating System (raw)' datatype='string' name='[os]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_502714371734159362]' derivation='User' name='[pcto:usr:Calculation_502714371734159362:qk:3]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Columns' type='PctTotal' />
            </column-instance>
            <column caption='Reorders' datatype='real' name='[reorders]' role='measure' type='quantitative' />
            <column caption='Segment' datatype='string' name='[segment]' role='dimension' type='nominal' />
            <column caption='Subsidy Type' datatype='string' name='[subsidy_type]' role='dimension' type='nominal' />
            <column caption='Commission Revenue (€)' datatype='real' default-format='C1031%' name='[total_commission]' role='measure' type='quantitative' />
            <column caption='Commission Revenue (LC)' datatype='real' name='[total_commission_lc]' role='measure' type='quantitative' />
            <column caption='Commission Revenue (USD)' datatype='real' name='[total_commission_usd]' role='measure' type='quantitative' />
            <column caption='Not Accepted' datatype='real' name='[total_not_accepted]' role='measure' type='quantitative' />
