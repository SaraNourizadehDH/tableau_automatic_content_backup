            <column caption='Failed Orders' datatype='real' name='[total_orders_not_sent]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1dh6lf918m8ta01ghkpki0p0efye].[Operating System (group) 1]'>
