      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1dh6lf918m8ta01ghkpki0p0efye].[win:usr:Calculation_502714371734159362:qk:14]&quot;' value='Moving Average of KPIs from the previous 7 Days/Weeks/Months (Depending on chosen field in &quot;Select Date View&quot;)' />
        </aliases>
      </column>
      <column caption='CPO' datatype='real' name='[CPA (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_5959528977747083264]) / SUM([total_orders])' />
      </column>
      <column caption='CPRO' datatype='real' name='[CPO (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_5959528977747083264]) / SUM([reorders])' />
      </column>
      <column caption='MoM % Orders' datatype='real' default-format='p0.00%' name='[Calculation2]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([total_orders])) - LOOKUP(ZN(SUM([total_orders])), -1))&#13;&#10; / ABS(LOOKUP(ZN(SUM([total_orders])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Total Orders' datatype='real' name='[Calculation_146015144656220165]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='TOTAL(SUM([total_orders]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Total Acquisitions' datatype='real' name='[Calculation_146015144656699398]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='TOTAL(SUM([acquisitions]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_2152931779749617664]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='USERNAME()=[username]' />
      </column>
      <column caption='String YoY' datatype='string' name='[Calculation_3357574295203119104]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Daily&apos; THEN &apos;&apos; ELSE &apos;YoY&apos; END' />
      </column>
      <column caption='String Δ Acquisitions YoY' datatype='string' name='[Calculation_3357574295204278275]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Daily&apos; THEN &apos;&apos; ELSE STR(ROUND([Δ Orders YoY (copy)]*100)) END' />
      </column>
      <column caption='CPA' datatype='real' name='[Calculation_428686418814488576]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_5959528977747083264]) / SUM([acquisitions])' />
      </column>
      <column caption='Date' datatype='date' default-format='*yyyy-mm-dd' name='[Calculation_457678357363400717]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE( &#13;&#10;IF [Parameters].[Parameter 1] = &quot;Daily&quot; THEN [order_date]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Weekly&quot; THEN DATETRUNC(&apos;week&apos;,[order_date],&apos;monday&apos;)&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Monthly&quot; THEN DATETRUNC(&apos;month&apos;,[order_date],&apos;monday&apos;)&#13;&#10;END&#13;&#10;)' />
      </column>
      <column caption='Commission Rate' datatype='real' default-format='p0.00%' name='[Calculation_492299738402304000]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_5959528977747644417]) / SUM([Calculation_5959528977765588995])' />
      </column>
      <column caption='Average Order Value' datatype='real' name='[Calculation_492299738402779137]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_5959528977765588995]) / SUM([total_orders])' />
      </column>
      <column caption='Mobile Orders' datatype='real' name='[Calculation_492299738404122627]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Operating System (group)] = &apos;Mobile&apos; THEN [total_orders] ELSE 0 END)' />
      </column>
      <column caption='Mobile Orders Share' datatype='real' default-format='p0.00%' name='[Calculation_492299738404663300]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_492299738404122627] / SUM([total_orders])' />
      </column>
      <column caption='Share Acquisition' datatype='real' default-format='p0.00%' name='[Calculation_502714371732062209]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([acquisitions]) / SUM([total_orders])' />
      </column>
      <column caption='KPIs' datatype='real' name='[Calculation_502714371734159362]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;Acquisitions&apos; THEN SUM([acquisitions])&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Reorders&apos; THEN SUM([reorders])&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Orders&apos; THEN SUM([total_orders])&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Declines&apos; THEN SUM([total_not_accepted])&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Declines %&apos; THEN SUM([total_not_accepted]) / SUM([total_orders])&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Not Sent&apos; THEN SUM([total_orders_not_sent])&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Commission Revenue&apos; THEN SUM([Calculation_5959528977747644417])&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Marketing Costs&apos; THEN SUM([Calculation_5959528977747083264])&#13;&#10;END' />
      </column>
      <column caption='YoY % Orders' datatype='real' default-format='p0.00%' name='[Calculation_502714371759747084]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([total_orders])) - LOOKUP(ZN(SUM([total_orders])), -12)) &#13;&#10;/ ABS(LOOKUP(ZN(SUM([total_orders])), -12))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Δ Orders YoY' datatype='real' name='[Calculation_5544001513381330944]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN (SUM([total_orders])/SUM([prev_364d_total_orders]) - 1)&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN (SUM([total_orders])/SUM([prev_y_total_orders]) - 1)&#10;ELSE AVG(0)&#10;END' />
      </column>
      <column caption='week_order_date_right' datatype='datetime' name='[Calculation_5957417909816061952]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF YEAR([order_date]) = 2017 THEN DATETRUNC(&apos;week&apos;, [order_date] - 7)&#10;ELSE DATETRUNC(&apos;week&apos;, [order_date])&#10;END' />
      </column>
      <column caption='Marketing Costs' datatype='real' name='[Calculation_5959528977747083264]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;EUR&apos; THEN [marketing_costs_eur]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;LC&apos; THEN [marketing_costs_lc]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;USD&apos; THEN [marketing_costs_usd]&#10;END' />
      </column>
      <column caption='Commission Revenue' datatype='real' name='[Calculation_5959528977747644417]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 4] =  &apos;EUR&apos; THEN [total_commission]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;LC&apos; THEN [total_commission_lc]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;USD&apos; THEN [total_commission_usd]&#10;END' />
      </column>
      <column caption='GMV' datatype='real' name='[Calculation_5959528977765588995]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;EUR&apos; THEN [total_revenue]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;USD&apos; THEN [total_revenue_usd]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;LC&apos; THEN [total_revenue_lc]&#10;END' />
      </column>
      <column caption='MoM KPIs' datatype='real' name='[KPIs (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;Acquisitions&apos; THEN [MoM % Orders (copy)]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Reorders&apos; THEN [MoM % Orders (copy 2)]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Orders&apos; THEN [Calculation2]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Declines&apos; THEN [MoM % Acquisitions (copy 2)]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Not Sent&apos; THEN [MoM % Acquisitions (copy 3)]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Commission Revenue&apos; THEN [MoM % Acquisitions (copy)]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Marketing Costs&apos; THEN [MoM % Commission Revenue (copy)]&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='MoM % Declines' datatype='real' default-format='p0.00%' name='[MoM % Acquisitions (copy 2)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([total_not_accepted])) - LOOKUP(ZN(SUM([total_not_accepted])), -1))&#13;&#10; / ABS(LOOKUP(ZN(SUM([total_not_accepted])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='MoM % Not Sent' datatype='real' default-format='p0.00%' name='[MoM % Acquisitions (copy 3)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([total_orders_not_sent])) - LOOKUP(ZN(SUM([total_orders_not_sent])), -1))&#13;&#10; / ABS(LOOKUP(ZN(SUM([total_orders_not_sent])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='MoM % Commission Revenue' datatype='real' default-format='p0.00%' name='[MoM % Acquisitions (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([Calculation_5959528977747644417])) - LOOKUP(ZN(SUM([Calculation_5959528977747644417])), -1))&#13;&#10; / ABS(LOOKUP(ZN(SUM([Calculation_5959528977747644417])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='MoM % Marketing Costs' datatype='real' default-format='p0.00%' name='[MoM % Commission Revenue (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([Calculation_5959528977747083264])) - LOOKUP(ZN(SUM([Calculation_5959528977747083264])), -1))&#13;&#10; / ABS(LOOKUP(ZN(SUM([Calculation_5959528977747083264])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='MoM % Reorders' datatype='real' default-format='p0.00%' name='[MoM % Orders (copy 2)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([reorders])) - LOOKUP(ZN(SUM([reorders])), -1))&#13;&#10; / ABS(LOOKUP(ZN(SUM([reorders])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='MoM % Acquisitions' datatype='real' default-format='p0.00%' name='[MoM % Orders (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([acquisitions])) - LOOKUP(ZN(SUM([acquisitions])), -1))&#13;&#10; / ABS(LOOKUP(ZN(SUM([acquisitions])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='YoY KPIs' datatype='real' name='[MoM KPIs (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;Acquisitions&apos; THEN [YoY % Orders (copy)]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Reorders&apos; THEN [YoY % Orders (copy 2)]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Orders&apos; THEN [Calculation_502714371759747084]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Declines&apos; THEN [YoY % Acquisitions (copy 2)]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Not Sent&apos; THEN [YoY % Acquisitions (copy 3)]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Commission Revenue&apos; THEN [YoY % Acquisitions (copy)]&#13;&#10;ELSEiF [Parameters].[Parameter 2] = &apos;Marketing Costs&apos; THEN [YoY % Commission Revenue (copy)]&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Web Orders' datatype='real' name='[Mobile Orders (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Operating System (group)] = &apos;Web&apos; THEN [total_orders] ELSE 0 END)' />
      </column>
      <column datatype='integer' hidden='true' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Operating System' datatype='string' name='[Operating System (group) 1]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[os]' new-bin='true'>
          <bin default-name='false' value='&quot;Android&quot;'>
            <value>&quot;android&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Mobile App&quot;'>
            <value>&quot;mobile app&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Mobile Web&quot;'>
            <value>&quot;mobile web&quot;</value>
            <value>&quot;mobile_web&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Others&quot;'>
            <value>&quot;NULL&quot;</value>
            <value>&quot;cost_data&quot;</value>
            <value>&quot;other&quot;</value>
            <value>&quot;others&quot;</value>
            <value>&quot;phone&quot;</value>
            <value>&quot;unknown&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Web&quot;'>
            <value>&quot;web&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;iOS&quot;'>
            <value>&quot;iOS&quot;</value>
            <value>&quot;ios&quot;</value>
            <value>&quot;iphone&quot;</value>
          </bin>
        </calculation>
      </column>
      <column caption='Operating System Type' datatype='string' name='[Operating System (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[os]' new-bin='true'>
          <bin default-name='false' value='&quot;Mobile&quot;'>
            <value>&quot;android&quot;</value>
            <value>&quot;iOS&quot;</value>
            <value>&quot;mobile web&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Others/Unknown&quot;'>
            <value>&quot;other&quot;</value>
            <value>&quot;others&quot;</value>
            <value>&quot;phone&quot;</value>
            <value>&quot;unknown&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Web&quot;'>
            <value>&quot;web&quot;</value>
          </bin>
        </calculation>
      </column>
      <column caption='Share Reorders' datatype='real' default-format='p0.00%' name='[Share Acquisition (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([reorders]) / SUM([total_orders])' />
      </column>
      <column caption='Web Orders Share' datatype='real' default-format='p0.00%' name='[Share Mobile Orders (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Mobile Orders (copy)] / SUM([total_orders])' />
      </column>
      <column caption='Fail Rate' datatype='real' default-format='p0.00%' name='[Share Reorders (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_orders_not_sent]) / (SUM([total_orders]) + SUM([total_orders_not_sent]))' />
      </column>
      <column caption='String %' datatype='string' name='[String YoY (copy)]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Daily&apos; THEN &apos;&apos; ELSE &apos;%&apos; END' />
      </column>
      <column caption='String Δ Orders YoY' datatype='string' name='[String Δ Acquisitions YoY (copy)]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Daily&apos; THEN &apos;&apos; ELSE STR(ROUND([Calculation_5544001513381330944]*100)) END' />
      </column>
      <column caption='YoY % Declines' datatype='real' default-format='p0.00%' name='[YoY % Acquisitions (copy 2)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([total_not_accepted])) - LOOKUP(ZN(SUM([total_not_accepted])), -12)) &#13;&#10;/ ABS(LOOKUP(ZN(SUM([total_not_accepted])), -12))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='YoY % Not Sent' datatype='real' default-format='p0.00%' name='[YoY % Acquisitions (copy 3)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([total_orders_not_sent])) - LOOKUP(ZN(SUM([total_orders_not_sent])), -12)) &#13;&#10;/ ABS(LOOKUP(ZN(SUM([total_orders_not_sent])), -12))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='YoY % Commission Revenue' datatype='real' default-format='p0.00%' name='[YoY % Acquisitions (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([Calculation_5959528977747644417])) - LOOKUP(ZN(SUM([Calculation_5959528977747644417])), -12)) &#13;&#10;/ ABS(LOOKUP(ZN(SUM([Calculation_5959528977747644417])), -12))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='YoY % Marketing Costs' datatype='real' default-format='p0.00%' name='[YoY % Commission Revenue (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([Calculation_5959528977747083264])) - LOOKUP(ZN(SUM([Calculation_5959528977747083264])), -12)) &#13;&#10;/ ABS(LOOKUP(ZN(SUM([Calculation_5959528977747083264])), -12))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='YoY % Reorders' datatype='real' default-format='p0.00%' name='[YoY % Orders (copy 2)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([reorders])) - LOOKUP(ZN(SUM([reorders])), -12)) &#13;&#10;/ ABS(LOOKUP(ZN(SUM([reorders])), -12))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='YoY % Acquisitions' datatype='real' default-format='p0.00%' name='[YoY % Orders (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([acquisitions])) - LOOKUP(ZN(SUM([acquisitions])), -12)) &#13;&#10;/ ABS(LOOKUP(ZN(SUM([acquisitions])), -12))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
