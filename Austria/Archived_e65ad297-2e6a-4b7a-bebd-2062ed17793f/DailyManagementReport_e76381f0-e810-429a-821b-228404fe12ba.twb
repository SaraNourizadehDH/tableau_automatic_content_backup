    <worksheet name='MoM/YoY Growth Graph'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#ff0000'>MoM</run>
            <run> &amp; </run>
            <run fontcolor='#1f77b4'>YoY</run>
