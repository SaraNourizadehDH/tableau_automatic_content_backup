              <calculation class='tableau' formula='DATE( &#13;&#10;IF [Parameters].[Parameter 1] = &quot;Daily&quot; THEN [order_date]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Weekly&quot; THEN DATETRUNC(&apos;week&apos;,[order_date],&apos;monday&apos;)&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Monthly&quot; THEN DATETRUNC(&apos;month&apos;,[order_date],&apos;monday&apos;)&#13;&#10;END&#13;&#10;)' />
            </column>
