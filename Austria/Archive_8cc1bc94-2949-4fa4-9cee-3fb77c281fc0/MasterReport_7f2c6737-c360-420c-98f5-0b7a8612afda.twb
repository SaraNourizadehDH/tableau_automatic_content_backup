        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1y4oykk1pgh38y1anfer508tstjl (copy 2)' name='Custom SQL Query' type='text'><![CDATA[--weekly 3 months data , weekly data
WITH
  date_month AS (
  SELECT
 date_trunc(iso_date,week(monday)) as iso_date,
 iso_week
  FROM
    `fulfillment-dwh-production.curated_data_shared_central_dwh.dates` 
    dim_dates
  WHERE
    iso_date >>= DATE_SUB(CURRENT_DATE, INTERVAL 3 MONTH)
    AND iso_date << current_date
 ),
  pd_orders AS (
  SELECT
    pd_orders.global_entity_id,
    pd_orders.country_name,
    pd_orders.delivery_address_city AS order_delivery_address_city,
    DATE_TRUNC(pd_orders.created_date_local,week(monday)) AS date_local,
    pd_orders.created_date_local,
    pd_orders.uuid AS order_uuid,
    pd_orders.id AS order_id,
    pd_orders.pd_vendor_uuid,
    dwho.analytical_customer_id,
    -- pd_orders.expedition_type,
    pd_orders.is_failed_order_vendor vendor_failed,
    pd_orders.is_failed_order_customer customer_failed,
    pd_orders.is_failed_order_foodpanda logistics_failed,
    pd_orders.is_pickup,
    pd_orders.code,
 
billable_flag.is_billable,
    pd_orders.is_valid_order,
    pd_orders.is_preorder,
    pd_orders.is_gross_order,
    pd_orders.is_failed_order,
    pd_orders.delivery_time_in_minutes,
    pd_orders.preparation_time_in_minutes,
    pd_orders.promised_delivery_time_in_minutes,
    pd_orders.vat_amount_local,
    pd_orders.total_value_local,
    pd_orders.minimum_delivery_value_local as min_delivery_value,
    pd_orders.products_total_local,
    -- pd_orders.ordered_at_local,
    pd_orders.delivery_fee_local,
    pd_orders.status_code,
    pd_payment_types.is_online_payment,
    dwho.is_acquisition is_acquisition,
    pd_orders_agg_vouchers.voucher.value_eur AS voucher_value_eur,
    pd_orders_agg_vouchers.voucher.current_foodpanda_ratio AS voucher_ratio,
    pd_orders_agg_vouchers.is_voucher_used,
    pd_orders.delivery_time_in_minutes - pd_orders.promised_delivery_time_in_minutes >> 10 AS is_delayed_10_mins,
    (pd_orders.delivery_time_in_minutes-pd_orders.promised_delivery_time_in_minutes) >> 35 AS is_delayed_35_mins,
    pd_orders_agg_accounting.gmv_eur AS gmv_eur,
    pd_orders_agg_accounting.gfv_eur AS gfv_eur,
    has_valid_reordered_in_7days,

    LAG(pd_orders.vendor_code) OVER (PARTITION BY dwho.analytical_customer_id ORDER BY pd_orders.created_at_local ASC) AS PreviousOrderVendorCode,
    LAG(pd_orders.created_date_local) OVER (PARTITION BY dwho.analytical_customer_id ORDER BY pd_orders.created_at_local ASC) AS PreviousOrderDate
  FROM
    `fulfillment-dwh-production.pandata_curated.pd_orders` AS pd_orders
left join 
`fulfillment-dwh-production.pandata_report.regional_eu__pd_orders_billing_flag` billable_flag
on pd_orders.global_entity_id = billable_flag.global_entity_id
and pd_orders.uuid = billable_flag.uuid
and pd_orders.id = billable_flag.id
and pd_orders.ordered_at_date_utc = billable_flag.ordered_at_date_utc

  LEFT JOIN
    `fulfillment-dwh-production.pandata_curated.pd_payment_types` AS pd_payment_types
  ON
    pd_payment_types.uuid = pd_orders.pd_payment_type_uuid

  LEFT JOIN
    `fulfillment-dwh-production.pandata_report.regional_apac_cx_orders_agg_reorder_dates` AS pandora_pd_orders_agg_reorder_dates
  ON
    pandora_pd_orders_agg_reorder_dates.uuid = pd_orders.uuid
    AND pandora_pd_orders_agg_reorder_dates.ordered_at_date_local >>= DATE_SUB(CURRENT_DATE, INTERVAL 3 MONTH)
  LEFT JOIN
    `fulfillment-dwh-production.curated_data_shared_central_dwh.orders` dwho
  ON
    dwho.order_id=pd_orders.code
    AND dwho.global_entity_id=pd_orders.global_entity_id
    AND dwho.placed_at_local>>=DATE_SUB(current_date, INTERVAL 3 month)
    AND DATE(dwho.placed_at)>>=DATE_SUB(current_date, INTERVAL 3 month)
  LEFT JOIN
    `fulfillment-dwh-production.curated_data_shared_central_dwh.agg_customers` cust
  ON
    cust.first_order_id = pd_orders.code
    AND cust.global_entity_id=pd_orders.global_entity_id
  LEFT JOIN
    `fulfillment-dwh-production.pandata_report.regional_eu__pd_orders_agg_accounting` AS pd_orders_agg_accounting
  ON
    pd_orders_agg_accounting.uuid = pd_orders.uuid
    AND pd_orders_agg_accounting.created_date_utc >>= DATE_SUB(CURRENT_DATE, INTERVAL 3 MONTH)
  LEFT JOIN
    `fulfillment-dwh-production.pandata_report.regional_eu__pd_orders_agg_vouchers` AS pd_orders_agg_vouchers
  ON
    pd_orders_agg_vouchers.uuid = pd_orders.uuid
    AND pd_orders_agg_vouchers.created_date_utc >>= DATE_SUB(CURRENT_DATE, INTERVAL 3 MONTH)
  WHERE
    pd_orders.global_entity_id = 'MJM_AT'
    AND pd_orders.created_date_utc <<>>current_date
    AND pd_orders.created_date_utc >>= DATE_SUB(CURRENT_DATE, INTERVAL 3 MONTH)
     and   billable_flag.created_date_utc >>= DATE_SUB(CURRENT_DATE, INTERVAL 3 MONTH)
    ),
  vendor_rating AS (
  

   SELECT distinct 
date_trunc(date(vr.timestamp),week(monday)) as date_rating,
content.entity_id,
last_value (FLOOR(ratings.rating *10) / 10 ) 

over ( partition by  content.entity_id,date_trunc(timestamp,week(monday))
order by date(date_trunc(vr.timestamp,week(monday)))
RANGE BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) as rating, 
topic
  FROM
    `fulfillment-dwh-production.curated_data_shared_data_stream.aggregated_rating_update_stream` vr,
    UNNEST(content.ratings) AS ratings
  WHERE
    content.global_entity_id = "MJM_AT" and
     DATE(timestamp) >>= DATE_SUB(CURRENT_DATE, INTERVAL 3 MONTH)
     and topic = 'overall'
      
 
    -- )
 ),


  pd_vendors AS(
  SELECT 
    date_month.iso_date ,iso_week,
    pd_vendors.global_entity_id AS vendor_global_entity_id,
    pd_vendors.vendor_code,
    pd_vendors.uuid AS vendor_uuid,
    pd_vendors.chain_code,
    pd_vendors.name AS vendor_name,
    pd_vendors.chain_name,
    pd_vendors.vertical_type,
    pd_vendors.location.street AS restaurant_street,
    pd_vendors.location.city AS restaurant_city,
    pd_vendors.location.postal_code AS restaurant_zip,
    pd_vendors.business_type,
   CASE
    WHEN pd_vendors.chain_code IN ('cy1dd', 'ch5me', 'cs3hp', 'cv1yp', 'cv5kr', 'cd0mi', 'ce0wk', 'cv2oo', 'cd0fr', 'ch6oj', 'cl1ok', 'cu1op', 'ce6wv') THEN "GFS"
    WHEN pd_vendors.chain_code IN ('cy1zy', 'cl4df', 'cc9ca', 'ck9yw', 'cd7bo', 'ch9xl', 'cz4kc', 'cu0yk', 'ck0ke', 'cr1dc', 'cz1ez', 'cq2ml',
    'cn3ne', 'cp5wm', 'co7cn', 'cg6vv', 'cd4bs', 'cl9ie', 'co3pl', 'cb6lp', 'ct3xv', 'ck1uq', 'cw4go', 'cq6ba', 'cx5dk', 'cm9fx',
    'cg8dy', 'cc3xc', 'cq2jy', 'cz3ny', 'cf3rb') THEN "KA"
    WHEN pd_vendors.vendor_code IN ('gmeg', 'eebs', 'b3wh', 'cbw8', 'e9sq', 'ebyl', 'g381', 'hc65', 'hkvh', 'k7dc', 'k8wb', 'k824', 'lx8n', 'rg8k', 'ribz', 'tjnt', 'vbuy', 'xk9p', 'yypa', 'mpdw', 'tqo2', 'jqr4', 'llmj', 'hzi0', 'akoi', 'dt2k', 'jgy3', 'd0y1', 'k883', 'j4ss', 'kzrr', 'cn1x', 'v2gn', 'fqvv', 'thi6', 'txqq', 'uc6g', 'g0kq', 'o2ip', 'x975', 'ksa1', 'cewf', 'qa6f', 'l40v', 'uy3f', 'llxp', 'b9u3', 'hpz1', 'mwmn', 'edfk', 'ibf7') THEN "KA"
    ELSE sf_accounts.gmv_class
END AS gmv_vendor_grade,

    -- pd_vendors.is_key_account,
    sf_addresses.postal_code AS postal_code,
    CASE
      WHEN pd_vendors.has_delivery_type_partner_delivery THEN "OD : Partner Delivery"
      WHEN pd_vendors.has_delivery_type_platform_delivery THEN "OD : Platform Delivery"
      WHEN pd_vendors.has_delivery_type_vendor_delivery THEN "MP"
  END
    AS delivery_type,
  FROM
    `fulfillment-dwh-production.pandata_curated.pd_vendors` AS pd_vendors
  LEFT JOIN
    `fulfillment-dwh-production.pandata_curated.sf_accounts` AS sf_accounts
  ON
    sf_accounts.vendor_code=pd_vendors.vendor_code
    AND sf_accounts.global_entity_id=pd_vendors.global_entity_id,
    UNNEST(sf_accounts.addresses) AS sf_addresses
  CROSS JOIN
    date_month
  WHERE
    pd_vendors.global_entity_id = 'MJM_AT'
    AND NOT is_test
    AND is_active   and sf_addresses.address_type LIKE "%Restaurant Address%" )
    ,
  cicle AS (
  SELECT 
  distinct
  
    pd_orders.*,
    pd_vendors.*,
  FROM
    pd_vendors
  LEFT JOIN
    pd_orders
  ON
    pd_vendors.vendor_uuid = pd_orders.pd_vendor_uuid
    AND pd_vendors.vendor_global_entity_id = pd_orders.global_entity_id
    AND pd_vendors.iso_date = pd_orders.date_local 
 
    ) ,
  main_metrics AS (
  SELECT
    cicle.global_entity_id,iso_week,
    iso_date date_local,
    order_delivery_address_city,
    chain_name,
    chain_code,
    cicle.vendor_code,
    vendor_name,
    vertical_type,
    restaurant_street,
    restaurant_city,
    postal_code,
    business_type,
    gmv_vendor_grade,
    -- is_key_account,
    is_billable,
    is_online_payment,
    is_voucher_used,
    delivery_type, min_delivery_value,

      vr.rating,vr.topic,
    COUNT( DISTINCT
      CASE
        WHEN is_online_payment AND is_valid_order THEN order_uuid
    END
      ) AS payment_online,
    COUNT(DISTINCT order_uuid) AS total_number_of_orders,

    COUNT(DISTINCT
    IF
      (is_valid_order, order_id, NULL)) AS total_number_of_successful_orders,
    COUNT(DISTINCT
    IF
      (is_failed_order, order_id, NULL)) AS total_number_of_failed_orders,
    COUNT(DISTINCT
    IF
      (status_code=67, order_id, NULL)) AS total_number_of_payment_failures,
    COUNT(DISTINCT
    IF
      (is_valid_order
        AND is_acquisition, analytical_customer_id, NULL)) AS acquisition,

COUNT(DISTINCT
    IF
      (is_valid_order
        AND is_pickup, order_id, NULL)) AS pickup_orders,
        
COUNT(DISTINCT
    IF
      (is_valid_order
        AND not is_pickup, order_id, NULL)) AS delivery_orders,


    COUNT(DISTINCT
    IF
      (is_valid_order, analytical_customer_id, NULL)) AS active_customer_count,
    COUNT(DISTINCT
    IF
      (is_valid_order
        AND is_delayed_10_mins, order_id, NULL)) AS total_number_of_delayed_10_mins_orders,

        COUNT(DISTINCT
    IF
      (is_valid_order
        AND is_delayed_35_mins, order_id, NULL)) AS total_number_of_delayed_35_mins_orders,
 
    COUNT(DISTINCT
    IF
      ( vendor_failed, order_id, NULL)) AS order_failed_vendor,
    COUNT(DISTINCT
    IF
      ( customer_failed, order_id, NULL)) AS order_failed_customer,
    COUNT(DISTINCT
    IF
      ( logistics_failed, order_id, NULL)) AS order_failed_logistics,
    AVG(CASE
        WHEN is_valid_order THEN delivery_time_in_minutes
    END
      ) AS avg_delivery_time_min,
    AVG(
      CASE
        WHEN is_valid_order THEN preparation_time_in_minutes
    END
      ) AS avg_prep_time_min,
    
   
    SUM(
    IF
      (is_valid_order, products_total_local, 0)) AS products_total_local,
    SUM(
    IF
      (is_valid_order, gmv_eur, 0)) AS total_gmv_eur,
    SUM(
    IF
      (is_valid_order, gfv_eur, 0)) AS total_gfv_eur,
  
    SUM(
    IF
      (is_valid_order, voucher_value_eur, 0)) AS total_voucher_value_eur,
    SUM(
    IF
      (is_valid_order, voucher_value_eur * (100 - voucher_ratio)/100, 0)) AS total_voucher_vendor_value_eur,
    SUM(CASE
        WHEN is_valid_order THEN delivery_fee_local
      ELSE
      0
    END
      ) AS delivery_fee,
    SUM(
    IF
      (is_valid_order, vat_amount_local, 0)) AS total_vat_amt_local,
    SUM(
      CASE
        WHEN is_valid_order THEN delivery_time_in_minutes
    END
      ) AS sum_delivery_time_min,
    SUM(
      CASE
        WHEN is_valid_order THEN preparation_time_in_minutes
    END
      ) AS sum_prep_time_min,
    SUM(
      CASE
        WHEN is_valid_order THEN promised_delivery_time_in_minutes
    END
      ) - SUM(delivery_time_in_minutes) AS diff_promised_delivery,
 
    COUNT( DISTINCT
    IF
      (has_valid_reordered_in_7days, order_id, NULL)) AS has_valid_reordered_in_7days,
   
    COUNT( DISTINCT
    IF
      (PreviousOrderVendorCode=cicle.vendor_code
        AND DATE_DIFF( created_date_local,PreviousOrderDate, day)<<=7, analytical_customer_id, NULL)) AS 
        has_valid_reordered_in_samevendor_7days_Customer,
    COUNT( DISTINCT
    IF
      (is_valid_order, analytical_customer_id, NULL)) AS Total_Customers,
  
  FROM
    cicle
  LEFT JOIN
    vendor_rating vr
  ON
    vr.entity_id =cicle.vendor_code
    and vr.date_rating = cicle.date_local
  GROUP BY global_entity_id,
  iso_week,iso_date,
    order_delivery_address_city,
    chain_name,
    chain_code,
    vendor_code,
    vendor_name,
    vertical_type,
    restaurant_street,
    restaurant_city,
    postal_code,
    business_type
    ,
    -- is_key_account,
    vr.rating,vr.topic,
    is_billable,
    is_online_payment,
 min_delivery_value,
    is_voucher_used,
    iso_week,
     gmv_vendor_grade,
    delivery_type
)
SELECT
  *
FROM
  main_metrics]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1y4oykk1pgh38y1anfer508tstjl (copy 2)' name='Custom SQL Query' type='text'><![CDATA[--weekly 3 months data , weekly data
WITH
  date_month AS (
  SELECT
 date_trunc(iso_date,week(monday)) as iso_date,
 iso_week
  FROM
    `fulfillment-dwh-production.curated_data_shared_central_dwh.dates` 
    dim_dates
  WHERE
    iso_date >>= DATE_SUB(CURRENT_DATE, INTERVAL 3 MONTH)
    AND iso_date << current_date
 ),
  pd_orders AS (
  SELECT
    pd_orders.global_entity_id,
    pd_orders.country_name,
    pd_orders.delivery_address_city AS order_delivery_address_city,
    DATE_TRUNC(pd_orders.created_date_local,week(monday)) AS date_local,
    pd_orders.created_date_local,
    pd_orders.uuid AS order_uuid,
    pd_orders.id AS order_id,
    pd_orders.pd_vendor_uuid,
    dwho.analytical_customer_id,
    -- pd_orders.expedition_type,
    pd_orders.is_failed_order_vendor vendor_failed,
    pd_orders.is_failed_order_customer customer_failed,
    pd_orders.is_failed_order_foodpanda logistics_failed,
    pd_orders.is_pickup,
    pd_orders.code,
 
billable_flag.is_billable,
    pd_orders.is_valid_order,
    pd_orders.is_preorder,
    pd_orders.is_gross_order,
    pd_orders.is_failed_order,
    pd_orders.delivery_time_in_minutes,
    pd_orders.preparation_time_in_minutes,
    pd_orders.promised_delivery_time_in_minutes,
    pd_orders.vat_amount_local,
    pd_orders.total_value_local,
    pd_orders.minimum_delivery_value_local as min_delivery_value,
    pd_orders.products_total_local,
    -- pd_orders.ordered_at_local,
    pd_orders.delivery_fee_local,
    pd_orders.status_code,
    pd_payment_types.is_online_payment,
    dwho.is_acquisition is_acquisition,
    pd_orders_agg_vouchers.voucher.value_eur AS voucher_value_eur,
    pd_orders_agg_vouchers.voucher.current_foodpanda_ratio AS voucher_ratio,
    pd_orders_agg_vouchers.is_voucher_used,
    pd_orders.delivery_time_in_minutes - pd_orders.promised_delivery_time_in_minutes >> 10 AS is_delayed_10_mins,
    (pd_orders.delivery_time_in_minutes-pd_orders.promised_delivery_time_in_minutes) >> 35 AS is_delayed_35_mins,
    pd_orders_agg_accounting.gmv_eur AS gmv_eur,
    pd_orders_agg_accounting.gfv_eur AS gfv_eur,
    has_valid_reordered_in_7days,

    LAG(pd_orders.vendor_code) OVER (PARTITION BY dwho.analytical_customer_id ORDER BY pd_orders.created_at_local ASC) AS PreviousOrderVendorCode,
    LAG(pd_orders.created_date_local) OVER (PARTITION BY dwho.analytical_customer_id ORDER BY pd_orders.created_at_local ASC) AS PreviousOrderDate
  FROM
    `fulfillment-dwh-production.pandata_curated.pd_orders` AS pd_orders
left join 
`fulfillment-dwh-production.pandata_report.regional_eu__pd_orders_billing_flag` billable_flag
on pd_orders.global_entity_id = billable_flag.global_entity_id
and pd_orders.uuid = billable_flag.uuid
and pd_orders.id = billable_flag.id
and pd_orders.ordered_at_date_utc = billable_flag.ordered_at_date_utc

  LEFT JOIN
    `fulfillment-dwh-production.pandata_curated.pd_payment_types` AS pd_payment_types
  ON
    pd_payment_types.uuid = pd_orders.pd_payment_type_uuid

  LEFT JOIN
    `fulfillment-dwh-production.pandata_report.regional_apac_cx_orders_agg_reorder_dates` AS pandora_pd_orders_agg_reorder_dates
  ON
    pandora_pd_orders_agg_reorder_dates.uuid = pd_orders.uuid
    AND pandora_pd_orders_agg_reorder_dates.ordered_at_date_local >>= DATE_SUB(CURRENT_DATE, INTERVAL 3 MONTH)
  LEFT JOIN
    `fulfillment-dwh-production.curated_data_shared_central_dwh.orders` dwho
  ON
    dwho.order_id=pd_orders.code
    AND dwho.global_entity_id=pd_orders.global_entity_id
    AND dwho.placed_at_local>>=DATE_SUB(current_date, INTERVAL 3 month)
    AND DATE(dwho.placed_at)>>=DATE_SUB(current_date, INTERVAL 3 month)
  LEFT JOIN
    `fulfillment-dwh-production.curated_data_shared_central_dwh.agg_customers` cust
  ON
    cust.first_order_id = pd_orders.code
    AND cust.global_entity_id=pd_orders.global_entity_id
  LEFT JOIN
    `fulfillment-dwh-production.pandata_report.regional_eu__pd_orders_agg_accounting` AS pd_orders_agg_accounting
  ON
    pd_orders_agg_accounting.uuid = pd_orders.uuid
    AND pd_orders_agg_accounting.created_date_utc >>= DATE_SUB(CURRENT_DATE, INTERVAL 3 MONTH)
  LEFT JOIN
    `fulfillment-dwh-production.pandata_report.regional_eu__pd_orders_agg_vouchers` AS pd_orders_agg_vouchers
  ON
    pd_orders_agg_vouchers.uuid = pd_orders.uuid
    AND pd_orders_agg_vouchers.created_date_utc >>= DATE_SUB(CURRENT_DATE, INTERVAL 3 MONTH)
  WHERE
    pd_orders.global_entity_id = 'MJM_AT'
    AND pd_orders.created_date_utc <<>>current_date
    AND pd_orders.created_date_utc >>= DATE_SUB(CURRENT_DATE, INTERVAL 3 MONTH)
     and   billable_flag.created_date_utc >>= DATE_SUB(CURRENT_DATE, INTERVAL 3 MONTH)
    ),
  vendor_rating AS (
  

   SELECT distinct 
date_trunc(date(vr.timestamp),week(monday)) as date_rating,
content.entity_id,
last_value (FLOOR(ratings.rating *10) / 10 ) 

over ( partition by  content.entity_id,date_trunc(timestamp,week(monday))
order by date(date_trunc(vr.timestamp,week(monday)))
RANGE BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) as rating, 
topic
  FROM
    `fulfillment-dwh-production.curated_data_shared_data_stream.aggregated_rating_update_stream` vr,
    UNNEST(content.ratings) AS ratings
  WHERE
    content.global_entity_id = "MJM_AT" and
     DATE(timestamp) >>= DATE_SUB(CURRENT_DATE, INTERVAL 3 MONTH)
     and topic = 'overall'
      
 
    -- )
 ),


  pd_vendors AS(
  SELECT 
    date_month.iso_date ,iso_week,
    pd_vendors.global_entity_id AS vendor_global_entity_id,
    pd_vendors.vendor_code,
    pd_vendors.uuid AS vendor_uuid,
    pd_vendors.chain_code,
    pd_vendors.name AS vendor_name,
    pd_vendors.chain_name,
    pd_vendors.vertical_type,
    pd_vendors.location.street AS restaurant_street,
    pd_vendors.location.city AS restaurant_city,
    pd_vendors.location.postal_code AS restaurant_zip,
    pd_vendors.business_type,
   CASE
    WHEN pd_vendors.chain_code IN ('cy1dd', 'ch5me', 'cs3hp', 'cv1yp', 'cv5kr', 'cd0mi', 'ce0wk', 'cv2oo', 'cd0fr', 'ch6oj', 'cl1ok', 'cu1op', 'ce6wv') THEN "GFS"
    WHEN pd_vendors.chain_code IN ('cy1zy', 'cl4df', 'cc9ca', 'ck9yw', 'cd7bo', 'ch9xl', 'cz4kc', 'cu0yk', 'ck0ke', 'cr1dc', 'cz1ez', 'cq2ml',
    'cn3ne', 'cp5wm', 'co7cn', 'cg6vv', 'cd4bs', 'cl9ie', 'co3pl', 'cb6lp', 'ct3xv', 'ck1uq', 'cw4go', 'cq6ba', 'cx5dk', 'cm9fx',
    'cg8dy', 'cc3xc', 'cq2jy', 'cz3ny', 'cf3rb') THEN "KA"
    WHEN pd_vendors.vendor_code IN ('gmeg', 'eebs', 'b3wh', 'cbw8', 'e9sq', 'ebyl', 'g381', 'hc65', 'hkvh', 'k7dc', 'k8wb', 'k824', 'lx8n', 'rg8k', 'ribz', 'tjnt', 'vbuy', 'xk9p', 'yypa', 'mpdw', 'tqo2', 'jqr4', 'llmj', 'hzi0', 'akoi', 'dt2k', 'jgy3', 'd0y1', 'k883', 'j4ss', 'kzrr', 'cn1x', 'v2gn', 'fqvv', 'thi6', 'txqq', 'uc6g', 'g0kq', 'o2ip', 'x975', 'ksa1', 'cewf', 'qa6f', 'l40v', 'uy3f', 'llxp', 'b9u3', 'hpz1', 'mwmn', 'edfk', 'ibf7') THEN "KA"
    ELSE sf_accounts.gmv_class
END AS gmv_vendor_grade,

    -- pd_vendors.is_key_account,
    sf_addresses.postal_code AS postal_code,
    CASE
      WHEN pd_vendors.has_delivery_type_partner_delivery THEN "OD : Partner Delivery"
      WHEN pd_vendors.has_delivery_type_platform_delivery THEN "OD : Platform Delivery"
      WHEN pd_vendors.has_delivery_type_vendor_delivery THEN "MP"
  END
    AS delivery_type,
  FROM
    `fulfillment-dwh-production.pandata_curated.pd_vendors` AS pd_vendors
  LEFT JOIN
    `fulfillment-dwh-production.pandata_curated.sf_accounts` AS sf_accounts
  ON
    sf_accounts.vendor_code=pd_vendors.vendor_code
    AND sf_accounts.global_entity_id=pd_vendors.global_entity_id,
    UNNEST(sf_accounts.addresses) AS sf_addresses
  CROSS JOIN
    date_month
  WHERE
    pd_vendors.global_entity_id = 'MJM_AT'
    AND NOT is_test
    AND is_active   and sf_addresses.address_type LIKE "%Restaurant Address%" )
    ,
  cicle AS (
  SELECT 
  distinct
  
    pd_orders.*,
    pd_vendors.*,
  FROM
    pd_vendors
  LEFT JOIN
    pd_orders
  ON
    pd_vendors.vendor_uuid = pd_orders.pd_vendor_uuid
    AND pd_vendors.vendor_global_entity_id = pd_orders.global_entity_id
    AND pd_vendors.iso_date = pd_orders.date_local 
 
    ) ,
  main_metrics AS (
  SELECT
    cicle.global_entity_id,iso_week,
    iso_date date_local,
    order_delivery_address_city,
    chain_name,
    chain_code,
    cicle.vendor_code,
    vendor_name,
    vertical_type,
    restaurant_street,
    restaurant_city,
    postal_code,
    business_type,
    gmv_vendor_grade,
    -- is_key_account,
    is_billable,
    is_online_payment,
    is_voucher_used,
    delivery_type, min_delivery_value,

      vr.rating,vr.topic,
    COUNT( DISTINCT
      CASE
        WHEN is_online_payment AND is_valid_order THEN order_uuid
    END
      ) AS payment_online,
    COUNT(DISTINCT order_uuid) AS total_number_of_orders,

    COUNT(DISTINCT
    IF
      (is_valid_order, order_id, NULL)) AS total_number_of_successful_orders,
    COUNT(DISTINCT
    IF
      (is_failed_order, order_id, NULL)) AS total_number_of_failed_orders,
    COUNT(DISTINCT
    IF
      (status_code=67, order_id, NULL)) AS total_number_of_payment_failures,
    COUNT(DISTINCT
    IF
      (is_valid_order
        AND is_acquisition, analytical_customer_id, NULL)) AS acquisition,

COUNT(DISTINCT
    IF
      (is_valid_order
        AND is_pickup, order_id, NULL)) AS pickup_orders,
        
COUNT(DISTINCT
    IF
      (is_valid_order
        AND not is_pickup, order_id, NULL)) AS delivery_orders,


    COUNT(DISTINCT
    IF
      (is_valid_order, analytical_customer_id, NULL)) AS active_customer_count,
    COUNT(DISTINCT
    IF
      (is_valid_order
        AND is_delayed_10_mins, order_id, NULL)) AS total_number_of_delayed_10_mins_orders,

        COUNT(DISTINCT
    IF
      (is_valid_order
        AND is_delayed_35_mins, order_id, NULL)) AS total_number_of_delayed_35_mins_orders,
 
    COUNT(DISTINCT
    IF
      ( vendor_failed, order_id, NULL)) AS order_failed_vendor,
    COUNT(DISTINCT
    IF
      ( customer_failed, order_id, NULL)) AS order_failed_customer,
    COUNT(DISTINCT
    IF
      ( logistics_failed, order_id, NULL)) AS order_failed_logistics,
    AVG(CASE
        WHEN is_valid_order THEN delivery_time_in_minutes
    END
      ) AS avg_delivery_time_min,
    AVG(
      CASE
        WHEN is_valid_order THEN preparation_time_in_minutes
    END
      ) AS avg_prep_time_min,
    
   
    SUM(
    IF
      (is_valid_order, products_total_local, 0)) AS products_total_local,
    SUM(
    IF
      (is_valid_order, gmv_eur, 0)) AS total_gmv_eur,
    SUM(
    IF
      (is_valid_order, gfv_eur, 0)) AS total_gfv_eur,
  
    SUM(
    IF
      (is_valid_order, voucher_value_eur, 0)) AS total_voucher_value_eur,
    SUM(
    IF
      (is_valid_order, voucher_value_eur * (100 - voucher_ratio)/100, 0)) AS total_voucher_vendor_value_eur,
    SUM(CASE
        WHEN is_valid_order THEN delivery_fee_local
      ELSE
      0
    END
      ) AS delivery_fee,
    SUM(
    IF
      (is_valid_order, vat_amount_local, 0)) AS total_vat_amt_local,
    SUM(
      CASE
        WHEN is_valid_order THEN delivery_time_in_minutes
    END
      ) AS sum_delivery_time_min,
    SUM(
      CASE
        WHEN is_valid_order THEN preparation_time_in_minutes
    END
      ) AS sum_prep_time_min,
    SUM(
      CASE
        WHEN is_valid_order THEN promised_delivery_time_in_minutes
    END
      ) - SUM(delivery_time_in_minutes) AS diff_promised_delivery,
 
    COUNT( DISTINCT
    IF
      (has_valid_reordered_in_7days, order_id, NULL)) AS has_valid_reordered_in_7days,
   
    COUNT( DISTINCT
    IF
      (PreviousOrderVendorCode=cicle.vendor_code
        AND DATE_DIFF( created_date_local,PreviousOrderDate, day)<<=7, analytical_customer_id, NULL)) AS 
        has_valid_reordered_in_samevendor_7days_Customer,
    COUNT( DISTINCT
    IF
      (is_valid_order, analytical_customer_id, NULL)) AS Total_Customers,
  
  FROM
    cicle
  LEFT JOIN
    vendor_rating vr
  ON
    vr.entity_id =cicle.vendor_code
    and vr.date_rating = cicle.date_local
  GROUP BY global_entity_id,
  iso_week,iso_date,
    order_delivery_address_city,
    chain_name,
    chain_code,
    vendor_code,
    vendor_name,
    vertical_type,
    restaurant_street,
    restaurant_city,
    postal_code,
    business_type
    ,
    -- is_key_account,
    vr.rating,vr.topic,
    is_billable,
    is_online_payment,
 min_delivery_value,
    is_voucher_used,
    iso_week,
     gmv_vendor_grade,
    delivery_type
)
SELECT
  *
FROM
  main_metrics]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
