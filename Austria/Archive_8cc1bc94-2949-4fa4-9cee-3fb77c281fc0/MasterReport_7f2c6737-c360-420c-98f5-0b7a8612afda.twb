            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dha---bi-485' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='curated_data_shared' server-oauth='' username='tilo.mohaupt@foodora.at' workgroup-auth-mode='prompt' />
