            <run bold='true' fontalignment='1' fontcolor='#fc0107' fontsize='10'>Active Customers</run>
            <run fontalignment='1' fontcolor='#fc0107' fontsize='10'> which can be </run>
            <run fontalignment='1' fontcolor='#fc0107' fontsize='10' underline='true'>doubled for more than one vendor</run>
            <run fontalignment='1' fontcolor='#fc0107' fontsize='10'>, should not be taken as a source of truth in </run>
            <run fontalignment='1' fontcolor='#fc0107' fontsize='10' underline='true'>Grand Total</run>
            <run fontalignment='1' fontcolor='#fc0107' fontsize='10'>)</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Austria/workbooks/Masterreport_16227089710460/MonthlyView?rev=' id='MonthlyView' path='/t/Austria/workbooks/MasterReport' revision='' site='Austria' />
      <table>
        <view>
          <datasources>
            <datasource caption='Monthly Datasource' name='federated.0s5fhr30a136rk117vh7c0oy7s8u' />
          </datasources>
          <datasource-dependencies datasource='federated.0s5fhr30a136rk117vh7c0oy7s8u'>
            <column caption='% Orders failed by logistics ' datatype='real' name='[% Canceled by Customer (copy)_716635312198328322]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([order_failed_logistics])/sum([total_number_of_orders])' />
            </column>
            <column caption='% Orders failed by customer' datatype='real' name='[% Canceled by Vendor  (copy)_716635312197763073]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([order_failed_customer])/sum([total_number_of_orders])' />
            </column>
            <column caption='% Fail Rate (excl. payment)' datatype='real' name='[Calculation_1037939027788558336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_number_of_failed_orders]) / SUM([total_number_of_orders])' />
            </column>
            <column caption='Front end rating (out of 5)' datatype='real' name='[Calculation_1157425126074769408]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if  [topic] =  &apos;overall&apos; then [rating] else null end' />
            </column>
            <column caption='% Orders failed by Vendor ' datatype='real' name='[Calculation_1205838865449492480]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([order_failed_vendor])/sum([total_number_of_orders])' />
            </column>
            <column caption='% Payment Online ' datatype='real' name='[Calculation_125819380810055680]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([payment_online])/ sum([total_number_of_successful_orders])' />
            </column>
            <column caption='% Pickup Orders' datatype='real' name='[Calculation_206321180102033413]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([pickup_orders])/sum([total_number_of_successful_orders])' />
            </column>
            <column caption='% Vendor Reorder Rate 30 Days' datatype='real' name='[Calculation_4819062711039102977]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([has_valid_reordered_in_samevendor_30days_Customer])/SUM([active_customer_count])' />
            </column>
            <column caption='isZeroSuccessfulMonthly' datatype='boolean' name='[Calculation_4819062711041339395]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if (({Fixed [vendor_code],DATETRUNC(&apos;month&apos;,[date_local]): SUM([total_number_of_successful_orders])} = 0) )then TRUE ELSE FALSE END' />
            </column>
            <column caption='# Voucher Used' datatype='integer' name='[Calculation_4885068616328966144]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if[is_voucher_used]then [total_number_of_successful_orders] else 0 end)' />
            </column>
            <column caption='# Commissionable Orders ' datatype='integer' name='[Calculation_6893040753869094913]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if[is_billable] then [total_number_of_successful_orders] else 0 end)' />
            </column>
            <column caption='Avg GMV €' datatype='real' name='[Calculation_6893040753869185026]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_gmv_eur])/SUM([total_number_of_successful_orders])' />
            </column>
            <column caption='Avg delivery fee €' datatype='real' name='[Calculation_7956101326444797952]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([delivery_fee])/sum ([total_number_of_successful_orders])' />
            </column>
            <column caption='%  Payment Failure' datatype='real' name='[Calculation_93731219011051521]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_number_of_payment_failures]) / SUM([total_number_of_orders])' />
            </column>
            <column caption='Packaging rating (out of 5)' datatype='real' name='[Front end rating (copy) (copy) (copy)_1157425126080905221]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if  [topic] =  &apos;packaging&apos; then [rating] else null end' />
            </column>
            <column caption='Food rating (out of 5)' datatype='real' name='[Front end rating (copy)_1157425126080884739]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if  [topic] =  &apos;restaurant_food&apos; then [rating] else null end' />
            </column>
            <column caption='Rider rating (out of 5)' datatype='real' name='[Frontend Star Rating (copy)_1157425126075396097]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if  [topic] =  &apos;rider&apos; then [rating] else null end' />
            </column>
            <column caption='Avg GFV €' datatype='real' name='[Total GFV € (copy)_6893040754204078087]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_gfv_eur])/SUM([total_number_of_successful_orders])' />
            </column>
