      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_D536DE72063B4340BBAE74BBA91A4A78'>
            <properties context=''>
              <relation connection='bigquery.1qdkwja1lunpia10pa8s50ln1ktj' name='Custom SQL Query' type='text'><![CDATA[-- daily (edit)
WITH
dates AS (
  SELECT
     DISTINCT iso_date
  FROM
    `fulfillment-dwh-production.curated_data_shared_central_dwh.dates` 
    dim_dates
  WHERE
    iso_date >>= DATE_SUB(CURRENT_DATE, INTERVAL 6 MONTH)
    AND iso_date << current_date
    -- AND iso_date >>= '2022-06-01'
    ),
  pd_orders AS (
  SELECT 
  distinct pd_orders.uuid AS order_uuid,
    pd_orders.global_entity_id,
    pd_orders.country_name,
    pd_orders.delivery_address_city AS order_delivery_address_city,
    pd_orders.created_date_local AS date_local,
    pd_orders.created_date_local,
    pd_orders.id AS order_id,
    pd_orders.pd_vendor_uuid,
    dwho.analytical_customer_id,
    -- pd_orders.expedition_type,
    pd_orders.is_failed_order_vendor vendor_failed,
    pd_orders.is_failed_order_customer customer_failed,
    pd_orders.is_failed_order_foodpanda logistics_failed,
    pd_orders.code,
    -- pd_orders.is_billable,
billable_flag.is_billable,
    pd_orders.is_valid_order,
    pd_orders.is_preorder,
    pd_orders.is_gross_order,
    pd_orders.is_failed_order,
    pd_orders.delivery_time_in_minutes,
    pd_orders.preparation_time_in_minutes,
    pd_orders.promised_delivery_time_in_minutes,
    pd_orders.vat_amount_local,
pd_orders.is_pickup,
    pd_orders.total_value_local,
    pd_orders.minimum_delivery_value_local  min_delivery_value, 
    pd_orders.products_total_local,
    pd_orders.ordered_at_local,
    pd_orders.delivery_fee_local,
    pd_orders.status_code,

    pd_payment_types.is_online_payment,
    dwho.is_acquisition is_acquisition,
    pd_orders_agg_vouchers.voucher.value_eur AS voucher_value_eur,
    pd_orders_agg_vouchers.voucher.current_foodpanda_ratio AS voucher_ratio,
    pd_orders_agg_vouchers.is_voucher_used,

    (pd_orders.delivery_time_in_minutes-pd_orders.promised_delivery_time_in_minutes) >> 10 AS is_delayed_10_mins, 

    pd_orders.delivery_time_in_minutes - pd_orders.promised_delivery_time_in_minutes >> 35 AS is_delayed_35_mins,
    pd_orders_agg_accounting.gmv_eur AS gmv_eur,
    pd_orders_agg_accounting.gfv_eur AS gfv_eur,
   

  FROM
    `fulfillment-dwh-production.pandata_curated.pd_orders` AS pd_orders
left join 
`fulfillment-dwh-production.pandata_report.regional_eu__pd_orders_billing_flag` billable_flag
on pd_orders.global_entity_id = billable_flag.global_entity_id
and pd_orders.uuid = billable_flag.uuid
and pd_orders.id = billable_flag.id
and pd_orders.ordered_at_date_utc = billable_flag.ordered_at_date_utc

  LEFT JOIN
    `fulfillment-dwh-production.pandata_curated.pd_payment_types` AS pd_payment_types
  ON
    pd_payment_types.uuid = pd_orders.pd_payment_type_uuid
  LEFT JOIN
    `fulfillment-dwh-production.curated_data_shared_central_dwh.orders` dwho
  ON
    dwho.order_id=pd_orders.code
    AND dwho.global_entity_id=pd_orders.global_entity_id
    AND dwho.placed_at_local>>=DATE_SUB(current_date, INTERVAL 6 month)
    AND DATE(dwho.placed_at)>>=DATE_SUB(current_date, INTERVAL 6 month)

  LEFT JOIN
    `fulfillment-dwh-production.pandata_report.regional_eu__pd_orders_agg_accounting` AS pd_orders_agg_accounting
  ON
    pd_orders_agg_accounting.uuid = pd_orders.uuid
    AND pd_orders_agg_accounting.created_date_utc >>= DATE_SUB(CURRENT_DATE, INTERVAL 6 MONTH)
  LEFT JOIN
    `fulfillment-dwh-production.pandata_report.regional_eu__pd_orders_agg_vouchers` AS pd_orders_agg_vouchers
  ON
    pd_orders_agg_vouchers.uuid = pd_orders.uuid
    AND pd_orders_agg_vouchers.created_date_utc >>= DATE_SUB(CURRENT_DATE, INTERVAL 6 MONTH)
  WHERE
    pd_orders.global_entity_id = 'MJM_AT'
    AND pd_orders.created_date_utc <<>>current_date
    AND pd_orders.created_date_utc >>= DATE_SUB(CURRENT_DATE, INTERVAL 6 MONTH)
    and   billable_flag.created_date_utc >>= DATE_SUB(CURRENT_DATE, INTERVAL 6 MONTH)
    ),
  vendor_rating AS (
     SELECT distinct 
date_trunc(date(vr.timestamp),day) as date_rating,
content.entity_id,
last_value (FLOOR(ratings.rating *10) / 10 ) 

over ( partition by  content.entity_id,date_trunc(timestamp,week(monday))
order by date(date_trunc(vr.timestamp,week(monday)))
RANGE BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) as rating, 
topic
  FROM
    `fulfillment-dwh-production.curated_data_shared_data_stream.aggregated_rating_update_stream` vr,
    UNNEST(content.ratings) AS ratings
  WHERE
    content.global_entity_id = "MJM_AT" and
     DATE(timestamp) >>= DATE_SUB(CURRENT_DATE, INTERVAL 6 MONTH)
     and topic = 'overall'
  
  ),
    
  pd_vendors AS(
  SELECT
      dates.iso_date iso_date,
    pd_vendors.global_entity_id AS vendor_global_entity_id,
    pd_vendors.vendor_code,
    pd_vendors.uuid AS vendor_uuid,
    pd_vendors.chain_code,
    pd_vendors.name AS vendor_name,
    pd_vendors.chain_name,
    pd_vendors.vertical_type,
    pd_vendors.location.street AS restaurant_street,
    pd_vendors.location.city AS restaurant_city,
    pd_vendors.location.postal_code AS restaurant_zip,
    pd_vendors.business_type,
     CASE
    WHEN pd_vendors.chain_code IN ('cy1dd', 'ch5me', 'cs3hp', 'cv1yp', 'cv5kr', 'cd0mi', 'ce0wk', 'cv2oo', 'cd0fr', 'ch6oj', 'cl1ok', 'cu1op', 'ce6wv') THEN "GFS"
    WHEN pd_vendors.chain_code IN ('cy1zy', 'cl4df', 'cc9ca', 'ck9yw', 'cd7bo', 'ch9xl', 'cz4kc', 'cu0yk', 'ck0ke', 'cr1dc', 'cz1ez', 'cq2ml',
    'cn3ne', 'cp5wm', 'co7cn', 'cg6vv', 'cd4bs', 'cl9ie', 'co3pl', 'cb6lp', 'ct3xv', 'ck1uq', 'cw4go', 'cq6ba', 'cx5dk', 'cm9fx',
    'cg8dy', 'cc3xc', 'cq2jy', 'cz3ny', 'cf3rb') THEN "KA"
    WHEN pd_vendors.vendor_code IN ('gmeg', 'eebs', 'b3wh', 'cbw8', 'e9sq', 'ebyl', 'g381', 'hc65', 'hkvh', 'k7dc', 'k8wb', 'k824', 'lx8n', 'rg8k', 'ribz', 'tjnt', 'vbuy', 'xk9p', 'yypa', 'mpdw', 'tqo2', 'jqr4', 'llmj', 'hzi0', 'akoi', 'dt2k', 'jgy3', 'd0y1', 'k883', 'j4ss', 'kzrr', 'cn1x', 'v2gn', 'fqvv', 'thi6', 'txqq', 'uc6g', 'g0kq', 'o2ip', 'x975', 'ksa1', 'cewf', 'qa6f', 'l40v', 'uy3f', 'llxp', 'b9u3', 'hpz1', 'mwmn', 'edfk', 'ibf7') THEN "KA"
    ELSE sf_accounts.gmv_class
END AS gmv_vendor_grade, 

    -- pd_vendors.is_key_account,
    sf_addresses.postal_code AS postal_code,
    CASE
      WHEN pd_vendors.has_delivery_type_partner_delivery THEN "OD : Partner Delivery"
      WHEN pd_vendors.has_delivery_type_platform_delivery THEN "OD : Platform Delivery"
      WHEN pd_vendors.has_delivery_type_vendor_delivery THEN "MP"
  END
    AS delivery_type,
  FROM
    `fulfillment-dwh-production.pandata_curated.pd_vendors` AS pd_vendors
  LEFT JOIN
    `fulfillment-dwh-production.pandata_curated.sf_accounts` AS sf_accounts
  ON
    sf_accounts.vendor_code=pd_vendors.vendor_code
    AND sf_accounts.global_entity_id=pd_vendors.global_entity_id,
    UNNEST(sf_accounts.addresses) AS sf_addresses
  CROSS JOIN
    dates
  WHERE
    pd_vendors.global_entity_id = 'MJM_AT'
    AND NOT is_test
    AND is_active 
      and sf_addresses.address_type LIKE "%Restaurant Address%" ),


  cicle AS (
  SELECT
    pd_orders.*,
    pd_vendors.*,
  FROM
    pd_vendors
  LEFT JOIN
    pd_orders
  ON
    pd_vendors.vendor_uuid = pd_orders.pd_vendor_uuid
    AND pd_vendors.vendor_global_entity_id = pd_orders.global_entity_id
    AND pd_vendors.iso_date = pd_orders.date_local ),

  main_metrics AS (
  SELECT
    cicle.global_entity_id,
    iso_date date_local,
    order_delivery_address_city,
    chain_name,
    chain_code,
    cicle.vendor_code,
    vendor_name,
    vertical_type,
    restaurant_street,
    restaurant_city,
    postal_code,
    business_type,
    gmv_vendor_grade,
    -- is_key_account,
    is_billable,
    is_online_payment,
    is_voucher_used,
    delivery_type,
     min_delivery_value,
vr.rating,vr.topic,
 
    COUNT( DISTINCT
      CASE
        WHEN is_online_payment AND is_valid_order THEN order_uuid
    END
      ) AS payment_online,
    COUNT(DISTINCT order_uuid) AS total_number_of_orders,
    COUNT(DISTINCT
    IF
      (is_valid_order, order_id, NULL)) AS total_number_of_successful_orders,
    COUNT(DISTINCT
    IF
      (is_failed_order, order_id, NULL)) AS total_number_of_failed_orders,
    COUNT(DISTINCT
    IF
      (status_code=67, order_id, NULL)) AS total_number_of_payment_failures,
    COUNT(DISTINCT
    IF
      (is_valid_order
        AND is_acquisition, analytical_customer_id, NULL)) AS acquisition,
    COUNT(DISTINCT
    IF
      (is_valid_order, analytical_customer_id, NULL)) AS active_customer_count,
    COUNT(DISTINCT
    IF
      (is_valid_order
        AND is_delayed_10_mins, order_id, NULL)) AS total_number_of_delayed_10_mins_orders,
   COUNT(DISTINCT
    IF
      (is_valid_order
        AND is_delayed_35_mins, order_id, NULL)) AS total_number_of_delayed_35_mins_orders,

COUNT(DISTINCT
    IF
      (is_valid_order
        AND is_pickup, order_id, NULL)) AS pickup_orders,

COUNT(DISTINCT
    IF
      (is_valid_order
        AND not is_pickup, order_id, NULL)) AS delivery_orders,



    COUNT(DISTINCT
    IF
      ( vendor_failed, order_id, NULL)) AS order_failed_vendor,
    COUNT(DISTINCT
    IF
      ( customer_failed, order_id, NULL)) AS order_failed_customer,
    COUNT(DISTINCT
    IF
      ( logistics_failed, order_id, NULL)) AS order_failed_logistics,
    AVG(CASE
        WHEN is_valid_order THEN delivery_time_in_minutes
    END
      ) AS avg_delivery_time_min,
    AVG(
      CASE
        WHEN is_valid_order THEN preparation_time_in_minutes
    END
      ) AS avg_prep_time_min,

    SUM(
    IF
      (is_valid_order, products_total_local, 0)) AS products_total_local,
    SUM(
    IF
      (is_valid_order, gmv_eur, 0)) AS total_gmv_eur,
    SUM(
    IF
      (is_valid_order, gfv_eur, 0)) AS total_gfv_eur,
    SUM(
    IF
      (is_valid_order, voucher_value_eur, 0)) AS total_voucher_value_eur,
    SUM(
    IF
      (is_valid_order, voucher_value_eur * (100 - voucher_ratio)/100, 0)) AS total_voucher_vendor_value_eur,
    SUM(CASE
        WHEN is_valid_order THEN delivery_fee_local
      ELSE
      0
    END
      ) AS delivery_fee,
    SUM(
    IF
      (is_valid_order, vat_amount_local, 0)) AS total_vat_amt_local,
    SUM(
      CASE
        WHEN is_valid_order THEN delivery_time_in_minutes
    END
      ) AS sum_delivery_time_min,
    SUM(
      CASE
        WHEN is_valid_order THEN preparation_time_in_minutes
    END
      ) AS sum_prep_time_min,
    SUM(
      CASE
        WHEN is_valid_order THEN promised_delivery_time_in_minutes
    END
      ) - SUM(delivery_time_in_minutes) AS diff_promised_delivery,


    COUNT( DISTINCT
    IF
      (is_valid_order, analytical_customer_id, NULL)) AS Total_Customers,
  FROM
    cicle
  LEFT JOIN
    vendor_rating vr
  ON
    vr.entity_id =cicle.vendor_code
    and vr.date_rating = cicle.date_local
  GROUP BY
    global_entity_id,
    date_local,
    order_delivery_address_city,
    chain_name,
    chain_code,
    vendor_code,
    vendor_name,
    vertical_type,
    restaurant_street,
    restaurant_city,
    postal_code,
    business_type,
    -- is_key_account,
    vr.rating,vr.topic,
gmv_vendor_grade,
    is_billable,
    is_online_payment,
    is_voucher_used,
    delivery_type,
    min_delivery_value)
SELECT
  *
FROM
  main_metrics]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='Daily View'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>&lt;Sheet Name&gt;&#10;</run>
            <run fontalignment='1' fontsize='10'>(data available up to 3 months)</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#fc0107' fontsize='10'>(Important note: Master Report works on </run>
            <run bold='true' fontalignment='1' fontcolor='#fc0107' fontsize='10'>vendor level</run>
            <run fontalignment='1' fontcolor='#fc0107' fontsize='10'>. </run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#fc0107' fontsize='10'> KPIs such as </run>
            <run bold='true' fontalignment='1' fontcolor='#fc0107' fontsize='10'>Active Customers</run>
            <run fontalignment='1' fontcolor='#fc0107' fontsize='10'> which can be </run>
            <run fontalignment='1' fontcolor='#fc0107' fontsize='10' underline='true'>doubled for more than one vendor</run>
            <run fontalignment='1' fontcolor='#fc0107' fontsize='10'>, should not be taken as a source of truth in </run>
            <run fontalignment='1' fontcolor='#fc0107' fontsize='10' underline='true'>Grand Total</run>
            <run fontalignment='1' fontcolor='#fc0107' fontsize='10'>)</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Austria/workbooks/Masterreport_16227089710460/DailyView?rev=' id='DailyView' path='/t/Austria/workbooks/MasterReport' revision='' site='Austria' />
      <table>
        <view>
          <datasources>
            <datasource caption='Daily Datasource' name='federated.0jelz4i18aumoz1fddf300fzteg1' />
          </datasources>
          <datasource-dependencies datasource='federated.0jelz4i18aumoz1fddf300fzteg1'>
            <column caption='% Orders failed by logistics' datatype='real' name='[% Orders failed by custoamer (copy)_1606377715286548484]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([order_failed_logistics])/sum([total_number_of_orders])' />
            </column>
            <column caption='% Orders failed by vendor ' datatype='real' name='[% Orders failed by logistics (copy)_1606377715286839301]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([order_failed_vendor])/sum([total_number_of_orders])' />
            </column>
            <column caption='# Commissionable Orders' datatype='integer' name='[Calculation_1292533139840872453]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if[is_billable] then [total_number_of_orders] else 0 end)' />
            </column>
            <column caption='# Voucher Used' datatype='integer' name='[Calculation_1292533139845742600]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if[is_voucher_used]then [total_number_of_successful_orders] else 0 end)' />
            </column>
            <column caption='% Online Payment' datatype='real' name='[Calculation_1292533139863539722]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([payment_online])/ sum([total_number_of_successful_orders])' />
            </column>
            <column caption='% Fail Rate (excl. payment)' datatype='real' name='[Calculation_1292533139865427979]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_number_of_failed_orders])/sum([total_number_of_orders])' />
            </column>
            <column caption='Avg delivery fee €' datatype='real' name='[Calculation_1606377715282661376]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([delivery_fee])/sum ([total_number_of_successful_orders])' />
            </column>
            <column caption='% Orders failed by customer' datatype='real' name='[Calculation_1606377715286368259]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([order_failed_customer])/sum([total_number_of_orders])' />
            </column>
            <column caption='Food rating (out of 5)' datatype='real' name='[Calculation_1606377715288137734]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if  [topic] =  &apos;restaurant_food&apos; then [rating] else null end' />
            </column>
            <column caption='Front end rating (out of 5)' datatype='real' name='[Calculation_1606377715288293383]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if  [topic] =  &apos;overall&apos; then [rating] else null end' />
            </column>
            <column caption='% Pickup Orders' datatype='real' name='[Calculation_1606377715290071050]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([pickup_orders])/sum([total_number_of_successful_orders])' />
            </column>
            <column caption='isZeroSuccessfulWeekly' datatype='boolean' name='[Calculation_246923931080290305]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if (({Fixed [vendor_code],DATETRUNC(&apos;week&apos;,[date_local]): SUM([total_number_of_successful_orders])} = 0) )then TRUE ELSE FALSE END' />
            </column>
            <column caption='Avg GMV €' datatype='real' name='[Calculation_6893040753652547584]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_gmv_eur])/SUM([total_number_of_successful_orders])' />
            </column>
            <column caption='# Payment Failures' datatype='integer' name='[Calculation_6893040754191355908]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_number_of_payment_failures]' />
            </column>
            <column caption='% Payment Fail Rate' datatype='real' name='[Calculation_93731219013390338]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_6893040754191355908]) / SUM([total_number_of_orders])' />
            </column>
            <column caption='Avg GFV€' datatype='real' name='[Total GFV € (copy)_6893040754204078087]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_gfv_eur])/SUM([total_number_of_successful_orders])' />
            </column>
            <column datatype='integer' name='[Total_Customers]' role='measure' type='quantitative' />
            <column caption='# Acquisition' datatype='integer' name='[acquisition]' role='measure' type='quantitative' />
            <column caption='# Active customers' datatype='integer' name='[active_customer_count]' role='measure' type='quantitative' />
            <column-instance column='[avg_delivery_time_min]' derivation='Avg' name='[avg:avg_delivery_time_min:qk]' pivot='key' type='quantitative' />
            <column-instance column='[min_delivery_value]' derivation='Avg' name='[avg:min_delivery_value:qk]' pivot='key' type='quantitative' />
            <column-instance column='[total_voucher_vendor_value_eur]' derivation='Avg' name='[avg:total_voucher_vendor_value_eur:qk]' pivot='key' type='quantitative' />
            <column caption='Delivery time (min)' datatype='real' name='[avg_delivery_time_min]' role='measure' type='quantitative' />
            <column caption='Avg Prep time (min)' datatype='real' name='[avg_prep_time_min]' role='measure' type='quantitative' />
            <column datatype='string' name='[chain_name]' role='dimension' type='nominal' />
            <column datatype='date' name='[date_local]' role='dimension' type='ordinal' />
            <column caption='Total Delivery Fee €' datatype='real' name='[delivery_fee]' role='measure' type='quantitative' />
            <column datatype='string' name='[delivery_type]' role='dimension' type='nominal' />
            <column caption='# Late orders ' datatype='integer' name='[diff_promised_delivery]' role='measure' type='quantitative' />
            <column datatype='string' name='[gmv_vendor_grade]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[is_billable]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[is_voucher_used]' role='dimension' type='nominal' />
            <column caption='Minimum delivery value' datatype='real' name='[min_delivery_value]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_246923931080290305]' derivation='None' name='[none:Calculation_246923931080290305:nk]' pivot='key' type='nominal' />
            <column-instance column='[chain_name]' derivation='None' name='[none:chain_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[date_local]' derivation='None' name='[none:date_local:qk]' pivot='key' type='quantitative' />
            <column-instance column='[delivery_type]' derivation='None' name='[none:delivery_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[gmv_vendor_grade]' derivation='None' name='[none:gmv_vendor_grade:nk]' pivot='key' type='nominal' />
            <column-instance column='[postal_code]' derivation='None' name='[none:postal_code:nk]' pivot='key' type='nominal' />
            <column-instance column='[restaurant_city]' derivation='None' name='[none:restaurant_city:nk]' pivot='key' type='nominal' />
            <column-instance column='[restaurant_street]' derivation='None' name='[none:restaurant_street:nk]' pivot='key' type='nominal' />
            <column-instance column='[vendor_code]' derivation='None' name='[none:vendor_code:nk]' pivot='key' type='nominal' />
            <column-instance column='[vendor_name]' derivation='None' name='[none:vendor_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[vertical_type]' derivation='None' name='[none:vertical_type:nk]' pivot='key' type='nominal' />
            <column caption='# Orders failed by customer' datatype='integer' name='[order_failed_customer]' role='measure' type='quantitative' />
            <column caption='# Orders failed by logistics' datatype='integer' name='[order_failed_logistics]' role='measure' type='quantitative' />
            <column caption='# Orders failed by vendor' datatype='integer' name='[order_failed_vendor]' role='measure' type='quantitative' />
            <column caption='# Payment online ' datatype='integer' name='[payment_online]' role='measure' type='quantitative' />
            <column caption='# Pickup orders' datatype='integer' name='[pickup_orders]' role='measure' type='quantitative' />
            <column datatype='string' name='[postal_code]' role='dimension' type='nominal' />
            <column datatype='real' hidden='true' name='[rating]' role='measure' type='quantitative' />
            <column datatype='string' name='[restaurant_city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column datatype='string' name='[restaurant_street]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1606377715288137734]' derivation='Sum' name='[sum:Calculation_1606377715288137734:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1606377715288293383]' derivation='Sum' name='[sum:Calculation_1606377715288293383:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_6893040754191355908]' derivation='Sum' name='[sum:Calculation_6893040754191355908:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Total_Customers]' derivation='Sum' name='[sum:Total_Customers:qk]' pivot='key' type='quantitative' />
            <column-instance column='[acquisition]' derivation='Sum' name='[sum:acquisition:qk]' pivot='key' type='quantitative' />
            <column-instance column='[active_customer_count]' derivation='Sum' name='[sum:active_customer_count:qk]' pivot='key' type='quantitative' />
            <column-instance column='[avg_delivery_time_min]' derivation='Sum' name='[sum:avg_delivery_time_min:qk]' pivot='key' type='quantitative' />
            <column-instance column='[avg_prep_time_min]' derivation='Sum' name='[sum:avg_prep_time_min:qk]' pivot='key' type='quantitative' />
            <column-instance column='[delivery_fee]' derivation='Sum' name='[sum:delivery_fee:qk]' pivot='key' type='quantitative' />
