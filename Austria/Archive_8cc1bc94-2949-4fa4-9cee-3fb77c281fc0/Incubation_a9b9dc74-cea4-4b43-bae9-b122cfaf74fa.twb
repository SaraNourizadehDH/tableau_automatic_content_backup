            <column caption='Target Partner' datatype='string' name='[target_partner]' role='dimension' type='nominal' />
            <column-instance column='[onboarding_month]' derivation='Month-Trunc' name='[tmn:onboarding_month:qk]' pivot='key' type='quantitative' />
