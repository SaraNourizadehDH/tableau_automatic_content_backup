    <worksheet name='performance_kpis'>
      <repository-location id='performance_kpis' path='/t/Austria/workbooks/Incubation' revision='' site='Austria' />
      <table>
        <view>
          <datasources>
            <datasource caption='incubation (report_tables)' name='federated.11nk2cw16fdy1p1e2pa6e04h7xyi' />
          </datasources>
          <datasource-dependencies datasource='federated.11nk2cw16fdy1p1e2pa6e04h7xyi'>
            <column caption='AVG at Vendor Time Cleaned' datatype='real' name='[Calculation_892275686182903810]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([at_vendor_time_cleaned_sum])/SUM([at_vendor_time_cleaned_count])' />
            </column>
            <column caption='Rider Late Over 5' datatype='real' name='[Calculation_892275686183059459]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_late_over_5_count])/SUM([rider_late_all_count])' />
            </column>
            <column caption='Rider Late Over 10' datatype='real' name='[Calculation_892275686183243780]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_late_over_10_count])/SUM([rider_late_all_count])' />
            </column>
            <column caption='Vendor Late Over 5' datatype='real' name='[Calculation_892275686183362565]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_over_5_count])/SUM([vendor_late_all_count])' />
            </column>
            <column caption='Vendor Late Over 10' datatype='real' name='[Calculation_892275686183538694]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_over_10_count])/SUM([vendor_late_all_count])' />
            </column>
            <column caption='Vendor Late Over 15' datatype='real' name='[Calculation_892275686183653383]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_over_15_count])/SUM([vendor_late_all_count])' />
            </column>
            <column caption='Offline Time ' datatype='real' name='[Calculation_892275686183763976]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([unavailable_hours])/SUM([scheduled_hours])' />
            </column>
            <column caption='% Failed by Vendor' datatype='real' name='[Calculation_892275686184050697]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_orders_vendor])/SUM([total_orders])' />
            </column>
