      <repository-location derived-from='https://tableau.deliveryhero.net/t/Austria/workbooks/Incubation/avg_orders_per_cohort?rev=' id='orders_per_cohort' path='/t/Austria/workbooks/Incubation' revision='' site='Austria' />
      <table>
        <view>
          <datasources>
            <datasource caption='incubation (report_tables)' name='federated.11nk2cw16fdy1p1e2pa6e04h7xyi' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Metric' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Avg Orders&quot;'>
              <calculation class='tableau' formula='&quot;Avg Orders&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.11nk2cw16fdy1p1e2pa6e04h7xyi'>
            <column caption='Orders' datatype='real' name='[Calculation_1338413525690355712]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Total Orders&apos; THEN SUM([successful_orders])&#13;&#10;WHEN &apos;Avg Orders&apos; THEN AVG([successful_orders])&#13;&#10;END' />
            </column>
            <column caption='is_current_month' datatype='boolean' name='[Calculation_1338413525704282113]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [report_month]= DATETRUNC(&apos;month&apos;, TODAY()) THEN TRUE&#13;&#10;ELSE  FALSE&#13;&#10;END' />
            </column>
            <column caption='FSA' datatype='string' name='[fsa]' role='dimension' type='nominal' />
            <column caption='Is GFS' datatype='boolean' name='[is_gfs]' role='dimension' type='nominal' />
            <column caption='Is KA' datatype='boolean' name='[is_ka]' role='dimension' type='nominal' />
            <column-instance column='[onboarding_month]' derivation='MY' name='[my:onboarding_month:ok]' pivot='key' type='ordinal' />
            <column-instance column='[report_month]' derivation='MY' name='[my:report_month:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_1338413525704282113]' derivation='None' name='[none:Calculation_1338413525704282113:nk]' pivot='key' type='nominal' />
            <column-instance column='[fsa]' derivation='None' name='[none:fsa:nk]' pivot='key' type='nominal' />
