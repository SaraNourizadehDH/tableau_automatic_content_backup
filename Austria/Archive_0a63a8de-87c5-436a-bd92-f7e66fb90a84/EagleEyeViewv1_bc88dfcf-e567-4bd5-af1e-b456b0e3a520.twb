  SELECT
    DATE_TRUNC(date_local, Week) AS Week,
    COUNT(DISTINCT vendor_code) AS Vendor_Number,
    SUM(count_of_shop_list_loaded) Vendor_list_views,
    SUM(count_of_shop_menu_loaded) Vendor_menu_views,
