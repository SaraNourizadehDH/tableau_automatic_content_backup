              <zone forceUpdate='true' h='7064' id='38' type-v2='text' w='90117' x='471' y='421'>
                <formatted-text>
                  <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='15'>EAGLE EYE </run>
                  <run fontalignment='1'>Æ&#10;</run>
                  <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='12'>Weekly Holistic Perspective on MJAM Business</run>
                  <run fontalignment='1'>Æ&#10;&#10;</run>
                  <run bold='true' fontalignment='1' fontcolor='#59a14f' fontsize='12'>Funnel Start: Frontend Demand KPIs</run>
                  <run fontalignment='1'>Æ&#10;</run>
                  <run fontalignment='1' fontcolor='#59a14f'>You can find the </run>
                  <run bold='true' fontalignment='1' fontcolor='#59a14f'>session(customer)</run>
                  <run fontalignment='1' fontcolor='#59a14f'> perspective on the </run>
                  <run bold='true' fontalignment='1' fontcolor='#59a14f'>left</run>
                  <run fontalignment='1' fontcolor='#59a14f'> and </run>
                  <run bold='true' fontalignment='1' fontcolor='#59a14f'>Vendor</run>
                  <run fontalignment='1' fontcolor='#59a14f'> perspective on the </run>
                  <run bold='true' fontalignment='1' fontcolor='#59a14f'>right</run>
                  <run fontalignment='1' fontcolor='#59a14f'>.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='4316' id='39' type-v2='text' w='90117' x='471' y='28421'>
                <formatted-text>
                  <run bold='true' fontalignment='1' fontcolor='#59a14f' fontsize='14'>Funnel Step2: Order, GMV and Unit Economics</run>
                  <run fontalignment='1'>Æ&#10;</run>
                  <run fontalignment='1' fontcolor='#59a14f'>This part shows the weekly development of orders and unit economics changes over selected time period. The table on the right shows the changes in revenue items( Delivery Fee, MOV fee, and comission)</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
