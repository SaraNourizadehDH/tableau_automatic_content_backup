    <worksheet name='Failed Orders'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Fail Performance </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Weekly Orders' name='federated.0c0jxfn122c80910gtyom1210ebw' />
          </datasources>
          <datasource-dependencies datasource='federated.0c0jxfn122c80910gtyom1210ebw'>
            <column caption='Cancelled Orders' datatype='integer' name='[Calculation_212795111723307009]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM( if [is_cancelled] THEN [Orders] ELSE null END)' />
            </column>
            <column caption='Declined Orders' datatype='integer' name='[Calculation_212795111723827202]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM( if [is_declined] THEN [Orders] ELSE null END)' />
            </column>
            <column caption='Failed Orders' datatype='integer' name='[Calculation_212795111723986948]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM( if [is_failed] THEN [Orders] ELSE null END)' />
            </column>
            <column caption='Cancelled Order share %' datatype='real' name='[Failed Order share % (copy)_4911668009263632396]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_212795111723307009]/sum([Orders])' />
            </column>
            <column caption='Declined Order share %' datatype='real' name='[Failed Order share % (copy)_4911668009263693837]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [is_declined] THEN [Orders] ELSE NULL END)/SUM([Orders])' />
            </column>
            <column caption='Failed Order share %' datatype='real' name='[OD Order share % (copy)_4911668009263407115]' role='measure' type='quantitative'>
