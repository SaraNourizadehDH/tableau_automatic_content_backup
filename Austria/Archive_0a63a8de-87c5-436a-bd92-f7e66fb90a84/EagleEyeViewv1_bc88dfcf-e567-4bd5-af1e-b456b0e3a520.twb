            <properties context=''>
              <relation connection='bigquery.02dz3tp0txfd9c1h6ap6c0afv0pi' name='Custom SQL Query' type='text'>WITH
  sessions AS (
  SELECT
    DATE_TRUNC(date_utc, Week) AS Week,
    SUM(sessions) sessions,
    SUM(sessions_with_transactions) sessions_with_transactions,
    SUM(transactions) transactions
