              <zone forceUpdate='true' h='3737' id='49' type-v2='text' w='90117' x='471' y='58000'>
                <formatted-text>
                  <run bold='true' fontalignment='1' fontcolor='#59a14f' fontsize='15'>Funnel 3: After</run>
                  <run fontalignment='1'>Æ&#10;</run>
                  <run fontalignment='1' fontcolor='#59a14f'>The table on the left shows the total </run>
                  <run bold='true' fontalignment='1' fontcolor='#59a14f'>customers </run>
                  <run fontalignment='1' fontcolor='#59a14f'>purchased, and the relative </run>
                  <run bold='true' fontalignment='1' fontcolor='#59a14f'>new customers</run>
                  <run fontalignment='1' fontcolor='#59a14f'>  in that week. </run>
                  <run fontalignment='1'>Æ&#10;</run>
                  <run fontalignment='1' fontcolor='#59a14f'>The table on the right sums up the</run>
                  <run bold='true' fontalignment='1' fontcolor='#59a14f'> failed order statuses</run>
                  <run fontalignment='1' fontcolor='#59a14f'>. A fail can be declined, cancelled, or error. </run>
