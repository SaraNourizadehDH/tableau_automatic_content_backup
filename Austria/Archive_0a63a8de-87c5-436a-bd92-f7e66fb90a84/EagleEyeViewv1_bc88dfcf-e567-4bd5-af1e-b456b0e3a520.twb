    <worksheet name='Details Check'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Vertical Shares and Subsidies</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Weekly Orders' name='federated.0c0jxfn122c80910gtyom1210ebw' />
          </datasources>
          <datasource-dependencies datasource='federated.0c0jxfn122c80910gtyom1210ebw'>
            <column datatype='integer' name='[Acquisitions]' role='measure' type='quantitative' />
            <column caption='Discount Orders' datatype='integer' name='[Calculation_212795111723913219]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM( if [is_discount] THEN [Orders] ELSE null END)' />
            </column>
            <column caption='OD orders' datatype='integer' name='[Calculation_212795111724167173]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM( if [is_own_delivery] THEN [Orders] ELSE null END)' />
            </column>
            <column caption='Qcommerce Orders' datatype='integer' name='[Calculation_212795111724400646]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM( if [is_qcommerce] THEN [Orders] ELSE null END)' />
            </column>
            <column caption='Voucher Orders' datatype='integer' name='[Calculation_212795111724486663]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM( if [is_voucher] THEN [Orders] ELSE null END)' />
            </column>
            <column caption='OD Order share %' datatype='real' name='[Calculation_212795111744344084]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [is_own_delivery] THEN [Orders] ELSE NULL END)/SUM([Orders])' />
            </column>
            <column caption='Discount Orders GMV' datatype='real' name='[Discount Orders (copy)_5834694826930982916]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM( if [is_discount] THEN [gmv_eur] ELSE null END)' />
            </column>
            <column caption='Qcommerce AOV ' datatype='real' name='[OD AOV (copy)_4911668009260249095]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [is_qcommerce] THEN [gmv_eur] ELSE NULL END)/SUM(if [is_qcommerce] THEN [Orders] ELSE NULL END)' />
            </column>
            <column caption='Qcommerce Order share %' datatype='real' name='[OD Order share % (copy)_4911668009259094021]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [is_qcommerce] THEN [Orders] ELSE NULL END)/SUM([Orders])' />
            </column>
            <column caption='OD AOV' datatype='real' name='[OD Order share % (copy)_4911668009259667462]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [is_own_delivery] THEN [gmv_eur] ELSE NULL END)/SUM(if [is_own_delivery] THEN [Orders] ELSE NULL END)' />
            </column>
            <column datatype='integer' name='[Orders]' role='measure' type='quantitative' />
            <column caption='Voucher Orders GMV' datatype='real' name='[Voucher Orders (copy)_5834694826930040835]' role='measure' type='quantitative'>
