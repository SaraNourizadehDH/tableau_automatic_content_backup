        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1cctlgn06dbl5616tuy5o0nfq53s' name='Custom SQL Query' type='text'><![CDATA[SELECT
  lg.created_date_local,
  CAST(rider.to_customer_time_in_seconds/60 AS INT64) to_Customer_min,
  CAST(CAST(rider.to_customer_time_in_seconds/60 AS INT64) AS String) to_Customer_min_string,
  CAST(rider.actual_delivery_time_in_seconds/60 AS INT64 ) delivery_time,
  CASE
    WHEN CAST(rider.actual_delivery_time_in_seconds/60 AS INT64 ) = 0 THEN '0'
    WHEN CAST(rider.actual_delivery_time_in_seconds/60 AS INT64 ) <<=5 THEN '0-5'
    WHEN CAST(rider.actual_delivery_time_in_seconds/60 AS INT64 ) <<=10 THEN '5-10'
    WHEN CAST(rider.actual_delivery_time_in_seconds/60 AS INT64 ) <<=15 THEN '10-15'
    WHEN CAST(rider.actual_delivery_time_in_seconds/60 AS INT64 ) <<=20 THEN '15-20'
    WHEN CAST(rider.actual_delivery_time_in_seconds/60 AS INT64 ) <<=25 THEN '20-25'
    WHEN CAST(rider.actual_delivery_time_in_seconds/60 AS INT64 ) <<=30 THEN '25-30'
    WHEN CAST(rider.actual_delivery_time_in_seconds/60 AS INT64 ) <<=35 THEN '30-35'
    WHEN CAST(rider.actual_delivery_time_in_seconds/60 AS INT64 ) <<=40 THEN '35-40'
    WHEN CAST(rider.actual_delivery_time_in_seconds/60 AS INT64 ) <<=45 THEN '40-45'
    WHEN CAST(rider.actual_delivery_time_in_seconds/60 AS INT64 ) <<=50 THEN '45-50'
    WHEN CAST(rider.actual_delivery_time_in_seconds/60 AS INT64 ) <<=55 THEN '50-55'
    WHEN CAST(rider.actual_delivery_time_in_seconds/60 AS INT64 ) <<=60 THEN '55-60'
    WHEN CAST(rider.actual_delivery_time_in_seconds/60 AS INT64 ) <<=60 THEN '+60'
END
  AS DT_Bucket,
  pd.delivery_address_city AS delivery_address_city,
  COUNT(DISTINCT lg.uuid) AS Orders
FROM
  `fulfillment-dwh-production.pandata_curated.lg_orders` lg
left join 
`fulfillment-dwh-production.pandata_curated.pd_orders` pd
on pd.global_entity_id=lg.global_entity_id
and pd.code = lg.order_code
and pd.delivery_address_city_uuid= lg.rider.lg_city_uuid
WHERE
  lg.created_date_utc >>= "2021-08-01"
  and pd.created_date_utc <<>> current_date
  AND lg.global_entity_id='MJM_AT'
  AND lg.vendor.order_status='completed'
GROUP BY
  1,
  2,
  3,
  4,
  5,
  6]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
