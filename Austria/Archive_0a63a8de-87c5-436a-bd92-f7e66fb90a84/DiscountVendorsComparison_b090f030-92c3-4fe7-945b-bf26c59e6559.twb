                <relation connection='bigquery.118ynav129h7as12v4pdq0v6kwm0' name='Custom SQL Query' type='text'><![CDATA[WITH
  discount_vendors AS (
    SELECT
        pdv.uuid,
        pdv.location.city,
        discounts.title
      FROM
        `fulfillment-dwh-production.pandata_curated.pd_vendors` pdv
      LEFT JOIN
        pdv.discounts discounts
      WHERE
        pdv.global_entity_id='MJM_AT'
        AND discounts.is_active
        AND date_trunc(<[Parameters].[First X Days (copy) (copy)_5988943114893811713]>,month) = date_trunc(discounts.start_date_local, month)
      UNION DISTINCT
      SELECT
        pdv.uuid,
        pdv.location.city,
        mc.title
      FROM
        `fulfillment-dwh-production.pandata_curated.pd_vendors_agg_menus` pdam
      LEFT JOIN
        UNNEST(pdam.menu_categories) mc
      LEFT JOIN
        `fulfillment-dwh-production.pandata_curated.pd_vendors` pdv
      ON
        pdv.uuid = pdam.uuid
      WHERE
        pdam.global_entity_id='MJM_AT'
        AND (mc.title LIKE '%-%auf%' or lower(mc.title) LIKE '%combo%deal%')
        AND not mc.is_deleted
  )
SELECT
  DATE_TRUNC(pdo.created_date_utc,month) date_month,
  pdo.vendor_code,
  pdv.location.city,
  pdv.location.city IN (
  SELECT
    DISTINCT city
  FROM
    discount_vendors) is_discount_city,
  discount_vendors.uuid IS NOT NULL is_discount_vendor,
  COUNT(DISTINCT
  IF
    (pdo.is_valid_order,
      pdo.uuid,
      NULL)) successful_orders,
  COUNT(DISTINCT
  IF
    (o.customer_vendor_rank=1
      AND o.is_sent,
      o.analytical_customer_id,
      NULL)) new_customers,
  SUM(
  IF
    (pdo.is_valid_order,
      pdo.total_value_local,
      NULL)) total_gmv
FROM
  `fulfillment-dwh-production.pandata_curated.pd_orders` pdo
LEFT JOIN
  `fulfillment-dwh-production.curated_data_shared_central_dwh.orders` o
ON
  pdo.code = o.order_id
  AND pdo.global_entity_id=o.global_entity_id
  AND DATE(o.placed_at_local)>>='2021-06-01'
LEFT JOIN
  `fulfillment-dwh-production.pandata_curated.pd_vendors` pdv
ON
  pdo.pd_vendor_uuid= pdv.uuid
LEFT JOIN
  discount_vendors
ON
  discount_vendors.uuid = pdv.uuid
LEFT JOIN
  `fulfillment-dwh-production.pandata_curated.pd_orders_agg_discounts` pdd
ON
  pdo.uuid = pdd.uuid
  AND pdd.is_discount_used
  AND pdd.created_date_utc=pdo.created_date_utc
LEFT JOIN
  `fulfillment-dwh-production.pandata_curated.pd_orders_agg_accounting` pda
ON
  pdo.uuid = pda.uuid
  AND pdo.created_date_utc=pda.created_date_utc
WHERE
  pdo.global_entity_id='MJM_AT'
  AND ( DATE_TRUNC(pdo.created_date_utc, month) = <[Parameters].[First X Days (copy)_5988943114893803520]>
  OR DATE_TRUNC(pdo.created_date_utc, month) = <[Parameters].[First X Days (copy) (copy)_5988943114893811713]>)
  AND EXTRACT(day
  FROM
    pdo.created_date_utc)<<=<[Parameters].[Parameter 1]>
GROUP BY
  1,
  2,
  3,
  4,
  5]]></relation>
