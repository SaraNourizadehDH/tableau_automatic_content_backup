        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0nucsyq0jws3zq1h3aqiw0i8iwqq' name='Custom SQL Query' type='text'><![CDATA[WITH
  pd_orders AS (
  SELECT
    pd_orders.global_entity_id,
    pd_orders.country_name,
    pd_orders.delivery_address_city_id,
    pd_orders.delivery_address_city AS order_delivery_address_city,
    pd_orders.created_date_local  AS date_local,
    pd_orders.uuid AS order_uuid,
    pd_orders.id AS order_id,
    pd_orders.pd_vendor_uuid,
    pd_orders.pd_customer_uuid,
    pd_orders.expedition_type,
    pd_orders.code,
    pd_orders.is_billable,
    pd_orders.is_valid_order,
    pd_orders.is_preorder,
    pd_orders.is_gross_order,
    pd_orders.is_failed_order,
    pd_orders.delivery_time_in_minutes,
    pd_orders.preparation_time_in_minutes,
    pd_orders.promised_delivery_time_in_minutes,
    pd_orders.total_value_local,
    pd_orders.minimum_delivery_value_local,
    pd_orders.products_total_local,
    pd_orders.payable_total_local,
    pd_orders.delivery_fee_local,
    -- mr.food_rating,
    -- mr.packaging_rating,
    -- mr.rider_rating,
    -- mr.punctuality_rating,
    -- mr.order_code reviewed_order_code,
    has_valid_reordered_in_90days,
    has_valid_reordered,
 
    acid.central_analytical_customer_id,
 IF
    (cust.analytical_customer_id IS NOT NULL,
      TRUE,
      FALSE) is_acquisition,
    pd_orders_agg_accounting.gmv_eur AS gmv_eur,
    pd_orders_agg_accounting.gfv_eur AS gfv_eur,
     CASE
      WHEN (pd_vendors.has_delivery_type_vendor_delivery AND (pd_vendors.has_delivery_type_partner_delivery OR pd_vendors.has_delivery_type_platform_delivery )) THEN "Both MP & OD"
      WHEN pd_vendors.has_delivery_type_partner_delivery THEN "OD : Partner Delivery"
      WHEN pd_vendors.has_delivery_type_platform_delivery THEN "OD : Platform Delivery"
      WHEN pd_vendors.has_delivery_type_vendor_delivery THEN "MP"
  END
    AS delivery_type,
  FROM
    `fulfillment-dwh-production.pandata_curated.pd_orders` AS pd_orders
    left join 
    `fulfillment-dwh-production.pandata_curated.pd_vendors` AS pd_vendors
    on pd_vendors.uuid = pd_orders.pd_vendor_uuid
  LEFT JOIN
    `fulfillment-dwh-production.pandata_curated.pd_orders_agg_status_flows` AS pd_orders_agg_status_flows
  ON
    pd_orders_agg_status_flows.uuid = pd_orders.uuid
    AND pd_orders_agg_status_flows.created_date_utc >>= DATE_SUB(CURRENT_DATE, INTERVAL 6 MONTH)
  LEFT JOIN
    `fulfillment-dwh-production.pandata_curated.pd_customers_agg_orders` AS pd_customers_agg_orders
  ON
    pd_customers_agg_orders.uuid = pd_orders.pd_customer_uuid

  LEFT JOIN
    `fulfillment-dwh-production.pandata_curated.pd_customers` pd_customers
  ON
    pd_customers.uuid = pd_orders.pd_customer_uuid
    LEFT JOIN
    `fulfillment-dwh-production.pandata_curated.pd_orders_agg_customer_analytical_ids` acid
  ON
    acid.uuid = pd_orders.uuid
    AND acid.placed_date_utc>>=DATE_SUB(CURRENT_DATE, INTERVAL 6 MONTH)
  LEFT JOIN
    `fulfillment-dwh-production.curated_data_shared_central_dwh.agg_customers` cust
  ON
    cust.first_order_id = pd_orders.code and cust.global_entity_id=pd_orders.global_entity_id
  LEFT JOIN
    `fulfillment-dwh-production.pandata_report.pandora_pd_orders_agg_reorder_dates` AS pandora_pd_orders_agg_reorder_dates
  ON
    pandora_pd_orders_agg_reorder_dates.uuid = pd_orders.uuid
    AND pandora_pd_orders_agg_reorder_dates.ordered_at_date_local >>= DATE_SUB(CURRENT_DATE, INTERVAL 6 MONTH)
  
  LEFT JOIN
    `fulfillment-dwh-production.pandata_curated.pd_orders_agg_accounting` AS pd_orders_agg_accounting
  ON
    pd_orders_agg_accounting.uuid = pd_orders.uuid
    AND pd_orders_agg_accounting.created_date_utc >>= DATE_SUB(CURRENT_DATE, INTERVAL 6 MONTH)
--   LEFT JOIN (
--     SELECT
--       order_code,
--       global_entity_id,
--       created_date_utc,
--       SUM(
--       IF
--         (ratings.name = 'restaurant_food',
--           ratings.value,
--           0)) AS food_rating,
--       SUM(
--       IF
--         (ratings.name = 'packaging',
--           ratings.value,
--           0)) AS packaging_rating,
--       SUM(
--       IF
--         (ratings.name = 'rider',
--           ratings.value,
--           0)) AS rider_rating,
--       SUM(
--       IF
--         (ratings.name = 'punctuality',
--           ratings.value,
--           0)) AS punctuality_rating,
--     -- FROM
--     --   `fulfillment-dwh-production.pandata_curated.marvin_reviews`,
--       --UNNEST(ratings) AS ratings
--     GROUP BY
--       1,
--       2,
--       3 ) mr
--   ON
--     mr.order_code=pd_orders.code
--     AND mr.global_entity_id=pd_orders.global_entity_id
--     AND mr.created_date_utc<<>>current_date
  WHERE
    pd_orders.global_entity_id = 'MJM_AT'
    AND pd_orders.created_date_utc <<>>current_date
    AND pd_orders.created_date_utc >>= DATE_SUB(CURRENT_DATE, INTERVAL 6 MONTH)
    AND pd_orders.delivery_address_city IN ('Graz',
      'Salzburg',
      'Linz',
      'Wiener Neustadt',
      'Innsbruck',
      'Bregenz',
      'Klagenfurt am Wörthersee',
'Klagenfurt',
      'Villach',
      'Wels',
      'Baden',
      'Leoben',
      'Feldkirch',
      'Klosterneuburg',
      'Krems an der Donau',
      'Stockerau',
      'Tulln an der Donau',
      'Steyr',
      'Ansfelden',
      'Dornbirn',
      'Sankt Pölten' )),
  pd_vendors AS(
  SELECT
    pd_vendors.global_entity_id AS vendor_global_entity_id,
    pd_vendors.vendor_code,
    pd_vendors.uuid AS vendor_uuid,
    activated_date_utc,
    pd_vendors.chain_code,
    pd_vendors.name AS vendor_name,
    pd_vendors.chain_name,
    pd_vendors.location.street AS restaurant_street,
    pd_vendors.location.city AS restaurant_city,
    pd_vendors.location.postal_code AS restaurant_zip,
    pd_vendors.business_type,
    pd_vendors.is_active,
    pd_vendors.is_private,
    pd_vendors.is_key_account,    
    sf_accounts.name AS concept_name,
    sf_accounts.global_vendor_id AS concept_id
  FROM
    `fulfillment-dwh-production.pandata_curated.pd_vendors` AS pd_vendors
  JOIN
    `fulfillment-dwh-production.pandata_curated.pd_vendors_agg_business_types` AS pd_vendors_agg_business_types
  ON
    pd_vendors_agg_business_types.uuid = pd_vendors.uuid
  LEFT JOIN
    `fulfillment-dwh-production.pandata_curated.sf_accounts` AS sf_accounts
  ON
    sf_accounts.global_entity_id = pd_vendors.global_entity_id
    AND sf_accounts.global_vendor_id=pd_vendors.global_vendor_id
    AND sf_accounts.type = 'Branch - Virtual Restaurant'
  WHERE
    pd_vendors.global_entity_id = 'MJM_AT'
    AND location.city IN ('Graz',
      'Salzburg',
      'Linz',
      'Wiener Neustadt',
      'Innsbruck',
      'Bregenz',
      'Klagenfurt am Wörthersee',
'Klagenfurt',
      'Villach',
      'Wels',
      'Baden',
      'Leoben',
      'Feldkirch',
      'Klosterneuburg',
      'Krems an der Donau',
      'Stockerau',
      'Tulln an der Donau',
      'Steyr',
      'Ansfelden',
      'Dornbirn',
      'Sankt Pölten')),
  main_metrics AS (
  SELECT
    DATE_TRUNC(pd_orders.date_local, month) AS date,
    order_delivery_address_city AS city,
    AVG(
    IF
      (is_valid_order,
        pd_orders.delivery_time_in_minutes,
        NULL)) AS avg_delivery_time_in_minutes,
    AVG(
    IF
      (is_valid_order,
        pd_orders.preparation_time_in_minutes,
        NULL)) AS avg_preparation_time_in_minutes,
    AVG(
    IF
      (is_valid_order,
        pd_orders.promised_delivery_time_in_minutes,
        NULL)) AS avg_promised_delivery_time_in_minutes,
    AVG(
    IF
      (is_valid_order,
        pd_orders.minimum_delivery_value_local,
        NULL)) AS avg_minimum_delivery_value_local,
    AVG(
    IF
      (is_valid_order,
        pd_orders.payable_total_local,
        NULL)) AS avg_payable_total_local,
    AVG(
    IF
      (is_valid_order,
        pd_orders.delivery_fee_local,
        NULL)) AS avg_delivery_fee_local,
    SUM(
    IF
      (is_valid_order,
        products_total_local,
        NULL)) AS sum_products_total_local,
    SUM(
    IF
      (is_valid_order,
        pd_orders.total_value_local,
        NULL)) AS sum_total_value_local,
    SUM(
    IF
      (is_valid_order,
        payable_total_local,
        NULL)) AS sum_payable_total_local,
    SUM(
    IF
      (is_valid_order,
        delivery_fee_local,
        NULL)) AS sum_delivery_fee_local,
    COUNT(DISTINCT
    IF
      (is_valid_order,
        order_id,
        NULL)) AS total_orders,
    COUNT(DISTINCT
    IF
      (is_valid_order
        AND concept_id IS NOT NULL,
        order_id,
        NULL)) AS total_concept_orders,
    COUNT( DISTINCT
      CASE
        WHEN is_valid_order AND is_key_account THEN order_id
      ELSE
      NULL
    END
      ) AS ka_orders,
    COUNT(DISTINCT
    IF
      (is_valid_order
        AND delivery_type = "MP",
        order_id,
        NULL)) AS Marketplace,
         COUNT(DISTINCT
    IF
      (is_valid_order
        AND delivery_type = "OD : Partner Delivery",
        order_id,
        NULL)) AS Partner_Delivery_order,
               COUNT(DISTINCT
    IF
      (is_valid_order
        AND delivery_type = "OD : Platform Delivery",
        order_id,
        NULL)) AS Platform_Delivery_order,
        
    COUNT(DISTINCT
    IF
      (is_failed_order,
        order_id,
        NULL)) AS failed_orders,
    COUNT( DISTINCT
      CASE
        WHEN is_valid_order AND activated_date_utc = date_local THEN order_id
      ELSE
      NULL
    END
      ) AS new_restos_order,
    COUNT(DISTINCT
    IF
      (is_active,
        vendor_uuid,
        NULL)) AS Online_Restaurants,
    COUNT(DISTINCT
    IF
      (is_active
        AND concept_id IS NOT NULL,
        vendor_uuid,
        NULL)) AS Online_Concept_Restaurants,
    COUNT(DISTINCT
      CASE
        WHEN delivery_type = 'OD : Platform Delivery' OR delivery_type = 'OD : Partner Delivery' THEN vendor_uuid
    END
      ) AS online_od_resto,
    COUNT(DISTINCT
      CASE
        WHEN delivery_type = 'MP' THEN vendor_uuid
    END
      ) AS online_marketplace_resto,
    COUNT( DISTINCT
      CASE
        WHEN activated_date_utc = date_local THEN vendor_uuid
      ELSE
      NULL
    END
      ) AS new_online_restos,
    COUNT(DISTINCT
    IF
      (is_active
        AND is_key_account,
        vendor_uuid,
        NULL)) AS Online_KA_Restaurants,
    COUNT(DISTINCT
    IF
      (is_valid_order,
        pd_vendor_uuid,
        NULL)) AS active_restaurants,
    COUNT(DISTINCT
    IF
      (is_valid_order
        AND concept_id IS NOT NULL,
        pd_vendor_uuid,
        NULL)) AS active_Concept_restaurants,
    COUNT(DISTINCT
    IF
      (is_valid_order
        AND delivery_type = 'MP',
        pd_vendor_uuid,
        NULL)) AS active_Marketplace_Restaurant,
    COUNT(DISTINCT
      CASE
        WHEN is_valid_order AND (delivery_type = 'OD : Platform Delivery' or delivery_type = 'OD : Partner Delivery')  THEN pd_vendor_uuid
    END
      ) AS active_od_restaurant,
        
    COUNT(DISTINCT chain_code) AS chain,
    COUNT(DISTINCT
      CASE
        WHEN is_valid_order AND activated_date_utc=pd_orders.date_local THEN pd_vendor_uuid
    END
      ) AS new_active_resto,
    COUNT(DISTINCT
      CASE
        WHEN (delivery_type = 'OD : Platform Delivery' or delivery_type = 'OD : Partner Delivery')  AND activated_date_utc = pd_orders.date_local THEN pd_vendor_uuid
    END
      ) AS new_OD_restaurant,
      
       COUNT(DISTINCT
      CASE
        WHEN delivery_type = 'MP'  AND activated_date_utc = pd_orders.date_local THEN pd_vendor_uuid
    END
      ) AS new_MP_restaurant,
      
  
    -- SAFE_DIVIDE(SUM(food_rating),
    --   COUNT(DISTINCT reviewed_order_code)) AS food_rating,
    -- SAFE_DIVIDE(SUM(packaging_rating),
    --   COUNT(DISTINCT reviewed_order_code)) AS packaging_rating,
    -- SAFE_DIVIDE(SUM(rider_rating),
    --   COUNT(DISTINCT reviewed_order_code)) AS rider_rating,
    -- SAFE_DIVIDE(SUM(punctuality_rating),
    --   COUNT(DISTINCT reviewed_order_code)) AS punctuality_rating,
    COUNT(DISTINCT
    IF
      (is_valid_order
        AND is_acquisition,
        central_analytical_customer_id,
        NULL))  AS Acquisitions,
  COUNT(DISTINCT
    IF
      (is_valid_order,
        central_analytical_customer_id,
        NULL)) as active_customer,
    COUNT(DISTINCT
    IF
      (has_valid_reordered,
        pd_customer_uuid,
        NULL)) AS has_valid_reordered,
    COUNT(DISTINCT
    IF
      (has_valid_reordered_in_90days,
        pd_customer_uuid,
        NULL)) AS has_valid_reordered_in_90days,
  FROM
    pd_orders AS pd_orders
  full outer join  pd_vendors AS pd_vendors
  ON
   pd_orders.pd_vendor_uuid = pd_vendors.vendor_uuid and pd_vendors.restaurant_city = pd_orders.order_delivery_address_city
  GROUP BY
    1,
    2 )
SELECT
  *
FROM
  main_metrics]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0nucsyq0jws3zq1h3aqiw0i8iwqq' name='Custom SQL Query' type='text'><![CDATA[WITH
  pd_orders AS (
  SELECT
    pd_orders.global_entity_id,
    pd_orders.country_name,
    pd_orders.delivery_address_city_id,
    pd_orders.delivery_address_city AS order_delivery_address_city,
    pd_orders.created_date_local  AS date_local,
    pd_orders.uuid AS order_uuid,
    pd_orders.id AS order_id,
    pd_orders.pd_vendor_uuid,
    pd_orders.pd_customer_uuid,
    pd_orders.expedition_type,
    pd_orders.code,
    pd_orders.is_billable,
    pd_orders.is_valid_order,
    pd_orders.is_preorder,
    pd_orders.is_gross_order,
    pd_orders.is_failed_order,
    pd_orders.delivery_time_in_minutes,
    pd_orders.preparation_time_in_minutes,
    pd_orders.promised_delivery_time_in_minutes,
    pd_orders.total_value_local,
    pd_orders.minimum_delivery_value_local,
    pd_orders.products_total_local,
    pd_orders.payable_total_local,
    pd_orders.delivery_fee_local,
    -- mr.food_rating,
    -- mr.packaging_rating,
    -- mr.rider_rating,
    -- mr.punctuality_rating,
    -- mr.order_code reviewed_order_code,
    has_valid_reordered_in_90days,
    has_valid_reordered,
 
    acid.central_analytical_customer_id,
 IF
    (cust.analytical_customer_id IS NOT NULL,
      TRUE,
      FALSE) is_acquisition,
    pd_orders_agg_accounting.gmv_eur AS gmv_eur,
    pd_orders_agg_accounting.gfv_eur AS gfv_eur,
     CASE
      WHEN (pd_vendors.has_delivery_type_vendor_delivery AND (pd_vendors.has_delivery_type_partner_delivery OR pd_vendors.has_delivery_type_platform_delivery )) THEN "Both MP & OD"
      WHEN pd_vendors.has_delivery_type_partner_delivery THEN "OD : Partner Delivery"
      WHEN pd_vendors.has_delivery_type_platform_delivery THEN "OD : Platform Delivery"
      WHEN pd_vendors.has_delivery_type_vendor_delivery THEN "MP"
  END
    AS delivery_type,
  FROM
    `fulfillment-dwh-production.pandata_curated.pd_orders` AS pd_orders
    left join 
    `fulfillment-dwh-production.pandata_curated.pd_vendors` AS pd_vendors
    on pd_vendors.uuid = pd_orders.pd_vendor_uuid
  LEFT JOIN
    `fulfillment-dwh-production.pandata_curated.pd_orders_agg_status_flows` AS pd_orders_agg_status_flows
  ON
    pd_orders_agg_status_flows.uuid = pd_orders.uuid
    AND pd_orders_agg_status_flows.created_date_utc >>= DATE_SUB(CURRENT_DATE, INTERVAL 6 MONTH)
  LEFT JOIN
    `fulfillment-dwh-production.pandata_curated.pd_customers_agg_orders` AS pd_customers_agg_orders
  ON
    pd_customers_agg_orders.uuid = pd_orders.pd_customer_uuid

  LEFT JOIN
    `fulfillment-dwh-production.pandata_curated.pd_customers` pd_customers
  ON
    pd_customers.uuid = pd_orders.pd_customer_uuid
    LEFT JOIN
    `fulfillment-dwh-production.pandata_curated.pd_orders_agg_customer_analytical_ids` acid
  ON
    acid.uuid = pd_orders.uuid
    AND acid.placed_date_utc>>=DATE_SUB(CURRENT_DATE, INTERVAL 6 MONTH)
  LEFT JOIN
    `fulfillment-dwh-production.curated_data_shared_central_dwh.agg_customers` cust
  ON
    cust.first_order_id = pd_orders.code and cust.global_entity_id=pd_orders.global_entity_id
  LEFT JOIN
    `fulfillment-dwh-production.pandata_report.pandora_pd_orders_agg_reorder_dates` AS pandora_pd_orders_agg_reorder_dates
  ON
    pandora_pd_orders_agg_reorder_dates.uuid = pd_orders.uuid
    AND pandora_pd_orders_agg_reorder_dates.ordered_at_date_local >>= DATE_SUB(CURRENT_DATE, INTERVAL 6 MONTH)
  
  LEFT JOIN
    `fulfillment-dwh-production.pandata_curated.pd_orders_agg_accounting` AS pd_orders_agg_accounting
  ON
    pd_orders_agg_accounting.uuid = pd_orders.uuid
    AND pd_orders_agg_accounting.created_date_utc >>= DATE_SUB(CURRENT_DATE, INTERVAL 6 MONTH)
--   LEFT JOIN (
--     SELECT
--       order_code,
--       global_entity_id,
--       created_date_utc,
--       SUM(
--       IF
--         (ratings.name = 'restaurant_food',
--           ratings.value,
--           0)) AS food_rating,
--       SUM(
--       IF
--         (ratings.name = 'packaging',
--           ratings.value,
--           0)) AS packaging_rating,
--       SUM(
--       IF
--         (ratings.name = 'rider',
--           ratings.value,
--           0)) AS rider_rating,
--       SUM(
--       IF
--         (ratings.name = 'punctuality',
--           ratings.value,
--           0)) AS punctuality_rating,
--     -- FROM
--     --   `fulfillment-dwh-production.pandata_curated.marvin_reviews`,
--       --UNNEST(ratings) AS ratings
--     GROUP BY
--       1,
--       2,
--       3 ) mr
--   ON
--     mr.order_code=pd_orders.code
--     AND mr.global_entity_id=pd_orders.global_entity_id
--     AND mr.created_date_utc<<>>current_date
  WHERE
    pd_orders.global_entity_id = 'MJM_AT'
    AND pd_orders.created_date_utc <<>>current_date
    AND pd_orders.created_date_utc >>= DATE_SUB(CURRENT_DATE, INTERVAL 6 MONTH)
    AND pd_orders.delivery_address_city IN ('Graz',
      'Salzburg',
      'Linz',
      'Wiener Neustadt',
      'Innsbruck',
      'Bregenz',
      'Klagenfurt am Wörthersee',
'Klagenfurt',
      'Villach',
      'Wels',
      'Baden',
      'Leoben',
      'Feldkirch',
      'Klosterneuburg',
      'Krems an der Donau',
      'Stockerau',
      'Tulln an der Donau',
      'Steyr',
      'Ansfelden',
      'Dornbirn',
      'Sankt Pölten' )),
  pd_vendors AS(
  SELECT
    pd_vendors.global_entity_id AS vendor_global_entity_id,
    pd_vendors.vendor_code,
    pd_vendors.uuid AS vendor_uuid,
    activated_date_utc,
    pd_vendors.chain_code,
    pd_vendors.name AS vendor_name,
    pd_vendors.chain_name,
    pd_vendors.location.street AS restaurant_street,
    pd_vendors.location.city AS restaurant_city,
    pd_vendors.location.postal_code AS restaurant_zip,
    pd_vendors.business_type,
    pd_vendors.is_active,
    pd_vendors.is_private,
    pd_vendors.is_key_account,    
    sf_accounts.name AS concept_name,
    sf_accounts.global_vendor_id AS concept_id
  FROM
    `fulfillment-dwh-production.pandata_curated.pd_vendors` AS pd_vendors
  JOIN
    `fulfillment-dwh-production.pandata_curated.pd_vendors_agg_business_types` AS pd_vendors_agg_business_types
  ON
    pd_vendors_agg_business_types.uuid = pd_vendors.uuid
  LEFT JOIN
    `fulfillment-dwh-production.pandata_curated.sf_accounts` AS sf_accounts
  ON
    sf_accounts.global_entity_id = pd_vendors.global_entity_id
    AND sf_accounts.global_vendor_id=pd_vendors.global_vendor_id
    AND sf_accounts.type = 'Branch - Virtual Restaurant'
  WHERE
    pd_vendors.global_entity_id = 'MJM_AT'
    AND location.city IN ('Graz',
      'Salzburg',
      'Linz',
      'Wiener Neustadt',
      'Innsbruck',
      'Bregenz',
      'Klagenfurt am Wörthersee',
'Klagenfurt',
      'Villach',
      'Wels',
      'Baden',
      'Leoben',
      'Feldkirch',
      'Klosterneuburg',
      'Krems an der Donau',
      'Stockerau',
      'Tulln an der Donau',
      'Steyr',
      'Ansfelden',
      'Dornbirn',
      'Sankt Pölten')),
  main_metrics AS (
  SELECT
    DATE_TRUNC(pd_orders.date_local, month) AS date,
    order_delivery_address_city AS city,
    AVG(
    IF
      (is_valid_order,
        pd_orders.delivery_time_in_minutes,
        NULL)) AS avg_delivery_time_in_minutes,
    AVG(
    IF
      (is_valid_order,
        pd_orders.preparation_time_in_minutes,
        NULL)) AS avg_preparation_time_in_minutes,
    AVG(
    IF
      (is_valid_order,
        pd_orders.promised_delivery_time_in_minutes,
        NULL)) AS avg_promised_delivery_time_in_minutes,
    AVG(
    IF
      (is_valid_order,
        pd_orders.minimum_delivery_value_local,
        NULL)) AS avg_minimum_delivery_value_local,
    AVG(
    IF
      (is_valid_order,
        pd_orders.payable_total_local,
        NULL)) AS avg_payable_total_local,
    AVG(
    IF
      (is_valid_order,
        pd_orders.delivery_fee_local,
        NULL)) AS avg_delivery_fee_local,
    SUM(
    IF
      (is_valid_order,
        products_total_local,
        NULL)) AS sum_products_total_local,
    SUM(
    IF
      (is_valid_order,
        pd_orders.total_value_local,
        NULL)) AS sum_total_value_local,
    SUM(
    IF
      (is_valid_order,
        payable_total_local,
        NULL)) AS sum_payable_total_local,
    SUM(
    IF
      (is_valid_order,
        delivery_fee_local,
        NULL)) AS sum_delivery_fee_local,
    COUNT(DISTINCT
    IF
      (is_valid_order,
        order_id,
        NULL)) AS total_orders,
    COUNT(DISTINCT
    IF
      (is_valid_order
        AND concept_id IS NOT NULL,
        order_id,
        NULL)) AS total_concept_orders,
    COUNT( DISTINCT
      CASE
        WHEN is_valid_order AND is_key_account THEN order_id
      ELSE
      NULL
    END
      ) AS ka_orders,
    COUNT(DISTINCT
    IF
      (is_valid_order
        AND delivery_type = "MP",
        order_id,
        NULL)) AS Marketplace,
         COUNT(DISTINCT
    IF
      (is_valid_order
        AND delivery_type = "OD : Partner Delivery",
        order_id,
        NULL)) AS Partner_Delivery_order,
               COUNT(DISTINCT
    IF
      (is_valid_order
        AND delivery_type = "OD : Platform Delivery",
        order_id,
        NULL)) AS Platform_Delivery_order,
        
    COUNT(DISTINCT
    IF
      (is_failed_order,
        order_id,
        NULL)) AS failed_orders,
    COUNT( DISTINCT
      CASE
        WHEN is_valid_order AND activated_date_utc = date_local THEN order_id
      ELSE
      NULL
    END
      ) AS new_restos_order,
    COUNT(DISTINCT
    IF
      (is_active,
        vendor_uuid,
        NULL)) AS Online_Restaurants,
    COUNT(DISTINCT
    IF
      (is_active
        AND concept_id IS NOT NULL,
        vendor_uuid,
        NULL)) AS Online_Concept_Restaurants,
    COUNT(DISTINCT
      CASE
        WHEN delivery_type = 'OD : Platform Delivery' OR delivery_type = 'OD : Partner Delivery' THEN vendor_uuid
    END
      ) AS online_od_resto,
    COUNT(DISTINCT
      CASE
        WHEN delivery_type = 'MP' THEN vendor_uuid
    END
      ) AS online_marketplace_resto,
    COUNT( DISTINCT
      CASE
        WHEN activated_date_utc = date_local THEN vendor_uuid
      ELSE
      NULL
    END
      ) AS new_online_restos,
    COUNT(DISTINCT
    IF
      (is_active
        AND is_key_account,
        vendor_uuid,
        NULL)) AS Online_KA_Restaurants,
    COUNT(DISTINCT
    IF
      (is_valid_order,
        pd_vendor_uuid,
        NULL)) AS active_restaurants,
    COUNT(DISTINCT
    IF
      (is_valid_order
        AND concept_id IS NOT NULL,
        pd_vendor_uuid,
        NULL)) AS active_Concept_restaurants,
    COUNT(DISTINCT
    IF
      (is_valid_order
        AND delivery_type = 'MP',
        pd_vendor_uuid,
        NULL)) AS active_Marketplace_Restaurant,
    COUNT(DISTINCT
      CASE
        WHEN is_valid_order AND (delivery_type = 'OD : Platform Delivery' or delivery_type = 'OD : Partner Delivery')  THEN pd_vendor_uuid
    END
      ) AS active_od_restaurant,
        
    COUNT(DISTINCT chain_code) AS chain,
    COUNT(DISTINCT
      CASE
        WHEN is_valid_order AND activated_date_utc=pd_orders.date_local THEN pd_vendor_uuid
    END
      ) AS new_active_resto,
    COUNT(DISTINCT
      CASE
        WHEN (delivery_type = 'OD : Platform Delivery' or delivery_type = 'OD : Partner Delivery')  AND activated_date_utc = pd_orders.date_local THEN pd_vendor_uuid
    END
      ) AS new_OD_restaurant,
      
       COUNT(DISTINCT
      CASE
        WHEN delivery_type = 'MP'  AND activated_date_utc = pd_orders.date_local THEN pd_vendor_uuid
    END
      ) AS new_MP_restaurant,
      
  
    -- SAFE_DIVIDE(SUM(food_rating),
    --   COUNT(DISTINCT reviewed_order_code)) AS food_rating,
    -- SAFE_DIVIDE(SUM(packaging_rating),
    --   COUNT(DISTINCT reviewed_order_code)) AS packaging_rating,
    -- SAFE_DIVIDE(SUM(rider_rating),
    --   COUNT(DISTINCT reviewed_order_code)) AS rider_rating,
    -- SAFE_DIVIDE(SUM(punctuality_rating),
    --   COUNT(DISTINCT reviewed_order_code)) AS punctuality_rating,
    COUNT(DISTINCT
    IF
      (is_valid_order
        AND is_acquisition,
        central_analytical_customer_id,
        NULL))  AS Acquisitions,
  COUNT(DISTINCT
    IF
      (is_valid_order,
        central_analytical_customer_id,
        NULL)) as active_customer,
    COUNT(DISTINCT
    IF
      (has_valid_reordered,
        pd_customer_uuid,
        NULL)) AS has_valid_reordered,
    COUNT(DISTINCT
    IF
      (has_valid_reordered_in_90days,
        pd_customer_uuid,
        NULL)) AS has_valid_reordered_in_90days,
  FROM
    pd_orders AS pd_orders
  full outer join  pd_vendors AS pd_vendors
  ON
   pd_orders.pd_vendor_uuid = pd_vendors.vendor_uuid and pd_vendors.restaurant_city = pd_orders.order_delivery_address_city
  GROUP BY
    1,
    2 )
SELECT
  *
FROM
  main_metrics]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
