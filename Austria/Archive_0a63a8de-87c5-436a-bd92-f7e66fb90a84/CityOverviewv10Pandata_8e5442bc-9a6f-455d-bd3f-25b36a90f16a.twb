        <calculation class='tableau' formula='AVG(IF DATETRUNC(&apos;month&apos;, date) &lt;&gt; DATETRUNC(&apos;month&apos;,{ FIXED : MAX(date) }) THEN [Marketplace] END)' />
      </column>
      <column caption='Mean Orders' datatype='real' name='[Mean Reorder Rate (copy)_5748563464378884109]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF DATETRUNC(&apos;month&apos;, date) &lt;&gt; DATETRUNC(&apos;month&apos;,{ FIXED : MAX(date) }) THEN [total_orders] END)' />
