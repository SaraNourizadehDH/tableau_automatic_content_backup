        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.03m45ul0g89sns1gzq37w0qlquot' name='Custom_SQL_Query' type='text'><![CDATA[WITH
  shrinks AS (
  SELECT
    city.city_id city_id,
    dae.created_date created_date,
    SUM(CASE
        WHEN dae.action = 'close' THEN dae.duration
      ELSE
      0
    END
      )/60 AS closure_time_min,
    SUM(CASE
        WHEN dae.action = 'shrink' THEN dae.duration
      ELSE
      0
    END
      )/60 AS shrink_time_min
  FROM
    `fulfillment-dwh-production.curated_data_shared.delivery_areas_events` dae
  WHERE
    is_active
    AND DATE_DIFF(CURRENT_DATE(), created_date, MONTH) <<=6
  GROUP BY
    1,
    2),
  vendor AS (
  SELECT
    v.created_date_local,
    od.city_name,
    od.city_id,
    ROUND(SAFE_DIVIDE(SUM(od.delivery_time_sum)/60,
        SUM(od.delivery_time_count)), 2) avg_delivery_time_min,
    ROUND(SAFE_DIVIDE(SUM(od.delivery_time_over_45_count),
        SUM(od.delivery_time_count)), 2) delivery_over_45_perc,

    ROUND(SAFE_DIVIDE(SUM(od.rider_vendor_on_time_count),SUM(od.delivery_time_count)), 2) delivery_on_time_perc
  FROM
    `fulfillment-dwh-production.curated_data_shared.vendor_kpi` v,
    UNNEST(own_deliveries) od
  WHERE
    DATE_DIFF(CURRENT_DATE(), created_date_local, MONTH) <<=6
  GROUP BY
    1,
    2,
    3)
SELECT
  * EXCEPT(city_id)
FROM
  vendor
LEFT JOIN
  shrinks s
ON
  s.city_id = vendor.city_id
  AND s.created_date = vendor.created_date_local]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
