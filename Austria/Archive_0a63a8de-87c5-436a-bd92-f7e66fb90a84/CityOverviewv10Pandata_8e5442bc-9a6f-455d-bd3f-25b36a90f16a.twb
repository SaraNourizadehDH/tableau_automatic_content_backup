    <worksheet name='orders (indicators)'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Austria/workbooks/CityOverviewv1_0-Pandata/ordersindicators?rev=' id='ordersindicators' path='/t/Austria/workbooks/CityOverviewv1_0-Pandata' revision='' site='Austria' />
      <table>
        <view>
          <datasources>
            <datasource caption='test/city' name='federated.1k2lrow109j269124jymf0c2yik3' />
          </datasources>
          <datasource-dependencies datasource='federated.1k2lrow109j269124jymf0c2yik3'>
            <column caption='Last Month -1' datatype='datetime' name='[Calculation_4203969529379254287]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEADD(&apos;month&apos;,-1,{ FIXED:MAX([date]) })' />
            </column>
            <column caption='Marketplace Share Indicator' datatype='integer' name='[Calculation_5748563464380096532]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Failure Rate Indicator' datatype='integer' name='[Calculation_5748563464384143414]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='KA Order Share Indicator' datatype='integer' name='[DHC Order Share Indicator (copy)_5748563464382570539]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='KA Orders Indicator' datatype='integer' name='[DHC Orders Indicator (copy)_5748563464382570540]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Last Month DHC Orders (copy)_5748563464382570541] &gt; [Mean DHC Orders (copy)_5748563464382570542] + [St Dev DHC Orders (copy)_5748563464382570543] THEN 2 ELSE 0 END' />
            </column>
            <column caption='New Restos Orders Indicator' datatype='integer' name='[DHC Orders Indicator (copy)_5748563464383381552]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Last Month DHC Orders (copy)_5748563464383381553] &gt; [Mean DHC Orders (copy)_5748563464383381554] + [St Dev DHC Orders (copy)_5748563464383381555] THEN 2 ELSE 0 END' />
            </column>
            <column caption='DHC Order Share Indicator' datatype='integer' name='[HFC Order Share Indicator (copy)_5748563464381882403]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='DHC Orders Indicator' datatype='integer' name='[HFC Orders Indicator (copy)_5748563464381882402]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Last Month HFC Orders (copy)_5748563464381882401] &gt; [Mean HFC Orders (copy)_5748563464381882404] + [St Dev HFC Orders (copy)_5748563464381882405] THEN 2 ELSE 0 END' />
            </column>
            <column caption='Last Month KA Orders' datatype='integer' name='[Last Month DHC Orders (copy)_5748563464382570541]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF DATETRUNC(&apos;month&apos;,date) = DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-1,{ FIXED:MAX([date]) })) THEN [ka_orders] END)' />
            </column>
            <column caption='Last Month New Resto Orders' datatype='integer' name='[Last Month DHC Orders (copy)_5748563464383381553]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF DATETRUNC(&apos;month&apos;,date) = DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-1,{ FIXED:MAX([date]) })) THEN [new_restos_order] END)' />
            </column>
            <column caption='Last Month DHC Orders' datatype='integer' name='[Last Month HFC Orders (copy)_5748563464381882401]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF DATETRUNC(&apos;month&apos;,date) = DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-1,{ FIXED:MAX([date]) })) THEN [total_concept_orders] END)' />
            </column>
            <column caption='Last Month Marketplace Orders' datatype='integer' name='[Last Month Orders (copy)_5748563464379629584]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF DATETRUNC(&apos;month&apos;,date) = DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-1,{ FIXED:MAX([date]) })) THEN [Marketplace] END)' />
            </column>
            <column caption='Last Month Orders' datatype='integer' name='[Last Month Reorder Rate (copy)_5748563464378884108]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF DATETRUNC(&apos;month&apos;,date) = DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-1,{ FIXED:MAX([date]) })) THEN [total_orders] END)' />
            </column>
            <column caption='Own Delivery Share Indicator' datatype='integer' name='[Marketplace Share Indicator (copy)_5748563464380780570]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='HFC Order Share Indicator' datatype='integer' name='[Marketplace Share Indicator (copy)_5748563464381673504]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column datatype='integer' name='[Marketplace]' role='measure' type='quantitative' />
            <column caption='Mean KA Orders' datatype='real' name='[Mean DHC Orders (copy)_5748563464382570542]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF DATETRUNC(&apos;month&apos;, date) &lt;&gt; DATETRUNC(&apos;month&apos;,{ FIXED : MAX(date) }) THEN [ka_orders] END)' />
            </column>
            <column caption='Mean New Restos Orders' datatype='real' name='[Mean DHC Orders (copy)_5748563464383381554]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF DATETRUNC(&apos;month&apos;, date) &lt;&gt; DATETRUNC(&apos;month&apos;,{ FIXED : MAX(date) }) THEN [new_restos_order] END)' />
            </column>
            <column caption='Mean DHC Orders' datatype='real' name='[Mean HFC Orders (copy)_5748563464381882404]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF DATETRUNC(&apos;month&apos;, date) &lt;&gt; DATETRUNC(&apos;month&apos;,{ FIXED : MAX(date) }) THEN [total_concept_orders] END)' />
            </column>
            <column caption='Mean Marketplace Orders' datatype='real' name='[Mean Orders (copy)_5748563464379719697]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF DATETRUNC(&apos;month&apos;, date) &lt;&gt; DATETRUNC(&apos;month&apos;,{ FIXED : MAX(date) }) THEN [Marketplace] END)' />
            </column>
            <column caption='Mean Orders' datatype='real' name='[Mean Reorder Rate (copy)_5748563464378884109]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF DATETRUNC(&apos;month&apos;, date) &lt;&gt; DATETRUNC(&apos;month&apos;,{ FIXED : MAX(date) }) THEN [total_orders] END)' />
            </column>
            <column caption='New Restos Orders Share Indicator' datatype='integer' name='[New Restos Orders Indicator (copy)_5748563464383877173]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Marketplace Indicator' datatype='integer' name='[Orders Indicator (copy)_5748563464379863059]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Last Month Orders (copy)_5748563464379629584] &gt; [Mean Orders (copy)_5748563464379719697] + [St Dev Orders (copy)_5748563464379797522] THEN 2 ELSE 0 END' />
            </column>
            <column caption='Orders Indicator' datatype='integer' name='[Reorder Rate Indicator (copy)_5748563464378884107]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Last Month Reorder Rate (copy)_5748563464378884108] &gt; [Mean Reorder Rate (copy)_5748563464378884109] + [St Dev Reorder Rate (copy)_5748563464378884110] THEN 2 ELSE 0 END' />
            </column>
