            <column datatype='integer' name='[Acquisitions]' role='measure' type='quantitative' />
            <column caption='Acquisitions Indicator' datatype='integer' name='[Active Customers Indicator (copy)_4203969529375522828]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF [Last Month Active Customers (copy)_4203969529375522827] &gt; [Mean Active Customers (copy)_4203969529375522826] + [St Dev Active Customers (copy)_4203969529375522829] THEN 2 ELSE 0 END' />
            </column>
            <column caption='Mean Active Customers' datatype='real' name='[Calculation_4203969529358036997]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF DATETRUNC(&apos;month&apos;, date) &lt;&gt; DATETRUNC(&apos;month&apos;,{ FIXED : MAX(date) }) THEN [active_customer] END)' />
            </column>
            <column caption='Last Month Active Customers' datatype='integer' name='[Calculation_4203969529358614535]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF DATETRUNC(&apos;month&apos;,date) = DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-1,{ FIXED:MAX([date]) })) THEN [active_customer] END)' />
            </column>
            <column caption='Active Customers Indicator' datatype='integer' name='[Calculation_4203969529358757896]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF [Calculation_4203969529358614535] &gt; [Calculation_4203969529358036997] + [Mean Active Customers (copy)_4203969529358483462] THEN 2 ELSE 0 END' />
            </column>
            <column caption='Acquisitions Share Indicator' datatype='integer' name='[Calculation_4203969529376903182]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Last Month -1' datatype='datetime' name='[Calculation_4203969529379254287]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEADD(&apos;month&apos;,-1,{ FIXED:MAX([date]) })' />
            </column>
            <column caption='Last Month Acquisitions' datatype='integer' name='[Last Month Active Customers (copy)_4203969529375522827]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF DATETRUNC(&apos;month&apos;,date) = DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-1,{ FIXED:MAX([date]) })) THEN [Acquisitions] END)' />
            </column>
            <column caption='St Dev Active Customers' datatype='real' name='[Mean Active Customers (copy)_4203969529358483462]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='STDEV(IF DATETRUNC(&apos;month&apos;, date) &lt;&gt; DATETRUNC(&apos;month&apos;,{ FIXED : MAX(date) }) THEN [active_customer] END)' />
            </column>
            <column caption='Mean Acquisitions' datatype='real' name='[Mean Active Customers (copy)_4203969529375522826]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF DATETRUNC(&apos;month&apos;, date) &lt;&gt; DATETRUNC(&apos;month&apos;,{ FIXED : MAX(date) }) THEN [Acquisitions] END)' />
            </column>
            <column caption='St Dev Acquisitions' datatype='real' name='[St Dev Active Customers (copy)_4203969529375522829]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='STDEV(IF DATETRUNC(&apos;month&apos;, date) &lt;&gt; DATETRUNC(&apos;month&apos;,{ FIXED : MAX(date) }) THEN [Acquisitions] END)' />
            </column>
            <column datatype='integer' name='[active_customer]' role='measure' type='quantitative' />
