      <table>
        <view>
          <datasources>
            <datasource caption='BigQuery' name='federated.1fhn7on09i1o5p10vbqm70rm65lu' />
          </datasources>
          <datasource-dependencies datasource='federated.1fhn7on09i1o5p10vbqm70rm65lu'>
            <column-instance column='[order_status]' derivation='None' name='[none:order_status:nk]' pivot='key' type='nominal' />
            <column datatype='date' name='[order_date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[order_status]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;failed_cancellation&quot;' value='cancelation' />
                <alias key='&quot;failed_overall&quot;' value='other failure' />
                <alias key='&quot;failed_payment&quot;' value='payment' />
                <alias key='&quot;failed_rejection&quot;' value='rejection' />
