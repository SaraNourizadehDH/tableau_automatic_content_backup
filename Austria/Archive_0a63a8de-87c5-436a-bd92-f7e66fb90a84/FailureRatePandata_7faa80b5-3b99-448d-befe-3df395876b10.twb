        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.08i4qpr1dmjrbe172h8ea0c2fbo8' name='Custom SQL Query' type='text'>SELECT&#13;
  po.created_date_utc AS cancellation_date,&#13;
  po.pd_status_id,&#13;
  po.status_code,&#13;
  status_flows.payment_status_type,&#13;
  ps.title as reason,&#13;
  COUNT(distinct po.uuid) as count&#13;
FROM&#13;
  `fulfillment-dwh-production.pandata_curated.pd_orders` AS po&#13;
  join `fulfillment-dwh-production.pandata_curated.pd_status` as ps&#13;
  on po.pd_status_id = ps.id,&#13;
  unnest(status_flows) as status_flows&#13;
WHERE&#13;
  po.is_valid_order IS FALSE &#13;
  and po.is_test_order is false&#13;
  AND po.global_entity_id = &apos;MJM_AT&apos;&#13;
  AND po.created_date_utc &gt;&gt; &apos;2020-05-31&apos;&#13;
GROUP BY&#13;
  1,&#13;
  2,3,4,5</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.08i4qpr1dmjrbe172h8ea0c2fbo8' name='Custom SQL Query' type='text'>SELECT&#13;
