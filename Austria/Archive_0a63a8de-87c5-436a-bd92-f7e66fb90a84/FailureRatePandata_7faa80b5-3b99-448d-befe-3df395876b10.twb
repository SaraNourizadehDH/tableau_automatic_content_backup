          <datasource-dependencies datasource='federated.1fhn7on09i1o5p10vbqm70rm65lu'>
            <column caption='# Logistics Cancellation' datatype='integer' default-format='n#,##0;-#,##0' name='[# Failed Verification (copy)]' role='measure' type='quantitative' visual-totals='Sum'>
              <calculation class='tableau' formula='Sum(IIF([order_status]=&apos;631 - Logistics Cancellation&apos;,[orders],0,0))' />
            </column>
            <column caption='# Vendor declined' datatype='integer' default-format='n#,##0;-#,##0' name='[# Rejection Fail (copy)]' role='measure' type='quantitative' visual-totals='Sum'>
              <calculation class='tableau' formula='Sum(IIF([is_failed_order_vendor]= True,[orders],0,0))' />
            </column>
            <column caption='# Customer cancelled ' datatype='integer' default-format='n#,##0;-#,##0' name='[# Response Fail (copy)]' role='measure' type='quantitative' visual-totals='Sum'>
              <calculation class='tableau' formula='Sum(IIF( [is_failed_order_customer]=&#9;&#13;&#10;True&#13;&#10;,[orders],0,0))' />
            </column>
            <column caption='# Order not delivered' datatype='integer' default-format='n#,##0;-#,##0' name='[# Transmission Fail (copy)]' role='measure' type='quantitative' visual-totals='Sum'>
