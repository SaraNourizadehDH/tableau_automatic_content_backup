    <worksheet name='Sheet 5'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000fc' fontname='Roboto,sans-serif' italic='true'>Payment Status </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (dwh_il_mjm_at)' name='federated.0riyf99120l0xc179glrz1ablodv' />
          </datasources>
          <datasource-dependencies datasource='federated.0riyf99120l0xc179glrz1ablodv'>
            <column caption='payment_failure' datatype='string' name='[Calculation_1028228151213387777]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [status_code]= 67 then[payment_status_type] else null end' />
              <aliases>
                <alias key='&quot;canceled&quot;' value='Canceled' />
                <alias key='&quot;in_progress&quot;' value='In Progress' />
                <alias key='&quot;paid&quot;' value='Paid' />
                <alias key='&quot;refused&quot;' value='Refused' />
              </aliases>
            </column>
            <column datatype='date' name='[cancellation_date]' role='dimension' type='ordinal' />
            <column caption='count (copy) (copy)' datatype='integer' name='[count (copy) (copy)_3534903559984779269]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[count]' />
            </column>
            <column datatype='integer' name='[count]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1028228151213387777]' derivation='None' name='[none:Calculation_1028228151213387777:nk]' pivot='key' type='nominal' />
            <column datatype='string' name='[payment_status_type]' role='dimension' type='nominal' />
            <column-instance column='[count (copy) (copy)_3534903559984779269]' derivation='Sum' name='[pcto:sum:count (copy) (copy)_3534903559984779269:qk:3]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' type='PctTotal' />
            </column-instance>
            <column datatype='string' name='[reason]' role='dimension' type='nominal' />
            <column datatype='integer' name='[status_code]' role='measure' type='quantitative' />
            <column-instance column='[count]' derivation='Sum' name='[sum:count:qk]' pivot='key' type='quantitative' />
            <column-instance column='[cancellation_date]' derivation='Month-Trunc' name='[tmn:cancellation_date:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0riyf99120l0xc179glrz1ablodv].[Action (MONTH(cancellation_date),reason)]'>
            <groupfilter function='reorder-dimensionality' user:ui-action-filter='[Action2]' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='crossjoin'>
                <groupfilter function='member' level='[reason]' member='&quot;67 - Incomplete order&quot;' />
                <groupfilter function='member' level='[tmn:cancellation_date:ok]' member='#2021-06-01 00:00:00#' />
              </groupfilter>
              <order>
                <hierarchy name='[tmn:cancellation_date:ok]' />
                <hierarchy name='[reason]' />
              </order>
            </groupfilter>
          </filter>
          <filter class='categorical' column='[federated.0riyf99120l0xc179glrz1ablodv].[none:Calculation_1028228151213387777:nk]'>
            <groupfilter function='level-members' level='[none:Calculation_1028228151213387777:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <manual-sort column='[federated.0riyf99120l0xc179glrz1ablodv].[none:Calculation_1028228151213387777:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;canceled&quot;</bucket>
              <bucket>%null%</bucket>
              <bucket>&quot;in_progress&quot;</bucket>
              <bucket>&quot;paid&quot;</bucket>
              <bucket>&quot;refused&quot;</bucket>
