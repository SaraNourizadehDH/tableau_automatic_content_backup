      <aliases enabled='yes' />
      <column caption='Lunch Vendors' datatype='integer' name='[Active Vendors (copy)_1311603034714247169]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [has_lunch] then [vendor_code] END)' />
      </column>
      <column caption='% Discount' datatype='real' name='[Amount Discount (copy)_1311603034716733444]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([percentage_discounts_sum])/SUM([percentage_discounts_count]))' />
      </column>
      <column caption='Active Vendors' datatype='integer' name='[Calculation_1311603034713497600]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([vendor_code])' />
      </column>
      <column caption='Amount Discount' datatype='real' name='[Calculation_1311603034716360707]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([amount_discounts_sum])/SUM([amount_discounts_count]))' />
      </column>
      <column caption='USP Vendors' datatype='integer' name='[Calculation_1311603035042512902]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF([has_deal] or [has_lunch] or [has_munzen] or [Calculation_2302113478792671236]) then [vendor_code] end )' />
      </column>
      <column caption='Lunch Vendors %' datatype='real' name='[Calculation_1311603035140964359]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Active Vendors (copy)_1311603034714247169]/[Calculation_1311603034713497600]' />
      </column>
      <column caption='Discount Vendors' datatype='integer' name='[Calculation_2302113478789431296]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [amount_discounts_count]+[percentage_discounts_count]+[freedelivery_discounts_count] &gt; 0 THEN [vendor_code] END)' />
      </column>
      <column caption='Legend' datatype='integer' name='[Calculation_2302113478792159235]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Münzen Vendors&apos; THEN [Lunch Vendors (copy)_1311603034716213250]&#10;    WHEN &apos;Deal Vendors&apos; THEN [Münzen Vendors (copy)_1311603034719510533]&#10;    WHEN &apos;Lunch Vendors&apos; THEN [Active Vendors (copy)_1311603034714247169]&#10;    WHEN &apos;Discount Vendors&apos; THEN [Calculation_2302113478789431296]&#10;    WHEN &apos;Orders&apos; THEN SUM([successful_orders])&#10;WHEN &apos;USP Vendors (Overall)&apos; THEN [Calculation_1311603035042512902]&#10;END' />
      </column>
      <column caption='Has Discount' datatype='boolean' name='[Calculation_2302113478792671236]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [vendor_code]: SUM([amount_discounts_count]+[freedelivery_discounts_count]+[percentage_discounts_count])}&gt;0' />
      </column>
      <column caption='Deal Vendor Orders' datatype='integer' name='[Calculation_2662542188023894019]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [has_deal] THEN [successful_orders] end)' />
      </column>
      <column caption='Deal Vendors Order Penetration' datatype='real' name='[Calculation_2662542188024369156]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2662542188023894019] / SUM([successful_orders])' />
      </column>
      <column caption='Discount Vendors %' datatype='real' name='[Deal Vendors % (copy)_2302113478789935105]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2302113478789431296]/[Calculation_1311603034713497600]' />
      </column>
      <column caption='Legend 2' datatype='boolean' name='[Legend (copy)_2662542188025278469]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Münzen Vendors&apos; THEN  [has_munzen]&#10;    WHEN &apos;Deal Vendors&apos; THEN [has_deal]&#10;    WHEN &apos;Lunch Vendors&apos; THEN [has_lunch]&#10;    WHEN &apos;Discount Vendors&apos; THEN [Calculation_2302113478792671236]&#10;END' />
      </column>
      <column caption='Münzen Vendors %' datatype='real' name='[Lunch Vendors % (copy) (copy)_1311603035141029897]' role='measure' type='quantitative'>
