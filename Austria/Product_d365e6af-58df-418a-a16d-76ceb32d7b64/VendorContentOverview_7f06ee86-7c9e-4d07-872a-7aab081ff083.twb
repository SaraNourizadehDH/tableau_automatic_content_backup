  <worksheets>
    <worksheet name='#3 items'>
      <table>
        <view>
          <datasources>
            <datasource caption='Vendor Content Metrics and Info' name='federated.0yr9hed1v8zjpp187xwbz0c0zhne' />
          </datasources>
          <datasource-dependencies datasource='federated.0yr9hed1v8zjpp187xwbz0c0zhne'>
            <column caption='# Categories w &lt; 3 Items' datatype='integer' default-format='N' name='[# Categories (copy)_4110097669753049097]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([number_of_categories_w_less_3_items],0)' />
            </column>
            <column caption='# Menu items' datatype='integer' default-format='N' name='[# Categories (copy)_4110097669753282570]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([number_of_menu_items],0)' />
            </column>
            <column caption='Image Coverage' datatype='real' default-format='p0.0%' name='[Calculation_4110097669744353281]' role='measure' type='quantitative'>
