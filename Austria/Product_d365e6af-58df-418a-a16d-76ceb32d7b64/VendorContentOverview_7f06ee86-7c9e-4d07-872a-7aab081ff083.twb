      <column caption='Image Coverage' datatype='real' default-format='p0.0%' name='[Calculation_4110097669744353281]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL((SUM([items_w_image]) / SUM([number_of_menu_items])) ,0)' />
