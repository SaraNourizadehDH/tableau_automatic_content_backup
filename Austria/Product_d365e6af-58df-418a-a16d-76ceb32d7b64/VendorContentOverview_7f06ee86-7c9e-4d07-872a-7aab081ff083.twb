      <column caption='Has Description' datatype='boolean' name='[Calculation_4552083751960285184]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='NOT ISNULL([vendor_description])' />
      </column>
      <column caption='NULL FOOD ' datatype='integer' name='[Calculation_4552083751962226689]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF ISNULL([Calculation_4110097669751218180]) = TRUE THEN 1 ELSE 0 END)' />
      </column>
      <column caption='is_private' datatype='integer' name='[Calculation_5697827648170590208]' role='measure' type='quantitative'>
