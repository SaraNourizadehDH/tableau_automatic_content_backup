              <calculation class='tableau' formula='SUM([orders])/ SUM([customers])' />
            </column>
            <column caption='Status' datatype='string' name='[Calculation_104849439612583938]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  [NPS] &lt; 7 THEN &quot;Detractor&quot;&#10;ELSEIF [NPS] &gt; 8 THEN &quot;Promoter&quot;&#10;ELSE &quot;Passive&quot;&#10;END' />
