  <worksheets>
    <worksheet name='% change_retention'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontsize='12'>Change in Retention Rate - NPS</run>
            <run fontalignment='1' fontsize='10'>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/AfterOrderNPSCohort_16286752996700/change_retention?rev=' id='change_retention' path='/t/GlobalStandardReporting/workbooks/AfterOrderNPSCohort_16286752996700' revision='' site='GlobalStandardReporting' />
      <table>
        <view>
          <datasources>
            <datasource caption='nps_cohort (dwh_bl.nps_cohort) (dwh_bl)' name='federated.0gx2x3x1a8t84g1a49tao15m9r7b' />
          </datasources>
          <datasource-dependencies datasource='federated.0gx2x3x1a8t84g1a49tao15m9r7b'>
            <column caption='% of change' datatype='real' default-format='p0.0%' name='[Calculation1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Calculation_104849439587831808]) - LOOKUP(ZN([Calculation_104849439587831808]), -1)'>
                <table-calc ordering-type='Columns' />
              </calculation>
            </column>
            <column caption='Retention Rate' datatype='real' default-format='p0.0%' name='[Calculation_104849439587831808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([customers]) / SUM([cohort_customers])' />
            </column>
            <column caption='Status' datatype='string' name='[Calculation_104849439612583938]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  [NPS] &lt; 7 THEN &quot;Detractor&quot;&#10;ELSEIF [NPS] &gt; 8 THEN &quot;Promoter&quot;&#10;ELSE &quot;Passive&quot;&#10;END' />
            </column>
            <column datatype='integer' datatype-customized='true' name='[NPS]' role='dimension' type='ordinal' />
            <column caption='Cohort Customers' datatype='integer' name='[cohort_customers]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Customers' datatype='integer' name='[customers]' role='measure' type='quantitative' />
