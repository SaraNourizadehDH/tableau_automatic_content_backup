      <datasource-dependencies datasource='federated.0gx2x3x1a8t84g1a49tao15m9r7b'>
        <column caption='Next Order Date' datatype='date' name='[Calculation_94153392256221184]' role='dimension' type='ordinal'>
          <calculation class='tableau' formula='DATE( &#10;LEFT(STR([next_order_month]), 4) // This covers the DD segment &#10;+&quot;-&quot; + &#10;MID(STR([next_order_month]), 6, 2) // The MMM segment &#10;+&quot;-&quot; + &#10;&quot;01&quot;&#10;)' />
        </column>
        <column caption='Submission Date' datatype='date' name='[Next Order Date (copy)]' role='dimension' type='ordinal'>
          <calculation class='tableau' formula='DATE( &#10;LEFT(STR([survey_month]), 4) // This covers the DD segment &#10;+&quot;-&quot; + &#10;MID(STR([survey_month]), 6, 2) // The MMM segment &#10;+&quot;-&quot; + &#10;&quot;01&quot;&#10;)' />
        </column>
        <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
