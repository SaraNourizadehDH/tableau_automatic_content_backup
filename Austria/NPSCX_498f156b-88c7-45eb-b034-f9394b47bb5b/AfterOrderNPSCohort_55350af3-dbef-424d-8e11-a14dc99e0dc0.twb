    <worksheet name='orders_cohort'>
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='nps_cohort (dwh_bl.nps_cohort) (dwh_bl)' name='federated.0gx2x3x1a8t84g1a49tao15m9r7b' />
          </datasources>
          <datasource-dependencies datasource='federated.0gx2x3x1a8t84g1a49tao15m9r7b'>
            <column caption='Status' datatype='string' name='[Calculation_104849439612583938]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  [NPS] &lt; 7 THEN &quot;Detractor&quot;&#10;ELSEIF [NPS] &gt; 8 THEN &quot;Promoter&quot;&#10;ELSE &quot;Passive&quot;&#10;END' />
            </column>
            <column caption='Months After NPS Order' datatype='string' name='[Calculation_89579424261824513]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Month After Survey Submission (copy)] = 0 THEN &quot;Survey Volume&quot; ELSE str([months_after_nps]) END' />
            </column>
            <column caption='Cohort Order KPI ' datatype='integer' name='[Cohort Customers KPI (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [months_after_nps] = 0 then [cohort_orders] ELSE orders END' />
            </column>
            <column caption='Month After Survey' datatype='integer' name='[Month After Survey Submission (copy)]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[months_after_nps]' />
            </column>
            <column datatype='integer' datatype-customized='true' name='[NPS]' role='dimension' type='ordinal' />
            <column caption='Submission Date' datatype='date' name='[Next Order Date (copy)]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE( &#10;LEFT(STR([survey_month]), 4) // This covers the DD segment &#10;+&quot;-&quot; + &#10;MID(STR([survey_month]), 6, 2) // The MMM segment &#10;+&quot;-&quot; + &#10;&quot;01&quot;&#10;)' />
            </column>
            <column caption='Cohort Orders' datatype='integer' name='[cohort_orders]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column-instance column='[Next Order Date (copy)]' derivation='Month' name='[mn:Next Order Date (copy):ok]' pivot='key' type='ordinal' />
            <column aggregation='Sum' caption='Month After NPS Order' datatype='integer' name='[months_after_nps]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_104849439612583938]' derivation='None' name='[none:Calculation_104849439612583938:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_89579424261824513]' derivation='None' name='[none:Calculation_89579424261824513:nk]' pivot='key' type='nominal' />
            <column-instance column='[NPS]' derivation='None' name='[none:NPS:ok]' pivot='key' type='ordinal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
