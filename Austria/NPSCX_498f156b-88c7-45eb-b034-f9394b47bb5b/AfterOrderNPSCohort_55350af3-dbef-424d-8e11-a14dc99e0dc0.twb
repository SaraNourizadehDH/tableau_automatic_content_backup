        <_.fcp.ObjectModelEncapsulateLegacy.false...relation join='inner' type='join'>
          <clause type='join'>
            <expression op='='>
              <expression op='[nps_cohort].[global_entity_id]' />
              <expression op='[tableau_gsr_entitlements_cx_global_entity_id].[global_entity_id]' />
            </expression>
          </clause>
          <relation connection='bigquery.1kbsexk16y5mdb11def2e0538dfa' name='nps_cohort' type='text'>WITH nps AS
(
  SELECT
      ao.global_entity_id,
      ao.created_date,
      ao.nps_score,
      ao.order_id,
      o.placed_at_local,
      o.analytical_customer_id,
      ROW_NUMBER() OVER (PARTITION BY ao.global_entity_id, ao.survey_id, o.analytical_customer_id ORDER BY ao.created_date) AS rown
  FROM fulfillment-dwh-production.curated_data_shared_central_dwh.orders o
  INNER JOIN fulfillment-dwh-production.curated_data_shared_cx.nps_after_order_all_survey_responses ao
  USING (global_entity_id, order_id)
  WHERE o.analytical_customer_id IS NOT NULL
),
next_orders AS
(
  SELECT
      n.global_entity_id,
      n.analytical_customer_id,
      n.placed_at_local AS nps_order,
      n.created_date ,
      o.placed_at_local AS next_order,
      DATE_DIFF(o.placed_at_local, n.created_date, MONTH) AS months_after_nps,
      n.order_id AS nps_order_id,
      o.order_id AS next_order_id,
      n.nps_score,
      o.is_sent,
      o.is_acquisition,
      NULLIF(COALESCE(o.value.voucher_dh_local, 0) + COALESCE(o.value.voucher_other_local, 0), 0) as amt_voucher_local,
      NULLIF(COALESCE(o.value.voucher_dh_eur, 0) + COALESCE(o.value.voucher_other_eur, 0), 0) as amt_voucher_eur,
      o.value.gmv_local AS amt_gmv_local,
      o.value.gmv_eur AS amt_gmv_eur,
  FROM fulfillment-dwh-production.curated_data_shared_central_dwh.orders o
  LEFT JOIN nps n
      ON  n.analytical_customer_id = o.analytical_customer_id
      AND n.global_entity_id = o.global_entity_id
      AND CAST(o.placed_at_local AS DATE) &gt;&gt;= CAST(n.placed_at_local AS DATE)
  WHERE n.rown = 1
  AND n.created_date &gt;&gt;= &apos;2015-11-01&apos;
  AND CAST(n.placed_at_local AS DATE) &gt;&gt;= &apos;2015-11-01&apos;
),
nps_cohort AS
(
  SELECT
      global_entity_id,
      nps_score,
      FORMAT_DATETIME(&quot;%Y-%m&quot;, created_date) AS survey_month,
      COUNT(DISTINCT analytical_customer_id) AS cohort_customers,
      COUNT(DISTINCT nps_order_id) AS cohort_orders,
      COUNT(CASE WHEN is_sent THEN nps_order_id END) AS cohort_successful_orders,
      SUM(CASE WHEN is_sent THEN amt_gmv_eur END) AS cohort_basket,
      SUM(amt_gmv_eur) AS cohort_gmv_eur
  FROM next_orders
  GROUP BY 1, 2, 3
),
nps_next_order AS
(
  SELECT
      global_entity_id,
      nps_score,
      FORMAT_DATETIME(&quot;%Y-%m&quot;, created_date) AS survey_month,
      FORMAT_DATETIME(&quot;%Y-%m&quot;, next_order) AS next_order_month,
      COALESCE(DATE_DIFF(next_order, created_date, MONTH), 0) months_after_nps,
      COUNT(DISTINCT analytical_customer_id) AS customers,
      COUNT(DISTINCT next_order_id) AS orders,
      COUNT(CASE WHEN is_sent THEN  next_order_id END) AS successful_orders,
      SUM(CASE WHEN is_sent THEN  amt_gmv_eur END) AS basket,
      SUM(amt_gmv_eur) AS gmv_eur
  FROM next_orders
  WHERE next_order &gt;&gt; created_date
  GROUP BY 1, 2, 3, 4, 5
)
SELECT
    a.global_entity_id,
    c.management_entity,
    c.country_name AS country,
    a.nps_score AS NPS,
    a.survey_month,
    b.next_order_month,
    b.months_after_nps,
    a.cohort_customers,
    a.cohort_orders,
    a.cohort_successful_orders,
    a.cohort_basket,
    a.cohort_gmv_eur,
    b.customers,
    b.orders,
    b.successful_orders,
    b.basket,
    b.gmv_eur
FROM nps_cohort a
LEFT JOIN nps_next_order b
    ON  a.global_entity_id = b.global_entity_id
    AND a.nps_score = b.nps_score
    AND a.survey_month = b.survey_month
JOIN fulfillment-dwh-production.curated_data_shared_coredata.global_entities c ON a.global_entity_id = c.global_entity_id
WHERE next_order_month != FORMAT_DATETIME(&quot;%Y-%m&quot;, CURRENT_DATE())
AND a.survey_month != FORMAT_DATETIME(&quot;%Y-%m&quot;, CURRENT_DATE())
AND c. is_reporting_enabled IS TRUE</relation>
