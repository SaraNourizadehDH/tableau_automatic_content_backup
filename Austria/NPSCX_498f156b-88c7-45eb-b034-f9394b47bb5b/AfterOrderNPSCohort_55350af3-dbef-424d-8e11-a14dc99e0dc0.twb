    <dashboard name='Avg. Basket/Year'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#ffffff'>AVG Basket Size / Year</run>
            <run fontalignment='1' fontcolor='#ffffff' fontsize='14'>&#10;After Order NPS&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/AfterOrderNPSCohort/Avg_BasketYear?rev=' id='Avg_BasketYear' path='/t/GlobalStandardReporting/workbooks/AfterOrderNPSCohort' revision='' site='GlobalStandardReporting' />
      <style>
