      <column caption='Avg. GMV ' datatype='real' default-format='n#,##0.00' hidden='true' name='[Avg. Basket Size (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gmv_eur])/ SUM([orders])' />
      </column>
      <column caption='Cohort Activity' datatype='real' default-format='n#,##0.00' hidden='true' name='[Avg. Order per Cust. (copy 2)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cohort_orders])/ SUM([cohort_customers])' />
      </column>
      <column caption='Avg. Basket Size' datatype='real' default-format='n#,##0.00' name='[Avg. Order per Cust. (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([basket])/ SUM([successful_orders])' />
      </column>
      <column caption='% of change' datatype='real' default-format='p0.0%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([Calculation_104849439587831808]) - LOOKUP(ZN([Calculation_104849439587831808]), -1)'>
          <table-calc ordering-type='Columns' />
        </calculation>
      </column>
      <column caption='Retention Rate' datatype='real' default-format='p0.0%' name='[Calculation_104849439587831808]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([customers]) / SUM([cohort_customers])' />
      </column>
      <column caption='Activity' datatype='real' default-format='n#,##0.00' name='[Calculation_104849439608516609]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders])/ SUM([customers])' />
      </column>
      <column caption='Status' datatype='string' name='[Calculation_104849439612583938]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [NPS] &lt; 7 THEN &quot;Detractor&quot;&#10;ELSEIF [NPS] &gt; 8 THEN &quot;Promoter&quot;&#10;ELSE &quot;Passive&quot;&#10;END' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_4366802795812495360]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Cohort Customers KPI' datatype='integer' name='[Calculation_89579424261312512]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [months_after_nps] = 0 then [cohort_customers] ELSE [customers] END' />
      </column>
      <column caption='Months After NPS Order' datatype='string' name='[Calculation_89579424261824513]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Month After Survey Submission (copy)] = 0 THEN &quot;Survey Volume&quot; ELSE str([months_after_nps]) END' />
      </column>
      <column caption='Next Order Date' datatype='date' name='[Calculation_94153392256221184]' role='dimension' type='ordinal'>
