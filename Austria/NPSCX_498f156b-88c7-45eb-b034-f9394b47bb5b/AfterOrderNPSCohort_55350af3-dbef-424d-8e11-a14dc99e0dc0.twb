        <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
        <column-instance column='[management_entity]' derivation='None' name='[none:management_entity:nk]' pivot='key' type='nominal' />
        <column-instance column='[Calculation_94153392256221184]' derivation='Year' name='[yr:Calculation_94153392256221184:ok]' pivot='key' type='ordinal' />
        <column-instance column='[Next Order Date (copy)]' derivation='Year' name='[yr:Next Order Date (copy):ok]' pivot='key' type='ordinal' />
      </datasource-dependencies>
