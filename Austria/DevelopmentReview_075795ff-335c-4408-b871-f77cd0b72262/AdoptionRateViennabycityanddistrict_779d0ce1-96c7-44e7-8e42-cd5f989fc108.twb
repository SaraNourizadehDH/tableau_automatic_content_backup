          <manual-sort column='[federated.18u95dy0cio9u11bcji0105x5vjk].[:Measure Names]' direction='ASC'>
            <dictionary>
              <bucket>&quot;[federated.18u95dy0cio9u11bcji0105x5vjk].[usr:Calculation1:qk]&quot;</bucket>
