            <groupfilter function='union' user:op='manual'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.18u95dy0cio9u11bcji0105x5vjk].[usr:Calculation1:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.18u95dy0cio9u11bcji0105x5vjk].[sum:Calculation_632192864732954640:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.18u95dy0cio9u11bcji0105x5vjk].[usr:Calculation_632192864664088579:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.18u95dy0cio9u11bcji0105x5vjk].[usr:Average DF original (copy)_632192864680128520:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.18u95dy0cio9u11bcji0105x5vjk].[usr:Average DF original (copy)_632192864664686596:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.18u95dy0cio9u11bcji0105x5vjk].[usr:Average GFV original  (copy)_632192864664805381:qk]&quot;' />
