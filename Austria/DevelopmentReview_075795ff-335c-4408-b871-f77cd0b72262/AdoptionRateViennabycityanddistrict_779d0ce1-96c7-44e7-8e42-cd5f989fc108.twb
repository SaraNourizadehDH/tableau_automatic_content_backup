            <connection CATALOG='dha---bi-485' EXECCATALOG='dha---bi-485' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='DHA - BI' schema='prod_tables' server-oauth='' username='sirinthip.narula@foodora.at' workgroup-auth-mode='prompt' />
