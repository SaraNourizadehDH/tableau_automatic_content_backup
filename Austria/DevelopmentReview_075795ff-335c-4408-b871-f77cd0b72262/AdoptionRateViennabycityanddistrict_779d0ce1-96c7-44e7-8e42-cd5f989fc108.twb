      <aliases enabled='yes' />
      <column caption='Avg GFV' datatype='real' name='[Average DF original (copy)_632192864664686596]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([gfv_eur])/sum([Calculation_632192864732954640])' />
      </column>
      <column caption='Avg DF user paid ' datatype='real' name='[Average DF original (copy)_632192864680128520]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([df_user_paid])/sum([Calculation_632192864732954640])' />
      </column>
      <column caption='Avg GMV ' datatype='real' name='[Average GFV original  (copy)_632192864664805381]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([gmv_eur])/sum([Calculation_632192864732954640])' />
      </column>
      <column caption='Avg GMV user paid' datatype='real' name='[Average GMV  (copy)_632192864679702535]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([gmv_user_paid_eur])/sum([orders])' />
      </column>
      <column caption='% of customers per user type' datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([pd_cus_id]) / TOTAL(SUM([pd_cus_id]))'>
          <table-calc ordering-type='Field'>
            <order field='[federated.18u95dy0cio9u11bcji0105x5vjk].[none:city:nk]' />
            <order field='[federated.18u95dy0cio9u11bcji0105x5vjk].[none:district:nk]' />
            <order field='[federated.18u95dy0cio9u11bcji0105x5vjk].[none:user_type:nk]' />
          </table-calc>
        </calculation>
      </column>
      <column caption='adoption rate per city' datatype='real' default-format='p0.00%' name='[Calculation2]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([pd_cus_id]) / TOTAL(SUM([pd_cus_id]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Avg DF original' datatype='real' name='[Calculation_632192864664088579]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([df_original])/sum([Calculation_632192864732954640])' />
      </column>
      <column caption='Country' datatype='string' name='[Calculation_632192864672649222]' role='dimension' semantic-role='[Country].[Name]' type='nominal'>
        <calculation class='tableau' formula='&apos;Austria&apos;' />
      </column>
      <column caption='TotalOrders' datatype='integer' name='[Calculation_632192864732954640]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [user_type] = &apos;subscriber&apos; then [subscriber_order] ELSEIF [user_type] = &apos;nonsubscriber&apos; then &#13;&#10;[orders] end' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Custom SQL Query' datatype='table' name='[__tableau_internal_object_id__].[_31D14CEB23AB402ABA17B04ADEC1E5E6]' role='measure' type='quantitative' />
      <column datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal'>
        <aliases>
          <alias key='%null%' value='Unknown' />
        </aliases>
      </column>
      <column datatype='string' name='[district]' role='dimension' semantic-role='' type='nominal' />
      <column datatype='string' name='[user_type]' role='dimension' type='nominal' />
      <column-instance column='[city]' derivation='None' name='[none:city:nk]' pivot='key' type='nominal' />
      <column-instance column='[district]' derivation='None' name='[none:district:nk]' pivot='key' type='nominal' />
      <column-instance column='[user_type]' derivation='None' name='[none:user_type:nk]' pivot='key' type='nominal' />
      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' _.fcp.SchemaViewerObjectModel.true...common-percentage='1' _.fcp.SchemaViewerObjectModel.true...user-set-layout-v2='true' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[none:user_type:nk]' type='palette'>
            <map to='#4e79a7'>
              <bucket>&quot;subscriber&quot;</bucket>
            </map>
            <map to='#76b7b2'>
              <bucket>%all%</bucket>
            </map>
            <map to='#e15759'>
              <bucket>&quot;nonsubscriber&quot;</bucket>
            </map>
          </encoding>
          <encoding attr='color' field='[none:city:nk]' type='palette'>
            <map to='#499894'>
              <bucket>&quot;Adnet&quot;</bucket>
            </map>
            <map to='#499894'>
              <bucket>&quot;Altach&quot;</bucket>
            </map>
            <map to='#499894'>
