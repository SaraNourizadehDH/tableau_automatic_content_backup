      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_31D14CEB23AB402ABA17B04ADEC1E5E6'>
            <properties context=''>
              <relation connection='bigquery.1lvw1kl1ty4lec16j8uc71fhwhtz' name='Custom SQL Query' type='text'><![CDATA[WITH




  all_subscribers AS (
  SELECT
    customer_code,
    pd_customer_uuid,
    prevailing_subscription_start_at_local,
    prevailing_subscription_end_at_local,
    prevailing_plan_duration_months,
    active_date
  FROM
    `fulfillment-dwh-production.pandata_report.regional_eu_subscriptions_active_subscribers`
  WHERE
    active_date = DATE_SUB(current_date,INTERVAL 1 day)
    AND global_entity_id = 'MJM_AT')

/*Group customers based on their zip codes, how many orders were in vienna, and how many in district 1-9 vs 10-23*/
  
  ,customer_orders AS (
  SELECT
    DISTINCT agg_eu.pd_customer_uuid,
    central_analytical_customer_id,
    DATE_TRUNC(agg_eu.created_date_utc,month) AS month,
    CASE
      WHEN pdo.delivery_address_postcode IN ('1010', '1020', '1030', '1040', '1050', '1060', '1070', '1080', '1090')THEN '1-9'
      WHEN pdo.delivery_address_postcode IN ('1100',
      '1110',
      '1120',
      '1130',
      '1140',
      '1150',
      '1160',
      '1170',
      '1180',
      '1190',
      '1200',
      '1210',
      '1220',
      '1230') THEN '10-23'
    ELSE
    pdo.delivery_address_postcode
  END
    AS district,
    CASE
      WHEN LOWER(pdo.delivery_address_city) IN ('wien', 'vienna') THEN 'Vienna'
    ELSE
    pdo.delivery_address_city
  END
    AS city,

    -- COUNT( DISTINCT (agg_eu.order_code)) OVER (PARTITION BY agg_eu.pd_customer_uuid, CASE WHEN LOWER(pdo.delivery_address_city) IN ('wien', 'vienna') THEN 'vienna'
    --   ELSE
    --   pdo.delivery_address_city
    -- END
    --   ,
    --   DATE_TRUNC(agg_eu.created_date_utc,month),
    --   CASE
    --     WHEN pdo.delivery_address_postcode IN ('1010', '1020', '1030', '1040', '1050', '1060', '1070', '1080', '1090')THEN 1
    --   ELSE
    --   2

    -- END
    --   )AS orders,
      order_code,
      gmv_eur as gmv_eur,
      gmv_user_paid_eur as gmv_user_paid_eur,
      gfv_eur as gfv_eur,
      df_original_incl_vat_eur as df_original,
      df_user_paid_incl_vat_eur as  df_user_paid,
    
      is_subscriber_order,
      is_subscription_order,

  FROM
    `fulfillment-dwh-production.pandata_report.agg_orders_eu` agg_eu
  LEFT JOIN
    `fulfillment-dwh-production.pandata_curated.pd_orders` pdo
  ON
    pdo.global_entity_id = agg_eu.global_entity_id
    AND pdo.code= agg_eu.order_code
    AND pdo.created_at_local = agg_eu.created_at_local
  WHERE
    agg_eu.created_date_utc >>= DATE_SUB(CURRENT_DATE, INTERVAL 2 MONTH)
    AND pdo.created_date_utc >>= DATE_SUB(CURRENT_DATE, INTERVAL 2 MONTH)
    AND agg_eu.global_entity_id = 'MJM_AT'
    AND agg_eu.is_valid_order
    AND pdo.is_valid_order
    order by month desc
    )
/*Give a ranking to each a customer, based on max orders */
  ,customer_order_district AS (
  SELECT
    DISTINCT district,
    city,
    pd_customer_uuid,
    central_analytical_customer_id,
    RANK() OVER (PARTITION BY  pd_customer_uuid  ORDER BY count(distinct(order_code))desc , city, district ) AS rank,
    count(distinct order_code) as orders,
    sum(gmv_eur) as gmv_eur,
    sum(gmv_user_paid_eur)as gmv_user_paid_eur,
    sum(gfv_eur) as gfv_eur,
    sum(df_original) as df_original,
    sum(df_user_paid) as  df_user_paid,
    count(distinct if(is_subscriber_order,order_code,null))as subscriber_order,
    count(distinct if(is_subscription_order,order_code,null)) as subscription_order
  FROM
    customer_orders
  GROUP BY
    district,
    city,
    order_code,
    pd_customer_uuid,
    central_analytical_customer_id 
    )
, agg_data as (
  SELECT distinct
    case when all_subscribers.pd_customer_uuid is null then 'nonsubscriber' when all_subscribers.pd_customer_uuid is not null then 'subscriber' end as user_type,
  customer_order_district.*
  FROM
    customer_order_district
        LEFT JOIN
    all_subscribers
  ON
    all_subscribers.pd_customer_uuid = customer_order_district.pd_customer_uuid
  WHERE
    rank = 1 

    )
    select 
    distinct city,
    
    case when city = 'Vienna' and district not in ('1-9','10-23') then 'unknown' 
    when city <<>> 'Vienna' and 
    char_length(district) >>4 then 'unknown'
    else district 
    end as 
    district,
    user_type,
    count(distinct pd_customer_uuid) as pd_cus_id,
    count(distinct central_analytical_customer_id) as acid,
    sum(gmv_eur) as gmv_eur,
    sum(gmv_user_paid_eur) as gmv_user_paid_eur,
    sum(gfv_eur) as gfv_eur,
    sum(df_original) as df_original,
    sum(df_user_paid) as df_user_paid,
    sum(subscriber_order) as subscriber_order,
    sum(orders) as orders,
    sum(subscription_order) as subscription_order

     from agg_data
     group by 1,2,3
     order by 4 desc]]></relation>
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
