  <datasources>
    <datasource caption='Custom SQL Query (prod_tables)' inline='true' name='federated.1h7dygg1351kto11q1b0g12fgfys' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1bsonex1bidv4418gskxu1bcwiub'>
            <connection CATALOG='dha---bi-485' EXECCATALOG='dha---bi-485' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='DHA - BI' schema='prod_tables' server-oauth='server-custom' username='tilo.mohaupt@foodora.at' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1bsonex1bidv4418gskxu1bcwiub' name='Custom SQL Query' type='text'>WITH ncr AS(&#13;
  SELECT&#13;
    vendor_code,&#13;
    report_month,    &#13;
    SUM(COALESCE(cpp_price, 0)) AS cpp_revenue,&#13;
    SUM(COALESCE(cpc_revenue, 0)) AS cpc_revenue,&#13;
    SUM(COALESCE(joker_revenue, 0)) AS joker_revenue  &#13;
  FROM&#13;
    `dha---bi-485.report_tables.ncr_monthly` ncr&#13;
  WHERE&#13;
    report_month &gt;&gt;= &quot;2024-01-01&quot;&#13;
  GROUP BY&#13;
    1,2&#13;
),&#13;
orders AS(&#13;
  SELECT&#13;
    v.sf_account_owner,&#13;
    v.vendor_code,&#13;
    DATE_TRUNC(o.created_date_local, MONTH) AS report_month,&#13;
    SUM(discount_value_local) AS discount_value_local,&#13;
    SUM(gmv_user_paid_local) AS gmv_user_paid_local&#13;
  FROM&#13;
    `fulfillment-dwh-production.pandata_report.agg_orders_eu` o&#13;
  LEFT JOIN&#13;
    `dha---bi-485.prod_tables.vendor_info` v&#13;
  ON&#13;
    v.vendor_code=o.vendor_code&#13;
  WHERE&#13;
    created_date_utc &gt;&gt;= &quot;2024-01-01&quot;&#13;
    AND o.global_entity_id = &quot;MJM_AT&quot;&#13;
    AND is_valid_order&#13;
  GROUP BY&#13;
    1,2,3)&#13;
SELECT&#13;
  sf_account_owner,&#13;
  orders.report_month,&#13;
  SUM(discount_value_local) AS discount_value_local,&#13;
  SUM(gmv_user_paid_local) AS gmv_user_paid_local,&#13;
  SUM(cpp_revenue) AS cpp_revenue,&#13;
  SUM(cpc_revenue) AS cpc_revenue,&#13;
  SUM(joker_revenue) AS joker_revenue&#13;
FROM&#13;
  orders&#13;
LEFT JOIN&#13;
  ncr&#13;
ON&#13;
  ncr.vendor_code=orders.vendor_code AND ncr.report_month=orders.report_month&#13;
GROUP BY&#13;
  1,2</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
