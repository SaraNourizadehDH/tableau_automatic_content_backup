    <worksheet name='Year-on-Year Growth Chart'>
      <layout-options>
        <title>
          <formatted-text>
            <run>&lt;</run>
            <run>[Parameters].[Parameter 4]</run>
            <run>&gt; Year-on-Year % Growth by &lt;</run>
            <run>[Parameters].[Parameter 3]</run>
            <run>&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location id='Year-on-YearGrowthChart' path='/t/Germany/workbooks/GermanHistoricalOrders' revision='' site='Germany' />
      <table>
        <view>
          <datasources>
            <datasource caption='BigQuery' name='federated.0dai72s1ng66wq1bq1c1b0rctyqq' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose KPI' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Orders&quot;'>
              <calculation class='tableau' formula='&quot;Orders&quot;' />
            </column>
            <column caption='Choose Date Dimension YoY' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
            <column caption='Choose KPI YoY' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Orders&quot;'>
              <calculation class='tableau' formula='&quot;Orders&quot;' />
            </column>
            <column alias='EUR' caption='Choose Currency' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Eur&quot;'>
              <calculation class='tableau' formula='&quot;Eur&quot;' />
              <aliases>
                <alias key='&quot;Eur&quot;' value='EUR' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0dai72s1ng66wq1bq1c1b0rctyqq'>
            <column caption='Acquisitions YoY (For YoY Chart)' datatype='real' name='[Acquisitions YOY (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN &quot;Month&quot; THEN SUM([Calculation_1024780060008738830])/sum([acquisitions_yoy])-1&#10;    WHEN &quot;Week&quot; THEN SUM([Calculation_1024780060008738830])/sum([acquisitions_yoy (copy)])-1&#10;END' />
            </column>
            <column caption='GMV (EUR) YoY (For YoY Chart)' datatype='real' name='[Acquisitions YoY (For YoY Chart) (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN &quot;Month&quot; THEN SUM([amt_gmv_eur])/sum([amt_gmv_eur_yoy])-1&#10;    WHEN &quot;Week&quot; THEN SUM([amt_gmv_eur])/sum([amt_gmv_eur_yoy_same_day])-1&#10;END' />
            </column>
            <column caption='Failure Rate' datatype='real' name='[Calculation_1024780059985756164]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_fail])/SUM([orders_total])' />
            </column>
            <column caption='Effective Commission Rate' datatype='real' name='[Calculation_1024780059985854469]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([amt_commission_eur])/SUM([amt_gmv_eur])' />
            </column>
            <column caption='Year' datatype='string' name='[Calculation_1024780059988475911]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(YEAR([order_date]))' />
            </column>
            <column caption='KPI' datatype='real' name='[Calculation_1024780059991732233]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;Orders&quot; THEN SUM([orders_succ])&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Acquisitions&quot; THEN SUM([Calculation_1024780060008738830])&#10;ELSEIF [Parameters].[Parameter 2] = &quot;GMV&quot; THEN [Calculation_3703436677877010433]&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Commission&quot; THEN SUM([Calculation_3703436677877891075])&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Commission Rate&quot; THEN [Calculation_1024780059985854469]&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Failure Rate&quot; THEN [Calculation_1024780059985756164]&#10;ELSEIF [Parameters].[Parameter 2] = &quot;GMV (After Discount)&quot; THEN SUM([Calculation_3703436677877624834])&#10;END' />
            </column>
            <column caption='Month Name' datatype='string' name='[Calculation_1024780060006912012]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;month&apos;, [order_date])' />
            </column>
            <column caption='Acquisitions (1)' datatype='integer' name='[Calculation_1024780060008738830]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [order_type] = &quot;acquisition&quot; THEN [acquisitions] ELSE 0 END' />
            </column>
            <column caption='Month Test' datatype='string' name='[Calculation_334462684927397889]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATETRUNC(&quot;month&quot;, [order_date]) &lt; DATETRUNC(&quot;month&quot;, TODAY())&#10;THEN &quot;Completed Months&quot;&#10;ELSE &quot;Current Month&quot;&#10;END' />
            </column>
            <column caption='GMV' datatype='real' name='[Calculation_3703436677877010433]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;    WHEN &quot;Eur&quot; THEN SUM([amt_gmv_eur])&#10;    WHEN &quot;Local Currency&quot; THEN SUM([amt_gmv_local])&#10;END' />
            </column>
            <column caption='GMV (Before Discount)' datatype='real' name='[Calculation_3703436677877624834]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;    WHEN &quot;Eur&quot; THEN [amt_gmv_eur] + IFNULL([amt_voucher_dh_eur],0)&#10;    WHEN &quot;Local Currency&quot; THEN [amt_gmv_local] + IFNULL([amt_voucher_dh_local],0)&#10;END' />
            </column>
            <column caption='Commission' datatype='real' name='[Calculation_3703436677877891075]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;    WHEN &quot;Eur&quot; THEN [amt_commission_eur]&#10;    WHEN &quot;Local Currency&quot; THEN [amt_commission_local]&#10;END' />
            </column>
            <column caption='Orders Succ YoY (For YoY Chart, filtered)' datatype='real' name='[Calculation_4124101026815606785]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Orders Succ YOY (copy 2)] &gt; 4 THEN NULL ELSE [Orders Succ YOY (copy 2)] END' />
            </column>
            <column caption='Acquisitions YoY (For YoY Chart, filtered)' datatype='real' name='[Calculation_4124101026817273858]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Acquisitions YOY (copy)] &gt; 4 THEN NULL ELSE [Acquisitions YOY (copy)] END' />
            </column>
            <column caption='GMV (EUR) YoY (For YoY Chart, filtered)' datatype='real' name='[Calculation_4124101026817445891]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Acquisitions YoY (For YoY Chart) (copy)] &gt; 4 THEN NULL ELSE [Acquisitions YoY (For YoY Chart) (copy)] END' />
            </column>
            <column caption='Date Dimension YoY' datatype='string' name='[Calculation_4760093758784229379]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 3] = &quot;Quarter&quot; AND DATETRUNC(&apos;quarter&apos;,[order_date])&lt;DATETRUNC(&apos;quarter&apos;,today()) then [Calculation_1024780060006912012]&#10;elseif [Parameters].[Parameter 3] = &quot;Month&quot; AND DATETRUNC(&apos;month&apos;,[order_date])&lt;DATETRUNC(&apos;month&apos;,today()) then [Calculation_1024780060006912012]&#10;elseif [Parameters].[Parameter 3] = &quot;Week&quot; then [Calculation_5046494526122684420]&#10;end' />
            </column>
            <column caption='Week Num' datatype='string' name='[Calculation_5046494526122684420]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='RIGHT([order_week],2)' />
            </column>
            <column caption='YoY KPI ' datatype='real' name='[KPI (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4] &#10;    WHEN &quot;Orders&quot; THEN [Calculation_4124101026815606785]&#10;    WHEN &quot;Acquisitions&quot; THEN [Calculation_4124101026817273858]&#10;    WHEN &quot;GMV&quot; THEN [Calculation_4124101026817445891]&#10;END' />
            </column>
            <column caption='Orders Succ YoY (For YoY Chart)' datatype='real' name='[Orders Succ YOY (copy 2)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN &quot;Month&quot; THEN SUM([orders_succ])/sum([orders_succ_yoy])-1&#10;    WHEN &quot;Week&quot; THEN SUM([orders_succ])/sum([orders_succ_yoy_same_day])-1&#10;END' />
            </column>
            <column caption='Acquisitions' datatype='integer' name='[acquisitions]' role='measure' type='quantitative' />
            <column caption='acquisitions_yoyd' datatype='integer' name='[acquisitions_yoy (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [order_type] = &quot;acquisition&quot; THEN [acquisitions_yoy_same_day] ELSE 0 END' />
            </column>
            <column caption='Acquisitions Yoy' datatype='integer' name='[acquisitions_yoy]' role='measure' type='quantitative' />
            <column caption='Acquisitions Yoy Same Day' datatype='integer' name='[acquisitions_yoy_same_day]' role='dimension' type='quantitative' />
            <column caption='Amt Commission Eur' datatype='real' name='[amt_commission_eur]' role='measure' type='quantitative' />
            <column caption='Amt Commission Local' datatype='real' name='[amt_commission_local]' role='measure' type='quantitative' />
            <column caption='Amt Gmv Eur' datatype='real' name='[amt_gmv_eur]' role='measure' type='quantitative' />
            <column caption='Amt Gmv Eur Yoy' datatype='real' name='[amt_gmv_eur_yoy]' role='measure' type='quantitative' />
            <column caption='Amt Gmv Eur Yoy Same Day' datatype='real' name='[amt_gmv_eur_yoy_same_day]' role='dimension' type='quantitative' />
            <column caption='Amt Gmv Local' datatype='real' name='[amt_gmv_local]' role='measure' type='quantitative' />
            <column caption='Amt Voucher Dh Eur' datatype='real' name='[amt_voucher_dh_eur]' role='measure' type='quantitative' />
            <column caption='Amt Voucher Dh Local' datatype='real' name='[amt_voucher_dh_local]' role='measure' type='quantitative' />
