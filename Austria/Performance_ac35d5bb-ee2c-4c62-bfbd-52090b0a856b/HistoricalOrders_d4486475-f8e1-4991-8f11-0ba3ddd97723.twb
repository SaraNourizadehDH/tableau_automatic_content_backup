    <worksheet name='Legal Entities'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>Delivery Hero Group - KPI Analysis
</run>
            <run fontalignment='1'>&lt;</run>
            <run fontalignment='1'>[federated.0dai72s1ng66wq1bq1c1b0rctyqq].[tmn:order_date:qk]</run>
            <run fontalignment='1'>&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/HistoricalOrders/LegalEntities?rev=' id='LegalEntities' path='/t/GlobalStandardReporting/workbooks/HistoricalOrders' revision='' site='GlobalStandardReporting' />
      <table>
        <view>
          <datasources>
            <datasource caption='BigQuery' name='federated.0dai72s1ng66wq1bq1c1b0rctyqq' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose Date Dimension' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
            <column alias='EUR' caption='Choose Currency' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Eur&quot;'>
              <calculation class='tableau' formula='&quot;Eur&quot;' />
              <aliases>
                <alias key='&quot;Eur&quot;' value='EUR' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0dai72s1ng66wq1bq1c1b0rctyqq'>
            <column caption='Orders DH Delivery' datatype='integer' name='[% DH Delivery (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_dh_delivery] = TRUE THEN [orders_succ] END)' />
            </column>
            <column caption='% DH Delivery' datatype='real' default-format='p0.00%' name='[% Mobile Orders (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_dh_delivery] = TRUE THEN [orders_succ] END)/SUM([orders_succ])' />
            </column>
            <column caption='Day of Week' datatype='string' name='[Calculation_1024780059979005952]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;,[order_date])' />
            </column>
            <column caption='Date Dimension' datatype='string' name='[Calculation_1024780059979481089]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &quot;Year&quot; THEN [Calculation_1024780059988475911]&#10;    WHEN &quot;Quarter&quot; THEN [Month (copy)_1607714714986287104]&#10;    WHEN &quot;Month&quot; THEN [Calculation_1024780059979702274]&#10;    WHEN &quot;Week&quot; THEN [order_week]&#10;    WHEN &quot;Date&quot; THEN [Calculation_1024780059987800070]&#10;    WHEN &quot;Day of Week&quot; THEN [Calculation_1024780059979005952]&#10;END' />
            </column>
            <column caption='Month' datatype='string' name='[Calculation_1024780059979702274]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;year&apos;, [order_date]) + &quot;-&quot; + IIF(MONTH([order_date])&lt;10, &quot;0&quot;,&quot;&quot;) + STR(MONTH([order_date]))' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_1024780059987800070]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;year&apos;, [order_date]) &#10;+ IIF(MONTH([order_date])&lt;10, &quot;-0&quot;,&quot;-&quot;) &#10;+ STR(MONTH([order_date]))&#10;+ IIF(DAY([order_date])&lt;10, &quot;-0&quot;,&quot;-&quot;) &#10;+ STR(DAY([order_date]))' />
            </column>
            <column caption='Year' datatype='string' name='[Calculation_1024780059988475911]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(YEAR([order_date]))' />
            </column>
            <column caption='GMV' datatype='real' name='[Calculation_3703436677877010433]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;    WHEN &quot;Eur&quot; THEN SUM([amt_gmv_eur])&#10;    WHEN &quot;Local Currency&quot; THEN SUM([amt_gmv_local])&#10;END' />
            </column>
            <column caption='GMV (Before Discount)' datatype='real' name='[Calculation_3703436677877624834]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;    WHEN &quot;Eur&quot; THEN [amt_gmv_eur] + IFNULL([amt_voucher_dh_eur],0)&#10;    WHEN &quot;Local Currency&quot; THEN [amt_gmv_local] + IFNULL([amt_voucher_dh_local],0)&#10;END' />
            </column>
            <column caption='Active Customers (Cumulative)' datatype='integer' name='[Calculation_5693675833014968320]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [global_entity_id], [Calculation_1024780059979481089],[is_dh_delivery],[order_type] : MAX([active_customers_cum])}' />
            </column>
            <column caption='% Online Payment Orders' datatype='real' default-format='p0.00%' name='[Calculation_6469913450705956869]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders_succ_online])/sum([orders_succ])' />
            </column>
            <column caption='Quarter' datatype='string' name='[Month (copy)_1607714714986287104]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;year&apos;, [order_date])+ &quot;-&quot; +&quot;Q&quot;+DATENAME(&apos;quarter&apos;, [order_date])' />
            </column>
            <column caption='Order Date (Previous Months)' datatype='date' name='[Order Date (copy)]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [order_date] &lt; DATETRUNC(&apos;month&apos;,{FIXED : MAX([order_date])}) THEN [order_date] END' />
            </column>
            <column caption='Acquisitions' datatype='integer' name='[acquisitions]' role='measure' type='quantitative' />
            <column caption='Active Customers 12M' datatype='integer' name='[active_customers_12m]' role='measure' type='quantitative' />
            <column caption='Active Customers 1M' datatype='integer' name='[active_customers_1m]' role='measure' type='quantitative' />
            <column caption='Active Customers Cum' datatype='integer' name='[active_customers_cum]' role='measure' type='quantitative' />
            <column caption='Amt Gmv Eur' datatype='real' name='[amt_gmv_eur]' role='measure' type='quantitative' />
            <column caption='Amt Gmv Local' datatype='real' name='[amt_gmv_local]' role='measure' type='quantitative' />
            <column caption='Amt Voucher Dh Eur' datatype='real' name='[amt_voucher_dh_eur]' role='measure' type='quantitative' />
            <column caption='Amt Voucher Dh Local' datatype='real' name='[amt_voucher_dh_local]' role='measure' type='quantitative' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Is Dh Delivery' datatype='boolean' name='[is_dh_delivery]' role='dimension' type='nominal' />
            <column caption='Lucanet Entity Name' datatype='string' name='[lucanet_entity_name]' role='dimension' type='nominal' />
            <column caption='Management Entity Group' datatype='string' name='[management_entity_group]' role='dimension' type='nominal' />
            <column-instance column='[Order Date (copy)]' derivation='MY' name='[my:Order Date (copy):ok]' pivot='key' type='ordinal' />
            <column-instance column='[lucanet_entity_name]' derivation='None' name='[none:lucanet_entity_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[management_entity_group]' derivation='None' name='[none:management_entity_group:nk]' pivot='key' type='nominal' />
            <column-instance column='[region]' derivation='None' name='[none:region:nk]' pivot='key' type='nominal' />
            <column caption='Order Date' datatype='date' name='[order_date]' role='dimension' type='ordinal' />
            <column caption='Order Type' datatype='string' name='[order_type]' role='dimension' type='nominal' />
            <column caption='Order Week' datatype='string' name='[order_week]' role='dimension' type='nominal' />
            <column caption='Orders Succ' datatype='integer' name='[orders_succ]' role='measure' type='quantitative' />
            <column caption='Orders Succ Online' datatype='integer' name='[orders_succ_online]' role='measure' type='quantitative' />
            <column caption='Region' datatype='string' name='[region]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_3703436677877624834]' derivation='Sum' name='[sum:Calculation_3703436677877624834:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_5693675833014968320]' derivation='Sum' name='[sum:Calculation_5693675833014968320:qk]' pivot='key' type='quantitative' />
            <column-instance column='[acquisitions]' derivation='Sum' name='[sum:acquisitions:qk]' pivot='key' type='quantitative' />
            <column-instance column='[active_customers_12m]' derivation='Sum' name='[sum:active_customers_12m:qk]' pivot='key' type='quantitative' />
            <column-instance column='[active_customers_1m]' derivation='Sum' name='[sum:active_customers_1m:qk]' pivot='key' type='quantitative' />
            <column-instance column='[orders_succ]' derivation='Sum' name='[sum:orders_succ:qk]' pivot='key' type='quantitative' />
            <column-instance column='[order_date]' derivation='Month-Trunc' name='[tmn:order_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[% DH Delivery (copy)]' derivation='User' name='[usr:% DH Delivery (copy):qk]' pivot='key' type='quantitative' />
            <column-instance column='[% Mobile Orders (copy)]' derivation='User' name='[usr:% Mobile Orders (copy):qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_3703436677877010433]' derivation='User' name='[usr:Calculation_3703436677877010433:qk]' pivot='key' type='quantitative' />
