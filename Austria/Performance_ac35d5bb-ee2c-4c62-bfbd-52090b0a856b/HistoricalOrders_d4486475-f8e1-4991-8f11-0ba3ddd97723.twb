        </title>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/HistoricalOrders/Chart?rev=' id='Chart' path='/t/GlobalStandardReporting/workbooks/HistoricalOrders' revision='' site='GlobalStandardReporting' />
      <table>
        <view>
          <datasources>
            <datasource caption='BigQuery' name='federated.0dai72s1ng66wq1bq1c1b0rctyqq' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose Date Dimension' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
            <column caption='Choose KPI' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Orders&quot;'>
              <calculation class='tableau' formula='&quot;Orders&quot;' />
            </column>
            <column alias='EUR' caption='Choose Currency' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Eur&quot;'>
              <calculation class='tableau' formula='&quot;Eur&quot;' />
              <aliases>
                <alias key='&quot;Eur&quot;' value='EUR' />
              </aliases>
            </column>
            <column caption='Toggle Legend' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Management Entity&quot;'>
              <calculation class='tableau' formula='&quot;Management Entity&quot;' />
            </column>
            <column caption='Moving Average Over X' datatype='integer' name='[Parameter 7]' param-domain-type='range' role='measure' type='quantitative' value='0'>
              <calculation class='tableau' formula='0' />
              <range max='28' min='0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0dai72s1ng66wq1bq1c1b0rctyqq'>
            <column caption='Failure Rate' datatype='real' name='[Calculation_1024780059985756164]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_fail])/SUM([orders_total])' />
            </column>
            <column caption='Effective Commission Rate' datatype='real' name='[Calculation_1024780059985854469]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([amt_commission_eur])/SUM([amt_gmv_eur])' />
            </column>
            <column caption='Date Dimension Chart' datatype='datetime' name='[Calculation_1024780059992965130]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &quot;Year&quot; THEN DATETRUNC(&quot;year&quot;, [order_date])&#10;    WHEN &quot;Quarter&quot; THEN DATETRUNC(&quot;quarter&quot;, [order_date])&#10;    WHEN &quot;Month&quot; THEN DATETRUNC(&quot;month&quot;, [order_date])&#10;    WHEN &quot;Week&quot; THEN DATETRUNC(&quot;week&quot;, [order_date],&quot;monday&quot;)&#10;    WHEN &quot;Date&quot; THEN [order_date]&#10;END' />
            </column>
            <column caption='Acquisitions (1)' datatype='integer' name='[Calculation_1024780060008738830]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [order_type] = &quot;acquisition&quot; THEN [acquisitions] ELSE 0 END' />
            </column>
            <column caption='GMV' datatype='real' name='[Calculation_3703436677877010433]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;    WHEN &quot;Eur&quot; THEN SUM([amt_gmv_eur])&#10;    WHEN &quot;Local Currency&quot; THEN SUM([amt_gmv_local])&#10;END' />
            </column>
            <column caption='GMV (Before Discount)' datatype='real' name='[Calculation_3703436677877624834]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;    WHEN &quot;Eur&quot; THEN [amt_gmv_eur] + IFNULL([amt_voucher_dh_eur],0)&#10;    WHEN &quot;Local Currency&quot; THEN [amt_gmv_local] + IFNULL([amt_voucher_dh_local],0)&#10;END' />
            </column>
            <column caption='Commission' datatype='real' name='[Calculation_3703436677877891075]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;    WHEN &quot;Eur&quot; THEN [amt_commission_eur]&#10;    WHEN &quot;Local Currency&quot; THEN [amt_commission_local]&#10;END' />
            </column>
            <column caption='Legend' datatype='string' name='[Calculation_4248864814950170624]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;    WHEN &quot;Management Entity&quot; THEN [management_entity_group]&#10;    WHEN &quot;Sub-Entity&quot; THEN [display_name]&#10;    WHEN &quot;Country&quot; THEN [country]&#10;    WHEN &quot;Global&quot; THEN &quot;DH&quot;&#10;END' />
            </column>
            <column caption='KPI (Moving Average)' datatype='real' name='[KPI (copy 3)_5221009010182275072]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG(&#10;IF [Parameters].[Parameter 2] = &quot;Orders&quot; THEN SUM([orders_succ])&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Acquisitions&quot; THEN SUM([Calculation_1024780060008738830])&#10;ELSEIF [Parameters].[Parameter 2] = &quot;GMV&quot; THEN [Calculation_3703436677877010433]&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Commission&quot; THEN SUM([Calculation_3703436677877891075])&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Commission Rate&quot; THEN [Calculation_1024780059985854469]&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Failure Rate&quot; THEN [Calculation_1024780059985756164]&#10;ELSEIF [Parameters].[Parameter 2] = &quot;GMV (After Discount)&quot; THEN SUM([Calculation_3703436677877624834])&#10;END,&#10;-[Parameters].[Parameter 7],&#10;0&#10;)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
