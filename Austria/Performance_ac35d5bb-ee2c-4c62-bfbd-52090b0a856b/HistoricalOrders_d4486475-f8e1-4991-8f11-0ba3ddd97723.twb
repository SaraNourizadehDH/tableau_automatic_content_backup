    <worksheet name='Customer Base Growth YoY'>
      <table>
        <view>
          <datasources>
            <datasource caption='BigQuery' name='federated.0dai72s1ng66wq1bq1c1b0rctyqq' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose Date Dimension' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
            <column caption='Choose Date Dimension YoY' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0dai72s1ng66wq1bq1c1b0rctyqq'>
            <column datatype='real' name='[Base Growth YoY (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_5693675833014968320]) &#10;/ LOOKUP(SUM([Calculation_5693675833014968320]), &#10;CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Year&quot; THEN -1&#10;WHEN &quot;Month&quot; THEN -12&#10;WHEN &quot;Week&quot; THEN -52&#10;WHEN &quot;Date&quot; THEN -365&#10;END&#10;) - 1'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Day of Week' datatype='string' name='[Calculation_1024780059979005952]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;,[order_date])' />
            </column>
            <column caption='Date Dimension' datatype='string' name='[Calculation_1024780059979481089]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &quot;Year&quot; THEN [Calculation_1024780059988475911]&#10;    WHEN &quot;Quarter&quot; THEN [Month (copy)_1607714714986287104]&#10;    WHEN &quot;Month&quot; THEN [Calculation_1024780059979702274]&#10;    WHEN &quot;Week&quot; THEN [order_week]&#10;    WHEN &quot;Date&quot; THEN [Calculation_1024780059987800070]&#10;    WHEN &quot;Day of Week&quot; THEN [Calculation_1024780059979005952]&#10;END' />
            </column>
            <column caption='Month' datatype='string' name='[Calculation_1024780059979702274]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;year&apos;, [order_date]) + &quot;-&quot; + IIF(MONTH([order_date])&lt;10, &quot;0&quot;,&quot;&quot;) + STR(MONTH([order_date]))' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_1024780059987800070]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;year&apos;, [order_date]) &#10;+ IIF(MONTH([order_date])&lt;10, &quot;-0&quot;,&quot;-&quot;) &#10;+ STR(MONTH([order_date]))&#10;+ IIF(DAY([order_date])&lt;10, &quot;-0&quot;,&quot;-&quot;) &#10;+ STR(DAY([order_date]))' />
            </column>
            <column caption='Year' datatype='string' name='[Calculation_1024780059988475911]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(YEAR([order_date]))' />
            </column>
            <column caption='Date Dimension Chart' datatype='datetime' name='[Calculation_1024780059992965130]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &quot;Year&quot; THEN DATETRUNC(&quot;year&quot;, [order_date])&#10;    WHEN &quot;Quarter&quot; THEN DATETRUNC(&quot;quarter&quot;, [order_date])&#10;    WHEN &quot;Month&quot; THEN DATETRUNC(&quot;month&quot;, [order_date])&#10;    WHEN &quot;Week&quot; THEN DATETRUNC(&quot;week&quot;, [order_date],&quot;monday&quot;)&#10;    WHEN &quot;Date&quot; THEN [order_date]&#10;END' />
            </column>
            <column caption='Everything' datatype='string' name='[Calculation_1024780060002209803]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;Hover and Click the + to drill down to show companies&quot;' />
              <aliases>
                <alias key='&quot;Hover and Click the + to drill down to show companies&quot;' value='Hover and Click the + to drill down to show entities &amp; companies' />
              </aliases>
            </column>
            <column caption='Month Name' datatype='string' name='[Calculation_1024780060006912012]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;month&apos;, [order_date])' />
            </column>
            <column caption='Base Growth YoY (filtered)' datatype='real' name='[Calculation_4124101026824978437]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Base Growth YoY (copy)] &gt; 4 THEN NULL ELSE [Base Growth YoY (copy)] END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Date Dimension YoY' datatype='string' name='[Calculation_4760093758784229379]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 3] = &quot;Quarter&quot; AND DATETRUNC(&apos;quarter&apos;,[order_date])&lt;DATETRUNC(&apos;quarter&apos;,today()) then [Calculation_1024780060006912012]&#10;elseif [Parameters].[Parameter 3] = &quot;Month&quot; AND DATETRUNC(&apos;month&apos;,[order_date])&lt;DATETRUNC(&apos;month&apos;,today()) then [Calculation_1024780060006912012]&#10;elseif [Parameters].[Parameter 3] = &quot;Week&quot; then [Calculation_5046494526122684420]&#10;end' />
            </column>
            <column caption='Week Num' datatype='string' name='[Calculation_5046494526122684420]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='RIGHT([order_week],2)' />
            </column>
            <column caption='Active Customers (Cumulative)' datatype='integer' name='[Calculation_5693675833014968320]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [global_entity_id], [Calculation_1024780059979481089],[is_dh_delivery],[order_type] : MAX([active_customers_cum])}' />
            </column>
            <column caption='Quarter' datatype='string' name='[Month (copy)_1607714714986287104]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;year&apos;, [order_date])+ &quot;-&quot; +&quot;Q&quot;+DATENAME(&apos;quarter&apos;, [order_date])' />
            </column>
            <column caption='Active Customers Cum' datatype='integer' name='[active_customers_cum]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
