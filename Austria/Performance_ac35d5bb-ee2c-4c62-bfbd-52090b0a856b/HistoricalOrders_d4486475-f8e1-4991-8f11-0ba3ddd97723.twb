    <worksheet name='Table'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/HistoricalOrders/Table?rev=' id='Table' path='/t/GlobalStandardReporting/workbooks/HistoricalOrders' revision='' site='GlobalStandardReporting' />
      <table>
        <view>
          <datasources>
            <datasource caption='BigQuery' name='federated.0dai72s1ng66wq1bq1c1b0rctyqq' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose Date Dimension' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
            <column alias='EUR' caption='Choose Currency' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Eur&quot;'>
              <calculation class='tableau' formula='&quot;Eur&quot;' />
              <aliases>
                <alias key='&quot;Eur&quot;' value='EUR' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0dai72s1ng66wq1bq1c1b0rctyqq'>
            <column caption='% DH Delivery' datatype='real' default-format='p0.00%' name='[% Mobile Orders (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_dh_delivery] = TRUE THEN [orders_succ] END)/SUM([orders_succ])' />
            </column>
            <column caption='Base Growth YoY' datatype='real' name='[Active Customers (Cumulative) (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_5693675833014968320]) &#10;/ LOOKUP(SUM([Calculation_5693675833014968320]), &#10;CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Year&quot; THEN 1&#10;WHEN &quot;Quarter&quot; THEN 4&#10;WHEN &quot;Month&quot; THEN 12&#10;WHEN &quot;Week&quot; THEN 52&#10;WHEN &quot;Date&quot; THEN 365&#10;END&#10;) - 1'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Day of Week' datatype='string' name='[Calculation_1024780059979005952]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;,[order_date])' />
            </column>
            <column caption='Date Dimension' datatype='string' name='[Calculation_1024780059979481089]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &quot;Year&quot; THEN [Calculation_1024780059988475911]&#10;    WHEN &quot;Quarter&quot; THEN [Month (copy)_1607714714986287104]&#10;    WHEN &quot;Month&quot; THEN [Calculation_1024780059979702274]&#10;    WHEN &quot;Week&quot; THEN [order_week]&#10;    WHEN &quot;Date&quot; THEN [Calculation_1024780059987800070]&#10;    WHEN &quot;Day of Week&quot; THEN [Calculation_1024780059979005952]&#10;END' />
            </column>
            <column caption='Month' datatype='string' name='[Calculation_1024780059979702274]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;year&apos;, [order_date]) + &quot;-&quot; + IIF(MONTH([order_date])&lt;10, &quot;0&quot;,&quot;&quot;) + STR(MONTH([order_date]))' />
            </column>
            <column caption='Failure Rate' datatype='real' name='[Calculation_1024780059985756164]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_fail])/SUM([orders_total])' />
            </column>
            <column caption='Effective Commission Rate' datatype='real' name='[Calculation_1024780059985854469]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([amt_commission_eur])/SUM([amt_gmv_eur])' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_1024780059987800070]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;year&apos;, [order_date]) &#10;+ IIF(MONTH([order_date])&lt;10, &quot;-0&quot;,&quot;-&quot;) &#10;+ STR(MONTH([order_date]))&#10;+ IIF(DAY([order_date])&lt;10, &quot;-0&quot;,&quot;-&quot;) &#10;+ STR(DAY([order_date]))' />
            </column>
            <column caption='Year' datatype='string' name='[Calculation_1024780059988475911]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(YEAR([order_date]))' />
            </column>
            <column caption='Everything' datatype='string' name='[Calculation_1024780060002209803]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;Hover and Click the + to drill down to show companies&quot;' />
              <aliases>
                <alias key='&quot;Hover and Click the + to drill down to show companies&quot;' value='Hover and Click the + to drill down to show entities &amp; companies' />
              </aliases>
            </column>
            <column caption='Acquisitions (1)' datatype='integer' name='[Calculation_1024780060008738830]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [order_type] = &quot;acquisition&quot; THEN [acquisitions] ELSE 0 END' />
            </column>
            <column caption='GMV Frequency' datatype='real' name='[Calculation_2150046637821382656]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3703436677877010433]&#10;/SUM([Calculation_5693675833014968320])' />
            </column>
            <column caption='orders_succ_mobile_app' datatype='integer' name='[Calculation_2228226324320903169]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_succ_android])+SUM([orders_succ_ios])' />
            </column>
            <column caption='orders_succ_other' datatype='integer' name='[Calculation_2228226324321161218]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_succ]) &#10;- SUM([orders_succ_android]) &#10;- SUM([orders_succ_ios])&#10;- SUM([orders_succ_web_desktop])&#10;- SUM([orders_succ_web_mobile])' />
            </column>
            <column caption='GMV  YoY' datatype='real' name='[Calculation_2776117390421667840]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;    WHEN &quot;Eur&quot; THEN &#10;CASE  [Parameters].[Parameter 1]&#10;    WHEN &quot;Year&quot; THEN SUM([amt_gmv_eur])/sum([amt_gmv_eur_yoy])-1&#10;    WHEN &quot;Quarter&quot; THEN SUM([amt_gmv_eur])/sum([amt_gmv_eur_yoy])-1&#10;    WHEN &quot;Month&quot; THEN SUM([amt_gmv_eur])/sum([amt_gmv_eur_yoy])-1&#10;    WHEN &quot;Week&quot; THEN SUM([amt_gmv_eur])/sum([GMV YoY (copy)_2151242906481766401])-1&#10;    WHEN &quot;Date&quot; THEN SUM([amt_gmv_eur])/SUM([GMV YoY (copy)_2151242906481766401])-1&#10;    WHEN &quot;Day of Week&quot; THEN SUM([amt_gmv_eur])/SUM([GMV YoY (copy)_2151242906481766401])-1&#10;END&#10;&#10;    WHEN &quot;Local Currency&quot; THEN CASE  [Parameters].[Parameter 1]&#10;    WHEN &quot;Year&quot; THEN SUM([amt_gmv_local])/sum([amt_gmv_local_yoy])-1&#10;    WHEN &quot;Quarter&quot; THEN SUM([amt_gmv_local])/sum([amt_gmv_local_yoy])-1&#10;    WHEN &quot;Month&quot; THEN SUM([amt_gmv_local])/sum([amt_gmv_local_yoy])-1&#10;    WHEN &quot;Week&quot; THEN SUM([amt_gmv_local])/sum([GMV YoY (copy)_2151242906481766401])-1&#10;    WHEN &quot;Date&quot; THEN SUM([amt_gmv_local])/SUM([GMV YoY (copy)_2151242906481766401])-1&#10;    WHEN &quot;Day of Week&quot; THEN SUM([amt_gmv_eur])/SUM([GMV YoY (copy)_2151242906481766401])-1&#10;&#10;END END' />
            </column>
            <column caption='OD Orders' datatype='integer' name='[Calculation_3563965790579429376]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_dh_delivery] = TRUE THEN [orders_succ] END)' />
            </column>
            <column caption='Frequency' datatype='real' name='[Calculation_3680707536640925696]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_succ])/SUM([Calculation_5693675833014968320])' />
            </column>
            <column caption='Frequency Growth YoY' datatype='real' name='[Calculation_3680707536654635009]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([orders_succ])/SUM([Calculation_5693675833014968320])) &#10;/ &#10;(&#10;    CASE [Parameters].[Parameter 1]&#10;        WHEN &quot;Year&quot; THEN SUM([orders_succ_yoy])&#10;        WHEN &quot;Quarter&quot; THEN SUM([orders_succ_yoy])&#10;        WHEN &quot;Month&quot; THEN SUM([orders_succ_yoy])&#10;        WHEN &quot;Week&quot; THEN SUM([orders_succ_yoy_same_day])&#10;        WHEN &quot;Date&quot; THEN SUM([orders_succ_yoy_same_day])&#10;    END&#10;    /&#10;    LOOKUP(SUM([Calculation_5693675833014968320]), &#10;        CASE [Parameters].[Parameter 1]&#10;            WHEN &quot;Year&quot; THEN 1&#10;            WHEN &quot;Quarter&quot; THEN 4&#10;            WHEN &quot;Month&quot; THEN 12&#10;            WHEN &quot;Week&quot; THEN 52&#10;            WHEN &quot;Date&quot; THEN 365&#10;        END&#10;    ) &#10;) - 1'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='GMV' datatype='real' name='[Calculation_3703436677877010433]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;    WHEN &quot;Eur&quot; THEN SUM([amt_gmv_eur])&#10;    WHEN &quot;Local Currency&quot; THEN SUM([amt_gmv_local])&#10;END' />
            </column>
            <column caption='Commission' datatype='real' name='[Calculation_3703436677877891075]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;    WHEN &quot;Eur&quot; THEN [amt_commission_eur]&#10;    WHEN &quot;Local Currency&quot; THEN [amt_commission_local]&#10;END' />
            </column>
            <column caption='DH Paid Discount' datatype='real' name='[Calculation_3703436677878235140]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;    WHEN &quot;Eur&quot; THEN IFNULL([amt_voucher_dh_eur],0) + IFNULL([amt_discount_dh_eur], 0)&#10;    WHEN &quot;Local Currency&quot; THEN IFNULL([amt_voucher_dh_local],0) + IFNULL([amt_discount_dh_local], 0)&#10;END' />
            </column>
            <column caption='% Paid by DH Discount' datatype='real' name='[Calculation_5046494525726470145]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IFNULL([amt_voucher_dh_eur],0)+IFNULL([amt_discount_dh_eur],0))/(sum([amt_gmv_eur]) + sum(IFNULL([amt_voucher_dh_eur],0)+IFNULL([amt_discount_dh_eur],0)))' />
            </column>
            <column caption='% Paid Not by DH' datatype='real' name='[Calculation_5046494525726998530]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-[Calculation_5046494525726470145]' />
            </column>
            <column caption='Reorders' datatype='integer' name='[Calculation_5046494526137155589]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders_succ])-sum([Calculation_1024780060008738830])' />
            </column>
            <column caption='Orders Succ YOY' datatype='real' name='[Calculation_5046494526155563015]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &quot;Year&quot; THEN SUM([orders_succ])/sum([orders_succ_yoy])-1&#10;    WHEN &apos;Quarter&apos; THEN SUM([orders_succ])/sum([orders_succ_yoy])-1&#10;    WHEN &quot;Month&quot; THEN SUM([orders_succ])/sum([orders_succ_yoy])-1&#10;    WHEN &quot;Week&quot; THEN SUM([orders_succ])/sum([orders_succ_yoy_same_day])-1&#10;    WHEN &quot;Date&quot; THEN SUM([orders_succ])/SUM([orders_succ_yoy_same_day])-1&#10;END' />
            </column>
            <column caption='Active Customers (Cumulative)' datatype='integer' name='[Calculation_5693675833014968320]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [global_entity_id], [Calculation_1024780059979481089],[is_dh_delivery],[order_type] : MAX([active_customers_cum])}' />
            </column>
            <column caption='Active Customers (This Month)' datatype='integer' name='[Calculation_5693675833015123969]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{INCLUDE [global_entity_id] : MAX([active_customers_1m])}' />
            </column>
            <column caption='Activity Rate (This Month/Cumulative)' datatype='real' name='[Calculation_5693675833024458755]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_5693675833015123969])/SUM([Calculation_5693675833014968320])' />
            </column>
            <column caption='Orders Per Active Customer (This Month)' datatype='real' name='[Calculation_5693675833049989124]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_succ])/SUM([Calculation_5693675833015123969])' />
            </column>
            <column caption='% Online Payment Orders' datatype='real' default-format='p0.00%' name='[Calculation_6469913450705956869]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders_succ_online])/sum([orders_succ])' />
            </column>
            <column caption='GMV Frequency Growth YoY' datatype='real' name='[Frequency Growth YoY (copy 2)_5492350880273137664]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_3703436677877010433]/SUM([Calculation_5693675833014968320])) &#10;/ &#10;(&#10;    CASE [Parameters].[Parameter 1]&#10;        WHEN &quot;Year&quot; THEN [GMV (copy)_2151242906481549312]&#10;        WHEN &quot;Month&quot; THEN [GMV (copy)_2151242906481549312]&#10;        WHEN &quot;Quarter&quot; THEN [GMV (copy)_2151242906481549312]&#10;        WHEN &quot;Week&quot; THEN SUM([GMV YoY (copy)_2151242906481766401])&#10;        WHEN &quot;Date&quot; THEN SUM([GMV YoY (copy)_2151242906481766401])&#10;    END&#10;    /&#10;    LOOKUP(SUM([Calculation_5693675833014968320]), &#10;        CASE [Parameters].[Parameter 1]&#10;            WHEN &quot;Year&quot; THEN 1&#10;            WHEN &quot;Quarter&quot; THEN 4&#10;            WHEN &quot;Month&quot; THEN 12&#10;            WHEN &quot;Week&quot; THEN 52&#10;            WHEN &quot;Date&quot; THEN 365&#10;        END&#10;    ) &#10;) - 1'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='GMV YoY' datatype='real' name='[GMV (copy)_2151242906481549312]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;    WHEN &quot;Eur&quot; THEN SUM([amt_gmv_eur_yoy])&#10;    WHEN &quot;Local Currency&quot; THEN SUM([amt_gmv_local_yoy])&#10;END' />
            </column>
            <column caption='GMV YoY Same Day' datatype='real' name='[GMV YoY (copy)_2151242906481766401]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;    WHEN &quot;Eur&quot; THEN [amt_gmv_eur_yoy_same_day]&#10;    WHEN &quot;Local Currency&quot; THEN [amt_gmv_local_yoy_same_day]&#10;END' />
            </column>
            <column caption='Quarter' datatype='string' name='[Month (copy)_1607714714986287104]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;year&apos;, [order_date])+ &quot;-&quot; +&quot;Q&quot;+DATENAME(&apos;quarter&apos;, [order_date])' />
            </column>
            <column caption='Acquisitions YoY' datatype='real' name='[Orders Succ YOY (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &quot;Year&quot; THEN SUM([Calculation_1024780060008738830])/sum([acquisitions_yoy])-1&#10;    WHEN &quot;Quarter&quot; THEN SUM([Calculation_1024780060008738830])/sum([acquisitions_yoy])-1&#10;    WHEN &quot;Month&quot; THEN SUM([Calculation_1024780060008738830])/sum([acquisitions_yoy])-1&#10;    WHEN &quot;Week&quot; THEN SUM([Calculation_1024780060008738830])/sum([acquisitions_yoy (copy)])-1&#10;    WHEN &quot;Date&quot; THEN SUM([Calculation_1024780060008738830])/SUM([acquisitions_yoy (copy)])-1&#10;END' />
            </column>
            <column caption='Acquisitions' datatype='integer' name='[acquisitions]' role='measure' type='quantitative' />
            <column caption='acquisitions_yoyd' datatype='integer' name='[acquisitions_yoy (copy)]' role='measure' type='quantitative'>
