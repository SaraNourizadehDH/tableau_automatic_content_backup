            <column-instance column='[Calculation_1024780059991732233]' derivation='User' name='[pcdf:usr:Calculation_1024780059991732233:qk:3]' pivot='key' type='quantitative'>
              <table-calc diff-options='Relative' ordering-field='[federated.0dai72s1ng66wq1bq1c1b0rctyqq].[Calculation_1024780059988475911]' ordering-type='Field' type='PctDiff'>
