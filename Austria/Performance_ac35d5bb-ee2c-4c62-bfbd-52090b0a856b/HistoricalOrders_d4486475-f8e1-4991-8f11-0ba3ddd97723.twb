      </column>
      <column caption='KPI (YoY Chart)' datatype='real' name='[KPI (copy 2)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4] &#10;    WHEN &quot;Orders&quot; THEN SUM([orders_succ])&#10;    WHEN &quot;Acquisitions&quot; THEN SUM([Calculation_1024780060008738830])&#10;    WHEN &quot;GMV&quot; THEN [Calculation_3703436677877010433]&#10;END' />
      </column>
      <column caption='KPI (Moving Average)' datatype='real' name='[KPI (copy 3)_5221009010182275072]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(&#10;IF [Parameters].[Parameter 2] = &quot;Orders&quot; THEN SUM([orders_succ])&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Acquisitions&quot; THEN SUM([Calculation_1024780060008738830])&#10;ELSEIF [Parameters].[Parameter 2] = &quot;GMV&quot; THEN [Calculation_3703436677877010433]&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Commission&quot; THEN SUM([Calculation_3703436677877891075])&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Commission Rate&quot; THEN [Calculation_1024780059985854469]&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Failure Rate&quot; THEN [Calculation_1024780059985756164]&#10;ELSEIF [Parameters].[Parameter 2] = &quot;GMV (After Discount)&quot; THEN SUM([Calculation_3703436677877624834])&#10;END,&#10;-[Parameters].[Parameter 7],&#10;0&#10;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='YoY KPI ' datatype='real' name='[KPI (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4] &#10;    WHEN &quot;Orders&quot; THEN [Calculation_4124101026815606785]&#10;    WHEN &quot;Acquisitions&quot; THEN [Calculation_4124101026817273858]&#10;    WHEN &quot;GMV&quot; THEN [Calculation_4124101026817445891]&#10;END' />
      </column>
      <column caption='Quarter' datatype='string' name='[Month (copy)_1607714714986287104]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;year&apos;, [order_date])+ &quot;-&quot; +&quot;Q&quot;+DATENAME(&apos;quarter&apos;, [order_date])' />
      </column>
      <column caption='Order Date (Previous Months)' datatype='date' name='[Order Date (copy)]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [order_date] &lt; DATETRUNC(&apos;month&apos;,{FIXED : MAX([order_date])}) THEN [order_date] END' />
      </column>
      <column caption='Orders Succ YoY (For YoY Chart)' datatype='real' name='[Orders Succ YOY (copy 2)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN &quot;Month&quot; THEN SUM([orders_succ])/sum([orders_succ_yoy])-1&#10;    WHEN &quot;Week&quot; THEN SUM([orders_succ])/sum([orders_succ_yoy_same_day])-1&#10;END' />
      </column>
      <column caption='Acquisitions YoY' datatype='real' name='[Orders Succ YOY (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &quot;Year&quot; THEN SUM([Calculation_1024780060008738830])/sum([acquisitions_yoy])-1&#10;    WHEN &quot;Quarter&quot; THEN SUM([Calculation_1024780060008738830])/sum([acquisitions_yoy])-1&#10;    WHEN &quot;Month&quot; THEN SUM([Calculation_1024780060008738830])/sum([acquisitions_yoy])-1&#10;    WHEN &quot;Week&quot; THEN SUM([Calculation_1024780060008738830])/sum([acquisitions_yoy (copy)])-1&#10;    WHEN &quot;Date&quot; THEN SUM([Calculation_1024780060008738830])/SUM([acquisitions_yoy (copy)])-1&#10;END' />
      </column>
