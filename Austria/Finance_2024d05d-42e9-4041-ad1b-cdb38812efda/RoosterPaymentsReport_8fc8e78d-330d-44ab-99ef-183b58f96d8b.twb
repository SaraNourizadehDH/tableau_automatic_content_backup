        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1pp65et0k1yvql1g6gwv41wzka2s' name='Custom SQL Query' type='text'><![CDATA[with CALC as (SELECT country_code,
                     extract(month from created_date) as month,
                     created_date,
                     rider_id,
                     rider_name,
                     r.payment_rule_id,
                     sum(r.total)                     as total,
                     sum(r.amount)                    as amount
              FROM `fulfillment-dwh-production.curated_data_shared.rider_payments` p
                       left join unnest(payment_details.basic_by_rule) r
              WHERE country_code = 'at'
                and date_diff(current_date(),created_date, month) <<= 3
              group by 1, 2, 3, 4, 5, 6 )
SELECT c.country_code,
       month,
       c.created_date,
       rider_id,
       rider_name,
       payment_rule_id,
       b.name,
       b.amount      as payment_per_unit,
       sum(c.amount) as total_units,
       sum(c.total)  as total_payment
FROM CALC c
         left join `fulfillment-dwh-production.curated_data_shared.payments_basic_rules` b
                   on c.country_code = b.country_code and c.payment_rule_id = b.id
where c.payment_rule_id is not null
group by 1, 2, 3, 4, 5, 6, 7, 8
order by 2, 4, 5]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1pp65et0k1yvql1g6gwv41wzka2s' name='Custom SQL Query' type='text'><![CDATA[with CALC as (SELECT country_code,
                     extract(month from created_date) as month,
                     created_date,
                     rider_id,
                     rider_name,
                     r.payment_rule_id,
                     sum(r.total)                     as total,
                     sum(r.amount)                    as amount
              FROM `fulfillment-dwh-production.curated_data_shared.rider_payments` p
                       left join unnest(payment_details.basic_by_rule) r
              WHERE country_code = 'at'
                and date_diff(current_date(),created_date, month) <<= 3
              group by 1, 2, 3, 4, 5, 6 )
SELECT c.country_code,
       month,
       c.created_date,
       rider_id,
       rider_name,
       payment_rule_id,
       b.name,
       b.amount      as payment_per_unit,
       sum(c.amount) as total_units,
       sum(c.total)  as total_payment
FROM CALC c
         left join `fulfillment-dwh-production.curated_data_shared.payments_basic_rules` b
                   on c.country_code = b.country_code and c.payment_rule_id = b.id
where c.payment_rule_id is not null
group by 1, 2, 3, 4, 5, 6, 7, 8
order by 2, 4, 5]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
