    pd_vendors.location.street AS vendor_street,
    pd_vendors.location.city AS vendor_city,
    pd_vendors.location.postal_code AS vendor_post_code,
    pd_vendors.chain_name,
    pd_vendors.has_delivery_type_pickup,
  FROM
    `fulfillment-dwh-production.pandata_curated.pd_vendors` pd_vendors
  CROSS JOIN
    date_month
  LEFT JOIN vd_hist_act
  ON (vd_hist_act.vendor_id=pd_vendors.vendor_code
        AND vd_hist_act.valid_at=date_month.iso_date)
  WHERE
    pd_vendors.global_entity_id = 'MJM_AT'
    AND is_online
   ),
  reorder_rate_90d AS (
  SELECT
    first_day_of_month,
    vendor_uuid,
    COUNT(DISTINCT(CASE
          WHEN has_reordered THEN customer_uuid
      END
        )) AS customers_reordered_90d,
    COUNT(DISTINCT customer_uuid) AS customers_90d
  FROM (
    SELECT
      first_day_of_month,
      csn.uuid AS vendor_uuid,
      pd_orders.pd_customer_uuid AS customer_uuid,
      COUNT(pd_orders.uuid) >> 1 AS has_reordered
    FROM
