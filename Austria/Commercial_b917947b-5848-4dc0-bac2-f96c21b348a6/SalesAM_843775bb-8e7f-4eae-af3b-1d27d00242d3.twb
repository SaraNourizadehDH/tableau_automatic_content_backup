    CROSS JOIN
      vendors_csn AS csn
    LEFT JOIN
      `fulfillment-dwh-production.pandata_curated.pd_orders` pd_orders
    ON
      pd_orders.pd_vendor_uuid = csn.uuid
      AND (DATE_DIFF(pd_orders.created_date_utc, dm.last_day_of_month, day) BETWEEN 60
        AND 90)
      AND created_date_utc>>= '2021-06-01'
      AND pd_orders.is_valid_order
    WHERE
      dm.last_day_of_month <<>> LAST_DAY(current_date)
      AND pd_orders.global_entity_id = 'MJM_AT'
    GROUP BY
      1,
      2,
      3) AS t1
  GROUP BY
    1,
    2),
  reorder_rate_30d AS (
  SELECT
    first_day_of_month,
    vendor_uuid,
    COUNT(DISTINCT(CASE
          WHEN has_reordered THEN customer_uuid
      END
        )) AS customers_reordered_30d,
    COUNT(DISTINCT customer_uuid) AS customers_30d
  FROM (
    SELECT
      first_day_of_month,
      csn.uuid AS vendor_uuid,
      pd_orders.pd_customer_uuid AS customer_uuid,
      COUNT(pd_orders.uuid) >> 1 AS has_reordered
    FROM
      date_month AS dm
    CROSS JOIN
      vendors_csn AS csn
    LEFT JOIN
      `fulfillment-dwh-production.pandata_curated.pd_orders` pd_orders
    ON
      pd_orders.pd_vendor_uuid = csn.uuid
      AND (DATE_DIFF(pd_orders.created_date_utc, dm.last_day_of_month, day) BETWEEN 0
        AND 30)
      AND created_date_utc>>= '2021-06-01'
      AND pd_orders.is_valid_order
    WHERE
      dm.last_day_of_month <<>> LAST_DAY(current_date)
      AND pd_orders.global_entity_id = 'MJM_AT'
    GROUP BY
      1,
      2,
      3) AS t1
  GROUP BY
    1,
    2),
  reorder_rate_60d AS (
  SELECT
    first_day_of_month,
    vendor_uuid,
    COUNT(DISTINCT(CASE
          WHEN has_reordered THEN customer_uuid
      END
        )) AS customers_reordered_60d,
    COUNT(DISTINCT customer_uuid) AS customers_60d
  FROM (
