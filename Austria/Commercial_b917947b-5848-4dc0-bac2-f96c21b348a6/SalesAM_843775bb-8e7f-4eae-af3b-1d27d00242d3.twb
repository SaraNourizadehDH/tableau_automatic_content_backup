      <column caption='Fail Rate %' datatype='real' name='[Calculation_6641542864042582019]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([failed_orders]) / SUM([total_orders])' />
      </column>
      <column caption='Avg. GFV € ' datatype='real' name='[Calculation_6641542864043970564]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_gfv_eur])/SUM([successful_orders])' />
      </column>
      <column caption='Online Restaurants' datatype='integer' name='[Calculation_6641542864100872198]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF[is_active] THEN [vendors_uuid] END)' />
      </column>
      <column caption='Zero Order Restaurants' datatype='integer' name='[Calculation_72972439158464512]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([online_restos])-SUM([active_restaurants])' />
