      AND (DATE_DIFF(pd_orders.created_date_utc, dm.last_day_of_month, day) BETWEEN 30
        AND 60)
      AND created_date_utc>>= '2021-06-01'
      AND pd_orders.is_valid_order
    WHERE
      dm.last_day_of_month <<>> LAST_DAY(current_date)
      AND pd_orders.global_entity_id = 'MJM_AT'
    GROUP BY
      1,
      2,
      3) AS t1
  GROUP BY
    1,
    2),
  monthly_metrics AS (
  SELECT
    pd_orders.created_date_utc AS date,
    DATE_TRUNC( pd_orders.created_date_utc, month) AS date_month,
