      <column caption='Avg. GFV € ' datatype='real' name='[Avg GFV (copy)_6641542864035229698]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_gfv_eur]) / SUM([successful_orders])' />
