      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_390A63896F0B4CC8A8B76E7A417252E2'>
            <properties context=''>
              <relation connection='bigquery.0bz2c1y0ss82ed1ci7bt01y34oth' name='Custom SQL Query' type='text'>SELECT&#13;
  DATE_TRUNC(pdo.created_date_utc,isoweek) AS week,&#13;
  pdo.vendor_code,&#13;
  pdv.name AS vendor_name,&#13;
  pdv.chain_code,&#13;
  COUNT(DISTINCT pdo.uuid) AS orders&#13;
FROM&#13;
  `fulfillment-dwh-production.pandata_curated.pd_orders` pdo&#13;
LEFT JOIN&#13;
  `dha---bi-485.prod_tables.vendor_info` pdv&#13;
ON&#13;
  pdo.vendor_code = pdv.vendor_code&#13;
WHERE&#13;
  pdo.created_date_utc &gt;&gt; &quot;2022-09-01&quot;&#13;
  AND pdo.global_entity_id = &apos;MJM_AT&apos;&#13;
  AND chain_code IN(&apos;cs3hp&apos;,&#13;
    &apos;cv2oo&apos;,&#13;
    &apos;ch6oj&apos;,&#13;
    &apos;cv2oo&apos;,&#13;
    &apos;cl1ok&apos;,&#13;
    &apos;cu1op&apos;,&#13;
    &apos;cd0fr&apos;,&#13;
    &apos;cm4fd&apos;,&#13;
    &apos;cg7pn&apos;,&#13;
    &apos;cs3hp&apos;,&#13;
    &apos;ch6oj&apos;,&#13;
    &apos;cv1yp&apos;,&#13;
    &apos;cd0mi&apos;,&#13;
    &apos;cv5kr&apos;,&#13;
    &apos;cy1dd&apos;,&#13;
    &apos;ch5me&apos;,&#13;
    &apos;cp8da&apos;,&#13;
    &apos;ce0wk&apos;)&#13;
GROUP BY&#13;
  1,&#13;
  2,&#13;
  3,&#13;
  4</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
