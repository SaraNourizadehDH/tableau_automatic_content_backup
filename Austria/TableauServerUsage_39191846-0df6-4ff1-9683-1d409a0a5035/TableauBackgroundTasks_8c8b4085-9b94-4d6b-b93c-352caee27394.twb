            <column caption='Failed Jobs' datatype='integer' name='[Calculation_1568378630832902144]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(IF [job_status] = &quot;Failed&quot; THEN 1 ELSE NULL END)' />
            </column>
            <column caption='Number of Jobs &gt;5m length' datatype='integer' name='[Calculation_565131414450327554]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [mins_to_complete]&gt;=5 THEN 1 ELSE NULL END' />
            </column>
            <column caption='Avg. Job Length (m)' datatype='real' name='[Calculation_565131414450454531]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='avg([mins_to_complete])' />
            </column>
            <column caption='Max. Job Length (m)' datatype='real' name='[Calculation_565131414450556932]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='max([mins_to_complete])' />
            </column>
            <column caption='% Jobs &gt;5m' datatype='real' name='[Calculation_7850759319664955393]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_565131414450327554])/sum([Number of Records])' />
