      <column caption='Avg. Wait Time' datatype='real' name='[Avg. Job Length (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg([mins_waiting])' />
      </column>
      <column caption='Failed Jobs' datatype='integer' name='[Calculation_1568378630832902144]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [job_status] = &quot;Failed&quot; THEN 1 ELSE NULL END)' />
      </column>
      <column caption='Selected KPI' datatype='real' name='[Calculation_4281304796285480960]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;    WHEN &quot;Number of Tasks&quot; THEN [Number of Records]&#10;    WHEN &quot;Minutes to Complete&quot; THEN [mins_to_complete]&#10;END' />
      </column>
      <column caption='Job Created At' datatype='datetime' name='[Calculation_565131414405873664]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='IF [created_at]&gt;[Calculation_565131414406094849]-[Parameters].[Parameter 3] &#10;AND [created_at]&lt;[Calculation_565131414406094849] &#10;THEN [created_at] END' />
      </column>
      <column caption='Last Job Created At' datatype='datetime' name='[Calculation_565131414406094849]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='{FIXED : MAX( [created_at] )}' />
      </column>
      <column caption='Number of Jobs &gt;5m length' datatype='integer' name='[Calculation_565131414450327554]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [mins_to_complete]&gt;=5 THEN 1 ELSE NULL END' />
      </column>
      <column caption='Avg. Job Length (m)' datatype='real' name='[Calculation_565131414450454531]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg([mins_to_complete])' />
      </column>
      <column caption='Max. Job Length (m)' datatype='real' name='[Calculation_565131414450556932]' role='measure' type='quantitative'>
