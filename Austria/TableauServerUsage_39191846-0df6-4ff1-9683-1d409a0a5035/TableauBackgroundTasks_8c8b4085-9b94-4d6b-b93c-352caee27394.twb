      </column>
      <column caption='% Jobs &gt;5m' datatype='real' name='[Calculation_7850759319664955393]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_565131414450327554])/sum([Number of Records])' />
      </column>
      <column caption='% Jobs Failed' datatype='real' name='[Failed Jobs (copy)_1568378630871703553]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [job_status] = &quot;Failed&quot; THEN 1 ELSE NULL END)/COUNT(1)' />
      </column>
      <column caption='Job Started At' datatype='datetime' name='[Job Created At (copy)]' role='dimension' type='quantitative'>
