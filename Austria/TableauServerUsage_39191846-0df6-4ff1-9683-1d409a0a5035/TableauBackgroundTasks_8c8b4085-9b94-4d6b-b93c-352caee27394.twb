        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='postgres.06dmmg813rsjbr17pdnz70a401ww' name='Custom SQL Query' type='text'>WITH historical_extract_tasks AS (
    SELECT  
        hs.site_id,
        ht.task_id,
        hp.project_id,
        he.details, 
        DATE_TRUNC(&apos;minute&apos;, he.created_at) as created_at
    FROM hist_tasks ht 
    JOIN historical_events he on he.hist_task_id = ht.id AND he.historical_event_type_id = 130 
    JOIN hist_sites hs on hs.id = he.hist_target_site_id
    JOIN hist_projects hp on hp.id = he.hist_project_id
),
hist_subscription_tasks AS (
    SELECT  
        hs.site_id,
        hp.project_id,
        hw.workbook_id,
        he.details, 
        s.name,
        CASE 
            WHEN s.schedule_type = 0 THEN &apos;Hourly&apos;
            WHEN s.schedule_type = 1 THEN &apos;Daily&apos;
            WHEN s.schedule_type = 2 THEN &apos;Weekdays&apos;
            WHEN s.schedule_type = 3 THEN &apos;Monthly&apos;
        END as schedule_type,
        s.priority,
        DATE_TRUNC(&apos;minute&apos;, he.created_at) as created_at
    FROM historical_events he  
    JOIN hist_sites hs on hs.id = he.hist_target_site_id
    JOIN hist_projects hp on hp.id = he.hist_project_id
    JOIN hist_workbooks hw on hw.id = he.hist_workbook_id
    JOIN hist_schedules s on s.id = he.hist_schedule_id
    WHERE he.historical_event_type_id IN (140, 141)  --140 Workbook subscription, 141 View subscription
),
background_tasks AS (
    SELECT 
        COALESCE(b.site_id, ht.site_id) as site_id,
        ht.project_id,
        b.title,
        b.correlation_id as task_id,
        COALESCE(b.notes, ht.details) as job_notes,
        CASE WHEN b.subtitle IS NOT NULL THEN b.job_name || &apos; (&apos; || b.subtitle || &apos;)&apos;  ELSE b.job_name END as job_type,
        CASE 
            WHEN b.progress = 100 AND b.finish_code = 0 THEN &apos;Completed&apos; 
            WHEN b.progress = 100 AND b.finish_code = 1 THEN &apos;Failed&apos;
            ELSE &apos;In Progress&apos;
        END as job_status,
        CASE 
            WHEN b.priority = 0 THEN &apos;Manual&apos;
            ELSE &apos;Scheduled&apos;
        END as job_trigger_type,
        CASE WHEN b.subtitle = &apos;Datasource&apos; THEN REPLACE(SPLIT_PART(b.args, &apos;- &apos;, 3), &apos;&apos;&apos;&apos;, &apos;&apos;)::BIGINT END as datasource_id,
        CASE WHEN b.subtitle = &apos;Workbook&apos; THEN REPLACE(SPLIT_PART(b.args, &apos;- &apos;, 3), &apos;&apos;&apos;&apos;, &apos;&apos;)::BIGINT END as workbook_id,
        CASE WHEN b.job_name = &apos;Subscription Notifications&apos; THEN REPLACE(SPLIT_PART(b.args, &apos;- &apos;, 2), &apos;&apos;&apos;&apos;, &apos;&apos;)::BIGINT END as subscription_id,
        b.created_at, 
        b.started_at,
        b.completed_at,
        EXTRACT(EPOCH FROM COALESCE( b.completed_at, now() ) - b.started_at)/60 as mins_to_complete,
        EXTRACT(EPOCH FROM COALESCE( b.completed_at, now() ) - b.started_at)/(60*60*24) as days_to_complete,
        EXTRACT(EPOCH FROM COALESCE( b.started_at, now() ) - b.created_at)/60 as mins_waiting,
        COALESCE(t.priority, s.priority) as task_priority,
        s.name as schedule_name,
        CASE 
            WHEN s.schedule_type = 0 THEN &apos;Hourly&apos;
            WHEN s.schedule_type = 1 THEN &apos;Daily&apos;
            WHEN s.schedule_type = 2 THEN &apos;Weekdays&apos;
            WHEN s.schedule_type = 3 THEN &apos;Monthly&apos;
        END as schedule_type
    FROM background_jobs b
    LEFT JOIN tasks t on t.id = b.correlation_id
    LEFT JOIN historical_extract_tasks ht on ht.task_id = b.correlation_id AND ht.created_at = DATE_TRUNC(&apos;minute&apos;, b.completed_at)
    LEFT JOIN schedules s on s.id = t.schedule_id
    WHERE b.job_name in (&apos;Refresh Extracts&apos;, &apos;Increment Extracts&apos;, &apos;Subscription Notifications&apos;)
)
SELECT DISTINCT
    si.name as site_name,
    p.name as project_name,
    COALESCE(b.title, su.subject) as obj_name,
    b.task_id,
    b.job_type,
    b.job_status,
    b.job_trigger_type,
    b.job_notes,
    b.created_at + INTERVAL &apos;2 hour&apos; as created_at,
    b.started_at + INTERVAL &apos;2 hour&apos; as started_at,
    b.completed_at + INTERVAL &apos;2 hour&apos; as completed_at,
    b.mins_to_complete,
    b.days_to_complete,
    b.mins_waiting,
    COALESCE(b.task_priority, hs.priority) as task_priority,
    CASE WHEN b.job_trigger_type = &apos;Manual&apos; THEN &apos;Manual&apos; ELSE COALESCE(b.schedule_name, hs.name, &apos;Unknown&apos;) END as schedule_name,
    CASE WHEN b.job_trigger_type = &apos;Manual&apos; THEN &apos;Manual&apos; ELSE COALESCE(b.schedule_type, hs.schedule_type, &apos;Unknown&apos;) END as schedule_type
FROM background_tasks b
LEFT JOIN datasources d on b.datasource_id = d.id
LEFT JOIN workbooks w on b.workbook_id = w.id
LEFT JOIN subscriptions su on b.subscription_id = su.id 
LEFT JOIN subscriptions_views sv on sv.subscription_id = su.id
LEFT JOIN subscriptions_workbooks sw on sw.subscription_id = su.id
LEFT JOIN views v on v.repository_url = sv.repository_url 
LEFT JOIN workbooks ws on ws.id = v.workbook_id OR ws.repository_url = sw.repository_url
LEFT JOIN sites si on si.id = COALESCE(b.site_id, v.site_id, sw.site_id)
LEFT JOIN projects p on p.id = COALESCE(d.project_id, w.project_id, ws.project_id, b.project_id)
LEFT JOIN hist_subscription_tasks hs on hs.created_at = DATE_TRUNC(&apos;minute&apos;, b.completed_at) AND ws.id = hs.workbook_id</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
