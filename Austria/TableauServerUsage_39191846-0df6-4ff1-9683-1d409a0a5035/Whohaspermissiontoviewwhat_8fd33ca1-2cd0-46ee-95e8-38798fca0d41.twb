      <object-graph>
        <objects>
          <object caption='Migrated Data' id='Migrated Data'>
            <properties context=''>
              <relation connection='postgres.1qlnubl04eciqc17t7vma0vfrz56' name='Custom SQL Query' type='text'>WITH project_hierarchy AS&#10;(    &#10;    SELECT &#10;        p3.id as project_id,&#10;        p0.name as project_name,&#10;        p0.name || &#10;            CASE WHEN p1.name IS NOT NULL THEN &apos;: &apos; || p1.name ELSE &apos;&apos; END ||&#10;            CASE WHEN p2.name IS NOT NULL THEN &apos;: &apos; || p2.name ELSE &apos;&apos; END ||&#10;            CASE WHEN p3.name IS NOT NULL THEN &apos;: &apos; || p3.name ELSE &apos;&apos; END as project_name_detail&#10;    FROM projects p0&#10;    JOIN projects p1 on p1.parent_project_id = p0.id&#10;    JOIN projects p2 on p2.parent_project_id = p1.id&#10;    JOIN projects p3 on p3.parent_project_id = p2.id&#10;    WHERE p0.parent_project_id IS NULL&#10;&#9;UNION&#10;&#9;SELECT &#10;        p2.id as project_id,&#10;        p0.name as project_name,&#10;        p0.name || &#10;            CASE WHEN p1.name IS NOT NULL THEN &apos;: &apos; || p1.name ELSE &apos;&apos; END ||&#10;            CASE WHEN p2.name IS NOT NULL THEN &apos;: &apos; || p2.name ELSE &apos;&apos; END as project_name_detail&#10;    FROM projects p0&#10;    JOIN projects p1 on p1.parent_project_id = p0.id&#10;    JOIN projects p2 on p2.parent_project_id = p1.id&#10;    WHERE p0.parent_project_id IS NULL&#10;    UNION&#10;    SELECT &#10;        p1.id as project_id,&#10;        p0.name as project_name,&#10;        p0.name || &#10;            CASE WHEN p1.name IS NOT NULL THEN &apos;: &apos; || p1.name ELSE &apos;&apos; END as project_name_detail&#10;    FROM projects p0&#10;    JOIN projects p1 on p1.parent_project_id = p0.id&#10;    WHERE p0.parent_project_id IS NULL&#10;    UNION&#10;    SELECT &#10;        id as project_id,&#10;        name as project_name,&#10;        name as project_name_detail&#10;    FROM projects p &#10;    WHERE p.parent_project_id IS NULL&#10;)&#10;SELECT &#10;&#9;su.name as user_name,&#10;&#9;su.friendly_name as user_display_name,&#10;&#9;su.email as user_email,&#10;&#9;SPLIT_PART(su.email, &apos;@&apos;, 2) as email_domain,&#10;&#9;s.name as site_name,&#10;&#9;g.name as group_name,&#10;&#9;h.project_name,&#10;&#9;h.project_name_detail,&#10;&#9;pr.reason as permission_reason,&#10;&#9;CASE &#10;        WHEN su.admin_level = 10 THEN &apos;Server Administrator&apos;&#10;        --WHEN u.admin_level = 5 THEN &apos;Site Administrator&apos;&#10;        --WHEN u.publisher_tristate &gt;&gt; 0 THEN &apos;Publisher&apos;&#10;        --WHEN u.publisher_tristate = 0 THEN l.name&#10;        ELSE l.name&#10;    END as site_role,&#10;    u.login_at as last_login_at&#10;FROM users u&#10;--LEFT JOIN _users uu on uu.id = u.id &#10;JOIN system_users su on su.id = u.system_user_id&#10;JOIN group_users gu on u.id = gu.user_id&#10;JOIN groups g on gu.group_id = g.id&#10;JOIN sites s on s.id = u.site_id&#10;JOIN permissions_templates pt on pt.grantee_id = g.id AND pt.grantee_type = &apos;Group&apos;&#10;LEFT JOIN permission_reasons pr on pr.precedence = pt.permission&#10;LEFT JOIN site_roles l on l.id = u.site_role_id&#10;JOIN projects p on p.id = pt.container_id AND pt.container_type = &apos;Project&apos;&#10;JOIN project_hierarchy h on h.project_id = p.id &#10;--LEFT JOIN licensing_roles l on l.id = u.licensing_role_id&#10;WHERE TRUE&#10;AND pt.capability_id = 1 -- &apos;read&apos;&#10;AND pt.template_type = &apos;Workbook&apos; -- Not interested in Data Sources&#10;AND pt.permission NOT IN (2, 4) -- Not disallowed&#10;AND l.name != &apos;Unlicensed&apos;</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </object-graph>
    </datasource>
