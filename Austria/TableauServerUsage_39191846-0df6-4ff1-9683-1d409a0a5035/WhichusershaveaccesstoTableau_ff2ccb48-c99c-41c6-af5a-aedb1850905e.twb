      <object-graph>
        <objects>
          <object caption='Migrated Data' id='Migrated Data'>
            <properties context=''>
              <relation connection='postgres.42047.368827094906leaf' name='Custom SQL Query' type='text'>SELECT &#10;&#9;su.id as user_id, &#10;&#9;su.name as user_name,&#10;&#9;su.email as user_email,&#10;&#9;SPLIT_PART(su.email, &apos;@&apos;, 2) as email_domain,&#10;&#9;su.friendly_name as display_name,&#10;&#9;s.name as site_name,&#10;&#9;su.created_at user_created_at,&#10;&#9;u.created_at site_access_created_at,&#10;&#9;u.login_at site_login_at,&#10;&#9;CASE &#10;&#9;&#9;WHEN su.admin_level = 10 THEN &apos;Server Administrator&apos;&#10;&#9;&#9;WHEN l.name = &apos;SiteAdministrator&apos; THEN &apos;Site Administrator&apos;&#10;&#9;&#9;WHEN l.name = &apos;Publisher&apos; THEN &apos;Explorer (can publish&apos;&#10;&#9;&#9;WHEN l.name = &apos;Interactor&apos; THEN &apos;Explorer&apos;&#10;&#9;&#9;WHEN l.name = &apos;BasicUser&apos; THEN &apos;Viewer&apos;&#10;&#9;&#9;ELSE l.name&#10;&#9;END as site_role&#10;FROM users u &#10;LEFT JOIN system_users su on su.id = u.system_user_id&#10;LEFT JOIN sites s on s.id = u.site_id&#10;LEFT JOIN site_roles l on l.id = u.site_role_id</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </object-graph>
