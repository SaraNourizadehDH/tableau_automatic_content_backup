        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='postgres.0fybspf0lf4s9n1cgzajs19644h8' name='Custom SQL Query' type='text'>WITH project_hierarchy AS
(    
    SELECT 
        COALESCE(p3.id, p2.id, p1.id, p0.id) as project_id,
        p0.name || 
            CASE WHEN p1.name IS NOT NULL THEN &apos;: &apos; || p1.name ELSE &apos;&apos; END ||
            CASE WHEN p2.name IS NOT NULL THEN &apos;: &apos; || p2.name ELSE &apos;&apos; END ||
            CASE WHEN p3.name IS NOT NULL THEN &apos;: &apos; || p3.name ELSE &apos;&apos; END as project_name
    FROM projects p0
    JOIN projects p1 on p1.parent_project_id = p0.id
    JOIN projects p2 on p2.parent_project_id = p1.id
    JOIN projects p3 on p3.parent_project_id = p2.id
    WHERE p0.parent_project_id IS NULL
    UNION
    SELECT 
        COALESCE(p2.id, p1.id, p0.id) as project_id,
        p0.name || 
            CASE WHEN p1.name IS NOT NULL THEN &apos;: &apos; || p1.name ELSE &apos;&apos; END ||
            CASE WHEN p2.name IS NOT NULL THEN &apos;: &apos; || p2.name ELSE &apos;&apos; END as project_name
    FROM projects p0
    JOIN projects p1 on p1.parent_project_id = p0.id
    JOIN projects p2 on p2.parent_project_id = p1.id
    WHERE p0.parent_project_id IS NULL
    UNION
    SELECT 
        COALESCE(p1.id, p0.id) as project_id,
        p0.name || 
            CASE WHEN p1.name IS NOT NULL THEN &apos;: &apos; || p1.name ELSE &apos;&apos; END as project_name
    FROM projects p0
    JOIN projects p1 on p1.parent_project_id = p0.id
    WHERE p0.parent_project_id IS NULL
    UNION
    SELECT 
        id as project_id,
        name as project_name
    FROM projects p 
    WHERE p.parent_project_id IS NULL
),

view_stats AS 
(
    SELECT 
        v.workbook_id,
        MAX(vs.time) as workbook_last_viewed_at,
        SUM(vs.nviews) as workbook_num_views,
        SUM(CASE WHEN vs.time &gt;&gt; CURRENT_DATE-7 THEN vs.nviews ELSE NULL END) as workbook_num_views_l7d,
        COUNT(DISTINCT CASE WHEN vs.time &gt;&gt; CURRENT_DATE-7 THEN vs.user_id ELSE NULL END) as workbook_distinct_users_l7d
    FROM views_stats vs
    JOIN views v on v.id = vs.view_id
    GROUP BY 1
)
--external connections
--https://tableau.deliveryhero.net/#/site/Germany/datasources/15768/connections  zip polulation

SELECT 
    CASE WHEN dc.owner_type = &apos;Workbook&apos; THEN &apos;Embedded&apos; ELSE &apos;Published DS&apos; END as data_connection_type,  
    CASE WHEN dc.owner_type = &apos;Workbook&apos; THEN 2 ELSE 0 END as data_connection_state,  -- 2=embedded, 0=published
    dc.id as data_connection_id,
    CASE 
    	WHEN dc.owner_type = &apos;Workbook&apos; THEN &apos;https://tableau.deliveryhero.net/#/site/&apos;||s.url_namespace||&apos;/workbooks/&apos;||w.id||&apos;/datasources&apos; 
		ELSE&apos;https://tableau.deliveryhero.net/#/site/&apos;||s.url_namespace||&apos;/datasources/&apos;||dc.id||&apos;/connections&apos; 
	END as data_connection_url,
    dc.server as db_server,
    dc.dbclass as db_class,
    dc.port as db_port,
    dc.username as db_username,
    dc.dbname as db_name,
    dc.has_extract,
    s.name as site_name,
    d.id as data_source_id,
    d.name as data_source_name,
    COALESCE(d.size, w.size) as data_source_size,
    ds.last_access_time as data_source_last_access,
    COALESCE(GREATEST(d.extracts_refreshed_at, d.updated_at, d.extracts_incremented_at, d.last_published_at), GREATEST(w.extracts_refreshed_at, w.updated_at, w.extracts_incremented_at, w.last_published_at)) as extracts_refreshed_at,
    COALESCE(p.project_name, pd.project_name) as project_name,
    w.id as workbook_id,
    &apos;https://tableau.deliveryhero.net/#/site/&apos;||s.url_namespace||&apos;/workbooks/&apos;||w.id||&apos;/views&apos; as workbook_url,
    w.name as workbook_name,
    w.size as workbook_size,
    vs.workbook_last_viewed_at,
    vs.workbook_num_views,
    vs.workbook_num_views_l7d,
    vs.workbook_distinct_users_l7d,
    su.friendly_name as workbook_owner,
    su.email as workbook_owner_email
FROM data_connections dc
JOIN sites s on s.id = dc.site_id
JOIN datasources d on dc.datasource_id = d.id
LEFT JOIN workbooks w on d.parent_workbook_id = w.id 
LEFT JOIN view_stats vs on vs.workbook_id = w.id
LEFT JOIN _datasources_stats ds on ds.datasource_id = d.id
LEFT JOIN project_hierarchy p on p.project_id = w.project_id
LEFT JOIN project_hierarchy pd on pd.project_id = d.project_id
LEFT JOIN users u on u.id = w.owner_id
LEFT JOIN system_users su on su.id = u.system_user_id
WHERE (dc.server NOT IN (&apos;tableau.deliveryhero.net&apos;, &apos;tableau.deliveryhero.com&apos;) 
OR dc.server IS NULL)

--internal connections
UNION
SELECT
    &apos;Connection to DS&apos; as data_connection_type,  
    CASE WHEN d.id is NULL THEN -1 ELSE 1 END as data_connection_state, -- 1=connection to DS, -1=broken connection to DS (DS doesn&apos;t exist)
    dc.id as data_connection_id,
    &apos;https://tableau.deliveryhero.net/#/site/&apos;||s.url_namespace||&apos;/datasources/&apos;||dc.id||&apos;/connections&apos; as data_connection_url,
    dc.server as db_server,
    dc.dbclass as db_class,
    dc.port as db_port,
    dc.username as db_username,
    dc.dbname as db_name,
    dc.has_extract,
    s.name as site_name,
    d.id as data_source_id,
    COALESCE(d.name, di.name) as data_source_name,
    COALESCE(d.size, w.size) as data_source_size,
    ds.last_access_time as data_source_last_access,
    COALESCE(GREATEST(d.extracts_refreshed_at, d.updated_at, d.extracts_incremented_at, d.last_published_at), GREATEST(w.extracts_refreshed_at, w.updated_at, w.extracts_incremented_at, w.last_published_at)) as extracts_refreshed_at,
    COALESCE(p.project_name, pd.project_name) as project_name,
    w.id as workbook_id,
    &apos;https://tableau.deliveryhero.net/#/site/&apos;||s.url_namespace||&apos;/workbooks/&apos;||w.id||&apos;/views&apos; as workbook_url,
    w.name as workbook_name,
    w.size as workbook_size,
    vs.workbook_last_viewed_at,
    vs.workbook_num_views,
    vs.workbook_num_views_l7d,
    vs.workbook_distinct_users_l7d,
    su.friendly_name as workbook_owner,
    su.email as workbook_owner_email
FROM data_connections dci
JOIN datasources di on dci.datasource_id = di.id
JOIN sites s on s.id = dci.site_id
LEFT JOIN datasources d on dci.dbname = d.repository_url
LEFT JOIN data_connections dc on dc.datasource_id = d.id
LEFT JOIN workbooks w on di.parent_workbook_id = w.id
LEFT JOIN view_stats vs on vs.workbook_id = w.id 
LEFT JOIN _datasources_stats ds on ds.datasource_id = d.id
LEFT JOIN project_hierarchy p on p.project_id = w.project_id
LEFT JOIN project_hierarchy pd on pd.project_id = d.project_id
LEFT JOIN users u on u.id = w.owner_id
LEFT JOIN system_users su on su.id = u.system_user_id
WHERE dci.server IN (&apos;tableau.deliveryhero.net&apos;, &apos;tableau.deliveryhero.com&apos;)</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='postgres.0fybspf0lf4s9n1cgzajs19644h8' name='Custom SQL Query' type='text'>WITH project_hierarchy AS
(    
    SELECT 
        COALESCE(p3.id, p2.id, p1.id, p0.id) as project_id,
        p0.name || 
            CASE WHEN p1.name IS NOT NULL THEN &apos;: &apos; || p1.name ELSE &apos;&apos; END ||
            CASE WHEN p2.name IS NOT NULL THEN &apos;: &apos; || p2.name ELSE &apos;&apos; END ||
            CASE WHEN p3.name IS NOT NULL THEN &apos;: &apos; || p3.name ELSE &apos;&apos; END as project_name
    FROM projects p0
    JOIN projects p1 on p1.parent_project_id = p0.id
    JOIN projects p2 on p2.parent_project_id = p1.id
    JOIN projects p3 on p3.parent_project_id = p2.id
    WHERE p0.parent_project_id IS NULL
    UNION
    SELECT 
        COALESCE(p2.id, p1.id, p0.id) as project_id,
        p0.name || 
            CASE WHEN p1.name IS NOT NULL THEN &apos;: &apos; || p1.name ELSE &apos;&apos; END ||
            CASE WHEN p2.name IS NOT NULL THEN &apos;: &apos; || p2.name ELSE &apos;&apos; END as project_name
    FROM projects p0
    JOIN projects p1 on p1.parent_project_id = p0.id
    JOIN projects p2 on p2.parent_project_id = p1.id
    WHERE p0.parent_project_id IS NULL
    UNION
    SELECT 
        COALESCE(p1.id, p0.id) as project_id,
        p0.name || 
            CASE WHEN p1.name IS NOT NULL THEN &apos;: &apos; || p1.name ELSE &apos;&apos; END as project_name
    FROM projects p0
    JOIN projects p1 on p1.parent_project_id = p0.id
    WHERE p0.parent_project_id IS NULL
    UNION
    SELECT 
        id as project_id,
        name as project_name
    FROM projects p 
    WHERE p.parent_project_id IS NULL
),

view_stats AS 
(
    SELECT 
        v.workbook_id,
        MAX(vs.time) as workbook_last_viewed_at,
        SUM(vs.nviews) as workbook_num_views,
        SUM(CASE WHEN vs.time &gt;&gt; CURRENT_DATE-7 THEN vs.nviews ELSE NULL END) as workbook_num_views_l7d,
