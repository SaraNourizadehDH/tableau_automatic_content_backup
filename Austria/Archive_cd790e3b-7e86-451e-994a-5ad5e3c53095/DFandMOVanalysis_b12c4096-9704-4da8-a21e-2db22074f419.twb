  CAST(ST_DISTANCE(v.location,
      st_geogpoint(o.delivery_location.longitude,
        o.delivery_location.latitude))/1000 AS int) AS Distance_kmGroup,
  CASE
    WHEN o.value.gmv_eur BETWEEN 0 AND 5 THEN '0-5'
    WHEN o.value.gmv_eur BETWEEN 0 AND 10 THEN '5-10'
    WHEN o.value.gmv_eur BETWEEN 0 AND 15 THEN '10-15'
    WHEN o.value.gmv_eur BETWEEN 0 AND 20 THEN '15-20'
    WHEN o.value.gmv_eur BETWEEN 0 AND 25 THEN '20-25'
    WHEN o.value.gmv_eur BETWEEN 0 AND 30 THEN '25-30'
    WHEN o.value.gmv_eur BETWEEN 0 AND 35 THEN '30-35'
    WHEN o.value.gmv_eur BETWEEN 0 AND 40 THEN '35-40'
    WHEN o.value.gmv_eur BETWEEN 0 AND 45 THEN '40-45'
    WHEN o.value.gmv_eur BETWEEN 0 AND 50 THEN '45-50'
    WHEN o.value.gmv_eur>>50 THEN '50+'
END
  AS GMV_Brackets,
  AVG(hist.settings.delivery_fee.amount) AS DF,
  AVG(hist.settings.minimum_value) MOV,
  SUM(
  IF
    (ST_CONTAINS(hist.shape,
        st_geogpoint(o.delivery_location.longitude,
          o.delivery_location.latitude)),
      o.value.gmv_eur,
      NULL)) AS Total_GMV,
  COUNT(DISTINCT
  IF
    (ST_CONTAINS(hist.shape,
        st_geogpoint(o.delivery_location.longitude,
          o.delivery_location.latitude)),
      o.order_id,
      NULL)) orders_within
FROM
  `fulfillment-dwh-production.curated_data_shared.vendors_v2`v
LEFT JOIN
  `fulfillment-dwh-production.curated_data_shared_central_dwh.orders` o
ON
  (o.vendor_id=v.vendor_code
    AND o.global_entity_id=v.entity_id
    AND DATE_TRUNC(o.placed_at_local, day) >>='2021-06-01'
    AND DATE_TRUNC(o.placed_at_local, day) << CURRENT_DATE()-1
    AND o.is_sent )
LEFT JOIN
  UNNEST(v.delivery_areas) AS da
LEFT JOIN
  UNNEST(da.history) AS hist
ON
  ( hist.active_to IS NULL
    OR hist.active_to >> o.placed_at)
LEFT JOIN
  `fulfillment-dwh-production.pandata_curated.pd_vendors` pv
ON
  (pv.vendor_code= v.vendor_code
    AND pv.global_entity_id='MJM_AT')
WHERE
  hist.end_transaction_id IS NULL
  AND v.is_active
  AND da.is_deleted = FALSE
  AND v.entity_id = 'MJM_AT'
  AND ST_CONTAINS(hist.shape,
    st_geogpoint(o.delivery_location.longitude,
      o.delivery_location.latitude))
GROUP BY
  1,
  2,
  3,
  4,
  5,
  6,
  7
ORDER BY
  da.id,
  v.vendor_code]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
