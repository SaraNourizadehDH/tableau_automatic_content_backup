    <worksheet name='WS_Table'>
      <table>
        <view>
          <datasources>
            <datasource caption='Logistics_Vendor_Performance_Master (report_tables)' name='federated.0cs9nek1g1k5vg16yr4ax01u8x4b' />
          </datasources>
          <datasource-dependencies datasource='federated.0cs9nek1g1k5vg16yr4ax01u8x4b'>
            <column caption='Account owner' datatype='string' name='[Account_owner]' role='dimension' type='nominal' />
            <column caption='Act delivery time' datatype='real' name='[Act_delivery_time]' role='measure' type='quantitative' />
            <column caption='Completed' datatype='integer' name='[Calculation_4879368729891405831]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Order_status] = &quot;completed&quot; THEN 1 ELSE 0 END' />
            </column>
            <column caption='Failed' datatype='integer' name='[Calculation_4879368729895968776]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Order_status] = &quot;cancelled&quot; THEN 1 ELSE 0 END' />
            </column>
            <column caption='# Prep Time Difference &gt; 3min' datatype='integer' name='[Calculation_4879368729901023242]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Prep_time_difference] &gt; 3 THEN 1 ELSE 0 END' />
            </column>
            <column caption='% Prep Time Difference &gt; 3min!' datatype='real' name='[Calculation_4879368729901342731]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_4879368729901023242]) / COUNT([Prep_time_difference])' />
            </column>
            <column caption='% Failed Orders' datatype='real' name='[Calculation_4879368729944739853]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_4879368729895968776]) / COUNT([Order_status])' />
            </column>
            <column caption='% Saver Orders' datatype='real' name='[Calculation_4879368729950208014]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_saver_fee] = TRUE THEN 1 ELSE 0 END) / COUNT([Calculation_4879368729891405831])' />
            </column>
            <column caption='% Rider Late &gt; 5min' datatype='real' name='[Calculation_4879368730106155025]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([is_rider_late_5]) / SUM(IF [Order_status] = &quot;completed&quot; THEN 1 ELSE 0 END)' />
            </column>
            <column caption='% Vendor Late &gt; 5min' datatype='real' name='[Calculation_4879368730106552338]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([is_vendor_late_5]) / SUM(IF [Order_status] = &quot;completed&quot; THEN 1 ELSE 0 END)' />
            </column>
            <column caption='% Vendor Late &gt; 10min' datatype='real' name='[Calculation_4879368730106822675]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([is_vendor_late_10]) / SUM(IF [Order_status] = &quot;completed&quot; THEN 1 ELSE 0 END)' />
            </column>
            <column caption='% Rider Late &gt; 10min' datatype='real' name='[Calculation_4879368730107080724]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([is_rider_late_10]) / SUM(IF [Order_status] = &quot;completed&quot; THEN 1 ELSE 0 END)' />
            </column>
            <column caption='% Seamless Orders' datatype='real' name='[Calculation_4879368730107445269]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([is_seamless]) / COUNT([Order_status])' />
            </column>
            <column caption='% Pro Orders' datatype='real' name='[Calculation_4879368730226360344]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_pro_order] = TRUE THEN 1 ELSE 0 END) / COUNT([Calculation_4879368729891405831])' />
            </column>
