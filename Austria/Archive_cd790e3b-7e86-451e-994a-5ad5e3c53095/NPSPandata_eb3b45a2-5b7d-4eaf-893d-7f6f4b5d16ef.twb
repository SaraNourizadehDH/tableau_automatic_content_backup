FROM `fulfillment-dwh-production.curated_data_shared_cx.nps_after_order_all_survey_responses` AS nps_new_after_order_survey_responses&#13;
where nps_new_after_order_survey_responses.global_entity_id = &apos;MJM_AT&apos;&#13;
