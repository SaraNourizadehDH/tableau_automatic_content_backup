            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dha---bi-485' REDIRECT_URI='urn:ietf:wg:oauth:2.0:oob' SCOPE='email profile https://www.googleapis.com/auth/bigquery https://www.googleapis.com/auth/cloudplatformprojects.readonly' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='pandata_curated' server='' server-oauth='' username='sirinthip.narula@deliveryhero.at' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0yx9n4a0dlhv3e1bp4f461v6yz09' name='Custom SQL Query' type='text'>SELECT&#13;
  nps_new_after_order_survey_responses.global_entity_id,&#13;
  nps_new_after_order_survey_responses.order_id,&#13;
  survey_id,&#13;
  recorded_at_utc AS survey_date,&#13;
  pd_orders.created_date_utc AS order_day,&#13;
  pd_orders.code,&#13;
  nps_score AS nps,&#13;
  CASE&#13;
    WHEN nps_group = &quot;Detractor&quot; THEN TRUE&#13;
  ELSE&#13;
  FALSE&#13;
END&#13;
  AS is_detractor,&#13;
  CASE&#13;
    WHEN nps_group = &quot;Passive&quot; THEN TRUE&#13;
  ELSE&#13;
  FALSE&#13;
END&#13;
  AS is_passive,&#13;
  CASE&#13;
    WHEN nps_group = &quot;Promoter&quot; THEN TRUE&#13;
  ELSE&#13;
  FALSE&#13;
END&#13;
  AS is_promoter,&#13;
  nps_reason AS reason,&#13;
  is_valid_order AS is_sent,&#13;
  pd_orders.pd_vendor_uuid,&#13;
  pd_orders.pd_customer_uuid,&#13;
  dwho.analytical_customer_id,&#13;
  pd_orders.delivery_address_city AS order_delivery_address_city,&#13;
  pd_vendors.name AS vendor_name,&#13;
  pd_vendors.chain_name,&#13;
  pd_vendors.is_active,&#13;
  pd_vendors.is_key_account,&#13;
  IF&#13;
    (cust.analytical_customer_id IS NOT NULL,&#13;
      TRUE,&#13;
      FALSE) is_acquisition,&#13;
  CASE&#13;
    WHEN (pd_vendors.has_delivery_type_vendor_delivery AND (pd_vendors.has_delivery_type_partner_delivery OR pd_vendors.has_delivery_type_platform_delivery )) THEN &quot;Both MP &amp; OD&quot;&#13;
    WHEN pd_vendors.has_delivery_type_partner_delivery THEN &quot;OD : Partner Delivery&quot;&#13;
    WHEN pd_vendors.has_delivery_type_platform_delivery THEN &quot;OD : Platform Delivery&quot;&#13;
    WHEN pd_vendors.has_delivery_type_vendor_delivery THEN &quot;MP&quot;&#13;
END&#13;
  AS restaurant_group,&#13;
  pd_orders_agg_accounting.gmv_eur AS gmv_eur,&#13;
  pd_orders_agg_accounting.gfv_eur AS gfv_eur,&#13;
  pd_orders_agg_vouchers.pd_voucher_uuid AS is_voucher_used,&#13;
  pd_orders.delivery_time_in_minutes - pd_orders.promised_delivery_time_in_minutes &gt;&gt; 10 AS is_delayed_more_than_10_mins,&#13;
FROM&#13;
  `fulfillment-dwh-production.curated_data_shared_cx.nps_after_order_all_survey_responses` AS nps_new_after_order_survey_responses&#13;
JOIN&#13;
  `fulfillment-dwh-production.pandata_curated.pd_orders` pd_orders&#13;
ON&#13;
  pd_orders.code = nps_new_after_order_survey_responses.order_id&#13;
  AND pd_orders.global_entity_id = nps_new_after_order_survey_responses.global_entity_id&#13;
  AND pd_orders.created_date_utc &gt;&gt;&apos;2021-05-01&apos;&#13;
LEFT JOIN&#13;
  `fulfillment-dwh-production.pandata_report.regional_eu__pd_orders_agg_accounting` AS pd_orders_agg_accounting&#13;
ON&#13;
  pd_orders_agg_accounting.uuid = pd_orders.uuid&#13;
  AND pd_orders_agg_accounting.created_date_utc &gt;&gt;= DATE_SUB(CURRENT_DATE, INTERVAL 6 MONTH)&#13;
  LEFT JOIN&#13;
    `fulfillment-dwh-production.curated_data_shared_central_dwh.orders` dwho&#13;
  ON&#13;
    dwho.order_id = pd_orders.code&#13;
    AND dwho.placed_at_local&gt;&gt;=DATE_SUB(CURRENT_DATE, INTERVAL 6 MONTH)&#13;
LEFT JOIN&#13;
    `fulfillment-dwh-production.curated_data_shared_central_dwh.agg_customers` cust&#13;
  ON&#13;
    cust.first_order_id = pd_orders.code&#13;
LEFT JOIN&#13;
  `fulfillment-dwh-production.pandata_report.regional_eu__pd_orders_agg_vouchers` AS pd_orders_agg_vouchers&#13;
ON&#13;
  pd_orders_agg_vouchers.uuid = pd_orders.uuid&#13;
  AND pd_orders_agg_vouchers.created_date_utc &gt;&gt;= DATE_SUB(CURRENT_DATE, INTERVAL 6 MONTH)&#13;
LEFT JOIN&#13;
  `fulfillment-dwh-production.pandata_curated.pd_vendors` AS pd_vendors&#13;
ON&#13;
  pd_vendors.uuid = pd_orders.pd_vendor_uuid&#13;
&#13;
WHERE&#13;
  nps_new_after_order_survey_responses.global_entity_id = &apos;MJM_AT&apos;&#13;
  AND nps_new_after_order_survey_responses.created_date &gt;&gt;&apos;2021-05-31&apos;</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
