      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_33A52C347D124FCCBBAAF0BB6F79C80E'>
            <properties context=''>
              <relation connection='bigquery.0u1rg860hwr2g012omdr200ilams' name='Custom SQL Query' type='text'>SELECT &#13;
date_trunc(nps_new_after_order_survey_responses.created_date, month ) as survey_month,COUNT(CASE when nps_group = &quot;Detractor&quot; then 1 END) as detractors,COUNT(CASE when nps_group = &quot;Passive&quot; then 1 END) as passives, COUNT(CASE when nps_group = &quot;Promoter&quot; then 1 END ) as promoters, COUNT( order_id ) as total_surveys&#13;
FROM `fulfillment-dwh-production.curated_data_shared_cx.nps_after_order_all_survey_responses` AS nps_new_after_order_survey_responses&#13;
where nps_new_after_order_survey_responses.global_entity_id = &apos;MJM_AT&apos;&#13;
  AND nps_new_after_order_survey_responses.created_date &gt;&gt;&apos;2021-05-31&apos;&#13;
GROUP BY 1</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
