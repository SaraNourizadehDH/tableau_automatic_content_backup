          <named-connection caption='BigQuery' name='bigquery.136hub613hq4tl16d40ob1v26tf5'>
            <connection CATALOG='bmj---mjam' EXECCATALOG='dha---bi-485' authentication='yes' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='BMJ - Mjam' schema='104059036' server-oauth='' username='serkan.koyak@deliveryhero.at' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.136hub613hq4tl16d40ob1v26tf5' name='Custom SQL Query' type='text'>WITH
  dates AS (
  SELECT
    d.date
  FROM
    `fulfillment-dwh-production.pandata_curated.shared_dates` d
  WHERE
    d.date BETWEEN DATE_SUB(date_trunc(current_date,month), INTERVAL 3 month)
    AND current_date),
  pd_vendors AS (
  SELECT
    pd_vendors.uuid,
    pd_vendors.location.city,
    d.postal_code AS vendor_post_code,
    pd_vendors.name,
    pd_vendors.vendor_code,
    MAX(
    IF
      (has_delivery_type_vendor_delivery,
        &apos;MP&apos;,
        &apos;OD&apos;)) delivery_type,
    MAX(
    IF
      (LOWER(food_characteristics.title) LIKE &apos;%deal%&apos;,
        TRUE,
        FALSE)) has_deal,
    MAX(
    IF
      (LOWER(food_characteristics.title) LIKE &apos;%münzen%&apos;,
        TRUE,
        FALSE)) has_munzen,
    MAX(
    IF
      (LOWER(food_characteristics.title) LIKE &apos;%lunch%&apos;,
        TRUE,
        FALSE)) has_lunch
  FROM
    `fulfillment-dwh-production.pandata_curated.pd_vendors` pd_vendors
  LEFT JOIN
    UNNEST(discounts) AS discounts
  LEFT JOIN
    UNNEST(food_characteristics) AS food_characteristics
  LEFT JOIN
    `fulfillment-dwh-production.pandata_curated.sf_accounts` AS sf_accounts
  ON
    sf_accounts.vendor_uuid = pd_vendors.uuid,
    UNNEST(addresses) AS d
  WHERE
    pd_vendors.global_entity_id=&apos;MJM_AT&apos;
    AND pd_vendors.is_active
    AND NOT pd_vendors.is_test
    AND d.is_type_restaurant_address
  GROUP BY
    1,
    2,
    3,
    4,
    5 ),
  discounts AS (
  SELECT
    pd_vendors.vendor_code,
    discounts.pd_discount_uuid,
    discounts.discount_type,
    discounts.title,
    discounts.start_date_local,
    discounts.end_date_local,
    AVG(discounts.amount_local) amount_local
  FROM
    `fulfillment-dwh-production.pandata_curated.pd_vendors` pd_vendors
  LEFT JOIN
    UNNEST(discounts) AS discounts
  LEFT JOIN
    UNNEST(food_characteristics) AS food_characteristics
  WHERE
    pd_vendors.global_entity_id=&apos;MJM_AT&apos;
    AND pd_vendors.is_active
    AND NOT pd_vendors.is_test
    AND discounts.is_active
  GROUP BY
    1,
    2,
    3,
    4,
    5,
    6 )
SELECT
  dates.date,
  pd_vendors.name,
  pd_vendors.vendor_code,
  pd_vendors.city,
  pd_vendors.vendor_post_code,
  delivery_type,
  has_deal,
  has_munzen,
  has_lunch,
  COUNT(
  IF
    (dis.discount_type = &apos;amount&apos;,
      dis.pd_discount_uuid,
      NULL)) amount_discounts_count,
  SUM(
  IF
    (dis.discount_type = &apos;amount&apos;,
      dis.amount_local,
      0)) amount_discounts_sum,
  COUNT(
  IF
    (dis.discount_type = &apos;percentage&apos;,
      dis.pd_discount_uuid,
      NULL)) percentage_discounts_count,
  SUM(
  IF
    (dis.discount_type = &apos;percentage&apos;,
      dis.amount_local,
      0)) percentage_discounts_sum,
  COUNT(
  IF
    (dis.discount_type = &apos;free-delivery&apos;,
      dis.pd_discount_uuid,
      NULL) ) freedelivery_discounts_count,
  COUNT(DISTINCT
  IF
    (pdo.is_valid_order,
      pdo.uuid,
      NULL)) successful_orders,
  COUNT(DISTINCT
  IF
    (pdo.is_valid_order
      AND dwh_orders.customer_vendor_rank = 1,
      pdo.uuid,
      NULL)) vendor_acquisitions
FROM
  pd_vendors
CROSS JOIN
  dates
LEFT JOIN
  discounts dis
ON
  dis.vendor_code=pd_vendors.vendor_code
  AND dates.date BETWEEN dis.start_date_local
  AND dis.end_date_local
LEFT JOIN
  `fulfillment-dwh-production.pandata_curated.pd_orders` pdo
LEFT JOIN
  `fulfillment-dwh-production.curated_data_shared_central_dwh.orders` dwh_orders
ON
  dwh_orders.order_id=pdo.code
  AND dwh_orders.global_entity_id=pdo.global_entity_id
  AND dwh_orders.placed_at_local &gt;&gt;= DATE_SUB(current_date, INTERVAL 3 month)
ON
  pdo.pd_vendor_uuid=pd_vendors.uuid
  AND DATE_TRUNC(pdo.created_date_utc, month) &gt;&gt;= DATE_SUB(current_date, INTERVAL 3 month)
  AND dates.date=pdo.created_date_local
GROUP BY
  1,
  2,
  3,
  4,
  5,
  6,
  7,
  8,
  9
ORDER BY
  1</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
