            <parent-name>[Custom SQL Query]</parent-name>
            <remote-alias>discount_type</remote-alias>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <contains-null>true</contains-null>
            <_.fcp.ObjectModelEncapsulateLegacy.true...object-id>[_5FD0A4E8D327491F93C1BD8313E59ECE]</_.fcp.ObjectModelEncapsulateLegacy.true...object-id>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>discount_title</remote-name>
            <remote-type>130</remote-type>
            <local-name>[discount_title]</local-name>
            <parent-name>[Custom SQL Query]</parent-name>
            <remote-alias>discount_title</remote-alias>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <contains-null>true</contains-null>
            <_.fcp.ObjectModelEncapsulateLegacy.true...object-id>[_5FD0A4E8D327491F93C1BD8313E59ECE]</_.fcp.ObjectModelEncapsulateLegacy.true...object-id>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>discounts_active</remote-name>
            <remote-type>20</remote-type>
            <local-name>[discounts_active]</local-name>
            <parent-name>[Custom SQL Query]</parent-name>
            <remote-alias>discounts_active</remote-alias>
            <local-type>integer</local-type>
