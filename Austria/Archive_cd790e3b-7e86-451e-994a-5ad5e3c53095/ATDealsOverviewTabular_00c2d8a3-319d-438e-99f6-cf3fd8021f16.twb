  <datasources>
    <datasource caption='Custom SQL Query (pandata_curated)' inline='true' name='federated.12fkbze1nux58d15q2nc01bv4uk1' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0ja9gbu15j02n810qf1li0bjf1rn'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dha---bi-485' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='pandata_curated' server-oauth='' username='sirinthip.narula@deliveryhero.at' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0ja9gbu15j02n810qf1li0bjf1rn' name='Custom SQL Query' type='text'><![CDATA[WITH
  order_discount AS (
  SELECT
    DISTINCT pd_orders.code AS order_code,
    pd_orders.uuid AS order_uuid,
    pd_vendor_uuid,
    pd_orders.global_entity_id,
    pd_orders.created_date_utc AS created_date,
    DATE_TRUNC(pd_orders.created_date_utc, month) AS report_month,
    pd_orders_agg_discounts.discount_used AS discount_used,
    max (pd_orders_agg_discounts.discount_type) as discount_type,
    max (pd_orders_agg_discounts.discount_title) as discount_title,
    avg(discount_ratio) as discount_ratio,
    SUM(discount_value_local) as discount_value_local,
  FROM
    `fulfillment-dwh-production.pandata_curated.pd_orders` AS pd_orders
  LEFT JOIN
    `dha---bi-485.local_schedules.pd_order_discount_mmt_selected_dishes_v2` AS pd_orders_agg_discounts
  ON
    pd_orders_agg_discounts.order_code = pd_orders.code
    AND pd_orders_agg_discounts.created_date BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE-1,MONTH),INTERVAL 11 MONTH)
    AND CURRENT_DATE - 1
  LEFT JOIN
    `fulfillment-dwh-production.pandata_curated.pd_discounts` pd_discounts
  ON
    pd_discounts.uuid = pd_orders_agg_discounts.pd_discount_uuid
  WHERE
    pd_orders.created_date_utc BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE-1,MONTH),INTERVAL 11 MONTH)
    AND CURRENT_DATE - 1
    AND pd_orders.global_entity_id = 'MJM_AT'
    AND NOT is_test_order
    AND is_valid_order
  GROUP BY
    1,
    2,
    3,
    4,
    5,
    6,
    7
    ),
vendor_orders as (SELECT
  order_discount.global_entity_id,
  created_date,
  report_month,
  pd_vendors.vendor_code,
  discount_used,
  max(discount_type) as discount_type ,
  max(discount_title) as discount_title,
  COUNT(DISTINCT order_uuid) AS successful_orders,
  SUM(pd_orders_agg_accounting.gfv_eur) AS gfv_local,
  SUM(pd_orders_agg_accounting.gmv_eur) AS gmv_local,
  avg(discount_ratio) AS discount_ratio,
  SUM(discount_value_local) AS discount_value_local,
FROM
  order_discount
LEFT JOIN
  `fulfillment-dwh-production.pandata_curated.pd_vendors` AS pd_vendors
ON
  pd_vendors.uuid = order_discount.pd_vendor_uuid
LEFT JOIN
  `fulfillment-dwh-production.pandata_curated.pd_orders_agg_accounting` AS pd_orders_agg_accounting
ON
  pd_orders_agg_accounting.uuid = order_discount.order_uuid
  AND pd_orders_agg_accounting.created_date_utc BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE-1,MONTH),INTERVAL 11 MONTH)
  AND CURRENT_DATE - 1
GROUP BY
  1,2,3,4,5),

  discounts AS (
  SELECT
    global_entity_id,
    b.iso_date AS report_date,
    pd_discount_uuid,
    start_date_local,
    end_date_local,
    discount_type,
    discount_ratio,
    discount_title
  FROM
    `dha---bi-485.local_schedules.discount_mmt_selected_dishes` a,
    `fulfillment-dwh-production.curated_data_shared_central_dwh.dates` b
  WHERE
    global_entity_id = 'MJM_AT'
    AND start_date_local <<= b.iso_date
    AND end_date_local >>= b.iso_date
    AND b.iso_date BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE-1,MONTH),INTERVAL 11 MONTH)
    AND CURRENT_DATE - 1
  ORDER BY
    start_date_local,
    iso_date
    ),
  vendor_discounts AS (
  SELECT
    DISTINCT a.global_entity_id,
    d.pd_discount_uuid,
    b.iso_date AS report_date,
    a.vendor_code
  FROM
    `fulfillment-dwh-production.pandata_curated.pd_vendors` a
  LEFT JOIN
    UNNEST(discounts) d,
    `fulfillment-dwh-production.curated_data_shared_central_dwh.dates` b
  WHERE
    global_entity_id = 'MJM_AT'
    AND start_date_local <<= b.iso_date
    AND end_date_local >>= b.iso_date
    AND b.iso_date BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE-1,MONTH),INTERVAL 11 MONTH)
    AND CURRENT_DATE - 1 
UNION ALL
    SELECT
    DISTINCT a.global_entity_id,
    d.pd_discount_uuid,
    b.iso_date AS report_date,
    a.vendor_code
  FROM
    `fulfillment-dwh-production.pandata_curated.pd_vendors` a
  LEFT JOIN
    `dha---bi-485.local_schedules.discount_mmt_selected_dishes` d on left(d.pd_discount_uuid,4) = a.vendor_code,
    `fulfillment-dwh-production.curated_data_shared_central_dwh.dates` b
  WHERE
    a.global_entity_id = 'MJM_AT'
    AND start_date_local <<= b.iso_date
    AND end_date_local >>= b.iso_date
    AND b.iso_date BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE-1,MONTH),INTERVAL 11 MONTH)
    AND CURRENT_DATE - 1
    ),
  active_discounts AS (
  SELECT
    a.global_entity_id,
    DATE_TRUNC(a.report_date,MONTH) AS report_month,
    CAST(NULL AS STRING) AS vendor_code,
    a.discount_type,
    a.discount_title,
    COUNT(DISTINCT a.pd_discount_uuid) AS discounts_active,
    COUNT(DISTINCT b.vendor_code) AS discounts_active_vendor,
    COUNT(DISTINCT
      CASE
        WHEN discount_type ='free_delivery' THEN a.pd_discount_uuid
    END
      ) AS discounts_active_free_delivery,
    COUNT(DISTINCT
      CASE
        WHEN discount_type = 'percentage' THEN if(left(a.pd_discount_uuid,6)='MJM_AT',a.pd_discount_uuid,left(a.discount_title,3))
    END
      ) AS discounts_active_percentage,
    COUNT(DISTINCT
      CASE
        WHEN discount_type = 'free_gift' THEN a.pd_discount_uuid
    END
      ) AS discounts_active_free_gift,
    COUNT(DISTINCT
      CASE
        WHEN discount_type = 'amount' THEN a.pd_discount_uuid
    END
      ) AS discounts_active_amount,
    COUNT(DISTINCT
      CASE
        WHEN COALESCE(discount_type, '') NOT IN ('free_delivery', 'percentage', 'free_gift', 'amount') THEN a.pd_discount_uuid
    END
      ) AS discounts_active_other,
    CASE
      WHEN COUNT(DISTINCT b.vendor_code ) = 0 THEN 1
    ELSE
    0
  END
    AS discounts_active_no_vendor
  FROM
    discounts a
  LEFT JOIN
    `fulfillment-dwh-production.curated_data_shared_central_dwh.dates` AS d
  ON
    a.report_date = d.iso_date
  LEFT JOIN
    vendor_discounts b
  ON
    a.global_entity_id = b.global_entity_id
    AND a.report_date = b.report_date
    AND a.pd_discount_uuid = b.pd_discount_uuid
  GROUP BY
    1,
    2,
    3,
    4,
    5),
  active_discounts_vendor AS (
  SELECT
    a.global_entity_id,
    DATE_TRUNC(a.report_date,MONTH) AS report_month,
    b.vendor_code,
    a.discount_type,
    a.discount_title,
    COUNT(DISTINCT b.vendor_code) AS discounts_active_vendor,
    COUNT(DISTINCT
      CASE
        WHEN discount_type ='free_delivery' THEN b.vendor_code
    END
      ) AS discounts_active_free_delivery_vendor,
    COUNT(DISTINCT
      CASE
        WHEN discount_type = 'percentage' THEN b.vendor_code
    END
      ) AS discounts_active_percentage_vendor,
    COUNT(DISTINCT
      CASE
        WHEN discount_type = 'free_gift' THEN b.vendor_code
    END
      ) AS discounts_active_free_gift_vendor,
    COUNT(DISTINCT
      CASE
        WHEN discount_type = 'amount' THEN b.vendor_code
    END
      ) AS discounts_active_amount_vendor,
    COUNT(DISTINCT
      CASE
        WHEN COALESCE(discount_type, '') NOT IN ('free_delivery', 'percentage', 'free_gift', 'amount') THEN b.vendor_code
    END
      ) AS discounts_active_other_vendor
  FROM
    discounts a
  LEFT JOIN
    `fulfillment-dwh-production.curated_data_shared_central_dwh.dates` AS d
  ON
    a.report_date = d.iso_date
  INNER JOIN
    vendor_discounts b
  ON
    a.global_entity_id = b.global_entity_id
    AND a.report_date = b.report_date
    AND a.pd_discount_uuid = b.pd_discount_uuid
  GROUP BY
    1,
    2,
    3,
    4,
    5),
  discount_orders AS (
  SELECT
    a.global_entity_id,
    DATE_TRUNC(a.created_date,MONTH) AS report_month,
    a.vendor_code,
    a.discount_type,
    a.discount_title,
    SUM(a.successful_orders) AS discounts,
    SUM(a.gfv_local) AS discounts_gfv,
    SUM(a.gmv_local) AS discounts_gmv,
    SUM(CASE
        WHEN a.discount_ratio = 100 THEN a.successful_orders
    END
      ) AS discounts_dh,
    SUM(CASE
        WHEN a.discount_ratio = 0 THEN a.successful_orders
    END
      ) AS discounts_vendor,
    SUM(CASE
        WHEN a.discount_ratio >> 0 AND a.discount_ratio<<100 THEN a.successful_orders
    END
      ) AS discounts_mixed,
    SUM(a.discount_value_local) AS discounts_value,
    SUM(a.discount_value_local*(a.discount_ratio/100)) AS discounts_value_dh,
    SUM(a.discount_value_local*((100-a.discount_ratio)/100)) AS discounts_value_vendor
  FROM
    vendor_orders AS a
  WHERE
    a.created_date BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE-1,MONTH),INTERVAL 11 MONTH)-1
    AND CURRENT_DATE - 1
    AND a.global_entity_id = 'MJM_AT'
    AND a.successful_orders >> 0
    AND a.discount_used IS TRUE
  GROUP BY
    1,
    2,
    3,
    4,
    5 ),
  successful_orders AS (
  SELECT
    a.global_entity_id,
    DATE_TRUNC(a.created_date,MONTH) AS report_month,
    a.vendor_code,
    a.discount_used,
    CAST('Total' AS STRING) AS discount_type,
    CAST('Total' AS STRING) AS discount_title,
    SUM(a.successful_orders) AS orders,
    SUM(a.gfv_local) AS orders_gfv,
    SUM(a.gmv_local) AS orders_gmv
  FROM
    vendor_orders AS a
  WHERE
    a.global_entity_id = 'MJM_AT'
    AND a.successful_orders >> 0
  GROUP BY
    1,
    2,
    3,
    4),
  active_vendors AS (
  SELECT
    pd_vendors.global_entity_id,
    DATE_TRUNC(a.date_created,MONTH) AS report_month,
    a.vendor_code,
    CAST('Total' AS STRING) AS discount_type,
    CAST('Total' AS STRING)AS discount_title,
    COUNT(DISTINCT a.vendor_code) AS vendors_active
  FROM
    `dha---bi-485.local_schedules.pd_vendors_history` AS a
  LEFT JOIN
    `fulfillment-dwh-production.pandata_curated.pd_vendors` AS pd_vendors
  ON
    pd_vendors.vendor_code = a.vendor_code
  WHERE
    pd_vendors.global_entity_id = 'MJM_AT'
    AND a.date_created BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE-1,MONTH),INTERVAL 11 MONTH)
    AND CURRENT_DATE - 1
    AND a.is_active IS TRUE
  GROUP BY
    1,
    2,
    3,
    4,
    5 ),
  final AS (
  SELECT
    global_entity_id,
    report_month,
    vendor_code,
    discount_type,
    discount_title,
    CAST(discounts_active AS INT64) AS discounts_active,
    CAST(discounts_active_free_delivery AS INT64) AS discounts_active_free_delivery,
    CAST(discounts_active_percentage AS INT64) AS discounts_active_percentage,
    CAST(discounts_active_free_gift AS INT64) AS discounts_active_free_gift,
    CAST(discounts_active_amount AS INT64) AS discounts_active_amount,
    CAST(discounts_active_other AS INT64) AS discounts_active_other,
    CAST(discounts_active_no_vendor AS INT64) AS discounts_active_no_vendor,
    CAST(NULL AS INT64) AS discounts_active_vendor,
    CAST(NULL AS INT64) AS discounts_active_free_delivery_vendor,
    CAST(NULL AS INT64) AS discounts_active_percentage_vendor,
    CAST(NULL AS INT64) AS discounts_active_text_freegift_vendor,
    CAST(NULL AS INT64) AS discounts_active_amount_vendor,
    CAST(NULL AS INT64) AS discounts_active_other_vendor,
    CAST(NULL AS INT64) AS discounts,
    CAST(NULL AS FLOAT64) AS discounts_gfv,
    CAST(NULL AS FLOAT64) AS discounts_gmv,
    CAST(NULL AS INT64) AS discounts_dh,
    CAST(NULL AS INT64) AS discounts_vendor,
    CAST(NULL AS INT64) AS discounts_mixed,
    CAST(NULL AS FLOAT64) AS discounts_value,
    CAST(NULL AS FLOAT64) AS discounts_value_dh,
    CAST(NULL AS FLOAT64) AS discounts_value_vendor,
    CAST(NULL AS INT64) AS orders,
    CAST(NULL AS FLOAT64) AS orders_gfv,
    CAST(NULL AS FLOAT64) AS orders_gmv,
    CAST(NULL AS INT64) AS vendors_active
  FROM
    active_discounts
  UNION ALL
  SELECT
    global_entity_id,
    report_month,
    vendor_code,
    discount_type,
    discount_title,
    CAST(NULL AS INT64) AS discounts_active,
    CAST(NULL AS INT64) AS discounts_active_free_delivery,
    CAST(NULL AS INT64) AS discounts_active_percentage,
    CAST(NULL AS INT64) AS discounts_active_text_freegift,
    CAST(NULL AS INT64) AS discounts_active_amount,
    CAST(NULL AS INT64) AS discounts_active_other,
    CAST(NULL AS INT64) AS discounts_active_no_vendor,
    CAST(discounts_active_vendor AS INT64) AS discounts_active_vendor,
    CAST(discounts_active_free_delivery_vendor AS INT64) AS discounts_active_free_delivery_vendor,
    CAST(discounts_active_percentage_vendor AS INT64) AS discounts_active_percentage_vendor,
    CAST(discounts_active_free_gift_vendor AS INT64) AS discounts_active_free_gift_vendor,
    CAST(discounts_active_amount_vendor AS INT64) AS discounts_active_amount_vendor,
    CAST(discounts_active_other_vendor AS INT64) AS discounts_active_other_vendor,
    CAST(NULL AS INT64) AS discounts,
    CAST(NULL AS FLOAT64) AS discounts_gfv,
    CAST(NULL AS FLOAT64) AS discounts_gmv,
    CAST(NULL AS INT64) AS discounts_dh,
    CAST(NULL AS INT64) AS discounts_vendor,
    CAST(NULL AS INT64) AS discounts_mixed,
    CAST(NULL AS FLOAT64) AS discounts_value,
    CAST(NULL AS FLOAT64) AS discounts_value_dh,
    CAST(NULL AS FLOAT64) AS discounts_value_vendor,
    CAST(NULL AS INT64) AS orders,
    CAST(NULL AS FLOAT64) AS orders_gfv,
    CAST(NULL AS FLOAT64) AS orders_gmv,
    CAST(NULL AS INT64) AS vendors_active
  FROM
    active_discounts_vendor
  UNION ALL
  SELECT
    global_entity_id,
    report_month,
    vendor_code,
    discount_type,
    discount_title,
    CAST(NULL AS INT64) AS discounts_active,
    CAST(NULL AS INT64) AS discounts_active_free_delivery,
    CAST(NULL AS INT64) AS discounts_active_percentage,
    CAST(NULL AS INT64) AS discounts_active_text_freegift,
    CAST(NULL AS INT64) AS discounts_active_amount,
    CAST(NULL AS INT64) AS discounts_active_other,
    CAST(NULL AS INT64) AS discounts_active_no_vendor,
    CAST(NULL AS INT64) AS discounts_active_vendor,
    CAST(NULL AS INT64) AS discounts_active_free_delivery_vendor,
    CAST(NULL AS INT64) AS discounts_active_percentage_vendor,
    CAST(NULL AS INT64) AS discounts_active_text_freegift_vendor,
    CAST(NULL AS INT64) AS discounts_active_amount_vendor,
    CAST(NULL AS INT64) AS discounts_active_other_vendor,
    CAST(discounts AS INT64) AS discounts,
    CAST(discounts_gfv AS FLOAT64) AS discounts_gfv,
    CAST(discounts_gmv AS FLOAT64) AS discounts_gmv,
    CAST(discounts_dh AS INT64) AS discounts_dh,
    CAST(discounts_vendor AS INT64) AS discounts_vendor,
    CAST(discounts_mixed AS INT64) AS discounts_mixed,
    CAST(discounts_value AS FLOAT64) AS discounts_value,
    CAST(discounts_value_dh AS FLOAT64) AS discounts_value_dh,
    CAST(discounts_value_vendor AS FLOAT64) AS discounts_value_vendor,
    CAST(NULL AS INT64) AS orders,
    CAST(NULL AS FLOAT64) AS orders_gfv,
    CAST(NULL AS FLOAT64) AS orders_gmv,
    CAST(NULL AS INT64) AS vendors_active
  FROM
    discount_orders
  UNION ALL
  SELECT
    global_entity_id,
    report_month,
    vendor_code,
    discount_type,
    discount_title,
    CAST(NULL AS INT64) AS discounts_active,
    CAST(NULL AS INT64) AS discounts_active_free_delivery,
    CAST(NULL AS INT64) AS discounts_active_percentage,
    CAST(NULL AS INT64) AS discounts_active_text_freegift,
    CAST(NULL AS INT64) AS discounts_active_amount,
    CAST(NULL AS INT64) AS discounts_active_other,
    CAST(NULL AS INT64) AS discounts_active_no_vendor,
    CAST(NULL AS INT64) AS discounts_active_vendor,
    CAST(NULL AS INT64) AS discounts_active_free_delivery_vendor,
    CAST(NULL AS INT64) AS discounts_active_percentage_vendor,
    CAST(NULL AS INT64) AS discounts_active_text_freegift_vendor,
    CAST(NULL AS INT64) AS discounts_active_amount_vendor,
    CAST(NULL AS INT64) AS discounts_active_other_vendor,
    CAST(NULL AS INT64) AS discounts,
    CAST(NULL AS FLOAT64) AS discounts_gfv,
    CAST(NULL AS FLOAT64) AS discounts_gmv,
    CAST(NULL AS INT64) AS discounts_dh,
    CAST(NULL AS INT64) AS discounts_vendor,
    CAST(NULL AS INT64) AS discounts_mixed,
    CAST(NULL AS FLOAT64) AS discounts_value,
    CAST(NULL AS FLOAT64) AS discounts_value_dh,
    CAST(NULL AS FLOAT64) AS discounts_value_vendor,
    CAST(orders AS INT64) AS orders,
    CAST(orders_gfv AS FLOAT64) AS orders_gfv,
    CAST(orders_gmv AS FLOAT64) AS orders_gmv,
    CAST(NULL AS INT64) AS vendors_active
  FROM
    successful_orders
  UNION ALL
  SELECT
    global_entity_id,
    report_month,
    vendor_code,
    discount_type,
    discount_title,
    CAST(NULL AS INT64) AS discounts_active,
    CAST(NULL AS INT64) AS discounts_active_free_delivery,
    CAST(NULL AS INT64) AS discounts_active_percentage,
    CAST(NULL AS INT64) AS discounts_active_text_freegift,
    CAST(NULL AS INT64) AS discounts_active_amount,
    CAST(NULL AS INT64) AS discounts_active_other,
    CAST(NULL AS INT64) AS discounts_active_no_vendor,
    CAST(NULL AS INT64) AS discounts_active_vendor,
    CAST(NULL AS INT64) AS discounts_active_free_delivery_vendor,
    CAST(NULL AS INT64) AS discounts_active_percentage_vendor,
    CAST(NULL AS INT64) AS discounts_active_text_freegift_vendor,
    CAST(NULL AS INT64) AS discounts_active_amount_vendor,
    CAST(NULL AS INT64) AS discounts_active_other_vendor,
    CAST(NULL AS INT64) AS discounts,
    CAST(NULL AS FLOAT64) AS discounts_gfv,
    CAST(NULL AS FLOAT64) AS discounts_gmv,
    CAST(NULL AS INT64) AS discounts_dh,
    CAST(NULL AS INT64) AS discounts_vendor,
    CAST(NULL AS INT64) AS discounts_mixed,
    CAST(NULL AS FLOAT64) AS discounts_value,
    CAST(NULL AS FLOAT64) AS discounts_value_dh,
    CAST(NULL AS FLOAT64) AS discounts_value_vendor,
    CAST(NULL AS INT64) AS orders,
    CAST(NULL AS FLOAT64) AS orders_gfv,
    CAST(NULL AS FLOAT64) AS orders_gmv,
    CAST(vendors_active AS INT64) AS vendors_active
  FROM
    active_vendors)
SELECT
  v.chain_name,
  v.name,
  v.is_active,
  a.*
FROM
  final AS a
LEFT JOIN
  `fulfillment-dwh-production.pandata_curated.pd_vendors` AS v
ON
  a.global_entity_id=v.global_entity_id
  AND a.vendor_code=v.vendor_code]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0ja9gbu15j02n810qf1li0bjf1rn' name='Custom SQL Query' type='text'><![CDATA[WITH
  order_discount AS (
  SELECT
    DISTINCT pd_orders.code AS order_code,
    pd_orders.uuid AS order_uuid,
    pd_vendor_uuid,
    pd_orders.global_entity_id,
    pd_orders.created_date_utc AS created_date,
    DATE_TRUNC(pd_orders.created_date_utc, month) AS report_month,
    pd_orders_agg_discounts.discount_used AS discount_used,
    max (pd_orders_agg_discounts.discount_type) as discount_type,
    max (pd_orders_agg_discounts.discount_title) as discount_title,
    avg(discount_ratio) as discount_ratio,
    SUM(discount_value_local) as discount_value_local,
  FROM
    `fulfillment-dwh-production.pandata_curated.pd_orders` AS pd_orders
  LEFT JOIN
    `dha---bi-485.local_schedules.pd_order_discount_mmt_selected_dishes_v2` AS pd_orders_agg_discounts
  ON
    pd_orders_agg_discounts.order_code = pd_orders.code
    AND pd_orders_agg_discounts.created_date BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE-1,MONTH),INTERVAL 11 MONTH)
    AND CURRENT_DATE - 1
  LEFT JOIN
    `fulfillment-dwh-production.pandata_curated.pd_discounts` pd_discounts
  ON
    pd_discounts.uuid = pd_orders_agg_discounts.pd_discount_uuid
  WHERE
    pd_orders.created_date_utc BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE-1,MONTH),INTERVAL 11 MONTH)
    AND CURRENT_DATE - 1
    AND pd_orders.global_entity_id = 'MJM_AT'
    AND NOT is_test_order
    AND is_valid_order
  GROUP BY
    1,
    2,
    3,
    4,
    5,
    6,
    7
    ),
vendor_orders as (SELECT
  order_discount.global_entity_id,
  created_date,
  report_month,
  pd_vendors.vendor_code,
  discount_used,
  max(discount_type) as discount_type ,
  max(discount_title) as discount_title,
  COUNT(DISTINCT order_uuid) AS successful_orders,
  SUM(pd_orders_agg_accounting.gfv_eur) AS gfv_local,
  SUM(pd_orders_agg_accounting.gmv_eur) AS gmv_local,
  avg(discount_ratio) AS discount_ratio,
  SUM(discount_value_local) AS discount_value_local,
FROM
  order_discount
LEFT JOIN
  `fulfillment-dwh-production.pandata_curated.pd_vendors` AS pd_vendors
ON
  pd_vendors.uuid = order_discount.pd_vendor_uuid
LEFT JOIN
  `fulfillment-dwh-production.pandata_curated.pd_orders_agg_accounting` AS pd_orders_agg_accounting
ON
  pd_orders_agg_accounting.uuid = order_discount.order_uuid
  AND pd_orders_agg_accounting.created_date_utc BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE-1,MONTH),INTERVAL 11 MONTH)
  AND CURRENT_DATE - 1
GROUP BY
  1,2,3,4,5),

  discounts AS (
  SELECT
    global_entity_id,
    b.iso_date AS report_date,
    pd_discount_uuid,
    start_date_local,
    end_date_local,
    discount_type,
    discount_ratio,
    discount_title
  FROM
    `dha---bi-485.local_schedules.discount_mmt_selected_dishes` a,
    `fulfillment-dwh-production.curated_data_shared_central_dwh.dates` b
  WHERE
    global_entity_id = 'MJM_AT'
    AND start_date_local <<= b.iso_date
    AND end_date_local >>= b.iso_date
    AND b.iso_date BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE-1,MONTH),INTERVAL 11 MONTH)
    AND CURRENT_DATE - 1
  ORDER BY
    start_date_local,
    iso_date
    ),
  vendor_discounts AS (
  SELECT
    DISTINCT a.global_entity_id,
    d.pd_discount_uuid,
    b.iso_date AS report_date,
    a.vendor_code
  FROM
    `fulfillment-dwh-production.pandata_curated.pd_vendors` a
  LEFT JOIN
    UNNEST(discounts) d,
    `fulfillment-dwh-production.curated_data_shared_central_dwh.dates` b
  WHERE
    global_entity_id = 'MJM_AT'
    AND start_date_local <<= b.iso_date
    AND end_date_local >>= b.iso_date
    AND b.iso_date BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE-1,MONTH),INTERVAL 11 MONTH)
    AND CURRENT_DATE - 1 
UNION ALL
    SELECT
    DISTINCT a.global_entity_id,
    d.pd_discount_uuid,
    b.iso_date AS report_date,
    a.vendor_code
  FROM
    `fulfillment-dwh-production.pandata_curated.pd_vendors` a
  LEFT JOIN
    `dha---bi-485.local_schedules.discount_mmt_selected_dishes` d on left(d.pd_discount_uuid,4) = a.vendor_code,
    `fulfillment-dwh-production.curated_data_shared_central_dwh.dates` b
  WHERE
    a.global_entity_id = 'MJM_AT'
    AND start_date_local <<= b.iso_date
    AND end_date_local >>= b.iso_date
    AND b.iso_date BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE-1,MONTH),INTERVAL 11 MONTH)
    AND CURRENT_DATE - 1
    ),
  active_discounts AS (
  SELECT
    a.global_entity_id,
    DATE_TRUNC(a.report_date,MONTH) AS report_month,
    CAST(NULL AS STRING) AS vendor_code,
    a.discount_type,
    a.discount_title,
    COUNT(DISTINCT a.pd_discount_uuid) AS discounts_active,
    COUNT(DISTINCT b.vendor_code) AS discounts_active_vendor,
    COUNT(DISTINCT
      CASE
        WHEN discount_type ='free_delivery' THEN a.pd_discount_uuid
    END
      ) AS discounts_active_free_delivery,
    COUNT(DISTINCT
      CASE
        WHEN discount_type = 'percentage' THEN if(left(a.pd_discount_uuid,6)='MJM_AT',a.pd_discount_uuid,left(a.discount_title,3))
    END
      ) AS discounts_active_percentage,
    COUNT(DISTINCT
      CASE
        WHEN discount_type = 'free_gift' THEN a.pd_discount_uuid
    END
      ) AS discounts_active_free_gift,
    COUNT(DISTINCT
      CASE
        WHEN discount_type = 'amount' THEN a.pd_discount_uuid
    END
      ) AS discounts_active_amount,
    COUNT(DISTINCT
      CASE
        WHEN COALESCE(discount_type, '') NOT IN ('free_delivery', 'percentage', 'free_gift', 'amount') THEN a.pd_discount_uuid
    END
      ) AS discounts_active_other,
    CASE
      WHEN COUNT(DISTINCT b.vendor_code ) = 0 THEN 1
    ELSE
    0
  END
    AS discounts_active_no_vendor
  FROM
    discounts a
  LEFT JOIN
    `fulfillment-dwh-production.curated_data_shared_central_dwh.dates` AS d
  ON
    a.report_date = d.iso_date
  LEFT JOIN
    vendor_discounts b
  ON
    a.global_entity_id = b.global_entity_id
    AND a.report_date = b.report_date
    AND a.pd_discount_uuid = b.pd_discount_uuid
  GROUP BY
    1,
    2,
    3,
    4,
    5),
  active_discounts_vendor AS (
  SELECT
    a.global_entity_id,
    DATE_TRUNC(a.report_date,MONTH) AS report_month,
    b.vendor_code,
    a.discount_type,
    a.discount_title,
    COUNT(DISTINCT b.vendor_code) AS discounts_active_vendor,
    COUNT(DISTINCT
      CASE
        WHEN discount_type ='free_delivery' THEN b.vendor_code
    END
      ) AS discounts_active_free_delivery_vendor,
    COUNT(DISTINCT
      CASE
        WHEN discount_type = 'percentage' THEN b.vendor_code
    END
      ) AS discounts_active_percentage_vendor,
    COUNT(DISTINCT
      CASE
        WHEN discount_type = 'free_gift' THEN b.vendor_code
    END
      ) AS discounts_active_free_gift_vendor,
    COUNT(DISTINCT
      CASE
        WHEN discount_type = 'amount' THEN b.vendor_code
    END
      ) AS discounts_active_amount_vendor,
    COUNT(DISTINCT
      CASE
        WHEN COALESCE(discount_type, '') NOT IN ('free_delivery', 'percentage', 'free_gift', 'amount') THEN b.vendor_code
    END
      ) AS discounts_active_other_vendor
  FROM
    discounts a
  LEFT JOIN
    `fulfillment-dwh-production.curated_data_shared_central_dwh.dates` AS d
  ON
    a.report_date = d.iso_date
  INNER JOIN
    vendor_discounts b
  ON
    a.global_entity_id = b.global_entity_id
    AND a.report_date = b.report_date
    AND a.pd_discount_uuid = b.pd_discount_uuid
  GROUP BY
    1,
    2,
    3,
    4,
    5),
  discount_orders AS (
  SELECT
    a.global_entity_id,
    DATE_TRUNC(a.created_date,MONTH) AS report_month,
    a.vendor_code,
    a.discount_type,
    a.discount_title,
    SUM(a.successful_orders) AS discounts,
    SUM(a.gfv_local) AS discounts_gfv,
    SUM(a.gmv_local) AS discounts_gmv,
    SUM(CASE
        WHEN a.discount_ratio = 100 THEN a.successful_orders
    END
      ) AS discounts_dh,
    SUM(CASE
        WHEN a.discount_ratio = 0 THEN a.successful_orders
    END
      ) AS discounts_vendor,
    SUM(CASE
        WHEN a.discount_ratio >> 0 AND a.discount_ratio<<100 THEN a.successful_orders
    END
      ) AS discounts_mixed,
    SUM(a.discount_value_local) AS discounts_value,
    SUM(a.discount_value_local*(a.discount_ratio/100)) AS discounts_value_dh,
    SUM(a.discount_value_local*((100-a.discount_ratio)/100)) AS discounts_value_vendor
  FROM
    vendor_orders AS a
  WHERE
    a.created_date BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE-1,MONTH),INTERVAL 11 MONTH)-1
    AND CURRENT_DATE - 1
    AND a.global_entity_id = 'MJM_AT'
    AND a.successful_orders >> 0
    AND a.discount_used IS TRUE
  GROUP BY
    1,
    2,
    3,
    4,
    5 ),
  successful_orders AS (
  SELECT
    a.global_entity_id,
    DATE_TRUNC(a.created_date,MONTH) AS report_month,
    a.vendor_code,
    a.discount_used,
    CAST('Total' AS STRING) AS discount_type,
    CAST('Total' AS STRING) AS discount_title,
    SUM(a.successful_orders) AS orders,
    SUM(a.gfv_local) AS orders_gfv,
    SUM(a.gmv_local) AS orders_gmv
  FROM
    vendor_orders AS a
  WHERE
    a.global_entity_id = 'MJM_AT'
    AND a.successful_orders >> 0
  GROUP BY
    1,
    2,
    3,
    4),
  active_vendors AS (
  SELECT
    pd_vendors.global_entity_id,
    DATE_TRUNC(a.date_created,MONTH) AS report_month,
    a.vendor_code,
    CAST('Total' AS STRING) AS discount_type,
    CAST('Total' AS STRING)AS discount_title,
    COUNT(DISTINCT a.vendor_code) AS vendors_active
  FROM
    `dha---bi-485.local_schedules.pd_vendors_history` AS a
  LEFT JOIN
    `fulfillment-dwh-production.pandata_curated.pd_vendors` AS pd_vendors
  ON
    pd_vendors.vendor_code = a.vendor_code
  WHERE
    pd_vendors.global_entity_id = 'MJM_AT'
    AND a.date_created BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE-1,MONTH),INTERVAL 11 MONTH)
    AND CURRENT_DATE - 1
    AND a.is_active IS TRUE
  GROUP BY
    1,
    2,
    3,
    4,
    5 ),
  final AS (
  SELECT
    global_entity_id,
    report_month,
    vendor_code,
    discount_type,
    discount_title,
    CAST(discounts_active AS INT64) AS discounts_active,
    CAST(discounts_active_free_delivery AS INT64) AS discounts_active_free_delivery,
    CAST(discounts_active_percentage AS INT64) AS discounts_active_percentage,
    CAST(discounts_active_free_gift AS INT64) AS discounts_active_free_gift,
    CAST(discounts_active_amount AS INT64) AS discounts_active_amount,
    CAST(discounts_active_other AS INT64) AS discounts_active_other,
    CAST(discounts_active_no_vendor AS INT64) AS discounts_active_no_vendor,
    CAST(NULL AS INT64) AS discounts_active_vendor,
    CAST(NULL AS INT64) AS discounts_active_free_delivery_vendor,
    CAST(NULL AS INT64) AS discounts_active_percentage_vendor,
    CAST(NULL AS INT64) AS discounts_active_text_freegift_vendor,
    CAST(NULL AS INT64) AS discounts_active_amount_vendor,
    CAST(NULL AS INT64) AS discounts_active_other_vendor,
    CAST(NULL AS INT64) AS discounts,
    CAST(NULL AS FLOAT64) AS discounts_gfv,
    CAST(NULL AS FLOAT64) AS discounts_gmv,
    CAST(NULL AS INT64) AS discounts_dh,
    CAST(NULL AS INT64) AS discounts_vendor,
    CAST(NULL AS INT64) AS discounts_mixed,
    CAST(NULL AS FLOAT64) AS discounts_value,
    CAST(NULL AS FLOAT64) AS discounts_value_dh,
    CAST(NULL AS FLOAT64) AS discounts_value_vendor,
    CAST(NULL AS INT64) AS orders,
    CAST(NULL AS FLOAT64) AS orders_gfv,
    CAST(NULL AS FLOAT64) AS orders_gmv,
    CAST(NULL AS INT64) AS vendors_active
  FROM
    active_discounts
  UNION ALL
  SELECT
    global_entity_id,
    report_month,
    vendor_code,
    discount_type,
    discount_title,
    CAST(NULL AS INT64) AS discounts_active,
    CAST(NULL AS INT64) AS discounts_active_free_delivery,
    CAST(NULL AS INT64) AS discounts_active_percentage,
    CAST(NULL AS INT64) AS discounts_active_text_freegift,
    CAST(NULL AS INT64) AS discounts_active_amount,
    CAST(NULL AS INT64) AS discounts_active_other,
    CAST(NULL AS INT64) AS discounts_active_no_vendor,
    CAST(discounts_active_vendor AS INT64) AS discounts_active_vendor,
    CAST(discounts_active_free_delivery_vendor AS INT64) AS discounts_active_free_delivery_vendor,
    CAST(discounts_active_percentage_vendor AS INT64) AS discounts_active_percentage_vendor,
    CAST(discounts_active_free_gift_vendor AS INT64) AS discounts_active_free_gift_vendor,
    CAST(discounts_active_amount_vendor AS INT64) AS discounts_active_amount_vendor,
    CAST(discounts_active_other_vendor AS INT64) AS discounts_active_other_vendor,
    CAST(NULL AS INT64) AS discounts,
    CAST(NULL AS FLOAT64) AS discounts_gfv,
    CAST(NULL AS FLOAT64) AS discounts_gmv,
    CAST(NULL AS INT64) AS discounts_dh,
    CAST(NULL AS INT64) AS discounts_vendor,
    CAST(NULL AS INT64) AS discounts_mixed,
    CAST(NULL AS FLOAT64) AS discounts_value,
    CAST(NULL AS FLOAT64) AS discounts_value_dh,
    CAST(NULL AS FLOAT64) AS discounts_value_vendor,
    CAST(NULL AS INT64) AS orders,
    CAST(NULL AS FLOAT64) AS orders_gfv,
    CAST(NULL AS FLOAT64) AS orders_gmv,
    CAST(NULL AS INT64) AS vendors_active
  FROM
    active_discounts_vendor
  UNION ALL
  SELECT
    global_entity_id,
    report_month,
    vendor_code,
    discount_type,
    discount_title,
    CAST(NULL AS INT64) AS discounts_active,
    CAST(NULL AS INT64) AS discounts_active_free_delivery,
    CAST(NULL AS INT64) AS discounts_active_percentage,
    CAST(NULL AS INT64) AS discounts_active_text_freegift,
    CAST(NULL AS INT64) AS discounts_active_amount,
    CAST(NULL AS INT64) AS discounts_active_other,
    CAST(NULL AS INT64) AS discounts_active_no_vendor,
    CAST(NULL AS INT64) AS discounts_active_vendor,
    CAST(NULL AS INT64) AS discounts_active_free_delivery_vendor,
    CAST(NULL AS INT64) AS discounts_active_percentage_vendor,
    CAST(NULL AS INT64) AS discounts_active_text_freegift_vendor,
    CAST(NULL AS INT64) AS discounts_active_amount_vendor,
    CAST(NULL AS INT64) AS discounts_active_other_vendor,
    CAST(discounts AS INT64) AS discounts,
    CAST(discounts_gfv AS FLOAT64) AS discounts_gfv,
    CAST(discounts_gmv AS FLOAT64) AS discounts_gmv,
    CAST(discounts_dh AS INT64) AS discounts_dh,
    CAST(discounts_vendor AS INT64) AS discounts_vendor,
    CAST(discounts_mixed AS INT64) AS discounts_mixed,
    CAST(discounts_value AS FLOAT64) AS discounts_value,
    CAST(discounts_value_dh AS FLOAT64) AS discounts_value_dh,
    CAST(discounts_value_vendor AS FLOAT64) AS discounts_value_vendor,
    CAST(NULL AS INT64) AS orders,
    CAST(NULL AS FLOAT64) AS orders_gfv,
    CAST(NULL AS FLOAT64) AS orders_gmv,
    CAST(NULL AS INT64) AS vendors_active
  FROM
    discount_orders
  UNION ALL
  SELECT
    global_entity_id,
    report_month,
    vendor_code,
    discount_type,
    discount_title,
    CAST(NULL AS INT64) AS discounts_active,
    CAST(NULL AS INT64) AS discounts_active_free_delivery,
    CAST(NULL AS INT64) AS discounts_active_percentage,
    CAST(NULL AS INT64) AS discounts_active_text_freegift,
    CAST(NULL AS INT64) AS discounts_active_amount,
    CAST(NULL AS INT64) AS discounts_active_other,
    CAST(NULL AS INT64) AS discounts_active_no_vendor,
    CAST(NULL AS INT64) AS discounts_active_vendor,
    CAST(NULL AS INT64) AS discounts_active_free_delivery_vendor,
    CAST(NULL AS INT64) AS discounts_active_percentage_vendor,
    CAST(NULL AS INT64) AS discounts_active_text_freegift_vendor,
    CAST(NULL AS INT64) AS discounts_active_amount_vendor,
    CAST(NULL AS INT64) AS discounts_active_other_vendor,
    CAST(NULL AS INT64) AS discounts,
    CAST(NULL AS FLOAT64) AS discounts_gfv,
    CAST(NULL AS FLOAT64) AS discounts_gmv,
    CAST(NULL AS INT64) AS discounts_dh,
    CAST(NULL AS INT64) AS discounts_vendor,
    CAST(NULL AS INT64) AS discounts_mixed,
    CAST(NULL AS FLOAT64) AS discounts_value,
    CAST(NULL AS FLOAT64) AS discounts_value_dh,
    CAST(NULL AS FLOAT64) AS discounts_value_vendor,
    CAST(orders AS INT64) AS orders,
    CAST(orders_gfv AS FLOAT64) AS orders_gfv,
    CAST(orders_gmv AS FLOAT64) AS orders_gmv,
    CAST(NULL AS INT64) AS vendors_active
  FROM
    successful_orders
  UNION ALL
  SELECT
    global_entity_id,
    report_month,
    vendor_code,
    discount_type,
    discount_title,
    CAST(NULL AS INT64) AS discounts_active,
    CAST(NULL AS INT64) AS discounts_active_free_delivery,
    CAST(NULL AS INT64) AS discounts_active_percentage,
    CAST(NULL AS INT64) AS discounts_active_text_freegift,
    CAST(NULL AS INT64) AS discounts_active_amount,
    CAST(NULL AS INT64) AS discounts_active_other,
    CAST(NULL AS INT64) AS discounts_active_no_vendor,
    CAST(NULL AS INT64) AS discounts_active_vendor,
    CAST(NULL AS INT64) AS discounts_active_free_delivery_vendor,
    CAST(NULL AS INT64) AS discounts_active_percentage_vendor,
    CAST(NULL AS INT64) AS discounts_active_text_freegift_vendor,
    CAST(NULL AS INT64) AS discounts_active_amount_vendor,
    CAST(NULL AS INT64) AS discounts_active_other_vendor,
    CAST(NULL AS INT64) AS discounts,
    CAST(NULL AS FLOAT64) AS discounts_gfv,
    CAST(NULL AS FLOAT64) AS discounts_gmv,
    CAST(NULL AS INT64) AS discounts_dh,
    CAST(NULL AS INT64) AS discounts_vendor,
    CAST(NULL AS INT64) AS discounts_mixed,
    CAST(NULL AS FLOAT64) AS discounts_value,
    CAST(NULL AS FLOAT64) AS discounts_value_dh,
    CAST(NULL AS FLOAT64) AS discounts_value_vendor,
    CAST(NULL AS INT64) AS orders,
    CAST(NULL AS FLOAT64) AS orders_gfv,
    CAST(NULL AS FLOAT64) AS orders_gmv,
    CAST(vendors_active AS INT64) AS vendors_active
  FROM
    active_vendors)
SELECT
  v.chain_name,
  v.name,
  v.is_active,
  a.*
FROM
  final AS a
LEFT JOIN
  `fulfillment-dwh-production.pandata_curated.pd_vendors` AS v
ON
  a.global_entity_id=v.global_entity_id
  AND a.vendor_code=v.vendor_code]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
