      <column caption='= GMV including Subsidies (user paid amount)_Copy' datatype='real' name='[= OD GMV including Subsidies (user paid amount) (copy)_2390848474137960449]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[= OD Restaurant Generated GMV (copy)_2390848474137710592]-[Group_Subsidies]' />
      </column>
      <column caption='= Restaurant Generated GMV_copy' datatype='real' name='[= OD Restaurant Generated GMV (copy)_2390848474137710592]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[GFV/GPV (copy)_4474748453697941505]-[Restaurant_Subsidies]' />
      </column>
      <column caption='= OD Restaurant Generated GMV (copy)' datatype='real' name='[= OD Restaurant Generated GMV (copy)_894668262042177538]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Local&apos; THEN ([GFV]+[delivery_fee]+[Other_fees]-[Restaurant_Subsidies])&#10;ELSE ([GFV]+[delivery_fee]+[Other_fees]-[Restaurant_Subsidies]) / [fx]&#10;END' />
      </column>
      <column caption='= Restaurant Generated GMV' datatype='real' name='[= Restaurant Generated GMV (copy)_2429340160187211777]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Local&apos; THEN ([GFV]+[delivery_fee]+[Other_fees]-[Restaurant_Subsidies])&#10;ELSE ([GFV]+[delivery_fee]+[Other_fees]-[Restaurant_Subsidies]) / [fx]&#10;END' />
      </column>
      <column caption='Orders Paid Online' datatype='integer' name='[Calculation_1316458506947121154]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [is_paid_online] then [Total_Orders]else null end' />
      </column>
      <column caption='GFV/GPV' datatype='real' name='[Calculation_181340304737857538]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1]= &apos;Local&apos; then [GFV] else [GFV]/[fx] END' />
      </column>
      <column caption='+ Delivery Fee' datatype='real' name='[Calculation_181340304738217987]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1]= &apos;Local&apos; then [delivery_fee] else [delivery_fee]/[fx] END' />
      </column>
      <column caption='- Restaurant Subsidies' datatype='real' name='[Calculation_181340304738562052]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1]= &apos;Local&apos; then [Restaurant_Subsidies] ELSE [Restaurant_Subsidies]/[fx] END' />
      </column>
      <column caption='+ Other Fees' datatype='real' name='[Calculation_181340304738865157]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1]= &apos;Local&apos; then [Other_fees] else [Other_fees]/[fx] END' />
      </column>
      <column caption='- Group Subsidies' datatype='real' name='[Calculation_181340304739422214]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1]= &apos;Local&apos; then [Group_Subsidies] else [Group_Subsidies]/[fx] END' />
      </column>
      <column caption='MP GFV/GPV' datatype='real' name='[Calculation_4474748453697757184]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Local&apos; THEN [GFV]&#10;ELSE [GFV] / [fx]&#10;END' />
      </column>
