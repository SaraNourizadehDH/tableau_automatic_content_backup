-- left join `fulfillment-dwh-production.pandata_report.regional_eu__pd_orders_agg_vouchers` as voucher
-- on voucher.global_entity_id = po.global_entity_id
-- and voucher.uuid = po.uuid
   

    LEFT JOIN
