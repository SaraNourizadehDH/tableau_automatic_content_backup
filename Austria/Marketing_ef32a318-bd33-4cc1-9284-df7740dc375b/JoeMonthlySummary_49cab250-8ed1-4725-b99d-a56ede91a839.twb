      <column caption='JoeAcquisitions' datatype='integer' name='[Calculation_1433270611593879553]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if([joe_created_at]&lt;=[order_created_at]and [is_acquisition]) then [total_joe_orders] end' />
      </column>
      <column caption='promotional' datatype='string' name='[Calculation_1433270611595452418]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if ISNULL([promotion_id]) then &apos;NonPromotional&apos; else &apos;Promotional&apos; end' />
      </column>
      <column caption='NonAcquisitionOrders' datatype='integer' name='[Calculation_1433270611600556035]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if( not[is_acquisition]) then [total_joe_orders] end' />
      </column>
      <column caption='Calculation1' datatype='boolean' name='[Calculation_1433270611604889604]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[joe_created_at]&gt;=[order_created_at]and not [is_acquisition]' />
      </column>
