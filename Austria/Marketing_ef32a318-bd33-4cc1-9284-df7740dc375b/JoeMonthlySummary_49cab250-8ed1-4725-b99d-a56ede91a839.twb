        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0icja3b1s2jqi41ab0tf01pq2ux8' name='Custom SQL Query' type='text'><![CDATA[with 
joe_promo_data as (
select date_trunc(po.created_at_local,month) AS order_month,
po.created_at_utc as order_created_at,
 po.global_entity_id,
rw_promotions.start_at_utc as promotion_start_date,
 rw_promotions.end_at_utc as promotion_end_date,
 is_acquisition,
analytical_customer_id,
po.code as order_code,
rw_point_transactions_joe.order_code  as joe_order_code,

rw_point_transactions_joe.points,
rw_customer_promotions.rw_promotion_id as promotion_id,
rw_customer_promotions.customer_code,
rw_promotions.title as promotion_title,
rw_promotions.rw_string_uuid as promotion_uuid,
rw_promotions.rules as promotion_rules,
rw_customer_promotion_joe_points.base_earning,
rw_customer_promotion_joe_points.promotion_earning,
rw_promotion_reward_joe_points.effect_value,
rw_promotion_reward_joe_points.effect_type

-- vouchers.voucher_code,
-- is_voucher,
FROM
  `fulfillment-dwh-production.pandata_curated.pd_orders` AS po
left join
  `fulfillment-dwh-production.pandata_curated.rw_point_transactions_joe` AS rw_point_transactions_joe
ON
  rw_point_transactions_joe.order_code = po.code
  and rw_point_transactions_joe.global_entity_id = po.global_entity_id
LEFT JOIN
  `fulfillment-dwh-production.pandata_curated.rw_customer_promotions` AS rw_customer_promotions
ON
  rw_customer_promotions.order_code = po.code
  and rw_customer_promotions.global_entity_id= po.global_entity_id
LEFT JOIN
  `fulfillment-dwh-production.pandata_curated.rw_promotions` AS rw_promotions
ON
  rw_promotions.id = rw_customer_promotions.rw_promotion_id
LEFT JOIN
  `fulfillment-dwh-production.pandata_curated.rw_customer_promotion_joe_points` AS rw_customer_promotion_joe_points
ON
  rw_customer_promotion_joe_points.rw_customer_promotion_uuid = rw_customer_promotions.uuid
LEFT JOIN
  `fulfillment-dwh-production.pandata_curated.rw_promotion_reward_joe_points` AS rw_promotion_reward_joe_points
ON
  rw_promotion_reward_joe_points.id = rw_customer_promotions.rw_promotion_id
-- left join `fulfillment-dwh-production.pandata_report.regional_eu__pd_orders_agg_vouchers` as voucher
-- on voucher.global_entity_id = po.global_entity_id
-- and voucher.uuid = po.uuid
   

    LEFT JOIN
    `fulfillment-dwh-production.curated_data_shared_central_dwh.orders` orders_dwh
  ON
    orders_dwh.global_entity_id = po.global_entity_id
    AND orders_dwh.order_id=po.code
    -- ,unnest(orders_dwh.vouchers) as vouchers
  where po.global_entity_id = 'MJM_AT'
  -- and voucher.created_date_utc >> DATE_SUB(CURRENT_DATE, INTERVAL 2 MONTH)

--  And end_at_utc is not null
-- and effect_value is not null
and
  po.is_valid_order =true
 and po.created_date_utc >>=DATE_SUB(CURRENT_DATE, INTERVAL 3 MONTH)
 
  AND orders_dwh.placed_at_local>>= DATE_SUB(CURRENT_DATE, INTERVAL 3 MONTH)
order by 1 asc)
,
joe_connection as (SELECT
  customer_code,
  global_entity_id,
  partner,
  is_deleted,
  field,
  created_at_utc as joe_created_date
FROM
  `fulfillment-dwh-production.pandata_curated.cus_partner_details`
WHERE
  global_entity_id = 'MJM_AT'
  and field = 'databar_id'
)
,data_combine as (
select 
*
from joe_promo_data p left join joe_connection c 
on p.customer_code = c.customer_code
and p.global_entity_id = c.global_entity_id
)


select distinct 
order_month,
date_trunc(data_combine.joe_created_date,month) as joe_created_month,
data_combine.promotion_start_date,
promotion_end_date,
data_combine.effect_value,
promotion_id,
count(distinct if( promotion_id is not null, joe_order_code,null)) as promo_orders,

count(distinct if( promotion_id  is not null and is_acquisition and joe_created_date<<= order_created_at , joe_order_code,null)) as promo_acquisitions,

count(distinct if(is_acquisition and joe_created_date<<= order_created_at and promotion_id is null,joe_order_code,null)) as non_promo_acq,
count(distinct if( promotion_id is null,joe_order_code,null))as joe_orders,


 
 from data_combine
 


group by 1,2,3,4,5,6]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
