    <datasource caption='Daily - Last 6 Months' inline='true' name='federated.19dsmsg12jp9b811a7vcv1xwf5no' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='Phoenix Cities - Tableau Update List' name='cloudfile:googledrive-excel-direct.1nlz4kj0zcy4vs11911ag1dd7awz'>
            <connection class='cloudfile:googledrive-excel-direct' cleaning='no' cloudFileExtension='xlsx' cloudFileId='12Jx-WCnRdRvxZ66Co38WnUzMyxaxYbAv1rMne8p4jDs' cloudFileMetadata_-_folder='root' cloudFileName='TEMP_076c2c51hla0tq14bbydf0p7irr5.xlsx' cloudFileProvider='googledrive' cloudFileRequestURL='https://www.googleapis.com/drive/v3/files/12Jx-WCnRdRvxZ66Co38WnUzMyxaxYbAv1rMne8p4jDs/export?mimeType=application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' compat='no' dataRefreshTime='' filename='TEMP_076c2c51hla0tq14bbydf0p7irr5.xlsx' google-sheets-upgraded='true' interpretationMode='1' server='' server-oauth='server-custom' userLanguage='en' username='tilo.mohaupt@foodora.at' validate='no' workgroup-auth-mode='as-is' />
          </named-connection>
          <named-connection caption='BigQuery' name='bigquery.0m4fy5q1fkqrhj125n6pf1h2otxs'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dha-logistics-dwh-access' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='pandata_curated' server-oauth='' username='tilo.mohaupt@foodora.at' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation join='left' type='join'>
          <clause type='join'>
            <expression op='='>
              <expression op='[Custom SQL Query].[restaurant_city]' />
              <expression op='[Overview].[City]' />
            </expression>
          </clause>
          <relation connection='bigquery.0m4fy5q1fkqrhj125n6pf1h2otxs' name='Custom SQL Query' type='text'><![CDATA[WITH
  pd_order AS (
  SELECT
    pd_orders.created_date_utc AS order_date,
    pd_orders.uuid AS order_id,
    pd_orders.is_valid_order,
    pd_vendors.adjusted_chain_name AS chain_name,
    pd_vendors.city AS restaurant_city,
    pd_vendors.uuid AS restaurant_id,
    agg_customers.first_is_mobile first_mobile_order,
    pd_orders.source platform,
    pd_orders_agg_vouchers.voucher.value_eur AS voucher_value_eur,
    pd_orders_agg_vouchers.voucher.current_foodpanda_ratio AS voucher_ratio,
    pd_orders_agg_vouchers.voucher.voucher_code campaign_name,
    pd_orders_agg_accounting.gmv_eur AS gmv_eur,
    pd_orders_agg_accounting.gfv_eur AS gfv_eur,
    pd_orders_agg_vouchers.is_voucher_used,
    pd_orders_agg_vouchers.voucher.vendor_subsidized_value_eur,
    pd_orders_agg_discount.is_discount_used,
    pd_orders_agg_vouchers.voucher.value_eur voucher_amount_eur,
    pd_orders_agg_discount.discount.discount_amount_eur,
    dwh_orders.customer_order_rank,
    dwh_orders.customer_vendor_rank,
    agg_customers.first_placed_date_local,
    dwho.analytical_customer_id,
    dwho.is_acquisition ,
   pd_orders.commission
  FROM
    `fulfillment-dwh-production.pandata_curated.pd_orders` AS pd_orders
  LEFT JOIN
    `fulfillment-dwh-production.curated_data_shared_central_dwh.orders` AS dwh_orders
  ON
    dwh_orders.order_id = pd_orders.code
    AND dwh_orders.global_entity_id = pd_orders.global_entity_id
    AND dwh_orders.placed_at_local >>= '2021-06-01'
    AND DATE_TRUNC(dwh_orders.placed_at_local, year) >>= DATE_TRUNC(current_date, year)
  LEFT JOIN
    dwh_orders.vouchers vouchers
  LEFT JOIN
    `dha---bi-485.prod_tables.vendor_info` AS pd_vendors
  ON
    pd_vendors.uuid = pd_orders.pd_vendor_uuid

    LEFT JOIN
    `fulfillment-dwh-production.pandata_report.regional_eu__pd_orders_agg_accounting` AS pd_orders_agg_accounting
  ON
    pd_orders_agg_accounting.uuid = pd_orders.uuid
    AND pd_orders_agg_accounting.created_date_utc >>= DATE_SUB(CURRENT_DATE, INTERVAL 6 month)
  LEFT JOIN
    `fulfillment-dwh-production.pandata_report.regional_eu__pd_orders_agg_vouchers` AS pd_orders_agg_vouchers
  ON
    pd_orders_agg_vouchers.uuid = pd_orders.uuid
    AND pd_orders_agg_vouchers.created_date_utc >>= DATE_SUB(CURRENT_DATE, INTERVAL 6 month)
  LEFT JOIN
    `fulfillment-dwh-production.pandata_report.regional_eu__pd_orders_agg_discounts` AS pd_orders_agg_discount
  ON
    pd_orders_agg_discount.pd_discount_uuid = pd_orders.uuid
    AND pd_orders_agg_discount.created_date_utc >>= DATE_SUB(CURRENT_DATE, INTERVAL 6 MONTH)
  LEFT JOIN
    `fulfillment-dwh-production.curated_data_shared_central_dwh.orders` AS dwho
  

  ON
    dwho.order_id=pd_orders.code
    AND dwho.global_entity_id=pd_orders.global_entity_id
    AND dwho.placed_at_local>>=DATE_SUB(current_date, INTERVAL 6 month)
    AND DATE(dwho.placed_at)>>=DATE_SUB(current_date, INTERVAL 6 month)

  LEFT JOIN
    `fulfillment-dwh-production.curated_data_shared_central_dwh.agg_customers` AS agg_customers
  ON
    agg_customers.first_order_id = pd_orders.code
    AND agg_customers.global_entity_id = pd_orders.global_entity_id
  WHERE
    pd_orders.global_entity_id = 'MJM_AT'
    AND is_valid_order
    AND pd_orders.created_date_utc <<>>current_date
    AND pd_orders.created_date_utc >>= DATE_SUB(CURRENT_DATE, INTERVAL 6 MONTH))
SELECT
  order_date,
  chain_name,
  restaurant_id,
  restaurant_city,
  campaign_name,
  first_mobile_order,
  platform,
  is_discount_used,
  COUNT(DISTINCT analytical_customer_id) AS total_customers,
  COUNT(DISTINCT
  IF
    (is_acquisition,
     analytical_customer_id,
      NULL )) AS acquisitions,
  COUNT(
    CASE
      WHEN customer_vendor_rank = 1 THEN order_id
    ELSE
    NULL
  END
    ) AS new_customers_restaurant,
  count (DISTINCT
  IF
    (is_voucher_used,
      order_id,
      NULL)) AS voucher_orders,
  count (DISTINCT
  IF
    (is_discount_used,
      order_id,
      NULL)) AS deal_orders,
  COUNT(DISTINCT order_id) AS successful_orders,
  SUM( voucher_value_eur ) AS voucher_spend,
  SUM( discount_amount_eur ) AS total_discount_amount_eur,
  SUM( vendor_subsidized_value_eur) AS total_voucher_vendor_value_eur,
  SUM( gmv_eur ) AS total_gmv_eur,
  SUM( commission ) AS total_commission_local
FROM
  pd_order AS p
GROUP BY
  1,
  2,
  3,
  4,
  5,
  6,
  7,
  8]]></relation>
          <relation connection='cloudfile:googledrive-excel-direct.1nlz4kj0zcy4vs11911ag1dd7awz' name='Overview' table='[Overview$]' type='table'>
