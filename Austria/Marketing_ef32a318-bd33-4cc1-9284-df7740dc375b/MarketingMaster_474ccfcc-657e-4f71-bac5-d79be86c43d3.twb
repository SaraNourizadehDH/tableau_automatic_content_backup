        <calculation class='tableau' formula='IF [Calculation_2831004991363182594] THEN &apos;Phoenix&apos;&#10;ELSEIF not [Calculation_2831004991363182594] and [restaurant_city] &lt;&gt; &apos;wien&apos; THEN &apos;Others excl. Vienna&apos;&#10;ELSE &apos;Vienna&apos;&#10;END' />
      </column>
      <column caption='check_phoenix' datatype='boolean' name='[Calculation_2831004991363182594]' role='dimension' type='nominal'>
