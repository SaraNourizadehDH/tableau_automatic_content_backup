      <column caption='Menu Deal?' datatype='boolean' name='[Calculation_5185120934330011651]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='NOT ISNULL([is_menu_deal])' />
      </column>
      <column caption='Date Dim' datatype='string' name='[Calculation_5940318297056980996]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN  &apos;Daily&apos; THEN STR(DATE([date_week]))&#10;WHEN &apos;Weekly&apos; THEN STR(WEEK([date_week]))&#10;WHEN &apos;Monthly&apos; THEN STR(MONTH([date_week]))&#10;END' />
