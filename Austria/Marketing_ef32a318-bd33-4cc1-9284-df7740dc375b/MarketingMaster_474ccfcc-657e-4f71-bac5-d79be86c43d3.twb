            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.19dsmsg12jp9b811a7vcv1xwf5no'>
            <column caption='Phoenix City' datatype='string' name='[Calculation_2622291296110039041]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_2831004991363182594] THEN &apos;Phoenix&apos;&#10;ELSEIF not [Calculation_2831004991363182594] and [restaurant_city] &lt;&gt; &apos;wien&apos; THEN &apos;Others excl. Vienna&apos;&#10;ELSE &apos;Vienna&apos;&#10;END' />
            </column>
            <column caption='check_phoenix' datatype='boolean' name='[Calculation_2831004991363182594]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='(NOT ISNULL([City])) AND [Status]' />
            </column>
            <column caption='Date Dim' datatype='string' name='[Calculation_5185120934323343362]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN  &apos;Daily&apos; THEN STR(DATE([order_date]))&#10;WHEN &apos;Weekly&apos; THEN STR(DATEPART(&apos;year&apos;,[order_date])) +&apos; - &apos;+STR(DATEPART(&apos;iso-week&apos;,[order_date]))&#10;WHEN &apos;Monthly&apos; THEN STR(DATEPART(&apos;year&apos;, [order_date])) +&apos; - &apos;+STR(DATEPART(&apos;month&apos;,[order_date]))&#10;END' />
            </column>
            <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column datatype='boolean' name='[Status]' role='dimension' type='nominal' />
            <column datatype='string' name='[campaign_name]' role='dimension' type='nominal' />
            <column datatype='string' name='[chain_name]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2622291296110039041]' derivation='None' name='[none:Calculation_2622291296110039041:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_5185120934323343362]' derivation='None' name='[none:Calculation_5185120934323343362:nk]' pivot='key' type='nominal' />
            <column-instance column='[campaign_name]' derivation='None' name='[none:campaign_name:nk]' pivot='key' type='nominal' />
