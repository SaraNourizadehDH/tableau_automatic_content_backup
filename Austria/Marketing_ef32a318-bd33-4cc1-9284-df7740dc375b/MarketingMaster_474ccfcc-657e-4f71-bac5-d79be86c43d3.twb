      <column caption='Date Dim' datatype='string' name='[Calculation_5185120934323343362]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN  &apos;Daily&apos; THEN STR(DATE([order_date]))&#10;WHEN &apos;Weekly&apos; THEN STR(DATEPART(&apos;year&apos;,[order_date])) +&apos; - &apos;+STR(DATEPART(&apos;iso-week&apos;,[order_date]))&#10;WHEN &apos;Monthly&apos; THEN STR(DATEPART(&apos;year&apos;, [order_date])) +&apos; - &apos;+STR(DATEPART(&apos;month&apos;,[order_date]))&#10;END' />
      </column>
      <column caption='Menu Deal?' datatype='boolean' name='[Calculation_5185120934330011651]' role='dimension' type='nominal'>
