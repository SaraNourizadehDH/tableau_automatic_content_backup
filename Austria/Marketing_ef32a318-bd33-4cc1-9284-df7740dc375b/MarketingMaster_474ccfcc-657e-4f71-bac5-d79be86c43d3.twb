      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_042C6A17CF194623B6CE9925BA5F06E4'>
            <properties context=''>
              <relation join='left' type='join'>
                <clause type='join'>
                  <expression op='='>
                    <expression op='[Custom SQL Query].[city]' />
                    <expression op='[Overview].[City]' />
                  </expression>
                </clause>
                <relation connection='bigquery.1rnomvf0xw47cm10ozcbx0ln5e89' name='Custom SQL Query' type='text'>SELECT
  DATE_TRUNC(date(o.placed_at_local),week) date_week,
  o.delivery_location.city,
  vendors.chain_name,
  vendors.vendor_id,
  vouchers.campaign_name,
  o.is_discount,
  o.frontend_client.frontend_client_type platform,
  count(distinct o.analytical_customer_id) active_customers,
  count(distinct IF(o.is_acquisition,o.analytical_customer_id,null)) acquisitions,
  count(distinct IF(o.is_acquisition and cust.first_is_mobile,o.analytical_customer_id,null)) mobile_acquisitions,
  count(distinct IF(o.customer_vendor_rank=1 and o.is_acquisition,o.analytical_customer_id,null)) new_to_vendor,
  count(distinct IF(o.is_voucher,o.order_id,null)) voucher_orders,
  count(distinct IF(o.is_sent,o.order_id,null)) successful_orders  
FROM
  `fulfillment-dwh-production.curated_data_shared_central_dwh.orders` o
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_central_dwh.agg_customers` cust on cust.analytical_customer_id=o.analytical_customer_id
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_central_dwh.vendors` vendors on vendors.vendor_id=o.vendor_id and vendors.global_entity_id=o.global_entity_id
  LEFT JOIN o.vouchers vouchers
WHERE
  o.global_entity_id=&apos;MJM_AT&apos;
  AND DATE(o.placed_at_local) &gt;&gt;= DATE_SUB(DATE_TRUNC(current_date, year), INTERVAL 1 YEAR)
GROUP BY
  1,2,3,4,5,6,7</relation>
