      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.14kwot01kltrfa17f4rw71w2k805'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dha-logistics-dwh-access' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='curated_data_shared_cx' server-oauth='' username='sirinthip.narula@deliveryhero.at' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.14kwot01kltrfa17f4rw71w2k805' name='Custom_SQL_Query' type='text'><![CDATA[WITH
  avgs AS (
  SELECT
    o.uuid,
    SUM(products.price_local) avg_basket_size
  FROM
    `fulfillment-dwh-production.pandata_curated.pd_orders` o,
    UNNEST(o.products) products
  WHERE
    o.global_entity_id='MJM_AT'
    AND o.created_date_utc <<>> current_date
    AND o.is_valid_order
    AND NOT o.is_test_order
    AND DATE_DIFF(current_date, o.created_date_utc, month) <<= 6
  GROUP BY
    1 )
SELECT
  o.created_date_local,
  o.payment_type.title,
  o.source,
  o.code,
  avgs.avg_basket_size
FROM
  `fulfillment-dwh-production.pandata_curated.pd_orders` o
JOIN
  `fulfillment-dwh-production.pandata_curated.pd_vendors` v
ON
  o.pd_vendor_uuid = v.uuid
  AND v.vertical_type = 'darkstores'
JOIN
  avgs
ON
  avgs.uuid = o.uuid
WHERE
  o.global_entity_id='MJM_AT'
  AND o.created_date_utc <<>> current_date
  AND o.is_valid_order
  AND NOT o.is_test_order
  AND DATE_DIFF(current_date, o.created_date_utc, month) <<= 6]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.14kwot01kltrfa17f4rw71w2k805' name='Custom_SQL_Query' type='text'><![CDATA[WITH
  avgs AS (
  SELECT
    o.uuid,
    SUM(products.price_local) avg_basket_size
  FROM
    `fulfillment-dwh-production.pandata_curated.pd_orders` o,
    UNNEST(o.products) products
  WHERE
    o.global_entity_id='MJM_AT'
    AND o.created_date_utc <<>> current_date
    AND o.is_valid_order
    AND NOT o.is_test_order
    AND DATE_DIFF(current_date, o.created_date_utc, month) <<= 6
  GROUP BY
    1 )
SELECT
  o.created_date_local,
  o.payment_type.title,
  o.source,
  o.code,
  avgs.avg_basket_size
FROM
  `fulfillment-dwh-production.pandata_curated.pd_orders` o
JOIN
  `fulfillment-dwh-production.pandata_curated.pd_vendors` v
ON
  o.pd_vendor_uuid = v.uuid
  AND v.vertical_type = 'darkstores'
JOIN
  avgs
ON
  avgs.uuid = o.uuid
WHERE
  o.global_entity_id='MJM_AT'
  AND o.created_date_utc <<>> current_date
  AND o.is_valid_order
  AND NOT o.is_test_order
  AND DATE_DIFF(current_date, o.created_date_utc, month) <<= 6]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
