        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0o9qp6h0t9mj8m1h8yx6q0rforsa' name='Custom_SQL_Query' type='text'><![CDATA[SELECT
  DATE_TRUNC(o.created_date_utc, month) order_month,
  v.location.city,
  o.order_code as code,
  ST_X(o.rider.customer_location_geo) longitude,
  ST_Y(o.rider.customer_location_geo) latitude
FROM
  `fulfillment-dwh-production.pandata_curated.lg_orders` o
JOIN
  `fulfillment-dwh-production.pandata_curated.pd_vendors` v
ON
  o.vendor_code = v.vendor_code
  AND o.global_entity_id = v.global_entity_id
  AND v.vertical_type = 'darkstores'
WHERE
  o.global_entity_id='MJM_AT'
  AND o.created_date_utc <<>> current_date
  AND o.vendor.order_status = 'completed'
  AND DATE_DIFF(current_date, o.created_date_utc, month) <<= 6]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
