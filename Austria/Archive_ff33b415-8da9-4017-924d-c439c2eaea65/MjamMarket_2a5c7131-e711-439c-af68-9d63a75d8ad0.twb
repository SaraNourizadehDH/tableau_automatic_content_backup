            <column caption='% Delivery Late &gt; 10' datatype='real' name='[Calculation_2129358210867773440]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([delivery_delay_over_10_count])/sum([delivery_delay_count])' />
            </column>
            <column caption='Average Delivery Time' datatype='real' name='[Calculation_2129358210868776961]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_time_min_sum])/SUM([delivery_time_count])' />
            </column>
            <column caption='% Delivery Late &gt;15' datatype='real' name='[Calculation_2129358210869121026]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([delivery_delay_over_15_count])/sum([delivery_delay_count])' />
            </column>
            <column caption='% Delivery Late &gt;5' datatype='real' name='[Calculation_2129358210870194180]' role='measure' type='quantitative'>
