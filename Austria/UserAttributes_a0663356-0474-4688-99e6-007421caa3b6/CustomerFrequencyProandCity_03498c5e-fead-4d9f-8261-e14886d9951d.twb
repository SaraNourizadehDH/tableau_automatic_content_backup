            <contains-null>true</contains-null>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>avg_frequency</remote-name>
            <remote-type>5</remote-type>
            <local-name>[avg_frequency]</local-name>
            <parent-name>[Custom SQL Query]</parent-name>
            <remote-alias>avg_frequency</remote-alias>
