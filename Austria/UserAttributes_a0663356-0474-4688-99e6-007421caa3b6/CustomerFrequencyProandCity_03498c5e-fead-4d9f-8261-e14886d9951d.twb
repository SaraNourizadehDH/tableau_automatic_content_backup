        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0khdxx10esrot91e4egbn11hrxok' name='Custom SQL Query' type='text'><![CDATA[-- Total Subsription Customer Base
with sub_data as (
SELECT
s.global_entity_id
, s.customer_uuid
, COALESCE(i.central_dwh_analytical_customer_id, s.customer_uuid) AS analytical_customer_id
, s.plan_code
, created_date_utc
, s.id AS subs_id
, s.status
, p.is_status_success
, p.is_status_failed
, p.is_renewal
, CASE WHEN LENGTH(p.voucher_code) << 1 THEN NULL ELSE p.voucher_code END AS voucher_code -->> because even without a code it wasnt actually null
, DATE(s.cancelled_at_local) AS cancelled_date
, DATE(p.paid_at_local) AS paid_date
, DATE(p.subscription_start_at_local) AS plan_start_date 
, DATE(p.subscription_end_at_local) AS plan_end_date
FROM `fulfillment-dwh-production.pandata_curated.sb_subscriptions` AS s
LEFT JOIN UNNEST(s.payments) AS p
LEFT JOIN `fulfillment-dwh-production.pandata_curated.mkt_tech_braze_external_id_map` AS i 
  ON s.customer_id = SAFE_CAST(SPLIT(i.mkt_tech_external_id, "_")[SAFE_OFFSET(1)] AS INT)
  AND s.global_entity_id = i.global_entity_id
WHERE s.global_entity_id = 'MJM_AT'
  AND created_date_utc <<= CURRENT_DATE
  and is_status_success = true
),

pro_users as

 ( select DISTINCT CASE WHEN plan_start_date <<= date_sub(current_date,interval 1 day) AND plan_end_date >> date_sub(current_date,interval 1 day) THEN analytical_customer_id END AS pro_analytical_customer_id,
CASE WHEN plan_start_date <<= date_sub(current_date,interval 1 day) AND plan_end_date >> date_sub(current_date,interval 1 day) THEN true else false END AS is_pro_user ,global_entity_id,
date_sub(current_date,interval 1 day) as report_date
from sub_data
)
, 

all_customers as 
(

  SELECT distinct 
date_sub(current_date,interval 1 day) as report_date,
all_cust.global_entity_id,
all_cust.central_dwh_analytical_customer_id as  central_analytical_customer_id,
case when is_pro_user= true then 'Pro' else
'Nonpro' end as user_type,

FROM  `fulfillment-dwh-production.pandata_curated.mkt_tech_braze_external_id_map` AS all_cust
left join pro_users
on pro_users.pro_analytical_customer_id = all_cust.central_dwh_analytical_customer_id
and pro_users.global_entity_id = all_cust.global_entity_id

where
 all_cust.global_entity_id = 'MJM_AT'

),
 customer_address as (
SELECT
DISTINCT

central_analytical_customer_id,
 eu_orders.customer_code,
 eu_orders.created_date_local,
order_code,
eu_orders.global_entity_id,
case when LOWER(delivery_address_city) IN ('wien',
'vienna') then 'vienna 'end as city,
delivery_address_postcode,
FROM
`fulfillment-dwh-production.pandata_report.agg_orders_eu` eu_orders
LEFT JOIN
`fulfillment-dwh-production.pandata_curated.pd_orders` pdo
ON
pdo.global_entity_id = eu_orders.global_entity_id
AND pdo.pd_customer_uuid = eu_orders.pd_customer_uuid
AND pdo.code = eu_orders.order_code
WHERE
eu_orders.created_date_utc >>= date_sub(current_date,interval 90 day)
AND pdo.created_date_utc >>= date_sub(current_date,interval 90 day) 
AND eu_orders.global_entity_id = 'MJM_AT'
AND LOWER(delivery_address_city) IN ('wien',
'vienna')
and delivery_address_postcode in ('1010',
'1020',
'1030',
'1040',
'1050',
'1060',
'1070',
'1080',
'1090',
 '1100',
 '1110',
 '1120',
 '1130',
 '1140',
 '1150',
 '1160',
 '1170',
 '1180',
 '1190',
 '1200',
 '1210',
 '1220',
 '1230')
GROUP BY 1,2,3,4,5,6,7

ORDER By
1 DESC)
-- ,
--  aggregated_data as (
select
distinct date_trunc(created_date_local,month) as month,
 all_customers.central_analytical_customer_id ,city,
user_type,
 case when  delivery_address_postcode IN ('1010',
'1020',
'1030',
'1040',
'1050',
'1060',
'1070',
'1080',
'1090') then '1-9' 
when delivery_address_postcode in (
 '1100',
 '1110',
 '1120',
 '1130',
 '1140',
 '1150',
 '1160',
 '1170',
 '1180',
 '1190',
 '1200',
 '1210',
 '1220',
 '1230') then '10-23' else null end as district_group,
 delivery_address_postcode,
count(distinct order_code) as orders,


 from all_customers
left join customer_address on 
all_customers.global_entity_id= customer_address.global_entity_id
and all_customers.central_analytical_customer_id = customer_address.central_analytical_customer_id

group by 1,2,3,4,5,6
-- )
-- -- ,
-- -- frequency_data as (
-- select 
-- month,city,user_type,district_1to9,district_1to23,
--  aggregated_data.central_analytical_customer_id as  analytical_customer_id,
--  sum(orders),
-- sum(orders)/count(distinct aggregated_data.central_analytical_customer_id) as frequency,

-- sum(orders) as orders

--  from aggregated_data
--  group by 1,2,3,4,5,6
 
-- --  )
-- --  select 
 
-- --  case when 
-- --  (frequency>>0 and frequency<<=1)  THEN '0-1' 
-- -- when (frequency>>2 and frequency<<=3) then '2-3'
-- -- when (frequency>>3 and frequency<<=4) then '3-4'
-- -- when(frequency>>4 and frequency<<=6) then '4-6'
-- -- when (frequency>>6 and frequency<<= 8) then '6-8'
-- -- when(frequency>>8 and frequency<<=10) then '8-10'
-- -- when (frequency>>10) then '10+' 
-- -- END as freq_group,

-- -- city,user_type,district_1to9,district_1to23,
-- --   sum(orders) as orders,
-- --   sum(analytical_customer_id) as customers,
-- --   avg(frequency) as avg_frequency
-- --   from frequency_data f

-- -- group by 1,2,3,4,5]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
