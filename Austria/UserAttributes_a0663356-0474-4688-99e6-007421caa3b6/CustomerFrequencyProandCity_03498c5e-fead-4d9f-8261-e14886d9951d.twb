      <column caption='Frequency group' datatype='string' name='[Calculation_656681142174273538]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='If ([Calculation_656681142179450884]&lt;=0 ) THEN &apos;0&apos; &#13;&#10;ELSEIF ([Calculation_656681142179450884]&lt;=1 ) THEN &apos;1&apos; &#13;&#10;ELSEIF([Calculation_656681142179450884]&lt;=2 ) THEN &apos;2&apos; &#13;&#10;ELSEIF([Calculation_656681142179450884]&lt;=3 ) THEN &apos;3&apos; &#13;&#10;ELSEIF ([Calculation_656681142179450884]&lt;=4 ) THEN &apos;4&apos; &#13;&#10;ELSEIF ([Calculation_656681142179450884]&lt;=5 ) THEN &apos;5&apos; &#13;&#10;ELSEIF([Calculation_656681142179450884]&lt;=6 ) THEN &apos;6&apos; &#13;&#10;ELSEIF([Calculation_656681142179450884]&lt;=7 ) THEN &apos;7&apos; &#13;&#10;ELSEIF ([Calculation_656681142179450884]&lt;=8 ) THEN &apos;8&apos; &#13;&#10;ELSEIF ([Calculation_656681142179450884]&lt;=9 ) THEN &apos;9&apos; &#13;&#10;ELSEIF ([Calculation_656681142179450884]&lt;=10 ) THEN &apos;10&apos; &#13;&#10;ELSEIF ([Calculation_656681142179450884]&gt;10) then &apos;10+&apos; &#13;&#10;END' />
      </column>
      <column caption='Frequency' datatype='real' name='[Calculation_656681142179450884]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [central_analytical_customer_id],[month]:SUM([orders])/COUNTD([central_analytical_customer_id])}' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Custom SQL Query' datatype='table' hidden='true' name='[__tableau_internal_object_id__].[_7FFDCF46FACD478B8406B8410593256B]' role='measure' type='quantitative' />
