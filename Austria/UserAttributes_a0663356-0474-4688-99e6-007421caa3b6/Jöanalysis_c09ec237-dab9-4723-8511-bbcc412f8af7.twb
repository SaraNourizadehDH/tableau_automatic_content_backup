      <column caption='Orders' datatype='integer' name='[Calculation_1281274143000301568]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([order_uuid])' />
      </column>
      <column caption='Customers' datatype='integer' name='[Calculation_1281274143000395777]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([analytical_customer_id])' />
      </column>
      <column caption='Frequency' datatype='real' name='[Calculation_1281274143020609543]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([order_uuid])/COUNTD([analytical_customer_id])' />
      </column>
      <column caption='churnedaccounts' datatype='string' name='[Calculation_1281274143034060811]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if[joe_deleted] then [analytical_customer_id] end' />
      </column>
      <column caption='Acquisition Condition' datatype='boolean' name='[Calculation_1463388454330118147]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if([connected_date]&lt;= [order_day]) then true end' />
      </column>
      <column caption='Partners' datatype='string' name='[Calculation_1463388454331904004]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_1463388454330118147] = true&#13;&#10;and [partner] = &apos;jö&apos;&#13;&#10; then &apos;jö&apos;&#13;&#10;ELSEIF  [partner] = &apos;nonjö&apos; then&#13;&#10; &apos;nonjö&apos;&#13;&#10;&#13;&#10; end' />
