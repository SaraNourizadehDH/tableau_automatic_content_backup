        <field-sort-custom-order field='Calculation_1281274143000395777' />
        <field-sort-custom-order field='Calculation_1281274143022723080' />
        <field-sort-custom-order field='gfv_eur' />
        <field-sort-custom-order field='gmv_eur' />
        <field-sort-custom-order field='delivery_fee_local' />
