    po.uuid AS order_uuid,
    analytical_customer_id,
    pd_orders_agg_accounting.gfv_eur AS gfv_eur,
    pd_orders_agg_accounting.gmv_eur AS gmv_eur,
    po.delivery_fee_local AS delivery_fee_local,
    accounting.discount_eur AS discount_eur,
    po.global_entity_id,
    po.pd_customer_uuid,
    orders_dwh.is_acquisition
  FROM
    `fulfillment-dwh-production.pandata_curated.pd_orders` AS po
  LEFT JOIN
    `fulfillment-dwh-production.curated_data_shared_central_dwh.orders` orders_dwh
  ON
    orders_dwh.global_entity_id = po.global_entity_id
    AND orders_dwh.order_id=po.code
  LEFT JOIN
    `fulfillment-dwh-production.pandata_report.regional_eu__pd_orders_agg_accounting` AS pd_orders_agg_accounting
  ON
    pd_orders_agg_accounting.uuid = po.uuid
    AND pd_orders_agg_accounting.global_entity_id = po.global_entity_id,
    UNNEST(accounting) AS accounting
  WHERE
    po.global_entity_id = 'MJM_AT'
    AND orders_dwh.placed_at_local >>= "2021-05-01"
    AND po.created_date_utc >>= "2021-05-01"
    AND is_valid_order
    AND pd_orders_agg_accounting.created_date_utc <<>>current_date 
    ),
    customer_data AS ( 
  SELECT
    cus.code,
    cus.uuid,
    partner.customer_code,
    partner.field,
    partner.partner,
    partner.is_deleted joe_deleted
    ,cus.is_deleted customer_deleted,
    cus.global_entity_id,
     DATE_TRUNC(partner.created_at_utc,day) AS connected_date,
    (DATE_TRUNC(partner.updated_at_utc,day)) AS joe_updated_date,
     rw_promotions.title,
  FROM
    `fulfillment-dwh-production.pandata_curated.cus_customers` cus 
    LEFT JOIN
  `fulfillment-dwh-production.pandata_curated.cus_partner_details` AS partner
ON
  cus.global_entity_id = partner.global_entity_id
  AND cus.code = partner.customer_code
AND field= 'customer_id'
left join 
    `fulfillment-dwh-production.pandata_curated.rw_customer_promotions` as cus_promo 
    on cus_promo.global_entity_id = partner.global_entity_id
    and cus_promo.customer_code = partner.customer_code 
 left join `fulfillment-dwh-production.pandata_curated.rw_promotions` as rw_promotions
on rw_promotions.id = cus_promo.rw_promotion_id
and rw_promotions.global_entity_id = cus_promo.global_entity_id


    
    ),
    kpi as( 
select * from 
order_data
left join 
customer_data
on order_data.global_entity_id = customer_data.global_entity_id
and order_data.pd_customer_uuid = customer_data.uuid

    )



  SELECT
order_month,
case when partner = 'joe' then 'jö' else 'nonjö' end as partner,
order_uuid,
analytical_customer_id,
gfv_eur
,
gmv_eur,
delivery_fee_local,
discount_eur
,
is_acquisition,
joe_deleted,
connected_date,
joe_updated_date,
order_day,
title
  from kpi
  -- GROUP BY 
    -- 1,2
  order by order_month  desc]]></relation>
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
