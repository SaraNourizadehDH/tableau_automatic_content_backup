      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_7FFDCF46FACD478B8406B8410593256B'>
            <properties context=''>
              <relation connection='bigquery.0khdxx10esrot91e4egbn11hrxok' name='Custom SQL Query' type='text'>WITH&#13;
  customer_data AS(&#13;
  SELECT&#13;
    DISTINCT central_analytical_customer_id,&#13;
    global_entity_id,&#13;
    is_acquisition,&#13;
    last_order_date,&#13;
    next_order_date,&#13;
    first_valid_order,&#13;
    previous_last_order_date,&#13;
    order_created_date,&#13;
    order_code,&#13;
    EXTRACT(month&#13;
    FROM&#13;
      order_created_date) AS current_month_number,&#13;
    DATE_TRUNC(order_created_date,month) AS order_month,&#13;
    ROW_NUMBER() OVER (PARTITION BY central_analytical_customer_id ORDER BY order_created_date DESC) AS number,&#13;
  FROM&#13;
    `dha---bi-485.report_tables.customer_order_dates` )&#13;
  SELECT&#13;
    DISTINCT central_analytical_customer_id,&#13;
    global_entity_id,&#13;
    current_month_number,&#13;
    order_month,&#13;
    order_created_date,&#13;
    COUNT(DISTINCT order_code) AS orders,&#13;
  FROM&#13;
    customer_data --&#13;
  -- WHERE&#13;
    -- DATE_TRUNC(order_created_date,month)=DATE_TRUNC(report_date,month)&#13;
  GROUP BY&#13;
    1,&#13;
    2,&#13;
    3,&#13;
    4,&#13;
    5</relation>
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='customer_segmentation (march' inline='true' name='federated.0g5ffl21vcrtnc13sublm0xjjosg (copy)' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.02mcgtq09kte7417vrxfh106agno (copy)'>
            <connection CATALOG='dha---bi-485' EXECCATALOG='dha---bi-485' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='DHA - BI' schema='report_tables' server-oauth='' username='sirinthip.narula@foodora.at' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.02mcgtq09kte7417vrxfh106agno (copy)' name='Custom SQL Query' type='text'><![CDATA[WITH
  customer_data AS(
  SELECT
    global_entity_id,
    central_analytical_customer_id,
    customer_code,
    acquisition_orders,
    LAST_DAY(current_date) AS current_month,
    DATE_SUB(LAST_DAY(current_date),INTERVAL 2 month) AS last_month,
    DATE_SUB(LAST_DAY(current_date),INTERVAL 2 month) AS last2_month,
    MAX(last_order_date) AS last_order_date,
    SUM(acquisition_orders) AS acquisition_order,
    LAST_DAY(DATE_TRUNC(MAX(last_order_date),month)) AS last_order_month,
    MAX(second_last_order_date) AS second_last_order_date,
    MAX(third_last_order_date) AS third_last_order_date,
    MAX(first_valid_order) AS first_valid_order,
  FROM
    `dha---bi-485.report_tables.customer_order_dates_v2`
  WHERE
    last_order_date <<= DATE_SUB(LAST_DAY(current_date),INTERVAL 2 month)
    group by 1,2,3,4,5
    ),

  customer_age AS (
  SELECT
    DISTINCT central_analytical_customer_id,
    acquisition_orders,
    last_month,
    last_order_month,
    customer_data.last2_month,
    first_valid_order,
    last_order_date,
    second_last_order_date,
    DATE_DIFF(last_month, first_valid_order, day) AS diff_acquisition_date,
    DATE_DIFF(last_month,DATE(third_last_order_date), day) AS diff_third_last_order,
    DATE_DIFF(last_month, DATE(second_last_order_date), day) AS diff_second_last_order,
    DATE_DIFF(last_month, DATE(last_order_date), day) AS diff_last_order,
    DATE_DIFF(last2_month, first_valid_order, day) AS last2_diff_first_order,
    DATE_DIFF(last2_month,DATE(third_last_order_date), day) AS last2_diff_third_last_order,
    DATE_DIFF(last2_month, DATE(second_last_order_date), day) AS last2_diff_second_last_order,
    DATE_DIFF(last2_month, DATE(last_order_date), day) AS last2_diff_last_order,
    DATE_DIFF(last_month,last_order_month,month)
  FROM
    customer_data )
SELECT
  last_month,
  CASE
    WHEN DATE_DIFF(last_month,(DATE_TRUNC(first_valid_order,month)),month)=0 THEN 'acquisition '
    WHEN (DATE_DIFF(last_order_month, last_month,month) = 0 )
  AND (diff_second_last_order>>89
    OR diff_last_order>>89 ) THEN 'reactivated'
   
    WHEN (diff_second_last_order BETWEEN 29 AND 89 OR diff_last_order BETWEEN 29 AND 89 OR diff_second_last_order IS NULL ) AND (DATE_DIFF(last_month,last_order_month,month) BETWEEN 1 AND 3 ) THEN 'churning_90d'
    WHEN DATE_DIFF( last_month,last_order_month,month) >>= 3
  OR diff_last_order>> 89 THEN 'inactive'
      WHEN (DATE_DIFF(last_month,last_order_month,month) = 0 OR diff_last_order BETWEEN 0 AND 29) THEN 'active'
 
END
  AS current_customer_segment,
 central_analytical_customer_id ,
 
  COUNT(DISTINCT central_analytical_customer_id) AS customers,
FROM
  customer_age
GROUP BY
  1,2,3]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.02mcgtq09kte7417vrxfh106agno (copy)' name='Custom SQL Query' type='text'><![CDATA[WITH
  customer_data AS(
  SELECT
    global_entity_id,
    central_analytical_customer_id,
    customer_code,
    acquisition_orders,
    LAST_DAY(current_date) AS current_month,
    DATE_SUB(LAST_DAY(current_date),INTERVAL 2 month) AS last_month,
    DATE_SUB(LAST_DAY(current_date),INTERVAL 2 month) AS last2_month,
    MAX(last_order_date) AS last_order_date,
    SUM(acquisition_orders) AS acquisition_order,
    LAST_DAY(DATE_TRUNC(MAX(last_order_date),month)) AS last_order_month,
    MAX(second_last_order_date) AS second_last_order_date,
    MAX(third_last_order_date) AS third_last_order_date,
    MAX(first_valid_order) AS first_valid_order,
  FROM
    `dha---bi-485.report_tables.customer_order_dates_v2`
  WHERE
    last_order_date <<= DATE_SUB(LAST_DAY(current_date),INTERVAL 2 month)
    group by 1,2,3,4,5
    ),

  customer_age AS (
  SELECT
    DISTINCT central_analytical_customer_id,
    acquisition_orders,
    last_month,
    last_order_month,
    customer_data.last2_month,
    first_valid_order,
    last_order_date,
    second_last_order_date,
    DATE_DIFF(last_month, first_valid_order, day) AS diff_acquisition_date,
    DATE_DIFF(last_month,DATE(third_last_order_date), day) AS diff_third_last_order,
    DATE_DIFF(last_month, DATE(second_last_order_date), day) AS diff_second_last_order,
    DATE_DIFF(last_month, DATE(last_order_date), day) AS diff_last_order,
    DATE_DIFF(last2_month, first_valid_order, day) AS last2_diff_first_order,
    DATE_DIFF(last2_month,DATE(third_last_order_date), day) AS last2_diff_third_last_order,
    DATE_DIFF(last2_month, DATE(second_last_order_date), day) AS last2_diff_second_last_order,
    DATE_DIFF(last2_month, DATE(last_order_date), day) AS last2_diff_last_order,
    DATE_DIFF(last_month,last_order_month,month)
  FROM
    customer_data )
SELECT
  last_month,
  CASE
    WHEN DATE_DIFF(last_month,(DATE_TRUNC(first_valid_order,month)),month)=0 THEN 'acquisition '
    WHEN (DATE_DIFF(last_order_month, last_month,month) = 0 )
  AND (diff_second_last_order>>89
    OR diff_last_order>>89 ) THEN 'reactivated'
   
    WHEN (diff_second_last_order BETWEEN 29 AND 89 OR diff_last_order BETWEEN 29 AND 89 OR diff_second_last_order IS NULL ) AND (DATE_DIFF(last_month,last_order_month,month) BETWEEN 1 AND 3 ) THEN 'churning_90d'
    WHEN DATE_DIFF( last_month,last_order_month,month) >>= 3
  OR diff_last_order>> 89 THEN 'inactive'
      WHEN (DATE_DIFF(last_month,last_order_month,month) = 0 OR diff_last_order BETWEEN 0 AND 29) THEN 'active'
 
END
  AS current_customer_segment,
 central_analytical_customer_id ,
 
  COUNT(DISTINCT central_analytical_customer_id) AS customers,
FROM
  customer_age
GROUP BY
  1,2,3]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
