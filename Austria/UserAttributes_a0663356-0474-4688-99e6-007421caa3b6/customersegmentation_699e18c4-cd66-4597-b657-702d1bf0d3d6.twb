      <_.fcp.ObjectModelTableType.true...column caption='Custom SQL Query' datatype='table' name='[__tableau_internal_object_id__].[_CFF9C9327515454FB4D6A6E60ECBD275]' role='measure' type='quantitative' />
      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
      <field-sort-info field-sort-order-type='custom-order'>
        <field-sort-custom-order field='last2_month' />
        <field-sort-custom-order field='previous_customer_segment' />
        <field-sort-custom-order field='last_month' />
        <field-sort-custom-order field='current_customer_segment' />
        <field-sort-custom-order field='Calculation_698620916362436610' />
        <field-sort-custom-order field='central_analytical_customer_id' />
      </field-sort-info>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_CFF9C9327515454FB4D6A6E60ECBD275'>
            <properties context=''>
              <relation connection='bigquery.02mcgtq09kte7417vrxfh106agno (copy)' name='Custom SQL Query' type='text'><![CDATA[WITH
  customer_data AS(
  SELECT
    global_entity_id,
    central_analytical_customer_id,
    customer_code,
    acquisition_orders,
    LAST_DAY(current_date) AS current_month,
    DATE_SUB(LAST_DAY(current_date),INTERVAL 2 month) AS last_month,
    DATE_SUB(LAST_DAY(current_date),INTERVAL 2 month) AS last2_month,
    MAX(last_order_date) AS last_order_date,
    SUM(acquisition_orders) AS acquisition_order,
    LAST_DAY(DATE_TRUNC(MAX(last_order_date),month)) AS last_order_month,
    MAX(second_last_order_date) AS second_last_order_date,
    MAX(third_last_order_date) AS third_last_order_date,
    MAX(first_valid_order) AS first_valid_order,
  FROM
    `dha---bi-485.report_tables.customer_order_dates_v2`
  WHERE
    last_order_date <<= DATE_SUB(LAST_DAY(current_date),INTERVAL 2 month)
    group by 1,2,3,4,5
    ),

  customer_age AS (
  SELECT
    DISTINCT central_analytical_customer_id,
    acquisition_orders,
    last_month,
    last_order_month,
    customer_data.last2_month,
    first_valid_order,
    last_order_date,
    second_last_order_date,
    DATE_DIFF(last_month, first_valid_order, day) AS diff_acquisition_date,
    DATE_DIFF(last_month,DATE(third_last_order_date), day) AS diff_third_last_order,
    DATE_DIFF(last_month, DATE(second_last_order_date), day) AS diff_second_last_order,
    DATE_DIFF(last_month, DATE(last_order_date), day) AS diff_last_order,
    DATE_DIFF(last2_month, first_valid_order, day) AS last2_diff_first_order,
    DATE_DIFF(last2_month,DATE(third_last_order_date), day) AS last2_diff_third_last_order,
    DATE_DIFF(last2_month, DATE(second_last_order_date), day) AS last2_diff_second_last_order,
    DATE_DIFF(last2_month, DATE(last_order_date), day) AS last2_diff_last_order,
    DATE_DIFF(last_month,last_order_month,month)
  FROM
    customer_data )
SELECT
  last_month,
  CASE
    WHEN DATE_DIFF(last_month,(DATE_TRUNC(first_valid_order,month)),month)=0 THEN 'acquisition '
    WHEN (DATE_DIFF(last_order_month, last_month,month) = 0 )
  AND (diff_second_last_order>>89
    OR diff_last_order>>89 ) THEN 'reactivated'
   
    WHEN (diff_second_last_order BETWEEN 29 AND 89 OR diff_last_order BETWEEN 29 AND 89 OR diff_second_last_order IS NULL ) AND (DATE_DIFF(last_month,last_order_month,month) BETWEEN 1 AND 3 ) THEN 'churning_90d'
    WHEN DATE_DIFF( last_month,last_order_month,month) >>= 3
  OR diff_last_order>> 89 THEN 'inactive'
      WHEN (DATE_DIFF(last_month,last_order_month,month) = 0 OR diff_last_order BETWEEN 0 AND 29) THEN 'active'
 
END
  AS current_customer_segment,
 central_analytical_customer_id ,
 
  COUNT(DISTINCT central_analytical_customer_id) AS customers,
FROM
  customer_age
GROUP BY
  1,2,3]]></relation>
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
