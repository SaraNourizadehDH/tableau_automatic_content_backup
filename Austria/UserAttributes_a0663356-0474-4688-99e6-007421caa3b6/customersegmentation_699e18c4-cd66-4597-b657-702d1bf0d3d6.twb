            <column-instance column='[Calculation3]' derivation='User' name='[usr:Calculation3:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-field='[federated.0g2stjp03q71af10kf64e0kgaze7].[Calculation_656681142174273538]' ordering-type='Field' />
            </column-instance>
