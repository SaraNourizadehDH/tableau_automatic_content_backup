    <worksheet lock-quick-filters='true' name='table'>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (report_tables)' name='federated.0g2stjp03q71af10kf64e0kgaze7' />
          </datasources>
          <datasource-dependencies datasource='federated.0g2stjp03q71af10kf64e0kgaze7'>
            <column caption='MOM customer change' datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN([Calculation_656681142171947009]) - LOOKUP(ZN([Calculation_656681142171947009]), -1)) / ABS(LOOKUP(ZN([Calculation_656681142171947009]), -1))'>
                <table-calc ordering-field='[federated.0g2stjp03q71af10kf64e0kgaze7].[none:Calculation_656681142174273538:nk]' ordering-type='Field' />
              </calculation>
            </column>
            <column caption='Orders%' datatype='real' default-format='p0.00%' name='[Calculation2]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders]) / TOTAL(SUM([orders]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Customer%' datatype='real' default-format='p0.00%' name='[Calculation3]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_656681142171947009] / TOTAL([Calculation_656681142171947009])'>
                <table-calc ordering-field='[federated.0g2stjp03q71af10kf64e0kgaze7].[Calculation_656681142174273538]' ordering-type='Field' />
              </calculation>
            </column>
            <column caption='Customers' datatype='integer' name='[Calculation_656681142171947009]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([central_analytical_customer_id])' />
            </column>
            <column caption='Frequency group' datatype='string' name='[Calculation_656681142174273538]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If ([Calculation_656681142179450884]&gt;=0 and [Calculation_656681142179450884]&lt;=1) THEN &apos;0-1&apos; &#13;&#10;ELSEIF([Calculation_656681142179450884]&gt;1 and [Calculation_656681142179450884]&lt;=3) then &apos;1-3&apos;&#13;&#10;ELSEIF ([Calculation_656681142179450884]&gt;3 and [Calculation_656681142179450884]&lt;=4) then &apos;3-4&apos;&#13;&#10;ELSEIF ([Calculation_656681142179450884]&gt;4 and [Calculation_656681142179450884]&lt;=6) then &apos;4-6&apos;&#13;&#10;ELSEIF ([Calculation_656681142179450884]&gt;6 and [Calculation_656681142179450884]&lt;= 8) then &apos;6-8&apos;&#13;&#10;ELSEIF ([Calculation_656681142179450884]&gt;8 and [Calculation_656681142179450884]&lt;=10) then &apos;8-10&apos;&#13;&#10;ELSEIF ([Calculation_656681142179450884]&gt;10) then &apos;10+&apos; &#13;&#10;END' />
            </column>
            <column caption='Frequency' datatype='real' name='[Calculation_656681142179450884]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [central_analytical_customer_id],DATETRUNC(&apos;month&apos;,[order_created_date]):SUM([orders])/COUNTD([central_analytical_customer_id])}' />
            </column>
            <column datatype='string' name='[central_analytical_customer_id]' role='dimension' type='nominal' />
            <column-instance column='[order_created_date]' derivation='MY' name='[my:order_created_date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_656681142174273538]' derivation='None' name='[none:Calculation_656681142174273538:nk]' pivot='key' type='nominal' />
            <column-instance column='[order_created_date]' derivation='None' name='[none:order_created_date:qk]' pivot='key' type='quantitative' />
            <column datatype='datetime' name='[order_created_date]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[orders]' role='measure' type='quantitative' />
            <column-instance column='[orders]' derivation='Sum' name='[sum:orders:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation1]' derivation='User' name='[usr:Calculation1:qk:3]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Field'>
                <order field='[federated.0g2stjp03q71af10kf64e0kgaze7].[Calculation_656681142174273538]' />
                <order field='[federated.0g2stjp03q71af10kf64e0kgaze7].[my:order_created_date:ok]' />
              </table-calc>
            </column-instance>
            <column-instance column='[Calculation2]' derivation='User' name='[usr:Calculation2:qk:2]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Columns' />
