        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0khdxx10esrot91e4egbn11hrxok' name='Custom SQL Query' type='text'>WITH&#13;
  customer_data AS(&#13;
  SELECT&#13;
    DISTINCT central_analytical_customer_id,&#13;
    global_entity_id,&#13;
    is_acquisition,&#13;
    last_order_date,&#13;
    next_order_date,&#13;
    first_valid_order,&#13;
    previous_last_order_date,&#13;
    order_created_date,&#13;
    order_code,&#13;
    EXTRACT(month&#13;
    FROM&#13;
      order_created_date) AS current_month_number,&#13;
    DATE_TRUNC(order_created_date,month) AS order_month,&#13;
    ROW_NUMBER() OVER (PARTITION BY central_analytical_customer_id ORDER BY order_created_date DESC) AS number,&#13;
  FROM&#13;
    `dha---bi-485.report_tables.customer_order_dates` )&#13;
  SELECT&#13;
    DISTINCT central_analytical_customer_id,&#13;
    global_entity_id,&#13;
    current_month_number,&#13;
    order_month,&#13;
    order_created_date,&#13;
    COUNT(DISTINCT order_code) AS orders,&#13;
  FROM&#13;
    customer_data --&#13;
  -- WHERE&#13;
    -- DATE_TRUNC(order_created_date,month)=DATE_TRUNC(report_date,month)&#13;
  GROUP BY&#13;
    1,&#13;
    2,&#13;
    3,&#13;
    4,&#13;
    5</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0khdxx10esrot91e4egbn11hrxok' name='Custom SQL Query' type='text'>WITH&#13;
  customer_data AS(&#13;
