            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dha---bi-485' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='curated_data_shared' server-oauth='' username='sirinthip.narula@foodora.at' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1xmdjdx1yf5lbp1du8ny1128ygp1' name='Custom SQL Query' type='text'><![CDATA[with data as (
SELECT
  DISTINCT pd_orders.uuid AS order_uuid,
  dwho.analytical_customer_id,
  pd_orders_agg_accounting.gmv_eur AS gmv_eur,
  pd_orders_agg_accounting.gfv_eur AS gfv_eur,
  date_trunc(pd_orders.created_at_utc,month) as month,
  minimum_delivery_value_local as mov
FROM
  `fulfillment-dwh-production.pandata_curated.pd_orders` AS pd_orders
LEFT JOIN
  `fulfillment-dwh-production.pandata_report.regional_eu__pd_orders_agg_accounting` AS pd_orders_agg_accounting
ON
  pd_orders_agg_accounting.uuid = pd_orders.uuid
  AND pd_orders_agg_accounting.created_date_utc BETWEEN date_sub(date_trunc(current_date,month),interval 3 month)
    AND current_date
LEFT JOIN
  `fulfillment-dwh-production.curated_data_shared_central_dwh.orders` dwho
ON
  dwho.order_id=pd_orders.code
  AND dwho.global_entity_id=pd_orders.global_entity_id
  AND dwho.placed_at_local BETWEEN date_sub(date_trunc(current_date,month),interval 3 month)
    AND current_date
  AND DATE(dwho.placed_at)BETWEEN date_sub(date_trunc(current_date,month),interval 3 month)
    AND current_date
WHERE
  pd_orders.global_entity_id = 'MJM_AT'
  and pd_orders.is_valid_order
  and dwho.is_sent
  AND pd_orders.created_date_utc BETWEEN date_sub(date_trunc(current_date,month),interval 3 month)
    AND current_date)

  select 
distinct 
case when avg(gfv_eur) <<= 2 then '<<=2' 
when avg(gfv_eur) <<= 4 then '<<=4' 
when avg(gfv_eur) <<= 6 then '<<=6' 
when avg(gfv_eur) <<= 8 then '<<=8' 
when avg(gfv_eur) <<= 10 then '<<=10' 
when avg(gfv_eur) <<= 12 then '<<=12' 
when avg(gfv_eur) <<= 14 then '<<=14' 
when avg(gfv_eur) <<= 16 then '<<=16'
when avg(gfv_eur) <<= 18 then '<<=18' 
when avg(gfv_eur) <<= 20 then '<<=20' 
when avg(gfv_eur) <<= 22 then '<<=22' 
when avg(gfv_eur) <<= 24 then '<<=24' 
when avg(gfv_eur) <<= 26 then '<<=26' 
when avg(gfv_eur) <<= 28 then '<<=28' 
when avg(gfv_eur) <<= 30 then '<<=30' 
when avg(gfv_eur) <<= 32 then '<<=32' 
when avg(gfv_eur) <<= 34 then '<<=34' 
when avg(gfv_eur) <<= 36 then '<<=36'
when avg(gfv_eur) <<= 38 then '<<=38' 
when avg(gfv_eur) <<= 40 then '<<=40' 
when avg(gfv_eur) <<= 42 then '<<=42' 
when avg(gfv_eur) <<= 44 then '<<=44' 
when avg(gfv_eur) <<= 46 then '<<=46' 
when avg(gfv_eur) <<= 48 then '<<=48' 
when avg(gfv_eur) <<= 50 then '<<=50' 
else '>>50' end as afv_bucket, 
count (distinct order_uuid) as orders,
analytical_customer_id,
gfv_eur,
order_uuid,
month,
mov
  from data 
  group by 3,4,5,6,7
  order by 1]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
