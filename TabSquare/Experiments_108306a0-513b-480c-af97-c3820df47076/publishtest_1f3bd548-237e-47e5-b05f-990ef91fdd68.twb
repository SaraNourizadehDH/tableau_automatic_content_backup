  <datasources>
    <datasource caption='test' inline='true' name='federated.19h8abu1ae8es61a92dsh1w320dy' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.04gwbzt1cq1ms613jnprr16s8ldx'>
            <connection CATALOG='tabsquare-data-sciences' EXECCATALOG='tabsquare-data-sciences' authentication='auth-oauth-service-account' class='bigquery' connection-dialect='google-sql' project='tabsquare-data-sciences' schema='skipque_cdc_data_prod' server-oauth='server-custom' username='data-team-tableau@tabsquare-data-sciences.iam.gserviceaccount.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.04gwbzt1cq1ms613jnprr16s8ldx' name='Custom SQL Query' type='text'>SELECT ifnull(U.country,C.name) as Country
from `tabsquare-data-sciences.skipque_cdc_data_prod.orders` O
left join `tabsquare-data-sciences.dashboard_validation_data.user_login` ul
on cast(O.restaurant_id as string) = ul.restaurant_id
left join `tabsquare-data-sciences.skipque_cdc_data_prod.users` U
on o.restaurant_id = U.id
left join `tabsquare-data-sciences.skipque_cdc_data_prod.organization` org
on o.restaurant_id = org.id
left join `tabsquare-data-sciences.skipque_cdc_data_prod.country` C
on org.country_id = C.id
LEFT JOIN `tabsquare-data-sciences.skipque_cdc_data_prod.order_payments` op
ON O.id = op.order_id
LEFT JOIN `tabsquare-data-sciences.skipque_cdc_data_prod.smartweb_payment_transactions` spt
ON O.id = spt.order_id 
LEFT JOIN `tabsquare-data-sciences.skipque_cdc_data_prod.stripe_merchant_payout_details` smpd
on cast(spt.order_id as string)= smpd.order_id
LEFT JOIN `tabsquare-data-sciences.skipque_cdc_data_prod.stripe_merchant_payouts` smp
on smpd.payout_id = smp.payout_id 
LEFT JOIN `tabsquare-data-sciences.skipque_cdc_data_prod.rapyd_payment_transactions` rpt
on op.order_id = rpt.order_id
LEFT JOIN `tabsquare-data-sciences.skipque_cdc_data_prod.rapyd_payout_details` rpd
on rpt.order_id = rpd.order_id
LEFT JOIN `tabsquare-data-sciences.skipque_cdc_data_prod.rapyd_payouts` rp
on rpd.payout_id = rp.id
LEFT JOIN `tabsquare-data-sciences.skipque_cdc_data_prod.order_refund` odr
on op.order_id = odr.order_id 
LEFT JOIN `tabsquare-data-sciences.skipque_cdc_data_prod.payment_webhook_config` pwc
on pwc.Merchant_key = ul.merchant_id 
LEFT JOIN `tabsquare-data-sciences.skipque_cdc_data_prod.chain_setting` cs
on cs.organization_id = org.id
LEFT JOIN `tabsquare-data-sciences.skipque_cdc_data_prod.smartweb_settings` sws
on sws.created_by = U.id
LEFT JOIN `tabsquare-data-sciences.skipque_cdc_data_prod.smartweb_stripe_config` ssc
on lower(ssc.country) =lower(U.country)
LEFT JOIN `tabsquare-data-sciences.skipque_cdc_data_prod.smartweb_stripe_config` ssc2
on lower(ssc2.country) =lower(C.name)
where spt.payment_type in 
(&apos;rapyd&apos;,&apos;Rapyd_bank_transfer&apos;,&apos;RAPYD_BANK_TRANSFER&apos;,
&apos;RAPYD_BANK_REDIRECT&apos;,&apos;RAPYD_EWALLET&apos;,&apos;Rapyd_ewallet&apos;,&apos;RAPYD&apos;,&apos;Rapyd_bank_redirect&apos;,
&apos;stripe_fpx&apos;,&apos;STRIPE&apos;,&apos;stripe&apos;,&apos;Stripe&apos;,&apos;STRIPE_FPX&apos;) 
AND o.status NOT IN (-3,-4,0) and op.status = 3 AND o.is_void=0 AND o.app_type in (4,5,10)</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.04gwbzt1cq1ms613jnprr16s8ldx' name='Custom SQL Query' type='text'>SELECT ifnull(U.country,C.name) as Country
