      <table>
        <view>
          <datasources>
            <datasource caption='expected repeat datasource' name='federated.06uwwzn1yrn2zb11pzj2w1h8x1q1' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency Conversion' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;SGD&quot;'>
              <calculation class='tableau' formula='&quot;SGD&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.06uwwzn1yrn2zb11pzj2w1h8x1q1'>
            <column caption='Conversion Factor (mod)' datatype='real' name='[Calculation_1229764177101324296]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1]=&apos;SGD&apos; then [conversion_factor]&#10;else 1 end' />
            </column>
            <column caption='Expected Repeat Type' datatype='string' name='[Calculation_5367446373324607488]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [predicted_new]=1 and [repeat_type]=&apos;new&apos; and [global_repeat_type]=&apos;repeat&apos; then &apos;Expected Repeat&apos;&#10;else [repeat_type] end' />
            </column>
            <column caption='For you accepted flag (order_id)' datatype='integer' name='[Calculation_691513652404211713]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [order_id_mod]: max([for_you_flag])}' />
            </column>
            <column caption='Date (sgt_datetime)' datatype='date' name='[Calculation_691513652405370884]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='date([sgt_datetime])' />
            </column>
            <column caption='For You Accepted Order count (cohorts)' datatype='integer' name='[Calculation_691513652405432325]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [merchant_id], [Calculation_691513652405370884], [customer_type], [global_repeat_type], [repeat_type],[Calculation_5367446373324607488]:&#10;countd(if [Calculation_691513652404211713]&gt;0 then [order_id_mod] end)}' />
            </column>
            <column caption='For You Accepted Check Size (cohorts)' datatype='real' name='[Calculation_691513652406591495]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[For You Accepted Order count (copy)_691513652406308870]/[Calculation_691513652405432325]' />
            </column>
            <column caption='No AI Order Count (cohorts)' datatype='integer' name='[Calculation_691513652409069576]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [merchant_id], [Calculation_691513652405370884], [customer_type], [global_repeat_type], [repeat_type]:&#10;countd(if [Calculation_691513652404211713]&lt;=0 then [order_id_mod] end)}' />
            </column>
            <column caption='No AI Check Size (cohorts)' datatype='real' name='[Calculation_691513652409458698]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[No AI Order Count (merchant_id, date) (copy)_691513652409319433]/[Calculation_691513652409069576]' />
            </column>
            <column caption='Total Sales (cohorts)' datatype='real' name='[Calculation_691513652414824459]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [merchant_id], [Calculation_691513652405370884], [customer_type], [global_repeat_type], [repeat_type],[Calculation_5367446373324607488]:&#10;sum([sales]*[Calculation_1229764177101324296])}' />
            </column>
            <column caption='for You $ incremental (merchant_id, date)' datatype='real' name='[Calculation_691513652418912270]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;ifnull([Calculation_691513652406591495],0)&#10;-&#10;ifnull([Calculation_691513652409458698],[Calculation_691513652698431523])&#10;)&#10;*&#10;ifnull([Calculation_691513652405432325],0)' />
            </column>
            <column caption='No Ai Check size (backcalc)' datatype='real' name='[Calculation_691513652420358159]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;sum([Calculation_691513652414824459])&#10;- &#10;sum(ifnull([Calculation_691513652418912270],0))&#10;)&#10;/&#10;(&#10;sum([Total Sales (merchant_id, date) (copy)_691513652414963724])&#10;)&#10;//sum([Total Order count (merchant_id, date, customer_types) ])' />
            </column>
            <column caption='For You Check size (backcalc)' datatype='real' name='[Calculation_691513652420575248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;sum(ifnull([Calculation_691513652418912270],0))&#10;/&#10;sum(ifnull([Calculation_691513652405432325],0))&#10;)&#10;+&#10;ifnull([Calculation_691513652420358159],0)' />
            </column>
            <column caption='% Incremental Check size (backcalc)' datatype='real' name='[Calculation_691513652421017617]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;[Calculation_691513652420575248] &#10;- &#10;[Calculation_691513652420358159]&#10;)&#10;/&#10;[Calculation_691513652420358159]' />
            </column>
            <column caption='No AI Check Size (for imputation)' datatype='real' name='[Calculation_691513652698431523]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/*&#10;{fixed [Merchant Id], [Date (sgt_datetime)]:&#10;sum(if [For you accepted flag (order_id)]&lt;=0 then [Conversion Factor]*[Sales] end)&#10;/&#10;countd(if [For you accepted flag (order_id)]&lt;=0 then [Order Id Mod] end)&#10;}&#10;&#10;[For You Accepted Check Size (merchant_id, date, customer types)] -&#10;0.25*[For You Accepted Check Size (merchant_id, date, customer types)]&#10;*/&#10;&#10;{fixed [merchant_id], [Calculation_691513652405370884], [customer_type], [global_repeat_type], [repeat_type], [Calculation_5367446373324607488]:&#10;sum(if [for_you_flag]=0 then [Calculation_1229764177101324296]*[sales] end)&#10;/&#10;countd(if [for_you_flag]=0 then [order_id_mod] end)&#10;}' />
