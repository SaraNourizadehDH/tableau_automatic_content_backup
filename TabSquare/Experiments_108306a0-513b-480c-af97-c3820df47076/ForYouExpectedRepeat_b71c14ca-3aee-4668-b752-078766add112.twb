      <object-graph>
        <objects>
          <object caption='for_you' id='for_you_00C02C27C2E14525AC5A311D2F79A42B'>
            <properties context=''>
              <relation connection='bigquery.1o3i8sw0vf8f0d10r46ui1mfrw9q' name='Custom SQL Query' type='text'>SELECT `for_you`.`conversion_factor` AS `conversion_factor`,&#10;  `for_you`.`country` AS `country`,&#10;  `for_you`.`currency_type` AS `currency_type`,&#10;  `for_you`.`customer_id` AS `customer_id`,&#10;  `for_you`.`customer_type` AS `customer_type`,&#10;  `for_you`.`date` AS `date`,&#10;  `for_you`.`empty_response_flag` AS `empty_response_flag`,&#10;  `for_you`.`for_you_flag` AS `for_you_flag`,&#10;  `for_you`.`for_you_reco_flag` AS `for_you_reco_flag`,&#10;  `for_you`.`for_you_reco_response_flag` AS `for_you_reco_response_flag`,&#10;  `for_you`.`for_you_reorder_flag` AS `for_you_reorder_flag`,&#10;  `for_you`.`for_you_reorder_response_flag` AS `for_you_reorder_response_flag`,&#10;  `for_you`.`for_you_response_flag` AS `for_you_response_flag`,&#10;  `for_you`.`for_you_top_trending_flag` AS `for_you_top_trending_flag`,&#10;  `for_you`.`for_you_top_trending_response_flag` AS `for_you_top_trending_response_flag`,&#10;  `for_you`.`global_repeat_type` AS `global_repeat_type`,&#10;  `for_you`.`menu_mode` AS `menu_mode`,&#10;  `for_you`.`merchant_id` AS `merchant_id`,&#10;  `for_you`.`merchant_name` AS `merchant_name`,&#10;  `for_you`.`order_datetime` AS `order_datetime`,&#10;  `for_you`.`order_id` AS `order_id`,&#10;  `for_you`.`order_id_mod` AS `order_id_mod`,&#10;  `for_you`.`order_no_mod` AS `order_no_mod`,&#10;  `for_you`.`order_type` AS `order_type`,&#10;  `for_you`.`organization_id` AS `organization_id`,&#10;  `for_you`.`repeat_flag` AS `repeat_flag`,&#10;  `for_you`.`repeat_type` AS `repeat_type`,&#10;  `for_you`.`sales` AS `sales`,&#10;  `for_you`.`sgt_datetime` AS `sgt_datetime`,&#10;  `for_you`.`test_type` AS `test_type`,&#10;  `for_you`.`time_zone` AS `time_zone`,&#10;  coalesce(predicted_new,0) as predicted_new &#10;FROM `tabsquare-data-sciences.tabsquare_dw_ai_measurement`.`for_you` &#10;inner join&#10;(select merchant_id &#10;from&#10;`tabsquare-data-sciences.tabsquare_dw_ai_prod.affinity_overlap_customer_list` &#10;group by 1&#10;) merch&#10;on for_you.merchant_id = merch.merchant_id&#10;left join&#10;(select customer_id,merchant_id,1 as predicted_new,&apos;2022-05-18&apos; as overlap_start_date&#10;from&#10;`tabsquare-data-sciences.tabsquare_dw_ai_prod.affinity_overlap_customer_list` &#10; ) overlap&#10;on for_you.merchant_id = overlap.merchant_id&#10;and for_you.customer_id = cast(overlap.customer_id as string)&#10;and for_you.date&gt;&gt;=overlap.overlap_start_date&#10;where date(sgt_datetime)&gt;&gt;=&apos;2021-03-01&apos;</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
