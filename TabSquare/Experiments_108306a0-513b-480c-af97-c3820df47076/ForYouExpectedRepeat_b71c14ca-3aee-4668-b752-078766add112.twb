              <calculation class='tableau' formula='COUNTD([order_id_mod])+0' />
            </column>
            <column caption='Expected Repeat Type' datatype='string' name='[Calculation_5367446373324607488]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [predicted_new]=1 and [repeat_type]=&apos;new&apos; and [global_repeat_type]=&apos;repeat&apos; then &apos;Expected Repeat&apos;&#10;else [repeat_type] end' />
            </column>
            <column caption='For you accepted flag (order_id)' datatype='integer' name='[Calculation_691513652404211713]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [order_id_mod]: max([for_you_flag])}' />
