          <alias key='&quot;[federated.0tn0ga00ucokc81blgggt16wzxdm].[pcto:ctd:order_id:qk:2]&quot;' value='% of Orders' />
          <alias key='&quot;[federated.0tn0ga00ucokc81blgggt16wzxdm].[sum:total_amount:qk]&quot;' value='GMV' />
        </aliases>
      </column>
      <column caption='% Count of Orders' datatype='real' default-format='p0.00%' name='[Calculation_1011621075298213891]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([id])/SUM({FIXED DATE([created_date]): COUNTD([id])})' />
      </column>
      <column aggregation='Sum' caption='restaurant failure' datatype='integer' name='[Calculation_1415819145026457602]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if [order_result] = 0 then [restaurant_id] END' />
      </column>
      <column caption='Selected Time Interval' datatype='date' name='[Calculation_1610318375916916738]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 4]=&apos;Year&apos; then date(DATETRUNC(&apos;year&apos;, [created_date]))&#13;&#10;ELSEIF [Parameters].[Parameter 4]=&apos;Quarter&apos; then date(DATETRUNC(&apos;quarter&apos;, [created_date]))&#13;&#10;elseif [Parameters].[Parameter 4]=&apos;Month&apos; then date(DATETRUNC(&apos;month&apos;, [created_date]))&#13;&#10;elseif [Parameters].[Parameter 4]=&apos;Week&apos; then date(DATETRUNC(&apos;week&apos;, [created_date]))&#13;&#10;elseif [Parameters].[Parameter 4]=&apos;Day&apos; then date(DATETRUNC(&apos;day&apos;, [created_date]))&#13;&#10;end' />
      </column>
      <column caption='Orders Table Status' datatype='string' name='[Calculation_1610318375926644744]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [orders_table_status]= -4 then &apos;TEMP_ORDER(-4)&apos;&#13;&#10;elseif [orders_table_status]= -3 then &apos;REJECTED(-3)&apos;&#13;&#10;elseif [orders_table_status]= -2 then &apos;STATUS_UNPAID_ORDER(-2)&apos;&#13;&#10;elseif [orders_table_status]= 0 then &apos;UNCOMFIRMED_ORDER(0)&apos;&#13;&#10;elseif [orders_table_status]= 1 then &apos;NEW ORDER/ CONFIRMED ORDER(1)&apos;&#13;&#10;elseif [orders_table_status]= 2 then &apos;READY(2)&apos;&#13;&#10;elseif [orders_table_status]= 3 then &apos;CLOSED(3)&apos;&#13;&#10;elseif [orders_table_status]= 6 then &apos;REFUNDED(6)&apos;&#13;&#10;elseif [orders_table_status]= 7 then &apos;DRIVER_ASSIGNED(7)&apos;&#13;&#10;else &apos;Others&apos;&#13;&#10;END' />
      </column>
      <column caption='failure orders percentage' datatype='real' name='[Calculation_1702923620634353664]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(if [order_result]= 0 then [id] end)/ countd(id)' />
      </column>
      <column caption='Date Range' datatype='boolean' name='[Calculation_553098335375880192]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[created_date]&gt;= [Parameters].[Parameter 1] and [created_date]&lt;= [Parameters].[Parameter 2]' />
      </column>
      <column caption='failure' datatype='integer' name='[Calculation_732890482154065920]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(if [order_result]= 0 then [id] end)' />
      </column>
      <column caption='index' datatype='integer' name='[Calculation_732890482172854278]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Selected Time Period' datatype='date' name='[Calculation_732890482374787098]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='date(&#10;if [Parameters].[Parameter 3]=&apos;Month&apos; then DATETRUNC(&apos;month&apos;, [created_date])&#10;elseif [Parameters].[Parameter 3]=&apos;Week&apos; then DATETRUNC(&apos;week&apos;, [created_date])&#10;elseif [Parameters].[Parameter 3]=&apos;Day&apos; then DATETRUNC(&apos;day&apos;, [created_date])&#10;end)' />
      </column>
      <column caption='middleware integrated' datatype='string' name='[Calculation_732890482419118115]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [middleware_integrated] = 0 then &quot;Middleware Not Integrated&quot;&#10;ELSEIF [middleware_integrated] = 1 then &quot;Middleware Integrated&quot;&#10;ELSE Null&#10;END' />
      </column>
      <column caption='integration types' datatype='string' name='[Calculation_732890482419535908]' role='dimension' type='nominal'>
