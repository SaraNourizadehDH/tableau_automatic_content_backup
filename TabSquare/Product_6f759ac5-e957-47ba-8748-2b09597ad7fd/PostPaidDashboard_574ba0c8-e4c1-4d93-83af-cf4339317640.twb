          <named-connection caption='BigQuery' name='bigquery.0k4q9l01a47heo1817gba15wfgjv'>
            <connection CATALOG='tabsquare-data-sciences' EXECCATALOG='tabsquare-data-sciences' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tabsquare-data-sciences' schema='skipque_cdc_data_prod' server-oauth='' username='akshay.r@deliveryhero.in' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0k4q9l01a47heo1817gba15wfgjv' name='Custom SQL Query' type='text'>select spt.id, spt.order_id, spt.session_id, spt.status, o.status as order_status,&#13;
spt.restaurant_id, org.merchant_key, org.name as merchant_name,&#13;
o.currency_symbol,o.order_amount,&#13;
case when o.currency_symbol = &apos;MYR&apos; then round(o.order_amount*0.33, 2) &#13;
when o.currency_symbol =&apos;IDR&apos; then round(o.order_amount*0.000092, 2)&#13;
when o.currency_symbol =&apos;Rp&apos; then round(o.order_amount*0.000092, 2) &#13;
when o.currency_symbol = &apos;AUD&apos; then round(o.order_amount*1, 2)&#13;
when o.currency_symbol = &apos;BND&apos; then round(o.order_amount*1, 2)&#13;
when o.currency_symbol = &apos;GBP&apos; then round(o.order_amount*1.86985, 2)&#13;
when o.currency_symbol = &apos;NZD&apos; then round(o.order_amount*0.92, 2)&#13;
when o.currency_symbol = &apos;PHP&apos; then round(o.order_amount*0.028, 2)&#13;
when o.currency_symbol = &apos;HKD&apos; then round(o.order_amount*0.17, 2)&#13;
when o.currency_symbol = &apos;EUR&apos; then round(o.order_amount*1.61, 2)&#13;
when o.currency_symbol = &apos;THB&apos; then round(o.order_amount*0.041, 2)&#13;
when o.currency_symbol = &apos;USD&apos; then round(o.order_amount*1.34386, 2)&#13;
when o.currency_symbol = &apos;TWD&apos; then round(o.order_amount*0.047, 2)&#13;
WHEN o.currency_symbol = &apos;Â£&apos; then round(o.order_amount*1.61, 2)&#13;
when o.currency_symbol = &apos;AED&apos; then round(o.order_amount*0.37, 2)&#13;
else round(o.order_amount, 2) end as converted_order_amount,&#13;
spt.total, &#13;
round(spt.total*0.36, 2) as converted_total_amount,&#13;
spt.commission_fee, round(spt.commission_fee*0.36, 2) as converted_commission_amount,&#13;
DATE(spt.created_date, &apos;Singapore&apos;) as created_date, &#13;
DATETIME(spt.created_date, &apos;Singapore&apos;) as sg_date_time&#13;
from `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_smartweb_payment_transactions_view_prod` as spt&#13;
LEFT JOIN `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_orders_view_prod` as o on spt.order_id = o.id&#13;
left join `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_organization_view_prod` as org on spt.restaurant_id = org.id&#13;
where DATE(spt.created_date, &apos;Singapore&apos;) &gt;&gt;= &apos;2022-12-01&apos; and spt.status &gt;&gt; 0&#13;
order by DATE(spt.created_date, &apos;Singapore&apos;) desc</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0k4q9l01a47heo1817gba15wfgjv' name='Custom SQL Query' type='text'>select spt.id, spt.order_id, spt.session_id, spt.status, o.status as order_status,&#13;
