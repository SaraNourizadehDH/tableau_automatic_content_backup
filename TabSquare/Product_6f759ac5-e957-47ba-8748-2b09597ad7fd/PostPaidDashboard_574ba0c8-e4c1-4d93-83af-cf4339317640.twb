else round(o.order_amount, 2) end as converted_order_amount,&#13;
spt.total, &#13;
round(spt.total*0.36, 2) as converted_total_amount,&#13;
spt.commission_fee, round(spt.commission_fee*0.36, 2) as converted_commission_amount,&#13;
DATE(spt.created_date, &apos;Singapore&apos;) as created_date, &#13;
