      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1naa8he0efma2b1ampa0g0ys1tgk].[cnt:Calculation_2467409647131299847:qk]&quot;' value='Order Count' />
          <alias key='&quot;[federated.1naa8he0efma2b1ampa0g0ys1tgk].[sum:Calculation_2467409647127814149:qk]&quot;' value='Total Orders' />
        </aliases>
      </column>
      <column caption='Latest Start Date' datatype='date' name='[Calculation_2467409647116730368]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='{fixed: max(date(DATETRUNC(&apos;day&apos;, [Calculation_2467409647116771329] - 6)))}' />
      </column>
      <column caption='Latest End Date' datatype='date' name='[Calculation_2467409647116771329]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{fixed :max(date(DATEADD(&apos;day&apos;,-1,{fixed: max([created_date])})))}' />
      </column>
      <column aggregation='Sum' caption='Current Time Period' datatype='integer' name='[Calculation_2467409647117320195]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [created_date]&gt;=[Parameters].[Parameter 1] and [created_date]&lt;=[Parameters].[Parameter 2] then 1 else 0 end' />
      </column>
      <column caption='% of Payments' datatype='real' name='[Calculation_2467409647122227204]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_2467409647127814149])/sum([Calculation_2467409647130013702])) * 100' />
      </column>
      <column caption='Total' datatype='real' name='[Calculation_2467409647127814149]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [restaurant_id] IN (9816, 6738, 7487, 10806, 11207, 11369, 11822, 11821, 6885, 11880, 11240, 11948, 6248, 100301) and [order_id] = 0 THEN [converted_total_amount] END' />
      </column>
      <column caption='Order_Amt' datatype='real' name='[Calculation_2467409647130013702]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [restaurant_id] IN (9816, 6738, 7487, 10806, 11207, 11369, 11821, 11822, 6885, 11880, 11240, 11948, 6248, 100301) and [order_status] &gt;  0 THEN [converted_order_amount] END' />
      </column>
      <column aggregation='Count' caption='SPT ID' datatype='integer' name='[Calculation_2467409647131299847]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [restaurant_id] IN (9816, 6738, 7487, 10806, 11207, 11369, 11821, 11822, 6885, 11880, 11240, 11948, 6248, 100301)&#13;&#10;and [order_id] = 0&#13;&#10;THEN [id]&#13;&#10;END' />
      </column>
      <column caption='Commission Fees' datatype='real' name='[Calculation_2467409647131832328]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [restaurant_id] IN (9816, 6738, 7487, 10806, 11207, 11369, 11822, 11821, 6885, 11880, 11240, 11948, 6248, 100301)&#13;&#10;and [order_id]= 0&#13;&#10;THEN [converted_commission_amount]&#13;&#10;END' />
      </column>
      <column caption='Restaurant' datatype='string' name='[Calculation_2467409647140192265]' role='dimension' type='nominal'>
