from `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_smartweb_payment_transactions_view_prod` as spt&#13;
LEFT JOIN `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_orders_view_prod` as o on spt.order_id = o.id&#13;
left join `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_organization_view_prod` as org on spt.restaurant_id = org.id&#13;
where DATE(spt.created_date, &apos;Singapore&apos;) &gt;&gt;= &apos;2022-12-01&apos; and spt.status &gt;&gt; 0&#13;
order by DATE(spt.created_date, &apos;Singapore&apos;) desc</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
