            <connection CATALOG='tabsquare-data-sciences' EXECCATALOG='tabsquare-805d0' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tabsquare-data-sciences' schema='emenu_events' server-oauth='server-custom' username='ashish@tabsquare.com' workgroup-auth-mode='prompt' />
