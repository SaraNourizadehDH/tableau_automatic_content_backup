          <datasource-dependencies datasource='federated.1eiynth0w7d6ye1djswcd0x9bv0x'>
            <column datatype='string' name='[BrandName]' role='dimension' type='nominal' />
            <column caption='Latest Start Date' datatype='date' name='[Calculation_1431018826177085440]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='{fixed: max(date(DATETRUNC(&apos;day&apos;, [Calculation_1431018826177130497] - 6)))}' />
            </column>
            <column caption='Latest End Date' datatype='date' name='[Calculation_1431018826177130497]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{fixed :max(date(DATEADD(&apos;day&apos;,-1,{fixed: max([date])})))}' />
            </column>
            <column caption='Current Time Period' datatype='integer' name='[Calculation_1431018826178039810]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [date] &gt;= [Parameters].[Parameter 1]&#13;&#10;AND &#13;&#10;[date] &lt;= [Parameters].[Parameter 2] &#13;&#10;THEN 1 &#13;&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column caption='Week with Date Range' datatype='string' name='[Calculation_1431018826180124675]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(DATEPART(&apos;year&apos;, [date])) + &quot;-Week &quot; &#13;&#10;+ STR(DATEPART(&apos;week&apos;, [date])) + &quot;: &quot;&#13;&#10;+ STR(DATE(DATETRUNC(&apos;week&apos;, [date]))) + &quot; - &quot; +&#13;&#10;STR(DATE(DATETRUNC(&apos;week&apos;, [date]) +6))' />
            </column>
