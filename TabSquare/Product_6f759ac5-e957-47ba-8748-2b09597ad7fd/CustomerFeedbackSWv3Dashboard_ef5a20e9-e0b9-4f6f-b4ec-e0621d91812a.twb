        <column _.fcp.RefreshableParameterRanges.true...default-value-field='[federated.1eiynth0w7d6ye1djswcd0x9bv0x].[Calculation_1431018826177085440]' _.fcp.RefreshableParameterRanges.true...source-field='[federated.1eiynth0w7d6ye1djswcd0x9bv0x].[date]' caption='Start Date' datatype='date' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='#2024-07-10#'>
          <calculation class='tableau' formula='#2024-07-10#' />
        </column>
        <column _.fcp.RefreshableParameterRanges.true...default-value-field='[federated.1eiynth0w7d6ye1djswcd0x9bv0x].[Calculation_1431018826177130497]' _.fcp.RefreshableParameterRanges.true...source-field='[federated.1eiynth0w7d6ye1djswcd0x9bv0x].[date]' caption='End Date' datatype='date' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='#2024-07-16#'>
          <calculation class='tableau' formula='#2024-07-16#' />
