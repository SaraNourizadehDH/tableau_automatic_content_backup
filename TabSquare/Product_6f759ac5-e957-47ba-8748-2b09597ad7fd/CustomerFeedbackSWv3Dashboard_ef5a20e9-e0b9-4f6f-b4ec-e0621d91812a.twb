        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0f0ua7j0dzfeh51ag7csx0g9mult' name='Custom SQL Query' type='text'>select *
from (
select a.*, 
CASE WHEN u.username is NULL THEN org1.name else u1.name end as BrandName, 
CASE WHEN u.username is NULL THEN org.name else u.name end as RestaurantName, 
CASE WHEN u.username is NULL THEN c.name else c1.name end as Country
FROM (
SELECT distinct cf.event_timestamp as event_date, date(cf.event_timestamp) as date, cf.feature, cf.rating, cf.remarks, cf.version, cf.merchantKey, cf.productRef, cf.orderId, cf.userID, cf.reasonTags
FROM `tabsquare-805d0.firestore_data_set.sw_customer_experience_view_prod` as cf) 
as a
left join `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_organization_view_prod` org on a.merchantKey = org.merchant_key
left join `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_organization_view_prod` org1 on org.organization_id = org1.id
left join `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_country_view_prod` c on org.country_id = c.id
left join `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_users_view_prod` u on a.merchantKey = u.customer_key
left join `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_users_view_prod` u1 on u.created_by = u1.id
left join `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_country_view_prod` c1 on u.country_code = c1.iso
) as b
where NOT(LOWER(RestaurantName) LIKE (&quot;%test%&quot;)
    OR LOWER(RestaurantName) LIKE (&quot;%demo%&quot;)
    OR LOWER(RestaurantName) LIKE (&quot;%ts cafe%&quot;)
    OR LOWER(RestaurantName) LIKE (&quot;%latest%&quot;))</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0f0ua7j0dzfeh51ag7csx0g9mult' name='Custom SQL Query' type='text'>select *
from (
select a.*, 
CASE WHEN u.username is NULL THEN org1.name else u1.name end as BrandName, 
CASE WHEN u.username is NULL THEN org.name else u.name end as RestaurantName, 
CASE WHEN u.username is NULL THEN c.name else c1.name end as Country
FROM (
SELECT distinct cf.event_timestamp as event_date, date(cf.event_timestamp) as date, cf.feature, cf.rating, cf.remarks, cf.version, cf.merchantKey, cf.productRef, cf.orderId, cf.userID, cf.reasonTags
FROM `tabsquare-805d0.firestore_data_set.sw_customer_experience_view_prod` as cf) 
as a
left join `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_organization_view_prod` org on a.merchantKey = org.merchant_key
left join `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_organization_view_prod` org1 on org.organization_id = org1.id
left join `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_country_view_prod` c on org.country_id = c.id
left join `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_users_view_prod` u on a.merchantKey = u.customer_key
left join `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_users_view_prod` u1 on u.created_by = u1.id
left join `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_country_view_prod` c1 on u.country_code = c1.iso
) as b
where NOT(LOWER(RestaurantName) LIKE (&quot;%test%&quot;)
    OR LOWER(RestaurantName) LIKE (&quot;%demo%&quot;)
    OR LOWER(RestaurantName) LIKE (&quot;%ts cafe%&quot;)
    OR LOWER(RestaurantName) LIKE (&quot;%latest%&quot;))</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
