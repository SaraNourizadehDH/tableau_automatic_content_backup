    <datasource caption='Custom SQL Query (tabsquare_crm_promo_data)' inline='true' name='federated.1u2yg7s054sw651euwbxc1lyn2od' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.03adkrl0rakmbn18lapw70cwqnn3'>
            <connection CATALOG='tabsquare-data-sciences' EXECCATALOG='tabsquare-data-sciences' authentication='auth-oauth-service-account' class='bigquery' connection-dialect='google-sql' project='tabsquare-data-sciences' schema='tabsquare_crm_promo_data' server-oauth='server-custom' username='data-team-tableau@tabsquare-data-sciences.iam.gserviceaccount.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.03adkrl0rakmbn18lapw70cwqnn3' name='Custom SQL Query' type='text'>select 
`stats`.`channel` AS `channel`,
  `stats`.`communication_type` AS `communication_type`,
  `stats`.`created_at` AS `created_at`,
  `stats`.`error` AS `error`,
  `stats`.`from_account` AS `from_account`,
  `stats`.`id` AS `id`,
  `stats`.`merchant_key` AS `merchant_key`,
  `stats`.`message_sid` AS `message_sid`,
  `stats`.`metadata` AS `metadata`,
 json_extract(metadata, &quot;$.numSegments&quot;) as sms_parts,
 json_extract(metadata, &quot;$.campaignName&quot;) as se_campaign_name,
  `stats`.`provider` AS `provider`,
  `stats`.`reference_id` AS `reference_id`,
  `stats`.`source` AS `source`,
  `stats`.`status` AS `status`,
CAST(`details`.`cost` AS FLOAT64) AS `cost`,
  `details`.`error` AS `details_error`,
  `details`.`id` AS `details_id`,
  `details`.`message_sid` AS `details_message_sid`,
  `details`.`receiver` AS `receiver`,
  `details`.`status` AS `details_status`,
  `details`.`status_date` AS `details_status_date`,
  content.content,
  users.merchant_name,
  orgs.org_name,
  mml.*
from
(select 
* 
from
`tabsquare-data-sciences.tabsquare_crm_promo_data.communication_stats` 
where trim(message_sid)!=&apos;&apos; and message_sid is not null and message_sid!=&apos;Messages queued for delivery.&apos;
)
stats
inner join
(
select message_sid, count(*) as c
from
`tabsquare-data-sciences.tabsquare_crm_promo_data.communication_stats`
group by 1
having c=1
)filtered
on stats.message_sid = filtered.message_sid
inner join
`tabsquare-data-sciences.tabsquare_crm_promo_data.communication_receiver_details` details
on stats.message_sid = details.message_sid
left join
(
  select content.message_sid, content.content
  from
`tabsquare-data-sciences.tabsquare_crm_promo_data.communication_message_content_details` content
inner join
(select  message_sid, count(*)
from
`tabsquare-data-sciences.tabsquare_crm_promo_data.communication_message_content_details`
where message_sid!=&apos;&apos;
group by 1
having count(*)&gt;&gt;1)check
on content.message_sid=check.message_sid
)content
on stats.message_sid = content.message_sid

                left join
                (
                select merchant_key as merchant_id, name as merchant_name, organization_id
                from
                `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_organization_view_prod`
                -- where coalesce(is_test_account,0)=0
                group by 1,2,3
                union all
                select customer_key as merchant_id, name as merchant_name, created_by as organization_id
                from
                `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_users_view_prod`
                group by 1,2,3
                )users
                on
                `stats`.`merchant_key` = users.merchant_id
                left join
                (
              select id, name as org_name
                from
                `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_organization_view_prod`
                -- where coalesce(is_test_account,0)=0
                group by 1,2
                union all
                select id, name as org_name
                from
                `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_users_view_prod`
                group by 1,2
                )orgs
                on users.organization_id=orgs.id
                left join
                `tabsquare-data-sciences.tabsquare_dw_lookups.master_merchant_list` mml
                on `stats`.`merchant_key` = mml.Merchant_id</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
