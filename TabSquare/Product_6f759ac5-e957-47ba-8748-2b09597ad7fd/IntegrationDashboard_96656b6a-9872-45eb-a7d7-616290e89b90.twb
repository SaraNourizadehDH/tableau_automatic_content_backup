    <datasource caption='Custom SQL Query (skipque_cdc_data_prod)' inline='true' name='federated.1ejlcpj07812cu12d98e612jkteh' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0cg23or05uo7in12z3xzs1uvsvas'>
            <connection CATALOG='tabsquare-data-sciences' EXECCATALOG='tabsquare-data-sciences' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tabsquare-data-sciences' schema='skipque_cdc_data_prod' server-oauth='' username='akshay.r@deliveryhero.in' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0cg23or05uo7in12z3xzs1uvsvas' name='Custom SQL Query' type='text'>select *,&#13;
case when currency_type = &apos;MYR&apos; then round(order_amount*0.33, 2) &#13;
when currency_type =&apos;IDR&apos; then round(order_amount*0.000092, 2) &#13;
when currency_type = &apos;AUD&apos; then round(order_amount*1, 2)&#13;
when currency_type = &apos;BND&apos; then round(order_amount*1, 2)&#13;
when currency_type = &apos;GBP&apos; then round(order_amount*1.86985, 2)&#13;
when currency_type = &apos;NZD&apos; then round(order_amount*0.92, 2)&#13;
when currency_type = &apos;PHP&apos; then round(order_amount*0.028, 2)&#13;
when currency_type = &apos;HKD&apos; then round(order_amount*0.17, 2)&#13;
when currency_type = &apos;EUR&apos; then round(order_amount*1.61, 2)&#13;
when currency_type = &apos;THB&apos; then round(order_amount*0.041, 2)&#13;
when currency_type = &apos;USD&apos; then round(order_amount*1.34386, 2)&#13;
when currency_type = &apos;TWD&apos; then round(order_amount*0.047, 2)&#13;
else round(order_amount, 2) end as total_amount&#13;
from &#13;
(select distinct o.id as order_id, ssp.value, ssp.identifier, org.name as merchant_name, ml.Chain_Name_in_system, org.merchant_key, org.currency_type, o.order_amount,&#13;
CASE WHEN o.status = -4 THEN &apos;Temp order while generating bill / Pending&apos;&#13;
	 WHEN o.status = -3 THEN &apos;Failed/ Rejected/ Cancelled&apos;&#13;
	 WHEN o.status = -2 THEN &apos;UnPaid/ Pending&apos;&#13;
	 WHEN o.status = -1 THEN &apos;UnAssigned&apos;&#13;
	 WHEN o.status = 0 THEN &apos;Not Confirm/ Pending&apos;&#13;
	 WHEN o.status = 1 THEN &apos;Confirmed/ Success&apos;&#13;
	 WHEN o.status = 2 THEN &apos;Ready/ Success&apos;&#13;
	 WHEN o.status = 3 THEN &apos;Closed/ Success&apos;&#13;
	 WHEN o.status = 4 THEN &apos;Unassigned&apos;&#13;
	 WHEN o.status = 5 THEN &apos;Unassigned&apos;&#13;
	 WHEN o.status = 6 THEN &apos;Refunded / Success but refunded later from MC&apos;&#13;
	 WHEN o.status = 7 THEN &apos;Driver Assigned/Success&apos;&#13;
END AS ts_order_status, c.name as country, date(o.created_date, &apos;Singapore&apos;) as sgt_datetime&#13;
from `tabsquare-data-sciences.skipque_cdc_data_prod.store_system_parameter` ssp&#13;
left join `tabsquare-data-sciences.skipque_cdc_data_prod.organization` org on ssp.organization_id= org.id&#13;
left join `tabsquare-data-sciences.skipque_cdc_data_prod.orders` o on org.id = o.restaurant_id&#13;
left join `tabsquare-data-sciences.tabsquare_dw_lookups.master_merchant_list` as ml on ml.Merchant_id = org.merchant_key&#13;
left join `tabsquare-data-sciences.skipque_cdc_data_prod.country` c on org.country_id = c.id&#13;
where value = &apos;1040&apos; and ssp.is_deleted != 1 and org.is_test_account != 1 and o.created_date &gt;&gt;= &apos;2023-01-01&apos;) as a</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
