      <aliases enabled='yes' />
      <column caption='Latest End Date' datatype='date' name='[Calculation_1748241133721636864]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{fixed :max(date(DATEADD(&apos;day&apos;,-1,{fixed: max([sgt_datetime])})))}' />
      </column>
      <column caption='Latest Start Date' datatype='date' name='[Calculation_1748241133721772033]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{fixed: max(date(DATETRUNC(&apos;day&apos;, [Calculation_1748241133721636864] - 6)))}' />
      </column>
      <column aggregation='Sum' caption='Current time period' datatype='integer' name='[Calculation_1748241133722972162]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if [sgt_datetime]&gt;=[Parameters].[Parameter 1] and [sgt_datetime]&lt;=[Parameters].[Parameter 2] then 1 else 0 end' />
