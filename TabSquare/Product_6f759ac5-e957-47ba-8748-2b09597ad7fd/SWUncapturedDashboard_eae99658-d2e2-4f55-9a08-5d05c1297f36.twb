      <column caption='Date Range' datatype='integer' name='[Calculation_1143351365064855552]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if [created_date]&gt;=[Parameters].[Parameter 1] and [created_date]&lt;=[Parameters].[Parameter 2] then 1 else 0 end' />
