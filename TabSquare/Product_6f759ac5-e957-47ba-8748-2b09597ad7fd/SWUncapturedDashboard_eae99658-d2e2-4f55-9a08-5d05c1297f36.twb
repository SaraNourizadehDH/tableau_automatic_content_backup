    <datasource caption='Custom SQL Query (skipque_cdc_data_prod)' inline='true' name='federated.13qqxzg1pjcz6y1c0rk9i1sr9r6h' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.11h9u2m1istmfm19az5a213wnpjs'>
            <connection CATALOG='tabsquare-data-sciences' EXECCATALOG='tabsquare-data-sciences' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tabsquare-data-sciences' schema='skipque_cdc_data_prod' server-oauth='' username='akshay.r@deliveryhero.in' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.11h9u2m1istmfm19az5a213wnpjs' name='Custom SQL Query' type='text'>select a.order_id, a.charge_order_id, a.charge_restaurantId, a.captured, a.order_status,&#13;
a.total_amount, DATE(a.created_date) as created_date, a.currency, a.order_amount, &#13;
case when currency = &apos;MYR&apos; then round(order_amount*0.33, 2) &#13;
when currency =&apos;IDR&apos; then round(order_amount*0.000092, 2) &#13;
when currency = &apos;AUD&apos; then round(order_amount*1, 2)&#13;
when currency = &apos;BND&apos; then round(order_amount*1, 2)&#13;
when currency = &apos;GBP&apos; then round(order_amount*1.86985, 2)&#13;
when currency = &apos;NZD&apos; then round(order_amount*0.92, 2)&#13;
when currency = &apos;PHP&apos; then round(order_amount*0.028, 2)&#13;
when currency = &apos;HKD&apos; then round(order_amount*0.17, 2)&#13;
when currency = &apos;EUR&apos; then round(order_amount*1.61, 2)&#13;
when currency = &apos;THB&apos; then round(order_amount*0.041, 2)&#13;
when currency = &apos;USD&apos; then round(order_amount*1.34386, 2)&#13;
when currency = &apos;TWD&apos; then round(order_amount*0.047, 2)&#13;
else round(order_amount, 2) end as converted_order_amount, Merchant_Name, country, System&#13;
from&#13;
(SELECT o.id as order_id, cast(replace(JSON_EXTRACT(c.metadata, &apos;$.orderId&apos;), &apos;\&quot;&apos;, &apos;&apos;) as numeric) as charge_order_id, &#13;
cast(replace(JSON_EXTRACT(c.metadata, &apos;$.restaurantId&apos;), &apos;\&quot;&apos;, &apos;&apos;) as numeric) as charge_restaurantId,&#13;
captured, o.status as order_status, o.total_amount, o.created_date, &#13;
o.order_amount, UPPER(c.currency) as currency, &#13;
CASE WHEN org.name is null then  u.name else org.name end as Merchant_Name,&#13;
CASE WHEN org.name is null then  u.country else org.country end as country,&#13;
CASE WHEN org.name is null then  &quot;CMS&quot; else &quot;ECMS&quot; end as System,&#13;
FROM `tabsquare-data-sciences.tabsquare_master_stripe.charge` as c&#13;
left join `tabsquare-data-sciences.skipque_cdc_data_prod.orders` as o on o.id = cast(replace(JSON_EXTRACT(c.metadata, &apos;$.orderId&apos;), &apos;\&quot;&apos;, &apos;&apos;) as numeric)&#13;
left join `tabsquare-data-sciences.skipque_cdc_data_prod.organization` as org on org.id = cast(replace(JSON_EXTRACT(c.metadata, &apos;$.restaurantId&apos;), &apos;\&quot;&apos;, &apos;&apos;) as numeric)&#13;
left join `tabsquare-data-sciences.skipque_cdc_data_prod.users` as u on u.id = cast(replace(JSON_EXTRACT(c.metadata, &apos;$.restaurantId&apos;), &apos;\&quot;&apos;, &apos;&apos;) as numeric)&#13;
where captured = FALSE and o.status = -4 and org.is_test_account != 1) as a</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.11h9u2m1istmfm19az5a213wnpjs' name='Custom SQL Query' type='text'>select a.order_id, a.charge_order_id, a.charge_restaurantId, a.captured, a.order_status,&#13;
a.total_amount, DATE(a.created_date) as created_date, a.currency, a.order_amount, &#13;
case when currency = &apos;MYR&apos; then round(order_amount*0.33, 2) &#13;
when currency =&apos;IDR&apos; then round(order_amount*0.000092, 2) &#13;
when currency = &apos;AUD&apos; then round(order_amount*1, 2)&#13;
when currency = &apos;BND&apos; then round(order_amount*1, 2)&#13;
when currency = &apos;GBP&apos; then round(order_amount*1.86985, 2)&#13;
when currency = &apos;NZD&apos; then round(order_amount*0.92, 2)&#13;
when currency = &apos;PHP&apos; then round(order_amount*0.028, 2)&#13;
when currency = &apos;HKD&apos; then round(order_amount*0.17, 2)&#13;
when currency = &apos;EUR&apos; then round(order_amount*1.61, 2)&#13;
when currency = &apos;THB&apos; then round(order_amount*0.041, 2)&#13;
when currency = &apos;USD&apos; then round(order_amount*1.34386, 2)&#13;
when currency = &apos;TWD&apos; then round(order_amount*0.047, 2)&#13;
else round(order_amount, 2) end as converted_order_amount, Merchant_Name, country, System&#13;
from&#13;
(SELECT o.id as order_id, cast(replace(JSON_EXTRACT(c.metadata, &apos;$.orderId&apos;), &apos;\&quot;&apos;, &apos;&apos;) as numeric) as charge_order_id, &#13;
cast(replace(JSON_EXTRACT(c.metadata, &apos;$.restaurantId&apos;), &apos;\&quot;&apos;, &apos;&apos;) as numeric) as charge_restaurantId,&#13;
captured, o.status as order_status, o.total_amount, o.created_date, &#13;
o.order_amount, UPPER(c.currency) as currency, &#13;
CASE WHEN org.name is null then  u.name else org.name end as Merchant_Name,&#13;
CASE WHEN org.name is null then  u.country else org.country end as country,&#13;
CASE WHEN org.name is null then  &quot;CMS&quot; else &quot;ECMS&quot; end as System,&#13;
FROM `tabsquare-data-sciences.tabsquare_master_stripe.charge` as c&#13;
left join `tabsquare-data-sciences.skipque_cdc_data_prod.orders` as o on o.id = cast(replace(JSON_EXTRACT(c.metadata, &apos;$.orderId&apos;), &apos;\&quot;&apos;, &apos;&apos;) as numeric)&#13;
left join `tabsquare-data-sciences.skipque_cdc_data_prod.organization` as org on org.id = cast(replace(JSON_EXTRACT(c.metadata, &apos;$.restaurantId&apos;), &apos;\&quot;&apos;, &apos;&apos;) as numeric)&#13;
left join `tabsquare-data-sciences.skipque_cdc_data_prod.users` as u on u.id = cast(replace(JSON_EXTRACT(c.metadata, &apos;$.restaurantId&apos;), &apos;\&quot;&apos;, &apos;&apos;) as numeric)&#13;
where captured = FALSE and o.status = -4 and org.is_test_account != 1) as a</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
