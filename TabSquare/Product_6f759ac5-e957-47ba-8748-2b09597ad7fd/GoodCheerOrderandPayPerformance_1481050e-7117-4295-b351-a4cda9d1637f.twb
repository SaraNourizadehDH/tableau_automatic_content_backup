      <column caption='Latest Start Date' datatype='date' name='[Calculation_251638667878428672]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='{fixed: max(date(DATETRUNC(&apos;day&apos;, [Calculation_251638667878486017] - 6)))}' />
      </column>
      <column caption='Latest End Date' datatype='date' name='[Calculation_251638667878486017]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{fixed :max(date(DATEADD(&apos;day&apos;,-1,{fixed: max([created_date])})))}' />
      </column>
      <column caption='Current time period' datatype='integer' name='[Calculation_251638667879596034]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if [created_date]&gt;=[Parameters].[Parameter 1] and [created_date]&lt;=[Parameters].[Parameter 2] then 1 else 0 end' />
      </column>
      <column aggregation='Sum' caption='Order_amt' datatype='real' name='[Calculation_251638667899543555]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [restaurant_id]= 9816 THEN [order_amount] END' />
