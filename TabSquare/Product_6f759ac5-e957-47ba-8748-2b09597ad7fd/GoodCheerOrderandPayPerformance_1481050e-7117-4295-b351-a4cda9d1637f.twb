        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1rjs0nn0amwbr417966o001cx474' name='Custom SQL Query' type='text'>select spt.id, spt.order_id, spt.session_id, spt.status, o.status as order_status,&#13;
o.restaurant_id, o.order_amount, spt.total, &#13;
spt.commission_fee, &#13;
DATE(spt.created_date, &apos;Singapore&apos;) as created_date, &#13;
DATETIME(spt.created_date, &apos;Singapore&apos;) as sg_date_time&#13;
from `tabsquare-data-sciences.skipque_cdc_data_prod.smartweb_payment_transactions` as spt&#13;
LEFT JOIN `tabsquare-data-sciences.skipque_cdc_data_prod.orders` as o on spt.order_id = o.id&#13;
left join `tabsquare-data-sciences.skipque_cdc_data_prod.organization` as org on o.restaurant_id = org.id&#13;
where spt.created_date &gt;&gt;= &apos;2022-12-01&apos; &#13;
and org.id in (9816, 6738, 7487) &#13;
and spt.status &gt;&gt; 0</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1rjs0nn0amwbr417966o001cx474' name='Custom SQL Query' type='text'>select spt.id, spt.order_id, spt.session_id, spt.status, o.status as order_status,&#13;
o.restaurant_id, o.order_amount, spt.total, &#13;
spt.commission_fee, &#13;
DATE(spt.created_date, &apos;Singapore&apos;) as created_date, &#13;
DATETIME(spt.created_date, &apos;Singapore&apos;) as sg_date_time&#13;
from `tabsquare-data-sciences.skipque_cdc_data_prod.smartweb_payment_transactions` as spt&#13;
LEFT JOIN `tabsquare-data-sciences.skipque_cdc_data_prod.orders` as o on spt.order_id = o.id&#13;
left join `tabsquare-data-sciences.skipque_cdc_data_prod.organization` as org on o.restaurant_id = org.id&#13;
where spt.created_date &gt;&gt;= &apos;2022-12-01&apos; &#13;
and org.id in (9816, 6738, 7487) &#13;
and spt.status &gt;&gt; 0</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
