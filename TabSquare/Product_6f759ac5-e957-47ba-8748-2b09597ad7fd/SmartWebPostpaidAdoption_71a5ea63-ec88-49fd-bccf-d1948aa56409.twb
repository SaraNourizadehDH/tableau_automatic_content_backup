        <objects>
          <object caption='Custom SQL Query' id='_F2920454CE064799920E08D22EFD1E85'>
            <properties context=''>
              <relation connection='bigquery.1rjs0nn0amwbr417966o001cx474' name='Custom SQL Query' type='text'>select spt.id, spt.order_id, spt.session_id, spt.status, o.status as order_status,&#13;
o.restaurant_id, o.order_amount, spt.total, &#13;
spt.commission_fee, &#13;
DATE(spt.created_date, &apos;Singapore&apos;) as created_date, &#13;
DATETIME(spt.created_date, &apos;Singapore&apos;) as sg_date_time&#13;
from `tabsquare-data-sciences.skipque_cdc_data_prod.smartweb_payment_transactions` as spt&#13;
LEFT JOIN `tabsquare-data-sciences.skipque_cdc_data_prod.orders` as o on spt.order_id = o.id&#13;
where spt.created_date &gt;&gt;= &apos;2022-12-01&apos; and spt.status &gt;&gt; 0</relation>
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
