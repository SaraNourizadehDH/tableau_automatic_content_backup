        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1rjs0nn0amwbr417966o001cx474' name='Custom SQL Query' type='text'>select spt.id, spt.order_id, spt.session_id, spt.status, o.status as order_status,&#13;
