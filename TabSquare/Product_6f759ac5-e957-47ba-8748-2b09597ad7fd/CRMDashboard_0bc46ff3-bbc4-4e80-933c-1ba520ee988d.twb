      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_55AB7C8F2AF448C9BA113A2A5A94FE42'>
            <properties context=''>
              <relation connection='bigquery.0lqb2b9107hyiu0zsi1wg01gibv8' name='Custom SQL Query' type='text'>select distinct ct.order_id, ct.status, ct.trans_type, ct.merchant_key, m.RestaurantName as merchant_name, m.Chain_Name_in_system as brand_name,&#13;
CASE WHEN ap.name like &apos;%KIOSK%&apos; THEN &apos;SmartKiosk&apos;&#13;
WHEN ap.name like &apos;%Smartweb%&apos; THEN &apos;SmartWeb&apos;   &#13;
ELSE ap.name END as Product_Type,&#13;
ct.user_name, crm_provider_name, o.currency_symbol, case when o.currency_symbol = &apos;MYR&apos; then round(o.order_amount*0.33, 2) &#13;
when o.currency_symbol =&apos;IDR&apos; then round(o.order_amount*0.000092, 2)&#13;
when o.currency_symbol =&apos;Rp&apos; then round(o.order_amount*0.000092, 2) &#13;
when o.currency_symbol = &apos;AUD&apos; then round(o.order_amount*1, 2)&#13;
when o.currency_symbol = &apos;BND&apos; then round(o.order_amount*1, 2)&#13;
when o.currency_symbol = &apos;GBP&apos; then round(o.order_amount*1.86985, 2)&#13;
when o.currency_symbol = &apos;NZD&apos; then round(o.order_amount*0.92, 2)&#13;
when o.currency_symbol = &apos;PHP&apos; then round(o.order_amount*0.028, 2)&#13;
when o.currency_symbol = &apos;HKD&apos; then round(o.order_amount*0.17, 2)&#13;
when o.currency_symbol = &apos;EUR&apos; then round(o.order_amount*1.61, 2)&#13;
when o.currency_symbol = &apos;THB&apos; then round(o.order_amount*0.041, 2)&#13;
when o.currency_symbol = &apos;USD&apos; then round(o.order_amount*1.34386, 2)&#13;
when o.currency_symbol = &apos;TWD&apos; then round(o.order_amount*0.047, 2)&#13;
WHEN o.currency_symbol = &apos;Â£&apos; then round(o.order_amount*1.61, 2)&#13;
when o.currency_symbol = &apos;AED&apos; then round(o.order_amount*0.37, 2)&#13;
else round(o.order_amount, 2) end as converted_order_amount, m.Country,&#13;
ct.points_earned, ct.total_trans_amount, JSON_VALUE(ct.response_from_provider, &apos;$.status&apos;) AS error_code,&#13;
JSON_VALUE(ct.response_from_provider, &apos;$.message&apos;) AS error_message, date(ct.created_at) as created_date &#13;
from `tabsquare-data-sciences.tabsquare_crm_promo_data.crm_transactions` ct&#13;
left join `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_orders_view_prod` o on ct.order_id = o.id&#13;
left join `tabsquare-data-sciences.tabsquare_dw_lookups.master_merchant_list` m on ct.merchant_key = m.Merchant_id&#13;
left join `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_order_payments_view_prod` op on o.id = op.order_id&#13;
left join `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_app_type_view_prod` ap on o.app_type = ap.id&#13;
left join `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_organization_view_prod` org on ct.merchant_key = org.merchant_key&#13;
where ct.created_at &gt;&gt;= &apos;2023-02-01&apos; and org.is_test_account != 1 and ct.crm_provider_name IN (&apos;REDCAT&apos;, &apos;TADA&apos;, &apos;ASCENTIS&apos;)</relation>
            </properties>
          </object>
        </objects>
