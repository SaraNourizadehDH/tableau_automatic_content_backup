left join `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_organization_view_prod` org on ct.merchant_key = org.merchant_key&#13;
where ct.created_at &gt;&gt;= &apos;2023-02-01&apos; and org.is_test_account != 1 and ct.crm_provider_name IN (&apos;REDCAT&apos;, &apos;TADA&apos;, &apos;ASCENTIS&apos;)</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
