          <datasource-dependencies datasource='federated.0hv6srp0b64w5r1987t2z16qcjyy'>
            <column caption='Latest Start Date' datatype='date' name='[Calculation_1659294993024335872]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='{fixed: max(date(DATETRUNC(&apos;day&apos;, [Calculation_1659294993024589825] - 6)))}' />
            </column>
            <column caption='Latest End Date' datatype='date' name='[Calculation_1659294993024589825]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{fixed :max(date(DATEADD(&apos;day&apos;,-1,{fixed: max([created_date])})))}' />
            </column>
            <column aggregation='Sum' caption='Current Time Period' datatype='integer' name='[Calculation_1659294993025581059]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [created_date] &gt;= [Parameters].[Parameter 1] &#13;&#10;and [created_date] &lt;= [Parameters].[Parameter 2] &#13;&#10;THEN 1 &#13;&#10;else 0 &#13;&#10;END' />
            </column>
            <column caption='Dummy' datatype='integer' name='[Calculation_1659294993032486916]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Compare Start Date' datatype='date' name='[Calculation_1659294993032749062]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='date(DATEADD(&apos;day&apos;,-1*[Calculation_1659294993032953864],[Parameters].[Parameter 1]))' />
            </column>
            <column caption='Compare End Date' datatype='date' name='[Calculation_1659294993032859655]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='date(DATEADD(&apos;day&apos;,-1,[Parameters].[Parameter 1]))' />
            </column>
            <column caption='Time Period' datatype='integer' name='[Calculation_1659294993032953864]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Parameters].[Parameter 1], [Parameters].[Parameter 2])+1' />
            </column>
            <column caption='Compare Time Period Filter' datatype='integer' name='[Calculation_1659294993033068553]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [created_date] &gt;= [Calculation_1659294993032749062] &#13;&#10;and [created_date] &lt;= [Calculation_1659294993032859655] &#13;&#10;then 1 &#13;&#10;else 0 &#13;&#10;end' />
            </column>
            <column caption='Current Points Earned Count' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_958703776387584010]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_1659294993025581059] = 1 THEN [points_earned] end)' />
