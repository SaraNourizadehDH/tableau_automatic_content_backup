        <column _.fcp.RefreshableParameterRanges.true...default-value-field='[federated.0hv6srp0b64w5r1987t2z16qcjyy].[Calculation_1659294993024335872]' _.fcp.RefreshableParameterRanges.true...source-field='[federated.0hv6srp0b64w5r1987t2z16qcjyy].[created_date]' caption='Start Date' datatype='date' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='#2023-12-06#'>
          <calculation class='tableau' formula='#2023-12-06#' />
        </column>
        <column _.fcp.RefreshableParameterRanges.true...default-value-field='[federated.0hv6srp0b64w5r1987t2z16qcjyy].[Calculation_1659294993024589825]' _.fcp.RefreshableParameterRanges.true...source-field='[federated.0hv6srp0b64w5r1987t2z16qcjyy].[created_date]' caption='End Date' datatype='date' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='#2023-12-12#'>
