    <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0sfkysj1da7vc91cmb7001o6oujq' name='Custom SQL Query' type='text'>with orders as (
  select o.id,o.order_amount ,o.changed_date,o.restaurant_id,CASE
    WHEN currency_symbol = &apos;MYR&apos; THEN ROUND(order_amount*0.33, 2)
    WHEN currency_symbol =&apos;IDR&apos; THEN ROUND(order_amount*0.000092, 2)
    WHEN currency_symbol = &apos;AUD&apos; THEN ROUND(order_amount*1, 2)
    WHEN currency_symbol = &apos;BND&apos; THEN ROUND(order_amount*1, 2)
    WHEN currency_symbol = &apos;GBP&apos; THEN ROUND(order_amount*1.86985, 2)
    WHEN currency_symbol = &apos;NZD&apos; THEN ROUND(order_amount*0.92, 2)
    WHEN currency_symbol = &apos;PHP&apos; THEN ROUND(order_amount*0.028, 2)
    WHEN currency_symbol = &apos;HKD&apos; THEN ROUND(order_amount*0.17, 2)
    WHEN currency_symbol = &apos;EUR&apos; THEN ROUND(order_amount*1.61, 2)
    WHEN currency_symbol = &apos;THB&apos; THEN ROUND(order_amount*0.041, 2)
    WHEN currency_symbol = &apos;USD&apos; THEN ROUND(order_amount*1.34386, 2)
    WHEN currency_symbol = &apos;TWD&apos; THEN ROUND(order_amount*0.047, 2)
  ELSE
  ROUND(order_amount, 2)
END
  AS c_order_amount from  `tabsquare-data-sciences.skipque_cdc_data_prod.orders` o
  where o.changed_date &gt;&gt;=&apos;2023-03-21&apos;
)
SELECT
  d.device_key,
  d.brand_id,
  d.merchant_key,
  ml.RestaurantName AS Outlet,
  ml.Chain_Name_in_system AS Brand,
  ml.Country as Country,
  d.device_model AS Pc_device_model,
  d.device_os,
  d.device_app_version,
  d.device_os_version,
  d.device_uuid,
  d.last_connected,
  d.device_status,
  d.id,
  d.device_register,
  d.created_date,
  oi.order_id,
  oi.mode,
  oi.used_printer,
  oi.receipt_type,
  oi.device_model,
  oi.printer_model,
  oi.connecting_type,
  oi.printing_status,
  oi.remark,
  oi.print_type,
  oi.app_type,
  oi.order_created_date,
  oi.received_firestore_date,
  oi.received_device_date,
  oi.printing_date,
  oi.delay_order_received,
  oi.delay_order_printing,
  o.id as m_orders_id,
  o.c_order_amount,
  o.changed_date as m_orders_date,
  org.is_test_account,

  
  
  CASE oi.app_type
    WHEN 1 THEN &apos;EMENU&apos;
    WHEN 2 THEN  &apos;SKIPQUE&apos;
    WHEN 3 THEN &apos;KIOSK&apos;
    WHEN 4 THEN &apos;SMARTWEB&apos;
    WHEN 5 THEN &apos;GOOGLE_PAY&apos;
    WHEN 10 THEN &apos;CONNECT&apos;
    ELSE NULL
  END AS app_type_Product

FROM
  tabsquare-data-sciences.skipque_cdc_data_prod.devices d
LEFT JOIN
  tabsquare-data-sciences.skipque_cdc_data_prod.order_info oi
ON
  d.device_key = oi.pc_id
left join orders o on o.id =oi.order_id
left join tabsquare-data-sciences.skipque_cdc_data_prod.organization org on
  d.merchant_key = org.merchant_key

INNER JOIN
  tabsquare-data-sciences.tabsquare_dw_lookups.master_merchant_list AS ml
ON
  org.merchant_key= ml.merchant_id
WHERE 
  d.device_register = 1 and ml.RestaurantName not like &quot;%Test%&quot; and ml.Chain_Name_in_system not like &quot;%Test%&quot; and org.is_test_account = 0</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
    <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
