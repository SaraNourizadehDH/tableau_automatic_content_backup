  </connection>
  <aliases enabled='yes' />
  <column caption='dau' datatype='integer' name='[Calculation_132222891987206144]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD(IF DATE([last_connected]) = TODAY() THEN [merchant_key] END)' />
  </column>
  <column caption='DAU_TEST' datatype='integer' name='[Calculation_132222892005158913]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{ FIXED [last_connected] :&#10;&#10;COUNTD([merchant_key])&#10;}' />
  </column>
  <column caption='Month' datatype='datetime' name='[Calculation_132222892010643458]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='DATETRUNC(&quot;month&quot;,[last_connected])' />
  </column>
  <column caption='MAU TEST' datatype='integer' name='[Calculation_132222892010766339]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{ FIXED [Calculation_132222892010643458] :&#10;&#10;COUNTD([merchant_key])&#10;}' />
  </column>
  <column caption='MAU ' datatype='integer' name='[Calculation_132222892017065988]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD(IF MONTH([last_connected]) = MONTH(TODAY()) AND YEAR([last_connected]) = YEAR(TODAY()) THEN [merchant_key] END)' />
  </column>
  <column caption='count the merchants per day' datatype='real' name='[Calculation_132222892027187207]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='AVG({ FIXED [last_connected] :&#10;&#10;COUNTD([merchant_key])&#10;})' />
  </column>
  <column caption='DAU DATA' datatype='integer' name='[Calculation_160651867098521600]' role='measure' type='ordinal'>
    <calculation class='tableau' formula='COUNTD(IF DATE([last_connected]) = TODAY() THEN [merchant_key] END)' />
  </column>
  <column caption='order_not_sent_Pc count' datatype='integer' name='[Calculation_237142682115186688]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNT([n_order_id])' />
  </column>
  <column aggregation='Sum' caption='delay in order received in minutes' datatype='real' name='[Calculation_237142682133766145]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='(([delay_order_received]/60)* 10)' />
  </column>
  <column caption='Delay  Received BINS' datatype='string' name='[Calculation_237142682153242632]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if [Calculation_237142682133766145] &gt;=2 and [Calculation_237142682133766145] &lt;=5 then &apos;2-5 mins delay&apos;&#10;ELSEIF [Calculation_237142682133766145] &gt;=6 and [Calculation_237142682133766145] &lt;=10 then &apos;5-10 mins delay&apos;&#10;ELSEIF [Calculation_237142682133766145]&gt;=11 AND [Calculation_237142682133766145]&lt;= 30 then &apos;10-30 mins delay&apos;&#10;ELSEIF [Calculation_237142682133766145]&gt;=30 AND [Calculation_237142682133766145]&lt;= 60 then &apos;30-60 mins delay&apos;&#10;ELSEIF [Calculation_237142682133766145]&lt;=61 then &apos;60 + mins delay&apos;&#10;end' />
  </column>
  <column caption='Orders not sent from SW' datatype='integer' name='[Calculation_237142682177658889]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='IF [app_type_Product] = &apos;SMARTWEB&apos; THEN ([n_order_id]) END' />
  </column>
  <column caption='Kisok Success' datatype='integer' name='[Calculation_308989164931289090]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='IF [printing_status] = &apos;Success&apos; AND [app_type_Product] = &apos;KIOSK&apos; then [order_id]&#10;END' />
  </column>
  <column caption='Kiosk failure' datatype='integer' name='[Calculation_308989164932067331]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='IF [printing_status] = &apos;Failed&apos; AND [app_type_Product] = &apos;KIOSK&apos; then [order_id]&#10;END' />
  </column>
