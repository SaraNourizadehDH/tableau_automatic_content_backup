    <datasource caption='Custom SQL Query (prod_analytics)' inline='true' name='federated.094qgia08yax7e11jdalb1rqkku1' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0sfkysj1da7vc91cmb7001o6oujq'>
            <connection CATALOG='tabsquare-data-sciences' EXECCATALOG='tabsquare-data-sciences' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tabsquare-data-sciences' schema='prod_analytics' server-oauth='' username='venkata.sirigineedi@deliveryhero.in' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0sfkysj1da7vc91cmb7001o6oujq' name='Custom SQL Query' type='text'>SELECT
  d.device_key,
  d.brand_id,
  d.merchant_key,
  ml.RestaurantName AS Outlet,
  ml.Chain_Name_in_system AS Brand,
  ml.Country as Country,
  d.device_model AS Pc_device_model,
  d.device_os,
  d.device_app_version,
  d.device_os_version,
  d.device_uuid,
  d.last_connected,
  d.device_status,
  d.id,
  d.device_register,
  d.created_date,
  oi.order_id,
  oi.mode,
  oi.used_printer,
  oi.receipt_type,
  oi.device_model,
  oi.printer_model,
  oi.connecting_type,
  oi.printing_status,
  oi.remark,
  oi.print_type,
  oi.app_type,
  oi.order_created_date,
  oi.received_firestore_date,
  oi.received_device_date,
  oi.printing_date,
  oi.delay_order_received,
  oi.delay_order_printing,
FROM
  tabsquare-data-sciences.skipque_cdc_data_prod.devices d
LEFT JOIN
  tabsquare-data-sciences.skipque_cdc_data_prod.order_info oi
ON
  d.device_key = oi.pc_id
INNER JOIN
  tabsquare-data-sciences.tabsquare_dw_lookups.master_merchant_list AS ml
ON
  d.merchant_key = ml.merchant_id
where d.device_register = 1</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0sfkysj1da7vc91cmb7001o6oujq' name='Custom SQL Query' type='text'>SELECT
  d.device_key,
  d.brand_id,
  d.merchant_key,
  ml.RestaurantName AS Outlet,
  ml.Chain_Name_in_system AS Brand,
  ml.Country as Country,
  d.device_model AS Pc_device_model,
  d.device_os,
  d.device_app_version,
  d.device_os_version,
  d.device_uuid,
  d.last_connected,
  d.device_status,
  d.id,
  d.device_register,
  d.created_date,
  oi.order_id,
  oi.mode,
  oi.used_printer,
  oi.receipt_type,
  oi.device_model,
  oi.printer_model,
  oi.connecting_type,
  oi.printing_status,
  oi.remark,
  oi.print_type,
  oi.app_type,
  oi.order_created_date,
  oi.received_firestore_date,
  oi.received_device_date,
  oi.printing_date,
  oi.delay_order_received,
  oi.delay_order_printing,
FROM
  tabsquare-data-sciences.skipque_cdc_data_prod.devices d
LEFT JOIN
  tabsquare-data-sciences.skipque_cdc_data_prod.order_info oi
ON
  d.device_key = oi.pc_id
INNER JOIN
  tabsquare-data-sciences.tabsquare_dw_lookups.master_merchant_list AS ml
ON
  d.merchant_key = ml.merchant_id
where d.device_register = 1</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
