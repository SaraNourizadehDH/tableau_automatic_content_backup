      <aliases enabled='yes' />
      <column caption='Current Time Period' datatype='integer' name='[Calculation_323274015540211714]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [created_date] &gt;= [Parameters].[Parameter 1] and &#10;[created_date] &lt;= [Parameters].[Start date (copy)_323274015539855360] then 1 else 0 END' />
      </column>
      <column caption='Latest Start Date' datatype='date' name='[Calculation_323274015540322307]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='{fixed: max(date(DATETRUNC(&apos;day&apos;, [Calculation_323274015540539396] - 6)))}' />
      </column>
      <column caption='Latest End Date' datatype='date' name='[Calculation_323274015540539396]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{fixed :max(date(DATEADD(&apos;day&apos;,-1,{fixed: max([created_date])})))}' />
      </column>
      <column caption='count devices' datatype='integer' name='[Calculation_323274015572754438]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([device_key])' />
      </column>
      <column caption='zero' datatype='integer' name='[Calculation_84442497329283072]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='current date' datatype='date' name='[Calculation_84442497333530625]' role='dimension' type='ordinal'>
