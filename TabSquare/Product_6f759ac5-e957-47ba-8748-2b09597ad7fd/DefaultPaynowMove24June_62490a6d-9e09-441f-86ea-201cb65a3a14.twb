      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_512034915DF74337BAB6C7468619731E'>
            <properties context=''>
              <relation connection='bigquery.0saniae06ohatt18dk6s81i38ibr' name='Custom SQL Query' type='text'><![CDATA[select gmv.*, pgmv.net_txn_revenue_sgd from 
(select a.*, b.Chain_Name_in_system,b.Account_Name,b.Name_of_Account_Manager,
b.Team, case when ifnull(organization_partner_id,0) in (1) then 'FoodPanda' 
 when ifnull(organization_partner_id,0) in (2) then 'Foodora'
 when ifnull(organization_partner_id,0) in (3) then 'Talabat'
 else 'TabSquare' end as third_party_flag,
 case when ifnull(organization_partner_id,0) in (1,2) and a.merchant_id in  (
"HQ-8543-8544","HQ-8656-8657","HQ-8664-8665","HQ-8818-8822","HQ-8117-8126","HQ-8117-8119","HQ-8351-8352","HQ-8557-8558","HQ-8137-8138","HQ-8193-8194",
"HQ-8582-8583","HQ-8100-8101","HQ-8131-8135","HQ-8097-8098","HQ-8230-8231","HQ-8131-8132","HQ-8573-8574","HQ-8389-8390","HQ-8826-8827","HQ-8831-8832",
"HQ-8824-8825","HQ-8845-8846","HQ-7959-7961","HQ-8061-8062","HQ-7960-7962","HQ-8131-8136","HQ-7370-7371","HQ-7604-7607","HQ-8078-8079","HQ-8133-8134",
"HQ-8133-8141","HQ-7964-7965","HQ-8646-8647","HQ-8654-8655","HQ-7937-7938","HQ-8108-8144","HQ-8258-8259","HQ-8652-8653","HQ-8821-8823","HQ-7605-7606",
"HQ-8117-8118","HQ-8706-8707","HQ-7776-8584","HQ-8518-8519","HQ-8531-8533","HQ-8267-8495","HQ-8108-8109","HQ-8577-8578","HQ-8372-8373","HQ-8157-8158",
"HQ-8287-8288","HQ-8403-8404","HQ-8370-8371","HQ-8353-8356","HQ-8096-8099","HQ-8300-8301","HQ-7663-7664","HQ-8267-8268","HQ-8195-8196","HQ-8159-8160",
"HQ-7937-7939","HQ-8059-8060","HQ-7689-7690","HQ-7780-7781","HQ-7900-7901","HQ-7755-7756","HQ-7358-7359","HQ-7543-7544","HQ-7624-7625","HQ-7682-7683",
"HQ-7729-7732","HQ-8128-8129","HQ-8267-8491","HQ-8243-8244","HQ-8485-8486","HQ-8120-8121","HQ-8094-8095","HQ-8294-8295","HQ-8289-8290","HQ-8292-8293",
"HQ-7751-7953","HQ-7887-7902","HQ-7694-7695","HQ-7935-7936","HQ-7719-7720","HQ-8122-8123","HQ-7790-7795","HQ-8680-8683","HQ-8625-8626","HQ-8532-8534",
"HQ-8017-8018","HQ-7751-7752","HQ-7784-7785","HQ-7915-7916","HQ-8621-8622","HQ-8674-8675","HQ-8623-8624","HQ-8585-8587","HQ-8401-8402","HQ-8537-8538",
"HQ-8374-8375","HQ-7759-7760","HQ-8106-8107","HQ-8115-8116","HQ-8305-8306","HQ-7967-7968","HQ-7753-7754","HQ-8076-8077","HQ-7991-7992","HQ-7821-7823",
"HQ-7989-7990","HQ-8063-8064","HQ-7788-7789","HQ-7887-7889","HQ-7757-7758","HQ-7777-7779","HQ-8376-8377","HQ-8627-8628","HQ-8575-8576","HQ-7747-7748",
"HQ-8019-8020","HQ-7887-7888") then "Food-Panda_PO"
when ifnull(organization_partner_id,0) in (1,2,3) and a.merchant_id not in  (
"HQ-8543-8544","HQ-8656-8657","HQ-8664-8665","HQ-8818-8822","HQ-8117-8126","HQ-8117-8119","HQ-8351-8352","HQ-8557-8558","HQ-8137-8138","HQ-8193-8194",
"HQ-8582-8583","HQ-8100-8101","HQ-8131-8135","HQ-8097-8098","HQ-8230-8231","HQ-8131-8132","HQ-8573-8574","HQ-8389-8390","HQ-8826-8827","HQ-8831-8832",
"HQ-8824-8825","HQ-8845-8846","HQ-7959-7961","HQ-8061-8062","HQ-7960-7962","HQ-8131-8136","HQ-7370-7371","HQ-7604-7607","HQ-8078-8079","HQ-8133-8134",
"HQ-8133-8141","HQ-7964-7965","HQ-8646-8647","HQ-8654-8655","HQ-7937-7938","HQ-8108-8144","HQ-8258-8259","HQ-8652-8653","HQ-8821-8823","HQ-7605-7606",
"HQ-8117-8118","HQ-8706-8707","HQ-7776-8584","HQ-8518-8519","HQ-8531-8533","HQ-8267-8495","HQ-8108-8109","HQ-8577-8578","HQ-8372-8373","HQ-8157-8158",
"HQ-8287-8288","HQ-8403-8404","HQ-8370-8371","HQ-8353-8356","HQ-8096-8099","HQ-8300-8301","HQ-7663-7664","HQ-8267-8268","HQ-8195-8196","HQ-8159-8160",
"HQ-7937-7939","HQ-8059-8060","HQ-7689-7690","HQ-7780-7781","HQ-7900-7901","HQ-7755-7756","HQ-7358-7359","HQ-7543-7544","HQ-7624-7625","HQ-7682-7683",
"HQ-7729-7732","HQ-8128-8129","HQ-8267-8491","HQ-8243-8244","HQ-8485-8486","HQ-8120-8121","HQ-8094-8095","HQ-8294-8295","HQ-8289-8290","HQ-8292-8293",
"HQ-7751-7953","HQ-7887-7902","HQ-7694-7695","HQ-7935-7936","HQ-7719-7720","HQ-8122-8123","HQ-7790-7795","HQ-8680-8683","HQ-8625-8626","HQ-8532-8534",
"HQ-8017-8018","HQ-7751-7752","HQ-7784-7785","HQ-7915-7916","HQ-8621-8622","HQ-8674-8675","HQ-8623-8624","HQ-8585-8587","HQ-8401-8402","HQ-8537-8538",
"HQ-8374-8375","HQ-7759-7760","HQ-8106-8107","HQ-8115-8116","HQ-8305-8306","HQ-7967-7968","HQ-7753-7754","HQ-8076-8077","HQ-7991-7992","HQ-7821-7823",
"HQ-7989-7990","HQ-8063-8064","HQ-7788-7789","HQ-7887-7889","HQ-7757-7758","HQ-7777-7779","HQ-8376-8377","HQ-8627-8628","HQ-8575-8576","HQ-7747-7748",
"HQ-8019-8020","HQ-7887-7888") then "Food-Panda_P1"
else "TS"
 end as PO_P1_TS
from
(
SELECT
  Merchant_id,RestaurantName,order_date,Country,Product_Type,data_source,System, sum(sales) as Sales, count(order_id) as orders, sum(Paid_Gmv) as Paid_Gmv
FROM
  `tabsquare-data-sciences.datastudio_dashboard_data.all_product_firebase_data`
WHERE
  order_date >>= '2025-03-01' and order_date <<= current_date('Asia/Singapore')
  and merchant_id not like '%HQ-24%'
  and merchant_id not like '%HQ-6278%'
  GROUP BY 1,2,3,4,5,6,7
UNION ALL
SELECT
  Merchant_id,RestaurantName,order_date,Country,Product_Type,data_source,System, sum(sales) as Sales, count(order_id) as orders, sum(Paid_Gmv) as Paid_Gmv
FROM
  `tabsquare-data-sciences.datastudio_dashboard_data.all_product_skipque_data`
WHERE
  order_date >>= '2025-03-01' and order_date <<= current_date('Asia/Singapore')
  GROUP BY 1,2,3,4,5,6,7

UNION ALL 

SELECT
  Merchant_id,RestaurantName,extract(date from order_date) as order_date,Country,Product_Type,data_source,System, sum(sales) as Sales, sum(Orders) as orders, 0 as Paid_Gmv
FROM
  `tabsquare-data-sciences.tabsquare_dw_lookups.kfc_taco_gmv`

  GROUP BY 1,2,3,4,5,6,7
) as a
left join
`tabsquare-data-sciences.tabsquare_dw_lookups.master_merchant_list_tableau_view` as b
on a.merchant_id = b.merchant_id
left join
`tabsquare-data-sciences.all_skipque_cdc_data_prod.all_organization_view_prod` o
on a.merchant_id = o.merchant_key) gmv 
left join  
`tabsquare-data-sciences.tabsquare_dw_lookups.net_txn_revenue` pgmv 
on gmv.merchant_id = pgmv.merchant_key
and lower(gmv.product_type) = lower(pgmv.app_type_final)
and gmv.order_date = pgmv.order_date]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
