          <named-connection caption='BigQuery' name='bigquery.17s5nlv0kuvpx714yihs817ujqfc'>
            <connection CATALOG='tabsquare-data-sciences' EXECCATALOG='tabsquare-data-sciences' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tabsquare-data-sciences' schema='skipque_cdc_data_prod' server-oauth='server-custom' username='data-team-tableau@tabsquare-data-sciences.iam.gserviceaccount.com' workgroup-auth-mode='prompt' />
