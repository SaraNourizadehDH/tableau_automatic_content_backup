        <relation connection='bigquery.17s5nlv0kuvpx714yihs817ujqfc' name='Custom SQL Query' type='text'>select * &#13;&#10;from&#13;&#10;(select o.id as order_id, o.status as order_status, &#13;&#10;CASE WHEN o.status = -4 THEN &apos;UNCONFIRMED&apos;&#13;&#10;&#9; WHEN o.status = -3 THEN &apos;REJECTED&apos;&#13;&#10;&#9; WHEN o.status = -2 THEN &apos;UNCONFIRMED&apos;&#13;&#10;&#9; WHEN o.status = -1 THEN &apos;UNASSIGNED&apos;&#13;&#10;&#9; WHEN o.status = 0 THEN &apos;UNCONFIRMED&apos;&#13;&#10;&#9; WHEN o.status = 1 THEN &apos;CONFIRMED&apos;&#13;&#10;&#9; WHEN o.status = 2 THEN &apos;CONFIRMED&apos;&#13;&#10;&#9; WHEN o.status = 3 THEN &apos;CONFIRMED&apos;&#13;&#10;&#9; WHEN o.status = 4 THEN &apos;UNASSIGNED&apos;&#13;&#10;&#9; WHEN o.status = 5 THEN &apos;UNASSIGNED&apos;&#13;&#10;&#9; WHEN o.status = 6 THEN &apos;REFUNDED&apos;&#13;&#10;&#9; WHEN o.status = -6 THEN &apos;REFUNDED&apos;&#13;&#10;&#9; WHEN o.status = 7 THEN &apos;Driver Assigned/Success&apos;&#13;&#10;ELSE CAST(o.status as STRING)&#13;&#10;END AS ts_order_status,&#13;&#10;CASE WHEN op.status = -1 THEN &apos;TIMEOUT&apos;&#13;&#10;WHEN op.status = 0 THEN &apos;PENDING&apos;&#13;&#10;when op.status = 2 then &apos;FAILED&apos;&#13;&#10;when op.status = 3 THEN &apos;SUCCESS&apos;&#13;&#10;WHEN op.status = 4 THEN &apos;CANCEL&apos;&#13;&#10;WHEN op.status = 1 THEN &apos;UNPAID&apos;&#13;&#10;else CAST(op.status as STRING) end as orderpayment_status,&#13;&#10;case when or1.refund_source = 1 then &apos;Auto Refund&apos;&#13;&#10;WHEN or1.refund_source = 2 THEN &apos;Manual Refund&apos;&#13;&#10;end as refundsource,&#13;&#10;CASE WHEN u.username is null THEN org.merchant_key else u.customer_key end as merchant_key,&#13;&#10;CASE WHEN u.username is null THEN org.name else u.name end as merchant_name,&#13;&#10;CASE WHEN u.username is null THEN org1.name else u1.name end as Brand_Name,&#13;&#10;CASE WHEN u.username is null THEN c.name else u.country end as Country,&#13;&#10;case when o.currency_symbol = &apos;MYR&apos; then (order_amount*0.33)&#13;&#10;when o.currency_symbol =&apos;IDR&apos; then (order_amount*0.000092)&#13;&#10;when o.currency_symbol =&apos;Rp&apos; then (order_amount*0.000092) &#13;&#10;when o.currency_symbol = &apos;AUD&apos; then (order_amount*1)&#13;&#10;when o.currency_symbol = &apos;BND&apos; then (order_amount*1)&#13;&#10;when o.currency_symbol = &apos;GBP&apos; then (order_amount*1.86985)&#13;&#10;when o.currency_symbol = &apos;NZD&apos; then (order_amount*0.92)&#13;&#10;when o.currency_symbol = &apos;PHP&apos; then (order_amount*0.028)&#13;&#10;when o.currency_symbol = &apos;HKD&apos; then (order_amount*0.17)&#13;&#10;when o.currency_symbol = &apos;EUR&apos; then (order_amount*1.61)&#13;&#10;when o.currency_symbol = &apos;THB&apos; then (order_amount*0.041)&#13;&#10;when o.currency_symbol = &apos;USD&apos; then (order_amount*1.34386)&#13;&#10;when o.currency_symbol = &apos;TWD&apos; then (order_amount*0.047)&#13;&#10;WHEN o.currency_symbol = &apos;Â£&apos; then (order_amount*1.61)&#13;&#10;else (order_amount) end as converted_order_amount,&#13;&#10;case when o.currency_symbol = &apos;MYR&apos; then round(or1.amount*0.33, 2) &#13;&#10;when o.currency_symbol =&apos;IDR&apos; then round(or1.amount*0.000092, 2)&#13;&#10;when o.currency_symbol =&apos;Rp&apos; then round(or1.amount*0.000092, 2) &#13;&#10;when o.currency_symbol = &apos;AUD&apos; then round(or1.amount*1, 2)&#13;&#10;when o.currency_symbol = &apos;BND&apos; then round(or1.amount*1, 2)&#13;&#10;when o.currency_symbol = &apos;GBP&apos; then round(or1.amount*1.86985, 2)&#13;&#10;when o.currency_symbol = &apos;NZD&apos; then round(or1.amount*0.92, 2)&#13;&#10;when o.currency_symbol = &apos;PHP&apos; then round(or1.amount*0.028, 2)&#13;&#10;when o.currency_symbol = &apos;HKD&apos; then round(or1.amount*0.17, 2)&#13;&#10;when o.currency_symbol = &apos;EUR&apos; then round(or1.amount*1.61, 2)&#13;&#10;when o.currency_symbol = &apos;THB&apos; then round(or1.amount*0.041, 2)&#13;&#10;when o.currency_symbol = &apos;USD&apos; then round(or1.amount*1.34386, 2)&#13;&#10;when o.currency_symbol = &apos;TWD&apos; then round(or1.amount*0.047, 2)&#13;&#10;else round(or1.amount, 2) end as converted_refund_amount,&#13;&#10;case when o.currency_symbol = &apos;MYR&apos; then round(op.amount*0.33, 2) &#13;&#10;when o.currency_symbol =&apos;IDR&apos; then round(op.amount*0.000092, 2)&#13;&#10;when o.currency_symbol =&apos;Rp&apos; then round(op.amount*0.000092, 2) &#13;&#10;when o.currency_symbol = &apos;AUD&apos; then round(op.amount*1, 2)&#13;&#10;when o.currency_symbol = &apos;BND&apos; then round(op.amount*1, 2)&#13;&#10;when o.currency_symbol = &apos;GBP&apos; then round(op.amount*1.86985, 2)&#13;&#10;when o.currency_symbol = &apos;NZD&apos; then round(op.amount*0.92, 2)&#13;&#10;when o.currency_symbol = &apos;PHP&apos; then round(op.amount*0.028, 2)&#13;&#10;when o.currency_symbol = &apos;HKD&apos; then round(op.amount*0.17, 2)&#13;&#10;when o.currency_symbol = &apos;EUR&apos; then round(op.amount*1.61, 2)&#13;&#10;when o.currency_symbol = &apos;THB&apos; then round(op.amount*0.041, 2)&#13;&#10;when o.currency_symbol = &apos;USD&apos; then round(op.amount*1.34386, 2)&#13;&#10;when o.currency_symbol = &apos;TWD&apos; then round(op.amount*0.047, 2)&#13;&#10;else round(op.amount, 2) end as converted_op_amount,&#13;&#10;or1.refund_type, or1.refund_reason,&#13;&#10;lower(op.payment_type) as payment_type,&#13;&#10;CASE WHEN op.payment_type like &apos;stripe%&apos; or op.payment_type like &apos;STRIPE%&apos; or op.payment_type like &apos;Stripe&apos; THEN &apos;Stripe&apos;&#13;&#10;WHEN op.payment_type like &apos;rapyd%&apos; or op.payment_type like &apos;Rapyd%&apos; THEN &apos;Rapyd&apos;&#13;&#10;WHEN op.payment_type like &apos;Raz%&apos; or op.payment_type like &apos;RAZ%&apos; THEN &apos;RazerPay&apos;&#13;&#10;WHEN op.payment_type like &apos;CHECKOUT%&apos; or op.payment_type like &apos;checkout%&apos; THEN &apos;Checkout&apos;&#13;&#10;else op.payment_type end as PaymentPartner,&#13;&#10;CASE WHEN at1.name is NULL THEN at2.name else at1.name end as Product_Type,&#13;&#10;date(o.created_date) as created_date, date(or1.created_date) as refund_date&#13;&#10;from `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_orders_view_prod` as o &#13;&#10;left join `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_order_payments_view_prod` as op on o.id = op.order_id&#13;&#10;left join `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_organization_view_prod` as org on o.restaurant_id = org.id&#13;&#10;left join `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_organization_view_prod` as org1 on org.organization_id = org1.id&#13;&#10;left join `tabsquare-data-sciences.skipque_cdc_data_prod.users` as u on o.restaurant_id = u.id&#13;&#10;left join `tabsquare-data-sciences.skipque_cdc_data_prod.users` as u1 on u.created_by = u1.id&#13;&#10;left join `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_app_types_view_prod` at1 on o.app_type = at1.id&#13;&#10;left join `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_app_type_view_prod` at2 on o.app_type = at2.id&#13;&#10;left join `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_country_view_prod` as c on org.country_id = c.id&#13;&#10;left join `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_order_refund_view_prod` as or1 on o.id = or1.order_id&#13;&#10;where o.app_type = 4 and &#13;&#10;op.payment_type NOT like &apos;CASH%&apos; and op.payment_type Not LIKE &apos;TA%&apos; and op.payment_type NOT like &apos;ASCENTIS%&apos;&#13;&#10;and op.payment_type not like &apos;3%&apos; and op.payment_type not like &apos;RED%&apos;&#13;&#10;and DATE(o.changed_date) &gt;&gt;= DATE_ADD(CURRENT_DATE(), INTERVAL -15 DAY)&#13;&#10;and DATE(op.created_date) &gt;&gt;= DATE_ADD(CURRENT_DATE(), INTERVAL -15 DAY)&#13;&#10;) as a&#13;&#10;where NOT(LOWER(merchant_name) LIKE (&quot;%test%&quot;)&#13;&#10;    OR LOWER(merchant_name) LIKE (&quot;%demo%&quot;)&#13;&#10;    OR LOWER(merchant_name) LIKE (&quot;%ts cafe%&quot;)&#13;&#10;    OR LOWER(merchant_name) LIKE (&quot;%latest%&quot;))</relation>
