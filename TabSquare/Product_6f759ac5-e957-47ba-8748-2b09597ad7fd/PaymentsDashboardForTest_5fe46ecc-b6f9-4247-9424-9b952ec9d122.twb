      <column caption='latest start date_sp' datatype='date' name='[Calculation_1132936806446989313]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='{fixed: max(date(DATETRUNC(&apos;day&apos;, [Calculation_1132936806447099906] - 6)))}' />
      </column>
      <column caption='latest end date_sp' datatype='date' name='[Calculation_1132936806447099906]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{fixed :max(date(DATEADD(&apos;day&apos;,0,{fixed: max([created_date])})))}' />
      </column>
      <column aggregation='Sum' caption='SP Current Time period' datatype='integer' name='[Calculation_1132936806448791556]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [created_date] &gt;= [Parameters].[Parameter 1] and &#13;&#10;[created_date] &lt;= [Parameters].[Parameter 2] then 1 else 0 END' />
      </column>
      <column caption='dummy' datatype='integer' hidden='true' name='[Calculation_1418633922357268481]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Compare Start Date SP' datatype='date' hidden='true' name='[Calculation_1418633922358181892]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='date(DATEADD(&apos;day&apos;,-1*[Calculation_1418633922358390789],[Parameters].[Parameter 3]))' />
      </column>
      <column caption='Time Period' datatype='integer' hidden='true' name='[Calculation_1418633922358390789]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Parameters].[Parameter 3], [Parameters].[Parameter 4])+1' />
      </column>
      <column caption='Compare End Date SP' datatype='date' hidden='true' name='[Calculation_1418633922358525958]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='date(DATEADD(&apos;day&apos;,-1,[Parameters].[Parameter 3]))' />
      </column>
      <column caption='Compare Time Period Filter SP' datatype='integer' hidden='true' name='[Calculation_1418633922358702087]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [created_date] &gt;= [Calculation_1418633922358181892] and [created_date] &lt;= [Calculation_1418633922358525958] then 1 else 0 end' />
      </column>
      <column caption='Current Sales SP' datatype='real' hidden='true' name='[Calculation_1418633922358943752]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [Calculation_1132936806448791556] = 1 THEN [paid_amount] END)' />
      </column>
      <column caption='Compare Sales' datatype='real' hidden='true' name='[Calculation_1418633922359123977]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [Calculation_1418633922358702087]=1 THEN [paid_amount] END)' />
      </column>
      <column caption='Change in Sales' datatype='real' hidden='true' name='[Calculation_1418633922359222282]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1418633922358943752]-[Calculation_1418633922359123977])/[Calculation_1418633922359123977]' />
