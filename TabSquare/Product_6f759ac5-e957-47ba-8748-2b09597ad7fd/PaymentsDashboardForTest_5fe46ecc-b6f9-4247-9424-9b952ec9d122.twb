      <object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_944B3AEAEA51458DA0B403D7B2085740'>
            <properties context=''>
              <relation connection='bigquery.1tlv76v0g8qncp188poos1tqrduc' name='Custom SQL Query' type='text'>SELECT p.id, p.payment_type, p.paid_amount, p.status, p.paymentchannel_source, &#13;&#10;CASE WHEN p.payment_type like &apos;stripe%&apos; or p.payment_type like &apos;STRIPE%&apos; or p.payment_type like &apos;Stripe&apos; &#13;&#10;or p.payment_type like &apos;PAYNOW%&apos; or p.payment_type like &apos;paynow%&apos;&#13;&#10;THEN &apos;Stripe&apos;&#13;&#10;WHEN p.payment_type like &apos;rapyd%&apos; or p.payment_type like &apos;Rapyd%&apos; THEN &apos;Rapyd&apos;&#13;&#10;WHEN p.payment_type like &apos;Raz%&apos; or p.payment_type like &apos;RAZ%&apos; or p.payment_type like &apos;RazerPay%&apos; THEN &apos;RazerPay&apos;&#13;&#10;WHEN p.payment_type like &apos;CHECKOUT%&apos; or p.payment_type like &apos;checkout%&apos; or p.payment_type like &apos;Checkout%&apos; THEN &apos;Checkout&apos;&#13;&#10;WHEN p.payment_type LIKE &apos;wechat_pay%&apos; or p.payment_type like &apos;WECHAT_PAY%&apos; THEN &apos;Stripe&apos;&#13;&#10;WHEN p.payment_type LIKE &apos;adyen_platform%&apos; or p.payment_type like &apos;ADYEN_PLATFORM%&apos; or p.payment_type like &apos;adyen_web%&apos; or p.payment_type like &apos;ADYEN_WEB%&apos; THEN &apos;Adyen&apos;&#13;&#10;else p.payment_type end as PaymentPartner, bi.merchant_key, org.name as merchant_name, c.name as Country, bi.app_type,&#13;&#10;CASE WHEN p.paymentchannel_source like &apos;PC Terminal%&apos; THEN &apos;PC Terminal&apos;&#13;&#10;WHEN bi.app_type = &apos;11&apos; THEN &apos;PostPay&apos;&#13;&#10;WHEN bi.app_type = &apos;4&apos; THEN &apos;SmartPay&apos; &#13;&#10;else p.paymentchannel_source END AS Product_type,&#13;&#10;date(p.created_at) as created_date &#13;&#10;FROM `tabsquare-data-sciences.skipque_cdc_data_prod.smartpay_payment_prod` p&#13;&#10;left join `tabsquare-data-sciences.skipque_cdc_data_prod.smartpay_bill_info_prod` bi on bi.id = p.bill_info_id&#13;&#10;left join `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_organization_view_prod` org on bi.merchant_key = org.merchant_key&#13;&#10;left join `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_country_view_prod` c on org.country_id = c.id&#13;&#10;where DATE(p.created_at) &gt;&gt;= DATE_ADD(CURRENT_DATE(), INTERVAL -90 DAY)&#13;&#10;and p.paymentchannel_source NOT LIKE &apos;%PC TerminaPCTerminal SmartwebSmartWeb SmartPAYSmartPAY PC TerminaPCTerminal SmartwebSmartWeb Smar123%&apos;&#13;&#10;and p.payment_type not like &apos;Alfred%&apos; and p.payment_type not like &apos;ALFRED%&apos; and p.payment_type not like &apos;alfred%&apos;&#13;&#10;order by p.created_at</relation>
            </properties>
          </object>
        </objects>
      </object-graph>
    </datasource>
  </datasources>
