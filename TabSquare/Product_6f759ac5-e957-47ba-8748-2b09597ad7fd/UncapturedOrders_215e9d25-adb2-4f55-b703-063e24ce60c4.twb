      </column>
      <column caption='Latest Start Date' datatype='date' name='[Calculation_1261570871939399680]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='{fixed: max(date(DATETRUNC(&apos;day&apos;, [Calculation_1261570871939710977] - 6)))}' />
      </column>
      <column caption='Latest End Date' datatype='date' name='[Calculation_1261570871939710977]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{fixed :max(date(DATEADD(&apos;day&apos;,-1,{fixed: max([created_date])})))}' />
      </column>
