      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_33D0C22D227040738486243B6CFBC30E'>
            <properties context=''>
              <relation connection='bigquery.1sa3o0m1gm30l7146omr70xzwrxn' name='Custom SQL Query' type='text'>SELECT id, order_status, payment_type, spt_order_id, op_status, restaurant_id,&#13;
country, currency_type, order_amount,spt_status,&#13;
case when currency_type = &apos;MYR&apos; then round(order_amount*0.33, 2) &#13;
when currency_type =&apos;IDR&apos; then round(order_amount*0.000092, 2) &#13;
when currency_type = &apos;AUD&apos; then round(order_amount*1, 2)&#13;
when currency_type = &apos;BND&apos; then round(order_amount*1, 2)&#13;
when currency_type = &apos;GBP&apos; then round(order_amount*1.86985, 2)&#13;
when currency_type = &apos;NZD&apos; then round(order_amount*0.92, 2)&#13;
when currency_type = &apos;PHP&apos; then round(order_amount*0.028, 2)&#13;
when currency_type = &apos;HKD&apos; then round(order_amount*0.17, 2)&#13;
when currency_type = &apos;EUR&apos; then round(order_amount*1.61, 2)&#13;
when currency_type = &apos;THB&apos; then round(order_amount*0.041, 2)&#13;
when currency_type = &apos;USD&apos; then round(order_amount*1.34386, 2)&#13;
when currency_type = &apos;TWD&apos; then round(order_amount*0.047, 2)&#13;
else round(order_amount, 2) end as total_amount,&#13;
ecms_merchant_name, cms_merchant_name, merchant_key, Merchant_id, RestaurantName, Chain_Name_in_system,&#13;
CASE WHEN isstandalone = 0 THEN &apos;pos_integrated&apos;&#13;
else &apos;standalone&apos; end as isstandalone,&#13;
pos_integration_type, &#13;
CASE WHEN webhook_status = 1 THEN &apos;new_flow&apos;&#13;
else &apos;old_flow&apos; end as webhook_status,&#13;
DATE(created_date) as created_date, order_date&#13;
from &#13;
(select o.id, o.status as order_status, op.payment_type,  spt.order_id as spt_order_id, op.status as op_status, o.order_amount, o.restaurant_id, spt.status as spt_status,&#13;
case when org.name is null then ml.Merchant_id else org.merchant_key end as merchant_key, ml.Merchant_id,&#13;
case when org.country is null then u.country else org.country end as country,&#13;
case when org.currency_type is null then u.currency_type else org.currency_type end as currency_type,&#13;
org.name as ecms_merchant_name, u.name as cms_merchant_name,  &#13;
case when ss.is_standalone is null then cs.is_standalone else ss.is_standalone end as isstandalone,&#13;
case when ss.pos_integration_type is null then cs.pos_integration_type else ss.pos_integration_type end as pos_integration_type,&#13;
pwc.webhook_status, o.created_date, o.order_date, ml.RestaurantName, ml.Chain_Name_in_system&#13;
from `tabsquare_dw_skipque_prod.skipque_orders` as o&#13;
left join `tabsquare-data-sciences.tabsquare_dw_skipque_prod.order_payments` as op ON op.order_id = o.id&#13;
left join `tabsquare-data-sciences.tabsquare_dw_skipque_prod.smartweb_payment_trans` spt ON spt.order_id = o.id&#13;
left join `tabsquare-data-sciences.tabsquare_dw_skipque_prod.ecms_organization` as org ON org.id = o.restaurant_id&#13;
left join `tabsquare-data-sciences.tabsquare_dw_skipque_prod.users` as u on u.id = o.restaurant_id&#13;
left join `tabsquare-data-sciences.tabsquare_dw_skipque_prod.skipque_smartweb_setting` as ss ON  ss.created_by = u.id&#13;
left join `tabsquare-data-sciences.skipque_cdc_data_prod.chain_setting` as cs ON cs.organization_id = org.organization_id&#13;
left join `tabsquare-data-sciences.skipque_cdc_data_prod.payment_webhook_config` as pwc ON pwc.restaurant_id = o.restaurant_id&#13;
left join `tabsquare-data-sciences.tabsquare_dw_lookups.master_merchant_list` as ml on ml.Merchant_id = org.merchant_key&#13;
where o.status &gt;&gt; 0 and op.payment_type = &apos;stripe&apos; and spt.order_id is null and org.is_test_account != 1&#13;
and o.order_date &gt;&gt;= &apos;2022-08-01&apos;&#13;
and op.order_date &gt;&gt;= &apos;2022-08-01&apos;)</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
