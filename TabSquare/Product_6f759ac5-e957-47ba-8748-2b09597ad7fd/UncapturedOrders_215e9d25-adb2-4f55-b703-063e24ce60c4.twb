org.name as ecms_merchant_name, u.name as cms_merchant_name,  &#13;
case when ss.is_standalone is null then cs.is_standalone else ss.is_standalone end as isstandalone,&#13;
case when ss.pos_integration_type is null then cs.pos_integration_type else ss.pos_integration_type end as pos_integration_type,&#13;
pwc.webhook_status, o.created_date, o.order_date, ml.RestaurantName, ml.Chain_Name_in_system&#13;
from `tabsquare_dw_skipque_prod.skipque_orders` as o&#13;
left join `tabsquare-data-sciences.tabsquare_dw_skipque_prod.order_payments` as op ON op.order_id = o.id&#13;
left join `tabsquare-data-sciences.tabsquare_dw_skipque_prod.smartweb_payment_trans` spt ON spt.order_id = o.id&#13;
left join `tabsquare-data-sciences.tabsquare_dw_skipque_prod.ecms_organization` as org ON org.id = o.restaurant_id&#13;
left join `tabsquare-data-sciences.tabsquare_dw_skipque_prod.users` as u on u.id = o.restaurant_id&#13;
left join `tabsquare-data-sciences.tabsquare_dw_skipque_prod.skipque_smartweb_setting` as ss ON  ss.created_by = u.id&#13;
left join `tabsquare-data-sciences.skipque_cdc_data_prod.chain_setting` as cs ON cs.organization_id = org.organization_id&#13;
left join `tabsquare-data-sciences.skipque_cdc_data_prod.payment_webhook_config` as pwc ON pwc.restaurant_id = o.restaurant_id&#13;
left join `tabsquare-data-sciences.tabsquare_dw_lookups.master_merchant_list` as ml on ml.Merchant_id = org.merchant_key&#13;
where o.status &gt;&gt; 0 and op.payment_type = &apos;stripe&apos; and spt.order_id is null and org.is_test_account != 1&#13;
and o.order_date &gt;&gt;= &apos;2022-08-01&apos;&#13;
