      <aliases enabled='yes' />
      <column caption='Date Range' datatype='integer' name='[Calculation_1176002457117241344]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [created_date] &gt;= [Parameters].[Parameter 1] and [created_date] &lt;= [Parameters].[Parameter 2] then 1 else 0 end' />
      </column>
      <column caption='CNT ECMS' datatype='integer' name='[Calculation_1176002457171222529]' role='measure' type='quantitative'>
