          <named-connection caption='BigQuery' name='bigquery.1sa3o0m1gm30l7146omr70xzwrxn'>
            <connection CATALOG='tabsquare-data-sciences' EXECCATALOG='tabsquare-data-sciences' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tabsquare-data-sciences' schema='tabsquare_dw_skipque_prod' server-oauth='' username='akshay.r@deliveryhero.in' workgroup-auth-mode='prompt' />
          </named-connection>
