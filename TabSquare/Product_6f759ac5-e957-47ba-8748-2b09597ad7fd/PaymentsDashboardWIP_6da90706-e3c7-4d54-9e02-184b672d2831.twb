      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_944B3AEAEA51458DA0B403D7B2085740'>
            <properties context=''>
              <relation connection='bigquery.1tlv76v0g8qncp188poos1tqrduc' name='Custom SQL Query' type='text'>SELECT p.*, CASE WHEN p.payment_type like &apos;stripe%&apos; or p.payment_type like &apos;STRIPE%&apos; or p.payment_type like &apos;Stripe&apos; THEN &apos;Stripe&apos;&#13;
WHEN p.payment_type like &apos;rapyd%&apos; or p.payment_type like &apos;Rapyd%&apos; THEN &apos;Rapyd&apos;&#13;
WHEN p.payment_type like &apos;Raz%&apos; or p.payment_type like &apos;RAZ%&apos; THEN &apos;RazerPay&apos;&#13;
WHEN p.payment_type like &apos;CHECKOUT%&apos; or p.payment_type like &apos;checkout%&apos; THEN &apos;Checkout&apos;&#13;
WHEN p.payment_type LIKE &apos;wechat_pay%&apos; THEN &apos;Stripe&apos;&#13;
else p.payment_type end as PaymentPartner, spt.restaurant_id, bi.merchant_key, org.name as merchant_name, spt.total, c.name as Country, bi.app_type,&#13;
CASE WHEN p.paymentchannel_source like &apos;PC Terminal%&apos; THEN &apos;PC Terminal&apos;&#13;
WHEN bi.app_type = &apos;11&apos; THEN &apos;PostPay&apos;&#13;
WHEN bi.app_type = &apos;4&apos; THEN &apos;SmartPay&apos; &#13;
else p.paymentchannel_source END AS Product_type, &#13;
date(p.created_at) as created_date &#13;
FROM `tabsquare-data-sciences.skipque_cdc_data_prod.smartpay_payment_prod` p&#13;
left join `tabsquare-data-sciences.skipque_cdc_data_prod.smartpay_bill_info_prod` bi on bi.id = p.bill_info_id&#13;
left join `tabsquare-data-sciences.skipque_cdc_data_prod.smartweb_payment_transactions` spt on p.payment_code = spt.session_id&#13;
left join `tabsquare-data-sciences.skipque_cdc_data_prod.organization` org on bi.merchant_key = org.merchant_key&#13;
left join `tabsquare-data-sciences.skipque_cdc_data_prod.country` c on org.country_id = c.id&#13;
where p.paymentchannel_source NOT LIKE &apos;%PC TerminaPCTerminal SmartwebSmartWeb SmartPAYSmartPAY PC TerminaPCTerminal SmartwebSmartWeb Smar123%&apos;&#13;
and p.payment_type not like &apos;Alfred%&apos; and p.payment_type not like &apos;%ALFRED%&apos; and p.payment_type not like &apos;alfred%&apos;&#13;
order by p.created_at desc</relation>
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
