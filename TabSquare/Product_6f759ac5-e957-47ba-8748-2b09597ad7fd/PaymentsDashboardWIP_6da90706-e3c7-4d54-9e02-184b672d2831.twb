  <worksheets>
    <worksheet name='Active Brands'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (skipque_cdc_data_prod)' name='federated.1qchkd017r11k117cppu81g69kl0' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.RefreshableParameterRanges.true...default-value-field='[federated.1qchkd017r11k117cppu81g69kl0].[Calculation_262616221004578817]' _.fcp.RefreshableParameterRanges.true...source-field='[federated.1qchkd017r11k117cppu81g69kl0].[created_date]' caption='Start Date' datatype='date' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='#2023-06-23#'>
              <calculation class='tableau' formula='#2023-06-23#' />
            </column>
            <column _.fcp.RefreshableParameterRanges.true...default-value-field='[federated.1qchkd017r11k117cppu81g69kl0].[Calculation_262616221004419072]' _.fcp.RefreshableParameterRanges.true...source-field='[federated.1qchkd017r11k117cppu81g69kl0].[created_date]' caption='End Date' datatype='date' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='#2023-06-29#'>
              <calculation class='tableau' formula='#2023-06-29#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1qchkd017r11k117cppu81g69kl0'>
            <column caption='Brand Name' datatype='string' name='[Brand_Name]' role='dimension' type='nominal' />
            <column caption='Time Period' datatype='integer' name='[Calculation_2205637937085865984]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Parameters].[Parameter 1], [Parameters].[Parameter 2])+1' />
            </column>
            <column caption='Compare Start Date' datatype='date' name='[Calculation_2205637937086087169]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='date(DATEADD(&apos;day&apos;,-1*[Calculation_2205637937085865984],[Parameters].[Parameter 1]))' />
            </column>
            <column caption='Compare End Date' datatype='date' name='[Calculation_2205637937086136322]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='date(DATEADD(&apos;day&apos;,-1,[Parameters].[Parameter 1]))' />
            </column>
            <column caption='Compare Time Period Filter' datatype='integer' name='[Calculation_2205637937086345219]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [created_date] &gt;= [Calculation_2205637937086087169] and [created_date] &lt;= [Calculation_2205637937086136322] then 1 else 0 end' />
            </column>
            <column aggregation='Sum' caption='dummy' datatype='integer' name='[Calculation_2205637937453686799]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Current Brand Count' datatype='integer' name='[Calculation_2205637937469820947]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(if [Calculation_262616221004886018]=1 then [Brand_Name] end)' />
            </column>
            <column caption='Compare Brand Count' datatype='integer' name='[Calculation_2205637937469960212]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(if [Calculation_2205637937086345219]=1 then [Brand_Name] end)' />
            </column>
            <column caption='Change in Brand Count' datatype='real' name='[Calculation_2205637937470054421]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_2205637937469820947]-[Calculation_2205637937469960212])/[Calculation_2205637937469960212]' />
            </column>
            <column caption='if [Change in Brand Count]&lt;=0 then -1 else 1 end' datatype='integer' name='[Calculation_2205637937471807511]' role='measure' type='quantitative' user:unnamed='Total Brands'>
              <calculation class='tableau' formula='if [Calculation_2205637937470054421]&lt;=0 then -1 else 1 end' />
            </column>
            <column caption='Latest End Date' datatype='date' name='[Calculation_262616221004419072]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{fixed :max(date(DATEADD(&apos;day&apos;,-1,{fixed: max([created_date])})))}' />
            </column>
            <column caption='Latest Start Date' datatype='date' name='[Calculation_262616221004578817]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{fixed: max(date(DATETRUNC(&apos;day&apos;, [Calculation_262616221004419072] - 6)))}' />
            </column>
            <column aggregation='Sum' caption='Current Time Period' datatype='integer' name='[Calculation_262616221004886018]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [created_date] &gt;= [Parameters].[Parameter 1] and &#13;&#10;[created_date] &lt;= [Parameters].[Parameter 2] then 1 else 0 END' />
            </column>
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Payment Partner' datatype='string' name='[PaymentPartner]' role='dimension' type='nominal' />
            <column datatype='string' name='[Product_Type]' role='dimension' type='nominal' />
            <column datatype='date' name='[created_date]' role='dimension' type='ordinal' />
            <column aggregation='Sum' caption='dummy (copy)' datatype='real' name='[dummy (copy)_2205637937453944848]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='0.7' />
            </column>
            <column caption='Merchant Name' datatype='string' name='[merchant_name]' role='dimension' type='nominal' />
            <column-instance column='[Brand_Name]' derivation='None' name='[none:Brand_Name:nk]' pivot='key' type='nominal' />
