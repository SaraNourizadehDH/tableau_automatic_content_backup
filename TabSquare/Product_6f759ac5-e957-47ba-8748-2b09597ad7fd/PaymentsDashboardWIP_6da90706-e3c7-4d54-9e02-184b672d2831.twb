      <column caption='Brand Name' datatype='string' name='[Brand_Name]' role='dimension' type='nominal' />
      <column caption='pending GMV' datatype='real' default-format='c&quot; $&quot;#,##0.00;&quot; $&quot;-#,##0.00' name='[Calculation_1142225474697498626]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Order Amount (copy)_1574571051724603393]) - sum([stripe_payout_amount])' />
      </column>
      <column aggregation='Count' caption='ConfirmedOrders' datatype='integer' name='[Calculation_1495758040157937664]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [ts_order_status]= &apos;CONFIRMED&apos; and NOT [payment_type] IN (&apos;CASHAC&apos;, &apos;CASH&apos;) THEN [order_id] END' />
      </column>
      <column caption='ConfirmedAmount' datatype='real' name='[Calculation_1495758040158990337]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [ts_order_status]= &apos;CONFIRMED&apos; and NOT [payment_type] IN (&apos;CASHAC&apos;, &apos;CASH&apos;) THEN [converted_order_amount] END' />
      </column>
      <column aggregation='Count' caption='UnconfirmedOrders' datatype='integer' name='[Calculation_1495758040160702466]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [ts_order_status] IN (&apos;UNCONFIRMED&apos;, &apos;UNPAID&apos;) and NOT [payment_type] IN (&apos;CASHAC&apos;, &apos;CASH&apos;) THEN [order_id] END' />
      </column>
      <column caption='UnconfirmedAmount' datatype='real' name='[Calculation_1495758040160894979]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [ts_order_status] IN (&apos;UNCONFIRMED&apos;, &apos;UNPAID&apos;) and NOT [payment_type] IN (&apos;CASHAC&apos;, &apos;CASH&apos;) THEN [converted_order_amount] END' />
      </column>
      <column aggregation='Count' caption='RefundedOrders' datatype='real' name='[Calculation_1495758040162762756]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[refund_amount]' />
      </column>
      <column caption='RefundedAmount' datatype='real' name='[Calculation_1495758040162992133]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [ts_order_status] = &apos;REFUNDED&apos; and NOT [payment_type] IN (&apos;CASHAC&apos;, &apos;CASH&apos;) THEN [converted_order_amount] END' />
      </column>
      <column aggregation='Count' caption='CapturedOrders' datatype='integer' name='[Calculation_1495758040163598342]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [payment_status] = 1 and NOT [payment_type] IN (&apos;CASHAC&apos;, &apos;CASH&apos;) THEN [order_id] END' />
      </column>
      <column caption='CapturedAmount' datatype='real' name='[Calculation_1495758040164323335]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [payment_status] = 1 and NOT [payment_type] IN (&apos;CASHAC&apos;, &apos;CASH&apos;) THEN [converted_order_amount] END' />
      </column>
      <column aggregation='Count' caption='UncapturedOrders' datatype='integer' name='[Calculation_1495758040164724744]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [payment_status] = -4 and NOT [payment_type] IN (&apos;CASHAC&apos;, &apos;CASH&apos;) THEN [order_id] END' />
      </column>
      <column caption='UncapturedAmount' datatype='real' name='[Calculation_1495758040164896777]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [payment_status] = -4 and NOT [payment_type] IN (&apos;CASHAC&apos;, &apos;CASH&apos;) THEN [converted_order_amount] END' />
      </column>
      <column aggregation='Count' caption='CancelledOrders' datatype='integer' name='[Calculation_1495758040165126154]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [payment_status] IN (2, 0) and NOT [payment_type] IN (&apos;CASHAC&apos;, &apos;CASH&apos;) THEN [order_id] END' />
      </column>
      <column caption='CancelledAmount' datatype='real' name='[Calculation_1495758040165347339]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [payment_status] IN (2, 0) and NOT [payment_type] IN (&apos;CASHAC&apos;, &apos;CASH&apos;) THEN [converted_order_amount] END' />
      </column>
      <column aggregation='Count' caption='RejectedOrders' datatype='integer' name='[Calculation_1495758040165597196]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [ts_order_status]= &apos;REJECTED&apos; and NOT [payment_type] IN (&apos;CASHAC&apos;, &apos;CASH&apos;) THEN [order_id] END' />
      </column>
      <column caption='RejectedAmount' datatype='real' name='[Calculation_1495758040165777421]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [ts_order_status]= &apos;REJECTED&apos; and NOT [payment_type] IN (&apos;CASHAC&apos;, &apos;CASH&apos;) THEN [converted_order_amount] END' />
      </column>
      <column caption='test' datatype='integer' name='[Calculation_1495758041605279766]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  [ts_order_status] IN(&apos;UNCONFIRMED&apos;, &apos;REFUNDED&apos;, &apos;REJECTED&apos;)&#13;&#10;THEN [order_id] END' />
      </column>
      <column caption='etst1' datatype='integer' name='[Calculation_1495758041607127063]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [ts_order_status]= &apos;CONFIRMED&apos; THEN [order_id] END' />
      </column>
      <column caption='Selected Time Interval' datatype='date' name='[Calculation_2024368058809315328]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 5]=&apos;Year&apos; then date(DATETRUNC(&apos;year&apos;, [created_date]))&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;Quarter&apos; then date(DATETRUNC(&apos;quarter&apos;, [created_date]))&#13;&#10;elseif [Parameters].[Parameter 5]=&apos;Month&apos; then date(DATETRUNC(&apos;month&apos;, [created_date]))&#13;&#10;elseif [Parameters].[Parameter 5]=&apos;Week&apos; then date(DATETRUNC(&apos;week&apos;, [created_date]))&#13;&#10;elseif [Parameters].[Parameter 5]=&apos;Day&apos; then date(DATETRUNC(&apos;day&apos;, [created_date]))&#13;&#10;end' />
