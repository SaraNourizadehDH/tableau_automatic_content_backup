      </column>
      <column caption='Current Transaction Count' datatype='integer' name='[Calculation_1418633922399514639]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(IF [Calculation_1132936806448791556] = 1 THEN [payment_code] end)' />
