      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (skipque_cdc_data_prod)' name='federated.1qchkd017r11k117cppu81g69kl0' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.RefreshableParameterRanges.true...default-value-field='[federated.1qchkd017r11k117cppu81g69kl0].[Calculation_262616221004578817]' _.fcp.RefreshableParameterRanges.true...source-field='[federated.1qchkd017r11k117cppu81g69kl0].[created_date]' caption='Start Date' datatype='date' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='#2023-06-23#'>
              <calculation class='tableau' formula='#2023-06-23#' />
            </column>
            <column _.fcp.RefreshableParameterRanges.true...default-value-field='[federated.1qchkd017r11k117cppu81g69kl0].[Calculation_262616221004419072]' _.fcp.RefreshableParameterRanges.true...source-field='[federated.1qchkd017r11k117cppu81g69kl0].[created_date]' caption='End Date' datatype='date' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='#2023-06-29#'>
              <calculation class='tableau' formula='#2023-06-29#' />
            </column>
            <column caption='Select Time Interval' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
              <calculation class='tableau' formula='&quot;Day&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1qchkd017r11k117cppu81g69kl0'>
            <column caption='Brand Name' datatype='string' name='[Brand_Name]' role='dimension' type='nominal' />
            <column caption='Selected Time Interval' datatype='date' name='[Calculation_2024368058809315328]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 5]=&apos;Year&apos; then date(DATETRUNC(&apos;year&apos;, [created_date]))&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;Quarter&apos; then date(DATETRUNC(&apos;quarter&apos;, [created_date]))&#13;&#10;elseif [Parameters].[Parameter 5]=&apos;Month&apos; then date(DATETRUNC(&apos;month&apos;, [created_date]))&#13;&#10;elseif [Parameters].[Parameter 5]=&apos;Week&apos; then date(DATETRUNC(&apos;week&apos;, [created_date]))&#13;&#10;elseif [Parameters].[Parameter 5]=&apos;Day&apos; then date(DATETRUNC(&apos;day&apos;, [created_date]))&#13;&#10;end' />
            </column>
            <column caption='Latest End Date' datatype='date' name='[Calculation_262616221004419072]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{fixed :max(date(DATEADD(&apos;day&apos;,-1,{fixed: max([created_date])})))}' />
            </column>
            <column caption='Latest Start Date' datatype='date' name='[Calculation_262616221004578817]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{fixed: max(date(DATETRUNC(&apos;day&apos;, [Calculation_262616221004419072] - 6)))}' />
            </column>
            <column aggregation='Sum' caption='Current Time Period' datatype='integer' name='[Calculation_262616221004886018]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [created_date] &gt;= [Parameters].[Parameter 1] and &#13;&#10;[created_date] &lt;= [Parameters].[Parameter 2] then 1 else 0 END' />
            </column>
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[Product_Type]' role='dimension' type='nominal' />
            <column datatype='date' name='[created_date]' role='dimension' type='ordinal' />
            <column-instance column='[stripe_payout_id]' derivation='CountD' name='[ctd:stripe_payout_id:qk]' pivot='key' type='quantitative' />
            <column caption='Merchant Name' datatype='string' name='[merchant_name]' role='dimension' type='nominal' />
            <column-instance column='[Brand_Name]' derivation='None' name='[none:Brand_Name:nk]' pivot='key' type='nominal' />
