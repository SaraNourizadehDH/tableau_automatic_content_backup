    <datasource caption='Custom SQL Query (skipque_cdc_data_prod)' inline='true' name='federated.1qchkd017r11k117cppu81g69kl0' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.17s5nlv0kuvpx714yihs817ujqfc'>
            <connection CATALOG='tabsquare-data-sciences' EXECCATALOG='tabsquare-data-sciences' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tabsquare-data-sciences' schema='skipque_cdc_data_prod' server-oauth='' username='akshay.r@deliveryhero.in' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.17s5nlv0kuvpx714yihs817ujqfc' name='Custom SQL Query' type='text'>select *,&#13;
case when currency_type = &apos;MYR&apos; then (order_amount*0.33)&#13;
when currency_type =&apos;IDR&apos; then (order_amount*0.000092)&#13;
when currency_type =&apos;Rp&apos; then (order_amount*0.000092) &#13;
when currency_type = &apos;AUD&apos; then (order_amount*1)&#13;
when currency_type = &apos;BND&apos; then (order_amount*1)&#13;
when currency_type = &apos;GBP&apos; then (order_amount*1.86985)&#13;
when currency_type = &apos;NZD&apos; then (order_amount*0.92)&#13;
when currency_type = &apos;PHP&apos; then (order_amount*0.028)&#13;
when currency_type = &apos;HKD&apos; then (order_amount*0.17)&#13;
when currency_type = &apos;EUR&apos; then (order_amount*1.61)&#13;
when currency_type = &apos;THB&apos; then (order_amount*0.041)&#13;
when currency_type = &apos;USD&apos; then (order_amount*1.34386)&#13;
when currency_type = &apos;TWD&apos; then (order_amount*0.047)&#13;
WHEN currency_type = &apos;Â£&apos; then (order_amount*1.61)&#13;
when currency_type = &apos;AED&apos; then round(order_amount*0.37, 2)&#13;
when Country like &apos;%French Guiana%&apos; then round(order_amount*0.00016, 2)&#13;
when Country like &apos;%United Kingdom%&apos; then round(order_amount*1.68, 2)&#13;
else (order_amount) end as converted_order_amount,&#13;
case when currency_type = &apos;MYR&apos; then round(refund_amount*0.33, 2) &#13;
when currency_type =&apos;IDR&apos; then round(refund_amount*0.000092, 2)&#13;
when currency_type =&apos;Rp&apos; then round(refund_amount*0.000092, 2) &#13;
when currency_type = &apos;AUD&apos; then round(refund_amount*1, 2)&#13;
when currency_type = &apos;BND&apos; then round(refund_amount*1, 2)&#13;
when currency_type = &apos;GBP&apos; then round(refund_amount*1.86985, 2)&#13;
when currency_type = &apos;NZD&apos; then round(refund_amount*0.92, 2)&#13;
when currency_type = &apos;PHP&apos; then round(refund_amount*0.028, 2)&#13;
when currency_type = &apos;HKD&apos; then round(refund_amount*0.17, 2)&#13;
when currency_type = &apos;EUR&apos; then round(refund_amount*1.61, 2)&#13;
when currency_type = &apos;THB&apos; then round(refund_amount*0.041, 2)&#13;
when currency_type = &apos;USD&apos; then round(refund_amount*1.34386, 2)&#13;
when currency_type = &apos;TWD&apos; then round(refund_amount*0.047, 2)&#13;
when currency_type = &apos;AED&apos; then round(refund_amount*0.37, 2)&#13;
when Country like &apos;%French Guiana%&apos; then round(refund_amount*0.00016, 2)&#13;
when Country like &apos;%United Kingdom%&apos; then round(refund_amount*1.68, 2)&#13;
else round(refund_amount, 2) end as converted_refund_amount,&#13;
case when currency_type = &apos;MYR&apos; then round(orderpayment_amount*0.33, 2) &#13;
when currency_type =&apos;IDR&apos; then round(orderpayment_amount*0.000092, 2)&#13;
when currency_type =&apos;Rp&apos; then round(orderpayment_amount*0.000092, 2) &#13;
when currency_type = &apos;AUD&apos; then round(orderpayment_amount*1, 2)&#13;
when currency_type = &apos;BND&apos; then round(orderpayment_amount*1, 2)&#13;
when currency_type = &apos;GBP&apos; then round(orderpayment_amount*1.86985, 2)&#13;
when currency_type = &apos;NZD&apos; then round(orderpayment_amount*0.92, 2)&#13;
when currency_type = &apos;PHP&apos; then round(orderpayment_amount*0.028, 2)&#13;
when currency_type = &apos;HKD&apos; then round(orderpayment_amount*0.17, 2)&#13;
when currency_type = &apos;EUR&apos; then round(orderpayment_amount*1.61, 2)&#13;
when currency_type = &apos;THB&apos; then round(orderpayment_amount*0.041, 2)&#13;
when currency_type = &apos;USD&apos; then round(orderpayment_amount*1.34386, 2)&#13;
when currency_type = &apos;TWD&apos; then round(orderpayment_amount*0.047, 2)&#13;
else round(orderpayment_amount, 2) end as converted_op_amount,&#13;
CASE WHEN ts_order_status = &apos;CONFIRMED&apos; and payment_type not in (&apos;cashac&apos;, &apos;cash&apos;) THEN &apos;Confirmed Orders&apos;&#13;
WHEN ts_order_status IN (&apos;UNCONFIRMED&apos;, &apos;UNPAID&apos;) and payment_type not in (&apos;cashac&apos;, &apos;cash&apos;) THEN &apos;Unconfirmed Orders&apos;&#13;
WHEN ts_order_status = &apos;REFUNDED&apos; and payment_type not in (&apos;cashac&apos;, &apos;cash&apos;) THEN &apos;Refunded Orders&apos;&#13;
WHEN ts_order_status = &apos;REJECTED&apos; and payment_type not in (&apos;cashac&apos;, &apos;cash&apos;) THEN &apos;Rejected Orders&apos;&#13;
END as OrderType,&#13;
CASE WHEN payment_status = 1 and payment_type not in (&apos;cashac&apos;, &apos;cash&apos;) THEN &apos;Captured Orders&apos;&#13;
WHEN payment_status = -4 and payment_type not in (&apos;cashac&apos;, &apos;cash&apos;) THEN &apos;Uncaptured Orders&apos;&#13;
WHEN payment_status in (2, 0)  and payment_type not in (&apos;cashac&apos;, &apos;cash&apos;) THEN &apos;Cancelled Orders&apos;&#13;
END as OrderPaymentType&#13;
from&#13;
(select o.id as order_id, o.status as order_status, &#13;
CASE WHEN o.status = -4 THEN &apos;UNCONFIRMED&apos;&#13;
	 WHEN o.status = -3 THEN &apos;REJECTED&apos;&#13;
	 WHEN o.status = -2 THEN &apos;UNCONFIRMED&apos;&#13;
	 WHEN o.status = -1 THEN &apos;UNASSIGNED&apos;&#13;
	 WHEN o.status = 0 THEN &apos;UNCONFIRMED&apos;&#13;
	 WHEN o.status = 1 THEN &apos;CONFIRMED&apos;&#13;
	 WHEN o.status = 2 THEN &apos;CONFIRMED&apos;&#13;
	 WHEN o.status = 3 THEN &apos;CONFIRMED&apos;&#13;
	 WHEN o.status = 4 THEN &apos;UNASSIGNED&apos;&#13;
	 WHEN o.status = 5 THEN &apos;UNASSIGNED&apos;&#13;
	 WHEN o.status = 6 THEN &apos;REFUNDED&apos;&#13;
	 WHEN o.status = -6 THEN &apos;REFUNDED&apos;&#13;
	 WHEN o.status = 7 THEN &apos;Driver Assigned/Success&apos;&#13;
ELSE CAST(o.status as STRING)&#13;
END AS ts_order_status,&#13;
spt.status as payment_status,&#13;
CASE WHEN op.status = -1 THEN &apos;TIMEOUT&apos;&#13;
WHEN op.status = 0 THEN &apos;PENDING&apos;&#13;
when op.status = 2 then &apos;FAILED&apos;&#13;
when op.status = 3 THEN &apos;SUCCESS&apos;&#13;
WHEN op.status = 4 THEN &apos;CANCEL&apos;&#13;
WHEN op.status = 1 THEN &apos;UNPAID&apos;&#13;
else CAST(op.status as STRING) end as orderpayment_status, op.amount as orderpayment_amount,&#13;
case when or1.refund_source = 1 then &apos;Auto Refund&apos;&#13;
WHEN or1.refund_source = 2 THEN &apos;Manual Refund&apos;&#13;
end as refundsource,&#13;
CASE WHEN spt.order_session_id in (select p.sp_session_id from `tabsquare-data-sciences.tabsquare_payment_data.payments` p) THEN &apos;SmartPay&apos; else &apos;SmartWeb&apos; end as Smart,&#13;
CASE WHEN u.username is null THEN org.merchant_key else u.customer_key end as merchant_key,&#13;
CASE WHEN u.username is null THEN org.name else u.name end as merchant_name,&#13;
CASE WHEN u.username is null THEN org1.name else u.name end as Brand_Name,&#13;
CASE WHEN u.username is null THEN &apos;ECMS&apos; else &apos;CMS&apos; end as System,&#13;
CASE WHEN u.username is null THEN c.name else c1.name end as Country,&#13;
CASE WHEN u.username is null THEN org.currency_type else u.currency_type end as currency_type, o.order_amount, or1.amount as refund_amount, or1.refund_type, or1.refund_reason,&#13;
lower(op.payment_type) as payment_type,&#13;
CASE WHEN op.payment_type like &apos;stripe%&apos; or op.payment_type like &apos;STRIPE%&apos; or op.payment_type like &apos;Stripe&apos; THEN &apos;Stripe&apos;&#13;
WHEN op.payment_type like &apos;rapyd%&apos; or op.payment_type like &apos;Rapyd%&apos; THEN &apos;Rapyd&apos;&#13;
WHEN op.payment_type like &apos;Raz%&apos; or op.payment_type like &apos;RAZ%&apos; THEN &apos;RazerPay&apos;&#13;
WHEN op.payment_type like &apos;CHECKOUT%&apos; or op.payment_type like &apos;checkout%&apos; THEN &apos;Checkout&apos;&#13;
else op.payment_type end as PaymentPartner,&#13;
CASE WHEN at1.name is NULL THEN at2.name else at1.name end as Product_Type,&#13;
o.app_type,&#13;
coalesce(pwc.webhook_status,if (lower(op.payment_type) like &apos;%stripe%&apos;,if(coalesce(ssc.webhook_allow_all,ssc2.webhook_allow_all) =0,0,(if(coalesce(ssc.webhook_allow_all,ssc2.webhook_allow_all) =1,1,&#13;
if(coalesce(cs.is_standalone,ss.is_standalone)=0,0,1)))),1)) as old_new_flow,&#13;
CASE WHEN ss.is_standalone = 0 THEN &apos;POS Integrated&apos;&#13;
WHEN cs.is_standalone = 0 THEN &apos;POS Integrated&apos;&#13;
WHEN ss.is_standalone = 1 THEN &apos;Not Integrated&apos;&#13;
WHEN ss.is_standalone IS NULL THEN &apos;Not Integrated&apos;&#13;
WHEN cs.is_standalone = 1 THEN &apos;Not Integrated&apos;&#13;
WHEN cs.is_standalone IS NULL THEN &apos;Not Integrated&apos;&#13;
else &apos;UNKNOWN&apos; end as Integration,&#13;
CASE WHEN o.id in (select ops.order_id from `tabsquare-data-sciences.skipque_cdc_data_prod.order_pos_status` ops) then &apos;POS Integrated&apos; else &apos;Not Integrated&apos; end as pos_or_not,&#13;
rp.payout_status as rapyd_payout_status, rp.payout_date as rapyd_payout_date, rpd.payout_id as rapyd_payout_id,&#13;
sp.payout_created_date as stripe_payout_date, spd.payout_id as stripe_payout_id,&#13;
coalesce(spd.payout_id, cast(rpd.payout_id as string)) as payout_id,&#13;
DATE(coalesce(spd.payout_created_date,rp.payout_date)) as payout_date, (spd.transfer_amount + spd.commission_fee) as stripe_payout_amount, rp.payout_amount as rapyd_payout_amount,&#13;
coalesce(spd.transfer_amount,rp.payout_amount,0) as paid_amount, &#13;
date(o.created_date) as created_date, date(or1.created_date) as refund_date, EXTRACT(HOUR FROM o.created_date) as hour, op.created_date as payment_date, o.created_date as datetime_&#13;
from `tabsquare-data-sciences.skipque_cdc_data_prod.orders` as o&#13;
left join `tabsquare-data-sciences.skipque_cdc_data_prod.order_payments` as op on o.id = op.order_id&#13;
left join `tabsquare-data-sciences.skipque_cdc_data_prod.organization` as org on o.restaurant_id = org.id&#13;
left join `tabsquare-data-sciences.skipque_cdc_data_prod.organization` as org1 on org.organization_id = org1.id&#13;
left join `tabsquare-data-sciences.skipque_cdc_data_prod.users` as u on o.restaurant_id = u.id&#13;
left join `tabsquare-data-sciences.skipque_cdc_data_prod.app_types` at1 on o.app_type = at1.id&#13;
left join `tabsquare-data-sciences.skipque_cdc_data_prod.app_type` at2 on o.app_type = at2.id&#13;
left join `tabsquare-data-sciences.skipque_cdc_data_prod.country` as c on org.country_id = c.id&#13;
left join `tabsquare-data-sciences.skipque_cdc_data_prod.country` as c1 on u.country_code = c1.iso&#13;
left join `tabsquare-data-sciences.skipque_cdc_data_prod.order_refund` as or1 on o.id = or1.order_id&#13;
left join `tabsquare-data-sciences.skipque_cdc_data_prod.smartweb_settings` as ss on u.id = ss.created_by &#13;
LEFt join `tabsquare-data-sciences.skipque_cdc_data_prod.chain_setting` as cs on org.id = cs.organization_id&#13;
left join `tabsquare-data-sciences.dashboard_validation_data.user_login` as ul on cast(o.restaurant_id as string) = ul.restaurant_id&#13;
LEFT JOIN `tabsquare-data-sciences.skipque_cdc_data_prod.payment_webhook_config` as pwc on pwc.Merchant_key = ul.merchant_id&#13;
LEFT JOIN `tabsquare-data-sciences.skipque_cdc_data_prod.smartweb_stripe_config` as ssc on lower(ssc.country) =lower(u.country)&#13;
LEFT JOIN `tabsquare-data-sciences.skipque_cdc_data_prod.smartweb_stripe_config` as ssc2 on lower(ssc2.country) =lower(c.name)&#13;
LEFT JOIN `tabsquare-data-sciences.skipque_cdc_data_prod.rapyd_payout_details` rpd on o.id = rpd.order_id&#13;
LEFT JOIN `tabsquare-data-sciences.skipque_cdc_data_prod.rapyd_payouts` rp on rpd.payout_id = rp.id&#13;
LEFT join `tabsquare-data-sciences.skipque_cdc_data_prod.stripe_merchant_payout_details` as spd on CAST(o.id as STRING) = spd.order_id &#13;
left join `tabsquare-data-sciences.skipque_cdc_data_prod.stripe_merchant_payouts` as sp on  spd.payout_id = sp.payout_id&#13;
left join `tabsquare-data-sciences.skipque_cdc_data_prod.smartweb_payment_transactions` as spt on o.id = spt.order_id&#13;
left join `tabsquare-data-sciences.tabsquare_payment_data.payments` p on p.sp_session_id = spt.session_id&#13;
where op.payment_type NOT like &apos;CASH%&apos; and op.payment_type Not LIKE &apos;TA%&apos; and op.payment_type NOT like &apos;ASCENTIS%&apos;&#13;
and op.payment_type not like &apos;3%&apos; and op.payment_type not like &apos;RED%&apos;&#13;
and o.app_type = 4&#13;
and o.created_date &gt;&gt;= &apos;2022-01-01&apos;) as a&#13;
where NOT(LOWER(merchant_name) LIKE (&quot;%test%&quot;)&#13;
    OR LOWER(merchant_name) LIKE (&quot;%demo%&quot;)&#13;
    OR LOWER(merchant_name) LIKE (&quot;%ts cafe%&quot;)&#13;
    OR LOWER(merchant_name) LIKE (&quot;%latest%&quot;))</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
