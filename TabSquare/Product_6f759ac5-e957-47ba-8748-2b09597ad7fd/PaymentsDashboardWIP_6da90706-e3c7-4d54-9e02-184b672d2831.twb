      </column>
      <column caption='Current Sales SP' datatype='real' name='[Calculation_1418633922358943752]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [Calculation_1132936806448791556] = 1 THEN [paid_amount] END)' />
      </column>
      <column caption='Compare Sales' datatype='real' name='[Calculation_1418633922359123977]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [Calculation_1418633922358702087]=1 THEN [paid_amount] END)' />
