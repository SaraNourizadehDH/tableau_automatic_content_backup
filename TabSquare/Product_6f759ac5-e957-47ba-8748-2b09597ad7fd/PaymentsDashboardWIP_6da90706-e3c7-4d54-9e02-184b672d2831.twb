            <column-instance column='[old_new_flow (copy)_2213800693340459008]' derivation='None' name='[none:old_new_flow (copy)_2213800693340459008:nk]' pivot='key' type='nominal' />
            <column caption='Payment Flow' datatype='string' name='[old_new_flow (copy)_2213800693340459008]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [old_new_flow] = 0 THEN &apos;Old Flow&apos;&#13;&#10;ELSEIF [old_new_flow] = 1 THEN &apos;New Flow&apos;&#13;&#10;END' />
            </column>
