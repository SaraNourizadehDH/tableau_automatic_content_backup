      </column>
      <column caption='latest end date_sp' datatype='date' name='[Calculation_1132936806447099906]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{fixed :max(date(DATEADD(&apos;day&apos;,0,{fixed: max([created_date])})))}' />
      </column>
      <column aggregation='Sum' caption='SP Current Time period' datatype='integer' name='[Calculation_1132936806448791556]' role='dimension' type='ordinal'>
