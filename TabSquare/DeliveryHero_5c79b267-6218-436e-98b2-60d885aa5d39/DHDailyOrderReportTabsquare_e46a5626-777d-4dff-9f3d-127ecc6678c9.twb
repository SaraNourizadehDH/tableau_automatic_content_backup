      <column caption='Acq Glovo condition' datatype='integer' name='[Acq (copy)_3173137848211615745]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[acq]' />
      </column>
      <column caption='CC RR vs CC Target Shape' datatype='integer' name='[CC RR vs CC Target (copy)_668292020527763465]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM(IF [Calculation_2129639734081232909] = TRUE THEN [rr_gmv_eur_constant_fx_exc_hient] ELSE 0 END) &#10;/ SUM(IF [Calculation_2129639734081232909] = TRUE THEN [cc_target_eur] ELSE 0 END) -1 &lt; 0 THEN 0 ELSE 1 END' />
      </column>
      <column caption='28 days last year' datatype='integer' name='[Calculation1 (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [report_date]&lt;=[Calculation_3840655741165600769] then [Order Succ Last 7 Days last year (copy)] else 0 end' />
      </column>
      <column caption='AOV w C2C,TS,ODR' datatype='real' name='[Calculation_1683994467049533440]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_5977332299559321620] ) / SUM([Calculation_5977332299559747607])' />
      </column>
      <column caption='GMV YoY Growth' datatype='real' name='[Calculation_1839298285487165440]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gmv_eur])/SUM([d_yoy_gmv_eur_ttl])-1' />
      </column>
      <column caption='GMV Eur w C2C,TS,ODR CC' datatype='real' name='[Calculation_2129639734067413000]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [display_name] IN (&apos;PY - Argentina&apos;,&apos;Yemeksepeti&apos;,&apos;GV - Ghana&apos;) THEN [Calculation_3712795741099884546] ELSE [Y GMV Eur w C2C (copy)_2129639734072037385] / [lucanet_fx_rates_cc_prev_year] END' />
      </column>
      <column caption='CM Flag' datatype='boolean' name='[Calculation_2129639734081232909]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[report_date]) = DATETRUNC(&apos;month&apos;,[Calculation_3840655741165600769])' />
      </column>
      <column caption='New Daily GMV Budget  ' datatype='real' name='[Calculation_2264395827852136449]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Sum({fixed [Calculation_3916865044458033152], [segment], [data_status], [global_entity_id]: [Daily GMV Budget (copy)_2413929409241272320]})' />
      </column>
      <column caption='Order Succ Last 7 Days' datatype='integer' name='[Calculation_295830214181986304]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if DATEDIFF(&apos;day&apos;,[report_date],[Calculation_3840655741165600769])&lt;7 then [ord_succ] end' />
      </column>
      <column caption='7 days last year' datatype='integer' name='[Calculation_295830214210449409]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [report_date]&lt;=[Calculation_3840655741165600769] then [Order Succ Last 7 Days (copy 2)] else 0 end' />
      </column>
      <column caption='Orders Last 28d YoY' datatype='real' default-format='p0.0%' name='[Calculation_295830214211473410]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF sum([Order Succ Last 7 Days (copy)])/sum([Calculation1 (copy)])-1 &gt; 100 THEN NULL &#10;ELSE sum([Order Succ Last 7 Days (copy)])/sum([Calculation1 (copy)])-1 END' />
      </column>
      <column caption='Segment Glovo edit' datatype='string' name='[Calculation_3173137848210575360]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [management_entity] = &apos;Glovo&apos; THEN &apos;Glovo&apos; ELSE [segment] END' />
      </column>
      <column caption='YoY Orders' datatype='real' name='[Calculation_3236821506574270464]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM(IIF([report_date] = [Calculation_3840655741165600769], [ord_succ],0))&#10;/SUM(IIF([report_date] = [Calculation_3840655741165600769], [d_yoy_ord_succ_ttl], 0))-1 &gt; 100 THEN NULL &#10;ELSE SUM(IIF([report_date] = [Calculation_3840655741165600769], [ord_succ],0))&#10;/SUM(IIF([report_date] = [Calculation_3840655741165600769], [d_yoy_ord_succ_ttl], 0))-1 END' />
      </column>
      <column caption='test 1' datatype='real' name='[Calculation_3617516461280362506]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([report_date] = [Calculation_3840655741165600769], (([gmv_lc]+IFNULL([gmv_c2c_lc],0))/[lucanet_fx_rates_cc_prev_year]),0))' />
      </column>
      <column caption='yesterdays gmv' datatype='real' name='[Calculation_3617516461280866316]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([report_date] = [Calculation_3840655741165600769], [gmv_eur]+IFNULL([gmv_c2c_eur],0),0))' />
      </column>
      <column caption='Y GMV Eur w C2C,TS,ODR' datatype='real' name='[Calculation_3712795741099884546]' role='measure' type='quantitative'>
