    <worksheet name='VS Budget'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff'>RR vs Budget</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_global_kpi_report_n (bi_global_dev.tableau_global_kpi_report_n) (bi_global_dev)' name='federated.15oo0u10yuvszn1d571yk0jwb6he' />
          </datasources>
          <datasource-dependencies datasource='federated.15oo0u10yuvszn1d571yk0jwb6he'>
            <column caption='CM Flag' datatype='boolean' name='[Calculation_2129639734081232909]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[report_date]) = DATETRUNC(&apos;month&apos;,[Calculation_3840655741165600769])' />
            </column>
            <column caption='Date with Actuals' datatype='date' name='[Calculation_3840655741164920832]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF ISNULL([ts_orders]) THEN NULL ELSE [report_date] END' />
            </column>
            <column caption='MaxDate with Actuals' datatype='date' name='[Calculation_3840655741165600769]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED : MAX([Calculation_3840655741164920832])}' />
            </column>
            <column caption='Attr' datatype='integer' name='[Calculation_3929461081944641542]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='ord vs bud shape w C2C' datatype='integer' name='[Calculation_3929461081971625994]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [RR_ord vs budget (copy 3)_5977332299558883347] &lt;0 then 0 else 1 end' />
            </column>
            <column caption='RR_ord vs budget w C2C,TS,ODR' datatype='real' name='[RR_ord vs budget (copy 3)_5977332299558883347]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([current month orders (copy 5)_5977332299558379536])/SUM([current month orders (copy 2)]))-1' />
            </column>
            <column caption='Segment (For Filter)' datatype='string' name='[Segment (copy)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[segment]' />
            </column>
            <column-instance column='[Calculation_3929461081944641542]' derivation='Attribute' name='[attr:Calculation_3929461081944641542:qk]' pivot='key' type='quantitative' />
            <column caption='Bud Ord Succ' datatype='real' name='[bud_ord_succ]' role='measure' type='quantitative' />
            <column caption='current month bud orders' datatype='real' name='[current month orders (copy 2)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if DATETRUNC(&apos;month&apos;,[report_date]) = DATETRUNC(&apos;month&apos;,[Calculation_3840655741165600769]) then [bud_ord_succ] end' />
            </column>
            <column caption='current month orders w C2C,TS,ODR' datatype='real' name='[current month orders (copy 5)_5977332299558379536]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if DATETRUNC(&apos;month&apos;,[report_date]) = DATETRUNC(&apos;month&apos;,[Calculation_3840655741165600769]) then IFNULL([rr_ord_succ],0)+IFNULL([rr_orders_c2c],0)+IFNULL([rr_orders_odr],0) end&#10;&#10;//+IFNULL([rr_orders_ts],0)' />
            </column>
            <column caption='Data Status' datatype='string' name='[data_status]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2129639734081232909]' derivation='None' name='[none:Calculation_2129639734081232909:nk]' pivot='key' type='nominal' />
            <column-instance column='[Segment (copy)]' derivation='None' name='[none:Segment (copy):nk]' pivot='key' type='nominal' />
            <column-instance column='[data_status]' derivation='None' name='[none:data_status:nk]' pivot='key' type='nominal' />
            <column caption='Report Date' datatype='date' name='[report_date]' role='dimension' type='ordinal' />
            <column caption='Rr Ord Succ' datatype='real' name='[rr_ord_succ]' role='measure' type='quantitative' />
            <column datatype='real' name='[rr_orders_c2c]' role='measure' type='quantitative' />
            <column datatype='real' name='[rr_orders_odr]' role='measure' type='quantitative' />
            <column caption='Segment' datatype='string' name='[segment]' role='dimension' type='nominal' />
