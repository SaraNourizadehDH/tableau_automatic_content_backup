              <calculation class='tableau' formula='IF sum([Order Succ Last 28 Days (copy)_5790855066677510155])/sum([28 days last year (copy)_5790855066677673997])-1 &gt; 100 THEN NULL &#10;ELSE sum([Order Succ Last 28 Days (copy)_5790855066677510155])/sum([28 days last year (copy)_5790855066677673997])-1 END' />
            </column>
            <column caption='RR_ord vs budget' datatype='real' name='[RR_ord vs budget (Kopie)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_3929461081970151433])/SUM([current month orders (copy 2)]))-1' />
            </column>
            <column caption='RR_ord vs budget TS' datatype='real' name='[RR_ord vs budget (copy 3)_793618699232272387]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([current month orders (copy 5)_793618699231899648])/SUM([current month orders (copy 2)]))-1' />
            </column>
            <column caption='RR GMV vs Budget' datatype='real' name='[RR_ord vs budget (copy)]' role='measure' type='quantitative'>
