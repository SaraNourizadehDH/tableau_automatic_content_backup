  <worksheets>
    <worksheet name='GMV vs Target'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#ffffff' fontsize='9'>MTD GMV</run>
            <run fontsize='9'>Æ </run>
            <run fontcolor='#ffffff' fontsize='9'>vs Target</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_global_kpi_report_n (bi_global_dev.tableau_global_kpi_report_n) (bi_global_dev)' name='federated.15oo0u10yuvszn1d571yk0jwb6he' />
          </datasources>
          <datasource-dependencies datasource='federated.15oo0u10yuvszn1d571yk0jwb6he'>
            <column caption='AOV w C2C,TS,ODR' datatype='real' name='[Calculation_1683994467049533440]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_5977332299559321620] ) / SUM([Calculation_5977332299559747607])' />
            </column>
            <column caption='New Daily GMV Budget  ' datatype='real' name='[Calculation_2264395827852136449]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum({fixed [Calculation_3916865044458033152], [segment], [data_status], [global_entity_id]: [Daily GMV Budget (copy)_2413929409241272320]})' />
            </column>
            <column caption='Segment Glovo edit' datatype='string' name='[Calculation_3173137848210575360]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [management_entity] = &apos;Glovo&apos; THEN &apos;Glovo&apos; ELSE [segment] END' />
            </column>
            <column caption='Date with Actuals' datatype='date' name='[Calculation_3840655741164920832]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF ISNULL([ts_orders]) THEN NULL ELSE [report_date] END' />
            </column>
            <column caption='MaxDate with Actuals' datatype='date' name='[Calculation_3840655741165600769]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED : MAX([Calculation_3840655741164920832])}' />
            </column>
            <column caption='MTD' datatype='boolean' name='[Calculation_3916865044458033152]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [report_date] &lt;= [Calculation_3840655741165600769]&#10;AND DATETRUNC(&quot;month&quot;, [report_date]) = DATETRUNC(&quot;month&quot;, [Calculation_3840655741165600769])&#10;THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='GMV Eur w C2C,TS,ODR' datatype='real' name='[Calculation_5977332299559321620]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([gmv_eur],0) + IFNULL([gmv_c2c_eur],0)+ IFNULL([ts_gmv_eur],0)+ IFNULL([odr_gmv_eur],0)' />
            </column>
            <column caption='Ord Succ w C2C,TS,ODR' datatype='integer' name='[Calculation_5977332299559747607]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([ord_succ],0) + IFNULL([c2c_orders],0)+ IFNULL([ts_orders],0)+ IFNULL([odr_orders],0)' />
            </column>
            <column caption='D YoY Gmv succ ttl w C2C,TS,ODR (copy)' datatype='real' name='[D YoY Ord succ ttl w C2C,TS,ODR (copy)_5863686719014457346]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([d_yoy_gmv_eur_ttl],0) + IFNULL([d_yoy_gmv_c2c_eur_ttl],0) + IFNULL([d_yoy_gmv_ts_eur_ttl],0) + IFNULL([d_yoy_gmv_odr_eur_ttl],0)' />
            </column>
            <column caption='Daily GMV Budget Base' datatype='real' name='[Daily GMV Budget (copy)_2413929409241272320]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([d_target_ord])*[Calculation_1683994467049533440]' />
            </column>
            <column caption='Daily GMV Budget' datatype='real' name='[Daily Orders Budget (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2264395827852136449]' />
            </column>
