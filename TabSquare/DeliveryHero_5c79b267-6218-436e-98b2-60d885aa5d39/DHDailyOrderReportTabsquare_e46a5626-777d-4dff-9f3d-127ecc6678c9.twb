          <datasource-dependencies datasource='federated.15oo0u10yuvszn1d571yk0jwb6he'>
            <column caption='28 days last year TS' datatype='integer' name='[28 days last year (copy)_5790855066677673997]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [report_date]&lt;=[Calculation_3840655741165600769] then [Order Succ Last 28 Days last year (copy)_5790855066677547020] else 0 end' />
            </column>
            <column caption='Date with Actuals' datatype='date' name='[Calculation_3840655741164920832]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF ISNULL([ts_orders]) THEN NULL ELSE [report_date] END' />
            </column>
            <column caption='MaxDate with Actuals' datatype='date' name='[Calculation_3840655741165600769]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED : MAX([Calculation_3840655741164920832])}' />
            </column>
            <column caption='current month orders' datatype='real' name='[Calculation_3929461081970151433]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if DATETRUNC(&apos;month&apos;,[report_date]) = DATETRUNC(&apos;month&apos;,[Calculation_3840655741165600769]) then [rr_ord_succ] end' />
            </column>
            <column caption='DoD GMV TS' datatype='real' default-format='p0.0%' name='[DoD GMV (copy)_5790855066674360320]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([y_gmv_ts_eur])/sum([ypw_gmv_ts_eur]))-1' />
            </column>
            <column caption='DoD orders TS' datatype='real' default-format='p0.0%' name='[DoD orders (copy)_5790855066675568647]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(Sum([y_ts_orders])/SUM([ypw_ts_orders]))-1' />
            </column>
            <column caption='Monthly RR YoY GMV TS' datatype='real' default-format='p0.0%' name='[Monthly RR YoY GMV (copy)_5790855066675003395]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF (sum([current month GMV (copy)_5790855066674868226])/sum([current month gmv yoy (copy)_5790855066675089412]))-1 &gt; 100 THEN NULL &#10;ELSE (sum([current month GMV (copy)_5790855066674868226])/sum([current month gmv yoy (copy)_5790855066675089412]))-1 END' />
            </column>
            <column caption='Monthly RR YoY Orders TS' datatype='real' default-format='p0.0%' name='[Monthly RR YoY Orders (copy 2)_793618699232010241]' role='measure' type='quantitative'>
