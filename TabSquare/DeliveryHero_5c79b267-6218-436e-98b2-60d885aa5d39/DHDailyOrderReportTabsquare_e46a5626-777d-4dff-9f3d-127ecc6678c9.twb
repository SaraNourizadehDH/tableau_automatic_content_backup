            <column-instance column='[Calculation_3929461081971625994]' derivation='User' name='[usr:Calculation_3929461081971625994:ok]' pivot='key' type='ordinal' />
            <column-instance column='[RR_ord vs budget (copy 3)_5977332299558883347]' derivation='User' name='[usr:RR_ord vs budget (copy 3)_5977332299558883347:qk]' pivot='key' type='quantitative' />
