      <table>
        <view>
          <datasources>
            <datasource caption='tableau_global_kpi_report_n (bi_global_dev.tableau_global_kpi_report_n) (bi_global_dev)' name='federated.15oo0u10yuvszn1d571yk0jwb6he' />
          </datasources>
          <datasource-dependencies datasource='federated.15oo0u10yuvszn1d571yk0jwb6he'>
            <column caption='Segment Glovo edit' datatype='string' name='[Calculation_3173137848210575360]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [management_entity] = &apos;Glovo&apos; THEN &apos;Glovo&apos; ELSE [segment] END' />
            </column>
            <column caption='Date with Actuals' datatype='date' name='[Calculation_3840655741164920832]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF ISNULL([ts_orders]) THEN NULL ELSE [report_date] END' />
            </column>
            <column caption='MaxDate with Actuals' datatype='date' name='[Calculation_3840655741165600769]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED : MAX([Calculation_3840655741164920832])}' />
            </column>
            <column caption='MTD' datatype='boolean' name='[Calculation_3916865044458033152]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [report_date] &lt;= [Calculation_3840655741165600769]&#10;AND DATETRUNC(&quot;month&quot;, [report_date]) = DATETRUNC(&quot;month&quot;, [Calculation_3840655741165600769])&#10;THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='D YoY Ord succ ttl w C2C,TS,ODR' datatype='integer' name='[Calculation_5863686719014072321]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([d_yoy_ord_succ_ttl],0) + IFNULL([d_yoy_c2c_orders_ttl],0) + IFNULL([d_yoy_ts_orders_ttl],0) + IFNULL([d_yoy_odr_orders_ttl],0)' />
            </column>
            <column caption='Ord Succ w C2C,TS,ODR' datatype='integer' name='[Calculation_5977332299559747607]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([ord_succ],0) + IFNULL([c2c_orders],0)+ IFNULL([ts_orders],0)+ IFNULL([odr_orders],0)' />
            </column>
            <column caption='Segment (For Filter)' datatype='string' name='[Segment (copy)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[segment]' />
            </column>
            <column datatype='integer' name='[c2c_orders]' role='measure' type='quantitative' />
            <column caption='Daily Orders Budget' datatype='real' name='[d_target_ord]' role='measure' type='quantitative' />
