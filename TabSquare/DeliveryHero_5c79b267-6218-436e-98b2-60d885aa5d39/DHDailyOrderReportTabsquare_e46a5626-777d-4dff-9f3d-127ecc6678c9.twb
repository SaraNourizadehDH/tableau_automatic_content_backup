              <calculation class='tableau' formula='if DATEDIFF(&apos;day&apos;,[report_date],[Calculation_3840655741165600769])&lt;28 then [ts_orders] end' />
            </column>
            <column caption='Order Succ Last 28 Days last year TS' datatype='integer' name='[Order Succ Last 28 Days last year (copy)_5790855066677547020]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if DATEDIFF(&apos;day&apos;,[report_date],[Calculation_3840655741165600769])&lt;28 then [d_yoy_ts_orders_ttl] end' />
            </column>
