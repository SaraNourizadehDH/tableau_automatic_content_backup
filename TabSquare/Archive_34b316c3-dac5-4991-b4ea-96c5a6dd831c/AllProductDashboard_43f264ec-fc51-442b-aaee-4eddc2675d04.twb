      <object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_5162AB09EC4B4CC49168AAC3A4DEBB16'>
            <properties context=''>
              <relation connection='bigquery.144u18o08somz31frlq3205bm2cr (copy)' name='Custom SQL Query' type='text'>select a.*, b.Chain_Name_in_system,b.Account_Name,b.Name_of_Account_Manager,&#10;b.Team,b.Active_in_Jan,&#10;from&#10;(&#10;SELECT&#10;  *&#10;FROM&#10;  `tabsquare-data-sciences.datastudio_dashboard_data.all_product_firebase_data`&#10;WHERE&#10;  order_date &gt;&gt;= &apos;2021-01-01&apos;&#10;UNION ALL&#10;SELECT&#10;  *&#10;FROM&#10;  `tabsquare-data-sciences.datastudio_dashboard_data.all_product_skipque_data`&#10;WHERE&#10;  order_date &gt;&gt;= &apos;2021-01-01&apos;&#10;)a&#10;left join&#10;`tabsquare-data-sciences.tabsquare_dw_lookups.master_merchant_list` b&#10;on a.merchant_id = b.merchant_id</relation>
            </properties>
          </object>
        </objects>
      </object-graph>
    </datasource>
    <datasource caption='Custom SQL Query (tabsquare_dw_ai_prod)' inline='true' name='federated.1eid3o11d73hod1fiq0xl0ur39q8' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.04g8vmj05bo3ko1h80na81e53gjq'>
            <connection CATALOG='tabsquare-data-sciences' EXECCATALOG='tabsquare-data-sciences' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tabsquare-data-sciences' schema='tabsquare_dw_ai_prod' server-oauth='server-custom' username='data-team-tableau@tabsquare-data-sciences.iam.gserviceaccount.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <relation connection='bigquery.04g8vmj05bo3ko1h80na81e53gjq' name='Custom SQL Query' type='text'>WITH&#10;  clean_data AS(&#10;  SELECT&#10;    customer_id,&#10;  IF&#10;    (LOWER(country) IN (&apos;singapore&apos;,&#10;        &apos;malaysia&apos;,&#10;        &apos;australia&apos;,&#10;        &apos;indonesia&apos;),&#10;      country,&#10;      &apos;Others&apos;) AS country,&#10;    MIN(order_date) AS first_order_date&#10;  FROM&#10;    tabsquare_dw_ai_prod.customer_stats_prod&#10;  WHERE&#10;    order_id IS NOT NULL&#10;    AND customer_id&gt;&gt;0&#10;    AND country IS NOT NULL&#10;    AND order_date&gt;&gt;&apos;2000-01-01&apos;&#10;  GROUP BY&#10;    1,&#10;    2 )&#10;    &#10;SELECT&#10;  *,&#10;  running_total - LAG(running_total) OVER (PARTITION BY country ORDER BY yr, mon_no) as LAG_running_total&#10;FROM (&#10;  SELECT&#10;    yr,&#10;    mon_no,&#10;    month,&#10;    country,&#10;    SUM(cnt) OVER (PARTITION BY country ORDER BY yr, mon_no) AS running_total&#10;  FROM (&#10;    SELECT&#10;      EXTRACT (Year&#10;      FROM&#10;        first_order_date) AS yr,&#10;      EXTRACT (MONTH&#10;      FROM&#10;        first_order_date) AS mon_no,&#10;      FORMAT_DATE(&quot;%B&quot;, first_order_date) AS month,&#10;      country,&#10;      COUNT(DISTINCT customer_id) AS cnt&#10;    FROM&#10;      clean_data&#10;    GROUP BY&#10;      1,&#10;      2,&#10;      3,&#10;      4))&#10;WHERE&#10;  yr&gt;&gt;2019</relation>
