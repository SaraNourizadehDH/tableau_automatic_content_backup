      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.09jd44b1tzgb3x1gm5r030ov7dlh (copy)].[ctd:Order_Id:qk]&quot;' value='Order Count' />
          <alias key='&quot;[federated.09jd44b1tzgb3x1gm5r030ov7dlh (copy)].[sum:Sales:qk]&quot;' value='GMV' />
        </aliases>
      </column>
      <column caption='Current ABV' datatype='real' name='[ABV (copy)_5746874649551593483]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [Calculation_5717953095680139264]=1 then [Sales] end)&#10;/&#10;count(if [Calculation_5717953095680139264]=1 then [Order_Id] end)' />
      </column>
      <column datatype='string' name='[Account_Name]' role='dimension' type='nominal' />
      <column caption='month_week_field' datatype='date' name='[Calculation_1909526290754387968]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1 1]&#13;&#10;WHEN &quot;monthly&quot; THEN Date(DATETRUNC(&apos;month&apos;, [order_date]))&#13;&#10;WHEN &quot;weekly&quot; THEN Date(DATETRUNC(&apos;week&apos;, [order_date]))&#13;&#10;END' />
      </column>
      <column caption='Selected Metric' datatype='real' name='[Calculation_1909526290759573505]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2 1]&#13;&#10;WHEN &quot;sales&quot; then sum([Sales])&#13;&#10;WHEN &quot;orders&quot; then COUNTD([Order_Id])&#10;when &quot;outlets&quot; then countd([Merchant_id])&#13;&#10;END' />
      </column>
      <column caption='Time Period' datatype='integer' name='[Calculation_5685161260887887873]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Parameters].[Parameter 2], [Parameters].[Start Date (copy)_5685161260887789568])+1' />
      </column>
      <column caption='Compare start date' datatype='date' name='[Calculation_5685161260888371202]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='date(DATEADD(&apos;day&apos;,-1*[Calculation_5685161260887887873],[Parameters].[Parameter 2]))' />
      </column>
      <column caption='Current Time Period Filter' datatype='integer' name='[Calculation_5717953095680139264]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if [order_date]&gt;=[Parameters].[Parameter 2] and [order_date]&lt;=[Parameters].[Start Date (copy)_5685161260887789568] then 1 else 0 end' />
      </column>
      <column caption='Latest End Date' datatype='date' name='[Calculation_5717953095685943300]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{fixed: max([order_date])}' />
      </column>
      <column caption='Latest Start Date' datatype='date' name='[Calculation_5717953095686021125]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{fixed: max(date(DATETRUNC(&apos;month&apos;, {fixed:max([order_date])})))}' />
      </column>
      <column caption='Compare Time Period Filter' datatype='integer' name='[Calculation_5746874649546481666]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [order_date]&gt;=[Calculation_5685161260888371202] and [order_date]&lt;=[Compare start date (copy)_5685161260888866819] then 1 else 0 end' />
      </column>
      <column caption='Time Period Filter' datatype='integer' name='[Calculation_5746874649546661891]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_5717953095680139264]=1 or [Calculation_5746874649546481666]=1 then 1 else 0 end' />
      </column>
      <column caption='Current Sales' datatype='real' name='[Calculation_5746874649547587588]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [Calculation_5717953095680139264]=1 then [Sales] end)' />
      </column>
      <column caption='Change in Sales' datatype='real' name='[Calculation_5746874649548210181]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_5746874649547587588] - [Current Sales (copy)_5746874649548333062])/[Current Sales (copy)_5746874649548333062]' />
      </column>
      <column caption='dummy' datatype='integer' name='[Calculation_5746874649548582919]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Current Merchant Count' datatype='integer' name='[Calculation_5746874649553522704]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(if [Calculation_5717953095680139264]=1 then [Merchant_id] end)' />
      </column>
      <column caption='Change in Merchant Count' datatype='real' name='[Calculation_5746874649553756178]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_5746874649553522704]-[Current Merchant Count (copy)_5746874649553653777])/[Current Merchant Count (copy)_5746874649553653777]' />
      </column>
      <column caption='Current Order Count' datatype='integer' name='[Calculation_5746874649553915923]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='count(if [Calculation_5717953095680139264]=1 then [Order_Id] end)' />
      </column>
      <column caption='Change in Order Count' datatype='real' name='[Calculation_5746874649554100245]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_5746874649553915923]-[Current Order Count (copy)_5746874649554001940])/[Current Order Count (copy)_5746874649554001940]' />
      </column>
      <column caption='Selected Time Interval' datatype='date' name='[Calculation_5746874649573715997]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 4]=&apos;Year&apos; then date(DATETRUNC(&apos;year&apos;, [order_date]))&#10;ELSEIF [Parameters].[Parameter 4]=&apos;Quarter&apos; then date(DATETRUNC(&apos;quarter&apos;, [order_date]))&#10;elseif [Parameters].[Parameter 4]=&apos;Month&apos; then date(DATETRUNC(&apos;month&apos;, [order_date]))&#10;elseif [Parameters].[Parameter 4]=&apos;Week&apos; then date(DATETRUNC(&apos;week&apos;, [order_date]))&#10;elseif [Parameters].[Parameter 4]=&apos;Day&apos; then date(DATETRUNC(&apos;day&apos;, [order_date]))&#10;end' />
      </column>
      <column caption='ABV' datatype='real' name='[Calculation_96123753293684736]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales]) / COUNTD([Order_Id])' />
      </column>
      <column caption='Selected Dimension' datatype='string' name='[Calculation_96123753339518988]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] == &quot;Country&quot; THEN [Country]&#10;ELSEIF [Parameters].[Parameter 1] == &quot;Order Type&quot; THEN [Order_Type]&#10;elseif [Parameters].[Parameter 1] == &apos;Payment Type&apos; then [Payment_Type]&#10;ELSEIF [Parameters].[Parameter 1] == &quot;Chain_Name&quot; THEN [Chain_Name_in_system]&#10;ELSEIF [Parameters].[Parameter 1] == &quot;Team&quot; THEN [Team]&#10;ELSEIF [Parameters].[Parameter 1] == &quot;Restaurant Name&quot; THEN [RestaurantName]&#10;ELSEIF [Parameters].[Parameter 1] == &quot;Account Manager&quot; THEN [Name_of_Account_Manager]&#10;ELSEIF [Parameters].[Parameter 1] == &quot;Product Type&quot; THEN [Product_Type]&#10;ELSEIF [Parameters].[Parameter 1] == &quot;System&quot; THEN [System]&#10;END' />
      </column>
      <column caption='Change in ABV' datatype='real' name='[Change in Sales (copy)_5746874649552101389]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([ABV (copy)_5746874649551593483] - [Current ABV (copy)_5746874649551929356])/[Current ABV (copy)_5746874649551929356]' />
      </column>
      <column caption='Compare end date ' datatype='date' name='[Compare start date (copy)_5685161260888866819]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='date(DATEADD(&apos;day&apos;,-1,[Parameters].[Parameter 2]))' />
      </column>
      <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column caption='Compare ABV' datatype='real' name='[Current ABV (copy)_5746874649551929356]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [Calculation_5746874649546481666]=1 then [Sales] end)&#10;/&#10;count(if [Calculation_5746874649546481666]=1 then [Order_Id] end)' />
      </column>
      <column caption='Compare Merchant Count' datatype='integer' name='[Current Merchant Count (copy)_5746874649553653777]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(if [Calculation_5746874649546481666]=1 then [Merchant_id] end)' />
      </column>
      <column caption='Compare Order Count ' datatype='integer' name='[Current Order Count (copy)_5746874649554001940]' role='measure' type='quantitative'>
