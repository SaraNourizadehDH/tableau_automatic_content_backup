      <table>
        <view>
          <datasources>
            <datasource caption='hourly' name='federated.1fdc2s11ib82vi128mo0v02yn8d0' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Start Date' datatype='date' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='#2025-06-01#'>
              <calculation class='tableau' formula='#2025-06-01#' />
              <range max='#2025-07-31#' min='#2025-01-01#' />
            </column>
            <column caption='End Date' datatype='date' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='#2025-06-30#'>
              <calculation class='tableau' formula='#2025-06-30#' />
              <range max='#2025-07-31#' min='#2025-01-01#' />
            </column>
            <column caption='Accounts' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Marrybrown MY&quot;'>
              <calculation class='tableau' formula='&quot;Marrybrown MY&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1fdc2s11ib82vi128mo0v02yn8d0'>
