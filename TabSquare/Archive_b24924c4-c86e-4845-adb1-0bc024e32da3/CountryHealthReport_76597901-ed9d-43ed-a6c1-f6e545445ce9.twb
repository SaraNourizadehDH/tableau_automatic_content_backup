              <calculation class='tableau' formula='SUM([cost_of_hardware])+SUM([cost_of_setup])+SUM([other_costs])+SUM([resellers_costs])+SUM([tcc_oat_fee])+SUM([total_stripe_cost])&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;///[cost_of_hardware]+[cost_of_setup]+[other_costs]+[resellers_costs]+[tcc_oat_fee]+[total_stripe_cost]///' />
