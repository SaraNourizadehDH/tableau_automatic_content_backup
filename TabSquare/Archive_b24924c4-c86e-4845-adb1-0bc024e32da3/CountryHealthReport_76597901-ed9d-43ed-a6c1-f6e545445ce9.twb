        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1kkd9551e2i8sw1axtwhh1crtqpp' name='Custom SQL Query8' type='text'>SELECT source_company,case when source_company= &apos;tabsquare_pte&apos; then &apos;Singapore&apos;
when source_company= &apos;tabsquare_pty&apos; then &apos;Australia&apos;
when source_company= &apos;tabsquare_smart_solution&apos; then &apos;Indonesia&apos;
when source_company= &apos;tabsquare_sdn_bhd&apos; then &apos;Malaysia&apos;
ELSE &apos;OTHERS&apos; END
as Country, 

concat(extract(year from transaction_date),&apos;-&apos;,extract(month from transaction_date)) as month_year,

sum(case when account_number like &quot;4-%&quot; then amount*exchange_rate else 0 end ) as total_revenue,
sum(case when account_number in (&quot;4-1700&quot;,&quot;4-1710&quot;,&quot;4-1730&quot;,&quot;4-1731&quot;,&quot;4-1732&quot;,&quot;4-1733&quot;,&quot;4-1736&quot;,&quot;4-1742&quot;,&quot;4-1750&quot;,
&quot;4-1780&quot;,&quot;4-1787&quot;,&quot;4-1790&quot;,&quot;4-1791&quot;,&quot;4-1792&quot;,&quot;4-1793&quot;,&quot;4-1800&quot;,&quot;4-1810&quot;,&quot;4-1820&quot;,&quot;4-1840&quot;,&quot;4-2000&quot;) then amount*exchange_rate else 0 end) as recurring_saas_fee,
sum(case when account_number in (&quot;4-1737&quot;, &quot;4-1739&quot;) then amount*exchange_rate else 0 end ) as total_payment_gateway_revenue,
sum(case when account_number = &apos;4-1782&apos; then amount*exchange_rate else 0 end ) as total_cash_revenue,
sum(case when account_number in (&quot;5-1730&quot;, &quot;5-1732&quot;) then amount*exchange_rate else 0 end ) as total_stripe_cost,
sum(case when account_number in (&quot;4-1250&quot;,&quot;4-1300&quot;,&quot;4-1310&quot;,&quot;4-1330&quot;,&quot;4-1331&quot;,&quot;4-1350&quot;,&quot;4-1355&quot;,&quot;4-1385&quot;,&quot;4-1386&quot;,&quot;4-1390&quot;, &quot;4-1920&quot;, &quot;4-3001&quot;) then amount*exchange_rate else 0 end ) as one_time_revenue,
sum(case when account_number in (&quot;5-1250&quot;, &quot;5-1300&quot;,&quot;5-1310&quot;) then amount*exchange_rate else 0 end ) as cost_of_setup,
sum(case when account_number in (&quot;5-1100&quot;, &quot;5-1190&quot;) then amount*exchange_rate else 0 end ) as cost_of_hardware,
sum(case when account_number in (&quot;5-1315&quot;,&quot;5-1610&quot;,&quot;5-1620&quot;,&quot;5-1630&quot;,&quot;5-1650&quot;,&quot;5-1660&quot;,&quot;5-1670&quot;,&quot;5-2000&quot;,&quot;6-1560&quot;,&quot;9-0001&quot;) then amount*exchange_rate else 0 end ) as other_costs,
sum(case when account_number in (&quot;5-1731&quot;, &quot;5-1735&quot;) then amount*exchange_rate else 0 end ) as tcc_oat_fee,
sum(case when account_number in (&quot;5-1700&quot;, &quot;5-1701&quot;) then amount*exchange_rate else 0 end ) as resellers_costs,
sum( case when account_number in (&apos;4-1710&apos;,&apos;4-1810&apos;) then amount*exchange_rate else 0 end )  as Recurring_Fee_SmartTab, 
sum( case when account_number  in (&apos;4-1730&apos;,&apos;4-1820&apos;) then amount*exchange_rate else 0 end ) as Recurring_Fee_SmartKiosk,
sum( case when account_number = &apos;4-1731&apos; then  amount*exchange_rate else 0 end ) as Recurring_Fee_SmartConnect,
sum( case when account_number  in (&apos;4-1790&apos;,&apos;4-1750&apos;,&apos;4-1736&apos;,&apos;4-1790&apos;) then amount*exchange_rate else 0 end ) as Recurring_Fee_SmartWeb,
sum( case when account_number = &apos;4-1780&apos; then amount*exchange_rate else 0 end ) as Recurring_Fee_AI,
sum( case when account_number = &apos;4-1792&apos; then amount*exchange_rate else 0 end ) as Recurring_Fee_SmartTerminal,
sum( case when account_number = &apos;4-1742&apos; then amount*exchange_rate else 0 end ) as Recurring_Fee_SmartApp,
sum( case when account_number = &apos;4-1770&apos; then amount*exchange_rate else 0 end ) as Recurring_Fee_POS,
sum( case when account_number = &apos;4-1793&apos; then amount*exchange_rate else 0 end ) as Recurring_Fee_Menu_Management,
sum( case when account_number in (&apos;4-1791&apos;, &apos;4-1840&apos;,&apos;4-1787&apos;,&apos;4-1920&apos;,&apos;4-2000&apos;) then amount*exchange_rate else 0 end ) as Recurring_fee_Others,
sum( case when account_number = &apos;4-1732&apos; then amount*exchange_rate else 0 end ) as Transaction_Fee_Adyen,
sum( case when account_number = &apos;4-1739&apos; then amount*exchange_rate else 0 end ) as Transaction_Fee_RazerPay,
sum( case when account_number = &apos;4-1711&apos; then amount*exchange_rate else 0 end ) as Recurring_Fee_Support_Package,



 from

(SELECT 
                &apos;INVOICE&apos; as type, 
                i.transaction_date, i.doc_number, c.company_name, i.exchange_rate,
                
                i.currency_id, il.description, il.amount, il.sales_item_quantity, 
                ifnull(a.account_number,ab.account_number) as account_number, ifnull(a.description, ab.description) as description,
                a.fully_qualified_name, i.source_company, qi.fully_qualified_name AS product_service,c.fully_qualified_name as full_customer_name
            FROM   
                `tabsquare-data-sciences.tabsquare_master_quickbooks.invoice` i
            INNER JOIN
                `tabsquare-data-sciences.tabsquare_master_quickbooks.invoice_line` il 
            ON  i.id = il.invoice_id
            AND i.source_company = il.source_company
            
            LEFT JOIN 
                `tabsquare-data-sciences.tabsquare_master_quickbooks.item` qi
                
            ON il.sales_item_item_id = qi.id
            AND il.source_company = qi.source_company
            
            
            LEFT JOIN
                `tabsquare-data-sciences.tabsquare_master_quickbooks.account` a
            ON  il.sales_item_account_id = a.id
            AND il.source_company = a.source_company

            LEFT JOIN
                `tabsquare-data-sciences.tabsquare_master_quickbooks.account` ab
            ON  qi.income_account_id = ab.id
            AND qi.source_company = ab.source_company
            
            LEFT JOIN
                `tabsquare-data-sciences.tabsquare_master_quickbooks.customer` c 
            ON  i.customer_id = c.id
            AND i.source_company = c.source_company
            where coalesce(a.account_number,ab.account_number) is not null
                
            
            UNION ALL
            
            
            SELECT
                &apos;CREDIT NOTE&apos; as type, 
                 cm.transaction_date, cm.doc_number, cu.company_name,cm.exchange_rate,
                 cm.currency_id, cl.description, cl.amount*-1, cl.sales_item_quantity, 
                 a.account_number, a.description AS account_description, 
                 a.fully_qualified_name, a.source_company, qj.fully_qualified_name as product_service,cu.fully_qualified_name as full_customer_name
                 
            FROM
                `tabsquare-data-sciences.tabsquare_master_quickbooks.credit_memo` cm
            INNER JOIN 
                `tabsquare-data-sciences.tabsquare_master_quickbooks.credit_memo_line` cl
            ON  cm.id = cl.credit_memo_id
            AND cm.source_company = cl.source_company
            
            LEFT JOIN
                `tabsquare-data-sciences.tabsquare_master_quickbooks.item` qj
                
            ON cl.sales_item_item_id = qj.id
            
            AND cl.source_company = qj.source_company
            
            LEFT JOIN
                `tabsquare-data-sciences.tabsquare_master_quickbooks.account` a
            ON  cl.sales_item_account_id = a.id
            AND cl.source_company = a.source_company
            
            
            LEFT JOIN
                `tabsquare-data-sciences.tabsquare_master_quickbooks.customer` cu
            ON  cm.customer_id = cu.id
            AND cm.source_company = cu.source_company
            
            WHERE account_number IS NOT NULL  
           
           UNION ALL

          SELECT
                &apos;JOURNAL ENTRY&apos; as type, 
                 cm.transaction_date, cm.doc_number, cu.company_name,cm.exchange_rate,
                 cm.currency_id, cl.description, case when posting_type = &apos;Debit&apos; then cl.amount*-1 else cl.amount end as amount,null as sales_item_quantity, 
                 a.account_number, a.description AS account_description, 
                 a.fully_qualified_name, cm.source_company, null as product_service,cu.fully_qualified_name as full_customer_name
                 
            FROM
                `tabsquare-data-sciences.tabsquare_master_quickbooks.journal_entry` cm
            INNER JOIN 
                `tabsquare-data-sciences.tabsquare_master_quickbooks.journal_entry_line` cl
            ON  cm.id = cl.journal_entry_id
            AND cm.source_company = cl.source_company

            
            LEFT JOIN
                `tabsquare-data-sciences.tabsquare_master_quickbooks.account` a
            ON  cl.account_id = a.id
            AND cl.source_company = a.source_company
            
            
            LEFT JOIN
                `tabsquare-data-sciences.tabsquare_master_quickbooks.customer` cu
            ON  cl.customer_id = cu.id
            AND cl.source_company = cu.source_company
            
            WHERE account_number IS NOT NULL
            
            
        UNION ALL 

        SELECT
                &apos;BILL&apos; as type, 
                 cm.transaction_date, cm.doc_number, cu.company_name,cm.exchange_rate,
                 cm.currency_id, cl.description,cl.amount*-1,null as sales_item_quantity, 
                 a.account_number, a.description AS account_description, 
                 a.fully_qualified_name, cm.source_company, null as product_service,cu.fully_qualified_name as full_customer_name
                 
            FROM
                `tabsquare-data-sciences.tabsquare_master_quickbooks.bill` cm
            INNER JOIN 
                `tabsquare-data-sciences.tabsquare_master_quickbooks.bill_line` cl
            ON  cm.id = cl.bill_id
            AND cm.source_company = cl.source_company
            

            
            LEFT JOIN
                `tabsquare-data-sciences.tabsquare_master_quickbooks.account` a
            ON  cl.account_expense_account_id = a.id
            AND cl.source_company = a.source_company
            
            
            LEFT JOIN
                `tabsquare-data-sciences.tabsquare_master_quickbooks.customer` cu
            ON  cl.account_expense_customer_id = cu.id
            AND cl.source_company = cu.source_company
            
            WHERE account_number IS NOT NULL

    UNION ALL 

          SELECT
                &apos;DEPOSIT&apos; as type, 
                 cm.transaction_date, null as doc_number, cu.company_name,1 as exchange_rate,
                 cm.currency_id, cl.description,cl.amount,null as sales_item_quantity, 
                 a.account_number, a.description AS account_description, 
                 a.fully_qualified_name, cm.source_company, null as product_service,cu.fully_qualified_name as full_customer_name
                 
            FROM
                `tabsquare-data-sciences.tabsquare_master_quickbooks.deposit` cm
            INNER JOIN 
                `tabsquare-data-sciences.tabsquare_master_quickbooks.deposit_line` cl
            ON  cm.id = cl.deposit_id
            AND cm.source_company = cl.source_company
            
            -- LEFT JOIN
            --     `tabsquare-data-sciences.tabsquare_master_quickbooks.item` qj
                
            -- ON cl.sales_item_item_id = qj.id
            
            -- AND cl.source_company = qj.source_company
            
            LEFT JOIN
                `tabsquare-data-sciences.tabsquare_master_quickbooks.account` a
            ON  cl.deposit_account_id = a.id
            AND cl.source_company = a.source_company
            
            
            LEFT JOIN
                `tabsquare-data-sciences.tabsquare_master_quickbooks.customer` cu
            ON  cl.deposit_customer_id = cu.id
            AND cl.source_company = cu.source_company
            
            WHERE account_number IS NOT NULL
   

            
            ) 

         
GROUP BY 1,2,3 order by 1,2,3</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='bigquery.1kkd9551e2i8sw1axtwhh1crtqpp' name='Custom SQL Query' type='text'><![CDATA[select country , concat(extract( year from order_date),"-", extract(month from order_date)) as month_year,merchant_id,  sum(sales) as sales, sum(orders) as orders, sum(Paid_Gmv) as paid_gmv from (select a.*, b.Chain_Name_in_system,b.Account_Name,b.Name_of_Account_Manager,
b.Team from
(
 select Country,System,Merchant_id,RestaurantName,order_date,Order_Type,data_source,sum(final_gmv) as Sales, sum(total_gmv_orders) as orders ,
sum(total_paid_gmv) as Paid_Gmv, sum(total_paid_orders) as Paid_Orders from 
`tabsquare-data-sciences.datastudio_dashboard_data.new_net_gmv` 
where order_date >>= '2023-01-01' and  order_date <<= current_date('Asia/Singapore')
and merchant_id not like '%HQ-24%'
and merchant_id not like '%HQ-6278%'
group by 1,2,3,4,5,6,7

UNION ALL

SELECT
  Country,System,Merchant_id,RestaurantName,extract(date from order_date) as order_date,Order_Type,data_source, sum(sales) as Sales, sum(Orders) as orders, 0 as Paid_Gmv,
0 as Paid_Orders
FROM
  `tabsquare-data-sciences.tabsquare_dw_lookups.kfc_taco_gmv`
Group by 1,2,3,4,5,6,7) a 
left join
`tabsquare-data-sciences.tabsquare_dw_lookups.master_merchant_list_tableau_view` as b
on a.merchant_id = b.merchant_id
left join
`tabsquare-data-sciences.all_skipque_cdc_data_prod.all_organization_view_prod` o
on a.merchant_id = o.merchant_key) where order_date >>="2023-01-01" group by 1,2,3 order by 1,2]]></relation>
          <relation connection='bigquery.1kkd9551e2i8sw1axtwhh1crtqpp' name='Custom SQL Query8' type='text'>SELECT source_company,case when source_company= &apos;tabsquare_pte&apos; then &apos;Singapore&apos;
when source_company= &apos;tabsquare_pty&apos; then &apos;Australia&apos;
when source_company= &apos;tabsquare_smart_solution&apos; then &apos;Indonesia&apos;
when source_company= &apos;tabsquare_sdn_bhd&apos; then &apos;Malaysia&apos;
ELSE &apos;OTHERS&apos; END
as Country, 

concat(extract(year from transaction_date),&apos;-&apos;,extract(month from transaction_date)) as month_year,

sum(case when account_number like &quot;4-%&quot; then amount*exchange_rate else 0 end ) as total_revenue,
sum(case when account_number in (&quot;4-1700&quot;,&quot;4-1710&quot;,&quot;4-1730&quot;,&quot;4-1731&quot;,&quot;4-1732&quot;,&quot;4-1733&quot;,&quot;4-1736&quot;,&quot;4-1742&quot;,&quot;4-1750&quot;,
&quot;4-1780&quot;,&quot;4-1787&quot;,&quot;4-1790&quot;,&quot;4-1791&quot;,&quot;4-1792&quot;,&quot;4-1793&quot;,&quot;4-1800&quot;,&quot;4-1810&quot;,&quot;4-1820&quot;,&quot;4-1840&quot;,&quot;4-2000&quot;) then amount*exchange_rate else 0 end) as recurring_saas_fee,
sum(case when account_number in (&quot;4-1737&quot;, &quot;4-1739&quot;) then amount*exchange_rate else 0 end ) as total_payment_gateway_revenue,
sum(case when account_number = &apos;4-1782&apos; then amount*exchange_rate else 0 end ) as total_cash_revenue,
sum(case when account_number in (&quot;5-1730&quot;, &quot;5-1732&quot;) then amount*exchange_rate else 0 end ) as total_stripe_cost,
sum(case when account_number in (&quot;4-1250&quot;,&quot;4-1300&quot;,&quot;4-1310&quot;,&quot;4-1330&quot;,&quot;4-1331&quot;,&quot;4-1350&quot;,&quot;4-1355&quot;,&quot;4-1385&quot;,&quot;4-1386&quot;,&quot;4-1390&quot;, &quot;4-1920&quot;, &quot;4-3001&quot;) then amount*exchange_rate else 0 end ) as one_time_revenue,
sum(case when account_number in (&quot;5-1250&quot;, &quot;5-1300&quot;,&quot;5-1310&quot;) then amount*exchange_rate else 0 end ) as cost_of_setup,
sum(case when account_number in (&quot;5-1100&quot;, &quot;5-1190&quot;) then amount*exchange_rate else 0 end ) as cost_of_hardware,
sum(case when account_number in (&quot;5-1315&quot;,&quot;5-1610&quot;,&quot;5-1620&quot;,&quot;5-1630&quot;,&quot;5-1650&quot;,&quot;5-1660&quot;,&quot;5-1670&quot;,&quot;5-2000&quot;,&quot;6-1560&quot;,&quot;9-0001&quot;) then amount*exchange_rate else 0 end ) as other_costs,
sum(case when account_number in (&quot;5-1731&quot;, &quot;5-1735&quot;) then amount*exchange_rate else 0 end ) as tcc_oat_fee,
sum(case when account_number in (&quot;5-1700&quot;, &quot;5-1701&quot;) then amount*exchange_rate else 0 end ) as resellers_costs,
sum( case when account_number in (&apos;4-1710&apos;,&apos;4-1810&apos;) then amount*exchange_rate else 0 end )  as Recurring_Fee_SmartTab, 
sum( case when account_number  in (&apos;4-1730&apos;,&apos;4-1820&apos;) then amount*exchange_rate else 0 end ) as Recurring_Fee_SmartKiosk,
sum( case when account_number = &apos;4-1731&apos; then  amount*exchange_rate else 0 end ) as Recurring_Fee_SmartConnect,
sum( case when account_number  in (&apos;4-1790&apos;,&apos;4-1750&apos;,&apos;4-1736&apos;,&apos;4-1790&apos;) then amount*exchange_rate else 0 end ) as Recurring_Fee_SmartWeb,
sum( case when account_number = &apos;4-1780&apos; then amount*exchange_rate else 0 end ) as Recurring_Fee_AI,
sum( case when account_number = &apos;4-1792&apos; then amount*exchange_rate else 0 end ) as Recurring_Fee_SmartTerminal,
sum( case when account_number = &apos;4-1742&apos; then amount*exchange_rate else 0 end ) as Recurring_Fee_SmartApp,
sum( case when account_number = &apos;4-1770&apos; then amount*exchange_rate else 0 end ) as Recurring_Fee_POS,
sum( case when account_number = &apos;4-1793&apos; then amount*exchange_rate else 0 end ) as Recurring_Fee_Menu_Management,
sum( case when account_number in (&apos;4-1791&apos;, &apos;4-1840&apos;,&apos;4-1787&apos;,&apos;4-1920&apos;,&apos;4-2000&apos;) then amount*exchange_rate else 0 end ) as Recurring_fee_Others,
sum( case when account_number = &apos;4-1732&apos; then amount*exchange_rate else 0 end ) as Transaction_Fee_Adyen,
sum( case when account_number = &apos;4-1739&apos; then amount*exchange_rate else 0 end ) as Transaction_Fee_RazerPay,
sum( case when account_number = &apos;4-1711&apos; then amount*exchange_rate else 0 end ) as Recurring_Fee_Support_Package,



 from

(SELECT 
                &apos;INVOICE&apos; as type, 
                i.transaction_date, i.doc_number, c.company_name, i.exchange_rate,
                
                i.currency_id, il.description, il.amount, il.sales_item_quantity, 
                ifnull(a.account_number,ab.account_number) as account_number, ifnull(a.description, ab.description) as description,
                a.fully_qualified_name, i.source_company, qi.fully_qualified_name AS product_service,c.fully_qualified_name as full_customer_name
            FROM   
                `tabsquare-data-sciences.tabsquare_master_quickbooks.invoice` i
            INNER JOIN
                `tabsquare-data-sciences.tabsquare_master_quickbooks.invoice_line` il 
            ON  i.id = il.invoice_id
            AND i.source_company = il.source_company
            
            LEFT JOIN 
                `tabsquare-data-sciences.tabsquare_master_quickbooks.item` qi
                
            ON il.sales_item_item_id = qi.id
            AND il.source_company = qi.source_company
            
            
            LEFT JOIN
                `tabsquare-data-sciences.tabsquare_master_quickbooks.account` a
            ON  il.sales_item_account_id = a.id
            AND il.source_company = a.source_company

            LEFT JOIN
                `tabsquare-data-sciences.tabsquare_master_quickbooks.account` ab
            ON  qi.income_account_id = ab.id
            AND qi.source_company = ab.source_company
            
            LEFT JOIN
                `tabsquare-data-sciences.tabsquare_master_quickbooks.customer` c 
            ON  i.customer_id = c.id
            AND i.source_company = c.source_company
            where coalesce(a.account_number,ab.account_number) is not null
                
            
            UNION ALL
            
            
            SELECT
                &apos;CREDIT NOTE&apos; as type, 
                 cm.transaction_date, cm.doc_number, cu.company_name,cm.exchange_rate,
                 cm.currency_id, cl.description, cl.amount*-1, cl.sales_item_quantity, 
                 a.account_number, a.description AS account_description, 
                 a.fully_qualified_name, a.source_company, qj.fully_qualified_name as product_service,cu.fully_qualified_name as full_customer_name
                 
            FROM
                `tabsquare-data-sciences.tabsquare_master_quickbooks.credit_memo` cm
            INNER JOIN 
                `tabsquare-data-sciences.tabsquare_master_quickbooks.credit_memo_line` cl
            ON  cm.id = cl.credit_memo_id
            AND cm.source_company = cl.source_company
            
            LEFT JOIN
                `tabsquare-data-sciences.tabsquare_master_quickbooks.item` qj
                
            ON cl.sales_item_item_id = qj.id
            
            AND cl.source_company = qj.source_company
            
            LEFT JOIN
                `tabsquare-data-sciences.tabsquare_master_quickbooks.account` a
            ON  cl.sales_item_account_id = a.id
            AND cl.source_company = a.source_company
            
            
            LEFT JOIN
                `tabsquare-data-sciences.tabsquare_master_quickbooks.customer` cu
            ON  cm.customer_id = cu.id
            AND cm.source_company = cu.source_company
            
            WHERE account_number IS NOT NULL  
           
           UNION ALL

          SELECT
                &apos;JOURNAL ENTRY&apos; as type, 
                 cm.transaction_date, cm.doc_number, cu.company_name,cm.exchange_rate,
                 cm.currency_id, cl.description, case when posting_type = &apos;Debit&apos; then cl.amount*-1 else cl.amount end as amount,null as sales_item_quantity, 
                 a.account_number, a.description AS account_description, 
                 a.fully_qualified_name, cm.source_company, null as product_service,cu.fully_qualified_name as full_customer_name
                 
            FROM
                `tabsquare-data-sciences.tabsquare_master_quickbooks.journal_entry` cm
            INNER JOIN 
                `tabsquare-data-sciences.tabsquare_master_quickbooks.journal_entry_line` cl
            ON  cm.id = cl.journal_entry_id
            AND cm.source_company = cl.source_company

            
            LEFT JOIN
                `tabsquare-data-sciences.tabsquare_master_quickbooks.account` a
            ON  cl.account_id = a.id
            AND cl.source_company = a.source_company
            
            
            LEFT JOIN
                `tabsquare-data-sciences.tabsquare_master_quickbooks.customer` cu
            ON  cl.customer_id = cu.id
            AND cl.source_company = cu.source_company
            
            WHERE account_number IS NOT NULL
            
            
        UNION ALL 

        SELECT
                &apos;BILL&apos; as type, 
                 cm.transaction_date, cm.doc_number, cu.company_name,cm.exchange_rate,
                 cm.currency_id, cl.description,cl.amount*-1,null as sales_item_quantity, 
                 a.account_number, a.description AS account_description, 
                 a.fully_qualified_name, cm.source_company, null as product_service,cu.fully_qualified_name as full_customer_name
                 
            FROM
                `tabsquare-data-sciences.tabsquare_master_quickbooks.bill` cm
            INNER JOIN 
                `tabsquare-data-sciences.tabsquare_master_quickbooks.bill_line` cl
            ON  cm.id = cl.bill_id
            AND cm.source_company = cl.source_company
            

            
            LEFT JOIN
                `tabsquare-data-sciences.tabsquare_master_quickbooks.account` a
            ON  cl.account_expense_account_id = a.id
            AND cl.source_company = a.source_company
            
            
            LEFT JOIN
                `tabsquare-data-sciences.tabsquare_master_quickbooks.customer` cu
            ON  cl.account_expense_customer_id = cu.id
            AND cl.source_company = cu.source_company
            
            WHERE account_number IS NOT NULL

    UNION ALL 

          SELECT
                &apos;DEPOSIT&apos; as type, 
                 cm.transaction_date, null as doc_number, cu.company_name,1 as exchange_rate,
                 cm.currency_id, cl.description,cl.amount,null as sales_item_quantity, 
                 a.account_number, a.description AS account_description, 
                 a.fully_qualified_name, cm.source_company, null as product_service,cu.fully_qualified_name as full_customer_name
                 
            FROM
                `tabsquare-data-sciences.tabsquare_master_quickbooks.deposit` cm
            INNER JOIN 
                `tabsquare-data-sciences.tabsquare_master_quickbooks.deposit_line` cl
            ON  cm.id = cl.deposit_id
            AND cm.source_company = cl.source_company
            
            -- LEFT JOIN
            --     `tabsquare-data-sciences.tabsquare_master_quickbooks.item` qj
                
            -- ON cl.sales_item_item_id = qj.id
            
            -- AND cl.source_company = qj.source_company
            
            LEFT JOIN
                `tabsquare-data-sciences.tabsquare_master_quickbooks.account` a
            ON  cl.deposit_account_id = a.id
            AND cl.source_company = a.source_company
            
            
            LEFT JOIN
                `tabsquare-data-sciences.tabsquare_master_quickbooks.customer` cu
            ON  cl.deposit_customer_id = cu.id
            AND cl.source_company = cu.source_company
            
            WHERE account_number IS NOT NULL
   

            
            ) 

         
GROUP BY 1,2,3 order by 1,2,3</relation>
          <relation connection='bigquery.1kkd9551e2i8sw1axtwhh1crtqpp' name='Custom SQL Query1' type='text'>SELECT * FROM `tabsquare-data-sciences.data_analysis_team_dev.fresdesk_modified_testing_1`</relation>
          <relation connection='bigquery.1kkd9551e2i8sw1axtwhh1crtqpp' name='Custom SQL Query10' type='text'><![CDATA[select distinct *, 
from

 (select distinct *,
DATE_DIFF(last_date,live_date,  DAY) as date_diff, concat(extract( year from live_date),"-", extract(month from live_date)) as month_year  from 

(select distinct country, live_date,merchant_id as m1,order_date, 
max(last_day(live_date)) over(partition by merchant_id) as last_date, sales, from (select distinct * from ((
  with
  a as(
    select date from
UNNEST(GENERATE_DATE_ARRAY("2022-01-01", current_date(), interval 1 day)) as date
  ),
  b as (
    select trim(merchant_id) as m1,max(cast(live_date as date)) as live_date from 
    `tabsquare-data-sciences.tabsquare_dw_airtable_prod.live_status` where live_date is not null and live_date>>="2022-01-01" and date(live_date)<<= current_date() group by 1
  ),
  c as (select * from a cross join b where date>>=b.live_date  order by m1, date),
  d as (
    SELECT
  trim(Merchant_id) as Merchant_id,RestaurantName,order_date,Country,Product_Type, sum(sales) as Sales, count(order_id) as orders
FROM
  `tabsquare-data-sciences.datastudio_dashboard_data.all_product_firebase_data`
WHERE
  order_date >>= '2022-01-01'
  and merchant_id not like '%HQ-24%'
  and merchant_id not like '%HQ-6278%'
  GROUP BY 1,2,3,4,5
UNION ALL
SELECT
  trim(Merchant_id) as Merchant_id,RestaurantName,order_date,Country,Product_Type,sum(sales) as Sales, count(order_id) as orders
FROM
  `tabsquare-data-sciences.datastudio_dashboard_data.all_product_skipque_data`
WHERE
  order_date >>= '2022-01-01'
  GROUP BY 1,2,3,4,5

UNION ALL 

SELECT
  trim(Merchant_id) as Merchant_id,RestaurantName,extract(date from order_date) as order_date,Country,Product_Type, sum(sales) as Sales, sum(Orders) as orders
FROM
  `tabsquare-data-sciences.tabsquare_dw_lookups.kfc_taco_gmv`
where extract(date from order_date)>>= "2022-01-01"
  GROUP BY 1,2,3,4,5
  ),

  e as (
    select c.m1 as m1, d.merchant_id,d.RestaurantName,d.Country,d.product_type,c.live_date,order_date,c.date,case when order_date != date then 0 else Sales end as new_sales,
  case when date << min(cast(order_date as date)) over(partition by Merchant_id) then -1 else sales end as new_sales1,sales
  from c left join d on c.m1 = d.Merchant_id and order_date>>= live_date order by Merchant_id,order_date,date),
  f as (select m1, Merchant_id,RestaurantName,Country,live_date,date,new_sales,row_number() over(partition by merchant_id,date,product_type order by Merchant_id,date desc) as rank1
   from e where new_sales>>0 or new_sales1=-1 order by Merchant_id, order_date,date)
  select m1, Merchant_id, RestaurantName,Country, live_date, date as order_date, new_sales as Sales from f where rank1=1  order by Merchant_id,date)
  union all 
(
  with
  b as (
    select trim(merchant_id) as m1,max(cast(live_date as date)) as live_date from 
    `tabsquare-data-sciences.tabsquare_dw_airtable_prod.live_status` where live_date is not null and live_date>>="2022-01-01" and date(live_date)<<= current_date() group by 1
  ),
  d as (
    SELECT
  trim(Merchant_id) as Merchant_id,RestaurantName,order_date,Country,Product_Type, sum(sales) as Sales, count(order_id) as orders
FROM
  `tabsquare-data-sciences.datastudio_dashboard_data.all_product_firebase_data`
WHERE
  order_date >>= '2022-01-01'
  and merchant_id not like '%HQ-24%'
  and merchant_id not like '%HQ-6278%'
  GROUP BY 1,2,3,4,5
UNION ALL
SELECT
  trim(Merchant_id) as Merchant_id,RestaurantName,order_date,Country,Product_Type,sum(sales) as Sales, count(order_id) as orders
FROM
  `tabsquare-data-sciences.datastudio_dashboard_data.all_product_skipque_data`
WHERE
  order_date >>= '2022-01-01'
  GROUP BY 1,2,3,4,5

UNION ALL 

SELECT
  trim(Merchant_id) as Merchant_id,RestaurantName,extract(date from order_date) as order_date,Country,Product_Type, sum(sales) as Sales, sum(Orders) as orders
FROM
  `tabsquare-data-sciences.tabsquare_dw_lookups.kfc_taco_gmv`
where extract(date from order_date)>>= "2022-01-01"
  GROUP BY 1,2,3,4,5
  ),
  g as (
select
u.id as restaurant_id,
u.name AS restaurant_name,
trim(u.customer_key) AS Merchant_id,
u.country AS country
FROM
`tabsquare-data-sciences.skipque_cdc_data_prod.users` u
union all
select
o.id as restaurant_id,
o.name AS restaurant_name,
trim(o.merchant_key) AS Merchant_id,
o.country AS country
FROM
`tabsquare-data-sciences.skipque_cdc_data_prod.organization` o) , 

f as  (select b.m1 as m1 , b.live_date from  b left join d on b.m1 = d.merchant_id where d.Merchant_id is null ),  

h as ( select f.m1, f.live_date, g.Merchant_id, g.restaurant_name, g.country  
 from f left join g on f.m1= g.merchant_id)

select  m1, h.merchant_id  , h.restaurant_name as restaurantname ,h.country, live_date, live_date as order_date, 0 as sales from h )
union all 

select * from (select m1, merchant_id , restaurantname, country, live_date, order_date, 0 as sales  from (
  select m1, merchant_id, restaurantname,country, live_date, (cast(live_date as date)) as order_date, 0 as sales, 
  case when max(order_date) over (partition by merchant_id)>>= live_date then
case when order_date is null then 1 else 0 end 
end as da from 
(select trim(Merchant_id) as m1,max(cast(live_date as date)) as live_date from `tabsquare-data-sciences.tabsquare_dw_airtable_prod.live_status` 
where live_date is not null and live_date>>="2022-01-01" and date(live_date)<<= current_date() group by 1) ls
left join (
   SELECT
  trim(Merchant_id) as Merchant_id,RestaurantName,order_date,Country,Product_Type, sum(sales) as Sales, count(order_id) as orders
FROM
  `tabsquare-data-sciences.datastudio_dashboard_data.all_product_firebase_data`
WHERE
  order_date >>= '2022-01-01'
  and merchant_id not like '%HQ-24%'
  and merchant_id not like '%HQ-6278%'
  GROUP BY 1,2,3,4,5
UNION ALL
SELECT
  trim(Merchant_id) as Merchant_id,RestaurantName,order_date,Country,Product_Type,sum(sales) as Sales, count(order_id) as orders
FROM
  `tabsquare-data-sciences.datastudio_dashboard_data.all_product_skipque_data`
WHERE
  order_date >>= '2022-01-01'
  GROUP BY 1,2,3,4,5

UNION ALL 

SELECT
  trim(Merchant_id) as Merchant_id,RestaurantName,extract(date from order_date) as order_date,Country,Product_Type, sum(sales) as Sales, sum(Orders) as orders
FROM
  `tabsquare-data-sciences.tabsquare_dw_lookups.kfc_taco_gmv`
where extract(date from order_date)>>= "2022-01-01"
  GROUP BY 1,2,3,4,5) gmv
on ls.m1= gmv.merchant_id
) as c where da is null) ) where live_date>>= "2022-09-01" and (m1 is not null  and merchant_id is not null )or (m1 is null and merchant_id is null)  order by merchant_id)where order_date>>=live_date  order by country, live_date,m1, order_date) order by country, live_date,m1, order_date)order by country, live_date,m1, order_date]]></relation>
          <relation connection='bigquery.1kkd9551e2i8sw1axtwhh1crtqpp' name='Custom SQL Query9' type='text'><![CDATA[select distinct *,  first_value(value) over(partition by id order by id, date desc) as value_max,
first_value(forecast_revenue) over(partition by id order by id, date desc) as value_forecast_revenue_max,
first_value(forecast_gmv) over(partition by id order by id, date desc) as value_forecast_gmv_max,
ifnull(first_value(custom_gmv) over(partition by id order by id, date desc), max(custom_gmv) over(partition by id)) as value_custom


 from (select distinct account_manager ,name, title, status ,new_status,max_status,max_status_1,  id, date,max_date,  month_year,start_time,
 custom_gmv, user_id, user_name,
value, pipedrive_country, forecast_revenue, forecast_gmv,


 from  (select distinct  account_manager,status,new_status,name, title, id, date, custom_gmv, value , forecast_revenue, forecast_gmv,
 
 month_year,pipedrive_country,start_time,
user_name, user_id,
max(last_day(date)) over(partition by id, month_year) as max_date , 

max(new_status) over(partition by id, month_year) as max_status ,

max(new_status) over(partition by id,name, month_year) as max_status_1,



from  (select distinct date,name,title, concat(extract( year from date),"-", extract(month from date)) as month_year,start_time, 

case when account_manager = "Account Management - ANZ" or account_manager = "Account Management - ANZ MASTER" or 
account_manager ="Resellers - Australia" or
account_manager = "Sales - Australia" then "Australia"

when account_manager = "Account Management - ID" or account_manager ="Account Management - ID - MASTER" or 
account_manager = "Resellers - Indonesia" or 
account_manager = "Sales- Indonesia" then "Indonesia"

when account_manager =" Account Management - MY" or account_manager ="Account Management - MY - MASTER"  or 
account_manager = "Resellers - MY"  or account_manager = "Sales- Malaysia" then "Malaysia"

when account_manager = "Account Management - SG" or account_manager = "Account Management - SG - MASTER" or 
account_manager = "Resellers - SG" 
or account_manager = "Sales Enterprise - Singapore" or account_manager = "Sales Lite Business - Singapore" then "Singapore"
when account_manager = "Sales Enterprise - Hong Kong" then "Hong Kong"
when account_manager = "Sales Enterprise - Taiwan" then "Taiwan"
else "Others"
end as pipedrive_country,
 account_manager, id, user_id, user_name,status, custom_gmv,value , forecast_revenue, forecast_gmv , 
 case when status = "open" then 0 else 1 end as new_status 
from(

with 
a as 
(select distinct account_manager, id, title, user_id,user_name,name,status, start_time,close_time, won_time, deal_updated_time, 
end_time, d1, d2, date(d1) as d3, date(d2)  as d4,  custom_potential_monthly_gmv, 
custom_gmv, weighted_value,dummy,stage_change_time , value,forecast_revenue, forecast_gmv from (select distinct account_manager,id,1 as dummy,title,
 name,user_name,user_id,status,deal_created_time as start_time,deal_updated_time, new_close_time as end_time, 
 new_updated_time as d1, close_time, won_time, lost_time,custom_potential_monthly_gmv,  custom_gmv, weighted_value,stage_change_time,value,
 forecast_revenue, forecast_gmv,
coalesce(max(new_updated_time ) over(partition by id
                        order by new_updated_time
                        rows between 1 following and 1 following), DATE_ADD(new_close_time, INTERVAL 1 DAY)) as d2,
  from 
 
 (select distinct *, 
case when deal_updated_time >>= max(deal_created_time) over(partition by id) and 
deal_updated_time <<= max(new_close_time) over(partition by id) then deal_updated_time
end as new_updated_time from (select distinct  account_manager,id,
 name,user_name,user_id,lost_time, won_time,custom_potential_monthly_gmv,custom_gmv, weighted_value,value,
close_time ,forecast_revenue,forecast_gmv,
deal_updated_time,
deal_created_time,1 as dummy,
close_time_1 as deal_close_time,  title,stage_change_time,
status,coalesce(close_time_1, timestamp(current_date())) as new_close_time from 
 
 
 (select distinct  p.name as account_manager,d.id,
 lower(trim(s.name)) as name,u.name as user_name,u.id as user_id, d.lost_time as lost_time, won_time,
d.close_time as close_time ,
IFNULL(close_time, last_value(close_time ) OVER (PARTITION BY d.id order by d.update_time rows between current row and unbounded following)) as close_time_1,
 d.update_time as deal_updated_time,
d.created_at as deal_created_time,title,custom_potential_monthly_gmv, 
custom_deal_monthly_revenue_forecast_sgd_filled_by_sales_ as forecast_revenue,				
custom_deal_monthly_gmv_forecast_sgd_filled_by_sales_ as forecast_gmv,
 custom_gmv, weighted_value,stage_change_time, value,

  status,
 FROM `tabsquare-data-sciences.pipedrive.deal_history`  d
left join `tabsquare-data-sciences.pipedrive.stage` s
on d.stage_id=s.id
left join `tabsquare-data-sciences.pipedrive.pipeline` p
on d.pipeline_id=p.id
left join `tabsquare-data-sciences.pipedrive.user`  u
on u.id= d.creator_user_id
 
 order by id, deal_updated_time) 
 
 order by id, deal_updated_time) order by id, deal_updated_time, new_updated_time) where new_updated_time is not null  order by id, deal_updated_time, new_updated_time) order by id, deal_updated_time, d1,d2,d3, d4), 


b as (select date, 1 as dummy
from
UNNEST(GENERATE_Date_ARRAY(date('2016-01-01'), current_date(), INTERVAL 1 DAY)) as date)

select distinct *  from b inner join a 
on b.dummy = a.dummy
and b.date>>=a.d3
and b.date<<a.d4

order by id, date, d1,d2,d3,d4

) order by id, date) 
 order by id, date)  where date = max_date order by id, date)  order by id, date]]></relation>
          <relation connection='bigquery.1kkd9551e2i8sw1axtwhh1crtqpp' name='Custom SQL Query4' type='text'>select * from tabsquare-data-sciences.data_analysis_team_dev.ap_modified_testing</relation>
