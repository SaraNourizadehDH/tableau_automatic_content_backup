      <column caption='AM GMV (copy)' datatype='integer' name='[AM GMV (copy)_897764479652757505]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [account_manager (Custom SQL Query9) (group)]= &quot;Account Management&quot; THEN [custom_gmv] END' />
      </column>
      <column caption='AM Created Deals' datatype='integer' name='[AM Lost Deals (copy)_778559826685661193]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_1075797400715599878]= &quot;Account Management&quot; then [Calculation_130745161446907905] end' />
      </column>
      <column caption='AM Lost Deals' datatype='integer' name='[AM Won Deals  (copy)_778559826685116422]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_1075797400715599878]= &quot;Account Management&quot; then [created deals (copy)_130745161447063555] end' />
      </column>
      <column caption='Buckets (copy)' datatype='string' name='[Buckets (copy)_778559826681905154]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_1075797400781545493]&gt;=0 and [Calculation_1075797400781545493]&lt; 20000 then &quot;Low&quot;&#13;&#10;ELSEIF [Calculation_1075797400781545493]&gt;=20000 and [Calculation_1075797400781545493]&lt; 100000 then &quot;Medium&quot;&#13;&#10;ELSEIF [Calculation_1075797400781545493]&gt;=100000  then &quot;High&quot;&#13;&#10;END' />
      </column>
      <column caption='Change in GMV wrt last month' datatype='real' name='[Calculation_1075797400705736704]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([sales (Custom SQL Query3)]-[last_1_month_gmv])/[last_1_month_gmv]' />
      </column>
      <column caption='Lost Merchant Flag(month)' datatype='integer' name='[Calculation_1075797400706023425]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if ifnull([last_3_months_gmv],0)=0 and ifnull([last_4_months_gmv],0)!=0&#13;&#10;and [first_month_flag]=0 and ifnull([sales (Custom SQL Query3)],0)=0 then 1 else 0 end' />
      </column>
      <column caption='Active Cohorts' datatype='string' name='[Calculation_1075797400706768898]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_1075797400705736704]&gt;=0.2 then &apos;Increasing&apos;&#13;&#10;ELSEIF [Calculation_1075797400705736704]&lt;-0.2 then &apos;Decreasing&apos;&#13;&#10;else &apos;Stable&apos;&#13;&#10;end' />
      </column>
      <column caption='Monthly Merchant Cohorts' datatype='string' name='[Calculation_1075797400707006467]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [first_month_flag]=1 then &apos;New&apos;&#13;&#10;ELSEIF ifnull([last_1_month_gmv],0)=0 and ifnull([last_2_months_gmv],0)&gt;0 and ifnull([sales (Custom SQL Query3)],0)=0 then &apos;At Risk of being Lost&apos;&#13;&#10;elseif ifnull([last_2_months_gmv],0)=0 and ifnull([last_3_months_gmv],0)&gt;0 and ifnull([sales (Custom SQL Query3)],0)=0 then &apos;High Risk of being Lost&apos;&#13;&#10;ELSEIF ifnull([last_1_month_gmv],0)&gt;0 and ifnull([sales (Custom SQL Query3)],0)=0 then &apos;Not Active&apos;&#13;&#10;ELSEIF ifnull([last_1_month_gmv],0)&gt;0 and ifnull([sales (Custom SQL Query3)],0)&gt;0 then [Calculation_1075797400706768898]&#13;&#10;elseif ifnull([last_1_month_gmv],0)=0  and ifnull([last_2_months_gmv],0)&gt;0 and ifnull([sales (Custom SQL Query3)],0)&gt;0 then &apos;Quick Restarted&apos;&#13;&#10;elseif ifnull([last_2_months_gmv],0)=0 and ifnull([last_3_months_gmv],0)&gt;0 and ifnull([sales (Custom SQL Query3)],0)&gt;0 then &apos;Restarted&apos;&#13;&#10;elseif ifnull([last_3_months_gmv],0)=0 and ifnull([sales (Custom SQL Query3)],0)&gt;0 then &apos;Back From Dead&apos;&#13;&#10;ELSEIF [Calculation_1075797400706023425]=1 then &apos;Lost&apos;&#13;&#10;end' />
      </column>
      <column caption='Merchant Cohorts- Category' datatype='string' name='[Calculation_1075797400707383300]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [first_month_flag]=1 then &apos;New&apos;&#13;&#10;ELSEIF [Calculation_1075797400707006467] = &apos;Not Active&apos;  then &apos;Not Active&apos;&#13;&#10;elseif [Calculation_1075797400707006467] = &apos;At Risk of being Lost&apos;&#13;&#10;        or [Calculation_1075797400707006467] = &apos;High Risk of being Lost&apos; then &apos;At Risk&apos;&#13;&#10;ELSEIF [Calculation_1075797400707006467] = &apos;Restarted&apos;&#13;&#10;        or [Calculation_1075797400707006467] = &apos;Quick Restarted&apos;&#13;&#10;        or [Calculation_1075797400707006467] = &apos;Back From Dead&apos; then &apos;Restarted&apos;&#13;&#10;else [Calculation_1075797400707006467]&#13;&#10;end' />
        <aliases>
          <alias key='&quot;Decreasing&quot;' value='Active Decreasing' />
          <alias key='&quot;Increasing&quot;' value='Active Increasing ' />
        </aliases>
      </column>
      <column caption='Max Pipeline' datatype='string' name='[Calculation_1075797400715599878]' role='dimension' type='nominal'>
