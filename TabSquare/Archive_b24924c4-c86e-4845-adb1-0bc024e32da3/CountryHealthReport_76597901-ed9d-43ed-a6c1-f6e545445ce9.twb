select * from (select m1, merchant_id , restaurantname, country, live_date, order_date, 0 as sales  from (
  select m1, merchant_id, restaurantname,country, live_date, (cast(live_date as date)) as order_date, 0 as sales, 
  case when max(order_date) over (partition by merchant_id)>>= live_date then
case when order_date is null then 1 else 0 end 
end as da from 
(select trim(Merchant_id) as m1,max(cast(live_date as date)) as live_date from `tabsquare-data-sciences.tabsquare_dw_airtable_prod.live_status` 
where live_date is not null and live_date>>="2022-01-01" and date(live_date)<<= current_date() group by 1) ls
left join (
   SELECT
  trim(Merchant_id) as Merchant_id,RestaurantName,order_date,Country,Product_Type, sum(sales) as Sales, count(order_id) as orders
FROM
  `tabsquare-data-sciences.datastudio_dashboard_data.all_product_firebase_data`
WHERE
  order_date >>= '2022-01-01'
  and merchant_id not like '%HQ-24%'
  and merchant_id not like '%HQ-6278%'
  GROUP BY 1,2,3,4,5
UNION ALL
SELECT
  trim(Merchant_id) as Merchant_id,RestaurantName,order_date,Country,Product_Type,sum(sales) as Sales, count(order_id) as orders
FROM
  `tabsquare-data-sciences.datastudio_dashboard_data.all_product_skipque_data`
WHERE
  order_date >>= '2022-01-01'
  GROUP BY 1,2,3,4,5

UNION ALL 

SELECT
  trim(Merchant_id) as Merchant_id,RestaurantName,extract(date from order_date) as order_date,Country,Product_Type, sum(sales) as Sales, sum(Orders) as orders
FROM
  `tabsquare-data-sciences.tabsquare_dw_lookups.kfc_taco_gmv`
where extract(date from order_date)>>= "2022-01-01"
  GROUP BY 1,2,3,4,5) gmv
on ls.m1= gmv.merchant_id
) as c where da is null) ) where live_date>>= "2022-09-01" and (m1 is not null  and merchant_id is not null )or (m1 is null and merchant_id is null)  order by merchant_id)]]></relation>
          <relation connection='bigquery.1kkd9551e2i8sw1axtwhh1crtqpp' name='Custom SQL Query7' type='text'>select * from tabsquare-data-sciences.data_analysis_team_dev.ar_modified_testing</relation>
          <relation connection='bigquery.1kkd9551e2i8sw1axtwhh1crtqpp' name='Custom SQL Query6' type='text'>select distinct *,
case when status =&quot;won&quot;  then id end as won_id, 
 case when status =&quot;lost&quot; then id end as lost_id, 
 case when status=&quot;open&quot; then id end as created_id,
from (select distinct account_manager , pipedrive_country,id,name,deal_created_time , 
max_won_time, max_created_time, max_lost_time,

concat(extract(year from max_created_time),&quot;-&quot;,extract(month from max_created_time)) as month_year_created_pipedrive,
 status, lost_time,
concat(extract(year from max_lost_time),&quot;-&quot;,extract(month from max_lost_time)) as month_year_lost_pipedrive,won_time,
concat(extract(year from max_won_time),&quot;-&quot;,extract(month from max_won_time)) as month_year_won_pipedrive from 

(select distinct account_manager, pipedrive_country, id,status, name, won_time,  max(won_time) over(partition by id) as max_won_time,
 lost_time,title,
  max(lost_time) over(partition by id) as max_lost_time,
   deal_created_time,max(deal_created_time) over(partition by id) as max_created_time from 
   
   
   (select distinct  p.name as account_manager,d.id,
 lower(trim(s.name)) as name,u.name as user_name,u.id as user_id,
  d.lost_time as lost_time, 
  won_time,
d.close_time as close_time ,
d.update_time as deal_updated_time,
d.created_at as deal_created_time,title,
case when p.name = &quot;Account Management - ANZ&quot; or p.name = &quot;Account Management - ANZ MASTER&quot; or 
p.name =&quot;Resellers - Australia&quot; or
 p.name = &quot;Sales - Australia&quot; then &quot;Australia&quot;

when p.name = &quot;Account Management - ID&quot; or p.name =&quot;Account Management - ID - MASTER&quot; or 
p.name = &quot;Resellers - Indonesia&quot; or 
p.name = &quot;Sales- Indonesia&quot; then &quot;Indonesia&quot;

when p.name =&quot; Account Management - MY&quot; or p.name =&quot;Account Management - MY - MASTER&quot;  or 
p.name = &quot;Resellers - MY&quot;  or p.name = &quot;Sales- Malaysia&quot; then &quot;Malaysia&quot;

when p.name = &quot;Account Management - SG&quot; or p.name = &quot;Account Management - SG - MASTER&quot; or 
p.name = &quot;Resellers - SG&quot; 
or p.name = &quot;Sales Enterprise - Singapore&quot; or p.name = &quot;Sales Lite Business - Singapore&quot; then &quot;Singapore&quot;
when p.name = &quot;Sales Enterprise - Hong Kong&quot; then &quot;Hong Kong&quot;
when p.name = &quot;Sales Enterprise - Taiwan&quot; then &quot;Taiwan&quot;
else &quot;Others&quot;
end as pipedrive_country,	
  status,
 FROM `tabsquare-data-sciences.pipedrive.deal_history`  d
left join `tabsquare-data-sciences.pipedrive.stage` s
on d.stage_id=s.id
left join `tabsquare-data-sciences.pipedrive.pipeline` p
on d.pipeline_id=p.id
left join `tabsquare-data-sciences.pipedrive.user`  u
on u.id= d.creator_user_id
 where ((extract(month from d.update_time) = extract(month from DATE_ADD(current_date, INTERVAL -2 month)) and 
  extract(year from d.update_time) = extract(year from DATE_ADD(current_date, INTERVAL -2 month)))  or  
  (extract(month from d.update_time) = extract(month from DATE_ADD(current_date, INTERVAL -1 month)) and 
  extract(year from d.update_time) = extract(year from DATE_ADD(current_date, INTERVAL -1 month))) or
  (extract(month from d.update_time) = extract(month from DATE_ADD(current_date, INTERVAL 0 month)) 
  and extract(year from d.update_time)= extract(year from DATE_ADD(current_date, INTERVAL 0 month)))
  or   (extract(month from d.update_time) = extract(month from DATE_ADD(current_date, INTERVAL -3 month)) 
  and extract(year from d.update_time)= extract(year from DATE_ADD(current_date, INTERVAL -3 month)))
  or (extract(month from d.update_time) = extract(month from DATE_ADD(current_date, INTERVAL -4 month)) 
  and extract(year from d.update_time)= extract(year from DATE_ADD(current_date, INTERVAL -4 month)))
  or (extract(month from d.update_time) = extract(month from DATE_ADD(current_date, INTERVAL -5 month)) 
  and extract(year from d.update_time)= extract(year from DATE_ADD(current_date, INTERVAL -5 month)))) order by id, d.update_time) order by id)order by id)  order by id</relation>
          <relation connection='bigquery.1kkd9551e2i8sw1axtwhh1crtqpp' name='Custom SQL Query3' type='text'><![CDATA[select base.*,c.sales as sales,concat(extract(year from base.month),"-",extract(month from base.month)) as month_date, 
  sum(sales) over(partition by base.merchant_id
                  order by base.month
                  rows between 4 preceding and 1 preceding) as last_4_months_gmv,
  sum(sales) over(partition by base.merchant_id
                  order by base.month
                  rows between 3 preceding and 1 preceding) as last_3_months_gmv,
  sum(sales) over(partition by base.merchant_id
                  order by base.month
                  rows between 2 preceding and 1 preceding) as last_2_months_gmv,
  sum(sales) over(partition by base.merchant_id
                  order by base.month
                  rows between 1 preceding and 1 preceding) as last_1_month_gmv,
                  mapp.Chain_Name_in_system,mapp.Account_Name,mapp.Name_of_Account_Manager,
mapp.Team
  from
  (
    select merchant_id,RestaurantName,Country, b.month,
    case when min_order_date_month=b.month then 1 else 0 end as first_month_flag
  from
  (
    select merchant_id, RestaurantName, 1 as dummy,Country, min(min_order_date_month) as min_order_date_month
    from
    (
    select merchant_id,RestaurantName,1 as dummy,Country, date_trunc(min(order_date),MONTH) as min_order_date_month
  FROM
    `tabsquare-data-sciences.datastudio_dashboard_data.all_product_firebase_data`
       where order_date <<= current_date('Asia/Singapore')
group by 1,2,3,4
  union all
  select merchant_id,RestaurantName,1 as dummy,Country,date_trunc(min(order_date),MONTH) as min_order_date_month
  FROM
    `tabsquare-data-sciences.datastudio_dashboard_data.all_product_skipque_data`
 where order_date <<= current_date('Asia/Singapore')    
group by 1,2,3,4
    )
    group by 1,2,3,4
  )a
  inner join
  (
    select month, dummy
    from
  (
    SELECT date_trunc(order_date, MONTH) as month,1 as dummy
  FROM
    `tabsquare-data-sciences.datastudio_dashboard_data.all_product_firebase_data`
 where order_date <<= current_date('Asia/Singapore')    
group by 1,2
  union all
    SELECT date_trunc(order_date, MONTH) as month,1 as dummy
  FROM
    `tabsquare-data-sciences.datastudio_dashboard_data.all_product_skipque_data`
 where order_date <<= current_date('Asia/Singapore')    
group by 1,2
  )
  group by 1,2
  )b
  on a.dummy = b.dummy
  where b.month>>=a.min_order_date_month
  )base
  left join
  (
    select merchant_id,  month, sum(sales) as sales
    from
    (
    select merchant_id, date_trunc(order_date,MONTH) as month, sum(sales) as sales
  FROM
    `tabsquare-data-sciences.datastudio_dashboard_data.all_product_firebase_data`
 where order_date <<= current_date('Asia/Singapore')   
 group by 1,2
  union all
  select merchant_id, date_trunc(order_date,MONTH) as month, sum(sales) as sales
  from
    `tabsquare-data-sciences.datastudio_dashboard_data.all_product_skipque_data`
 where order_date <<= current_date('Asia/Singapore')   
 group by 1,2
    )
    group by 1,2
  )c
  on base.month=c.month and 
  base.merchant_id = c.merchant_id 
  left join
`tabsquare-data-sciences.tabsquare_dw_lookups.master_merchant_list` mapp
on base.merchant_id = mapp.merchant_id]]></relation>
