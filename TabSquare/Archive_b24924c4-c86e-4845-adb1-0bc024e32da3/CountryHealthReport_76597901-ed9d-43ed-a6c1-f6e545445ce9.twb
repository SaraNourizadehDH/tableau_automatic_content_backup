    <worksheet name='Freshdesk'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query+ (all_skipque_cdc_data_prod)' name='federated.0xgukxt059r9i61ahck5g1kpil21' />
          </datasources>
          <datasource-dependencies datasource='federated.0xgukxt059r9i61ahck5g1kpil21'>
            <column caption='others_count' datatype='integer' name='[Calculation_1977221000845209604]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(COUNTD([finance_1]),0)+IFNULL(COUNTD([implementation_1]),0)+IFNULL(COUNTD([menu_1]),0)+IFNULL(COUNTD([payment_1]),0)+IFNULL(COUNTD([others_1]),0)' />
            </column>
            <column caption='l1_reso' datatype='integer' name='[Calculation_1977221000847626245]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if  rn_resolved_at= 1 and ticket_categorization = &quot;l1&quot; and status = &quot;Resolved&quot; and month_year_created=month_year_resolved and  source_new &lt;&gt; &quot;Whatsapp&quot; then DATEDIFF( &apos;day&apos;, [ticket_created_at],[ticket_resolved_at]) end' />
            </column>
            <column caption='l1_ticket' datatype='integer' name='[Calculation_1977221000847962119]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if  rn_resolved_at= 1 and ticket_categorization = &quot;l1&quot; and status = &quot;Resolved&quot; and month_year_created=month_year_resolved and  source_new &lt;&gt; &quot;Whatsapp&quot; then [ticket_id] end' />
            </column>
            <column caption='l1_average_resolution_time' datatype='real' name='[Calculation_1977221000848138249]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([l1_reso (copy)_1977221000847867910])/COUNTD([l1_ticket (copy)_1977221000848060424])' />
            </column>
            <column caption='l3_reso' datatype='integer' name='[Calculation_1977221000849784844]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if  rn_resolved_at= 1 and ticket_categorization = &quot;l3&quot; and status = &quot;Resolved&quot; and month_year_created=month_year_resolved and  source_new &lt;&gt; &quot;Whatsapp&quot; then DATEDIFF( &apos;day&apos;, [ticket_created_at],[ticket_resolved_at]) end' />
            </column>
            <column caption='l3_ticket' datatype='integer' name='[Calculation_1977221000850128910]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if  rn_resolved_at= 1 and ticket_categorization = &quot;l3&quot; and status = &quot;Resolved&quot; and month_year_created=month_year_resolved and  source_new &lt;&gt; &quot;Whatsapp&quot; then [ticket_id] end' />
            </column>
            <column caption='l3_ticket_new' datatype='integer' name='[Calculation_1977221000850194447]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if not ISNULL([Calculation_1977221000849784844]) then [Calculation_1977221000850128910] END' />
            </column>
            <column caption='l3_average_resolution_time' datatype='real' name='[Calculation_1977221000850264080]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([l3_reso (copy)_1977221000849907725])/COUNTD([Calculation_1977221000850194447])' />
            </column>
            <column caption='finance_reso' datatype='integer' name='[Calculation_1977221000850935825]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if  rn_resolved_at= 1 and ticket_categorization = &quot;Finance Team&quot; and status = &quot;Resolved&quot; and month_year_created=month_year_resolved and  source_new &lt;&gt; &quot;Whatsapp&quot; then DATEDIFF( &apos;day&apos;, [ticket_created_at],[ticket_resolved_at]) end' />
            </column>
            <column caption='finance_ticket' datatype='integer' name='[Calculation_1977221000851226645]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if  rn_resolved_at= 1 and ticket_categorization = &quot;Finance Team&quot; and status = &quot;Resolved&quot; and month_year_created=month_year_resolved and  source_new &lt;&gt; &quot;Whatsapp&quot; then [ticket_id] end' />
            </column>
            <column caption='finance_ticket_new' datatype='integer' name='[Calculation_1977221000851288086]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if not ISNULL([Calculation_1977221000850935825]) then [Calculation_1977221000851226645] END' />
            </column>
            <column caption='payment_support_ticket' datatype='integer' name='[Calculation_1977221000853901345]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if  rn_resolved_at= 1 and ticket_categorization = &quot;Payment Support&quot; and status = &quot;Resolved&quot; and month_year_created=month_year_resolved and  source_new &lt;&gt; &quot;Whatsapp&quot; then [ticket_id] end' />
            </column>
            <column caption='others_reso' datatype='integer' name='[Calculation_1977221000854155300]' role='measure' type='quantitative'>
