              <calculation class='tableau' formula='#2025-06-30#' />
            </column>
            <column caption='Select Time Interval' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1us9m2j00qi5sf1fe9c1a1m03o7i'>
            <column caption='Account Name' datatype='string' name='[Account_Name]' role='dimension' type='nominal' />
            <column caption='Date Filter' datatype='boolean' name='[Calculation_5002373319919808524]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[created_date] &gt;= [Parameters].[Parameter 1] AND [created_date] &lt;= [Parameters].[Parameter 2]' />
            </column>
            <column caption='Selected Time Interval' datatype='string' name='[Calculation_5002373319919996941]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &quot;Month&quot; THEN&#10;  DATENAME(&apos;month&apos;, [created_date]) + &apos; &apos; + STR(YEAR([created_date]))&#10;&#10;ELSEIF [Parameters].[Parameter 3] = &quot;Quarter&quot; THEN&#10;  &apos;Q&apos; + STR(DATEPART(&apos;quarter&apos;, [created_date])) + &apos;-&apos; + STR(DATEPART(&apos;year&apos;, [created_date]))&#10;&#10;ELSEIF [Parameters].[Parameter 3] = &quot;Week&quot; THEN&#10;  str(date((DATETRUNC(&apos;week&apos;, [created_date]))))&#10;&#10;ELSE&#10;  NULL&#10;END' />
            </column>
            <column caption='Chain Name in system' datatype='string' name='[Chain_Name_in_system]' role='dimension' type='nominal' />
            <column caption='Created Date' datatype='date' name='[created_date]' role='dimension' type='ordinal' />
            <column caption='Merchant Name' datatype='string' name='[merchant_name]' role='dimension' type='nominal' />
            <column-instance column='[created_date]' derivation='Min' name='[min:created_date:qk]' pivot='key' type='quantitative' />
