      </column>
      <column caption='For you total orders-Denominator' datatype='integer' name='[Calculation_5002373319941275675]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(if [Calculation_5002373319941070873]&gt;0 then [order_id_mod] end)' />
