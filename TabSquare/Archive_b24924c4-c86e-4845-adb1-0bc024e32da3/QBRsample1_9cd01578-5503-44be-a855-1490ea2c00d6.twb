    <worksheet name='For You Acceptance rate'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='for you ir' name='federated.1vmbnrd1yljyt017ql4x01k9akhl' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Start Date' datatype='date' name='[Parameter 1]' param-domain-type='any' role='measure' type='quantitative' value='#2025-04-01#'>
              <calculation class='tableau' formula='#2025-04-01#' />
            </column>
            <column caption='End Date' datatype='date' name='[Parameter 2]' param-domain-type='any' role='measure' type='quantitative' value='#2025-06-30#'>
              <calculation class='tableau' formula='#2025-06-30#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1vmbnrd1yljyt017ql4x01k9akhl'>
            <column caption='Account Name' datatype='string' name='[Account_Name]' role='dimension' type='nominal' />
            <column caption='Date Filter' datatype='boolean' name='[Calculation_5002373319892574214]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[date] &gt;= [Parameters].[Parameter 1] AND [date] &lt;= [Parameters].[Parameter 2]' />
            </column>
            <column caption='For you accepted flag (order_id)' datatype='integer' name='[Calculation_5002373319940927512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [order_id_mod]: max([for_you_flag])}' />
            </column>
            <column caption='For you accepted response flag (order_id) ' datatype='integer' name='[Calculation_5002373319941070873]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [order_id_mod]: max([fy_resp_flag])}' />
            </column>
            <column caption='For You Accepted Order count (merchant_id, date, customer_type, repeat types)- Numerator' datatype='integer' name='[Calculation_5002373319941177370]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [merchant_id], [date], [customer_type], [org_repeat_type], [menu_mode]:&#10;countd(if [Calculation_5002373319940927512]&gt;0 and [Calculation_5002373319941070873]&gt;0 then [order_id_mod] end)}' />
            </column>
            <column caption='For you total orders-Denominator' datatype='integer' name='[Calculation_5002373319941275675]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(if [Calculation_5002373319941070873]&gt;0 then [order_id_mod] end)' />
            </column>
            <column caption='For You Acceptance Rate' datatype='real' name='[Calculation_5002373319946407968]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_5002373319941177370])/ ([Calculation_5002373319941275675])' />
            </column>
            <column caption='Chain Name in system' datatype='string' name='[Chain_Name_in_system]' role='dimension' type='nominal' />
            <column caption='Customer Type' datatype='string' name='[customer_type]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;guest&quot;' value='Guest' />
                <alias key='&quot;login&quot;' value='Login' />
              </aliases>
            </column>
            <column caption='Date' datatype='date' datatype-customized='true' name='[date]' role='dimension' type='ordinal' />
            <column caption='For You Flag' datatype='integer' name='[for_you_flag]' role='measure' type='quantitative' />
            <column caption='Fy Resp Flag' datatype='integer' name='[fy_resp_flag]' role='dimension' type='quantitative' />
            <column caption='Menu Mode' datatype='string' name='[menu_mode]' role='dimension' type='nominal' />
            <column caption='Merchant Id' datatype='string' name='[merchant_id]' role='dimension' type='nominal' />
