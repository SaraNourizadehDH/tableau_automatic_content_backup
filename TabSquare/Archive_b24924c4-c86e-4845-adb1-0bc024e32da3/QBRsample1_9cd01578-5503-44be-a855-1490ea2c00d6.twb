            <column-instance column='[Calculation_5002373319919996941]' derivation='None' name='[none:Calculation_5002373319919996941:nk]' pivot='key' type='nominal' />
            <column-instance column='[Chain_Name_in_system]' derivation='None' name='[none:Chain_Name_in_system:nk]' pivot='key' type='nominal' />
            <column-instance column='[merchant_name]' derivation='None' name='[none:merchant_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[result]' derivation='None' name='[none:result:nk]' pivot='key' type='nominal' />
            <column caption='Order Id' datatype='integer' name='[order_id]' role='dimension' type='ordinal' />
            <column-instance column='[order_id]' derivation='CountD' name='[pcto:ctd:order_id:qk:1]' pivot='key' type='quantitative'>
              <table-calc ordering-field='[federated.1us9m2j00qi5sf1fe9c1a1m03o7i].[none:result:nk]' ordering-type='Field' type='PctTotal' />
