    <worksheet name='Item Reco Acceptance Rate Across Time'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='for you ir' name='federated.1vmbnrd1yljyt017ql4x01k9akhl' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Start Date' datatype='date' name='[Parameter 1]' param-domain-type='any' role='measure' type='quantitative' value='#2025-04-01#'>
              <calculation class='tableau' formula='#2025-04-01#' />
            </column>
            <column caption='End Date' datatype='date' name='[Parameter 2]' param-domain-type='any' role='measure' type='quantitative' value='#2025-06-30#'>
              <calculation class='tableau' formula='#2025-06-30#' />
            </column>
            <column caption='Select Time Interval' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1vmbnrd1yljyt017ql4x01k9akhl'>
            <column caption='Account Name' datatype='string' name='[Account_Name]' role='dimension' type='nominal' />
            <column caption='Date Filter' datatype='boolean' name='[Calculation_5002373319892574214]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[date] &gt;= [Parameters].[Parameter 1] AND [date] &lt;= [Parameters].[Parameter 2]' />
            </column>
            <column caption='Selected Time Interval' datatype='string' name='[Calculation_5002373319892791303]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &quot;Month&quot; THEN&#10;  DATENAME(&apos;month&apos;, [date]) + &apos; &apos; + STR(YEAR([date]))&#10;&#10;ELSEIF [Parameters].[Parameter 3] = &quot;Quarter&quot; THEN&#10;  &apos;Q&apos; + STR(DATEPART(&apos;quarter&apos;, [date])) + &apos;-&apos; + STR(DATEPART(&apos;year&apos;, [date]))&#10;&#10;ELSEIF [Parameters].[Parameter 3] = &quot;Week&quot; THEN&#10;  str(date((DATETRUNC(&apos;week&apos;, [date]))))&#10;&#10;ELSE&#10;  NULL&#10;END' />
            </column>
            <column caption='IR accepted flag (order_id)' datatype='integer' name='[Calculation_5002373319941419036]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [order_id_mod]: max([reco_flag])}' />
            </column>
            <column caption='IR accepted response flag (order_id)' datatype='integer' name='[Calculation_5002373319941509149]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [order_id_mod]: max([IR_OR_resp_flag])}' />
            </column>
            <column caption='IR total orders-denominator' datatype='integer' name='[Calculation_5002373319941603358]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(if [Calculation_5002373319941509149] &gt;0 then [order_id_mod] end)' />
            </column>
            <column caption='IR Accepted Order count (merchant_id, date, customer_type, repeat types)- Numerator' datatype='integer' name='[Calculation_5002373319942377503]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [merchant_id], [date], [customer_type], [org_repeat_type], [menu_mode]:&#10;countd(if [Calculation_5002373319941419036]&gt;0 and [Calculation_5002373319941509149] &gt;0 then [order_id_mod] end)}' />
            </column>
            <column caption='Item Reco Acceptance Rate' datatype='real' name='[Calculation_5002373319946489889]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_5002373319942377503])/[Calculation_5002373319941603358]' />
            </column>
            <column caption='Chain Name in system' datatype='string' name='[Chain_Name_in_system]' role='dimension' type='nominal' />
            <column caption='IR OR resp flag' datatype='integer' name='[IR_OR_resp_flag]' role='measure' type='quantitative' />
