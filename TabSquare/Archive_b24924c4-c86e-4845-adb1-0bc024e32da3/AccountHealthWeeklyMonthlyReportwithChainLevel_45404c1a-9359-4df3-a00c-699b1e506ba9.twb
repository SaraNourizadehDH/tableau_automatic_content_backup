          <alias key='&quot;[federated.01ogsvb1yq9z2h18yzda41i2f3iq].[usr:Calculation_2408088810322358310:qk]&quot;' value='Total Implemented Outlets' />
          <alias key='&quot;[federated.01ogsvb1yq9z2h18yzda41i2f3iq].[usr:Calculation_2408088810323832871:qk]&quot;' value='Others Count' />
        </aliases>
      </column>
      <column caption='GMV in Local' datatype='real' name='[Calculation_2408088810309914627]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case  [country] when &quot;Australia&quot;  then [sales]/0.9004687&#10;when &quot;Singapore&quot; then [sales]&#10;when &quot;Malaysia&quot; then [sales]/0.30175252&#10;when &quot;Indonesia&quot; then [sales]/0.000089&#10;else [sales]&#10;END' />
      </column>
      <column caption='Paid GMV in Local' datatype='real' name='[Calculation_2408088810309984260]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case  [country] when &quot;Australia&quot;  then [paid_gmv]/0.9004687&#10;when &quot;Singapore&quot; then [paid_gmv]&#10;when &quot;Malaysia&quot; then [paid_gmv]/0.30175252&#10;when &quot;Indonesia&quot; then [paid_gmv]/0.000089&#10;else [paid_gmv]&#10;END' />
      </column>
      <column caption='Orders/Outlet' datatype='real' name='[Calculation_2408088810310078469]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders])/COUNTD([merchant_id])' />
      </column>
      <column caption='GMV /Outlet' datatype='real' name='[Calculation_2408088810310664198]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sales])/COUNTD([merchant_id])' />
      </column>
      <column caption='Paid GMV %' datatype='real' name='[Calculation_2408088810310832135]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_2408088810309984260])/SUM([Calculation_2408088810309914627])' />
      </column>
      <column caption='ABV' datatype='real' name='[Calculation_2408088810311065608]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_2408088810309914627])/SUM([orders])' />
      </column>
      <column caption='Customer Type' datatype='string' name='[Calculation_2408088810312110089]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [customer_id]&gt;0 then &apos;Login&apos; else &apos;Guest&apos; END' />
      </column>
      <column caption='Guest Orders' datatype='integer' name='[Calculation_2408088810312265738]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_2408088810312110089]=&apos;Guest&apos; then [orders (Custom SQL Query2)] END' />
      </column>
      <column caption='Guest ABV' datatype='real' name='[Calculation_2408088810313936912]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Login Sales (copy)_2408088810313555983])/SUM([Calculation_2408088810312265738])' />
      </column>
      <column caption='Login ABV' datatype='real' name='[Calculation_2408088810314719251]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Guest Orders (copy)_2408088810312384524])/ SUM([Guest Orders (copy)_2408088810312318987])' />
      </column>
      <column caption='Login Order %' datatype='real' name='[Calculation_2408088810314973205]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Guest Orders (copy)_2408088810312318987])/SUM([orders (Custom SQL Query2)])' />
      </column>
      <column caption='Guest Order %' datatype='real' name='[Calculation_2408088810315059222]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_2408088810312265738])/SUM([orders (Custom SQL Query2)])' />
      </column>
      <column caption='Login Customer Count' datatype='integer' name='[Calculation_2408088810315149335]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [Calculation_2408088810312110089]=&apos;Login&apos; then [customer_id] END)' />
      </column>
      <column caption='date_diff' datatype='integer' name='[Calculation_2408088810316972056]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[date_diff_month]' />
      </column>
      <column caption='Fixed Date Diff Max' datatype='integer' name='[Calculation_2408088810317213721]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [m1]: MAX(if [Calculation_2408088810317299738]=True then [Calculation_2408088810316972056] END)}' />
      </column>
      <column caption='Date Filter' datatype='boolean' name='[Calculation_2408088810317299738]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[order_date]&lt;=[last_date]' />
      </column>
      <column caption='Converted Sales' datatype='real' name='[Calculation_2408088810317504539]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [mm_country] == &apos;Singapore&apos; THEN [Sales (Custom SQL Query3)]&#10;ELSEIF [mm_country] == &apos;Australia&apos; THEN [Sales (Custom SQL Query3)]&#10;ELSEIF [mm_country] == &apos;Indonesia&apos; THEN [Sales (Custom SQL Query3)] * 0.000092&#10;ELSEIF [mm_country] == &apos;Malayasia&apos; THEN [Sales (Custom SQL Query3)] * 0.33&#10;ELSE [Sales (Custom SQL Query3)] END' />
      </column>
      <column caption='Fixed Sales Merchant' datatype='real' name='[Calculation_2408088810321399837]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [m1]: sum(if [Calculation_2408088810317299738]=True then [Calculation_2408088810317504539] END)}' />
      </column>
      <column caption='Sales/diff' datatype='real' name='[Calculation_2408088810321530910]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2408088810321399837]/ [Calculation_2408088810317213721]' />
      </column>
      <column caption='Sales Per Day' datatype='real' name='[Calculation_2408088810321608735]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if ISNULL([Calculation_2408088810321530910]) then [Calculation_2408088810321399837] else [Calculation_2408088810321530910] end' />
      </column>
      <column caption='sales for whole month' datatype='real' name='[Calculation_2408088810321682464]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2408088810321608735]*30' />
      </column>
      <column caption='Buckets' datatype='string' name='[Calculation_2408088810321821729]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_2408088810321682464]&gt;=0 and [Calculation_2408088810321682464]&lt; 20000 then &quot;Low&quot;&#10;ELSEIF [Calculation_2408088810321682464]&gt;=20000 and [Calculation_2408088810321682464]&lt; 100000 then &quot;Medium&quot;&#10;ELSEIF [Calculation_2408088810321682464]&gt;=100000  then &quot;High&quot;&#10;END' />
      </column>
      <column caption='Low Buckets' datatype='string' name='[Calculation_2408088810321887266]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_2408088810321821729] =&quot;Low&quot; then [m1] END' />
      </column>
      <column caption='Total Buckets' datatype='integer' name='[Calculation_2408088810322358310]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Merchant_id (Custom SQL Query3)])' />
      </column>
      <column caption='others counts' datatype='integer' name='[Calculation_2408088810323832871]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(COUNTD([finance_1]),0)+IFNULL(COUNTD([implementation_1]),0)+IFNULL(COUNTD([menu_1]),0)+IFNULL(COUNTD([payment_1]),0)+IFNULL(COUNTD([others_1]),0)' />
      </column>
      <column caption='Contact Ratio' datatype='real' name='[Calculation_2408088810324602921]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(COUNTD([l1_1])+COUNTD([l3_1])+COUNTD([Calculation_2408088810356891705]))/sum([orders])' />
      </column>
      <column caption='Failed Order' datatype='integer' name='[Calculation_2408088810326016042]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Result]= &quot;FAILED&quot; then [order_count] END' />
      </column>
      <column caption='Success Order' datatype='integer' name='[Calculation_2408088810326089771]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Result]= &quot;SUCCESS&quot; then [order_count] END' />
      </column>
      <column caption='Total Order Count' datatype='integer' name='[Calculation_2408088810326253612]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Calculation_2408088810326016042],0)+IFNULL([Calculation_2408088810326089771],0)' />
      </column>
      <column caption='Success %' datatype='real' name='[Calculation_2408088810326343725]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_2408088810326089771])/SUM([order_count])' />
      </column>
      <column caption='Change in GMV wrt last month' datatype='real' name='[Calculation_2408088810328784945]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([sales (Custom SQL Query4)]-[last_1_month_gmv])/[last_1_month_gmv]' />
      </column>
      <column caption='Lost Merchant Flag(month)' datatype='integer' name='[Calculation_2408088810328883250]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if ifnull([last_3_months_gmv],0)=0 and ifnull([last_4_months_gmv],0)!=0&#10;and [first_month_flag]=0 and ifnull([sales (Custom SQL Query4)],0)=0 then 1 else 0 end' />
      </column>
      <column caption='Active Cohorts' datatype='string' name='[Calculation_2408088810328973363]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_2408088810328784945]&gt;=0.2 then &apos;Increasing&apos;&#10;ELSEIF [Calculation_2408088810328784945]&lt;-0.2 then &apos;Decreasing&apos;&#10;else &apos;Stable&apos;&#10;end' />
      </column>
      <column caption='Monthly Merchant Cohorts' datatype='string' name='[Calculation_2408088810329157684]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [first_month_flag]=1 then &apos;New&apos;&#10;ELSEIF ifnull([last_1_month_gmv],0)=0 and ifnull([last_2_months_gmv],0)&gt;0 and ifnull([sales (Custom SQL Query4)],0)=0 then &apos;At Risk of being Lost&apos;&#10;elseif ifnull([last_2_months_gmv],0)=0 and ifnull([last_3_months_gmv],0)&gt;0 and ifnull([sales (Custom SQL Query4)],0)=0 then &apos;High Risk of being Lost&apos;&#10;ELSEIF ifnull([last_1_month_gmv],0)&gt;0 and ifnull([sales (Custom SQL Query4)],0)=0 then &apos;Not Active&apos;&#10;ELSEIF ifnull([last_1_month_gmv],0)&gt;0 and ifnull([sales (Custom SQL Query4)],0)&gt;0 then [Calculation_2408088810328973363]&#10;elseif ifnull([last_1_month_gmv],0)=0  and ifnull([last_2_months_gmv],0)&gt;0 and ifnull([sales (Custom SQL Query4)],0)&gt;0 then &apos;Quick Restarted&apos;&#10;elseif ifnull([last_2_months_gmv],0)=0 and ifnull([last_3_months_gmv],0)&gt;0 and ifnull([sales (Custom SQL Query4)],0)&gt;0 then &apos;Restarted&apos;&#10;elseif ifnull([last_3_months_gmv],0)=0 and ifnull([sales (Custom SQL Query4)],0)&gt;0 then &apos;Back From Dead&apos;&#10;ELSEIF [Calculation_2408088810328883250]=1 then &apos;Lost&apos;&#10;end' />
      </column>
      <column caption='Merchant Cohorts - Category' datatype='string' name='[Calculation_2408088810329313333]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [first_month_flag]=1 then &apos;New&apos;&#10;ELSEIF [Calculation_2408088810329157684] = &apos;Not Active&apos;  then &apos;Not Active&apos;&#10;elseif [Calculation_2408088810329157684] = &apos;At Risk of being Lost&apos;&#10;        or [Calculation_2408088810329157684] = &apos;High Risk of being Lost&apos; then &apos;At Risk&apos;&#10;ELSEIF [Calculation_2408088810329157684] = &apos;Restarted&apos;&#10;        or [Calculation_2408088810329157684] = &apos;Quick Restarted&apos;&#10;        or [Calculation_2408088810329157684] = &apos;Back From Dead&apos; then &apos;Restarted&apos;&#10;else [Calculation_2408088810329157684]&#10;end' />
        <aliases>
          <alias key='&quot;Decreasing&quot;' value='Active Decreasing' />
          <alias key='&quot;Increasing&quot;' value='Active Increasing' />
        </aliases>
      </column>
      <column caption='Paid GMV/Outlet' datatype='real' name='[Calculation_2408088810341261366]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_2408088810309984260])/COUNTD([merchant_id])' />
      </column>
      <column caption='others_ticket' datatype='integer' name='[Calculation_2408088810356891705]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if  rn_resolved_at= 1 and ticket_categorization = &quot;others&quot; and status = &quot;Resolved&quot; and [month_year_created]=[month_year_resolved] and  source_new &lt;&gt; &quot;Whatsapp&quot; then [ticket_id] end' />
      </column>
      <column datatype='string' name='[Country (Custom SQL Query3)]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column datatype='string' name='[Country (Custom SQL Query4)]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column datatype='string' name='[Country (Custom SQL Query6)]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column caption='Login Orders' datatype='integer' name='[Guest Orders (copy)_2408088810312318987]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_2408088810312110089]=&apos;Login&apos; then [orders (Custom SQL Query2)] END' />
      </column>
      <column caption='Login Sales' datatype='real' name='[Guest Orders (copy)_2408088810312384524]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_2408088810312110089]=&apos;Login&apos; then [sales (Custom SQL Query2)] END' />
      </column>
      <column caption='Guest Sales' datatype='real' name='[Login Sales (copy)_2408088810313555983]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_2408088810312110089]=&apos;Guest&apos; then [sales (Custom SQL Query2)] END' />
      </column>
      <column caption='High Buckets' datatype='string' name='[Low Buckets (copy 2)_2408088810322026533]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_2408088810321821729] =&quot;High&quot; then [m1] END' />
      </column>
      <column caption='Medium Buckets' datatype='string' name='[Low Buckets (copy) (copy)_2408088810321944612]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_2408088810321821729] =&quot;Medium&quot; then [m1] END' />
      </column>
      <column caption='Restaurant Name' datatype='string' name='[RestaurantName (Custom SQL Query4)]' role='dimension' type='nominal' />
      <column caption='Failed %' datatype='real' name='[Success % (copy)_2408088810326384686]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_2408088810326016042])/SUM([order_count])' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Rating' datatype='table' name='[__tableau_internal_object_id__].[_08289AFA1B024177A077E934F5B9C931]' role='measure' type='quantitative' />
      <_.fcp.ObjectModelTableType.true...column caption='Freshdesk' datatype='table' name='[__tableau_internal_object_id__].[_23855EC77E6C4DD5A3521B6AA8EFBCC8]' role='measure' type='quantitative' />
      <_.fcp.ObjectModelTableType.true...column caption='Success/Failed' datatype='table' name='[__tableau_internal_object_id__].[_5683CCDA62524C1CB4EB49411A5AC4F5]' role='measure' type='quantitative' />
      <_.fcp.ObjectModelTableType.true...column caption='Implementation' datatype='table' name='[__tableau_internal_object_id__].[_5E41E5B5725846A486A1FBB43986A06D]' role='measure' type='quantitative' />
      <_.fcp.ObjectModelTableType.true...column caption='GMV' datatype='table' name='[__tableau_internal_object_id__].[_60A5A9BBE44F41FF8FEF2115663F74B1]' role='measure' type='quantitative' />
      <_.fcp.ObjectModelTableType.true...column caption='GMV Product Level' datatype='table' name='[__tableau_internal_object_id__].[_6A05CAE6C2D647E1853CF799AB9F4FC3]' role='measure' type='quantitative' />
      <_.fcp.ObjectModelTableType.true...column caption='Merchant Status' datatype='table' name='[__tableau_internal_object_id__].[_B2C307248365420F9BE7256AD5040AF1]' role='measure' type='quantitative' />
      <column datatype='string' name='[country (Custom SQL Query2)]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column datatype='string' name='[country (Custom SQL Query5)]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column datatype='string' name='[country_new]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column datatype='integer' name='[l1_1]' role='measure' type='quantitative' />
      <column datatype='integer' name='[l3_1]' role='measure' type='quantitative' />
      <column datatype='string' name='[merchant_id]' role='dimension' type='nominal' />
      <column datatype='string' name='[mm_country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column datatype='integer' name='[orders]' role='measure' type='quantitative' />
      <column datatype='string' name='[rating (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[rating]' new-bin='true'>
          <bin default-name='false' value='&quot;Negative Rating&quot;'>
            <value>0</value>
            <value>1</value>
            <value>2</value>
          </bin>
          <bin default-name='false' value='&quot;Neutral Rating&quot;'>
            <value>3</value>
          </bin>
          <bin default-name='false' value='&quot;Positive Rating&quot;'>
            <value>4</value>
            <value>5</value>
          </bin>
        </calculation>
      </column>
      <column aggregation='Sum' datatype='integer' name='[rating]' role='dimension' type='ordinal' />
      <column datatype='real' name='[sales]' role='measure' type='quantitative' />
      <column datatype='string' name='[year_month]' role='dimension' type='nominal' />
      <column-instance column='[Calculation_2408088810321887266]' derivation='CountD' name='[ctd:Calculation_2408088810321887266:qk]' pivot='key' type='quantitative' />
      <column-instance column='[Low Buckets (copy 2)_2408088810322026533]' derivation='CountD' name='[ctd:Low Buckets (copy 2)_2408088810322026533:qk]' pivot='key' type='quantitative' />
      <column-instance column='[Low Buckets (copy) (copy)_2408088810321944612]' derivation='CountD' name='[ctd:Low Buckets (copy) (copy)_2408088810321944612:qk]' pivot='key' type='quantitative' />
      <column-instance column='[l1_1]' derivation='CountD' name='[ctd:l1_1:qk]' pivot='key' type='quantitative' />
      <column-instance column='[l3_1]' derivation='CountD' name='[ctd:l3_1:qk]' pivot='key' type='quantitative' />
      <column-instance column='[merchant_id]' derivation='CountD' name='[ctd:merchant_id:qk]' pivot='key' type='quantitative' />
      <column-instance column='[orders]' derivation='Sum' name='[sum:orders:qk]' pivot='key' type='quantitative' />
      <column-instance column='[sales]' derivation='Sum' name='[sum:sales:qk]' pivot='key' type='quantitative' />
      <column-instance column='[Calculation_2408088810322358310]' derivation='User' name='[usr:Calculation_2408088810322358310:qk]' pivot='key' type='quantitative' />
      <column-instance column='[Calculation_2408088810323832871]' derivation='User' name='[usr:Calculation_2408088810323832871:qk]' pivot='key' type='quantitative' />
      <group caption='Action (Merchant Cohorts - Category,year_month)' hidden='true' name='[Action (Merchant Cohorts - Category,year_month)]' name-style='unqualified' user:auto-column='sheet_link'>
        <groupfilter function='crossjoin'>
          <groupfilter function='level-members' level='[Calculation_2408088810329313333]' />
          <groupfilter function='level-members' level='[year_month]' />
        </groupfilter>
      </group>
      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;India&quot;' />
      </semantic-values>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Rating' id='_08289AFA1B024177A077E934F5B9C931'>
            <properties context=''>
              <relation connection='bigquery.176jz4z1s9dj8n16mqqld0bl6b71' name='Custom SQL Query5' type='text'>with a as
(
 select merchant_id,product_ref, feature, rating,remarks, version_no, `date`,  from `tabsquare-data-sciences.emenu_events.sk_customer_feedback`
union all
select merchant_id,product_ref, feature, rating,remarks, version_no, event_date as `date` from `tabsquare-data-sciences.emenu_events.sw_customer_feedback_view`
),
b as
(select * from `tabsquare-data-sciences.tabsquare_dw_lookups.master_merchant_list` )


select a.merchant_id,a.product_ref,a.feature,a.rating,remarks,a.version_no, format_date(&quot;%Y-%m&quot;, a.`date`) as year_month,
FORMAT_DATE(&apos;%Y-%m-%d&apos;, DATE_TRUNC(a.`date`, WEEK(MONDAY))) as year_month_week, b.Account_name, b.name_of_account_manager, b.country, b.Chain_Name_in_system
from a left join b on a.merchant_id= b.merchant_id</relation>
            </properties>
          </object>
          <object caption='Freshdesk' id='_23855EC77E6C4DD5A3521B6AA8EFBCC8'>
            <properties context=''>
              <relation connection='bigquery.176jz4z1s9dj8n16mqqld0bl6b71' name='Custom SQL Query1' type='text'><![CDATA[select distinct * from
(select distinct ticket_id,
ifnull(deleted, False) as deleted,
month_year_created,
month_year_resolved,
Name_of_Account_Manager, Account_Name,
Chain_Name_in_system,
year_month_week_created,
year_month_week_resolved,
ticket_created_at,
ticket_resolved_at,
status,
source_new,
country_new,
concat(country_new,"-", source_new, "-", month_year_created,"-", status ) as abcd,
rn_updated_at_ticket,rn_resolved_at, ticket_categorization,
case when rn_updated_at_ticket=1 and ticket_categorization = "l1" then ticket_id end as l1_1,
case when rn_updated_at_ticket=1 and ticket_categorization = "l3" then ticket_id end as l3_1,
case when rn_updated_at_ticket=1 and ticket_categorization = "Finance Team" then ticket_id end as finance_1,
case when rn_updated_at_ticket=1 and ticket_categorization = "Payment Support" then ticket_id end as payment_1,
case when rn_updated_at_ticket=1 and ticket_categorization = "Implementation Team" then ticket_id end as implementation_1,
case when rn_updated_at_ticket=1 and ticket_categorization = "Menu Team" then ticket_id end as menu_1,
case when rn_updated_at_ticket=1 and ticket_categorization = "others" then ticket_id end as others_1,
CASE WHEN rn_updated_at_ticket=1 and satisfaction_rating = '100' THEN ticket_id end as neutral_rating,
CASE WHEN rn_updated_at_ticket=1 and satisfaction_rating = '-103' THEN ticket_id end as negative_rating,
CASE WHEN rn_updated_at_ticket=1 and satisfaction_rating = '103' THEN ticket_id end as positive_rating,
from
(select distinct *,
row_number() over(partition by ticket_id order by ticket_updated_time desc) as rn_updated_at_ticket,
row_number() over(partition by ticket_id, ticket_categorization, status order by ticket_updated_time desc) as rn_resolved_at,


from




(
SELECT  distinct th.id as ticket_id, th.created_at as ticket_created_at,th.stats_resolved_at as ticket_resolved_at,
format_date("%Y-%m", th.created_at) as month_year_created,
format_date("%Y-%m", th.stats_resolved_at) as month_year_resolved,
FORMAT_DATE('%Y-%m-%d', DATE_TRUNC(th.created_at, WEEK(MONDAY))) as year_month_week_created,
FORMAT_DATE('%Y-%m-%d', DATE_TRUNC(th.stats_resolved_at, WEEK(MONDAY))) as year_month_week_resolved,
sl.label_for_agents as status,th.updated_at as ticket_updated_time,
max(th.custom_cf_country) over(partition by th.id) as country_new,
sr.feedback,mm.Name_of_Account_Manager, mm.Account_Name,mm.Chain_Name_in_system,
   sv.value AS satisfaction_rating, th.deleted,
case when so.source is null then "Whatsapp" else so.source end as source_new,
case when  trim(g.name) IN ("Refund Support",
"SG-On-Site Support",
"Supportdesk AU",
"Supportdesk ID",
"Supportdesk MY",
"Supportdesk SG",
"Supportdesk") THEN 'l1'
when trim(g.name) IN ("L2-CMS-Support","L2-Console-Support","L2-CRM-Support",
"L2-Data Analytics-Support","L2-eCMS-Support","L2-Hardware-Support",
"L2-Integration-Support","L2-Payment-Support","L2-SmartConnect-Support",
"L2-SmartKiosk-Support","L2-SmartQ-Support","L2-SmartTab-Support",
"L2-SmartWeb-Support","L2-Support","L3-CMS-Support","L3-Console-Support",
"L3-CRM-Support","L3-Data Analytics-Support","L3-Delivery-Support",
"L3-eCMS-Support","L3-Hardware-Support","L3-Integration-Support",
"L3-Payment-Support","L3-SmartConnect-Support","L3-SmartKiosk-Support",
"L3-SmartQ-Support","L3-SmartTab-Support","L3-SmartWeb-Support",
"L3-Void Order-Support","Supportdesk - L2", "L3-SmartConnect-Support","L3-SmartWeb-Support","L3-Data Analytics-Support","L3-CRM-Support",
"L3-CMS-Support","L3-SmartTerminal-Support","L3-eCMS-Support","L3-iOS App-Support",
"L3-Integration-Support","L3-Payment-Support","L3-DBOps-Support","L3-SmartKiosk-Support",
"L3-SmartQ-Support","L3-Console-Support","L3-Delivery-Support","L2-SmartWeb-Support","L2-Support") THEN 'l3'
when trim(g.name) IN ("Finance Team") then 'Finance Team'
when trim(g.name) IN ("Payment Support") then 'Payment Support'
when trim(g.name) IN ("Implementation/Project Support") then 'Implementation Team'
when trim(g.name) IN ("Merchant Data Support") then 'Menu Team'
else "others"
end as ticket_categorization  ,
from `freshdesk_data_prod.ticket_history` th
left join `freshdesk_data_prod.status_lookup` sl
on th.status = sl.id
left join `freshdesk_data_prod.source_lookup` so
on th.source = so.id
left join `freshdesk_data_prod.group` g
on  th.group_id = g.id
left join `freshdesk_data_prod.priority_lookup` pl
on th.priority = pl.id
left join `freshdesk_data_prod.agent` a
on a.id = th.responder_id
left join `freshdesk_data_prod.company` cm
on th.company_id= cm.id
left join
`tabsquare-data-sciences.tabsquare_dw_lookups.master_merchant_list` mm
on trim(th.custom_cf_merchant_key) = trim(mm.Merchant_id)
LEFT JOIN
`tabsquare-data-sciences.freshdesk_data_prod.satisfaction_rating` sr
ON th.id = sr.ticket_id
LEFT JOIN `tabsquare-data-sciences.freshdesk_data_prod.satisfaction_rating_value` sv
ON sr.id = sv.satisfaction_rating_id




 order by th.id, th.created_at, th.updated_at
)


order by ticket_id, ticket_created_at)  order by 1,2,3,4,5,6) where deleted<<>> True and ticket_created_at>>="2024-01-01" and abcd <<>>"Singapore-Outbound Email-2023-11-Closed"  order by ticket_id]]></relation>
            </properties>
          </object>
          <object caption='Success/Failed' id='_5683CCDA62524C1CB4EB49411A5AC4F5'>
            <properties context=''>
              <relation connection='bigquery.176jz4z1s9dj8n16mqqld0bl6b71' name='Custom SQL Query6' type='text'>SELECT * FROM `tabsquare-data-sciences.data_analysis_team_dev.pos_weekly_monthly_dashboard_agg`</relation>
            </properties>
          </object>
          <object caption='Implementation' id='_5E41E5B5725846A486A1FBB43986A06D'>
            <properties context=''>
              <relation connection='bigquery.176jz4z1s9dj8n16mqqld0bl6b71' name='Custom SQL Query3' type='text'>select * from `tabsquare-data-sciences.data_analysis_team_dev.implementation_week_month_account_dashboard`</relation>
            </properties>
          </object>
          <object caption='GMV' id='_60A5A9BBE44F41FF8FEF2115663F74B1'>
            <properties context=''>
              <relation connection='bigquery.176jz4z1s9dj8n16mqqld0bl6b71' name='Custom SQL Query' type='text'><![CDATA[select country , account_name, Name_of_Account_Manager,merchant_id, Chain_Name_in_system,
format_date("%Y-%m", order_date) as year_month,
concat(extract(year from order_date), "-", extract(month from order_date)) as year_month_1,
FORMAT_DATE('%Y-%m-%d', DATE_TRUNC(order_date, WEEK(MONDAY)))  as year_month_week,
sum(sales) as sales, 
sum(orders) as orders,
sum(paid_gmv) as paid_gmv

 from (select a.*, b.Chain_Name_in_system,b.Account_Name,b.Name_of_Account_Manager,
b.Team, case when ifnull(organization_partner_id,0) in (1) then 'FoodPanda' 
 when ifnull(organization_partner_id,0) in (2) then 'Foodora'
 when ifnull(organization_partner_id,0) in (3) then 'Talabat'
 else 'TabSquare' end as third_party_flag from
(
 select Country,Merchant_id,RestaurantName,order_date,sum(final_gmv) as Sales, sum(total_gmv_orders) as orders ,
sum(total_paid_gmv) as Paid_Gmv, sum(total_paid_orders) as Paid_Orders from 
`tabsquare-data-sciences.datastudio_dashboard_data.new_net_gmv` 
where order_date >>= '2024-01-01' and  order_date <<= current_date('Asia/Singapore')
and merchant_id not like '%HQ-24%'
and merchant_id not like '%HQ-6278%'
group by 1,2,3,4

UNION ALL

SELECT
  Country,Merchant_id,RestaurantName,extract(date from order_date) as order_date, sum(sales) as Sales, sum(Orders) as orders, 0 as Paid_Gmv,
0 as Paid_Orders
FROM
  `tabsquare-data-sciences.tabsquare_dw_lookups.kfc_taco_gmv`
  where extract(date from order_date) >>= '2024-01-01' and  extract(date from order_date) <<= current_date('Asia/Singapore')
Group by 1,2,3,4) a 
left join
`tabsquare-data-sciences.tabsquare_dw_lookups.master_merchant_list_tableau_view` as b
on a.merchant_id = b.merchant_id
left join
`tabsquare-data-sciences.all_skipque_cdc_data_prod.all_organization_view_prod` o
on a.merchant_id = o.merchant_key)  group by 1,2,3,4,5,6,7,8 order by 1,2,3,4,5,6,7,8]]></relation>
            </properties>
