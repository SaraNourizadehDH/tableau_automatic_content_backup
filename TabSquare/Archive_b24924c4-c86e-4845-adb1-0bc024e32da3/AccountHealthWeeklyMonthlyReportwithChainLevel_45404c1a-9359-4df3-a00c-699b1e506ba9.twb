    <worksheet name='No GMV Last 7 Days'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>No GMV Last 7 Days</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Account Name' name='federated.0xgukxt059r9i61ahck5g1kpil21' />
          </datasources>
          <datasource-dependencies datasource='federated.0xgukxt059r9i61ahck5g1kpil21'>
            <column caption='Account_Name ' datatype='string' name='[Account_Name (Custom SQL Query11)]' role='dimension' type='nominal' />
            <column caption='last 7 to today' datatype='date' name='[Calculation_2442639871998611457]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='date(DATEADD(&apos;day&apos;, - 7, TODAY()))' />
            </column>
            <column caption='last to last 7 days to today' datatype='date' name='[Calculation_2442639871998996482]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='date(DATEADD(&apos;day&apos;, - 6, [Calculation_2442639871998611457]))' />
            </column>
            <column caption='immediate previous week last 7 days ' datatype='boolean' name='[Calculation_2442639871999545347]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[order_date (Custom SQL Query11)]&gt;= [Calculation_2442639871998996482] and [order_date (Custom SQL Query11)]&lt;= [Calculation_2442639871998611457]' />
            </column>
            <column caption='No GMV in Immediate previous 7 days' datatype='boolean' name='[Calculation_2442639871999819780]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ FIXED [Merchant_id (Custom SQL Query11)]: SUM(IF [Calculation_2442639871999545347] = True THEN [Sales (Custom SQL Query11)] ELSE 0 END) } = 0' />
            </column>
            <column caption='comment field' datatype='string' name='[Calculation_2442639872000045061]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_2442639871999819780] = False&#13;&#10;and  [Calculation_2442639872000397318]  = True&#13;&#10; then&#13;&#10;&quot;No gmv last 7 days low usage list (to be reported)&quot; END' />
            </column>
            <column caption='new No GMV in Last 7 Days' datatype='boolean' name='[Calculation_2442639872000397318]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ FIXED [Merchant_id (Custom SQL Query11)] : SUM(IF [Calculation_91760909666140173] = True THEN [Sales (Custom SQL Query11)] ELSE 0 END) } = 0' />
            </column>
            <column caption='last 7 days sales' datatype='real' name='[Calculation_2442639872007032840]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull(if [Calculation_91760909666140173]= TRUE then [Sales (Custom SQL Query11)] END,0)' />
            </column>
            <column caption='7 days GMV filter' datatype='boolean' name='[Calculation_91760909666140173]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[order_date (Custom SQL Query11)]&gt;= dateadd(&apos;day&apos;,-7,TODAY()) and [order_date (Custom SQL Query11)]&lt;= TODAY()' />
            </column>
            <column caption='Merchant_id ' datatype='string' name='[Merchant_id (Custom SQL Query11)]' role='dimension' type='nominal' />
            <column datatype='string' name='[Name_of_Account_Manager (Custom SQL Query)]' role='dimension' type='nominal' />
            <column caption='Name_of_Account_Manager ' datatype='string' name='[Name_of_Account_Manager (Custom SQL Query11)]' role='dimension' type='nominal' />
            <column caption='RestaurantName ' datatype='string' name='[RestaurantName (Custom SQL Query11)]' role='dimension' type='nominal' />
            <column datatype='real' name='[Sales (Custom SQL Query11)]' role='measure' type='quantitative' />
            <column datatype='string' name='[account_name (Custom SQL Query) #1]' role='dimension' type='nominal' />
            <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
