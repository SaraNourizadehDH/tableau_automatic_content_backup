          <object caption='NO GMV last 7 days' id='_CEDE805FBF854763A8CBA4D20FF57F7C'>
            <properties context=''>
              <relation connection='bigquery.1kkd9551e2i8sw1axtwhh1crtqpp' name='Custom SQL Query11' type='text'>select a.*, b.Chain_Name_in_system,b.Account_Name,b.Name_of_Account_Manager,
b.Team,b.Sales_Planning_and_Opportunity_Names, o.cms_merchant_key, coalesce(ecms_migration_done,0) as ecms_migration_done, nr.no_gmv_duration, nr.reason_bucket, nr.reason_detail, nr.week_start_date, lu.merchant_id as low_usage_merchant_id, is_churned, b.Partner_TS_FP_Talabat_Foodora as partner_filter
from
(
SELECT
  Order_Id, Merchant_id,  Restaurant_id,  RestaurantName, Customer_id,  order_date, Order_Type, Country,  Product_Type, Payment_Type, data_source,  Sales,  order_date_time,  System, old_merchant_id,  old_restaurant_name,  Paid_Gmv
FROM
  `tabsquare-data-sciences.datastudio_dashboard_data.all_product_firebase_data`

WHERE order_date &gt;&gt;= DATE_SUB(CURRENT_DATE(&apos;Asia/Singapore&apos;), INTERVAL 14 DAY) 

UNION ALL
SELECT
  Order_Id, Merchant_id,  Restaurant_id,  RestaurantName, Customer_id,  order_date, Order_Type, Country,  Product_Type, Payment_Type, data_source,  Sales,  order_date_time,  System, old_merchant_id,  old_restaurant_name,  Paid_Gmv
FROM
  `tabsquare-data-sciences.datastudio_dashboard_data.all_product_skipque_data`

  WHERE order_date &gt;&gt;= DATE_SUB(CURRENT_DATE(&apos;Asia/Singapore&apos;), INTERVAL 14 DAY) 

)a
left join
`tabsquare-data-sciences.tabsquare_dw_lookups.master_merchant_list` b
on a.merchant_id = b.merchant_id
left join `tabsquare-data-sciences.tabsquare_dw_lookups.no_gmv_reason_prod` nr
on a.merchant_id= nr.merchant_id
left join `tabsquare-data-sciences.tabsquare_dw_lookups.low_usage_outlet_list_prod` lu
on a.merchant_id= lu.merchant_id
left join
(select cms_merchant_key, 1 as ecms_migration_done
from
`tabsquare-data-sciences.all_skipque_cdc_data_prod.all_organization_view_prod`
group by 1
)
 o
on a.merchant_id = o.cms_merchant_key
left join
(select merchant_key, is_churned
from
`tabsquare-data-sciences.all_skipque_cdc_data_prod.all_organization_view_prod`
)
org
on a.merchant_id = org.merchant_key</relation>
            </properties>
          </object>
