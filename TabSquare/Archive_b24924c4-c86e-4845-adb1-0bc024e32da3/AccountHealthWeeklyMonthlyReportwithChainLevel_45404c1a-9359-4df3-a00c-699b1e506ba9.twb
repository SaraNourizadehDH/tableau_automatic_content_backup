                <zone forceUpdate='true' h='13875' id='245' type-v2='text' w='35901' x='62999' y='45041'>
                  <formatted-text>
                    <run fontcolor='#000000' fontname='Roboto' fontsize='7'>Freshdesk has group name that are categorized as L1,  L3 and others</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Roboto' fontsize='7'>L1</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Roboto' fontsize='7'>Refund Support,   SG-On-Site Support,   Supportdesk AU,   Supportdesk ID,   Supportdesk MY,   Supportdesk SG, Supportdesk</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Roboto' fontsize='7'>L3 </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Roboto' fontsize='7'>L2-CMS-Support,  L2-Console-Support, L2-CRM-Support, L2-Data Analytics-Support, L2-eCMS-Support, L2-Hardware-Support, L2-Integration-Support, L2-Payment-Support, L2-SmartConnect-Support, L2-SmartKiosk-Support, L2-SmartQ-Support, L2-SmartTab-Support, L2-SmartWeb-Support, L2-Support, L3-CMS-Support, L3-Console-Support, L3-CRM-Support, L3-Data Analytics-Support, L3-Delivery-Support, L3-eCMS-Support, L3-Hardware-Support, L3-Integration-Support, L3-Payment-Support, L3-SmartConnect-Support, L3-SmartKiosk-Support, L3-SmartQ-Support, L3-SmartTab-Support, L3-SmartWeb-Support, L3-Void Order-Support, Supportdesk - L2,&quot;L3-CRM-Support&quot;, </run>
                    <run fontcolor='#000000' fontname='Roboto,Arial' fontsize='7'>&quot;L3-SmartTerminal-Support&quot;,&quot;L3-iOS App-Support&quot;,&quot;L3-DBOps-Support&quot;,&quot;L3-Delivery-Support&quot;,&quot;L2-Support&quot;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Roboto' fontsize='7'>Others</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Roboto' fontsize='7'>Finance, Payment, Implementation, Merchant Data Support</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
