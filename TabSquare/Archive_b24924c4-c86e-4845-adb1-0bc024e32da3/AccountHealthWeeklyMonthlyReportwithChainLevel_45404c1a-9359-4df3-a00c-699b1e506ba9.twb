            <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[New Merchant_ids (copy)_617274686237343751]' derivation='CountD' name='[ctd:New Merchant_ids (copy)_617274686237343751:qk]' pivot='key' type='quantitative' />
