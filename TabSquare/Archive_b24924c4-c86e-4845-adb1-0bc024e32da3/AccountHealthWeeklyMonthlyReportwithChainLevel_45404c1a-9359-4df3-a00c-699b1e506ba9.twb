            <column-instance column='[year_month]' derivation='None' name='[none:year_month:nk]' pivot='key' type='nominal' />
            <column datatype='real' name='[sales (Custom SQL Query4)]' role='measure' type='quantitative' />
            <column datatype='string' name='[year_month]' role='dimension' type='nominal' />
          </datasource-dependencies>
