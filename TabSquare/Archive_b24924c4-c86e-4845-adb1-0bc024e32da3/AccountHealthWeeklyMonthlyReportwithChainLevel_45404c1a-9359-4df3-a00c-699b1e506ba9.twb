      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.01ogsvb1yq9z2h18yzda41i2f3iq].[ctd:Calculation_2408088810321887266:qk]&quot;' value='Low Transacting Outlets' />
          <alias key='&quot;[federated.01ogsvb1yq9z2h18yzda41i2f3iq].[ctd:l1_1:qk]&quot;' value='L1 Ticket Count' />
          <alias key='&quot;[federated.01ogsvb1yq9z2h18yzda41i2f3iq].[ctd:l3_1:qk]&quot;' value='L3 Ticket Count' />
          <alias key='&quot;[federated.01ogsvb1yq9z2h18yzda41i2f3iq].[ctd:Low Buckets (copy 2)_2408088810322026533:qk]&quot;' value='High Transacting Outlets' />
          <alias key='&quot;[federated.01ogsvb1yq9z2h18yzda41i2f3iq].[ctd:Low Buckets (copy) (copy)_2408088810321944612:qk]&quot;' value='Medium Transacting Outlets' />
          <alias key='&quot;[federated.01ogsvb1yq9z2h18yzda41i2f3iq].[ctd:merchant_id:qk]&quot;' value='Merchant Count' />
          <alias key='&quot;[federated.01ogsvb1yq9z2h18yzda41i2f3iq].[sum:orders:qk]&quot;' value='Orders' />
