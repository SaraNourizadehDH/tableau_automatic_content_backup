        <calculation class='tableau' formula='if [Parameters].[Parameter 1]=&quot;Week&quot; then &#10;&#10;if  rn_resolved_at= 1 and ticket_categorization = &quot;l1&quot; and status = &quot;Resolved&quot; and [year_month_week_created]=[year_month_week_resolved] and  source_new &lt;&gt; &quot;Whatsapp&quot; then DATEDIFF( &apos;day&apos;, [ticket_created_at],[ticket_resolved_at]) end&#10;&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Month&quot; then &#10;&#10;if  rn_resolved_at= 1 and ticket_categorization = &quot;l1&quot; and status = &quot;Resolved&quot; and [month_year_created]=[month_year_resolved] and  source_new &lt;&gt; &quot;Whatsapp&quot; then DATEDIFF( &apos;day&apos;, [ticket_created_at],[ticket_resolved_at]) end&#10;END' />
      </column>
      <column caption='l1_ticket' datatype='integer' name='[Calculation_1977221000847962119]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1]=&quot;Week&quot; then &#10;&#10;if  rn_resolved_at= 1 and ticket_categorization = &quot;l1&quot; and status = &quot;Resolved&quot; and [year_month_week_created]=[year_month_week_resolved] and  source_new &lt;&gt; &quot;Whatsapp&quot; then [ticket_id] end&#10;&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Month&quot; then &#10;&#10;if  rn_resolved_at= 1 and ticket_categorization = &quot;l1&quot; and status = &quot;Resolved&quot; and [month_year_created]=[month_year_resolved] and  source_new &lt;&gt; &quot;Whatsapp&quot; then [ticket_id] end&#10;END' />
      </column>
      <column caption='l1_average_resolution_time' datatype='real' name='[Calculation_1977221000848138249]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([l1_reso (copy)_1977221000847867910])/COUNTD([l1_ticket (copy)_1977221000848060424])' />
      </column>
      <column caption='l3_reso' datatype='integer' name='[Calculation_1977221000849784844]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1]=&quot;Week&quot; then &#10;&#10;if  rn_resolved_at= 1 and ticket_categorization = &quot;l3&quot; and status = &quot;Resolved&quot; and  source_new &lt;&gt; &quot;Whatsapp&quot; then DATEDIFF( &apos;day&apos;, [ticket_created_at],[ticket_resolved_at]) end&#10;&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Month&quot; then &#10;&#10;if  rn_resolved_at= 1 and ticket_categorization = &quot;l3&quot; and status = &quot;Resolved&quot; and [month_year_created]=[month_year_resolved] and  source_new &lt;&gt; &quot;Whatsapp&quot; then DATEDIFF( &apos;day&apos;, [ticket_created_at],[ticket_resolved_at]) end&#10;END' />
      </column>
      <column caption='l3_ticket' datatype='integer' name='[Calculation_1977221000850128910]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1]=&quot;Week&quot; then &#10;&#10;if  rn_resolved_at= 1 and ticket_categorization = &quot;l3&quot; and status = &quot;Resolved&quot; and [year_month_week_created]=[year_month_week_resolved] and  source_new &lt;&gt; &quot;Whatsapp&quot; then [ticket_id] end&#10;&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Month&quot; then &#10;&#10;if  rn_resolved_at= 1 and ticket_categorization = &quot;l3&quot; and status = &quot;Resolved&quot; and [month_year_created]=[month_year_resolved] and  source_new &lt;&gt; &quot;Whatsapp&quot; then [ticket_id] end&#10;END' />
      </column>
      <column caption='l3_ticket_new' datatype='integer' name='[Calculation_1977221000850194447]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if not ISNULL([Calculation_1977221000849784844]) then [Calculation_1977221000850128910] END' />
      </column>
      <column caption='l3_average_resolution_time' datatype='real' name='[Calculation_1977221000850264080]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([l3_reso (copy)_1977221000849907725])/COUNTD([Calculation_1977221000850194447])' />
      </column>
      <column caption='finance_reso' datatype='integer' name='[Calculation_1977221000850935825]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1]=&quot;Week&quot; then &#10;&#10;if  rn_resolved_at= 1 and ticket_categorization = &quot;Finance Team&quot; and status = &quot;Resolved&quot; and [year_month_week_created]=[year_month_week_resolved] and  source_new &lt;&gt; &quot;Whatsapp&quot; then DATEDIFF( &apos;day&apos;, [ticket_created_at],[ticket_resolved_at]) end&#10;&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Month&quot; then &#10;&#10;if  rn_resolved_at= 1 and ticket_categorization = &quot;Finance Team&quot; and status = &quot;Resolved&quot; and [month_year_created]=[month_year_resolved] and  source_new &lt;&gt; &quot;Whatsapp&quot; then DATEDIFF( &apos;day&apos;, [ticket_created_at],[ticket_resolved_at]) end&#10;END' />
      </column>
      <column caption='finance_ticket' datatype='integer' name='[Calculation_1977221000851226645]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1]=&quot;Week&quot; then &#10;&#10;if  rn_resolved_at= 1 and ticket_categorization = &quot;Finance Team&quot; and status = &quot;Resolved&quot; and [year_month_week_created]=[year_month_week_resolved] and  source_new &lt;&gt; &quot;Whatsapp&quot; then [ticket_id] end&#10;&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Month&quot; then &#10;&#10;if  rn_resolved_at= 1 and ticket_categorization = &quot;Finance Team&quot; and status = &quot;Resolved&quot; and [month_year_created]=[month_year_resolved] and  source_new &lt;&gt; &quot;Whatsapp&quot; then [ticket_id] end&#10;END' />
      </column>
      <column caption='finance_ticket_new' datatype='integer' name='[Calculation_1977221000851288086]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if not ISNULL([Calculation_1977221000850935825]) then [Calculation_1977221000851226645] END' />
      </column>
      <column caption='payment_support_ticket' datatype='integer' name='[Calculation_1977221000853901345]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1]=&quot;Week&quot; then &#10;&#10;if  rn_resolved_at= 1 and ticket_categorization = &quot;Payment Support&quot; and status = &quot;Resolved&quot; and [year_month_week_created]=[year_month_week_resolved] and  source_new &lt;&gt; &quot;Whatsapp&quot; then [ticket_id] end&#10;&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Month&quot; then &#10;&#10;if  rn_resolved_at= 1 and ticket_categorization = &quot;Payment Support&quot; and status = &quot;Resolved&quot; and [month_year_created]=[month_year_resolved] and  source_new &lt;&gt; &quot;Whatsapp&quot; then [ticket_id] end&#10;END' />
      </column>
      <column caption='others_reso' datatype='integer' name='[Calculation_1977221000854155300]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1]=&quot;Week&quot; then &#10;&#10;if  rn_resolved_at= 1 and ticket_categorization = &quot;others&quot; and status = &quot;Resolved&quot; and [year_month_week_created]=[year_month_week_resolved] and  source_new &lt;&gt; &quot;Whatsapp&quot; then DATEDIFF( &apos;day&apos;, [ticket_created_at],[ticket_resolved_at]) end&#10;&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Month&quot; then &#10;&#10;if  rn_resolved_at= 1 and ticket_categorization = &quot;others&quot; and status = &quot;Resolved&quot; and [month_year_created]=[month_year_resolved] and  source_new &lt;&gt; &quot;Whatsapp&quot; then DATEDIFF( &apos;day&apos;, [ticket_created_at],[ticket_resolved_at]) end&#10;END' />
      </column>
      <column caption='others_reso_new' datatype='integer' name='[Calculation_1977221000854208549]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if not ISNULL([Calculation_1977221000854155300]) then [Calculation_1977221000854155300] END' />
      </column>
      <column caption='others_ticket' datatype='integer' name='[Calculation_1977221000854265894]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1]=&quot;Week&quot; then &#10;&#10;if  rn_resolved_at= 1 and ticket_categorization = &quot;others&quot; and status = &quot;Resolved&quot; and [year_month_week_created]=[year_month_week_resolved] and  source_new &lt;&gt; &quot;Whatsapp&quot; then [ticket_id] end&#10;&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Month&quot; then &#10;&#10;if  rn_resolved_at= 1 and ticket_categorization = &quot;others&quot; and status = &quot;Resolved&quot; and [month_year_created]=[month_year_resolved] and  source_new &lt;&gt; &quot;Whatsapp&quot; then [ticket_id] end&#10;END' />
      </column>
      <column caption='Calculation1' datatype='boolean' name='[Calculation_1977221000854315047]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='not ISNULL([Calculation_1977221000847626245])' />
      </column>
      <column caption='others_ticket_new' datatype='integer' name='[Calculation_1977221000854364200]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if not ISNULL([Calculation_1977221000854155300]) then [Calculation_1977221000854265894] END' />
      </column>
      <column caption='others_overall_ticket' datatype='integer' name='[Calculation_1977221000854507561]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(COUNTD([Calculation_1977221000851288086]),0)+IFNULL(COUNTD([finance_ticket_new (copy)_1977221000852230170]),0)+IFNULL(COUNTD([implementation_ticket_new (copy)_1977221000852975646]),0)+IFNULL(COUNTD([payment_support_ticket (copy)_1977221000854065187]),0)+IFNULL(COUNTD([Calculation_1977221000854364200]),0)' />
      </column>
      <column caption='others_overall_sum_reso' datatype='integer' name='[Calculation_1977221000854577194]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(SUM([finance_reso (copy)_1977221000851120147]),0)+IFNULL(SUM([finance_reso_new (copy)_1977221000852217880]),0)+IFNULL(SUM([implementation_reso_new (copy)_1977221000852959260]),0)+IFNULL(SUM([payment_support_reso (copy)_1977221000853815328]),0)+IFNULL(SUM([Calculation_1977221000854208549]),0)' />
      </column>
      <column caption='others_average_resolution_time' datatype='real' name='[Calculation_1977221000854650923]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1977221000854577194]/[Calculation_1977221000854507561]' />
      </column>
      <column caption='last 7 to today' datatype='date' name='[Calculation_2442639871998611457]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='date(DATEADD(&apos;day&apos;, - 7, TODAY()))' />
      </column>
      <column caption='last to last 7 days to today' datatype='date' name='[Calculation_2442639871998996482]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='date(DATEADD(&apos;day&apos;, - 6, [Calculation_2442639871998611457]))' />
      </column>
      <column caption='immediate previous week last 7 days ' datatype='boolean' name='[Calculation_2442639871999545347]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[order_date (Custom SQL Query11)]&gt;= [Calculation_2442639871998996482] and [order_date (Custom SQL Query11)]&lt;= [Calculation_2442639871998611457]' />
      </column>
      <column caption='No GMV in Immediate previous 7 days' datatype='boolean' name='[Calculation_2442639871999819780]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [Merchant_id (Custom SQL Query11)]: SUM(IF [Calculation_2442639871999545347] = True THEN [Sales (Custom SQL Query11)] ELSE 0 END) } = 0' />
      </column>
      <column caption='comment field' datatype='string' name='[Calculation_2442639872000045061]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_2442639871999819780] = False&#13;&#10;and  [Calculation_2442639872000397318]  = True&#13;&#10; then&#13;&#10;&quot;No gmv last 7 days low usage list (to be reported)&quot; END' />
      </column>
      <column caption='new No GMV in Last 7 Days' datatype='boolean' name='[Calculation_2442639872000397318]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [Merchant_id (Custom SQL Query11)] : SUM(IF [Calculation_91760909666140173] = True THEN [Sales (Custom SQL Query11)] ELSE 0 END) } = 0' />
      </column>
      <column caption='new 7 days GMV filter' datatype='boolean' name='[Calculation_2442639872000786439]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[order_date (Custom SQL Query11)]&lt;= TODAY()' />
      </column>
      <column caption='last 7 days sales' datatype='real' name='[Calculation_2442639872007032840]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ifnull(if [Calculation_91760909666140173]= TRUE then [Sales (Custom SQL Query11)] END,0)' />
      </column>
      <column caption='GMV in local' datatype='real' name='[Calculation_246361031159136256]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case  [country] when &quot;Australia&quot;  then [sales]/0.9004687&#10;when &quot;Singapore&quot; then [sales]&#10;when &quot;Malaysia&quot; then [sales]/0.30175252&#10;when &quot;Indonesia&quot; then [sales]/0.000089&#10;else [sales]&#10;END' />
      </column>
      <column caption='Paid_Gmv in local' datatype='real' name='[Calculation_246361031160545281]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case  [country] when &quot;Australia&quot;  then [paid_gmv]/0.9004687&#10;when &quot;Singapore&quot; then [paid_gmv]&#10;when &quot;Malaysia&quot; then [paid_gmv]/0.30175252&#10;when &quot;Indonesia&quot; then [paid_gmv]/0.000089&#10;else [paid_gmv]&#10;END' />
      </column>
      <column caption='Calculation2' datatype='boolean' name='[Calculation_2635872446526660609]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[month_year_created]=[month_year]' />
      </column>
      <column caption='abv' datatype='real' name='[Calculation_2635872446706798599]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_246361031159136256])/SUM([orders])' />
      </column>
      <column caption='GMV/Outlet' datatype='real' name='[Calculation_2635872446706921480]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sales])/COUNTD([merchant_id (Custom SQL Query)])' />
      </column>
      <column caption='Paid GMV' datatype='real' name='[Calculation_2635872446707298314]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if  CONTAINS(lower([payment_type]),&apos;razer&apos;) OR&#10;CONTAINS(lower([payment_type]),&apos;stripe&apos;) OR&#10;CONTAINS(lower([payment_type]),&apos;rapyd&apos;) OR&#10;CONTAINS(lower([payment_type]),&apos;checkout&apos;) OR&#10;CONTAINS(lower([payment_type]),&apos;g_pay&apos;)&#10;THEN [sales] END )' />
      </column>
      <column caption='Calculation3' datatype='boolean' name='[Calculation_2635872446722297867]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[country]=[country_new]' />
      </column>
      <column caption='win_rate' datatype='integer' name='[Calculation_2635872446734131212]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [name (group)]= &quot;proposal made &amp; targeting closure&quot; and [status]=&quot;won&quot; then id end' />
      </column>
      <column caption='Total Deducted Cost' datatype='real' name='[Calculation_401101891435012096]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ifnull(SUM([cost_of_hardware_acc]),0)+&#13;&#10;ifnull(SUM([other_costs_acc]),0)+&#13;&#10;ifnull(SUM([resellers_costs_acc]),0)&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;///[cost_of_hardware]+[cost_of_setup]+[other_costs]+[resellers_costs]+[tcc_oat_fee]+[total_stripe_cost]///' />
      </column>
      <column caption='Total Rev' datatype='real' name='[Calculation_401101891435864066]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//sum([Recurring SaaS Fee])+[Total Payment Gateway Revenue New]+sum([one_time_revenue_acc])+sum([cos_tcc_oat_fee_refund_acc])+sum([total_stripe_cost_acc])&#13;&#10;&#13;&#10;&#13;&#10;//SUM([Total revenue]) + sum([cos_tcc_oat_fee_refund_acc])&#10;&#10;ifnull(sum([recurring_revenue_acc]),0)&#10;+ifnull([Total Payment Gateway Revenue(minus cost) (copy)_5936096161049804800],0)&#10;+ifnull(sum([one_time_revenue_acc]),0)&#10;+ifnull(sum([deferred_revenue_acc]),0)' />
      </column>
      <column caption='Net Revenue' datatype='real' name='[Calculation_401101891437056003]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ifnull(sum([Calculation_5097230416282984451]),0)+ifnull(([Calculation_401101891435012096]),0)&#13;&#10;//sum([Recurring SaaS Fee]) +sum([one_time_revenue_acc])+  ([Total Deducted Cost]) + [Total Payment Gateway Revenue New]' />
      </column>
      <column caption='Month' datatype='string' name='[Calculation_4311915232969408512]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
      </column>
      <column caption='Stripe cost' datatype='real' name='[Calculation_46443398551068674]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE  [Country (Custom SQL Query5) #1] when &apos;Australia&apos; THEN 0.013*stripe_revenue_und_15_acc + 0.05*stripe_orders_und_15_acc + 0.01*(stripe_revenue_acc - stripe_revenue_und_15_acc) + 0.10*(stripe_orders_acc-stripe_orders_und_15_acc)&#10;     WHEN  &apos;Singapore&apos; THEN 0.018*stripe_revenue_und_15_acc + 0.07*stripe_orders_und_15_acc + 0.017*(stripe_revenue_acc - stripe_revenue_und_15_acc) + 0.07*(stripe_orders_acc-stripe_orders_und_15_acc)&#10;     WHEN  &apos;Malaysia&apos; THEN (0.015*stripe_revenue_acc + 0.10*0.33 *stripe_orders_acc)&#10;     ELSE 0 &#10;&#10;END' />
      </column>
      <column caption='Revenue-Stripe' datatype='real' name='[Calculation_46443398551851011]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([converted_revenue_acc])-Sum([Calculation_46443398551068674])' />
      </column>
      <column caption='Recurring_revenue' datatype='real' name='[Calculation_46443398553153540]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(recurring_revenue_acc)' />
      </column>
      <column caption='transaction_cash_revenu' datatype='real' name='[Calculation_46443398556901382]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[transaction_cash_revenue_acc]' />
      </column>
      <column caption='Calculation4' datatype='integer' name='[Calculation_46443398581121034]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [month_year]= [month_date_day] and [month_year]=[month_date_stage] then [won_deals] END' />
      </column>
      <column caption='Recurring SaaS Fee' datatype='real' name='[Calculation_5097230416280944642]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//[Other_Recurring_SaaS_Fee_acc]+[recurring_smarttab_revenue_acc]+[recurring_smartkiosk_revenue_acc]+[recurring_smartconnect_revenue_acc]+[recurring_smartweb_revenue_acc]+[recurring_smartapp_revenue_acc]+[recurring_ai_revenue_acc]+[recurring_others_revenue_acc]+[recurring_terminal_revenue_acc]+[recurring_menumanagement_revenue_acc]&#10;&#10;&#10;&#10;ifnull(sum([recurring_revenue_acc]),0)+ifnull(sum([deferred_revenue_acc]),0)' />
      </column>
      <column caption='Total revenue' datatype='real' name='[Calculation_5097230416282984451]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[transaction_stripe_revenue_acc]+ [transaction_cash_revenue_acc]+&#13;&#10;[recurring_smarttab_revenue_acc]+ [recurring_smartkiosk_revenue_acc]+&#13;&#10;[recurring_smartconnect_revenue_acc]+ [recurring_ai_revenue_acc]+&#13;&#10;[recurring_smartapp_revenue_acc]+[recurring_terminal_revenue_acc]+&#13;&#10;[recurring_smartweb_revenue_acc]+[recurring_pos_revenue_acc]+&#13;&#10;[recurring_fee_adyen_acc]+[recurring_menumanagement_revenue_acc]+&#13;&#10;[transaction_fee_razerpay_acc]+[recurring_support_revenue_acc]+&#13;&#10;[recurring_others_revenue_acc]+[one_time_revenue_acc]' />
      </column>
      <column caption='Time interval' datatype='string' name='[Calculation_5230931027982954496]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[year_month]' />
      </column>
      <column caption='date_diff' datatype='integer' name='[Calculation_5230931027999526914]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1]=&quot;Month&quot; then [date_diff_month]&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Week&quot; then [date_diff_week] END' />
      </column>
      <column caption='Month/week-FD' datatype='string' name='[Calculation_5482991869669892097]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1]=&quot;Month&quot; then [month_year_created] &#10;ELSEIF [Parameters].[Parameter 1]=&quot;Month&quot; then [month_year_resolved] &#10;ELSEIF [Parameters].[Parameter 1]=&quot;Week&quot; then [year_month_week_created]&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Week&quot; then [year_month_week_resolved] &#10;END' />
      </column>
      <column caption='New SGD -AP' datatype='real' name='[Calculation_5482991869682888706]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1]=&quot;Month&quot; then [new_sgd (Custom SQL Query4)] END' />
      </column>
      <column caption='AR-SGD' datatype='real' name='[Calculation_5482991869683625987]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1]= &quot;Month&quot; then [new_sgd] end' />
      </column>
      <column caption='L1_1' datatype='integer' name='[Calculation_5482991869711933444]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_5230931027982954496]= [Calculation_5482991869669892097] then [l1_1] end' />
      </column>
      <column caption='New Merchant_ids' datatype='string' name='[Calculation_5482991869729075210]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1]=&quot;Month&quot; then [merchant_id] &#10;END' />
      </column>
      <column caption='Calculation6' datatype='boolean' name='[Calculation_5997457758658633729]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[month_date]= [year_month]' />
      </column>
      <column caption='Change wrt to Last week' datatype='real' name='[Calculation_617274686228987905]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([sales (Custom SQL Query5)]-[last_1_month_gmv (Custom SQL Query5)])/[last_1_month_gmv (Custom SQL Query5)]' />
      </column>
      <column aggregation='Sum' caption='Sheet Selector- month' datatype='integer' name='[Calculation_617274686238822408]' role='dimension' type='ordinal'>
