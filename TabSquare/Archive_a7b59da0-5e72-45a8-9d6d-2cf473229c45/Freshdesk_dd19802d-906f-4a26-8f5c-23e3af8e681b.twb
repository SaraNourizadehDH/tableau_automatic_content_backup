            <column caption='ticket_id after filter O' datatype='integer' name='[ticket_id after filter l3 (copy)_2497738586679640081]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if [l3 filter (copy)_2497738586679549968]= True and [rn_resolved_at]= 1 and [Calculation_434878855830249484]= True and TRIM([label_for_agents])= &apos;Resolved&apos; then [ticket_id] END' />
            </column>
