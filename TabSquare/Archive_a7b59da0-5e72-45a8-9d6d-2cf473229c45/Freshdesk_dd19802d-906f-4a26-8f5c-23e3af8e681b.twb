      <column caption='Time difference' datatype='integer' name='[Calculation_2497738586729676832]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [ticket_id], [ticket_categorization] : DATEDIFF([Parameters].[Parameter 1], MAX([ticket_created_at]), MAX([ticket_resolved_at]))}' />
