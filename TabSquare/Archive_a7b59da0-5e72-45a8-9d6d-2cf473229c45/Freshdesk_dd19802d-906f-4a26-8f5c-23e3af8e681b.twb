  <worksheets>
    <worksheet name=' Group ticket res '>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>Group View</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (freshdesk_data_prod)' name='federated.0p6du6d0dmph0s13v3bz70d4d9mi' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Day' caption='Time period' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;day&quot;'>
              <calculation class='tableau' formula='&quot;day&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Day' />
                <alias key='&quot;hour&quot;' value='Hour' />
                <alias key='&quot;minute&quot;' value='Minute' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0p6du6d0dmph0s13v3bz70d4d9mi'>
            <column datatype='string' name='[Account_Name]' role='dimension' type='nominal' />
            <column caption='O time difference' datatype='integer' name='[Calculation_2497738586675929096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [ticket_id]: DATEDIFF([Parameters].[Parameter 1], max([l1 : created max (copy)_2497738586672353283]), max([Calculation_3021915367371358208]))}' />
            </column>
            <column caption='no whatsapp' datatype='boolean' name='[Calculation_2497738586685190168]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[source_new]&lt;&gt; &quot;Whatsapp&quot;' />
            </column>
            <column caption='O Max Resolved At' datatype='datetime' name='[Calculation_3021915367371358208]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [ticket_id], [ticket_categorization (group)], [label_for_agents]: MAX(if [rn_resolved_at]= 1 and [label_for_agents]=  &apos;Resolved&apos; then [ticket_resolved_at]end )}' />
            </column>
            <column caption='Resolved Dates' datatype='boolean' name='[Calculation_434878855830249484]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='month([ticket_created_at])= month([ticket_resolved_at]) and YEAR([ticket_created_at])= YEAR([ticket_resolved_at])' />
            </column>
            <column datatype='string' name='[agent_name]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country_new]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[group_name]' role='dimension' type='nominal' />
            <column caption='O : created max' datatype='date' name='[l1 : created max (copy)_2497738586672353283]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [ticket_id]: MAX([ticket_created_at])}' />
            </column>
            <column caption='O average resolution time' datatype='real' name='[l1 average resolution time (copy)_2497738586681249814]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([time difference l3- after filter (copy)_2497738586679689234])/ COUNTD([ticket_id after filter l3 (copy)_2497738586679640081])' />
            </column>
            <column caption='O filter' datatype='boolean' name='[l3 filter (copy)_2497738586679549968]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='not ISNULL([Calculation_2497738586675929096])' />
            </column>
            <column caption='Status' datatype='string' name='[label_for_agents]' role='dimension' type='nominal' />
            <column datatype='string' name='[merchant_id]' role='dimension' type='nominal' />
            <column-instance column='[ticket_created_at]' derivation='MY' name='[my:ticket_created_at:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Account_Name]' derivation='None' name='[none:Account_Name:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2497738586685190168]' derivation='None' name='[none:Calculation_2497738586685190168:nk]' pivot='key' type='nominal' />
            <column-instance column='[agent_name]' derivation='None' name='[none:agent_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_new]' derivation='None' name='[none:country_new:nk]' pivot='key' type='nominal' />
            <column-instance column='[group_name]' derivation='None' name='[none:group_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[merchant_id]' derivation='None' name='[none:merchant_id:nk]' pivot='key' type='nominal' />
            <column datatype='string' name='[priority_status]' role='dimension' type='nominal' />
            <column caption='Product Categorization' datatype='string' name='[product_categorization]' role='dimension' type='nominal' />
            <column datatype='integer' name='[rn_resolved_at]' role='measure' type='quantitative' />
            <column datatype='string' name='[source_new]' role='dimension' type='nominal' />
            <column datatype='string' name='[ticket_categorization (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[ticket_categorization]' new-bin='true'>
                <bin default-name='false' value='&quot;Others &quot;'>
                  <value>&quot;Finance Team&quot;</value>
                  <value>&quot;Implementation Team&quot;</value>
                  <value>&quot;Menu Team&quot;</value>
                  <value>&quot;others&quot;</value>
                  <value>&quot;Payment Support&quot;</value>
                </bin>
              </calculation>
            </column>
            <column datatype='string' name='[ticket_categorization]' role='dimension' type='nominal' />
            <column datatype='date' datatype-customized='true' name='[ticket_created_at]' role='dimension' type='ordinal' />
            <column caption='ticket_id after filter O' datatype='integer' name='[ticket_id after filter l3 (copy)_2497738586679640081]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if [l3 filter (copy)_2497738586679549968]= True and [rn_resolved_at]= 1 and [Calculation_434878855830249484]= True and TRIM([label_for_agents])= &apos;Resolved&apos; then [ticket_id] END' />
            </column>
            <column aggregation='Sum' datatype='integer' name='[ticket_id]' role='dimension' type='ordinal' />
            <column datatype='datetime' name='[ticket_resolved_at]' role='dimension' type='ordinal' />
            <column caption='time difference O- after filter' datatype='integer' name='[time difference l3- after filter (copy)_2497738586679689234]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [l3 filter (copy)_2497738586679549968]= True and [rn_resolved_at]= 1 and [Calculation_434878855830249484]= True and TRIM([label_for_agents])= &apos;Resolved&apos; then [Calculation_2497738586675929096] END' />
            </column>
            <column-instance column='[l1 average resolution time (copy)_2497738586681249814]' derivation='User' name='[usr:l1 average resolution time (copy)_2497738586681249814:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0p6du6d0dmph0s13v3bz70d4d9mi].[Action (priority_status,ticket_categorization (group))]'>
            <groupfilter function='crossjoin' user:ui-action-filter='[Action4_D649247F772F42C6B9EDF0A624C75560]' user:ui-enumeration='all' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[priority_status]' />
              <groupfilter function='level-members' level='[ticket_categorization (group)]' />
            </groupfilter>
          </filter>
          <filter class='categorical' column='[federated.0p6du6d0dmph0s13v3bz70d4d9mi].[Action (product_categorization,ticket_categorization (group))]'>
            <groupfilter function='crossjoin' user:ui-action-filter='[Action6_8FB79E6CED6B46AB9A13023FA29A6820]' user:ui-enumeration='all' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[product_categorization]' />
              <groupfilter function='level-members' level='[ticket_categorization (group)]' />
            </groupfilter>
          </filter>
          <filter class='categorical' column='[federated.0p6du6d0dmph0s13v3bz70d4d9mi].[Action (source_new,ticket_categorization (group))]'>
            <groupfilter function='crossjoin' user:ui-action-filter='[Action8_BC2AC4A2E9D04A9BB5C4ED46C05BA662]' user:ui-enumeration='all' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[source_new]' />
              <groupfilter function='level-members' level='[ticket_categorization (group)]' />
            </groupfilter>
          </filter>
          <filter class='categorical' column='[federated.0p6du6d0dmph0s13v3bz70d4d9mi].[Action (ticket_categorization (group))]'>
            <groupfilter function='level-members' level='[ticket_categorization (group)]' user:ui-action-filter='[Action2_E68AB899676E4270A18C40961E3488F2]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.0p6du6d0dmph0s13v3bz70d4d9mi].[my:ticket_created_at:ok]' filter-group='5'>
            <groupfilter function='member' level='[my:ticket_created_at:ok]' member='202503' />
            <preset type='last-values' />
          </filter>
          <filter class='categorical' column='[federated.0p6du6d0dmph0s13v3bz70d4d9mi].[none:Calculation_2497738586685190168:nk]' filter-group='3'>
            <groupfilter function='member' level='[none:Calculation_2497738586685190168:nk]' member='true' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <shelf-sorts>
            <shelf-sort-v2 dimension-to-sort='[federated.0p6du6d0dmph0s13v3bz70d4d9mi].[none:group_name:nk]' direction='DESC' is-on-innermost-dimension='true' measure-to-sort-by='[federated.0p6du6d0dmph0s13v3bz70d4d9mi].[usr:l1 average resolution time (copy)_2497738586681249814:qk]' shelf='rows' />
          </shelf-sorts>
          <slices>
            <column>[federated.0p6du6d0dmph0s13v3bz70d4d9mi].[none:country_new:nk]</column>
            <column>[federated.0p6du6d0dmph0s13v3bz70d4d9mi].[none:agent_name:nk]</column>
            <column>[federated.0p6du6d0dmph0s13v3bz70d4d9mi].[none:Account_Name:nk]</column>
            <column>[federated.0p6du6d0dmph0s13v3bz70d4d9mi].[none:merchant_id:nk]</column>
            <column>[federated.0p6du6d0dmph0s13v3bz70d4d9mi].[none:Calculation_2497738586685190168:nk]</column>
            <column>[federated.0p6du6d0dmph0s13v3bz70d4d9mi].[my:ticket_created_at:ok]</column>
            <column>[federated.0p6du6d0dmph0s13v3bz70d4d9mi].[Action (ticket_categorization (group))]</column>
            <column>[federated.0p6du6d0dmph0s13v3bz70d4d9mi].[Action (priority_status,ticket_categorization (group))]</column>
            <column>[federated.0p6du6d0dmph0s13v3bz70d4d9mi].[Action (product_categorization,ticket_categorization (group))]</column>
            <column>[federated.0p6du6d0dmph0s13v3bz70d4d9mi].[Action (source_new,ticket_categorization (group))]</column>
          </slices>
          <aggregation value='true' />
