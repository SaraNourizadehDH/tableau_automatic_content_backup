    <worksheet name='Ac wise- tickets '>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>Account View</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (freshdesk_data_prod)' name='federated.0p6du6d0dmph0s13v3bz70d4d9mi' />
          </datasources>
          <datasource-dependencies datasource='federated.0p6du6d0dmph0s13v3bz70d4d9mi'>
            <column datatype='string' name='[Account_Name]' role='dimension' type='nominal' />
            <column caption='NEW Ticket Count' datatype='integer' name='[Calculation_434878855825072139]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(if [rn_updated_at_ticket]= 1 then [ticket_id] END)' />
            </column>
            <column caption='Resolved Dates' datatype='boolean' name='[Calculation_434878855830249484]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='month([ticket_created_at])= month([ticket_resolved_at]) and YEAR([ticket_created_at])= YEAR([ticket_resolved_at])' />
            </column>
            <column caption='NEW resolved ticket count' datatype='integer' name='[Calculation_434878856044965901]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(if [Calculation_434878855830249484]= True and [rn_updated_at_ticket]= 1 then [ticket_id] END)' />
            </column>
            <column caption='Resolution Rate' datatype='real' name='[Calculation_434878856057266190]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_434878856044965901]/[Calculation_434878855825072139]' />
            </column>
            <column datatype='string' name='[Status (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[label_for_agents]' new-bin='true'>
                <bin default-name='true' value='&quot;Closed&quot;'>
                  <value>&quot;Closed&quot;</value>
                </bin>
                <bin default-name='true' value='&quot;Open&quot;'>
                  <value>&quot;Open&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Pending/ escalated/ monitoring&quot;'>
                  <value>&quot;Escalated to Tech&quot;</value>
                  <value>&quot;Monitoring&quot;</value>
                  <value>&quot;Pending&quot;</value>
                  <value>&quot;Pending Info - Jira&quot;</value>
                  <value>&quot;Pending Support Team&quot;</value>
                </bin>
                <bin default-name='true' value='&quot;Resolved&quot;'>
                  <value>&quot;Resolved&quot;</value>
                </bin>
              </calculation>
            </column>
            <column datatype='string' name='[agent_name]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country_new]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='boolean' name='[deleted]' role='dimension' type='nominal' />
            <column caption='Status' datatype='string' name='[label_for_agents]' role='dimension' type='nominal' />
            <column datatype='string' name='[merchant_id]' role='dimension' type='nominal' />
            <column-instance column='[ticket_created_at]' derivation='MY' name='[my:ticket_created_at:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Account_Name]' derivation='None' name='[none:Account_Name:nk]' pivot='key' type='nominal' />
            <column-instance column='[agent_name]' derivation='None' name='[none:agent_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_new]' derivation='None' name='[none:country_new:nk]' pivot='key' type='nominal' />
            <column-instance column='[deleted]' derivation='None' name='[none:deleted:nk]' pivot='key' type='nominal' />
            <column-instance column='[merchant_id]' derivation='None' name='[none:merchant_id:nk]' pivot='key' type='nominal' />
            <column datatype='string' name='[priority_status]' role='dimension' type='nominal' />
            <column datatype='integer' name='[rn_updated_at_ticket]' role='measure' type='quantitative' />
            <column caption='Scope Categorization' datatype='string' name='[scope_categorization]' role='dimension' type='nominal' />
