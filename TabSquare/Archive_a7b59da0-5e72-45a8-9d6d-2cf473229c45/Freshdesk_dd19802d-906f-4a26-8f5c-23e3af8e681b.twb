    <worksheet name='Detailed View res'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>Detailed View </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (freshdesk_data_prod)' name='federated.0p6du6d0dmph0s13v3bz70d4d9mi' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Day' caption='Time period' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;day&quot;'>
              <calculation class='tableau' formula='&quot;day&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Day' />
                <alias key='&quot;hour&quot;' value='Hour' />
                <alias key='&quot;minute&quot;' value='Minute' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0p6du6d0dmph0s13v3bz70d4d9mi'>
            <column datatype='string' name='[Account_Name]' role='dimension' type='nominal' />
            <column caption='O time difference' datatype='integer' name='[Calculation_2497738586675929096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [ticket_id]: DATEDIFF([Parameters].[Parameter 1], max([l1 : created max (copy)_2497738586672353283]), max([Calculation_3021915367371358208]))}' />
            </column>
            <column caption='no whatsapp' datatype='boolean' name='[Calculation_2497738586685190168]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[source_new]&lt;&gt; &quot;Whatsapp&quot;' />
            </column>
            <column caption='resolved or closed' datatype='boolean' name='[Calculation_2497738586738143265]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[label_for_agents]=&quot;Resolved&quot; or [label_for_agents]=&quot;Closed&quot;' />
            </column>
            <column caption='O Max Resolved At' datatype='datetime' name='[Calculation_3021915367371358208]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [ticket_id], [ticket_categorization (group)], [label_for_agents]: MAX(if [rn_resolved_at]= 1 and [label_for_agents]=  &apos;Resolved&apos; then [ticket_resolved_at]end )}' />
            </column>
            <column caption='Resolved Dates' datatype='boolean' name='[Calculation_434878855830249484]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='month([ticket_created_at])= month([ticket_resolved_at]) and YEAR([ticket_created_at])= YEAR([ticket_resolved_at])' />
            </column>
            <column datatype='string' name='[agent_name]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country_new]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='O : created max' datatype='date' name='[l1 : created max (copy)_2497738586672353283]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [ticket_id]: MAX([ticket_created_at])}' />
            </column>
            <column caption='O average resolution time' datatype='real' name='[l1 average resolution time (copy)_2497738586681249814]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([time difference l3- after filter (copy)_2497738586679689234])/ COUNTD([ticket_id after filter l3 (copy)_2497738586679640081])' />
            </column>
            <column caption='O filter' datatype='boolean' name='[l3 filter (copy)_2497738586679549968]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='not ISNULL([Calculation_2497738586675929096])' />
            </column>
            <column caption='Status' datatype='string' name='[label_for_agents]' role='dimension' type='nominal' />
            <column-instance column='[ticket_created_at]' derivation='Max' name='[max:ticket_created_at:ok]' pivot='key' type='ordinal' />
            <column-instance column='[ticket_resolved_at]' derivation='Max' name='[max:ticket_resolved_at:ok]' pivot='key' type='ordinal' />
            <column datatype='string' name='[merchant_id]' role='dimension' type='nominal' />
            <column-instance column='[ticket_created_at]' derivation='MY' name='[my:ticket_created_at:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Account_Name]' derivation='None' name='[none:Account_Name:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2497738586685190168]' derivation='None' name='[none:Calculation_2497738586685190168:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2497738586738143265]' derivation='None' name='[none:Calculation_2497738586738143265:nk]' pivot='key' type='nominal' />
            <column-instance column='[agent_name]' derivation='None' name='[none:agent_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_new]' derivation='None' name='[none:country_new:nk]' pivot='key' type='nominal' />
            <column-instance column='[label_for_agents]' derivation='None' name='[none:label_for_agents:nk]' pivot='key' type='nominal' />
            <column-instance column='[merchant_id]' derivation='None' name='[none:merchant_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[ticket_categorization]' derivation='None' name='[none:ticket_categorization:nk]' pivot='key' type='nominal' />
            <column-instance column='[ticket_id]' derivation='None' name='[none:ticket_id:ok]' pivot='key' type='ordinal' />
            <column datatype='string' name='[priority_status]' role='dimension' type='nominal' />
            <column caption='Product Categorization' datatype='string' name='[product_categorization]' role='dimension' type='nominal' />
            <column datatype='integer' name='[rn_resolved_at]' role='measure' type='quantitative' />
