      <column aggregation='Sum' caption='counts' datatype='integer' name='[Calculation_2497738586705887259]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if [ticket_categorization (group)]= &quot;l1&quot; then [ticket_id after filter l3 (copy)_2497738586679824404]&#10;ELSEIF [ticket_categorization (group)]= &quot;l3&quot;    then [Calculation_2497738586677485581]&#13;&#10;ELSEIF [ticket_categorization (group)]= &quot;Others&quot;  then [ticket_id after filter l1 (copy)_434878855472652292]&#10;END' />
