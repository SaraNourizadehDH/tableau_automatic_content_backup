case when ticket_categorization = "Payment Support" and overall_max_resolved = 7 and rn_updated_at_ticket= 1 and lower(trim(label_for_agents))= "resolved" then ticket_resolved_at 
when ticket_categorization = "Payment Support" and overall_max_resolved = 8 and rn_updated_at_ticket= 1 and lower(trim(label_for_agents))= "closed" then ticket_resolved_at

end as Payment_Support_resolution_time,

case when ticket_categorization = "Implementation Team" and overall_max_resolved = 9 and rn_updated_at=1  and difference ="change" then ticket_updated_time
when ticket_categorization = "Implementation Team" and overall_max_resolved = 10 and rn_updated_at=1  and difference ="change" then ticket_updated_time end as Implementation_team_updatedtime,
case when ticket_categorization = "Implementation Team" and overall_max_resolved = 9 and difference ="no change" and rn_updated_at=1 then ticket_created_at 
when ticket_categorization = "Implementation Team" and overall_max_resolved = 10 and difference =" no change" and rn_updated_at=1 then ticket_created_at
end as Implementatio_Team_created_time,


case when ticket_categorization = "Implementation Team" and overall_max_resolved = 9 and rn_updated_at_ticket= 1 and lower(trim(label_for_agents))= "resolved" then ticket_resolved_at 
when ticket_categorization = "Implementation Team" and overall_max_resolved = 10 and rn_updated_at_ticket= 1 and lower(trim(label_for_agents))= "closed" then ticket_resolved_at

end as Implementation_Team_resolution_time,

case when ticket_categorization = "Menu Team" and overall_max_resolved = 11 and rn_updated_at=1  and difference ="change" then ticket_updated_time
when ticket_categorization = "Menu Team" and overall_max_resolved = 12 and rn_updated_at=1  and difference ="change" then ticket_updated_time end as menu_team_updatedtime,
case when ticket_categorization = "Menu Team" and overall_max_resolved = 11 and difference ="no change" and rn_updated_at=1 then ticket_created_at 
when ticket_categorization = "Menu Team" and overall_max_resolved = 12 and difference =" no change" and rn_updated_at=1 then ticket_created_at
end as Menu_Team_created_time,


