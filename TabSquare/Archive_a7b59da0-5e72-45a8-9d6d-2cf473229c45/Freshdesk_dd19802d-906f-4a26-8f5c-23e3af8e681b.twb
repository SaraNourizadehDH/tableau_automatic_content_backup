      <column caption='NEW Avg Res Time ' datatype='real' name='[Avg Res Time (copy)_434878856107261971]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_434878856181485588])/ [Calculation_434878856044965901]' />
      </column>
      <column caption='previous month ticket id' datatype='integer' name='[Calculation2 (copy)_2295428492990390314]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if datetrunc(&apos;month&apos;, [current month -1 (copy)_2295428492986277922])= datetrunc(&apos;month&apos;, DATEADD(&apos;month&apos;,0, [current month -1 (copy)_2295428492986277922])) then [ticket_id] END' />
      </column>
      <column caption='Calculation1' datatype='date' datatype-customized='true' name='[Calculation_2295428492978978844]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [ticket_created_at]))' />
      </column>
      <column caption='Calculation2' datatype='integer' name='[Calculation_2295428492988710951]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if DATETRUNC(&apos;month&apos;, [current month (copy)_2295428492985454624])=DATETRUNC(&apos;month&apos;, [ticket_created_at]) then [ticket_id] END' />
      </column>
      <column caption='l1 : created max' datatype='datetime' name='[Calculation_2497738586669506560]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [ticket_id], [ticket_categorization]: MAX([l1_created_at])}' />
      </column>
      <column caption='O time difference' datatype='integer' name='[Calculation_2497738586675929096]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [ticket_id]: DATEDIFF([Parameters].[Parameter 1], max([l1 : created max (copy)_2497738586672353283]), max([Calculation_3021915367371358208]))}' />
      </column>
      <column caption='l3 filter' datatype='boolean' name='[Calculation_2497738586677129227]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='not ISNULL([l2 difference (copy) (copy)_2497738586676486154])' />
      </column>
      <column caption='time difference l3- after filter' datatype='integer' name='[Calculation_2497738586677325836]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_2497738586677129227]= True  then [l2 difference (copy) (copy)_2497738586676486154] END' />
      </column>
      <column aggregation='Sum' caption='ticket_id after filter l3' datatype='integer' name='[Calculation_2497738586677485581]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if [Calculation_2497738586677129227]= true then [ticket_id] END' />
      </column>
      <column caption='index' datatype='integer' name='[Calculation_2497738586678841358]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
