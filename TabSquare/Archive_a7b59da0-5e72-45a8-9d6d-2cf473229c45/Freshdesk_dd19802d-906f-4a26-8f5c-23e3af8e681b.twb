      </column>
      <column caption='l1 average resolution time' datatype='real' name='[Calculation_2497738586681040917]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([time difference l2- after filter (copy)_2497738586696630298])/ COUNTD([ticket_id after filter l3 (copy)_2497738586679824404])' />
