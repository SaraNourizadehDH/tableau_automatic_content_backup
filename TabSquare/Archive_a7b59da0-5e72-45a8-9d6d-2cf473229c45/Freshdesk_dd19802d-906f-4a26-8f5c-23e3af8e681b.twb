          <object caption='Custom SQL Query' id='_04FE3A040184451BB2AE18271A4D0B26'>
            <properties context=''>
              <relation connection='bigquery.070tibj101ubcl1h54p7l19k7dsc' name='Custom SQL Query' type='text'><![CDATA[select * ,
case when  rn_updated_at_ticket= 1 then ticket_categorization end as max_labels,


case when ticket_categorization = "l1"  and overall_max_resolved = 1 and rn_updated_at=1 then ticket_created_at
when ticket_categorization = "l1"  and overall_max_resolved = 2 and rn_updated_at=1 then ticket_created_at
end as l1_created_at,

case when ticket_categorization = "l1" and overall_max_resolved = 1 and  rn_updated_at_ticket= 1 and  lower(trim(label_for_agents))= "resolved" then ticket_resolved_at 
when ticket_categorization = "l1" and overall_max_resolved = 2 and  rn_updated_at_ticket= 1  and lower(trim(label_for_agents))= "closed" then ticket_resolved_at 
end as l1_resolution_time,



case when ticket_categorization = "l3" and overall_max_resolved = 3 and difference ="change" and rn_updated_at=1 then ticket_updated_time
when ticket_categorization = "l3" and overall_max_resolved = 4 and difference ="change" and rn_updated_at=1 then ticket_updated_time end as l3_updatedtime,
case when ticket_categorization = "l3" and overall_max_resolved = 3 and difference =" no change" and rn_updated_at=1 then ticket_created_at 
when ticket_categorization = "l3" and overall_max_resolved = 4 and difference =" no change" and rn_updated_at=1 then ticket_created_at end as l3_created_time,

case when ticket_categorization = "l3" and overall_max_resolved = 3 and rn_updated_at_ticket= 1 and  lower(trim(label_for_agents))= "resolved" then ticket_resolved_at 
when ticket_categorization = "l3" and overall_max_resolved = 4 and rn_updated_at_ticket= 1 and lower(trim(label_for_agents))= "closed" then ticket_resolved_at
end as l3_resolution_time,


case when ticket_categorization = "Finance Team" and overall_max_resolved = 5 and rn_updated_at=1  and difference ="change" then ticket_updated_time
when ticket_categorization = "Finance Team" and overall_max_resolved = 6 and rn_updated_at=1  and difference ="change" then ticket_updated_time end as finance_team_updatedtime,
case when ticket_categorization = "Finance Team" and overall_max_resolved = 5 and difference =" no change" and rn_updated_at=1 then ticket_created_at 
when ticket_categorization = "Finance Team" and overall_max_resolved = 6 and difference =" no change" and rn_updated_at=1 then ticket_created_at
end as Finance_Team_created_time,


case when ticket_categorization = "Finance Team" and overall_max_resolved = 5 and rn_updated_at_ticket= 1 and lower(trim(label_for_agents))= "resolved" then ticket_resolved_at 
when ticket_categorization = "Finance Team" and overall_max_resolved = 6 and rn_updated_at_ticket= 1 and lower(trim(label_for_agents))= "closed" then ticket_resolved_at

end as Finance_Team_resolution_time,

case when ticket_categorization = "Payment Support" and overall_max_resolved = 7 and rn_updated_at=1  and difference ="change" then ticket_updated_time
when ticket_categorization = "Payment Support" and overall_max_resolved = 8 and rn_updated_at=1  and difference ="change" then ticket_updated_time end as payment_support_updatedtime,
case when ticket_categorization = "Payment Support" and overall_max_resolved = 7 and difference ="no change" and rn_updated_at=1 then ticket_created_at 
when ticket_categorization = "Payment Support" and overall_max_resolved = 8 and difference =" no change" and rn_updated_at=1 then ticket_created_at
end as Payment_Support_created_time,


case when ticket_categorization = "Payment Support" and overall_max_resolved = 7 and rn_updated_at_ticket= 1 and lower(trim(label_for_agents))= "resolved" then ticket_resolved_at 
when ticket_categorization = "Payment Support" and overall_max_resolved = 8 and rn_updated_at_ticket= 1 and lower(trim(label_for_agents))= "closed" then ticket_resolved_at

end as Payment_Support_resolution_time,

case when ticket_categorization = "Implementation Team" and overall_max_resolved = 9 and rn_updated_at=1  and difference ="change" then ticket_updated_time
when ticket_categorization = "Implementation Team" and overall_max_resolved = 10 and rn_updated_at=1  and difference ="change" then ticket_updated_time end as Implementation_team_updatedtime,
case when ticket_categorization = "Implementation Team" and overall_max_resolved = 9 and difference ="no change" and rn_updated_at=1 then ticket_created_at 
when ticket_categorization = "Implementation Team" and overall_max_resolved = 10 and difference =" no change" and rn_updated_at=1 then ticket_created_at
end as Implementatio_Team_created_time,


case when ticket_categorization = "Implementation Team" and overall_max_resolved = 9 and rn_updated_at_ticket= 1 and lower(trim(label_for_agents))= "resolved" then ticket_resolved_at 
when ticket_categorization = "Implementation Team" and overall_max_resolved = 10 and rn_updated_at_ticket= 1 and lower(trim(label_for_agents))= "closed" then ticket_resolved_at

end as Implementation_Team_resolution_time,

case when ticket_categorization = "Menu Team" and overall_max_resolved = 11 and rn_updated_at=1  and difference ="change" then ticket_updated_time
when ticket_categorization = "Menu Team" and overall_max_resolved = 12 and rn_updated_at=1  and difference ="change" then ticket_updated_time end as menu_team_updatedtime,
case when ticket_categorization = "Menu Team" and overall_max_resolved = 11 and difference ="no change" and rn_updated_at=1 then ticket_created_at 
when ticket_categorization = "Menu Team" and overall_max_resolved = 12 and difference =" no change" and rn_updated_at=1 then ticket_created_at
end as Menu_Team_created_time,


case when ticket_categorization = "Menu Team" and overall_max_resolved = 11 and rn_updated_at_ticket= 1 and lower(trim(label_for_agents))= "resolved" then ticket_resolved_at 
when ticket_categorization = "Menu Team" and overall_max_resolved = 12 and rn_updated_at_ticket= 1 and lower(trim(label_for_agents))= "closed" then ticket_resolved_at

end as Menu_Team_resolution_time,
from 
(select distinct *, case when (  lag_cat- ticket_cat_1 ) <<>>0 then "change"
else " no change" end as difference,
from (select distinct *,
lag(ticket_cat_1) over(partition by ticket_id order by ticket_updated_time) as lag_cat ,
max(resolved) over(partition by ticket_id) as overall_max_resolved,
from
 (select distinct *,
row_number() over(partition by ticket_id, ticket_categorization order by ticket_updated_time asc) as rn_updated_at,
row_number() over(partition by ticket_id, ticket_categorization, label_for_agents order by ticket_updated_time desc) as rn_resolved_at, 
row_number() over(partition by ticket_id order by ticket_updated_time desc) as rn_updated_at_ticket,
case when (lower(trim(label_for_agents))= "resolved" ) and ticket_categorization = "l1" then 1
when (lower(trim(label_for_agents))= "closed" ) and ticket_categorization = "l1" then 2
when (lower(trim(label_for_agents))= "resolved") and ticket_categorization = "l3" then 3
when (lower(trim(label_for_agents))= "closed" ) and ticket_categorization = "l3" then 4
when (lower(trim(label_for_agents))= "resolved") and ticket_categorization = 'Finance Team' then 5
when (lower(trim(label_for_agents))= "closed" ) and ticket_categorization = 'Finance Team' then 6
when (lower(trim(label_for_agents))= "resolved") and ticket_categorization = 'Payment Support' then 7
when (lower(trim(label_for_agents))= "closed" ) and ticket_categorization = 'Payment Support' then 8
when (lower(trim(label_for_agents))= "resolved") and ticket_categorization = 'Implementation Team' then 9
when (lower(trim(label_for_agents))= "closed" ) and ticket_categorization = 'Implementation Team' then 10
when (lower(trim(label_for_agents))= "resolved") and ticket_categorization = 'Menu Team' then 11
when (lower(trim(label_for_agents))= "closed" ) and ticket_categorization = 'Menu Team' then 12
end as resolved,
case when ticket_categorization = "l1" then 0
when ticket_categorization = "l3" then 1
when ticket_categorization = "Finance Team" then -1
when ticket_categorization = "Payment Support" then -2
when ticket_categorization = "Implementation Team" then -3
when ticket_categorization = "Menu Team" then -4
end as ticket_cat_1 
from (SELECT  distinct th.id as ticket_id, th.created_at as ticket_created_at,th.stats_resolved_at as ticket_resolved_at,
th.updated_at as ticket_updated_time, pl.priority as priority_status, g.name as group_name, a.contact_name as agent_name,
max(th.custom_cf_country) over(partition by th.id) as country_new, custom_cf_brand_name as brand_name,
custom_cf_chain_name as chain_name,
custom_cf_merchant_key as Merchant_key ,mm.Merchant_id as merchant_id, mm.Account_Name, mm.Chain_Name_in_system,
mm.name_of_account_manager,
custom_cf_outlet_name as Outlet_name,
custom_cf_reported_issue as issue_categorization,
custom_cf_scope_categorization_941995 as scope_categorization, 
custom_cf_product_type as product_categorization,
cm.name as Company_name,
case when so.source is null then "Whatsapp" else so.source end as source_new,
case when trim(g.name) IN ("Refund Support",
"SG-On-Site Support",
"Supportdesk AU",
"Supportdesk ID",
"Supportdesk MY",
"Supportdesk SG",
"Supportdesk") THEN 'l1'
when trim(g.name) IN ("L2-CMS-Support","L2-Console-Support","L2-CRM-Support",
"L2-Data Analytics-Support","L2-eCMS-Support","L2-Hardware-Support",
"L2-Integration-Support","L2-Payment-Support","L2-SmartConnect-Support",
"L2-SmartKiosk-Support","L2-SmartQ-Support","L2-SmartTab-Support",
"L2-SmartWeb-Support","L2-Support","L3-CMS-Support","L3-Console-Support",
"L3-CRM-Support","L3-Data Analytics-Support","L3-Delivery-Support",
"L3-eCMS-Support","L3-Hardware-Support","L3-Integration-Support",
"L3-Payment-Support","L3-SmartConnect-Support","L3-SmartKiosk-Support",
"L3-SmartQ-Support","L3-SmartTab-Support","L3-SmartWeb-Support",
"L3-Void Order-Support","Supportdesk - L2","L3-SmartConnect-Support","L3-SmartWeb-Support","L3-Data Analytics-Support","L3-CRM-Support",
"L3-CMS-Support","L3-SmartTerminal-Support","L3-eCMS-Support","L3-iOS App-Support",
"L3-Integration-Support","L3-Payment-Support","L3-DBOps-Support","L3-SmartKiosk-Support",
"L3-SmartQ-Support","L3-Console-Support","L3-Delivery-Support","L2-SmartWeb-Support","L2-Support") THEN 'l3'
when trim(g.name) IN ("Finance Team") then 'Finance Team'
when trim(g.name) IN ("Payment Support") then 'Payment Support'
when trim(g.name) IN ("Implementation/Project Support") then 'Implementation Team'
when trim(g.name) IN ("Merchant Data Support") then 'Menu Team'
else "others"
 end as ticket_categorization ,
  sl.label_for_agents,th.deleted,
from `freshdesk_data_prod.ticket_history` th
left join `freshdesk_data_prod.status_lookup` sl
on th.status = sl.id
left join `freshdesk_data_prod.source_lookup` so
on th.source = so.id
left join `freshdesk_data_prod.group` g
on  th.group_id = g.id
left join `freshdesk_data_prod.priority_lookup` pl
on th.priority = pl.id
left join `freshdesk_data_prod.agent` a
on a.id = th.responder_id
left join `freshdesk_data_prod.company` cm
on th.company_id= cm.id
left join 
`tabsquare-data-sciences.tabsquare_dw_lookups.master_merchant_list` mm 
on trim(th.custom_cf_merchant_key) = trim(mm.Merchant_id)
where  th.created_at >>="2024-01-01"  order by th.id, th.created_at,th.updated_at)order by ticket_id, ticket_created_at,ticket_updated_time )order by ticket_id, ticket_created_at,ticket_updated_time)order by ticket_id, ticket_created_at,ticket_updated_time )order by ticket_id, ticket_created_at,ticket_updated_time]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
