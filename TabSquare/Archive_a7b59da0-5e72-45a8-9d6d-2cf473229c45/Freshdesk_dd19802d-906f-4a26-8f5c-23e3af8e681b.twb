    <worksheet name='average resolution time'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>Average Resolution Time (</run>
            <run bold='true' fontalignment='1' fontsize='10'>in &lt;[Parameters].[Parameter 1]&gt;</run>
            <run bold='true' fontalignment='1'>)</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='true' fontalignment='1' fontsize='8'>(Does not include Source- Whatsapp)</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='true' fontalignment='1' fontsize='7'>(Others Contain (Finance Team, Implementation Team, Menu Team, Payment Support))</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (freshdesk_data_prod)' name='federated.0p6du6d0dmph0s13v3bz70d4d9mi' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Day' caption='Time period' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;day&quot;'>
              <calculation class='tableau' formula='&quot;day&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Day' />
                <alias key='&quot;hour&quot;' value='Hour' />
                <alias key='&quot;minute&quot;' value='Minute' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0p6du6d0dmph0s13v3bz70d4d9mi'>
            <column datatype='string' name='[Account_Name]' role='dimension' type='nominal' />
            <column caption='l1 : created max' datatype='datetime' name='[Calculation_2497738586669506560]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [ticket_id], [ticket_categorization]: MAX([l1_created_at])}' />
            </column>
            <column caption='O time difference' datatype='integer' name='[Calculation_2497738586675929096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [ticket_id]: DATEDIFF([Parameters].[Parameter 1], max([l1 : created max (copy)_2497738586672353283]), max([Calculation_3021915367371358208]))}' />
            </column>
            <column caption='l3 filter' datatype='boolean' name='[Calculation_2497738586677129227]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='not ISNULL([l2 difference (copy) (copy)_2497738586676486154])' />
            </column>
            <column caption='time difference l3- after filter' datatype='integer' name='[Calculation_2497738586677325836]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Calculation_2497738586677129227]= True  then [l2 difference (copy) (copy)_2497738586676486154] END' />
            </column>
            <column aggregation='Sum' caption='ticket_id after filter l3' datatype='integer' name='[Calculation_2497738586677485581]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if [Calculation_2497738586677129227]= true then [ticket_id] END' />
            </column>
            <column caption='l1 average resolution time' datatype='real' name='[Calculation_2497738586681040917]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([time difference l2- after filter (copy)_2497738586696630298])/ COUNTD([ticket_id after filter l3 (copy)_2497738586679824404])' />
            </column>
            <column caption='no whatsapp' datatype='boolean' name='[Calculation_2497738586685190168]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[source_new]&lt;&gt; &quot;Whatsapp&quot;' />
            </column>
            <column caption='O Max Resolved At' datatype='datetime' name='[Calculation_3021915367371358208]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [ticket_id], [ticket_categorization (group)], [label_for_agents]: MAX(if [rn_resolved_at]= 1 and [label_for_agents]=  &apos;Resolved&apos; then [ticket_resolved_at]end )}' />
            </column>
            <column caption='Resolved Dates' datatype='boolean' name='[Calculation_434878855830249484]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='month([ticket_created_at])= month([ticket_resolved_at]) and YEAR([ticket_created_at])= YEAR([ticket_resolved_at])' />
            </column>
            <column datatype='string' name='[agent_name]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country_new]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='l1 : resolution max ' datatype='datetime' name='[l1 : created max (copy)_2497738586671677441]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [ticket_id], [ticket_categorization]: MAX([l1_resolution_time])}' />
            </column>
            <column caption='O : created max' datatype='date' name='[l1 : created max (copy)_2497738586672353283]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [ticket_id]: MAX([ticket_created_at])}' />
            </column>
            <column caption='others : created max ' datatype='date' name='[l1 : created max (copy)_434878855472500737]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [ticket_id], [ticket_categorization (group)]: MAX([ticket_created_at])}' />
            </column>
            <column caption='Others : resolution max  ' datatype='datetime' name='[l1 : resolution max  (copy)_434878855472549890]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [ticket_id], [ticket_categorization (group)]: MAX([ticket_resolved_at])}' />
            </column>
            <column caption='l3 average resolution time' datatype='real' name='[l1 average resolution time (copy) (copy)_2497738586681253911]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2497738586677325836])/ COUNTD([Calculation_2497738586677485581])' />
            </column>
            <column caption='O average resolution time' datatype='real' name='[l1 average resolution time (copy)_2497738586681249814]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([time difference l3- after filter (copy)_2497738586679689234])/ COUNTD([ticket_id after filter l3 (copy)_2497738586679640081])' />
            </column>
            <column caption='Others average resolution time ' datatype='real' name='[l1 average resolution time (copy)_434878855472697349]' role='measure' type='quantitative'>
