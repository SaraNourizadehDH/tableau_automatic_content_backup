&quot;L3-eCMS-Support&quot;,&quot;L3-Hardware-Support&quot;,&quot;L3-Integration-Support&quot;,
&quot;L3-Payment-Support&quot;,&quot;L3-SmartConnect-Support&quot;,&quot;L3-SmartKiosk-Support&quot;,
&quot;L3-SmartQ-Support&quot;,&quot;L3-SmartTab-Support&quot;,&quot;L3-SmartWeb-Support&quot;,
&quot;L3-Void Order-Support&quot;,&quot;Supportdesk - L2&quot;,&quot;L3-SmartConnect-Support&quot;,&quot;L3-SmartWeb-Support&quot;,&quot;L3-Data Analytics-Support&quot;,&quot;L3-CRM-Support&quot;,
&quot;L3-CMS-Support&quot;,&quot;L3-SmartTerminal-Support&quot;,&quot;L3-eCMS-Support&quot;,&quot;L3-iOS App-Support&quot;,
&quot;L3-Integration-Support&quot;,&quot;L3-Payment-Support&quot;,&quot;L3-DBOps-Support&quot;,&quot;L3-SmartKiosk-Support&quot;,
&quot;L3-SmartQ-Support&quot;,&quot;L3-Console-Support&quot;,&quot;L3-Delivery-Support&quot;,&quot;L2-SmartWeb-Support&quot;,&quot;L2-Support&quot;) THEN &apos;l3&apos;
when trim(g.name) IN (&quot;Finance Team&quot;) then &apos;Finance Team&apos;
when trim(g.name) IN (&quot;Payment Support&quot;) then &apos;Payment Support&apos;
when trim(g.name) IN (&quot;Implementation/Project Support&quot;) then &apos;Implementation Team&apos;
when trim(g.name) IN (&quot;Merchant Data Support&quot;) then &apos;Menu Team&apos;
else &quot;others&quot;
 end as ticket_categorization ,
  sl.label_for_agents,th.deleted,
from `freshdesk_data_prod.ticket_history` th
left join `freshdesk_data_prod.status_lookup` sl
on th.status = sl.id
left join `freshdesk_data_prod.source_lookup` so
on th.source = so.id
left join `freshdesk_data_prod.group` g
on  th.group_id = g.id
left join `freshdesk_data_prod.priority_lookup` pl
on th.priority = pl.id
left join `freshdesk_data_prod.agent` a
on a.id = th.responder_id
left join `freshdesk_data_prod.company` cm
on th.company_id= cm.id
left join 
`tabsquare-data-sciences.tabsquare_dw_lookups.master_merchant_list` mm 
on trim(th.custom_cf_merchant_key) = trim(mm.Merchant_id)
where  th.created_at &gt;&gt;=&quot;2024-12-01&quot;)</relation>
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
