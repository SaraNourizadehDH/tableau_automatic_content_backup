            <column aggregation='Sum' caption='Login Sales' datatype='real' default-type='quantitative' layered='true' name='[Calculation_1696168272759394309]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='if [Customer_Type]=&apos;Login&apos; then [sales (Custom SQL Query7)] END' />
            </column>
            <column aggregation='User' caption='Login ABV' datatype='real' default-type='quantitative' layered='true' name='[Calculation_1696168272759496710]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='sum([Calculation_1696168272759394309])/ SUM([Calculation_1696168272759255044])' />
            </column>
            <column aggregation='User' caption='Login Customer Count' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_1696168272759603207]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
