          <calculation column='[Calculation_2408088810312265738]' formula='if [Customer_Type]=&apos;Guest&apos; then [orders (Custom SQL Query2)] END' />
          <calculation column='[Calculation_2408088810313936912]' formula='SUM([Login Sales (copy)_2408088810313555983])/SUM([Calculation_2408088810312265738])' />
          <calculation column='[Calculation_2408088810314719251]' formula='sum([Guest Orders (copy)_2408088810312384524])/ SUM([Guest Orders (copy)_2408088810312318987])' />
          <calculation column='[Calculation_2408088810314973205]' formula='sum([Guest Orders (copy)_2408088810312318987])/SUM([orders (Custom SQL Query2)])' />
          <calculation column='[Calculation_2408088810315059222]' formula='sum([Calculation_2408088810312265738])/SUM([orders (Custom SQL Query2)])' />
          <calculation column='[Calculation_2408088810315149335]' formula='sum(if [Customer_Type]=&apos;Login&apos; then [customer_count] END)' />
          <calculation column='[Calculation_2408088810316972056]' formula='[date_diff_month]' />
          <calculation column='[Calculation_2408088810317213721]' formula='{ FIXED [m1]: MAX(if [Calculation_2408088810317299738]=True then [Calculation_2408088810316972056] END)}' />
          <calculation column='[Calculation_2408088810317299738]' formula='[order_date]&lt;=[last_date]' />
          <calculation column='[Calculation_2408088810317504539]' formula='IF [mm_country] == &apos;Singapore&apos; THEN [Sales (Custom SQL Query3)]&#10;ELSEIF [mm_country] == &apos;Australia&apos; THEN [Sales (Custom SQL Query3)]&#10;ELSEIF [mm_country] == &apos;Indonesia&apos; THEN [Sales (Custom SQL Query3)] * 0.000092&#10;ELSEIF [mm_country] == &apos;Malayasia&apos; THEN [Sales (Custom SQL Query3)] * 0.33&#10;ELSE [Sales (Custom SQL Query3)] END' />
          <calculation column='[Calculation_2408088810321399837]' formula='{ FIXED [m1]: sum(if [Calculation_2408088810317299738]=True then [Calculation_2408088810317504539] END)}' />
          <calculation column='[Calculation_2408088810321530910]' formula='[Calculation_2408088810321399837]/ [Calculation_2408088810317213721]' />
          <calculation column='[Calculation_2408088810321608735]' formula='if ISNULL([Calculation_2408088810321530910]) then [Calculation_2408088810321399837] else [Calculation_2408088810321530910] end' />
          <calculation column='[Calculation_2408088810321682464]' formula='[Calculation_2408088810321608735]*30' />
          <calculation column='[Calculation_2408088810321821729]' formula='if [Calculation_2408088810321682464]&gt;=0 and [Calculation_2408088810321682464]&lt; 20000 then &quot;Low&quot;&#10;ELSEIF [Calculation_2408088810321682464]&gt;=20000 and [Calculation_2408088810321682464]&lt; 100000 then &quot;Medium&quot;&#10;ELSEIF [Calculation_2408088810321682464]&gt;=100000  then &quot;High&quot;&#10;END' />
          <calculation column='[Calculation_2408088810321887266]' formula='if [Calculation_2408088810321821729] =&quot;Low&quot; then [m1] END' />
          <calculation column='[Calculation_2408088810322358310]' formula='COUNTD([Merchant_id (Custom SQL Query3)])' />
          <calculation column='[Calculation_2408088810323832871]' formula='IFNULL(COUNTD([finance_1]),0)+IFNULL(COUNTD([implementation_1]),0)+IFNULL(COUNTD([menu_1]),0)+IFNULL(COUNTD([payment_1]),0)+IFNULL(COUNTD([others_1]),0)' />
          <calculation column='[Calculation_2408088810324602921]' formula='(COUNTD([l1_1])+COUNTD([l3_1])+COUNTD([Calculation_2408088810356891705]))/sum([orders])' />
          <calculation column='[Calculation_2408088810326016042]' formula='if [Result]= &quot;FAILED&quot; then [order_count] END' />
          <calculation column='[Calculation_2408088810326089771]' formula='if [Result]= &quot;SUCCESS&quot; then [order_count] END' />
          <calculation column='[Calculation_2408088810326253612]' formula='IFNULL([Calculation_2408088810326016042],0)+IFNULL([Calculation_2408088810326089771],0)' />
          <calculation column='[Calculation_2408088810326343725]' formula='sum([Calculation_2408088810326089771])/SUM([order_count])' />
          <calculation column='[Calculation_2408088810328784945]' formula='([sales (Custom SQL Query4)]-[last_1_month_gmv])/[last_1_month_gmv]' />
          <calculation column='[Calculation_2408088810328883250]' formula='if ifnull([last_3_months_gmv],0)=0 and ifnull([last_4_months_gmv],0)!=0&#10;and [first_month_flag]=0 and ifnull([sales (Custom SQL Query4)],0)=0 then 1 else 0 end' />
          <calculation column='[Calculation_2408088810328973363]' formula='if [Calculation_2408088810328784945]&gt;=0.2 then &apos;Increasing&apos;&#10;ELSEIF [Calculation_2408088810328784945]&lt;-0.2 then &apos;Decreasing&apos;&#10;else &apos;Stable&apos;&#10;end' />
          <calculation column='[Calculation_2408088810329157684]' formula='if [first_month_flag]=1 then &apos;New&apos;&#10;ELSEIF ifnull([last_1_month_gmv],0)=0 and ifnull([last_2_months_gmv],0)&gt;0 and ifnull([sales (Custom SQL Query4)],0)=0 then &apos;At Risk of being Lost&apos;&#10;elseif ifnull([last_2_months_gmv],0)=0 and ifnull([last_3_months_gmv],0)&gt;0 and ifnull([sales (Custom SQL Query4)],0)=0 then &apos;High Risk of being Lost&apos;&#10;ELSEIF ifnull([last_1_month_gmv],0)&gt;0 and ifnull([sales (Custom SQL Query4)],0)=0 then &apos;Not Active&apos;&#10;ELSEIF ifnull([last_1_month_gmv],0)&gt;0 and ifnull([sales (Custom SQL Query4)],0)&gt;0 then [Calculation_2408088810328973363]&#10;elseif ifnull([last_1_month_gmv],0)=0  and ifnull([last_2_months_gmv],0)&gt;0 and ifnull([sales (Custom SQL Query4)],0)&gt;0 then &apos;Quick Restarted&apos;&#10;elseif ifnull([last_2_months_gmv],0)=0 and ifnull([last_3_months_gmv],0)&gt;0 and ifnull([sales (Custom SQL Query4)],0)&gt;0 then &apos;Restarted&apos;&#10;elseif ifnull([last_3_months_gmv],0)=0 and ifnull([sales (Custom SQL Query4)],0)&gt;0 then &apos;Back From Dead&apos;&#10;ELSEIF [Calculation_2408088810328883250]=1 then &apos;Lost&apos;&#10;end' />
          <calculation column='[Calculation_2408088810329313333]' formula='if [first_month_flag]=1 then &apos;New&apos;&#10;ELSEIF [Calculation_2408088810329157684] = &apos;Not Active&apos;  then &apos;Not Active&apos;&#10;elseif [Calculation_2408088810329157684] = &apos;At Risk of being Lost&apos;&#10;        or [Calculation_2408088810329157684] = &apos;High Risk of being Lost&apos; then &apos;At Risk&apos;&#10;ELSEIF [Calculation_2408088810329157684] = &apos;Restarted&apos;&#10;        or [Calculation_2408088810329157684] = &apos;Quick Restarted&apos;&#10;        or [Calculation_2408088810329157684] = &apos;Back From Dead&apos; then &apos;Restarted&apos;&#10;else [Calculation_2408088810329157684]&#10;end' />
          <calculation column='[Calculation_2408088810341261366]' formula='SUM([Calculation_2408088810309984260])/COUNTD([merchant_id])' />
          <calculation column='[Calculation_2408088810356891705]' formula='if  rn_resolved_at= 1 and ticket_categorization = &quot;others&quot; and status = &quot;Resolved&quot; and [month_year_created]=[month_year_resolved] and  source_new &lt;&gt; &quot;Whatsapp&quot; then [ticket_id] end' />
          <calculation column='[Guest Orders (copy)_2408088810312318987]' formula='if [Customer_Type]=&apos;Login&apos; then [orders (Custom SQL Query2)] END' />
          <calculation column='[Guest Orders (copy)_2408088810312384524]' formula='if [Customer_Type]=&apos;Login&apos; then [sales (Custom SQL Query2)] END' />
          <calculation column='[Login Sales (copy)_2408088810313555983]' formula='if [Customer_Type]=&apos;Guest&apos; then [sales (Custom SQL Query2)] END' />
          <calculation column='[Low Buckets (copy 2)_2408088810322026533]' formula='if [Calculation_2408088810321821729] =&quot;High&quot; then [m1] END' />
          <calculation column='[Low Buckets (copy) (copy)_2408088810321944612]' formula='if [Calculation_2408088810321821729] =&quot;Medium&quot; then [m1] END' />
          <calculation column='[Success % (copy)_2408088810326384686]' formula='sum([Calculation_2408088810326016042])/SUM([order_count])' />
          <calculation column='[rating (group)]' formula='CASE [rating]&#10;  WHEN 0 THEN &quot;Negative Rating&quot;&#10;  WHEN 1 THEN &quot;Negative Rating&quot;&#10;  WHEN 2 THEN &quot;Negative Rating&quot;&#10;  WHEN 3 THEN &quot;Neutral Rating&quot;&#10;  WHEN 4 THEN &quot;Positive Rating&quot;&#10;  WHEN 5 THEN &quot;Positive Rating&quot;&#10;  ELSE STR([rating])&#10;END' />
        </calculations>
