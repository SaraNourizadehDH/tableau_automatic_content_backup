            </column>
            <column aggregation='Count' caption='new No GMV in Last 7 Days' datatype='boolean' default-type='nominal' layered='true' name='[Calculation_2442639872000397318]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default'>
              <calculation class='tableau' formula='{ FIXED [Merchant_id (Custom SQL Query11)] : SUM(IF [Calculation_91760909666140173] = True THEN [Sales (Custom SQL Query11)] ELSE 0 END) } = 0' />
            </column>
            <column aggregation='Sum' caption='last 7 days sales' datatype='real' default-type='quantitative' layered='true' name='[Calculation_2442639872007032840]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='ifnull(if [Calculation_91760909666140173]= TRUE then [Sales (Custom SQL Query11)] END,0)' />
            </column>
            <column aggregation='Count' caption='7 days GMV filter' datatype='boolean' default-type='nominal' layered='true' name='[Calculation_91760909666140173]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default'>
              <calculation class='tableau' formula='[order_date (Custom SQL Query11)]&gt;= dateadd(&apos;day&apos;,-7,TODAY()) and [order_date (Custom SQL Query11)]&lt;= TODAY()' />
            </column>
            <column aggregation='Count' caption='Merchant_id ' datatype='string' default-type='nominal' layered='true' name='[Merchant_id (Custom SQL Query11)]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
