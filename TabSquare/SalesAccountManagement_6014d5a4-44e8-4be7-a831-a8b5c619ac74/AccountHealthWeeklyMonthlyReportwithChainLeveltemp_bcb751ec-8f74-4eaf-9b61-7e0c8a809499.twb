              <calculation class='tableau' formula='ifnull(([Calculation_8877157850208419841]),0)/ sum([Calculation_246361031159136256])' />
            </column>
            <column aggregation='User' caption='Total Recurring Revenue' datatype='real' default-type='quantitative' layered='true' name='[Calculation_8877157850208419841]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='//[recurring_revenue_acc]+[deferred_revenue_acc]&#10;&#10;&#10;ifnull([Total Payment Gateway Revenue(minus cost) (copy)_5936096161049804800],0)&#10;+ifnull(SUM([recurring_revenue_acc]),0)&#10;+ifnull(sum([deferred_revenue_acc]),0)' />
            </column>
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[Name_of_Account_Manager (Custom SQL Query)]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
