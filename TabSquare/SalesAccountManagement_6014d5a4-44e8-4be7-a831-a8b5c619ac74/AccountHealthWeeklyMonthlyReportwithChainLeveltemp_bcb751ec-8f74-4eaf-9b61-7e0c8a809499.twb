            <column aggregation='Year' caption='last 7 to today' datatype='date' default-type='ordinal' layered='true' name='[Calculation_2442639871998611457]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default'>
              <calculation class='tableau' formula='date(DATEADD(&apos;day&apos;, - 7, TODAY()))' />
            </column>
            <column aggregation='Year' caption='last to last 7 days to today' datatype='date' default-type='ordinal' layered='true' name='[Calculation_2442639871998996482]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default'>
