            <column aggregation='User' caption='Avg Recurring Revenue Per Store' datatype='real' default-type='quantitative' layered='true' name='[Calculation_7900158178059894792]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='([Calculation_8877157850208419841])/COUNTD([merchant_id (Custom SQL Query)])' />
