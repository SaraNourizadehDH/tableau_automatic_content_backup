          <calculation column='[Calculation_1075797400855040028]' formula='IF [mm_country (Custom SQL Query10)] == &apos;Singapore&apos; THEN [Sales (Custom SQL Query10) #1]&#13;&#10;ELSEIF [mm_country (Custom SQL Query10)] == &apos;Australia&apos; THEN [Sales (Custom SQL Query10) #1]&#13;&#10;ELSEIF [mm_country (Custom SQL Query10)] == &apos;Indonesia&apos; THEN [Sales (Custom SQL Query10) #1] * 0.000092&#13;&#10;ELSEIF [mm_country (Custom SQL Query10)] == &apos;Malayasia&apos; THEN [Sales (Custom SQL Query10) #1] * 0.33&#13;&#10;ELSE [Sales (Custom SQL Query10) #1] END' />
