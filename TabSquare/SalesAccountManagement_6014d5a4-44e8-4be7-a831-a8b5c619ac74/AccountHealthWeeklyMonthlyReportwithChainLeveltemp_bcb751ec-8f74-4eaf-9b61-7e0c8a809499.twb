          <calculation column='[Buckets (copy)_778559826681905154]' formula='if [Calculation_1075797400781545493]&gt;=0 and [Calculation_1075797400781545493]&lt; 20000 then &quot;Low&quot;&#13;&#10;ELSEIF [Calculation_1075797400781545493]&gt;=20000 and [Calculation_1075797400781545493]&lt; 100000 then &quot;Medium&quot;&#13;&#10;ELSEIF [Calculation_1075797400781545493]&gt;=100000  then &quot;High&quot;&#13;&#10;END' />
