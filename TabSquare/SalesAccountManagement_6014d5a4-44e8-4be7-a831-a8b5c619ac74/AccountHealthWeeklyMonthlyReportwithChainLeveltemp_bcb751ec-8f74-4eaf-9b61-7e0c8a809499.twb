          <calculation column='[Calculation_1075797400781434900]' formula='if [Parameters].[Parameter 1] =&quot;Week&quot; then &#10;if [sales for whole month (copy)_1526861070919933952]&gt;=0 and [sales for whole month (copy)_1526861070919933952]&lt; 1000 then &quot;Low&quot;&#13;&#10;ELSEIF [sales for whole month (copy)_1526861070919933952]&gt;=1000 and [sales for whole month (copy)_1526861070919933952]&lt; 7000 then &quot;Medium&quot;&#13;&#10;ELSEIF [sales for whole month (copy)_1526861070919933952]&gt;=7000  then &quot;High&quot;&#13;&#10;END&#10;&#10;ELSEIF  [Parameters].[Parameter 1]=&quot;Month&quot; then &#10;if [Calculation_1075797400781545493]&gt;=0 and [Calculation_1075797400781545493]&lt; 20000 then &quot;Low&quot;&#10;ELSEIF [Calculation_1075797400781545493]&gt;=20000 and [Calculation_1075797400781545493]&lt; 100000 then &quot;Medium&quot;&#10;ELSEIF [Calculation_1075797400781545493]&gt;=100000  then &quot;High&quot;&#10;END&#10;&#10;END' />
