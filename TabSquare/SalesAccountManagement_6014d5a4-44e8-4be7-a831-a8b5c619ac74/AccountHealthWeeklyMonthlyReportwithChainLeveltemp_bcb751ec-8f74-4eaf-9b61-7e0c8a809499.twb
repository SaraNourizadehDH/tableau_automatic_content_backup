              <calculation class='tableau' formula='[order_date (Custom SQL Query11)]&gt;= [Calculation_2442639871998996482] and [order_date (Custom SQL Query11)]&lt;= [Calculation_2442639871998611457]' />
            </column>
            <column aggregation='Count' caption='No GMV in Immediate previous 7 days' datatype='boolean' default-type='nominal' layered='true' name='[Calculation_2442639871999819780]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default'>
              <calculation class='tableau' formula='{ FIXED [Merchant_id (Custom SQL Query11)]: SUM(IF [Calculation_2442639871999545347] = True THEN [Sales (Custom SQL Query11)] ELSE 0 END) } = 0' />
            </column>
            <column aggregation='Count' caption='comment field' datatype='string' default-type='nominal' layered='true' name='[Calculation_2442639872000045061]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
