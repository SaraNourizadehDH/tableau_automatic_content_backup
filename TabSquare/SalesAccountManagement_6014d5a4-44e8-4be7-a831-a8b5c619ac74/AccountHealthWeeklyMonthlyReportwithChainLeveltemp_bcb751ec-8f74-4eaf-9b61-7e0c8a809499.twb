    <worksheet name='Merchant status CN (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>Merchant Status List View at Month Level</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Chain Health' name='sqlproxy.0u9bcx50mn6msm17140s80daf4xp' />
          </datasources>
          <datasource-dependencies datasource='sqlproxy.0u9bcx50mn6msm17140s80daf4xp'>
            <column aggregation='Sum' caption='Change in GMV wrt last month' datatype='real' default-type='quantitative' layered='true' name='[Calculation_2408088810328784945]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='([sales (Custom SQL Query4)]-[last_1_month_gmv])/[last_1_month_gmv]' />
            </column>
            <column aggregation='Sum' caption='Lost Merchant Flag(month)' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_2408088810328883250]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
              <calculation class='tableau' formula='if ifnull([last_3_months_gmv],0)=0 and ifnull([last_4_months_gmv],0)!=0&#10;and [first_month_flag]=0 and ifnull([sales (Custom SQL Query4)],0)=0 then 1 else 0 end' />
            </column>
            <column aggregation='Count' caption='Active Cohorts' datatype='string' default-type='nominal' layered='true' name='[Calculation_2408088810328973363]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
              <calculation class='tableau' formula='if [Calculation_2408088810328784945]&gt;=0.2 then &apos;Increasing&apos;&#10;ELSEIF [Calculation_2408088810328784945]&lt;-0.2 then &apos;Decreasing&apos;&#10;else &apos;Stable&apos;&#10;end' />
            </column>
            <column aggregation='Count' caption='Monthly Merchant Cohorts' datatype='string' default-type='nominal' layered='true' name='[Calculation_2408088810329157684]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
              <calculation class='tableau' formula='if [first_month_flag]=1 then &apos;New&apos;&#10;ELSEIF ifnull([last_1_month_gmv],0)=0 and ifnull([last_2_months_gmv],0)&gt;0 and ifnull([sales (Custom SQL Query4)],0)=0 then &apos;At Risk of being Lost&apos;&#10;elseif ifnull([last_2_months_gmv],0)=0 and ifnull([last_3_months_gmv],0)&gt;0 and ifnull([sales (Custom SQL Query4)],0)=0 then &apos;High Risk of being Lost&apos;&#10;ELSEIF ifnull([last_1_month_gmv],0)&gt;0 and ifnull([sales (Custom SQL Query4)],0)=0 then &apos;Not Active&apos;&#10;ELSEIF ifnull([last_1_month_gmv],0)&gt;0 and ifnull([sales (Custom SQL Query4)],0)&gt;0 then [Calculation_2408088810328973363]&#10;elseif ifnull([last_1_month_gmv],0)=0  and ifnull([last_2_months_gmv],0)&gt;0 and ifnull([sales (Custom SQL Query4)],0)&gt;0 then &apos;Quick Restarted&apos;&#10;elseif ifnull([last_2_months_gmv],0)=0 and ifnull([last_3_months_gmv],0)&gt;0 and ifnull([sales (Custom SQL Query4)],0)&gt;0 then &apos;Restarted&apos;&#10;elseif ifnull([last_3_months_gmv],0)=0 and ifnull([sales (Custom SQL Query4)],0)&gt;0 then &apos;Back From Dead&apos;&#10;ELSEIF [Calculation_2408088810328883250]=1 then &apos;Lost&apos;&#10;end' />
            </column>
            <column aggregation='Count' caption='Merchant Cohorts - Category' datatype='string' default-type='nominal' layered='true' name='[Calculation_2408088810329313333]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
              <calculation class='tableau' formula='if [first_month_flag]=1 then &apos;New&apos;&#10;ELSEIF [Calculation_2408088810329157684] = &apos;Not Active&apos;  then &apos;Not Active&apos;&#10;elseif [Calculation_2408088810329157684] = &apos;At Risk of being Lost&apos;&#10;        or [Calculation_2408088810329157684] = &apos;High Risk of being Lost&apos; then &apos;At Risk&apos;&#10;ELSEIF [Calculation_2408088810329157684] = &apos;Restarted&apos;&#10;        or [Calculation_2408088810329157684] = &apos;Quick Restarted&apos;&#10;        or [Calculation_2408088810329157684] = &apos;Back From Dead&apos; then &apos;Restarted&apos;&#10;else [Calculation_2408088810329157684]&#10;end' />
              <aliases>
                <alias key='&quot;Decreasing&quot;' value='Active Decreasing' />
                <alias key='&quot;Increasing&quot;' value='Active Increasing' />
              </aliases>
            </column>
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[Chain_Name_in_system]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Count' caption='Restaurant Name' datatype='string' default-type='nominal' layered='true' name='[RestaurantName (Custom SQL Query4)]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[account_name]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[country]' pivot='key' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' user-datatype='string' visual-totals='Default' />
            <column-instance column='[merchant_id (Custom SQL Query4)]' derivation='CountD' name='[ctd:merchant_id (Custom SQL Query4):qk]' pivot='key' type='quantitative' />
            <column aggregation='Sum' datatype='integer' default-type='quantitative' layered='true' name='[first_month_flag]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default' />
            <column aggregation='Sum' datatype='real' default-type='quantitative' layered='true' name='[last_1_month_gmv]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default' />
            <column aggregation='Sum' datatype='real' default-type='quantitative' layered='true' name='[last_2_months_gmv]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default' />
            <column aggregation='Sum' datatype='real' default-type='quantitative' layered='true' name='[last_3_months_gmv]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default' />
            <column aggregation='Sum' datatype='real' default-type='quantitative' layered='true' name='[last_4_months_gmv]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[merchant_id (Custom SQL Query4)]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column-instance column='[Calculation_2408088810329313333]' derivation='None' name='[none:Calculation_2408088810329313333:nk]' pivot='key' type='nominal' />
            <column-instance column='[Chain_Name_in_system]' derivation='None' name='[none:Chain_Name_in_system:nk]' pivot='key' type='nominal' />
            <column-instance column='[RestaurantName (Custom SQL Query4)]' derivation='None' name='[none:RestaurantName (Custom SQL Query4):nk]' pivot='key' type='nominal' />
            <column-instance column='[account_name]' derivation='None' name='[none:account_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column-instance column='[year_month]' derivation='None' name='[none:year_month:nk]' pivot='key' type='nominal' />
            <column aggregation='Sum' datatype='real' default-type='quantitative' layered='true' name='[sales (Custom SQL Query4)]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[year_month]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
          </datasource-dependencies>
