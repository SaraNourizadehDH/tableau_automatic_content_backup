          <datasource-dependencies datasource='sqlproxy.0n3txnn0w1v3uv18dvc660hlykd6'>
            <column aggregation='Count' caption='Login Orders' datatype='integer' default-type='ordinal' layered='true' name='[Calculation_1696168272759255044]' pivot='key' role='dimension' type='ordinal' user-datatype='integer' visual-totals='Default'>
              <calculation class='tableau' formula='if [Customer_Type]=&apos;Login&apos; then [orders (Custom SQL Query7)] END' />
