            <groupfilter function='crossjoin' user:ui-action-filter='[Action1_8F338ABBF06844EEB6FABC6E991636F4]' user:ui-enumeration='all' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[Calculation_1075797400707383300]' />
