        <calculations>
          <calculation column='[Calculation_2408088810309914627]' formula='case  [country] when &quot;Australia&quot;  then [sales]/0.9004687&#10;when &quot;Singapore&quot; then [sales]&#10;when &quot;Malaysia&quot; then [sales]/0.30175252&#10;when &quot;Indonesia&quot; then [sales]/0.000089&#10;else [sales]&#10;END' />
          <calculation column='[Calculation_2408088810309984260]' formula='case  [country] when &quot;Australia&quot;  then [paid_gmv]/0.9004687&#10;when &quot;Singapore&quot; then [paid_gmv]&#10;when &quot;Malaysia&quot; then [paid_gmv]/0.30175252&#10;when &quot;Indonesia&quot; then [paid_gmv]/0.000089&#10;else [paid_gmv]&#10;END' />
          <calculation column='[Calculation_2408088810310078469]' formula='SUM([orders])/COUNTD([merchant_id])' />
