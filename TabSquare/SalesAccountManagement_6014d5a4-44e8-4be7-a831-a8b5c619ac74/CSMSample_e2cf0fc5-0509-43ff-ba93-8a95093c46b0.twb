      <column caption='New Customers %' datatype='real' name='[Calculation_8904742387262476296]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([new_customers])/ (sum([new_customers])+sum([repeat_customers]))' />
      </column>
      <column caption='Brand' datatype='string' name='[Chain_Name_in_system]' role='dimension' type='nominal' />
      <column caption='Login Customer Average Basket value ' datatype='real' name='[New Customer Average Basket value (copy) (copy)_6135098986499559448]' role='measure' type='quantitative'>
