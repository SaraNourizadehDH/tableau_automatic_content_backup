            <column-instance column='[Calculation_2327516596712427521]' derivation='Sum' name='[sum:Calculation_2327516596712427521:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2327516596712607746]' derivation='Sum' name='[sum:Calculation_2327516596712607746:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_838795447765372931]' derivation='Sum' name='[sum:Calculation_838795447765372931:qk]' pivot='key' type='quantitative' />
