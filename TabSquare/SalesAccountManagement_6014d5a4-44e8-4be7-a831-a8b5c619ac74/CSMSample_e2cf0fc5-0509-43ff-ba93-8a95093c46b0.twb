      <column caption='Year Month Week-4' datatype='boolean' name='[Calculation_1770759101335597059]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[week_start_date] &gt;= DATEADD(&apos;week&apos;, -4, DATETRUNC(&apos;week&apos;, TODAY()))&#13;&#10;AND [week_start_date] &lt;= DATETRUNC(&apos;week&apos;, TODAY())' />
      </column>
      <column caption='% Difference in Repeat Customer' datatype='real' name='[Calculation_1911778067292954631]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([repeat_customer]-[previous_repeat_customer])/[previous_repeat_customer]' />
      </column>
      <column caption='Login Order %' datatype='real' name='[Calculation_3169689761764847622]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([login_orders])/(ifnull(SUM([login_orders]),0)+ifnull(SUM([guest_orders]),0))' />
      </column>
      <column caption='New Customer Average Basket value' datatype='real' name='[Calculation_6135098986499014677]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([new_sales])/ sum([new_orders])' />
