      <column caption='Current Login %' datatype='real' name='[Calculation_3169689761761787909]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Current Week Login Sales (copy)_3169689761757020161])/ SUM([Current Week Login Sales (copy)_3169689761774481415])' />
