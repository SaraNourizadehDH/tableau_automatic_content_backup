      <column caption='Guest Average Basket value ' datatype='real' name='[New Customer Average Basket value (copy)_6135098986499547159]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([guest_sales])/ sum([guest_orders])' />
