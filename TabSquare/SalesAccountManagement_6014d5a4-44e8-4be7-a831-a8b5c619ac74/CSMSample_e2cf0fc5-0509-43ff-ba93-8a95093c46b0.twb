      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1ugkdnt16yz3mr18437nh0udt5y8].[ctd:Calculation_838795447835643927:qk]&quot;' value='Outlets with Decreasing GMV (&gt;15%)' />
          <alias key='&quot;[federated.1ugkdnt16yz3mr18437nh0udt5y8].[sum:Avg Resolution Time Hours (copy)_1422856022343630851:qk]&quot;' value='Mean Time to Resolution (Hours)' />
          <alias key='&quot;[federated.1ugkdnt16yz3mr18437nh0udt5y8].[sum:Calculation_6070148639805853699:qk]&quot;' value='Sales ' />
          <alias key='&quot;[federated.1ugkdnt16yz3mr18437nh0udt5y8].[sum:sales:qk]&quot;' value='Sales' />
          <alias key='&quot;[federated.1ugkdnt16yz3mr18437nh0udt5y8].[usr:Calculation_2327516596809973764:qk:1]&quot;' value='Week-over-Week Sales Change' />
        </aliases>
      </column>
      <column caption='Mean Time to Resolution (Hours)' datatype='real' datatype-customized='true' name='[Avg Resolution Time Hours (copy)_1422856022343630851]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOAT([avg_resolution_time_hours])' />
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([sales])) - LOOKUP(ZN(SUM([sales])), -1)) / ABS(LOOKUP(ZN(SUM([sales])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation2]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([sales])) - LOOKUP(ZN(SUM([sales])), -1)) / ABS(LOOKUP(ZN(SUM([sales])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Average Basket Value' datatype='real' name='[Calculation_1422856022334144513]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_6070148639805853699])/SUM([orders])' />
      </column>
      <column caption='Order Success Rate' datatype='real' name='[Calculation_1619607066829942785]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(ifnull([Success_order],0))/SUM(ifnull([sf_orders],0))' />
      </column>
      <column caption='Year Month Week-4' datatype='boolean' name='[Calculation_1770759101335183362]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[year_month_week] &gt;= DATEADD(&apos;week&apos;, -4, DATETRUNC(&apos;week&apos;, TODAY()))&#13;&#10;AND [year_month_week] &lt;= DATETRUNC(&apos;week&apos;, TODAY())-1' />
      </column>
      <column caption='Store Name' datatype='string' name='[Calculation_1796373311515058176]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([RestaurantName], [sfo_merchant_name])' />
      </column>
      <column caption='Issues Reported' datatype='integer' name='[Calculation_1807069379694415933]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([overall_ticket_count],0)' />
      </column>
      <column caption='dummy1' datatype='integer' name='[Calculation_1911778067285663744]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='gmv%&lt;-0.15 flag' datatype='boolean' name='[Calculation_2080381572327186470]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='({ FIXED [merchant_id], [year_month_week]: [Calculation_838795447835545622]}) &lt; -0.15' />
      </column>
      <column caption='Failed Orders' datatype='integer' name='[Calculation_2327516596712427521]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Failed_order],0)' />
      </column>
      <column caption='Success Orders' datatype='integer' name='[Calculation_2327516596712607746]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Success_order],0)' />
      </column>
      <column caption='GMV % Diff' datatype='real' name='[Calculation_2327516596809973764]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([Calculation_6070148639805853699])) - LOOKUP(ZN(SUM([Calculation_6070148639805853699])), -1)) / ABS(LOOKUP(ZN(SUM([Calculation_6070148639805853699])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Outlets with decreasing GMV &gt;15%' datatype='integer' name='[Calculation_2327516596810293253]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='if [Calculation_2327516596809973764]&lt;-0.15 then COUNTD([merchant_id]) END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='dummy' datatype='integer' name='[Calculation_2569303619412811776]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Error Rate Color' datatype='string' name='[Calculation_2569303619415896065]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if [Success % (copy)_1422856022333911040] &lt;=0.005 then &apos;green&apos;&#13;&#10;elseif [Success % (copy)_1422856022333911040] &lt;=0.01 then &apos;Orange&apos; &#13;&#10;elseif [Success % (copy)_1422856022333911040] &gt;0.01  then &apos;Red&apos;&#13;&#10;else &apos;black&apos;&#13;&#10;END' />
      </column>
      <column caption='NO GMV' datatype='string' name='[Calculation_3030922610102579200]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [no_gmv]=&quot;no gmv&quot; then [merchant_id] end' />
      </column>
      <column caption='chain filter excludes' datatype='string' name='[Calculation_4419720103783243783]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Chain_Name_in_system]' />
      </column>
      <column caption='Store Performance Week' datatype='string' name='[Calculation_5380816419015720997]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Week of &quot; +&#13;&#10;DATENAME(&apos;month&apos;, DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;week&apos;, TODAY()))) + &quot; &quot; +&#13;&#10;STR(DAY(DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;week&apos;, TODAY())))) + &quot;, &quot; +&#13;&#10;STR(YEAR(DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;week&apos;, TODAY())))) +&#13;&#10;&quot; – &quot; +&#13;&#10;DATENAME(&apos;month&apos;, DATEADD(&apos;day&apos;, 6, DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;week&apos;, TODAY())))) + &quot; &quot; +&#13;&#10;STR(DAY(DATEADD(&apos;day&apos;, 6, DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;week&apos;, TODAY()))))) + &quot;, &quot; +&#13;&#10;STR(YEAR(DATEADD(&apos;day&apos;, 6, DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;week&apos;, TODAY())))))' />
      </column>
      <column caption='Conversion Factor' datatype='real' name='[Calculation_6070148639804682242]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='If [country]=&apos;Indonesia&apos;&#9;then 0.00008862&#10;elseif [country]=&apos;Others&apos; then&#9;1.0&#9;&#10;elseif [country]=&apos;Singapore&apos; then&#9;1.0&#9;&#10;elseif [country]=&apos;Brunei&apos; then&#9;1.0&#9;&#10;elseif [country]=&apos;Jordan&apos; then&#9;2.03&#9;&#10;elseif [country]=&apos;United Kingdom&apos; then&#9;1.86985&#9;&#10;elseif [country]=&apos;New Zealand&apos; then&#9;0.92&#9;&#10;elseif [country]=&apos;Malaysia&apos; then&#9;0.30175252&#9;&#10;elseif [country]=&apos;Philippines&apos; then&#9;0.028&#9;&#10;elseif [country]=&apos;Sweden&apos; then&#9;0.13&#9;&#10;elseif [country]=&apos;Taiwan&apos; then&#9;0.047&#9;&#10;elseif [country]=&apos;United Arab Emirates&apos; then&#9;0.37&#9;&#10;elseif [country]=&apos;Hong Kong&apos; then&#9;0.17&#9;&#10;elseif [country]=&apos;Andorra&apos; then&#9;1.61&#9;&#10;elseif [country]=&apos;Thailand&apos; then 0.041&#10;elseif [country]=&apos;Australia&apos; then&#9;0.9004687&#10;END' />
      </column>
      <column caption='Converted Sales' datatype='real' name='[Calculation_6070148639805853699]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[sales]/[Calculation_6070148639804682242]' />
      </column>
      <column caption='Year Month Week-1' datatype='boolean' name='[Calculation_6135098985086844935]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[year_month_week] &gt;= DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;week&apos;, TODAY()))&#10;AND [year_month_week] &lt; DATETRUNC(&apos;week&apos;, TODAY())' />
      </column>
      <column caption='Current week sales' datatype='real' name='[Calculation_7718114276816859198]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [year_month_week] &gt;= DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;week&apos;, TODAY()))&#10;AND [year_month_week] &lt; DATETRUNC(&apos;week&apos;, TODAY()) then [Calculation_6070148639805853699] END' />
      </column>
      <column caption='Previous week sales' datatype='real' name='[Calculation_7718114276817006655]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [year_month_week] &gt;= DATEADD(&apos;week&apos;, -2, DATETRUNC(&apos;week&apos;, TODAY()))&#10;AND [year_month_week] &lt; DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;week&apos;, TODAY())) then [Calculation_6070148639805853699] END' />
      </column>
