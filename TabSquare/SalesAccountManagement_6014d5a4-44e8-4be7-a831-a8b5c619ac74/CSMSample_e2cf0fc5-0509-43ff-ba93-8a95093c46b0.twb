    <worksheet name='CSM restaurant Level (Updated)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff'>Store Performance</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='9'><![CDATA[<[federated.1ugkdnt16yz3mr18437nh0udt5y8].[attr:Calculation_5380816419015720997:nk]>]]></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='csm_weekonweek Main' name='federated.1ugkdnt16yz3mr18437nh0udt5y8' />
            <datasource caption='Guest Vs Login' name='federated.13ybqdu06e6hi4178fbfw0up42hi' />
          </datasources>
          <datasource-dependencies datasource='federated.13ybqdu06e6hi4178fbfw0up42hi'>
            <column caption='Current Login %' datatype='real' name='[Calculation_3169689761761787909]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Current Week Login Sales (copy)_3169689761757020161])/ SUM([Current Week Login Sales (copy)_3169689761774481415])' />
            </column>
            <column caption='Current Week Login Orders' datatype='integer' name='[Current Week Login Sales (copy)_3169689761757020161]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [start_date] &gt;= DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;week&apos;, TODAY()))&#10;AND [start_date] &lt; DATETRUNC(&apos;week&apos;, TODAY()) then ([login_orders]) END' />
            </column>
            <column caption='Current Week Total Orders' datatype='integer' name='[Current Week Login Sales (copy)_3169689761774481415]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [start_date] &gt;= DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;week&apos;, TODAY()))&#10;AND [start_date] &lt; DATETRUNC(&apos;week&apos;, TODAY()) then ([total_orders]) END' />
            </column>
            <column datatype='integer' name='[login_orders]' role='measure' type='quantitative' />
            <column datatype='date' name='[start_date]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[total_orders]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_3169689761761787909]' derivation='User' name='[usr:Calculation_3169689761761787909:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ugkdnt16yz3mr18437nh0udt5y8'>
            <column caption='Average Basket Value' datatype='real' name='[Calculation_1422856022334144513]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_6070148639805853699])/SUM([orders])' />
            </column>
            <column caption='Store Name' datatype='string' name='[Calculation_1796373311515058176]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([RestaurantName], [sfo_merchant_name])' />
            </column>
            <column caption='Failed Orders' datatype='integer' name='[Calculation_2327516596712427521]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([Failed_order],0)' />
            </column>
            <column caption='dummy' datatype='integer' name='[Calculation_2569303619412811776]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Error Rate Color' datatype='string' name='[Calculation_2569303619415896065]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if [Success % (copy)_1422856022333911040] &lt;=0.005 then &apos;green&apos;&#13;&#10;elseif [Success % (copy)_1422856022333911040] &lt;=0.01 then &apos;Orange&apos; &#13;&#10;elseif [Success % (copy)_1422856022333911040] &gt;0.01  then &apos;Red&apos;&#13;&#10;else &apos;black&apos;&#13;&#10;END' />
            </column>
            <column caption='Store Performance Week' datatype='string' name='[Calculation_5380816419015720997]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;Week of &quot; +&#13;&#10;DATENAME(&apos;month&apos;, DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;week&apos;, TODAY()))) + &quot; &quot; +&#13;&#10;STR(DAY(DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;week&apos;, TODAY())))) + &quot;, &quot; +&#13;&#10;STR(YEAR(DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;week&apos;, TODAY())))) +&#13;&#10;&quot; – &quot; +&#13;&#10;DATENAME(&apos;month&apos;, DATEADD(&apos;day&apos;, 6, DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;week&apos;, TODAY())))) + &quot; &quot; +&#13;&#10;STR(DAY(DATEADD(&apos;day&apos;, 6, DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;week&apos;, TODAY()))))) + &quot;, &quot; +&#13;&#10;STR(YEAR(DATEADD(&apos;day&apos;, 6, DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;week&apos;, TODAY())))))' />
            </column>
            <column caption='Conversion Factor' datatype='real' name='[Calculation_6070148639804682242]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='If [country]=&apos;Indonesia&apos;&#9;then 0.00008862&#10;elseif [country]=&apos;Others&apos; then&#9;1.0&#9;&#10;elseif [country]=&apos;Singapore&apos; then&#9;1.0&#9;&#10;elseif [country]=&apos;Brunei&apos; then&#9;1.0&#9;&#10;elseif [country]=&apos;Jordan&apos; then&#9;2.03&#9;&#10;elseif [country]=&apos;United Kingdom&apos; then&#9;1.86985&#9;&#10;elseif [country]=&apos;New Zealand&apos; then&#9;0.92&#9;&#10;elseif [country]=&apos;Malaysia&apos; then&#9;0.30175252&#9;&#10;elseif [country]=&apos;Philippines&apos; then&#9;0.028&#9;&#10;elseif [country]=&apos;Sweden&apos; then&#9;0.13&#9;&#10;elseif [country]=&apos;Taiwan&apos; then&#9;0.047&#9;&#10;elseif [country]=&apos;United Arab Emirates&apos; then&#9;0.37&#9;&#10;elseif [country]=&apos;Hong Kong&apos; then&#9;0.17&#9;&#10;elseif [country]=&apos;Andorra&apos; then&#9;1.61&#9;&#10;elseif [country]=&apos;Thailand&apos; then 0.041&#10;elseif [country]=&apos;Australia&apos; then&#9;0.9004687&#10;END' />
            </column>
            <column caption='Converted Sales' datatype='real' name='[Calculation_6070148639805853699]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[sales]/[Calculation_6070148639804682242]' />
            </column>
            <column caption='Current week sales' datatype='real' name='[Calculation_7718114276816859198]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [year_month_week] &gt;= DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;week&apos;, TODAY()))&#10;AND [year_month_week] &lt; DATETRUNC(&apos;week&apos;, TODAY()) then [Calculation_6070148639805853699] END' />
            </column>
            <column caption='Previous week sales' datatype='real' name='[Calculation_7718114276817006655]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [year_month_week] &gt;= DATEADD(&apos;week&apos;, -2, DATETRUNC(&apos;week&apos;, TODAY()))&#10;AND [year_month_week] &lt; DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;week&apos;, TODAY())) then [Calculation_6070148639805853699] END' />
            </column>
            <column caption='Sales %' datatype='real' name='[Calculation_7718114276817150016]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ifnull(SUM([Calculation_7718114276816859198]),0)- ifnull(SUM([Calculation_7718114276817006655]),0))/SUM([Calculation_7718114276817006655])' />
            </column>
            <column caption='Current Failed Orders' datatype='integer' name='[Calculation_7718114276817584194]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [year_month_week] &gt;= DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;week&apos;, TODAY()))&#10;AND [year_month_week] &lt; DATETRUNC(&apos;week&apos;, TODAY()) then [Calculation_2327516596712427521] END' />
            </column>
            <column caption='Current Success Orders' datatype='integer' name='[Calculation_7718114276817678403]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [year_month_week] &gt;= DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;week&apos;, TODAY()))&#10;AND [year_month_week] &lt; DATETRUNC(&apos;week&apos;, TODAY()) then [sf_orders] END' />
            </column>
            <column caption='Current Error Rate %' datatype='real' name='[Calculation_7718114276817797188]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(ifnull([Calculation_7718114276817584194],0))/SUM(ifnull([Calculation_7718114276817678403],0))' />
            </column>
            <column caption='Previous Failed Orders' datatype='integer' name='[Calculation_7718114276817973317]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [year_month_week] &gt;= DATEADD(&apos;week&apos;, -2, DATETRUNC(&apos;week&apos;, TODAY()))&#10;AND [year_month_week] &lt; DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;week&apos;, TODAY())) then [Calculation_2327516596712427521] END' />
            </column>
            <column caption='Previous Success Orders' datatype='integer' name='[Calculation_7718114276818227270]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [year_month_week] &gt;= DATEADD(&apos;week&apos;, -2, DATETRUNC(&apos;week&apos;, TODAY()))&#10;AND [year_month_week] &lt; DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;week&apos;, TODAY())) then [sf_orders] END' />
            </column>
            <column caption='Previous Error Rate %' datatype='real' name='[Calculation_7718114276818321479]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(ifnull([Calculation_7718114276817973317],0))/SUM(ifnull([Calculation_7718114276818227270],0))' />
            </column>
            <column caption='Error Rate % Difference' datatype='real' name='[Calculation_7718114276818550856]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ifnull([Calculation_7718114276817797188],0)-ifnull([Calculation_7718114276818321479],0))' />
            </column>
            <column caption='Current ABV' datatype='real' name='[Calculation_7718114276819533899]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_7718114276816859198])/SUM([Current week sales (copy)_7718114276819353674])' />
            </column>
            <column caption='Merchant_Week_GMV' datatype='real' name='[Calculation_8904742387250966528]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [merchant_id], [year_month_week] : SUM([Calculation_6070148639805853699]) }' />
            </column>
            <column caption='GMV Percentile Rank' datatype='real' name='[Calculation_8904742387252768772]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK_PERCENTILE(SUM([Calculation_8904742387250966528]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Sales Classification' datatype='string' name='[Calculation_8904742387253252102]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_8904742387252768772] &lt;= 0.33 THEN &quot;Below Average&quot;&#10;ELSEIF [Calculation_8904742387252768772] &lt;= 0.66 THEN &quot;Average&quot;&#10;ELSE &quot;Above Average&quot;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Brand' datatype='string' name='[Chain_Name_in_system]' role='dimension' type='nominal' />
            <column caption='Current week orders' datatype='integer' name='[Current week sales (copy)_7718114276819353674]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [year_month_week] &gt;= DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;week&apos;, TODAY()))&#10;AND [year_month_week] &lt; DATETRUNC(&apos;week&apos;, TODAY()) then [orders] END' />
            </column>
            <column caption='Error Rate % Difference (copy)' datatype='string' name='[Error Rate % Difference (copy)_8051451024739958789]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (IFNULL([Calculation_7718114276817797188], 0) - IFNULL([Calculation_7718114276818321479], 0)) &gt; 0 THEN&#10;    &quot;+&quot; + STR(ROUND((IFNULL([Calculation_7718114276817797188], 0) - IFNULL([Calculation_7718114276818321479], 0)) * 100, 2)) + &quot;%&quot;&#10;ELSE&#10;    STR(ROUND((IFNULL([Calculation_7718114276817797188], 0) - IFNULL([Calculation_7718114276818321479], 0)) * 100, 2)) + &quot;%&quot;&#10;END' />
            </column>
            <column caption='Error Rate Diff Color ' datatype='string' name='[Error Rate Color (copy)_1376694162336550912]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_7718114276818550856]&gt;0 then &apos;Red&apos;&#13;&#10;elseif [Calculation_7718114276818550856] &lt;=0  then &apos;Green&apos;&#13;&#10;END' />
            </column>
