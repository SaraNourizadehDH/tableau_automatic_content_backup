      <column caption='Current Week Login Sales' datatype='real' name='[Calculation_3169689761756893184]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [start_date] &gt;= DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;week&apos;, TODAY()))&#10;AND [start_date] &lt; DATETRUNC(&apos;week&apos;, TODAY()) then ([login_sales]) END' />
