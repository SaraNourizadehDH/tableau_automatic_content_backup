    <worksheet name='CSM restaurant Level (3)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff'>Store Performance</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='9'><![CDATA[<[federated.1ugkdnt16yz3mr18437nh0udt5y8].[attr:Calculation_5380816419015720997:nk]>]]></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='csm_weekonweek Main' name='federated.1ugkdnt16yz3mr18437nh0udt5y8' />
          </datasources>
          <datasource-dependencies datasource='federated.1ugkdnt16yz3mr18437nh0udt5y8'>
            <column caption='Average Basket Value' datatype='real' name='[Calculation_1422856022334144513]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_6070148639805853699])/SUM([orders])' />
            </column>
            <column caption='Store Name' datatype='string' name='[Calculation_1796373311515058176]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([RestaurantName], [sfo_merchant_name])' />
            </column>
            <column caption='Failed Orders' datatype='integer' name='[Calculation_2327516596712427521]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([Failed_order],0)' />
            </column>
            <column caption='Error Rate Color' datatype='string' name='[Calculation_2569303619415896065]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if [Success % (copy)_1422856022333911040] &lt;=0.005 then &apos;green&apos;&#13;&#10;elseif [Success % (copy)_1422856022333911040] &lt;=0.01 then &apos;Orange&apos; &#13;&#10;elseif [Success % (copy)_1422856022333911040] &gt;0.01  then &apos;Red&apos;&#13;&#10;else &apos;black&apos;&#13;&#10;END' />
            </column>
            <column caption='Store Performance Week' datatype='string' name='[Calculation_5380816419015720997]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;Week of &quot; +&#13;&#10;DATENAME(&apos;month&apos;, DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;week&apos;, TODAY()))) + &quot; &quot; +&#13;&#10;STR(DAY(DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;week&apos;, TODAY())))) + &quot;, &quot; +&#13;&#10;STR(YEAR(DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;week&apos;, TODAY())))) +&#13;&#10;&quot; – &quot; +&#13;&#10;DATENAME(&apos;month&apos;, DATEADD(&apos;day&apos;, 6, DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;week&apos;, TODAY())))) + &quot; &quot; +&#13;&#10;STR(DAY(DATEADD(&apos;day&apos;, 6, DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;week&apos;, TODAY()))))) + &quot;, &quot; +&#13;&#10;STR(YEAR(DATEADD(&apos;day&apos;, 6, DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;week&apos;, TODAY())))))' />
            </column>
            <column caption='Conversion Factor' datatype='real' name='[Calculation_6070148639804682242]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='If [country]=&apos;Indonesia&apos;&#9;then 0.00008862&#10;elseif [country]=&apos;Others&apos; then&#9;1.0&#9;&#10;elseif [country]=&apos;Singapore&apos; then&#9;1.0&#9;&#10;elseif [country]=&apos;Brunei&apos; then&#9;1.0&#9;&#10;elseif [country]=&apos;Jordan&apos; then&#9;2.03&#9;&#10;elseif [country]=&apos;United Kingdom&apos; then&#9;1.86985&#9;&#10;elseif [country]=&apos;New Zealand&apos; then&#9;0.92&#9;&#10;elseif [country]=&apos;Malaysia&apos; then&#9;0.30175252&#9;&#10;elseif [country]=&apos;Philippines&apos; then&#9;0.028&#9;&#10;elseif [country]=&apos;Sweden&apos; then&#9;0.13&#9;&#10;elseif [country]=&apos;Taiwan&apos; then&#9;0.047&#9;&#10;elseif [country]=&apos;United Arab Emirates&apos; then&#9;0.37&#9;&#10;elseif [country]=&apos;Hong Kong&apos; then&#9;0.17&#9;&#10;elseif [country]=&apos;Andorra&apos; then&#9;1.61&#9;&#10;elseif [country]=&apos;Thailand&apos; then 0.041&#10;elseif [country]=&apos;Australia&apos; then&#9;0.9004687&#10;END' />
            </column>
            <column caption='Converted Sales' datatype='real' name='[Calculation_6070148639805853699]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[sales]/[Calculation_6070148639804682242]' />
            </column>
            <column caption='Year Month Week-1' datatype='boolean' name='[Calculation_6135098985086844935]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[year_month_week] &gt;= DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;week&apos;, TODAY()))&#10;AND [year_month_week] &lt; DATETRUNC(&apos;week&apos;, TODAY())' />
            </column>
            <column caption='Merchant_Week_GMV' datatype='real' name='[Calculation_8904742387250966528]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [merchant_id], [year_month_week] : SUM([Calculation_6070148639805853699]) }' />
            </column>
            <column caption='GMV Percentile Rank' datatype='real' name='[Calculation_8904742387252768772]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK_PERCENTILE(SUM([Calculation_8904742387250966528]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Sales Classification' datatype='string' name='[Calculation_8904742387253252102]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_8904742387252768772] &lt;= 0.33 THEN &quot;Below Average&quot;&#10;ELSEIF [Calculation_8904742387252768772] &lt;= 0.66 THEN &quot;Average&quot;&#10;ELSE &quot;Above Average&quot;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Brand' datatype='string' name='[Chain_Name_in_system]' role='dimension' type='nominal' />
            <column caption='Failed order' datatype='integer' name='[Failed_order]' role='measure' type='quantitative' />
            <column datatype='string' name='[RestaurantName]' role='dimension' type='nominal' />
            <column caption='Error Rate % ' datatype='real' name='[Success % (copy)_1422856022333911040]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(ifnull([Calculation_2327516596712427521],0))/SUM(ifnull([sf_orders],0))' />
            </column>
            <column caption='Account Name' datatype='string' name='[account_name]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_5380816419015720997]' derivation='Attribute' name='[attr:Calculation_5380816419015720997:nk]' pivot='key' type='nominal' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Merchant Id' datatype='string' name='[merchant_id]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1796373311515058176]' derivation='None' name='[none:Calculation_1796373311515058176:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_6135098985086844935]' derivation='None' name='[none:Calculation_6135098985086844935:nk]' pivot='key' type='nominal' />
            <column-instance column='[Chain_Name_in_system]' derivation='None' name='[none:Chain_Name_in_system:nk]' pivot='key' type='nominal' />
            <column-instance column='[account_name]' derivation='None' name='[none:account_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column caption='Orders' datatype='integer' name='[orders]' role='measure' type='quantitative' />
            <column caption='Sales' datatype='real' name='[sales]' role='measure' type='quantitative' />
            <column caption='Sf Orders' datatype='integer' name='[sf_orders]' role='measure' type='quantitative' />
            <column caption='Sfo Merchant Name' datatype='string' name='[sfo_merchant_name]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_6070148639805853699]' derivation='Sum' name='[sum:Calculation_6070148639805853699:qk]' pivot='key' type='quantitative' />
