            <column-instance column='[Calculation_2569303619415896065]' derivation='User' name='[usr:Calculation_2569303619415896065:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_8904742387253252102]' derivation='User' name='[usr:Calculation_8904742387253252102:nk:1]' pivot='key' type='nominal'>
              <table-calc ordering-type='Columns' />
