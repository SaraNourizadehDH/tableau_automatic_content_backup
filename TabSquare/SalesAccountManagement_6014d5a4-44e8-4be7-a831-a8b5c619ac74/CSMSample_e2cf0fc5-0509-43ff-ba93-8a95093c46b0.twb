      <column caption='Repeat Customer Average Basket value' datatype='real' name='[New Customer Average Basket value (copy)_6135098986499272726]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([repeat_sales])/ sum([repeat_orders])' />
