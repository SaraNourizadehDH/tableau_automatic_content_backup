              <calculation class='tableau' formula='{ FIXED [m1 (Custom SQL Query10)]: sum(if [Calculation_1075797400794873880]=True then [Calculation_1075797400855040028] END)}' />
            </column>
            <column caption='Buckets' datatype='string' name='[Calculation_1075797400781434900]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] =&quot;Week&quot; then &#10;if [sales for whole month (copy)_1526861070919933952]&gt;=0 and [sales for whole month (copy)_1526861070919933952]&lt; 1000 then &quot;Low&quot;&#13;&#10;ELSEIF [sales for whole month (copy)_1526861070919933952]&gt;=1000 and [sales for whole month (copy)_1526861070919933952]&lt; 7000 then &quot;Medium&quot;&#13;&#10;ELSEIF [sales for whole month (copy)_1526861070919933952]&gt;=7000  then &quot;High&quot;&#13;&#10;END&#10;&#10;ELSEIF  [Parameters].[Parameter 1]=&quot;Month&quot; then &#10;if [Calculation_1075797400781545493]&gt;=0 and [Calculation_1075797400781545493]&lt; 20000 then &quot;Low&quot;&#10;ELSEIF [Calculation_1075797400781545493]&gt;=20000 and [Calculation_1075797400781545493]&lt; 100000 then &quot;Medium&quot;&#10;ELSEIF [Calculation_1075797400781545493]&gt;=100000  then &quot;High&quot;&#10;END&#10;&#10;END' />
            </column>
            <column caption='sales for whole month' datatype='real' name='[Calculation_1075797400781545493]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1075797400781066258]*30' />
            </column>
            <column caption='Date Filter' datatype='boolean' name='[Calculation_1075797400794873880]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if  [Parameters].[Parameter 1]=&quot;Week&quot; then &#10;[order_date]&lt;=[coming_sunday]&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Month&quot; then&#10;[order_date]&lt;=[last_date] END' />
            </column>
            <column caption='Fixed Date Diff Max' datatype='integer' name='[Calculation_1075797400835153946]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [m1 (Custom SQL Query10)]: MAX(if [Calculation_1075797400794873880]=True then [Calculation_5230931027999526914] END)}' />
            </column>
            <column caption='Converted Sales' datatype='real' name='[Calculation_1075797400855040028]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [mm_country (Custom SQL Query10)] == &apos;Singapore&apos; THEN [Sales (Custom SQL Query10) #1]&#13;&#10;ELSEIF [mm_country (Custom SQL Query10)] == &apos;Australia&apos; THEN [Sales (Custom SQL Query10) #1]&#13;&#10;ELSEIF [mm_country (Custom SQL Query10)] == &apos;Indonesia&apos; THEN [Sales (Custom SQL Query10) #1] * 0.000092&#13;&#10;ELSEIF [mm_country (Custom SQL Query10)] == &apos;Malayasia&apos; THEN [Sales (Custom SQL Query10) #1] * 0.33&#13;&#10;ELSE [Sales (Custom SQL Query10) #1] END' />
            </column>
            <column caption='date_diff' datatype='integer' name='[Calculation_5230931027999526914]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1]=&quot;Month&quot; then [date_diff_month]&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Week&quot; then [date_diff_week] END' />
            </column>
            <column caption='Low Buckets' datatype='string' name='[Calculation_778559826681651201]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_1075797400781434900] =&quot;Low&quot; then [m1 (Custom SQL Query10)] END' />
            </column>
            <column caption='Medium Buckets' datatype='string' name='[Low Buckets (copy) (copy)_778559826682298372]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_1075797400781434900] =&quot;Medium&quot; then [m1 (Custom SQL Query10)] END' />
            </column>
            <column caption='High Buckets' datatype='string' name='[Low Buckets (copy)_778559826682290179]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_1075797400781434900] =&quot;High&quot; then [m1 (Custom SQL Query10)] END' />
            </column>
            <column caption='total buckets' datatype='integer' name='[Medium Buckets (copy)_778559826682421253]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='COUNTD([m1 (Custom SQL Query10)])' />
            </column>
            <column datatype='string' name='[Name_of_Account_Manager (Custom SQL Query)]' role='dimension' type='nominal' />
            <column datatype='real' name='[Sales (Custom SQL Query10) #1]' role='measure' type='quantitative' />
            <column caption='Time interval (copy)' datatype='string' name='[Time interval (copy)_4311915232973570049]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[year_month_week]' />
            </column>
            <column datatype='string' name='[account_name (Custom SQL Query) #1]' role='dimension' type='nominal' />
            <column datatype='date' name='[coming_sunday]' role='dimension' type='ordinal' />
            <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[Calculation_778559826681651201]' derivation='CountD' name='[ctd:Calculation_778559826681651201:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Low Buckets (copy) (copy)_778559826682298372]' derivation='CountD' name='[ctd:Low Buckets (copy) (copy)_778559826682298372:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Low Buckets (copy)_778559826682290179]' derivation='CountD' name='[ctd:Low Buckets (copy)_778559826682290179:qk]' pivot='key' type='quantitative' />
            <column datatype='integer' name='[date_diff_month]' role='measure' type='quantitative' />
            <column datatype='integer' name='[date_diff_week]' role='measure' type='quantitative' />
            <column datatype='date' name='[last_date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[m1 (Custom SQL Query10)]' role='dimension' type='nominal' />
            <column datatype='string' name='[mm_country (Custom SQL Query10)]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[Calculation_1075797400794873880]' derivation='None' name='[none:Calculation_1075797400794873880:nk]' pivot='key' type='nominal' />
            <column-instance column='[Name_of_Account_Manager (Custom SQL Query)]' derivation='None' name='[none:Name_of_Account_Manager (Custom SQL Query):nk]' pivot='key' type='nominal' />
            <column-instance column='[Time interval (copy)_4311915232973570049]' derivation='None' name='[none:Time interval (copy)_4311915232973570049:nk]' pivot='key' type='nominal' />
            <column-instance column='[account_name (Custom SQL Query) #1]' derivation='None' name='[none:account_name (Custom SQL Query) #1:nk]' pivot='key' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column datatype='date' name='[order_date]' role='dimension' type='ordinal' />
            <column caption='sales for whole week' datatype='real' name='[sales for whole month (copy)_1526861070919933952]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1075797400781066258]*7' />
            </column>
            <column-instance column='[Medium Buckets (copy)_778559826682421253]' derivation='User' name='[usr:Medium Buckets (copy)_778559826682421253:qk]' pivot='key' type='quantitative' />
            <column datatype='string' datatype-customized='true' name='[year_month_week]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0xgukxt059r9i61ahck5g1kpil21].[:Measure Names]'>
            <groupfilter function='union' user:op='manual'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0xgukxt059r9i61ahck5g1kpil21].[usr:Medium Buckets (copy)_778559826682421253:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0xgukxt059r9i61ahck5g1kpil21].[ctd:Calculation_778559826681651201:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0xgukxt059r9i61ahck5g1kpil21].[ctd:Low Buckets (copy) (copy)_778559826682298372:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0xgukxt059r9i61ahck5g1kpil21].[ctd:Low Buckets (copy)_778559826682290179:qk]&quot;' />
