            <groupfilter function='level-members' level='[none:Calculation_1075797400707383300:nk]' user:ui-enumeration='all' user:ui-exclude='true' user:ui-marker='enumerate' />
          </filter>
          <manual-sort column='[federated.0xgukxt059r9i61ahck5g1kpil21].[none:Calculation_1075797400707383300:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;Increasing&quot;</bucket>
              <bucket>&quot;Decreasing&quot;</bucket>
              <bucket>&quot;Stable&quot;</bucket>
              <bucket>&quot;Not Active&quot;</bucket>
            </dictionary>
          </manual-sort>
          <filter class='categorical' column='[federated.0xgukxt059r9i61ahck5g1kpil21].[none:Calculation_5230931027982954496:nk]' filter-group='3'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:Calculation_5230931027982954496:nk]' member='&quot;2024-04&quot;' />
              <groupfilter function='member' level='[none:Calculation_5230931027982954496:nk]' member='&quot;2024-05&quot;' />
              <groupfilter function='member' level='[none:Calculation_5230931027982954496:nk]' member='&quot;2024-06&quot;' />
            </groupfilter>
