        <calculation class='tableau' formula='IFNULL(COUNTD([Calculation_1977221000851288086]),0)+IFNULL(COUNTD([finance_ticket_new (copy)_1977221000852230170]),0)+IFNULL(COUNTD([implementation_ticket_new (copy)_1977221000852975646]),0)+IFNULL(COUNTD([payment_support_ticket (copy)_1977221000854065187]),0)+IFNULL(COUNTD([Calculation_1977221000854364200]),0)' />
      </column>
      <column caption='others_overall_sum_reso' datatype='integer' name='[Calculation_1977221000854577194]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(SUM([finance_reso (copy)_1977221000851120147]),0)+IFNULL(SUM([finance_reso_new (copy)_1977221000852217880]),0)+IFNULL(SUM([implementation_reso_new (copy)_1977221000852959260]),0)+IFNULL(SUM([payment_support_reso (copy)_1977221000853815328]),0)+IFNULL(SUM([Calculation_1977221000854208549]),0)' />
      </column>
      <column caption='others_average_resolution_time' datatype='real' name='[Calculation_1977221000854650923]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1977221000854577194]/[Calculation_1977221000854507561]' />
      </column>
      <column caption='GMV in local' datatype='real' name='[Calculation_246361031159136256]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case  [country] when &quot;Australia&quot;  then [sales]/0.9004687&#10;when &quot;Singapore&quot; then [sales]&#10;when &quot;Malaysia&quot; then [sales]/0.30175252&#10;when &quot;Indonesia&quot; then [sales]/0.000089&#10;else [sales]&#10;END' />
      </column>
      <column caption='Paid_Gmv in local' datatype='real' name='[Calculation_246361031160545281]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case  [country] when &quot;Australia&quot;  then [paid_gmv]/0.9004687&#10;when &quot;Singapore&quot; then [paid_gmv]&#10;when &quot;Malaysia&quot; then [paid_gmv]/0.30175252&#10;when &quot;Indonesia&quot; then [paid_gmv]/0.000089&#10;else [paid_gmv]&#10;END' />
      </column>
      <column caption='Calculation2' datatype='boolean' name='[Calculation_2635872446526660609]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[month_year_created]=[month_year]' />
      </column>
      <column caption='abv' datatype='real' name='[Calculation_2635872446706798599]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_246361031159136256])/SUM([orders])' />
      </column>
      <column caption='GMV/Outlet' datatype='real' name='[Calculation_2635872446706921480]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sales])/COUNTD([merchant_id (Custom SQL Query)])' />
      </column>
      <column caption='Paid GMV' datatype='real' name='[Calculation_2635872446707298314]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if  CONTAINS(lower([payment_type]),&apos;razer&apos;) OR&#10;CONTAINS(lower([payment_type]),&apos;stripe&apos;) OR&#10;CONTAINS(lower([payment_type]),&apos;rapyd&apos;) OR&#10;CONTAINS(lower([payment_type]),&apos;checkout&apos;) OR&#10;CONTAINS(lower([payment_type]),&apos;g_pay&apos;)&#10;THEN [sales] END )' />
      </column>
      <column caption='Calculation3' datatype='boolean' name='[Calculation_2635872446722297867]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[country]=[country_new]' />
      </column>
      <column caption='win_rate' datatype='integer' name='[Calculation_2635872446734131212]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [name (group)]= &quot;proposal made &amp; targeting closure&quot; and [status]=&quot;won&quot; then id end' />
      </column>
      <column caption='Total Deducted Cost' datatype='real' name='[Calculation_401101891435012096]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ifnull(SUM([cost_of_hardware_acc]),0)+&#13;&#10;ifnull(SUM([other_costs_acc]),0)+&#13;&#10;ifnull(SUM([resellers_costs_acc]),0)&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;///[cost_of_hardware]+[cost_of_setup]+[other_costs]+[resellers_costs]+[tcc_oat_fee]+[total_stripe_cost]///' />
      </column>
      <column caption='Total Rev' datatype='real' name='[Calculation_401101891435864066]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//sum([Recurring SaaS Fee])+[Total Payment Gateway Revenue New]+sum([one_time_revenue_acc])+sum([cos_tcc_oat_fee_refund_acc])+sum([total_stripe_cost_acc])&#13;&#10;&#13;&#10;&#13;&#10;//SUM([Total revenue]) + sum([cos_tcc_oat_fee_refund_acc])&#10;&#10;ifnull(sum([recurring_revenue_acc]),0)&#10;+ifnull([Total Payment Gateway Revenue(minus cost) (copy)_5936096161049804800],0)&#10;+ifnull(sum([one_time_revenue_acc]),0)&#10;+ifnull(sum([deferred_revenue_acc]),0)' />
      </column>
      <column caption='Net Revenue' datatype='real' name='[Calculation_401101891437056003]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ifnull(sum([Calculation_5097230416282984451]),0)+ifnull(([Calculation_401101891435012096]),0)&#13;&#10;//sum([Recurring SaaS Fee]) +sum([one_time_revenue_acc])+  ([Total Deducted Cost]) + [Total Payment Gateway Revenue New]' />
      </column>
      <column caption='Month' datatype='string' name='[Calculation_4311915232969408512]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
      </column>
      <column caption='Stripe cost' datatype='real' name='[Calculation_46443398551068674]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE  [Country (Custom SQL Query5) #1] when &apos;Australia&apos; THEN 0.013*stripe_revenue_und_15_acc + 0.05*stripe_orders_und_15_acc + 0.01*(stripe_revenue_acc - stripe_revenue_und_15_acc) + 0.10*(stripe_orders_acc-stripe_orders_und_15_acc)&#10;     WHEN  &apos;Singapore&apos; THEN 0.018*stripe_revenue_und_15_acc + 0.07*stripe_orders_und_15_acc + 0.017*(stripe_revenue_acc - stripe_revenue_und_15_acc) + 0.07*(stripe_orders_acc-stripe_orders_und_15_acc)&#10;     WHEN  &apos;Malaysia&apos; THEN (0.015*stripe_revenue_acc + 0.10*0.33 *stripe_orders_acc)&#10;     ELSE 0 &#10;&#10;END' />
      </column>
      <column caption='Revenue-Stripe' datatype='real' name='[Calculation_46443398551851011]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([converted_revenue_acc])-Sum([Calculation_46443398551068674])' />
      </column>
      <column caption='Recurring_revenue' datatype='real' name='[Calculation_46443398553153540]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(recurring_revenue_acc)' />
      </column>
      <column caption='transaction_cash_revenu' datatype='real' name='[Calculation_46443398556901382]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[transaction_cash_revenue_acc]' />
      </column>
      <column caption='Calculation4' datatype='integer' name='[Calculation_46443398581121034]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [month_year]= [month_date_day] and [month_year]=[month_date_stage] then [won_deals] END' />
      </column>
      <column caption='Recurring SaaS Fee' datatype='real' name='[Calculation_5097230416280944642]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//[Other_Recurring_SaaS_Fee_acc]+[recurring_smarttab_revenue_acc]+[recurring_smartkiosk_revenue_acc]+[recurring_smartconnect_revenue_acc]+[recurring_smartweb_revenue_acc]+[recurring_smartapp_revenue_acc]+[recurring_ai_revenue_acc]+[recurring_others_revenue_acc]+[recurring_terminal_revenue_acc]+[recurring_menumanagement_revenue_acc]&#10;&#10;&#10;&#10;ifnull(sum([recurring_revenue_acc]),0)+ifnull(sum([deferred_revenue_acc]),0)' />
      </column>
      <column caption='Total revenue' datatype='real' name='[Calculation_5097230416282984451]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[transaction_stripe_revenue_acc]+ [transaction_cash_revenue_acc]+&#13;&#10;[recurring_smarttab_revenue_acc]+ [recurring_smartkiosk_revenue_acc]+&#13;&#10;[recurring_smartconnect_revenue_acc]+ [recurring_ai_revenue_acc]+&#13;&#10;[recurring_smartapp_revenue_acc]+[recurring_terminal_revenue_acc]+&#13;&#10;[recurring_smartweb_revenue_acc]+[recurring_pos_revenue_acc]+&#13;&#10;[recurring_fee_adyen_acc]+[recurring_menumanagement_revenue_acc]+&#13;&#10;[transaction_fee_razerpay_acc]+[recurring_support_revenue_acc]+&#13;&#10;[recurring_others_revenue_acc]+[one_time_revenue_acc]' />
      </column>
      <column caption='Time interval' datatype='string' name='[Calculation_5230931027982954496]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[year_month]' />
      </column>
      <column caption='date_diff' datatype='integer' name='[Calculation_5230931027999526914]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1]=&quot;Month&quot; then [date_diff_month]&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Week&quot; then [date_diff_week] END' />
      </column>
      <column caption='Month/week-FD' datatype='string' name='[Calculation_5482991869669892097]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1]=&quot;Month&quot; then [month_year_created] &#10;ELSEIF [Parameters].[Parameter 1]=&quot;Month&quot; then [month_year_resolved] &#10;ELSEIF [Parameters].[Parameter 1]=&quot;Week&quot; then [year_month_week_created]&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Week&quot; then [year_month_week_resolved] &#10;END' />
      </column>
      <column caption='New SGD -AP' datatype='real' name='[Calculation_5482991869682888706]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1]=&quot;Month&quot; then [new_sgd (Custom SQL Query4)] END' />
      </column>
      <column caption='AR-SGD' datatype='real' name='[Calculation_5482991869683625987]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1]= &quot;Month&quot; then [new_sgd] end' />
      </column>
      <column caption='L1_1' datatype='integer' name='[Calculation_5482991869711933444]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_5230931027982954496]= [Calculation_5482991869669892097] then [l1_1] end' />
      </column>
      <column caption='New Merchant_ids' datatype='string' name='[Calculation_5482991869729075210]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1]=&quot;Month&quot; then [merchant_id] &#10;END' />
      </column>
      <column caption='Calculation6' datatype='boolean' name='[Calculation_5997457758658633729]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[month_date]= [year_month]' />
      </column>
      <column caption='Change wrt to Last week' datatype='real' name='[Calculation_617274686228987905]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([sales (Custom SQL Query5)]-[last_1_month_gmv (Custom SQL Query5)])/[last_1_month_gmv (Custom SQL Query5)]' />
      </column>
      <column aggregation='Sum' caption='Sheet Selector- month' datatype='integer' name='[Calculation_617274686238822408]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Month&quot; THEN 1&#10;ELSE 0&#10;END' />
      </column>
      <column caption='Merchant_ids' datatype='string' name='[Calculation_6298424877530173440]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1]=&quot;Week&quot; then [merchant_id (Custom SQL Query5)] END' />
      </column>
      <column caption='Recurring Fee Others' datatype='real' name='[Calculation_6958483694440194048]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Recurring_Fee_Menu_Management],0)+ IFNULL([Recurring_fee_Others],0)+ifnull([Recurring_Fee_POS],0)+ifnull([Recurring_Fee_SmartApp],0)+ifnull([Recurring_Fee_Support_Package],0)+ifnull([Recurring_Fee_SmartTerminal],0)' />
      </column>
      <column caption='Low Buckets' datatype='string' name='[Calculation_778559826681651201]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_1075797400781434900] =&quot;Low&quot; then [m1 (Custom SQL Query10)] END' />
      </column>
      <column caption='Paid GMV %' datatype='real' name='[Calculation_7900158178056388611]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_246361031160545281])/SUM([Calculation_246361031159136256])' />
      </column>
      <column caption='Total Recurring Revenue ' datatype='real' name='[Calculation_7900158178057891844]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_cash_revenue_acc (bq-results-20240916-100941-1726)])+SUM([Calculation_5097230416280944642])+sum([total_payment_gateway_revenue_acc (bq-results-20240916-100941-1726)]) + sum([cos_tcc_oat_fee_refund_acc])+ sum([total_stripe_cost_acc])' />
      </column>
      <column caption='Avg Recurring Revenue Per Store' datatype='real' name='[Calculation_7900158178059894792]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_8877157850208419841])/COUNTD([merchant_id (Custom SQL Query)])' />
      </column>
      <column caption='Take Rate ' datatype='real' name='[Calculation_7900158178060951562]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ifnull(([Calculation_8877157850208419841]),0)/ sum([Calculation_246361031159136256])' />
      </column>
      <column caption='Contact Ratio' datatype='real' name='[Calculation_7900158178062426123]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(COUNTD([l1_1])+COUNTD([l3_1])+COUNTD([Calculation_1977221000854265894]))/sum([orders])' />
      </column>
      <column caption='Total Recurring Revenue' datatype='real' name='[Calculation_8877157850208419841]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//[recurring_revenue_acc]+[deferred_revenue_acc]&#10;&#10;&#10;ifnull([Total Payment Gateway Revenue(minus cost) (copy)_5936096161049804800],0)&#10;+ifnull(SUM([recurring_revenue_acc]),0)&#10;+ifnull(sum([deferred_revenue_acc]),0)' />
      </column>
      <column caption='Calculation9' datatype='real' name='[Calculation_91760909546741763]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Failed order],0)+IFNULL([Success order],0)' />
      </column>
      <column caption='Failed Order' datatype='integer' name='[Calculation_91760909546807300]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Result]= &quot;FAILED&quot; then [order_count] END' />
      </column>
      <column caption='Success Order' datatype='integer' name='[Calculation_91760909546889221]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Result]= &quot;SUCCESS&quot; then [order_count] END' />
      </column>
      <column caption='Total Order Count' datatype='integer' name='[Calculation_91760909546983430]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Calculation_91760909546807300],0)+IFNULL([Calculation_91760909546889221],0)' />
      </column>
      <column caption='Failed %' datatype='real' name='[Calculation_91760909547118599]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_91760909546807300])/SUM([order_count])' />
      </column>
      <column caption='Success %' datatype='real' name='[Calculation_91760909547208712]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_91760909546889221])/SUM([order_count])' />
      </column>
      <column caption='No GMV Last 7 Days' datatype='boolean' name='[Calculation_91760909661007881]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [Merchant_id (Custom SQL Query11)] : SUM(IF DATEDIFF(&apos;day&apos;, [order_date (Custom SQL Query11)], TODAY()) &lt;= 7 THEN [Sales (Custom SQL Query11)] ELSE 0 END) } = 0' />
      </column>
      <column caption='No GMV Last 7 Days new' datatype='boolean' name='[Calculation_91760909661282314]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [Merchant_id (Custom SQL Query11)] : SUM(IF  [Calculation_91760909666140173] = True THEN [Sales (Custom SQL Query11)] ELSE 0 END) } = 0' />
      </column>
      <column caption='7 days GMV filter' datatype='boolean' name='[Calculation_91760909666140173]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[order_date (Custom SQL Query11)]&gt;= dateadd(&apos;day&apos;,-7,TODAY()) and [order_date (Custom SQL Query11)]&lt;= TODAY()' />
      </column>
      <column caption='No GMV Merchant List' datatype='string' name='[Calculation_91760909960081424]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_91760909661282314] = True then [Merchant_id (Custom SQL Query11)] END' />
      </column>
      <column caption='Calculation10' datatype='integer' name='[Calculation_91760909960962065]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='string' name='[Country (Custom SQL Query10) #1]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column datatype='string' name='[Country (Custom SQL Query11)]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column datatype='string' name='[Country (Custom SQL Query2)]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column datatype='string' name='[Country (Custom SQL Query3)]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column datatype='string' name='[Country (Custom SQL Query5)]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column datatype='string' name='[Country (Custom SQL Query6)]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column datatype='string' name='[Country (Custom SQL Query9)]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column caption='GMV/Outlet (copy)' datatype='real' name='[GMV/Outlet (copy)_2584714356470829073]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sales])/COUNTD([merchant_id (Custom SQL Query)])' />
      </column>
      <column caption='Orders/Outlet' datatype='real' name='[GMV/Outlet (copy)_2635872446707064841]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders])/COUNTD([merchant_id (Custom SQL Query)])' />
      </column>
      <column caption='Paid_Gmv/Outlet' datatype='real' name='[GMV/Outlet (copy)_987132757387116544]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_246361031160545281])/COUNTD([merchant_id (Custom SQL Query)])' />
      </column>
      <column caption='L3_1' datatype='integer' name='[L1_1 (copy)_5482991869717102598]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_5230931027982954496]= [Calculation_5482991869669892097] then [l3_1] end' />
      </column>
      <column caption='Guest Orders' datatype='integer' name='[Login ABV (copy)_1696168272760516619]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_1696168272758276097]=&apos;Guest&apos; then [orders (Custom SQL Query7)] END' />
      </column>
      <column caption='Repeat Customer Count' datatype='integer' name='[Login Customer Count (copy)_1696168272820793359]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [Calculation_1696168272758714371]=&apos;Repeat&apos; then [customer_id] END)' />
      </column>
      <column caption='Lost Merchant Flag(week)' datatype='integer' name='[Lost Merchant Flag(month) (copy)_617274686230491139]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if ifnull([last_3_months_gmv (Custom SQL Query5)],0)=0 and ifnull([last_4_months_gmv (Custom SQL Query5)],0)!=0&#13;&#10;and [first_month_flag (Custom SQL Query5)]=0 and ifnull([sales (Custom SQL Query5)],0)=0 then 1 else 0 end' />
      </column>
      <column caption='Medium Buckets' datatype='string' name='[Low Buckets (copy) (copy)_778559826682298372]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_1075797400781434900] =&quot;Medium&quot; then [m1 (Custom SQL Query10)] END' />
      </column>
      <column caption='High Buckets' datatype='string' name='[Low Buckets (copy)_778559826682290179]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_1075797400781434900] =&quot;High&quot; then [m1 (Custom SQL Query10)] END' />
      </column>
      <column caption='total buckets' datatype='integer' name='[Medium Buckets (copy)_778559826682421253]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='COUNTD([m1 (Custom SQL Query10)])' />
      </column>
      <column caption='Merchant Cohorts- Category (copy)' datatype='string' name='[Merchant Cohorts- Category (copy)_617274686236950534]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [first_month_flag (Custom SQL Query5)]=1 then &apos;New&apos;&#13;&#10;ELSEIF [Monthly Merchant Cohorts (copy)_617274686236581893] = &apos;Not Active&apos;  then &apos;Not Active&apos;&#13;&#10;elseif [Monthly Merchant Cohorts (copy)_617274686236581893] = &apos;At Risk of being Lost&apos;&#13;&#10;        or [Monthly Merchant Cohorts (copy)_617274686236581893] = &apos;High Risk of being Lost&apos; then &apos;At Risk&apos;&#13;&#10;ELSEIF [Monthly Merchant Cohorts (copy)_617274686236581893] = &apos;Restarted&apos;&#13;&#10;        or [Monthly Merchant Cohorts (copy)_617274686236581893] = &apos;Quick Restarted&apos;&#13;&#10;        or [Monthly Merchant Cohorts (copy)_617274686236581893] = &apos;Back From Dead&apos; then &apos;Restarted&apos;&#13;&#10;else [Monthly Merchant Cohorts (copy)_617274686236581893]&#13;&#10;end' />
        <aliases>
          <alias key='&quot;Decreasing&quot;' value='Active Decreasing' />
          <alias key='&quot;Increasing&quot;' value='Active Increasing ' />
        </aliases>
      </column>
      <column caption='Merchant_id ' datatype='string' name='[Merchant_id (Custom SQL Query11)]' role='dimension' type='nominal' />
      <column caption='Monthly Merchant Cohorts (copy)' datatype='string' name='[Monthly Merchant Cohorts (copy)_617274686236581893]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [first_month_flag (Custom SQL Query5)]=1 then &apos;New&apos;&#13;&#10;ELSEIF ifnull([last_1_month_gmv (Custom SQL Query5)],0)=0 and ifnull([last_2_months_gmv (Custom SQL Query5)],0)&gt;0 and ifnull([sales (Custom SQL Query5)],0)=0 then &apos;At Risk of being Lost&apos;&#13;&#10;elseif ifnull([last_2_months_gmv (Custom SQL Query5)],0)=0 and ifnull([last_3_months_gmv (Custom SQL Query5)],0)&gt;0 and ifnull([sales (Custom SQL Query5)],0)=0 then &apos;High Risk of being Lost&apos;&#13;&#10;ELSEIF ifnull([last_1_month_gmv (Custom SQL Query5)],0)&gt;0 and ifnull([sales (Custom SQL Query5)],0)=0 then &apos;Not Active&apos;&#13;&#10;ELSEIF ifnull([last_1_month_gmv (Custom SQL Query5)],0)&gt;0 and ifnull([sales (Custom SQL Query5)],0)&gt;0 then [Active Cohorts (copy)_617274686236479492]&#13;&#10;elseif ifnull([last_1_month_gmv (Custom SQL Query5)],0)=0  and ifnull([last_2_months_gmv (Custom SQL Query5)],0)&gt;0 and ifnull([sales (Custom SQL Query5)],0)&gt;0 then &apos;Quick Restarted&apos;&#13;&#10;elseif ifnull([last_2_months_gmv (Custom SQL Query5)],0)=0 and ifnull([last_3_months_gmv (Custom SQL Query5)],0)&gt;0 and ifnull([sales (Custom SQL Query5)],0)&gt;0 then &apos;Restarted&apos;&#13;&#10;elseif ifnull([last_3_months_gmv (Custom SQL Query5)],0)=0 and ifnull([sales (Custom SQL Query5)],0)&gt;0 then &apos;Back From Dead&apos;&#13;&#10;ELSEIF [Lost Merchant Flag(month) (copy)_617274686230491139]=1 then &apos;Lost&apos;&#13;&#10;end' />
      </column>
