          <datasource-dependencies datasource='federated.0xgukxt059r9i61ahck5g1kpil21'>
            <column caption='Active Cohorts (copy)' datatype='string' name='[Active Cohorts (copy)_617274686236479492]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_617274686228987905]&gt;=0.4 then &apos;Increasing&apos;&#13;&#10;ELSEIF [Calculation_617274686228987905]&lt;-0.4 then &apos;Decreasing&apos;&#13;&#10;else &apos;Stable&apos;&#13;&#10;end' />
            </column>
            <column caption='Change wrt to Last week' datatype='real' name='[Calculation_617274686228987905]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([sales (Custom SQL Query5)]-[last_1_month_gmv (Custom SQL Query5)])/[last_1_month_gmv (Custom SQL Query5)]' />
            </column>
            <column caption='Lost Merchant Flag(week)' datatype='integer' name='[Lost Merchant Flag(month) (copy)_617274686230491139]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if ifnull([last_3_months_gmv (Custom SQL Query5)],0)=0 and ifnull([last_4_months_gmv (Custom SQL Query5)],0)!=0&#13;&#10;and [first_month_flag (Custom SQL Query5)]=0 and ifnull([sales (Custom SQL Query5)],0)=0 then 1 else 0 end' />
            </column>
            <column caption='Merchant Cohorts- Category (copy)' datatype='string' name='[Merchant Cohorts- Category (copy)_617274686236950534]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [first_month_flag (Custom SQL Query5)]=1 then &apos;New&apos;&#13;&#10;ELSEIF [Monthly Merchant Cohorts (copy)_617274686236581893] = &apos;Not Active&apos;  then &apos;Not Active&apos;&#13;&#10;elseif [Monthly Merchant Cohorts (copy)_617274686236581893] = &apos;At Risk of being Lost&apos;&#13;&#10;        or [Monthly Merchant Cohorts (copy)_617274686236581893] = &apos;High Risk of being Lost&apos; then &apos;At Risk&apos;&#13;&#10;ELSEIF [Monthly Merchant Cohorts (copy)_617274686236581893] = &apos;Restarted&apos;&#13;&#10;        or [Monthly Merchant Cohorts (copy)_617274686236581893] = &apos;Quick Restarted&apos;&#13;&#10;        or [Monthly Merchant Cohorts (copy)_617274686236581893] = &apos;Back From Dead&apos; then &apos;Restarted&apos;&#13;&#10;else [Monthly Merchant Cohorts (copy)_617274686236581893]&#13;&#10;end' />
              <aliases>
                <alias key='&quot;Decreasing&quot;' value='Active Decreasing' />
                <alias key='&quot;Increasing&quot;' value='Active Increasing ' />
              </aliases>
            </column>
            <column caption='Monthly Merchant Cohorts (copy)' datatype='string' name='[Monthly Merchant Cohorts (copy)_617274686236581893]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [first_month_flag (Custom SQL Query5)]=1 then &apos;New&apos;&#13;&#10;ELSEIF ifnull([last_1_month_gmv (Custom SQL Query5)],0)=0 and ifnull([last_2_months_gmv (Custom SQL Query5)],0)&gt;0 and ifnull([sales (Custom SQL Query5)],0)=0 then &apos;At Risk of being Lost&apos;&#13;&#10;elseif ifnull([last_2_months_gmv (Custom SQL Query5)],0)=0 and ifnull([last_3_months_gmv (Custom SQL Query5)],0)&gt;0 and ifnull([sales (Custom SQL Query5)],0)=0 then &apos;High Risk of being Lost&apos;&#13;&#10;ELSEIF ifnull([last_1_month_gmv (Custom SQL Query5)],0)&gt;0 and ifnull([sales (Custom SQL Query5)],0)=0 then &apos;Not Active&apos;&#13;&#10;ELSEIF ifnull([last_1_month_gmv (Custom SQL Query5)],0)&gt;0 and ifnull([sales (Custom SQL Query5)],0)&gt;0 then [Active Cohorts (copy)_617274686236479492]&#13;&#10;elseif ifnull([last_1_month_gmv (Custom SQL Query5)],0)=0  and ifnull([last_2_months_gmv (Custom SQL Query5)],0)&gt;0 and ifnull([sales (Custom SQL Query5)],0)&gt;0 then &apos;Quick Restarted&apos;&#13;&#10;elseif ifnull([last_2_months_gmv (Custom SQL Query5)],0)=0 and ifnull([last_3_months_gmv (Custom SQL Query5)],0)&gt;0 and ifnull([sales (Custom SQL Query5)],0)&gt;0 then &apos;Restarted&apos;&#13;&#10;elseif ifnull([last_3_months_gmv (Custom SQL Query5)],0)=0 and ifnull([sales (Custom SQL Query5)],0)&gt;0 then &apos;Back From Dead&apos;&#13;&#10;ELSEIF [Lost Merchant Flag(month) (copy)_617274686230491139]=1 then &apos;Lost&apos;&#13;&#10;end' />
            </column>
