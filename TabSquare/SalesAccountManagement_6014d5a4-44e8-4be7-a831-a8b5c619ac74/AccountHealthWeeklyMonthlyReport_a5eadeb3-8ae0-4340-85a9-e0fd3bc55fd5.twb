    <worksheet name='Revenue (NEW)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>Revenue at Month Level</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query+ (all_skipque_cdc_data_prod)' name='federated.0xgukxt059r9i61ahck5g1kpil21' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Month /Week' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0xgukxt059r9i61ahck5g1kpil21'>
            <column caption='Payment gateway Cost' datatype='real' name='[Calculation_1813261865022558211]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-[transactional_cost]' />
            </column>
            <column caption='GMV in local' datatype='real' name='[Calculation_246361031159136256]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case  [country] when &quot;Australia&quot;  then [sales]/0.9004687&#10;when &quot;Singapore&quot; then [sales]&#10;when &quot;Malaysia&quot; then [sales]/0.30175252&#10;when &quot;Indonesia&quot; then [sales]/0.000089&#10;else [sales]&#10;END' />
            </column>
            <column caption='Total Deducted Cost' datatype='real' name='[Calculation_401101891435012096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull(SUM([cost_of_hardware_acc]),0)+&#13;&#10;ifnull(SUM([other_costs_acc]),0)+&#13;&#10;ifnull(SUM([resellers_costs_acc]),0)&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;///[cost_of_hardware]+[cost_of_setup]+[other_costs]+[resellers_costs]+[tcc_oat_fee]+[total_stripe_cost]///' />
            </column>
            <column caption='Total Rev' datatype='real' name='[Calculation_401101891435864066]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//sum([Recurring SaaS Fee])+[Total Payment Gateway Revenue New]+sum([one_time_revenue_acc])+sum([cos_tcc_oat_fee_refund_acc])+sum([total_stripe_cost_acc])&#13;&#10;&#13;&#10;&#13;&#10;//SUM([Total revenue]) + sum([cos_tcc_oat_fee_refund_acc])&#10;&#10;ifnull(sum([recurring_revenue_acc]),0)&#10;+ifnull([Total Payment Gateway Revenue(minus cost) (copy)_5936096161049804800],0)&#10;+ifnull(sum([one_time_revenue_acc]),0)&#10;+ifnull(sum([deferred_revenue_acc]),0)' />
            </column>
            <column caption='Net Revenue' datatype='real' name='[Calculation_401101891437056003]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull(sum([Calculation_5097230416282984451]),0)+ifnull(([Calculation_401101891435012096]),0)&#13;&#10;//sum([Recurring SaaS Fee]) +sum([one_time_revenue_acc])+  ([Total Deducted Cost]) + [Total Payment Gateway Revenue New]' />
            </column>
            <column caption='Recurring SaaS Fee' datatype='real' name='[Calculation_5097230416280944642]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//[Other_Recurring_SaaS_Fee_acc]+[recurring_smarttab_revenue_acc]+[recurring_smartkiosk_revenue_acc]+[recurring_smartconnect_revenue_acc]+[recurring_smartweb_revenue_acc]+[recurring_smartapp_revenue_acc]+[recurring_ai_revenue_acc]+[recurring_others_revenue_acc]+[recurring_terminal_revenue_acc]+[recurring_menumanagement_revenue_acc]&#10;&#10;&#10;&#10;ifnull(sum([recurring_revenue_acc]),0)+ifnull(sum([deferred_revenue_acc]),0)' />
            </column>
            <column caption='Total revenue' datatype='real' name='[Calculation_5097230416282984451]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[transaction_stripe_revenue_acc]+ [transaction_cash_revenue_acc]+&#13;&#10;[recurring_smarttab_revenue_acc]+ [recurring_smartkiosk_revenue_acc]+&#13;&#10;[recurring_smartconnect_revenue_acc]+ [recurring_ai_revenue_acc]+&#13;&#10;[recurring_smartapp_revenue_acc]+[recurring_terminal_revenue_acc]+&#13;&#10;[recurring_smartweb_revenue_acc]+[recurring_pos_revenue_acc]+&#13;&#10;[recurring_fee_adyen_acc]+[recurring_menumanagement_revenue_acc]+&#13;&#10;[transaction_fee_razerpay_acc]+[recurring_support_revenue_acc]+&#13;&#10;[recurring_others_revenue_acc]+[one_time_revenue_acc]' />
            </column>
            <column caption='Time interval' datatype='string' name='[Calculation_5230931027982954496]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[year_month]' />
            </column>
            <column aggregation='Sum' caption='Sheet Selector- month' datatype='integer' name='[Calculation_617274686238822408]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Month&quot; THEN 1&#10;ELSE 0&#10;END' />
            </column>
            <column caption='Avg Recurring Revenue Per Store' datatype='real' name='[Calculation_7900158178059894792]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_8877157850208419841])/COUNTD([merchant_id (Custom SQL Query)])' />
            </column>
            <column caption='Take Rate ' datatype='real' name='[Calculation_7900158178060951562]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull(([Calculation_8877157850208419841]),0)/ sum([Calculation_246361031159136256])' />
            </column>
            <column caption='Total Recurring Revenue' datatype='real' name='[Calculation_8877157850208419841]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//[recurring_revenue_acc]+[deferred_revenue_acc]&#10;&#10;&#10;ifnull([Total Payment Gateway Revenue(minus cost) (copy)_5936096161049804800],0)&#10;+ifnull(SUM([recurring_revenue_acc]),0)&#10;+ifnull(sum([deferred_revenue_acc]),0)' />
            </column>
            <column datatype='string' name='[Name_of_Account_Manager (Custom SQL Query)]' role='dimension' type='nominal' />
            <column caption='Total Payment Gateway Revenue(minus cost) (copy)' datatype='real' name='[Total Payment Gateway Revenue(minus cost) (copy)_5936096161049804800]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Total Rev (copy)_4813151741158383616] - sum([transactional_cost]) +sum([cos_tcc_oat_fee_refund_acc])' />
            </column>
            <column caption='Total Payment Gateway Revenue New' datatype='real' name='[Total Rev (copy)_4813151741158383616]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([transaction_fee_razerpay_acc])+sum([transaction_stripe_revenue_acc])+sum([recurring_fee_adyen_acc]) + sum([transaction_cash_revenue_acc])' />
            </column>
            <column datatype='string' name='[account_name (Custom SQL Query) #1]' role='dimension' type='nominal' />
            <column datatype='real' name='[cos_tcc_oat_fee_refund_acc]' role='measure' type='quantitative' />
            <column datatype='real' name='[cost_of_hardware_acc]' role='measure' type='quantitative' />
            <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='real' name='[deferred_revenue_acc]' role='measure' type='quantitative' />
            <column datatype='string' name='[merchant_id (Custom SQL Query)]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_5230931027982954496]' derivation='None' name='[none:Calculation_5230931027982954496:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_617274686238822408]' derivation='None' name='[none:Calculation_617274686238822408:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Name_of_Account_Manager (Custom SQL Query)]' derivation='None' name='[none:Name_of_Account_Manager (Custom SQL Query):nk]' pivot='key' type='nominal' />
            <column-instance column='[account_name (Custom SQL Query) #1]' derivation='None' name='[none:account_name (Custom SQL Query) #1:nk]' pivot='key' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column datatype='real' name='[one_time_revenue_acc]' role='measure' type='quantitative' />
            <column datatype='real' name='[other_costs_acc]' role='measure' type='quantitative' />
            <column datatype='real' name='[recurring_ai_revenue_acc]' role='measure' type='quantitative' />
            <column datatype='real' name='[recurring_fee_adyen_acc]' role='measure' type='quantitative' />
            <column datatype='real' name='[recurring_menumanagement_revenue_acc]' role='measure' type='quantitative' />
            <column datatype='real' name='[recurring_others_revenue_acc]' role='measure' type='quantitative' />
            <column datatype='real' name='[recurring_pos_revenue_acc]' role='measure' type='quantitative' />
            <column datatype='real' name='[recurring_revenue_acc]' role='measure' type='quantitative' />
            <column datatype='real' name='[recurring_smartapp_revenue_acc]' role='measure' type='quantitative' />
            <column datatype='real' name='[recurring_smartconnect_revenue_acc]' role='measure' type='quantitative' />
            <column datatype='real' name='[recurring_smartkiosk_revenue_acc]' role='measure' type='quantitative' />
            <column datatype='real' name='[recurring_smarttab_revenue_acc]' role='measure' type='quantitative' />
            <column datatype='real' name='[recurring_smartweb_revenue_acc]' role='measure' type='quantitative' />
            <column datatype='real' name='[recurring_support_revenue_acc]' role='measure' type='quantitative' />
            <column datatype='real' name='[recurring_terminal_revenue_acc]' role='measure' type='quantitative' />
