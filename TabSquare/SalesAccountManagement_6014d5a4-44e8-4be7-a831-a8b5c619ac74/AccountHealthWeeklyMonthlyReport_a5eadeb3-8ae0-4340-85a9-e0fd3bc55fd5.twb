        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1kkd9551e2i8sw1axtwhh1crtqpp' name='Custom SQL Query7' type='text'>select * from `tabsquare-data-sciences.data_analysis_team_dev.productgmv_week_month_account_dashboard`</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='bigquery.1kkd9551e2i8sw1axtwhh1crtqpp' name='Custom SQL Query' type='text'><![CDATA[select country , account_name, Name_of_Account_Manager,merchant_id,
format_date("%Y-%m", order_date) as year_month,
concat(extract(year from order_date), "-", extract(month from order_date)) as year_month_1,
FORMAT_DATE('%Y-%m-%d', DATE_TRUNC(order_date, WEEK(MONDAY)))  as year_month_week,
sum(sales) as sales, 
sum(orders) as orders,
sum(paid_gmv) as paid_gmv

 from (select a.*, b.Chain_Name_in_system,b.Account_Name,b.Name_of_Account_Manager,
b.Team, case when ifnull(organization_partner_id,0) in (1) then 'FoodPanda' 
 when ifnull(organization_partner_id,0) in (2) then 'Foodora'
 when ifnull(organization_partner_id,0) in (3) then 'Talabat'
 else 'TabSquare' end as third_party_flag from
(
 select Country,Merchant_id,RestaurantName,order_date,sum(final_gmv) as Sales, sum(total_gmv_orders) as orders ,
sum(total_paid_gmv) as Paid_Gmv, sum(total_paid_orders) as Paid_Orders from 
`tabsquare-data-sciences.datastudio_dashboard_data.new_net_gmv` 
where order_date >>= '2024-01-01' and  order_date <<= current_date('Asia/Singapore')
and merchant_id not like '%HQ-24%'
and merchant_id not like '%HQ-6278%'
group by 1,2,3,4

UNION ALL

SELECT
  Country,Merchant_id,RestaurantName,extract(date from order_date) as order_date, sum(sales) as Sales, sum(Orders) as orders, 0 as Paid_Gmv,
0 as Paid_Orders
FROM
  `tabsquare-data-sciences.tabsquare_dw_lookups.kfc_taco_gmv`
  where extract(date from order_date) >>= '2024-01-01' and  extract(date from order_date) <<= current_date('Asia/Singapore')
Group by 1,2,3,4) a 
left join
`tabsquare-data-sciences.tabsquare_dw_lookups.master_merchant_list_tableau_view` as b
on a.merchant_id = b.merchant_id
left join
`tabsquare-data-sciences.all_skipque_cdc_data_prod.all_organization_view_prod` o
on a.merchant_id = o.merchant_key)  group by 1,2,3,4,5,6,7 order by 1,2,3,4,5,6,7]]></relation>
          <relation connection='bigquery.1kkd9551e2i8sw1axtwhh1crtqpp' name='Custom SQL Query7' type='text'>select * from `tabsquare-data-sciences.data_analysis_team_dev.productgmv_week_month_account_dashboard`</relation>
          <relation connection='bigquery.1kkd9551e2i8sw1axtwhh1crtqpp' name='Custom SQL Query2' type='text'>select * from `tabsquare-data-sciences.data_analysis_team_dev.merchant_status_month_account_dashboard`</relation>
          <relation connection='bigquery.1kkd9551e2i8sw1axtwhh1crtqpp' name='Custom SQL Query6' type='text'>select * from tabsquare-data-sciences.data_analysis_team_dev.account_health_revenue</relation>
          <relation connection='bigquery.1kkd9551e2i8sw1axtwhh1crtqpp' name='Custom SQL Query1' type='text'><![CDATA[select distinct * from 
(select distinct ticket_id, 
ifnull(deleted, False) as deleted, 
month_year_created, 
month_year_resolved, 
Name_of_Account_Manager, Account_Name,
year_month_week_created,
year_month_week_resolved,
ticket_created_at, 
ticket_resolved_at, 
status, 
source_new, 
country_new,
concat(country_new,"-", source_new, "-", month_year_created,"-", status ) as abcd,
rn_updated_at_ticket,rn_resolved_at, ticket_categorization,
case when rn_updated_at_ticket=1 and ticket_categorization = "l1" then ticket_id end as l1_1,
case when rn_updated_at_ticket=1 and ticket_categorization = "l3" then ticket_id end as l3_1,
case when rn_updated_at_ticket=1 and ticket_categorization = "Finance Team" then ticket_id end as finance_1,
 case when rn_updated_at_ticket=1 and ticket_categorization = "Payment Support" then ticket_id end as payment_1,
 case when rn_updated_at_ticket=1 and ticket_categorization = "Implementation Team" then ticket_id end as implementation_1,
 case when rn_updated_at_ticket=1 and ticket_categorization = "Menu Team" then ticket_id end as menu_1,
 case when rn_updated_at_ticket=1 and ticket_categorization = "others" then ticket_id end as others_1,
CASE WHEN rn_updated_at_ticket=1 and satisfaction_rating = '100' THEN ticket_id end as neutral_rating,
CASE WHEN rn_updated_at_ticket=1 and satisfaction_rating = '-103' THEN ticket_id end as negative_rating,
CASE WHEN rn_updated_at_ticket=1 and satisfaction_rating = '103' THEN ticket_id end as positive_rating,
from 
(select distinct *,
row_number() over(partition by ticket_id order by ticket_updated_time desc) as rn_updated_at_ticket,
row_number() over(partition by ticket_id, ticket_categorization, status order by ticket_updated_time desc) as rn_resolved_at,

from 


(
SELECT  distinct th.id as ticket_id, th.created_at as ticket_created_at,th.stats_resolved_at as ticket_resolved_at,
format_date("%Y-%m", th.created_at) as month_year_created,
format_date("%Y-%m", th.stats_resolved_at) as month_year_resolved,
FORMAT_DATE('%Y-%m-%d', DATE_TRUNC(th.created_at, WEEK(MONDAY))) as year_month_week_created,
FORMAT_DATE('%Y-%m-%d', DATE_TRUNC(th.stats_resolved_at, WEEK(MONDAY))) as year_month_week_resolved,
sl.label_for_agents as status,th.updated_at as ticket_updated_time,
max(th.custom_cf_country) over(partition by th.id) as country_new,
 sr.feedback,mm.Name_of_Account_Manager, mm.Account_Name,
    sv.value AS satisfaction_rating, th.deleted,
case when so.source is null then "Whatsapp" else so.source end as source_new,
case when  trim(g.name) IN ("Refund Support",
"SG-On-Site Support",
"Supportdesk AU",
"Supportdesk ID",
"Supportdesk MY",
"Supportdesk SG") THEN 'l1'
when trim(g.name) IN ("L2-CMS-Support","L2-Console-Support","L2-CRM-Support",
"L2-Data Analytics-Support","L2-eCMS-Support","L2-Hardware-Support",
"L2-Integration-Support","L2-Payment-Support","L2-SmartConnect-Support",
"L2-SmartKiosk-Support","L2-SmartQ-Support","L2-SmartTab-Support",
"L2-SmartWeb-Support","L2-Support","L3-CMS-Support","L3-Console-Support",
"L3-CRM-Support","L3-Data Analytics-Support","L3-Delivery-Support",
"L3-eCMS-Support","L3-Hardware-Support","L3-Integration-Support",
"L3-Payment-Support","L3-SmartConnect-Support","L3-SmartKiosk-Support",
"L3-SmartQ-Support","L3-SmartTab-Support","L3-SmartWeb-Support",
"L3-Void Order-Support","Supportdesk - L2") THEN 'l3'
when trim(g.name) IN ("Finance Team") then 'Finance Team'
when trim(g.name) IN ("Payment Support") then 'Payment Support'
when trim(g.name) IN ("Implementation/Project Support") then 'Implementation Team'
when trim(g.name) IN ("Merchant Data Support") then 'Menu Team'
else "others"
 end as ticket_categorization  ,
 
from `freshdesk_data_prod.ticket_history` th
left join `freshdesk_data_prod.status_lookup` sl
on th.status = sl.id
left join `freshdesk_data_prod.source_lookup` so
on th.source = so.id
left join `freshdesk_data_prod.group` g
on  th.group_id = g.id
left join `freshdesk_data_prod.priority_lookup` pl
on th.priority = pl.id
left join `freshdesk_data_prod.agent` a
on a.id = th.responder_id
left join `freshdesk_data_prod.company` cm
on th.company_id= cm.id
left join 
`tabsquare-data-sciences.tabsquare_dw_lookups.master_merchant_list` mm 
on trim(th.custom_cf_merchant_key) = trim(mm.Merchant_id)
LEFT JOIN
 `tabsquare-data-sciences.freshdesk_data_prod.satisfaction_rating` sr
ON th.id = sr.ticket_id
LEFT JOIN `tabsquare-data-sciences.freshdesk_data_prod.satisfaction_rating_value` sv
ON sr.id = sv.satisfaction_rating_id 


  order by th.id, th.created_at, th.updated_at
)

order by ticket_id, ticket_created_at)  order by 1,2,3,4,5,6) where deleted<<>> True and ticket_created_at>>="2023-01-01" and abcd <<>>"Singapore-Outbound Email-2023-11-Closed"  order by ticket_id]]></relation>
          <relation connection='bigquery.1kkd9551e2i8sw1axtwhh1crtqpp' name='Custom SQL Query4' type='text'><![CDATA[(
  
  
  with a as ((
WITH
a AS (
SELECT
DISTINCT *,
1 AS dummy,
CASE
WHEN invoice_status = "FULLY PAID" THEN 0
ELSE
ROUND(total_amount,1)- ROUND(paid_sum,1)
END
AS due_amount_new
FROM (
SELECT
DISTINCT *,
CASE
WHEN ROUND(paid_sum,1) >> ROUND(total_amount,1) THEN "FULLY PAID"
WHEN ROUND(paid_sum, 1) = ROUND(total_amount, 1) THEN "FULLY PAID"
WHEN paid_sum = 0 THEN "NOT PAID"
WHEN ROUND(paid_sum,0) << ROUND(total_amount,1) THEN "PARTIALLY PAID"
END
AS invoice_status
FROM (
SELECT
DISTINCT *,
ROUND((total_amount - paid_sum),2) AS diff
FROM (
SELECT
DISTINCT *
FROM (
SELECT
DISTINCT *,
MAX(payment_transaction_date) OVER(PARTITION BY doc_number, source_company) AS max_payment_transaction_day,
SUM(p1) OVER(PARTITION BY doc_number, source_company) AS paid_sum
FROM (
SELECT
row_number () OVER(PARTITION BY doc_number, i.source_company ORDER BY payment_transaction_date DESC) AS rn,
CASE
WHEN i.source_company= 'tabsquare_pte' THEN 'Singapore'
WHEN i.source_company= 'tabsquare_pty' THEN 'Australia'
WHEN i.source_company= 'tabsquare_smart_solution' THEN 'Indonesia'
WHEN i.source_company= 'tabsquare_sdn_bhd' THEN 'Malaysia'
ELSE
'OTHERS'
END
AS Country,
payment_transaction_date,
'BILL' AS type,
i.due_date,
bill_id,
i.transaction_date,
i.doc_number,
i.total_amount*exchange_rate AS invoice_amount,
IFNULL(pl.paid_amount,0)AS p1,
IFNULL(pl.paid_amount*exchange_rate,0) AS paid_amount,
c.company_name,
i.exchange_rate,
i.total_amount,
i.currency_id,
c.company_name AS full_customer_name,
i.source_company,
(total_amount - IFNULL(paid_amount,0))*exchange_rate AS due_amount,
DATE_DIFF(CURRENT_DATE(), due_date, DAY) AS aging_days
FROM
`tabsquare-data-sciences.tabsquare_master_quickbooks.bill` i
LEFT JOIN
`tabsquare-data-sciences.tabsquare_master_quickbooks.vendor` c
ON
TRIM(i.vendor_id) = TRIM(c.id)
AND TRIM(i.source_company) = TRIM(c.source_company)
LEFT JOIN (
SELECT
pll.bill_id,
p.source_company,
p.transaction_date AS payment_transaction_date,
SUM(amount)AS paid_amount
FROM
`tabsquare-data-sciences.tabsquare_master_quickbooks.bill_payment_line` pll
LEFT JOIN
`tabsquare-data-sciences.tabsquare_master_quickbooks.bill_payment` p
ON
pll.bill_payment_id=p.id
GROUP BY
1,
2,
3 ) pl
ON
TRIM(pl.bill_id) = TRIM(i.id)
AND TRIM(pl.source_company) = TRIM(i.source_company)
WHERE
LOWER(c.company_name) NOT LIKE '%tabsquare%'
AND transaction_date>>="2022-01-01"
ORDER BY
doc_number,
payment_transaction_date)
ORDER BY
doc_number,
payment_transaction_date)
WHERE
rn = 1)
ORDER BY
doc_number,
payment_transaction_date)
ORDER BY
doc_number,
payment_transaction_date)),
b AS (
SELECT
date,
1 AS dummy
FROM
UNNEST(GENERATE_DATE_ARRAY(DATE('2016-01-01'), CURRENT_DATE(), INTERVAL 1 DAY)) AS date)
SELECT
DISTINCT *
FROM (
SELECT
DISTINCT *,
Format_date("%Y-%B", date) AS month_date,
CASE
WHEN source_company= 'tabsquare_pte' THEN 'Singapore'
WHEN source_company= 'tabsquare_pty' THEN 'Australia'
WHEN source_company= 'tabsquare_smart_solution' THEN 'Indonesia'
WHEN source_company= 'tabsquare_sdn_bhd' THEN 'Malaysia'
ELSE
'OTHERS'
END
AS Country,
FROM (
SELECT
DISTINCT *,
CASE
WHEN date=last_day_every_month THEN buckets
END
AS buckets_1,
CASE
WHEN date<<payment_transaction_date THEN total_amount
ELSE IFNULL(due_amount_new,0)
END
AS new_sgd,
FROM (
SELECT
DISTINCT *,
MAX(LAST_DAY(date)) OVER(PARTITION BY doc_number, EXTRACT(month FROM date)) AS last_day_every_month
FROM (
SELECT
DISTINCT *,
CASE
WHEN new_aging_days<<=0 AND new_status != "FULLY PAID" THEN "Current"
WHEN new_aging_days >> 0
AND new_aging_days <<30
AND new_status != "FULLY PAID" THEN "<<30 days"
WHEN new_aging_days >>=30 AND new_aging_days <<60 AND new_status != "FULLY PAID" THEN "30-60 days"
WHEN new_aging_days >>=60
AND new_aging_days <<90
AND new_status != "FULLY PAID" THEN "60-90 days"
WHEN new_aging_days >>=90 AND new_status != "FULLY PAID" THEN "90+ days"
ELSE
"FULLY PAID"
END
AS buckets
FROM (
SELECT
DISTINCT *,
DATE_DIFF(date, due_date, DAY) AS new_aging_days
FROM (
SELECT
DISTINCT doc_number,
source_company,
full_customer_name,
date,
transaction_date,
due_Date,
payment_transaction_date,
max_payment_transaction_day,
total_amount,
invoice_amount,
paid_amount,
due_amount,
due_amount_new,
CASE
WHEN date<<payment_transaction_date THEN "NOT PAID"
ELSE
invoice_status
END
AS new_status,
FROM
b
INNER JOIN
a
ON
b.dummy = a.dummy
AND b.date>>=a.transaction_date
AND b.date<<=CURRENT_DATE()
ORDER BY
doc_number,
date)
ORDER BY
doc_number,
date)
ORDER BY
doc_number,
date)
ORDER BY
doc_number,
date)
ORDER BY
doc_number,
date)
ORDER BY
doc_number,
date)
WHERE
buckets_1 IS NOT NULL
ORDER BY
doc_number,
date)
ORDER BY
doc_number,
date),

b as
      (select CASE
    WHEN COUNT(Outlet_QB_Name) >> 1 THEN MAX(Outlet_QB_Name)ELSE Outlet_QB_Name end as qb_name , 
    
    max(Parent_QB_Names) as Parent_QB_Names , max(Country) as mm_country, max(merchant_id) as merchant_id, max(Account_Name) as account_name, max(Team) as Team,
      max(Name_of_Account_Manager) as Account_Manager, max(restaurantname) as restaurant_name from   
        `tabsquare-data-sciences.tabsquare_dw_lookups.master_merchant_list`  mml group by Outlet_QB_Name) 


select doc_number, source_company, mm_country, country, full_customer_name,Parent_QB_Names
merchant_id,
account_name,
Team,
Account_Manager,
restaurant_name,
date,
transaction_date,
due_Date,
payment_transaction_date,
max_payment_transaction_day,
total_amount,
invoice_amount,
paid_amount,
due_amount,
due_amount_new,
new_status,
new_aging_days,
buckets,
last_day_every_month,
buckets_1,
new_sgd,
month_date


 from (select * from a 
left join b 
ON
    a.full_customer_name LIKE CONCAT('%', b.qb_name, '%')
    OR
    b.qb_name LIKE CONCAT('%', a.full_customer_name, '%')
    or a.full_customer_name LIKE CONCAT('%', b.Parent_QB_Names, '%')
    OR
    b.Parent_QB_Names LIKE CONCAT('%', a.full_customer_name, '%'))   
    )]]></relation>
          <relation connection='bigquery.1kkd9551e2i8sw1axtwhh1crtqpp' name='Custom SQL Query10' type='text'>select * from `tabsquare-data-sciences.data_analysis_team_dev.implementation_week_month_account_dashboard`</relation>
          <relation connection='bigquery.1kkd9551e2i8sw1axtwhh1crtqpp' name='Custom SQL Query8' type='text'>with a as 
(
  select merchant_id,product_ref, feature, rating,remarks, version_no, `date`,  from `tabsquare-data-sciences.emenu_events.sk_customer_feedback`
union all
select merchant_id,product_ref, feature, rating,remarks, version_no, event_date as `date` from `tabsquare-data-sciences.emenu_events.sw_customer_feedback_view`
),
b as 
(select * from `tabsquare-data-sciences.tabsquare_dw_lookups.master_merchant_list` )

select a.merchant_id,a.product_ref,a.feature,a.rating,remarks,a.version_no, format_date(&quot;%Y-%m&quot;, a.`date`) as year_month,
FORMAT_DATE(&apos;%Y-%m-%d&apos;, DATE_TRUNC(a.`date`, WEEK(MONDAY))) as year_month_week, b.Account_name, b.name_of_account_manager, b.country
from a left join b on a.merchant_id= b.merchant_id</relation>
          <relation connection='bigquery.1kkd9551e2i8sw1axtwhh1crtqpp' name='Custom SQL Query3' type='text'><![CDATA[((
  with a as 


  (select distinct *,1 as dummy, 
case when diff<<0 then total_amount - paid_amount 
else total_amount- paid_sum end as due_amount_new from 
(select distinct * ,total_amount - paid_sum as diff  from (select distinct *, 
sum(paid_amount) over(partition by doc_number, source_company) as paid_sum from 
(select distinct rn,doc_number, source_company, transaction_date, due_date, payment_transaction_date,account_manager,account_name,
max(payment_transaction_date) over(partition by doc_number, source_company) as max_payment_transaction_day,total_amount, 
invoice_amount, paid_amount,due_amount,exchange_rate,  
CASE WHEN paid_amount >>= invoice_amount-1 then 'FULLY PAID'
          WHEN paid_amount >> 0 then ' PARTIALLY PAID'
          WHEN paid_amount = 0 then 'NOT PAID'
          ELSE 'OTHERS' END
      as invoice_status, from
 (SELECT 

    row_number () over(partition by doc_number, i.source_company order by payment_transaction_date desc) as rn, 'INVOICE' as type, i.due_date,total_amount,
    total_amount - coalesce(paid_amount,0) as due_amount,
     i.transaction_date, i.doc_number, coalesce(i.total_amount*i.exchange_rate,0) as invoice_amount,coalesce(pl.paid_amount*i.exchange_rate,0) as paid_amount,
     c.company_name, i.exchange_rate,i.source_company,
     i.currency_id,c.fully_qualified_name as full_customer_name, lkp.qb_name,lkp.Parent_QB_Names,
     lkp.country, lkp.Team,lkp.account_name,lkp.restaurant_name, lkp.Account_Manager,lkp.Merchant_id,
    payment_transaction_date
  FROM   
    `tabsquare-data-sciences.tabsquare_master_quickbooks.invoice` i
  LEFT JOIN
     `tabsquare-data-sciences.tabsquare_master_quickbooks.customer` c 
  ON  i.customer_id = c.id
  AND i.source_company = c.source_company
  LEFT JOIN
    (select * from (select pll.payment_id,pll.source_company, pll.invoice_id,p.transaction_date as payment_transaction_date, row_number() over(partition by invoice_id) as rn,sum(amount) over(partition by invoice_id) as paid_amount from 
      `tabsquare-data-sciences.tabsquare_master_quickbooks.payment_line` pll
      left join `tabsquare-data-sciences.tabsquare_master_quickbooks.payment` p
      on pll.payment_id=p.id
      ) where rn=1) pl      
  ON pl.invoice_id = i.id 
  AND pl.source_company = i.source_company
  LEFT JOIN 
      (select CASE
    WHEN COUNT(Outlet_QB_Name) >> 1 THEN MAX(Outlet_QB_Name)ELSE Outlet_QB_Name end as qb_name , 
    max(Parent_QB_Names) as Parent_QB_Names , max(Country) as country, max(merchant_id) as merchant_id, max(Account_Name) as account_name, max(Team) as Team,
      max(Name_of_Account_Manager) as Account_Manager, max(restaurantname) as restaurant_name from   
        `tabsquare-data-sciences.tabsquare_dw_lookups.master_merchant_list`  mml group by Outlet_QB_Name) lkp 
  on regexp_replace(c.fully_qualified_name,' ','') = regexp_replace(lkp.qb_name,' ','') 
  or regexp_replace(c.fully_qualified_name,' ','') = regexp_replace(lkp.Parent_QB_Names,' ','') where  transaction_date>>="2022-01-01" 
  order by doc_number, payment_transaction_date)  order by doc_number, payment_transaction_date)order by doc_number, payment_transaction_date)
  order by doc_number, payment_transaction_date)  where rn =1 order by doc_number, payment_transaction_date), 

b as (select date, 1 as dummy
from
UNNEST(GENERATE_Date_ARRAY(date('2016-01-01'), current_date(), INTERVAL 1 DAY)) as date)


select distinct * from (select distinct *,format_date("%Y-%m", date) as month_date,


case when source_company= 'tabsquare_pte' then 'Singapore'
when source_company= 'tabsquare_pty' then 'Australia'
when source_company= 'tabsquare_smart_solution' then 'Indonesia'
when source_company= 'tabsquare_sdn_bhd' then 'Malaysia'
ELSE 'OTHERS' END
as Country, from (
select distinct *, case when date=last_day_every_month then buckets end as buckets_1 ,
case when date<<payment_transaction_date then total_amount*exchange_rate
else due_amount_new*exchange_rate end as new_sgd,
from

(select distinct *,max(last_day(date)) over(partition by doc_number, extract(month from date)) as last_day_every_month from 


(select distinct *, case 

when new_aging_days<<=0 AND new_status != "FULLY PAID" then "Current"
when new_aging_days >> 0 and new_aging_days <<=30 and new_status != "FULLY PAID" then ">>30 days"
when new_aging_days >>=31 and new_aging_days <<=60 and new_status != "FULLY PAID" then "30-60 days"
when new_aging_days >>=61 and new_aging_days <<90 and new_status != "FULLY PAID" then "60-90 days"
when new_aging_days >>=91 and new_status != "FULLY PAID" then "90+ days"
ELSE "FULLY PAID"
end as buckets from

 (select distinct *, 
 date_diff(date, due_date, DAY) as new_aging_days
 from 
 
 (select distinct doc_number, source_company, 
date,transaction_date,due_Date, payment_transaction_date, max_payment_transaction_day,total_amount,invoice_amount, paid_amount, paid_sum,
due_amount,due_amount_new,exchange_rate,account_manager,account_name,
case when date<<payment_transaction_date then "NOT PAID"
 else invoice_status
end as new_status,
 from b inner join a 
on b.dummy = a.dummy
and b.date>>=a.transaction_date
and b.date<<=current_date()
order by doc_number, date)order by doc_number, date)order by doc_number, date)order by doc_number, date)order by doc_number, date) order by 

doc_number, date) where buckets_1 is not null   order by doc_number, date)   order by doc_number, date)]]></relation>
          <relation connection='bigquery.1kkd9551e2i8sw1axtwhh1crtqpp' name='Custom SQL Query5' type='text'>select * from `tabsquare-data-sciences.data_analysis_team_dev.merchant_status_week_account_dashboard`</relation>
          <relation connection='bigquery.1kkd9551e2i8sw1axtwhh1crtqpp' name='Custom SQL Query11' type='text'>select * from `tabsquare-data-sciences.data_analysis_team_dev.nogmv_reason_account_dashboard`</relation>
          <relation connection='bigquery.1kkd9551e2i8sw1axtwhh1crtqpp' name='Custom SQL Query9' type='text'>select format_date(&quot;%Y-%m&quot;, created_date) as year_month,
FORMAT_DATE(&apos;%Y-%m-%d&apos;, DATE_TRUNC(created_date, WEEK(MONDAY)))  as year_month_week,
Account_Name,
name_of_account_manager,
Country,
Result,
count(distinct order_id) as order_count
from
`tabsquare-data-sciences.data_analysis_team_dev.pos_dashboard_raw_query` pos
group by 1,2,3,4,5,6</relation>
        </_.fcp.ObjectModelEncapsulateLegacy.true...relation>
