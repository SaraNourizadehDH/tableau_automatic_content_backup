    <worksheet name='Merchant Status - Month'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>Merchant Status View at Month Level</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontname='Charter'>The GMV for the current and the last 4 months are considered and based on that the merchants are categorised as follows:</run>
            <run>Æ&#10;</run>
            <run fontname='Charter'>1.</run>
            <run bold='true' fontname='Charter'>Active Increasing:</run>
            <run fontname='Charter'> GMV has increased by 20% compared to the previous month.</run>
            <run>Æ&#10;</run>
            <run fontname='Charter'>2.</run>
            <run bold='true' fontname='Charter'>Active Decreasing:</run>
            <run fontname='Charter'> GMV has decreased by 20% compared to the previous month.</run>
            <run>Æ&#10;</run>
            <run fontname='Charter'>3.</run>
            <run bold='true' fontname='Charter'>Stable:</run>
            <run fontname='Charter'> Consistent GMV over the last 4 months and current month.</run>
            <run>Æ&#10;</run>
            <run fontname='Charter'>4.</run>
            <run bold='true' fontname='Charter'>Not Active: </run>
            <run fontname='Charter'>No GMV in the current month but has GMV in prior months.</run>
            <run>Æ&#10;</run>
            <run fontname='Charter'>5.</run>
            <run bold='true' fontname='Charter'>At Risk:</run>
            <run fontname='Charter'> No GMV in the current month and the last 2 months.</run>
            <run>Æ&#10;</run>
            <run fontname='Charter'>6.</run>
            <run bold='true' fontname='Charter'>Lost</run>
            <run fontname='Charter'>: No GMV in the current and previous 3 months but had GMV earlier.</run>
            <run>Æ&#10;</run>
            <run fontname='Charter'>7.</run>
            <run bold='true' fontname='Charter'>Restarted:</run>
            <run fontname='Charter'> No GMV in the last month but has GMV in the current month and in any of the prior 4 months.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query+ (all_skipque_cdc_data_prod)' name='federated.0xgukxt059r9i61ahck5g1kpil21' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Month /Week' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0xgukxt059r9i61ahck5g1kpil21'>
            <column caption='Change in GMV wrt last month' datatype='real' name='[Calculation_1075797400705736704]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([sales (Custom SQL Query2)]-[last_1_month_gmv])/[last_1_month_gmv]' />
            </column>
            <column caption='Lost Merchant Flag(month)' datatype='integer' name='[Calculation_1075797400706023425]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if ifnull([last_3_months_gmv],0)=0 and ifnull([last_4_months_gmv],0)!=0&#13;&#10;and [first_month_flag]=0 and ifnull([sales (Custom SQL Query2)],0)=0 then 1 else 0 end' />
            </column>
            <column caption='Active Cohorts' datatype='string' name='[Calculation_1075797400706768898]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_1075797400705736704]&gt;=0.2 then &apos;Increasing&apos;&#13;&#10;ELSEIF [Calculation_1075797400705736704]&lt;-0.2 then &apos;Decreasing&apos;&#13;&#10;else &apos;Stable&apos;&#13;&#10;end' />
            </column>
            <column caption='Monthly Merchant Cohorts' datatype='string' name='[Calculation_1075797400707006467]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [first_month_flag]=1 then &apos;New&apos;&#13;&#10;ELSEIF ifnull([last_1_month_gmv],0)=0 and ifnull([last_2_months_gmv],0)&gt;0 and ifnull([sales (Custom SQL Query2)],0)=0 then &apos;At Risk of being Lost&apos;&#13;&#10;elseif ifnull([last_2_months_gmv],0)=0 and ifnull([last_3_months_gmv],0)&gt;0 and ifnull([sales (Custom SQL Query2)],0)=0 then &apos;High Risk of being Lost&apos;&#13;&#10;ELSEIF ifnull([last_1_month_gmv],0)&gt;0 and ifnull([sales (Custom SQL Query2)],0)=0 then &apos;Not Active&apos;&#13;&#10;ELSEIF ifnull([last_1_month_gmv],0)&gt;0 and ifnull([sales (Custom SQL Query2)],0)&gt;0 then [Calculation_1075797400706768898]&#13;&#10;elseif ifnull([last_1_month_gmv],0)=0  and ifnull([last_2_months_gmv],0)&gt;0 and ifnull([sales (Custom SQL Query2)],0)&gt;0 then &apos;Quick Restarted&apos;&#13;&#10;elseif ifnull([last_2_months_gmv],0)=0 and ifnull([last_3_months_gmv],0)&gt;0 and ifnull([sales (Custom SQL Query2)],0)&gt;0 then &apos;Restarted&apos;&#13;&#10;elseif ifnull([last_3_months_gmv],0)=0 and ifnull([sales (Custom SQL Query2)],0)&gt;0 then &apos;Back From Dead&apos;&#13;&#10;ELSEIF [Calculation_1075797400706023425]=1 then &apos;Lost&apos;&#13;&#10;end' />
            </column>
            <column caption='Merchant Cohorts- Category' datatype='string' name='[Calculation_1075797400707383300]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [first_month_flag]=1 then &apos;New&apos;&#13;&#10;ELSEIF [Calculation_1075797400707006467] = &apos;Not Active&apos;  then &apos;Not Active&apos;&#13;&#10;elseif [Calculation_1075797400707006467] = &apos;At Risk of being Lost&apos;&#13;&#10;        or [Calculation_1075797400707006467] = &apos;High Risk of being Lost&apos; then &apos;At Risk&apos;&#13;&#10;ELSEIF [Calculation_1075797400707006467] = &apos;Restarted&apos;&#13;&#10;        or [Calculation_1075797400707006467] = &apos;Quick Restarted&apos;&#13;&#10;        or [Calculation_1075797400707006467] = &apos;Back From Dead&apos; then &apos;Restarted&apos;&#13;&#10;else [Calculation_1075797400707006467]&#13;&#10;end' />
              <aliases>
                <alias key='&quot;Decreasing&quot;' value='Active Decreasing' />
                <alias key='&quot;Increasing&quot;' value='Active Increasing ' />
              </aliases>
            </column>
            <column caption='Time interval' datatype='string' name='[Calculation_5230931027982954496]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[year_month]' />
            </column>
            <column caption='New Merchant_ids' datatype='string' name='[Calculation_5482991869729075210]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1]=&quot;Month&quot; then [merchant_id] &#10;END' />
            </column>
            <column aggregation='Sum' caption='Sheet Selector- month' datatype='integer' name='[Calculation_617274686238822408]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Month&quot; THEN 1&#10;ELSE 0&#10;END' />
            </column>
            <column datatype='string' name='[Name_of_Account_Manager (Custom SQL Query)]' role='dimension' type='nominal' />
            <column datatype='string' name='[account_name (Custom SQL Query) #1]' role='dimension' type='nominal' />
            <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[Calculation_5482991869729075210]' derivation='CountD' name='[ctd:Calculation_5482991869729075210:qk]' pivot='key' type='quantitative' />
            <column datatype='integer' name='[first_month_flag]' role='measure' type='quantitative' />
            <column datatype='real' name='[last_1_month_gmv]' role='measure' type='quantitative' />
            <column datatype='real' name='[last_2_months_gmv]' role='measure' type='quantitative' />
            <column datatype='real' name='[last_3_months_gmv]' role='measure' type='quantitative' />
            <column datatype='real' name='[last_4_months_gmv]' role='measure' type='quantitative' />
            <column datatype='string' name='[merchant_id]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1075797400707383300]' derivation='None' name='[none:Calculation_1075797400707383300:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_5230931027982954496]' derivation='None' name='[none:Calculation_5230931027982954496:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_617274686238822408]' derivation='None' name='[none:Calculation_617274686238822408:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Name_of_Account_Manager (Custom SQL Query)]' derivation='None' name='[none:Name_of_Account_Manager (Custom SQL Query):nk]' pivot='key' type='nominal' />
            <column-instance column='[account_name (Custom SQL Query) #1]' derivation='None' name='[none:account_name (Custom SQL Query) #1:nk]' pivot='key' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column datatype='real' name='[sales (Custom SQL Query2)]' role='measure' type='quantitative' />
            <column datatype='string' name='[year_month]' role='dimension' type='nominal' />
          </datasource-dependencies>
