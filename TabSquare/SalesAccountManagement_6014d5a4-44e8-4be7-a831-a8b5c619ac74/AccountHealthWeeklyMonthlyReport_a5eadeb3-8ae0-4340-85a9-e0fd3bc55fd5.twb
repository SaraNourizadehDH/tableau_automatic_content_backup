          <filter class='categorical' column='[federated.0xgukxt059r9i61ahck5g1kpil21].[none:Calculation_617274686238822408:ok]'>
            <groupfilter function='except' user:ui-domain='database' user:ui-enumeration='exclusive' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[none:Calculation_617274686238822408:ok]' />
