    <worksheet name='Merchant Status - Week'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>Merchant Status View at Week Level</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontname='Charter'>The GMV for the current and the last 4 weeks are considered and based on that the merchants are categorised as follows:</run>
            <run>Æ&#10;</run>
            <run fontname='Charter'>1.</run>
            <run bold='true' fontname='Charter'>Active Increasing:</run>
            <run fontname='Charter'> GMV has increased by 40% compared to the previous week.</run>
            <run>Æ&#10;</run>
            <run fontname='Charter'>2.</run>
            <run bold='true' fontname='Charter'>Active Decreasing:</run>
            <run fontname='Charter'> GMV has decreased by 40% compared to the previous week.</run>
            <run>Æ&#10;</run>
            <run fontname='Charter'>3.</run>
            <run bold='true' fontname='Charter'>Stable:</run>
            <run fontname='Charter'> Consistent GMV over the last last 4 week and current week.</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
