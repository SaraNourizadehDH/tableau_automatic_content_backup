    <worksheet name='Customers'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>&lt;Sheet Name&gt; at Month Level</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query+ (all_skipque_cdc_data_prod)' name='federated.0xgukxt059r9i61ahck5g1kpil21' />
          </datasources>
          <datasource-dependencies datasource='federated.0xgukxt059r9i61ahck5g1kpil21'>
            <column caption='Customer Type' datatype='string' name='[Calculation_1696168272758276097]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [customer_id]&gt;0 then &apos;Login&apos; else &apos;Guest&apos; END' />
            </column>
            <column caption='Login Orders' datatype='integer' name='[Calculation_1696168272759255044]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if [Calculation_1696168272758276097]=&apos;Login&apos; then [orders (Custom SQL Query7)] END' />
            </column>
            <column caption='Login Sales' datatype='real' name='[Calculation_1696168272759394309]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Calculation_1696168272758276097]=&apos;Login&apos; then [sales (Custom SQL Query7)] END' />
            </column>
            <column caption='Login ABV' datatype='real' name='[Calculation_1696168272759496710]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_1696168272759394309])/ SUM([Calculation_1696168272759255044])' />
            </column>
            <column caption='Login Customer Count' datatype='integer' name='[Calculation_1696168272759603207]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if [Calculation_1696168272758276097]=&apos;Login&apos; then [customer_id] END)' />
            </column>
            <column caption='Login Orders %' datatype='real' name='[Calculation_1696168272759951369]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_1696168272759255044])/SUM([orders (Custom SQL Query7)])' />
            </column>
            <column caption='Guest Sales' datatype='real' name='[Calculation_1696168272760696844]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Calculation_1696168272758276097]=&apos;Guest&apos; then [sales (Custom SQL Query7)] END' />
            </column>
            <column caption='Guest Orders %' datatype='real' name='[Calculation_1696168272760786957]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Login ABV (copy)_1696168272760516619])/sum([orders (Custom SQL Query7)])' />
            </column>
            <column caption='Guest ABV' datatype='real' name='[Calculation_1696168272760983566]' role='measure' type='quantitative'>
