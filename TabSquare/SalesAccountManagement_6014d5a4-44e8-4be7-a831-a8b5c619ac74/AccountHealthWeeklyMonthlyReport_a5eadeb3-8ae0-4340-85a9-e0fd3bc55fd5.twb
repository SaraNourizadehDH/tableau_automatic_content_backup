                <zone fixed-size='220' h='8508' id='344' is-fixed='true' name='Implementation Overview' w='86300' x='1100' y='47414'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='8508' id='354' type-v2='text' w='11500' x='87400' y='47414'>
                  <formatted-text>
                    <run bold='true' fontsize='8'>Description:</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontsize='7'>Merchant categorization based on the Buckets created based on Sales Over The Month</run>
                    <run>Æ&#10;</run>
                    <run fontsize='6'>Low: 0-20K </run>
                    <run>Æ&#10;</run>
                    <run fontsize='6'>Medium: 20K- 100K </run>
                    <run>Æ&#10;</run>
                    <run fontsize='6'>High: &gt;100K</run>
                    <run>Æ&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='278' h='10677' id='862' is-fixed='true' name='Freshdesk' w='58100' x='1100' y='55922'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone h='10677' id='1317' type-v2='text' w='39700' x='59200' y='55922'>
                  <formatted-text>
                    <run fontcolor='#000000' fontname='Roboto' fontsize='7'>Freshdesk has group name that are categorized as L1,  L3 and others</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Roboto' fontsize='7'>L1</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Roboto' fontsize='7'>Refund Support,   SG-On-Site Support,   Supportdesk AU,   Supportdesk ID,   Supportdesk MY,   Supportdesk SG</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Roboto' fontsize='7'>L3 </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Roboto' fontsize='7'>L2-CMS-Support,  L2-Console-Support, L2-CRM-Support, L2-Data Analytics-Support, L2-eCMS-Support, L2-Hardware-Support, L2-Integration-Support, L2-Payment-Support, L2-SmartConnect-Support, L2-SmartKiosk-Support, L2-SmartQ-Support, L2-SmartTab-Support, L2-SmartWeb-Support, L2-Support, L3-CMS-Support, L3-Console-Support, L3-CRM-Support, L3-Data Analytics-Support, L3-Delivery-Support, L3-eCMS-Support, L3-Hardware-Support, L3-Integration-Support, L3-Payment-Support, L3-SmartConnect-Support, L3-SmartKiosk-Support, L3-SmartQ-Support, L3-SmartTab-Support, L3-SmartWeb-Support, L3-Void Order-Support, Supportdesk - L2</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Roboto' fontsize='7'>Others</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Roboto' fontsize='7'>Finance, Payment, Implementation, Merchant Data Support</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='178' h='6882' id='1246' is-fixed='true' name='Success/Failed' w='97800' x='1100' y='66599'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='198' h='7704' id='1248' is-fixed='true' name='Rating Month Level' w='77000' x='1100' y='73481'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone h='7704' id='1316' type-v2='text' w='20800' x='78100' y='73481'>
                  <formatted-text>
                    <run fontsize='7'>There is 5 point rating with 1 as lowest and 5 as highest, for which categorization has been done as</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontsize='7'>Negative Rating:</run>
                    <run fontsize='7'> 1 and 2</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontsize='7'>Neutral Rating:</run>
                    <run fontsize='7'>3</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontsize='7'>Positive Rating:</run>
                    <run fontsize='7'> 4 and 5</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='266' h='10232' id='702' is-fixed='true' name='Merchant Status - Month' w='62900' x='1100' y='81185'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone h='10232' id='1321' type-v2='text' w='34900' x='64000' y='81185'>
                  <formatted-text>
                    <run fontname='Charter' fontsize='7'>The GMV for the current and the last 4 months are considered and based on that the merchants are categorised as follows:</run>
                    <run>Æ&#10;</run>
                    <run fontname='Charter' fontsize='7'>1.</run>
                    <run bold='true' fontname='Charter' fontsize='7'>Active Increasing:</run>
                    <run fontname='Charter' fontsize='7'> GMV has increased by 20% compared to the previous month.</run>
                    <run>Æ&#10;</run>
                    <run fontname='Charter' fontsize='7'>2.</run>
                    <run bold='true' fontname='Charter' fontsize='7'>Active Decreasing:</run>
                    <run fontname='Charter' fontsize='7'> GMV has decreased by 20% compared to the previous month.</run>
                    <run>Æ&#10;</run>
                    <run fontname='Charter' fontsize='7'>3.</run>
                    <run bold='true' fontname='Charter' fontsize='7'>Stable:</run>
                    <run fontname='Charter' fontsize='7'> Consistent GMV over the last 4 months and current month.</run>
                    <run>Æ&#10;</run>
                    <run fontname='Charter' fontsize='7'>4.</run>
                    <run bold='true' fontname='Charter' fontsize='7'>Not Active: </run>
                    <run fontname='Charter' fontsize='7'>No GMV in the current month but has GMV in prior months.</run>
                    <run>Æ&#10;</run>
                    <run fontname='Charter' fontsize='7'>5.</run>
                    <run bold='true' fontname='Charter' fontsize='7'>At Risk:</run>
                    <run fontname='Charter' fontsize='7'> No GMV in the current month and the last 2 months.</run>
                    <run>Æ&#10;</run>
                    <run fontname='Charter' fontsize='7'>6.</run>
                    <run bold='true' fontname='Charter' fontsize='7'>Lost</run>
                    <run fontname='Charter' fontsize='7'>: No GMV in the current and previous 3 months but had GMV earlier.</run>
                    <run>Æ&#10;</run>
                    <run fontname='Charter' fontsize='7'>7.</run>
                    <run bold='true' fontname='Charter' fontsize='7'>Restarted:</run>
                    <run fontname='Charter' fontsize='7'> No GMV in the last month but has GMV in the current month and in any of the prior 4 months.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='211' h='8176' id='1318' is-fixed='true' name='Merchant Status - Month (2)' w='97800' x='1100' y='91417'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#555555' />
                <format attr='border-style' value='solid' />
                <format attr='border-width' value='3' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
