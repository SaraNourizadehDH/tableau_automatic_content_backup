      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='GMV- Product level' id='_1E28E006EA3B4C7AAF598B2ACDB39FA6'>
            <properties context=''>
              <relation connection='bigquery.1kkd9551e2i8sw1axtwhh1crtqpp' name='Custom SQL Query7' type='text'>select * from `tabsquare-data-sciences.data_analysis_team_dev.productgmv_week_month_account_dashboard`</relation>
            </properties>
            <properties context='extract'>
              <relation name='_1E28E006EA3B4C7AAF598B2ACDB39FA6' table='[Extract].[_1E28E006EA3B4C7AAF598B2ACDB39FA6]' type='table' />
