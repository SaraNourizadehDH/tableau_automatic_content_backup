      <column caption='AM GMV (copy)' datatype='integer' name='[AM GMV (copy)_897764479652757505]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [account_manager (Custom SQL Query9) (group)]= &quot;Account Management&quot; THEN [custom_gmv] END' />
      </column>
      <column caption='AM Created Deals' datatype='integer' name='[AM Lost Deals (copy)_778559826685661193]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_1075797400715599878]= &quot;Account Management&quot; then [Calculation_130745161446907905] end' />
      </column>
      <column caption='AM Lost Deals' datatype='integer' name='[AM Won Deals  (copy)_778559826685116422]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_1075797400715599878]= &quot;Account Management&quot; then [created deals (copy)_130745161447063555] end' />
      </column>
      <column caption='Account_Name ' datatype='string' name='[Account_Name (Custom SQL Query11)]' role='dimension' type='nominal' />
      <column caption='Active Cohorts (copy)' datatype='string' name='[Active Cohorts (copy)_617274686236479492]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_617274686228987905]&gt;=0.4 then &apos;Increasing&apos;&#13;&#10;ELSEIF [Calculation_617274686228987905]&lt;-0.4 then &apos;Decreasing&apos;&#13;&#10;else &apos;Stable&apos;&#13;&#10;end' />
      </column>
      <column caption='Buckets (copy)' datatype='string' name='[Buckets (copy)_778559826681905154]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_1075797400781545493]&gt;=0 and [Calculation_1075797400781545493]&lt; 20000 then &quot;Low&quot;&#13;&#10;ELSEIF [Calculation_1075797400781545493]&gt;=20000 and [Calculation_1075797400781545493]&lt; 100000 then &quot;Medium&quot;&#13;&#10;ELSEIF [Calculation_1075797400781545493]&gt;=100000  then &quot;High&quot;&#13;&#10;END' />
      </column>
      <column caption='Change in GMV wrt last month' datatype='real' name='[Calculation_1075797400705736704]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([sales (Custom SQL Query2)]-[last_1_month_gmv])/[last_1_month_gmv]' />
      </column>
      <column caption='Lost Merchant Flag(month)' datatype='integer' name='[Calculation_1075797400706023425]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if ifnull([last_3_months_gmv],0)=0 and ifnull([last_4_months_gmv],0)!=0&#13;&#10;and [first_month_flag]=0 and ifnull([sales (Custom SQL Query2)],0)=0 then 1 else 0 end' />
      </column>
      <column caption='Active Cohorts' datatype='string' name='[Calculation_1075797400706768898]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_1075797400705736704]&gt;=0.2 then &apos;Increasing&apos;&#13;&#10;ELSEIF [Calculation_1075797400705736704]&lt;-0.2 then &apos;Decreasing&apos;&#13;&#10;else &apos;Stable&apos;&#13;&#10;end' />
      </column>
