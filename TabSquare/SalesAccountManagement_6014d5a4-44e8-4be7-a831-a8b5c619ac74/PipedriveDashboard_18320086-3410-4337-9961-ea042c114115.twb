          <datasource-dependencies datasource='Parameters'>
            <column caption='Date' datatype='date' default-format='*MMM YYYY' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2023-05-31#'>
              <calculation class='tableau' formula='#2023-05-31#' />
              <aliases>
                <alias key='#2022-11-30#' value='Nov 2022' />
                <alias key='#2022-12-30#' value='Dec 2022' />
                <alias key='#2023-01-30#' value='Jan 2023' />
                <alias key='#2023-02-28#' value='Feb 2023' />
                <alias key='#2023-03-30#' value='Mar 2023' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.10x6wjm0mkx7aj1dgcrt31jyjlun'>
            <column caption=' # of days proposal made to won' datatype='integer' name='[ # of days first meeting to proposal made (copy)_5337469250964742173]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [id]: (DATEDIFF(&apos;day&apos;, [Calculation_5337469250963718172], [proposal made - stage update time -won  (copy)_5337469250962702361]))}' />
            </column>
            <column caption='proposal made - min ' datatype='date' name='[Calculation_5337469250963718172]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='MIN([proposal made - stage change time  (copy)_5337469250962419735])' />
            </column>
            <column caption='account_management' datatype='string' name='[account_manager]' role='dimension' type='nominal' />
            <column-instance column='[ # of days first meeting to proposal made (copy)_5337469250964742173]' derivation='Avg' name='[avg: # of days first meeting to proposal made (copy)_5337469250964742173:qk]' pivot='key' type='quantitative' />
            <column caption='current month update date' datatype='boolean' name='[current month stage (copy)_5181813588951744513]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='MONTH([date]) = month(DATEADD(&apos;month&apos;, 0, [Parameters].[Parameter 1])) and YEAR([date]) = year(DATEADD(&apos;month&apos;, 0, [Parameters].[Parameter 1]))' />
            </column>
            <column datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column aggregation='Sum' datatype='integer' name='[id]' role='dimension' type='ordinal' />
            <column datatype='string' name='[name (group)]' role='dimension' type='nominal'>
