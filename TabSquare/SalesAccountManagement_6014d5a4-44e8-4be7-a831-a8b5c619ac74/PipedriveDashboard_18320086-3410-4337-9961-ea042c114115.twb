            <column-instance column='[user_name]' derivation='None' name='[none:user_name:nk]' pivot='key' type='nominal' />
            <column caption='proposal made -  update time' datatype='date' name='[proposal made - stage change time  (copy)_5337469250962419735]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF  [name (group)]=&quot;proposal made &amp; targeting closure&quot; and status = &quot;open&quot; then [date] END' />
            </column>
            <column caption='proposal made - stage update time -won ' datatype='date' name='[proposal made - stage update time (copy)_5337469250962546712]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [current month stage (copy)_5181813588951744513]= True and [status]= &quot;won&quot; and  [name (group)]=&quot;proposal made &amp; targeting closure&quot; then [date] END' />
            </column>
            <column caption='proposal made - stage update time -won - max date' datatype='date' name='[proposal made - stage update time -won  (copy)_5337469250962702361]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='MAX([proposal made - stage update time (copy)_5337469250962546712])' />
