              <calculation class='tableau' formula='{ FIXED [account_manager], [user_name] : [count distinct deals 1 month  (copy)_6835549447273005069]}' />
            </column>
            <column aggregation='Sum' datatype='integer' name='[id]' role='dimension' type='ordinal' />
            <column datatype='string' name='[name (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[name]' new-bin='true'>
                <bin default-name='false' value='&quot;1st meeting, 1st meeting with decision maker&quot;'>
