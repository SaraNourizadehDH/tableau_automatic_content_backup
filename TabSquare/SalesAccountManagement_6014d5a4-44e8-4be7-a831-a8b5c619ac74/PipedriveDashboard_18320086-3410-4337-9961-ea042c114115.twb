    <worksheet name='conversion rate - AM'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>Conversion Rates (AM)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (pipedrive)' name='federated.10x6wjm0mkx7aj1dgcrt31jyjlun' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date' datatype='date' default-format='*MMM YYYY' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2023-05-31#'>
              <calculation class='tableau' formula='#2023-05-31#' />
              <aliases>
                <alias key='#2022-11-30#' value='Nov 2022' />
                <alias key='#2022-12-30#' value='Dec 2022' />
                <alias key='#2023-01-30#' value='Jan 2023' />
                <alias key='#2023-02-28#' value='Feb 2023' />
                <alias key='#2023-03-30#' value='Mar 2023' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.10x6wjm0mkx7aj1dgcrt31jyjlun'>
            <column caption='1st meeting deals 3 month ' datatype='integer' name='[1st meeting deals 1 month (copy)_6835549447269134336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [name (group)]= &quot;1st meeting, 1st meeting with decision maker&quot;  and [Calculation_4903434836252639256]= True and [Calculation_4903434836434198590]= True then id end' />
            </column>
            <column caption='last to last month' datatype='integer' name='[Calculation2 (copy)_4903434836487082053]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF MONTH([date]) = month(DATEADD(&apos;month&apos;, -2, [Parameters].[Parameter 1])) and YEAR([date]) = year(DATEADD(&apos;month&apos;, -2, [Parameters].[Parameter 1])) and [status]&lt;&gt;&quot;open&quot;&#10;then 1 else 0 END' />
            </column>
            <column caption='unqualified deals 1 month' datatype='integer' name='[Calculation_4903434836229627905]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [name (group)]= &quot;opportunities (unqualified deals)&quot;  and [Calculation_4903434836252266519]= True then [id]  end' />
            </column>
            <column caption='count distinct unqualified 1 month' datatype='integer' name='[Calculation_4903434836231307270]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_4903434836229627905])+COUNTD([unqualified deals (copy)_4903434836229738498])+COUNTD([unqualified deals (copy) (copy)_4903434836229750787])+COUNTD([unqualified deals (copy) (copy) (copy)_4903434836229763076])+COUNTD([unqualified deals (copy) (copy) (copy) (copy)_4903434836229779461])' />
            </column>
            <column caption='current month stage' datatype='boolean' name='[Calculation_4903434836252266519]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='MONTH([stage_change_time]) = month(DATEADD(&apos;month&apos;, 0, [Parameters].[Parameter 1])) and YEAR([stage_change_time]) = year(DATEADD(&apos;month&apos;, 0, [Parameters].[Parameter 1]))' />
            </column>
            <column caption='3 months date' datatype='boolean' name='[Calculation_4903434836252639256]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='MONTH([date]) = month(DATEADD(&apos;month&apos;, -2, [Parameters].[Parameter 1])) and YEAR([date]) = year(DATEADD(&apos;month&apos;, -2, [Parameters].[Parameter 1]))&#10;or MONTH([date]) = month(DATEADD(&apos;month&apos;, -1, [Parameters].[Parameter 1])) and YEAR([date]) = year(DATEADD(&apos;month&apos;, -1, [Parameters].[Parameter 1])) or &#10;MONTH([date]) = month(DATEADD(&apos;month&apos;, 0, [Parameters].[Parameter 1])) and YEAR([date]) = year(DATEADD(&apos;month&apos;, 0, [Parameters].[Parameter 1]))' />
            </column>
            <column caption='excluding deals having lost , deleted and won in the past months' datatype='boolean' name='[Calculation_4903434836434198590]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_5210031454883311618]= 0 and  [Calculation_5210031454883237889]=0' />
            </column>
            <column caption='last month ' datatype='integer' name='[Calculation_4903434836473237570]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF MONTH([date]) = month(DATEADD(&apos;month&apos;, -1, [Parameters].[Parameter 1])) and YEAR([date]) = year(DATEADD(&apos;month&apos;, -1, [Parameters].[Parameter 1])) and [status]&lt;&gt;&quot;open&quot;&#10;then 1  else 0 END' />
            </column>
            <column caption='MAX([last to last month])' datatype='integer' name='[Calculation_5210031454883237889]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='{fixed [id] : MAX([Calculation2 (copy)_4903434836487082053])}' />
            </column>
            <column caption='MAX([last month ])' datatype='integer' name='[Calculation_5210031454883311618]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED id: MAX([Calculation_4903434836473237570])}' />
            </column>
            <column caption='conversion rate- qd- 1st meeting' datatype='real' name='[Calculation_6835549447276302370]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([fixed unqualifed 1 month (copy) (copy) (copy)_6835549447274209303])/ SUM([fixed qualifed 1 month  (copy)_6835549447274799132])' />
            </column>
            <column caption='account_management' datatype='string' name='[account_manager]' role='dimension' type='nominal' />
            <column caption='conversion rate- proposal to win' datatype='real' name='[conversion rate- qd- 1st meeting (copy) (copy)_6835549447276474404]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([fixed proposal 1 month  (copy)_6835549447275860000])/ SUM([fixed proposal 3 month (copy)_6835549447275868193])' />
            </column>
            <column caption='conversion rate-  1st meeting to tc ' datatype='real' name='[conversion rate- qd- 1st meeting (copy)_6835549447276470307]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([fixed unqualifed 1 month (copy) (copy) (copy) (copy)_6835549447274217496])/ SUM([fixed 1st meet 1 month (copy)_6835549447274766361])' />
            </column>
            <column caption='count distinct tc 1 month' datatype='integer' name='[count distinct 1st meet 1 month (copy)_6835549447273246734]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[count distinct deals 1 month  (copy)_6835549447273005069] -COUNTD([unqualified deals (copy) (copy) (copy)_4903434836229763076] )' />
            </column>
            <column caption='count distinct 1st meet 3 month' datatype='integer' name='[count distinct 1st meet 1 month (copy)_6835549447273406479]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[count distinct deals 1 month  (copy)_6835549447273414672] -COUNTD([deal engaging deals 1 month (copy)_6835549447269142529] )' />
            </column>
            <column caption='count distinct 1st meet 1 month' datatype='integer' name='[count distinct deals 1 month  (copy)_6835549447273005069]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[count distinct qualified 1 month  (copy)_6835549447272849419] -COUNTD([unqualified deals (copy) (copy)_4903434836229750787] )' />
            </column>
            <column caption='count distinct deals 3 month' datatype='integer' name='[count distinct deals 1 month  (copy)_6835549447273414672]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[count distinct qualified 1 month  (copy)_6835549447273422865]-COUNTD([qualified deals 1 month (copy)_6835549447269150722])' />
            </column>
            <column caption='count distinct deals 1 month ' datatype='integer' name='[count distinct qualified 1 month  (copy)_6835549447272849419]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[count distinct unqualified 1 month (copy)_6835549447272722442]-COUNTD([unqualified deals (copy)_4903434836229738498])' />
            </column>
            <column caption='count distinct qualified 3 month ' datatype='integer' name='[count distinct qualified 1 month  (copy)_6835549447273422865]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total (copy)_6835549447269797893]-COUNTD([unqualified deals 1 month (copy)_6835549447269154819])' />
            </column>
            <column caption='count distinct qualified 1 month ' datatype='integer' name='[count distinct unqualified 1 month (copy)_6835549447272722442]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4903434836231307270]-COUNTD([Calculation_4903434836229627905])' />
