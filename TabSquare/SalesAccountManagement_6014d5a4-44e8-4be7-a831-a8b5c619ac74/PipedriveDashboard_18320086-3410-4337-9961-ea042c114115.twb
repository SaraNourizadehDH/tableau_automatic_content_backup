                </bin>
                <bin default-name='true' value='&quot;proposal made &amp; targeting closure&quot;'>
                  <value>&quot;proposal made&quot;</value>
                  <value>&quot;targeting closure&quot;</value>
                </bin>
                <bin default-name='true' value='&quot;qualified deals &amp; qualified leads&quot;'>
