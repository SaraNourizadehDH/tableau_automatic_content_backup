              <calculation class='tableau' formula='MAX([1st meeting date - max -if  (copy)_4903434836418166838])' />
            </column>
            <column caption='proposal made date' datatype='date' name='[Calculation_4903434836418678841]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='MAX([1st meeting date -min if  (copy)_4903434836418318391])' />
            </column>
