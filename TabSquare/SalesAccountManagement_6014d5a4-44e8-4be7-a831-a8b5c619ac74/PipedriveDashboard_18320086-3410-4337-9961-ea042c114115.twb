              <calculation class='tableau' formula='{ FIXED id : (DATEDIFF(&apos;day&apos;, [Calculation_4903434836418596920], [Calculation_4903434836418678841]))}' />
            </column>
            <column datatype='date' datatype-customized='true' name='[stage_change_time]' role='dimension' type='ordinal' />
            <column datatype='string' name='[status]' role='dimension' type='nominal' />
            <column datatype='string' name='[user_name]' role='dimension' type='nominal' />
