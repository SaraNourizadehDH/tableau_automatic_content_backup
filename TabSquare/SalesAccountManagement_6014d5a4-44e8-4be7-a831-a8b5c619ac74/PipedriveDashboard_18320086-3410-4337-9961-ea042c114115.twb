              <calculation class='tableau' formula='{ FIXED [account_manager], [user_name] : [count distinct 1st meet 1 month (copy)_6835549447273406479]}' />
            </column>
            <column caption='fixed win rate 1 month' datatype='integer' name='[fixed proposal 1 month  (copy)_6835549447275860000]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [account_manager], [user_name] : COUNTD([proposal made 1 month (copy)_6835549447275679774])}' />
            </column>
            <column caption='fixed win 3 month' datatype='integer' name='[fixed proposal 3 month (copy)_6835549447275868193]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [account_manager], [user_name] : COUNTD([proposal made 3 month  (copy)_6835549447275687967])}' />
            </column>
            <column caption='fixed qualifed 3 month' datatype='integer' name='[fixed qualifed 1 month  (copy)_6835549447274799132]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [account_manager], [user_name] : [count distinct qualified 1 month  (copy)_6835549447273422865]}' />
            </column>
            <column caption='fixed proposal 1 month ' datatype='integer' name='[fixed unqualifed 1 month (copy) (copy) (copy) (copy)_6835549447274217496]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [account_manager], [user_name] : [count distinct 1st meet 1 month (copy)_6835549447273246734]}' />
            </column>
