      <column caption=' # of days proposal made to won' datatype='integer' name='[ # of days first meeting to proposal made (copy)_5337469250964742173]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [id]: (DATEDIFF(&apos;day&apos;, [Calculation_5337469250963718172], [proposal made - stage update time -won  (copy)_5337469250962702361]))}' />
      </column>
      <column caption='1st meeting date - max -if ' datatype='date' name='[1st meeting date - max (copy 2)_4903434836273516591]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [Calculation_4903434836252266519]=True and [name (group)]=&quot;1st meeting, 1st meeting with decision maker&quot; then [stage_change_time] END' />
      </column>
      <column caption='qualified deals - stage change time' datatype='date' name='[1st meeting date - max (copy)_4903434836273254446]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF  [name (group)]=&quot;qualified deals &amp; qualified leads&quot; then [stage_change_time] END' />
