    <worksheet name='Slide 3 win rate Over all'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>Winning Rate </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (pipedrive)' name='federated.10x6wjm0mkx7aj1dgcrt31jyjlun' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date' datatype='date' default-format='*MMM YYYY' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2023-05-31#'>
              <calculation class='tableau' formula='#2023-05-31#' />
              <aliases>
                <alias key='#2022-11-30#' value='Nov 2022' />
                <alias key='#2022-12-30#' value='Dec 2022' />
                <alias key='#2023-01-30#' value='Jan 2023' />
                <alias key='#2023-02-28#' value='Feb 2023' />
                <alias key='#2023-03-30#' value='Mar 2023' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.10x6wjm0mkx7aj1dgcrt31jyjlun'>
            <column caption='last to last month' datatype='integer' name='[Calculation2 (copy)_4903434836487082053]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF MONTH([date]) = month(DATEADD(&apos;month&apos;, -2, [Parameters].[Parameter 1])) and YEAR([date]) = year(DATEADD(&apos;month&apos;, -2, [Parameters].[Parameter 1])) and [status]&lt;&gt;&quot;open&quot;&#10;then 1 else 0 END' />
            </column>
            <column caption='current month stage' datatype='boolean' name='[Calculation_4903434836252266519]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='MONTH([stage_change_time]) = month(DATEADD(&apos;month&apos;, 0, [Parameters].[Parameter 1])) and YEAR([stage_change_time]) = year(DATEADD(&apos;month&apos;, 0, [Parameters].[Parameter 1]))' />
            </column>
            <column caption='3 months date' datatype='boolean' name='[Calculation_4903434836252639256]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='MONTH([date]) = month(DATEADD(&apos;month&apos;, -2, [Parameters].[Parameter 1])) and YEAR([date]) = year(DATEADD(&apos;month&apos;, -2, [Parameters].[Parameter 1]))&#10;or MONTH([date]) = month(DATEADD(&apos;month&apos;, -1, [Parameters].[Parameter 1])) and YEAR([date]) = year(DATEADD(&apos;month&apos;, -1, [Parameters].[Parameter 1])) or &#10;MONTH([date]) = month(DATEADD(&apos;month&apos;, 0, [Parameters].[Parameter 1])) and YEAR([date]) = year(DATEADD(&apos;month&apos;, 0, [Parameters].[Parameter 1]))' />
            </column>
            <column caption='excluding deals having lost , deleted and won in the past months' datatype='boolean' name='[Calculation_4903434836434198590]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_5210031454883311618]= 0 and  [Calculation_5210031454883237889]=0' />
            </column>
            <column caption='last month ' datatype='integer' name='[Calculation_4903434836473237570]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF MONTH([date]) = month(DATEADD(&apos;month&apos;, -1, [Parameters].[Parameter 1])) and YEAR([date]) = year(DATEADD(&apos;month&apos;, -1, [Parameters].[Parameter 1])) and [status]&lt;&gt;&quot;open&quot;&#10;then 1  else 0 END' />
            </column>
            <column caption='MAX([last to last month])' datatype='integer' name='[Calculation_5210031454883237889]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='{fixed [id] : MAX([Calculation2 (copy)_4903434836487082053])}' />
            </column>
            <column caption='MAX([last month ])' datatype='integer' name='[Calculation_5210031454883311618]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED id: MAX([Calculation_4903434836473237570])}' />
            </column>
            <column caption='COUNTD([win rate numerator  ])/ COUNTD([win rate - denominato...' datatype='real' name='[Calculation_5337469250979065894]' role='measure' type='quantitative' user:unnamed='win rate'>
              <calculation class='tableau' formula='COUNTD([Calculation_5337469250977157153])/ COUNTD([win rate - denominator- 3 months (copy)_5337469250978140195])' />
            </column>
            <column caption='account_management' datatype='string' name='[account_manager]' role='dimension' type='nominal' />
            <column caption='conversion rate- proposal to win' datatype='real' name='[conversion rate- qd- 1st meeting (copy) (copy)_6835549447276474404]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([fixed proposal 1 month  (copy)_6835549447275860000])/ SUM([fixed proposal 3 month (copy)_6835549447275868193])' />
            </column>
            <column datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column caption='fixed win rate 1 month' datatype='integer' name='[fixed proposal 1 month  (copy)_6835549447275860000]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [account_manager], [user_name] : COUNTD([proposal made 1 month (copy)_6835549447275679774])}' />
            </column>
            <column caption='fixed win 3 month' datatype='integer' name='[fixed proposal 3 month (copy)_6835549447275868193]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [account_manager], [user_name] : COUNTD([proposal made 3 month  (copy)_6835549447275687967])}' />
            </column>
            <column aggregation='Sum' datatype='integer' name='[id]' role='dimension' type='ordinal' />
            <column datatype='string' name='[name (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[name]' new-bin='true'>
                <bin default-name='false' value='&quot;1st meeting, 1st meeting with decision maker&quot;'>
                  <value>&quot;1st meeting&quot;</value>
                  <value>&quot;1st meeting with decision maker&quot;</value>
                  <value>&quot;meeting with decision maker&quot;</value>
                </bin>
                <bin default-name='true' value='&quot;existing client &amp; existing clients&quot;'>
                  <value>&quot;existing client&quot;</value>
                  <value>&quot;existing clients&quot;</value>
                </bin>
                <bin default-name='true' value='&quot;proposal made &amp; targeting closure&quot;'>
                  <value>&quot;proposal made&quot;</value>
                  <value>&quot;targeting closure&quot;</value>
                </bin>
                <bin default-name='true' value='&quot;qualified deals &amp; qualified leads&quot;'>
                  <value>&quot;qualified deals&quot;</value>
                  <value>&quot;qualified leads&quot;</value>
                </bin>
              </calculation>
            </column>
            <column datatype='string' name='[name]' role='dimension' type='nominal' />
            <column-instance column='[account_manager]' derivation='None' name='[none:account_manager:nk]' pivot='key' type='nominal' />
            <column-instance column='[user_name]' derivation='None' name='[none:user_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[conversion rate- qd- 1st meeting (copy) (copy)_6835549447276474404]' derivation='User' name='[pcdf:usr:conversion rate- qd- 1st meeting (copy) (copy)_6835549447276474404:qk]' pivot='key' type='quantitative'>
              <table-calc diff-options='Relative' ordering-type='Rows' type='PctDiff'>
                <address>
                  <value>-1</value>
                </address>
              </table-calc>
            </column-instance>
            <column caption='win rate 1 month ' datatype='integer' name='[proposal made 1 month (copy)_6835549447275679774]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [name (group)]= &quot;signed quotation&quot; and [Calculation_4903434836252266519]= True and [status]=&quot;won&quot; then id end' />
            </column>
            <column caption='win rate 3 month' datatype='integer' name='[proposal made 3 month  (copy)_6835549447275687967]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [name (group)]= &quot;proposal made &amp; targeting closure&quot; and [Calculation_4903434836252639256]= True and [Calculation_4903434836434198590]= True then id end' />
            </column>
            <column datatype='date' datatype-customized='true' name='[stage_change_time]' role='dimension' type='ordinal' />
            <column datatype='string' name='[status]' role='dimension' type='nominal' />
            <column datatype='string' name='[user_name]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_5337469250979065894]' derivation='User' name='[usr:Calculation_5337469250979065894:qk]' pivot='key' type='quantitative' />
            <column-instance column='[conversion rate- qd- 1st meeting (copy) (copy)_6835549447276474404]' derivation='User' name='[usr:conversion rate- qd- 1st meeting (copy) (copy)_6835549447276474404:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
