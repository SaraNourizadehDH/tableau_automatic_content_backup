          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date' datatype='date' default-format='*MMM YYYY' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2023-05-31#'>
              <calculation class='tableau' formula='#2023-05-31#' />
              <aliases>
                <alias key='#2022-11-30#' value='Nov 2022' />
                <alias key='#2022-12-30#' value='Dec 2022' />
                <alias key='#2023-01-30#' value='Jan 2023' />
                <alias key='#2023-02-28#' value='Feb 2023' />
                <alias key='#2023-03-30#' value='Mar 2023' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.10x6wjm0mkx7aj1dgcrt31jyjlun'>
            <column caption=' # of days proposal made to won' datatype='integer' name='[ # of days first meeting to proposal made (copy)_5337469250964742173]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [id]: (DATEDIFF(&apos;day&apos;, [Calculation_5337469250963718172], [proposal made - stage update time -won  (copy)_5337469250962702361]))}' />
            </column>
            <column caption='1st meeting date - max -if ' datatype='date' name='[1st meeting date - max (copy 2)_4903434836273516591]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Calculation_4903434836252266519]=True and [name (group)]=&quot;1st meeting, 1st meeting with decision maker&quot; then [stage_change_time] END' />
            </column>
            <column caption='qualified deals - stage change time' datatype='date' name='[1st meeting date - max (copy)_4903434836273254446]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF  [name (group)]=&quot;qualified deals &amp; qualified leads&quot; then [stage_change_time] END' />
            </column>
            <column caption='1st meeting date -min if ' datatype='date' name='[1st meeting date - max -if  (copy)_4903434836418166838]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [name (group)]=&quot;1st meeting, 1st meeting with decision maker&quot; then [stage_change_time] END' />
            </column>
            <column caption='proposal made - stage change time ' datatype='date' name='[1st meeting date -min if  (copy)_4903434836418318391]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Calculation_4903434836252266519]=True and [name (group)]=&quot;proposal made &amp; targeting closure&quot; then [stage_change_time] END' />
            </column>
            <column caption='current month stage' datatype='boolean' name='[Calculation_4903434836252266519]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='MONTH([stage_change_time]) = month(DATEADD(&apos;month&apos;, 0, [Parameters].[Parameter 1])) and YEAR([stage_change_time]) = year(DATEADD(&apos;month&apos;, 0, [Parameters].[Parameter 1]))' />
            </column>
            <column caption='1st Meeting Date' datatype='date' name='[Calculation_4903434836274999344]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='MAX([1st meeting date - max (copy 2)_4903434836273516591])' />
            </column>
            <column caption='Qualified Deals  date' datatype='date' name='[Calculation_4903434836417888309]' role='measure' type='ordinal'>
