            <column-instance column='[ # of days first meeting to proposal made (copy)_5337469250964742173]' derivation='Avg' name='[avg: # of days first meeting to proposal made (copy)_5337469250964742173:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_4903434836429910076]' derivation='Avg' name='[avg:Calculation_4903434836429910076:qk]' pivot='key' type='quantitative' />
            <column-instance column='[qualified deals to first meeting (copy)_4903434836430790717]' derivation='Avg' name='[avg:qualified deals to first meeting (copy)_4903434836430790717:qk]' pivot='key' type='quantitative' />
            <column-instance column='[ # of days first meeting to proposal made (copy)_5337469250964742173]' derivation='Count' name='[cnt: # of days first meeting to proposal made (copy)_5337469250964742173:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_4903434836429910076]' derivation='Count' name='[cnt:Calculation_4903434836429910076:qk]' pivot='key' type='quantitative' />
            <column-instance column='[qualified deals to first meeting (copy)_4903434836430790717]' derivation='Count' name='[cnt:qualified deals to first meeting (copy)_4903434836430790717:qk]' pivot='key' type='quantitative' />
            <column caption='current month update date' datatype='boolean' name='[current month stage (copy)_5181813588951744513]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='MONTH([date]) = month(DATEADD(&apos;month&apos;, 0, [Parameters].[Parameter 1])) and YEAR([date]) = year(DATEADD(&apos;month&apos;, 0, [Parameters].[Parameter 1]))' />
            </column>
            <column datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column aggregation='Sum' datatype='integer' name='[id]' role='dimension' type='ordinal' />
            <column datatype='string' name='[name (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[name]' new-bin='true'>
                <bin default-name='false' value='&quot;1st meeting, 1st meeting with decision maker&quot;'>
                  <value>&quot;1st meeting&quot;</value>
                  <value>&quot;1st meeting with decision maker&quot;</value>
                  <value>&quot;meeting with decision maker&quot;</value>
                </bin>
                <bin default-name='true' value='&quot;existing client &amp; existing clients&quot;'>
                  <value>&quot;existing client&quot;</value>
                  <value>&quot;existing clients&quot;</value>
                </bin>
                <bin default-name='true' value='&quot;proposal made &amp; targeting closure&quot;'>
                  <value>&quot;proposal made&quot;</value>
                  <value>&quot;targeting closure&quot;</value>
                </bin>
                <bin default-name='true' value='&quot;qualified deals &amp; qualified leads&quot;'>
                  <value>&quot;qualified deals&quot;</value>
                  <value>&quot;qualified leads&quot;</value>
                </bin>
              </calculation>
            </column>
            <column datatype='string' name='[name]' role='dimension' type='nominal' />
            <column-instance column='[account_manager]' derivation='None' name='[none:account_manager:nk]' pivot='key' type='nominal' />
            <column-instance column='[user_name]' derivation='None' name='[none:user_name:nk]' pivot='key' type='nominal' />
            <column caption='proposal made -  update time' datatype='date' name='[proposal made - stage change time  (copy)_5337469250962419735]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF  [name (group)]=&quot;proposal made &amp; targeting closure&quot; and status = &quot;open&quot; then [date] END' />
            </column>
