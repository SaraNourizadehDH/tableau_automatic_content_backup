            <column-instance column='[year_month_week]' derivation='MDY' name='[md:year_month_week:ok]' pivot='key' type='ordinal' />
            <column caption='Merchant Id' datatype='string' name='[merchant_id]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1796373311515058176]' derivation='None' name='[none:Calculation_1796373311515058176:nk]' pivot='key' type='nominal' />
            <column-instance column='[Chain_Name_in_system]' derivation='None' name='[none:Chain_Name_in_system:nk]' pivot='key' type='nominal' />
            <column-instance column='[Customer_Success_Manager]' derivation='None' name='[none:Customer_Success_Manager:nk]' pivot='key' type='nominal' />
