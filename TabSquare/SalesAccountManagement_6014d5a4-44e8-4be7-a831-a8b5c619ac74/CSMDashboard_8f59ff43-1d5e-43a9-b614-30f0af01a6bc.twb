      </layout-options>
      <repository-location id='CSMOverview2' path='/t/TabSquare/workbooks/CSMDashboard' revision='' site='TabSquare' />
      <table>
        <view>
          <datasources>
            <datasource caption='csm_weekonweek Main' name='federated.1ugkdnt16yz3mr18437nh0udt5y8' />
          </datasources>
          <datasource-dependencies datasource='federated.1ugkdnt16yz3mr18437nh0udt5y8'>
            <column caption='Average Basket Value' datatype='real' name='[Calculation_1422856022334144513]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sales])/SUM([orders])' />
            </column>
            <column caption='Order Success Rate' datatype='real' name='[Calculation_1619607066829942785]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(ifnull([Success_order],0))/SUM(ifnull([sf_orders],0))' />
            </column>
            <column caption='Store Name' datatype='string' name='[Calculation_1796373311515058176]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([fsh_restaurantname], [sfo_merchant_name])' />
            </column>
            <column caption='Failed Orders' datatype='integer' name='[Calculation_2327516596712427521]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([Failed_order],0)' />
            </column>
            <column caption='Success Orders' datatype='integer' name='[Calculation_2327516596712607746]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([Success_order],0)' />
            </column>
            <column caption='GMV % Diff' datatype='real' name='[Calculation_2327516596809973764]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([sales])) - LOOKUP(ZN(SUM([sales])), -1)) / ABS(LOOKUP(ZN(SUM([sales])), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='chain filter excludes' datatype='string' name='[Calculation_4419720103783243783]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Chain_Name_in_system]' />
            </column>
            <column caption='success &lt;99.5' datatype='string' name='[Calculation_838795447764840449]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_1619607066829942785]&lt;=0.995 then &apos;t&apos; else &apos;f&apos; END' />
            </column>
            <column caption='Outlets with Success Rate &lt;99.5%' datatype='integer' name='[Calculation_838795447765372931]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [year_month_week], [Chain_Name_in_system], [merchant_id]: if [Calculation_838795447764840449]=&apos;t&apos; then COUNTD([merchant_id]) END}' />
            </column>
            <column caption='fixed sales tester' datatype='real' name='[Calculation_838795447832801299]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [merchant_id],[year_month_week]: sum(ifnull([sales],0))}' />
            </column>
            <column caption='prev sales tester' datatype='real' name='[Calculation_838795447833042964]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [merchant_id],[year_month_week]: sum([prev_sales])}' />
            </column>
            <column caption='test%dif' datatype='real' name='[Calculation_838795447835545622]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_838795447832801299])-SUM([Calculation_838795447833042964]))/SUM([Calculation_838795447833042964])' />
            </column>
            <column caption='Outlets with Decreasing GMV (&gt;15%)' datatype='string' name='[Calculation_838795447835643927]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ({ FIXED [merchant_id], [year_month_week]: [Calculation_838795447835545622]}) &lt; -0.15 then [merchant_id] END' />
            </column>
            <column caption='Brand' datatype='string' name='[Chain_Name_in_system]' role='dimension' type='nominal' />
