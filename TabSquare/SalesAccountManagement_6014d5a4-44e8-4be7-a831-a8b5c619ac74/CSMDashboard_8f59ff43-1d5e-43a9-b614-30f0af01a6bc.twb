    <worksheet name='CSM Overview (4)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>WoW -Churn Analysis</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='csm_weekonweek Main' name='federated.1ugkdnt16yz3mr18437nh0udt5y8' />
          </datasources>
          <datasource-dependencies datasource='federated.1ugkdnt16yz3mr18437nh0udt5y8'>
            <column caption='Store Name' datatype='string' name='[Calculation_1796373311515058176]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([fsh_restaurantname], [sfo_merchant_name])' />
            </column>
            <column caption='GMV % Diff' datatype='real' name='[Calculation_2327516596809973764]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([sales])) - LOOKUP(ZN(SUM([sales])), -1)) / ABS(LOOKUP(ZN(SUM([sales])), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Outlets with decreasing GMV &gt;15%' datatype='integer' name='[Calculation_2327516596810293253]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='if [Calculation_2327516596809973764]&lt;-0.15 then COUNTD([merchant_id]) END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Brand' datatype='string' name='[Chain_Name_in_system]' role='dimension' type='nominal' />
            <column caption='Customer Success Manager' datatype='string' name='[Customer_Success_Manager]' role='dimension' type='nominal' />
            <column caption='Name of Account Manager' datatype='string' name='[Name_of_Account_Manager]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
