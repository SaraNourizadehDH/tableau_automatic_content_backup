    <worksheet name='CSM restaurant Level'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff'>Store Performance</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='9'><![CDATA[<[federated.1ugkdnt16yz3mr18437nh0udt5y8].[attr:Calculation_5380816419015720997:nk]>]]></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='csm_weekonweek Main' name='federated.1ugkdnt16yz3mr18437nh0udt5y8' />
          </datasources>
          <datasource-dependencies datasource='federated.1ugkdnt16yz3mr18437nh0udt5y8'>
            <column caption='Average Basket Value' datatype='real' name='[Calculation_1422856022334144513]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sales])/SUM([orders])' />
            </column>
            <column caption='Store Name' datatype='string' name='[Calculation_1796373311515058176]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([fsh_restaurantname], [sfo_merchant_name])' />
            </column>
            <column caption='Failed Orders' datatype='integer' name='[Calculation_2327516596712427521]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([Failed_order],0)' />
            </column>
            <column caption='Store Performance Week' datatype='string' name='[Calculation_5380816419015720997]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;Week of &quot; + &#10;DATENAME(&apos;month&apos;, [year_month_week]) + &quot; &quot; + &#10;STR(DAY([year_month_week])) + &quot;, &quot; + &#10;STR(YEAR([year_month_week])) + &#10;&quot; – &quot; + &#10;DATENAME(&apos;month&apos;, DATEADD(&apos;day&apos;, 6, [year_month_week])) + &quot; &quot; + &#10;STR(DAY(DATEADD(&apos;day&apos;, 6, [year_month_week]))) + &quot;, &quot; + &#10;STR(YEAR(DATEADD(&apos;day&apos;, 6, [year_month_week])))' />
            </column>
            <column caption='Year Month Week-1' datatype='boolean' name='[Calculation_6135098985086844935]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[year_month_week] &gt;= DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;week&apos;, TODAY()))&#10;AND [year_month_week] &lt; DATETRUNC(&apos;week&apos;, TODAY())' />
            </column>
            <column caption='Merchant_Week_GMV' datatype='real' name='[Calculation_8904742387250966528]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [merchant_id], [year_month_week] : SUM([sales]) }' />
            </column>
            <column caption='GMV Percentile Rank' datatype='real' name='[Calculation_8904742387252768772]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK_PERCENTILE(SUM([Calculation_8904742387250966528]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Sales Classification' datatype='string' name='[Calculation_8904742387253252102]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_8904742387252768772] &lt;= 0.33 THEN &quot;Below Average&quot;&#10;ELSEIF [Calculation_8904742387252768772] &lt;= 0.66 THEN &quot;Average&quot;&#10;ELSE &quot;Above Average&quot;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Brand' datatype='string' name='[Chain_Name_in_system]' role='dimension' type='nominal' />
