      <column caption='Mean Time to Resolution (Hours)' datatype='real' datatype-customized='true' name='[Avg Resolution Time Hours (copy)_1422856022343630851]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOAT([avg_resolution_time_hours])' />
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([sales])) - LOOKUP(ZN(SUM([sales])), -1)) / ABS(LOOKUP(ZN(SUM([sales])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation2]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([sales])) - LOOKUP(ZN(SUM([sales])), -1)) / ABS(LOOKUP(ZN(SUM([sales])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Average Basket Value' datatype='real' name='[Calculation_1422856022334144513]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sales])/SUM([orders])' />
      </column>
      <column caption='Order Success Rate' datatype='real' name='[Calculation_1619607066829942785]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(ifnull([Success_order],0))/SUM(ifnull([sf_orders],0))' />
      </column>
      <column caption='Year Month Week-4' datatype='boolean' name='[Calculation_1770759101335183362]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[year_month_week] &gt;= DATEADD(&apos;week&apos;, -4, DATETRUNC(&apos;week&apos;, TODAY()))&#13;&#10;AND [year_month_week] &lt;= DATETRUNC(&apos;week&apos;, TODAY())-1' />
      </column>
      <column caption='Store Name' datatype='string' name='[Calculation_1796373311515058176]' role='dimension' type='nominal'>
