      <column caption='Date Filter' datatype='boolean' name='[Calculation_5180195146321743873]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[date] &gt;= [Parameters].[Parameter 1] AND [date] &lt;= [Parameters].[Parameter 2]' />
      </column>
      <column caption='Selected Time Interval' datatype='string' name='[Calculation_5180195146321981442]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &quot;Month&quot; THEN&#10;  DATENAME(&apos;month&apos;, [date]) + &apos; &apos; + STR(YEAR([date]))&#10;&#10;ELSEIF [Parameters].[Parameter 3] = &quot;Quarter&quot; THEN&#10;  &apos;Q&apos; + STR(DATEPART(&apos;quarter&apos;, [date])) + &apos;-&apos; + STR(DATEPART(&apos;year&apos;, [date]))&#10;&#10;ELSEIF [Parameters].[Parameter 3] = &quot;Week&quot; THEN&#10;  str(date((DATETRUNC(&apos;week&apos;, [date]))))&#10;&#10;ELSE&#10;  NULL&#10;END' />
      </column>
      <column caption='New ABV' datatype='real' name='[Calculation_5180195146322202627]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([new_sales])/ sum([new_orders])' />
      </column>
      <column caption='For you Acceptance Rate' datatype='real' name='[Calculation_5180195146326155269]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ifnull(sum(for_you_acceptance_orders),0)/ifnull(sum(total_orders_for_foryou),0)' />
      </column>
      <column caption='New +Repeat' datatype='real' name='[Calculation_5180195146341548039]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([new_orders]) / sum(ifnull([new_orders],0) + ifnull([repeat_orders],0))' />
      </column>
      <column caption='For you Acceptance Rate Guest' datatype='real' name='[Calculation_6556396676957261824]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ifnull(sum([for_you_acceptance_orders_guest]),0)/ifnull(sum([total_orders_for_foryou_guest]),0)' />
      </column>
      <column caption='AI ORDERS' datatype='integer' name='[Calculation_6556396676969943044]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if ISNULL([total_orders_for_foryou]) or [total_orders_for_foryou]=0 then [total_orders_for_reco]&#10;ELSEIF ISNULL([total_orders_for_reco]) or [total_orders_for_reco]= 0 then [total_orders_for_foryou]&#10;ELSE [total_orders_for_foryou] END' />
      </column>
      <column caption='Total Item Order Reco Enabled Orders' datatype='integer' name='[Calculation_7718114274974556213]' role='measure' type='quantitative'>
