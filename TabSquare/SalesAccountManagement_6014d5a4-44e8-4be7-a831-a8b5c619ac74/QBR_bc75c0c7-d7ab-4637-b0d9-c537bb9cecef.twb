      <column caption='ABV (copy 2)' datatype='real' name='[ABV (copy 2)_1635088183470764036]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sales]) / [Calculation_5002373319885221891]' />
      </column>
      <column caption='Account Name' datatype='string' name='[Account_Name]' role='dimension' type='nominal' />
      <column caption='WeekDay/Weekend' datatype='string' name='[Calculation_1419196876775751680]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEPART(&apos;weekday&apos;, [order_date]) = 1 OR DATEPART(&apos;weekday&apos;, [order_date]) = 7 THEN&#13;&#10;    &quot;Weekend&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Weekday&quot;&#13;&#10;END' />
      </column>
      <column caption='Filter by Partition' datatype='boolean' name='[Calculation_1635088183465521152]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[partition_number] = { FIXED : MAX([Calculation_1635088183465824258]) }' />
      </column>
      <column caption='Partition Filter' datatype='integer' name='[Calculation_1635088183465824258]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Account_Name] = [Parameters].[Account Name Parameter] THEN [partition_number] END' />
      </column>
      <column caption='Index' datatype='integer' name='[Calculation_2667327287833690141]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Date Filter' datatype='boolean' name='[Calculation_5002373319881486336]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[order_date] &gt;= [Parameters].[Parameter 1] AND [order_date] &lt;= [Parameters].[Parameter 2]' />
      </column>
      <column caption='Selected Time Interval' datatype='string' name='[Calculation_5002373319882588161]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &quot;Month&quot; THEN&#10;  DATENAME(&apos;month&apos;, [order_date]) + &apos; &apos; + STR(YEAR([order_date]))&#10;&#10;ELSEIF [Parameters].[Parameter 3] = &quot;Quarter&quot; THEN&#10;  &apos;Q&apos; + STR(DATEPART(&apos;quarter&apos;, [order_date])) + &apos;-&apos; + STR(DATEPART(&apos;year&apos;, [order_date]))&#10;&#10;ELSEIF [Parameters].[Parameter 3] = &quot;Week&quot; THEN&#10;  str(date((DATETRUNC(&apos;week&apos;, [order_date]))))&#10;&#10;ELSE&#10;  NULL&#10;END' />
      </column>
      <column caption='Orders' datatype='integer' name='[Calculation_5002373319885221891]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([order_id])' />
      </column>
      <column caption='ABV' datatype='real' name='[Calculation_5002373319885324292]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='///SUM(IF ISNULL([Product_Type]) THEN IFNULL([Sales], 0)ELSE IFNULL([order_amount_clean], 0) END) / [Orders]///&#13;&#10;&#13;&#10;sum(ifnull([order_amount],0))/sum([orders])' />
      </column>
      <column caption='Category Sales' datatype='real' name='[Calculation_5002373319924379662]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Calculation_6885440919778476047], [Chain_Name_in_system], [Calculation_5002373319881486336]: sum([sales])}' />
      </column>
      <column caption='Category Contribution' datatype='real' name='[Calculation_5002373319930146835]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_5002373319924379662])/ sum([Category Sales (copy)_5002373319924916240])' />
      </column>
      <column caption='Category Performance Group' datatype='string' name='[Calculation_5002373319931342868]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF RANK_UNIQUE(([Calculation_5002373319930146835]), &apos;desc&apos;) &lt;= 5 THEN &quot;High Performing&quot;&#10;ELSEIF RANK_UNIQUE(([Calculation_5002373319930146835]), &apos;desc&apos;) &gt;= (WINDOW_MAX(RANK_UNIQUE(([Calculation_5002373319930146835]), &apos;desc&apos;)) - 4) THEN &quot;Low Performing&quot;&#10;ELSE &quot;Others&quot;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Top Orders' datatype='boolean' name='[Calculation_5002373319936131095]' role='measure' type='nominal'>
        <calculation class='tableau' formula='RANK(COUNTD([order_id]))&lt;= [Parameters].[Parameter 4]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Category Names' datatype='string' name='[Calculation_6885440919778476047]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='REGEXP_REPLACE(STR([category_name]), &apos;[^A-Za-z0-9 ]&apos;, &apos;&apos;)' />
      </column>
      <column caption='Item Contribution' datatype='real' name='[Category Contribution (copy)_5002373319934631957]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Category Sales (copy)_5002373319934677014])/ sum([Category Sales (copy)_5002373319924916240])' />
      </column>
      <column caption='Category Penetration' datatype='real' name='[Category Contribution (copy)_7035115239324831812]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Category Sales (copy)_7035115239324926021])/ sum([Overall Sales (copy)_7035115239325118534])' />
      </column>
      <column caption='Category Performance Group (copy)' datatype='string' name='[Category Performance Group (copy)_7035115239328084039]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF RANK_UNIQUE(([Calculation_5002373319930146835]), &apos;desc&apos;) &lt;= 5 THEN &quot;High Performing&quot;&#10;ELSEIF RANK_UNIQUE(([Calculation_5002373319930146835]), &apos;desc&apos;) &gt;= (WINDOW_MAX(RANK_UNIQUE(([Calculation_5002373319930146835]), &apos;desc&apos;)) - 4) THEN &quot;Low Performing&quot;&#10;ELSE &quot;Others&quot;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Overall Sales' datatype='real' name='[Category Sales (copy)_5002373319924916240]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED  [Chain_Name_in_system], [Calculation_5002373319881486336]: sum([sales])}' />
      </column>
      <column caption='Item Sales' datatype='real' name='[Category Sales (copy)_5002373319934677014]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [item_name], [Merchant_id], [Calculation_5002373319881486336]: sum([sales])}' />
      </column>
      <column caption='Category Orders' datatype='integer' name='[Category Sales (copy)_7035115239324926021]' role='measure' type='quantitative'>
