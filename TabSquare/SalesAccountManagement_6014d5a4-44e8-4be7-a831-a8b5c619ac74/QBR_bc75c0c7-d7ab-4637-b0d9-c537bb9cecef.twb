      <column caption='Ticket Status' datatype='string' name='[Calculation_1530098013748301826]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Calculation_1807069391774437524]) THEN &quot;Unresolved&quot;&#13;&#10;ELSE &quot;Resolved&quot;&#13;&#10;END' />
      </column>
      <column caption='Fixed max Resolved Date' datatype='datetime' name='[Calculation_1807069391774437524]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [ticket_id]: MAX([ticket_resolved_at])}' />
      </column>
      <column caption='Fixed Root Cause' datatype='string' name='[Calculation_1807069391774584981]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [ticket_id] : MIN([custom_cf_root_cause]) }' />
      </column>
      <column caption='Date Filter' datatype='boolean' name='[Calculation_5002373319881486336]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='date([ticket_created_at]) &gt;= [Parameters].[Parameter 1] AND date([ticket_created_at]) &lt;= [Parameters].[Parameter 2]' />
      </column>
      <column caption='Selected Time Interval' datatype='string' name='[Calculation_5002373319882588161]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &quot;Month&quot; THEN&#10;  DATENAME(&apos;month&apos;, date([ticket_created_at])) + &apos; &apos; + STR(YEAR(date([ticket_created_at])))&#10;&#10;ELSEIF [Parameters].[Parameter 3] = &quot;Quarter&quot; THEN&#10;  &apos;Q&apos; + STR(DATEPART(&apos;quarter&apos;, date([ticket_created_at]))) + &apos;-&apos; + STR(DATEPART(&apos;year&apos;, date([ticket_created_at])))&#10;&#10;ELSEIF [Parameters].[Parameter 3] = &quot;Week&quot; THEN&#10;  str(date((DATETRUNC(&apos;week&apos;, date([ticket_created_at])))))&#10;&#10;ELSE&#10;  NULL&#10;END' />
      </column>
