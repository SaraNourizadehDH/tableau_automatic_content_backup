      <table>
        <view>
          <datasources>
            <datasource caption='hourly' name='federated.1fdc2s11ib82vi128mo0v02yn8d0' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Start Date' datatype='date' name='[Parameter 1]' param-domain-type='any' role='measure' type='quantitative' value='#2025-07-01#'>
              <calculation class='tableau' formula='#2025-07-01#' />
            </column>
            <column caption='End Date' datatype='date' name='[Parameter 2]' param-domain-type='any' role='measure' type='quantitative' value='#2025-07-31#'>
              <calculation class='tableau' formula='#2025-07-31#' />
            </column>
            <column caption='Select Time Interval' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1fdc2s11ib82vi128mo0v02yn8d0'>
            <column caption='Account Name' datatype='string' name='[Account_Name]' role='dimension' type='nominal' />
            <column caption='WeekDay/Weekend' datatype='string' name='[Calculation_1419196876775751680]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATEPART(&apos;weekday&apos;, [order_date]) = 1 OR DATEPART(&apos;weekday&apos;, [order_date]) = 7 THEN&#13;&#10;    &quot;Weekend&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Weekday&quot;&#13;&#10;END' />
            </column>
            <column caption='Index' datatype='integer' name='[Calculation_2667327287833690141]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='INDEX()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Date Filter' datatype='boolean' name='[Calculation_5002373319881486336]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[order_date] &gt;= [Parameters].[Parameter 1] AND [order_date] &lt;= [Parameters].[Parameter 2]' />
            </column>
            <column caption='Selected Time Interval' datatype='string' name='[Calculation_5002373319882588161]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &quot;Month&quot; THEN&#10;  DATENAME(&apos;month&apos;, [order_date]) + &apos; &apos; + STR(YEAR([order_date]))&#10;&#10;ELSEIF [Parameters].[Parameter 3] = &quot;Quarter&quot; THEN&#10;  &apos;Q&apos; + STR(DATEPART(&apos;quarter&apos;, [order_date])) + &apos;-&apos; + STR(DATEPART(&apos;year&apos;, [order_date]))&#10;&#10;ELSEIF [Parameters].[Parameter 3] = &quot;Week&quot; THEN&#10;  str(date((DATETRUNC(&apos;week&apos;, [order_date]))))&#10;&#10;ELSE&#10;  NULL&#10;END' />
            </column>
            <column caption='Chain Name in system' datatype='string' name='[Chain_Name_in_system]' role='dimension' type='nominal' />
            <column datatype='string' name='[Merchant_id]' role='dimension' type='nominal' />
            <column datatype='string' name='[Order_Type]' role='dimension' type='nominal' />
            <column datatype='string' name='[Product_Type]' role='dimension' type='nominal' />
            <column caption='Restaurant Name' datatype='string' name='[RestaurantName]' role='dimension' type='nominal' />
            <column datatype='string' name='[customer_type]' role='dimension' type='nominal' />
            <column-instance column='[Account_Name]' derivation='None' name='[none:Account_Name:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1419196876775751680]' derivation='None' name='[none:Calculation_1419196876775751680:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_5002373319881486336]' derivation='None' name='[none:Calculation_5002373319881486336:nk]' pivot='key' type='nominal' />
