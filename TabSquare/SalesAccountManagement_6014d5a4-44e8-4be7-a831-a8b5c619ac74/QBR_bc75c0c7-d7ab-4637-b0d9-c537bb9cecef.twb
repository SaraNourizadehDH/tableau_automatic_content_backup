      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1fdc2s11ib82vi128mo0v02yn8d0].[sum:item_quantity:qk]&quot;' value='Quantity' />
