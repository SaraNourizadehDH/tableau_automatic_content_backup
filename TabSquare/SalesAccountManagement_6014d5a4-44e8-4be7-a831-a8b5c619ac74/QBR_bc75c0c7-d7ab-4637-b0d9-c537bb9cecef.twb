      <column caption='Date Filter' datatype='boolean' name='[Calculation_5002373319919808524]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[created_date] &gt;= [Parameters].[Parameter 1] AND [created_date] &lt;= [Parameters].[Parameter 2]' />
