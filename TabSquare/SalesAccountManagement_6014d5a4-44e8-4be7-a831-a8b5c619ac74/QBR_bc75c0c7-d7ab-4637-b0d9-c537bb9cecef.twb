            <column caption='Selected Time Interval' datatype='string' name='[Calculation_5180195146321981442]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &quot;Month&quot; THEN&#10;  DATENAME(&apos;month&apos;, [date]) + &apos; &apos; + STR(YEAR([date]))&#10;&#10;ELSEIF [Parameters].[Parameter 3] = &quot;Quarter&quot; THEN&#10;  &apos;Q&apos; + STR(DATEPART(&apos;quarter&apos;, [date])) + &apos;-&apos; + STR(DATEPART(&apos;year&apos;, [date]))&#10;&#10;ELSEIF [Parameters].[Parameter 3] = &quot;Week&quot; THEN&#10;  str(date((DATETRUNC(&apos;week&apos;, [date]))))&#10;&#10;ELSE&#10;  NULL&#10;END' />
