            </column>
            <column caption='Selected Time Interval' datatype='string' name='[Calculation_5002373319882588161]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &quot;Month&quot; THEN&#10;  DATENAME(&apos;month&apos;, [order_date]) + &apos; &apos; + STR(YEAR([order_date]))&#10;&#10;ELSEIF [Parameters].[Parameter 3] = &quot;Quarter&quot; THEN&#10;  &apos;Q&apos; + STR(DATEPART(&apos;quarter&apos;, [order_date])) + &apos;-&apos; + STR(DATEPART(&apos;year&apos;, [order_date]))&#10;&#10;ELSEIF [Parameters].[Parameter 3] = &quot;Week&quot; THEN&#10;  str(date((DATETRUNC(&apos;week&apos;, [order_date]))))&#10;&#10;ELSE&#10;  NULL&#10;END' />
            </column>
            <column caption='ABV' datatype='real' name='[Calculation_5002373319885324292]' role='measure' type='quantitative'>
