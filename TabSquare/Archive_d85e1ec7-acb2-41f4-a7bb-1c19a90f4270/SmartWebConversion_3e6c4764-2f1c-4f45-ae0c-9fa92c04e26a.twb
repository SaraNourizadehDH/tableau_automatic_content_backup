    <datasource caption='Custom SQL Query (tabsquare_dw_ecms_prod)' inline='true' name='federated.0bczd960m9u7vw10tg0cj094zyti' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0bd3edm1lzqcl11bclh3n1vtrl3a'>
            <connection CATALOG='tabsquare-data-sciences' EXECCATALOG='tabsquare-data-sciences' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tabsquare-data-sciences' schema='tabsquare_dw_ecms_prod' server-oauth='server-custom' username='data-team-tableau@tabsquare-data-sciences.iam.gserviceaccount.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0bd3edm1lzqcl11bclh3n1vtrl3a' name='Custom SQL Query' type='text'>Select a.*, c.restaurant_name, c.country,b.Account_Name,b.Name_of_Account_Manager,b.Team from
(Select merchant_id,order_date, sum(case when confirm_customer_id is null then 0 else 1 end) as converted_events, count(*) as total_events  from
(Select  cl.*, eo.customer_id as confirm_customer_id from 
(select distinct menu_mode,order_date,customer_id, merchant_id from `tabsquare-data-sciences.tabsquare_dw_web_event_prod.emenu_order_item_web_prod`)  eo
right join (select distinct menu_mode,order_date,customer_id, merchant_id from `tabsquare-data-sciences.tabsquare_dw_web_event_prod.click_login_web_prod`)  cl 
on eo.customer_id= cl.customer_id 
and eo.merchant_id = cl.merchant_id
and eo.order_date = cl.order_date
and eo.menu_mode = cl.menu_mode
WHERE cl.order_date &gt;&gt; &quot;2022-04-01&quot; and cl.menu_mode = &apos;Web&apos; and cl.customer_id &gt;&gt; 0)
GROUP BY 1,2) a
LEFT JOIN `tabsquare-data-sciences.tabsquare_dw_lookups.master_merchant_list` b
on a.merchant_id = b.merchant_id 
LEFT JOIN `tabsquare-data-sciences.tabsquare_dw_lookups.all_merchants_lookups` c 
on a.merchant_id = c.merchant_id</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0bd3edm1lzqcl11bclh3n1vtrl3a' name='Custom SQL Query' type='text'>Select a.*, c.restaurant_name, c.country,b.Account_Name,b.Name_of_Account_Manager,b.Team from
(Select merchant_id,order_date, sum(case when confirm_customer_id is null then 0 else 1 end) as converted_events, count(*) as total_events  from
(Select  cl.*, eo.customer_id as confirm_customer_id from 
(select distinct menu_mode,order_date,customer_id, merchant_id from `tabsquare-data-sciences.tabsquare_dw_web_event_prod.emenu_order_item_web_prod`)  eo
right join (select distinct menu_mode,order_date,customer_id, merchant_id from `tabsquare-data-sciences.tabsquare_dw_web_event_prod.click_login_web_prod`)  cl 
on eo.customer_id= cl.customer_id 
and eo.merchant_id = cl.merchant_id
and eo.order_date = cl.order_date
and eo.menu_mode = cl.menu_mode
WHERE cl.order_date &gt;&gt; &quot;2022-04-01&quot; and cl.menu_mode = &apos;Web&apos; and cl.customer_id &gt;&gt; 0)
GROUP BY 1,2) a
LEFT JOIN `tabsquare-data-sciences.tabsquare_dw_lookups.master_merchant_list` b
on a.merchant_id = b.merchant_id 
LEFT JOIN `tabsquare-data-sciences.tabsquare_dw_lookups.all_merchants_lookups` c 
on a.merchant_id = c.merchant_id</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
