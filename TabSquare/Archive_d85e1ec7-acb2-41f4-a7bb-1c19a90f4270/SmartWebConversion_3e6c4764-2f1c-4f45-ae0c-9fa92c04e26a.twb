      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0bczd960m9u7vw10tg0cj094zyti].[ctd:Order_Id:qk]&quot;' value='Order count' />
          <alias key='&quot;[federated.0bczd960m9u7vw10tg0cj094zyti].[sum:Sales:qk]&quot;' value='GMV' />
        </aliases>
      </column>
      <column datatype='string' name='[Account_Name]' role='dimension' type='nominal' />
      <column caption='month_week_field' datatype='date' name='[Calculation_1909526290754387968]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1 1]&#13;&#10;WHEN &quot;monthly&quot; THEN Date(DATETRUNC(&apos;month&apos;, [order_date]))&#13;&#10;WHEN &quot;weekly&quot; THEN Date(DATETRUNC(&apos;week&apos;, [order_date]))&#13;&#10;END' />
      </column>
      <column caption='Week Start Date' datatype='date' name='[Calculation_4604156623693287424]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='date(DATETRUNC(&apos;week&apos;, [order_date],&apos;Monday&apos;))' />
      </column>
      <column caption='conversion' datatype='real' name='[Calculation_516295481915559936]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([converted_events])/SUM([total_events])' />
      </column>
      <column caption='sum_total_events' datatype='integer' name='[Calculation_516295482137657345]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='TOTAL(SUM([total_events]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='agg_conversion' datatype='real' name='[Calculation_516295482215346183]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='TOTAL([Calculation_516295481915559936])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Time Period' datatype='integer' name='[Calculation_5685161260887887873]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Parameters].[Parameter 2], [Parameters].[Start Date (copy)_5685161260887789568])+1' />
      </column>
      <column caption='Compare start date' datatype='date' name='[Calculation_5685161260888371202]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='date(DATEADD(&apos;day&apos;,-1*[Calculation_5685161260887887873],[Parameters].[Parameter 2]))' />
      </column>
      <column caption='Current Time Period Filter' datatype='integer' name='[Calculation_5717953095680139264]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if [order_date]&gt;=[Parameters].[Parameter 2] and [order_date]&lt;=[Parameters].[Start Date (copy)_5685161260887789568] then 1 else 0 end' />
      </column>
      <column caption='Latest End Date' datatype='date' name='[Calculation_5717953095685943300]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{fixed :max(date(DATEADD(&apos;day&apos;,-1,{fixed: max([order_date])})))}' />
      </column>
      <column caption='Latest Start Date' datatype='date' name='[Calculation_5717953095686021125]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{fixed: max(date(DATETRUNC(&apos;month&apos;, [Calculation_5717953095685943300])))}' />
      </column>
      <column caption='Selected Time Interval' datatype='date' name='[Calculation_5746874649573715997]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 4]=&apos;Year&apos; then date(DATETRUNC(&apos;year&apos;, [order_date]))&#10;ELSEIF [Parameters].[Parameter 4]=&apos;Quarter&apos; then date(DATETRUNC(&apos;quarter&apos;, [order_date]))&#10;elseif [Parameters].[Parameter 4]=&apos;Month&apos; then date(DATETRUNC(&apos;month&apos;, [order_date]))&#10;elseif [Parameters].[Parameter 4]=&apos;Week&apos; then date(DATETRUNC(&apos;week&apos;, [order_date]))&#10;elseif [Parameters].[Parameter 4]=&apos;Day&apos; then date(DATETRUNC(&apos;day&apos;, [order_date]))&#10;end' />
      </column>
      <column caption='Selected Dimension' datatype='string' name='[Calculation_96123753339518988]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] == &quot;Country&quot; THEN [Country]&#10;ELSEIF [Parameters].[Parameter 1] == &quot;Order Type&quot; THEN [Order_Type]&#10;elseif [Parameters].[Parameter 1] == &apos;Payment Type&apos; then [Payment_Type]&#10;ELSEIF [Parameters].[Parameter 1] == &quot;Chain Name&quot; THEN [Chain_Name_in_system]&#10;ELSEIF [Parameters].[Parameter 1] == &quot;Team&quot; THEN [Team]&#10;ELSEIF [Parameters].[Parameter 1] == &quot;Restaurant Name&quot; THEN [RestaurantName]&#10;ELSEIF [Parameters].[Parameter 1] == &quot;Account Manager&quot; THEN [Name_of_Account_Manager]&#10;ELSEIF [Parameters].[Parameter 1] == &quot;Product Type&quot; THEN [Product_Type]&#10;ELSEIF [Parameters].[Parameter 1] == &quot;System&quot; THEN [System]&#10;elseif [Parameters].[Parameter 1] == &apos;Account Name&apos; then [Account_Name]&#10;elseif [Parameters].[Parameter 1] == &quot;Partner&quot; then [third_party_flag]&#10;end' />
      </column>
      <column caption='Compare end date ' datatype='date' name='[Compare start date (copy)_5685161260888866819]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='date(DATEADD(&apos;day&apos;,-1,[Parameters].[Parameter 2]))' />
      </column>
      <column caption='Latest Week Date filter' datatype='integer' name='[Latest End Date (copy)_5449637084984557575]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if date(datetrunc(&apos;week&apos;,[order_date],&apos;Monday&apos;))&#10;=&#10;date(datetrunc(&apos;week&apos;,{fixed: max([order_date])},&apos;Monday&apos;))&#10;then 1&#10;else 0 end' />
      </column>
