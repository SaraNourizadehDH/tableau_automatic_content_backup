      <aliases enabled='yes' />
      <column caption='% Count of Orders' datatype='real' default-format='p0.00%' name='[Calculation_1011621075298213891]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([id])/SUM({FIXED DATE([created_date]): COUNTD([id])})' />
      </column>
      <column caption='Failed orders with errors' datatype='integer' name='[Calculation_1337850587645153280]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF &#13;&#10;[message] IN (&apos;Order rejected due to middleware offline or rmq messaging issue&apos;,&#13;&#10;&apos;Order failed as POS did not send request for this order on time. Please confirm with POS partner if POS is sending requests properly&apos;,&#13;&#10;&apos;[Microsoft][ODBC Driver 17 for SQL Server]Login timeout expired&apos;,&#13;&#10;&apos;The table is being used on the POS by the Store Staff&apos;,&#13;&#10;&apos;Order failed|callback time out&apos;)&#13;&#10;THEN [id]&#13;&#10;END' />
      </column>
      <column caption='% of failed orders with errors' datatype='real' default-format='p0.00%' name='[Calculation_1337850587647356929]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_1337850587645153280])/SUM({FIXED DATE([created_date]): COUNTD([id])})' />
      </column>
      <column caption='Failed Orders without errors' datatype='integer' name='[Calculation_1337850587648114690]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF NOT &#13;&#10;[message] IN (&apos;Order rejected due to middleware offline or rmq messaging issue&apos;,&#13;&#10;&apos;Order failed as POS did not send request for this order on time. Please confirm with POS partner if POS is sending requests properly&apos;,&#13;&#10;&apos;[Microsoft][ODBC Driver 17 for SQL Server]Login timeout expired&apos;,&#13;&#10;&apos;The table is being used on the POS by the Store Staff&apos;,&#13;&#10;&apos;Order failed|callback time out&apos;)&#13;&#10;THEN [id]&#13;&#10;END' />
      </column>
      <column caption='% of failed orders without errors' datatype='real' default-format='p0.00%' name='[Calculation_1337850587648278531]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_1337850587648114690])/SUM({FIXED DATE([created_date]): COUNTD([id])})' />
      </column>
      <column aggregation='Sum' caption='Fixable Error Flag' datatype='integer' name='[Calculation_1726919418042667011]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if [pos_partner]=&apos;RAPTOR&apos; then&#10;    if trim([status_code]) in (&apos;504&apos;) then 1 else 0 end&#10;else 1&#10;end' />
      </column>
      <column caption='Failed % (mod)' datatype='real' name='[Calculation_1726919418043092996]' role='measure' type='quantitative'>
