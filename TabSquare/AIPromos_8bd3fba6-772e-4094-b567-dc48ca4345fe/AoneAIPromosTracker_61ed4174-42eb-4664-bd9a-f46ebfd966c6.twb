            <column caption='Promo accepted orders' datatype='integer' name='[Calculation_4157596570514632709]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(if [Calculation_4157596570514415619]=1 then [Calculation_4157596570514157568] end)' />
            </column>
