      <column caption='Order Id mod' datatype='string' name='[Calculation_4157596570514157568]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[merchant_id]+str([customer_id]) +  str([order_no_mod])' />
      </column>
      <column caption='Promo Acceptance Flag' datatype='integer' name='[Calculation_4157596570514415619]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [Calculation_4157596570514157568]: max(if [is_personalised]=1 then 1 else 0 end)}' />
      </column>
      <column caption='Promo accepted orders' datatype='integer' name='[Calculation_4157596570514632709]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(if [Calculation_4157596570514415619]=1 then [Calculation_4157596570514157568] end)' />
      </column>
      <column caption='Non Promo Check Size' datatype='real' name='[Calculation_4157596570515394573]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Promo accepted Sales (copy)_4157596570515296267] / &#10;[Promo accepted orders (copy)_4157596570515230730]' />
      </column>
      <column caption='Promo Check Size' datatype='real' name='[Calculation_4157596570515529742]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Promo accepted orders (copy)_4157596570514739206]&#10;/&#10;[Calculation_4157596570514632709]' />
