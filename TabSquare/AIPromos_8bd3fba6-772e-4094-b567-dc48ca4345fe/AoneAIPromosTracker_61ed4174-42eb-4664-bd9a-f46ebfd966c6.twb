            <column caption='New/Repeat' datatype='string' name='[Calculation_4157596572185493539]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [order_no_mod]=0 then &apos;New&apos; else &apos;Repeat&apos; end' />
            </column>
            <column caption='Incremental Check Size' datatype='real' name='[Calculation_5218405341301043215]' role='measure' type='quantitative'>
