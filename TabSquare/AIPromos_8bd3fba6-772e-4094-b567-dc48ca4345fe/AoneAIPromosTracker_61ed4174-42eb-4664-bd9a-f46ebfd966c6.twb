      <aliases enabled='yes' />
      <column caption='Order Id mod' datatype='string' name='[Calculation_4157596570514157568]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[merchant_id]+str([customer_id]) +  str([order_no_mod])' />
      </column>
      <column aggregation='Sum' caption='Promo Acceptance Flag' datatype='integer' name='[Calculation_4157596570514415619]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{fixed [order_id_mod]: max(if [is_personalised]=1 then 1 else 0 end)}' />
      </column>
      <column caption='Promo accepted orders' datatype='integer' name='[Calculation_4157596570514632709]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(if [Calculation_4157596570514415619]=1 then [Calculation_4157596570514157568] end)' />
      </column>
      <column caption='Non Promo Check Size' datatype='real' name='[Calculation_4157596570515394573]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Promo accepted Sales (copy)_4157596570515296267] / &#10;[Promo accepted orders (copy)_4157596570515230730]' />
      </column>
      <column caption='Promo Check Size' datatype='real' name='[Calculation_4157596570515529742]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Promo accepted orders (copy)_4157596570514739206]&#10;/&#10;[Calculation_4157596570514632709]' />
      </column>
      <column caption='Promo Acceptance Rate' datatype='real' name='[Calculation_4157596572184952866]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_4157596570514632709]/countd([Calculation_4157596570514157568])' />
      </column>
      <column caption='New/Repeat' datatype='string' name='[Calculation_4157596572185493539]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [order_no_mod]=0 then &apos;New&apos; else &apos;Repeat&apos; end' />
      </column>
      <column caption='Total Orders' datatype='integer' name='[Calculation_4157596572187988004]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd([Calculation_4157596570514157568])' />
      </column>
      <column caption='Promo Accepted Orders (item)' datatype='integer' name='[Calculation_4157596572542115879]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(if [is_personalised]=1 then [Calculation_4157596570514157568] end)' />
      </column>
      <column caption='Total Discounts' datatype='real' name='[Calculation_5218405340487458817]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [is_personalised]=1 then [promo_discount_amount] end)' />
      </column>
      <column caption='Discount Amount' datatype='real' name='[Calculation_5218405340499640323]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [order_id_mod]:max([promo_discount_amount])}' />
      </column>
      <column caption='MOV' datatype='real' name='[Calculation_5218405341288529925]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [order_id_mod]: max([promo_mov])}' />
      </column>
      <column caption='Expected ABV' datatype='real' name='[Calculation_5218405341289291782]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5218405341288529925]+[Promo discount (order id) (copy)_5218405341292978187]' />
      </column>
      <column caption='Expected Increment in ABV' datatype='real' name='[Calculation_5218405341289598983]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_5218405341289291782]-[ABV])/[ABV]' />
      </column>
      <column caption='Expected Increment in ABV Bucket' datatype='string' name='[Calculation_5218405341289713672]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_5218405341289598983]&lt;=0.1 then &apos;10%&apos;&#10;ELSEIF [Calculation_5218405341289598983]&lt;=0.2 then &apos;20%&apos;&#10;else &apos;30% or higher&apos;&#10;end' />
      </column>
      <column caption='Prev ABV' datatype='real' name='[Calculation_5218405341294182412]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_4157596572185493539]=&apos;Repeat&apos; then [ABV] end' />
      </column>
      <column caption='ABV (derived)' datatype='real' name='[Calculation_5218405341296795662]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([sales])/countd([order_id_mod])' />
      </column>
      <column caption='Incremental Check Size' datatype='real' name='[Calculation_5218405341301043215]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_4157596570515529742] - [Calculation_4157596570515394573])/[Calculation_4157596570515394573]' />
      </column>
      <column caption='Total Incremental' datatype='real' name='[Calculation_5218405341303902225]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_4157596570515529742]-[Calculation_4157596570515394573])*[Calculation_4157596570514632709]' />
      </column>
      <column caption='ROI' datatype='real' name='[Calculation_5218405341304025106]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5218405341303902225]/[Calculation_5218405340487458817]' />
      </column>
      <column caption='Pre vs Promo ABV Incremental' datatype='real' name='[Calculation_5218405341413142547]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [order_id_mod]:&#10;(&#10;sum(if [Calculation_4157596570514415619]=1 then [sales] end)&#10;-&#10;max([ABV])&#10;)&#10;/max([ABV])}' />
      </column>
      <column caption='Pre vs Promo ABV Incremental bucket' datatype='string' name='[Calculation_5218405341416280086]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_5218405341413142547]&lt;=-0.3 then &quot;Less than -30%&quot;&#10;elseif [Calculation_5218405341413142547]&lt;=-0.2 then &quot;-20 to -30%&quot;&#10;elseif [Calculation_5218405341413142547]&lt;=-0.1 then &quot;-10 to -20%&quot;&#10;elseif [Calculation_5218405341413142547]&lt;=0 then &quot;0 to -10%&quot;&#10;elseif [Calculation_5218405341413142547]&lt;=0.1 then &quot;0 to 10%&quot;&#10;elseif [Calculation_5218405341413142547]&lt;=0.2 then &quot;10 to 20%&quot;&#10;elseif [Calculation_5218405341413142547]&lt;=0.3 then &quot;20 to 30%&quot;&#10;else &quot;Greater than 30%&quot;&#10;end' />
      </column>
      <column caption='LTV Cohorts mod' datatype='string' name='[Calculation_5218405341489422360]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1]=&apos;Show&apos; then [ltv_cohort] else &apos;All&apos; end' />
      </column>
      <column caption='ABV Cohorts mod' datatype='string' name='[Calculation_5218405341489598489]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 2]=&apos;Show&apos; then [abv_cohort] else &apos;All&apos; end' />
      </column>
      <column caption='Non Promo accepted Sales' datatype='real' name='[Promo accepted Sales (copy)_4157596570515296267]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [Calculation_4157596570514415619]=0 then [sales] end)' />
      </column>
      <column caption='Promo accepted Sales' datatype='real' name='[Promo accepted orders (copy)_4157596570514739206]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [Calculation_4157596570514415619]=1 then [sales] end)' />
      </column>
      <column caption='Non Promo accepted orders' datatype='integer' name='[Promo accepted orders (copy)_4157596570515230730]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(if [Calculation_4157596570514415619]=0 then [Calculation_4157596570514157568] end)' />
      </column>
      <column caption='Discounted Price' datatype='real' name='[Promo discount (order id) (copy)_5218405341292978187]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [order_id_mod]:max([promo_discounted_price])}' />
      </column>
