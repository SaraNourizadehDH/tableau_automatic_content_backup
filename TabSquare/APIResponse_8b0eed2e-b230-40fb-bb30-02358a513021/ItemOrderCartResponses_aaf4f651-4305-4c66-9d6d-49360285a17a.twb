          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1y0eye617awxes1543iu50e4ldb9' name='Custom SQL Query' type='text'><![CDATA[select raw.*,u.name as merchant_name, urls.external_url, has_item_recommendation, has_order_cart_recommendation,
git.*
from
(
  SELECT 
  `itemreco_ordercart_api_response`.`api_response_code` AS `api_response_code`,
  `itemreco_ordercart_api_response`.`custid` AS `custid`,
  `itemreco_ordercart_api_response`.`date_time` AS `date_time`,
  `itemreco_ordercart_api_response`.`debug_mode` AS `debug_mode`,
  `itemreco_ordercart_api_response`.`device_id` AS `device_id`,
  `itemreco_ordercart_api_response`.`device_os` AS `device_os`,
  `itemreco_ordercart_api_response`.`internal_type` AS `internal_type`,
  `itemreco_ordercart_api_response`.`is_added_items_null` AS `is_added_items_null`,
  `itemreco_ordercart_api_response`.`is_ai_response_null` AS `is_ai_response_null`,
  `itemreco_ordercart_api_response`.`is_non_ai_restaurant` AS `is_non_ai_restaurant`,
  `itemreco_ordercart_api_response`.`merchant_id` AS `merchant_id`,
  `itemreco_ordercart_api_response`.`message` AS `message`,
  `itemreco_ordercart_api_response`.`order_type` AS `order_type`,
  `itemreco_ordercart_api_response`.`os_version` AS `os_version`,
  `itemreco_ordercart_api_response`.`pax` AS `pax`,
  `itemreco_ordercart_api_response`.`reco_type` AS `reco_type`,
  `itemreco_ordercart_api_response`.`request_date` AS `request_date`,
  `itemreco_ordercart_api_response`.`response_id` AS `response_id`,
  `itemreco_ordercart_api_response`.`session_id` AS `session_id`,
  `itemreco_ordercart_api_response`.`smarttab_mode` AS `smarttab_mode`,
  `itemreco_ordercart_api_response`.`smarttab_version` AS `smarttab_version`,
  `itemreco_ordercart_api_response`.`status` AS `status`,
  `itemreco_ordercart_api_response`.`tableno` AS `tableno`
FROM `tabsquare-data-sciences.tabsquare_dw_ai_response_prod.itemreco_ordercart_api_main_response` `itemreco_ordercart_api_response`
where request_date>>=DATE_ADD(CURRENT_DATE(), INTERVAL -1*<[Parameters].[Parameter 1]> DAY)
and request_date<<=CURRENT_DATE()
and date(date_time)>>=DATE_ADD(CURRENT_DATE(), INTERVAL -1*<[Parameters].[Parameter 1]> DAY)
and date(date_time)<<=CURRENT_DATE()
-- <[Parameters].[Parameter 1]>
)raw
inner join
(select id as restaurant_id, customer_key as merchant_id, name
from `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_users_view_prod`
group by 1,2,3
union all
select id as restaurant_id, merchant_key as merchant_id, name
from `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_organization_view_prod`
group by 1,2,3)u
on raw.merchant_id=u.merchant_id
left join
(
select created_by as restaurant_id, external_url 
from  `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_smartweb_settings_view_prod` ss 
group by 1,2
)urls
on u.restaurant_id = urls.restaurant_id
left join
(
  select eo.merchant_key as merchant_id, has_item_recommendation, has_order_cart_recommendation
from
(select organization_id,id as tier_setting_id, has_item_recommendation, has_order_cart_recommendation
from
`tabsquare-data-sciences.all_skipque_cdc_data_prod.all_chain_tier_setting_view_prod` 
)cts
inner join
`tabsquare-data-sciences.all_skipque_cdc_data_prod.all_organization_view_prod` eo
on cts.organization_id = eo.organization_id
and cts.tier_setting_id = eo.tier_setting_id
union all
select su.customer_key as merchant_id,  has_item_recommendation, has_order_cart_recommendation
from
(select created_by as restaurant_id,
max(has_item_recommendation) as has_item_recommendation,
max(has_order_cart_recommendation) as has_order_cart_recommendation
from
`tabsquare-data-sciences.all_skipque_cdc_data_prod.all_smartweb_settings_view_prod`
group by 1
)sss
inner join
`tabsquare-data-sciences.all_skipque_cdc_data_prod.all_users_view_prod` su
on sss.restaurant_id = su.id
)settings
on raw.merchant_id=settings.merchant_id
left join
`tabsquare-data-sciences.datateam_dev.item_reco_git_log` git
on request_date = git.commit_date]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
