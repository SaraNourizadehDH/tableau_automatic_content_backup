      <datasource-dependencies datasource='Parameters'>
        <column caption='Fetch Response Data for (days)' datatype='integer' name='[Parameter 1]' param-domain-type='any' role='measure' type='quantitative' value='6'>
          <calculation class='tableau' formula='6' />
