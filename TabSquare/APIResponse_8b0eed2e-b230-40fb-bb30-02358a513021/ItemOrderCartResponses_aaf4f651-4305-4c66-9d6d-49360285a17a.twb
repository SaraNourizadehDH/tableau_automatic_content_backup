  <worksheets>
    <worksheet name='% Null Responses over Time for Item Reco'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontsize='12'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Item Reco Response' name='federated.0j3iby70an0kwh139krt11j1kou3' />
          </datasources>
          <datasource-dependencies datasource='federated.0j3iby70an0kwh139krt11j1kou3'>
            <column aggregation='Sum' caption='Commit Flag' datatype='integer' name='[Calculation_1490339689877241859]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if [request_date]=[commit_date] then 1 else 0 end' />
            </column>
            <column caption='Count of Response ids' datatype='integer' name='[Calculation_2150679952735514625]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd([response_id])' />
            </column>
            <column caption='Count of Null Responses' datatype='integer' name='[Calculation_2150679952737185798]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(if [is_ai_response_null]=1 then [response_id] end)' />
            </column>
            <column caption='[Count of Null Responses]/[Count of Response ids]' datatype='real' name='[Calculation_2150679952737751052]' role='measure' type='quantitative' user:unnamed='Response Counts across Time (2)'>
              <calculation class='tableau' formula='[Calculation_2150679952737185798]/[Calculation_2150679952735514625]' />
            </column>
            <column datatype='string' name='[commit]' role='dimension' type='nominal' />
            <column datatype='date' name='[commit_date]' role='dimension' type='ordinal' />
            <column aggregation='Sum' datatype='integer' name='[has_item_recommendation]' role='dimension' type='ordinal' />
            <column caption='Is Ai Response Null' datatype='integer' name='[is_ai_response_null]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1490339689877241859]' derivation='Max' name='[max:Calculation_1490339689877241859:ok]' pivot='key' type='ordinal' />
