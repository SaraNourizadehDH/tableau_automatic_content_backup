          <named-connection caption='BigQuery' name='bigquery.1slbhrn1j4vma2126edme1h1qbn2'>
            <connection CATALOG='tabsquare-data-sciences' EXECCATALOG='tabsquare-data-sciences' authentication='auth-oauth-service-account' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='3' bq-large-fetch-rows='250000' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tabsquare-data-sciences' schema='tabsquare_dw_ai_response_prod' server-oauth='server-custom' username='data-team-tableau@tabsquare-data-sciences.iam.gserviceaccount.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1slbhrn1j4vma2126edme1h1qbn2' name='Custom SQL Query' type='text'><![CDATA[select raw.*,u.name as merchant_name, urls.external_url, has_recommendation, has_promotion, has_order_history,
case when lower(smarttab_mode) like '%web%' then timestamp(datetime(date_time,time_zone))
else timestamp(datetime(date_time,"UTC") ) end as localized_time,
case when lower(smarttab_mode) like '%web%' then timestamp(datetime(date_time,"Asia/Singapore") )
else timestamp(datetime(timestamp(datetime(date_time,time_zone)),"Asia/Singapore")) end as SGT_time,
country
from
(SELECT `personalize_api_response`.`custid` AS `custid`,
   `personalize_api_response`.`date_time` AS `date_time`,
  `personalize_api_response`.`is_non_ai_restaurant` AS `is_non_ai_restaurant`,
  `personalize_api_response`.`is_null_response` AS `is_null_response`,
  `personalize_api_response`.`merchant_id` AS `merchant_id`,
  `personalize_api_response`.`message` AS `message`,
  `personalize_api_response`.`order_type` AS `order_type`,
  `personalize_api_response`.`request_date` AS `request_date`,
  `personalize_api_response`.`response_id` AS `response_id`,
  `personalize_api_response`.`session_id` AS `session_id`,
  `personalize_api_response`.`smarttab_mode` AS `smarttab_mode`,
  `personalize_api_response`.`status` AS `status`,
  `personalize_api_response`.`test_type` AS `test_type`,
  `personalize_api_response`.`type` AS `type`,
  `dish_response`.`dish_id` AS `dish_id`,
   `dish_response`.`score` AS `score`
FROM `tabsquare-data-sciences.tabsquare_dw_ai_response_prod.personalize_api_main_response` `personalize_api_response`
left join (
  select * from 
`tabsquare-data-sciences.tabsquare_dw_ai_response_prod.personalize_api_dish_response` `dish_response`
where 
-- dish_response.request_date>>=DATE_ADD(CURRENT_DATE(), INTERVAL -1*3 DAY) 
dish_response.request_date>>=DATE_ADD(CURRENT_DATE(), INTERVAL -1*<[Parameters].[Parameter 1]> DAY)
and dish_response.request_date<<=CURRENT_DATE()
)`dish_response`
on personalize_api_response.response_id = dish_response.response_id
and personalize_api_response.type = dish_response.type
where 
-- personalize_api_response.request_date>>=DATE_ADD(CURRENT_DATE(), INTERVAL -1*3 DAY)
personalize_api_response.request_date>>=DATE_ADD(CURRENT_DATE(), INTERVAL -1*<[Parameters].[Parameter 1]> DAY)
and personalize_api_response.request_date<<=CURRENT_DATE()
)raw
inner join
(select id as restaurant_id, customer_key as merchant_id, name
from `tabsquare-data-sciences.skipque_cdc_data_prod.users`
group by 1,2,3
union all
select id as restaurant_id, merchant_key as merchant_id, name
from `tabsquare-data-sciences.skipque_cdc_data_prod.organization`
group by 1,2,3)u
on raw.merchant_id=u.merchant_id
left join
(
select created_by as restaurant_id, external_url 
from  `tabsquare-data-sciences.skipque_cdc_data_prod.smartweb_settings` ss 
group by 1,2
)urls
on u.restaurant_id = urls.restaurant_id
left join
(
  select eo.merchant_key as merchant_id, has_recommendation, has_promotion, has_order_history
from
(select organization_id,id as tier_setting_id, has_recommendation,
has_promotion, has_order_history
from
`tabsquare-data-sciences.skipque_cdc_data_prod.chain_tier_setting` 
)cts
inner join
`tabsquare-data-sciences.skipque_cdc_data_prod.organization` eo
on cts.organization_id = eo.organization_id
and cts.tier_setting_id = eo.tier_setting_id
union all
select su.customer_key as merchant_id, has_recommendation, has_promotion, has_order_history
from
(select created_by as restaurant_id,
max(has_recommendation) as has_recommendation,
max(has_promotion) as has_promotion , max(has_order_history) as has_order_history
from
`tabsquare-data-sciences.skipque_cdc_data_prod.smartweb_settings`
group by 1
)sss
inner join
`tabsquare-data-sciences.skipque_cdc_data_prod.users` su
on sss.restaurant_id = su.id
)settings
on raw.merchant_id=settings.merchant_id
left join
(
  select merchant_key as merchant_id, country,time_zone
  from
  `tabsquare-data-sciences.skipque_cdc_data_prod.organization`
  group by 1,2,3
  union all
  select customer_key as merchant_id, country, time_zone
  from
  `tabsquare-data-sciences.skipque_cdc_data_prod.users`
  group by 1,2,3
)meta
on raw.merchant_id = meta.merchant_id]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
