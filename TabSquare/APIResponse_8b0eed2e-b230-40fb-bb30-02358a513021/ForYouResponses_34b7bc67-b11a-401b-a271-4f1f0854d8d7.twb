              <calculation class='tableau' formula='if contains(lower([smarttab_mode]),&apos;smartweb&apos;) then&#10;if [Calculation_4698943300407185408]&gt;=8 then &apos;Reco Size met&apos;&#10;elseif [Calculation_4698943300407185408]&gt;=5 then &apos;Reco Size 5-8&apos;&#10;else &apos;Reco Size &lt;5&apos; &#10;end&#10;else&#10;if [Calculation_4698943300407185408]=20 then &apos;Reco Size met&apos;&#10;elseif [Calculation_4698943300407185408]&gt;=15 then &apos;Reco Size 15-20&apos;&#10;elseif [Calculation_4698943300407185408]&gt;=10 then &apos;Reco Size 10-15&apos;&#10;elseif [Calculation_4698943300407185408]&gt;=5 then &apos;Reco Size 5-10&apos;&#10;else &apos;Reco Size &lt;5&apos; end&#10;end' />
            </column>
