      <datasource-dependencies datasource='Parameters'>
        <column caption='Start Date' datatype='date' name='[Parameter 1]' param-domain-type='any' role='measure' type='quantitative' value='#2022-07-01#'>
          <calculation class='tableau' formula='#2022-07-01#' />
        </column>
        <column caption='End Date' datatype='date' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='#2022-08-16#'>
          <calculation class='tableau' formula='#2022-08-16#' />
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='sqlproxy.0rvohs40kj6cfn13gb37d12zszop'>
        <column caption='Payment Status' datatype='string' name='[Calculation_1236519637603622916]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [payment_status]= 0 then &quot; Accept Payment By PaymentGateway&quot;&#13;&#10;elseif [payment_status]= 1 then &quot; UnPaid (for Cash)&quot;&#13;&#10;elseif [payment_status]= 2 then &quot; Failed&quot;&#13;&#10;elseif [payment_status]= 3 then &quot; Success&quot;&#13;&#10;elseif [payment_status]= 4 then &quot; Canceled&quot;&#13;&#10;ELSE &quot;others&quot;&#13;&#10;END' />
        </column>
        <column caption='Order Status' datatype='string' name='[Calculation_1236519637603766277]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [order_status]= -4 then &quot;TEMP_ORDER&quot;&#13;&#10;elseif [order_status]= -3 then &quot;REJECTED&quot;&#13;&#10;elseif [order_status]= -2 then &quot; STATUS_UNPAID_ORDER&quot;&#13;&#10;elseif [order_status]= 0 then &quot; UNCOMFIRMED_ORDER&quot;&#13;&#10;elseif [order_status]= 1 then &quot; NEW ORDER/ CONFIRMED ORDER&quot;&#13;&#10;elseif [order_status]= 2 then &quot; READY&quot;&#13;&#10;elseif [order_status]= 3 then &quot; CLOSED&quot;&#13;&#10;elseif [order_status]= 6 then &quot; REFUNDED&quot;&#13;&#10;elseif [order_status]= 7 then &quot; DRIVER_ASSIGNED&quot;&#13;&#10;ELSE &quot;others&quot;&#13;&#10;END' />
        </column>
        <column caption='Void Status' datatype='string' name='[Calculation_1236519637610033162]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [is_void]= 0 then &quot;Successful&quot; &#13;&#10;ELSEIF [is_void]=1 then &quot;Unsuccessful&quot;&#13;&#10;ELSE Null end' />
        </column>
        <column caption='eCMS/CMS' datatype='string' name='[Calculation_6344797874357264385]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='if CONTAINS([merchant_id],&apos;HQ&apos;) then &apos;eCMS&apos; else &apos;CMS&apos; end' />
        </column>
        <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[app_type]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
