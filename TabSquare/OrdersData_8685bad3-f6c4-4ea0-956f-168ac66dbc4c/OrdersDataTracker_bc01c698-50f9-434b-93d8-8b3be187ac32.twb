    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Detailed View'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/TabSquare/workbooks/OrdersDataTracker/DetailedView?rev=' id='137176' path='/t/TabSquare/workbooks/OrdersDataTracker' revision='' site='TabSquare' />
      <style />
      <size maxheight='800' maxwidth='1500' minheight='800' minwidth='1500' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='Orders Data Tracker' name='sqlproxy.0rvohs40kj6cfn13gb37d12zszop' />
