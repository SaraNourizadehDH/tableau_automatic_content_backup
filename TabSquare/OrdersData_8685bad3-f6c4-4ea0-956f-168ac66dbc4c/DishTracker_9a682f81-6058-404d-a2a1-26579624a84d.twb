      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontname='Tableau Bold'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Dishes Tag Tracker Custom Query' name='federated.1qlnvtf10akzqw14ywwwz12ut4dm' />
          </datasources>
          <datasource-dependencies datasource='federated.1qlnvtf10akzqw14ywwwz12ut4dm'>
            <column datatype='string' name='[Account_Name]' role='dimension' type='nominal' />
            <column caption='Tag in S1 not S0' datatype='integer' name='[Calculation_110338196627955712]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Stages] = &apos;Stage 1&apos; THEN&#10;    IF IFNULL([s0_tag_count],0) = 0 THEN [dishes_id] END&#10;END' />
            </column>
            <column caption='Tag in S0 not in S1' datatype='integer' name='[Calculation_110338196628357121]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Stages] = &apos;Stage 0&apos; THEN&#10;    IF IFNULL([level1_count],0) = 0 &#10;    AND IFNULL([level2_count],0) = 0&#10;    AND IFNULL([level3_count],0) = 0 THEN [dishes_id] END&#10;ELSEIF  [Stages] = &apos;ECMS&apos; OR [Stages] = &apos;CMS&apos; THEN&#10;    IF IFNULL([level1_count],0) = 0 &#10;    AND IFNULL([level2_count],0) = 0&#10;    AND IFNULL([level3_count],0) = 0 THEN [dishes_id] END&#10;END' />
            </column>
            <column caption='No Tags' datatype='integer' name='[Calculation_110338196628709379]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF  IFNULL([s0_tag_count],0) = 0&#10;    AND IFNULL([level1_count],0) = 0 &#10;    AND IFNULL([level2_count],0) = 0&#10;    AND IFNULL([level3_count],0) = 0 &#10;THEN [dishes_id] END' />
            </column>
            <column caption='Untagged Dish_id by Stage' datatype='string' name='[Calculation_110338196634259461]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [dishes_id]&#10;WHEN [Calculation_110338196628357121] THEN &apos;Tag in S0 not in S1&apos;&#10;WHEN [Calculation_110338196627955712] THEN &apos;Tag in S1 not in S0&apos;&#10;WHEN [Calculation_110338196628709379] THEN &apos;No Tag in S0 and S1&apos;&#10;WHEN [Calculation_110338196643172358] THEN &apos;Tag in S0 and S1&apos;&#10;END' />
            </column>
            <column caption='Tag in S0 and S1' datatype='integer' name='[Calculation_110338196643172358]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF NOT ISNULL([Stages])&#10;THEN [dishes_id] END' />
            </column>
            <column caption='% Untagged Dishes (merchant id)' datatype='real' name='[Calculation_1400549120062619650]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [customer_key]: [Calculation_3180878347051962369]}' />
            </column>
            <column caption='% Untagged dishes Buckets (merchant id)' datatype='string' name='[Calculation_1400549120063373317]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_1400549120062619650]=0 then &apos;0%&apos;&#10;elseif [Calculation_1400549120062619650]&lt;=0.05 then &apos;0-5%&apos;&#10;elseif [Calculation_1400549120062619650]&lt;=0.1 then &apos;5-10%&apos;&#10;elseif [Calculation_1400549120062619650]&lt;=0.2 then &apos;10-20%&apos;&#10;elseif [Calculation_1400549120062619650]&lt;=0.3 then &apos;20-30%&apos;&#10;else &apos;30%+&apos;&#10;end' />
            </column>
            <column caption='Untagged Dish_ID' datatype='integer' name='[Calculation_3180878347050999808]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF ISNULL([S0_insert_date]) and ISNULL([s1_insert_date])&#10;THEN [dishes_id]&#10;END' />
            </column>
            <column caption='Percentage of Untagged dishes' datatype='real' name='[Calculation_3180878347051962369]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_3180878347050999808])/COUNTD([dishes_id])' />
            </column>
            <column caption='Avg Tag/Item Stage 0' datatype='real' name='[Calculation_3180878347064225799]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([s0_tag_count])/[Calculation_3180878347064512520]' />
            </column>
            <column caption='Total Dishes' datatype='integer' name='[Calculation_3180878347064512520]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([dishes_id])' />
            </column>
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
