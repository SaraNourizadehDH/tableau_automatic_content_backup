            <column caption='Untagged Dish_ID' datatype='integer' name='[Calculation_3180878347050999808]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF ISNULL([S0_insert_date]) and ISNULL([s1_insert_date])&#10;THEN [dishes_id]&#10;END' />
            </column>
            <column caption='Percentage of Untagged dishes' datatype='real' name='[Calculation_3180878347051962369]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_3180878347050999808])/COUNTD([dishes_id])' />
            </column>
            <column caption='Tagged Dish_id' datatype='integer' name='[Calculation_3180878347053457412]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF NOT(ISNULL([S0_insert_date]) and ISNULL([s1_insert_date]))&#10;THEN [dishes_id]&#10;END' />
            </column>
            <column caption='Stage 0 Tagged Dishes' datatype='integer' name='[Calculation_3180878347062759429]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF NOT(ISNULL([S0_insert_date]))&#10;THEN [dishes_id]&#10;END' />
            </column>
            <column caption='Stage 1 Tagged Dishes' datatype='integer' name='[Calculation_3180878347063070726]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF NOT(ISNULL([s1_insert_date]))&#10;THEN [dishes_id]&#10;END' />
            </column>
            <column caption='Avg Tag/Item Stage 0' datatype='real' name='[Calculation_3180878347064225799]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([s0_tag_count])/[Calculation_3180878347064512520]' />
            </column>
            <column caption='Total Dishes' datatype='integer' name='[Calculation_3180878347064512520]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([dishes_id])' />
            </column>
            <column caption='Avg Tags/Item Per Tagged Dish' datatype='real' name='[Calculation_318488940593778689]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IFNULL([s0_tag_count],0))+[Calculation_45950794318598148])/COUNT([Calculation_3180878347053457412])' />
            </column>
            <column caption='Stage 1 Tag Count' datatype='integer' name='[Calculation_45950794318598148]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([level1_count]+[level2_count]+[level3_count])' />
