      <column-instance column='[Calculation_3180878347053457412]' derivation='CountD' name='[ctd:Calculation_3180878347053457412:qk]' pivot='key' type='quantitative' />
      <column-instance column='[customer_key]' derivation='CountD' name='[ctd:customer_key:qk]' pivot='key' type='quantitative' />
