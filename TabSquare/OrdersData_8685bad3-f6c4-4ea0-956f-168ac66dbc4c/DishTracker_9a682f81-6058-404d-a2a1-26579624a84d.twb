            <column-instance column='[customer_key]' derivation='None' name='[none:customer_key:nk]' pivot='key' type='nominal' />
            <column datatype='integer' name='[s0_tag_count]' role='measure' type='quantitative' />
            <column datatype='date' name='[s1_insert_date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_3180878347052699650]' derivation='User' name='[usr:Calculation_3180878347052699650:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1qlnvtf10akzqw14ywwwz12ut4dm].[Action (% Untagged dishes Buckets (merchant id))]'>
            <groupfilter function='level-members' level='[Calculation_1400549120063373317]' user:ui-action-filter='[Action1_551C975F2D144AE78617EB7A98742A06]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <slices>
