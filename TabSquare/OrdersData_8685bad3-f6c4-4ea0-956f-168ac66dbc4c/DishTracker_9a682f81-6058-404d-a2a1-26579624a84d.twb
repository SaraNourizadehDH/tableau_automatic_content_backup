      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.03y5jng0im1a33169mk2r1mku0w8].[ctd:Calculation_3180878347050999808:qk]&quot;' value='Untagged Dishes' />
          <alias key='&quot;[federated.03y5jng0im1a33169mk2r1mku0w8].[ctd:Calculation_3180878347053457412:qk]&quot;' value='Tagged Dishes' />
          <alias key='&quot;[federated.03y5jng0im1a33169mk2r1mku0w8].[ctd:Calculation_3180878347062759429:qk]&quot;' value='Stage 0 Tagged Dishes' />
          <alias key='&quot;[federated.03y5jng0im1a33169mk2r1mku0w8].[ctd:Calculation_3180878347063070726:qk]&quot;' value='Stage 1 Tagged Dishes' />
          <alias key='&quot;[federated.03y5jng0im1a33169mk2r1mku0w8].[ctd:customer_key:qk]&quot;' value='Count of Merchants' />
