      <object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_6FED846F70034493B457B879292F52A5'>
            <properties context=''>
              <relation connection='bigquery.0dr9hn70n5y8ry1bctq1q0h0nw6i' name='Custom SQL Query' type='text'>select distinct * from(&#10;SELECT t1.customer_key,mmd.Country,mmd.Restaurantname,mml.Account_Name, mml.Name_of_Account_Manager, mml.Team,&#10;t1.dish_name,t1.dishes_id,coalesce(stage0.CMS_ECMS,stage1.CMS_ECMS) as Stages,stage0.s0_all_tags,stage0.s0_tag_count,&#10;stage1.dish_tag_l1,stage1.dish_tag_l2,stage1.dish_tag_l3,&#10;stage1.level1_count,stage1.level2_count,stage1.level3_count,&#10;stage0.S0_insert_date,stage1.s1_insert_date,coalesce(stage0.source_name,stage1.source_name) as Source_name,&#10;gmv_data.GMV&#10;from&#10;(&#10;SELECT U.customer_key as merchant_id,U.customer_key,U.name, D.id as dishes_id, D.name as dish_name&#10;FROM `tabsquare-data-sciences.skipque_cdc_data_prod.users` U&#10;RIGHT JOIN `tabsquare-data-sciences.skipque_cdc_data_prod.dishes` D&#10;ON U.id = D.created_by&#10;inner join&#10;tabsquare-data-sciences.skipque_cdc_data_prod.dish_categories dc&#10;on dc.dish_id = D.id &#10;UNION ALL&#10;SELECT split(merchant_key,&quot;-&quot;)[safe_ordinal(3)] as merchant_id,&#10;O.merchant_key as customer_key, O.name, D.id as dishes_id, D.name as dish_name &#10;FROM `tabsquare-data-sciences.skipque_cdc_data_prod.chain_dish` D&#10;LEFT JOIN `tabsquare-data-sciences.skipque_cdc_data_prod.organization` O&#10;ON D.organization_id = O.id) t1&#10;LEFT JOIN &#10;(&#10;  SELECT merchant_id,item_id,lower(string_agg(distinct(tag_name))) as s0_all_tags,count(tag_name) as s0_tag_count, cast(insert_date as date) as S0_insert_date,&#10;case when source_name like &apos;%cms%&apos; then &apos;CMS&apos;&#10;else &apos;Stage 0&apos; END as CMS_ECMS,source_name&#10;FROM `tabsquare-data-sciences.tabsquare_dw_ai_prod.merchant_dish_tag_prod` &#10;group by item_id, merchant_id,insert_date,source_name&#10;UNION ALL&#10;SELECT cast(organization_id as string),chain_dish_id,lower(string_agg(distinct(tag_name))) as s0_all_tags,count(tag_name) as s0_tag_count,cast(insert_date as date),&#10;case when source_name like &apos;%ecms%&apos; then &apos;ECMS&apos;&#10;else &apos;Stage 0&apos; END as CMS_ECMS,source_name&#10;FROM `tabsquare-data-sciences.tabsquare_dw_ai_prod.ecms_merchant_dish_tag_prod`&#10;group by chain_dish_id, organization_id,insert_date,source_name&#10;) stage0&#10;ON t1.merchant_id = stage0.merchant_id and t1.dishes_id = stage0.item_id&#10;LEFT JOIN&#10;(&#10;  SELECT merchant_id,item_id,cast(insert_date as date) as s1_insert_date,&apos;Stage 1&apos; as CMS_ECMS,source_name,&#10;  lower(array_to_string(dish_tags_l1,&apos;,&apos;)) as dish_tag_l1,&#10;  lower(array_to_string(dish_tags_l2,&apos;,&apos;)) as dish_tag_l2,&#10;  lower(array_to_string(dish_tags_l3,&apos;,&apos;)) as dish_tag_l3,&#10;  (SELECT count(*) from unnest(dish_tags_l1)) as level1_count,&#10;  (SELECT count(*) from unnest(dish_tags_l2)) as level2_count,&#10;  (SELECT count(*) from unnest(dish_tags_l3)) as level3_count&#10;FROM&#10;  `tabsquare-data-sciences.tabsquare_dw_ai_prod.cms_merchant_dish_tag_stage_1`&#10;UNION ALL&#10;SELECT cast(organization_id as string),chain_dish_id,cast(insert_date as date) as s1_insert_date,&apos;Stage 1&apos; as CMS_ECMS_S1,source_name,&#10;  lower(array_to_string(dish_tags_l1,&apos;--&apos;)) as dish_tag_l1,&#10;  lower(array_to_string(dish_tags_l2,&apos;--&apos;)) as dish_tag_l2,&#10;  lower(array_to_string(dish_tags_l3,&apos;--&apos;)) as dish_tag_l3,&#10;  (SELECT  count(*) as l1_count from unnest(dish_tags_l1) as l1) as level1,&#10;  (SELECT  count(*) as l2_count from unnest(dish_tags_l2) as l2) as level2,&#10;  (SELECT  count(*) as l3_count from unnest(dish_tags_l3) as l3) as level3&#10;FROM&#10;   `tabsquare-data-sciences.tabsquare_dw_ai_prod.ecms_merchant_dish_tag_stage_1`&#10;) stage1&#10;ON t1.merchant_id = stage1.merchant_id and t1.dishes_id = stage1.item_id &#10;LEFT JOIN&#10;(&#10;  SELECT merchant_key,name as Restaurantname,country FROM `tabsquare-data-sciences.skipque_cdc_data_prod.organization` &#10;  union all &#10;  select customer_key,name as Restaurantname,country FROM `tabsquare-data-sciences.skipque_cdc_data_prod.users`&#10;) mmd&#10;ON t1.customer_key = mmd.merchant_key&#10;LEFT JOIN&#10;(&#10;  SELECT Merchant_id, Account_Name, Name_of_Account_Manager, Team FROM `tabsquare-data-sciences.tabsquare_dw_lookups.master_merchant_list` &#10;) mml&#10;ON t1.customer_key = mml.merchant_id&#10;LEFT JOIN&#10;(&#10;  SELECT case&#10;  WHEN lower(merchant_id) like (&apos;hq%&apos;) then split(merchant_id,&quot;-&quot;)[safe_ordinal(2)]&#10;  ELSE merchant_id&#10;  END as merchant_id,SUM(Sales) as GMV FROM(&#10;SELECT&#10;  *&#10;FROM&#10;  tabsquare-data-sciences.datastudio_dashboard_data.all_product_firebase_data&#10;UNION ALL&#10;SELECT&#10;  *&#10;FROM&#10;  tabsquare-data-sciences.datastudio_dashboard_data.all_product_skipque_data&#10;) GROUP BY Merchant_id&#10;) gmv_data&#10;ON t1.merchant_id = gmv_data.merchant_id &#10;WHERE t1.merchant_id in (&#10;  SELECT case&#10;  WHEN lower(merchant_id) like (&apos;hq%&apos;) then split(merchant_id,&quot;-&quot;)[safe_ordinal(2)]&#10;  ELSE merchant_id&#10;  END as merchant_id&#10;  FROM(&#10;SELECT&#10;  *&#10;FROM&#10;  tabsquare-data-sciences.datastudio_dashboard_data.all_product_firebase_data&#10;UNION ALL&#10;SELECT&#10;  *&#10;FROM&#10;  tabsquare-data-sciences.datastudio_dashboard_data.all_product_skipque_data&#10;)&#10;)&#10;order by customer_key&#10;)</relation>
            </properties>
          </object>
        </objects>
      </object-graph>
    </datasource>
  </datasources>
