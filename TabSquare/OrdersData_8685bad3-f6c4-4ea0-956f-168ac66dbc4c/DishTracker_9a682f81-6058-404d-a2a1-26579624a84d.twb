      <aliases enabled='yes' />
      <column aggregation='None' caption='% Untagged Dishes (merchant id) (bin)' datatype='integer' name='[% Untagged Dishes (merchant id) (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='-2' formula='[Calculation_1400549120062619650]' peg='0' size='0.05' />
