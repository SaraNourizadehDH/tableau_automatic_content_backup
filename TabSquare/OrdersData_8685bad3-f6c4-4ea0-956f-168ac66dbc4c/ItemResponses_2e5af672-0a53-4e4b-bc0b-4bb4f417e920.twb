        <relation connection='bigquery.18ovfp11dylqv01cst1wv1tja3pp' name='Custom SQL Query' type='text'>select &#10;merchant_id,merchant_name,country,&#10;type,&#10;menu_mode,&#10;account_name ,dish_id,&#10;dish_name,&#10;sum(accepted_response_count) as accepted_response_count,&#10;sum(total_response_count) as total_response_count,&#10;(sum(accepted_response_count)/sum(total_response_count))*100 as accepted_ratio,&#10;case when ((sum(accepted_response_count)/sum(total_response_count))*100)&gt;&gt;= 0 and ((sum(accepted_response_count)/sum(total_response_count))*100) &lt;&lt;25 then &quot;Critically low&quot;&#10;when ((sum(accepted_response_count)/sum(total_response_count))*100)&gt;&gt;= 25 and ((sum(accepted_response_count)/sum(total_response_count))*100)&lt;&lt;50 then &quot;Low accepted&quot;&#10;when ((sum(accepted_response_count)/sum(total_response_count))*100)&gt;&gt;= 50 and ((sum(accepted_response_count)/sum(total_response_count))*100)&lt;&lt;75 then &quot;Above average accepted&quot;&#10;when ((sum(accepted_response_count)/sum(total_response_count))*100)&gt;&gt;=75 and ((sum(accepted_response_count)/sum(total_response_count))*100)&lt;&lt;=100 then &quot;Highly accepted&quot; end as buckets&#10;&#10; from `tabsquare-data-sciences.tabsquare_dw_ai_prod.for_you_item_acceptance_v1` group by 1,2,3,4,5,6,7,8</relation>
