            </column>
            <column _.fcp.RefreshableParameterRanges.true...default-value-field='[sqlproxy.1bdunlc0fg0uzj1e4c9n00l46kj2].[Calculation_5717953095685943300]' _.fcp.RefreshableParameterRanges.true...source-field='[sqlproxy.1bdunlc0fg0uzj1e4c9n00l46kj2].[order_date]' caption='End Date' datatype='date' name='[Start Date (copy)_5685161260887789568]' param-domain-type='range' role='measure' type='quantitative' value='#2023-07-02#'>
              <calculation class='tableau' formula='#2023-07-02#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.1bdunlc0fg0uzj1e4c9n00l46kj2'>
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[Account_Name]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='User' caption='Selected Metric' datatype='real' default-type='quantitative' layered='true' name='[Calculation_1909526290759573505]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2 1]&#13;&#10;WHEN &quot;sales&quot; then sum([Sales])&#13;&#10;WHEN &quot;orders&quot; then sum([orders])&#10;when &quot;outlets&quot; then countd([Merchant_id])&#10;when &quot;ABV&quot; then sum([Sales])/sum([orders])&#10;when &quot;GMV/Outlet&quot; then sum([Sales])/COUNTD([Merchant_id])&#10;When &quot;Orders/Outlet&quot; then sum([orders])/COUNTD([Merchant_id])&#10;WHEN &quot;Paid GMV&quot; then [Calculation_4304948671612907524]&#10;WHEN &quot;Paid GMV %&quot; then [Calculation_4304948671612907524]/sum([Sales])&#13;&#10;END' />
            </column>
            <column caption='COUNTD(IF [Paid_GMV row] &gt; 0 then [Merchant_id] END)' datatype='integer' name='[Calculation_3457568247762157574]' role='measure' type='quantitative' user:unnamed='p_gmv_product_country (2)'>
              <calculation class='tableau' formula='COUNTD(IF [Paid_GMV (copy)_3457568247762051077] &gt; 0 then [Merchant_id] END)' />
            </column>
            <column aggregation='User' caption='Paid_GMV' datatype='real' default-type='quantitative' layered='true' name='[Calculation_4304948671612907524]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='sum([Paid_Gmv])' />
            </column>
            <column aggregation='Count' caption='Current Time Period Filter' datatype='integer' default-type='ordinal' layered='true' name='[Calculation_5717953095680139264]' pivot='key' role='dimension' type='ordinal' user-datatype='integer' visual-totals='Default'>
              <calculation class='tableau' formula='if [order_date]&gt;=[Parameters].[Parameter 2] and [order_date]&lt;=[Parameters].[Start Date (copy)_5685161260887789568] then 1 else 0 end' />
            </column>
            <column aggregation='Year' caption='Latest End Date' datatype='date' default-type='ordinal' layered='true' name='[Calculation_5717953095685943300]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default'>
              <calculation class='tableau' formula='{fixed :max(date(DATEADD(&apos;day&apos;,-1,{fixed: max([order_date])})))}' />
            </column>
            <column aggregation='Year' caption='Latest Start Date' datatype='date' default-type='ordinal' layered='true' name='[Calculation_5717953095686021125]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default'>
              <calculation class='tableau' formula='{fixed: max(date(DATETRUNC(&apos;month&apos;, [Calculation_5717953095685943300])))}' />
            </column>
            <column aggregation='Year' caption='Selected Time Interval' datatype='date' default-type='ordinal' layered='true' name='[Calculation_5746874649573715997]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 4]=&apos;Year&apos; then date(DATETRUNC(&apos;year&apos;, [order_date]))&#10;ELSEIF [Parameters].[Parameter 4]=&apos;Quarter&apos; then date(DATETRUNC(&apos;quarter&apos;, [order_date]))&#10;elseif [Parameters].[Parameter 4]=&apos;Month&apos; then date(DATETRUNC(&apos;month&apos;, [order_date]))&#10;elseif [Parameters].[Parameter 4]=&apos;Week&apos; then date(DATETRUNC(&apos;week&apos;, [order_date]))&#10;elseif [Parameters].[Parameter 4]=&apos;Day&apos; then date(DATETRUNC(&apos;day&apos;, [order_date]))&#10;end' />
            </column>
            <column caption='sum([Paid_Gmv])/sum([Sales])' datatype='real' name='[Calculation_746823508593819649]' role='measure' type='quantitative' user:unnamed='p_gmv_country'>
              <calculation class='tableau' formula='sum([Paid_Gmv])/sum([Sales])' />
            </column>
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[Chain_Name_in_system]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
