      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontsize='12'><![CDATA[Paid GMV/Outlet Count/Paid GMV % across <[Parameters].[Parameter 4]> by Country and Product Type]]></run>
