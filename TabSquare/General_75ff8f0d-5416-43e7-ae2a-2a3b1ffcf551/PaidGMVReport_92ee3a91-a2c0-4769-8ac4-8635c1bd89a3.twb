        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] == &quot;Country&quot; THEN [Country]&#10;ELSEIF [Parameters].[Parameter 1] == &quot;Order Type&quot; THEN [Order_Type]&#10;elseif [Parameters].[Parameter 1] == &apos;Payment Type&apos; then [Payment_Type]&#10;ELSEIF [Parameters].[Parameter 1] == &quot;Chain Name&quot; THEN [Chain_Name_in_system]&#10;ELSEIF [Parameters].[Parameter 1] == &quot;Team&quot; THEN [Team]&#10;ELSEIF [Parameters].[Parameter 1] == &quot;Restaurant Name&quot; THEN [RestaurantName]&#10;ELSEIF [Parameters].[Parameter 1] == &quot;Account Manager&quot; THEN [Name_of_Account_Manager]&#10;ELSEIF [Parameters].[Parameter 1] == &quot;Product Type&quot; THEN [Product_Type]&#10;ELSEIF [Parameters].[Parameter 1] == &quot;System&quot; THEN [System]&#10;elseif [Parameters].[Parameter 1] == &apos;Account Name&apos; then [Account_Name]&#10;elseif [Parameters].[Parameter 1] == &quot;Partner&quot; then [third_party_flag]&#10;end' />
