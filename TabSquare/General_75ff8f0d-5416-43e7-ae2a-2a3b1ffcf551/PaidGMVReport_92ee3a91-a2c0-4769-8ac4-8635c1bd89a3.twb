      <column aggregation='User' caption='Change in Sales' datatype='real' default-type='quantitative' layered='true' name='[Calculation_5746874649548210181]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='([Calculation_5746874649547587588] - [Current Sales (copy)_5746874649548333062])/[Current Sales (copy)_5746874649548333062]' />
