      <column aggregation='User' caption='Current ABV' datatype='real' default-type='quantitative' layered='true' name='[ABV (copy)_5746874649551593483]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='sum(if [Calculation_5717953095680139264]=1 then [Sales] end)&#10;/&#10;sum(if [Calculation_5717953095680139264]=1 then [orders] end)' />
      </column>
      <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[Account_Name]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
      <column aggregation='Year' caption='month_week_field' datatype='date' default-type='quantitative' layered='true' name='[Calculation_1909526290754387968]' pivot='key' role='dimension' type='quantitative' user-datatype='date' visual-totals='Default'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1 1]&#13;&#10;WHEN &quot;monthly&quot; THEN Date(DATETRUNC(&apos;month&apos;, [order_date]))&#13;&#10;WHEN &quot;weekly&quot; THEN Date(DATETRUNC(&apos;week&apos;, [order_date]))&#13;&#10;END' />
      </column>
      <column aggregation='User' caption='Selected Metric' datatype='real' default-type='quantitative' layered='true' name='[Calculation_1909526290759573505]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2 1]&#13;&#10;WHEN &quot;sales&quot; then sum([Sales])&#13;&#10;WHEN &quot;orders&quot; then sum([orders])&#10;when &quot;outlets&quot; then countd([Merchant_id])&#10;when &quot;ABV&quot; then sum([Sales])/sum([orders])&#10;when &quot;GMV/Outlet&quot; then sum([Sales])/COUNTD([Merchant_id])&#10;When &quot;Orders/Outlet&quot; then sum([orders])/COUNTD([Merchant_id])&#10;WHEN &quot;Paid GMV&quot; then [Calculation_4304948671612907524]&#10;WHEN &quot;Paid GMV %&quot; then [Calculation_4304948671612907524]/sum([Sales])&#13;&#10;END' />
      </column>
      <column aggregation='User' caption='Paid_GMV' datatype='real' default-type='quantitative' layered='true' name='[Calculation_4304948671612907524]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='sum([Paid_Gmv])' />
      </column>
      <column aggregation='Year' caption='Week Start Date' datatype='date' default-type='ordinal' layered='true' name='[Calculation_4604156623693287424]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default'>
        <calculation class='tableau' formula='date(DATETRUNC(&apos;week&apos;, [order_date],&apos;Monday&apos;))' />
      </column>
      <column aggregation='Sum' caption='Time Period' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_5685161260887887873]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Parameters].[Parameter 2], [Parameters].[Start Date (copy)_5685161260887789568])+1' />
      </column>
      <column aggregation='Year' caption='Compare start date' datatype='date' default-type='ordinal' layered='true' name='[Calculation_5685161260888371202]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default'>
        <calculation class='tableau' formula='date(DATEADD(&apos;day&apos;,-1*[Calculation_5685161260887887873],[Parameters].[Parameter 2]))' />
      </column>
      <column aggregation='Count' caption='Current Time Period Filter' datatype='integer' default-type='ordinal' layered='true' name='[Calculation_5717953095680139264]' pivot='key' role='dimension' type='ordinal' user-datatype='integer' visual-totals='Default'>
        <calculation class='tableau' formula='if [order_date]&gt;=[Parameters].[Parameter 2] and [order_date]&lt;=[Parameters].[Start Date (copy)_5685161260887789568] then 1 else 0 end' />
      </column>
      <column aggregation='Year' caption='Latest End Date' datatype='date' default-type='ordinal' layered='true' name='[Calculation_5717953095685943300]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default'>
        <calculation class='tableau' formula='{fixed :max(date(DATEADD(&apos;day&apos;,-1,{fixed: max([order_date])})))}' />
      </column>
      <column aggregation='Year' caption='Latest Start Date' datatype='date' default-type='ordinal' layered='true' name='[Calculation_5717953095686021125]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default'>
        <calculation class='tableau' formula='{fixed: max(date(DATETRUNC(&apos;month&apos;, [Calculation_5717953095685943300])))}' />
      </column>
      <column aggregation='Sum' caption='Compare Time Period Filter' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_5746874649546481666]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
        <calculation class='tableau' formula='if [order_date]&gt;=[Calculation_5685161260888371202] and [order_date]&lt;=[Compare start date (copy)_5685161260888866819] then 1 else 0 end' />
      </column>
      <column aggregation='User' caption='Current Sales' datatype='real' default-type='quantitative' layered='true' name='[Calculation_5746874649547587588]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
