      <connection channel='https' class='sqlproxy' dataserver-permissions='true' dbname='AllMerchantExtract' directory='dataserver' port='443' saved-credentials-viewerid='39731' server='tableau.deliveryhero.net' server-oauth='' username='' workgroup-auth-mode='prompt'>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation name='sqlproxy' table='[sqlproxy]' type='table' />
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation name='sqlproxy' table='[sqlproxy]' type='table' />
        <calculations>
          <calculation column='[ABV (copy)_5746874649551593483]' formula='sum(if [Calculation_5717953095680139264]=1 then [Sales] end)&#10;/&#10;sum(if [Calculation_5717953095680139264]=1 then [orders] end)' />
          <calculation column='[Calculation_1909526290754387968]' formula='CASE [Parameters].[Parameter 1 1]&#13;&#10;WHEN &quot;monthly&quot; THEN Date(DATETRUNC(&apos;month&apos;, [order_date]))&#13;&#10;WHEN &quot;weekly&quot; THEN Date(DATETRUNC(&apos;week&apos;, [order_date]))&#13;&#10;END' />
          <calculation column='[Calculation_1909526290759573505]' formula='CASE [Parameters].[Parameter 2 1]&#13;&#10;WHEN &quot;sales&quot; then sum([Sales])&#13;&#10;WHEN &quot;orders&quot; then sum([orders])&#10;when &quot;outlets&quot; then countd([Merchant_id])&#10;when &quot;ABV&quot; then sum([Sales])/sum([orders])&#10;when &quot;GMV/Outlet&quot; then sum([Sales])/COUNTD([Merchant_id])&#10;When &quot;Orders/Outlet&quot; then sum([orders])/COUNTD([Merchant_id])&#10;WHEN &quot;Paid GMV&quot; then [Calculation_4304948671612907524]&#10;WHEN &quot;Paid GMV %&quot; then [Calculation_4304948671612907524]/sum([Sales])&#13;&#10;END' />
          <calculation column='[Calculation_4304948671612907524]' formula='sum([Paid_Gmv])' />
          <calculation column='[Calculation_4604156623693287424]' formula='date(DATETRUNC(&apos;week&apos;, [order_date],&apos;Monday&apos;))' />
          <calculation column='[Calculation_5685161260887887873]' formula='DATEDIFF(&apos;day&apos;, [Parameters].[Parameter 2], [Parameters].[Start Date (copy)_5685161260887789568])+1' />
          <calculation column='[Calculation_5685161260888371202]' formula='date(DATEADD(&apos;day&apos;,-1*[Calculation_5685161260887887873],[Parameters].[Parameter 2]))' />
          <calculation column='[Calculation_5717953095680139264]' formula='if [order_date]&gt;=[Parameters].[Parameter 2] and [order_date]&lt;=[Parameters].[Start Date (copy)_5685161260887789568] then 1 else 0 end' />
          <calculation column='[Calculation_5717953095685943300]' formula='{fixed :max(date(DATEADD(&apos;day&apos;,-1,{fixed: max([order_date])})))}' />
          <calculation column='[Calculation_5717953095686021125]' formula='{fixed: max(date(DATETRUNC(&apos;month&apos;, [Calculation_5717953095685943300])))}' />
          <calculation column='[Calculation_5746874649546481666]' formula='if [order_date]&gt;=[Calculation_5685161260888371202] and [order_date]&lt;=[Compare start date (copy)_5685161260888866819] then 1 else 0 end' />
          <calculation column='[Calculation_5746874649547587588]' formula='sum(if [Calculation_5717953095680139264]=1 then [Sales] end)' />
          <calculation column='[Calculation_5746874649548210181]' formula='([Calculation_5746874649547587588] - [Current Sales (copy)_5746874649548333062])/[Current Sales (copy)_5746874649548333062]' />
          <calculation column='[Calculation_5746874649548582919]' formula='1' />
          <calculation column='[Calculation_5746874649553522704]' formula='countd(if [Calculation_5717953095680139264]=1 then [Merchant_id] end)' />
          <calculation column='[Calculation_5746874649553756178]' formula='([Calculation_5746874649553522704]-[Current Merchant Count (copy)_5746874649553653777])/[Current Merchant Count (copy)_5746874649553653777]' />
          <calculation column='[Calculation_5746874649553915923]' formula='sum(if [Calculation_5717953095680139264]=1 then [orders] end)' />
          <calculation column='[Calculation_5746874649554100245]' formula='([Calculation_5746874649553915923]-[Current Order Count (copy)_5746874649554001940])/[Current Order Count (copy)_5746874649554001940]' />
          <calculation column='[Calculation_5746874649573715997]' formula='if [Parameters].[Parameter 4]=&apos;Year&apos; then date(DATETRUNC(&apos;year&apos;, [order_date]))&#10;ELSEIF [Parameters].[Parameter 4]=&apos;Quarter&apos; then date(DATETRUNC(&apos;quarter&apos;, [order_date]))&#10;elseif [Parameters].[Parameter 4]=&apos;Month&apos; then date(DATETRUNC(&apos;month&apos;, [order_date]))&#10;elseif [Parameters].[Parameter 4]=&apos;Week&apos; then date(DATETRUNC(&apos;week&apos;, [order_date]))&#10;elseif [Parameters].[Parameter 4]=&apos;Day&apos; then date(DATETRUNC(&apos;day&apos;, [order_date]))&#10;end' />
          <calculation column='[Calculation_96123753339518988]' formula='IF [Parameters].[Parameter 1] == &quot;Country&quot; THEN [Country]&#10;ELSEIF [Parameters].[Parameter 1] == &quot;Order Type&quot; THEN [Order_Type]&#10;elseif [Parameters].[Parameter 1] == &apos;Payment Type&apos; then [Payment_Type]&#10;ELSEIF [Parameters].[Parameter 1] == &quot;Chain Name&quot; THEN [Chain_Name_in_system]&#10;ELSEIF [Parameters].[Parameter 1] == &quot;Team&quot; THEN [Team]&#10;ELSEIF [Parameters].[Parameter 1] == &quot;Restaurant Name&quot; THEN [RestaurantName]&#10;ELSEIF [Parameters].[Parameter 1] == &quot;Account Manager&quot; THEN [Name_of_Account_Manager]&#10;ELSEIF [Parameters].[Parameter 1] == &quot;Product Type&quot; THEN [Product_Type]&#10;ELSEIF [Parameters].[Parameter 1] == &quot;System&quot; THEN [System]&#10;elseif [Parameters].[Parameter 1] == &apos;Account Name&apos; then [Account_Name]&#10;elseif [Parameters].[Parameter 1] == &quot;Partner&quot; then [third_party_flag]&#10;end' />
          <calculation column='[Change in Sales (copy)_5746874649552101389]' formula='([ABV (copy)_5746874649551593483] - [Current ABV (copy)_5746874649551929356])/[Current ABV (copy)_5746874649551929356]' />
          <calculation column='[Compare start date (copy)_5685161260888866819]' formula='date(DATEADD(&apos;day&apos;,-1,[Parameters].[Parameter 2]))' />
          <calculation column='[Country (group)]' formula='CASE [Country]&#10;  WHEN &quot;Australia&quot; THEN &quot;Australia &amp; NZ&quot;&#10;  WHEN &quot;New Zealand&quot; THEN &quot;Australia &amp; NZ&quot;&#10;  WHEN &quot;Andorra&quot; THEN &quot;Others&quot;&#10;  WHEN &quot;Brunei&quot; THEN &quot;Others&quot;&#10;  WHEN &quot;Hong Kong&quot; THEN &quot;Others&quot;&#10;  WHEN &quot;Jordan&quot; THEN &quot;Others&quot;&#10;  WHEN &quot;Other&quot; THEN &quot;Others&quot;&#10;  WHEN &quot;Others&quot; THEN &quot;Others&quot;&#10;  WHEN &quot;Philippines&quot; THEN &quot;Others&quot;&#10;  WHEN &quot;Taiwan&quot; THEN &quot;Others&quot;&#10;  WHEN &quot;Thailand&quot; THEN &quot;Others&quot;&#10;  WHEN &quot;United Kingdom&quot; THEN &quot;Others&quot;&#10;  ELSE [Country]&#10;END' />
          <calculation column='[Current ABV (copy)_5746874649551929356]' formula='sum(if [Calculation_5746874649546481666]=1 then [Sales] end)&#10;/&#10;sum(if [Calculation_5746874649546481666]=1 then [orders] end)' />
