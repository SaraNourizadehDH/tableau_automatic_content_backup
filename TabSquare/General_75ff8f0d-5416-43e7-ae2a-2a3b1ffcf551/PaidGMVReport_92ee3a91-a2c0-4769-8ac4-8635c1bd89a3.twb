  <column aggregation='User' caption='Current ABV' datatype='real' default-type='quantitative' name='[ABV (copy)_5746874649551593483]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
    <calculation class='tableau' formula='sum(if [Calculation_5717953095680139264]=1 then [Sales] end)&\#10;/&\#10;sum(if [Calculation_5717953095680139264]=1 then [orders] end)' />
  </column>
  <column aggregation='Count' datatype='string' default-type='nominal' name='[Account_Name]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
  <column aggregation='Year' caption='month_week_field' datatype='date' default-type='quantitative' name='[Calculation_1909526290754387968]' pivot='key' role='dimension' type='quantitative' user-datatype='date' visual-totals='Default'>
    <calculation class='tableau' formula='CASE [Parameters].[Parameter 1 1]&\#13;&\#10;WHEN &quot;monthly&quot; THEN Date(DATETRUNC(&apos;month&apos;, [order_date]))&\#13;&\#10;WHEN &quot;weekly&quot; THEN Date(DATETRUNC(&apos;week&apos;, [order_date]))&\#13;&\#10;END' />
  </column>
  <column aggregation='User' caption='Selected Metric' datatype='real' default-type='quantitative' name='[Calculation_1909526290759573505]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
    <calculation class='tableau' formula='CASE [Parameters].[Parameter 2 1]&\#13;&\#10;WHEN &quot;sales&quot; then sum([Sales])&\#13;&\#10;WHEN &quot;orders&quot; then sum([orders])&\#10;when &quot;outlets&quot; then countd([Merchant_id])&\#10;when &quot;ABV&quot; then sum([Sales])/sum([orders])&\#10;when &quot;GMV/Outlet&quot; then sum([Sales])/COUNTD([Merchant_id])&\#10;When &quot;Orders/Outlet&quot; then sum([orders])/COUNTD([Merchant_id])&\#10;WHEN &quot;Paid GMV&quot; then [Calculation_4304948671612907524]&\#10;WHEN &quot;Paid GMV \%&quot; then [Calculation_4304948671612907524]/sum([Sales])&\#13;&\#10;END' />
  </column>
  <column aggregation='User' caption='Paid_GMV' datatype='real' default-type='quantitative' name='[Calculation_4304948671612907524]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
    <calculation class='tableau' formula='sum([Paid_Gmv])' />
  </column>
  <column aggregation='Year' caption='Week Start Date' datatype='date' default-type='ordinal' name='[Calculation_4604156623693287424]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default'>
    <calculation class='tableau' formula='date(DATETRUNC(&apos;week&apos;, [order_date],&apos;Monday&apos;))' />
  </column>
  <column aggregation='Sum' caption='Time Period' datatype='integer' default-type='quantitative' name='[Calculation_5685161260887887873]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
    <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Parameters].[Parameter 2], [Parameters].[Start Date (copy)_5685161260887789568])+1' />
