            <column caption='Paid_GMV row' datatype='real' name='[Paid_GMV (copy)_3457568247762051077]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if  CONTAINS(lower([Payment_Type]),&apos;razer&apos;) OR  &#10;CONTAINS(lower([Payment_Type]),&apos;stripe&apos;) OR &#10;CONTAINS(lower([Payment_Type]),&apos;rapyd&apos;) OR  &#10;CONTAINS(lower([Payment_Type]),&apos;checkout&apos;) OR  &#10;CONTAINS(lower([Payment_Type]),&apos;g_pay&apos;) &#10;THEN [Sales] END' />
