            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[Merchant_id]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[Name_of_Account_Manager]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
