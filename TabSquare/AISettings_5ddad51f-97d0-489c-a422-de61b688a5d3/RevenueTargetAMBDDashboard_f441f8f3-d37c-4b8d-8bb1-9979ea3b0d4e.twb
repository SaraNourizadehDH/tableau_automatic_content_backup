          FROM (
            SELECT
              *,
              ROW_NUMBER() OVER(PARTITION BY ar_h1_h21, ar_year1 ORDER BY date DESC) AS rn
            FROM (
              SELECT
                CAST (SPLIT(month_date, '-')[
                OFFSET
                  (0)] AS int) AS ar_year1,
                CASE
                  WHEN SPLIT(month_date, '-')[ OFFSET (1)] IN ("1", "2", "3", "4", "5", "6") THEN "H1"
                  WHEN SPLIT(month_date, '-')[
              OFFSET
                (1)] IN ("7",
                  "8",
                  "9",
                  "10",
                  "11",
                  "12") THEN "H2"
              END
                AS ar_H1_H21,
                date,
              FROM
                `tabsquare-data-sciences.data_analysis_team_dev.ar_modified_testing`
              WHERE
                buckets_1!= "FULLY PAID")
            GROUP BY
