      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='BD' id='_3157A093458E425A8B54B2A56E3213CE'>
            <properties context=''>
              <relation connection='bigquery.0fcl7go0eeoly31b9bhae1xzme3s' name='Custom SQL Query' type='text'>(with &#13;
 &#13;
 sales as &#13;
 (select country as sales_country, signed_by ,H1_H2, year,sum(Actual_GMV_Added) as Actual_GMV_Added, sum(Actual_Revenue_Added) as Actual_Revenue_Added, sum(revenue) as revenue, sum(saas_amount) as recurring_revenue,sum(total_post_gmv) as total_post_gmv,&#13;
sum(total_revenue) as total_revenue,&#13;
sum(total_post_commission) as total_post_commission from  (select * ,&#13;
 &#13;
  SPLIT(month_date, &apos;-&apos;)[&#13;
       OFFSET&#13;
         (0)] AS year,&#13;
         CASE&#13;
           WHEN SPLIT(month_date, &apos;-&apos;)[ OFFSET (1)] IN (&quot;1&quot;, &quot;2&quot;, &quot;3&quot;, &quot;4&quot;, &quot;5&quot;, &quot;6&quot;) THEN &quot;H1&quot;&#13;
           WHEN SPLIT(month_date, &apos;-&apos;)[&#13;
       OFFSET&#13;
         (1)] IN (&quot;7&quot;,&#13;
           &quot;8&quot;,&#13;
           &quot;9&quot;,&#13;
           &quot;10&quot;,&#13;
           &quot;11&quot;,&#13;
           &quot;12&quot;) THEN &quot;H2&quot;&#13;
       END&#13;
         AS H1_H2 from ((SELECT country,&#13;
signed_by,&#13;
name_of_account_manager,&#13;
concat(extract( year from live_date),&quot;-&quot;, extract(month from live_date)) as month_date,&#13;
live_date,&#13;
case when(post_gmv- pre_gmv)&gt;&gt;0 then ((post_gmv- pre_gmv)) else 0 end as Actual_GMV_Added,&#13;
post_gmv,&#13;
pre_gmv,&#13;
revenue,&#13;
factor,&#13;
pre_paid_gmv,&#13;
post_paid_gmv,&#13;
case when (cast(post_commission as float64)-cast(pre_commission as float64))&gt;&gt;0 then ((cast(post_commission as float64)-cast(pre_commission as float64))) else 0 end as Actual_Revenue_Added,&#13;
pre_commission,&#13;
post_commission,&#13;
(saas_amount*factor) as saas_amount,&#13;
total_post_gmv,&#13;
total_revenue,&#13;
total_post_commission&#13;
 FROM `tabsquare-data-sciences.data_analysis_team_dev.bd_revenue_table_updated` ))) group by 1,2,3,4 order by 1,2,3,4),&#13;
&#13;
&#13;
okr_query AS (&#13;
   SELECT&#13;
     country,&#13;
     Employee_Name,&#13;
     H1_H2_Period,&#13;
     target_year,&#13;
     SUM(AR_reduction_by_50) AS AR_reduction_by_50,&#13;
     SUM(am_gm_added) AS am_gm_added,&#13;
     SUM(individual_gmv_added) AS individual_gmv_added,&#13;
     SUM(team_gmv_added) AS team_gmv_added,&#13;
     SUM(am_revenue_added) AS am_revenue_added,&#13;
     SUM(individual_reveneu_added) AS individual_reveneu_added,&#13;
     SUM(team_revenue_added) AS team_revenue_added,&#13;
     SUM(AR_reduction_by_50_weightage) AS AR_reduction_by_50_weightage,&#13;
     SUM(am_gm_added_weightage) AS am_gm_added_weightage,&#13;
     SUM(individual_gmv_added_weightage) AS individual_gmv_added_weightage,&#13;
     SUM(team_gmv_added_weightage) AS team_gmv_added_weightage,&#13;
     SUM(am_revenue_added_weightage) AS am_revenue_added_weightage,&#13;
     SUM(individual_reveneu_added_weightage) AS individual_reveneu_added_weightage,&#13;
     SUM(team_revenue_added_weightage) AS team_revenue_added_weightage&#13;
   FROM (&#13;
     SELECT&#13;
       Country,&#13;
       Employee_Name,&#13;
       CASE&#13;
         WHEN Key_Result_Area= &quot;AR reduction by 50%&quot; THEN total_okr&#13;
     END&#13;
       AS AR_reduction_by_50,&#13;
       CASE&#13;
         WHEN Key_Result_Area= &quot;Average new monthly GMV added (AM Team)&quot; THEN total_okr&#13;
     END&#13;
       AS am_gm_added,&#13;
       CASE&#13;
         WHEN Key_Result_Area= &quot;Average new monthly GMV added (Individual)&quot; THEN total_okr&#13;
     END&#13;
       AS individual_gmv_added,&#13;
       CASE&#13;
         WHEN Key_Result_Area= &quot;Average new monthly GMV added (Team level)&quot; THEN total_okr&#13;
     END&#13;
       AS team_gmv_added,&#13;
       CASE&#13;
         WHEN Key_Result_Area= &quot;Average new monthly Revenue added (AM Team)&quot; THEN total_okr&#13;
     END&#13;
       AS am_revenue_added,&#13;
       CASE&#13;
         WHEN Key_Result_Area= &quot;Average new monthly Revenue added (Individual)&quot; THEN total_okr&#13;
     END&#13;
       AS individual_reveneu_added,&#13;
       CASE&#13;
         WHEN Key_Result_Area= &quot;Average new monthly Revenue added (Team level)&quot; THEN total_okr&#13;
     END&#13;
       AS team_revenue_added,&#13;
       CASE&#13;
         WHEN Key_Result_Area= &quot;AR reduction by 50%&quot; THEN weightage&#13;
     END&#13;
       AS AR_reduction_by_50_weightage,&#13;
       CASE&#13;
         WHEN Key_Result_Area= &quot;Average new monthly GMV added (AM Team)&quot; THEN weightage&#13;
     END&#13;
       AS am_gm_added_weightage,&#13;
       CASE&#13;
         WHEN Key_Result_Area= &quot;Average new monthly GMV added (Individual)&quot; THEN weightage&#13;
     END&#13;
       AS individual_gmv_added_weightage,&#13;
       CASE&#13;
         WHEN Key_Result_Area= &quot;Average new monthly GMV added (Team level)&quot; THEN weightage&#13;
     END&#13;
       AS team_gmv_added_weightage,&#13;
       CASE&#13;
         WHEN Key_Result_Area= &quot;Average new monthly Revenue added (AM Team)&quot; THEN weightage&#13;
     END&#13;
       AS am_revenue_added_weightage,&#13;
       CASE&#13;
         WHEN Key_Result_Area= &quot;Average new monthly Revenue added (Individual)&quot; THEN weightage&#13;
     END&#13;
       AS individual_reveneu_added_weightage,&#13;
       CASE&#13;
         WHEN Key_Result_Area= &quot;Average new monthly Revenue added (Team level)&quot; THEN weightage&#13;
     END&#13;
       AS team_revenue_added_weightage,&#13;
       H1_H2_Period,&#13;
       target_year&#13;
     FROM (&#13;
       SELECT&#13;
         country,&#13;
         Team,&#13;
         Team_AM,&#13;
         Employee_Name,&#13;
         Key_Result_Area,&#13;
         Metric_Filter,&#13;
         Weightage,&#13;
         Current_Numbers_if_available,&#13;
         Total_OKR,&#13;
         H1_H2_Period,&#13;
         Year AS target_year&#13;
       FROM&#13;
         tabsquare-data-sciences.tabsquare_dw_lookups.okr_template_prod where team in (&quot;SG - BD&quot;, &quot;MY - BD&quot;,  &quot;ID - BD&quot;, &quot;AU - BD&quot;)) )&#13;
   GROUP BY&#13;
     1,&#13;
     2,&#13;
     3,&#13;
     4&#13;
   ORDER BY&#13;
     1,&#13;
     2,&#13;
     3,&#13;
     4)&#13;
&#13;
&#13;
select * from sales join  okr_query &#13;
on lower(sales.signed_by) = lower(okr_query.employee_name)&#13;
and lower(sales.sales_country) = lower(okr_query.country)&#13;
and sales.h1_h2 = okr_query.H1_H2_Period and sales.year= cast(okr_query.target_year as string)&#13;
     )</relation>
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='AM' inline='true' name='federated.1bgxsb81k5wmwz1f8il9m0tjy6v7' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.08os60f0927ere1bp6a731bmc2lx'>
            <connection CATALOG='tabsquare-data-sciences' EXECCATALOG='tabsquare-data-sciences' authentication='oauth' bq-fetch-tasks='3' bq-large-fetch-rows='250000' class='bigquery' connection-dialect='google-sql' project='tabsquare-data-sciences' schema='all_skipque_cdc_data_prod' server-oauth='server-custom' username='data-team-tableau@tabsquare-data-sciences.iam.gserviceaccount.com' workgroup-auth-mode='prompt'>
              <connection-customization class='bigquery' enabled='false' version='18.1'>
