          <named-connection caption='BigQuery' name='bigquery.0fcl7go0eeoly31b9bhae1xzme3s'>
            <connection CATALOG='tabsquare-data-sciences' EXECCATALOG='tabsquare-data-sciences' authentication='oauth' bq-fetch-tasks='3' bq-large-fetch-rows='250000' class='bigquery' connection-dialect='google-sql' project='tabsquare-data-sciences' schema='all_skipque_cdc_data_prod' server-oauth='server-custom' username='data-team-tableau@tabsquare-data-sciences.iam.gserviceaccount.com' workgroup-auth-mode='prompt'>
