            <groupfilter from='&quot;H1-2014&quot;' function='range' level='[Calculation_416090429640445977]' to='&quot;H1-2022&quot;' />
            <groupfilter from='&quot;H2-2013&quot;' function='range' level='[Calculation_416090429640445977]' to='&quot;H2-2022&quot;' />
            <groupfilter function='member' level='[Calculation_416090429640445977]' member='&quot;H2-2076&quot;' />
          </groupfilter>
        </groupfilter>
      </filter>
      <filter class='categorical' column='[name_of_account_manager]' filter-group='2'>
        <groupfilter function='except' user:ui-domain='database' user:ui-enumeration='exclusive' user:ui-marker='enumerate'>
          <groupfilter function='level-members' level='[name_of_account_manager]' />
          <groupfilter function='member' level='[name_of_account_manager]' member='&quot;Testing / Demo&quot;' />
        </groupfilter>
      </filter>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_04DAC0D861C845A0B8B2DB072A76DA32'>
            <properties context=''>
              <relation connection='bigquery.08os60f0927ere1bp6a731bmc2lx' name='Custom SQL Query' type='text'><![CDATA[(
  WITH
    revenue_query AS (
    SELECT
      country AS revenue_country,
      name_of_account_manager,
      CAST (year AS int) AS revenue_year,
      H1_H2,
      SUM(gmv_acc) AS gmv_acc,
      SUM(CASE
          WHEN full_customer_name NOT IN( "Delivery Hero (Singapore) Pte Ltd - Stripe", "Delivery Hero (Singapore) Pte Ltd - Adyen", "Delivery Hero Malaysia  Sdn Bhd - Stripe") THEN converted_revenue_acc
        ELSE
        0
      END
        ) AS converted_revenue_acc,
      SUM(CASE
          WHEN full_customer_name NOT IN( "Delivery Hero (Singapore) Pte Ltd - Stripe", "Delivery Hero (Singapore) Pte Ltd - Adyen", "Delivery Hero Malaysia  Sdn Bhd - Stripe") THEN (transaction_stripe_revenue_acc)
        ELSE
        0
      END
        ) AS transactional_stripe_revenue_acc,
      SUM(CASE
          WHEN full_customer_name NOT IN( "Delivery Hero (Singapore) Pte Ltd - Stripe", "Delivery Hero (Singapore) Pte Ltd - Adyen", "Delivery Hero Malaysia  Sdn Bhd - Stripe") THEN (recurring_fee_adyen_acc)
        ELSE
        0
      END
        ) AS recurring_fee_adyen_acc,
      SUM(CASE
          WHEN full_customer_name NOT IN( "Delivery Hero (Singapore) Pte Ltd - Stripe", "Delivery Hero (Singapore) Pte Ltd - Adyen", "Delivery Hero Malaysia  Sdn Bhd - Stripe") THEN (deferred_revenue_acc)
        ELSE
        0
      END
        ) AS deferred_revenue_acc,
      SUM(CASE
          WHEN full_customer_name NOT IN( "Delivery Hero (Singapore) Pte Ltd - Stripe", "Delivery Hero (Singapore) Pte Ltd - Adyen", "Delivery Hero Malaysia  Sdn Bhd - Stripe") THEN (recurring_revenue_acc)
        ELSE
        0
      END
        ) AS recurring_revenue_acc,
      SUM(CASE
          WHEN full_customer_name NOT IN( "Delivery Hero (Singapore) Pte Ltd - Stripe", "Delivery Hero (Singapore) Pte Ltd - Adyen", "Delivery Hero Malaysia  Sdn Bhd - Stripe") THEN (transaction_fee_razerpay_acc)
        ELSE
        0
      END
        ) AS transaction_fee_razerpay_acc,
      SUM(CASE
          WHEN full_customer_name NOT IN( "Delivery Hero (Singapore) Pte Ltd - Stripe", "Delivery Hero (Singapore) Pte Ltd - Adyen", "Delivery Hero Malaysia  Sdn Bhd - Stripe") THEN (cos_tcc_oat_fee_refund_acc)
        ELSE
        0
      END
        ) AS cos_tcc_oat_fee_refund_acc,
      SUM( transactional_cost) AS transactional_cost
    FROM (
      SELECT
        *
      FROM (
        SELECT
          *,
          SPLIT(month_date, '-')[
        OFFSET
          (0)] AS year,
          CASE
            WHEN SPLIT(month_date, '-')[ OFFSET (1)] IN ("1", "2", "3", "4", "5", "6") THEN "H1"
            WHEN SPLIT(month_date, '-')[
        OFFSET
          (1)] IN ("7",
            "8",
            "9",
            "10",
            "11",
            "12") THEN "H2"
        END
          AS H1_H2,
        FROM
          tabsquare-data-sciences.tabsquare_dw_lookups.revenue_merchant_level
         ))
    WHERE
      third_party_flag IS NULL
      OR third_party_flag= "TabSquare"
    GROUP BY
      1,
      2,
      3,
      4
    ORDER BY
      1,
      2,
      3,
      4),
    okr_query AS (
    SELECT
      country,
      Employee_Name,
      H1_H2_Period,
      target_year,
      SUM(AR_reduction_by_50) AS AR_reduction_by_50,
      SUM(am_gm_added) AS am_gm_added,
      SUM(individual_gmv_added) AS individual_gmv_added,
      SUM(team_gmv_added) AS team_gmv_added,
      SUM(am_revenue_added) AS am_revenue_added,
      SUM(individual_reveneu_added) AS individual_reveneu_added,
      SUM(team_revenue_added) AS team_revenue_added,
      SUM(AR_reduction_by_50_weightage) AS AR_reduction_by_50_weightage,
      SUM(am_gm_added_weightage) AS am_gm_added_weightage,
      SUM(individual_gmv_added_weightage) AS individual_gmv_added_weightage,
      SUM(team_gmv_added_weightage) AS team_gmv_added_weightage,
      SUM(am_revenue_added_weightage) AS am_revenue_added_weightage,
      SUM(individual_reveneu_added_weightage) AS individual_reveneu_added_weightage,
      SUM(team_revenue_added_weightage) AS team_revenue_added_weightage
    FROM (
      SELECT
        Country,
        Employee_Name,
        CASE
          WHEN Key_Result_Area= "More than 30 days AR reduction " THEN total_okr
      END
        AS AR_reduction_by_50,
        CASE
          WHEN Key_Result_Area= "Average new monthly GMV added (AM Team)" THEN total_okr
      END
        AS am_gm_added,
        CASE
          WHEN Key_Result_Area= "Average new monthly GMV added (Individual)" THEN total_okr
      END
        AS individual_gmv_added,
        CASE
          WHEN Key_Result_Area= "Average new monthly GMV added (Team level)" THEN total_okr
      END
        AS team_gmv_added,
        CASE
          WHEN Key_Result_Area= "Average new monthly Revenue added (AM Team)" THEN total_okr
      END
        AS am_revenue_added,
        CASE
          WHEN Key_Result_Area= "Average new monthly Revenue added (Individual)" THEN total_okr
      END
        AS individual_reveneu_added,
        CASE
          WHEN Key_Result_Area= "Average new monthly Revenue added (Team level)" THEN total_okr
      END
        AS team_revenue_added,
        CASE
          WHEN Key_Result_Area= "More than 30 days AR reduction " THEN weightage
      END
        AS AR_reduction_by_50_weightage,
        CASE
          WHEN Key_Result_Area= "Average new monthly GMV added (AM Team)" THEN weightage
      END
        AS am_gm_added_weightage,
        CASE
          WHEN Key_Result_Area= "Average new monthly GMV added (Individual)" THEN weightage
      END
        AS individual_gmv_added_weightage,
        CASE
          WHEN Key_Result_Area= "Average new monthly GMV added (Team level)" THEN weightage
      END
        AS team_gmv_added_weightage,
        CASE
          WHEN Key_Result_Area= "Average new monthly Revenue added (AM Team)" THEN weightage
      END
        AS am_revenue_added_weightage,
        CASE
          WHEN Key_Result_Area= "Average new monthly Revenue added (Individual)" THEN weightage
      END
        AS individual_reveneu_added_weightage,
        CASE
          WHEN Key_Result_Area= "Average new monthly Revenue added (Team level)" THEN weightage
      END
        AS team_revenue_added_weightage,
        H1_H2_Period,
        target_year
      FROM (
        SELECT
          country,
          Team,
          Team_AM,
          Employee_Name,
          Key_Result_Area,
          Metric_Filter,
          Weightage,
          Current_Numbers_if_available,
          Total_OKR,
          H1_H2_Period,
          Year AS target_year
        FROM
          tabsquare-data-sciences.tabsquare_dw_lookups.okr_template_prod) )
    GROUP BY
      1,
      2,
      3,
      4
    ORDER BY
      1,
      2,
      3,
      4),
    revenue_with_okr AS (
    SELECT
      revenue_query.*,
      okr_query.Employee_Name,
      ROW_NUMBER() OVER(PARTITION BY revenue_country, name_of_account_manager, revenue_year, H1_H2) AS rn,
      AR_reduction_by_50,
      am_gm_added,
      individual_gmv_added,
      team_gmv_added,
      am_revenue_added,
      individual_reveneu_added,
      team_revenue_added,
      am_gm_added_weightage,
      individual_gmv_added_weightage,
      team_gmv_added_weightage,
      am_revenue_added_weightage,
      individual_reveneu_added_weightage,
      team_revenue_added_weightage,
    FROM
      revenue_query
    LEFT JOIN
      okr_query
    ON
      revenue_query.revenue_country= okr_query.country
      AND revenue_query.h1_h2= okr_query.H1_H2_Period
      AND revenue_query.revenue_year = okr_query.target_year
      AND lower(revenue_query.name_of_account_manager)= lower(okr_query.employee_name)
    ORDER BY
      revenue_country,
      name_of_account_manager,
      revenue_year),
    ar_query AS ((
      SELECT
        country AS ar_country,
        account_manager,
        ar_year,
        ar_h1_h2,
        SUM(current_sgd) AS current_sgd,
        SUM(less_than_30_days_sgd) AS less_than_30_days_sgd,
        SUM(btwn_30_60_days_sgd) AS btwn_30_60_days_sgd,
        SUM(btwn_60_90_days_sgd) AS btwn_60_90_days_sgd,
        SUM(more_than_90_days_sgd) AS more_than_90_days_sgd
      FROM (
        SELECT
          *
        FROM (
          SELECT
            *,
            CAST (SPLIT(month_date, '-')[
            OFFSET
              (0)] AS int) AS ar_year,
            CASE
              WHEN SPLIT(month_date, '-')[ OFFSET (1)] IN ("1", "2", "3", "4", "5", "6") THEN "H1"
              WHEN SPLIT(month_date, '-')[
          OFFSET
            (1)] IN ("7",
              "8",
              "9",
              "10",
              "11",
              "12") THEN "H2"
          END
            AS ar_H1_H2,
            CASE
              WHEN buckets_1= "Current" THEN new_sgd
          END
            AS current_sgd,
            CASE
              WHEN buckets_1= "<<30 days" THEN new_sgd
          END
            AS less_than_30_days_sgd,
            CASE
              WHEN buckets_1= "30-60 days" THEN new_sgd
          END
            AS btwn_30_60_days_sgd,
            CASE
              WHEN buckets_1= "60-90 days" THEN new_sgd
          END
            AS btwn_60_90_days_sgd,
            CASE
              WHEN buckets_1= "90+ days" THEN new_sgd
          END
            AS more_than_90_days_sgd
          FROM
            `tabsquare-data-sciences.data_analysis_team_dev.ar_modified_testing`
          WHERE
            buckets_1!= "FULLY PAID") AS a
        JOIN (
          SELECT
            *
          FROM (
            SELECT
              *,
              ROW_NUMBER() OVER(PARTITION BY ar_h1_h21, ar_year1 ORDER BY date DESC) AS rn
            FROM (
              SELECT
                CAST (SPLIT(month_date, '-')[
                OFFSET
                  (0)] AS int) AS ar_year1,
                CASE
                  WHEN SPLIT(month_date, '-')[ OFFSET (1)] IN ("1", "2", "3", "4", "5", "6") THEN "H1"
                  WHEN SPLIT(month_date, '-')[
              OFFSET
                (1)] IN ("7",
                  "8",
                  "9",
                  "10",
                  "11",
                  "12") THEN "H2"
              END
                AS ar_H1_H21,
                date,
              FROM
                `tabsquare-data-sciences.data_analysis_team_dev.ar_modified_testing`
              WHERE
                buckets_1!= "FULLY PAID")
            GROUP BY
              1,
              2,
              3
            ORDER BY
              1,
              2,
              3)
          WHERE
            rn=1) b
        ON
          a.date= b.date
          AND a.ar_h1_h2 = b.ar_h1_h21 )
      GROUP BY
        1,
        2,
        3,
        4
      ORDER BY
        1,
        2,
        3,
        4 ))
  SELECT
    *
  FROM
    revenue_with_okr
  LEFT JOIN
    ar_query
  ON
    revenue_with_okr.h1_h2= ar_query.ar_H1_H2
    AND revenue_with_okr.revenue_year = ar_query.ar_year
    AND revenue_with_okr.revenue_country= IFNULL(ar_query.ar_country,"")
    AND (lower(revenue_with_okr.name_of_account_manager) = lower(ar_query.account_manager)
      OR (lower(revenue_with_okr.name_of_account_manager) IS NULL
        AND lower(ar_query.account_manager) IS NULL)) )]]></relation>
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='% Achievement BD'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Tableau Light' fontsize='12'>Manager Level</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='BD' name='federated.0e0lwom1u3mnz91fz906915nucq9' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='h1_h2_year Parameter' datatype='string' name='[h1_h2_year Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;H2-2023&quot;'>
              <calculation class='tableau' formula='&quot;H2-2023&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0e0lwom1u3mnz91fz906915nucq9'>
            <column datatype='real' name='[Actual_GMV_Added]' role='measure' type='quantitative' />
            <column caption='Target Monthly GMV' datatype='real' name='[Calculation_2129076775977529344]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Calculation_5579819248325144585]= [Calculation_5579819248324493319] then [individual_gmv_added] END' />
            </column>
            <column caption='Target Monthly Revenue' datatype='real' name='[Calculation_2129076775977918465]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Calculation_5579819248325144585]= [Calculation_5579819248324493319] then [individual_reveneu_added] END' />
            </column>
            <column caption='Actual Monthly Recurring Revenue' datatype='real' name='[Calculation_2129076775978999810]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Calculation_5579819248325144585]= [Calculation_5579819248324493319] then [recurring_revenue] END' />
            </column>
            <column caption='Actual Monthly Revenue' datatype='real' name='[Calculation_2634605829777596418]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Current 30 Days GMV (copy)_5579819248325623819]+ [Calculation_2129076775978999810]' />
            </column>
            <column caption='Actual 30 Days GMV' datatype='real' name='[Calculation_5579819247889203203]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Actual_GMV_Added]' />
            </column>
