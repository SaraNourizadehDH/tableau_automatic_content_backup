        <relation connection='bigquery.19xg3ox13t9x0i1dur8wu01cos6l' name='Custom SQL Query' type='text'>select base.*, gmv.gmv&#10;from&#10;(&#10;  select master.merchant_id,  master.restaurant_name, master.restaurant_id,all_dates.date as settings_date, start_settings_date, end_settings_date,&#10;gmv_start_date,&#10;has_recommendation, has_promotion, has_order_history, order_cart_recommendation, item_recommendation,&#10;mm.Chain_Name_in_system as chain_name_in_the_system,&#10;    mm.Account_Name as account_name,&#10;    mm.Name_of_Account_Manager as name_of_account_manager,&#10;    mm.Team as team,&#10;    mm.Country as country, &#10;from&#10;(&#10;  select date, 1 as dummy&#10;from&#10;UNNEST(GENERATE_DATE_ARRAY(&apos;2022-01-01&apos;, current_date(), INTERVAL 1 DAY)) as date&#10;)all_dates&#10;inner join&#10;(&#10;select merchant_id, restaurant_name, restaurant_id, settings_date as start_settings_date, &#10;coalesce(max(settings_date) over(partition by merchant_id&#10;                        order by base.settings_date&#10;                        rows between 1 following and 1 following), current_date()) as end_settings_date,&#10;has_recommendation, has_promotion, has_order_history,order_cart_recommendation, item_recommendation,&#10;1 as dummy&#10;from&#10;(&#10;select merchant_id,restaurant_name,  restaurant_id, date(metadata_timestamp) as settings_date,&#10;metadata_timestamp,&#10;row_number() over(partition by merchant_id, date(metadata_timestamp) &#10;                  order by metadata_timestamp desc) as rankk,&#10;has_recommendation, has_promotion, has_order_history, order_cart_recommendation, item_recommendation,&#10;from&#10;(&#10;&#10;SELECT&#10;     sl.id as id,&#10;    o.merchant_key as merchant_id,&#10;    o.id as restaurant_id, &#10;    o.name as restaurant_name,&#10;    sl.has_recommendation as has_recommendation,&#10;    sl.has_promotion as has_promotion,&#10;    sl.has_order_history as has_order_history,&#10;    sl.has_order_cart_recommendation as order_cart_recommendation, &#10;    sl.has_item_recommendation as item_recommendation, &#10;    sl._metadata_timestamp  as metadata_timestamp&#10;        FROM&#10;`tabsquare-data-sciences.skipque_cdc_data_stag.chain_tier_setting_log` sl&#10;inner JOIN&#10;  `tabsquare-data-sciences.skipque_cdc_data_prod.organization` o&#10;ON&#10;  sl.id=o.tier_setting_id&#10;  and sl.organization_id= o.organization_id&#10;  union all&#10;  SELECT&#10;     sl1.id as id,&#10;    o1.customer_key as merchant_id,&#10;    o1.id as restaurant_id, &#10;    o1.name as restaurant_name,&#10;    sl1.has_recommendation as has_recommendation,&#10;    sl1.has_promotion as has_promotion,&#10;    sl1.has_order_history as has_order_history,&#10;    sl1.has_order_cart_recommendation as order_cart_recommendation, &#10;    sl1.has_item_recommendation as item_recommendation,&#10;     sl1._metadata_timestamp  as metadata_timestamp&#10;    FROM&#10;`tabsquare-data-sciences.skipque_cdc_data_stag.smartweb_settings_log` sl1&#10;inner JOIN&#10;  `tabsquare-data-sciences.skipque_cdc_data_prod.users` o1&#10;ON&#10;sl1.created_by= o1.id&#10;)base&#10;)base&#10;where rankk=1&#10;)master&#10;on all_dates.dummy = master.dummy&#10;and all_dates.date&gt;&gt;=master.start_settings_date&#10;and all_dates.date&lt;&lt;master.end_settings_date&#10;inner join&#10; (&#10; select users.merchant_id, min(date(order_datetime)) as gmv_start_date&#10;from&#10;(&#10;                select id, created_date as order_datetime,&#10;                customer_id,restaurant_id,order_session_id as session_id, order_type_id&#10;                from &#10;                `tabsquare-data-sciences.skipque_cdc_data_prod.orders` &#10;                where is_void=0 and status not in (-3,-4,0) &#10;                and app_type=4&#10;                and date(created_date)&gt;&gt;=&apos;2018-01-01&apos;&#10;                and order_amount&gt;&gt;0&#10;                )o&#10;                inner join&#10;                (&#10;                select id, customer_key as merchant_id&#10;                from&#10;                `tabsquare-data-sciences.skipque_cdc_data_prod.users`&#10;                group by 1,2&#10;                union all&#10;                select id, merchant_key as merchant_id&#10;                from&#10;                `tabsquare-data-sciences.skipque_cdc_data_prod.organization`&#10;                group by 1,2)users&#10;                on&#10;                o.restaurant_id = users.id &#10;                group by 1&#10;&#10; )sd&#10; on master.merchant_id = sd.merchant_id&#10; left join&#10; `tabsquare-data-sciences.tabsquare_dw_lookups.master_merchant_list` mm&#10;     on master.merchant_id = mm.Merchant_id &#10; where all_dates.date&gt;&gt;=sd.gmv_start_date&#10;)base&#10;  left join&#10;  (&#10; select merchant_id,order_date, sum(Sales) as gmv&#10; FROM&#10;      `tabsquare-data-sciences.datastudio_dashboard_data.all_product_skipque_data` &#10;      where Product_Type = &apos;Smartweb&apos;&#10;      group by 1, 2&#10; )gmv&#10; on base.merchant_id = gmv.merchant_id&#10; and base.settings_date = gmv.order_date&#10; order by 1,2</relation>
