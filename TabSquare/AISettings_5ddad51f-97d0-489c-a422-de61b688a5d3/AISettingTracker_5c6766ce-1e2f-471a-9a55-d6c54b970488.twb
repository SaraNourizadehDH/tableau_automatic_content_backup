      <column caption='count of merchant id turned off' datatype='integer' name='[count of merchant id turned onn (copy)_1583789331758256133]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;if [Parameters].[Parameter 4] = &quot;Reorder&quot;&#10;and [has_order_history] = 0&#10;and [has_promotion] = 1&#10;and [has_recommendation] = 1&#10;     then [merchant_id] &#10;&#10;ELSEIF  [Parameters].[Parameter 4] = &quot;Promotions&quot;&#10;and [has_order_history] = 1&#10;and [has_promotion] = 0&#10;and [has_recommendation] = 1&#10;     then [merchant_id]&#10;     &#10;ELSEIF  [Parameters].[Parameter 4] = &quot;Recommendation&quot;&#10;and [has_order_history] = 1&#10;and [has_promotion] = 1&#10;and [has_recommendation] = 0&#10;     then [merchant_id]&#10;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;All&quot;&#10;and [has_order_history] = 0&#10;and [has_promotion] = 0&#10;and [has_recommendation] = 0&#10;     then [merchant_id]&#10;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Reco and Promo&quot;&#10;and [has_order_history] = 1&#10;and [has_promotion] = 0&#10;and [has_recommendation] = 0&#10;     then [merchant_id] &#10;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Reorder and Promo&quot;&#10;and [has_order_history] = 0&#10;and [has_promotion] = 0&#10;and [has_recommendation] = 1&#10;     then [merchant_id] &#10;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Reorder and Reco&quot;&#10;and [has_order_history] = 0&#10;and [has_promotion] = 1&#10;and [has_recommendation] = 0&#10;     then [merchant_id]&#10;END)' />
      </column>
