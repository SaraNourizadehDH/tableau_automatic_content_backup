        <calculation class='tableau' formula='if [Parameters].[Parameter 4] = &quot;Promotions&quot;&#10;then (countd(if [Has Recommendation Flag (latest, merchantid, selected time period) (copy) (copy)_6053260118176473098]=0 then [merchant_id] end)&#10;/&#10;countd([merchant_id]))&#10;&#10;Elseif [Parameters].[Parameter 4] = &quot;Recommendation&quot;&#10;then (countd(if [Calculation_6053260118174470149]=0 then [merchant_id] end)&#10;/&#10;countd([merchant_id]))&#10;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Reorder&quot;&#10;then (countd(if [Has Recommendation Flag (latest, merchantid, selected time period) (copy)_6053260118176464905]=0 then [merchant_id] end)&#10;/&#10;countd([merchant_id]))&#10;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Order Cart Recommendation&quot;&#10;then (countd(if [Has Reorder Flag (latest, merchantid, selected time period) (copy)_2487112903183446016]=0 then [merchant_id] end)&#10;/&#10;countd([merchant_id]))&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Item Recommendation&quot;&#10;then (countd(if [Has Reorder Flag (latest, merchantid, selected time period) (copy)_2487112903183699969]=0 then [merchant_id] end)&#10;/&#10;countd([merchant_id]))&#10;&#10;END' />
      </column>
