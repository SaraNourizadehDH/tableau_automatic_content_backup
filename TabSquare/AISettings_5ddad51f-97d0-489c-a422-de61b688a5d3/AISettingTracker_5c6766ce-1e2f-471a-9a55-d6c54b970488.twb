      <aliases enabled='yes' />
      <column caption='all % promo onn' datatype='real' name='[Calculation_1583789331762749448]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 4] = &quot;Promotions&quot;&#10;then (countd(if [Has Recommendation Flag (latest, merchantid, selected time period) (copy) (copy)_6053260118176473098]=1 then [merchant_id] end)&#10;/&#10;countd([merchant_id]))&#10;&#10;Elseif [Parameters].[Parameter 4] = &quot;Recommendation&quot;&#10;then (countd(if [Calculation_6053260118174470149]=1 then [merchant_id] end)&#10;/&#10;countd([merchant_id]))&#10;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Reorder&quot;&#10;then (countd(if [Has Recommendation Flag (latest, merchantid, selected time period) (copy)_6053260118176464905]=1 then [merchant_id] end)&#10;/&#10;countd([merchant_id]))&#10;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Order Cart Recommendation&quot;&#10;then (countd(if [Has Reorder Flag (latest, merchantid, selected time period) (copy)_2487112903183446016]=1 then [merchant_id] end)&#10;/&#10;countd([merchant_id]))&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Item Recommendation&quot;&#10;then (countd(if [Has Reorder Flag (latest, merchantid, selected time period) (copy)_2487112903183699969]=1 then [merchant_id] end)&#10;/&#10;countd([merchant_id]))&#10;&#10;END' />
      </column>
      <column caption='index' datatype='integer' name='[Calculation_1583789331766272010]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='title ' datatype='string' name='[Calculation_1583789331767676939]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 4]' />
      </column>
      <column caption='all merchant count turned onn' datatype='integer' name='[Calculation_1583789331809845262]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 4] = &quot;Promotions&quot;&#10;then countd(if [Has Recommendation Flag (latest, merchantid, selected time period) (copy) (copy)_6053260118176473098]=1 then [merchant_id] end)&#10;ELSEIF  [Parameters].[Parameter 4] = &quot;Recommendation&quot;&#10;then countd(if [Calculation_6053260118174470149]=1 then [merchant_id] end)&#10;ELSEIF  [Parameters].[Parameter 4] = &quot;Reorder&quot;&#10;then countd(if [Has Recommendation Flag (latest, merchantid, selected time period) (copy)_6053260118176464905]=1 then [merchant_id] end)&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Order Cart Recommendation&quot;&#10;then countd(if [Has Reorder Flag (latest, merchantid, selected time period) (copy)_2487112903183446016]=1 then [merchant_id] end)&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Item Recommendation&quot;&#10;then countd(if [Has Reorder Flag (latest, merchantid, selected time period) (copy)_2487112903183699969]=1 then [merchant_id] end)&#10;&#10;END' />
      </column>
      <column caption='merchant list active' datatype='string' name='[Calculation_1583789332062773272]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 4] = &quot;Reorder&quot;&#10;then &#10;if [Has Recommendation Flag (latest, merchantid, selected time period) (copy)_6053260118176464905]=1 &#10;then [merchant_id] end&#10;&#10;ELSEIF  [Parameters].[Parameter 4] = &quot;Promotions&quot;&#10;then &#10;if [Has Recommendation Flag (latest, merchantid, selected time period) (copy) (copy)_6053260118176473098]=1 &#10;then [merchant_id] end&#10;&#10;ELSEIF  [Parameters].[Parameter 4] = &quot;Recommendation&quot;&#10;then &#10;if [Calculation_6053260118174470149]=1 &#10;then [merchant_id] end&#10;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Order Cart Recommendation&quot;&#10;then if [Has Reorder Flag (latest, merchantid, selected time period) (copy)_2487112903183446016]=1 &#10;&#10;then [merchant_id] end&#10;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Item Recommendation&quot;&#10;then &#10;if [Has Reorder Flag (latest, merchantid, selected time period) (copy)_2487112903183699969]=1 &#10;then [merchant_id] end&#10;&#10;END' />
      </column>
      <column caption='Selected Time Period' datatype='date' name='[Calculation_6053260118173356035]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='date(if [Parameters].[Parameter 3 1]=&apos;Year&apos; then DATETRUNC(&apos;year&apos;, [settings_date])&#10;elseif [Parameters].[Parameter 3 1]=&apos;Quarter&apos; then DATETRUNC(&apos;quarter&apos;, [settings_date])&#10;elseif [Parameters].[Parameter 3 1]=&apos;Month&apos; then DATETRUNC(&apos;month&apos;, [settings_date])&#10;elseif [Parameters].[Parameter 3 1]=&apos;Week&apos; then DATETRUNC(&apos;week&apos;, [settings_date])&#10;elseif [Parameters].[Parameter 3 1]=&apos;Today&apos; then TODAY()&#10;&#10;end)' />
      </column>
      <column caption='Max settings date (selected time period)' datatype='date' name='[Calculation_6053260118173777924]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{fixed [Calculation_6053260118173356035]: max([settings_date])}' />
      </column>
      <column caption='Has Recommendation Flag (latest, merchantid, selected time period)' datatype='integer' name='[Calculation_6053260118174470149]' role='measure' type='quantitative'>
