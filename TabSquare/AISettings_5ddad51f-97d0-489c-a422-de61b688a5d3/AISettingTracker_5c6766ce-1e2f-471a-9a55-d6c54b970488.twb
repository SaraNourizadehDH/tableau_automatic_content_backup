      <column caption='% of For You reorder On ' datatype='real' name='[% of For You reco On (copy) (copy)_1583789331761893383]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(if [Has Recommendation Flag (latest, merchantid, selected time period) (copy)_6053260118176464905]=1 then [merchant_id] end)&#10;/&#10;countd([merchant_id])' />
      </column>
      <column caption='% of For You promoOn' datatype='real' name='[% of For You reco On (copy)_1583789331761864710]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(if [Has Recommendation Flag (latest, merchantid, selected time period) (copy) (copy)_6053260118176473098]=1 then [merchant_id] end)&#10;/&#10;countd([merchant_id])' />
      </column>
      <column caption='count of merchant id turned onn' datatype='integer' name='[Calculation_1583789331753410561]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;if [Parameters].[Parameter 4] = &quot;Reorder&quot;&#10;and [has_order_history] = 1&#10;and [has_promotion] = 0&#10;and [has_recommendation] = 0&#10;     then [merchant_id] &#10;&#10;ELSEIF  [Parameters].[Parameter 4] = &quot;Promotions&quot;&#10;and [has_order_history] = 0&#10;and [has_promotion] = 1&#10;and [has_recommendation] = 0&#10;     then [merchant_id]&#10;     &#10;ELSEIF  [Parameters].[Parameter 4] = &quot;Recommendation&quot;&#10;and [has_order_history] = 0&#10;and [has_promotion] = 0&#10;and [has_recommendation] = 1&#10;     then [merchant_id]&#10;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;All&quot;&#10;and [has_order_history] = 1&#10;and [has_promotion] = 1&#10;and [has_recommendation] = 1&#10;     then [merchant_id]&#10;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Reco and Promo&quot;&#10;and [has_order_history] = 0&#10;and [has_promotion] = 1&#10;and [has_recommendation] = 1&#10;     then [merchant_id]&#10;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Reorder and Promo&quot;&#10;and [has_order_history] = 1&#10;and [has_promotion] = 1&#10;and [has_recommendation] = 0&#10;     then [merchant_id]&#10;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Reorder and Reco&quot;&#10;and [has_order_history] = 1&#10;and [has_promotion] = 0&#10;and [has_recommendation] = 1&#10;     then [merchant_id] &#10;END)' />
      </column>
      <column caption='all % promo onn' datatype='real' name='[Calculation_1583789331762749448]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 4] = &quot;Promotions&quot;&#10;then (countd(if [Has Recommendation Flag (latest, merchantid, selected time period) (copy) (copy)_6053260118176473098]=1 then [merchant_id] end)&#10;/&#10;countd([merchant_id]))&#10;&#10;Elseif [Parameters].[Parameter 4] = &quot;Recommendation&quot;&#10;then (countd(if [Calculation_6053260118174470149]=1 then [merchant_id] end)&#10;/&#10;countd([merchant_id]))&#10;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Reorder&quot;&#10;then (countd(if [Has Recommendation Flag (latest, merchantid, selected time period) (copy)_6053260118176464905]=1 then [merchant_id] end)&#10;/&#10;countd([merchant_id]))&#10;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Order Cart Recommendation&quot;&#10;then (countd(if [Has Reorder Flag (latest, merchantid, selected time period) (copy)_2487112903183446016]=1 then [merchant_id] end)&#10;/&#10;countd([merchant_id]))&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Item Recommendation&quot;&#10;then (countd(if [Has Reorder Flag (latest, merchantid, selected time period) (copy)_2487112903183699969]=1 then [merchant_id] end)&#10;/&#10;countd([merchant_id]))&#10;&#10;END' />
      </column>
      <column caption='merchant list ' datatype='string' name='[Calculation_1583789331764969481]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 4] = &quot;Reorder&quot;&#10;and [has_order_history] = 1&#10;and [has_promotion] = 0&#10;and [has_recommendation] = 0&#10;     then [restaurant_name]&#10;&#10;ELSEIF  [Parameters].[Parameter 4] = &quot;Promotions&quot;&#10;and [has_order_history] = 0&#10;and [has_promotion] = 1&#10;and [has_recommendation] = 0&#10;     then [restaurant_name]&#10;     &#10;ELSEIF  [Parameters].[Parameter 4] = &quot;Recommendation&quot;&#10;and [has_order_history] = 0&#10;and [has_promotion] = 0&#10;and [has_recommendation] = 1&#10;     then [merchant_id]&#10;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;All&quot;&#10;and [has_order_history] = 1&#10;and [has_promotion] = 1&#10;and [has_recommendation] = 1&#10;     then [restaurant_name]&#10;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Reco and Promo&quot;&#10;and [has_order_history] = 0&#10;and [has_promotion] = 1&#10;and [has_recommendation] = 1&#10;     then [restaurant_name]&#10;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Reorder and Promo&quot;&#10;and [has_order_history] = 1&#10;and [has_promotion] = 1&#10;and [has_recommendation] = 0&#10;     then [restaurant_name]&#10;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Reorder and Reco&quot;&#10;and [has_order_history] = 1&#10;and [has_promotion] = 0&#10;and [has_recommendation] = 1&#10;     then [restaurant_name]&#10;END' />
      </column>
