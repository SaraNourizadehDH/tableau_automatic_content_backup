          <calculation class='tableau' formula='&quot;Promotions&quot;' />
        </column>
        <column caption='Time Period New' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Last Week&quot;'>
