      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_CDEB7234BD144DEF84E8A4C001018FF0'>
            <properties context=''>
              <relation connection='bigquery.0ivoeqk04fa93o13z8gxd1j4jcc5' name='Custom SQL Query' type='text'><![CDATA[select * , 
case when (lag_recommendation- has_recommendation) = 1 then "turn off" 
 when  (lag_recommendation- has_recommendation) = -1 then "turn onn" 
 else "no change"
end as lag_recommendation_change, 

case when ( lag_has_promotion- has_promotion) = 1 then "turn off" 
 when  (lag_has_promotion- has_promotion) = -1 then "turn onn" 
 else "no change"
end as lag_has_promotion_change, 

case when (  lag_has_order_history- has_order_history) = 1 then "turn off" 
 when  (lag_has_order_history- has_order_history) = -1 then "turn onn" 
 else "no change"
end as lag_has_order_history_change,

case when ( lag_order_cart_recommendation- order_cart_recommendation) = 1 then "turn off" 
 when  (lag_order_cart_recommendation- order_cart_recommendation) = -1 then "turn onn" 
 else "no change"
end as lag_order_cart_recommendation_change,

case when (  lag_item_recommendation- item_recommendation) = 1 then "turn off" 
 when  (lag_item_recommendation- item_recommendation) = -1 then "turn onn" 
 else "no change"
end as lag_item_recommendation_change from (select * , 
lag(has_recommendation) over(partition by merchant_id order by settings_date) as lag_recommendation
,lag(has_promotion) over(partition by merchant_id order by settings_date) as lag_has_promotion,
lag(has_order_history) over(partition by merchant_id order by settings_date) as lag_has_order_history,
lag(order_cart_recommendation) over(partition by merchant_id order by settings_date) as lag_order_cart_recommendation,
lag(item_recommendation) over(partition by merchant_id order by settings_date) as lag_item_recommendation from (select base.*, gmv.gmv
from
(
  select master.merchant_id,  master.restaurant_name, master.restaurant_id,all_dates.date as settings_date, start_settings_date, end_settings_date,
gmv_start_date,
has_recommendation, has_promotion, has_order_history, order_cart_recommendation, item_recommendation,
mm.Chain_Name_in_system as chain_name_in_the_system,
    mm.Account_Name as account_name,
    mm.Name_of_Account_Manager as name_of_account_manager,
    mm.Team as team,
    mm.Country as country
from
(
  select date, 1 as dummy
from
UNNEST(GENERATE_DATE_ARRAY('2022-01-01', current_date(), INTERVAL 1 DAY)) as date
)all_dates
inner join
(
select merchant_id, restaurant_name, restaurant_id, settings_date as start_settings_date, 
coalesce(max(settings_date) over(partition by merchant_id
                        order by base.settings_date
                        rows between 1 following and 1 following), current_date()) as end_settings_date,
has_recommendation, has_promotion, has_order_history,order_cart_recommendation, item_recommendation,lag(has_recommendation) over(partition by base.merchant_id order by settings_date) as lag_recommendation, 
lag(has_promotion) over(partition by base.merchant_id order by settings_date) as lag_has_promotion,
lag(has_order_history) over(partition by base.merchant_id order by settings_date) as lag_has_order_history,
lag(order_cart_recommendation) over(partition by base.merchant_id order by settings_date) as lag_order_cart_recommendation,
lag(item_recommendation) over(partition by base.merchant_id order by settings_date) as lag_item_recommendation,
1 as dummy
from
(
select merchant_id,restaurant_name,  restaurant_id, date(metadata_timestamp) as settings_date,
metadata_timestamp,
row_number() over(partition by merchant_id, date(metadata_timestamp) 
                  order by metadata_timestamp desc) as rankk,
has_recommendation, has_promotion, has_order_history, order_cart_recommendation, item_recommendation,
from
(

SELECT
     sl.id as id,
    o.merchant_key as merchant_id,
    o.id as restaurant_id, 
    o.name as restaurant_name,
    sl.has_recommendation as has_recommendation,
    sl.has_promotion as has_promotion,
    sl.has_order_history as has_order_history,
    sl.has_order_cart_recommendation as order_cart_recommendation, 
    sl.has_item_recommendation as item_recommendation, 
    sl._metadata_timestamp  as metadata_timestamp
        FROM
`tabsquare-data-sciences.skipque_cdc_data_stag.chain_tier_setting_log` sl
inner JOIN
  `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_organization_view_prod` o
ON
  sl.id=o.tier_setting_id
  and sl.organization_id= o.organization_id
  union all
  SELECT
     sl1.id as id,
    o1.customer_key as merchant_id,
    o1.id as restaurant_id, 
    o1.name as restaurant_name,
    sl1.has_recommendation as has_recommendation,
    sl1.has_promotion as has_promotion,
    sl1.has_order_history as has_order_history,
    sl1.has_order_cart_recommendation as order_cart_recommendation, 
    sl1.has_item_recommendation as item_recommendation,
     sl1._metadata_timestamp  as metadata_timestamp
    FROM
`tabsquare-data-sciences.skipque_cdc_data_stag.smartweb_settings_log` sl1
inner JOIN
  `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_users_view_prod` o1
ON
sl1.created_by= o1.id
)base
)base
where rankk=1
)master
on all_dates.dummy = master.dummy
and all_dates.date>>=master.start_settings_date
and all_dates.date<<master.end_settings_date
inner join
 (
 select users.merchant_id, min(date(order_datetime)) as gmv_start_date
from
(
                select id, created_date as order_datetime,
                customer_id,restaurant_id,order_session_id as session_id, order_type_id
                from 
                `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_orders_view_prod` 
                where is_void=0 and status not in (-3,-4,0) 
                and app_type=4
                and date(created_date)>>='2018-01-01'
                and order_amount>>0
                )o
                inner join
                (
                select id, customer_key as merchant_id
                from
                `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_users_view_prod`
                group by 1,2
                union all
                select id, merchant_key as merchant_id
                from
                `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_organization_view_prod`
                group by 1,2)users
                on
                o.restaurant_id = users.id 
                group by 1

 )sd
 on master.merchant_id = sd.merchant_id
 left join
 `tabsquare-data-sciences.tabsquare_dw_lookups.master_merchant_list` mm
     on master.merchant_id = mm.Merchant_id 
 where all_dates.date>>=sd.gmv_start_date
)base
  left join
  (
 select merchant_id,order_date, sum(Sales) as gmv
 FROM
      `tabsquare-data-sciences.datastudio_dashboard_data.all_product_skipque_data` 
      where Product_Type = 'Smartweb'
      group by 1, 2
 )gmv
 on base.merchant_id = gmv.merchant_id
 and base.settings_date = gmv.order_date)
 order by merchant_id, settings_date)]]></relation>
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
