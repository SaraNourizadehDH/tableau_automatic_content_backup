            </column>
            <column _.fcp.RefreshableParameterRanges.true...default-value-field='[federated.1563tba06eosoi1dehc391u8qejf].[Calculation_2013390551815360515]' _.fcp.RefreshableParameterRanges.true...source-field='[federated.1563tba06eosoi1dehc391u8qejf].[settings_date]' caption='End Date' datatype='date' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='#2023-12-10#'>
