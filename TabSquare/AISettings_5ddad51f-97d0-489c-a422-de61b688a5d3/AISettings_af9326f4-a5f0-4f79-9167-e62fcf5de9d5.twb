    <worksheet name='Team FOR YOU SETTINGS TURNED OFF'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontsize='16'>TEAM</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Settings Data across time' name='federated.1563tba06eosoi1dehc391u8qejf' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.RefreshableParameterRanges.true...default-value-field='[federated.1563tba06eosoi1dehc391u8qejf].[Calculation_2013390551815200770]' _.fcp.RefreshableParameterRanges.true...source-field='[federated.1563tba06eosoi1dehc391u8qejf].[settings_date]' caption='Start Date' datatype='date' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='#2023-12-03#'>
              <calculation class='tableau' formula='#2023-12-03#' />
            </column>
            <column _.fcp.RefreshableParameterRanges.true...default-value-field='[federated.1563tba06eosoi1dehc391u8qejf].[Calculation_2013390551815360515]' _.fcp.RefreshableParameterRanges.true...source-field='[federated.1563tba06eosoi1dehc391u8qejf].[settings_date]' caption='End Date' datatype='date' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='#2023-12-10#'>
              <calculation class='tableau' formula='#2023-12-10#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1563tba06eosoi1dehc391u8qejf'>
            <column caption='Date Range' datatype='boolean' name='[Calculation_2013390551811502081]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[settings_date]&gt;= [Parameters].[Parameter 1] and&#13;&#10;[settings_date]&lt;= [Parameters].[Parameter 2]' />
            </column>
            <column caption='Latest Start Date' datatype='date' name='[Calculation_2013390551815200770]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='{fixed: max(date(DATETRUNC(&apos;week&apos;, [Calculation_2013390551815360515])))}' />
            </column>
            <column caption='Latest End Date' datatype='date' name='[Calculation_2013390551815360515]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='///{fixed :max(date(DATEADD(&apos;day&apos;,-1,{fixed: max([settings_date])})))}///&#10;&#10;{fixed: MAX([settings_date])}' />
            </column>
            <column caption='CMS/eCMS' datatype='string' name='[Calculation_6053260118167986176]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if CONTAINS([merchant_id], &apos;HQ-&apos;) then &apos;eCMS&apos;&#10;else &apos;CMS&apos; end' />
            </column>
            <column caption='For You Logic Only Turn Off /On' datatype='string' name='[For You Logic (copy) (copy)_2013390552029896727]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [lag_has_order_history_change]= &apos;turn off&apos; &#13;&#10;          and [lag_has_promotion_change]= &apos;turn off&apos; &#13;&#10;          and [lag_recommendation_change]= &apos;turn off&apos; &#13;&#10;then &apos;Turned Off&apos;&#13;&#10;ELSEIF [lag_has_order_history_change]&lt;&gt; &apos;turn off&apos;  &#13;&#10;          and [lag_has_promotion_change]&lt;&gt;&apos;turn off&apos; &#13;&#10;          and [lag_recommendation_change]= &apos;turn off&apos; &#13;&#10;then &apos;Turned Off&apos;&#13;&#10;ELSEIF [lag_has_order_history_change]= &apos;turn off&apos; &#13;&#10;          and [lag_has_promotion_change]&lt;&gt; &apos;turn off&apos; &#13;&#10;          and [lag_recommendation_change]&lt;&gt; &apos;turn off&apos; &#13;&#10;then &apos;Turned Off&apos;&#13;&#10;ELSEIF [lag_has_order_history_change]&lt;&gt; &apos;turn off&apos; &#13;&#10;          and [lag_has_promotion_change]= &apos;turn off&apos; &#13;&#10;          and [lag_recommendation_change]&lt;&gt; &apos;turn off&apos; &#13;&#10;then &apos;Turned Off&apos;&#13;&#10;ELSEIF [lag_has_order_history_change]&lt;&gt; &apos;turn off&apos; &#13;&#10;          and [lag_has_promotion_change]= &apos;turn off&apos; &#13;&#10;          and [lag_recommendation_change]= &apos;turn off&apos; &#13;&#10;then &apos;Turned Off&apos;&#13;&#10;ELSEIF [lag_has_order_history_change]= &apos;turn off&apos; &#13;&#10;          and [lag_has_promotion_change]= &apos;turn off&apos; &#13;&#10;          and [lag_recommendation_change]&lt;&gt; &apos;turn off&apos; &#13;&#10;then &apos;Turned Off&apos;&#13;&#10;ELSEIF [lag_has_order_history_change]= &apos;turn off&apos;  &#13;&#10;          and [lag_has_promotion_change]&lt;&gt;&apos;turn off&apos;  &#13;&#10;          and [lag_recommendation_change]= &apos;turn off&apos;  &#13;&#10;then &apos;Turned Off&apos;&#13;&#10;ELSEIF [lag_has_order_history_change]&lt;&gt; &apos;turn off&apos; &#13;&#10;          and [lag_has_promotion_change]&lt;&gt; &apos;turn off&apos;  &#13;&#10;          and [lag_recommendation_change]&lt;&gt; &apos;turn off&apos;  &#13;&#10;then &apos;Turned On&apos;&#13;&#10;END' />
