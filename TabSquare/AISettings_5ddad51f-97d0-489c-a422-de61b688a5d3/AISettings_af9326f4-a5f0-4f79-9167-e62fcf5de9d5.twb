          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='title ' datatype='string' name='[Calculation_1583789331767676939]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 4]' />
      </column>
      <column caption='all merchant count turned onn' datatype='integer' name='[Calculation_1583789331809845262]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 4] = &quot;Promotions&quot;&#10;then countd(if [Has Recommendation Flag (latest, merchantid, selected time period) (copy) (copy)_6053260118176473098]=1 then [merchant_id] end)&#10;ELSEIF  [Parameters].[Parameter 4] = &quot;Recommendation&quot;&#10;then countd(if [Calculation_6053260118174470149]=1 then [merchant_id] end)&#10;ELSEIF  [Parameters].[Parameter 4] = &quot;Reorder&quot;&#10;then countd(if [Has Recommendation Flag (latest, merchantid, selected time period) (copy)_6053260118176464905]=1 then [merchant_id] end)&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Order Cart Recommendation&quot;&#10;then countd(if [Has Reorder Flag (latest, merchantid, selected time period) (copy)_2487112903183446016]=1 then [merchant_id] end)&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Item Recommendation&quot;&#10;then countd(if [Has Reorder Flag (latest, merchantid, selected time period) (copy)_2487112903183699969]=1 then [merchant_id] end)&#10;&#10;END' />
      </column>
      <column caption='merchant list active' datatype='string' name='[Calculation_1583789332062773272]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 4] = &quot;Reorder&quot;&#10;then &#10;if [Has Recommendation Flag (latest, merchantid, selected time period) (copy)_6053260118176464905]=1 &#10;then [merchant_id] end&#10;&#10;ELSEIF  [Parameters].[Parameter 4] = &quot;Promotions&quot;&#10;then &#10;if [Has Recommendation Flag (latest, merchantid, selected time period) (copy) (copy)_6053260118176473098]=1 &#10;then [merchant_id] end&#10;&#10;ELSEIF  [Parameters].[Parameter 4] = &quot;Recommendation&quot;&#10;then &#10;if [Calculation_6053260118174470149]=1 &#10;then [merchant_id] end&#10;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Order Cart Recommendation&quot;&#10;then if [Has Reorder Flag (latest, merchantid, selected time period) (copy)_2487112903183446016]=1 &#10;&#10;then [merchant_id] end&#10;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Item Recommendation&quot;&#10;then &#10;if [Has Reorder Flag (latest, merchantid, selected time period) (copy)_2487112903183699969]=1 &#10;then [merchant_id] end&#10;&#10;END' />
      </column>
      <column caption='max date at merchant time period' datatype='date' name='[Calculation_1954843752687054849]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [merchant_id], [Calculation_6053260118173356035]: MAX([settings_date])}' />
      </column>
      <column caption='Date Range' datatype='boolean' name='[Calculation_2013390551811502081]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[settings_date]&gt;= [Parameters].[Parameter 1] and&#13;&#10;[settings_date]&lt;= [Parameters].[Parameter 2]' />
      </column>
      <column caption='Latest Start Date' datatype='date' name='[Calculation_2013390551815200770]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='{fixed: max(date(DATETRUNC(&apos;week&apos;, [Calculation_2013390551815360515])))}' />
      </column>
      <column caption='Latest End Date' datatype='date' name='[Calculation_2013390551815360515]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='///{fixed :max(date(DATEADD(&apos;day&apos;,-1,{fixed: max([settings_date])})))}///&#10;&#10;{fixed: MAX([settings_date])}' />
      </column>
      <column caption='dates cals ' datatype='real' name='[Calculation_2013390551819329540]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_1095782127341441033] &lt;= 7 then&#13;&#10;&#13;&#10;    &quot;This Week&quot;&#13;&#10;&#13;&#10;elseif [Calculation_1095782127341441033] &gt;= 7 AND [Calculation_1095782127341441033] &lt;= 14 then&#13;&#10;&#13;&#10;    &quot;Last Week&quot;&#13;&#10;&#13;&#10;&#13;&#10;DATEDIFF(&quot;day&quot;, [settings_date], TODAY())&#13;&#10;&#13;&#10;DATEDIFF(&apos;week&apos;, [Service End Date], today()) =1&#13;&#10; &#13;&#10;THEN &quot;End date last week&quot;&#13;&#10;&#13;&#10;&#13;&#10;Case p_Period_Select&#13;&#10;   When &apos;Current Week&apos; Then DateTrunc(&apos;week&apos;,Order_Date) = DateTrunc(&apos;week&apos;,Today())&#13;&#10;   When &apos;Last Week&apos; Then DateTrunc(&apos;week&apos;,Order_Date) = DateTrunc(&apos;week&apos;,Today()-7)&#13;&#10;   When &apos;Last Week PY&apos; Then DateTrunc(&apos;week&apos;,Order_Date) = DateTrunc(&apos;week&apos;,Today()-365)&#13;&#10;   Else False&#13;&#10;End' />
      </column>
      <column caption='Time Cal ' datatype='boolean' name='[Calculation_2013390551819399173]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='Case [Parameters].[Parameter 3 1]&#13;&#10;   When &apos;Current Week&apos; Then DateTrunc(&apos;week&apos;,[settings_date]) = DateTrunc(&apos;week&apos;,Today())&#13;&#10;   When &apos;Last Week&apos; Then DateTrunc(&apos;week&apos;,[settings_date]) = DateTrunc(&apos;week&apos;,Today()-7)&#13;&#10;   Else False&#13;&#10;End' />
      </column>
      <column caption='New Time Period' datatype='boolean' name='[Calculation_2013390551821815814]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATE(&#13;&#10;case&#13;&#10; [Parameters].[Parameter 5]&#13;&#10;   When &apos;Current Week&apos; Then DateTrunc(&apos;week&apos;,[settings_date]) = DateTrunc(&apos;week&apos;,Today())&#13;&#10;   When &apos;Last Week&apos; Then DateTrunc(&apos;week&apos;,[settings_date]) = DateTrunc(&apos;week&apos;,Today()-7)&#13;&#10;   WHEN &apos;Today&apos; THEN TODAY()&#13;&#10;End)&#13;&#10;&#13;&#10;date(if [Parameters].[Parameter 5]=&apos;Current Week&apos; then DATETRUNC(&apos;week&apos;, [settings_date])= DateTrunc(&apos;week&apos;,Today())&#13;&#10;elseif [Parameters].[Parameter 5]=&apos;Last Week&apos; then DATETRUNC(&apos;week&apos;, [settings_date]) = DateTrunc(&apos;week&apos;,Today()-7)&#13;&#10;elseif [Parameters].[Parameter 5]=&apos;Today&apos; then TODAY()&#13;&#10;&#13;&#10;end)' />
      </column>
      <column caption='Current Week' datatype='string' name='[Calculation_2013390551825293319]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if DateTrunc(&apos;week&apos;,[settings_date]) = DateTrunc(&apos;week&apos;,Today()) then &apos;Current Week&apos;&#13;&#10;End' />
      </column>
      <column caption='Last Week' datatype='string' name='[Calculation_2013390551826018312]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if DateTrunc(&apos;week&apos;,[settings_date]) = DateTrunc(&apos;week&apos;,Today()-7) THEN &apos;Last Week&apos;&#13;&#10;End' />
      </column>
      <column caption='New Selected Time Period (Week)' datatype='date' name='[Calculation_2013390551826276363]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if &#13;&#10; [Parameters].[Parameter 5]= &apos;Current Week&apos; Then date([Calculation_2013390551825293319])&#13;&#10;   ELSEIF [Parameters].[Parameter 5]= &apos;Last Week&apos; Then date([Calculation_2013390551826018312])&#13;&#10;   ELSEIF [Parameters].[Parameter 5]=&apos;Today&apos; THEN TODAY()&#13;&#10;End' />
      </column>
      <column caption='Turned Off Merchant Count' datatype='string' name='[Calculation_2013390551829938188]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3 1]= &quot;Last Week&quot; OR [Parameters].[Parameter 3 1]= &quot;Current Week&quot; OR [Parameters].[Parameter 3 1]= &quot;Today&quot; THEN&#13;&#10;    if [Has Recommendation Flag (latest, merchantid, selected time period) (copy)_6053260118176464905]=0 &#13;&#10;then [merchant_id] END&#13;&#10;&#13;&#10;ELSEIF  [Parameters].[Parameter 3 1]= &quot;Last Week&quot; OR [Parameters].[Parameter 3 1]= &quot;Current Week&quot; OR [Parameters].[Parameter 3 1]= &quot;Today&quot;  THEN&#13;&#10;    if [Has Reorder Flag (latest, merchantid, selected time period) (copy)_2487112903183699969]=0 &#13;&#10;then [merchant_id] END&#13;&#10;&#13;&#10;ELSEIF  [Parameters].[Parameter 3 1]= &quot;Last Week&quot; OR [Parameters].[Parameter 3 1]= &quot;Current Week&quot; OR [Parameters].[Parameter 3 1]= &quot;Today&quot;  THEN&#13;&#10;    if [Has Reorder Flag (latest, merchantid, selected time period) (copy)_2487112903183446016]=0 &#13;&#10;then [merchant_id] END&#13;&#10;&#13;&#10;ELSEIF  [Parameters].[Parameter 3 1]= &quot;Last Week&quot; OR [Parameters].[Parameter 3 1]= &quot;Current Week&quot; OR [Parameters].[Parameter 3 1]= &quot;Today&quot;  THEN&#13;&#10;    if [Has Recommendation Flag (latest, merchantid, selected time period) (copy) (copy)_6053260118176473098]=0 &#13;&#10;then [merchant_id] END&#13;&#10;&#13;&#10;ELSEIF  [Parameters].[Parameter 3 1]= &quot;Last Week&quot; OR [Parameters].[Parameter 3 1]= &quot;Current Week&quot; OR [Parameters].[Parameter 3 1]= &quot;Today&quot;  THEN&#13;&#10;    if [Calculation_6053260118174470149]=0 &#13;&#10;then [merchant_id] END&#13;&#10;END' />
      </column>
      <column caption='Item Reco Logic' datatype='string' name='[Calculation_2013390551833788430]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Has Reorder Flag (latest, merchantid, selected time period) (copy)_2487112903183699969]=0 &#13;&#10;          and [Has Reorder Flag (latest, merchantid, selected time period) (copy)_2487112903183446016]=0 &#13;&#10;then &apos;OverAll&apos;&#13;&#10;ELSEIF [Has Reorder Flag (latest, merchantid, selected time period) (copy)_2487112903183699969]&lt;&gt;0 &#13;&#10;          and [Has Reorder Flag (latest, merchantid, selected time period) (copy)_2487112903183446016]=0 &#13;&#10;then &apos;Only Reco Order&apos;&#13;&#10;ELSEIF [Has Reorder Flag (latest, merchantid, selected time period) (copy)_2487112903183699969]=0 &#13;&#10;          and [Has Reorder Flag (latest, merchantid, selected time period) (copy)_2487112903183446016]&lt;&gt;0 &#13;&#10;then &apos;Only Reco Item&apos;&#13;&#10;ELSEIF [Has Reorder Flag (latest, merchantid, selected time period) (copy)_2487112903183699969]&lt;&gt;0 &#13;&#10;          and [Has Reorder Flag (latest, merchantid, selected time period) (copy)_2487112903183446016]&lt;&gt;0 &#13;&#10;then &apos;No Reco&apos;&#13;&#10;END' />
      </column>
      <column caption='For You Logic' datatype='string' name='[Calculation_2013390551835488272]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Has Recommendation Flag (latest, merchantid, selected time period) (copy) (copy)_6053260118176473098]=0 &#13;&#10;          and [Calculation_6053260118174470149]=0 &#13;&#10;          and [Has Recommendation Flag (latest, merchantid, selected time period) (copy)_6053260118176464905]=0 &#13;&#10;then &apos;OverAll&apos;&#13;&#10;ELSEIF [Has Recommendation Flag (latest, merchantid, selected time period) (copy) (copy)_6053260118176473098]&lt;&gt;0 &#13;&#10;          and [Calculation_6053260118174470149]=0 &#13;&#10;          and [Has Recommendation Flag (latest, merchantid, selected time period) (copy)_6053260118176464905]&lt;&gt;0 &#13;&#10;then &apos;Only Recommendation&apos;&#13;&#10;ELSEIF [Has Recommendation Flag (latest, merchantid, selected time period) (copy) (copy)_6053260118176473098]&lt;&gt;0 &#13;&#10;          and [Calculation_6053260118174470149]&lt;&gt;0 &#13;&#10;          and [Has Recommendation Flag (latest, merchantid, selected time period) (copy)_6053260118176464905]=0 &#13;&#10;then &apos;Only Reorder&apos;&#13;&#10;ELSEIF [Has Recommendation Flag (latest, merchantid, selected time period) (copy) (copy)_6053260118176473098]=0 &#13;&#10;          and [Calculation_6053260118174470149]&lt;&gt;0 &#13;&#10;          and [Has Recommendation Flag (latest, merchantid, selected time period) (copy)_6053260118176464905]&lt;&gt;0 &#13;&#10;then &apos;Only Promo&apos;&#13;&#10;ELSEIF [Has Recommendation Flag (latest, merchantid, selected time period) (copy) (copy)_6053260118176473098]=0 &#13;&#10;          and [Calculation_6053260118174470149]=0 &#13;&#10;          and [Has Recommendation Flag (latest, merchantid, selected time period) (copy)_6053260118176464905]&lt;&gt;0 &#13;&#10;then &apos;Recommendation/Promo&apos;&#13;&#10;ELSEIF [Has Recommendation Flag (latest, merchantid, selected time period) (copy) (copy)_6053260118176473098]=0 &#13;&#10;          and [Calculation_6053260118174470149]&lt;&gt;0 &#13;&#10;          and [Has Recommendation Flag (latest, merchantid, selected time period) (copy)_6053260118176464905]=0 &#13;&#10;then &apos;Reorder/Promo&apos;&#13;&#10;ELSEIF [Has Recommendation Flag (latest, merchantid, selected time period) (copy) (copy)_6053260118176473098]&lt;&gt;0 &#13;&#10;          and [Calculation_6053260118174470149]=0 &#13;&#10;          and [Has Recommendation Flag (latest, merchantid, selected time period) (copy)_6053260118176464905]=0 &#13;&#10;then &apos;Recommendation/Reorder&apos;&#13;&#10;ELSEIF [Has Recommendation Flag (latest, merchantid, selected time period) (copy) (copy)_6053260118176473098]&lt;&gt;0 &#13;&#10;          and [Calculation_6053260118174470149]&lt;&gt;0 &#13;&#10;          and [Has Recommendation Flag (latest, merchantid, selected time period) (copy)_6053260118176464905]&lt;&gt;0 &#13;&#10;then &apos;No For You&apos;&#13;&#10;END' />
      </column>
      <column caption='Merchant Count (For You)' datatype='integer' name='[Calculation_2013390551839531025]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [merchant_id], [Calculation_6053260118173356035], [Calculation_2013390551835488272]:&#13;&#10;countd([merchant_id] )}' />
      </column>
      <column caption='reorder merchant counts turned off' datatype='string' name='[Calculation_2013390551880060947]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [Parameters].[Parameter 3 1]= &quot;Today&quot; THEN&#13;&#10;   if lag_has_order_history_change = &quot;turn off&quot; &#13;&#10;and  DATETRUNC(&apos;day&apos;, [settings_date]) = (TODAY()-1)&#13;&#10; then [merchant_id] END&#13;&#10;END' />
      </column>
      <column caption='New Selected Time Periods' datatype='date' name='[Calculation_2013390551884587029]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='date(if [Parameters].[Parameter 3 1]=&apos;Month&apos; then DATETRUNC(&apos;month&apos;, [settings_date])&#13;&#10;elseif [Parameters].[Parameter 3 1]=&apos;Week&apos; then DATETRUNC(&apos;week&apos;, [settings_date])&#13;&#10;elseif [Parameters].[Parameter 3 1]=&apos;Today&apos; then {MAX(DATETRUNC(&apos;day&apos;,[settings_date]))}&#13;&#10;ELSEIF [Parameters].[Parameter 3 1]= &apos;Last Week&apos; then DateTrunc(&apos;week&apos;,{MAX(DATETRUNC(&apos;week&apos;,[settings_date]))}-7)&#13;&#10;ELSEIF [Parameters].[Parameter 3 1]= &apos;Current Week&apos; then DateTrunc(&apos;week&apos;,{MAX(DATETRUNC(&apos;week&apos;,[settings_date]))})&#13;&#10;end)' />
      </column>
      <column caption='Order History Off Dates' datatype='date' name='[Calculation_2013390552030613528]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [lag_has_order_history_change]= &apos;turn off&apos; THEN [settings_date] END' />
      </column>
      <column caption='Promo Turn Off dates' datatype='date' name='[Calculation_2013390552031080473]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [lag_has_promotion_change]= &apos;turn off&apos; THEN [settings_date] END' />
      </column>
      <column caption='Order Cart Turn Off Dates' datatype='date' name='[Calculation_2013390552031367194]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [lag_order_cart_recommendation_change]= &apos;turn off&apos; THEN [settings_date] END' />
      </column>
      <column caption='Reco Turn Off Dates' datatype='date' name='[Calculation_2013390552031809563]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [lag_recommendation_change]= &apos;turn off&apos; THEN [settings_date] END' />
      </column>
      <column caption='Item Reco Turn Off Dates' datatype='date' name='[Calculation_2013390552033919004]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [lag_item_recommendation_change]= &apos;turn off&apos; THEN [settings_date] END' />
      </column>
      <column caption='Calculation1' datatype='boolean' name='[Calculation_2013390552092131362]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[settings_date]=TODAY()' />
      </column>
      <column caption='All Logic' datatype='string' name='[Calculation_2013390552494862373]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [lag_has_order_history_change]= &apos;turn off&apos; &#13;&#10;          and [lag_has_promotion_change]= &apos;turn off&apos; &#13;&#10;          and [lag_recommendation_change]= &apos;turn off&apos; &#13;&#10;          and [lag_item_recommendation_change]= &apos;turn off&apos;&#13;&#10;          and [lag_order_cart_recommendation_change]= &apos;turn off&apos;&#13;&#10;then &apos;All Off&apos;&#13;&#10;ELSEIF [lag_has_order_history_change]&lt;&gt; &apos;turn off&apos;  &#13;&#10;          and [lag_has_promotion_change]&lt;&gt;&apos;turn off&apos; &#13;&#10;          and [lag_recommendation_change]= &apos;turn off&apos; &#13;&#10;          and [lag_item_recommendation_change]= &apos;turn off&apos;&#13;&#10;          and [lag_order_cart_recommendation_change]= &apos;turn off&apos;&#13;&#10;then &apos;Recommendation Off&apos;&#13;&#10;ELSEIF [lag_has_order_history_change]= &apos;turn off&apos; &#13;&#10;          and [lag_has_promotion_change]&lt;&gt; &apos;turn off&apos; &#13;&#10;          and [lag_recommendation_change]&lt;&gt; &apos;turn off&apos; &#13;&#10;then &apos;Reorder Off&apos;&#13;&#10;ELSEIF [lag_has_order_history_change]&lt;&gt; &apos;turn off&apos; &#13;&#10;          and [lag_has_promotion_change]= &apos;turn off&apos; &#13;&#10;          and [lag_recommendation_change]&lt;&gt; &apos;turn off&apos; &#13;&#10;then &apos;Promo Off&apos;&#13;&#10;ELSEIF [lag_has_order_history_change]&lt;&gt; &apos;turn off&apos; &#13;&#10;          and [lag_has_promotion_change]= &apos;turn off&apos; &#13;&#10;          and [lag_recommendation_change]= &apos;turn off&apos; &#13;&#10;then &apos;Recommendation Off&apos;&#13;&#10;ELSEIF [lag_has_order_history_change]= &apos;turn off&apos; &#13;&#10;          and [lag_has_promotion_change]= &apos;turn off&apos; &#13;&#10;          and [lag_recommendation_change]&lt;&gt; &apos;turn off&apos; &#13;&#10;then &apos;Reorder Off&apos;&#13;&#10;ELSEIF [lag_has_order_history_change]= &apos;turn off&apos;  &#13;&#10;          and [lag_has_promotion_change]&lt;&gt;&apos;turn off&apos;  &#13;&#10;          and [lag_recommendation_change]= &apos;turn off&apos;  &#13;&#10;then &apos;Recommendation/Reorder&apos;&#13;&#10;ELSEIF [lag_has_order_history_change]&lt;&gt; &apos;turn off&apos; &#13;&#10;          and [lag_has_promotion_change]&lt;&gt; &apos;turn off&apos;  &#13;&#10;          and [lag_recommendation_change]&lt;&gt; &apos;turn off&apos;  &#13;&#10;then &apos;No For You Off&apos;&#13;&#10;ELSEIF [lag_item_recommendation_change]= &apos;turn off&apos;&#13;&#10;          and [lag_order_cart_recommendation_change]= &apos;turn off&apos;&#13;&#10;then &apos;All Reco Off&apos;&#13;&#10;ELSEIF [lag_item_recommendation_change]&lt;&gt; &apos;turn off&apos;&#13;&#10;          and [lag_order_cart_recommendation_change]= &apos;turn off&apos;&#13;&#10;then &apos;Reco Order Off&apos;&#13;&#10;ELSEIF [lag_item_recommendation_change]= &apos;turn off&apos;&#13;&#10;          and [lag_order_cart_recommendation_change]&lt;&gt; &apos;turn off&apos;&#13;&#10;then &apos;Reco Item Off&apos;&#13;&#10;ELSEIF [lag_item_recommendation_change]&lt;&gt; &apos;turn off&apos;&#13;&#10;          and [lag_order_cart_recommendation_change]&lt;&gt; &apos;turn off&apos;&#13;&#10;then &apos;No Reco Off&apos;&#13;&#10;END' />
      </column>
      <column caption='Calculation2' datatype='boolean' name='[Calculation_2013390552500084775]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[lag_has_order_history_change]= &apos;turn off&apos;' />
      </column>
      <column caption='Combined Turned Off' datatype='string' name='[Calculation_2013390553903845421]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [For You Logic (copy) (copy)_2013390552029896727]= &apos;Turned Off&apos; &#13;&#10;          and [Item Reco Logic (copy) (copy)_2013390552039206942]= &apos;Turned Off&apos; &#13;&#10;then &apos;Turned Off&apos;&#13;&#10;&#13;&#10;ELSEIF [For You Logic (copy) (copy)_2013390552029896727]&lt;&gt; &apos;Turned Off&apos; &#13;&#10;          and [Item Reco Logic (copy) (copy)_2013390552039206942]= &apos;Turned Off&apos; &#13;&#10;then &apos;Turned Off&apos;&#13;&#10;&#13;&#10;ELSEIF [For You Logic (copy) (copy)_2013390552029896727]= &apos;Turned Off&apos; &#13;&#10;          and [Item Reco Logic (copy) (copy)_2013390552039206942]&lt;&gt; &apos;Turned Off&apos; &#13;&#10;then &apos;Turned Off&apos;&#13;&#10;&#13;&#10;ELSEIF [For You Logic (copy) (copy)_2013390552029896727]&lt;&gt; &apos;Turned Off&apos; &#13;&#10;          and [Item Reco Logic (copy) (copy)_2013390552039206942]&lt;&gt; &apos;Turned Off&apos; &#13;&#10;then &apos;Turned On&apos;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Calculation3' datatype='string' name='[Calculation_2013390553906102318]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [lag_recommendation_change]= &apos;turn off&apos; then [merchant_id] END' />
      </column>
      <column caption='merchant list not equal to null' datatype='string' name='[Calculation_2487112903515172866]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if not ISNULL([Calculation_1583789332062773272]) then [merchant_id]&#10;END' />
      </column>
      <column caption='CMS/eCMS' datatype='string' name='[Calculation_6053260118167986176]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if CONTAINS([merchant_id], &apos;HQ-&apos;) then &apos;eCMS&apos;&#10;else &apos;CMS&apos; end' />
      </column>
      <column caption='Selected Time Period' datatype='date' name='[Calculation_6053260118173356035]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='date(if [Parameters].[Parameter 3 1]=&apos;Month&apos; then DATETRUNC(&apos;month&apos;, [settings_date])&#10;elseif [Parameters].[Parameter 3 1]=&apos;Week&apos; then DATETRUNC(&apos;week&apos;, [settings_date])&#10;elseif [Parameters].[Parameter 3 1]=&apos;Today&apos; then TODAY()&#13;&#10;ELSEIF [Parameters].[Parameter 3 1]= &apos;Last Week&apos; then DateTrunc(&apos;week&apos;,Today()-7)&#13;&#10;ELSEIF [Parameters].[Parameter 3 1]= &apos;Current Week&apos; then DateTrunc(&apos;week&apos;,Today())&#10;end)' />
      </column>
      <column caption='Max settings date (selected time period)' datatype='date' name='[Calculation_6053260118173777924]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{fixed [Calculation_6053260118173356035]: max([settings_date])}' />
      </column>
      <column caption='Has Recommendation Flag (latest, merchantid, selected time period)' datatype='integer' name='[Calculation_6053260118174470149]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed merchant_id, [Calculation_6053260118173356035]&#10;:&#10;max(if [settings_date]=[Calculation_6053260118173777924]&#10; then [has_recommendation]&#10;end)&#10;}' />
      </column>
      <column caption='% of For You reco On' datatype='real' name='[Calculation_6053260118176768012]' role='measure' type='quantitative'>
