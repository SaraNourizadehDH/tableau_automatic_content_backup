      <column caption='AI off' datatype='string' name='[Calculation_969118386315927552]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_6053260118174470149]=0 then &quot;Reco Off&quot; &#13;&#10;ELSEIF [Has Reorder Flag (latest, merchantid, selected time period) (copy)_2487112903183699969]= 0 then &quot;Item Reco Off&quot;&#13;&#10;ELSEIF [Has Reorder Flag (latest, merchantid, selected time period) (copy)_2487112903183446016]= 0 then &quot;Order Reco Off&quot;&#13;&#10;ELSEIF [Has Recommendation Flag (latest, merchantid, selected time period) (copy)_6053260118176464905]= 0 then &quot;Reorder Off&quot;&#13;&#10;ELSEIF [Has Recommendation Flag (latest, merchantid, selected time period) (copy) (copy)_6053260118176473098]= 0 then &quot;Promo Off&quot;&#13;&#10;ELSE &quot;Green&quot; END' />
