      <column caption='Reco Turn Onn Dates' datatype='date' name='[Reco Turn Off Dates (copy)_2893703546368520196]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [lag_recommendation_change]= &apos;turn onn&apos; THEN [settings_date] END' />
      </column>
      <column caption='Turned Off Merchant Count (copy)' datatype='string' name='[Turned Off Merchant Count (copy)_2013390551832256525]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3 1]= &quot;Last Week&quot; OR [Parameters].[Parameter 3 1]= &quot;Current Week&quot; OR [Parameters].[Parameter 3 1]= &quot;Today&quot; THEN&#13;&#10;    if [Has Recommendation Flag (latest, merchantid, selected time period) (copy)_6053260118176464905]=0 &#13;&#10;then [merchant_id] END&#13;&#10;&#13;&#10;ELSEIF  [Parameters].[Parameter 3 1]= &quot;Last Week&quot; OR [Parameters].[Parameter 3 1]= &quot;Current Week&quot; OR [Parameters].[Parameter 3 1]= &quot;Today&quot;  THEN&#13;&#10;    if [Has Reorder Flag (latest, merchantid, selected time period) (copy)_2487112903183699969]=0 &#13;&#10;then [merchant_id] END&#13;&#10;&#13;&#10;ELSEIF  [Parameters].[Parameter 3 1]= &quot;Last Week&quot; OR [Parameters].[Parameter 3 1]= &quot;Current Week&quot; OR [Parameters].[Parameter 3 1]= &quot;Today&quot;  THEN&#13;&#10;    if [Has Reorder Flag (latest, merchantid, selected time period) (copy)_2487112903183446016]=0 &#13;&#10;then [merchant_id] END&#13;&#10;&#13;&#10;ELSEIF  [Parameters].[Parameter 3 1]= &quot;Last Week&quot; OR [Parameters].[Parameter 3 1]= &quot;Current Week&quot; OR [Parameters].[Parameter 3 1]= &quot;Today&quot;  THEN&#13;&#10;    if [Has Recommendation Flag (latest, merchantid, selected time period) (copy) (copy)_6053260118176473098]=0 &#13;&#10;then [merchant_id] END&#13;&#10;&#13;&#10;ELSEIF  [Parameters].[Parameter 3 1]= &quot;Last Week&quot; OR [Parameters].[Parameter 3 1]= &quot;Current Week&quot; OR [Parameters].[Parameter 3 1]= &quot;Today&quot;  THEN&#13;&#10;    if [Calculation_6053260118174470149]=0 &#13;&#10;then [merchant_id] END&#13;&#10;END' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Custom SQL Query' datatype='table' name='[__tableau_internal_object_id__].[_CDEB7234BD144DEF84E8A4C001018FF0]' role='measure' type='quantitative' />
      <column caption='all % promo off' datatype='real' name='[all % promo onn (copy)_1583789332054712342]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 4] = &quot;Promotions&quot;&#10;then (countd(if [Has Recommendation Flag (latest, merchantid, selected time period) (copy) (copy)_6053260118176473098]=0 then [merchant_id] end)&#10;/&#10;countd([merchant_id]))&#10;&#10;Elseif [Parameters].[Parameter 4] = &quot;Recommendation&quot;&#10;then (countd(if [Calculation_6053260118174470149]=0 then [merchant_id] end)&#10;/&#10;countd([merchant_id]))&#10;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Reorder&quot;&#10;then (countd(if [Has Recommendation Flag (latest, merchantid, selected time period) (copy)_6053260118176464905]=0 then [merchant_id] end)&#10;/&#10;countd([merchant_id]))&#10;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Order Cart Recommendation&quot;&#10;then (countd(if [Has Reorder Flag (latest, merchantid, selected time period) (copy)_2487112903183446016]=0 then [merchant_id] end)&#10;/&#10;countd([merchant_id]))&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Item Recommendation&quot;&#10;then (countd(if [Has Reorder Flag (latest, merchantid, selected time period) (copy)_2487112903183699969]=0 then [merchant_id] end)&#10;/&#10;countd([merchant_id]))&#10;&#10;END' />
      </column>
      <column caption='all merchant count turned off' datatype='integer' name='[all merchant count turned onn (copy)_1583789331811524623]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 4] = &quot;Promotions&quot;&#10;then countd(if [Has Recommendation Flag (latest, merchantid, selected time period) (copy) (copy)_6053260118176473098]=0 &#13;&#10;and [settings_date]&gt;= [Parameters].[Parameter 1] and [settings_date]&lt;= [Parameters].[Parameter 2]&#13;&#10;then [merchant_id] end)&#10;ELSEIF  [Parameters].[Parameter 4] = &quot;Recommendation&quot;&#10;then countd(if [Calculation_6053260118174470149]=0 and [settings_date]&gt;= [Parameters].[Parameter 1] and [settings_date]&lt;= [Parameters].[Parameter 2] &#13;&#10;then [merchant_id] end)&#10;ELSEIF  [Parameters].[Parameter 4] = &quot;Reorder&quot;&#10;then countd(if [Has Recommendation Flag (latest, merchantid, selected time period) (copy)_6053260118176464905]=0 &#13;&#10;and [settings_date]&gt;= [Parameters].[Parameter 1] and [settings_date]&lt;= [Parameters].[Parameter 2]&#13;&#10;then [merchant_id] end)&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Order Cart Recommendation&quot;&#10;then countd(if [Has Reorder Flag (latest, merchantid, selected time period) (copy)_2487112903183446016]=0 &#13;&#10;and [settings_date]&gt;= [Parameters].[Parameter 1] and [settings_date]&lt;= [Parameters].[Parameter 2]&#13;&#10;then [merchant_id] end)&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Item Recommendation&quot;&#10;then countd(if [Has Reorder Flag (latest, merchantid, selected time period) (copy)_2487112903183699969]=0 &#13;&#10;and [settings_date]&gt;= [Parameters].[Parameter 1] and [settings_date]&lt;= [Parameters].[Parameter 2]&#13;&#10;then [merchant_id] end)&#10;END' />
      </column>
      <column caption='count of merchant id turned off' datatype='integer' name='[count of merchant id turned onn (copy)_1583789331758256133]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;if [Parameters].[Parameter 4] = &quot;Reorder&quot;&#10;and [has_order_history] = 0&#10;and [has_promotion] = 1&#10;and [has_recommendation] = 1&#10;     then [merchant_id] &#10;&#10;ELSEIF  [Parameters].[Parameter 4] = &quot;Promotions&quot;&#10;and [has_order_history] = 1&#10;and [has_promotion] = 0&#10;and [has_recommendation] = 1&#10;     then [merchant_id]&#10;     &#10;ELSEIF  [Parameters].[Parameter 4] = &quot;Recommendation&quot;&#10;and [has_order_history] = 1&#10;and [has_promotion] = 1&#10;and [has_recommendation] = 0&#10;     then [merchant_id]&#10;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;All&quot;&#10;and [has_order_history] = 0&#10;and [has_promotion] = 0&#10;and [has_recommendation] = 0&#10;     then [merchant_id]&#10;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Reco and Promo&quot;&#10;and [has_order_history] = 1&#10;and [has_promotion] = 0&#10;and [has_recommendation] = 0&#10;     then [merchant_id] &#10;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Reorder and Promo&quot;&#10;and [has_order_history] = 0&#10;and [has_promotion] = 0&#10;and [has_recommendation] = 1&#10;     then [merchant_id] &#10;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Reorder and Reco&quot;&#10;and [has_order_history] = 0&#10;and [has_promotion] = 1&#10;and [has_recommendation] = 0&#10;     then [merchant_id]&#10;END)' />
      </column>
      <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column aggregation='Sum' datatype='integer' name='[has_order_history]' role='dimension' type='ordinal' />
      <column aggregation='Sum' datatype='integer' name='[has_promotion]' role='dimension' type='ordinal' />
      <column aggregation='Sum' datatype='integer' name='[has_recommendation]' role='dimension' type='ordinal' />
      <column aggregation='Sum' datatype='integer' name='[item_recommendation]' role='dimension' type='ordinal' />
      <column caption='merchant list  all flag' datatype='string' name='[merchant list  (copy)_1583789331823661076]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 4] = &quot;Reorder&quot;&#10;and [has_order_history] = 1&#10;&#10;     then [merchant_id]&#10;&#10;ELSEIF  [Parameters].[Parameter 4] = &quot;Promotions&quot;&#10;&#10;and [has_promotion] = 1&#10;&#10;     then [merchant_id]&#10;     &#10;ELSEIF  [Parameters].[Parameter 4] = &quot;Recommendation&quot;&#10;&#10;and [has_recommendation] = 1&#10;     then [merchant_id]&#10;&#10;&#10;END' />
      </column>
      <column datatype='string' name='[merchant_id]' role='dimension' type='nominal' />
      <column aggregation='Sum' datatype='integer' name='[order_cart_recommendation]' role='dimension' type='ordinal' />
      <column caption='reorder merchant counts turned off (copy)' datatype='string' name='[reorder merchant counts turned off (copy)_2013390551880921108]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [Parameters].[Parameter 3 1]= &quot;Current Week&quot; THEN&#13;&#10;   if lag_has_order_history_change = &quot;turn off&quot; &#13;&#10;and  DATETRUNC(&apos;week&apos;, [settings_date]) = DateTrunc(&apos;week&apos;,Today()-7)&#13;&#10; then [merchant_id] END&#13;&#10;END' />
      </column>
