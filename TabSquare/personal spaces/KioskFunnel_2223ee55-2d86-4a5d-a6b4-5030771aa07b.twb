        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.04yphhd1jv7tjh18wfz8r0tpi8dq' name='Custom SQL Query' type='text'>select distinct x.*&#13;
from&#13;
(with click_login as &#13;
(select distinct cl.session_id as cl_session_id, cl.date_time as cl_date_time, cl.merchant_id as cl_merchant_id, cl.customer_id as cl_customer_id, &#13;
cl.login_mode as cl_login_mode, cl.origin as cl_origin, cl.app_version as cl_app_version, cl.clicked_on_page as cl_clicked_on_page&#13;
from `tabsquare-data-sciences.emenu_events.click_login` cl&#13;
where cl.menu_mode = &apos;Kiosk&apos; and cl.date &gt;&gt;= DATE_ADD(current_date(), INTERVAL -14 DAY)),&#13;
confirm_order as &#13;
(select distinct co.session_id as co_session_id, co.date_time as co_date_time, co.merchant_id as co_merchant_id, co.customer_id as co_customer_id&#13;
from `tabsquare-data-sciences.emenu_events.confirm_order` co&#13;
where co.menu_mode = &apos;Kiosk&apos; and co.date &gt;&gt;= date_add(current_date(), INTERVAL -14 DAY)),&#13;
click_logout as &#13;
(select distinct cll.session_id as cll_session_id, cll.date_time as cll_date_time, cll.merchant_id as cll_merchant_id, cll.customer_id as cll_customer_id, cll.origin as cll_origin&#13;
from `tabsquare-data-sciences.emenu_events.click_logout` cll&#13;
where cll.menu_mode = &apos;Kiosk&apos; and cll.date &gt;&gt;= date_add(current_date(), INTERVAL -14 DAY)),&#13;
click_category as  &#13;
(select distinct cc.session_id as cc_session_id, cc.date_time as cc_date_time, cc.merchant_id as cc_merchant_id, cc.customer_id as cc_customer_id,&#13;
cc.category_id as cc_category_id, cc.category_name as cc_category_name, 0 as cc_subcategory_id, &apos;NA&apos; as cc_subcategory_name,&#13;
&apos;NA&apos; as cc_clicked_on_page, 0 as cc_item_id, &apos;NA&apos; as cc_item_name, &apos;NA&apos; as cc_item_type&#13;
from `tabsquare-data-sciences.emenu_events.click_category` cc&#13;
where cc.menu_mode = &apos;Kiosk&apos; and cc.date &gt;&gt;= date_add(current_date(), INTERVAL -14 DAY)),&#13;
add_item as &#13;
(select distinct ai.session_id as ai_session_id, ai.date_time as ai_date_time, ai.merchant_id as ai_merchant_id, ai.customer_id as ai_customer_id, ai.clicked_on_page as ai_clicked_on_page, &#13;
ai.category_id as ai_category_id, ai.category_name as ai_category_name, ai.subcategory_id as ai_subcategory_id, ai.subcategory_name as ai_subcategory_name, &#13;
ai.item_id as ai_item_id, ai.item_name as ai_item_name, ai.item_type as ai_item_type, ai. is_personalized as ai_is_personalized&#13;
from `tabsquare-data-sciences.emenu_events.add_item` ai&#13;
where ai.menu_mode = &apos;Kiosk&apos; and ai.date &gt;&gt;= date_add(current_date(), INTERVAL -14 DAY)),&#13;
view_bill as &#13;
(select distinct vb.session_id as vb_session_id, vb.date_time as vb_date_time, vb.merchant_id as vb_merchant_id, vb.customer_id as vb_customer_id, &#13;
vb.bill_value as vb_bill_value, vb.currency as vb_currency, vb.order_type as vb_order_type &#13;
from`tabsquare-data-sciences.emenu_events.view_bill` as vb&#13;
where vb.menu_mode = &apos;Kiosk&apos; and vb.date &gt;&gt;= DATE_ADD(CURRENT_DATE(), INTERVAL -14 DAY)),&#13;
make_payment as &#13;
(select distinct mp.session_id as mp_session_id, mp.date_time as mp_date_time, mp.merchant_id as mp_merchant_id, mp.customer_id as mp_customer_id, &#13;
mp.bill_value as mp_bill_value, mp.currency as mp_currency, mp.order_type as mp_order_type, mp.payment_mode as mp_payment_mode&#13;
from `tabsquare-data-sciences.emenu_events.make_payment` mp&#13;
where mp.menu_mode = &apos;Kiosk&apos; and mp.date &gt;&gt;= DATE_ADD(CURRENT_DATE(), INTERVAL -14 DAY)),&#13;
successful_payment as&#13;
(select distinct sp.session_id as sp_session_id, sp.date_time as sp_date_time, sp.merchant_id as sp_merchant_id, sp.customer_id as sp_customer_id, &#13;
sp.origin as sp_origin, sp.bill_value as sp_bill_value, sp.currency as sp_currency, sp.order_type as sp_order_type,&#13;
sp.payment_mode as sp_payment_mode, &#13;
sp.cashback_available as sp_cashback_available, sp.cashback_earn_expiry as sp_cashback_earn_expiry, sp.cashback_earned as sp_cashback_earned, sp.cashback_redeemed as sp_cashback_redeemed&#13;
from `tabsquare-data-sciences.emenu_events.successful_payment` sp&#13;
where sp.menu_mode = &apos;Kiosk&apos; and sp.date &gt;&gt;= DATE_ADD(CURRENT_DATE(), INTERVAL -14 DAY))&#13;
&#13;
select distinct cl.*, cc.*, ai.*, vb.*, mp.*, sp.*, co.*, cll.*,&#13;
f.ordering_flow_v2,&#13;
CASE WHEN f.ordering_flow_v2 = &apos;True&apos; THEN &apos;New UI&apos;&#13;
ELSE &apos;Old UI&apos; end as UI,&#13;
CASE WHEN u.username is NULL THEN org.name else u.name end as RestaurantName, &#13;
CASE WHEN u.username is NULL THEN  org1.name else u1.name end as Brand_Name,&#13;
CASE WHEN u.username is NULL THEN c.name else c1.name end as Country,&#13;
CASE WHEN u.username is NULL THEN &apos;ECMS&apos; else &apos;CMS&apos; end as System,&#13;
from click_login cl&#13;
left join click_category cc on cl.cl_session_id = cc.cc_session_id&#13;
left join add_item ai on cl.cl_session_id = ai.ai_session_id&#13;
left join view_bill vb on cl.cl_session_id = vb.vb_session_id&#13;
left join make_payment mp on cl.cl_session_id = mp.mp_session_id&#13;
left join successful_payment sp on cl.cl_session_id = sp.sp_session_id&#13;
left join confirm_order co on cl.cl_session_id = co.co_session_id&#13;
left join click_logout cll on cl.cl_session_id = cll.cll_session_id&#13;
left join `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_organization_view_prod` org on cl.cl_merchant_id = org.merchant_key and org.is_test_account != 1&#13;
left join `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_organization_view_prod` org1 on org.organization_id = org1.id&#13;
left join `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_users_view_prod` u on cl.cl_merchant_id = u.customer_key&#13;
left join `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_users_view_prod` u1 on u.created_by = u1.id&#13;
left join `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_country_view_prod` c on org.country_id = c.id&#13;
left join `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_country_view_prod` c1 on u.country_code = c1.iso&#13;
left join `tabsquare-805d0.ts_master_data.ts_feature_flag` f on f.merchant_id = cl.cl_merchant_id&#13;
) as x&#13;
where NOT(LOWER(RestaurantName) LIKE (&quot;%test%&quot;)&#13;
    OR LOWER(RestaurantName) LIKE (&quot;%demo%&quot;)&#13;
    OR LOWER(RestaurantName) LIKE (&quot;%ts cafe%&quot;)&#13;
    OR LOWER(RestaurantName) LIKE (&quot;%latest%&quot;))</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
