      </column>
      <column caption='BrandName' datatype='string' name='[Brand_Name]' role='dimension' type='nominal' />
      <column caption='Menu Drop' datatype='real' default-format='p0.00%' name='[Calculation_1451566510193938432]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(([Calculation_622059748067995648]-[Calculation_622059748090105858])/[Calculation_622059748067995648])' />
      </column>
      <column caption='Order Drop' datatype='real' default-format='p0.00%' name='[Calculation_1451566510194831361]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(([Calculation_622059748090105858]-[Calculation_622059748091072519])/[Calculation_622059748091072519])' />
      </column>
      <column caption='Payment Drop' datatype='real' default-format='p0.00%' name='[Calculation_1451566510195154946]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(([Calculation_622059748091072519]-[Calculation_622059748090818565])/[Calculation_622059748091072519])' />
      </column>
      <column aggregation='Avg' caption='Menu Time (Sec)' datatype='integer' name='[Calculation_1626925420984188928]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [cl_date_time] &lt;= [sp_date_time] THEN &#13;&#10;DATEDIFF(&apos;second&apos;, [cl_date_time], [ai_date_time])&#13;&#10;END' />
      </column>
      <column aggregation='Avg' caption='Order Confirmation Time (Sec)' datatype='integer' name='[Calculation_1626925420984471553]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [cl_date_time] &lt;= [sp_date_time] THEN &#13;&#10;DATEDIFF(&apos;second&apos;, [ai_date_time], [co_date_time])&#13;&#10;END' />
      </column>
      <column aggregation='Avg' caption='Payment Time (Sec)' datatype='integer' name='[Calculation_1626925420984696834]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [cl_date_time] &lt;= [sp_date_time] THEN &#13;&#10;DATEDIFF(&apos;second&apos;, [co_date_time], [sp_date_time])&#13;&#10;END' />
      </column>
      <column caption='Latest End Date' datatype='date' name='[Calculation_454019190540300288]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{fixed :max(date(DATEADD(&apos;day&apos;,-1,{fixed: max([cl_date_time])})))}' />
      </column>
      <column caption='Latest Start Date' datatype='date' name='[Calculation_454019190540763137]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{fixed: max(date(DATETRUNC(&apos;day&apos;, [Calculation_454019190540300288] - 6)))}' />
      </column>
      <column caption='cl_datetime' datatype='date' name='[Calculation_454019190542639106]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='date([cl_date_time])' />
      </column>
      <column aggregation='Sum' caption='Current Time Period' datatype='integer' name='[Calculation_454019190543818756]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF &#13;&#10;[Calculation_454019190542639106] &gt;= [Parameters].[Parameter 1]&#13;&#10;and&#13;&#10;[Calculation_454019190542639106] &lt;=  [Parameters].[Parameter 2]&#13;&#10;then&#13;&#10;1 &#13;&#10;else 0&#13;&#10;END' />
      </column>
      <column caption='ClickLoginCount' datatype='integer' name='[Calculation_622059748067995648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([cl_session_id])' />
      </column>
      <column caption='ClickCategoryCount' datatype='integer' name='[Calculation_622059748068241409]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;IF not ISNULL([cc_date_time])&#13;&#10;THEN [cc_session_id]&#13;&#10;END)' />
      </column>
      <column caption='AddItemCount' datatype='integer' name='[Calculation_622059748090105858]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;IF not ISNULL([ai_date_time])&#13;&#10;THEN [ai_session_id]&#13;&#10;END)' />
      </column>
      <column caption='ViewBillCount' datatype='integer' name='[Calculation_622059748090384387]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;IF not ISNULL([vb_date_time])&#13;&#10;THEN [vb_session_id]&#13;&#10;END)' />
      </column>
      <column caption='MakePaymentCount' datatype='integer' name='[Calculation_622059748090683396]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;IF not ISNULL([mp_date_time])&#13;&#10;THEN [mp_session_id]&#13;&#10;END)' />
      </column>
      <column caption='SuccessPaymentCount' datatype='integer' name='[Calculation_622059748090818565]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;IF not ISNULL([sp_date_time])&#13;&#10;THEN [sp_session_id]&#13;&#10;END)' />
