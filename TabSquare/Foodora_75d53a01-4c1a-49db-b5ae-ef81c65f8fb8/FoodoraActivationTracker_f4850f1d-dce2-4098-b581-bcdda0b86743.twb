      <column datatype='string' name='[Account_Name]' role='dimension' type='nominal' />
      <column caption='Selected Metric' datatype='real' name='[Calculation_1909526290759573505]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2 1]&#13;&#10;WHEN &quot;sales&quot; then sum([Sales])&#13;&#10;WHEN &quot;orders&quot; then COUNTD([Order_Id])&#10;when &quot;outlets&quot; then countd([Merchant_id])&#10;when &quot;abv&quot; then sum([Sales])/COUNTD([Order_Id])&#13;&#10;WHEN  &quot;GMV/Outlet&quot; then SUM([Sales])/COUNTD([Merchant_id])&#13;&#10;WHEN &quot;Orders/Outlet&quot; THEN COUNTD([Order_Id])/COUNTD([Merchant_id])&#13;&#10;END' />
      </column>
      <column caption='Sales Filter' datatype='real' name='[Calculation_2276288200275488768]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Merchant_id]: SUM([Sales])}' />
      </column>
      <column caption='dummy' datatype='integer' name='[Calculation_5746874649548582919]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Selected Time Interval' datatype='date' name='[Calculation_5746874649573715997]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 4]=&apos;Year&apos; then date(DATETRUNC(&apos;year&apos;, [order_date]))&#10;ELSEIF [Parameters].[Parameter 4]=&apos;Quarter&apos; then date(DATETRUNC(&apos;quarter&apos;, [order_date]))&#10;elseif [Parameters].[Parameter 4]=&apos;Month&apos; then date(DATETRUNC(&apos;month&apos;, [order_date]))&#10;elseif [Parameters].[Parameter 4]=&apos;Week&apos; then date(DATETRUNC(&apos;week&apos;, [order_date]))&#10;elseif [Parameters].[Parameter 4]=&apos;Day&apos; then date(DATETRUNC(&apos;day&apos;, [order_date]))&#10;end' />
      </column>
      <column caption='Merchant_count' datatype='integer' name='[Calculation_769411852861452288]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Merchant_id])' />
      </column>
      <column caption='Selected Dimension' datatype='string' name='[Calculation_96123753339518988]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] == &quot;Country&quot; THEN [Country]&#10;ELSEIF [Parameters].[Parameter 1] == &quot;Order Type&quot; THEN [Order_Type]&#10;elseif [Parameters].[Parameter 1] == &apos;Payment Type&apos; then [Payment_Type]&#10;ELSEIF [Parameters].[Parameter 1] == &quot;Chain Name&quot; THEN [Chain_Name_in_system]&#10;ELSEIF [Parameters].[Parameter 1] == &quot;Team&quot; THEN [Team]&#10;ELSEIF [Parameters].[Parameter 1] == &quot;Restaurant Name&quot; THEN [RestaurantName]&#10;ELSEIF [Parameters].[Parameter 1] == &quot;Account Manager&quot; THEN [Name_of_Account_Manager]&#10;ELSEIF [Parameters].[Parameter 1] == &quot;Product Type&quot; THEN [Product_Type]&#10;ELSEIF [Parameters].[Parameter 1] == &quot;System&quot; THEN [System]&#10;elseif [Parameters].[Parameter 1] == &apos;Account Name&apos; then [Account_Name]&#10;elseif [Parameters].[Parameter 1] == &quot;Partner&quot; then [third_party_flag]&#10;end' />
      </column>
