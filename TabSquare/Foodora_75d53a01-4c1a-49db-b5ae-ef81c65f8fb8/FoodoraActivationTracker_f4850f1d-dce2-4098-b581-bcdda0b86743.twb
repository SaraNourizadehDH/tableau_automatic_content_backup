      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0bczd960m9u7vw10tg0cj094zyti].[ctd:Order_Id:qk]&quot;' value='Order count' />
          <alias key='&quot;[federated.0bczd960m9u7vw10tg0cj094zyti].[sum:Sales:qk]&quot;' value='GMV' />
