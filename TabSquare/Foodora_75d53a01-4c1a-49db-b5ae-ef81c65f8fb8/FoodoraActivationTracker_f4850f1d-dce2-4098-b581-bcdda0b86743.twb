    <datasource caption='Custom SQL Query (tabsquare_dw_ecms_prod)' inline='true' name='federated.0bczd960m9u7vw10tg0cj094zyti' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0bd3edm1lzqcl11bclh3n1vtrl3a'>
            <connection CATALOG='tabsquare-data-sciences' EXECCATALOG='tabsquare-data-sciences' authentication='auth-oauth-service-account' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='3' bq-large-fetch-rows='250000' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tabsquare-data-sciences' schema='tabsquare_dw_ecms_prod' server-oauth='server-custom' username='data-team-tableau@tabsquare-data-sciences.iam.gserviceaccount.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0bd3edm1lzqcl11bclh3n1vtrl3a' name='Custom SQL Query' type='text'>SELECT Country,  Merchant_id, RestaurantName, Chain_Name_in_system,Account_Name, Name_of_Account_Manager, MIN(order_date) as activation_date, MAX(running_orders) as total_orders, MAX(running_GMV) as total_GMV from 
(Select Country, Merchant_ID, RestaurantName, order_date, GMV, orders, Chain_Name_in_system, Account_Name, Name_of_Account_Manager,
 SUM(orders) OVER (PARTITION BY MERCHANT_ID, RestaurantName order by order_date) as running_orders,
 SUM(GMV) OVER (PARTITION BY MERCHANT_ID, RestaurantName order by order_date) as running_GMV,
  from 
(select a.*, b.Chain_Name_in_system,b.Account_Name,b.Name_of_Account_Manager, 
 case when coalesce(organization_partner_id,0)=1 then &apos;FoodPanda&apos; else &apos;TabSquare&apos; end as third_party_flag
from
(
SELECT Country, Merchant_id,RestaurantName,order_date, SUM(gmv) as GMV, SUM(orders) as orders from
(SELECT
  Country, Merchant_id, RestaurantName,order_date, sum(sales) as gmv , count(distinct order_id) as orders
FROM
  `tabsquare-data-sciences.datastudio_dashboard_data.all_product_firebase_data`
WHERE
  order_date &gt;&gt;= &apos;2022-01-01&apos;
GROUP BY 1,2,3,4
UNION ALL
SELECT
  Country, Merchant_id, RestaurantName, order_date, sum(Sales) as gmv , count(distinct order_id) as orders
FROM
  `tabsquare-data-sciences.datastudio_dashboard_data.all_product_skipque_data`
WHERE
  order_date &gt;&gt;= &apos;2022-01-01&apos;
GROUP BY 1,2,3,4)
GROUP BY 1,2,3,4
)a
left join
`tabsquare-data-sciences.tabsquare_dw_lookups.master_merchant_list` b
on a.merchant_id = b.merchant_id
left join
  `tabsquare-data-sciences.skipque_cdc_data_prod.organization` o
  on a.merchant_id = o.merchant_key
where o.organization_partner_id = 2)
ORDER by 1,2,3)
WHERE running_orders &gt;&gt;= 5
GROUP BY 1,2,3,4,5,6</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0bd3edm1lzqcl11bclh3n1vtrl3a' name='Custom SQL Query' type='text'>SELECT Country,  Merchant_id, RestaurantName, Chain_Name_in_system,Account_Name, Name_of_Account_Manager, MIN(order_date) as activation_date, MAX(running_orders) as total_orders, MAX(running_GMV) as total_GMV from 
(Select Country, Merchant_ID, RestaurantName, order_date, GMV, orders, Chain_Name_in_system, Account_Name, Name_of_Account_Manager,
 SUM(orders) OVER (PARTITION BY MERCHANT_ID, RestaurantName order by order_date) as running_orders,
 SUM(GMV) OVER (PARTITION BY MERCHANT_ID, RestaurantName order by order_date) as running_GMV,
  from 
(select a.*, b.Chain_Name_in_system,b.Account_Name,b.Name_of_Account_Manager, 
 case when coalesce(organization_partner_id,0)=1 then &apos;FoodPanda&apos; else &apos;TabSquare&apos; end as third_party_flag
from
(
SELECT Country, Merchant_id,RestaurantName,order_date, SUM(gmv) as GMV, SUM(orders) as orders from
(SELECT
  Country, Merchant_id, RestaurantName,order_date, sum(sales) as gmv , count(distinct order_id) as orders
FROM
  `tabsquare-data-sciences.datastudio_dashboard_data.all_product_firebase_data`
WHERE
  order_date &gt;&gt;= &apos;2022-01-01&apos;
GROUP BY 1,2,3,4
UNION ALL
SELECT
  Country, Merchant_id, RestaurantName, order_date, sum(Sales) as gmv , count(distinct order_id) as orders
FROM
  `tabsquare-data-sciences.datastudio_dashboard_data.all_product_skipque_data`
WHERE
  order_date &gt;&gt;= &apos;2022-01-01&apos;
GROUP BY 1,2,3,4)
GROUP BY 1,2,3,4
)a
left join
`tabsquare-data-sciences.tabsquare_dw_lookups.master_merchant_list` b
on a.merchant_id = b.merchant_id
left join
  `tabsquare-data-sciences.skipque_cdc_data_prod.organization` o
  on a.merchant_id = o.merchant_key
where o.organization_partner_id = 2)
ORDER by 1,2,3)
WHERE running_orders &gt;&gt;= 5
GROUP BY 1,2,3,4,5,6</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
