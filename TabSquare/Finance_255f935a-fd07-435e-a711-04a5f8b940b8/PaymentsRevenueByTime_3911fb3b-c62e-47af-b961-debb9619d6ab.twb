            <column caption='payment_type_final' datatype='string' name='[payment_type (copy)_315181654235389953]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if lower([payment_type]) = &apos;stripe&apos; then &apos;Stripe&apos;&#10;ELSEIF  CONTAINS(lower([payment_type]),&apos;adyen&apos;) then &apos;Adyen Legacy&apos;&#10;else [payment_type]&#10;end' />
