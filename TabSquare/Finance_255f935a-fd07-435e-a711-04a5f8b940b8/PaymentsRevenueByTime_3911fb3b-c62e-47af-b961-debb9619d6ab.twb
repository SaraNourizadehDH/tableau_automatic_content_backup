    <worksheet name='payment_sales_orders'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='12'>&lt;</run>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='12'>[Parameters].[Parameter 2 1]</run>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='12'>&gt;  by Payment Type</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Revenue New Query ' name='federated.0bczd960m9u7vw10tg0cj094zyti' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Total Net Txn Revenue' caption='Select Metric' datatype='string' name='[Parameter 2 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;net_txn_revenue&quot;'>
              <calculation class='tableau' formula='&quot;net_txn_revenue&quot;' />
              <aliases>
                <alias key='&quot;buy_rate&quot;' value='Buy Rate' />
                <alias key='&quot;net_txn_revenue&quot;' value='Total Net Txn Revenue' />
                <alias key='&quot;sell_rate&quot;' value='Sell Rate' />
                <alias key='&quot;total_commission&quot;' value='Total TS Commission' />
                <alias key='&quot;total_paid_gmv&quot;' value='Total Paid GMV' />
                <alias key='&quot;transactional_cost&quot;' value='Total TS Cost' />
              </aliases>
            </column>
            <column _.fcp.RefreshableParameterRanges.true...source-field='[federated.0bczd960m9u7vw10tg0cj094zyti].[order_date]' caption='Start Date' datatype='date' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='#2025-04-01#'>
              <calculation class='tableau' formula='#2025-04-01#' />
            </column>
            <column caption='Select Time Interval' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
            <column _.fcp.RefreshableParameterRanges.true...source-field='[federated.0bczd960m9u7vw10tg0cj094zyti].[order_date]' caption='End Date' datatype='date' name='[Start Date (copy)_5685161260887789568]' param-domain-type='range' role='measure' type='quantitative' value='#2025-08-31#'>
              <calculation class='tableau' formula='#2025-08-31#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0bczd960m9u7vw10tg0cj094zyti'>
            <column caption='Selected Metric' datatype='real' name='[Calculation_1909526290759573505]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2 1]&#10;WHEN &quot;net_txn_revenue&quot; then sum([net_txn_revenue_sgd])&#13;&#10;WHEN &quot;total_paid_gmv&quot; then sum([total_sales_sgd])&#13;&#10;WHEN &quot;total_commission&quot; then sum([ts_commission_sgd])&#13;&#10;WHEN &quot;transactional_cost&quot; then sum([total_ts_cost_sgd])&#13;&#10;WHEN &quot;buy_rate&quot; then  MIN(sum([total_ts_cost_sgd])*100/sum([total_sales_sgd]),10) &#10;WHEN &quot;sell_rate&quot; then MIN(sum([ts_commission_sgd])*100/sum([total_sales_sgd]),10)&#13;&#10;END' />
            </column>
            <column caption='Selected Time Interval' datatype='date' name='[Calculation_315181654228631552]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 4]=&apos;Year&apos; then date(DATETRUNC(&apos;year&apos;, [order_date]))&#10;ELSEIF [Parameters].[Parameter 4]=&apos;Quarter&apos; then date(DATETRUNC(&apos;quarter&apos;, [order_date]))&#10;elseif [Parameters].[Parameter 4]=&apos;Month&apos; then date(DATETRUNC(&apos;month&apos;, [order_date]))&#10;elseif [Parameters].[Parameter 4]=&apos;Week&apos; then date(DATETRUNC(&apos;week&apos;, [order_date], &apos;monday&apos;))&#10;elseif [Parameters].[Parameter 4]=&apos;Day&apos; then date(DATETRUNC(&apos;day&apos;, [order_date]))&#10;end' />
            </column>
            <column aggregation='Sum' caption='Current Time Period' datatype='integer' name='[Calculation_315181654237782019]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if [order_date]&gt;=[Parameters].[Parameter 2] and [order_date]&lt;=[Parameters].[Start Date (copy)_5685161260887789568] then 1 else 0 end' />
            </column>
            <column datatype='string' name='[Chain_name_in_system]' role='dimension' type='nominal' />
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[Name_of_Account_Manager]' role='dimension' type='nominal' />
            <column datatype='string' name='[Team]' role='dimension' type='nominal' />
            <column datatype='string' name='[account_name]' role='dimension' type='nominal' />
            <column datatype='string' name='[app_type_final]' role='dimension' type='nominal' />
            <column datatype='real' name='[net_txn_revenue_sgd]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_315181654228631552]' derivation='None' name='[none:Calculation_315181654228631552:ok]' pivot='key' type='ordinal' />
