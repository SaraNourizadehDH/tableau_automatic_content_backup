      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0bczd960m9u7vw10tg0cj094zyti].[ctd:Order_Id:qk]&quot;' value='Order count' />
          <alias key='&quot;[federated.0bczd960m9u7vw10tg0cj094zyti].[sum:Sales:qk]&quot;' value='GMV' />
        </aliases>
      </column>
      <column caption='Selected Metric' datatype='real' name='[Calculation_1909526290759573505]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2 1]&#10;WHEN &quot;net_txn_revenue&quot; then sum([net_txn_revenue_sgd])&#13;&#10;WHEN &quot;total_paid_gmv&quot; then sum([total_sales_sgd])&#13;&#10;WHEN &quot;total_commission&quot; then sum([ts_commission_sgd])&#13;&#10;WHEN &quot;transactional_cost&quot; then sum([total_ts_cost_sgd])&#13;&#10;WHEN &quot;buy_rate&quot; then  MIN(sum([total_ts_cost_sgd])*100/sum([total_sales_sgd]),10) &#10;WHEN &quot;sell_rate&quot; then MIN(sum([ts_commission_sgd])*100/sum([total_sales_sgd]),10)&#13;&#10;END' />
      </column>
      <column caption='Selected Time Interval' datatype='date' name='[Calculation_315181654228631552]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 4]=&apos;Year&apos; then date(DATETRUNC(&apos;year&apos;, [order_date]))&#10;ELSEIF [Parameters].[Parameter 4]=&apos;Quarter&apos; then date(DATETRUNC(&apos;quarter&apos;, [order_date]))&#10;elseif [Parameters].[Parameter 4]=&apos;Month&apos; then date(DATETRUNC(&apos;month&apos;, [order_date]))&#10;elseif [Parameters].[Parameter 4]=&apos;Week&apos; then date(DATETRUNC(&apos;week&apos;, [order_date], &apos;monday&apos;))&#10;elseif [Parameters].[Parameter 4]=&apos;Day&apos; then date(DATETRUNC(&apos;day&apos;, [order_date]))&#10;end' />
      </column>
      <column aggregation='Sum' caption='Current Time Period' datatype='integer' name='[Calculation_315181654237782019]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if [order_date]&gt;=[Parameters].[Parameter 2] and [order_date]&lt;=[Parameters].[Start Date (copy)_5685161260887789568] then 1 else 0 end' />
      </column>
      <column caption='Time Period' datatype='integer' name='[Calculation_5685161260887887873]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Parameters].[Parameter 2], [Parameters].[Start Date (copy)_5685161260887789568])+1' />
      </column>
      <column caption='Compare start date' datatype='date' name='[Calculation_5685161260888371202]' role='dimension' type='ordinal'>
