            <column-instance column='[Chain_name_in_system]' derivation='None' name='[none:Chain_name_in_system:nk]' pivot='key' type='nominal' />
            <column-instance column='[Country]' derivation='None' name='[none:Country:nk]' pivot='key' type='nominal' />
            <column-instance column='[Name_of_Account_Manager]' derivation='None' name='[none:Name_of_Account_Manager:nk]' pivot='key' type='nominal' />
            <column-instance column='[Team]' derivation='None' name='[none:Team:nk]' pivot='key' type='nominal' />
            <column-instance column='[account_name]' derivation='None' name='[none:account_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[app_type_final]' derivation='None' name='[none:app_type_final:nk]' pivot='key' type='nominal' />
            <column-instance column='[payment_type (copy)_315181654235389953]' derivation='None' name='[none:payment_type (copy)_315181654235389953:nk]' pivot='key' type='nominal' />
            <column-instance column='[restaurant_name]' derivation='None' name='[none:restaurant_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[third_partner_flag]' derivation='None' name='[none:third_partner_flag:nk]' pivot='key' type='nominal' />
            <column datatype='date' name='[order_date]' role='dimension' type='ordinal' />
            <column caption='payment_type_final' datatype='string' name='[payment_type (copy)_315181654235389953]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if lower([payment_type]) = &apos;stripe&apos; then &apos;Stripe&apos;&#10;ELSEIF  CONTAINS(lower([payment_type]),&apos;adyen&apos;) then &apos;Adyen Legacy&apos;&#10;else [payment_type]&#10;end' />
            </column>
            <column datatype='string' name='[payment_type]' role='dimension' type='nominal' />
            <column datatype='string' name='[restaurant_name]' role='dimension' type='nominal' />
