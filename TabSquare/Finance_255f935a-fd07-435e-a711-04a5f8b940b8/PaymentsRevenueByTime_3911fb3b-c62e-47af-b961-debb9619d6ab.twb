        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0bd3edm1lzqcl11bclh3n1vtrl3a' name='Custom SQL Query' type='text'>select a.*, b.Name_of_Account_Manager,b.Team,
case when c.organization_partner_id = 0 then &apos;TabSquare&apos;
     when c.organization_partner_id = 1 then &apos;Foodpanda&apos;
     else null end as third_partner_flag 

from `tabsquare-data-sciences.tabsquare_dw_lookups.net_txn_revenue` a 
left join 
`tabsquare-data-sciences.tabsquare_dw_lookups.master_merchant_list` b 
on a.merchant_key = b.merchant_id
left join
`tabsquare-data-sciences.all_skipque_cdc_data_prod.all_organization_view_prod` c 
on a.merchant_key = c.merchant_key</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0bd3edm1lzqcl11bclh3n1vtrl3a' name='Custom SQL Query' type='text'>select a.*, b.Name_of_Account_Manager,b.Team,
