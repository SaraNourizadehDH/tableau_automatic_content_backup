        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='bigquery.14ursey03wcz1q139xap00ugooi6' name='Custom SQL Query' type='text'>SELECT&#13;
  merchant_key,&#13;
  Country AS Country,&#13;
  account_name,&#13;
  Chain_name_in_system,&#13;
  restaurant_name,&#13;
  payment_type,&#13;
  app_type_final,&#13;
  DATE_TRUNC(order_date, MONTH) AS month_year,&#13;
  SUM(total_ts_cost_sgd) AS total_ts_cost_sgd,&#13;
  SUM(ts_commission_sgd) AS total_commission_sgd,&#13;
  SUM(total_sales_sgd) AS total_sales_sgd,&#13;
  SUM(net_txn_revenue_sgd) AS Net_Revenue,&#13;
   SUM(total_ts_cost) AS total_ts_cost,&#13;
  SUM(ts_commission) AS ts_commmission,&#13;
  SUM(total_sales) AS total_sales,&#13;
  CONCAT(merchant_key,payment_type,app_type_final ) AS Key&#13;
&#13;
FROM `tabsquare-data-sciences.tabsquare_dw_lookups.net_txn_revenue`&#13;
GROUP BY&#13;
  merchant_key,&#13;
  Country,&#13;
  account_name,&#13;
  Chain_name_in_system,&#13;
  restaurant_name,&#13;
  payment_type,&#13;
  app_type_final,&#13;
  month_year&#13;
ORDER BY&#13;
  merchant_key,&#13;
  month_year</relation>
