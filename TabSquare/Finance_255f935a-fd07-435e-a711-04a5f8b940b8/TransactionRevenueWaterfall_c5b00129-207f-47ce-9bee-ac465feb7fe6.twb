              <calculation class='tableau' formula='ifnull(SUM(IF [Calculation_1136033031088832542] = &quot;New&quot; AND [month_year] = [Parameters].[Parameter 1] THEN [total_commission_sgd] END),0) / [Calculation_1136033030914723846]&#13;&#10;&#13;&#10;//SUM(IF [New Flag] = 1 THEN [Ts Commmission] END) / [New GMV]' />
