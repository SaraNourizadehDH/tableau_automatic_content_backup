            <datasource caption='Custom SQL Query (tabsquare_dw_lookups)' name='federated.05tk3750z768lx1c8wrfi1pyqsrn' />
          </datasources>
          <datasource-dependencies datasource='federated.05tk3750z768lx1c8wrfi1pyqsrn'>
            <column caption='Account Name' datatype='string' name='[Account_Name]' role='dimension' type='nominal' />
            <column caption='Total Orders' datatype='integer' name='[Calculation_1620732968990515205]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull([product_orders],0)' />
            </column>
            <column caption='Number of Outlets' datatype='integer' name='[Calculation_1620732968990691334]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull([product_outlets],0)' />
            </column>
            <column caption='GMV (SGD)' datatype='real' name='[Calculation_1620732968990908423]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull([product_gmv],0)' />
            </column>
            <column caption='Paid GMV (SGD)' datatype='real' name='[Calculation_1620732968991068168]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull([product_paid_gmv],0)' />
            </column>
            <column caption='Recurring revenue (Subscription) / outlet' datatype='real' name='[Calculation_1620732968991825929]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_34973316490276866])/sum([Calculation_1620732968990691334])' />
            </column>
            <column caption='Recurring Profitability / outlet' datatype='real' name='[Calculation_1620732968992649226]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(ifnull([Total Recurring Revenue (copy)_34973317475016722],0))/sum(ifnull([Calculation_1620732968990691334],0))' />
            </column>
            <column caption='Recurring revenue (Subscription)' datatype='real' name='[Calculation_34973316490276866]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull([product_revenue],0) &#13;&#10;&#13;&#10;&#13;&#10;// Total Recurring Revenue//' />
            </column>
            <column caption='Recurring Profitability Take Rate' datatype='real' name='[Calculation_840554706181324800]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([Total Recurring Revenue (copy)_34973317475016722],0))/sum([Calculation_1620732968990908423])' />
            </column>
            <column caption='Cloud Hosting Costs - Managed Services' datatype='real' name='[Cloud Cost Per  Account (copy)_34973316526473231]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ifnull([Max Cloud Cost (copy)_34973316522225669],0)/ifnull([Max Cloud Cost (copy)_34973316522577928],0))* ifnull([product_orders],0)&#13;&#10;&#13;&#10;&#13;&#10;//Managed Cloud Cost Per Account//' />
            </column>
            <column caption='Max Managed Cloud cost' datatype='real' name='[Max Cloud Cost (copy)_34973316522225669]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [mod_month_year]:max([managed_cloud_hosting_cost])}' />
            </column>
            <column caption='Total orders' datatype='integer' name='[Max Cloud Cost (copy)_34973316522577928]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [mod_month_year]:sum([product_orders])}' />
            </column>
            <column caption='Max Cloud Cost' datatype='real' name='[Max Support Cost (copy)_34973316522123268]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [mod_month_year]:max([cloud_hosting_cost])}' />
            </column>
            <column caption='Recurring Revenue Take Rate ' datatype='real' name='[Recurring Profitability Take Rate (copy)_840554706181693441]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_34973316490276866])/SUM([Calculation_1620732968990908423])' />
            </column>
            <column caption='Cloud Hosting Costs' datatype='real' name='[Support Cost Per  Account (copy)_34973316526346254]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ifnull([Max Support Cost (copy)_34973316522123268],0)/ifnull([Max Cloud Cost (copy)_34973316522577928],0))* ifnull([product_orders],0)&#13;&#10;&#13;&#10;&#13;&#10;//Cloud Cost Per  Account//' />
            </column>
            <column caption='Recurring Profitability' datatype='real' name='[Total Recurring Revenue (copy)_34973317475016722]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull([product_revenue],0) + ifnull([Cloud Cost Per  Account (copy)_34973316526473231],0) + ifnull([Support Cost Per  Account (copy)_34973316526346254],0)' />
            </column>
