      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_8DC28F250D274AB09FC835D0C6DA5F28'>
            <properties context=''>
              <relation connection='bigquery.0slzt0u01ryokq16g03zv1x0d75y' name='Custom SQL Query' type='text'><![CDATA[with revenue_data as
(SELECT source_company,country,
 month_date as mod_month_year,Account_Name,max(Name_of_Account_Manager) as Name_of_Account_Manager,
sum(recurring_revenue_acc+deferred_revenue_acc) as recurring_revenue_total,
sum(transaction_stripe_revenue_acc + transaction_cash_revenue_acc+recurring_fee_adyen_acc+ transaction_fee_razerpay_acc + cos_tcc_oat_fee_refund_acc) as transaction_revenue_total,
sum(recurring_support_revenue_acc) as recurring_support_revenue,
sum(recurring_smartconnect_revenue_acc) as recurring_smartconnect_revenue,
sum(recurring_smartweb_revenue_acc) as recurring_smartweb_revenue,
sum(recurring_smarttab_revenue_acc) as recurring_smarttab_revenue,
sum(recurring_smartkiosk_revenue_acc) as recurring_smartkiosk_revenue,
sum(recurring_terminal_revenue_acc) as recurring_terminal_revenue,
sum(transactional_cost) as transaction_cost_total,
sum(gmv_acc) as gmv_total,
sum(paid_gmv_acc) as paid_gmv_total,
sum(orders) as orders,
count(distinct case when gmv_acc>>0 then merchant_id end) as total_outlets
 
  FROM `tabsquare-data-sciences.tabsquare_dw_lookups.revenue_merchant_level` rm 

 
  
   group by 1,2,3,4)
,

gmv_data as 
(select source_company,country,
 Account_Name, product_type, concat(extract(year from order_date),"-",extract(month from order_date)) as month_date, sum(sales) as gmv, sum(orders) as orders, sum(paid_gmv) as paid_gmv, count(distinct merchant_id) as outlets
from
(select a.*, b.Chain_Name_in_system,b.Account_Name,b.Name_of_Account_Manager,m.source_company,
b.Team, case when ifnull(organization_partner_id,0) in (1) then 'FoodPanda' 
 when ifnull(organization_partner_id,0) in (2) then 'Foodora'
 when ifnull(organization_partner_id,0) in (3) then 'Talabat'
 else 'TabSquare' end as third_party_flag,
 case when ifnull(organization_partner_id,0) in (1,2) and a.merchant_id in  (
"HQ-8543-8544","HQ-8656-8657","HQ-8664-8665","HQ-8818-8822","HQ-8117-8126","HQ-8117-8119","HQ-8351-8352","HQ-8557-8558","HQ-8137-8138","HQ-8193-8194",
"HQ-8582-8583","HQ-8100-8101","HQ-8131-8135","HQ-8097-8098","HQ-8230-8231","HQ-8131-8132","HQ-8573-8574","HQ-8389-8390","HQ-8826-8827","HQ-8831-8832",
"HQ-8824-8825","HQ-8845-8846","HQ-7959-7961","HQ-8061-8062","HQ-7960-7962","HQ-8131-8136","HQ-7370-7371","HQ-7604-7607","HQ-8078-8079","HQ-8133-8134",
"HQ-8133-8141","HQ-7964-7965","HQ-8646-8647","HQ-8654-8655","HQ-7937-7938","HQ-8108-8144","HQ-8258-8259","HQ-8652-8653","HQ-8821-8823","HQ-7605-7606",
"HQ-8117-8118","HQ-8706-8707","HQ-7776-8584","HQ-8518-8519","HQ-8531-8533","HQ-8267-8495","HQ-8108-8109","HQ-8577-8578","HQ-8372-8373","HQ-8157-8158",
"HQ-8287-8288","HQ-8403-8404","HQ-8370-8371","HQ-8353-8356","HQ-8096-8099","HQ-8300-8301","HQ-7663-7664","HQ-8267-8268","HQ-8195-8196","HQ-8159-8160",
"HQ-7937-7939","HQ-8059-8060","HQ-7689-7690","HQ-7780-7781","HQ-7900-7901","HQ-7755-7756","HQ-7358-7359","HQ-7543-7544","HQ-7624-7625","HQ-7682-7683",
"HQ-7729-7732","HQ-8128-8129","HQ-8267-8491","HQ-8243-8244","HQ-8485-8486","HQ-8120-8121","HQ-8094-8095","HQ-8294-8295","HQ-8289-8290","HQ-8292-8293",
"HQ-7751-7953","HQ-7887-7902","HQ-7694-7695","HQ-7935-7936","HQ-7719-7720","HQ-8122-8123","HQ-7790-7795","HQ-8680-8683","HQ-8625-8626","HQ-8532-8534",
"HQ-8017-8018","HQ-7751-7752","HQ-7784-7785","HQ-7915-7916","HQ-8621-8622","HQ-8674-8675","HQ-8623-8624","HQ-8585-8587","HQ-8401-8402","HQ-8537-8538",
"HQ-8374-8375","HQ-7759-7760","HQ-8106-8107","HQ-8115-8116","HQ-8305-8306","HQ-7967-7968","HQ-7753-7754","HQ-8076-8077","HQ-7991-7992","HQ-7821-7823",
"HQ-7989-7990","HQ-8063-8064","HQ-7788-7789","HQ-7887-7889","HQ-7757-7758","HQ-7777-7779","HQ-8376-8377","HQ-8627-8628","HQ-8575-8576","HQ-7747-7748",
"HQ-8019-8020","HQ-7887-7888") then "Food-Panda_PO"
when ifnull(organization_partner_id,0) in (1,2,3) and a.merchant_id not in  (
"HQ-8543-8544","HQ-8656-8657","HQ-8664-8665","HQ-8818-8822","HQ-8117-8126","HQ-8117-8119","HQ-8351-8352","HQ-8557-8558","HQ-8137-8138","HQ-8193-8194",
"HQ-8582-8583","HQ-8100-8101","HQ-8131-8135","HQ-8097-8098","HQ-8230-8231","HQ-8131-8132","HQ-8573-8574","HQ-8389-8390","HQ-8826-8827","HQ-8831-8832",
"HQ-8824-8825","HQ-8845-8846","HQ-7959-7961","HQ-8061-8062","HQ-7960-7962","HQ-8131-8136","HQ-7370-7371","HQ-7604-7607","HQ-8078-8079","HQ-8133-8134",
"HQ-8133-8141","HQ-7964-7965","HQ-8646-8647","HQ-8654-8655","HQ-7937-7938","HQ-8108-8144","HQ-8258-8259","HQ-8652-8653","HQ-8821-8823","HQ-7605-7606",
"HQ-8117-8118","HQ-8706-8707","HQ-7776-8584","HQ-8518-8519","HQ-8531-8533","HQ-8267-8495","HQ-8108-8109","HQ-8577-8578","HQ-8372-8373","HQ-8157-8158",
"HQ-8287-8288","HQ-8403-8404","HQ-8370-8371","HQ-8353-8356","HQ-8096-8099","HQ-8300-8301","HQ-7663-7664","HQ-8267-8268","HQ-8195-8196","HQ-8159-8160",
"HQ-7937-7939","HQ-8059-8060","HQ-7689-7690","HQ-7780-7781","HQ-7900-7901","HQ-7755-7756","HQ-7358-7359","HQ-7543-7544","HQ-7624-7625","HQ-7682-7683",
"HQ-7729-7732","HQ-8128-8129","HQ-8267-8491","HQ-8243-8244","HQ-8485-8486","HQ-8120-8121","HQ-8094-8095","HQ-8294-8295","HQ-8289-8290","HQ-8292-8293",
"HQ-7751-7953","HQ-7887-7902","HQ-7694-7695","HQ-7935-7936","HQ-7719-7720","HQ-8122-8123","HQ-7790-7795","HQ-8680-8683","HQ-8625-8626","HQ-8532-8534",
"HQ-8017-8018","HQ-7751-7752","HQ-7784-7785","HQ-7915-7916","HQ-8621-8622","HQ-8674-8675","HQ-8623-8624","HQ-8585-8587","HQ-8401-8402","HQ-8537-8538",
"HQ-8374-8375","HQ-7759-7760","HQ-8106-8107","HQ-8115-8116","HQ-8305-8306","HQ-7967-7968","HQ-7753-7754","HQ-8076-8077","HQ-7991-7992","HQ-7821-7823",
"HQ-7989-7990","HQ-8063-8064","HQ-7788-7789","HQ-7887-7889","HQ-7757-7758","HQ-7777-7779","HQ-8376-8377","HQ-8627-8628","HQ-8575-8576","HQ-7747-7748",
"HQ-8019-8020","HQ-7887-7888") then "Food-Panda_P1"
else "TS"
 end as PO_P1_TS
from
(
SELECT
  Merchant_id,RestaurantName,order_date,Order_Type,Country,Product_Type,Payment_Type,data_source,System, sum(sales) as Sales, count(order_id) as orders, sum(Paid_Gmv) as Paid_Gmv
FROM
  `tabsquare-data-sciences.datastudio_dashboard_data.all_product_firebase_data`
WHERE
  order_date >>= '2025-01-01' and order_date <<= current_date('Asia/Singapore')
  and merchant_id not like '%HQ-24%'
  and merchant_id not like '%HQ-6278%'
  GROUP BY 1,2,3,4,5,6,7,8,9
UNION ALL
SELECT
  Merchant_id,RestaurantName,order_date,Order_Type,Country,Product_Type,Payment_Type,data_source,System, sum(sales) as Sales, count(order_id) as orders, sum(Paid_Gmv) as Paid_Gmv
FROM
  `tabsquare-data-sciences.datastudio_dashboard_data.all_product_skipque_data`
WHERE
  order_date >>= '2025-01-01' and order_date <<= current_date('Asia/Singapore')
  GROUP BY 1,2,3,4,5,6,7,8,9

UNION ALL 

SELECT
  Merchant_id,RestaurantName,extract(date from order_date) as order_date,Order_Type,Country,Product_Type,Payment_Type,data_source,System, sum(sales) as Sales, sum(Orders) as orders, 0 as Paid_Gmv
FROM
  `tabsquare-data-sciences.tabsquare_dw_lookups.kfc_taco_gmv`

  GROUP BY 1,2,3,4,5,6,7,8,9
) as a
left join
`tabsquare-data-sciences.tabsquare_dw_lookups.master_merchant_list_tableau_view` as b
on a.merchant_id = b.merchant_id
left join
`tabsquare-data-sciences.all_skipque_cdc_data_prod.all_organization_view_prod` o
on a.merchant_id = o.merchant_key
left join (select distinct merchant_id,source_company from `tabsquare-data-sciences.tabsquare_dw_lookups.revenue_merchant_level` ) m 
on a.merchant_id=m.merchant_id

)
group by 1,2,3,4,5),

cost_data as 
(
SELECT
               'INVOICE' as type,
               i.transaction_date, i.doc_number, c.company_name, i.exchange_rate,
              
               i.currency_id, il.description, il.amount, il.sales_item_quantity,
               ifnull(a.account_number,ab.account_number) as account_number, ifnull(a.description, ab.description) as description,
               a.fully_qualified_name, i.source_company, qi.fully_qualified_name AS product_service,c.fully_qualified_name as full_customer_name, case when a.account_number in ('4-1737', '4-1782') and extract(day from transaction_date) <<= 5 then date_sub(transaction_date,INTERVAL 10 DAY) else transaction_date end as mod_transaction_date
           FROM  
               `tabsquare-data-sciences.tabsquare_master_quickbooks.invoice` i
           INNER JOIN
               `tabsquare-data-sciences.tabsquare_master_quickbooks.invoice_line` il
           ON  i.id = il.invoice_id
           AND i.source_company = il.source_company
          
           LEFT JOIN
               `tabsquare-data-sciences.tabsquare_master_quickbooks.item` qi
              
           ON il.sales_item_item_id = qi.id
           AND il.source_company = qi.source_company
          
          
           LEFT JOIN
               `tabsquare-data-sciences.tabsquare_master_quickbooks.account` a
           ON  il.sales_item_account_id = a.id
           AND il.source_company = a.source_company


           LEFT JOIN
               `tabsquare-data-sciences.tabsquare_master_quickbooks.account` ab
           ON  qi.income_account_id = ab.id
           AND qi.source_company = ab.source_company
          
           LEFT JOIN
               `tabsquare-data-sciences.tabsquare_master_quickbooks.customer` c
           ON  i.customer_id = c.id
           AND i.source_company = c.source_company
           where coalesce(a.account_number,ab.account_number) is not null
              
          
           UNION ALL
          
          
           SELECT
               'CREDIT NOTE' as type,
                cm.transaction_date, cm.doc_number, cu.company_name,cm.exchange_rate,
                cm.currency_id, cl.description, cl.amount*-1, cl.sales_item_quantity,
                a.account_number, a.description AS account_description,
                a.fully_qualified_name, a.source_company, qj.fully_qualified_name as product_service,cu.fully_qualified_name as full_customer_name, transaction_date as mod_transaction_date
               
           FROM
               `tabsquare-data-sciences.tabsquare_master_quickbooks.credit_memo` cm
           INNER JOIN
               `tabsquare-data-sciences.tabsquare_master_quickbooks.credit_memo_line` cl
           ON  cm.id = cl.credit_memo_id
           AND cm.source_company = cl.source_company
          
           LEFT JOIN
               `tabsquare-data-sciences.tabsquare_master_quickbooks.item` qj
              
           ON cl.sales_item_item_id = qj.id
          
           AND cl.source_company = qj.source_company
          
           LEFT JOIN
               `tabsquare-data-sciences.tabsquare_master_quickbooks.account` a
           ON  cl.sales_item_account_id = a.id
           AND cl.source_company = a.source_company
          
          
           LEFT JOIN
               `tabsquare-data-sciences.tabsquare_master_quickbooks.customer` cu
           ON  cm.customer_id = cu.id
           AND cm.source_company = cu.source_company
          
           WHERE account_number IS NOT NULL 
         
          UNION ALL


         SELECT
               'JOURNAL ENTRY' as type,
                cm.transaction_date, cm.doc_number, cu.company_name,cm.exchange_rate,
                cm.currency_id, cl.description, case when posting_type = 'Debit' then cl.amount*-1 else cl.amount end as amount,null as sales_item_quantity,
                a.account_number, a.description AS account_description,
                a.fully_qualified_name, cm.source_company, null as product_service,cu.fully_qualified_name as full_customer_name,
                transaction_date as mod_transaction_date
               
           FROM
               `tabsquare-data-sciences.tabsquare_master_quickbooks.journal_entry` cm
           INNER JOIN
               `tabsquare-data-sciences.tabsquare_master_quickbooks.journal_entry_line` cl
           ON  cm.id = cl.journal_entry_id
           AND cm.source_company = cl.source_company


          
           LEFT JOIN
               `tabsquare-data-sciences.tabsquare_master_quickbooks.account` a
           ON  cl.account_id = a.id
           AND cl.source_company = a.source_company
          
          
           LEFT JOIN
               `tabsquare-data-sciences.tabsquare_master_quickbooks.customer` cu
           ON  cl.customer_id = cu.id
           AND cl.source_company = cu.source_company
          
           WHERE account_number IS NOT NULL and account_number in("4-1732", "5-1731", "5-1735")
          
          
       UNION ALL


       SELECT
               'BILL' as type,
                cm.transaction_date, cm.doc_number, cu.company_name,cm.exchange_rate,
                cm.currency_id, cl.description,cl.amount*-1,null as sales_item_quantity,
                a.account_number, a.description AS account_description,
                a.fully_qualified_name, cm.source_company, null as product_service,cu.fully_qualified_name as full_customer_name,
                transaction_date as mod_transaction_date
               
           FROM
               `tabsquare-data-sciences.tabsquare_master_quickbooks.bill` cm
           INNER JOIN
               `tabsquare-data-sciences.tabsquare_master_quickbooks.bill_line` cl
           ON  cm.id = cl.bill_id
           AND cm.source_company = cl.source_company
          


          
           LEFT JOIN
               `tabsquare-data-sciences.tabsquare_master_quickbooks.account` a
           ON  cl.account_expense_account_id = a.id
           AND cl.source_company = a.source_company
          
          
           LEFT JOIN
               `tabsquare-data-sciences.tabsquare_master_quickbooks.customer` cu
           ON  cl.account_expense_customer_id = cu.id
           AND cl.source_company = cu.source_company
          
           WHERE account_number IS NOT NULL)



select c.*,cd.support_cost,cd.cloud_hosting_cost, cd.managed_cloud_hosting_cost,cd.am_cost from 
(select
a.*, g.product_type, g.gmv as product_gmv,g.orders as product_orders, g.paid_gmv as product_paid_gmv, g.outlets as product_outlets,
case when product_type = 'SmartKiosk' then a.recurring_smartkiosk_revenue   
     when product_type = 'Smartweb' then a.recurring_smartweb_revenue 
     when product_type = 'SmartTab' then a.recurring_smarttab_revenue 
     when product_type = 'SmartConnect' then a.recurring_smartconnect_revenue
     when product_type = 'SmartTerminal' then a.recurring_terminal_revenue
 else 0 end 
as product_revenue
from revenue_data a 
left join gmv_data g 
on a.country = g.country
and a.source_company = g.source_company
and a.account_name = g.account_name
and a.mod_month_year=g.month_date) c
 left join 
(
select source_company, month_date,am_cost,
sum(support_cost) over (partition by month_date) as support_cost,
sum(cloud_hosting_cost) over (partition by month_date) as cloud_hosting_cost,
sum(managed_cloud_hosting_cost) over  (partition by month_date) as managed_cloud_hosting_cost,
from 
(select 
source_company,
concat(extract(year from mod_transaction_date),'-',extract(month from mod_transaction_date)) as month_date,
sum(case when account_number like '5-15%' then net_amount else 0 end) as support_cost,
sum(case when account_number in ('5-1710','5-1711') then net_amount else 0 end) as cloud_hosting_cost,
sum(case when account_number in ('5-1712') then net_amount else 0 end) as managed_cloud_hosting_cost,
sum(case when account_number like '6-129%' then net_amount else 0 end) as am_cost
from
(select *, case when source_company = 'tabsquare_pte' then amount*exchange_rate
when source_company = 'tabsquare_pty' then amount*exchange_rate*0.9004687
when source_company = 'tabsquare_smart_solution' then amount*exchange_rate*0.000089
when source_company = 'tabsquare_sdn_bhd' then amount*exchange_rate* 0.30
else amount*exchange_rate end net_amount from  cost_data)
group by 1,2)) cd 
on c.source_company = cd.source_company 
and c.mod_month_year = cd.month_date]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
