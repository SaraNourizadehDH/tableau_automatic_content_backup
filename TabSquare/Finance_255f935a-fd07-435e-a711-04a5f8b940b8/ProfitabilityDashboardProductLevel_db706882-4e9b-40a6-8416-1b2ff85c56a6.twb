            <connection CATALOG='tabsquare-data-sciences' EXECCATALOG='tabsquare-data-sciences' authentication='auth-oauth-service-account' bq-fetch-tasks='3' bq-large-fetch-rows='250000' class='bigquery' connection-dialect='google-sql' project='tabsquare-data-sciences' schema='tabsquare_dw_lookups' server-oauth='server-custom' username='data-team-tableau@tabsquare-data-sciences.iam.gserviceaccount.com' workgroup-auth-mode='prompt' />
