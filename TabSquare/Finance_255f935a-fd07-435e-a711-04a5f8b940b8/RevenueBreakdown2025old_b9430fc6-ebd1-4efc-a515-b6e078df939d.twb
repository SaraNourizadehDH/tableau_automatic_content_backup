            <column datatype='string' name='[Merchant Key]' role='dimension' type='nominal' />
            <column datatype='real' name='[Net Revenue]' role='measure' type='quantitative' />
            <column caption='Current Existing GMV' datatype='real' name='[Previous Existing GMV (copy)_1088182285244129313]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull(SUM(&#13;&#10;  IF [Calculation_1136033031088832542]=&apos;Existing&apos;&#13;&#10;     AND [month_year] = [Parameters].[Parameter 1]&#13;&#10; THEN [total_sales_sgd]&#13;&#10;END),0)&#13;&#10;&#13;&#10;//[Select Reporting Month]' />
