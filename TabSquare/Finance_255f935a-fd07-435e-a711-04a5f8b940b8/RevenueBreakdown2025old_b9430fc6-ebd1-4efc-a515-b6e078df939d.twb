            <column caption='Label' datatype='string' name='[Calculation_1088182285248987174]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Step Id]&#13;&#10;    WHEN 1 THEN &apos;Previous Net Revenue&apos;&#13;&#10;    WHEN 2 THEN &apos;Existing GMV Contribution&apos;&#13;&#10;    WHEN 3 THEN &apos;New GMV Contribution&apos;&#13;&#10;    WHEN 4 THEN &apos;Churn GMV Contribution&apos;&#13;&#10;    WHEN 5 THEN &apos;Existing Take Rate Contribution&apos;&#13;&#10;    WHEN 6 THEN &apos;New Take Rate Contribution&apos;&#13;&#10;    WHEN 7 THEN &apos;Churn Take Rate Contribution&apos;&#13;&#10;    WHEN 8 THEN &apos;GMV Contribution&apos;&#13;&#10;    WHEN 9 THEN &apos;Existing Sell Rate Contribution&apos;&#13;&#10;    WHEN 10 THEN &apos;Existing Buy Rate Contribution&apos;&#13;&#10;    WHEN 11 THEN &apos;New sell Rate Contribution&apos;&#13;&#10;    WHEN 12 THEN &apos;New Buy Rate Contribution&apos;&#13;&#10;    WHEN 13 THEN &apos;Churn Sell Rate Contribution&apos;&#13;&#10;    WHEN 14 THEN &apos;Churn Buy Rate Contribution&apos;&#13;&#10;    WHEN 15 THEN &apos;Grand Total A&apos;&#13;&#10;    WHEN 16 THEN &apos;Grand Total B&apos;&#13;&#10;&#13;&#10;&#13;&#10;    &#13;&#10;END' />
