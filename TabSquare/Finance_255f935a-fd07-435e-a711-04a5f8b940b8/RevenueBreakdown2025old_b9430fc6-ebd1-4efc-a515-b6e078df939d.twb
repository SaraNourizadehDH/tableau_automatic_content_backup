      </column>
      <column caption='% Change in Net Revenue' datatype='real' name='[Calculation_1136033030916046863]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1088182285230284814] - [Calculation_1088182285229617163]) / [Calculation_1088182285229617163]&#13;&#10;&#13;&#10;&#13;&#10;//(SUM(IF [Month Year] = [Select Reporting Month] THEN [Net Revenue] END)-SUM(IF [Month Year] = [Previous Month] THEN [Net Revenue] END))/SUM(IF [Month Year] = [Previous Month] THEN [Net Revenue] END)&#13;&#10;&#13;&#10;&#13;&#10;//(SUM([Net Revenue]) - LOOKUP(SUM([Net Revenue]), -1)) / ABS(LOOKUP(SUM([Net Revenue]), -1))' />
      </column>
      <column caption='% Change in GMV' datatype='real' name='[Calculation_1136033030916128784]' role='measure' type='quantitative'>
