      </column>
      <column caption='% Change in Take Rate' datatype='real' name='[Calculation_1136033030916198417]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF [month_year] = [Parameters].[Parameter 1] THEN [% Take Rate] END)&#13;&#10;-&#13;&#10; SUM(IF [month_year] = [Calculation_1088182285221376005] THEN [% Take Rate] END))&#13;&#10;/&#13;&#10;SUM(IF [month_year] = [Calculation_1088182285221376005] THEN [% Take Rate] END)&#13;&#10;&#13;&#10;&#13;&#10;//(SUM([% Take Rate]) - LOOKUP(SUM([% Take Rate]), -1)) / ABS(LOOKUP(SUM([% Take Rate]), -1))' />
