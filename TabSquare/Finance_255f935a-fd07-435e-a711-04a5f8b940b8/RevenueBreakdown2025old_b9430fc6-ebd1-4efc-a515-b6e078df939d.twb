    <worksheet name='Sheet 7'>
      <table>
        <view>
          <datasources>
            <datasource caption='All Payment Data (Outlet Level View for Txn Revenue)' name='federated.0a5yrj21sqfcfc1anu6ni1a8npyd' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Reporting Month' datatype='date' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2025-05-01#'>
              <calculation class='tableau' formula='#2025-05-01#' />
            </column>
            <column caption='Waterfall Step Selector' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Existing GMV Contribution&quot;'>
              <calculation class='tableau' formula='&quot;Existing GMV Contribution&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0a5yrj21sqfcfc1anu6ni1a8npyd'>
            <column caption='Previous Month' datatype='datetime' name='[Calculation_1088182285221376005]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEADD(&apos;month&apos;, -1, [Parameters].[Parameter 1])' />
            </column>
            <column caption='Previous Net Revenue' datatype='real' name='[Calculation_1088182285229617163]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [month_year] = [Calculation_1088182285221376005] THEN [Net Revenue] END)' />
            </column>
            <column caption='Previous Take Rate' datatype='real' name='[Calculation_1088182285229711372]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1088182285229617163] / [Calculation_1136033031141445669]' />
            </column>
            <column caption='Previous Sell Rate' datatype='real' name='[Calculation_1088182285229899789]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [month_year] = [Calculation_1088182285221376005] THEN [total_commission_sgd] END)&#13;&#10;/ [Calculation_1136033031141445669]' />
            </column>
            <column caption='Current Net Revenue' datatype='real' name='[Calculation_1088182285230284814]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull(SUM(IF [month_year] = [Parameters].[Parameter 1] THEN [Net Revenue] END),0)' />
            </column>
            <column caption='Previous Buy Rate' datatype='real' name='[Calculation_1088182285230534671]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [month_year] = [Calculation_1088182285221376005] THEN [total_ts_cost_sgd] END)&#13;&#10;/ [Calculation_1136033031141445669]' />
            </column>
            <column caption='Churn GMV Contribution' datatype='real' name='[Calculation_1088182285240258578]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1136033030974210067] - [Calculation_1088182285240872983] - [Calculation_1136033030975168535]' />
            </column>
            <column caption='Churn Take Rate Contribution' datatype='real' name='[Calculation_1088182285240426515]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1136033030974353428] - [Calculation_1088182285240762390] - [Calculation_1136033030975250456]' />
            </column>
            <column caption='Churn Sell Rate Contribution' datatype='real' name='[Calculation_1088182285240496148]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-[Calculation_1136033030974636053] - [Calculation_1088182285240934424] - [Calculation_1136033030975352857]' />
            </column>
            <column caption='Churn Buy Rate Contribution' datatype='real' name='[Calculation_1088182285240582165]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-[Calculation_1136033030974820374] + [Calculation_1088182285241004057] - [Calculation_1136033030975500314]' />
            </column>
            <column caption='Existing Take Rate Contribution' datatype='real' name='[Calculation_1088182285240762390]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ifnull([Previous Existing Take Rate (copy)_1088182285345054764],0) - ifnull([Calculation_1088182285242331166],0)) * ifnull([Previous Existing GMV (copy)_1088182285244129313],0)&#13;&#10;&#13;&#10;&#13;&#10;//SUM(IF [Customer Type Flag] = &quot;Existing&quot; THEN [Total Sales Sgd] * ([Current Take Rate] - [Previous Take Rate]) END)' />
            </column>
            <column caption='Existing GMV Contribution' datatype='real' name='[Calculation_1088182285240872983]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1088182285242331166] * ([Previous Existing GMV (copy)_1088182285244129313] - [Calculation_1088182285242138652])&#13;&#10;&#13;&#10;&#13;&#10;//SUM(IF [Customer Type Flag] = &quot;Existing&quot; THEN [Current Take Rate] * [Total Sales Sgd] END)' />
            </column>
            <column caption='Existing Sell Rate Contribution' datatype='real' name='[Calculation_1088182285240934424]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1088182285241679898] - [Calculation_1088182285241745435]) * [Calculation_1136033030913875969]&#13;&#10;&#13;&#10;&#13;&#10;//SUM(IF [Customer Type Flag] = &quot;Existing&quot; THEN ([Previous Sell Rate] - [Current Sell Rate]) * [Total Sales Sgd] END)' />
            </column>
            <column caption='Existing Buy Rate Contribution' datatype='real' name='[Calculation_1088182285241004057]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1088182285242626079] - [Calculation_1088182285242691616]) * [Calculation_1136033030913875969]&#13;&#10;&#13;&#10;//SUM(IF [Customer Type Flag] = &quot;Existing&quot; THEN ([Current Buy Rate] - [Previous Buy Rate]) * [Total Sales Sgd] END)' />
            </column>
            <column caption='Current Existing Sell Rate' datatype='real' name='[Calculation_1088182285241679898]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_1136033031088832542] = &quot;Existing&quot; AND [month_year] = [Parameters].[Parameter 1] THEN [total_commission_sgd] END) &#13;&#10;/ [Calculation_1136033030913875969]' />
            </column>
            <column caption='Previous Existing Sell Rate' datatype='real' name='[Calculation_1088182285241745435]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF isnull([Calculation_1136033031088832542]) AND [month_year] = [Calculation_1088182285221376005] THEN [total_commission_sgd] END) &#13;&#10;/ [Calculation_1088182285242138652]' />
            </column>
            <column caption='Previous Existing GMV' datatype='real' name='[Calculation_1088182285242138652]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull(SUM(&#13;&#10;  IF ISNULL([Calculation_1136033031088832542])&#13;&#10;     AND [month_year] = [Calculation_1088182285221376005]&#13;&#10;  THEN [total_sales_sgd]&#13;&#10;END),0)' />
            </column>
            <column caption='Previous Existing Net Revenue' datatype='real' name='[Calculation_1088182285242228765]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull(SUM(&#13;&#10;  IF isnull([Calculation_1136033031088832542])&#13;&#10;     AND [month_year] = [Calculation_1088182285221376005]&#13;&#10;  THEN [Net Revenue]&#13;&#10;END),0)' />
            </column>
            <column caption='Previous Existing Take Rate' datatype='real' name='[Calculation_1088182285242331166]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1088182285242228765] / [Calculation_1088182285242138652]' />
            </column>
            <column caption='Current Existing Buy Rate' datatype='real' name='[Calculation_1088182285242626079]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_1136033031088832542] = &quot;Existing&quot; AND [month_year] = [Parameters].[Parameter 1] THEN [total_ts_cost_sgd] END) &#13;&#10;/ [Calculation_1136033030913875969]' />
            </column>
            <column caption='Previous Existing Buy Rate' datatype='real' name='[Calculation_1088182285242691616]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF isnull([Calculation_1136033031088832542]) AND [month_year] = [Calculation_1088182285221376005] &#13;&#10;THEN [total_ts_cost_sgd] END) &#13;&#10;/ [Calculation_1088182285242138652]' />
            </column>
            <column caption='Label' datatype='string' name='[Calculation_1088182285248987174]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Step Id]&#13;&#10;    WHEN 1 THEN &apos;Previous Net Revenue&apos;&#13;&#10;    WHEN 2 THEN &apos;Existing GMV Contribution&apos;&#13;&#10;    WHEN 3 THEN &apos;New GMV Contribution&apos;&#13;&#10;    WHEN 4 THEN &apos;Churn GMV Contribution&apos;&#13;&#10;    WHEN 5 THEN &apos;Existing Take Rate Contribution&apos;&#13;&#10;    WHEN 6 THEN &apos;New Take Rate Contribution&apos;&#13;&#10;    WHEN 7 THEN &apos;Churn Take Rate Contribution&apos;&#13;&#10;    WHEN 8 THEN &apos;GMV Contribution&apos;&#13;&#10;    WHEN 9 THEN &apos;Existing Sell Rate Contribution&apos;&#13;&#10;    WHEN 10 THEN &apos;Existing Buy Rate Contribution&apos;&#13;&#10;    WHEN 11 THEN &apos;New sell Rate Contribution&apos;&#13;&#10;    WHEN 12 THEN &apos;New Buy Rate Contribution&apos;&#13;&#10;    WHEN 13 THEN &apos;Churn Sell Rate Contribution&apos;&#13;&#10;    WHEN 14 THEN &apos;Churn Buy Rate Contribution&apos;&#13;&#10;    WHEN 15 THEN &apos;Grand Total A&apos;&#13;&#10;    WHEN 16 THEN &apos;Grand Total B&apos;&#13;&#10;&#13;&#10;&#13;&#10;    &#13;&#10;END' />
            </column>
            <column caption='Start' datatype='real' name='[Calculation_1088182285253357609]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE min([Step Id])&#13;&#10;WHEN 1 THEN [Calculation_1088182285229617163]&#13;&#10;WHEN 2 THEN [Calculation_1088182285240872983]&#13;&#10;WHEN 3 THEN [Calculation_1136033030975168535]&#13;&#10;WHEN 4 THEN [Calculation_1088182285240258578]&#13;&#10;WHEN 5 THEN [Calculation_1088182285240762390]&#13;&#10;WHEN 6 THEN [Calculation_1136033030975250456]&#13;&#10;WHEN 7 THEN [Calculation_1088182285240426515]&#13;&#10;WHEN 8 THEN [Calculation_1136033030974210067]&#13;&#10;WHEN 9 THEN [Calculation_1088182285240934424]&#13;&#10;WHEN 10 THEN [Calculation_1088182285241004057]&#13;&#10;WHEN 11 THEN [Calculation_1136033030975352857]&#13;&#10;WHEN 12 THEN [Calculation_1136033030975500314]&#13;&#10;WHEN 13 THEN [Calculation_1088182285240496148]&#13;&#10;WHEN 14 THEN [Calculation_1088182285240582165]&#13;&#10;WHEN 15 THEN [Calculation_1088182285229617163]&#13;&#10;+ [Calculation_1088182285240872983]&#13;&#10;+ [Calculation_1136033030975168535]&#13;&#10;+ [Calculation_1088182285240258578]&#13;&#10;+[Calculation_1088182285240762390]&#13;&#10;+ [Calculation_1136033030975250456]&#13;&#10;+[Calculation_1088182285240426515]&#13;&#10;WHEN 16 THEN [Calculation_1088182285229617163]&#13;&#10;+[Calculation_1136033030974210067]&#13;&#10;+[Calculation_1088182285240934424]&#13;&#10;+[Calculation_1088182285241004057]&#13;&#10;+[Calculation_1136033030975352857]&#13;&#10;+[Calculation_1136033030975500314]&#13;&#10;+[Calculation_1088182285240496148]&#13;&#10;+[Calculation_1088182285240582165]&#13;&#10;END' />
            </column>
            <column caption='Neg' datatype='real' name='[Calculation_1088182285256630314]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-[Calculation_1088182285253357609]' />
            </column>
            <column caption='Existing GMV' datatype='real' name='[Calculation_1136033030913875969]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull(SUM(IF [Calculation_1136033031088832542] = &quot;Existing&quot; THEN [total_sales_sgd] END),0)' />
            </column>
            <column caption='New Net Revenue' datatype='real' name='[Calculation_1136033030914633733]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_1136033031088832542] = &quot;New&quot; THEN [Net Revenue] END)&#13;&#10;//SUM(IF [New Flag] = 1 THEN [Net Revenue] END)' />
            </column>
            <column caption='New GMV' datatype='real' name='[Calculation_1136033030914723846]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull(SUM(IF [Calculation_1136033031088832542] = &quot;New&quot; THEN [total_sales_sgd] END),0)' />
            </column>
            <column caption='New Take Rate' datatype='real' name='[Calculation_1136033030914781191]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1136033030914633733] / [Calculation_1136033030914723846]' />
            </column>
            <column caption='New Sell Rate' datatype='real' name='[Calculation_1136033030914846728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_1136033031088832542] = &quot;New&quot; THEN [total_commission_sgd] END) / [Calculation_1136033030914723846]&#13;&#10;&#13;&#10;//SUM(IF [New Flag] = 1 THEN [Ts Commmission] END) / [New GMV]' />
            </column>
            <column caption='Churn GMV' datatype='real' name='[Calculation_1136033030915084299]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_1136033031088832542] = &quot;Churn&quot; &#13;&#10;and [Calculation_1136033031090552864]=1 &#13;&#10;and [month_year] = DATEADD(&apos;month&apos;, -1, [Parameters].[Parameter 1])&#13;&#10;THEN [total_sales_sgd] END)&#13;&#10;&#13;&#10;//SUM(IF [Churn Flag] = 1 THEN [Total Sales] END)' />
            </column>
            <column caption='GMV Contribution' datatype='real' name='[Calculation_1136033030974210067]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1088182285229711372] * ([Calculation_1136033031141310500] - [Calculation_1136033031141445669])&#13;&#10;&#13;&#10;&#13;&#10;//sum([% Take Rate]) * (SUM([Total Sales Sgd]) - LOOKUP(SUM([Total Sales Sgd]), -1))' />
            </column>
            <column caption='Take Rate Contribution' datatype='real' name='[Calculation_1136033030974353428]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1136033031141310500] * ([Current GMV (copy)_1088182285225889800] - [Calculation_1088182285229711372])&#13;&#10;&#13;&#10;//SUM([Total Sales]) * (sum([% Take Rate]) - LOOKUP(sum([% Take Rate]), -1))' />
            </column>
            <column caption='Sell Rate Contribution' datatype='real' name='[Calculation_1136033030974636053]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1088182285229899789] - [Current GMV (copy) (copy)_1088182285226024970]) * [Calculation_1136033031141310500]&#13;&#10;&#13;&#10;&#13;&#10;//(LOOKUP(sum([% Sell Rate]), -1) - sum([% Sell Rate])) * SUM([Total Sales])' />
            </column>
            <column caption='Buy Rate Contribution' datatype='real' name='[Calculation_1136033030974820374]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Current GMV (copy)_1088182285226012681] - [Calculation_1088182285230534671]) * [Calculation_1136033031141310500]&#13;&#10;&#13;&#10;//(sum([% Buy Rate]) - LOOKUP(sum([% Buy Rate]), -1)) * SUM([Total Sales])' />
            </column>
            <column caption='New GMV Contribution' datatype='real' name='[Calculation_1136033030975168535]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Calculation_1136033030914723846] + [Calculation_1136033030915084299]) &gt; 0 THEN&#13;&#10;    ([Calculation_1136033030974210067] - [Calculation_1088182285240872983]) * (([Calculation_1136033030914723846]) / ([Calculation_1136033030914723846] - [Calculation_1136033030915084299]))&#13;&#10;END&#13;&#10;&#13;&#10;//(sum([GMV Contribution]) - [Existing GMV]) * ([New GMV] / ([New GMV] - [Churn GMV]))' />
            </column>
            <column caption='New Take Rate Contribution' datatype='real' name='[Calculation_1136033030975250456]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='- ([Current GMV (copy)_1088182285225889800] - [Calculation_1136033030914781191]) * [Calculation_1136033030914723846]' />
            </column>
            <column caption='New Sell Rate Contribution' datatype='real' name='[Calculation_1136033030975352857]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1136033030914846728] - [Calculation_1088182285229899789]) * [Calculation_1136033030914723846]&#13;&#10;&#13;&#10;//([New Sell Rate] - LOOKUP(sum([% Sell Rate]), -1)) * [New GMV]' />
            </column>
            <column caption='New Buy Rate Contribution' datatype='real' name='[Calculation_1136033030975500314]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1136033030975250456]-[Calculation_1136033030975352857]' />
            </column>
            <column caption='Customer Type Flag' datatype='string' name='[Calculation_1136033031088832542]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [month_year] = [Parameters].[Parameter 1] AND [Calculation_1136033031090552864] = 1 THEN &quot;Existing&quot;&#13;&#10;ELSEIF [month_year] = [Parameters].[Parameter 1] AND (isnull([Calculation_1136033031090552864]) or [Calculation_1136033031090552864]=0) THEN &quot;New&quot;&#13;&#10;ELSEIF [month_year] = [Calculation_1088182285221376005]&#13;&#10;     AND ([Calculation_1136033031090421791]=0 or [Calculation_1136033031131586595] &lt; [Parameters].[Parameter 1]) THEN &quot;Churn&quot;&#13;&#10;&#13;&#10;&#13;&#10;//ELSEIF [Month Year] = DATEADD(&apos;month&apos;, -1, [Select Reporting Month]) AND [Has Current Month] = 0 THEN &quot;Churn&quot;&#13;&#10;//ELSEIF [Month Year] = [previous month] AND [Has Current Month] = 0 or NULL THEN &quot;Churn&quot;&#13;&#10;END&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;//IF [Month Year] = [current month] AND { FIXED [Merchant Key] : COUNTD(IF [Month Year] = [previous month] THEN [Merchant Key] END) } &gt; 0 THEN &quot;Existing&quot;&#13;&#10;&#13;&#10;//ELSEIF [Month Year] = [current month] AND { FIXED [Merchant Key] : COUNTD(IF [Month Year] = [previous month] THEN [Merchant Key] END) } = 0 THEN &quot;New&quot;&#13;&#10;&#13;&#10;//ELSEIF [Month Year] = [previous month] AND  { FIXED [Merchant Key] : COUNTD(IF [Month Year] = [current month] THEN [Merchant Key] END) } = 0 THEN &quot;Churn&quot; END' />
            </column>
            <column caption='Has Current Month' datatype='integer' name='[Calculation_1136033031090421791]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Merchant Key] : MAX(IF [month_year] = [Parameters].[Parameter 1] THEN 1 ELSE 0 END) }' />
            </column>
            <column caption='Has Previous Month' datatype='integer' name='[Calculation_1136033031090552864]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Merchant Key] : MAX(IF [month_year] = DATEADD(&apos;month&apos;, -1, [Parameters].[Parameter 1]) THEN 1 ELSE 0 END) }&#13;&#10;//[previous month]' />
            </column>
            <column caption='Max Active Month' datatype='date' name='[Calculation_1136033031131586595]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [Merchant Key] : MAX([month_year]) }' />
            </column>
            <column caption='Current GMV' datatype='real' name='[Calculation_1136033031141310500]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [month_year] = [Parameters].[Parameter 1] THEN [total_sales_sgd] END)' />
            </column>
            <column caption='Previous GMV' datatype='real' name='[Calculation_1136033031141445669]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull(sum(IF [month_year] = [Calculation_1088182285221376005] THEN [total_sales_sgd] END),0)' />
            </column>
            <column caption='Color' datatype='string' name='[Calculation_1523342600401018884]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1088182285253357609] &gt; 0 THEN &quot;Blue&quot;&#13;&#10;ELSE &quot;Red&quot;&#13;&#10;END' />
            </column>
            <column caption='Current Sell Rate' datatype='real' name='[Current GMV (copy) (copy)_1088182285226024970]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [month_year] = [Parameters].[Parameter 1] THEN [total_commission_sgd] END)/ [Calculation_1136033031141310500]' />
            </column>
            <column caption='Current Take Rate' datatype='real' name='[Current GMV (copy)_1088182285225889800]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1088182285230284814] / [Calculation_1136033031141310500]' />
            </column>
            <column caption='Current Buy Rate' datatype='real' name='[Current GMV (copy)_1088182285226012681]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [month_year] = [Parameters].[Parameter 1] THEN [total_ts_cost_sgd] END)&#13;&#10;/ [Calculation_1136033031141310500]' />
