            </column>
            <column caption='Customer Type Flag' datatype='string' name='[Calculation_1136033031088832542]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [month_year] = [Parameters].[Parameter 1] AND [Calculation_1136033031090552864] = 1 THEN &quot;Existing&quot;&#13;&#10;ELSEIF [month_year] = [Parameters].[Parameter 1] AND (isnull([Calculation_1136033031090552864]) or [Calculation_1136033031090552864]=0) THEN &quot;New&quot;&#13;&#10;ELSEIF [month_year] = [Calculation_1088182285221376005]&#13;&#10;     AND ([Calculation_1136033031090421791]=0 or [Calculation_1136033031131586595] &lt; [Parameters].[Parameter 1]) THEN &quot;Churn&quot;&#13;&#10;&#13;&#10;&#13;&#10;//ELSEIF [Month Year] = DATEADD(&apos;month&apos;, -1, [Select Reporting Month]) AND [Has Current Month] = 0 THEN &quot;Churn&quot;&#13;&#10;//ELSEIF [Month Year] = [previous month] AND [Has Current Month] = 0 or NULL THEN &quot;Churn&quot;&#13;&#10;END&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;//IF [Month Year] = [current month] AND { FIXED [Merchant Key] : COUNTD(IF [Month Year] = [previous month] THEN [Merchant Key] END) } &gt; 0 THEN &quot;Existing&quot;&#13;&#10;&#13;&#10;//ELSEIF [Month Year] = [current month] AND { FIXED [Merchant Key] : COUNTD(IF [Month Year] = [previous month] THEN [Merchant Key] END) } = 0 THEN &quot;New&quot;&#13;&#10;&#13;&#10;//ELSEIF [Month Year] = [previous month] AND  { FIXED [Merchant Key] : COUNTD(IF [Month Year] = [current month] THEN [Merchant Key] END) } = 0 THEN &quot;Churn&quot; END' />
            </column>
            <column caption='Has Current Month' datatype='integer' name='[Calculation_1136033031090421791]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Merchant Key] : MAX(IF [month_year] = [Parameters].[Parameter 1] THEN 1 ELSE 0 END) }' />
            </column>
            <column caption='Has Previous Month' datatype='integer' name='[Calculation_1136033031090552864]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Merchant Key] : MAX(IF [month_year] = DATEADD(&apos;month&apos;, -1, [Parameters].[Parameter 1]) THEN 1 ELSE 0 END) }&#13;&#10;//[previous month]' />
            </column>
            <column caption='Max Active Month' datatype='date' name='[Calculation_1136033031131586595]' role='dimension' type='ordinal'>
