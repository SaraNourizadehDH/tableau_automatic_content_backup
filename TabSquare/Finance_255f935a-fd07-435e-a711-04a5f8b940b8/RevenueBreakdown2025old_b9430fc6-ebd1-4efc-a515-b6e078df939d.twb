    <worksheet name='Sheet 11 (8)'>
      <table>
        <view>
          <datasources>
            <datasource caption='All Payment Data (Outlet Level View for Txn Revenue)' name='federated.0a5yrj21sqfcfc1anu6ni1a8npyd' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Reporting Month' datatype='date' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2025-05-01#'>
              <calculation class='tableau' formula='#2025-05-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0a5yrj21sqfcfc1anu6ni1a8npyd'>
            <column caption='Previous Month' datatype='datetime' name='[Calculation_1088182285221376005]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEADD(&apos;month&apos;, -1, [Parameters].[Parameter 1])' />
            </column>
            <column caption='Previous Net Revenue' datatype='real' name='[Calculation_1088182285229617163]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [month_year] = [Calculation_1088182285221376005] THEN [Net Revenue] END)' />
            </column>
            <column caption='Previous Take Rate' datatype='real' name='[Calculation_1088182285229711372]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1088182285229617163] / [Calculation_1136033031141445669]' />
            </column>
            <column caption='Existing GMV Contribution' datatype='real' name='[Calculation_1088182285240872983]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1088182285242331166] * ([Previous Existing GMV (copy)_1088182285244129313] - [Calculation_1088182285242138652])&#13;&#10;&#13;&#10;&#13;&#10;//SUM(IF [Customer Type Flag] = &quot;Existing&quot; THEN [Current Take Rate] * [Total Sales Sgd] END)' />
            </column>
            <column caption='Previous Existing GMV' datatype='real' name='[Calculation_1088182285242138652]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull(SUM(&#13;&#10;  IF ISNULL([Calculation_1136033031088832542])&#13;&#10;     AND [month_year] = [Calculation_1088182285221376005]&#13;&#10;  THEN [total_sales_sgd]&#13;&#10;END),0)' />
            </column>
            <column caption='Previous Existing Net Revenue' datatype='real' name='[Calculation_1088182285242228765]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull(SUM(&#13;&#10;  IF isnull([Calculation_1136033031088832542])&#13;&#10;     AND [month_year] = [Calculation_1088182285221376005]&#13;&#10;  THEN [Net Revenue]&#13;&#10;END),0)' />
            </column>
            <column caption='Previous Existing Take Rate' datatype='real' name='[Calculation_1088182285242331166]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1088182285242228765] / [Calculation_1088182285242138652]' />
            </column>
            <column caption='New GMV' datatype='real' name='[Calculation_1136033030914723846]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull(SUM(IF [Calculation_1136033031088832542] = &quot;New&quot; THEN [total_sales_sgd] END),0)' />
            </column>
            <column caption='Churn GMV' datatype='real' name='[Calculation_1136033030915084299]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_1136033031088832542] = &quot;Churn&quot; &#13;&#10;and [Calculation_1136033031090552864]=1 &#13;&#10;and [month_year] = DATEADD(&apos;month&apos;, -1, [Parameters].[Parameter 1])&#13;&#10;THEN [total_sales_sgd] END)&#13;&#10;&#13;&#10;//SUM(IF [Churn Flag] = 1 THEN [Total Sales] END)' />
            </column>
            <column caption='GMV Contribution' datatype='real' name='[Calculation_1136033030974210067]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1088182285229711372] * ([Calculation_1136033031141310500] - [Calculation_1136033031141445669])&#13;&#10;&#13;&#10;&#13;&#10;//sum([% Take Rate]) * (SUM([Total Sales Sgd]) - LOOKUP(SUM([Total Sales Sgd]), -1))' />
            </column>
            <column caption='New GMV Contribution' datatype='real' name='[Calculation_1136033030975168535]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Calculation_1136033030914723846] + [Calculation_1136033030915084299]) &gt; 0 THEN&#13;&#10;    ([Calculation_1136033030974210067] - [Calculation_1088182285240872983]) * (([Calculation_1136033030914723846]) / ([Calculation_1136033030914723846] - [Calculation_1136033030915084299]))&#13;&#10;END&#13;&#10;&#13;&#10;//(sum([GMV Contribution]) - [Existing GMV]) * ([New GMV] / ([New GMV] - [Churn GMV]))' />
            </column>
            <column caption='Customer Type Flag' datatype='string' name='[Calculation_1136033031088832542]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [month_year] = [Parameters].[Parameter 1] AND [Calculation_1136033031090552864] = 1 THEN &quot;Existing&quot;&#13;&#10;ELSEIF [month_year] = [Parameters].[Parameter 1] AND (isnull([Calculation_1136033031090552864]) or [Calculation_1136033031090552864]=0) THEN &quot;New&quot;&#13;&#10;ELSEIF [month_year] = [Calculation_1088182285221376005]&#13;&#10;     AND ([Calculation_1136033031090421791]=0 or [Calculation_1136033031131586595] &lt; [Parameters].[Parameter 1]) THEN &quot;Churn&quot;&#13;&#10;&#13;&#10;&#13;&#10;//ELSEIF [Month Year] = DATEADD(&apos;month&apos;, -1, [Select Reporting Month]) AND [Has Current Month] = 0 THEN &quot;Churn&quot;&#13;&#10;//ELSEIF [Month Year] = [previous month] AND [Has Current Month] = 0 or NULL THEN &quot;Churn&quot;&#13;&#10;END&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;//IF [Month Year] = [current month] AND { FIXED [Merchant Key] : COUNTD(IF [Month Year] = [previous month] THEN [Merchant Key] END) } &gt; 0 THEN &quot;Existing&quot;&#13;&#10;&#13;&#10;//ELSEIF [Month Year] = [current month] AND { FIXED [Merchant Key] : COUNTD(IF [Month Year] = [previous month] THEN [Merchant Key] END) } = 0 THEN &quot;New&quot;&#13;&#10;&#13;&#10;//ELSEIF [Month Year] = [previous month] AND  { FIXED [Merchant Key] : COUNTD(IF [Month Year] = [current month] THEN [Merchant Key] END) } = 0 THEN &quot;Churn&quot; END' />
            </column>
            <column caption='Has Current Month' datatype='integer' name='[Calculation_1136033031090421791]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Merchant Key] : MAX(IF [month_year] = [Parameters].[Parameter 1] THEN 1 ELSE 0 END) }' />
            </column>
            <column caption='Has Previous Month' datatype='integer' name='[Calculation_1136033031090552864]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Merchant Key] : MAX(IF [month_year] = DATEADD(&apos;month&apos;, -1, [Parameters].[Parameter 1]) THEN 1 ELSE 0 END) }&#13;&#10;//[previous month]' />
            </column>
            <column caption='Current Month' datatype='date' name='[Calculation_1136033031101304865]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Merchant Key] : MAX(IF [Calculation_1136033031101714466] THEN [month_year] END) }' />
            </column>
            <column caption='Month to Include' datatype='boolean' name='[Calculation_1136033031101714466]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[month_year] = [Parameters].[Parameter 1]&#13;&#10;//OR[Month Year] = DATEADD(&apos;month&apos;, -1, [Select Reporting Month])' />
            </column>
            <column caption='Max Active Month' datatype='date' name='[Calculation_1136033031131586595]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [Merchant Key] : MAX([month_year]) }' />
            </column>
            <column caption='Current GMV' datatype='real' name='[Calculation_1136033031141310500]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [month_year] = [Parameters].[Parameter 1] THEN [total_sales_sgd] END)' />
            </column>
            <column caption='Previous GMV' datatype='real' name='[Calculation_1136033031141445669]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull(sum(IF [month_year] = [Calculation_1088182285221376005] THEN [total_sales_sgd] END),0)' />
            </column>
            <column datatype='string' name='[Merchant Key]' role='dimension' type='nominal' />
            <column datatype='real' name='[Net Revenue]' role='measure' type='quantitative' />
            <column caption='Current Existing GMV' datatype='real' name='[Previous Existing GMV (copy)_1088182285244129313]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull(SUM(&#13;&#10;  IF [Calculation_1136033031088832542]=&apos;Existing&apos;&#13;&#10;     AND [month_year] = [Parameters].[Parameter 1]&#13;&#10; THEN [total_sales_sgd]&#13;&#10;END),0)&#13;&#10;&#13;&#10;//[Select Reporting Month]' />
            </column>
            <column caption='Month Year' datatype='date' name='[month_year]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1136033031088832542]' derivation='None' name='[none:Calculation_1136033031088832542:nk]' pivot='key' type='nominal' />
            <column-instance column='[Merchant Key]' derivation='None' name='[none:Merchant Key:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1136033031101304865]' derivation='Month-Trunc' name='[tmn:Calculation_1136033031101304865:ok]' pivot='key' type='ordinal' />
            <column-instance column='[month_year]' derivation='Month-Trunc' name='[tmn:month_year:ok]' pivot='key' type='ordinal' />
            <column caption='Total Sales Sgd' datatype='real' name='[total_sales_sgd]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1088182285240872983]' derivation='User' name='[usr:Calculation_1088182285240872983:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_1136033030914723846]' derivation='User' name='[usr:Calculation_1136033030914723846:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_1136033030915084299]' derivation='User' name='[usr:Calculation_1136033030915084299:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_1136033030974210067]' derivation='User' name='[usr:Calculation_1136033030974210067:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_1136033030975168535]' derivation='User' name='[usr:Calculation_1136033030975168535:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0a5yrj21sqfcfc1anu6ni1a8npyd].[none:Merchant Key:nk]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:Merchant Key:nk]' member='&quot;HQ-10025-10026&quot;' />
              <groupfilter function='member' level='[none:Merchant Key:nk]' member='&quot;HQ-12798-12799&quot;' />
              <groupfilter function='member' level='[none:Merchant Key:nk]' member='&quot;HQ-14582-16557&quot;' />
              <groupfilter function='member' level='[none:Merchant Key:nk]' member='&quot;HQ-16878-16882&quot;' />
              <groupfilter function='member' level='[none:Merchant Key:nk]' member='&quot;HQ-5530-5531&quot;' />
            </groupfilter>
          </filter>
