            </column>
            <column caption='% Diff GMV' datatype='string' name='[Calculation_2205356507515133954]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_2205356507515355139] *100 &lt;=0 and [Calculation_2205356507515355139]*100 &gt;=-10 then &apos;0-10% Drop&apos;&#13;&#10;ELSEIF [Calculation_2205356507515355139]*100 &gt;=-20 and [Calculation_2205356507515355139]*100 &lt;-10 then &apos;10-20% Drop&apos;&#13;&#10;ELSEIF [Calculation_2205356507515355139]*100 &lt;-20 then &apos;&gt; 20% Drop&apos;&#13;&#10;ELSEIF [Calculation_2205356507515355139]*100 &gt;0 and [Calculation_2205356507515355139]*100 &lt;=10 then &apos;0-10% Inc&apos;&#13;&#10;ELSEIF [Calculation_2205356507515355139]*100 &gt;10 and [Calculation_2205356507515355139]*100 &lt;=20 then &apos;10-20% Inc&apos;&#13;&#10;ELSEIF [Calculation_2205356507515355139]*100 &gt;20 then &apos;&gt; 20% Inc&apos;&#13;&#10;end' />
            </column>
            <column caption='% Diff in GMV from Prev.' datatype='real' name='[Calculation_2205356507515355139]' role='measure' type='quantitative'>
