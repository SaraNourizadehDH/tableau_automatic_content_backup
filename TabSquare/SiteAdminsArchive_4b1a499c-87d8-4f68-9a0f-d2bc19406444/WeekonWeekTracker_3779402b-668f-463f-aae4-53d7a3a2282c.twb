              <calculation class='tableau' formula='(zn([Calculation_3886887957090897928])-zn([Calculation_1639873218765840385]))/zn([Calculation_1639873218765840385])&#13;&#10;&#13;&#10;/*(ZN(SUM([sales])) - LOOKUP(ZN(SUM([sales])), -1)) / ABS(LOOKUP(ZN(SUM([sales])), -1))*/'>
