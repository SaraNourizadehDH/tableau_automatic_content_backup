            </column>
            <column caption='Date (sgt_datetime)' datatype='date' name='[Calculation_691513652405370884]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='date([sgt_datetime])' />
            </column>
            <column caption='Logic Level For You Accepted Order count (merchant_id, date, customer_type, repeat types) ' datatype='integer' name='[For You Accepted Order count (merchant_id, date, customer_type, repeat types) (copy)_1164743454870630400]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [merchant_id], [Calculation_691513652405370884], [customer_type], [global_repeat_type], [repeat_type], [Calculation_1415537658320863234]:&#10;countd(if [Calculation_691513652404211713]&gt;0 then [order_id_mod] end)}' />
            </column>
            <column caption='Logic Level For you Acceptance Rate ' datatype='real' name='[For you Acceptance Rate (copy)_2749447623037214720]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='sum(ifnull([For You Accepted Order count (merchant_id, date, customer_type, repeat types) (copy)_1164743454870630400],0))&#10;/&#10;sum([Total Sales (merchant_id, date) (copy)_691513652414963724])' />
