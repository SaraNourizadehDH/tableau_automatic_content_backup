            </column>
            <column caption='For You Accepted Order count (merchant_id, date, customer_type, repeat types)' datatype='integer' name='[Calculation_691513652405432325]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [merchant_id], [Calculation_691513652405370884], [customer_type], [global_repeat_type], [repeat_type]:&#10;countd(if [Calculation_691513652404211713]&gt;0 then [order_id_mod] end)}' />
            </column>
            <column caption='For You Acceptance Rate Change (merchant id, selected time period) ' datatype='real' name='[For You Acceptance Rate (merchant id, selected time period) (copy)_3467701410388873218]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;sum([Calculation_2493797990548086786]) &#10;-&#10;lookup(sum([Calculation_2493797990548086786]),-1)&#10;)&#10;/&#10;lookup(sum([Calculation_2493797990548086786]),-1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='For You Acceptance Rate Change buckets (merchant id)' datatype='string' name='[For You Acceptance Rate buckets (merchant id) (copy)_3467701410389483523]' role='measure' type='nominal'>
              <calculation class='tableau' formula='//if [For You Acceptance Rate Change (merchant id, selected time period) ]&lt;=-0.5 then &quot;&gt; 50% Decrease&quot;&#10;//elseif [For You Acceptance Rate Change (merchant id, selected time period) ]&lt;=-0.3 then &quot;&gt; 30% Decrease&quot;&#10;//elseif [For You Acceptance Rate Change (merchant id, selected time period) ]&lt;=-0.1 then &quot;&gt; 10% Decrease&quot;&#10;//elseif [For You Acceptance Rate Change (merchant id, selected time period) ]&lt;=0 then &quot;0-10% Decrease&quot;&#10;//elseif [For You Acceptance Rate Change (merchant id, selected time period) ]&gt;=0.5 then &quot;&gt; 50% Increase&quot;&#10;//elseif [For You Acceptance Rate Change (merchant id, selected time period) ]&gt;=0.3 then &quot;&gt; 30% Increase&quot;&#10;//elseif [For You Acceptance Rate Change (merchant id, selected time period) ]&gt;=0.1 then &quot;&gt; 10% Increase&quot;&#10;//elseif [For You Acceptance Rate Change (merchant id, selected time period) ]&gt;0 then &quot;0-10% Increase&quot;&#10;//end&#10;if [For You Acceptance Rate (merchant id, selected time period) (copy)_3467701410388873218]&lt;=0 then &quot;Decreasing&quot;&#10;elseif [For You Acceptance Rate (merchant id, selected time period) (copy)_3467701410388873218]&gt;0 then &quot;Increasing&quot;&#10;end'>
                <table-calc ordering-type='Rows' />
