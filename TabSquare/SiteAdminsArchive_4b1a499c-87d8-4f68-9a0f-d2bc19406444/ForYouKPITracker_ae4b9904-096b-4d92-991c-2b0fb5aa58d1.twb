            <column caption='logic level ' datatype='string' name='[Calculation_1415537658320863234]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//{fixed [Merchant Id], [Date (sgt_datetime)], [Customer Type],&#13;&#10;//[Global Repeat Type], [Repeat Type],[Menu Mode]:&#13;&#10;//countd(if [For you Reco accepted flag (order_id) ]&gt;0 &#13;&#10;         //and [For you Reorder accepted flag (order_id) ]&gt;0&#13;&#10;          //and [For you Promo accepted flag (order_id) ]&gt;0 then [Order Id Mod] end)}&#13;&#10;&#13;&#10;if [Calculation_1415537658322509827]&gt;0 &#13;&#10;          and [Calculation_1415537658322825220]&gt;0&#13;&#10;          and [Calculation_1415537658323038214]&gt;0 &#13;&#10;          and [Calculation_691513652404211713]&gt;0&#13;&#10;          and [Calculation_1415537658337906707]&gt;0&#13;&#10;then &apos;OverAll&apos;&#13;&#10;ELSEIF [Calculation_1415537658322509827]&gt;0 &#13;&#10;          and [Calculation_1415537658322825220]&gt;0&#13;&#10;          and [Calculation_1415537658323038214]&lt;=0 &#13;&#10;          and [Calculation_691513652404211713]&gt;0&#13;&#10;          and [Calculation_1415537658337906707]&lt;=0&#13;&#10;then &apos;Reco &amp; Reorder&apos;&#13;&#10;ELSEIF [Calculation_1415537658322509827]&gt;0 &#13;&#10;          and [Calculation_1415537658322825220]&lt;=0&#13;&#10;          and [Calculation_1415537658323038214]&gt;0 &#13;&#10;          and [Calculation_691513652404211713]&gt;0&#13;&#10;          and [Calculation_1415537658337906707]&lt;=0&#13;&#10;then &apos;Reco &amp; Promo&apos;&#13;&#10;ELSEIF [Calculation_1415537658322509827]&lt;=0 &#13;&#10;          and [Calculation_1415537658322825220]&gt;0&#13;&#10;          and [Calculation_1415537658323038214]&gt;0 &#13;&#10;          and [Calculation_691513652404211713]&gt;0&#13;&#10;          and [Calculation_1415537658337906707]&lt;=0&#13;&#10;then &apos;Reorder &amp; Promo&apos;&#13;&#10;ELSEIF [Calculation_1415537658322509827]&gt;0 &#13;&#10;          and [Calculation_1415537658322825220]&lt;=0&#13;&#10;          and [Calculation_1415537658323038214]&lt;=0 &#13;&#10;          and [Calculation_691513652404211713]&gt;0&#13;&#10;          OR  [Calculation_1415537658337906707]&gt;0&#13;&#10;then &apos;Only Reco&apos;&#13;&#10;ELSEIF [Calculation_1415537658322509827]&lt;=0 &#13;&#10;          and [Calculation_1415537658322825220]&gt;0&#13;&#10;          and [Calculation_1415537658323038214]&lt;=0 &#13;&#10;          and [Calculation_691513652404211713]&gt;0&#13;&#10;          and [Calculation_1415537658337906707]&lt;=0&#13;&#10;then &apos;Only Reorder&apos;&#13;&#10;ELSEIF [Calculation_1415537658322509827]&lt;=0 &#13;&#10;          and [Calculation_1415537658322825220]&lt;=0&#13;&#10;          and [Calculation_1415537658323038214]&gt;0 &#13;&#10;          and [Calculation_691513652404211713]&gt;0&#13;&#10;          and [Calculation_1415537658337906707]&lt;=0&#13;&#10;then &apos;Only Promo&apos;&#13;&#10;ELSEIF [Calculation_1415537658322509827]&lt;=0 &#13;&#10;          and [Calculation_1415537658322825220]&lt;=0&#13;&#10;          and [Calculation_1415537658323038214]&lt;=0 &#13;&#10;          and [Calculation_691513652404211713]&lt;=0&#13;&#10;          and [Calculation_1415537658337906707]&lt;=0&#13;&#10;then &apos;No AI&apos;&#13;&#10;END&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;/*if [For you Reco accepted flag (order_id)]&gt;0 &#13;&#10;          and [For you Reorder accepted flag (order_id)]&gt;0&#13;&#10;          and [For you Promo accepted flag (order_id)]&gt;0 &#13;&#10;          and [For you accepted flag (order_id)]&gt;0&#13;&#10;          &#13;&#10;then &apos;OverAll&apos;&#13;&#10;ELSEIF [For you Reco accepted flag (order_id)]&gt;0 &#13;&#10;          and [For you Reorder accepted flag (order_id)]&gt;0&#13;&#10;          and [For you Promo accepted flag (order_id)]&lt;=0 &#13;&#10;          and [For you accepted flag (order_id)]&gt;0&#13;&#10;          &#13;&#10;then &apos;Reco &amp; Reorder&apos;&#13;&#10;ELSEIF [For you Reco accepted flag (order_id)]&gt;0 &#13;&#10;          and [For you Reorder accepted flag (order_id)]&lt;=0&#13;&#10;          and [For you Promo accepted flag (order_id)]&gt;0 &#13;&#10;          and [For you accepted flag (order_id)]&gt;0&#13;&#10;          and [Top Trending Accepted flag (order_id)]&lt;=0&#13;&#10;then &apos;Reco &amp; Promo&apos;&#13;&#10;ELSEIF [For you Reco accepted flag (order_id)]&lt;=0 &#13;&#10;          and [For you Reorder accepted flag (order_id)]&gt;0&#13;&#10;          and [For you Promo accepted flag (order_id)]&gt;0 &#13;&#10;          and [For you accepted flag (order_id)]&gt;0&#13;&#10;          &#13;&#10;then &apos;Reorder &amp; Promo&apos;&#13;&#10;ELSEIF [For you Reco accepted flag (order_id)]&gt;0 &#13;&#10;          and [For you Reorder accepted flag (order_id)]&lt;=0&#13;&#10;          and [For you Promo accepted flag (order_id)]&lt;=0 &#13;&#10;          and [For you accepted flag (order_id)]&gt;0&#13;&#10;          &#13;&#10;then &apos;Only Reco&apos;&#13;&#10;ELSEIF [For you Reco accepted flag (order_id)]&lt;=0 &#13;&#10;          and [For you Reorder accepted flag (order_id)]&gt;0&#13;&#10;          and [For you Promo accepted flag (order_id)]&lt;=0 &#13;&#10;          and [For you accepted flag (order_id)]&gt;0&#13;&#10;          &#13;&#10;then &apos;Only Reorder&apos;&#13;&#10;ELSEIF [For you Reco accepted flag (order_id)]&lt;=0 &#13;&#10;          and [For you Reorder accepted flag (order_id)]&lt;=0&#13;&#10;          and [For you Promo accepted flag (order_id)]&gt;0 &#13;&#10;          and [For you accepted flag (order_id)]&gt;0&#13;&#10;          &#13;&#10;then &apos;Only Promo&apos;&#13;&#10;ELSEIF [For you Reco accepted flag (order_id)]&lt;=0 &#13;&#10;          and [For you Reorder accepted flag (order_id)]&lt;=0&#13;&#10;          and [For you Promo accepted flag (order_id)]&lt;=0 &#13;&#10;          and [For you accepted flag (order_id)]&lt;=0&#13;&#10;          and [Top Trending Accepted flag (order_id)]&lt;=0&#13;&#10;then &apos;Top Trending&apos;&#13;&#10;ELSEIF [For you Reco accepted flag (order_id)]&lt;=0 &#13;&#10;          and [For you Reorder accepted flag (order_id)]&lt;=0&#13;&#10;          and [For you Promo accepted flag (order_id)]&lt;=0 &#13;&#10;          and [For you accepted flag (order_id)]&lt;=0&#13;&#10;then &apos;No AI&apos;&#13;&#10;END*/' />
            </column>
            <column caption='For you Reco accepted flag (order_id)' datatype='integer' name='[Calculation_1415537658322509827]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [order_id_mod]: max([for_you_reco_flag])}' />
            </column>
            <column caption='For you Reorder accepted flag (order_id)' datatype='integer' name='[Calculation_1415537658322825220]' role='measure' type='quantitative'>
