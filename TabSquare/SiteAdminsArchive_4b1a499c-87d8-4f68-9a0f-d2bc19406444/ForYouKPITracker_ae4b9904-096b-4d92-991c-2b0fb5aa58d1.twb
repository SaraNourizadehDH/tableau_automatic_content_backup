      <column caption='Price Buckets' datatype='string' name='[Calculation_2749447623055429638]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_2749447623054200837]&lt;=6 THEN &quot;Less Then $6&quot;&#13;&#10;ELSEIF [Calculation_2749447623054200837]&lt;=12 THEN &quot;Less Then $12&quot;&#13;&#10;ELSEIF [Calculation_2749447623054200837]&lt;=20 THEN &quot;Less Then $20&quot;&#13;&#10;ELse &quot;Above $20&quot;&#13;&#10;END' />
      </column>
      <column caption='MOI % Diff' datatype='real' name='[Calculation_3165467648139595778]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN([Calculation_1673087320944381968]) - LOOKUP(ZN( [Calculation_1673087320944381968]), -1)) / &#13;&#10;ABS(LOOKUP(ZN( [Calculation_1673087320944381968]), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Date Range' datatype='boolean' name='[Calculation_3165467648479408137]' role='dimension' type='nominal'>
