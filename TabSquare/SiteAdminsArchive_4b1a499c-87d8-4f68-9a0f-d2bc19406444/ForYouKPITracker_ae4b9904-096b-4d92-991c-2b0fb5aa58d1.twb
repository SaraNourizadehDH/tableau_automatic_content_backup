      </column>
      <column caption='% Diff Bucket' datatype='string' name='[Calculation_3165467648785076246]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_3165467648780292117]*100 &lt;=0 and [Calculation_3165467648780292117]*100 &gt;=-10 then &apos;-10&apos;&#13;&#10;ELSEIF [Calculation_3165467648780292117]*100 &lt;=-10 and [Calculation_3165467648780292117]*100 &gt;=-20 then &apos;-20&apos;&#13;&#10;ELSEIF [Calculation_3165467648780292117]*100 &lt;=-20 and [Calculation_3165467648780292117]*100 &gt;=-30 then &apos;-30&apos;&#13;&#10;ELSEIF [Calculation_3165467648780292117]*100 &lt;=-30 then &apos;&lt;-30&apos;&#13;&#10;ELSEIF [Calculation_3165467648780292117]*100 &gt;=0 and [Calculation_3165467648780292117]*100 &lt;=10 then &apos;+10&apos;&#13;&#10;ELSEIF [Calculation_3165467648780292117]*100 &gt;=10 and [Calculation_3165467648780292117]*100 &lt;=20 then &apos;+20&apos;&#13;&#10;ELSEIF [Calculation_3165467648780292117]*100 &gt;=20 and [Calculation_3165467648780292117]*100 &lt;=30 then &apos;+30&apos;&#13;&#10;ELSEIF [Calculation_3165467648780292117]*100 &gt;=30 and [Calculation_3165467648780292117]*100 &lt;=40 then &apos;+40&apos;&#13;&#10;ELSEIF [Calculation_3165467648780292117]*100 &gt;=40 and [Calculation_3165467648780292117]*100 &lt;=50 then &apos;+50&apos;&#13;&#10;ELSEIF [Calculation_3165467648780292117]*100 &gt;50 then &apos;&gt;50&apos;&#13;&#10;end'>
