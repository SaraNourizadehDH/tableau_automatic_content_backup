          <object caption='Custom SQL Query' id='_70EA1456811D4A74A50A1647D866E210'>
            <properties context=''>
              <relation connection='bigquery.1c43t3112vdacv14nstja0ax8cja' name='Custom SQL Query' type='text'>SELECT *,row_number() over(PARTITION BY customer_id order by order_id) as order_number,&#10;count(order_id) over(PARTITION BY customer_id) as total_order_count,&#10;count(order_id) &#10;over(PARTITION BY customer_id,CONCAT(CAST(EXTRACT(YEAR FROM DATE (Order_Date)) AS STRING),&quot;-&quot;,CAST(EXTRACT(MONTH FROM DATE (Order_Date)) AS STRING)))&#10;as order_count_month,&#10;min(format_date(&quot;%Y-%m&quot;, order_date)) &#10;over(partition by customer_id) as first_purchase_date,&#10;format_date(&quot;%Y-%m&quot;, order_date) as Year_month,&#10;FROM&#10;(&#10;SELECT&#10;  *&#10;FROM&#10;  tabsquare-data-sciences.datastudio_dashboard_data.all_product_firebase_data&#10;UNION ALL&#10;SELECT&#10;  *&#10;FROM&#10;  tabsquare-data-sciences.datastudio_dashboard_data.all_product_skipque_data&#10;) WHERE  customer_id &gt;&gt; 0&#10;order by customer_id</relation>
            </properties>
          </object>
        </objects>
      </object-graph>
    </datasource>
  </datasources>
