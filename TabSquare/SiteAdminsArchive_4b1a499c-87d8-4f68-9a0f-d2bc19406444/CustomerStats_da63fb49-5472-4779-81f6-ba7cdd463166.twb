      <column caption='Order Bins' datatype='string' name='[Calculation_58969011808854017]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [order_count_month]&#10;WHEN 1 THEN &apos;One Order&apos;&#10;WHEN 2 THEN &apos;Two Orders&apos;&#10;WHEN 3 THEN &apos;Three Orders&apos;&#10;WHEN 4 THEN &apos;Four Orders&apos;&#10;ELSE &apos;5+ Orders&apos;&#10;END' />
