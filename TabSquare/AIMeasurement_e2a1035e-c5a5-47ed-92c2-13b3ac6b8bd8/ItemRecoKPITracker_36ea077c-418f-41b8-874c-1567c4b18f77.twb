            <column caption='Total Order count (merchant_id, date, customer_types) ' datatype='integer' name='[Total Sales (merchant_id, date) (copy)_691513652414963724]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [merchant_id], [Calculation_691513652405370884], [customer_type], [global_repeat_type], [repeat_type]:&#10;countd([order_id_mod])}' />
            </column>
            <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[customer_type]' role='dimension' type='nominal' />
            <column datatype='string' name='[global_repeat_type]' role='dimension' type='nominal' />
            <column caption='Logic Level' datatype='string' name='[logic level  (copy)_3571073038242603008]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_1415537658322509827]&gt;0 &#13;&#10;          and [Calculation_1415537658323038214]&gt;0 &#13;&#10;          and [Calculation_691513652404211713]&gt;0&#13;&#10;then &apos;OverAll&apos;&#13;&#10;ELSEIF [Calculation_1415537658322509827]&gt;0 &#13;&#10;          and [Calculation_1415537658323038214]&lt;=0 &#13;&#10;          and [Calculation_691513652404211713]&gt;0&#13;&#10;then &apos;Only Reco Order&apos;&#13;&#10;ELSEIF [Calculation_1415537658322509827]&lt;=0 &#13;&#10;          and [Calculation_1415537658323038214]&gt;0 &#13;&#10;          and [Calculation_691513652404211713]&gt;0&#13;&#10;then &apos;Only Reco Item&apos;&#13;&#10;ELSEIF [Calculation_1415537658322509827]&lt;=0 &#13;&#10;          and [Calculation_1415537658323038214]&lt;=0 &#13;&#10;          and [Calculation_691513652404211713]&lt;=0&#13;&#10;then &apos;No Reco&apos;&#13;&#10;END&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;/*if [For you Reco accepted flag (order_id)]&gt;0 &#13;&#10;          and [For you Reorder accepted flag (order_id)]&gt;0&#13;&#10;          and [For you Promo accepted flag (order_id)]&gt;0 &#13;&#10;          and [For you accepted flag (order_id)]&gt;0&#13;&#10;          &#13;&#10;then &apos;OverAll&apos;&#13;&#10;ELSEIF [For you Reco accepted flag (order_id)]&gt;0 &#13;&#10;          and [For you Reorder accepted flag (order_id)]&gt;0&#13;&#10;          and [For you Promo accepted flag (order_id)]&lt;=0 &#13;&#10;          and [For you accepted flag (order_id)]&gt;0&#13;&#10;          &#13;&#10;then &apos;Reco &amp; Reorder&apos;&#13;&#10;ELSEIF [For you Reco accepted flag (order_id)]&gt;0 &#13;&#10;          and [For you Reorder accepted flag (order_id)]&lt;=0&#13;&#10;          and [For you Promo accepted flag (order_id)]&gt;0 &#13;&#10;          and [For you accepted flag (order_id)]&gt;0&#13;&#10;          and [Top Trending Accepted flag (order_id)]&lt;=0&#13;&#10;then &apos;Reco &amp; Promo&apos;&#13;&#10;ELSEIF [For you Reco accepted flag (order_id)]&lt;=0 &#13;&#10;          and [For you Reorder accepted flag (order_id)]&gt;0&#13;&#10;          and [For you Promo accepted flag (order_id)]&gt;0 &#13;&#10;          and [For you accepted flag (order_id)]&gt;0&#13;&#10;          &#13;&#10;then &apos;Reorder &amp; Promo&apos;&#13;&#10;ELSEIF [For you Reco accepted flag (order_id)]&gt;0 &#13;&#10;          and [For you Reorder accepted flag (order_id)]&lt;=0&#13;&#10;          and [For you Promo accepted flag (order_id)]&lt;=0 &#13;&#10;          and [For you accepted flag (order_id)]&gt;0&#13;&#10;          &#13;&#10;then &apos;Only Reco&apos;&#13;&#10;ELSEIF [For you Reco accepted flag (order_id)]&lt;=0 &#13;&#10;          and [For you Reorder accepted flag (order_id)]&gt;0&#13;&#10;          and [For you Promo accepted flag (order_id)]&lt;=0 &#13;&#10;          and [For you accepted flag (order_id)]&gt;0&#13;&#10;          &#13;&#10;then &apos;Only Reorder&apos;&#13;&#10;ELSEIF [For you Reco accepted flag (order_id)]&lt;=0 &#13;&#10;          and [For you Reorder accepted flag (order_id)]&lt;=0&#13;&#10;          and [For you Promo accepted flag (order_id)]&gt;0 &#13;&#10;          and [For you accepted flag (order_id)]&gt;0&#13;&#10;          &#13;&#10;then &apos;Only Promo&apos;&#13;&#10;ELSEIF [For you Reco accepted flag (order_id)]&lt;=0 &#13;&#10;          and [For you Reorder accepted flag (order_id)]&lt;=0&#13;&#10;          and [For you Promo accepted flag (order_id)]&lt;=0 &#13;&#10;          and [For you accepted flag (order_id)]&lt;=0&#13;&#10;          and [Top Trending Accepted flag (order_id)]&lt;=0&#13;&#10;then &apos;Top Trending&apos;&#13;&#10;ELSEIF [For you Reco accepted flag (order_id)]&lt;=0 &#13;&#10;          and [For you Reorder accepted flag (order_id)]&lt;=0&#13;&#10;          and [For you Promo accepted flag (order_id)]&lt;=0 &#13;&#10; 