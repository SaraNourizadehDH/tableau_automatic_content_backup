      <table>
        <view>
          <datasources>
            <datasource caption='Item Reco Customer Query' name='federated.0kbs8ie10nulls1bi9gpd1y3ews1' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Time Period' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0kbs8ie10nulls1bi9gpd1y3ews1].[Calculation_1613203501769428993]' caption='Start Date' datatype='date' datatype-customized='true' name='[Parameter 5]' param-domain-type='any' role='measure' type='quantitative' value='#2023-01-27#'>
              <calculation class='tableau' formula='#2023-01-27#' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0kbs8ie10nulls1bi9gpd1y3ews1].[Calculation_1613203501769289728]' caption='End Date' datatype='date' datatype-customized='true' name='[Parameter 6]' param-domain-type='any' role='measure' type='quantitative' value='#2023-02-26#'>
              <calculation class='tableau' formula='#2023-02-26#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0kbs8ie10nulls1bi9gpd1y3ews1'>
            <column datatype='string' name='[Account_Name]' role='dimension' type='nominal' />
            <column caption='Reco Order accepted flag (order_id)' datatype='integer' name='[Calculation_1415537658322509827]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [order_id_mod]: max([reco_order_flag])}' />
            </column>
            <column caption='Reco Item accepted flag (order_id)' datatype='integer' name='[Calculation_1415537658323038214]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [order_id_mod]: max([reco_item_flag])}' />
            </column>
            <column caption='Latest End Date' datatype='date' name='[Calculation_1613203501769289728]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{fixed :max(date(DATEADD(&apos;day&apos;,-1,{fixed: max([Calculation_691513652405370884])})))}' />
            </column>
            <column caption='Latest Start Date' datatype='date' name='[Calculation_1613203501769428993]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{fixed: max(date(DATEADD(&apos;day&apos;,-30, [Calculation_1613203501769289728])))}' />
            </column>
            <column caption='Selected Time Period' datatype='date' name='[Calculation_2493797990550470662]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='date(if [Parameters].[Parameter 3]=&apos;Year&apos; then DATETRUNC(&apos;year&apos;, [Calculation_691513652405370884])&#10;elseif [Parameters].[Parameter 3]=&apos;Quarter&apos; then DATETRUNC(&apos;quarter&apos;, [Calculation_691513652405370884])&#10;elseif [Parameters].[Parameter 3]=&apos;Month&apos; then DATETRUNC(&apos;month&apos;, [Calculation_691513652405370884])&#10;elseif [Parameters].[Parameter 3]=&apos;Week&apos; then DATETRUNC(&apos;week&apos;, [Calculation_691513652405370884])&#10;end)' />
            </column>
            <column caption='eCMS/CMS' datatype='string' name='[Calculation_2493797990566744072]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if CONTAINS([merchant_id],&apos;HQ&apos;) then &apos;eCMS&apos; else &apos;CMS&apos; end' />
            </column>
            <column caption='Date Range' datatype='boolean' name='[Calculation_3165467648479408137]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_691513652405370884]&gt;= [Parameters].[Parameter 5] and&#13;&#10;[Calculation_691513652405370884]&lt;= [Parameters].[Parameter 6]' />
            </column>
            <column caption='Reco accepted flag (order_id)' datatype='integer' name='[Calculation_691513652404211713]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [order_id_mod]: max([reco_flag])}' />
            </column>
            <column caption='Date (sgt_datetime)' datatype='date' name='[Calculation_691513652405370884]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='date([sgt_datetime])' />
            </column>
            <column caption='Logic Level Reco Accepted Order count (merchant_id, date, customer_type, repeat types) ' datatype='integer' name='[For You Accepted Order count (merchant_id, date, customer_type, repeat types) (copy)_1164743454870630400]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [merchant_id], [Calculation_691513652405370884], [customer_type], [global_repeat_type], [repeat_type], [logic level  (copy)_3571073038242603008]:&#10;countd(if [Calculation_691513652404211713]&gt;0 then [order_id_mod] end)}' />
            </column>
            <column caption='Logic Level Reco Acceptance Rate ' datatype='real' name='[For you Acceptance Rate (copy)_2749447623037214720]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(ifnull([For You Accepted Order count (merchant_id, date, customer_type, repeat types) (copy)_1164743454870630400],0))&#10;/&#10;sum([Total Sales (merchant_id, date) (copy)_691513652414963724])' />
            </column>
            <column datatype='string' name='[Name_of_Account_Manager]' role='dimension' type='nominal' />
            <column datatype='string' name='[Team]' role='dimension' type='nominal' />
            <column caption='Total Order count (merchant_id, date, customer_types) ' datatype='integer' name='[Total Sales (merchant_id, date) (copy)_691513652414963724]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [merchant_id], [Calculation_691513652405370884], [customer_type], [global_repeat_type], [repeat_type]:&#10;countd([order_id_mod])}' />
            </column>
            <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[customer_type]' role='dimension' type='nominal' />
