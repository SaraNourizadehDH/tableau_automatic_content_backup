      <aliases enabled='yes' />
      <column caption='Min Order Date (merchant id)' datatype='date' name='[Calculation_4504866313499631616]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{fixed [Merchant_id]: min([order_date])}' />
      </column>
      <column caption='Max Date (overall)' datatype='date' name='[Calculation_4504866313510965252]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='{fixed [Calculation_4504866313511186437]: max([month])}' />
      </column>
      <column caption='dummy' datatype='integer' name='[Calculation_4504866313511186437]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column aggregation='Sum' caption='Lost Merchant Flag (month)' datatype='integer' name='[Calculation_4504866314450219039]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if ifnull([last_3_months_gmv],0)=0 and ifnull([last_4_months_gmv],0)!=0&#10;and [first_month_flag]=0 and ifnull(sales,0)=0 then 1 else 0 end' />
      </column>
      <column caption='Monthly Merchant Cohorts' datatype='string' name='[Calculation_4504866314453905440]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [first_month_flag]=1 then &apos;New&apos;&#10;ELSEIF ifnull([last_1_month_gmv],0)=0 and ifnull([last_2_months_gmv],0)&gt;0 and ifnull([sales],0)=0 then &apos;At Risk of being Lost&apos;&#10;elseif ifnull([last_2_months_gmv],0)=0 and ifnull([last_3_months_gmv],0)&gt;0 and ifnull([sales],0)=0 then &apos;High Risk of being Lost&apos;&#10;ELSEIF ifnull([last_1_month_gmv],0)&gt;0 and ifnull([sales],0)=0 then &apos;Not Active&apos;&#10;ELSEIF ifnull([last_1_month_gmv],0)&gt;0 and ifnull([sales],0)&gt;0 then [Calculation_4504866314491465766]&#10;elseif ifnull([last_1_month_gmv],0)=0  and ifnull([last_2_months_gmv],0)&gt;0 and ifnull([sales],0)&gt;0 then &apos;Quick Restarted&apos;&#10;elseif ifnull([last_2_months_gmv],0)=0 and ifnull([last_3_months_gmv],0)&gt;0 and ifnull([sales],0)&gt;0 then &apos;Restarted&apos;&#10;elseif ifnull([last_3_months_gmv],0)=0 and ifnull([sales],0)&gt;0 then &apos;Back From Dead&apos;&#10;ELSEIF [Calculation_4504866314450219039]=1 then &apos;Lost&apos;&#10;end' />
      </column>
      <column caption='Change in GMV wrt last month' datatype='real' name='[Calculation_4504866314491301925]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([sales]-[last_1_month_gmv])/[last_1_month_gmv]' />
      </column>
      <column caption='Active Cohorts' datatype='string' name='[Calculation_4504866314491465766]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Change in GMV wrt last month (copy)_4790844909308878848]&gt;=0.2 then &apos;Increasing&apos;&#10;ELSEIF [Change in GMV wrt last month (copy)_4790844909308878848]&lt;-0.2 then &apos;Decreasing&apos;&#10;else &apos;Stable&apos;&#10;end' />
      </column>
      <column caption='Change in GMV wrt last month per day' datatype='real' name='[Change in GMV wrt last month (copy)_4790844909308878848]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([sales_per_day]-[last_1_month_gmv_day])/[last_1_month_gmv_day]' />
      </column>
      <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column caption='Monthly Merchant Cohorts - Category' datatype='string' name='[Monthly Merchant Cohorts (copy)_4504866314491957287]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [first_month_flag]=1 then &apos;New&apos;&#10;ELSEIF ifnull([last_1_month_gmv],0)&gt;0 and ifnull([sales],0)&gt;0 then &apos;Active&apos;&#10;ELSEIF [Calculation_4504866314453905440] = &apos;Not Active&apos;  then &apos;Not Active&apos;&#10;elseif [Calculation_4504866314453905440] = &apos;At Risk of being Lost&apos; &#10;        or [Calculation_4504866314453905440] = &apos;High Risk of being Lost&apos; then &apos;At Risk&apos;&#10;ELSEIF [Calculation_4504866314453905440] = &apos;Restarted&apos;&#10;        or [Calculation_4504866314453905440] = &apos;Quick Restarted&apos;&#10;        or [Calculation_4504866314453905440] = &apos;Back From Dead&apos; then &apos;Restarted&apos;&#10;else [Calculation_4504866314453905440]&#10;end' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Custom SQL Query' datatype='table' name='[__tableau_internal_object_id__].[_4E6E7F7802D741ED9C10B41A2329343E]' role='measure' type='quantitative' />
      <column aggregation='Sum' datatype='integer' name='[first_month_flag]' role='dimension' type='ordinal' />
      <column caption='last_1_month_gmv (copy)' datatype='real' name='[last_1_month_gmv (copy)_2255529422517014567]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[last_1_month_gmv]' />
      </column>
