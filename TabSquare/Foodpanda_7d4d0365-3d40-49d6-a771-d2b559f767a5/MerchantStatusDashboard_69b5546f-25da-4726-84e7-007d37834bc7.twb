      <column caption='Month 1 Cohorts    ' datatype='string' name='[Calculation_1964765758890848256]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if isnull([Calculation_4504866314509484086]) and [Month 1 cohorts (copy)_4504866314509586487] = &apos;New&apos; then &apos;NA&apos;&#10;elseif isnull([Calculation_4504866314509484086]) then &apos;Long Lost&apos;&#10;else [Calculation_4504866314509484086] end' />
      </column>
      <column caption='Rank of merchant counts' datatype='integer' name='[Calculation_1964765758893834251]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='rank(ifnull(countd([merchant_id]),0))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Month 2 Cohorts    ' datatype='string' name='[Calculation_1964765758923497492]' role='dimension' type='nominal'>
