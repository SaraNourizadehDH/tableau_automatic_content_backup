      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_4E6E7F7802D741ED9C10B41A2329343E'>
            <properties context=''>
              <relation connection='bigquery.1098kz61n7v0411aoh5q01cjrx5x (copy)' name='Custom SQL Query' type='text'>select base.*,c.sales as sales,c.sales_per_day as sales_per_day,
sum(sales) over(partition by base.merchant_id
                order by base.month
                rows between 4 preceding and 1 preceding) as last_4_months_gmv,
sum(sales) over(partition by base.merchant_id
                order by base.month
                rows between 3 preceding and 1 preceding) as last_3_months_gmv,
sum(sales) over(partition by base.merchant_id
                order by base.month
                rows between 2 preceding and 1 preceding) as last_2_months_gmv,
sum(sales) over(partition by base.merchant_id
                order by base.month
                rows between 1 preceding and 1 preceding) as last_1_month_gmv,
sum(sales_per_day) over(partition by base.merchant_id
                  order by base.month
                  rows between 1 preceding and 1 preceding) as last_1_month_gmv_day,
&apos;dummy&apos; as data_type,
mapp.Chain_Name_in_system,mapp.Account_Name,mapp.Name_of_Account_Manager,
mapp.Team
from
(
  select merchant_id,RestaurantName,Country, b.month,
  case when min_order_date_month=b.month then 1 else 0 end as first_month_flag
from
(
  select merchant_id, RestaurantName,Country, 1 as dummy, min(min_order_date_month) as min_order_date_month
  from
  (
  select merchant_id,RestaurantName,Country,1 as dummy, date_trunc(min(order_date),MONTH) as min_order_date_month
FROM
  `tabsquare-data-sciences.datastudio_dashboard_data.all_product_firebase_data`
  group by 1,2,3,4
union all
select merchant_id,RestaurantName,Country,1 as dummy,date_trunc(min(order_date),MONTH) as min_order_date_month
FROM
  `tabsquare-data-sciences.datastudio_dashboard_data.all_product_skipque_data`
  group by 1,2,3,4
  )
  group by 1,2,3
)a
inner join
(
  select month, dummy
  from
(
  SELECT date_trunc(order_date, MONTH) as month,1 as dummy
FROM
  `tabsquare-data-sciences.datastudio_dashboard_data.all_product_firebase_data`
  group by 1,2
union all
  SELECT date_trunc(order_date, MONTH) as month,1 as dummy
FROM
  `tabsquare-data-sciences.datastudio_dashboard_data.all_product_skipque_data`
  group by 1,2
)
group by 1,2
)b
on a.dummy = b.dummy
where b.month&gt;&gt;=a.min_order_date_month
)base
left join
  (
    select gm.*, md.days, case when md.days is not null then sales/days else sales end as sales_per_day from
    (select merchant_id,  month, sum(sales) as sales
    from
    (
    select merchant_id, date_trunc(order_date,MONTH) as month, sum(sales) as sales
  FROM
    `tabsquare-data-sciences.datastudio_dashboard_data.all_product_firebase_data`
    group by 1,2
  union all
  select merchant_id, date_trunc(order_date,MONTH) as month, sum(sales) as sales
  from
    `tabsquare-data-sciences.datastudio_dashboard_data.all_product_skipque_data`
    group by 1,2
    )
    group by 1,2) gm 
  left join (select date_trunc(order_date,MONTH) as month , count(distinct order_date) as days from `tabsquare-data-sciences.datastudio_dashboard_data.all_product_skipque_data` group by 1) md 
  on gm.month = md.month)c
on base.month=c.month and 
base.merchant_id = c.merchant_id
left join
`tabsquare-data-sciences.tabsquare_dw_lookups.master_merchant_list` mapp
on base.merchant_id = mapp.merchant_id
left join `tabsquare-data-sciences.skipque_cdc_data_prod.organization` eo 
on base.merchant_id = eo.merchant_key 
where eo.organization_partner_id = 1

union all 

select base.*,c.sales as sales, c.sales_per_day as sales_per_day,
sum(sales) over(partition by base.merchant_id
                order by base.month
                rows between 4 preceding and 1 preceding) as last_4_months_gmv,
sum(sales) over(partition by base.merchant_id
                order by base.month
                rows between 3 preceding and 1 preceding) as last_3_months_gmv,
sum(sales) over(partition by base.merchant_id
                order by base.month
                rows between 2 preceding and 1 preceding) as last_2_months_gmv,
sum(sales) over(partition by base.merchant_id
                order by base.month
                rows between 1 preceding and 1 preceding) as last_1_month_gmv,
sum(sales_per_day) over(partition by base.merchant_id
                  order by base.month
                  rows between 1 preceding and 1 preceding) as last_1_month_gmv_day,
&apos;real&apos; as data_type,
mapp.Chain_Name_in_system,mapp.Account_Name,mapp.Name_of_Account_Manager,
mapp.Team
from
(
  select merchant_id,RestaurantName,Country, b.month,
  case when min_order_date_month=b.month then 1 else 0 end as first_month_flag
from
(
  select merchant_id, RestaurantName,Country, 1 as dummy, min(min_order_date_month) as min_order_date_month
  from
  (
  select merchant_id,RestaurantName,Country,1 as dummy, date_trunc(min(order_date),MONTH) as min_order_date_month
FROM
  `tabsquare-data-sciences.datastudio_dashboard_data.all_product_firebase_data`
  group by 1,2,3,4
union all
select merchant_id,RestaurantName,Country,1 as dummy,date_trunc(min(order_date),MONTH) as min_order_date_month
FROM
  `tabsquare-data-sciences.datastudio_dashboard_data.all_product_skipque_data`
  group by 1,2,3,4
  )
  group by 1,2,3,4
)a
inner join
(
  select month, dummy
  from
(
  SELECT date_trunc(order_date, MONTH) as month,1 as dummy
FROM
  `tabsquare-data-sciences.datastudio_dashboard_data.all_product_firebase_data`
  group by 1,2
union all
  SELECT date_trunc(order_date, MONTH) as month,1 as dummy
FROM
  `tabsquare-data-sciences.datastudio_dashboard_data.all_product_skipque_data`
  group by 1,2
)
group by 1,2
)b
on a.dummy = b.dummy
where b.month&gt;&gt;=a.min_order_date_month
)base
left join
  (
    select gm.*, md.days, case when md.days is not null then sales/days else sales end as sales_per_day from
    (select merchant_id,  month, sum(sales) as sales
    from
    (
    select merchant_id, date_trunc(order_date,MONTH) as month, sum(sales) as sales
  FROM
    `tabsquare-data-sciences.datastudio_dashboard_data.all_product_firebase_data`
    group by 1,2
  union all
  select merchant_id, date_trunc(order_date,MONTH) as month, sum(sales) as sales
  from
    `tabsquare-data-sciences.datastudio_dashboard_data.all_product_skipque_data`
    group by 1,2
    )
    group by 1,2) gm 
  left join (select date_trunc(order_date,MONTH) as month , count(distinct order_date) as days from `tabsquare-data-sciences.datastudio_dashboard_data.all_product_skipque_data` group by 1) md 
  on gm.month = md.month )c
on base.month=c.month and 
base.merchant_id = c.merchant_id
left join
`tabsquare-data-sciences.tabsquare_dw_lookups.master_merchant_list` mapp
on base.merchant_id = mapp.merchant_id
left join `tabsquare-data-sciences.skipque_cdc_data_prod.organization` eo 
on base.merchant_id = eo.merchant_key 
where eo.organization_partner_id = 1</relation>
            </properties>
          </object>
        </objects>
