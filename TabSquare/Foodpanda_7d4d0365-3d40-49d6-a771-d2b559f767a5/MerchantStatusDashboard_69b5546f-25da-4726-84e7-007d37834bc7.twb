            </zone>
          </zone>
          <zone forceUpdate='true' h='81625' id='23' type-v2='text' w='16514' x='82794' y='17250'>
            <formatted-text>
              <run bold='true' fontalignment='1' fontsize='8'>Definitions</run>
              <run fontalignment='1'>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run bold='true' fontsize='8' underline='true'>Monthly Merchant Cohorts - Category:</run>
              <run>Æ&#10;</run>
              <run bold='true' fontsize='8' underline='true'>(</run>
              <run bold='true' fontsize='8' italic='true'>Click on &apos;+&apos; sign to expand category into granular cohorts</run>
              <run bold='true' fontsize='8' underline='true'>)</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontsize='8'>New</run>
              <run fontsize='8'>: Has GMV for the first time in the current month (t)</run>
              <run>Æ&#10;</run>
              <run bold='true' fontsize='8'>Active</run>
              <run fontsize='8'>: Has GMV last month (t-1) as well in the current month (t)</run>
              <run>Æ&#10;</run>
              <run fontsize='8'>Æ     </run>
              <run bold='true' fontsize='8'>   Increasing: </run>
              <run fontsize='8'>20% Increase in GMV from last month</run>
              <run>Æ&#10;</run>
              <run bold='true' fontsize='8'>        Decreasing: </run>
              <run fontsize='8'>20% decrease in GMV from last month</run>
              <run>Æ&#10;</run>
              <run bold='true' fontsize='8'>        Stable: </run>
              <run fontsize='8'>GMV change between -20% to 20%</run>
              <run>Æ&#10;</run>
              <run bold='true' fontsize='8'>Restarted</run>
              <run fontsize='8'>: No GMV in t-x months but has GMV in the the current month</run>
              <run>Æ&#10;</run>
              <run fontsize='8'>Æ        </run>
              <run bold='true' fontsize='8'>Quick Restarted: </run>
              <run fontsize='8'>No GMV in t-1 month but has GMV in the current month</run>
              <run>Æ&#10;</run>
              <run fontsize='8'>Æ        </run>
              <run bold='true' fontsize='8'>Restarted: </run>
              <run fontsize='8'>No GMV in t-1 and t-2 months but has GMV in the current month</run>
              <run>Æ&#10;</run>
              <run fontsize='8'>Æ        </run>
              <run bold='true' fontsize='8'>Back From Dead: </run>
              <run fontsize='8'>No GMV in t-1, t-2 and t-3 months but has GMV in the current month</run>
              <run>Æ&#10;</run>
              <run bold='true' fontsize='8'>Not Active</run>
              <run fontsize='8'>: Has GMV in t-1 month but no GMV in the current month</run>
              <run>Æ&#10;</run>
              <run bold='true' fontsize='8'>At Risk</run>
              <run fontsize='8'>: Has GMV in t-2 or t-3 months but no GMV in the current month</run>
              <run>Æ&#10;</run>
              <run fontsize='8'>Æ        </run>
              <run bold='true' fontsize='8'>At Risk of being Lost: </run>
              <run fontsize='8'>Has GMV in t-2 month but no GMV in t-1 and current months</run>
              <run>Æ&#10;</run>
              <run bold='true' fontsize='8'>       High Risk of being Lost: </run>
              <run fontsize='8'>Has GMV in t-3 month but no GMV in t-2, t-1 and current months</run>
              <run>Æ&#10;</run>
              <run bold='true' fontsize='8'>Lost</run>
              <run fontsize='8'>: No GMV t-1, t-2, and t-3 months AND no GMV in the current month</run>
              <run>Æ&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='solid' />
              <format attr='border-width' value='1' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone h='9250' id='24' type-v2='empty' w='16514' x='82794' y='8000'>
