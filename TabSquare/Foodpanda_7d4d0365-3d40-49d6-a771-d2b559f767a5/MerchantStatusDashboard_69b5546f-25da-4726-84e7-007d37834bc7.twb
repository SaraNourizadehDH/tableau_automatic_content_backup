            <column-instance column='[Monthly Merchant Cohorts (copy)_4504866314491957287]' derivation='None' name='[none:Monthly Merchant Cohorts (copy)_4504866314491957287:nk]' pivot='key' type='nominal' />
            <column-instance column='[Name_of_Account_Manager]' derivation='None' name='[none:Name_of_Account_Manager:nk]' pivot='key' type='nominal' />
            <column-instance column='[Team]' derivation='None' name='[none:Team:nk]' pivot='key' type='nominal' />
            <column-instance column='[month]' derivation='None' name='[none:month:qk]' pivot='key' type='quantitative' />
            <column datatype='real' name='[sales]' role='measure' type='quantitative' />
            <column datatype='real' name='[sales_per_day]' role='measure' type='quantitative' />
            <column-instance column='[sales]' derivation='Sum' name='[sum:sales:qk]' pivot='key' type='quantitative' />
            <column-instance column='[month]' derivation='Month-Trunc' name='[tmn:month:ok]' pivot='key' type='ordinal' />
