        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.025ypmu09tk373167e02g0hi8kg0' name='Custom SQL Query' type='text'>select a.*, b.Chain_Name_in_system,b.Account_Name,b.Name_of_Account_Manager,
b.Team,b.Sales_Planning_and_Opportunity_Names, o.cms_merchant_key, coalesce(ecms_migration_done,0) as ecms_migration_done
from
(
SELECT
  *
FROM
  `tabsquare-data-sciences.datastudio_dashboard_data.all_product_firebase_data`
WHERE
  order_date &gt;&gt;=&apos;2022-01-01&apos;
UNION ALL
SELECT
  *
FROM
  `tabsquare-data-sciences.datastudio_dashboard_data.all_product_skipque_data`
WHERE
  order_date &gt;&gt;=&apos;2022-01-01&apos;
)a
left join
`tabsquare-data-sciences.tabsquare_dw_lookups.master_merchant_list` b
on a.merchant_id = b.merchant_id
left join
(select cms_merchant_key, 1 as ecms_migration_done
from
`tabsquare-data-sciences.skipque_cdc_data_prod.organization`
group by 1
)
 o
on a.merchant_id = o.cms_merchant_key
left join `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_organization_view_prod` eo 
on a.merchant_id = eo.merchant_key 
where eo.organization_partner_id = 1</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.025ypmu09tk373167e02g0hi8kg0' name='Custom SQL Query' type='text'>select a.*, b.Chain_Name_in_system,b.Account_Name,b.Name_of_Account_Manager,
b.Team,b.Sales_Planning_and_Opportunity_Names, o.cms_merchant_key, coalesce(ecms_migration_done,0) as ecms_migration_done
from
(
SELECT
  *
FROM
  `tabsquare-data-sciences.datastudio_dashboard_data.all_product_firebase_data`
WHERE
  order_date &gt;&gt;=&apos;2022-01-01&apos;
UNION ALL
SELECT
  *
FROM
  `tabsquare-data-sciences.datastudio_dashboard_data.all_product_skipque_data`
WHERE
  order_date &gt;&gt;=&apos;2022-01-01&apos;
)a
left join
`tabsquare-data-sciences.tabsquare_dw_lookups.master_merchant_list` b
on a.merchant_id = b.merchant_id
left join
(select cms_merchant_key, 1 as ecms_migration_done
from
`tabsquare-data-sciences.skipque_cdc_data_prod.organization`
group by 1
)
 o
on a.merchant_id = o.cms_merchant_key
left join `tabsquare-data-sciences.all_skipque_cdc_data_prod.all_organization_view_prod` eo 
on a.merchant_id = eo.merchant_key 
where eo.organization_partner_id = 1</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
