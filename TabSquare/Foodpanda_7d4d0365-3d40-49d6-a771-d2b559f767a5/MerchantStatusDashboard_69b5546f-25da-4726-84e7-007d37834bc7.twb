    <datasource caption='tabsquare_dw_skipque_prod' inline='true' name='federated.0vlutid1t3dqjf1akvmoa1ir3tok' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.025ypmu09tk373167e02g0hi8kg0'>
            <connection CATALOG='tabsquare-data-sciences' EXECCATALOG='tabsquare-data-sciences' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='3' bq-large-fetch-rows='250000' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tabsquare-data-sciences' schema='tabsquare_dw_skipque_prod' server-oauth='server-custom' username='data-team-tableau@tabsquare-data-sciences.iam.gserviceaccount.com' workgroup-auth-mode='prompt'>
              <connection-customization class='bigquery' enabled='false' version='18.1'>
                <vendor name='bigquery' />
                <driver name='bigquery' />
                <customizations>
                  <customization name='CAP_BIGQUERY_FORCE_SPOOL_JOB' value='yes' />
                  <customization name='bq-fetch-tasks' value='3' />
