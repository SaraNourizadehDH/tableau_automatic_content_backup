            <column caption='Merchant Cohort' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Category&quot;'>
              <calculation class='tableau' formula='&quot;Category&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1f6gma10e2cp9u17jvh6y1qwhtle (copy)'>
            <column datatype='string' name='[Account_Name]' role='dimension' type='nominal' />
            <column caption='Month 1 Cohorts    ' datatype='string' name='[Calculation_1964765758890848256]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if isnull([Calculation_4504866314509484086]) and [Month 1 cohorts (copy)_4504866314509586487] = &apos;New&apos; then &apos;NA&apos;&#10;elseif isnull([Calculation_4504866314509484086]) then &apos;Long Lost&apos;&#10;else [Calculation_4504866314509484086] end' />
            </column>
            <column caption='Month 2 Cohorts    ' datatype='string' name='[Calculation_1964765758923497492]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if isnull([Month 1 cohorts (copy)_4504866314509586487]) then &apos;Long Lost&apos;&#10;else [Month 1 cohorts (copy)_4504866314509586487] end' />
            </column>
            <column aggregation='Sum' caption='Lost Merchant Flag (month)' datatype='integer' name='[Calculation_4504866314450219039]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if ifnull([last_3_months_gmv],0)=0 and ifnull([last_4_months_gmv],0)!=0&#10;and [first_month_flag]=0 and ifnull(sales,0)=0 then 1 else 0 end' />
            </column>
            <column caption='Monthly Merchant Cohorts' datatype='string' name='[Calculation_4504866314453905440]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [first_month_flag]=1 then &apos;New&apos;&#10;ELSEIF ifnull([last_1_month_gmv],0)=0 and ifnull([last_2_months_gmv],0)&gt;0 and ifnull([sales],0)=0 then &apos;At Risk of being Lost&apos;&#10;elseif ifnull([last_2_months_gmv],0)=0 and ifnull([last_3_months_gmv],0)&gt;0 and ifnull([sales],0)=0 then &apos;High Risk of being Lost&apos;&#10;ELSEIF ifnull([last_1_month_gmv],0)&gt;0 and ifnull([sales],0)=0 then &apos;Not Active&apos;&#10;ELSEIF ifnull([last_1_month_gmv],0)&gt;0 and ifnull([sales],0)&gt;0 then [Calculation_4504866314491465766]&#10;elseif ifnull([last_1_month_gmv],0)=0  and ifnull([last_2_months_gmv],0)&gt;0 and ifnull([sales],0)&gt;0 then &apos;Quick Restarted&apos;&#10;elseif ifnull([last_2_months_gmv],0)=0 and ifnull([last_3_months_gmv],0)&gt;0 and ifnull([sales],0)&gt;0 then &apos;Restarted&apos;&#10;elseif ifnull([last_3_months_gmv],0)=0 and ifnull([sales],0)&gt;0 then &apos;Back From Dead&apos;&#10;ELSEIF [Calculation_4504866314450219039]=1 then &apos;Lost&apos;&#10;end' />
            </column>
            <column caption='Active Cohorts' datatype='string' name='[Calculation_4504866314491465766]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Change in GMV wrt last month (copy)_5037065145194942464]&gt;=0.2 then &apos;Increasing&apos;&#10;ELSEIF [Change in GMV wrt last month (copy)_5037065145194942464]&lt;-0.2 then &apos;Decreasing&apos;&#10;else &apos;Stable&apos;&#10;end' />
            </column>
            <column caption='Month 1 cohorts' datatype='string' name='[Calculation_4504866314509484086]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{fixed [merchant_id]:max(if [month]=[Parameters].[Parameter 4] then [Calculation_5338384089298939907] end)}' />
            </column>
            <column caption='Merchant Cohorts (dynamic)' datatype='string' name='[Calculation_5338384089298939907]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 5]=&apos;Category&apos; then [Monthly Merchant Cohorts (copy)_4504866314491957287]&#10;else [Calculation_4504866314453905440] end' />
            </column>
            <column caption='Month 1 + Month 2 GMV' datatype='real' name='[Calculation_6004002040909819905]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [month]=[Parameters].[Parameter 4] or [month]=[Parameters].[Parameter 3] then [sales] end)' />
            </column>
            <column caption='-1*ifnull([Month 1 + Month 2 GMV],0)' datatype='real' name='[Calculation_6004002040910286851]' role='measure' type='quantitative' user:unnamed='Merchant List - Sankey'>
              <calculation class='tableau' formula='-1*ifnull([Calculation_6004002040909819905],0)' />
            </column>
            <column datatype='string' name='[Chain_Name_in_system]' role='dimension' type='nominal' />
            <column caption='Change in GMV wrt last month per day' datatype='real' name='[Change in GMV wrt last month (copy)_5037065145194942464]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([sales_per_day]-[last_1_month_gmv_day])/[last_1_month_gmv_day]' />
            </column>
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Month 2 cohorts ' datatype='string' name='[Month 1 cohorts (copy)_4504866314509586487]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{fixed [merchant_id]:max(if [month]=[Parameters].[Parameter 3] then [Calculation_5338384089298939907] end)}' />
            </column>
            <column caption='Monthly Merchant Cohorts - Category' datatype='string' name='[Monthly Merchant Cohorts (copy)_4504866314491957287]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [first_month_flag]=1 then &apos;New&apos;&#10;ELSEIF ifnull([last_1_month_gmv],0)&gt;0 and ifnull([sales],0)&gt;0 then &apos;Active&apos;&#10;ELSEIF [Calculation_4504866314453905440] = &apos;Not Active&apos;  then &apos;Not Active&apos;&#10;elseif [Calculation_4504866314453905440] = &apos;At Risk of being Lost&apos; &#10;        or [Calculation_4504866314453905440] = &apos;High Risk of being Lost&apos; then &apos;At Risk&apos;&#10;ELSEIF [Calculation_4504866314453905440] = &apos;Restarted&apos;&#10;        or [Calculation_4504866314453905440] = &apos;Quick Restarted&apos;&#10;        or [Calculation_4504866314453905440] = &apos;Back From Dead&apos; then &apos;Restarted&apos;&#10;else [Calculation_4504866314453905440]&#10;end' />
