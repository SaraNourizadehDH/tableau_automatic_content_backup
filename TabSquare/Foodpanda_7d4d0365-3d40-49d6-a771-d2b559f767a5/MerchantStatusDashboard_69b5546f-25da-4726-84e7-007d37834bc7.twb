    <worksheet name='Increase GMV merchants - AM'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>By Account Manager</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tabsquare_dw_skipque_prod' name='federated.0vlutid1t3dqjf1akvmoa1ir3tok' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Decrease GMV/day threshold (%) ' datatype='real' name='[Increase GMV/day threshold (%) (copy)_2255529422443560970]' param-domain-type='any' role='measure' type='quantitative' value='10.'>
              <calculation class='tableau' formula='10.' />
            </column>
            <column caption='Current Time Period (Last n days)' datatype='integer' name='[Parameter 6]' param-domain-type='any' role='measure' type='quantitative' value='7'>
              <calculation class='tableau' formula='7' />
            </column>
            <column caption='Compare Time Period (days prior current)' datatype='integer' name='[Parameter 7]' param-domain-type='any' role='measure' type='quantitative' value='30'>
              <calculation class='tableau' formula='30' />
            </column>
            <column caption='Select GMV Trend' datatype='string' name='[Parameter 8]' param-domain-type='list' role='measure' type='nominal' value='&quot;Increasing GMV/day&quot;'>
              <calculation class='tableau' formula='&quot;Increasing GMV/day&quot;' />
            </column>
            <column caption='GMV/day threshold (%)' datatype='real' name='[Parameter 9]' param-domain-type='any' role='measure' type='quantitative' value='20.'>
              <calculation class='tableau' formula='20.' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0vlutid1t3dqjf1akvmoa1ir3tok'>
            <column datatype='string' name='[Account_Name]' role='dimension' type='nominal' />
            <column caption='Merchant Count' datatype='integer' name='[Calculation_2188679115441467398]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd([Merchant_id])' />
            </column>
            <column aggregation='Sum' caption='Latest Date Filter' datatype='integer' name='[Calculation_2255529422435676162]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if [order_date]=[Calculation_4504866313510965252] then 1 else 0 end' />
            </column>
            <column caption='Rolling Current TP Start Date' datatype='datetime' name='[Calculation_2255529422436327427]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEADD(&apos;day&apos;,(-1*[Parameters].[Parameter 6])+1, [Calculation_4504866313510965252])' />
            </column>
            <column caption='Current TP GMV/Day' datatype='real' name='[Calculation_2255529422436700164]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [Merchant_id]: &#10;    sum(if [order_date]&gt;=[Calculation_2255529422436327427]&#10;            and [order_date]&lt;=[Calculation_4504866313510965252] then [Sales] end)&#10;    /&#10;    COUNTD(if [order_date]&gt;=[Calculation_2255529422436327427]&#10;            and [order_date]&lt;=[Calculation_4504866313510965252] then [order_date] end)&#10;&#10;}' />
            </column>
            <column caption='Change % in GMV/day' datatype='real' name='[Calculation_2255529422437830662]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_2255529422436700164] - [Current TP GMV/Day (copy)_2255529422437314565])/[Current TP GMV/Day (copy)_2255529422437314565]' />
            </column>
            <column aggregation='Sum' caption='Increase GMV/day Alert flag' datatype='integer' name='[Calculation_2255529422438006791]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if [Calculation_2255529422437830662]*100 &gt;=[Parameters].[Parameter 9] then 1 else 0 end' />
            </column>
            <column aggregation='Sum' caption='Trend Alert Flag' datatype='integer' name='[Calculation_2255529422489563167]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 8]=&apos;Increasing GMV/day&apos; then [Calculation_2255529422438006791]&#10;ELSEIF [Parameters].[Parameter 8]=&apos;Decreasing GMV/day&apos; then [Increase GMV/day Alert flag (copy)_2255529422443802635]&#10;elseif [Parameters].[Parameter 8]=&apos;Stable GMV/day&apos; then [Increase GMV/day Alert flag (copy)_2255529422502236196]&#10;end' />
            </column>
            <column caption='Max Date (overall)' datatype='date' name='[Calculation_4504866313510965252]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='{fixed [Calculation_4504866313511186437]: max([order_date])}' />
            </column>
            <column caption='dummy' datatype='integer' name='[Calculation_4504866313511186437]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='total(countd([Merchant_id]))' datatype='integer' name='[Calculation_6432688430829363209]' role='measure' type='quantitative' user:unnamed='No GMV merchants - Australia'>
              <calculation class='tableau' formula='total(countd([Merchant_id]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Change % in GMV/day (agg)' datatype='real' name='[Change % in GMV/day (copy)_2255529422441394185]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([Calculation_2255529422436700164]) - sum([Current TP GMV/Day (copy)_2255529422437314565]))/sum([Current TP GMV/Day (copy)_2255529422437314565])' />
            </column>
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Compare TP GMV/Day ' datatype='real' name='[Current TP GMV/Day (copy)_2255529422437314565]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [Merchant_id]: &#10;    sum(if [order_date]&gt;=[Rolling 30 days start date (copy)_2188679115435958273]&#10;            and [order_date]&lt;=[Rolling 30 days end date (copy)_2188679115435945984] then [Sales] end)&#10;    /&#10;    countd(if [order_date]&gt;=[Rolling 30 days start date (copy)_2188679115435958273]&#10;            and [order_date]&lt;=[Rolling 30 days end date (copy)_2188679115435945984] then [order_date] end)&#10;&#10;}' />
