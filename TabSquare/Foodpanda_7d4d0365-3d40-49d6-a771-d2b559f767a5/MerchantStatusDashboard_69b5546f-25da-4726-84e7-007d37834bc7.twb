    <worksheet name='No GMV merchants'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>List of Merchants </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tabsquare_dw_skipque_prod' name='federated.0vlutid1t3dqjf1akvmoa1ir3tok' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Current Time Period (Last n days)' datatype='integer' name='[Parameter 6]' param-domain-type='any' role='measure' type='quantitative' value='7'>
              <calculation class='tableau' formula='7' />
            </column>
            <column caption='Compare Time Period (days prior current)' datatype='integer' name='[Parameter 7]' param-domain-type='any' role='measure' type='quantitative' value='30'>
              <calculation class='tableau' formula='30' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0vlutid1t3dqjf1akvmoa1ir3tok'>
            <column datatype='string' name='[Account_Name]' role='dimension' type='nominal' />
            <column caption='-1*[Rolling Compare TP GMV (for alert) ]' datatype='real' name='[Calculation_2188679115438014469]' role='measure' type='quantitative' user:unnamed='No GMV merchants - Australia (3)'>
              <calculation class='tableau' formula='-1*[Rolling 30 days GMV (for alert) (copy)_2188679115436302338]' />
            </column>
            <column caption='Max Date (overall)' datatype='date' name='[Calculation_4504866313510965252]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='{fixed [Calculation_4504866313511186437]: max([order_date])}' />
            </column>
            <column caption='dummy' datatype='integer' name='[Calculation_4504866313511186437]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='total(countd([Merchant_id]))' datatype='integer' name='[Calculation_6432688430829363209]' role='measure' type='quantitative' user:unnamed='No GMV merchants - Australia'>
              <calculation class='tableau' formula='total(countd([Merchant_id]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='string' name='[Chain_Name_in_system]' role='dimension' type='nominal' />
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[Merchant_id]' role='dimension' type='nominal' />
            <column caption='Max Order Date (merchant id) ' datatype='date' name='[Min Order Date (merchant id) (copy)_4504866313499725825]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{fixed [Merchant_id]: max([order_date])}' />
            </column>
            <column datatype='string' name='[Name_of_Account_Manager]' role='dimension' type='nominal' />
            <column aggregation='Sum' caption='No Activity alert flag (parametrized)' datatype='integer' name='[No Activity alert flag (copy)_2188679115436711940]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if DATEDIFF(&apos;day&apos;, [Min Order Date (merchant id) (copy)_4504866313499725825],[Calculation_4504866313510965252])+1&gt;[Parameters].[Parameter 6] &#10;and [Rolling 30 days activity flag (copy)_2188679115436503043]=1 then 1 else 0 end' />
            </column>
            <column datatype='string' name='[Order_Type]' role='dimension' type='nominal' />
            <column datatype='string' name='[Payment_Type]' role='dimension' type='nominal' />
            <column datatype='string' name='[Product_Type]' role='dimension' type='nominal' />
            <column datatype='string' name='[RestaurantName]' role='dimension' type='nominal' />
            <column caption='Rolling Compare TP GMV (for alert) ' datatype='real' name='[Rolling 30 days GMV (for alert) (copy)_2188679115436302338]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [order_date]&gt;= [Rolling 30 days start date (copy)_2188679115435958273] and [order_date]&lt;=[Rolling 30 days end date (copy)_2188679115435945984]&#10;then [Sales] end)' />
