            <column caption='Selected Metric (Eur)' datatype='real' name='[Selected Metric (copy)_2919458504952623117]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2 1]&#13;&#10;WHEN &quot;sales&quot; then sum([Calculation_65091120001449984])&#13;&#10;WHEN &quot;orders&quot; then sum([orders])&#10;when &quot;outlets&quot; then countd([Merchant_id])&#10;when &quot;ABV&quot; then sum([Calculation_65091120001449984])/sum([orders])&#10;when &quot;GMV/Outlet&quot; then sum([Calculation_65091120001449984])/COUNTD([Merchant_id])&#10;When &quot;Orders/Outlet&quot; then sum([orders])/COUNTD([Merchant_id])&#10;WHEN &quot;Paid GMV&quot; then sum([Calculation_2919458504953688082])&#10;WHEN &quot;Paid GMV %&quot; then sum([Calculation_2919458504953688082])/sum([Sales])&#13;&#10;END' />
