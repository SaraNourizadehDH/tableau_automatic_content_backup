      <column aggregation='User' caption='Change in Merchant Count' datatype='real' default-type='quantitative' layered='true' name='[Calculation_5746874649553756178]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='([Calculation_5746874649553522704]-[Current Merchant Count (copy)_5746874649553653777])/[Current Merchant Count (copy)_5746874649553653777]' />
