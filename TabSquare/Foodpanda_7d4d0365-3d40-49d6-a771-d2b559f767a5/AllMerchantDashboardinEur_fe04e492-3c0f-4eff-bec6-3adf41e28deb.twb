            <column _.fcp.RefreshableParameterRanges.true...default-value-field='[sqlproxy.1r78wjm1y5h91y17l60591mnomxx].[Calculation_5717953095685943300]' _.fcp.RefreshableParameterRanges.true...source-field='[sqlproxy.1r78wjm1y5h91y17l60591mnomxx].[order_date]' caption='End Date' datatype='date' default-format='*dd-mm-yyyy' name='[Start Date (copy)_5685161260887789568]' param-domain-type='range' role='measure' type='quantitative' value='#2023-07-18#'>
