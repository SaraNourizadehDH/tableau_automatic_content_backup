              <calculation class='tableau' formula='(&#10;sum([Calculation_691513652414824459])&#10;- &#10;sum(ifnull([Calculation_691513652418912270],0))&#10;)&#10;/&#10;(&#10;sum([Total Sales (merchant_id, date) (copy)_691513652414963724])&#10;)&#10;//sum([Total Order count (merchant_id, date, customer_types) ])' />
            </column>
            <column caption='No AI Check Size (for imputation)' datatype='real' name='[Calculation_691513652698431523]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/*&#10;{fixed [Merchant Id], [Date (sgt_datetime)]:&#10;sum(if [For you accepted flag (order_id)]&lt;=0 then [Conversion Factor]*[Sales] end)&#10;/&#10;countd(if [For you accepted flag (order_id)]&lt;=0 then [Order Id Mod] end)&#10;}&#10;&#10;[For You Accepted Check Size (merchant_id, date, customer types)] -&#10;0.25*[For You Accepted Check Size (merchant_id, date, customer types)]&#10;*/&#10;&#10;{fixed [merchant_id], [Calculation_691513652405370884], [customer_type], [global_repeat_type], [repeat_type]:&#10;sum(if [for_you_flag]=0 then [Calculation_1229764177101324296]*[sales] end)&#10;/&#10;countd(if [for_you_flag]=0 then [order_id_mod] end)&#10;}' />
            </column>
            <column caption='For You $ Incremental per Order over No AI' datatype='real' name='[For You $ Incremental per Order (copy)_691513652787126312]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(ifnull([Calculation_691513652418912270],0))&#10;/&#10;countd([order_id_mod])&#10;/&#10;[Calculation_691513652420358159]' />
            </column>
            <column caption='For You Accepted Sales (merchant_id, date, customer_type, repeat types)' datatype='real' name='[For You Accepted Order count (copy)_691513652406308870]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [merchant_id], [Calculation_691513652405370884], [customer_type], [global_repeat_type], [repeat_type]:&#10;sum(if [Calculation_691513652404211713]&gt;0 then [Calculation_1229764177101324296]*[sales] end)}' />
            </column>
            <column caption='Merchant Name (copy)' datatype='string' name='[Merchant Name (copy)_691513652422705172]' role='dimension' type='nominal'>
