      <aliases enabled='yes' />
      <column caption='% Change in incremental over Non AI' datatype='real' name='[% Change in Acceptance Rate (copy)_5296936859885768716]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='( [For You $ Incremental per Order (copy)_691513652787126312] &#10;- LOOKUP([For You $ Incremental per Order (copy)_691513652787126312],-1))&#10;/&#10;LOOKUP([For You $ Incremental per Order (copy)_691513652787126312],-1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.06uwwzn1yrn2zb11pzj2w1h8x1q1].[usr:Calculation_691513652420358159:qk]&quot;' value='No Ai Check size ' />
          <alias key='&quot;[federated.06uwwzn1yrn2zb11pzj2w1h8x1q1].[usr:Calculation_691513652420575248:qk]&quot;' value='For You Check size ' />
        </aliases>
      </column>
      <column caption='Conversion Factor (mod)' datatype='real' name='[Calculation_1229764177101324296]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1]=&apos;SGD&apos; then [conversion_factor]&#10;else 1 end' />
      </column>
      <column caption='Response Order count' datatype='integer' name='[Calculation_1229764177151090700]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(if [for_you_response_flag]=1 then [order_id_mod] end)' />
      </column>
      <column caption='Global Repeat Types' datatype='string' name='[Calculation_1490410050634031104]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [customer_type]= &quot;login&quot; then [global_repeat_type] ELSE &quot;guest&quot; END' />
      </column>
      <column caption='cust Count' datatype='integer' name='[Calculation_1672524316021227524]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='COUNTD([customer_id])' />
      </column>
      <column caption='Order Count' datatype='string' datatype-customized='true' name='[Calculation_1672524316021305349]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(COUNTD([order_id_mod]))' />
      </column>
      <column caption='% Change in Acceptance Rate' datatype='real' name='[Calculation_5296936859883020294]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='( [Calculation_691513652425011221] - LOOKUP([Calculation_691513652425011221],-1))&#10;/&#10;LOOKUP([Calculation_691513652425011221],-1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Latest week flag' datatype='integer' name='[Calculation_5296936859893846039]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if &#10;datediff(&apos;day&apos;, DATETRUNC(&apos;week&apos;, [Calculation_691513652405370884]),&#10;{fixed [Calculation_5296936859894136856]: DATETRUNC(&apos;week&apos;, max([Calculation_691513652405370884]))})&#10;=0&#10;then 1 else 0 end' />
      </column>
      <column caption='dummy' datatype='integer' name='[Calculation_5296936859894136856]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Latest week Acceptance Rate (week)' datatype='real' name='[Calculation_5296936859894255641]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if max([Calculation_5296936859893846039]) = 1 &#10;    then &#10;[Calculation_691513652425011221] end' />
      </column>
      <column caption='Top Acceptance Rate Filter' datatype='integer' name='[Calculation_5296936859928997972]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if RANK_DENSE([Calculation_691513652425011221], &apos;desc&apos;) &lt;=[Parameters].[Bottom N (copy)_5296936859915354183] then 1 else 0 end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='eCMS/CMS' datatype='string' name='[Calculation_5449637084946477056]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if CONTAINS([merchant_id],&apos;HQ&apos;) then &apos;eCMS&apos;&#10;else &apos;CMS&apos;&#10;end' />
      </column>
      <column caption='For you accepted flag (order_id)' datatype='integer' name='[Calculation_691513652404211713]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [order_id_mod]: max([for_you_flag])}' />
      </column>
      <column caption='Date (sgt_datetime)' datatype='date' name='[Calculation_691513652405370884]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='date([sgt_datetime])' />
      </column>
      <column caption='For You Accepted Order count (merchant_id, date, customer_type, repeat types)' datatype='integer' name='[Calculation_691513652405432325]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [merchant_id], [Calculation_691513652405370884], [customer_type], [global_repeat_type], [repeat_type]:&#10;countd(if [Calculation_691513652404211713]&gt;0 then [order_id_mod] end)}' />
      </column>
      <column caption='For You Accepted Check Size (merchant_id, date, customer types)' datatype='real' name='[Calculation_691513652406591495]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[For You Accepted Order count (copy)_691513652406308870]/[Calculation_691513652405432325]' />
      </column>
      <column caption='No AI Order Count (merchant_id, date, customer_types)' datatype='integer' name='[Calculation_691513652409069576]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [merchant_id], [Calculation_691513652405370884], [customer_type], [global_repeat_type], [repeat_type]:&#10;countd(if [Calculation_691513652404211713]&lt;=0 then [order_id_mod] end)}' />
      </column>
      <column caption='No AI Check Size (merchant_id, date, customer_types)' datatype='real' name='[Calculation_691513652409458698]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[No AI Order Count (merchant_id, date) (copy)_691513652409319433]/[Calculation_691513652409069576]' />
      </column>
      <column caption='Total Sales (merchant_id, date, customer_types)' datatype='real' name='[Calculation_691513652414824459]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [merchant_id], [Calculation_691513652405370884], [customer_type], [global_repeat_type], [repeat_type]:&#10;sum([sales]*[Calculation_1229764177101324296])}' />
      </column>
      <column caption='for You $ incremental (merchant_id, date)' datatype='real' name='[Calculation_691513652418912270]' role='measure' type='quantitative'>
