    <worksheet name='# % incremental over non AI'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontsize='12'>% Increase in Revenue from For You</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (tabsquare_dw_ai_measurement)' name='federated.06uwwzn1yrn2zb11pzj2w1h8x1q1' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency Conversion' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Local&quot;'>
              <calculation class='tableau' formula='&quot;Local&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.06uwwzn1yrn2zb11pzj2w1h8x1q1'>
            <column caption='Conversion Factor (mod)' datatype='real' name='[Calculation_1229764177101324296]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1]=&apos;SGD&apos; then [conversion_factor]&#10;else 1 end' />
            </column>
            <column caption='For you accepted flag (order_id)' datatype='integer' name='[Calculation_691513652404211713]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [order_id_mod]: max([for_you_flag])}' />
            </column>
            <column caption='Date (sgt_datetime)' datatype='date' name='[Calculation_691513652405370884]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='date([sgt_datetime])' />
            </column>
            <column caption='For You Accepted Order count (merchant_id, date, customer_type, repeat types)' datatype='integer' name='[Calculation_691513652405432325]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [merchant_id], [Calculation_691513652405370884], [customer_type], [global_repeat_type], [repeat_type]:&#10;countd(if [Calculation_691513652404211713]&gt;0 then [order_id_mod] end)}' />
            </column>
            <column caption='For You Accepted Check Size (merchant_id, date, customer types)' datatype='real' name='[Calculation_691513652406591495]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[For You Accepted Order count (copy)_691513652406308870]/[Calculation_691513652405432325]' />
            </column>
            <column caption='No AI Order Count (merchant_id, date, customer_types)' datatype='integer' name='[Calculation_691513652409069576]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [merchant_id], [Calculation_691513652405370884], [customer_type], [global_repeat_type], [repeat_type]:&#10;countd(if [Calculation_691513652404211713]&lt;=0 then [order_id_mod] end)}' />
            </column>
            <column caption='No AI Check Size (merchant_id, date, customer_types)' datatype='real' name='[Calculation_691513652409458698]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[No AI Order Count (merchant_id, date) (copy)_691513652409319433]/[Calculation_691513652409069576]' />
            </column>
            <column caption='Total Sales (merchant_id, date, customer_types)' datatype='real' name='[Calculation_691513652414824459]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [merchant_id], [Calculation_691513652405370884], [customer_type], [global_repeat_type], [repeat_type]:&#10;sum([sales]*[Calculation_1229764177101324296])}' />
            </column>
            <column caption='for You $ incremental (merchant_id, date)' datatype='real' name='[Calculation_691513652418912270]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;ifnull([Calculation_691513652406591495],0)&#10;-&#10;ifnull([Calculation_691513652409458698],[Calculation_691513652698431523])&#10;)&#10;*&#10;ifnull([Calculation_691513652405432325],0)' />
            </column>
            <column caption='No Ai Check size (backcalc)' datatype='real' name='[Calculation_691513652420358159]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;sum([Calculation_691513652414824459])&#10;- &#10;sum(ifnull([Calculation_691513652418912270],0))&#10;)&#10;/&#10;(&#10;sum([Total Sales (merchant_id, date) (copy)_691513652414963724])&#10;)&#10;//sum([Total Order count (merchant_id, date, customer_types) ])' />
            </column>
            <column caption='No AI Check Size (for imputation)' datatype='real' name='[Calculation_691513652698431523]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/*&#10;{fixed [Merchant Id], [Date (sgt_datetime)]:&#10;sum(if [For you accepted flag (order_id)]&lt;=0 then [Conversion Factor]*[Sales] end)&#10;/&#10;countd(if [For you accepted flag (order_id)]&lt;=0 then [Order Id Mod] end)&#10;}&#10;&#10;[For You Accepted Check Size (merchant_id, date, customer types)] -&#10;0.25*[For You Accepted Check Size (merchant_id, date, customer types)]&#10;*/&#10;&#10;{fixed [merchant_id], [Calculation_691513652405370884], [customer_type], [global_repeat_type], [repeat_type]:&#10;sum(if [for_you_flag]=0 then [Calculation_1229764177101324296]*[sales] end)&#10;/&#10;countd(if [for_you_flag]=0 then [order_id_mod] end)&#10;}' />
            </column>
            <column caption='For You $ Incremental per Order over No AI' datatype='real' name='[For You $ Incremental per Order (copy)_691513652787126312]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(ifnull([Calculation_691513652418912270],0))&#10;/&#10;countd([order_id_mod])&#10;/&#10;[Calculation_691513652420358159]' />
            </column>
            <column caption='For You Accepted Sales (merchant_id, date, customer_type, repeat types)' datatype='real' name='[For You Accepted Order count (copy)_691513652406308870]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [merchant_id], [Calculation_691513652405370884], [customer_type], [global_repeat_type], [repeat_type]:&#10;sum(if [Calculation_691513652404211713]&gt;0 then [Calculation_1229764177101324296]*[sales] end)}' />
            </column>
            <column caption='Merchant Name (copy)' datatype='string' name='[Merchant Name (copy)_691513652422705172]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[merchant_name]' />
            </column>
            <column caption='No AI Sales (merchant_id, date, customer_types) ' datatype='real' name='[No AI Order Count (merchant_id, date) (copy)_691513652409319433]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [merchant_id], [Calculation_691513652405370884], [customer_type], [global_repeat_type],[repeat_type]:&#10;sum(if [Calculation_691513652404211713]&lt;=0 then [Calculation_1229764177101324296]*[sales] end)}' />
            </column>
            <column caption='Total Order count (merchant_id, date, customer_types) ' datatype='integer' name='[Total Sales (merchant_id, date) (copy)_691513652414963724]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [merchant_id], [Calculation_691513652405370884], [customer_type], [global_repeat_type], [repeat_type]:&#10;countd([order_id_mod])}' />
            </column>
            <column caption='Conversion Factor' datatype='real' name='[conversion_factor]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Customer Type' datatype='string' name='[customer_type]' role='dimension' type='nominal' />
            <column aggregation='Sum' caption='For You Flag' datatype='integer' name='[for_you_flag]' role='dimension' type='ordinal' />
            <column caption='Global Repeat Type' datatype='string' name='[global_repeat_type]' role='dimension' type='nominal' />
            <column-instance column='[Set 1]' derivation='InOut' name='[io:Set 1:nk]' pivot='key' type='nominal' />
            <column caption='Menu Mode' datatype='string' name='[menu_mode]' role='dimension' type='nominal' />
            <column caption='Merchant Id' datatype='string' name='[merchant_id]' role='dimension' type='nominal' />
            <column caption='Merchant Name' datatype='string' name='[merchant_name]' role='dimension' type='nominal' />
            <column-instance column='[sgt_datetime]' derivation='MY' name='[my:sgt_datetime:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Merchant Name (copy)_691513652422705172]' derivation='None' name='[none:Merchant Name (copy)_691513652422705172:nk]' pivot='key' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column-instance column='[customer_type]' derivation='None' name='[none:customer_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[menu_mode]' derivation='None' name='[none:menu_mode:nk]' pivot='key' type='nominal' />
            <column-instance column='[merchant_id]' derivation='None' name='[none:merchant_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[merchant_name]' derivation='None' name='[none:merchant_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[organization_id]' derivation='None' name='[none:organization_id:ok]' pivot='key' type='ordinal' />
            <column caption='Order Id Mod' datatype='string' name='[order_id_mod]' role='dimension' type='nominal' />
            <column caption='Organization Id' datatype='integer' name='[organization_id]' role='dimension' type='ordinal' />
            <column caption='Repeat Type' datatype='string' name='[repeat_type]' role='dimension' type='nominal' />
            <column caption='Sales' datatype='real' name='[sales]' role='measure' type='quantitative' />
            <column caption='Sgt Datetime' datatype='datetime' name='[sgt_datetime]' role='dimension' type='ordinal' />
            <column-instance column='[For You $ Incremental per Order (copy)_691513652787126312]' derivation='User' name='[usr:For You $ Incremental per Order (copy)_691513652787126312:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
