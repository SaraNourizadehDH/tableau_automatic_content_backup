              <calculation class='tableau' formula='(&#10;ifnull([Calculation_691513652406591495],0)&#10;-&#10;ifnull([Calculation_691513652409458698],[Calculation_691513652698431523])&#10;)&#10;*&#10;ifnull([Calculation_691513652405432325],0)' />
            </column>
