      </column>
      <column caption='Conversion Factor (mod)' datatype='real' name='[Calculation_1229764177101324296]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1]=&apos;SGD&apos; then [conversion_factor]&#10;else 1 end' />
      </column>
      <column caption='eCMS/CMS' datatype='string' name='[Calculation_1394004867119468545]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if CONTAINS([merchant_id], &apos;HQ&apos;) then &apos;eCMS&apos; else &apos;CMS&apos; end' />
      </column>
      <column caption='Reco accepted flag (order_id)' datatype='integer' name='[Calculation_691513652404211713]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [order_id_mod]: max([reco_flag])}' />
      </column>
      <column caption='Date (sgt_datetime)' datatype='date' name='[Calculation_691513652405370884]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='date([sgt_datetime])' />
      </column>
      <column caption='Reco Accepted Order count (merchant_id, date, customer_type, repeat types)' datatype='integer' name='[Calculation_691513652405432325]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [merchant_id], [Calculation_691513652405370884], [customer_type], [global_repeat_type], [repeat_type]:&#10;countd(if [Calculation_691513652404211713]&gt;0 then [order_id_mod] end)}' />
      </column>
      <column caption='Reco Accepted Check Size (merchant_id, date, customer types)' datatype='real' name='[Calculation_691513652406591495]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[For You Accepted Order count (copy)_691513652406308870]/[Calculation_691513652405432325]' />
      </column>
      <column caption='No AI Order Count (merchant_id, date, customer_types)' datatype='integer' name='[Calculation_691513652409069576]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [merchant_id], [Calculation_691513652405370884], [customer_type], [global_repeat_type], [repeat_type]:&#10;countd(if [Calculation_691513652404211713]&lt;=0 then [order_id_mod] end)}' />
      </column>
      <column caption='No AI Check Size (merchant_id, date, customer_types)' datatype='real' name='[Calculation_691513652409458698]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[No AI Order Count (merchant_id, date) (copy)_691513652409319433]/[Calculation_691513652409069576]' />
      </column>
      <column caption='Total Sales (merchant_id, date, customer_types)' datatype='real' name='[Calculation_691513652414824459]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [merchant_id], [Calculation_691513652405370884], [customer_type], [global_repeat_type], [repeat_type]:&#10;sum([sales]*[Calculation_1229764177101324296])}' />
      </column>
      <column caption='Reco $ incremental (merchant_id, date)' datatype='real' name='[Calculation_691513652418912270]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;ifnull([Calculation_691513652406591495],0)&#10;-&#10;ifnull([Calculation_691513652409458698],[Calculation_691513652698431523])&#10;)&#10;*&#10;ifnull([Calculation_691513652405432325],0)' />
      </column>
      <column caption='No Ai Check size (backcalc)' datatype='real' name='[Calculation_691513652420358159]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;sum([Calculation_691513652414824459])&#10;- &#10;sum(ifnull([Calculation_691513652418912270],0))&#10;)&#10;/&#10;(&#10;sum([Total Sales (merchant_id, date) (copy)_691513652414963724])&#10;)&#10;//sum([Total Order count (merchant_id, date, customer_types) ])' />
      </column>
      <column caption='Reco Check size (backcalc)' datatype='real' name='[Calculation_691513652420575248]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;sum(ifnull([Calculation_691513652418912270],0))&#10;/&#10;sum(ifnull([Calculation_691513652405432325],0))&#10;)&#10;+&#10;ifnull([Calculation_691513652420358159],0)' />
      </column>
      <column caption='% Incremental Check size (backcalc)' datatype='real' name='[Calculation_691513652421017617]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;[Calculation_691513652420575248] &#10;- &#10;[Calculation_691513652420358159]&#10;)&#10;/&#10;[Calculation_691513652420358159]' />
      </column>
      <column caption='Reco Acceptance Rate' datatype='real' name='[Calculation_691513652425011221]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(ifnull([Calculation_691513652405432325],0))&#10;/&#10;countd([order_id_mod])' />
      </column>
      <column caption='Overall Check Size' datatype='real' name='[Calculation_691513652435677212]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(ifnull([Calculation_1229764177101324296]*[sales],0))/countd([order_id_mod])' />
      </column>
      <column caption='No AI Check Size (for imputation)' datatype='real' name='[Calculation_691513652698431523]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='/*&#10;{fixed [Merchant Id], [Date (sgt_datetime)]:&#10;sum(if [For you accepted flag (order_id)]&lt;=0 then [Conversion Factor]*[Sales] end)&#10;/&#10;countd(if [For you accepted flag (order_id)]&lt;=0 then [Order Id Mod] end)&#10;}&#10;&#10;[For You Accepted Check Size (merchant_id, date, customer types)] -&#10;0.25*[For You Accepted Check Size (merchant_id, date, customer types)]&#10;*/&#10;&#10;{fixed [merchant_id], [Calculation_691513652405370884], [customer_type], [global_repeat_type], [repeat_type]:&#10;sum(if [reco_flag]=0 then [Calculation_1229764177101324296]*[sales] end)&#10;/&#10;countd(if [reco_flag]=0 then [order_id_mod] end)&#10;}' />
      </column>
      <column caption='Reco $ Incremental per Order' datatype='real' name='[Calculation_691513652786266151]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(ifnull([Calculation_691513652418912270],0))&#10;/&#10;countd([order_id_mod])' />
      </column>
      <column caption='Reco $ Incremental per Order over No AI' datatype='real' name='[For You $ Incremental per Order (copy)_691513652787126312]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(ifnull([Calculation_691513652418912270],0))&#10;/&#10;countd([order_id_mod])&#10;/&#10;[Calculation_691513652420358159]' />
      </column>
      <column caption='Reco Accepted Sales (merchant_id, date, customer_type, repeat types)' datatype='real' name='[For You Accepted Order count (copy)_691513652406308870]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [merchant_id], [Calculation_691513652405370884], [customer_type], [global_repeat_type], [repeat_type]:&#10;sum(if [Calculation_691513652404211713]&gt;0 then [Calculation_1229764177101324296]*[sales] end)}' />
