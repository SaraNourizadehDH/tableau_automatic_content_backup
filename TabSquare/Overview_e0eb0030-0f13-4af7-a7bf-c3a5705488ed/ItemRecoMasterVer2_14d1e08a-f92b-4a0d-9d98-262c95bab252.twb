            <column caption='Menu Mode' datatype='string' name='[menu_mode]' role='dimension' type='nominal' />
            <column caption='Merchant Id' datatype='string' name='[merchant_id]' role='dimension' type='nominal' />
            <column caption='Merchant Name' datatype='string' name='[merchant_name]' role='dimension' type='nominal' />
