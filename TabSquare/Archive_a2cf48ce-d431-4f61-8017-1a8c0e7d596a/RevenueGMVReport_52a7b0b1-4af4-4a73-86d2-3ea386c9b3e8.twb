      <aliases enabled='yes' />
      <column caption='Account Name' datatype='string' name='[Account_Name]' role='dimension' type='nominal' />
      <column caption='Month to remove from filters' datatype='string' name='[Calculation_112167841788567552]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[month_date]' />
      </column>
      <column caption='Total Recurring Revenue' datatype='real' name='[Calculation_178877408784859136]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[recurring_revenue_acc]+[deferred_revenue_acc]' />
      </column>
      <column caption='Stripe Cost' datatype='real' name='[Calculation_178877408789209089]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Country] when &apos;Australia&apos; THEN 0.013*[stripe_revenue_und_15_acc] + 0.05*[stripe_orders_und_15_acc] + 0.01*([stripe_revenue_acc] - [stripe_revenue_und_15_acc]) + 0.10*([stripe_orders_acc]-[stripe_orders_und_15_acc]) &#10;      when &apos;Singapore&apos; THEN 0.018*[stripe_revenue_und_15_acc] + 0.07*[stripe_orders_und_15_acc] + 0.017*([stripe_revenue_acc] - [stripe_revenue_und_15_acc]) + 0.07*([stripe_orders_acc]-[stripe_orders_und_15_acc])&#10;     when &apos;Malaysia&apos; THEN (0.015*[stripe_revenue_acc] + 0.10*0.33 *[stripe_orders_acc])&#10;END' />
      </column>
      <column caption='Take Rate' datatype='real' name='[Calculation_178877408789430274]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([converted_revenue_acc])/sum([gmv_acc])' />
      </column>
      <column caption='Act Cal Rev' datatype='real' name='[Calculation_198862133240872961]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_62909719436935177] - [Calculation_62909719462752268]' />
      </column>
      <column caption='Sum of Cal GMV' datatype='real' name='[Calculation_212021088417067008]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cal_gmv])' />
      </column>
      <column caption='Sum of QB GMV' datatype='real' name='[Calculation_212021088417169409]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gmv_acc])' />
      </column>
      <column caption='GMV Diff' datatype='real' name='[Calculation_212021088417259522]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_212021088417169409] - [Calculation_212021088417067008]' />
      </column>
      <column caption='Sum of Converted Rev Acc' datatype='real' hidden='true' name='[Calculation_62909719432130567]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([converted_revenue_acc])' />
      </column>
      <column caption='Sum Cal Tot Rev Conv' datatype='real' hidden='true' name='[Calculation_62909719436935177]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cal_total_revenue_Converted])' />
      </column>
      <column caption='Revenue Difference ' datatype='real' name='[Calculation_62909719437701130]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_62909719432130567] - [Calculation_62909719436935177]' />
      </column>
      <column caption='Actual Revenue' datatype='real' name='[Calculation_62909719461068811]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_62909719432130567] - [Calculation_62909719462752268]' />
      </column>
      <column caption='Sum of Stripe Cost' datatype='real' name='[Calculation_62909719462752268]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_178877408789209089])' />
      </column>
