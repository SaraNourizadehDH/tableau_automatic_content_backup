            <column caption='Stripe Orders Und 15 Acc' datatype='real' name='[stripe_orders_und_15_acc]' role='measure' type='quantitative' />
            <column caption='QB Stripe Revenue ' datatype='real' name='[stripe_revenue_acc]' role='measure' type='quantitative' />
            <column caption='Stripe Revenue Und 15 Acc' datatype='real' name='[stripe_revenue_und_15_acc]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_178877408784859136]' derivation='Sum' name='[sum:Calculation_178877408784859136:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_178877408789209089]' derivation='Sum' name='[sum:Calculation_178877408789209089:qk]' pivot='key' type='quantitative' />
