          </datasource-dependencies>
          <filter class='categorical' column='[federated.1sc5lza1rl0ym618s77r618t87u8].[:Measure Names]'>
            <groupfilter function='union' user:op='manual'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1sc5lza1rl0ym618s77r618t87u8].[sum:gmv_acc:qk]&quot;' />
