    <worksheet name='Distribution of GMV/Revenue BY Account Names'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontname='Tableau Bold' fontsize='16'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sheet1 (revenue)' name='federated.1sc5lza1rl0ym618s77r618t87u8' />
          </datasources>
          <datasource-dependencies datasource='federated.1sc5lza1rl0ym618s77r618t87u8'>
            <column caption='Account Name' datatype='string' name='[Account_Name]' role='dimension' type='nominal' />
            <column caption='Total Recurring Revenue' datatype='real' name='[Calculation_178877408784859136]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[recurring_revenue_acc]+[deferred_revenue_acc]' />
            </column>
            <column caption='Stripe Cost' datatype='real' name='[Calculation_178877408789209089]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Country] when &apos;Australia&apos; THEN 0.013*[stripe_revenue_und_15_acc] + 0.05*[stripe_orders_und_15_acc] + 0.01*([stripe_revenue_acc] - [stripe_revenue_und_15_acc]) + 0.10*([stripe_orders_acc]-[stripe_orders_und_15_acc]) &#10;      when &apos;Singapore&apos; THEN 0.018*[stripe_revenue_und_15_acc] + 0.07*[stripe_orders_und_15_acc] + 0.017*([stripe_revenue_acc] - [stripe_revenue_und_15_acc]) + 0.07*([stripe_orders_acc]-[stripe_orders_und_15_acc])&#10;     when &apos;Malaysia&apos; THEN (0.015*[stripe_revenue_acc] + 0.10*0.33 *[stripe_orders_acc])&#10;END' />
            </column>
            <column caption='Take Rate' datatype='real' name='[Calculation_178877408789430274]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([converted_revenue_acc])/sum([gmv_acc])' />
            </column>
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Total Revenue (Minus Stripe Cost)' datatype='real' name='[Total Revenue (copy)_818669971699339264]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[converted_revenue_acc] - IFNULL([Calculation_178877408789209089],0)' />
            </column>
            <column caption='Total Revenue' datatype='real' name='[converted_revenue_acc]' role='measure' type='quantitative' />
            <column caption='QB Deferred Revenue ' datatype='real' name='[deferred_revenue_acc]' role='measure' type='quantitative' />
            <column caption='GMV' datatype='real' name='[gmv_acc]' role='measure' type='ordinal' />
            <column caption='Merchant Id' datatype='string' name='[merchant_id]' role='dimension' type='nominal' />
            <column caption='Month Date' datatype='string' name='[month_date]' role='dimension' type='nominal' />
            <column-instance column='[Account_Name]' derivation='None' name='[none:Account_Name:nk]' pivot='key' type='nominal' />
            <column-instance column='[Country]' derivation='None' name='[none:Country:nk]' pivot='key' type='nominal' />
            <column-instance column='[merchant_id]' derivation='None' name='[none:merchant_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[month_date]' derivation='None' name='[none:month_date:nk]' pivot='key' type='nominal' />
            <column-instance column='[qb_name]' derivation='None' name='[none:qb_name:nk]' pivot='key' type='nominal' />
