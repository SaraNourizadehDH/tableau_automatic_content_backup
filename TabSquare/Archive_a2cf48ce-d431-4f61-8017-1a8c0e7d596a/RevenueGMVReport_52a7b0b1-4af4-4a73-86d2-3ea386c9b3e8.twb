            <column caption='Stripe Cost' datatype='real' name='[Calculation_178877408789209089]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Country] when &apos;Australia&apos; THEN 0.013*[stripe_revenue_und_15_acc] + 0.05*[stripe_orders_und_15_acc] + 0.01*([stripe_revenue_acc] - [stripe_revenue_und_15_acc]) + 0.10*([stripe_orders_acc]-[stripe_orders_und_15_acc]) &#10;      when &apos;Singapore&apos; THEN 0.018*[stripe_revenue_und_15_acc] + 0.07*[stripe_orders_und_15_acc] + 0.017*([stripe_revenue_acc] - [stripe_revenue_und_15_acc]) + 0.07*([stripe_orders_acc]-[stripe_orders_und_15_acc])&#10;     when &apos;Malaysia&apos; THEN (0.015*[stripe_revenue_acc] + 0.10*0.33 *[stripe_orders_acc])&#10;END' />
            </column>
            <column caption='Sum of Converted Rev Acc' datatype='real' hidden='true' name='[Calculation_62909719432130567]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([converted_revenue_acc])' />
            </column>
            <column caption='Actual Revenue' datatype='real' name='[Calculation_62909719461068811]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_62909719432130567] - [Calculation_62909719462752268]' />
            </column>
            <column caption='Sum of Stripe Cost' datatype='real' name='[Calculation_62909719462752268]' role='measure' type='quantitative'>
