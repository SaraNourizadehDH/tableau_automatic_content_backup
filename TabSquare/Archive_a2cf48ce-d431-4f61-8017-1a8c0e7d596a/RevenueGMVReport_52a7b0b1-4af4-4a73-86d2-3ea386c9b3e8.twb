            <column caption='QB Recurring Revenue ' datatype='real' name='[recurring_revenue_acc]' role='measure' type='quantitative' />
            <column caption='Source Company' datatype='string' name='[source_company]' role='dimension' type='nominal' />
            <column caption='Stripe Orders Acc' datatype='real' name='[stripe_orders_acc]' role='measure' type='quantitative' />
