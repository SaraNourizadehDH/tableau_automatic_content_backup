    <datasource caption='Custom SQL Query (skipque_cdc_data_prod)' inline='true' name='federated.1fbd1nj179gyqp16fs8at1uqecb7' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1wsnau306mq5mn179ixp71x2uhwd'>
            <connection CATALOG='tabsquare-data-sciences' EXECCATALOG='tabsquare-data-sciences' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='3' bq-large-fetch-rows='250000' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tabsquare-data-sciences' schema='skipque_cdc_data_prod' server-oauth='server-custom' username='data-team-tableau@tabsquare-data-sciences.iam.gserviceaccount.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <relation connection='bigquery.1wsnau306mq5mn179ixp71x2uhwd' name='Custom SQL Query' type='text'>SELECT distinct *&#10;from(&#10;WITH&#10;  usr AS (&#10;  SELECT&#10;    id AS restaurant_id,customer_key AS merchant_id,country&#10;  FROM&#10;    `tabsquare-data-sciences.skipque_cdc_data_prod.users`&#10;  UNION ALL&#10;  SELECT&#10;    id AS restaurant_id,merchant_key AS merchant_id,country&#10;  FROM&#10;    `tabsquare-data-sciences.skipque_cdc_data_prod.organization` ),&#10;    merch_totl_tab as (&#10;Select merchant_id,STRING_AGG(menu_mode,&quot;,&quot;) as menu_mode from `tabsquare-data-sciences.dashboard_validation_data.merchant_total_tables`&#10;group by 1)&#10;select a.*,b.*,&#10;(a.orders - b.d_orders) as order_difference,&#10;(a.sales - b.d_sales) as sales_difference  from &#10; ((SELECT&#10;  u.merchant_id AS merchant_id,&#10;  EXTRACT(DATE&#10;  FROM&#10;    DATETIME_ADD(op.created_date,&#10;      INTERVAL&#10;      CASE&#10;        WHEN u.country IN (&apos;Singapore&apos;, &apos;singapore&apos;, &apos;Malaysia&apos;, &apos;malaysia&apos;, &apos;Brunei&apos;, &apos;brunei&apos;, &apos;Hong Kong&apos;, &apos;HongKong&apos;, &apos;Hongkong&apos;, &apos;hongkong&apos;, &apos;Philippines&apos;, &apos;philippines&apos;) THEN 8&#10;        WHEN u.country IN (&apos;Australia&apos;,&apos;australia&apos;) THEN 11&#10;        WHEN u.country IN (&apos;Thailand&apos;, &apos;thailand&apos;, &apos;Indonesia&apos;, &apos;indonesia&apos;, &apos;Jakarta&apos;, &apos;jakarta&apos;) THEN 7&#10;        WHEN u.country IN (&apos;New Zealand&apos;,&apos;NewZealand&apos;,&apos;New zealand&apos;,&apos;Newzealand&apos;,&apos;new Zealand&apos;,&apos;newzealand&apos;) THEN 13&#10;      ELSE 0&#10;    END&#10;      HOUR)) AS order_date,&#10;  ROUND(SUM(COALESCE(o.order_amount,0)), 2) AS sales,&#10;  COUNT(DISTINCT o.id) AS orders&#10;FROM&#10;  `tabsquare-data-sciences.skipque_cdc_data_prod.orders` o&#10;INNER JOIN usr u ON o.restaurant_id = u.restaurant_id&#10;LEFT JOIN&#10;  `tabsquare-data-sciences.skipque_cdc_data_prod.order_payments` op&#10;ON  o.id = op.order_id&#10;WHERE&#10;  op.created_date &gt;&gt;= &apos;2022-09-30 00:00:0&apos; &#10;  AND o.app_type IN (3,4,5,10)&#10;  AND o.status NOT IN (-3,-4,0)&#10;  AND o.is_void = 0&#10;  AND op.status = 3&#10;GROUP BY 1,2&#10;ORDER BY 1,2)&#10;union all&#10;(SELECT case &#10;when merchant_id not like (&apos;HQ-%&apos;) then lower(merchant_id) else merchant_id end as merchant_id,date AS order_date,&#10;  ROUND(SUM(COALESCE(sales,0)), 2) AS sales,&#10;  COUNT(DISTINCT order_id) AS orders&#10;FROM `tabsquare-data-sciences.emenu_events.emenu_order_item` &#10;WHERE date &gt;&gt;= &apos;2022-09-30&apos; &#10;group by 1,2)) a&#10;LEFT OUTER JOIN &#10;(select mml.Account_Name, mml.Name_of_Account_Manager, mml.Team, mml.Country, mml.Chain_Name_in_system,dr.merchant_id as d_merchant_id,restaurantname as restaurant_name,mtt.menu_mode,date as d_order_date,&#10;sum(round(dr.sales,2)) over(partition by date,dr.merchant_id) as d_sales,sum(dr.orders) over(partition by date,dr.merchant_id) as d_orders &#10;from `tabsquare-data-sciences.dashboard_validation_data.daily_report` dr&#10;left join merch_totl_tab  mtt on LOWER(dr.merchant_id) = LOWER(mtt.merchant_id)&#10;left join `tabsquare-data-sciences.tabsquare_dw_lookups.master_merchant_list` mml&#10;on dr.merchant_id= mml.merchant_id&#10;where date &gt;&gt;= &apos;2022-09-30&apos; &#10;and dr.merchant_id not in (&apos;demoid0123&apos;,&apos;demoid4567&apos;,&apos;demoid8910&apos;)&#10;) b&#10;on LOWER(a.merchant_id) = LOWER(b.d_merchant_id)&#10;  and a.order_date = b.d_order_date) where order_date &gt;&gt;= &apos;2022-10-01&apos; and order_date &lt;&lt;=date_sub(current_date(),interval 2 day) order by order_date desc</relation>
