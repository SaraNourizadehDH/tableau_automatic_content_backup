    <worksheet name='Diff Mer'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (skipque_cdc_data_prod)' name='federated.1fbd1nj179gyqp16fs8at1uqecb7' />
          </datasources>
          <datasource-dependencies datasource='federated.1fbd1nj179gyqp16fs8at1uqecb7'>
            <column caption='Merchant With Order Differences' datatype='integer' name='[Calculation_1998753848842858499]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [Calculation_4294182281668026370]= &quot;Diff&quot; then [merchant_id] END)' />
            </column>
            <column caption='Order Differences' datatype='string' name='[Calculation_4294182281668026370]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [orders]= [d_orders] then &apos;No Diff&apos;&#13;&#10;ELSEIF [orders]&lt;&gt; [d_orders] then &apos;Diff&apos;&#13;&#10;ELSEIF [orders]&gt; [d_orders] then &apos;Diff&apos;&#13;&#10;ELSEIF [orders]&lt; [d_orders] then &apos;Diff&apos;&#13;&#10;END' />
            </column>
            <column datatype='integer' name='[d_orders]' role='measure' type='quantitative' />
            <column datatype='string' name='[merchant_id]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_4294182281668026370]' derivation='None' name='[none:Calculation_4294182281668026370:nk]' pivot='key' type='nominal' />
            <column datatype='integer' name='[orders]' role='measure' type='quantitative' />
            <column-instance column='[d_orders]' derivation='Sum' name='[sum:d_orders:qk]' pivot='key' type='quantitative' />
            <column-instance column='[orders]' derivation='Sum' name='[sum:orders:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1998753848842858499]' derivation='User' name='[usr:Calculation_1998753848842858499:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1fbd1nj179gyqp16fs8at1uqecb7].[none:Calculation_4294182281668026370:nk]'>
            <groupfilter function='member' level='[none:Calculation_4294182281668026370:nk]' member='&quot;Diff&quot;' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.1fbd1nj179gyqp16fs8at1uqecb7].[none:Calculation_4294182281668026370:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='text-align' field='[federated.1fbd1nj179gyqp16fs8at1uqecb7].[usr:Calculation_1998753848842858499:qk]' value='center' />
            <format attr='text-align' value='center' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
