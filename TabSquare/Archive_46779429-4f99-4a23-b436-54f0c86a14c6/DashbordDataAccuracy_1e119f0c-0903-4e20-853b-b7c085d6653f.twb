    <worksheet name='Sales Impact'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (skipque_cdc_data_prod)' name='federated.1fbd1nj179gyqp16fs8at1uqecb7' />
          </datasources>
          <datasource-dependencies datasource='federated.1fbd1nj179gyqp16fs8at1uqecb7'>
            <column caption='Total Sales Diff' datatype='real' name='[Calculation_1998753848853737478]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [Calculation_4294182281668026370]= &quot;Diff&quot; then [sales]END)' />
            </column>
            <column caption='Sales Impact' datatype='real' name='[Calculation_1998753848854093831]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1998753848853737478]/SUM([sales])' />
            </column>
            <column caption='Order Differences' datatype='string' name='[Calculation_4294182281668026370]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [orders]= [d_orders] then &apos;No Diff&apos;&#13;&#10;ELSEIF [orders]&lt;&gt; [d_orders] then &apos;Diff&apos;&#13;&#10;ELSEIF [orders]&gt; [d_orders] then &apos;Diff&apos;&#13;&#10;ELSEIF [orders]&lt; [d_orders] then &apos;Diff&apos;&#13;&#10;END' />
            </column>
            <column datatype='integer' name='[d_orders]' role='measure' type='quantitative' />
            <column datatype='integer' name='[orders]' role='measure' type='quantitative' />
            <column datatype='real' name='[sales]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1998753848854093831]' derivation='User' name='[usr:Calculation_1998753848854093831:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='text-format' field='[federated.1fbd1nj179gyqp16fs8at1uqecb7].[usr:Calculation_1998753848854093831:qk]' value='p0.00%' />
            <format attr='text-align' value='center' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <text column='[federated.1fbd1nj179gyqp16fs8at1uqecb7].[usr:Calculation_1998753848854093831:qk]' />
            </encodings>
            <customized-label>
              <formatted-text>
                <run bold='true' fontsize='24'>&lt;[federated.1fbd1nj179gyqp16fs8at1uqecb7].[usr:Calculation_1998753848854093831:qk]&gt;</run>
                <run bold='true' fontsize='24'>Æ&#10;</run>
              </formatted-text>
            </customized-label>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
