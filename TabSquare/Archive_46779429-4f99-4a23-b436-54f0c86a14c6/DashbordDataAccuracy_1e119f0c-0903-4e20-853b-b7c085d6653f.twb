      <aliases enabled='yes' />
      <column caption='Diverging Differences' datatype='integer' name='[Calculation_1998753848814243840]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_4294182281668026370]= &quot;Diff&quot; THEN - [d_orders] ELSE [d_orders] END' />
      </column>
      <column caption='Merchant With Order Differences' datatype='integer' name='[Calculation_1998753848842858499]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Calculation_4294182281668026370]= &quot;Diff&quot; then [merchant_id] END)' />
      </column>
      <column caption='Merchant With No Differences' datatype='integer' name='[Calculation_1998753848843091972]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Calculation_4294182281668026370]= &quot;No Diff&quot; then [merchant_id] END)' />
      </column>
      <column caption='Total Sales Diff' datatype='real' name='[Calculation_1998753848853737478]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [Calculation_4294182281668026370]= &quot;Diff&quot; then [sales]END)' />
      </column>
      <column caption='Sales Impact' datatype='real' name='[Calculation_1998753848854093831]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1998753848853737478]/SUM([sales])' />
      </column>
      <column caption='sales diff' datatype='real' name='[Calculation_1998753848854380552]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([sales])-[Calculation_1998753848853737478])/ [Calculation_1998753848853737478]' />
      </column>
      <column caption='Null Orders Merchant Count Dashboard' datatype='integer' name='[Calculation_1998753848855707657]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF ISNULL([d_orders]) THEN [merchant_id] END)' />
      </column>
      <column caption='Orders Against Dashbord Null Orders' datatype='integer' name='[Calculation_1998753848856485898]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF ISNULL([d_orders]) then [orders] END)' />
      </column>
      <column caption='fixed mer ord diff' datatype='integer' name='[Calculation_1998753848858677259]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [merchant_id]: sum([Calculation_4294182281663692800])}' />
      </column>
      <column caption='Diff Merchants' datatype='string' name='[Calculation_1998753848859164684]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [d_orders]&lt;&gt;[orders] THEN [merchant_id] END' />
      </column>
      <column caption='No Diff Merchant' datatype='string' name='[Calculation_1998753848859344909]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [merchant_id]&lt;&gt; [Calculation_1998753848859164684] then &apos;No Diff Merchant&apos; END' />
      </column>
      <column caption='Order Diff' datatype='integer' name='[Calculation_4294182281663692800]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='[d_orders]-[orders]' />
      </column>
      <column caption='Date Differences' datatype='string' name='[Calculation_4294182281665638401]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [d_order_date]= [order_date] then &apos;No Date Diff&apos;&#13;&#10;ELSEIF [d_order_date]&lt;&gt; [order_date] then &apos;Date Diff&apos;&#13;&#10;END' />
      </column>
      <column caption='Order Differences' datatype='string' name='[Calculation_4294182281668026370]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [orders]= [d_orders] then &apos;No Diff&apos;&#13;&#10;ELSEIF [orders]&lt;&gt; [d_orders] then &apos;Diff&apos;&#13;&#10;ELSEIF [orders]&gt; [d_orders] then &apos;Diff&apos;&#13;&#10;ELSEIF [orders]&lt; [d_orders] then &apos;Diff&apos;&#13;&#10;END' />
      </column>
      <column caption='Not Zero' datatype='string' name='[Calculation_4775082283703480320]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_4775082283710779393] &lt;&gt; 0 THEN &apos;Non-Zero&apos; ELSE &apos;Zero&apos; END' />
      </column>
      <column caption='Cal Diff' datatype='integer' name='[Calculation_4775082283710779393]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders]) - ATTR([d_orders])' />
      </column>
      <column caption='Min Difference Date' datatype='date' name='[Calculation_4775082284324855812]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED [merchant_id] : MIN([order_date])}' />
      </column>
      <column caption='Min order date' datatype='date' name='[Calculation_4775082284326047749]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='min([order_date])' />
      </column>
      <column caption='Max Difference Date' datatype='date' name='[Calculation_4775082284328394758]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED [merchant_id] : max([order_date])}' />
      </column>
      <column caption='Kiosk_emenu_merchants' datatype='integer' name='[Calculation_4901394141661884416]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [merchant_id]:COUNTD([menu_mode])}' />
      </column>
      <column caption='Percentage Order Accurate' datatype='real' name='[Calculation_4901394141663723521]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([order_difference])/SUM([orders])' />
      </column>
      <column caption='Kiosk and emenu merchants' datatype='string' name='[Calculation_514395587516510211]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [menu_mode]=&apos;Kiosk&apos; THEN [merchant_id]&#10;ELSEIF [menu_mode]=&apos;eMenu&apos; THEN [merchant_id]&#10;ELSE &apos;Others&apos; END' />
      </column>
      <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column caption='Custom SQL Query' datatype='table' name='[__tableau_internal_object_id__].[_8CF907FAD9054AD2BECB570E11211154]' role='measure' type='quantitative' />
      <column-instance column='[Calculation_4294182281668026370]' derivation='None' name='[none:Calculation_4294182281668026370:nk]' pivot='key' type='nominal' />
      <layout dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[none:Calculation_4294182281668026370:nk]' type='palette'>
