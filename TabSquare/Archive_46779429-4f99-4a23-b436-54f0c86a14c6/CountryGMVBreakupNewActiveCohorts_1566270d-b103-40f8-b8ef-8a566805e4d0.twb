    <worksheet name='active difference &lt;-20 drop'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>$MN</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (skipque_cdc_data_prod)' name='federated.0lqvtjz10yqi0k1b82tvo0w8gosx' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date param' datatype='date' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='#2023-09-22#'>
              <calculation class='tableau' formula='#2023-09-22#' />
            </column>
            <column caption='n paramter' datatype='integer' name='[Parameter 2]' param-domain-type='list' role='measure' type='quantitative' value='7'>
              <calculation class='tableau' formula='7' />
            </column>
            <column alias='On' caption='Extrapolation on/off' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;1&quot;'>
              <calculation class='tableau' formula='&quot;1&quot;' />
              <aliases>
                <alias key='&quot;0&quot;' value='Off' />
                <alias key='&quot;1&quot;' value='On' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0lqvtjz10yqi0k1b82tvo0w8gosx'>
            <column caption='20 drop active difference %  (copy)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[20 drop active difference %  (copy)_1797076992186126423]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([20 drop than active difference (copy)_1797076992186003542])/ [20 drop active previous sales  (copy)_1797076992323833978]' />
            </column>
            <column caption='20 drop active previous sales  (copy)' datatype='real' name='[20 drop active previous sales  (copy)_1797076992323833978]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(sum(([less than 7 active previous sales (copy)_1797076992181260362])/1000000),2)' />
            </column>
            <column caption='&lt;-20 drop than active difference ' datatype='real' name='[20 drop than active difference (copy 2)_1797076992189153372]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(sum([active current &lt;-20  (copy)_1572530329408086026]),0)-IFNULL(sum([active previous&lt;-20 (copy)_1797076992187129945]),0)' />
            </column>
            <column caption='20 drop than active difference (copy)' datatype='real' name='[20 drop than active difference (copy)_1797076992186003542]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(([less than active difference (copy)_1797076992181268555]/1000000),2)' />
            </column>
            <column datatype='string' name='[Account_Name]' role='dimension' type='nominal' />
            <column caption='less than 7 days keep/remove' datatype='string' name='[Calculation_1797076992173846581]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [less than 7 days merchant list]=True then &quot;Keep&quot; else &quot;remove&quot;  end' />
            </column>
            <column caption='active- last 7 days merchant count' datatype='integer' name='[Calculation_1797076992178896961]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([active current (copy 2)_6913658749651198014])- COUNTD([less than 7 active current sales (copy)_1797076992177066045])' />
            </column>
            <column caption='extrapolation factor' datatype='real' name='[Calculation_2577114521544609793]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 3]=&quot;1&quot; then [Calculation_937944994124505099]/[Calculation_937944994126520333]&#10;else 1 END' />
            </column>
            <column caption='current n previous' datatype='string' name='[Calculation_6372171262747947009]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if { FIXED [merchant_id]:ifnull(sum(if [month]=[Calculation_6372171262748041218] then [sales] end),0)}&gt;0 and &#10; { FIXED [merchant_id]:ifnull(sum(if [month]=[current selected month (copy)_6372171262748332035] then  [sales] end),0)}&gt;0 then &quot;both&quot; &#10;&#10;ELSEIF { FIXED [merchant_id]:ifnull(sum(if [month]=[Calculation_6372171262748041218] then [sales] end),0)}&gt;0 and &#10; { FIXED [merchant_id]:ifnull(sum(if [month]=[current selected month (copy)_6372171262748332035] then [sales] end),0)}=0 then &quot;only current&quot;&#10; ELSEIF { FIXED [merchant_id]:ifnull(sum(if [month]=[Calculation_6372171262748041218] then [sales] end),0)}=0 and &#10; { FIXED [merchant_id]:ifnull(sum(if [month]=[current selected month (copy)_6372171262748332035] then [sales] end),0)}&gt;0 then &quot;only previous&quot; &#10;ELSE &quot;others&quot;&#10;end' />
            </column>
            <column aggregation='Sum' caption='current selected month' datatype='integer' name='[Calculation_6372171262748041218]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEPART(&apos;month&apos;, [Parameters].[Parameter 1])' />
            </column>
            <column caption='new status' datatype='string' name='[Calculation_6372171262750285829]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if status = &quot;Implementation&quot; and [Calculation_6372171262747947009]=&quot;both&quot; then &quot;Active_current&quot;&#10;ELSEIF status = &quot;Implementation-1&quot; and [Calculation_6372171262747947009]=&quot;both&quot; then &quot;Active_previous&quot;&#10;ELSEIF status = &quot;Incubation-1&quot; and [Calculation_6372171262747947009]= &quot;only previous&quot; then &quot;At risk&quot;&#10;ELSEIF status = &quot;Implementation-1&quot; and [Calculation_6372171262747947009]=&quot;only previous&quot; then &quot;At risk&quot;&#10;ELSEIF status = &quot;Incubation&quot; and [Calculation_6372171262747947009]= &quot;only current&quot; then &quot;Restarted&quot;&#10;ELSEIF [status]=&quot;Restarted&quot; and [current_and_previous_first_order_date]=&quot;current_month_go_live&quot; then&#10;&quot;New-not on airtable&quot;&#10;&#10;else [status]&#10;END' />
            </column>
            <column caption='fixed max order date' datatype='date' name='[Calculation_937944994099474432]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [merchant_id]:MAX([max_order_date])}' />
            </column>
            <column caption='global max' datatype='date' name='[Calculation_937944994099793921]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED  : MAX([Calculation_937944994099474432])}' />
            </column>
            <column caption='less than n days gmv' datatype='string' name='[Calculation_937944994112262148]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if datediff(&apos;day&apos;,[Calculation_937944994099474432],[Calculation_937944994099793921]) &gt;= [Parameters].[Parameter 2] then  &quot;No gmv&quot;&#10;else &quot;GMV&quot; END' />
            </column>
            <column caption='first day of the month' datatype='date' name='[Calculation_937944994121117705]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='date(DATEADD(&apos;month&apos;, 0, DATETRUNC(&apos;month&apos;, [Calculation_937944994099793921])))' />
            </column>
            <column caption='no of days in a month ' datatype='integer' name='[Calculation_937944994124505099]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DAY(DATEADD(&apos;day&apos;,-1,DATEADD(&apos;month&apos;,1,DATETRUNC(&apos;month&apos;,[Calculation_937944994099793921]))))' />
            </column>
            <column caption='difference days' datatype='integer' name='[Calculation_937944994126520333]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Calculation_937944994121117705],[Calculation_937944994099793921])+1' />
            </column>
            <column caption='active previous' datatype='real' default-format='n#,##0,.00K;-#,##0,.00K' name='[Calculation_95771917745643525]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(if [Calculation_6372171262750285829]= &quot;Active_previous&quot; then [sales] end )' />
            </column>
            <column caption='active current merchants' datatype='string' default-format='n#,##0.00;-#,##0.00' name='[active current (copy 2)_6913658749651198014]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='(if [Calculation_6372171262750285829]= &quot;Active_current&quot; then [merchant_id] end )' />
            </column>
            <column caption='active current&lt;-20' datatype='real' name='[active current &lt;-20  (copy)_1572530329408086026]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(if  { FIXED [less than 7 days main merchant list (copy)_1797076992180338756] : [20 drop active difference %  (copy)_1797076992186126423]*100}&lt;-20 then [less than 7 active current sales (copy 2)_1797076992181248073] end )' />
            </column>
            <column caption='active previous merchants' datatype='string' default-format='n#,##0,.00K;-#,##0,.00K' name='[active previous (copy 2)_6913658749651267647]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='(if [Calculation_6372171262750285829]= &quot;Active_previous&quot; then [merchant_id] end )' />
            </column>
            <column caption='active current' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[active previous (copy)_408842460789587996]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(if [Calculation_6372171262750285829]= &quot;Active_current&quot; then [previous month sales_main (copy)_408842460798832672] end )' />
            </column>
            <column caption='active previous&lt;-20' datatype='real' name='[active previous&lt;-20 (copy)_1797076992187129945]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(if  { FIXED [less than 7 days main merchant list (copy)_1797076992180338756] : [20 drop active difference %  (copy)_1797076992186126423]*100}&lt;-20 then [less than 7 active previous sales (copy)_1797076992181260362] end )' />
            </column>
            <column caption='color active difference less than active difference  &lt;-20 drop than active difference ' datatype='integer' default-format='n#,##0.00;-#,##0.00' name='[color active difference less than active difference (copy)_1797076992200093805]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='if [20 drop than active difference (copy 2)_1797076992189153372]&gt;0 then 1 else 0 END' />
            </column>
            <column caption='Country' datatype='string' name='[country (group)]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='categorical-bin' column='[country]' new-bin='true'>
                <bin default-name='false' value='&quot;ANZ&quot;'>
                  <value>&quot;Australia&quot;</value>
                  <value>&quot;New Zealand&quot;</value>
                  <value>&quot;United Kingdom&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Others&quot;'>
                  <value>&quot;Brunei&quot;</value>
                  <value>&quot;Hong Kong&quot;</value>
                  <value>&quot;Jordan&quot;</value>
                  <value>&quot;Philippines&quot;</value>
                  <value>&quot;Sweden&quot;</value>
                  <value>&quot;Taiwan&quot;</value>
                  <value>&quot;Thailand&quot;</value>
                  <value>&quot;United Arab Emirates&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Singapore&quot;'>
                  <value>&quot;Singapore&quot;</value>
                </bin>
              </calculation>
            </column>
            <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column aggregation='Sum' caption='previous  selected month ' datatype='integer' name='[current selected month (copy)_6372171262748332035]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEPART(&apos;month&apos;,DATEADD(&apos;month&apos;,-1, [Parameters].[Parameter 1]))' />
            </column>
            <column datatype='string' name='[current_and_previous_first_order_date]' role='dimension' type='nominal' />
            <column datatype='string' name='[current_and_previous_order_date]' role='dimension' type='nominal' />
            <column caption='20 drop active current sales' datatype='real' name='[less than 7 active current sales (copy 2)_1797076992181248073]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [less than 7 days main merchant list (copy)_1797076992180338756] = [active current (copy 2)_6913658749651198014] then [active previous (copy)_408842460789587996] end' />
            </column>
            <column caption='less than 7 active current sales (copy)' datatype='string' name='[less than 7 active current sales (copy)_1797076992177066045]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [less than 7 days true (copy)_1797076992174932024] = [active current (copy 2)_6913658749651198014] then [merchant_id] end' />
            </column>
            <column caption='20 drop active previous sales ' datatype='real' name='[less than 7 active previous sales (copy)_1797076992181260362]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [less than 7 days main merchant list (copy)_1797076992180338756] = [active previous (copy 2)_6913658749651267647] then [Calculation_95771917745643525] end' />
            </column>
            <column caption='20 drop merchants keep/remove' datatype='string' name='[less than 7 days keep/remove (copy)_1797076992180109379]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [20 drop merchants] =True then &quot;Keep&quot; else &quot;remove&quot;  end' />
            </column>
            <column caption='20 drop main merchant list' datatype='string' name='[less than 7 days main merchant list (copy)_1797076992180338756]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if  [less than 7 days keep/remove (copy)_1797076992180109379]=&quot;Keep&quot; then [merchant_id]  end' />
            </column>
            <column caption='less than 7 days main merchant list' datatype='string' name='[less than 7 days true (copy)_1797076992174932024]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_1797076992173846581]=&quot;Keep&quot; then [merchant_id]  end' />
            </column>
            <column caption='20 drop than active difference' datatype='real' name='[less than active difference (copy)_1797076992181268555]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(sum([less than 7 active current sales (copy 2)_1797076992181248073]),0)-IFNULL(sum([less than 7 active previous sales (copy)_1797076992181260362]),0)' />
            </column>
            <column caption='less than n days gmv-keep' datatype='string' name='[less than n days gmv (copy)_1797076992173281332]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_937944994112262148]=&quot;No gmv&quot; then [merchant_id] END' />
