when extract(month from order_date) = extract(month from DATE_ADD(current_date, INTERVAL -2 month)) and 
extract(year from order_date) = extract(year from DATE_ADD(current_date, INTERVAL -2 month)) then 0
end as current_and_previous_1, 

sum(sales)  as sales

 from 
(SELECT distinct  t2.merchant_id, t2.order_date,t2.product_type,
