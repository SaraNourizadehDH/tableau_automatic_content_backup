      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (skipque_cdc_data_prod)' name='federated.0lqvtjz10yqi0k1b82tvo0w8gosx' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date param' datatype='date' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='#2023-09-22#'>
              <calculation class='tableau' formula='#2023-09-22#' />
            </column>
            <column caption='n paramter' datatype='integer' name='[Parameter 2]' param-domain-type='list' role='measure' type='quantitative' value='7'>
              <calculation class='tableau' formula='7' />
            </column>
            <column alias='On' caption='Extrapolation on/off' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;1&quot;'>
              <calculation class='tableau' formula='&quot;1&quot;' />
              <aliases>
                <alias key='&quot;0&quot;' value='Off' />
                <alias key='&quot;1&quot;' value='On' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0lqvtjz10yqi0k1b82tvo0w8gosx'>
            <column caption='extrapolation factor' datatype='real' name='[Calculation_2577114521544609793]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 3]=&quot;1&quot; then [Calculation_937944994124505099]/[Calculation_937944994126520333]&#10;else 1 END' />
            </column>
            <column caption='current sales(merchants)' datatype='real' name='[Calculation_2577114521557123078]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [merchant_id] : sum([previous month sales_main (copy)_408842460798832672])}' />
            </column>
            <column caption='current-previous%(merchant)' datatype='real' name='[Calculation_2577114521557569544]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_2577114521557123078]- [current sales(merchants) (copy)_2577114521557389319])/[current sales(merchants) (copy)_2577114521557389319]' />
            </column>
            <column caption='activecohorts(merchant_id)' datatype='string' name='[Calculation_2577114521558183948]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if datediff(&apos;day&apos;,[Calculation_937944994099474432],[Calculation_937944994099793921]) &gt;= [Parameters].[Parameter 2] then  &quot;No gmv&quot;&#10;ELSEIF [Calculation_2577114521557569544]&gt;0.2 then &quot;&gt;20% gmv&quot;&#10;ELSEIF [Calculation_2577114521557569544]&lt;-0.2 then &quot;&lt;-20% gmv&quot;&#10;elseif [Calculation_6372171262750285829]= &quot;Active_current&quot; then &quot;stable&quot; END' />
            </column>
            <column caption='previous month sales_main' datatype='real' default-format='n#,##0,,.0M;-#,##0,,.0M' name='[Calculation_408842460798685215]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [current_and_previous_order_date]=&quot;previous_month_order&quot; then [sales] END' />
            </column>
            <column caption='current n previous' datatype='string' name='[Calculation_6372171262747947009]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if { FIXED [merchant_id]:ifnull(sum(if [month]=[Calculation_6372171262748041218] then [sales] end),0)}&gt;0 and &#10; { FIXED [merchant_id]:ifnull(sum(if [month]=[current selected month (copy)_6372171262748332035] then  [sales] end),0)}&gt;0 then &quot;both&quot; &#10;&#10;ELSEIF { FIXED [merchant_id]:ifnull(sum(if [month]=[Calculation_6372171262748041218] then [sales] end),0)}&gt;0 and &#10; { FIXED [merchant_id]:ifnull(sum(if [month]=[current selected month (copy)_6372171262748332035] then [sales] end),0)}=0 then &quot;only current&quot;&#10; ELSEIF { FIXED [merchant_id]:ifnull(sum(if [month]=[Calculation_6372171262748041218] then [sales] end),0)}=0 and &#10; { FIXED [merchant_id]:ifnull(sum(if [month]=[current selected month (copy)_6372171262748332035] then [sales] end),0)}&gt;0 then &quot;only previous&quot; &#10;ELSE &quot;others&quot;&#10;end' />
            </column>
            <column aggregation='Sum' caption='current selected month' datatype='integer' name='[Calculation_6372171262748041218]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEPART(&apos;month&apos;, [Parameters].[Parameter 1])' />
            </column>
            <column caption='new status' datatype='string' name='[Calculation_6372171262750285829]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if status = &quot;Implementation&quot; and [Calculation_6372171262747947009]=&quot;both&quot; then &quot;Active_current&quot;&#10;ELSEIF status = &quot;Implementation-1&quot; and [Calculation_6372171262747947009]=&quot;both&quot; then &quot;Active_previous&quot;&#10;ELSEIF status = &quot;Incubation-1&quot; and [Calculation_6372171262747947009]= &quot;only previous&quot; then &quot;At risk&quot;&#10;ELSEIF status = &quot;Implementation-1&quot; and [Calculation_6372171262747947009]=&quot;only previous&quot; then &quot;At risk&quot;&#10;ELSEIF status = &quot;Incubation&quot; and [Calculation_6372171262747947009]= &quot;only current&quot; then &quot;Restarted&quot;&#10;ELSEIF [status]=&quot;Restarted&quot; and [current_and_previous_first_order_date]=&quot;current_month_go_live&quot; then&#10;&quot;New-not on airtable&quot;&#10;&#10;else [status]&#10;END' />
            </column>
            <column caption='fixed max order date' datatype='date' name='[Calculation_937944994099474432]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [merchant_id]:MAX([max_order_date])}' />
            </column>
            <column caption='global max' datatype='date' name='[Calculation_937944994099793921]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED  : MAX([Calculation_937944994099474432])}' />
            </column>
            <column caption='first day of the month' datatype='date' name='[Calculation_937944994121117705]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='date(DATEADD(&apos;month&apos;, 0, DATETRUNC(&apos;month&apos;, [Calculation_937944994099793921])))' />
            </column>
            <column caption='no of days in a month ' datatype='integer' name='[Calculation_937944994124505099]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DAY(DATEADD(&apos;day&apos;,-1,DATEADD(&apos;month&apos;,1,DATETRUNC(&apos;month&apos;,[Calculation_937944994099793921]))))' />
            </column>
            <column caption='difference days' datatype='integer' name='[Calculation_937944994126520333]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Calculation_937944994121117705],[Calculation_937944994099793921])+1' />
            </column>
            <column caption='previous  sales(merchants)' datatype='real' name='[current sales(merchants) (copy)_2577114521557389319]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [merchant_id] : sum([Calculation_408842460798685215])}' />
            </column>
            <column aggregation='Sum' caption='previous  selected month ' datatype='integer' name='[current selected month (copy)_6372171262748332035]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEPART(&apos;month&apos;,DATEADD(&apos;month&apos;,-1, [Parameters].[Parameter 1]))' />
            </column>
            <column datatype='string' name='[current_and_previous_first_order_date]' role='dimension' type='nominal' />
            <column datatype='string' name='[current_and_previous_order_date]' role='dimension' type='nominal' />
            <column datatype='date' name='[max_order_date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[merchant_id]' role='dimension' type='nominal' />
            <column aggregation='Sum' datatype='integer' name='[month]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_2577114521558183948]' derivation='None' name='[none:Calculation_2577114521558183948:nk]' pivot='key' type='nominal' />
            <column caption='current month sales_main ' datatype='real' default-format='n#,##0,,.0M;-#,##0,,.0M' name='[previous month sales_main (copy)_408842460798832672]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [current_and_previous_order_date]=&quot;Current_month_order&quot; then [sales]*[Calculation_2577114521544609793] END' />
            </column>
            <column datatype='real' default-format='n#,##0.00;-#,##0.00' name='[sales]' role='measure' type='quantitative' />
            <column datatype='string' name='[status]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_408842460798685215]' derivation='Sum' name='[sum:Calculation_408842460798685215:qk]' pivot='key' type='quantitative' />
