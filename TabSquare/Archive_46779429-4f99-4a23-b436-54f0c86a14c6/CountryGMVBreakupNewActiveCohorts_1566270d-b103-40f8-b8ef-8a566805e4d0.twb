when extract(month from order_date) = extract(month from DATE_ADD(current_date, INTERVAL -1 month)) and 
extract(year from order_date) = extract(year from DATE_ADD(current_date, INTERVAL -1 month)) then &quot;previous_month_order&quot;
when extract(month from order_date) = extract(month from DATE_ADD(current_date, INTERVAL -2 month)) and 
extract(year from order_date) = extract(year from DATE_ADD(current_date, INTERVAL -2 month)) then &quot;prior_month_order&quot;
