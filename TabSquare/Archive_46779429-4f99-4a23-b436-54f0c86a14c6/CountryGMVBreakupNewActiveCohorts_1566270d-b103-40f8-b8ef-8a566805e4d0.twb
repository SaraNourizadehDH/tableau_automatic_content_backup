            </column>
            <column caption='less than active difference (copy)' datatype='real' name='[less than active difference (copy)_1797076992183386193]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(([Calculation_1797076992178147391]/1000000),2)' />
            </column>
