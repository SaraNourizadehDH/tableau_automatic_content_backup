                </bin>
              </calculation>
            </column>
            <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[current_and_previous_order_date]' role='dimension' type='nominal' />
