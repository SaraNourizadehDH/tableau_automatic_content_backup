          <datasource-dependencies datasource='federated.0lqvtjz10yqi0k1b82tvo0w8gosx'>
            <column caption='20 drop active difference %  (copy)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[20 drop active difference %  (copy)_1797076992186126423]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([20 drop than active difference (copy)_1797076992186003542])/ [20 drop active previous sales  (copy)_1797076992323833978]' />
            </column>
