else &quot;Prior_to_prior_month&quot;
end as current_and_previous_go_live,

case when extract(month from order_date) = extract(month from DATE_ADD(current_date, INTERVAL 0 month))  and 
extract(year from order_date) = extract(year from DATE_ADD(current_date, INTERVAL 0 month)) then &quot;Current_month_order&quot;
when extract(month from order_date) = extract(month from DATE_ADD(current_date, INTERVAL -1 month)) and 
