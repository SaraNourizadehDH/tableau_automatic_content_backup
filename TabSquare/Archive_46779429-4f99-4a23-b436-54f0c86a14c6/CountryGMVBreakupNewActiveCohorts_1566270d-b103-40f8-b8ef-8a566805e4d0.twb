            <column datatype='string' name='[current_and_previous_order_date]' role='dimension' type='nominal' />
            <column caption='less than 7 active previous sales' datatype='real' name='[less than 7 active current sales (copy)_1797076992176914492]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [less than 7 days true (copy)_1797076992174932024] = [active previous (copy 2)_6913658749651267647] then [Calculation_95771917745643525] end' />
            </column>
            <column caption='less than 7 days active difference % (copy)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[less than 7 days active difference % (copy)_1797076992185606229]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([less than active difference (copy)_1797076992183386193])/[previous month sales_main (copy)_4149363428034539522]' />
            </column>
            <column caption='less than 7 days main merchant list' datatype='string' name='[less than 7 days true (copy)_1797076992174932024]' role='dimension' type='nominal'>
