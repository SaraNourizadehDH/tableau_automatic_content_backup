              <relation connection='bigquery.0ifie4w0ujbeh21g4q6ej1n5vzhf' name='Custom SQL Query' type='text'>select * from (SELECT distinct merchant_id,country, month, year, sales,current_go_live_date,current_and_previous_go_live, current_and_previous_order_date, subtracted_Sales, subtracted_sales_1,
case when current_and_previous_go_live= &quot;previous_month_go_live&quot; and current_and_previous_order_date= &quot;Current_month_order&quot; then &quot;Incubation&quot;
when current_and_previous_go_live= &quot;current_month_go_live&quot; and current_and_previous_order_date= &quot;Current_month_order&quot; then &quot;Implementation&quot;
when current_and_previous_go_live= &quot;current_month_go_live&quot; and current_and_previous_order_date= &quot;previous_month_order&quot; then &quot;Implementation-1&quot;
when current_and_previous_go_live= &quot;previous_month_go_live&quot; and current_and_previous_order_date= &quot;previous_month_order&quot; then &quot;Incubation-1&quot;
when current_and_previous_go_live= &quot;Prior_to_prior_month&quot; and current_and_previous_order_date=&quot;Current_month_order&quot; 
and ((subtracted_sales = 1 and subtracted_sales_1 is null) or (subtracted_sales is null and subtracted_sales_1 is null))  then &quot;Restarted&quot;
when current_and_previous_go_live= &quot;Prior_to_prior_month&quot; and current_and_previous_order_date=&quot;previous_month_order&quot; 
and ((subtracted_sales = -1 and subtracted_sales_1 is null)  or   
(subtracted_sales is null and subtracted_sales_1 is null)) then &quot;At risk&quot;
when current_and_previous_go_live= &quot;Prior_to_prior_month&quot; and current_and_previous_order_date=&quot;previous_month_order&quot; 
and ((subtracted_sales = -1 and subtracted_sales_1= -2) or (subtracted_sales is null and subtracted_sales_1= -2) ) then &quot;Active_previous&quot;
when current_and_previous_go_live= &quot;Prior_to_prior_month&quot; and current_and_previous_order_date=&quot;Current_month_order&quot; 
and (subtracted_sales = 2 and subtracted_sales_1 is null )  then &quot;Active_current&quot;
end as status
from (select distinct *,
current_and_previous_1- lag(current_and_previous_1) over (partition by merchant_id order by year, month ) as subtracted_sales,
current_and_previous_1- lead(current_and_previous_1) over (partition by merchant_id order by year, month ) as subtracted_sales_1
from (
  
  select distinct merchant_id,  country, current_go_live_date,
extract(month from order_date) as month, extract(year from order_date) as year,

case when extract(month from current_go_live_date) = extract(month from DATE_ADD(current_date, INTERVAL 0 month)) and 
extract(year from current_go_live_date) = extract(year from DATE_ADD(current_date, INTERVAL 0 month))  then &quot;current_month_go_live&quot;
when extract(month from current_go_live_date) = extract(month from DATE_ADD(current_date, INTERVAL -1 month)) and 
