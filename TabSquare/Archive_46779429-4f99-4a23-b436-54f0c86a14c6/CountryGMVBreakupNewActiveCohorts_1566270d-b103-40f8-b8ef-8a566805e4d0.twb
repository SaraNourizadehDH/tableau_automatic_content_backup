when extract(month from order_date) = extract(month from DATE_ADD(current_date, INTERVAL -2 month)) and 
extract(year from order_date) = extract(year from DATE_ADD(current_date, INTERVAL -2 month)) then &quot;prior_month_order&quot;
end as current_and_previous_order_date,

case when extract(month from order_date) = extract(month from DATE_ADD(current_date, INTERVAL 0 month)) and 
extract(year from order_date) = extract(year from DATE_ADD(current_date, INTERVAL 0 month)) then  1
when extract(month from order_date) = extract(month from DATE_ADD(current_date, INTERVAL -1 month)) and 
extract(year from order_date) = extract(year from DATE_ADD(current_date, INTERVAL -1 month)) then -1 
