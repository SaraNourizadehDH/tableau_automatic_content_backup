              <calculation class='tableau' formula='DATEPART(&apos;month&apos;,DATEADD(&apos;month&apos;,-1, [Parameters].[Parameter 1]))' />
            </column>
            <column datatype='string' name='[current_and_previous_first_order_date]' role='dimension' type='nominal' />
            <column caption='difference main % color incubation' datatype='integer' default-format='n#,##0.00;-#,##0.00' name='[difference main % color (copy)_6913658749655339075]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Calculation_6372171262752378886] &gt;0 then 1 else 0 end' />
