    <worksheet name='CPC clicks difference'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000'>CPC billable clicks - difference between Perseus and GA</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='ncr-8534' name='federated.0m3l91c0rrcnjx13hjcnk1an1vn7' />
          </datasources>
          <datasource-dependencies datasource='federated.0m3l91c0rrcnjx13hjcnk1an1vn7'>
            <column caption='CPC clicks difference, abs' datatype='integer' name='[CPC clicks difference, % (copy)_1716223340210905094]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_1716223340175179779]) - sum([deduplicated cpc clicks - perseus sponsored (copy)_1716223340175417348])' />
            </column>
            <column caption='cpc clicks - perseus sponsored' datatype='integer' name='[Calculation_1716223340175179779]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [source] = &apos;perseus_sponsored&apos; then [cpc_clicks] end' />
            </column>
            <column caption='CPC clicks difference, %' datatype='real' name='[Calculation_1716223340175482885]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_1716223340175179779]) / sum([deduplicated cpc clicks - perseus sponsored (copy)_1716223340175417348]) -1' />
            </column>
            <column caption='Date' datatype='string' datatype-customized='true' name='[Partition Date (copy)_1716223340162510848]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([partition_date])' />
            </column>
            <column datatype='string' name='[app_version_code]' role='dimension' type='nominal' />
