      </column>
      <column caption='CPC clicks difference, abs' datatype='integer' name='[CPC clicks difference, % (copy)_1716223340210905094]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_1716223340175179779]) - sum([deduplicated cpc clicks - perseus sponsored (copy)_1716223340175417348])' />
      </column>
      <column caption='CPC revenue difference, %' datatype='real' name='[CPC clicks difference, % (copy)_1716223340213342217]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([cpc clicks - perseus sponsored (copy)_1716223340213317640]) / sum([cpc clicks - ga sponsored (copy)_1716223340213305351]) -1' />
      </column>
      <column caption='CPC transactions difference, % ' datatype='real' name='[CPC clicks difference, % (copy)_1716223340247584782]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([cpc revenue - perseus sponsored (copy)_1716223340247535628]) / sum([cpc revenue - ga sponsored  (copy)_1716223340247519243]) -1' />
      </column>
      <column caption='CPC revenue difference, abs ' datatype='real' name='[CPC clicks difference, abs (copy)_1716223340213350410]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([cpc clicks - perseus sponsored (copy)_1716223340213317640]) - sum([cpc clicks - ga sponsored (copy)_1716223340213305351])' />
      </column>
      <column caption='CPC transactions difference, abs' datatype='integer' name='[CPC clicks difference, abs (copy)_1716223340247552013]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([cpc revenue - perseus sponsored (copy)_1716223340247535628]) - sum([cpc revenue - ga sponsored  (copy)_1716223340247519243])' />
      </column>
      <column caption='CPC revenue flag ' datatype='string' name='[CPC clicks flag (copy)_6248040864088858635]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [CPC clicks difference, % (copy)_1716223340213342217] &gt; 0 THEN &quot;yes&quot; ELSE &quot;no&quot; END' />
