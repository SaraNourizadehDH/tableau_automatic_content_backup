          <datasource-dependencies datasource='federated.0m3l91c0rrcnjx13hjcnk1an1vn7'>
            <column caption='CPC revenue difference, %' datatype='real' name='[CPC clicks difference, % (copy)_1716223340213342217]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cpc clicks - perseus sponsored (copy)_1716223340213317640]) / sum([cpc clicks - ga sponsored (copy)_1716223340213305351]) -1' />
            </column>
            <column caption='CPC revenue flag ' datatype='string' name='[CPC clicks flag (copy)_6248040864088858635]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [CPC clicks difference, % (copy)_1716223340213342217] &gt; 0 THEN &quot;yes&quot; ELSE &quot;no&quot; END' />
            </column>
            <column caption='cpc clicks - perseus sponsored' datatype='integer' name='[Calculation_1716223340175179779]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [source] = &apos;perseus_sponsored&apos; then [cpc_clicks] end' />
            </column>
            <column caption='CPC clicks difference, %' datatype='real' name='[Calculation_1716223340175482885]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_1716223340175179779]) / sum([deduplicated cpc clicks - perseus sponsored (copy)_1716223340175417348]) -1' />
            </column>
            <column caption='Decision flag - colouring' datatype='string' name='[Calculation_6248040795648876562]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_6248040864090411021] = &apos;migrate&apos; then &quot;green&quot; &#10;ELSEIF [Calculation_6248040864090411021] = &apos;0-1% loss&apos; then &apos;yellow&apos; &#10;ELSEIF [Calculation_6248040864090411021] = &apos;1-2% loss&apos; then &apos;pink&apos; &#10;ELSEIF [Calculation_6248040864090411021] = &apos;2-3% loss&apos; then &apos;red&apos; &#10;ELSE &apos;red&apos;&#10;end' />
            </column>
            <column caption='1' datatype='integer' name='[Calculation_6248040795650179091]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='CPC clicks flag' datatype='string' name='[Calculation_6248040864088506378]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1716223340175482885]&gt; 0 THEN &quot;yes&quot; ELSE &quot;no&quot; END' />
            </column>
            <column caption='Decision flag' datatype='string' name='[Calculation_6248040864090411021]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_6248040864088506378] = [CPC clicks flag (copy)_6248040864088858635] &#10;            and [Calculation_6248040864088506378] = &quot;yes&quot; &#10;            and [CPC clicks difference, % (copy)_1716223340213342217] &gt; 0 THEN &quot;migrate&quot; &#10;&#10;    ELSEIF [Calculation_6248040864088506378] = [CPC clicks flag (copy)_6248040864088858635] &#10;        and [Calculation_6248040864088506378] = &quot;no&quot; &#10;        and [CPC clicks difference, % (copy)_1716223340213342217] &gt;= -0.01 THEN &quot;0-1% loss&quot; &#10;&#10;ELSEIF [Calculation_6248040864088506378] = [CPC clicks flag (copy)_6248040864088858635] &#10;        and [Calculation_6248040864088506378] = &quot;no&quot; &#10;        and [CPC clicks difference, % (copy)_1716223340213342217] &gt;= -0.02 &#10;        and [CPC clicks difference, % (copy)_1716223340213342217] &lt; -0.01 THEN &quot;1-2% loss&quot; &#10;&#10;ELSEIF [Calculation_6248040864088506378] = [CPC clicks flag (copy)_6248040864088858635] &#10;        and [Calculation_6248040864088506378] = &quot;no&quot; &#10;        and [CPC clicks difference, % (copy)_1716223340213342217] &gt;= -0.03 &#10;        and [CPC clicks difference, % (copy)_1716223340213342217] &lt; -0.02 THEN &quot;2-3% loss&quot; &#10;&#10;ELSEIF [Calculation_6248040864088506378] = [CPC clicks flag (copy)_6248040864088858635] &#10;        and [Calculation_6248040864088506378] = &quot;no&quot; &#10;        and [CPC clicks difference, % (copy)_1716223340213342217] &lt; -0.03 THEN &quot;&gt;3% loss&quot; &#10;&#10;END' />
            </column>
