      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0m3l91c0rrcnjx13hjcnk1an1vn7].[usr:CPC clicks difference, \% (copy)_1716223340210905094:qk]&quot;' value='CPC clicks difference' />
