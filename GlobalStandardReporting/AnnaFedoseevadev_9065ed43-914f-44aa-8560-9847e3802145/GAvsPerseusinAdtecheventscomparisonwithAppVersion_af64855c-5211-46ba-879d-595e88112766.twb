        <calculation class='tableau' formula='[CPC clicks difference, abs (copy)_1716223340213350410]&#10;/ sum([cpc clicks - ga sponsored (copy)_1716223340213305351])' />
      </column>
      <column caption='cpc clicks - perseus sponsored' datatype='integer' name='[Calculation_1716223340175179779]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [source] = &apos;perseus_sponsored&apos; then [cpc_clicks] end' />
      </column>
      <column caption='CPC clicks difference, %' datatype='real' name='[Calculation_1716223340175482885]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_1716223340175179779]) / sum([deduplicated cpc clicks - perseus sponsored (copy)_1716223340175417348]) -1' />
      </column>
      <column caption='Share of abs difference out of total CPC clicks in Perseus' datatype='real' name='[Calculation_2075737281517953024]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[CPC clicks difference, % (copy)_1716223340210905094] / sum([Calculation_1716223340175179779])' />
      </column>
      <column caption='app version logic' datatype='boolean' name='[Calculation_2689141563940638723]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_1716223340175482885] &lt; 0 then true else false end' />
      </column>
      <column caption='cpc_revenue / cpc_clicks' datatype='real' name='[Calculation_3373407295067721728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([cpc_revenue_eur])/sum([cpc_clicks])' />
