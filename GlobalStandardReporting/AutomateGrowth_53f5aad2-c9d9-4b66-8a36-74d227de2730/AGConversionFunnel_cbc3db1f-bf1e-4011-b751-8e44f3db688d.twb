    <datasource caption='AG Funnel Monthly' inline='true' name='federated.0sultqw0n4tl1l1bmdzdr1exzdwn' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.16qgmm115j04731d348w21awza6q'>
            <connection CATALOG='dhh-ncr-stg' EXECCATALOG='dhh-ncr-stg' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='dhh-ncr-stg' schema='dev_sales_revenue' server-oauth='' username='yexi.yuan@foodpanda.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.16qgmm115j04731d348w21awza6q' name='Custom SQL Query' type='text'><![CDATA[WITH vendors AS (
  SELECT
    global_entity_id
    ,vendor_id
    ,chain_id
    ,vertical_type
    ,vertical_parent
    ,salesforce.key_account_category
    ,salesforce.is_key_account
    ,activation_date
    ,is_qcommerce
    ,is_local_shop
    ,location.city
    ,location.city_id
    ,CONCAT(global_entity_id, ';', vendor_id) AS vendor_code
    ,DATE_DIFF(CURRENT_DATE, DATE(activation_date), DAY) days_since_activation
  FROM `fulfillment-dwh-production.curated_data_shared_coredata_business.vendors`
  WHERE TRUE
    AND is_qcommerce = FALSE
    AND is_test_vendor = FALSE
)

, ga_events AS (
  SELECT
    event_timestamp_utc
    , fielddate event_date
    , user_id
    , user_pseudo_id
    , session_id
    , global_vendor_count
    , is_impersonated
    , event_name
    , global_entity_id
    , email_domain

    -- TRAFFIC SOURCE
    , traffic_source
    , collected_traffic_source

    -- GEO INFORMATMION
    , geo_continent
    , geo_region
    , geo_country
    , geo_city

    -- , event_params
    -- DEVICE INFORMATION
    -- , vpm_webview_id
    -- , app_id
    , device_category
    -- , device_os
    -- , device_brand
    -- , device_model

    , (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = 'tag') AS tag
    , (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = 'selected_vendor_id') AS selected_vendor_id
    , (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = 'selected_vendor_count') AS selected_vendor_count
    
    -- PLUGIN METADATA
    , (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = 'plugin_name') AS plugin_name
    , (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = 'page_name') AS page_name
    , section
    , label

    , (SELECT params.value.string_value FROM UNNEST(event_params) AS params WHERE params.key = 'campaign_state') AS campaign_state
    , (SELECT params.value.int_value FROM UNNEST(event_params) AS params WHERE params.key = 'recommended_tier') AS recommended_tier
    , (SELECT params.value.double_value FROM UNNEST(event_params) AS params WHERE params.key = 'recommended_budget') AS recommended_budget
    , (SELECT params.value.double_value FROM UNNEST(event_params) AS params WHERE params.key = 'roi_estimate') AS roi_estimate
    , (SELECT params.value.int_value FROM UNNEST(event_params) AS params WHERE params.key = 'order_estimate') AS order_estimate

  FROM `fulfillment-dwh-production.cl_vendor.vp_events`
  WHERE user_id IS NOT NULL
    AND fielddate >>= '2024-04-25'
)

, cpc_bookings AS (
  SELECT
    date_month
    ,global_entity_id
    ,vendor_id
    ,CONCAT(global_entity_id, ';', vendor_id) AS vendor_code
    ,MAX(booking_source) AS booking_source
    ,MIN(created_date) created_date
    ,MAX(last_run_date) last_run_date
  FROM `dhh-ncr-live.analytics.ad_tech_il_cpc`
  WHERE management_entity = 'Talabat'
    -- AND date_month >>= DATE_TRUNC(CURRENT_DATE, MONTH)
  GROUP BY 1,2,3,4
)

, apr_reco AS (
  SELECT
    CONCAT(global_entity_id, ';', vendor_id) AS vendor_code
    ,ag_segment
    ,recommendation_id
  FROM `dhh-ncr-live.adtech_vfd.adtech-vfda-ag-budget-allocation-europe_adtech_vfd_ag_budget_allocation_20240419T015222`
  -- WHERE ag_segment != 'F'
)

, ag_events AS (
  SELECT
    event_date
    ,device_category
    ,ga.global_entity_id
    ,selected_vendor_id
    ,plugin_name
    ,CASE WHEN ag_segment IS NULL THEN 'DEFAULT' ELSE ag_segment END AS ag_segment
    ,CASE 
      WHEN booking_source IS NOT NULL
      AND DATE(created_date) << DATE(event_date)
      THEN TRUE ELSE FALSE END
    AS is_existing_cpc
    ,COALESCE(key_account_category, 'Long Tail') account_segment
    ,MAX(CASE WHEN label = 'page_load' THEN TRUE ELSE FALSE END) plugin_loaded
    ,MAX(CASE WHEN label IN ('decrease_recommended_tier', 'increase_recommended_tier') THEN TRUE ELSE FALSE END) change_budget
    ,MAX(CASE WHEN label = 'booking_success' THEN TRUE ELSE FALSE END) booking_success
  FROM ga_events ga
    LEFT JOIN vendors v
      ON ga.selected_vendor_id = v.vendor_code
    LEFT JOIN cpc_bookings cpc
      ON ga.selected_vendor_id = cpc.vendor_code
      AND DATE_TRUNC(ga.event_date, MONTH) = date_month
    LEFT JOIN apr_reco rec
      ON ga.selected_vendor_id = rec.vendor_code
  WHERE TRUE
    AND ga.global_entity_id = 'TB_OM'
    GROUP BY 1,2,3,4,5,6,7,8
)
  SELECT
    DATE_TRUNC(event_date, ISOWEEK) AS report_period
    ,'Weekly' AS period
    ,device_category
    ,global_entity_id
    ,ag_segment
    ,is_existing_cpc
    ,account_segment

    ,COUNT(DISTINCT selected_vendor_id) portal_logins
    ,COUNT(DISTINCT CASE WHEN plugin_name = 'automate_growth' AND plugin_loaded = TRUE THEN selected_vendor_id END) AS plugin_loaded
    ,COUNT(DISTINCT CASE WHEN plugin_name = 'automate_growth' AND plugin_loaded = TRUE AND is_existing_cpc = FALSE AND ag_segment != 'F' THEN selected_vendor_id END) AS plugin_loaded_no_sl
    
    ,COUNT(DISTINCT CASE WHEN plugin_name = 'automate_growth' AND change_budget = TRUE THEN selected_vendor_id END) AS change_budget
    ,COUNT(DISTINCT CASE WHEN plugin_name = 'automate_growth' AND change_budget = TRUE AND is_existing_cpc = FALSE THEN selected_vendor_id END) AS change_budget_no_sl
    
    ,COUNT(DISTINCT CASE WHEN plugin_name = 'automate_growth' AND booking_success = TRUE THEN selected_vendor_id END) AS booking_success
    ,COUNT(DISTINCT CASE WHEN plugin_name = 'automate_growth' AND booking_success = TRUE AND is_existing_cpc = FALSE THEN selected_vendor_id END) AS booking_success_no_sl
    
  FROM ag_events
  GROUP BY 1,2,3,4,5,6,7
  UNION ALL
  SELECT
    DATE_TRUNC(event_date, MONTH) AS report_period
    ,'Monthly' AS period
    ,device_category
    ,global_entity_id
    ,ag_segment
    ,is_existing_cpc
    ,account_segment

    ,COUNT(DISTINCT selected_vendor_id) portal_logins
    ,COUNT(DISTINCT CASE WHEN plugin_name = 'automate_growth' AND plugin_loaded = TRUE THEN selected_vendor_id END) AS plugin_loaded
    ,COUNT(DISTINCT CASE WHEN plugin_name = 'automate_growth' AND plugin_loaded = TRUE AND is_existing_cpc = FALSE AND ag_segment != 'F' THEN selected_vendor_id END) AS plugin_loaded_no_sl
    
    ,COUNT(DISTINCT CASE WHEN plugin_name = 'automate_growth' AND change_budget = TRUE THEN selected_vendor_id END) AS change_budget
    ,COUNT(DISTINCT CASE WHEN plugin_name = 'automate_growth' AND change_budget = TRUE AND is_existing_cpc = FALSE THEN selected_vendor_id END) AS change_budget_no_sl
    
    ,COUNT(DISTINCT CASE WHEN plugin_name = 'automate_growth' AND booking_success = TRUE THEN selected_vendor_id END) AS booking_success
    ,COUNT(DISTINCT CASE WHEN plugin_name = 'automate_growth' AND booking_success = TRUE AND is_existing_cpc = FALSE THEN selected_vendor_id END) AS booking_success_no_sl
    
  FROM ag_events
  GROUP BY 1,2,3,4,5,6,7]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
