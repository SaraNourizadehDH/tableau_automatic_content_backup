      <column caption='Cost per GMV %' datatype='real' name='[Calculation_724516638414155776]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL( SUM(([psp_acquiring_fees] + [psp_processing_fees])) / SUM([psp_order_amount]) ,0)' />
