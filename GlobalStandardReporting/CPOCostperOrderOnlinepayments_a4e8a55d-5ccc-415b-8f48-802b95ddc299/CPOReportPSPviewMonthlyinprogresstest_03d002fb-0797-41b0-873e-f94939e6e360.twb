  <worksheets>
    <worksheet name='Detailed PSP Cost Overview'>
      <layout-options>
        <title>
          <formatted-text>
            <run>&lt;Sheet Name&gt;&#10;</run>
            <run fontcolor='#000000' fontname='Calibri' fontsize='11'>* Please note that the work is in progress. Currently, there are missing values due to the missing PSP / external acquirer integrations, see &apos;Information&apos; tab. </run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Calibri' fontsize='11'>* For ADYEN -&gt; Psp Acquiring Fee = Psp Markup Fees + Psp Issuer Fees + Psp Commission Fees + Psp Scheme Fees </run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/CPOReport-PSPview-Monthly/DetailedPSPCostOverview?rev=' id='DetailedPSPCostOverview' path='/t/GlobalStandardReporting/workbooks/CPOReport-PSPview-Monthly' revision='' site='GlobalStandardReporting' />
      <table>
        <view>
          <datasources>
            <datasource caption='cpo_report_psp' name='federated.07crnhk0ux7f3217jv1ja0jbjovb' />
          </datasources>
          <datasource-dependencies datasource='federated.07crnhk0ux7f3217jv1ja0jbjovb'>
            <column caption='Cost per GMV %' datatype='real' name='[Calculation_724516638414155776]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL( SUM(([psp_acquiring_fees] + [psp_processing_fees])) / SUM([psp_order_amount]) ,0)' />
            </column>
            <column caption='Total Cost' datatype='real' name='[Calculation_724516638416871425]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[psp_acquiring_fees] + [psp_processing_fees]' />
            </column>
            <column caption='Category Name /' datatype='string' name='[Category Name (copy)_2334834999151620099]' role='dimension' type='nominal'>
