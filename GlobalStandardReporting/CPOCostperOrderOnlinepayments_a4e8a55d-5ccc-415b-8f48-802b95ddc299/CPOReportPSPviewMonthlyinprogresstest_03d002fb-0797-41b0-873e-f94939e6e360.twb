  <dashboards>
    <dashboard name='Information'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/CPOReport-PSPview-Monthly/Information?rev=' id='Information' path='/t/GlobalStandardReporting/workbooks/CPOReport-PSPview-Monthly' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='800' maxwidth='1000' minheight='800' minwidth='1000' />
      <zones>
        <zone _.fcp.SetMembershipControl.false...type='layout-basic' _.fcp.SetMembershipControl.true...type-v2='layout-basic' h='100000' id='4' w='100000' x='0' y='0'>
          <zone _.fcp.SetMembershipControl.false...type='text' _.fcp.SetMembershipControl.true...type-v2='text' forceUpdate='true' h='98000' id='3' w='98400' x='800' y='1000'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontname='Segoe UI' fontsize='10'>Purpose:</run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='10'>Æ </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='10'>Tracking of payments costs from Payment Service Provider/External Acquirer&apos;s data by Region, Country, Entity, Payment Method</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Segoe UI' fontsize='10'>Categories: </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='11'>Adyen, Paypal (direct), Paypal via Adyen, Klarna (SE), KBank (TH), PayMaya (PH), AMEX (SG, HK, AT, FI, SE), </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='11'>GlobalPayments (TW), Checkout OY (FI), Cybersource (TW), PayU (CZ), SimplePay (HU)</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Segoe UI' fontsize='10'>Cost Metrics:</run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='10'>Æ </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Segoe UI' fontsize='10'>PSP Order Count </run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='10'>-&gt; total order count in PSP</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Segoe UI' fontsize='10'>PSP Order Amount </run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='10'>-&gt; total order amount in PSP</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Segoe UI' fontsize='10'>PSP Processing Fees</run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='10'> -&gt; payment processing / transaction / gateway fees </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Segoe UI' fontsize='10'>PSP Acquiring Fees</run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='10'> -&gt; sum of markup, commission, sheme and interchange (issuer) fees</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Segoe UI' fontsize='10'>Time Frame:</run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='10'> last 6 months</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Segoe UI' fontsize='10'>NOTES:</run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='10'>Æ </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='10'>* Psp: Payment service provider</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='10'>* BE: Backend</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='10'>* Timezone of the dates are as they are coming from the original report files so that it is in line with the invoices for comparison reasons. </run>
