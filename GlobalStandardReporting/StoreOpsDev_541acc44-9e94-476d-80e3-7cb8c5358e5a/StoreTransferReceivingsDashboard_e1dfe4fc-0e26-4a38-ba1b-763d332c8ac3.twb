      <aliases enabled='yes' />
      <column caption='Avg Receiving Time Per ST(min)' datatype='real' name='[Avg Receiving Time Per SKU(Sec) (copy)_3440116810329788419]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([st_receiving_time_s])/sum([total_store_transfer]))/60' />
      </column>
      <column caption='Avg Receiving Time Per Unit(sec)' datatype='real' name='[Avg Receiving Time Per SKU(sec) (copy)_3939171949629403136]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([st_receiving_time_s])/sum([total_received_qty]))' />
      </column>
      <column caption='Store Transfer Type' datatype='string' name='[Calculation_170784958996652032]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [warehouse_type] = &apos;dmart&apos; then &apos;Dmart2Dmart&apos;&#10;ELSEIF [warehouse_type] = &apos;dc&apos; then &apos;Dc2Dmart&apos;&#10;ELSE &apos;Others&apos; END' />
      </column>
      <column caption='Avg Receiving Time Per SKU(sec)' datatype='real' name='[Calculation_2203808339585654784]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([st_receiving_time_s])/sum([unique_SKUs]))' />
      </column>
      <column caption='%SKUs with Bulk Receivings' datatype='real' default-format='p0%' name='[Calculation_2928395302240075776]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100*sum(IF [receiving_type_flag] = &apos;Bulk&apos; THEN [unique_SKUs] ELSE 0 END)&#10;/ sum([unique_SKUs])' />
      </column>
      <column caption='Dynamic Date' datatype='date' name='[Calculation_3440116810326999040]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 1] &#10;WHEN &apos;Daily&apos; THEN DATETRUNC(&apos;day&apos;, [st_receiving_date]) &#10;WHEN &apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;, [st_receiving_date])&#10;WHEN &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;, [st_receiving_date])  &#10;WHEN &apos;Quarterly&apos; THEN DATETRUNC(&apos;quarter&apos;, [st_receiving_date]) &#10;END)' />
      </column>
      <column caption='Avg # Received SKU Per ST' datatype='real' name='[Calculation_3440116810328981505]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([unique_SKUs])/sum([total_store_transfer])' />
      </column>
      <column caption='Dynamic KPI Select ST' datatype='real' name='[Calculation_3440116810331811845]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;Avg Receiving time per SKU(sec)&apos; then [Calculation_2203808339585654784] &#10;ELSEIF [Parameters].[Parameter 2] = &apos;Avg Receiving Time Per Unit(sec)&apos; then [Avg Receiving Time Per SKU(sec) (copy)_3939171949629403136]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Avg Receiving time per ST(min)&apos; then [Avg Receiving Time Per SKU(Sec) (copy)_3440116810329788419]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Avg # Received SKUs per ST&apos; then [Calculation_3440116810328981505]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Total # Store transfers&apos; then sum([total_store_transfer])&#10;ELSEIF [Parameters].[Parameter 2] = &apos;%SKUs w Bulk RVGs&apos; then [Calculation_2928395302240075776]&#10;end' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='ac_allstore_transfers' datatype='table' name='[__tableau_internal_object_id__].[ac_allstore_transfers_3E8953285BE84CBE901D1C9A4122FFA2]' role='measure' type='quantitative' />
