          <datasource-dependencies datasource='Parameters'>
            <column alias='Daily' caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;day&quot;'>
              <calculation class='tableau' formula='&quot;day&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;quarter&quot;' value='Quarterly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ke59kw1wad9zj0zw1x8v1l4vast'>
            <column caption='Avg. Picking Time (s) per SKU' datatype='real' name='[Avg. Picking Time (m) (copy)_6294273115995271169]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [is_sent] then [picking_time_s] else 0 END)/sum([skus_delivered])' />
            </column>
            <column caption='Avg. Picking Time (s) per Item' datatype='real' name='[Avg. Picking Time (m) per SKU (copy)_6294273115996135426]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [is_sent] then [picking_time_s] else 0 END)/sum([qty_delivered])' />
            </column>
            <column caption='Dynamic Date' datatype='date' datatype-customized='true' name='[Calculation_6284632596197068803]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 1] &#10;WHEN &apos;day&apos; THEN DATETRUNC(&apos;day&apos;, [order_start_date]) &#10;WHEN &apos;week&apos; THEN DATETRUNC(&apos;week&apos;, [order_start_date])&#10;WHEN &apos;month&apos; THEN DATETRUNC(&apos;month&apos;, [order_start_date])  &#10;WHEN &apos;quarter&apos; THEN DATETRUNC(&apos;quarter&apos;, [order_start_date]) &#10;END)' />
            </column>
            <column caption='Peak Hours Flag' datatype='string' name='[Calculation_6867074649023840266]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [order_start_hour] &gt;= 17 and [order_start_hour] &lt;= 21 then &quot;Peak Hours&quot;&#10;ELSE &quot;Non Peak Hours&quot;&#10;END' />
            </column>
            <column datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
