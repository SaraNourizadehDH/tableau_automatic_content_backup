    <worksheet name='Engg_WHName_AllKpis'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>Active WareHouses</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='ac_of_rl_v1 (temp_qc)' name='federated.0ke59kw1wad9zj0zw1x8v1l4vast' />
          </datasources>
          <datasource-dependencies datasource='federated.0ke59kw1wad9zj0zw1x8v1l4vast'>
            <column caption='Avg # Missing SKU in Partial Fulfilled' datatype='real' name='[% Partial Fulfilled Orders (copy)_6294273116270727173]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [partial_order] then [skus_ordered] - [skus_delivered] else 0 END) /&#10;sum(IF [partial_order] and [skus_ordered] &gt; [skus_delivered] then [Calculation_6284632595905806336] else 0 END)' />
            </column>
            <column caption='Avg # Missing Items in Partial Fulfilled' datatype='real' name='[Avg # Missing SKU in Partial Fulfilled (copy)_6294273116272156678]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [partial_order] then [qty_ordered] - [qty_delivered] else 0 END) /&#10;sum(IF [partial_order] then [Calculation_6284632595905806336] else 0 END)' />
            </column>
            <column caption='Avg. Adj Dispatching Time (m) ' datatype='real' name='[Avg. Dispatching Time (m) (copy)_6294273116355223560]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum(IF [is_sent] then [adj_dispatch_time] else 0 END)/ sum(if [adj_dispatch_flag] then [Calculation_6284632595905806336] else 0 end)) /60' />
            </column>
            <column caption='Avg Basket Size(item)' datatype='real' name='[Basket Size(SKU) (copy)_6284632597311836167]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([qty_delivered])/sum([Calculation_6284632595905806336])' />
            </column>
            <column caption='Avg Basket Value(Euro)' datatype='real' name='[Calculation_5907948718584860672]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([order_value_euro])/sum([Calculation_6284632595905806336])' />
            </column>
            <column caption='successful orders' datatype='integer' name='[Calculation_6284632595905806336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_sent] then [num_orders] else 0 END' />
            </column>
            <column caption='Avg Dispatch Order wait time' datatype='real' name='[Calculation_6284632595917324289]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum(IF [is_sent] then [dispatch_order_wait_time] else 0 END) / sum([Calculation_6284632595905806336]))/60' />
            </column>
            <column caption='Avg Basket Size(SKU)' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_6284632597310476294]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([skus_delivered])/sum([Calculation_6284632595905806336])' />
            </column>
            <column caption='Avg. Assignment Time (m)' datatype='real' name='[Calculation_6867074648984064006]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [is_sent] then [assignment_time_s] else 0 END)/SUM([Calculation_6284632595905806336])) / 60' />
            </column>
            <column caption='Avg. Packaging Time (m)' datatype='real' name='[Calculation_6867074648985370631]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum(IF [is_sent] then [packaging_time_s] else 0 END)/sum([Calculation_6284632595905806336])) / 60' />
            </column>
            <column caption='Avg. Picking Time (m)' datatype='real' name='[Calculation_6867074648985595912]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum(IF [is_sent] then [picking_time_s] else 0 END)/sum([Calculation_6284632595905806336])) / 60' />
            </column>
            <column caption='Avg Total Store Time (m)' datatype='real' name='[Calculation_6867074648997535753]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6867074648984064006] + [Calculation_6867074648985595912] + [Calculation_6867074648985370631] + [Avg. Dispatching Time (m) (copy)_6294273116355223560]' />
            </column>
