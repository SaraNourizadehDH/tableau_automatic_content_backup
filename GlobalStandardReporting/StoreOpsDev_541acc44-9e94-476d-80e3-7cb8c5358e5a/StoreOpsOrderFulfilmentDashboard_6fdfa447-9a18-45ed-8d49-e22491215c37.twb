          <datasource-dependencies datasource='federated.0ke59kw1wad9zj0zw1x8v1l4vast'>
            <column caption='Avg # Missing SKU in Partial Fulfilled' datatype='real' name='[% Partial Fulfilled Orders (copy)_6294273116270727173]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [partial_order] then [skus_ordered] - [skus_delivered] else 0 END) /&#10;sum(IF [partial_order] and [skus_ordered] &gt; [skus_delivered] then [Calculation_6284632595905806336] else 0 END)' />
