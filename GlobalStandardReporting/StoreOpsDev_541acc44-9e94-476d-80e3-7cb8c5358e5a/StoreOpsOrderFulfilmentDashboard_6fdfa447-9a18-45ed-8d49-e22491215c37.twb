    <worksheet name='PF_Country'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>Country View of the Metric</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='ac_of_rl_v1 (temp_qc)' name='federated.0ke59kw1wad9zj0zw1x8v1l4vast' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Daily' caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;day&quot;'>
              <calculation class='tableau' formula='&quot;day&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;quarter&quot;' value='Quarterly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
            <column caption='Select KPI PF' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Avg Missing Item/Order&quot;'>
              <calculation class='tableau' formula='&quot;Avg Missing Item/Order&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ke59kw1wad9zj0zw1x8v1l4vast'>
            <column caption='Avg # Missing SKU in Partial Fulfilled' datatype='real' name='[% Partial Fulfilled Orders (copy)_6294273116270727173]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [partial_order] then [skus_ordered] - [skus_delivered] else 0 END) /&#10;sum(IF [partial_order] and [skus_ordered] &gt; [skus_delivered] then [Calculation_6284632595905806336] else 0 END)' />
            </column>
            <column caption='Avg # Missing Items in Partial Fulfilled' datatype='real' name='[Avg # Missing SKU in Partial Fulfilled (copy)_6294273116272156678]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [partial_order] then [qty_ordered] - [qty_delivered] else 0 END) /&#10;sum(IF [partial_order] then [Calculation_6284632595905806336] else 0 END)' />
            </column>
            <column caption='successful orders' datatype='integer' name='[Calculation_6284632595905806336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_sent] then [num_orders] else 0 END' />
            </column>
            <column caption='Dynamic Date' datatype='date' datatype-customized='true' name='[Calculation_6284632596197068803]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 1] &#10;WHEN &apos;day&apos; THEN DATETRUNC(&apos;day&apos;, [order_start_date]) &#10;WHEN &apos;week&apos; THEN DATETRUNC(&apos;week&apos;, [order_start_date])&#10;WHEN &apos;month&apos; THEN DATETRUNC(&apos;month&apos;, [order_start_date])  &#10;WHEN &apos;quarter&apos; THEN DATETRUNC(&apos;quarter&apos;, [order_start_date]) &#10;END)' />
            </column>
            <column caption='Dynamic Select KPI PF' datatype='real' name='[Calculation_6294273116273876999]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 4] = &apos;Partial FF Orders&apos; then [successful orders (copy)_6294273116265537539]&#10;elseif [Parameters].[Parameter 4] = &apos;%Partial FF Orders&apos; then [Partial Fulfilled Orders (copy)_6294273116265771012]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Avg Missing SKU/Order&apos; then [% Partial Fulfilled Orders (copy)_6294273116270727173]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Avg Missing Item/Order&apos; then [Avg # Missing SKU in Partial Fulfilled (copy)_6294273116272156678]&#10;//ELSEIF [Select KPI PF] = &apos;Total Value Lost (Euro)&apos; then [Partial Order Value Lost (Euro)]&#10;end' />
            </column>
            <column caption='Peak Hours Flag' datatype='string' name='[Calculation_6867074649023840266]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [order_start_hour] &gt;= 17 and [order_start_hour] &lt;= 21 then &quot;Peak Hours&quot;&#10;ELSE &quot;Non Peak Hours&quot;&#10;END' />
            </column>
            <column caption='% Partial Fulfilled Orders' datatype='real' name='[Partial Fulfilled Orders (copy)_6294273116265771012]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100*([successful orders (copy)_6294273116265537539]/sum([Calculation_6284632595905806336]))' />
            </column>
            <column datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
