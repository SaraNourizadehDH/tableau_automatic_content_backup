      <datasources>
        <datasource name='Parameters' />
        <datasource caption='ac_of_rl_v1 (temp_qc)' name='federated.0ke59kw1wad9zj0zw1x8v1l4vast' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column alias='Daily' caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;day&quot;'>
          <calculation class='tableau' formula='&quot;day&quot;' />
          <aliases>
            <alias key='&quot;day&quot;' value='Daily' />
            <alias key='&quot;month&quot;' value='Monthly' />
            <alias key='&quot;quarter&quot;' value='Quarterly' />
            <alias key='&quot;week&quot;' value='Weekly' />
          </aliases>
          <members>
            <member alias='Daily' value='&quot;day&quot;' />
            <member alias='Weekly' value='&quot;week&quot;' />
            <member alias='Monthly' value='&quot;month&quot;' />
            <member alias='Quarterly' value='&quot;quarter&quot;' />
          </members>
        </column>
        <column caption='Select KPI OF' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Avg. Picking Time (s) per Item&quot;'>
          <calculation class='tableau' formula='&quot;Avg. Picking Time (s) per Item&quot;' />
          <members>
            <member value='&quot;Avg Assignment Time(m)&quot;' />
            <member value='&quot;Avg Picking Time(m)&quot;' />
            <member value='&quot;Avg Packaging Time(m)&quot;' />
            <member value='&quot;Avg Adj. Dispatch Time(m)&quot;' />
            <member value='&quot;Avg Total Store Time(m)&quot;' />
            <member value='&quot;Avg. Picking Time (s) per Item&quot;' />
            <member value='&quot;Avg. Packaging Time (s) per Item&quot;' />
          </members>
        </column>
      </datasource-dependencies>
