      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/StoreOps-OrderFulfilmentDashboard/OFMetrics?rev=' id='OFMetrics' path='/t/GlobalStandardReporting/workbooks/StoreOps-OrderFulfilmentDashboard' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='dash-text'>
          <format attr='text-align' id='dash-text_24' value='left' />
        </style-rule>
        <style-rule element='parameter-ctrl'>
          <format attr='background-color' value='#f5f5f5' />
          <format attr='border-style' value='solid' />
          <format attr='border-color' value='#000000' />
        </style-rule>
      </style>
