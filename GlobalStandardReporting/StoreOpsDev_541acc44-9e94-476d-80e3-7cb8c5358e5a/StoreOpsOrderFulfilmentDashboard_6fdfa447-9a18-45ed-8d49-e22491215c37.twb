      <aliases enabled='yes' />
      <column caption='Avg # Missing SKU in Partial Fulfilled' datatype='real' name='[% Partial Fulfilled Orders (copy)_6294273116270727173]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [partial_order] then [skus_ordered] - [skus_delivered] else 0 END) /&#10;sum(IF [partial_order] and [skus_ordered] &gt; [skus_delivered] then [Calculation_6284632595905806336] else 0 END)' />
      </column>
      <column caption='Avg # Missing Items in Partial Fulfilled' datatype='real' name='[Avg # Missing SKU in Partial Fulfilled (copy)_6294273116272156678]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [partial_order] then [qty_ordered] - [qty_delivered] else 0 END) /&#10;sum(IF [partial_order] then [Calculation_6284632595905806336] else 0 END)' />
      </column>
      <column caption='Avg. Adj Dispatching Time (m) ' datatype='real' name='[Avg. Dispatching Time (m) (copy)_6294273116355223560]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum(IF [is_sent] then [adj_dispatch_time] else 0 END)/ sum(if [adj_dispatch_flag] then [Calculation_6284632595905806336] else 0 end)) /60' />
      </column>
      <column caption='Avg. Picking Time (s) per SKU' datatype='real' name='[Avg. Picking Time (m) (copy)_6294273115995271169]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [is_sent] then [picking_time_s] else 0 END)/sum([skus_delivered])' />
      </column>
      <column caption='Avg. Picking Time (s) per Item' datatype='real' name='[Avg. Picking Time (m) per SKU (copy)_6294273115996135426]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [is_sent] then [picking_time_s] else 0 END)/sum([qty_delivered])' />
      </column>
      <column caption='Avg. Packaging Time (s) per Item' datatype='real' name='[Avg. Picking Time (s) per Item (copy)_856950585233027072]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [is_sent] then [packaging_time_s] else 0 END)/sum([qty_delivered])' />
      </column>
      <column caption='Avg Basket Size(item)' datatype='real' name='[Basket Size(SKU) (copy)_6284632597311836167]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([qty_delivered])/sum([Calculation_6284632595905806336])' />
      </column>
      <column caption='Partial Order Value Lost (Euro)' datatype='real' name='[Calculation_3801812207050268672]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [partial_order] then [order_value_euro] else 0 END)' />
      </column>
      <column caption='Avg Basket Value(Euro)' datatype='real' name='[Calculation_5907948718584860672]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([order_value_euro])/sum([Calculation_6284632595905806336])' />
      </column>
      <column caption='successful orders' datatype='integer' name='[Calculation_6284632595905806336]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_sent] then [num_orders] else 0 END' />
      </column>
      <column caption='Avg Dispatch Order wait time' datatype='real' name='[Calculation_6284632595917324289]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum(IF [is_sent] then [dispatch_order_wait_time] else 0 END) / sum([Calculation_6284632595905806336]))/60' />
      </column>
      <column caption='Avg Dispatch Rider Pickup Time' datatype='real' name='[Calculation_6284632595917549570]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum(IF [is_sent] then [dispatch_rider_pickup_time] else 0 END)/sum([Calculation_6284632595905806336]))/60' />
      </column>
      <column caption='Dynamic Date' datatype='date' datatype-customized='true' name='[Calculation_6284632596197068803]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 1] &#10;WHEN &apos;day&apos; THEN DATETRUNC(&apos;day&apos;, [order_start_date]) &#10;WHEN &apos;week&apos; THEN DATETRUNC(&apos;week&apos;, [order_start_date])&#10;WHEN &apos;month&apos; THEN DATETRUNC(&apos;month&apos;, [order_start_date])  &#10;WHEN &apos;quarter&apos; THEN DATETRUNC(&apos;quarter&apos;, [order_start_date]) &#10;END)' />
      </column>
      <column caption='Dynamic KPI Select OF' datatype='real' name='[Calculation_6284632597251702788]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 2] = &apos;Avg Assignment Time(m)&apos; then [Calculation_6867074648984064006] &#10;elseif [Parameters].[Parameter 2] = &apos;Avg Picking Time(m)&apos; then [Calculation_6867074648985595912]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Avg Packaging Time(m)&apos; then [Calculation_6867074648985370631]&#10;//ELSEIF [Select KPI OF] = &apos;Avg Dispatch Order Wait Time&apos; then [Avg Dispatch Order wait time]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Avg Adj. Dispatch Time(m)&apos; then [Avg. Dispatching Time (m) (copy)_6294273116355223560]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Avg Total Store Time(m)&apos; then [Calculation_6867074648997535753]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Avg. Picking Time (s) per Item&apos; then [Avg. Picking Time (m) per SKU (copy)_6294273115996135426]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Avg. Packaging Time (s) per Item&apos; then [Avg. Picking Time (s) per Item (copy)_856950585233027072]&#10;end' />
      </column>
      <column caption='Dynamic KPI select orders' datatype='real' name='[Calculation_6284632597310275589]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 3] = &apos;Successful Orders&apos; then sum([Calculation_6284632595905806336])&#10;elseif [Parameters].[Parameter 3] = &apos;Avg Basket Size(SKU)&apos; then [Calculation_6284632597310476294]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Avg Basket Size(Item)&apos; then [Basket Size(SKU) (copy)_6284632597311836167]&#10;elseif [Parameters].[Parameter 3] = &apos;Avg Basket Value(Euro)&apos; then [Calculation_5907948718584860672]&#10;end' />
      </column>
      <column caption='Avg Basket Size(SKU)' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_6284632597310476294]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([skus_delivered])/sum([Calculation_6284632595905806336])' />
      </column>
      <column caption='Dynamic Select KPI PF' datatype='real' name='[Calculation_6294273116273876999]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 4] = &apos;Partial FF Orders&apos; then [successful orders (copy)_6294273116265537539]&#10;elseif [Parameters].[Parameter 4] = &apos;%Partial FF Orders&apos; then [Partial Fulfilled Orders (copy)_6294273116265771012]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Avg Missing SKU/Order&apos; then [% Partial Fulfilled Orders (copy)_6294273116270727173]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Avg Missing Item/Order&apos; then [Avg # Missing SKU in Partial Fulfilled (copy)_6294273116272156678]&#10;//ELSEIF [Select KPI PF] = &apos;Total Value Lost (Euro)&apos; then [Partial Order Value Lost (Euro)]&#10;end' />
      </column>
      <column caption='Total Warehouse with Dispatch' datatype='integer' name='[Calculation_6867074648950571009]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([warehouse_id])' />
      </column>
      <column caption='LastWeek' datatype='string' name='[Calculation_6867074648955899906]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF Datediff(&apos;week&apos;,[order_start_date],TODAY(),&apos;sunday&apos;)=1 then &quot;Show&quot;&#10;ELSE &quot;Hide&quot;&#10;END' />
      </column>
      <column caption='Avg. Dispatching Time (m)' datatype='real' name='[Calculation_6867074648979120132]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum(IF [is_sent] then [store_dispatch_time_s] else 0 END)/ sum([Calculation_6284632595905806336])) /60' />
      </column>
      <column caption='Avg. Assignment Time (m)' datatype='real' name='[Calculation_6867074648984064006]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF [is_sent] then [assignment_time_s] else 0 END)/SUM([Calculation_6284632595905806336])) / 60' />
      </column>
      <column caption='Avg. Packaging Time (m)' datatype='real' name='[Calculation_6867074648985370631]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum(IF [is_sent] then [packaging_time_s] else 0 END)/sum([Calculation_6284632595905806336])) / 60' />
      </column>
      <column caption='Avg. Picking Time (m)' datatype='real' name='[Calculation_6867074648985595912]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum(IF [is_sent] then [picking_time_s] else 0 END)/sum([Calculation_6284632595905806336])) / 60' />
      </column>
      <column caption='Avg Total Store Time (m)' datatype='real' name='[Calculation_6867074648997535753]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_6867074648984064006] + [Calculation_6867074648985595912] + [Calculation_6867074648985370631] + [Avg. Dispatching Time (m) (copy)_6294273116355223560]' />
