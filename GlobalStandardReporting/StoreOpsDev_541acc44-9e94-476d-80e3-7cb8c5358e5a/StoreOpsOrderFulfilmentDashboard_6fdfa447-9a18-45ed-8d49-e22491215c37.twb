    <worksheet name='DD_OP_Dispatch_Ord_DT'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>Avg Store Dispatch Time by #Dispatch Bags</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='ac_of_rl_v1 (temp_qc)' name='federated.0ke59kw1wad9zj0zw1x8v1l4vast' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Daily' caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;day&quot;'>
              <calculation class='tableau' formula='&quot;day&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;quarter&quot;' value='Quarterly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ke59kw1wad9zj0zw1x8v1l4vast'>
            <column caption='Avg. Adj Dispatching Time (m) ' datatype='real' name='[Avg. Dispatching Time (m) (copy)_6294273116355223560]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum(IF [is_sent] then [adj_dispatch_time] else 0 END)/ sum(if [adj_dispatch_flag] then [Calculation_6284632595905806336] else 0 end)) /60' />
            </column>
