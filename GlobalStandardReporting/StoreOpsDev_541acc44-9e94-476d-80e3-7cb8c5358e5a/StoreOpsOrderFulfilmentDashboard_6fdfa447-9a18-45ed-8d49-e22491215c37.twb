    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='UserGuide'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/StoreOps-OrderFulfilmentDashboard/UserGuide?rev=' id='UserGuide' path='/t/GlobalStandardReporting/workbooks/StoreOps-OrderFulfilmentDashboard' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='dash-text'>
          <format attr='text-align' id='dash-text_24' value='left' />
        </style-rule>
      </style>
      <size maxheight='1000' maxwidth='1100' minheight='1000' minwidth='1100' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98400' id='364' param='vert' type-v2='layout-flow' w='98546' x='727' y='800'>
            <zone h='98400' id='362' type-v2='layout-basic' w='98546' x='727' y='800'>
              <zone h='31599' id='30' param='horz' type-v2='layout-flow' w='98546' x='727' y='800'>
                <zone h='31599' id='28' type-v2='layout-basic' w='98546' x='727' y='800'>
                  <zone h='16186' id='7' param='horz' type-v2='layout-flow' w='98546' x='727' y='16213'>
                    <zone h='16186' id='5' type-v2='layout-basic' w='98546' x='727' y='16213'>
                      <zone forceUpdate='true' h='16186' id='11' type-v2='text' w='98546' x='727' y='16213'>
                        <formatted-text>
                          <run bold='true' fontcolor='#000000' fontsize='16'>Order Metrics:</run>
                          <run fontcolor='#000000' fontsize='16'> Captures basic order related metrics </run>
                          <run>Æ&#10;</run>
                          <run bold='true' fontcolor='#000000' fontsize='16'>OF Metrics: </run>
                          <run fontcolor='#000000' fontsize='16'>Captures order fulfilment metrics</run>
                          <run>Æ&#10;</run>
                          <run bold='true' fontcolor='#000000' fontsize='16'>DD OF: </run>
                          <run fontcolor='#000000' fontsize='16'>Captures drill down of order fulfillment metrics</run>
                          <run>Æ&#10;</run>
                          <run bold='true' fontcolor='#000000' fontsize='16'>Partial FF: </run>
                          <run fontcolor='#000000' fontsize='16'>Captures partial fulfillment metrics</run>
                          <run>Æ&#10;</run>
                          <run bold='true' fontcolor='#000000' fontsize='16'>OF Warehouse DD: </run>
                          <run fontcolor='#000000' fontsize='16'>Captures warehouse drill down for all the metrics</run>
                          <run>Æ&#10;&#10;</run>
                        </formatted-text>
                        <zone-style>
                          <format attr='border-color' value='#000000' />
                          <format attr='border-style' value='none' />
                          <format attr='border-width' value='0' />
                          <format attr='margin' value='4' />
                        </zone-style>
                      </zone>
                    </zone>
                  </zone>
                  <zone forceUpdate='true' h='10083' id='22' type-v2='text' w='82023' x='17250' y='800'>
                    <formatted-text>
                      <run bold='true' fontalignment='1' fontcolor='#e15759' fontsize='28'>Store Ops  | ORDER FULFILMENT DASHBOARD</run>
                      <run>Æ&#10;</run>
                      <run bold='true' fontcolor='#c0c0c0' fontsize='15' italic='true'>          Quick Commerce         </run>
                      <run bold='true' fontcolor='#e15759' fontsize='15'>| USER GUIDE</run>
                    </formatted-text>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
                    </zone-style>
                  </zone>
                  <zone h='10083' id='23' is-scaled='1' param='Image/Delivery-Hero-Comet.png' type-v2='bitmap' w='16523' x='727' y='800'>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
                    </zone-style>
                  </zone>
                  <zone forceUpdate='true' h='5330' id='24' type-v2='text' w='88546' x='727' y='10883'>
                    <formatted-text>
                      <run bold='true' fontcolor='#ffffff' fontsize='16'>Dasboard Overview</run>
                    </formatted-text>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
                      <format attr='background-color' value='#000000' />
                    </zone-style>
                  </zone>
                  <zone alt-text='Fulfillment Ops' h='5330' id='359' is-scaled='1' param='Image/Learn-More-PNG-Free-Image.png' type-v2='bitmap' url='https://confluence.deliveryhero.com/display/GBU/Project+Neev+-+Order+Fulfilment+Data+Foundation' w='10000' x='89273' y='10883'>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
                    </zone-style>
                  </zone>
                </zone>
              </zone>
              <zone forceUpdate='true' h='61101' id='174' type-v2='text' w='98546' x='727' y='38099'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontsize='14'>Successful orders:</run>
                  <run fontcolor='#000000' fontsize='14'> Total number of orders successfully delivered</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='14'>Avg Basket Size(SKU):</run>
                  <run fontcolor='#000000' fontsize='14'> Number of SKUs on average delivered in an order</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='14'>Avg Basket Size(Item): </run>
                  <run fontcolor='#000000' fontsize='14'>Number of Items on average delivered in an order</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='14'>Avg Basket Value(Euro):</run>
                  <run fontcolor='#000000' fontsize='14'> Avg value(Euro) of an order placed by the customer</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='14'>Avg Assignment Time:</run>
                  <run fontcolor='#000000' fontsize='14'> Avg time(mins) an order stays on the pelican without being assigned to a picker</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='14'>Avg picking Time: </run>
                  <run fontcolor='#000000' fontsize='14'>Avg time(mins) a picker takes to pick all the items for an order</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='14'>Avg packaging Time:</run>
                  <run fontcolor='#000000' fontsize='14'> Avg time(mins) a picker takes to pack an order</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='14'>Avg Dispatch Order wait Time:</run>
                  <run fontcolor='#000000' fontsize='14'> Avg time(mins) an order waits on the shelf until the rider is near the dmart</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='14'>Avg Adj. Dispatch Time:</run>
                  <run fontcolor='#000000' fontsize='14'> Avg time(mins) taken by a rider to pick up an order when the order is ready for pick up and rider is near Dmart</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='14'>Avg Dispatch Time:</run>
                  <run fontcolor='#000000' fontsize='14'> Avg time(mins) taken by rider to pick up an order once it is ready for pick up</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='14'>Avg Total Store Time:</run>
                  <run fontcolor='#000000' fontsize='14'> Avg total time taken for an order leave the Dmart from the time it is available on pelican</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='14'>Avg Picking Time(s) per SKU:</run>
                  <run fontcolor='#000000' fontsize='14'> Avg time taken by a picker to pick a SKU</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='14'>Avg Picking Time(s) per Item:</run>
                  <run fontcolor='#000000' fontsize='14'> Avg time taken by a picker to pick an Item</run>
