                <zone alt-text='Fulfillment Ops' fixed-size='45' h='5330' id='359' is-fixed='true' is-scaled='1' param='Image/Learn-More-PNG-Free-Image.png' type-v2='bitmap' url='https://confluence.deliveryhero.com/display/GBU/Project+Neev+-+Order+Fulfilment+Data+Foundation' w='10000' x='89273' y='10883'>
