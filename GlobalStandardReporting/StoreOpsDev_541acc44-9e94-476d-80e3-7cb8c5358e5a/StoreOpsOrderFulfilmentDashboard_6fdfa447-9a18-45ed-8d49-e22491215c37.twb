            <column caption='Is Sent' datatype='boolean' name='[is_sent]' role='dimension' type='nominal' />
            <column datatype='string' name='[key_market]' role='dimension' type='nominal' />
            <column caption='Manual Dispatching' datatype='integer' name='[manual_dispatching]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_6867074649023840266]' derivation='None' name='[none:Calculation_6867074649023840266:nk]' pivot='key' type='nominal' />
            <column-instance column='[Total_dispatch_Bag_buckt]' derivation='None' name='[none:Total_dispatch_Bag_buckt:nk]' pivot='key' type='nominal' />
            <column-instance column='[city]' derivation='None' name='[none:city:nk]' pivot='key' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
