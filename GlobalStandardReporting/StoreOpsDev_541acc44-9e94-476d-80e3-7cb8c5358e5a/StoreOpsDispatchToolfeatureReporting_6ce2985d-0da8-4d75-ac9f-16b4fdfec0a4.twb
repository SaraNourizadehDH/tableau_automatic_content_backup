    <worksheet name='Engg_StoreTime_Trend'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>Avg. Total Store Time by Region</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='_tableau_store_performance_w_dispatch_flag (temp_qc)' name='federated.1454g7f0fa7j7q1cbsnpj12o5xhd' />
          </datasources>
          <datasource-dependencies datasource='federated.1454g7f0fa7j7q1cbsnpj12o5xhd'>
            <column caption='Avg. Dispatching Time (m)' datatype='real' name='[Calculation_6867074648979120132]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([store_dispatch_time_s])/ sum([store_dispatch_time_count])) /86400' />
            </column>
            <column caption='Avg. Assignment Time (m)' datatype='real' name='[Calculation_6867074648984064006]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([assignment_time_s])/SUM([assignment_time_count])) / 86400' />
            </column>
            <column caption='Avg. Packaging Time (m)' datatype='real' name='[Calculation_6867074648985370631]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([packaging_time_s])/sum([packaging_time_count])) / 86400' />
            </column>
            <column caption='Avg. Picking Time (m)' datatype='real' name='[Calculation_6867074648985595912]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([picking_time_s])/sum([picking_time_count])) / 86400' />
            </column>
            <column caption='Total Store Time (m)' datatype='real' name='[Calculation_6867074648997535753]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6867074648984064006] + [Calculation_6867074648985595912] + [Calculation_6867074648985370631] +[Calculation_6867074648979120132]' />
            </column>
            <column caption='Peak Hours Flag' datatype='string' name='[Calculation_6867074649023840266]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [static_hour] &gt;= 17 and [static_hour] &lt;= 21 then &quot;Peak Hours&quot;&#10;ELSE &quot;Non Peak Hours&quot;&#10;END' />
            </column>
            <column caption='Is Preorder' datatype='boolean' name='[Calculation_6867074649723502604]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [preorders] &gt; 1 THEN TRUE &#10;ELSE FALSE&#10;END' />
