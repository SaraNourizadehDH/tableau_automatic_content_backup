      <aliases enabled='yes' />
      <column caption='Avg. Picking Time (m) V2' datatype='real' name='[Avg. Picking Time (m) (copy)_806003653025226752]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([picking_time_s])/sum([picking_time_count])) / 60' />
      </column>
      <column caption='Dynamic Select Metric' datatype='real' name='[Calculation_4954452227479814145]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='If [Parameters].[Parameter 1] = &apos;Warehouse W Dispatch Tool&apos; then [Calculation_6867074648950571009]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;%Warehouse W Dispatch Tool&apos; then [Total Warehouse with Dispatch (copy)_4954452227479359488]&#10;END' />
      </column>
      <column caption='Total Warehouse with Dispatch' datatype='integer' name='[Calculation_6867074648950571009]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [dispatch_tool_flag] = 1 then [warehouse_id] END)' />
      </column>
      <column caption='LastWeek' datatype='string' name='[Calculation_6867074648955899906]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF Datediff(&apos;week&apos;,[static_day],TODAY(),&apos;sunday&apos;)=1 then &quot;Show&quot;&#10;ELSE &quot;Hide&quot;&#10;END' />
      </column>
      <column caption='Avg. Dispatching Time (m)' datatype='real' name='[Calculation_6867074648979120132]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([store_dispatch_time_s])/ sum([store_dispatch_time_count])) /86400' />
      </column>
      <column caption='Avg. Assignment Time (m)' datatype='real' name='[Calculation_6867074648984064006]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([assignment_time_s])/SUM([assignment_time_count])) / 86400' />
      </column>
      <column caption='Avg. Packaging Time (m)' datatype='real' name='[Calculation_6867074648985370631]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([packaging_time_s])/sum([packaging_time_count])) / 86400' />
      </column>
      <column caption='Avg. Picking Time (m)' datatype='real' name='[Calculation_6867074648985595912]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([picking_time_s])/sum([picking_time_count])) / 86400' />
      </column>
      <column caption='Total Store Time (m)' datatype='real' name='[Calculation_6867074648997535753]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_6867074648984064006] + [Calculation_6867074648985595912] + [Calculation_6867074648985370631] +[Calculation_6867074648979120132]' />
      </column>
      <column caption='Peak Hours Flag' datatype='string' name='[Calculation_6867074649023840266]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [static_hour] &gt;= 17 and [static_hour] &lt;= 21 then &quot;Peak Hours&quot;&#10;ELSE &quot;Non Peak Hours&quot;&#10;END' />
      </column>
      <column caption='Is Preorder' datatype='boolean' name='[Calculation_6867074649723502604]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [preorders] &gt; 1 THEN TRUE &#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='%Warehouse w Dispatch Tool' datatype='real' name='[Total Warehouse with Dispatch (copy)_4954452227479359488]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100*(COUNTD(if [dispatch_tool_flag] = 1 then [warehouse_id] END)/ COUNTD([warehouse_id]))' />
      </column>
      <column caption='Warehouse ID with Dispatch' datatype='string' name='[Total Warehouse with Dispatch (copy)_806003653062324235]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [dispatch_tool_flag] = 1 then [warehouse_id] END' />
      </column>
