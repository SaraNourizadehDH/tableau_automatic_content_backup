      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1pr9nu20e9exje19fzoqa1mnokh0].[usr:Avg. Receiving Time / SKU (copy)_4974577639090315265:qk]&quot;' value='Avg. Receiving Time / SKU' />
        </aliases>
      </column>
      <column caption='Avg. Receiving Time / PO (Intervention)' datatype='real' name='[Avg. Receiving Time / SKU (Intervention) (copy)_4974577639149912067]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Receiving_Time_Intervention])/COUNTD([po_order_id])/60' />
      </column>
      <column caption='Avg. Receiving Time / SKU (Intervention)' datatype='real' name='[Avg. Receiving Time / SKU (copy)_4974577639090315265]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Receiving_Time_Intervention])/sum([unique_SKUs])' />
      </column>
      <column caption='Avg. Receiving Time / SKU' datatype='real' name='[Calculation_4974577639089352704]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Receiving_Time])/sum([unique_SKUs])' />
      </column>
      <column caption='Quantity Received' datatype='integer' name='[Calculation_4974577639145533442]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[quantity_delivered] - [quantity_returned]' />
      </column>
      <column caption='Avg. SKUs / PO' datatype='real' name='[Calculation_4974577639151423493]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([unique_SKUs])/COUNTD([po_order_id])' />
      </column>
