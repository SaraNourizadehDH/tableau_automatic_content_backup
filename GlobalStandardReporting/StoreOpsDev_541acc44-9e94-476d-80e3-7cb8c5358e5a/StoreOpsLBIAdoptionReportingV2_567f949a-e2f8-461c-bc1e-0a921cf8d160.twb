            </column>
            <column caption='Order Qty pos' datatype='real' name='[Order_Qty_pos]' role='measure' type='quantitative' />
            <column caption='Order Qty pre' datatype='real' name='[Order_Qty_pre]' role='measure' type='quantitative' />
