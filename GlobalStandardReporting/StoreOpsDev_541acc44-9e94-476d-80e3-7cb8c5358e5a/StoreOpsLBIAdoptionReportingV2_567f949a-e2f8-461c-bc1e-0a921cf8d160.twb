    <worksheet name='WN_Adop_Kpis'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>LBI Adoption by Dmarts</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location id='WN_Adop_Kpis' path='/t/GlobalStandardReporting/workbooks/StoreOpsLBIAdoptionReporting' revision='' site='GlobalStandardReporting' />
      <table>
        <view>
          <datasources>
            <datasource caption='ac_lbi_adoption_v1 (rl_dmart)' name='federated.1ue965t0u0jrpe1dkn6sk0gwr595' />
          </datasources>
          <datasource-dependencies datasource='federated.1ue965t0u0jrpe1dkn6sk0gwr595'>
            <column caption='SKU_Adoption_Flag' datatype='string' name='[Calculation_5070912468961271808]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [active_sku_count_w_location] / [active_sku_count] &gt; 0.8 &#10;then &apos;Yes&apos;&#10;ELSE &apos;No&apos; END' />
            </column>
            <column caption='%LBI Started DMarts' datatype='real' name='[Calculation_6471039405516255232]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(COUNTD(if [Calculation_6471039405526024194] = 1 then [warehouse_id] END)/ COUNTD([warehouse_id]))' />
            </column>
            <column caption='LBI Started DMarts' datatype='integer' name='[Calculation_6471039405525856257]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if [Calculation_6471039405526024194] = 1 then [warehouse_id] else null end)' />
            </column>
            <column caption='LBI RollOut Flag' datatype='integer' name='[Calculation_6471039405526024194]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL([first_batch_date]) then 0 else 1 END' />
            </column>
            <column datatype='string' name='[Region]' role='dimension' type='nominal' />
            <column caption='LBI 80%SKU DMarts' datatype='integer' name='[Total Warehouse W LBI (copy)_6623035884861313024]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if [Calculation_6471039405526024194] = 1 AND [Calculation_5070912468961271808] = &apos;Yes&apos; then [warehouse_id] else null end)' />
            </column>
            <column caption='Active Sku Count' datatype='integer' name='[active_sku_count]' role='measure' type='quantitative' />
            <column caption='Active Sku Count W Location' datatype='integer' name='[active_sku_count_w_location]' role='measure' type='quantitative' />
            <column caption='City' datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='First Batch Date' datatype='date' name='[first_batch_date]' role='dimension' type='ordinal' />
            <column-instance column='[Region]' derivation='None' name='[none:Region:nk]' pivot='key' type='nominal' />
            <column-instance column='[city]' derivation='None' name='[none:city:nk]' pivot='key' type='nominal' />
