            <column-instance column='[warehouse_name]' derivation='None' name='[none:warehouse_name:nk]' pivot='key' type='nominal' />
            <column caption='Order Qty' datatype='real' name='[order_qty]' role='measure' type='quantitative' />
            <column caption='Order Skus Delivered' datatype='integer' name='[order_skus_delivered]' role='measure' type='quantitative' />
            <column caption='Partial Orders' datatype='integer' name='[partial_orders]' role='measure' type='quantitative' />
