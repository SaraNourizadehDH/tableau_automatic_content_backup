      <aliases enabled='yes' />
      <column caption='%LBI 80%SKU DMarts' datatype='real' name='[%warehouse w LBI (copy)_6623035884862967810]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(COUNTD(if [Calculation_6471039405526024194] = 1 AND [Calculation_5070912468961271808] = &apos;Yes&apos;  then [warehouse_id] END)/ COUNTD([warehouse_id]))' />
      </column>
      <column caption='Dynamic Date' datatype='date' name='[Calculation_3913065188393480192]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 3] &#10;WHEN &apos;Day&apos; THEN DATETRUNC(&apos;day&apos;, [static_day]) &#10;WHEN &apos;Week&apos; THEN DATETRUNC(&apos;week&apos;, [static_day])&#10;WHEN &apos;Month&apos; THEN DATETRUNC(&apos;month&apos;, [static_day])  &#10;WHEN &apos;Quarter&apos; THEN DATETRUNC(&apos;quarter&apos;, [static_day]) &#10;END)' />
      </column>
      <column caption='SKU_Adoption_Flag' datatype='string' name='[Calculation_5070912468961271808]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [active_sku_count_w_location] / [active_sku_count] &gt; 0.8 &#10;then &apos;Yes&apos;&#10;ELSE &apos;No&apos; END' />
      </column>
      <column caption='Avg. Picking Time per Sku (s)' datatype='real' name='[Calculation_586664278850273287]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([picking_time_s]) / SUM([order_skus_delivered]))' />
      </column>
      <column caption='Avg. Picking Time per Item (s)' datatype='real' name='[Calculation_586664278850514952]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([picking_time_s]) / SUM([order_qty]))' />
      </column>
      <column caption='Partial Fulfilment Rate (%)' datatype='real' name='[Calculation_586664278850826249]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn(sum([partial_orders])/sum([successful_orders]))' />
      </column>
      <column caption='Dynamic Order Metrics' datatype='real' name='[Calculation_586664278852558859]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='If [Parameters].[Parameter 2] = &apos;Avg Picking Time Per SKU&apos; then [Calculation_586664278850273287]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Avg Picking Time Per Item&apos; then [Calculation_586664278850514952]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;%Partal Fulfillment Rate&apos; then [Calculation_586664278850826249]&#10;END' />
      </column>
      <column caption='%LBI Started DMarts' datatype='real' name='[Calculation_6471039405516255232]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(COUNTD(if [Calculation_6471039405526024194] = 1 then [warehouse_id] END)/ COUNTD([warehouse_id]))' />
      </column>
      <column caption='LBI Started DMarts' datatype='integer' name='[Calculation_6471039405525856257]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [Calculation_6471039405526024194] = 1 then [warehouse_id] else null end)' />
      </column>
      <column caption='LBI RollOut Flag' datatype='integer' name='[Calculation_6471039405526024194]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([first_batch_date]) then 0 else 1 END' />
      </column>
      <column caption='Dynamic Warehouse Adoption' datatype='real' name='[Calculation_6471039405526507523]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='If [Parameters].[Parameter 1] = &apos;Total Warehouse W LBI&apos; then [Calculation_6471039405525856257]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;%Warehouse W LBI&apos; then [Calculation_6471039405516255232]&#10;END' />
      </column>
      <column caption='Avg. Dispatching Time (m)' datatype='real' name='[Calculation_6867074648979120132]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([store_dispatch_time_s])/ sum([store_dispatch_time_count])) /86400' />
      </column>
      <column caption='Peak Hours Flag' datatype='string' name='[Calculation_6867074649023840266]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [static_hour] &gt;= 17 and [static_hour] &lt;= 21 then &quot;Peak Hours&quot;&#10;ELSE &quot;Non Peak Hours&quot;&#10;END' />
      </column>
      <column caption='Is Preorder' datatype='boolean' name='[Calculation_6867074649723502604]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [preorders] &gt; 1 THEN TRUE &#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='LBI 80%SKU DMarts' datatype='integer' name='[Total Warehouse W LBI (copy)_6623035884861313024]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [Calculation_6471039405526024194] = 1 AND [Calculation_5070912468961271808] = &apos;Yes&apos; then [warehouse_id] else null end)' />
      </column>
      <column caption='T.DMarts' datatype='integer' name='[Total Warehouse W LBI (copy)_6623035884861706241]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([warehouse_id])' />
      </column>
