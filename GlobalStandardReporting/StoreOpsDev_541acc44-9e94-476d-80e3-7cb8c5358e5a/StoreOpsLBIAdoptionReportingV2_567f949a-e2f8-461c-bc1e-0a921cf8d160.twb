    <worksheet name='OF_Country_Trend'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>Country Metric Trend</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='ac_lbi_adoption_v1 (rl_dmart)' name='federated.1ue965t0u0jrpe1dkn6sk0gwr595' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Order Metrics' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Avg Picking Time Per Item&quot;'>
              <calculation class='tableau' formula='&quot;Avg Picking Time Per Item&quot;' />
            </column>
            <column alias='Daily' caption='Date Granularity' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
              <calculation class='tableau' formula='&quot;Day&quot;' />
              <aliases>
                <alias key='&quot;Day&quot;' value='Daily' />
                <alias key='&quot;Month&quot;' value='Monthly' />
                <alias key='&quot;Quarter&quot;' value='Quarterly' />
                <alias key='&quot;Week&quot;' value='Weekly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ue965t0u0jrpe1dkn6sk0gwr595'>
            <column caption='Dynamic Date' datatype='date' name='[Calculation_3913065188393480192]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 3] &#10;WHEN &apos;Day&apos; THEN DATETRUNC(&apos;day&apos;, [static_day]) &#10;WHEN &apos;Week&apos; THEN DATETRUNC(&apos;week&apos;, [static_day])&#10;WHEN &apos;Month&apos; THEN DATETRUNC(&apos;month&apos;, [static_day])  &#10;WHEN &apos;Quarter&apos; THEN DATETRUNC(&apos;quarter&apos;, [static_day]) &#10;END)' />
            </column>
            <column caption='Avg. Picking Time per Sku (s)' datatype='real' name='[Calculation_586664278850273287]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([picking_time_s]) / SUM([order_skus_delivered]))' />
            </column>
            <column caption='Avg. Picking Time per Item (s)' datatype='real' name='[Calculation_586664278850514952]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([picking_time_s]) / SUM([order_qty]))' />
            </column>
            <column caption='Partial Fulfilment Rate (%)' datatype='real' name='[Calculation_586664278850826249]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(sum([partial_orders])/sum([successful_orders]))' />
            </column>
            <column caption='Dynamic Order Metrics' datatype='real' name='[Calculation_586664278852558859]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='If [Parameters].[Parameter 2] = &apos;Avg Picking Time Per SKU&apos; then [Calculation_586664278850273287]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Avg Picking Time Per Item&apos; then [Calculation_586664278850514952]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;%Partal Fulfillment Rate&apos; then [Calculation_586664278850826249]&#10;END' />
            </column>
            <column caption='LBI RollOut Flag' datatype='integer' name='[Calculation_6471039405526024194]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL([first_batch_date]) then 0 else 1 END' />
            </column>
            <column caption='Peak Hours Flag' datatype='string' name='[Calculation_6867074649023840266]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [static_hour] &gt;= 17 and [static_hour] &lt;= 21 then &quot;Peak Hours&quot;&#10;ELSE &quot;Non Peak Hours&quot;&#10;END' />
            </column>
            <column caption='Is Preorder' datatype='boolean' name='[Calculation_6867074649723502604]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [preorders] &gt; 1 THEN TRUE &#10;ELSE FALSE&#10;END' />
            </column>
            <column datatype='string' name='[Region]' role='dimension' type='nominal' />
            <column caption='City' datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='First Batch Date' datatype='date' name='[first_batch_date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_6471039405526024194]' derivation='None' name='[none:Calculation_6471039405526024194:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_6867074649023840266]' derivation='None' name='[none:Calculation_6867074649023840266:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_6867074649723502604]' derivation='None' name='[none:Calculation_6867074649723502604:nk]' pivot='key' type='nominal' />
            <column-instance column='[Region]' derivation='None' name='[none:Region:nk]' pivot='key' type='nominal' />
            <column-instance column='[city]' derivation='None' name='[none:city:nk]' pivot='key' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
