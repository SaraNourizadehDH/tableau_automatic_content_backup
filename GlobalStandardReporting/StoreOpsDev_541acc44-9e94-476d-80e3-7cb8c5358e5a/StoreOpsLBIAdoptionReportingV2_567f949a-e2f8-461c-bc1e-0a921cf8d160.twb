            <column caption='Preorders' datatype='integer' name='[preorders]' role='measure' type='quantitative' />
            <column caption='Static Day' datatype='date' name='[static_day]' role='dimension' type='ordinal' />
            <column caption='Static Hour' datatype='integer' name='[static_hour]' role='measure' type='quantitative' />
            <column caption='Successful Orders' datatype='integer' name='[successful_orders]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_3913065188393480192]' derivation='Day-Trunc' name='[tdy:Calculation_3913065188393480192:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_586664278852558859]' derivation='User' name='[usr:Calculation_586664278852558859:qk]' pivot='key' type='quantitative' />
            <column caption='Warehouse Name' datatype='string' name='[warehouse_name]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1ue965t0u0jrpe1dkn6sk0gwr595].[none:Calculation_6471039405526024194:ok]' filter-group='18'>
