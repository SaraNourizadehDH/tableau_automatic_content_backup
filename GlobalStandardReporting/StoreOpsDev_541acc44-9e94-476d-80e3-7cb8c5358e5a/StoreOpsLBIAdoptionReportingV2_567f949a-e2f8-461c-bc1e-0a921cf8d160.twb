      <aliases enabled='yes' />
      <column caption='%Change Partial Fulfilment' datatype='real' name='[Calculation_6289206527078100992]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(((sum([Partial_Orders_pos])/sum([successful_orders_pos]))&#10;/ &#10;(sum([Partial_Orders_pre])/sum([successful_orders_pre]))) - 1)' />
      </column>
      <column caption='%Change Picking Time Per Unit' datatype='real' name='[Calculation_6289206527078301697]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(((sum([picking_time_s_pos])/sum([Order_Qty_pos]))&#10;/ &#10;(sum([picking_time_s_pre])/sum([Order_Qty_pre]))) - 1)' />
      </column>
      <column caption='Avg Picking Time Per Unit' datatype='real' name='[Calculation_6289206527078453250]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([picking_time_s]) / SUM([Order_Qty]))' />
      </column>
      <column caption='Partial Fulfilment Rate' datatype='real' name='[Calculation_6289206527078940676]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn(sum([Partial_Orders])/sum([successful_orders]))' />
      </column>
