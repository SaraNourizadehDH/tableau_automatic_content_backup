                <zone forceUpdate='true' h='15112' id='6' type-v2='text' w='89384' x='10030' y='1042'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontsize='28'>Q-Commerce</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#e51770' fontsize='12'>PANDORA</run>
                    <run fontsize='12' italic='true'> Vendor level Search Exploration</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='8846' id='9' type-v2='text' w='98828' x='586' y='16154'>
                  <formatted-text>
                    <run bold='true' fontcolor='#ea565f' fontsize='24'>DEFINITION</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='73958' id='70' type-v2='text' w='98828' x='586' y='25000'>
                  <formatted-text>
                    <run bold='true' fontsize='16'>General</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='14'>➤ </run>
                    <run fontsize='14'>Data sorted based on </run>
                    <run fontsize='14' italic='true'>category / brand interaction</run>
                    <run fontsize='14'>Æ </run>
                    <run bold='true' fontsize='14'>not</run>
                    <run fontsize='14'> based on </run>
                    <run fontsize='14' italic='true'>appearence</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='14'>➤ </run>
                    <run fontsize='14'>If no data shows it means no data available for the selected filter, please change the filter setting</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='14'>➤ </run>
                    <run fontsize='14'>Be mindful with the slider after changing filter, it might not get updated until you change the slider (Top X Slider)</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='14'>➤ </run>
                    <run fontsize='14'>Be mindfull with </run>
                    <run bold='true' fontsize='14'>(All) brands filter</run>
                    <run fontsize='14'>, please select only relevant brand, there&apos;s possibility not all data will be shown due to the </run>
                    <run bold='true' fontsize='14' italic='true'>Tableau limitation</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontsize='16'>High Level </run>
                    <run fontcolor='#1b1b1b' fontsize='16'>tab</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='14'>➤ </run>
                    <run bold='true' fontsize='14'>Search terms per month</run>
                    <run fontsize='14'>: # of unique search terms appeared in a period</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='14'>➤ </run>
                    <run bold='true' fontsize='14'>Brands appeared per month</run>
                    <run fontsize='14'>: # of unique brand appeared in a period</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='14'>➤ </run>
                    <run bold='true' fontsize='14'>Search appearance</run>
                    <run fontsize='14'>: # of sessions which contains specific search terms based on the breakdown</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontsize='16'>Brand Search Terms</run>
                    <run fontcolor='#1b1b1b' fontsize='16'> tab</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='14'>➤ </run>
                    <run bold='true' fontsize='14'>Brand Appearence</run>
                    <run fontsize='14'>: # of sessions where the selected brand appeared in search results based on the breakdown</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='14'>➤ </run>
                    <run bold='true' fontsize='14'>Brand Interaction</run>
                    <run fontsize='14'>: # of sessions where the selected brand clicked (PDP and or ATC) in search results based on the breakdown</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='14'>➤ </run>
                    <run bold='true' fontsize='14'>Brand Conversion</run>
                    <run fontsize='14'>: Brand Interaction / Brand Appearence</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontsize='16'>Category Search Terms </run>
                    <run fontcolor='#1b1b1b' fontsize='16'>tab</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='14'>➤ </run>
                    <run bold='true' fontsize='14'>Category Appearence</run>
                    <run fontsize='14'>: # of sessions where the search results contains at least 1 category</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='14'>➤ </run>
                    <run bold='true' fontsize='14'>Category Interaction</run>
                    <run fontsize='14'>: # of sessions where there&apos;s interaction with the product belongs to the category in the search results</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='14'>➤ </run>
                    <run bold='true' fontsize='14'>Category Conversion</run>
                    <run fontsize='14'>: Category Interaction / Category Appearence</run>
                    <run>Æ&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
