              <calculation class='tableau' formula='IF SUM([M: Search Clicks (copy)_4435553116879106048]) &gt;= 1000000000 THEN ROUND(SUM([M: Search Clicks (copy)_4435553116879106048]) / 1000000000,1)&#10;ELSEIF SUM([M: Search Clicks (copy)_4435553116879106048]) &gt;= 1000000 THEN ROUND(SUM([M: Search Clicks (copy)_4435553116879106048])  / 1000000,1)&#10;ELSEIF SUM([M: Search Clicks (copy)_4435553116879106048]) &gt;= 1000 THEN ROUND(SUM([M: Search Clicks (copy)_4435553116879106048]) / 1000,1)&#10;ELSE ROUND(SUM([M: Search Clicks (copy)_4435553116879106048]) , 0)&#10;END' />
