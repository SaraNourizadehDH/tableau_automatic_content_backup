            </column>
            <column caption='C4-5 Y Midline Next' datatype='real' name='[Y Previous (copy) 1 2]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Y coordinate for the next point on the midpoint line.&#13;&#10;// Calc will give us the top of the curve, so we&apos;ll move down half to get to the midline.&#13;&#10;[Calculation_5790329121624550 1 1] + (([Calculation_5790329121624550 1 1 1] - [Calculation_5790329121624550 1 1])*ATTR([Sigmoid Y (copy) (copy)]))-[Flow Size 1 (copy) 1 1]/2'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='C4-5 Y Bottom' datatype='real' name='[Y Top Parallel (copy) 1 2]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Y coordinate for the parallel line.&#13;&#10;// Radius in our trig is [N1 Flow Size]/2&#13;&#10;IF [Top Angle (copy) 1 2] = 180 OR [Top Angle (copy) 1 2] = 360 THEN&#13;&#10;    // This is a horizontal line.&#13;&#10;    [Calculation_1221882918444765184 1 2]-[Flow Size 1 (copy) 1 1]/2&#13;&#10;ELSE&#13;&#10;    [Calculation_1221882918444765184 1 2]+[Flow Size 1 (copy) 1 1]/2*SIN(RADIANS([Top Angle (copy) 1 2]))&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
