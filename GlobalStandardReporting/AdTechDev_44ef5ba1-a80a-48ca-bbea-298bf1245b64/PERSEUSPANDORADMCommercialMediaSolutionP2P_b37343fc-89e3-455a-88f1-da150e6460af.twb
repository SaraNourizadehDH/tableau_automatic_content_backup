          <datasource-dependencies datasource='federated.1htca5s0ze74ij10v1t1x1uscpu1 (copy 10)'>
            <column caption='Size to Show' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_343118044271468544]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Size gets duplicated 100 times. Summing it will cause problems to adjust.&#13;&#10;// This can then be used for displaying the value.&#13;&#10;SUM([nr_users])/([Calculation_987695734025916417]*2)' />
            </column>
            <column caption='month' datatype='string' name='[Calculation_365284190685270017]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(DATEPART(&apos;year&apos;, [partition_date])) &#10;&#9;+ STR(&quot;-&quot;) &#10;&#9;+ IF DATEPART(&apos;month&apos;, [partition_date]) &lt; 10 THEN STR(&quot;0&quot;) ELSE STR(&quot;&quot;) END&#10;&#9;+ STR(DATEPART(&apos;month&apos;, [partition_date]))' />
            </column>
            <column caption='N5 Bar Position' datatype='real' name='[Calculation_4500329135059284 1 1 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Position of each bar on step 5&#13;&#10;IF ISNULL(ATTR([step_5])) OR ATTR([step_5])=&quot;&quot; THEN&#13;&#10;    NULL&#13;&#10;ELSE&#13;&#10;    RUNNING_SUM([Flow Size 1 (copy) 1 1 1]+ [N1 Whitespace (copy) 1 1 1]) - [Flow Size 1 (copy) 1 1 1] - [N1 Whitespace (copy) 1 1 1]/2&#13;&#10;END'>
                <table-calc ordering-field='[federated.1htca5s0ze74ij10v1t1x1uscpu1 (copy 10)].[step_5]' ordering-type='Field' />
              </calculation>
            </column>
            <column caption='Step Size' datatype='real' name='[Calculation_540994926005260288]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Percentage of total.&#13;&#10;SUM([nr_sessions])/TOTAL(SUM([nr_sessions]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Max Densification Points' datatype='integer' datatype-customized='true' name='[Calculation_987695734025916417]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Maximum number of points in our denisification data.&#13;&#10;[Parameters].[Parameter 4]' />
            </column>
            <column caption='N5 Flow Size' datatype='real' name='[Flow Size 1 (copy) 1 1 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// We want the scale to always be 0 to 1.&#13;&#10;// Thus, we must adjust the flow size to account for...&#13;&#10;// ...the number of whitespaces.&#13;&#10;// Separate calc so it can be computed differently&#13;&#10;(SUM([nr_users])*(1 - SIZE()*[N1 Whitespace (copy) 1 1 1]))/TOTAL(SUM([nr_users]))'>
                <table-calc ordering-type='Field'>
                  <order field='[federated.1htca5s0ze74ij10v1t1x1uscpu1 (copy 10)].[Step 1]' />
                  <order field='[federated.1htca5s0ze74ij10v1t1x1uscpu1 (copy 10)].[Step 2]' />
