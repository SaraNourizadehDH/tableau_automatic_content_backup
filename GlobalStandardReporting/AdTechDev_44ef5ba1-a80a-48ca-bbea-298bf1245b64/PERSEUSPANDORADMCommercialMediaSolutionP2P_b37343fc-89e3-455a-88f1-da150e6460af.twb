    <worksheet name='bar_s1 (4)'>
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <repository-location derived-from='https://public.tableau.com/workbooks/HorizontalSankeywithAdjustableWhitespace/Bar1?rev=' id='Bar1' path='/workbooks/HorizontalSankeywithAdjustableWhitespace' revision='' />
      <table>
        <view>
          <datasources>
            <datasource caption='QC-First5StepsVisit' name='federated.1htca5s0ze74ij10v1t1x1uscpu1 (copy 3)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Whitespace' datatype='real' name='[Parameter 1 1]' param-domain-type='range' role='measure' type='quantitative' value='0.615807903951976'>
              <calculation class='tableau' formula='0.615807903951976' />
              <range max='1.0' min='0.0' />
            </column>
            <column caption='Max Points' datatype='integer' name='[Parameter 4]' param-domain-type='any' role='measure' type='quantitative' value='50'>
              <calculation class='tableau' formula='50' />
              <desc>
                <formatted-text>
                  <run>This is a static value</run>
                </formatted-text>
              </desc>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1htca5s0ze74ij10v1t1x1uscpu1 (copy 3)'>
            <column caption='N1 Bar Position' datatype='real' name='[Calculation_1280329135011862]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Position of each bar on step 1&#13;&#10;IF ISNULL(ATTR([step_1])) OR ATTR([step_1])=&quot;&quot; THEN&#13;&#10;    NULL&#13;&#10;ELSE&#13;&#10;    RUNNING_SUM([Calculation_1490329120836378 1]+ [Calculation_604889763570143232]) - [Calculation_1490329120836378 1] - [Calculation_604889763570143232]/2&#13;&#10;END'>
                <table-calc ordering-field='[federated.1htca5s0ze74ij10v1t1x1uscpu1 (copy 3)].[step_1]' ordering-type='Field' />
              </calculation>
            </column>
            <column caption='N1 Flow Size' datatype='real' name='[Calculation_1490329120836378 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// We want the scale to always be 0 to 1.&#13;&#10;// Thus, we must adjust the flow size to account for...&#13;&#10;// ...the number of whitespaces.&#13;&#10;// Separate calc so it can be computed differently&#13;&#10;(SUM([nr_users])*(1 - SIZE()*[Calculation_604889763570143232]))/TOTAL(SUM([nr_users]))'>
                <table-calc ordering-type='Field'>
                  <order field='[federated.1htca5s0ze74ij10v1t1x1uscpu1 (copy 3)].[step_1]' />
                  <order field='[federated.1htca5s0ze74ij10v1t1x1uscpu1 (copy 3)].[step_2]' />
                </table-calc>
              </calculation>
            </column>
            <column caption='Filter: Transacted' datatype='string' name='[Calculation_3084191730189803520]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [category]&#10;    WHEN &apos;xx Non-transacted xx&apos; THEN &apos;Non Transacted&apos;&#10;    ELSE &apos;Transacted&apos;&#10;END' />
            </column>
            <column caption='Size to Show' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_343118044271468544]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Size gets duplicated 100 times. Summing it will cause problems to adjust.&#13;&#10;// This can then be used for displaying the value.&#13;&#10;SUM([nr_users])/([Calculation_987695734025916417]*2)' />
            </column>
            <column caption='month' datatype='string' name='[Calculation_365284190685270017]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(DATEPART(&apos;year&apos;, [partition_date])) &#10;&#9;+ STR(&quot;-&quot;) &#10;&#9;+ IF DATEPART(&apos;month&apos;, [partition_date]) &lt; 10 THEN STR(&quot;0&quot;) ELSE STR(&quot;&quot;) END&#10;&#9;+ STR(DATEPART(&apos;month&apos;, [partition_date]))' />
            </column>
            <column caption='Step Size' datatype='real' name='[Calculation_540994926005260288]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Percentage of total.&#13;&#10;SUM([nr_sessions])/TOTAL(SUM([nr_sessions]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='N1 Whitespace' datatype='real' name='[Calculation_604889763570143232]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// We want to evenly distribute the spacing...&#13;&#10;// ...so that the flows stay the same size...&#13;&#10;// ...regardless of the number of bars on each side.&#13;&#10;// Separate calc for Step 1 so it can be computed differently.&#13;&#10;[Parameters].[Parameter 1 1]/SIZE()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Max Densification Points' datatype='integer' datatype-customized='true' name='[Calculation_987695734025916417]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Maximum number of points in our denisification data.&#13;&#10;[Parameters].[Parameter 4]' />
            </column>
            <column-instance column='[step_1]' derivation='Attribute' name='[attr:step_1:nk]' pivot='key' type='nominal' />
            <column caption='Brand' datatype='string' name='[brand]' role='dimension' type='nominal' />
            <column caption='Category' datatype='string' name='[category]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[Calculation_3084191730189803520]' derivation='None' name='[none:Calculation_3084191730189803520:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_365284190685270017]' derivation='None' name='[none:Calculation_365284190685270017:nk]' pivot='key' type='nominal' />
            <column-instance column='[brand]' derivation='None' name='[none:brand:nk]' pivot='key' type='nominal' />
            <column-instance column='[category]' derivation='None' name='[none:category:nk]' pivot='key' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column-instance column='[platform]' derivation='None' name='[none:platform:nk]' pivot='key' type='nominal' />
            <column-instance column='[step_1]' derivation='None' name='[none:step_1:nk]' pivot='key' type='nominal' />
            <column caption='Nr Sessions' datatype='integer' name='[nr_sessions]' role='measure' type='quantitative' />
            <column caption='Nr Users' datatype='integer' name='[nr_users]' role='measure' type='quantitative' />
            <column caption='Partition Date' datatype='date' name='[partition_date]' role='dimension' type='ordinal' />
            <column caption='Platform' datatype='string' name='[platform]' role='dimension' type='nominal' />
            <column caption='Step 11' datatype='string' name='[step_1]' role='dimension' type='nominal'>
