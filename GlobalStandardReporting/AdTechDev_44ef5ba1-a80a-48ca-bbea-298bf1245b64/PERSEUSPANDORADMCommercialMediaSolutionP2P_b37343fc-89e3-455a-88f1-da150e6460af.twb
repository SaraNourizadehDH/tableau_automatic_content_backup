              <zone h='5889' id='133' mode='dropdown' name='Table' param='[federated.1etspkn1x1g45u1ae1j7d0bnbt9w (copy)].[none:Calculation_4992521678426882049:nk]' show-apply='true' type-v2='filter' values='database' w='18616' x='80769' y='889'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
