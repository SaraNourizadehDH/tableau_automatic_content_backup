            <column caption='C4-5 Y Midline Previous' datatype='real' name='[Y (copy) 1 2]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Y coordinate for the previous point on the midpoint line.&#13;&#10;// Calc will give us the top of the curve, so we&apos;ll move down half to get to the midline.&#13;&#10;[Calculation_5790329121624550 1 1] + (([Calculation_5790329121624550 1 1 1] - [Calculation_5790329121624550 1 1])*ATTR([Sigmoid Y (copy)]))-[Flow Size 1 (copy) 1 1]/2'>
