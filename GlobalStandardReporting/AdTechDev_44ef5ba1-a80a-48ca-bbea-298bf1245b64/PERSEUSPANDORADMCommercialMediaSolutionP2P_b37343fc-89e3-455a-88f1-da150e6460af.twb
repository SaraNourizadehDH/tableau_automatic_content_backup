            <column caption='C4-5 Y Final' datatype='real' name='[X Final (copy) 1 2]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Final Y value.&#13;&#10;IF ISNULL(ATTR([step_4])) OR ATTR([step_4])=&quot;&quot; OR ISNULL(ATTR([step_5])) OR ATTR([step_5])=&quot;&quot; THEN&#13;&#10;    NULL&#13;&#10;ELSE&#13;&#10;    CASE ATTR([Line])&#13;&#10;    WHEN &quot;Bottom&quot; THEN [Y Top Parallel (copy) 1 2]&#13;&#10;    WHEN &quot;Midline&quot; THEN [Calculation_1221882918444765184 1 2]&#13;&#10;    WHEN &quot;Top&quot; THEN [X Parallel (copy) 1 2]&#13;&#10;    END&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='C4-5 Y Top' datatype='real' name='[X Parallel (copy) 1 2]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Y coordinate for the parallel line.&#13;&#10;// Radius in our trig is [N1 Flow Size]/2&#13;&#10;IF [Calculation_738871858459418636 1 2] = 180 OR [Calculation_738871858459418636 1 2] = 360 THEN&#13;&#10;    // This is a horizontal line.&#13;&#10;    [Calculation_1221882918444765184 1 2]+[Flow Size 1 (copy) 1 1]/2&#13;&#10;ELSE&#13;&#10;    [Calculation_1221882918444765184 1 2]+[Flow Size 1 (copy) 1 1]/2*SIN(RADIANS([Calculation_738871858459418636 1 2]))&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
