        <calculation class='tableau' formula='// Y coordinate for the parallel line.&#13;&#10;// Radius in our trig is [N1 Flow Size]/2&#13;&#10;IF [Top Angle (copy)] = 180 OR [Top Angle (copy)] = 360 THEN&#13;&#10;    // This is a horizontal line.&#13;&#10;    [Calculation_1221882918444765184]-[Calculation_1490329120836378 1]/2&#13;&#10;ELSE&#13;&#10;    [Calculation_1221882918444765184]+[Calculation_1490329120836378 1]/2*SIN(RADIANS([Top Angle (copy)]))&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
