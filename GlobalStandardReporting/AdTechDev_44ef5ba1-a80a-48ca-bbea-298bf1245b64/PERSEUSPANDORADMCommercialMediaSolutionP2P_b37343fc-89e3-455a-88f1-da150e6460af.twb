            </column>
            <column caption='Step 21' datatype='string' name='[step_2]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1280329135011862]' derivation='User' name='[usr:Calculation_1280329135011862:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-field='[federated.1htca5s0ze74ij10v1t1x1uscpu1 (copy 3)].[step_1]' ordering-type='Field' />
              <table-calc field='[federated.1htca5s0ze74ij10v1t1x1uscpu1 (copy 3)].[Calculation_604889763570143232]' ordering-field='[federated.1htca5s0ze74ij10v1t1x1uscpu1 (copy 3)].[step_1]' ordering-type='Field' />
              <table-calc field='[federated.1htca5s0ze74ij10v1t1x1uscpu1 (copy 3)].[Calculation_1490329120836378 1]' ordering-field='[federated.1htca5s0ze74ij10v1t1x1uscpu1 (copy 3)].[step_1]' ordering-type='Field' />
