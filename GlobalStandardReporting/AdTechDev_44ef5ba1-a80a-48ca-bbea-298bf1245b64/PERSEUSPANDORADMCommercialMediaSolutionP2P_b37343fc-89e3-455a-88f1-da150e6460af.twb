              <zone forceUpdate='true' h='9110' id='118' type-v2='text' w='98770' x='615' y='12000'>
                <formatted-text>
                  <run bold='true' fontcolor='#ea565f' fontsize='15'>General User Flow, </run>
                  <run fontcolor='#ea565f' fontsize='15' italic='true'>Avg. Steps taken before First Add-to-Cart</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
