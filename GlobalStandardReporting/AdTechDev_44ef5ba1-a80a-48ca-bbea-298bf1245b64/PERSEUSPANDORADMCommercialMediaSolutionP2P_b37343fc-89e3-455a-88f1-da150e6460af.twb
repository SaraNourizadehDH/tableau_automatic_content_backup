            <column caption='C3-4 Y Top' datatype='real' name='[X Parallel (copy) 1 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Y coordinate for the parallel line.&#13;&#10;// Radius in our trig is [N1 Flow Size]/2&#13;&#10;IF [Calculation_738871858459418636 1 1] = 180 OR [Calculation_738871858459418636 1 1] = 360 THEN&#13;&#10;    // This is a horizontal line.&#13;&#10;    [Calculation_1221882918444765184 1 1]+[Flow Size 1 (copy) 1]/2&#13;&#10;ELSE&#13;&#10;    [Calculation_1221882918444765184 1 1]+[Flow Size 1 (copy) 1]/2*SIN(RADIANS([Calculation_738871858459418636 1 1]))&#13;&#10;END'>
