            <column caption='C4-5 Angle Bottom' datatype='real' name='[Top Angle (copy) 1 2]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Angle, in degrees, based on the slope, to get the bottom curve.&#13;&#10;// Just need to swing the top around 180 degrees.&#13;&#10;180+[Calculation_738871858459418636 1 2]'>
