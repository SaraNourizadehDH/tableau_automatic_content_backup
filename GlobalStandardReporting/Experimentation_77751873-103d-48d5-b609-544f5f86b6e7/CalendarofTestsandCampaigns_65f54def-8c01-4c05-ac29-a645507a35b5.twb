      <aliases enabled='yes' />
      <column caption='Name' datatype='string' name='[Calculation_1908400364741668866]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [type] = &apos;Campaign&apos; THEN &apos;Campaign&apos; ELSE [name] END' />
      </column>
      <column caption='Live' datatype='boolean' name='[Calculation_1950340157111693320]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='ISNULL([end_date]) OR [end_date] &gt; [Parameters].[Next 30 days (copy)_2093610893228855302]' />
      </column>
      <column caption='Detail ' datatype='string' name='[Calculation_2093610893223813120]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;    WHEN &apos;None&apos; THEN &apos;&apos;&#13;&#10;    WHEN &apos;City&apos; THEN [city_name]&#13;&#10;    WHEN &apos;Block&apos; THEN STR([block_id])&#13;&#10;    WHEN &apos;Zone&apos; THEN [zone_name]&#13;&#10;    WHEN &apos;Parent&apos; THEN [vertical_parent]&#13;&#10;    WHEN &apos;Name&apos; THEN [name]&#13;&#10;END' />
      </column>
      <column caption='Today + 30' datatype='date' name='[Calculation_2093610893227163652]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='TODAY() + 30' />
      </column>
      <column caption='Length' datatype='real' name='[Calculation_352688162164596738]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN(IFNULL(&#13;&#10;[end_date]-[start_date],&#13;&#10;MAX([Parameters].[Next 30 days (copy)_2093610893228855302],[start_date])-[start_date]),360)' />
      </column>
      <column caption='Format' datatype='string' name='[Calculation_352688162209132564]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF COUNTD([Calculation_1908400364741668866]) = 0 THEN &quot;No test&quot;&#13;&#10;ELSEIF NOT MIN([is_targeted]) THEN &quot;Overlapping&quot;&#13;&#10;ELSEIF COUNTD([Calculation_1908400364741668866]) &gt; 0 THEN &quot;Targeted&quot;&#13;&#10;ELSE &quot;N/A&quot;&#13;&#10;END' />
      </column>
      <column caption='Subdetail ' datatype='string' name='[Detail  (copy)_2093610893224476674]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Detail (copy)_2093610893224443905]&#13;&#10;    WHEN &apos;None&apos; THEN &apos;&apos;&#13;&#10;    WHEN &apos;City&apos; THEN [city_name]&#13;&#10;    WHEN &apos;Block&apos; THEN STR([block_id])&#13;&#10;    WHEN &apos;Zone&apos; THEN [zone_name]&#13;&#10;    WHEN &apos;Parent&apos; THEN [vertical_parent]&#13;&#10;    WHEN &apos;Name&apos; THEN [name]&#13;&#10;END' />
      </column>
      <column caption='Other Feature ' datatype='string' name='[Other Feature (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[other_feature]' new-bin='true'>
          <bin default-name='false' value='&quot;N/A&quot;'>
            <value>%null%</value>
            <value>&quot;No mechanism&quot;</value>
          </bin>
        </calculation>
      </column>
      <column caption='Today + 90' datatype='date' name='[Today + 30 (copy)_1950340157109010437]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='TODAY() + 90' />
      </column>
      <column caption='Today - 30' datatype='date' name='[Today + 30 (copy)_1950340157110595591]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='TODAY() - 30' />
      </column>
      <column caption='Today ' datatype='date' name='[Today + 30 (copy)_2093610893228486661]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='TODAY()' />
      </column>
