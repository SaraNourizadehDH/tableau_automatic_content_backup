    <dashboard name='KPI Definition'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/DarkStores-GMROIReport_16419859620200/KPIDefinition?rev=' id='KPIDefinition' path='/t/GlobalStandardReporting/workbooks/DarkStores-GMROIReport_16419859620200' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='table'>
          <format attr='background-color' value='#555555' />
        </style-rule>
      </style>
      <size maxheight='1900' maxwidth='1200' minheight='1900' minwidth='1200' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='2895' id='3' type-v2='text' w='98666' x='667' y='421'>
            <formatted-text>
              <run fontcolor='#ffffff' fontsize='15'>KPI Definitions</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='24631' id='5' type-v2='text' w='98666' x='667' y='5158'>
            <formatted-text>
              <run bold='true' fontcolor='#ffffff' fontsize='11'>Beginning Inventory</run>
              <run fontcolor='#ffffff' fontsize='11'>:                                   Qty on hand start of period</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='11'>Ending Inventory</run>
              <run fontcolor='#ffffff' fontsize='11'>:                                          Qty on hand end of period</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='11'>Beginning Inventory (EUR)</run>
              <run fontcolor='#ffffff' fontsize='11'>:                      WAC * Beginning Inventory</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='11'>Ending Inventory (EUR)</run>
              <run fontcolor='#ffffff' fontsize='11'>:                             WAC * Ending Inventory</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='11'>Average Inventory (Bookvalue EUR):</run>
              <run fontcolor='#ffffff' fontsize='11'>  (Beginning Inventory (EUR) + Ending Inventory (EUR)])/ 2</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#ffffff' fontsize='11'>Selling price includes item level discount but net of VAT</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='11'>Gross Profit (%)</run>
              <run fontcolor='#ffffff' fontsize='11'>:                                            Sales - COGS</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='11'>Annual Gross Profit (EUR)</run>
              <run fontcolor='#ffffff' fontsize='11'>:                       (Sales-COGS)/ 30days * 365</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='11'>GMROI</run>
              <run fontcolor='#ffffff' fontsize='11'> :                                                               Annual GP in EUR / Avg Inventory Book Value in EUR</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='11'>Average Daily COGS (EUR)</run>
              <run fontcolor='#ffffff' fontsize='11'>:                       COGS / 30days </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='11'>Annual COGS (EUR)</run>
              <run fontcolor='#ffffff' fontsize='11'>:                                      Avg Daily COGS * 365</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='11'>Inventory Turnover</run>
              <run fontcolor='#ffffff' fontsize='11'>:                                      Annual COGS in EUR / Avg Inventory Book Value in EUR</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='11'>Inventory Holding Period (Days)</run>
              <run fontcolor='#ffffff' fontsize='11'> :         365 / Inventory Turnover</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='11'>Stock Cover (Days)</run>
              <run fontcolor='#ffffff' fontsize='11'>:                                       Ending Inventory / Avg Daily COGS</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='11'>Stock Cover Class</run>
              <run fontcolor='#ffffff' fontsize='11'><![CDATA[  :                                        < 15days]]></run>
              <run>Æ&#10;</run>
              <run fontcolor='#ffffff' fontsize='11'>                                                                                 15-30 days</run>
              <run>Æ&#10;</run>
              <run fontcolor='#ffffff' fontsize='11'>                                                                                 30-60 days</run>
              <run>Æ&#10;</run>
              <run fontcolor='#ffffff' fontsize='11'>                                                                                 60-90 days</run>
              <run>Æ&#10;</run>
              <run fontcolor='#ffffff' fontsize='11'>                                                                                 &gt; 90 days</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone h='69790' id='6' type-v2='empty' w='98666' x='667' y='29789'>
