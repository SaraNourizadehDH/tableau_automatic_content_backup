          <datasource-dependencies datasource='federated.0qkgjue0cxf88u10uk9iv0z1unhd'>
            <column caption='Gross Margin %' datatype='real' name='[Calculation_2339971861640798208]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4185673685911904263]' />
            </column>
