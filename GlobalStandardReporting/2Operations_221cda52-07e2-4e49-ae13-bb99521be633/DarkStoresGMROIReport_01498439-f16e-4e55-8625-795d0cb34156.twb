              <calculation class='tableau' formula='If ISNULL([beginning_bookvalue_eur]) THEN 0&#10;ELSE [beginning_bookvalue_eur] END' />
            </column>
            <column caption='Granularity Level' datatype='string' name='[Calculation_3979211768338862081]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[GMROI Type (copy)_3979211768338157568] = &apos;Region&apos; THEN [Calculation_4185673685899796480] &#10;ELSEIF [Parameters].[GMROI Type (copy)_3979211768338157568] = &apos;Country&apos; THEN [Region. (copy)_4185673685899927553] &#10;ELSE [Calculation_4185673685900177411]&#10;END' />
