              <calculation class='tableau' formula='SUM([total_sales_eur])' />
            </column>
            <column caption='COGS (EUR)' datatype='real' name='[Calculation_2661064487102930945]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_cogs_eur])' />
            </column>
            <column caption='Beginning Bookvalue (EUR)' datatype='real' name='[Calculation_2661064487103561730]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_3039015017355333637])' />
            </column>
            <column caption='Ending Bookvalue (EUR)' datatype='real' name='[Calculation_2661064487108059140]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_3039015017354809347])' />
            </column>
            <column caption='Beginning Inv.' datatype='integer' name='[Calculation_2661064487109488645]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([beginning_inventory])' />
            </column>
            <column caption='Ending Inv.' datatype='integer' name='[Calculation_2661064487109705734]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ending_inventory])' />
            </column>
            <column caption='Beginning Inventory without null' datatype='integer' name='[Calculation_3039015017349316608]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL([beginning_inventory]) THEN 0&#10;ELSE [beginning_inventory] END' />
            </column>
            <column caption='Ending Inventory without null' datatype='integer' name='[Calculation_3039015017349652481]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL([ending_inventory]) THEN 0&#10;ELSE [ending_inventory] END' />
            </column>
            <column caption='Ending Bookvalue eur without null' datatype='real' name='[Calculation_3039015017354809347]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL([ending_bookvalue_eur]) THEN 0&#10;ELSE [ending_bookvalue_eur] END' />
            </column>
            <column caption='Beginning Bookvalue eur without null' datatype='real' name='[Calculation_3039015017355333637]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='If ISNULL([beginning_bookvalue_eur]) THEN 0&#10;ELSE [beginning_bookvalue_eur] END' />
            </column>
            <column caption='GMROI Bucket' datatype='string' name='[Calculation_4135008210420924416]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_4135008210422210561] &lt; 5 THEN &apos;&lt; 5&apos; &#10;ELSEIF [Calculation_4135008210422210561] &gt;= 5 AND [Calculation_4135008210422210561] &lt; 10 THEN &apos;5 - 10&apos; &#10;ELSEIF [Calculation_4135008210422210561] &gt;= 10 AND [Calculation_4135008210422210561] &lt; 15 THEN &apos;10 - 15&apos; &#10;ELSEIF [Calculation_4135008210422210561] &gt;= 15 AND [Calculation_4135008210422210561] &lt; 20 THEN &apos;15 - 20&apos; &#10;ELSEIF [Calculation_4135008210422210561] &gt;= 20 AND [Calculation_4135008210422210561] &lt; 25 THEN &apos;20 - 25&apos; &#10;ELSEIF [Calculation_4135008210422210561] &gt;= 25 AND [Calculation_4135008210422210561] &lt; 30 THEN &apos;25 - 30&apos; &#10;ELSEIF [Calculation_4135008210422210561] &gt; 30 THEN &apos;&gt; 30&apos; &#10;END' />
            </column>
            <column caption='GMROI Parameter Swap' datatype='real' name='[Calculation_4135008210422210561]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;GMROI (Monthly)&apos; THEN [Calculation_4185673685913473036]&#10;WHEN &apos;GMROI (Annual)&apos; THEN [GMROI (copy)_2661064487114895367]&#10;END' />
            </column>
            <column caption='Average Inventory' datatype='real' name='[Calculation_4185673685910188036]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_3039015017349316608])+SUM([Calculation_3039015017349652481]))/2' />
            </column>
            <column caption='Average Daily COGS' datatype='real' name='[Calculation_4185673685911130117]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2661064487102930945]/30' />
            </column>
            <column caption='Annual COGS' datatype='real' name='[Calculation_4185673685911420934]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4185673685911130117]*365' />
            </column>
            <column caption='Gross Profit (EUR)' datatype='real' name='[Calculation_4185673685911904263]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2661064487102771200]-[Calculation_2661064487102930945]' />
            </column>
            <column caption='Annual Gross Profit (EUR)' datatype='real' name='[Calculation_4185673685912109064]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(([Calculation_2661064487102771200]-[Calculation_2661064487102930945])/30)*365' />
            </column>
            <column caption='Inventory Turnover (Monthly)' datatype='real' name='[Calculation_4185673685912338441]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2661064487102930945]/[Calculation_4185673685914107917]' />
