      <aliases enabled='yes' />
      <column caption='Date Filter' datatype='date' name='[Calculation_1298233015128350721]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF DAY(TODAY()) &lt; 15 THEN&#10;    IF [metric_function] IN (&quot;Profitability&quot;, &quot;OneStream&quot;) AND MONTH([report_month]) = MONTH(DATEADD(&apos;month&apos;, -1, TODAY())) THEN&#10;        NULL  // Exclude last month&apos;s data for these metrics&#10;    ELSE&#10;        [report_month]  // Keep other months and metrics unchanged&#10;    END&#10;ELSE&#10;    [report_month]  // Show everything after the 15th&#10;END' />
      </column>
      <column caption='percent' datatype='string' name='[Calculation_2174183135147757568]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [metric_type] = &apos;Percentage&apos; THEN &apos;%&apos; ELSE &apos;&apos; END' />
      </column>
      <column caption='percent / pp' datatype='string' name='[Calculation_2174183135148834817]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] IN (&quot;Actuals - MoM/QoQ&quot;, &quot;Actuals - YoY&quot;) THEN&#10;    IF [metric_type] = &apos;Percentage&apos; AND NOT ISNULL([value_YoY]) THEN &apos;pp&apos;&#10;    ELSEIF NOT [metric_type] = &apos;Percentage&apos; AND NOT ISNULL([value_YoY]) THEN &apos;%&apos;&#10;    ELSE &apos;&apos;&#10;    END&#10;ELSE&#10;    &apos;&apos;&#10;END' />
      </column>
      <column caption='Metric Color Change' datatype='real' name='[Calculation_2174183135149002754]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Actuals&quot; THEN &#10;    IF [reverse_metric] = &apos;TRUE&apos; THEN [value] * -1 ELSE [value] END&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Actuals - MoM&quot; THEN &#10;    IF [reverse_metric] = &apos;TRUE&apos; THEN [value_MoM] * -1 ELSE [value_MoM] END&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Actuals - YoY&quot; THEN &#10;    IF [reverse_metric] = &apos;TRUE&apos; THEN [value_YoY] * -1 ELSE [value_YoY] END&#10;&#10;ELSE &#10;    0  &#10;END' />
      </column>
      <column caption='parameter_1' datatype='real' name='[Calculation_2244411141846794240]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Actuals - MoM/QoQ&quot; THEN [value_MoM]&#10;WHEN &quot;Actuals - YoY&quot; THEN [value_YoY]&#10;END' />
      </column>
      <column caption='Value - Actual' datatype='real' name='[Calculation_2244411141847064577]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [metric_type] = &quot;Absolute&quot; THEN [value] ELSE NULL END' />
      </column>
      <column caption='Value - Decimal' datatype='real' name='[Calculation_2244411141847175170]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [metric_type] = &quot;Absolute - Decimal&quot; THEN [value] ELSE NULL END' />
      </column>
      <column caption='Metric Filter' datatype='string' name='[Calculation_2244411141848776707]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[metric_function] + &quot; - &quot; + [metric_display_name]' />
      </column>
      <column caption='Display Date' datatype='string' name='[Calculation_3983363554750136321]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [granularity] = &quot;Monthly&quot; THEN &#10;    LEFT(DATENAME(&apos;month&apos;, [report_month]), 3) + &quot;-&quot; + RIGHT(STR(YEAR([report_month])), 2)&#10;ELSEIF [granularity] = &quot;Quarterly&quot; THEN &#10;    &quot;Q&quot; + STR(DATEPART(&apos;quarter&apos;, [report_month])) + &quot;-&quot; + RIGHT(STR(YEAR([report_month])), 2)&#10;END' />
      </column>
      <column caption='Value Color' datatype='real' name='[Calculation_4033395725888872453]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [metric_name] = &quot;Actual - MoM&quot; THEN &#10;    IF [reverse_metric] = &apos;TRUE&apos; THEN [value_MoM] * -1 ELSE [value_MoM] END&#10;ELSEIF [metric_name] = &quot;Actual - YoY&quot; THEN &#10;    IF [reverse_metric] = &apos;TRUE&apos; THEN [value_YoY] * -1 ELSE [value_YoY] END&#10;ELSE &#10;    0&#10;END' />
      </column>
      <column caption='Value Color YoY' datatype='real' name='[Calculation_4033395725889429511]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [reverse_metric] = &apos;TRUE&apos; THEN [value_YoY]*-1 ELSE [value_YoY] END' />
      </column>
      <column caption='Report Period' datatype='string' name='[Calculation_4575798010895196162]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [granularity] = &quot;Monthly&quot; THEN &#10;    LEFT(DATENAME(&apos;month&apos;, [report_month]), 3) + &quot;-&quot; + RIGHT(STR(YEAR([report_month])), 2)&#10;ELSEIF [granularity] = &quot;Quarterly&quot; THEN &#10;    &quot;Q&quot; + LEFT(STR(DATEPART(&apos;quarter&apos;, [report_month])),3) + &quot; - &quot; + RIGHT(STR(YEAR([report_month])), 2)&#10;ELSE &#10;    &apos;&apos;&#10;END' />
      </column>
      <column caption='Value Color MoM' datatype='real' name='[Calculation_5546534832528109568]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [reverse_metric] = &apos;TRUE&apos; THEN [value_MoM]*-1 ELSE [value_MoM] END' />
      </column>
      <column aggregation='Sum' caption='parameter red' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_6297580439543230465]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [Calculation_6881148435309998081]&lt;0 THEN [Calculation_2244411141846794240]&#10;ELSE NULL END' />
      </column>
      <column caption='percent/pp color' datatype='string' name='[Calculation_6297580439552446467]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] IN (&quot;Actuals - MoM&quot;, &quot;Actuals - YoY&quot;) THEN&#10;    // Apply reverse metric logic&#10;    IF [Calculation_2244411141846794240] &gt; 0 THEN &#10;        IF [reverse_metric] = &apos;TRUE&apos; THEN STR([Calculation_2244411141846794240] * -1) ELSE STR([Calculation_2244411141846794240]) END&#10;    ELSE &#10;        NULL &#10;    END&#10;END&#10;+ &#10;IF [metric_type] = &apos;Percentage&apos; AND NOT ISNULL([value_YoY]) THEN &apos; pp&apos;&#10;ELSEIF NOT [metric_type] = &apos;Percentage&apos; AND NOT ISNULL([value_YoY]) THEN &apos; %&apos;&#10;ELSE &apos;&apos;&#10;END' />
      </column>
      <column caption='Reverse Metric Boolean' datatype='boolean' name='[Calculation_6297580439563182086]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [reverse_metric] = &quot;TRUE&quot; THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='adjusted parameter' datatype='real' name='[Calculation_6881148435309998081]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [reverse_metric] = &apos;TRUE&apos; THEN [Calculation_2244411141846794240] * -1 ELSE [Calculation_2244411141846794240] END' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Username (copy)_1298233015131262979]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Value - Percentage' datatype='real' name='[Value - Actual (copy)_4033395725838577665]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [metric_type] = &quot;Percentage&quot; THEN [value] ELSE NULL END' />
      </column>
