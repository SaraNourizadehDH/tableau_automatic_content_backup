          <relation connection='bigquery.0oj3qga0hbg4kw1bf6vd40h15cxz' name='Custom SQL Query' type='text'>WITH yoy AS
(
SELECT
p1.global_entity_id,
p1.sub_entity,
p1.management_entity,
p1.report_month,
p1.granularity,
p1.metric_function,
CASE 
  WHEN p1.metric_type = &apos;Percentage&apos; THEN &apos;Percentage Point&apos; 
  WHEN p1.metric_type in (&apos;Absolute - Decimal&apos;,&apos;Absolute&apos;) THEN &apos;Percentage&apos; 
  END AS metric_type,
CONCAT(p1.metric_name,&apos;_yoy&apos;) as metric_name,
CONCAT(p1.metric_display_name,&apos; - YoY&apos;) as metric_display_name,
CASE 
  WHEN p1.metric_type = &apos;Percentage&apos; THEN (p1.value_raw - p2.value_raw) 
  WHEN p1.metric_type in (&apos;Absolute - Decimal&apos;,&apos;Absolute&apos;) THEN (SAFE_DIVIDE(p1.value_raw , p2.value_raw) -1) 
  END AS value
FROM `fulfillment-dwh-production.rl_intl_markets.country_benchmarking_dashboard` p1
LEFT JOIN `fulfillment-dwh-production.rl_intl_markets.country_benchmarking_dashboard` p2
  ON p1.global_entity_id = p2.global_entity_id
  AND p1.metric_name = p2.metric_name
  AND p1.granularity = p2.granularity
  AND p1.report_month = DATE_ADD(p2.report_month, INTERVAL 12 MONTH)
), 
mom AS 
(
SELECT
p1.global_entity_id,
p1.sub_entity,
p1.management_entity,
p1.report_month,
p1.granularity,
p1.metric_function,
CASE 
  WHEN p1.metric_type = &apos;Percentage&apos; THEN &apos;Percentage Point&apos; 
  WHEN p1.metric_type in (&apos;Absolute - Decimal&apos;,&apos;Absolute&apos;) THEN &apos;Percentage&apos; 
END AS metric_type,
CONCAT(p1.metric_name,&apos;_mom&apos;) as metric_name,
CONCAT(p1.metric_display_name,&apos; - MoM&apos;) as metric_display_name,
CASE 
  WHEN p1.metric_type = &apos;Percentage&apos; THEN (p1.value_raw - p2.value_raw) 
  WHEN p1.metric_type in (&apos;Absolute - Decimal&apos;,&apos;Absolute&apos;) THEN (SAFE_DIVIDE(p1.value_raw , p2.value_raw) -1) 
  END AS value
FROM `fulfillment-dwh-production.rl_intl_markets.country_benchmarking_dashboard` p1
LEFT JOIN `fulfillment-dwh-production.rl_intl_markets.country_benchmarking_dashboard` p2
  ON p1.global_entity_id = p2.global_entity_id
  AND p1.metric_name = p2.metric_name
  AND p1.granularity = p2.granularity
  AND p1.report_month = DATE_ADD(p2.report_month, INTERVAL 1 MONTH)
)

SELECT 
global_entity_id,
sub_entity,
management_entity,
report_month,
granularity,
metric_function,
metric_name,
metric_display_name,
metric_type,
value_raw as value
FROM `fulfillment-dwh-production.rl_intl_markets.country_benchmarking_dashboard`
UNION ALL

SELECT 
global_entity_id,
sub_entity,
management_entity,
report_month,
granularity,
metric_function,
metric_name,
metric_display_name,
metric_type,
value 
FROM mom
UNION ALL

SELECT 
global_entity_id,
sub_entity,
management_entity,
report_month,
granularity,
metric_function,
metric_name,
metric_display_name,
metric_type,
value 
FROM yoy</relation>
