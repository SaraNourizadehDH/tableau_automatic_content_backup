      <aliases enabled='yes' />
      <column caption='Date Filter' datatype='date' name='[Calculation_1298233015128055808]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF DAY(TODAY()) &lt; 15 THEN&#10;    IF [metric_function] IN (&quot;Profitability&quot;, &quot;OneStream&quot;) AND MONTH([report_month]) = MONTH(DATEADD(&apos;month&apos;, -1, TODAY())) THEN&#10;        NULL&#10;    ELSE&#10;        [report_month]&#10;    END&#10;ELSE&#10;    [report_month] &#10;END' />
      </column>
      <column caption='value formatted' datatype='real' name='[Calculation_2244411141935742983]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [metric_type] = &quot;Absolute&quot; THEN &#10;    INT([value])&#10;&#10;ELSEIF [metric_type] = &quot;Absolute - Decimal&quot; THEN &#10;    ROUND([value], 2)&#10;&#10;ELSEIF [metric_type] = &quot;Percentage&quot; THEN &#10;    [value]&#10;&#10;ELSE &#10;    NULL  // Fallback for unexpected values&#10;END' />
      </column>
      <column caption='Display Date' datatype='string' name='[Calculation_3983363554749476864]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [granularity] = &quot;Monthly&quot; THEN &#10;    LEFT(DATENAME(&apos;month&apos;, [report_month]), 3) + &quot;-&quot; + RIGHT(STR(YEAR([report_month])), 2)&#10;ELSEIF [granularity] = &quot;Quarterly&quot; THEN &#10;    &quot;Q&quot; + STR(DATEPART(&apos;quarter&apos;, [report_month])) + &quot;-&quot; + RIGHT(STR(YEAR([report_month])), 2)&#10;END' />
      </column>
      <column caption='Value Color MoM' datatype='real' name='[Calculation_4033395725877551107]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [reverse_metric] = &apos;TRUE&apos; THEN [value_MoM]*-1 ELSE [value_MoM] END' />
      </column>
      <column caption='Value Color YoY' datatype='real' name='[Calculation_4033395725879898116]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [reverse_metric] = &apos;TRUE&apos; THEN [value_YoY]*-1 ELSE [value_YoY] END' />
      </column>
      <column caption='year' datatype='integer' name='[Calculation_4575798010577076225]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='YEAR([report_month])*100 + MONTH([report_month])' />
      </column>
      <column caption='Value - Decimal' datatype='real' name='[Calculation_565131429056016384]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [metric_type] = &quot;Absolute - Decimal&quot; THEN [value] ELSE NULL END' />
      </column>
      <column caption='percent' datatype='string' name='[Calculation_565131429057011714]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [metric_type] = &apos;Percentage&apos; THEN &apos;%&apos; ELSE &apos;&apos; END' />
      </column>
      <column caption='percent / pp' datatype='string' name='[Calculation_565131429057196035]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] IN (&quot;Actuals - MoM&quot;, &quot;Actuals - YoY&quot;) THEN&#10;    IF [metric_type] = &apos;Percentage&apos; AND NOT ISNULL([value_YoY]) THEN &#10;        IF ([value_YoY] &gt; 0 AND [reverse_metric] = &apos;FALSE&apos;) OR &#10;           ([value_YoY] &lt; 0 AND [reverse_metric] = &apos;TRUE&apos;) THEN &#10;            &apos;pp&apos;&#10;        ELSE &#10;            &apos;pp&apos;&#10;        END&#10;    ELSEIF NOT [metric_type] = &apos;Percentage&apos; AND NOT ISNULL([value_YoY]) THEN &#10;        IF ([value_YoY] &gt; 0 AND [reverse_metric] = &apos;FALSE&apos;) OR &#10;           ([value_YoY] &lt; 0 AND [reverse_metric] = &apos;TRUE&apos;) THEN &#10;            &apos;%&apos;&#10;        ELSE &#10;            &apos;%&apos;&#10;        END&#10;    ELSE &apos;&apos;&#10;    END&#10;ELSE&#10;    &apos;&apos;&#10;END' />
      </column>
      <column caption='MoM Direction' datatype='string' name='[Calculation_565131429062696964]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [value_MoM] &gt; 0 THEN &quot;▲&quot;&#10;ELSEIF [value_MoM] &lt; 0 THEN &quot;▲&quot;&#10;ELSE &quot;&quot;&#10;END' />
      </column>
      <column caption='YoY Direction' datatype='string' name='[Calculation_565131429063008261]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [value_YoY] &gt; 0 THEN &quot;▲&quot;&#10;ELSEIF [value_YoY] &lt; 0 THEN &quot;▲&quot;&#10;ELSE &quot;&quot;&#10;END' />
      </column>
      <column caption='parameter ' datatype='real' name='[Calculation_565131429064749062]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Actuals - MoM/QoQ&quot; THEN [value_MoM]&#10;WHEN &quot;Actuals - YoY&quot; THEN [value_YoY]&#10;END' />
      </column>
      <column caption='Metric Filter' datatype='string' name='[Calculation_565131429094703113]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[metric_function] + &quot; - &quot; + [metric_display_name]' />
      </column>
      <column caption='Report Period' datatype='date' datatype-customized='true' name='[Calculation_6297510074349686785]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(IF [granularity] = &quot;Monthly&quot; THEN &#10;    DATE([report_month])&#10;ELSEIF [granularity] = &quot;Quarterly&quot; THEN &#10;    DATETRUNC(&apos;quarter&apos;, DATE([report_month]))&#10;END)' />
      </column>
      <column aggregation='Sum' caption='parameter green' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_6297580439581569032]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [Calculation_6297580439604174861]&gt;0 THEN [Calculation_565131429064749062]&#10;ELSE NULL END' />
      </column>
      <column caption='pp / percent green' datatype='string' name='[Calculation_6297580439602491403]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] IN (&quot;Actuals - MoM/QoQ&quot;, &quot;Actuals - YoY&quot;) AND [Calculation_6297580439604174861] &gt;0 THEN&#10;    IF [metric_type] = &apos;Percentage&apos; AND NOT ISNULL([value_YoY]) THEN &apos;pp&apos;&#10;    ELSEIF [metric_type] = &apos;Percentage&apos; AND [metric_function] = &apos;OneStream&apos; THEN &apos;pp&apos;&#10;    ELSEIF NOT [metric_type] = &apos;Percentage&apos; AND [metric_function] = &apos;OneStream&apos; THEN &apos;%&apos;&#10;    ELSEIF NOT [metric_type] = &apos;Percentage&apos; AND NOT ISNULL([value_YoY]) THEN &apos;%&apos;&#10;    ELSE &apos;&apos;&#10;    END&#10;ELSE&#10;    &apos;&apos;&#10;END' />
      </column>
      <column caption='Adjusted Parameter' datatype='real' name='[Calculation_6297580439604174861]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [reverse_metric] = &apos;TRUE&apos; THEN [Calculation_565131429064749062] * -1 ELSE [Calculation_565131429064749062] END' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Username (copy)_1298233015130771458]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Value - Percentage' datatype='real' name='[Value - Decimal (copy)_2244411141923700742]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [metric_type] = &quot;Percentage&quot; THEN [value] ELSE NULL END' />
      </column>
      <column caption='Value - Actual' datatype='real' name='[Value - Decimal (copy)_565131429056249857]' role='measure' type='quantitative'>
