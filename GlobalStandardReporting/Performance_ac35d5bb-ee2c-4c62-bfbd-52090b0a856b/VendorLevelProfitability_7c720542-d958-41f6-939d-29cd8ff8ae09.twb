          <datasource-dependencies datasource='federated.1sdk8xr1jslpc919iu3u71df7064'>
            <column caption='AFV' datatype='real' name='[AFV (copy)_4513451277972164619]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF(SUM([Orders_L6M]) &gt; 0, SUM([total_gfv_eur]) / SUM([Orders_L6M]), NULL)' />
