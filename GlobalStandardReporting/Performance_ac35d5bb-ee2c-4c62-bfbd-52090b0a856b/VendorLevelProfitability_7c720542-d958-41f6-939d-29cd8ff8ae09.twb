              <calculation class='tableau' formula='IIF( COUNTD([vendor_id]) &gt; 0,&#10;&#10;COUNTD(IIF([gpo_vs_avg] = &apos;Above&apos;, [vendor_id], NULL)) / COUNTD([vendor_id]),&#10;&#10;NULL)' />
