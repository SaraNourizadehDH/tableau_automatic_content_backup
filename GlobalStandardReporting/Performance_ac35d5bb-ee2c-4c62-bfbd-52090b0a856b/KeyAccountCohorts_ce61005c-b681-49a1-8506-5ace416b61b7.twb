    <worksheet name='Reorder Rate '>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#ffffff' fontsize='16'>Monthly KA Cohorts - &lt;</run>
            <run fontcolor='#ffffff' fontsize='16'>[Parameters].[Parameter 4]</run>
            <run fontcolor='#ffffff' fontsize='16'>&gt;</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run bold='true' fontsize='8'>KPI Definitions</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontsize='8'>Reorder Rate (RR): </run>
            <run fontsize='8'>Active customers divided by cohort acquisitions (acquired at the selected KAs (</run>
            <run fontcolor='#499894' fontsize='8'>*</run>
            <run fontsize='8'>) and reordered at any restaurant)</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='8'>RR From Any KA: </run>
            <run fontsize='8'>Reorder Rate for</run>
            <run bold='true' fontsize='8'>Æ </run>
            <run fontsize='8'>customers that got acquired at the selected KAs (</run>
            <run fontcolor='#499894' fontsize='8'>*</run>
            <run fontsize='8'>) and reordered at any KA</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='8'>RR Excluding Any KA: </run>
            <run fontsize='8'>Reorder Rate for</run>
            <run bold='true' fontsize='8'>Æ </run>
            <run fontsize='8'>customers that got acquired at the selected KAs (</run>
            <run fontcolor='#499894' fontsize='8'>*</run>
            <run fontsize='8'>) and reordered at any restaurant that is not a KA</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='8'>RR From Selected KA: </run>
            <run fontsize='8'>Reorder Rate for</run>
            <run bold='true' fontsize='8'>Æ </run>
            <run fontsize='8'>customers that got acquired at the selected KAs (</run>
            <run fontcolor='#499894' fontsize='8'>*</run>
            <run fontsize='8'>) and reordered only at the very same KA they got acquired at</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='8'>RR Excluding Selected KA: </run>
            <run fontsize='8'>Reorder Rate for</run>
            <run bold='true' fontsize='8'>Æ </run>
            <run fontsize='8'>customers that got acquired at the selected KAs (</run>
            <run fontcolor='#499894' fontsize='8'>*</run>
            <run fontsize='8'>) and reordered anywhere but at the very same KA they got acquired at</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontsize='8'>Active Customers: </run>
            <run fontsize='8'>Number of unique users who ordered in the reporting month</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='8'>Acquisitions:</run>
            <run fontsize='8'> Number of customers who placed their first successful order during the period (For these cohorts, Month 0), where a customer is defined as a distinct Analytical Costumer ID,</run>
            <run fontcolor='#ffffff' fontsize='8'>Æ </run>
            <run auto-url='true' fontcolor='#ffffff' fontsize='8' hyperlink='tabdoc:load-url url=&amp;quot;https://docs.google.com/presentation/d/19zkaMmm42CPz9Os5sJZIEhlA1RPmbvFwThO2LR-9X9g&amp;quot;'>https://docs.google.com/presentation/d/19zkaMmm42CPz9Os5sJZIEhlA1RPmbvFwThO2LR-9X9g</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontsize='8'>NOTE: </run>
            <run fontsize='8'>Month 0 is not shown for reorder rate</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </caption>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.com/t/GlobalStandardReporting/workbooks/MonthlyCohort_1/ReorderRate?rev=' id='ReorderRate_1' path='/t/GlobalStandardReporting/workbooks/MonthlyCohort_1' revision='' site='GlobalStandardReporting' />
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_key_account_cohorts+ (cl_intl_markets)' name='federated.05wy1mp0r7g8wg142m0e71qjo5tl' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Reorder Rate (RR)' caption='Reorder Rate KPI' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Reorder Rate&quot;'>
              <calculation class='tableau' formula='&quot;Reorder Rate&quot;' />
              <aliases>
                <alias key='&quot;Reorder Rate&quot;' value='Reorder Rate (RR)' />
                <alias key='&quot;Reorder Rate Excluding Any KA&quot;' value='RR Excluding Any KA' />
                <alias key='&quot;Reorder Rate Excluding Selected KA&quot;' value='RR Excluding Selected KA' />
                <alias key='&quot;Reorder Rate From Any KA&quot;' value='RR From Any KA' />
                <alias key='&quot;Reorder Rate From Selected KA&quot;' value='RR From Selected KA' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.05wy1mp0r7g8wg142m0e71qjo5tl'>
            <column caption='Acquisition Customers for Calc' datatype='integer' name='[Acquisitions for Calc (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM(SUM(IIF([month_number]=0, [customers],0)))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Index' datatype='integer' name='[Calculation_528187854654222338]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Index()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Reorder Rate KPI NEW' datatype='real' default-format='p0.0%' name='[Reorder Rate KPI (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 4] &#13;&#10;    when &apos;Reorder Rate&apos; then &#13;&#10;        SUM(IF [month_number] = 0 THEN NULL ELSE [return_customers] END)&#13;&#10;&#9;/&#13;&#10;&#9;[Acquisitions for Calc (copy)]&#10;    when &apos;Reorder Rate From Any KA&apos; then &#10;        SUM(IF [month_number] = 0 THEN NULL ELSE [key_acc_return_customers] END)&#10;        / &#10;        [Acquisitions for Calc (copy)]&#10;    when &apos;Reorder Rate Excluding Any KA&apos; then &#10;        SUM(IF [month_number] = 0 THEN NULL ELSE [return_customers]-[key_acc_return_customers] END)&#10;        / &#10;        [Acquisitions for Calc (copy)]&#10;    when &apos;Reorder Rate From Selected KA&apos; then&#10;        SUM(IF [month_number] = 0 THEN NULL ELSE [same_key_acc_return_customers] END)&#10;        / &#10;        [Acquisitions for Calc (copy)]&#10;    when &apos;Reorder Rate Excluding Selected KA&apos; then&#10;        SUM(IF [month_number] = 0 THEN NULL ELSE [return_customers]-[same_key_acc_return_customers] END)&#10;        / &#10;        [Acquisitions for Calc (copy)]&#10;end' scope-isolation='false'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Acq Key Chain Info' datatype='string' name='[acq_key_chain_info]' role='dimension' type='nominal' />
            <column caption='Acq Month' datatype='datetime' name='[acq_month]' role='dimension' type='ordinal' />
            <column caption='Customers' datatype='integer' name='[customers]' role='measure' type='quantitative' />
            <column caption='Key Acc Return Customers' datatype='integer' name='[key_acc_return_customers]' role='dimension' type='ordinal' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column-instance column='[acq_month]' derivation='Month' name='[mn:acq_month:ok]' pivot='key' type='ordinal' />
            <column caption='Month Number' datatype='integer' name='[month_number]' role='dimension' type='quantitative' />
            <column-instance column='[acq_key_chain_info]' derivation='None' name='[none:acq_key_chain_info:nk]' pivot='key' type='nominal' />
            <column-instance column='[acq_month]' derivation='None' name='[none:acq_month:qk]' pivot='key' type='quantitative' />
            <column-instance column='[management_entity]' derivation='None' name='[none:management_entity:nk]' pivot='key' type='nominal' />
            <column-instance column='[month_number]' derivation='None' name='[none:month_number:ok]' pivot='key' type='ordinal' />
            <column-instance column='[sub_entity]' derivation='None' name='[none:sub_entity:nk]' pivot='key' type='nominal' />
            <column-instance column='[acq_month]' derivation='Quarter' name='[qr:acq_month:ok]' pivot='key' type='ordinal' />
            <column caption='Return Customers' datatype='integer' name='[return_customers]' role='measure' type='quantitative' />
            <column caption='Same Key Acc Return Customers' datatype='integer' name='[same_key_acc_return_customers]' role='measure' type='quantitative' />
            <column caption='Sub Entity' datatype='string' name='[sub_entity]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_528187854654222338]' derivation='User' name='[usr:Calculation_528187854654222338:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' />
            </column-instance>
            <column-instance column='[Reorder Rate KPI (copy)]' derivation='User' name='[usr:Reorder Rate KPI (copy):qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' />
              <table-calc field='[federated.05wy1mp0r7g8wg142m0e71qjo5tl].[Acquisitions for Calc (copy)]' ordering-type='Rows' />
            </column-instance>
            <column-instance column='[acq_month]' derivation='Year' name='[yr:acq_month:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.05wy1mp0r7g8wg142m0e71qjo5tl].[none:month_number:ok]' kind='hide'>
            <groupfilter function='except' user:ui-domain='relevant' user:ui-enumeration='exclusive' user:ui-manual-selection='true' user:ui-manual-selection-all-when-empty='true' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[none:month_number:ok]' />
              <groupfilter function='member' level='[none:month_number:ok]' member='0' />
            </groupfilter>
          </filter>
          <filter class='quantitative' column='[federated.05wy1mp0r7g8wg142m0e71qjo5tl].[usr:Calculation_528187854654222338:qk]' included-values='in-range'>
            <min>1</min>
