            <format attr='title' field='[federated.05wy1mp0r7g8wg142m0e71qjo5tl].[none:acq_key_chain_info:nk]' value='KA Acquisition: Chain*'>
              <formatted-text>
                <run fontalignment='0' fontcolor='#499894'>KA Acquisition: Chain*</run>
              </formatted-text>
            </format>
            <format attr='title' field='[federated.05wy1mp0r7g8wg142m0e71qjo5tl].[none:acq_month:qk]' value='Acquisition Month'>
