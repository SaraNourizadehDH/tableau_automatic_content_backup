    <worksheet name='Cohort Orders'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#ffffff' fontsize='16'>Monthly KA Cohorts - &lt;</run>
            <run fontcolor='#ffffff' fontsize='16'>[Parameters].[Parameter 1]</run>
            <run fontcolor='#ffffff' fontsize='16'>&gt;</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run bold='true' fontsize='8'>KPI Definitions</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontsize='8'>Successful Orders: </run>
            <run fontsize='8'>Total number of orders successfully processed during the reported period. Success is from a customer perspective, not commission. Basis for successful is status from Backend (not 9C or Hurrier)</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontsize='8'>Note: </run>
            <run fontsize='8'>If you select a specific KA at </run>
            <run bold='true' fontcolor='#499894' fontsize='8'>* </run>
            <run fontsize='8'>you will see the Orders (Cumulative Orders) of the </run>
            <run fontsize='8' underline='true'>users</run>
            <run fontsize='8'> that got acquired at that very chain and not the actual Orders (Cumulative Orders) placed at that KA! </run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_key_account_cohorts+ (cl_intl_markets)' name='federated.05wy1mp0r7g8wg142m0e71qjo5tl' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Orders' caption='Order KPI' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Orders&quot;'>
              <calculation class='tableau' formula='&quot;Orders&quot;' />
              <aliases>
                <alias key='&quot;Cumulative Orders&quot;' value='Cumulative Orders' />
                <alias key='&quot;Orders&quot;' value='Orders' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.05wy1mp0r7g8wg142m0e71qjo5tl'>
            <column caption='Order KPI' datatype='integer' name='[Calculation_488218394875670529]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;    WHEN &apos;Cumulative Orders&apos;    THEN SUM(ZN([cumulative_orders]))&#10;    WHEN &apos;Orders&apos;               THEN SUM([orders])&#13;&#10;END' />
            </column>
            <column caption='Acq Key Chain Info' datatype='string' name='[acq_key_chain_info]' role='dimension' type='nominal' />
            <column caption='Acq Month' datatype='datetime' name='[acq_month]' role='dimension' type='ordinal' />
            <column caption='Cumulative Orders' datatype='integer' name='[cumulative_orders]' role='measure' type='quantitative' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column-instance column='[acq_month]' derivation='Month' name='[mn:acq_month:ok]' pivot='key' type='ordinal' />
            <column caption='Month Number' datatype='integer' name='[month_number]' role='dimension' type='quantitative' />
            <column-instance column='[acq_key_chain_info]' derivation='None' name='[none:acq_key_chain_info:nk]' pivot='key' type='nominal' />
            <column-instance column='[acq_month]' derivation='None' name='[none:acq_month:qk]' pivot='key' type='quantitative' />
