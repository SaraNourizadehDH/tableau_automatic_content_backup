      <aliases enabled='yes' />
      <column caption='Acquisition Customers for Calc' datatype='integer' name='[Acquisitions for Calc (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM(IIF([month_number]=0, [customers],0)))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Frequency KPI' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[Activity KPI (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Activity KPI (copy)] &#10;    when &apos;Frequency&apos; then &#10;    case [Parameters].[Parameter 3] &#10;        when &apos;Frequency&apos; then &#10;            SUM([orders])&#10;            /&#10;            [Acquisitions for Calc (copy)]&#10;        when &apos;cum. Frequency&apos; then &#10;            SUM([cumulative_orders])&#10;            /&#10;            [Acquisitions for Calc (copy)]  &#10;    end&#10;    when &apos;Frequency From Any KA&apos; then &#10;    case [Parameters].[Parameter 3] &#10;        when &apos;Frequency&apos; then &#10;            SUM([key_acc_orders])&#10;            /&#10;            [Acquisitions for Calc (copy)]&#10;        when &apos;cum. Frequency&apos; then &#10;            SUM([cumulative_key_acc_orders])&#10;            /&#10;            [Acquisitions for Calc (copy)]  &#10;    end&#10;    when &apos;Frequency Excluding Any KA&apos; then &#10;    case [Parameters].[Parameter 3] &#10;        when &apos;Frequency&apos; then &#10;            (SUM([orders]) - SUM([key_acc_orders]))&#10;            /&#10;            [Acquisitions for Calc (copy)]&#10;        when &apos;cum. Frequency&apos; then &#10;            (SUM([cumulative_orders]) -SUM([cumulative_key_acc_orders]))&#10;            /&#10;            [Acquisitions for Calc (copy)]  &#10;    end&#10;    when &apos;Frequency From Selected KA&apos; then&#10;    case [Parameters].[Parameter 3] &#10;        when &apos;Frequency&apos; then &#10;            SUM([same_key_acc_orders])&#10;            /&#10;            [Acquisitions for Calc (copy)]&#10;        when &apos;cum. Frequency&apos; then &#10;            SUM([cumulative_same_key_acc_orders])&#10;            /&#10;            [Acquisitions for Calc (copy)]  &#10;    end&#10;    when &apos;Frequency Excluding Selected KA&apos; then&#10;    case [Parameters].[Parameter 3] &#10;        when &apos;Frequency&apos; then &#10;            (SUM([orders]) - SUM([same_key_acc_orders]))&#10;            /&#10;            [Acquisitions for Calc (copy)]&#10;        when &apos;cum. Frequency&apos; then &#10;            (SUM([cumulative_orders]) - SUM([cumulative_same_key_acc_orders]))&#10;            /&#10;            [Acquisitions for Calc (copy)]  &#10;    end&#10;end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Username Filter' datatype='boolean' name='[Calculation_4844184374682071040]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='USERNAME() = [username]' />
      </column>
      <column caption='Order KPI' datatype='integer' name='[Calculation_488218394875670529]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;    WHEN &apos;Cumulative Orders&apos;    THEN SUM(ZN([cumulative_orders]))&#10;    WHEN &apos;Orders&apos;               THEN SUM([orders])&#13;&#10;END' />
      </column>
      <column caption='Activity KPI' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_5218123922625363968]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Reorder Rate KPI (copy)] &#10;    when &apos;Activity&apos; then &#10;        SUM([orders])&#10;&#9;/&#10;&#9;SUM([customers])&#10;    when &apos;Activity From Any KA&apos; then &#10;        SUM([key_acc_orders])&#10;        / &#10;        SUM([customers])&#10;    when &apos;Activity Excluding Any KA&apos; then &#10;        (SUM([orders])-SUM(IFNULL([key_acc_orders], 0)))&#10;        / &#10;        SUM([customers])&#10;    when &apos;Activity From Selected KA&apos; then&#10;        SUM([same_key_acc_orders])&#10;        / &#10;        SUM([customers])&#10;    when &apos;Activity Excluding Selected KA&apos; then&#10;        (SUM([orders])-SUM(IFNULL([same_key_acc_orders], 0)))&#10;        / &#10;        SUM([customers])&#10;end' />
      </column>
      <column caption='Index' datatype='integer' name='[Calculation_528187854654222338]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Index()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='GMV KPIs' datatype='real' name='[Cohort KPI (Kopie)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Metric Type (Kopie)] &#10;    when &apos;GMV LC&apos; then &#13;&#10;        SUM([amt_gmv_lc])&#10;    when &apos;GMV EUR&apos; then &#13;&#10;        SUM([amt_gmv_eur])&#10;    when &apos;cum GMV / acquisition LC&apos; then &#13;&#10;        SUM([cumulative_gmv_lc])/[Acquisitions for Calc (copy)]&#13;&#10;    when &apos;cum GMV / acquisition EUR&apos; then &#13;&#10;        SUM([cumulative_gmv_eur])/[Acquisitions for Calc (copy)]&#13;&#10;end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Commission KPIs (cum values)' datatype='real' name='[Commission KPIs (Kopie)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[MPR Type (Kopie)] &#13;&#10;&#13;&#10;    when &apos;cum Commission / acquisition LC&apos; then &#13;&#10;        SUM([cumulative_commission_lc])/[Acquisitions for Calc (copy)]&#13;&#10;    when &apos;cum Commission / acquisition EUR&apos; then &#13;&#10;        SUM([cumulative_commission_eur])/[Acquisitions for Calc (copy)]&#13;&#10;end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Cumulative Frequency' datatype='real' name='[Frequency (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cumulative_orders]) / SUM([acquisition_customers])' scope-isolation='false' />
      </column>
      <column caption='Commission KPIs' datatype='real' name='[MPR KPIs (Kopie)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[MPR Type (Kopie)] &#10;    when &apos;Commission LC&apos; then &#13;&#10;        SUM([amt_commission_lc])&#10;    when &apos;Commission EUR&apos; then &#13;&#10;        SUM([amt_commission_eur])&#13;&#10;&#13;&#10;  //  when &apos;cum Commission / acquisition LC&apos; then &#13;&#10;//        sum([Inital Commission Revenue]+[Cum Commission Revenue])/sum([Acquisitions])&#13;&#10;//    when &apos;cum Commission / acquisition EUR&apos; then &#13;&#10;//        sum([inital_commission_revenue_eur]+[cum_commission_revenue_eur])/sum([Acquisitions])&#13;&#10;end' />
      </column>
      <column caption='Reorder Rate KPI NEW' datatype='real' default-format='p0.0%' name='[Reorder Rate KPI (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 4] &#13;&#10;    when &apos;Reorder Rate&apos; then &#13;&#10;        SUM(IF [month_number] = 0 THEN NULL ELSE [return_customers] END)&#13;&#10;&#9;/&#13;&#10;&#9;[Acquisitions for Calc (copy)]&#10;    when &apos;Reorder Rate From Any KA&apos; then &#10;        SUM(IF [month_number] = 0 THEN NULL ELSE [key_acc_return_customers] END)&#10;        / &#10;        [Acquisitions for Calc (copy)]&#10;    when &apos;Reorder Rate Excluding Any KA&apos; then &#10;        SUM(IF [month_number] = 0 THEN NULL ELSE [return_customers]-[key_acc_return_customers] END)&#10;        / &#10;        [Acquisitions for Calc (copy)]&#10;    when &apos;Reorder Rate From Selected KA&apos; then&#10;        SUM(IF [month_number] = 0 THEN NULL ELSE [same_key_acc_return_customers] END)&#10;        / &#10;        [Acquisitions for Calc (copy)]&#10;    when &apos;Reorder Rate Excluding Selected KA&apos; then&#10;        SUM(IF [month_number] = 0 THEN NULL ELSE [return_customers]-[same_key_acc_return_customers] END)&#10;        / &#10;        [Acquisitions for Calc (copy)]&#10;end' scope-isolation='false'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
