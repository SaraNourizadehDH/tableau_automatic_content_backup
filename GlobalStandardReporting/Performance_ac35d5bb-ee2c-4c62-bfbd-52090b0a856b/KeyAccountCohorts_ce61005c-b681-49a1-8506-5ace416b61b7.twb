  <worksheets>
    <worksheet name='Activity WS'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#ffffff' fontsize='16'>Monthly KA Cohorts - Activity</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run bold='true' fontsize='8'>KPI Definitions</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontsize='8'>Activity (A.): </run>
            <run fontsize='8'>Orders (made anywhere) divided by Active customers (looking only at those acquired at </run>
            <run fontcolor='#499894' fontsize='8'>*</run>
            <run fontsize='8'>)</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='8'>A. From Any KA: </run>
            <run fontsize='8'>Orders made at any KA divided by Active Customers (acquired at </run>
            <run fontcolor='#499894' fontsize='8'>*</run>
            <run fontsize='8'>)</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='8'>A. Ecluding Any KA: </run>
            <run fontsize='8'>Orders made at any non-KA divided by Active Customers (acquired at </run>
            <run fontcolor='#499894' fontsize='8'>*</run>
            <run fontsize='8'>)</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='8'>A. From Selected KA: </run>
            <run fontsize='8'>Orders made at the very same KA (</run>
            <run fontcolor='#499894' fontsize='8'>*</run>
            <run fontsize='8'>) divided by Active Customers (acquired at </run>
            <run fontcolor='#499894' fontsize='8'>*</run>
            <run fontsize='8'>)</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='8'>A. Excluding Selected KA: </run>
            <run fontsize='8'>Orders made anywhere except at the very same KA (</run>
            <run fontcolor='#499894' fontsize='8'>*</run>
            <run fontsize='8'>) divided by Active Customers (acquired at </run>
            <run fontcolor='#499894' fontsize='8'>*</run>
            <run fontsize='8'>)</run>
            <run>Æ&#10;&#10;&#10;&#10;&#10;</run>
          </formatted-text>
        </caption>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.com/t/GlobalStandardReporting/workbooks/MonthlyCohort_1/Activity?rev=' id='Activity' path='/t/GlobalStandardReporting/workbooks/MonthlyCohort_1' revision='' site='GlobalStandardReporting' />
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_key_account_cohorts+ (cl_intl_markets)' name='federated.05wy1mp0r7g8wg142m0e71qjo5tl' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Activity (A.)' caption='Activity KPI' datatype='string' name='[Reorder Rate KPI (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;Activity&quot;'>
              <calculation class='tableau' formula='&quot;Activity&quot;' />
              <aliases>
                <alias key='&quot;Activity&quot;' value='Activity (A.)' />
                <alias key='&quot;Activity Excluding Any KA&quot;' value='A. Excluding Any KA' />
                <alias key='&quot;Activity Excluding Selected KA&quot;' value='A. Excluding Selected KA' />
                <alias key='&quot;Activity From Any KA&quot;' value='A. From Any KA' />
                <alias key='&quot;Activity From Selected KA&quot;' value='A. From Selected KA' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.05wy1mp0r7g8wg142m0e71qjo5tl'>
            <column caption='Activity KPI' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_5218123922625363968]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Reorder Rate KPI (copy)] &#10;    when &apos;Activity&apos; then &#10;        SUM([orders])&#10;&#9;/&#10;&#9;SUM([customers])&#10;    when &apos;Activity From Any KA&apos; then &#10;        SUM([key_acc_orders])&#10;        / &#10;        SUM([customers])&#10;    when &apos;Activity Excluding Any KA&apos; then &#10;        (SUM([orders])-SUM(IFNULL([key_acc_orders], 0)))&#10;        / &#10;        SUM([customers])&#10;    when &apos;Activity From Selected KA&apos; then&#10;        SUM([same_key_acc_orders])&#10;        / &#10;        SUM([customers])&#10;    when &apos;Activity Excluding Selected KA&apos; then&#10;        (SUM([orders])-SUM(IFNULL([same_key_acc_orders], 0)))&#10;        / &#10;        SUM([customers])&#10;end' />
            </column>
            <column caption='Index' datatype='integer' name='[Calculation_528187854654222338]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Index()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Acq Key Chain Info' datatype='string' name='[acq_key_chain_info]' role='dimension' type='nominal' />
