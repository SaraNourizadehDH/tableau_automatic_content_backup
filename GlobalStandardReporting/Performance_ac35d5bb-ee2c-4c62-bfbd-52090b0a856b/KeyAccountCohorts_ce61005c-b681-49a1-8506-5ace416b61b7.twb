    <worksheet name='Frequency WS'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#ffffff' fontsize='16'>Monthly KA Cohorts - &lt;</run>
            <run fontcolor='#ffffff' fontsize='16'>[Parameters].[Parameter 3]</run>
            <run fontcolor='#ffffff' fontsize='16'>&gt;</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run bold='true' fontsize='8'>KPI Definitions</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontsize='8'>Frequency (F.): </run>
            <run fontsize='8'>Orders (made anywhere) divided by cohort acquisitions (at </run>
            <run fontcolor='#499894' fontsize='8'>*</run>
            <run fontsize='8'>)</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='8'>F. From Any KA: </run>
            <run fontsize='8'>Orders made at any KA divided by cohort acquisitions (at </run>
            <run fontcolor='#499894' fontsize='8'>*</run>
            <run fontsize='8'>)</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='8'>F. Ecluding Any KA: </run>
            <run fontsize='8'>Orders made at any non-KA divided by cohort acquisitions (at </run>
            <run fontcolor='#499894' fontsize='8'>*</run>
            <run fontsize='8'>)</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='8'>F. From Selected KA: </run>
            <run fontsize='8'>Orders made at the very same KA (</run>
            <run fontcolor='#499894' fontsize='8'>*</run>
            <run fontsize='8'>) divided by cohort acquisitions (at </run>
            <run fontcolor='#499894' fontsize='8'>*</run>
            <run fontsize='8'>)</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='8'>F. Excluding Selected KA: </run>
            <run fontsize='8'>Orders made anywhere except at the very same KA (</run>
            <run fontcolor='#499894' fontsize='8'>*</run>
            <run fontsize='8'>) divided by cohort acquisitions (at </run>
            <run fontcolor='#499894' fontsize='8'>*</run>
            <run fontsize='8'>)</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </caption>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.com/t/GlobalStandardReporting/workbooks/MonthlyCohort_1/Frequency?rev=' id='Frequency' path='/t/GlobalStandardReporting/workbooks/MonthlyCohort_1' revision='' site='GlobalStandardReporting' />
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_key_account_cohorts+ (cl_intl_markets)' name='federated.05wy1mp0r7g8wg142m0e71qjo5tl' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Frequency (F.)' caption='Frequency KPI' datatype='string' name='[Activity KPI (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;Frequency&quot;'>
              <calculation class='tableau' formula='&quot;Frequency&quot;' />
              <aliases>
                <alias key='&quot;Frequency&quot;' value='Frequency (F.)' />
                <alias key='&quot;Frequency Excluding Any KA&quot;' value='F. Excluding Any KA' />
                <alias key='&quot;Frequency Excluding Selected KA&quot;' value='F. Excluding Selected KA' />
                <alias key='&quot;Frequency From Any KA&quot;' value='F. From Any KA' />
                <alias key='&quot;Frequency From Selected KA&quot;' value='F. From Selected KA' />
              </aliases>
            </column>
            <column caption='Frequency Type' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Frequency&quot;'>
              <calculation class='tableau' formula='&quot;Frequency&quot;' />
              <aliases>
                <alias key='&quot;cum. Frequency&quot;' value='Cumulative Frequency' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.05wy1mp0r7g8wg142m0e71qjo5tl'>
            <column caption='Acquisition Customers for Calc' datatype='integer' name='[Acquisitions for Calc (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM(SUM(IIF([month_number]=0, [customers],0)))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Frequency KPI' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[Activity KPI (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Activity KPI (copy)] &#10;    when &apos;Frequency&apos; then &#10;    case [Parameters].[Parameter 3] &#10;        when &apos;Frequency&apos; then &#10;            SUM([orders])&#10;            /&#10;            [Acquisitions for Calc (copy)]&#10;        when &apos;cum. Frequency&apos; then &#10;            SUM([cumulative_orders])&#10;            /&#10;            [Acquisitions for Calc (copy)]  &#10;    end&#10;    when &apos;Frequency From Any KA&apos; then &#10;    case [Parameters].[Parameter 3] &#10;        when &apos;Frequency&apos; then &#10;            SUM([key_acc_orders])&#10;            /&#10;            [Acquisitions for Calc (copy)]&#10;        when &apos;cum. Frequency&apos; then &#10;            SUM([cumulative_key_acc_orders])&#10;            /&#10;            [Acquisitions for Calc (copy)]  &#10;    end&#10;    when &apos;Frequency Excluding Any KA&apos; then &#10;    case [Parameters].[Parameter 3] &#10;        when &apos;Frequency&apos; then &#10;            (SUM([orders]) - SUM([key_acc_orders]))&#10;            /&#10;            [Acquisitions for Calc (copy)]&#10;        when &apos;cum. Frequency&apos; then &#10;            (SUM([cumulative_orders]) -SUM([cumulative_key_acc_orders]))&#10;            /&#10;            [Acquisitions for Calc (copy)]  &#10;    end&#10;    when &apos;Frequency From Selected KA&apos; then&#10;    case [Parameters].[Parameter 3] &#10;        when &apos;Frequency&apos; then &#10;            SUM([same_key_acc_orders])&#10;            /&#10;            [Acquisitions for Calc (copy)]&#10;        when &apos;cum. Frequency&apos; then &#10;            SUM([cumulative_same_key_acc_orders])&#10;            /&#10;            [Acquisitions for Calc (copy)]  &#10;    end&#10;    when &apos;Frequency Excluding Selected KA&apos; then&#10;    case [Parameters].[Parameter 3] &#10;        when &apos;Frequency&apos; then &#10;            (SUM([orders]) - SUM([same_key_acc_orders]))&#10;            /&#10;            [Acquisitions for Calc (copy)]&#10;        when &apos;cum. Frequency&apos; then &#10;            (SUM([cumulative_orders]) - SUM([cumulative_same_key_acc_orders]))&#10;            /&#10;            [Acquisitions for Calc (copy)]  &#10;    end&#10;end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Acq Key Chain Info' datatype='string' name='[acq_key_chain_info]' role='dimension' type='nominal' />
            <column caption='Acq Month' datatype='datetime' name='[acq_month]' role='dimension' type='ordinal' />
            <column caption='Cumulative Key Acc Orders' datatype='integer' name='[cumulative_key_acc_orders]' role='measure' type='quantitative' />
            <column caption='Cumulative Orders' datatype='integer' name='[cumulative_orders]' role='measure' type='quantitative' />
            <column caption='Cumulative Same Key Acc Orders' datatype='integer' name='[cumulative_same_key_acc_orders]' role='measure' type='quantitative' />
            <column caption='Customers' datatype='integer' name='[customers]' role='measure' type='quantitative' />
            <column caption='Key Acc Orders' datatype='integer' name='[key_acc_orders]' role='dimension' type='ordinal' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column-instance column='[acq_month]' derivation='Month' name='[mn:acq_month:ok]' pivot='key' type='ordinal' />
            <column caption='Month Number' datatype='integer' name='[month_number]' role='dimension' type='quantitative' />
            <column-instance column='[acq_key_chain_info]' derivation='None' name='[none:acq_key_chain_info:nk]' pivot='key' type='nominal' />
            <column-instance column='[acq_month]' derivation='None' name='[none:acq_month:qk]' pivot='key' type='quantitative' />
            <column-instance column='[management_entity]' derivation='None' name='[none:management_entity:nk]' pivot='key' type='nominal' />
            <column-instance column='[month_number]' derivation='None' name='[none:month_number:ok]' pivot='key' type='ordinal' />
            <column-instance column='[sub_entity]' derivation='None' name='[none:sub_entity:nk]' pivot='key' type='nominal' />
            <column caption='Orders' datatype='integer' name='[orders]' role='measure' type='quantitative' />
            <column-instance column='[acq_month]' derivation='Quarter' name='[qr:acq_month:ok]' pivot='key' type='ordinal' />
            <column caption='Same Key Acc Orders' datatype='integer' name='[same_key_acc_orders]' role='measure' type='quantitative' />
            <column caption='Sub Entity' datatype='string' name='[sub_entity]' role='dimension' type='nominal' />
            <column-instance column='[Activity KPI (copy)]' derivation='User' name='[usr:Activity KPI (copy):qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' />
              <table-calc field='[federated.05wy1mp0r7g8wg142m0e71qjo5tl].[Acquisitions for Calc (copy)]' ordering-type='Rows' />
            </column-instance>
            <column-instance column='[acq_month]' derivation='Year' name='[yr:acq_month:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <filter class='quantitative' column='[federated.05wy1mp0r7g8wg142m0e71qjo5tl].[usr:Activity KPI (copy):qk]' included-values='in-range'>
            <min>0.0</min>
          </filter>
          <slices>
            <column>[federated.05wy1mp0r7g8wg142m0e71qjo5tl].[usr:Activity KPI (copy):qk]</column>
            <column>[federated.05wy1mp0r7g8wg142m0e71qjo5tl].[none:sub_entity:nk]</column>
            <column>[federated.05wy1mp0r7g8wg142m0e71qjo5tl].[none:management_entity:nk]</column>
            <column>[federated.05wy1mp0r7g8wg142m0e71qjo5tl].[none:acq_month:qk]</column>
            <column>[federated.05wy1mp0r7g8wg142m0e71qjo5tl].[none:acq_key_chain_info:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='width' field='[federated.05wy1mp0r7g8wg142m0e71qjo5tl].[none:month_number:ok]' value='81' />
          </style-rule>
          <style-rule element='header'>
