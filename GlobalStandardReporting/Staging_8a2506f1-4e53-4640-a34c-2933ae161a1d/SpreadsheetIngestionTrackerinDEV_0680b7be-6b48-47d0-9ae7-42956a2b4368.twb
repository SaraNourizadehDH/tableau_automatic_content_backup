      <column caption='% vendor penetration' datatype='real' name='[Calculation_1416241372916867072]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Calculation_3469601326657134600])/([Calculation_3469601326656143366])' />
      </column>
      <column caption='Month Date' datatype='date' name='[Calculation_3469601326602588160]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Month]&#10;    WHEN &quot;January&quot; THEN DATE(&quot;2023-01-01&quot;)&#10;    WHEN &quot;February&quot; THEN DATE(&quot;2023-02-01&quot;)&#10;    WHEN &quot;March&quot; THEN DATE(&quot;2023-03-01&quot;)&#10;    WHEN &quot;April&quot; THEN DATE(&quot;2023-04-01&quot;)&#10;    WHEN &quot;May&quot; THEN DATE(&quot;2023-05-01&quot;)&#10;    WHEN &quot;June&quot; THEN DATE(&quot;2023-06-01&quot;)&#10;    WHEN &quot;July&quot; THEN DATE(&quot;2023-07-01&quot;)&#10;    WHEN &quot;August&quot; THEN DATE(&quot;2023-08-01&quot;)&#10;    WHEN &quot;September&quot; THEN DATE(&quot;2023-09-01&quot;)&#10;    WHEN &quot;October&quot; THEN DATE(&quot;2023-10-01&quot;)&#10;    WHEN &quot;November&quot; THEN DATE(&quot;2023-11-01&quot;)&#10;    WHEN &quot;December&quot; THEN DATE(&quot;2023-12-01&quot;)&#10;END' />
      </column>
      <column caption='Months' datatype='string' name='[Calculation_3469601326604242945]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEPART(&apos;month&apos;, [Calculation_3469601326602588160]) &lt; DATEPART(&apos;month&apos;, TODAY()) THEN [Month] END' />
      </column>
      <column caption='Vendor ID Count' datatype='integer' name='[Calculation_3469601326656143366]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([vendor_id])' />
      </column>
      <column caption='Non Null Vendor ID' datatype='string' name='[Calculation_3469601326657134600]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [per_si_promo]!= 0&#10;THEN [vendor_id] END' />
      </column>
      <column caption='Prev Vendor Id' datatype='integer' name='[Calculation_3469601326665703438]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF DATEPART(&apos;month&apos;, [Calculation_3469601326602588160]) = DATEPART(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY()))&#10;    AND DATEPART(&apos;year&apos;, [Calculation_3469601326602588160]) = DATEPART(&apos;year&apos;, DATEADD(&apos;month&apos;, -1, TODAY()))&#10;THEN&#10;    { FIXED : COUNT([vendor_id]) }&#10;END' />
      </column>
