      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1p6mdic1mk508g1gi8eap1thlmth].[avg:per_si_promo:qk]&quot;' value='SI Promo%' />
