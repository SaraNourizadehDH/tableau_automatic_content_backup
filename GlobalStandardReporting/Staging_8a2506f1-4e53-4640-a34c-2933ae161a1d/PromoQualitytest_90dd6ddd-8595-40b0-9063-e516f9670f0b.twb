    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Getting Started'>
      <repository-location id='GettingStarted' path='/t/GlobalStandardReporting/workbooks/AffordabilityScoreCard' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='1400' maxwidth='1000' minheight='1400' minwidth='1000' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='6' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='2277' id='5' type-v2='text' w='98400' x='800' y='18652'>
            <formatted-text>
              <run bold='true' fontcolor='#e15759' fontsize='18'>How is the Score calculated?</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='16571' id='7' type-v2='text' w='98400' x='800' y='20929'>
            <formatted-text>
              <run fontcolor='#000000' fontname='Outfit' fontsize='8'>The metrics used are the ones displayed in the table below, together with their description. </run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontname='Outfit' fontsize='8'>- Score ranges from 1 to 100, similar to AQS, according to Score formula* at a country-month level</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontname='Outfit' fontsize='8'>- Limits are based on global benchmarks (percentiles 10 &amp; 90, respectively)</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontname='Outfit' fontsize='8'>- Model weights are determined based on the perceived importance determined with Regional teams and strength of correlation between variable values and key commercial outputs, including Orders, GPV, Customers, ABV, Units Sold, and Frequency</run>
              <run>Æ&#10;&#10;</run>
              <run fontname='Outfit' fontsize='5'>Score calculation: Weight * [(Max points - Min points)/(Max points - Min points)]*100. Eg: Promo attractiveness is 20%*[(67%-45%)/(75%-45%)]*100=14.6 ~&gt;15</run>
              <run>Æ&#10;&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone h='10669' id='45' is-centered='0' is-scaled='1' param='Image/DH-Logo_Tableau 1.png' type-v2='bitmap' w='14400' x='800' y='571'>
