    <worksheet name='Score Evolution Comp Graph'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='pqs' name='federated.15l6rta1088oux1dx3dar03qh865' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Past N Months' datatype='integer' name='[Currency (copy)]' param-domain-type='range' role='measure' type='quantitative' value='7'>
              <calculation class='tableau' formula='7' />
              <range granularity='1' max='24' min='1' />
            </column>
            <column caption='X Axis' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Promo Attractiveness Score&quot;'>
              <calculation class='tableau' formula='&quot;Promo Attractiveness Score&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.15l6rta1088oux1dx3dar03qh865'>
            <column caption='Score' datatype='real' name='[Calculation_1185854145418219532]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[pqs_score]' />
            </column>
            <column caption='X Axis' datatype='real' name='[Calculation_1185854145493569550]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;Score&quot; THEN [Calculation_1185854145418219532]&#13;&#10;    WHEN &quot;Promo Attractiveness Score&quot; THEN [promo_attractiveness_score]&#13;&#10;    WHEN &quot;Promo Availabilty Score&quot; THEN [promo_availability_score]&#13;&#10;    WHEN &quot;Share of Effective Promo Score&quot; THEN [effective_promo_score]&#13;&#10;    WHEN &quot;Gross GPV Uplift&quot; THEN [market_promo_gpv_score]&#13;&#10;END' />
            </column>
            <column caption='Month' datatype='string' name='[Calculation_238972299405660163]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(DATEPART(&apos;year&apos;, [date_month])) + &apos;-&apos; +&#13;&#10;RIGHT(&apos;00&apos; + STR(DATEPART(&apos;month&apos;, [date_month])), 2)' />
            </column>
            <column caption='Filter for past months' datatype='boolean' name='[Calculation_655273804877156353]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  [date_month] &gt;= DATEADD(&apos;month&apos;, -[Parameters].[Currency (copy)], TODAY())&#13;&#10;THEN  TRUE ELSE FALSE END' />
            </column>
            <column caption='Comparison Metric' datatype='real' name='[X Axis (copy)_904097689131704320]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1185854145493569550]' />
            </column>
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Date Month' datatype='date' name='[date_month]' role='dimension' type='ordinal' />
            <column caption='Display Name' datatype='string' name='[display_name]' role='dimension' type='nominal' />
            <column caption='Effective Promo Score' datatype='real' name='[effective_promo_score]' role='measure' type='quantitative' />
            <column caption='Granularity' datatype='string' name='[granularity]' role='dimension' type='nominal' />
