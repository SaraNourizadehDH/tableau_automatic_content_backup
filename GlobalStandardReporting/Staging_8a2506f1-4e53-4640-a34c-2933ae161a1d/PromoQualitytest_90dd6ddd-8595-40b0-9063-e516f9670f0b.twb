      <aliases enabled='yes' />
      <column caption='2. Score Asst. Design Gap ' datatype='integer' hidden='true' name='[1. Score Avg Listed SKUs (copy)_1185854145411874821]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [perc_design_compliance]  &gt; 30 THEN 0&#13;&#10;ELSEIF [perc_design_compliance] &gt;= 27.5 THEN 1&#13;&#10;ELSEIF [perc_design_compliance] &gt;= 25 THEN 2&#13;&#10;ELSEIF [perc_design_compliance] &gt;= 22.5 THEN 3&#13;&#10;ELSEIF [perc_design_compliance] &gt;= 20 THEN 4&#13;&#10;ELSEIF [perc_design_compliance] &gt;= 17.5 THEN 5&#13;&#10;ELSEIF [perc_design_compliance] &gt;= 15 THEN 6&#13;&#10;ELSEIF [perc_design_compliance] &gt;= 12.5 THEN 7&#13;&#10;ELSEIF [perc_design_compliance] &gt;= 10 THEN 8&#13;&#10;ELSEIF [perc_design_compliance] &gt;= 7.5 THEN 9&#13;&#10;ELSE 10 END' />
      </column>
