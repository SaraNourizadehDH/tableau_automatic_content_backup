        <calculation class='tableau' formula='IF [check_book_value]  &gt; 40 THEN 0&#13;&#10;ELSEIF [check_book_value] &gt;= 37.5 THEN 1&#13;&#10;ELSEIF [check_book_value] &gt;= 35 THEN 2&#13;&#10;ELSEIF [check_book_value] &gt;= 32.5 THEN 3&#13;&#10;ELSEIF [check_book_value] &gt;= 30 THEN 4&#13;&#10;ELSEIF [check_book_value] &gt;= 27.5 THEN 5&#13;&#10;ELSEIF [check_book_value] &gt;= 25 THEN 6&#13;&#10;ELSEIF [check_book_value] &gt;= 22.5 THEN 7&#13;&#10;ELSEIF [check_book_value] &gt;= 20 THEN 8&#13;&#10;ELSEIF [check_book_value] &gt;= 17.5 THEN 9&#13;&#10;ELSE 10 END' />
