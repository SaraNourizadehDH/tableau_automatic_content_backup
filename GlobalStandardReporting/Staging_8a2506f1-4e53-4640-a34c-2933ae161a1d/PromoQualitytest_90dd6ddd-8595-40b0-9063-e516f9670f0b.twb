          <datasource-dependencies datasource='federated.15l6rta1088oux1dx3dar03qh865'>
            <column caption='Listed SKUs MoM' datatype='real' hidden='true' name='[Calculation_2981101509400100869]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF DATETRUNC(&apos;month&apos;,[date_month]) = [Parameters].[X Axis (copy)] THEN [avg_listed_skus_check] END)&#13;&#10;&#13;&#10;-&#13;&#10;&#13;&#10;SUM(IF DATETRUNC(&apos;month&apos;,[date_month]) = DATEADD(&apos;month&apos;,-1,[Parameters].[X Axis (copy)]) THEN [avg_listed_skus_check] END))' />
