              <calculation class='tableau' formula='[pqs_score]' />
            </column>
            <column caption='X Axis' datatype='real' name='[Calculation_1185854145493569550]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;Score&quot; THEN [Calculation_1185854145418219532]&#13;&#10;    WHEN &quot;Promo Attractiveness Score&quot; THEN [promo_attractiveness_score]&#13;&#10;    WHEN &quot;Promo Availabilty Score&quot; THEN [promo_availability_score]&#13;&#10;    WHEN &quot;Share of Effective Promo Score&quot; THEN [effective_promo_score]&#13;&#10;    WHEN &quot;Gross GPV Uplift&quot; THEN [market_promo_gpv_score]&#13;&#10;END' />
            </column>
            <column caption='Month' datatype='string' name='[Calculation_238972299405660163]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(DATEPART(&apos;year&apos;, [date_month])) + &apos;-&apos; +&#13;&#10;RIGHT(&apos;00&apos; + STR(DATEPART(&apos;month&apos;, [date_month])), 2)' />
            </column>
            <column caption='Filter for past months' datatype='boolean' name='[Calculation_655273804877156353]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  [date_month] &gt;= DATEADD(&apos;month&apos;, -[Parameters].[Currency (copy)], TODAY())&#13;&#10;THEN  TRUE ELSE FALSE END' />
            </column>
            <column caption='Y Axis' datatype='real' name='[X Axis (copy)_1185854145498325007]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[X Axis (copy 2)_1083115766643929088]&#13;&#10;    WHEN &quot;Score&quot; THEN [Calculation_1185854145418219532]&#10;    WHEN &quot;ABV&quot; THEN ([country_gpv_eur])/([count_order_id])&#10;    WHEN &quot;ABS&quot; THEN ([sum_items_qty_sold]/([count_order_id]))&#13;&#10;END' />
