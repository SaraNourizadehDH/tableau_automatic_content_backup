      </column>
      <column caption='Weightable GPV % from Total' datatype='real' name='[Calculation_5122703897003552768]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([w_order_GPV])/SUM([total_GPV])' />
      </column>
      <column caption='Weightable GPV% from UF' datatype='real' name='[Calculation_5122703897003778049]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([w_order_GPV])/SUM([uf_f_order_GPV])' />
      </column>
      <column caption='Weightable items GPV% from Total GPV' datatype='real' name='[Calculation_5122703897004453890]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([w_items_GPV])/SUM([total_GPV])' />
      </column>
      <column caption='Weightable items GPV% from UF/F GPV' datatype='real' name='[Calculation_5122703897004646403]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([w_items_GPV])/sum([uf_f_order_GPV])' />
      </column>
      <column caption='% Weightable Orders from Total' datatype='real' name='[Calculation_5122703897004961796]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([w_orders])/SUM([total_orders])' />
      </column>
      <column caption='% Weightable Orders from UF/F' datatype='real' name='[Calculation_5122703897005072389]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([w_orders])/SUM([uf_f_orders])' />
      </column>
      <column caption='Total ABS' datatype='real' name='[Calculation_5122703897006260230]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_items])/SUM([total_orders])' />
      </column>
      <column caption='UF/F ABS' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_5122703897006444551]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([uf_f_all_order_items])/SUM([uf_f_orders])' />
      </column>
      <column caption='Weightables ABS' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_5122703897006882824]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([w_all_order_items])/SUM([w_orders])' />
      </column>
      <column caption='AVG # of UF/F Items in Basket' datatype='real' name='[Calculation_5122703897007411209]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([uf_f_items])/SUM([uf_f_orders])' />
      </column>
      <column caption='AVG # of Weightables Items in Basket' datatype='real' name='[Calculation_5122703897007546378]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([w_items])/SUM([w_orders])' />
      </column>
      <column caption='Total ABV' datatype='real' name='[Calculation_5122703897009041419]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_GPV])/sum([total_orders])' />
      </column>
      <column caption='UF/F ABV' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_5122703897009197068]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([uf_f_order_GPV])/sum([uf_f_orders])' />
      </column>
      <column caption='Weightables ABV' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_5122703897009455117]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([w_order_GPV])/SUM([w_orders])' />
      </column>
      <column caption='Average Sales Price UF/F Items' datatype='real' name='[Calculation_5122703897009668110]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([uf_f_items_GPV])/SUM([uf_f_items])' />
      </column>
      <column caption='Average Sales Price Weightable Items' datatype='real' name='[Calculation_5122703897010262031]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([w_items_GPV])/SUM([w_items])' />
      </column>
      <column caption='Quarter' datatype='string' name='[Calculation_5122703897015865362]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(YEAR([order_month])) + &apos;Q&apos; + STR(DATEPART(&apos;quarter&apos;, [order_month]))' />
      </column>
      <column caption='Month_Name' datatype='string' name='[Calculation_5122703897020899348]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;month&apos;, [order_month]) + &quot; &quot; + STR(YEAR([order_month]))' />
      </column>
      <column caption='GPV previous month' datatype='real' name='[Calculation_5122703897087602712]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(SUM([w_items_GPV]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='W_GPV_diff' datatype='real' name='[Calculation_5122703897087774745]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([w_items_GPV]) - LOOKUP(SUM([w_items_GPV]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='W_item_gpv arrow' datatype='string' name='[Calculation_5122703897088094234]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([w_items_GPV]) - LOOKUP(SUM([w_items_GPV]), -1) &gt; 0 THEN &quot;▲&quot;&#10;ELSEIF SUM([w_items_GPV]) - LOOKUP(SUM([w_items_GPV]), -1) &lt; 0 THEN &quot;▼&quot;&#10;ELSE &quot;&quot;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='gpv items diff %' datatype='real' name='[Calculation_5122703897090822171]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5122703897087774745]/SUM([w_items_GPV])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Cuurent month' datatype='date' name='[Calculation_5122703897091956765]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED : MAX([order_month]) }' />
      </column>
      <column caption='is latest month' datatype='boolean' name='[Calculation_5122703897092227102]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[order_month] = [Calculation_5122703897091956765]' />
      </column>
      <column caption='w_gpv diff %' datatype='real' name='[Calculation_5122703898824728607]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF DATETRUNC(&apos;month&apos;, MAX([order_month])) = DATETRUNC(&apos;month&apos;, WINDOW_MAX(MAX([order_month]))) THEN&#10;    (SUM([w_items_GPV]) - LOOKUP(SUM([w_items_GPV]), -1)) / LOOKUP(SUM([w_items_GPV]), -1)&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='W_order_diff' datatype='integer' name='[Calculation_5122703898840109090]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([w_orders]) - LOOKUP(SUM([w_orders]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='W_order_arrow' datatype='string' name='[Calculation_5122703898840358947]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([w_orders]) - LOOKUP(SUM([w_orders]), -1) &gt; 0 THEN &quot;▲&quot;&#10;ELSEIF SUM([w_orders]) - LOOKUP(SUM([w_orders]), -1) &lt; 0 THEN &quot;▼&quot;&#10;ELSE &quot;&quot;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
