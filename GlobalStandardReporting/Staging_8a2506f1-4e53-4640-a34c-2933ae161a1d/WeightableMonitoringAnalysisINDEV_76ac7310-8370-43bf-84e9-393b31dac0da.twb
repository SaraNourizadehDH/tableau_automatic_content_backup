    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Performance Report'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/WeightableMonitoringAnalysisINDEV/PerformanceReport?rev=' id='PerformanceReport' path='/t/GlobalStandardReporting/workbooks/WeightableMonitoringAnalysisINDEV' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='dash-text'>
          <format attr='text-align' id='dash-text_37' value='center' />
        </style-rule>
      </style>
      <size maxheight='3000' maxwidth='1380' minheight='3000' minwidth='1380' sizing-mode='fixed' />
      <datasources>
        <datasource caption='weightable_temp_data_soumya (rl_dmart)' name='federated.0bsv20j0tyeh4f10rkih21pux4iu' />
      </datasources>
      <datasource-dependencies datasource='federated.0bsv20j0tyeh4f10rkih21pux4iu'>
        <column caption='Quarter' datatype='string' name='[Calculation_5122703897015865362]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='STR(YEAR([order_month])) + &apos;Q&apos; + STR(DATEPART(&apos;quarter&apos;, [order_month]))' />
        </column>
        <column caption='Chain Id' datatype='string' name='[chain_id]' role='dimension' type='nominal' />
