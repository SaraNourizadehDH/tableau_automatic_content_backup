      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0bsv20j0tyeh4f10rkih21pux4iu].[ctd:chain_name:qk]&quot;' value='# Chains (Key Partners)' />
