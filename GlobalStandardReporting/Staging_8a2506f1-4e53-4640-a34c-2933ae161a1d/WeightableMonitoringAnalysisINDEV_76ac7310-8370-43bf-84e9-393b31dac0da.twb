                <zone forceUpdate='true' h='71125' id='6' type-v2='text' w='98666' x='667' y='28375'>
                  <formatted-text>
                    <run>Æ&#10;</run>
                    <run fontcolor='#b7090e' fontname='Tableau Bold' fontsize='14'>GPV</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='11'>Total GPV of Chains (that rolled out Weightables) :  </run>
                    <run fontname='Tableau Regular' fontsize='11'>Total Price paid by customer for an order [including VAT]</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='11'>GPV of orders with at least one UF/F item  :  </run>
                    <run fontname='Tableau Regular' fontsize='11'>Total Price paid by customer [including VAT] for order  that has atleast one </run>
                    <run fontcolor='#b7090e' fontname='Tableau Regular' fontsize='11'>UF/F item</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='11'>Æ </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='11'>GPV of orders with at least one Weightable item : </run>
                    <run fontname='Tableau Regular' fontsize='11'>Total Price paid by customer [including VAT] for order  that has atleast one </run>
                    <run fontcolor='#b7090e' fontname='Tableau Regular' fontsize='11'>Weightable item</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='11'>Æ </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='11'>Weightable GPV% from Total : [</run>
                    <run fontcolor='#555555' fontname='Tableau Regular' fontsize='11'>GPV of orders with at least one Weightable item / Total GPV of Chains]</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Regular' fontsize='11'>Weightable GPV% from UF/F </run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='11'>: [</run>
                    <run fontcolor='#555555' fontname='Tableau Regular' fontsize='11'>GPV of orders with at least one Weightable item /GPV of orders with at least one UF/F item ]</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='11'>F/UF items GPV (GPV UF/F items) : </run>
                    <run fontname='Tableau Regular' fontsize='11'>Total Price paid by customer for </run>
                    <run fontcolor='#b7090e' fontname='Tableau Regular' fontsize='11'>UF/F items</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='11'>Weightable items GPV (GPV Weightable items): </run>
                    <run fontname='Tableau Regular' fontsize='11'>Total Price paid by customer for  </run>
                    <run fontcolor='#b7090e' fontname='Tableau Regular' fontsize='11'>Weightable items</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#b7090e' fontname='Tableau Bold' fontsize='14'>Orders</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='11'>Total Orders :</run>
                    <run fontcolor='#555555' fontname='Tableau Regular' fontsize='11'> # of Orders for Chains that rolled out Weightables</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='11'>UF/F Orders :</run>
                    <run fontcolor='#555555' fontname='Tableau Regular' fontsize='11'> # of orders where atleat one item was </run>
                    <run fontcolor='#b7090e' fontname='Tableau Regular' fontsize='11'>UF/F</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='11'>Weightable Orders : </run>
                    <run fontcolor='#555555' fontname='Tableau Regular' fontsize='11'># of orders where atleat one item was </run>
                    <run fontcolor='#b7090e' fontname='Tableau Regular' fontsize='11'>Weightable</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#b7090e' fontname='Tableau Bold' fontsize='14'>Items</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='11'>Total # of Items Sold</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='11'>Total # of Items Sold in Orders with at least one UF/F Item in the Order</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='11'>Total # of Items Sold in Orders with at least one Weightable Item in the Order</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='11'>Total # of UF/F Items Sold </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='11'>Total # of Weightable Items Sold </run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#b7090e' fontname='Tableau Bold' fontsize='14'>Average Basket Size</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='11'>Total ABS</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='11'>UF/F ABS:  </run>
                    <run fontcolor='#555555' fontname='Tableau Regular' fontsize='11'>Total basket size for orders where at least one item is </run>
                    <run fontcolor='#b7090e' fontname='Tableau Regular' fontsize='11'>UF/F</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='11'>Weightables ABS : </run>
                    <run fontcolor='#555555' fontname='Tableau Regular' fontsize='11'>Total basket size for orders where at least one item is </run>
                    <run fontcolor='#b7090e' fontname='Tableau Regular' fontsize='11'>Weightable</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='11'>Average # of UF/F Items in Basket : </run>
                    <run fontcolor='#555555' fontname='Tableau Regular' fontsize='11'>Avg. Quantity Size</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='11'>Average # of Weightables Items in Basket : </run>
                    <run fontcolor='#555555' fontname='Tableau Regular' fontsize='11'>Avg. Quantity Size</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#b7090e' fontname='Tableau Bold' fontsize='14'>Average Basket Value</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='11'>Total ABV</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='11'>UF/F ABV : </run>
                    <run fontcolor='#555555' fontname='Tableau Regular' fontsize='11'>Total basket value for orders where at least one item is </run>
                    <run fontcolor='#b7090e' fontname='Tableau Regular' fontsize='11'>UF/F</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='11'>Weightables ABV : </run>
                    <run fontcolor='#555555' fontname='Tableau Regular' fontsize='11'>Total basket value for orders where at least one item is </run>
                    <run fontcolor='#b7090e' fontname='Tableau Regular' fontsize='11'>Weightable</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='11'>Average Sales Price </run>
                    <run fontcolor='#b7090e' fontname='Tableau Regular' fontsize='11'>UF/F Items</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='11'>Average Sales Price </run>
                    <run fontcolor='#b7090e' fontname='Tableau Regular' fontsize='11'>Weightable </run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='11'>Items</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#b7090e' fontname='Tableau Bold' fontsize='14'>Assortment</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='11'># of Partners with Weightables : </run>
                    <run fontcolor='#555555' fontname='Tableau Regular' fontsize='11'>Total chains with at least 1 weightable SKU active</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#b7090e' fontname='Tableau Regular' fontsize='12' italic='true'>SKU Funnel &gt;&gt;&gt;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#555555' fontname='Tableau Regular' fontsize='11'># SKUs in Catalog</run>
