      <table>
        <view>
          <datasources>
            <datasource caption='weightable_temp_data_soumya (rl_dmart)' name='federated.0bsv20j0tyeh4f10rkih21pux4iu' />
          </datasources>
          <datasource-dependencies datasource='federated.0bsv20j0tyeh4f10rkih21pux4iu'>
            <column caption='UF/F ABS' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_5122703897006444551]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([uf_f_all_order_items])/SUM([uf_f_orders])' />
            </column>
            <column caption='Weightables ABS' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_5122703897006882824]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([w_all_order_items])/SUM([w_orders])' />
            </column>
            <column caption='Quarter' datatype='string' name='[Calculation_5122703897015865362]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(YEAR([order_month])) + &apos;Q&apos; + STR(DATEPART(&apos;quarter&apos;, [order_month]))' />
