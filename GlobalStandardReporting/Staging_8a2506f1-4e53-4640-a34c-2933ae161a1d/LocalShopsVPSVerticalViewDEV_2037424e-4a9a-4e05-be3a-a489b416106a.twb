    <worksheet name='Verticals Marketplace'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='ls_vps_stg_monthly (cl_dmart)' name='federated.0lv5k2c1n0iz5v13tz9zl0k21co1' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Column L1' datatype='string' name='[Parameter 1 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Vertical&quot;'>
              <calculation class='tableau' formula='&quot;Vertical&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0lv5k2c1n0iz5v13tz9zl0k21co1'>
            <column caption='# Zombie' datatype='integer' name='[# Total Online Vendors (copy)_5998724359019638812]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF [is_zombie] AND [is_online]&#10;   THEN [Calculation_5998724359021813790] ELSE NULL END)' />
            </column>
            <column caption='# New' datatype='integer' name='[# Zombie (copy)_5998724359019905053]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF [is_vendor_new_m0] AND [is_online]&#10; THEN [Calculation_5998724359021813790] ELSE NULL END)' />
            </column>
            <column caption='Average VPS v1' datatype='real' name='[Calculation_1230116035724840965]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='ROUND(AVG([vps_v1]),1)' />
            </column>
            <column caption='Report Month (String)' datatype='string' name='[Calculation_2188186524933500930]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(STR(DATENAME(&apos;month&apos;, [report_month])),3) + &quot;&apos;&quot; + RIGHT(STR(DATEPART(&apos;year&apos;, [report_month])),2)' />
            </column>
            <column caption='Column L1' datatype='string' name='[Calculation_2188186524935585795]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1 1]&#10;    WHEN &quot;No Breakdown&quot; THEN &quot;&quot;&#10;    WHEN &quot;Segment&quot; THEN [region]&#10;    WHEN &quot;Management Entity&quot; THEN [Calculation_5502132165345308674]&#10;    WHEN &quot;Country Name&quot; THEN [country_name]&#10;    WHEN &quot;Vertical&quot; THEN [vertical]&#10;    WHEN &quot;Vertical Segment&quot; THEN [vertical_segment]&#10;    //WHEN &quot;Vertical Parent&quot; THEN &#10;    //WHEN &quot;Vertical Type&quot; THEN &#10;    //WHEN &quot;AAA Chain Name Cleaned&quot; THEN &#10;    WHEN &quot;Is AAA&quot; THEN STR([is_aaa])&#10;    //WHEN &quot;Is AAA Supermarket&quot; THEN STR([Is AAA Supermarket])&#10;    //WHEN &quot;Is Own Delivery&quot; THEN STR([Is Own Delivery])&#10;    WHEN &quot;Report Month&quot; THEN [Calculation_2188186524933500930]&#10;    WHEN &quot;Report Quarter&quot; THEN &quot;Q&quot; + LEFT(STR(DATENAME(&apos;quarter&apos;, [report_month])),3) + &quot;&apos;&quot; + RIGHT(STR(DATEPART(&apos;year&apos;, [report_month])),2)&#10;END' />
            </column>
            <column caption='Promo Contribution (% of GPV)' datatype='real' name='[Calculation_2188186526664994824]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM( [sum_gpv_promo_items_eur] )&#10;/&#10;SUM([sum_gpv_all_eur] )' />
            </column>
            <column caption='Marketplace' datatype='integer' datatype-customized='true' name='[Calculation_498070026568073216]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(&quot;&quot;)' />
            </column>
            <column aggregation='CountD' caption='Customer' datatype='integer' datatype-customized='true' name='[Calculation_498070026568929282]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='INT(&quot;&quot;)' />
            </column>
            <column caption='Management_Entity' datatype='string' name='[Calculation_5502132165345308674]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [management_entity]&#10;WHEN &apos;Yemeksepeti&apos; THEN &apos;DH Europe&apos;&#10;ELSE [management_entity]&#10;END' />
            </column>
            <column caption='Vendor Fail Rate' datatype='real' name='[Calculation_5502132165360877571]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_orders_vendor]) / SUM([all_orders])' />
            </column>
            <column caption='Is AAA' datatype='string' name='[Calculation_5987746869230931968]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [is_aaa] WHEN True then &apos;TRUE&apos;&#10;WHEN False THEN &apos;FALSE&apos;&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='ABV' datatype='real' name='[Calculation_5987746869607972865]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gbv_eur]) / SUM([successful_orders])' />
            </column>
            <column caption='ABS' datatype='real' name='[Calculation_5987746869608894466]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ops_qty_delivered]) / SUM([ops_confirmed_orders])' />
            </column>
            <column caption='Frequency' datatype='real' name='[Calculation_5987746869612150787]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders]) / SUM([vendor_mau])' />
            </column>
            <column caption='Contact_Rate' datatype='real' name='[Calculation_5987746869624295428]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([contacted_orders]) / SUM([all_orders])' />
            </column>
            <column caption='# Total' datatype='integer' name='[Calculation_5998724359007277083]' role='measure' type='quantitative'>
