          </datasources>
          <datasource-dependencies datasource='federated.0lv5k2c1n0iz5v13tz9zl0k21co1'>
            <column caption='Avg % Items Not Delivered' datatype='real' name='[Avg Vendor Fail Rate (copy)_5998724358973050897]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([perc_items_not_delivered])' />
            </column>
            <column caption='Report Month &gt;= L12M Filter' datatype='boolean' name='[Calculation_3496552563108286464]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_month] &gt;= dateadd(&apos;month&apos;, -12,DATETRUNC(&apos;month&apos;, TODAY()))' />
            </column>
            <column caption='Avg mCVR3' datatype='real' name='[Calculation_5998724358673416193]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([mcvr3])' />
