            <column caption='# Zombie' datatype='integer' name='[# Total Online Vendors (copy)_5998724359019638812]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF [is_zombie] AND [is_online]&#10;   THEN [Calculation_5998724359021813790] ELSE NULL END)' />
            </column>
            <column caption='Average VPS v1' datatype='real' name='[Calculation_1230116035724840965]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='ROUND(AVG([vps_v1]),1)' />
            </column>
            <column caption='Report Month &gt;= L12M Filter' datatype='boolean' name='[Calculation_3496552563108286464]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_month] &gt;= dateadd(&apos;month&apos;, -12,DATETRUNC(&apos;month&apos;, TODAY()))' />
            </column>
            <column caption='Avg VPS Including Zombies v1' datatype='real' name='[Calculation_5998724358667874304]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([vps_including_zombies_v1])' />
            </column>
            <column caption='# Total' datatype='integer' name='[Calculation_5998724359007277083]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF [is_online] THEN [Calculation_5998724359021813790] ELSE NULL END)' />
            </column>
            <column caption='Global Unique Vendor ID' datatype='string' name='[Calculation_5998724359021813790]' role='dimension' type='nominal'>
