            <column caption='# Total Online Vendors' datatype='integer' name='[Calculation_5998724359067451438]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF [is_online] THEN [Calculation_5998724359067594799] ELSE NULL END)' />
