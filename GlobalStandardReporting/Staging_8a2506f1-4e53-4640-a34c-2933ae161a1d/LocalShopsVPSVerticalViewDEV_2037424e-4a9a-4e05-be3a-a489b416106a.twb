          <datasource-dependencies datasource='federated.0w8tmow04292kn1cml9zu0rujndg'>
            <column caption=' ❷ P&amp;L' datatype='integer' name='[ ❶ KPIs (copy)_562387060583026786]' role='measure' type='quantitative'>
