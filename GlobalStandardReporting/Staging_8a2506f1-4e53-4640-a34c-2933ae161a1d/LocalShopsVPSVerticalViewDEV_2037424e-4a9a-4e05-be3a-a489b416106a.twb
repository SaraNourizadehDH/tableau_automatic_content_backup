            <column caption='Row L2' datatype='string' name='[Row L1 (copy)_562387060580110428]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Row Level 1 (copy)_562387060580065371]&#13;&#10;    WHEN &quot;No Breakdown&quot; THEN &quot;&quot;&#13;&#10;    WHEN &quot;Segment&quot; THEN [segment]&#13;&#10;    WHEN &quot;Management Entity&quot; THEN [management_entity]&#13;&#10;    WHEN &quot;Country Name&quot; THEN [country_name]&#13;&#10;    WHEN &quot;Vertical Parent&quot; THEN [vertical_parent]&#13;&#10;    WHEN &quot;Vertical Type&quot; THEN [vertical_type]&#13;&#10;    WHEN &quot;AAA Chain Name Cleaned&quot; THEN [aaa_chain_name_cleaned]&#13;&#10;    WHEN &quot;Is AAA&quot; THEN STR([is_aaa])&#13;&#10;    WHEN &quot;Is AAA Supermarket&quot; THEN STR([is_aaa_supermarket])&#13;&#10;    WHEN &quot;Is Own Delivery&quot; THEN STR([is_own_delivery])&#13;&#10;    WHEN &quot;Report Month&quot; THEN LEFT(STR(DATENAME(&apos;month&apos;, [report_month])),3) + &quot;&apos;&quot; + RIGHT(STR(DATEPART(&apos;year&apos;, [report_month])),2)&#13;&#10;    WHEN &quot;Report Quarter&quot; THEN &quot;Q&quot; + LEFT(STR(DATENAME(&apos;quarter&apos;, [report_month])),3) + &quot;&apos;&quot; + RIGHT(STR(DATEPART(&apos;year&apos;, [report_month])),2)&#13;&#10;END' />
            </column>
            <column caption='Vertical Segment' datatype='string' name='[Vertical (copy)_2188186524845916160]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE LOWER([vertical_type])&#10;      WHEN &apos;convenience&apos; THEN &apos;convenience&apos;&#10;      WHEN &apos;hypermarket&apos; THEN &apos;hypermarket&apos;&#10;      WHEN &apos;kiosks&apos; THEN &apos;kiosk&apos;&#10;      WHEN &apos;mini_market&apos; THEN &apos;mini_market&apos;&#10;      WHEN &apos;groceries&apos; THEN &apos;supermarket&apos;&#10;      WHEN &apos;supermarket&apos; THEN &apos;supermarket&apos;&#10;      WHEN &apos;alcoholic_drinks&apos; THEN &apos;alcoholic_drinks&apos;&#10;      WHEN &apos;bakery&apos; THEN &apos;bakery&apos;&#10;      WHEN &apos;delicatessen&apos; THEN &apos;bakery&apos;&#10;      WHEN &apos;butchery&apos; THEN &apos;butchery&apos;&#10;      WHEN &apos;dairy_products&apos; THEN &apos;dairy_products&apos;&#10;      WHEN &apos;drinks&apos; THEN &apos;drinks&apos;&#10;      WHEN &apos;fishery&apos; THEN &apos;fishery&apos;&#10;      WHEN &apos;frozen_food&apos; THEN &apos;frozen_food&apos;&#10;      WHEN &apos;fruits_and_vegetables&apos; THEN &apos;fruits_and_vegetables&apos;&#10;      WHEN &apos;gourmet&apos; THEN &apos;gourmet&apos;&#10;      WHEN &apos;nuts_and_dried_fruits&apos; THEN &apos;nuts_and_dried_fruits&apos;&#10;      WHEN &apos;pasta_shop&apos; THEN &apos;pasta_shop&apos;&#10;      WHEN &apos;snacks&apos; THEN &apos;snacks_and_sweets&apos;&#10;      WHEN &apos;snacks_and_sweets&apos; THEN &apos;snacks_and_sweets&apos;&#10;      WHEN &apos;specialty_and_ethnic&apos; THEN &apos;specialty_and_ethnic&apos;&#10;      WHEN &apos;coffee_grinders&apos; THEN &apos;specialty_coffee_and_tea&apos;&#10;      WHEN &apos;wet_market&apos; THEN &apos;wet_market&apos;&#10;      WHEN &apos;flowers&apos; THEN &apos;flowers_and_plants&apos;&#10;      WHEN &apos;flowers_and_plants&apos; THEN &apos;flowers_and_plants&apos;&#10;      WHEN &apos;charity&apos; THEN &apos;charity&apos;&#10;      WHEN &apos;electronics&apos; THEN &apos;electronics&apos;&#10;      WHEN &apos;fashion&apos; THEN &apos;fashion&apos;&#10;      WHEN &apos;games&apos; THEN &apos;games&apos;&#10;      WHEN &apos;toys&apos; THEN &apos;games&apos;&#10;      WHEN &apos;hardware&apos; THEN &apos;hardware&apos;&#10;      WHEN &apos;just_for_adults&apos; THEN &apos;just_for_adults&apos;&#10;      WHEN &apos;bags_and_luggage&apos; THEN &apos;luggage_and_travel_accessories&apos;&#10;      WHEN &apos;luggage_and_travel_accessories&apos; THEN &apos;luggage_and_travel_accessories&apos;&#10;      WHEN &apos;optics&apos; THEN &apos;optics&apos;&#10;      WHEN &apos;party_supplies&apos; THEN &apos;party_supplies&apos;&#10;      WHEN &apos;religious_supplies&apos; THEN &apos;religious_supplies&apos;&#10;      WHEN &apos;bills_and_services&apos; THEN &apos;services&apos;&#10;      WHEN &apos;services&apos; THEN &apos;services&apos;&#10;      WHEN &apos;sports_and_lifestyle&apos; THEN &apos;sports_and_lifestyle&apos;&#10;      WHEN &apos;stationery&apos; THEN &apos;stationery_and_books&apos;&#10;      WHEN &apos;stationery_and_books&apos; THEN &apos;stationery_and_books&apos;&#10;      WHEN &apos;tickets_and_experience&apos; THEN &apos;tickets_and_experience&apos;&#10;      WHEN &apos;tobacco&apos; THEN &apos;tobacco&apos;&#10;      WHEN &apos;automotive&apos; THEN &apos;vehicles&apos;&#10;      WHEN &apos;vehicles&apos; THEN &apos;vehicles&apos;&#10;      WHEN &apos;beauty&apos; THEN &apos;beauty&apos;&#10;      WHEN &apos;cosmetics&apos; THEN &apos;beauty&apos;&#10;      WHEN &apos;health_and_wellness&apos; THEN &apos;health_and_wellness&apos;&#10;      WHEN &apos;health_supplements&apos; THEN &apos;health_and_wellness&apos;&#10;      WHEN &apos;home_and_gifts&apos; THEN &apos;home_and_gifts&apos;&#10;      WHEN &apos;baby_supplies&apos; THEN &apos;mother_and_baby&apos;&#10;      WHEN &apos;mother_and_baby&apos; THEN &apos;mother_and_baby&apos;&#10;      WHEN &apos;pharmacies&apos; THEN &apos;pharmacy&apos;&#10;      WHEN &apos;pet_services&apos; THEN &apos;pet_services&apos;&#10;      W