              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3 1]&#13;&#10;    WHEN &quot;Actual&quot; THEN [act_commission_revenue]&#13;&#10;    WHEN &quot;Budget&quot; THEN [bud_commission_revenue]&#13;&#10;    WHEN &quot;Last Estimate&quot; THEN [le_commission_revenue]&#13;&#10;    WHEN &quot;Month Estimate&quot; THEN [me_commission_revenue]&#13;&#10;END' />
