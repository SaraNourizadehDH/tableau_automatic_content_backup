      <aliases enabled='yes' />
      <column caption='# Zombies' datatype='integer' name='[# Total Online Vendors (copy)_2157857566453596164]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( IF [is_zombie] AND [is_online] THEN [Calculation_5998724359067594799] ELSE NULL END)' />
      </column>
      <column caption='# Zombie' datatype='integer' name='[# Total Online Vendors (copy)_5998724359019638812]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( IF [is_zombie] AND [is_online]&#10;   THEN [Calculation_5998724359067594799] ELSE NULL END)' />
      </column>
      <column caption='Med VPS v1' datatype='real' name='[Avg VPS v1 (copy)_2157857566373658624]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_MEDIAN(AVG([vps_v1]),0,0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Min VPS v1' datatype='real' name='[Avg VPS v1 (copy)_2157857566374318081]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN([vps_v1])' />
      </column>
      <column caption='VPS Component' datatype='string' name='[Calculation_3573043383088689163]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[score_component]' />
      </column>
      <column caption='VPS Component Value' datatype='real' name='[Calculation_3573043383090786316]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [is_zombie] WHEN TRUE THEN NULL&#10;ELSE IFNULL([score_value],0) END' />
      </column>
      <column caption='# Total' datatype='integer' name='[Calculation_5998724359007277083]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( IF [is_online] THEN [Calculation_5998724359067594799] ELSE NULL END)' />
      </column>
      <column caption='Avg Score' datatype='real' name='[Calculation_5998724359061458988]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_3573043383090786316])' />
      </column>
      <column caption='Avg Metric' datatype='real' name='[Calculation_5998724359061860397]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([metric_value])' />
      </column>
      <column caption='# Total Online Vendors' datatype='integer' name='[Calculation_5998724359067451438]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( IF [is_online] THEN [Calculation_5998724359067594799] ELSE NULL END)' />
      </column>
      <column caption='Global Unique Vendor ID' datatype='string' name='[Calculation_5998724359067594799]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[global_entity_id]+[platform_vendor_id]' />
      </column>
      <column caption='GMV (Euro)' datatype='real' name='[Calculation_5998724359075381296]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([gmv_eur] / 6)' />
      </column>
      <column caption='GMV / Vendor' datatype='real' name='[Calculation_96475568808148995]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gmv_eur]) / [Calculation_5998724359067451438]' />
      </column>
      <column caption='% Zombie' datatype='real' name='[Calculation_96475568808910853]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[# Total Online Vendors (copy)_5998724359019638812] / [Calculation_5998724359007277083]' />
      </column>
      <column caption='unused Avg. Score Value (Adjusted)' datatype='real' name='[Calculation_96475569179430927]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_96475569201070096])' />
      </column>
      <column caption='unused Score Value (Adjusted)' datatype='real' name='[Calculation_96475569201070096]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_pelican] = TRUE AND [Calculation_3573043383088689163]=&apos;weighted_score_gmv_lost_oos_v1&apos; THEN 0&#10;ELSEIF [is_pelican] = FALSE AND [Calculation_3573043383088689163]=&apos;weighted_score_perc_items_not_delivered_v1&apos; THEN 0&#10;ELSE [score_value]&#10;END' />
      </column>
      <column caption='Dimension 1' datatype='string' name='[Calculation_96475569209118739]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;Management Entity&apos; THEN [management_entity]&#10;WHEN &apos;Country&apos; THEN [country_name]&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Avg VPS v1' datatype='real' name='[Calculation_96475569214062613]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([vps_v1])' />
      </column>
      <column caption='Dimension 1 (Deep-Dive By 2 Dimensions)' datatype='string' name='[Dimension 1 (copy)_3573043383012032518]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Dimension 1 (copy)_3573043383008927748]&#10;WHEN &apos;Management Entity&apos; THEN [management_entity]&#10;WHEN &apos;Country&apos; THEN [country_name]&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Dimension 2' datatype='string' name='[Dimension 1 (copy)_96475569211093012]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Drill Down By (1) (copy)_96475569208922130]&#10;WHEN &apos;Vertical&apos; THEN [vertical]&#10;WHEN &apos;Vertical Segment&apos; THEN [vertical_segment]&#10;WHEN &apos;Country&apos; THEN [country_name]&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Dimension 2 (Deep-Dive By 2 Dimensions)' datatype='string' name='[Dimension 2 (copy)_3573043383013277703]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Dimension 2 (Deep-Dive By 2 Dimensions) (copy)_3573043383010799621]&#10;WHEN &apos;Vertical&apos; THEN [vertical]&#10;WHEN &apos;Vertical Segment&apos; THEN [vertical_segment]&#10;WHEN &apos;Country&apos; THEN [country_name]&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='VPS Components / KPIs' datatype='real' name='[KPIs (copy)_2157857566459785222]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Select VPS Component (copy)_2157857566459015173]&#10;WHEN  &apos;% 0-order Vendor Share&apos; THEN [Calculation_96475568808910853]&#10;WHEN  &apos;GMV&apos; THEN SUM([gmv_eur])&#10;WHEN &apos;Orders&apos; THEN SUM(succ)&#10;WHEN &apos;GMV / Vendor&apos; THEN [Calculation_96475568808148995]&#10;WHEN &apos;Take-in per order&apos; THEN AVG([take_in_per_order_eur])&#10;WHEN  &apos;mCVR3&apos; THEN AVG([mcvr3])&#10;WHEN  &apos;M1 Retention&apos; THEN AVG([m1_retention])&#10;WHEN &apos;Vendor Fail Rate&apos; THEN AVG([fail_rate_vendor])&#10;WHEN &apos;% Items Not Delivered&apos; THEN AVG([perc_items_not_delivered])&#10;WHEN &apos;% OOS GMV Loss&apos; THEN AVG([gmv_lost_oos_percent])&#10;WHEN &apos;Online Rate&apos; THEN AVG([vendor_online_rate])&#10;ELSE NULL&#10;END' />
      </column>
