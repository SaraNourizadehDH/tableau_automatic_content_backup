    <worksheet name='Verticals Marketplace Report Month'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='ls_vps_stg_monthly (cl_dmart)' name='federated.0lv5k2c1n0iz5v13tz9zl0k21co1' />
          </datasources>
          <datasource-dependencies datasource='federated.0lv5k2c1n0iz5v13tz9zl0k21co1'>
            <column caption='# Zombie' datatype='integer' name='[# Total Online Vendors (copy)_5998724359019638812]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF [is_zombie] AND [is_online]&#10;   THEN [Calculation_5998724359021813790] ELSE NULL END)' />
            </column>
            <column caption='# New' datatype='integer' name='[# Zombie (copy)_5998724359019905053]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF [is_vendor_new_m0] AND [is_online]&#10; THEN [Calculation_5998724359021813790] ELSE NULL END)' />
            </column>
            <column caption='Average VPS v1' datatype='real' name='[Calculation_1230116035724840965]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='ROUND(AVG([vps_v1]),1)' />
            </column>
            <column caption='Marketplace' datatype='integer' datatype-customized='true' name='[Calculation_498070026568073216]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(&quot;&quot;)' />
            </column>
            <column aggregation='CountD' caption='Customer' datatype='integer' datatype-customized='true' name='[Calculation_498070026568929282]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='INT(&quot;&quot;)' />
            </column>
            <column caption='Avg Vendor Fail Rate' datatype='real' name='[Calculation_5998724358971834382]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([fail_rate_vendor])' />
            </column>
            <column caption='# Total' datatype='integer' name='[Calculation_5998724359007277083]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF [is_online] THEN [Calculation_5998724359021813790] ELSE NULL END)' />
            </column>
            <column caption='Global Unique Vendor ID' datatype='string' name='[Calculation_5998724359021813790]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[global_entity_id]+[platform_vendor_id]' />
            </column>
            <column caption='# Delisted' datatype='integer' name='[Calculation_5998724359022534687]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF( LOOKUP([Calculation_5998724359007277083], -1) - [Calculation_5998724359007277083] + [# Zombie (copy)_5998724359019905053]) &lt; 0 THEN 0&#10;ELSE (LOOKUP([Calculation_5998724359007277083], -1) - [Calculation_5998724359007277083] + [# Zombie (copy)_5998724359019905053])  &#10;END'>
                <table-calc level-address='[federated.0lv5k2c1n0iz5v13tz9zl0k21co1].[none:report_month:ok]' ordering-field='[federated.0lv5k2c1n0iz5v13tz9zl0k21co1].[report_month]' ordering-type='Field' />
              </calculation>
            </column>
            <column caption='# Online Vendors' datatype='integer' name='[Calculation_5998724359067451438]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF [is_online] THEN [Calculation_5998724359021813790] ELSE NULL END)' />
            </column>
            <column caption='% Zombie' datatype='real' name='[Calculation_96475568808910853]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[# Total Online Vendors (copy)_5998724359019638812] / [Calculation_5998724359007277083]' />
