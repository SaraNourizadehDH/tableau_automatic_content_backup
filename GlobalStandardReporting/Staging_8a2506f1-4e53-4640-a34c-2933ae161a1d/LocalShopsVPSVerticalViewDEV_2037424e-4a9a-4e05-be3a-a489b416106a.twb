              <calculation class='tableau' formula='INT(&quot;&quot;)' />
            </column>
            <column caption=' ❹ Ratios (as % of GMV)' datatype='integer' name='[ ❸ Unit Economics (copy)_562387060583903333]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(&quot;&quot;)' />
            </column>
            <column caption='_Space_1' datatype='integer' name='[Calculation_562387060169220114]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(&quot;&quot;)' />
            </column>
            <column caption='Column L1' datatype='string' name='[Calculation_562387060244058184]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1 1]&#13;&#10;    WHEN &quot;No Breakdown&quot; THEN &quot;&quot;&#13;&#10;    WHEN &quot;Segment&quot; THEN [segment]&#13;&#10;    WHEN &quot;Management Entity&quot; THEN [management_entity]&#13;&#10;    WHEN &quot;Country Name&quot; THEN [country_name]&#10;    WHEN &quot;Vertical&quot; THEN [Vertical Type (copy)_1640576957397835778]&#10;    WHEN &quot;Vertical Segment&quot; THEN [Vertical (copy)_2188186524845916160]&#13;&#10;    WHEN &quot;Vertical Parent&quot; THEN [vertical_parent]&#13;&#10;    WHEN &quot;Vertical Type&quot; THEN [vertical_type]&#13;&#10;    WHEN &quot;AAA Chain Name Cleaned&quot; THEN [aaa_chain_name_cleaned]&#13;&#10;    WHEN &quot;Is AAA&quot; THEN STR([is_aaa])&#13;&#10;    WHEN &quot;Is AAA Supermarket&quot; THEN STR([is_aaa_supermarket])&#13;&#10;    WHEN &quot;Is Own Delivery&quot; THEN STR([is_own_delivery])&#13;&#10;    WHEN &quot;Report Month&quot; THEN LEFT(STR(DATENAME(&apos;month&apos;, [report_month])),3) + &quot;&apos;&quot; + RIGHT(STR(DATEPART(&apos;year&apos;, [report_month])),2)&#13;&#10;    WHEN &quot;Report Quarter&quot; THEN &quot;Q&quot; + LEFT(STR(DATENAME(&apos;quarter&apos;, [report_month])),3) + &quot;&apos;&quot; + RIGHT(STR(DATEPART(&apos;year&apos;, [report_month])),2)&#13;&#10;END' />
            </column>
            <column caption='User filter' datatype='boolean' name='[Calculation_804736960008593408]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[username]=USERNAME()' />
            </column>
            <column caption='DT1 1.02. KPIs - GMV' datatype='real' default-format='n#,##0;-#,##0' name='[DT1  1.01. KPIs - Orders (copy)_1537416390879768596]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3 1]&#13;&#10;    WHEN &quot;Actual&quot; THEN [act_gmv]&#13;&#10;    WHEN &quot;Budget&quot; THEN [bud_gmv]&#13;&#10;    WHEN &quot;Last Estimate&quot; THEN [le_gmv]&#13;&#10;    WHEN &quot;Month Estimate&quot; THEN [me_gmv]&#13;&#10;END' />
            </column>
            <column caption='DT1 1.03. KPIs - GPV' datatype='real' default-format='n#,##0;-#,##0' name='[DT1  1.02. KPIs - GMV (copy)_1537416390879969301]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3 1]&#13;&#10;    WHEN &quot;Actual&quot; THEN [act_gpv]&#13;&#10;    WHEN &quot;Budget&quot; THEN [bud_gpv]&#13;&#10;    WHEN &quot;Last Estimate&quot; THEN [le_gpv]&#13;&#10;    WHEN &quot;Month Estimate&quot; THEN [me_gpv]&#13;&#10;END' />
            </column>
            <column caption='DT1 2.00.01. Take In' datatype='real' default-format='n#,##0;-#,##0' name='[DT1  1.03. KPIs - GPV (copy)_1537416390886076438]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3 1]&#13;&#10;    WHEN &quot;Actual&quot; THEN [act_take_in]&#13;&#10;    WHEN &quot;Budget&quot; THEN [bud_take_in]&#13;&#10;    WHEN &quot;Last Estimate&quot; THEN [le_take_in]&#13;&#10;    WHEN &quot;Month Estimate&quot; THEN [me_take_in]&#13;&#10;END' />
            </column>
            <column caption='DT1 2.00.02. Gross Profit' datatype='real' default-format='n#,##0;-#,##0' name='[DT1  2.00.01. Take In (copy)_1537416390886416407]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3 1]&#13;&#10;    WHEN &quot;Actual&quot; THEN [act_gross_profit]&#13;&#10;    WHEN &quot;Budget&quot; THEN [bud_gross_profit]&#13;&#10;    WHEN &quot;Last Estimate&quot; THEN [le_gross_profit]&#13;&#10;    WHEN &quot;Month Estimate&quot; THEN [me_gross_profit]&#13;&#10;END' />
            </column>
            <column caption='DT1 3.00.01. Take In, per Order' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[DT1  2.00.01. Take In (copy)_1537416390891597877]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([DT1  1.03. KPIs - GPV (copy)_1537416390886076438])&#13;&#10;/&#13;&#10;SUM([Me 1.01. KPIs - Orders (copy)_1537416390879293452])' />
            </column>
            <column caption='DT1 2.00.03. Gross Profit incl. NCR' datatype='real' default-format='n#,##0;-#,##0' name='[DT1  2.00.02. Gross Profit (copy)_1537416390886588440]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3 1]&#13;&#10;    WHEN &quot;Actual&quot; THEN [act_gross_profit_incl_ncr]&#13;&#10;    WHEN &quot;Budget&quot; THEN [bud_gross_profit_incl_ncr]&#13;&#10;    WHEN &quot;Last Estimate&quot; THEN [le_gross_profit_incl_ncr]&#13;&#10;    WHEN &quot;Month Estimate&quot; THEN [me_gross_profit_incl_ncr]&#13;&#10;END' />
            </column>
            <column caption='DT1 3.00.02. Gross Profit, per Order' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[DT1  2.00.02. Gross Profit (copy)_1537416390891597878]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([DT1  2.00.01. Take In (copy)_1537416390886416407])&#13;&#10;/&#13;&#10;SUM([Me 1.01. KPIs - Orders (copy)_1537416390879293452])' />
