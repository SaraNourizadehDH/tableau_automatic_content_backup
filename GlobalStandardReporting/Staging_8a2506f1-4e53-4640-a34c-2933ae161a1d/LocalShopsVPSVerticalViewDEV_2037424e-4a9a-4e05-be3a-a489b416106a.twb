      </column>
      <column caption='Column L1' datatype='string' name='[Calculation_2188186524935585795]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1 1]&#10;    WHEN &quot;No Breakdown&quot; THEN &quot;&quot;&#10;    WHEN &quot;Segment&quot; THEN [region]&#10;    WHEN &quot;Management Entity&quot; THEN [Calculation_5502132165345308674]&#10;    WHEN &quot;Country Name&quot; THEN [country_name]&#10;    WHEN &quot;Vertical&quot; THEN [vertical]&#10;    WHEN &quot;Vertical Segment&quot; THEN [vertical_segment]&#10;    //WHEN &quot;Vertical Parent&quot; THEN &#10;    //WHEN &quot;Vertical Type&quot; THEN &#10;    //WHEN &quot;AAA Chain Name Cleaned&quot; THEN &#10;    WHEN &quot;Is AAA&quot; THEN STR([is_aaa])&#10;    //WHEN &quot;Is AAA Supermarket&quot; THEN STR([Is AAA Supermarket])&#10;    //WHEN &quot;Is Own Delivery&quot; THEN STR([Is Own Delivery])&#10;    WHEN &quot;Report Month&quot; THEN [Calculation_2188186524933500930]&#10;    WHEN &quot;Report Quarter&quot; THEN &quot;Q&quot; + LEFT(STR(DATENAME(&apos;quarter&apos;, [report_month])),3) + &quot;&apos;&quot; + RIGHT(STR(DATEPART(&apos;year&apos;, [report_month])),2)&#10;END' />
