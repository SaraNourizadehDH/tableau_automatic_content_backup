    <worksheet name='Evolution profit'>
      <repository-location derived-from='http://ip-172-31-0-197:8196/t/GlobalStandardReporting/workbooks/Targets2025/Evolutionprofit?rev=' id='Evolutionprofit' path='/t/GlobalStandardReporting/workbooks/Targets2025' revision='' site='GlobalStandardReporting' />
      <table>
        <view>
          <datasources>
            <datasource caption='onestream_target (growth_pricing)' name='federated.1qqk6b70jp0io81g4d9ot00dafkk' />
          </datasources>
          <datasource-dependencies datasource='federated.1qqk6b70jp0io81g4d9ot00dafkk'>
            <column caption='% Take Rate' datatype='real' default-format='p0.0%' name='[Calculation_1816921030556618752]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([analytical_profit])/SUM([gmv])' />
            </column>
            <column caption='Analytical Profit per Order' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1816921030564904961]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([analytical_profit])/SUM([orders])' />
