              <calculation class='tableau' formula='&quot;Brand&quot;' />
            </column>
            <column caption='Sub-Detail' datatype='string' name='[Detail (copy)_7035115241187565678]' param-domain-type='list' role='measure' type='nominal' value='&quot;Total&quot;'>
