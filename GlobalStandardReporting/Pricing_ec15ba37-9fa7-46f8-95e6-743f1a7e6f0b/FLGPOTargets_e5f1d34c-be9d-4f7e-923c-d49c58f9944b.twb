        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1rq6eu41uorxd61e94kjl1vm8f2u' name='Custom SQL Query1' type='text'>WITH
months AS (
  SELECT
    DATE_TRUNC(DATE_ADD(&apos;2023-01-01&apos;, INTERVAL n MONTH), MONTH) AS reporting_month
  FROM
    UNNEST(GENERATE_ARRAY(0, 80)) AS n
)
SELECT
  reporting_month,
  EXTRACT(DAY FROM LAST_DAY(reporting_month, MONTH)) AS days_in_month
FROM
  months
ORDER BY
  reporting_month</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
