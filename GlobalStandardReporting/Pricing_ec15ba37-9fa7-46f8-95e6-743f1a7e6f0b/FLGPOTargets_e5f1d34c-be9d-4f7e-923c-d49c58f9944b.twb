            <column caption='Detail' datatype='string' name='[Agg (copy)_7035115241187721327]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Aggregation (copy)_7035115241187369069]&#10;WHEN &apos;Total&apos; THEN &apos;&apos;&#10;WHEN &apos;Month&apos; THEN STR([reporting_month])&#10;WHEN &apos;Brand&apos; THEN [brand_name]&#10;WHEN &apos;Entity&apos; THEN [global_entity_id]&#10;WHEN &apos;Channel&apos; THEN [channel]&#10;WHEN &apos;Vertical&apos; THEN [vertical]&#10;WHEN &apos;Scenario&apos; THEN [scenario]&#10;END' />
            </column>
            <column caption='Agg' datatype='real' name='[Calculation_7035115241180098638]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Vendor Funded Delivery Fee Subsidy Net Parameter]&#10;WHEN &apos;Total&apos; THEN 1&#10;WHEN &apos;Per Order&apos; THEN SUM([orders])&#10;WHEN &apos;Per Subscribed Order&apos; THEN SUM([orders_from_subscribed_customers])&#10;WHEN &apos;% GMV&apos; THEN SUM([gmv]) / 100&#10;WHEN &apos;% Revenue&apos; THEN SUM([revenue_net]) / 100&#10;WHEN &apos;Per Day&apos; THEN SUM([days_in_month])&#10;END' />
            </column>
            <column caption='Agg Commission Fee Net' datatype='real' name='[Calculation_7035115241182855254]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([commission_fee_net])/[Calculation_7035115241180098638]' />
            </column>
