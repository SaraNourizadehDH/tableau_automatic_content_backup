          <datasource-dependencies datasource='federated.1qqk6b70jp0io81g4d9ot00dafkk'>
            <column caption='Detail' datatype='string' name='[Agg (copy)_7035115241187721327]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Aggregation (copy)_7035115241187369069]&#10;WHEN &apos;Total&apos; THEN &apos;&apos;&#10;WHEN &apos;Month&apos; THEN STR([reporting_month])&#10;WHEN &apos;Brand&apos; THEN [brand_name]&#10;WHEN &apos;Entity&apos; THEN [global_entity_id]&#10;WHEN &apos;Channel&apos; THEN [channel]&#10;WHEN &apos;Vertical&apos; THEN [vertical]&#10;WHEN &apos;Scenario&apos; THEN [scenario]&#10;END' />
            </column>
            <column caption='Agg' datatype='real' name='[Calculation_7035115241180098638]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Vendor Funded Delivery Fee Subsidy Net Parameter]&#10;WHEN &apos;Total&apos; THEN 1&#10;WHEN &apos;Per Order&apos; THEN SUM([orders])&#10;WHEN &apos;Per Subscribed Order&apos; THEN SUM([orders_from_subscribed_customers])&#10;WHEN &apos;% GMV&apos; THEN SUM([gmv]) / 100&#10;WHEN &apos;% Revenue&apos; THEN SUM([revenue_net]) / 100&#10;WHEN &apos;Per Day&apos; THEN SUM([days_in_month])&#10;END' />
            </column>
            <column caption='Agg Analytical Profit' datatype='real' name='[Calculation_7035115241180581967]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([analytical_profit])/[Calculation_7035115241180098638]' />
            </column>
            <column caption='Agg DH Funded Basket Incentives' datatype='real' name='[Calculation_7035115241180655696]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dh_funded_basket_incentives])/[Calculation_7035115241180098638]' />
            </column>
            <column caption='Agg Cost Of Sales' datatype='real' name='[Calculation_7035115241180676177]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cost_of_sales])/[Calculation_7035115241180098638]' />
            </column>
            <column caption='Agg Revenue Net' datatype='real' name='[Calculation_7035115241180692562]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([revenue_net])/[Calculation_7035115241180098638]' />
            </column>
            <column caption='Sub-Detail' datatype='string' name='[Detail (copy)_7035115241188012144]' role='dimension' type='nominal'>
