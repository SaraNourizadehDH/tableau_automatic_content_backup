      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='onestream_target (growth_pricing)' name='federated.1qqk6b70jp0io81g4d9ot00dafkk' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Detail' datatype='string' name='[Aggregation (copy)_7035115241187369069]' param-domain-type='list' role='measure' type='nominal' value='&quot;Brand&quot;'>
              <calculation class='tableau' formula='&quot;Brand&quot;' />
            </column>
            <column caption='Sub-Detail' datatype='string' name='[Detail (copy)_7035115241187565678]' param-domain-type='list' role='measure' type='nominal' value='&quot;Total&quot;'>
              <calculation class='tableau' formula='&quot;Total&quot;' />
            </column>
            <column caption='Row' datatype='string' name='[Sub-Detail (copy)_7035115241189662833]' param-domain-type='list' role='measure' type='nominal' value='&quot;Total&quot;'>
              <calculation class='tableau' formula='&quot;Total&quot;' />
            </column>
            <column caption='Aggregation' datatype='string' name='[Vendor Funded Delivery Fee Subsidy Net Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% Revenue&quot;'>
              <calculation class='tableau' formula='&quot;% Revenue&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1qqk6b70jp0io81g4d9ot00dafkk'>
            <column caption='Detail' datatype='string' name='[Agg (copy)_7035115241187721327]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Aggregation (copy)_7035115241187369069]&#10;WHEN &apos;Total&apos; THEN &apos;&apos;&#10;WHEN &apos;Month&apos; THEN STR([reporting_month])&#10;WHEN &apos;Brand&apos; THEN [brand_name]&#10;WHEN &apos;Entity&apos; THEN [global_entity_id]&#10;WHEN &apos;Channel&apos; THEN [channel]&#10;WHEN &apos;Vertical&apos; THEN [vertical]&#10;WHEN &apos;Scenario&apos; THEN [scenario]&#10;END' />
            </column>
            <column caption='Agg' datatype='real' name='[Calculation_7035115241180098638]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Vendor Funded Delivery Fee Subsidy Net Parameter]&#10;WHEN &apos;Total&apos; THEN 1&#10;WHEN &apos;Per Order&apos; THEN SUM([orders])&#10;WHEN &apos;Per Subscribed Order&apos; THEN SUM([orders_from_subscribed_customers])&#10;WHEN &apos;% GMV&apos; THEN SUM([gmv]) / 100&#10;WHEN &apos;% Revenue&apos; THEN SUM([revenue_net]) / 100&#10;WHEN &apos;Per Day&apos; THEN SUM([days_in_month])&#10;END' />
            </column>
            <column caption='Agg Delivery Costs' datatype='real' name='[Calculation_7035115241183121509]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_costs])/[Calculation_7035115241180098638]' />
            </column>
            <column caption='Agg Cost Of Goods Sold' datatype='real' name='[Calculation_7035115241183133798]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cost_of_goods_sold])/[Calculation_7035115241180098638]' />
            </column>
            <column caption='Agg Payment Costs' datatype='real' name='[Calculation_7035115241183150183]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([payment_costs])/[Calculation_7035115241180098638]' />
            </column>
            <column caption='Agg Recooks And Wastage' datatype='real' name='[Calculation_7035115241183166568]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([recooks_and_wastage])/[Calculation_7035115241180098638]' />
            </column>
            <column caption='Agg Refunds And Compensation' datatype='real' name='[Calculation_7035115241183187049]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([refunds_and_compensation])/[Calculation_7035115241180098638]' />
