      <column caption='Detail' datatype='string' name='[Agg (copy)_7035115241187721327]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Aggregation (copy)_7035115241187369069]&#10;WHEN &apos;Total&apos; THEN &apos;&apos;&#10;WHEN &apos;Month&apos; THEN STR([reporting_month])&#10;WHEN &apos;Brand&apos; THEN [brand_name]&#10;WHEN &apos;Entity&apos; THEN [global_entity_id]&#10;WHEN &apos;Channel&apos; THEN [channel]&#10;WHEN &apos;Vertical&apos; THEN [vertical]&#10;WHEN &apos;Scenario&apos; THEN [scenario]&#10;END' />
      </column>
      <column caption='% Take Rate' datatype='real' default-format='p0.0%' name='[Calculation_1816921030556618752]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([analytical_profit])/SUM([gmv])' />
      </column>
      <column caption='Analytical Profit per Order' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1816921030564904961]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([analytical_profit])/SUM([orders])' />
      </column>
      <column caption='Delivery Costs per Order' datatype='real' name='[Calculation_1816921030576406531]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([delivery_costs])/SUM([orders])' />
      </column>
      <column caption='Daily Orders' datatype='real' name='[Calculation_2008816582075506714]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders])/SUM([days_in_month])' />
      </column>
      <column caption='Is Target' datatype='boolean' name='[Calculation_2825305114884743301]' role='dimension' type='nominal'>
