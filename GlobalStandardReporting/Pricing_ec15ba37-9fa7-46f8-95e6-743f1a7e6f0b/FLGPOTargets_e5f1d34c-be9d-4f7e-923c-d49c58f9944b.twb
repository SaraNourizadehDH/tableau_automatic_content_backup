      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query1' id='_0BCE7FB8C58D4AC386A881B110E767EE'>
            <properties context=''>
              <relation connection='bigquery.1rq6eu41uorxd61e94kjl1vm8f2u' name='Custom SQL Query1' type='text'>WITH
months AS (
  SELECT
    DATE_TRUNC(DATE_ADD(&apos;2023-01-01&apos;, INTERVAL n MONTH), MONTH) AS reporting_month
  FROM
    UNNEST(GENERATE_ARRAY(0, 80)) AS n
)
SELECT
  reporting_month,
  EXTRACT(DAY FROM LAST_DAY(reporting_month, MONTH)) AS days_in_month
FROM
  months
ORDER BY
  reporting_month</relation>
            </properties>
          </object>
          <object caption='Custom SQL Query' id='_FC07B542B72E479394202771E3C35FDE'>
            <properties context=''>
              <relation connection='bigquery.1rq6eu41uorxd61e94kjl1vm8f2u' name='Custom SQL Query' type='text'>SELECT * FROM `fulfillment-dwh-production.curated_data_shared_coredata.global_entities`</relation>
            </properties>
          </object>
