            </column>
            <column caption='Agg Card Fee Net' datatype='real' name='[Calculation_7035115241182888024]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([card_fee_net])/[Calculation_7035115241180098638]' />
            </column>
            <column caption='Agg Delivery Fee Net' datatype='real' name='[Calculation_7035115241182904409]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_fee_net])/[Calculation_7035115241180098638]' />
