  <worksheets>
    <worksheet name='(Inflation monitoring)'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Inflation monitoring </run>
            <run fontsize='10'><![CDATA[[<[Clipboard_20220324T151630].[none:global_entity_id:nk]> | <[Clipboard_20220324T151630].[tmn:month:qk]> | Vertical: <[Clipboard_20220324T151630].[none:vertical_parent:nk]> | Sub-vertical: <[Clipboard_20220324T151630].[none:vertical_type:nk]>]]]></run>
            <run>Æ&#10;</run>
            <run fontsize='10'>Æ </run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run>Figures deflated using the Consumer Price Index, All items (IMF). When the first data point in the series is zero the index cannot be calculated, please adjust the time window. Last updated on </run>
            <run fontsize='8'>&lt;Data Update Time&gt;</run>
            <run>.
Venezuela inflation data is not relevant as prices are charged in USD. Taiwan CPI data comes from the Taiwanese Statistical Bureau. The last CPI data point available may be several months old.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <repository-location id='Inflationmonitoring' path='/t/GlobalStandardReporting/workbooks/PricingInflationMonitoring' revision='' site='GlobalStandardReporting' />
      <table>
        <view>
          <datasources>
            <datasource caption='IMF + cDWH data (filtered)' name='Clipboard_20220324T151630' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Clipboard_20220324T151630'>
            <column caption='Deflated DF (index)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[ADF (index) (copy)_278097293238411276]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Index (copy)_278097293237899275]/[Calculation_278097293231017985]&#13;&#10;/ LOOKUP([Index (copy)_278097293237899275]/[Calculation_278097293231017985], FIRST())&#13;&#10;* 100'>
                <table-calc ordering-field='[Clipboard_20220324T151630].[month]' ordering-type='Field' />
              </calculation>
