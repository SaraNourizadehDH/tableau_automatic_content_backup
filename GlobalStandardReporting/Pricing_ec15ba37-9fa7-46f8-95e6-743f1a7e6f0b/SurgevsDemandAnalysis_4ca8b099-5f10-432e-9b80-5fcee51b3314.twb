            <column caption='minutes buckets' datatype='integer' default-format='*# \m\i\n' name='[country_code Parameter]' param-domain-type='any' role='measure' type='quantitative' value='15'>
              <calculation class='tableau' formula='15' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.13msmxh0ab6xcl10848zu1718maw'>
            <column caption='Bucketed Local Time' datatype='datetime' name='[Calculation_3055129402128461840]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETIME(INT(FLOAT([local_created_at_bucket]) * (24 * 60 / [Parameters].[country_code Parameter])) / (24 * 60 / [Parameters].[country_code Parameter]))' />
