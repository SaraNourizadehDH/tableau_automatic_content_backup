      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Surge Components' id='_91476FD8AF7B42C0B8B9A1AD222EF5F8'>
            <properties context=''>
              <relation connection='bigquery.1ufi2us0ysxjs81ddflct0cqczxr' name='Custom SQL Query' type='text'><![CDATA[WITH
timestamps AS (
  SELECT
    created_at_bucket
  FROM UNNEST(GENERATE_TIMESTAMP_ARRAY(
    TIMESTAMP_TRUNC(TIMESTAMP(<[Parameters].[Parameter 1]>), MINUTE) - INTERVAL 1 DAY,
    TIMESTAMP_TRUNC(TIMESTAMP(<[Parameters].[Parameter 1]> + INTERVAL <[Parameters].[Parameter 5]> DAY), MINUTE) + INTERVAL 2 DAY - INTERVAL 1 MINUTE,
    INTERVAL 1 MINUTE)) created_at_bucket
)
, orders AS (
  select
    platform_order_code,
    dps_mean_delay,
    dps_travel_time_fee_eur,
    dps_surge_fee_eur,
    country_code,
    IFNULL(dps_mean_delay_zone_id, zone_id) AS zone_id,
    order_placed_at,
    IFNULL(IFNULL(dps_session_timestamp, dps_session_id_created_at - INTERVAL 8 MINUTE), order_placed_at - INTERVAL 8 MINUTE) AS dps_session_started_at,
    TIMESTAMP(order_report_time, timezone) AS order_delivered_at, -- stored local time as datetime but on GMT, this transforms it back to timestamp UTC
    timezone,
  from `fulfillment-dwh-production.curated_data_shared.dps_sessions_mapped_to_orders`
  where
    created_date between <[Parameters].[Parameter 1]> - INTERVAL 1 DAY and <[Parameters].[Parameter 1]> + INTERVAL <[Parameters].[Parameter 5]> DAY + INTERVAL 1 DAY
    -- and created_date_local between <[Parameters].[Parameter 1]> and <[Parameters].[Parameter 1]> + INTERVAL <[Parameters].[Parameter 5]> DAY
    AND country_code = <[Parameters].[Parameter 3]>
    AND IFNULL(dps_mean_delay_zone_id, zone_id) = <[Parameters].[Parameter 4]>
    AND is_own_delivery
    AND is_sent
    -- AND zone_id = dps_mean_delay_zone_id
  ORDER BY 1
)
SELECT
  t.created_at_bucket,
  o.country_code,
  o.zone_id,
  `stats`[SAFE_OFFSET(0)].created_at,
  `stats`[SAFE_OFFSET(0)].mean_delay,
  `stats`[SAFE_OFFSET(0)].estimated_courier_delay,
  `stats`[SAFE_OFFSET(0)].accepteds_count,
  `stats`[SAFE_OFFSET(0)].dispatcheds_count,
  `stats`[SAFE_OFFSET(0)].queueds_count,
  `stats`[SAFE_OFFSET(0)].drop_off_count,
  `stats`[SAFE_OFFSET(0)].couriers_count,
  `stats`[SAFE_OFFSET(0)].couriers_starting_count,
  `stats`[SAFE_OFFSET(0)].couriers_ending_count,
  datetime(t.created_at_bucket, timezone) local_created_at_bucket,
  SUM(IF(DATE_TRUNC(o.order_placed_at, minute) <<= t.created_at_bucket AND DATE_TRUNC(o.order_delivered_at, minute) >>= t.created_at_bucket, 1, 0)) AS active_orders,
  SUM(IF(DATE_TRUNC(o.order_placed_at, minute) = t.created_at_bucket, 1, 0)) AS placed_orders,
  SUM(IF(DATE_TRUNC(o.order_delivered_at, minute) = t.created_at_bucket, 1, 0)) AS delivered_orders,
  MIN(IF(DATE_TRUNC(o.dps_session_started_at, minute) = t.created_at_bucket, dps_mean_delay, NULL)) AS min_dps_mean_delay,
  AVG(IF(DATE_TRUNC(o.dps_session_started_at, minute) = t.created_at_bucket, dps_mean_delay, NULL)) AS avg_dps_mean_delay,
  MAX(IF(DATE_TRUNC(o.dps_session_started_at, minute) = t.created_at_bucket, dps_mean_delay, NULL)) AS max_dps_mean_delay,
  SUM(IF(DATE_TRUNC(o.dps_session_started_at, minute) = t.created_at_bucket, dps_surge_fee_eur, NULL)) AS sum_dps_surge_fee_eur,
  SUM(IF(DATE_TRUNC(o.dps_session_started_at, minute) = t.created_at_bucket, dps_travel_time_fee_eur, NULL)) AS sum_dps_travel_time_fee_eur,
FROM timestamps t
CROSS JOIN orders o
LEFT JOIN `fulfillment-dwh-production.curated_data_shared.zone_stats` z
  ON t.created_at_bucket = z.created_at_bucket
    AND o.country_code = z.country_code
    AND o.zone_id = z.zone_id
WHERE DATETIME(t.created_at_bucket, timezone) between <[Parameters].[Parameter 1]> + INTERVAL 6 HOUR and <[Parameters].[Parameter 1]> + INTERVAL <[Parameters].[Parameter 5]> DAY + INTERVAL + 1 DAY - INTERVAL - 1 MINUTE + INTERVAL 3 HOUR
GROUP BY ALL
ORDER BY 1]]></relation>
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
  <actions>
    <action caption='Highlight1' name='[Action2_E1F6B75E7ADA4A569A7D598899B91D4E]'>
