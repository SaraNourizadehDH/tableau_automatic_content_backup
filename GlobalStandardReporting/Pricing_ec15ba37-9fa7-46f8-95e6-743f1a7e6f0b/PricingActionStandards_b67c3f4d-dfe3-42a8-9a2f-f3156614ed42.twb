          <relation connection='bigquery.09ficgh1erbmhx1fs0vjj0zk17ut' name='Custom SQL Query' type='text'>SELECT&#13;
  o.entity_id,&#13;
  o.test_id,&#13;
  sum(o.gmv_eur) / sum(o.gmv_local) fx,&#13;
FROM `fulfillment-dwh-production.curated_data_shared.dps_test_orders` o&#13;
WHERE true&#13;
  AND o.created_date_local &gt;&gt;= &quot;2023-08-01&quot;&#13;
GROUP BY ALL&#13;
ORDER BY 2,1</relation>
