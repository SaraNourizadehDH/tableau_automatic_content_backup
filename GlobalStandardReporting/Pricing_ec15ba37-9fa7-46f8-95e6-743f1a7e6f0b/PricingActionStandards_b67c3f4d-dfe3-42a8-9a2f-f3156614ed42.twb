            </column>
            <column caption='Recoup ROI under Cap' datatype='string' name='[Calculation_1370783192836448269]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1870401270524358662] = &apos;PPOL - Profit per Order Lost&apos;&#13;&#10;THEN &#13;&#10;&#13;&#10;IF [ROI (copy)_1870401270585368622] &lt; AVG([recoup_roi_cap]) THEN &apos;Y ✅&apos;&#13;&#10;ELSEIF [ROI (copy)_1870401270585368622] &gt;= AVG([recoup_roi_cap]) THEN &apos;N ❌&apos;&#13;&#10;END&#13;&#10;&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
              <aliases>
                <alias key='%null%' value=' ' />
              </aliases>
            </column>
            <column caption='Test End Date or Last Update' datatype='datetime' name='[Calculation_1370783192882102290]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEADD(&apos;day&apos;,[test_length],[test_start_date])' />
            </column>
            <column caption='Result' datatype='string' name='[Calculation_1370783192961134613]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF NOT ATTR([Calculation_6135098985835495444]) THEN NULL&#13;&#10;ELSEIF [Calculation_1870401270522822658] &gt;= [Calculation_1870401270522667009] AND [Profit Variation (copy)_1870401270530695187] &gt;= [Profit Control (copy)_1870401270530695186] THEN &apos;Win-Win 🎰&apos;&#13;&#10;ELSEIF [Calculation_1870401270522822658] &lt;= [Calculation_1870401270522667009] AND [Profit Variation (copy)_1870401270530695187] &lt;= [Profit Control (copy)_1870401270530695186] THEN &apos;Lose-Lose ⛔&apos;&#13;&#10;ELSEIF [Calculation_1870401270522822658] &gt; [Calculation_1870401270522667009] AND [Profit Variation (copy)_1870401270530695187] &lt; [Profit Control (copy)_1870401270530695186] THEN &apos;CPiO 🚀&apos;&#13;&#10;ELSEIF [Calculation_1870401270522822658] &lt; [Calculation_1870401270522667009] AND [Profit Variation (copy)_1870401270530695187] &gt; [Profit Control (copy)_1870401270530695186] THEN &apos;PPOL 🤑&apos;&#13;&#10;ELSE &quot;N/A&quot;&#13;&#10;END' />
            </column>
            <column caption='Orders base' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1870401270522667009]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([raw_orders_base])' />
            </column>
            <column caption='Orders var scaled' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1870401270522822658]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([raw_orders_variation] * IFNULL([users_base] / [users_variation],1))' />
            </column>
            <column caption='Scenario' datatype='string' name='[Calculation_1870401270524358662]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1870401270522822658] &gt;= [Calculation_1870401270522667009] AND [Profit Variation (copy)_1870401270530695187] &gt;= [Profit Control (copy)_1870401270530695186] THEN &apos;Win-Win 🎰&apos;&#13;&#10;ELSEIF [Calculation_1870401270522822658] &lt;= [Calculation_1870401270522667009] AND [Profit Variation (copy)_1870401270530695187] &lt;= [Profit Control (copy)_1870401270530695186] THEN &apos;Lose-Lose ⛔&apos;&#13;&#10;ELSEIF [Calculation_1870401270522822658] &gt; [Calculation_1870401270522667009] AND [Profit Variation (copy)_1870401270530695187] &lt; [Profit Control (copy)_1870401270530695186] THEN &apos;CPiO - Cost per Incremental Order&apos;&#13;&#10;ELSEIF [Calculation_1870401270522822658] &lt; [Calculation_1870401270522667009] AND [Profit Variation (copy)_1870401270530695187] &gt; [Profit Control (copy)_1870401270530695186] THEN &apos;PPOL - Profit per Order Lost&apos;&#13;&#10;END' />
              <aliases>
                <alias key='&quot;CPiO - Cost per Incremental Order&quot;' value='CPiO🚀' />
                <alias key='&quot;PPOL - Profit per Order Lost&quot;' value='PPOL 🤑' />
              </aliases>
            </column>
            <column caption='iOrders' datatype='real' default-format='*+#,##0;-#,##0;-' name='[Calculation_1870401270525657095]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1870401270522822658]-[Calculation_1870401270522667009]' />
            </column>
            <column caption='No-Loss Scenario' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1870401270531858456]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_1870401270524358662] = &apos;CPiO - Cost per Incremental Order&apos;&#13;&#10;THEN [Calculation_1870401270522822658] * [Profit Control (copy)_1870401270530695186]&#13;&#10;ELSEIF [Calculation_1870401270524358662] = &apos;PPOL - Profit per Order Lost&apos;&#13;&#10;THEN [Calculation_1870401270522822658] * [Profit Control (copy)_1870401270530695186]&#13;&#10;END' />
            </column>
            <column caption='Trade-off' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1870401270547955742]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_1870401270551183394]&#13;&#10;THEN [Diff Profit (copy)_1870401270531072021] * [Calculation_1870401270522822658] / -[Calculation_1870401270525657095]&#13;&#10;END' />
            </column>
            <column caption='Is Trade-off' datatype='boolean' name='[Calculation_1870401270551183394]' role='measure' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1870401270524358662] = &apos;CPiO - Cost per Incremental Order&apos;&#10;OR [Calculation_1870401270524358662] = &apos;PPOL - Profit per Order Lost&apos;' />
            </column>
            <column caption='Trade-off Type' datatype='string' name='[Calculation_1870401270551588899]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1870401270524358662] = (&apos;CPiO - Cost per Incremental Order&apos;)&#13;&#10;    THEN &apos;CPiO&apos;&#13;&#10;ELSEIF [Calculation_1870401270524358662] = (&apos;PPOL - Profit per Order Lost&apos;)&#13;&#10;    THEN &apos;PPOL&apos;&#13;&#10;END' />
            </column>
            <column caption='ROI' datatype='real' default-format='*#,##0.0%;-#,##0.0%;-' name='[Calculation_1870401270553899044]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Diff Profit (copy)_1870401270533152797]/ABS([Diff Profit per Order (copy)_1870401270532104217])' />
            </column>
            <column caption='%iOrders' datatype='real' default-format='*#,##0.0%;-#,##0.0%;#,##0.0%' name='[Calculation_1870401270647291956]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1870401270525657095]/[Calculation_1870401270522667009]' />
            </column>
            <column caption='%iFLGPO' datatype='real' default-format='*#,##0.0%;-#,##0.0%;#,##0.0%' name='[Calculation_1870401270647345205]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Diff Profit (copy)_1870401270531072021]/ABS([Profit Control (copy)_1870401270530695186])' />
            </column>
            <column caption='Acceptable Order Delta' datatype='real' default-format='*+#,##0.0%;-#,##0.0%;-' name='[Calculation_1870401270664028216]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Profit Control (copy)_1870401270530695186]/([Profit Control (copy)_1870401270530695186]+[Diff Profit (copy)_1870401270531072021]*(1+AVG([roi_threshold]))) - 1' />
            </column>
            <column caption='Current FLGPO' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2015923848704499731]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(&#13;&#10;SUM([analytical_profit]) / SUM([orders]) / AVG(IF [Parameters].[Parameter 10] THEN [fx] ELSE 1 END),&#13;&#10;SUM([flgpo_local_base] * IF [Parameters].[Parameter 10] THEN 1 ELSE [fx] END * [raw_orders_base]) / SUM([raw_orders_base]))' />
            </column>
            <column caption='Winning' datatype='boolean' name='[Calculation_2314005841836142592]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[variation - Split 1]=[variant]' />
              <aliases>
                <alias key='%null%' value='-' />
                <alias key='false' value='N ❌' />
                <alias key='true' value='Y ✅' />
              </aliases>
            </column>
            <column caption='Target FLGPO' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_392094705005985800]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([flgpo_target_eur]) / AVG (IF [Parameters].[Parameter 10] THEN [fx] ELSE 1 END)' />
            </column>
            <column caption='Hide Base' datatype='boolean' name='[Calculation_6135098985835495444]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[variation - Split 1]&lt;&gt;[Var (copy)_870039217785552899]' />
            </column>
            <column caption='iFLGP' datatype='real' default-format='n#,##0;-#,##0' name='[Diff Orders (copy)_1870401270526517256]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Orders Variation (copy)_1870401270523924485]-[Orders Control (copy)_1870401270523924484]' />
            </column>
            <column caption='iFLGPO' datatype='real' default-format='*+#,##0.00;-#,##0.00;-' name='[Diff Profit (copy)_1870401270531072021]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Profit Variation (copy)_1870401270530695187]-[Profit Control (copy)_1870401270530695186]' />
            </column>
            <column caption='Return' datatype='real' name='[Diff Profit (copy)_1870401270533152797]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Diff Orders (copy)_1870401270526517256]' />
            </column>
            <column caption='Investment' datatype='real' default-format='n#,##0;-#,##0' name='[Diff Profit per Order (copy)_1870401270532104217]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Scenario Var (copy)_1870401270554787877]-[Calculation_1870401270531858456]' />
            </column>
            <column caption='FLGP base' datatype='real' default-format='n#,##0;-#,##0' name='[Orders Control (copy)_1870401270523924484]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1870401270522667009] * [Profit Control (copy)_1870401270530695186]' />
            </column>
            <column caption='FLGP var' datatype='real' default-format='n#,##0;-#,##0' name='[Orders Variation (copy)_1870401270523924485]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1870401270522822658] * [Profit Variation (copy)_1870401270530695187]' />
            </column>
            <column caption='FLGPO base' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Profit Control (copy)_1870401270530695186]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([flgpo_local_base] * IF [Parameters].[Parameter 10] THEN 1 ELSE [fx] END * [raw_orders_base]) / SUM([raw_orders_base])&#13;&#10;+ [Calculation_392094705005985800] - [Calculation_2015923848704499731]' />
            </column>
            <column caption='FLGPO var' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Profit Variation (copy)_1870401270530695187]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([flgpo_local_variation] * IF [Parameters].[Parameter 10] THEN 1 ELSE [fx] END * [raw_orders_variation]) / SUM([raw_orders_variation])&#13;&#10;+ [Calculation_392094705005985800] - [Calculation_2015923848704499731]' />
            </column>
            <column caption='Recoup ROI' datatype='real' default-format='*#,##0.0%;-#,##0.0%;-' name='[ROI (copy)_1870401270585368622]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Recoup ROI (copy)_1870401270637305906] / [Recoup ROI numerator (copy)_1870401270586753072]' />
            </column>
            <column caption='Recoup FLGPO' datatype='real' default-format='n#,##0;-#,##0' name='[Recoup ROI (copy)_1870401270586212399]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_1870401270524358662] = &apos;PPOL - Profit per Order Lost&apos;&#13;&#10;THEN - ([Calculation_1870401270525657095] * [Profit Variation (copy)_1870401270530695187])&#13;&#10;//ELSEIF [Scenario] IN (&apos;CPiO - Costly Orders&apos;)&#13;&#10;//THEN ([Diff Orders] * [FLGPO Control])&#13;&#10;END' />
            </column>
            <column caption='Recoup' datatype='real' default-format='n#,##0;-#,##0' name='[Recoup ROI (copy)_1870401270637305906]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Recoup ROI (copy)_1870401270586212399] - [Recoup ROI numerator (copy)_1870401270586753072]' />
            </column>
            <column caption='Recoup Orders' datatype='real' default-format='n#,##0;-#,##0' name='[Recoup ROI numerator (copy)_1870401270586753072]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_1870401270524358662] = &apos;PPOL - Profit per Order Lost&apos;&#13;&#10;THEN ([Diff Profit (copy)_1870401270531072021] * [Calculation_1870401270522822658])&#13;&#10;//ELSEIF [Scenario] IN (&apos;CPiO - Costly Orders&apos;)&#13;&#10;//THEN - ([iFLGPO] * [Orders Control])&#13;&#10;END' />
            </column>
            <column caption='Trade-off vs Target FLGPO' datatype='string' name='[Recoup ROI under Cap (copy)_1370783192837885966]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1870401270524358662] = &apos;PPOL - Profit per Order Lost&apos;&#13;&#10;THEN &#13;&#10;&#13;&#10;IF [Calculation_1870401270547955742] &gt; [Calculation_392094705005985800] THEN &apos;Y ✅&apos;&#13;&#10;ELSEIF [Calculation_1870401270547955742] &lt;= [Calculation_392094705005985800] THEN &apos;N ❌&apos;&#13;&#10;END&#13;&#10;&#13;&#10;ELSEIF [Calculation_1870401270524358662] = &apos;CPiO - Cost per Incremental Order&apos;&#13;&#10;THEN &#13;&#10;&#13;&#10;IF [Calculation_1870401270547955742] &lt; [Calculation_392094705005985800] / AVG(1 + [roi_threshold]) THEN &apos;Y ✅&apos;&#13;&#10;ELSEIF [Calculation_1870401270547955742] &gt;= [Calculation_392094705005985800] / AVG(1 + [roi_threshold]) THEN &apos;N ❌&apos;&#13;&#10;END&#13;&#10;&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
              <aliases>
                <alias key='%null%' value=' ' />
              </aliases>
            </column>
            <column caption='Base Scenario' datatype='real' default-format='n#,##0;-#,##0' name='[Scenario Var (copy)_1870401270554787877]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_1870401270524358662] = &apos;CPiO - Cost per Incremental Order&apos;&#13;&#10;THEN [Orders Variation (copy)_1870401270523924485]&#13;&#10;ELSEIF [Calculation_1870401270524358662] = &apos;PPOL - Profit per Order Lost&apos;&#13;&#10;THEN [Orders Control (copy)_1870401270523924484]&#13;&#10;END' />
            </column>
            <column caption='Additional Check' datatype='string' name='[Soft Check (copy)_2015923848770392160]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1870401270551588899] = &apos;CPiO&apos; THEN [Calculation_1057501546294812723]&#13;&#10;ELSEIF [Calculation_1870401270551588899] = &apos;PPOL&apos; THEN [Calculation_1370783192836448269]&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
            </column>
