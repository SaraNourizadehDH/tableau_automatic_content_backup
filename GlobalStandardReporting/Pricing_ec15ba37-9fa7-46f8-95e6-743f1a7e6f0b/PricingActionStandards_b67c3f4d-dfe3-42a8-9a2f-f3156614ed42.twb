    <worksheet name='Tests'>
      <table>
        <view>
          <datasources>
            <datasource caption='Calculator' name='federated.1ffq3c01pfytq912okfuq0p6iqcw' />
          </datasources>
          <datasource-dependencies datasource='federated.1ffq3c01pfytq912okfuq0p6iqcw'>
            <column caption='Test End Date' datatype='datetime' name='[Calculation_1370783192967573526]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEADD(&apos;day&apos;,[test_length],[test_start_date])' />
            </column>
            <column caption='Targeting' datatype='string' name='[Calculation_557883428998131718]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Label Generator&#13;&#10;TRIM(&#13;&#10;    IF [has_vertical_customer_target] THEN &quot; Vertical&quot; ELSE &quot;&quot; END&#13;&#10;    + IF [has_zone_customer_target] THEN &quot; Zone&quot; ELSE &quot;&quot; END&#13;&#10;)' />
            </column>
            <column caption='Status (cleaned)' datatype='string' name='[Calculation_557883429006790666]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;CONTAINS(LOWER([status]), &quot;impl&quot;)&#13;&#10;OR (LOWER([status]) = &quot;y&quot;)&#13;&#10;OR (LOWER([status]) = &quot;yes&quot;)&#13;&#10;OR (LOWER([status]) = &quot;rolled out&quot;)&#13;&#10;&#13;&#10;THEN &apos;Implemented&apos;&#13;&#10;&#13;&#10;ELSEIF&#13;&#10;&#13;&#10;CONTAINS(LOWER([status]), &quot;depr&quot;)&#13;&#10;OR CONTAINS(LOWER([status]), &quot;iter&quot;)&#13;&#10;OR (LOWER([status]) = &quot;n&quot;)&#13;&#10;OR (LOWER([status]) = &quot;no&quot;)&#13;&#10;OR (LOWER([status]) = &quot;not rolled out&quot;)&#13;&#10;OR (LOWER([status]) = &quot;rejected&quot;)&#13;&#10;OR (LOWER([status]) = &quot;retested&quot;)&#13;&#10;&#13;&#10;THEN &apos;Discarded&apos;&#13;&#10;&#13;&#10;ELSE &apos;Pending Info&apos;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Month Analyzed' datatype='datetime' name='[Calculation_557883429008625675]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&quot;month&quot;, [Calculation_1370783192967573526])' />
            </column>
            <column caption='Total Experiments' datatype='integer' name='[Calculation_557883429009661969]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='TOTAL(COUNTD([entity_id] + STR([test_id])))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Sub-Segment' datatype='string' name='[Calculation_557883429022715925]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [global_entity_id] IN (&apos;GV_CI&apos;, &apos;GV_KE&apos;, &apos;GV_MA&apos;, &apos;GV_NG&apos;, &apos;GV_TN&apos;, &apos;GV_UG&apos;) THEN &apos;AFR&apos;&#13;&#10;ELSEIF [global_entity_id] = &apos;PY_AR&apos; THEN &apos;Argentina&apos;&#13;&#10;ELSEIF [global_entity_id] IN (&apos;DJ_CZ&apos;, &apos;MJM_AT&apos;, &apos;NP_HU&apos;) THEN &apos;CEE&apos;&#13;&#10;ELSEIF [global_entity_id] IN (&apos;GV_AM&apos;, &apos;GV_GE&apos;, &apos;GV_KG&apos;, &apos;GV_KZ&apos;, &apos;GV_UA&apos;) THEN &apos;EECA&apos;&#13;&#10;ELSEIF [global_entity_id] IN (&apos;HF_EG&apos;, &apos;TB_IQ&apos;, &apos;TB_JO&apos;) THEN &apos;EJI&apos;&#13;&#10;ELSEIF [global_entity_id] IN (&apos;TB_AE&apos;, &apos;TB_BH&apos;, &apos;TB_KW&apos;, &apos;TB_OM&apos;, &apos;TB_QA&apos;) THEN &apos;GCC&apos;&#13;&#10;ELSEIF [global_entity_id] IN (&apos;EF_GR&apos;, &apos;FY_CY&apos;) THEN &apos;Greek&apos;&#13;&#10;ELSEIF [global_entity_id] = &apos;HS_SA&apos; THEN &apos;Saudi&apos;&#13;&#10;ELSEIF [global_entity_id] IN (&apos;IN_AE&apos;, &apos;IN_EG&apos;) THEN &apos;Instashop&apos;&#13;&#10;ELSEIF [global_entity_id] IN (&apos;FO_NO&apos;, &apos;OP_SE&apos;, &apos;PO_FI&apos;) THEN &apos;Nordics&apos;&#13;&#10;ELSEIF [global_entity_id] IN (&apos;AP_PA&apos;, &apos;PY_CR&apos;, &apos;PY_DO&apos;, &apos;PY_EC&apos;, &apos;PY_GT&apos;, &apos;PY_HN&apos;, &apos;PY_NI&apos;, &apos;PY_SV&apos;, &apos;PY_VE&apos;) THEN &apos;North&apos;&#13;&#10;ELSEIF [global_entity_id] IN (&apos;GV_BA&apos;, &apos;GV_BG&apos;, &apos;GV_HR&apos;, &apos;GV_MD&apos;, &apos;GV_ME&apos;, &apos;GV_RO&apos;, &apos;GV_RS&apos;) THEN &apos;SEE&apos;&#13;&#10;ELSEIF [global_entity_id] IN (&apos;PY_BO&apos;, &apos;PY_CL&apos;, &apos;PY_PE&apos;, &apos;PY_PY&apos;, &apos;PY_UY&apos;) THEN &apos;South&apos;&#13;&#10;ELSEIF [global_entity_id] IN (&apos;FP_BD&apos;, &apos;FP_KH&apos;, &apos;FP_LA&apos;, &apos;FP_MM&apos;, &apos;FP_PK&apos;, &apos;FP_TH&apos;) THEN &apos;Tail&apos;&#13;&#10;ELSEIF [global_entity_id] IN (&apos;FP_HK&apos;, &apos;FP_MY&apos;, &apos;FP_PH&apos;, &apos;FP_SG&apos;, &apos;FP_TW&apos;) THEN &apos;Top&apos;&#13;&#10;ELSEIF [global_entity_id] IN (&apos;GV_AD&apos;, &apos;GV_ES&apos;, &apos;GV_IT&apos;, &apos;GV_PL&apos;, &apos;GV_PT&apos;) THEN &apos;WEE&apos;&#13;&#10;ELSEIF [global_entity_id] = &apos;BM_KR&apos; THEN &apos;Woowa&apos;&#13;&#10;ELSEIF [global_entity_id] = &apos;YS_TR&apos; THEN &apos;Turkey&apos;&#13;&#10;ELSE [global_entity_id]&#13;&#10;END' />
            </column>
            <column caption='Implemented Variant' datatype='string' name='[Calculation_557883429026676758]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_557883429006790666] = &quot;Implemented&quot; THEN &quot;Var &quot; + STR([variant (Decisions)]) + &quot; &quot; END' />
            </column>
            <column caption='COUNTD([Var])-1' datatype='integer' name='[Calculation_557883429027467287]' role='measure' type='quantitative' user:unnamed='Tests'>
              <calculation class='tableau' formula='COUNTD([variation - Split 1])-1' />
            </column>
            <column caption='Features tested' datatype='string' name='[Raw Label (copy)_557883429000818695]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Label Generator&#13;&#10;TRIM(&#13;&#10;    IF [is_basket_value_test] THEN &quot; Basket Value&quot; ELSE &quot;&quot; END&#13;&#10;    + IF [is_fleet_delay_test] THEN &quot; Surge&quot; ELSE &quot;&quot; END&#13;&#10;    + IF [is_mov_delay_test] THEN &quot; MOV/SBF&quot; ELSE &quot;&quot; END&#13;&#10;    + IF [is_service_fee_test] THEN &quot; SF&quot; ELSE &quot;&quot; END&#13;&#10;    + IF [is_travel_time_test] THEN &quot; DBF&quot; ELSE &quot;&quot; END&#13;&#10;)' />
            </column>
            <column caption='Conditions' datatype='string' name='[Targeting (copy)_557883429001068552]' role='dimension' type='nominal'>
