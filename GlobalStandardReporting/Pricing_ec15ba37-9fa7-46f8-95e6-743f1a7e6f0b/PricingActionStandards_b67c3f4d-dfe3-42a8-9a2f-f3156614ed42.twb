          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ffq3c01pfytq912okfuq0p6iqcw'>
            <column caption='Final P Value' datatype='real' name='[Calculation_1126533277014171648]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF NOT ISNULL([corrected_cuped_p_value]) THEN [corrected_cuped_p_value]&#10;ELSEIF NOT ISNULL([cuped_p_value]) THEN [cuped_p_value]&#10;ELSEIF NOT ISNULL([corrected_p_value]) THEN [corrected_p_value]&#10;ELSE [p_value]&#10;END' />
            </column>
            <column caption='KPI Label' datatype='string' name='[Calculation_2041749161529237504]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [kpi_label] = &quot;commission_local_per_user&quot; THEN &quot;Commission/User&quot;&#13;&#10;ELSEIF [kpi_label] = &quot;dps_delivery_fee_local_per_user&quot; THEN &quot;DPS Delivery Fee/User&quot;&#13;&#10;ELSEIF [kpi_label] = &quot;mov_customer_fee_local_per_user&quot; THEN &quot;Minimum Order Value Fee/User&quot;&#13;&#10;ELSEIF [kpi_label] = &quot;profit_local_per_user&quot; THEN &quot;Gross Profit/User&quot;&#13;&#10;ELSEIF [kpi_label] = &quot;fully_loaded_gross_profit_local_per_user&quot; THEN &quot;Fully Loaded Gross Profit/User&quot;&#13;&#10;ELSEIF [kpi_label] = &quot;revenue_local_per_user&quot; THEN &quot;Revenue/User&quot;&#13;&#10;ELSEIF [kpi_label] = &quot;delivery_costs_local_per_user&quot; THEN &quot;Delivery Costs/User&quot;&#13;&#10;ELSEIF [kpi_label] = &quot;gmv_local_per_user&quot; THEN &quot;GMV/User&quot;&#13;&#10;ELSEIF [kpi_label] = &quot;delivery_distance_per_user&quot; THEN &quot;Delivery Distance/User&quot;&#13;&#10;ELSEIF [kpi_label] = &quot;service_fee_local_per_user&quot; THEN &quot;Service Fee/User&quot;&#13;&#10;ELSEIF [kpi_label] = &quot;travel_time_per_user&quot; THEN &quot;Travel Time/User&quot;&#13;&#10;ELSEIF [kpi_label] = &quot;orders_per_user&quot; THEN &quot;Orders/User&quot;&#13;&#10;&#13;&#10;ELSEIF [kpi_label] = &quot;profit_local&quot; THEN &quot;Gross Profit/Order&quot;&#13;&#10;ELSEIF [kpi_label] = &quot;fully_loaded_gross_profit_local&quot; THEN &quot;Fully Loaded Gross Profit/Order&quot;&#13;&#10;&#13;&#10;&#13;&#10;ELSEIF [kpi_label] = &apos;cvr&apos; THEN &apos;CVR&apos;&#13;&#10;ELSEIF [kpi_label] = &apos;cvr3&apos; THEN &apos;CVR3&apos;&#13;&#10;ELSEIF [kpi_label] = &apos;mcvr2&apos; THEN &apos;mCVR2&apos;&#13;&#10;ELSEIF [kpi_label] = &apos;mcvr3&apos; THEN &apos;mCVR3&apos;&#13;&#10;ELSEIF [kpi_label] = &apos;mcvr4&apos; THEN &apos;mCVR4&apos;&#13;&#10;&#13;&#10;END' />
              <aliases>
                <alias key='&quot;Fully Loaded Gross Profit/Order&quot;' value='FLGP/Order' />
                <alias key='&quot;Fully Loaded Gross Profit/User&quot;' value='FLGP/User' />
              </aliases>
            </column>
            <column caption='Mean   ' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2784420867375927317]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(AVG(&#10;IF CONTAINS([Calculation_2041749161529237504] , &quot;CVR&quot;) THEN [Mean A (copy)_2958865021026353153] * 100&#10;ELSE [Mean A (copy)_2958865021026353153]&#10;END),40)' />
            </column>
            <column caption='IF [Variant A] = &apos;Control&apos; THEN 0 ELSE INT(RIGHT([Variant A],...' datatype='integer' name='[Calculation_2784420867376599064]' role='measure' type='quantitative' user:unnamed='Intervals (2)'>
              <calculation class='tableau' formula='IF [group_a] = &apos;Control&apos; THEN 0 ELSE INT(RIGHT([group_a],1)) END' />
            </column>
            <column caption='Mean A    ' datatype='real' name='[Calculation_2958865021025902592]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([upper_bound_a]+[lower_bound_a])/2' />
            </column>
            <column caption='Legend    ' datatype='string' name='[Calculation_2958865021071876100]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_3751287402078126081] = &apos;Statistically Significant&apos; AND NOT [Calculation_3530751789452361730] THEN &quot;Significant&quot; &#13;&#10;ELSEIF [Calculation_3530751789452361730] THEN &apos;Control&apos;&#13;&#10;ELSE &apos;Not Significant&apos;&#13;&#10;END' />
              <aliases>
                <alias key='&quot;Control&quot;' value='Baseline' />
              </aliases>
            </column>
            <column caption='Indicator' datatype='string' name='[Calculation_3131338776232759304]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_8411246389318590486] = 0  THEN &apos;Neutral&apos;&#10;ELSEIF [Calculation_8411246389318590486] &gt;= 0 THEN &apos;Positive&apos; &#10;ELSEIF [Calculation_8411246389318590486] &lt; 0 THEN &apos;Negative&apos; &#10;END' />
            </column>
            <column caption='VariantA=VariantB' datatype='boolean' name='[Calculation_3530751789452361730]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[group_a] == [group_b]' />
            </column>
            <column caption='Significance    ' datatype='string' name='[Calculation_3751287402078126081]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF(&#10;   ([Calculation_1126533277014171648] &lt;= [Parameters].[Parameter 4 1] AND [anova_p_value] &lt;= [Parameters].[Parameter 4 1])&#10;   OR &#10;   ([Calculation_1126533277014171648] &lt;= [Parameters].[Parameter 4 1] AND ISNULL([anova_p_value]))&#10;   OR &#10;   ([Calculation_1126533277014171648] &lt;= [Parameters].[Parameter 4 1] AND NOT ISNULL([cuped_p_value]))&#10;   )&#10;THEN &quot;Statistically Significant&quot;&#10;ELSE &quot;Statistically Insignificant&quot;&#10;END' />
              <aliases>
                <alias key='&quot;Statistically Insignificant&quot;' value=' ' />
                <alias key='&quot;Statistically Significant&quot;' value='✅' />
              </aliases>
            </column>
            <column caption='Is CUPED Applied' datatype='boolean' name='[Calculation_796011262747332608]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF NOT ISNULL([cuped_p_value]) THEN TRUE ELSE FALSE END' />
              <aliases>
                <alias key='false' value='-' />
                <alias key='true' value='✔️' />
              </aliases>
            </column>
            <column caption='Upper minus Lower Bound %' datatype='real' name='[Calculation_8411246389318455314]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_8411246389318508564]-[Calculation_8411246389318488083]' />
            </column>
            <column caption='Lower Bound %' datatype='real' name='[Calculation_8411246389318488083]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(AVG([lower_bound_b])-(AVG([Calculation_2958865021025902592])))/ABS(AVG([Calculation_2958865021025902592]))' />
            </column>
            <column caption='Upper Bound %' datatype='real' name='[Calculation_8411246389318508564]' role='measure' type='quantitative'>
