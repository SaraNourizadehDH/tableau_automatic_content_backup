              <lod column='[federated.1ffq3c01pfytq912okfuq0p6iqcw].[none:Calculation_1870401270571606059:nk]' />
            </encodings>
            <customized-label>
              <formatted-text>
                <run fontcolor='#b4b4b4' fontsize='10'><![CDATA[Actual Revenue: <[federated.1ffq3c01pfytq912okfuq0p6iqcw].[none:Calculation_1870401270571606059:nk]>]]></run>
                <run>Æ&#10;</run>
                <run fontcolor='#b4b4b4' fontsize='10'><![CDATA[Theoretical Revenue: <[federated.1ffq3c01pfytq912okfuq0p6iqcw].[none:Calculation_1370783192548245510:nk]>]]></run>
              </formatted-text>
            </customized-label>
