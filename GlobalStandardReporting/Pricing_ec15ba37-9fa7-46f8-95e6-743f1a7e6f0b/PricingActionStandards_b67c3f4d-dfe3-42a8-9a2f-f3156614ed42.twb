            <column caption='Conf. Interval' datatype='real' default-format='*+0.0 p.p.;-0.0 p.p.;0.0 p.p.' name='[New customer orders (copy)]' param-domain-type='any' role='measure' type='quantitative' value='1.0570667559036018'>
