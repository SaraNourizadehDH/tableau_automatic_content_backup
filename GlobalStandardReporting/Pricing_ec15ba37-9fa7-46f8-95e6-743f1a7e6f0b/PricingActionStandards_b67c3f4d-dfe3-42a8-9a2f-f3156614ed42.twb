      <aliases enabled='yes' />
      <column caption='%iFLGP' datatype='real' default-format='*#,##0.0%;-#,##0.0%;#,##0.0%' name='[% Profit per Order (copy)_1835216898845216795]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Diff Orders (copy)_1870401270526517256]/ABS([Orders Control (copy)_1870401270523924484])' />
      </column>
      <column caption='%iOrders Recoup' datatype='real' default-format='*#,##0.0%;-#,##0.0%;#,##0.0%' name='[%iOrders (copy)_2371989678307639297]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Recoup ROI (copy)_1870401270586212399]/[Recoup ROI numerator (copy)_1870401270586753072]-1' />
      </column>
      <column caption='Acceptable Order Delta (abs)' datatype='real' default-format='n#,##0;-#,##0' name='[Acceptable Order Delta (copy)_1057501546248728613]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1870401270664028216]+1)*[Calculation_1870401270522667009]' />
      </column>
      <column caption='Acceptable FLGPO Delta' datatype='real' default-format='*+#,##0.0%;-#,##0.0%;#,##0.0%' name='[Acceptable Order Delta (copy)_1370783192529907712]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//([Orders ctrl]/[Orders var scaled]-1)*(1+[ROI threshold])&#13;&#10;//-iOrders / (Orders var × (ROI threshold + 1))&#13;&#10;&#13;&#10;-[Calculation_1870401270525657095] / ([Calculation_1870401270522822658] * (1 + [Parameters].[Parameter 11]))' />
      </column>
      <column caption='Orders Scaled Description' datatype='string' name='[Adj FLGPO Description (copy)_1057501547368624185]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;The higher the number of total users participating in a test, the lower the difference between the users in each variant is expected to be.&#13;&#10;To compensate for this, we adjust the number of total orders based on the ratio between variation and base.&#13;&#10;&quot;' />
      </column>
      <column caption='Ranges Description' datatype='string' name='[Adj FLGPO Description (copy)_1057501547370999866]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Based on the underlying order per user distribution, we estimate with 95% confidence what&apos;s the range of total orders we can project per variant.&#13;&#10;The higher the sample size (more population exposed or longer test length) and the lower the daily variance, the narrower the range will be.&#13;&#10;Wide ranges indicate that a more pronounced change has to be detected, as the expected uplift can turn out to be much lower than estimated.&#13;&#10;A lower boundary below the Acceptable Delta (%iOrders) means that there is not enough evidence yet to expect the ROI to be above the ROI threshold once the variant is implemented.&#13;&#10;&#13;&#10;Acceptable Order Delta (abs): (Acceptable Delta (%iOrders) + 1) × Orders ctrl&#13;&#10;Conf. Interval: (Upper Orders/User var ÷ Mean Orders/User var - 1) × 100&#13;&#10;&quot;' />
      </column>
      <column caption='Cum Adj Target FLGPO' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Adj Target FLGPO (copy)_777433908605091927]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Target FLGPO (copy)_777433908330737707] / (1 + AVG([roi_threshold]))' />
      </column>
      <column caption='Breakeven' datatype='real' default-format='n#,##0;-#,##0' hidden='true' name='[Base Scenario (copy)_1370783192850313233]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Orders Variation (copy)_1870401270523924485] - ([Orders Variation (copy)_1870401270523924485]/(1 + [Parameters].[Parameter 11]) - [Orders Variation (copy)_1870401270523924485] )' />
      </column>
      <column caption='Brand1' datatype='string' name='[Brand]' role='dimension' type='nominal' />
      <column caption='Recoup ROI Description' datatype='string' name='[Calculation_1057501545513336833]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;What ROI is required to recuperate the orders lost before the extra margin from the increase in iFLGPO is consumed.&#13;&#10;A number above the Recoup ROI cap means that we would not be able to recuperate those orders sustainably.&#13;&#10;The Recoup ROI indicates what&apos;s the typical return expected from other marketing levers, not necessarily pricing related.&#13;&#10;&quot;' />
      </column>
      <column caption='Confidence' datatype='real' default-format='*+0.0p.p.;-0.0p.p.;0.0p.p.' name='[Calculation_1057501545606950928]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1870401270551588899] = &apos;CPiO&apos; THEN&#13;&#10;([Calculation_1870401270647291956]-[Calculation_1870401270664028216]) * 100&#13;&#10;&#13;&#10;ELSEIF [Calculation_1870401270551588899] = &apos;PPOL&apos; THEN&#13;&#10;([Calculation_1870401270647345205]-[Acceptable Order Delta (copy)_1370783192529907712]) * 100&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='% incremental' datatype='real' default-format='p0.0%' name='[Calculation_1057501545985904668]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1870401270551588899] = &apos;CPiO&apos; THEN SUM([Calculation_1870401270647291956]) &#13;&#10;ELSEIF [Calculation_1870401270551588899] = &apos;PPOL&apos; THEN SUM([Calculation_1870401270647345205])  &#13;&#10;END' />
      </column>
      <column caption='Acceptable Delta' datatype='real' default-format='*+#,##0.0%;-#,##0.0%;#,##0.0%' name='[Calculation_1057501545986175005]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1870401270551588899] = &apos;CPiO&apos; THEN SUM([Calculation_1870401270664028216]) &#13;&#10;ELSEIF [Calculation_1870401270551588899] = &apos;PPOL&apos; THEN SUM([Acceptable Order Delta (copy)_1370783192529907712])  &#13;&#10;END' />
      </column>
      <column caption='Confidence Interval var' datatype='real' name='[Calculation_1057501546229243934]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([orders_per_user_upper_variation]) / SUM([orders_per_user_mean_variation]) - 1) * 100' />
      </column>
      <column caption='Range Orders var' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1057501546246271009]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Parameters].[New customer orders (copy)] / 100 * [Calculation_1870401270522822658])' />
      </column>
      <column caption='Investment delta' datatype='real' name='[Calculation_1057501547378405435]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Scenario Var (copy)_1870401270554787877]-[Calculation_1870401270531858456]' />
      </column>
      <column caption='Final P Value' datatype='real' name='[Calculation_1126533277014171648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF NOT ISNULL([corrected_cuped_p_value]) THEN [corrected_cuped_p_value]&#10;ELSEIF NOT ISNULL([cuped_p_value]) THEN [cuped_p_value]&#10;ELSEIF NOT ISNULL([corrected_p_value]) THEN [corrected_p_value]&#10;ELSE [p_value]&#10;END' />
      </column>
      <column caption='FLGPO base test' datatype='real' name='[Calculation_1370783192542781443]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([flgpo_local_base] * IF [Parameters].[Parameter 10] THEN 1 ELSE [Parameters].[Parameter 9] END * [raw_orders_base]) / SUM([raw_orders_base])' />
      </column>
      <column caption='Theoretical Scenario Calculation' datatype='string' name='[Calculation_1370783192548245510]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Orders var × Adj FLGPO base&apos;' />
      </column>
      <column caption='ROI above Threshold' datatype='string' name='[Calculation_1370783192835411980 1]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1870401270553899044] &gt; AVG([roi_threshold]) THEN &apos;✅&apos;&#13;&#10;ELSEIF [Calculation_1870401270553899044] &lt;= AVG([roi_threshold]) THEN &apos;❌&apos;&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
        <aliases>
          <alias key='%null%' value=' ' />
        </aliases>
      </column>
      <column caption='ROI above threshold' datatype='boolean' name='[Calculation_1370783192835411980]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1870401270551588899] = &apos;CPiO&apos; THEN [Calculation_1870401270553899044] &gt;= AVG([Parameters].[Parameter 11])&#13;&#10;ELSEIF [Calculation_1870401270551588899] = &apos;PPOL&apos; THEN [Calculation_1870401270553899044] &gt;= AVG([Parameters].[Parameter 11])&#13;&#10;END' />
        <aliases>
          <alias key='%null%' value=' ' />
        </aliases>
      </column>
      <column caption='Recoup ROI under Cap' datatype='boolean' name='[Calculation_1370783192836448269]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1870401270524358662] = &apos;PPOL - Profit per Order Lost&apos;&#13;&#10;THEN [ROI (copy)_1870401270585368622] &lt; [Parameters].[Parameter 12] END' />
        <aliases>
          <alias key='%null%' value=' ' />
        </aliases>
      </column>
      <column caption='Test End Date or Last Update' datatype='datetime' name='[Calculation_1370783192882102290]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEADD(&apos;day&apos;,[test_length],[test_start_date])' />
      </column>
      <column caption='Result' datatype='string' name='[Calculation_1370783192961134613]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1870401270522822658] &gt;= [Calculation_1870401270522667009] AND [Profit Variation (copy)_1870401270530695187 1] &gt;= [Profit Control (copy)_1870401270530695186 1] THEN &apos;Win-Win 🎰&apos;&#13;&#10;ELSEIF [Calculation_1870401270522822658] &lt;= [Calculation_1870401270522667009] AND [Profit Variation (copy)_1870401270530695187 1] &lt;= [Profit Control (copy)_1870401270530695186 1] THEN &apos;Lose-Lose ⛔&apos;&#13;&#10;ELSEIF [Calculation_1870401270522822658] &gt; [Calculation_1870401270522667009] AND [Profit Variation (copy)_1870401270530695187 1] &lt; [Profit Control (copy)_1870401270530695186 1] THEN &apos;CPiO 🚀&apos;&#13;&#10;ELSEIF [Calculation_1870401270522822658] &lt; [Calculation_1870401270522667009] AND [Profit Variation (copy)_1870401270530695187 1] &gt; [Profit Control (copy)_1870401270530695186 1] THEN &apos;PPOL 🤑&apos;&#13;&#10;ELSE &quot;N/A&quot;&#13;&#10;END' />
      </column>
      <column caption='Test End Date' datatype='datetime' name='[Calculation_1370783192967573526]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEADD(&apos;day&apos;,[test_length],[test_start_date])' />
      </column>
      <column caption='Entitlement' datatype='boolean' name='[Calculation_1370783192976404505]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Sync status' datatype='boolean' name='[Calculation_1835216898788831243]' role='measure' type='nominal'>
        <calculation class='tableau' formula='ABS([Parameters].[Parameter 1] / SUM([raw_orders_base]) - 1&#13;&#10;+ [Parameters].[Parameter 2] / SUM([raw_orders_variation]) - 1&#13;&#10;+ [Parameters].[Parameter 9] / SUM([fx]) - 1&#13;&#10;+ [Parameters].[Parameter 5] / [Calculation_1370783192542781443] - 1&#13;&#10;+ [Parameters].[Profit per Order Control (copy)_1870401270523674627] / [FLGPO ctrl test (copy)_1370783192543096836] - 1&#13;&#10;+ [Parameters].[Parameter 8] / [Calculation_2015923848727113784] - 1&#13;&#10;+ [Parameters].[Current Profit per Order (copy)_1835216898774908933] / [Calculation_392094705004056583] - 1&#13;&#10;+ IFNULL([Parameters].[Parameter 3] / MIN(IFNULL([users_base],1000)) - 1, 0)&#13;&#10;+ IFNULL([Parameters].[Parameter 4] / MIN(IFNULL([users_variation],1000)) - 1, 0)&#13;&#10;//+ IF [Users base] = [Users var] THEN 1 ELSE 0 END&#13;&#10;)&#13;&#10;&lt; 0.001' />
        <aliases>
          <alias key='false' value='Unsynced' />
          <alias key='true' value='Synced' />
        </aliases>
      </column>
      <column caption='Status message' datatype='string' name='[Calculation_1835216898790174735]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1835216898788831243] THEN &apos;Loaded&apos; ELSE &apos;Click to sync&apos; END' />
      </column>
      <column caption='Orders base' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1870401270522667009]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
      </column>
      <column caption='Orders var scaled' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1870401270522822658]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Parameters].[Parameter 2] * IFNULL([Parameters].[Parameter 3] / [Parameters].[Parameter 4],1)' />
      </column>
      <column caption='Scenario' datatype='string' name='[Calculation_1870401270524358662]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1870401270522822658] &gt;= [Calculation_1870401270522667009] AND [Parameters].[Profit per Order Control (copy)_1870401270523674627] &gt;= [Parameters].[Parameter 5] THEN &apos;Win-Win 🎰&apos;&#13;&#10;ELSEIF [Calculation_1870401270522822658] &lt;= [Calculation_1870401270522667009] AND [Parameters].[Profit per Order Control (copy)_1870401270523674627] &lt;= [Parameters].[Parameter 5] THEN &apos;Lose-Lose 📉&apos;&#13;&#10;ELSEIF [Calculation_1870401270522822658] &gt; [Calculation_1870401270522667009] AND [Parameters].[Profit per Order Control (copy)_1870401270523674627] &lt; [Parameters].[Parameter 5] THEN &apos;CPiO - Cost per Incremental Order&apos;&#13;&#10;ELSEIF [Calculation_1870401270522822658] &lt; [Calculation_1870401270522667009] AND [Parameters].[Profit per Order Control (copy)_1870401270523674627] &gt; [Parameters].[Parameter 5] THEN &apos;PPOL - Profit per Order Lost&apos;&#13;&#10;END' />
        <aliases>
          <alias key='&quot;CPiO - Cost per Incremental Order&quot;' value='CPiO - Cost per Incremental Order 🚀' />
          <alias key='&quot;PPOL - Profit per Order Lost&quot;' value='PPOL - Profit per Order Lost 🤑' />
        </aliases>
      </column>
      <column caption='iOrders' datatype='real' default-format='*+#,##0;-#,##0;#,##0' name='[Calculation_1870401270525657095]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1870401270522822658]-[Calculation_1870401270522667009]' />
      </column>
      <column caption='Incremental Orders' datatype='boolean' name='[Calculation_1870401270528430093]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1870401270525657095]&gt;0' />
      </column>
      <column caption='Incremental FLGP' datatype='boolean' name='[Calculation_1870401270528516111]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Diff Orders (copy)_1870401270526517256]&gt;0' />
      </column>
      <column caption='Theoretical Revenue' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1870401270531858456]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1870401270522822658] * [Profit Control (copy)_1870401270530695186]' />
      </column>
      <column caption='Trade-off' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1870401270547955742]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1870401270551183394]&#13;&#10;THEN [Diff Profit (copy)_1870401270531072021] * [Calculation_1870401270522822658] / -[Calculation_1870401270525657095]&#13;&#10;END' />
      </column>
      <column caption='Is Trade-off' datatype='boolean' name='[Calculation_1870401270551183394]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1870401270524358662] = &apos;CPiO - Cost per Incremental Order&apos; OR [Calculation_1870401270524358662] = &apos;PPOL - Profit per Order Lost&apos;' />
      </column>
      <column caption='Trade-off Type' datatype='string' name='[Calculation_1870401270551588899]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1870401270524358662] = (&apos;CPiO - Cost per Incremental Order&apos;)&#13;&#10;    THEN &apos;CPiO&apos;&#13;&#10;ELSEIF [Calculation_1870401270524358662] = (&apos;PPOL - Profit per Order Lost&apos;)&#13;&#10;    THEN &apos;PPOL&apos;&#13;&#10;END' />
      </column>
      <column caption='ROI' datatype='real' default-format='*#,##0.0%;-#,##0.0%;#,##0.0%' name='[Calculation_1870401270553899044]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Diff Orders (copy)_1870401270526517256]/ABS([Diff Profit per Order (copy)_1870401270532104217])' />
      </column>
      <column caption='Actual Revenue Calculation' datatype='string' name='[Calculation_1870401270571606059]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1870401270524358662] = &apos;CPiO - Cost per Incremental Order&apos;&#13;&#10;THEN &quot;FLGP var = Orders var × Adj FLGPO var&quot;&#13;&#10;ELSEIF [Calculation_1870401270524358662] = &apos;PPOL - Profit per Order Lost&apos;&#13;&#10;THEN &quot;FLGP base = Orders base × Adj FLGPO base&quot;&#13;&#10;END' />
      </column>
      <column caption='%iOrders' datatype='real' default-format='*#,##0.0%;-#,##0.0%;#,##0.0%' name='[Calculation_1870401270647291956]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1870401270525657095]/[Calculation_1870401270522667009]' />
      </column>
      <column caption='%iFLGPO' datatype='real' default-format='*#,##0.0%;-#,##0.0%;#,##0.0%' name='[Calculation_1870401270647345205]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Diff Profit (copy)_1870401270531072021]/ABS([Profit Control (copy)_1870401270530695186])' />
      </column>
      <column caption='Acceptable Order Delta' datatype='real' default-format='*+#,##0.0%;-#,##0.0%;#,##0.0%' name='[Calculation_1870401270664028216]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Profit Control (copy)_1870401270530695186]/([Profit Control (copy)_1870401270530695186]+[Diff Profit (copy)_1870401270531072021]*(1+[Parameters].[Parameter 11])) - 1' />
      </column>
      <column caption='Current FLGPO' datatype='real' name='[Calculation_2015923848727113784]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(&#13;&#10;SUM([analytical_profit]) / SUM([orders]) / AVG([fx]) * AVG(IF [Parameters].[Parameter 10] THEN 1 ELSE [Parameters].[Parameter 9] END),&#13;&#10;SUM([flgpo_local_base] * IF [Parameters].[Parameter 10] THEN 1 ELSE [Parameters].[Parameter 9] END * [raw_orders_base]) / SUM([raw_orders_base]))' />
      </column>
      <column caption='Expected Baseline Growth' datatype='real' default-format='*+#,##0.00;-#,##0.00;#,##0.00' name='[Calculation_2015923848746070080]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_392094705004056583]-[Calculation_2015923848727113784]' />
      </column>
      <column caption='KPI Label' datatype='string' name='[Calculation_2041749161529237504]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [kpi_label] = &quot;commission_local_per_user&quot; THEN &quot;Commission/User&quot;&#13;&#10;ELSEIF [kpi_label] = &quot;dps_delivery_fee_local_per_user&quot; THEN &quot;DPS Delivery Fee/User&quot;&#13;&#10;ELSEIF [kpi_label] = &quot;mov_customer_fee_local_per_user&quot; THEN &quot;Minimum Order Value Fee/User&quot;&#13;&#10;ELSEIF [kpi_label] = &quot;profit_local_per_user&quot; THEN &quot;Gross Profit/User&quot;&#13;&#10;ELSEIF [kpi_label] = &quot;fully_loaded_gross_profit_local_per_user&quot; THEN &quot;Fully Loaded Gross Profit/User&quot;&#13;&#10;ELSEIF [kpi_label] = &quot;revenue_local_per_user&quot; THEN &quot;Revenue/User&quot;&#13;&#10;ELSEIF [kpi_label] = &quot;delivery_costs_local_per_user&quot; THEN &quot;Delivery Costs/User&quot;&#13;&#10;ELSEIF [kpi_label] = &quot;gmv_local_per_user&quot; THEN &quot;GMV/User&quot;&#13;&#10;ELSEIF [kpi_label] = &quot;delivery_distance_per_user&quot; THEN &quot;Delivery Distance/User&quot;&#13;&#10;ELSEIF [kpi_label] = &quot;service_fee_local_per_user&quot; THEN &quot;Service Fee/User&quot;&#13;&#10;ELSEIF [kpi_label] = &quot;travel_time_per_user&quot; THEN &quot;Travel Time/User&quot;&#13;&#10;ELSEIF [kpi_label] = &quot;orders_per_user&quot; THEN &quot;Orders/User&quot;&#13;&#10;&#13;&#10;ELSEIF [kpi_label] = &quot;profit_local&quot; THEN &quot;Gross Profit/Order&quot;&#13;&#10;ELSEIF [kpi_label] = &quot;fully_loaded_gross_profit_local&quot; THEN &quot;Fully Loaded Gross Profit/Order&quot;&#13;&#10;&#13;&#10;&#13;&#10;ELSEIF [kpi_label] = &apos;cvr&apos; THEN &apos;CVR&apos;&#13;&#10;ELSEIF [kpi_label] = &apos;cvr3&apos; THEN &apos;CVR3&apos;&#13;&#10;ELSEIF [kpi_label] = &apos;mcvr2&apos; THEN &apos;mCVR2&apos;&#13;&#10;ELSEIF [kpi_label] = &apos;mcvr3&apos; THEN &apos;mCVR3&apos;&#13;&#10;ELSEIF [kpi_label] = &apos;mcvr4&apos; THEN &apos;mCVR4&apos;&#13;&#10;&#13;&#10;END' />
        <aliases>
          <alias key='&quot;Fully Loaded Gross Profit/Order&quot;' value='FLGP/Order' />
          <alias key='&quot;Fully Loaded Gross Profit/User&quot;' value='FLGP/User' />
        </aliases>
      </column>
      <column caption='Rounded Adj Target FLGPO' datatype='real' name='[Calculation_2066026373310832643]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='ROUND([Calculation_5789025521514053681],2)' />
      </column>
      <column caption='Winning' datatype='boolean' name='[Calculation_2314005841843933187]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[variant (Decisions)]=[variation - Split 1]' />
        <aliases>
          <alias key='%null%' value='-' />
          <alias key='false' value='N ❌' />
          <alias key='true' value='Y ✅' />
        </aliases>
      </column>
      <column caption='Investment %' datatype='real' default-format='*#,##0.0%;-#,##0.0%;#,##0.0%' name='[Calculation_2371989678308216834]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Scenario Var (copy)_1870401270554787877]/[Calculation_1870401270531858456] - 1' />
      </column>
      <column caption='Selected Variant' datatype='boolean' name='[Calculation_2492742418525646850]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[variation]=[group_b]' />
      </column>
      <column caption='Is PPOL (simple)' datatype='boolean' name='[Calculation_2492742418526404611]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[Calculation_7035115223930146844] = &apos;PPOL&apos;' />
      </column>
      <column caption='Mean   ' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2784420867375927317]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(AVG(&#10;IF CONTAINS([Calculation_2041749161529237504] , &quot;CVR&quot;) THEN [Mean A (copy)_2958865021026353153] * 100&#10;ELSE [Mean A (copy)_2958865021026353153]&#10;END),40)' />
      </column>
      <column caption='Mean A    ' datatype='real' name='[Calculation_2958865021025902592]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([upper_bound_a]+[lower_bound_a])/2' />
      </column>
      <column caption='Legend    ' datatype='string' name='[Calculation_2958865021071876100]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_3751287402078126081] = &apos;Statistically Significant&apos; AND NOT [Calculation_3530751789452361730] THEN &quot;Significant&quot; &#13;&#10;ELSEIF [Calculation_3530751789452361730] THEN &apos;Control&apos;&#13;&#10;ELSE &apos;Not Significant&apos;&#13;&#10;END' />
        <aliases>
          <alias key='&quot;Control&quot;' value='Baseline' />
        </aliases>
      </column>
      <column caption='Indicator' datatype='string' name='[Calculation_3131338776232759304]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_8411246389318590486] = 0  THEN &apos;Neutral&apos;&#10;ELSEIF [Calculation_8411246389318590486] &gt;= 0 THEN &apos;Positive&apos; &#10;ELSEIF [Calculation_8411246389318590486] &lt; 0 THEN &apos;Negative&apos; &#10;END' />
      </column>
      <column caption='FLGPO Eur' datatype='real' name='[Calculation_3165467654014029824]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([analytical_profit])/SUM([orders])' />
      </column>
      <column caption='Cum Daily Orders' datatype='real' name='[Calculation_3165467655504834579]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM([Calculation_3165467655504875540])/RUNNING_SUM(COUNTD([order_date]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Daily Orders' datatype='real' name='[Calculation_3165467655504875540]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([raw_orders]) * AVG(IFNULL([users_base] / [users_variation],1))' />
      </column>
      <column caption='VariantA=VariantB' datatype='boolean' name='[Calculation_3530751789452361730]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[group_a] == [group_b]' />
      </column>
      <column caption='Significance    ' datatype='string' name='[Calculation_3751287402078126081]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF(&#10;   ([Calculation_1126533277014171648] &lt;= [Parameters].[Parameter 4 1] AND [anova_p_value] &lt;= [Parameters].[Parameter 4 1])&#10;   OR &#10;   ([Calculation_1126533277014171648] &lt;= [Parameters].[Parameter 4 1] AND ISNULL([anova_p_value]))&#10;   OR &#10;   ([Calculation_1126533277014171648] &lt;= [Parameters].[Parameter 4 1] AND NOT ISNULL([cuped_p_value]))&#10;   )&#10;THEN &quot;Statistically Significant&quot;&#10;ELSE &quot;Statistically Insignificant&quot;&#10;END' />
        <aliases>
          <alias key='&quot;Statistically Insignificant&quot;' value=' ' />
          <alias key='&quot;Statistically Significant&quot;' value='✅' />
        </aliases>
      </column>
      <column caption='Target FLGPO' datatype='real' name='[Calculation_392094705004056583]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([flgpo_target_eur]) &#13;&#10;// / IF [Scenario] = &apos;CPiO - Cost per Incremental Order&apos; THEN (1 + [ROI threshold]) &#13;&#10;// ELSE 1 &#13;&#10;// END &#13;&#10;/ AVG([fx]) * AVG(IF [Parameters].[Parameter 10] THEN 1 ELSE [Parameters].[Parameter 9] END)' />
      </column>
      <column caption='Targeting' datatype='string' name='[Calculation_557883428998131718]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Label Generator&#13;&#10;TRIM(&#13;&#10;    IF [has_vertical_customer_target] THEN &quot; Vertical&quot; ELSE &quot;&quot; END&#13;&#10;    + IF [has_zone_customer_target] THEN &quot; Zone&quot; ELSE &quot;&quot; END&#13;&#10;)' />
      </column>
      <column caption='Status (cleaned)' datatype='string' name='[Calculation_557883429006790666]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#13;&#10;CONTAINS(LOWER([status]), &quot;impl&quot;)&#13;&#10;OR (LOWER([status]) = &quot;y&quot;)&#13;&#10;OR (LOWER([status]) = &quot;yes&quot;)&#13;&#10;OR (LOWER([status]) = &quot;rolled out&quot;)&#13;&#10;&#13;&#10;THEN &apos;Implemented&apos;&#13;&#10;&#13;&#10;ELSEIF&#13;&#10;&#13;&#10;CONTAINS(LOWER([status]), &quot;depr&quot;)&#13;&#10;OR CONTAINS(LOWER([status]), &quot;iter&quot;)&#13;&#10;OR (LOWER([status]) = &quot;n&quot;)&#13;&#10;OR (LOWER([status]) = &quot;no&quot;)&#13;&#10;OR (LOWER([status]) = &quot;not rolled out&quot;)&#13;&#10;OR (LOWER([status]) = &quot;rejected&quot;)&#13;&#10;OR (LOWER([status]) = &quot;retested&quot;)&#13;&#10;&#13;&#10;THEN &apos;Discarded&apos;&#13;&#10;&#13;&#10;ELSE &apos;Pending Info&apos;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Month Analyzed' datatype='datetime' name='[Calculation_557883429008625675]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&quot;month&quot;, [Calculation_1370783192967573526])' />
      </column>
      <column caption='Total Experiments' datatype='integer' name='[Calculation_557883429009661969]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='TOTAL(COUNTD([entity_id] + STR([test_id])))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Previous month' datatype='datetime' name='[Calculation_557883429010407442]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEADD(&quot;month&quot;, -1, &#13;&#10;DATETRUNC(&quot;month&quot;, TODAY())&#13;&#10;)' />
      </column>
      <column caption='Sub-Segment' datatype='string' name='[Calculation_557883429022715925]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [global_entity_id] IN (&apos;GV_CI&apos;, &apos;GV_KE&apos;, &apos;GV_MA&apos;, &apos;GV_NG&apos;, &apos;GV_TN&apos;, &apos;GV_UG&apos;) THEN &apos;AFR&apos;&#13;&#10;ELSEIF [global_entity_id] = &apos;PY_AR&apos; THEN &apos;Argentina&apos;&#13;&#10;ELSEIF [global_entity_id] IN (&apos;DJ_CZ&apos;, &apos;MJM_AT&apos;, &apos;NP_HU&apos;) THEN &apos;CEE&apos;&#13;&#10;ELSEIF [global_entity_id] IN (&apos;GV_AM&apos;, &apos;GV_GE&apos;, &apos;GV_KG&apos;, &apos;GV_KZ&apos;, &apos;GV_UA&apos;) THEN &apos;EECA&apos;&#13;&#10;ELSEIF [global_entity_id] IN (&apos;HF_EG&apos;, &apos;TB_IQ&apos;, &apos;TB_JO&apos;) THEN &apos;EJI&apos;&#13;&#10;ELSEIF [global_entity_id] IN (&apos;TB_AE&apos;, &apos;TB_BH&apos;, &apos;TB_KW&apos;, &apos;TB_OM&apos;, &apos;TB_QA&apos;) THEN &apos;GCC&apos;&#13;&#10;ELSEIF [global_entity_id] IN (&apos;EF_GR&apos;, &apos;FY_CY&apos;) THEN &apos;Greek&apos;&#13;&#10;ELSEIF [global_entity_id] = &apos;HS_SA&apos; THEN &apos;Saudi&apos;&#13;&#10;ELSEIF [global_entity_id] IN (&apos;IN_AE&apos;, &apos;IN_EG&apos;) THEN &apos;Instashop&apos;&#13;&#10;ELSEIF [global_entity_id] IN (&apos;FO_NO&apos;, &apos;OP_SE&apos;, &apos;PO_FI&apos;) THEN &apos;Nordics&apos;&#13;&#10;ELSEIF [global_entity_id] IN (&apos;AP_PA&apos;, &apos;PY_CR&apos;, &apos;PY_DO&apos;, &apos;PY_EC&apos;, &apos;PY_GT&apos;, &apos;PY_HN&apos;, &apos;PY_NI&apos;, &apos;PY_SV&apos;, &apos;PY_VE&apos;) THEN &apos;North&apos;&#13;&#10;ELSEIF [global_entity_id] IN (&apos;GV_BA&apos;, &apos;GV_BG&apos;, &apos;GV_HR&apos;, &apos;GV_MD&apos;, &apos;GV_ME&apos;, &apos;GV_RO&apos;, &apos;GV_RS&apos;) THEN &apos;SEE&apos;&#13;&#10;ELSEIF [global_entity_id] IN (&apos;PY_BO&apos;, &apos;PY_CL&apos;, &apos;PY_PE&apos;, &apos;PY_PY&apos;, &apos;PY_UY&apos;) THEN &apos;South&apos;&#13;&#10;ELSEIF [global_entity_id] IN (&apos;FP_BD&apos;, &apos;FP_KH&apos;, &apos;FP_LA&apos;, &apos;FP_MM&apos;, &apos;FP_PK&apos;, &apos;FP_TH&apos;) THEN &apos;Tail&apos;&#13;&#10;ELSEIF [global_entity_id] IN (&apos;FP_HK&apos;, &apos;FP_MY&apos;, &apos;FP_PH&apos;, &apos;FP_SG&apos;, &apos;FP_TW&apos;) THEN &apos;Top&apos;&#13;&#10;ELSEIF [global_entity_id] IN (&apos;GV_AD&apos;, &apos;GV_ES&apos;, &apos;GV_IT&apos;, &apos;GV_PL&apos;, &apos;GV_PT&apos;) THEN &apos;WEE&apos;&#13;&#10;ELSEIF [global_entity_id] = &apos;BM_KR&apos; THEN &apos;Woowa&apos;&#13;&#10;ELSEIF [global_entity_id] = &apos;YS_TR&apos; THEN &apos;Turkey&apos;&#13;&#10;ELSE [global_entity_id]&#13;&#10;END' />
      </column>
      <column caption='Implemented Variant' datatype='string' name='[Calculation_557883429026676758]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_557883429006790666] = &quot;Implemented&quot; THEN &quot;Var &quot; + STR([variant (Decisions)]) + &quot; &quot; END' />
      </column>
      <column caption='Adj Target FLGPO' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_5789025521514053681]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Parameters].[Current Profit per Order (copy)_1835216898774908933] / (1 + [Parameters].[Parameter 11])' />
      </column>
      <column caption='Is Winning Variant' datatype='boolean' name='[Calculation_7035115223925391380]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[variation - Split 1]=[variant (Decisions)]' />
      </column>
      <column caption='FLGPO base (simple)' datatype='real' name='[Calculation_7035115223926898710]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([flgpo_local_base] * IF [Parameters].[Parameter 10] THEN 1 ELSE [fx] END * [raw_orders_base])&#10;/ SUM([raw_orders_base])&#10;+ [Target FLGPO (copy)_777433908330737707] - [Current FLGPO (copy)_777433908330655786]' />
      </column>
      <column caption='FLGP var (simple)' datatype='real' name='[Calculation_7035115223929946138]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[FLGPO base (simple) (copy)_7035115223927529495] * [Orders base (simple) (copy)_7035115223929688089]' />
      </column>
      <column caption='Trade-off Type (simple)' datatype='string' name='[Calculation_7035115223930146844]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ATTR([variation]) = ATTR([base]) THEN NULL // No trade-off for Base&#10;ELSEIF [Orders base (simple) (copy)_7035115223929688089] &gt;= [FLGPO base (simple) (copy)_7035115223929380888] AND [FLGPO base (simple) (copy)_7035115223927529495] &gt;=  [Calculation_7035115223926898710] THEN &apos;Win-Win&apos;&#10;ELSEIF [Orders base (simple) (copy)_7035115223929688089] &lt;= [FLGPO base (simple) (copy)_7035115223929380888] AND [FLGPO base (simple) (copy)_7035115223927529495] &lt;=  [Calculation_7035115223926898710] THEN &apos;Lose-Lose&apos;&#10;ELSEIF [Orders base (simple) (copy)_7035115223929688089] &gt; [FLGPO base (simple) (copy)_7035115223929380888] AND [FLGPO base (simple) (copy)_7035115223927529495] &lt; [Calculation_7035115223926898710] THEN &apos;CPiO&apos;&#10;ELSEIF [Orders base (simple) (copy)_7035115223929688089] &lt; [FLGPO base (simple) (copy)_7035115223929380888] AND [FLGPO base (simple) (copy)_7035115223927529495] &gt; [Calculation_7035115223926898710] THEN &apos;PPOL&apos;&#10;END' />
