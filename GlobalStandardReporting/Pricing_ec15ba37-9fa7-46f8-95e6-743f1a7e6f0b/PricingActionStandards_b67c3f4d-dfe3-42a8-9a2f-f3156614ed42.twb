            <column datatype='integer' name='[users_base]' role='measure' type='quantitative' />
            <column aggregation='Avg' datatype='integer' name='[users_variation]' role='measure' type='quantitative' />
            <column-instance column='[Adj Target FLGPO (copy)_777433908605091927]' derivation='User' name='[usr:Adj Target FLGPO (copy)_777433908605091927:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_777433908307869736]' derivation='User' name='[usr:Calculation_777433908307869736:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Cum ROI (copy) (copy)_777433908302905381]' derivation='User' name='[usr:Cum ROI (copy) (copy)_777433908302905381:nk]' pivot='key' type='nominal'>
              <table-calc ordering-type='Rows' />
