            </column>
            <column caption='Scenario' datatype='string' name='[Calculation_1870401270524358662]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1870401270522822658] &gt;= [Calculation_1870401270522667009] AND [Parameters].[Profit per Order Control (copy)_1870401270523674627] &gt;= [Parameters].[Parameter 5] THEN &apos;Win-Win 🎰&apos;&#13;&#10;ELSEIF [Calculation_1870401270522822658] &lt;= [Calculation_1870401270522667009] AND [Parameters].[Profit per Order Control (copy)_1870401270523674627] &lt;= [Parameters].[Parameter 5] THEN &apos;Lose-Lose 📉&apos;&#13;&#10;ELSEIF [Calculation_1870401270522822658] &gt; [Calculation_1870401270522667009] AND [Parameters].[Profit per Order Control (copy)_1870401270523674627] &lt; [Parameters].[Parameter 5] THEN &apos;CPiO - Cost per Incremental Order&apos;&#13;&#10;ELSEIF [Calculation_1870401270522822658] &lt; [Calculation_1870401270522667009] AND [Parameters].[Profit per Order Control (copy)_1870401270523674627] &gt; [Parameters].[Parameter 5] THEN &apos;PPOL - Profit per Order Lost&apos;&#13;&#10;END' />
