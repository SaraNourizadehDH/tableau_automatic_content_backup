    <worksheet name='Acceptable Order Delta'>
      <table>
        <view>
          <datasources>
            <datasource caption='Calculator' name='federated.1ffq3c01pfytq912okfuq0p6iqcw' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Target FLGPO' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Current Profit per Order (copy)_1835216898774908933]' param-domain-type='any' role='measure' type='quantitative' value='0.87995458186395636'>
              <calculation class='tableau' formula='0.87995458186395636' />
            </column>
            <column caption='ROI threshold' datatype='real' default-format='p0%' name='[Parameter 11]' param-domain-type='any' role='measure' type='quantitative' value='-0.20000000000000001'>
              <calculation class='tableau' formula='-0.20000000000000001' />
            </column>
            <column caption='Orders base' datatype='integer' datatype-customized='true' name='[Parameter 1]' param-domain-type='any' role='measure' type='quantitative' value='370602'>
              <calculation class='tableau' formula='370602' />
            </column>
            <column caption='Orders var' datatype='real' datatype-customized='true' name='[Parameter 2]' param-domain-type='any' role='measure' type='quantitative' value='379681.0'>
              <calculation class='tableau' formula='379681.0' />
            </column>
            <column caption='Users base' datatype='integer' name='[Parameter 3]' param-domain-type='any' role='measure' type='quantitative' value='172462'>
              <calculation class='tableau' formula='172462' />
            </column>
            <column caption='Users var' datatype='integer' name='[Parameter 4]' param-domain-type='any' role='measure' type='quantitative' value='172812'>
              <calculation class='tableau' formula='172812' />
            </column>
            <column caption='FLGPO base' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Parameter 5]' param-domain-type='any' role='measure' type='quantitative' value='0.69799914902887505'>
              <calculation class='tableau' formula='0.69799914902887505' />
            </column>
            <column caption='Current FLGPO' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Parameter 8]' param-domain-type='any' role='measure' type='quantitative' value='0.91182344974521223'>
              <calculation class='tableau' formula='0.91182344974521223' />
            </column>
            <column caption='FLGPO var' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Profit per Order Control (copy)_1870401270523674627]' param-domain-type='any' role='measure' type='quantitative' value='0.65615519843532288'>
              <calculation class='tableau' formula='0.65615519843532288' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ffq3c01pfytq912okfuq0p6iqcw'>
            <column caption='Acceptable FLGPO Delta' datatype='real' default-format='*+#,##0.0%;-#,##0.0%;#,##0.0%' name='[Acceptable Order Delta (copy)_1370783192529907712]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//([Orders ctrl]/[Orders var scaled]-1)*(1+[ROI threshold])&#13;&#10;//-iOrders / (Orders var × (ROI threshold + 1))&#13;&#10;&#13;&#10;-[Calculation_1870401270525657095] / ([Calculation_1870401270522822658] * (1 + [Parameters].[Parameter 11]))' />
            </column>
            <column caption='Confidence' datatype='real' default-format='*+0.0p.p.;-0.0p.p.;0.0p.p.' name='[Calculation_1057501545606950928]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_1870401270551588899] = &apos;CPiO&apos; THEN&#13;&#10;([Calculation_1870401270647291956]-[Calculation_1870401270664028216]) * 100&#13;&#10;&#13;&#10;ELSEIF [Calculation_1870401270551588899] = &apos;PPOL&apos; THEN&#13;&#10;([Calculation_1870401270647345205]-[Acceptable Order Delta (copy)_1370783192529907712]) * 100&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='% incremental' datatype='real' default-format='p0.0%' name='[Calculation_1057501545985904668]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_1870401270551588899] = &apos;CPiO&apos; THEN SUM([Calculation_1870401270647291956]) &#13;&#10;ELSEIF [Calculation_1870401270551588899] = &apos;PPOL&apos; THEN SUM([Calculation_1870401270647345205])  &#13;&#10;END' />
            </column>
            <column caption='Acceptable Delta' datatype='real' default-format='*+#,##0.0%;-#,##0.0%;#,##0.0%' name='[Calculation_1057501545986175005]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_1870401270551588899] = &apos;CPiO&apos; THEN SUM([Calculation_1870401270664028216]) &#13;&#10;ELSEIF [Calculation_1870401270551588899] = &apos;PPOL&apos; THEN SUM([Acceptable Order Delta (copy)_1370783192529907712])  &#13;&#10;END' />
            </column>
            <column caption='Orders base' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1870401270522667009]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
            </column>
            <column caption='Orders var scaled' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1870401270522822658]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Parameters].[Parameter 2] * IFNULL([Parameters].[Parameter 3] / [Parameters].[Parameter 4],1)' />
            </column>
            <column caption='Scenario' datatype='string' name='[Calculation_1870401270524358662]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1870401270522822658] &gt;= [Calculation_1870401270522667009] AND [Parameters].[Profit per Order Control (copy)_1870401270523674627] &gt;= [Parameters].[Parameter 5] THEN &apos;Win-Win 🎰&apos;&#13;&#10;ELSEIF [Calculation_1870401270522822658] &lt;= [Calculation_1870401270522667009] AND [Parameters].[Profit per Order Control (copy)_1870401270523674627] &lt;= [Parameters].[Parameter 5] THEN &apos;Lose-Lose 📉&apos;&#13;&#10;ELSEIF [Calculation_1870401270522822658] &gt; [Calculation_1870401270522667009] AND [Parameters].[Profit per Order Control (copy)_1870401270523674627] &lt; [Parameters].[Parameter 5] THEN &apos;CPiO - Cost per Incremental Order&apos;&#13;&#10;ELSEIF [Calculation_1870401270522822658] &lt; [Calculation_1870401270522667009] AND [Parameters].[Profit per Order Control (copy)_1870401270523674627] &gt; [Parameters].[Parameter 5] THEN &apos;PPOL - Profit per Order Lost&apos;&#13;&#10;END' />
              <aliases>
                <alias key='&quot;CPiO - Cost per Incremental Order&quot;' value='CPiO - Cost per Incremental Order 🚀' />
                <alias key='&quot;PPOL - Profit per Order Lost&quot;' value='PPOL - Profit per Order Lost 🤑' />
              </aliases>
            </column>
            <column caption='iOrders' datatype='real' default-format='*+#,##0;-#,##0;#,##0' name='[Calculation_1870401270525657095]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1870401270522822658]-[Calculation_1870401270522667009]' />
            </column>
            <column caption='Is Trade-off' datatype='boolean' name='[Calculation_1870401270551183394]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1870401270524358662] = &apos;CPiO - Cost per Incremental Order&apos; OR [Calculation_1870401270524358662] = &apos;PPOL - Profit per Order Lost&apos;' />
            </column>
            <column caption='Trade-off Type' datatype='string' name='[Calculation_1870401270551588899]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1870401270524358662] = (&apos;CPiO - Cost per Incremental Order&apos;)&#13;&#10;    THEN &apos;CPiO&apos;&#13;&#10;ELSEIF [Calculation_1870401270524358662] = (&apos;PPOL - Profit per Order Lost&apos;)&#13;&#10;    THEN &apos;PPOL&apos;&#13;&#10;END' />
            </column>
            <column caption='%iOrders' datatype='real' default-format='*#,##0.0%;-#,##0.0%;#,##0.0%' name='[Calculation_1870401270647291956]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1870401270525657095]/[Calculation_1870401270522667009]' />
            </column>
            <column caption='%iFLGPO' datatype='real' default-format='*#,##0.0%;-#,##0.0%;#,##0.0%' name='[Calculation_1870401270647345205]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Diff Profit (copy)_1870401270531072021]/ABS([Profit Control (copy)_1870401270530695186])' />
            </column>
            <column caption='Acceptable Order Delta' datatype='real' default-format='*+#,##0.0%;-#,##0.0%;#,##0.0%' name='[Calculation_1870401270664028216]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Profit Control (copy)_1870401270530695186]/([Profit Control (copy)_1870401270530695186]+[Diff Profit (copy)_1870401270531072021]*(1+[Parameters].[Parameter 11])) - 1' />
            </column>
            <column caption='iFLGPO' datatype='real' default-format='*+#,##0.00;-#,##0.00;#,##0.0' name='[Diff Profit (copy)_1870401270531072021]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Profit Variation (copy)_1870401270530695187]-[Profit Control (copy)_1870401270530695186]' />
            </column>
            <column caption='Adj FLGPO base' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Profit Control (copy)_1870401270530695186]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Parameters].[Parameter 5] + ([Parameters].[Current Profit per Order (copy)_1835216898774908933] - [Parameters].[Parameter 8])' />
            </column>
            <column caption='Adj FLGPO var' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Profit Variation (copy)_1870401270530695187]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Parameters].[Profit per Order Control (copy)_1870401270523674627] + ([Parameters].[Current Profit per Order (copy)_1835216898774908933] - [Parameters].[Parameter 8])' />
            </column>
            <column-instance column='[Calculation_1870401270551183394]' derivation='None' name='[none:Calculation_1870401270551183394:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1057501545606950928]' derivation='Sum' name='[sum:Calculation_1057501545606950928:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1057501545985904668]' derivation='User' name='[usr:Calculation_1057501545985904668:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1057501545986175005]' derivation='User' name='[usr:Calculation_1057501545986175005:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
