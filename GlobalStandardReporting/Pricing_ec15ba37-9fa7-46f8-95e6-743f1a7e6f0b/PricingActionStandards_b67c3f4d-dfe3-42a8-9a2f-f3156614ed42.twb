            <column caption='FLGPO var' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Profit per Order Control (copy)_1870401270523674627]' param-domain-type='any' role='measure' type='quantitative' value='0.65615519843532288'>
              <calculation class='tableau' formula='0.65615519843532288' />
