        <calculation class='tableau' formula='IF ATTR([variant]) = ATTR([base]) THEN NULL&#13;&#10;ELSEIF [Cum ROI (copy)_777433908297650207] &gt; 10 THEN 10&#13;&#10;ELSEIF [Cum ROI (copy)_777433908297650207] &lt; -10 THEN -10&#13;&#10;ELSE [Cum ROI (copy)_777433908297650207] &#13;&#10;END'>
