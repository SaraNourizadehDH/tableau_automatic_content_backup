      </column>
      <column caption='Investment' datatype='real' default-format='n#,##0;-#,##0' name='[Diff Profit per Order (copy)_1870401270532104217]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1870401270551588899] = &apos;CPiO&apos; THEN&#13;&#10;&#13;&#10;[Calculation_1870401270531858456]-[Scenario Var (copy)_1870401270554787877]&#13;&#10;&#13;&#10;ELSEIF [Calculation_1870401270551588899] = &apos;PPOL&apos; THEN&#13;&#10;&#13;&#10;[Scenario Var (copy)_1870401270554787877]-[Calculation_1870401270531858456]&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='FLGP base (simple)' datatype='real' name='[FLGP var (simple) (copy)_7035115223930032155]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_7035115223926898710] * [FLGPO base (simple) (copy)_7035115223929380888]' />
      </column>
      <column caption='FLGPO var (simple)' datatype='real' name='[FLGPO base (simple) (copy)_7035115223927529495]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([flgpo_local_variation] &#10;* IF [Parameters].[Parameter 10] THEN 1 ELSE [fx] END &#10;* [raw_orders_variation])&#10;/ SUM([raw_orders_variation])&#10;+ [Target FLGPO (copy)_777433908330737707] - [Current FLGPO (copy)_777433908330655786]' />
      </column>
      <column caption='Orders base (simple)' datatype='integer' name='[FLGPO base (simple) (copy)_7035115223929380888]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([raw_orders_base])' />
      </column>
      <column caption='FLGPO var test' datatype='real' name='[FLGPO ctrl test (copy)_1370783192543096836]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([flgpo_local_variation] * IF [Parameters].[Parameter 10] THEN 1 ELSE [Parameters].[Parameter 9] END * [raw_orders_variation]) / SUM([raw_orders_variation])' />
      </column>
      <column caption='Incremental FLGPO' datatype='boolean' name='[Incremental Profit (copy)_1870401270531002388]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Diff Profit (copy)_1870401270531072021]&gt;0' />
      </column>
      <column caption='Incremental Scenario' datatype='boolean' name='[Incremental Profit per Order (copy)_1870401270532210714]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Diff Profit per Order (copy)_1870401270532104217]&gt;0' />
      </column>
      <column caption='Recoup Scenario' datatype='boolean' name='[Incremental Scenario (copy)_1370783192847388687]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Recoup ROI (copy)_1870401270586212399]&lt;[Recoup (copy)_1370783192848003088]' />
      </column>
      <column caption='Investment Calculation (short)' datatype='string' name='[Investment Calculation (copy)_1057501545563615245]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1870401270551588899] = &apos;CPiO&apos; THEN&#13;&#10;&#13;&#10;&quot;Theoretical Revenue - Actual Revenue&quot;&#13;&#10;&#13;&#10;ELSEIF [Calculation_1870401270551588899] = &apos;PPOL&apos; THEN&#13;&#10;&#13;&#10;&quot;Actual Revenue - Theoretical Revenue&quot;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Confidence Calculation' datatype='string' name='[Investment Calculation (copy)_1057501546288246834]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;%iOrders - %iOrders Breakeven&apos;' />
      </column>
      <column caption='FLGP Calculation' datatype='string' name='[Investment Calculation (copy)_1870401270580719661]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Orders × Adj FLGPO&quot;' />
      </column>
      <column caption='Not PPOL' datatype='boolean' name='[Is PPOL (copy)_1057501545564753934]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='NOT [Calculation_1870401270524358662] = &apos;PPOL - Profit per Order Lost&apos;' />
      </column>
      <column caption='Is CPiO' datatype='boolean' name='[Is PPOL (copy)_1057501545601679375]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1870401270524358662] = &apos;CPiO - Cost per Incremental Order&apos;' />
      </column>
      <column caption='Not Trade-off' datatype='boolean' name='[Is Trade-off (copy)_1057501545561923596]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1870401270524358662] &lt;&gt; &apos;CPiO - Cost per Incremental Order&apos; AND [Calculation_1870401270524358662] &lt;&gt; &apos;PPOL - Profit per Order Lost&apos;' />
      </column>
      <column caption='Is PPOL' datatype='boolean' name='[Is Trade-off (copy)_1835216898843955226]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1870401270524358662] = &apos;PPOL - Profit per Order Lost&apos;' />
      </column>
      <column caption='Upper Orders base' datatype='real' default-format='n#,##0;-#,##0' name='[Lower Orders ctrl (copy)_1057501546252664874]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM((1 + [Parameters].[New customer orders (copy)] / 100) * [Calculation_1870401270522667009])' />
      </column>
      <column caption='Lower Orders base' datatype='real' default-format='n#,##0;-#,##0' name='[Lower Orders var (copy)_1057501546247397412]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM((1 - [Parameters].[New customer orders (copy)] / 100) * [Calculation_1870401270522667009])' />
      </column>
      <column caption='Upper Orders var' datatype='real' default-format='n#,##0;-#,##0' name='[Lower Orders var (copy)_1057501546252062761]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM((1 + [Parameters].[New customer orders (copy)] / 100) * [Calculation_1870401270522822658])' />
      </column>
      <column caption='Mean B    ' datatype='real' name='[Mean A (copy)_2958865021026353153]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([upper_bound_b]+[lower_bound_b])/2' />
      </column>
      <column caption='FLGP base' datatype='real' default-format='n#,##0;-#,##0' name='[Orders Control (copy)_1870401270523924484]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1870401270522667009] * [Profit Control (copy)_1870401270530695186]' />
      </column>
      <column caption='FLGP var' datatype='real' default-format='n#,##0;-#,##0' name='[Orders Variation (copy)_1870401270523924485]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1870401270522822658] * [Profit Variation (copy)_1870401270530695187]' />
      </column>
      <column caption='Orders var (simple)' datatype='real' name='[Orders base (simple) (copy)_7035115223929688089]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([raw_orders_variation] * IFNULL([users_base] / [users_variation],1))' />
      </column>
      <column caption='FLGPO base' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Profit Control (copy)_1870401270530695186 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([flgpo_local_base] * IF [Parameters].[Parameter 10] THEN 1 ELSE [fx] END * [raw_orders_base]) / SUM([raw_orders_base])&#13;&#10;+ [Calculation_392094705004056583] - [Calculation_2015923848727113784]' />
      </column>
      <column caption='Adj FLGPO base' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Profit Control (copy)_1870401270530695186]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Parameters].[Parameter 5] + ([Parameters].[Current Profit per Order (copy)_1835216898774908933] - [Parameters].[Parameter 8])' />
      </column>
      <column caption='FLGPO var' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Profit Variation (copy)_1870401270530695187 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([flgpo_local_variation] * IF [Parameters].[Parameter 10] THEN 1 ELSE [fx] END * [raw_orders_variation]) / SUM([raw_orders_variation])&#13;&#10;+ [Calculation_392094705004056583] - [Calculation_2015923848727113784]' />
      </column>
      <column caption='Adj FLGPO var' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Profit Variation (copy)_1870401270530695187]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Parameters].[Profit per Order Control (copy)_1870401270523674627] + ([Parameters].[Current Profit per Order (copy)_1835216898774908933] - [Parameters].[Parameter 8])' />
      </column>
      <column caption='Recoup ROI' datatype='real' default-format='*#,##0.0%;-#,##0.0%;#,##0.0%' name='[ROI (copy)_1870401270585368622]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Recoup ROI (copy)_1870401270637305906] / [Recoup ROI numerator (copy)_1870401270586753072]' />
      </column>
      <column caption='Recoup ROI Calculation' datatype='string' name='[ROI Calculation (copy)_2015923848776048738]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1870401270551588899] = &apos;PPOL&apos; THEN&#13;&#10;&#13;&#10;&quot;FLGPO var ÷ PPOL - 1&quot;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Return Description' datatype='string' name='[ROI Description (copy)_1057501545535328263]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;The total FLGP (Fully Loaded Gross Profit) in excess generated by the Variation analyzed vs Control.&quot;' />
      </column>
      <column caption='Confidence above cap' datatype='boolean' name='[ROI above cap (copy)_1057501545981546523]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1057501545606950928] &gt;= [Parameters].[New customer orders (copy)]' />
      </column>
      <column caption='Range Orders base' datatype='real' default-format='n#,##0;-#,##0' name='[Range Orders var (copy)_1057501546247221283]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Parameters].[New customer orders (copy)] / 100 * [Calculation_1870401270522667009])' />
      </column>
      <column caption='Features tested' datatype='string' name='[Raw Label (copy)_557883429000818695]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Label Generator&#13;&#10;TRIM(&#13;&#10;    IF [is_basket_value_test] THEN &quot; Basket Value&quot; ELSE &quot;&quot; END&#13;&#10;    + IF [is_fleet_delay_test] THEN &quot; Surge&quot; ELSE &quot;&quot; END&#13;&#10;    + IF [is_mov_delay_test] THEN &quot; MOV/SBF&quot; ELSE &quot;&quot; END&#13;&#10;    + IF [is_service_fee_test] THEN &quot; SF&quot; ELSE &quot;&quot; END&#13;&#10;    + IF [is_travel_time_test] THEN &quot; DBF&quot; ELSE &quot;&quot; END&#13;&#10;)' />
      </column>
      <column caption='Recoup Cap' datatype='real' default-format='n#,##0;-#,##0' name='[Recoup (copy)_1370783192848003088]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Recoup ROI numerator (copy)_1870401270586753072] * (1+[Parameters].[Parameter 12])' />
      </column>
      <column caption='iOrders Recoup Cost' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Recoup ROI (copy)_1870401270586212399]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1870401270524358662] = &apos;PPOL - Profit per Order Lost&apos;&#13;&#10;THEN - ([Calculation_1870401270525657095] * ([Parameters].[Profit per Order Control (copy)_1870401270523674627] + [Parameters].[Current Profit per Order (copy)_1835216898774908933] - [Parameters].[Parameter 8]))&#13;&#10;//ELSEIF [Scenario] IN (&apos;CPiO - Costly Orders&apos;)&#13;&#10;//THEN ([Diff Orders] * [FLGPO Control])&#13;&#10;END' />
      </column>
      <column caption='Recoup Investment Required' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Recoup ROI (copy)_1870401270637305906]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Recoup ROI (copy)_1870401270586212399] - [Recoup ROI numerator (copy)_1870401270586753072]' />
      </column>
      <column caption='Trade-off Description' datatype='string' name='[Recoup ROI Description (copy)_1057501545516158980]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1870401270551588899] = &apos;CPiO&apos; THEN&#13;&#10;&#13;&#10;&quot;CPiO shows how much FLGP was invested for each additional order produced.&#13;&#10;The calculation is adjusted to make sure the Pricing impact is diluted when margins go down.&quot;&#13;&#10;&#13;&#10;ELSEIF [Calculation_1870401270551588899] = &apos;PPOL&apos; THEN&#13;&#10;&#13;&#10;&quot;PPOL shows how much extra FLGP was gained for each order lost.&quot;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Recoup Description' datatype='string' name='[Recoup ROI Description (copy)_1057501545548705802]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;A higher Recoup Investment Required means that we need to invest more of the incremental margin generated by the higher FLGPO in variation to recuperate the orders lost.&#13;&#10;This check is important to see if we could sustain the same order volume level using other growth levers.&#13;&#10;If the iOrders Recoup Cost is above the indicated Cap, this means that we don&apos;t have other levers to recuperate the orders lost without spending more than the Extra Margin generated.&#13;&#10;&#13;&#10;&quot;' />
      </column>
      <column caption='Adj FLGPO Description' datatype='string' name='[Recoup ROI Description (copy)_1057501547364393016]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;We want to estimate our Pricing experiments long-term ROI.&#13;&#10;For that, we need to project what we expect not just our present but the future FLGPO to be.&#13;&#10;The delta between the current FLGPO and the targeted FLGPO can be used to show by how much we expect our baseline to grow. &#13;&#10;Adding this to our FLGPO results in higher and more future-oriented baselines, and more conservative ROIs as a result.&#13;&#10;This is especially useful in the context of areas where we might still be operating with negative or close to zero margins.&#13;&#10;&quot;' />
      </column>
      <column caption='iFLGPO Extra Margin' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Recoup ROI numerator (copy)_1870401270586753072]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1870401270524358662] = &apos;PPOL - Profit per Order Lost&apos;&#13;&#10;THEN ([Diff Profit (copy)_1870401270531072021] * [Calculation_1870401270522822658])&#13;&#10;//ELSEIF [Scenario] IN (&apos;CPiO - Costly Orders&apos;)&#13;&#10;//THEN - ([iFLGPO] * [Orders Control])&#13;&#10;END' />
      </column>
      <column caption='Trade-off better than Target FLGPO' datatype='boolean' name='[Recoup ROI under Cap (copy)_1370783192837885966]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1870401270524358662] = &apos;PPOL - Profit per Order Lost&apos;&#13;&#10;THEN [Calculation_1870401270547955742] &gt; [Parameters].[Current Profit per Order (copy)_1835216898774908933]&#13;&#10;&#13;&#10;ELSEIF [Calculation_1870401270524358662] = &apos;CPiO - Cost per Incremental Order&apos;&#13;&#10;THEN [Calculation_1870401270547955742] &lt; [Parameters].[Current Profit per Order (copy)_1835216898774908933] / (1 + [Parameters].[Parameter 11])&#13;&#10;&#13;&#10;END' />
        <aliases>
          <alias key='%null%' value=' ' />
        </aliases>
      </column>
      <column caption='Recoup ROI under Cap (simple)' datatype='boolean' name='[Recoup ROI under Cap (copy)_7035115223933726758]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_7035115223930146844] = &apos;PPOL&apos;&#13;&#10;THEN [Cum Recoup ROI (calc) (copy)_7035115223933509669] &lt; AVG([recoup_roi_cap])&#13;&#10;END' />
        <aliases>
          <alias key='%null%' value=' ' />
        </aliases>
      </column>
      <column caption='Acceptable Delta Description' datatype='string' name='[Return Description (copy)_1057501547467022398]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;The reference lines indicate the respective incrementality required, assuming order or volume constant, to achieve a ROI equal to the ROI threshold:&#13;&#10;&#13;&#10;Acceptable Delta (%iOrders)= Adj FLGPO base ÷ (Adj FLGPO base + iFLGPO × (1 + ROI threshold)) - 1&#13;&#10;Acceptable Delta (%iFLGPO) = -iOrders ÷ (Orders var scaled × (1 + ROI threshold)) - 1&quot;' />
      </column>
      <column caption='Actual Revenue' datatype='real' default-format='n#,##0;-#,##0' name='[Scenario Var (copy)_1870401270554787877]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1870401270524358662] = &apos;CPiO - Cost per Incremental Order&apos;&#13;&#10;THEN [Orders Variation (copy)_1870401270523924485]&#13;&#10;ELSEIF [Calculation_1870401270524358662] = &apos;PPOL - Profit per Order Lost&apos;&#13;&#10;THEN [Orders Control (copy)_1870401270523924484]&#13;&#10;END' />
      </column>
      <column caption='Cum Target FLGPO' datatype='real' name='[Target FLGPO (copy)_777433908330737707]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([flgpo_target_eur] / IF [Parameters].[Parameter 10] THEN [fx] ELSE 1 END)' />
      </column>
      <column caption='Conditions' datatype='string' name='[Targeting (copy)_557883429001068552]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='TRIM(&#13;&#10;    IF [has_time_condition] THEN &quot; Time&quot; ELSE &quot;&quot; END&#13;&#10;    + IF [has_customer_condition] THEN &quot; Customer&quot; ELSE &quot;&quot; END&#13;&#10;    + IF [has_location_condition] THEN &quot; Location&quot; ELSE &quot;&quot; END&#13;&#10;)' />
      </column>
      <column caption='Cum Trade-off' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Trade-off (copy)_777433908172701705]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([variant]) = ATTR([base]) THEN NULL&#13;&#10;ELSEIF [Cum Trade-off (copy)_777433908608811096] * AVG(IF [Parameters].[Parameter 10] THEN [fx] ELSE 1 END) &gt; 100 THEN 100 * AVG(IF [Parameters].[Parameter 10] THEN [fx] ELSE 1 END)&#13;&#10;ELSEIF [Cum Trade-off (copy)_777433908608811096] * AVG(IF [Parameters].[Parameter 10] THEN [fx] ELSE 1 END) &lt; -100 THEN -100 * AVG(IF [Parameters].[Parameter 10] THEN [fx] ELSE 1 END)&#13;&#10;ELSE [Cum Trade-off (copy)_777433908608811096] &#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='ROI Calculation' datatype='string' name='[Trade-off Calculation (copy)_2015923848775114849]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1870401270551588899] = &apos;CPiO&apos; THEN&#13;&#10;&#13;&#10;&quot;FLGPO base ÷ CPiO - 1&quot;&#13;&#10;&#13;&#10;ELSEIF [Calculation_1870401270551588899] = &apos;PPOL&apos; THEN&#13;&#10;&#13;&#10;&quot;(PPOL - FLGPO base) ÷ ABS(FLGPO base)&quot;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Trade-off Calculation' datatype='string' name='[Trade-off Description (copy)_1057501545522487301]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1870401270551588899] = &apos;CPiO&apos; THEN&#13;&#10;&#13;&#10;&quot;Orders var scaled × -iFLGPO (↓) ÷ iOrders (↑)&quot;&#13;&#10;&#13;&#10;ELSEIF [Calculation_1870401270551588899] = &apos;PPOL&apos; THEN&#13;&#10;&#13;&#10;&quot;Orders var scaled × iFLGPO (↑) ÷ -iOrders (↓)&quot;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='ROI Description' datatype='string' name='[Trade-off Description (copy)_1057501545524379654]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;ROI indicates how much % we are gaining back from each € invested.&#13;&#10;&quot;&#13;&#10;+ &#13;&#10;IF [Calculation_1870401270551588899] = &quot;CPiO&quot; THEN&#13;&#10;&quot;Depending on the competitive landscape, investment in growth leading to negative returns might be accepted up to the ROI cap.&quot;&#13;&#10;ELSEIF [Calculation_1870401270551588899] = &quot;PPOL&quot; THEN&#13;&#10;&quot;Depending on the competitive landscape, investment in growth leading to negative returns might be accepted up to the ROI cap.&quot;&#13;&#10;//&quot;Negative ROIs in PPOL scenarios are not accepted.&quot;&#13;&#10;END' />
      </column>
      <column caption='Investment Description' datatype='string' name='[Trade-off Description (copy)_1057501545536573449]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1870401270551588899] = &apos;CPiO&apos; THEN&#13;&#10;&#13;&#10;&quot;To make Pricing comparable with other Marketing levers, we need to estimate an equivalent investment.&#13;&#10;If Pricing had no effect on gross margins (FLGPO base), but affected volume (Orders var scaled), the product would be a higher FLGP.&#13;&#10;Let&apos;s call it &apos;Theoretical Revenue&apos;. The difference between that and the &apos;Actual Revenue&apos;, is the respective investment that would keep FLGP unchanged.&#13;&#10;&quot;&#13;&#10;&#13;&#10;ELSEIF [Calculation_1870401270551588899] = &apos;PPOL&apos; THEN&#13;&#10;&#13;&#10;&quot;To make Pricing comparable with other Marketing levers, we need to estimate an equivalent investment.&#13;&#10;If Pricing had no effect on gross margins (FLGPO base), but affected volume (Orders var scaled), the product would be a lower FLGP.&#13;&#10;Let&apos;s call it &apos;Theoretical Revenue&apos;. The difference between the &apos;Actual Revenue&apos; and that, is the respective investment that would keep FLGP unchanged.&#13;&#10;&quot;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Confidence Description' datatype='string' name='[Trade-off Description (copy)_1057501546241372192]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1870401270551588899] = &apos;CPiO&apos; THEN&#13;&#10;&#13;&#10;&quot;The %iOrders estimation is subject to the experiment&apos;s underlying volatility.&#13;&#10;The range between the mean and the 95% boundaries of orders per user is our confidence interval.&#13;&#10;By subtracting the confidence interval from the %iOrders we get its lower boundary.&#13;&#10;If the %iOrders lower boundary is under the breakeven, this is flagged as a potential concern.&#13;&#10;&quot;&#13;&#10;&#13;&#10;//(SUM([orders_per_user_upper_variation] - [orders_per_user_mean_variation]) / SUM([orders_per_user_mean_ctrl])) * 100&#13;&#10;&#13;&#10;ELSEIF [Calculation_1870401270551588899] = &apos;PPOL&apos; THEN&#13;&#10;&#13;&#10;&quot;The %iFLGPO estimation is subject to the experiment&apos;s underlying volatility.&#13;&#10;The range between the mean and the 95% boundaries of FLGPO is our confidence interval.&#13;&#10;By subtracting the confidence interval from the %iFLGPO we get its lower boundary.&#13;&#10;If the %iFLGPO lower boundary is under the breakeven, this is flagged as a potential concern.&#13;&#10;&quot;&#13;&#10;END' />
      </column>
      <column caption='Target Description' datatype='string' name='[Trade-off Description (copy)_5789025521510633515]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1870401270551588899] = &apos;CPiO&apos; THEN&#13;&#10;&#13;&#10;&quot;For CPiO scenarios, this first check is adjusted based on the ROI threshold. Lower thresholds mean that the CPiO can be higher. That is, CPiO must be lower than Target Profit ÷ (1 + ROI threshold).&quot;&#13;&#10;&#13;&#10;ELSEIF [Calculation_1870401270551588899] = &apos;PPOL&apos; THEN&#13;&#10;&#13;&#10;NULL&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Trade-off better than Target FLGPO (simple)' datatype='boolean' name='[Trade-off better than Target FLGPO (copy)_7035115223932715044]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_7035115223930146844] = &apos;PPOL&apos;&#13;&#10;THEN [Cum Trade-off (calc) (copy)_7035115223931142174] &gt; [Target FLGPO (copy)_777433908330737707]&#13;&#10;&#13;&#10;ELSEIF [Calculation_7035115223930146844] = &apos;CPiO&apos;&#13;&#10;THEN [Cum Trade-off (calc) (copy)_7035115223931142174] &lt; [Target FLGPO (copy)_777433908330737707] / AVG(1 + [roi_threshold])&#13;&#10;&#13;&#10;ELSEIF [Calculation_7035115223930146844] = &apos;Win-Win&apos;&#13;&#10;THEN TRUE&#13;&#10;&#13;&#10;ELSEIF [Calculation_7035115223930146844] = &apos;Lose-Lose&apos;&#13;&#10;THEN FALSE&#13;&#10;&#13;&#10;END' />
        <aliases>
          <alias key='%null%' value=' ' />
        </aliases>
      </column>
      <column caption='Lower Orders var' datatype='real' default-format='n#,##0;-#,##0' name='[Upper Orders var (copy)_1057501546246553634]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM((1 - [Parameters].[New customer orders (copy)] / 100) * [Calculation_1870401270522822658])' />
      </column>
