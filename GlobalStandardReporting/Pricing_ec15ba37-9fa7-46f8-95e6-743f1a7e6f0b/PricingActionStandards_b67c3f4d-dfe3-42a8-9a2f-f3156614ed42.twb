              <calculation class='tableau' formula='IF [Calculation_1870401270551588899] = &apos;CPiO&apos; THEN&#13;&#10;([Calculation_1870401270647291956]-[Calculation_1870401270664028216]) * 100&#13;&#10;&#13;&#10;//ELSEIF [Trade-off Type] = &apos;PPOL&apos; THEN&#13;&#10;//([%iFLGPO]-[Acceptable FLGPO Delta]) * 100&#13;&#10;&#13;&#10;END' />
