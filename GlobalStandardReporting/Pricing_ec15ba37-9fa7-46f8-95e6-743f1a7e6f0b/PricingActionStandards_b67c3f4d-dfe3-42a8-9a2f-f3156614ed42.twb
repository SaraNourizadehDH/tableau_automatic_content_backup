              <calculation class='tableau' formula='172462' />
            </column>
            <column caption='Users var' datatype='integer' name='[Parameter 4]' param-domain-type='any' role='measure' type='quantitative' value='172812'>
              <calculation class='tableau' formula='172812' />
            </column>
            <column caption='FLGPO base' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Parameter 5]' param-domain-type='any' role='measure' type='quantitative' value='0.69799914902887505'>
              <calculation class='tableau' formula='0.69799914902887505' />
            </column>
            <column caption='Current FLGPO' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Parameter 8]' param-domain-type='any' role='measure' type='quantitative' value='0.91182344974521223'>
              <calculation class='tableau' formula='0.91182344974521223' />
            </column>
            <column caption='FX' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Parameter 9]' param-domain-type='any' role='measure' type='quantitative' value='0.93472836400000003'>
              <calculation class='tableau' formula='0.93472836400000003' />
            </column>
            <column caption='FLGPO var' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Profit per Order Control (copy)_1870401270523674627]' param-domain-type='any' role='measure' type='quantitative' value='0.65615519843532288'>
              <calculation class='tableau' formula='0.65615519843532288' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ffq3c01pfytq912okfuq0p6iqcw'>
            <column caption='Confidence Interval var' datatype='real' name='[Calculation_1057501546229243934]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([orders_per_user_upper_variation]) / SUM([orders_per_user_mean_variation]) - 1) * 100' />
            </column>
            <column caption='FLGPO base test' datatype='real' name='[Calculation_1370783192542781443]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([flgpo_local_base] * IF [Parameters].[Parameter 10] THEN 1 ELSE [Parameters].[Parameter 9] END * [raw_orders_base]) / SUM([raw_orders_base])' />
            </column>
            <column caption='Sync status' datatype='boolean' name='[Calculation_1835216898788831243]' role='measure' type='nominal'>
              <calculation class='tableau' formula='ABS([Parameters].[Parameter 1] / SUM([raw_orders_base]) - 1&#13;&#10;+ [Parameters].[Parameter 2] / SUM([raw_orders_variation]) - 1&#13;&#10;+ [Parameters].[Parameter 9] / SUM([fx]) - 1&#13;&#10;+ [Parameters].[Parameter 5] / [Calculation_1370783192542781443] - 1&#13;&#10;+ [Parameters].[Profit per Order Control (copy)_1870401270523674627] / [FLGPO ctrl test (copy)_1370783192543096836] - 1&#13;&#10;+ [Parameters].[Parameter 8] / [Calculation_2015923848727113784] - 1&#13;&#10;+ [Parameters].[Current Profit per Order (copy)_1835216898774908933] / [Calculation_392094705004056583] - 1&#13;&#10;+ IFNULL([Parameters].[Parameter 3] / MIN(IFNULL([users_base],1000)) - 1, 0)&#13;&#10;+ IFNULL([Parameters].[Parameter 4] / MIN(IFNULL([users_variation],1000)) - 1, 0)&#13;&#10;//+ IF [Users base] = [Users var] THEN 1 ELSE 0 END&#13;&#10;)&#13;&#10;&lt; 0.001' />
              <aliases>
                <alias key='false' value='Unsynced' />
                <alias key='true' value='Synced' />
              </aliases>
            </column>
            <column caption='Status message' datatype='string' name='[Calculation_1835216898790174735]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1835216898788831243] THEN &apos;Loaded&apos; ELSE &apos;Click to sync&apos; END' />
            </column>
            <column caption='Current FLGPO' datatype='real' name='[Calculation_2015923848727113784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(&#13;&#10;SUM([analytical_profit]) / SUM([orders]) / AVG([fx]) * AVG(IF [Parameters].[Parameter 10] THEN 1 ELSE [Parameters].[Parameter 9] END),&#13;&#10;SUM([flgpo_local_base] * IF [Parameters].[Parameter 10] THEN 1 ELSE [Parameters].[Parameter 9] END * [raw_orders_base]) / SUM([raw_orders_base]))' />
            </column>
            <column caption='AVG(IFNULL([users_base],1000))' datatype='real' name='[Calculation_2492742418595172386]' role='measure' type='quantitative' user:unnamed='Experiment stats'>
              <calculation class='tableau' formula='AVG(IFNULL([users_base],1000))' />
            </column>
            <column caption='AVG(IFNULL([users_variation],1000))' datatype='real' name='[Calculation_2492742418595196963]' role='measure' type='quantitative' user:unnamed='Experiment stats'>
              <calculation class='tableau' formula='AVG(IFNULL([users_variation],1000))' />
            </column>
            <column caption='Target FLGPO' datatype='real' name='[Calculation_392094705004056583]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([flgpo_target_eur]) &#13;&#10;// / IF [Scenario] = &apos;CPiO - Cost per Incremental Order&apos; THEN (1 + [ROI threshold]) &#13;&#10;// ELSE 1 &#13;&#10;// END &#13;&#10;/ AVG([fx]) * AVG(IF [Parameters].[Parameter 10] THEN 1 ELSE [Parameters].[Parameter 9] END)' />
            </column>
            <column caption='FLGPO var test' datatype='real' name='[FLGPO ctrl test (copy)_1370783192543096836]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([flgpo_local_variation] * IF [Parameters].[Parameter 10] THEN 1 ELSE [Parameters].[Parameter 9] END * [raw_orders_variation]) / SUM([raw_orders_variation])' />
            </column>
