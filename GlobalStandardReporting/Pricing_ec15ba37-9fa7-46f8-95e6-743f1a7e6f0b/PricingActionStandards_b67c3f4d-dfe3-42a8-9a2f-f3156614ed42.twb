    <worksheet name='Cum Recoup ROI'>
      <layout-options>
        <title>
          <formatted-text>
            <run>&lt;Sheet Name&gt;</run>
            <run fontsize='10'> (for PPOL cases)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Calculator' name='federated.1ffq3c01pfytq912okfuq0p6iqcw' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Local' caption='Currency' datatype='boolean' name='[Parameter 10]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
              <aliases>
                <alias key='false' value='EUR' />
                <alias key='true' value='Local' />
              </aliases>
            </column>
            <column caption='Days to hide' datatype='integer' default-format='*# first days' name='[Parameter 7]' param-domain-type='any' role='measure' type='quantitative' value='7'>
              <calculation class='tableau' formula='7' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ffq3c01pfytq912okfuq0p6iqcw'>
            <column caption='Cum Daily Orders' datatype='real' name='[Calculation_3165467655504834579]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM([Calculation_3165467655504875540])/RUNNING_SUM(COUNTD([order_date]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Daily Orders' datatype='real' name='[Calculation_3165467655504875540]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([raw_orders]) * AVG(IFNULL([users_base] / [users_variation],1))' />
            </column>
            <column caption='Variation filter' datatype='boolean' name='[Calculation_777433908300435489]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[variation] = [variant]' />
            </column>
            <column caption='Base filter' datatype='boolean' name='[Calculation_777433908370559038]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[variant (daily_order_profitability1)] = [base]' />
            </column>
            <column caption='Test Day' datatype='integer' name='[Calculation_777433908574896212]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [test_start_date], [order_date])+1' />
            </column>
            <column caption='Days hidden' datatype='boolean' name='[Calculation_777433908611186778]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_777433908574896212] &gt; [Parameters].[Parameter 7]' />
            </column>
            <column caption='4 weeks' datatype='datetime' name='[Calculation_777433908613328991]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATEADD(&apos;day&apos;, 27, [test_start_date])' />
            </column>
            <column caption='Daily FLGPO' datatype='real' name='[Cum Daily FLGPO (copy)_3165467655506153494]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([flgpo_local] * IF [Parameters].[Parameter 10] THEN 1 ELSE [fx] END) + [Target FLGPO (copy)_777433908330737707] - [Current FLGPO (copy)_777433908330655786]' />
            </column>
            <column caption='Cum Daily iFLGPO' datatype='real' name='[Cum Daily FLGPO (copy)_777433908164034561]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM([Cum Daily FLGPO (copy)_3165467655506153494] * [Calculation_3165467655504875540]) / RUNNING_SUM([Calculation_3165467655504875540])&#13;&#10;- RUNNING_SUM([Daily FLGPO (copy)_777433908373418048] * [Daily Orders (copy)_777433908373418047]) / RUNNING_SUM([Daily Orders (copy)_777433908373418047])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Cum FLGPO' datatype='real' name='[Cum Daily FLGPO (copy)_777433908294172701]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM([Cum Daily FLGPO (copy)_3165467655506153494] * [Calculation_3165467655504875540]) / RUNNING_SUM([Calculation_3165467655504875540])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Cum Daily iOrders' datatype='real' name='[Cum Daily Orders (copy)_777433908169654276]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM([Daily Orders (copy)_777433908171206664])/RUNNING_SUM(COUNTD([order_date]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Cum Orders' datatype='real' name='[Cum Daily Orders (copy)_777433908178477074]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM([Calculation_3165467655504875540])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Cum FLGPO (Base)' datatype='real' name='[Cum FLGPO (copy)_777433908294344734]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM([Daily FLGPO (copy)_777433908373418048] * [Daily Orders (copy)_777433908373418047]) / RUNNING_SUM([Daily Orders (copy)_777433908373418047])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Cum Orders (Base)' datatype='integer' name='[Cum Orders (copy)_777433908293885980]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM([Daily Orders (copy)_777433908373418047])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Cum Recoup ROI (calc)' datatype='real' default-format='p0.0%' name='[Cum ROI (calc) (copy)_777433908592967765]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Cum ROI (copy) (copy)_777433908302905381]&#13;&#10;WHEN &apos;PPOL&apos; THEN [Cum Daily FLGPO (copy)_777433908294172701] / [Cum Trade-off (copy)_777433908608811096] - 1&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Cum Trade-off Type' datatype='string' default-format='p0.0%' name='[Cum ROI (copy) (copy)_777433908302905381]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ATTR([variant]) = ATTR([base]) THEN NULL // No trade-off for Base&#13;&#10;ELSEIF [Cum Daily Orders (copy)_777433908178477074] &gt;= [Cum Orders (copy)_777433908293885980] AND [Cum Daily FLGPO (copy)_777433908294172701] &gt;=  [Cum FLGPO (copy)_777433908294344734] THEN &apos;Win-Win&apos;&#13;&#10;ELSEIF [Cum Daily Orders (copy)_777433908178477074] &lt;= [Cum Orders (copy)_777433908293885980] AND [Cum Daily FLGPO (copy)_777433908294172701] &lt;=  [Cum FLGPO (copy)_777433908294344734] THEN &apos;Lose-Lose&apos;&#13;&#10;ELSEIF [Cum Daily Orders (copy)_777433908178477074] &gt; [Cum Orders (copy)_777433908293885980] AND [Cum Daily FLGPO (copy)_777433908294172701] &lt; [Cum FLGPO (copy)_777433908294344734] THEN &apos;CPiO&apos;&#13;&#10;ELSEIF [Cum Daily Orders (copy)_777433908178477074] &lt; [Cum Orders (copy)_777433908293885980] AND [Cum Daily FLGPO (copy)_777433908294172701] &gt; [Cum FLGPO (copy)_777433908294344734] THEN &apos;PPOL&apos;&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Cum Recoup ROI' datatype='real' default-format='p0.0%' name='[Cum Recoup ROI (calc) (copy)_777433908594577494]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Cum ROI (calc) (copy)_777433908592967765] &gt; 10 THEN 10&#13;&#10;ELSEIF [Cum ROI (calc) (copy)_777433908592967765] &lt; -10 THEN -10&#13;&#10;ELSE [Cum ROI (calc) (copy)_777433908592967765]&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Cum Trade-off (calc)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Cum Trade-off (copy)_777433908608811096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Cum ROI (copy) (copy)_777433908302905381]&#13;&#10;WHEN &apos;Win-Win&apos; THEN AVG(100 / IF [Parameters].[Parameter 10] THEN [fx] ELSE 1 END)&#13;&#10;WHEN &apos;Lose-Lose&apos; THEN AVG(-100 / IF [Parameters].[Parameter 10] THEN [fx] ELSE 1 END)&#13;&#10;WHEN &apos;CPiO&apos; THEN [Cum Daily FLGPO (copy)_777433908164034561] * [Calculation_3165467655504834579] / - [Cum Daily Orders (copy)_777433908169654276]&#13;&#10;WHEN &apos;PPOL&apos; THEN [Cum Daily FLGPO (copy)_777433908164034561] * [Calculation_3165467655504834579] / - [Cum Daily Orders (copy)_777433908169654276]&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Cum Current FLGPO' datatype='real' name='[Current FLGPO (copy)_777433908330655786]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(&#13;&#10;SUM([analytical_profit] / IF [Parameters].[Parameter 10] THEN [fx] ELSE 1 END) / SUM([orders]),&#13;&#10;SUM([flgpo_local_base] * IF [Parameters].[Parameter 10] THEN 1 ELSE [fx] END * [raw_orders_base]) &#13;&#10;/ SUM([raw_orders_base]))' />
            </column>
            <column caption='Daily FLGPO (Base)' datatype='real' name='[Daily FLGPO (copy)_777433908373418048]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([flgpo_local (daily_order_profitability1)] * IF [Parameters].[Parameter 10] THEN 1 ELSE [fx] END) + [Target FLGPO (copy)_777433908330737707] - [Current FLGPO (copy)_777433908330655786]' />
            </column>
            <column caption='Daily iOrders' datatype='real' name='[Daily Orders (copy)_777433908171206664]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3165467655504875540] - [Daily Orders (copy)_777433908373418047]' />
            </column>
            <column caption='Daily Orders (Base)' datatype='integer' name='[Daily Orders (copy)_777433908373418047]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([raw_orders (daily_order_profitability1)])' />
            </column>
            <column caption='Cum Target FLGPO' datatype='real' name='[Target FLGPO (copy)_777433908330737707]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([flgpo_target_eur] / IF [Parameters].[Parameter 10] THEN [fx] ELSE 1 END)' />
