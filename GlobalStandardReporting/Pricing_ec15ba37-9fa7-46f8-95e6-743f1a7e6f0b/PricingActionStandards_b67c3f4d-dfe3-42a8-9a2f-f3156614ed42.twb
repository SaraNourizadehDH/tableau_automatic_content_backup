            <column datatype='integer' name='[raw_orders_variation]' role='measure' type='quantitative' />
            <column caption='Region' datatype='string' name='[region]' role='dimension' type='nominal' />
            <column caption='Roi Threshold' datatype='real' default-format='p0.0%' name='[roi_threshold]' role='measure' type='quantitative' />
