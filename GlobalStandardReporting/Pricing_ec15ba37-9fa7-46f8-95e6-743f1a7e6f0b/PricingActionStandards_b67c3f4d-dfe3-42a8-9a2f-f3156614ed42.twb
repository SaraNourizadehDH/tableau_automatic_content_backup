    <worksheet name='Recoup ROI under cap (summary)'>
      <repository-location id='RecoupROIundercap2' path='/t/GlobalStandardReporting/workbooks/ROIsimulator' revision='' site='GlobalStandardReporting' />
      <table>
        <view>
          <datasources>
            <datasource caption='Calculator' name='federated.1ffq3c01pfytq912okfuq0p6iqcw' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Local' caption='Currency' datatype='boolean' name='[Parameter 10]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
              <aliases>
                <alias key='false' value='EUR' />
                <alias key='true' value='Local' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ffq3c01pfytq912okfuq0p6iqcw'>
            <column caption='&apos;Recoup ROI&apos;' datatype='string' name='[Calculation_2492742418528636937]' role='dimension' type='nominal' user:unnamed='Recoup ROI under cap (2)'>
              <calculation class='tableau' formula='&apos;Recoup ROI&apos;' />
            </column>
            <column caption='FLGPO base (simple)' datatype='real' name='[Calculation_7035115223926898710]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([flgpo_local_base] * IF [Parameters].[Parameter 10] THEN 1 ELSE [fx] END * [raw_orders_base])&#10;/ SUM([raw_orders_base])&#10;+ [Target FLGPO (copy)_777433908330737707] - [Current FLGPO (copy)_777433908330655786]' />
            </column>
            <column caption='Trade-off Type (simple)' datatype='string' name='[Calculation_7035115223930146844]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ATTR([variation]) = ATTR([base]) THEN NULL // No trade-off for Base&#10;ELSEIF [Orders base (simple) (copy)_7035115223929688089] &gt;= [FLGPO base (simple) (copy)_7035115223929380888] AND [FLGPO base (simple) (copy)_7035115223927529495] &gt;=  [Calculation_7035115223926898710] THEN &apos;Win-Win&apos;&#10;ELSEIF [Orders base (simple) (copy)_7035115223929688089] &lt;= [FLGPO base (simple) (copy)_7035115223929380888] AND [FLGPO base (simple) (copy)_7035115223927529495] &lt;=  [Calculation_7035115223926898710] THEN &apos;Lose-Lose&apos;&#10;ELSEIF [Orders base (simple) (copy)_7035115223929688089] &gt; [FLGPO base (simple) (copy)_7035115223929380888] AND [FLGPO base (simple) (copy)_7035115223927529495] &lt; [Calculation_7035115223926898710] THEN &apos;CPiO&apos;&#10;ELSEIF [Orders base (simple) (copy)_7035115223929688089] &lt; [FLGPO base (simple) (copy)_7035115223929380888] AND [FLGPO base (simple) (copy)_7035115223927529495] &gt; [Calculation_7035115223926898710] THEN &apos;PPOL&apos;&#10;END' />
            </column>
            <column caption='iFLGPO (simple)' datatype='real' name='[Calculation_7035115223931449376]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[FLGPO base (simple) (copy)_7035115223927529495]-[Calculation_7035115223926898710]' />
            </column>
            <column caption='iOrders (simple)' datatype='real' name='[Calculation_7035115223931527201]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Orders base (simple) (copy)_7035115223929688089]-[FLGPO base (simple) (copy)_7035115223929380888]' />
            </column>
            <column caption='Variation filter' datatype='boolean' name='[Calculation_777433908300435489]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[variation] = [variant]' />
            </column>
            <column caption='Base filter' datatype='boolean' name='[Calculation_777433908370559038]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[variant (daily_order_profitability1)] = [base]' />
            </column>
            <column caption='Recoup ROI (calc) (simple)' datatype='real' default-format='p0.0%' name='[Cum Recoup ROI (calc) (copy)_7035115223933509669]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Calculation_7035115223930146844]&#13;&#10;WHEN &apos;PPOL&apos; THEN [FLGPO base (simple) (copy)_7035115223927529495] / [Cum Trade-off (calc) (copy)_7035115223931142174] - 1&#13;&#10;END' />
            </column>
            <column caption='Trade-off (calc) (simple)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Cum Trade-off (calc) (copy)_7035115223931142174]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Calculation_7035115223930146844]&#13;&#10;WHEN &apos;Win-Win&apos; THEN AVG(100 / IF [Parameters].[Parameter 10] THEN [fx] ELSE 1 END)&#13;&#10;WHEN &apos;Lose-Lose&apos; THEN AVG(-100 / IF [Parameters].[Parameter 10] THEN [fx] ELSE 1 END)&#13;&#10;WHEN &apos;CPiO&apos; THEN [Calculation_7035115223931449376] * [Orders base (simple) (copy)_7035115223929688089] / - [Calculation_7035115223931527201]&#13;&#10;WHEN &apos;PPOL&apos; THEN [Calculation_7035115223931449376] * [Orders base (simple) (copy)_7035115223929688089] / - [Calculation_7035115223931527201]&#13;&#10;END' />
            </column>
            <column caption='Cum Current FLGPO' datatype='real' name='[Current FLGPO (copy)_777433908330655786]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(&#13;&#10;SUM([analytical_profit] / IF [Parameters].[Parameter 10] THEN [fx] ELSE 1 END) / SUM([orders]),&#13;&#10;SUM([flgpo_local_base] * IF [Parameters].[Parameter 10] THEN 1 ELSE [fx] END * [raw_orders_base]) &#13;&#10;/ SUM([raw_orders_base]))' />
            </column>
            <column caption='FLGPO var (simple)' datatype='real' name='[FLGPO base (simple) (copy)_7035115223927529495]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([flgpo_local_variation] &#10;* IF [Parameters].[Parameter 10] THEN 1 ELSE [fx] END &#10;* [raw_orders_variation])&#10;/ SUM([raw_orders_variation])&#10;+ [Target FLGPO (copy)_777433908330737707] - [Current FLGPO (copy)_777433908330655786]' />
            </column>
            <column caption='Orders base (simple)' datatype='integer' name='[FLGPO base (simple) (copy)_7035115223929380888]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([raw_orders_base])' />
            </column>
            <column caption='Orders var (simple)' datatype='real' name='[Orders base (simple) (copy)_7035115223929688089]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([raw_orders_variation] * IFNULL([users_base] / [users_variation],1))' />
            </column>
            <column caption='Recoup ROI under Cap (simple)' datatype='boolean' name='[Recoup ROI under Cap (copy)_7035115223933726758]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_7035115223930146844] = &apos;PPOL&apos;&#13;&#10;THEN [Cum Recoup ROI (calc) (copy)_7035115223933509669] &lt; AVG([recoup_roi_cap])&#13;&#10;END' />
              <aliases>
                <alias key='%null%' value=' ' />
              </aliases>
            </column>
            <column caption='Cum Target FLGPO' datatype='real' name='[Target FLGPO (copy)_777433908330737707]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([flgpo_target_eur] / IF [Parameters].[Parameter 10] THEN [fx] ELSE 1 END)' />
            </column>
            <column datatype='real' name='[analytical_profit]' role='measure' type='quantitative' />
            <column caption='Base' datatype='string' name='[base]' role='dimension' type='nominal' user:SplitFieldIndex='1' user:SplitFieldOrigin='[federated.1ffq3c01pfytq912okfuq0p6iqcw (copy)].[variation]' />
            <column caption='Brand' datatype='string' name='[brand]' role='dimension' type='nominal' />
            <column datatype='string' name='[data_source]' role='dimension' type='nominal' />
            <column caption='Entity Id' datatype='string' name='[entity_id]' role='dimension' type='nominal' />
