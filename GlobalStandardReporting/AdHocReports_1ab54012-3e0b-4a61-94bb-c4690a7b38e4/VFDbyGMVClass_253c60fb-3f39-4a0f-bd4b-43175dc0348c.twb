          <named-connection caption='BigQuery' name='bigquery.0bm9x481ut59z91gttvzq1mylzw0'>
            <connection CATALOG='dhh-ncr-stg' EXECCATALOG='dhh-ncr-stg' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='dhh-ncr-stg' schema='dev_sales_revenue' server-oauth='' username='yexi.yuan@foodpanda.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0bm9x481ut59z91gttvzq1mylzw0' name='Custom SQL Query' type='text'>WITH entity AS (
  SELECT
    management_entity
    ,segment
    ,country_name
    ,sub_entity
    ,brand_name
    ,global_entity_id
    ,SPLIT(global_entity_id, &apos;_&apos;)[OFFSET(1)] country_code
  FROM `fulfillment-dwh-production.curated_data_shared_coredata.global_entities`
  WHERE is_entity_online = TRUE
    AND management_entity NOT IN (&apos;Instashop&apos;, &apos;Zomato&apos;, &apos;Woowa&apos;)
)

, incentives AS (
  SELECT 
    global_entity_id
    , DATE_TRUNC(DATE(order_placed_at), MONTH) order_month
    , order_vendor_id
    , COUNT(order_id) inct_order_count
    , SUM(order_value.gmv_eur) inct_gmv_eur
    , SUM(order_value.gbv_eur) inct_gbv_eur
    , SUM(SAFE_DIVIDE(total_incentive_value_local, order_fx_rate_eur)) total_incentive_value_eur
    , SUM(SAFE_DIVIDE(sponsor_value_local_vendor, order_fx_rate_eur)) vendor_funded_value_eur

    , COUNT(CASE WHEN is_self_service THEN order_id END) ss_inct_order_count
    , SUM(CASE WHEN is_self_service THEN order_value.gmv_eur END) ss_inct_gmv_eur
    , SUM(CASE WHEN is_self_service THEN order_value.gbv_eur END) ss_inct_gbv_eur
    , SUM(CASE WHEN is_self_service THEN SAFE_DIVIDE(sponsor_value_local_vendor, order_fx_rate_eur) END) ss_vendor_funded_value_eur
  FROM `fulfillment-dwh-production.cl_sales_revenue.customer_incentive_transactions` 
  WHERE transaction_date &gt;&gt;= &quot;2023-01-01&quot;
  GROUP BY 1,2,3
)

, vendor_class AS (
  SELECT
    global_entity_id
    , vendor_id
    , report_month
    , vendor_class
  FROM `fulfillment-dwh-production.curated_data_shared_coredata_business.agg_vendor_kpis_monthly`
  WHERE is_online
    AND report_month &gt;&gt;= &apos;2023-01-01&apos;
)

, inct_vendor_class AS (
  SELECT
    ven.vendor_class
    , ven.vendor_id
    , ven.global_entity_id
    , ven.report_month
    , inct.inct_order_count
    , inct.inct_gbv_eur
    , inct.vendor_funded_value_eur
    , inct.ss_inct_order_count
    , inct.ss_inct_gbv_eur
    , inct.ss_vendor_funded_value_eur
  FROM vendor_class ven
    LEFT JOIN incentives inct 
      ON ven.vendor_id = inct.order_vendor_id
      AND ven.global_entity_id = inct.global_entity_id
      AND ven.report_month = inct.order_month
) 

SELECT
  report_month
  , global_entity_id
  , vendor_class
  , MAX(management_entity) management_entity
  , MAX(brand_name) brand_name
  , MAX(sub_entity) sub_entity

  , COUNT(vendor_id) total_vendor_count
  
  , COUNT(CASE WHEN vendor_funded_value_eur &gt;&gt; 0 THEN vendor_id END) vfd_vendor_count
  , SUM(inct_order_count) inct_order_count
  , SUM(inct_gbv_eur) inct_gbv_eur
  , SUM(vendor_funded_value_eur) vendor_funded_value_eur

  , COUNT(CASE WHEN ss_vendor_funded_value_eur &gt;&gt; 0 THEN vendor_id END) ss_vfd_vendor_count
  , SUM(ss_inct_order_count) ss_inct_order_count
  , SUM(ss_inct_gbv_eur) ss_inct_gbv_eur
  , SUM(ss_vendor_funded_value_eur) ss_vendor_funded_value_eur
FROM inct_vendor_class
  INNER JOIN entity USING(global_entity_id)
GROUP BY 1,2,3</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
