    <worksheet name='Savings/GMV'>
      <layout-options>
        <title>
          <formatted-text>
            <run>&lt;Sheet Name&gt;&#10;</run>
            <run fontsize='10'>Global KA have less coverage with incentives, because most of incentives are item-level.</run>
            <run>Æ&#10;</run>
            <run fontsize='10'>And they are more cofunded by DH. </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='vdata_5571_incentives (snadira)' name='federated.0ezqd3u10uhb0p1g7m9ym16phjva' />
          </datasources>
          <datasource-dependencies datasource='federated.0ezqd3u10uhb0p1g7m9ym16phjva'>
            <column caption='Brand' datatype='string' name='[Calculation_4670725447087185920]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [brand_name] = &apos;Talabat&apos; THEN &apos;Talabat&apos; ELSE &apos;Pandora&apos; END' />
            </column>
            <column caption='VFD / GMV' datatype='real' default-format='p0.0%' name='[Calculation_4670725447376359427]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([incentive_vendor_funded_amount_eur]) / sum([gmv])' />
            </column>
            <column caption='Cofunding: VFD / DH+VFD' datatype='real' default-format='p0.0%' name='[DH+VFD/GMV (copy)_4670725447377248261]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([incentive_vendor_funded_amount_eur]) / sum([incentive_amount_eur])' />
            </column>
            <column caption='Coverage: GMV With VFD / GMV' datatype='real' default-format='p0.0%' name='[Deal Depth: VFD/GMV With Incentives (copy)_4670725447389835274]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([gmv_with_incentives (vdata_5571_orders)]) / sum([gmv])' />
            </column>
            <column caption='Deal Depth: DH+VFD / GMV With VFD' datatype='real' default-format='p0.0%' name='[VFD/GMV (copy)_4670725447389675529]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([incentive_amount_eur]) / sum([gmv_with_incentives (vdata_5571_orders)])' />
            </column>
            <column caption='Brand Name ' datatype='string' name='[brand_name (vdata_5571_orders)]' role='dimension' type='nominal' />
            <column caption='Brand Name' datatype='string' name='[brand_name]' role='dimension' type='nominal' />
            <column caption='GMV' datatype='real' name='[gmv]' role='measure' type='quantitative' />
            <column caption='GMV With VFD' datatype='real' name='[gmv_with_incentives (vdata_5571_orders)]' role='measure' type='quantitative' />
            <column caption='DH+VFD Eur' datatype='real' name='[incentive_amount_eur]' role='measure' type='quantitative' />
            <column caption='VFD Eur' datatype='real' name='[incentive_vendor_funded_amount_eur]' role='measure' type='quantitative' />
            <column-instance column='[order_month]' derivation='Month' name='[mn:order_month:ok]' pivot='key' type='ordinal' />
