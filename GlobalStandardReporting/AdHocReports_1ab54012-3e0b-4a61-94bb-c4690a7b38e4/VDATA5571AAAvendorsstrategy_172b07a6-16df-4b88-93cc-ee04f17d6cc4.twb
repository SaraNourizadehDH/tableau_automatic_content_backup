      <aliases enabled='yes' />
      <column caption='Brand' datatype='string' name='[Calculation_4670725447087185920]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [brand_name] = &apos;Talabat&apos; THEN &apos;Talabat&apos; ELSE &apos;Pandora&apos; END' />
      </column>
      <column caption='VFD / GMV' datatype='real' default-format='p0.0%' name='[Calculation_4670725447376359427]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([incentive_vendor_funded_amount_eur]) / sum([gmv])' />
      </column>
      <column caption='AOV' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_4670725447381082118]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([gmv]) / sum([orders (vdata_5571_orders)])' />
      </column>
      <column caption='VFD Per Vendor' datatype='real' name='[Calculation_4670725447384510471]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([incentive_vendor_funded_amount_eur]) / sum([vendors_with_incentives (vdata_5571_orders)])' />
      </column>
      <column caption='Orders Per Vendor' datatype='real' name='[Calculation_4670725447385239560]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([orders (vdata_5571_orders)]) / sum([vendors (vdata_5571_orders)])' />
      </column>
      <column caption='VFD / Incentive Campaign' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_4670725447397879823]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([incentive_vendor_funded_amount_eur]) / sum([incentives])' />
      </column>
      <column caption='Coverage: Vendors With VFD / Vendors' datatype='real' default-format='p0.0%' name='[Coverage: GMV With VFD / GMV (copy)_6589751469913935872]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vendors_with_incentives (vdata_5571_orders)]) / sum([vendors (vdata_5571_orders)])' />
      </column>
      <column caption='Coverage: Orders With VFD / Orders' datatype='real' default-format='p0.0%' name='[Coverage: Vendors With VFD / Vendors (copy)_6589751469917052933]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([orders_with_incentives (vdata_5571_orders)]) / sum([orders (vdata_5571_orders)])' />
      </column>
      <column caption='Cofunding: VFD / DH+VFD' datatype='real' default-format='p0.0%' name='[DH+VFD/GMV (copy)_4670725447377248261]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([incentive_vendor_funded_amount_eur]) / sum([incentive_amount_eur])' />
      </column>
      <column caption='Deal Depth: DH+VFD / iGMV' datatype='real' default-format='p0.0%' name='[Deal Depth: DH+VFD / GMV With VFD (copy)_6964605770172837888]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([incentive_amount_eur]) / sum([gmv (vdata_5571_incentives)])' />
      </column>
      <column caption='Coverage: GMV With VFD / GMV' datatype='real' default-format='p0.0%' name='[Deal Depth: VFD/GMV With Incentives (copy)_4670725447389835274]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([gmv_with_incentives (vdata_5571_orders)]) / sum([gmv])' />
      </column>
      <column caption='DH+VFD / GMV' datatype='real' default-format='p0.0%' name='[VFD/GMV (copy)_4670725447376670724]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([incentive_amount_eur]) / sum([gmv])' />
      </column>
      <column caption='Deal Depth: DH+VFD / GMV With VFD' datatype='real' default-format='p0.0%' name='[VFD/GMV (copy)_4670725447389675529]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([incentive_amount_eur]) / sum([gmv_with_incentives (vdata_5571_orders)])' />
      </column>
