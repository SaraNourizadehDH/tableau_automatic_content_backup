            <column caption='Line Dimension' datatype='string' name='[Calculation_2823616272723992577]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;  WHEN &apos;Overall&apos; THEN &apos;Overall&apos;&#10;  WHEN &apos;By Operation Type&apos; THEN [operation_type]&#10;  WHEN &apos;By Change Type&apos; THEN [change_type]&#10;  WHEN &apos;By Brand Name&apos; THEN [brand_name]&#10;END' />
