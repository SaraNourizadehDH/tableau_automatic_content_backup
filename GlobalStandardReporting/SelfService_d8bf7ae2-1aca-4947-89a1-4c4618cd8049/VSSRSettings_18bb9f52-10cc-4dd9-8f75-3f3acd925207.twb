    <worksheet name='% VSSR Evolution - Dynamic'>
      <table>
        <view>
          <datasources>
            <datasource caption='growth_settings_vssr+ (rl_vendor)' name='federated.0f6l7od0o1a6s61asg3og0n2529o' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Week' caption='Time Granularity - VSSR Evolution' datatype='integer' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='2'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='1' value='Day' />
                <alias key='2' value='Week' />
                <alias key='3' value='Month' />
                <alias key='4' value='Quarter' />
              </aliases>
            </column>
            <column alias='Week' caption='Time Granularity - VSSR Dynamic Evolution' datatype='integer' name='[Time Granularity - VSSR Evolution (copy)_2382896843075354624]' param-domain-type='list' role='measure' type='quantitative' value='2'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='1' value='Day' />
                <alias key='2' value='Week' />
                <alias key='3' value='Month' />
                <alias key='4' value='Quarter' />
              </aliases>
            </column>
            <column caption='Line Dimension Param - Dynamic Evolution' datatype='string' name='[VSSR Split By (copy)_2382896843075620867]' param-domain-type='list' role='measure' type='nominal' value='&quot;By Region&quot;'>
              <calculation class='tableau' formula='&quot;By Region&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0f6l7od0o1a6s61asg3og0n2529o'>
            <column caption='% Non-Automation - Vendor Changes' datatype='real' name='[# Non-Automation - Vendor Changes (copy)_399131548562259977]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [author] = &apos;Vendor&apos; THEN [events] ELSE 0 END)&#10;/&#10;SUM([events])' />
            </column>
            <column caption='# Non-Automation - Vendor Changes' datatype='integer' name='[# Non-Automation Changes (copy)_399131548562173960]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [author] = &apos;Vendor&apos; THEN [events] ELSE 0 END)' />
            </column>
            <column caption='Include Automation?' datatype='boolean' name='[Calculation_149955852584632320]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[automation_group] = &apos;AUTOMATION&apos;' />
            </column>
            <column caption='# Non-Automation Changes' datatype='integer' name='[Calculation_399131548561588230]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([events])' />
            </column>
            <column caption='TG - VSSR Evolution' datatype='string' name='[Calculation_399131548573265934]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;  WHEN 1 THEN STR([created_date])&#10;  WHEN 2 THEN [created_week]&#10;  WHEN 3 THEN [created_month]&#10;  WHEN 4 THEN [created_quarter]&#10;END' />
            </column>
            <column caption='_user_entitlement' datatype='boolean' name='[Calculation_6198993844256624640]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[username] = USERNAME()' />
            </column>
            <column caption='Exact Dates' datatype='date' name='[Calculation_6892125969418379264]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[created_date]' />
            </column>
            <column caption='Line Dimension - Dynamic Chart' datatype='string' name='[Line Dimension (copy)_2382896843075551234]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[VSSR Split By (copy)_2382896843075620867]&#10;  WHEN &apos;Overall&apos; THEN &apos;Overall&apos;&#10;  WHEN &apos;By Region&apos; THEN [region]&#10;  WHEN &apos;By Brand Name&apos; THEN [brand_name]&#10;  WHEN &apos;By Country Name&apos; THEN [country_name]&#10;  WHEN &apos;By Entity ID&apos; THEN [entity_id]&#10;  WHEN &apos;By Vertical Type&apos; THEN [vertical_type]&#10;  WHEN &apos;By Vendor Grade&apos; THEN [vendor_grade]&#10;  WHEN &apos;By Is New Vendor&apos; THEN STR([is_new_vendor])&#10;  WHEN &apos;By Key Account Subcategory&apos; THEN [key_account_sub_category]&#10;  WHEN &apos;By Operation Type&apos; THEN [operation_type]&#10;  WHEN &apos;By Change Type&apos; THEN [change_type]&#10;END' />
            </column>
            <column caption='TG - VSSR Dynamic Evolution' datatype='string' name='[TG - VSSR Evolution (copy)_2382896843075411969]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Time Granularity - VSSR Evolution (copy)_2382896843075354624]&#10;  WHEN 1 THEN STR([created_date])&#10;  WHEN 2 THEN [created_week]&#10;  WHEN 3 THEN [created_month]&#10;  WHEN 4 THEN [created_quarter]&#10;END' />
