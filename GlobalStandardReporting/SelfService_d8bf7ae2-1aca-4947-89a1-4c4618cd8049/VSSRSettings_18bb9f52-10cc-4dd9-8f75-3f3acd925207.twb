      <aliases enabled='yes' />
      <column caption='# Unknown Changes' datatype='integer' name='[# Automation - Product Changes (copy)_810859096118145024]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [author] = &apos;Unknown&apos; THEN [events] ELSE 0 END)' />
      </column>
      <column caption='% Automation Changes' datatype='real' name='[# Automation Changes (copy)_399131548560039937]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [automation_group] = &apos;AUTOMATION&apos; THEN [events] ELSE 0 END)&#10;/&#10;SUM([events])' />
      </column>
      <column caption='# Update Changes' datatype='integer' name='[# Create Changes (copy)_6892125969424486402]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [author] = &apos;Vendor&apos; AND [operation_type] = &apos;Update&apos; THEN [events] ELSE 0 END)' />
      </column>
      <column caption='# Delete Changes' datatype='integer' name='[# Create Changes (copy)_6892125969424592899]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [author] = &apos;Vendor&apos; AND [operation_type] = &apos;Delete&apos; THEN [events] ELSE 0 END)' />
      </column>
      <column caption='% Non-Automation - Vendor Changes' datatype='real' name='[# Non-Automation - Vendor Changes (copy)_399131548562259977]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [author] = &apos;Vendor&apos; THEN [events] ELSE 0 END)&#10;/&#10;SUM([events])' />
      </column>
      <column caption='# Non-Automation - Platform Changes' datatype='integer' name='[# Non-Automation - Vendor Changes (copy)_399131548562501642]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [automation_group] = &apos;NON-AUTOMATION&apos; AND [author] = &apos;Platform&apos; THEN [events] ELSE 0 END)' />
      </column>
      <column caption='% Non-Automation Changes' datatype='real' name='[# Non-Automation Changes (copy)_399131548561739783]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [automation_group] = &apos;NON-AUTOMATION&apos; THEN [events] ELSE 0 END)&#10;/&#10;SUM([events])' />
      </column>
      <column caption='# Non-Automation - Vendor Changes' datatype='integer' name='[# Non-Automation Changes (copy)_399131548562173960]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [author] = &apos;Vendor&apos; THEN [events] ELSE 0 END)' />
      </column>
      <column caption='% Unknown Changes' datatype='real' name='[% Automation Changes (copy)_810859096122667010]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [author] = &apos;Unknown&apos; THEN [events] ELSE 0 END)&#10;/&#10;SUM([events])' />
      </column>
      <column caption='% Non-Automation - Platform Changes' datatype='real' name='[% Non-Automation - Vendor Changes (copy)_399131548562554891]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [automation_group] = &apos;NON-AUTOMATION&apos; AND [author] = &apos;Platform&apos; THEN [events] ELSE 0 END)&#10;/&#10;SUM(IF [automation_group] = &apos;NON-AUTOMATION&apos; THEN [events] ELSE 0 END)' />
      </column>
      <column caption='% VSSR - Create' datatype='real' name='[% Non-Automation - Vendor Changes (copy)_6892125969424990212]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [operation_type] = &apos;Create&apos; AND [author] = &apos;Vendor&apos; THEN [events] ELSE 0 END)&#10;/&#10;SUM(IF [operation_type] = &apos;Create&apos; THEN [events] ELSE 0 END)' />
      </column>
      <column caption='% VSSR - Update' datatype='real' name='[% VSSR - Create (copy)_6892125969425285126]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [operation_type] = &apos;Update&apos; AND [author] = &apos;Vendor&apos; THEN [events] ELSE 0 END)&#10;/&#10;SUM(IF [operation_type] = &apos;Update&apos; THEN [events] ELSE 0 END)' />
      </column>
      <column caption='% VSSR - Delete' datatype='real' name='[% VSSR - Update (copy)_6892125969425408007]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [operation_type] = &apos;Delete&apos; AND [author] = &apos;Vendor&apos; THEN [events] ELSE 0 END)&#10;/&#10;SUM(IF [operation_type] = &apos;Delete&apos; THEN [events] ELSE 0 END)' />
      </column>
      <column caption='Include Automation?' datatype='boolean' name='[Calculation_149955852584632320]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[automation_group] = &apos;AUTOMATION&apos;' />
      </column>
      <column caption='Waterfall Granularity CF' datatype='string' name='[Calculation_149955852605906945]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = &apos;By Operation Type&apos; THEN [operation_type] ELSE [change_type] END' />
      </column>
      <column caption='Line Dimension' datatype='string' name='[Calculation_2823616272723992577]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;  WHEN &apos;Overall&apos; THEN &apos;Overall&apos;&#10;  WHEN &apos;By Operation Type&apos; THEN [operation_type]&#10;  WHEN &apos;By Change Type&apos; THEN [change_type]&#10;  WHEN &apos;By Brand Name&apos; THEN [brand_name]&#10;END' />
      </column>
      <column caption='# Automation Changes' datatype='integer' name='[Calculation_399131548559908864]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [automation_group] = &apos;AUTOMATION&apos; THEN [events] ELSE 0 END)' />
      </column>
      <column caption='# Non-Automation Changes' datatype='integer' name='[Calculation_399131548561588230]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([events])' />
      </column>
      <column caption='Waterfall Height' datatype='integer' name='[Calculation_399131548563103756]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-SUM([events])' />
      </column>
      <column caption='Segment' datatype='string' name='[Calculation_399131548563341325]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [automation_group] = &apos;AUTOMATION&apos; THEN [automation_group]&#10;ELSEIF [persona] = &apos;Vendor&apos; THEN [Calculation_149955852605906945] + &apos; - &apos; + &apos;Self-service&apos;&#10;ELSE [Calculation_149955852605906945] + &apos; - &apos; + [persona]&#10;END' />
      </column>
      <column caption='TG - VSSR Evolution' datatype='string' name='[Calculation_399131548573265934]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;  WHEN 1 THEN STR([created_date])&#10;  WHEN 2 THEN [created_week]&#10;  WHEN 3 THEN [created_month]&#10;  WHEN 4 THEN [created_quarter]&#10;END' />
      </column>
      <column caption='Dimension A' datatype='string' name='[Calculation_399131548575666191]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;  WHEN &apos;Overall&apos; THEN &apos;&apos;&#10;  WHEN &apos;Region&apos; THEN [region]&#10;  WHEN &apos;Country Name&apos; THEN [country_name]&#10;  WHEN &apos;Brand Name&apos; THEN [brand_name]&#10;  WHEN &apos;Entity ID&apos; THEN [entity_id]&#10;  WHEN &apos;Vendor Grade&apos; THEN [vendor_grade]&#10;  WHEN &apos;Vertical Type&apos; THEN [vertical_type]&#10;  WHEN &apos;Client Name&apos; THEN [client_name]&#10;  WHEN &apos;POS Integration Type&apos; THEN [pos_integration_type]&#10;  WHEN &apos;Automation Group&apos; THEN [automation_group]&#10;  WHEN &apos;Persona&apos; THEN [persona]&#10;  WHEN &apos;Operation Type&apos; THEN [operation_type]&#10;  WHEN &apos;Change Type&apos; THEN [change_type]&#10;END' />
      </column>
      <column caption='Table Metric' datatype='real' name='[Calculation_399131548576874514]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;  WHEN &apos;# Events&apos; THEN -SUM([events])&#10;  WHEN &apos;% Vendor Self-Service Ratio (VSSR)&apos; THEN [# Non-Automation - Vendor Changes (copy)_399131548562259977]&#10;END' />
      </column>
      <column caption='Table Metric KPI - To Display' datatype='string' name='[Calculation_399131548577447957]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 3]' />
