            <datasource caption='_ls_growth_report' name='federated.1h8aqjb1kf6zzb11td54z15opur0' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Vertical' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;LOCAL SHOPS&quot;'>
              <calculation class='tableau' formula='&quot;LOCAL SHOPS&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0iv0u350g9d59r10h9mk31mi5bqh'>
            <column caption='Return Period' datatype='string' name='[Calculation_1103381928389619713]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [return_period] WHEN 1 THEN &apos;M1&apos;&#13;&#10;WHEN 3 THEN &apos;M3&apos;&#13;&#10;WHEN 6 THEN &apos;M6&apos;&#13;&#10;WHEN 12 THEN &apos;M12&apos; &#13;&#10;ELSE &apos;Others&apos;&#13;&#10;END' />
            </column>
            <column caption='Current Return Month' datatype='string' name='[Calculation_1191202123828199428]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF MONTH([return_date])=MONTH(TODAY()) THEN &apos;Yes&apos; ELSE &apos;No&apos; END' />
            </column>
            <column caption='Organic M1 Return Users' datatype='integer' name='[Calculation_1220757001082298369]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [incentive] = &apos;Organic&apos;&#13;&#10;AND [Calculation_1103381928389619713]=&apos;M1&apos;&#13;&#10;THEN [returning_users]&#13;&#10;END' />
            </column>
            <column caption='SUM([Organic M1 Return Users])/SUM([Organic M1 Cohort Size])' datatype='real' name='[Calculation_1220757001161547785]' role='measure' type='quantitative' user:unnamed='Line-RetentionRate (2)'>
              <calculation class='tableau' formula='SUM([Calculation_1220757001082298369])/SUM([Organic Return Users (copy)_1220757001160749062])' />
            </column>
            <column caption='SUM([SI M1 Return Users])/SUM([SI M1 Cohort Size])' datatype='real' name='[Calculation_1220757001161711626]' role='measure' type='quantitative' user:unnamed='Line-RetentionRate (2)'>
              <calculation class='tableau' formula='SUM([Organic Return Users (copy)_1220757001160622085])/SUM([Organic Cohort Size (copy)_1220757001160892423])' />
            </column>
            <column caption='SUM([Organic M3 Return Users])/SUM([Organic M3 Cohort Size])' datatype='real' name='[Calculation_1220757001169621010]' role='measure' type='quantitative' user:unnamed='Line-RetentionRate (3)'>
              <calculation class='tableau' formula='SUM([Organic M1 Return Users (copy)_1220757001167245324])/SUM([Organic M1 Cohort Size (copy)_1220757001167138827])' />
            </column>
            <column caption='SUM([SI M3 Return Users])/SUM([SI M3 Cohort Size ])' datatype='real' name='[Calculation_1220757001169756179]' role='measure' type='quantitative' user:unnamed='Line-RetentionRate (3)'>
              <calculation class='tableau' formula='SUM([SI M1 Return Users (copy)_1220757001168728079])/SUM([SI M1 Cohort Size (copy)_1220757001168572430])' />
            </column>
            <column caption='Vertical_Type' datatype='boolean' name='[Calculation_1370501663541153808]' role='dimension' type='nominal'>
