            <column caption='SUM([New Customers])/SUM([MAU])' datatype='real' name='[Calculation_1462262532602527747]' role='measure' type='quantitative' user:unnamed='New Customers'>
              <calculation class='tableau' formula='SUM([MAU (copy)_1462262532597465089])/SUM([Trial Non Voucher (copy)_1462262532593786880])' />
            </column>
