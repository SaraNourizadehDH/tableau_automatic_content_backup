              <calculation class='tableau' formula='&quot;Argentina&quot;' />
            </column>
            <column caption='Entity_Name_F' datatype='string' name='[Entity_Name (copy)_777715399732510741]' param-domain-type='list' role='measure' type='nominal' value='&quot;Pedidosya&quot;'>
