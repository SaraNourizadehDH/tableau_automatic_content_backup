      <column caption='Return Period' datatype='string' name='[Calculation_1103381928389619713]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [return_period] WHEN 1 THEN &apos;M1&apos;&#13;&#10;WHEN 3 THEN &apos;M3&apos;&#13;&#10;WHEN 6 THEN &apos;M6&apos;&#13;&#10;WHEN 12 THEN &apos;M12&apos; &#13;&#10;ELSE &apos;Others&apos;&#13;&#10;END' />
      </column>
      <column caption='KPI Select' datatype='real' name='[Calculation_1117455675085594628]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &apos;1&apos;&#13;&#10;THEN ROUND((SUM([returning_users])/SUM([cohort_size]))*100)&#13;&#10;WHEN &apos;2&apos;&#13;&#10;THEN SUM([orders])/SUM([returning_users])&#13;&#10;WHEN &apos;3&apos;&#13;&#10;THEN SUM([orders])/SUM([cohort_size])&#13;&#10;WHEN &apos;4&apos;&#13;&#10;THEN SUM([amt_gmv_eur])&#13;&#10;WHEN &apos;5&apos;&#13;&#10;THEN SUM([amt_gbv_eur])/SUM([orders])&#13;&#10;WHEN &apos;6&apos;&#13;&#10;THEN SUM([qty_sold])/SUM([orders])&#13;&#10;WHEN &apos;7&apos;&#13;&#10;THEN ROUND((SUM([voucher_orders])/SUM([orders]))*100)&#13;&#10;WHEN &apos;8&apos;&#13;&#10;THEN (SUM([amt_voucher_eur])/SUM([amt_gmv_eur]))&#13;&#10;WHEN &apos;9&apos;&#13;&#10;THEN ROUND((SUM([amt_discount_eur])/SUM([amt_gmv_eur]))*100)&#13;&#10;WHEN &apos;10&apos;&#13;&#10;THEN ROUND((SUM([stacked_incentives])/SUM([amt_gmv_eur]))*100)&#13;&#10;END' />
      </column>
      <column caption='KPI Select Second' datatype='real' name='[Calculation_1117455675086393349]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Select First KPI (copy)_1370501663522402313]&#13;&#10;WHEN &apos;1&apos;&#13;&#10;THEN ROUND((SUM([returning_users])/SUM([cohort_size]))*100)&#13;&#10;WHEN &apos;2&apos;&#13;&#10;THEN SUM([orders])/SUM([returning_users])&#13;&#10;WHEN &apos;3&apos;&#13;&#10;THEN SUM([orders])/SUM([cohort_size])&#13;&#10;WHEN &apos;4&apos;&#13;&#10;THEN SUM([amt_gmv_eur])&#13;&#10;WHEN &apos;5&apos;&#13;&#10;THEN SUM([amt_gbv_eur])/SUM([orders])&#13;&#10;WHEN &apos;6&apos;&#13;&#10;THEN SUM([qty_sold])/SUM([orders])&#13;&#10;WHEN &apos;7&apos;&#13;&#10;THEN ROUND((SUM([voucher_orders])/SUM([orders]))*100)&#13;&#10;WHEN &apos;8&apos;&#13;&#10;THEN (SUM([amt_voucher_eur])/SUM([amt_gmv_eur]))&#13;&#10;WHEN &apos;9&apos;&#13;&#10;THEN ROUND((SUM([amt_discount_eur])/SUM([amt_gmv_eur]))*100)&#13;&#10;WHEN &apos;10&apos;&#13;&#10;THEN ROUND((SUM([stacked_incentives])/SUM([amt_gmv_eur]))*100)&#13;&#10;END' />
      </column>
      <column caption='KPI Select Third' datatype='real' name='[Calculation_1117455675086770183]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Select Second KPI  (copy)_1033013169304920067]&#13;&#10;WHEN &apos;1&apos;&#13;&#10;THEN ROUND((SUM([returning_users])/SUM([cohort_size]))*100)&#13;&#10;WHEN &apos;2&apos;&#13;&#10;THEN SUM([orders])/SUM([returning_users])&#13;&#10;WHEN &apos;3&apos;&#13;&#10;THEN SUM([orders])/SUM([cohort_size])&#13;&#10;WHEN &apos;4&apos;&#13;&#10;THEN SUM([amt_gmv_eur])&#13;&#10;WHEN &apos;5&apos;&#13;&#10;THEN SUM([amt_gbv_eur])/SUM([orders])&#13;&#10;WHEN &apos;6&apos;&#13;&#10;THEN SUM([qty_sold])/SUM([orders])&#13;&#10;WHEN &apos;7&apos;&#13;&#10;THEN ROUND((SUM([voucher_orders])/SUM([orders]))*100)&#13;&#10;WHEN &apos;8&apos;&#13;&#10;THEN (SUM([amt_voucher_eur])/SUM([amt_gmv_eur]))&#13;&#10;WHEN &apos;9&apos;&#13;&#10;THEN ROUND((SUM([amt_discount_eur])/SUM([amt_gmv_eur]))*100)&#13;&#10;WHEN &apos;10&apos;&#13;&#10;THEN ROUND((SUM([stacked_incentives])/SUM([amt_gmv_eur]))*100)&#13;&#10;END' />
      </column>
      <column caption='Current Return Month' datatype='string' name='[Calculation_1191202123828199428]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF MONTH([return_date])=MONTH(TODAY()) THEN &apos;Yes&apos; ELSE &apos;No&apos; END' />
      </column>
