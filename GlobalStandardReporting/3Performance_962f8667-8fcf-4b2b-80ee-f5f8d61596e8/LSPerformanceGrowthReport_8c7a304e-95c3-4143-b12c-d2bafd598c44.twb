          <datasource-dependencies datasource='federated.0iv0u350g9d59r10h9mk31mi5bqh'>
            <column caption='Return Period' datatype='string' name='[Calculation_1103381928389619713]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [return_period] WHEN 1 THEN &apos;M1&apos;&#13;&#10;WHEN 3 THEN &apos;M3&apos;&#13;&#10;WHEN 6 THEN &apos;M6&apos;&#13;&#10;WHEN 12 THEN &apos;M12&apos; &#13;&#10;ELSE &apos;Others&apos;&#13;&#10;END' />
            </column>
            <column caption='Current Return Month' datatype='string' name='[Calculation_1191202123828199428]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF MONTH([return_date])=MONTH(TODAY()) THEN &apos;Yes&apos; ELSE &apos;No&apos; END' />
            </column>
            <column caption='Country Selection' datatype='boolean' name='[Calculation_1462262532964909064]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Country] WHEN [Parameters].[Parameter 4] THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='SUM([Country_Returnusers])/SUM([Country_CohortSize])' datatype='real' name='[Calculation_1462262532972818451]' role='measure' type='quantitative' user:unnamed='RetentionRate (3)'>
              <calculation class='tableau' formula='SUM([Entity_Returnusers (copy)_1462262532972601362])/SUM([Entity_CohortSIze (copy)_1462262532972343313])' />
            </column>
            <column caption='SUM([Country_Returnusers_F])/SUM([Country_CohortSize_F])' datatype='real' name='[Calculation_777715399736307738]' role='measure' type='quantitative' user:unnamed='RetentionRate- LS'>
