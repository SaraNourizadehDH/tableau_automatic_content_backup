    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Glossary'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/QC-Performance-LocalShopGrowthReport/Glossary?rev=' id='Glossary' path='/t/GlobalStandardReporting/workbooks/QC-Performance-LocalShopGrowthReport' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='768' maxwidth='1366' minheight='768' minwidth='1366' preset-index='0' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='97916' id='110' param='horz' type-v2='layout-flow' w='98828' x='586' y='1042'>
            <zone h='97916' id='6' type-v2='layout-basic' w='98828' x='586' y='1042'>
              <zone forceUpdate='true' h='9950' id='3' type-v2='text' w='98828' x='586' y='1042'>
                <formatted-text>
                  <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='22'>Glossary</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='3' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#da1d23' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='87966' id='132' type-v2='text' w='98828' x='586' y='10992'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000'>Acquisitions:</run>
                  <run fontcolor='#000000'> Customers that tried the Platform (First platform lifetime order) within a period of time</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000'>Trials :</run>
                  <run fontcolor='#000000'> Customers that tried a certain vertical  within a period of time</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000'>Trials [ Sub Vertical] :</run>
                  <run fontcolor='#000000'> Customers that tried a certain LocalShops via subvertical within a period of time</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000'>Cross Sells [ aka Cross Trials] :</run>
                  <run fontcolor='#000000'>Existing Platform customers that tried  a certain vertical/subvertical (1st vertical/subvertical lifetime order, but not 1st Platform lifetime order) within a period of time</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000'>Retention Rate:</run>
                  <run fontcolor='#000000'> Active Customers from Trial Cohort  / Trial Cohort</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000'>Activity (Active Frequency)</run>
                  <run fontcolor='#000000'>: Successful Orders / Active Trial Cohort Base</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000'>Active Trial Cohort Base: All customers who tried QC/ DM/ LS in month 0 and came back in repective months</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000'>Frequency:</run>
                  <run fontcolor='#000000'> Successful Orders / Trial Cohort Base (both Active+Inactive)</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000'>ABV:</run>
                  <run fontcolor='#000000'> Gross Basket Value / Successful Orders</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000'>ABS:</run>
                  <run fontcolor='#000000'> Total Items Sold / Successful Orders</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000'>% Orders w/Vouchers:</run>
                  <run fontcolor='#000000'> Percentage of total Orders with vouchers</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000'>Vouchers % of GMV:</run>
                  <run fontcolor='#000000'> Percentage of vouchers to total GMV</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000'>Incentivized MAU:</run>
                  <run fontcolor='#000000'> Monthly  Active users with one or more incentive applied to the order (ex: Voucher/Discount/Free Delivery)</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='3' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
        <zone h='6771' id='66' is-scaled='1' param='Image/DH New Logo.PNG' type-v2='bitmap' w='5930' x='1903' y='2865' />
