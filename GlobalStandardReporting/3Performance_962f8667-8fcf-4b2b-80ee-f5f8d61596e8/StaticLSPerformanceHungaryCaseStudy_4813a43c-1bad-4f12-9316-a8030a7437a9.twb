  <worksheets>
    <worksheet name='Overall: Quadrant'>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (curated_data_shared_dmart)' name='federated.1ry5dkx0m1288t14x5ufe179ybkb' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Highlight by' datatype='string' name='[Color by (copy)_339458873827012623]' param-domain-type='list' role='measure' type='nominal' value='&quot;City&quot;'>
              <calculation class='tableau' formula='&quot;City&quot;' />
            </column>
            <column caption='Granularity' datatype='string' name='[Granularity 1 (copy)_339458873826197518]' param-domain-type='list' role='measure' type='nominal' value='&quot;Vendor Name&quot;'>
              <calculation class='tableau' formula='&quot;Vendor Name&quot;' />
            </column>
            <column caption='Color by' datatype='string' name='[Granularity 3 (copy)_339458873823813640]' param-domain-type='list' role='measure' type='nominal' value='&quot;Chain Name&quot;'>
              <calculation class='tableau' formula='&quot;Chain Name&quot;' />
            </column>
            <column caption='X Axis' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;GBV Total OOS Loss (FR+PF)&quot;'>
              <calculation class='tableau' formula='&quot;GBV Total OOS Loss (FR+PF)&quot;' />
            </column>
            <column caption='Y Axis' datatype='string' name='[X Axis (copy)_339458873829376022]' param-domain-type='list' role='measure' type='nominal' value='&quot;GBV Total OOS Loss (FR+PF) Rate&quot;'>
              <calculation class='tableau' formula='&quot;GBV Total OOS Loss (FR+PF) Rate&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ry5dkx0m1288t14x5ufe179ybkb'>
            <column caption='GBV Total OOS Loss (FR+PF) Rate' datatype='real' default-format='p0.00%' name='[Calculation_1635369665882509312]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([gbv_failed_oos_and_pf_loss],0))/SUM([gbv_delivered])' />
            </column>
            <column caption='Monthly Orders' datatype='integer' name='[Calculation_339458873818243073]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [global_entity_id],[Granularity 1 (copy)_339458873824100364],[month]: SUM([orders_total])}' />
            </column>
            <column caption='Avg. Monthly Orders' datatype='real' name='[Calculation_339458873822547971]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Calculation_339458873818243073])' />
            </column>
            <column caption='X Axis' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_339458873830002714]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;    WHEN &quot;GBV Failed by Vendor Loss&quot; THEN SUM(IFNULL([gbv_failed_by_vendor_loss],0))&#13;&#10;    WHEN &quot;GBV Failed OOS Loss&quot; THEN SUM(IFNULL([gbv_failed_by_vendor_oos_loss],0))&#13;&#10;    WHEN &quot;GBV PF Loss&quot; THEN SUM(IFNULL([gbv_partial_fulfillment_loss],0))&#13;&#10;    WHEN &quot;GBV Total Failed Loss&quot; THEN SUM(IFNULL([gbv_failed_loss],0))&#13;&#10;    WHEN &quot;GBV Total OOS Loss (FR+PF)&quot; THEN SUM(IFNULL([gbv_failed_oos_and_pf_loss],0))&#13;&#10;END' />
            </column>
            <column caption='Highlight' datatype='string' name='[Color (copy)_339458873827057680]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Color by (copy)_339458873827012623]&#13;&#10;    WHEN &quot;Segment&quot; THEN [segment]&#13;&#10;    WHEN &quot;Management Entity&quot; THEN [management_entity]&#13;&#10;    WHEN &quot;Country&quot; THEN [country_name]&#13;&#10;    WHEN &quot;City&quot; THEN [city]&#13;&#10;    WHEN &quot;Vertical Type&quot; THEN [vertical_type]&#13;&#10;    WHEN &quot;Chain Name&quot; THEN [chain_name]&#13;&#10;    WHEN &quot;AAA Chain Name Cleaned&quot; THEN [aaa_chain_name_cleaned]&#13;&#10;    WHEN &quot;Vendor Name&quot; THEN [vendor_name]&#13;&#10;END' />
            </column>
            <column caption='GBV Failed by Vendor Loss Rate' datatype='real' default-format='p0.00%' name='[GBV Total OOS Loss (FR + PF) Rate (copy)_339458873828585490]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([gbv_failed_by_vendor_loss],0))/SUM([gbv_delivered])' />
            </column>
            <column caption='GBV Failed OOS Loss Rate' datatype='real' default-format='p0.00%' name='[GBV Total OOS Loss (FR + PF) Rate (copy)_339458873828687891]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([gbv_failed_by_vendor_oos_loss],0))/SUM([gbv_delivered])' />
            </column>
            <column caption='GBV Total Failed Loss Rate' datatype='real' default-format='p0.00%' name='[GBV Total OOS Loss (FR + PF) Rate (copy)_339458873828831252]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([gbv_failed_oos_and_pf_loss],0))/SUM([gbv_delivered])' />
            </column>
            <column caption='GBV PF Loss Rate' datatype='real' default-format='p0.00%' name='[GBV Total OOS Loss Rate (copy)_339458873827794961]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([gbv_partial_fulfillment_loss],0))/SUM([gbv_delivered])' />
            </column>
            <column caption='Granularity' datatype='string' name='[Granularity 1 (copy)_339458873824100364]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Granularity 1 (copy)_339458873826197518]&#13;&#10;    WHEN &quot;Segment&quot; THEN [segment]&#13;&#10;    WHEN &quot;Management Entity&quot; THEN [management_entity]&#13;&#10;    WHEN &quot;Country&quot; THEN [country_name]&#13;&#10;    WHEN &quot;City&quot; THEN [city]&#13;&#10;    WHEN &quot;Vertical Type&quot; THEN [vertical_type]&#13;&#10;    WHEN &quot;Chain Name&quot; THEN [chain_name]&#13;&#10;    WHEN &quot;AAA Chain Name Cleaned&quot; THEN [aaa_chain_name_cleaned]&#13;&#10;    WHEN &quot;Vendor Name&quot; THEN [vendor_name]&#13;&#10;END' />
            </column>
            <column caption='Color' datatype='string' name='[Granularity 3 (copy)_339458873824022539]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Granularity 3 (copy)_339458873823813640]&#13;&#10;    WHEN &quot;Segment&quot; THEN [segment]&#13;&#10;    WHEN &quot;Management Entity&quot; THEN [management_entity]&#13;&#10;    WHEN &quot;Country&quot; THEN [country_name]&#13;&#10;    WHEN &quot;City&quot; THEN [city]&#13;&#10;    WHEN &quot;Vertical Type&quot; THEN [vertical_type]&#13;&#10;    WHEN &quot;Chain Name&quot; THEN [chain_name]&#13;&#10;    WHEN &quot;AAA Chain Name Cleaned&quot; THEN [aaa_chain_name_cleaned]&#13;&#10;    WHEN &quot;Vendor Name&quot; THEN [vendor_name]&#13;&#10;END' />
            </column>
            <column caption='Y Axis' datatype='real' default-format='p0.00%' name='[X Axis (copy)_339458873830514715]' role='measure' type='quantitative'>
