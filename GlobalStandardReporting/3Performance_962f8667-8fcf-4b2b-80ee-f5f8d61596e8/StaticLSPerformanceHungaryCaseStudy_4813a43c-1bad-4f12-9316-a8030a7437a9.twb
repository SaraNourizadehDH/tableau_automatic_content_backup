      <column caption='GBV Total OOS Loss (FR+PF) Rate' datatype='real' default-format='p0.00%' name='[Calculation_1635369665882509312]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL([gbv_failed_oos_and_pf_loss],0))/SUM([gbv_delivered])' />
