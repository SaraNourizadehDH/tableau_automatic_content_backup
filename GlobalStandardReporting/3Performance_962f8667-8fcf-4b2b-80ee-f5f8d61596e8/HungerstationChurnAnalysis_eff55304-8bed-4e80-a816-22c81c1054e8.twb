      <aliases enabled='yes' />
      <column caption='% Orders with  Free Delivery' datatype='real' name='[% Orders with discuounts (copy)_3253850781285290002]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dmart_order_with_fdf])/SUM([dmart_successful_orders])' />
      </column>
      <column caption='% Orders with discounts' datatype='real' name='[% Orders with vouchers (copy)_3253850781285203985]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dmart_order_with_discount])/SUM([dmart_successful_orders])' />
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Customer_cnt]) / TOTAL(SUM([Customer_cnt]))'>
          <table-calc ordering-type='ColumnInPane' />
        </calculation>
      </column>
      <column aggregation='Sum' caption='Month - Trial Month' datatype='integer' name='[Calculation_3253850781254438912]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,[trial_month],[reporting_month])' />
      </column>
      <column caption='Classification L1' datatype='string' name='[Calculation_3253850781257199618]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE  [Parameters].[Parameter 1]&#10;WHEN 1 THEN [customer_classification]&#10;WHEN 2 THEN [trial_incentive_type]&#10;WHEN 3 THEN IF([partial_order_trial])=TRUE THEN &quot;1&quot; ELSE &quot;0&quot; END&#10;WHEN 4 THEN [delivery_time_trial_bucket]&#10;WHEN 5 THEN [delivery_delay_trial_bucket]&#10;WHEN 6 THEN NULL&#10;END' />
      </column>
      <column caption='Food KPI' datatype='real' name='[Calculation_3253850781276631046]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2] &#10;WHEN 1 THEN [food_orders]&#10;WHEN 2 THEN [food_gmv] END' />
      </column>
      <column aggregation='Sum' caption='Months (Trial- Churn)' datatype='integer' name='[Calculation_3253850781277851657]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,[trial_month],[reporting_month])' />
      </column>
      <column caption='Delivery Delay' datatype='real' name='[Calculation_3253850781279272970]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([delivery_delay_minutes])/SUM([dmart_order_with_dd])' />
      </column>
      <column caption='Time Till Churn' datatype='boolean' name='[Calculation_3253850781281447948]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[reporting_month]&lt;=[first_churn_month]' />
      </column>
      <column caption='Partial Orders' datatype='real' name='[Calculation_3253850781282512909]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dmart_partial_orders])/SUM([dmart_successful_orders])' />
      </column>
      <column caption='Failed Orders' datatype='real' name='[Calculation_3253850781282697230]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Dmart_Failed_Orders])/SUM([dmart_total_orders])' />
      </column>
      <column caption='% Orders with delivery delay' datatype='real' name='[Calculation_3253850781283450895]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dmart_order_with_dd])/SUM([dmart_successful_orders])' />
      </column>
      <column caption='% Orders with vouchers' datatype='real' name='[Calculation_3253850781284982800]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dmart_order_with_voucher])/SUM([dmart_successful_orders])' />
      </column>
      <column caption='Avg Voucher Spend' datatype='real' name='[Calculation_3253850781287186451]' role='measure' type='quantitative'>
