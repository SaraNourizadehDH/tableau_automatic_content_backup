      </column>
      <column caption='Classification L2' datatype='string' name='[Classification L1 (copy)_3253850781274750980]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE  [Parameters].[Classification 1 (copy)_3253850781274157059]&#10;WHEN 1 THEN [customer_classification]&#10;WHEN 2 THEN [trial_incentive_type]&#10;WHEN 3 THEN IF([partial_order_trial])=TRUE THEN &quot;1&quot; ELSE &quot;0&quot; END&#10;WHEN 4 THEN [delivery_time_trial_bucket]&#10;WHEN 5 THEN [delivery_delay_trial_bucket]&#10;WHEN 6 THEN NULL&#10;END' />
