      <aliases enabled='yes' />
      <column caption='AAA Category GPV' datatype='real' name='[AAA_Category_GPV]' role='measure' type='quantitative' />
      <column caption='AAA Total GPV' datatype='real' name='[AAA_Total_GPV]' role='measure' type='quantitative' />
      <column caption='Chain, Country' datatype='string' name='[Calculation_327355462456905730]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[AAA Supermarkets]+&quot;,&quot;+Right([Global_Entity_Id],2)' />
      </column>
      <column caption='GPV Delta' datatype='real' name='[Calculation_327355462457479171]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([AAA_Category_GPV])*100/MAX([AAA_Total_GPV])-SUM([Dmart_Category_GPV])*100/MAX([Dmart_Total_GPV])' />
      </column>
      <column caption='% of UF SKUS' datatype='real' name='[Calculation_327355462457798660]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Listed UF SKUs  (AAA)])/SUM([Listed UF SKUs  (Dmarts)])' />
      </column>
      <column caption='Entity (Fixed)' datatype='string' name='[Calculation_327355463096545288]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Country]=&apos;Turkey&apos; THEN &quot;YemekSpeti&quot; ELSE [Entity] END' />
      </column>
