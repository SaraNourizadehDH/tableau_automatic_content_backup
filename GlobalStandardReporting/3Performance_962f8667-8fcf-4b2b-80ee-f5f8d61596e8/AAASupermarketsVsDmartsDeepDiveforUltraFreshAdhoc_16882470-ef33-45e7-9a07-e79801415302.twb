  <worksheets>
    <worksheet name='% of UF Items Delivered'>
      <table>
        <view>
          <datasources>
            <datasource caption='Raw Data (AAA UF Analysis - SKU Deep Dive)' name='federated.08oqvqv0oxa363118u2051art09g' />
          </datasources>
          <datasource-dependencies datasource='federated.08oqvqv0oxa363118u2051art09g'>
            <column caption='Avg listed skus' datatype='real' name='[Avg_listed_skus]' role='measure' type='quantitative' />
            <column caption='UF Items Delivered Per Order' datatype='real' name='[Calculation_327355462452260864]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([UF Qty Delivered])/SUM({ FIXED [Country],[Calculation_5304395995659816960]: MAX([Orders (Raw data (UF as % of items deli)])})' />
            </column>
            <column caption='Management Entity (Fixed)' datatype='string' name='[Calculation_327355463112806409]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Country]=&apos;Turkey&apos; THEN &apos;Yemekspeti&apos; ELSE [Management Entity] END' />
            </column>
            <column caption='Chain,Country' datatype='string' name='[Calculation_5304395995659816960]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Chain_Name]+&quot;,&quot;+RIGHT([Global_Entity_Id],2)' />
            </column>
            <column caption='Dmarts/AAAs' datatype='string' name='[Calculation_5304395995662663683]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Chain_Name]=&apos;Dmarts&apos; THEN &quot;Dmarts&quot; ELSE &quot;AAAs&quot; END' />
            </column>
