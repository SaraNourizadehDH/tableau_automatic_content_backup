      <column caption='AAA' datatype='string' name='[AAA Supermarkets]' role='dimension' type='nominal' />
      <column caption='% OF Total' datatype='real' name='[Calculation_327355462817705991]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Numerator])/SUM({FIXED [Country]:Sum([Numerator])})' />
      </column>
      <column caption='Impact' datatype='real' name='[Calculation_327355463303872524]' role='measure' type='quantitative'>
