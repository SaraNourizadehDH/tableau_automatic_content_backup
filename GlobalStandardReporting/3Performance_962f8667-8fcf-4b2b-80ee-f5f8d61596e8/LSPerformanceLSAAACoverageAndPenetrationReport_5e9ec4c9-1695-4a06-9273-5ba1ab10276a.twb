            <column caption='Country' datatype='string' name='[COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Penetration ' datatype='real' name='[Calculation_1651413739274944512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([LS_MAU])/SUM([GRANULARITY_LEVEL_LS_COVERED_MAU])' />
            </column>
            <column caption='Element Dim Sort' datatype='string' name='[Calculation_1651413739278032899]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_4533998974558175238]=&quot;Overall&quot; Then &quot;0&quot; ELSE &quot;1&quot; END' />
            </column>
            <column caption='Element Dim -1' datatype='string' name='[Calculation_1798554789193666560]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [ELEMENT]=&apos;Vendors&apos; then [AAA_Supermarket_Name] ELSE [Calculation_4533998974558175238] END' />
              <aliases>
                <alias key='&quot;Overall&quot;' value='Across all AAAs' />
              </aliases>
            </column>
            <column caption='Granularity ' datatype='string' name='[Calculation_4533998974551830528]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [GRANULARITY]&#10;WHEN &quot;City&quot; THEN [CITY]&#10;WHEN &quot;Country&quot; THEN [COUNTRY]&#10;WHEN &quot;Management Entity&quot; THEN   [MANAGEMENT_ENTITY]&#10;WHEN &quot;Region&quot; THEN [REGION]&#10;WHEN &quot;Global&quot; THEN &quot;DH&quot;&#10;END' />
              <aliases>
                <alias key='&quot;XXXXX&quot;' value=' ' />
              </aliases>
            </column>
            <column caption='Element Dim' datatype='string' name='[Calculation_4533998974558175238]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [ELEMENT]=&quot;Overall&quot; THEN &quot;Overall&quot; Else [ELEMENT_DIMENSION] END' />
              <aliases>
                <alias key='&quot;Overall&quot;' value='Across all AAAs' />
              </aliases>
            </column>
            <column caption='Coverage' datatype='real' name='[Calculation_4533998974574456845]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([LS_COVERED_MAU])/SUM([GRANULARITY_LEVEL_PLATFORM_MAU])' />
            </column>
            <column caption='% Prospect MAU' datatype='real' name='[Calculation_4533998974578511888]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([LS_COVERED_PROSPECT_MAU])/sum([GRANULARITY_LEVEL_LS_COVERED_MAU])' />
