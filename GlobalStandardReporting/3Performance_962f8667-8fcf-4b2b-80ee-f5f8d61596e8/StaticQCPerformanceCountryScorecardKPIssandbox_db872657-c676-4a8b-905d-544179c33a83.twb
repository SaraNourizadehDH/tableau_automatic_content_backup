              <calculation class='tableau' formula='&quot;DH Group&quot;' />
            </column>
            <column caption='Granularity C' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
              <calculation class='tableau' formula='&quot;Country&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.081sadv14rc7dp1ca2s8v0up1no6'>
            <column caption='User Entitlements' datatype='boolean' name='[Calculation_1343761595230257169]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[username] = USERNAME()' />
            </column>
            <column caption='KPI - QC - MAU as % of Platform' datatype='real' default-format='p0.0%' name='[Calculation_370984075400355840]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cdwh_qc_mau])/SUM([cdwh_pl_mau])' />
