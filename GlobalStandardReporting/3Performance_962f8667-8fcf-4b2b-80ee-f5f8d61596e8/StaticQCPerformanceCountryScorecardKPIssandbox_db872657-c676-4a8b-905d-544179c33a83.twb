      <column caption='X Axis' datatype='real' name='[Calculation_1343761595192139779]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &apos;Dmarts - MAU&apos; THEN SUM([cdwh_dm_mau])&#13;&#10;WHEN &apos;Dmarts - GMV&apos; THEN SUM([cdwh_dm_gmv])&#13;&#10;WHEN &apos;Dmarts - Orders&apos; THEN SUM([cdwh_dm_orders])&#13;&#10;WHEN &apos;Dmarts - QC Trials via Dmarts&apos; THEN SUM([qc_trials_in_dm])&#13;&#10;WHEN &apos;Dmarts - Assortment Quality Score&apos; THEN [Calculation_370984075415814189]&#13;&#10;WHEN &apos;Dmarts - CVR3&apos; THEN [KPI - Dmarts - GMV as % of Platform (copy)_370984075408777227]&#13;&#10;WHEN &apos;Dmarts - Centralisation of SKUs&apos; THEN [KPI - Dmarts - Orders as % of Platform (copy)_370984075416764465]&#13;&#10;WHEN &apos;Dmarts - Covered MAU per Store&apos; THEN [KPI - Dmarts - Days on Hand (copy)_370984075417641013]&#13;&#10;WHEN &apos;Dmarts - Days on Hand&apos; THEN [KPI - Dmarts - CVR3 (copy)_370984075416961075]&#13;&#10;WHEN &apos;Dmarts - GMV as % of Platform&apos; THEN [KPI - Dmarts - MAU as % of Platform (copy)_370984075408134149]&#13;&#10;WHEN &apos;Dmarts - Incentive spend as % of GMV&apos; THEN [KPI - Dmarts - CVR3 (copy)_370984075413647392]&#13;&#10;WHEN &apos;Dmarts - Incentive spend as % of Platform&apos; THEN [KPI - Shops - Incentive spend as % of Platform (copy)_370984075414327331]&#13;&#10;WHEN &apos;Dmarts - Incentive spend on QC trial in Dmarts (as % of all incentive spend)&apos; THEN [KPI - Dmarts - Incentive spend as % of Platform (copy)_370984075414536229]&#13;&#10;WHEN &apos;Dmarts - M1 Retention of QC Trials via Dmarts&apos; THEN [KPI - QC - M1 Retention (copy)_370984075412230171]&#13;&#10;WHEN &apos;Dmarts - M3 Retention of QC Trials via Dmarts&apos; THEN [KPI - Dmarts - M1 Retention of QC Trials via Dmarts (copy)_370984075413454878]&#13;&#10;WHEN &apos;Dmarts - MAU as % of Platform&apos; THEN [KPI - QC - QC MAU as % of Platform (copy)_370984075407503362]&#13;&#10;WHEN &apos;Dmarts - Orders as % of Platform&apos; THEN [KPI - Dmarts - GMV as % of Platform (co