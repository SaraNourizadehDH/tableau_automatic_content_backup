        <_.fcp.ObjectModelEncapsulateLegacy.false...relation join='inner' type='join'>
          <clause type='join'>
            <expression op='='>
              <expression op='[Custom SQL Query].[global_entity_id]' />
              <expression op='[tableau_gsr_entitlements_global_entity_id].[global_entity_id]' />
            </expression>
          </clause>
          <relation connection='bigquery.0ehlehy0oczne41bzzgsa002gjd8' name='Custom SQL Query' type='text'>SELECT&#13;
  qc.*,&#13;
  dmarts.* EXCEPT(global_entity_id,month,cdwh_dm_revenue_fees),&#13;
  shops.* EXCEPT(global_entity_id,month,cdwh_ls_gmv),&#13;
  ge.management_entity,&#13;
  ge.country_name&#13;
FROM `dh-darkstores-stg.dev_dmart.pede_qc_scorecard_qc` qc&#13;
INNER JOIN `fulfillment-dwh-production.curated_data_shared_coredata.global_entities` ge&#13;
  USING (global_entity_id)&#13;
LEFT JOIN `dh-darkstores-stg.dev_dmart.pede_qc_scorecard_dmarts` dmarts&#13;
  USING (global_entity_id,month)&#13;
LEFT JOIN `dh-darkstores-stg.dev_dmart.pede_qc_scorecard_shops` shops&#13;
  USING (global_entity_id,month)&#13;
ORDER BY 2,1</relation>
          <relation connection='bigquery.07tuk130i1igji0zryacd08ujt2b' name='tableau_gsr_entitlements_global_entity_id' table='[fulfillment-dwh-production.curated_data_shared_govops].[tableau_gsr_entitlements_global_entity_id]' type='table' />
