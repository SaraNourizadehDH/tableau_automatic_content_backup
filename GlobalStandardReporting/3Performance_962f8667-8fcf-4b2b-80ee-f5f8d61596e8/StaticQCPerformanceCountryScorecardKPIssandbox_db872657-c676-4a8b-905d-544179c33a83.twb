  <worksheets>
    <worksheet name='Correlation Chart'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#d30000'>&lt;Sheet Name&gt; (customizable)</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/QCCountryScorecardKPIscustomizable/CorrelationChart?rev=' id='CorrelationChart' path='/t/GlobalStandardReporting/workbooks/QCCountryScorecardKPIscustomizable' revision='' site='GlobalStandardReporting' />
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (curated_data_shared_central_dwh)' name='federated.081sadv14rc7dp1ca2s8v0up1no6' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Color by' datatype='string' name='[Granularity T (copy)_1343761595219587087]' param-domain-type='list' role='measure' type='nominal' value='&quot;Management Entity&quot;'>
              <calculation class='tableau' formula='&quot;Management Entity&quot;' />
            </column>
            <column caption='Granularity C' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
              <calculation class='tableau' formula='&quot;Country&quot;' />
            </column>
            <column caption='X Axis' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Dmarts - GMV&quot;'>
              <calculation class='tableau' formula='&quot;Dmarts - GMV&quot;' />
            </column>
            <column caption='Y Axis' datatype='string' name='[X Axis (copy)_1343761595219349516]' param-domain-type='list' role='measure' type='nominal' value='&quot;Shops - GMV&quot;'>
              <calculation class='tableau' formula='&quot;Shops - GMV&quot;' />
            </column>
            <column caption='Size' datatype='string' name='[Y Axis (copy)_1343761595219476493]' param-domain-type='list' role='measure' type='nominal' value='&quot;QC - Cross Sells as \% of QC Prospects&quot;'>
              <calculation class='tableau' formula='&quot;QC - Cross Sells as % of QC Prospects&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.081sadv14rc7dp1ca2s8v0up1no6'>
            <column caption='X Axis' datatype='real' name='[Calculation_1343761595192139779]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &apos;Dmarts - MAU&apos; THEN SUM([cdwh_dm_mau])&#13;&#10;WHEN &apos;Dmarts - GMV&apos; THEN SUM([cdwh_dm_gmv])&#13;&#10;WHEN &apos;Dmarts - Orders&apos; THEN SUM([cdwh_dm_orders])&#13;&#10;WHEN &apos;Dmarts - QC Trials via Dmarts&apos; THEN SUM([qc_trials_in_dm])&#13;&#10;WHEN &apos;Dmarts - Assortment Quality Score&apos; THEN [Calculation_370984075415814189]&#13;&#10;WHEN &apos;Dmarts - CVR3&apos; THEN [KPI - Dmarts - GMV as % of Platform (copy)_370984075408777227]&#13;&#10;WHEN &apos;Dmarts - Centralisation of SKUs&apos; THEN [KPI - Dmarts - Orders as % of Platform (copy)_370984075416764465]&#13;&#10;WHEN &apos;Dmarts - Covered MAU per Store&apos; THEN [KPI - Dmarts - Days on Hand (copy)_370984075417641013]&#13;&#10;WHEN &apos;Dmarts - Days on Hand&apos; THEN [KPI - Dmarts - CVR3 (copy)_370984075416961075]&#13;&#10;WHEN &apos;Dmarts - GMV as % of Platform&apos; THEN [KPI - Dmarts - MAU as % of Platform (copy)_370984075408134149]&#13;&#10;WHEN &apos;Dmarts - Incentive spend as % of GMV&apos; THEN [KPI - Dmarts - CVR3 (copy)_370984075413647392]&#13;&#10;WHEN &apos;Dmarts - Incentive spend as % of Platform&apos; THEN [KPI - Shops - Incentive spend as % of Platform (copy)_370984075414327331]&#13;&#10;WHEN &apos;Dmarts - Incentive spend on QC trial in Dmarts (as % of all incentive spend)&apos; THEN [KPI - Dmarts - Incentive spend as % of Platform (copy)_370984075414536229]&#13;&#10;WHEN &apos;Dmarts - M1 Retention of QC Trials via Dmarts&apos; THEN [KPI - QC - M1 Retention (copy)_370984075412230171]&#13;&#10;WHEN &apos;Dmarts - M3 Retention of QC Trials via Dmarts&apos; THEN [KPI - Dmarts - M1 Retention of QC Trials via Dmarts (copy)_370984075413454878]&#13;&#10;WHEN &apos;Dmarts - MAU as % of Platform&apos; THEN [KPI - QC - QC MAU as % of Platform (copy)_370984075407503362]&#13;&#10;WHEN &apos;Dmarts - Orders as % of Platform&apos; THEN [KPI - Dmarts - GMV as % of Platform (copy)_370984075408400392]&#13;&#10;WHEN &apos;Dmarts - Partial Fulfillment Rate&apos; THEN [KPI - Dmarts - GMV as % of Platform (copy)_370984075417489460]&#13;&#10;WHEN &apos;Dmarts - QC Cross Sells via Dmarts as % of QC Prospects&apos; THEN [KPI - Dmarts - CVR3 (copy)_370984075411185687]&#13;&#10;WHEN &apos;Dmarts - Revenue fees as % of ABV (realised)&apos; THEN [KPI - Dmarts - GMV as % of Platform (copy)_370984075416514607]&#13;&#10;WHEN &apos;Dmarts - SKU Availability&apos; THEN [KPI - Dmarts - GMV as % of Platform (copy)_370984075416252462]&#13;&#10;WHEN &apos;Dmarts - Vendor Sessions as % of Platform&apos; THEN [KPI - Dmarts - CVR3 (copy)_370984075410468882]&#13;&#10;WHEN &apos;QC - MAU&apos; THEN SUM([cdwh_qc_mau])&#13;&#10;WHEN &apos;QC - GMV&apos; THEN SUM([cdwh_qc_gmv])&#13;&#10;WHEN &apos;QC - Orders&apos; THEN SUM([cdwh_qc_orders])&#13;&#10;WHEN &apos;QC - Trials&apos; THEN SUM([qc_trials])&#13;&#10;WHEN &apos;QC -  Incentive spend on QC early (as % of all incentive spend)&apos; THEN [KPI - QC -  Incentive spend on QC trial (as % of all incentive spend) (copy)_370984075415371816]&#13;&#10;WHEN &apos;QC -  Incentive spend on QC trial (as % of all incentive spend)&apos; THEN [KPI - Shops -  Incentive spend on QC trial in Shops (as % of all incentive spend) (copy)_370984075414966311]&#13;&#10;WHEN &apos;QC - CVR3&apos; THEN [KPI - Shops - CVR3 (copy)_370984075408973837]&#13;&#10;WHEN &apos;QC - Cross Sells as % of QC Prospects&apos; THEN [KPI - Shops - QC Cross Sells via Shops as % of QC Prospects (copy)_370984075411562521]&#13;&#10;WHEN &apos;QC - GMV as % of Platform&apos; THEN [KPI - Shops - GMV as % of Platform (copy)_370984075408310279]&#13;&#10;WHEN &apos;QC - Incentive spend as % of Platform&apos; THEN [KPI - Dmarts - Incentive spend as % of Platform (copy)_370984075414429732]&#13;&#10;WHEN &apos;QC - M1 Retention&apos; THEN [KPI - Dmarts - CVR3 (copy)_370984075411886106]&#13;&#10;WHEN &apos;QC - M3 Retention&apos; THEN [KPI - QC - M1 Retention (copy)_370984075413553183]&#13;&#10;WHEN &apos;QC - MAU as % of Platform&apos; THEN [Calculation_370984075400355840]&#13;&#10;WHEN &apos;QC - Orders as % of Platform&apos; THEN [KPI - Shops - Orders as % of Platform (copy)_370984075408584714]&#13;&#10;WHEN &apos;QC - Vendor Sessions as % of Platform&apos; THEN [KPI - Dmarts - Vendor Sessions as % of Platform (copy)_370984075410694164]&#13;&#10;WHEN &apos;Shops - MAU&apos; THEN SUM([cdwh_ls_mau])&#13;&#10;WHEN &apos;Shops - GMV&apos; THEN SUM([cdwh_ls_gmv])&#13;&#10;WHEN &apos;Shops - Orders&apos; THEN SUM([cdwh_ls_orders])&#13;&#10;WHEN &apos;Shops - QC Trials via Shops&apos; THEN SUM([qc_trials_in_ls])&#13;&#10;WHEN &apos;Shops - AAA GMV&apos; THEN SUM([cdwh_ls_aaa_gmv])&#13;&#10;WHEN &apos;Shops - AAA Live Chains&apos; THEN SUM([ls_aaa_live_chains])&#13;&#10;WHEN &apos;Shops - AAA CVR3&apos; THEN [KPI - Shops - CVR3 (copy)_370984075418181686]&#13;&#10;WHEN &apos;Shops - AAA Mark-up vs. Dmarts&apos; THEN [KPI - Shops - MAU as % of Platform (copy)_370984075418488887]&#13;&#10;WHEN &apos;Shops - AAA Promo Penetration&apos; THEN [KPI - Shops - GMV as % of Platform (copy)_370984075419119672]&#13;&#10;WHEN &apos;Shops - Avg. # of Active SKUs per Vendor (only AAAs)&apos; THEN [KPI - Dmarts - Days on Hand (copy)_370984075419775035]&#13;&#10;WHEN &apos;Shops - CVR3&apos; THEN [KPI - Dmarts - CVR3 (copy)_370984075408887820]&#13;&#10;WHEN &apos;Shops - Content Quality Score&apos; THEN [KPI - Dmarts - Days on Hand (copy)_370984075420336189]&#13;&#10;WHEN &apos;Shops - GMV as % of Platform&apos; THEN [KPI - Dmarts - GMV as % of Platform (copy)_370984075408228358]&#13;&#10;WHEN &apos;Shops - Incentive spend as % of GMV&apos; THEN [KPI - Dmarts - Incentive spend as % of GMV (copy)_370984075413815329]&#13;&#10;WHEN &apos;Shops - Incentive spend as % of Platform&apos; THEN [KPI - Shops - Incentive spend as % of GMV (copy)_370984075414192162]&#13;&#10;WHEN &apos;Shops - Incentive spend on QC trial in Shops (as % of all incentive spend)&apos; THEN [KPI - Dmarts -  Incentive spend on QC trial in Dmarts (as % of all incentive spend) (copy)_370984075414724646]&#13;&#10;WHEN &apos;Shops - M1 Retention of QC Trials via Shops&apos; THEN [KPI - Dmarts - M1 Retention of QC Trials via Dmarts (copy)_370984075413180444]&#13;&#10;WHEN &apos;Shops - M3 Retention of QC Trials via Shops&apos; THEN [KPI - Shops - M1 Retention of QC Trials via Shops (copy)_370984075413327901]&#13;&#10;WHEN &apos;Shops - MAU as % of Platform&apos; THEN [KPI - Dmarts - Dmarts MAU as % of Platform (copy)_370984075407609859]&#13;&#10;WHEN &apos;Shops - Monthly GMV per Active Vendor&apos; THEN [Calculation_370984075409563664]&#13;&#10;WHEN &apos;Shops - OOS Fail Rate&apos; THEN [KPI - Shops - MAU as % of Platform (copy)_370984075409891345]&#13;&#10;WHEN &apos;Shops - Orders as % of Platform&apos; THEN [KPI - Dmarts - Orders as % of Platform (copy)_370984075408494601]&#13;&#10;WHEN &apos;Shops - Partial Fulfillment Rate (only Pelican Orders)&apos; THEN [KPI - Dmarts - Partial Fulfillment Rate (copy)_370984075419500601]&#13;&#10;WHEN &apos;Shops - QC Cross Sells via Shops as % of QC Prospects&apos; THEN [KPI - Dmarts - QC Cross Sells via Dmarts as % of QC Prospects (copy)_370984075411402776]&#13;&#10;WHEN &apos;Shops - Vendor Sessions as % of Platform&apos; THEN [KPI - QC - Vendor Sessions as % of Platform (copy)_370984075410776085]&#13;&#10;END' />
            </column>
            <column caption='Granularity C' datatype='string' name='[Calculation_1343761595218702343]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;DH Group&quot; THEN &quot;DH Group&quot;&#13;&#10;    WHEN &quot;Management Entity&quot; THEN [management_entity]&#13;&#10;    WHEN &quot;Country&quot; THEN [country_name]&#13;&#10;END' />
            </column>
            <column caption='User Entitlements' datatype='boolean' name='[Calculation_1343761595230257169]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[username] = USERNAME()' />
            </column>
            <column caption='KPI - QC - MAU as % of Platform' datatype='real' default-format='p0.0%' name='[Calculation_370984075400355840]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cdwh_qc_mau])/SUM([cdwh_pl_mau])' />
            </column>
            <column caption='KPI - Shops - Monthly GMV per Active Vendor' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_370984075409563664]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cdwh_ls_aaa_gmv])/SUM([cdwh_ls_aaa_vendors])' />
            </column>
            <column caption='KPI - Dmarts - Assortment Quality Score' datatype='real' default-format='N' name='[Calculation_370984075415814189]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;Country&quot; THEN AVG([aqs_country])&#13;&#10;    WHEN &quot;Management Entity&quot; THEN AVG([aqs_entity])&#13;&#10;    ELSE AVG([aqs_country])&#13;&#10;END' />
            </column>
            <column caption='Color' datatype='string' name='[Granularity T (copy)_1343761595219640336]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Granularity T (copy)_1343761595219587087]&#13;&#10;    WHEN &quot;DH Group&quot; THEN &quot;DH Group&quot;&#13;&#10;    WHEN &quot;Management Entity&quot; THEN [management_entity]&#13;&#10;    WHEN &quot;Country&quot; THEN [country_name]&#13;&#10;END' />
            </column>
            <column caption='KPI - Shops - Incentive spend on QC trial in Shops (as % of all incentive spend)' datatype='real' default-format='p0.0%' name='[KPI - Dmarts -  Incentive spend on QC trial in Dmarts (as % of all incentive spend) (copy)_370984075414724646]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([bima_dh_inc_qc_trial_in_ls])/SUM([bima_pl_dh_inc])' />
            </column>
            <column caption='KPI - Shops - CVR3' datatype='real' default-format='p0.0%' name='[KPI - Dmarts - CVR3 (copy)_370984075408887820]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ls_vendor_sessions_w_transaction])/SUM([ls_vendor_sessions])' />
            </column>
            <column caption='KPI - Dmarts - Vendor Sessions as % of Platform' datatype='real' default-format='p0.0%' name='[KPI - Dmarts - CVR3 (copy)_370984075410468882]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dm_vendor_sessions])/SUM([pl_sessions])' />
            </column>
            <column caption='KPI - Dmarts - QC Cross Sells via Dmarts as % of QC Prospects' datatype='real' default-format='p0.0%' name='[KPI - Dmarts - CVR3 (copy)_370984075411185687]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qc_xsells_in_dm])/SUM([qc_prospects])' />
            </column>
            <column caption='KPI - QC - M1 Retention' datatype='real' default-format='p0.0%' name='[KPI - Dmarts - CVR3 (copy)_370984075411886106]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qc_trials_m1])/SUM([qc_trials_mm1])' />
            </column>
            <column caption='KPI - Dmarts - Incentive spend as % of GMV' datatype='real' default-format='p0.0%' name='[KPI - Dmarts - CVR3 (copy)_370984075413647392]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([bima_dm_dh_inc])/SUM([cdwh_dm_gmv])' />
            </column>
            <column caption='KPI - Dmarts - Days on Hand' datatype='real' default-format='N' name='[KPI - Dmarts - CVR3 (copy)_370984075416961075]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([avg_daily_book_value])/SUM([avg_daily_cogs])' />
            </column>
            <column caption='KPI - Dmarts - Covered MAU per Store' datatype='real' default-format='N' name='[KPI - Dmarts - Days on Hand (copy)_370984075417641013]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dmart_covered_mau])/SUM([active_warehouses])' />
            </column>
            <column caption='KPI - Shops - Avg. # of Active SKUs per Vendor (only AAAs)' datatype='real' default-format='N' name='[KPI - Dmarts - Days on Hand (copy)_370984075419775035]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([avg_active_skus_per_ls_vendor]*[ls_vendors_w_skus])/SUM([ls_vendors_w_skus])' />
            </column>
            <column caption='KPI - Shops - Content Quality Score' datatype='real' default-format='N' name='[KPI - Dmarts - Days on Hand (copy)_370984075420336189]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ls_cqs_agg]*[ls_no_products])/SUM([ls_no_products])' />
            </column>
            <column caption='KPI - Shops - MAU as % of Platform' datatype='real' default-format='p0.0%' name='[KPI - Dmarts - Dmarts MAU as % of Platform (copy)_370984075407609859]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cdwh_ls_mau])/SUM([cdwh_pl_mau])' />
            </column>
            <column caption='KPI - Shops - GMV as % of Platform' datatype='real' default-format='p0.0%' name='[KPI - Dmarts - GMV as % of Platform (copy)_370984075408228358]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cdwh_ls_gmv])/SUM([cdwh_pl_gmv])' />
            </column>
            <column caption='KPI - Dmarts - Orders as % of Platform' datatype='real' default-format='p0.0%' name='[KPI - Dmarts - GMV as % of Platform (copy)_370984075408400392]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cdwh_dm_orders])/SUM([cdwh_pl_orders])' />
            </column>
            <column caption='KPI - Dmarts - CVR3' datatype='real' default-format='p0.0%' name='[KPI - Dmarts - GMV as % of Platform (copy)_370984075408777227]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dm_vendor_sessions_w_transaction])/SUM([dm_vendor_sessions])' />
            </column>
            <column caption='KPI - Dmarts - SKU Availability' datatype='real' default-format='p0.0%' name='[KPI - Dmarts - GMV as % of Platform (copy)_370984075416252462]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([availability_numerator])/SUM([availability_denominator])' />
            </column>
            <column caption='KPI - Dmarts - Revenue fees as % of ABV (realised)' datatype='real' default-format='p0.0%' name='[KPI - Dmarts - GMV as % of Platform (copy)_370984075416514607]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cdwh_dm_revenue_fees])/SUM([cdwh_dm_gbv])' />
            </column>
            <column caption='KPI - Dmarts - Partial Fulfillment Rate' datatype='real' default-format='p0.0%' name='[KPI - Dmarts - GMV as % of Platform (copy)_370984075417489460]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([partial_orders_store_perf])/SUM([successful_orders_store_perf])' />
            </column>
            <column caption='KPI - Shops - Incentive spend as % of GMV' datatype='real' default-format='p0.0%' name='[KPI - Dmarts - Incentive spend as % of GMV (copy)_370984075413815329]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([bima_ls_dh_inc])/SUM([cdwh_ls_gmv])' />
            </column>
            <column caption='KPI - QC - Incentive spend as % of Platform' datatype='real' default-format='p0.0%' name='[KPI - Dmarts - Incentive spend as % of Platform (copy)_370984075414429732]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([bima_qc_dh_inc])/SUM([bima_pl_dh_inc])' />
            </column>
            <column caption='KPI - Dmarts - Incentive spend on QC trial in Dmarts (as % of all incentive spend)' datatype='real' default-format='p0.0%' name='[KPI - Dmarts - Incentive spend as % of Platform (copy)_370984075414536229]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([bima_dh_inc_qc_trial_in_dm])/SUM([bima_pl_dh_inc])' />
            </column>
