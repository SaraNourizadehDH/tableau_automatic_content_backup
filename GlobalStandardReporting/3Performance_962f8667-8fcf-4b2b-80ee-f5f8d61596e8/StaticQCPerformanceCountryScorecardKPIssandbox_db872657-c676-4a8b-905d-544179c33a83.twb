              <calculation class='tableau' formula='SUM([cdwh_ls_aaa_gmv])/SUM([cdwh_ls_aaa_vendors])' />
            </column>
            <column caption='KPI - Dmarts - Assortment Quality Score' datatype='real' default-format='N' name='[Calculation_370984075415814189]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;Country&quot; THEN AVG([aqs_country])&#13;&#10;    WHEN &quot;Management Entity&quot; THEN AVG([aqs_entity])&#13;&#10;    ELSE AVG([aqs_country])&#13;&#10;END' />
            </column>
            <column caption='Granularity T -1' datatype='string' name='[Granularity C (copy)_1343761595218890760]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Granularity (copy)_1343761595218599942]&#13;&#10;    WHEN &quot;DH Group&quot; THEN &quot;DH Group&quot;&#13;&#10;    WHEN &quot;Management Entity&quot; THEN &quot;DH Group&quot;&#13;&#10;    WHEN &quot;Country&quot; THEN [management_entity]&#13;&#10;END' />
            </column>
            <column caption='Granularity T' datatype='string' name='[Granularity C (copy)_1343761595219079178]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Granularity (copy)_1343761595218599942]&#13;&#10;    WHEN &quot;DH Group&quot; THEN &quot;DH Group&quot;&#13;&#10;    WHEN &quot;Management Entity&quot; THEN [management_entity]&#13;&#10;    WHEN &quot;Country&quot; THEN [country_name]&#13;&#10;END' />
            </column>
            <column caption='Granularity T -2' datatype='string' name='[Granularity T -1 (copy)_1343761595219132427]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Granularity (copy)_1343761595218599942]&#13;&#10;    WHEN &quot;DH Group&quot; THEN &quot;DH Group&quot;&#13;&#10;    WHEN &quot;Management Entity&quot; THEN &quot;DH Group&quot;&#13;&#10;    WHEN &quot;Country&quot; THEN &quot;DH Group&quot;&#13;&#10;END' />
            </column>
            <column caption='KPI - Shops - Incentive spend on QC trial in Shops (as % of all incentive spend)' datatype='real' default-format='p0.0%' name='[KPI - Dmarts -  Incentive spend on QC trial in Dmarts (as % of all incentive spend) (copy)_370984075414724646]' role='measure' type='quantitative'>
