      </column>
      <column caption='KPI - QC -  Incentive spend on QC trial (as % of all incentive spend)' datatype='real' default-format='p0.0%' name='[KPI - Shops -  Incentive spend on QC trial in Shops (as % of all incentive spend) (copy)_370984075414966311]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([bima_dh_inc_qc_trial])/SUM([bima_pl_dh_inc])' />
      </column>
      <column caption='KPI - QC - CVR3' datatype='real' default-format='p0.0%' name='[KPI - Shops - CVR3 (copy)_370984075408973837]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([qc_vendor_sessions_w_transaction])/SUM([qc_vendor_sessions])' />
      </column>
      <column caption='KPI - Shops - AAA CVR3' datatype='real' default-format='p0.0%' name='[KPI - Shops - CVR3 (copy)_370984075418181686]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ls_aaa_vendor_sessions_w_transaction])/SUM([ls_aaa_vendor_sessions])' />
      </column>
      <column caption='KPI - QC - GMV as % of Platform' datatype='real' default-format='p0.0%' name='[KPI - Shops - GMV as % of Platform (copy)_370984075408310279]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cdwh_qc_gmv])/SUM([cdwh_pl_gmv])' />
      </column>
      <column caption='KPI - Shops - AAA Promo Penetration' datatype='real' default-format='p0.0%' name='[KPI - Shops - GMV as % of Platform (copy)_370984075419119672]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([promos_promo_orders])/SUM([promos_all_orders])' />
      </column>
      <column caption='KPI - Shops - Incentive spend as % of Platform' datatype='real' default-format='p0.0%' name='[KPI - Shops - Incentive spend as % of GMV (copy)_370984075414192162]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([bima_ls_dh_inc])/SUM([bima_pl_dh_inc])' />
      </column>
      <column caption='KPI - Dmarts - Incentive spend as % of Platform' datatype='real' default-format='p0.0%' name='[KPI - Shops - Incentive spend as % of Platform (copy)_370984075414327331]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([bima_dm_dh_inc])/SUM([bima_pl_dh_inc])' />
      </column>
      <column caption='KPI - Shops - M3 Retention of QC Trials via Shops' datatype='real' default-format='p0.0%' name='[KPI - Shops - M1 Retention of QC Trials via Shops (copy)_370984075413327901]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([qc_trials_in_ls_m3])/SUM([qc_trials_in_ls_mm3])' />
      </column>
      <column caption='KPI - Shops - OOS Fail Rate' datatype='real' default-format='p0.0%' name='[KPI - Shops - MAU as % of Platform (copy)_370984075409891345]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cdwh_ls_oos_failed_orders])/SUM([cdwh_ls_total_orders])' />
      </column>
      <column caption='KPI - Shops - AAA Mark-up vs. Dmarts' datatype='real' default-format='p0.0%' name='[KPI - Shops - MAU as % of Platform (copy)_370984075418488887]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([mark_up_vs_dmarts]*[mark_up_weight])/SUM([mark_up_weight])' />
      </column>
      <column caption='KPI - QC - Orders as % of Platform' datatype='real' default-format='p0.0%' name='[KPI - Shops - Orders as % of Platform (copy)_370984075408584714]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cdwh_qc_orders])/SUM([cdwh_pl_orders])' />
      </column>
      <column caption='KPI - QC - Cross Sells as % of QC Prospects' datatype='real' default-format='p0.0%' name='[KPI - Shops - QC Cross Sells via Shops as % of QC Prospects (copy)_370984075411562521]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([qc_xsells])/SUM([qc_prospects])' />
      </column>
