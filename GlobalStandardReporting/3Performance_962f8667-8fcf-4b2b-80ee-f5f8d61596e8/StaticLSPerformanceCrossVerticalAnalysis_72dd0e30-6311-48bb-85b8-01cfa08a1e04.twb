      <column caption='Customer Cnt at Trial' datatype='integer' name='[Calculation_299348667831717888]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(sum([Customer_Cnt]),-max([Number_Of_Months]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% Active Customers' datatype='real' name='[Calculation_299348667833798659]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Sum([Customer_Cnt])/LOOKUP(sum([Customer_Cnt]),-max([Number_Of_Months]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Frequency' datatype='real' name='[Calculation_6584684896274718720]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Sum([Order_Cnt])/Sum([Customer_Cnt])' />
      </column>
      <column caption='Reorder Rate' datatype='real' name='[Calculation_6584684896275869697]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Sum([Reordered_Customer_Cnt])/Sum([Customer_Cnt_PM])' />
