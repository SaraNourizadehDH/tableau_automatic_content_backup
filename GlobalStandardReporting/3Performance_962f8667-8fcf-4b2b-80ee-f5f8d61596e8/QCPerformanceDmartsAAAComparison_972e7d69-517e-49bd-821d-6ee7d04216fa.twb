      <table>
        <view>
          <datasources>
            <datasource caption='dmarts_aaa_comparison_analysis (dev_dmart)' name='federated.1utiun81m2dv8910blygj0ovyi7m' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Active Users' caption='KPI 1 (Growth)' datatype='real' name='[Parameter 2]' param-domain-type='list' role='measure' type='quantitative' value='4.'>
              <calculation class='tableau' formula='4.' />
              <aliases>
                <alias key='1.' value='Orders' />
                <alias key='2.' value='Vendor Sessions' />
                <alias key='3.' value='CVR3' />
                <alias key='4.' value='Active Users' />
                <alias key='5.' value='% Incentivized orders' />
                <alias key='6.' value='Vouchers as % of GMV' />
                <alias key='7.' value='Active Vendors' />
                <alias key='8.' value='GMV' />
                <alias key='9.' value='D/O/S' />
                <alias key='10.' value='Frequency' />
                <alias key='11.' value='Trials' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1utiun81m2dv8910blygj0ovyi7m'>
            <column caption='Active Users' datatype='integer' name='[Active_Users]' role='measure' type='quantitative' />
            <column caption='Active Vendors' datatype='integer' name='[Active_Vendors]' role='measure' type='quantitative' />
            <column caption='Cvr3' datatype='real' name='[CVR3]' role='measure' type='quantitative' />
            <column caption='# KPI 1 (Growth)' datatype='real' name='[Calculation_591730817689804819]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN 1 THEN [Orders]&#10;WHEN 2 THEN [Vendor_Sessions]&#10;WHEN 3 THEN [CVR3]&#10;WHEN 4 THEN [Active_Users]&#10;WHEN 5 THEN [Perc_Incentive_Orders]&#10;WHEN 6 THEN [Vouchers_by_GMV]&#10;WHEN 7 THEN [Active_Vendors]&#10;WHEN 8 THEN [GMV]&#10;WHEN 9 THEN NULL &#10;WHEN 10 THEN [Frequency]&#10;WHEN 11 THEN [Trials]&#10;END' />
            </column>
            <column caption='Country name' datatype='string' name='[Country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[Dimension]' role='dimension' type='nominal' />
            <column datatype='real' name='[Frequency]' role='measure' type='quantitative' />
            <column datatype='real' name='[GMV]' role='measure' type='quantitative' />
            <column caption='Granularity Level' datatype='string' name='[Granularity_Level]' role='dimension' type='nominal' />
            <column caption='* KPI 1 (Growth) (Display)' datatype='string' name='[KPI 1 (Growth) (copy)_2428636515981807616]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN 1 THEN STR(ROUND([Orders]/1000,2))+&quot;K&quot;&#10;WHEN 2 THEN STR(ROUND([Vendor_Sessions]/1000,2))+&quot;K&quot;&#10;WHEN 3 THEN STR(ROUND([CVR3]*100,2))+&quot;%&quot;&#10;WHEN 4 THEN STR(ROUND([Active_Users]/1000,2))+&quot;K&quot;&#10;WHEN 5 THEN STR(ROUND([Perc_Incentive_Orders]*100,2))+&quot;%&quot;&#10;WHEN 6 THEN STR(ROUND([Vouchers_by_GMV]*100,2))+&quot;%&quot;&#10;WHEN 7 THEN STR([Active_Vendors])&#10;WHEN 8 THEN STR(ROUND([GMV]/1000,2))+&quot;K&quot;&#10;WHEN 9 THEN NULL &#10;WHEN 10 THEN STR(ROUND([Frequency],2))&#10;WHEN 11 THEN STR(ROUND([Trials]/1000,2))+&quot;K&quot;&#10;END' />
            </column>
            <column caption='Management Entity' datatype='string' name='[Management_Entity]' role='dimension' type='nominal' />
            <column datatype='integer' name='[Orders]' role='measure' type='quantitative' />
            <column caption='Perc Incentive Orders' datatype='real' name='[Perc_Incentive_Orders]' role='measure' type='quantitative' />
