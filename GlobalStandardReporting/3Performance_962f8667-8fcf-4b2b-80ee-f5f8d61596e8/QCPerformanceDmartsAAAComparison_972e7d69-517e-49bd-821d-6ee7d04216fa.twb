            <column caption='Time period' datatype='date' name='[Time_period]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[Trials]' role='measure' type='quantitative' />
            <column caption='Vendor Sessions' datatype='integer' name='[Vendor_Sessions]' role='measure' type='quantitative' />
            <column caption='Vouchers by GMV' datatype='real' name='[Vouchers_by_GMV]' role='measure' type='quantitative' />
            <column-instance column='[KPI 1 (Growth) (copy)_2428636515981807616]' derivation='Attribute' name='[attr:KPI 1 (Growth) (copy)_2428636515981807616:nk]' pivot='key' type='nominal' />
