          <datasource-dependencies datasource='Parameters'>
            <column caption='X Axis' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;GAQS&quot;'>
              <calculation class='tableau' formula='&quot;GAQS&quot;' />
              <aliases>
                <alias key='&quot;Customers&quot;' value='Customers' />
                <alias key='&quot;Frequency&quot;' value='Frequency' />
                <alias key='&quot;Fresh GPV Contribution \%&quot;' value='Fresh GPV Contribution %' />
                <alias key='&quot;Minimum SKU Compliance \%&quot;' value='Minimum SKU Compliance %' />
                <alias key='&quot;Sessions&quot;' value='Menu Sessions' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0xlb8gx0zydc531h6r4wz0rljoh1'>
            <column datatype='real' name='[ABV]' role='measure' type='quantitative' />
            <column caption='Frequency' datatype='real' name='[Calculation_1185854145204133891]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders])/SUM([customers])' />
            </column>
            <column caption='Menu Sessions' datatype='integer' name='[Calculation_2092625765279252480]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([shop_details_loaded])' />
            </column>
            <column caption='Buyable Rate Score' datatype='real' name='[Calculation_3574310006545289217]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ATTR([buyable_rate])' />
            </column>
            <column caption='X Axis' datatype='real' name='[Calculation_831125277877043201]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &quot;Average Active SKUs&quot; THEN [Calculation_831125277884456962]&#10;    WHEN &quot;L3 Category Coverage %&quot; THEN [Calculation_831125277884940292] * 100&#10;    WHEN &quot;Buyable Rate&quot; THEN [Calculation_3574310006545289217] * 100&#10;    WHEN &quot;Minimum SKU Compliance %&quot; THEN [Calculation_831125277887770629] * 100&#10;    WHEN &quot;Ultra Fresh GPV Contribution&quot; THEN [Calculation_831125277888065543] * 100&#10;    WHEN &quot;Fresh GPV Contribution %&quot; THEN [Calculation_831125277888163849] * 100&#10;    WHEN &quot;GAQS&quot; THEN [Calculation_831125277889286159]&#10;    WHEN &quot;Frequency&quot; THEN [Calculation_831125277890977809]&#10;    WHEN &quot;Sessions&quot; THEN [Calculation_2092625765279252480]&#10;    WHEN &quot;mCVR3&quot; THEN [Calculation_831125277888417803] * 100&#10;    WHEN &quot;Orders&quot; THEN [Calculation_831125277888569356]&#10;    WHEN &quot;Customers&quot; THEN [Calculation_831125277888647181]&#10;    WHEN &quot;GMV (EUR)&quot; THEN [Calculation_831125277888770062]&#10;    WHEN &quot;ABV&quot; THEN [Calculation_831125277891215378]&#10;END' />
            </column>
            <column caption='Average Active SKUs' datatype='real' name='[Calculation_831125277884456962]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([count_active_skus])' />
            </column>
            <column caption='L3 Category Coverage %' datatype='real' name='[Calculation_831125277884940292]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([l3_cat_coverage])' />
            </column>
            <column caption='Minimum SKU Compliance %' datatype='real' name='[Calculation_831125277887770629]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([min_sku_compliance])' />
            </column>
            <column caption='Ultra Fresh GPV Contribution %' datatype='real' name='[Calculation_831125277888065543]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([UF_GPV_Cont])' />
