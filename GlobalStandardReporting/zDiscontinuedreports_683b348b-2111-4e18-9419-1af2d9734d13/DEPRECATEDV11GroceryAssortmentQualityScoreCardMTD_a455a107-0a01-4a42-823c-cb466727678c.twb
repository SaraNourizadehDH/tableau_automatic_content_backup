            <column caption='X Axis' datatype='real' name='[Calculation_831125277877043201]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &quot;Average Active SKUs&quot; THEN [Calculation_831125277884456962]&#10;    WHEN &quot;L3 Category Coverage %&quot; THEN [Calculation_831125277884940292] * 100&#10;    WHEN &quot;Buyable Rate&quot; THEN [Calculation_3574310006545289217] * 100&#10;    WHEN &quot;Minimum SKU Compliance %&quot; THEN [Calculation_831125277887770629] * 100&#10;    WHEN &quot;Ultra Fresh GPV Contribution&quot; THEN [Calculation_831125277888065543] * 100&#10;    WHEN &quot;Fresh GPV Contribution %&quot; THEN [Calculation_831125277888163849] * 100&#10;    WHEN &quot;GAQS&quot; THEN [Calculation_831125277889286159]&#10;    WHEN &quot;Frequency&quot; THEN [Calculation_831125277890977809]&#10;    WHEN &quot;Sessions&quot; THEN [Calculation_2092625765279252480]&#10;    WHEN &quot;mCVR3&quot; THEN [Calculation_831125277888417803] * 100&#10;    WHEN &quot;Orders&quot; THEN [Calculation_831125277888569356]&#10;    WHEN &quot;Customers&quot; THEN [Calculation_831125277888647181]&#10;    WHEN &quot;GMV (EUR)&quot; THEN [Calculation_831125277888770062]&#10;    WHEN &quot;ABV&quot; THEN [Calculation_831125277891215378]&#10;END' />
