    <worksheet name='Asst. Perception'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontsize='14'>Output Metrics</run>
            <run fontalignment='1'>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='LS - AQS - Overview' name='federated.0xlb8gx0zydc531h6r4wz0rljoh1' />
            <datasource caption='LS - AQS - Min SKU Compliance (Deep-Dive) - Vendor' name='federated.0icambr0uxy6l016drfo916m5x6g' />
          </datasources>
          <datasource-dependencies datasource='federated.0icambr0uxy6l016drfo916m5x6g'>
            <column-instance column='[vendor_name]' derivation='None' name='[none:vendor_name:nk]' pivot='key' type='nominal' />
            <column caption='Vendor Name' datatype='string' name='[vendor_name]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0xlb8gx0zydc531h6r4wz0rljoh1'>
            <column datatype='real' name='[ABV]' role='measure' type='quantitative' />
            <column caption='ABV' datatype='real' name='[Calculation_1185854145202937857]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([GMV_EUR])/SUM([total_orders])' />
            </column>
            <column caption='Frequency' datatype='real' name='[Calculation_1185854145204133891]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders])/SUM([customers])' />
            </column>
