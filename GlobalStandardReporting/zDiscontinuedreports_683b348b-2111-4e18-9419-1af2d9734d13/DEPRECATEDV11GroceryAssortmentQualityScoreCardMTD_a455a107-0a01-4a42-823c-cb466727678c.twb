      </column>
      <column caption='UF GPV Cont CF' datatype='string' name='[Calculation_96123759927566341]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [UF_GPV_Cont] &lt;= .599 OR [UF_GPV_Cont] &gt;= .3699 THEN &quot;Poor&quot;&#10;ELSEIF ([UF_GPV_Cont] &gt; .6 AND [UF_GPV_Cont] &lt;= .1199) &#10;    OR ([UF_GPV_Cont] &gt;= .30 AND [UF_GPV_Cont] &lt;= .3599) THEN &quot;Fair&quot;&#10;ELSEIF ([UF_GPV_Cont] &gt;= .12 AND [UF_GPV_Cont] &lt;= .1799) &#10;    OR ([UF_GPV_Cont] &gt;= .24 AND [UF_GPV_Cont] &lt;= .2999) THEN &quot;Good&quot;&#10;ELSEIF [UF_GPV_Cont] &gt;= .18 AND [UF_GPV_Cont] &lt;= .2399 THEN &quot;Excellent&quot;&#10;END' />
      </column>
      <column caption='F GPV Cont CF' datatype='string' name='[Calculation_96123759928672262]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [F_GPV_Cont] &lt; 0.1299 OR [F_GPV_Cont] &gt;= 0.28 THEN &quot;Poor&quot;&#10;ELSEIF ([F_GPV_Cont] &gt;= 0.13 AND [F_GPV_Cont] &lt;= 0.1599) &#10;    OR ([F_GPV_Cont] &gt;= 0.25 AND [F_GPV_Cont] &lt;= 0.2799) THEN &quot;Fair&quot;&#10;ELSEIF ([F_GPV_Cont] &gt;= 0.16 AND [F_GPV_Cont] &lt;= 0.1899) &#10;    OR ([F_GPV_Cont] &gt;= 0.22 AND [F_GPV_Cont] &lt;= 0.2499) THEN &quot;Good&quot;&#10;ELSEIF [F_GPV_Cont] &gt;= 0.19 AND [F_GPV_Cont] &lt;= 0.2199 THEN &quot;Excellent&quot;&#10;END' />
      </column>
      <column caption='F GPV Cont' datatype='real' name='[F_GPV_Cont]' role='measure' type='quantitative' />
      <column caption='F GPV Cont score' datatype='real' name='[F_GPV_Cont_score]' role='measure' type='quantitative' />
