      <aliases enabled='yes' />
      <column caption='Avg delivery time' datatype='real' name='[Avg_delivery_time]' role='measure' type='quantitative' />
      <column caption='Avg Fail rate' datatype='real' default-format='p0.00%' name='[Calculation_3249980499531079680]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([failed_orders])/SUM([orders])' />
      </column>
      <column caption='AOV' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_3249980499536130049]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gmv_eur])/SUM([orders])' />
      </column>
      <column caption='Store Active days' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_3249980499555225602]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [restaurant_name],[Calculation_595038146533093377]: COUNTD([Calculation_595038146533093377])}' />
      </column>
      <column caption='Days Active rate' datatype='integer' name='[Calculation_3249980499564539907]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(STR(DAY([Calculation_595038146533093377]))+STR(MONTH([Calculation_595038146533093377]))+STR(YEAR([Calculation_595038146533093377])))' />
      </column>
      <column caption='KPIs' datatype='real' name='[Calculation_595038146529935360]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Orders&apos;                                   THEN ROUND(AVG([orders]))&#10;WHEN &apos;Amt GMV&apos;                                  THEN ROUND(AVG([gmv_eur]))&#10;WHEN &apos;Acquisitions&apos;                             THEN (SUM([acquisitions]))&#10;WHEN &apos;AOV&apos;                                      THEN ROUND([Calculation_3249980499536130049])&#10;WHEN &apos;Avg Delivery Time&apos;                        THEN AVG([Avg_delivery_time])&#10;WHEN &apos;Items Sold&apos;                               THEN SUM([items_delivered])&#10;WHEN &apos;Avg Fail rate&apos;                            THEN ([Calculation_3249980499531079680])&#10;WHEN &apos;Active days&apos;                              THEN (SUM([Calculation_3249980499555225602]))&#10;WHEN &apos;SKU&apos;                                      THEN (AVG([sku_count]))&#10;END' />
      </column>
      <column caption='Date' datatype='date' name='[Calculation_595038146533093377]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parameter 1], [order_date], &apos;monday&apos;))' />
      </column>
      <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
        <calculation class='tableau' formula='1' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='_tableau_geoviz_kpis' datatype='table' name='[__tableau_internal_object_id__].[_tableau_geoviz_kpis_AE3EBE83F4BF4D5280B353CBF55D3093]' role='measure' type='quantitative' />
      <column caption='Acquisitions' datatype='integer' default-format='n#,##0;-#,##0' name='[acquisitions]' role='measure' type='quantitative' />
      <column aggregation='None' caption='City' datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal'>
        <semantic-values semantic-role='[City].[Name]'>
          <semantic-value key='&quot;new taipei city&quot;' value='&quot;Taipei&quot;' />
          <semantic-value key='&quot;taipei city&quot;' value='&quot;Taipei&quot;' />
        </semantic-values>
      </column>
      <column aggregation='None' caption='Common Name' datatype='string' name='[common_name]' role='dimension' semantic-role='[Country].[Name]' type='nominal' />
      <column caption='Completed Orders' datatype='integer' name='[completed_orders]' role='measure' type='quantitative' />
      <column caption='Display Name' datatype='string' name='[display_name]' role='dimension' type='nominal' />
      <column caption='Failed Orders' datatype='integer' default-format='p0.00%' name='[failed_orders]' role='measure' type='quantitative' />
      <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
      <column caption='Amt GMV' datatype='real' name='[gmv_eur]' role='measure' type='quantitative' />
      <column caption='Items Delivered' datatype='integer' name='[items_delivered]' role='measure' type='quantitative' />
      <column aggregation='Avg' caption='Latitude' datatype='real' name='[latitude]' role='measure' semantic-role='[Geographical].[Latitude]' type='quantitative' />
      <column aggregation='Avg' caption='Longitude' datatype='real' name='[longitude]' role='measure' semantic-role='[Geographical].[Longitude]' type='quantitative' />
      <column caption='Management Entity Group' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
      <column caption='Order Date' datatype='date' name='[order_date]' role='dimension' type='ordinal' />
      <column caption='Orders' datatype='integer' name='[orders]' role='measure' type='quantitative' />
      <column caption='Region' datatype='string' name='[region]' role='dimension' type='nominal' />
      <column caption='Restaurant Name' datatype='string' name='[restaurant_name]' role='dimension' type='nominal' />
      <column caption='Vendor Type' datatype='string' name='[shop_type]' role='dimension' type='nominal' />
      <column caption='SKU' datatype='integer' name='[sku_count]' role='measure' type='quantitative' />
      <column caption='Warehouse Name' datatype='string' name='[warehouse_name]' role='dimension' type='nominal' />
      <column-instance column='[restaurant_name]' derivation='None' name='[none:restaurant_name:nk]' pivot='key' type='nominal' />
      <group name='[Map view]' name-style='unqualified' user:ui-builder='identity-set'>
        <groupfilter function='intersection'>
          <groupfilter function='level-members' level='[management_entity]' />
          <groupfilter function='union'>
            <groupfilter expression='false' function='filter'>
              <groupfilter function='level-members' level='[management_entity]' />
            </groupfilter>
            <groupfilter expression='ISMEMBEROF(&apos;gsr_darkstores_developer&apos;)' function='filter'>
              <groupfilter function='union'>
                <groupfilter function='member' level='[management_entity]' member='&quot;Foodpanda APAC&quot;' />
                <groupfilter function='member' level='[management_entity]' member='&quot;HungerStation&quot;' />
                <groupfilter function='member' level='[management_entity]' member='&quot;Pedidosya&quot;' />
                <groupfilter function='member' level='[management_entity]' member='&quot;Talabat&quot;' />
              </groupfilter>
            </groupfilter>
            <groupfilter expression='ISMEMBEROF(&apos;gsr_darkstores_enduser&apos;)' function='filter'>
