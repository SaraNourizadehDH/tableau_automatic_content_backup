      <aliases enabled='yes' />
      <column caption='pim_account_source_type' datatype='string' name='[Calculation_367395274170925056]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [pim_account_source] = &apos;Automated LeadGen&apos; then &apos;Automated LeadGen&apos;&#10;elseif [pim_account_source] = &apos;Self Sign Up&apos; then &apos;Self Sign Up&apos;&#10;elseif [pim_account_source] = &apos;Inbound&apos; then &apos;Inbound&apos;&#10;elseif [pim_account_source] = &apos;Own Research&apos; then &apos;Own Research&apos;&#10;else &apos;Others&apos;&#10;end' />
      </column>
      <column caption='#Units Sold per Active Vendor' datatype='real' name='[Calculation_367395274178035713]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_367395274200190988])/ (COUNTD([vendor_id]))' />
      </column>
      <column caption='ABV' datatype='real' name='[Calculation_367395274178990082]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_367395274193399812]) / countd([order_id])' />
      </column>
      <column caption='amt_gbv_eur (unique)' datatype='real' name='[Calculation_367395274193399812]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [order_id], [global_entity_id], [analytical_customer_id]: min([amt_gbv_eur])}' />
      </column>
      <column caption='amt_gmv_eur (unique)' datatype='real' name='[Calculation_367395274195075077]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [order_id], [global_entity_id], [analytical_customer_id]: min([amt_gmv_eur])}' />
      </column>
      <column caption='amt_delivery_fee_eur (unique)' datatype='real' name='[Calculation_367395274195243014]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [order_id], [global_entity_id], [analytical_customer_id]: min([amt_delivery_fee_eur])}' />
      </column>
      <column caption='amt_commission_eur (unique)' datatype='real' name='[Calculation_367395274195406855]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [order_id], [global_entity_id], [analytical_customer_id]: min([amt_commission_eur])}' />
      </column>
      <column caption='amt_commission_base_eur (unique)' datatype='real' name='[Calculation_367395274195529736]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [order_id], [global_entity_id], [analytical_customer_id]: min([amt_commission_base_eur])}' />
