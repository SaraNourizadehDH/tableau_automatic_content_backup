    <worksheet name='2.Order performance - KPIs'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ca011d' fontsize='12'>Order performance</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='ssu_pim_table (local_shops_analytics)' name='federated.0ytuoxh1y8ofbe15n2cmd0zo4yvj' />
          </datasources>
          <datasource-dependencies datasource='federated.0ytuoxh1y8ofbe15n2cmd0zo4yvj'>
            <column caption='#Units Sold per Active Vendor' datatype='real' name='[Calculation_367395274178035713]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_367395274200190988])/ (COUNTD([vendor_id]))' />
            </column>
            <column caption='ABV' datatype='real' name='[Calculation_367395274178990082]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_367395274193399812]) / countd([order_id])' />
            </column>
            <column caption='amt_gbv_eur (unique)' datatype='real' name='[Calculation_367395274193399812]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [order_id], [global_entity_id], [analytical_customer_id]: min([amt_gbv_eur])}' />
            </column>
            <column caption='amt_gmv_eur (unique)' datatype='real' name='[Calculation_367395274195075077]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [order_id], [global_entity_id], [analytical_customer_id]: min([amt_gmv_eur])}' />
            </column>
            <column caption='amt_delivery_fee_eur (unique)' datatype='real' name='[Calculation_367395274195243014]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [order_id], [global_entity_id], [analytical_customer_id]: min([amt_delivery_fee_eur])}' />
            </column>
            <column caption='amt_commission_eur (unique)' datatype='real' name='[Calculation_367395274195406855]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [order_id], [global_entity_id], [analytical_customer_id]: min([amt_commission_eur])}' />
            </column>
            <column caption='amt_commission_base_eur (unique)' datatype='real' name='[Calculation_367395274195529736]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [order_id], [global_entity_id], [analytical_customer_id]: min([amt_commission_base_eur])}' />
            </column>
            <column caption='amt_discount_eur (unique)' datatype='real' name='[Calculation_367395274195664905]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [order_id], [global_entity_id], [analytical_customer_id]: min([amt_discount_eur])}' />
            </column>
            <column caption='amt_cogs_eur (unique)' datatype='real' name='[Calculation_367395274196987915]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [order_id], [global_entity_id], [analytical_customer_id]: min([amt_cogs_eur])}' />
            </column>
            <column caption='Ordered_Quantity (unique)' datatype='real' name='[Calculation_367395274200190988]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [order_id], [global_entity_id], [analytical_customer_id]: min([Ordered_Quantity])}' />
            </column>
            <column caption='Fulfilled_Quantity (unique)' datatype='real' name='[Calculation_367395274200657933]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [order_id], [global_entity_id], [analytical_customer_id]: min([Fulfilled_Quantity])}' />
            </column>
            <column caption='Vat_Amount (unique)' datatype='real' name='[Calculation_367395274201563150]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [order_id], [global_entity_id], [analytical_customer_id]: min([Vat_Amount])}' />
            </column>
            <column caption='ABS' datatype='real' name='[Calculation_367395275917946898]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_367395274200190988]) / countd([order_id])' />
