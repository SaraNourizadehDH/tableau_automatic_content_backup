            <run bold='true' fontcolor='#ca011d' fontsize='11'>Active SSU Vendors</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='ssu_pim_table (local_shops_analytics)' name='federated.0ytuoxh1y8ofbe15n2cmd0zo4yvj' />
          </datasources>
          <datasource-dependencies datasource='federated.0ytuoxh1y8ofbe15n2cmd0zo4yvj'>
            <column caption='Zombie %' datatype='real' name='[Calculation_6431421806294642688]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(1 - (COUNTD([vendor_id]) / countd([pim_vendor_id])))' />
            </column>
            <column caption='Coalesced_region' datatype='string' name='[Calculation_6431421806300430337]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ISNULL([region]) = true and [pim_is_online] and is_sent = false then [Calculation_6431421806453096450] else [region] end' />
            </column>
            <column caption='vendors_region' datatype='string' name='[Calculation_6431421806453096450]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [vendors_global_entity_id] in (&apos;CG_QA&apos;,&#10;&apos;HF_EG&apos;,&#10;&apos;HS_BH&apos;,&#10;&apos;HS_SA&apos;,&#10;&apos;TB_AE&apos;,&#10;&apos;TB_BH&apos;,&#10;&apos;TB_JO&apos;,&#10;&apos;TB_KW&apos;,&#10;&apos;TB_OM&apos;,&#10;&apos;TB_QA&apos;,&#10;&apos;TB_SA&apos;,&#10;&apos;YS_TR&apos;) then &apos;MENA&apos;&#10;ELSEIF  [vendors_global_entity_id] in (&apos;AP_PA&apos;,&#10;&apos;PY_AR&apos;,&#10;&apos;PY_BO&apos;,&#10;&apos;PY_CL&apos;,&#10;&apos;PY_CR&apos;,&#10;&apos;PY_DO&apos;,&#10;&apos;PY_EC&apos;,&#10;&apos;PY_GT&apos;,&#10;&apos;PY_HN&apos;,&#10;&apos;PY_NI&apos;,&#10;&apos;PY_PE&apos;,&#10;&apos;PY_PY&apos;,&#10;&apos;PY_SV&apos;,&#10;&apos;PY_UY&apos;,&#10;&apos;PY_VE&apos;) then &apos;America&apos;&#10;elseif [vendors_global_entity_id] in (&apos;BM_VN&apos;,&#10;&apos;FP_BD&apos;,&#10;&apos;FP_HK&apos;,&#10;&apos;FP_KH&apos;,&#10;&apos;FP_LA&apos;,&#10;&apos;FP_MM&apos;,&#10;&apos;FP_MY&apos;,&#10;&apos;FP_PH&apos;,&#10;&apos;FP_PK&apos;,&#10;&apos;FP_SG&apos;,&#10;&apos;FP_TH&apos;,&#10;&apos;FP_TW&apos;) then &apos;Asia&apos;&#10;else &apos;Europe&apos; end' />
            </column>
            <column-instance column='[pim_vendor_id]' derivation='CountD' name='[ctd:pim_vendor_id:qk]' pivot='key' type='quantitative' />
            <column-instance column='[vendor_id]' derivation='CountD' name='[ctd:vendor_id:qk]' pivot='key' type='quantitative' />
            <column datatype='boolean' name='[is_sent]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_6431421806300430337]' derivation='None' name='[none:Calculation_6431421806300430337:nk]' pivot='key' type='nominal' />
            <column datatype='boolean' name='[pim_is_online]' role='dimension' type='nominal' />
            <column datatype='string' name='[pim_vendor_id]' role='dimension' type='nominal' />
            <column caption='Region' datatype='string' name='[region]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_6431421806294642688]' derivation='User' name='[usr:Calculation_6431421806294642688:qk]' pivot='key' type='quantitative' />
            <column caption='Vendor Id' datatype='string' name='[vendor_id]' role='dimension' type='nominal' />
            <column datatype='string' name='[vendors_global_entity_id]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0ytuoxh1y8ofbe15n2cmd0zo4yvj].[none:Calculation_6431421806300430337:nk]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:Calculation_6431421806300430337:nk]' member='&quot;America&quot;' />
              <groupfilter function='member' level='[none:Calculation_6431421806300430337:nk]' member='&quot;Asia&quot;' />
            </groupfilter>
          </filter>
          <slices>
            <column>[federated.0ytuoxh1y8ofbe15n2cmd0zo4yvj].[none:Calculation_6431421806300430337:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
