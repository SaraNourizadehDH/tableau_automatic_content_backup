      </column>
      <column caption='amt_voucher_eur (unique)' datatype='real' name='[Calculation_367395274195767306]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [order_id], [global_entity_id], [analytical_customer_id]: min([amt_voucher_eur])}' />
      </column>
      <column caption='amt_cogs_eur (unique)' datatype='real' name='[Calculation_367395274196987915]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [order_id], [global_entity_id], [analytical_customer_id]: min([amt_cogs_eur])}' />
      </column>
      <column caption='Ordered_Quantity (unique)' datatype='real' name='[Calculation_367395274200190988]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [order_id], [global_entity_id], [analytical_customer_id]: min([Ordered_Quantity])}' />
      </column>
      <column caption='Fulfilled_Quantity (unique)' datatype='real' name='[Calculation_367395274200657933]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [order_id], [global_entity_id], [analytical_customer_id]: min([Fulfilled_Quantity])}' />
      </column>
      <column caption='Vat_Amount (unique)' datatype='real' name='[Calculation_367395274201563150]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [order_id], [global_entity_id], [analytical_customer_id]: min([Vat_Amount])}' />
      </column>
      <column caption='Adjusted_Item_COGS (unique)' datatype='real' name='[Calculation_367395274202316815]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [order_id], [global_entity_id], [analytical_customer_id]: min([Adjusted_Item_COGS])}' />
      </column>
      <column caption='Price_difference (unique)' datatype='real' name='[Calculation_367395275910283280]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [order_id], [global_entity_id], [analytical_customer_id]: min([Price_Difference])}' />
      </column>
      <column caption='ABS' datatype='real' name='[Calculation_367395275917946898]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_367395274200190988]) / countd([order_id])' />
      </column>
      <column caption='Listed SKU per Vendor' datatype='real' name='[Calculation_5197365139423936512]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd([pim_sku])/COUNTD([pim_vendor_id])' />
      </column>
      <column caption='pim_ssu_flag' datatype='string' name='[Calculation_5197365139427446785]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [pim_account_source] = &apos;Self Sign Up&apos; then &apos;SSU&apos;&#10;else &apos;Non-SSU&apos; end' />
      </column>
      <column caption='Zombie %' datatype='real' name='[Calculation_6431421806294642688]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(1 - (COUNTD([vendor_id]) / countd([pim_vendor_id])))' />
      </column>
      <column caption='Coalesced_region' datatype='string' name='[Calculation_6431421806300430337]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if ISNULL([region]) = true and [pim_is_online] and is_sent = false then [Calculation_6431421806453096450] else [region] end' />
      </column>
      <column caption='vendors_region' datatype='string' name='[Calculation_6431421806453096450]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [vendors_global_entity_id] in (&apos;CG_QA&apos;,&#10;&apos;HF_EG&apos;,&#10;&apos;HS_BH&apos;,&#10;&apos;HS_SA&apos;,&#10;&apos;TB_AE&apos;,&#10;&apos;TB_BH&apos;,&#10;&apos;TB_JO&apos;,&#10;&apos;TB_KW&apos;,&#10;&apos;TB_OM&apos;,&#10;&apos;TB_QA&apos;,&#10;&apos;TB_SA&apos;,&#10;&apos;YS_TR&apos;) then &apos;MENA&apos;&#10;ELSEIF  [vendors_global_entity_id] in (&apos;AP_PA&apos;,&#10;&apos;PY_AR&apos;,&#10;&apos;PY_BO&apos;,&#10;&apos;PY_CL&apos;,&#10;&apos;PY_CR&apos;,&#10;&apos;PY_DO&apos;,&#10;&apos;PY_EC&apos;,&#10;&apos;PY_GT&apos;,&#10;&apos;PY_HN&apos;,&#10;&apos;PY_NI&apos;,&#10;&apos;PY_PE&apos;,&#10;&apos;PY_PY&apos;,&#10;&apos;PY_SV&apos;,&#10;&apos;PY_UY&apos;,&#10;&apos;PY_VE&apos;) then &apos;America&apos;&#10;elseif [vendors_global_entity_id] in (&apos;BM_VN&apos;,&#10;&apos;FP_BD&apos;,&#10;&apos;FP_HK&apos;,&#10;&apos;FP_KH&apos;,&#10;&apos;FP_LA&apos;,&#10;&apos;FP_MM&apos;,&#10;&apos;FP_MY&apos;,&#10;&apos;FP_PH&apos;,&#10;&apos;FP_PK&apos;,&#10;&apos;FP_SG&apos;,&#10;&apos;FP_TH&apos;,&#10;&apos;FP_TW&apos;) then &apos;Asia&apos;&#10;else &apos;Europe&apos; end' />
      </column>
      <column caption='SSU share by Acq.' datatype='real' name='[Calculation_6431421806475403267]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(if [pim_account_source] = &apos;Self Sign Up&apos; then [pim_vendor_id] end)/&#10;COUNTD(if pim_is_online and pim_is_contracted then [pim_vendor_id] end)' />
      </column>
      <column caption='Listed MasterIDs per Vendor (copy)' datatype='real' name='[Listed SKU per Vendor (copy)_5197365139432140802]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd([pim_master_id])/COUNTD([pim_vendor_id])' />
      </column>
