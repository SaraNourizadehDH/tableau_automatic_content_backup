      <aliases enabled='yes' />
      <column aggregation='Sum' caption='Exclude current month' datatype='integer' name='[Calculation_1190216953495252992]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [order_month] &lt; DATETRUNC(&apos;month&apos;, TODAY())&#10;&#10;then 1 else 0 END' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_1240741698289135616]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]=USERNAME()' />
      </column>
      <column caption='Penetration' datatype='real' name='[Calculation_2060256101039951876]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( [platform_dmart_mau]) / SUM( [plat_cust_in_dmart_deliveryarea])' />
      </column>
      <column caption='Avg. Coverage Per Store' datatype='real' name='[Calculation_2060256101343330311]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Coverage MAU (copy)_2060256101309399045] / SUM([warehouse_count])' />
      </column>
      <column caption='Avg Servicable Customer Base' datatype='real' name='[Calculation_2060256101344575496]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2060256101343330311] * SUM([city_level_platform_mau])' />
      </column>
      <column caption='Calculation Granularity' datatype='string' name='[Calculation_2995878924256890882]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
      </column>
      <column caption='Calculation Type Filter' datatype='string' name='[Calculation_3809763824017858561]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 3]' />
      </column>
      <column caption='City Name ' datatype='string' name='[City Name (copy)_2995878924249366529]' role='dimension' semantic-role='[City].[Name]' type='nominal'>
        <calculation class='tableau' formula='[city_name]' />
      </column>
      <column caption='Country Name ' datatype='string' name='[Country Name (copy)_2060256101341679622]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
        <calculation class='tableau' formula='[country_name]' />
      </column>
      <column caption='Coverage MAU Country' datatype='real' name='[Coverage MAU (copy)_2060256101309399045]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( [plat_cust_in_dmart_deliveryarea]) / MAX( [country_level_platform_mau])' />
      </column>
      <column caption='Coverage MAU City' datatype='real' name='[Coverage MAU Country (copy)_2995878924246425600]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( [plat_cust_in_dmart_deliveryarea]) / MAX( [city_level_platform_mau])' />
      </column>
      <column caption='Penetration DMART ALL' datatype='real' name='[Penetration (copy)_3809763824017141760]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( [dmart_mau]) / SUM( [plat_cust_in_dmart_deliveryarea])' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Xtableau_coverage_penetration_report' datatype='table' name='[__tableau_internal_object_id__].[_tableau_coverage_penetration_report_CA5EE758F6824CBB8CE53564416C8B67]' role='measure' type='quantitative' />
