                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='94309' id='3' type-v2='text' w='98858' x='571' y='5076'>
                  <formatted-text>
                    <run bold='true' fontcolor='#ffffff' fontsize='14' underline='true'>Country/City Level vs. Dmart Level</run>
                    <run fontcolor='#ffffff' fontsize='14' underline='true'>:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#ffffff' fontsize='14'>The warehouse based calculations cannot be aggregated to to non-warehouse Country/City level Calculations. This is because one customer can purchase from more than one warehouse.  For the Country/City level calculations the distinct customer id is used, resulting in a lower total than the sum of the warehouse customers. </run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='14' underline='true'>Platform Customers</run>
                    <run fontcolor='#ffffff' fontsize='14' underline='true'>:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#ffffff' fontsize='14'>Restaurant customers that have purchased that month  (Monthly Active Users).</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#ffffff' fontsize='14'>Country Platform Customers: Restaurant customers from only cities in which we operate with Dmarts too</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='14' underline='true'>Dmart Customers</run>
                    <run fontcolor='#ffffff' fontsize='14' underline='true'>:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#ffffff' fontsize='14'>Dmart Monthly Active customers  who have purchases that month. </run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='14' underline='true'>Coverage</run>
                    <run fontcolor='#ffffff' fontsize='14' underline='true'>:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#ffffff' fontsize='14'>Platform Customers that are within Dmart delivery areas / Platform Customers. </run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='14' underline='true'>Penetration</run>
                    <run fontcolor='#ffffff' fontsize='14' underline='true'>:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#ffffff' fontsize='14' underline='true'>Calculation type Dmart MAU</run>
                    <run fontcolor='#ffffff' fontsize='14'> : </run>
                    <run fontcolor='#ffffff' fontsize='14'> Dmart Customers / Platform Customers that are within Dmart delivery areas.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#ffffff' fontsize='14' underline='true'>Calculation type Dmart &amp; Platform MAU</run>
                    <run fontcolor='#ffffff' fontsize='14'> : </run>
                    <run fontcolor='#ffffff' fontsize='14'>Customers that ordered both Dmart and Restaurant in a give time / Platform Customers that are within Dmart delivery areas. </run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='14' underline='true'>Dmart &amp; Platform Customers</run>
                    <run fontcolor='#ffffff' fontsize='14' underline='true'>: </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#ffffff' fontsize='14'>Platform monthly active users that are also dmart monthly active users. </run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='14' underline='true'>Avg. Coverage Per Store</run>
                    <run fontcolor='#ffffff' fontsize='14' underline='true'>:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#ffffff' fontsize='14'>Coverage / # Active Dmarts</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='14' underline='true'>AVG Servicable Customer Base</run>
                    <run fontcolor='#ffffff' fontsize='14' underline='true'>:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#ffffff' fontsize='14'>Avg. Coverage per Store * Platform Customers</run>
                    <run>Æ&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#535353' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
                <format attr='background-color' value='#535353' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
      <simple-id uuid='{5213709D-FBA0-44E0-9736-D01253DBAAFB}' />
    </dashboard>
