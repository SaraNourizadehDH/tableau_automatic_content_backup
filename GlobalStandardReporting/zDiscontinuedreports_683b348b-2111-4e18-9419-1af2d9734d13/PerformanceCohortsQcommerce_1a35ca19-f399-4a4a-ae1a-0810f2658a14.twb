      <aliases enabled='yes' />
      <column caption='Customer Spend' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[AOV ALL (copy)_3930235117815910404]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_2294795171160137730] + (SUM([amt_delivery_fee_eur])/SUM([orders])) )&#10;* &#10;SUM([returning_users])&#10;&#10;* [Calculation_1387249477440393217]&#10;&#10;* [Frequency (copy)]' />
      </column>
      <column caption='Active Ls FIXED' datatype='integer' name='[Active Dmarts FIXED (copy)_2884063002694586369]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [common_name], [cohort_date], [return_period], [vertical_type]: MAX([active_ls])}' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_1361213054629728256]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]=USERNAME()' />
      </column>
      <column caption='Retention Rate ALL' datatype='real' default-format='p0%' name='[Calculation_1387249477440393217]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([returning_users]) / [Calculation_1519120490500636697]' />
      </column>
      <column caption='current_period' datatype='boolean' name='[Calculation_1387249477445312515]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='dateadd(&apos;month&apos;, [return_period], [cohort_date]) = DATETRUNC(&apos;month&apos;, TODAY())' />
      </column>
      <column caption='text' datatype='string' name='[Calculation_1519120484110606357]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Info:&#10;&#10;This Cohort is User based, while a cohort is defined as following:&#10;&#10;The first time a User places an order in Qcommerce.&apos;' />
      </column>
      <column caption='Cohort Size New' datatype='integer' name='[Calculation_1519120490500636697]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cohort_size])' />
      </column>
      <column caption='AOV ALL' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2294795171160137730]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([amt_gmv_eur])/SUM([orders])' />
      </column>
      <column caption='Active Dmarts FIXED' datatype='integer' name='[Calculation_2884063002694434816]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [common_name], [cohort_date], [return_period], [vertical_type]: MAX([active_dmarts])}' />
      </column>
      <column caption='Users per Store' datatype='real' name='[Calculation_3930235117531897856]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([returning_users]) /&#10;(ZN(SUM([Calculation_2884063002694434816])) + ZN(SUM([Active Dmarts FIXED (copy)_2884063002694586369])))' />
      </column>
      <column caption='share orders with voucher' datatype='real' name='[Calculation_3930235117806092291]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([voucher_orders])) / SUM([orders])' />
      </column>
      <column caption='Avg. # of items in the basket' datatype='real' name='[Calculation_3930235117821841414]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([qty_sold]))&#10;/SUM([orders])' />
      </column>
      <column caption='Frequency ALL' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Frequency (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders]) / [Calculation_1519120490500636697]' />
      </column>
      <column caption='Retention Rate (Color)' datatype='real' default-format='p0%' name='[Retention Rate (copy 2)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = 0 AND MAX([return_period]) = 0 THEN 0 ELSE [Calculation_1387249477440393217] END' />
      </column>
      <column caption='Activity ALL' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Retention Rate (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders]) / SUM([returning_users])' />
      </column>
      <column caption='Orders per Store' datatype='real' name='[Users per Store (copy)_3930235117871865863]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders]) /&#10;(ZN(SUM([Calculation_2884063002694434816])) + ZN(SUM([Active Dmarts FIXED (copy)_2884063002694586369])))' />
      </column>
