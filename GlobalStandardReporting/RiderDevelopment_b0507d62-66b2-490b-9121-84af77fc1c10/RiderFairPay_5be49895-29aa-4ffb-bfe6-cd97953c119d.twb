      <column caption='test' datatype='integer' name='[Calculation_1733674815619489792]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [rider_id],[country_code]: COUNTD([contract_type_new])}' />
      </column>
      <column caption='#Riders above Min Wage' datatype='integer' name='[Calculation_3413306306583515139]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Rider above Min Wage (copy)_5613877703582462001] THEN [rider_id] END)' />
      </column>
      <column caption='Country Filter' datatype='boolean' name='[Calculation_3413306306586849285]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [country_code]: COUNTD([Rider above Min Wage (copy)_5613877703582462001])} =1' />
      </column>
      <column caption='Riders above min wage' datatype='integer' name='[Calculation_3478256661429305344]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Rider above Min Wage (copy)_5613877703582462001] THEN [rider_id] END)' />
      </column>
      <column caption='Earnings per hour' datatype='real' hidden='true' name='[Calculation_5613877701184610310]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([total_paid]/[working_time])' />
      </column>
      <column caption='Rider above Min Wage' datatype='integer' hidden='true' name='[Calculation_5613877701500559370]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_5613877701184610310]&gt;=[minimum_wage_hourly_net_value] THEN [rider_id] END' />
      </column>
      <column caption='DH - Hourly Wage' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_5613877701868929051]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([total_paid]-[Calculation_1240038016736186370])/SUM([working_time]))*3600' />
      </column>
      <column caption='0 paid riders' datatype='boolean' hidden='true' name='[Calculation_5613877701941874725]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [country_code],[rider_id]: MAX([total_paid])}=0' />
      </column>
      <column caption='Percentage 0 riders' datatype='real' hidden='true' name='[Calculation_5613877701950713895]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Calculation_5613877701941874725] THEN [rider_id] END)/COUNTD([rider_id])' />
      </column>
      <column caption='Riders 0 paid' datatype='integer' hidden='true' name='[Calculation_5613877701950976040]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_5613877701941874725] THEN [rider_id] END' />
      </column>
      <column caption='Working Time Hours' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_5613877702176383017]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[working_time]/3600' />
      </column>
      <column caption='Average hours worked per day' datatype='real' name='[Calculation_5613877702182223916]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [country_code], [rider_id], [report_date]: SUM([Calculation_5613877702176383017])}/{ FIXED [country_code], [rider_id], [report_date]: SUM([days_worked])}' />
