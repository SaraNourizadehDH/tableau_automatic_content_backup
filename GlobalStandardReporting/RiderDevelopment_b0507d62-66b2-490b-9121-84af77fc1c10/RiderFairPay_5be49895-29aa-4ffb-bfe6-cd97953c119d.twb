        <calculation class='tableau' formula='//{ FIXED [Rider Id],[Country Code],[Report Date]: AVG([Hourly Min Wage EUR]) - [Earnings per hour Euro]}&#10;&#10;IF [Rider above Min Wage (copy)_5613877703582462001] = FALSE THEN &#10;[Calculation_5692479591557464064] - { FIXED [rider_id],[country_code],[report_date],[Rider above Min Wage (copy)_5613877703582462001]: ([Calculation_5613877701868929051])}&#10;END' />
