      <column caption='Hourly Min Wage' datatype='real' name='[Calculation_5692479591557464064]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [country_code],[report_date]: MIN([minimum_wage_hourly_gross_eur])}' />
