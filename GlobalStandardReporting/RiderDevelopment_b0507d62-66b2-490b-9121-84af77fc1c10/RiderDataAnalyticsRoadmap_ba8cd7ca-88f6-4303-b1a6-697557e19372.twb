      <aliases enabled='yes' />
      <column datatype='string' name='[1st Delivery ETA (Month-Year)]' role='dimension' type='nominal' />
      <column caption='In Progress Projects' datatype='string' name='[Blocked Project (copy)_1526368491097067523]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Status] = &apos;IN PROGRESS&apos; THEN [Project Name] END' />
      </column>
      <column caption='Completed Projects' datatype='string' name='[Blocked Projects (copy)_1526368491097251844]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Status] = &apos;DONE&apos; THEN [Project Name] END' />
      </column>
      <column caption='On-Track Projects' datatype='string' name='[Blocked Projects (copy)_1526368491097387013]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [On Track?] THEN [Project Name] END' />
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([__tableau_internal_object_id__].[Tracker_6F92FA105381487D9AC10151E65B89F0]) / TOTAL(COUNT([__tableau_internal_object_id__].[Tracker_6F92FA105381487D9AC10151E65B89F0]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Blocked Projects' datatype='string' name='[Calculation_1526368491089182720]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Status] = &apos;BLOCKED&apos; THEN [Project Name] END' />
      </column>
      <column caption='Not Rejected Projects' datatype='string' name='[Calculation_1526368491098353672]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Status]!= &apos;REJECTED&apos; THEN [Project Name] END' />
      </column>
      <column caption='ETA' datatype='datetime' name='[Calculation_3415769272602910720]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEADD(&apos;week&apos;,INT(RIGHT([Delivery ETA (Sprint)],2)),DATE(&quot;01/01/&quot;+STR(YEAR(TODAY())))) - 2' />
      </column>
      <column caption='Duration Days' datatype='integer' name='[Calculation_6894729608864755720]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(DATE([Delivered On]), TODAY()) - [Started Date (copy)_6894729608863920135]' />
      </column>
      <column datatype='string' name='[Comments]' role='dimension' type='nominal' />
      <column datatype='string' name='[Delivered On]' role='dimension' type='nominal' />
      <column datatype='string' name='[Delivery ETA (Sprint)]' role='dimension' type='nominal' />
      <column caption='Updated ETA' datatype='datetime' name='[ETA (copy)_2527293515316137984]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEADD(&apos;week&apos;,INT(RIGHT([Updated ETA (Sprint)],2)),DATE(&quot;01/01/&quot;+STR(YEAR(TODAY())))) - 2' />
      </column>
      <column aggregation='Sum' caption='Effort Weeks' datatype='real' name='[EW]' role='dimension' type='ordinal' />
      <column datatype='string' name='[Epic / Ticket]' role='dimension' type='nominal' />
      <column datatype='boolean' name='[On Track?]' role='dimension' type='nominal'>
        <aliases>
          <alias key='false' value='Off-Track' />
          <alias key='true' value='On-Track' />
        </aliases>
      </column>
      <column caption='Off-Track Projects' datatype='string' name='[On-Track Projcets (copy)_1526368491097587719]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF NOT([On Track?]) THEN [Project Name] END' />
      </column>
      <column datatype='string' name='[Project Name]' role='dimension' type='nominal' />
      <column caption='Requested (Year - Quarter)' datatype='date' default-format='*yyyy-q' name='[Requested On (copy)_5168513954735144960]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE([Requested On])' />
      </column>
      <column datatype='string' name='[Requested On]' role='dimension' type='nominal' />
      <column caption='Dates' datatype='date' datatype-customized='true' name='[Started Date (copy)_6894729608863920135]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATEPARSE ( &quot;yyyy-MM-dd&quot;, [Started On] ))' />
      </column>
