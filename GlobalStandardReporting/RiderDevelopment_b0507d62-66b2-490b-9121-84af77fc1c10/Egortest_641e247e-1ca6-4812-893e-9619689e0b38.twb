            <column caption='Dimension (B)' datatype='string' name='[Dimension (A) (copy)_1000925066835812354]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Dimension (A) (copy)_1000925066829422592]&#13;&#10;WHEN &apos;Region&apos; THEN [region]&#13;&#10;WHEN &apos;Country Name&apos; THEN [country_name]&#13;&#10;WHEN &apos;Country Code&apos; THEN [country_code]&#13;&#10;WHEN &apos;City Name&apos; THEN [city_name]&#13;&#10;WHEN &apos;Zone Name&apos; THEN [zone_name]&#13;&#10;WHEN &apos;Period time&apos; THEN [period_time]&#13;&#10;WHEN &apos;Goal DT based&apos; THEN [goal_dt_based]&#13;&#10;WHEN &apos;Week&apos; THEN str([report_week_local])&#13;&#10;WHEN &apos;Day&apos; THEN str([report_date_local])&#13;&#10;WHEN &apos;Time&apos; THEN str([Calculation_169729460486262798])&#13;&#10;WHEN &apos;Date and Time&apos; THEN str([report_datetime_local])&#13;&#10;WHEN &apos;Weekday&apos; THEN [weekday]&#13;&#10;WHEN &apos;None&apos; THEN &apos;None&apos;&#13;&#10;END' />
            </column>
