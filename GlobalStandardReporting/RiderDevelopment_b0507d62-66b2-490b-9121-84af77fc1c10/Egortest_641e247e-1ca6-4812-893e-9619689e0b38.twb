    <worksheet name='UTR- Synchronize (Zones)'>
      <table>
        <view>
          <datasources>
            <datasource caption='utr_suggestions_report' name='federated.0kd9le004kph601ekcmju06plfy1' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select # of Top Zones' datatype='integer' name='[Choose Date Granularity (copy)]' param-domain-type='range' role='measure' type='quantitative' value='5'>
              <calculation class='tableau' formula='5' />
              <range max='20' min='1' />
            </column>
            <column caption='Synchronize axis' datatype='boolean' hidden='true' name='[Choose Metric (A) (copy)]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
            </column>
            <column caption='Metric left axis (zones)' datatype='string' name='[Metric left axis (copy)_330451647102033921]' param-domain-type='list' role='measure' type='nominal' value='&quot;Actual UTR&quot;'>
              <calculation class='tableau' formula='&quot;Actual UTR&quot;' />
            </column>
            <column caption='Metric right axis (zones)' datatype='string' name='[Metric left axis (zones) (copy)_330451647102386178]' param-domain-type='list' role='measure' type='nominal' value='&quot;UTR Suggestion&quot;'>
              <calculation class='tableau' formula='&quot;UTR Suggestion&quot;' />
            </column>
            <column alias='Date' caption='Choose Time Dimension' datatype='string' name='[Report Date Local Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
              <calculation class='tableau' formula='&quot;Day&quot;' />
              <aliases>
                <alias key='&quot;Datetime&quot;' value='Date and Time' />
                <alias key='&quot;Day&quot;' value='Date' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0kd9le004kph601ekcmju06plfy1'>
            <column caption='UTR Suggestion' datatype='real' name='[Calculation_1000925067172737031]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([utr_suggested])' />
            </column>
            <column caption='Goal DT' datatype='real' name='[Calculation_1000925067179491336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([goal_delivery_time])' />
            </column>
            <column caption='UTR Assumption' datatype='real' name='[Calculation_1000925067185512457]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([utr_assumption])' />
            </column>
            <column caption='Planned Shift Duration Hr' datatype='real' hidden='true' name='[Calculation_1000925068231835666]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[planned_shift_duration_min]/60' />
            </column>
            <column caption='Elbow Point ' datatype='real' name='[Calculation_1025694874550964224]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([elbow_point])' />
            </column>
            <column caption='Model Intercept ' datatype='real' name='[Calculation_1025694874558631940]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([model_intercept])' />
            </column>
            <column caption='Actual DT' datatype='real' name='[Calculation_169729459441061888]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_time_n])/SUM([delivery_time_d])' />
            </column>
            <column caption='Actual UTR' datatype='real' name='[Calculation_169729459449139201]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_actuals])/SUM(([evaluations_working_time_mins]/60))' />
            </column>
            <column caption='Staffed UTR' datatype='real' name='[Calculation_169729459538055170]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2281917687594700800])/ &#10;(sum([Calculation_1000925068231835666]&#10;-zn([Calculation_2281917687594803201]/2) &#10;- zn([No Shows Expected 2 (copy)_1957588125716545536]/2) &#10;- zn ([No Shows Expected 2 (copy) (copy)_1957588125716566017]/2)&#10;))' />
            </column>
            <column caption='Time dimension' datatype='string' name='[Calculation_169729459809845252]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Report Date Local Parameter]&#13;&#10;WHEN &apos;Week&apos; THEN str([report_week_local])&#13;&#10;WHEN &apos;Day&apos; THEN str([report_date_local])&#13;&#10;WHEN &apos;Time&apos; THEN str([Calculation_169729460486262798])&#13;&#10;WHEN &apos;Datetime&apos; THEN str([report_datetime_local])&#13;&#10;WHEN &apos;Weekday&apos; THEN [weekday]&#13;&#10;END' />
            </column>
            <column caption='time_local' datatype='string' name='[Calculation_169729460486262798]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='RIGHT(&quot;0&quot;+STR(DATEPARt(&apos;hour&apos;,[report_datetime_local])),2)+&#13;&#10;&#13;&#10;&quot;:&quot;+RIGHT(&quot;0&quot;+STR(DATEPARt(&apos;minute&apos;,[report_datetime_local])),2)' />
            </column>
            <column caption='Adjusted Orders 2' datatype='real' hidden='true' name='[Calculation_2281917687594700800]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[adjusted_orders]/2' />
            </column>
            <column caption='No Shows Expected 2' datatype='real' hidden='true' name='[Calculation_2281917687594803201]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[no_shows_expected]/2' />
            </column>
            <column caption='Synchronize axis' datatype='boolean' name='[Calculation_2281917687628849154]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Choose Metric (A) (copy)]' />
            </column>
            <column caption='Labels Top N Zones' datatype='string' name='[Calculation_330451647091646464]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Top N Zones by # Orders]&#13;&#10;THEN [zone_name]&#13;&#10;ELSE &quot;Others&quot;&#13;&#10;END' />
            </column>
            <column caption='Index' datatype='integer' name='[Calculation_330451647127056389]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INDEX()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Fill Rate' datatype='real' name='[Calculation_756604785159106560]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([open_slots_assigned])/SUM([open_slots_size])' />
            </column>
            <column caption='% Idle time ' datatype='real' name='[Idle time (copy)_169729459867889676]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-(sum([trans_busy_mins])/sum([trans_working_mins]))' />
            </column>
            <column caption='Metric left axis (zones)' datatype='real' name='[Metric left axis (copy)_330451647102529539]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Metric left axis (copy)_330451647102033921]&#13;&#10;WHEN &apos;Actual UTR&apos; THEN ([Calculation_169729459449139201])&#13;&#10;WHEN &apos;Staffed UTR&apos; THEN ([Calculation_169729459538055170])&#13;&#10;WHEN &apos;UTR Suggestion&apos; THEN ([Calculation_1000925067172737031])&#13;&#10;WHEN &apos;UTR Assumption&apos; THEN ([Calculation_1000925067185512457])&#13;&#10;WHEN &apos;# Actual Orders&apos; THEN SUM([orders_actuals])&#13;&#10;WHEN &apos;% Idle Time&apos; THEN [Idle time (copy)_169729459867889676]*100&#13;&#10;WHEN &apos;Goal DT&apos; THEN [Calculation_1000925067179491336]&#13;&#10;WHEN &apos;Actual DT&apos; THEN [Calculation_169729459441061888]&#13;&#10;WHEN &apos;Fill Rate&apos; THEN [Calculation_756604785159106560]* 100&#13;&#10;WHEN &apos;Elbow Point&apos; THEN [Calculation_1025694874550964224]&#13;&#10;WHEN &apos;Model Intercept&apos; THEN [Calculation_1025694874558631940]&#13;&#10;END' />
            </column>
            <column caption='Metric right axis (zones)' datatype='real' name='[Metric left axis (zones) (copy)_330451647102791684]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Metric left axis (zones) (copy)_330451647102386178]&#13;&#10;WHEN &apos;Actual UTR&apos; THEN ([Calculation_169729459449139201])&#13;&#10;WHEN &apos;Staffed UTR&apos; THEN ([Calculation_169729459538055170])&#13;&#10;WHEN &apos;UTR Suggestion&apos; THEN ([Calculation_1000925067172737031])&#13;&#10;WHEN &apos;UTR Assumption&apos; THEN ([Calculation_1000925067185512457])&#13;&#10;WHEN &apos;# Actual Orders&apos; THEN SUM([orders_actuals])&#13;&#10;WHEN &apos;% Idle Time&apos; THEN [Idle time (copy)_169729459867889676]*100&#13;&#10;WHEN &apos;Goal DT&apos; THEN [Calculation_1000925067179491336]&#13;&#10;WHEN &apos;Actual DT&apos; THEN [Calculation_169729459441061888]&#13;&#10;WHEN &apos;Elbow Point&apos; THEN [Calculation_1025694874550964224]&#13;&#10;WHEN &apos;Model Intercept&apos; THEN [Calculation_1025694874558631940]&#13;&#10;END' />
