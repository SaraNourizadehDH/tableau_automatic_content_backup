            <column-instance column='[Calculation_169729459809845252]' derivation='None' name='[none:Calculation_169729459809845252:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2281917687628849154]' derivation='None' name='[none:Calculation_2281917687628849154:nk]' pivot='key' type='nominal' />
            <column-instance column='[city_name]' derivation='None' name='[none:city_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_code]' derivation='None' name='[none:country_code:nk]' pivot='key' type='nominal' />
