              <calculation class='tableau' formula='&quot;Region&quot;' />
              <aliases>
                <alias key='&quot;Day&quot;' value='Date' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0kd9le004kph601ekcmju06plfy1 (copy)'>
            <column caption='Delta DT' datatype='real' name='[Calculation_1000925066836959235]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([goal_delivery_time])- [Calculation_169729459441061888]' />
            </column>
            <column caption='Delta UTR (Suggestion-Actual)' datatype='real' name='[Calculation_1000925066837364740]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([utr_suggested])-[Calculation_169729459449139201]' />
            </column>
            <column caption='UTR Suggestion' datatype='real' name='[Calculation_1000925067172737031]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([utr_suggested])' />
            </column>
            <column caption='Goal DT' datatype='real' name='[Calculation_1000925067179491336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([goal_delivery_time])' />
            </column>
            <column caption='UTR Assumption' datatype='real' name='[Calculation_1000925067185512457]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([utr_assumption])' />
            </column>
            <column caption='Planned Shift Duration Hr' datatype='real' hidden='true' name='[Calculation_1000925068231835666]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[planned_shift_duration_min]/60' />
            </column>
            <column caption='Actual DT' datatype='real' name='[Calculation_169729459441061888]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_time_n])/SUM([delivery_time_d])' />
            </column>
            <column caption='Actual UTR' datatype='real' name='[Calculation_169729459449139201]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_actuals])/SUM(([evaluations_working_time_mins]/60))' />
            </column>
            <column caption='Staffed UTR' datatype='real' name='[Calculation_169729459538055170]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2281917687594700800])/ &#10;(sum([Calculation_1000925068231835666]&#10;-zn([Calculation_2281917687594803201]/2) &#10;- zn([No Shows Expected 2 (copy)_1957588125716545536]/2) &#10;- zn ([No Shows Expected 2 (copy) (copy)_1957588125716566017]/2)&#10;))' />
            </column>
            <column caption='% Stacked Deliveries' datatype='real' name='[Calculation_169729459898437645]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([stacked_deliveries_count])/sum([orders_actuals])' />
            </column>
            <column caption='time_local' datatype='string' name='[Calculation_169729460486262798]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='RIGHT(&quot;0&quot;+STR(DATEPARt(&apos;hour&apos;,[report_datetime_local])),2)+&#13;&#10;&#13;&#10;&quot;:&quot;+RIGHT(&quot;0&quot;+STR(DATEPARt(&apos;minute&apos;,[report_datetime_local])),2)' />
            </column>
            <column caption='% DT &gt; 45' datatype='real' name='[Calculation_1751618789900046336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dt_over_45_count])/SUM([delivery_time_d])' />
            </column>
            <column caption='Adjusted Orders 2' datatype='real' hidden='true' name='[Calculation_2281917687594700800]' role='measure' type='quantitative'>
