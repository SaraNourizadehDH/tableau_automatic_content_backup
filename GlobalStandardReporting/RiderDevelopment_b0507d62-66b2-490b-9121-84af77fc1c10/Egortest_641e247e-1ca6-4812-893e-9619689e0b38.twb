    <worksheet name='Delivery Time'>
      <table>
        <view>
          <datasources>
            <datasource caption='utr_suggestions_report' name='federated.0kd9le004kph601ekcmju06plfy1' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Show Model Intercept' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Yes&quot;'>
              <calculation class='tableau' formula='&quot;Yes&quot;' />
              <aliases>
                <alias key='&quot;Yes excluding when Elbow Point is zero&quot;' value='Yes, excluding when Elbow Point is zero' />
              </aliases>
            </column>
            <column alias='Date' caption='Choose Time Dimension' datatype='string' name='[Report Date Local Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
              <calculation class='tableau' formula='&quot;Day&quot;' />
              <aliases>
                <alias key='&quot;Datetime&quot;' value='Date and Time' />
                <alias key='&quot;Day&quot;' value='Date' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0kd9le004kph601ekcmju06plfy1'>
            <column caption='Goal DT' datatype='real' name='[Calculation_1000925067179491336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([goal_delivery_time])' />
            </column>
            <column caption='Model Intercept ' datatype='real' name='[Calculation_1025694874558631940]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([model_intercept])' />
            </column>
            <column caption='Actual DT' datatype='real' name='[Calculation_169729459441061888]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_time_n])/SUM([delivery_time_d])' />
            </column>
            <column caption='Time dimension' datatype='string' name='[Calculation_169729459809845252]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Report Date Local Parameter]&#13;&#10;WHEN &apos;Week&apos; THEN str([report_week_local])&#13;&#10;WHEN &apos;Day&apos; THEN str([report_date_local])&#13;&#10;WHEN &apos;Time&apos; THEN str([Calculation_169729460486262798])&#13;&#10;WHEN &apos;Datetime&apos; THEN str([report_datetime_local])&#13;&#10;WHEN &apos;Weekday&apos; THEN [weekday]&#13;&#10;END' />
            </column>
            <column caption='time_local' datatype='string' name='[Calculation_169729460486262798]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='RIGHT(&quot;0&quot;+STR(DATEPARt(&apos;hour&apos;,[report_datetime_local])),2)+&#13;&#10;&#13;&#10;&quot;:&quot;+RIGHT(&quot;0&quot;+STR(DATEPARt(&apos;minute&apos;,[report_datetime_local])),2)' />
            </column>
            <column caption='Model Intercept (excluding elbow point zero)' datatype='real' name='[Calculation_470063273455349760]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF [elbow_point] = 0 THEN null ELSE [model_intercept] END)' />
            </column>
            <column caption='Model Intercept  (parameter)' datatype='real' name='[Metric left axis (copy)_470063273461678081]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Yes&apos; THEN [Calculation_1025694874558631940]&#13;&#10;WHEN &apos;No&apos; THEN NULL&#13;&#10;WHEN &apos;Yes excluding when Elbow Point is zero&apos; THEN [Calculation_470063273455349760]&#13;&#10;END' />
            </column>
            <column caption='City Name' datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Country Code' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Delivery Time D' datatype='real' hidden='true' name='[delivery_time_d]' role='measure' type='quantitative' />
            <column caption='Delivery Time N' datatype='real' hidden='true' name='[delivery_time_n]' role='measure' type='quantitative' />
            <column caption='Elbow Point' datatype='real' hidden='true' name='[elbow_point]' role='measure' type='quantitative' />
            <column caption='Goal Delivery Time' datatype='real' hidden='true' name='[goal_delivery_time]' role='measure' type='quantitative' />
