          <datasource-dependencies datasource='federated.10hnce20edo3n4133yd5t07xvj4b'>
            <column caption='Rider' datatype='string' name='[Calculation_371476604726915075]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([rider_id]) + [country_name]' />
            </column>
            <column caption='% of errors when sending a password' datatype='real' name='[Calculation_371476604777431053]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([send_password_failed])/sum([forgot_password_taps])' />
