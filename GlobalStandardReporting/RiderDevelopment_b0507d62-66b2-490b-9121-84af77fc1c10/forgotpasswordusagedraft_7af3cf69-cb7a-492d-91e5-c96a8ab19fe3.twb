    <worksheet name='Sheet 34'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='12'>Dynamics of time segmentation between password recovery and login</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='password_recovery_dash (Elenka)' name='federated.10hnce20edo3n4133yd5t07xvj4b' />
          </datasources>
          <datasource-dependencies datasource='federated.10hnce20edo3n4133yd5t07xvj4b'>
            <column caption='Time to login group' datatype='string' name='[Calculation_203787887576526848]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_371476604793405455] &lt;= 60 then &apos;&lt;= 1 minute&apos; &#10;ELSEIF [Calculation_371476604793405455] &gt; 60 &#10;and [Calculation_371476604793405455] &lt;= 600 then &apos;1-10 minutes&apos;&#10;ELSEIF [Calculation_371476604793405455] &gt; 600&#10;and [Calculation_371476604793405455] &lt;= 3600 then &apos;10-60 minutes&apos;&#10;ELSEIF [Calculation_371476604793405455] &gt; 3600 &#10;and [Calculation_371476604793405455] &lt;= 18000 then &apos;1-5 hours&apos;&#10;ELSE &apos;5+ hours&apos; end' />
            </column>
            <column caption='Rider' datatype='string' name='[Calculation_371476604726915075]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([rider_id]) + [country_name]' />
            </column>
            <column caption='Riders' datatype='integer' name='[Calculation_371476604751949830]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_371476604726915075])' />
            </column>
            <column caption='Time difference between pc and login' datatype='real' name='[Calculation_371476604793405455]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[time_to_login]/[logins_after_pc]' />
            </column>
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Created Date' datatype='date' name='[created_date]' role='dimension' type='ordinal' />
            <column caption='Forgot Password Tap' datatype='integer' name='[forgot_password_tap]' role='measure' type='quantitative' />
            <column caption='Logins After Pc' datatype='integer' name='[logins_after_pc]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_203787887576526848]' derivation='None' name='[none:Calculation_203787887576526848:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[created_date]' derivation='None' name='[none:created_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[forgot_password_tap]' derivation='None' name='[none:forgot_password_tap:qk]' pivot='key' type='quantitative' />
            <column-instance column='[operating_system]' derivation='None' name='[none:operating_system:nk]' pivot='key' type='nominal' />
            <column caption='Operating System' datatype='string' name='[operating_system]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_371476604751949830]' derivation='User' name='[pcto:usr:Calculation_371476604751949830:qk:2]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Columns' type='PctTotal' />
            </column-instance>
            <column caption='Rider Id' datatype='integer' name='[rider_id]' role='dimension' type='ordinal' />
            <column-instance column='[created_date]' derivation='Day-Trunc' name='[tdy:created_date:qk]' pivot='key' type='quantitative' />
            <column caption='Time To Login' datatype='integer' name='[time_to_login]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_371476604751949830]' derivation='User' name='[usr:Calculation_371476604751949830:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.10hnce20edo3n4133yd5t07xvj4b].[none:country_name:nk]' filter-group='6'>
            <groupfilter function='level-members' level='[none:country_name:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='relative-date' column='[federated.10hnce20edo3n4133yd5t07xvj4b].[none:created_date:qk]' filter-group='4' first-period='-20' include-future='true' include-null='false' last-period='0' period-type-v2='day' />
          <filter class='quantitative' column='[federated.10hnce20edo3n4133yd5t07xvj4b].[none:forgot_password_tap:qk]' included-values='in-range'>
            <min>1</min>
            <max>51</max>
