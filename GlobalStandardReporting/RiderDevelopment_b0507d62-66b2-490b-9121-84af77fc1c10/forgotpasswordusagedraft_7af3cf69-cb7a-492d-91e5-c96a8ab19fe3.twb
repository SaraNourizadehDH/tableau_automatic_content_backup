        </aliases>
      </column>
      <column caption='Time to login group' datatype='string' name='[Calculation_203787887576526848]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_371476604793405455] &lt;= 60 then &apos;&lt;= 1 minute&apos; &#10;ELSEIF [Calculation_371476604793405455] &gt; 60 &#10;and [Calculation_371476604793405455] &lt;= 600 then &apos;1-10 minutes&apos;&#10;ELSEIF [Calculation_371476604793405455] &gt; 600&#10;and [Calculation_371476604793405455] &lt;= 3600 then &apos;10-60 minutes&apos;&#10;ELSEIF [Calculation_371476604793405455] &gt; 3600 &#10;and [Calculation_371476604793405455] &lt;= 18000 then &apos;1-5 hours&apos;&#10;ELSE &apos;5+ hours&apos; end' />
      </column>
      <column caption='Time to login minutes' datatype='real' name='[Calculation_203787887581212674]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[time_to_login]/60' />
      </column>
      <column caption='Unique riders who had failed password request' datatype='integer' name='[Calculation_293930250670354433]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(if [send_password_failed] &gt; 0 then [rider_id] else null end)' />
      </column>
      <column caption='% of riders who had failed password request' datatype='real' name='[Calculation_293930250670657538]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_293930250670354433]/[Calculation_371476604751949830]' />
      </column>
      <column caption='% of riders who changed password' datatype='real' name='[Calculation_371476604722839554]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_371476604750725124]/COUNTD([Calculation_371476604726915075])' />
      </column>
      <column caption='Rider' datatype='string' name='[Calculation_371476604726915075]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([rider_id]) + [country_name]' />
      </column>
      <column caption='Riders who changed password' datatype='integer' name='[Calculation_371476604750725124]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [forgot_password_submit] &gt; 0 then [Calculation_371476604726915075] else null end)' />
      </column>
      <column caption='rider type' datatype='string' name='[Calculation_371476604751532037]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [forgot_password_submit] &gt; 0 then &apos;changed password&apos; else &apos;did not changed password&apos; end' />
      </column>
      <column caption='Riders' datatype='integer' name='[Calculation_371476604751949830]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_371476604726915075])' />
      </column>
      <column caption='% forgot password submit' datatype='real' name='[Calculation_371476604760281096]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([forgot_password_submit])/sum([forgot_password_tap])' />
      </column>
      <column caption='% of forgot password tap' datatype='real' name='[Calculation_371476604760772617]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([forgot_password_tap])/sum([forgot_password_tap])' />
      </column>
      <column caption='% of logins after password recovery' datatype='real' name='[Calculation_371476604761055242]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([logins_after_pc])/sum([forgot_password_tap])' />
      </column>
      <column caption='Same day login' datatype='integer' name='[Calculation_371476604764942347]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [time_to_login] &lt;= 86400 then [logins_after_pc] else null end)' />
      </column>
      <column caption='Forgot Password Submit Clicks by Rider' datatype='real' name='[Calculation_371476604775825420]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([forgot_password_submit_taps])/[Calculation_371476604751949830]' />
      </column>
      <column caption='% of errors when sending a password' datatype='real' name='[Calculation_371476604777431053]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([send_password_failed])/sum([forgot_password_taps])' />
      </column>
      <column caption='Riders for whom the password request was fallen' datatype='integer' name='[Calculation_371476604782571534]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [send_password_failed] &gt; 0 then [Calculation_371476604726915075] else null end)' />
      </column>
      <column caption='Time difference between pc and login' datatype='real' name='[Calculation_371476604793405455]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[time_to_login]/[logins_after_pc]' />
      </column>
      <column caption='time to shift' datatype='real' name='[Calculation_371476604795256848]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([time_between_pc_and_shift]/[shift_after_pc])/60' />
      </column>
      <column caption='Time to shift group' datatype='string' name='[Calculation_371476604796842001]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_371476604795256848] &lt;= 15 then &apos;&lt;= 15 minutes&apos;&#10;ELSEIF [Calculation_371476604795256848] &gt; 15 and [Calculation_371476604795256848] &lt;= 60 then &apos;15-60 minutes&apos;&#10;ELSEIF [Calculation_371476604795256848] &gt; 60 and [Calculation_371476604795256848] &lt;= 300 then &apos;1-5 hours&apos;&#10;else &apos;5+ hours&apos; end' />
      </column>
