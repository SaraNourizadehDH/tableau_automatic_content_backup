              <calculation class='tableau' formula='SUM([pickup_task_to_location_match])/SUM([total_rdds_deliveries])' />
            </column>
            <column caption='% Total Match' datatype='real' default-format='p0.0%' name='[Calculation_2206060131804229634]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([all_locations_match])/SUM([total_rdds_deliveries])' />
            </column>
            <column caption='% Pickup Task From Match' datatype='real' default-format='p0.0%' name='[Calculation_2206060131807006723]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pickup_task_from_location_match])/SUM([total_rdds_deliveries])' />
            </column>
            <column caption='Deliveries with a mismatch' datatype='integer' name='[Calculation_2206060131831451658]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_rdds_deliveries]) - SUM([all_locations_match])' />
            </column>
            <column caption='Dimension A' datatype='string' name='[Calculation_4751930928067624961]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = 1 THEN [region]&#10;ELSEIF [Parameters].[Parameter 1] = 2 THEN [country_code]&#10;ELSEIF [Parameters].[Parameter 1] = 3 THEN [country_name]&#10;ELSEIF [Parameters].[Parameter 1] = 4 THEN [delivery_status]&#10;ELSEIF [Parameters].[Parameter 1] = 5 THEN [contract_type]&#10;ELSEIF [Parameters].[Parameter 1] = 6 THEN [engagement_model]&#10;ELSEIF [Parameters].[Parameter 1] = 7 THEN STR([is_stacked])&#10;//ELSEIF [Parameters].[Dimension A] = 8 THEN STR([same_vendor_stack])&#10;END' />
            </column>
            <column caption='KPI' datatype='real' name='[Calculation_4751930928069689347]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = 11 THEN SUM([total_rdds_deliveries])&#10;ELSEIF  [Parameters].[Parameter 2] = 1 THEN SUM([all_locations_match])&#10;ELSEIF [Parameters].[Parameter 2] = 2 THEN [Calculation_2206060131804229634]*100&#10;ELSEIF [Parameters].[Parameter 2] = 3 THEN SUM([pickup_task_from_location_match])&#10;ELSEIF [Parameters].[Parameter 2] = 4 THEN ([Calculation_2206060131807006723])*100&#10;ELSEIF [Parameters].[Parameter 2] = 5 THEN SUM([pickup_task_to_location_match])&#10;ELSEIF [Parameters].[Parameter 2] = 6 THEN ([% Pickup Task From Match (copy)_2206060131807244292])*100&#10;ELSEIF [Parameters].[Parameter 2] = 7 THEN SUM([dropoff_task_from_location_match])&#10;ELSEIF [Parameters].[Parameter 2] = 8 THEN ([% Pickup Task From Match (copy) (copy)_2206060131807256581])*100&#10;ELSEIF [Parameters].[Parameter 2] = 9 THEN SUM([dropoff_task_to_location_match])&#10;ELSEIF [Parameters].[Parameter 2] = 10 THEN ([% Pickup Task From Match (copy) (copy) (copy)_2206060131807264774])*100&#10;END' />
            </column>
            <column caption='% label' datatype='string' name='[Calculation_4751930928070959108]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] IN (2,4,6,8,10) THEN &apos;%&apos; END' />
