            <column caption='% Dropoff Task to Match' datatype='real' default-format='p0.0%' name='[% Pickup Task From Match (copy) (copy) (copy)_2206060131807264774]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dropoff_task_to_location_match])/SUM([total_rdds_deliveries])' />
