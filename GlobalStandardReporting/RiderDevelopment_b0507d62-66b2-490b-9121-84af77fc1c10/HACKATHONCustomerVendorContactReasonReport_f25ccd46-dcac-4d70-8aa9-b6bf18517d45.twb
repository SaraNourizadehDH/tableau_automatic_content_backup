    <worksheet name='CCR L1'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontsize='11'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='contact_reason_report' name='federated.15cehv015dgmno1abds701w52j7r' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Weekly' caption='Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
              <aliases>
                <alias key='&quot;Date&quot;' value='Daily' />
                <alias key='&quot;Month&quot;' value='Monthly' />
                <alias key='&quot;Week&quot;' value='Weekly' />
              </aliases>
            </column>
            <column caption='KPIs Graphs Evolution' datatype='string' datatype-customized='true' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Resolved Cases&quot;'>
              <calculation class='tableau' formula='&quot;Resolved Cases&quot;' />
              <aliases>
                <alias key='&quot;After Contact CSAT (\%)&quot;' value='Afer Contact CSAT (%)' />
                <alias key='&quot;Case AHT (h)&quot;' value='Case AHT Non-Live (h)' />
                <alias key='&quot;FullRT&quot;' value='FullRT (h)' />
                <alias key='&quot;QA Score (\%)&quot;' value='QA Score (%)' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.15cehv015dgmno1abds701w52j7r'>
            <column caption='After Contact CSAT' datatype='real' default-format='n#,##0;-#,##0' name='[CSAT (in percentage) (copy)_1095571024879681546]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_ac_csat_4_5]) / SUM([count_ac_csat_responses])' />
            </column>
            <column caption='Chat AHT (m)' datatype='real' name='[Calculation_1194016888929374213]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(&#10;    CASE [channel] WHEN &apos;Chat&apos; THEN [Handling Time (copy)_1194016888929615878]&#10;    ELSE 0 END &#10;   )&#10;/&#10;SUM(&#10;    CASE [channel] WHEN &apos;Chat&apos; THEN [Resolved Cases (copy)_1194016888930238471]&#10;    ELSE 0 END &#10;   )&#10;)/60' />
            </column>
            <column caption='Orders' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1252000751479169032]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Old logic -- revised 28-Feb-21&#10;// { FIXED [Source Id],[Date Range], [Vertical], [Delivery Type] : MAX([Gross Orders]) }&#10;&#10;// Revised per bug reported in RASD-1347&#10;// After the CCR design was updated to insert gross_orders just once rather than being included in each record, the old LOD above no longer worked.&#10;// Revised logic first gets the max() at that level same as last time, but then uses EXCLUDE to remove the CCR granularity when &#10;// adding the orders. The final effect is that orders are again appropriately counted just once per date, delivery type, vertical &amp; source ID.&#10;&#10;{ EXCLUDE [contact_reason_l1], [contact_reason_l2], [contact_reason_l3] :&#10;&#9;SUM( { FIXED [report_date], [delivery_type], [vertical],[is_corporate], [is_preorder], [is_subscription],[global_entity_id] : MAX([gross_orders]) }) &#10;}' />
            </column>
            <column caption='# Audits' datatype='real' name='[Calculation_1476899229110317057]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([evaluations])' />
            </column>
            <column caption='Avg. Full Resolution Time (h)' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1515179817555480578]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([full_resolution_time_min]) / SUM([resolved_contact_ind]) /60' />
            </column>
            <column caption='After Contact CSAT (in percentage)' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_338121849629618177]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_ac_csat_4_5]) / SUM([count_ac_csat_responses]) * 100' />
            </column>
            <column caption='QA Score' datatype='real' name='[Calculation_526358231821787148]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([score_avg])/SUM([evaluations])' />
            </column>
            <column caption='KPIs Graphs' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_735212659243257856]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 5]=&apos;Incoming Cases&apos; then sum(round([inbound_contact_ind],2))&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;Incoming Cases %&apos; then ROUND(SUM([inbound_contact_ind]) / TOTAL(SUM([inbound_contact_ind])),2)*100&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;Resolved Cases&apos; then round(sum([resolved_contact_ind]),2)&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;Resolved Cases %&apos; then ROUND(SUM([resolved_contact_ind]) / TOTAL(SUM([resolved_contact_ind])),2)*100&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;Case AHT (h)&apos; then ROUND([Case AHT (h) (copy)_1194016888909897728],1)&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;Chat AHT (m)&apos; then ROUND([Calculation_1194016888929374213],1)&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;Incoming Cases per order&apos; then ROUND([Cases per order (copy)_552535426687778822],3)*100&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;Resolved Cases per order&apos; then ROUND([Cases per order (copy) (copy)_552535426687787015],3)*100&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;FullRT&apos; then ROUND([Calculation_1515179817555480578],1)&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;QA Score (%)&apos; then ROUND([Calculation_526358231821787148],3)*100&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;# Audits&apos; then ROUND([Calculation_1476899229110317057],0)&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;After Contact CSAT (%)&apos; then ROUND([Calculation_338121849629618177],0)&#13;&#10;//ELSEIF  [KPIs Graphs Evolution]=&apos;% 1-time contact&apos; THEN ROUND([% 1-time contact],3)*100&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Case AHT Non-Live (h)' datatype='real' default-format='n#,##0;-#,##0' name='[Case AHT (h) (copy)_1194016888909897728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//Non Chat Case AHT (hours)&#10;(&#10;SUM(&#10;    CASE [channel] WHEN &apos;Chat&apos; THEN 0&#10;    ELSE [handling_time_secs] END &#10;   )&#10;/&#10;SUM(&#10;    CASE [channel] WHEN &apos;Chat&apos; THEN 0&#10;    ELSE [resolved_contact_ind] END &#10;   )&#10;   )&#10;/60&#10;&#10;/60' />
            </column>
            <column caption='Resolved Cases per order' datatype='real' default-format='p0.00%' name='[Cases per order (copy) (copy)_552535426687787015]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([resolved_contact_ind])/SUM([Calculation_1252000751479169032])' />
            </column>
            <column caption='Incoming Cases per order' datatype='real' default-format='p0.00%' name='[Cases per order (copy)_552535426687778822]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([inbound_contact_ind])/SUM([Calculation_1252000751479169032])' />
            </column>
            <column caption='Granularity' datatype='string' name='[Choosen Dimension Graphs (copy)_526358231826968593]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Month&apos; THEN STR([month])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Week&apos; THEN STR([week])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Date&apos; THEN STR([report_date])&#10;END' />
            </column>
            <column caption='Date' datatype='date' name='[Date Range  (copy)_2503438490013786122]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[report_date]' />
            </column>
            <column caption='lookup first value in Granularity' datatype='string' name='[Granularity (copy)_6572722229298831362]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Month&apos; THEN STR(LOOKUP(MIN([month]),FIRST()))&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Week&apos; THEN STR(LOOKUP(MIN([week]),FIRST()))&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Date&apos; THEN STR(LOOKUP(MIN([report_date]),FIRST()))&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Chat Handling Time' datatype='real' name='[Handling Time (copy)_1194016888929615878]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [channel] = &apos;Chat&apos;&#10;THEN [handling_time_secs]&#10;END' />
            </column>
            <column caption='KPIs Evolution Trends' datatype='real' default-format='*0%▲;0%▼' name='[KPIs Graphs (copy)_6291880589552807937]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;&#10;WHEN &apos;Incoming Cases&apos;             THEN IF ISNULL(LOOKUP(ZN(SUM([inbound_contact_ind])),-1)) THEN 0 ELSE RUNNING_SUM(ZN(sum([inbound_contact_ind])) - LOOKUP(ZN(sum([inbound_contact_ind])), -1)) / LOOKUP(ZN(sum([inbound_contact_ind])), FIRST()) END&#10;WHEN &apos;Incoming Cases %&apos;           THEN IF ISNULL(LOOKUP(ZN(SUM([inbound_contact_ind]) / TOTAL(SUM([inbound_contact_ind]))), -1)) THEN 0 ELSE RUNNING_SUM(ZN(SUM([inbound_contact_ind]) / TOTAL(SUM([inbound_contact_ind]))) - LOOKUP(ZN(SUM([inbound_contact_ind]) / TOTAL(SUM([inbound_contact_ind]))), -1)) END&#10;WHEN &apos;Resolved Cases&apos;             THEN IF ISNULL(LOOKUP(ZN(SUM([resolved_contact_ind])),-1)) THEN 0 ELSE RUNNING_SUM(ZN(sum([resolved_contact_ind])) - LOOKUP(ZN(sum([resolved_contact_ind])), -1)) / LOOKUP(ZN(sum([resolved_contact_ind])), FIRST()) END&#10;WHEN &apos;Resolved Cases %&apos;           THEN IF ISNULL(LOOKUP(ZN(SUM([resolved_contact_ind]) / TOTAL(SUM([resolved_contact_ind]))), -1)) THEN 0 ELSE RUNNING_SUM(ZN(SUM([resolved_contact_ind]) / TOTAL(SUM([resolved_contact_ind]))) - LOOKUP(ZN(SUM([resolved_contact_ind]) / TOTAL(SUM([resolved_contact_ind]))), -1)) END&#10;WHEN &apos;Case AHT (h)&apos;               THEN IF ISNULL(LOOKUP(ZN([Case AHT (h) (copy)_1194016888909897728]),-1)) THEN 0 ELSE RUNNING_SUM(ZN([Case AHT (h) (copy)_1194016888909897728]) - LOOKUP(ZN([Case AHT (h) (copy)_1194016888909897728]), -1)) / LOOKUP(ZN([Case AHT (h) (copy)_1194016888909897728]), FIRST()) END&#10;WHEN &apos;Chat AHT (m)&apos;               THEN IF ISNULL(LOOKUP(ZN([Calculation_1194016888929374213]),-1)) THEN 0 ELSE RUNNING_SUM(ZN([Calculation_1194016888929374213]) - LOOKUP(ZN([Calculation_1194016888929374213]), -1)) / LOOKUP(ZN([Calculation_1194016888929374213]), FIRST()) END&#10;WHEN &apos;Incoming Cases per order&apos;   THEN IF ISNULL(LOOKUP(ZN([Cases per order (copy)_552535426687778822]), -1)) THEN 0 ELSE RUNNING_SUM(ZN([Cases per order (copy)_552535426687778822]) - LOOKUP(ZN([Cases per order (copy)_552535426687778822]), -1)) END&#10;WHEN &apos;Resolved Cases per order&apos;   THEN IF ISNULL(LOOKUP(ZN([Cases per order (copy) (copy)_552535426687787015]), -1)) THEN 0 ELSE RUNNING_SUM(ZN([Cases per order (copy) (copy)_552535426687787015]) - LOOKUP(ZN([Cases per order (copy) (copy)_552535426687787015]), -1)) END&#10;WHEN &apos;FullRT&apos;                     THEN IF ISNULL(LOOKUP(ZN([Calculation_1515179817555480578]),-1)) THEN 0 ELSE RUNNING_SUM(ZN([Calculation_1515179817555480578]) - LOOKUP(ZN([Calculation_1515179817555480578]), -1)) / LOOKUP(ZN([Calculation_1515179817555480578]), FIRST()) END&#10;WHEN &apos;QA Score&apos;                   THEN IF ISNULL(LOOKUP(ZN([Calculation_526358231821787148]),-1)) THEN 0 ELSE RUNNING_SUM(ZN([Calculation_526358231821787148]) - LOOKUP(ZN([Calculation_526358231821787148]), -1)) / LOOKUP(ZN([Calculation_526358231821787148]), FIRST()) END&#10;WHEN &apos;After Contact CSAT (%)&apos;     THEN IF ISNULL(LOOKUP(ZN([CSAT (in percentage) (copy)_1095571024879681546]),-1)) THEN 0 ELSE RUNNING_SUM(ZN([CSAT (in percentage) (copy)_1095571024879681546]) - LOOKUP(ZN([CSAT (in percentage) (copy)_1095571024879681546]), -1)) END&#10;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Total Served Chats' datatype='real' name='[Resolved Cases (copy)_1194016888930238471]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [channel] = &apos;Chat&apos; THEN [resolved_contact_ind]&#10;END' />
            </column>
            <column caption='Agent Facing Tool' datatype='string' name='[agent_facing_tool]' role='dimension' type='nominal'>
              <aliases>
                <alias key='%null%' value='N/A' />
              </aliases>
            </column>
