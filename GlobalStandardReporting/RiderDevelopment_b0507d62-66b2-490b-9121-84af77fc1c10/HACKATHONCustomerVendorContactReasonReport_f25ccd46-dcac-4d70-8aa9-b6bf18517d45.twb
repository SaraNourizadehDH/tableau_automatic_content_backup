              <calculation class='tableau' formula='IF  [Parameters].[Parameter 4]=&apos;# Incoming Cases&apos; THEN sum([inbound_contact_ind])&#10;ELSEIF [Parameters].[Parameter 4]=&apos;# Resolved Cases&apos; THEN sum([resolved_contact_ind])&#10;ELSEIF  [Parameters].[Parameter 4]=&apos;Case AHT Non-Live (h)&apos; THEN ROUND([Case AHT (h) (copy)_1194016888909897728],1)&#10;//ELSEIF  [Parameters].[KPIs]=&apos;Case AHT Live (m)&apos; THEN ROUND([Case AHT Live (m)],1)&#10;ELSEIF  [Parameters].[Parameter 4]=&apos;Chat AHT (m)&apos; THEN ROUND([Calculation_1194016888929374213],1)&#10;ELSEIF  [Parameters].[Parameter 4]=&apos;Chat Avg. Wrap Time (m)&apos; THEN ROUND([Chat AHT (m) (copy)_5870160642275184642],1)&#10;ELSEIF  [Parameters].[Parameter 4]=&apos;Chat Avg. THT (m)&apos; THEN ROUND([Chat AHT (m) (copy)_5870160642274512896],1)&#10;ELSEIF  [Parameters].[Parameter 4]=&apos;Avg. Full Resolution Time&apos; THEN ROUND([Calculation_1515179817555480578],1)&#10;// NPS removed as part of RA-1134&#10;// ELSEIF  [Parameters].[KPIs]=&apos;AC NPS&apos; THEN ROUND([AC NPS],0)&#10;ELSEIF  [Parameters].[Parameter 4]=&apos;After Contact CSAT (in percentage)&apos; THEN ROUND([Calculation_338121849629618177],0)&#10;ELSEIF  [Parameters].[Parameter 4]=&apos;# After Contact CSAT Responses&apos; THEN SUM([count_ac_csat_responses])&#10;ELSEIF  [Parameters].[Parameter 4]=&apos;QA Score&apos; THEN ROUND([Calculation_526358231821787148], 0)&#13;&#10;ELSEIF  [Parameters].[Parameter 4]=&apos;# Audits&apos; THEN ROUND([Calculation_1476899229110317057], 0)&#10;//ELSEIF  [Parameters].[KPIs]=&apos;% 1-time contact&apos; THEN ROUND([% 1-time contact],2)*100&#10;END' />
