      <aliases enabled='yes' />
      <column caption='2nd Dimension' datatype='string' default-format='n#,##0.0;-#,##0.0' name='[1st Dimension (copy)_2391270706831896577]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[1st Dimension (copy)_2391270706831839232]= &apos;DH Regions&apos; THEN [dh_region]&#10;ELSEIF [Parameters].[1st Dimension (copy)_2391270706831839232]=&apos;Management Entity&apos; THEN [management_entity_group]&#10;ELSEIF [Parameters].[1st Dimension (copy)_2391270706831839232]=&apos;Contact Center&apos; THEN [contact_center]&#10;ELSEIF [Parameters].[1st Dimension (copy)_2391270706831839232]=&apos;Country&apos; THEN [country]&#10;ELSEIF  [Parameters].[1st Dimension (copy)_2391270706831839232]=&apos;Brand&apos; THEN [brand]&#10;ELSEIF  [Parameters].[1st Dimension (copy)_2391270706831839232]=&apos;Channel&apos; THEN [channel]&#10;ELSEIF  [Parameters].[1st Dimension (copy)_2391270706831839232]=&apos;Stakeholder&apos; THEN [stakeholder]&#10;ELSEIF [Parameters].[1st Dimension (copy)_2391270706831839232]=&apos;Agent Facing Tool&apos; THEN [agent_facing_tool]&#10;ELSEIF [Parameters].[1st Dimension (copy)_2391270706831839232]=&apos;Stakeholder Entry Point&apos; THEN [stakeholder_entry_point]&#10;ELSEIF  [Parameters].[1st Dimension (copy)_2391270706831839232]=&apos;Contact Resolution Skill&apos; THEN [contact_resolution_skill]&#10;ELSEIF  [Parameters].[1st Dimension (copy)_2391270706831839232]=&apos;Vertical&apos; THEN [vertical]&#10;ELSEIF  [Parameters].[1st Dimension (copy)_2391270706831839232]=&apos;Delivery Type&apos; THEN [delivery_type]&#10;ELSEIF  [Parameters].[1st Dimension (copy)_2391270706831839232]=&apos;Is Preorder?&apos; THEN STR([is_preorder])&#10;ELSEIF  [Parameters].[1st Dimension (copy)_2391270706831839232]=&apos;Is Corporate ?&apos; THEN STR([is_corporate])&#10;ELSEIF  [Parameters].[1st Dimension (copy)_2391270706831839232]=&apos;Is Subscription ?&apos; THEN STR([is_subscription])&#10;ELSEIF  [Parameters].[1st Dimension (copy)_2391270706831839232]=&apos;Global&apos; THEN [Calculation_610026676822482944]&#10;ELSEIF  [Parameters].[1st Dimension (copy)_2391270706831839232]=&apos;Ownership&apos; THEN [ownership]&#13;&#10;END' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.15cehv015dgmno1abds701w52j7r].[sum:count_ac_csat_responses:qk]&quot;' value='# After Contact CSAT Responses' />
          <alias key='&quot;[federated.15cehv015dgmno1abds701w52j7r].[usr:Calculation_338121849629618177:qk]&quot;' value='After Contact CSAT (%)' />
        </aliases>
      </column>
      <column caption='FCR (%) Contribution' datatype='real' name='[AHT Contribution (copy)_2503438489942347784]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(WINDOW_SUM(SUM([count_first_contact_resolution])) / WINDOW_SUM(SUM([count_contacts_related_to_order]))) // window aggregate&#10;-&#10;(&#10;&#9;(  WINDOW_SUM(SUM([count_first_contact_resolution])) // window sum numerator&#10;&#9; - LOOKUP(SUM([count_first_contact_resolution]), 0) // current row numerator&#10;&#9;)&#10;&#9;/&#10;&#9;(  WINDOW_SUM(SUM([count_contacts_related_to_order])) // window sum denominator&#10;&#9; - LOOKUP(SUM([count_contacts_related_to_order]), 0) // current row denominator&#10;&#9;)&#10;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Contact Rate Contribution' datatype='real' name='[AHT Contribution (copy)_2503438489945026569]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(WINDOW_SUM(SUM(IFNULL([inbound_contact_ind],0))) / WINDOW_SUM(SUM([Calculation_1252000751479169032]))) // window aggregate&#10;-&#10;(&#10;&#9;(  WINDOW_SUM(SUM(IFNULL([inbound_contact_ind],0))) // window sum numerator&#10;&#9; - LOOKUP(SUM(IFNULL([inbound_contact_ind],0)), 0) // current row numerator&#10;&#9;)&#10;&#9;/&#10;&#9;(  WINDOW_SUM(SUM([Calculation_1252000751479169032])) // window sum denominator&#10;&#9; - LOOKUP(SUM([Calculation_1252000751479169032]), 0) // current row denominator&#10;&#9;)&#10;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='After Contact CSAT' datatype='real' default-format='n#,##0;-#,##0' name='[CSAT (in percentage) (copy)_1095571024879681546]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_ac_csat_4_5]) / SUM([count_ac_csat_responses])' />
      </column>
      <column caption='Chat AHT(m) Contribution' datatype='real' name='[CSAT Contribution (copy)_2503438489939230723]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(WINDOW_SUM(SUM(CASE [channel] WHEN &apos;Chat&apos; THEN [Handling Time (copy)_1194016888929615878] ELSE 0 END)) / WINDOW_SUM(SUM(CASE [channel] WHEN &apos;Chat&apos; THEN [Resolved Cases (copy)_1194016888930238471]ELSE 0 END))) /60 // window aggregate&#10;-&#10;(&#10;&#9;(  WINDOW_SUM(SUM(CASE [channel] WHEN &apos;Chat&apos; THEN [Handling Time (copy)_1194016888929615878] ELSE 0 END)) // window sum numerator&#10;&#9; - LOOKUP(SUM(CASE [channel] WHEN &apos;Chat&apos; THEN [Handling Time (copy)_1194016888929615878] ELSE 0 END), 0) // current row numerator&#10;&#9;)&#10;&#9;/&#10;&#9;(  WINDOW_SUM(SUM(CASE [channel] WHEN &apos;Chat&apos; THEN [Resolved Cases (copy)_1194016888930238471]ELSE 0 END)) // window sum denominator&#10;&#9; - LOOKUP(SUM(CASE [channel] WHEN &apos;Chat&apos; THEN [Resolved Cases (copy)_1194016888930238471]ELSE 0 END), 0) // current row denominator&#10;&#9;)&#10;        /60&#10;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Hide First Value on X axis' datatype='boolean' name='[Calculation_1095571024881283083]' role='measure' type='nominal'>
        <calculation class='tableau' formula='INDEX() = 1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Chat AHT (m)' datatype='real' name='[Calculation_1194016888929374213]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(&#10;    CASE [channel] WHEN &apos;Chat&apos; THEN [Handling Time (copy)_1194016888929615878]&#10;    ELSE 0 END &#10;   )&#10;/&#10;SUM(&#10;    CASE [channel] WHEN &apos;Chat&apos; THEN [Resolved Cases (copy)_1194016888930238471]&#10;    ELSE 0 END &#10;   )&#10;)/60' />
      </column>
      <column caption='Orders' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1252000751479169032]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Old logic -- revised 28-Feb-21&#10;// { FIXED [Source Id],[Date Range], [Vertical], [Delivery Type] : MAX([Gross Orders]) }&#10;&#10;// Revised per bug reported in RASD-1347&#10;// After the CCR design was updated to insert gross_orders just once rather than being included in each record, the old LOD above no longer worked.&#10;// Revised logic first gets the max() at that level same as last time, but then uses EXCLUDE to remove the CCR granularity when &#10;// adding the orders. The final effect is that orders are again appropriately counted just once per date, delivery type, vertical &amp; source ID.&#10;&#10;{ EXCLUDE [contact_reason_l1], [contact_reason_l2], [contact_reason_l3] :&#10;&#9;SUM( { FIXED [report_date], [delivery_type], [vertical],[is_corporate], [is_preorder], [is_subscription],[global_entity_id] : MAX([gross_orders]) }) &#10;}' />
      </column>
      <column caption='Cases per Order' datatype='real' default-format='p0.00%' name='[Calculation_1252000751479709705]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(CASE [Parameters].[Cases (copy)_2949294850072502276]&#10;        WHEN &apos;Cases per order - All&apos; THEN [KPIs Graphs (copy)_552535426223271940]&#10;        WHEN &apos;Cases per order - Own Delivery&apos; THEN IF [delivery_type] = &apos;Own Delivery&apos; THEN [KPIs Graphs (copy)_552535426223271940] END&#10;        WHEN &apos;Cases per order - Vendor Delivery&apos; THEN IF [delivery_type] = &apos;Vendor Delivery&apos; THEN [KPIs Graphs (copy)_552535426223271940] END&#10;        WHEN &apos;Cases per order - unknown&apos; THEN IF [delivery_type] = &apos;Unknown&apos; THEN [KPIs Graphs (copy)_552535426223271940] END&#10;        WHEN &apos;Cases per order - Pick-up&apos; THEN IF [delivery_type] = &apos;Pick-up&apos; THEN [KPIs Graphs (copy)_552535426223271940] END&#10;    END&#10;   )&#10;/&#10;SUM([Calculation_1252000751479169032])' />
      </column>
      <column caption='# Audits' datatype='real' name='[Calculation_1476899229110317057]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([evaluations])' />
      </column>
      <column caption='Avg. Full Resolution Time (h)' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1515179817555480578]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([full_resolution_time_min]) / SUM([resolved_contact_ind]) /60' />
      </column>
      <column caption='KPIs' datatype='real' default-format='N' name='[Calculation_1515179817556090885]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  [Parameters].[Parameter 4]=&apos;# Incoming Cases&apos; THEN sum([inbound_contact_ind])&#10;ELSEIF [Parameters].[Parameter 4]=&apos;# Resolved Cases&apos; THEN sum([resolved_contact_ind])&#10;ELSEIF  [Parameters].[Parameter 4]=&apos;Case AHT Non-Live (h)&apos; THEN ROUND([Case AHT (h) (copy)_1194016888909897728],1)&#10;//ELSEIF  [Parameters].[KPIs]=&apos;Case AHT Live (m)&apos; THEN ROUND([Case AHT Live (m)],1)&#10;ELSEIF  [Parameters].[Parameter 4]=&apos;Chat AHT (m)&apos; THEN ROUND([Calculation_1194016888929374213],1)&#10;ELSEIF  [Parameters].[Parameter 4]=&apos;Chat Avg. Wrap Time (m)&apos; THEN ROUND([Chat AHT (m) (copy)_5870160642275184642],1)&#10;ELSEIF  [Parameters].[Parameter 4]=&apos;Chat Avg. THT (m)&apos; THEN ROUND([Chat AHT (m) (copy)_5870160642274512896],1)&#10;ELSEIF  [Parameters].[Parameter 4]=&apos;Avg. Full Resolution Time&apos; THEN ROUND([Calculation_1515179817555480578],1)&#10;// NPS removed as part of RA-1134&#10;// ELSEIF  [Parameters].[KPIs]=&apos;AC NPS&apos; THEN ROUND([AC NPS],0)&#10;ELSEIF  [Parameters].[Parameter 4]=&apos;After Contact CSAT (in percentage)&apos; THEN ROUND([Calculation_338121849629618177],0)&#10;ELSEIF  [Parameters].[Parameter 4]=&apos;# After Contact CSAT Responses&apos; THEN SUM([count_ac_csat_responses])&#10;ELSEIF  [Parameters].[Parameter 4]=&apos;QA Score&apos; THEN ROUND([Calculation_526358231821787148], 0)&#13;&#10;ELSEIF  [Parameters].[Parameter 4]=&apos;# Audits&apos; THEN ROUND([Calculation_1476899229110317057], 0)&#10;//ELSEIF  [Parameters].[KPIs]=&apos;% 1-time contact&apos; THEN ROUND([% 1-time contact],2)*100&#10;END' />
      </column>
      <column caption='Flag Null CCR' datatype='boolean' name='[Calculation_1582100542344032256]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='ISNULL([contact_reason_l1]) OR [contact_reason_l1]=&apos;Unknown&apos;' />
      </column>
      <column caption='Contribution to KPI' datatype='real' default-format='p0.00%' name='[Calculation_2503438489938718722]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[KPIs (copy)_2503438489938403329]&#10;  WHEN &apos;After Contact CSAT (%)&apos;THEN [Calculation_7796575385002577922]&#10;  WHEN &apos;Chat AHT(m)&apos;           THEN [CSAT Contribution (copy)_2503438489939230723]&#10;  WHEN &apos;Case AHT Non-Live (h)&apos; THEN [Chat AHT(m) Contribution (copy)_3956412320066273280]&#10;  WHEN &apos;FCR (%)&apos;               THEN [AHT Contribution (copy)_2503438489942347784]&#10;  WHEN &apos;Contact Rate&apos;          THEN [AHT Contribution (copy)_2503438489945026569]&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='After Contact CSAT (in percentage)' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_338121849629618177]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_ac_csat_4_5]) / SUM([count_ac_csat_responses]) * 100' />
      </column>
      <column caption='Total Cases' datatype='real' name='[Calculation_3734328520131284992]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='TOTAL(SUM([inbound_contact_ind]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column aggregation='Attribute' caption='% Incoming Cases ' datatype='real' default-format='p0.00%' name='[Calculation_3734328520131403777]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[inbound_contact_ind] / {EXCLUDE  [local_contact_reason] : SUM([inbound_contact_ind])}' />
      </column>
      <column aggregation='Attribute' caption='Total Cases in past 3 months' datatype='real' name='[Calculation_3734328520132632578]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{EXCLUDE  [local_contact_reason] : SUM([inbound_contact_ind])}' />
      </column>
      <column caption='Contact Reason Level' datatype='string' name='[Calculation_374291399389483009]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;  WHEN &apos;Level 1&apos; THEN [contact_reason_l1]&#10;  WHEN &apos;Level 2&apos; THEN [contact_reason_l2]&#10;  WHEN &apos;Level 3&apos; THEN [contact_reason_l3]&#10;END' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_4396991041483190272]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column aggregation='Sum' caption='Toogle' datatype='real' name='[Calculation_4717942861270638592]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 3]' />
      </column>
      <column caption='Cases for selected Delivery Type' datatype='real' name='[Calculation_5055431335537905664]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Cases (copy)_2949294850072502276]&#10;    WHEN &apos;Cases per order - All&apos; THEN [KPIs Graphs (copy)_552535426223271940]&#10;    WHEN &apos;Cases per order - Own Delivery&apos; THEN IF [delivery_type] = &apos;Own Delivery&apos; THEN [KPIs Graphs (copy)_552535426223271940] END&#10;    WHEN &apos;Cases per order - Vendor Delivery&apos; THEN IF [delivery_type] = &apos;Vendor Delivery&apos; THEN [KPIs Graphs (copy)_552535426223271940] END&#10;    WHEN &apos;Cases per order - unknown&apos; THEN IF [delivery_type] = &apos;unknown&apos; THEN [KPIs Graphs (copy)_552535426223271940] END&#10;    WHEN &apos;Cases per order - Pick-up&apos; THEN IF [delivery_type] = &apos;Pick-up&apos; THEN [KPIs Graphs (copy)_552535426223271940] END&#10;END' />
      </column>
      <column caption='QA Score' datatype='real' name='[Calculation_526358231821787148]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([score_avg])/SUM([evaluations])' />
      </column>
      <column caption='Selected Metric' datatype='real' default-format='N' name='[Calculation_535224713484959745]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2 1]&#10;  WHEN &apos;Chat AHT (m)&apos;                               THEN ROUND([Calculation_1194016888929374213],1)&#10;  WHEN &apos;Case AHT Non-Live (h)&apos;                      THEN ROUND([Case AHT (h) (copy)_1194016888909897728],1)&#10;  WHEN &apos;After Contact CSAT (in percentage)&apos;         THEN ROUND([Calculation_338121849629618177],0)&#13;&#10;  WHEN &apos;Resolved Cases per Order (in percentage)&apos;   THEN ROUND((SUM([resolved_contact_ind]) / SUM([Calculation_1252000751479169032]))*100,2)&#10;  WHEN  &apos;# Incoming Cases&apos;                          THEN sum([inbound_contact_ind])&#10;  WHEN  &apos;# Resolved Cases&apos;                          THEN sum([resolved_contact_ind])&#10;  WHEN  &apos;Chat Avg. Wrap Time (m)&apos;                   THEN ROUND([Chat AHT (m) (copy)_5870160642275184642],1)&#10;  WHEN  &apos;Chat Avg. THT (m)&apos;                         THEN ROUND([Chat AHT (m) (copy)_5870160642274512896],1)&#10;  WHEN  &apos;Avg. Full Resolution Time&apos;                 THEN ROUND([Calculation_1515179817555480578],1)&#10;  WHEN  &apos;# After Contact CSAT Responses&apos;            THEN SUM([count_ac_csat_responses])&#10;  WHEN  &apos;QA Score (in percentage)&apos;                  THEN ROUND([Calculation_526358231821787148], 0)&#13;&#10;  WHEN  &apos;# Audits&apos;                                  THEN ROUND([Calculation_1476899229110317057], 0)&#10;END' />
      </column>
      <column caption='FCR (%)' datatype='real' default-format='p0.0%' name='[Calculation_552535426702155790]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// --- old definition :&#10;//SUM(IF NOT ISNULL([CR Category L1]) AND [CR Category L1] &lt;&gt; &apos;Ticket without CCR&apos; THEN [Count First Contact Resolution] END)&#10;// /&#10;//SUM(IF NOT ISNULL([CR Category L1]) AND [CR Category L1] &lt;&gt; &apos;Ticket without CCR&apos; THEN [Count Contacts Related To Order] END)&#10;&#10;&#10;// updated as part of RASD-2083 to new definition of FCR : Number of Order-CCR combinations with only one contact / Number of total Order-CCR combinations.&#10;SUM([count_first_contact_resolution])&#10;/&#10;SUM([count_contacts_related_to_order])' />
      </column>
      <column caption='% of contacts with order number' datatype='real' default-format='p0%' name='[Calculation_552535426703106063]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([count_contacts_related_to_order]) / SUM([inbound_contact_ind])' />
      </column>
      <column caption='Global' datatype='string' name='[Calculation_610026676822482944]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Global&apos;' />
      </column>
      <column caption='Metric avg down' datatype='real' name='[Calculation_699183910165061646]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG([Calculation_535224713484959745])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Metric Average - Row' datatype='real' name='[Calculation_699183910166229009]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG([Calculation_535224713484959745])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Metric Average - Pane ' datatype='real' name='[Calculation_699183910166409234]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// This is the WIN_AVG() calculated by PANE DOWN&#13;&#10;[Metric avg down (copy)_699183910165192719]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Metric Average - Column' datatype='real' name='[Calculation_699183910166581267]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// This is the WIN_AVG() calculated by TABLE DOWN&#13;&#10;[Calculation_699183910165061646]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% Metric Difference' datatype='real' name='[Calculation_699183910166802452]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_535224713484959745] - [Metric avg pane down (copy)_699183910165274640]) / [Metric avg pane down (copy)_699183910165274640]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='KPIs Graphs' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_735212659243257856]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 5]=&apos;Incoming Cases&apos; then sum(round([inbound_contact_ind],2))&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;Incoming Cases %&apos; then ROUND(SUM([inbound_contact_ind]) / TOTAL(SUM([inbound_contact_ind])),2)*100&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;Resolved Cases&apos; then round(sum([resolved_contact_ind]),2)&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;Resolved Cases %&apos; then ROUND(SUM([resolved_contact_ind]) / TOTAL(SUM([resolved_contact_ind])),2)*100&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;Case AHT (h)&apos; then ROUND([Case AHT (h) (copy)_1194016888909897728],1)&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;Chat AHT (m)&apos; then ROUND([Calculation_1194016888929374213],1)&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;Incoming Cases per order&apos; then ROUND([Cases per order (copy)_552535426687778822],3)*100&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;Resolved Cases per order&apos; then ROUND([Cases per order (copy) (copy)_552535426687787015],3)*100&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;FullRT&apos; then ROUND([Calculation_1515179817555480578],1)&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;QA Score (%)&apos; then ROUND([Calculation_526358231821787148],3)*100&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;# Audits&apos; then ROUND([Calculation_1476899229110317057],0)&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;After Contact CSAT (%)&apos; then ROUND([Calculation_338121849629618177],0)&#13;&#10;//ELSEIF  [KPIs Graphs Evolution]=&apos;% 1-time contact&apos; THEN ROUND([% 1-time contact],3)*100&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='After Contact CSAT Contribution' datatype='real' name='[Calculation_7796575385002577922]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(WINDOW_SUM(SUM([count_ac_csat_4_5])) / WINDOW_SUM(SUM([count_ac_csat_responses]))) // window aggregate&#10;-&#10;(&#10;&#9;(  WINDOW_SUM(SUM([count_ac_csat_4_5])) // window sum numerator&#10;&#9; - LOOKUP(SUM([count_ac_csat_4_5]), 0) // current row numerator&#10;&#9;)&#10;&#9;/&#10;&#9;(  WINDOW_SUM(SUM([count_ac_csat_responses])) // window sum denominator&#10;&#9; - LOOKUP(SUM([count_ac_csat_responses]), 0) // current row denominator&#10;&#9;)&#10;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Case AHT Non-Live (h)' datatype='real' default-format='n#,##0;-#,##0' name='[Case AHT (h) (copy)_1194016888909897728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//Non Chat Case AHT (hours)&#10;(&#10;SUM(&#10;    CASE [channel] WHEN &apos;Chat&apos; THEN 0&#10;    ELSE [handling_time_secs] END &#10;   )&#10;/&#10;SUM(&#10;    CASE [channel] WHEN &apos;Chat&apos; THEN 0&#10;    ELSE [resolved_contact_ind] END &#10;   )&#10;   )&#10;/60&#10;&#10;/60' />
      </column>
      <column caption='Orders for Delivery Type' datatype='real' hidden='true' name='[Cases for Delivery Type (copy)_5055431335538511874]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Cases (copy)_2949294850072502276]&#10;    WHEN &apos;Cases per order - All&apos; THEN [Calculation_1252000751479169032]&#10;    ELSE { INCLUDE [report_date], [delivery_type] : SUM([Calculation_1252000751479169032]) }&#10;END' />
      </column>
      <column caption='Cases per Order Evolution' datatype='real' default-format='p0.00%' name='[Cases per Order (copy)_1095571024893714444]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([KPIs Graphs (copy)_552535426223271940]) / SUM([Calculation_1252000751479169032])' />
      </column>
      <column caption='Resolved Cases per order' datatype='real' default-format='p0.00%' name='[Cases per order (copy) (copy)_552535426687787015]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([resolved_contact_ind])/SUM([Calculation_1252000751479169032])' />
      </column>
      <column caption='Incoming Cases per order' datatype='real' default-format='p0.00%' name='[Cases per order (copy)_552535426687778822]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([inbound_contact_ind])/SUM([Calculation_1252000751479169032])' />
      </column>
      <column caption='Chat AHT numerator' datatype='real' name='[Chat AHT (m) (copy)_2503438489939726340]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    CASE [channel] WHEN &apos;Chat&apos; THEN [Handling Time (copy)_1194016888929615878]&#10;    ELSE 0 END &#10;   )' />
      </column>
      <column caption='Chat AHT denominator' datatype='real' name='[Chat AHT (m) (copy)_2503438489939939333]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    CASE [channel] WHEN &apos;Chat&apos; THEN [Resolved Cases (copy)_1194016888930238471]&#10;    ELSE 0 END &#10;   )' />
      </column>
      <column caption='Chat Avg Total HT (m)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Chat AHT (m) (copy)_5870160642274512896]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(&#10;    CASE [channel] WHEN &apos;Chat&apos; THEN ZN([Handling Time (copy)_1194016888929615878]) + ZN([wrap_up_time_secs])&#10;    ELSE 0 END &#10;   )&#10;/&#10;SUM(&#10;    CASE [channel] WHEN &apos;Chat&apos; THEN [Resolved Cases (copy)_1194016888930238471]&#10;    ELSE 0 END &#10;   )&#10;)/60' />
      </column>
      <column caption='Chat Avg. Wrap Time (m)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Chat AHT (m) (copy)_5870160642275184642]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(&#10;    CASE [channel] WHEN &apos;Chat&apos; THEN [wrap_up_time_secs]&#10;    ELSE 0 END &#10;   )&#10;/&#10;SUM(&#10;    CASE [channel] WHEN &apos;Chat&apos; THEN [Resolved Cases (copy)_1194016888930238471]&#10;    ELSE 0 END &#10;   )&#10;)/60' />
      </column>
      <column caption='Case AHT Non-Live (h) Contribution' datatype='real' name='[Chat AHT(m) Contribution (copy)_3956412320066273280]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(WINDOW_SUM(SUM(CASE [channel] WHEN &apos;Chat&apos; THEN 0 ELSE [handling_time_secs] END)) / WINDOW_SUM(SUM(CASE [channel] WHEN &apos;Chat&apos; THEN 0 ELSE [resolved_contact_ind] END))) /3600 // window aggregate&#10;-&#10;(&#10;&#9;(  WINDOW_SUM(SUM(CASE [channel] WHEN &apos;Chat&apos; THEN 0 ELSE [handling_time_secs] END)) // window sum numerator&#10;&#9; - LOOKUP(SUM(CASE [channel] WHEN &apos;Chat&apos; THEN 0 ELSE [handling_time_secs] END), 0) // current row numerator&#10;&#9;)&#10;&#9;/&#10;&#9;(  WINDOW_SUM(SUM(CASE [channel] WHEN &apos;Chat&apos; THEN 0 ELSE [resolved_contact_ind] END)) // window sum denominator&#10;&#9; - LOOKUP(SUM(CASE [channel] WHEN &apos;Chat&apos; THEN 0 ELSE [resolved_contact_ind] END), 0) // current row denominator&#10;&#9;)&#10;        /3600&#10;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Granularity' datatype='string' name='[Choosen Dimension Graphs (copy)_526358231826968593]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Month&apos; THEN STR([month])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Week&apos; THEN STR([week])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Date&apos; THEN STR([report_date])&#10;END' />
      </column>
      <column caption='Date' datatype='date' name='[Date Range  (copy)_2503438490013786122]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[report_date]' />
      </column>
      <column caption='lookup first value in Granularity' datatype='string' name='[Granularity (copy)_6572722229298831362]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Month&apos; THEN STR(LOOKUP(MIN([month]),FIRST()))&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Week&apos; THEN STR(LOOKUP(MIN([week]),FIRST()))&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Date&apos; THEN STR(LOOKUP(MIN([report_date]),FIRST()))&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Chat Handling Time' datatype='real' name='[Handling Time (copy)_1194016888929615878]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [channel] = &apos;Chat&apos;&#10;THEN [handling_time_secs]&#10;END' />
      </column>
      <column caption='1st Dimension' datatype='string' default-format='n#,##0.0;-#,##0.0' name='[KPIS 1 (copy)]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 6]= &apos;DH Regions&apos; THEN [dh_region]&#10;ELSEIF [Parameters].[Parameter 6]=&apos;Management Entity&apos; THEN [management_entity_group]&#10;ELSEIF [Parameters].[Parameter 6]=&apos;Contact Center&apos; THEN [contact_center]&#10;ELSEIF [Parameters].[Parameter 6]=&apos;Country&apos; THEN [country]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Brand&apos; THEN [brand]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Channel&apos; THEN [channel]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Stakeholder&apos; THEN [stakeholder]&#10;ELSEIF [Parameters].[Parameter 6]=&apos;Agent Facing Tool&apos; THEN [agent_facing_tool]&#10;ELSEIF [Parameters].[Parameter 6]=&apos;Stakeholder Entry Point&apos; THEN [stakeholder_entry_point]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Contact Resolution Skill&apos; THEN [contact_resolution_skill]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Vertical&apos; THEN [vertical]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Delivery Type&apos; THEN [delivery_type]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Is Preorder?&apos; THEN STR([is_preorder])&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Is Corporate ?&apos; THEN STR([is_corporate])&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Is Subscription ?&apos; THEN STR([is_subscription])&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Global&apos; THEN [Calculation_610026676822482944]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Ownership&apos; THEN [ownership]&#13;&#10;END' />
      </column>
      <column caption='KPIs Trends' datatype='real' default-format='*0%▲;-0%▼' name='[KPIs Evolution Trends (copy)_6572722229307621379]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[KPIs Graphs Evolution (copy)_6572722229307867140]&#10;WHEN &apos;Case AHT (h)&apos;              THEN IF ISNULL(LOOKUP(ZN([Case AHT (h) (copy)_1194016888909897728]),-1)) THEN 0 ELSE RUNNING_SUM(ZN([Case AHT (h) (copy)_1194016888909897728]) - LOOKUP(ZN([Case AHT (h) (copy)_1194016888909897728]), -1)) / LOOKUP(ZN([Case AHT (h) (copy)_1194016888909897728]), FIRST()) END&#10;WHEN &apos;Chat AHT (m)&apos;              THEN IF ISNULL(LOOKUP(ZN([Calculation_1194016888929374213]),-1)) THEN 0 ELSE RUNNING_SUM(ZN([Calculation_1194016888929374213]) - LOOKUP(ZN([Calculation_1194016888929374213]), -1)) / LOOKUP(ZN([Calculation_1194016888929374213]), FIRST()) END&#10;WHEN &apos;After Contact CSAT (%)&apos;    THEN IF ISNULL(LOOKUP(ZN([CSAT (in percentage) (copy)_1095571024879681546]),-1)) THEN 0 ELSE RUNNING_SUM(ZN([CSAT (in percentage) (copy)_1095571024879681546]) - LOOKUP(ZN([CSAT (in percentage) (copy)_1095571024879681546]), -1)) END&#10;WHEN &apos;FCR (%)&apos;                   THEN IF ISNULL(LOOKUP(ZN([Calculation_552535426702155790]),-1)) THEN 0 ELSE RUNNING_SUM(ZN([Calculation_552535426702155790]) - LOOKUP(ZN([Calculation_552535426702155790]), -1)) END&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Cases' datatype='real' default-format='n#,##0;-#,##0' name='[KPIs Graphs (copy)_552535426223271940]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[KPIs Graphs (copy)_552535426223394821]=&apos;Incoming Cases&apos; then [inbound_contact_ind]&#13;&#10;ELSEIF [Parameters].[KPIs Graphs (copy)_552535426223394821]=&apos;Resolved Cases&apos; then [resolved_contact_ind]&#13;&#10;END' />
      </column>
      <column caption='KPIs Evolution Trends' datatype='real' default-format='*0%▲;0%▼' name='[KPIs Graphs (copy)_6291880589552807937]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;&#10;WHEN &apos;Incoming Cases&apos;             THEN IF ISNULL(LOOKUP(ZN(SUM([inbound_contact_ind])),-1)) THEN 0 ELSE RUNNING_SUM(ZN(sum([inbound_contact_ind])) - LOOKUP(ZN(sum([inbound_contact_ind])), -1)) / LOOKUP(ZN(sum([inbound_contact_ind])), FIRST()) END&#10;WHEN &apos;Incoming Cases %&apos;           THEN IF ISNULL(LOOKUP(ZN(SUM([inbound_contact_ind]) / TOTAL(SUM([inbound_contact_ind]))), -1)) THEN 0 ELSE RUNNING_SUM(ZN(SUM([inbound_contact_ind]) / TOTAL(SUM([inbound_contact_ind]))) - LOOKUP(ZN(SUM([inbound_contact_ind]) / TOTAL(SUM([inbound_contact_ind]))), -1)) END&#10;WHEN &apos;Resolved Cases&apos;             THEN IF ISNULL(LOOKUP(ZN(SUM([resolved_contact_ind])),-1)) THEN 0 ELSE RUNNING_SUM(ZN(sum([resolved_contact_ind])) - LOOKUP(ZN(sum([resolved_contact_ind])), -1)) / LOOKUP(ZN(sum([resolved_contact_ind])), FIRST()) END&#10;WHEN &apos;Resolved Cases %&apos;           THEN IF ISNULL(LOOKUP(ZN(SUM([resolved_contact_ind]) / TOTAL(SUM([resolved_contact_ind]))), -1)) THEN 0 ELSE RUNNING_SUM(ZN(SUM([resolved_contact_ind]) / TOTAL(SUM([resolved_contact_ind]))) - LOOKUP(ZN(SUM([resolved_contact_ind]) / TOTAL(SUM([resolved_contact_ind]))), -1)) END&#10;WHEN &apos;Case AHT (h)&apos;               THEN IF ISNULL(LOOKUP(ZN([Case AHT (h) (copy)_1194016888909897728]),-1)) THEN 0 ELSE RUNNING_SUM(ZN([Case AHT (h) (copy)_1194016888909897728]) - LOOKUP(ZN([Case AHT (h) (copy)_1194016888909897728]), -1)) / LOOKUP(ZN([Case AHT (h) (copy)_1194016888909897728]), FIRST()) END&#10;WHEN &apos;Chat AHT (m)&apos;               THEN IF ISNULL(LOOKUP(ZN([Calculation_1194016888929374213]),-1)) THEN 0 ELSE RUNNING_SUM(ZN([Calculation_1194016888929374213]) - LOOKUP(ZN([Calculation_1194016888929374213]), -1)) / LOOKUP(ZN([Calculation_1194016888929374213]), FIRST()) END&#10;WHEN &apos;Incoming Cases per order&apos;   THEN IF ISNULL(LOOKUP(ZN([Cases per order (copy)_552535426687778822]), -1)) THEN 0 ELSE RUNNING_SUM(ZN([Cases per order (copy)_552535426687778822]) - LOOKUP(ZN([Cases per order (copy)_552535426687778822]), -1)) END&#10;WHEN &apos;Resolved Cases per order&apos;   THEN IF ISNULL(LOOKUP(ZN([Cases per order (copy) (copy)_552535426687787015]), -1)) THEN 0 ELSE RUNNING_SUM(ZN([Cases per order (copy) (copy)_552535426687787015]) - LOOKUP(ZN([Cases per order (copy) (copy)_552535426687787015]), -1)) END&#10;WHEN &apos;FullRT&apos;                     THEN IF ISNULL(LOOKUP(ZN([Calculation_1515179817555480578]),-1)) THEN 0 ELSE RUNNING_SUM(ZN([Calculation_1515179817555480578]) - LOOKUP(ZN([Calculation_1515179817555480578]), -1)) / LOOKUP(ZN([Calculation_1515179817555480578]), FIRST()) END&#10;WHEN &apos;QA Score&apos;                   THEN IF ISNULL(LOOKUP(ZN([Calculation_526358231821787148]),-1)) THEN 0 ELSE RUNNING_SUM(ZN([Calculation_526358231821787148]) - LOOKUP(ZN([Calculation_526358231821787148]), -1)) / LOOKUP(ZN([Calculation_526358231821787148]), FIRST()) END&#10;WHEN &apos;After Contact CSAT (%)&apos;     THEN IF ISNULL(LOOKUP(ZN([CSAT (in percentage) (copy)_1095571024879681546]),-1)) THEN 0 ELSE RUNNING_SUM(ZN([CSAT (in percentage) (copy)_1095571024879681546]) - LOOKUP(ZN([CSAT (in percentage) (copy)_1095571024879681546]), -1)) END&#10;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Cases per Order Trend' datatype='real' default-format='*0.00%▲;0.00%▼' name='[KPIs Trends (copy)_1095571024895201293]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(ZN([Cases per Order (copy)_1095571024893714444]) - LOOKUP(ZN([Cases per Order (copy)_1095571024893714444]), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='lookup first value in KPI Trends' datatype='real' default-format='n#,##0;-#,##0' name='[KPIs Trends (copy)_6572722229312962565]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[KPIs Graphs Evolution (copy)_6572722229307867140]&#10;WHEN &apos;Case AHT (h)&apos;               THEN LOOKUP(ZN([Case AHT (h) (copy)_1194016888909897728]), FIRST()) &#10;WHEN &apos;Chat AHT (m)&apos;               THEN LOOKUP(ZN([Calculation_1194016888929374213]), FIRST())&#10;WHEN &apos;After Contact CSAT (%)&apos;     THEN LOOKUP(ZN([CSAT (in percentage) (copy)_1095571024879681546]), FIRST())*100&#10;WHEN &apos;FCR (%)&apos;                    THEN LOOKUP(ZN([Calculation_552535426702155790]), FIRST())*100&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Metric avg pane down' datatype='real' name='[Metric avg down (copy)_699183910165192719]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG([Calculation_535224713484959745])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Metric Average' datatype='real' name='[Metric avg pane down (copy)_699183910165274640]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5 1]&#13;&#10;&#13;&#10;WHEN &apos;Row&apos;    THEN [Calculation_699183910166229009]&#13;&#10;WHEN &apos;Column&apos; THEN [Calculation_699183910166581267]&#10;WHEN &apos;Pane&apos;   THEN [Calculation_699183910166409234]&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Case AHT Live (m)' datatype='real' default-format='n#,##0;-#,##0' hidden='true' name='[Non Chat Case AHT (hours) (copy)_1194016888913399811]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Chat Case (m)&#10;&#10;(SUM(&#10;    CASE [channel] WHEN &apos;Chat&apos; THEN [handling_time_secs]&#10;    ELSE 0 END &#10;   )&#10; /&#10;SUM(&#10;    CASE [channel] WHEN &apos;Chat&apos; THEN [resolved_contact_ind]&#10;    ELSE 0 END &#10;   )&#10;)&#10;/60' />
      </column>
      <column caption='Total Served Chats' datatype='real' name='[Resolved Cases (copy)_1194016888930238471]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [channel] = &apos;Chat&apos; THEN [resolved_contact_ind]&#10;END' />
      </column>
      <column caption='% Metric Difference(+/-)' datatype='real' default-format='p0.00%' name='[Selected Metric (copy)_699183910167060501]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2 1]&#10;  WHEN &apos;Chat AHT (m)&apos;                               THEN -[Calculation_699183910166802452]&#10;  WHEN &apos;Case AHT Non-Live (h)&apos;                      THEN -[Calculation_699183910166802452]&#10;  WHEN &apos;After Contact CSAT (in percentage)&apos;         THEN [Calculation_699183910166802452]&#10;  WHEN &apos;Resolved Cases per Order (in percentage)&apos;   THEN -[Calculation_699183910166802452]&#10;  WHEN  &apos;# Incoming Cases&apos;                          THEN -[Calculation_699183910166802452]&#10;  WHEN  &apos;# Resolved Cases&apos;                          THEN -[Calculation_699183910166802452]&#10;  WHEN  &apos;Chat Avg. Wrap Time (m)&apos;                   THEN -[Calculation_699183910166802452]&#10;  WHEN  &apos;Chat Avg. THT (m)&apos;                         THEN -[Calculation_699183910166802452]&#10;  WHEN  &apos;Avg. Full Resolution Time&apos;                 THEN -[Calculation_699183910166802452]&#10;  WHEN  &apos;# After Contact CSAT Responses&apos;            THEN [Calculation_699183910166802452]&#10;  WHEN  &apos;QA Score (in percentage)&apos;                  THEN [Calculation_699183910166802452]&#13;&#10;  WHEN  &apos;# Audits&apos;                                  THEN [Calculation_699183910166802452]&#10;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
