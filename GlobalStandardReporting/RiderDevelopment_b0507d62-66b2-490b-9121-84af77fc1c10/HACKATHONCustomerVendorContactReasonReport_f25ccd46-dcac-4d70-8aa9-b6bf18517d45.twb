          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='contact_reason_report' name='federated.15cehv015dgmno1abds701w52j7r' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='2nd Dimension' datatype='string' name='[1st Dimension (copy)_2391270706831839232]' param-domain-type='list' role='measure' type='nominal' value='&quot;Stakeholder&quot;'>
              <calculation class='tableau' formula='&quot;Stakeholder&quot;' />
              <aliases>
                <alias key='&quot;Contact Center&quot;' value='Contact Center' />
              </aliases>
            </column>
            <column alias='Weekly' caption='Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
              <aliases>
                <alias key='&quot;Date&quot;' value='Daily' />
                <alias key='&quot;Month&quot;' value='Monthly' />
                <alias key='&quot;Week&quot;' value='Weekly' />
              </aliases>
            </column>
            <column caption='1st Dimension' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Management Entity&quot;'>
              <calculation class='tableau' formula='&quot;Management Entity&quot;' />
              <aliases>
                <alias key='&quot;Contact Center&quot;' value='Contact Center' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.15cehv015dgmno1abds701w52j7r'>
            <column caption='2nd Dimension' datatype='string' default-format='n#,##0.0;-#,##0.0' name='[1st Dimension (copy)_2391270706831896577]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[1st Dimension (copy)_2391270706831839232]= &apos;DH Regions&apos; THEN [dh_region]&#10;ELSEIF [Parameters].[1st Dimension (copy)_2391270706831839232]=&apos;Management Entity&apos; THEN [management_entity_group]&#10;ELSEIF [Parameters].[1st Dimension (copy)_2391270706831839232]=&apos;Contact Center&apos; THEN [contact_center]&#10;ELSEIF [Parameters].[1st Dimension (copy)_2391270706831839232]=&apos;Country&apos; THEN [country]&#10;ELSEIF  [Parameters].[1st Dimension (copy)_2391270706831839232]=&apos;Brand&apos; THEN [brand]&#10;ELSEIF  [Parameters].[1st Dimension (copy)_2391270706831839232]=&apos;Channel&apos; THEN [channel]&#10;ELSEIF  [Parameters].[1st Dimension (copy)_2391270706831839232]=&apos;Stakeholder&apos; THEN [stakeholder]&#10;ELSEIF [Parameters].[1st Dimension (copy)_2391270706831839232]=&apos;Agent Facing Tool&apos; THEN [agent_facing_tool]&#10;ELSEIF [Parameters].[1st Dimension (copy)_2391270706831839232]=&apos;Stakeholder Entry Point&apos; THEN [stakeholder_entry_point]&#10;ELSEIF  [Parameters].[1st Dimension (copy)_2391270706831839232]=&apos;Contact Resolution Skill&apos; THEN [contact_resolution_skill]&#10;ELSEIF  [Parameters].[1st Dimension (copy)_2391270706831839232]=&apos;Vertical&apos; THEN [vertical]&#10;ELSEIF  [Parameters].[1st Dimension (copy)_2391270706831839232]=&apos;Delivery Type&apos; THEN [delivery_type]&#10;ELSEIF  [Parameters].[1st Dimension (copy)_2391270706831839232]=&apos;Is Preorder?&apos; THEN STR([is_preorder])&#10;ELSEIF  [Parameters].[1st Dimension (copy)_2391270706831839232]=&apos;Is Corporate ?&apos; THEN STR([is_corporate])&#10;ELSEIF  [Parameters].[1st Dimension (copy)_2391270706831839232]=&apos;Is Subscription ?&apos; THEN STR([is_subscription])&#10;ELSEIF  [Parameters].[1st Dimension (copy)_2391270706831839232]=&apos;Global&apos; THEN [Calculation_610026676822482944]&#10;ELSEIF  [Parameters].[1st Dimension (copy)_2391270706831839232]=&apos;Ownership&apos; THEN [ownership]&#13;&#10;END' />
            </column>
            <column caption='Chat AHT (m)' datatype='real' name='[Calculation_1194016888929374213]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(&#10;    CASE [channel] WHEN &apos;Chat&apos; THEN [Handling Time (copy)_1194016888929615878]&#10;    ELSE 0 END &#10;   )&#10;/&#10;SUM(&#10;    CASE [channel] WHEN &apos;Chat&apos; THEN [Resolved Cases (copy)_1194016888930238471]&#10;    ELSE 0 END &#10;   )&#10;)/60' />
            </column>
            <column caption='# Audits' datatype='real' name='[Calculation_1476899229110317057]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([evaluations])' />
            </column>
            <column caption='Avg. Full Resolution Time (h)' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1515179817555480578]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([full_resolution_time_min]) / SUM([resolved_contact_ind]) /60' />
            </column>
            <column caption='After Contact CSAT (in percentage)' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_338121849629618177]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_ac_csat_4_5]) / SUM([count_ac_csat_responses]) * 100' />
            </column>
            <column caption='QA Score' datatype='real' name='[Calculation_526358231821787148]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([score_avg])/SUM([evaluations])' />
            </column>
            <column caption='FCR (%)' datatype='real' default-format='p0.0%' name='[Calculation_552535426702155790]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// --- old definition :&#10;//SUM(IF NOT ISNULL([CR Category L1]) AND [CR Category L1] &lt;&gt; &apos;Ticket without CCR&apos; THEN [Count First Contact Resolution] END)&#10;// /&#10;//SUM(IF NOT ISNULL([CR Category L1]) AND [CR Category L1] &lt;&gt; &apos;Ticket without CCR&apos; THEN [Count Contacts Related To Order] END)&#10;&#10;&#10;// updated as part of RASD-2083 to new definition of FCR : Number of Order-CCR combinations with only one contact / Number of total Order-CCR combinations.&#10;SUM([count_first_contact_resolution])&#10;/&#10;SUM([count_contacts_related_to_order])' />
            </column>
            <column caption='% of contacts with order number' datatype='real' default-format='p0%' name='[Calculation_552535426703106063]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([count_contacts_related_to_order]) / SUM([inbound_contact_ind])' />
            </column>
            <column caption='Global' datatype='string' name='[Calculation_610026676822482944]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;Global&apos;' />
            </column>
            <column caption='Case AHT Non-Live (h)' datatype='real' default-format='n#,##0;-#,##0' name='[Case AHT (h) (copy)_1194016888909897728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//Non Chat Case AHT (hours)&#10;(&#10;SUM(&#10;    CASE [channel] WHEN &apos;Chat&apos; THEN 0&#10;    ELSE [handling_time_secs] END &#10;   )&#10;/&#10;SUM(&#10;    CASE [channel] WHEN &apos;Chat&apos; THEN 0&#10;    ELSE [resolved_contact_ind] END &#10;   )&#10;   )&#10;/60&#10;&#10;/60' />
            </column>
            <column caption='Chat Avg Total HT (m)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Chat AHT (m) (copy)_5870160642274512896]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(&#10;    CASE [channel] WHEN &apos;Chat&apos; THEN ZN([Handling Time (copy)_1194016888929615878]) + ZN([wrap_up_time_secs])&#10;    ELSE 0 END &#10;   )&#10;/&#10;SUM(&#10;    CASE [channel] WHEN &apos;Chat&apos; THEN [Resolved Cases (copy)_1194016888930238471]&#10;    ELSE 0 END &#10;   )&#10;)/60' />
            </column>
            <column caption='Chat Avg. Wrap Time (m)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Chat AHT (m) (copy)_5870160642275184642]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(&#10;    CASE [channel] WHEN &apos;Chat&apos; THEN [wrap_up_time_secs]&#10;    ELSE 0 END &#10;   )&#10;/&#10;SUM(&#10;    CASE [channel] WHEN &apos;Chat&apos; THEN [Resolved Cases (copy)_1194016888930238471]&#10;    ELSE 0 END &#10;   )&#10;)/60' />
            </column>
            <column caption='Granularity' datatype='string' name='[Choosen Dimension Graphs (copy)_526358231826968593]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Month&apos; THEN STR([month])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Week&apos; THEN STR([week])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Date&apos; THEN STR([report_date])&#10;END' />
            </column>
            <column caption='Date' datatype='date' name='[Date Range  (copy)_2503438490013786122]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[report_date]' />
            </column>
            <column caption='Chat Handling Time' datatype='real' name='[Handling Time (copy)_1194016888929615878]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [channel] = &apos;Chat&apos;&#10;THEN [handling_time_secs]&#10;END' />
            </column>
            <column caption='1st Dimension' datatype='string' default-format='n#,##0.0;-#,##0.0' name='[KPIS 1 (copy)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 6]= &apos;DH Regions&apos; THEN [dh_region]&#10;ELSEIF [Parameters].[Parameter 6]=&apos;Management Entity&apos; THEN [management_entity_group]&#10;ELSEIF [Parameters].[Parameter 6]=&apos;Contact Center&apos; THEN [contact_center]&#10;ELSEIF [Parameters].[Parameter 6]=&apos;Country&apos; THEN [country]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Brand&apos; THEN [brand]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Channel&apos; THEN [channel]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Stakeholder&apos; THEN [stakeholder]&#10;ELSEIF [Parameters].[Parameter 6]=&apos;Agent Facing Tool&apos; THEN [agent_facing_tool]&#10;ELSEIF [Parameters].[Parameter 6]=&apos;Stakeholder Entry Point&apos; THEN [stakeholder_entry_point]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Contact Resolution Skill&apos; THEN [contact_resolution_skill]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Vertical&apos; THEN [vertical]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Delivery Type&apos; THEN [delivery_type]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Is Preorder?&apos; THEN STR([is_preorder])&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Is Corporate ?&apos; THEN STR([is_corporate])&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Is Subscription ?&apos; THEN STR([is_subscription])&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Global&apos; THEN [Calculation_610026676822482944]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Ownership&apos; THEN [ownership]&#13;&#10;END' />
            </column>
            <column caption='Total Served Chats' datatype='real' name='[Resolved Cases (copy)_1194016888930238471]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [channel] = &apos;Chat&apos; THEN [resolved_contact_ind]&#10;END' />
            </column>
            <column caption='Agent Facing Tool' datatype='string' name='[agent_facing_tool]' role='dimension' type='nominal'>
              <aliases>
                <alias key='%null%' value='N/A' />
              </aliases>
            </column>
            <column caption='Brand' datatype='string' name='[brand]' role='dimension' type='nominal' />
            <column caption='Channel' datatype='string' name='[channel]' role='dimension' type='nominal' />
            <column caption='Contact Center' datatype='string' name='[contact_center]' role='dimension' type='nominal' />
            <column caption='CR Level 1' datatype='string' name='[contact_reason_l1]' role='dimension' type='nominal' />
