            <column caption='Cases by Delivery Type' datatype='string' datatype-customized='true' name='[Cases (copy)_2949294850072502276]' param-domain-type='list' role='measure' type='nominal' value='&quot;Cases per order - All&quot;'>
              <calculation class='tableau' formula='&quot;Cases per order - All&quot;' />
            </column>
            <column caption='Cases' datatype='string' datatype-customized='true' name='[KPIs Graphs (copy)_552535426223394821]' param-domain-type='list' role='measure' type='nominal' value='&quot;Resolved Cases&quot;'>
              <calculation class='tableau' formula='&quot;Resolved Cases&quot;' />
            </column>
            <column alias='Weekly' caption='Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
              <aliases>
                <alias key='&quot;Date&quot;' value='Daily' />
                <alias key='&quot;Month&quot;' value='Monthly' />
                <alias key='&quot;Week&quot;' value='Weekly' />
              </aliases>
            </column>
            <column caption='1st Dimension' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Management Entity&quot;'>
              <calculation class='tableau' formula='&quot;Management Entity&quot;' />
              <aliases>
                <alias key='&quot;Contact Center&quot;' value='Contact Center' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.15cehv015dgmno1abds701w52j7r'>
            <column caption='2nd Dimension' datatype='string' default-format='n#,##0.0;-#,##0.0' name='[1st Dimension (copy)_2391270706831896577]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[1st Dimension (copy)_2391270706831839232]= &apos;DH Regions&apos; THEN [dh_region]&#10;ELSEIF [Parameters].[1st Dimension (copy)_2391270706831839232]=&apos;Management Entity&apos; THEN [management_entity_group]&#10;ELSEIF [Parameters].[1st Dimension (copy)_2391270706831839232]=&apos;Contact Center&apos; THEN [contact_center]&#10;ELSEIF [Parameters].[1st Dimension (copy)_2391270706831839232]=&apos;Country&apos; THEN [country]&#10;ELSEIF  [Parameters].[1st Dimension (copy)_2391270706831839232]=&apos;Brand&apos; THEN [brand]&#10;ELSEIF  [Parameters].[1st Dimension (copy)_2391270706831839232]=&apos;Channel&apos; THEN [channel]&#10;ELSEIF  [Parameters].[1st Dimension (copy)_2391270706831839232]=&apos;Stakeholder&apos; THEN [stakeholder]&#10;ELSEIF [Parameters].[1st Dimension (copy)_2391270706831839232]=&apos;Agent Facing Tool&apos; THEN [agent_facing_tool]&#10;ELSEIF [Parameters].[1st Dimension (copy)_2391270706831839232]=&apos;Stakeholder Entry Point&apos; THEN [stakeholder_entry_point]&#10;ELSEIF  [Parameters].[1st Dimension (copy)_2391270706831839232]=&apos;Contact Resolution Skill&apos; THEN [contact_resolution_skill]&#10;ELSEIF  [Parameters].[1st Dimension (copy)_2391270706831839232]=&apos;Vertical&apos; THEN [vertical]&#10;ELSEIF  [Parameters].[1st Dimension (copy)_2391270706831839232]=&apos;Delivery Type&apos; THEN [delivery_type]&#10;ELSEIF  [Parameters].[1st Dimension (copy)_2391270706831839232]=&apos;Is Preorder?&apos; THEN STR([is_preorder])&#10;ELSEIF  [Parameters].[1st Dimension (copy)_2391270706831839232]=&apos;Is Corporate ?&apos; THEN STR([is_corporate])&#10;ELSEIF  [Parameters].[1st Dimension (copy)_2391270706831839232]=&apos;Is Subscription ?&apos; THEN STR([is_subscription])&#10;ELSEIF  [Parameters].[1st Dimension (copy)_2391270706831839232]=&apos;Global&apos; THEN [Calculation_610026676822482944]&#10;ELSEIF  [Parameters].[1st Dimension (copy)_2391270706831839232]=&apos;Ownership&apos; THEN [ownership]&#13;&#10;END' />
            </column>
            <column caption='Orders' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1252000751479169032]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Old logic -- revised 28-Feb-21&#10;// { FIXED [Source Id],[Date Range], [Vertical], [Delivery Type] : MAX([Gross Orders]) }&#10;&#10;// Revised per bug reported in RASD-1347&#10;// After the CCR design was updated to insert gross_orders just once rather than being included in each record, the old LOD above no longer worked.&#10;// Revised logic first gets the max() at that level same as last time, but then uses EXCLUDE to remove the CCR granularity when &#10;// adding the orders. The final effect is that orders are again appropriately counted just once per date, delivery type, vertical &amp; source ID.&#10;&#10;{ EXCLUDE [contact_reason_l1], [contact_reason_l2], [contact_reason_l3] :&#10;&#9;SUM( { FIXED [report_date], [delivery_type], [vertical],[is_corporate], [is_preorder], [is_subscription],[global_entity_id] : MAX([gross_orders]) }) &#10;}' />
            </column>
            <column caption='Cases per Order' datatype='real' default-format='p0.00%' name='[Calculation_1252000751479709705]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(CASE [Parameters].[Cases (copy)_2949294850072502276]&#10;        WHEN &apos;Cases per order - All&apos; THEN [KPIs Graphs (copy)_552535426223271940]&#10;        WHEN &apos;Cases per order - Own Delivery&apos; THEN IF [delivery_type] = &apos;Own Delivery&apos; THEN [KPIs Graphs (copy)_552535426223271940] END&#10;        WHEN &apos;Cases per order - Vendor Delivery&apos; THEN IF [delivery_type] = &apos;Vendor Delivery&apos; THEN [KPIs Graphs (copy)_552535426223271940] END&#10;        WHEN &apos;Cases per order - unknown&apos; THEN IF [delivery_type] = &apos;Unknown&apos; THEN [KPIs Graphs (copy)_552535426223271940] END&#10;        WHEN &apos;Cases per order - Pick-up&apos; THEN IF [delivery_type] = &apos;Pick-up&apos; THEN [KPIs Graphs (copy)_552535426223271940] END&#10;    END&#10;   )&#10;/&#10;SUM([Calculation_1252000751479169032])' />
            </column>
            <column caption='Cases for selected Delivery Type' datatype='real' name='[Calculation_5055431335537905664]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Cases (copy)_2949294850072502276]&#10;    WHEN &apos;Cases per order - All&apos; THEN [KPIs Graphs (copy)_552535426223271940]&#10;    WHEN &apos;Cases per order - Own Delivery&apos; THEN IF [delivery_type] = &apos;Own Delivery&apos; THEN [KPIs Graphs (copy)_552535426223271940] END&#10;    WHEN &apos;Cases per order - Vendor Delivery&apos; THEN IF [delivery_type] = &apos;Vendor Delivery&apos; THEN [KPIs Graphs (copy)_552535426223271940] END&#10;    WHEN &apos;Cases per order - unknown&apos; THEN IF [delivery_type] = &apos;unknown&apos; THEN [KPIs Graphs (copy)_552535426223271940] END&#10;    WHEN &apos;Cases per order - Pick-up&apos; THEN IF [delivery_type] = &apos;Pick-up&apos; THEN [KPIs Graphs (copy)_552535426223271940] END&#10;END' />
            </column>
            <column caption='Global' datatype='string' name='[Calculation_610026676822482944]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;Global&apos;' />
            </column>
            <column caption='Granularity' datatype='string' name='[Choosen Dimension Graphs (copy)_526358231826968593]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Month&apos; THEN STR([month])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Week&apos; THEN STR([week])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Date&apos; THEN STR([report_date])&#10;END' />
            </column>
            <column caption='Date' datatype='date' name='[Date Range  (copy)_2503438490013786122]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[report_date]' />
            </column>
            <column caption='1st Dimension' datatype='string' default-format='n#,##0.0;-#,##0.0' name='[KPIS 1 (copy)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 6]= &apos;DH Regions&apos; THEN [dh_region]&#10;ELSEIF [Parameters].[Parameter 6]=&apos;Management Entity&apos; THEN [management_entity_group]&#10;ELSEIF [Parameters].[Parameter 6]=&apos;Contact Center&apos; THEN [contact_center]&#10;ELSEIF [Parameters].[Parameter 6]=&apos;Country&apos; THEN [country]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Brand&apos; THEN [brand]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Channel&apos; THEN [channel]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Stakeholder&apos; THEN [stakeholder]&#10;ELSEIF [Parameters].[Parameter 6]=&apos;Agent Facing Tool&apos; THEN [agent_facing_tool]&#10;ELSEIF [Parameters].[Parameter 6]=&apos;Stakeholder Entry Point&apos; THEN [stakeholder_entry_point]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Contact Resolution Skill&apos; THEN [contact_resolution_skill]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Vertical&apos; THEN [vertical]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Delivery Type&apos; THEN [delivery_type]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Is Preorder?&apos; THEN STR([is_preorder])&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Is Corporate ?&apos; THEN STR([is_corporate])&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Is Subscription ?&apos; THEN STR([is_subscription])&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Global&apos; THEN [Calculation_610026676822482944]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Ownership&apos; THEN [ownership]&#13;&#10;END' />
            </column>
            <column caption='Cases' datatype='real' default-format='n#,##0;-#,##0' name='[KPIs Graphs (copy)_552535426223271940]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[KPIs Graphs (copy)_552535426223394821]=&apos;Incoming Cases&apos; then [inbound_contact_ind]&#13;&#10;ELSEIF [Parameters].[KPIs Graphs (copy)_552535426223394821]=&apos;Resolved Cases&apos; then [resolved_contact_ind]&#13;&#10;END' />
            </column>
