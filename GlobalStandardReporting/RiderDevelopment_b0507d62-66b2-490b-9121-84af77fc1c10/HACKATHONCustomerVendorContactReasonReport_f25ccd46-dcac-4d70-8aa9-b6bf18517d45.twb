            <column-instance column='[1st Dimension (copy)_2391270706831896577]' derivation='None' name='[none:1st Dimension (copy)_2391270706831896577:nk]' pivot='key' type='nominal' />
            <column-instance column='[Choosen Dimension Graphs (copy)_526358231826968593]' derivation='None' name='[none:Choosen Dimension Graphs (copy)_526358231826968593:nk]' pivot='key' type='nominal' />
