            <column alias='After Contact CSAT (%)' caption='Contribution KPIs' datatype='string' name='[KPIs (copy)_2503438489938403329]' param-domain-type='list' role='measure' type='nominal' value='&quot;After Contact CSAT (\%)&quot;'>
              <calculation class='tableau' formula='&quot;After Contact CSAT (%)&quot;' />
              <aliases>
