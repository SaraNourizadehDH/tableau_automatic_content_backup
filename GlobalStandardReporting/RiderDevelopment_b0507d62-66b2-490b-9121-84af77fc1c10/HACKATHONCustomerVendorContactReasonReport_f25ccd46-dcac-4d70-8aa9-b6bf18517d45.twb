                <run fontcolor='#1b1b1b' fontsize='9'>, </run>
                <run fontcolor='#1b1b1b' fontsize='9' italic='true'>Vendor Delivery</run>
                <run fontcolor='#1b1b1b' fontsize='9'> etc.</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#1b1b1b' fontsize='9'>By default this tab is on : Resolved Cases / All Orders</run>
                <run>Æ&#10;</run>
