            <customized-tooltip>
              <formatted-text>
                <run bold='true' fontcolor='#000000' fontsize='9'>NOTE :</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='9'>1/ Trend&apos; is the % change in </run>
                <run bold='true' fontcolor='#000000' fontsize='9'><![CDATA['<[Parameters].[KPIs Graphs Evolution (copy)_6572722229307867140]>']]></run>
                <run fontcolor='#000000' fontsize='9'> currently compared to the first value in the selected time period</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='9'>2/  This tab has </run>
                <run fontcolor='#000000' fontsize='9' underline='true'>single selection option</run>
                <run fontcolor='#000000' fontsize='9'> for the following filters : </run>
                <run bold='true' fontcolor='#000000' fontsize='9'>CR Level 1, CR Level 2, CR Level 3, CR Level, Metrics</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='9'>3/ By default the contact reason displayed is &apos;Across Journey&apos;  and the metric for which contact reason trend is displayed is CSAT(%). To display different metric and contact reason combinations, please refer to the usage instructions below : </run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#000000' fontsize='9'>USAGE INSTRUCTIONS :</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='9'>1/ Use </run>
                <run bold='true' fontcolor='#000000' fontsize='9'>Metrics </run>
                <run fontcolor='#000000' fontsize='9'>filter to select a metric for which you&apos;d like to view the trend</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='9'>2/  Use </run>
                <run bold='true' fontcolor='#000000' fontsize='9'>CR Level 1 </run>
                <run fontcolor='#000000' fontsize='9'>filter to select a  level 1 contact reason for which you&apos;d like to view the trend</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='9'>3 /  Use </run>
                <run bold='true' fontcolor='#000000' fontsize='9'>CR Level </run>
                <run fontcolor='#000000' fontsize='9'>filter to split the level 1 contact reason into its level 2 or level 3 components </run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='9'>4/  Use </run>
                <run bold='true' fontcolor='#000000' fontsize='9'>CR Level 2</run>
                <run fontcolor='#000000' fontsize='9'> , </run>
                <run bold='true' fontcolor='#000000' fontsize='9'>CR Level 3</run>
                <run fontcolor='#000000' fontsize='9'> filters to view specific level 2 and level 3 contact reasons</run>
              </formatted-text>
            </customized-tooltip>
            <style>
              <style-rule element='mark'>
                <format attr='shape' value='Bug Tracking/light.png' />
                <format attr='size' value='2.022099494934082' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
      <simple-id uuid='{A5905DC3-6F54-4EDF-ADAA-E8BC632AD375}' />
    </worksheet>
