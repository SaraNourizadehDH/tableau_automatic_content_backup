    <worksheet name='Pay Difference'>
      <table>
        <view>
          <datasources>
            <datasource caption='_pa_rider_payments_earnings_estimation (cl)' name='federated.07mqeo91wkl96s1dym4ig0zvimtf' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Include &lt;.01 cases' datatype='boolean' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='false'>
              <calculation class='tableau' formula='false' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.07mqeo91wkl96s1dym4ig0zvimtf'>
            <column caption='Pay Comparison' datatype='string' name='[Calculation_3475371594245640197]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] AND [Calculation_5196239233422499855] THEN &apos;Same&apos;&#10;ELSE&#10;    IF [total_paid] &gt; [latest_mobile_estimation] THEN &apos;More&apos;&#10;    ELSEIF [total_paid] &lt; [latest_mobile_estimation] THEN &apos;Less&apos;&#10;    ELSEIF [total_paid] = [latest_mobile_estimation] THEN &apos;Same&apos;&#10;    ELSE &apos;Incomplete Data&apos;&#10;    END&#10;END' />
            </column>
            <column caption='MIN(1)' datatype='integer' name='[Calculation_3475371594530533388]' role='measure' type='quantitative' user:unnamed='Country Paying more'>
              <calculation class='tableau' formula='MIN(1)' />
            </column>
            <column caption='Pay Difference' datatype='real' name='[Calculation_5196239233416577034]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_paid] - [latest_mobile_estimation]' />
            </column>
            <column caption='.01 Cases' datatype='boolean' name='[Calculation_5196239233422499855]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_5196239233416577034]&lt;=.01' />
            </column>
            <column caption='ZN([Avg Pay Difference - Pay Less])' datatype='real' name='[Calculation_5196239233426063377]' role='measure' type='quantitative' user:unnamed='Pay Difference'>
              <calculation class='tableau' formula='ZN([Pay Difference (copy)_5196239233416822795])' />
            </column>
            <column caption='Avg Pay Difference - Pay Less' datatype='real' default-format='p0.0%' name='[Pay Difference (copy)_5196239233416822795]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_paid] - (IF [Calculation_3475371594245640197] = &apos;Less&apos; THEN [latest_mobile_estimation] END)&#10;&#10;)/SUM([total_paid])' />
            </column>
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Created Date Local' datatype='date' name='[created_date_local]' role='dimension' type='ordinal' />
            <column caption='Is Accepted' datatype='boolean' name='[is_accepted]' role='dimension' type='nominal' />
