      <column caption='Avg Pay Difference - Pay More' datatype='real' default-format='p0.0%' name='[Avg Pay Difference - Pay Less (copy)_5196239233418862606]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_paid] - (IF [Calculation_3475371594245640197] = &apos;More&apos; THEN [latest_mobile_estimation] END)&#10;&#10;)/SUM([total_paid])' />
      </column>
      <column caption='Boost1' datatype='string' name='[Boost]' role='dimension' type='nominal' />
      <column caption='Actual Total Paid' datatype='real' name='[Calculation_2199867738945314818]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Boost] = &apos;yes&apos; AND [Tip] = &apos;no&apos; THEN [basic_payment]+[scoring_payment]+[boost_payment] &#10;ELSEIF [Boost] = &apos;yes&apos; AND [Tip] = &apos;yes&apos; THEN [basic_payment]+[scoring_payment]+[boost_payment]//+Tip&#10;ELSEIF [Boost] = &apos;no&apos; AND [Tip] = &apos;yes&apos; THEN [basic_payment]+[scoring_payment]//+tip&#10;ELSEIF [Boost] = &apos;no&apos; AND [Tip] = &apos;no&apos; THEN [basic_payment]+[scoring_payment]&#10;END' />
      </column>
      <column caption='Min Date Filter' datatype='boolean' name='[Calculation_2199867739008733187]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[created_date_local]&gt;={MIN(IF NOT(ISNULL([latest_mobile_estimation])) AND [latest_mobile_estimation]&gt;0 THEN [created_date_local] END)}' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_2937965496707665920]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Mobile Estimation Match' datatype='boolean' name='[Calculation_3475371594235666432]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] THEN&#10;([total_paid] = [latest_mobile_estimation]) OR [Calculation_5196239233422499855] &#10;ELSE    &#10;([total_paid] = [latest_mobile_estimation])&#10;END' />
        <aliases>
          <alias key='false' value='No Match' />
          <alias key='true' value='Match' />
        </aliases>
      </column>
      <column caption='Unique ID' datatype='string' name='[Calculation_3475371594237665283]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([delivery_id])+STR([rider_id])+[country_code]' />
      </column>
      <column caption='Mobile Estimate Match %' datatype='real' default-format='p0.00%' name='[Calculation_3475371594238902276]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Calculation_3475371594235666432] THEN [Calculation_3475371594237665283] END)/TOTAL(COUNTD([Calculation_3475371594237665283]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Pay Comparison' datatype='string' name='[Calculation_3475371594245640197]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] AND [Calculation_5196239233422499855] THEN &apos;Same&apos;&#10;ELSE&#10;    IF [total_paid] &gt; [latest_mobile_estimation] THEN &apos;More&apos;&#10;    ELSEIF [total_paid] &lt; [latest_mobile_estimation] THEN &apos;Less&apos;&#10;    ELSEIF [total_paid] = [latest_mobile_estimation] THEN &apos;Same&apos;&#10;    ELSE &apos;Incomplete Data&apos;&#10;    END&#10;END' />
      </column>
      <column caption='Paying Less' datatype='integer' name='[Calculation_3475371594533511189]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Calculation_3475371594245640197] = &apos;Less&apos; THEN [Calculation_3475371594237665283] END)' />
      </column>
      <column caption='Pay Difference' datatype='real' name='[Calculation_5196239233416577034]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[total_paid] - [latest_mobile_estimation]' />
      </column>
      <column caption='.01 Cases' datatype='boolean' name='[Calculation_5196239233422499855]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_5196239233416577034]&lt;=.01' />
      </column>
      <column caption='Index' datatype='integer' name='[Calculation_5196239233443696667]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Field'>
            <order field='[federated.07mqeo91wkl96s1dym4ig0zvimtf].[country_code]' />
            <order field='[federated.07mqeo91wkl96s1dym4ig0zvimtf].[created_date_local]' />
            <order field='[federated.07mqeo91wkl96s1dym4ig0zvimtf].[delivery_id]' />
            <order field='[federated.07mqeo91wkl96s1dym4ig0zvimtf].[hurrier_id]' />
            <order field='[federated.07mqeo91wkl96s1dym4ig0zvimtf].[Paying Less (copy)_5196239233400524800]' />
          </table-calc>
        </calculation>
      </column>
      <column caption='% Pay Difference' datatype='real' default-format='p0.0%' name='[Calculation_5196239233444028446]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_5196239233416577034])/SUM([total_paid])' />
      </column>
      <column caption='Pay More Flag' datatype='integer' name='[Calculation_5196239234444693537]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [Calculation_3475371594245640197] = &apos;More&apos; THEN 1 ELSE NULL END' />
      </column>
      <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column caption='Avg Pay Difference - Pay Less' datatype='real' default-format='p0.0%' name='[Pay Difference (copy)_5196239233416822795]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_paid] - (IF [Calculation_3475371594245640197] = &apos;Less&apos; THEN [latest_mobile_estimation] END)&#10;&#10;)/SUM([total_paid])' />
