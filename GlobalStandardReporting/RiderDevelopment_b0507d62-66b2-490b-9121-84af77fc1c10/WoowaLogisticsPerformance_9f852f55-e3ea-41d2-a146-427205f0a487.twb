      <column caption='AOV (Local)' datatype='real' default-format='n#,##0;-#,##0' name='[GMV (Local) (copy)_5142336760020783128]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([aov_local_n]) / SUM([aov_d])' />
      </column>
      <column caption='Rider Reaction Time (mins)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Holdback Duration (mins) (copy)_5142336760052908075]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([rider_reaction_duration_n] / 60) / SUM([rider_reaction_duration_d])' />
      </column>
      <column caption='Post-Checkout PDT (mins)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[PDT (mins) (copy)_5142336760014483460]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([post_checkout_pdt_n] / 60) / SUM([post_checkount_pdt_d])' />
