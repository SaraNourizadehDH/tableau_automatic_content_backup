            <column caption='% Reassignment Rate' datatype='real' default-format='p0.0%' name='[Calculation_5142336760024113187]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([reassignment_n]) / SUM([reassignment_d])' />
