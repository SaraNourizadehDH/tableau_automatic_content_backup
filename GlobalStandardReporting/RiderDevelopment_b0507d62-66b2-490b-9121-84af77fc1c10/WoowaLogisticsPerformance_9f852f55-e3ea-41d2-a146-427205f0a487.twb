      <column caption='CPO / AOV' datatype='real' default-format='p0.0%' name='[Calculation_5142336760022470685]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[CPO (EUR) (copy)_5142336760021303324] / [GMV (Local) (copy)_5142336760020783128]' />
      </column>
