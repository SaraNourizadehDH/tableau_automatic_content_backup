        <calculation class='tableau' formula='SUM([acceptance_n]) / SUM([acceptance_d])' />
      </column>
      <column caption='% Reassignment Rate' datatype='real' default-format='p0.0%' name='[Calculation_5142336760024113187]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([reassignment_n]) / SUM([reassignment_d])' />
      </column>
      <column caption='CPO / DT' datatype='real' name='[Calculation_5142336760036212774]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[CPO (EUR) (copy)_5142336760021303324] / [Calculation_5142336760013824001]' />
      </column>
      <column caption='Rider DT (excl. To Vendor)' datatype='real' name='[Calculation_5142336760036536359]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// as to vendor isn&apos;t paid&#10;SUM([courier_delivery_time_n]) / SUM([completed_deliveries])' />
      </column>
