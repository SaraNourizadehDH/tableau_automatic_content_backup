                <zone h='5714' id='15' mode='checkdropdown' name='CPO vs Effort' param='[federated.0l037sx0pk3s8211r1w491e2h8lt].[none:distance_bucket_500m:nk]' show-apply='true' type-v2='filter' w='12000' x='87429' y='6643'>
                  <zone-style>
