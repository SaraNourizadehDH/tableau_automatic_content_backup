      <column caption='Report Quarter' datatype='string' name='[Report Month (copy)_4752634663910195203]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT(STR(DATETRUNC(&apos;quarter&apos;, [report_date])), 7) // to format as 2025-01, 2025-02 etc.' />
      </column>
      <column caption='Region Grouping' datatype='string' name='[Rgn1 Name (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[rgn1_name]' default='&quot;Regional Cities&quot;' new-bin='true'>
          <bin default-name='false' value='&quot;Gyeonggi&quot;'>
            <value>&quot;Gyeonggi-do&quot;</value>
          </bin>
          <bin default-name='true' value='&quot;Seoul&quot;'>
            <value>&quot;Seoul&quot;</value>
          </bin>
        </calculation>
      </column>
      <column caption='Vendor Late (mins)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Rider Late (mins) (copy)_5330362047241904132]' role='measure' type='quantitative'>
