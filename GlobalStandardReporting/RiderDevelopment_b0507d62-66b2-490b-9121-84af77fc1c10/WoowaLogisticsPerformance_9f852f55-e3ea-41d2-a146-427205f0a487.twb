                <zone h='5714' id='14' mode='checkdropdown' name='Daily' param='[federated.0l037sx0pk3s8211r1w491e2h8lt].[none:rgn2_name:nk]' show-apply='true' type-v2='filter' w='12000' x='75429' y='6643'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
