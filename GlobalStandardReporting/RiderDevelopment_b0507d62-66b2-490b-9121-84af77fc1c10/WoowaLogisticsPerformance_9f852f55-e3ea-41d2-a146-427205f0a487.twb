      <column caption='% Bicycles' datatype='real' default-format='p0.0%' name='[Calculation_5142336760054612014]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([bicycle_acceptance_n]) / SUM([acceptance_n])' />
