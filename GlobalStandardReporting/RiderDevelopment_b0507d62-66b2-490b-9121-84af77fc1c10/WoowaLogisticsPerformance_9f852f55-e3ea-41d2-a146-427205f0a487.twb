          <datasource-dependencies datasource='federated.0l037sx0pk3s8211r1w491e2h8lt'>
            <column caption='% CDT &gt; 60' datatype='real' default-format='p0.0%' name='[% CDT &gt; 45 (copy)_4752634663902572545]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cdt_gt60_n]) / SUM([actual_dt_d])' />
            </column>
            <column caption='% CDT &gt; 45' datatype='real' default-format='p0.0%' name='[% DT &gt; 45 (copy)_4752634663902420992]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cdt_gt45_n]) / SUM([actual_dt_d])' />
            </column>
            <column caption='% DT &gt; 45' datatype='real' default-format='p0.0%' name='[% DT &gt; 60 (copy)_5142336760016879628]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dt_gt45_n]) / SUM([actual_dt_d])' />
            </column>
            <column caption='% DT &gt; EDT Max' datatype='real' default-format='p0.0%' name='[% Damage Rate (copy)_5330362047242567686]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([woowa_dt_gt_edt_max_n]) / SUM([orders_completed])' />
            </column>
            <column caption='% Orders Late &gt; 10' datatype='real' default-format='p0.0%' name='[% Fail Rate (copy)_5142336760017547279]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([late_10_n]) / SUM([orders_completed])' />
            </column>
            <column caption='% On Time' datatype='real' default-format='p0.0%' name='[% Orders Late &gt; 10 (copy)_5142336760017666064]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([on_time_n]) / SUM([orders_completed])' />
            </column>
            <column caption='% Orders Early &lt; 10' datatype='real' default-format='p0.0%' name='[% Orders Late &gt; 10 (copy)_5142336760052371498]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([early_10_n]) / SUM([orders_completed])' />
            </column>
            <column caption='Rider Late (mins)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[% Rider Late (copy)_5330362046953975809]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_late_duration_n] / 60)&#10;/&#10;SUM([rider_late_d])' />
            </column>
            <column caption='% Rider Late &gt; 10' datatype='real' default-format='p0.0%' name='[% Rider Late (copy)_5330362047241457666]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_late_gt60_n])&#10;/&#10;SUM([rider_late_d])' />
            </column>
            <column caption='% Vendor Late' datatype='real' default-format='p0.0%' name='[% Rider Late (copy)_5330362047241785347]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_n])&#10;/&#10;SUM([vendor_late_d])' />
            </column>
            <column caption='% Vendor Late &gt; 10' datatype='real' default-format='p0.0%' name='[% Rider Late &gt; 10 (copy)_5330362047242022917]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_gt60_n])&#10;/&#10;SUM([vendor_late_d])' />
            </column>
            <column caption='% Bundles' datatype='real' default-format='p0.0%' name='[% Stacked Bundles (copy)_4752634663911796740]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([stacked_bundle_deliveries]) / SUM([completed_deliveries])' />
            </column>
            <column caption='% Intravendor Stacked' datatype='real' default-format='p0.0%' name='[% Stacked Deliveries (copy)_5142336760018984980]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([intravendor_stacked_deliveries]) / SUM([completed_deliveries])' />
            </column>
            <column caption='% Stacked Bundles' datatype='real' default-format='p0.0%' name='[% Stacked Deliveries (copy)_5142336760058941491]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([stacked_bundle_deliveries]) / SUM([stacked_deliveries])' />
            </column>
            <column caption='CPO (EUR)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[AOV (EUR) (copy)_5142336760021188635]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cpo_eur_n]) / SUM([orders_completed])' />
            </column>
            <column caption='At Vendor Cleaned (mins)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[At Vendor (mins) (copy)_5142336760015585286]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([at_vendor_cleaned_n] / 60) / SUM([at_vendor_cleaned_d])' />
            </column>
            <column caption='To Customer (mins)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[At Vendor (mins) (copy)_5142336760015745031]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([to_customer_n] / 60) / SUM([to_customer_d])' />
            </column>
            <column caption='At Customer (mins)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[At Vendor (mins) (copy)_5142336760015843336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([at_customer_n] / 60) / SUM([at_customer_d])' />
            </column>
            <column caption='EPT [vendor confirmed] (mins)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[At Vendor (mins) (copy)_5142336760015958025]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ept_minutes_n]) / SUM([ept_minutes_d])' />
            </column>
            <column caption='To Vendor (mins)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[At Vendor (mins) (copy)_5142336760017883153]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([to_vendor_n] / 60) / SUM([to_vendor_d])' />
            </column>
            <column caption='CPO (Local)' datatype='real' default-format='n#,##0;-#,##0' name='[CPO (EUR) (copy)_5142336760021303324]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cpo_local_n]) / SUM([orders_completed])' />
            </column>
            <column caption='PD Straightline (m)' datatype='real' name='[Calculation_2586684717834211330]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([straightline_distance_m_n]) / SUM([straightline_distance_m_d])' />
            </column>
            <column caption='Report Month' datatype='string' name='[Calculation_4752634663909748738]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(STR(DATETRUNC(&apos;month&apos;, [report_date])), 7) // to format as 2025-01, 2025-02 etc.' />
            </column>
            <column caption='% Food Orders' datatype='real' default-format='p0.0%' name='[Calculation_4752634663912435717]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [vertical_parent] = &apos;Food&apos; THEN [orders_created] ELSE 0 END)&#10;/&#10;SUM([orders_created])' />
            </column>
            <column caption='Time Period' datatype='string' name='[Calculation_4752634663913340934]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Day&apos; THEN STR([report_date])&#10;    WHEN &apos;Week&apos; THEN [report_week]&#10;    WHEN &apos;Month&apos; THEN [Calculation_4752634663909748738]&#10;    WHEN &apos;Quarter&apos; THEN [Report Month (copy)_4752634663910195203]&#10;END' />
            </column>
            <column caption='Region' datatype='string' name='[Calculation_4752634663949672456]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &apos;RGN GRP&apos; THEN [Rgn1 Name (group)]&#10;    WHEN &apos;RGN1&apos; THEN [rgn1_name]&#10;    WHEN &apos;RGN2&apos; THEN [rgn2_name]&#10;END' />
            </column>
            <column caption='Dimension A' datatype='string' name='[Calculation_4752634663950426122]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN &apos;Time&apos; THEN [Calculation_4752634663913340934]&#10;    WHEN &apos;Geography&apos; THEN [Calculation_4752634663949672456]&#10;    WHEN &apos;Vertical&apos; THEN [vertical_parent]&#10;    WHEN &apos;Distance Bucket&apos; THEN [distance_bucket_500m]&#10;    WHEN &apos;Is NSTOD&apos; THEN STR([Calculation_5956503130462507008])&#10;    WHEN &apos;Is Preorder&apos; THEN STR([is_preorder])&#10;END' />
            </column>
            <column caption='Show Metrics as Columns?' datatype='boolean' name='[Calculation_4752634663956111375]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 4]' />
            </column>
            <column caption='% Fail Rate' datatype='real' default-format='p0.0%' name='[Calculation_5142336760013668352]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_cancelled]) / SUM([orders_created])' />
            </column>
            <column caption='DT (mins)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_5142336760013824001]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([actual_dt_n] / 60) / SUM([actual_dt_d])' />
            </column>
            <column caption='Customer DT (mins)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_5142336760013971458]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([customer_facing_dt_n] / 60) / SUM([customer_facing_dt_d])' />
            </column>
            <column caption='PDT (mins)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_5142336760014381059]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pdt_n] / 60) / SUM([pdt_d])' />
            </column>
            <column caption='At Vendor (mins)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_5142336760015380485]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([at_vendor_n] / 60) / SUM([at_vendor_d])' />
            </column>
            <column caption='PDT pre/post Checkout ∆' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_5142336760016203786]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5142336760014381059] - [PDT (mins) (copy)_5142336760014483460]' />
            </column>
            <column caption='% DT &gt; 60' datatype='real' default-format='p0.0%' name='[Calculation_5142336760016629771]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dt_gt60_n]) / SUM([actual_dt_d])' />
