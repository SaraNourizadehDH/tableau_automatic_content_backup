    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Monthly-Weekly View'>
      <repository-location id='Monthly-WeeklyView' path='/t/GlobalStandardReporting/workbooks/WoowaLogisticsPerformance' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='1400' maxwidth='1600' minheight='1400' minwidth='1600' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='woowa_logistics_dashboard (rl)' name='federated.0l037sx0pk3s8211r1w491e2h8lt' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Choose Time Dimension' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
          <calculation class='tableau' formula='&quot;Week&quot;' />
          <members>
            <member value='&quot;Day&quot;' />
            <member value='&quot;Week&quot;' />
            <member value='&quot;Month&quot;' />
            <member value='&quot;Quarter&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.0l037sx0pk3s8211r1w491e2h8lt'>
        <column caption='Distance Bucket 500M' datatype='string' name='[distance_bucket_500m]' role='dimension' type='nominal' />
        <column caption='Is Preorder' datatype='boolean' name='[is_preorder]' role='dimension' type='nominal' />
        <column caption='Is Stod' datatype='boolean' name='[is_stod]' role='dimension' type='nominal' />
        <column-instance column='[distance_bucket_500m]' derivation='None' name='[none:distance_bucket_500m:nk]' pivot='key' type='nominal' />
        <column-instance column='[is_preorder]' derivation='None' name='[none:is_preorder:nk]' pivot='key' type='nominal' />
        <column-instance column='[is_stod]' derivation='None' name='[none:is_stod:nk]' pivot='key' type='nominal' />
        <column-instance column='[report_date]' derivation='None' name='[none:report_date:qk]' pivot='key' type='quantitative' />
        <column-instance column='[rgn1_name]' derivation='None' name='[none:rgn1_name:nk]' pivot='key' type='nominal' />
        <column-instance column='[rgn2_korean]' derivation='None' name='[none:rgn2_korean:nk]' pivot='key' type='nominal' />
        <column-instance column='[rgn2_name]' derivation='None' name='[none:rgn2_name:nk]' pivot='key' type='nominal' />
        <column-instance column='[vertical_parent]' derivation='None' name='[none:vertical_parent:nk]' pivot='key' type='nominal' />
        <column caption='Report Date' datatype='date' name='[report_date]' role='dimension' type='ordinal' />
        <column caption='Rgn1 Name' datatype='string' name='[rgn1_name]' role='dimension' type='nominal' />
        <column caption='Rgn2 Korean' datatype='string' name='[rgn2_korean]' role='dimension' type='nominal' />
        <column caption='Rgn2 Name' datatype='string' name='[rgn2_name]' role='dimension' type='nominal' />
        <column caption='Vertical Parent' datatype='string' name='[vertical_parent]' role='dimension' type='nominal' />
      </datasource-dependencies>
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='88858' id='7' param='horz' type-v2='layout-flow' w='99000' x='500' y='10571'>
            <zone h='88858' id='5' type-v2='layout-basic' w='99000' x='500' y='10571'>
              <zone h='73572' id='3' name='Daily' w='99000' x='500' y='25857'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='15286' id='18' type-v2='text' w='99000' x='500' y='10571'>
                <formatted-text>
                  <run fontcolor='#e15759' fontname='Tableau Medium' fontsize='10'>** Data validation is in progress, and some known issues/limitations are listed below. **</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontname='Tableau Medium' fontsize='10'>- </run>
                  <run fontsize='10'>Woowa </run>
                  <run fontname='Tableau Semibold' fontsize='10' italic='true'>OD orders</run>
                  <run fontsize='10'> from 15-Jan-2025 are available in this dashboard, but </run>
                  <run fontcolor='#e15759' fontsize='10'>currently most B-Mart orders appear to be missing from the automation source</run>
                  <run fontsize='10'>.</run>
                  <run>Æ&#10;</run>
                  <run fontname='Tableau Medium' fontsize='10'>- </run>
                  <run fontname='Tableau Semibold' fontsize='10' italic='true'>GMV, AOV, DF</run>
                  <run fontname='Tableau Medium' fontsize='10'>Æ </run>
                  <run fontsize='10'>are sourced from Coredata Business tables in Datahub</run>
                  <run fontname='Tableau Medium' fontsize='10'>.</run>
                  <run>Æ&#10;</run>
                  <run fontname='Tableau Medium' fontsize='10'>- </run>
                  <run fontname='Tableau Semibold' fontsize='10' italic='true'>UTR</run>
                  <run fontsize='10' italic='true'>Æ </run>
                  <run fontsize='10'>isn&apos;t directly comparable at a city level with DH because riders can work across cities, and their activity isn&apos;t linked to a city in the underlying data. UTR is calculated by distributing riders&apos; total hours worked in the day based on the proportion of deliveries made by them in each city on the same day. </run>
                  <run fontcolor='#e15759' fontsize='10' italic='true'>UTR can only be broken down by RGN, not by STOD, Distances, or Vertical</run>
                  <run fontsize='10' italic='true'>.</run>
                  <run>Æ&#10;</run>
                  <run fontname='Tableau Medium' fontsize='10'>- </run>
                  <run fontname='Tableau Semibold' fontsize='10' italic='true'>To Vendor Time</run>
                  <run fontname='Tableau Medium' fontsize='10'>Æ </run>
                  <run fontsize='10'>is not comparable to DH, given that riders can accept next delivery while ongoing deliveries are in progress. Consequently, </run>
                  <run fontname='Tableau Semibold' fontsize='10' italic='true'>Rider DT</run>
                  <run fontname='Tableau Medium' fontsize='10' italic='true'>Æ </run>
                  <run fontsize='10'>excludes </run>
                  <run fontname='Tableau Medium' fontsize='10' italic='true'>To Vendor Time</run>
                  <run fontname='Tableau Medium' fontsize='10'>.</run>
                  <run>Æ&#10;</run>
                  <run fontname='Tableau Medium' fontsize='10'>- </run>
                  <run fontname='Tableau Semibold' fontsize='10' italic='true'>CPO [Bonus]</run>
                  <run fontname='Tableau Medium' fontsize='10'>Æ </run>
                  <run fontsize='10'>includes promotions (equivalent to DH&apos;s quest payments).</run>
                  <run>Æ&#10;</run>
                  <run fontname='Tableau Medium' fontsize='10'>- </run>
                  <run fontname='Tableau Semibold' fontsize='10' italic='true'>Damage Rate, CDT &gt; 60, CDT &gt; 45</run>
                  <run fontname='Tableau Medium' fontsize='10'>Æ </run>
                  <run fontsize='10'>are based on Customer Delivery Time i.e. inclusive of </run>
                  <run fontname='Tableau Semibold' fontsize='10' italic='true'>At Customer TIme</run>
                  <run fontsize='10'>.</run>
                  <run>Æ&#10;</run>
                  <run fontname='Tableau Medium' fontsize='10'>- </run>
                  <run fontname='Tableau Semibold' fontsize='10' italic='true'>PDT</run>
                  <run fontname='Tableau Medium' fontsize='10'>Æ </run>
                  <run fontsize='10'>isn&apos;t generated by Woowa as a single value, it&apos;s always a range. Therefore, the PDT metric in this report is derived as the midpoint of the range.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='dotted' />
                  <format attr='border-width' value='1' />
                  <format attr='margin' value='0' />
