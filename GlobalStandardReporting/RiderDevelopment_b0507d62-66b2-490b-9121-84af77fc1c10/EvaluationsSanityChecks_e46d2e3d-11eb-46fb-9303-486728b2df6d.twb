      <aliases enabled='yes' />
      <column caption='% Error Working' datatype='real' default-format='p0.0%' name='[Calculation_1104226346610688000]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ABS(SUM([rooster_working_hours])-SUM([hurrier_working_hours]))/SUM([hurrier_working_hours])' />
      </column>
      <column caption='% Error Breaks ' datatype='real' default-format='p0.0%' name='[Calculation_1104226346615365634]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ABS(SUM([rooster_break_hours])-SUM([hurrier_break_hours]))/SUM([hurrier_break_hours])' />
      </column>
      <column caption='exclude current date' datatype='integer' name='[Calculation_1104226346616348676]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [working_day] &lt; DATETRUNC(&apos;day&apos;, TODAY()) then 1 else 0 END' />
      </column>
      <column aggregation='Sum' caption='Last 50 days' datatype='integer' name='[Calculation_662310639488753665]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [working_day] &lt; DATETRUNC(&apos;day&apos;, TODAY()-50) then 1 else 0 END' />
      </column>
      <column caption='Week' datatype='datetime' name='[Calculation_662310639489282050]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;, [working_day])' />
      </column>
      <column aggregation='Sum' caption='Report Week ' datatype='integer' name='[Calculation_662310639492841475]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEPART(&apos;week&apos;, [working_day])' />
      </column>
      <column aggregation='Sum' caption='Report Month' datatype='integer' name='[Calculation_662310639493337092]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEPART(&apos;month&apos;, [working_day])' />
      </column>
      <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
        <calculation class='tableau' formula='1' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Migrated Data' datatype='table' name='[__tableau_internal_object_id__].[Migrated Data]' role='measure' type='quantitative' />
      <column caption='Break Hours Diff' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[break_hours_diff]' role='measure' type='quantitative' />
      <column caption='Break Seconds Diff' datatype='real' name='[break_seconds_diff]' role='measure' type='quantitative' />
