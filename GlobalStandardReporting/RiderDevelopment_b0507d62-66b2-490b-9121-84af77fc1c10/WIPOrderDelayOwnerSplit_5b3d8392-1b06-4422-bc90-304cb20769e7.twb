    <worksheet name='Overall Delay Coutries (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Delay Split by Category - &lt;</run>
            <run>[federated.1v7qu6d0lilr261d5iimc0hhzj40].[country_name]</run>
            <run>&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (cl)' name='federated.1v7qu6d0lilr261d5iimc0hhzj40' />
          </datasources>
          <datasource-dependencies datasource='federated.1v7qu6d0lilr261d5iimc0hhzj40'>
            <column caption='%Orders' datatype='real' name='[Calculation_1741837549922840576]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([number_of_orders])/SUM({ FIXED : SUM([number_of_orders])})' />
            </column>
            <column caption='Rider Delay' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_4404590815753924609]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_delay])/SUM([number_of_orders])' />
            </column>
            <column caption='Owner' datatype='string' name='[Calculation_4484388971958673408]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF RIGHT([category],5) = &apos;Rider&apos; THEN &apos;Rider&apos;&#10;ELSEIF RIGHT([category],5) = &apos;endor&apos; THEN &apos;Vendor&apos;&#10;ELSEIF [category] IN (&apos;Case 4&apos;,&apos;Case 9&apos;) THEN &apos;Split&apos;&#10;ELSEIF [category] IN (&apos;Case 11&apos;,&apos;Case 13&apos;,&apos;Case 14&apos;,&apos;Case 17&apos;, &apos;Case 18&apos;) THEN &apos;Undefined&apos;&#10;END' />
            </column>
            <column caption='Split Delay' datatype='real' name='[Calculation_6689956533837418498]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([split_delay])/SUM([number_of_orders])' />
            </column>
            <column caption='Undefined Delay' datatype='real' name='[Calculation_6689956533837484035]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([undefined_responsibility])/SUM([number_of_orders])' />
            </column>
            <column caption='Vendor Delay' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Rider Late (copy)_4404590815754043394]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_delay])/SUM([number_of_orders])' />
            </column>
            <column caption='Case' datatype='string' name='[category]' role='dimension' type='nominal' />
