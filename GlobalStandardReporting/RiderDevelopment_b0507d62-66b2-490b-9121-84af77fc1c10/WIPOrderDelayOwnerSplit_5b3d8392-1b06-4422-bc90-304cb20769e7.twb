      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_E672BAC4274540DC8F3661DE2FAB5F67'>
            <properties context=''>
              <relation connection='bigquery.0tjx88z0jetyks18v80jj01kavpl' name='Custom SQL Query' type='text'>WITH cities AS (
  SELECT co.region
    , co.country_code
    , co.country_name
   , ci.id AS city_id
   , ci.name AS city_name
   , ci.timezone
   , ci.zones
  FROM `fulfillment-dwh-production.cl.countries` co
  LEFT JOIN UNNEST (co.cities) ci
), zones AS (
 SELECT country_code
   , country_name
   , ci.city_id
    , zo.id AS zone_id
    , zo.name AS zone_name
  FROM cities ci
  LEFT JOIN UNNEST(ci.zones) zo
  )
SELECT ci.country_name
  , ci.city_name
  , zo.zone_name
  , created_date
  , category
  , status
  , SUM(IF(RIGHT(s.category, 5) = &apos;Rider&apos;, rider_late_full, NULL))/60 AS rider_delay
  , SUM(IF(RIGHT(s.category, 5) = &apos;endor&apos;, vendor_late_full, NULL))/60 AS vendor_delay
  , SUM(IF(s.category IN (&apos;Case 4&apos;, &apos;Case 9&apos;), COALESCE(s.rider_late_split, s.rider_late_full) + COALESCE(s.vendor_late_split, s.vendor_late_full), NULL))/60 AS split_delay
  , SUM(IF(s.category IN (&apos;Case 11&apos;, &apos;Case 13&apos;, &apos;Case 14&apos;, &apos;Case 17&apos;, &apos;Case 18&apos;), undefined_reponsibility, NULL))/60 AS undefined_responsibility
  , COUNT(DISTINCT s.platform_order_code) number_of_orders
FROM `logistics-data-storage-staging.sandbox_shiva.order_delay_owner_split_new` s
LEFT JOIN cities ci ON s.country_code = ci.country_code
  AND s.city_id = ci.city_id
LEFT JOIN zones zo ON s.country_code = zo.country_code
  AND s.zone_id = zo.zone_id
AND s.city_id = zo.city_id
GROUP BY 1, 2, 3, 4, 5, 6
ORDER BY 1, 2, 3 ,4, 5, 6</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
