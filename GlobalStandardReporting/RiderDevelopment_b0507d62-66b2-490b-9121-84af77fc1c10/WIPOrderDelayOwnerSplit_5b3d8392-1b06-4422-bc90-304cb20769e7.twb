      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (cl)' name='federated.1v7qu6d0lilr261d5iimc0hhzj40' />
          </datasources>
          <datasource-dependencies datasource='federated.1v7qu6d0lilr261d5iimc0hhzj40'>
            <column caption='Rider Delay - % orders ' datatype='real' default-format='p0.0%' name='[%Orders (copy)_1741837549925023745]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([Calculation_4484388971958673408] = &apos;Rider&apos;,[number_of_orders],NULL))/SUM({ FIXED : SUM([number_of_orders])})' />
            </column>
            <column caption='([Rider Delay])' datatype='real' name='[Calculation_130463676635992065]' role='measure' type='quantitative' user:unnamed='Rider'>
              <calculation class='tableau' formula='([Calculation_4404590815753924609])' />
            </column>
            <column caption='Rider Delay' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_4404590815753924609]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_delay])/SUM([number_of_orders])' />
            </column>
            <column caption='Owner' datatype='string' name='[Calculation_4484388971958673408]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF RIGHT([category],5) = &apos;Rider&apos; THEN &apos;Rider&apos;&#10;ELSEIF RIGHT([category],5) = &apos;endor&apos; THEN &apos;Vendor&apos;&#10;ELSEIF [category] IN (&apos;Case 4&apos;,&apos;Case 9&apos;) THEN &apos;Split&apos;&#10;ELSEIF [category] IN (&apos;Case 11&apos;,&apos;Case 13&apos;,&apos;Case 14&apos;,&apos;Case 17&apos;, &apos;Case 18&apos;) THEN &apos;Undefined&apos;&#10;END' />
            </column>
            <column caption='Vendor Delay - % orders ' datatype='real' default-format='p0.0%' name='[Rider Delay - % orders  (copy)_1741837549925433346]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([Calculation_4484388971958673408] = &apos;Vendor&apos;,[number_of_orders],NULL))/SUM({ FIXED : SUM([number_of_orders])})' />
            </column>
            <column caption='Undefined Delay - % orders' datatype='real' default-format='p0.0%' name='[Split Delay - % orders (copy)_1741837549925568516]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([Calculation_4484388971958673408] = &apos;Undefined&apos;,[number_of_orders],NULL))/SUM({ FIXED : SUM([number_of_orders])})' />
            </column>
            <column caption='Split Delay - % orders' datatype='real' default-format='p0.0%' name='[Vendor Delay - % orders  (copy)_1741837549925490691]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([Calculation_4484388971958673408] = &apos;Split&apos;,[number_of_orders],NULL))/SUM({ FIXED : SUM([number_of_orders])})' />
            </column>
            <column caption='Case' datatype='string' name='[category]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
