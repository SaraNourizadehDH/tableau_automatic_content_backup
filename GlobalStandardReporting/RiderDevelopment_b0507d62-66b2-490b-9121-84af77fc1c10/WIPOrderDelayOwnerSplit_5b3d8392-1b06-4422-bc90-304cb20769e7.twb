          <named-connection caption='BigQuery' name='bigquery.0tjx88z0jetyks18v80jj01kavpl'>
            <connection CATALOG='logistics-data-storage-staging' EXECCATALOG='logistics-rider-staging' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='logistics-data-storage-staging' schema='' server-oauth='' username='shiva.arora@deliveryhero.com' workgroup-auth-mode='prompt' />
          </named-connection>
