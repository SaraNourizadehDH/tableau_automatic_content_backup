            <column caption='Orders' datatype='integer' name='[number_of_orders]' role='measure' type='quantitative' />
            <column datatype='real' name='[split_delay]' role='measure' type='quantitative' />
            <column datatype='string' name='[status]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_130463676678696977]' derivation='User' name='[usr:Calculation_130463676678696977:qk]' pivot='key' type='quantitative' />
