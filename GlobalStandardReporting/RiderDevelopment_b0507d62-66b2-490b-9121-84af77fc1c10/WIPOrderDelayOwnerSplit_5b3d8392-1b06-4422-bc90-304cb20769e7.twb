      <aliases enabled='yes' />
      <column caption='Rider Delay - % orders ' datatype='real' default-format='p0.0%' name='[%Orders (copy)_1741837549925023745]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([Calculation_4484388971958673408] = &apos;Rider&apos;,[number_of_orders],NULL))/SUM({ FIXED : SUM([number_of_orders])})' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1v7qu6d0lilr261d5iimc0hhzj40].[usr:Calculation_6689956533837864964:qk]&quot;' value='Rider Delay ' />
          <alias key='&quot;[federated.1v7qu6d0lilr261d5iimc0hhzj40].[usr:Calculation_6689956533837877253:qk]&quot;' value='Vendor Delay ' />
