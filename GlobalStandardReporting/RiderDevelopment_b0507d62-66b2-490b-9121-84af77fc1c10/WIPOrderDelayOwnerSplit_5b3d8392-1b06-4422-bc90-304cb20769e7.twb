          <datasource-dependencies datasource='federated.1v7qu6d0lilr261d5iimc0hhzj40'>
            <column caption='([Split Delay])' datatype='real' name='[Calculation_130463676678696977]' role='measure' type='quantitative' user:unnamed='Split Delay'>
              <calculation class='tableau' formula='([Calculation_6689956533837418498])' />
            </column>
            <column caption='Owner' datatype='string' name='[Calculation_4484388971958673408]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF RIGHT([category],5) = &apos;Rider&apos; THEN &apos;Rider&apos;&#10;ELSEIF RIGHT([category],5) = &apos;endor&apos; THEN &apos;Vendor&apos;&#10;ELSEIF [category] IN (&apos;Case 4&apos;,&apos;Case 9&apos;) THEN &apos;Split&apos;&#10;ELSEIF [category] IN (&apos;Case 11&apos;,&apos;Case 13&apos;,&apos;Case 14&apos;,&apos;Case 17&apos;, &apos;Case 18&apos;) THEN &apos;Undefined&apos;&#10;END' />
            </column>
            <column caption='Split Delay' datatype='real' name='[Calculation_6689956533837418498]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([split_delay])/SUM([number_of_orders])' />
            </column>
            <column caption='Split Delay - % orders' datatype='real' default-format='p0.0%' name='[Vendor Delay - % orders  (copy)_1741837549925490691]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([Calculation_4484388971958673408] = &apos;Split&apos;,[number_of_orders],NULL))/SUM({ FIXED : SUM([number_of_orders])})' />
            </column>
            <column caption='Case' datatype='string' name='[category]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Report Date' datatype='date' name='[created_date]' role='dimension' type='ordinal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
