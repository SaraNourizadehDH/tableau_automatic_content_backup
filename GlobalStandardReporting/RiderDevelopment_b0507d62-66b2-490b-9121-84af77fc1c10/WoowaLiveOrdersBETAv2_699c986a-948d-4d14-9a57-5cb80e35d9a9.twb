    <worksheet name='Mean Delay vs Saturation'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Medium' fontsize='12'><![CDATA[<[Parameters].[Parameter 4]> (X) vs <[Parameters].[Select X KPI (copy)_1677942755260178433]> (Y) | ]]></run>
            <run fontsize='10'>aggregations are simple averages of minute-level raw data</run>
            <run>Æ&#10;</run>
            <run fontsize='10'>Aggregate by 15-min or 1-hr intervals for meaningful Fail Rate data</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='woowa_live_saturation (rl)' name='federated.0md76xw0jqdpfv1h81apr0hs9n18' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose Interval' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;5 min&quot;'>
              <calculation class='tableau' formula='&quot;5 min&quot;' />
            </column>
            <column alias='DH' caption='Saturation Calculation' datatype='boolean' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
              <aliases>
                <alias key='false' value='Glovo' />
                <alias key='true' value='DH' />
              </aliases>
            </column>
            <column caption='Split by' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
              <calculation class='tableau' formula='&quot;Day&quot;' />
            </column>
            <column caption='Select X KPI' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Saturation Level&quot;'>
              <calculation class='tableau' formula='&quot;Saturation Level&quot;' />
            </column>
            <column alias='WoW (same day last week)' caption='Reference Period' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;WoW&quot;'>
              <calculation class='tableau' formula='&quot;WoW&quot;' />
              <aliases>
                <alias key='&quot;WoW&quot;' value='WoW (same day last week)' />
              </aliases>
            </column>
            <column caption='Select Y KPI' datatype='string' name='[Select X KPI (copy)_1677942755260178433]' param-domain-type='list' role='measure' type='nominal' value='&quot;Mean Delay&quot;'>
              <calculation class='tableau' formula='&quot;Mean Delay&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0md76xw0jqdpfv1h81apr0hs9n18'>
            <column caption='% Fail Rate (using Avg. Active Orders)' datatype='real' default-format='p0.0%' name='[Calculation_1677942755256836096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cancelled_orders]) / AVG([active_orders])' />
            </column>
            <column caption='5-min Interval' datatype='datetime' name='[Calculation_1733111848459563008]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETIME(INT(FLOAT([created_at])*288)/288)' />
            </column>
            <column caption='15-min Interval' datatype='datetime' name='[Calculation_1733111848479612929]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETIME(INT((FLOAT([created_at])-(14.999/60/24)) * (96 / 1)) / (96 / 1))' />
            </column>
            <column caption='Selected Interval' datatype='datetime' name='[Calculation_1733111848479821826]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;5 min&apos; THEN [Calculation_1733111848459563008]&#10;    WHEN &apos;15 min&apos; THEN  [Calculation_1733111848479612929]&#10;    WHEN &apos;1 hr&apos; THEN DATETRUNC(&apos;hour&apos;, [created_at])&#10;    ELSE [created_at]&#10;END' />
            </column>
            <column caption='Saturation Level' datatype='real' name='[Calculation_1901082041155289089]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]&#10;    THEN ROUND([active_orders] / [saturation_couriers_dh] * 100) // DH&#10;    ELSE ROUND([active_orders] / [saturation_couriers_glovo] * 100) // Glovo&#10;END' />
            </column>
            <column caption='Day' datatype='string' name='[Calculation_1901082041158840325]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATE([created_at]) = TODAY() THEN &apos;Today&apos;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;DoD&apos; AND DATE([created_at]) = TODAY()-1 THEN &apos;Yesterday&apos;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;WoW&apos; AND DATE([created_at]) = TODAY()-7 THEN &apos;Same Day Last Week&apos;&#10;END' />
            </column>
            <column caption='Split By Dimension' datatype='string' name='[Calculation_1901082041496805382]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Day&apos; THEN [Calculation_1901082041158840325]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;City&apos; THEN [city_code]&#10;END' />
            </column>
            <column caption='Selected X KPI' datatype='real' name='[Calculation_1901082041529577479]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;    WHEN &apos;Mean Delay&apos; THEN AVG([mean_delay])&#10;    WHEN &apos;Saturation Level&apos; THEN AVG([Calculation_1901082041155289089])&#10;    WHEN &apos;% Fail Rate&apos; THEN [Calculation_1677942755256836096]&#10;END' />
            </column>
            <column caption='Selected Y KPI' datatype='real' name='[Selected X KPI (copy)_1677942755260436482]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Select X KPI (copy)_1677942755260178433]&#10;    WHEN &apos;Mean Delay&apos; THEN AVG([mean_delay])&#10;    WHEN &apos;Saturation Level&apos; THEN AVG([Calculation_1901082041155289089])&#10;    WHEN &apos;% Fail Rate&apos; THEN [Calculation_1677942755256836096]&#10;END' />
            </column>
            <column caption='Active Orders' datatype='integer' name='[active_orders]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1901082041155289089]' derivation='Avg' name='[avg:Calculation_1901082041155289089:qk]' pivot='key' type='quantitative' />
            <column-instance column='[active_orders]' derivation='Avg' name='[avg:active_orders:qk]' pivot='key' type='quantitative' />
            <column-instance column='[mean_delay]' derivation='Avg' name='[avg:mean_delay:qk]' pivot='key' type='quantitative' />
            <column caption='Cancelled Orders' datatype='integer' name='[cancelled_orders]' role='measure' type='quantitative' />
            <column caption='City Code' datatype='string' name='[city_code]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Created At' datatype='datetime' name='[created_at]' role='dimension' type='ordinal' />
            <column-instance column='[created_at]' derivation='Hour' name='[hr:created_at:ok]' pivot='key' type='ordinal' />
            <column caption='Mean Delay' datatype='real' name='[mean_delay]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1733111848479821826]' derivation='None' name='[none:Calculation_1733111848479821826:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1901082041158840325]' derivation='None' name='[none:Calculation_1901082041158840325:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1901082041496805382]' derivation='None' name='[none:Calculation_1901082041496805382:nk]' pivot='key' type='nominal' />
            <column-instance column='[city_code]' derivation='None' name='[none:city_code:nk]' pivot='key' type='nominal' />
            <column-instance column='[created_at]' derivation='None' name='[none:created_at:qk]' pivot='key' type='quantitative' />
            <column caption='Saturation Couriers Dh' datatype='integer' name='[saturation_couriers_dh]' role='measure' type='quantitative' />
            <column caption='Saturation Couriers Glovo' datatype='integer' name='[saturation_couriers_glovo]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1677942755256836096]' derivation='User' name='[usr:Calculation_1677942755256836096:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1901082041529577479]' derivation='User' name='[usr:Calculation_1901082041529577479:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Selected X KPI (copy)_1677942755260436482]' derivation='User' name='[usr:Selected X KPI (copy)_1677942755260436482:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <slices>
            <column>[federated.0md76xw0jqdpfv1h81apr0hs9n18].[hr:created_at:ok]</column>
            <column>[federated.0md76xw0jqdpfv1h81apr0hs9n18].[none:created_at:qk]</column>
            <column>[federated.0md76xw0jqdpfv1h81apr0hs9n18].[none:Calculation_1901082041158840325:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='title' class='0' field='[federated.0md76xw0jqdpfv1h81apr0hs9n18].[usr:Calculation_1901082041529577479:qk]' scope='cols' value='' />
            <format attr='title' class='0' field='[federated.0md76xw0jqdpfv1h81apr0hs9n18].[usr:Selected X KPI (copy)_1677942755260436482:qk]' scope='rows' value='' />
          </style-rule>
          <style-rule element='cell'>
            <format attr='text-format' field='[federated.0md76xw0jqdpfv1h81apr0hs9n18].[avg:mean_delay:qk]' value='n#,##0;-#,##0' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Circle' />
            <encodings>
              <color column='[federated.0md76xw0jqdpfv1h81apr0hs9n18].[none:Calculation_1901082041496805382:nk]' />
