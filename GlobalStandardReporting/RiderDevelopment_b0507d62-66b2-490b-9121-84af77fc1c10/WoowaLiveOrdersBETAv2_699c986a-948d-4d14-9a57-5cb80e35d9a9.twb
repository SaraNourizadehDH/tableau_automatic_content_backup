              <calculation class='tableau' formula='&quot;WoW&quot;' />
              <aliases>
                <alias key='&quot;WoW&quot;' value='WoW (same day last week)' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1lfam451nld0vz11vz3fb0eq1n4f'>
            <column caption='% On Time Orders' datatype='real' default-format='p0.0%' name='[% Late Orders [DH]] (copy)_1088604520202919940]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(IF [is_order_delivered] AND NOT [is_preorder] AND ABS(([promised_delivery_time_seconds]/60) - ([delivery_time_dh_seconds]/60)) &lt; 10 THEN [order_id] END)&#10;/&#10;COUNT(IF [is_order_delivered] AND NOT [is_preorder] THEN [order_id] END)' />
            </column>
            <column caption='% Early Orders' datatype='real' default-format='p0.0%' name='[% On Time Orders [DH]] (copy)_1088604520203124741]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(IF [is_order_delivered] AND NOT [is_preorder] AND (([promised_delivery_time_seconds]/60) - ([delivery_time_dh_seconds]/60)) &gt; 10 THEN [order_id] END)&#10;/&#10;COUNT(IF [is_order_delivered] AND NOT [is_preorder] THEN [order_id] END)' />
            </column>
            <column caption='Basic CPO [EUR]' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Basic CPO [LC]] (copy)_1088604520273522702]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1297670063759290368])&#10;/&#10;SUM(IF NOT ISNULL([Calculation_1297670063759290368]) AND [is_order_delivered] THEN 1 ELSE 0 END)' />
            </column>
            <column caption='Pickup CPO [EUR]' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1062216197435273216]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pickup_payments_eur])&#10;/&#10;SUM(IF [Calculation_1297670063759290368] &gt; 0 AND [is_order_delivered] THEN 1 ELSE 0 END)' />
            </column>
            <column caption='Distance CPO [EUR]' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1062216197435801601]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([distance_payments_eur])&#10;/&#10;SUM(IF [Calculation_1297670063759290368] &gt; 0 AND [is_order_delivered] THEN 1 ELSE 0 END)' />
            </column>
            <column caption='Dropoff CPO {EUR]' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1062216197435936770]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dropoff_payments_eur])&#10;/&#10;SUM(IF [Calculation_1297670063759290368] &gt; 0 AND [is_order_delivered] THEN 1 ELSE 0 END)' />
            </column>
            <column caption='Pickup CPO [LC]' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1062216197436190723]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pickup_payments_local])&#10;/&#10;SUM(IF [Calculation_1297670063759421441] &gt; 0 AND [is_order_delivered] THEN 1 ELSE 0 END)' />
            </column>
            <column caption='Distance CPO [LC]' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1062216197436391428]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([distance_payments_local])&#10;/&#10;SUM(IF [Calculation_1297670063759421441] &gt; 0 AND [is_order_delivered] THEN 1 ELSE 0 END)' />
            </column>
            <column caption='Dropoff CPO [LC]' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1062216197436510213]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dropoff_payments_local])&#10;/&#10;SUM(IF [Calculation_1297670063759421441] &gt; 0 AND [is_order_delivered] THEN 1 ELSE 0 END)' />
            </column>
            <column caption='% Late Orders [DH]' datatype='real' default-format='p0.0%' name='[Calculation_1088604520201166851]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(IF [is_order_delivered] AND NOT [is_preorder] AND (([promised_delivery_time_seconds]/60) - ([delivery_time_dh_seconds]/60)) &lt; -10 THEN [order_id] END)&#10;/&#10;COUNT(IF [is_order_delivered] AND NOT [is_preorder] THEN [order_id] END)' />
            </column>
            <column caption='Is Today?' datatype='boolean' name='[Calculation_1088604520258093063]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [created_date] = TODAY()&#10;    THEN TRUE&#10;ELSEIF [Parameters].[Parameter 5] = &apos;DoD&apos; AND [created_date] = TODAY()-1 // DoD comparison&#10;    THEN FALSE&#10;ELSEIF [Parameters].[Parameter 5] = &apos;WoW&apos; AND [created_date] = TODAY()-7 // WoW comparison&#10;    THEN FALSE&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Period ∆' datatype='real' default-format='p0%' name='[Calculation_1088604520258805770]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF(COUNTD([order_id]) &gt; 0&#10;    , (ZN(COUNTD([order_id])) - LOOKUP(ZN(COUNTD(IF [Calculation_3685985238640177156] &lt;= [Calculation_3685985238636498945] THEN [order_id] END)), -1))&#10;        / ABS(LOOKUP(ZN(COUNTD(IF [Calculation_3685985238640177156] &lt;= [Calculation_3685985238636498945] THEN [order_id] END)), -1))&#10;    , NULL)'>
                <table-calc ordering-field='[federated.1lfam451nld0vz11vz3fb0eq1n4f].[Calculation_1088604520258093063]' ordering-type='Field' />
              </calculation>
            </column>
            <column caption='Basic CPO [LC]' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1088604520273330189]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1297670063759421441])&#10;/&#10;SUM(IF NOT ISNULL([Calculation_1297670063759421441]) AND [is_order_delivered] THEN 1 ELSE 0 END)' />
            </column>
            <column caption='Costs Basic EUR' datatype='real' name='[Calculation_1297670063759290368]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([distance_payments_eur]) + ZN([dropoff_payments_eur]) + ZN([pickup_payments_eur])' />
            </column>
            <column caption='Costs Basic Local Currency' datatype='real' name='[Calculation_1297670063759421441]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([distance_payments_local]) + ZN([dropoff_payments_local]) + ZN([pickup_payments_local])' />
            </column>
            <column caption='Today Most Recent Timestamp' datatype='integer' name='[Calculation_3685985238636498945]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED : MAX((DATEPART(&apos;hour&apos;, IF [created_date] = TODAY() THEN [order_created_at] END) * 60)&#10;            + DATEPART(&apos;minute&apos;, IF [created_date] = TODAY() THEN [order_created_at] END)) &#10;}' />
            </column>
            <column caption='Order Hour-Minute' datatype='integer' name='[Calculation_3685985238640177156]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(DATEPART(&apos;hour&apos;, [order_created_at]) * 60)&#10;+&#10;DATEPART(&apos;minute&apos;, [order_created_at])' />
            </column>
            <column caption='Order Created Hour' datatype='integer' name='[Calculation_4356036438536249344]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEPART(&apos;hour&apos;, IF [is_preorder] THEN IFNULL([order_accepted_at], [order_created_at]) ELSE [order_created_at] END)' />
            </column>
            <column caption='DT DH' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_445011985580785664]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_order_delivered] THEN [delivery_time_dh_seconds] END / 60)&#10;/&#10;COUNT(IF [is_order_delivered] THEN [delivery_time_dh_seconds] END)' />
            </column>
            <column caption='To Vendor Time' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_445011985581166594]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([to_vendor_seconds])/60) / COUNT([to_vendor_seconds])' />
            </column>
            <column caption='At Vendor Time' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_445011985581305859]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([at_vendor_seconds])/60) / COUNT([at_vendor_seconds])' />
            </column>
            <column caption='To Customer Time' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_445011985581420548]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([to_customer_seconds])/60) / COUNT([to_customer_seconds])' />
            </column>
            <column caption='At Customer Time' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_445011985581654021]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([at_customer_seconds])/60) / COUNT([at_customer_seconds])' />
            </column>
            <column caption='# Orders Created' datatype='integer' default-format='N' name='[Calculation_445011985581793286]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([order_id])' />
            </column>
            <column caption='# Orders Completed' datatype='integer' default-format='N' name='[Calculation_445011985581883399]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(IF [is_order_delivered] THEN [order_id] END)' />
            </column>
            <column caption='# Orders Cancelled' datatype='integer' default-format='N' name='[Calculation_445011985582686216]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(IF [is_order_cancelled] THEN [order_id] END)' />
            </column>
            <column caption='# Live Orders' datatype='integer' default-format='N' name='[Calculation_445011985583910921]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(IF [Calculation_445011985661673492] THEN [order_id] END)' />
            </column>
            <column caption='% Fail Rate' datatype='real' default-format='p0.0%' name='[Calculation_445011985586565131]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_445011985582686216] / [Calculation_445011985581793286]' />
            </column>
            <column caption='% DT DH &gt; 60' datatype='real' default-format='p0.0%' name='[Calculation_445011985623056397]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(IF [is_order_delivered] AND [delivery_time_dh_seconds] &gt; 3600 THEN [order_id] END)&#10;/&#10;COUNT([delivery_time_dh_seconds])' />
            </column>
            <column caption='Is Live' datatype='boolean' name='[Calculation_445011985661673492]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF (([is_preorder] AND NOT ISNULL([order_accepted_at])) OR NOT [is_preorder]) // exclude preorders if they&apos;re not yet activated&#10;    AND NOT [is_order_cancelled] AND NOT [is_order_delivered] // exclude all cancelled and delivered orders&#10;    THEN TRUE&#10;    ELSE FALSE&#10;END' />
            </column>
            <column caption='Avg. Rush X' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_4770649074898886656]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([multiplier_value]) / COUNT([multiplier_value])' />
            </column>
            <column caption='% Stacked' datatype='real' default-format='p0.0%' name='[Calculation_810155408848343040]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_stacked] THEN 1 ELSE 0 END) / [Calculation_445011985581883399]' />
            </column>
