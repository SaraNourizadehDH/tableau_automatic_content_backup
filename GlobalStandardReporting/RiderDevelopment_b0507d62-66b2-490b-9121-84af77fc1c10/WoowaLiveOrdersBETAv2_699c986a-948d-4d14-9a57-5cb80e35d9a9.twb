    <worksheet name='Today vs 7 Days Ago'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#e8c039' fontname='Tableau Medium' fontsize='12'>Today</run>
            <run bold='true' fontname='Tableau Medium' fontsize='12'> vs </run>
            <run bold='true' fontcolor='#65aaa3' fontname='Tableau Medium' fontsize='12'>&lt;[Parameters].[Parameter 5]&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
