    <worksheet name='Last Event At'>
      <table>
        <view>
          <datasources>
            <datasource caption='woowa_live_orders (rl)' name='federated.1lfam451nld0vz11vz3fb0eq1n4f' />
          </datasources>
          <datasource-dependencies datasource='federated.1lfam451nld0vz11vz3fb0eq1n4f'>
            <column caption='Order Created Hour' datatype='integer' name='[Calculation_4356036438536249344]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEPART(&apos;hour&apos;, IF [is_preorder] THEN IFNULL([order_accepted_at], [order_created_at]) ELSE [order_created_at] END)' />
            </column>
            <column caption='Last Event At' datatype='datetime' name='[Calculation_445011985591115788]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='MAX(MAX(MAX(MAX(MAX([order_created_at], [order_accepted_at])&#10;, [order_near_pickup_at])&#10;, [order_picked_up_at])&#10;, [order_near_dropoff_at])&#10;, [order_delivered_at])' />
            </column>
            <column caption='City Name' datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Created Date' datatype='date' name='[created_date]' role='dimension' type='ordinal' />
            <column caption='Is Preorder' datatype='boolean' name='[is_preorder]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_445011985591115788]' derivation='Max' name='[max:Calculation_445011985591115788:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_4356036438536249344]' derivation='None' name='[none:Calculation_4356036438536249344:ok]' pivot='key' type='ordinal' />
            <column-instance column='[city_name]' derivation='None' name='[none:city_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[created_date]' derivation='None' name='[none:created_date:qk]' pivot='key' type='quantitative' />
            <column caption='Order Accepted At' datatype='datetime' name='[order_accepted_at]' role='dimension' type='ordinal' />
            <column caption='Order Created At' datatype='datetime' name='[order_created_at]' role='dimension' type='ordinal' />
            <column caption='Order Delivered At' datatype='datetime' name='[order_delivered_at]' role='dimension' type='ordinal' />
            <column caption='Order Near Dropoff At' datatype='datetime' name='[order_near_dropoff_at]' role='dimension' type='ordinal' />
            <column caption='Order Near Pickup At' datatype='datetime' name='[order_near_pickup_at]' role='dimension' type='ordinal' />
            <column caption='Order Picked Up At' datatype='datetime' name='[order_picked_up_at]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <filter class='relative-date' column='[federated.1lfam451nld0vz11vz3fb0eq1n4f].[none:created_date:qk]' context='true' filter-group='4' first-period='0' include-future='true' include-null='false' last-period='0' period-type-v2='day' />
          <slices>
            <column>[federated.1lfam451nld0vz11vz3fb0eq1n4f].[none:created_date:qk]</column>
            <column>[federated.1lfam451nld0vz11vz3fb0eq1n4f].[none:city_name:nk]</column>
            <column>[federated.1lfam451nld0vz11vz3fb0eq1n4f].[none:Calculation_4356036438536249344:ok]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <text column='[federated.1lfam451nld0vz11vz3fb0eq1n4f].[max:Calculation_445011985591115788:ok]' />
            </encodings>
            <customized-label>
              <formatted-text>
                <run fontalignment='0' fontsize='8'>- Data updates every </run>
                <run bold='true' fontalignment='0' fontcolor='#e15759' fontsize='8'>15</run>
                <run fontalignment='0' fontsize='8'> minutes</run>
                <run fontalignment='0'>Æ&#10;</run>
                <run fontalignment='0' fontsize='8'>- &quot;Live&quot; Orders calculated as those not cancelled and not yet delivered as-of query execution time</run>
                <run fontalignment='0'>Æ&#10;</run>
                <run fontalignment='0' fontsize='8'>- A few orders might have &quot;Null&quot; City Code due to sync issues between various streams</run>
                <run fontalignment='0'>Æ&#10;</run>
                <run fontalignment='0' fontsize='8'>- </run>
                <run fontalignment='0' fontsize='8' italic='true'>DT DH, DT Glovo, % DT DH &gt;60, % Late Orders, % On Time, % Early Orders, To Cancel Time</run>
                <run fontalignment='0' fontsize='8'> exclude preorders</run>
                <run fontalignment='0'>Æ&#10;</run>
                <run fontalignment='0' fontsize='8'>- CPO only includes basic costs i.e. excluding quests, scoring, hourly, and special payments</run>
                <run fontalignment='0'>Æ&#10;</run>
                <run fontalignment='0' fontsize='8'>- Avg. Rush X: </run>
                <run fontalignment='0' fontcolor='#1d1c1d' fontsize='8'>this may not reflect rooster settings as actual rush multipliers are only available for completed deliveries, and may have been accepted in a different time window</run>
                <run fontalignment='0'>Æ&#10;</run>
                <run bold='true' fontalignment='0' fontsize='8'><![CDATA[- Last Event: <[federated.1lfam451nld0vz11vz3fb0eq1n4f].[max:Calculation_445011985591115788:ok]>]]></run>
              </formatted-text>
            </customized-label>
            <style>
