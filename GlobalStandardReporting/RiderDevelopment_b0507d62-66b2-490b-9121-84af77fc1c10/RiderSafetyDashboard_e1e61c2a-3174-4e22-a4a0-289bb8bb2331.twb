            </column>
            <column caption='Total' datatype='real' name='[Calculation_6573144412896575489]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = 1 THEN &#10;(&#10;IF [Parameters].[Parameter 1] = 1 THEN SUM([total_of_personal_accidents_with_no_lost_time])&#10;ELSEIF [Parameters].[Parameter 1] = 2 THEN SUM([total_of_personal_accidents_with_lost_time])&#10;ELSEIF [Parameters].[Parameter 1] = 3 THEN SUM([total_of_days_lost_sl])&#10;ELSEIF [Parameters].[Parameter 1] = 4 THEN SUM([absolute_total_fatalities])&#10;ELSEIF [Parameters].[Parameter 1] = 5 THEN SUM([total_distance])&#10;ELSEIF [Parameters].[Parameter 1] = 6 THEN SUM([total_deliveries])&#10;ELSEIF [Parameters].[Parameter 1] = 7 THEN SUM([hours_worked])&#10;ELSEIF [Parameters].[Parameter 1] = 8 THEN SUM(ZN([total_of_personal_accidents_with_no_lost_time])+ZN([total_of_personal_accidents_with_lost_time]))&#10;ELSEIF [Parameters].[Parameter 1] = 9 THEN SUM(ZN([total_of_personal_accidents_with_no_lost_time])+ZN([total_of_personal_accidents_with_lost_time]))*1000000/SUM([total_deliveries])&#10;ELSEIF [Parameters].[Parameter 1] = 10 THEN SUM([absolute_total_fatalities])*1000000/SUM([total_deliveries])&#10;ELSEIF [Parameters].[Parameter 1] = 12 THEN SUM(ZN([total_of_personal_accidents_with_no_lost_time])+ZN([total_of_personal_accidents_with_lost_time]))*1000000/SUM([total_distance])&#10;ELSEIF [Parameters].[Parameter 1] = 13 THEN SUM([absolute_total_fatalities])*1000000/SUM([total_distance])&#10;ELSEIF [Parameters].[Parameter 1] =14 THEN SUM(ZN([total_of_personal_accidents_with_no_lost_time])+ZN([total_of_personal_accidents_with_lost_time]))*1000000/SUM([hours_worked])&#10;ELSEIF [Parameters].[Parameter 1] = 15 THEN SUM([absolute_total_fatalities])*1000000/SUM([hours_worked])&#10;ELSEIF [Parameters].[Parameter 1] = 16 THEN ([Calculation_2164894437013086224])&#10;END)&#10;ELSE &#10;(IF [Parameters].[Parameter 1] = 1 THEN RUNNING_SUM(SUM([total_of_personal_accidents_with_no_lost_time]))&#10;ELSEIF [Parameters].[Parameter 1] = 2 THEN RUNNING_SUM(SUM([total_of_personal_accidents_with_