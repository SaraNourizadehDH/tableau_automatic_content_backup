        <zone h='1929' id='233' leg-item-layout='horz' name='Country Deepdive' pane-specification-id='4' param='[federated.1te5e2i0z4zk9h10s6nff0k426rs].[:Measure Names]' show-title='false' type-v2='color' w='27133' x='71667' y='46929' />
        <zone forceUpdate='true' h='2143' id='452' type-v2='text' w='14533' x='1067' y='75286'>
          <formatted-text>
            <run fontsize='15'>Accidents</run>
            <run fontcolor='#333333' fontsize='15'> vs Fatalities </run>
          </formatted-text>
        </zone>
        <zone forceUpdate='true' h='28786' hidden-by-user='true' id='563' type-v2='text' w='32533' x='65467' y='15714'>
          <formatted-text>
            <run bold='true' fontcolor='#1d1c1d' fontname='Slack-Lato,Slack-Fractions,appleLogo,sans-serif' fontsize='10'>Accidents with NO lost time:</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato,Slack-Fractions,appleLogo,sans-serif' fontsize='10'> Any work-related injury during the Rider&apos;s active shift, which is treated by a paramedic or a physician without loss of work time other than the time of the shift on which it occurred, and the injured person continues with his normal scheduled work. First aid related.</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#1d1c1d' fontname='Slack-Lato,Slack-Fractions,appleLogo,sans-serif' fontsize='10'>Accidents with Lost Time: </run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato,Slack-Fractions,appleLogo,sans-serif' fontsize='10'>Any work-related injury during the Rider&apos;s active shift, resulting in the employee not being able to return to work for their next scheduled work period. Time off as requested by a healthcare professional as a result of the accident. Sick leave/doctor&apos;s note related.</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#1d1c1d' fontname='Slack-Lato,Slack-Fractions,appleLogo,sans-serif' fontsize='10'>Total Accidents</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato,Slack-Fractions,appleLogo,sans-serif' fontsize='10'>: Accidents with no lost time + accidents with lost time

</run>
            <run bold='true' fontcolor='#1d1c1d' fontname='Slack-Lato,Slack-Fractions,appleLogo,sans-serif' fontsize='10'>Fatalities:</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato,Slack-Fractions,appleLogo,sans-serif' fontsize='10'> Death from a work-related injury during the Rider&apos;s active shift, certified by a medical professional.</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#1d1c1d' fontname='Slack-Lato,Slack-Fractions,appleLogo,sans-serif' fontsize='10'>Reduction target performance</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato,Slack-Fractions,appleLogo,sans-serif' fontsize='10'>: % difference between the current performance and the reduction target</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#1d1c1d' fontname='Slack-Lato,Slack-Fractions,appleLogo,sans-serif' fontsize='10'>Cumulative (Non-Ratio KPIs)</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato,Slack-Fractions,appleLogo,sans-serif' fontsize='10'>: Sum of data over the selected month/quarter/year</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#1d1c1d' fontname='Slack-Lato,Slack-Fractions,appleLogo,sans-serif' fontsize='10'>Cumulative (Ratio KPIs): (</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato,Slack-Fractions,appleLogo,sans-serif' fontsize='10'>Sum of accidents over the selected month/quarter/year) * 1000000 / (Sum of corresponding KPI over the selected month/quarter/year)</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#898989' />
            <format attr='border-style' value='solid' />
            <format attr='border-width' value='1' />
            <format attr='background-color' value='#ffffff' />
          </zone-style>
        </zone>
        <zone h='1857' id='564' type-v2='dashboard-object' w='7800' x='91000' y='13286'>
          <button action='' active-visual-state-index='1' button-type='text'>
            <toggle-action>tabdoc:toggle-button-click-action window-id=&quot;{8DDC3894-8AEC-4625-A814-E4453128286D}&quot; zone-id=&quot;564&quot; zone-ids=[563]</toggle-action>
