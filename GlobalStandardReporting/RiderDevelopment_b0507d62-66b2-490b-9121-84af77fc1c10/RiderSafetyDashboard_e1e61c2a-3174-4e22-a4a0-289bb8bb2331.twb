        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = 1 THEN DATENAME(&apos;year&apos;,[report_month])&#10;ELSEIF [Parameters].[Parameter 2] = 2 THEN  &quot;Q&quot;+DATENAME(&apos;quarter&apos;,[report_month])+&quot; &quot;+RIGHT(DATENAME(&apos;year&apos;,[report_month]),2)&#10;ELSEIF [Parameters].[Parameter 2] = 3 THEN LEFT(DATENAME(&apos;month&apos;,[report_month]),3) + &quot; &quot;+RIGHT(DATENAME(&apos;year&apos;,[report_month]),2)&#10;END' />
