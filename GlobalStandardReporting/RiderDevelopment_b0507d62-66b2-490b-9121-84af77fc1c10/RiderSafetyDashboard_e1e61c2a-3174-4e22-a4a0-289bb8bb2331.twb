            <column caption='Reduction Target' datatype='real' name='[Baseline (copy)_1559371418879250435]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Calculation_6573144413526953996], YEAR([Report Date (copy)_6573144412903514116]): MAX(&#10;&#10;IF [Parameters].[Parameter 3] = &apos;Brand&apos; THEN &#10;    IF YEAR([Report Date (copy)_6573144412903514116]) = 2023 THEN [Reduction Target (copy)_2164894437007507470]*.98&#10;    ELSEIF [entity] = &apos;eFood&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2024 THEN 57.76&#10;    ELSEIF [entity] = &apos;Foodora&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2024 THEN 16.62&#10;    ELSEIF [entity] = &apos;Foodpanda&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2024 THEN 23.90&#10;    ELSEIF [entity] = &apos;Foody&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2024 THEN 96.38&#10;    ELSEIF [entity] = &apos;Glovo&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2024 THEN 72.17&#10;    ELSEIF [entity] = &apos;HungerStation&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2024 THEN 1.6758&#10;    ELSEIF [entity] = &apos;PedidosYa&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2024 THEN 9.64&#10;    ELSEIF [entity] = &apos;Talabat&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2024 THEN 21.21&#10;    ELSEIF [entity] = &apos;Woowa&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2024 THEN 9.29&#10;    ELSEIF [entity] = &apos;Yemeksepeti&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2024 THEN 113.3445&#10;    ELSEIF [entity] = &apos;Delivery Hero&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2024 THEN 24.60&#10;&#10;    ELSEIF [entity] = &apos;eFood&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2025 THEN [Reduction Target (copy)_2164894437007507470]*.97&#10;    ELSEIF [entity] = &apos;Foodora&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2025 THEN [Reduction Target (copy)_2164894437007507470]*.97&#10;    ELSEIF [entity] = &apos;Foodpanda&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2025 THEN [Reduction Target (copy)_2164894437007507470]*.97&#10;    ELSEIF [entity] = &apos;Foody&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2025 THEN [Reduction Target (copy)_2164894437007507470]*.97&#10;    ELSEIF [entity] = &apos;Glovo&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2025 THEN [Reduction Target (copy)_2164894437007507470]*.97&#10;    ELSEIF [entity] = &apos;HungerStation&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2025 THEN [Reduction Target (copy)_2164894437007507470]*.97&#10;    ELSEIF [entity] = &apos;PedidosYa&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2025 THEN [Reduction Target (copy)_2164894437007507470]*.97&#10;    ELSEIF [entity] = &apos;Talabat&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2025 THEN [Reduction Target (copy)_2164894437007507470]*.90&#10;    ELSEIF [entity] = &apos;Woowa&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2025 THEN [Reduction Target (copy)_2164894437007507470]*.97&#10;    ELSEIF [entity] = &apos;Yemeksepeti&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2025 THEN [Reduction Target (copy)_2164894437007507470]*.97&#10;    ELSEIF [entity] = &apos;Delivery Hero&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2025 THEN [Reduction Target (copy)_2164894437007507470]*.97&#10;&#10;    END&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Global&apos; THEN &#10;    IF YEAR([Report Date (copy)_6573144412903514116]) = 2023 THEN [Reduction Target (copy)_2164894437007507470]*.98&#10;    ELSEIF YEAR([Report Date (copy)_6573144412903514116]) = 2024 THEN 24.60&#10;  ELSEIF YEAR([Report Date (copy)_6573144412903514116]) = 2025 THEN 24.60*.97&#10;    END&#10;END)&#10;}' />
            </column>
            <column caption='Performance' datatype='real' name='[Calculation_2164894437013086224]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Total (copy)_6573144413965881367] - SUM([Baseline (copy)_1559371418879250435]))*100/SUM([Baseline (copy)_1559371418879250435])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Total' datatype='real' name='[Calculation_6573144412896575489]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = 1 THEN &#10;(&#10;IF [Parameters].[Parameter 1] = 1 THEN SUM([total_of_personal_accidents_with_no_lost_time])&#10;ELSEIF [Parameters].[Parameter 1] = 2 THEN SUM([total_of_personal_accidents_with_lost_time])&#10;ELSEIF [Parameters].[Parameter 1] = 3 THEN SUM([total_of_days_lost_sl])&#10;ELSEIF [Parameters].[Parameter 1] = 4 THEN SUM([absolute_total_fatalities])&#10;ELSEIF [Parameters].[Parameter 1] = 5 THEN SUM([total_distance])&#10;ELSEIF [Parameters].[Parameter 1] = 6 THEN SUM([total_deliveries])&#10;ELSEIF [Parameters].[Parameter 1] = 7 THEN SUM([hours_worked])&#10;ELSEIF [Parameters].[Parameter 1] = 8 THEN SUM(ZN([total_of_personal_accidents_with_no_lost_time])+ZN([total_of_personal_accidents_with_lost_time]))&#10;ELSEIF [Parameters].[Parameter 1] = 9 THEN SUM(ZN([total_of_personal_accidents_with_no_lost_time])+ZN([total_of_personal_accidents_with_lost_time]))*1000000/SUM([total_deliveries])&#10;ELSEIF [Parameters].[Parameter 1] = 10 THEN SUM([absolute_total_fatalities])*1000000/SUM([total_deliveries])&#10;ELSEIF [Parameters].[Parameter 1] = 12 THEN SUM(ZN([total_of_personal_accidents_with_no_lost_time])+ZN([total_of_personal_accidents_with_lost_time]))*1000000/SUM([total_distance])&#10;ELSEIF [Parameters].[Parameter 1] = 13 THEN SUM([absolute_total_fatalities])*1000000/SUM([total_distance])&#10;ELSEIF [Parameters].[Parameter 1] =14 THEN SUM(ZN([total_of_personal_accidents_with_no_lost_time])+ZN([total_of_personal_accidents_with_lost_time]))*1000000/SUM([hours_worked])&#10;ELSEIF [Parameters].[Parameter 1] = 15 THEN SUM([absolute_total_fatalities])*1000000/SUM([hours_worked])&#10;ELSEIF [Parameters].[Parameter 1] = 16 THEN ([Calculation_2164894437013086224])&#10;END)&#10;ELSE &#10;(IF [Parameters].[Parameter 1] = 1 THEN RUNNING_SUM(SUM([total_of_personal_accidents_with_no_lost_time]))&#10;ELSEIF [Parameters].[Parameter 1] = 2 THEN RUNNING_SUM(SUM([total_of_personal_accidents_with_lost_time]))&#10;ELSEIF [Parameters].[Parameter 1] = 3 THEN RUNNING_SUM(SUM([total_of_days_lost_sl]))&#10;ELSEIF [Parameters].[Parameter 1] = 4 THEN RUNNING_SUM(SUM([absolute_total_fatalities]))&#10;ELSEIF [Parameters].[Parameter 1] = 5 THEN RUNNING_SUM(SUM([total_distance]))&#10;ELSEIF [Parameters].[Parameter 1] = 6 THEN RUNNING_SUM(SUM([total_deliveries]))&#10;ELSEIF [Parameters].[Parameter 1] = 7 THEN RUNNING_SUM(SUM([hours_worked]))&#10;ELSEIF [Parameters].[Parameter 1] = 8 THEN RUNNING_SUM(SUM(ZN([total_of_personal_accidents_with_no_lost_time])+ZN([total_of_personal_accidents_with_lost_time])))&#10;ELSEIF [Parameters].[Parameter 1] = 9 THEN RUNNING_SUM(SUM(ZN([total_of_personal_accidents_with_no_lost_time])+ZN([total_of_personal_accidents_with_lost_time])))*1000000/RUNNING_SUM(SUM([total_deliveries]))&#10;ELSEIF [Parameters].[Parameter 1] = 10 THEN RUNNING_SUM(SUM([absolute_total_fatalities]))*1000000/RUNNING_SUM(SUM([total_deliveries]))&#10;ELSEIF [Parameters].[Parameter 1] = 12 THEN RUNNING_SUM(SUM(ZN([total_of_personal_accidents_with_no_lost_time])+ZN([total_of_personal_accidents_with_lost_time])))*1000000/RUNNING_SUM(SUM([total_distance]))&#10;ELSEIF [Parameters].[Parameter 1] = 13 THEN RUNNING_SUM(SUM([absolute_total_fatalities]))*1000000/RUNNING_SUM(SUM([total_distance]))&#10;ELSEIF [Parameters].[Parameter 1] = 14 THEN RUNNING_SUM(SUM(ZN([total_of_personal_accidents_with_no_lost_time])+ZN([total_of_personal_accidents_with_lost_time])))*1000000/RUNNING_SUM(SUM([hours_worked]))&#10;ELSEIF [Parameters].[Parameter 1] = 15 THEN RUNNING_SUM(SUM([absolute_total_fatalities]))*1000000/RUNNING_SUM(SUM([hours_worked]))&#10;END)&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Report Date' datatype='string' datatype-customized='true' name='[Calculation_6573144412900839427]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = 1 THEN DATENAME(&apos;year&apos;,[report_month])&#10;ELSEIF [Parameters].[Parameter 2] = 2 THEN  &quot;Q&quot;+DATENAME(&apos;quarter&apos;,[report_month])+&quot; &quot;+RIGHT(DATENAME(&apos;year&apos;,[report_month]),2)&#10;ELSEIF [Parameters].[Parameter 2] = 3 THEN LEFT(DATENAME(&apos;month&apos;,[report_month]),3) + &quot; &quot;+RIGHT(DATENAME(&apos;year&apos;,[report_month]),2)&#10;END' />
            </column>
            <column caption='Dimension A' datatype='string' name='[Calculation_6573144413526953996]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Region&apos; THEN [region]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Country&apos; THEN [country_name]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Brand&apos; AND NOT([Parameters].[Parameter 5]) THEN [entity]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Brand&apos; AND [Parameters].[Parameter 5] THEN &#10;    (IF [entity] = &apos;Yemeksepeti&apos; or [entity] = &apos;Foodora&apos; or [entity] = &apos;Foodpanda&apos; THEN &apos;Pandora&apos;&#10;    ELSE [entity] &#10;    END)&#10;ELSE &apos;Global&apos;&#10;END' />
            </column>
            <column caption='Show Hide' datatype='boolean' name='[Calculation_6573144413908430869]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1] = 11' />
            </column>
            <column caption='Dimension B' datatype='string' name='[Dimension A (copy)_6573144413527011341]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Dimension A (copy)_6573144413527228430] = &apos;Region&apos; THEN [region]&#10;ELSEIF [Parameters].[Dimension A (copy)_6573144413527228430] = &apos;Country&apos; THEN [country_name]&#10;//ELSEIF [Parameters].[Dimension B] = &apos;Brand&apos; THEN [Entity]&#10;ELSEIF [Parameters].[Dimension A (copy)_6573144413527228430] = &apos;Brand&apos; AND NOT([Parameters].[Parameter 5]) THEN [entity]&#10;ELSEIF [Parameters].[Dimension A (copy)_6573144413527228430] = &apos;Brand&apos; AND [Parameters].[Parameter 5] THEN &#10;    (IF [entity] = &apos;Yemeksepeti&apos; or [entity] = &apos;Foodora&apos; or [entity] = &apos;Foodpanda&apos; THEN &apos;Pandora&apos;&#10;    ELSE [entity] &#10;    END)&#10;ELSE &quot;&quot;&#10;END' />
