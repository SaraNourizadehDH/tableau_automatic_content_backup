            </column>
            <column caption='Dimension B' datatype='string' name='[Dimension A (copy)_6573144413527011341]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Dimension A (copy)_6573144413527228430] = &apos;Region&apos; THEN [region]&#10;ELSEIF [Parameters].[Dimension A (copy)_6573144413527228430] = &apos;Country&apos; THEN [country_name]&#10;//ELSEIF [Parameters].[Dimension B] = &apos;Brand&apos; THEN [Entity]&#10;ELSEIF [Parameters].[Dimension A (copy)_6573144413527228430] = &apos;Brand&apos; AND NOT([Parameters].[Parameter 5]) THEN [entity]&#10;ELSEIF [Parameters].[Dimension A (copy)_6573144413527228430] = &apos;Brand&apos; AND [Parameters].[Parameter 5] THEN &#10;    (IF [entity] = &apos;Yemeksepeti&apos; or [entity] = &apos;Foodora&apos; or [entity] = &apos;Foodpanda&apos; THEN &apos;Pandora&apos;&#10;    ELSE [entity] &#10;    END)&#10;ELSE &quot;&quot;&#10;END' />
            </column>
            <column caption='Baseline' datatype='real' name='[Reduction Target (copy)_2164894437007507470]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Calculation_6573144413526953996], YEAR([Report Date (copy)_6573144412903514116]): MAX(&#10;&#10;IF [Parameters].[Parameter 3] = &apos;Brand&apos; THEN &#10;    IF [entity] = &apos;eFood&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2023 THEN 80.18&#10;    ELSEIF [entity] = &apos;Foodora&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2023 THEN 20.87&#10;    ELSEIF [entity] = &apos;Foodpanda&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2023 THEN 28.06&#10;    ELSEIF [entity] = &apos;Foody&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2023 THEN 89.76&#10;    ELSEIF [entity] = &apos;Glovo&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2023 THEN 42.98&#10;    ELSEIF [entity] = &apos;HungerStation&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2023 THEN 0.59&#10;    ELSEIF [entity] = &apos;PedidosYa&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2023 THEN 12.42&#10;    ELSEIF [entity] = &apos;Talabat&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2023 THEN 53.93&#10;    ELSEIF [entity] = &apos;Woowa&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2023 THEN 11.46&#10;    ELSEIF [entity] = &apos;Yemeksepeti&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2023 THEN 475.86&#10;    ELSEIF [entity] = &apos;Delivery Hero&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2023 THEN 37.57&#10;&#10;    //ELSEIF [Entity] = &apos;eFood&apos; AND YEAR([Report Date Sort]) = 2024 THEN 59.55&#10;    //ELSEIF [Entity] = &apos;Foodora&apos; AND YEAR([Report Date Sort]) = 2024 THEN 16.96&#10;    //ELSEIF [Entity] = &apos;Foodpanda&apos; AND YEAR([Report Date Sort]) = 2024 THEN 26.56&#10;    //ELSEIF [Entity] = &apos;Foody&apos; AND YEAR([Report Date Sort]) = 2024 THEN 98.35&#10;    //ELSEIF [Entity] = &apos;Glovo&apos; AND YEAR([Report Date Sort]) = 2024 THEN 75.97&#10;    //ELSEIF [Entity] = &apos;Hung