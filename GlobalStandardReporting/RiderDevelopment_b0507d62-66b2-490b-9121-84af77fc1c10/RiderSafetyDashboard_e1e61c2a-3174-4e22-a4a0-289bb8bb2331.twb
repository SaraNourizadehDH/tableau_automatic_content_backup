          <datasource-dependencies datasource='federated.1te5e2i0z4zk9h10s6nff0k426rs'>
            <column caption='Dimension A' datatype='string' name='[Calculation_6573144413526953996]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Region&apos; THEN [region]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Country&apos; THEN [country_name]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Brand&apos; AND NOT([Parameters].[Parameter 5]) THEN [entity]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Brand&apos; AND [Parameters].[Parameter 5] THEN &#10;    (IF [entity] = &apos;Yemeksepeti&apos; or [entity] = &apos;Foodora&apos; or [entity] = &apos;Foodpanda&apos; THEN &apos;Pandora&apos;&#10;    ELSE [entity] &#10;    END)&#10;ELSE &apos;Global&apos;&#10;END' />
            </column>
            <column caption='Show Hide' datatype='boolean' name='[Calculation_6573144413908430869]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1] = 11' />
            </column>
            <column caption='Dimension B' datatype='string' name='[Dimension A (copy)_6573144413527011341]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Dimension A (copy)_6573144413527228430] = &apos;Region&apos; THEN [region]&#10;ELSEIF [Parameters].[Dimension A (copy)_6573144413527228430] = &apos;Country&apos; THEN [country_name]&#10;//ELSEIF [Parameters].[Dimension B] = &apos;Brand&apos; THEN [Entity]&#10;ELSEIF [Parameters].[Dimension A (copy)_6573144413527228430] = &apos;Brand&apos; AND NOT([Parameters].[Parameter 5]) THEN [entity]&#10;ELSEIF [Parameters].[Dimension A (copy)_6573144413527228430] = &apos;Brand&apos; AND [Parameters].[Parameter 5] THEN &#10;    (IF [entity] = &apos;Yemeksepeti&apos; or [entity] = &apos;Foodora&apos; or [entity] = &apos;Foodpanda&apos; THEN &apos;Pandora&apos;&#10;    ELSE [entity] &#10;    END)&#10;ELSE &quot;&quot;&#10;END' />
            </column>
            <column caption='Freelancers' datatype='real' name='[Select KPI (copy) (copy) (copy)_6573144412911714311]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = 1 THEN &#10;(IF [Parameters].[Parameter 1] = 1 THEN SUM([freelancers_nlt])&#10;ELSEIF [Parameters].[Parameter 1] = 2 THEN SUM([freelancers_lt])&#10;ELSEIF [Parameters].[Parameter 1] = 3 THEN SUM([freelancers_sl])&#10;ELSEIF [Parameters].[Parameter 1] = 4 THEN SUM([freelancers_f])&#10;ELSEIF [Parameters].[Parameter 1] = 5 THEN SUM([freelancers_distance])&#10;ELSEIF [Parameters].[Parameter 1] = 6 THEN SUM([freelancers_deliveries])&#10;ELSEIF [Parameters].[Parameter 1] = 7 THEN SUM([freelancers_hours_worked])&#10;ELSEIF [Parameters].[Parameter 1] = 8 THEN SUM(IFNULL([freelancers_nlt],0)+IFNULL([freelancers_lt],0))&#10;ELSEIF [Parameters].[Parameter 1] = 9 THEN SUM((ZN([freelancers_nlt])+ZN([freelancers_lt]))*1000000)/SUM([freelancers_deliveries])&#10;ELSEIF [Parameters].[Parameter 1] = 10 THEN SUM(([freelancers_f])*1000000)/SUM([freelancers_deliveries])&#10;ELSEIF [Parameters].[Parameter 1] = 12 THEN SUM((ZN([freelancers_nlt])+ZN([freelancers_lt]))*1000000)/SUM([freelancers_distance])&#10;ELSEIF [Parameters].[Parameter 1] = 13 THEN SUM(([freelancers_f])*1000000)/SUM([freelancers_distance])&#10;ELSEIF [Parameters].[Parameter 1] = 14 THEN SUM((ZN([freelancers_nlt])+ZN([freelancers_lt]))*1000000)/SUM([freelancers_hours_worked])&#10;ELSEIF [Parameters].[Parameter 1] = 15 THEN SUM(([freelancers_f])*1000000)/SUM([freelancers_hours_worked])&#10;END)&#10;ELSE &#10;(IF [Parameters].[Parameter 1] = 1 THEN RUNNING_SUM(SUM([freelancers_nlt]))&#10;ELSEIF [Parameters].[Parameter 1] = 2 THEN RUNNING_SUM(SUM([freelancers_lt]))&#10;ELSEIF [Parameters].[Parameter 1] = 3 THEN RUNNING_SUM(SUM([freelancers_sl]))&#10;ELSEIF [Parameters].[Parameter 1] = 4 THEN RUNNING_SUM(SUM([freelancers_f]))&#10;ELSEIF [Parameters].[Parameter 1] = 5 THEN RUNNING_SUM(SUM([freelancers_distance]))&#10;ELSEIF [Parameters].[Parameter 1] = 6 THEN RUNNING_SUM(SUM([freelancers_deliveries]))&#10;ELSEIF [Parameters].[Parameter 1] = 7 THEN RUNNING_SUM(SUM([freelancers_hours_worked]))&#10;ELSEIF [Parameters].[Parameter 1] = 8 THEN RUNNING_SUM(SUM(ZN([freelancers_nlt])+ZN([freelancers_lt])))&#10;ELSEIF [Parameters].[Parameter 1] = 9 THEN RUNNING_SUM(SUM(ZN([freelancers_nlt])+ZN([freelancers_lt])))*1000000/RUNNING_SUM(SUM([freelancers_deliveries]))&#10;ELSEIF [Parameters].[Parameter 1] = 10 THEN RUNNING_SUM(SUM([freelancers_f]))*1000000/RUNNING_SUM(SUM([freelancers_deliveries]))&#10;ELSEIF [Parameters].[Parameter 1] = 12 THEN RUNNING_SUM(SUM(ZN([freelancers_nlt])+ZN([freelancers_lt])))*1000000/RUNNING_SUM(SUM([freelancers_distance]))&#10;ELSEIF [Parameters].[Parameter 1] = 13 THEN RUNNING_SUM(SUM([freelancers_f]))*1000000/RUNNING_SUM(SUM([freelancers_distance]))&#10;ELSEIF [Parameters].[Parameter 1] = 14 THEN RUNNING_SUM(SUM(ZN([freelancers_nlt])+ZN([freelancers_lt])))*1000000/RUNNING_SUM(SUM([freelancers_hours_worked]))&#10;ELSEIF [Parameters].[Parameter 1] = 15 THEN RUNNING_SUM(SUM([freelancers_f]))*1000000/RUNNING_SUM(SUM([freelancers_hours_worked]))&#10;END)&#10;END'>
