py)_6573144412903514116]) = 2025 THEN [Reduction Target (copy)_2164894437007507470]*.97&#10;    ELSEIF [entity] = &apos;Foody&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2025 THEN [Reduction Target (copy)_2164894437007507470]*.97&#10;    ELSEIF [entity] = &apos;Glovo&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2025 THEN [Reduction Target (copy)_2164894437007507470]*.97&#10;    ELSEIF [entity] = &apos;HungerStation&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2025 THEN [Reduction Target (copy)_2164894437007507470]*.97&#10;    ELSEIF [entity] = &apos;PedidosYa&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2025 THEN [Reduction Target (copy)_2164894437007507470]*.97&#10;    ELSEIF [entity] = &apos;Talabat&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2025 THEN [Reduction Target (copy)_2164894437007507470]*.90&#10;    ELSEIF [entity] = &apos;Woowa&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2025 THEN [Reduction Target (copy)_2164894437007507470]*.97&#10;    ELSEIF [entity] = &apos;Yemeksepeti&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2025 THEN [Reduction Target (copy)_2164894437007507470]*.97&#10;    ELSEIF [entity] = &apos;Delivery Hero&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2025 THEN [Reduction Target (copy)_2164894437007507470]*.97&#10;&#10;    END&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Global&apos; THEN &#10;    IF YEAR([Report Date (copy)_6573144412903514116]) = 2023 THEN [Reduction Target (copy)_2164894437007507470]*.98&#10;    ELSEIF YEAR([Report Date (copy)_6573144412903514116]) = 2024 THEN 24.60&#10;  ELSEIF YEAR([Report Date (copy)_6573144412903514116]) = 2025 THEN 24.60*.97&#10;    END&#10;END)&#10;}' />
