              <calculation class='tableau' formula='{ FIXED [Calculation_6573144413526953996], YEAR([Report Date (copy)_6573144412903514116]): MAX(&#10;&#10;IF [Parameters].[Parameter 3] = &apos;Brand&apos; THEN &#10;    IF YEAR([Report Date (copy)_6573144412903514116]) = 2023 THEN [Reduction Target (copy)_2164894437007507470]*.98&#10;    ELSEIF [entity] = &apos;eFood&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2024 THEN 57.76&#10;    ELSEIF [entity] = &apos;Foodora&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2024 THEN 16.62&#10;    ELSEIF [entity] = &apos;Foodpanda&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2024 THEN 23.90&#10;    ELSEIF [entity] = &apos;Foody&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2024 THEN 96.38&#10;    ELSEIF [entity] = &apos;Glovo&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2024 THEN 72.17&#10;    ELSEIF [entity] = &apos;HungerStation&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2024 THEN 1.6758&#10;    ELSEIF [entity] = &apos;PedidosYa&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2024 THEN 9.64&#10;    ELSEIF [entity] = &apos;Talabat&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2024 THEN 21.21&#10;    ELSEIF [entity] = &apos;Woowa&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2024 THEN 9.29&#10;    ELSEIF [entity] = &apos;Yemeksepeti&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2024 THEN 113.3445&#10;    ELSEIF [entity] = &apos;Delivery Hero&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2024 THEN 24.60&#10;&#10;    ELSEIF [entity] = &apos;eFood&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2025 THEN [Reduction Target (copy)_2164894437007507470]*.97&#10;    ELSEIF [entity] = &apos;Foodora&apos; AND YEAR([Report Date (copy)_6573144412903514116]) = 2025 THEN [Reduction Target (copy)_2164894437007507470]*.97&#10;    ELSEIF [entity] = &apos;Foodpanda&apos; AND YEAR([Report Da