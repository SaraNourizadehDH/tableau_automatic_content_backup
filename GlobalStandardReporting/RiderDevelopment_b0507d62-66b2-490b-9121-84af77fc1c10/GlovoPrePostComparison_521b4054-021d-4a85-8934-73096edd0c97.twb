      <aliases enabled='yes' />
      <column caption='% diff Orders Completed' datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([orders_completed])) - LOOKUP(ZN(SUM([orders_completed])), -1)) / ABS(LOOKUP(ZN(SUM([orders_completed])), -1))'>
          <table-calc ordering-type='Field'>
            <order field='[federated.10aufah1tnjwxg1fk3zxu1lu35rs].[none:period:nk]' />
            <order field='[federated.10aufah1tnjwxg1fk3zxu1lu35rs].[none:Calculation_2181008912327335936:nk]' />
          </table-calc>
        </calculation>
      </column>
      <column caption='Time Dimension' datatype='string' name='[Calculation_2181008912327335936]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;  WHEN &apos;Report Date&apos; &#10;     THEN [report_date]&#10;  WHEN  &apos;Report Week&apos; &#10;     THEN [report_week]&#10;END' />
      </column>
      <column caption='Delivery Time DH' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_2181008912330260481]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([delivery_time_dh_n]) / SUM([delivery_time_dh_d])' />
      </column>
      <column caption='Orders Completed Test' datatype='string' name='[Calculation_2181008912375709699]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(SUM([orders_completed])) + &#10;&apos; (&apos; + &#10;IF [Calculation1] = 0 THEN&#10;    &apos;No Change&apos;&#10;ELSEIF [Calculation1] &gt; 0 THEN&#10;    &apos;+&apos; + STR(ROUND([Calculation1] * 100, 1)) + &apos;%&apos;&#10;ELSE&#10;    STR(ROUND([Calculation1] * 100, 1)) + &apos;%&apos;&#10;END +&#10;&apos;)&apos;'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Orders Completed Label' datatype='string' name='[Calculation_2181008912379617284]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Orders Completed Label&quot;' />
      </column>
      <column caption='KPI' datatype='real' name='[Calculation_3146679188909359111]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;Completed Orders&apos; THEN SUM([orders_completed])&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Delivery Time&apos; THEN [Calculation_2181008912330260481]&#10;END' />
      </column>
      <column caption='Completed Orders' datatype='integer' name='[Calculation_3146679188911833096]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Delivery Time' datatype='integer' name='[Completed Orders (copy)_3146679188911874057]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
