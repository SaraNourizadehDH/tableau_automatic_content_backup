      <column caption='City' datatype='string' name='[Calculation_5917378127165747201]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='If [_source] = &apos;comparable_cities&apos; &#10;&#10;THEN  &apos;Gimhae-si / Wonju-si / Jungwon-gu Seongnam-si&apos; &#10;ELSE [_source] &#10;END' />
