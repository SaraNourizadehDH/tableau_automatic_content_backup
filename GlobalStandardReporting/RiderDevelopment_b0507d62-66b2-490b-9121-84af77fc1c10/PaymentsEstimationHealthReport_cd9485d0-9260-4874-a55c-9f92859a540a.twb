              <calculation class='tableau' formula='SUM([actual_payment_deliveries]) / SUM([all_deliveris])' />
            </column>
            <column caption='% Estimated Paid Deliveries' datatype='real' default-format='p0.0%' name='[Calculation_7000423421977923585]' role='measure' type='quantitative'>
