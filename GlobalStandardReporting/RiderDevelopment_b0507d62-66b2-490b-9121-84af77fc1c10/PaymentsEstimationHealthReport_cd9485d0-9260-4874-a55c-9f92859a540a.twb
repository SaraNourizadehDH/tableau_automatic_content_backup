      <aliases enabled='yes' />
      <column caption='% Actual Paid Deliveries' datatype='real' default-format='p0.0%' name='[Calculation_7000423421977673728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([actual_payment_deliveries]) / SUM([all_deliveris])' />
      </column>
      <column caption='% Estimated Paid Deliveries' datatype='real' default-format='p0.0%' name='[Calculation_7000423421977923585]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([estimated_payment_deliveries]) / SUM([all_deliveris])' />
      </column>
      <column caption='% Estimated - Actual (Basic)' datatype='real' default-format='p0.0%' name='[Calculation_7000423421979906051]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([estimated_basic_payment]) - SUM([actual_basic_payment])) / SUM([estimated_basic_payment])' />
      </column>
      <column caption='Time Dimension' datatype='string' name='[Calculation_7000423422027964420]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;&#10;&#10;when &apos;Report Date&apos; THEN [report_date]&#10;when &apos;Report Week&apos; then [report_week]&#10;when &apos;Report Month&apos; THEN [report_month]&#10;end' />
      </column>
      <column caption='% Fall Back Paid Deliveries' datatype='real' default-format='p0.0%' name='[Calculation_7000423423466115077]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([fallback_payment_deliveries]) / SUM([all_deliveris])' />
      </column>
