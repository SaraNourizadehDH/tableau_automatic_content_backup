        <column-instance column='[user_email]' derivation='None' name='[none:user_email:nk]' pivot='key' type='nominal' />
        <column caption='Project Id' datatype='string' name='[project_id]' role='dimension' type='nominal' />
        <column caption='Task Id' datatype='string' name='[task_id]' role='dimension' type='nominal' />
        <column caption='User Email' datatype='string' name='[user_email]' role='dimension' type='nominal' />
      </datasource-dependencies>
