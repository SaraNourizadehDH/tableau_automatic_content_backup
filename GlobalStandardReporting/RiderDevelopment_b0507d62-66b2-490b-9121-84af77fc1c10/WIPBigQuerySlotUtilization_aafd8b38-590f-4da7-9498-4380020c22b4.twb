        <calculation class='tableau' formula='CASE [Calculation_129759996791676930]&#13;&#10;WHEN &apos;Absolute Values&apos; THEN SUM([slot_minutes])&#13;&#10;WHEN &apos;Percentage&apos; THEN -(SUM([slot_minutes]) / SUM({EXCLUDE [Calculation_3387340263885512704]: SUM([slot_minutes])}))&#13;&#10;END' />
