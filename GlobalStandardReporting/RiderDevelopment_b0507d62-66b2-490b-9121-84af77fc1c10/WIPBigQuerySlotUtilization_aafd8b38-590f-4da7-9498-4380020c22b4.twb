      <column caption='Metrics' datatype='real' name='[Calculation_129759996815630345]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Graph Type (copy)]&#13;&#10;WHEN  &apos;Avg Daily Slot Usage&apos; THEN  [Calculation_3985967176299040768]&#13;&#10;WHEN  &apos;Avg Task Slot Usage&apos; THEN  [Avg Task Slot Usage SP (copy)_1096063593259298819]&#13;&#10;WHEN &apos;Total Slot Usage&apos; THEN  SUM([slot_usage])&#13;&#10;WHEN &apos;Max Slot Usage&apos; THEN  MAX([slot_usage])&#13;&#10;WHEN &apos;Count Tasks&apos; THEN COUNT([task_id])&#13;&#10;WHEN &apos;# Unique Tasks&apos; THEN [Unique Tasks PP (copy)_1096063593262157828]&#13;&#10;WHEN &apos;Total Slot Minutes&apos; THEN SUM([slot_minutes])&#13;&#10;END' />
