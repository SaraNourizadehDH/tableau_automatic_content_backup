            <column caption='Parameterized Date' datatype='string' name='[Calculation_129759996787785729]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Slot Usage Parameter]&#13;&#10;    WHEN &apos;Day&apos; THEN STR([created_date])&#10;    WHEN &apos;Week&apos; THEN STR(DATE(DATETRUNC(&apos;week&apos;, [created_date], &apos;monday&apos;)))&#10;    WHEN &apos;Month&apos; THEN STR(DATE(DATETRUNC(&apos;month&apos;, [created_date])))&#13;&#10;    WHEN &apos;Hour&apos; THEN STR(DATEPART(&apos;hour&apos;, [period_start]))&#10;    WHEN &apos;Total&apos; THEN &apos;NA&apos;&#13;&#10;END' />
