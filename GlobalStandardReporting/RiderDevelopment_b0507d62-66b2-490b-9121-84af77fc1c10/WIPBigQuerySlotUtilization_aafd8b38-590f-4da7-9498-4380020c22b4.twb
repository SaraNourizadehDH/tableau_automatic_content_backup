            <column _.fcp.RefreshableParameterRanges.true...default-value-field='[federated.0q20dsk1sjbqe711yb6u40v64sdz].[Calculation_193654819316695041]' _.fcp.RefreshableParameterRanges.true...source-field='[federated.0q20dsk1sjbqe711yb6u40v64sdz].[created_date]' caption='From' datatype='date' name='[Metric (copy 2)]' param-domain-type='range' role='measure' type='quantitative' value='#2023-05-16#'>
