            </column>
            <column caption='From (Previous Period)' datatype='date' name='[Calculation_129759997935394837]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATEADD([Parameters].[From (copy)], -1, [Parameters].[Metric (copy 2)]))' />
            </column>
            <column caption='Avg Daily Slot Usage SP' datatype='real' name='[Calculation_129759997950279705]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF ([Calculation_129759997926862868],  [slot_usage], null))&#13;&#10;/&#13;&#10;COUNTD(IIF ([Calculation_129759997926862868],  [created_date], null))' />
            </column>
            <column caption='Avg Daily Slot Usage (Evo)' datatype='real' name='[Calculation_129759997952442395]' role='measure' type='quantitative'>
