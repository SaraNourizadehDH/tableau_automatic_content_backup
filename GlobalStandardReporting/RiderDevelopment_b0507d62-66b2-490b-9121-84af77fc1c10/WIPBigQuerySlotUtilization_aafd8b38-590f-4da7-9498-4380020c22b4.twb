          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0q20dsk1sjbqe711yb6u40v64sdz'>
            <column caption='Slot Usage (Graph Type)' datatype='real' name='[Calculation_1096063593254440962]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Calculation_129759996791676930]&#13;&#10;WHEN &apos;Absolute Values&apos; THEN SUM([slot_usage])&#13;&#10;WHEN &apos;Percentage&apos; THEN (SUM([slot_usage]) / SUM({EXCLUDE [Calculation_3387340263885512704]: SUM([slot_usage])}))&#13;&#10;END' />
            </column>
            <column caption='Graph Type' datatype='string' name='[Calculation_129759996791676930]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Time Granularity (copy)]' />
            </column>
            <column caption='Dimension A' datatype='string' name='[Calculation_129759996826169356]' role='dimension' type='nominal'>
