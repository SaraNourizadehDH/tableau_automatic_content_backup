        <calculation class='tableau' formula='[Calculation_129759997950279705]/[Avg Daily Slot Usage A (copy)_129759997951758362] - 1' />
      </column>
      <column caption='Date Equalizer' datatype='string' name='[Calculation_129759998164455461]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Slot Usage Parameter]&#13;&#10;WHEN &apos;Day&apos; THEN&#13;&#10;str(date(IF [Calculation_129759997926862868] = true then [created_date]&#13;&#10;ELSEIF [Is the Period (copy)_129759997936861207] = TRUE THEN dateadd([Parameters].[From (copy)], 1,[created_date])&#13;&#10;else null&#13;&#10;end))&#13;&#10;&#13;&#10;WHEN &apos;Hour&apos; THEN STR(DATEPART(&apos;hour&apos;, [period_start]))&#13;&#10;END' />
      </column>
