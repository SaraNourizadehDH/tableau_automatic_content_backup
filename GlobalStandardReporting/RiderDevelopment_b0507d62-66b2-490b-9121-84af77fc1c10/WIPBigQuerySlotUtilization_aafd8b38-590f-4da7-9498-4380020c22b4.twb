          <datasource-dependencies datasource='federated.0q20dsk1sjbqe711yb6u40v64sdz'>
            <column caption='Avg Daily Slot Usage PP' datatype='real' name='[Avg Daily Slot Usage A (copy)_129759997951758362]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF ([Is the Period (copy)_129759997936861207],  [slot_usage], null))&#13;&#10;/&#13;&#10;COUNTD(IIF ([Is the Period (copy)_129759997936861207],  [created_date], null))' />
            </column>
            <column caption='Is Selected Period' datatype='boolean' name='[Calculation_129759997926862868]' role='dimension' type='nominal'>
