    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='DAG Analysis'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/WIPBigQuerySlotUtilization/DAGAnalysis?rev=' id='DAGAnalysis' path='/t/GlobalStandardReporting/workbooks/WIPBigQuerySlotUtilization' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='1600' maxwidth='1300' minheight='1200' minwidth='1200' sizing-mode='range' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='bigquery_slot_metrics (rl)' name='federated.0q20dsk1sjbqe711yb6u40v64sdz' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Metric (DAG Analysis)' datatype='string' name='[Metric (copy 3)_335799695347798020]' param-domain-type='list' role='measure' type='nominal' value='&quot;Slot Minutes&quot;'>
          <calculation class='tableau' formula='&quot;Slot Minutes&quot;' />
          <members>
            <member value='&quot;Slot Usage&quot;' />
            <member value='&quot;Slot Minutes&quot;' />
          </members>
        </column>
        <column caption='Dimension A' datatype='string' name='[Metric (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;DAG Product Line&quot;'>
          <calculation class='tableau' formula='&quot;DAG Product Line&quot;' />
          <members>
            <member value='&quot;Project Id&quot;' />
            <member value='&quot;DAG&quot;' />
            <member value='&quot;DAG Id&quot;' />
            <member value='&quot;Task Id&quot;' />
            <member value='&quot;Email&quot;' />
            <member value='&quot;DAG Product Line&quot;' />
            <member value='&quot;DAG Type&quot;' />
            <member value='&quot;None&quot;' />
          </members>
        </column>
        <column caption='Time Granularity' datatype='string' name='[Slot Usage Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
          <calculation class='tableau' formula='&quot;Day&quot;' />
          <members>
            <member value='&quot;Hour&quot;' />
            <member value='&quot;Day&quot;' />
            <member value='&quot;Week&quot;' />
            <member value='&quot;Month&quot;' />
            <member value='&quot;Total&quot;' />
          </members>
        </column>
        <column caption='Graph Type' datatype='string' name='[Time Granularity (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;Absolute Values&quot;'>
          <calculation class='tableau' formula='&quot;Absolute Values&quot;' />
          <members>
            <member value='&quot;Percentage&quot;' />
            <member value='&quot;Absolute Values&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.0q20dsk1sjbqe711yb6u40v64sdz'>
        <column caption='DAG' datatype='string' name='[Calculation_3387340263885512704]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [dag_id] = &apos;great_expectations_dq_dag&apos; AND [business_unit] = &apos;log&apos;&#10;    THEN &apos;ge-daily&apos;&#10;ELSEIF STARTSWITH([task_id], &apos;great_expectations&apos;) AND [business_unit] = &apos;log&apos;&#10;    THEN &apos;ge&apos;&#10;ELSEIF [dag_id] = &apos;great_expectations_dq_dag&apos; AND [business_unit] = &apos;gcc_service&apos;&#10;    THEN &apos;ge-daily-service&apos;&#10;ELSEIF STARTSWITH([task_id], &apos;great_expectations&apos;) AND [business_unit] = &apos;gcc_service&apos;&#10;    THEN &apos;ge-service&apos;&#10;ELSEIF STARTSWITH([task_id], &apos;great_expectations&apos;)&#10;    THEN &apos;ge-all-others&apos;&#10;ELSEIF [dag_id] = &apos;curated-data-v3&apos; OR [dag_id] = &apos;curated-data-service-cl&apos; // Service&#10;    THEN &apos;cl-service&apos;&#10;ELSEIF STARTSWITH([dag_id], &apos;curated-data-common&apos;)&#10;    THEN &apos;cl&apos;&#10;ELSEIF STARTSWITH([dag_id], &apos;curated-data-rider-cl-daily&apos;)&#10;    THEN &apos;cl-rider-daily&apos;&#10;ELSEIF STARTSWITH([dag_id], &apos;curated-data-rider-cl-weekly&apos;)&#10;    THEN &apos;cl-rider-weekly&apos;&#10;ELSEIF STARTSWITH([dag_id], &apos;curated-data-rider-cl&apos;)&#10;    THEN &apos;cl-rider&apos;&#10;ELSEIF STARTSWITH([dag_id], &apos;curated-data-customer-cl-daily&apos;)&#10;    THEN &apos;cl-customer-daily&apos;&#10;ELSEIF STARTSWITH([dag_id], &apos;curated-data-customer-cl-hourly&apos;)&#10;    THEN &apos;cl-customer-hourly&apos;&#10;ELSEIF STARTSWITH([dag_id], &apos;curated-data-customer-cl-weekly&apos;)&#10;    THEN &apos;cl-customer-weekly&apos;&#10;ELSEIF STARTSWITH([dag_id], &apos;curated-data-customer-cl&apos;)&#10;    THEN &apos;cl-customer&apos;&#10;ELSEIF STARTSWITH([dag_id], &apos;curated-data-vendor-cl-daily&apos;)&#10;    THEN &apos;cl-vendor-daily&apos;&#10;ELSEIF STARTSWITH([dag_id], &apos;curated-data-vendor-cl-weekly&apos;)&#10;    THEN &apos;cl-vendor-weekly&apos;&#10;ELSEIF STARTSWITH([dag_id], &apos;curated-data-vendor-cl&apos;)&#10;    THEN &apos;cl-vendor&apos;&#10;ELSEIF STARTSWITH([dag_id], &apos;curated-data-daily&apos;)&#10;    THEN &apos;cl-daily&apos;&#10;ELSEIF STARTSWITH([dag_id], &apos;curated-data-reports-daily&apos;)&#10;    THEN &apos;rl-daily&apos;&#10;ELSEIF STARTSWITH([dag_id], &apos;curated-data-reports&apos;)&#10;    THEN &apos;rl&apos;&#10;ELSEIF [dag_id] = &apos;curated-data-service-reports&apos; // Service RL&#10;    THEN &apos;rl-service&apos;&#10;ELSEIF [dag_id] = &apos;curated-data-service-reports-daily&apos; // Service Daily RL&#10;    THEN &apos;rl-daily-service&apos;&#10;ELSEIF STARTSWITH([dag_id], &apos;curated-data-backfill&apos;)&#10;    THEN &apos;cl-backfill&apos;&#10;ELSEIF STARTSWITH([dag_id], &apos;import-&apos;)&#10;    THEN &apos;import&apos;&#10;ELSEIF STARTSWITH([dag_id], &apos;curated-data-&apos;)&#10;    THEN &apos;cl-others&apos;&#10;ELSE &apos;x-others&apos;    &#10;END' />
        </column>
        <column caption='Date (Relative)' datatype='date' name='[Calculation_3387340263978442753]' role='dimension' type='ordinal'>
          <calculation class='tableau' formula='[created_date]' />
        </column>
        <column caption='Created Date' datatype='date' name='[created_date]' role='dimension' type='ordinal' />
        <column caption='Dag Id' datatype='string' name='[dag_id]' role='dimension' type='nominal' />
        <column-instance column='[Calculation_3387340263885512704]' derivation='None' name='[none:Calculation_3387340263885512704:nk]' pivot='key' type='nominal' />
        <column-instance column='[Calculation_3387340263978442753]' derivation='None' name='[none:Calculation_3387340263978442753:qk]' pivot='key' type='quantitative' />
