              </aliases>
            </column>
            <column alias='Region' caption='Dimension 1' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;region&quot;'>
              <calculation class='tableau' formula='&quot;region&quot;' />
              <aliases>
                <alias key='&quot;category&quot;' value='CR Level 1' />
                <alias key='&quot;country_name&quot;' value='Country' />
                <alias key='&quot;delivery_stage&quot;' value='Delivery Stage' />
                <alias key='&quot;distance&quot;' value='Dropoff Distance' />
                <alias key='&quot;entity_id&quot;' value='Entity Id' />
                <alias key='&quot;is_cod_order&quot;' value='Is COD Order' />
                <alias key='&quot;is_preorder&quot;' value='Is Preorder' />
                <alias key='&quot;is_split_order&quot;' value='Is Split Order' />
                <alias key='&quot;leaf_cr&quot;' value='HelpCenter CR' />
                <alias key='&quot;region&quot;' value='Region' />
                <alias key='&quot;sub_category&quot;' value='CR Level 2' />
                <alias key='&quot;tenure&quot;' value='Rider Tenure' />
                <alias key='&quot;vertical_type&quot;' value='Vertical' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0zewfuw1m2cf8h1afz4qx17a9708'>
            <column caption='% Contacts (Dimension 1)' datatype='real' default-format='p0.0%' name='[% Contacts (copy)_2092836882642792453]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([contacts]) / SUM({EXCLUDE [Selected Dimension 1 (copy)_1118863089190780935]: SUM([contacts])})' />
            </column>
            <column caption='RCR' datatype='real' default-format='p0.00%' name='[Calculation_1118863087065210880]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [chat_type] = &apos;agent_chats&apos; THEN [contacts] ELSE 0 END)&#10;/ SUM(IF [chat_type] = &apos;agent_chats&apos; THEN [gross_orders] ELSE 0 END)' />
            </column>
            <column caption='Dimension 1' datatype='string' name='[Calculation_1118863087066607618]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;region&apos; THEN [region]&#10;WHEN &apos;country_name&apos; THEN [country_name]&#10;WHEN &apos;entity_id&apos; THEN [entity_id]&#10;WHEN &apos;is_preorder&apos; THEN STR([is_preorder])&#10;WHEN &apos;is_split_order&apos; THEN STR([is_split_order])&#10;WHEN &apos;is_cod_order&apos; THEN STR([is_cod_order])&#10;WHEN &apos;delivery_stage&apos; THEN [delivery_stage]&#10;WHEN &apos;tenure&apos; THEN STR([tenure_in_years]) + &apos; years&apos;&#10;WHEN &apos;distance&apos; THEN [distance_sizing]&#10;WHEN &apos;vertical_type&apos; THEN [vertical_type]&#10;WHEN &apos;category&apos; THEN [category]&#10;WHEN &apos;sub_category&apos; THEN [sub_category]&#10;WHEN &apos;leaf_cr&apos; THEN [leaf_cr]&#10;WHEN &apos;None&apos; THEN &apos;&apos;&#10;END' />
            </column>
            <column caption='Handling Time (min)' datatype='real' name='[Calculation_1118863089799917577]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([handling_time_secs])&#10;/&#10;SUM(IF [chat_type] = &apos;agent_chats&apos; THEN [contacts] ELSE 0 END)&#10;/ 60' />
            </column>
            <column caption='Dropoff distance' datatype='string' name='[Calculation_4862128443431522304]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [distance_sizing]&#10;WHEN &apos;big distance&apos; THEN &apos;(1) top 25%&apos;&#10;WHEN &apos;normal distance&apos; THEN &apos;(2) normal distance (rest)&apos;&#10;WHEN &apos;small distance&apos; THEN &apos;(3) bottom 25%&apos;&#10;WHEN &apos;no data&apos; THEN &apos;(4) no data&apos;&#10;END' />
            </column>
            <column caption='Customer chats per order' datatype='real' default-format='p0.00%' name='[RCR (Agent) (copy)_1118863087328481284]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [chat_type] = &apos;customer_chats&apos; THEN [contacts] ELSE 0 END)&#10;/ SUM(IF [chat_type] = &apos;customer_chats&apos; THEN [gross_orders] ELSE 0 END)' />
            </column>
            <column caption='Dimension 2' datatype='string' name='[Selected Dimension 1 (copy)_1118863089190780935]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Dimension 1 (copy)_1118863089190567942]&#10;WHEN &apos;region&apos; THEN [region]&#10;WHEN &apos;country_name&apos; THEN [country_name]&#10;WHEN &apos;entity_id&apos; THEN [entity_id]&#10;WHEN &apos;is_preorder&apos; THEN STR([is_preorder])&#10;WHEN &apos;is_split_order&apos; THEN STR([is_split_order])&#10;WHEN &apos;is_cod_order&apos; THEN STR([is_cod_order])&#10;WHEN &apos;delivery_stage&apos; THEN [delivery_stage]&#10;WHEN &apos;tenure&apos; THEN STR([tenure_in_years]) + &apos; years&apos;&#10;WHEN &apos;distance&apos; THEN [Calculation_4862128443431522304]&#10;WHEN &apos;vertical_type&apos; THEN [vertical_type]&#10;WHEN &apos;category&apos; THEN [category]&#10;WHEN &apos;sub_category&apos; THEN [sub_category]&#10;WHEN &apos;leaf_cr&apos; THEN [leaf_cr]&#10;WHEN &apos;None&apos; THEN &apos;&apos;&#10;END' />
            </column>
            <column caption='Brand Name' datatype='string' name='[brand_name]' role='dimension' type='nominal' />
