              <calculation class='tableau' formula='SUM(IF [chat_type] = &apos;agent_chats&apos; THEN [contacts] ELSE 0 END)&#10;/ SUM(IF [chat_type] = &apos;agent_chats&apos; THEN [gross_orders] ELSE 0 END)' />
