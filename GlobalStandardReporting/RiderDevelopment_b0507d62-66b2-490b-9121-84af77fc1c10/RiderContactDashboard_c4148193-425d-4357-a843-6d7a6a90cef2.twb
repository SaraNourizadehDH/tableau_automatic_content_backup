            <column caption='Selected time granularity' datatype='string' name='[Calculation_1118863089856024592]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &apos;quarter&apos; THEN [report_quarter]&#10;    WHEN &apos;month&apos; THEN [report_month]&#10;    WHEN &apos;week&apos; THEN [report_week]&#10;    WHEN &apos;day&apos; THEN STR([report_date])&#10;END' />
