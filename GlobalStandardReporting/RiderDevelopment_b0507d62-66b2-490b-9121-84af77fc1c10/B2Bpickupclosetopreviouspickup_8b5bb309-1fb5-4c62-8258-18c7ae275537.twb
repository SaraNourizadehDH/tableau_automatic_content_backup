            <column caption='At Vendor Time cleaned (min)' datatype='real' name='[At Vendor Time (min) (copy)_4763682549947293768]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([at_vendor_time_cleaned])/60) / count([at_vendor_time_cleaned])' />
