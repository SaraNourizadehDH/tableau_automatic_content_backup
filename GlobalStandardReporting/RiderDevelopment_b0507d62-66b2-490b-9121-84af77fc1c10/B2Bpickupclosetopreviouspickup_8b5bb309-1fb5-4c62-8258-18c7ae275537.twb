      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_FE1CA7A2CAF84B71A9FB1E564BBEE1E2'>
            <properties context=''>
              <relation connection='bigquery.1j32a6b0zgp0qb1b1usvy17ex614' name='Custom SQL Query' type='text'>WITH deliveries AS (
  SELECT order_id
    , d.rider_id 
    , d.id AS delivery_id
    , d.is_back_to_back
    , d.pickup
    , DATE(COALESCE(d.rider_dropped_off_at, d.created_at), o.timezone) AS report_date
    --, d.created_at
    --, d.rider_notified_at
    --, d.rider_accepted_at
    --, d.rider_dropped_off_at
    , IF(d.stacked_deliveries &gt;&gt; 0, TRUE, FALSE) is_stacked_delivery
    , d.delivery_status
    , IF(is_preorder IS FALSE AND d.delivery_status = &apos;completed&apos;, d.timings.actual_delivery_time, NULL) AS actual_delivery_time_secs
    , IF(rider_near_restaurant_at IS NOT NULL, d.timings.to_vendor_time, NULL) AS to_vendor_time
    , IF(rider_near_restaurant_at IS NOT NULL, d.timings.at_vendor_time, NULL) AS at_vendor_time
    , IF(rider_near_restaurant_at IS NOT NULL, d.timings.at_vendor_time_cleaned, NULL) AS at_vendor_time_cleaned
    , d.timings.rider_late AS rider_late
    , IF(rider_near_customer_at IS NOT NULL, d.timings.to_customer_time, NULL) AS to_customer_time
    , IF(d.delivery_status = &apos;completed&apos; AND is_preorder = FALSE, (o.timings.actual_delivery_time - o.timings.promised_delivery_time), NULL) AS order_late
    , LAG(d.id) OVER (PARTITION BY o.country_code, d.rider_id ORDER BY d.rider_notified_at) AS prev_delivery_id
    , LAG(d.is_back_to_back) OVER (PARTITION BY o.country_code, d.rider_id ORDER BY d.rider_notified_at) AS prev_is_back_to_back
    , LAG(d.pickup) OVER (PARTITION BY o.country_code, d.rider_id ORDER BY d.rider_notified_at) AS prev_pickup
    , LAG(is_preorder) OVER (PARTITION BY o.country_code, d.rider_id ORDER BY d.rider_notified_at) AS prev_is_preorder
    , LAG(d.delivery_status) OVER (PARTITION BY o.country_code, d.rider_id ORDER BY d.rider_notified_at) AS prev_delivery_status
    , LAG(o.timings.actual_delivery_time) OVER (PARTITION BY o.country_code, d.rider_id ORDER BY d.rider_notified_at) AS prev_actual_delivery_time
    , d.stacked_deliveries_details
    , is_primary
  FROM `fulfillment-dwh-production.cl.orders` o
  LEFT JOIN UNNEST (deliveries) d
  WHERE o.created_date &gt;&gt;= &quot;2025-08-01&quot;
    AND o.country_code = &apos;gv-md&apos;
), find_distance AS (
SELECT d.*
  -- distance in meters
  , ST_DISTANCE(d.pickup, d.prev_pickup) AS distance_between_pickups
  , IF(prev_delivery_id IN UNNEST (d.stacked_deliveries_details.delivery_id), TRUE, FALSE) AS  is_stacked_with_back_to_back
  , IF(prev_is_preorder IS FALSE AND d.prev_delivery_status = &apos;completed&apos;, d.prev_actual_delivery_time, NULL) AS prev_actual_delivery_time_secs
FROM deliveries d
WHERE report_date BETWEEN &quot;2025-08-04&quot; AND &quot;2025-08-17&quot;
  AND is_primary
--ORDER BY 2, 8
)
SELECT *
  , CASE
        WHEN distance_between_pickups = 0 THEN &apos;0&apos; -- hardcoding baseline as 60
        WHEN distance_between_pickups &gt;&gt;= 4000 THEN &apos;[4000,[&apos; 
        ELSE &apos;[&apos; || CAST(FLOOR(distance_between_pickups / 400) * 400 AS STRING) || &apos;,&apos; || CAST(FLOOR(distance_between_pickups / 400) * 400 + 400 AS STRING) || &apos;[&apos; -- and, bins of 400m in between
      END AS distance_between_pickups_bucket
FROM find_distance</relation>
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='b2b_distance_between_pickups_v2' inline='true' name='federated.1vtoyqu1k36bgv16u0gdv1gz614g' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0m0ux0q0b0lfi21aw013y0kn1nav'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='log-data-science-staging' authentication='yes' class='bigquery' connection-dialect='google-sql' project='DataHub Production' schema='cl' server='' server-oauth='server-custom' username='grecia.diaz@deliveryhero.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0m0ux0q0b0lfi21aw013y0kn1nav' name='Custom SQL Query' type='text'>WITH deliveries_raw AS (
  SELECT o.country_code
    , d.rider_id
    , d.id AS delivery_id
    , DATE(COALESCE(d.rider_dropped_off_at, d.created_at), o.timezone) AS report_date
    , d.rider_accepted_at
    , d.is_back_to_back
    , d.rider_picked_up_at
    , d.rider_dropped_off_at
    , d.rider_notified_at
    , IF(is_preorder IS FALSE AND d.delivery_status = &apos;completed&apos;, d.timings.actual_delivery_time, NULL) AS actual_delivery_time_secs
    , IF(rider_near_restaurant_at IS NOT NULL, d.timings.to_vendor_time, NULL) AS to_vendor_time
    , IF(rider_near_restaurant_at IS NOT NULL, d.timings.at_vendor_time, NULL) AS at_vendor_time
    , IF(rider_near_restaurant_at IS NOT NULL, d.timings.at_vendor_time_cleaned, NULL) AS at_vendor_time_cleaned
    , d.timings.rider_late AS rider_late
    , IF(rider_near_customer_at IS NOT NULL, d.timings.to_customer_time, NULL) AS to_customer_time
    , IF(d.delivery_status = &apos;completed&apos; AND is_preorder = FALSE, (o.timings.actual_delivery_time - o.timings.promised_delivery_time), NULL) AS order_late
    , (SELECT MIN(created_at) FROM UNNEST(d.transitions) WHERE state = &apos;cancelled&apos;) AS delivery_cancelled_at
    , d.pickup
    , d.is_primary
    , d.delivery_status
    , IF(d.stacked_deliveries &gt;&gt; 0, TRUE, FALSE) is_stacked_delivery
    , d.stacked_deliveries_details
  FROM `fulfillment-dwh-production.cl.orders` o
  LEFT JOIN UNNEST(deliveries) d
  WHERE created_date BETWEEN &apos;2025-08-01&apos; AND &apos;2025-08-18&apos;
    AND o.country_code = &apos;gv-md&apos;
), b2b_deliveries AS (
  SELECT b.country_code
    , b.rider_id
    , b.report_date
    , b.delivery_id AS b2b_delivery_id
    , d.delivery_id AS current_delivery_id
    , b.actual_delivery_time_secs AS b2b_delivery_time_secs
    , d.actual_delivery_time_secs AS current_delivery_time_secs
    , b.to_vendor_time
    , b.at_vendor_time
    , b.at_vendor_time_cleaned
    , b.rider_late
    , b.to_customer_time
    , b.order_late
    , ST_DISTANCE(d.pickup, b.pickup) AS distance_between_pickups
    , IF(d.delivery_id IN UNNEST (b.stacked_deliveries_details.delivery_id), TRUE, FALSE) AS  is_stacked_with_back_to_back
    , b.delivery_status
    , b.is_stacked_delivery
  FROM deliveries_raw b
  LEFT JOIN deliveries_raw d ON d.country_code = b.country_code
    AND d.rider_id = b.rider_id
    AND b.rider_accepted_at BETWEEN d.rider_picked_up_at AND COALESCE(d.rider_dropped_off_at, d.delivery_cancelled_at)
  WHERE b.is_back_to_back
    AND b.report_date BETWEEN &apos;2025-08-04&apos; AND &apos;2025-08-17&apos;
    AND b.is_primary
  -- there are cases wherre the b2b order is notified between 2 deliveries, in that case take the first one to avoid duplication
  QUALIFY ROW_NUMBER() OVER (PARTITION BY b.country_code, b.delivery_id, b.rider_id ORDER BY d.rider_picked_up_at ASC) = 1
)
SELECT *
    , CASE
        WHEN distance_between_pickups = 0 THEN &apos;0&apos; -- hardcoding baseline as 60
        WHEN distance_between_pickups &gt;&gt;= 4000 THEN &apos;[4000,[&apos; 
        ELSE &apos;[&apos; || CAST(FLOOR(distance_between_pickups / 200) * 200 AS STRING) || &apos;,&apos; || CAST(FLOOR(distance_between_pickups / 200) * 200 + 200 AS STRING) || &apos;[&apos; -- and, bins of 400m in between
      END AS distance_between_pickups_bucket
FROM b2b_deliveries b
WHERE current_delivery_id IS NOT NULL</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0m0ux0q0b0lfi21aw013y0kn1nav' name='Custom SQL Query' type='text'>WITH deliveries_raw AS (
  SELECT o.country_code
    , d.rider_id
    , d.id AS delivery_id
    , DATE(COALESCE(d.rider_dropped_off_at, d.created_at), o.timezone) AS report_date
    , d.rider_accepted_at
    , d.is_back_to_back
    , d.rider_picked_up_at
    , d.rider_dropped_off_at
    , d.rider_notified_at
    , IF(is_preorder IS FALSE AND d.delivery_status = &apos;completed&apos;, d.timings.actual_delivery_time, NULL) AS actual_delivery_time_secs
    , IF(rider_near_restaurant_at IS NOT NULL, d.timings.to_vendor_time, NULL) AS to_vendor_time
    , IF(rider_near_restaurant_at IS NOT NULL, d.timings.at_vendor_time, NULL) AS at_vendor_time
    , IF(rider_near_restaurant_at IS NOT NULL, d.timings.at_vendor_time_cleaned, NULL) AS at_vendor_time_cleaned
    , d.timings.rider_late AS rider_late
    , IF(rider_near_customer_at IS NOT NULL, d.timings.to_customer_time, NULL) AS to_customer_time
    , IF(d.delivery_status = &apos;completed&apos; AND is_preorder = FALSE, (o.timings.actual_delivery_time - o.timings.promised_delivery_time), NULL) AS order_late
    , (SELECT MIN(created_at) FROM UNNEST(d.transitions) WHERE state = &apos;cancelled&apos;) AS delivery_cancelled_at
    , d.pickup
    , d.is_primary
    , d.delivery_status
    , IF(d.stacked_deliveries &gt;&gt; 0, TRUE, FALSE) is_stacked_delivery
    , d.stacked_deliveries_details
  FROM `fulfillment-dwh-production.cl.orders` o
  LEFT JOIN UNNEST(deliveries) d
  WHERE created_date BETWEEN &apos;2025-08-01&apos; AND &apos;2025-08-18&apos;
    AND o.country_code = &apos;gv-md&apos;
), b2b_deliveries AS (
  SELECT b.country_code
    , b.rider_id
    , b.report_date
    , b.delivery_id AS b2b_delivery_id
    , d.delivery_id AS current_delivery_id
    , b.actual_delivery_time_secs AS b2b_delivery_time_secs
    , d.actual_delivery_time_secs AS current_delivery_time_secs
    , b.to_vendor_time
    , b.at_vendor_time
    , b.at_vendor_time_cleaned
    , b.rider_late
    , b.to_customer_time
    , b.order_late
    , ST_DISTANCE(d.pickup, b.pickup) AS distance_between_pickups
    , IF(d.delivery_id IN UNNEST (b.stacked_deliveries_details.delivery_id), TRUE, FALSE) AS  is_stacked_with_back_to_back
    , b.delivery_status
    , b.is_stacked_delivery
  FROM deliveries_raw b
  LEFT JOIN deliveries_raw d ON d.country_code = b.country_code
    AND d.rider_id = b.rider_id
    AND b.rider_accepted_at BETWEEN d.rider_picked_up_at AND COALESCE(d.rider_dropped_off_at, d.delivery_cancelled_at)
  WHERE b.is_back_to_back
    AND b.report_date BETWEEN &apos;2025-08-04&apos; AND &apos;2025-08-17&apos;
    AND b.is_primary
  -- there are cases wherre the b2b order is notified between 2 deliveries, in that case take the first one to avoid duplication
  QUALIFY ROW_NUMBER() OVER (PARTITION BY b.country_code, b.delivery_id, b.rider_id ORDER BY d.rider_picked_up_at ASC) = 1
)
SELECT *
    , CASE
        WHEN distance_between_pickups = 0 THEN &apos;0&apos; -- hardcoding baseline as 60
        WHEN distance_between_pickups &gt;&gt;= 4000 THEN &apos;[4000,[&apos; 
        ELSE &apos;[&apos; || CAST(FLOOR(distance_between_pickups / 200) * 200 AS STRING) || &apos;,&apos; || CAST(FLOOR(distance_between_pickups / 200) * 200 + 200 AS STRING) || &apos;[&apos; -- and, bins of 400m in between
      END AS distance_between_pickups_bucket
FROM b2b_deliveries b
WHERE current_delivery_id IS NOT NULL</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
