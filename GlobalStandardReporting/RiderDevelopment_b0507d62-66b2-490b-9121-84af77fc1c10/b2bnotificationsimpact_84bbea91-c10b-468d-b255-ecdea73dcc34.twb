      <aliases enabled='yes' />
      <column caption='Hold Back Time' datatype='real' name='[Calculation_1806576808798195712]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([hold_back_time_n]) / SUM([hold_back_time_d])' />
      </column>
      <column caption='% Vendor Late (over 10)' datatype='real' default-format='p0.00%' name='[Calculation_1806576808828424196]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendor_late_n]) / SUM([vendor_late_d])' />
      </column>
      <column caption='Created to First Dispatched' datatype='real' name='[Calculation_1806576808828981253]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([created_to_first_dispatched_time_n]) &#10;&#10;/ SUM([created_to_first_dispatched_time_d])' />
      </column>
      <column caption='At Vendor Time' datatype='real' name='[Calculation_1806576808829698054]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([at_vendor_time_mins_n]) / SUM([at_vendor_time_cleaned_mins_d])' />
      </column>
      <column caption='At Vendor Time Cleaned' datatype='real' name='[Calculation_1806576808830189575]' role='measure' type='quantitative'>
