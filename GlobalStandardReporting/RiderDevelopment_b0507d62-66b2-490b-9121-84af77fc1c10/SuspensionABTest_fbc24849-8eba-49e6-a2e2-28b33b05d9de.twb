      <aliases enabled='yes' />
      <column caption='Suspension Lifting Time (h)' datatype='real' name='[Calculation_2423781081625919489]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([time_to_lift_suspension_sum]) / SUM([time_to_lift_suspension_count])' />
      </column>
      <column caption='% Open Suspensions' datatype='real' default-format='p0.00%' name='[Calculation_324962911726264320]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([suspensions_started])/SUM([suspensions])' />
      </column>
      <column caption='Unique Riders' datatype='integer' name='[Calculation_3726799097042132992]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_910008641616252929])' />
      </column>
      <column caption='Total Shifts Missed' datatype='integer' name='[Calculation_3726799097067331585]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[shifts_missed] + [upcoming_shifts]' />
      </column>
      <column caption='Rider_Country' datatype='string' name='[Calculation_910008641616252929]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([rider_id])+STR([country_code])' />
      </column>
