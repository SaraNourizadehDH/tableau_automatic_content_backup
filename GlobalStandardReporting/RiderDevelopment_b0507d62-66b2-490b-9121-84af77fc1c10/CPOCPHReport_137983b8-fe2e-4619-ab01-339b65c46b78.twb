      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Migrated Data' id='Migrated Data'>
            <properties context=''>
              <relation join='inner' type='join'>
                <clause type='join'>
                  <expression op='='>
                    <expression op='[Custom SQL Query].[country_code]' />
                    <expression op='[_tableau_country_user_entitlements].[country_code]' />
                  </expression>
                </clause>
                <relation connection='bigquery.0dgbct21ebsk1315l22ic0j9f07u' name='Custom SQL Query' type='text'>WITH cpo_cph_utr AS (&#13;
SELECT `payment_report`.`region` AS `region`,&#13;
  `payment_report`.`city_name` AS `city_name`,&#13;
  `payment_report`.`country_name` AS `country_name`,&#13;
  `payment_report`.`country_code` AS `country_code`,&#13;
  `payment_report`.`rider_id` AS `rider_id`,&#13;
  `payment_report`.`report_date_local` AS `report_date_local`,&#13;
  `payment_report`.`basic_total` AS `basic_total`,&#13;
  `payment_report`.`quest_total` AS `quest_total`,&#13;
  `payment_report`.`scoring_total` AS `scoring_total`,&#13;
  `payment_report`.`batch_number` AS `batch_number`,&#13;
  `payment_report`.`deliveries` AS `deliveries`,&#13;
  `payment_report`.`working_hours` AS `working_hours`,&#13;
  `payment_report`.`UTR` AS `UTR`,&#13;
  `payment_report`.`pickup_distance` AS `pickup_distance`,&#13;
  `payment_report`.`dropoff_distance` AS `dropoff_distance`,&#13;
  `payment_report`.`acceptance_rate` AS `acceptance_rate`,&#13;
  `payment_report`.`contract_name` AS `contract_name`,&#13;
  `payment_report`.`contract_type` AS `contract_type`,&#13;
  `payment_report`.`vehicle_name` AS `vehicle_name`,&#13;
  `payment_report`.`zone_name` AS `zone_name`,&#13;
  `payment_report`.`exchange_rate` AS `exchange_rate`,&#13;
FROM `fulfillment-dwh-production.rl.payment_report` `payment_report`&#13;
WHERE report_date_local &gt;&gt;= DATE_SUB(CURRENT_DATE, INTERVAL 8 WEEK)&#13;
), group_utr AS (&#13;
SELECT region&#13;
  , FORMAT_DATE(&quot;%G-%V&quot;,report_date_local) AS report_week&#13;
  , country_name&#13;
  , country_code&#13;
  , city_name&#13;
  , zone_name&#13;
  , contract_type&#13;
  , contract_name&#13;
  , vehicle_name&#13;
  , SUM(pickup_distance) AS pickup_distance_sum&#13;
  , COUNT(pickup_distance) AS pickup_distance_count&#13;
  , SUM(dropoff_distance) AS dropoff_distance_sum&#13;
  , COUNT(dropoff_distance) AS dropoff_distance_count&#13;
  , SUM(acceptance_rate) AS acceptance_rate_sum&#13;
  , COUNT(acceptance_rate) AS acceptance_rate_count&#13;
  , SUM(basic_total) AS basic_total &#13;
  , SUM(quest_total) AS quest_total&#13;
  , SUM(scoring_total) AS scoring_total&#13;
  , SUM(basic_total)/avg(exchange_rate) AS basic_total_eur&#13;
  , SUM(quest_total)/avg(exchange_rate) AS quest_total_eur&#13;
  , SUM(scoring_total)/avg(exchange_rate) AS scoring_total_eur&#13;
  , SUM(deliveries) as deliveries&#13;
  , SUM(working_hours) AS working_hours&#13;
FROM cpo_cph_utr&#13;
GROUP BY 1, 2, 3, 4, 5, 6, 7, 8, 9&#13;
order by 1, 2, 3, 4, 5, 6, 7, 8, 9&#13;
)&#13;
SELECT region&#13;
  , report_week&#13;
  , country_name&#13;
  , country_code&#13;
  , city_name&#13;
  , zone_name&#13;
  , contract_name&#13;
  , contract_type&#13;
  , vehicle_name&#13;
  , ROUND(SAFE_DIVIDE(SUM(pickup_distance_sum), SUM(pickup_distance_count)), 1) AS pickup_distance&#13;
  , ROUND(SAFE_DIVIDE(SUM(dropoff_distance_sum), SUM(dropoff_distance_count)), 1) AS dropoff_distance&#13;
  , ROUND(SAFE_DIVIDE(SUM(acceptance_rate_sum), SUM(acceptance_rate_count)), 1) AS acceptance_rate&#13;
  , ROUND(SAFE_DIVIDE(SUM(deliveries), SUM(working_hours)), 1) AS utr&#13;
  , ROUND(SAFE_DIVIDE(CAST((SUM(basic_total) + SUM(quest_total) + SUM(scoring_total)) AS INT64) , (SUM(deliveries))), 0) AS CPO&#13;
  , ROUND(SAFE_DIVIDE(CAST((SUM(basic_total) + SUM(quest_total) + SUM(scoring_total)) AS INT64) , (SUM(working_hours))), 0) AS CPH&#13;
  , ROUND(SAFE_DIVIDE(CAST((SUM(basic_total_eur) + SUM(quest_total_eur) + SUM(scoring_total_eur)) AS INT64) , (SUM(deliveries))), 0) AS CPO_eur&#13;
  , ROUND(SAFE_DIVIDE(CAST((SUM(basic_total_eur) + SUM(quest_total_eur) + SUM(scoring_total_eur)) AS INT64) , (SUM(working_hours))), 0) AS CPH_eur&#13;
FROM group_utr&#13;
GROUP BY 1, 2, 3, 4, 5, 6, 7, 8, 9</relation>
                <relation connection='bigquery.0dgbct21ebsk1315l22ic0j9f07u' name='_tableau_country_user_entitlements' table='[fulfillment-dwh-production.cl].[_tableau_country_user_entitlements]' type='table' />
              </relation>
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
