    <dashboard name='Notes'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/CPOCPHReport/Notes?rev=' id='Notes' path='/t/GlobalStandardReporting/workbooks/CPOCPHReport' revision='' site='GlobalStandardReporting' />
      <style />
      <size sizing-mode='automatic' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='3909' id='3' type-v2='empty' w='49518' x='49999' y='929'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='39280' id='5' type-v2='text' w='99034' x='483' y='4838'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontname='Calibri' fontsize='15'>Notes on the use of the dashboard</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontname='Calibri' fontsize='12'>The  payment report has the purpose of showing the CPO and CPH with various levels of granularity.</run>
              <run>Æ&#10;&#10;&#10;&#10;</run>
              <run fontcolor='#000000' fontname='Calibri' fontsize='12'>Relevant points on the logic used: </run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Calibri' fontsize='12'>☞  CPO</run>
              <run fontname='Calibri' fontsize='12'>: Cost per order. This is obtained by dividing all costs within the paid period selected by all sucessfull deliveries within the same period.</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Calibri' fontsize='12'>☞  CPH</run>
              <run fontname='Calibri' fontsize='12'>: Cost per hour.  This is obtained by dividing all costs within the paid period selected by all hours worked  within the same period.</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Calibri' fontsize='12'>☞ Basic</run>
              <run fontname='Calibri' fontsize='12'>: The basic payment (deliveries, hours, distances) is calculated daily by rooster so the report date represents the effective date when the payment is executed. </run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Calibri' fontsize='12'>☞  Quest</run>
              <run fontname='Calibri' fontsize='12'>: Contrary to basic, quest payments (payment on reached  goals) are based on payment cycles, thus they are not daily calculated. However, we split them on a daily basis by checking all the days within the period when deliveries (for CPO) or hours (for CPH) happened. We then equally distribute the cost across the past days of the cycle. </run>
              <run>Æ&#10;&#10;</run>
              <run fontname='Calibri' fontsize='12'>EG: cycle start: 2020-01-01 </run>
              <run>Æ&#10;</run>
              <run fontname='Calibri' fontsize='12'>        cycle end: 2020-01-10 </run>
              <run>Æ&#10;</run>
              <run fontname='Calibri' fontsize='12'>        payment date: 2020-01-11</run>
              <run>Æ&#10;</run>
              <run fontname='Calibri' fontsize='12'>        amount: 100 </run>
              <run>Æ&#10;</run>
              <run fontname='Calibri' fontsize='12'>Costs = ( 100 / 10) = 10 per day from  2020-01-01  to  2020-01-10 </run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Calibri' fontsize='12'>☞  Scoring</run>
              <run fontname='Calibri' fontsize='12'>: Same logic Basic.</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#c84d4f' fontname='Calibri' fontsize='14'>IMPORTANT</run>
              <run fontcolor='#000000' fontname='Calibri' fontsize='12'>:  At current state report is in local currency, thus user should not select multiple countries due to different currency. </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Calibri' fontsize='12'>Please rely on info only from live dates </run>
              <run auto-url='true' fontcolor='#0000ff' fontname='Benton Sans Book' fontsize='12' hyperlink='tabdoc:load-url url=&amp;quot;https://product.deliveryhero.net/global-logistics/documentation/payment-roll-outs/&amp;quot;' underline='true'>https://product.deliveryhero.net/global-logistics/documentation/payment-roll-outs/</run>
              <run>Æ&#10;&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone h='3909' id='6' is-centered='0' is-scaled='1' param='Image/DH logo standard 1.png' type-v2='bitmap' w='49516' x='483' y='929'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone h='54953' id='9' type-v2='empty' w='99034' x='483' y='44118'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='265' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='84000' id='264' param='vert' type-v2='layout-flow' w='84000' x='8000' y='8000'>
                <zone fixed-size='24' h='3909' id='6' is-centered='0' is-fixed='true' is-scaled='1' param='Image/DH logo standard 1.png' type-v2='bitmap' w='49516' x='483' y='929'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='39280' id='5' type-v2='text' w='99034' x='483' y='4838'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontname='Calibri' fontsize='15'>Notes on the use of the dashboard</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#000000' fontname='Calibri' fontsize='12'>The  payment report has the purpose of showing the CPO and CPH with various levels of granularity.</run>
                    <run>Æ&#10;&#10;&#10;&#10;</run>
                    <run fontcolor='#000000' fontname='Calibri' fontsize='12'>Relevant points on the logic used: </run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Calibri' fontsize='12'>☞  CPO</run>
                    <run fontname='Calibri' fontsize='12'>: Cost per order. This is obtained by dividing all costs within the paid period selected by all sucessfull deliveries within the same period.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Calibri' fontsize='12'>☞  CPH</run>
                    <run fontname='Calibri' fontsize='12'>: Cost per hour.  This is obtained by dividing all costs within the paid period selected by all hours worked  within the same period.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Calibri' fontsize='12'>☞ Basic</run>
                    <run fontname='Calibri' fontsize='12'>: The basic payment (deliveries, hours, distances) is calculated daily by rooster so the report date represents the effective date when the payment is executed. </run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Calibri' fontsize='12'>☞  Quest</run>
                    <run fontname='Calibri' fontsize='12'>: Contrary to basic, quest payments (payment on reached  goals) are based on payment cycles, thus they are not daily calculated. However, we split them on a daily basis by checking all the days within the period when deliveries (for CPO) or hours (for CPH) happened. We then equally distribute the cost across the past days of the cycle. </run>
                    <run>Æ&#10;&#10;</run>
                    <run fontname='Calibri' fontsize='12'>EG: cycle start: 2020-01-01 </run>
                    <run>Æ&#10;</run>
                    <run fontname='Calibri' fontsize='12'>        cycle end: 2020-01-10 </run>
                    <run>Æ&#10;</run>
                    <run fontname='Calibri' fontsize='12'>        payment date: 2020-01-11</run>
                    <run>Æ&#10;</run>
                    <run fontname='Calibri' fontsize='12'>        amount: 100 </run>
                    <run>Æ&#10;</run>
                    <run fontname='Calibri' fontsize='12'>Costs = ( 100 / 10) = 10 per day from  2020-01-01  to  2020-01-10 </run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Calibri' fontsize='12'>☞  Scoring</run>
                    <run fontname='Calibri' fontsize='12'>: Same logic Basic.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#c84d4f' fontname='Calibri' fontsize='14'>IMPORTANT</run>
                    <run fontcolor='#000000' fontname='Calibri' fontsize='12'>:  At current state report is in local currency, thus user should not select multiple countries due to different currency. </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Calibri' fontsize='12'>Please rely on info only from live dates </run>
                    <run auto-url='true' fontcolor='#0000ff' fontname='Benton Sans Book' fontsize='12' hyperlink='tabdoc:load-url url=&amp;quot;https://product.deliveryhero.net/global-logistics/documentation/payment-roll-outs/&amp;quot;' underline='true'>https://product.deliveryhero.net/global-logistics/documentation/payment-roll-outs/</run>
                    <run>Æ&#10;&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
      <simple-id uuid='{AE2A9408-7627-49BD-A02B-4F62D7E9EBC5}' />
    </dashboard>
