      <table>
        <view>
          <datasources>
            <datasource caption='payment_report' name='federated.03ocvls0qkz7ts16h5aoo01p19ij' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Vehicle' caption='Choose x Axis' datatype='integer' name='[Choose x Axis (copy)_1086774902616932352]' param-domain-type='list' role='measure' type='quantitative' value='2'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='1' value='Batch Number' />
                <alias key='2' value='Vehicle' />
              </aliases>
            </column>
            <column alias='Riders' caption='Choose y1 Axis' datatype='integer' name='[Choose y2 Axis  (copy)_1450722067351994369]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='Riders' />
                <alias key='2' value='Deliveries' />
                <alias key='3' value='Working Hours' />
              </aliases>
            </column>
            <column alias='LOCAL CURRENCY' caption='Currency Selector' datatype='integer' name='[Parameter 10]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='0' value='EUR' />
                <alias key='1' value='LOCAL CURRENCY' />
              </aliases>
            </column>
            <column alias='CPO' caption='Choose y2 Axis ' datatype='integer' name='[Parameter 2]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='CPO' />
                <alias key='2' value='CPH' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.03ocvls0qkz7ts16h5aoo01p19ij'>
            <column caption='# Basic EUR ' datatype='real' default-format='n#,##0;-#,##0' name='[# Basic (copy)_833165944340946949]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[basic_total] /   [exchange_rate]' />
            </column>
            <column caption='# Quest EUR' datatype='real' name='[# Quest (copy)_833165944341282822]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[quest_total] / [exchange_rate]' />
            </column>
            <column caption='# Scoring EUR' datatype='real' name='[# Scoring (copy)_833165944341413895]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[scoring_total] / [exchange_rate]' />
            </column>
            <column caption='CPH EUR' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[CPH (copy)_833165944341876747]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([Total Costs (copy)_833165944341676041]) / SUM([working_hours]))' />
            </column>
            <column caption='CPO EUR' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[CPO (copy 2)_833165944341774346]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Total Costs (copy)_833165944341676041]) / SUM([deliveries])' />
            </column>
            <column caption='Batch Number or Vehicle' datatype='string' name='[Calculation_1086774902617305089]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Choose x Axis (copy)_1086774902616932352] &#13;&#10;when 1     THEN          STR([batch_number])&#13;&#10;&#13;&#10;when    2        then             [vehicle_name]  &#13;&#10;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Riders, Deliveries, Working Hours' datatype='real' name='[Calculation_1450722067352813571]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Choose y2 Axis  (copy)_1450722067351994369]&#13;&#10;WHEN 1 THEN COUNTD([rider_id])&#13;&#10;WHEN 2 THEN SUM([deliveries])&#13;&#10;WHEN 3 THEN SUM([working_hours])&#13;&#10;END' />
            </column>
            <column caption='Total Costs' datatype='real' name='[Calculation_1647754579069087744]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[basic_total]+[scoring_total]+[quest_total]' />
            </column>
            <column caption='CPO' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1647754579069231105]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1647754579069087744]) / SUM([deliveries])' />
            </column>
            <column caption='CPH' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1647754580045262851]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([Calculation_1647754579069087744]) / SUM([working_hours]))' />
            </column>
            <column caption='Report Week' datatype='string' name='[Calculation_1647754580089331718]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_week]' />
            </column>
            <column caption='CPO or  CPH' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_2615184015212208129]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2] &#13;&#10;when 1     THEN          [Calculation_833165944343732240]&#13;&#10;when    2        then            [Calculation_833165944342441999]  &#13;&#10;END' />
            </column>
            <column caption='CPH (EUR or Local)' datatype='real' name='[Calculation_833165944342441999]' role='measure' type='quantitative'>
