          <relation connection='bigquery.12s8a9p147cyor196whnn1q4pegc (copy)' name='Custom SQL Query' type='text'>WITH distribution_raw AS (&#13;
SELECT `payment_report`.`region` AS `region`,&#13;
  `payment_report`.`city_name` AS `city_name`,&#13;
  `payment_report`.`country_name` AS `country_name`,&#13;
  `payment_report`.`country_code` AS `country_code`,&#13;
  `payment_report`.`rider_id` AS `rider_id`,&#13;
  `payment_report`.`report_date_local` AS `report_date_local`,&#13;
  `payment_report`.`basic_total` AS `basic_total`,&#13;
  `payment_report`.`quest_total` AS `quest_total`,&#13;
  `payment_report`.`scoring_total` AS `scoring_total`,&#13;
  `payment_report`.`batch_number` AS `batch_number`,&#13;
  `payment_report`.`deliveries` AS `deliveries`,&#13;
  `payment_report`.`working_hours` AS `working_hours`,&#13;
  `payment_report`.`UTR` AS `UTR`, &#13;
  `payment_report`.`vehicle_name` AS `vehicle_name`, &#13;
  &#13;
FROM `fulfillment-dwh-production.rl`.`payment_report_tableau` `payment_report`&#13;
), distribution AS (&#13;
  SELECT region&#13;
    , city_name&#13;
    , country_name&#13;
    , country_code&#13;
    , rider_id&#13;
    , report_date_local&#13;
    , batch_number&#13;
    , vehicle_name&#13;
    , SUM(basic_total) AS basic_total&#13;
    , SUM(quest_total) AS quest_total&#13;
    , SUM(scoring_total) AS scoring_total&#13;
    , SUM(deliveries) AS deliveries&#13;
    , SUM(working_hours) AS working_hours&#13;
  FROM distribution_raw&#13;
  GROUP BY 1, 2, 3, 4, 5, 6, 7, 8&#13;
), group_riders AS (&#13;
&#13;
SELECT &apos;CPO&apos; AS choose_metric&#13;
  , &apos;City&apos; AS choose_dimension&#13;
  , region&#13;
  , FORMAT_DATE(&quot;%G-%V&quot;,report_date_local) AS report_week&#13;
  , country_name&#13;
  , country_code&#13;
  , city_name AS dimension&#13;
  , ROUND(SAFE_DIVIDE(CAST(basic_total AS INT64) + CAST(quest_total AS INT64) + CAST(scoring_total AS INT64) , (deliveries)), 0) AS metric&#13;
  , COUNT(DISTINCT rider_id) AS riders  &#13;
FROM distribution&#13;
GROUP BY 1, 2, 3, 4, 5, 6, 7, 8&#13;
&#13;
UNION ALL &#13;
&#13;
SELECT &apos;CPH&apos; AS choose_metric&#13;
  , &apos;City&apos; AS choose_dimension&#13;
  , region&#13;
  , FORMAT_DATE(&quot;%G-%V&quot;,report_date_local) AS report_week&#13;
  , country_name&#13;
  , country_code&#13;
  , city_name AS dimension&#13;
  , ROUND(SAFE_DIVIDE(CAST((basic_total + quest_total + scoring_total) AS INT64) , (working_hours)), 0) AS metric&#13;
  , COUNT(DISTINCT rider_id) AS riders  &#13;
FROM distribution&#13;
GROUP BY 1, 2, 3, 4, 5, 6, 7, 8&#13;
&#13;
UNION ALL&#13;
&#13;
SELECT &apos;CPO&apos; AS choose_metric&#13;
  , &apos;Vehicle&apos; AS choose_dimension&#13;
  , region&#13;
  , FORMAT_DATE(&quot;%G-%V&quot;,report_date_local) AS report_week&#13;
  , country_name&#13;
  , country_code&#13;
  , vehicle_name AS dimension&#13;
  , ROUND(SAFE_DIVIDE(CAST(basic_total AS INT64) + CAST(quest_total AS INT64) + CAST(scoring_total AS INT64) , (deliveries)), 0) AS metric&#13;
  , COUNT(DISTINCT rider_id) AS riders  &#13;
FROM distribution&#13;
GROUP BY 1, 2, 3, 4, 5, 6, 7, 8&#13;
&#13;
UNION ALL &#13;
&#13;
SELECT &apos;CPH&apos; AS choose_metric&#13;
  , &apos;Vehicle&apos; AS choose_dimension&#13;
  , region&#13;
  , FORMAT_DATE(&quot;%G-%V&quot;,report_date_local) AS report_week&#13;
  , country_name&#13;
  , country_code&#13;
  , vehicle_name AS dimension&#13;
  , ROUND(SAFE_DIVIDE(CAST((basic_total + quest_total + scoring_total) AS INT64) , (working_hours)), 0) AS metric&#13;
  , COUNT(DISTINCT rider_id) AS riders  &#13;
FROM distribution&#13;
GROUP BY 1, 2, 3, 4, 5, 6, 7, 8&#13;
&#13;
UNION ALL&#13;
&#13;
SELECT &apos;CPO&apos; AS choose_metric&#13;
  , &apos;Batch Number&apos; AS choose_dimension&#13;
  , region&#13;
  , FORMAT_DATE(&quot;%G-%V&quot;,report_date_local) AS report_week&#13;
  , country_name&#13;
  , country_code&#13;
  , SAFE_CAST(batch_number AS STRING) AS dimension&#13;
  , ROUND(SAFE_DIVIDE(CAST(basic_total AS INT64) + CAST(quest_total AS INT64) + CAST(scoring_total AS INT64) , (deliveries)), 0) AS metric&#13;
  , COUNT(DISTINCT rider_id) AS riders  &#13;
FROM distribution&#13;
GROUP BY 1, 2, 3, 4, 5, 6, 7, 8&#13;
&#13;
UNION ALL &#13;
&#13;
SELECT &apos;CPH&apos; AS choose_metric&#13;
  , &apos;Batch Number&apos; AS choose_dimension&#13;
  , region&#13;
  , FORMAT_DATE(&quot;%G-%V&quot;,report_date_local) AS report_week&#13;
  , country_name&#13;
  , country_code&#13;
  , SAFE_CAST(batch_number AS STRING) AS dimension&#13;
  , ROUND(SAFE_DIVIDE(CAST((basic_total + quest_total + scoring_total) AS INT64) , (working_hours)), 0) AS metric&#13;
  , COUNT(DISTINCT rider_id) AS riders  &#13;
FROM distribution&#13;
GROUP BY 1, 2, 3, 4, 5, 6, 7, 8&#13;
) &#13;
&#13;
SELECT region&#13;
  , report_week&#13;
  , country_name&#13;
  , country_code&#13;
  , dimension&#13;
  , choose_metric&#13;
  , choose_dimension&#13;
  , metric&#13;
  , (riders) / SUM(riders) OVER (PARTITION BY country_code, dimension, choose_metric, report_week) AS perc_riders&#13;
FROM group_riders&#13;
WHERE metric IS NOT NULL</relation>
