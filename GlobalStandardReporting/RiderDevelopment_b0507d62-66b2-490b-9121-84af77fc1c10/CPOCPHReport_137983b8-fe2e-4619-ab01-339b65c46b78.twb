    <worksheet name='Indexed View CPH'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='12'>CPH Indexed View</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='payment_report' name='federated.03ocvls0qkz7ts16h5aoo01p19ij' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose Time Dimension' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Report Date&quot;'>
              <calculation class='tableau' formula='&quot;Report Date&quot;' />
            </column>
            <column caption='Choose Granularity' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Zone&quot;'>
              <calculation class='tableau' formula='&quot;Zone&quot;' />
            </column>
            <column caption='Reference Period Start' datatype='date' default-format='*dd.mm.yyyy' name='[Parameter 5]' param-domain-type='any' role='measure' type='quantitative' value='#2021-01-29#'>
              <calculation class='tableau' formula='#2021-01-29#' />
            </column>
            <column caption='Reference Period End' datatype='date' default-format='*dd.mm.yyyy' name='[Reference Period Start (copy)_56576484266663940]' param-domain-type='any' role='measure' type='quantitative' value='#2021-02-08#'>
              <calculation class='tableau' formula='#2021-02-08#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.03ocvls0qkz7ts16h5aoo01p19ij'>
            <column caption='Total Costs' datatype='real' name='[Calculation_1647754579069087744]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[basic_total]+[scoring_total]+[quest_total]' />
            </column>
            <column caption='CPH' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1647754580045262851]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([Calculation_1647754579069087744]) / SUM([working_hours]))' />
            </column>
            <column caption='Report Week' datatype='string' name='[Calculation_1647754580089331718]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_week]' />
            </column>
            <column caption='Report Month' datatype='string' name='[Calculation_1647754580089409543]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_month]' />
            </column>
            <column caption='Time Dimension' datatype='string' name='[Calculation_1647754580089847817]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE   [Parameters].[Parameter 1]&#13;&#10;&#13;&#10;WHEN    &apos;Report Date&apos;  THEN     STR([report_date_local])&#13;&#10;&#13;&#10;WHEN  &apos;Report Week&apos; THEN [Calculation_1647754580089331718]&#13;&#10;&#13;&#10;WHEN &apos;Report Month&apos; THEN  [Calculation_1647754580089409543]&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Granularity Legend' datatype='string' name='[Calculation_56576484090228737]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE  [Parameters].[Parameter 4]&#13;&#10;&#13;&#10;WHEN &apos;Region&apos; THEN [region]&#13;&#10;WHEN &apos;Country&apos; THEN [country_name]&#13;&#10;WHEN &apos;City&apos; THEN [city_name]&#13;&#10;WHEN &apos;Contract Type&apos; THEN [contract_type]&#13;&#10;WHEN &apos;Contract Name&apos; THEN [contract_name]&#13;&#10;WHEN &apos;Vehicle&apos; THEN [vehicle_name]&#13;&#10;WHEN &apos;Zone&apos; THEN [zone_name]&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='CPH Perc Variance' datatype='real' name='[Calculation_56576484261421059]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1647754580045262851]/LOOKUP([Calculation_1647754580045262851],FIRST())*100'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Date range' datatype='boolean' name='[Calculation_56576484268126213]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date_local] &gt;= [Parameters].[Parameter 5] AND [report_date_local] &lt;= [Parameters].[Reference Period Start (copy)_56576484266663940]' />
