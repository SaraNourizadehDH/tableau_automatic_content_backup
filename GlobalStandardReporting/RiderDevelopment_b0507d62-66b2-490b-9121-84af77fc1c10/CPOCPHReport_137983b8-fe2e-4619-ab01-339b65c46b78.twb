      <aliases enabled='yes' />
      <column datatype='real' default-format='n#,##0.0;-#,##0.0' name='[CPH]' role='measure' type='quantitative' />
      <column datatype='real' default-format='n#,##0.0;-#,##0.0' name='[CPO]' role='measure' type='quantitative' />
      <column caption='UTR or Distance or Acceptance' datatype='real' name='[Calculation_1972295199608967169]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#13;&#10;&#13;&#10;WHEN 1 THEN [utr]&#13;&#10;WHEN 2 THEN [pickup_distance]&#13;&#10;WHEN 3 THEN [dropoff_distance]&#13;&#10;WHEN  4 THEN  [acceptance_rate]&#13;&#10;WHEN 5 then [Calculation_2133298896152485888]&#13;&#10;END' />
      </column>
      <column aggregation='Sum' caption='Total Distance' datatype='real' name='[Calculation_2133298896152485888]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[pickup_distance] + [dropoff_distance]' />
      </column>
      <column caption='Report Week ' datatype='real' name='[Calculation_2615184014099488768]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='STR(DATEPART(&apos;year&apos;,[Report Date])) + &#13;&#10;&#13;&#10;&quot;-&quot; +    &#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;STR(DATEPART(&apos;week&apos;,[Report Date],&apos;monday&apos;))' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_3188548581101862912]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='CPO (Eur or Local)' datatype='real' name='[Calculation_833165944593793048]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 10]&#13;&#10;&#13;&#10;WHEN 0  THEN [CPO_eur]&#13;&#10;WHEN 1 THEN [CPO]&#13;&#10;END' />
      </column>
      <column caption='CPH (Eur or Local)' datatype='real' name='[Calculation_833165944594042905]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 10]&#13;&#10;&#13;&#10;WHEN 0  THEN [CPH_eur]&#13;&#10;WHEN 1 THEN [CPH]&#13;&#10;END' />
      </column>
      <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
