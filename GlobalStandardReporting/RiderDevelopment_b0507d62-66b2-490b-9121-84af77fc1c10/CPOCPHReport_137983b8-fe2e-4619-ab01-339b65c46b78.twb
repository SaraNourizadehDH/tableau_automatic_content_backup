            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.03ocvls0qkz7ts16h5aoo01p19ij'>
            <column caption='% Riders in Cost Contribution Dimension' datatype='real' default-format='p0.0%' name='[Calculation2]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2218585833287745538] / TOTAL([Calculation_2218585833287745538])'>
                <table-calc ordering-field='[federated.03ocvls0qkz7ts16h5aoo01p19ij].[Calculation_1071293762908565505]' ordering-type='Field' />
              </calculation>
            </column>
            <column caption='Costs Contribution' datatype='string' name='[Calculation_1071293762908565505]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE  [Parameters].[Parameter 8]&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;Country&apos; THEN [country_name]&#13;&#10;WHEN &apos;City&apos; THEN [city_name]&#13;&#10;WHEN &apos;Contract Type&apos; THEN [contract_type]&#13;&#10;WHEN &apos;Contract Name&apos; THEN [contract_name]&#13;&#10;WHEN &apos;Vehicle&apos; THEN [vehicle_name]&#13;&#10;WHEN &apos;Zone&apos; THEN [zone_name]&#13;&#10;WHEN  &apos;Batch&apos; THEN STR([batch_number]&#13;&#10;)&#13;&#10;END' />
            </column>
            <column caption='% Per All Distances' datatype='real' default-format='p0.0%' name='[Calculation_1071293762936500226]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([per_all_distances]) /   SUM([basic_total])' />
            </column>
            <column caption='% Per Completed Deliveries' datatype='real' default-format='p0.0%' name='[Calculation_1071293762936856579]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([per_completed_deliveries]) /   SUM([basic_total])' />
            </column>
            <column caption='% Per Dropoff Distances' datatype='real' default-format='p0.0%' name='[Calculation_1071293762936979460]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([per_dropoff_distances]) /   SUM([basic_total])' />
            </column>
            <column caption='% Per Near Pick Up Deliveries' datatype='real' default-format='p0.0%' name='[Calculation_1071293762937270278]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([per_near_pickup_deliveries]) /   SUM([basic_total])' />
            </column>
            <column caption='% Per Picked Up Deliveries' datatype='real' default-format='p0.0%' name='[Calculation_1071293762937413639]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([per_picked_up_deliveries]) /   SUM([basic_total])' />
            </column>
            <column caption='Total Costs' datatype='real' name='[Calculation_1647754579069087744]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[basic_total]+[scoring_total]+[quest_total]' />
            </column>
            <column caption='Report Week' datatype='string' name='[Calculation_1647754580089331718]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_week]' />
