            </column>
            <column caption='Total Costs EUR' datatype='real' name='[Total Costs (copy)_833165944341676041]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[# Basic (copy)_833165944340946949]+[# Scoring (copy)_833165944341413895]+[# Quest (copy)_833165944341282822]' />
