            <column-instance column='[Calculation_56576484090228737]' derivation='None' name='[none:Calculation_56576484090228737:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_56576484268126213]' derivation='None' name='[none:Calculation_56576484268126213:nk]' pivot='key' type='nominal' />
            <column-instance column='[city_name]' derivation='None' name='[none:city_name:nk]' pivot='key' type='nominal' />
