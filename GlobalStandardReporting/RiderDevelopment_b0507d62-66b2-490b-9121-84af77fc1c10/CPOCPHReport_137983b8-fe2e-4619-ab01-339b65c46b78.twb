      <table>
        <view>
          <datasources>
            <datasource caption='payment_report' name='federated.03ocvls0qkz7ts16h5aoo01p19ij' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='LOCAL CURRENCY' caption='Currency Selector' datatype='integer' name='[Parameter 10]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='0' value='EUR' />
                <alias key='1' value='LOCAL CURRENCY' />
              </aliases>
            </column>
            <column caption='Choose Time Dimension' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Report Date&quot;'>
              <calculation class='tableau' formula='&quot;Report Date&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.03ocvls0qkz7ts16h5aoo01p19ij'>
            <column caption='# Basic EUR ' datatype='real' default-format='n#,##0;-#,##0' name='[# Basic (copy)_833165944340946949]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[basic_total] /   [exchange_rate]' />
            </column>
            <column caption='# Quest EUR' datatype='real' name='[# Quest (copy)_833165944341282822]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[quest_total] / [exchange_rate]' />
            </column>
            <column caption='# Scoring EUR' datatype='real' name='[# Scoring (copy)_833165944341413895]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[scoring_total] / [exchange_rate]' />
            </column>
            <column caption='CPO EUR' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[CPO (copy 2)_833165944341774346]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Total Costs (copy)_833165944341676041]) / SUM([deliveries])' />
            </column>
            <column caption='CPO baseline' datatype='real' name='[Calculation_1440870418492620800]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 10] &#13;&#10;WHEN 0 THEN LOOKUP(([CPO (copy 2)_833165944341774346]),FIRST())&#13;&#10;WHEN 1 THEN LOOKUP(([Calculation_1647754579069231105]),FIRST())&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Total Costs' datatype='real' name='[Calculation_1647754579069087744]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[basic_total]+[scoring_total]+[quest_total]' />
            </column>
            <column caption='CPO' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1647754579069231105]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1647754579069087744]) / SUM([deliveries])' />
            </column>
            <column caption='UTR ' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1647754580069822469]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([deliveries])/SUM([working_hours])' />
            </column>
            <column caption='Report Week' datatype='string' name='[Calculation_1647754580089331718]' role='dimension' type='nominal'>
