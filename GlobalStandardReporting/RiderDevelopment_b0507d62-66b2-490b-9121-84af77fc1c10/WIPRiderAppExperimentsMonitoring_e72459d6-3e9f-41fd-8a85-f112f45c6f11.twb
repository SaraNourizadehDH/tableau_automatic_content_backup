            </column>
            <column caption='Has Multiple Variations' datatype='boolean' name='[has_multiple_variations]' role='dimension' type='nominal' />
            <column caption='Late Shifts 5' datatype='integer' hidden='true' name='[late_shifts_5]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1260233855464247296]' derivation='None' name='[none:Calculation_1260233855464247296:nk]' pivot='key' type='nominal' />
            <column-instance column='[batch_number]' derivation='None' name='[none:batch_number:ok]' pivot='key' type='ordinal' />
