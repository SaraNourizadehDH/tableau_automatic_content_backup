    <worksheet name='RL - Metric dynamics'>
      <layout-options>
        <title>
          <formatted-text>
            <run>&lt;</run>
            <run>[federated.1aonq3h0tdx1pd172xt9419kf7qn].[none:Calculation_3425550508507922433:nk]</run>
            <run>&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='rider_fwf_ab_rider_kpi' name='federated.1aonq3h0tdx1pd172xt9419kf7qn' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Metric' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Number of riders&quot;'>
              <calculation class='tableau' formula='&quot;Number of riders&quot;' />
              <aliases>
                <alias key='&quot;Average rider accepting time (wo auto-accept)&quot;' value='Average rider accepting time (wo auto-accept)' />
                <alias key='&quot;Rider contact rate&quot;' value='Rider contact rate' />
              </aliases>
            </column>
            <column caption='Granularity' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1aonq3h0tdx1pd172xt9419kf7qn'>
            <column caption='Acceptance rate, % (wo auto-accepted deliveries)' datatype='real' default-format='p0.00%' name='[Acceptance rate, % (copy)_4066046833544024065]' role='measure' type='quantitative' visual-totals='Avg'>
              <calculation class='tableau' formula='SUM([rider_accepted_count_wo_auto_accept])/SUM([rider_notified_count_wo_auto_accept])' />
            </column>
            <column caption='Average rider accepting time (wo auto-accepted deliveries)  (min)' datatype='real' name='[Average time at customer (minutes) (copy)_4066046833542934528]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([rider_accepting_time_wo_auto_accept_sum])/SUM([rider_accepting_time_wo_auto_accept_count]))/60' />
            </column>
            <column caption='Metric' datatype='real' name='[Calculation_1213509034655973379]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Acceptance rate,%&apos; &#10;THEN [Calculation_153122428265914369]&#10;ELSEIF [Parameters].[Parameter 1]= &apos;% of the late shifts (delay 5+ minutes)&apos; &#10;THEN [Calculation_153122428279980036]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Average time to start the shift&apos; &#10;THEN [Calculation_153122428279578627]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Average actual delivery time&apos; &#10;THEN [Calculation_153122428285046796]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;% of the unexcused no shows&apos; &#10;THEN [Calculation_153122428286054413]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Average rider reaction time&apos; &#10;THEN [Calculation_153122428280696837]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Average time to vendor&apos; &#10;THEN [Calculation_153122428280696837]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Average time at vendor&apos;&#10;THEN [Calculation_153122428283719689]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Average time to customer&apos;&#10;THEN [Calculation_153122428284289034]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Average time at customer&apos;&#10;THEN [Calculation_153122428284579851]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Idle time,%&apos; &#10;THEN [Calculation_153122428296929295]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;% of the start working errors&apos; &#10;THEN [Calculation_153122428281843718]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;% of completed deliveries&apos; &#10;THEN [Calculation_153122428295172110]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Average rider accepting time (wo auto-accept)&apos;&#10;THEN [Average time at customer (minutes) (copy)_4066046833542934528]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Acceptance rate, % (wo auto-accept)&apos;&#10;THEN [Acceptance rate, % (copy)_4066046833544024065]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Completed Deliveries&apos;&#10;THEN SUM([completed_deliveries])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Number of riders&apos;&#10;THEN [Calculation_153122428278726658]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Rider contact rate&apos;&#10;THEN [Calculation_2554103948346568704]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;% Riders with app crashes&apos;&#10;THEN [Number of riders (copy)_546835523171950593]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;% ANR-free riders&apos;&#10;THEN [Calculation_6454713811996409858]&#10;END' />
            </column>
            <column caption='User Entitlement' datatype='boolean' name='[Calculation_1260233855464247296]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[username] = USERNAME()' />
            </column>
            <column caption='Acceptance rate %' datatype='real' default-format='p0.00%' name='[Calculation_153122428265914369]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_accepted])/SUM([rider_notified])' />
            </column>
            <column caption='Number of riders' datatype='integer' name='[Calculation_153122428278726658]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(STR([rider_id]) + [country_code])' />
            </column>
            <column caption='Average time  to start the shift (sec)' datatype='real' name='[Calculation_153122428279578627]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([to_start_shift_sum])/SUM([to_start_shift_count])' />
            </column>
            <column caption='% of the late shifts (delay more than 5 minutes)' datatype='real' name='[Calculation_153122428279980036]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([late_shifts_5])/SUM([shifts_done])' />
            </column>
            <column caption='Average rider reaction time (sec)' datatype='real' name='[Calculation_153122428280696837]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([reaction_time_sec_sum])/SUM([reaction_time_sec_count])' />
            </column>
            <column caption='% of start working errors' datatype='real' name='[Calculation_153122428281843718]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([start_working_errors])/SUM([start_working_clicks])' />
            </column>
            <column caption='Average time at vendor (min)' datatype='real' name='[Calculation_153122428283719689]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([at_vendor_time_sum])/SUM([at_vendor_time_count]))/60' />
            </column>
            <column caption='Average time to customer (min)' datatype='real' name='[Calculation_153122428284289034]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([to_customer_time_sum])/SUM([to_customer_time_count]))/60' />
            </column>
            <column caption='Average time at customer (min)' datatype='real' name='[Calculation_153122428284579851]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([at_customer_time_sum])/SUM([at_customer_time_count]))/60' />
            </column>
            <column caption='Average actual delivery time (min)' datatype='real' name='[Calculation_153122428285046796]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([effective_delivery_time_sum])/SUM([effective_delivery_time_count]))/60' />
            </column>
            <column caption='% of unexcused no shows' datatype='real' name='[Calculation_153122428286054413]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([unexcused_no_shows])/SUM([all_shifts])' />
            </column>
            <column caption='% of completed delieveries' datatype='real' name='[Calculation_153122428295172110]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([completed_deliveries])/SUM([rider_accepted])' />
            </column>
            <column caption='Idle time, %' datatype='real' name='[Calculation_153122428296929295]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - (SUM([transition_busy_time])/SUM([transition_working_time]))' />
            </column>
            <column caption='Rider contact rate' datatype='real' default-format='*0.00%' name='[Calculation_2554103948346568704]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_contacts_count])/SUM([orders_count])' />
            </column>
            <column caption='Viz name' datatype='string' name='[Calculation_3425550508507922433]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Acceptance rate,%&apos; &#10;THEN &apos;Dynamics of the acceptance rate, %&apos; &#10;ELSEIF [Parameters].[Parameter 1]= &apos;% of the late shifts (delay 5+ minutes)&apos; &#10;THEN &apos;Dynamics of the % of the late shifts (delay 5+ minutes)&apos;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Average time to start the shift&apos; &#10;THEN &apos;Dynamics of the average time to start the shift (seconds)&apos;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Average actual delivery time&apos; &#10;THEN &apos;Dynamics of the average effective delivery time (minutes)&apos;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;% of the unexcused no shows&apos; &#10;THEN &apos;Dynamics of the % of the unexcused no shows&apos;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Average rider reaction time&apos; &#10;THEN &apos;Dynamics of the average rider reaction time (seconds)&apos;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Average time to vendor&apos; &#10;THEN &apos;Dynamics of the average time to vendor (minutes)&apos;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Average time at vendor&apos;&#10;THEN &apos;Dynamics of the average time at vendor (minutes)&apos;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Average time to customer&apos;&#10;THEN &apos;Dynamics of the average time to customer (minutes)&apos;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Average time at customer&apos;&#10;THEN &apos;Dynamics of the average time at customer (minutes)&apos;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Idle time,%&apos; &#10;THEN &apos;Dynamics of the idle time, %&apos;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;% of the start working errors&apos; &#10;THEN  &apos;Dynamics of the % of start worling errors&apos;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;% of completed deliveries&apos; &#10;THEN &apos;Dynamics of the % of completed deliveries&apos;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Average rider accepting time (wo auto-accept)&apos;&#10;THEN &apos;Dynamics of the average rider accepting time (wo auto-accepted deliveries)&apos; &#10;ELSEIF [Parameters].[Parameter 1] = &apos;Acceptance rate, % (wo auto-accept)&apos;&#10;THEN &apos;Dynamics of the acceptance rate, % (wo auto-accepted deliveries)&apos; &#10;ELSEIF [Parameters].[Parameter 1] = &apos;Completed Deliveries&apos;&#10;THEN &apos;Dynamics of the completed deliveries&apos; &#10;ELSEIF [Parameters].[Parameter 1] = &apos;Number of riders&apos;&#10;THEN &apos;Dynamics of the number of riders&apos; &#10;ELSEIF [Parameters].[Parameter 1] = &apos;Rider contact rate&apos;&#10;THEN &apos;Dynamics of the rider contact rate&apos; &#10;ELSEIF [Parameters].[Parameter 1] = &apos;% Riders with app crashes&apos;&#10;THEN &apos;% Riders with app crashes&apos;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;% ANR-free riders&apos;&#10;THEN &apos;% ANR-free riders&apos;&#10;END' />
            </column>
            <column caption='Metric value' datatype='real' name='[Calculation_3425550508531273733]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Acceptance rate,%&apos; &#10;THEN -[Calculation_153122428265914369]&#10;ELSEIF [Parameters].[Parameter 1]= &apos;% of the late shifts (delay 5+ minutes)&apos; &#10;THEN -[Calculation_153122428279980036]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Average time to start the shift&apos; &#10;THEN [Calculation_153122428279578627]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Average actual delivery time&apos; &#10;THEN [Calculation_153122428285046796]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;% of the unexcused no shows&apos; &#10;THEN -[Calculation_153122428286054413]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Average rider reaction time&apos; &#10;THEN [Calculation_153122428280696837]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Average time to vendor&apos; &#10;THEN [Calculation_153122428280696837]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Average time at vendor&apos;&#10;THEN [Calculation_153122428283719689]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Average time to customer&apos;&#10;THEN [Calculation_153122428284289034]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Average time at customer&apos;&#10;THEN [Calculation_153122428284579851]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Acceptance rate, % (wo auto-accept)&apos;&#10;THEN -[Acceptance rate, % (copy)_4066046833544024065]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Idle time,%&apos; &#10;THEN -[Calculation_153122428296929295]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;% of the start working errors&apos; &#10;THEN -[Calculation_153122428281843718]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;% of completed deliveries&apos; &#10;THEN -[Calculation_153122428295172110]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Average rider accepting time (wo auto-accept)&apos;&#10;THEN [Average time at customer (minutes) (copy)_4066046833542934528]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Completed Deliveries&apos;&#10;THEN SUM([completed_deliveries])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Number of riders&apos;&#10;THEN [Calculation_153122428278726658]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Rider contact rate&apos;&#10;THEN -[Calculation_2554103948346568704]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;% Riders with app crashes&apos;&#10;THEN -[Number of riders (copy)_546835523171950593]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;% ANR-free riders&apos;&#10;THEN -[Calculation_6454713811996409858]&#10;END' />
            </column>
            <column caption='Date' datatype='date' datatype-customized='true' name='[Calculation_439030637345693706]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(IF [Parameters].[Parameter 2] = &apos;Daily&apos; &#10;THEN DATETRUNC(&apos;day&apos;,[report_date])&#10;ELSE DATETRUNC(&apos;week&apos;,[report_date]) END)' />
            </column>
            <column caption='Riders with ANR errors' datatype='integer' name='[Calculation_6454713811996278785]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [anr_errors] &gt; 0 THEN STR([rider_id]) + [country_code] ELSE NULL END)' />
