            <column caption='Average refund (euro)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_192247454787981313]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_192247454787768320] / [Number of riders (copy)_2675138245644619784]' />
            </column>
            <column caption='Redispatch rate' datatype='real' default-format='p0.00%' name='[Calculation_2141602378846117888]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([redispatch_deliveries]) / SUM([rider_accepted_count])' />
            </column>
            <column caption='Is Stacked Delivery' datatype='boolean' name='[Calculation_2141602378847457281]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_stacked_delivery] = TRUE&#10;THEN TRUE&#10;ELSE FALSE&#10;END' />
