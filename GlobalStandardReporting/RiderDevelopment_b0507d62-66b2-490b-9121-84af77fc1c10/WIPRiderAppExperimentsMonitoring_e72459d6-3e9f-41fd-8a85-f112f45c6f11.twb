            <column caption='% Fail rate' datatype='real' default-format='p0.00%' name='[Calculation_4277997445156577280]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cancelled_orders]) / SUM([gross_orders])' />
            </column>
            <column caption='RCR' datatype='real' default-format='p0.00%' name='[Calculation_4277997445158125569]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_contacts_count]) / [Number of riders (copy)_2675138245644619784]' />
            </column>
            <column caption='% Crash rate' datatype='real' default-format='p0.00%' name='[Calculation_4277997445160333314]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_app_crash_count]) / [Number of riders (copy)_2675138245644619784]' />
            </column>
            <column caption='Date' datatype='date' datatype-customized='true' name='[Calculation_439030637345693706]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(IF [Parameters].[Parameter 2] = &apos;Daily&apos; &#10;THEN DATETRUNC(&apos;day&apos;,[created_date_local])&#10;ELSE DATETRUNC(&apos;week&apos;,[created_date_local]) END)' />
            </column>
            <column caption='Number of completed deliveries' datatype='integer' name='[Number of deliveries (copy)_2675138245644963849]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [delivery_status] = &apos;completed&apos; THEN STR([rider_id]) + [country_code] + STR([delivery_id]) ELSE NULL END)' />
            </column>
            <column caption='Number of deliveries' datatype='integer' name='[Number of riders (copy)_2675138245644619784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(STR([rider_id]) + [country_code] + STR([delivery_id]))' />
            </column>
            <column caption='Actual Delivery Time' datatype='integer' hidden='true' name='[actual_delivery_time]' role='measure' type='quantitative' />
            <column caption='At Customer Time' datatype='integer' hidden='true' name='[at_customer_time]' role='measure' type='quantitative' />
            <column caption='At Vendor Time' datatype='integer' hidden='true' name='[at_vendor_time]' role='measure' type='quantitative' />
            <column datatype='integer' hidden='true' name='[auto_accept_adoption]' role='measure' type='quantitative' />
            <column caption='Batch Number' datatype='integer' name='[batch_number]' role='dimension' type='ordinal' />
            <column datatype='integer' hidden='true' name='[cancelled_orders]' role='measure' type='quantitative' />
            <column caption='Country Code' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='real' hidden='true' name='[cpo]' role='measure' type='quantitative' />
            <column caption='Report Date' datatype='date' name='[created_date_local]' role='dimension' type='ordinal' />
            <column caption='Delivery Id' datatype='integer' name='[delivery_id]' role='dimension' type='ordinal' />
            <column caption='Delivery Status' datatype='string' name='[delivery_status]' role='dimension' type='nominal' />
            <column caption='Device OS' datatype='string' name='[device_os]' role='dimension' type='nominal' />
            <column caption='Dropoff Delta' datatype='real' hidden='true' name='[dropoff_delta]' role='measure' type='quantitative' />
