s; &#10;ELSEIF [Parameters].[Metric (copy)_2675138245635772418] = &apos;RCR&apos;&#10;THEN &apos;Dynamics of the RCR&apos; &#10;ELSEIF [Parameters].[Metric (copy)_2675138245635772418] = &apos;% Crash rate&apos;&#10;THEN &apos;Dynamics of the % Crash rate&apos; &#10;ELSEIF [Parameters].[Metric (copy)_2675138245635772418] = &apos;% Fail rate&apos;&#10;THEN &apos;Dynamics of the % Fail rate&apos; &#10;ELSEIF [Parameters].[Metric (copy)_2675138245635772418] = &apos;Auto-Accept adoption rate&apos;&#10;THEN &apos;Dynamics of the Auto-Accept adoption rate&apos; &#10;END' />
            </column>
            <column caption='% Fail rate' datatype='real' default-format='p0.00%' name='[Calculation_4277997445156577280]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cancelled_orders]) / SUM([gross_orders])' />
            </column>
            <column caption='RCR' datatype='real' default-format='p0.00%' name='[Calculation_4277997445158125569]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_contacts_count]) / [Number of riders (copy)_2675138245644619784]' />
            </column>
            <column caption='% Crash rate' datatype='real' default-format='p0.00%' name='[Calculation_4277997445160333314]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_app_crash_count]) / [Number of riders (copy)_2675138245644619784]' />
            </column>
            <column caption='Date' datatype='date' datatype-customized='true' name='[Calculation_439030637345693706]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(IF [Parameters].[Parameter 2] = &apos;Daily&apos; &#10;THEN DATETRUNC(&apos;day&apos;,[created_date_local])&#10;ELSE DATETRUNC(&apos;week&apos;,[created_date_local]) END)' />
            </column>
            <column caption='Metric Average' datatype='real' name='[Calculation_6700652616567758849]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({ INCLUDE [country_code], [rider_id], [delivery_id]: [Calculation_1213509034655973379]})' />
            </column>
            <column caption='CI - Upper' datatype='real' name='[Calculation_6700652616568844291]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6700652616567758849] + [Calculation_6700652616618758151] * [Metric Average (copy)_6700652616568528898]' />
            </column>
            <column caption='CI - Width' datatype='real' name='[Calculation_6700652616570720261]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6700652616568844291] - [Upper CI (copy)_6700652616568999940]' />
            </column>
            <column caption='z-statistic' datatype='real' hidden='true' name='[Calculation_6700652616618758151]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Granularity (copy)]&#10;WHEN 75 THEN 1.15&#10;WHEN 80 THEN 1.28&#10;WHEN 90 THEN 1.65&#10;WHEN 95 THEN 1.96&#10;WHEN 99 THEN 2.58&#10;END' />
            </column>
            <column caption='Metric Standard Error' datatype='real' hidden='true' name='[Metric Average (copy)_6700652616568528898]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='STDEV({ INCLUDE [country_code], [rider_id], [delivery_id]: [Calculation_1213509034655973379]}) / SQRT(COUNT({ INCLUDE [country_code], [rider_id], [delivery_id]: [Calculation_1213509034655973379]}))' />
            </column>
            <column caption='Number of completed deliveries' datatype='integer' name='[Number of deliveries (copy)_2675138245644963849]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [delivery_status] = &apos;completed&apos; THEN STR([rider_id]) + [country_code] + STR([delivery_id]) ELSE NULL END)' />
            </column>
            <column caption='Number of deliveries' datatype='integer' name='[Number of riders (copy)_2675138245644619784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(STR([rider_id]) + [country_code] + STR([delivery_id]))' />
