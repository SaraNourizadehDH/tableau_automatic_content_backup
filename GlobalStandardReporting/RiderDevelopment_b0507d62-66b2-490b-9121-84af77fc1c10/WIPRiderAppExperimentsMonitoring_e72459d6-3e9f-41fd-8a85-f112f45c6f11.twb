        <column caption='Has Multiple OS' datatype='boolean' name='[Calculation_2675138245632733184]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [device_os] = &apos;Multi OS&apos; THEN TRUE ELSE IF ISNULL([device_os]) THEN NULL ELSE FALSE END END' />
        </column>
        <column caption='Has Multiple Variation' datatype='boolean' name='[Calculation_2675138245634211841]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [fwf_variation] = &apos;Multi Variation&apos; THEN TRUE ELSE FALSE END' />
        </column>
        <column caption='Date' datatype='date' datatype-customized='true' name='[Calculation_439030637345693706]' role='dimension' type='ordinal'>
          <calculation class='tableau' formula='DATE(IF [Parameters].[Parameter 2] = &apos;Daily&apos; &#10;THEN DATETRUNC(&apos;day&apos;,[created_date_local])&#10;ELSE DATETRUNC(&apos;week&apos;,[created_date_local]) END)' />
