            <column caption='% ANR-free riders' datatype='real' name='[Calculation_6454713811996409858]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_153122428278726658] - [Calculation_6454713811996278785])/[Calculation_153122428278726658]' />
