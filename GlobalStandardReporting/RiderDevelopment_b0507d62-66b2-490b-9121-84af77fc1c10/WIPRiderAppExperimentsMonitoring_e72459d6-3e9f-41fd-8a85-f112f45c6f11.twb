    <worksheet name='DL - Multiple devices'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000'>Multiple devices</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='rider_fwf_ab_delivery_kpi' name='federated.1aonq3h0tdx1pd172xt9419kf7qn (copy)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Delivery Level Metrics' datatype='string' name='[Metric (copy)_2675138245635772418]' param-domain-type='list' role='measure' type='nominal' value='&quot;Number of riders&quot;'>
              <calculation class='tableau' formula='&quot;Number of riders&quot;' />
            </column>
            <column caption='Granularity' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1aonq3h0tdx1pd172xt9419kf7qn (copy)'>
            <column caption='Acceptance rate v3' datatype='real' default-format='p0.00%' name='[Acceptance rate (copy)_2675138245644394503]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([rider_accepted_count_new]) - SUM([manual_undispatched_count]))/SUM([rider_notified_count_new])' />
            </column>
            <column caption='Average order delay (minutes)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Average actual delivery time (minutes) (copy)_2675138245652176908]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([order_delay])/60' />
            </column>
            <column caption='Average pickup delta (minutes)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Average dropoff delta (minutes) (copy)_2675138245645488138]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([pickup_delta])/60' />
            </column>
            <column caption='Average delivery time (minutes)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Average effective delivery time (minutes) (copy)_2675138245643878405]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([actual_delivery_time])/60' />
            </column>
            <column caption='Average rider accepting time (minutes)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Average time at vendor (minutes) (copy)_2675138245643341827]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([rider_accepting_time])/60' />
            </column>
            <column caption='Average dropoff delta (minutes)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Average time to vendor (minutes) (copy)_2675138245644091398]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([dropoff_delta])/60' />
            </column>
            <column caption='User Entitlement' datatype='boolean' name='[Calculation_1260233855464247296]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[username] = USERNAME()' />
            </column>
            <column caption='Acceptance rate' datatype='real' default-format='p0.00%' name='[Calculation_153122428265914369]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_accepted_count])/SUM([rider_notified_count])' />
            </column>
            <column caption='Number of riders' datatype='integer' name='[Calculation_153122428278726658]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(STR([rider_id]) + [country_code])' />
            </column>
            <column caption='Average rider reaction time (seconds)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_153122428280696837]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([rider_reaction_time])' />
            </column>
            <column caption='Average time to vendor (minutes)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_153122428282908679]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([to_vendor_time])/60' />
            </column>
            <column caption='Average time at vendor (minutes)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_153122428283719689]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([at_vendor_time])/60' />
            </column>
            <column caption='Average time to customer (minutes)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_153122428284289034]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([to_customer_time])/60' />
            </column>
            <column caption='Average time at customer (minutes)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_153122428284579851]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([at_customer_time])/60' />
            </column>
            <column caption='Average effective delivery time (minutes)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_153122428285046796]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([effective_delivery_time])/60' />
            </column>
            <column caption='% of completed delieveries' datatype='real' default-format='p0.00%' name='[Calculation_153122428295172110]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Number of deliveries (copy)_2675138245644963849]/[Number of riders (copy)_2675138245644619784]' />
            </column>
            <column caption='Is Stacked Delivery' datatype='boolean' name='[Calculation_2141602378847457281]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_stacked_delivery] = TRUE&#10;THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='Has Multiple OS' datatype='boolean' name='[Calculation_2675138245632733184]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [device_os] = &apos;Multi OS&apos; THEN TRUE ELSE IF ISNULL([device_os]) THEN NULL ELSE FALSE END END' />
            </column>
            <column caption='Has Multiple Variation' datatype='boolean' name='[Calculation_2675138245634211841]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [fwf_variation] = &apos;Multi Variation&apos; THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Date' datatype='date' datatype-customized='true' name='[Calculation_439030637345693706]' role='dimension' type='ordinal'>
