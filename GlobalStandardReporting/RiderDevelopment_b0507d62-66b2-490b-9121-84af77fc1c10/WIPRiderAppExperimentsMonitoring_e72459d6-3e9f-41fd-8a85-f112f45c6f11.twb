            <column caption='Effective Delivery Time Count' datatype='integer' hidden='true' name='[effective_delivery_time_count]' role='measure' type='quantitative' />
            <column caption='Effective Delivery Time Sum' datatype='integer' hidden='true' name='[effective_delivery_time_sum]' role='measure' type='quantitative' />
            <column caption='Experiment Name' datatype='string' name='[fwf_feature]' role='dimension' type='nominal' />
            <column caption='Test Variation' datatype='string' name='[fwf_variation]' role='dimension' type='nominal' />
            <column caption='Has Multiple Devices' datatype='boolean' name='[has_multiple_devices]' role='dimension' type='nominal'>
              <aliases>
