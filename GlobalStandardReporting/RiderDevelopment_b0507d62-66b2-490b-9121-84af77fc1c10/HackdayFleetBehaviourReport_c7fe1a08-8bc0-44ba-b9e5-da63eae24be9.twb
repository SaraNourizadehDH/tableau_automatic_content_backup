      <aliases enabled='yes' />
      <column caption='Lifespan Deliveries Sum Month' datatype='integer' name='[Calculation_2456150666323210240]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IF {fixed [Calculation_2456150666583003137]:max([report_week])} &#13;&#10;= [report_week]&#13;&#10;THEN [lifespan_deliveries_sum]&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Report Month' datatype='string' name='[Calculation_2456150666583003137]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(DATEPART(&apos;year&apos;, [week_start])) + &apos; - &apos; +&#13;&#10;STR(DATEPART(&apos;month&apos;, [week_start]))' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_2456150666643468298]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]= USERNAME()' />
      </column>
      <column caption='Lifespan Deliveries Week' datatype='real' name='[Calculation_616148743454232576]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([lifespan_deliveries_sum])/SUM([lifespan_deliveries_count])' />
      </column>
      <column caption='Lifespan Week' datatype='real' name='[Calculation_616148743455203330]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Lifespan Hours Parameter]&#13;&#10;  WHEN &apos;Deliveries&apos; THEN [Calculation_616148743454232576]&#13;&#10;  WHEN &apos;Worked Hours&apos; THEN [Lifespan Deliveries (copy)_616148743454400513]&#13;&#10;END' />
      </column>
      <column caption='Choosen Timeframe' datatype='string' name='[Calculation_616148743479922691]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &quot;Quarter&quot;&#13;&#10;THEN &quot;Q&quot; + STR(DATEPART(&apos;quarter&apos;, [week_start]))&#13;&#10;ELSEIF [Parameters].[Parameter 5] = &quot;Month&quot;&#13;&#10;THEN [Calculation_2456150666583003137]&#13;&#10;ELSEIF [Parameters].[Parameter 5] = &quot;Week&quot;&#13;&#10;THEN [report_week]&#13;&#10;END' />
      </column>
      <column caption='Lifespan Hours Week' datatype='real' name='[Lifespan Deliveries (copy)_616148743454400513]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([lifespan_hours_sum])/SUM([lifespan_hours_count])' />
      </column>
      <column caption='Lifespan Hours Count Month' datatype='integer' name='[Lifespan Deliveries Count Month (copy)_2456150666590760964]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IF {fixed [Calculation_2456150666583003137]:max([report_week])} &#13;&#10;= [report_week]&#13;&#10;THEN [lifespan_hours_count]&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Lifespan Deliveries Count Month' datatype='integer' name='[Lifespan Deliveries Sum Month (copy)_2456150666590490627]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IF {fixed [Calculation_2456150666583003137]:max([report_week])} &#13;&#10;= [report_week]&#13;&#10;THEN [lifespan_deliveries_count]&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Lifespan Deliveries Month' datatype='real' name='[Lifespan Deliveries Week (copy)_2456150666591305734]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_2456150666323210240])/SUM([Lifespan Deliveries Sum Month (copy)_2456150666590490627])' />
      </column>
      <column caption='Lifespan Hours Sum Month' datatype='real' name='[Lifespan Hours Count Month (copy)_2456150666590916613]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IF {fixed [Calculation_2456150666583003137]:max([report_week])} &#13;&#10;= [report_week]&#13;&#10;THEN [lifespan_hours_sum]&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Lifespan Hours Month' datatype='real' name='[Lifespan Hours Week (copy)_2456150666591473671]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Lifespan Hours Count Month (copy)_2456150666590916613])/SUM([Lifespan Deliveries Count Month (copy)_2456150666590760964])' />
      </column>
      <column caption='Lifespan' datatype='real' name='[Lifespan Month (copy)_2456150666591834121]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#13;&#10;  WHEN &apos;Month&apos; THEN [Lifespan Week (copy)_2456150666591694856]&#13;&#10;  WHEN &apos;Week&apos; THEN [Calculation_616148743455203330]&#13;&#10;END' />
      </column>
      <column caption='Lifespan Month' datatype='real' name='[Lifespan Week (copy)_2456150666591694856]' role='measure' type='quantitative'>
