          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose Timeframe' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ihl7wp0pu4tah1ee88kf0sjl4g3'>
            <column caption='Churn Rate' datatype='real' name='[% Active Riders - Timeframe (copy)_5574189763240386561]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Day&apos; THEN&#10;    SUM([churn_riders_day]) / (SUM([active_riders_day]) + SUM([inactive_riders_day]) + SUM([churn_riders_day]))&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Week&apos; THEN&#10;    SUM([churn_riders_week]) / (SUM([active_riders_week]) + SUM([inactive_riders_week]) + SUM([churn_riders_week]))&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Month&apos; THEN&#10;    SUM([churn_riders_month]) / (SUM([active_riders_month]) + SUM([inactive_riders_month]) + SUM([churn_riders_month]))&#10;&#10;END' />
            </column>
            <column caption='Stale Riders - Timeframe ' datatype='integer' name='[Active Riders - Timeframe (copy)_3936779453224521733]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Day&apos; THEN&#10;    SUM([stale_riders_day])&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Week&apos; THEN&#10;    SUM([stale_riders_week])&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Month&apos; THEN&#10;    SUM([stale_riders_month]) &#10;&#10;END' />
            </column>
            <column caption='Reactivated Riders - Timeframe' datatype='integer' name='[Active Riders - Timeframe (copy)_4982388624624214024]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Day&apos; THEN&#10;    SUM([reactivated_riders_day])&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Week&apos; THEN&#10;    SUM([reactivated_riders_week])&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Month&apos; THEN&#10;    SUM([reactivated_riders_month]) &#10;&#10;END' />
            </column>
            <column caption='Active Riders - Timeframe' datatype='integer' name='[Calculation_3936779453221216260]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Day&apos; THEN&#10;    SUM([active_riders_day])&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Week&apos; THEN&#10;    SUM([active_riders_week])&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Month&apos; THEN&#10;    SUM([active_riders_month]) &#10;&#10;END' />
            </column>
            <column caption='Time Dimension' datatype='string' name='[Calculation_3936779453225644038]' role='dimension' type='nominal'>
