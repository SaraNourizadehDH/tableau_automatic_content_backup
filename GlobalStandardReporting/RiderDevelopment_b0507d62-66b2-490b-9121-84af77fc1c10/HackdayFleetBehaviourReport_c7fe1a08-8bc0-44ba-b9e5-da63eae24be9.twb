          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Lifespan' datatype='string' name='[Lifespan Hours Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Deliveries&quot;'>
              <calculation class='tableau' formula='&quot;Deliveries&quot;' />
            </column>
            <column caption='Choose Timeframe' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ihl7wp0pu4tah1ee88kf0sjl4g3'>
