      <table>
        <view>
          <datasources>
            <datasource caption='fleet_activity_and_engagement_report+ (cl)' name='federated.0ihl7wp0pu4tah1ee88kf0sjl4g3' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Fleet activity graph - Type' datatype='string' name='[Ongoing Contracts Type (copy)_692217402044817408]' param-domain-type='list' role='measure' type='nominal' value='&quot;Absolute&quot;'>
              <calculation class='tableau' formula='&quot;Absolute&quot;' />
            </column>
            <column caption='Choose Timeframe' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ihl7wp0pu4tah1ee88kf0sjl4g3'>
            <column caption='% Inactive Riders - Timeframe' datatype='real' name='[% Active Riders - Timeframe (copy)_4982388624605741056]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Day&apos; THEN&#10;    SUM([inactive_riders_day]) / (SUM([active_riders_day]) + SUM([inactive_riders_day]) + SUM([stale_riders_day]))&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Week&apos; THEN&#10;    SUM([inactive_riders_week]) / (SUM([active_riders_week]) + SUM([inactive_riders_week]) + SUM([stale_riders_week]))&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Month&apos; THEN&#10;    SUM([inactive_riders_month]) / (SUM([active_riders_month]) + SUM([inactive_riders_month]) + SUM([stale_riders_month]))&#10;&#10;END' />
            </column>
            <column caption='% Stale Riders - Timeframe' datatype='real' name='[% Inactive Riders - Timeframe (copy)_4982388624606887937]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Day&apos; THEN&#10;    SUM([stale_riders_day]) / (SUM([active_riders_day]) + SUM([inactive_riders_day]) + SUM([stale_riders_day]))&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Week&apos; THEN&#10;    SUM([stale_riders_week]) / (SUM([active_riders_week]) + SUM([inactive_riders_week]) + SUM([stale_riders_week]))&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Month&apos; THEN&#10;    SUM([stale_riders_month]) / (SUM([active_riders_month]) + SUM([inactive_riders_month]) + SUM([stale_riders_month]))&#10;&#10;END' />
            </column>
            <column caption='Stale Riders - Timeframe ' datatype='integer' name='[Active Riders - Timeframe (copy)_3936779453224521733]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Day&apos; THEN&#10;    SUM([stale_riders_day])&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Week&apos; THEN&#10;    SUM([stale_riders_week])&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Month&apos; THEN&#10;    SUM([stale_riders_month]) &#10;&#10;END' />
            </column>
            <column caption='% Active Riders - Timeframe' datatype='real' name='[Active Riders - Timeframe (copy)_4029947671932211211]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Day&apos; THEN&#10;    SUM([active_riders_day]) / (SUM([active_riders_day]) + SUM([inactive_riders_day]) + SUM([stale_riders_day]))&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Week&apos; THEN&#10;    SUM([active_riders_week]) / (SUM([active_riders_week]) + SUM([inactive_riders_week]) + SUM([stale_riders_week]))&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Month&apos; THEN&#10;    SUM([active_riders_month]) / (SUM([active_riders_month]) + SUM([inactive_riders_month]) + SUM([stale_riders_month]))&#10;&#10;END' />
            </column>
            <column caption='Active Riders - Timeframe' datatype='integer' name='[Calculation_3936779453221216260]' role='measure' type='quantitative'>
