            </column>
            <column caption='Churn Rate Denominator' datatype='integer' name='[Churn Rate (copy) (copy)_402298149663068198]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Day&apos; THEN&#10;(SUM([active_riders_day]) + SUM([inactive_riders_day]) + SUM([churn_riders_day]))&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Week&apos; THEN&#10;(SUM([active_riders_week]) + SUM([inactive_riders_week]) + SUM([churn_riders_week]))&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Month&apos; THEN&#10; (SUM([active_riders_month]) + SUM([inactive_riders_month]) + SUM([churn_riders_month]))&#10;&#10;END' />
            </column>
