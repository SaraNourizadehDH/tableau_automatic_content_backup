      <aliases enabled='yes' />
      <column caption='Achievment Rate ' datatype='real' name='[Achievment Rate (copy)_2005579600871927817]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='({ FIXED [country_code], [rider_id]: SUM([achieved_goals])}&#10;*100)/({ FIXED [country_code], [rider_id]:SUM([total_goals])})' />
      </column>
      <column caption='Achievment Rate Country' datatype='real' name='[Achievment Rate (copy)_3067725424770207750]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([achieved_goals])&#10;/SUM([total_goals])' />
      </column>
      <column caption='Achievment Rate Country (copy)' datatype='real' name='[Achievment Rate Country (copy)_2005579600853594118]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([achieved_goals])&#10;/SUM([total_goals])' />
      </column>
      <column caption='Riders Participated' datatype='integer' name='[Calculation_2005579600590372865]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [participation_flag] = 1 THEN  [rider_id] END)' />
      </column>
      <column caption='Achieved at least 1 goal' datatype='integer' name='[Calculation_2005579600590675970]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [achieved_goals] &gt; 0 THEN [rider_id] END)' />
      </column>
      <column caption='Achieved all Goals' datatype='integer' name='[Calculation_2005579600590860291]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [total_goals] = [achieved_goals] THEN [rider_id] END)' />
      </column>
      <column caption='Number of Riders' datatype='integer' name='[Calculation_2005579600850550788]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([rider_id])' />
      </column>
      <column caption='Achievment Rate' datatype='real' name='[Calculation_3067725424480497664]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({ FIXED [country_code], [rider_id]: SUM([achieved_goals])}&#10;*100)/SUM({ FIXED [country_code], [rider_id]:SUM([total_goals])})' />
      </column>
      <column caption='Participation Rate' datatype='real' name='[Calculation_3067725424492183554]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [country_code]: COUNTD(IF [participation_flag] = 1 THEN [rider_id] END)}/&#10;{ FIXED [country_code]: COUNTD([rider_id])}' />
      </column>
