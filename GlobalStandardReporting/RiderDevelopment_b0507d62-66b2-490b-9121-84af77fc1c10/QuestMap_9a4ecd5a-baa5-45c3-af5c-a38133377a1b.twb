            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='log-bi-reporting-production' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='DataHub Production' schema='cl' server-oauth='' username='shiva.arora@deliveryhero.com' workgroup-auth-mode='prompt' />
