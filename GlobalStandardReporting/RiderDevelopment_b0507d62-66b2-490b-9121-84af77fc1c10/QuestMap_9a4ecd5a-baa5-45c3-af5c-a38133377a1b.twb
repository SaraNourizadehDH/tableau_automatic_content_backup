            <column caption='Achievment Rate ' datatype='real' name='[Achievment Rate (copy)_2005579600871927817]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='({ FIXED [country_code], [rider_id]: SUM([achieved_goals])}&#10;*100)/({ FIXED [country_code], [rider_id]:SUM([total_goals])})' />
