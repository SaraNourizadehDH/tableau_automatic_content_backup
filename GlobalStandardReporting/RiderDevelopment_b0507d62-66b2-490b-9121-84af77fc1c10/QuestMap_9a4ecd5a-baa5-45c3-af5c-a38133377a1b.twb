      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_C6C8AF250EC94DE195843DC9DBC7DFAE'>
            <properties context=''>
              <relation connection='bigquery.1007za712kve5910pco420c5aphh' name='Custom SQL Query' type='text'>WITH dow AS (SELECT country_code
  , id
  , LOWER(d) AS day_of_week
 FROM `fulfillment-dwh-production.cl.payments_quest_rules` q
 LEFT JOIN UNNEST (q.applies_to) a
 LEFT JOIN UNNEST(a.days_of_week) d
 WHERE d IS NOT NULL
), date_ranges AS (
  SELECT
    country_code,
    id,
    start_date,
    end_date,
    GENERATE_DATE_ARRAY(DATE(start_date), DATE(end_date), INTERVAL 1 DAY) AS date_range
 FROM `fulfillment-dwh-production.cl.payments_quest_rules` q
 LEFT JOIN UNNEST (q.applies_to) a
), date_range AS (SELECT
  dr.country_code
  , dr.id
  , DATE(date) AS new_date
  , LOWER(FORMAT_DATE(&apos;%A&apos;, DATE(date))) AS day_of_week
FROM
  date_ranges dr
  LEFT JOIN UNNEST(date_range) AS date
), active_days AS (SELECT DISTINCT dr.country_code
, dr.id
, dr.new_date
, IF(d.id IS NULL, dr.day_of_week, d.day_of_week) AS day_of_week
FROM date_range dr
LEFT JOIN dow d ON dr.country_code = d.country_code
  AND dr.id = d.id
WHERE d.id IS NULL OR (d.day_of_week = dr.day_of_week)
--  AND dr.day_of_week = d.day_of_week
)
SELECT country_code
, day_of_week
, COUNT(id) number_of_rules
, COUNT(DISTINCT id) number_of_distinct_rules
FROM active_days
GROUP BY 1, 2</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
