            <column caption='Avg Delivery Area Size' datatype='real' name='[Calculation_3085458392887975938]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([vendor_delivery_area_km2_sum], 0)) / SUM(IFNULL([vendor_delivery_area_km2_count], 0))' />
