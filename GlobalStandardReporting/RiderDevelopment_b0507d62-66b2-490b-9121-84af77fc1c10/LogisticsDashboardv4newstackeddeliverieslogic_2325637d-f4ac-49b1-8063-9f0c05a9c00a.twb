            <column caption='Dt Denominator' datatype='integer' hidden='true' name='[dt_denominator]' role='measure' type='quantitative' />
            <column caption='Dt Numerator' datatype='real' hidden='true' name='[dt_numerator]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_916764006880329741]' derivation='None' name='[none:Calculation_916764006880329741:nk]' pivot='key' type='nominal' />
            <column-instance column='[Report Week (copy)]' derivation='None' name='[none:Report Week (copy):qk]' pivot='key' type='quantitative' />
            <column caption='Report Date' datatype='date' default-format='*yyyy-mm-dd' name='[report_date]' role='dimension' type='ordinal' />
