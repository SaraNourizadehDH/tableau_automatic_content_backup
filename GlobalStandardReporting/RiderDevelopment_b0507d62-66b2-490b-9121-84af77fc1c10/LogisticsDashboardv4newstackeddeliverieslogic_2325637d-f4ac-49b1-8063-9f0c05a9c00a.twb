            <column caption='UTR' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_916764006829854729]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_completed])/SUM([working_time])' />
            </column>
            <column caption='Pickup Distance Manhattan (km)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_920423184737288194]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pickup_distance_manhattan_km_sum])&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;SUM([pickup_distance_manhattan_km_count])' />
