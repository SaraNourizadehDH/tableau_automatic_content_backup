        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;&#10;WHEN &apos;# Orders&apos; THEN [Calculation_6013009250916843536]&#10;WHEN &apos;# Deliveries&apos; THEN [Calculation_6013009250916843536]&#10;WHEN &apos;# Failed Orders&apos; THEN -[Calculation_6013009250916843536]&#10;WHEN &apos;% Fail Rate&apos; THEN -[Calculation_6013009250916843536]&#10;WHEN &apos;Logistics Index&apos; THEN -[Calculation_6013009250916843536]&#10;WHEN &apos;UTR (Rooster)&apos; THEN [Calculation_916764006829854729]&#10;WHEN &apos;DT (min)&apos; THEN -[Calculation_6013009250916843536]&#10;WHEN &apos;% DT &lt; 20&apos; THEN [Calculation_6013009250916843536]&#10;WHEN &apos;% DT &gt; 45&apos; THEN -[Calculation_6013009250916843536]&#10;WHEN &apos;% Orders w Food is Ready&apos; THEN [Calculation_6013009250916843536]&#10;WHEN &apos;% Idle Time&apos; THEN -[Calculation_6013009250916843536]&#10;WHEN &apos;% Order late &gt; 10&apos; THEN -[Calculation_6013009250916843536]&#10;WHEN &apos;% Vendor late &gt; 10&apos; THEN -[Calculation_6013009250916843536]&#10;WHEN &apos;% Rider late &gt; 10&apos; THEN -[Calculation_6013009250916843536]&#10;WHEN &apos;% Order late &gt; 5&apos; THEN -[Calculation_6013009250916843536]&#10;WHEN &apos;% Vendor late &gt; 5&apos; THEN -[Calculation_6013009250916843536]&#10;WHEN &apos;% Rider late &gt; 5&apos; THEN -[Calculation_6013009250916843536]&#10;WHEN &apos;% Stacked Deliveries&apos; THEN [Calculation_6013009250916843536]&#10;WHEN &apos;% Acceptance Rate&apos; THEN [Calculation_6013009250916843536]&#10;WHEN &apos;P-D Distance (km)&apos; THEN [Calculation_6013009250916843536]&#10;WHEN &apos;Pickup Distance Manhattan (km)&apos; THEN [Calculation_6013009250916843536]&#10;WHEN &apos;Dropoff Distance Manhattan (km)&apos; THEN [Calculation_6013009250916843536]&#10;WHEN &apos;Working Hours (h)&apos; THEN [Calculation_6013009250916843536]&#10;WHEN &apos;Rider Accepting Time (min)&apos; THEN -[Calculation_6013009250916843536]&#10;WHEN &apos;To Vendor Time (min)&apos; THEN -[Calculation_6013009250916843536]&#10;WHEN &apos;At Vendor Time (min)&apos; THEN -[Calculation_6013009250916843536]&#10;WHEN &apos;At Vendor Time - Cleaned (min)&apos; THEN -[Calculation_6013009250916843536]&#10;WHEN &apos;To Customer Time (min)&apos; THEN -[Calculation_6013009250916843536]&#10;WHEN &apos;At Customer Time (min)&apos; THEN -[Calculation_6013009250916843536]&#10;WHEN &apos;Est. Prep Duration (min)&apos; THEN -[Calculation_6013009250916843536]&#10;WHEN &apos;Assumed Actual Prep Time (min)&apos; THEN -[Calculation_6013009250916843536]&#10;WHEN &apos;Delivery Size&apos; THEN -[Calculation_6013009250916843536]&#10;WHEN &apos;% Order early &lt; 10&apos; THEN [Calculation_6013009250916843536]&#10;WHEN &apos;% Order on time&apos; THEN [Calculation_6013009250916843536]&#10;WHEN &apos;CPO&apos; THEN -[Calculation_623818961401982977]&#10;WHEN &apos;Delivery Costs&apos; THEN -SUM([delivery_costs_eur])&#10;END'>
