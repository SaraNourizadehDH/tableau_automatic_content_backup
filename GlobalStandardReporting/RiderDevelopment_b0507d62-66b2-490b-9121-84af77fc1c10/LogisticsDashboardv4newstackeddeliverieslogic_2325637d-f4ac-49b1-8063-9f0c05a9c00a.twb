            <column caption='Vendor Walk in Time (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_549439176711352320]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_walk_in_time_numerator])/SUM([vendor_walk_in_time_denominator])' />
