          <datasource-dependencies datasource='federated.0qfwv2z0njkjcz18bfp0v199lqmg'>
            <column caption='% Order Early &lt; 10' datatype='real' default-format='p0.0%' name='[% Order Late &gt; 10 (copy)_6047982464002453504]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_early_10_n])/SUM([order_late_d])' />
            </column>
            <column caption='% Order On Time' datatype='real' default-format='p0.0%' name='[% Order Late &gt; 10 (copy)_6047982464002732033]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_on_time_n])/SUM([order_late_d])' />
            </column>
            <column caption='% Acceptance Rate' datatype='real' default-format='p0.0%' name='[Calculation_1083115719790469121]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_accepted])/SUM([rider_notified])' />
            </column>
            <column caption='% Stacked Deliveries' datatype='real' default-format='p0.0%' name='[Calculation_1083115720614670339]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([stacked_deliveries])/SUM([deliveries])' />
            </column>
            <column caption='% Stacked Deliveries (Intravendor) ' datatype='real' default-format='p0.0%' name='[Calculation_1083115720615055364]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([stacked_intravendor])/SUM([deliveries])' />
            </column>
            <column caption='% Single Stacks' datatype='real' default-format='p0.0%' name='[Calculation_1083115720631730182]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([single_stacked])/SUM([deliveries])' />
            </column>
            <column caption='% Double Stacks' datatype='real' default-format='p0.0%' name='[Calculation_1083115720631894023]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([double_stacked])/SUM([deliveries])' />
            </column>
            <column caption='% Triple Stacks' datatype='real' default-format='p0.0%' name='[Calculation_1083115720632315912]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([triple_stacked])/SUM([deliveries])' />
            </column>
            <column caption='% Over Triple Stacks' datatype='real' default-format='p0.0%' name='[Calculation_1083115720850903049]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([over_triple_stacked])/SUM([deliveries])' />
            </column>
            <column caption='Logistics Index' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1134907111286050817]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_916764006825598979]/[Calculation_916764006829854729]' />
            </column>
            <column caption='Promised DT (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1174032143710326786]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([promised_dt_numerator])/ SUM([promised_dt_denominator])' />
            </column>
            <column caption='Hold Back Time (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1175721020515610624]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([hold_back_time_n]) / SUM([hold_back_time_d])' />
            </column>
            <column caption='% Order Late &gt; 10' datatype='real' default-format='p0.0%' name='[Calculation_1313080789290942464]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_late_10_n])/SUM([order_late_d])' />
            </column>
            <column caption='% Vendor Late &gt; 10' datatype='real' default-format='p0.0%' name='[Calculation_1313080789291196417]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_10_n])/SUM([vendor_late_d])' />
            </column>
            <column caption='% Rider Late &gt; 10' datatype='real' default-format='p0.0%' name='[Calculation_1313080789291307010]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_late_10_n])/SUM([rider_late_d])' />
            </column>
            <column caption='Brand - Region' datatype='string' name='[Calculation_1441433410804244494]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[brand_id] +  &apos; - &apos; + [region]' />
            </column>
            <column caption='Avg Delivery Area Size' datatype='real' name='[Calculation_3085458392887975938]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([vendor_delivery_area_km2_sum], 0)) / SUM(IFNULL([vendor_delivery_area_km2_count], 0))' />
            </column>
            <column caption='Vendor Walk in Time (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_549439176711352320]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_walk_in_time_numerator])/SUM([vendor_walk_in_time_denominator])' />
            </column>
            <column caption='Customer walk in time (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_549439176711577601]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([customer_walk_in_time_numerator])/SUM([customer_walk_in_time_denominator])' />
            </column>
            <column caption='To Vendor Time (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_549439176832049154]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([to_vendor_time_mins_n])/SUM([to_vendor_time_mins_d])' />
            </column>
            <column caption='At Vendor Time (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_549439176832249859]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([at_vendor_time_mins_n])/SUM([at_vendor_time_mins_d])' />
            </column>
            <column caption='At Vendor Time - Cleaned (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_549439176832425988]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([at_vendor_time_cleaned_mins_n])/SUM([at_vendor_time_cleaned_mins_d])' />
            </column>
            <column caption='To Customer Time (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_549439176832589829]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([to_customer_time_mins_n])/SUM([to_customer_time_mins_d])' />
            </column>
            <column caption='At Customer Time (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_549439176832729094]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([at_customer_time_mins_n])/SUM([at_customer_time_mins_d])' />
            </column>
            <column caption='Est. Prep Duration  (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_549439176833003527]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([estimated_prep_time_mins_n])&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;/SUM([estimated_prep_time_mins_d])' />
            </column>
            <column caption='Est. Prep Buffer (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_549439176833187848]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([estimated_prep_buffer_mins_n])&#13;&#10;&#13;&#10;/sum([estimated_prep_buffer_mins_d])' />
            </column>
            <column caption='Rider Reaction Time (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_549439176833667081]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_reaction_time_mins_n])/SUM([rider_reaction_time_mins_d])' />
            </column>
            <column caption='Rider Accepting Time (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_549439176833933322]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_accepting_time_mins_n])/SUM([rider_reaction_time_mins_d])' />
            </column>
            <column caption='P-D Distance (km)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_584060594250178560]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_distance_sum]) /SUM([delivery_distance_count])' />
            </column>
            <column caption='CPO [EUR]' datatype='real' name='[Calculation_623818961401982977]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_costs_eur])/SUM([deliveries])' />
            </column>
            <column caption='% Break Hours' datatype='real' default-format='p0.0%' name='[Calculation_707909591935713280]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([break_time]) &#10;/(SUM([working_time]) + SUM([break_time]))' />
            </column>
            <column caption='DT (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_916764006825598979]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dt_numerator])/ SUM([dt_denominator])' />
            </column>
            <column caption='% Fail Rate' datatype='real' default-format='p0.0%' name='[Calculation_916764006826897413]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_cancelled])/SUM([gross_orders])' />
            </column>
            <column caption='% Idle Time' datatype='real' default-format='p0.00%' name='[Calculation_916764006829162504]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([idle_time])/SUM([working_time])' />
