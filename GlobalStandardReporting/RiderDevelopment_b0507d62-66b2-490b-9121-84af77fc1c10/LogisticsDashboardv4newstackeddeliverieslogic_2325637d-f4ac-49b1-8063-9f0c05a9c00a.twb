    <worksheet name='Custom Graph Lines'>
      <table>
        <view>
          <datasources>
            <datasource caption='logistics dashboard v4' name='federated.0qfwv2z0njkjcz18bfp0v199lqmg' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Split by Dimension' datatype='string' name='[Choose Dimension (A) (copy)_5486580677888692241]' param-domain-type='list' role='measure' type='nominal' value='&quot;None&quot;'>
              <calculation class='tableau' formula='&quot;None&quot;' />
            </column>
            <column caption='Choose Y-Metric' datatype='string' name='[Choose Metric (copy)_231231758732468225]' param-domain-type='list' role='measure' type='nominal' value='&quot;\# Deliveries&quot;'>
              <calculation class='tableau' formula='&quot;# Deliveries&quot;' />
              <aliases>
                <alias key='&quot;CPO&quot;' value='CPO [EUR]' />
                <alias key='&quot;UTR (Rooster)&quot;' value='UTR' />
              </aliases>
            </column>
            <column alias='Day' caption='Choose Time Dimension' datatype='string' name='[Parameter 1 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Report Date&quot;'>
              <calculation class='tableau' formula='&quot;Report Date&quot;' />
              <aliases>
                <alias key='&quot;Report Date&quot;' value='Day' />
                <alias key='&quot;Report Month&quot;' value='Month' />
                <alias key='&quot;Report Quarter&quot;' value='Quarter' />
                <alias key='&quot;Report Week&quot;' value='Week' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0qfwv2z0njkjcz18bfp0v199lqmg'>
            <column caption='% Order Early &lt; 10' datatype='real' default-format='p0.0%' name='[% Order Late &gt; 10 (copy)_6047982464002453504]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_early_10_n])/SUM([order_late_d])' />
            </column>
            <column caption='% Order On Time' datatype='real' default-format='p0.0%' name='[% Order Late &gt; 10 (copy)_6047982464002732033]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_on_time_n])/SUM([order_late_d])' />
            </column>
            <column caption='Batch Number (for dimension)' datatype='string' datatype-customized='true' name='[Batch Number (copy)_1259459827601379329]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL(STR([batch_number]), &apos;null&apos;)' />
            </column>
            <column caption='% Acceptance Rate' datatype='real' default-format='p0.0%' name='[Calculation_1083115719790469121]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_accepted])/SUM([rider_notified])' />
            </column>
            <column caption='% Stacked Deliveries' datatype='real' default-format='p0.0%' name='[Calculation_1083115720614670339]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([stacked_deliveries])/SUM([deliveries])' />
            </column>
            <column caption='Logistics Index' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1134907111286050817]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_916764006825598979]/[Calculation_916764006829854729]' />
            </column>
            <column caption='% Order Late &gt; 10' datatype='real' default-format='p0.0%' name='[Calculation_1313080789290942464]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_late_10_n])/SUM([order_late_d])' />
            </column>
            <column caption='% Vendor Late &gt; 10' datatype='real' default-format='p0.0%' name='[Calculation_1313080789291196417]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_10_n])/SUM([vendor_late_d])' />
            </column>
            <column caption='% Rider Late &gt; 10' datatype='real' default-format='p0.0%' name='[Calculation_1313080789291307010]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_late_10_n])/SUM([rider_late_d])' />
            </column>
            <column caption='Time Dimension' datatype='string' name='[Calculation_1647754580089847817]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE   [Parameters].[Parameter 1 1]&#13;&#10;&#13;&#10;WHEN &apos;Report Date&apos;  THEN STR([report_date])&#13;&#10;&#13;&#10;WHEN  &apos;Report Week&apos; THEN [Calculation_582371729572569088]&#13;&#10;&#13;&#10;WHEN &apos;Report Month&apos; THEN [Calculation_589408605726945292]&#10;&#10;WHEN &apos;Report Quarter&apos; THEN [Calculation_5486580677879509004]&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='% Orders w Food is Ready' datatype='real' default-format='p0.0%' name='[Calculation_2804546360846450688]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([food_is_ready]) / (SUM([orders_completed]) + SUM([orders_cancelled]))' />
            </column>
            <column caption='Report Quarter' datatype='string' name='[Calculation_5486580677879509004]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(YEAR([report_date])) + &quot;-Q&quot;+ STR(QUARTER([report_date]))' />
            </column>
            <column caption='Report Week' datatype='string' datatype-customized='true' default-format='*yyyy-ww' name='[Calculation_582371729572569088]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[start_dateweek]' />
            </column>
