      <table>
        <view>
          <datasources>
            <datasource caption='logistics dashboard v4' name='federated.0qfwv2z0njkjcz18bfp0v199lqmg' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='T granularity ' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0qfwv2z0njkjcz18bfp0v199lqmg'>
            <column caption='Logistics Index' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1134907111286050817]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_916764006825598979]/[Calculation_916764006829854729]' />
            </column>
            <column caption='Report Quarter' datatype='string' name='[Calculation_5486580677879509004]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(YEAR([report_date])) + &quot;-Q&quot;+ STR(QUARTER([report_date]))' />
            </column>
            <column caption='Report Week' datatype='string' datatype-customized='true' default-format='*yyyy-ww' name='[Calculation_582371729572569088]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[start_dateweek]' />
            </column>
            <column caption='Report Month ' datatype='string' name='[Calculation_589408605726945292]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[start_date_month]' />
            </column>
            <column caption='DT (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_916764006825598979]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dt_numerator])/ SUM([dt_denominator])' />
            </column>
            <column caption='UTR' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_916764006829854729]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_completed])/SUM([working_time])' />
            </column>
            <column caption='(t-dimension)' datatype='string' name='[Calculation_916764006880329741]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case  [Parameters].[Parameter 2]&#10;WHEN &apos;Quarter&apos; THEN [Calculation_5486580677879509004]&#13;&#10;WHEN &apos;Month&apos;   THEN [Calculation_589408605726945292]&#13;&#10;WHEN &apos;Week&apos;   THEN [Calculation_582371729572569088] &#13;&#10;END' />
            </column>
            <column caption='Weekday' datatype='date' default-format='*ddd' name='[Report Date (copy 2)]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[report_date]' />
            </column>
            <column caption='Timeframe' datatype='date' datatype-customized='true' default-format='*yyyy-ww' name='[Report Week (copy)]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[report_date]' />
