            <column caption='City Name' datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Contract Type' datatype='string' name='[contract_type]' role='dimension' type='nominal' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='# Deliveries' datatype='integer' name='[deliveries]' role='measure' type='quantitative' />
            <column caption='Delivery costs [EUR]' datatype='real' name='[delivery_costs_eur]' role='measure' type='quantitative' />
