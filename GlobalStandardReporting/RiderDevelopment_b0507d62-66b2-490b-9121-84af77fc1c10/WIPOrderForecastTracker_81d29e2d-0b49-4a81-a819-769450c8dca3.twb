              <calculation class='tableau' formula='CASE [Parameters].[Dimension A (copy)_929782276070653968]&#10;WHEN &apos;Country Code&apos; THEN  [country_code]&#10;WHEN &apos;City Name&apos; THEN  [city_name]&#10;WHEN &apos;Zone Name&apos; THEN [zone_name]&#10;WHEN &apos;Weekday&apos; THEN [weekday]&#10;WHEN &apos;Is Special Day&apos; then if[is_special_day] = true then &apos;True&apos; else &apos;False&apos; END&#10;WHEN &apos;Forecast Created Date&apos; THEN [forecast_created_date]&#10;WHEN &apos;None&apos; THEN &apos;&apos;&#10;END' />
            </column>
            <column caption='Metric' datatype='real' name='[Calculation_929782276081061907]' role='measure' type='quantitative'>
