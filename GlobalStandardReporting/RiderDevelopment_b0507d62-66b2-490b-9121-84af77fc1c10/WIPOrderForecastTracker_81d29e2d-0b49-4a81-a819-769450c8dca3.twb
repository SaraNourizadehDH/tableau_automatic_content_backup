            </column>
            <column caption='Accuracy Metric' datatype='real' name='[Calculation_929782276036956170]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Time Granularity (copy)]&#10;WHEN &apos;MAPE&apos; THEN [Calculation_929782276018794502]*100&#10;WHEN &apos;RMSE&apos; THEN [MSE (copy)_929782276036808713]&#10;WHEN &apos;MSE&apos; THEN [MAPE (copy)_929782276034613255]&#10;WHEN &apos;WAPE&apos; THEN [MAPE (copy)_7180215550051061760]&#10;END' />
