              <calculation class='tableau' formula='CASE [Parameters].[Report Date Parameter]&#10;WHEN &apos;Monthly&apos; THEN [report_month]&#10;WHEN &apos;Weekly&apos; THEN [report_week]&#10;WHEN &apos;Daily&apos; THEN STR([report_date])&#10;WHEN &apos;Weekday&apos; THEN [weekday]&#10;END' />
