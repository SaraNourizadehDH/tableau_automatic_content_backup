            <column caption='MSE Exp Orders Latest' datatype='real' name='[Calculation_1232367874270085120]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(POWER([error_exp_orders_latest_n], 2))&#10;/&#10;SUM([error_exp_orders_latest_d])' />
