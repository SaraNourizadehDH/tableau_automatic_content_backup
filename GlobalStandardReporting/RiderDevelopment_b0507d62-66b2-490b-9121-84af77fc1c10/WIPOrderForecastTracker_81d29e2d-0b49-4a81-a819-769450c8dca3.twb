      <column caption='MSE Exp Orders Latest' datatype='real' name='[Calculation_1232367874270085120]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(POWER([error_exp_orders_latest_n], 2))&#10;/&#10;SUM([error_exp_orders_latest_d])' />
      </column>
      <column caption='RMSE Exp Orders Latest' datatype='real' name='[Calculation_1232367874270674945]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SQRT(SUM(POWER([error_exp_orders_latest_n], 2))&#10;/&#10;SUM([error_exp_orders_latest_d]))' />
      </column>
      <column aggregation='Attribute' caption='Forecast created date (1)' datatype='string' name='[Calculation_4367013954197848064]' role='measure' type='nominal'>
        <calculation class='tableau' formula='{EXCLUDE   [forecast_created_date]: MIN([forecast_created_date])}' />
      </column>
      <column aggregation='Attribute' caption='Is Filteed Forecast Created Date' datatype='string' name='[Calculation_4367013954198622209]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [forecast_created_date]  = [Calculation_4367013954197848064]&#10;then &apos;include&apos;&#10;else &apos;exclude&apos;&#10;end' />
      </column>
      <column caption='MAPE Exp Orders Latest' datatype='real' name='[Calculation_929782275770499072]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([mape_exp_orders_latest_n])&#10;/ &#10;SUM([mape_exp_orders_latest_d])' />
      </column>
      <column caption='Time Granularity' datatype='string' name='[Calculation_929782276016926724]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Report Date Parameter]&#10;WHEN &apos;Monthly&apos; THEN [report_month]&#10;WHEN &apos;Weekly&apos; THEN [report_week]&#10;WHEN &apos;Daily&apos; THEN STR([report_date])&#10;WHEN &apos;Weekday&apos; THEN [weekday]&#10;END' />
      </column>
      <column caption='MAPE' datatype='real' name='[Calculation_929782276018794502]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Accuracy Metric (copy)]&#10;WHEN &apos;Forecast&apos; THEN [MAPE Exp Orders Latest (copy)_929782275770724353] &#10;WHEN &apos;Adjusted Forecast&apos; THEN [Calculation_929782275770499072]&#10;END' />
      </column>
      <column caption='Accuracy Metric' datatype='real' name='[Calculation_929782276036956170]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Time Granularity (copy)]&#10;WHEN &apos;MAPE&apos; THEN [Calculation_929782276018794502]*100&#10;WHEN &apos;RMSE&apos; THEN [MSE (copy)_929782276036808713]&#10;WHEN &apos;MSE&apos; THEN [MAPE (copy)_929782276034613255]&#10;WHEN &apos;WAPE&apos; THEN [MAPE (copy)_7180215550051061760]&#10;END' />
      </column>
      <column caption='Special day label' datatype='string' name='[Calculation_929782276039933963]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_special_day]= TRUE &#10;THEN [special_day_type]&#10;else null&#10;end' />
      </column>
      <column caption='Gross Orders' datatype='integer' name='[Calculation_929782276046028813]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[orders_lost_net] + [orders]' />
      </column>
      <column caption='Dimension A' datatype='string' name='[Calculation_929782276069527567]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Accuracy Metric (copy 2)]&#10;WHEN &apos;Country Code&apos; THEN  [country_code]&#10;WHEN &apos;City Name&apos; THEN  [city_name]&#10;WHEN &apos;Zone Name&apos; THEN [zone_name]&#10;WHEN &apos;Weekday&apos; THEN [weekday]&#10;WHEN &apos;Is Special Day&apos; then if[is_special_day] = TRUE then &apos;True&apos; else &apos;False&apos; END&#10;WHEN &apos;Forecast Created Date&apos; THEN [forecast_created_date]&#10;END' />
      </column>
      <column caption='Dimension B' datatype='string' name='[Calculation_929782276070711313]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Dimension A (copy)_929782276070653968]&#10;WHEN &apos;Country Code&apos; THEN  [country_code]&#10;WHEN &apos;City Name&apos; THEN  [city_name]&#10;WHEN &apos;Zone Name&apos; THEN [zone_name]&#10;WHEN &apos;Weekday&apos; THEN [weekday]&#10;WHEN &apos;Is Special Day&apos; then if[is_special_day] = true then &apos;True&apos; else &apos;False&apos; END&#10;WHEN &apos;Forecast Created Date&apos; THEN [forecast_created_date]&#10;WHEN &apos;None&apos; THEN &apos;&apos;&#10;END' />
      </column>
      <column caption='Metric' datatype='real' name='[Calculation_929782276081061907]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Time Granularity (copy 2)]&#10;WHEN &apos;Orders&apos; THEN SUM([orders])&#10;WHEN &apos;Lost Orders&apos; THEN SUM([orders_lost_net])&#10;WHEN &apos;Forcasted Orders&apos; THEN SUM([MAPE (copy)_929782276041220108])&#10;WHEN &apos;MAPE&apos; THEN [Calculation_929782276018794502]*100&#10;WHEN &apos;MSE&apos; THEN [MAPE (copy)_929782276034613255]&#10;WHEN &apos;RMSE&apos; THEN [MSE (copy)_929782276036808713]&#10;WHEN &apos;WAPE&apos; THEN [MAPE (copy)_7180215550051061760]*100&#10;END' />
      </column>
      <column caption='WAPE' datatype='real' name='[MAPE (copy)_7180215550051061760]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Accuracy Metric (copy)]&#10;WHEN &apos;Forecast&apos; THEN [MAPE Original Orders (copy)_7180215550051278852] &#10;WHEN &apos;Adjusted Forecast&apos; THEN [MAPE Exp Orders Latest (copy)_7180215550051074049]&#10;END' />
