        <calculation class='tableau' formula='CASE [Parameters].[Accuracy Metric (copy)]&#10;WHEN &apos;Forecast&apos; THEN [original_orders] &#10;WHEN &apos;Adjusted Forecast&apos; THEN [exp_orders_latest]&#10;END' />
