              <calculation class='tableau' formula='20' />
              <range min='0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1jl2m011oczhsq14603xx0p42keg'>
            <column caption='# Riders &gt; D' datatype='integer' name='[# Riders &gt; A (copy) (copy) (copy)_4998291902997995529]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [delivery_sum_per_day] &gt; [Parameters].[Parameter A (copy) (copy) (copy)_4998291902997213188] THEN [rider_id]&#10;ELSE NULL &#10;END)' />
            </column>
            <column caption='After contract starts' datatype='boolean' name='[Calculation_2272840071560495104]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date] &gt;= [contract_start_date_local]' />
