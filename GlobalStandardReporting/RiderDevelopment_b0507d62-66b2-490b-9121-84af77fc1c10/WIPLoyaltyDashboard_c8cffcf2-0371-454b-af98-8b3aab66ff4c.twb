      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/WIPLoyaltyDashboard/CustomTabularView?rev=' id='CustomTabularView' path='/t/GlobalStandardReporting/workbooks/WIPLoyaltyDashboard' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='parameter-ctrl'>
          <format attr='background-color' value='#f5f5f5' />
        </style-rule>
      </style>
      <size maxheight='2000' maxwidth='1800' minheight='1600' minwidth='1500' sizing-mode='range' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='da_rider_loyalty_dashboard+ (cl)' name='federated.1jl2m011oczhsq14603xx0p42keg' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Dimension B' datatype='string' name='[Dimension A (copy)_5785084834142334977]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country Code&quot;'>
          <calculation class='tableau' formula='&quot;Country Code&quot;' />
          <members>
            <member value='&quot;Region&quot;' />
            <member value='&quot;Country Code&quot;' />
            <member value='&quot;Country Name&quot;' />
            <member value='&quot;City Name&quot;' />
            <member value='&quot;None&quot;' />
          </members>
        </column>
        <column caption='Order Threshold A' datatype='integer' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='10'>
          <calculation class='tableau' formula='10' />
          <range min='0' />
        </column>
        <column caption='Choose Type' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Absolute&quot;'>
          <calculation class='tableau' formula='&quot;Absolute&quot;' />
          <members>
            <member value='&quot;Absolute&quot;' />
            <member value='&quot;Percentage&quot;' />
