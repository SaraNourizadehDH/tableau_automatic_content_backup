            </column>
            <column caption='# Churn Riders' datatype='integer' name='[Churn Riders (copy)_5074430889593499648]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [cumulative_churn] = TRUE THEN [rider_id] END)' />
            </column>
            <column caption='# Churn Riders &gt; 0' datatype='integer' name='[Churn Riders &gt; 0 (copy)_5074430889593585665]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [cumulative_churn] = TRUE &#10;    AND [delivery_sum_per_day] &gt; 0&#10;THEN [rider_id] END)' />
            </column>
            <column caption='# Churn Riders &gt; A' datatype='integer' name='[Churn Riders &gt; A (copy)_5074430889593794562]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [cumulative_churn] = TRUE &#10;    AND [delivery_sum_per_day] &gt; [Parameters].[Parameter 1]&#10;THEN [rider_id] END)' />
            </column>
            <column caption='# Churn Riders &gt; B' datatype='integer' name='[Churn Riders &gt; B (copy)_5074430889593810947]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [cumulative_churn] = TRUE &#10;    AND [delivery_sum_per_day] &gt; [Parameters].[Parameter A (copy)_4998291902997168130]&#10;THEN [rider_id] END)' />
            </column>
            <column caption='# Churn Riders &gt; C' datatype='integer' name='[Churn Riders &gt; C (copy)_5074430889593839620]' role='measure' type='quantitative'>
