        <calculation class='tableau' formula='[Active Riders (copy) (copy)_6225100589441245189] / ([Calculation_6225100589349171200] + [Active Riders (copy)_6225100589441232900] + [Active Riders (copy) (copy)_6225100589441245189])' />
