              <calculation class='tableau' formula='10' />
              <range min='0' />
            </column>
            <column caption='Choose Type' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Absolute&quot;'>
              <calculation class='tableau' formula='&quot;Absolute&quot;' />
            </column>
            <column caption='Order Threshold D' datatype='integer' name='[Parameter A (copy) (copy) (copy)_4998291902997213188]' param-domain-type='range' role='measure' type='quantitative' value='100'>
              <calculation class='tableau' formula='100' />
              <range min='0' />
            </column>
            <column caption='Order Threshold C' datatype='integer' name='[Parameter A (copy) (copy)_4998291902997188611]' param-domain-type='range' role='measure' type='quantitative' value='30'>
              <calculation class='tableau' formula='30' />
              <range min='0' />
            </column>
