  <datasources>
    <datasource caption='Test_Activation' inline='true' name='federated.14cwxyc09olo4q10b2jl01bimk1v' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.10ucgbn07qemmj10qxv800dvazvd'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dh-vt-rsc-6006' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='curated_data_shared_govops' server-oauth='' username='johann.grobler@deliveryhero.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation join='inner' type='join'>
          <clause type='join'>
            <expression op='='>
              <expression op='[Custom SQL Query].[global_entity_id]' />
              <expression op='[tableau_gsr_entitlements_global_entity_id].[global_entity_id]' />
            </expression>
          </clause>
          <relation connection='bigquery.10ucgbn07qemmj10qxv800dvazvd' name='Custom SQL Query' type='text'><![CDATA[WITH rest_base AS (
  SELECT DISTINCT a.id
    , a.entity_id AS global_entity_id
    , datetime(a.created_at,d.timezone) AS created_at
    , CAST(DATE_TRUNC(DATETIME(a.created_at,d.timezone),day) AS DATE)AS created_at_date
    , CAST(DATE_TRUNC(DATETIME(a.created_at,d.timezone),WEEK(MONDAY)) AS DATE) AS week_date
    , CAST(DATE_TRUNC(DATETIME(a.created_at,d.timezone),month) AS DATE) AS month_date
    , a.restaurant_id AS vendor_id
    , a.supplier_id
    , a.status
  FROM `fulfillment-dwh-production.dl_sales_revenue.rsc_app_data_orders` a 
  LEFT JOIN `fulfillment-dwh-production.dl_sales_revenue.rsc_app_data_suppliers` b  
  ON a.entity_id = b.entity_id 
    AND b.id = a.supplier_id
  LEFT JOIN `fulfillment-dwh-production.dl_sales_revenue.rsc_app_data_restaurants` c 
  ON a.entity_id = c.entity_id 
    AND c.id = a.restaurant_id
  INNER JOIN  `fulfillment-dwh-production.curated_data_shared_data_stream.timezones`d
    ON d.global_entity_id = a.entity_id
  LEFT JOIN fulfillment-dwh-production.rl_sales_revenue.rsc_vendor_period_exclusion_table e 
  ON e.global_entity_id = a.entity_id
    AND e.vendor_id = a.restaurant_id
  WHERE a.deleted = FALSE
    AND DATE(a.merge_layer_updated_at)>> '2022-11-01'
    AND NOT CONTAINS_SUBSTR(LOWER(b.name), 'test_')
    AND NOT CONTAINS_SUBSTR(LOWER(b.name), 'demo_') 
    AND a.status NOT LIKE '%cancel%'
    AND a.status NOT LIKE '%rejected%'
    AND b.name not like '%stock_balance%'
    AND NOT (a.entity_id = 'PY_CL' AND (a.supplier_id = 8 OR a.supplier_id = 21 OR a.supplier_id = 103))
    AND NOT b.is_packaging = TRUE
    AND NOT (e.vendor_id IS NOT NULL AND DATE(a.created_at) >>= e.exclusion_period_start_date AND DATE(a.created_at) << e.exclusion_period_end_date)
    AND (
      (a.entity_id = 'FP_HK' AND LOWER(b.name) NOT LIKE '%foodpanda rest%') 
      OR a.entity_id = 'FP_SG' 
      OR (a.entity_id = 'MJM_AT' AND LOWER(b.name) NOT LIKE '%mjam%') 
      OR (
        a.entity_id= 'PY_CL' 
        AND LOWER(b.name) <<>>'efe test supplier' 
        AND LOWER(b.name) <<>> 'valentin cl email' 
        AND a.created_at >> '2022-01-16'
      )
      OR a.entity_id = 'FP_MY'
      OR a.entity_id = 'FP_TH'
      OR a.entity_id = 'TB_QA'
    )
), activation_base AS (
  SELECT a.*
  , DENSE_RANK() OVER (PARTITION BY global_entity_id, vendor_id ORDER BY created_at_date) AS order_day
  FROM rest_base a
), activation_stats AS (
  SELECT global_entity_id
    , vendor_id
    , MIN(
      CASE 
        WHEN order_day = 2
          THEN  created_at_date
      END) AS activation_date
    , MIN(
      CASE 
        WHEN order_day = 2
          THEN week_date
      END) AS activation_week  
    , MIN(
      CASE 
        WHEN order_day = 2
          THEN month_date
      END) AS activation_month  
    , COUNT(DISTINCT
      CASE
        WHEN order_day <<= 2
          THEN supplier_id
      END) AS no_activation_suppliers
    , 'Traditional' AS activation_critieria
  FROM activation_base
  GROUP BY 1,2
), vendor_supp_strict AS (
  SELECT global_entity_id
    , vendor_id
    , supplier_id
    , MIN(created_at) AS min_vendor_supp_date_time
  FROM rest_base 
  GROUP BY 1,2,3
), sf_salesmanager as (
select global_entity_id,
vendor_code__c, 
bb.ownername,
case when strpos(vendor_code__c, '-')>> 0 
then substr(vendor_code__c,strpos(vendor_code__c, '-')+1)
else vendor_code__c
end as clean_
from fulfillment-dwh-production.curated_data_shared_salesforce_rsc.lead bb
where vendor_code__c is not null
), vendor_supp_rank_strict AS (
  SELECT global_entity_id
  , vendor_id
  , supplier_id
  , min_vendor_supp_date_time
  , COUNT(vendor_id) OVER (PARTITION BY global_entity_id, vendor_id ORDER BY min_vendor_supp_date_time) AS supp_vendor_rank
  FROM vendor_supp_strict  a
), strict_criteria_base AS (
  SELECT a.global_entity_id
  , a.vendor_id
  , MIN(
    CASE 
      WHEN order_day = 3
        THEN created_at_date
    END) AS order_day_3_date
  , MIN(
    CASE 
      WHEN order_day = 5
        THEN created_at_date 
    END) AS order_day_5_date
  , MIN(
    CASE 
      WHEN b.supp_vendor_rank = 2
        THEN DATE(min_vendor_supp_date_time)
    END) AS order_day_2nd_supplier
  FROM activation_base a
  LEFT JOIN vendor_supp_rank_strict b 
  ON a.global_entity_id = b.global_entity_id 
    AND a.vendor_id = b.vendor_id
  GROUP BY 1,2
), selection_critieria AS (
   SELECT global_entity_id
  , vendor_id
  , CASE
      WHEN order_day_2nd_supplier <<= order_day_3_date
        THEN order_day_3_date
      WHEN order_day_2nd_supplier >> order_day_3_date AND order_day_2nd_supplier << order_day_5_date
        THEN order_day_2nd_supplier
    ELSE order_day_5_date
    END AS activation_date
  FROM strict_criteria_base
), strct_final AS (
 SELECT a.*
    , CAST(DATE_TRUNC(activation_date,WEEK(MONDAY)) AS DATE) AS activation_week
    , CAST(DATE_TRUNC(activation_date,MONTH) AS DATE) AS activation_month
    , COUNT(DISTINCT 
      CASE 
        WHEN b.created_at_date <<= activation_date
          THEN supplier_id
      END) AS no_activation_suppliers
    , 'Strict' AS activation_critieria
  FROM selection_critieria a
  INNER JOIN activation_base b 
  ON a.global_entity_id = b.global_entity_id 
    AND a.vendor_id = b.vendor_id

  GROUP BY 1,2,3
)
SELECT a.global_entity_id
  , a.vendor_id
  , b.code AS vendor_code
  , b.name AS vendor_name
  , a.activation_date
  , a.activation_week
  , COUNT(
    CASE 
      WHEN c.week_date >> a.activation_week
      AND c.week_date <<= DATE_ADD(a.activation_week, INTERVAL 1 week)
      THEN c.id
      END) AS order_w1_after_activation
  , COUNT(
    CASE 
      WHEN c.week_date >> DATE_ADD(a.activation_week, INTERVAL 1 week)
      AND c.week_date <<= DATE_ADD(a.activation_week, INTERVAL 2 week)
      THEN c.id
      END) AS order_w2_after_activation
  , CASE
      WHEN DATE_ADD(a.activation_week, INTERVAL 2 week) <<= CURRENT_DATE()
      THEN 1
      ELSE 0
      END AS activation_lenght_W1
  ,   CASE
      WHEN DATE_ADD(a.activation_week, INTERVAL 3 week) <<= CURRENT_DATE()
      THEN 1
      ELSE 0
      END AS activation_lenght_W2
  , a.activation_month
  , a.no_activation_suppliers
  , a.activation_critieria
  , d.ownername as sales_manager
FROM activation_stats a
INNER JOIN `fulfillment-dwh-production.dl_sales_revenue.rsc_app_data_restaurants` b
ON a.global_entity_id = b.entity_id
  AND a.vendor_id = b.id
INNER JOIN activation_base c 
ON a.global_entity_id = c.global_entity_id 
  AND a.vendor_id = c.vendor_id
LEFT JOIN sf_salesmanager d 
ON d.global_entity_id = b.entity_id
  AND d.clean_ = b.code
WHERE activation_date IS NOT NULL
  AND activation_date >> DATE_SUB(DATE_TRUNC(CURRENT_DATE(), month), INTERVAL 6 MONTH)
GROUP BY 1,2,3,4,5,6,9,10,11,12,13,14

UNION ALL

SELECT a.global_entity_id
  , a.vendor_id
  , b.code AS vendor_code
  , b.name AS vendor_name
  , a.activation_date
  , a.activation_week
  , COUNT(
    CASE 
      WHEN c.week_date >> a.activation_week
      AND c.week_date <<= DATE_ADD(a.activation_week, INTERVAL 1 week)
      THEN c.id
      END )AS order_w1_after_activation
  , COUNT(
    CASE 
      WHEN c.week_date >> DATE_ADD(a.activation_week, INTERVAL 1 week)
      AND c.week_date <<= DATE_ADD(a.activation_week, INTERVAL 2 week)
      THEN c.id
      END) AS order_w2_after_activation
  , CASE
      WHEN DATE_ADD(a.activation_week, INTERVAL 2 week) <<= CURRENT_DATE()
      THEN 1
      ELSE 0
      END AS activation_lenght_W1
  , CASE
      WHEN DATE_ADD(a.activation_week, INTERVAL 3 week) <<= CURRENT_DATE()
      THEN 1
      ELSE 0
      END AS activation_lenght_W2
  , a.activation_month
  , a.no_activation_suppliers
  , a.activation_critieria
  , d.ownername as sales_manager
FROM strct_final a
INNER JOIN `fulfillment-dwh-production.dl_sales_revenue.rsc_app_data_restaurants` b
ON a.global_entity_id = b.entity_id
  AND a.vendor_id = b.id
INNER JOIN activation_base c 
ON a.global_entity_id = c.global_entity_id 
  AND a.vendor_id = c.vendor_id
LEFT JOIN sf_salesmanager d 
ON d.global_entity_id = b.entity_id
  AND d.clean_ = b.code
WHERE activation_date IS NOT NULL
  AND activation_date >> DATE_SUB(DATE_TRUNC(CURRENT_DATE(), month), INTERVAL 6 MONTH)
GROUP BY 1,2,3,4,5,6,9,10,11,12,13,14]]></relation>
