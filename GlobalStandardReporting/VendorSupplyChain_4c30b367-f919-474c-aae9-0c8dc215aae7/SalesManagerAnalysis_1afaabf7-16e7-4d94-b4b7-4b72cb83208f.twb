        </_.fcp.ObjectModelEncapsulateLegacy.true...relation>
        <cols>
          <map key='[access_group]' value='[tableau_gsr_entitlements_global_entity_id].[access_group]' />
          <map key='[activation_critieria]' value='[Custom SQL Query].[activation_critieria]' />
          <map key='[activation_date]' value='[Custom SQL Query].[activation_date]' />
          <map key='[activation_lenght_W1]' value='[Custom SQL Query].[activation_lenght_W1]' />
          <map key='[activation_lenght_W2]' value='[Custom SQL Query].[activation_lenght_W2]' />
