vendor_code__c, 
bb.ownername,
case when strpos(vendor_code__c, '-')>> 0 
then substr(vendor_code__c,strpos(vendor_code__c, '-')+1)
else vendor_code__c
end as clean_
from fulfillment-dwh-production.curated_data_shared_salesforce_rsc.lead bb
where vendor_code__c is not null
), vendor_supp_rank_strict AS (
