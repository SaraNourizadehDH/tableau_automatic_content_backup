  LEFT JOIN vendor_supp_rank_strict b 
  ON a.global_entity_id = b.global_entity_id 
    AND a.vendor_id = b.vendor_id
  GROUP BY 1,2
), selection_critieria AS (
   SELECT global_entity_id
  , vendor_id
  , CASE
      WHEN order_day_2nd_supplier <<= order_day_3_date
        THEN order_day_3_date
