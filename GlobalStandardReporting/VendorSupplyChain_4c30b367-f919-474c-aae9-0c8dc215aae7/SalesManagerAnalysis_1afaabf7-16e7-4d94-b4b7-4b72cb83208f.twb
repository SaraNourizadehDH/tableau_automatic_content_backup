          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='Activation Suppliers'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='11'>Average number of activation suppliers</run>
