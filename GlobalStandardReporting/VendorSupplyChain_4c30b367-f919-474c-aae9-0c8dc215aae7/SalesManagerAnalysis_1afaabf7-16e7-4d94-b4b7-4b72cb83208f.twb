  <dashboards>
    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Definitions'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/SalesManagerAnalysis/Definitions?rev=' id='Definitions' path='/t/GlobalStandardReporting/workbooks/SalesManagerAnalysis' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='768' maxwidth='1366' minheight='768' minwidth='1366' preset-index='0' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='8' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='83203' id='7' type-v2='text' w='98828' x='586' y='15755'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontsize='14'>Dashboard Definitions:</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontsize='10'>Dashboard Section 1: Filters sections (Top part of dashboard with dropdown filters)</run>
              <run>Æ&#10;</run>
              <run fontsize='10'>____________________________________________________________________________________________________</run>
              <run>Æ&#10;</run>
              <run bold='true' fontsize='10'>Activation criteria filter:</run>
              <run>Æ&#10;</run>
              <run bold='true' fontsize='10'>Traditional - </run>
              <run fontsize='10'>Activation takes place with the first uncancelled order on the 2nd order day</run>
              <run>Æ&#10;</run>
              <run bold='true' fontsize='10'>Strict - Activation takes place on:</run>
              <run>Æ&#10;</run>
              <run fontsize='10'>     a. The first uncancelled order on the 3rd order day, if the restaurant has ordered from at least 2 different suppliers between order day 1 - 3</run>
              <run>Æ&#10;</run>
              <run fontsize='10'>     b. The first uncancelled order on the 5th order day if the restaurant has ordered only from 1 supplier between order day 1 - 5</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontsize='10'>Dashboard Section 2: Metrics and visuals section</run>
              <run>Æ&#10;</run>
              <run fontsize='10'>_____________________________________________________________________________________________________</run>
              <run>Æ&#10;</run>
              <run bold='true' fontsize='10'>Total activations:</run>
              <run>Æ&#10;</run>
              <run fontsize='10'>Total number of activations as per selected criteria</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontsize='10'>% Restaurants who ordered in W1 and W2 after activation:</run>
              <run>Æ&#10;</run>
              <run fontsize='10'> If a restaurant has at least 1 uncancelled order in the respective first calendar week after activation W1(starting on a Monday) , or second calendar week after after activation W2 this will count towards this metric</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontsize='10'>Average activation suppliers:</run>
              <run>Æ&#10;</run>
              <run fontsize='10'>(Total number of distinct suppliers that received an uncancelled order, up until and including the activation day) / (Total number of restaurants activated)</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='solid' />
              <format attr='border-width' value='1' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='14713' id='9' type-v2='text' w='98828' x='586' y='1042'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontsize='14'>Dashboard Scope:</run>
              <run>Æ&#10;</run>
              <run fontsize='10'>Only uncancelled orders are considered</run>
              <run>Æ&#10;</run>
              <run fontsize='10'>Sales Manager will have a &apos;Null&apos; Value if the account management input Gsheet does not contain the Sales Manager</run>
              <run bold='true' fontsize='10'> linked to a restaurant</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='solid' />
              <format attr='border-width' value='1' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
