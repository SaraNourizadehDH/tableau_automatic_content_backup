      <column caption='Username' datatype='string' name='[username]' role='dimension' type='nominal' />
      <column-instance column='[date]' derivation='None' name='[none:date:ok]' pivot='key' type='ordinal' />
      <column-instance column='[No_Active_Rests]' derivation='Sum' name='[sum:No_Active_Rests:qk]' pivot='key' type='quantitative' />
      <column-instance column='[Activated_rests_Run_Sum (copy)_849772970595262473]' derivation='User' name='[usr:Activated_rests_Run_Sum (copy)_849772970595262473:qk]' pivot='key' type='quantitative'>
        <table-calc ordering-field='[federated.1dshx221no1yfr1carbke00x3mkw].[date]' ordering-type='Field' />
      </column-instance>
      <column-instance column='[Calculation_849772970588651526]' derivation='User' name='[usr:Calculation_849772970588651526:qk]' pivot='key' type='quantitative'>
        <table-calc ordering-type='Rows' />
      </column-instance>
      <group name='[User Filter 1]' name-style='unqualified' user:ui-builder='identity-set'>
        <groupfilter function='intersection'>
          <groupfilter function='level-members' level='[market]' />
          <groupfilter function='union'>
            <groupfilter expression='false' function='filter'>
              <groupfilter function='level-members' level='[market]' />
            </groupfilter>
            <groupfilter expression='ISMEMBEROF(&apos;gsr_sales_developer&apos;)' function='filter'>
              <groupfilter function='union'>
                <groupfilter function='member' level='[market]' member='&quot;FP_HK&quot;' />
                <groupfilter function='member' level='[market]' member='&quot;FP_MY&quot;' />
                <groupfilter function='member' level='[market]' member='&quot;FP_SG&quot;' />
                <groupfilter function='member' level='[market]' member='&quot;MJM_AT&quot;' />
                <groupfilter function='member' level='[market]' member='&quot;PY_CL&quot;' />
              </groupfilter>
            </groupfilter>
            <groupfilter expression='ISMEMBEROF(&apos;gsr_sales_enduser&apos;)' function='filter'>
              <groupfilter function='union'>
                <groupfilter function='member' level='[market]' member='&quot;FP_HK&quot;' />
                <groupfilter function='member' level='[market]' member='&quot;FP_MY&quot;' />
                <groupfilter function='member' level='[market]' member='&quot;FP_SG&quot;' />
                <groupfilter function='member' level='[market]' member='&quot;MJM_AT&quot;' />
                <groupfilter function='member' level='[market]' member='&quot;PY_CL&quot;' />
              </groupfilter>
            </groupfilter>
            <groupfilter expression='ISMEMBEROF(&apos;gsr_sales_foodpanda_APAC_enduser&apos;)' function='filter'>
              <groupfilter function='union'>
                <groupfilter function='member' level='[market]' member='&quot;FP_HK&quot;' />
                <groupfilter function='member' level='[market]' member='&quot;FP_MY&quot;' />
                <groupfilter function='member' level='[market]' member='&quot;FP_SG&quot;' />
              </groupfilter>
            </groupfilter>
