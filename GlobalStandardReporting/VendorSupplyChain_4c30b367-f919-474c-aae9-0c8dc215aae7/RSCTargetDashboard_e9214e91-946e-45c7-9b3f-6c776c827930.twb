      <column caption='Days in Month' datatype='integer' name='[Calculation_2169327660599406592]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEPART(&apos;day&apos;, DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [first_day_of_month]))))' />
