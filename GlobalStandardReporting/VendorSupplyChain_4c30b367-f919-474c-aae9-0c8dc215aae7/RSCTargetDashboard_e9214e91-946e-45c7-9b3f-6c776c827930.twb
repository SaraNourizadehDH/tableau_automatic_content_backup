      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_FF8C74DFF08C4E2CBF8BB41E009BBDB0'>
            <properties context=''>
              <relation join='inner' type='join'>
                <clause type='join'>
                  <expression op='='>
                    <expression op='[Custom SQL Query].[market]' />
                    <expression op='[tableau_gsr_entitlements_global_entity_id].[global_entity_id]' />
                  </expression>
                </clause>
                <relation connection='bigquery.1p4esd40s0d38t1dghc531v9w2ob' name='Custom SQL Query' type='text'><![CDATA[WITH Rest_Base_1 as
(
select 
distinct a.id,
a.entity_id,
cast(date_trunc(datetime(a.created_at,d.timezone),day) as date)as Day_date,
cast(date_trunc(datetime(a.created_at,d.timezone),WEEK(MONDAY)) as date) as Week_date,
cast(date_trunc(datetime(a.created_at,d.timezone),month) as date) as Month_date,
a.restaurant_id,
a.supplier_id,
from`fulfillment-dwh-production.dl_sales_revenue.rsc_app_data_orders` a 
left join `fulfillment-dwh-production.dl_sales_revenue.rsc_app_data_suppliers` b  on a.entity_id = b.entity_id and b.id = a.supplier_id
left join `fulfillment-dwh-production.dl_sales_revenue.rsc_app_data_restaurants` c on a.entity_id = c.entity_id and c.id = a.restaurant_id
inner join  `fulfillment-dwh-production.curated_data_shared_data_stream.timezones`d on d.global_entity_id = a.entity_id
where not CONTAINS_SUBSTR(lower(b.name), 'test_')
and not CONTAINS_SUBSTR(lower(b.name), 'demo_')
and ((a.entity_id = 'FP_HK' and lower(b.name) not like '%foodpanda rest%') or a.entity_id = 'FP_SG' or (a.entity_id = 'MJM_AT' and lower(b.name) not like '%mjam%') or(a.entity_id = 'PY_CL' and lower(b.name) <<>>'efe test supplier' and lower(b.name) <<>> 'valentin cl email' and a.created_at >> '2022-01-16')or a.entity_id = 'FP_MY'or a.entity_id = 'FP_TH')
and not (a.entity_id = 'PY_CL' and (a.supplier_id = 8 or a.supplier_id = 21 or a.supplier_id = 103))
and not b.is_packaging = TRUE
and a.status not like '%cancel%'
and a.status not like '%rejected%'
and lower(b.name) not like '%stock_balance%'
and a.deleted = FALSE
and a.merge_layer_updated_at >> '2022-11-01'
),
rest_base as
(
select *,
dense_rank() over (partition by entity_id,restaurant_id order by Day_date) as Order_Day,
from Rest_Base_1
),
total_orders_d as
(
select day_date,
a.entity_id,
count(distinct id) as Total,
count (distinct
case when Order_Day = 2
then restaurant_id
end ) as No_Rests_activated,
count (distinct
case when Order_Day >> 1
then restaurant_id
end ) as No_Active_Rests_ordering,
from Rest_Base a
group by 1,2
),
total_orders_w as
(
select week_date,
a.entity_id,
count(distinct id) as Total,
count (distinct
case when Order_Day = 2
then restaurant_id
end ) as No_Rests_activated,
count (distinct
case when Order_Day >> 1
then restaurant_id
end ) as No_Active_Rests_ordering,
from Rest_Base a
group by 1,2
),Base_day as 
(
SELECT a.date
    , aa.entity_id AS market
    , 'Daily' AS Granularity,
  date_trunc(a.date,month) as Month_class
    from
(
SELECT DISTINCT DATE_TRUNC(iso_date, day) AS date
  FROM `fulfillment-dwh-production.curated_data_shared_central_dwh.dates` 
    WHERE iso_date BETWEEN date_sub(date_trunc(current_date(), month), interval 6 month)
 AND last_DAY(current_date())
)a
  cross join 
  (
  select distinct entity_id
  from rest_base
  where entity_id in   ('FP_HK' , 'MJM_AT',  'PY_CL', 'FP_SG', 'FP_MY', 'FP_TH')
  ) aa
),
daily_final as
(
select a.*,
b.total as Total,
b.No_Rests_activated,
from Base_day a
left join total_orders_d b on a.date = b.day_date and a.market = b.entity_id
)
,
 Base_week as 
(
SELECT a.date
    , aa.entity_id AS market
    , 'Weekly' AS Granularity,
    case when date_trunc(last_day_of_week,month) >> first_day_of_month
    then date_add (first_day_of_month, interval 1 month)
    else first_day_of_month
    end as Month_Class
    from
(
SELECT DISTINCT DATE_TRUNC(iso_date, day) AS date,
last_day_of_week,
first_day_of_month
  FROM `fulfillment-dwh-production.curated_data_shared_central_dwh.dates` 
    WHERE iso_date BETWEEN date_sub(date_trunc(current_date(), month), interval 6 month)
 AND last_DAY(current_date())
 and day_of_week = 1
)a
  cross join 
  (
  select distinct entity_id
  from rest_base
  where entity_id in   ('FP_HK' , 'MJM_AT',  'PY_CL', 'FP_SG', 'FP_MY', 'FP_TH')
  ) aa
)
select a.*,
coalesce(d.No_Active_Rests_ordering,0) as No_Active_Rests,
coalesce(d.No_Rests_activated,0) as Activated_Rests,
coalesce(d.total,0) as Total_Orders
from Base_week a  
left join total_orders_w d on a.date = d.week_date and a.market = d.entity_id
where a.Month_class <<= date_trunc(current_date(),month)
union all
select a.*,
coalesce(d.No_Active_Rests_ordering,0) as No_Active_Rests,
coalesce(d.No_Rests_activated,0) as Activated_Rests,
coalesce(d.total,0) as Total_Orders
from Base_day a    
left join total_orders_d d on a.date = d.day_date and a.market = d.entity_id
where a.Month_class <<= date_trunc(current_date(),month)]]></relation>
                <relation connection='bigquery.1p4esd40s0d38t1dghc531v9w2ob' name='tableau_gsr_entitlements_global_entity_id' table='[fulfillment-dwh-production.curated_data_shared_govops].[tableau_gsr_entitlements_global_entity_id]' type='table' />
              </relation>
            </properties>
            <properties context='extract'>
              <relation join='inner' type='join'>
                <clause type='join'>
                  <expression op='='>
                    <expression op='[Custom SQL Query].[market]' />
                    <expression op='[tableau_gsr_entitlements_global_entity_id].[global_entity_id]' />
                  </expression>
                </clause>
                <relation name='Custom SQL Query' table='[Extract].[Custom SQL Query]' type='table' />
                <relation name='tableau_gsr_entitlements_global_entity_id' table='[Extract].[tableau_gsr_entitlements_global_entity_id]' type='table' />
              </relation>
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
