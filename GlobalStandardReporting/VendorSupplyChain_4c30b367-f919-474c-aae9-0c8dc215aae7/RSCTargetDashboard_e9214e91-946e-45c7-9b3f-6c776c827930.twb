      <aliases enabled='yes' />
      <column caption='Total_Orders_Run_Sum' datatype='integer' name='[Activated_rests_Run_Sum (copy)_849772970595262473]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if attr([date]) &lt;= today()&#13;&#10;then RUNNING_SUM(sum([Total_Orders]))&#13;&#10;END'>
          <table-calc ordering-field='[federated.1dshx221no1yfr1carbke00x3mkw].[date]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_2358478878649548800]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Activated_rests_Run_Sum' datatype='integer' name='[Calculation_849772970588651526]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if attr([date]) &lt;= today()&#13;&#10;then RUNNING_SUM(sum([Activated_Rests]))&#13;&#10;END'>
          <table-calc ordering-field='[federated.1dshx221no1yfr1carbke00x3mkw].[date]' ordering-type='Field' />
        </calculation>
      </column>
      <column datatype='date' default-format='*mmm/yy' name='[Month_Class]' role='dimension' type='ordinal' />
      <column datatype='integer' name='[No_Active_Rests]' role='measure' type='quantitative' />
      <_.fcp.ObjectModelTableType.true...column caption='Custom SQL Query' datatype='table' name='[__tableau_internal_object_id__].[_FF8C74DFF08C4E2CBF8BB41E009BBDB0]' role='measure' type='quantitative' />
      <column caption='Access Group' datatype='string' name='[access_group]' role='dimension' type='nominal' />
