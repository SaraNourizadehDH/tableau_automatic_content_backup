      <filter class='categorical' column='[market]' filter-group='2'>
        <groupfilter expression='ISNULL([market]) OR (NOT(CONTAINS(LOWER([market]), LOWER(&apos;FP_TH&apos;))))' function='filter' user:ui-enumeration='exclusive' user:ui-pattern-include-all-when-empty='true' user:ui-pattern_text='FP_TH' user:ui-pattern_type='contains'>
          <groupfilter function='level-members' level='[market]' user:ui-enumeration='all' user:ui-marker='enumerate' />
        </groupfilter>
