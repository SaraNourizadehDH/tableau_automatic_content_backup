          <zone forceUpdate='true' h='4335' id='26' type-v2='text' w='89992' x='9387' y='348'>
            <formatted-text>
              <run bold='true' fontalignment='1' fontsize='11'>Hey CPL Team,</run>
              <run fontalignment='1'>Æ&#10;</run>
              <run bold='true' fontalignment='1' fontsize='11'> Here&apos;s a quick summary of our recent CSAT and CES scores for our internal tools ( DPS, DAS and TES )</run>
              <run fontalignment='1'>Æ&#10;</run>
              <run bold='true' fontalignment='1' fontsize='11'> up to the most recent quarter</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='solid' />
              <format attr='border-width' value='1' />
              <format attr='margin' value='4' />
              <format attr='background-color' value='#e9f3f2' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='2764' id='27' type-v2='text' w='98758' x='621' y='80543'>
            <formatted-text>
              <run bold='true' fontcolor='#333333' fontsize='15'>Metric Definitions</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
              <format attr='background-color' value='#f0eae8' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='16345' id='28' type-v2='text' w='98758' x='621' y='83307'>
            <formatted-text>
              <run bold='true'>Satisfaction Score (CSAT):</run>
              <run>Æ&#10;</run>
              <run>Based on 5-point scale where:</run>
              <run>Æ&#10;</run>
              <run>1=Extremely Dissatisfied,</run>
              <run>Æ&#10;</run>
              <run>2= Somewhat Dissatisfied, </run>
              <run>Æ&#10;</run>
              <run>3= Neither Satisfied nor Dissatisfied, </run>
              <run>Æ&#10;</run>
              <run>4= Somewhat Satisfied, </run>
              <run>Æ&#10;</run>
              <run>5= Extremely Satisfied. </run>
              <run>Æ&#10;</run>
              <run bold='true'>Scores are averaged with 5 being the best possible outcome.</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run bold='true'>Effort Score ( CES ): </run>
              <run>Æ&#10;</run>
              <run>Based on a 5-point scale where: </run>
              <run>Æ&#10;</run>
              <run>1= Very Low Effort, </run>
              <run>Æ&#10;</run>
              <run>2= Low Effort, </run>
              <run>Æ&#10;</run>
              <run>3=Medium Effort, </run>
              <run>Æ&#10;</run>
              <run>4=High Effort, </run>
              <run>Æ&#10;</run>
              <run>5=Very High Effort. </run>
              <run>Æ&#10;</run>
              <run bold='true'>Scores are averaged with 1 being the best possible outcome, as higher effort indicates more difficulty. </run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='solid' />
              <format attr='border-width' value='1' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='1404' id='38' type-v2='text' w='89992' x='9387' y='4683'>
            <formatted-text>
              <run bold='true' fontalignment='1' fontcolor='#1d1c1d' fontname='Tableau Regular' fontsize='9'>Please note: 5 is the best outcome for Satisfaction Score while 1 is the best outcome for Effort Score</run>
              <run bold='true' fontalignment='1' fontcolor='#1d1c1d' fontname='Tableau Regular' fontsize='9'>Æ </run>
              <run fontalignment='1' fontcolor='#555555' fontname='Tableau Regular' fontsize='9'>( the lower the effort the better )</run>
              <run bold='true' fontalignment='1' fontcolor='#555555' fontname='Tableau Regular' fontsize='9'>Æ </run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#898989' />
              <format attr='border-style' value='solid' />
              <format attr='border-width' value='1' />
              <format attr='margin' value='4' />
              <format attr='background-color' value='#e6e6e6' />
            </zone-style>
