      <column caption='Satisfaction Score ( Numeric ) ' datatype='integer' name='[Calculation_1807069382587072590]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF CONTAINS([QID1], &quot;Extremely dissatisfied&quot;) THEN 1&#10;ELSEIF CONTAINS([QID1], &quot;Somewhat dissatisfied&quot;) THEN 2&#10;ELSEIF CONTAINS([QID1], &quot;Neither satisfied nor dissatisfied&quot;) THEN 3&#10;ELSEIF CONTAINS([QID1], &quot;Somewhat satisfied&quot;) THEN 4&#10;ELSEIF CONTAINS([QID1], &quot;Extremely satisfied&quot;) THEN 5&#10;END' />
      </column>
      <column caption='Effort Score ( Numeric ) ' datatype='integer' name='[Calculation_6688267693319999514]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF CONTAINS([QID26], &quot;Very high effort&quot;) THEN 5&#10;ELSEIF CONTAINS([QID26], &quot;High effort&quot;) THEN 4&#10;ELSEIF CONTAINS([QID26], &quot;Medium effort&quot;) THEN 3&#10;ELSEIF CONTAINS([QID26], &quot;Low effort&quot;) THEN 2&#10;ELSEIF CONTAINS([QID26], &quot;Very low effort&quot;) THEN 1&#10;END' />
      </column>
      <column caption='Metric Name' datatype='string' name='[Calculation_6688267693324521499]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF NOT ISNULL([Calculation_1807069382587072590]) THEN &quot;Satisfaction&quot;&#10;ELSE &quot;Effort&quot;&#10;END' />
      </column>
