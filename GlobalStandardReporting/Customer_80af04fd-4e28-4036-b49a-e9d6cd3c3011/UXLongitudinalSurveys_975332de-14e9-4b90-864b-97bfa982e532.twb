              <calculation class='tableau' formula='IF CONTAINS([QID1218163537], &quot;Extremely dissatisfied&quot;) THEN 1&#10;ELSEIF CONTAINS([QID1218163537], &quot;Somewhat dissatisfied&quot;) THEN 2&#10;ELSEIF CONTAINS([QID1218163537], &quot;Neither satisfied nor dissatisfied&quot;) THEN 3&#10;ELSEIF CONTAINS([QID1218163537], &quot;Somewhat satisfied&quot;) THEN 4&#10;ELSEIF CONTAINS([QID1218163537], &quot;Extremely satisfied&quot;) THEN 5&#10;END' />
            </column>
            <column caption='Effort Score ( Numeric ) ' datatype='integer' name='[Calculation_1807069389674922099]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF CONTAINS([QID1218163539], &quot;Very high effort&quot;) THEN 5&#10;ELSEIF CONTAINS([QID1218163539], &quot;High effort&quot;) THEN 4&#10;ELSEIF CONTAINS([QID1218163539], &quot;Medium effort&quot;) THEN 3&#10;ELSEIF CONTAINS([QID1218163539], &quot;Low effort&quot;) THEN 2&#10;ELSEIF CONTAINS([QID1218163539], &quot;Very low effort&quot;) THEN 1&#10;END' />
            </column>
