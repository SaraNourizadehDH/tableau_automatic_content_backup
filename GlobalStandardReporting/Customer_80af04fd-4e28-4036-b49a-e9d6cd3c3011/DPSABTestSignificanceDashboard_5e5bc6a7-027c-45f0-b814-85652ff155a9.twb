      <column caption='Treatment Dynamic Explanation' datatype='string' name='[ANOVA Dynamic Explanation (copy)_397653784156893184]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [treatment] = &quot;All&quot;&#10;    THEN &quot;Treatment = All means that all events/orders that are part of the experiment are taken into account, regardless of the treatment scope.&quot;&#10;ELSEIF [treatment] = &quot;True&quot;&#10;    THEN &quot;Treatment = True means that only events/orders that were made in the treatment scope are taken into account.&#10;If a customer or time condition is set for the experiment, it also has to be TRUE for treatment to be considered true.&#10;Please note that multiple fee events (such as home page or listing page) are considered both as treatment = true and treatment = false, since they are not connected to a specific vendor. Therefore, CVR where treatment = true is the number of transactions from vendor within the treatment scope divided by ALL sessions&quot;&#10;ELSE &quot;&quot;&#10;END' />
      </column>
      <column caption='Final P Value' datatype='real' name='[Calculation_1126533277014171648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([corrected_p_value], [p_value])' />
      </column>
      <column caption='Friendly Guide' datatype='string' name='[Calculation_1263541234825424896]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Hypothesis Testing - A Friendly Guide&quot;' />
      </column>
      <column caption='KPI Label (Aliases)' datatype='string' name='[Calculation_2041749161529237504]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [kpi_label] = &quot;commission_local_per_user&quot; THEN &quot;Commission per user&quot;&#10;ELSEIF [kpi_label] = &quot;dps_delivery_fee_local_per_user&quot; THEN &quot;DPS Delivery Fee per user&quot;&#10;ELSEIF [kpi_label] = &quot;mov_customer_fee_local_per_user&quot; THEN &quot;Minimum Order Value Customer Fee per user&quot;&#10;ELSEIF [kpi_label] = &quot;profit_local_per_user&quot; THEN &quot;Profit per user&quot;&#10;ELSEIF [kpi_label] = &quot;revenue_local_per_user&quot; THEN &quot;Revenue per user&quot;&#13;&#10;ELSEIF [kpi_label] = &quot;delivery_costs_local_per_user&quot; THEN &quot;Delivery Costs per user&quot;&#10;ELSEIF [kpi_label] = &quot;gmv_local_per_user&quot; THEN &quot;GMV per user&quot;&#10;ELSEIF [kpi_label] = &quot;delivery_distance_per_user&quot; THEN &quot;Delivery Distance per user&quot;&#10;ELSEIF [kpi_label] = &quot;service_fee_local_per_user&quot; THEN &quot;Service Fee per user&quot;&#10;ELSEIF [kpi_label] = &quot;travel_time_per_user&quot; THEN &quot;Travel Time per user&quot;&#10;ELSEIF [kpi_label] = &quot;orders_per_user&quot; THEN &quot;Orders per User&quot;&#10;ELSEIF [kpi_label] = &quot;profit_local&quot; THEN &quot;Profit per Order&quot;&#10;&#10;ELSEIF [kpi_label] = &apos;cvr&apos; THEN &apos;Conversion Rate&apos;&#10;ELSEIF [kpi_label] = &apos;cvr3&apos; THEN &apos;CVR3&apos;&#10;ELSEIF [kpi_label] = &apos;mcvr2&apos; THEN &apos;mCVR2&apos;&#10;ELSEIF [kpi_label] = &apos;mcvr3&apos; THEN &apos;mCVR3&apos;&#10;ELSEIF [kpi_label] = &apos;mcvr4&apos; THEN &apos;mCVR4&apos;&#10;&#10;END' />
      </column>
      <column caption='Alpha Tooltip' datatype='string' name='[Calculation_265712398065946625]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Alpha is the upper threshold of P-Value, above which the result is considered insignificant&quot;' />
      </column>
      <column caption='P Values - ANOVA Title' datatype='string' name='[Calculation_3388958737982304260]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF NOT ISNULL([anova_p_value]) THEN &apos;ANOVA - P Values&apos; ELSE &apos;&apos; END' />
      </column>
      <column caption='ANOVA Dynamic Explanation' datatype='string' name='[Calculation_3701466333685420032]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([anova_p_value]) THEN &quot;&quot; ELSE &quot;Please note that both the ANOVA and the final P-Values are necessary to determine significance of the result. For more detailed explanation, please refer to the notes tab or to the more detailed friendly guide (linked above)&quot; END' />
      </column>
      <column caption='Significance Bottom Line' datatype='string' name='[Calculation_3751287402078126081]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF&#10;  (&#10;     (&#10;        [Calculation_1126533277014171648] &lt;= [Parameters].[Parameter 4]&#10;        AND&#10;        [anova_p_value] &lt;= [Parameters].[Parameter 4]&#10;     )&#10;      OR &#10;     (&#10;        [Calculation_1126533277014171648] &lt;= [Parameters].[Parameter 4]&#10;        AND&#10;        ISNULL([anova_p_value])&#10;     )&#10;  )&#10;THEN &quot;Statistically Significant&quot;&#10;ELSE &quot;Statistically Insignificant&quot;&#10;END' />
      </column>
      <column caption='P Values - ANOVA Bottom Line' datatype='string' name='[Calculation_4974014701203705856]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [anova_p_value] &lt;= [Parameters].[Parameter 4] THEN &quot;Significance&quot; ELSE &quot;Insignificant&quot; END' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_5347250524662693888]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Selected test status' datatype='boolean' name='[Calculation_5843420528886534145]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 6] = [status]' />
      </column>
      <column caption='Type of Analysis' datatype='string' name='[Calculation_5874805028430352384]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
      </column>
      <column caption='Variant Count' datatype='integer' name='[Calculation_681732403392458758]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([variant_a])' />
      </column>
      <column caption='Dummy Field' datatype='integer' name='[Calculation_796503826225192962]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF FALSE THEN 0 ELSE NULL END' />
      </column>
      <column caption='Mean A Exists' datatype='boolean' name='[Calculation_796503826246000643]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF NOT ISNULL([mean_a]) THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Mean Delta (Percent)' datatype='real' name='[Calculation_917467696420880385]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [variant_a] &lt;&gt; [variant_b] THEN 100*([mean_b]-[mean_a])/ABS([mean_a]) END' />
      </column>
      <column caption='KPI Definitions' datatype='string' name='[Calculation_917467696436420610]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [KPI Label (Aliases) (copy)_796503826216357888] = &apos;Delivery Costs&apos;&#10;    THEN &apos;The total riders costs per order. Obtained by summing the weekly costs by city and repartitioning them per delivery based on the total time spent on that single delivery including the idle_time, then summing up the cost of all deliveries for order.&apos;&#10;ELSEIF [KPI Label (Aliases) (copy)_796503826216357888] = &apos;Delivery Distance&apos;&#10;    THEN &apos;The Manhattan distance (km) between the vendor location coordinates and customer location coordinates. This distance does not take into account potential stacked deliveries, and it is not the traveled distance. This KPI is only available for OD orders.&apos;&#10;ELSEIF [KPI Label (Aliases) (copy)_796503826216357888] = &apos;DPS Delivery Fee&apos;&#13;&#10;    THEN &apos;The delivery fee of the order tracked from dps logs (OD ony).&apos;&#13;&#10;ELSEIF [KPI Label (Aliases) (copy)_796503826216357888] = &apos;Delivery Fee&apos;&#10;    THEN &apos;The supposed-to-be-paid delivery fee of the order placed from the backend. This may differ from the actual delivery fee paid in the case of local marketing campaigns that are not signalled in central-dwh.orders.&apos;&#10;ELSEIF [KPI Label (Aliases) (copy)_796503826216357888] = &apos;Revenue&apos;&#10;    THEN &apos;The total income of an order. It’s the sum of the delivery fee (without VAT), commission and the vendor fee.&apos;&#10;ELSEIF [KPI Label (Aliases) (copy)_796503826216357888] = &apos;Profit&apos;&#10;    THEN &apos;The total sum of revenue minus delivery costs.&apos;&#10;ELSEIF [KPI Label (Aliases) (copy)_796503826216357888] = &apos;Travel Time&apos;&#10;    THEN &apos;The time (min) it takes the rider to travel from vendor location coordinates to the customers. This KPI is only available for OD orders.&apos;&#10;ELSEIF [KPI Label (Aliases) (copy)_796503826216357888] = &apos;Orders per User&apos;&#10;    THEN &apos;Number of orders divided by number of distinct users.&apos;&#10;ELSEIF [KPI Label (Aliases) (copy)_796503826216357888] = &apos;Minimum Order Value Customer Fee&apos;&#10;    THEN &apos;Fee charged for not reaching the minimum order value by customer&apos;&#10;ELSEIF [KPI Label (Aliases) (copy)_796503826216357888] = &apos;Service Fee&apos;&#10;    THEN &apos;The service fee for the session sent by DPS.&apos;&#10;ELSEIF [KPI Label (Aliases) (copy)_796503826216357888] = &apos;GMV&apos;&#10;    THEN &apos;The gmv (gross merchandise value) of the order placed from backend&apos;&#10;ELSEIF [KPI Label (Aliases) (copy)_796503826216357888] = &apos;GFV&apos;&#10;    THEN &apos;The gfv (gross food value) of the order placed from backend&apos;&#10;ELSEIF [KPI Label (Aliases) (copy)_796503826216357888] = &apos;Commission&apos;&#10;    THEN &apos;Contracted fee/commission charged by DH to the vendors per billable orders&apos;&#10;ELSEIF [KPI Label (Aliases) (copy)_796503826216357888] = &apos;CVR&apos;&#10;    THEN &apos;Fraction of sessions that ended in a successful transaction. Calculated as the number of distinct transactions divided by the number of distinct session_id’s.&apos;&#10;ELSEIF [KPI Label (Aliases) (copy)_796503826216357888] = &apos;CVR3&apos;&#10;    THEN &apos;Fraction of sessions that ended in the checkout page out of all the sessions.&apos;&#10;ELSEIF [KPI Label (Aliases) (copy)_796503826216357888] = &apos;mCVR2&apos;&#10;    THEN &apos;Fraction of sessions that ended in the menu page out of the sessions that visited the listing page.&apos;&#10;ELSEIF [KPI Label (Aliases) (copy)_796503826216357888] = &apos;mCVR3&apos;&#10;    THEN &apos;Fraction of sessions that ended in the checkout page out of the sessions that visited the menu page&apos;&#10;ELSEIF [KPI Label (Aliases) (copy)_796503826216357888] = &apos;mCVR4&apos;&#10;    THEN &apos;Fraction of sessions that ended in a successful transaction out of the sessions that visited the checkout page.&apos;&#10;&#10;&#10;END' />
      </column>
      <column caption='KPI Category' datatype='string' name='[Currency View KPI Filter (copy)_6270347736504692736]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [kpi_label] = &quot;commission_local_per_user&quot; THEN &quot;Per User KPIs&quot;&#10;ELSEIF [kpi_label] = &quot;dps_delivery_fee_local_per_user&quot; THEN &quot;Per User KPIs&quot;&#10;ELSEIF [kpi_label] = &quot;mov_customer_fee_local_per_user&quot; THEN &quot;Per User KPIs&quot;&#10;ELSEIF [kpi_label] = &quot;profit_local_per_user&quot; THEN &quot;Per User KPIs&quot;&#10;ELSEIF [kpi_label] = &quot;revenue_local_per_user&quot; THEN &quot;Per User KPIs&quot;&#10;ELSEIF [kpi_label] = &quot;delivery_costs_local_per_user&quot; THEN &quot;Per User KPIs&quot;&#10;ELSEIF [kpi_label] = &quot;gmv_local_per_user&quot; THEN &quot;Per User KPIs&quot;&#10;ELSEIF [kpi_label] = &quot;delivery_distance_per_user&quot; THEN &quot;Per User KPIs&quot;&#10;ELSEIF [kpi_label] = &quot;service_fee_local_per_user&quot; THEN &quot;Per User KPIs&quot;&#10;ELSEIF [kpi_label] = &quot;travel_time_per_user&quot; THEN &quot;Per User KPIs&quot;&#10;ELSEIF [kpi_label] = &quot;orders_per_user&quot; THEN &quot;Per User KPIs&quot;&#10;ELSEIF [kpi_label] = &quot;profit_local&quot; THEN &quot;Per Order KPIs&quot;&#10;&#10;ELSEIF [kpi_label] = &apos;cvr&apos; THEN &apos;Conversion Rate&apos;&#10;ELSEIF [kpi_label] = &apos;cvr3&apos; THEN &apos;Conversion Rate&apos;&#10;ELSEIF [kpi_label] = &apos;mcvr2&apos; THEN &apos;Conversion Rate&apos;&#10;ELSEIF [kpi_label] = &apos;mcvr3&apos; THEN &apos;Conversion Rate&apos;&#10;ELSEIF [kpi_label] = &apos;mcvr4&apos; THEN &apos;Conversion Rate&apos;&#10;&#10;END' />
      </column>
      <column caption='KPI Label (Dynamic Definition)' datatype='string' name='[KPI Label (Aliases) (copy)_796503826216357888]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF STARTSWITH([kpi_label], &quot;dps_delivery_fee&quot;) THEN &quot;DPS Delivery Fee&quot;&#10;ELSEIF STARTSWITH([kpi_label], &quot;commission&quot;) THEN &quot;Commission&quot;&#10;ELSEIF STARTSWITH([kpi_label], &quot;dps_delivery_fee_local_per_user&quot;) THEN &quot;DPS Delivery Fee&quot;&#10;ELSEIF STARTSWITH([kpi_label], &quot;profit&quot;) THEN &quot;Profit&quot;&#10;ELSEIF STARTSWITH([kpi_label], &quot;gfv&quot;) THEN &quot;GFV&quot;&#10;ELSEIF STARTSWITH([kpi_label], &quot;delivery_costs&quot;) THEN &quot;Delivery Costs&quot;&#10;ELSEIF STARTSWITH([kpi_label], &quot;revenue&quot;) THEN &quot;Revenue&quot;&#10;ELSEIF STARTSWITH([kpi_label], &quot;service_fee&quot;) THEN &quot;Service Fee&quot;&#10;ELSEIF STARTSWITH([kpi_label], &quot;mov_customer_fee&quot;) THEN &quot;Minimum Order Value Customer Fee&quot;&#10;ELSEIF STARTSWITH([kpi_label], &quot;gmv&quot;) THEN &quot;GMV&quot;&#10;ELSEIF STARTSWITH([kpi_label], &quot;delivery_distance&quot;) THEN &quot;Delivery Distance&quot;&#10;ELSEIF STARTSWITH([kpi_label], &quot;orders_per_user&quot;) THEN &quot;Orders Per User&quot;&#10;ELSEIF STARTSWITH([kpi_label], &quot;travel_time&quot;) THEN &quot;Travel Time&quot;&#10;ELSEIF [kpi_label] = &quot;cvr&quot; THEN &quot;Conversion Rate&quot;&#10;ELSEIF [kpi_label] = &quot;cvr3&quot; THEN &quot;CVR3&quot;&#10;ELSEIF [kpi_label] = &quot;mcvr3&quot; THEN &quot;mCVR2&quot;&#10;ELSEIF [kpi_label] = &quot;mcvr3&quot; THEN &quot;mCVR3&quot;&#10;ELSEIF [kpi_label] = &quot;mcvr4&quot; THEN &quot;mCVR4&quot;&#10;END' />
      </column>
      <column caption='Alpha (α)' datatype='string' name='[Selected Test Name (copy)_3390295792716660737]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Alpha (α)&apos;' />
      </column>
