            <column caption='Delivery Tag' datatype='string' name='[Calculation_6612973167010172935]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [order_delay]&#10;when &apos;(a)&lt; -30&apos; then &apos;(a) Early&apos;&#10;when &apos;(b) -30 to -25&apos; then &apos;(a) Early&apos;&#10;when &apos;(c) -25 to -20&apos; then &apos;(a) Early&apos;&#10;when &apos;(d) -20 to -15&apos; then &apos;(a) Early&apos;&#10;when &apos;(e) -15 to -10&apos; then &apos;(a) Early&apos;&#10;when &apos;(f) -10 to -5&apos; then &apos;(b) On Time&apos;&#10;when &apos;(g) -5 to 0&apos; then &apos;(b) On Time&apos;&#10;when &apos;(h) 0 to 5&apos; then &apos;(b) On Time&apos;&#10;when &apos;(i) 5 to 10&apos; then &apos;(b) On Time&apos;&#10;when &apos;(j) 10 to 15&apos; then &apos;(c) Late&apos;&#10;when &apos;(k) 15 to 20&apos; then &apos;(c) Late&apos;&#10;when &apos;(l) 20 to 25&apos; then &apos;(c) Late&apos;&#10;when &apos;(m) 25 to 30&apos; then &apos;(c) Late&apos;&#10;when &apos;(n) &gt; 30&apos; then &apos;(c) Late&apos; end' />
