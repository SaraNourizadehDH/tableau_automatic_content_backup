      </column>
      <column caption='% Contact Rate (with &gt;= 3 ETA Stuck)' datatype='real' name='[% Contact Rate (with ETA Stuck) (copy)_6612973167003516933]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [contact_flag] &gt; 0 and [eta_stuck_flag_3] &gt; 0 then [orders] end)*100/sum(if [eta_stuck_flag_3] &gt; 0 then [orders] end)' />
      </column>
      <column caption='% Contact Rate (with Upward Jumps) ' datatype='real' name='[% Contact Rate (with Jumps) (copy)_1588715198722662408]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [contact_flag] &gt; 0 and [upward_jump_flag] &gt; 0 then [orders] end)*100/sum(if [upward_jump_flag] &gt; 0 then [orders] end)' />
      </column>
      <column caption='% Contact Rate (with &gt;= 3 Jumps) ' datatype='real' name='[% Contact Rate (with Jumps) (copy)_6612973167001395200]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [contact_flag] &gt; 0 and [jump_score_3] &gt; 0 then [orders] end)*100/sum(if [jump_score_3] &gt; 0 then [orders] end)' />
      </column>
      <column caption='% Contact Rate (with ETA Stuck)' datatype='real' name='[% Contact Rate (with Upward Jumps)  (copy)_1588715198722953225]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [contact_flag] &gt; 0 and [eta_stuck_flag] &gt; 0 then [orders] end)*100/sum(if [eta_stuck_flag] &gt; 0 then [orders] end)' />
      </column>
      <column caption='% Contact Rate (with &gt;= 3 Upward Jumps)' datatype='real' name='[% Contact Rate (with Upward Jumps)  (copy)_6612973167001763843]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [contact_flag] &gt; 0 and [upward_jump_flag_3] &gt; 0 then [orders] end)*100/sum(if [upward_jump_flag_3] &gt; 0 then [orders] end)' />
      </column>
      <column caption='% Jump Score' datatype='real' name='[Calculation_1352276218205360128]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [jump_score] &gt; 0 then [orders] end)*100/sum([orders])' />
      </column>
      <column caption='% Contact Rate' datatype='real' name='[Calculation_1352276218205470721]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [contact_flag] &gt; 0 then [orders] end)*100/sum([orders])' />
      </column>
      <column caption='% Contact Rate (No Jumps)' datatype='real' name='[Calculation_1588715198716592132]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [contact_flag] &gt; 0 and [jump_score] = 0 then [orders] end)*100/sum(if [jump_score] = 0 then [orders] end)' />
      </column>
      <column caption='% Contact Rate (with Jumps)' datatype='real' name='[Calculation_1588715198716760069]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [contact_flag] &gt; 0 and [jump_score] &gt; 0 then [orders] end)*100/sum(if [jump_score] &gt; 0 then [orders] end)' />
      </column>
      <column caption='Delivery Tag' datatype='string' name='[Calculation_6612973167010172935]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [order_delay]&#10;when &apos;(a)&lt; -30&apos; then &apos;(a) Early&apos;&#10;when &apos;(b) -30 to -25&apos; then &apos;(a) Early&apos;&#10;when &apos;(c) -25 to -20&apos; then &apos;(a) Early&apos;&#10;when &apos;(d) -20 to -15&apos; then &apos;(a) Early&apos;&#10;when &apos;(e) -15 to -10&apos; then &apos;(a) Early&apos;&#10;when &apos;(f) -10 to -5&apos; then &apos;(b) On Time&apos;&#10;when &apos;(g) -5 to 0&apos; then &apos;(b) On Time&apos;&#10;when &apos;(h) 0 to 5&apos; then &apos;(b) On Time&apos;&#10;when &apos;(i) 5 to 10&apos; then &apos;(b) On Time&apos;&#10;when &apos;(j) 10 to 15&apos; then &apos;(c) Late&apos;&#10;when &apos;(k) 15 to 20&apos; then &apos;(c) Late&apos;&#10;when &apos;(l) 20 to 25&apos; then &apos;(c) Late&apos;&#10;when &apos;(m) 25 to 30&apos; then &apos;(c) Late&apos;&#10;when &apos;(n) &gt; 30&apos; then &apos;(c) Late&apos; end' />
      </column>
