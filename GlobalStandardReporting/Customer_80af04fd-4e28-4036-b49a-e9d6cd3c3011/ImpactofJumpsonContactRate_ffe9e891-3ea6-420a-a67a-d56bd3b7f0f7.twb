            <column caption='% Contact Rate (with &gt;= 5 Jumps)' datatype='real' name='[% Contact Rate (with &gt;= 3 Jumps)  (copy)_6612973167001632770]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [contact_flag] &gt; 0 and [jump_score_5] &gt; 0 then [orders] end)*100/sum(if [jump_score_5] &gt; 0 then [orders] end)' />
