              <calculation class='tableau' formula='SUM([delivery_fee_eur_n])/SUM([delivery_fee_eur_d])' />
            </column>
            <column caption='CPO (Euro)' datatype='real' name='[Calculation_6708745006373609474]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_costs_eur_n])/SUM([delivery_costs_eur_d])' />
            </column>
            <column caption='Revenue Per Order (Euro)' datatype='real' name='[Calculation_6708745006373826563]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([revenue_eur_n])/SUM([revenue_eur_d])' />
            </column>
            <column caption='% Orders with Free Delivery' datatype='real' name='[Calculation_6708745006374400004]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([free_delivery_orders])/SUM([orders])' />
            </column>
            <column caption='% Non Subscription Orders' datatype='real' name='[Calculation_6708745006374670341]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([non_subscription_orders])/SUM([orders])' />
            </column>
            <column caption='Pre Dates' datatype='date' name='[Calculation_6708745006384775174]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [period] = &quot;Pre&quot; THEN [report_date] ELSE NULL END' />
            </column>
            <column caption='Post Dates' datatype='date' name='[Calculation_6708745006386368519]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [period] = &quot;Post&quot; THEN [report_date] ELSE NULL END' />
            </column>
            <column caption='Report Quarter' datatype='string' name='[Calculation_6708745006388961288]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(STR(DATETRUNC(&apos;quarter&apos;, [report_date])), 7) // to format as 2025-01, 2025-02 etc.' />
            </column>
            <column caption='Time Period' datatype='string' name='[Calculation_6708745006389542921]' role='dimension' type='nominal'>
