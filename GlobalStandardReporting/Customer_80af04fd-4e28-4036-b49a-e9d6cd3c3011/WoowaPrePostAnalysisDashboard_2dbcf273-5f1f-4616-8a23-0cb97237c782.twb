      <column caption='DF w/o Discounts (Euro)' datatype='real' name='[Calculation_2183401438143401984]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([delivery_fee_before_discount_eur_n])/SUM([delivery_fee_before_discount_eur_d])' />
      </column>
      <column caption='Profit (Euro)' datatype='real' name='[Calculation_2183401438144438273]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([profit_eur_n])/SUM([profit_eur_d])' />
      </column>
      <column caption='FLGPO (Euro)' datatype='real' name='[Calculation_2183401438144749570]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fully_loaded_gross_profit_eur_n])/SUM([fully_loaded_gross_profit_eur_d])' />
      </column>
      <column caption='% OD Orders' datatype='real' name='[Calculation_6591510680311169024]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([own_delivery_orders])/SUM([orders])' />
      </column>
      <column caption='DF Paid By Customer (Euro)' datatype='real' name='[Calculation_6708745006371434496]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([delivery_fee_eur_n])/SUM([delivery_fee_eur_d])' />
      </column>
      <column caption='GFV Per Order' datatype='real' name='[Calculation_6708745006372581377]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gfv_eur_n])/SUM([gfv_eur_d])' />
      </column>
      <column caption='CPO (Euro)' datatype='real' name='[Calculation_6708745006373609474]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([delivery_costs_eur_n])/SUM([delivery_costs_eur_d])' />
      </column>
      <column caption='Revenue Per Order (Euro)' datatype='real' name='[Calculation_6708745006373826563]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([revenue_eur_n])/SUM([revenue_eur_d])' />
      </column>
      <column caption='% Orders with Free Delivery' datatype='real' name='[Calculation_6708745006374400004]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([free_delivery_orders])/SUM([orders])' />
