    <worksheet name='D3-Avg. CVR'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Avg. CVR</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='pricing_kpi_report' name='federated.0j7pf7x1e6oj8m18zpnor0xpyiki' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose Time Dimension' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Report Date&quot;'>
              <calculation class='tableau' formula='&quot;Report Date&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0j7pf7x1e6oj8m18zpnor0xpyiki'>
            <column caption='Time Dimension' datatype='string' name='[Calculation_4518306739301130241]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE   [Parameters].[Parameter 6]&#10;&#10;WHEN    &apos;Report Date&apos;  THEN     STR([report_date])&#10;&#10;WHEN  &apos;Report Week&apos; THEN [report_week]&#10;&#10;END' />
            </column>
            <column caption='LAST' datatype='boolean' name='[Calculation_4518306739302502402]' role='measure' type='nominal'>
              <calculation class='tableau' formula='LAST() = 0'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='attr' datatype='integer' name='[Calculation_4518306739307192323]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='% diff (cvr)' datatype='real' name='[Calculation_4518306739308814341]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN((ZN(AVG([cvr])) - LOOKUP(ZN(AVG([cvr])), -1)) / ABS(LOOKUP(ZN(AVG([cvr])), -1)))'>
                <table-calc ordering-field='[federated.0j7pf7x1e6oj8m18zpnor0xpyiki].[Calculation_4518306739301130241]' ordering-type='Field' />
              </calculation>
            </column>
            <column caption='attr 1' datatype='integer' name='[attr (copy)_4518306739308134404]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0' />
            </column>
            <column-instance column='[cvr]' derivation='Avg' name='[avg:cvr:qk]' pivot='key' type='quantitative' />
            <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='real' name='[cvr]' role='measure' type='quantitative' />
            <column caption='Entity Display Name' datatype='string' name='[entity_display_name]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_4518306739301130241]' derivation='None' name='[none:Calculation_4518306739301130241:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
