      <aliases enabled='yes' />
      <column caption='% Null Session ID' datatype='real' default-format='p0.0%' name='[% Null Client ID (copy)_2420966337117315074]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([session_id_null])/SUM([total_responses])' />
      </column>
      <column caption='% Null/Non perseus Client ID ' datatype='real' default-format='p0.0%' name='[% Null Client ID (copy)_2420966337118617603]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1-SUM([client_id_null_or_nonperseus])/SUM([total_responses])' />
      </column>
      <column caption='% traffic' datatype='real' default-format='p0.0%' name='[% Null Client ID (copy)_2420966337119383557]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([version_numer])/SUM([version_denomer])' />
      </column>
      <column caption='% Null/Non perseus Session ID' datatype='real' default-format='p0.0%' name='[% Null/Non perseus Client ID  (copy)_2420966337119117316]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1-SUM([session_id_null_or_nonperseus])/SUM([total_responses])' />
      </column>
      <column caption='% traffic by version' datatype='real' default-format='p0.0%' name='[% traffic (copy)_2420966338187472905]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([version_numer])/[Calculation_2420966338184851464]' />
      </column>
      <column caption='user_entitlements' datatype='boolean' name='[Calculation_1403997247641882624]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Metric selection' datatype='real' name='[Calculation_2295991448535674881]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;% Null Client ID&apos; THEN [Calculation_2420966337116057601]&#13;&#10;WHEN &apos;% Null/Non perseus Client ID&apos; THEN [% Null Client ID (copy)_2420966337118617603]&#13;&#10;WHEN &apos;% Null Session ID&apos; THEN [% Null Client ID (copy)_2420966337117315074]&#13;&#10;WHEN &apos;% Null/non Perseus Session ID&apos; THEN [% Null/Non perseus Client ID  (copy)_2420966337119117316]&#13;&#10;WHEN &apos;% Traffic&apos; THEN [% Null Client ID (copy)_2420966337119383557]&#13;&#10;END' />
      </column>
      <column caption='% Null Client ID' datatype='real' default-format='p0.0%' name='[Calculation_2420966337116057601]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([client_id_null])/SUM([total_responses])' />
      </column>
      <column caption='den_traffic_perc' datatype='integer' hidden='true' name='[Calculation_2420966338184851464]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( { EXCLUDE [version] : SUM([version_numer]) } )' />
      </column>
      <column caption='Platform Name' datatype='string' name='[Platform (copy)_2420966337114308608]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[platform]' />
      </column>
