        <calculation class='tableau' formula='SUM([is_cancelled]) / SUM([Calculation_3458483064367726596])' />
      </column>
      <column caption='Business KPI&apos;s' datatype='real' name='[Calculation_3458483064368336905]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &quot;Contact Rate&quot; THEN&#10;    [Calculation_3458483064367968262]&#10;ELSEIF [Parameters].[Parameter 3] = &quot;Help Center Session Rate&quot; THEN&#10;    [Calculation_3458483064368066567]&#10;ELSEIF [Parameters].[Parameter 3] = &quot;Cancellation Rate&quot;  THEN&#10;    [Calculation_3458483064368173064]&#10;ELSEIF [Parameters].[Parameter 3] = &quot;Unhealthy Cancellation Rate&quot; THEN&#10;    SUM([is_unhealthy]) / SUM([Calculation_3458483064367726596])&#10;ELSEIF [Parameters].[Parameter 3] = &quot;Healthy Cancellation Rate&quot; THEN&#10;    SUM([is_healthy]) / SUM([Calculation_3458483064367726596])&#10;ELSE&#10;    NULL&#10;END' />
      </column>
      <column caption='% Orders with upward jumps' datatype='real' name='[Calculation_3458483064368713739]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([upward_jump]) / SUM([Calculation_3458483064367726596])' />
      </column>
      <column caption='% Orders with stuck requests' datatype='real' name='[Calculation_3458483064369127439]' role='measure' type='quantitative'>
