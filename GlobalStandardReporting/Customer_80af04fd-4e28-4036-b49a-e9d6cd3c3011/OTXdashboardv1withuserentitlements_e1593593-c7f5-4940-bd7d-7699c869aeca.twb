  <worksheets>
    <worksheet name='Bound Jumps'>
      <table>
        <view>
          <datasources>
            <datasource caption='mla_otx_jumps_bounds (rl)' name='federated.0weyely16kumey1c3v9wy020r9dw' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Jumps Type' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% Orders with stuck or upward jumps&quot;'>
              <calculation class='tableau' formula='&quot;% Orders with stuck or upward jumps&quot;' />
            </column>
            <column caption='Business KPI' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Help Center Session Rate&quot;'>
              <calculation class='tableau' formula='&quot;Help Center Session Rate&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0weyely16kumey1c3v9wy020r9dw'>
            <column caption='% Orders with stuck or upward jumps &gt;= 5' datatype='real' name='[% Orders with stuck or upside jumps (copy)_2297539520437719074]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([eta_stuck_or_upward_jump_5]) / SUM([Calculation_1403293521217511424])' />
            </column>
            <column caption='Total # Orders' datatype='real' name='[Calculation_1403293521217511424]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [region],[country_code],[global_entity_id], [created_date]: AVG([num_orders])}' />
            </column>
            <column caption='% Orders with no requests' datatype='real' name='[Calculation_1403293521536086021]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_1403293521217511424]) - &#10;SUM([orders_less_10_requests]) -&#10;SUM([orders_more_10_requests]) )/ SUM([Calculation_1403293521217511424])' />
            </column>
            <column caption='%Orders with upward jump or downward jump or stuck' datatype='real' name='[Calculation_2246381453487665152]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([eta_not_okay]) / SUM([Calculation_1403293521217511424])' />
            </column>
            <column caption='% Orders with no jumps or stuck' datatype='real' name='[Calculation_2246381453488414722]' role='measure' type='quantitative'>
