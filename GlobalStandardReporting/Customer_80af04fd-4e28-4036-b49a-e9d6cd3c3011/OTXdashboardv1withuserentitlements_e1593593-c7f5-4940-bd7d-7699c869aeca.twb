    <worksheet name='Jumps vs KPI&apos;s Single Value'>
      <table>
        <view>
          <datasources>
            <datasource caption='mla_otx_jumps_median (rl)' name='federated.0rbam421wpux7u11k7wq21b5pqpg' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Jumps Type' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% Orders with stuck or upward jumps&quot;'>
              <calculation class='tableau' formula='&quot;% Orders with stuck or upward jumps&quot;' />
            </column>
            <column caption='Business KPI' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Help Center Session Rate&quot;'>
              <calculation class='tableau' formula='&quot;Help Center Session Rate&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0rbam421wpux7u11k7wq21b5pqpg'>
            <column caption='% Orders with stuck or upward jumps &gt;= 5' datatype='real' name='[% Orders with upward jumps (copy) (copy) (copy)_3458483064368988174]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([eta_stuck_or_upward_jump_5]) / SUM([Calculation_3458483064367726596])' />
            </column>
            <column caption='% Orders with stuck or upward jumps' datatype='real' name='[% Orders with upward jumps (copy) (copy)_3458483064368963597]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([eta_stuck_or_upward_jump]) / SUM([Calculation_3458483064367726596])' />
            </column>
            <column caption='% Orders with downward jumps' datatype='real' name='[% Orders with upward jumps (copy)_3458483064368951308]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([downward_jump]) / SUM([Calculation_3458483064367726596])' />
            </column>
            <column caption='% Orders with upward jump or downward jump or stuck' datatype='real' name='[Calculation_2793920652142571520]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([eta_not_okay]) / SUM([Calculation_3458483064367726596])' />
            </column>
            <column caption='% Orders with no jumps or stuck' datatype='real' name='[Calculation_2793920652142792705]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([eta_okay]) / SUM([Calculation_3458483064367726596])' />
            </column>
            <column caption='% Orders with stuck or upward jumps &gt;= 2' datatype='real' name='[Calculation_2793920654315081736]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([eta_stuck_or_upward_jump_2]) / SUM([Calculation_3458483064367726596])' />
            </column>
            <column caption='% Orders with stuck or upward jumps &gt;= 3' datatype='real' name='[Calculation_2793920654315274249]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([eta_stuck_or_upward_jump_3]) / SUM([Calculation_3458483064367726596])' />
            </column>
            <column caption='% Orders with stuck or upward jumps &gt;= 4' datatype='real' name='[Calculation_2793920654315409418]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([eta_stuck_or_upward_jump_4]) / SUM([Calculation_3458483064367726596])' />
            </column>
            <column caption='Total # Orders' datatype='real' name='[Calculation_3458483064367726596]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [region],[country_code],[global_entity_id], [created_date], [type]: AVG([num_orders])}' />
            </column>
            <column caption='Contact Rate' datatype='real' name='[Calculation_3458483064367968262]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delay_contact]) / SUM([Calculation_3458483064367726596])' />
            </column>
            <column caption='Help Center Session Rate' datatype='real' name='[Calculation_3458483064368066567]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([help_center_session]) / SUM([Calculation_3458483064367726596])' />
            </column>
            <column caption='Cancellation Rate' datatype='real' name='[Calculation_3458483064368173064]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([is_cancelled]) / SUM([Calculation_3458483064367726596])' />
            </column>
            <column caption='Business KPI&apos;s' datatype='real' name='[Calculation_3458483064368336905]' role='measure' type='quantitative'>
