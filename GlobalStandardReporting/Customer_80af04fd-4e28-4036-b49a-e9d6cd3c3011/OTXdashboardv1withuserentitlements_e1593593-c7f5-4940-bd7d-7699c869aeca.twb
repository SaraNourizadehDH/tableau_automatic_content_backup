      </column>
      <column caption='% Orders with maximum upward jump magnitude of 20 minutes' datatype='real' name='[% Orders with maximum jump maginute of 5 minutes (copy) (copy) (copy)_2297539520216903693]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([max_magnitude_20_bounds]) / SUM([Calculation_1403293521217511424])' />
      </column>
