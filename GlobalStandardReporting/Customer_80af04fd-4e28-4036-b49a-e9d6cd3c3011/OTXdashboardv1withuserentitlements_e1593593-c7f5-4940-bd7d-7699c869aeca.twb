      <column caption='Business KPI&apos;s' datatype='real' name='[Calculation_2297539520449695781]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &quot;Contact Rate&quot; THEN&#10;    [Calculation_2297539520433557531]&#10;ELSEIF [Parameters].[Parameter 3] = &quot;Help Center Session Rate&quot; THEN&#10;    [Calculation_2297539520433827868]&#10;ELSEIF [Parameters].[Parameter 3] = &quot;Cancellation Rate&quot;  THEN&#10;    [Calculation_2297539520433967133]&#10;ELSEIF [Parameters].[Parameter 3] = &quot;Unhealthy Cancellation Rate&quot; THEN&#10;    SUM([is_unhealthy]) / SUM([Calculation_1403293521217511424])&#10;ELSEIF [Parameters].[Parameter 3] = &quot;Healthy Cancellation Rate&quot; THEN&#10;    SUM([is_healthy]) / SUM([Calculation_1403293521217511424])&#10;ELSE&#10;    NULL&#10;END' />
      </column>
      <column caption='Time Dimension Per State' datatype='string' name='[Calculation_2297539520464818216]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;[Parameters].[Parameter 4] = &quot;day&quot; THEN&#10;STR(DATEPART(&quot;year&quot;, [created_date])) + &quot;-&quot; + STR(DATEPART(&quot;month&quot;, [created_date])) + &quot;-&quot; + STR(DATEPART(&quot;day&quot;, [created_date]))&#10;ELSEIF [Parameters].[Parameter 4] = &quot;weekly&quot; THEN &#10;STR(DATEPART(&quot;year&quot;, [created_date])) + &quot; W&quot; + STR([week_num])&#10;ELSEIF [Parameters].[Parameter 4] = &quot;month&quot; then &#10;STR(DATEPART(&quot;year&quot;, [created_date])) + &quot;-&quot; + STR(DATEPART(&quot;month&quot;, [created_date]))&#10;ELSEIF [Parameters].[Parameter 4] = &quot;quarter&quot; then&#10;STR(DATEPART(&quot;year&quot;, [created_date])) + &quot; Q&quot; + STR(DATEPART(&quot;quarter&quot;, [created_date]))&#10;ELSEIF [Parameters].[Parameter 4] = &quot;year&quot; then &#10;&quot;Year - &quot; + STR(DATEPART(&quot;year&quot;, [created_date]))&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Hide&quot; then&#10;&quot;Overall&quot;&#10;END' />
      </column>
      <column caption='% Orders without request' datatype='real' hidden='true' name='[Calculation_270849319787896834]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([num_orders]) - SUM([num_orders_per_day_and_state])) / SUM([Calculation_1403293521217511424])' />
