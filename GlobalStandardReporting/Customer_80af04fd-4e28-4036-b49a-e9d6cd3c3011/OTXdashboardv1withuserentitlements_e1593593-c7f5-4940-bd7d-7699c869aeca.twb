      <column caption='Contact Rate' datatype='real' name='[Calculation_270849319827914755]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([delay_contact]) / SUM([num_orders])' />
      </column>
      <column caption='Help Center Session Rate' datatype='real' name='[Calculation_270849319828086789]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([help_center_session]) / SUM([num_orders])' />
      </column>
      <column caption='Cancellation Rate' datatype='real' name='[Calculation_270849319828230150]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([is_cancelled]) / SUM([num_orders])' />
      </column>
      <column caption='Jump Score' datatype='real' name='[Calculation_270849319854055431]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([state_first_eta_stuck_up]) / SUM([num_orders])' />
