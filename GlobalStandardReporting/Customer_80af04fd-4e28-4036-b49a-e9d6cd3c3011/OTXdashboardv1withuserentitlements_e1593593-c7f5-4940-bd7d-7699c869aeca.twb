      <column caption='% Orders with stuck or upward jumps &gt;= 5' datatype='real' name='[% Orders with stuck or upside jumps (copy)_2297539520437719074]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([eta_stuck_or_upward_jump_5]) / SUM([Calculation_1403293521217511424])' />
      </column>
      <column caption='Total # Orders' datatype='real' name='[Calculation_1403293521217511424]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [region],[country_code],[global_entity_id], [created_date]: AVG([num_orders])}' />
