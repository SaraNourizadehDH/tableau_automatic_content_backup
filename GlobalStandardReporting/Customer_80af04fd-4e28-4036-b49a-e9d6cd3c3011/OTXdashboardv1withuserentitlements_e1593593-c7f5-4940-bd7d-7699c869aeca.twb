      <column caption='% Orders with no jumps or stuck' datatype='real' name='[Calculation_2793920652142792705]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([eta_okay]) / SUM([Calculation_3458483064367726596])' />
      </column>
      <column caption='% Orders with stuck or upward jumps &gt;= 2' datatype='real' name='[Calculation_2793920654315081736]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([eta_stuck_or_upward_jump_2]) / SUM([Calculation_3458483064367726596])' />
      </column>
      <column caption='% Orders with stuck or upward jumps &gt;= 3' datatype='real' name='[Calculation_2793920654315274249]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([eta_stuck_or_upward_jump_3]) / SUM([Calculation_3458483064367726596])' />
      </column>
      <column caption='% Orders with stuck or upward jumps &gt;= 4' datatype='real' name='[Calculation_2793920654315409418]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([eta_stuck_or_upward_jump_4]) / SUM([Calculation_3458483064367726596])' />
      </column>
      <column caption='Total # Orders' datatype='real' name='[Calculation_3458483064367726596]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [region],[country_code],[global_entity_id], [created_date], [type]: AVG([num_orders])}' />
      </column>
      <column caption='Contact Rate' datatype='real' name='[Calculation_3458483064367968262]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([delay_contact]) / SUM([Calculation_3458483064367726596])' />
