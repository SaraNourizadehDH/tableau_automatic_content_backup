        <calculation class='tableau' formula='(SUM([Calculation_3458483064367726596]) - &#10;SUM([orders_less_10_requests]) -&#10;SUM([orders_more_10_requests]) )/ SUM([Calculation_3458483064367726596])' />
      </column>
      <column caption='Date Dimension' datatype='string' name='[Calculation_3458483064382799910]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;[Parameters].[Parameter 1] = &quot;day&quot; THEN&#10;STR(DATEPART(&quot;year&quot;, [created_date])) + &quot;-&quot; + STR(DATEPART(&quot;month&quot;, [created_date])) + &quot;-&quot; + STR(DATEPART(&quot;day&quot;, [created_date]))&#10;ELSEIF [Parameters].[Parameter 1] = &quot;weekly&quot; AND [week_num] = 52 AND DATEPART(&quot;month&quot;, [created_date]) = 1 THEN &#10;STR(DATEPART(&quot;year&quot;, [created_date])-1) + &quot; W&quot; + STR([week_num])&#10;ELSEIF [Parameters].[Parameter 1] = &quot;week&quot; THEN &#10;STR(DATEPART(&quot;year&quot;, [created_date])) + &quot; W&quot; + STR([week_num])&#10;ELSEIF [Parameters].[Parameter 1] = &quot;month&quot; then &#10;STR(DATEPART(&quot;year&quot;, [created_date])) + &quot;-&quot; + STR(DATEPART(&quot;month&quot;, [created_date]))&#10;ELSEIF [Parameters].[Parameter 1] = &quot;quarter&quot; then&#10;STR(DATEPART(&quot;year&quot;, [created_date])) + &quot; Q&quot; + STR(DATEPART(&quot;quarter&quot;, [created_date]))&#10;ELSEIF [Parameters].[Parameter 1] = &quot;year&quot; then &#10;&quot;Year - &quot; + STR(DATEPART(&quot;year&quot;, [created_date]))&#10;END' />
      </column>
      <column caption='Time Dimension Per State' datatype='string' name='[Calculation_3458483064396927015]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;[Parameters].[Parameter 4] = &quot;day&quot; THEN&#10;STR(DATEPART(&quot;year&quot;, [created_date])) + &quot;-&quot; + STR(DATEPART(&quot;month&quot;, [created_date])) + &quot;-&quot; + STR(DATEPART(&quot;day&quot;, [created_date]))&#10;ELSEIF [Parameters].[Parameter 4] = &quot;weekly&quot; THEN &#10;STR(DATEPART(&quot;year&quot;, [created_date])) + &quot; W&quot; + STR([week_num])&#10;ELSEIF [Parameters].[Parameter 4] = &quot;month&quot; then &#10;STR(DATEPART(&quot;year&quot;, [created_date])) + &quot;-&quot; + STR(DATEPART(&quot;month&quot;, [created_date]))&#10;ELSEIF [Parameters].[Parameter 4] = &quot;quarter&quot; then&#10;STR(DATEPART(&quot;year&quot;, [created_date])) + &quot; Q&quot; + STR(DATEPART(&quot;quarter&quot;, [created_date]))&#10;ELSEIF [Parameters].[Parameter 4] = &quot;year&quot; then &#10;&quot;Year - &quot; + STR(DATEPART(&quot;year&quot;, [created_date]))&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Hide&quot; then&#10;&quot;Overall&quot;&#10;END' />
      </column>
