      <column caption='% Orders with upward jump or downward jump or stuck' datatype='real' name='[Calculation_2793920652142571520]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([eta_not_okay]) / SUM([Calculation_3458483064367726596])' />
