      </column>
      <column caption='Jumps Type' datatype='real' name='[Calculation_3458483064369979408]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;% Orders with downward jumps&quot; THEN&#10;    [% Orders with upward jumps (copy)_3458483064368951308]&#10;ELSEIF [Parameters].[Parameter 2] = &quot;% Orders with no jumps or stuck requests&quot; THEN&#10;    [Calculation_2793920652142792705]&#10;ELSEIF [Parameters].[Parameter 2] = &quot;% Orders with stuck or upward jumps&quot; THEN&#10;    [% Orders with upward jumps (copy) (copy)_3458483064368963597]&#10;ELSEIF [Parameters].[Parameter 2] = &quot;% Orders with stuck or upward jumps &gt;= 2&quot; THEN&#10;    [Calculation_2793920654315081736]&#10;ELSEIF [Parameters].[Parameter 2] = &quot;% Orders with stuck or upward jumps &gt;= 3&quot; THEN&#10;    [Calculation_2793920654315274249]&#10;ELSEIF [Parameters].[Parameter 2] = &quot;% Orders with stuck or upward jumps &gt;= 4&quot; THEN&#10;    [Calculation_2793920654315409418]&#10;ELSEIF [Parameters].[Parameter 2] = &quot;% Orders with stuck or upward jumps &gt;= 5&quot; THEN&#10;    [% Orders with upward jumps (copy) (copy) (copy)_3458483064368988174]&#10;ELSEIF [Parameters].[Parameter 2] = &quot;% Orders with stuck requests&quot; THEN&#10;    [Calculation_3458483064369127439]&#10;ELSEIF [Parameters].[Parameter 2] = &quot;% Orders with upward jumps&quot; THEN&#10;    [Calculation_3458483064368713739]&#10;ELSEIF [Parameters].[Parameter 2] = &quot;% Orders with upward jump or downward jump or stuck&quot; THEN&#10;    [Calculation_2793920652142571520]&#10;ELSEIF [Parameters].[Parameter 2] = &quot;% Orders with no requests&quot; THEN&#10;    [Calculation_3458483064382500901]&#10;ELSE  &#10;    NULL&#10;END' />
      </column>
      <column caption='% Orders with avg upward jump magnitude between 0 - 1 minutes' datatype='real' name='[Calculation_3458483064378359825]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([avg_magnitude_min_0_min_1]) / SUM([Calculation_3458483064367726596])' />
      </column>
