      <column caption='% Orders with avg upward jump magnitude between 5 - 10 minutes' datatype='real' name='[% Orders with avg jump magnitude between 0 - 1 minute (copy) (copy) (copy) (copy) (copy)_2297539520215126022]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([avg_magnitude_min_5_min_10]) / SUM([Calculation_1403293521217511424])' />
      </column>
      <column caption='% Orders with maximum upward jump magnitude of 25 minutes' datatype='real' name='[% Orders with maximum jump maginute of 5 minutes (copy) (copy) (copy) (copy)_2297539520216915982]' role='measure' type='quantitative'>
