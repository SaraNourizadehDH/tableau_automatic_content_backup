        <zone forceUpdate='true' h='2125' id='3' type-v2='text' w='99818' x='0' y='15225'>
          <formatted-text>
            <run bold='true' fontalignment='1' fontsize='28'>General Summary</run>
          </formatted-text>
        </zone>
        <zone h='3425' id='4' is-centered='0' is-scaled='1' param='Image/Screenshot 2023-02-08 at 10.56.09.png' type-v2='bitmap' w='41727' x='909' y='250' />
        <zone forceUpdate='true' h='3525' id='5' type-v2='text' w='51182' x='42727' y='275'>
          <formatted-text>
            <run bold='true' fontalignment='1' fontsize='20'>Seamless - A/B Testing Analysis Dashboard</run>
          </formatted-text>
        </zone>
        <zone h='2600' id='6' type-v2='empty' w='99909' x='91' y='3925'>
          <zone-style>
            <format attr='border-color' value='#000000' />
