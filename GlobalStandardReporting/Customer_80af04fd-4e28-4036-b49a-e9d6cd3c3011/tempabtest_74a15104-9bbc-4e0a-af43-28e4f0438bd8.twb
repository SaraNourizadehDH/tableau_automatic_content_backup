          <datasource-dependencies datasource='federated.0qmla8713mg4qs13akfzl1kdl0lv'>
            <column caption='% Ctrl' datatype='real' name='[Calculation_1606940698914074625]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([version_a.percentage])' />
            </column>
            <column caption='% Exp' datatype='real' name='[Calculation_1606940698914172930]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([version_b.percentage])' />
            </column>
            <column caption='Ctrl Value' datatype='real' name='[Calculation_1606940698914357251]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([version_a.aggregate])' />
            </column>
            <column caption='Exp Value' datatype='real' name='[Calculation_1606940698914476036]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([version_b.aggregate])' />
            </column>
            <column caption='P - Value' datatype='real' name='[Calculation_1606940698914590725]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([p])' />
            </column>
            <column caption='Delta Exp - Ctrl' datatype='real' name='[Calculation_1606940698914705414]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1606940698914476036] - [Calculation_1606940698914357251]' />
            </column>
            <column caption='Delta Color' datatype='integer' name='[Calculation_1606940698915147783]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [improvement] = &apos;improvement&apos; AND [p] &lt; 0.05 THEN 1 &#10;ELSEIF [improvement] = &apos;downgrade&apos; AND [p] &lt; 0.05 THEN -1 &#10;ELSE 0&#10;END' />
            </column>
            <column-instance column='[Calculation_1606940698915147783]' derivation='Avg' name='[avg:Calculation_1606940698915147783:qk]' pivot='key' type='quantitative' />
            <column caption='End Date' datatype='date' name='[end_date]' role='dimension' type='ordinal' />
