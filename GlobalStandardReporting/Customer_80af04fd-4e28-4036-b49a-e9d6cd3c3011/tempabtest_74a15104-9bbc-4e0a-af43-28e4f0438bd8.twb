        <zone h='3425' id='7' name='Description' w='100091' x='-91' y='6575' />
        <zone h='1350' id='8' mode='dropdown' name='Description' param='[federated.0qmla8713mg4qs13akfzl1kdl0lv].[none:owner:nk]' show-filter-state='false' type-v2='filter' values='all' w='26364' x='16182' y='4650' />
        <zone h='1050' id='9' mode='dropdown' name='Description' param='[federated.0qmla8713mg4qs13akfzl1kdl0lv].[none:test_name:nk]' show-all='false' type-v2='filter' values='context' w='27182' x='47182' y='4675' />
        <zone h='5175' id='10' name='Versions' w='99727' x='-91' y='10000' />
        <zone h='26450' id='11' name='General summary' show-title='false' w='85364' x='7455' y='25775' />
        <zone h='1225' id='14' mode='checkdropdown' name='General summary' param='[federated.0qmla8713mg4qs13akfzl1kdl0lv].[none:metric_name:nk]' show-all='false' type-v2='filter' values='context' w='35727' x='33909' y='18325' />
        <zone forceUpdate='true' h='5150' id='15' type-v2='text' w='99818' x='182' y='20100'>
          <formatted-text>
            <run fontsize='11'>In the following table we will see the general improvement of the metrics for each experiment. You will see three different colors:</run>
            <run>Æ&#10;</run>
            <run fontsize='11'>• green: there is a statistically significant improvement in the metric.</run>
            <run>Æ&#10;</run>
            <run fontsize='11'>• gray: there isn&apos;t any statistically significant change in the metric.</run>
            <run>Æ&#10;</run>
            <run fontsize='11'>• red: there is a statistically significant worsten in the metric.</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontsize='11'>* This change was implemented on 2023-05-26, so all tests that were done before this date will have  either green color (significant change) or gray color (no significant change) for their metrics.</run>
          </formatted-text>
        </zone>
        <zone forceUpdate='true' h='2125' id='16' type-v2='text' w='99818' x='0' y='52975'>
          <formatted-text>
            <run bold='true' fontalignment='1' fontsize='28'>Detailed Summary</run>
          </formatted-text>
        </zone>
        <zone h='2400' id='17' type-v2='empty' w='99909' x='91' y='55125'>
