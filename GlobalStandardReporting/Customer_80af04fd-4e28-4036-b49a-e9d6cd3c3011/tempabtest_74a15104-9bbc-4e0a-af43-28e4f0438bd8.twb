          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='solid' />
            <format attr='border-width' value='1' />
          </zone-style>
        </zone>
        <zone h='1150' id='21' mode='dropdown' name='Confidence Intervals' param='[federated.0qmla8713mg4qs13akfzl1kdl0lv].[none:metric_name:nk]' show-all='false' type-v2='filter' values='context' w='29727' x='15091' y='55875' />
