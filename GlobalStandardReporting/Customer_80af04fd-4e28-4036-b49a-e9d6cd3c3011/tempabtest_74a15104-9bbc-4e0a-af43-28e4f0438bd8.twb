        <zone h='1075' id='22' mode='dropdown' name='Confidence Intervals' param='[federated.0qmla8713mg4qs13akfzl1kdl0lv].[none:entities:nk]' show-all='false' type-v2='filter' values='context' w='20909' x='53455' y='55900' />
        <zone h='1200' id='28' name='Time series metric' pane-specification-id='0' param='[federated.0qmla8713mg4qs13akfzl1kdl0lv].[none:time_series_model_version:nk]' type-v2='color' w='23545' x='1000' y='72075' />
