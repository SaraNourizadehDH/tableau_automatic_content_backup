      <aliases enabled='yes' />
      <column caption='Contacts' datatype='string' name='[Calculation_5603252012880977920]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [contact_flag] &gt; 0 then &apos;Yes Contacts&apos; else &apos;No Contacts&apos; end' />
