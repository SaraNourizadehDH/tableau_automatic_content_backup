_1394708559882715142] = FALSE OR ([Parameters].[Analytical Customer ID (CDP) (copy)_1394708559882715142] = TRUE AND ([classification_phone] = &quot;True Positive&quot; OR ISNULL([classification_phone]))))&#13;&#10;)' />
