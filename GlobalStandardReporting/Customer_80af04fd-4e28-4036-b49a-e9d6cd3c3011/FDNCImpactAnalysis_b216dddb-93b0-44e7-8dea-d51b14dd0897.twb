            <column caption='Filtered Correct FDNC Flag (True Positive)' datatype='boolean' name='[Filtered Correct Scheme Flag (copy)_1394708560105033741]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='(&#13;&#10;    IF([Parameters].[is_darkstore_fdntv Parameter] = FALSE) THEN ([is_darkstore_fdntv] = FALSE OR ISNULL([is_darkstore_fdntv])) ELSE TRUE END&#13;&#10;    AND IF([Parameters].[is_qcommerce_fdntv Parameter] = FALSE) THEN ([is_qcommerce_fdntv] = FALSE OR ISNULL([is_qcommerce_fdntv]))ELSE TRUE END&#13;&#10;    AND IF([Parameters].[is_fdnc_not_fdntv Parameter] = FALSE) THEN [is_darkstore_fdntv] = TRUE OR [is_qcommerce_fdntv] = TRUE ELSE TRUE END&#13;&#10;)&#13;&#10;AND &#13;&#10;(&#13;&#10;    NOT ISNULL([order_scheme_customer_condition_id])&#13;&#10;    AND ([Parameters].[Customer Account ID (CDW) (copy 4)_1394708559882366981] = FALSE OR ([Parameters].[Customer Account ID (CDW) (copy 4)_1394708559882366981] = TRUE AND ([classification_adjust] = &quot;True Positive&quot; OR ISNULL([classification_adjust]))))&#13;&#10;    AND ([Parameters].[Customer Account ID (CDW) (copy)_1394708559882317826] = FALSE OR ([Parameters].[Customer Account ID (CDW) (copy)_1394708559882317826] = TRUE AND ([classification_analytical] = &quot;True Positive&quot; OR ISNULL([classification_analytical]))))&#13;&#10;    AND ([Parameters].[Customer Account ID (CDW) (copy 2)_1394708559882346499] = FALSE OR ([Parameters].[Customer Account ID (CDW) (copy 2)_1394708559882346499] = TRUE AND ([classification_cdp_customer] = &quot;True Positive&quot; OR ISNULL([classification_cdp_customer]))))&#13;&#10;    AND ([Parameters].[Choose Distribution View (copy)] = FALSE OR ([Parameters].[Choose Distribution View (copy)] = TRUE AND ([classification_cdw] = &quot;True Positive&quot; OR ISNULL([classification_cdw]))))&#13;&#10;    AND ([Parameters].[Customer Account ID (CDW) (copy 3)_1394708559882358788] = FALSE OR ([Parameters].[Customer Account ID (CDW) (copy 3)_1394708559882358788] = TRUE AND ([classification_perseus] = &quot;True Positive&quot; OR ISNULL([classification_perseus]))))&#13;&#10;    AND ([Parameters].[Analytical Customer ID (CDP) (copy)_1394708559882715142] = FALSE OR ([Parameters].[Analytical Customer ID (CDP) (copy)_1394708559882715142] = TRUE AND ([classification_phone] = &quot;True Positive&quot; OR ISNULL([classification_phone]))))&#13;&#10;)' />
            </column>
