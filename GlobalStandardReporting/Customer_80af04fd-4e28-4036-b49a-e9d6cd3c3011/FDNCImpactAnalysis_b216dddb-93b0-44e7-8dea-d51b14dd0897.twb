      </column>
      <column caption='Filtered FP Flag' datatype='boolean' name='[Calculation_1394708560081678345]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='(&#13;&#10;    IF([Parameters].[is_darkstore_fdntv Parameter] = FALSE) THEN ([is_darkstore_fdntv] = FALSE OR ISNULL([is_darkstore_fdntv])) ELSE TRUE END&#13;&#10;    AND IF([Parameters].[is_qcommerce_fdntv Parameter] = FALSE) THEN ([is_qcommerce_fdntv] = FALSE OR ISNULL([is_qcommerce_fdntv]))ELSE TRUE END&#13;&#10;    AND IF([Parameters].[is_fdnc_not_fdntv Parameter] = FALSE) THEN [is_darkstore_fdntv] = TRUE OR [is_qcommerce_fdntv] = TRUE ELSE TRUE END&#13;&#10;)&#13;&#10;AND&#13;&#10;(&#13;&#10;    ([Parameters].[Customer Account ID (CDW) (copy 4)_1394708559882366981] = TRUE AND [classification_adjust] = &quot;False Positive&quot;)&#13;&#10;    OR ([Parameters].[Customer Account ID (CDW) (copy)_1394708559882317826] = TRUE AND [classification_analytical] = &quot;False Positive&quot;)&#13;&#10;    OR ([Parameters].[Customer Account ID (CDW) (copy 2)_1394708559882346499] = TRUE AND [classification_cdp_customer] = &quot;False Positive&quot;)&#13;&#10;    OR ([Parameters].[Choose Distribution View (copy)] = TRUE AND [classification_cdw] = &quot;False Positive&quot;)&#13;&#10;    OR ([Parameters].[Customer Account ID (CDW) (copy 3)_1394708559882358788] = TRUE AND [classification_perseus] = &quot;False Positive&quot;)&#13;&#10;    OR ([Parameters].[Analytical Customer ID (CDP) (copy)_1394708559882715142] = TRUE AND [classification_phone] = &quot;False Positive&quot;)&#13;&#10;)' />
      </column>
      <column caption='Filtered Count of TP orders' datatype='integer' name='[Calculation_1394708560130347022]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Filtered Correct Scheme Flag (copy)_1394708560105033741] = TRUE THEN 1 ELSE 0 END&#13;&#10;)' />
      </column>
      <column caption='Filtered Incorrectly Collected Revenue Eur' datatype='real' name='[Calculation_1394708560137457681]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Filtered FP Flag (copy)_1394708560083939338] = TRUE THEN [delivery_fee_eur] ELSE 0 END&#13;&#10;)' />
      </column>
      <column caption='Is FDNC and not FDNTV' datatype='boolean' name='[Calculation_2093047931939110912]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='NOT [is_darkstore_fdntv] AND NOT [is_qcommerce_fdntv]' />
      </column>
      <column caption='Filtered Estimated Lost Revenue Eur' datatype='real' name='[Calculation_261490309202579456]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF([Calculation_1394708560081678345] = TRUE) THEN [estimated_lost_revenue_eur] ELSE 0 END)' />
