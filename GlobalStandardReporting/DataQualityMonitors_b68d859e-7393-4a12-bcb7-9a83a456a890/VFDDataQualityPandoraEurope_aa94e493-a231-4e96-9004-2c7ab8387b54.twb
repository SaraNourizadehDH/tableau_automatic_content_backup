      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_4289C18B3CB84C3591E07FCFD6F2DDF1'>
            <properties context=''>
              <relation connection='bigquery.1kqk3ux1n2v6pj1dxadan0j8p1y0' name='Custom SQL Query' type='text'>SELECT
  COALESCE(DATE(pd_created_at_utc), DATE(cit_order_placed_utc)) created_date_utc
  ,COALESCE(pd_global_entity_id, cit_global_entity_id) global_entiy_id
  ,COUNT(DISTINCT COALESCE(pd_order_id, cit_order_id)) any_orders
  
  -- ORDERS COMPARISON
  ,COUNT(DISTINCT pd_order_id) pd_orders
  ,COUNT(DISTINCT cit_order_id) cit_orders
  ,COUNT(DISTINCT CASE WHEN is_matched_order THEN pd_order_id END) matched_order_counts

  ,SUM(pd_gmv_local) pd_gmv_local
  ,SUM(cit_gmv_local) cit_gmv_local

  ,SUM(pd_gmv_eur) pd_gmv_eur
  ,SUM(cit_gmv_eur) cit_gmv_eur

  ,SUM(pd_gfv_local) pd_gfv_local
  ,SUM(cit_gfv_local) cit_gfv_local

  ,SUM(pd_gfv_eur) pd_gfv_eur
  ,SUM(cit_gfv_eur) cit_gfv_eur
  
  -- DISCOUNTS COMPARISON
  ,COUNT(DISTINCT pd_discount_id) pd_discounts
  ,COUNT(DISTINCT cit_discount_incentive_code) cit_discounts
  ,COUNT(DISTINCT CASE WHEN is_matched_discount THEN pd_discount_id END) matched_discount_counts
  
  ,SUM(pd_vf_discount_local) pd_vf_discount_local
  ,SUM(cit_vf_discount_local) cit_vf_discount_local
  ,SUM(pd_vf_discount_eur) pd_vf_discount_eur
  ,SUM(cit_vf_discount_eur) cit_vf_discount_eur
  
  -- VOUCHERS COMPARISON
  ,COUNT(DISTINCT pd_voucher_id) pd_vouchers
  ,COUNT(DISTINCT cit_voucher_incentive_code) cit_vouchers
  ,COUNT(DISTINCT CASE WHEN is_matched_voucher THEN pd_voucher_id END) matched_voucher_counts

  ,SUM(pd_vf_voucher_local) pd_vf_voucher_local
  ,SUM(cit_vf_voucher_local) cit_vf_voucher_local
  ,SUM(pd_vf_voucher_eur) pd_vf_voucher_eur
  ,SUM(cit_vf_voucher_eur) cit_vf_voucher_eur

FROM `dhh-ncr-stg.dev_sales_revenue.pandora_eu_vs_cit_stream`
WHERE (cit_discount_incentive_code IS NOT NULL OR cit_voucher_incentive_code IS NOT NULL)
  AND vertical_type = &apos;restaurants&apos;
GROUP BY 1,2</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
