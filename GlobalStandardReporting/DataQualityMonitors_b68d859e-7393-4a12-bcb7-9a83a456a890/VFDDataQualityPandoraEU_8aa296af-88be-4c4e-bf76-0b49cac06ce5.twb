      CASE WHEN cit_discount_incentive_type = &apos;delivery_fee&apos;
      THEN cit_vf_discount_eur END
    ) cit_vf_delivery_fee_discount_eur
    ,SUM(
      CASE WHEN cit_discount_incentive_type = &apos;delivery_fee&apos;
      THEN pd_pf_discount_eur END
    ) pd_pf_delivery_fee_discount_eur
    ,SUM(
      CASE WHEN cit_discount_incentive_type = &apos;delivery_fee&apos;
      THEN cit_pf_discount_eur END
    ) cit_pf_delivery_fee_discount_eur
    -- NULL
    ,COUNT(DISTINCT 
      CASE WHEN cit_discount_incentive_type IS NULL
      THEN pd_discount_id END
    ) pd_null_type_discounts
    ,COUNT(DISTINCT 
      CASE WHEN cit_discount_incentive_type IS NULL
      THEN cit_discount_incentive_code END
    ) cit_null_type_discounts
    ,COUNT(DISTINCT 
      CASE WHEN cit_discount_incentive_type IS NULL
      AND is_matched_discount
      THEN pd_discount_id END
    ) matched_null_type_discount_counts
    ,SUM(
      CASE WHEN cit_discount_incentive_type IS NULL
      THEN pd_vf_discount_eur END
    ) pd_vf_null_type_discount_eur
    ,SUM(
      CASE WHEN cit_discount_incentive_type IS NULL
      THEN cit_vf_discount_eur END
    ) cit_vf_null_type_discount_eur
    ,SUM(
      CASE WHEN cit_discount_incentive_type IS NULL
      THEN pd_pf_discount_eur END
    ) pd_pf_null_type_discount_eur
    ,SUM(
      CASE WHEN cit_discount_incentive_type IS NULL
      THEN cit_pf_discount_eur END
    ) cit_pf_null_type_discount_eur

    --DISCOUNT
    --FULL MENU
    ,COUNT(DISTINCT 
      CASE WHEN cit_voucher_incentive_type IN (&apos;amount&apos;, &apos;percentage&apos;) 
      AND cit_voucher_num_products = 0 
      THEN pd_voucher_id END
    ) pd_full_menu_vouchers
    ,COUNT(DISTINCT 
      CASE WHEN cit_voucher_incentive_type IN (&apos;amount&apos;, &apos;percentage&apos;) 
      AND cit_voucher_num_products = 0 
      THEN cit_voucher_incentive_code END
    ) cit_full_menu_vouchers
    ,COUNT(DISTINCT 
      CASE WHEN cit_voucher_incentive_type IN (&apos;amount&apos;, &apos;percentage&apos;) 
      AND cit_voucher_num_products = 0 
      AND is_matched_voucher
      THEN pd_voucher_id END
    ) matched_full_menu_voucher_counts
    ,SUM(
      CASE WHEN cit_voucher_incentive_type IN (&apos;amount&apos;, &apos;percentage&apos;) 
      AND cit_voucher_num_products = 0 
      THEN pd_vf_voucher_eur END
    ) pd_vf_full_menu_voucher_eur
    ,SUM(
      CASE WHEN cit_voucher_incentive_type IN (&apos;amount&apos;, &apos;percentage&apos;) 
      AND cit_voucher_num_products = 0 
      THEN cit_vf_voucher_eur END
    ) cit_vf_full_menu_voucher_eur
    ,SUM(
      CASE WHEN cit_voucher_incentive_type IN (&apos;amount&apos;, &apos;percentage&apos;) 
      AND cit_voucher_num_products = 0 
      THEN pd_pf_voucher_eur END
    ) pd_pf_full_menu_voucher_eur
    ,SUM(
      CASE WHEN cit_voucher_incentive_type IN (&apos;amount&apos;, &apos;percentage&apos;) 
      AND cit_voucher_num_products = 0 
      THEN cit_pf_voucher_eur END
    ) cit_pf_full_menu_voucher_eur
    --ITEM-LEVEL
    ,COUNT(DISTINCT 
      CASE WHEN cit_voucher_incentive_type IN (&apos;amount&apos;, &apos;percentage&apos;, &apos;composite&apos;) 
      AND cit_voucher_num_products &gt;&gt; 0 
      THEN pd_voucher_id END
    ) pd_item_level_vouchers
    ,COUNT(DISTINCT 
      CASE WHEN cit_voucher_incentive_type IN (&apos;amount&apos;, &apos;percentage&apos;, &apos;composite&apos;) 
      AND cit_voucher_num_products &gt;&gt; 0 
      THEN cit_voucher_incentive_code END
    ) cit_item_level_vouchers
    ,COUNT(DISTINCT 
      CASE WHEN cit_voucher_incentive_type IN (&apos;amount&apos;, &apos;percentage&apos;, &apos;composite&apos;) 
      AND cit_voucher_num_products &gt;&gt; 0 
      AND is_matched_voucher
      THEN pd_voucher_id END
    ) matched_item_level_voucher_counts
    ,SUM(
      CASE WHEN cit_voucher_incentive_type IN (&apos;amount&apos;, &apos;percentage&apos;, &apos;composite&apos;) 
      AND cit_voucher_num_products &gt;&gt; 0 
      THEN pd_vf_voucher_eur END
    ) pd_vf_item_level_voucher_eur
    ,SUM(
      CASE WHEN cit_voucher_incentive_type IN (&apos;amount&apos;, &apos;percentage&apos;, &apos;composite&apos;) 
      AND cit_voucher_num_products &gt;&gt; 0 
      THEN cit_vf_voucher_eur END
    ) cit_vf_item_level_voucher_eur
    ,SUM(
      CASE WHEN cit_voucher_incentive_type IN (&apos;amount&apos;, &apos;percentage&apos;, &apos;composite&apos;) 
      AND cit_voucher_num_products &gt;&gt; 0 
      THEN pd_pf_voucher_eur END
    ) pd_pf_item_level_voucher_eur
    ,SUM(
      CASE WHEN cit_voucher_incentive_type IN (&apos;amount&apos;, &apos;percentage&apos;, &apos;composite&apos;) 
      AND cit_voucher_num_products &gt;&gt; 0 
      THEN cit_pf_voucher_eur END
    ) cit_pf_item_level_voucher_eur
    -- DELIVERY FEE
    ,COUNT(DISTINCT 
      CASE WHEN cit_voucher_incentive_type = &apos;delivery_fee&apos;
      THEN pd_voucher_id END
    ) pd_delivery_fee_vouchers
    ,COUNT(DISTINCT 
      CASE WHEN cit_voucher_incentive_type = &apos;delivery_fee&apos;
      THEN cit_voucher_incentive_code END
    ) cit_delivery_fee_vouchers
    ,COUNT(DISTINCT 
      CASE WHEN cit_voucher_incentive_type = &apos;delivery_fee&apos;
      AND is_matched_voucher
      THEN pd_voucher_id END
    ) matched_delivery_fee_voucher_counts
    ,SUM(
      CASE WHEN cit_voucher_incentive_type = &apos;delivery_fee&apos;
      THEN pd_vf_voucher_eur END
    ) pd_vf_delivery_fee_voucher_eur
    ,SUM(
      CASE WHEN cit_voucher_incentive_type = &apos;delivery_fee&apos;
      THEN cit_vf_voucher_eur END
    ) cit_vf_delivery_fee_voucher_eur
    ,SUM(
      CASE WHEN cit_voucher_incentive_type = &apos;delivery_fee&apos;
      THEN pd_pf_voucher_eur END
    ) pd_pf_delivery_fee_voucher_eur
    ,SUM(
      CASE WHEN cit_voucher_incentive_type = &apos;delivery_fee&apos;
      THEN cit_pf_voucher_eur END
    ) cit_pf_delivery_fee_voucher_eur
    -- NULL
    ,COUNT(DISTINCT 
      CASE WHEN cit_voucher_incentive_type IS NULL
      THEN pd_voucher_id END
    ) pd_null_type_vouchers
    ,COUNT(DISTINCT 
      CASE WHEN cit_voucher_incentive_type IS NULL
      THEN cit_voucher_incentive_code END
    ) cit_null_type_vouchers
    ,COUNT(DISTINCT 
      CASE WHEN cit_voucher_incentive_type IS NULL
      AND is_matched_voucher
      THEN pd_voucher_id END
    ) matched_null_type_voucher_counts
    ,SUM(
      CASE WHEN cit_voucher_incentive_type IS NULL
      THEN pd_vf_voucher_eur END
    ) pd_vf_null_type_voucher_eur
    ,SUM(
      CASE WHEN cit_voucher_incentive_type IS NULL
      THEN cit_vf_voucher_eur END
    ) cit_vf_null_type_voucher_eur
    ,SUM(
      CASE WHEN cit_voucher_incentive_type IS NULL
      THEN pd_pf_voucher_eur END
    ) pd_pf_null_type_voucher_eur
    ,SUM(
      CASE WHEN cit_voucher_incentive_type IS NULL
      THEN cit_pf_voucher_eur END
    ) cit_pf_null_type_voucher_eur
  FROM `dhh-ncr-stg.dev_sales_revenue.pandora_eu_vs_cit_stream_sr_ver`
  WHERE (cit_discount_incentive_code IS NOT NULL OR cit_voucher_incentive_code IS NOT NULL)
    AND vertical_type = &apos;restaurants&apos;
  GROUP BY 1,2</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
