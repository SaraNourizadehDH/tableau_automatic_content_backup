        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1lg2sq308ofirw14idz1h07ujrh3' name='Custom SQL Query' type='text'>SELECT
  DATE(order_time_utc) order_date
  ,country_code
  ,tb_incentive_sub_type
  ,vertical_id

  ,MIN(DATE(order_time_utc)) start_date
  ,MAX(DATE(order_time_utc)) end_date

  ,COUNT(DISTINCT coalesce_order_id) total_order_count
  ,COUNT(DISTINCT CASE WHEN is_order_id_match THEN coalesce_order_id END) match_order_count

  ,COUNT(DISTINCT coalesce_customer_incentive_id) total_inct_count
  ,COUNT(DISTINCT CASE WHEN is_customer_incentive_id_match THEN coalesce_customer_incentive_id END) match_inct_count
  

  ,COUNT(DISTINCT df_order_id) df_order_count
  ,COUNT(DISTINCT tb_order_id) tb_order_count

  ,COUNT(DISTINCT df_customer_incentive_id) df_inct_count
  ,COUNT(DISTINCT tb_customer_incentive_id) tb_inct_count
  
  ,SUM(df_incentive_applied_amount_eur) df_incentive_applied_amount_eur
  ,SUM(tb_incentive_applied_amount_eur) tb_incentive_applied_amount_eur

  ,SUM(df_vendor_sponsorship_amount_eur) df_vendor_sponsorship_amount_eur
  ,SUM(tb_vendor_sponsorship_amount_eur) tb_vendor_sponsorship_amount_eur

  ,SUM(df_vendor_sponsorship_amount_local) df_vendor_sponsorship_amount_local
  ,SUM(tb_vendor_sponsorship_amount_local) tb_vendor_sponsorship_amount_local

FROM `dhh-ncr-stg.dev_sales_revenue.talabat_vs_cit_stream_by_type`
WHERE TRUE 
GROUP BY 1,2,3,4</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1lg2sq308ofirw14idz1h07ujrh3' name='Custom SQL Query' type='text'>SELECT
