      <column caption='% Diff Orders' datatype='real' name='[% Diff Total Amount (copy)_3121909360361959427]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([df_order_count])/SUM([tb_order_count]))-1' />
      </column>
