      <repository-location derived-from='http://ip-172-31-0-134:8278/t/GlobalStandardReporting/workbooks/PromoDashboard-updated/Vendordetailed-view?rev=' id='Vendordetailed-view' path='/t/GlobalStandardReporting/workbooks/PromoDashboard-updated' revision='' site='GlobalStandardReporting' />
      <table>
        <view>
          <datasources>
            <datasource caption='promotions_orders_analysis_vendor_level_new (local_shops_analytics) (2)' name='federated.15jtdih0llzywq1b5mvlm0k05jbf (copy)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Measure' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;\#Orders&quot;'>
              <calculation class='tableau' formula='&quot;#Orders&quot;' />
              <aliases>
                <alias key='&quot;Discount Total&quot;' value='Discount Total' />
                <alias key='&quot;GBV avg.&quot;' value='GBV avg. €' />
                <alias key='&quot;GBV Total&quot;' value='GBV Total €' />
                <alias key='&quot;GMV avg.&quot;' value='GMV avg. €' />
                <alias key='&quot;GMV Total&quot;' value='GMV Total €' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.15jtdih0llzywq1b5mvlm0k05jbf (copy)'>
            <column caption='Orders with promo' datatype='integer' name='[Calculation_1633047464366747648]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [order_type]  WHEN &quot;True&quot; THEN [orders] else 0 END' />
            </column>
            <column caption='Calculated measure' datatype='real' name='[Calculation_499195892641468416]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;GMV avg.&quot; THEN Sum([gmv_eur_total])/ SUM([orders])&#10;WHEN &quot;GBV avg.&quot; THEN Sum([gbv_eur_total])/ SUM([orders])&#10;WHEN &quot;#Orders&quot; THEN (SUM([orders]))&#10;WHEN &quot;#Items Sold&quot; THEN Sum([total_items_sold])&#10;WHEN &quot;GMV Total&quot; THEN sum([gmv_eur_total])&#10;WHEN &quot;GBV Total&quot; THEN sum([gbv_eur_total])&#10;WHEN &quot;Items Per Order&quot; THEN SUM([total_items_sold])/ SUM([orders])&#10;WHEN &quot;Distinct Items Per Order&quot; THEN SUM([items_sold_distinct_skus])/ SUM([orders])&#10;WHEN &quot;Distinct Items Per Order&quot; THEN SUM([items_sold_distinct_skus])/ SUM([orders])&#10;&#10;WHEN &quot;% Orders with promo&quot; THEN (sum([Calculation_1633047464366747648]))&#10;WHEN &quot;Discount Total&quot; THEN ([Calculation_5465892240613486595])&#10;WHEN &quot;Discount avg.&quot; THEN ([Calculation_5465892240613486595])/ SUM([orders])&#10;WHEN &quot;Discount over GMV&quot; THEN ([Calculation_5465892240613486595])/ sum([gmv_eur_total])&#10;&#10;&#10;&#10;&#10;&#10;END' />
            </column>
            <column caption='Total Discount' datatype='real' name='[Calculation_5465892240613486595]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([discount_eur_vendor_items]) + SUM([total_discount_eur_cart])' />
            </column>
            <column caption='Exclude Peya- before nov 23' datatype='string' name='[Calculation_8708413620312776704]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([region]=&apos;America&apos; AND [campaign_type]=&apos;BasketValue&apos;, &apos;Exclude&apos;, &apos;Include&apos;)' />
            </column>
            <column caption='Campaign Type' datatype='string' name='[campaign_type]' role='dimension' type='nominal' />
            <column caption='City' datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Date' datatype='date' name='[day_]' role='dimension' type='quantitative' />
            <column datatype='real' name='[discount_eur_vendor_items]' role='measure' type='quantitative' />
            <column caption='Gbv Eur Total' datatype='real' name='[gbv_eur_total]' role='measure' type='quantitative' />
            <column caption='Gmv Eur Total' datatype='real' name='[gmv_eur_total]' role='measure' type='quantitative' />
            <column caption='Items Sold Distinct Skus' datatype='integer' name='[items_sold_distinct_skus]' role='measure' type='quantitative' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column-instance column='[day_]' derivation='MY' name='[my:day_:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_8708413620312776704]' derivation='None' name='[none:Calculation_8708413620312776704:nk]' pivot='key' type='nominal' />
