          <datasource-dependencies datasource='federated.15jtdih0llzywq1b5mvlm0k05jbf (copy)'>
            <column caption='Calculated  Discount per GMV' datatype='real' default-format='C1031%' name='[Calculated  Discount per order (copy)_2464454199170793474]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5465892240613486595]/ SUM([gmv_eur_total])' />
            </column>
            <column caption='Calculated items Sold' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculated GBV (copy)_2464454199140114432]' role='measure' type='ordinal' visual-totals='Avg'>
              <calculation class='tableau' formula='Sum([total_items_sold])/ SUM([orders])' />
            </column>
            <column caption='Calculated GBV' datatype='real' default-format='C1031%' name='[Calculated GMV (copy)_2174183129402490881]' role='measure' type='ordinal' visual-totals='Avg'>
              <calculation class='tableau' formula='Sum([gbv_eur_total])/ SUM([orders])' />
            </column>
