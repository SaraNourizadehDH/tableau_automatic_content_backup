      </column>
      <column caption='Vendor Adoption Active Vendors' datatype='real' name='[Calculation_3990752228909723648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([promo_vendors]) / sum ([all_active_vendors])' />
      </column>
      <column caption='Vendor Adoption Active Vendors (copy)' datatype='real' name='[Vendor Adoption Active Vendors (copy)_6792976401703575552]' role='measure' type='quantitative'>
