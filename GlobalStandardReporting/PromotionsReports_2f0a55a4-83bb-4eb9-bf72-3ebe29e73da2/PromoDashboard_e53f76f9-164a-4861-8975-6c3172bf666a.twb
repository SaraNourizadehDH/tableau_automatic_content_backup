      <aliases enabled='yes' />
      <column caption='% Vendor Discount ' datatype='real' default-format='p0%' name='[% DH Discount (copy)_5465892240620781573]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5465892240613355522] / [Calculation_5465892240613486595]' />
      </column>
      <column caption='Calculated  Discount per GMV' datatype='real' default-format='C1031%' name='[Calculated  Discount per order (copy)_2464454199170793474]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5465892240613486595]/ SUM([gmv_eur_total])' />
      </column>
      <column caption='Calculated items Sold' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculated GBV (copy)_2464454199140114432]' role='measure' type='ordinal' visual-totals='Avg'>
        <calculation class='tableau' formula='Sum([total_items_sold])/ SUM([orders])' />
      </column>
      <column caption='Calculated GBV' datatype='real' default-format='C1031%' name='[Calculated GMV (copy)_2174183129402490881]' role='measure' type='ordinal' visual-totals='Avg'>
        <calculation class='tableau' formula='Sum([gbv_eur_total])/ SUM([orders])' />
      </column>
      <column caption='Calculated  Discount per order' datatype='real' default-format='C1031%' name='[Calculated GMV (copy)_2174183129402707970]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5465892240613486595]/ SUM([orders])' />
      </column>
      <column caption='Calculated items Sold Distinct' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculated Utems Sold (copy)_2464454199140204545]' role='measure' type='ordinal' visual-totals='Avg'>
        <calculation class='tableau' formula='Sum([items_sold_distinct_skus])/ SUM([orders])' />
      </column>
      <column caption='Orders with promo' datatype='integer' name='[Calculation_1633047464366747648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [order_type]  WHEN &quot;True&quot; THEN [orders] else 0 END' />
      </column>
      <column caption='avg_gbv_items_discount' datatype='real' name='[Calculation_1743948611598811137]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([amt_gbv_eur_items_discount]) /SUM([num_of_total_items_sold_w_discount])' />
      </column>
      <column caption='avg_gbv_items_wo_discount' datatype='real' name='[Calculation_1743948611599187970]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([amt_gbv_eur_items_WO_discount]) /&#10;(&#10;sum ([total_items_sold])-&#10;SUM([num_of_total_items_sold_w_discount])&#10;&#10;)' />
      </column>
      <column caption='Calculated GMV' datatype='real' default-format='C1031%' name='[Calculation_2174183129402265600]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Sum([gmv_eur_total])/ SUM([orders])' />
      </column>
      <column caption='Date.' datatype='date' datatype-customized='true' name='[Calculation_2212745197705093129]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 5]&#10;WHEN &quot;Day&quot; THEN [day_]&#10;WHEN &quot;Week&quot; THEN DATETRUNC(&apos;week&apos;, [day_])&#10;WHEN &quot;Month&quot; THEN DATETRUNC(&apos;month&apos;, [day_])&#10;WHEN &quot;Year&quot; THEN DATETRUNC(&apos;year&apos;, [day_])&#10;end)' />
      </column>
      <column caption='Calculated measure' datatype='real' name='[Calculation_499195892641468416]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;GMV avg.&quot; THEN Sum([gmv_eur_total])/ SUM([orders])&#10;WHEN &quot;GBV avg.&quot; THEN Sum([gbv_eur_total])/ SUM([orders])&#10;WHEN &quot;#Orders&quot; THEN (SUM([orders]))&#10;WHEN &quot;#Items Sold&quot; THEN Sum([total_items_sold])&#10;WHEN &quot;GMV Total&quot; THEN sum([gmv_eur_total])&#10;WHEN &quot;GBV Total&quot; THEN sum([gbv_eur_total])&#10;WHEN &quot;Items Per Order&quot; THEN SUM([total_items_sold])/ SUM([orders])&#10;WHEN &quot;Distinct Items Per Order&quot; THEN SUM([items_sold_distinct_skus])/ SUM([orders])&#10;WHEN &quot;Distinct Items Per Order&quot; THEN SUM([items_sold_distinct_skus])/ SUM([orders])&#10;&#10;WHEN &quot;% Orders with promo&quot; THEN (sum([Calculation_1633047464366747648]))&#10;WHEN &quot;Discount Total&quot; THEN ([Calculation_5465892240613486595])&#10;WHEN &quot;Discount avg.&quot; THEN ([Calculation_5465892240613486595])/ SUM([orders])&#10;WHEN &quot;Discount over GMV&quot; THEN ([Calculation_5465892240613486595])/ sum([gmv_eur_total])&#10;&#10;&#10;&#10;&#10;&#10;END' />
      </column>
      <column caption='Discount DH' datatype='real' name='[Calculation_5465892240613216257]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([amt_discount_dh_eur_cart])' />
      </column>
      <column caption='Discount Vendor' datatype='real' name='[Calculation_5465892240613355522]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([amt_discount_vendor_eur_cart])+ sum([discount_eur_vendor_items])' />
      </column>
      <column caption='Total Discount' datatype='real' name='[Calculation_5465892240613486595]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([discount_eur_vendor_items]) + SUM([total_discount_eur_cart])' />
      </column>
      <column caption='% DH Discount' datatype='real' default-format='p0%' name='[Calculation_5465892240620392452]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5465892240613216257] / [Calculation_5465892240613486595]' />
      </column>
      <column caption='Exclude Peya- before nov 23' datatype='string' name='[Calculation_8708413620312776704]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([region]=&apos;America&apos; AND [campaign_type]=&apos;BasketValue&apos;, &apos;Exclude&apos;, &apos;Include&apos;)' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='promotions_orders_analysis_vendor_level_new' datatype='table' name='[__tableau_internal_object_id__].[promotions_orders_analysis_vendor_level_new_410287B3A2DD4A5AABA0C60821559C3C]' role='measure' type='quantitative' />
