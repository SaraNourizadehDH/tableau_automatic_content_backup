      <aliases enabled='yes' />
      <column caption='SSP Active Vendor Adoption  %' datatype='real' default-format='p0.00%' name='[Active Vendor Promo. Adoption %   (copy)_279504703344058370]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([active_vendors_with_promos_ssp]) / sum([all_active_vendors])' />
      </column>
      <column caption='Ratio Active Vendors Promo/ Vendors with Promos' datatype='real' default-format='p0.00%' name='[Active Vendor Promo. Adoption %   (copy)_279504703344431107]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([active_vendors_with_promos]) / sum([promo_vendors])' />
      </column>
      <column caption='Active Vendor Promo. Adoption %  ' datatype='real' default-format='p0%' name='[Calculation_279504703342342144]' role='measure' type='quantitative'>
