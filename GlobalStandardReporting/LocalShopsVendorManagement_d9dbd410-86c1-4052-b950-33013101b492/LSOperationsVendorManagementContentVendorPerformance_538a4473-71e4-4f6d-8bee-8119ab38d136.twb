      <column caption='Granularity 2' datatype='string' name='[Calculation_1438337135105560577]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 4]=&quot;Region&quot; THEN [region]&#13;&#10;ELSEIF [Parameters].[Parameter 4]=&quot;Country&quot; THEN [country]&#13;&#10;ELSEIF [Parameters].[Parameter 4]=&quot;Store Type L1&quot; THEN [store_type_l1]&#13;&#10;ELSEIF [Parameters].[Parameter 4]=&quot;Store Type L2&quot; THEN [store_type_l2]&#13;&#10;ELSEIF [Parameters].[Parameter 4]=&quot;Vendor Name&quot; THEN [vendor_name]&#13;&#10;ELSEIF [Parameters].[Parameter 4]=&quot;Chain Name&quot; THEN [chain_name]&#13;&#10;END' />
      </column>
      <column caption='Zombie Vendor Count' datatype='integer' name='[Calculation_1438337135409807362]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(CASE [zombie_flag] WHEN  &apos;1&apos; THEN [vendor_code] END)' />
      </column>
      <column caption='Transaction Period' datatype='date' name='[Calculation_1438337135416463363]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parameter 5],[transaction_week]))' />
      </column>
      <column caption='Granularity' datatype='string' name='[Calculation_1912340996887851008]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 6]=&quot;vendor&quot; THEN [vendor_name]&#13;&#10;ELSEIF [Parameters].[Parameter 6]=&quot;chain&quot; THEN [chain_name]&#13;&#10;ELSEIF [Parameters].[Parameter 6]=&quot;country&quot; THEN [country]&#13;&#10;ELSEIF [Parameters].[Parameter 6]=&quot;chain x type&quot; THEN [chain_name]+&quot;-&quot;+[shop_type]&#13;&#10;END' />
      </column>
      <column caption='ABV' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_46724849100767232]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_gmv_eur_w])/SUM([nr_completed_orders_w])' />
      </column>
      <column caption='ABS' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_46724849100857345]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_quantity_w])/SUM([nr_completed_orders_w])' />
      </column>
      <column caption='Order Frequency' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_46724849101033474]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nr_completed_orders_w])/SUM([active_user])' />
      </column>
      <column caption='Vendor Fail Rate' datatype='real' default-format='p0.0%' name='[Calculation_46724849104326659]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nr_failed_orders_vendor_w])/SUM([nr_orders_w])' />
      </column>
      <column caption='Fail Rate OOS' datatype='real' default-format='p0.0%' name='[Calculation_46724849104498692]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nr_failed_orders_OOS_w])/SUM([nr_orders_w])' />
      </column>
      <column caption='CS Score Field' datatype='real' name='[Calculation_46724850183622662]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&quot;Global Completeness Score Aggregated&quot; THEN [global_completeness_score_aggregated]&#13;&#10;ELSEIF [Parameters].[Parameter 2]=&quot;Global Content Score Aggregated&quot; THEN [global_content_score_aggregated]&#13;&#10;ELSEIF [Parameters].[Parameter 2]=&quot;Global Quality Score Aggregated&quot; THEN [global_quality_score_aggregated]&#13;&#10;END' />
      </column>
      <column caption='Metric Field' datatype='real' name='[Calculation_46724850184941575]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&quot;Fail Rate OOS&quot; THEN SUM([nr_failed_orders_OOS_w])/SUM([nr_orders_w])&#13;&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Completed Orders&quot; THEN SUM([nr_completed_orders_w])&#13;&#10;ELSEIF [Parameters].[Parameter 1]=&quot;ABV&quot; THEN SUM([total_gmv_eur_w])/SUM([nr_completed_orders_w])&#13;&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Total Orders&quot; THEN SUM([nr_orders_w])&#13;&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Total GMV&quot; THEN SUM([total_gmv_eur_w])&#13;&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Vendor Fail Rate&quot; THEN SUM([nr_failed_orders_vendor_w])/SUM([nr_orders_w])&#13;&#10;ELSEIF [Parameters].[Parameter 1]=&quot;ABS&quot; THEN SUM([total_quantity_w])/SUM([nr_completed_orders_w])&#13;&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Order Frequency&quot; THEN SUM([nr_completed_orders_w])/SUM([active_user])&#13;&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Zombie Count&quot; THEN SUM([zombie_cnt])&#13;&#10;END' />
      </column>
