          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#d61f26'>Vendor Performance</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='_qcls_content_vendor_summary (dev_dmart)' name='federated.14fpos00vzk9621f7howk1lc9dly' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Parameter Test' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;country&quot;'>
              <calculation class='tableau' formula='&quot;country&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.14fpos00vzk9621f7howk1lc9dly'>
            <column caption='Granularity' datatype='string' name='[Calculation_1912340996887851008]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 6]=&quot;vendor&quot; THEN [vendor_name]&#13;&#10;ELSEIF [Parameters].[Parameter 6]=&quot;chain&quot; THEN [chain_name]&#13;&#10;ELSEIF [Parameters].[Parameter 6]=&quot;country&quot; THEN [country]&#13;&#10;ELSEIF [Parameters].[Parameter 6]=&quot;chain x type&quot; THEN [chain_name]+&quot;-&quot;+[shop_type]&#13;&#10;END' />
            </column>
            <column caption='ABV' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_46724849100767232]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_gmv_eur_w])/SUM([nr_completed_orders_w])' />
            </column>
            <column caption='ABS' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_46724849100857345]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_quantity_w])/SUM([nr_completed_orders_w])' />
