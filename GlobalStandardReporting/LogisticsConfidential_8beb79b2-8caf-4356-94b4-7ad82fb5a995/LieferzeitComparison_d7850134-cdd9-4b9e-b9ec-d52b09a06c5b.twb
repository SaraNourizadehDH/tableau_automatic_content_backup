          <datasource-dependencies datasource='federated.1kz0fi11m08l9r1g3063u1v0g6r4'>
            <column datatype='integer' name='[# Orders]' role='measure' type='quantitative' />
            <column caption=' % Accuracy [On-time]' datatype='real' default-format='p0%' name='[% Cancellations (copy)_1423137492533624841]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([% Orders Accurate] * [# Orders])&#10;/&#10;SUM(IF ISNULL([% Orders Accurate]) THEN 0 ELSE [# Orders] END)' />
            </column>
            <column caption=' % Rider Contact Rate' datatype='real' default-format='p0.0%' name='[% Cancellations (copy)_1423137492539985939]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([% Rider Contacts] * [# Orders])&#10;/&#10;SUM(IF ISNULL([% Rider Contacts]) THEN 0 ELSE [# Orders] END)' />
            </column>
            <column caption=' % Motorized Deliveries' datatype='real' default-format='p0%' name='[% Cancellations (copy)_1423137492570746902]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([% orders motorized] * [# Orders])&#10;/&#10;SUM(IF ISNULL([% orders motorized]) THEN 0 ELSE [# Orders] END)' />
            </column>
            <column datatype='real' name='[% Customer Contacts]' role='measure' type='quantitative' />
            <column datatype='real' name='[% Fail Rate (% Cancellations)]' role='measure' type='quantitative' />
            <column datatype='real' name='[% Orders Accurate]' role='measure' type='quantitative' />
            <column caption=' % Customer Contact Rate' datatype='real' default-format='p0.0%' name='[% Rider Contact Rate (copy)_1423137492540211220]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([% Customer Contacts] * [# Orders])&#10;/&#10;SUM(IF ISNULL([% Customer Contacts]) THEN 0 ELSE [# Orders] END)' />
            </column>
            <column datatype='real' name='[% Rider Contacts]' role='measure' type='quantitative' />
            <column caption='% Orders Motorized' datatype='real' name='[% orders motorized]' role='measure' type='quantitative' />
            <column caption='Order Volume' datatype='string' name='[Calculation_1423137492529672192]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [# Orders] &lt; 25000 THEN &apos;0-25K&apos;&#10;ELSEIF [# Orders] &lt; 100000 THEN &apos;25K-100K&apos;&#10;ELSEIF [# Orders] &lt; 200000 THEN &apos;100K-200K&apos;&#10;ELSEIF [# Orders] &lt; 500000 THEN &apos;200K-500K&apos;&#10;ELSEIF [# Orders] &lt; 1000000 THEN &apos;500K-1M&apos;&#10;ELSE &apos;1M+&apos;&#10;END' />
            </column>
            <column caption=' # Cities' datatype='integer' default-format='N' name='[Calculation_1423137492530507777]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([City])' />
            </column>
            <column caption=' DT' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1423137492530626562]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Delivery Time] * [# Orders])&#10;/&#10;SUM(IF ISNULL([Delivery Time]) THEN 0 ELSE [# Orders] END)' />
            </column>
            <column caption=' Logistics Index' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1423137492531089412]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1423137492530626562] / [DT (copy)_1423137492530880515]' />
            </column>
            <column caption=' % Orders' datatype='real' default-format='p0%' name='[Calculation_1423137492531449861]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([# Orders]) / SUM({ FIXED [Grouping] : SUM([# Orders]) })' />
            </column>
            <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption=' UTR [Efficiency]' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[DT (copy)_1423137492530880515]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([UTR (Efficiency)] * [# Orders])&#10;/&#10;SUM([# Orders])' />
            </column>
            <column caption=' % Cancellations' datatype='real' default-format='p0.0%' name='[DT (copy)_1423137492531847174]' role='measure' type='quantitative'>
