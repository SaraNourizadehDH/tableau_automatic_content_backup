          <datasource-dependencies datasource='federated.1kz0fi11m08l9r1g3063u1v0g6r4'>
            <column caption=' % Customer Intents' datatype='real' default-format='p0.0%' name='[ % Customer Contact Rate (copy)_2511249384206565380]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([% Customer Contact Intents] * [# Orders])&#10;/&#10;SUM(IF ISNULL([% Customer Contact Intents]) THEN 0 ELSE [# Orders] END)' />
            </column>
            <column caption=' CPO/AOV' datatype='real' default-format='p0.0%' name='[ % Rider Contact Rate (copy)_2511249384207495173]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Courier CPO / Average Order Value] * [# Orders])&#10;/&#10;SUM([# Orders])' />
            </column>
            <column caption=' Order Density [DH approach]' datatype='real' default-format='n#,##0;-#,##0' name='[ Order Density (copy)_3038100172183146496]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Density (DH) approach] * [# Orders])&#10;/&#10;SUM(IF ISNULL([Density (DH) approach]) THEN 0 ELSE [# Orders] END)' />
            </column>
            <column datatype='integer' name='[# Orders]' role='measure' type='quantitative' />
            <column caption=' % On Time' datatype='real' default-format='p0%' name='[% Accuracy (copy)_1423137492541730837]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([% Orders On Time] * [# Orders])&#10;/&#10;SUM(IF ISNULL([% Orders On Time]) THEN 0 ELSE [# Orders] END)' />
            </column>
            <column caption=' % Accuracy [On-time]' datatype='real' default-format='p0%' name='[% Cancellations (copy)_1423137492533624841]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([% Orders Accurate] * [# Orders])&#10;/&#10;SUM(IF ISNULL([% Orders Accurate]) THEN 0 ELSE [# Orders] END)' />
            </column>
            <column caption=' % Rider Contact Rate' datatype='real' default-format='p0.0%' name='[% Cancellations (copy)_1423137492539985939]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([% Rider Contacts] * [# Orders])&#10;/&#10;SUM(IF ISNULL([% Rider Contacts]) THEN 0 ELSE [# Orders] END)' />
            </column>
            <column caption=' % Motorized Deliveries' datatype='real' default-format='p0%' name='[% Cancellations (copy)_1423137492570746902]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([% orders motorized] * [# Orders])&#10;/&#10;SUM(IF ISNULL([% orders motorized]) THEN 0 ELSE [# Orders] END)' />
            </column>
