      <datasources>
        <datasource name='Parameters' />
        <datasource caption='rps_gsr_device_service_metrics (rl)' name='federated.0qxr6l51bm7h4e19u2f671309mur' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Choose Metrics_4' datatype='string' name='[Choose Metrics (copy 2)_493425658420502532]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% Offline Duration&quot;'>
          <calculation class='tableau' formula='&quot;% Offline Duration&quot;' />
          <members>
            <member value='&quot;\% Vendor Fail Rate&quot;' />
            <member value='&quot;\% Unreachable Duration&quot;' />
            <member value='&quot;\% Offline Duration&quot;' />
          </members>
        </column>
        <column caption='Choose Breakdown_1' datatype='string' datatype-customized='true' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;NGT vs Others&quot;'>
          <calculation class='tableau' formula='&quot;NGT vs Others&quot;' />
          <members>
            <member value='&quot;MDM Solutions&quot;' />
            <member value='&quot;NGT vs Others&quot;' />
            <member value='&quot;Is in VLOG Service&quot;' />
            <member value='&quot;Network Channel&quot;' />
            <member value='&quot;Client Name&quot;' />
          </members>
        </column>
        <column caption='Choose Granularity' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
          <calculation class='tableau' formula='&quot;Daily&quot;' />
          <members>
            <member value='&quot;Daily&quot;' />
            <member value='&quot;Weekly&quot;' />
            <member value='&quot;Monthly&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.0qxr6l51bm7h4e19u2f671309mur'>
        <column caption='Device Manufacturers' datatype='string' name='[Calculation_164240672038150149]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF ([Set 1]) AND [hw_manufacturer] &lt;&gt; &apos;(N/A)&apos; AND [hw_manufacturer] &lt;&gt; &apos;(Unknown)&apos; THEN [hw_manufacturer]&#10;ELSE &apos;(Others)&apos;&#10;END' />
        </column>
        <column caption='is_in_rps_service' datatype='string' name='[Calculation_164240672051978246]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='If([service] = &apos;DMS&apos;) THEN &apos;YES&apos; ELSE &apos;NO&apos; END' />
        </column>
        <column datatype='string' name='[app_version]' role='dimension' type='nominal' />
        <column caption='Brand Name' datatype='string' name='[brand_name]' role='dimension' type='nominal' />
        <column caption='City' datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
        <column caption='client_name_cleaned' datatype='string' name='[client_name (group)]' role='dimension' type='nominal'>
          <calculation class='categorical-bin' column='[client_name]' new-bin='true'>
            <bin default-name='false' value='&quot;(Unknown)&quot;'>
              <value>%null%</value>
              <value>&quot;(Unknown)&quot;</value>
              <value>&quot;POS NON_POS&quot;</value>
            </bin>
            <bin default-name='false' value='&quot;GOWEB&quot;'>
              <value>&quot;GOWIN WEB&quot;</value>
            </bin>
            <bin default-name='false' value='&quot;GOWIN&quot;'>
              <value>&quot;GOWIN UNKNWON&quot;</value>
              <value>&quot;GOWIN WINDOWS&quot;</value>
            </bin>
          </calculation>
        </column>
        <column datatype='string' name='[client_name]' role='dimension' type='nominal' />
        <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
