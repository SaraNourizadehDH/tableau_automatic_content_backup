      <group caption='User Filter - entity_id' name='[User Filter 1]' name-style='unqualified' user:ui-builder='identity-set'>
        <groupfilter function='intersection'>
          <groupfilter function='level-members' level='[entity_id]' />
          <groupfilter function='union'>
            <groupfilter expression='false' function='filter'>
              <groupfilter function='level-members' level='[entity_id]' />
            </groupfilter>
            <groupfilter expression='ISMEMBEROF(&apos;gsr_logistics_carriage_enduser&apos;)' function='filter'>
              <groupfilter function='union'>
                <groupfilter function='member' level='[entity_id]' member='&quot;CG_AE&quot;' />
                <groupfilter function='member' level='[entity_id]' member='&quot;CG_KW&quot;' />
                <groupfilter function='member' level='[entity_id]' member='&quot;CG_QA&quot;' />
              </groupfilter>
            </groupfilter>
            <groupfilter expression='ISMEMBEROF(&apos;gsr_logistics_clickdelivery_south_america_enduser&apos;)' function='filter'>
              <groupfilter function='member' level='[entity_id]' member='&quot;CD_CO&quot;' />
            </groupfilter>
            <groupfilter expression='ISMEMBEROF(&apos;gsr_logistics_damejidlo_czech_republic_enduser&apos;)' function='filter'>
              <groupfilter function='member' level='[entity_id]' member='&quot;DJ_CZ&quot;' />
            </groupfilter>
            <groupfilter expression='ISMEMBEROF(&apos;gsr_logistics_developer&apos;)' function='filter'>
              <groupfilter function='union'>
                <groupfilter function='member' level='[entity_id]' member='&quot;AP_PA&quot;' />
                <groupfilter function='member' level='[entity_id]' member='&quot;AR_HU&quot;' />
