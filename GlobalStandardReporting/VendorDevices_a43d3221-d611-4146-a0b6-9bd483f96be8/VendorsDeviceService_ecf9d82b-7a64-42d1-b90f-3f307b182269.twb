          <alias key='&quot;[federated.0qxr6l51bm7h4e19u2f671309mur].[usr:Calculation_493425658053771265:qk]&quot;' value='Avg. Daily Vendor Failed Orders per Vendor' />
          <alias key='&quot;[federated.0qxr6l51bm7h4e19u2f671309mur].[usr:Calculation_493425658054840322:qk]&quot;' value='Avg. Daily Failed Orders per Vendor' />
