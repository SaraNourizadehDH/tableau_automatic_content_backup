          <groupfilter function='level-members' level='[tdy:created_date:ok]' />
          <groupfilter function='level-members' level='[brand_name]' />
          <groupfilter function='level-members' level='[region]' />
        </groupfilter>
      </group>
      <group caption='_top_manu' name='[Set 1]' name-style='unqualified' user:ui-builder='filter-group'>
        <groupfilter count='10' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
          <groupfilter direction='DESC' expression='[Calculation_231442820903878656]' function='order' user:ui-marker='order'>
            <groupfilter function='level-members' level='[hw_manufacturer]' user:ui-enumeration='all' user:ui-marker='enumerate' />
