    <worksheet name='prop_comp_loc_tbl'>
      <table>
        <view>
          <datasources>
            <datasource caption='rps_gsr_device_service_metrics (rl)' name='federated.0qxr6l51bm7h4e19u2f671309mur' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose Metrics_4' datatype='string' name='[Choose Metrics (copy 2)_493425658420502532]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% Offline Duration&quot;'>
              <calculation class='tableau' formula='&quot;% Offline Duration&quot;' />
            </column>
            <column caption='Choose Granularity' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0qxr6l51bm7h4e19u2f671309mur'>
            <column caption='% Offline Duration' datatype='real' default-format='p0.0%' name='[% Unreachable Duration (copy)_493425658428129285]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([mnt_daily_offline])/SUM([mnt_daily_schedule])' />
            </column>
            <column caption='# Unreachable Failed Orders' datatype='integer' name='[Calculation_143059679014850562]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_failed_unreachable_orders])' />
            </column>
            <column caption='% Unreachable Duration' datatype='real' default-format='p0.0%' name='[Calculation_143059679017082883]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([mnt_daily_unreachable])/SUM([mnt_daily_schedule])' />
            </column>
            <column caption='_date_daily' datatype='string' default-format='*yyyy-mm-dd' name='[Calculation_149744718183436290]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([created_date])' />
            </column>
            <column caption='_date_main' datatype='string' name='[Calculation_149744718204440582]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3]=&apos;Daily&apos; THEN STR([Calculation_149744718183436290])&#10;ELSEIF [Parameters].[Parameter 3]=&apos;Weekly&apos; THEN STR([_daily_date (copy)_149744718183628803])&#10;ELSEIF [Parameters].[Parameter 3]=&apos;Monthly&apos; THEN STR([_daily_date (copy) (copy)_149744718183641092])&#10;END' />
            </column>
            <column caption='_is_curr_date' datatype='boolean' name='[Calculation_161425925731332096]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='([created_date] = TODAY())' />
            </column>
            <column caption='Device Manufacturers' datatype='string' name='[Calculation_164240672038150149]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([Set 1]) AND [hw_manufacturer] &lt;&gt; &apos;(N/A)&apos; AND [hw_manufacturer] &lt;&gt; &apos;(Unknown)&apos; THEN [hw_manufacturer]&#10;ELSE &apos;(Others)&apos;&#10;END' />
            </column>
            <column caption='is_in_rps_service' datatype='string' name='[Calculation_164240672051978246]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If([service] = &apos;DMS&apos;) THEN &apos;YES&apos; ELSE &apos;NO&apos; END' />
            </column>
            <column caption='% Vendor Fail Rate' datatype='real' default-format='p0.0%' name='[Calculation_164240672060366856]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_164240672060624905]/[Calculation_231442820903878656]' />
            </column>
            <column caption='# Vendor Fail Orders' datatype='integer' name='[Calculation_164240672060624905]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_failed_vendors_orders])' />
            </column>
            <column caption='% Unreachable Fail Shares from All Vendor Fail Rate' datatype='real' default-format='p0.0%' name='[Calculation_1821635704822706176]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_143059679014850562]/[Calculation_164240672060624905]' />
            </column>
            <column caption='% Vendor Fail Shares from All Failed Orders' datatype='real' default-format='p0.0%' name='[Calculation_1821635704823029761]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_164240672060624905]/[Calculation_231442820905885697]' />
            </column>
            <column caption='# Orders' datatype='integer' name='[Calculation_231442820903878656]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_orders])' />
            </column>
            <column caption='# Failed Orders' datatype='integer' name='[Calculation_231442820905885697]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_failed_orders])' />
            </column>
            <column caption='_vendor_fail_val' datatype='real' default-format='p0.0%' name='[Calculation_493425658432684038]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Choose Metrics (copy 2)_493425658420502532]&#10;WHEN &apos;% Vendor Fail Rate&apos; THEN [Calculation_164240672060366856]&#10;WHEN &apos;% Vendor Fail Share&apos; THEN [Calculation_1821635704823029761]&#10;WHEN &apos;% Unreachable Fail Share&apos; THEN [Calculation_1821635704822706176]&#10;WHEN &apos;% Unreachable Duration&apos; THEN [Calculation_143059679017082883]&#10;WHEN &apos;% Offline Duration&apos; THEN [% Unreachable Duration (copy)_493425658428129285]&#10;END' />
            </column>
            <column caption='_date_monthly' datatype='string' default-format='*yyyy-mm' name='[_daily_date (copy) (copy)_149744718183641092]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF(MONTH([created_date])) &lt; 10&#10;THEN STR(YEAR([created_date])) + &apos;-0&apos; +STR(MONTH([created_date]))&#10;ELSE STR(YEAR([created_date])) + &apos;-&apos; +STR(MONTH([created_date]))&#10;END' />
            </column>
            <column caption='_date_weekly' datatype='string' default-format='*yyyy-ww' name='[_daily_date (copy)_149744718183628803]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF WEEK(DATETRUNC(&apos;week&apos;,[created_date], &apos;monday&apos;)) &lt; 10&#10;THEN STR(YEAR([created_date]))+&apos;-0&apos;+ STR(WEEK(DATETRUNC(&apos;week&apos;,[created_date], &apos;monday&apos;)))&#10;ELSE STR(YEAR([created_date]))+&apos;-&apos;+ STR(WEEK(DATETRUNC(&apos;week&apos;,[created_date], &apos;monday&apos;)))&#10;END' />
            </column>
            <column caption='Brand Name' datatype='string' name='[brand_name]' role='dimension' type='nominal' />
            <column datatype='date' name='[created_date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[hw_manufacturer]' role='dimension' type='nominal' />
            <column datatype='string' name='[mdm_service]' role='dimension' type='nominal' />
