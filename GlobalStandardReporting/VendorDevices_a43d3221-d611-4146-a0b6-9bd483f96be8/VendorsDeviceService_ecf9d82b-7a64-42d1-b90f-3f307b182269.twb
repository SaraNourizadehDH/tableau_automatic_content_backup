    <worksheet name='inp_trend_1a'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='9'>&lt;</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='9'>[Parameters].[Parameter 2]</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='9'>&gt; Over Time of &lt;</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='9'>[Parameters].[Parameter 1]</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='9'>&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='rps_gsr_device_service_metrics (rl)' name='federated.0qxr6l51bm7h4e19u2f671309mur' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose Breakdown_1' datatype='string' datatype-customized='true' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;NGT vs Others&quot;'>
              <calculation class='tableau' formula='&quot;NGT vs Others&quot;' />
            </column>
            <column caption='Choose Metrics' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;\# Daily Active Vendors&quot;'>
              <calculation class='tableau' formula='&quot;# Daily Active Vendors&quot;' />
            </column>
            <column caption='Choose Granularity' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0qxr6l51bm7h4e19u2f671309mur'>
            <column caption='# Daily Active Devices' datatype='real' name='[# Daily Active Vendors (copy)_408349858353303556]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF( [Parameters].[Parameter 3] = &apos;Daily&apos; )&#10;    THEN SUM([no_daily_devices])&#10;    ELSE AVG({INCLUDE DATETRUNC(&apos;day&apos;, [created_date]) : SUM([no_daily_devices])})&#10;END' />
            </column>
            <column caption='_implementation_val_abs' datatype='real' name='[Calculation_147281802568577025]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;# Daily Active Devices&apos; THEN [# Daily Active Vendors (copy)_408349858353303556]&#10;WHEN &apos;# Daily Active Vendors&apos; THEN [Calculation_408349858352578562]&#10;WHEN &apos;# Orders&apos; THEN SUM([no_orders])&#10;WHEN &apos;# Failed Orders&apos; THEN SUM([no_failed_orders])&#10;END' />
            </column>
            <column caption='_date_daily' datatype='string' default-format='*yyyy-mm-dd' name='[Calculation_149744718183436290]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([created_date])' />
            </column>
            <column caption='_date_main' datatype='string' name='[Calculation_149744718204440582]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3]=&apos;Daily&apos; THEN STR([Calculation_149744718183436290])&#10;ELSEIF [Parameters].[Parameter 3]=&apos;Weekly&apos; THEN STR([_daily_date (copy)_149744718183628803])&#10;ELSEIF [Parameters].[Parameter 3]=&apos;Monthly&apos; THEN STR([_daily_date (copy) (copy)_149744718183641092])&#10;END' />
            </column>
            <column caption='_breakdowns' datatype='string' name='[Calculation_156359369542631424]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;MDM Solutions&apos; THEN [mdm_service]&#10;WHEN &apos;NGT vs Others&apos; THEN (IF [is_ngt] THEN &apos;NGT&apos; ELSE &apos;Others&apos; END)&#10;WHEN &apos;Is in VLOG Service&apos; THEN [service]&#10;WHEN &apos;Network Channel&apos; THEN [network_channel]&#10;WHEN &apos;Client App. Version&apos; THEN [app_version]&#10;WHEN &apos;Client Name&apos; THEN [client_name (group)]&#10;END' />
            </column>
            <column caption='_is_curr_date' datatype='boolean' name='[Calculation_161425925731332096]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='([created_date] = TODAY())' />
            </column>
            <column caption='# Daily Active Vendors' datatype='real' name='[Calculation_408349858352578562]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF( [Parameters].[Parameter 3] = &apos;Daily&apos; )&#10;    THEN SUM([no_daily_vendors])&#10;    ELSE AVG({INCLUDE DATETRUNC(&apos;day&apos;, [created_date]) : SUM([no_daily_vendors])})&#10;END' />
            </column>
            <column caption='_chosen_metrics_trend_odr' datatype='boolean' name='[_chosen_metrics_trend_unr (copy)_476044558387412994]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF([Parameters].[Parameter 2] = &apos;% Unreachable Durations&apos; &#10;OR [Parameters].[Parameter 2] = &apos;% Fail Rate Caused by Unreachable&apos;&#10;OR [Parameters].[Parameter 2] = &apos;% Vendor Fail Rate&apos;) &#10;THEN FALSE&#10;ELSE TRUE&#10;END' />
            </column>
            <column caption='_date_monthly' datatype='string' default-format='*yyyy-mm' name='[_daily_date (copy) (copy)_149744718183641092]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF(MONTH([created_date])) &lt; 10&#10;THEN STR(YEAR([created_date])) + &apos;-0&apos; +STR(MONTH([created_date]))&#10;ELSE STR(YEAR([created_date])) + &apos;-&apos; +STR(MONTH([created_date]))&#10;END' />
            </column>
            <column caption='_date_weekly' datatype='string' default-format='*yyyy-ww' name='[_daily_date (copy)_149744718183628803]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF WEEK(DATETRUNC(&apos;week&apos;,[created_date], &apos;monday&apos;)) &lt; 10&#10;THEN STR(YEAR([created_date]))+&apos;-0&apos;+ STR(WEEK(DATETRUNC(&apos;week&apos;,[created_date], &apos;monday&apos;)))&#10;ELSE STR(YEAR([created_date]))+&apos;-&apos;+ STR(WEEK(DATETRUNC(&apos;week&apos;,[created_date], &apos;monday&apos;)))&#10;END' />
            </column>
            <column datatype='string' name='[app_version]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_156359369542631424]' derivation='Attribute' name='[attr:Calculation_156359369542631424:nk]' pivot='key' type='nominal' />
            <column caption='client_name_cleaned' datatype='string' name='[client_name (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[client_name]' new-bin='true'>
                <bin default-name='false' value='&quot;(Unknown)&quot;'>
                  <value>%null%</value>
                  <value>&quot;(Unknown)&quot;</value>
                  <value>&quot;POS NON_POS&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;GOWEB&quot;'>
                  <value>&quot;GOWIN WEB&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;GOWIN&quot;'>
                  <value>&quot;GOWIN UNKNWON&quot;</value>
                  <value>&quot;GOWIN WINDOWS&quot;</value>
                </bin>
              </calculation>
            </column>
            <column datatype='string' name='[client_name]' role='dimension' type='nominal' />
            <column datatype='date' name='[created_date]' role='dimension' type='ordinal' />
            <column datatype='boolean' name='[is_ngt]' role='dimension' type='nominal' />
            <column datatype='string' name='[mdm_service]' role='dimension' type='nominal' />
            <column datatype='string' name='[network_channel]' role='dimension' type='nominal' />
            <column datatype='integer' name='[no_daily_devices]' role='measure' type='quantitative' />
