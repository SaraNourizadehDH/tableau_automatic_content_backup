    <worksheet name='ovr_grwth_tbl'>
      <table>
        <view>
          <datasources>
            <datasource caption='rps_gsr_device_service_metrics (rl)' name='federated.0qxr6l51bm7h4e19u2f671309mur' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose Granularity' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0qxr6l51bm7h4e19u2f671309mur'>
            <column caption='% Difference - Unreachable Duration Pctg' datatype='real' default-format='p0.00%' name='[% Growth Rate - Fail Rate (copy)_169729445027516420]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='(&#10;// present&#10;(&#10;SUM(IF([Calculation_155796433322123265]) &#10;THEN [mnt_daily_unreachable] ELSE NULL END)&#10;/&#10;SUM(IF([Calculation_155796433322123265]) &#10;THEN [mnt_daily_schedule] ELSE NULL END)&#10;)&#10; -&#10;(&#10;// past&#10;SUM(IF([_ovr_date_filter (copy)_463589320431411202]) &#10;THEN [mnt_daily_unreachable] ELSE NULL END)&#10;/&#10;SUM(IF([_ovr_date_filter (copy)_463589320431411202]) &#10;THEN [mnt_daily_schedule] ELSE NULL END)&#10;)&#10;)&#10;/&#10;(&#10;// past&#10;SUM(IF([_ovr_date_filter (copy)_463589320431411202]) &#10;THEN [mnt_daily_unreachable] ELSE NULL END)&#10;/&#10;SUM(IF([_ovr_date_filter (copy)_463589320431411202]) &#10;THEN [mnt_daily_schedule] ELSE NULL END)&#10;)' />
            </column>
            <column caption='% Difference - Unreachable Fail Rate' datatype='real' default-format='p0.00%' name='[% Growth Rate - Fail Rate (copy)_169729445058969606]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='(&#10;// present&#10;(&#10;SUM(IF([Calculation_155796433322123265]) &#10;THEN [no_failed_unreachable_orders] ELSE NULL END)&#10;/&#10;SUM(IF([Calculation_155796433322123265]) &#10;THEN [no_orders] ELSE NULL END)&#10;)&#10; -&#10;(&#10;// past&#10;SUM(IF([_ovr_date_filter (copy)_463589320431411202]) &#10;THEN [no_failed_unreachable_orders] ELSE NULL END)&#10;/&#10;SUM(IF([_ovr_date_filter (copy)_463589320431411202]) &#10;THEN [no_orders] ELSE NULL END)&#10;)&#10;)&#10;/&#10;(&#10;// past&#10;SUM(IF([_ovr_date_filter (copy)_463589320431411202]) &#10;THEN [no_failed_unreachable_orders] ELSE NULL END)&#10;/&#10;SUM(IF([_ovr_date_filter (copy)_463589320431411202]) &#10;THEN [no_orders] ELSE NULL END)&#10;)' />
            </column>
            <column caption='% Difference - Fail Rate' datatype='real' default-format='p0.00%' name='[% Growth Rate - Failed Orders (copy)_169729445026516995]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='(&#10;// present&#10;(&#10;SUM(IF([Calculation_155796433322123265]) &#10;THEN [no_failed_orders] ELSE NULL END)&#10;/&#10;SUM(IF([Calculation_155796433322123265]) &#10;THEN [no_orders] ELSE NULL END)&#10;)&#10; -&#10;(&#10;// past&#10;SUM(IF([_ovr_date_filter (copy)_463589320431411202]) &#10;THEN [no_failed_orders] ELSE NULL END)&#10;/&#10;SUM(IF([_ovr_date_filter (copy)_463589320431411202]) &#10;THEN [no_orders] ELSE NULL END)&#10;)&#10;)&#10;/&#10;(&#10;// past&#10;SUM(IF([_ovr_date_filter (copy)_463589320431411202]) &#10;THEN [no_failed_orders] ELSE NULL END)&#10;/&#10;SUM(IF([_ovr_date_filter (copy)_463589320431411202]) &#10;THEN [no_orders] ELSE NULL END)&#10;)' />
            </column>
            <column caption='% Difference - Vendor Fail Rate' datatype='real' default-format='p0.00%' name='[% Growth Rate - Orders (copy) (copy)_169729445022998530]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='(&#10;// present&#10;(&#10;SUM(IF([Calculation_155796433322123265]) &#10;THEN [no_failed_vendors_orders] ELSE NULL END)&#10;/&#10;SUM(IF([Calculation_155796433322123265]) &#10;THEN [no_orders] ELSE NULL END)&#10;)&#10; -&#10;(&#10;// past&#10;SUM(IF([_ovr_date_filter (copy)_463589320431411202]) &#10;THEN [no_failed_vendors_orders] ELSE NULL END)&#10;/&#10;SUM(IF([_ovr_date_filter (copy)_463589320431411202]) &#10;THEN [no_orders] ELSE NULL END)&#10;)&#10;)&#10;/&#10;(&#10;// past&#10;SUM(IF([_ovr_date_filter (copy)_463589320431411202]) &#10;THEN [no_failed_vendors_orders] ELSE NULL END)&#10;/&#10;SUM(IF([_ovr_date_filter (copy)_463589320431411202]) &#10;THEN [no_orders] ELSE NULL END)&#10;)' />
            </column>
            <column caption='% Difference - Unreachable Failed Orders' datatype='real' default-format='p0.00%' name='[% Growth Rate - Orders (copy)_169729445022969857]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='(&#10;// present&#10;SUM(IF([Calculation_155796433322123265]) &#10;THEN [no_failed_unreachable_orders] ELSE NULL END)&#10; -&#10;// past&#10;SUM(IF([_ovr_date_filter (copy)_463589320431411202]) &#10;THEN [no_failed_unreachable_orders] ELSE NULL END)&#10;)&#10;/&#10;// past&#10;SUM(IF([_ovr_date_filter (copy)_463589320431411202]) &#10;THEN [no_failed_unreachable_orders] ELSE NULL END)' />
            </column>
            <column caption='_ovr_date_filter' datatype='boolean' name='[Calculation_155796433322123265]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF(created_date &gt; &#10;CASE [Parameters].[Parameter 3]&#10;  WHEN &apos;Daily&apos; THEN DATEADD(&apos;day&apos;, -8, {FIXED : MAX([created_date])})&#10;  WHEN &apos;Weekly&apos; THEN DATEADD(&apos;day&apos;, -31, {FIXED : MAX([created_date])})&#10;  WHEN &apos;Monthly&apos; THEN DATEADD(&apos;day&apos;, -91, {FIXED : MAX([created_date])})&#10;END) &#10;THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='_is_curr_date' datatype='boolean' name='[Calculation_161425925731332096]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='([created_date] = TODAY())' />
            </column>
            <column caption='% Difference - Orders' datatype='real' default-format='p0.00%' name='[_atest_prev_orders (copy)_169729445020131328]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='(&#10;// present&#10;SUM(IF([Calculation_155796433322123265]) &#10;THEN [no_orders] ELSE NULL END)&#10; -&#10;// past&#10;SUM(IF([_ovr_date_filter (copy)_463589320431411202]) &#10;THEN [no_orders] ELSE NULL END)&#10;)&#10;/&#10;// past&#10;SUM(IF([_ovr_date_filter (copy)_463589320431411202]) &#10;THEN [no_orders] ELSE NULL END)' />
            </column>
            <column caption='_ovr_prevdate_filter' datatype='boolean' name='[_ovr_date_filter (copy)_463589320431411202]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF(created_date &lt; &#10;CASE [Parameters].[Parameter 3]&#10;  WHEN &apos;Daily&apos; THEN DATEADD(&apos;day&apos;, -7, {FIXED : MAX([created_date])})&#10;  WHEN &apos;Weekly&apos; THEN DATEADD(&apos;day&apos;, -30, {FIXED : MAX([created_date])})&#10;  WHEN &apos;Monthly&apos; THEN DATEADD(&apos;day&apos;, -90, {FIXED : MAX([created_date])})&#10;END&#10;AND created_date &gt;= &#10;CASE [Parameters].[Parameter 3]&#10;  WHEN &apos;Daily&apos; THEN DATEADD(&apos;day&apos;, -14, {FIXED : MAX([created_date])})&#10;  WHEN &apos;Weekly&apos; THEN DATEADD(&apos;day&apos;, -60, {FIXED : MAX([created_date])})&#10;  WHEN &apos;Monthly&apos; THEN {FIXED : MIN([created_date])}&#10;END) &#10;THEN TRUE ELSE FALSE END' />
            </column>
            <column datatype='date' name='[created_date]' role='dimension' type='ordinal' />
            <column datatype='real' name='[mnt_daily_schedule]' role='measure' type='quantitative' />
            <column datatype='real' name='[mnt_daily_unreachable]' role='measure' type='quantitative' />
            <column datatype='integer' name='[no_failed_orders]' role='measure' type='quantitative' />
            <column datatype='integer' name='[no_failed_unreachable_orders]' role='measure' type='quantitative' />
            <column datatype='integer' name='[no_failed_vendors_orders]' role='measure' type='quantitative' />
            <column datatype='integer' name='[no_orders]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_161425925731332096]' derivation='None' name='[none:Calculation_161425925731332096:nk]' pivot='key' type='nominal' />
            <column-instance column='[% Growth Rate - Fail Rate (copy)_169729445027516420]' derivation='User' name='[usr:% Growth Rate - Fail Rate (copy)_169729445027516420:qk]' pivot='key' type='quantitative' />
            <column-instance column='[% Growth Rate - Fail Rate (copy)_169729445058969606]' derivation='User' name='[usr:% Growth Rate - Fail Rate (copy)_169729445058969606:qk]' pivot='key' type='quantitative' />
            <column-instance column='[% Growth Rate - Failed Orders (copy)_169729445026516995]' derivation='User' name='[usr:% Growth Rate - Failed Orders (copy)_169729445026516995:qk]' pivot='key' type='quantitative' />
            <column-instance column='[% Growth Rate - Orders (copy) (copy)_169729445022998530]' derivation='User' name='[usr:% Growth Rate - Orders (copy) (copy)_169729445022998530:qk]' pivot='key' type='quantitative' />
            <column-instance column='[% Growth Rate - Orders (copy)_169729445022969857]' derivation='User' name='[usr:% Growth Rate - Orders (copy)_169729445022969857:qk]' pivot='key' type='quantitative' />
