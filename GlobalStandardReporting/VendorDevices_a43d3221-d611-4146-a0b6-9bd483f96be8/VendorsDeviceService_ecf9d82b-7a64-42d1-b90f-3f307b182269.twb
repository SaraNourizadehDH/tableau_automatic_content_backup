          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose Dimension (B)' datatype='string' name='[Choose Dimension (A) (copy)_217650530091704324]' param-domain-type='list' role='measure' type='nominal' value='&quot;Brand Name&quot;'>
              <calculation class='tableau' formula='&quot;Brand Name&quot;' />
            </column>
            <column caption='Choose Metrics' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;\# Daily Active Vendors&quot;'>
              <calculation class='tableau' formula='&quot;# Daily Active Vendors&quot;' />
            </column>
            <column caption='Choose Granularity' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
            <column caption='Choose Dimension (A)' datatype='string' name='[_static_number (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;Region&quot;'>
              <calculation class='tableau' formula='&quot;Region&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0qxr6l51bm7h4e19u2f671309mur'>
            <column aggregation='Attribute' caption='# Total Orders' datatype='integer' name='[# Orders (copy)_217650530135961606]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{EXCLUDE [Calculation_149744718204440582]&#10;    , [region]&#10;    , [country_name]&#10;    , [city_name]&#10;    , [network_channel]&#10;    , [vendor_grade]&#10;    , [brand_name]&#10;    , [client_name (group)]&#10;    , [Calculation_217650530126057477]&#10;    , [mdm_service]&#10;    , [Calculation_164240672051978246]&#10;    , [Calculation_164240672038150149]&#10;    , [Calculation_164240672038150149]&#10;    , [app_version]&#10;    , [Calculation_217650530076626945]&#10;    , [Dimension (A) (copy)_217650530091016195]&#10;: SUM([no_orders])}' />
            </column>
            <column caption='_date_daily' datatype='string' default-format='*yyyy-mm-dd' name='[Calculation_149744718183436290]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([created_date])' />
            </column>
            <column caption='_date_main' datatype='string' name='[Calculation_149744718204440582]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3]=&apos;Daily&apos; THEN STR([Calculation_149744718183436290])&#10;ELSEIF [Parameters].[Parameter 3]=&apos;Weekly&apos; THEN STR([_daily_date (copy)_149744718183628803])&#10;ELSEIF [Parameters].[Parameter 3]=&apos;Monthly&apos; THEN STR([_daily_date (copy) (copy)_149744718183641092])&#10;END' />
            </column>
            <column caption='_is_curr_date' datatype='boolean' name='[Calculation_161425925731332096]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='([created_date] = TODAY())' />
            </column>
            <column caption='Device Manufacturers' datatype='string' name='[Calculation_164240672038150149]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([Set 1]) AND [hw_manufacturer] &lt;&gt; &apos;(N/A)&apos; AND [hw_manufacturer] &lt;&gt; &apos;(Unknown)&apos; THEN [hw_manufacturer]&#10;ELSE &apos;(Others)&apos;&#10;END' />
            </column>
            <column caption='is_in_rps_service' datatype='string' name='[Calculation_164240672051978246]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If([service] = &apos;DMS&apos;) THEN &apos;YES&apos; ELSE &apos;NO&apos; END' />
            </column>
            <column caption='% Vendor Fail Rate' datatype='real' default-format='p0.0%' name='[Calculation_164240672060366856]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_164240672060624905]/[Calculation_231442820903878656]' />
            </column>
            <column caption='# Vendor Fail Orders' datatype='integer' name='[Calculation_164240672060624905]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_failed_vendors_orders])' />
            </column>
            <column caption='Dimension (A)' datatype='string' name='[Calculation_217650530076626945]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[_static_number (copy)] &#10;WHEN &apos;Region&apos; THEN [region]&#10;WHEN &apos;Brand Name&apos; THEN [brand_name]&#10;WHEN &apos;Country&apos; THEN [country_name]&#10;WHEN &apos;City&apos; THEN [city_name]&#10;WHEN &apos;Client Name&apos; THEN [client_name (group)]&#10;WHEN &apos;Vendor Grade&apos; THEN [vendor_grade]&#10;WHEN &apos;Is NGT?&apos; THEN [Calculation_217650530126057477]&#10;WHEN &apos;Is in VLOG Service?&apos; THEN [Calculation_164240672051978246]&#10;WHEN &apos;MDM Service&apos; THEN [mdm_service]&#10;WHEN &apos;Device Manufacturer&apos; THEN [Calculation_164240672038150149]&#10;WHEN &apos;Client Version&apos; THEN [app_version]&#10;WHEN &apos;Network Channel&apos; THEN [network_channel]&#10;WHEN &apos;(All)&apos; THEN &apos;&apos;&#10;END' />
            </column>
            <column caption='Is NGT' datatype='string' name='[Calculation_217650530126057477]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF([is_ngt]) THEN &apos;YES&apos;&#10;ELSEIF(NOT [is_ngt]) THEN &apos;NO&apos;&#10;ELSE &apos;(Unknown)&apos;&#10;END' />
            </column>
            <column caption='% Orders Share' datatype='real' default-format='p0.0%' name='[Calculation_217650530142859272]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ATTR({EXCLUDE [Calculation_149744718204440582] : [Calculation_231442820903878656]})/ATTR([# Orders (copy)_217650530135961606])' />
            </column>
            <column caption='# Orders' datatype='integer' name='[Calculation_231442820903878656]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_orders])' />
            </column>
            <column caption='_chosen_metrics_trend_vfr' datatype='boolean' name='[Calculation_476044558338875392]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF([Parameters].[Parameter 2] = &apos;% Vendor Fail Rate&apos;) THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='Dimension (B)' datatype='string' name='[Dimension (A) (copy)_217650530091016195]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Choose Dimension (A) (copy)_217650530091704324] &#10;WHEN &apos;Region&apos; THEN [region]&#10;WHEN &apos;Brand Name&apos; THEN [brand_name]&#10;WHEN &apos;Country&apos; THEN [country_name]&#10;WHEN &apos;City&apos; THEN [city_name]&#10;WHEN &apos;Client Name&apos; THEN [client_name (group)]&#10;WHEN &apos;Vendor Grade&apos; THEN [vendor_grade]&#10;WHEN &apos;Is NGT?&apos; THEN [Calculation_217650530126057477]&#10;WHEN &apos;Is in VLOG Service?&apos; THEN [Calculation_164240672051978246]&#10;WHEN &apos;MDM Service&apos; THEN [mdm_service]&#10;WHEN &apos;Device Manufacturer&apos; THEN [Calculation_164240672038150149]&#10;WHEN &apos;Client Version&apos; THEN [app_version]&#10;WHEN &apos;Network Channel&apos; THEN [network_channel]&#10;WHEN &apos;(All)&apos; THEN &apos;&apos;&#10;END' />
            </column>
            <column caption='_date_monthly' datatype='string' default-format='*yyyy-mm' name='[_daily_date (copy) (copy)_149744718183641092]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF(MONTH([created_date])) &lt; 10&#10;THEN STR(YEAR([created_date])) + &apos;-0&apos; +STR(MONTH([created_date]))&#10;ELSE STR(YEAR([created_date])) + &apos;-&apos; +STR(MONTH([created_date]))&#10;END' />
            </column>
            <column caption='_date_weekly' datatype='string' default-format='*yyyy-ww' name='[_daily_date (copy)_149744718183628803]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF WEEK(DATETRUNC(&apos;week&apos;,[created_date], &apos;monday&apos;)) &lt; 10&#10;THEN STR(YEAR([created_date]))+&apos;-0&apos;+ STR(WEEK(DATETRUNC(&apos;week&apos;,[created_date], &apos;monday&apos;)))&#10;ELSE STR(YEAR([created_date]))+&apos;-&apos;+ STR(WEEK(DATETRUNC(&apos;week&apos;,[created_date], &apos;monday&apos;)))&#10;END' />
            </column>
