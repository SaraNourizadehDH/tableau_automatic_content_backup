      <column caption='_impleentation_tag_pctg' datatype='string' name='[Calculation_1953365994080083971]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;# Daily Devices&apos; THEN &apos;% Device Shares&apos;&#10;WHEN &apos;# Daily Active Vendors&apos; THEN &apos;% Active Vendors Shares&apos;&#10;WHEN &apos;# Orders&apos; THEN &apos;% Orders Shares&apos;&#10;WHEN &apos;# Failed Orders&apos; THEN &apos;% Failed Orders Shares&apos;&#10;END' />
      </column>
