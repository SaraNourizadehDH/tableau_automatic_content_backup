            <column datatype='date' name='[created_date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_161425925731332096]' derivation='None' name='[none:Calculation_161425925731332096:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_463589320427728896]' derivation='None' name='[none:Calculation_463589320427728896:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <slices>
