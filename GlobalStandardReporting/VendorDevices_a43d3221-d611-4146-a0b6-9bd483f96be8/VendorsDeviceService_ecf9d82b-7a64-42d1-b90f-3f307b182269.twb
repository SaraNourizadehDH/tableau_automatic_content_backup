        <calculation class='tableau' formula='CASE [Parameters].[_static_number (copy)] &#10;WHEN &apos;Region&apos; THEN [region]&#10;WHEN &apos;Brand Name&apos; THEN [brand_name]&#10;WHEN &apos;Country&apos; THEN [country_name]&#10;WHEN &apos;City&apos; THEN [city_name]&#10;WHEN &apos;Client Name&apos; THEN [client_name (group)]&#10;WHEN &apos;Vendor Grade&apos; THEN [vendor_grade]&#10;WHEN &apos;Is NGT?&apos; THEN [Calculation_217650530126057477]&#10;WHEN &apos;Is in VLOG Service?&apos; THEN [Calculation_164240672051978246]&#10;WHEN &apos;MDM Service&apos; THEN [mdm_service]&#10;WHEN &apos;Device Manufacturer&apos; THEN [Calculation_164240672038150149]&#10;WHEN &apos;Client Version&apos; THEN [app_version]&#10;WHEN &apos;Network Channel&apos; THEN [network_channel]&#10;WHEN &apos;(All)&apos; THEN &apos;&apos;&#10;END' />
      </column>
      <column caption='Is NGT' datatype='string' name='[Calculation_217650530126057477]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF([is_ngt]) THEN &apos;YES&apos;&#10;ELSEIF(NOT [is_ngt]) THEN &apos;NO&apos;&#10;ELSE &apos;(Unknown)&apos;&#10;END' />
      </column>
      <column caption='% Orders Share' datatype='real' default-format='p0.0%' name='[Calculation_217650530142859272]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ATTR({EXCLUDE [Calculation_149744718204440582] : [Calculation_231442820903878656]})/ATTR([# Orders (copy)_217650530135961606])' />
      </column>
      <column caption='# Orders' datatype='integer' name='[Calculation_231442820903878656]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([no_orders])' />
      </column>
      <column caption='# Failed Orders' datatype='integer' name='[Calculation_231442820905885697]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([no_failed_orders])' />
      </column>
      <column caption='% Failed Rate' datatype='real' default-format='p0.0%' name='[Calculation_231442820910583810]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_231442820905885697]&#10;/ [Calculation_231442820903878656]' />
      </column>
      <column caption='_chosen_absolut' datatype='boolean' name='[Calculation_379498668555776001]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Choose Breakdown_1 (copy)] = &apos;Absolute&apos;&#10;  THEN TRUE&#10;END' />
      </column>
      <column caption='_chosen_percentage' datatype='boolean' name='[Calculation_379498668556709890]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Choose Breakdown_1 (copy)] = &apos;Percentage&apos;&#10;  THEN TRUE&#10;END' />
      </column>
      <column caption='# Daily Active Vendors' datatype='real' name='[Calculation_408349858352578562]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF( [Parameters].[Parameter 3] = &apos;Daily&apos; )&#10;    THEN SUM([no_daily_vendors])&#10;    ELSE AVG({INCLUDE DATETRUNC(&apos;day&apos;, [created_date]) : SUM([no_daily_vendors])})&#10;END' />
      </column>
      <column caption='_ovr_title_lbl' datatype='string' name='[Calculation_463589320427728896]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;  WHEN &apos;Daily&apos; THEN &apos;7 Days&apos;&#10;  WHEN &apos;Weekly&apos; THEN &apos;4 Weeks&apos;&#10;  WHEN &apos;Monthly&apos; THEN &apos;3 Months&apos;&#10;END' />
      </column>
      <column caption='_chosen_metrics_trend_vfr' datatype='boolean' name='[Calculation_476044558338875392]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF([Parameters].[Parameter 2] = &apos;% Vendor Fail Rate&apos;) THEN TRUE&#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_4905827433140772864]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Avg. Orders per Vendor per Day' datatype='real' name='[Calculation_493425658052599808]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([no_orders])' />
      </column>
      <column caption='Avg. Vendor Failed Orders' datatype='real' name='[Calculation_493425658053771265]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([no_failed_vendors_orders])' />
      </column>
      <column caption='Avg. Failed Orders per Vendor per Day' datatype='real' name='[Calculation_493425658054840322]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([no_failed_orders])' />
      </column>
      <column caption='Avg. Failed Orders Caused by Unreachable' datatype='real' name='[Calculation_493425658396278787]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([no_failed_unreachable_orders])' />
      </column>
      <column caption='_vendor_fail_val' datatype='real' default-format='p0.0%' name='[Calculation_493425658432684038]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Choose Metrics (copy 2)_493425658420502532]&#10;WHEN &apos;% Vendor Fail Rate&apos; THEN [Calculation_164240672060366856]&#10;WHEN &apos;% Vendor Fail Share&apos; THEN [Calculation_1821635704823029761]&#10;WHEN &apos;% Unreachable Fail Share&apos; THEN [Calculation_1821635704822706176]&#10;WHEN &apos;% Unreachable Duration&apos; THEN [Calculation_143059679017082883]&#10;WHEN &apos;% Offline Duration&apos; THEN [% Unreachable Duration (copy)_493425658428129285]&#10;END' />
      </column>
      <column caption='Dimension (B)' datatype='string' name='[Dimension (A) (copy)_217650530091016195]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Choose Dimension (A) (copy)_217650530091704324] &#10;WHEN &apos;Region&apos; THEN [region]&#10;WHEN &apos;Brand Name&apos; THEN [brand_name]&#10;WHEN &apos;Country&apos; THEN [country_name]&#10;WHEN &apos;City&apos; THEN [city_name]&#10;WHEN &apos;Client Name&apos; THEN [client_name (group)]&#10;WHEN &apos;Vendor Grade&apos; THEN [vendor_grade]&#10;WHEN &apos;Is NGT?&apos; THEN [Calculation_217650530126057477]&#10;WHEN &apos;Is in VLOG Service?&apos; THEN [Calculation_164240672051978246]&#10;WHEN &apos;MDM Service&apos; THEN [mdm_service]&#10;WHEN &apos;Device Manufacturer&apos; THEN [Calculation_164240672038150149]&#10;WHEN &apos;Client Version&apos; THEN [app_version]&#10;WHEN &apos;Network Channel&apos; THEN [network_channel]&#10;WHEN &apos;(All)&apos; THEN &apos;&apos;&#10;END' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='_tableau_entity_user_entitlements_entity_id' datatype='table' name='[__tableau_internal_object_id__].[_tableau_entity_user_entitlements_entity_id_D2CA625B964B4B6B93F608AF11D22863]' role='measure' type='quantitative' />
      <_.fcp.ObjectModelTableType.true...column caption='rps_gsr_device_service_metrics' datatype='table' name='[__tableau_internal_object_id__].[rps_gsr_device_service_metrics_3639C972E3914C4FB54CB645890DEF0D]' role='measure' type='quantitative' />
      <column caption='% Difference - Orders' datatype='real' default-format='p0.00%' name='[_atest_prev_orders (copy)_169729445020131328]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='(&#10;// present&#10;SUM(IF([Calculation_155796433322123265]) &#10;THEN [no_orders] ELSE NULL END)&#10; -&#10;// past&#10;SUM(IF([_ovr_date_filter (copy)_463589320431411202]) &#10;THEN [no_orders] ELSE NULL END)&#10;)&#10;/&#10;// past&#10;SUM(IF([_ovr_date_filter (copy)_463589320431411202]) &#10;THEN [no_orders] ELSE NULL END)' />
      </column>
      <column caption='_chosen_metrics_trend_unr' datatype='boolean' name='[_chosen_metrics_trend (copy)_476044558381240321]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF([Parameters].[Parameter 2] = &apos;% Unreachable Durations&apos; &#10;OR [Parameters].[Parameter 2] = &apos;% Fail Rate Caused by Unreachable&apos;) &#10;THEN TRUE&#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='_chosen_metrics_trend_odr' datatype='boolean' name='[_chosen_metrics_trend_unr (copy)_476044558387412994]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF([Parameters].[Parameter 2] = &apos;% Unreachable Durations&apos; &#10;OR [Parameters].[Parameter 2] = &apos;% Fail Rate Caused by Unreachable&apos;&#10;OR [Parameters].[Parameter 2] = &apos;% Vendor Fail Rate&apos;) &#10;THEN FALSE&#10;ELSE TRUE&#10;END' />
      </column>
      <column caption='_date_monthly' datatype='string' default-format='*yyyy-mm' name='[_daily_date (copy) (copy)_149744718183641092]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF(MONTH([created_date])) &lt; 10&#10;THEN STR(YEAR([created_date])) + &apos;-0&apos; +STR(MONTH([created_date]))&#10;ELSE STR(YEAR([created_date])) + &apos;-&apos; +STR(MONTH([created_date]))&#10;END' />
      </column>
      <column caption='_date_weekly' datatype='string' default-format='*yyyy-ww' name='[_daily_date (copy)_149744718183628803]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF WEEK(DATETRUNC(&apos;week&apos;,[created_date], &apos;monday&apos;)) &lt; 10&#10;THEN STR(YEAR([created_date]))+&apos;-0&apos;+ STR(WEEK(DATETRUNC(&apos;week&apos;,[created_date], &apos;monday&apos;)))&#10;ELSE STR(YEAR([created_date]))+&apos;-&apos;+ STR(WEEK(DATETRUNC(&apos;week&apos;,[created_date], &apos;monday&apos;)))&#10;END' />
      </column>
      <column caption='_implementation_val_pctg_2' datatype='real' default-format='p0.0%' name='[_implementation_val_abs (copy)_147281802590986243]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Choose Metrics (copy)]&#10;      WHEN &apos;% NGT Vendors Share&apos; THEN SUM([no_daily_ngt_vendors])/SUM([no_daily_vendors])&#10;      WHEN &apos;% DMS Vendors Share&apos; THEN SUM([no_daily_dms_vendors])/SUM([no_daily_vendors])&#10;      WHEN &apos;% SOTI Vendors Share&apos; THEN SUM([no_daily_soti_vendors])/SUM([no_daily_vendors])&#10;      WHEN &apos;% Global SIM Vendors Share&apos; THEN SUM([no_daily_global_sim_vendors])/SUM([no_daily_vendors])&#10;    END' />
      </column>
      <column caption='% Device Shares for Pie Chart' datatype='real' default-format='p0.0%' name='[_implementation_val_pctg_2 (copy)_1953365994076676096]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([no_daily_devices]) / TOTAL(SUM([no_daily_devices]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='_ovr_prevdate_filter' datatype='boolean' name='[_ovr_date_filter (copy)_463589320431411202]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF(created_date &lt; &#10;CASE [Parameters].[Parameter 3]&#10;  WHEN &apos;Daily&apos; THEN DATEADD(&apos;day&apos;, -7, {FIXED : MAX([created_date])})&#10;  WHEN &apos;Weekly&apos; THEN DATEADD(&apos;day&apos;, -30, {FIXED : MAX([created_date])})&#10;  WHEN &apos;Monthly&apos; THEN DATEADD(&apos;day&apos;, -90, {FIXED : MAX([created_date])})&#10;END&#10;AND created_date &gt;= &#10;CASE [Parameters].[Parameter 3]&#10;  WHEN &apos;Daily&apos; THEN DATEADD(&apos;day&apos;, -14, {FIXED : MAX([created_date])})&#10;  WHEN &apos;Weekly&apos; THEN DATEADD(&apos;day&apos;, -60, {FIXED : MAX([created_date])})&#10;  WHEN &apos;Monthly&apos; THEN {FIXED : MIN([created_date])}&#10;END) &#10;THEN TRUE ELSE FALSE END' />
      </column>
