            <column caption='# Active Vendors' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_117867698653655045]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF([no_last28days_order] &gt; 0 ) THEN [vendor_uid] END)' />
            </column>
            <column caption='# Unreachable Vendors' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_117867698653954054]' role='measure' type='quantitative'>
