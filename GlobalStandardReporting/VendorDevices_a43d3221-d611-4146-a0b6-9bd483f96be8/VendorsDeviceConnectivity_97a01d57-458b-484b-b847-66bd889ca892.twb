          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0dc0bty1f39g1v17dwblb1ohn9tf'>
            <column caption='# All-Day Unreachable Events' datatype='integer' name='[# Long Unreachable Events (copy)_322570382987218947]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_allday_unreachable_cnt])' />
            </column>
            <column caption='# Long Unreachable Events' datatype='integer' name='[# Short Unreachable Events (copy)_322570382987059202]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_long_unreachable_cnt])' />
            </column>
            <column caption='% Proportion of More than 30 Minutes Unreachable Events' datatype='real' default-format='p0.0%' name='[% Short to Overall Unreachability Events (copy)_109423457137004551]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([# Long Unreachable Events (copy)_322570382987218947] + [# Short Unreachable Events (copy)_322570382987059202])/[Calculation_117867698653540356]' />
            </column>
            <column caption='MDM' datatype='string' name='[Calculation_109282711640743942]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [mdm_service] = &apos;(Unknown)&apos; THEN &apos;NONE&apos; ELSE [mdm_service] end' />
            </column>
            <column caption='% Proportion of Less than 30 Minute Unreachabie Events' datatype='real' default-format='p0.0%' name='[Calculation_109423457136504836]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_322570382986784769]/[Calculation_117867698653540356]' />
            </column>
            <column caption='# Long Offline Events' datatype='integer' name='[Calculation_109423457149882377]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_long_offline_cnt])' />
            </column>
            <column caption='# All-day Offline Events' datatype='integer' name='[Calculation_109423457150017546]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_allday_offline_cnt])' />
            </column>
            <column caption='# Short Offline Events' datatype='integer' name='[Calculation_109423457150287883]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_short_offline_cnt])' />
            </column>
            <column caption='% Proportion of Less than 30 Minutes Offline Events' datatype='real' default-format='p0.0%' name='[Calculation_109423457150619660]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_109423457150287883]/[Calculation_117867698655707144]' />
            </column>
            <column caption='% Proportion of More than 30 Minutes Offline Events' datatype='real' default-format='p0.0%' name='[Calculation_109423457151098893]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_109423457150017546]+[Calculation_109423457149882377])/[Calculation_117867698655707144]' />
            </column>
            <column caption='# Unreachability Events' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_117867698653540356]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_unreachable_events])' />
            </column>
            <column caption='# Offline Events' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_117867698655707144]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_offline_events])' />
            </column>
            <column caption='% Offline to Unreachable Ratio' datatype='real' default-format='p0.0%' name='[Calculation_140033851321012224]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_offline_events])/SUM([no_unreachable_events])' />
            </column>
            <column caption='# Short Unreachable Events' datatype='integer' name='[Calculation_322570382986784769]' role='measure' type='quantitative'>
