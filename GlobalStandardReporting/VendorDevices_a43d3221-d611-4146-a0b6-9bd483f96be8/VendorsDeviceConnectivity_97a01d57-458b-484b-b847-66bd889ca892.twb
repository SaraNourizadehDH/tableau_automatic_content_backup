            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0dc0bty1f39g1v17dwblb1ohn9tf'>
            <column caption='# More than 30 Minutes Offline Vendors' datatype='integer' default-format='n#,##0;-#,##0' name='[# 100% Offline Vendors (copy)_109423457166012433]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF [no_long_offline_cnt] &gt;= 1&#10;    THEN [vendor_uid] ELSE NULL END)' />
            </column>
            <column caption='# More than 30 Minutes Unreachable Vendors' datatype='integer' default-format='n#,##0;-#,##0' name='[# 100% Unreachable Vendors (copy)_109423457166569490]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF [no_long_unreachable_cnt] &gt;= 1 &#10;    THEN [vendor_uid] ELSE NULL END)' />
            </column>
            <column caption='# All-Day Unreachable Events' datatype='integer' name='[# Long Unreachable Events (copy)_322570382987218947]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_allday_unreachable_cnt])' />
            </column>
            <column caption='% more than  30 min. Unreachable to All Active Vendors' datatype='real' default-format='p0.0%' name='[% 30 Min. and more Offine to All Active Vendors (copy)_181621789022056449]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([# Long Unreachable Events (copy)_322570382987218947] +[# 100% Unreachable Vendors (copy)_109423457166569490])  /[Calculation_117867698653655045]' />
            </column>
            <column caption='% more than 30 min. to All Unreachable Vendors' datatype='real' default-format='p0.0%' name='[% 30 Min. and more Unreachable to All Active Vendors (copy) (copy)_181621789022515202]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([# Long Unreachable Events (copy)_322570382987218947] + [# 100% Unreachable Vendors (copy)_109423457166569490])  / [Calculation_117867698653954054]' />
            </column>
            <column caption='% more than 30 min. Offline to All Offline Vendors' datatype='real' default-format='p0.0%' name='[% 30 Min. and more to All Unreachable Vendors (copy)_181621789023109123]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_109423457150017546] + [# 100% Offline Vendors (copy)_109423457166012433]) / [Calculation_117867698656305161]' />
            </column>
            <column caption='% more than 30 min. Offline to All Active Vendors' datatype='real' default-format='p0.0%' name='[% Offine to All Active Vendors (copy)_181621789021679616]' role='measure' type='quantitative'>
