          <datasource-dependencies datasource='federated.0dc0bty1f39g1v17dwblb1ohn9tf'>
            <column caption='# All-Day Unreachable Events' datatype='integer' name='[# Long Unreachable Events (copy)_322570382987218947]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_allday_unreachable_cnt])' />
            </column>
            <column caption='# Long Unreachable Events' datatype='integer' name='[# Short Unreachable Events (copy)_322570382987059202]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_long_unreachable_cnt])' />
            </column>
            <column caption='% Proportion of More than 30 Minutes Unreachable Events' datatype='real' default-format='p0.0%' name='[% Short to Overall Unreachability Events (copy)_109423457137004551]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([# Long Unreachable Events (copy)_322570382987218947] + [# Short Unreachable Events (copy)_322570382987059202])/[Calculation_117867698653540356]' />
            </column>
            <column caption='MDM' datatype='string' name='[Calculation_109282711640743942]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [mdm_service] = &apos;(Unknown)&apos; THEN &apos;NONE&apos; ELSE [mdm_service] end' />
            </column>
            <column caption='% Proportion of Less than 30 Minute Unreachabie Events' datatype='real' default-format='p0.0%' name='[Calculation_109423457136504836]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_322570382986784769]/[Calculation_117867698653540356]' />
            </column>
            <column caption='# Long Offline Events' datatype='integer' name='[Calculation_109423457149882377]' role='measure' type='quantitative'>
