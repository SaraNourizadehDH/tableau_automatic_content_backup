              <calculation class='tableau' formula='IF [mdm_service] = &apos;(Unknown)&apos; THEN &apos;NONE&apos; ELSE [mdm_service] end' />
            </column>
            <column caption='# All-day Offline Events' datatype='integer' name='[Calculation_109423457150017546]' role='measure' type='quantitative'>
