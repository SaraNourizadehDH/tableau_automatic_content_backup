    <worksheet name='connectivity_duration_w'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='9'>% Unreachable and % Offline Duration</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='rps_gsr_device_connectivity_general (rl)' name='federated.0dc0bty1f39g1v17dwblb1ohn9tf' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0dc0bty1f39g1v17dwblb1ohn9tf'>
            <column caption='% Offline Duration' datatype='real' default-format='p0.0%' name='[% Unreachable Duration (copy)_202591664546398210]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF([offline_duration_seconds] &gt; [schedule_duration_seconds]) THEN [schedule_duration_seconds] ELSE  [offline_duration_seconds] END)&#10;/SUM([schedule_duration_seconds])' />
            </column>
            <column caption='MDM' datatype='string' name='[Calculation_109282711640743942]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [mdm_service] = &apos;(Unknown)&apos; THEN &apos;NONE&apos; ELSE [mdm_service] end' />
            </column>
            <column caption='Schedule Durations (hours)' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_117867698654674951]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([schedule_duration_seconds]/3600)' />
            </column>
            <column caption='Avg. Schedule Duration (hours) per Active Vendors' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_140033851360841732]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_117867698654674951]&#10;/COUNTD([vendor_uid])' />
            </column>
            <column caption='_date week' datatype='datetime' default-format='*yyyy-ww' name='[Calculation_427560554575917058]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='IF([Parameters].[Parameter 1] = &apos;Weekly&apos;) &#10;THEN DATETRUNC(&apos;week&apos;,[date],&apos;monday&apos;)&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='% Unreachable Duration' datatype='real' default-format='p0.0%' name='[Calculation_88242455306207237]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF([unreachable_duration_seconds] &gt; [schedule_duration_seconds]) THEN [schedule_duration_seconds] ELSE [unreachable_duration_seconds] END)&#10;/SUM([schedule_duration_seconds])' />
            </column>
            <column datatype='string' name='[Manufacturer (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[manufacturer]' new-bin='true'>
                <bin default-name='false' value='&quot;(Unknown)&quot;'>
                  <value>&quot;&quot;</value>
