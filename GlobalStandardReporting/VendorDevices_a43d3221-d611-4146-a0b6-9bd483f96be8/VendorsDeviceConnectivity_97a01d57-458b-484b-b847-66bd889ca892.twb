          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose Metrics to Show' datatype='string' name='[Choose Date Granularity 1 (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% Unreachable Duration&quot;'>
              <calculation class='tableau' formula='&quot;% Unreachable Duration&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0dc0bty1f39g1v17dwblb1ohn9tf'>
            <column caption='% Offline Duration' datatype='real' default-format='p0.0%' name='[% Unreachable Duration (copy)_202591664546398210]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF([offline_duration_seconds] &gt; [schedule_duration_seconds]) THEN [schedule_duration_seconds] ELSE  [offline_duration_seconds] END)&#10;/SUM([schedule_duration_seconds])' />
            </column>
            <column caption='MDM' datatype='string' name='[Calculation_109282711640743942]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [mdm_service] = &apos;(Unknown)&apos; THEN &apos;NONE&apos; ELSE [mdm_service] end' />
            </column>
            <column caption='Avg. Unreachable Duration (hours) per Events' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_117867698653024258]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_148548476868792325]&#10;/SUM([no_unreachable_events])' />
            </column>
            <column caption='# Active Vendors' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_117867698653655045]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF([no_last28days_order] &gt; 0 ) THEN [vendor_uid] END)' />
