    <worksheet name='connectivity_vendors_m'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='9'># Unreachable and # Offline Vendors</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='rps_gsr_device_connectivity_general (rl)' name='federated.0dc0bty1f39g1v17dwblb1ohn9tf' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0dc0bty1f39g1v17dwblb1ohn9tf'>
            <column caption='# More than 30 Minutes Offline Vendors' datatype='integer' default-format='n#,##0;-#,##0' name='[# 100% Offline Vendors (copy)_109423457166012433]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF [no_long_offline_cnt] &gt;= 1&#10;    THEN [vendor_uid] ELSE NULL END)' />
            </column>
            <column caption='# More than 30 Minutes Unreachable Vendors' datatype='integer' default-format='n#,##0;-#,##0' name='[# 100% Unreachable Vendors (copy)_109423457166569490]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF [no_long_unreachable_cnt] &gt;= 1 &#10;    THEN [vendor_uid] ELSE NULL END)' />
            </column>
            <column caption='MDM' datatype='string' name='[Calculation_109282711640743942]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [mdm_service] = &apos;(Unknown)&apos; THEN &apos;NONE&apos; ELSE [mdm_service] end' />
            </column>
            <column caption='# Active Vendors' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_117867698653655045]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF([no_last28days_order] &gt; 0 ) THEN [vendor_uid] END)' />
            </column>
            <column caption='# Unreachable Vendors' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_117867698653954054]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF [no_unreachable_events] &gt;= 1 &#10;    THEN [vendor_uid] ELSE NULL END)' />
            </column>
            <column caption='# Offline Vendors' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_117867698656305161]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF [no_offline_events] &gt;= 1 AND [is_monitor_enabled]&#10;    THEN [vendor_uid] ELSE NULL END)' />
            </column>
            <column caption='_date month' datatype='datetime' default-format='*yyyy-mm' name='[Calculation_427560554573520896]' role='dimension' type='quantitative'>
