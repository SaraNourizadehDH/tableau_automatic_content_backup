            <column caption='Failed Order Customer' datatype='integer' name='[failed_order_customer]' role='measure' type='quantitative' />
            <column caption='Failed Order Fulfilment' datatype='integer' name='[failed_order_fulfilment]' role='measure' type='quantitative' />
