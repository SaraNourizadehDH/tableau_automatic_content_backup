        <calculation class='tableau' formula='IF [Parameters].[Select KPI Metric (copy)_6848567715375222784] = &apos;Physical Vendors&apos; THEN &apos;# Platform Vendors&apos;&#10;ELSEIF [Parameters].[Select KPI Metric (copy)_6848567715375222784] = &apos;Platform Vendors&apos; THEN &apos;# Physical Vendors&apos;&#10;ELSEIF [Parameters].[Select KPI Metric (copy)_6848567715375222784] = &apos;Orders&apos; THEN &apos;# Platform Vendors&apos;&#10;ELSEIF [Parameters].[Select KPI Metric (copy)_6848567715375222784] = &apos;Accepted Orders&apos; THEN &apos;# Platform Vendors&apos;&#10;END' />
