            <column caption='Diff First Order to Equalisation' datatype='integer' name='[Calculation_277534387970027520]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='ABS([first_order_date_to_pos]) - [equalisation_period]' />
            </column>
            <column caption='20-30 Days Diff Equalisation to  First Order' datatype='integer' name='[Calculation_277534387971121153]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_277534387970027520] &gt;= 20 AND  [Calculation_277534387970027520] &lt;= 30 &#10;THEN 1 &#10;ELSE 0 &#10;END' />
            </column>
            <column caption='Info Pannel Placeholder' datatype='string' name='[Info Pannel Placeholder (copy)_6088233437364850688]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos; &apos;' />
            </column>
            <column caption='Equalisation Period (Day)' datatype='integer' name='[equalisation_period]' role='measure' type='quantitative' />
            <column caption='FIrst Order To Pos' datatype='integer' name='[first_order_date_to_pos]' role='measure' type='quantitative' />
            <column-instance column='[Info Pannel Placeholder (copy)_6088233437364850688]' derivation='None' name='[none:Info Pannel Placeholder (copy)_6088233437364850688:nk]' pivot='key' type='nominal' />
            <column-instance column='[physical_vendor]' derivation='None' name='[none:physical_vendor:nk]' pivot='key' type='nominal' />
            <column-instance column='[pos_integration_type_original]' derivation='None' name='[none:pos_integration_type_original:nk]' pivot='key' type='nominal' />
            <column caption='Physical Vendor' datatype='string' name='[physical_vendor]' role='dimension' type='nominal' />
            <column caption='Pos Integration Type Original' datatype='string' name='[pos_integration_type_original]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1uqcwtt0t2d99u1axru2f0ikops0].[none:physical_vendor:nk]' filter-group='20'>
            <groupfilter count='1' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
              <groupfilter direction='DESC' expression='MAX([Calculation_277534387971121153])' function='order' user:ui-marker='order'>
                <groupfilter function='level-members' level='[none:physical_vendor:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
              </groupfilter>
            </groupfilter>
          </filter>
          <slices>
            <column>[federated.1uqcwtt0t2d99u1axru2f0ikops0].[none:physical_vendor:nk]</column>
            <column>[federated.1uqcwtt0t2d99u1axru2f0ikops0].[none:pos_integration_type_original:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='header'>
            <format attr='band-color' scope='rows' value='#00000000' />
          </style-rule>
          <style-rule element='pane'>
            <format attr='band-color' scope='rows' value='#00000000' />
          </style-rule>
          <style-rule element='table'>
            <format attr='background-color' value='#00000000' />
            <format attr='band-size' scope='rows' value='1' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Shape' />
            <encodings>
              <lod column='[federated.1uqcwtt0t2d99u1axru2f0ikops0].[none:Info Pannel Placeholder (copy)_6088233437364850688:nk]' />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run fontsize='11'>To compare the Metrics before and after POS, we need to have a similar number of vendors that influence the metric on both sides of the POS period start (T-0). To achieve this, we equalize the order periods B&amp;A POS for every vendor. </run>
                <run>Æ&#10;&#10;</run>
                <run fontsize='11'>For example: </run>
                <run>Æ&#10;&#10;</run>
                <run fontsize='11'><![CDATA[<Sheet name="[POS B&A] Equalisation Explained" maxwidth="500" maxheight="500" filter="[Physical Vendor]">]]></run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#b4b4b4' italic='true'>**  Loading time ~10 seconds.</run>
                <run>Æ&#10;&#10;</run>
                <run fontsize='11'>So we will take the Equalisation days of orders before and after POS. </run>
                <run>Æ&#10;</run>
                <run fontsize='11'>E.g. if we have Equalisation period = 61 days, we take 61 days of orders before and after POS.</run>
              </formatted-text>
            </customized-tooltip>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-cull' value='true' />
                <format attr='mark-labels-show' value='false' />
                <format attr='shape' value='My Shapes/icons-information.png' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
      <simple-id uuid='{F9DA572A-E5CA-4BAA-AA41-4A4F2FECA0F4}' />
    </worksheet>
