            <column caption='KPI Metric (A)' datatype='real' default-format='p0.00%' name='[KPI Metric (copy)_5621899766604935179]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Select KPI Metric (copy)_5621899766599585802]&#10;  WHEN &apos;Orders&apos; &#10;    THEN SUM([orders]) &#10;  WHEN &apos;Physical Vendors&apos; &#10;    THEN [Calculation_3998352103356067843]&#10;  WHEN &apos;Platform Vendors&apos;&#10;    THEN [Calculation_3998352103356493828]&#10;  WHEN &apos;Accepted Orders&apos; &#10;    THEN SUM([accepted_orders]) &#10;  WHEN &apos;Failed Orders&apos; &#10;    THEN SUM([failed_orders])&#10;  WHEN &apos;Completed Orders&apos; &#10;    THEN SUM([completed_orders])&#10;  WHEN &apos;Response time&apos; &#10;    THEN AVG([avg_response_time])&#10;  WHEN &apos;% Fail Rate&apos; &#10;    THEN [Calculation_4874372596807196676]&#10;  WHEN &apos;% Platform Fail Rate&apos; &#10;    THEN [% Vendor Fail Rate (copy) (copy 2) (copy 2)_4874372596807876618]&#10;  WHEN &apos;% Customer Fail Rate&apos; &#10;    THEN [% Vendor Fail Rate (copy)_4874372596807835654]&#10;  WHEN &apos;% Fulfilment Fail Rate&apos; &#10;    THEN [% Vendor Fail Rate (copy) (copy 2)_4874372596807856136]&#10;  WHEN &apos;% Vendor Fail Rate&apos; &#10;    THEN [Calculation_4874372596807598085]&#10;  WHEN &apos;% Transport Fail Rate&apos; &#10;    THEN [% Vendor Fail Rate (copy) (copy 2) (copy)_4874372596807868425]&#10;  WHEN &apos;  % UNREACHABLE Fail Rate&apos; &#10;    THEN [% Vendor Fail Rate (copy) (copy)_4874372596807843847]&#10;  WHEN &apos;  % TOO BUSY Fail Rate&apos; &#10;    THEN [% Unreachable Fail Rate (copy) (copy)_4874372596809089037]&#10;  WHEN &apos;  % ITEM UNAVAILABLE Fail Rate&apos; &#10;    THEN [% Unreachable Fail Rate (copy)_4874372596809076748]&#10;  WHEN &apos;  % NO RESPONSE Fail Rate&apos; &#10;    THEN [% Unreachable Fail Rate (copy) (copy) (copy)_4874372596809097230]&#10;  WHEN &apos;  % CLOSED Fail Rate&apos; &#10;    THEN [% Unreachable Fail Rate (copy)_4874372596808531979]&#10;  WHEN &apos;Vendor Fail Reasons&apos;&#10;    THEN [Calculation_4874372596807598085]&#10;  WHEN  &apos;% Orders RT &lt;= 10s&apos;&#10;    THEN [Calculation_279856552792715264]&#10;  WHEN  &apos;% Orders RT &lt;= 20s&apos;&#10;    THEN [% Orders Response time &lt;10s (copy)_279856552792989697]&#10;  WHEN  &apos;% Orders RT &lt;= 30s&apos;&#10;    THEN [% Orders Response time &lt;10s (copy) (copy)_279856552793001986]&#10;  WHEN  &apos;% Orders RT &lt;= 60s&apos;&#10;    THEN [% Orders Response time 10 - 20s (copy)_279856552793591814]&#10;  WHEN  &apos;% Orders RT &gt; 60s&apos;&#10;    THEN [% Orders Response time under 10s (copy)_279856552793726983]&#10;END' />
            </column>
