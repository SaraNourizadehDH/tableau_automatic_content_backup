      <aliases enabled='yes' />
      <column caption='% Orders RT &lt;= 60s' datatype='real' default-format='p0%' name='[% Orders Response time 10 - 20s (copy)_279856552793591814]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_response_time_up_to_60s])/ SUM([accepted_orders])' />
      </column>
      <column caption='% Orders RT &lt;= 30s' datatype='real' default-format='p0%' name='[% Orders Response time &lt;10s (copy) (copy)_279856552793001986]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_response_time_up_to_30s])/ SUM([accepted_orders])' />
      </column>
      <column caption='% Orders RT &lt;= 20s' datatype='real' default-format='p0%' name='[% Orders Response time &lt;10s (copy)_279856552792989697]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_response_time_up_to_20s])/ SUM([accepted_orders])' />
      </column>
      <column caption='% Orders RT &gt; 60s' datatype='real' default-format='p0%' name='[% Orders Response time under 10s (copy)_279856552793726983]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_response_time_above_60s])/ SUM([accepted_orders])' />
      </column>
      <column caption='% No Response Fail Rate' datatype='real' default-format='p0.00%' name='[% Unreachable Fail Rate (copy) (copy) (copy)_4874372596809097230]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([failed_orders_no_response]) / SUM([orders])' />
      </column>
      <column caption='% Too Busy Fail Rate' datatype='real' default-format='p0.00%' name='[% Unreachable Fail Rate (copy) (copy)_4874372596809089037]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([failed_orders_too_busy]) / SUM([orders])' />
      </column>
      <column caption='% Closed Fail Rate' datatype='real' default-format='p0.00%' name='[% Unreachable Fail Rate (copy)_4874372596808531979]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([failed_orders_closed]) / SUM([orders])' />
      </column>
      <column caption='% Item Unavailable Fail Rate ' datatype='real' default-format='p0.00%' name='[% Unreachable Fail Rate (copy)_4874372596809076748]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([failed_orders_item_unavailable]) / SUM([orders])' />
      </column>
      <column caption='% Platform Fail Rate' datatype='real' default-format='p0.00%' name='[% Vendor Fail Rate (copy) (copy 2) (copy 2)_4874372596807876618]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([failed_order_platform]) / SUM([orders])' />
      </column>
      <column caption='% Transport Fail Rate' datatype='real' default-format='p0.00%' name='[% Vendor Fail Rate (copy) (copy 2) (copy)_4874372596807868425]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([failed_order_transport]) / SUM([orders])' />
      </column>
      <column caption='% Fulfilment Fail Rate' datatype='real' default-format='p0.00%' name='[% Vendor Fail Rate (copy) (copy 2)_4874372596807856136]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([failed_order_fulfilment]) / SUM([orders])' />
      </column>
      <column caption='% Unreachable Fail Rate' datatype='real' default-format='p0.00%' name='[% Vendor Fail Rate (copy) (copy)_4874372596807843847]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([failed_orders_unreachable]) / SUM([orders])' />
      </column>
      <column caption='% Customer Fail Rate' datatype='real' default-format='p0.00%' name='[% Vendor Fail Rate (copy)_4874372596807835654]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([failed_order_customer]) / SUM([orders])' />
      </column>
      <column caption='_View_' datatype='string' name='[Calculation_217580214179545088]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Select KPI Metric (copy)_5621899766599585802]' />
      </column>
      <column caption='Diff First Order to Equalisation' datatype='integer' name='[Calculation_277534387970027520]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='ABS([first_order_date_to_pos]) - [equalisation_period]' />
      </column>
      <column caption='20-30 Days Diff Equalisation to  First Order' datatype='integer' name='[Calculation_277534387971121153]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_277534387970027520] &gt;= 20 AND  [Calculation_277534387970027520] &lt;= 30 &#10;THEN 1 &#10;ELSE 0 &#10;END' />
      </column>
      <column caption='% Orders RT &lt;= 10s' datatype='real' default-format='p0%' name='[Calculation_279856552792715264]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_response_time_up_to_10s])/ SUM([accepted_orders])' />
      </column>
      <column caption='Physical Vendors + Pos Period Start' datatype='string' name='[Calculation_3998352103355068417]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[physical_vendor] + STR([pos_period_start_date])' />
      </column>
      <column caption='# Physical Vendors' datatype='integer' name='[Calculation_3998352103356067843]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_3998352103355068417])' />
      </column>
      <column caption='# Platform Vendors' datatype='integer' name='[Calculation_3998352103356493828]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Physical Vendors + Pos Period Start (copy)_3998352103355875330])' />
      </column>
      <column caption='t-dimension' datatype='string' name='[Calculation_4874372596797050882]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Choose Date Granularity (copy)_4874372596788895744]&#10;    WHEN &apos;day&apos;&#10;        THEN &apos;T &apos; + STR([order_to_pos_start_days])&#10;    WHEN &apos;week&apos;&#10;        THEN &apos;T &apos; + STR([order_to_pos_start_weeks])&#10;    WHEN &apos;month&apos;&#10;        THEN &apos;T &apos; + STR([order_to_pos_start_months])&#10;END' />
      </column>
      <column caption='[Colors] Before &amp; After POS ' datatype='string' name='[Calculation_4874372596805128195]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE CONTAINS( [Calculation_4874372596797050882], &apos;-&apos; )&#10;    WHEN TRUE   THEN &apos;Before POS&apos;&#10;    WHEN FALSE  THEN &apos;After POS&apos;&#10;END' />
      </column>
      <column caption='% Fail Rate' datatype='real' datatype-customized='true' default-format='*#,##0;0.0%' name='[Calculation_4874372596807196676]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([failed_orders]) / SUM([orders])' />
      </column>
      <column caption='% Vendor Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_4874372596807598085]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([failed_order_vendor]) / SUM([orders])' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_5003851093791236097]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]= USERNAME()' />
      </column>
      <column caption='Equalisation Period Explanation' datatype='string' name='[Calculation_5298133177437536258]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;We take &apos; + STR([equalisation_period]) + &apos; days of orders before POS and &apos; &#10;&#10;+ STR([equalisation_period])+ &apos; after&apos;' />
      </column>
      <column caption='Cohort Date' datatype='date' datatype-customized='true' name='[Calculation_5621899766597275657]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Order Date Granularity (copy)], [pos_period_start]))' />
      </column>
      <column caption='[Data Source Filter] Cohorts Last 12 months' datatype='boolean' name='[Calculation_6810638966112755712]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [pos_period_start_date] &gt;= [Calculation_6810638966113234946] &#10;THEN TRUE &#10;ELSE FALSE &#10;END' />
      </column>
      <column caption='12 month ago' datatype='datetime' name='[Calculation_6810638966113234946]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEADD(&apos;month&apos;, -12, TODAY())' />
      </column>
      <column caption='[Info Tooltip] Physical Vendor Identification' datatype='string' name='[Calculation_6810638966119227395]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_6810638966123827206] = [Calculation_6810638966119534596]&#10;THEN [physical_vendor]&#10;ELSE Null &#10;END' />
      </column>
      <column caption='[Info Tooltip] [LOD] Physical Vendor # Integrations' datatype='integer' name='[Calculation_6810638966119534596]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [physical_vendor]: COUNTD(STR([pos_chain_id])+STR([pos_integration_id]))}' />
      </column>
      <column caption='[Info Tooltip] [LOD] Max # Integrations ' datatype='integer' name='[Calculation_6810638966123827206]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : MAX([Calculation_6810638966119534596])}' />
      </column>
      <column caption='KPI Metric (B)' datatype='integer' name='[Calculation_6848567715375681537]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Select KPI Metric (copy)_6848567715375222784]&#10;  WHEN &apos;Orders&apos; &#10;    THEN SUM([orders])&#10;  WHEN &apos;Accepted Orders&apos;&#10;    THEN SUM([accepted_orders])&#10;//  WHEN &apos;Completed Orders&apos;&#10;//    THEN SUM([completed_orders])&#10;//  WHEN &apos;Failed Orders&apos;&#10;//    THEN SUM([Failed Orders])&#10;  WHEN &apos;Physical Vendors&apos;&#10;    THEN [Calculation_3998352103356067843]&#10;  WHEN &apos;Platform Vendors&apos;&#10;    THEN [Calculation_3998352103356493828]&#10;END' />
      </column>
      <column caption='First Cohort Date' datatype='date' datatype-customized='true' name='[Cohort Date (copy)_3998352103402594309]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Order Date Granularity (copy)], [first_cohort]))' />
      </column>
      <column caption='Info Pannel Placeholder' datatype='string' name='[Info Pannel Placeholder (copy)_6088233437364850688]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos; &apos;' />
      </column>
      <column caption='KPI Metric (A)' datatype='real' default-format='p0.00%' name='[KPI Metric (copy)_5621899766604935179]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Select KPI Metric (copy)_5621899766599585802]&#10;  WHEN &apos;Orders&apos; &#10;    THEN SUM([orders]) &#10;  WHEN &apos;Physical Vendors&apos; &#10;    THEN [Calculation_3998352103356067843]&#10;  WHEN &apos;Platform Vendors&apos;&#10;    THEN [Calculation_3998352103356493828]&#10;  WHEN &apos;Accepted Orders&apos; &#10;    THEN SUM([accepted_orders]) &#10;  WHEN &apos;Failed Orders&apos; &#10;    THEN SUM([failed_orders])&#10;  WHEN &apos;Completed Orders&apos; &#10;    THEN SUM([completed_orders])&#10;  WHEN &apos;Response time&apos; &#10;    THEN AVG([avg_response_time])&#10;  WHEN &apos;% Fail Rate&apos; &#10;    THEN [Calculation_4874372596807196676]&#10;  WHEN &apos;% Platform Fail Rate&apos; &#10;    THEN [% Vendor Fail Rate (copy) (copy 2) (copy 2)_4874372596807876618]&#10;  WHEN &apos;% Customer Fail Rate&apos; &#10;    THEN [% Vendor Fail Rate (copy)_4874372596807835654]&#10;  WHEN &apos;% Fulfilment Fail Rate&apos; &#10;    THEN [% Vendor Fail Rate (copy) (copy 2)_4874372596807856136]&#10;  WHEN &apos;% Vendor Fail Rate&apos; &#10;    THEN [Calculation_4874372596807598085]&#10;  WHEN &apos;% Transport Fail Rate&apos; &#10;    THEN [% Vendor Fail Rate (copy) (copy 2) (copy)_4874372596807868425]&#10;  WHEN &apos;  % UNREACHABLE Fail Rate&apos; &#10;    THEN [% Vendor Fail Rate (copy) (copy)_4874372596807843847]&#10;  WHEN &apos;  % TOO BUSY Fail Rate&apos; &#10;    THEN [% Unreachable Fail Rate (copy) (copy)_4874372596809089037]&#10;  WHEN &apos;  % ITEM UNAVAILABLE Fail Rate&apos; &#10;    THEN [% Unreachable Fail Rate (copy)_4874372596809076748]&#10;  WHEN &apos;  % NO RESPONSE Fail Rate&apos; &#10;    THEN [% Unreachable Fail Rate (copy) (copy) (copy)_4874372596809097230]&#10;  WHEN &apos;  % CLOSED Fail Rate&apos; &#10;    THEN [% Unreachable Fail Rate (copy)_4874372596808531979]&#10;  WHEN &apos;Vendor Fail Reasons&apos;&#10;    THEN [Calculation_4874372596807598085]&#10;  WHEN  &apos;% Orders RT &lt;= 10s&apos;&#10;    THEN [Calculation_279856552792715264]&#10;  WHEN  &apos;% Orders RT &lt;= 20s&apos;&#10;    THEN [% Orders Response time &lt;10s (copy)_279856552792989697]&#10;  WHEN  &apos;% Orders RT &lt;= 30s&apos;&#10;    THEN [% Orders Response time &lt;10s (copy) (copy)_279856552793001986]&#10;  WHEN  &apos;% Orders RT &lt;= 60s&apos;&#10;    THEN [% Orders Response time 10 - 20s (copy)_279856552793591814]&#10;  WHEN  &apos;% Orders RT &gt; 60s&apos;&#10;    THEN [% Orders Response time under 10s (copy)_279856552793726983]&#10;END' />
      </column>
      <column caption='Platform Vendors + Physical Vendors + Pos Period Start' datatype='string' name='[Physical Vendors + Pos Period Start (copy)_3998352103355875330]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[platform_vendor] + [Calculation_3998352103355068417]' />
