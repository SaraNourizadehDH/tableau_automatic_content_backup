              <calculation class='tableau' formula='IF [Parameters].[Select KPI Metric (copy)_6848567715375222784] = &apos;Physical Vendors&apos; THEN SUM([accepted_orders])&#10;ELSEIF [Parameters].[Select KPI Metric (copy)_6848567715375222784] = &apos;Platform Vendors&apos; THEN SUM([accepted_orders])&#10;ELSEIF [Parameters].[Select KPI Metric (copy)_6848567715375222784] = &apos;Orders&apos; THEN SUM([accepted_orders])&#10;ELSEIF [Parameters].[Select KPI Metric (copy)_6848567715375222784] = &apos;Accepted Orders&apos; THEN SUM([orders])&#10;END' />
