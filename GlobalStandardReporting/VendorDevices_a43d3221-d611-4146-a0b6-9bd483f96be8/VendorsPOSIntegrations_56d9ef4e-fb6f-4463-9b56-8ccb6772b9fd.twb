      <aliases enabled='yes' />
      <column caption='# Distinct POS Chain' datatype='integer' name='[# Distinct POS Integration (copy)_2242581520670531584]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([pos_chain_name])' />
      </column>
      <column caption='# Total POS Orders' datatype='real' name='[# Total Orders (copy)_1453184941404979202]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG({EXCLUDE [Calculation_517843633631232002]:SUM([no_orders_pos])})' />
      </column>
      <column caption='# POS Vendors' datatype='integer' name='[# Vendors (copy)_1651765538468229121]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IIF(NOT ISNULL([pos_integration_name]), [unique_vendor_code], NULL))' />
      </column>
      <column caption='% POS Order Share' datatype='real' default-format='p0.00%' name='[% Order share (copy)_1453184941404839936]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[# Total Orders (copy)_1453184941404979202]/ ATTR([_total_orders (copy)_1453184941404979201])' />
      </column>
      <column caption='%  Vendor Fail Rate' datatype='real' default-format='p0.00%' name='[% POS Fail Rate (copy 2)_1651765538480316418]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([no_fail_orders_vendor_pos])/SUM([no_orders_pos])' />
      </column>
      <column caption='% Fail Rate - CLOSED' datatype='real' default-format='p0.00%' name='[% VD Fail Rate - UNREACHABLE (copy) (copy) (copy) (copy)_6587710776611438596]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([no_fail_orders_vendor_closed])/SUM([no_orders])' />
      </column>
      <column caption='Dimension (A)' datatype='string' name='[Calculation_1606096264971079681]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Region&apos; THEN [region]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Brand Name&apos; THEN [brand_name]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Country&apos; THEN [country_name]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Delivery Type&apos; THEN [delivery_type]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;App Client&apos; THEN [application_client_name]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Vertical Type&apos; THEN [vertical_type]&#10;END' />
      </column>
      <column caption='_Exclude Today' datatype='boolean' name='[Calculation_1827687403375435776]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[order_date] &lt; TODAY()' />
      </column>
      <column caption='# Vendors' datatype='integer' name='[Calculation_2036260364137832448]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([unique_vendor_code])' />
      </column>
      <column caption='# Distinct POS Integration' datatype='integer' name='[Calculation_2549530025661030400]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([pos_integration_name])' />
      </column>
      <column caption='_POS Displayed Time Series' datatype='string' name='[Calculation_2549530025679474690]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 2]' />
      </column>
      <column caption='% Orders' datatype='real' name='[Calculation_2646216634936246272]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[no_orders]/{ FIXED [Dimension (A) (copy)_1383801359639625730], [Calculation_517843633631232002]: SUM([no_orders])}' />
      </column>
      <column caption='_total_orders' datatype='integer' name='[Calculation_3333508160234987545]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='{EXCLUDE [Calculation_517843633631232002]&#10;    , [region]&#10;    , [brand_name]&#10;    , [country_name]&#10;    , [pos_integration_name]&#10;    , [Calculation_1606096264971079681]&#10;    , [Dimension (A) (copy)_1606096264971841538]&#10;: SUM([no_orders])&#10;}' />
      </column>
      <column caption='% POS Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_4008555566080409606]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([no_fail_orders_pos])/SUM([no_orders_pos])' />
      </column>
      <column caption='Order Date (day and month)' datatype='date' datatype-customized='true' name='[Calculation_4008555566098100234]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[order_date]' />
      </column>
      <column caption='Manufacturer Cleaned' datatype='string' name='[Calculation_406309176525737984]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Set 1]) OR NOT [Set 1]&#10;OR ISNULL([manufacturer]) THEN &apos;(Others)&apos;&#10;ELSE (&#10;    IF LEFT([manufacturer], 7)  =  &apos;SAMSUNG&apos; THEN &apos;SAMSUNG&apos;&#10;    ELSE TRIM([manufacturer])&#10;    END&#10;) END' />
      </column>
      <column caption='% Vendor Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_4090042567939112963]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([no_fail_orders_vendor])/SUM([no_orders])' />
      </column>
      <column caption='POS Metric' datatype='real' name='[Calculation_4369195361261191168]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;# Orders&apos;&#10;    THEN SUM([no_orders_pos])&#10;ELSEIF [Parameters].[Parameter 5] = &apos;% Orders&apos;&#10;    THEN SUM([Calculation_2646216634936246272])&#10;ELSEIF [Parameters].[Parameter 5] = &apos;# Failed Orders&apos;&#10;    THEN SUM([no_fail_orders_pos])&#10;ELSEIF [Parameters].[Parameter 5] = &apos;GMV (EUR)&apos;&#10;    THEN SUM([gmv_eur])&#10;ELSEIF [Parameters].[Parameter 5] = &apos;% Fail Rate&apos;&#10;    THEN [Calculation_4008555566080409606]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;% Vendor Fail Rate&apos;&#10;    THEN [% POS Fail Rate (copy 2)_1651765538480316418]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;# Distinct Vendors&apos;&#10;    THEN [# Vendors (copy)_1651765538468229121]&#10;END' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_5003851093791129600]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='% Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_517843633630994432]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([no_fail_orders])/SUM([no_orders])' />
      </column>
      <column caption='Date Granularity' datatype='string' name='[Calculation_517843633631232002]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&apos;Daily&apos; THEN STR([Calculation_4008555566098100234])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Weekly&apos; THEN [order_week]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Monthly&apos; THEN [order_month]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Quarterly&apos; THEN STR(DATE(DATETRUNC(&apos;quarter&apos;,[order_date])))&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Yearly&apos; THEN STR([order_year])&#10;END' />
      </column>
      <column caption='Cancellation Dimension (A)' datatype='string' name='[Calculation_639440833043079169]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Owner&apos; THEN [cancellation_owner]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Reason&apos; THEN [cancellation_reason]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Source&apos; THEN [cancellation_source]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Stage&apos; THEN [cancellation_stage]&#10;END' />
