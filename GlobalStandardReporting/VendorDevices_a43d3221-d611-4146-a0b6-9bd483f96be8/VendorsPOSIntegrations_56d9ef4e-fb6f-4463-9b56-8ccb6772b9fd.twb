            <column aggregation='Sum' caption='Pos Id' datatype='integer' name='[pos_integration_id]' role='dimension' type='ordinal' />
            <column caption='Pos Integration Type Original' datatype='string' name='[pos_integration_type_original]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1uqcwtt0t2d99u1axru2f0ikops0].[none:Calculation_6810638966119227395:nk]' filter-group='10'>
            <groupfilter count='2' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
              <groupfilter direction='DESC' expression='SUM([pos_integration_id])' function='order' user:ui-marker='order'>
                <groupfilter function='level-members' level='[none:Calculation_6810638966119227395:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
              </groupfilter>
            </groupfilter>
          </filter>
          <filter class='categorical' column='[federated.1uqcwtt0t2d99u1axru2f0ikops0].[none:[Info Tooltip]] Physical Vendor Identification (copy)_6810638966135787531:nk]' filter-group='21'>
            <groupfilter count='2' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
              <groupfilter direction='DESC' expression='MAX([Calculation_6810638966119534596])' function='order' user:ui-marker='order'>
                <groupfilter function='except' user:ui-domain='relevant' user:ui-enumeration='exclusive' user:ui-marker='enumerate'>
                  <groupfilter function='level-members' level='[none:[Info Tooltip]] Physical Vendor Identification (copy)_6810638966135787531:nk]' />
                  <groupfilter function='member' level='[none:[Info Tooltip]] Physical Vendor Identification (copy)_6810638966135787531:nk]' member='%null%' />
                </groupfilter>
              </groupfilter>
            </groupfilter>
          </filter>
          <slices>
            <column>[federated.1uqcwtt0t2d99u1axru2f0ikops0].[none:Calculation_6810638966119227395:nk]</column>
            <column>[federated.1uqcwtt0t2d99u1axru2f0ikops0].[none:[Info Tooltip]] Physical Vendor Identification (copy)_6810638966135787531:nk]</column>
            <column>[federated.1uqcwtt0t2d99u1axru2f0ikops0].[none:pos_integration_type_original:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='header'>
            <format attr='band-color' scope='rows' value='#00000000' />
          </style-rule>
          <style-rule element='pane'>
            <format attr='band-color' scope='rows' value='#00000000' />
          </style-rule>
          <style-rule element='table'>
            <format attr='background-color' value='#00000000' />
            <format attr='band-size' scope='rows' value='1' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Shape' />
            <encodings>
              <lod column='[federated.1uqcwtt0t2d99u1axru2f0ikops0].[none:Info Pannel Placeholder (copy)_6088233437364850688:nk]' />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run fontsize='11'>The dashboard provides a comparison between the overall vendors&apos; performance before and after POS. It is limited to the </run>
                <run bold='true' fontsize='11'>vendors that became POS in the last 12 months</run>
                <run fontsize='11'>. As some vendors have had many different integrations and chains, </run>
                <run bold='true' fontsize='11'>we consider the configuration only of the initial integrations </run>
                <run fontsize='11'>- the very first integration &amp; the first integration after a NON-POS period. </run>
                <run>Æ&#10;&#10;</run>
                <run fontsize='11'>For example:</run>
                <run><![CDATA[

<Sheet name="[POS B&A] Report Information Explained" maxwidth="500" maxheight="500" filter="[[Info Tooltip] Physical Vendor Identification Not Null], [[Info Tooltip] Physical Vendor Identification]">

]]></run>
                <run fontcolor='#b4b4b4' italic='true'>** Loading time ~10 seconds. If the example visualisation is empty, we don&apos;t have a vendor with &gt; 1 integration in the last 12 m</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontsize='11'>Integration periods: &#9;</run>
                <run fontsize='11'>&gt; 14 days </run>
                <run>Æ&#10;</run>
                <run bold='true' fontsize='11'>NON-POS breaks: &#9;</run>
                <run fontsize='11'>&gt; 14 days</run>
                <run>Æ&#10;</run>
                <run bold='true' fontsize='11'>Metrics Timeline: &#9;</run>
                <run fontsize='11'>up to 3 m B&amp; A POS </run>
              </formatted-text>
            </customized-tooltip>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-cull' value='true' />
                <format attr='mark-labels-show' value='false' />
                <format attr='shape' value='My Shapes/icons-information.png' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
      <simple-id uuid='{1FF88349-9F76-4FC7-88B2-DA362178E2E8}' />
    </worksheet>
    <worksheet name='[POS B&amp;A] Info Pannel T-Dimension'>
      <table>
        <view>
          <datasources>
            <datasource caption='posmw_vendor_orders_before_after_pos_start' name='federated.1uqcwtt0t2d99u1axru2f0ikops0' />
          </datasources>
          <datasource-dependencies datasource='federated.1uqcwtt0t2d99u1axru2f0ikops0'>
            <column caption='Diff First Order to Equalisation' datatype='integer' name='[Calculation_277534387970027520]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='ABS([first_order_date_to_pos]) - [equalisation_period]' />
            </column>
            <column caption='20-30 Days Diff Equalisation to  First Order' datatype='integer' name='[Calculation_277534387971121153]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_277534387970027520] &gt;= 20 AND  [Calculation_277534387970027520] &lt;= 30 &#10;THEN 1 &#10;ELSE 0 &#10;END' />
            </column>
            <column caption='Info Pannel Placeholder' datatype='string' name='[Info Pannel Placeholder (copy)_6088233437364850688]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos; &apos;' />
