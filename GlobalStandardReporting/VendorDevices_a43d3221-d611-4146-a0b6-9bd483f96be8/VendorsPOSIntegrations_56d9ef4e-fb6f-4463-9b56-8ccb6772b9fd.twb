            <column caption='[Tool Tip KPI Metric B]  Metric 1 ' datatype='integer' datatype-customized='true' default-format='n#,##0;-#,##0' name='[[Tool Tip KPI A]] Orders - Physical Vendors  (copy) (copy)_6848567715378290693]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Select KPI Metric (copy)_6848567715375222784] = &apos;Physical Vendors&apos; THEN SUM([orders])&#10;ELSEIF [Parameters].[Select KPI Metric (copy)_6848567715375222784] = &apos;Platform Vendors&apos; THEN SUM([orders])&#10;ELSEIF [Parameters].[Select KPI Metric (copy)_6848567715375222784] = &apos;Orders&apos; THEN [Calculation_3998352103356067843]&#10;ELSEIF [Parameters].[Select KPI Metric (copy)_6848567715375222784] = &apos;Accepted Orders&apos; THEN [Calculation_3998352103356067843]&#10;END' />
