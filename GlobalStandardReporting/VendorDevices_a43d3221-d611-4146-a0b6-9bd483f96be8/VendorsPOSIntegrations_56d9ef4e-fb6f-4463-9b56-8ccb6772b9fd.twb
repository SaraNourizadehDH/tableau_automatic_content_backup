            <groupfilter count='1' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
              <groupfilter direction='DESC' expression='MAX([Calculation_277534387971121153])' function='order' user:ui-marker='order'>
                <groupfilter function='level-members' level='[none:physical_vendor:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
