    <worksheet name='[POS B&amp;A] Orders vs. Failure Rate (Owners) '>
      <layout-options>
        <title>
          <formatted-text>
            <run>&lt;</run>
            <run>[Parameters].[Select KPI Metric (copy)_6848567715375222784]</run>
            <run>&gt; &amp; Failure Rate (Owners) Comparison Before and After POS</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='posmw_vendor_orders_before_after_pos_start' name='federated.1uqcwtt0t2d99u1axru2f0ikops0' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Weekly' caption='t-dimension Granularity' datatype='string' folder-name='Params POS B&amp;A' name='[Choose Date Granularity (copy)_4874372596788895744]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
              <calculation class='tableau' formula='&quot;week&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
            <column alias='Daily' caption='Cohort Granularity' datatype='string' folder-name='Params POS B&amp;A' name='[Order Date Granularity (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;day&quot;'>
              <calculation class='tableau' formula='&quot;day&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;quarter&quot;' value='Quarterly' />
                <alias key='&quot;week&quot;' value='Weekly' />
                <alias key='&quot;year&quot;' value='Yearly' />
              </aliases>
            </column>
            <column caption='Select KPI Metric (A)' datatype='string' folder-name='Params POS B&amp;A' name='[Select KPI Metric (copy)_5621899766599585802]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% Vendor Fail Rate&quot;'>
              <calculation class='tableau' formula='&quot;% Vendor Fail Rate&quot;' />
              <aliases>
                <alias key='&quot;Accepted Orders&quot;' value='# Accepted Orders' />
                <alias key='&quot;Completed Orders&quot;' value='# Completed Orders' />
                <alias key='&quot;Failed Orders&quot;' value='# Failed Orders' />
                <alias key='&quot;Orders&quot;' value='# Orders' />
                <alias key='&quot;Physical Vendors&quot;' value='# Physical Vendors' />
                <alias key='&quot;Platform Vendors&quot;' value='# Platform Vendors' />
                <alias key='&quot;Vendor Fail Reasons&quot;' value='% Vendor Fail Rate (Reasons)' />
              </aliases>
            </column>
            <column alias='# Orders' caption='Select KPI Metric (B)' datatype='string' folder-name='Params POS B&amp;A' name='[Select KPI Metric (copy)_6848567715375222784]' param-domain-type='list' role='measure' type='nominal' value='&quot;Orders&quot;'>
              <calculation class='tableau' formula='&quot;Orders&quot;' />
              <aliases>
                <alias key='&quot;Accepted Orders&quot;' value='# Accepted Orders' />
                <alias key='&quot;Orders&quot;' value='# Orders' />
                <alias key='&quot;Physical Vendors&quot;' value='# Physical Vendors' />
                <alias key='&quot;Platform Vendors&quot;' value='# Platform Vendors' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1uqcwtt0t2d99u1axru2f0ikops0'>
            <column caption='% Platform Fail Rate' datatype='real' default-format='p0.00%' name='[% Vendor Fail Rate (copy) (copy 2) (copy 2)_4874372596807876618]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_order_platform]) / SUM([orders])' />
            </column>
            <column caption='% Transport Fail Rate' datatype='real' default-format='p0.00%' name='[% Vendor Fail Rate (copy) (copy 2) (copy)_4874372596807868425]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_order_transport]) / SUM([orders])' />
            </column>
            <column caption='% Fulfilment Fail Rate' datatype='real' default-format='p0.00%' name='[% Vendor Fail Rate (copy) (copy 2)_4874372596807856136]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_order_fulfilment]) / SUM([orders])' />
            </column>
            <column caption='% Customer Fail Rate' datatype='real' default-format='p0.00%' name='[% Vendor Fail Rate (copy)_4874372596807835654]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_order_customer]) / SUM([orders])' />
            </column>
            <column caption='_View_' datatype='string' name='[Calculation_217580214179545088]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Select KPI Metric (copy)_5621899766599585802]' />
            </column>
            <column caption='Physical Vendors + Pos Period Start' datatype='string' name='[Calculation_3998352103355068417]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[physical_vendor] + STR([pos_period_start_date])' />
            </column>
            <column caption='# Physical Vendors' datatype='integer' name='[Calculation_3998352103356067843]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_3998352103355068417])' />
            </column>
            <column caption='# Platform Vendors' datatype='integer' name='[Calculation_3998352103356493828]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Physical Vendors + Pos Period Start (copy)_3998352103355875330])' />
            </column>
            <column caption='t-dimension' datatype='string' name='[Calculation_4874372596797050882]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Choose Date Granularity (copy)_4874372596788895744]&#10;    WHEN &apos;day&apos;&#10;        THEN &apos;T &apos; + STR([order_to_pos_start_days])&#10;    WHEN &apos;week&apos;&#10;        THEN &apos;T &apos; + STR([order_to_pos_start_weeks])&#10;    WHEN &apos;month&apos;&#10;        THEN &apos;T &apos; + STR([order_to_pos_start_months])&#10;END' />
            </column>
            <column caption='[Colors] Before &amp; After POS ' datatype='string' name='[Calculation_4874372596805128195]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE CONTAINS( [Calculation_4874372596797050882], &apos;-&apos; )&#10;    WHEN TRUE   THEN &apos;Before POS&apos;&#10;    WHEN FALSE  THEN &apos;After POS&apos;&#10;END' />
            </column>
            <column caption='% Vendor Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_4874372596807598085]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_order_vendor]) / SUM([orders])' />
