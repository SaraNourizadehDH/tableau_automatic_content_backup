            <column-instance column='[physical_vendor]' derivation='None' name='[none:physical_vendor:nk]' pivot='key' type='nominal' />
            <column-instance column='[pos_integration_type_original]' derivation='None' name='[none:pos_integration_type_original:nk]' pivot='key' type='nominal' />
            <column caption='Physical Vendor' datatype='string' name='[physical_vendor]' role='dimension' type='nominal' />
            <column caption='Pos Integration Type Original' datatype='string' name='[pos_integration_type_original]' role='dimension' type='nominal' />
