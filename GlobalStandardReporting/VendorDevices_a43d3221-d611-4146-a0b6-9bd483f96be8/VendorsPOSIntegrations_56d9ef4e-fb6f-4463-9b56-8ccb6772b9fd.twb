            <column-instance column='[[Tool Tip KPI Metric B]]  Metric 3 (copy)_279856552939139082]' derivation='Attribute' name='[attr:[Tool Tip KPI Metric B]]  Metric 3 (copy)_279856552939139082:nk]' pivot='key' type='nominal' />
