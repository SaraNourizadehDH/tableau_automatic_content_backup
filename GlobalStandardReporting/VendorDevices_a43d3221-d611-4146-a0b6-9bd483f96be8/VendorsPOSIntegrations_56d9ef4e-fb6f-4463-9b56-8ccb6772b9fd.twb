      <column caption='[Info Tooltip] Physical Vendor Identification Not Null' datatype='string' name='[[Info Tooltip]] Physical Vendor Identification (copy)_6810638966135787531]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_6810638966123827206] = [Calculation_6810638966119534596]&#10;THEN [physical_vendor]&#10;ELSE Null &#10;END' />
