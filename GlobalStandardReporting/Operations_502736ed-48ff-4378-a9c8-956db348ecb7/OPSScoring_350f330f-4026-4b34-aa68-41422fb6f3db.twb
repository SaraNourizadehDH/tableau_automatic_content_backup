            <column caption='Score color' datatype='string' name='[Calculation_1184376373536325633]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF AVG([ops_score]) &gt; 3.5 THEN &apos;green&apos;&#10;ELSEIF AVG([ops_score]) &gt;= 3 THEN &apos;yellow&apos;&#10;ELSE &apos;red&apos;&#10;END' />
            </column>
            <column caption='Vendors Count' datatype='integer' name='[Calculation_1184376373545791491]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([vendor_id])' />
            </column>
            <column aggregation='CountD' caption='Vendors with B&amp;M Count' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1184376373546057732]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF IFNULL(bm_vendors, &apos;N/A&apos;) != &apos;N/A&apos; THEN vendor_id END' />
            </column>
            <column caption='B&amp;M Rate' datatype='real' name='[Calculation_1184376373547847685]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_1184376373546057732])/[Calculation_1184376373545791491]' />
            </column>
            <column caption='Vendor' datatype='string' name='[Calculation_5579397037396013056]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[vendor_name] + &apos; &apos; + vendor_id' />
            </column>
            <column caption='Vendor ADO' datatype='string' name='[Calculation_5579397037408473089]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [ADO] &lt; 40 THEN &quot;Low volume, below 40 orders&quot;&#10;ELSEIF [ADO] &lt; 70 THEN &quot;Average volume, below 70 orders&quot;&#10;ELSE &quot;High volume, 70 + orders&quot;&#10;END' />
            </column>
