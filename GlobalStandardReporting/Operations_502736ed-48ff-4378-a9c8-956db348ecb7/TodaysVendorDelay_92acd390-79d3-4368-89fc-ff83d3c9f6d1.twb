      <aliases enabled='yes' />
      <column caption='Entitlement' datatype='boolean' name='[Calculation_4819555291177816064]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Is Vendor Late (5min)' datatype='boolean' name='[Calculation_4819555291178004481]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[vendor_late_os]&gt; 300' />
      </column>
      <column caption='Vendor Late Rate' datatype='real' default-format='p0%' name='[Calculation_4819555291178188802]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_4819555291178004481] THEN 1 ELSE 0 END) / COUNTD([order_id])' />
      </column>
      <column caption='Orders' datatype='integer' name='[Calculation_4819555291178549251]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([order_id])' />
      </column>
      <column caption='Last few hours' datatype='boolean' name='[Calculation_4819555291178905604]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEPART(&apos;hour&apos;, NOW()) -  &#10;DATEPART(&apos;hour&apos;, [original_scheduled_pickup_at]) &lt; 5' />
      </column>
      <column caption='Last Pick Up At' datatype='datetime' name='[Calculation_4819555291180425221]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MAX([rider_picked_up_at])' />
      </column>
