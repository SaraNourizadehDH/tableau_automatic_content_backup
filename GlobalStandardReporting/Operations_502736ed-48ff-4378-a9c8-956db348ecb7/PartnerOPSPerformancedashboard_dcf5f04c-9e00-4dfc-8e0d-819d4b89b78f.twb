            <column datatype='real' name='[vendor_late_5_min_count]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <slices>
            <column>[federated.0tvk7t70ah311s1df95em1n2atmx].[none:brand_name:nk]</column>
            <column>[federated.0tvk7t70ah311s1df95em1n2atmx].[none:partner_name:nk]</column>
