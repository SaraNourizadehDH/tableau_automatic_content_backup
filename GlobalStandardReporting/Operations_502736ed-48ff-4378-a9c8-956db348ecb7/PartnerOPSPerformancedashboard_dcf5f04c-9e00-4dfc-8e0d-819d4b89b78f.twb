    <worksheet name='Ops Orders x Graph'>
      <layout-options>
        <title>
          <formatted-text>
            <run><![CDATA[Orders x <[Parameters].[Parameter 9]>
]]></run>
            <run fontsize='10'>** Select a second metric</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_partner_monthly_ops_report' name='federated.0tvk7t70ah311s1df95em1n2atmx' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select a Metric for Ops' datatype='string' name='[Parameter 9]' param-domain-type='list' role='measure' type='nominal' value='&quot;Preparation Time&quot;'>
              <calculation class='tableau' formula='&quot;Preparation Time&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0tvk7t70ah311s1df95em1n2atmx'>
            <column caption='Preparation Time' datatype='real' name='[Calculation_173599731907002368]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([prep_min_sum])/SUM([prep_min_count])' />
            </column>
            <column caption='Delivery Time' datatype='real' name='[Calculation_173599731907989505]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_time_sum])/SUM([delivery_time_count])' />
            </column>
            <column caption='Offline Rate' datatype='real' name='[Calculation_173599731908333570]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-((1 - sum([offline_minutes])/sum([schedule_minutes])))' />
            </column>
            <column caption='Rejection Rate' datatype='real' name='[Calculation_173599731908808707]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([failed_orders_vendor])/SUM([successful_orders]))' />
            </column>
            <column caption='Rating' datatype='real' name='[Calculation_173599731909029892]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rating_sum])/SUM([rating_count])*5' />
            </column>
            <column caption='Vendor Delay Rate 5 min' datatype='real' name='[Calculation_173599731909206021]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_5_min_count])/SUM([successful_orders])' />
            </column>
            <column caption='Fail Rate' datatype='real' name='[Calculation_173599731909410822]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([failed_orders])/SUM([total_orders]))' />
            </column>
            <column caption='Ops Metric Trend' datatype='real' name='[Calculation_173599731915243527]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 9]&#10;WHEN &quot;Preparation Time&quot; THEN [Calculation_173599731907002368]&#10;WHEN &quot;Delivery Time&quot; THEN [Calculation_173599731907989505]&#10;WHEN &quot;Offline Rate %&quot; THEN [Calculation_173599731908333570]*100&#10;WHEN &quot;Rejection Rate %&quot; THEN [Calculation_173599731908808707]*100&#10;WHEN &quot;Rating&quot; THEN [Calculation_173599731909029892]&#10;WHEN &quot;Vendor Delay 5 min %&quot; THEN [Calculation_173599731909206021]*100&#10;WHEN &quot;Fail Rate %&quot; THEN [Calculation_173599731909410822]*100&#10;END' />
            </column>
            <column caption='Kitchens or B&amp;M' datatype='string' name='[Calculation_5936799878900658177]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [kitchen_short_name (copy)_2623839403224707134] = &apos;B&amp;M&apos; THEN &apos;B&amp;M&apos;&#10;ELSE &apos;Kitchens&apos; END' />
            </column>
            <column datatype='string' name='[brand_name]' role='dimension' type='nominal' />
            <column datatype='real' name='[delivery_time_count]' role='measure' type='quantitative' />
            <column datatype='real' name='[delivery_time_sum]' role='measure' type='quantitative' />
            <column datatype='real' name='[failed_orders]' role='measure' type='quantitative' />
            <column datatype='real' name='[failed_orders_vendor]' role='measure' type='quantitative' />
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Kitchen Name ' datatype='string' name='[kitchen_short_name (copy)_2623839403224707134]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[kitchen_short_name]' />
            </column>
            <column datatype='string' name='[kitchen_short_name]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_5936799878900658177]' derivation='None' name='[none:Calculation_5936799878900658177:nk]' pivot='key' type='nominal' />
            <column-instance column='[brand_name]' derivation='None' name='[none:brand_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[partner_name]' derivation='None' name='[none:partner_name:nk]' pivot='key' type='nominal' />
            <column datatype='real' name='[offline_minutes]' role='measure' type='quantitative' />
            <column datatype='string' name='[partner_name]' role='dimension' type='nominal' />
            <column datatype='real' name='[prep_min_count]' role='measure' type='quantitative' />
            <column datatype='real' name='[prep_min_sum]' role='measure' type='quantitative' />
            <column datatype='integer' name='[rating_count]' role='measure' type='quantitative' />
            <column datatype='real' name='[rating_sum]' role='measure' type='quantitative' />
            <column datatype='date' name='[report_month]' role='dimension' type='ordinal' />
