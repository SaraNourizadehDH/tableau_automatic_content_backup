      </column>
      <column caption='Preparation Time' datatype='real' name='[Calculation_173599731907002368]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([prep_min_sum])/SUM([prep_min_count])' />
      </column>
      <column caption='Delivery Time' datatype='real' name='[Calculation_173599731907989505]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([delivery_time_sum])/SUM([delivery_time_count])' />
      </column>
      <column caption='Offline Rate' datatype='real' name='[Calculation_173599731908333570]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1-((1 - sum([offline_minutes])/sum([schedule_minutes])))' />
      </column>
      <column caption='Rejection Rate' datatype='real' name='[Calculation_173599731908808707]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([failed_orders_vendor])/SUM([successful_orders]))' />
      </column>
      <column caption='Rating' datatype='real' name='[Calculation_173599731909029892]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([rating_sum])/SUM([rating_count])*5' />
      </column>
      <column caption='Vendor Delay Rate 5 min' datatype='real' name='[Calculation_173599731909206021]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendor_late_5_min_count])/SUM([successful_orders])' />
      </column>
      <column caption='Fail Rate' datatype='real' name='[Calculation_173599731909410822]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([failed_orders])/SUM([total_orders]))' />
      </column>
      <column caption='Ops Metric Trend' datatype='real' name='[Calculation_173599731915243527]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 9]&#10;WHEN &quot;Preparation Time&quot; THEN [Calculation_173599731907002368]&#10;WHEN &quot;Delivery Time&quot; THEN [Calculation_173599731907989505]&#10;WHEN &quot;Offline Rate %&quot; THEN [Calculation_173599731908333570]*100&#10;WHEN &quot;Rejection Rate %&quot; THEN [Calculation_173599731908808707]*100&#10;WHEN &quot;Rating&quot; THEN [Calculation_173599731909029892]&#10;WHEN &quot;Vendor Delay 5 min %&quot; THEN [Calculation_173599731909206021]*100&#10;WHEN &quot;Fail Rate %&quot; THEN [Calculation_173599731909410822]*100&#10;END' />
      </column>
      <column caption='max date' datatype='date' name='[Calculation_1859494102780846080]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED :MAX([report_month])}' />
      </column>
      <column caption='Is Last  Month' datatype='boolean' name='[Calculation_1859494102834782218]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1859494102780846080] = [report_month] then true else false end' />
      </column>
      <column caption='Hide Nulls' datatype='boolean' name='[Calculation_1859494102836051983]' role='measure' type='nominal'>
        <calculation class='tableau' formula='INDEX()!= 1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Days Diff from Max Day' datatype='integer' name='[Calculation_1859494103237623831]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEPART(&apos;day&apos;,[Calculation_1859494102780846080])' />
      </column>
      <column caption='Row No' datatype='integer' name='[Calculation_2623839402895552567]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Attr' datatype='integer' name='[Calculation_5936799878869467136]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Kitchens or B&amp;M' datatype='string' name='[Calculation_5936799878900658177]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [kitchen_short_name (copy)_2623839403224707134] = &apos;B&amp;M&apos; THEN &apos;B&amp;M&apos;&#10;ELSE &apos;Kitchens&apos; END' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_6085137196630519808]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]=USERNAME()' />
      </column>
      <column caption='LW' datatype='datetime' name='[Calculation_6191675482530623510]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;,DATEADD(&apos;week&apos;,-1,TODAY()))' />
      </column>
      <column caption='successful order LW clean Total' datatype='real' name='[Calculation_6191675482752598042]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [report_month]=DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-1,TODAY())) THEN&#10;[successful_orders] END' />
      </column>
      <column caption='Vendor name id' datatype='string' name='[Calculation_6895503650175827969]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[vendor_name]+[vendor_id]' />
      </column>
      <column caption='L2W' datatype='datetime' name='[LW (copy)_6191675482531287063]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;,DATEADD(&apos;week&apos;,-2,TODAY()))' />
      </column>
