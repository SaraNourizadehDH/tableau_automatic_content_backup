      <column caption='Vendor Location' datatype='spatial' name='[Calculation_162411066968506368]' role='measure' type='nominal'>
        <calculation class='tableau' formula='MAKEPOINT([vendor_latitude], [vendor_longitude])' />
      </column>
      <column caption='Orders LOD' datatype='integer' name='[Calculation_162411066972266497]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [location_name], [location_status], [logistic_zone_restricted], [drive_time], [vehicle_profile], [global_entity_id]&#10;:&#10;MAX([orders])}' />
      </column>
      <column caption='Polygon Point' datatype='spatial' name='[Calculation_162411066977603586]' role='measure' type='nominal'>
