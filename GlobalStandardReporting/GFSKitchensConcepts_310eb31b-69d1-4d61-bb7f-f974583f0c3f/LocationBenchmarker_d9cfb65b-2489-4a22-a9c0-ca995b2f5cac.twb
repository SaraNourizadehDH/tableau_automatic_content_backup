      <aliases enabled='yes' />
      <column caption='Is compared to' datatype='boolean' name='[Calculation_1567815655944552448]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[location_name] IN [Location Name Set]' />
      </column>
      <column caption='Comparison Latitude' datatype='real' name='[Calculation_1567815655946768385]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED : AVG(IF [Calculation_1567815655944552448] then [latitude] end) }' />
      </column>
      <column caption='Distance [km]' datatype='real' name='[Calculation_1567815655947083779]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DISTANCE(MAKEPOINT([latitude], [longitude]), MAKEPOINT([Calculation_1567815655946768385], [Comparison Latitude (copy)_1567815655946985474]), &quot;km&quot;)' />
      </column>
      <column caption='Relevant Location Keys' datatype='string' name='[Calculation_211598849731768320]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [kitchen_owner] IN (&apos;Central&apos;, &apos;KW_Team&apos;, &apos;KSA_Team&apos;, &apos;CSS_Colab&apos;) then [location_key] end' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_211598849736159233]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Comparison Longitude' datatype='real' name='[Comparison Latitude (copy)_1567815655946985474]' role='measure' semantic-role='[Geographical].[Latitude]' type='quantitative'>
        <calculation class='tableau' formula='{FIXED : AVG(IF [Calculation_1567815655944552448] then [longitude] end) }' />
      </column>
