            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='federated.1a3w6o41e72lnw17qvn8f0yts3h3'>
            <column caption='Color scheme' datatype='string' name='[Calculation_1284018527538565120]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  [Calculation_1881026942655094787]  THEN  &quot;Location&quot;&#10;ELSEIF [Calculation_1881026942654234626] &gt; 0.75 THEN &quot;Overlap &gt; 0.75&quot;&#10;ELSEIF [Calculation_1881026942654234626] &gt; 0.50 THEN &quot;Overlap &gt; 0.5&quot;&#10;ELSEIF [Calculation_1881026942654234626] &gt; 0.25 THEN &quot;Overlap &gt; 0.25&quot;&#10;ELSE &quot;Overlap &lt; 0.25&quot;&#10;END' />
            </column>
            <column caption='Calculation1' datatype='string' name='[Calculation_1284018527539683330]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1881026942655094787] THEN &quot;Checked Location&quot; ELSE STR(ROUND([Calculation_1881026942654234626]*100, 0)) + &quot;%&quot; END' />
            </column>
            <column caption='Entitlement' datatype='boolean' name='[Calculation_1881026942653431808]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[username] = USERNAME()' />
            </column>
            <column caption='Location Orders' datatype='integer' name='[Calculation_1881026942653997057]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='{FIXED [location_name], [drive_time] : MAX(&#10;IF [location_name] =  [overlapping_kitchen_name] THEN [orders] END) }' />
            </column>
            <column caption='Overlap Percentage' datatype='real' name='[Calculation_1881026942654234626]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[orders]/ [Calculation_1881026942653997057]' />
            </column>
            <column caption='Is Same Location' datatype='boolean' name='[Calculation_1881026942655094787]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[overlapping_kitchen_name] = [location_name]' />
              <aliases>
                <alias key='false' value='Other Location' />
                <alias key='true' value='Checked Location' />
              </aliases>
            </column>
            <column caption='Status' datatype='string' name='[Calculation_1881026942657122308]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  [Calculation_1881026942655094787] THEN &quot;This Location&quot;&#10;ELSE [overlapping_location_status] END' />
            </column>
