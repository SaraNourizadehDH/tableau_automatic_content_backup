      <aliases enabled='yes' />
      <column caption='_time_duration' datatype='integer' name='[Calculation_2157927960395485184]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='TODAY() - MIN([created_date]) + 1' />
      </column>
      <column caption=' Item Unavailable' datatype='real' name='[Calculation_2470294800931684352]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([reconciliation_accepted_client_item_unavailable])/SUM([total_orders])' />
      </column>
      <column caption='Mistake Error' datatype='real' name='[Calculation_2470294800931954689]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([reconciliation_accepted_client_mistake])/SUM([total_orders])' />
      </column>
      <column caption='Failed Other' datatype='real' name='[Calculation_2470294800932352002]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([reconciliation_accepted_other_failed])/SUM([total_orders])' />
      </column>
      <column caption='Failed Vendor Other' datatype='real' name='[Calculation_2470294800932548611]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([reconciliation_accepted_other_vendor])/SUM([total_orders])' />
      </column>
      <column caption='Wrong Item' datatype='real' name='[Calculation_2470294800932798468]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([reconciliation_accepted_wrong_item])/SUM([total_orders])' />
      </column>
      <column caption='Accepted (Not Failed)' datatype='real' name='[Calculation_2470294800932990981]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([reconciliation_accepted_client])/SUM([total_orders])' />
      </column>
      <column caption='Recon. (Decline)' datatype='real' name='[Calculation_2470294800933306374]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([reconciliation_declined_client])/SUM([total_orders])' />
      </column>
      <column caption='Recon. (Decline - 1 Product)' datatype='real' name='[Calculation_2470294800933838855]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([reconciliation_declined_client_1product])/SUM([total_orders])' />
      </column>
      <column caption='[C] Accepted (Failed)' datatype='real' name='[Calculation_2470294800934084616]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([customer_flow_accept_failed])/SUM([total_orders])' />
      </column>
      <column caption='[C] Accepted (Not Failed)' datatype='real' name='[Calculation_2470294800934572041]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([customer_flow_accept_accept])/SUM([total_orders])' />
      </column>
      <column caption='Decline' datatype='real' name='[Calculation_2470294800934936586]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([customer_flow_decline])/SUM([total_orders])' />
      </column>
      <column caption='Dismissed (Accepted)' datatype='real' name='[Calculation_2470294800935137291]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([customer_flow_dismissed_accepted])/SUM([total_orders])' />
      </column>
      <column caption='Dismissed' datatype='real' name='[Calculation_2470294800935346188]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([customer_flow_dismissed])/SUM([total_orders])' />
      </column>
      <column caption='No Action' datatype='real' name='[Calculation_2470294800935825421]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([customer_flow_shown_no_action])/SUM([total_orders])' />
      </column>
      <column caption='Agent/Other (Failed)' datatype='real' name='[Calculation_2470294800936116238]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([not_reconciled_order_item_failed_agent])/SUM([total_orders])' />
      </column>
      <column caption='Simple Flow (Failed)' datatype='real' name='[Calculation_2470294800936538127]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([not_reconciled_order_device])/SUM([total_orders])' />
      </column>
      <column caption='Overall Rescued ' datatype='real' name='[Calculation_910430848414117888]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([rescued])/SUM([total_orders] - [customer_flow_dismissed_accepted])' />
      </column>
      <column caption='Reconciliation Rescued ' datatype='real' name='[Calculation_910430848416354305]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([rescued])/ SUM([rescued_total_orders] - [customer_flow_dismissed_accepted])' />
      </column>
      <column caption='- Label - Overal Rescued' datatype='string' name='[Calculation_910430848433205250]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Overall Rescued %&apos;' />
      </column>
      <column caption='- Label Reconciliation Rescued' datatype='string' name='[Calculation_910430848434065411]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Reconciliation Rescued %&apos;' />
      </column>
      <column caption='- label - Partical Acc. Flow Rescued' datatype='string' name='[Calculation_910430848442056708]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Partical Acc. Flow Rescued %&apos;' />
      </column>
      <column caption='Partical Acc. Flow Rescued ' datatype='real' name='[Calculation_910430848442404869]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([reconciliation_accepted_client])/SUM([reconcile_orders])' />
      </column>
      <column caption='- Label Customer Flow Rescued' datatype='string' name='[Calculation_910430848444563462]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Customer Flow Rescued %&apos;' />
      </column>
      <column caption='Customer Flow Rescued' datatype='real' name='[Calculation_910430848445497351]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([customer_flow_accept_accept])/SUM([customer_flow_orders] - [customer_flow_dismissed_accepted])' />
      </column>
      <column caption='Negative Total Orders' datatype='integer' name='[Calculation_910430848450699272]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='- [total_orders]' />
      </column>
