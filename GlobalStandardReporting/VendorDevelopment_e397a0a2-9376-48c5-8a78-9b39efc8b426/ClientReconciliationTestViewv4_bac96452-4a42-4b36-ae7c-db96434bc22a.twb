            <column caption='Item Unavailable Failed' datatype='integer' name='[Calculation_2470294800988209168]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='COUNTD(IF [cancellation_reason] = &apos;ITEM_UNAVAILABLE&apos; THEN [unique_order_code] END)' />
            </column>
            <column caption='Call Customer (Accepted)' datatype='integer' name='[Calculation_2470294800988667921]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [reconciliation_segment] = &apos;2. CALL CUSTOMER (Accepted)&apos; THEN [unique_order_code] END)' />
            </column>
            <column caption='Call Customer (No Action)' datatype='integer' name='[Calculation_2470294800990900243]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [reconciliation_segment] = &apos;2. CALL CUSTOMER (No action)&apos; THEN [unique_order_code] END)' />
            </column>
            <column caption='Call Customer (Dismissed)' datatype='integer' name='[Calculation_2470294800991399956]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [reconciliation_segment] = &apos;2. CALL CUSTOMER (Dismissed)&apos; THEN [unique_order_code] END)' />
            </column>
            <column caption='Call Customer (Declined)' datatype='integer' name='[Calculation_2470294800992391189]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [reconciliation_segment] = &apos;2. CALL CUSTOMER (Declined)&apos; THEN [unique_order_code] END)' />
            </column>
            <column caption='Not Reconciled (Failed Agent/ Other)' datatype='integer' name='[Calculation_2470294801021583382]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [reconciliation_segment] = &apos;3. NOT Reconciled (Failed Agent/OTHER)&apos; THEN [unique_order_code] END)' />
            </column>
            <column caption='Simple Flow' datatype='integer' name='[Calculation_2470294801022042135]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [reconciliation_segment] = &apos;3. Simple Flow&apos; THEN [unique_order_code] END)' />
            </column>
            <column caption='Partial Acceptance (Accepted)' datatype='integer' name='[Calculation_2470294801022234648]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [reconciliation_segment] = &apos;1. Partial Acceptance (Accepted)&apos; THEN [unique_order_code] END)' />
            </column>
            <column caption='Partial Aceptance (Decline)' datatype='integer' name='[Calculation_2470294801022488601]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [reconciliation_segment] = &apos;1. Partial Acceptance (Declined)&apos; THEN [unique_order_code] END)' />
            </column>
            <column caption='Orders' datatype='integer' name='[Calculation_2470294801023971354]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([unique_order_code])' />
            </column>
