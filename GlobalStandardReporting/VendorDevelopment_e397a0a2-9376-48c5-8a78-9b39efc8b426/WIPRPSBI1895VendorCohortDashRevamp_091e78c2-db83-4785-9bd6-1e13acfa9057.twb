      <column caption='_order date metric name' datatype='string' name='[Calculation_2039075110479712262]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Date Granularity (copy)] &#10;WHEN &apos;# Orders&apos; THEN &apos;# All Orders within Period&apos;&#10;WHEN &apos;# Vendors with Orders&apos; THEN &apos;# All Vendors with Orders within Period&apos;&#10;WHEN &apos;# OD Orders&apos; THEN &apos;# OD Orders within Period&apos;&#10;WHEN &apos;# POS Orders&apos; THEN &apos;# POS Orders within Period&apos;&#10;WHEN &apos;% Fail Rate&apos; THEN &apos;% Fail Rate within Period&apos;&#10;WHEN &apos;% Vendor Fail Rate&apos; THEN &apos;% Vendor Fail Rate within Period&apos;&#10;WHEN &apos;# GoWin Orders&apos; THEN &apos;# GoWin Orders within Period&apos;&#10;WHEN &apos;# GoWeb Orders&apos; THEN &apos;# GoWeb Orders within Period&apos;&#10;WHEN &apos;# GoDroid Orders&apos; THEN &apos;# GoDroid Orders within Period&apos;&#10;WHEN &apos;# GoWin Vendors&apos; THEN &apos;# GoWin Vendors within Period&apos;&#10;WHEN &apos;# GoWeb Vendors&apos; THEN &apos;# GoWeb Vendors within Period&apos;&#10;WHEN &apos;# GoDroid Vendors&apos; THEN &apos;# GoDroid Vendors within Period&apos;&#10;WHEN &apos;% GoDroid Vendors&apos; THEN &apos;% GoDroid Vendors within Period&apos;&#10;WHEN &apos;% GoWeb Vendors&apos; THEN &apos;% GoWeb Vendors within Period&apos;&#10;WHEN &apos;% GoWin Vendors&apos; THEN &apos;% GoWin Vendors within Period&apos;&#10;WHEN &apos;% Item Unavailable FR&apos; THEN &apos;% Item Unavailable FR within Period&apos;&#10;WHEN &apos;% Unreachable FR&apos; THEN &apos;% Unreachable FR within Period&apos;&#10;WHEN &apos;% No Response FR&apos; THEN &apos;% No Response FR within Period&apos;&#10;WHEN &apos;% Too Busy FR&apos; THEN &apos;% Too Busy FR within Period&apos;&#10;WHEN &apos;% Closed FR&apos; THEN &apos;% Closed FR within Period&apos;&#10;WHEN &apos;% Vendor Grade AAA&apos; THEN &apos;% Vendor Grade AAA within Period&apos;&#10;WHEN &apos;% Vendor Grade AA&apos; THEN &apos;% Vendor Grade AA within Period&apos;&#10;WHEN &apos;% Vendor Grade A&apos; THEN &apos;% Vendor Grade A within Period&apos;&#10;WHEN &apos;% Vendor Grade B&apos; THEN &apos;% Vendor Grade B within Period&apos;&#10;WHEN &apos;% Vendor Grade C&apos; THEN &apos;% Vendor Grade C within Period&apos;&#10;WHEN &apos;% Vendor Grade D&apos; THEN &apos;% Vendor Grade D within Period&apos;&#10;WHEN &apos;% Vendor Grade NA&apos; THEN &apos;% Vendor Grade NA within Period&apos;&#10;END' />
      </column>
