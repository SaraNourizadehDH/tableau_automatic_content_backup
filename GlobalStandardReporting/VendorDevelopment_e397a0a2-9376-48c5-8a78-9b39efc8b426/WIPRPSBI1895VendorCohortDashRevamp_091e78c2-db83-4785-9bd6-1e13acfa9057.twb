  <worksheets>
    <worksheet name='Activation Cohort - INT'>
      <table>
        <view>
          <datasources>
            <datasource caption='vendor_cohort_revamp_dashboard_20230330v2 (van)' name='federated.04gavyf03r64be1gwp3g81h3umqv' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Metric' datatype='string' name='[Date Granularity (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% Vendors with Orders&quot;'>
              <calculation class='tableau' formula='&quot;% Vendors with Orders&quot;' />
            </column>
            <column alias='Monthly' caption='Date Granularity' datatype='integer' datatype-customized='true' name='[Show Data (copy)]' param-domain-type='list' role='measure' type='quantitative' value='3'>
              <calculation class='tableau' formula='3' />
              <aliases>
                <alias key='1' value='Daily' />
                <alias key='2' value='Weekly' />
                <alias key='3' value='Monthly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.04gavyf03r64be1gwp3g81h3umqv'>
            <column caption='date_granularity' datatype='boolean' name='[Calculation_2039075110085033984]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Show Data (copy)]&#10;WHEN 1 THEN [date_type] = &apos;Daily&apos;&#10;WHEN 2 THEN [date_type] = &apos;Weekly&apos;&#10;WHEN 3 THEN [date_type] = &apos;Monthly&apos;&#10;END' />
            </column>
            <column caption='Metric To Show' datatype='real' name='[Calculation_2039075110144020482]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Date Granularity (copy)] &#10;WHEN &apos;# Orders&apos; THEN SUM(IF [cte_type] = &apos;cohort&apos; THEN [orders_ct] ELSE 0 END)&#10;WHEN &apos;# Vendors&apos; THEN SUM(IF [cte_type] = &apos;cohort&apos; THEN [vendors_ct] ELSE 0 END)&#10;WHEN &apos;# Vendors with Orders&apos; THEN SUM(IF [cte_type] = &apos;cohort&apos; THEN [vendors_with_orders_ct] ELSE 0 END)&#10;WHEN &apos;% Vendors with Orders&apos; THEN &#10;SUM(IF [cte_type] = &apos;cohort&apos; THEN [vendors_with_orders_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;cohort&apos; THEN [vendors_ct] ELSE 0 END)&#10;WHEN &apos;# OD Orders&apos; THEN SUM(IF [cte_type] = &apos;cohort&apos; THEN [od_orders_ct] ELSE 0 END)&#10;WHEN &apos;# POS Orders&apos; THEN SUM(IF [cte_type] = &apos;cohort&apos; THEN [pos_orders_ct] ELSE 0 END)&#10;WHEN &apos;% Fail Rate&apos; THEN SUM(IF [cte_type] = &apos;cohort&apos; THEN [fail_orders_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;cohort&apos; THEN [orders_ct] ELSE 0 END)&#10;WHEN &apos;% Vendor Fail Rate&apos; THEN SUM(IF [cte_type] = &apos;cohort&apos; THEN [fail_orders_vendor_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;cohort&apos; THEN [orders_ct] ELSE 0 END)&#10;WHEN &apos;# GoWin Orders&apos; THEN SUM(IF [cte_type] = &apos;cohort&apos; THEN [gowin_orders_ct] ELSE 0 END)&#10;WHEN &apos;# GoWeb Orders&apos; THEN SUM(IF [cte_type] = &apos;cohort&apos; THEN [goweb_orders_ct] ELSE 0 END)&#10;WHEN &apos;# GoDroid Orders&apos; THEN SUM(IF [cte_type] = &apos;cohort&apos; THEN [godroid_orders_ct] ELSE 0 END)&#10;WHEN &apos;# GoWin Vendors&apos; THEN SUM(IF [cte_type] = &apos;cohort&apos; THEN [vendor_gowin_ct] ELSE 0 END)&#10;WHEN &apos;# GoWeb Vendors&apos; THEN SUM(IF [cte_type] = &apos;cohort&apos; THEN [vendor_goweb_ct] ELSE 0 END)&#10;WHEN &apos;# GoDroid Vendors&apos; THEN SUM(IF [cte_type] = &apos;cohort&apos; THEN [vendor_godroid_ct] ELSE 0 END)&#10;WHEN &apos;% GoDroid Vendors&apos; THEN SUM(IF [cte_type] = &apos;cohort&apos; THEN [vendor_godroid_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;cohort&apos; THEN [vendors_with_orders_ct] ELSE 0 END)&#10;WHEN &apos;% GoWeb Vendors&apos; THEN SUM(IF [cte_type] = &apos;cohort&apos; THEN [vendor_goweb_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;cohort&apos; THEN [vendors_with_orders_ct] ELSE 0 END)&#10;WHEN &apos;% GoWin Vendors&apos; THEN SUM(IF [cte_type] = &apos;cohort&apos; THEN [vendor_gowin_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;cohort&apos; THEN [vendors_with_orders_ct] ELSE 0 END)&#10;WHEN &apos;% Item Unavailable FR&apos; THEN SUM(IF [cte_type] = &apos;cohort&apos; THEN [fail_orders_item_unavailable_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;cohort&apos; THEN [orders_ct] ELSE 0 END)&#10;WHEN &apos;% Unreachable FR&apos; THEN SUM(IF [cte_type] = &apos;cohort&apos; THEN [fail_orders_unreachable_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;cohort&apos; THEN [orders_ct] ELSE 0 END)&#10;WHEN &apos;% No Response FR&apos; THEN SUM(IF [cte_type] = &apos;cohort&apos; THEN [fail_orders_no_response_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;cohort&apos; THEN [orders_ct] ELSE 0 END)&#10;WHEN &apos;% Too Busy FR&apos; THEN SUM(IF [cte_type] = &apos;cohort&apos; THEN [fail_orders_too_busy_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;cohort&apos; THEN [orders_ct] ELSE 0 END)&#10;WHEN &apos;% Closed FR&apos; THEN SUM(IF [cte_type] = &apos;cohort&apos; THEN [fail_orders_closed_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;cohort&apos; THEN [orders_ct] ELSE 0 END)&#10;WHEN &apos;% Vendor Grade AAA&apos; THEN SUM(IF [vendor_grade] = &apos;AAA&apos; AND [cte_type] = &apos;cohort&apos; THEN [vendors_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;cohort&apos; THEN [vendors_ct] ELSE 0 END)&#10;WHEN &apos;% Vendor Grade AA&apos; THEN SUM(IF [vendor_grade] = &apos;AA&apos; AND [cte_type] = &apos;cohort&apos; THEN [vendors_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;cohort&apos; THEN [vendors_ct] ELSE 0 END)&#10;WHEN &apos;% Vendor Grade A&apos; THEN SUM(IF [vendor_grade] = &apos;A&apos; AND [cte_type] = &apos;cohort&apos; THEN [vendors_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;cohort&apos; THEN [vendors_ct] ELSE 0 END)&#10;WHEN &apos;% Vendor Grade B&apos; THEN SUM(IF [vendor_grade] = &apos;B&apos; AND [cte_type] = &apos;cohort&apos; THEN [vendors_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;cohort&apos; THEN [vendors_ct] ELSE 0 END)&#10;WHEN &apos;% Vendor Grade C&apos; THEN SUM(IF [vendor_grade] = &apos;C&apos; AND [cte_type] = &apos;cohort&apos; THEN [vendors_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;cohort&apos; THEN [vendors_ct] ELSE 0 END)&#10;WHEN &apos;% Vendor Grade D&apos; THEN SUM(IF [vendor_grade] = &apos;D&apos; AND [cte_type] = &apos;cohort&apos; THEN [vendors_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;cohort&apos; THEN [vendors_ct] ELSE 0 END)&#10;WHEN &apos;% Vendor Grade NA&apos; THEN SUM(IF [vendor_grade] = &apos;NA&apos; AND [cte_type] = &apos;cohort&apos; THEN [vendors_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;cohort&apos; THEN [vendors_ct] ELSE 0 END)&#10;END' />
            </column>
            <column caption='Order Date Metric' datatype='real' name='[Calculation_2039075110153412611]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Date Granularity (copy)] &#10;WHEN &apos;# Orders&apos; THEN SUM(IF [cte_type] = &apos;order&apos; THEN [orders_ct] ELSE 0 END)&#10;WHEN &apos;# Vendors with Orders&apos; THEN SUM(IF [cte_type] = &apos;order&apos; THEN [vendors_with_orders_ct] ELSE 0 END)&#10;WHEN &apos;# OD Orders&apos; THEN SUM(IF [cte_type] = &apos;order&apos; THEN [od_orders_ct] ELSE 0 END)&#10;WHEN &apos;# POS Orders&apos; THEN SUM(IF [cte_type] = &apos;order&apos; THEN [pos_orders_ct] ELSE 0 END)&#10;WHEN &apos;% Fail Rate&apos; THEN SUM(IF [cte_type] = &apos;order&apos; THEN [fail_orders_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;order&apos; THEN [orders_ct] ELSE 0 END)&#10;WHEN &apos;% Vendor Fail Rate&apos; THEN SUM(IF [cte_type] = &apos;order&apos; THEN [fail_orders_vendor_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;order&apos; THEN [orders_ct] ELSE 0 END)&#10;WHEN &apos;# GoWin Orders&apos; THEN SUM(IF [cte_type] = &apos;order&apos; THEN [gowin_orders_ct] ELSE 0 END)&#10;WHEN &apos;# GoWeb Orders&apos; THEN SUM(IF [cte_type] = &apos;order&apos; THEN [goweb_orders_ct] ELSE 0 END)&#10;WHEN &apos;# GoDroid Orders&apos; THEN SUM(IF [cte_type] = &apos;order&apos; THEN [godroid_orders_ct] ELSE 0 END)&#10;WHEN &apos;# GoWin Vendors&apos; THEN SUM(IF [cte_type] = &apos;order&apos; THEN [vendor_gowin_ct] ELSE 0 END)&#10;WHEN &apos;# GoWeb Vendors&apos; THEN SUM(IF [cte_type] = &apos;order&apos; THEN [vendor_goweb_ct] ELSE 0 END)&#10;WHEN &apos;# GoDroid Vendors&apos; THEN SUM(IF [cte_type] = &apos;order&apos; THEN [vendor_godroid_ct] ELSE 0 END)&#10;WHEN &apos;% GoDroid Vendors&apos; THEN SUM(IF [cte_type] = &apos;order&apos; THEN [vendor_godroid_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;order&apos; THEN [vendors_with_orders_ct] ELSE 0 END)&#10;WHEN &apos;% GoWeb Vendors&apos; THEN SUM(IF [cte_type] = &apos;order&apos; THEN [vendor_goweb_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;order&apos; THEN [vendors_with_orders_ct] ELSE 0 END