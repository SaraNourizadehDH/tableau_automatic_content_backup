      <aliases enabled='yes' />
      <column caption='Cohort Size' datatype='integer' name='[Calculation_2039075110154764292]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendors_ct])' />
      </column>
      <column caption='Metric Granularity' datatype='string' name='[Calculation_2360941744907505688]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Metric (copy)] = &apos;(All)&apos; THEN NULL&#10;ELSEIF [Parameters].[Metric (copy)] = &apos;Region&apos; THEN [region]&#10;ELSEIF [Parameters].[Metric (copy)] = &apos;Brand Name&apos; THEN [brand_name]&#10;ELSEIF [Parameters].[Metric (copy)] = &apos;Country&apos; THEN [country_name]&#10;ELSEIF [Parameters].[Metric (copy)] = &apos;Is Self Activated&apos; THEN STR([is_self_activated])&#10;ELSEIF [Parameters].[Metric (copy)] = &apos;Vendor Grade&apos; THEN [vendor_grade]&#10;END' />
      </column>
      <column caption='Shown Metric' datatype='real' name='[Calculation_2360941744910172185]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Date Granularity (copy)] &#10;WHEN &apos;# Orders&apos; THEN SUM([orders_ct])&#10;WHEN &apos;# Vendors&apos; THEN SUM([vendors_ct])&#10;WHEN &apos;# Vendors with Orders&apos; THEN SUM([vendors_with_orders_ct])&#10;WHEN &apos;% Vendors with Orders&apos; THEN SUM([vendors_with_orders_ct])/SUM([vendors_ct])&#10;WHEN &apos;# OD Orders&apos; THEN SUM([od_orders_ct])&#10;WHEN &apos;# POS Orders&apos; THEN SUM([pos_orders_ct])&#10;WHEN &apos;% Fail Rate&apos; THEN SUM([fail_orders_ct])/SUM([orders_ct])&#10;WHEN &apos;% Vendor Fail Rate&apos; THEN SUM([fail_orders_vendor_ct])/SUM([orders_ct])&#10;WHEN &apos;# GoWin Orders&apos; THEN SUM([gowin_orders_ct])&#10;WHEN &apos;# GoWeb Orders&apos; THEN SUM([goweb_orders_ct])&#10;WHEN &apos;# GoDroid Orders&apos; THEN SUM([godroid_orders_ct])&#10;WHEN &apos;# GoWin Vendors&apos; THEN SUM([vendor_gowin_ct])&#10;WHEN &apos;# GoWeb Vendors&apos; THEN SUM([vendor_goweb_ct])&#10;WHEN &apos;# GoDroid Vendors&apos; THEN SUM([vendor_godroid_ct])&#10;WHEN &apos;% GoDroid Vendors&apos; THEN SUM([vendor_godroid_ct])/SUM([vendors_with_orders_ct])&#10;WHEN &apos;% GoWeb Vendors&apos; THEN SUM([vendor_goweb_ct])/SUM([vendors_with_orders_ct])&#10;WHEN &apos;% GoWin Vendors&apos; THEN SUM([vendor_gowin_ct])/SUM([vendors_with_orders_ct])&#10;WHEN &apos;% Item Unavailable FR&apos; THEN SUM([fail_orders_item_unavailable_ct])/SUM([orders_ct])&#10;WHEN &apos;% Unreachable FR&apos; THEN SUM([fail_orders_unreachable_ct])/SUM([orders_ct])&#10;WHEN &apos;% No Response FR&apos; THEN SUM([fail_orders_no_response_ct])/SUM([orders_ct])&#10;WHEN &apos;% Too Busy FR&apos; THEN SUM([fail_orders_too_busy_ct])/SUM([orders_ct])&#10;WHEN &apos;% Closed FR&apos; THEN SUM([fail_orders_closed_ct])/SUM([orders_ct])&#10;WHEN &apos;% Vendor Grade AAA&apos; THEN SUM(IF [vendor_grade] = &apos;AAA&apos; THEN [vendors_ct] ELSE 0 END)/SUM([vendors_ct])&#10;WHEN &apos;% Vendor Grade AA&apos; THEN SUM(IF [vendor_grade] = &apos;AA&apos; THEN [vendors_ct] ELSE 0 END)/SUM([vendors_ct])&#10;WHEN &apos;% Vendor Grade A&apos; THEN SUM(IF [vendor_grade] = &apos;A&apos; THEN [vendors_ct] ELSE 0 END)/SUM([vendors_ct])&#10;WHEN &apos;% Vendor Grade B&apos; THEN SUM(IF [vendor_grade] = &apos;B&apos; THEN [vendors_ct] ELSE 0 END)/SUM([vendors_ct])&#10;WHEN &apos;% Vendor Grade C&apos; THEN SUM(IF [vendor_grade] = &apos;C&apos; THEN [vendors_ct] ELSE 0 END)/SUM([vendors_ct])&#10;WHEN &apos;% Vendor Grade D&apos; THEN SUM(IF [vendor_grade] = &apos;D&apos; THEN [vendors_ct] ELSE 0 END)/SUM([vendors_ct])&#10;WHEN &apos;% Vendor Grade NA&apos; THEN SUM(IF [vendor_grade] = &apos;NA&apos; THEN [vendors_ct] ELSE 0 END)/SUM([vendors_ct])&#10;END' />
      </column>
      <column caption='KPI' datatype='string' name='[Calculation_2360941744951738394]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_2360941744910172185] &lt;= WINDOW_PERCENTILE([Calculation_2360941744910172185], 0.2) THEN &apos;20 Percentile&apos;&#10;ELSEIF  [Calculation_2360941744910172185] &lt;= WINDOW_PERCENTILE([Calculation_2360941744910172185], 0.8) THEN &apos;20-80 Percentile&apos;&#10;ELSEIF  [Calculation_2360941744910172185] &lt;= WINDOW_PERCENTILE([Calculation_2360941744910172185], 1) THEN &apos;80-100 Percentile&apos;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='_number' datatype='boolean' name='[Calculation_2360941744957775899]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Date Granularity (copy)]&#10;WHEN &apos;# Vendors&apos; THEN TRUE&#10;WHEN &apos;# Vendors with Orders&apos; THEN TRUE&#10;WHEN &apos;# Orders&apos; THEN TRUE&#10;WHEN &apos;# OD Orders&apos; THEN TRUE&#10;WHEN &apos;# POS Orders&apos; THEN TRUE&#10;WHEN &apos;# GoWin Orders&apos; THEN TRUE&#10;WHEN &apos;# GoWeb Orders&apos; THEN TRUE&#10;WHEN &apos;# GoDroid Orders&apos; THEN TRUE&#10;WHEN &apos;# GoWin Vendors&apos; THEN TRUE&#10;WHEN &apos;# GoWeb Vendors&apos; THEN TRUE&#10;WHEN &apos;# GoDroid Vendors&apos; THEN TRUE&#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='Fixed Cohort Size' datatype='real' name='[Calculation_2360941745946132508]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG({ INCLUDE [cohort_week], [time_period]&#10;                                        , [region]&#10;                                        , [brand_name]&#10;                                        , [country_name]&#10;                                        , [is_self_activated]&#10;                                        , [first_client_name]&#10;                                        , [first_delivery_type]&#10;                                        , [first_pos_integration_type]&#10;                                        , [first_vertical_type] : SUM([vendors_ct])})' />
      </column>
