_ct] ELSE 0 END)&#10;WHEN &apos;% Vendor Grade C&apos; THEN SUM(IF [vendor_grade] = &apos;C&apos; AND [cte_type] = &apos;order&apos; THEN [vendors_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;order&apos; THEN [vendors_ct] ELSE 0 END)&#10;WHEN &apos;% Vendor Grade D&apos; THEN SUM(IF [vendor_grade] = &apos;D&apos; AND [cte_type] = &apos;order&apos; THEN [vendors_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;order&apos; THEN [vendors_ct] ELSE 0 END)&#10;WHEN &apos;% Vendor Grade NA&apos; THEN SUM(IF [vendor_grade] = &apos;NA&apos; AND [cte_type] = &apos;order&apos; THEN [vendors_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;order&apos; THEN [vendors_ct] ELSE 0 END)&#10;END' />
