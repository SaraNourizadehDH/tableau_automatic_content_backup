    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Order Cohort'>
      <repository-location id='OrderCohort' path='/t/GlobalStandardReporting/workbooks/WIPRPSBI-1895VendorCohortDashRevamp' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='dash-text'>
          <format attr='text-align' value='center' />
          <format attr='wrap' value='on' />
        </style-rule>
        <style-rule element='parameter-ctrl'>
          <format attr='background-color' value='#ffffff' />
          <format attr='border-width' value='0' />
          <format attr='border-style' value='none' />
        </style-rule>
        <style-rule element='parameter-ctrl-title'>
          <format attr='text-align' value='left' />
        </style-rule>
      </style>
      <size maxheight='1500' maxwidth='1300' minheight='1500' minwidth='1300' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='vendor_order_cohort_dashboard_20230327 (van)' name='federated.0piybiq0x006wi126uigh0ie67gu' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Metric' datatype='string' name='[Date Granularity (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% Vendors with Orders&quot;'>
          <calculation class='tableau' formula='&quot;% Vendors with Orders&quot;' />
          <members>
            <member value='&quot;\# Vendors&quot;' />
            <member value='&quot;\# Vendors with Orders&quot;' />
            <member value='&quot;\% Vendors with Orders&quot;' />
            <member value='&quot;\# Orders&quot;' />
            <member value='&quot;\# OD Orders&quot;' />
