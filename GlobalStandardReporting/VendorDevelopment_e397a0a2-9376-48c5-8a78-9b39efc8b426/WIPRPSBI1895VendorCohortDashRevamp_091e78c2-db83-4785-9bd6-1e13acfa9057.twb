      <column caption='Comparative Name' datatype='string' name='[Calculation_3912009606880550913]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Date Granularity (copy)] &#10;WHEN &apos;# Orders&apos; THEN &apos;% of total Orders within Period&apos;&#10;WHEN &apos;# Vendors with Orders&apos; THEN &apos;% of total Vendors with Orders within Period&apos;&#10;WHEN &apos;# OD Orders&apos; THEN &apos;% of total OD Orders within Period&apos;&#10;WHEN &apos;# POS Orders&apos; THEN &apos;% of total POS Orders within Period&apos;&#10;WHEN &apos;# GoWin Orders&apos; THEN &apos;% of total GoWin Orders within Period&apos;&#10;WHEN &apos;# GoWeb Orders&apos; THEN &apos;% of total GoWeb Orders within Period&apos;&#10;WHEN &apos;# GoDroid Orders&apos; THEN &apos;% of total GoDroid Orders within Period&apos; &#10;WHEN &apos;# GoWin Vendors&apos; THEN &apos;% of total GoWin Vendors within Period&apos; &#10;WHEN &apos;# GoWeb Vendors&apos; THEN &apos;% of total GoWeb Vendors within Period&apos; &#10;WHEN &apos;# GoDroid Vendors&apos; THEN &apos;% of total GoDroid Vendors within Period&apos;&#10;WHEN &apos;% Vendor Grade AAA&apos; THEN &apos;% of total Vendor Grade AAA within Period&apos;&#10;WHEN &apos;% Vendor Grade AA&apos; THEN &apos;% of total Vendor Grade AA within Period&apos;&#10;WHEN &apos;% Vendor Grade A&apos; THEN &apos;% of total Vendor Grade A within Period&apos;&#10;WHEN &apos;% Vendor Grade B&apos; THEN &apos;% of total Vendor Grade B within Period&apos;&#10;WHEN &apos;% Vendor Grade C&apos; THEN &apos;% of total Vendor Grade C within Period&apos;&#10;WHEN &apos;% Vendor Grade D&apos; THEN &apos;% of total Vendor Grade D within Period&apos;&#10;WHEN &apos;% Vendor Grade NA&apos; THEN &apos;% of total Vendor Grade NA within Period&apos;&#10;END' />
      </column>
      <column caption='_is_number' datatype='boolean' name='[Calculation_3912009606884573186]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Date Granularity (copy)]&#10;WHEN &apos;# Vendors&apos; THEN TRUE&#10;WHEN &apos;# Vendors with Orders&apos; THEN TRUE&#10;WHEN &apos;# Orders&apos; THEN TRUE&#10;WHEN &apos;# OD Orders&apos; THEN TRUE&#10;WHEN &apos;# POS Orders&apos; THEN TRUE&#10;WHEN &apos;# GoWin Orders&apos; THEN TRUE&#10;WHEN &apos;# GoWeb Orders&apos; THEN TRUE&#10;WHEN &apos;# GoDroid Orders&apos; THEN TRUE&#10;WHEN &apos;# GoWin Vendors&apos; THEN TRUE&#10;WHEN &apos;# GoWeb Vendors&apos; THEN TRUE&#10;WHEN &apos;# GoDroid Vendors&apos; THEN TRUE&#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='Metric Granularity' datatype='string' name='[Calculation_3912009606890045443]' role='dimension' type='nominal'>
