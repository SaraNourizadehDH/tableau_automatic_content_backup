      <column caption='Color_KPI' datatype='string' name='[Calculation_2039075110430105605]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_2039075110144020482] &lt;= WINDOW_PERCENTILE([Calculation_2039075110144020482], 0.2) THEN &apos;20 Percentile&apos;&#10;ELSEIF  [Calculation_2039075110144020482] &lt;= WINDOW_PERCENTILE([Calculation_2039075110144020482], 0.8) THEN &apos;20-80 Percentile&apos;&#10;ELSEIF  [Calculation_2039075110144020482] &lt;= WINDOW_PERCENTILE([Calculation_2039075110144020482], 1) THEN &apos;80-100 Percentile&apos;&#10;END'>
