        <zone h='6800' hidden-by-user='true' id='359' type-v2='text' w='33923' x='20231' y='12133'>
          <formatted-text>
            <run fontalignment='0' fontcolor='#000000' italic='true'>This tab (Cohort by Order Date) displays the vendors&apos; performance on a weekly basis over a time period of </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' italic='true'>6 months</run>
            <run fontalignment='0' fontcolor='#000000' italic='true'>, based on their </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' italic='true'>order date</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' italic='true' underline='true'>Note:</run>
            <run fontalignment='0' fontcolor='#000000' italic='true'> Order date does </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' italic='true'>NOT </run>
            <run fontalignment='0' fontcolor='#000000' italic='true'>indicate the </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' italic='true'>first</run>
            <run fontalignment='0' fontcolor='#000000' italic='true'> order date of the vendor, rather performance of all vendors who had order on a specific week over Time.</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='dotted' />
            <format attr='border-width' value='1' />
            <format attr='background-color' value='#ffffff' />
          </zone-style>
        </zone>
