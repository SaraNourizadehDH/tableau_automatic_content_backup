    <worksheet name='Activation Cohort - INT example'>
      <table>
        <view>
          <datasources>
            <datasource caption='vendor_cohort_revamp_dashboard_20230330v2 (van)' name='federated.04gavyf03r64be1gwp3g81h3umqv' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Metric' datatype='string' name='[Date Granularity (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;Cohort Size&quot;'>
              <calculation class='tableau' formula='&quot;Cohort Size&quot;' />
            </column>
            <column caption='Dimension (B)' datatype='string' name='[Dimension (A) (copy)_1165939739784396800]' param-domain-type='list' role='measure' type='nominal' value='&quot;(All)&quot;'>
              <calculation class='tableau' formula='&quot;(All)&quot;' />
            </column>
            <column caption='Dimension (A)' datatype='string' name='[Metric (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;(All)&quot;'>
              <calculation class='tableau' formula='&quot;(All)&quot;' />
            </column>
            <column alias='Weekly' caption='Date Granularity' datatype='integer' datatype-customized='true' name='[Show Data (copy)]' param-domain-type='list' role='measure' type='quantitative' value='2'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='1' value='Daily' />
                <alias key='2' value='Weekly' />
                <alias key='3' value='Monthly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.04gavyf03r64be1gwp3g81h3umqv'>
            <column caption='Dimension (B)' datatype='string' name='[Calculation_1165939739784478721]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Dimension (A) (copy)_1165939739784396800] = &apos;(All)&apos; THEN &apos;(All)&apos;&#10;ELSEIF [Parameters].[Dimension (A) (copy)_1165939739784396800] = &apos;Region&apos; THEN [region]&#10;ELSEIF [Parameters].[Dimension (A) (copy)_1165939739784396800] = &apos;Brand Name&apos; THEN [brand_name]&#10;ELSEIF [Parameters].[Dimension (A) (copy)_1165939739784396800] = &apos;Country&apos; THEN [country_name]&#10;ELSEIF [Parameters].[Dimension (A) (copy)_1165939739784396800] = &apos;Is Self Activated&apos; THEN STR([is_self_activated])&#10;ELSEIF [Parameters].[Dimension (A) (copy)_1165939739784396800] = &apos;Vendor Grade&apos; THEN [vendor_grade]&#10;ELSEIF [Parameters].[Dimension (A) (copy)_1165939739784396800] = &apos;Transmission Type&apos; THEN [transmission_type]&#10;ELSEIF [Parameters].[Dimension (A) (copy)_1165939739784396800] = &apos;Vertical Food&apos; THEN [vertical_food]&#10;END' />
            </column>
            <column caption='date_granularity' datatype='boolean' name='[Calculation_2039075110085033984]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Show Data (copy)]&#10;WHEN 1 THEN [date_type] = &apos;Daily&apos;&#10;WHEN 2 THEN [date_type] = &apos;Weekly&apos;&#10;WHEN 3 THEN [date_type] = &apos;Monthly&apos;&#10;END' />
            </column>
            <column caption='Metric value of Cohort' datatype='real' name='[Calculation_2039075110144020482]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Date Granularity (copy)] &#10;WHEN &apos;# Orders&apos; THEN SUM(IF [cte_type] = &apos;cohort&apos; THEN [orders_ct] ELSE 0 END)&#10;WHEN &apos;Cohort Size&apos; THEN SUM(IF [cte_type] = &apos;cohort&apos; THEN [vendors_ct] ELSE 0 END)&#10;WHEN &apos;# Vendors with Orders&apos; THEN SUM(IF [cte_type] = &apos;cohort&apos; THEN [vendors_with_orders_ct] ELSE 0 END)&#10;WHEN &apos;% Vendors with Orders&apos; THEN &#10;SUM(IF [cte_type] = &apos;cohort&apos; THEN [vendors_with_orders_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;cohort&apos; THEN [vendors_ct] ELSE 0 END)&#10;WHEN &apos;# OD Orders&apos; THEN SUM(IF [cte_type] = &apos;cohort&apos; THEN [od_orders_ct] ELSE 0 END)&#10;WHEN &apos;# POS Orders&apos; THEN SUM(IF [cte_type] = &apos;cohort&apos; THEN [pos_orders_ct] ELSE 0 END)&#10;WHEN &apos;% Fail Rate&apos; THEN SUM(IF [cte_type] = &apos;cohort&apos; THEN [fail_orders_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;cohort&apos; THEN [orders_ct] ELSE 0 END)&#10;WHEN &apos;  % Vendor Fail Rate&apos; THEN SUM(IF [cte_type] = &apos;cohort&apos; THEN [fail_orders_vendor_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;cohort&apos; THEN [orders_ct] ELSE 0 END)&#10;WHEN &apos;# GoWin Orders&apos; THEN SUM(IF [cte_type] = &apos;cohort&apos; THEN [gowin_orders_ct] ELSE 0 END)&#10;WHEN &apos;# GoWeb Orders&apos; THEN SUM(IF [cte_type] = &apos;cohort&apos; THEN [goweb_orders_ct] ELSE 0 END)&#10;WHEN &apos;# GoDroid Orders&apos; THEN SUM(IF [cte_type] = &apos;cohort&apos; THEN [godroid_orders_ct] ELSE 0 END)&#10;WHEN &apos;# GoWin Vendors&apos; THEN SUM(IF [cte_type] = &apos;cohort&apos; THEN [vendor_gowin_ct] ELSE 0 END)&#10;WHEN &apos;# GoWeb Vendors&apos; THEN SUM(IF [cte_type] = &apos;cohort&apos; THEN [vendor_goweb_ct] ELSE 0 END)&#10;WHEN &apos;# GoDroid Vendors&apos; THEN SUM(IF [cte_type] = &apos;cohort&apos; THEN [vendor_godroid_ct] ELSE 0 END)&#10;WHEN &apos;% GoDroid Vendors&apos; THEN SUM(IF [cte_type] = &apos;cohort&apos; THEN [vendor_godroid_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;cohort&apos; THEN [vendors_with_orders_ct] ELSE 0 END)&#10;WHEN &apos;% GoWeb Vendors&apos; THEN SUM(IF [cte_type] = &apos;cohort&apos; THEN [vendor_goweb_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;cohort&apos; THEN [vendors_with_orders_ct] ELSE 0 END)&#10;WHEN &apos;% GoWin Vendors&apos; THEN SUM(IF [cte_type] = &apos;cohort&apos; THEN [vendor_gowin_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;cohort&apos; THEN [vendors_with_orders_ct] ELSE 0 END)&#10;WHEN &apos;    % Item Unavailable FR&apos; THEN SUM(IF [cte_type] = &apos;cohort&apos; THEN [fail_orders_item_unavailable_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;cohort&apos; THEN [orders_ct] ELSE 0 END)&#10;WHEN &apos;    % Unreachable FR&apos; THEN SUM(IF [cte_type] = &apos;cohort&apos; THEN [fail_orders_unreachable_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;cohort&apos; THEN [orders_ct] ELSE 0 END)&#10;WHEN &apos;    % No Response FR&apos; THEN SUM(IF [cte_type] = &apos;cohort&apos; THEN [fail_orders_no_response_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;cohort&apos; THEN [orders_ct] ELSE 0 END)&#10;WHEN &apos;    % Too Busy FR&apos; THEN SUM(IF [cte_type] = &apos;cohort&apos; THEN [fail_orders_too_busy_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;cohort&apos; THEN [orders_ct] ELSE 0 END)&#10;WHEN &apos;    % Closed FR&apos; THEN SUM(IF [cte_type] = &apos;cohort&apos; THEN [fail_orders_closed_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;cohort&apos; THEN [orders_ct] ELSE 0 END)&#10;WHEN &apos;% Vendor Grade AAA&apos; THEN SUM(IF [vendor_grade] = &apos;AAA&apos; AND [cte_type] = &apos;cohort&apos; THEN [vendors_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;cohort&apos; THEN [vendors_ct] ELSE 0 END)&#10;WHEN &apos;% Vendor Grade AA&apos; THEN SUM(IF [vendor_grade] = &apos;AA&apos; AND [cte_type] = &apos;cohort&apos; THEN [vendors_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;cohort&apos; THEN [vendors_ct] ELSE 0 END)&#10;WHEN &apos;% Vendor Grade A&apos; THEN SUM(IF [vendor_grade] = &apos;A&apos; AND [cte_type] = &apos;cohort&apos; THEN [vendors_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;cohort&apos; THEN [vendors_ct] ELSE 0 END)&#10;WHEN &apos;% Vendor Grade B&apos; THEN SUM(IF [vendor_grade] = &apos;B&apos; AND [cte_type] = &apos;cohort&apos; THEN [vendors_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;cohort&apos; THEN [vendors_ct] ELSE 0 END)&#10;WHEN &apos;% Vendor Grade C&apos; THEN SUM(IF [vendor_grade] = &apos;C&apos; AND [cte_type] = &apos;cohort&apos; THEN [vendors_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;cohort&apos; THEN [vendors_ct] ELSE 0 END)&#10;WHEN &apos;% Vendor Grade D&apos; THEN SUM(IF [vendor_grade] = &apos;D&apos; AND [cte_type] = &apos;cohort&apos; THEN [vendors_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;cohort&apos; THEN [vendors_ct] ELSE 0 END)&#10;WHEN &apos;% Vendor Grade NA&apos; THEN SUM(IF [vendor_grade] = &apos;NA&apos; AND [cte_type] = &apos;cohort&apos; THEN [vendors_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;cohort&apos; THEN [vendors_ct] ELSE 0 END)&#10;END' />
            </column>
            <column caption='Metric value of All Vendors in Period' datatype='real' name='[Calculation_2039075110153412611]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Date Granularity (copy)] &#10;WHEN &apos;# Orders&apos; THEN SUM(IF [cte_type] = &apos;order&apos; THEN [orders_ct] ELSE 0 END)&#10;WHEN &apos;# Vendors with Orders&apos; THEN SUM(IF [cte_type] = &apos;order&apos; THEN [vendors_with_orders_ct] ELSE 0 END)&#10;WHEN &apos;# OD Orders&apos; THEN SUM(IF [cte_type] = &apos;order&apos; THEN [od_orders_ct] ELSE 0 END)&#10;WHEN &apos;# POS Orders&apos; THEN SUM(IF [cte_type] = &apos;order&apos; THEN [pos_orders_ct] ELSE 0 END)&#10;WHEN &apos;% Fail Rate&apos; THEN SUM(IF [cte_type] = &apos;order&apos; THEN [fail_orders_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;order&apos; THEN [orders_ct] ELSE 0 END)&#10;WHEN &apos;  % Vendor Fail Rate&apos; THEN SUM(IF [cte_type] = &apos;order&apos; THEN [fail_orders_vendor_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;order&apos; THEN [orders_ct] ELSE 0 END)&#10;WHEN &apos;# GoWin Orders&apos; THEN SUM(IF [cte_type] = &apos;order&apos; THEN [gowin_orders_ct] ELSE 0 END)&#10;WHEN &apos;# GoWeb Orders&apos; THEN SUM(IF [cte_type] = &apos;order&apos; THEN [goweb_orders_ct] ELSE 0 END)&#10;WHEN &apos;# GoDroid Orders&apos; THEN SUM(IF [cte_type] = &apos;order&apos; THEN [godroid_orders_ct] ELSE 0 END)&#10;WHEN &apos;# GoWin Vendors&apos; THEN SUM(IF [cte_type] = &apos;order&apos; THEN [vendor_gowin_ct] ELSE 0 END)&#10;WHEN &apos;# GoWeb Vendors&apos; THEN SUM(IF [cte_type] = &apos;order&apos; THEN [vendor_goweb_ct] ELSE 0 END)&#10;WHEN &apos;# GoDroid Vendors&apos; THEN SUM(IF [cte_type] = &apos;order&apos; THEN [vendor_godroid_ct] ELSE 0 END)&#10;WHEN &apos;    % GoDroid Vendors&apos; THEN SUM(IF [cte_type] = &apos;order&apos; THEN [vendor_godroid_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;order&apos; THEN [vendors_with_orders_ct] ELSE 0 END)&#10;WHEN &apos;    % GoWeb Vendors&apos; THEN SUM(IF [cte_type] = &apos;order&apos; THEN [vendor_goweb_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;order&apos; THEN [vendors_with_orders_ct] ELSE 0 END)&#10;WHEN &apos;    % GoWin Vendors&apos; THEN SUM(IF [cte_type] = &apos;order&apos; THEN [vendor_gowin_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;order&apos; THEN [vendors_with_orders_ct] ELSE 0 END)&#10;WHEN &apos;    % Item Unavailable FR&apos; THEN SUM(IF [cte_type] = &apos;order&apos; THEN [fail_orders_item_unavailable_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;order&apos; THEN [orders_ct] ELSE 0 END)&#10;WHEN &apos;    % Unreachable FR&apos; THEN SUM(IF [cte_type] = &apos;order&apos; THEN [fail_orders_unreachable_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;order&apos; THEN [orders_ct] ELSE 0 END)&#10;WHEN &apos;    % No Response FR&apos; THEN SUM(IF [cte_type] = &apos;order&apos; THEN [fail_orders_no_response_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;order&apos; THEN [orders_ct] ELSE 0 END)&#10;WHEN &apos;    % Too Busy FR&apos; THEN SUM(IF [cte_type] = &apos;order&apos; THEN [fail_orders_too_busy_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;order&apos; THEN [orders_ct] ELSE 0 END)&#10;WHEN &apos;    % Closed FR&apos; THEN SUM(IF [cte_type] = &apos;order&apos; THEN [fail_orders_closed_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;order&apos; THEN [orders_ct] ELSE 0 END)&#10;WHEN &apos;% Vendor Grade AAA&apos; THEN SUM(IF [vendor_grade] = &apos;AAA&apos; AND [cte_type] = &apos;order&apos; THEN [vendors_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;order&apos; THEN [vendors_ct] ELSE 0 END)&#10;WHEN &apos;% Vendor Grade AA&apos; THEN SUM(IF [vendor_grade] = &apos;AA&apos; AND [cte_type] = &apos;order&apos; THEN [vendors_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;order&apos; THEN [vendors_ct] ELSE 0 END)&#10;WHEN &apos;% Vendor Grade A&apos; THEN SUM(IF [vendor_grade] = &apos;A&apos; AND [cte_type] = &apos;order&apos; THEN [vendors_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;order&apos; THEN [vendors_ct] ELSE 0 END)&#10;WHEN &apos;% Vendor Grade B&apos; THEN SUM(IF [vendor_grade] = &apos;B&apos; AND [cte_type] = &apos;order&apos; THEN [vendors_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;order&apos; THEN [vendors_ct] ELSE 0 END)&#10;WHEN &apos;% Vendor Grade C&apos; THEN SUM(IF [vendor_grade] = &apos;C&apos; AND [cte_type] = &apos;order&apos; THEN [vendors_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;order&apos; THEN [vendors_ct] ELSE 0 END)&#10;WHEN &apos;% Vendor Grade D&apos; THEN SUM(IF [vendor_grade] = &apos;D&apos; AND [cte_type] = &apos;order&apos; THEN [vendors_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;order&apos; THEN [vendors_ct] ELSE 0 END)&#10;WHEN &apos;% Vendor Grade NA&apos; THEN SUM(IF [vendor_grade] = &apos;NA&apos; AND [cte_type] = &apos;order&apos; THEN [vendors_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;order&apos; THEN [vendors_ct] ELSE 0 END)&#10;END' />
            </column>
            <column caption='_order date metric name' datatype='string' name='[Calculation_2039075110479712262]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Date Granularity (copy)] &#10;WHEN &apos;# Orders&apos; THEN &apos;# All Orders within Period&apos;&#10;WHEN &apos;# Vendors with Orders&apos; THEN &apos;# All Vendors with Orders in Period&apos;&#10;WHEN &apos;# OD Orders&apos; THEN &apos;# All Vendors OD Orders in Period&apos;&#10;WHEN &apos;# POS Orders&apos; THEN &apos;# All Vendors POS Orders in Period&apos;&#10;WHEN &apos;% Fail Rate&apos; THEN &apos;% All Vendors FR in Period&apos;&#10;WHEN &apos;  % Vendor Fail Rate&apos; THEN &apos;% All Vendors vFR in Period&apos;&#10;WHEN &apos;# GoWin Orders&apos; THEN &apos;# All Vendors GoWin Orders in Period&apos;&#10;WHEN &apos;# GoWeb Orders&apos; THEN &apos;# All Vendors GoWeb Orders in Period&apos;&#10;WHEN &apos;# GoDroid Orders&apos; THEN &apos;# All GoDroid Orders in Period&apos;&#10;WHEN &apos;# GoWin Vendors&apos; THEN &apos;# All GoWin Vendors in Period&apos;&#10;WHEN &apos;# GoWeb Vendors&apos; THEN &apos;# All GoWeb Vendors in Period&apos;&#10;WHEN &apos;# GoDroid Vendors&apos; THEN &apos;# All GoDroid Vendors in Period&apos;&#10;//WHEN &apos;% GoDroid Vendors&apos; THEN &apos;% All GoDroid Vendors in Period&apos;&#10;//WHEN &apos;% GoWeb Vendors&apos; THEN &apos;% All GoWeb Vendors in Period&apos;&#10;//WHEN &apos;% GoWin Vendors&apos; THEN &apos;% GoWin Vendors in Period&apos;&#10;WHEN &apos;    % Item Unavailable FR&apos; THEN &apos;% All Vendors Item Unavailable FR in Period&apos;&#10;WHEN &apos;    % Unreachable FR&apos; THEN &apos;% All Vendors Unreachable FR in Period&apos;&#10;WHEN &apos;    % No Response FR&apos; THEN &apos;% All Vendors No Response FR in Period&apos;&#10;WHEN &apos;    % Too Busy FR&apos; THEN &apos;% All Vendors Too Busy FR in Period&apos;&#10;WHEN &apos;    % Closed FR&apos; THEN &apos;% All Vendors Closed FR in Period&apos;&#10;WHEN &apos;% Vendor Grade AAA&apos; THEN &apos;% All Vendor Grade AAA in Period&apos;&#10;WHEN &apos;% Vendor Grade AA&apos; THEN &apos;% All Vendor Grade AA in Period&apos;&#10;WHEN &apos;% Vendor Grade A&apos; THEN &apos;% All Vendor Grade A in Period&apos;&#10;WHEN &apos;% Vendor Grade B&apos; THEN &apos;% All Vendor Grade B in Period&apos;&#10;WHEN &apos;% Vendor Grade C&apos; THEN &apos;% All Vendor Grade C in Period&apos;&#10;WHEN &apos;% Vendor Grade D&apos; THEN &apos;% All Vendor Grade D in Period&apos;&#10;WHEN &apos;% Vendor Grade NA&apos; THEN &apos;% All Vendor Grade NA in Period&apos;&#10;END' />
            </column>
            <column caption='(1)/(2)' datatype='real' name='[Calculation_3912009606838784000]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Date Granularity (copy)] &#10;WHEN &apos;# Orders&apos; THEN [Calculation_2039075110144020482]/[Calculation_2039075110153412611] &#10;WHEN &apos;# Vendors with Orders&apos; THEN [Calculation_2039075110144020482]/[Calculation_2039075110153412611] &#10;WHEN &apos;# OD Orders&apos; THEN [Calculation_2039075110144020482]/[Calculation_2039075110153412611] &#10;WHEN &apos;# POS Orders&apos; THEN [Calculation_2039075110144020482]/[Calculation_2039075110153412611] &#10;WHEN &apos;# GoWin Orders&apos; THEN [Calculation_2039075110144020482]/[Calculation_2039075110153412611] &#10;WHEN &apos;# GoWeb Orders&apos; THEN [Calculation_2039075110144020482]/[Calculation_2039075110153412611] &#10;WHEN &apos;# GoDroid Orders&apos; THEN [Calculation_2039075110144020482]/[Calculation_2039075110153412611] &#10;WHEN &apos;# GoWin Vendors&apos; THEN [Calculation_2039075110144020482]/[Calculation_2039075110153412611] &#10;WHEN &apos;# GoWeb Vendors&apos; THEN [Calculation_2039075110144020482]/[Calculation_2039075110153412611] &#10;WHEN &apos;# GoDroid Vendors&apos; THEN [Calculation_2039075110144020482]/[Calculation_2039075110153412611] &#10;WHEN &apos;% Vendor Grade AAA&apos; THEN SUM(IF [vendor_grade] = &apos;AAA&apos; AND [cte_type] = &apos;cohort&apos; THEN [vendors_ct] ELSE 0 END)/SUM(IF [vendor_grade] = &apos;AAA&apos; AND [cte_type] = &apos;order&apos; THEN [vendors_ct] ELSE 0 END)&#10;WHEN &apos;% Vendor Grade AA&apos; THEN SUM(IF [vendor_grade] = &apos;AA&apos; AND [cte_type] = &apos;cohort&apos; THEN [vendors_ct] ELSE 0 END)/SUM(IF [vendor_grade] = &apos;AA&apos; AND [cte_type] = &apos;order&apos; THEN [vendors_ct] ELSE 0 END)&#10;WHEN &apos;% Vendor Grade A&apos; THEN SUM(IF [vendor_grade] = &apos;A&apos; AND [cte_type] = &apos;cohort&apos; THEN [vendors_ct] ELSE 0 END)/SUM(IF [vendor_grade] = &apos;A&apos; AND [cte_type] = &apos;order&apos; THEN [vendors_ct] ELSE 0 END)&#10;WHEN &apos;% Vendor Grade B&apos; THEN SUM(IF [vendor_grade] = &apos;B&apos; AND [cte_type] = &apos;cohort&apos; THEN [vendors_ct] ELSE 0 END)/SUM(IF [vendor_grade] = &apos;B&apos; AND [cte_type] = &apos;order&apos; THEN [vendors_ct] ELSE 0 END)&#10;WHEN &apos;% Vendor Grade C&apos; THEN SUM(IF [vendor_grade] = &apos;C&apos; AND [cte_type] = &apos;cohort&apos; THEN [vendors_ct] ELSE 0 END)/SUM(IF [vendor_grade] = &apos;C&apos; AND [cte_type] = &apos;order&apos; THEN [vendors_ct] ELSE 0 END)&#10;WHEN &apos;% Vendor Grade D&apos; THEN SUM(IF [vendor_grade] = &apos;D&apos; AND [cte_type] = &apos;cohort&apos; THEN [vendors_ct] ELSE 0 END)/SUM(IF [vendor_grade] = &apos;D&apos; AND [cte_type] = &apos;order&apos; THEN [vendors_ct] ELSE 0 END)&#10;WHEN &apos;% Vendor Grade NA&apos; THEN SUM(IF [vendor_grade] = &apos;NA&apos; AND [cte_type] = &apos;cohort&apos; THEN [vendors_ct] ELSE 0 END)/SUM(IF [vendor_grade] = &apos;NA&apos; AND [cte_type] = &apos;order&apos; THEN [vendors_ct] ELSE 0 END)&#10;END' />
            </column>
            <column caption='Comparative Name' datatype='string' name='[Calculation_3912009606880550913]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Date Granularity (copy)] &#10;WHEN &apos;# Orders&apos; THEN &apos;% Cohort contribution to All Vendors&apos;&#10;WHEN &apos;# Vendors with Orders&apos; THEN &apos;% Cohort contribution to All Vendors&apos;&#10;WHEN &apos;# OD Orders&apos; THEN &apos;% Cohort contribution to All OD Orders&apos;&#10;WHEN &apos;# POS Orders&apos; THEN &apos;% Cohort contribution to All POS Orders&apos;&#10;WHEN &apos;# GoWin Orders&apos; THEN &apos;% Cohort contribution to All GoWin Orders&apos;&#10;WHEN &apos;# GoWeb Orders&apos; THEN &apos;% Cohort contribution to All GoWeb Orders&apos;&#10;WHEN &apos;# GoDroid Orders&apos; THEN &apos;% Cohort contribution to All GoDroid Orders&apos;&#10;WHEN &apos;# GoWin Vendors&apos; THEN &apos;% Cohort contribution to All GoWin Vendors in Period&apos; &#10;WHEN &apos;# GoWeb Vendors&apos; THEN &apos;% Cohort contribution to All GoWeb Vendors in Period&apos; &#10;WHEN &apos;# GoDroid Vendors&apos; THEN &apos;% Cohort contribution to All GoDroid Vendors in Period&apos;&#10;WHEN &apos;% Vendor Grade AAA&apos; THEN &apos;% Cohort contribution to All AAA Vendor Grade in Period&apos;&#10;WHEN &apos;% Vendor Grade AA&apos; THEN &apos;% Cohort contribution to All AA Vendor Grade in Period&apos;&#10;WHEN &apos;% Vendor Grade A&apos; THEN &apos;% Cohort contribution to All A Vendor Grade in Period&apos;&#10;WHEN &apos;% Vendor Grade B&apos; THEN &apos;% Cohort contribution to All B Vendor Grade in Period&apos;&#10;WHEN &apos;% Vendor Grade C&apos; THEN &apos;% Cohort contribution to All C Vendor Grade in Period&apos;&#10;WHEN &apos;% Vendor Grade D&apos; THEN &apos;% Cohort contribution to All D Vendor Grade in Period&apos;&#10;WHEN &apos;% Vendor Grade NA&apos; THEN &apos;% Cohort contribution to All NA Vendor Grade in Period&apos;&#10;END' />
            </column>
            <column caption='_is_filter' datatype='integer' name='[Calculation_3912009606884573186]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Date Granularity (copy)]&#10;WHEN &apos;# Vendors with Orders&apos; THEN 1&#10;WHEN &apos;# Orders&apos; THEN 1&#10;WHEN &apos;# OD Orders&apos; THEN 1&#10;WHEN &apos;# POS Orders&apos; THEN 1&#10;WHEN &apos;# GoWin Orders&apos; THEN 1&#10;WHEN &apos;# GoWeb Orders&apos; THEN 1&#10;WHEN &apos;# GoDroid Orders&apos; THEN 1&#10;WHEN &apos;# GoWin Vendors&apos; THEN 1&#10;WHEN &apos;# GoWeb Vendors&apos; THEN 1&#10;WHEN &apos;# GoDroid Vendors&apos; THEN 1&#10;WHEN &apos;% Vendors with Orders&apos; THEN 2&#10;WHEN &apos;% GoDroid Vendors&apos; THEN 2&#10;WHEN &apos;% GoWeb Vendors&apos; THEN 2&#10;WHEN &apos;% GoWin Vendors&apos; THEN 2&#10;WHEN &apos;% Vendor Grade AAA&apos; THEN 2&#10;WHEN &apos;% Vendor Grade AA&apos; THEN 2&#10;WHEN &apos;% Vendor Grade A&apos; THEN 2&#10;WHEN &apos;% Vendor Grade B&apos; THEN 2&#10;WHEN &apos;% Vendor Grade C&apos; THEN 2&#10;WHEN &apos;% Vendor Grade D&apos; THEN 2&#10;WHEN &apos;% Vendor Grade NA&apos; THEN 2&#10;WHEN &apos;Cohort Size&apos; THEN 3&#10;WHEN &apos;% Fail Rate&apos; THEN 4&#10;WHEN &apos;  % Vendor Fail Rate&apos; THEN 4&#10;WHEN &apos;    % Item Unavailable FR&apos; THEN 4&#10;WHEN &apos;    % Unreachable FR&apos; THEN 4&#10;WHEN &apos;    % No Response FR&apos; THEN 4&#10;WHEN &apos;    % Too Busy FR&apos; THEN 4&#10;WHEN &apos;    % Closed FR&apos; THEN 4&#10;ELSE NULL&#10;END' />
