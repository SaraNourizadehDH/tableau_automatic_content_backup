    <worksheet name='Order Cohort - Cohort Size'>
      <table>
        <view>
          <datasources>
            <datasource caption='vendor_order_cohort_dashboard_20230327 (van)' name='federated.0piybiq0x006wi126uigh0ie67gu' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Metric' datatype='string' name='[Date Granularity (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;Cohort Size&quot;'>
              <calculation class='tableau' formula='&quot;Cohort Size&quot;' />
            </column>
            <column caption='Dimension (B)' datatype='string' name='[Dimension (A) (copy)_1165939739784396800]' param-domain-type='list' role='measure' type='nominal' value='&quot;(All)&quot;'>
              <calculation class='tableau' formula='&quot;(All)&quot;' />
            </column>
            <column caption='Dimension (A)' datatype='string' name='[Metric (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;(All)&quot;'>
              <calculation class='tableau' formula='&quot;(All)&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0piybiq0x006wi126uigh0ie67gu'>
            <column caption='Cohort Size' datatype='integer' name='[Calculation_2039075110154764292]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [time_period] = 0 THEN [vendors_ct] ELSE 0 END)' />
            </column>
            <column caption='Dimension (A)' datatype='string' name='[Calculation_2360941744907505688]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Metric (copy)] = &apos;(All)&apos; THEN &apos;(All)&apos;&#10;ELSEIF [Parameters].[Metric (copy)] = &apos;Region&apos; THEN [region]&#10;ELSEIF [Parameters].[Metric (copy)] = &apos;Brand Name&apos; THEN [brand_name]&#10;ELSEIF [Parameters].[Metric (copy)] = &apos;Country&apos; THEN [country_name]&#10;ELSEIF [Parameters].[Metric (copy)] = &apos;Is Self Activated&apos; THEN STR([is_self_activated])&#10;ELSEIF [Parameters].[Metric (copy)] = &apos;Vendor Grade&apos; THEN [vendor_grade]&#10;ELSEIF [Parameters].[Metric (copy)] = &apos;Vertical Food&apos; THEN [first_vertical_type]&#10;ELSEIF [Parameters].[Metric (copy)] = &apos;Transmission Type&apos; THEN [transmission_type]&#10;END' />
            </column>
            <column caption='_is_filter' datatype='integer' name='[Calculation_2360941744957775899]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Date Granularity (copy)]&#10;WHEN &apos;# Vendors with Orders&apos; THEN 1&#10;WHEN &apos;# Orders&apos; THEN 1&#10;WHEN &apos;# OD Orders&apos; THEN 1&#10;WHEN &apos;# POS Orders&apos; THEN 1&#10;WHEN &apos;# GoWin Orders&apos; THEN 1&#10;WHEN &apos;# GoWeb Orders&apos; THEN 1&#10;WHEN &apos;# GoDroid Orders&apos; THEN 1&#10;WHEN &apos;# GoWin Vendors&apos; THEN 1&#10;WHEN &apos;# GoWeb Vendors&apos; THEN 1&#10;WHEN &apos;# GoDroid Vendors&apos; THEN 1&#10;WHEN &apos;% Vendors with Orders&apos; THEN 2&#10;WHEN &apos;% GoDroid Vendors&apos; THEN 2&#10;WHEN &apos;% GoWeb Vendors&apos; THEN 2&#10;WHEN &apos;% GoWin Vendors&apos; THEN 2&#10;WHEN &apos;% Vendor Grade AAA&apos; THEN 2&#10;WHEN &apos;% Vendor Grade AA&apos; THEN 2&#10;WHEN &apos;% Vendor Grade A&apos; THEN 2&#10;WHEN &apos;% Vendor Grade B&apos; THEN 2&#10;WHEN &apos;% Vendor Grade C&apos; THEN 2&#10;WHEN &apos;% Vendor Grade D&apos; THEN 2&#10;WHEN &apos;% Vendor Grade NA&apos; THEN 2&#10;WHEN &apos;Cohort Size&apos; THEN 3&#10;WHEN &apos;% Fail Rate&apos; THEN 4&#10;WHEN &apos;  % Vendor Fail Rate&apos; THEN 4&#10;WHEN &apos;    % Item Unavailable FR&apos; THEN 4&#10;WHEN &apos;    % Unreachable FR&apos; THEN 4&#10;WHEN &apos;    % No Response FR&apos; THEN 4&#10;WHEN &apos;    % Too Busy FR&apos; THEN 4&#10;WHEN &apos;    % Closed FR&apos; THEN 4&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Dimension (B)' datatype='string' name='[Calculation_3501126516723589120]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Dimension (A) (copy)_1165939739784396800] = &apos;(All)&apos; THEN &apos;(All)&apos;&#10;ELSEIF [Parameters].[Dimension (A) (copy)_1165939739784396800] = &apos;Region&apos; THEN [region]&#10;ELSEIF [Parameters].[Dimension (A) (copy)_1165939739784396800] = &apos;Brand Name&apos; THEN [brand_name]&#10;ELSEIF [Parameters].[Dimension (A) (copy)_1165939739784396800] = &apos;Country&apos; THEN [country_name]&#10;ELSEIF [Parameters].[Dimension (A) (copy)_1165939739784396800] = &apos;Is Self Activated&apos; THEN STR([is_self_activated])&#10;ELSEIF [Parameters].[Dimension (A) (copy)_1165939739784396800] = &apos;Vendor Grade&apos; THEN [vendor_grade]&#10;ELSEIF [Parameters].[Dimension (A) (copy)_1165939739784396800] = &apos;Vertical Food&apos; THEN [first_vertical_type]&#10;ELSEIF [Parameters].[Dimension (A) (copy)_1165939739784396800] = &apos;Transmission Type&apos; THEN [transmission_type]&#10;END' />
            </column>
