            </column>
            <column caption='average_orders Parameter 3' datatype='integer' name='[average_orders Parameter (copy)_1451777572766961692]' param-domain-type='range' role='measure' type='quantitative' value='600'>
              <calculation class='tableau' formula='600' />
              <range granularity='50' max='5000' min='0' />
            </column>
            <column caption='average_orders Parameter 2' datatype='integer' datatype-customized='true' name='[average_orders Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='1200'>
