      <column aggregation='None' caption='AOV_test (bin)' datatype='integer' name='[AOV_test (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='0' formula='[AOV_test]' peg='0' size='1' />
      </column>
      <column datatype='real' name='[AOV_test]' role='measure' type='quantitative' />
      <column caption='CVR_Flag' datatype='boolean' name='[Area_Flag (copy)_1451777572762943514]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [CVR]&gt;= [Parameters].[CVR Parameter]/100 THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Min_Area_Flag (Lead)' datatype='boolean' name='[Area_Flag (copy)_6048967634495754247]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [min_distance_corrected]&gt;= [Parameters].[Min Distance Parameter (copy)_6048967634495328261] THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Average Orders brand' datatype='real' name='[Average Orders (copy)_1451777571337564174]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([average_orders])/SUM([vendor_count])' />
      </column>
      <column datatype='real' name='[CVR]' role='measure' type='quantitative' />
      <column caption='Orders_Flag 1' datatype='boolean' name='[CVR_Flag (copy)_1451777572764258331]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [average_orders]&gt;= [Parameters].[average_orders Parameter] THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Area_Flag' datatype='boolean' name='[Calculation_1451777569337782277]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [min_distance_corrected]&lt;= [Parameters].[Min Distance Parameter] THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='CVR' datatype='real' name='[Calculation_1451777569685168137]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([transactions])/sum([menu])' />
      </column>
      <column caption='rating' datatype='real' name='[Calculation_1451777569884344331]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([converted_rating_total])/SUM([rated_order_count]))*5' />
      </column>
      <column caption='total_count' datatype='real' name='[Calculation_1451777572518854674]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([AOV_test])/3' />
      </column>
      <column caption='TEST' datatype='integer' name='[Calculation_1451777572519215124]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Lead Type' datatype='string' name='[Calculation_1451777572769484833]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [city_flag] and [Area_Flag (copy)_1451777572762943514] and [CVR_Flag (copy)_1451777572764258331] THEN &apos;City Brands&apos;&#10;ELSE IF [city_flag]=FALSE and [Orders_Flag 1 (copy)_1451777572769255456] and [Orders_Flag (copy)_1451777572768874525] THEN &apos;Country Brands&apos;&#10;ELSE IF [Orders_Flag 1 (copy)_1451777572769116191] and [Orders_Flag 2 (copy)_1451777572769017886] and [city_flag] THEN &apos;Rising Stars&apos;&#10;END END END' />
      </column>
      <column caption='Reorder Rate' datatype='real' name='[Calculation_1451777572780957730]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([customer_reorders_same_restaurant_30_ft])/SUM([ft_customers])' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_1451777573827678243]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]=USERNAME()' />
      </column>
      <column caption='Brand Count' datatype='integer' name='[Calculation_1451777574181666852]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([brand])' />
      </column>
      <column caption='Cuisine Count' datatype='integer' name='[Calculation_3517874272778899456]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([main_category_name])' />
      </column>
      <column caption='Index' datatype='integer' name='[Calculation_3517874272780914689]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='Index()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Category' datatype='boolean' name='[Calculation_383439322743005184]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='NULL' />
      </column>
      <column caption='month' datatype='string' name='[Calculation_6048967633176788992]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;month&apos;, DATEADD(&apos;month&apos;,-2,TODAY())) + &apos;-&apos; + STR(YEAR(TODAY()))' />
      </column>
      <column aggregation='None' caption='Converted Rating Total (bin)' datatype='integer' name='[Converted Rating Total (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='-1' formula='[converted_rating_total]' peg='0' size='0.2' />
      </column>
      <column caption='Lead Rating' datatype='real' name='[Converted Rating Total (copy)_6048967633826103300]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([converted_rating_total]*[rated_order_count])/SUM([rated_order_count])' />
      </column>
      <column caption='Max_Area_Flag (Lead)' datatype='boolean' name='[Min_Area_Flag (Lead) (copy)_6048967634498015240]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [min_distance_corrected]&lt;= [Parameters].[Min Distance Parameter (Lead) (copy)_6048967634495463430] THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Orders_Flag 2' datatype='boolean' name='[Orders_Flag (copy)_1451777572768874525]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [average_orders]&gt;= [Parameters].[average_orders Parameter 2] THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='CMGR Flag' datatype='boolean' name='[Orders_Flag 1 (copy)_1451777572769116191]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [brand_cmgr_3m]&gt;= [Parameters].[brand_cmgr_3m Parameter]/100 THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Vendor Count Flag' datatype='boolean' name='[Orders_Flag 1 (copy)_1451777572769255456]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [vendor_count]&gt;= [Parameters].[Vendor Count Parameter] THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Orders_Flag 3' datatype='boolean' name='[Orders_Flag 2 (copy)_1451777572769017886]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [average_orders]&gt;= [Parameters].[average_orders Parameter (copy)_1451777572766961692] THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Lead Category' datatype='string' name='[Rated Order Count (copy)_6048967633797955587]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [rated_order_count]&gt;=[Parameters].[average_orders Parameter (copy)_6048967633795227650] AND [converted_rating_total]&gt;=[Parameters].[Converted Rating Total Parameter]&#10;AND [min_distance_corrected]&gt;=[Parameters].[Min Distance Parameter (copy)_6048967634495328261] AND [min_distance_corrected]&lt;=[Parameters].[Min Distance Parameter (Lead) (copy)_6048967634495463430]&#10;AND [selection_group]=&apos;Lead&apos; THEN &apos;Select&apos;&#10;ELSE NULL END' />
      </column>
