              <calculation class='tableau' formula='IF [average_orders]&gt;= [Parameters].[average_orders Parameter 2] THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='CMGR Flag' datatype='boolean' name='[Orders_Flag 1 (copy)_1451777572769116191]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [brand_cmgr_3m]&gt;= [Parameters].[brand_cmgr_3m Parameter]/100 THEN TRUE ELSE FALSE END' />
