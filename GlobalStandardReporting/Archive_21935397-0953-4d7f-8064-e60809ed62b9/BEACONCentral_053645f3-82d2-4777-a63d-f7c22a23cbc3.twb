                <zone forceUpdate='true' h='1200' id='1077' type-v2='text' w='99000' x='500' y='21133'>
                  <formatted-text>
                    <run fontsize='8'>*CMGR stands for </run>
                    <run bold='true' fontcolor='#555555' fontsize='8'>Compounded Monthly Growth Rate (CMGR)</run>
                    <run fontcolor='#555555' fontname='Montserrat,sans-serif' fontsize='8'>Æ </run>
                    <run fontsize='8'>and the formula for</run>
                    <run fontname='Montserrat,sans-serif' fontsize='8'>Æ </run>
                    <run bold='true' fontsize='8'>CMGR</run>
                    <run bold='true' fontcolor='#404040' fontsize='8'> = </run>
                    <run bold='true' fontsize='8'>(Latest Month/ First Month)^(1/# of Months) -1</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
