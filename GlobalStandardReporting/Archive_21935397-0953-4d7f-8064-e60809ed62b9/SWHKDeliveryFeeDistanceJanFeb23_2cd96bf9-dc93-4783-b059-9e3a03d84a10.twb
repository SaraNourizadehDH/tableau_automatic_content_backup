            </expression>
          </clause>
          <relation connection='bigquery.1cnwdf819y4bk21946s951fwopnx' name='tableau_user_entitlement' table='[fulfillment-dwh-production.rl_gfs].[tableau_user_entitlement]' type='table' />
          <relation connection='bigquery.1cnwdf819y4bk21946s951fwopnx' name='Custom SQL Query' type='text'>WITH pre AS (
  SELECT o.global_entity_id,
  DATE(placed_at_local) as report_date,
  value.delivery_fee_local,
  ROUND(lo.delivery_distance/ 1000, 0) distance_bin,
  COUNT(*) as cnt,
  FROM `fulfillment-dwh-production.cl_gfs.gfs_incremental_central_orders` o
  JOIN `fulfillment-dwh-production.cl_gfs.gfs_incremental_log_orders` lo 
  on o.vendor_id = lo.vendor_code
  and o.global_entity_id = lo.entity.id
  and o.order_id = lo.order_code
  join `fulfillment-dwh-production.dbt_cl_gfs.vendors` v 
  on  (
    o.global_entity_id = v.global_entity_id
    AND o.vendor_id = v.vendor_id)
  WHERE DATE(placed_at_local) &gt;&gt; &quot;2023-01-01&quot; 
  and kitchen_group = &apos;swhk&apos;
  and is_sent
  group by 1,2, 3,4
  order by 2 desc, 5
)
SELECT *, pre.cnt/ SUM(pre.cnt) OVER( PARTITION BY global_entity_id, report_date) as share
FROM pre
order by 1, 2 DESC, 5 DESC</relation>
