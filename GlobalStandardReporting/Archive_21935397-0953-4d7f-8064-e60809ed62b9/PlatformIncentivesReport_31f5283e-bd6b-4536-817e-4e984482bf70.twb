      </column>
      <column caption='CVR' datatype='real' name='[Calculation_2182556992446930946]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([transactions])/SUM([menu])' />
      </column>
      <column caption='MenuK' datatype='real' name='[Calculation_2182556992447692804]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([menu])/1000' />
      </column>
      <column caption='Order Count 7 days' datatype='real' name='[Calculation_2182556992460103689]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_SUM(SUM(total_order_count), -6,0)/ 7'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='MenuK 7 days' datatype='real' name='[Calculation_2182556992460816396]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(WINDOW_SUM(SUM([menu]), -6,0)/ WINDOW_COUNT(COUNT([menu]), -6,0))/1000'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Subsidised Orders % ' datatype='real' name='[Calculation_3204100074612887557]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([subsidised_orders]) / SUM([total_order_count])' />
      </column>
      <column caption='Subsidies (% of Total GBV)' datatype='real' name='[Calculation_3204100074613624838]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([total voucher (copy)_3897372929481850896]+[Calculation_3897372929481752591])/SUM([gbv_eur])' />
      </column>
      <column caption='total subsidies' datatype='real' name='[Calculation_3897372928526221313]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[total voucher (copy)_3897372929481850896]+[Calculation_3897372929481752591]' />
      </column>
      <column caption='GFS_FLAG' datatype='string' name='[Calculation_3897372928539926530]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [brand_owner]&#10;WHEN &apos;gen1&apos; THEN &apos;Kitchens&apos; &#10;WHEN &apos;gen2&apos; THEN &apos;Kitchens&apos;&#10;ELSE [brand_owner] END' />
      </column>
      <column caption='Month' datatype='string' name='[Calculation_3897372929131278344]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;month&apos;,[reporting_date])' />
      </column>
      <column caption='total voucher' datatype='real' name='[Calculation_3897372929481752591]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([voucher_dh_eur]) + SUM([voucher_other_eur])' />
      </column>
      <column caption='suffix' datatype='string' name='[Calculation_3897372929494286354]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[brand_owner Parameter]&#10;when &apos;Total Subsidies&apos; THEN &apos;€&apos; &#10;when &apos;Subsidies (% of Total GBV)&apos; THEN &apos;%&apos;&#10;when &apos;Subsidies (% of Total Orders)&apos; THEN &apos;%&apos;&#10;END' />
      </column>
      <column caption='Measure 1' datatype='real' name='[Calculation_3897372929790001184]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter (copy)_3897372929787957278]&#10;WHEN &apos;Total Subsidies&apos; THEN [Calculation_3897372928526221313]&#10;WHEN &apos;Subsidies (% of Total GBV)&apos; THEN ([Calculation_3897372928526221313]/SUM([gbv_eur]))*100&#10;WHEN &apos;Subsidies (% of Total Orders)&apos; THEN (SUM([subsidised_orders])/SUM([total_order_count]))*100&#10;WHEN &apos;DH Subsidies&apos; THEN SUM([discount_dh_eur]+[voucher_dh_eur])&#10;WHEN &apos;Vendor Subsidies&apos; THEN SUM([discount_other_eur]+[voucher_other_eur])&#10;WHEN &apos;Total Orders&apos; THEN SUM([total_order_count])&#10;WHEN &apos;Total Subsidised Orders&apos; THEN SUM([subsidised_orders])&#10;WHEN &apos;Subsidies per Order&apos; THEN [Calculation_3897372928526221313]/SUM([total_order_count])&#10;WHEN &apos;CVR&apos; THEN ([Calculation_2182556992446930946])*100&#10;WHEN &apos;Menu Sessions&apos; THEN SUM([menu])&#10;WHEN &apos;Reorder Rate&apos; THEN ([Calculation_3897372929792749602])*100&#10;WHEN &apos;GBV&apos; Then SUM([gbv_eur])&#10;END' />
      </column>
      <column caption='Reorder Rate' datatype='real' name='[Calculation_3897372929792749602]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([returned_customers_same_vendor_30d_ft])/SUM([new_customer_restaurant])' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_668714223603306496]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='USERNAME()=[username]' />
      </column>
      <column caption='CPA' datatype='real' name='[Calculation_668714223605248001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if  [Customer_fg]=&apos;New&apos; THEN [discount_dh_eur] + [discount_other_eur] + [voucher_dh_eur] + [voucher_other_eur] END )&#10;/&#10;SUM([new_customer_count])' />
      </column>
      <column caption='Concept Breakdown Subsidies(Existing)' datatype='real' name='[Concept Breakdown Subsidies(New) (copy)_3204100066796548097]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[brand_owner Parameter]&#10;&#10;WHEN &apos;Total Subsidies&apos; THEN&#10;SUM(if ([brand_owner]=&apos;Concept&apos; OR [brand_owner]=&apos;HFC&apos;) AND [Customer_fg]=&apos;Existing&apos; THEN [discount_dh_eur] + [discount_other_eur] + [voucher_dh_eur] + [voucher_other_eur] END )&#10;WHEN &apos;Subsidies (% of Total GBV)&apos; THEN &#10;(SUM(if [brand_owner]=&apos;Concept&apos; OR [brand_owner]=&apos;HFC&apos; AND [Customer_fg]=&apos;Existing&apos; THEN [discount_dh_eur] + [discount_other_eur] + [voucher_dh_eur] + [voucher_other_eur] END )&#10;/&#10;SUM( if [brand_owner]=&apos;Concept&apos; OR [brand_owner]=&apos;HFC&apos; AND [Customer_fg]=&apos;Existing&apos; THEN [gbv_eur] END))*100&#10;WHEN &apos;Subsidies (% of Total Orders)&apos; THEN &#10;(SUM(if [brand_owner]=&apos;Concept&apos; OR [brand_owner]=&apos;HFC&apos; AND [Customer_fg]=&apos;Existing&apos; THEN [subsidised_orders] END)&#10;/&#10;SUM([total_order_count]))*100&#10;END' />
      </column>
      <column caption='Concept Breakdown Subsidies(New)' datatype='real' name='[Concept Breakdown Subsidies(discount) (copy)_3204100066796089344]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[brand_owner Parameter]&#10;&#10;WHEN &apos;Total Subsidies&apos; THEN&#10;SUM(if ([brand_owner]=&apos;Concept&apos; OR [brand_owner]=&apos;HFC&apos;) AND [Customer_fg]=&apos;New&apos; THEN [discount_dh_eur] + [discount_other_eur] + [voucher_dh_eur] + [voucher_other_eur] END )&#10;WHEN &apos;Subsidies (% of Total GBV)&apos; THEN &#10;(SUM(if ([brand_owner]=&apos;Concept&apos; OR [brand_owner]=&apos;HFC&apos;) AND [Customer_fg]=&apos;New&apos; THEN [discount_dh_eur] + [discount_other_eur] + [voucher_dh_eur] + [voucher_other_eur] END )&#10;/&#10;SUM( if ([brand_owner]=&apos;Concept&apos; OR [brand_owner]=&apos;HFC&apos;) AND [Customer_fg]=&apos;New&apos; THEN [gbv_eur] END))*100&#10;WHEN &apos;Subsidies (% of Total Orders)&apos; THEN &#10;(SUM(if ([brand_owner]=&apos;Concept&apos; OR [brand_owner]=&apos;HFC&apos;) AND [Customer_fg]=&apos;New&apos; THEN [subsidised_orders] END)&#10;/&#10;SUM([total_order_count]))*100&#10;END' />
      </column>
      <column caption='Country Measure' datatype='real' name='[Concept Breakdown Subsidies(discount) (copy)_3897372929571639319]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[brand_owner Parameter]&#10;&#10;WHEN &apos;Total Subsidies&apos; THEN&#10;SUM([discount_dh_eur] + [discount_other_eur] + [voucher_dh_eur] + [voucher_other_eur])&#10;WHEN &apos;Subsidies (% of Total GBV)&apos; THEN &#10;(SUM([discount_dh_eur] + [discount_other_eur] + [voucher_dh_eur] + [voucher_other_eur])&#10;/&#10;SUM([gbv_eur]))*100&#10;WHEN &apos;Subsidies (% of Total Orders)&apos; THEN &#10;(SUM( subsidised_orders)&#10;/&#10;SUM([total_order_count]))*100&#10;END' />
      </column>
      <column caption='HFC Breakdown Subsidies(discount)' datatype='real' name='[Concept Breakdown Subsidies(discount) (copy)_3897372929588330522]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[brand_owner Parameter]&#10;&#10;WHEN &apos;Total Subsidies&apos; THEN&#10;SUM(if [brand_owner]=&apos;HFC&apos; THEN [discount_dh_eur] + [discount_other_eur] END )&#10;WHEN &apos;Subsidies vs GBV&apos; THEN &#10;(SUM(if [brand_owner]=&apos;HFC&apos; THEN [discount_dh_eur] + [discount_other_eur] END )&#10;/&#10;SUM( if [brand_owner]=&apos;HFC&apos; THEN [gbv_eur] END))*100&#10;WHEN &apos;Subsidies vs Orders&apos; THEN &#10;(SUM(if [brand_owner]=&apos;HFC&apos; THEN [discount_orders_count] END)&#10;/&#10;SUM([total_order_count]))*100&#10;END' />
      </column>
      <column caption='Concept Breakdown Subsidies(discount)' datatype='real' name='[Concept Breakdown Subsidies(voucher) (copy)_3897372929562419220]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[brand_owner Parameter]&#10;&#10;WHEN &apos;Total Subsidies&apos; THEN&#10;SUM(if [brand_owner]=&apos;Concept&apos; OR [brand_owner]=&apos;HFC&apos;THEN [discount_dh_eur] + [discount_other_eur] END )&#10;WHEN &apos;Subsidies (% of Total GBV)&apos; THEN &#10;(SUM(if [brand_owner]=&apos;Concept&apos; OR [brand_owner]=&apos;HFC&apos; THEN [discount_dh_eur] + [discount_other_eur] END )&#10;/&#10;SUM( if [brand_owner]=&apos;Concept&apos; OR [brand_owner]=&apos;HFC&apos; THEN [gbv_eur] END))*100&#10;WHEN &apos;Subsidies (% of Total Orders)&apos; THEN &#10;(SUM(if [brand_owner]=&apos;Concept&apos; OR [brand_owner]=&apos;HFC&apos; THEN [discount_orders_count] END)&#10;/&#10;SUM([total_order_count]))*100&#10;END' />
      </column>
      <column caption='HFC Breakdown Subsidies(voucher)' datatype='real' name='[Concept Breakdown Subsidies(voucher) (copy)_3897372929588490267]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[brand_owner Parameter]&#10;&#10;WHEN &apos;Total Subsidies&apos; THEN&#10;SUM(if [brand_owner]=&apos;HFC&apos; THEN [voucher_dh_eur] + [voucher_other_eur] END )&#10;WHEN &apos;Subsidies vs GBV&apos; THEN &#10;(SUM(if [brand_owner]=&apos;HFC&apos; THEN [voucher_dh_eur] + [voucher_other_eur]  END )&#10;/&#10;SUM( if [brand_owner]=&apos;HFC&apos; THEN [gbv_eur] END))*100&#10;WHEN &apos;Subsidies vs Orders&apos; THEN &#10;(SUM(if [brand_owner]=&apos;HFC&apos; THEN [voucher_orders_count] END)&#10;/&#10;SUM([total_order_count]))*100&#10;END' />
      </column>
      <column caption='Concept Breakdown Subsidies(voucher)' datatype='real' name='[Concept Measure Subsidies (copy)_3897372929561903123]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[brand_owner Parameter]&#10;&#10;WHEN &apos;Total Subsidies&apos; THEN&#10;SUM(if [brand_owner]=&apos;Concept&apos; OR [brand_owner]=&apos;HFC&apos; THEN [voucher_dh_eur] + [voucher_other_eur] END )&#10;WHEN &apos;Subsidies (% of Total GBV)&apos; THEN &#10;(SUM(if [brand_owner]=&apos;Concept&apos; OR [brand_owner]=&apos;HFC&apos;THEN [voucher_dh_eur] + [voucher_other_eur]  END )&#10;/&#10;SUM( if [brand_owner]=&apos;Concept&apos; OR [brand_owner]=&apos;HFC&apos; THEN [gbv_eur] END))*100&#10;WHEN &apos;Subsidies (% of Total Orders)&apos; THEN &#10;(SUM(if [brand_owner]=&apos;Concept&apos; OR [brand_owner]=&apos;HFC&apos; THEN [voucher_orders_count] END)&#10;/&#10;SUM([total_order_count]))*100&#10;END' />
      </column>
      <column caption='HFC Measure Subsidies' datatype='real' name='[Concept Measure Subsidies (copy)_3897372929586012184]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[brand_owner Parameter]&#10;&#10;WHEN &apos;Total Subsidies&apos; THEN&#10;SUM(if [brand_owner]=&apos;HFC&apos; THEN [discount_dh_eur] + [discount_other_eur] + [voucher_dh_eur] + [voucher_other_eur] END )&#10;WHEN &apos;Subsidies vs GBV&apos; THEN &#10;(SUM(if [brand_owner]=&apos;HFC&apos; THEN [discount_dh_eur] + [discount_other_eur] + [voucher_dh_eur] + [voucher_other_eur] END )&#10;/&#10;SUM( if [brand_owner]=&apos;HFC&apos; THEN [gbv_eur] END))*100&#10;WHEN &apos;Subsidies vs Orders&apos; THEN &#10;(SUM(if [brand_owner]=&apos;HFC&apos; THEN subsidised_orders END)&#10;/&#10;SUM([total_order_count]))*100&#10;END' />
      </column>
      <column caption='Country Measure (copy)' datatype='real' name='[Country Measure (copy)_3204100073470156804]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[brand_owner Parameter]&#10;&#10;WHEN &apos;Total Subsidies&apos; THEN&#10;SUM([discount_dh_eur] + [discount_other_eur] + [voucher_dh_eur] + [voucher_other_eur])&#10;WHEN &apos;Subsidies (% of Total GBV)&apos; THEN &#10;(SUM([discount_dh_eur] + [discount_other_eur] + [voucher_dh_eur] + [voucher_other_eur])&#10;/&#10;SUM([gbv_eur]))*100&#10;WHEN &apos;Subsidies (% of Total Orders)&apos; THEN &#10;(SUM( subsidised_orders)&#10;/&#10;SUM([total_order_count]))*100&#10;END' />
      </column>
