            <column caption='Kitchen Measure Subsidies' datatype='real' name='[HFC Measure Subsidies (copy)_3897372929587011609]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[brand_owner Parameter]&#10;&#10;WHEN &apos;Total Subsidies&apos; THEN&#10;SUM(if ([brand_owner]&lt;&gt;&apos;HFC&apos; AND [brand_owner]&lt;&gt;&apos;Concept&apos;) THEN [discount_dh_eur] + [discount_other_eur] + [voucher_dh_eur] + [voucher_other_eur] END )&#10;WHEN &apos;Subsidies (% of Total GBV)&apos; THEN &#10;(SUM(if ([brand_owner]&lt;&gt;&apos;HFC&apos; AND [brand_owner]&lt;&gt;&apos;Concept&apos;)  THEN [discount_dh_eur] + [discount_other_eur] + [voucher_dh_eur] + [voucher_other_eur] END )&#10;/&#10;SUM( if ([brand_owner]&lt;&gt;&apos;HFC&apos; AND [brand_owner]&lt;&gt;&apos;Concept&apos;)  THEN [gbv_eur] END))*100&#10;WHEN &apos;Subsidies (% of Total Orders)&apos; THEN &#10;(SUM(if ([brand_owner]&lt;&gt;&apos;HFC&apos; AND [brand_owner]&lt;&gt;&apos;Concept&apos;)  THEN subsidised_orders END)&#10;/&#10;SUM([total_order_count]))*100&#10;END' />
            </column>
