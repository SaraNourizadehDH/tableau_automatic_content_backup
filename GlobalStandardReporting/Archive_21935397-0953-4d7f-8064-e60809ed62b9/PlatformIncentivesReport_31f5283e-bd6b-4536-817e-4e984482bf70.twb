    <worksheet name='Kitchen by breakdown (2)'>
      <table>
        <view>
          <datasources>
            <datasource caption='marketing_spend (gfs_bi)' name='federated.08d6puo0xyf3861bl3rp60wbvmfh' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Parameter' datatype='string' name='[brand_owner Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Total Subsidies&quot;'>
              <calculation class='tableau' formula='&quot;Total Subsidies&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.08d6puo0xyf3861bl3rp60wbvmfh'>
            <column caption='suffix' datatype='string' name='[Calculation_3897372929494286354]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[brand_owner Parameter]&#10;when &apos;Total Subsidies&apos; THEN &apos;€&apos; &#10;when &apos;Subsidies (% of Total GBV)&apos; THEN &apos;%&apos;&#10;when &apos;Subsidies (% of Total Orders)&apos; THEN &apos;%&apos;&#10;END' />
            </column>
            <column datatype='string' name='[Customer_fg]' role='dimension' type='nominal' />
            <column caption='Kitchen Breakdown Subsidies(existing)' datatype='real' name='[Kitchen Breakdown Subsidies(discount) (copy)_3204100066798567426]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[brand_owner Parameter]&#10;&#10;WHEN &apos;Total Subsidies&apos; THEN&#10;SUM(if ([brand_owner]&lt;&gt;&apos;Concept&apos; AND [brand_owner]&lt;&gt;&apos;HFC&apos;) AND [Customer_fg]=&apos;Existing&apos; THEN [discount_dh_eur] + [discount_other_eur] + [voucher_dh_eur] + [voucher_other_eur] END )&#10;WHEN &apos;Subsidies (% of Total GBV)&apos; THEN &#10;(SUM(if [brand_owner]&lt;&gt;&apos;Concept&apos; AND [brand_owner]&lt;&gt;&apos;HFC&apos; AND [Customer_fg]=&apos;Existing&apos; THEN [discount_dh_eur] + [discount_other_eur] + [voucher_dh_eur] + [voucher_other_eur] END )&#10;/&#10;SUM( if [brand_owner]&lt;&gt;&apos;Concept&apos; AND [brand_owner]&lt;&gt;&apos;HFC&apos; AND [Customer_fg]=&apos;Existing&apos; THEN [gbv_eur] END))*100&#10;WHEN &apos;Subsidies (% of Total Orders)&apos; THEN &#10;(SUM(if [brand_owner]&lt;&gt;&apos;Concept&apos; AND [brand_owner]&lt;&gt;&apos;HFC&apos; AND [Customer_fg]=&apos;Existing&apos; THEN [subsidised_orders] END)&#10;/&#10;SUM([total_order_count]))*100&#10;END' />
            </column>
            <column caption='Kitchen Breakdown Subsidies(new)' datatype='real' name='[Kitchen Breakdown Subsidies(existing) (copy)_3204100066798870531]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[brand_owner Parameter]&#10;&#10;WHEN &apos;Total Subsidies&apos; THEN&#10;SUM(if ([brand_owner]&lt;&gt;&apos;Concept&apos; AND [brand_owner]&lt;&gt;&apos;HFC&apos;) AND [Customer_fg]=&apos;New&apos; THEN [discount_dh_eur] + [discount_other_eur] + [voucher_dh_eur] + [voucher_other_eur] END )&#10;WHEN &apos;Subsidies (% of Total GBV)&apos; THEN &#10;(SUM(if [brand_owner]&lt;&gt;&apos;Concept&apos; AND [brand_owner]&lt;&gt;&apos;HFC&apos; AND [Customer_fg]=&apos;New&apos; THEN [discount_dh_eur] + [discount_other_eur] + [voucher_dh_eur] + [voucher_other_eur] END )&#10;/&#10;SUM( if [brand_owner]&lt;&gt;&apos;Concept&apos; AND [brand_owner]&lt;&gt;&apos;HFC&apos; AND [Customer_fg]=&apos;New&apos; THEN [gbv_eur] END))*100&#10;WHEN &apos;Subsidies (% of Total Orders)&apos; THEN &#10;(SUM(if [brand_owner]&lt;&gt;&apos;Concept&apos; AND [brand_owner]&lt;&gt;&apos;HFC&apos; AND [Customer_fg]=&apos;New&apos; THEN [subsidised_orders] END)&#10;/&#10;SUM([total_order_count]))*100&#10;END' />
