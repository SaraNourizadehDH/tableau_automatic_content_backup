            <column-instance column='[HFC Breakdown Subsidies(discount) (copy)_3897372929589792796]' derivation='User' name='[usr:HFC Breakdown Subsidies(discount) (copy)_3897372929589792796:qk]' pivot='key' type='quantitative' />
            <column-instance column='[HFC Breakdown Subsidies(voucher) (copy)_3897372929590022173]' derivation='User' name='[usr:HFC Breakdown Subsidies(voucher) (copy)_3897372929590022173:qk]' pivot='key' type='quantitative' />
