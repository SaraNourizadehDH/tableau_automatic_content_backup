            <column datatype='real' name='[discount_other_eur]' role='measure' type='quantitative' />
            <column datatype='real' name='[gbv_eur]' role='measure' type='quantitative' />
            <column datatype='string' name='[kitchen_area]' role='dimension' type='nominal' />
            <column datatype='string' name='[kitchen_group]' role='dimension' type='nominal' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column-instance column='[reporting_date]' derivation='MY' name='[my:reporting_date:ok]' pivot='key' type='ordinal' />
