        <calculation class='tableau' formula='CASE [Parameters].[brand_owner Parameter]&#10;&#10;WHEN &apos;Total Subsidies&apos; THEN&#10;SUM(if ([brand_owner]&lt;&gt;&apos;Concept&apos; AND [brand_owner]&lt;&gt;&apos;HFC&apos;) AND [Customer_fg]=&apos;New&apos; THEN [discount_dh_eur] + [discount_other_eur] + [voucher_dh_eur] + [voucher_other_eur] END )&#10;WHEN &apos;Subsidies (% of Total GBV)&apos; THEN &#10;(SUM(if [brand_owner]&lt;&gt;&apos;Concept&apos; AND [brand_owner]&lt;&gt;&apos;HFC&apos; AND [Customer_fg]=&apos;New&apos; THEN [discount_dh_eur] + [discount_other_eur] + [voucher_dh_eur] + [voucher_other_eur] END )&#10;/&#10;SUM( if [brand_owner]&lt;&gt;&apos;Concept&apos; AND [brand_owner]&lt;&gt;&apos;HFC&apos; AND [Customer_fg]=&apos;New&apos; THEN [gbv_eur] END))*100&#10;WHEN &apos;Subsidies (% of Total Orders)&apos; THEN &#10;(SUM(if [brand_owner]&lt;&gt;&apos;Concept&apos; AND [brand_owner]&lt;&gt;&apos;HFC&apos; AND [Customer_fg]=&apos;New&apos; THEN [subsidised_orders] END)&#10;/&#10;SUM([total_order_count]))*100&#10;END' />
      </column>
      <column caption='Concept Measure Subsidies' datatype='real' name='[Kitchen Total Subsidies (copy)_3897372929141960716]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[brand_owner Parameter]&#10;&#10;WHEN &apos;Total Subsidies&apos; THEN&#10;SUM(if [brand_owner]=&apos;Concept&apos; OR [brand_owner]=&apos;HFC&apos; THEN [discount_dh_eur] + [discount_other_eur] + [voucher_dh_eur] + [voucher_other_eur] END )&#10;WHEN &apos;Subsidies (% of Total GBV)&apos; THEN &#10;(SUM(if [brand_owner]=&apos;Concept&apos; OR [brand_owner]=&apos;HFC&apos; THEN [discount_dh_eur] + [discount_other_eur] + [voucher_dh_eur] + [voucher_other_eur] END )&#10;/&#10;SUM( if [brand_owner]=&apos;Concept&apos; OR [brand_owner]=&apos;HFC&apos; THEN [gbv_eur] END))*100&#10;WHEN &apos;Subsidies (% of Total Orders)&apos; THEN &#10;(SUM(if [brand_owner]=&apos;Concept&apos; OR [brand_owner]=&apos;HFC&apos; THEN subsidised_orders END)&#10;/&#10;SUM([total_order_count]))*100&#10;END' />
      </column>
      <column caption='Measure 2' datatype='real' name='[Measure 1 (copy)_3897372929790062625]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Measure 1 (copy)_3897372929789440031]&#10;WHEN &apos;Total Subsidies&apos; THEN [Calculation_3897372928526221313]&#10;WHEN &apos;Subsidies (% of Total GBV)&apos; THEN ([Calculation_3897372928526221313]/SUM([gbv_eur]))*100&#10;WHEN &apos;Subsidies (% of Total Orders)&apos; THEN (SUM([subsidised_orders])/SUM([total_order_count]))*100&#10;WHEN &apos;DH Subsidies&apos; THEN SUM([discount_dh_eur]+[voucher_dh_eur])&#10;WHEN &apos;Vendor Subsidies&apos; THEN SUM([discount_other_eur]+[voucher_other_eur])&#10;WHEN &apos;Total Orders&apos; THEN SUM([total_order_count])&#10;WHEN &apos;Total Subsidies Order&apos; THEN SUM([subsidised_orders])&#10;WHEN &apos;Subsidies per Order&apos; THEN [Calculation_3897372928526221313]/SUM([total_order_count])&#10;WHEN &apos;CVR&apos; THEN ([Calculation_2182556992446930946])*100&#10;WHEN &apos;Menu Sessions&apos; THEN SUM([menu])&#10;WHEN &apos;Reorder Rate&apos; THEN ([Calculation_3897372929792749602])*100&#10;WHEN &apos;GBV&apos; Then SUM([gbv_eur])&#10;END' />
      </column>
