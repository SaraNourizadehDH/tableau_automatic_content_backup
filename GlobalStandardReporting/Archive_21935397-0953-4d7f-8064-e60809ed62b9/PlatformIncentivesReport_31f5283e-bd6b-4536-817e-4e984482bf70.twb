    <worksheet name='Kitchen by breakdown'>
      <table>
        <view>
          <datasources>
            <datasource caption='marketing_spend (gfs_bi)' name='federated.08d6puo0xyf3861bl3rp60wbvmfh' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Parameter' datatype='string' name='[brand_owner Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Total Subsidies&quot;'>
              <calculation class='tableau' formula='&quot;Total Subsidies&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.08d6puo0xyf3861bl3rp60wbvmfh'>
            <column caption='suffix' datatype='string' name='[Calculation_3897372929494286354]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[brand_owner Parameter]&#10;when &apos;Total Subsidies&apos; THEN &apos;€&apos; &#10;when &apos;Subsidies (% of Total GBV)&apos; THEN &apos;%&apos;&#10;when &apos;Subsidies (% of Total Orders)&apos; THEN &apos;%&apos;&#10;END' />
            </column>
            <column caption='HFC Breakdown Subsidies(voucher)' datatype='real' name='[Concept Breakdown Subsidies(voucher) (copy)_3897372929588490267]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[brand_owner Parameter]&#10;&#10;WHEN &apos;Total Subsidies&apos; THEN&#10;SUM(if [brand_owner]=&apos;HFC&apos; THEN [voucher_dh_eur] + [voucher_other_eur] END )&#10;WHEN &apos;Subsidies vs GBV&apos; THEN &#10;(SUM(if [brand_owner]=&apos;HFC&apos; THEN [voucher_dh_eur] + [voucher_other_eur]  END )&#10;/&#10;SUM( if [brand_owner]=&apos;HFC&apos; THEN [gbv_eur] END))*100&#10;WHEN &apos;Subsidies vs Orders&apos; THEN &#10;(SUM(if [brand_owner]=&apos;HFC&apos; THEN [voucher_orders_count] END)&#10;/&#10;SUM([total_order_count]))*100&#10;END' />
            </column>
            <column caption='Kitchen Breakdown Subsidies(discount)' datatype='real' name='[HFC Breakdown Subsidies(discount) (copy)_3897372929589792796]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[brand_owner Parameter]&#10;&#10;WHEN &apos;Total Subsidies&apos; THEN&#10;SUM(if ([brand_owner]&lt;&gt;&apos;HFC&apos; AND [brand_owner]&lt;&gt;&apos;Concept&apos;) THEN [discount_dh_eur] + [discount_other_eur] END )&#10;WHEN &apos;Subsidies (% of Total GBV)&apos; THEN &#10;(SUM(if ([brand_owner]&lt;&gt;&apos;HFC&apos; AND [brand_owner]&lt;&gt;&apos;Concept&apos;)  THEN [discount_dh_eur] + [discount_other_eur] END )&#10;/&#10;SUM( if ([brand_owner]&lt;&gt;&apos;HFC&apos; AND [brand_owner]&lt;&gt;&apos;Concept&apos;)  THEN [gbv_eur] END))*100&#10;WHEN &apos;Subsidies (% of Total Orders)&apos; THEN &#10;(SUM(if ([brand_owner]&lt;&gt;&apos;HFC&apos; AND [brand_owner]&lt;&gt;&apos;Concept&apos;)  THEN [discount_orders_count] END)&#10;/&#10;SUM([total_order_count]))*100&#10;END' />
            </column>
            <column caption='Kitchen Breakdown Subsidies(voucher)' datatype='real' name='[HFC Breakdown Subsidies(voucher) (copy)_3897372929590022173]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[brand_owner Parameter]&#10;&#10;WHEN &apos;Total Subsidies&apos; THEN&#10;SUM(if [brand_owner]&lt;&gt;&apos;HFC&apos; AND [brand_owner]&lt;&gt;&apos;Concept&apos; THEN [voucher_dh_eur] + [voucher_other_eur] END )&#10;WHEN &apos;Subsidies (% of Total GBV)&apos; THEN &#10;(SUM(if [brand_owner]&lt;&gt;&apos;HFC&apos; AND [brand_owner]&lt;&gt;&apos;Concept&apos; THEN [voucher_dh_eur] + [voucher_other_eur]  END )&#10;/&#10;SUM( if [brand_owner]&lt;&gt;&apos;HFC&apos; AND [brand_owner]&lt;&gt;&apos;Concept&apos; THEN [gbv_eur] END))*100&#10;WHEN &apos;Subsidies (% of Total Orders)&apos; THEN &#10;(SUM(if [brand_owner]&lt;&gt;&apos;HFC&apos; AND [brand_owner]&lt;&gt;&apos;Concept&apos; THEN [voucher_orders_count] END)&#10;/&#10;SUM([total_order_count]))*100&#10;END' />
            </column>
            <column caption='Brand' datatype='string' name='[brand]' role='dimension' type='nominal' />
            <column caption='Brand Owner' datatype='string' name='[brand_owner]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='real' name='[discount_dh_eur]' role='measure' type='quantitative' />
            <column datatype='integer' name='[discount_orders_count]' role='measure' type='quantitative' />
            <column datatype='real' name='[discount_other_eur]' role='measure' type='quantitative' />
            <column datatype='real' name='[gbv_eur]' role='measure' type='quantitative' />
            <column datatype='string' name='[kitchen_area]' role='dimension' type='nominal' />
            <column datatype='string' name='[kitchen_group]' role='dimension' type='nominal' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column-instance column='[reporting_date]' derivation='MY' name='[my:reporting_date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_3897372929494286354]' derivation='None' name='[none:Calculation_3897372929494286354:nk]' pivot='key' type='nominal' />
