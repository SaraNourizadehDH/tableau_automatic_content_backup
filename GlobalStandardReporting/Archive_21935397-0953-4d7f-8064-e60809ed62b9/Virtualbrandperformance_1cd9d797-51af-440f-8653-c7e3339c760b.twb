                <zone fixed-size='520' forceUpdate='true' h='18747' id='24' type-v2='text' w='33000' x='65496' y='6178'>
                  <formatted-text>
                    <run fontcolor='#555555'>Feedback and feature requests please add to the link below:</run>
                    <run>Æ&#10;</run>
                    <run auto-url='true' fontcolor='#1155cc' fontname='Arial' fontsize='8' hyperlink='tabdoc:load-url url=&amp;quot;https://docs.google.com/spreadsheets/d/14MwXx6MvQloZJRAtd4Pj_l2tELjnbQOVegj0c1IzzKY/edit#gid=165756770&amp;quot;' underline='true'>https://docs.google.com/spreadsheets/d/14MwXx6MvQloZJRAtd4Pj_l2tELjnbQOVegj0c1IzzKY/edit#gid=165756770</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' underline='true'>Glossary</run>
                    <run bold='true'>:</run>
                    <run>Æ&#10;</run>
                    <run bold='true'>Benchmarks:</run>
                    <run>Æ&#10;</run>
                    <run bold='true'>1. All Restaurants: </run>
                    <run>All non GFS restaurants. Key accounts might be excluded if needed by using &apos;is_key_account&apos; filter on the top.
</run>
                    <run bold='true'>2. Key accounts: </run>
                    <run>Only key accounts, e.g. Burger King.
</run>
                    <run bold='true'>3.</run>
                    <run>Æ </run>
                    <run bold='true'>Top 25 percent</run>
                    <run>: Restaurants (excl. GFS and key accounts) that are in top 25% on the platform by order number based on the last year data (last year: is the timeframe of this report).
</run>
                    <run bold='true'>Menu (GA)</run>
                    <run> - menu page loaded&#10;</run>
                    <run bold='true'>Orders (GA) </run>
                    <run> - transactions&#10;</run>
                    <run bold='true'>CVR</run>
                    <run> = transactions/menu&#10;</run>
                    <run bold='true'>Successful Orders</run>
                    <run> - total number of successful orders per brand
</run>
                    <run bold='true'>Reorder Share</run>
                    <run> -  Share of orders from returning customers
</run>
                    <run bold='true'>Orders Penetartion %</run>
                    <run> - GFS Orders/ Total Orders&#10;&#10;</run>
                    <run bold='true'>Note</run>
                    <run>: In the report the data is available till the last month.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
