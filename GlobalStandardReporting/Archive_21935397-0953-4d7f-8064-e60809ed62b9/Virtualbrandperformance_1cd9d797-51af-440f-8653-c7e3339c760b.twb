      </column>
      <column caption='Orders_MoM_benchmark' datatype='integer' name='[Calculation_3799560358245216259]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [is_concept]=FALSE AND [is_hfc]=FALSE THEN [orders_mom] END)' />
      </column>
      <column caption='Orders_MoM_brand' datatype='integer' name='[Calculation_3799560358245576708]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [is_concept]=TRUE OR [is_hfc]=TRUE THEN [orders_mom] END)' />
      </column>
      <column caption='MoM_%_brand' datatype='real' name='[Calculation_3799560358245842949]' role='measure' type='quantitative'>
