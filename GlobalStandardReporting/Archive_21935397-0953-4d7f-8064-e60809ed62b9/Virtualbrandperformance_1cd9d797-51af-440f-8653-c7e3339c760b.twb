      <column caption='Number Of Records' datatype='integer' name='[Calculation_1777936713880059904]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='CTR' datatype='real' default-format='p0.0%' name='[Calculation_1777936714186231812]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([all_mcvr_menu])/SUM([Calculation_5371105519468998669])' />
      </column>
      <column caption='is_gfs' datatype='boolean' name='[Calculation_1777936714233389069]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_concept] = TRUE OR [is_hfc] = TRUE THEN TRUE ELSE FALSE END' />
