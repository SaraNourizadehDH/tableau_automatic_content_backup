      <column caption='test' datatype='string' name='[Calculation_1029072538976288771]' role='measure' type='nominal'>
        <calculation class='tableau' formula='ATTR(&quot;Feedback and feature requests for this dashboard&quot;)' />
      </column>
      <column caption='One_benchmark' datatype='boolean' name='[Calculation_1029072539006869510]' role='measure' type='nominal'>
        <calculation class='tableau' formula='COUNTD([brand_name (copy)_5371105518049751045])=1' />
