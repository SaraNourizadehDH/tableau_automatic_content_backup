    <worksheet name='Orders_by_rest_benchmark'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontsize='12'>Avg Orders Benchmark, last month</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='dwh_bl.tableau_gfs_virtual_brand_performance' name='federated.1978f3t0n896pd11mwv0707cufm4' />
          </datasources>
          <datasource-dependencies datasource='federated.1978f3t0n896pd11mwv0707cufm4'>
            <column caption='One_benchmark' datatype='boolean' name='[Calculation_1029072539006869510]' role='measure' type='nominal'>
              <calculation class='tableau' formula='COUNTD([brand_name (copy)_5371105518049751045])=1' />
            </column>
            <column caption='is_gfs' datatype='boolean' name='[Calculation_1777936714233389069]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_concept] = TRUE OR [is_hfc] = TRUE THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='User Entitlement' datatype='boolean' name='[Calculation_2822560728090054656]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[username] = USERNAME()' />
            </column>
            <column caption='Average orders benchmark' datatype='real' name='[Calculation_3906731969994338304]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders])/sum([vendors_count])' />
            </column>
            <column caption='Last month' datatype='boolean' name='[Calculation_4648981480072974336]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&quot;month&quot;, [report_month], TODAY()) = 1' />
            </column>
            <column caption='brand_name_benchmark' datatype='string' name='[brand_name (copy)_5371105518049751045]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF is_concept = FALSE AND is_hfc = FALSE THEN [brand_name] END' />
            </column>
            <column caption='Brand name' datatype='string' name='[brand_name]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;All restaurants&quot;' value='1 Benchmark: All restaurants' />
                <alias key='&quot;Key accounts&quot;' value='2 Benchmark: Key accounts' />
                <alias key='&quot;Non GFS restaurants&quot;' value='1 Benchmark: Non GFS restaurants' />
                <alias key='&quot;Top 25 percent&quot;' value='3 Benchmark: Top 25 percent' />
              </aliases>
            </column>
            <column datatype='string' name='[brand_owner]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;All&quot;' value='All restaurants' />
              </aliases>
            </column>
