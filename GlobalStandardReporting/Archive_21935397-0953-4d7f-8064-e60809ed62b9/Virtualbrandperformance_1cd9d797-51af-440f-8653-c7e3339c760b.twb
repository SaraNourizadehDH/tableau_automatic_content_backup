    <worksheet name='Br_Bench_Share'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#ffffff'>Brand vs Benchmark</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='dwh_bl.tableau_gfs_virtual_brand_performance' name='federated.1978f3t0n896pd11mwv0707cufm4' />
          </datasources>
          <datasource-dependencies datasource='federated.1978f3t0n896pd11mwv0707cufm4'>
            <column caption='One_benchmark' datatype='boolean' name='[Calculation_1029072539006869510]' role='measure' type='nominal'>
              <calculation class='tableau' formula='COUNTD([brand_name (copy)_5371105518049751045])=1' />
            </column>
            <column caption='User Entitlement' datatype='boolean' name='[Calculation_2822560728090054656]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[username] = USERNAME()' />
            </column>
            <column caption='Last 3 months' datatype='boolean' name='[Last month (copy)_4648981480075808769]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&quot;month&quot;, [report_month], TODAY()) &gt;= 1 AND DATEDIFF(&quot;month&quot;, [report_month], TODAY())&lt;4' />
            </column>
            <column caption='Share_brand_bench' datatype='real' name='[Orders brand_benchmark (copy)_2312879897851023388]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Share of Orders Returning Customers (copy 2)_2312879897849905176]-[Share of Orders Returning Customers (copy)_2312879897849888791]' />
            </column>
            <column caption='Orders_concept_returning_customer' datatype='integer' name='[Orders_brand (copy)_2312879897848438803]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_concept]=TRUE OR [is_hfc]=TRUE THEN [orders_gfs_brand_returning_customer] END)' />
            </column>
            <column caption='Total_concept_orders' datatype='integer' name='[Orders_concept_returning_customer (copy)_2312879897849344020]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_concept]=TRUE OR [is_hfc]=TRUE THEN [orders_gfs_brand_returning_customer] + [orders_gfs_brand_acquisition] END)' />
            </column>
            <column caption='Orders_bench_returning_customer' datatype='integer' name='[Orders_concept_returning_customer (copy)_2312879897849524245]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_concept]=FALSE AND [is_hfc]=FALSE THEN [orders_gfs_brand_returning_customer] END)' />
            </column>
            <column caption='Share Conc Orders Returning Customers' datatype='real' name='[Share of Orders Returning Customers (copy 2)_2312879897849905176]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Orders_brand (copy)_2312879897848438803]/[Orders_concept_returning_customer (copy)_2312879897849344020]' />
            </column>
            <column caption='Share Bench Orders Returning Customers' datatype='real' name='[Share of Orders Returning Customers (copy)_2312879897849888791]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Orders_concept_returning_customer (copy)_2312879897849524245]/[Total_concept_orders (copy)_2312879897849536534]' />
            </column>
            <column caption='Total_bench_orders' datatype='integer' name='[Total_concept_orders (copy)_2312879897849536534]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_concept]=FALSE AND [is_hfc]=FALSE THEN [orders_gfs_brand_returning_customer] + [orders_gfs_brand_acquisition] END)' />
            </column>
            <column caption='brand_name_benchmark' datatype='string' name='[brand_name (copy)_5371105518049751045]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF is_concept = FALSE AND is_hfc = FALSE THEN [brand_name] END' />
            </column>
            <column caption='Brand name' datatype='string' name='[brand_name]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;All restaurants&quot;' value='1 Benchmark: All restaurants' />
                <alias key='&quot;Key accounts&quot;' value='2 Benchmark: Key accounts' />
                <alias key='&quot;Non GFS restaurants&quot;' value='1 Benchmark: Non GFS restaurants' />
                <alias key='&quot;Top 25 percent&quot;' value='3 Benchmark: Top 25 percent' />
              </aliases>
            </column>
            <column datatype='string' name='[brand_owner]' role='dimension' type='nominal'>
