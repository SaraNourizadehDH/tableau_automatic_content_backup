    <worksheet name='Top_brand'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#ffffff'>Brand, last month</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='dwh_bl.tableau_gfs_virtual_brand_performance' name='federated.1978f3t0n896pd11mwv0707cufm4' />
          </datasources>
          <datasource-dependencies datasource='federated.1978f3t0n896pd11mwv0707cufm4'>
            <column caption='CTR' datatype='real' default-format='p0.0%' name='[Calculation_1777936714186231812]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([all_mcvr_menu])/SUM([Calculation_5371105519468998669])' />
            </column>
            <column caption='User Entitlement' datatype='boolean' name='[Calculation_2822560728090054656]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[username] = USERNAME()' />
            </column>
            <column caption='MoM_%_orders' datatype='real' name='[Calculation_3219721906111107073]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([orders]) - sum([orders_mom]))/sum([orders_mom])' />
            </column>
            <column caption='Average rating' datatype='real' name='[Calculation_369224830258364416]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([converted_ratings])/sum([ratings])' />
            </column>
            <column caption='Last month' datatype='boolean' name='[Calculation_4648981480072974336]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&quot;month&quot;, [report_month], TODAY()) = 1' />
            </column>
            <column caption='CVR' datatype='real' name='[Calculation_5371105518033199105]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([all_mcvr_transactions])/SUM([all_mcvr_menu])' />
            </column>
            <column caption='Total_orders' datatype='integer' name='[Calculation_5371105518079201288]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders_gfs_brand_acquisition])+sum([orders_gfs_brand_returning_customer])' />
            </column>
            <column caption='Share of Orders Returning Customers' datatype='real' name='[Calculation_5371105518080344073]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders_gfs_brand_returning_customer])/[Calculation_5371105518079201288]' />
            </column>
            <column caption='RLP_adjusted' datatype='integer' name='[Calculation_5371105519468998669]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [management_entity] IN (&apos;DH Austria&apos;, &apos;Talabat&apos;) THEN null ELSE [all_mcvr_list] END' />
            </column>
            <column datatype='integer' name='[all_mcvr_list]' role='measure' type='quantitative' />
            <column datatype='integer' name='[all_mcvr_menu]' role='measure' type='quantitative' />
            <column datatype='integer' name='[all_mcvr_transactions]' role='measure' type='quantitative' />
            <column caption='brand_name_GFS' datatype='string' name='[brand_name (copy)_5371105518030172160]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF is_concept = TRUE or is_hfc = TRUE THEN [brand_name] END' />
            </column>
            <column caption='Brand name' datatype='string' name='[brand_name]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;All restaurants&quot;' value='1 Benchmark: All restaurants' />
                <alias key='&quot;Key accounts&quot;' value='2 Benchmark: Key accounts' />
                <alias key='&quot;Non GFS restaurants&quot;' value='1 Benchmark: Non GFS restaurants' />
                <alias key='&quot;Top 25 percent&quot;' value='3 Benchmark: Top 25 percent' />
              </aliases>
            </column>
            <column datatype='string' name='[brand_owner]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;All&quot;' value='All restaurants' />
              </aliases>
            </column>
            <column caption='City' datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column datatype='real' name='[converted_ratings]' role='measure' type='quantitative' />
            <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Is Concept?' datatype='boolean' name='[is_concept]' role='dimension' type='nominal' />
            <column caption='Is HFC?' datatype='boolean' name='[is_hfc]' role='dimension' type='nominal' />
