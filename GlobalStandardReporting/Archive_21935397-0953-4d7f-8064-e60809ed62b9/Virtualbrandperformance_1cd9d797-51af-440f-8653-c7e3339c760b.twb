            </column>
            <column caption='RLP_adjusted' datatype='integer' name='[Calculation_5371105519468998669]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [management_entity] IN (&apos;DH Austria&apos;, &apos;Talabat&apos;) THEN null ELSE [all_mcvr_list] END' />
            </column>
            <column caption='RLP_brand' datatype='integer' name='[Calculation_5371105519773593624]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [is_concept]=TRUE OR [is_hfc]=TRUE THEN [Calculation_5371105519468998669] END)' />
            </column>
            <column caption='Last 3 months' datatype='boolean' name='[Last month (copy)_4648981480075808769]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&quot;month&quot;, [report_month], TODAY()) &gt;= 1 AND DATEDIFF(&quot;month&quot;, [report_month], TODAY())&lt;4' />
