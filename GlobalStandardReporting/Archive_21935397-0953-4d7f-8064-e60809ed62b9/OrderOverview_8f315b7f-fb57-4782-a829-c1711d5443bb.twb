            <column caption='Show Order Nr' datatype='string' datatype-customized='true' name='[Show Item Details (copy 2)_1327436030158954496]' param-domain-type='list' role='measure' type='nominal' value='&quot;False&quot;'>
              <calculation class='tableau' formula='&quot;False&quot;' />
            </column>
            <column caption='Show Country' datatype='string' datatype-customized='true' name='[Show Partner Details (copy 2)_982066233392500743]' param-domain-type='list' role='measure' type='nominal' value='&quot;True&quot;'>
