          <alias key='&quot;[federated.1h1s5z71c37xc017lg8hb1ppiwov].[sum:qtydelivered:qk]&quot;' value='Qty Delivered' />
          <alias key='&quot;[federated.1h1s5z71c37xc017lg8hb1ppiwov].[sum:qtyinvoiced:qk]&quot;' value='Qty Invoiced' />
        </aliases>
      </column>
      <column aggregation='Attribute' caption='qty_ordered_fixed' datatype='real' name='[Calculation_1057079310025465856]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{EXCLUDE  [hfc_code],[product_name]: MAX(SUM([qtylostsales]),sum([qtyordered]))}' />
      </column>
      <column caption='invoice uom &lt;&gt; price uom' datatype='boolean' name='[Calculation_1057079310042849281]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[uom_en] &lt;&gt; [price_uom]' />
      </column>
      <column caption='PPV' datatype='real' name='[Calculation_1057079310044495874]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([price_std_eur]-[invoice_price_actual_eur]) * [qtydelivered]' />
      </column>
      <column caption='KG delivered' datatype='real' name='[Calculation_1057079310056783875]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([gramm_multiplyrate]* [qtydelivered])/1000' />
      </column>
      <column caption='Einkauf Countries' datatype='string' name='[Calculation_1057079310062485509]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [sales_type]&#10;when &apos;Einkauf&apos; then (&#10;&#10;IF  [warehouse]=&#10; &apos;L05_Produktion&apos; and [organization]= &apos;Honest Food Company&apos;&#9;then&apos;AT CPK&apos;&#10;ELSEIF  [warehouse]=  &apos;L09_Finland &apos; and [organization]= &apos;Delivery Hero HF Kitchens Finland Oy&apos; then&apos;FI&apos;&#10;ELSEIF  [warehouse]=  &apos;L09_Finland&apos; and [organization]= &apos;Delivery Hero HF Kitchens Finland Oy&apos; then&apos;FI&apos;&#10;ELSEIF  [warehouse] =  &apos;L11_SCM Czech&apos; and [organization]= &apos;Delivery Hero HF Kitchens Czech&apos; then &apos;CZ&apos;&#10;ELSEIF [warehouse] =  &apos;L13_Hungary&apos;   and [organization]= &apos;Delivery Hero HF Kitchens Hungary Kft.&apos; then &apos;HU&apos;&#10;ELSEIF [warehouse] = &apos;L17_Sweden Havilog&apos; and [organization] = &apos;Honest Food Kitchens Sweden AB&apos; then &apos;SE&apos;&#10;ELSEIF [warehouse] = &apos;L18_HAVI&apos; and [organization] = &apos;Honest Food Company&apos; then &apos;AT&apos;&#10;ELSEIF [warehouse]= &apos;1000005_Honest Food Kitchens Sweden AB&apos; and [organization]= &apos;Honest Food Kitchens Sweden AB&apos;then &apos;SE&apos;&#10;ELSEIF [warehouse]= &apos;L16_QSL Hungary (Schattenlager)&apos; THEN &apos;HU&apos;&#10;else NULL&#10;END)&#10;when &apos;Verkauf&apos; then [country_code]&#10;END' />
      </column>
      <column caption='F: Country' datatype='string' name='[Calculation_1057079310062776326]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case &#10;[Parameters].[Show Partner Details (copy 2)_982066233392500743]&#10;when &apos;True&apos; THEN  [Calculation_1057079310062485509]&#10;when &apos;False&apos; then &quot;&quot;&#10;end' />
      </column>
      <column caption='F: Partner Name' datatype='string' name='[Calculation_1057079310063792135]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Show source (copy)] THEN [partner_name_identifier]&#10;ELSE &quot;&quot;&#10;END' />
      </column>
      <column caption='F: Warehouse' datatype='string' name='[Calculation_1057079310063960072]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case &#10;[Parameters].[Show keystone ref (copy)_982066233364578307]&#10;when &apos;True&apos; THEN  [warehouse]&#10;when &apos;False&apos; then &quot;&quot;&#10;end' />
      </column>
      <column caption='F: Organization' datatype='string' name='[Calculation_1057079310064029705]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case &#10;[Parameters].[Show warehouse (copy)_982066233364639748]&#10;when &apos;True&apos; THEN  [organization]&#10;when &apos;False&apos; then &quot;&quot;&#10;end' />
      </column>
      <column caption='F: Product Details' datatype='string' name='[Calculation_1057079310064267274]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[Show Partner Details (copy)]&#10;when true       &#10;THEN [product_name] +  &quot; &quot; + [hfc_code]&#10;When False then &quot;&quot;&#10;END' />
      </column>
      <column caption='F: Order Nr' datatype='string' name='[Calculation_1057079310065926155]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case &#10;[Parameters].[Show Item Details (copy 2)_1327436030158954496]&#10;when &apos;True&apos; THEN  [document_number]&#10;when &apos;False&apos; then &quot;&quot;&#10;end' />
      </column>
      <column caption='F: Invoice Id' datatype='string' name='[Calculation_1057079310069436430]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 3]&#10;when TRUE then STR([invoice_doc_number])&#10;when FALSE then &quot;&quot;&#10;end' />
      </column>
      <column caption='Calculation1' datatype='boolean' name='[Calculation_201536128596742144]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[invoice_price_actual_lc] &lt;&gt; [invoice_price_actual_eur]' />
      </column>
      <column caption='Net Amount' datatype='real' name='[Calculation_201536128596918273]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[invoice_price_actual_eur] * [qtyinvoiced]' />
      </column>
      <column aggregation='Attribute' caption='qty delivered fix' datatype='real' name='[Calculation_201536128601403394]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ EXCLUDE [hfc_code], [product_name]: SUM([qtydelivered])}' />
      </column>
      <column caption='country code verkauf' datatype='string' name='[Calculation_6339168360221888512]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='If &#10;(IF  [sales_type] = &apos;Verkauf&apos; &#10;then LEFT([partner_name_identifier],2)&#10;else null       &#10;END) &lt;&gt; &apos;De&apos; &#10;and (IF  [sales_type] = &apos;Verkauf&apos; &#10;then LEFT([partner_name_identifier],2)&#10;else null       &#10;END) &lt;&gt; &apos;He&apos;&#10;and &#10;(IF  [sales_type] = &apos;Verkauf&apos; &#10;then LEFT([partner_name_identifier],2)&#10;else null       &#10;END) &lt;&gt; &apos;Ho&apos;&#10;and (IF  [sales_type] = &apos;Verkauf&apos; &#10;then LEFT([partner_name_identifier],2)&#10;else null       &#10;END)&#10; &lt;&gt; &apos;Mj&apos;&#10;then &#10;(IF  [sales_type] = &apos;Verkauf&apos; &#10;then LEFT([partner_name_identifier],2)&#10;else null       &#10;END)&#10;else null end' />
      </column>
      <column caption='Date Ordered (copy)' datatype='date' name='[Date Ordered (copy)_1057079310059909124]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[date_ordered]' />
      </column>
      <column caption='F: Month' datatype='string' name='[F: Partner Name (copy)_2658460821673644032]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 2]&#10;when true       &#10;THEN str (DATETRUNC(&apos;month&apos;, [date_ordered]))&#10;When False then &quot;&quot;&#10;END' />
      </column>
