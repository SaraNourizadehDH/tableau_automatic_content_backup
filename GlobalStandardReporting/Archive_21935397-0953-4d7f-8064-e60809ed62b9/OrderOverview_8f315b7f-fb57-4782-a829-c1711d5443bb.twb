  <worksheets>
    <worksheet name='Finance'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Finance Order Overview</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_metasfresh_orders (rl_gfs)' name='federated.1h1s5z71c37xc017lg8hb1ppiwov' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Show Month Detail' datatype='boolean' datatype-customized='true' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
            </column>
            <column caption='Show Invoice Nr' datatype='boolean' datatype-customized='true' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='false'>
              <calculation class='tableau' formula='false' />
