      <column caption='Concepts Order Share' datatype='real' name='[Calculation_3740802470873837571]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([successful_orders_concepts])&#10;/&#10;SUM([successful_orders_all])' />
      </column>
      <column caption='Concepts GMV Share' datatype='real' name='[Calculation_3740802470874013700]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([amt_gmv_eur_concepts])&#10;/&#10;SUM([amt_gmv_eur_all])' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_3740802470877061125]' role='dimension' type='nominal'>
