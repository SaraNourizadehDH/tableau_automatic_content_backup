    <worksheet name='Monthly Overview'>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_gfs_global_food_services' name='federated.14iaiy6010lznw13xgy0y1m02vq5' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Split into verticals' datatype='boolean' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='false'>
              <calculation class='tableau' formula='false' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.14iaiy6010lznw13xgy0y1m02vq5'>
            <column caption='Voucher Orders %' datatype='real' default-format='p0.0%' name='[Calculation_137078377583230978]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders_voucher])&#10;/&#10;SUM([successful_orders])' />
            </column>
            <column caption='Avg Prep Time' datatype='real' name='[Calculation_137078377633206275]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([prep_time_m_sum])&#10;/&#10;SUM([prep_time_m_count]))/60' />
            </column>
            <column caption='Restaurant PKey' datatype='string' name='[Calculation_274649272835469312]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([global_entity_id]) + &apos;-&apos; + [vendor_id]' />
            </column>
            <column caption='Love Index' datatype='real' default-format='p0%' name='[Calculation_274649272852434947]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([nps_ao_promoters])&#10;/&#10;SUM([nps_ao_responses])' />
            </column>
            <column caption='Rests Online' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_283304626958954497]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_online] THEN [Calculation_274649272835469312] END)' />
            </column>
            <column caption='Rests Active' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_283304626959204354]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_active] THEN [Calculation_274649272835469312] END)' />
            </column>
            <column caption='Orders per Active Rests' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_283304626959433731]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders])&#10;/&#10;[Calculation_283304626959204354]' />
            </column>
            <column caption='AOV' datatype='real' default-format='c&quot;€&quot;#,##0.0;-&quot;€&quot;#,##0.0' name='[Calculation_283304626959994884]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_eur])&#10;/&#10;SUM([successful_orders])' />
            </column>
            <column caption='Avg Delivery Time' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_283304626960986117]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([delivery_time_m_sum])&#10;/&#10;SUM([delivery_time_m_count]))/60' />
            </column>
            <column caption='Avg Rating' datatype='real' default-format='p0.0%' name='[Calculation_283304626961231878]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([converted_rating_total])&#10;/&#10;SUM([rated_order_count])' />
            </column>
            <column caption='Fail Rate' datatype='real' default-format='p0.0%' name='[Calculation_283304626961436679]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_orders])&#10;/&#10;(SUM([failed_orders]) + SUM([successful_orders]))' />
            </column>
            <column caption='Commission Rate' datatype='real' default-format='p0.00%' name='[Calculation_283304626962989064]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([commission_eur])&#10;/&#10;SUM([gmv_eur])' />
            </column>
            <column caption='Rests Churned' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_283304626976784393]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [churned] THEN [Calculation_274649272835469312] END)' />
            </column>
            <column caption='Rests Recovered' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_283304626976915466]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [recovered_churn] THEN [Calculation_274649272835469312] END)' />
            </column>
            <column caption='Rests New' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_283304626977050635]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [new_online] THEN [Calculation_274649272835469312] END)' />
            </column>
            <column caption='Selected Vertical' datatype='string' name='[Calculation_421508840184877056]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF(&#10;    [gfs_vertical] = &apos;gen1&apos; OR [gfs_vertical] = &apos;gen2&apos;  OR [gfs_vertical] = &apos;Concept&apos;,&#10;    IIF(&#10;        [Parameters].[Parameter 1] = TRUE,&#10;        [gfs_vertical],&#10;        &apos;GFS&apos;&#10;    ),&#10;    IIF(&#10;        [gfs_vertical] = &apos;HFC&apos;,&#10;        &apos;HFC&apos;,&#10;        &apos;Other&apos;&#10;    )&#10;)' />
            </column>
            <column caption='Avg. Delivery Distance' datatype='real' default-format='n#,##0.00&quot; km&quot;;-#,##0.00&quot; km&quot;' name='[Calculation_5341550673163743232]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([delivery_distance_sum]) / SUM([delivery_distance_count]))/1000' />
            </column>
            <column caption='Groups' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_809733206004117504]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ INCLUDE [gfs_vertical]: COUNTD(IF [is_online] THEN [Calculation_809733206011854849] END)}' />
            </column>
            <column caption='Group' datatype='string' name='[Calculation_809733206011854849]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [gfs_vertical] = &apos;Concept&apos; THEN [brand]&#10;ELSEIF [gfs_vertical] = &apos;gen1&apos; or [gfs_vertical] = &apos;gen2&apos; THEN [vendor_id]&#10;ELSEIF [gfs_vertical] = &apos;HFC&apos; THEN [brand]&#10;END' />
            </column>
            <column caption='Orders per Online Rest' datatype='real' default-format='n#,##0;-#,##0' name='[Orders per Online Rest (copy)_3740802469817446401]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders])&#10;/&#10;[Calculation_283304626958954497]' />
            </column>
            <column caption='Stacked Orders Restaurant' datatype='real' name='[Stacked Orders Driver (copy)_2802153789719756801]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([stacked_orders_intravendor_count]) / SUM([stacked_orders_intravendor_sum])' />
            </column>
            <column datatype='string' name='[brand]' role='dimension' type='nominal' />
            <column caption='Churned' datatype='boolean' name='[churned]' role='dimension' type='nominal' />
            <column caption='City' datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column datatype='real' name='[commission_eur]' role='measure' type='quantitative' />
            <column caption='Converted Rating Total' datatype='real' name='[converted_rating_total]' role='measure' type='quantitative' />
            <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='integer' name='[delivery_distance_count]' role='measure' type='quantitative' />
            <column datatype='integer' name='[delivery_distance_sum]' role='measure' type='quantitative' />
            <column caption='Delivery Time M Count' datatype='integer' name='[delivery_time_m_count]' role='measure' type='quantitative' />
            <column caption='Delivery Time M Sum' datatype='integer' name='[delivery_time_m_sum]' role='measure' type='quantitative' />
            <column caption='Failed Orders' datatype='integer' name='[failed_orders]' role='measure' type='quantitative' />
            <column caption='GFS Vertical' datatype='string' name='[gfs_vertical]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;c&quot;' value='Concepts' />
                <alias key='&quot;d&quot;' value='Darkstores' />
                <alias key='&quot;k&quot;' value='Kitchens' />
                <alias key='&quot;n&quot;' value='HFC' />
                <alias key='&quot;o&quot;' value='Other' />
                <alias key='&quot;s&quot;' value='Shops' />
              </aliases>
            </column>
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column datatype='real' name='[gmv_eur]' role='measure' type='quantitative' />
            <column caption='Is Active' datatype='boolean' name='[is_active]' role='dimension' type='nominal' />
