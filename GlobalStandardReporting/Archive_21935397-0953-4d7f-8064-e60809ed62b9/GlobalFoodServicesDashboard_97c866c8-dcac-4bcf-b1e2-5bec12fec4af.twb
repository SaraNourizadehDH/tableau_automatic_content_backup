    <worksheet name='Number of Rest Groups'>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_gfs_global_food_services' name='federated.14iaiy6010lznw13xgy0y1m02vq5' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Split into verticals' datatype='boolean' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='false'>
              <calculation class='tableau' formula='false' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.14iaiy6010lznw13xgy0y1m02vq5'>
            <column caption='Selected Vertical' datatype='string' name='[Calculation_421508840184877056]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF(&#10;    [gfs_vertical] = &apos;gen1&apos; OR [gfs_vertical] = &apos;gen2&apos;  OR [gfs_vertical] = &apos;Concept&apos;,&#10;    IIF(&#10;        [Parameters].[Parameter 1] = TRUE,&#10;        [gfs_vertical],&#10;        &apos;GFS&apos;&#10;    ),&#10;    IIF(&#10;        [gfs_vertical] = &apos;HFC&apos;,&#10;        &apos;HFC&apos;,&#10;        &apos;Other&apos;&#10;    )&#10;)' />
            </column>
            <column caption='Groups' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_809733206004117504]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ INCLUDE [gfs_vertical]: COUNTD(IF [is_online] THEN [Calculation_809733206011854849] END)}' />
            </column>
            <column caption='Group' datatype='string' name='[Calculation_809733206011854849]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [gfs_vertical] = &apos;Concept&apos; THEN [brand]&#10;ELSEIF [gfs_vertical] = &apos;gen1&apos; or [gfs_vertical] = &apos;gen2&apos; THEN [vendor_id]&#10;ELSEIF [gfs_vertical] = &apos;HFC&apos; THEN [brand]&#10;END' />
            </column>
            <column datatype='string' name='[brand]' role='dimension' type='nominal' />
            <column caption='City' datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='GFS Vertical' datatype='string' name='[gfs_vertical]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;c&quot;' value='Concepts' />
                <alias key='&quot;d&quot;' value='Darkstores' />
