    <worksheet name='Inventory Development'>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_gfs_global_food_services' name='federated.14iaiy6010lznw13xgy0y1m02vq5' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Split into verticals' datatype='boolean' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='false'>
              <calculation class='tableau' formula='false' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.14iaiy6010lznw13xgy0y1m02vq5'>
            <column caption='Restaurant PKey' datatype='string' name='[Calculation_274649272835469312]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([global_entity_id]) + &apos;-&apos; + [vendor_id]' />
            </column>
            <column caption='Rests Churned' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_283304626976784393]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [churned] THEN [Calculation_274649272835469312] END)' />
            </column>
            <column caption='Rests Recovered' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_283304626976915466]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [recovered_churn] THEN [Calculation_274649272835469312] END)' />
            </column>
            <column caption='Rests New' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_283304626977050635]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [new_online] THEN [Calculation_274649272835469312] END)' />
            </column>
            <column caption='-[Rests Churned]' datatype='integer' name='[Calculation_283304626978967566]' role='measure' type='quantitative' user:unnamed='Rest Inventory Development'>
              <calculation class='tableau' formula='-[Calculation_283304626976784393]' />
            </column>
            <column caption='Selected Vertical' datatype='string' name='[Calculation_421508840184877056]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF(&#10;    [gfs_vertical] = &apos;gen1&apos; OR [gfs_vertical] = &apos;gen2&apos;  OR [gfs_vertical] = &apos;Concept&apos;,&#10;    IIF(&#10;        [Parameters].[Parameter 1] = TRUE,&#10;        [gfs_vertical],&#10;        &apos;GFS&apos;&#10;    ),&#10;    IIF(&#10;        [gfs_vertical] = &apos;HFC&apos;,&#10;        &apos;HFC&apos;,&#10;        &apos;Other&apos;&#10;    )&#10;)' />
            </column>
            <column datatype='string' name='[brand]' role='dimension' type='nominal' />
            <column caption='Churned' datatype='boolean' name='[churned]' role='dimension' type='nominal' />
            <column caption='City' datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='GFS Vertical' datatype='string' name='[gfs_vertical]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;c&quot;' value='Concepts' />
                <alias key='&quot;d&quot;' value='Darkstores' />
