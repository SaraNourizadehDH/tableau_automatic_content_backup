            <column caption='Concepts GMV Share' datatype='real' name='[Calculation_3740802470874013700]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([amt_gmv_eur_concepts])&#10;/&#10;SUM([amt_gmv_eur_all])' />
            </column>
            <column caption='Kitchens City' datatype='boolean' name='[Calculation_3740802470878523400]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF { FIXED [global_entity_id], [city]: SUM([successful_orders_kitchens]) } &gt; 0&#10;    THEN TRUE&#10;    ELSE FALSE&#10;    END' />
            </column>
            <column caption='Kitchens GMV Share' datatype='real' name='[Concepts GMV Share (copy)_3740802470880219146]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([amt_gmv_eur_kitchens])&#10;/&#10;SUM([amt_gmv_eur_all])' />
