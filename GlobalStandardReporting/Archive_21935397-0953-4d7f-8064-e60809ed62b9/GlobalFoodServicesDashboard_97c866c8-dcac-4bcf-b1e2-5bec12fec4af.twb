      </column>
      <column caption='Kitchens City' datatype='boolean' name='[Calculation_3740802470878523400]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF { FIXED [global_entity_id], [city]: SUM([successful_orders_kitchens]) } &gt; 0&#10;    THEN TRUE&#10;    ELSE FALSE&#10;    END' />
      </column>
      <column caption='GFS GMV Share' datatype='real' name='[Calculation_4011862869548965888]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([amt_gmv_eur_concepts] + [amt_gmv_eur_hfc] + [amt_gmv_eur_kitchens])/SUM([amt_gmv_eur_all])' />
      </column>
