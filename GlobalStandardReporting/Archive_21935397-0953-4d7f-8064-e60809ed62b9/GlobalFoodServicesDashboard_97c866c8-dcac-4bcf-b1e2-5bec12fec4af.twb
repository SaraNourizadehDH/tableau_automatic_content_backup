      <table>
        <view>
          <datasources>
            <datasource caption='tableau_gfs_global_food_services' name='federated.14iaiy6010lznw13xgy0y1m02vq5' />
          </datasources>
          <datasource-dependencies datasource='federated.14iaiy6010lznw13xgy0y1m02vq5'>
            <column caption='Voucher Orders %' datatype='real' default-format='p0.0%' name='[Calculation_137078377583230978]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders_voucher])&#10;/&#10;SUM([successful_orders])' />
            </column>
            <column caption='Avg Prep Time' datatype='real' name='[Calculation_137078377633206275]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([prep_time_m_sum])&#10;/&#10;SUM([prep_time_m_count]))/60' />
            </column>
            <column caption='AOV' datatype='real' default-format='c&quot;€&quot;#,##0.0;-&quot;€&quot;#,##0.0' name='[Calculation_283304626959994884]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_eur])&#10;/&#10;SUM([successful_orders])' />
            </column>
            <column caption='Avg Delivery Time' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_283304626960986117]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([delivery_time_m_sum])&#10;/&#10;SUM([delivery_time_m_count]))/60' />
            </column>
            <column caption='Avg Rating' datatype='real' default-format='p0.0%' name='[Calculation_283304626961231878]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([converted_rating_total])&#10;/&#10;SUM([rated_order_count])' />
            </column>
            <column caption='Fail Rate' datatype='real' default-format='p0.0%' name='[Calculation_283304626961436679]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_orders])&#10;/&#10;(SUM([failed_orders]) + SUM([successful_orders]))' />
            </column>
            <column caption='Commission Rate' datatype='real' default-format='p0.00%' name='[Calculation_283304626962989064]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([commission_eur])&#10;/&#10;SUM([gmv_eur])' />
            </column>
            <column caption='Avg. Delivery Distance' datatype='real' default-format='n#,##0.00&quot; km&quot;;-#,##0.00&quot; km&quot;' name='[Calculation_5341550673163743232]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([delivery_distance_sum]) / SUM([delivery_distance_count]))/1000' />
            </column>
            <column caption='Group' datatype='string' name='[Calculation_809733206011854849]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [gfs_vertical] = &apos;Concept&apos; THEN [brand]&#10;ELSEIF [gfs_vertical] = &apos;gen1&apos; or [gfs_vertical] = &apos;gen2&apos; THEN [vendor_id]&#10;ELSEIF [gfs_vertical] = &apos;HFC&apos; THEN [brand]&#10;END' />
            </column>
            <column caption='Stacked Orders Restaurant' datatype='real' name='[Stacked Orders Driver (copy)_2802153789719756801]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([stacked_orders_intravendor_count]) / SUM([stacked_orders_intravendor_sum])' />
