      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_F5217D3901334F0BB015D23E3D887620'>
            <properties context=''>
              <relation join='inner' type='join'>
                <clause type='join'>
                  <expression op='='>
                    <expression op='[Custom SQL Query].[global_entity_id]' />
                    <expression op='[tableau_user_entitlement].[global_entity_id]' />
                  </expression>
                </clause>
                <relation connection='bigquery.0qp0y1p0wpcr6f1anh6os16qyyjv' name='Custom SQL Query' type='text'>with kitopi_swhk_parent AS (
  SELECT DISTINCT id, name  FROM `fulfillment-dwh-production.curated_data_shared_salesforce.account` 
where LOWER(name)IN (&apos;kitopi catering services l.l.c&apos;,
&apos;sweetheart kitchen catering services llc&apos;)
)
, kitopi_swhk_account AS (
 SELECT a.grid__c, a.global_entity_id, a.name, ksp.name  as group_name FROM `fulfillment-dwh-production.curated_data_shared_salesforce.account` a 
 LEFT JOIN  `fulfillment-dwh-production.curated_data_shared_salesforce.account` p 
 on a.parentid = p.id 
  JOIN kitopi_swhk_parent ksp
 on ksp.id = a.parentid OR ksp.id = p.parentid
)
SELECT 
  v.kitchen_group
, v.kitchen_area
, v.location.latitude
, v.location.longitude
, v.brand
, v.global_entity_id
, v.vendor_id
, k.grid__c
, v.is_own_delivery
, k.group_name
, vkpi.report_month
, vkpi.successful_orders
  FROM `fulfillment-dwh-production.dbt_cl_gfs.vendors` v
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_central_dwh.agg_vendor_kpis_monthly` vkpi
USING (global_entity_id, vendor_id) 
 LEFT JOIN kitopi_swhk_account k
on v.global_entity_id = k.global_entity_id 
and v.salesforce_id =k.grid__c
WHERE v.global_entity_id = &apos;TB_AE&apos;
and k.grid__c IS NOT NULL
and report_month &gt;&gt; &apos;2020-06-01&apos;</relation>
                <relation connection='bigquery.1h1s196105qsor1ajupan1c7tii0' name='tableau_user_entitlement' table='[fulfillment-dwh-production.rl_gfs].[tableau_user_entitlement]' type='table' />
              </relation>
            </properties>
            <properties context='extract'>
              <relation join='inner' type='join'>
                <clause type='join'>
                  <expression op='='>
                    <expression op='[Custom SQL Query].[global_entity_id]' />
                    <expression op='[tableau_user_entitlement].[global_entity_id]' />
                  </expression>
                </clause>
