, kitopi_swhk_account AS (
 SELECT a.grid__c, a.global_entity_id, a.name, ksp.name  as group_name FROM `fulfillment-dwh-production.curated_data_shared_salesforce.account` a 
 LEFT JOIN  `fulfillment-dwh-production.curated_data_shared_salesforce.account` p 
 on a.parentid = p.id 
  JOIN kitopi_swhk_parent ksp
 on ksp.id = a.parentid OR ksp.id = p.parentid
)
SELECT 
  v.kitchen_group
, v.kitchen_area
, v.location.latitude
, v.location.longitude
