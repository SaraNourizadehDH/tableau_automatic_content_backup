            <column-instance column='[metric_value_currency_and_metric_switch (copy)_6115043916215246852]' derivation='Max' name='[max:metric_value_currency_and_metric_switch (copy)_6115043916215246852:nk]' pivot='key' type='nominal' />
            <column caption='Metric Name' datatype='string' name='[metric_name]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;ord_inc_num&quot;' value='Incentivised' />
                <alias key='&quot;ord_uninc_num&quot;' value='Unincentivised' />
                <alias key='&quot;orders_non_pickup_num&quot;' value='Non Pickup' />
