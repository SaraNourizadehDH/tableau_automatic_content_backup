                <alias key='1' value='LC' />
                <alias key='2' value='EUR' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0xx7okr0y0bx2c1dduo4i0vfmw2h'>
            <column caption='Brand Name DH' datatype='string' name='[Calculation_2499849639481999360]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF(ISNULL([global_entity_id]), [brand_name], &apos;DH&apos;)' />
            </column>
            <column caption='Order Date - End' datatype='date' datatype-customized='true' default-format='*dd/mm/yy' name='[Calculation_2703426430128222209]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(IF [granularity] = &apos;monthly&apos; AND [order_date] = DATETRUNC(&apos;month&apos;, [batch_date]) THEN [batch_date]&#10;ELSEIF [granularity] = &apos;monthly&apos; THEN DATE(DATEADD(&apos;day&apos;,-1,(DATEADD(&apos;month&apos;,1,[order_date]))))&#10;ELSEIF [granularity] = &apos;weekly&apos; THEN DATE(DATEADD(&apos;day&apos;, 6, [order_date]))&#10;END)' />
            </column>
            <column caption='afv_aov_title_switch' datatype='string' name='[Calculation_3067021766772797453]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [country_name_capitalized] = &apos;Taiwan&apos; OR [brand_name] = &apos;Deliveroo&apos; THEN &apos;Avg. Order Value&apos;&#10;ELSE &apos;Avg. Basket Value&apos;&#10;END' />
            </column>
            <column caption='period_diff' datatype='integer' name='[Calculation_3268557805155057664]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='iif([granularity] = &apos;monthly&apos;, DATEDIFF(&apos;month&apos;, [order_date], [Parameters].[Parameter 3]),&#10;DATEDIFF(&apos;week&apos;, [order_date], [Parameters].[Parameter 3]))' />
            </column>
            <column caption='sg_avg_total_lower_switch' datatype='real' name='[Calculation_3574802625049272326]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL([global_entity_id]) THEN IIF([Parameters].[Parameter 9] = 1, [orders_aov] - [orders_aov_lower_sem], [orders_aov_eur] - [orders_aov_lower_sem_eur]) END' />
            </column>
            <column caption='sg_avg_total_upper_switch' datatype='real' name='[Calculation_3574802625049399303]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL([global_entity_id]) THEN IIF([Parameters].[Parameter 9] = 1, [orders_aov] + [orders_aov_upper_sem], [orders_aov_eur] + [orders_aov_upper_sem_eur]) END' />
            </column>
            <column caption='sg_avg_afv_aov_lower_switch' datatype='real' name='[Calculation_3574802625049522184]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([country_name_capitalized] = &apos;Taiwan&apos; OR [brand_name] = &apos;Deliveroo&apos;, [Calculation_3574802625049272326], [Calculation_6346979274304024583])' />
            </column>
            <column caption='sg_avg_afv_aov_upper_switch' datatype='real' name='[Calculation_3574802625049808905]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([country_name_capitalized] = &apos;Taiwan&apos; OR [brand_name] = &apos;Deliveroo&apos;, [Calculation_3574802625049399303], [Calculation_6346979274303864838])' />
            </column>
            <column caption='orders_aov_switch' datatype='real' name='[Calculation_3574802625097342990]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 9] = 1, [orders_aov], [orders_aov_eur])' />
            </column>
            <column caption='batch_date_short' datatype='string' default-format='*DD/MM' name='[Calculation_449163714054664203]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='RIGHT(STR([batch_date]), 2) + &quot;-&quot; + MID(STR([batch_date]), 6,2)' />
            </column>
            <column caption='MtD_sign' datatype='string' default-role='measure' default-type='ordinal' name='[Calculation_4883309390215806976]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [granularity] = &apos;monthly&apos; AND [order_date] = DATETRUNC(&apos;month&apos;, [batch_date])&#10;THEN &apos;displays month to &apos; + STR([Calculation_449163714054664203])&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='sg_avg_basket_upper_switch' datatype='real' name='[Calculation_6346979274303864838]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL([global_entity_id]) THEN IIF([Parameters].[Parameter 9] = 1, [orders_abv] + [orders_abv_upper_sem], [orders_abv_eur] + [orders_abv_upper_sem_eur]) END' />
            </column>
            <column caption='sg_avg_basket_lower_switch' datatype='real' name='[Calculation_6346979274304024583]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL([global_entity_id]) THEN IIF([Parameters].[Parameter 9] = 1, [orders_abv] - [orders_abv_lower_sem], [orders_abv_eur] - [orders_abv_lower_sem_eur]) END' />
            </column>
            <column caption='currency_code_switch' datatype='string' name='[Calculation_6346979274305511432]' role='dimension' type='nominal'>
