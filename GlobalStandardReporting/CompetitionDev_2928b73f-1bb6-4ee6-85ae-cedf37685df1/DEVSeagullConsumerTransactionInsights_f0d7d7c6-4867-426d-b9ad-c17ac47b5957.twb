      <aliases enabled='yes' />
      <column caption='Metric Name Thin Receipts Exception' datatype='string' name='[Brand Display Name DH (copy)_787707776872087557]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [country_name_capitalized] IN (&apos;Taiwan&apos;, &apos;Hong Kong&apos;) OR [brand_display_name] = &apos;Deliveroo&apos; THEN &apos;&apos;&#10;ELSEIF [metric_name] IN (&apos;ord_inc_gmv&apos;, &apos;ord_inc_num&apos;) THEN &apos;incentivised&apos;&#10;ELSEIF [metric_name] IN (&apos;ord_uninc_gmv&apos;, &apos;ord_uninc_num&apos;) THEN &apos;unincentivised&apos;&#10;END' />
        <aliases>
          <alias key='&quot;incentivised &quot;' value=' ' />
          <alias key='&quot;incentivised GMV&quot;' value='incentivised' />
          <alias key='&quot;incentivised orders&quot;' value='incentivised ' />
          <alias key='&quot;non-incentivised &quot;' value='    ' />
          <alias key='&quot;unincentivised GMV&quot;' value='non-incentivised' />
          <alias key='&quot;unincentivised orders&quot;' value='non-incentivised ' />
        </aliases>
      </column>
      <column caption='url_confluence' datatype='string' name='[Calculation_1042442627335028746]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;&apos;' />
      </column>
      <column caption='limit_lower_switch' datatype='real' name='[Calculation_1172906273465495552]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 9] = 1, [lower_limit], [lower_limit_eur])' />
      </column>
      <column caption='limit_upper_switch' datatype='real' name='[Calculation_1172906273465622529]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 9] = 1, [upper_limit], [upper_limit_eur])' />
      </column>
      <column caption='display_table' datatype='string' name='[Calculation_157063096749993984]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
      </column>
      <column caption='metric_value_currency_switch_extension' datatype='real' name='[Calculation_1596244618187866115]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_5056346137067720709]) + 0.3 * SUM([Calculation_5056346137067720709])' />
      </column>
      <column caption='metric_value_extension' datatype='real' name='[Calculation_1596244618198568964]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([metric_value]) + 0.3 * MAX([metric_value])' />
      </column>
      <column caption='Order Date - End' datatype='datetime' default-format='*dd/mm/yyyy' name='[Calculation_2703426430124564480]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [granularity] = &apos;monthly&apos; AND [order_date] = DATETRUNC(&apos;month&apos;, [batch_date]) THEN [batch_date]&#10;ELSEIF [granularity] = &apos;monthly&apos; THEN DATE(DATEADD(&apos;day&apos;,-1,(DATEADD(&apos;month&apos;,1,[order_date]))))&#10;ELSEIF [granularity] = &apos;weekly&apos; THEN DATE(DATEADD(&apos;day&apos;, 6, [order_date]))&#10;END' />
      </column>
      <column caption='Brand Display Name DH' datatype='string' name='[Calculation_2894829404494397440]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF(ISNULL([global_entity_id]), [brand_display_name], &apos;DH&apos;)' />
      </column>
      <column caption='period_diff' datatype='integer' name='[Calculation_3268557805156294658]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='iif([granularity] = &apos;monthly&apos;, DATEDIFF(&apos;month&apos;, [order_date], [Parameters].[Parameter 3]),&#10;DATEDIFF(&apos;week&apos;, [order_date], [Parameters].[Parameter 3]))' />
      </column>
      <column caption='metric_value_currency_switch' datatype='real' name='[Calculation_5056346137067720709]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 9] = 1, [metric_value], [metric_value_eur])' />
      </column>
      <column caption='max_batch_date' datatype='datetime' name='[Calculation_513410389178220544]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MAX([batch_date])' />
      </column>
      <column caption='order_date_temp_turkey' datatype='date' name='[Calculation_5251619416721547264]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Turkey&apos; AND [order_date] &lt; DATE(&apos;2022-05-01&apos;) THEN NULL ELSE [order_date] END' />
      </column>
      <column caption='currency_code_switch' datatype='string' name='[Calculation_6346979274308927504]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 9] = 1, [currency_code_complete], &apos;&apos;)' />
      </column>
      <column caption='user_filter_country_kpis_pivot' datatype='boolean' name='[Calculation_711216912983506947]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='USERNAME() = [username]' />
      </column>
      <column caption='batch_date_short' datatype='string' name='[Calculation_748301245566836736]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='RIGHT(STR([batch_date]), 2) + &quot;-&quot; + MID(STR([batch_date]), 6,2)' />
