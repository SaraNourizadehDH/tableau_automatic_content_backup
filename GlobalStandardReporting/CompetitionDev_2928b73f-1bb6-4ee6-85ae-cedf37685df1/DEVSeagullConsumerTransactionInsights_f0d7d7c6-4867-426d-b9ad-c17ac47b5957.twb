      <column caption='icpo_relative_abv_switch' datatype='real' name='[Avg Incentive Per Order Switch (copy)_6357042012163506178]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [country_name_capitalized] = &apos;Taiwan&apos; THEN NULL&#10;ELSEIF [brand_name] = &apos;Deliveroo&apos; AND [order_date] &gt;= #2022-11-01# THEN 0&#10;ELSE IIF([Parameters].[Parameter 9] = 1, [ord_inc_icpo]/[orders_abv], [ord_inc_icpo_eur]/[orders_abv_eur])&#10;END' />
      </column>
      <column caption='Brand Name_avg_incentive_perc_AFV_line' datatype='string' name='[Brand Name (copy 2)_6115043916228304902]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[brand_name]' />
      </column>
      <column caption='Total Incentives Spend SG DH Switch' datatype='real' name='[Calculation_1313643756010041347]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([brand_name] = &apos;Deliveroo&apos; AND [order_date] &gt;= #2022-11-01#, 0, IIF([Parameters].[Parameter 9] = 1, [ord_inc_incentive], [ord_inc_incentive_eur]&#10;))' />
      </column>
      <column aggregation='Sum' caption='one' datatype='integer' name='[Calculation_1313643756081160197]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='diplay_table' datatype='string' name='[Calculation_157063096750972929]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
      </column>
      <column caption='icpo_vs_icpio_lower_label_switch' datatype='string' name='[Calculation_1642758355660812289]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 11] = 1, [sg_icpo_lower_switch_label (copy)_929500757274341399], [Calculation_1667317074175729674])' />
      </column>
      <column caption='icpo_upper_switch' datatype='real' name='[Calculation_1667317074167291909]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([global_entity_id]) THEN IIF([Parameters].[Parameter 9] = 1, [ord_inc_icpo] + [ord_inc_icpo_upper_sem], [ord_inc_icpo_eur] + [ord_inc_icpo_upper_sem_eur]) END' />
      </column>
      <column caption='icpo_lower_switch' datatype='real' name='[Calculation_1667317074167586822]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([global_entity_id]) THEN IIF([Parameters].[Parameter 9] = 1, [ord_inc_icpo] - [ord_inc_icpo_lower_sem], [ord_inc_icpo_eur] - [ord_inc_icpo_lower_sem_eur]) END' />
      </column>
      <column caption='icpo_upper_switch_label' datatype='string' name='[Calculation_1667317074174320649]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL(MAX([global_entity_id]))&#10;THEN &apos; - &apos; + STR(ROUND(SUM([Calculation_6346979274307452943]),2)) + &apos;)&apos;&#10;ELSE &apos;&apos;&#10;END' />
      </column>
      <column caption='icpo_lower_switch_label' datatype='string' name='[Calculation_1667317074175729674]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL(MAX([global_entity_id]))&#10;THEN &apos;(&apos; + STR(ROUND(SUM([Calculation_1667317074167586822]),2))&#10;ELSE &apos;&apos;&#10;END' />
      </column>
      <column caption='customers_upper' datatype='real' name='[Calculation_1778710753048281096]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL(MAX([global_entity_id])) THEN SUM([customers_num]) + SUM([customers_num_std_err]) END' />
      </column>
      <column caption='customers_lower' datatype='real' name='[Calculation_1778710753048641545]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL(MAX([global_entity_id])) THEN SUM([customers_num]) - SUM([customers_num_std_err]) END' />
      </column>
      <column caption='frequency_upper' datatype='real' name='[Calculation_1778710753050316811]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL(MAX([global_entity_id])) THEN SUM([orders_frequency]) + SUM([orders_frequency_std_err]) END' />
      </column>
      <column caption='frequency_lower' datatype='real' name='[Calculation_1778710753050550285]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL(MAX([global_entity_id])) THEN SUM([orders_frequency]) - SUM([orders_frequency_std_err]) END' />
      </column>
      <column caption='icpo_switch' datatype='real' name='[Calculation_196821402008301569]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([brand_name] = &apos;Deliveroo&apos; AND [order_date] &gt;= #2022-11-01#, 0, IIF([Parameters].[Parameter 9] = 1, [ord_inc_icpo], [ord_inc_icpo_eur]))' />
      </column>
      <column caption='Brand Name DH' datatype='string' name='[Calculation_2499849639481999360]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF(ISNULL([global_entity_id]), [brand_name], &apos;DH&apos;)' />
      </column>
      <column caption='Order Date - End' datatype='date' datatype-customized='true' default-format='*dd/mm/yy' name='[Calculation_2703426430128222209]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(IF [granularity] = &apos;monthly&apos; AND [order_date] = DATETRUNC(&apos;month&apos;, [batch_date]) THEN [batch_date]&#10;ELSEIF [granularity] = &apos;monthly&apos; THEN DATE(DATEADD(&apos;day&apos;,-1,(DATEADD(&apos;month&apos;,1,[order_date]))))&#10;ELSEIF [granularity] = &apos;weekly&apos; THEN DATE(DATEADD(&apos;day&apos;, 6, [order_date]))&#10;END)' />
      </column>
      <column caption='Order Date TW - End' datatype='date' default-format='*dd/mm/yyyy' name='[Calculation_2703426430130393090]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='CASE [granularity] WHEN &apos;monthly&apos; THEN DATE(DATEADD(&apos;day&apos;,-1,(DATEADD(&apos;month&apos;,1,[Order Date (copy)_341429202753896448]))))&#10;WHEN &apos;weekly&apos; THEN DATE(DATEADD(&apos;day&apos;, 6, [Order Date (copy)_341429202753896448]))&#10;END' />
      </column>
      <column caption='MoM_gmv_brand_change' datatype='real' name='[Calculation_2789980003287879680]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 9] = 1  THEN [orders_gmv_change_brand] ELSE [orders_gmv_change_eur_brand] END' />
      </column>
      <column caption='MoM_gmv_sg_dh' datatype='real' name='[Calculation_2984197724734918663]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF ([Parameters].[Parameter 9] = 1, [orders_gmv_change], [orders_gmv_change_eur])' />
      </column>
      <column caption='afv_aov_title_switch' datatype='string' name='[Calculation_3067021766772797453]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [country_name_capitalized] = &apos;Taiwan&apos; OR [brand_name] = &apos;Deliveroo&apos; THEN &apos;Avg. Order Value&apos;&#10;ELSE &apos;Avg. Basket Value&apos;&#10;END' />
      </column>
      <column caption='period_diff' datatype='integer' name='[Calculation_3268557805155057664]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='iif([granularity] = &apos;monthly&apos;, DATEDIFF(&apos;month&apos;, [order_date], [Parameters].[Parameter 3]),&#10;DATEDIFF(&apos;week&apos;, [order_date], [Parameters].[Parameter 3]))' />
      </column>
      <column caption='data_validation_sg_switch' datatype='real' name='[Calculation_3328723077499891729]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = 1 AND [granularity] = &apos;weekly&apos; THEN [orders_num_sg_proj]&#10;ELSEIF [Parameters].[Parameter 6] = 2 AND [granularity] != &apos;weekly&apos; THEN [orders_gmv_sg_proj]&#10;ELSEIF [Parameters].[Parameter 6] = 3 AND [granularity] != &apos;weekly&apos; AND [Parameters].[Parameter 1] != &apos;Taiwan&apos; AND [Parameters].[Parameter 1] != &apos;Hong Kong&apos; THEN [orders_abv_sg]&#10;ELSEIF [Parameters].[Parameter 6] = 3 AND [granularity] != &apos;weekly&apos; AND ([Parameters].[Parameter 1] = &apos;Taiwan&apos; OR [Parameters].[Parameter 1] = &apos;Hong Kong&apos;) THEN [orders_aov_sg]&#10;ELSEIF [Parameters].[Parameter 6] = 4 AND [granularity] != &apos;weekly&apos; THEN [delivery_fee_avg_sg]&#10;ELSEIF [Parameters].[Parameter 6] = 5 AND [granularity] != &apos;weekly&apos; THEN [ord_inc_share_sg]&#10;ELSEIF [Parameters].[Parameter 6] = 6 AND [granularity] != &apos;weekly&apos; THEN [customers_num_sg_proj]&#10;ELSEIF [Parameters].[Parameter 6] = 7 AND [granularity] != &apos;weekly&apos; THEN [orders_frequency_sg]&#10;ELSEIF [Parameters].[Parameter 6] = 8 AND [granularity] != &apos;weekly&apos; THEN [device_ios_share_sg]&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='data_validation_actuals_switch' datatype='real' name='[Calculation_3328723077501874194]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = 1 AND [granularity] = &apos;weekly&apos; THEN [orders_num]&#10;ELSEIF [Parameters].[Parameter 6] = 2 AND [granularity] != &apos;weekly&apos; THEN [orders_gmv]&#10;ELSEIF [Parameters].[Parameter 6] = 3 AND [granularity] != &apos;weekly&apos; AND [Parameters].[Parameter 1] != &apos;Taiwan&apos; AND [Parameters].[Parameter 1] != &apos;Hong Kong&apos; THEN [orders_abv]&#10;ELSEIF [Parameters].[Parameter 6] = 3 AND [granularity] != &apos;weekly&apos; AND ([Parameters].[Parameter 1] = &apos;Taiwan&apos; OR [Parameters].[Parameter 1] = &apos;Hong Kong&apos;) THEN [orders_aov]&#10;ELSEIF [Parameters].[Parameter 6] = 4 AND [granularity] != &apos;weekly&apos; THEN [delivery_fee_avg]&#10;ELSEIF [Parameters].[Parameter 6] = 5 AND [granularity] != &apos;weekly&apos; THEN [ord_inc_share]&#10;ELSEIF [Parameters].[Parameter 6] = 6 AND [granularity] != &apos;weekly&apos; THEN [customers_num]&#10;ELSEIF [Parameters].[Parameter 6] = 7 AND [granularity] != &apos;weekly&apos; THEN [orders_frequency]&#10;ELSEIF [Parameters].[Parameter 6] = 8 AND [granularity] != &apos;weekly&apos; THEN [device_ios_share]&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='sg_avg_total_lower_switch' datatype='real' name='[Calculation_3574802625049272326]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([global_entity_id]) THEN IIF([Parameters].[Parameter 9] = 1, [orders_aov] - [orders_aov_lower_sem], [orders_aov_eur] - [orders_aov_lower_sem_eur]) END' />
      </column>
      <column caption='sg_avg_total_upper_switch' datatype='real' name='[Calculation_3574802625049399303]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([global_entity_id]) THEN IIF([Parameters].[Parameter 9] = 1, [orders_aov] + [orders_aov_upper_sem], [orders_aov_eur] + [orders_aov_upper_sem_eur]) END' />
      </column>
      <column caption='sg_avg_afv_aov_lower_switch' datatype='real' name='[Calculation_3574802625049522184]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([country_name_capitalized] = &apos;Taiwan&apos; OR [brand_name] = &apos;Deliveroo&apos;, [Calculation_3574802625049272326], [Calculation_6346979274304024583])' />
      </column>
      <column caption='sg_avg_afv_aov_upper_switch' datatype='real' name='[Calculation_3574802625049808905]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([country_name_capitalized] = &apos;Taiwan&apos; OR [brand_name] = &apos;Deliveroo&apos;, [Calculation_3574802625049399303], [Calculation_6346979274303864838])' />
      </column>
      <column caption='ue_disclaimer' datatype='string' name='[Calculation_3574802625085739019]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF     [country_name_capitalized] = &apos;Taiwan&apos; THEN &apos;From May 2021, consumer transaction insights for UberEats, Taiwan, are limited to orders, net GMV and average order value. Additional metrics, including average food value, are available for other markets.&apos;&#10;ELSEIF [country_name_capitalized] = &apos;Singapore&apos; OR [country_name_capitalized] = &apos;Hong Kong&apos; THEN &apos;From November 2022, consumer transaction insights for Deliveroo are limited to orders, net GMV and average order value.&apos;&#10;ELSEIF [country_name_capitalized] = &apos;Turkey&apos; THEN  &apos;Available for food vertical only.&apos;&#10;ELSE&#10;    &apos;&apos;&#13;END' />
      </column>
      <column caption='orders_aov_switch' datatype='real' name='[Calculation_3574802625097342990]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 9] = 1, [orders_aov], [orders_aov_eur])' />
      </column>
      <column caption='delta_perc_color' datatype='integer' name='[Calculation_3893502624608849922]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IF [data_validation_delta (copy)_3893502624606646273] &gt;= 0.05 AND [data_validation_delta (copy)_3893502624606646273] &lt; 0.01 THEN 1&#10;ELSEIF [data_validation_delta (copy)_3893502624606646273] &lt;= -0.05 AND [data_validation_delta (copy)_3893502624606646273] &gt; -0.1 THEN 1&#10;ELSEIF [data_validation_delta (copy)_3893502624606646273] &gt;= 0.1 THEN 2&#10;ELSEIF [data_validation_delta (copy)_3893502624606646273] &lt;= -0.1 THEN 2&#10;ELSE 0&#10;END' />
      </column>
      <column caption='Incentive Depth ABV/GMV Switch' datatype='real' default-format='p0.0%' name='[Calculation_4160763122327158786]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 12] = 1, [ord_inc_incentive_avg_relative_abv], [ord_inc_icpgmv])' />
      </column>
      <column caption='Relative ABV/GMV Incentivised Orders SG DH Switch' datatype='real' name='[Calculation_4160763122335059972]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([brand_name] = &apos;Deliveroo&apos; AND [order_date] &gt;= #2022-11-01#, 0, IIF([Parameters].[Parameter 12] = 1, ord_inc_abv_relative_total_abv, ord_inc_aov_relative_total_aov))' />
      </column>
      <column caption='Relative ABV/GMV Incentivised Orders Label' datatype='string' name='[Calculation_4160763122366054405]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 12] = 1, &apos;Orders&apos;, &apos;Customers&apos;)' />
      </column>
      <column caption='batch_date_short' datatype='string' default-format='*DD/MM' name='[Calculation_449163714054664203]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='RIGHT(STR([batch_date]), 2) + &quot;-&quot; + MID(STR([batch_date]), 6,2)' />
      </column>
      <column caption='MtD_sign' datatype='string' default-role='measure' default-type='ordinal' name='[Calculation_4883309390215806976]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [granularity] = &apos;monthly&apos; AND [order_date] = DATETRUNC(&apos;month&apos;, [batch_date])&#10;THEN &apos;displays month to &apos; + STR([Calculation_449163714054664203])&#10;ELSE &apos;&apos;&#10;END' />
      </column>
      <column caption='Country Name Capitalized' datatype='string' name='[Calculation_494621904697266180]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [country_name] WHEN &apos;hong_kong&apos; THEN &apos;Hong Kong&apos;&#10;WHEN &apos;saudi_arabia&apos; THEN &apos;Saudi Arabia&apos;&#10;WHEN &apos;chile&apos; THEN NULL&#10;WHEN &apos;argentina&apos; THEN NULL&#10;ELSE UPPER(LEFT([country_name], 1)) + MID([country_name], 2)&#10;END' />
      </column>
      <column caption='items_upper' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_5056346136993615874]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_items_num]) + SUM([orders_items_num_sem])' />
      </column>
      <column caption='items_lower' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_5056346136993796099]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_items_num]) - SUM([orders_items_num_sem])' />
      </column>
      <column caption='vertical_filter' datatype='string' name='[Calculation_5918785480701128709]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Turkey&apos; THEN &apos;food&apos; ELSE &apos;platform&apos; END' />
      </column>
      <column caption='orders_abv_switch' datatype='real' name='[Calculation_6346979274302681089]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 9] = 1, [orders_abv], [orders_abv_eur])' />
      </column>
      <column caption='sg_avg_basket_upper_switch' datatype='real' name='[Calculation_6346979274303864838]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([global_entity_id]) THEN IIF([Parameters].[Parameter 9] = 1, [orders_abv] + [orders_abv_upper_sem], [orders_abv_eur] + [orders_abv_upper_sem_eur]) END' />
      </column>
      <column caption='sg_avg_basket_lower_switch' datatype='real' name='[Calculation_6346979274304024583]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([global_entity_id]) THEN IIF([Parameters].[Parameter 9] = 1, [orders_abv] - [orders_abv_lower_sem], [orders_abv_eur] - [orders_abv_lower_sem_eur]) END' />
      </column>
      <column caption='currency_code_switch' datatype='string' name='[Calculation_6346979274305511432]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 9] = 1, [currency_code_complete], &apos;&apos;)' />
      </column>
      <column caption='df_avg_switch' datatype='real' name='[Calculation_6346979274306031626]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 9] = 1, [delivery_fee_avg], [delivery_fee_avg_eur])' />
      </column>
      <column caption='sg_avg_delivery_fee_lower_switch' datatype='real' name='[Calculation_6346979274307309582]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([global_entity_id]) THEN IIF([Parameters].[Parameter 9] = 1, [delivery_fee_avg] - [delivery_fee_avg_lower_sem], [delivery_fee_avg_eur] - [delivery_fee_avg_lower_sem_eur]) END' />
      </column>
      <column caption='sg_avg_delivery_fee_upper_switch' datatype='real' name='[Calculation_6346979274307452943]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([global_entity_id]) THEN IIF([Parameters].[Parameter 9] = 1, [delivery_fee_avg] + [delivery_fee_avg_upper_sem], [delivery_fee_avg_eur] + [delivery_fee_avg_upper_sem_eur]) END' />
      </column>
      <column caption='display_table' datatype='string' name='[Calculation_6419248001012813824]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
      </column>
      <column caption='country_overview_avg_order_value_title' datatype='string' name='[Calculation_6419248001231986689]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 1] IN (&apos;Taiwan&apos;, &apos;Hong Kong&apos;, &apos;Singapore&apos;), &apos;Avg. Order Value (in &apos; + IIF([Parameters].[Parameter 9] = 1, &apos;LC&apos;, &apos;EUR&apos;) + &apos;)&apos;, &apos;&apos;)' />
      </column>
      <column caption='Null' datatype='integer' name='[Calculation_6609876883174666243]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IF FALSE THEN 0 ELSE NULL END' />
      </column>
      <column caption='user_filter_country_kpis' datatype='boolean' name='[Calculation_711216912983392258]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='USERNAME() = [username]' />
      </column>
      <column caption='currency_switch_sign' datatype='string' name='[Calculation_748301245576802311]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 6] = 2 OR [Parameters].[Parameter 6] = 3 OR [Parameters].[Parameter 6] = 4, &quot;(&quot;+[currency_code_complete]+&quot;)&quot;, &apos;&apos;)' />
      </column>
      <column caption='taiwan_exclude' datatype='boolean' name='[Calculation_758504735335686144]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([country_name_capitalized] = &apos;Taiwan&apos;, FALSE, TRUE)' />
      </column>
      <column caption='data_validation_title' datatype='string' name='[Calculation_787707776860094467]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = 1 THEN &apos;Orders (weekly)&apos;&#10;ELSEIF [Parameters].[Parameter 6] = 2 THEN &apos;GMV&apos;&#10;ELSEIF  [Parameters].[Parameter 6] = 3 AND [country_name_capitalized] = &apos;Taiwan&apos; THEN &apos;AOV&apos;&#10;ELSEIF  [Parameters].[Parameter 6] = 3 AND [country_name_capitalized] != &apos;Taiwan&apos; THEN &apos;AFV&apos;&#10;ELSEIF  [Parameters].[Parameter 6] = 4 THEN &apos;Delivery Fee&apos;&#10;ELSEIF  [Parameters].[Parameter 6] = 5 THEN &apos;Fraction of Incentivised Orders&apos;&#10;ELSEIF [Parameters].[Parameter 6] = 6 THEN &apos;Active Customers&apos;&#10;ELSEIF  [Parameters].[Parameter 6] = 7 THEN &apos;Customer Frequency&apos;&#10;ELSEIF  [Parameters].[Parameter 6] = 8 THEN &apos;iOS Share&apos;&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='orders_date_axis' datatype='date' datatype-customized='true' name='[Calculation_929500757141745664]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(IIF([Parameters].[Parameter 2] = &apos;monthly&apos;, DATETRUNC(&apos;month&apos;, [order_date]), DATETRUNC(&apos;week&apos;, [order_date], &apos;monday&apos;)))' />
      </column>
      <column caption='gmv_perc_total' datatype='real' name='[Calculation_929500757169684485]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_gmv])/TOTAL(SUM([orders_gmv]))*100'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='disclaimer_unavailable' datatype='string' name='[Calculation_929500757220724747]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Turkey&apos; THEN &apos;Available for food vertical only.&apos;&#10;ELSE &apos;Unfortunately this view in unavailable for this country due to limited information on the receipts&apos;&#10;END' />
      </column>
      <column caption='incentives_icpo_icpio_title' datatype='string' name='[Calculation_929500757272784912]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 11] = 1, &apos;Avg. Incentive Per Incentivised Order&apos;, &apos;Avg. Incentive Per Order&apos;)' />
      </column>
      <column caption='icpo_vs_icpio_switch' datatype='real' name='[Calculation_929500757273808915]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 11] = 1, [icpo_switch (copy)_929500757273407506], [Calculation_196821402008301569])' />
      </column>
      <column caption='orders_perc_total' datatype='real' name='[Calculation_929500757287026712]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_num])/TOTAL(SUM([orders_num]))*100'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='icpo_vs_icpio_relative_abv_switch' datatype='real' name='[Calculation_929500757290176540]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 11] = 1, [icpo_relative_abv_switch (copy)_929500757289963547], [Avg Incentive Per Order Switch (copy)_6357042012163506178])' />
      </column>
      <column caption='MtD_sign (copy)' datatype='string' datatype-customized='true' name='[MtD_sign (copy)_3956341934085222402]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [granularity] = &apos;monthly&apos; AND [order_date] = DATETRUNC(&apos;month&apos;, [batch_date])&#10;THEN &apos;displays month to &apos; + STR([Calculation_449163714054664203])&#10;ELSE &apos;&apos;&#10;END' />
      </column>
      <column caption='Order Date TW' datatype='date' default-format='*dd/mm/yyyy' name='[Order Date (copy)_341429202753896448]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='IIF([country_name_capitalized] != &apos;Taiwan&apos;, [order_date],&#10;IIF([country_name_capitalized] = &apos;Taiwan&apos; AND [order_date] &lt;= DATE(&quot;2021-04-30&quot;), [order_date], NULL&#10;))' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='aads_seagull_rl_country_kpis' datatype='table' hidden='true' name='[__tableau_internal_object_id__].[aads_seagull_rl_country_kpis_37AD5B90ABB94824BD82D74E27AAB952]' role='measure' type='quantitative' />
      <column caption='Android Share' datatype='real' hidden='true' name='[android_share]' role='measure' type='quantitative' />
