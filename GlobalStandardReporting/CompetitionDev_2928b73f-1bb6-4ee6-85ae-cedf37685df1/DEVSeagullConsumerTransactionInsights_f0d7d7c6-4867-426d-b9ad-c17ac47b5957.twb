      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0cikb7m12nvk0n14s7es70sqtytm].[sum:total_transactions:qk]&quot;' value=' ' />
        </aliases>
      </column>
      <column caption='Live Active Customers' datatype='integer' name='[Calculation_1830994740580003840]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[num_active_customers] - [num_not_live_active_customers]' />
      </column>
      <column caption='country_name_capitalized' datatype='string' name='[Calculation_1830994740580610049]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [country_name] WHEN &apos;hong_kong&apos; THEN &apos;Hong Kong&apos;&#10;WHEN &apos;saudi_arabia&apos; THEN &apos;Saudi Arabia&apos;&#10;WHEN &apos;chile&apos; THEN NULL&#10;WHEN &apos;argentina&apos; THEN NULL&#10;ELSE UPPER(LEFT([country_name], 1)) + MID([country_name], 2)&#10;END' />
      </column>
      <column caption='Perc Non-Live Active Customers' datatype='real' name='[Calculation_1830994740582117378]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([num_not_live_active_customers])/SUM([num_active_customers])) * 100' />
      </column>
      <column caption='Perc Live Active Customers' datatype='real' name='[Calculation_1830994740582346755]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_1830994740580003840])/SUM([num_active_customers])) * 100' />
      </column>
      <column caption='period_diff' datatype='integer' name='[Calculation_1830994740613406726]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='iif([granularity] = &apos;monthly&apos;, DATEDIFF(&apos;month&apos;, [order_date], [Parameters].[Parameter 3]),&#10;DATEDIFF(&apos;week&apos;, [order_date], [Parameters].[Parameter 3]))' />
      </column>
      <column caption='brand_name_dh' datatype='string' name='[Calculation_1830994740618735624]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF(ISNULL([global_entity_id]), [brand_name], &apos;DH&apos;)' />
      </column>
      <column caption='Live Transactions' datatype='integer' name='[Calculation_1830994740622155785]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[total_transactions] - [num_not_live_transactions]' />
      </column>
      <column caption='Percent Live Transactions' datatype='real' name='[Calculation_1830994740622217226]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_1830994740622155785])/SUM([total_transactions])) * 100' />
      </column>
      <column caption='Percent Non-Live Transactions' datatype='real' name='[Calculation_1830994740622426123]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([num_not_live_transactions])/SUM([total_transactions])) * 100' />
      </column>
      <column caption='user_filter_7' datatype='boolean' name='[Calculation_2149131831806423043]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='USERNAME() = [username]' />
      </column>
      <column caption='Order Date - End' datatype='date' default-format='*dd/mm/yyyy' name='[Calculation_2703426430140956677]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [granularity] = &apos;monthly&apos; AND [order_date] = DATETRUNC(&apos;month&apos;, [batch_date]) THEN [batch_date]&#10;ELSEIF [granularity] = &apos;monthly&apos; THEN DATE(DATEADD(&apos;day&apos;,-1,(DATEADD(&apos;month&apos;,1,[order_date]))))&#10;ELSEIF [granularity] = &apos;weekly&apos; THEN DATE(DATEADD(&apos;day&apos;, 6, [order_date]))&#10;END' />
      </column>
      <column caption='complete_transactions' datatype='integer' name='[Calculation_3951556851386142738]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_transactions])-SUM([num_incomplete_transactions])' />
      </column>
      <column caption='pct_complete_transactions' datatype='real' name='[Calculation_3951556851388289043]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3951556851386142738]/SUM([total_transactions])' />
      </column>
      <column caption='incomplete_transactions_switch' datatype='real' name='[Calculation_3951556851388702740]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 5] = 1, [num_incomplete_transactions], (ROUND([pct_incomplete_transactions],2)*100))' />
      </column>
      <column caption='complete_transactions_switch' datatype='real' name='[Calculation_3951556851389181973]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 5] = 1, [Calculation_3951556851386142738], (ROUND([Calculation_3951556851388289043],2)*100))' />
      </column>
      <column caption='pct_complete_transactions_sign' datatype='string' name='[Calculation_3951556851396825112]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR((ROUND([Calculation_3951556851388289043],2) * 100)) + &apos;%&apos;' />
      </column>
      <column caption='pct_incomplete_transactions_sign' datatype='string' name='[Calculation_3951556851397013529]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR((ROUND([pct_incomplete_transactions],2) * 100)) + &apos;%&apos;' />
      </column>
      <column caption='Non-Live Active Customers Switch' datatype='real' name='[Calculation_449163714022416385]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = 1 THEN SUM([num_not_live_active_customers])&#10;ELSEIF [Parameters].[Parameter 5] = 2 THEN ROUND([Calculation_1830994740582117378], 2)&#10;END' />
      </column>
      <column caption='Live Active Customers Switch' datatype='real' name='[Calculation_449163714023747586]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = 1 THEN SUM([Calculation_1830994740580003840])&#10;ELSEIF [Parameters].[Parameter 5] = 2 THEN ROUND([Calculation_1830994740582346755], 2)&#10;END' />
      </column>
      <column caption='metric_switch_sign' datatype='string' name='[Calculation_449163714025414660]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = 2 THEN &apos;%&apos;&#10;ELSE &apos;&apos;&#10;END' />
      </column>
      <column caption='reference_line_customers_switch' datatype='integer' name='[Calculation_449163714029588485]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [order_date] = DATETRUNC(&apos;month&apos;, TODAY()) THEN NULL&#10;ELSEIF [Parameters].[Parameter 5] = 1 THEN [num_active_customers]&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Non-Live Transactions Switch' datatype='real' name='[Calculation_449163714040066054]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = 1 THEN SUM([num_not_live_transactions])&#10;ELSEIF [Parameters].[Parameter 5] = 2 THEN ROUND([Calculation_449163714040262663], 2)&#10;END' />
      </column>
      <column caption='Perc Non-Live Transactions' datatype='real' name='[Calculation_449163714040262663]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([num_not_live_transactions])/SUM([total_transactions])) * 100' />
      </column>
      <column caption='Perc Live Transactions' datatype='real' name='[Calculation_449163714040729608]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_1830994740622155785])/SUM([total_transactions])) * 100' />
      </column>
      <column caption='Live Transactions Switch' datatype='real' name='[Calculation_449163714041819145]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = 1 THEN SUM([Calculation_1830994740622155785])&#10;ELSEIF [Parameters].[Parameter 5] = 2 THEN ROUND([Calculation_449163714040729608], 2)&#10;END' />
      </column>
      <column caption='reference_line_transactions_switch' datatype='integer' name='[Calculation_449163714042880010]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [order_date] = DATETRUNC(&apos;month&apos;, TODAY()) THEN NULL&#10;ELSEIF [Parameters].[Parameter 5] = 1 THEN [total_transactions]&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='batch_date_short' datatype='string' name='[Calculation_449163714062757900]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='RIGHT(STR([batch_date]), 2) + &quot;-&quot; + MID(STR([batch_date]), 6,2)' />
      </column>
      <column caption='MtD_sign' datatype='string' name='[Calculation_4883309390229311489]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [granularity] = &apos;monthly&apos; AND [order_date] = DATETRUNC(&apos;month&apos;, [batch_date])&#10;THEN &apos;displays month to &apos; + STR([Calculation_449163714062757900])&#10;ELSE &apos;&apos;&#10;END' />
      </column>
      <column caption='vertical_filter' datatype='string' name='[Calculation_5918785480702640135]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Turkey&apos; THEN  &apos;food&apos; ELSE &apos;platform&apos; END' />
      </column>
      <column caption='MtD_sign (copy)' datatype='string' name='[MtD_sign (copy)_3956341934088818691]' role='dimension' type='nominal'>
