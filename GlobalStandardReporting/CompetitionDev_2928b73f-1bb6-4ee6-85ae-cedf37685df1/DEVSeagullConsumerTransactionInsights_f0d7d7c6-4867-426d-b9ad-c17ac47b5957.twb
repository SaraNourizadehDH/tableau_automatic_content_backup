            <column-instance column='[MtD_sign (copy)_3956341934088818691]' derivation='None' name='[none:MtD_sign (copy)_3956341934088818691:nk]' pivot='key' type='nominal' />
            <column-instance column='[batch_date]' derivation='None' name='[none:batch_date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[batch_date]' derivation='None' name='[none:batch_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[brand_name]' derivation='None' name='[none:brand_name:nk]' pivot='key' type='nominal' />
