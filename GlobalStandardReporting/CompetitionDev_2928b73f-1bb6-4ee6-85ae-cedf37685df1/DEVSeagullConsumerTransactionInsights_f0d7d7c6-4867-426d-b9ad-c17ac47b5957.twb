          <datasource-dependencies datasource='federated.0fvazcg1s7jig016m9hc51yacutm'>
            <column aggregation='Sum' caption='period_diff' datatype='integer' name='[Calculation_1042442627306168320]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='iif([granularity] = &apos;monthly&apos;, DATEDIFF(&apos;month&apos;, [order_date], [Parameters].[Parameter 3]),&#10;DATEDIFF(&apos;week&apos;, [order_date], [Parameters].[Parameter 3]))' />
            </column>
            <column caption='MoM_orders_sg_dh' datatype='real' name='[Calculation_1042442627307626498]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM([orders_num])/SUM([prev_orders_sg_dh]))-1)*100' />
            </column>
            <column caption='Order Date - End' datatype='datetime' default-format='*dd/mm/yyyy' name='[Calculation_2703426430137421828]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [granularity] = &apos;monthly&apos; AND [order_date] = DATETRUNC(&apos;month&apos;, [batch_date]) THEN [batch_date]&#10;ELSEIF [granularity] = &apos;monthly&apos; THEN DATE(DATEADD(&apos;day&apos;,-1,(DATEADD(&apos;month&apos;,1,[order_date]))))&#10;ELSEIF [granularity] = &apos;weekly&apos; THEN DATE(DATEADD(&apos;day&apos;, 6, [order_date]))&#10;END' />
            </column>
            <column caption='location_name_corrected' datatype='string' name='[Calculation_5591078241771970561]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Turkey&apos; AND [location_name] = &apos;Capital City&apos; THEN &apos;Main City&apos; ELSE [location_name] END' />
            </column>
            <column caption='vertical_filter' datatype='string' name='[Calculation_5918785480550109188]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Turkey&apos; THEN &apos;food&apos; ELSE &apos;platform&apos; END' />
            </column>
            <column caption='orders_perc_total' datatype='real' name='[Calculation_929500757262282766]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_num])/TOTAL(SUM([orders_num]))*100'>
                <table-calc ordering-type='Rows' />
