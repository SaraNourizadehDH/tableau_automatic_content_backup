          <formatted-text>
            <run bold='true'>AFV </run>
            <run>for </run>
            <run bold='true'>competitor brands </run>
            <run>represents the </run>
            <run bold='true'>&quot;subtotal&quot; </run>
            <run>on</run>
            <run bold='true'> e-receipt.</run>
            <run>Æ&#10;</run>
            <run bold='true'>AFV </run>
            <run>for </run>
            <run bold='true'>DH brands </run>
            <run>aligns with</run>
            <run bold='true'> DH AFV definition:</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true'>Average Food Value </run>
            <run>(AFV): Gross Food Value / # of Orders
</run>
            <run bold='true'>Gross Food Value </run>
            <run>(GFV): Total paid compulsory by customer for food. Excluding service fees and delivery fees. Including VAT.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='fulfillment-dwh-production.rl_intl_markets.aads_seagull_vendor_kpis' name='federated.0xx7okr0y0bx2c1dduo4i0vfmw2h (copy 5)' />
            <datasource caption='fulfillment-dwh-production.rl_intl_markets.aads_seagull_rl_country_kpis' name='federated.0xx7okr0y0bx2c1dduo4i0vfmw2h' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.0xx7okr0y0bx2c1dduo4i0vfmw2h].[country_name_capitalized]' caption='Country' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Hong Kong&quot;'>
              <calculation class='tableau' formula='&quot;Hong Kong&quot;' />
            </column>
            <column alias='EUR' caption='Currency Switch' datatype='integer' name='[Parameter 9]' param-domain-type='list' role='measure' type='quantitative' value='2'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='1' value='LC' />
                <alias key='2' value='EUR' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0xx7okr0y0bx2c1dduo4i0vfmw2h'>
            <column datatype='string' name='[country_name_capitalized]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[country_name_capitalized]' derivation='None' name='[none:country_name_capitalized:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0xx7okr0y0bx2c1dduo4i0vfmw2h (copy 5)'>
            <column caption='currency code switch' datatype='string' name='[Calculation_1716364076510564352]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 9] = 1, &apos;(&apos; + [currency_code_complete] + &apos;)&apos;, &apos;&apos;)' />
            </column>
            <column caption='L3M Selector' datatype='string' name='[Calculation_219620887827877892]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([start_date]) + &quot; to &quot; + STR([end_date])' />
            </column>
            <column caption='metric_currency_switch' datatype='real' name='[Calculation_219620887831154694]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 9] = 2 AND (CONTAINS([metric_name], &apos;abv&apos;) OR CONTAINS([metric_name], &apos;delivery_fee&apos;)), [metric_value_eur], [metric_value])' />
            </column>
            <column caption='brand_name_corr' datatype='string' name='[Calculation_429882679320481792]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF(ISNULL(brand), &apos;&apos;, [brand])' />
            </column>
            <column caption='formated_number' datatype='string' name='[Calculation_429882679321468929]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([metric_name], &apos;change&apos;) OR CONTAINS([metric_name], &apos;trend&apos;) THEN&#10;    IF [metric_value] &lt;= -0.10 THEN LEFT(STR([metric_value]*100), 6) + &apos;%&apos;&#10;    ELSEIF [metric_value] &lt; 0 THEN LEFT(STR([metric_value]*100), 5) + &apos;%&apos;&#10;    ELSEIF [metric_value] &gt;= 0 AND [metric_value] &lt; 0.1 THEN LEFT(STR([metric_value]*100), 4) + &apos;%&apos;&#10;    ELSE LEFT(STR([metric_value]*100), 5) + &apos;%&apos;&#10;    END&#10;ELSEIF CONTAINS([metric_name], &apos;ratio&apos;) THEN&#10;    IF [metric_value] &gt;= 10 THEN LEFT(STR([metric_value]), 5) + &apos;x&apos; ELSE LEFT(STR([metric_value]), 4) + &apos;x&apos; END&#10;ELSE&#10;    IF [Calculation_219620887831154694] &gt;= 100&#10;        THEN LEFT(STR([Calculation_219620887831154694]), 6)&#10;    ELSEIF  [Calculation_219620887831154694] &gt;=10&#10;        THEN LEFT(STR([Calculation_219620887831154694]), 5)&#10;    ELSE&#10;        LEFT(STR([Calculation_219620887831154694]), 4)&#10;    END&#10;END' />
            </column>
            <column caption='ratio_signs' datatype='integer' name='[Calculation_429882679499591682]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF CONTAINS([metric_name], &apos;ratio&apos;) THEN&#10;    IF [metric_value] &lt; 1 THEN -1 ELSE 1 END&#10;ELSEIF CONTAINS([metric_name],&apos;change&apos;) OR CONTAINS([metric_name], &apos;trend&apos;) THEN&#10;    IF [metric_value] &lt; 0 THEN -1 ELSE 1 END&#10;ELSE&#10;    0&#10;END' />
            </column>
            <column datatype='string' name='[brand]' role='dimension' type='nominal' />
            <column datatype='string' name='[country_name_capitalized]' role='dimension' semantic-role='' type='nominal' />
            <column datatype='string' name='[currency_code_complete]' role='dimension' type='nominal' />
