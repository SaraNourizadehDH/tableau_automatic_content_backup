        <title>
          <formatted-text>
            <run bold='true'>ABV</run>
            <run><![CDATA[ in <[Parameters].[Parameter 9]>]]></run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run bold='true'>AFV </run>
            <run>for </run>
            <run bold='true'>competitor brands </run>
            <run>represents the </run>
            <run bold='true'>&quot;subtotal&quot; </run>
