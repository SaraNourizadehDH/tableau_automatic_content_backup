                <alias key='1' value='LC' />
                <alias key='2' value='EUR' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0m9ub5z1h0d3ek1dtmll10j4692h'>
            <column caption='metric_name_thin_receipts_exeption' datatype='string' name='[Calculation_1025905958995038208]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [country_name_capitalized] IN (&apos;Taiwan&apos;) THEN &apos;&apos;&#10;ELSEIF CONTAINS([metric_name], &apos;uninc&apos;) THEN &apos;unincentivised&apos;&#10;ELSEIF CONTAINS([metric_name], &apos;inc&apos;) THEN &apos;incentivised&apos;&#10;END' />
            </column>
            <column caption='display_data' datatype='string' name='[Calculation_1149262390007754754]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[country_name_capitalized]' />
            </column>
            <column caption='Order Date - End' datatype='datetime' default-format='*dd/mm/yyyy' name='[Calculation_2703426430137163779]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [granularity] = &apos;monthly&apos; AND [order_date] = DATETRUNC(&apos;month&apos;, [batch_date]) THEN [batch_date]&#10;ELSEIF [granularity] = &apos;monthly&apos; THEN DATE(DATEADD(&apos;day&apos;,-1,(DATEADD(&apos;month&apos;,1,[order_date]))))&#10;ELSEIF [granularity] = &apos;weekly&apos; THEN DATE(DATEADD(&apos;day&apos;, 6, [order_date]))&#10;END' />
            </column>
            <column caption='MtD_sign_long' datatype='string' name='[Calculation_3574802625109254164]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [granularity] = &apos;monthly&apos; AND [order_date] = DATETRUNC(&apos;month&apos;, [batch_date])&#10;THEN &apos;displays month to &apos; + STR([Calculation_3979985851578519557])&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column aggregation='Sum' caption='period_diff' datatype='integer' name='[Calculation_3979985851575062529]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='iif([granularity] = &apos;monthly&apos;, DATEDIFF(&apos;month&apos;, [order_date], [Parameters].[Parameter 3]),&#10;DATEDIFF(&apos;week&apos;, [order_date], [Parameters].[Parameter 3]))' />
            </column>
            <column caption='batch_date_short' datatype='string' name='[Calculation_3979985851578519557]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='RIGHT(STR([batch_date]), 2) + &quot;-&quot; + MID(STR([batch_date]), 6,2)' />
            </column>
            <column caption='MtD_sign' datatype='string' name='[Calculation_3979985851578675206]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [granularity] = &apos;monthly&apos; AND [order_date] = DATETRUNC(&apos;month&apos;, [batch_date])&#10;THEN &apos;(month to &apos; + STR([Calculation_3979985851578519557]) + &apos;)&apos;&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='metric_value_currency_switch' datatype='real' name='[Calculation_3979985851584872457]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 9] = 1, [metric_value], [metric_value_eur (aads_seagull_rl_geo_breakdown_kpis_pivot)])' />
            </column>
            <column caption='metric_value_currency_and_metric_switch' datatype='real' name='[Calculation_3979985851585749002]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MAX([country_name_capitalized]) IN (&apos;Taiwan&apos;, &apos;Hong Kong&apos;) THEN  NULL&#10;ELSEIF ([Parameters].[Parameter 9] = 1 AND [Parameters].[Parameter 5] = 1) OR MAX([metric_name]) IN (&apos;ord_inc_num&apos;, &apos;ord_uninc_num&apos;) THEN MAX([metric_value])/1000000&#10;ELSEIF [Parameters].[Parameter 9] = 1 AND [Parameters].[Parameter 5] = 2 THEN (SUM({FIXED [country_name_capitalized], [order_date], [brand_display_name], [location_name], [metric_name]: SUM([metric_value])}) / SUM({FIXED  [country_name_capitalized], [order_date], [location_name], [brand_display_name]: SUM([metric_value])})) *100&#10;ELSEIF [Parameters].[Parameter 9] = 2 AND [Parameters].[Parameter 5] = 1 THEN MAX([metric_value_eur (aads_seagull_rl_geo_breakdown_kpis_pivot)])/1000000&#10;ELSEIF [Parameters].[Parameter 9] = 2 AND [Parameters].[Parameter 5] = 2 THEN (SUM({FIXED [country_name_capitalized], [order_date], [brand_display_name], [location_name], [metric_name]: SUM([metric_value])}) / SUM({FIXED  [country_name_capitalized], [order_date], [location_name], [brand_display_name]: SUM([metric_value_eur (aads_seagull_rl_geo_breakdown_kpis_pivot)])})) *100&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='metric_value_currency_switch_extension' datatype='real' name='[Calculation_3979985851587166219]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_3979985851584872457]) + 0.3 * SUM([Calculation_3979985851584872457])' />
            </column>
            <column caption='metric_value_percent_share' datatype='real' name='[Calculation_3979985851587461132]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM({FIXED [country_name_capitalized], [order_date], [brand_display_name], [location_name], [metric_name]: SUM([metric_value])}) / SUM({FIXED  [country_name_capitalized], [order_date], [location_name], [brand_display_name]: SUM([metric_value])})) *100' />
            </column>
            <column caption='metric_value_currency_switch_sign' datatype='string' name='[Calculation_3979985851587616781]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [country_name_capitalized] IN (&apos;Taiwan&apos;, &apos;Hong Kong&apos;) THEN &apos;&apos; &#10;ELSEIF [Parameters].[Parameter 5] = 1 OR [metric_name] IN (&apos;ord_inc_num&apos;, &apos;ord_uninc_num&apos;) THEN &apos;M&apos;&#10;ELSEIF [Parameters].[Parameter 5] = 2 THEN &apos;%&apos;&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='currency_code_switch' datatype='string' name='[Calculation_3979985851588153358]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Taiwan&apos; AND [Parameters].[Parameter 9] = 1 THEN &apos;TWD&apos;&#10;ELSEIF  [Parameters].[Parameter 9] = 1 THEN [currency_code]&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='location_name_corrected' datatype='string' name='[Calculation_5591078241771384832]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Turkey&apos; AND [location_name] = &apos;Capital City&apos; THEN &apos;Main City&apos; ELSE [location_name] END' />
            </column>
            <column caption='vertical_filter' datatype='string' name='[Calculation_5918785480547184641]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Turkey&apos; THEN &apos;food&apos; ELSE &apos;platform&apos; END' />
            </column>
