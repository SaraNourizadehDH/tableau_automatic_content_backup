              <calculation class='tableau' formula='&quot;Hong Kong&quot;' />
            </column>
            <column alias='Delivery Fee' caption='KPI Selector' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;delivery_fee&quot;'>
