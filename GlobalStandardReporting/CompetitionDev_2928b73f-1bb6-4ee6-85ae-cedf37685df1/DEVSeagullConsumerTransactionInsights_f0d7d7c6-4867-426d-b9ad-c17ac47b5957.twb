              </aliases>
            </column>
            <column caption='Metric Value' datatype='real' name='[metric_value]' role='measure' type='quantitative' />
            <column caption='metric_value_currency_and_metric_switch_sign_thinreceipts' datatype='string' name='[metric_value_currency_and_metric_switch (copy)_6115043916215246852]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [country_name_capitalized] IN (&apos;Taiwan&apos;, &apos;Hong Kong&apos;) OR [brand_display_name] IN (&apos;UberEats&apos;, &apos;Deliveroo&apos;) THEN &apos;&apos;&#10;ELSEIF ([Parameters].[Parameter 9] = 1 AND [Parameters].[Parameter 5] = 1 OR [metric_name] IN (&apos;ord_inc_num&apos;, &apos;ord_uninc_num&apos;)) THEN &apos;M&apos;&#10;ELSEIF [Parameters].[Parameter 9] = 1 AND [Parameters].[Parameter 5] = 2 AND ([country_name_capitalized] != &apos;Taiwan&apos; AND [brand_display_name] != &apos;UberEats&apos;) THEN &apos;%&apos;&#10;ELSEIF [Parameters].[Parameter 9] = 2 AND [Parameters].[Parameter 5] = 1 AND ([country_name_capitalized] != &apos;Taiwan&apos; AND [brand_display_name] != &apos;UberEats&apos;) THEN &apos;M&apos;&#10;ELSEIF [Parameters].[Parameter 9] = 2 AND [Parameters].[Parameter 5] = 2 AND ([country_name_capitalized] != &apos;Taiwan&apos; AND [brand_display_name] != &apos;UberEats&apos;) THEN &apos;%&apos;&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='metric_value_percent_share' datatype='real' name='[metric_value_currency_and_metric_switch (copy)_6115043916216594437]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM({FIXED [country_name_capitalized], [order_date], [brand_display_name], [metric_name]: SUM([metric_value])}) / SUM({FIXED  [country_name_capitalized], [order_date], [brand_display_name]: SUM([metric_value])})) *100' />
            </column>
            <column caption='metric_value_currency_and_metric_switch' datatype='real' name='[metric_value_currency_switch (copy)_6115043916210712579]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[Parameter 9] = 1 AND [Parameters].[Parameter 5] = 1) OR MAX([metric_name]) IN (&apos;ord_uninc_num&apos;, &apos;ord_inc_num&apos;) THEN MAX([metric_value])/1000000&#10;ELSEIF [Parameters].[Parameter 9] = 1 AND [Parameters].[Parameter 5] = 2 THEN (SUM({FIXED [country_name_capitalized], [order_date], [brand_display_name], [metric_name]: SUM([metric_value])}) / SUM({FIXED  [country_name_capitalized], [order_date], [brand_display_name]: SUM([metric_value])})) *100&#10;ELSEIF [Parameters].[Parameter 9] = 2 AND [Parameters].[Parameter 5] = 1 THEN MAX([metric_value_eur])/1000000&#10;ELSEIF [Parameters].[Parameter 9] = 2 AND [Parameters].[Parameter 5] = 2 THEN (SUM({FIXED [country_name_capitalized], [order_date], [brand_display_name], [metric_name]: SUM([metric_value])}) / SUM({FIXED  [country_name_capitalized], [order_date], [brand_display_name]: SUM([metric_value])})) *100&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='metric_value_currency_switch_thinreceipts' datatype='real' name='[metric_value_currency_switch (copy)_787707776896245772]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([country_name_capitalized] IN (&apos;Taiwan&apos;) OR [brand_display_name] IN (&apos;UberEats&apos;), NULL, [Calculation_5056346137067720709])' />
            </column>
            <column caption='Metric Value Eur' datatype='real' name='[metric_value_eur]' role='measure' type='quantitative' />
            <column caption='metric_value_percent_share_thinreceipts' datatype='real' name='[metric_value_percent_share (copy)_787707776896598029]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF(MAX([country_name_capitalized]) IN (&apos;Taiwan&apos;) OR MAX([brand_display_name]) IN (&apos;UberEats&apos;), NULL, [metric_value_currency_and_metric_switch (copy)_6115043916216594437])' />
            </column>
