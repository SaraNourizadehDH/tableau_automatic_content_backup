      <column caption='Avg Incentive Per Order' datatype='real' hidden='true' name='[avg_incentive_per_order]' role='measure' type='quantitative' />
      <column caption='Avg Total' datatype='real' hidden='true' name='[avg_total]' role='measure' type='quantitative' />
