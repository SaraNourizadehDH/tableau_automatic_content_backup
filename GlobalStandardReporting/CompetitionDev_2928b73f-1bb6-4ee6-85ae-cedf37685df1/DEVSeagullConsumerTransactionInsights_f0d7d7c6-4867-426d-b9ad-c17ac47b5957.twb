            </column>
            <column caption='Order Date - End' datatype='datetime' default-format='*dd/mm/yyyy' name='[Calculation_2703426430124564480]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [granularity] = &apos;monthly&apos; AND [order_date] = DATETRUNC(&apos;month&apos;, [batch_date]) THEN [batch_date]&#10;ELSEIF [granularity] = &apos;monthly&apos; THEN DATE(DATEADD(&apos;day&apos;,-1,(DATEADD(&apos;month&apos;,1,[order_date]))))&#10;ELSEIF [granularity] = &apos;weekly&apos; THEN DATE(DATEADD(&apos;day&apos;, 6, [order_date]))&#10;END' />
            </column>
            <column caption='Brand Display Name DH' datatype='string' name='[Calculation_2894829404494397440]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF(ISNULL([global_entity_id]), [brand_display_name], &apos;DH&apos;)' />
            </column>
            <column caption='period_diff' datatype='integer' name='[Calculation_3268557805156294658]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='iif([granularity] = &apos;monthly&apos;, DATEDIFF(&apos;month&apos;, [order_date], [Parameters].[Parameter 3]),&#10;DATEDIFF(&apos;week&apos;, [order_date], [Parameters].[Parameter 3]))' />
            </column>
            <column caption='batch_date_short' datatype='string' name='[Calculation_748301245566836736]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='RIGHT(STR([batch_date]), 2) + &quot;-&quot; + MID(STR([batch_date]), 6,2)' />
            </column>
            <column caption='MtD_sign' datatype='string' name='[Calculation_748301245566943233]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [granularity] = &apos;monthly&apos; AND [order_date] = DATETRUNC(&apos;month&apos;, [batch_date])&#10;THEN &apos;(month to &apos; + STR([Calculation_748301245566836736]) + &apos;)&apos;&#10;ELSE &apos;&apos;&#10;END' />
            </column>
