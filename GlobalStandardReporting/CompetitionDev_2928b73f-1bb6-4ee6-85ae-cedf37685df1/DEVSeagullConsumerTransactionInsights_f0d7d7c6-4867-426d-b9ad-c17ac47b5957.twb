              <calculation class='tableau' formula='IF [Parameters].[KPI Selector (copy)] = &apos;Orders&apos; THEN [n_orders]&#10;ELSEIF [Parameters].[KPI Selector (copy)] = &apos;Customers&apos; THEN [n_customers]&#10;ELSEIF [Parameters].[KPI Selector (copy)] = &apos;GMV&apos; THEN [Calculation_828662381966979074]&#10;ELSEIF [Parameters].[KPI Selector (copy)] = &apos;Frequency&apos; THEN [order_frequency]&#10;ELSEIF [Parameters].[KPI Selector (copy)] = &apos;Avg. Basket&apos; THEN [Calculation_828662381965627392]&#10;ELSEIF [Parameters].[KPI Selector (copy)] = &apos;Avg. Delivery Fee&apos; THEN [Calculation_828662381966688257]&#10;ELSEIF [Parameters].[KPI Selector (copy)] = &apos;Avg. Incentives&apos; THEN [Calculation_828662381967224836]&#10;END' />
