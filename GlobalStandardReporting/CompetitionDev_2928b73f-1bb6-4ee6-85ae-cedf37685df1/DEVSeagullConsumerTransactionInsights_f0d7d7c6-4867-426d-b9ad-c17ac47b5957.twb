      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'><![CDATA[Food Value (in <[federated.0xx7okr0y0bx2c1dduo4i0vfmw2h (copy 2)].[none:currency_code:nk]>)]]></run>
            <run>Æ&#10;&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='fulfillment-dwh-production.rl_intl_markets.aads_seagull_kpi_distribution' name='federated.0xx7okr0y0bx2c1dduo4i0vfmw2h (copy 2)' />
            <datasource caption='fulfillment-dwh-production.rl_intl_markets.aads_seagull_rl_country_kpis' name='federated.0xx7okr0y0bx2c1dduo4i0vfmw2h' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.0xx7okr0y0bx2c1dduo4i0vfmw2h].[country_name_capitalized]' caption='Country' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Hong Kong&quot;'>
              <calculation class='tableau' formula='&quot;Hong Kong&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0xx7okr0y0bx2c1dduo4i0vfmw2h'>
            <column datatype='string' name='[country_name_capitalized]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0xx7okr0y0bx2c1dduo4i0vfmw2h (copy 2)'>
            <column caption='Country Name Capitalized' datatype='string' name='[Calculation_1534109003627954177]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [country_name] WHEN &apos;hong_kong&apos; THEN &apos;Hong Kong&apos;&#10;WHEN &apos;saudi_arabia&apos; THEN &apos;Saudi Arabia&apos;&#10;WHEN &apos;chile&apos; THEN NULL&#10;WHEN &apos;argentina&apos; THEN NULL&#10;ELSE UPPER(LEFT([country_name], 1)) + MID([country_name], 2)&#10;END' />
            </column>
            <column caption='orders_x_pct' datatype='real' name='[Calculation_1534109003629539330]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[orders] * [pct]' />
            </column>
            <column caption='weighted_pct' datatype='real' name='[Calculation_1534109003631669252]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF([Calculation_1534109003634655237] = &apos;Deliveroo&apos; AND [kpi] &lt;&gt; &apos;frequency&apos;) THEN NULL ELSE [Calculation_1534109003629539330] END)/SUM([orders])' />
            </column>
            <column caption='Brand Display Name DH' datatype='string' name='[Calculation_1534109003634655237]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF(ISNULL([global_entity_id]), [brand_name], &apos;DH&apos;)' />
            </column>
            <column caption='Seagull vs Internal Filter' datatype='string' name='[Calculation_1534109003658559494]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_actual] THEN &apos;DH Internal&apos;&#10;ELSEIF INT([is_actual]) = 0 AND ISNULL([global_entity_id]) THEN &apos;Competitor Seagull&apos;&#10;ELSEIF INT([is_actual]) = 0 AND NOT ISNULL([global_entity_id]) THEN &apos;DH Seagull&apos;&#10;ELSE &apos;unknown&apos;&#10;END' />
            </column>
            <column caption='display_table' datatype='string' name='[Calculation_5304747833181118468]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
            </column>
            <column caption='vertical_filter' datatype='string' name='[Calculation_5918785480701550598]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Turkey&apos; THEN &apos;food&apos; ELSE &apos;platform&apos; END' />
            </column>
