          <datasource-dependencies datasource='federated.0xx7okr0y0bx2c1dduo4i0vfmw2h'>
            <column caption='Total Incentives Spend SG DH Switch' datatype='real' name='[Calculation_1313643756010041347]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([brand_name] = &apos;Deliveroo&apos; AND [order_date] &gt;= #2022-11-01#, 0, IIF([Parameters].[Parameter 9] = 1, [ord_inc_incentive], [ord_inc_incentive_eur]&#10;))' />
            </column>
            <column caption='diplay_table' datatype='string' name='[Calculation_157063096750972929]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
            </column>
            <column caption='Order Date - End' datatype='date' datatype-customized='true' default-format='*dd/mm/yy' name='[Calculation_2703426430128222209]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(IF [granularity] = &apos;monthly&apos; AND [order_date] = DATETRUNC(&apos;month&apos;, [batch_date]) THEN [batch_date]&#10;ELSEIF [granularity] = &apos;monthly&apos; THEN DATE(DATEADD(&apos;day&apos;,-1,(DATEADD(&apos;month&apos;,1,[order_date]))))&#10;ELSEIF [granularity] = &apos;weekly&apos; THEN DATE(DATEADD(&apos;day&apos;, 6, [order_date]))&#10;END)' />
            </column>
            <column caption='Order Date TW - End' datatype='date' default-format='*dd/mm/yyyy' name='[Calculation_2703426430130393090]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='CASE [granularity] WHEN &apos;monthly&apos; THEN DATE(DATEADD(&apos;day&apos;,-1,(DATEADD(&apos;month&apos;,1,[Order Date (copy)_341429202753896448]))))&#10;WHEN &apos;weekly&apos; THEN DATE(DATEADD(&apos;day&apos;, 6, [Order Date (copy)_341429202753896448]))&#10;END' />
            </column>
            <column caption='period_diff' datatype='integer' name='[Calculation_3268557805155057664]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='iif([granularity] = &apos;monthly&apos;, DATEDIFF(&apos;month&apos;, [order_date], [Parameters].[Parameter 3]),&#10;DATEDIFF(&apos;week&apos;, [order_date], [Parameters].[Parameter 3]))' />
            </column>
            <column caption='batch_date_short' datatype='string' default-format='*DD/MM' name='[Calculation_449163714054664203]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='RIGHT(STR([batch_date]), 2) + &quot;-&quot; + MID(STR([batch_date]), 6,2)' />
            </column>
            <column caption='MtD_sign' datatype='string' default-role='measure' default-type='ordinal' name='[Calculation_4883309390215806976]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [granularity] = &apos;monthly&apos; AND [order_date] = DATETRUNC(&apos;month&apos;, [batch_date])&#10;THEN &apos;displays month to &apos; + STR([Calculation_449163714054664203])&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='Country Name Capitalized' datatype='string' name='[Calculation_494621904697266180]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [country_name] WHEN &apos;hong_kong&apos; THEN &apos;Hong Kong&apos;&#10;WHEN &apos;saudi_arabia&apos; THEN &apos;Saudi Arabia&apos;&#10;WHEN &apos;chile&apos; THEN NULL&#10;WHEN &apos;argentina&apos; THEN NULL&#10;ELSE UPPER(LEFT([country_name], 1)) + MID([country_name], 2)&#10;END' />
            </column>
            <column caption='currency_code_switch' datatype='string' name='[Calculation_6346979274305511432]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 9] = 1, [currency_code_complete], &apos;&apos;)' />
            </column>
            <column caption='taiwan_exclude' datatype='boolean' name='[Calculation_758504735335686144]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([country_name_capitalized] = &apos;Taiwan&apos;, FALSE, TRUE)' />
            </column>
            <column caption='MtD_sign (copy)' datatype='string' datatype-customized='true' name='[MtD_sign (copy)_3956341934085222402]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [granularity] = &apos;monthly&apos; AND [order_date] = DATETRUNC(&apos;month&apos;, [batch_date])&#10;THEN &apos;displays month to &apos; + STR([Calculation_449163714054664203])&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='Order Date TW' datatype='date' default-format='*dd/mm/yyyy' name='[Order Date (copy)_341429202753896448]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='IIF([country_name_capitalized] != &apos;Taiwan&apos;, [order_date],&#10;IIF([country_name_capitalized] = &apos;Taiwan&apos; AND [order_date] &lt;= DATE(&quot;2021-04-30&quot;), [order_date], NULL&#10;))' />
