      <aliases enabled='yes' />
      <column caption='correlations_switch' datatype='real' name='[Calculation_1642758355674648579]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = 1 AND [granularity] = &apos;weekly&apos; THEN [orders_num_corr]&#10;ELSEIF [Parameters].[Parameter 6] = 2 AND [granularity] != &apos;weekly&apos; THEN [orders_gmv_corr]&#10;ELSEIF [Parameters].[Parameter 6] = 3 AND [granularity] != &apos;weekly&apos; AND [Parameters].[Parameter 1] != &apos;Taiwan&apos; AND [Parameters].[Parameter 1] != &apos;Hong Kong&apos; THEN [orders_abv_corr]&#10;ELSEIF [Parameters].[Parameter 6] = 3 AND [granularity] != &apos;weekly&apos; AND ([Parameters].[Parameter 1] = &apos;Taiwan&apos; OR [Parameters].[Parameter 1] = &apos;Hong Kong&apos;) THEN [orders_aov_corr]&#10;ELSEIF [Parameters].[Parameter 6] = 4 AND [granularity] != &apos;weekly&apos; THEN [delivery_fee_avg_corr]&#10;ELSEIF [Parameters].[Parameter 6] = 5 AND [granularity] != &apos;weekly&apos; THEN [ord_inc_share_corr]&#10;ELSEIF [Parameters].[Parameter 6] = 6 AND [granularity] != &apos;weekly&apos; THEN [customers_num_corr]&#10;ELSEIF [Parameters].[Parameter 6] = 7 AND [granularity] != &apos;weekly&apos; THEN [frequency_corr]&#10;ELSEIF [Parameters].[Parameter 6] = 8 AND [granularity] != &apos;weekly&apos; THEN [device_ios_share_corr]&#10;ELSE NULL&#10;END' />
      </column>
