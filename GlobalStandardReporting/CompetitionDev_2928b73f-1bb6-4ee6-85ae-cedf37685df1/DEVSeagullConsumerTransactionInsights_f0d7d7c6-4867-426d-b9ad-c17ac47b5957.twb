            <column datatype='real' name='[device_ios_share]' role='measure' type='quantitative' />
            <column datatype='real' name='[device_ios_share_sg]' role='measure' type='quantitative' />
            <column caption='Display Date' datatype='string' name='[display_date]' role='dimension' type='nominal' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Granularity' datatype='string' name='[granularity]' role='dimension' type='nominal' />
            <column caption='Is Reliable' datatype='boolean' name='[is_reliable]' role='dimension' type='nominal' />
            <column caption='Is Thin Receipt' datatype='boolean' name='[is_thin_receipt]' role='dimension' type='nominal' />
