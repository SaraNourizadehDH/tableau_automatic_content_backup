      <column caption='Calibration' datatype='real' hidden='true' name='[calibration]' role='measure' type='quantitative' />
      <column caption='Calibration Relative Error' datatype='real' hidden='true' name='[calibration_relative_error]' role='measure' type='quantitative' />
      <column caption='Country Code' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column datatype='string' name='[country_name_capitalized]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column caption='Currency Code' datatype='string' name='[currency_code]' role='dimension' type='nominal' />
      <column caption='Currency Code Complete' datatype='string' name='[currency_code_complete]' role='dimension' type='nominal' />
      <column datatype='real' name='[customers_num]' role='measure' type='quantitative' />
      <column caption='data_validation_delta_perc' datatype='real' name='[data_validation_delta (copy)_3893502624606646273]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = 1 AND [granularity] = &apos;weekly&apos; THEN [orders_num_delta]&#10;ELSEIF [Parameters].[Parameter 6] = 2 AND [granularity] != &apos;weekly&apos; THEN [orders_gmv_delta]&#10;ELSEIF [Parameters].[Parameter 6] = 3 AND [granularity] != &apos;weekly&apos; AND [Parameters].[Parameter 1] != &apos;Taiwan&apos; AND [Parameters].[Parameter 1] != &apos;Hong Kong&apos; THEN [orders_abv_delta]&#10;ELSEIF [Parameters].[Parameter 6] = 3 AND [granularity] != &apos;weekly&apos; AND ([Parameters].[Parameter 1] = &apos;Taiwan&apos; OR [Parameters].[Parameter 1] = &apos;Hong Kong&apos;) THEN [orders_aov_delta]&#10;ELSEIF [Parameters].[Parameter 6] = 4 AND [granularity] != &apos;weekly&apos; THEN [delivery_fee_avg_delta]&#10;ELSEIF [Parameters].[Parameter 6] = 5 AND [granularity] != &apos;weekly&apos; THEN [ord_inc_share_delta]&#10;ELSEIF [Parameters].[Parameter 6] = 6 AND [granularity] != &apos;weekly&apos; THEN [customers_num_delta]&#10;ELSEIF [Parameters].[Parameter 6] = 7 AND [granularity] != &apos;weekly&apos; THEN [orders_frequency_delta]&#10;ELSEIF [Parameters].[Parameter 6] = 8 AND [granularity] != &apos;weekly&apos; THEN [device_ios_share_delta]&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Discount Share' datatype='real' hidden='true' name='[discount_share]' role='measure' type='quantitative' />
      <column caption='Display Date' datatype='string' name='[display_date]' role='dimension' type='nominal' />
      <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
      <column caption='Gmv' datatype='real' hidden='true' name='[gmv]' role='measure' type='quantitative' />
      <column caption='gmv EUR' datatype='real' hidden='true' name='[gmv_EUR]' role='measure' type='quantitative' />
      <column caption='Gmv Scaling Factor' datatype='real' hidden='true' name='[gmv_scaling_factor]' role='measure' type='quantitative' />
      <column caption='Granularity' datatype='string' name='[granularity]' role='dimension' type='nominal' />
      <column caption='icpio_relative_abv_switch' datatype='real' name='[icpo_relative_abv_switch (copy)_929500757289963547]' role='measure' type='quantitative'>
