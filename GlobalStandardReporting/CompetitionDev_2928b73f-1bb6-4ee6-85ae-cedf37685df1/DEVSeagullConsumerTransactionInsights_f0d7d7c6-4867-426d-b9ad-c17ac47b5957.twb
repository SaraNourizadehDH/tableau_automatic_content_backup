    <dashboard name='Vendor Overview'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>AFV</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/Seagull-ConsumerTransactionInsightsDRAFT/VendorOverview?rev=' id='VendorOverview' path='/t/GlobalStandardReporting/workbooks/DEV-Seagull-ConsumerTransactionInsights' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='dash-text'>
          <format attr='vertical-align' id='dash-text_593' value='top' />
        </style-rule>
      </style>
      <size maxheight='2450' maxwidth='1000' minheight='2450' minwidth='1000' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
