      <column caption='MoM_orders_sg_dh' datatype='real' name='[Calculation_1042442627307626498]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((SUM([orders_num])/SUM([prev_orders_sg_dh]))-1)*100' />
      </column>
      <column caption='MoM_gmv_sg_dh' datatype='real' name='[Calculation_1042442627330809863]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([orders_gmv])/SUM([prev_gmv_sg_dh]))-1' />
      </column>
      <column aggregation='CountD' caption='MtD_sign' datatype='string' name='[Calculation_1875115977519030274]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [granularity] = &apos;monthly&apos; AND [order_date] = DATETRUNC(&apos;month&apos;, [batch_date])&#10;THEN &apos;displays month to &apos; + STR([Calculation_1875115977519095811])&#10;ELSE &apos;&apos;&#10;END' />
      </column>
      <column caption='batch_date_short' datatype='string' name='[Calculation_1875115977519095811]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='RIGHT(STR([batch_date]), 2) + &quot;-&quot; + MID(STR([batch_date]), 6,2)' />
      </column>
      <column caption='Avg Incentive Per Order Switch' datatype='real' name='[Calculation_1875115977521332229]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 9] = 1, [ord_inc_icpo], [ord_inc_icpo_eur])' />
      </column>
      <column caption='currency_code_switch' datatype='string' name='[Calculation_1875115977522012169]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 9] = 1, [currency_code_complete], &apos;&apos;)' />
      </column>
      <column caption='Avg Basket Switch' datatype='real' name='[Calculation_1875115977532620820]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 9] = 1, [orders_abv], [orders_abv_eur])' />
      </column>
      <column caption='Brand Name DH' datatype='string' name='[Calculation_1875115977535041559]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF(ISNULL([global_entity_id]), [brand_name], &apos;DH&apos;)' />
      </column>
      <column caption='user_filter_region_kpis' datatype='boolean' name='[Calculation_2149131831806296065]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='USERNAME() = [username]' />
      </column>
      <column caption='Order Date - End' datatype='datetime' default-format='*dd/mm/yyyy' name='[Calculation_2703426430137421828]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [granularity] = &apos;monthly&apos; AND [order_date] = DATETRUNC(&apos;month&apos;, [batch_date]) THEN [batch_date]&#10;ELSEIF [granularity] = &apos;monthly&apos; THEN DATE(DATEADD(&apos;day&apos;,-1,(DATEADD(&apos;month&apos;,1,[order_date]))))&#10;ELSEIF [granularity] = &apos;weekly&apos; THEN DATE(DATEADD(&apos;day&apos;, 6, [order_date]))&#10;END' />
      </column>
      <column caption='Avg Delivery Fee Switch' datatype='real' name='[Calculation_3067021766764199936]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 9] = 1, [delivery_fee_avg], [delivery_fee_avg_eur (aads_seagull_rl_geo_breakdown_kpis)])' />
      </column>
      <column caption='region_label_linechart' datatype='string' default-role='measure' default-type='ordinal' name='[Calculation_3067021766769016843]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [granularity] = &apos;weekly&apos; AND DATEDIFF(&apos;week&apos;, [order_date], TODAY()) &lt; 3 THEN [Calculation_5591078241771970561]&#10;ELSEIF [granularity] = &apos;monthly&apos; AND DATEDIFF(&apos;month&apos;, [order_date], TODAY()) &lt; 2 THEN [Calculation_5591078241771970561]&#10;ELSE &apos;&apos;&#10;END' />
        <aliases>
          <alias key='&quot;east_coast&quot;' value='East Coast' />
          <alias key='&quot;johor&quot;' value='Johor' />
          <alias key='&quot;klang_valley&quot;' value='Klang Valley' />
          <alias key='&quot;melaka_&amp;_n9&quot;' value='Melaka' />
          <alias key='&quot;north&quot;' value='North' />
          <alias key='&quot;sabah&quot;' value='Sabah' />
          <alias key='&quot;sarawak&quot;' value='Sarawak' />
        </aliases>
      </column>
      <column caption='MtD_sign_long' datatype='string' name='[Calculation_3574802625108979731]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [granularity] = &apos;monthly&apos; AND [order_date] = DATETRUNC(&apos;month&apos;, [batch_date])&#10;THEN &apos;displays month to &apos; + STR([Calculation_1875115977519095811])&#10;ELSE &apos;&apos;&#10;END' />
      </column>
      <column caption='location_name_corrected' datatype='string' name='[Calculation_5591078241771970561]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Turkey&apos; AND [location_name] = &apos;Capital City&apos; THEN &apos;Main City&apos; ELSE [location_name] END' />
      </column>
      <column caption='vertical_filter' datatype='string' name='[Calculation_5918785480550109188]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Turkey&apos; THEN &apos;food&apos; ELSE &apos;platform&apos; END' />
      </column>
      <column caption='orders_perc_total' datatype='real' name='[Calculation_929500757262282766]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_num])/TOTAL(SUM([orders_num]))*100'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='gmv_perc_total' datatype='real' name='[Calculation_929500757268389903]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_gmv])/TOTAL(SUM([orders_gmv]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
