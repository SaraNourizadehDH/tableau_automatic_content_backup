                <zone forceUpdate='true' h='3969' id='2754' type-v2='text' w='99140' x='430' y='81683'>
                  <formatted-text>
                    <run>NOTE: For </run>
                    <run bold='true'>Hong Kong</run>
                    <run> and </run>
                    <run bold='true'>Taiwan</run>
                    <run>, Average </run>
                    <run bold='true'>Order</run>
                    <run> Value is shown. Average </run>
                    <run bold='true'>Food </run>
                    <run>Value (AFV) is not available.&#10;&#10;</run>
                    <run bold='true'>AFV </run>
                    <run>for </run>
                    <run bold='true'>competitor brands </run>
                    <run>represents the </run>
                    <run bold='true'>&quot;subtotal&quot; </run>
                    <run>on</run>
                    <run bold='true'> e-receipt.</run>
                    <run>Æ&#10;</run>
                    <run bold='true'>AFV </run>
                    <run>for </run>
                    <run bold='true'>DH brands </run>
                    <run>aligns with</run>
                    <run bold='true'> DH AFV definition:</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true'>Average Food Value </run>
                    <run>(AFV): Gross Food Value / # of Orders
</run>
                    <run bold='true'>Gross Food Value </run>
                    <run>(GFV): Total paid compulsory by customer for food. Excluding service fees and delivery fees. Including VAT.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
