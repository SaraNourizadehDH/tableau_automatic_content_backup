      <table>
        <view>
          <datasources>
            <datasource caption='fulfillment-dwh-production.rl_intl_markets.aads_seagull_rl_country_kpis' name='federated.0xx7okr0y0bx2c1dduo4i0vfmw2h' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.0xx7okr0y0bx2c1dduo4i0vfmw2h].[vertical]' alias='Both' caption='vertical_parameter' datatype='string' name='[Parameter 10]' param-domain-type='list' role='measure' type='nominal' value='&quot;platform&quot;'>
              <calculation class='tableau' formula='&quot;platform&quot;' />
              <aliases>
                <alias key='&quot;food&quot;' value='Food' />
                <alias key='&quot;platform&quot;' value='Both' />
                <alias key='&quot;q_comm&quot;' value='QCommerce' />
              </aliases>
            </column>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.0xx7okr0y0bx2c1dduo4i0vfmw2h].[country_name_capitalized]' caption='Country' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Hong Kong&quot;'>
              <calculation class='tableau' formula='&quot;Hong Kong&quot;' />
            </column>
            <column caption='Granularity' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;monthly&quot;'>
              <calculation class='tableau' formula='&quot;monthly&quot;' />
            </column>
            <column _.fcp.RefreshableParameterRanges.true...source-field='[federated.0xx7okr0y0bx2c1dduo4i0vfmw2h].[report_date]' caption='p_Date' datatype='date' name='[Parameter 3]' param-domain-type='range' role='measure' type='quantitative' value='#2023-08-17#'>
              <calculation class='tableau' formula='#2023-08-17#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0xx7okr0y0bx2c1dduo4i0vfmw2h'>
            <column caption='customers_upper' datatype='real' name='[Calculation_1778710753048281096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL(MAX([global_entity_id])) THEN SUM([customers_num]) + SUM([customers_num_std_err]) END' />
            </column>
            <column caption='customers_lower' datatype='real' name='[Calculation_1778710753048641545]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL(MAX([global_entity_id])) THEN SUM([customers_num]) - SUM([customers_num_std_err]) END' />
            </column>
            <column caption='Brand Name DH' datatype='string' name='[Calculation_2499849639481999360]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF(ISNULL([global_entity_id]), [brand_name], &apos;DH&apos;)' />
            </column>
            <column caption='Order Date - End' datatype='date' datatype-customized='true' default-format='*dd/mm/yy' name='[Calculation_2703426430128222209]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(IF [granularity] = &apos;monthly&apos; AND [order_date] = DATETRUNC(&apos;month&apos;, [batch_date]) THEN [batch_date]&#10;ELSEIF [granularity] = &apos;monthly&apos; THEN DATE(DATEADD(&apos;day&apos;,-1,(DATEADD(&apos;month&apos;,1,[order_date]))))&#10;ELSEIF [granularity] = &apos;weekly&apos; THEN DATE(DATEADD(&apos;day&apos;, 6, [order_date]))&#10;END)' />
            </column>
            <column caption='period_diff' datatype='integer' name='[Calculation_3268557805155057664]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='iif([granularity] = &apos;monthly&apos;, DATEDIFF(&apos;month&apos;, [order_date], [Parameters].[Parameter 3]),&#10;DATEDIFF(&apos;week&apos;, [order_date], [Parameters].[Parameter 3]))' />
            </column>
            <column caption='ue_disclaimer' datatype='string' name='[Calculation_3574802625085739019]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF     [country_name_capitalized] = &apos;Taiwan&apos; THEN &apos;From May 2021, consumer transaction insights for UberEats, Taiwan, are limited to orders, net GMV and average order value. Additional metrics, including average food value, are available for other markets.&apos;&#10;ELSEIF [country_name_capitalized] = &apos;Singapore&apos; OR [country_name_capitalized] = &apos;Hong Kong&apos; THEN &apos;From November 2022, consumer transaction insights for Deliveroo are limited to orders, net GMV and average order value.&apos;&#10;ELSEIF [country_name_capitalized] = &apos;Turkey&apos; THEN  &apos;Available for food vertical only.&apos;&#10;ELSE&#10;    &apos;&apos;&#13;END' />
            </column>
            <column caption='batch_date_short' datatype='string' default-format='*DD/MM' name='[Calculation_449163714054664203]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='RIGHT(STR([batch_date]), 2) + &quot;-&quot; + MID(STR([batch_date]), 6,2)' />
            </column>
            <column caption='MtD_sign' datatype='string' default-role='measure' default-type='ordinal' name='[Calculation_4883309390215806976]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [granularity] = &apos;monthly&apos; AND [order_date] = DATETRUNC(&apos;month&apos;, [batch_date])&#10;THEN &apos;displays month to &apos; + STR([Calculation_449163714054664203])&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='MtD_sign (copy)' datatype='string' datatype-customized='true' name='[MtD_sign (copy)_3956341934085222402]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [granularity] = &apos;monthly&apos; AND [order_date] = DATETRUNC(&apos;month&apos;, [batch_date])&#10;THEN &apos;displays month to &apos; + STR([Calculation_449163714054664203])&#10;ELSE &apos;&apos;&#10;END' />
            </column>
