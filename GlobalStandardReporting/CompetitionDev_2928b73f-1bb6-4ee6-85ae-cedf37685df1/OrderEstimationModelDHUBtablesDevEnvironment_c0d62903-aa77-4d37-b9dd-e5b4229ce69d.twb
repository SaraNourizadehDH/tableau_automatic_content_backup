                <zone h='99666' id='1037' type-v2='layout-basic' w='98596' x='702' y='167'>
                  <zone friendly-name='Disclaimer' h='3562' id='299' param='horz' type-v2='layout-flow' w='98596' x='702' y='96271'>
                    <zone h='3562' id='297' type-v2='layout-basic' w='98596' x='702' y='96271'>
                      <zone forceUpdate='true' h='3562' id='156' type-v2='text' w='49296' x='702' y='96271'>
                        <formatted-text>
                          <run bold='true' fontalignment='0' fontcolor='#222222' fontname='Tableau Book' fontsize='9'>TABLE</run>
                          <run fontalignment='0' fontcolor='#222222' fontname='Tableau Book' fontsize='9'>: Shows</run>
                          <run bold='true' fontalignment='0' fontcolor='#222222' fontname='Tableau Book' fontsize='9'> total number of orders</run>
                          <run fontalignment='0' fontcolor='#222222' fontname='Tableau Book' fontsize='9'>,</run>
                          <run bold='true' fontalignment='0' fontcolor='#222222' fontname='Tableau Book' fontsize='9'> MoM order growth </run>
                          <run fontalignment='0' fontcolor='#222222' fontname='Tableau Book' fontsize='9'>and </run>
                          <run bold='true' fontalignment='0' fontcolor='#222222' fontname='Tableau Book' fontsize='9'>order ratios</run>
                          <run fontalignment='0' fontcolor='#222222' fontname='Tableau Book' fontsize='9'>  (DH - competitor) by country and brand.</run>
                          <run fontalignment='0'>Æ&#10;&#10;</run>
                          <run bold='true' fontalignment='0' fontname='Tableau Book' fontsize='9'>MODEL: </run>
                          <run fontalignment='0' fontname='Tableau Book' fontsize='9'>Order estimations for competitor brands are based on the Order Estimation Model. Order numbers for DH brands are based on actuals (past months) and run-rates (current month).</run>
                          <run fontalignment='0'>Æ&#10;&#10;</run>
                          <run bold='true' fontalignment='0' fontcolor='#222222' fontname='Tableau Book' fontsize='9'>LEGEND</run>
                          <run fontalignment='0'>Æ&#10;</run>
                          <run bold='true' fontalignment='0' fontname='Tableau Book' fontsize='9'> ★ </run>
                          <run fontalignment='0' fontname='Tableau Book' fontsize='9'>sign: These estimations have not been calibrated on competitor order insights provided by local teams (= local insights). </run>
                        </formatted-text>
                        <zone-style>
                          <format attr='border-color' value='#000000' />
                          <format attr='border-style' value='none' />
                          <format attr='border-width' value='0' />
                          <format attr='margin' value='4' />
                          <format attr='margin-top' value='10' />
                        </zone-style>
                      </zone>
                      <zone forceUpdate='true' h='3562' id='482' type-v2='text' w='49300' x='49998' y='96271'>
                        <formatted-text>
                          <run bold='true' fontalignment='0' fontname='Tableau Book' fontsize='9'>DISCLAIMER</run>
                          <run fontalignment='0' fontname='Tableau Book' fontsize='9'>: The estimations are based on Food or Food&amp;QC combined depending on the local insight that that OEM has received.</run>
                          <run fontalignment='0'>Æ&#10;&#10;</run>
                          <run bold='true' fontalignment='0' fontname='Tableau Book' fontsize='9'>COVERAGE</run>
                          <run fontalignment='0' fontname='Tableau Book' fontsize='9'>: </run>
                          <run bold='true' fontalignment='0' fontname='Tableau Book' fontsize='9'>Countries included</run>
                          <run fontalignment='0' fontname='Tableau Book' fontsize='9'> in  the OEM may </run>
                          <run bold='true' fontalignment='0' fontname='Tableau Book' fontsize='9'>vary from month to month</run>
                          <run fontalignment='0' fontname='Tableau Book' fontsize='9'>. This fluctuation is expected as predictions lacking meaningful features are not displayed.</run>
                          <run fontalignment='0'>Æ&#10;&#10;</run>
                          <run fontalignment='0' fontname='Tableau Book' fontsize='9'>In case of questions or doubt, please reach out on Slack at</run>
