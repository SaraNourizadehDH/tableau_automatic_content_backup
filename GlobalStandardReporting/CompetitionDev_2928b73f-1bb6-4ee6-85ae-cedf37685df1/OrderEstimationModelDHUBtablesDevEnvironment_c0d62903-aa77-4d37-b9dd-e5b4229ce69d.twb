            <column caption='order growth %' datatype='real' name='[Calculation_4847350979614543872]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [comp_orders]&#10;WHEN 0 THEN 0&#10;ELSE ([comp_mom_growth]-1)*100&#10;END' />
