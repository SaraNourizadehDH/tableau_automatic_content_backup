    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Monthly OEM Overview [New]'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/OrderEstimationModel-DHUBtablesDevEnvironment/MonthlyOEMOverviewNew?rev=' id='MonthlyOEMOverviewNew' path='/t/GlobalStandardReporting/workbooks/OrderEstimationModel-DHUBtablesDevEnvironment' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='dash-text'>
          <format attr='text-align' id='dash-text_73' value='center' />
