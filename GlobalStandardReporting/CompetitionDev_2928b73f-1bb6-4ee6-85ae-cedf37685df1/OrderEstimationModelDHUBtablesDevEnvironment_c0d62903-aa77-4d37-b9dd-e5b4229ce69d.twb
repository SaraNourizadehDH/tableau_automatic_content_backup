      <aliases enabled='yes' />
      <column caption='confluence' datatype='string' name='[Calculation_1101622741170249728]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;&apos;' />
      </column>
      <column caption='is_dh_brand' datatype='boolean' name='[Calculation_11470125174534145]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([comp_display_name] = [dh_brand_name], TRUE, FALSE)' />
      </column>
      <column caption='dh_brand_name_limited' datatype='string' name='[Calculation_1277122349839642624]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([dh_brand_name] != &apos;Baedaltong&apos;, [dh_brand_name], NULL)' />
      </column>
      <column caption='is calibrated sort' datatype='integer' name='[Calculation_177821855549722628]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_calibrated] THEN 1 &#10;ELSE 0&#10;END' />
      </column>
      <column caption='perc_comp_orders' datatype='real' name='[Calculation_1858297862175711238]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([comp_orders]) /SUM({ EXCLUDE [comp_display_name], [Calculation_750130821268701184]: SUM([comp_orders]) })' />
      </column>
      <column caption='segment-country' datatype='string' name='[Calculation_1894256262138343424]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[segment] + &apos;-&apos; + [country_code]' />
      </column>
      <column caption='dh_orders_actuals_run_rate' datatype='integer' name='[Calculation_2301057942482325506]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([dh_confidence] = &apos;DH run rate&apos;, [dh_orders], [comp_orders])' />
      </column>
      <column caption='DELTA_dh_comp_ratio' datatype='real' name='[Calculation_2301057942484045827]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [dh_brand_name] = [comp_display_name] THEN NULL&#10;ELSE [dh_comp_ratio]&#10;END' />
      </column>
      <column caption='confidence_label' datatype='string' name='[Calculation_2301057942509113350]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [dh_brand_name] = [comp_display_name] THEN [dh_confidence]&#10;ELSE LOWER([comp_confidence])&#10;END' />
      </column>
      <column caption='ratio_sign' datatype='string' name='[Calculation_2301057942517882888]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [comp_orders] = 0 THEN NULL&#10;ELSE &#10;IIF([dh_brand_name] = [comp_display_name], NULL, &apos;x&apos;)&#10;END' />
      </column>
      <column caption='user_filter' datatype='boolean' name='[Calculation_2545378229332922368]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='USERNAME() = [username]' />
      </column>
      <column caption='Has Local Insights' datatype='boolean' name='[Calculation_3434768802271555588]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF MAX([is_calibrated]) = FALSE THEN FALSE &#10;ELSE TRUE&#10;END' />
      </column>
      <column caption='order_growth' datatype='real' default-format='p0.00%' name='[Calculation_3661356142864076801]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF( MAX([comp_orders])= 0 ,&#10; 0 , (MAX([comp_orders]) / MAX([prev_comp_orders]))-1 )' />
      </column>
      <column caption='current_month_orders' datatype='integer' name='[Calculation_3851140649185165313]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IIF(&#10;DATETRUNC(&apos;month&apos;, [report_date]) = DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;, TODAY())) OR&#10;DATETRUNC(&apos;month&apos;, [report_date]) = DATEADD(&apos;month&apos;, -2, DATETRUNC(&apos;month&apos;, TODAY())) &#10;&#10;, [comp_orders], NULL)' />
      </column>
      <column caption='orders_sorting' datatype='integer' name='[Calculation_3851140649193340930]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='INT(STR([Calculation_4838977090648731654]) + STR([Calculation_3851140649185165313]))' />
      </column>
      <column caption='local_insights_form' datatype='string' name='[Calculation_3933331372072796160]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Do you have a local insight on competitor performance to report? Please click here to share it via our form.&apos;' />
      </column>
      <column caption='Country Name - Comp Display Name' datatype='string' name='[Calculation_3972245286050541568]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[country_name] + &apos; - &apos; + [comp_display_name]' />
      </column>
      <column caption='competitor_insights_sign' datatype='string' name='[Calculation_4266316245074591744]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='iif([competitor_insights_order] &gt; 0, &apos;*&apos;, NULL)' />
      </column>
      <column caption='cnt_country_comp' datatype='integer' name='[Calculation_4519291894220869632]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_3972245286050541568])' />
      </column>
      <column caption='ATTR' datatype='real' name='[Calculation_4632796669879885824]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ATTR(0.5)' />
      </column>
      <column caption='x_competitors' datatype='string' name='[Calculation_4752845734239662089]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([dh_brand_name] = [comp_display_name], &apos;&apos;, &apos;x&apos;)' />
      </column>
      <column caption='DH_sorting' datatype='integer' name='[Calculation_4838977090648731654]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IIF([comp_display_name] = [dh_brand_name], 1, 0)' />
      </column>
      <column caption='order growth %' datatype='real' name='[Calculation_4847350979614543872]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [comp_orders]&#10;WHEN 0 THEN 0&#10;ELSE ([comp_mom_growth]-1)*100&#10;END' />
      </column>
      <column caption='order_growth_brackets' datatype='string' name='[Calculation_549931752477478913]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF MAX([comp_orders]) = 0 THEN NULL&#10;ELSE &#10;IIF(ISNULL([Calculation_3661356142864076801]), &quot;&quot;, &quot;(&quot; + STR(ROUND([Calculation_3661356142864076801] * 100, 0)) + &quot;%&quot; + &quot;)&quot;)&#10;END' />
      </column>
      <column caption='DELTA_MoM' datatype='real' name='[Calculation_5592415221279059970]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND([Calculation_2301057942484045827],3) - ROUND([Calculation_5592415221280022532],3)' />
      </column>
      <column caption='DELTA_previous' datatype='real' name='[Calculation_5592415221280022532]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([dh_brand_name] = [comp_display_name], NULL, &#10;    IIF([prev_comp_orders] &gt; 0, [prev_dh_orders]/[prev_comp_orders], NULL))' />
      </column>
      <column caption='Local Insights Missing Sign' datatype='string' name='[Calculation_6203004818854383616]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([dh_brand_name] = [comp_display_name] OR INT([is_calibrated]) = 1, &apos;&apos;, &apos;★&apos;)' />
      </column>
      <column caption='ATTR_2' datatype='integer' name='[Calculation_6528671357649747968]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ATTR(1)' />
      </column>
      <column caption='confidence_label_color' datatype='string' name='[Calculation_6528671357683052545]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_2301057942509113350]' />
      </column>
      <column caption='comp_orders_decimals' datatype='integer' name='[Calculation_6901344241002725378]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF MAX([comp_orders]) = 0 THEN NULL&#10;ELSE &#10;IF MAX([comp_orders]) &lt; 1000 THEN -MAX([comp_orders])&#10;ELSE MAX([comp_orders]) &#10;END&#10;END' />
      </column>
      <column caption='Confidence_display' datatype='string' name='[Calculation_750130821268701184]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([comp_confidence] = &apos;Actuals&apos;, &apos;Actuals / Run Rate&apos;,&#10;IIF([comp_confidence] = &apos;Run Rate&apos;, &apos;Actuals / Run Rate&apos;, [comp_confidence]))' />
      </column>
      <column caption='Competitor (copy)' datatype='string' name='[Competitor (copy)_3851140649175674880]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[comp_display_name]' />
      </column>
      <column caption='forecast_indicator' datatype='string' name='[Confidence_display (copy)_750130821978312705]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([comp_confidence] = &apos;Run Rate&apos;, &apos;(RR)&apos;,&#10;IIF([is_forecast], &apos;(FCST)&apos;,&#10;&apos;&apos;))' />
      </column>
      <column caption='DELTA_MoM_colour' datatype='string' name='[DELTA_MoM (copy)_5592415221279703043]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [comp_orders]&#10;WHEN 0 THEN &apos;Seagull&apos; &#10;ELSE&#10;&#10;IIF([Calculation_5592415221279059970] &gt; 0, &apos;Growth&apos;,&#10;IIF([Calculation_5592415221279059970] &lt; 0, &apos;Decline&apos;,&#10;IIF([Calculation_5592415221279059970] = 0, &apos;Stable&apos;,NULL)&#10;)&#10;)&#10;END' />
      </column>
      <column caption='DELTA_MoM_colour (copy)' datatype='integer' name='[DELTA_MoM_colour (copy)_3400991810028388355]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Calculation_5592415221279059970] &gt; 0, 1,&#10;IIF([Calculation_5592415221279059970] &lt; 0, -1,0))' />
      </column>
      <column caption='DELTA_orders_color' datatype='integer' datatype-customized='true' name='[DELTA_orders (copy)_4838977090620215299]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([comp_orders (copy)_4838977090604687360] &gt;= 1, 1, &#10;IIF(ISNULL([comp_orders (copy)_4838977090604687360]), 0,&#10;-1))' />
      </column>
      <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
