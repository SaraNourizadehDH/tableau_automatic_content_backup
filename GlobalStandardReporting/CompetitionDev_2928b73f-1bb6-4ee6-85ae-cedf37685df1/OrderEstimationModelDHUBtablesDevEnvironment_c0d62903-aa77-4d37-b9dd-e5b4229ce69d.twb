    <worksheet name='Order Estimates'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#ffffff' fontsize='12'><![CDATA[<[Parameters].[Parameter 1]> Order Estimates Δ vs Competitor: Order Growth, Relative Share and Ratios]]></run>
            <run>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='ci_oem_kpis_v2 (rl_intl_markets)' name='federated.0tctmuq0445vbv1fwqkpv1ou8sqp' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='monthly' caption='Date_Granularity' datatype='integer' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='7'>
              <calculation class='tableau' formula='7' />
              <aliases>
                <alias key='7' value='monthly' />
                <alias key='14' value='weekly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0tctmuq0445vbv1fwqkpv1ou8sqp'>
            <column caption='is_dh_brand' datatype='boolean' name='[Calculation_11470125174534145]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([comp_display_name] = [dh_brand_name], TRUE, FALSE)' />
            </column>
            <column caption='perc_comp_orders' datatype='real' name='[Calculation_1858297862175711238]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([comp_orders]) /SUM({ EXCLUDE [comp_display_name], [Calculation_750130821268701184]: SUM([comp_orders]) })' />
            </column>
            <column caption='segment-country' datatype='string' name='[Calculation_1894256262138343424]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[segment] + &apos;-&apos; + [country_code]' />
            </column>
            <column caption='DELTA_dh_comp_ratio' datatype='real' name='[Calculation_2301057942484045827]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [dh_brand_name] = [comp_display_name] THEN NULL&#10;ELSE [dh_comp_ratio]&#10;END' />
            </column>
            <column caption='order_growth' datatype='real' default-format='p0.00%' name='[Calculation_3661356142864076801]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF( MAX([comp_orders])= 0 ,&#10; 0 , (MAX([comp_orders]) / MAX([prev_comp_orders]))-1 )' />
            </column>
            <column caption='Confidence_display' datatype='string' name='[Calculation_750130821268701184]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([comp_confidence] = &apos;Actuals&apos;, &apos;Actuals / Run Rate&apos;,&#10;IIF([comp_confidence] = &apos;Run Rate&apos;, &apos;Actuals / Run Rate&apos;, [comp_confidence]))' />
            </column>
            <column caption='DELTA_orders_color' datatype='integer' datatype-customized='true' name='[DELTA_orders (copy)_4838977090620215299]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([comp_orders (copy)_4838977090604687360] &gt;= 1, 1, &#10;IIF(ISNULL([comp_orders (copy)_4838977090604687360]), 0,&#10;-1))' />
            </column>
            <column caption='Comp Confidence' datatype='string' name='[comp_confidence]' role='dimension' type='nominal' />
            <column caption='Comp Display Name' datatype='string' name='[comp_display_name]' role='dimension' type='nominal' />
            <column caption='DELTA_orders' datatype='real' datatype-customized='true' name='[comp_orders (copy)_4838977090604687360]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([dh_brand_name] = [comp_display_name], NULL, &#10;[dh_orders]/[comp_orders])' />
            </column>
            <column caption='Comp Orders' datatype='integer' name='[comp_orders]' role='measure' type='quantitative' />
            <column caption='Country Code' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Dh Brand Name' datatype='string' name='[dh_brand_name]' role='dimension' type='nominal' />
            <column datatype='real' name='[dh_comp_ratio]' role='measure' type='quantitative' />
            <column caption='Dh Display Name' datatype='string' name='[dh_display_name]' role='dimension' type='nominal' />
