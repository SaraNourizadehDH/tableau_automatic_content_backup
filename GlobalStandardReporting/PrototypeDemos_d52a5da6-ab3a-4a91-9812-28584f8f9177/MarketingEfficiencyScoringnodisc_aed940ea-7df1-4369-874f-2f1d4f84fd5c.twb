      <column caption='Score colors' datatype='string' name='[Calculation_2623768999296045058]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [final_vendor_score] &lt; 2 THEN &apos;Optimisation needed&apos;&#10;ELSEIF [final_vendor_score] &lt; 3 THEN &apos;Optimisation suggested&apos;&#10;ELSEIF [final_vendor_score] &gt;= 3 AND [final_vendor_score] &lt; 4 THEN &apos;Good performance&apos;&#10;ELSEIF [final_vendor_score] &gt;=4 THEN &apos;Great Performance&apos;&#10;END' />
      </column>
      <column caption='CVR score color' datatype='string' name='[Calculation_2623768999299158020]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [cvr_diff_score] &lt; 2 THEN &apos;Optimisation needed&apos;&#10;ELSEIF [cvr_diff_score] &lt; 3 THEN &apos;Optimisation suggested&apos;&#10;ELSEIF [cvr_diff_score] &gt;= 3 AND [cvr_diff_score] &lt; 4 THEN &apos;Good performance&apos;&#10;ELSEIF [cvr_diff_score] &gt;=4 THEN &apos;Great Performance&apos;&#10;END' />
