      <column caption='ROAS score color' datatype='string' name='[CPO score color (copy)_2623768999322873862]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [roas_new_score] &lt; 2 THEN &apos;Optimisation needed&apos;&#10;ELSEIF [roas_new_score] &lt; 3 THEN &apos;Optimisation suggested&apos;&#10;ELSEIF [roas_new_score] &gt;= 3 AND [roas_new_score] &lt; 4 THEN &apos;Good performance&apos;&#10;ELSEIF [roas_new_score] &gt;= 4 THEN &apos;Great Performance&apos;&#10;END' />
      </column>
      <column caption='Spend GBV score color' datatype='string' name='[CPO score color (copy)_2623768999323697159]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [spend_gbv_score] &lt; 2 THEN &apos;Optimisation needed&apos;&#10;ELSEIF [spend_gbv_score] &lt; 3 THEN &apos;Optimisation suggested&apos;&#10;ELSEIF [spend_gbv_score] &gt;= 3 AND [cpo_eur_score] &lt; 4 THEN &apos;Good performance&apos;&#10;ELSEIF [spend_gbv_score] &gt;= 4 THEN &apos;Great Performance&apos;&#10;END' />
      </column>
      <column caption='CVR diff lower bound 2' datatype='real' name='[CVR diff lower bound (copy)_629729896937660419]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[cvr_diff_mean]-[cvr_diff_stddev]' />
      </column>
      <column caption='CVR diff lower bound 3' datatype='real' name='[CVR diff lower bound 2 (copy)_629729896938201092]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[cvr_diff_mean]-[cvr_diff_stddev]*100' />
      </column>
      <column caption='CVR diff upper bound 3' datatype='real' name='[CVR diff lower bound 3 (copy)_629729896941731845]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[cvr_diff_mean]+[cvr_diff_stddev]*100' />
      </column>
      <column caption='CVR diff lower bound' datatype='real' name='[CVR diff upper bound (copy)_629729896935378945]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[cvr_diff_mean]-([cvr_diff_stddev]*0.5)' />
      </column>
      <column caption='Marketing Orders Share' datatype='real' name='[Calculation_2043508373411766274]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([marketing_orders_unique])/SUM([successful_orders])' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_2623768999275859968]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
