              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Vendor score&apos; THEN SUM([final_vendor_score]*[successful_orders])/SUM([successful_orders])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Spend GBV Rate&apos; THEN SUM([spend_gbv]*[successful_orders])/SUM([successful_orders])*100&#10;ELSEIF [Parameters].[Parameter 1] = &apos;CVR diff score&apos; THEN SUM([cvr_diff_score]*[successful_orders])/SUM([successful_orders])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;CPO euro score&apos; THEN SUM([cpo_eur_score]*[successful_orders])/SUM([successful_orders])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Spend GBV score&apos; THEN SUM([spend_gbv_score]*[successful_orders])/SUM([successful_orders])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;ROAS new score&apos; THEN SUM([roas_new_score]*[successful_orders])/SUM([successful_orders])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Acquisition Rate score&apos; THEN SUM([acquisition_rate_score]*[successful_orders])/SUM([successful_orders])&#10;END' />
            </column>
