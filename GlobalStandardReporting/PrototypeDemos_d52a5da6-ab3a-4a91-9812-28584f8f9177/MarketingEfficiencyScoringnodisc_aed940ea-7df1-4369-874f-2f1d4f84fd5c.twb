      <column aggregation='Sum' caption='Full score number' datatype='integer' datatype-customized='true' name='[Calculation_2623768999330840584]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='INT(ROUND([final_vendor_score]))' />
