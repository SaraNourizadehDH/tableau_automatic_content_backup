                <zone custom-title='true' fixed-size='246' h='3000' id='377' mode='slider' param='[Parameters].[brand_cmgr_3m Parameter]' type-v2='paramctrl' w='15875' x='66607' y='18133'>
                  <formatted-text>
                    <run fontalignment='1' fontsize='12'>CMGR* Parameter %</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
