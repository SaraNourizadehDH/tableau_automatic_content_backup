              <zone forceUpdate='true' h='1267' id='1019' type-v2='text' w='99000' x='500' y='15200'>
                <formatted-text>
                  <run fontsize='8'><![CDATA[*Reorder Rate is calculated for the first time to restaurant customers for 30 days, results are shown for latest complete month '<]]></run>
                  <run fontsize='8'>[Parameters].[month Parameter]</run>
                  <run fontsize='8'>&gt;&apos;</run>
