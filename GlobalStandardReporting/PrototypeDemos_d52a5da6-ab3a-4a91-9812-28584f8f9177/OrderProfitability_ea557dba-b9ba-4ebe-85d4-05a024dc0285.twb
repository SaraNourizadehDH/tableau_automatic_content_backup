      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0tvk7t70ah311s1df95em1n2atmx].[avg:Cost per Order (copy)_3762053848140230657:qk]&quot;' value='Cost per Order Kitchen' />
          <alias key='&quot;[federated.0tvk7t70ah311s1df95em1n2atmx].[avg:Cost per Order Kitchen (copy)_3762053848141561858:qk]&quot;' value='Cost per Order Platform' />
          <alias key='&quot;[federated.0tvk7t70ah311s1df95em1n2atmx].[avg:Revenue per order (copy)_3762053848142487555:qk]&quot;' value='Revenue per order Kitchen' />
          <alias key='&quot;[federated.0tvk7t70ah311s1df95em1n2atmx].[avg:Revenue per order Kitchen (copy)_3762053848142721028:qk]&quot;' value='Revenue per order Platform' />
        </aliases>
      </column>
      <column caption='Cost per Order' datatype='real' name='[Calculation_2565714828162912256]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cost_of_sales])/SUM([successful_orders])' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_4994210558828650496]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='USERNAME() = [username]' />
      </column>
      <column caption='Kitchen or Not Kitchen' datatype='string' name='[Calculation_6198782719202922496]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [kitchen_short_name] = &apos;Other platform vendors&apos; THEN &apos;Platform vendors&apos; ELSE &apos;Kitchen_vendors&apos; END' />
      </column>
      <column caption='Profit per Order' datatype='real' name='[Calculation_6198782719203176449]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(analytical_profit)/SUM([successful_orders])' />
      </column>
      <column caption='Revenue per order' datatype='real' name='[Cost per Order (copy)_2565714828163145729]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([revenue_net])/SUM([successful_orders])' />
      </column>
      <column caption='Cost per Order Kitchen' datatype='real' name='[Cost per Order (copy)_3762053848140230657]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_6198782719202922496] = &apos;Kitchen_vendors&apos; THEN [cost_of_sales]/([successful_orders]) END' />
      </column>
      <column caption='Cost per Order Platform' datatype='real' name='[Cost per Order Kitchen (copy)_3762053848141561858]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_6198782719202922496] != &apos;Kitchen_vendors&apos; THEN [cost_of_sales]/([successful_orders]) END' />
      </column>
      <column caption='Profit per Order without NCR rev' datatype='real' name='[Profit per Order (copy)_3805963943597506560]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([analytical_profit]-[ads_revenue_net]-[other_ncr_net])/SUM([successful_orders])' />
      </column>
      <column caption='Revenue per order Kitchen' datatype='real' name='[Revenue per order (copy)_3762053848142487555]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_6198782719202922496] = &apos;Kitchen_vendors&apos; THEN [revenue_net]/[successful_orders] END' />
      </column>
      <column caption='Revenue per order Platform' datatype='real' name='[Revenue per order Kitchen (copy)_3762053848142721028]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_6198782719202922496] != &apos;Kitchen_vendors&apos; THEN [revenue_net]/[successful_orders] END' />
      </column>
