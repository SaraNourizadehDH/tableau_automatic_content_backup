      <column caption='Collection Name' datatype='string' name='[Calculation_1552475245952909312]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_best_seller_order] = TRUE THEN &apos;Best seller&apos;&#10;ELSEIF is_super_saver_order = TRUE THEN &apos;Super Saver&apos;&#10;ELSEIF is_flash_sale_order = TRUE THEN &apos;Flash Sale&apos;&#10;ELSEIF is_hot_deal = TRUE THEN &apos;Hot deals&apos;&#10;ELSEIF is_under_30_deals =  TRUE THEN &apos;Under 30 deals&apos;&#10;ELSEIF is_weekend_drop_order =  TRUE THEN &apos;Weekend Drop&apos;&#10;END' />
      </column>
      <column caption='AOV euro' datatype='real' name='[Calculation_2573385014360600578]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gmv_eur])/SUM([successful_orders])' />
      </column>
      <column caption='Cumulative Orders' datatype='integer' name='[Calculation_3067232865546432514]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF MAX([report_month]) &lt;= DATETRUNC(&apos;month&apos;, today()) THEN&#10;RUNNING_SUM(SUM([successful_orders])) END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Marketing cost FIRST' datatype='real' name='[Calculation_3317323378137935875]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF MAX([report_month]) &lt;= DATETRUNC(&apos;month&apos;, today()) THEN&#10;LOOKUP(SUM([marketing_cost_eur]),FIRST()) END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Cumulative GMV' datatype='real' name='[Calculation_3317323378166607878]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF MAX([report_month]) &lt;= DATETRUNC(&apos;month&apos;, today()) THEN&#10;RUNNING_SUM(SUM([gmv_eur])) END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Marketing Effect Orders FIRST' datatype='integer' name='[Calculation_4145704237115793409]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF MAX([report_month]) &lt;= DATETRUNC(&apos;month&apos;, today()) THEN&#10;LOOKUP(SUM([marketing_effect_orders]),FIRST()) END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Marketing_effect_gmv_eur_FIRST' datatype='real' name='[Calculation_4145704237117296642]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF MAX([report_month]) &lt;= DATETRUNC(&apos;month&apos;, today()) THEN&#10;LOOKUP(SUM([marketing_effect_gmv_eur]),FIRST()) END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Customers FIRST' datatype='integer' name='[Calculation_6210323189797294080]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF MAX([report_month]) &lt;= DATETRUNC(&apos;month&apos;, today()) THEN&#10;LOOKUP(SUM([customers]),FIRST()) END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Retention Rate' datatype='real' name='[Calculation_6210323189797396481]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(customers)/[Calculation_6210323189797294080]'>
