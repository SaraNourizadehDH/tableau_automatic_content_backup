      <column caption='KPI' datatype='real' name='[Calculation_6804094670745649153]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;Customer&apos; THEN SUM([customers])&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Frequency&apos; THEN SUM([successful_orders])/SUM(customers)&#10;ELSEIF [Parameters].[Parameter 2] = &apos;AOV, euro&apos; THEN [Calculation_2573385014360600578]&#10;ELSE [Calculation_6210323189797396481]*100 END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Suffix' datatype='string' name='[Calculation_6804094670751240194]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Retention&apos; THEN &apos;%&apos;&#10;&#10;END' />
