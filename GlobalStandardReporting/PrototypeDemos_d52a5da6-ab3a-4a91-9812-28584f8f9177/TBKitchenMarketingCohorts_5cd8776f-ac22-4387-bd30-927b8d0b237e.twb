    <worksheet name='Retention Cohort'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Customer Marketing Cohorts</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_TBkitchen_customers_cohorts' name='federated.0tvk7t70ah311s1df95em1n2atmx' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='KPI Selection' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Customer&quot;'>
              <calculation class='tableau' formula='&quot;Customer&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0tvk7t70ah311s1df95em1n2atmx'>
            <column caption='Collection Name' datatype='string' name='[Calculation_1552475245952909312]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_best_seller_order] = TRUE THEN &apos;Best seller&apos;&#10;ELSEIF is_super_saver_order = TRUE THEN &apos;Super Saver&apos;&#10;ELSEIF is_flash_sale_order = TRUE THEN &apos;Flash Sale&apos;&#10;ELSEIF is_hot_deal = TRUE THEN &apos;Hot deals&apos;&#10;ELSEIF is_under_30_deals =  TRUE THEN &apos;Under 30 deals&apos;&#10;ELSEIF is_weekend_drop_order =  TRUE THEN &apos;Weekend Drop&apos;&#10;END' />
            </column>
            <column caption='AOV euro' datatype='real' name='[Calculation_2573385014360600578]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_eur])/SUM([successful_orders])' />
            </column>
            <column caption='Customers FIRST' datatype='integer' name='[Calculation_6210323189797294080]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MAX([report_month]) &lt;= DATETRUNC(&apos;month&apos;, today()) THEN&#10;LOOKUP(SUM([customers]),FIRST()) END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Retention Rate' datatype='real' name='[Calculation_6210323189797396481]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(customers)/[Calculation_6210323189797294080]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='KPI' datatype='real' name='[Calculation_6804094670745649153]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;Customer&apos; THEN SUM([customers])&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Frequency&apos; THEN SUM([successful_orders])/SUM(customers)&#10;ELSEIF [Parameters].[Parameter 2] = &apos;AOV, euro&apos; THEN [Calculation_2573385014360600578]&#10;ELSE [Calculation_6210323189797396481]*100 END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Suffix' datatype='string' name='[Calculation_6804094670751240194]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Retention&apos; THEN &apos;%&apos;&#10;&#10;END' />
            </column>
            <column caption='Vendor name id' datatype='string' name='[Calculation_6895503650175827969]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[vendor_name]+[vendor_id]' />
            </column>
            <column datatype='date' name='[acquisition_month]' role='dimension' type='ordinal' />
            <column-instance column='[report_month]' derivation='Attribute' name='[attr:report_month:ok]' pivot='key' type='ordinal' />
