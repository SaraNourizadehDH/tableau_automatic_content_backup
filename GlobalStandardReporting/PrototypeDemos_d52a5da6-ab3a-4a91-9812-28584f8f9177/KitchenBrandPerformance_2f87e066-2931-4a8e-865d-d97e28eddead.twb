      <column caption='P Control' datatype='string' name='[Calculation_1361916727911301120]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 9]&#10;when &apos;Partner&apos; then   [partner_name]&#10;When &apos;Brand&apos; THEN [brand]&#10;when &apos;Cuisine&apos; then [main_cuisine]&#10;END' />
