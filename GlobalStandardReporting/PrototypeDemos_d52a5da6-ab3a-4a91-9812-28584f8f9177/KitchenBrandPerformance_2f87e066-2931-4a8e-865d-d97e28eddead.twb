      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/KitchenBrandPerformance_15856626526350/KitchenBrandPerformance?rev=' id='KitchenBrandPerformance' path='/t/GlobalStandardReporting/workbooks/KitchenBrandPerformance_17478444191350' revision='' site='GlobalStandardReporting' />
