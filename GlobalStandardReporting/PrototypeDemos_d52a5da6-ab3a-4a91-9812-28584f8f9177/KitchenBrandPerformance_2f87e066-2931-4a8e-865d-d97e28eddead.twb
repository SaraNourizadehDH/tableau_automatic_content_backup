        <column caption='dim' datatype='string' name='[Parameter 10]' param-domain-type='list' role='measure' type='nominal' value='&quot;City&quot;'>
          <calculation class='tableau' formula='&quot;City&quot;' />
          <members>
            <member value='&quot;City&quot;' />
            <member value='&quot;Kitchen Name&quot;' />
            <member value='&quot;Partner Name&quot;' />
            <member value='&quot;Brand&quot;' />
          </members>
        </column>
