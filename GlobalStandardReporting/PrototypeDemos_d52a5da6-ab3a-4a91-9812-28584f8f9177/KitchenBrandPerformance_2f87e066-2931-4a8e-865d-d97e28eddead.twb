          <calculation class='tableau' formula='IF  [onboarding_month] &gt;=  DATEADD(&apos;month&apos;, -2, DATETRUNC(&apos;month&apos;, TODAY())) AND [global_entity_id] = &apos;HS_SA&apos; THEN &apos;New Vendors&apos;&#10;ELSEIF [onboarding_month] &lt; DATEADD(&apos;month&apos;, -2, DATETRUNC(&apos;month&apos;, TODAY())) AND [global_entity_id] = &apos;HS_SA&apos; THEN &apos;Aged Vendors&apos;&#10;ELSEIF [onboarding_month] = DATETRUNC(&apos;month&apos;, TODAY()) THEN &apos;New&apos;&#10;ELSEIF [onboarding_month] &gt;=  DATEADD(&apos;month&apos;, -6, DATETRUNC(&apos;month&apos;, TODAY())) THEN &apos;Non Aged&apos;&#10;ELSEIF [onboarding_month] &lt; DATEADD(&apos;month&apos;, -6, DATETRUNC(&apos;month&apos;, TODAY())) THEN &apos;Aged&apos;&#10;END' />
        </column>
        <column caption='Kitchen Segment' datatype='string' name='[Calculation_3795549365267267584]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [country_name]=&apos;Saudi Arabia&apos; THEN &apos;KSA&apos;&#10;&#10;ELSE [segment] END' />
        </column>
        <column caption='City KSA' datatype='string' name='[Calculation_5117144740759887872]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF CONTAINS([kitchen_area], &quot;Riyadh&quot;) THEN &quot;Riyadh&quot;&#10; ELSEIF CONTAINS([kitchen_area], &quot;Jeddah&quot;) THEN &quot;Jeddah&quot; &#10; ELSEIF CONTAINS([kitchen_area], &quot;Dammam&quot;) OR CONTAINS([kitchen_area], &quot;Khobar&quot;) THEN &quot;Dammam&quot;&#10;END' />
        </column>
        <column caption='Partner Live' datatype='boolean' name='[Calculation_869194771949228032]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF ISNULL([stall_partner_churn_month]) THEN TRUE ELSE FALSE END' />
        </column>
        <column caption='Brand' datatype='string' name='[brand]' role='dimension' type='nominal' />
        <column datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
        <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
