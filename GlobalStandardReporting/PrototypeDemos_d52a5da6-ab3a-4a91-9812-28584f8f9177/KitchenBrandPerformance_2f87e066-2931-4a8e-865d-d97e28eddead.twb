        </calculation>
      </column>
      <column caption='GMV euro/local' datatype='real' name='[Calculation_2079185309815750657]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 8] = &apos;Euro&apos; THEN [gmv_eur] ELSE [gmv_local] END' />
      </column>
      <column caption='Commission Euro/Local' datatype='real' name='[Calculation_2079185309817233411]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 8] = &apos;Euro&apos; THEN [commission_eur] ELSE [commission_local] END' />
      </column>
      <column caption='Discount DH Local/Euro' datatype='real' name='[Calculation_2079185309818232837]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 8] = &apos;Euro&apos; THEN [discount_dh_eur]&#10;ELSE [discount_dh_local]&#10;END' />
      </column>
      <column caption='Discount other Euro/Local' datatype='real' name='[Calculation_2079185309818966022]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='If [Parameters].[Parameter 8] = &apos;Euro&apos; THEN [discount_other_eur]&#10;ELSE [discount_other_local]&#10;END' />
      </column>
      <column caption='Voucher DH euro/local' datatype='real' name='[Calculation_2079185309819568135]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 8] = &apos;Euro&apos; THEN [voucher_dh_eur] ELSE [voucher_dh_local] END' />
      </column>
      <column caption='Voucher other Euro/Local' datatype='real' name='[Calculation_2079185309820207112]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 8] = &apos;Euro&apos; THEN [voucher_other_eur]&#10;ELSE [voucher_other_local]&#10;END' />
      </column>
      <column caption='Delivery Fee Euro/Local' datatype='real' datatype-customized='true' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2079185309820768265]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 8]=&apos;Euro&apos; THEN [delivery_fee_eur]&#10;ELSE [delivery_fee_local]&#10;END' />
      </column>
      <column caption='Online Time Rate' datatype='real' name='[Calculation_2495416434298896385]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - sum([offline_minutes])/sum([schedule_minutes])' />
      </column>
      <column caption='Menu Sessions / Vendor' datatype='real' name='[Calculation_2495416434299764738]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([menu])/COUNTD([vendor_id])' />
      </column>
      <column caption='total subsidies amount E/L' datatype='real' name='[Calculation_2495416436021919747]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Parameters].[Parameter 8] = &apos;Euro&apos; THEN [discount_dh_eur]+[discount_other_eur]+[voucher_dh_eur]+[voucher_other_eur]&#10;ELSE [discount_dh_local] + [discount_other_local] + [voucher_dh_local] + [voucher_other_local] END)' />
      </column>
      <column caption='total voucher amount E/L' datatype='real' name='[Calculation_2495416436024778756]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Parameters].[Parameter 8] = &apos;Euro&apos; THEN [voucher_dh_eur]+[voucher_other_eur]&#10;ELSE [voucher_dh_local]+[voucher_other_local]&#10;END)' />
      </column>
      <column caption='ABV euro/local' datatype='real' name='[Calculation_2495416436081438725]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5885782551741943810]&#10;/&#10;SUM([successful_order_count])' />
      </column>
      <column caption='CVR' datatype='real' name='[Calculation_2495416436114980870]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([transactions])/SUM([menu]))' />
      </column>
      <column caption='Reorder Rate*' datatype='real' name='[Calculation_2495416436115185671]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([returned_customers_same_vendor_30d_ft])/SUM([new_customer_restaurant]))' />
      </column>
      <column caption='Total Subsidies/GBV' datatype='real' name='[Calculation_2495416436115542024]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((SUM([discount_dh_eur])+SUM([discount_other_eur])+SUM([voucher_dh_eur])+SUM([voucher_other_eur]))/SUM([gbv_eur]))' />
      </column>
      <column caption='Title' datatype='string' name='[Calculation_2495416437137489930]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;Yes&apos; THEN [Parameters].[Parameter 3]&#10;WHEN &apos;No&apos; THEN &apos;All KPIs&apos;&#10;END' />
      </column>
      <column caption='Total Subsidies/GMV' datatype='real' name='[Calculation_2495416437152169997]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((SUM([discount_dh_eur])+SUM([discount_other_eur])+SUM([voucher_dh_eur])+SUM([voucher_other_eur]))/SUM([gmv_eur]))' />
      </column>
      <column caption='Total Discount Amount E/L' datatype='real' name='[Calculation_2495416437166116880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;IF [Parameters].[Parameter 8] = &apos;Euro&apos; THEN [discount_dh_eur]+[discount_other_eur]&#10;ELSE [discount_dh_local]+[discount_other_local]&#10;END)' />
      </column>
      <column caption='At Vendor Time' datatype='real' name='[Calculation_2759510356747177984]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([at_vendor_time_min_sum])/SUM([at_vendor_time_min_count])' />
      </column>
      <column caption='Hold Back Time' datatype='real' name='[Calculation_2759510356747427841]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([holdback_time_sec_sum])/SUM([holdback_time_sec_count]))/60' />
      </column>
      <column caption='Estimated Prep Time' datatype='real' name='[Calculation_2759510356747575298]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([estimated_prep_time_min_sum])/SUM([estimated_prep_time_count])' />
      </column>
      <column caption='Order Delay' datatype='real' name='[Calculation_2759510356748083203]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([delivery_delay_count])/SUM([successful_order_count])' />
      </column>
      <column caption='Order Delay 5 min' datatype='real' name='[Calculation_2759510356748189700]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([delivery_delay_5_min_count])/SUM([successful_order_count])' />
      </column>
      <column caption='Stacking Rate' datatype='real' name='[Calculation_2759510356749500421]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([stacked_orders_count])/SUM([successful_order_count])' />
      </column>
      <column caption='Vendor Fail Rate' datatype='real' name='[Calculation_2759510356749979654]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([failed_orders_vendor])/SUM([successful_order_count]))' />
      </column>
      <column caption='Rider Delay 5 min' datatype='real' name='[Calculation_2759510356750639111]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([rider_late_5_min_count])/SUM([successful_order_count])' />
      </column>
      <column caption='AOV Euro/Local' datatype='real' default-format='c&quot;€&quot;#,##0.0;-&quot;€&quot;#,##0.0' name='[Calculation_283304626959994884]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_2079185309815750657])&#10;/&#10;SUM([successful_order_count])' />
      </column>
      <column caption='Avg Delivery Time' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_283304626960986117]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([delivery_min_sum])&#10;/&#10;SUM([delivery_min_count]))' />
      </column>
      <column caption='Avg Rating' datatype='real' default-format='p0.0%' name='[Calculation_283304626961231878]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([converted_rating_total])*5&#10;/&#10;SUM([rated_orders_count]))' />
      </column>
      <column caption='Fail Rate' datatype='real' default-format='p0.0%' name='[Calculation_283304626961436679]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([failed_order_count])&#10;/&#10;(SUM([failed_order_count])+SUM([successful_order_count]))' />
      </column>
      <column caption='Commission Rate' datatype='real' default-format='p0.00%' name='[Calculation_283304626962989064]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([commission_eur])&#10;/&#10;SUM([gmv_eur])' />
      </column>
      <column caption='Online Minutes avg' datatype='real' name='[Calculation_2998904777393471490]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([schedule_minutes]) - SUM([offline_minutes]))/COUNTD(IF [schedule_minutes] &gt; 0 THEN [vendor_id] END)/COUNTD(IF [schedule_minutes]&gt;0 THEN [report_date] END)' />
      </column>
      <column caption='Breakdown by' datatype='string' name='[Calculation_313563136351502344]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='Case [Parameters].[Parameter 10]&#10;WHEN &apos;City&apos; THEN [City KSA (copy)_3849733268036108288]&#10;WHEN &apos;Kitchen Name&apos; THEN [Kitchen Name  (copy)_3341108018553868290]&#10;WHEN &apos;Partner Name&apos; THEN [Partner Name (copy)_3341108018554220548]&#10;When &apos;Brand&apos; THEN [Brand (copy)_3341108018553786368]&#10;END' />
      </column>
      <column caption='Avg Distance Delivered' datatype='real' name='[Calculation_3191292952450838528]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([delivery_distance_sum]) / SUM([delivery_distance_count]))/1000' />
      </column>
      <column caption='Vendor Maturity' datatype='string' name='[Calculation_3340826505906548736]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [onboarding_month] &gt;=  DATEADD(&apos;month&apos;, -2, DATETRUNC(&apos;month&apos;, TODAY())) AND [global_entity_id] = &apos;HS_SA&apos; THEN &apos;New Vendors&apos;&#10;ELSEIF [onboarding_month] &lt; DATEADD(&apos;month&apos;, -2, DATETRUNC(&apos;month&apos;, TODAY())) AND [global_entity_id] = &apos;HS_SA&apos; THEN &apos;Aged Vendors&apos;&#10;ELSEIF [onboarding_month] = DATETRUNC(&apos;month&apos;, TODAY()) THEN &apos;New&apos;&#10;ELSEIF [onboarding_month] &gt;=  DATEADD(&apos;month&apos;, -6, DATETRUNC(&apos;month&apos;, TODAY())) THEN &apos;Non Aged&apos;&#10;ELSEIF [onboarding_month] &lt; DATEADD(&apos;month&apos;, -6, DATETRUNC(&apos;month&apos;, TODAY())) THEN &apos;Aged&apos;&#10;END' />
      </column>
      <column caption='ADOS' datatype='real' name='[Calculation_3384244016838606848]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF report_date!= TODAY() THEN [successful_order_count] END)/COUNTD(IF [successful_order_count]&gt;0 AND [report_date]!=TODAY() THEN [report_date] END))/COUNTD(IF [successful_order_count]&gt;0 AND[report_date]!=TODAY() THEN [stall_number]+&apos;_&apos;+[kitchen_short_name] END)' />
      </column>
      <column caption='ADO' datatype='real' name='[Calculation_3384244016838705153]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [report_date]!= TODAY() THEN [successful_order_count] END) /COUNTD(IF[successful_order_count]&gt;0 AND [report_date] != TODAY() THEN [report_date] END)' />
      </column>
      <column caption='KPI Measure Cal' datatype='real' datatype-customized='true' name='[Calculation_3468475425963737088]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN &quot;Order Forecast&quot; THEN  SUM([Calculation_764415711604879362])&#10;WHEN &apos;Orders&apos; THEN SUM([successful_order_count])&#10;WHEN &apos;Orders per Day&apos; THEN SUM(IF [report_date]!= TODAY() THEN [successful_order_count] END) /COUNTD(IF[successful_order_count]&gt;0 AND [report_date] != TODAY() THEN [report_date] END)&#10;WHEN &apos;Orders per Stall per Day&apos; THEN (SUM(IF report_date!= TODAY() THEN [successful_order_count] END)/COUNTD(IF [successful_order_count]&gt;0 AND [report_date]!=TODAY() THEN [report_date] END))/COUNTD(IF [successful_order_count]&gt;0 AND[report_date]!=TODAY() THEN [stall_number]+&apos;_&apos;+[kitchen_short_name] END)&#10;WHEN &apos;Delivery Distance&apos; THEN (SUM([delivery_distance_sum]) / SUM([delivery_distance_count]))/1000&#10;WHEN &apos;Fail Rate&apos; THEN (SUM([failed_order_count])/(SUM([failed_order_count])+SUM([successful_order_count])))*100&#10;WHEN &apos;Failed Orders&apos; THEN SUM([failed_order_count])&#10;WHEN &apos;Rejection Rate&apos; THEN (SUM([failed_orders_vendor])/SUM([successful_order_count]))*100&#10;WHEN &apos;Rating&apos; THEN (SUM([converted_rating_total])/SUM([rated_orders_count]))*5&#10;WHEN &apos;Commission Rate&apos; THEN SUM([Calculation_2079185309817233411])/SUM([Calculation_2079185309815750657])*100&#10;WHEN &apos;Average Order Value&apos; THEN SUM([Calculation_2079185309815750657])/SUM([successful_order_count])&#10;WHEN &apos;Delivery Time&apos; THEN (SUM([delivery_min_sum])/SUM([delivery_min_count]))&#10;WHEN &apos;GMV&apos; THEN SUM([Calculation_2079185309815750657])&#10;WHEN &apos;Preparation Time&apos; THEN (SUM([prep_time_tb_sum])/SUM([prep_time_tb_count]))&#10;WHEN &apos;Estimated Prep Time&apos; THEN (SUM([estimated_prep_time_min_sum])/SUM([estimated_prep_time_count]))&#10;WHEN &apos;Food is ready&apos; THEN (SUM([food_ready_min_sum])/SUM([food_ready_min_count]))&#10;WHEN &apos;FIR Orders&apos; THEN SUM([food_ready_min_count])&#10;WHEN &apos;Confident FIR Orders&apos; THEN SUM([confident_fir_order_count])&#10;WHEN &apos;% Confident FIR&apos; THEN (SUM([confident_fir_order_count])/SUM(IF CONTAINS([global_entity_id], &apos;TB&apos;) THEN [fir_confident_use_tlb_count] ELSE [successful_order_count] END))*100&#10;WHEN &apos;% FIR&apos; THEN SUM([food_ready_min_count])/SUM([successful_order_count])*100&#10;WHEN &apos;CVR&apos; THEN (SUM([transactions])/SUM([menu]))*100&#10;WHEN &apos;Reorder Rate*&apos; THEN (SUM([returned_customers_same_vendor_30d_ft])/SUM([new_customer_restaurant]))*100&#10;WHEN &apos;Online Time Rate&apos; THEN (1 - sum([offline_minutes])/sum([schedule_minutes]))*100&#10;WHEN &apos;Offline Time Rate&apos; THEN sum([offline_minutes])/sum([schedule_minutes])*100&#10;WHEN &apos;Menu Sessions&apos; THEN SUM([menu])&#10;WHEN &apos;Transactions&apos; THEN SUM([transactions])&#10;WHEN &apos;GBV&apos; THEN [Calculation_5885782551741943810]&#10;WHEN &apos;Total Subsidies/GBV&apos; THEN ((SUM([Calculation_2079185309818232837])+SUM([Calculation_2079185309818966022])+SUM([Calculation_2079185309819568135])+SUM([Calculation_2079185309820207112]))/[Calculation_5885782551741943810])*100&#10;WHEN &apos;Total Subsidies&apos; THEN SUM([Calculation_2079185309818232837])+SUM([Calculation_2079185309818966022])+SUM([Calculation_2079185309819568135])+SUM([Calculation_2079185309820207112])&#10;WHEN &apos;Voucher&apos; THEN SUM([Calculation_2079185309819568135])+SUM([Calculation_2079185309820207112])&#10;WHEN &apos;Discount&apos; THEN SUM([Calculation_2079185309818232837])+SUM([Calculation_2079185309818966022])&#10;WHEN &apos;ABV&apos; THEN [Calculation_5885782551741943810]/SUM([successful_order_count])&#10;WHEN &apos;Total Subsidies/GMV&apos; THEN ((SUM([Calculation_2079185309818232837])+SUM([Calculation_2079185309818966022])+SUM([Calculation_2079185309819568135])+SUM([Calculation_2079185309820207112]))/SUM([Calculation_2079185309815750657]))*100&#10;WHEN &apos;Voucher(Order)&apos; THEN SUM([voucher_orders_count])&#10;WHEN &apos;Discount(Order)&apos; THEN SUM([discount_orders_count])&#10;WHEN &apos;Vendor Delay &gt; 5 min&apos; THEN (SUM([vendor_late_5_min_count])/SUM([successful_order_count]))*100&#10;WHEN &apos;Vendor Delay &gt; 10 min&apos; THEN (SUM([vendor_late_10_min_count])/SUM([successful_order_count]))*100&#10;WHEN &apos;% Discount&apos; THEN (SUM([discount_orders_count])/SUM([successful_order_count]))*100&#10;WHEN &apos;Delivery Fee avg&apos; THEN SUM([Calculation_2079185309820768265])/SUM([successful_order_count])&#10;WHEN &apos;Online Minutes&apos; THEN (SUM([schedule_minutes]) - SUM([offline_minutes]))/COUNTD(IF [schedule_minutes] &gt; 0 THEN [vendor_id] END)/COUNTD(IF [schedule_minutes]&gt;0 THEN [report_date] END)&#10;WHEN &apos;Rider Late 5 min&apos; THEN SUM([rider_late_5_min_count])/SUM([successful_order_count])*100&#10;WHEN &apos;At vendor time, min&apos; THEN ROUND(SUM([at_vendor_time_min_sum])/SUM([at_vendor_time_min_count]),1)&#10;WHEN &apos;Stacked Rate, %&apos; THEN SUM([stacked_orders_count])/SUM([successful_order_count])*100&#10;WHEN &apos;Intravendor Rate, %&apos; THEN [Calculation_4004403765344100352]*100&#10;WHEN &apos;Pickup Orders&apos; THEN SUM([pickup_orders])&#10;WHEN &apos;Pickup time&apos; THEN SUM([time_to_pickup_min_sum])/SUM([time_to_pickup_min_count])&#10;WHEN &apos;Time to pick up cleaned&apos; THEN ROUND(SUM([time_to_pickup_cleaned_min_sum])/SUM([time_to_pickup_cleaned_min_count]),1)&#10;WHEN &apos;Pickup Rate&apos; THEN SUM([pickup_orders])/SUM([successful_order_count])*100&#10;END' />
      </column>
      <column caption='Suffix' datatype='string' name='[Calculation_3468475425972117505]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;Fail Rate&apos; THEN &apos;%&apos;&#10;WHEN &apos;Commission Rate&apos; THEN &apos;%&apos;&#10;WHEN &apos;Stacked Rate, %&apos; THEN &apos;%&apos;&#10;WHEN &apos;Intravendor Rate, %&apos; THEN &apos;%&apos;&#10;WHEN &apos;Rider Late 5 min&apos; THEN &apos;%&apos;&#10;WHEN &apos;Delivery Time&apos; THEN &apos;m&apos;&#10;WHEN &apos;Delivery Distance&apos; THEN &apos;km&apos;&#10;WHEN &apos;Food is ready&apos; THEN &apos;m&apos;&#10;WHEN &apos;Preparation Time&apos; THEN &apos;m&apos;&#10;WHEN &apos;Estimated Prep Time&apos; THEN &apos;m&apos;&#10;WHEN &apos;At vendor time, min&apos; THEN &apos;m&apos;&#10;WHEN &apos;CVR&apos; THEN &apos;%&apos;&#10;WHEN &apos;Reorder Rate*&apos; THEN &apos;%&apos;&#10;WHEN &apos;Online Time Rate&apos; THEN &apos;%&apos;&#10;WHEN &apos;Offline Time Rate&apos; THEN &apos;%&apos;&#10;WHEN &apos;Pickup Rate&apos; THEN &apos;%&apos;&#10;WHEN &apos;Online Minutes&apos; THEN &apos;m&apos;&#10;WHEN &apos;Total Subsidies/GBV&apos; THEN &apos;%&apos;&#10;WHEN &apos;Total Subsidies/GMV&apos; THEN &apos;%&apos;&#10;WHEN &apos;Vendor Fail Rate&apos; THEN &apos;%&apos;&#10;WHEN &apos;Vendor Delay &gt; 5 min&apos; THEN &apos;%&apos;&#10;WHEN &apos;Vendor Delay &gt; 10 min&apos; THEN &apos;%&apos;&#10;&#10;END' />
      </column>
      <column caption='Kitchen_Count' datatype='integer' name='[Calculation_3538421993700298755]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(COUNTD([kitchen_area]))' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_3699284905920208896]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]=USERNAME()' />
      </column>
      <column caption='Measure 1' datatype='real' name='[Calculation_3699284906489057286]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[KPI Measure (copy)_3699284906488201220]&#10;WHEN &apos;Orders&apos; THEN SUM([successful_order_count])&#10;WHEN &apos;Delivery Distance&apos; THEN (SUM([delivery_distance_sum]) / SUM([delivery_distance_count]))/1000&#10;WHEN &apos;Fail Rate&apos; THEN (SUM([failed_order_count])/(SUM([failed_order_count])+SUM([successful_order_count])))*100&#10;WHEN &apos;Rating&apos; THEN (SUM([converted_rating_total])/SUM([rated_orders_count]))*5&#10;WHEN &apos;Commission Rate&apos; THEN SUM([commission_eur])/SUM([gmv_eur])*100&#10;WHEN &apos;Average Order Value&apos; THEN SUM([gmv_eur])/SUM([successful_order_count])&#10;WHEN &apos;Delivery Time&apos; THEN (SUM([delivery_min_sum])/SUM([delivery_min_count]))&#10;WHEN &apos;GMV&apos; THEN SUM([gmv_eur])&#10;WHEN &apos;Preparation Time&apos; THEN (SUM([prep_min_sum])/SUM([prep_min_count]))&#10;WHEN &apos;CVR&apos; THEN (SUM([transactions])/SUM([menu]))*100&#10;WHEN &apos;Reorder Rate*&apos; THEN (SUM([returned_customers_same_vendor_30d_ft])/SUM([new_customer_restaurant]))*100&#10;WHEN &apos;Online Time Rate&apos; THEN (1 - sum([offline_minutes])/sum([schedule_minutes]))*100&#10;WHEN &apos;Menu Sessions&apos; THEN SUM([menu])&#10;WHEN &apos;Transactions&apos; THEN SUM([transactions])&#10;WHEN &apos;GBV&apos; THEN SUM([gbv_eur])&#10;WHEN &apos;Total Subsidies/GBV&apos; THEN ((SUM([discount_dh_eur])+SUM([discount_other_eur])+SUM([voucher_dh_eur])+SUM([voucher_other_eur]))/SUM([gbv_eur]))*100&#10;WHEN &apos;Total Subsidies&apos; THEN SUM([discount_dh_eur])+SUM([discount_other_eur])+SUM([voucher_dh_eur])+SUM([voucher_other_eur])&#10;WHEN &apos;Voucher&apos; THEN SUM([voucher_dh_eur])+SUM([voucher_other_eur])&#10;WHEN &apos;Discount&apos; THEN SUM([discount_dh_eur])+SUM([discount_other_eur])&#10;WHEN &apos;ABV&apos; THEN SUM([gbv_eur])/SUM([successful_order_count])&#10;WHEN &apos;Total Subsidies/GMV&apos; THEN ((SUM([discount_dh_eur])+SUM([discount_other_eur])+SUM([voucher_dh_eur])+SUM([voucher_other_eur]))/SUM([gmv_eur]))*100&#10;END' />
      </column>
      <column caption='Month_segment' datatype='string' name='[Calculation_3780701528187092992]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATETRUNC(&apos;month&apos;, [report_date]) = DATETRUNC(&apos;month&apos;, TODAY()) THEN &quot;CM&quot;&#10;ELSEIF DATETRUNC(&apos;month&apos;, [report_date]) &gt;= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -3, TODAY())) THEN &quot;P3M&quot;&#10;ELSE &quot;Historical&quot;&#10;END' />
      </column>
      <column caption='Billable_orders_per_day' datatype='real' name='[Calculation_3780701528187498497]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([successful_order_count])/COUNTD([report_date])' />
      </column>
      <column caption='Day_of_week' datatype='string' name='[Calculation_3780701528207806471]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;, [report_date])' />
      </column>
      <column caption='Kitchen Segment' datatype='string' name='[Calculation_3795549365267267584]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [country_name]=&apos;Saudi Arabia&apos; THEN &apos;KSA&apos;&#10;&#10;ELSE [segment] END' />
      </column>
      <column caption='Intravendor Share %' datatype='real' name='[Calculation_4004403765344100352]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([stacked_intravendor_count])/SUM([stacked_orders_count])' />
      </column>
      <column caption='Color rank' datatype='real' name='[Calculation_4639692803792998409]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3699284906489057286]*[Dinamic Measure 1 (copy)_4639692803691298816]' />
      </column>
      <column caption='City KSA' datatype='string' name='[Calculation_5117144740759887872]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([kitchen_area], &quot;Riyadh&quot;) THEN &quot;Riyadh&quot;&#10; ELSEIF CONTAINS([kitchen_area], &quot;Jeddah&quot;) THEN &quot;Jeddah&quot; &#10; ELSEIF CONTAINS([kitchen_area], &quot;Dammam&quot;) OR CONTAINS([kitchen_area], &quot;Khobar&quot;) THEN &quot;Dammam&quot;&#10;END' />
      </column>
      <column caption='Kitchen Age' datatype='string' name='[Calculation_5140929350716956672]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='RIGHT([facility_maturity], LEN([facility_maturity]) -3)' />
      </column>
      <column caption='Discount Rate' datatype='real' name='[Calculation_5334302691446566912]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([discount_orders_count])/SUM([successful_order_count])' />
      </column>
      <column caption='Avg Delivery Fee, local' datatype='real' name='[Calculation_5334302691447013377]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([delivery_fee_local])/SUM([successful_order_count])' />
      </column>
      <column caption='KPI FIlter' datatype='string' name='[Calculation_53761751548362754]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 3]' />
      </column>
      <column caption='KPI Splittted' datatype='string' name='[Calculation_53761751550197763]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 4]' />
      </column>
      <column caption='Vendor Density' datatype='real' name='[Calculation_5885782551735472129]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendor_count])&#10;/COUNTD([report_date])&#10;//AVG([vendor_count])' />
      </column>
      <column caption='GBV euro/local' datatype='real' name='[Calculation_5885782551741943810]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Parameters].[Parameter 8]=&apos;Euro&apos; THEN [gbv_eur] ELSE [gbv_local] END)' />
      </column>
      <column caption='Orders Per Vendor' datatype='real' name='[Calculation_5885782551742136323]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([successful_order_count])/(SUM([vendor_count])/COUNTD([report_date]))' />
      </column>
      <column caption='Avg. Items Per Order' datatype='real' name='[Calculation_5885782551742332932]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_items_sold])/SUM([successful_order_count])' />
      </column>
      <column caption='Rejection Rate' datatype='real' name='[Calculation_5885782551754620933]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([failed_orders_vendor])/SUM([successful_order_count]))' />
      </column>
      <column caption='Contact Rate' datatype='real' name='[Calculation_5885782551754743814]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([total_contacts])/Sum([successful_order_count]))' />
      </column>
      <column caption='FIR Time' datatype='real' name='[Calculation_5885782551754862599]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([food_ready_min_sum])/SUM([food_ready_min_count]))' />
      </column>
      <column caption='Total Subsidies DH Euro/Local' datatype='real' name='[Calculation_5885782551755218952]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Parameters].[Parameter 8] = &apos;Euro&apos; THEN[discount_dh_eur]+[voucher_dh_eur]&#10;else [discount_dh_local]+[voucher_dh_local]&#10;END)' />
      </column>
      <column caption='Total Subsidies Other E/L' datatype='real' name='[Calculation_5885782551755358217]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Parameters].[Parameter 8] = &apos;Euro&apos; THEN [discount_other_eur]+[voucher_other_eur]&#10;ELSE [discount_other_local]+[voucher_other_local]&#10;END)' />
      </column>
      <column caption='Vendor Delay &gt; 5 min' datatype='real' name='[Calculation_5885782551755489290]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([vendor_late_5_min_count])/SUM([successful_order_count]))' />
      </column>
      <column caption='Partner Name fte' datatype='string' name='[Calculation_598415803217719296]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[partner_name]' />
      </column>
      <column caption='Kitchen Name fte' datatype='string' name='[Calculation_598415803217821697]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[kitchen_short_name]' />
      </column>
      <column caption='Monthly Forecast' datatype='real' name='[Calculation_764415711604879362]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 7] = &quot;Monthly&quot; &#10;                 AND DATETRUNC(&quot;month&quot;, [Calculation_145170742309019648]) = DATETRUNC(&quot;month&quot;, TODAY()) &#10;                 AND [report_date] != TODAY() &#10;            THEN &#10;                [successful_order_count] * DAY(DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, 1, TODAY())) - 1) / (DAY(TODAY() - 1))  &#10;            ELSE &#10;                [successful_order_count]&#10;END' />
      </column>
      <column caption='Partner Live' datatype='boolean' name='[Calculation_869194771949228032]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([stall_partner_churn_month]) THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Offline Rate' datatype='real' name='[Calculation_999376925623963648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([offline_minutes])/SUM([schedule_minutes])*100' />
      </column>
      <column caption='City' datatype='string' name='[City KSA (copy)_3849733268036108288]' role='dimension' semantic-role='[City].[Name]' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([kitchen_area], &quot;Riyadh&quot;) THEN &quot;Riyadh&quot;&#10; ELSEIF CONTAINS([kitchen_area], &quot;Jeddah&quot;) THEN &quot;Jeddah&quot; &#10; ELSEIF CONTAINS([kitchen_area], &quot;Dammam&quot;) OR CONTAINS([kitchen_area], &quot;Khobar&quot;) THEN &quot;Dammam&quot;&#10; ELSE [city]&#10;END' />
      </column>
      <column caption='Country (cuisine)' datatype='string' name='[Country (copy)_2924525049448173570]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
        <calculation class='tableau' formula='[country_name]' />
      </column>
      <column caption='Country ' datatype='string' name='[Country (copy)_3341108018553831425]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
        <calculation class='tableau' formula='[country_name]' />
      </column>
      <column caption='Country   ' datatype='string' name='[Country (copy)_6684397396603670528]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
        <calculation class='tableau' formula='[country_name]' />
      </column>
      <column caption='Measure 2' datatype='real' name='[Dinamic Measure 1 (copy)_4639692803691298816]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Measure 1 (copy)_2495416437150093323]&#10;WHEN &apos;Orders&apos; THEN SUM([successful_order_count])&#10;WHEN &apos;Delivery Distance&apos; THEN (SUM([delivery_distance_sum]) / SUM([delivery_distance_count]))/1000&#10;WHEN &apos;Fail Rate&apos; THEN (SUM([failed_order_count])/(SUM([failed_order_count])+SUM([successful_order_count])))*100&#10;WHEN &apos;Rating&apos; THEN (SUM([converted_rating_total])/SUM([rated_orders_count]))*5&#10;WHEN &apos;Commission Rate&apos; THEN SUM([commission_eur])/SUM([gmv_eur])*100&#10;WHEN &apos;Average Order Value&apos; THEN SUM([gmv_eur])/SUM([successful_order_count])&#10;WHEN &apos;Delivery Time&apos; THEN (SUM([delivery_min_sum])/SUM([delivery_min_count]))&#10;WHEN &apos;GMV&apos; THEN SUM([gmv_eur])&#10;WHEN &apos;Preparation Time&apos; THEN (SUM([prep_min_sum])/SUM([prep_min_count]))&#10;WHEN &apos;CVR&apos; THEN (SUM([transactions])/SUM([menu]))*100&#10;WHEN &apos;Reorder Rate*&apos; THEN (SUM([returned_customers_same_vendor_30d_ft])/SUM([new_customer_restaurant]))*100&#10;WHEN &apos;Online Time Rate&apos; THEN (1 - sum([offline_minutes])/sum([schedule_minutes]))*100&#10;WHEN &apos;Menu Sessions&apos; THEN SUM([menu])&#10;WHEN &apos;Transactions&apos; THEN SUM([transactions])&#10;WHEN &apos;GBV&apos; THEN SUM([gbv_eur])&#10;WHEN &apos;Total Subsidies/GBV&apos; THEN ((SUM([discount_dh_eur])+SUM([discount_other_eur])+SUM([voucher_dh_eur])+SUM([voucher_other_eur]))/SUM([gbv_eur]))*100&#10;WHEN &apos;Total Subsidies&apos; THEN SUM([discount_dh_eur])+SUM([discount_other_eur])+SUM([voucher_dh_eur])+SUM([voucher_other_eur])&#10;WHEN &apos;Voucher&apos; THEN SUM([voucher_dh_eur])+SUM([voucher_other_eur])&#10;WHEN &apos;Discount&apos; THEN SUM([discount_dh_eur])+SUM([discount_other_eur])&#10;WHEN &apos;ABV&apos; THEN SUM([gbv_eur])/SUM([successful_order_count])&#10;WHEN &apos;Total Subsidies/GMV&apos; THEN ((SUM([discount_dh_eur])+SUM([discount_other_eur])+SUM([voucher_dh_eur])+SUM([voucher_other_eur]))/SUM([gmv_eur]))*100&#10;END' />
      </column>
      <column caption='Dimension' datatype='string' name='[Dinamic Measure 1 (copy)_4639692803691524097]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Dinamic Measure 1 (copy)_4639692803691544578]&#10;WHEN &apos;Segment&apos; THEN [segment]&#10;WHEN &apos;Management Entity&apos; THEN [management_entity]&#10;WHEN &apos;Country&apos; THEN [country_name]&#10;WHEN &apos;Sub Entity&apos; THEN [sub_entity]&#10;WHEN &apos;Brand&apos; THEN [brand]&#10;WHEN &apos;Kitchen Group&apos; THEN [kitchen_group]&#10;WHEN &apos;Kitchen Type&apos; THEN [kitchen_type]&#10;WHEN &apos;Kitchen Name&apos; THEN [kitchen_area]&#10;END' />
      </column>
      <column caption='Discounted Orders Diff %' datatype='real' name='[GMV eur Diff % (copy)_2835297506464428032]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([discount_orders_count])) - LOOKUP(ZN(SUM([discount_orders_count])), -1)) / ABS(LOOKUP(ZN(SUM([discount_orders_count])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='AOV_eur_before' datatype='real' name='[GMV_eur_before (copy)_1418141367141359634]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(ZN([Calculation_283304626959994884]), -1)'>
          <table-calc ordering-type='Rows' />
