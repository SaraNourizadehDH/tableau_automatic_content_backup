          <zone forceUpdate='true' h='5519' id='560' type-v2='text' w='14598' x='84902' y='615'>
            <formatted-text>
              <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='11'>FILTERS</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
