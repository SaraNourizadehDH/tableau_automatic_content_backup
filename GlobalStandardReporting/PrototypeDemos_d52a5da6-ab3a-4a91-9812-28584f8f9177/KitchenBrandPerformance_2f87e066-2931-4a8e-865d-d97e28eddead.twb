        <calculation class='tableau' formula='if [Calculation_1634384517332602886] &lt; 0 then &quot;▼&quot;&#10;end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='orders diff up' datatype='string' name='[Calculation_1418141367094759425]' role='measure' type='nominal'>
