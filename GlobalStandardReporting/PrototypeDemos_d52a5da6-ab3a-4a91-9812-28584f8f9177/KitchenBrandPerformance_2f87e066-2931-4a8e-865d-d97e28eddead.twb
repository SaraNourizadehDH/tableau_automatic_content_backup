        </calculation>
      </column>
      <column caption='Period Before' datatype='date' name='[Calculation_1418141367097716738]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATE(&#10;IF [Parameters].[Parameter 7] = &apos;Weekly&apos; THEN DATEADD(&apos;week&apos;,-1, DATETRUNC(&apos;week&apos;,[report_date], &apos;monday&apos;))&#10;ELSEIF [Parameters].[Parameter 7] = &apos;Monthly&apos; THEN DATEADD(&apos;month&apos;,-1, DATETRUNC(&apos;month&apos;,[report_date]))&#10;END)' />
      </column>
      <column caption='Successful Orders before' datatype='real' name='[Calculation_1418141367099469827]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(ZN(sum([successful_order_count])), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Report Period Date' datatype='date' datatype-customized='true' name='[Calculation_145170742309019648]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 7]&#10;WHEN &apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;,[report_date])&#10;WHEN &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;,[report_date])&#10;WHEN &apos;Daily&apos; THEN [report_date]&#10;WHEN &apos;Yearly&apos; THEN DATETRUNC(&apos;year&apos;,[report_date])&#10;WHEN &apos;Quarter&apos; THEN DATETRUNC(&apos;quarter&apos;, report_date )&#10;END)' />
      </column>
      <column caption='Unique vendors' datatype='string' name='[Calculation_1634384517307068416]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[global_entity_id] + [vendor_id]' />
      </column>
      <column caption='Kitchens with orders' datatype='string' name='[Calculation_1634384517311979521]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [successful_order_count] &gt; 0 THEN [kitchen_area] END' />
      </column>
      <column caption='Vendors with orders' datatype='string' name='[Calculation_1634384517312544770]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [successful_order_count] &gt; 0 THEN [vendor_id] END' />
      </column>
      <column caption='last 2 periods' datatype='boolean' name='[Calculation_1634384517331169285]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 7] = &apos;Weekly&apos; THEN&#10;DATEDIFF(&quot;week&quot;, [report_date], TODAY(), &apos;monday&apos;) =1 or DATEDIFF(&quot;week&quot;, [report_date], TODAY(), &apos;monday&apos;) = 2&#10;ELSEIF [Parameters].[Parameter 7] = &apos;Monthly&apos; THEN&#10;DATEDIFF(&quot;month&quot;, [report_date], TODAY())= 1 or DATEDIFF(&quot;month&quot;, [report_date], TODAY())= 2&#10;END' />
      </column>
      <column caption='Orders Diff %' datatype='real' name='[Calculation_1634384517332602886]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([successful_order_count])) - LOOKUP(ZN(SUM([successful_order_count])), -1)) / ABS(LOOKUP(ZN(SUM([successful_order_count])), -1))'>
