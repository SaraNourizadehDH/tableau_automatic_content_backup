    <worksheet name='Benchm. A.: Kitchen Measure General '>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ff0000'>Kitchens</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='dwh_bl.kitchen_brand_performance' name='federated.14iaiy6010lznw13xgy0y1m02vq5' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='KPI Measure (Benchmark)' datatype='string' name='[KPI Measure (copy)_4132404552623636483]' param-domain-type='list' role='measure' type='nominal' value='&quot;Orders&quot;'>
              <calculation class='tableau' formula='&quot;Orders&quot;' />
              <aliases>
                <alias key='&quot;Average Order Value&quot;' value='AOV' />
              </aliases>
            </column>
            <column caption='KPI Split' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Yes&quot;'>
              <calculation class='tableau' formula='&quot;Yes&quot;' />
            </column>
            <column caption='Date Parameter' datatype='string' name='[Parameter 7]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
            <column caption='Currency Switcher' datatype='string' name='[Parameter 8]' param-domain-type='list' role='measure' type='nominal' value='&quot;Local&quot;'>
              <calculation class='tableau' formula='&quot;Local&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.14iaiy6010lznw13xgy0y1m02vq5'>
            <column caption='Report Period Date' datatype='date' datatype-customized='true' name='[Calculation_145170742309019648]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 7]&#10;WHEN &apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;,[report_date])&#10;WHEN &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;,[report_date])&#10;WHEN &apos;Daily&apos; THEN [report_date]&#10;WHEN &apos;Yearly&apos; THEN DATETRUNC(&apos;year&apos;,[report_date])&#10;WHEN &apos;Quarter&apos; THEN DATETRUNC(&apos;quarter&apos;, report_date )&#10;END)' />
            </column>
            <column caption='GMV euro/local' datatype='real' name='[Calculation_2079185309815750657]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 8] = &apos;Euro&apos; THEN [gmv_eur] ELSE [gmv_local] END' />
            </column>
            <column caption='Discount DH Local/Euro' datatype='real' name='[Calculation_2079185309818232837]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 8] = &apos;Euro&apos; THEN [discount_dh_eur]&#10;ELSE [discount_dh_local]&#10;END' />
            </column>
            <column caption='Discount other Euro/Local' datatype='real' name='[Calculation_2079185309818966022]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='If [Parameters].[Parameter 8] = &apos;Euro&apos; THEN [discount_other_eur]&#10;ELSE [discount_other_local]&#10;END' />
            </column>
            <column caption='Voucher DH euro/local' datatype='real' name='[Calculation_2079185309819568135]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 8] = &apos;Euro&apos; THEN [voucher_dh_eur] ELSE [voucher_dh_local] END' />
            </column>
            <column caption='Voucher other Euro/Local' datatype='real' name='[Calculation_2079185309820207112]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 8] = &apos;Euro&apos; THEN [voucher_other_eur]&#10;ELSE [voucher_other_local]&#10;END' />
            </column>
            <column caption='Vendor Maturity' datatype='string' name='[Calculation_3340826505906548736]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  [onboarding_month] &gt;=  DATEADD(&apos;month&apos;, -2, DATETRUNC(&apos;month&apos;, TODAY())) AND [global_entity_id] = &apos;HS_SA&apos; THEN &apos;New Vendors&apos;&#10;ELSEIF [onboarding_month] &lt; DATEADD(&apos;month&apos;, -2, DATETRUNC(&apos;month&apos;, TODAY())) AND [global_entity_id] = &apos;HS_SA&apos; THEN &apos;Aged Vendors&apos;&#10;ELSEIF [onboarding_month] = DATETRUNC(&apos;month&apos;, TODAY()) THEN &apos;New&apos;&#10;ELSEIF [onboarding_month] &gt;=  DATEADD(&apos;month&apos;, -6, DATETRUNC(&apos;month&apos;, TODAY())) THEN &apos;Non Aged&apos;&#10;ELSEIF [onboarding_month] &lt; DATEADD(&apos;month&apos;, -6, DATETRUNC(&apos;month&apos;, TODAY())) THEN &apos;Aged&apos;&#10;END' />
            </column>
            <column caption='Kitchen Segment' datatype='string' name='[Calculation_3795549365267267584]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [country_name]=&apos;Saudi Arabia&apos; THEN &apos;KSA&apos;&#10;&#10;ELSE [segment] END' />
            </column>
            <column caption='City KSA' datatype='string' name='[Calculation_5117144740759887872]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([kitchen_area], &quot;Riyadh&quot;) THEN &quot;Riyadh&quot;&#10; ELSEIF CONTAINS([kitchen_area], &quot;Jeddah&quot;) THEN &quot;Jeddah&quot; &#10; ELSEIF CONTAINS([kitchen_area], &quot;Dammam&quot;) OR CONTAINS([kitchen_area], &quot;Khobar&quot;) THEN &quot;Dammam&quot;&#10;END' />
            </column>
            <column caption='KPI Splittted' datatype='string' name='[Calculation_53761751550197763]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 4]' />
            </column>
            <column caption='GBV euro/local' datatype='real' name='[Calculation_5885782551741943810]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Parameters].[Parameter 8]=&apos;Euro&apos; THEN [gbv_eur] ELSE [gbv_local] END)' />
            </column>
            <column caption='Partner Live' datatype='boolean' name='[Calculation_869194771949228032]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([stall_partner_churn_month]) THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='KPI Measure Cal (Benchmark)' datatype='real' datatype-customized='true' name='[KPI Measure Cal (copy 2)_4132404552622768129]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[KPI Measure (copy)_4132404552623636483]&#10;WHEN &apos;Orders&apos; THEN SUM([successful_order_count])&#10;WHEN &apos;GBV&apos; THEN [Calculation_5885782551741943810]&#10;WHEN &apos;Vendor Density&apos; THEN SUM([vendor_count])/COUNTD([report_date])&#10;WHEN &apos;Orders per Vendor&apos; THEN SUM([successful_order_count])/(SUM([vendor_count])/COUNTD([report_date]))&#10;WHEN &apos;Average Order Value&apos; THEN SUM([Calculation_2079185309815750657])/SUM([successful_order_count])&#10;WHEN &apos;ABV&apos; THEN [Calculation_5885782551741943810]/SUM([successful_order_count])&#10;WHEN &apos;Avg. Items per Order&apos; THEN SUM([total_items_sold])/SUM([successful_order_count])&#10;WHEN &apos;Rating&apos; THEN (SUM([converted_rating_total])/SUM([rated_orders_count]))*5&#10;WHEN &apos;Vendor Fail Rate&apos; THEN (SUM([failed_orders_vendor])/SUM([successful_order_count]))*100&#10;WHEN &apos;Contact Rate&apos; THEN (SUM([total_contacts])/Sum([successful_order_count]))*100&#10;WHEN &apos;Avg. Food Ready Time&apos; THEN (SUM([food_ready_min_sum])/SUM([food_ready_min_count]))&#10;WHEN &apos;Preparation Time&apos; THEN (SUM([prep_time_tb_sum])/SUM([prep_time_tb_count]))&#10;WHEN &apos;Delivery Time&apos; THEN (SUM([delivery_min_sum])/SUM([delivery_min_count]))&#10;WHEN &apos;Total Subsidies/GMV&apos; THEN ((SUM([Calculation_2079185309818232837])+SUM([Calculation_2079185309818966022])+SUM([Calculation_2079185309819568135])+SUM([Calculation_2079185309820207112]))/SUM([Calculation_2079185309815750657]))*100&#10;WHEN &apos;Total Subsidies&apos; THEN SUM([Calculation_2079185309818232837])+SUM([Calculation_2079185309818966022])+SUM([Calculation_2079185309819568135])+SUM([Calculation_2079185309820207112])&#10;WHEN &apos;Total Subsidies DH&apos; THEN SUM([Calculation_2079185309818232837])+SUM([Calculation_2079185309819568135])&#10;WHEN &apos;Total Subsidies Other&apos; THEN SUM([Calculation_2079185309818966022])+SUM([Calculation_2079185309820207112])&#10;WHEN &apos;Vendor Delay &gt; 5 min&apos; THEN (SUM([vendor_late_5_min_count])/SUM([successful_order_count]))*100&#10;WHEN &apos;Vendor Delay &gt; 10 min&apos; THEN (SUM([vendor_late_10_min_count])/SUM([successful_order_count]))*100&#10;WHEN &apos;Online Time Rate&apos; THEN (1 - sum([offline_minutes])/sum([schedule_minutes]))*100&#10;WHEN &apos;Order Delay 5 min&apos; THEN SUM(order_delay_5_min_count)/SUM([successful_order_count])*100&#10;WHEN &apos;EPT, min&apos; THEN SUM(estimated_prep_time_min_sum)/SUM(estimated_prep_time_count)&#10;WHEN &apos;AVTC, min&apos; THEN ROUND((SUM([at_vendor_time_min_sum])/SUM([at_vendor_time_min_count])),1)&#10;WHEN &apos;EPT + AVTC&apos; THEN SUM(estimated_prep_time_min_sum)/SUM(estimated_prep_time_count) +  ROUND((SUM([at_vendor_time_min_sum])/SUM([at_vendor_time_min_count])),1)&#10;WHEN &apos;FIR Conf Rate&apos; THEN (SUM([confident_fir_order_count])/SUM(IF CONTAINS([global_entity_id], &apos;TB&apos;) THEN [fir_confident_use_tlb_count] ELSE [successful_order_count] END))*100&#10;WHEN &apos;Offline Rate&apos; THEN sum([offline_minutes])/sum([schedule_minutes])*100 &#10;WHEN &apos;Sessions&apos; THEN SUM([menu])&#10;WHEN &apos;Rider Delay 5 min&apos; THEN (SUM([rider_late_5_min_count])/SUM([successful_order_count]))*100&#10;&#10;END' />
            </column>
            <column caption='Suffix (Benchmark)' datatype='string' name='[Suffix (copy)_4132404552637575172]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[KPI Measure (copy)_4132404552623636483]&#10;WHEN &apos;Vendor Fail Rate&apos; THEN &apos;%&apos;&#10;WHEN &apos;Contact Rate&apos; THEN &apos;%&apos;&#10;WHEN &apos;Avg. Food Ready Time&apos; THEN &apos;m&apos;&#10;WHEN  &apos;Preparation Time&apos; THEN &apos;m&apos;&#10;WHEN &apos;Delivery Time&apos; THEN &apos;m&apos;&#10;WHEN &apos;Total Subsidies/GMV&apos; THEN &apos;%&apos;&#10;WHEN &apos;Vendor Delay &gt; 5 min&apos; THEN &apos;%&apos;&#10;WHEN &apos;Vendor Delay &gt; 10 min&apos; THEN &apos;%&apos;&#10;WHEN &apos;Online Time Rate&apos; THEN &apos;%&apos;&#10;WHEN &apos;Offline Rate&apos; THEN &apos;%&apos;&#10;WHEN &apos;Order Delay 5 min&apos; THEN &apos;%&apos;&#10;WHEN &apos;EPT, min&apos; THEN &apos;m&apos;&#10;WHEN &apos;AVTC, min&apos; THEN &apos;m&apos;&#10;WHEN &apos;FIR Conf Rate&apos; THEN &apos;%&apos;&#10;WHEN &apos;Rider Delay 5 min&apos; THEN &apos;%&apos;&#10;WHEN &apos;EPT + AVTC&apos; THEN &apos;m&apos;&#10;END' />
            </column>
            <column datatype='real' name='[at_vendor_time_min_count]' role='measure' type='quantitative' />
            <column datatype='real' name='[at_vendor_time_min_sum]' role='measure' type='quantitative' />
            <column caption='Brand' datatype='string' name='[brand]' role='dimension' type='nominal' />
            <column datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column datatype='real' name='[confident_fir_order_count]' role='measure' type='quantitative' />
            <column caption='Converted Rating Total' datatype='real' name='[converted_rating_total]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='real' name='[delivery_min_count]' role='measure' type='quantitative' />
            <column datatype='real' name='[delivery_min_sum]' role='measure' type='quantitative' />
            <column datatype='real' name='[discount_dh_eur]' role='measure' type='quantitative' />
            <column datatype='real' name='[discount_dh_local]' role='measure' type='quantitative' />
            <column datatype='real' name='[discount_other_eur]' role='measure' type='quantitative' />
            <column datatype='real' name='[discount_other_local]' role='measure' type='quantitative' />
            <column datatype='real' name='[estimated_prep_time_count]' role='measure' type='quantitative' />
