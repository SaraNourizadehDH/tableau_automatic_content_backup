          </datasources>
          <datasource-dependencies datasource='federated.0tvk7t70ah311s1df95em1n2atmx'>
            <column caption='AVTC B&amp;M' datatype='real' name='[AVTC (copy)_866450387306164236]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([bm_at_vendor_time_min_sum])/SUM([bm_at_vendor_time_min_count])' />
            </column>
            <column caption='Brand name   ' datatype='string' name='[Brand name   (copy)_1204290706378526759]' role='dimension' type='nominal'>
