  <worksheets>
    <worksheet name='BD'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>BD</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_kitchen_growth_report' name='federated.0tvk7t70ah311s1df95em1n2atmx' />
          </datasources>
          <datasource-dependencies datasource='federated.0tvk7t70ah311s1df95em1n2atmx'>
            <column caption='AVTC B&amp;M' datatype='real' name='[AVTC (copy)_866450387306164236]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([bm_at_vendor_time_min_sum])/SUM([bm_at_vendor_time_min_count])' />
            </column>
            <column caption='Score color' datatype='string' name='[Calculation_1184376373536325633]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_866450387320520729] &gt; 3 THEN &apos;green&apos;&#10;ELSEIF [Calculation_866450387320520729] = 3 THEN &apos;yellow&apos;&#10;ELSE &apos;red&apos;&#10;END' />
            </column>
            <column caption='Vendors Count' datatype='integer' name='[Calculation_1184376373545791491]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([vendor_id])' />
            </column>
            <column caption='Vendors with B&amp;M Count' datatype='integer' name='[Calculation_1184376373546057732]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF IFNULL([bm_prep_time_tb_count],0)!= 0 OR IFNULL([bm_rating_count],0)!= 0 OR IFNULL([bm_vendor_late_5_min_count],0)!= 0 &#10;OR IFNULL([bm_failed_orders_vendor],0)!=0 OR IFNULL([bm_schedule_minutes],0) != 0 OR IFNULL([bm_at_vendor_time_min_count],0) != 0&#10;THEN vendor_id END)' />
            </column>
            <column caption='B&amp;M Rate' datatype='real' name='[Calculation_1184376373547847685]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1184376373546057732]/[Calculation_1184376373545791491]' />
            </column>
            <column caption='Prep time' datatype='real' name='[Calculation_866450387295170560]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([prep_time_tb_sum])/SUM([prep_time_tb_count])' />
            </column>
            <column caption='Rating' datatype='real' name='[Calculation_866450387295584257]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([converted_rating_sum])*5/SUM([rating_count])' />
            </column>
            <column caption='Vendor Late 5 min' datatype='real' name='[Calculation_866450387297308674]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_5_min_count])/SUM([successful_orders])' />
            </column>
            <column caption='Rejection Rate' datatype='real' name='[Calculation_866450387297574915]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_orders_vendor])/SUM([successful_orders])' />
            </column>
            <column caption='Offline Rate' datatype='real' name='[Calculation_866450387298422788]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([offline_minutes])/SUM([schedule_minutes])' />
            </column>
            <column caption='AVTC' datatype='real' name='[Calculation_866450387298783237]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([at_vendor_time_min_sum])/SUM([at_vendor_time_min_count])' />
            </column>
            <column caption='Prep time diff' datatype='real' name='[Calculation_866450387306553357]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_866450387295170560] - [Prep time (copy)_866450387304697863]' />
            </column>
            <column caption='Rating diff' datatype='real' name='[Calculation_866450387306696718]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_866450387295584257] - [Rating (copy)_866450387305091080]' />
            </column>
            <column caption='Vendor Late diff' datatype='real' name='[Calculation_866450387306889231]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_866450387297308674] - [Vendor Late 5 min (copy)_866450387305373705])*100' />
            </column>
            <column caption='Rejection Rate diff' datatype='real' name='[Calculation_866450387317297168]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_866450387297574915] - [Rejection Rate (copy)_866450387305615370])*100' />
            </column>
            <column caption='Offline Rate diff' datatype='real' name='[Calculation_866450387317886993]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_866450387298422788] - [Offline Rate (copy)_866450387305914379])*100' />
            </column>
            <column caption='AVTC diff' datatype='real' name='[Calculation_866450387318083602]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_866450387298783237] - [AVTC (copy)_866450387306164236]' />
            </column>
            <column caption='Prep Time Score' datatype='integer' name='[Calculation_866450387318276115]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_866450387306553357] &lt; 0 THEN 4&#10;ELSEIF [Calculation_866450387306553357] = 0 THEN 3&#10;ELSEIF [Calculation_866450387306553357] &gt; 0 THEN 2&#10;END' />
            </column>
            <column caption='OPS Score' datatype='real' name='[Calculation_866450387320520729]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IFNULL([Calculation_866450387318276115],0) + IFNULL([Prep Time Score (copy)_866450387318902804],0) + IFNULL([Rating Score (copy)_866450387319238677],0) +&#10; IFNULL([Vendor Late Score (copy)_866450387319443478],0) + IFNULL([Vendor Late Score (copy)_866450387319775255],0) + IFNULL([Vendor Late Score (copy)_866450387320238104],0))&#10;/&#10;( (IF IFNULL([Calculation_866450387318276115],0)!=0 THEN 1 ELSE 0 END) +&#10;  (IF IFNULL([Prep Time Score (copy)_866450387318902804],0)!=0 THEN 1 ELSE 0 END) +&#10;  (IF IFNULL([Rating Score (copy)_866450387319238677],0)!=0 THEN 1 ELSE 0 END) +&#10;  (IF IFNULL([Vendor Late Score (copy)_866450387319443478],0)!=0 THEN 1 ELSE 0 END) +&#10;  (IF IFNULL([Vendor Late Score (copy)_866450387319775255],0)!=0 THEN 1 ELSE 0 END) +&#10;  (IF IFNULL([Vendor Late Score (copy)_866450387320238104],0)!=0 THEN 1 ELSE 0 END) &#10;)' />
            </column>
            <column caption='Offline Rate B&amp;M' datatype='real' name='[Offline Rate (copy)_866450387305914379]' role='measure' type='quantitative'>
