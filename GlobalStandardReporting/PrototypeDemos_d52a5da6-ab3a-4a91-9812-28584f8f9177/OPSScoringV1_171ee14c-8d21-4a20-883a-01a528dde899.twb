      <column caption='AVTC B&amp;M' datatype='real' name='[AVTC (copy)_866450387306164236]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([bm_at_vendor_time_min_sum])/SUM([bm_at_vendor_time_min_count])' />
      </column>
      <column caption='Orders diff up' datatype='string' name='[Acquisitions diff up (copy)_2791950341166018564]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_300615292202123264] &gt; 0 then &quot;▲&quot;&#10;end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Brand name   ' datatype='string' name='[Brand name   (copy)_1204290706378526759]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[brand_name]' />
      </column>
      <column caption='Brands_period_before' datatype='integer' name='[CPC CVR period before (copy)_1474506719718203430]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(ZN([Calculation_1474506719717449761]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Vendors period before' datatype='integer' name='[CPC CVR period before (copy)_1474506719718690855]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(ZN(COUNTD([Calculation_2791950341196853253])), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Score color' datatype='string' name='[Calculation_1184376373536325633]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_866450387320520729] &gt; 3 THEN &apos;green&apos;&#10;ELSEIF [Calculation_866450387320520729] = 3 THEN &apos;yellow&apos;&#10;ELSE &apos;red&apos;&#10;END' />
      </column>
      <column caption='Vendors Count' datatype='integer' name='[Calculation_1184376373545791491]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([vendor_id])' />
      </column>
      <column caption='Vendors with B&amp;M Count' datatype='integer' name='[Calculation_1184376373546057732]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF IFNULL([bm_prep_time_tb_count],0)!= 0 OR IFNULL([bm_rating_count],0)!= 0 OR IFNULL([bm_vendor_late_5_min_count],0)!= 0 &#10;OR IFNULL([bm_failed_orders_vendor],0)!=0 OR IFNULL([bm_schedule_minutes],0) != 0 OR IFNULL([bm_at_vendor_time_min_count],0) != 0&#10;THEN vendor_id END)' />
      </column>
      <column caption='B&amp;M Rate' datatype='real' name='[Calculation_1184376373547847685]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1184376373546057732]/[Calculation_1184376373545791491]' />
      </column>
      <column caption='table index' datatype='boolean' name='[Calculation_1235675194530279425]' role='measure' type='nominal'>
        <calculation class='tableau' formula='INDEX() &lt;= 3'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Brands Count' datatype='integer' name='[Calculation_1474506719717449761]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([brand_name (copy)_6105192256984604675])' />
      </column>
      <column caption='User_entitlement' datatype='boolean' name='[Calculation_2095088658948644864]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Churn URL' datatype='string' name='[Calculation_2190719798290661376]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;https://tableau.deliveryhero.net/#/site/GlobalStandardReporting/views/KitchenStallChurn/StallChurn&quot;' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_2201556533219696650]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] =  USERNAME()' />
      </column>
      <column caption='Unique vendor' datatype='string' name='[Calculation_2791950341196853253]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[vendor_id]+[global_entity_id]' />
      </column>
      <column caption='Orders Diff %' datatype='real' name='[Calculation_300615292202123264]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([successful_orders])) - LOOKUP(ZN(SUM([successful_orders])), -1)) / ABS(LOOKUP(ZN(SUM([successful_orders])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column aggregation='Sum' caption='Days in current month' datatype='real' datatype-customized='true' name='[Calculation_4704080227387314178]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='FLOAT(DAY(DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, DATEADD(&apos;day&apos;, -1, TODAY()))))))' />
      </column>
      <column caption='Successful Orders period before' datatype='real' name='[Calculation_496592245834625025]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(ZN(SUM([successful_orders])), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Orders diff down' datatype='string' name='[Calculation_496592245834891266]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_300615292202123264] &lt; 0 then &quot;▼&quot;&#10;end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Orders diff' datatype='real' name='[Calculation_496592245836812292]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([successful_orders])) - LOOKUP(ZN(SUM([successful_orders])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='placeholder' datatype='integer' name='[Calculation_81346321119756297]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='min(0)' />
      </column>
      <column caption='Order Penetration Trends' datatype='string' name='[Calculation_81346321119981578]' role='dimension' type='nominal'>
