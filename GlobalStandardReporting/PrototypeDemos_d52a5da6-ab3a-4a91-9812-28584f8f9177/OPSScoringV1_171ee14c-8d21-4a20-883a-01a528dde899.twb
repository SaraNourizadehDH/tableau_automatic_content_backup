            <column caption='Vendors Count' datatype='integer' name='[Calculation_1184376373545791491]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([vendor_id])' />
            </column>
            <column caption='Vendors with B&amp;M Count' datatype='integer' name='[Calculation_1184376373546057732]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF IFNULL([bm_prep_time_tb_count],0)!= 0 OR IFNULL([bm_rating_count],0)!= 0 OR IFNULL([bm_vendor_late_5_min_count],0)!= 0 &#10;OR IFNULL([bm_failed_orders_vendor],0)!=0 OR IFNULL([bm_schedule_minutes],0) != 0 OR IFNULL([bm_at_vendor_time_min_count],0) != 0&#10;THEN vendor_id END)' />
            </column>
            <column caption='Prep time' datatype='real' name='[Calculation_866450387295170560]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([prep_time_tb_sum])/SUM([prep_time_tb_count])' />
            </column>
            <column caption='Rating' datatype='real' name='[Calculation_866450387295584257]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([converted_rating_sum])*5/SUM([rating_count])' />
            </column>
            <column caption='Vendor Late 5 min' datatype='real' name='[Calculation_866450387297308674]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_5_min_count])/SUM([successful_orders])' />
            </column>
            <column caption='Rejection Rate' datatype='real' name='[Calculation_866450387297574915]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_orders_vendor])/SUM([successful_orders])' />
            </column>
            <column caption='Offline Rate' datatype='real' name='[Calculation_866450387298422788]' role='measure' type='quantitative'>
