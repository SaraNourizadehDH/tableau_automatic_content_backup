        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1lmcz7z0yt1ret0zin68f1webz2d' name='Custom SQL Query' type='text'>SELECT 
creation_time,
destination_table.table_id,
query,
total_slot_ms/(1000*60*60*24) AS total_slot_days,
ROUND((total_slot_ms/(1000*60)) / 60 * (0.024 * 0.78), 4) AS compute_cost_usd_including_child_steps -- BQ pricing thru Jun 2024, including --enterprise discount
FROM `dhub-gfs.region-US.INFORMATION_SCHEMA.JOBS_BY_PROJECT`
WHERE user_email LIKE &apos;%gfs%&apos;
  AND DATE(creation_time) &gt;&gt;= DATE_SUB(DATE_TRUNC(current_date, MONTH), INTERVAL 3 MONTH)</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
