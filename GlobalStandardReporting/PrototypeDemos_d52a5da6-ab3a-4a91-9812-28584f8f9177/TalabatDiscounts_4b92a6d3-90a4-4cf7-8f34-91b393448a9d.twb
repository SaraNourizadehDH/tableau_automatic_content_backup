  <worksheets>
    <worksheet name='Discounts table'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Campaign discount table</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_kitchen_growth_report' name='federated.0tvk7t70ah311s1df95em1n2atmx' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='KPI Selected' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Discount orders&quot;'>
              <calculation class='tableau' formula='&quot;Discount orders&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0tvk7t70ah311s1df95em1n2atmx'>
            <column caption='Brand name   ' datatype='string' name='[Brand name   (copy)_1204290706378526759]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[brand_name]' />
            </column>
            <column caption='report_date_filter' datatype='boolean' name='[Calculation_2201556533220913163]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date] &lt; TODAY()' />
            </column>
            <column caption='KPI' datatype='real' name='[Calculation_5235645712591093764]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;Discount orders&apos; THEN SUM([discount_orders])&#10;ELSEIF [Parameters].[Parameter 2] = &apos;GMV local discounts&apos; THEN SUM([gmv_local_discounts])&#10;ELSEIF [Parameters].[Parameter 2] = &apos;GMV euro discounts&apos; THEN SUM([gmv_eur_discounts])&#10;ELSEIF [Parameters].[Parameter 2] = &apos;ROI&apos; THEN SUM([gmv_local_discounts])/SUM([incentive_amount_lc])&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Incentive amount lc&apos; THEN SUM([incentive_amount_lc])&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Incentive amount eur&apos; THEN SUM([incentive_amount_eur])&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Vendor incentive amount eur&apos; THEN SUM([vendor_incentive_amount_eur])&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Vendor incentive amount lc&apos; THEN SUM([vendor_incentive_amount_lc])&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Platform incentive amount eur&apos; THEN SUM([platform_incentive_amount_eur])&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Platform incentive amount lc&apos; THEN SUM([platform_incentive_amount_lc])&#10;END' />
            </column>
            <column caption='Vendor name w/id' datatype='string' name='[Calculation_614811771051663362]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[vendor_name] + [vendor_id]' />
            </column>
            <column caption='Partner name    ' datatype='string' name='[Partner name   (copy)_1204290706378510374]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[partner_name]' />
            </column>
            <column caption='brand' datatype='string' name='[brand_name]' role='dimension' type='nominal' />
            <column caption='campaign end date' datatype='date' datatype-customized='true' name='[campaign_end_date (copy)_5235645712584073218]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE([campaign_end_date])' />
