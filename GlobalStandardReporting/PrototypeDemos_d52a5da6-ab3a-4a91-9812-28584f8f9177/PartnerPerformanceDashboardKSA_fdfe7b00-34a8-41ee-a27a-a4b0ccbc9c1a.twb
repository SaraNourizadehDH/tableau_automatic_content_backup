              <calculation class='tableau' formula='(ZN(SUM([cpc_gmv_local])) - LOOKUP(ZN(SUM([cpc_gmv_local])), -1)) / ABS(LOOKUP(ZN(SUM([cpc_gmv_local])), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
