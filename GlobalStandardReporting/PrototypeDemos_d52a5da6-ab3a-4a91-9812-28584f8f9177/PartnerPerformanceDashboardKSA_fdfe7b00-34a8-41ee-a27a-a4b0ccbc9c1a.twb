      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_partner_monthly_report_ksa' name='federated.0tvk7t70ah311s1df95em1n2atmx' />
          </datasources>
          <datasource-dependencies datasource='federated.0tvk7t70ah311s1df95em1n2atmx'>
            <column caption='Last 2 months' datatype='boolean' name='[Calculation_1943373632986230786]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&quot;month&quot;, [report_month], TODAY())= 1 or DATEDIFF(&quot;month&quot;, [report_month], TODAY())= 2' />
            </column>
            <column caption='Delivery Time' datatype='real' name='[Calculation_2749799441609121811]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_time_sum])/SUM([delivery_time_count])' />
            </column>
            <column caption='Diff delivery time color down' datatype='string' name='[Diff orders color down (copy)_493566398059454465]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Orders Diff (copy)_493566398059200512] &lt; 0 then &quot;▼&quot;&#10;end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Diff delivery time color up' datatype='string' name='[Diff orders color up (copy)_493566398059479042]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Orders Diff (copy)_493566398059200512] &gt; 0 then &quot;▲&quot;&#10;end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Delivery time Diff' datatype='real' name='[Orders Diff (copy)_493566398059200512]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='(ZN([Calculation_2749799441609121811]) - LOOKUP(ZN([Calculation_2749799441609121811]), -1)) / ABS(LOOKUP(ZN([Calculation_2749799441609121811]), -1))'>
