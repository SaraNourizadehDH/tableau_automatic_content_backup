              <calculation class='tableau' formula='DATEDIFF(&quot;month&quot;, [report_month], TODAY())= 1 or DATEDIFF(&quot;month&quot;, [report_month], TODAY())= 2' />
            </column>
            <column caption='Diff CPC Rev color up' datatype='string' name='[Diff AOV color up (copy)_2749799441565822985]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Orders Diff (copy)_2749799441560268808] &gt; 0 then &quot;▲&quot;&#10;end'>
                <table-calc ordering-type='Rows' />
