      <column caption='Last Month vs Previous Month' datatype='boolean' name='[Calculation_1859494102797631497]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_332773809124851713] OR [Last complete month (copy)_332773809127383044] then true else false end' />
      </column>
      <column caption='Hide Nulls' datatype='boolean' name='[Calculation_1859494102836051983]' role='measure' type='nominal'>
        <calculation class='tableau' formula='INDEX()!= 1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Orders Diff' datatype='real' name='[Calculation_1943373632985956353]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='(ZN(SUM([successful_orders])) - LOOKUP(ZN(SUM([successful_orders])), -1)) / ABS(LOOKUP(ZN(SUM([successful_orders])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Last 2 months' datatype='boolean' name='[Calculation_1943373632986230786]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&quot;month&quot;, [report_month], TODAY())= 1 or DATEDIFF(&quot;month&quot;, [report_month], TODAY())= 2' />
      </column>
      <column caption='Diff orders color up' datatype='string' name='[Calculation_1943373632989081603]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1943373632985956353] &gt; 0 then &quot;▲&quot;&#10;end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='GMV diff' datatype='real' name='[Calculation_1943373632990433284]' role='measure' type='quantitative'>
