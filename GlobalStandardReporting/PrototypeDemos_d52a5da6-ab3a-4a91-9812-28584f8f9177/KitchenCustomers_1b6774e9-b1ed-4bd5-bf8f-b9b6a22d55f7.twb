      </column>
      <column caption='Last month' datatype='boolean' name='[Calculation_1802213918798741505]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[order_month] =  DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;, TODAY()))' />
      </column>
      <column caption='Customers 10 min drive' datatype='integer' name='[Calculation_1802213918818615299]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [drive_time] = 10 THEN [kitchen_location_customers] END)' />
      </column>
      <column caption='Customers %, 10 min' datatype='real' name='[Calculation_1802213918820892677]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1802213918818615299]/AVG([Entity customers fix (copy)_6619376671468662791])' />
      </column>
      <column caption='Country Orders LM' datatype='real' name='[Calculation_5967621386701971456]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG({FIXED [kitchen_short_name], [drive_time] : &#10;IF DAY(TODAY())&lt;=3 THEN&#10;SUM(IF[order_month]= DATEADD(&apos;month&apos;,-2,DATEADD(&apos;month&apos;,0,DATETRUNC(&apos;month&apos;,TODAY()))) &#10;THEN [entity_orders] END)&#10;ELSE SUM(IF [order_month]= DATEADD(&apos;month&apos;,-1,DATEADD(&apos;month&apos;,0,DATETRUNC(&apos;month&apos;,TODAY()))) &#10;THEN [entity_orders] END)&#10;END&#10;})' />
      </column>
      <column caption='Frequency Kitchen' datatype='real' name='[Calculation_6098225751951781888]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(kitchen_orders)/AVG([total_kitchen_customers])' />
      </column>
      <column caption='Last Month' datatype='datetime' name='[Calculation_6137561903901552640]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEADD(&apos;month&apos;,-1,DATEADD(&apos;month&apos;,0,DATETRUNC(&apos;month&apos;,TODAY())))' />
      </column>
      <column caption='Country Pen Rate' datatype='real' name='[Calculation_6137561903905767427]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([total_kitchen_customers])/AVG([Calculation_6619376671466655749])' />
      </column>
      <column caption='Column Divider' datatype='integer' name='[Calculation_6137561903921893381]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='INT((INDEX()-1)%(3))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Row Divider' datatype='integer' name='[Calculation_6137561903922331654]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='INT((INDEX()-1)/3)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_6137561903966900231]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='USERNAME()=[username]' />
      </column>
      <column caption='Kitchen Location Orders LM' datatype='integer' name='[Calculation_6137561903972757513]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [order_month]= DATEADD(&apos;month&apos;,-1,DATEADD(&apos;month&apos;,0,DATETRUNC(&apos;month&apos;,TODAY()))) THEN [kitchen_location_orders] END)' />
      </column>
      <column caption='Kitchen Location Coverage' datatype='real' name='[Calculation_6137561903973453834]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([kitchen_location_customers])/SUM([location_customers])' />
      </column>
      <column caption='Platform Frequency' datatype='real' name='[Calculation_6619376671456882688]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([entity_orders])/AVG([entity_customers])' />
      </column>
      <column caption='Facility Frequency' datatype='real' name='[Calculation_6619376671460814852]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([kitchen_orders])/AVG([kitchen_customers])' />
      </column>
      <column caption='Entity customers fix' datatype='integer' name='[Calculation_6619376671466655749]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [global_entity_id], [official_kitchen_name], [drive_time], [order_month]: SUM([entity_customers])}' />
      </column>
      <column caption='caption date' datatype='datetime' name='[Calculation_810014668164292608]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF day(today())&lt;=3 THEN &#10;DATEADD(&apos;month&apos;,-2,DATEADD(&apos;month&apos;,0,DATETRUNC(&apos;month&apos;,TODAY()))) &#10;ELSE &#10;DATEADD(&apos;month&apos;,-1,DATEADD(&apos;month&apos;,0,DATETRUNC(&apos;month&apos;,TODAY()))) &#10;END' />
      </column>
      <column caption='Customers %, 15 min' datatype='real' name='[Customers %, 10 min (copy)_1802213918822006790]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Customers 10 min drive (copy)_1802213918819037188]/AVG([Entity customers fix (copy)_6619376671468662791])' />
      </column>
      <column caption='Customers 15 min drive' datatype='integer' name='[Customers 10 min drive (copy)_1802213918819037188]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [drive_time] = 15 THEN [kitchen_location_customers] END)' />
      </column>
      <column caption='Kitchen customers fix' datatype='integer' name='[Entity customers fix (copy)_6619376671468662791]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [global_entity_id], [official_kitchen_name], [drive_time], [order_month]: SUM([kitchen_customers])}' />
      </column>
