          <calculation column='[% of NC Requests Blocked (copy)_6972838903092318215]' formula='SUM([pos_registered_user_count])/&#10;SUM([registered_user_count])' />
          <calculation column='[0 Filter - customer_count_w_voucher (copy)_482659238236688391]' formula='[pos_no_voucher_customer_count] = 0&#10;OR ISNULL([pos_no_voucher_customer_count])' />
          <calculation column='[0 Filter - pos_no_voucher_customer_count (copy)_865887436583460865]' formula='[pos_no_voucher_customer_count_1d] = 0&#10;OR ISNULL([pos_no_voucher_customer_count_1d])' />
          <calculation column='[Accuracy (copy)_6972838903095762956]' formula='([True Positives (copy)_6972838903094775818] + [True Negatives (copy)_6972838903095300107])/&#10;([True Positives (copy)_6972838903094775818] + [True Negatives (copy)_6972838903095300107] + SUM([neg_customer_count_w_single_order]) + SUM([pos_no_voucher_customer_count]))' />
          <calculation column='[Calculation_1714112287551049752]' formula='[neg_customer_count_w_single_order] = 0&#10;OR ISNULL([neg_customer_count_w_single_order])' />
          <calculation column='[Calculation_1714112288579387417]' formula='[total_voucher_dh_eur_blocked] = 0&#10;OR ISNULL([total_voucher_dh_eur_blocked])' />
          <calculation column='[Calculation_1952029012998598657]' formula='[total_voucher_dh_eur_lost_by_churn] = 0&#10;OR ISNULL([total_voucher_dh_eur_lost_by_churn])' />
          <calculation column='[Calculation_1984468998769864704]' formula='SUM([neg_customer_count_w_single_order])/&#10;SUM([customer_count_w_voucher])' />
          <calculation column='[Calculation_1984468998770114561]' formula='SUM([customer_count_wo_voucher_with_single_order])/&#10;SUM([customer_count_wo_voucher])' />
          <calculation column='[Calculation_1984468998774755330]' formula='SUM([pos_no_voucher_customer_count])/&#10;SUM([pos_registered_user_count])' />
