        <calculations>
          <calculation column='[% FP (copy)_482659238234406918]' formula='SUM([pos_no_voucher_customer_count])/&#10;SUM([pos_registered_user_count])' />
          <calculation column='[% FP (copy)_6806205697780121600 1]' formula='SUM([contact_rate.customer_count_w_voucher_issue_1d])/&#10;SUM([contact_rate.customer_count_w_voucher_request])' />
          <calculation column='[% FP (copy)_6806205697780121600]' formula='SUM([false_neg_customer_count])/&#10;SUM([customer_count_w_voucher])' />
