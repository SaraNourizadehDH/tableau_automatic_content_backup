              <calculation class='tableau' formula='[neg_customer_count_w_single_order] = 0&#10;OR ISNULL([neg_customer_count_w_single_order])' />
            </column>
            <column aggregation='Year' caption='Date Aggregation' datatype='date' datatype-customized='true' default-type='ordinal' layered='true' name='[Calculation_2832623490723422209]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default'>
              <calculation class='tableau' formula='DATE(IF [Parameters].[Parameter 2] = &quot;Day&quot;&#10;THEN DATETRUNC(&apos;day&apos;,[date])&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Week&quot;&#10;THEN DATETRUNC(&apos;week&apos;,[date])&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Month&quot;&#10;THEN DATETRUNC(&apos;month&apos;,[date])&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Quarter&quot;&#10;THEN DATETRUNC(&apos;quarter&apos;,[date])&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Year&quot;&#10;THEN DATETRUNC(&apos;year&apos;,[date])&#10;END)' />
            </column>
            <column aggregation='User' caption='Precision' datatype='real' default-type='quantitative' layered='true' name='[Precision (copy)_6972838903096135693]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='[True Positives (copy)_6972838903094775818]/SUM([pos_registered_user_count])' />
            </column>
            <column aggregation='User' caption='Recall' datatype='real' default-type='quantitative' layered='true' name='[Recall (copy)_6972838903096229902]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='[True Positives (copy)_6972838903094775818]/([True Positives (copy)_6972838903094775818] + SUM([neg_customer_count_w_single_order]))' />
            </column>
            <column aggregation='User' caption='True Positives' datatype='integer' default-type='quantitative' layered='true' name='[True Positives (copy)_6972838903094775818]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
              <calculation class='tableau' formula='SUM([pos_registered_user_count]) - SUM([pos_no_voucher_customer_count])' />
            </column>
            <column aggregation='Year' caption='Date' datatype='date' default-type='ordinal' layered='true' name='[date]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default' />
