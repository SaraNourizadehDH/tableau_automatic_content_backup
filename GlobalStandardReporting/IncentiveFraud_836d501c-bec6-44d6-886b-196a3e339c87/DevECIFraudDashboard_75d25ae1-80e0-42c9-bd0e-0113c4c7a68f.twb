      <column caption='Date Agg' datatype='date' name='[Calculation_2832623490758795268]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(IF [Parameters].[Parameter 2] = &quot;Day&quot;&#10;THEN DATETRUNC(&apos;day&apos;,[date])&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Week&quot;&#10;THEN DATETRUNC(&apos;week&apos;,[date])&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Month&quot;&#10;THEN DATETRUNC(&apos;month&apos;,[date])&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Quarter&quot;&#10;THEN DATETRUNC(&apos;quarter&apos;,[date])&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Year&quot;&#10;THEN DATETRUNC(&apos;year&apos;,[date])&#10;END)' />
      </column>
      <column caption='Unprofitable Orders %' datatype='real' name='[Calculation_4639692819967430656]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [est_FLGP_Blocked] &lt;= 0 THEN [customer_id] END)/ COUNTD([customer_id])' />
      </column>
      <column caption='Negative FLGP Blocked' datatype='real' name='[Calculation_4639692819967893505]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [flgp_before_blocked] &lt;= 0 THEN [customer_id] END)/ COUNTD([customer_id])' />
      </column>
      <column caption='False Positive - 1 day' datatype='real' name='[Unprofitable Orders % (copy)_4639692819968155651]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [orders_wo_incentives_after_block_1d] &gt; 0 THEN [customer_id] END)/ COUNTD([customer_id])' />
      </column>
