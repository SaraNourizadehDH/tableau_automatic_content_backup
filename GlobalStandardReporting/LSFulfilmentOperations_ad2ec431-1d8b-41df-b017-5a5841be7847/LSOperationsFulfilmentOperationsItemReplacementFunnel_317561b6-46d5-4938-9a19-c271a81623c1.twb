    <worksheet name='Timeline per KPI Entity'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='12'>Entity level</run>
            <run>Æ&#10;&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='ls_ops_ir_rl' name='federated.1ex1aqh01b3tvm1enjguy0hjrfl2' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Monthly' caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
              <aliases>
                <alias key='&quot;Day&quot;' value='Daily' />
                <alias key='&quot;Month&quot;' value='Monthly' />
                <alias key='&quot;Quarter&quot;' value='Quarterly' />
                <alias key='&quot;Week&quot;' value='Weekly' />
              </aliases>
            </column>
            <column alias='% Replaced from sent' caption='Order Timeline metric' datatype='string' name='[Select Metrics(PELICAN ORDERS) (copy)_230387323708497932]' param-domain-type='list' role='measure' type='nominal' value='&quot;4&quot;'>
              <calculation class='tableau' formula='&quot;4&quot;' />
              <aliases>
                <alias key='&quot;1&quot;' value='% Picker Compliance Rate' />
                <alias key='&quot;10&quot;' value='% CVR4 - Confirmed to replaced' />
                <alias key='&quot;11&quot;' value='% Confirmation rate' />
                <alias key='&quot;12&quot;' value='% Rejection rate' />
                <alias key='&quot;13&quot;' value='% Expiration rate' />
                <alias key='&quot;14&quot;' value='% Orders eligible from total ordered' />
                <alias key='&quot;15&quot;' value='% Add Products from eligible' />
                <alias key='&quot;17&quot;' value='% Replaced+Added products from eligible' />
                <alias key='&quot;2&quot;' value='% Replaced from eligible' />
                <alias key='&quot;4&quot;' value='% Replaced from sent' />
                <alias key='&quot;5&quot;' value='% CVR1 - Eligible to initiated replacement' />
                <alias key='&quot;6&quot;' value='% CVR2 - Initiated replacement to sent' />
                <alias key='&quot;9&quot;' value='% CVR3 - Sent to Confirmed' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ex1aqh01b3tvm1enjguy0hjrfl2'>
            <column caption='% Rejection Rate backend only' datatype='real' default-format='p0.0%' name='[% Confirmation Rate backend only (copy) (copy)_763852778179452931]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos; THEN [rejected_answer_backend_eligible_for_replacement] END) &#10;/&#10;SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos; THEN replacement_sent_eligible_for_replacement_v2 END)' />
            </column>
            <column caption='% Expiration Rate backend only' datatype='real' default-format='p0.0%' name='[% Confirmation Rate backend only (copy)_763852778179440642]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos; THEN [expired_answer_backend_eligible_for_replacement] END) &#10;/&#10;SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos; THEN replacement_sent_eligible_for_replacement_v2 END)' />
            </column>
            <column caption='% Replaced+Add Products from eligible orders' datatype='real' default-format='p0.0%' name='[% Replaced from eligible (copy)_3726236131322966024]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//sum([Pelican Replacements Orders]) / sum([partial_orders_old] + [Failed Due To Oos])&#10;&#10;//New definition&#10;sum(elg_pelican_replacement_orders_plus_added) / SUM([Calculation_263108790750830597])&#10;//[Eligible orders for replacement Old]' />
            </column>
            <column caption='% Orders Eligible from total ordered' datatype='real' default-format='p0.0%' name='[CVR1 - Eligible to initiated replacement (copy)_273030743614816256]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_263108790750830597])/SUM([pelican_confirmed_orders])' />
            </column>
            <column caption='CVR1 - Eligible to initiated replacement' datatype='real' default-format='p0.0%' name='[CVR1 - Not found to started (copy)_230387323695685636]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN(SUM([replacement_suggested_eligible_for_replacement])/SUM([Calculation_263108790750830597]),1)' />
            </column>
            <column caption='CVR2 - Initiated replacement to sent' datatype='real' default-format='p0.0%' name='[CVR2 - Started to suggested (copy)_230387323696893959]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([replacement_sent_eligible_for_replacement_v2])/SUM([replacement_suggested_eligible_for_replacement])' />
            </column>
            <column caption='CVR3 - Sent to Confirmed' datatype='real' default-format='p0.0%' name='[CVR3 - Sent to Confirmed (copy)_763852778203865092]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//SUM([replacement_confirmed_eligible_for_replacement_v2])/SUM([replacement_sent_eligible_for_replacement_v2])&#10;SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos; THEN confirmed_answer_backend_eligible_for_replacement END) &#10;/&#10;SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos; THEN [replacement_sent_eligible_for_replacement_v2] END)' />
            </column>
            <column caption='CVR4 - Confirmed to replaced' datatype='real' default-format='p0.0%' name='[CVR4 - Answered to replaced (copy)_253960857604853761]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos;  THEN ([replacement_done_eligible_for_replacement_v2]) END)&#10;/&#10;SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos; THEN ([replacement_confirmed_eligible_for_replacement_v2]) END)&#10;//Considers 100% max once might have miss-attribuition in flow' />
            </column>
            <column caption='Refresh rule' datatype='boolean' name='[Calculation_1038783420879003652]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[local_date] &lt;= {MAX([local_date])} - 2' />
            </column>
            <column caption='Picker Compliance' datatype='real' default-format='p0.0%' name='[Calculation_1207668441211351042]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([replacement_sent_eligible_for_replacement_v2])&#10;/SUM([Calculation_263108790750830597])' />
            </column>
            <column caption='concat_entity_country' datatype='string' name='[Calculation_167477668842803202]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;(&quot;+[management_entity]+&quot;) &quot; + [country]' />
            </column>
            <column caption='% Replaced from sent' datatype='real' default-format='p0.0%' name='[Calculation_230387323702554635]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;    [replacement_done_eligible_for_replacement_v2]&#10;) / &#10;SUM(&#10;   [replacement_sent_eligible_for_replacement_v2]&#10;)' />
            </column>
            <column caption='Eligible orders for replacement new' datatype='integer' name='[Calculation_263108790750830597]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[orders_eligible_for_replacement]' />
            </column>
            <column caption='% Replaced from eligible' datatype='real' default-format='p0.0%' name='[Calculation_3212755418220572672]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//sum([Pelican Replacements Orders]) / sum([partial_orders_old] + [Failed Due To Oos])&#10;&#10;//New definition&#10;sum([elg_pelican_replacement_orders]) / SUM([Calculation_263108790750830597])&#10;//[Eligible orders for replacement Old]' />
            </column>
            <column caption='Dynamic Date' datatype='date' name='[Calculation_3571213798266298371]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 1] &#10;WHEN &apos;Day&apos; THEN DATETRUNC(&apos;day&apos;, [local_date],&apos;Monday&apos;) &#10;WHEN &apos;Week&apos; THEN DATETRUNC(&apos;week&apos;, [local_date],&apos;Monday&apos;)&#10;WHEN &apos;Month&apos; THEN DATETRUNC(&apos;month&apos;, [local_date],&apos;Monday&apos;)  &#10;WHEN &apos;Quarter&apos; THEN DATETRUNC(&apos;quarter&apos;, [local_date],&apos;Monday&apos;) &#10;END)' />
            </column>
            <column caption='pelican_replacement_l30_flag_cf' datatype='string' name='[Calculation_4113123466683564033]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [pelican_replacement_l30_flag] &gt; 0 then &apos;Yes&apos; else &apos;No&apos; end' />
            </column>
            <column caption='Replacement Flow Gir1&amp;2' datatype='string' name='[Calculation_5697757283087187968]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//IF replacement_flow_gir_ph1_flag &gt; 0 then &apos;GIR-Phase1&apos; &#10;//ELSEIF replacement_flow_talabat_inapp_flag &gt; 0 then &apos;Talabat-inapp&apos; &#10;//ELSEIF replacement_flow_new_product_added_flag &gt; 0 then &apos;New-Product-Added&apos; &#10;//ELSEIF replacement_flow_custom_flow_replaced_flag &gt; 0 then &apos;Custom-Flow&apos; &#10;//ELSEIF replacement_flow_gir_ph2_flag &gt; 0 then &apos;GIR-Phase2&apos;&#10;//ELSE &apos;Others&apos;&#10;//END&#10;&#10;//If [Replacement Flow All] = &apos;GIR-Phase1&apos; then &apos;GIR-Phase1&apos;&#10;//ELSEIF [Replacement Flow All] = &apos;GIR-Phase2&apos; then &apos;GIR-Phase2&apos;&#10;//END&#10;&#10;If be_customer_sent&gt;0 then &apos;GIR-Phase2&apos;&#10;ELSEIf [Replacement Flow Gir1&amp;2 (copy)_6601854909039779842] = &apos;GIR-Phase1&apos; then &apos;GIR-Phase1&apos;&#10;END' />
            </column>
            <column caption='% Confirmation Rate backend only' datatype='real' default-format='p0.0%' name='[Calculation_763852778178813953]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//SUM([replacement_confirmed_eligible_for_replacement_v2])/SUM([replacement_sent_eligible_for_replacement_v2])&#10;SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos; THEN confirmed_answer_backend_eligible_for_replacement END) &#10;/&#10;SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos; THEN replacement_sent_eligible_for_replacement_v2 END)' />
            </column>
            <column caption='Timeline metric selection' datatype='real' default-format='p0.0%' name='[Dynamic metric selection (copy)_230387323708977165]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='If [Parameters].[Select Metrics(PELICAN ORDERS) (copy)_230387323708497932] = &apos;1&apos; then [Calculation_1207668441211351042]&#10;ELSEIF [Parameters].[Select Metrics(PELICAN ORDERS) (copy)_230387323708497932] = &apos;2&apos; then [Calculation_3212755418220572672]&#10;ELSEIF [Parameters].[Select Metrics(PELICAN ORDERS) (copy)_230387323708497932] = &apos;3&apos; then [Calculation_763852778178813953]&#10;ELSEIF [Parameters].[Select Metrics(PELICAN ORDERS) (copy)_230387323708497932] = &apos;4&apos; then [Calculation_230387323702554635]&#10;ELSEIF [Parameters].[Select Metrics(PELICAN ORDERS) (copy)_230387323708497932] = &apos;5&apos; then [CVR1 - Not found to started (copy)_230387323695685636]&#10;ELSEIF [Parameters].[Select Metrics(PELICAN ORDERS) (copy)_230387323708497932] = &apos;6&apos; then [CVR2 - Started to suggested (copy)_230387323696893959]&#10;//ELSEIF [Timeline metric] = &apos;7&apos; then [CVR3 - Sent to Answered]&#10;//ELSEIF [Timeline metric] = &apos;8&apos; then [CVR4 - Answered to replaced]&#10;ELSEIF [Parameters].[Select Metrics(PELICAN ORDERS) (copy)_230387323708497932] = &apos;9&apos; then [CVR3 - Sent to Confirmed (copy)_763852778203865092]&#10;ELSEIF [Parameters].[Select Metrics(PELICAN ORDERS) (copy)_230387323708497932] = &apos;10&apos; then [CVR4 - Answered to replaced (copy)_253960857604853761]&#10;ELSEIF [Parameters].[Select Metrics(PELICAN ORDERS) (copy)_230387323708497932] = &apos;11&apos; then [Calculation_763852778178813953]&#10;ELSEIF [Parameters].[Select Metrics(PELICAN ORDERS) (copy)_230387323708497932] = &apos;12&apos; then [% Confirmation Rate backend only (copy) (copy)_763852778179452931]&#10;ELSEIF [Parameters].[Select Metrics(PELICAN ORDERS) (copy)_230387323708497932] = &apos;13&apos; then [% Confirmation Rate backend only (copy)_763852778179440642]&#10;ELSEIF [Parameters].[Select Metrics(PELICAN ORDERS) (copy)_230387323708497932] = &apos;14&apos; THEN [CVR1 - Eligible to initiated replacement (copy)_273030743614816256]// in order level this code is 16&#10;ELSEIF [Parameters].[Select Metrics(PELICAN ORDERS) (copy)_230387323708497932] = &apos;15&apos; THEN [Item % Add Products from eligible (copy)_273030743618002946]&#10;// Confirmed not selected would be 16, doesn&apos;t make sense in order level&#10;ELSEIF [Parameters].[Select Metrics(PELICAN ORDERS) (copy)_230387323708497932] = &apos;17&apos; THEN [% Replaced from eligible (copy)_3726236131322966024]&#10;END' />
            </column>
            <column caption='Order % Add Products from eligible' datatype='real' default-format='p0.0%' name='[Item % Add Products from eligible (copy)_273030743618002946]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//sum([Pelican Replacements Orders]) / sum([partial_orders_old] + [Failed Due To Oos])&#10;&#10;//New definition&#10;sum([replacement_flow_new_product_added_flag]) / SUM([orders_eligible_for_replacement])&#10;//[Eligible orders for replacement Old]' />
            </column>
            <column caption='Replacement Flow All' datatype='string' name='[Replacement Flow Gir1&amp;2 (copy)_6601854909039779842]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF replacement_flow_gir_ph1_flag &gt; 0 then &apos;GIR-Phase1&apos;&#10;ELSEIF replacement_flow_gir_ph2_flag &gt; 0 then &apos;GIR-Phase2&apos;&#10;//ELSEIF replacement_flow_talabat_inapp_flag &gt; 0 then &apos;Talabat-inapp&apos;&#10;ELSEIF replacement_flow_talabat_inapp_flag &gt; 0 then &apos;GIR-Phase2&apos;&#10;ELSEIF replacement_flow_new_product_added_flag &gt; 0 then &apos;New-Product-Added&apos;&#10;//ELSEIF replacement_flow_custom_flow_replaced_flag &gt; 0 then &apos;Custom-Flow&apos; DEPRECATED&#10;ELSE &apos;Others&apos;&#10;END' />
            </column>
            <column datatype='string' name='[Vendor_App]' role='dimension' type='nominal' />
            <column-instance column='[management_entity]' derivation='Attribute' name='[attr:management_entity:nk]' pivot='key' type='nominal' />
            <column datatype='real' name='[be_customer_sent]' role='measure' type='quantitative' />
            <column caption='Chain Name' datatype='string' name='[chain_name]' role='dimension' type='nominal' />
            <column caption='City' datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column datatype='integer' name='[confirmed_answer_backend_eligible_for_replacement]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='integer' name='[elg_pelican_replacement_orders]' role='measure' type='quantitative' />
            <column datatype='integer' name='[elg_pelican_replacement_orders_plus_added]' role='measure' type='quantitative' />
            <column datatype='integer' name='[expired_answer_backend_eligible_for_replacement]' role='measure' type='quantitative' />
            <column datatype='boolean' name='[is_aaa_supermarket]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[is_aaa_vendor]' role='dimension' type='nominal' />
            <column caption='Local Date' datatype='date' name='[local_date]' role='dimension' type='ordinal' />
