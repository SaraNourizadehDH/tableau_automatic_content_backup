    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Item level - CVR and evolution'>
      <layout-options>
        <title>
          <formatted-text>
            <run>CVR entity view</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/LS-Operations-FulfilmentOperations-Itemreplacementfunnel/Itemlevel-CVRandevolution?rev=' id='Itemlevel-CVRandevolution' path='/t/GlobalStandardReporting/workbooks/LS-Operations-FulfilmentOperations-Itemreplacementfunnel' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='dash-text'>
          <format attr='text-align' id='dash-text_24' value='left' />
        </style-rule>
        <style-rule element='parameter-ctrl'>
          <format attr='background-color' value='#fefaf1' />
          <format attr='border-color' value='#000000' />
          <format attr='border-width' value='1' />
          <format attr='border-style' value='solid' />
        </style-rule>
      </style>
      <size maxheight='3200' maxwidth='1280' minheight='3200' minwidth='1280' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='ls_ops_ir_rl' name='federated.1ex1aqh01b3tvm1enjguy0hjrfl2' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column alias='Monthly' caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
          <calculation class='tableau' formula='&quot;Month&quot;' />
          <aliases>
            <alias key='&quot;Day&quot;' value='Daily' />
            <alias key='&quot;Month&quot;' value='Monthly' />
            <alias key='&quot;Quarter&quot;' value='Quarterly' />
            <alias key='&quot;Week&quot;' value='Weekly' />
          </aliases>
          <members>
            <member alias='Daily' value='&quot;Day&quot;' />
            <member alias='Weekly' value='&quot;Week&quot;' />
            <member alias='Monthly' value='&quot;Month&quot;' />
            <member alias='Quarterly' value='&quot;Quarter&quot;' />
          </members>
        </column>
        <column alias='% CVR1 - Eligible to initiated replacement' caption='Item Timeline metric' datatype='string' name='[Timeline metric (copy)_2010505394417131534]' param-domain-type='list' role='measure' type='nominal' value='&quot;5&quot;'>
          <calculation class='tableau' formula='&quot;5&quot;' />
          <aliases>
            <alias key='&quot;1&quot;' value='% Picker Compliance Rate' />
            <alias key='&quot;10&quot;' value='% CVR4 - Confirmed to replaced' />
            <alias key='&quot;11&quot;' value='% Confirmation rate' />
            <alias key='&quot;12&quot;' value='% Rejection rate' />
            <alias key='&quot;13&quot;' value='% Expiration rate' />
            <alias key='&quot;14&quot;' value='% Replaced+Add Products from eligible' />
            <alias key='&quot;15&quot;' value='% Add Products from eligible' />
            <alias key='&quot;16&quot;' value='% Items eligible from total ordered' />
            <alias key='&quot;17&quot;' value='% Partial rejection rate' />
            <alias key='&quot;18&quot;' value='€ GMV Replacements' />
            <alias key='&quot;19&quot;' value='% Replaced from Eligible (€ GMV)' />
            <alias key='&quot;2&quot;' value='% Replaced from eligible' />
            <alias key='&quot;20&quot;' value='€ GMV added directly' />
            <alias key='&quot;21&quot;' value='% GMV Replaced + Added directly from Eligible' />
            <alias key='&quot;4&quot;' value='% Replaced from sent' />
            <alias key='&quot;5&quot;' value='% CVR1 - Eligible to initiated replacement' />
            <alias key='&quot;6&quot;' value='% CVR2 - Initiated replacement to sent' />
            <alias key='&quot;9&quot;' value='% CVR3 - Sent to Confirmed' />
          </aliases>
          <members>
