  <dashboards>
    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='(WIP) MetricsDefinition'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/LS-Operations-FulfilmentOperations-Itemreplacementfunnel/MetricsDefinition?rev=' id='WIPMetricsDefinition' path='/t/GlobalStandardReporting/workbooks/LS-Operations-FulfilmentOperations-ItemReplacementFunnel' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='dash-text'>
          <format attr='text-align' id='dash-text_24' value='left' />
        </style-rule>
      </style>
      <size maxheight='2250' maxwidth='1100' minheight='2250' minwidth='1100' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='99288' id='7' param='horz' type-v2='layout-flow' w='98546' x='727' y='356'>
            <zone h='99288' id='5' type-v2='layout-basic' w='98546' x='727' y='356'>
              <zone forceUpdate='true' h='3777' id='47' type-v2='text' w='83273' x='16000' y='356'>
                <formatted-text>
                  <run bold='true' fontcolor='#e15759' fontsize='28'>Item Replacement Phase 1 Dashboard</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#c0c0c0' fontsize='15' italic='true'>Quick Commerce        </run>
                  <run bold='true' fontcolor='#e15759' fontsize='15'>| Metrics Definition | </run>
                  <run bold='true' fontcolor='#59a14f' fontsize='10' italic='true'> Refresh Frequency - Mon &amp; Thurs every week</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='2844' id='135' type-v2='text' w='98546' x='727' y='6667'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>OverallMetricsTrend:</run>
                  <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'> Understand the overall metric trends that are important for the experiment by comparing regions and countries </run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='dotted' />
                  <format attr='border-width' value='1' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='3067' id='136' type-v2='text' w='98546' x='727' y='9511'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>IRFunnel:</run>
                  <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'> Understand the item replacement funnel and their compliance rate by different dimensions </run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='dotted' />
                  <format attr='border-width' value='1' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='2534' id='137' type-v2='text' w='98546' x='727' y='4133'>
                <formatted-text>
                  <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='14'>Dashboard Tab Summary</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#913a3c' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='2755' id='138' type-v2='text' w='98546' x='727' y='12578'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>VendorDD:</run>
                  <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'> Deep dive on the important metrics for the vendors to understand the impact on the vendors and take actions</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='dotted' />
                  <format attr='border-width' value='1' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='2089' id='139' type-v2='text' w='98546' x='727' y='15333'>
                <formatted-text>
                  <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='15'> Metric Definition (OverallMetricsTrend)</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#9a3c40' />
                </zone-style>
              </zone>
              <zone h='1525' id='154' type-v2='empty' w='98546' x='727' y='98119'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='2400' id='197' type-v2='text' w='25909' x='727' y='17422'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='12'>(€)</run>
                  <run bold='true' fontcolor='#000000' fontsize='12'>OOS GMV Loss</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='1' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#f5f5f5' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='2400' id='198' type-v2='text' w='72637' x='26636' y='17422'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontname='Tableau Light'>Def:</run>
                  <run fontcolor='#000000' fontname='Tableau Light'>  The OOS GMV loss refers to the total Gross Merchandise Value (GMV) lost due to orders that are either partially fulfilled or unable to be fulfilled because the items are out of stock (OOS). </run>
                  <run>Æ&#10;</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='1' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#f5f5f5' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='2267' id='199' type-v2='text' w='25909' x='727' y='19822'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontsize='12'>(%)OOS fail rate</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='1' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='2267' id='200' type-v2='text' w='72637' x='26636' y='19822'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000'>Def:</run>
                  <run fontcolor='#000000'>Æ </run>
                  <run fontcolor='#000000' fontname='Tableau Light'>Percentage of orders that fail due to vendor Out of Stock (OOS) issues, calculated by dividing the total number of failed orders caused by vendor OOS by the total number of orders placed.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='1' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='2400' id='202' type-v2='text' w='72637' x='26636' y='36756'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontname='Tableau Light'>Def: </run>
                  <run fontcolor='#000000' fontname='Tableau Light'>The rate is calculated by dividing the number of pelican orders where picker send the suggestion to the customer from the total number of pelican orders eligible for replacement(Partial Fulfillment (PF) or failed due to Out of Stock (OOS) or replaced)</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='1' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#f5f5f5' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='2533' id='203' type-v2='text' w='25909' x='727' y='26889'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontsize='12'>Avg Order Items</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='1' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#f5f5f5' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='2533' id='204' type-v2='text' w='72637' x='26636' y='26889'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000'>Def: </run>
                  <run fontcolor='#000000' fontname='Tableau Light'>This metric is calculated by dividing the total number of items ordered by the total number of pelican orders made during a period.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='1' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#f5f5f5' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='2356' id='205' type-v2='text' w='25909' x='727' y='34400'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontsize='12'>(%)Orders triggered for IR</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='1' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='2356' id='206' type-v2='text' w='72637' x='26636' y='34400'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000'>Def:</run>
                  <run fontcolor='#000000'>Æ </run>
                  <run fontcolor='#000000' fontname='Benton Sans Book'>Æ </run>
                  <run fontcolor='#000000' fontname='Tableau Light'>The rate calculated by dividing the number of Pelican orders in which the picker clicked on &quot;Item is &apos;out of stock&apos;&quot; (indicating eligibility for replacement) by the total number of Pelican orders placed. </run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='1' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='2311' id='207' type-v2='text' w='25909' x='727' y='39156'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontsize='12'>(%)Orders w replacement started</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='1' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='2311' id='208' type-v2='text' w='72637' x='26636' y='39156'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000'>Def:</run>
                  <run fontcolor='#000000'>Æ </run>
                  <run fontcolor='#000000' fontname='Tableau Light'>The rate calculated by dividing the number of Pelican orders in which the picker clicks on &apos;Replace Items&apos; (indicating initiation for replacement) by the total number of Pelican orders placed.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='1' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='2355' id='209' type-v2='text' w='25909' x='727' y='41467'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontsize='12'>(%)Contact Rate</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='1' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#f5f5f5' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='2355' id='210' type-v2='text' w='72637' x='26636' y='41467'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000'>Def: </run>
                  <run fontcolor='#000000' fontname='Benton Sans Book'>T</run>
                  <run fontcolor='#000000' fontname='Tableau Light'>he rate calculated by dividing the number of Pelican orders that are contacted for reasons such as &apos;Out of Stock item(s)&apos;, &apos;Issue with item replacement process&apos;, &apos;Missing item&apos;, or &apos;Wrong item&apos; by the total number of Pelican orders placed.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='1' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#f5f5f5' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='2622' id='212' type-v2='text' w='72637' x='26636' y='31778'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontname='Tableau Light'>Def:</run>
                  <run fontcolor='#000000' fontname='Tableau Light'> The rate calculated by dividing the number of replaced pelican orders from the total number of orders that were Partial Fulfillment (PF) or failed due to Out of Stock (OOS) issues or replaced.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='1' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#f5f5f5' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='2933' id='237' type-v2='text' w='98546' x='727' y='48356'>
                <formatted-text>
                  <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='15'>Funnel Metrics Definition(IRFunnel)</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#9a3c40' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='2578' id='238' type-v2='text' w='26364' x='727' y='51289'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontsize='12'>Total Pelican Orders/Items</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
