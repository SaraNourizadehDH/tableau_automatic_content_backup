      <column caption='Avg Sold Items' datatype='real' name='[Avg Diff Ordered Items vs Sold Items (copy) (copy)_3580009909763985409]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [Vendor_App] = &apos;pelican&apos; then [qty_sold] else 0 END)/sum([total_pelican_orders])' />
      </column>
      <column caption='Avg Order Items' datatype='real' name='[Avg Diff Ordered Items vs Sold Items (copy)_3580009909763960832]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [Vendor_App] = &apos;pelican&apos; then [qty_ordered] else 0 end)/sum([total_pelican_orders])' />
      </column>
      <column caption='% Items Eligible from total ordered' datatype='real' default-format='p0.0%' name='[Avg Order Items (copy)_2578873743273709568]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([eligible_replacement_items])/sum(if [Vendor_App] = &apos;pelican&apos; then [qty_ordered] else 0 end)' />
      </column>
      <column caption='Item CVR1 - Eligible to initiated replacement' datatype='real' default-format='p0.0%' name='[CVR1 - Eligible to initiated replacement (copy)_2010505394403991552]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([be_replacement_suggestion_qty])/SUM([eligible_replacement_items])' />
      </column>
      <column caption='% Orders Eligible from total ordered' datatype='real' default-format='p0.0%' name='[CVR1 - Eligible to initiated replacement (copy)_273030743614816256]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_263108790750830597])/SUM([pelican_confirmed_orders])' />
      </column>
      <column caption='CVR1 - Eligible to initiated dropoff' datatype='real' default-format='p0.0%' name='[CVR1 - Eligible to initiated replacement (copy)_4792111541180260352]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-(1-(MIN(SUM([replacement_suggested_eligible_for_replacement])/SUM([Calculation_263108790750830597]),1)))' />
      </column>
      <column caption='CVR1 - Eligible to initiated replacement' datatype='real' default-format='p0.0%' name='[CVR1 - Not found to started (copy)_230387323695685636]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN(SUM([replacement_suggested_eligible_for_replacement])/SUM([Calculation_263108790750830597]),1)' />
      </column>
      <column caption='Item CVR2 - Initiated replacement to sent' datatype='real' default-format='p0.0%' name='[CVR2 - Initiated replacement to sent (copy)_2010505394404290561]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN(SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos; THEN [be_customer_sent] END)/&#10;SUM([be_replacement_suggestion_qty]),1)&#10;//Investigate why over 100% in some cases' />
      </column>
      <column caption='CVR2 - Initiated replacement to sent dropoff' datatype='real' default-format='p0.0%' name='[CVR2 - Initiated replacement to sent (copy)_4792111541180260353]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-(1-(SUM([replacement_sent_eligible_for_replacement_v2])/SUM([replacement_suggested_eligible_for_replacement])))' />
      </column>
      <column caption='CVR2 - Initiated replacement to sent' datatype='real' default-format='p0.0%' name='[CVR2 - Started to suggested (copy)_230387323696893959]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([replacement_sent_eligible_for_replacement_v2])/SUM([replacement_suggested_eligible_for_replacement])' />
      </column>
      <column caption='CVR3 - Sent to Confirmed (deprecated)' datatype='real' default-format='p0.0%' name='[CVR3 - Sent to Answered (copy)_253960857604853760]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([confirmed_answer_backend_eligible_for_replacement])/SUM([has_answer_backend_eligible_for_replacement])' />
      </column>
      <column caption='CVR3 - Sent to Confirmed' datatype='real' default-format='p0.0%' name='[CVR3 - Sent to Confirmed (copy)_763852778203865092]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//SUM([replacement_confirmed_eligible_for_replacement_v2])/SUM([replacement_sent_eligible_for_replacement_v2])&#10;SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos; THEN confirmed_answer_backend_eligible_for_replacement END) &#10;/&#10;SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos; THEN [replacement_sent_eligible_for_replacement_v2] END)' />
      </column>
      <column caption='Item CVR3 - Sent to Confirmed (plus talabat)' datatype='real' default-format='p0.0%' name='[CVR3 - Sent to Confirmed (plus talabat) (copy)_2010505394405126147]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUm([be_customer_confirmed])&#10;/SUM([be_customer_sent])' />
      </column>
      <column caption='CVR3 - Sent to Confirmed (plus talabat) dropoff' datatype='real' default-format='p0.0%' name='[CVR3 - Sent to Confirmed (plus talabat) (copy)_4792111541180260355]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-(1-([Confirmed BE + Talabat (copy)_2968012907857879040]&#10;/SUM([replacement_sent_eligible_for_replacement_v2])))' />
      </column>
      <column caption='CVR3 - Sent to Answered' datatype='real' default-format='p0.0%' name='[CVR3 - Suggested to Sent (copy)_230387323697344520]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_5697757283096076289])/SUM([replacement_sent_eligible_for_replacement_v2])' />
      </column>
      <column caption='CVR4 - Confirmed to replaced' datatype='real' default-format='p0.0%' name='[CVR4 - Answered to replaced (copy)_253960857604853761]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos;  THEN ([replacement_done_eligible_for_replacement_v2]) END)&#10;/&#10;SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos; THEN ([replacement_confirmed_eligible_for_replacement_v2]) END)&#10;//Considers 100% max once might have miss-attribuition in flow' />
      </column>
      <column caption='Item CVR4 - Confirmed to replaced' datatype='real' default-format='p0.0%' name='[CVR4 - Confirmed to replaced (copy)_2010505394405224452]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(replacements_pelican_items_v2)/SUM([be_customer_confirmed]) //Considers 100% max once might have miss-attribuition in flow' />
      </column>
      <column caption='CVR4 - Confirmed to replaced dropoff' datatype='real' default-format='p0.0%' name='[CVR4 - Confirmed to replaced (copy)_4792111541180260357]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Order #Replacement confirmed (copy)_2968012907858329602]/[Confirmed BE + Talabat (copy)_2968012907857879040] //Considers 100% max once might have miss-attribuition in flow' />
      </column>
      <column caption='CVR4 - Answered to replaced' datatype='real' default-format='p0.0%' name='[CVR4 - Sent to Answered (copy)_230387323697815561]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Order #Replacement confirmed (copy)_2968012907858329602]/SUM([Calculation_5697757283096076289])' />
      </column>
      <column caption='Refresh rule' datatype='boolean' name='[Calculation_1038783420879003652]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[local_date] &lt;= {MAX([local_date])} - 2' />
      </column>
      <column caption='Max date' datatype='string' name='[Calculation_1038783420881231878]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR({MAX(IF [Calculation_1038783420879003652] THEN [local_date] END)})' />
      </column>
      <column caption='Picker Compliance' datatype='real' default-format='p0.0%' name='[Calculation_1207668441211351042]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([replacement_sent_eligible_for_replacement_v2])&#10;/SUM([Calculation_263108790750830597])' />
      </column>
      <column caption='replacement_sent_cf' datatype='integer' name='[Calculation_1515883494825349120]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[replacement_sent_eligible_for_replacement_v2]&#10;&#10;//if [Management Entity] = &apos;Talabat&apos; then 0&#10;//else [replacement_sent] end' />
      </column>
      <column caption='% Total Level 1' datatype='real' default-format='p0%' name='[Calculation_1603281492334383104]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SIZE() &gt; 1 THEN&#10;[Calculation_4453919318659833858] + [% GIR-1 Total Items (copy)_4453919318660833283] +[% GIR-1 Total Items (copy)_4453919318663348233]&#10;ELSE TOTAL([Calculation_4453919318659833858] + [% GIR-1 Total Items (copy)_4453919318660833283] + [% GIR-1 Total Items (copy)_4453919318663348233])&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Calculation1' datatype='real' name='[Calculation_167477668810031104]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CONCAT(' />
      </column>
      <column caption='concat_chain_country' datatype='string' name='[Calculation_167477668810276865]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[chain_name]+&quot; (&quot;+[country]+&quot;)&quot;' />
      </column>
      <column caption='concat_entity_country' datatype='string' name='[Calculation_167477668842803202]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;(&quot;+[management_entity]+&quot;) &quot; + [country]' />
      </column>
      <column caption='PickerCallingRate exclude talabat' datatype='real' name='[Calculation_2068067064206565376]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [management_entity] = &apos;Talabat&apos; &#10;  THEN 0&#10;ELSE&#10;    [call_initiated]&#10;END) / &#10;SUM(IF [management_entity] = &apos;Talabat&apos; THEN&#10;  0 &#10;ELSE&#10;    [item_not_found]&#10;END)' />
      </column>
      <column caption='Complete week' datatype='boolean' name='[Calculation_225672615371251712]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;, [Calculation_3571213798266298371]) &lt; DATETRUNC(&apos;week&apos;, TODAY()-2)' />
      </column>
      <column caption='Local date str' datatype='string' name='[Calculation_225672615373815809]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([local_date])' />
      </column>
      <column caption='% Replaced from sent' datatype='real' default-format='p0.0%' name='[Calculation_230387323702554635]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    [replacement_done_eligible_for_replacement_v2]&#10;) / &#10;SUM(&#10;   [replacement_sent_eligible_for_replacement_v2]&#10;)' />
      </column>
      <column caption='Pelican Replacement L30 Flag Boolean' datatype='boolean' name='[Calculation_2459950625618546688]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [pelican_replacement_l30_flag] = 1 then TRUE else FALSE end' />
      </column>
      <column caption='$ GMV Replacements' datatype='real' default-format='c&quot;€&quot;#,##0;-&quot;€&quot;#,##0' name='[Calculation_2538833970026364928]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([replacements_pelican_total_price_eur])' />
      </column>
      <column caption='Eligible orders for replacement new' datatype='integer' name='[Calculation_263108790750830597]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[orders_eligible_for_replacement]' />
      </column>
      <column caption='% GIR 1 Replaced' datatype='real' default-format='p0.0%' name='[Calculation_263108790775095307]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[elg_pelican_replacement_orders_gir1&amp;2 (copy)_263108790774509577] / SUM([Calculation_263108790750830597])' />
      </column>
      <column caption='% Replaced from eligible' datatype='real' default-format='p0.0%' name='[Calculation_3212755418220572672]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//sum([Pelican Replacements Orders]) / sum([partial_orders_old] + [Failed Due To Oos])&#10;&#10;//New definition&#10;sum([elg_pelican_replacement_orders]) / SUM([Calculation_263108790750830597])&#10;//[Eligible orders for replacement Old]' />
      </column>
      <column caption='trunc_month' datatype='string' name='[Calculation_3541307062703697921]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(DATE(DATETRUNC(&apos;month&apos;, [Calculation_3571213798266298371])))' />
      </column>
      <column caption='MoM: Comparison' datatype='integer' default-format='p0.0%' name='[Calculation_3541307062709587970]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [MoM #Eligible Items for Replacement (copy)_5446048230367707136] &lt; [MoM: SUM Current Month (copy)_5446048230368362497] THEN -1&#10;ELSEIF  [MoM #Eligible Items for Replacement (copy)_5446048230367707136] &gt; [MoM: SUM Current Month (copy)_5446048230368362497] THEN 1&#10;ELSE 0&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Avg Diff Ordered Items vs Sold Items' datatype='real' name='[Calculation_3571213798262587392]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [Vendor_App] = &apos;pelican&apos; then [qty_ordered] else 0 end)/sum([total_pelican_orders]) - &#10;sum(if [Vendor_App] = &apos;pelican&apos; then [qty_sold] else 0 END)/sum([total_pelican_orders])' />
      </column>
      <column caption='(%)Orders triggered for IR' datatype='real' name='[Calculation_3571213798263255041]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([item_not_found]) / sum([pelican_confirmed_orders])' />
      </column>
      <column caption='Dynamic Date' datatype='date' name='[Calculation_3571213798266298371]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 1] &#10;WHEN &apos;Day&apos; THEN DATETRUNC(&apos;day&apos;, [local_date],&apos;Monday&apos;) &#10;WHEN &apos;Week&apos; THEN DATETRUNC(&apos;week&apos;, [local_date],&apos;Monday&apos;)&#10;WHEN &apos;Month&apos; THEN DATETRUNC(&apos;month&apos;, [local_date],&apos;Monday&apos;)  &#10;WHEN &apos;Quarter&apos; THEN DATETRUNC(&apos;quarter&apos;, [local_date],&apos;Monday&apos;) &#10;END)' />
      </column>
      <column caption='Dynamic metric selection' datatype='real' name='[Calculation_3571213798267330564]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='If [Parameters].[Parameter 2] = &apos;OOS vendor fail rate&apos; then 100*[Calculation_3571213798268973061]&#10;//ELSEIF [Select Metrics(PELICAN ORDERS)] = &apos;OOS GMV Loss&apos; then sum([Gmv_lost_due_to_OOS_pelican]) deprecated&#10;//ELSEIF [Select Metrics(PELICAN ORDERS)] = &apos;OOS Partial fulfillment rate with replacements&apos; then 100*[OOS Partial fulfillment rate with replacements]&#10;//ELSEIF [Select Metrics(PELICAN ORDERS)] = &apos;OOS Pelican Partial fulfillment rate&apos; then 100*[OOS Pelican Partial fulfillment rate]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Pelican Partial fulfillment rate&apos; then 100*[OOS Partial fulfillment rate (copy)_1707779084885458945]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Pelican Partial fulfillment rate old&apos; then 100*[OOS Pelican Partial fulfillment rate (copy)_5391653226446458884]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Avg Order Items&apos; then [Avg Diff Ordered Items vs Sold Items (copy)_3580009909763960832]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Avg Sent Items&apos; then [Avg Diff Ordered Items vs Sold Items (copy) (copy)_3580009909763985409]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;(%)orders triggered for IR&apos; then 100*[Calculation_3571213798263255041]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;(%)Orders w replacement started&apos; then 100*[%Eligible order for Replacement (copy)_3571213798264324098]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;%Pelican Contacted Order&apos; then 100*[Calculation_4034732718765412352]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;(%)Eligible orders replaced&apos; then 100*[Calculation_3212755418220572672]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;ABV&apos; then [Calculation_5391653226430795777]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;(%)Fill Rate&apos; then 100*[Calculation_5391653226436194307]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Picker Compliance Rate&apos; then 100*[Calculation_1207668441211351042]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;(%)Items Replaced from Eligible&apos; then 100*[Calculation_3743617255147995136]&#10;END' />
      </column>
      <column caption='OOS Vendor Fail rate pelican' datatype='real' name='[Calculation_3571213798268973061]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([oos_pelican_vendor_failed_orders])/sum([total_pelican_orders])' />
      </column>
      <column caption='OOS Partial fulfillment rate with replacements' datatype='real' name='[Calculation_3571213798269698054]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(pelican_partially_fulfilled_with_replacement)/sum([all_pelican_partially_fulfilled])' />
      </column>
      <column caption='Flag(Order Triggered for IR)' datatype='integer' name='[Calculation_3580009909802516482]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if sum([item_not_found]) &gt; 0 then 1 else 0 END' />
      </column>
      <column caption='Flag(replacement started)' datatype='integer' name='[Calculation_3580009909803073539]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if sum([replacement_started]) &gt; 0 then 1 else 0 end' />
      </column>
      <column caption='per_Items_Replaced_from_Eligible' datatype='real' name='[Calculation_3743617255147995136]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//sum(replacements_pelican_items_v2)/sum(eligible_replacement_items)&#10;&#10;//vendor_app = &apos;pelican&apos;&#10;&#10;SUM(IF [Vendor_App] = &apos;pelican&apos; then [replacements_pelican_items_v2] else 0 END)&#10;/ &#10;SUM(IF [Vendor_App] = &apos;pelican&apos; then [eligible_replacement_items] else 0 END)' />
      </column>
      <column caption='Metric Format' datatype='string' name='[Calculation_3960564077724725248]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Timeline metric (copy)_2010505394417131534] = &apos;18&apos; THEN &quot;€&quot;&#10;ELSE &quot;%&quot;&#10;END' />
      </column>
      <column caption='Metric Value' datatype='real' name='[Calculation_3960564077725003778]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Timeline metric (copy)_2010505394417131534]&#10;    WHEN &apos;1&apos; THEN [Picker Compliance (copy)_2010505394410926090]&#10;    WHEN &apos;2&apos; THEN [% Replaced from eligible (copy)_2010505394408988677]&#10;    WHEN &apos;3&apos; THEN [% Confirmation Rate backend only (copy)_2010505394411159563]&#10;    WHEN &apos;4&apos; THEN [% Replaced from sent (copy)_2010505394410823689]&#10;    WHEN &apos;5&apos; THEN [CVR1 - Eligible to initiated replacement (copy)_2010505394403991552]&#10;    WHEN &apos;6&apos; THEN [CVR2 - Initiated replacement to sent (copy)_2010505394404290561]&#10;    WHEN &apos;9&apos; THEN [CVR3 - Sent to Confirmed (plus talabat) (copy)_2010505394405126147]&#10;    WHEN &apos;10&apos; THEN [Item CVR4 - Confirmed to replaced (copy)_769200749606723585]&#10;    WHEN &apos;11&apos; THEN [% Confirmation Rate backend only (copy)_2010505394411159563]&#10;    WHEN &apos;12&apos; THEN [% Rejection Rate backend only (copy)_2010505394411270156]&#10;    WHEN &apos;13&apos; THEN [% Expiration Rate backend only (copy)_2010505394411638797]&#10;    WHEN &apos;14&apos; THEN [Item % Replaced from eligible (copy)_6507419991450529795]&#10;    WHEN &apos;15&apos; THEN [Item % Replaced from eligible +Add Products (copy)_6507419991450976260]&#10;    WHEN &apos;16&apos; THEN [Avg Order Items (copy)_2578873743273709568]&#10;    WHEN &apos;17&apos; THEN [Item % Rejection Rate backend only (copy)_951033586048462850]&#10;    WHEN &apos;18&apos; THEN [Calculation_2538833970026364928]&#10;    WHEN &apos;19&apos; THEN [Calculation_5351894887910461441]&#10;    WHEN &apos;20&apos; THEN [$ Replacements GMV (copy)_5351894887975436290]&#10;    WHEN &apos;21&apos; THEN [$ GMV Replacements + Added directly (copy)_5351894887976640516]&#10;END' />
      </column>
      <column caption='Metric Display' datatype='string' name='[Calculation_3960564077725749251]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Timeline metric (copy)_2010505394417131534] IN  (&apos;18&apos;,&apos;20&apos;) &#10;THEN &#10;    &quot;€ &quot; + &#10;    LEFT(STR(INT([Calculation_3960564077725003778])), LEN(STR(INT([Calculation_3960564077725003778]))) - 3) + &#10;    &quot;.&quot; + &#10;    RIGHT(STR(INT([Calculation_3960564077725003778])), 3) &#10;     + &#10;    RIGHT(&quot;00&quot; + STR(ROUND(([Calculation_3960564077725003778] - INT([Calculation_3960564077725003778])) * 100, 0)), 0)&#10;ELSE &#10;    STR(ROUND([Calculation_3960564077725003778] * 100,1)) + &quot; %&quot;&#10;END' />
      </column>
      <column caption='%Pelican Contacted Order' datatype='real' name='[Calculation_4034732718765412352]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([pelican_contact_orders])/sum([pelican_confirmed_orders])' />
      </column>
      <column caption='pelican_replacement_l30_flag_cf' datatype='string' name='[Calculation_4113123466683564033]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [pelican_replacement_l30_flag] &gt; 0 then &apos;Yes&apos; else &apos;No&apos; end' />
      </column>
      <column caption='1Dropoff_%_ConfirmedtoPelicanOrder' datatype='real' name='[Calculation_4251116613366321153]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-(sum([total_pelican_orders]) - sum([pelican_confirmed_orders])) / sum([total_pelican_orders])' />
      </column>
      <column caption='% GIR-1 Total Items' datatype='real' default-format='p0%' name='[Calculation_4453919318659833858]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([exit_gir_1])/SUM([eligible_replacement_items])' />
      </column>
      <column caption='Confirmed BE + Talabat' datatype='integer' name='[Calculation_4792111541182627847]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([confirmed_answer_backend_eligible_for_replacement])+SUM([replacement_answered_confirmed_eligible_for_replacement])' />
      </column>
      <column caption='replace_pelican_item_new' datatype='real' name='[Calculation_4894920278734184448]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Vendor_App] = &apos;pelican&apos; then [replacements_pelican_items_v2] else 0 END)' />
      </column>
      <column caption='pelican_eligible_replacement_items' datatype='real' name='[Calculation_4894920278734585857]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Vendor_App] = &apos;pelican&apos; then [eligible_replacement_items] else 0 END)' />
      </column>
      <column caption='% GMV Replaced from eligible' datatype='real' default-format='p0.0%' name='[Calculation_5351894887910461441]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2538833970026364928]/[$ Replacements GMV (copy)_5351894887910281216]' />
      </column>
      <column caption='ABV' datatype='real' name='[Calculation_5391653226430795777]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [Vendor_App] = &apos;pelican&apos; THEN [gbv_gross] ELSE 0 END)/SUM([pelican_confirmed_orders])' />
      </column>
      <column caption='Fill Rate' datatype='real' name='[Calculation_5391653226436194307]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [Vendor_App] = &apos;pelican&apos; THEN [qty_sold] ELSE 0 END)/sum(if [Vendor_App] = &apos;pelican&apos; THEN [qty_ordered] ELSE 0 END)' />
      </column>
      <column caption='Replacement Flow Gir1&amp;2' datatype='string' name='[Calculation_5697757283087187968]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//IF replacement_flow_gir_ph1_flag &gt; 0 then &apos;GIR-Phase1&apos; &#10;//ELSEIF replacement_flow_talabat_inapp_flag &gt; 0 then &apos;Talabat-inapp&apos; &#10;//ELSEIF replacement_flow_new_product_added_flag &gt; 0 then &apos;New-Product-Added&apos; &#10;//ELSEIF replacement_flow_custom_flow_replaced_flag &gt; 0 then &apos;Custom-Flow&apos; &#10;//ELSEIF replacement_flow_gir_ph2_flag &gt; 0 then &apos;GIR-Phase2&apos;&#10;//ELSE &apos;Others&apos;&#10;//END&#10;&#10;//If [Replacement Flow All] = &apos;GIR-Phase1&apos; then &apos;GIR-Phase1&apos;&#10;//ELSEIF [Replacement Flow All] = &apos;GIR-Phase2&apos; then &apos;GIR-Phase2&apos;&#10;//END&#10;&#10;If be_customer_sent&gt;0 then &apos;GIR-Phase2&apos;&#10;ELSEIf [Replacement Flow Gir1&amp;2 (copy)_6601854909039779842] = &apos;GIR-Phase1&apos; then &apos;GIR-Phase1&apos;&#10;END' />
      </column>
      <column caption='replacement_answer_gir + others' datatype='integer' name='[Calculation_5697757283096076289]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[replacement_answered_gir] + [replacement_answered_confirmed] &#10;// add rejected as well+ replacement_an&#10;&#10;//If [Management Entity] = &apos;Talabat&apos; then 0 &#10;//else [replacement_answered_gir] end //+ [replacement_answered_confirmed]' />
      </column>
      <column caption='Item Eligible Temp' datatype='real' name='[Calculation_6507419991443197952]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[eligible_replacement_items]' />
      </column>
      <column caption='elg_pelican_replacement_orders_gir1&amp;2' datatype='integer' name='[Calculation_6601854909034287104]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if ([Calculation_5697757283087187968] = &apos;GIR-Phase1&apos; &#10;OR [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos;) AND &#10;([Replacement Flow Gir1&amp;2 (copy)_6601854909039779842] = &apos;GIR-Phase2&apos; OR [Replacement Flow Gir1&amp;2 (copy)_6601854909039779842] = &apos;GIR-Phase1&apos;)&#10; then [elg_pelican_replacement_orders] else 0 end)' />
      </column>
      <column caption='replacement_sent_qty_new' datatype='real' name='[Calculation_706854084968660992]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(&#10;If [replacement_suggested_eligible_for_replacement] &gt; 0 and [replacement_sent_eligible_for_replacement_v2] &gt; 0 //and [Management Entity] &lt;&gt; &apos;Talabat&apos;&#10;then [replacement_suggestion_qty] &#10;ELSE 0 END&#10;)' />
      </column>
      <column caption='% Confirmation Rate backend only' datatype='real' default-format='p0.0%' name='[Calculation_763852778178813953]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//SUM([replacement_confirmed_eligible_for_replacement_v2])/SUM([replacement_sent_eligible_for_replacement_v2])&#10;SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos; THEN confirmed_answer_backend_eligible_for_replacement END) &#10;/&#10;SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos; THEN replacement_sent_eligible_for_replacement_v2 END)' />
      </column>
      <column caption='Order #Replacement confirmed' datatype='integer' name='[Confirmed BE + Talabat (copy)_2968012907857879040]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([replacement_confirmed_eligible_for_replacement_v2])' />
      </column>
      <column caption='2.0Dropoff_%_PelicantoEligibleOrder' datatype='real' name='[Dropoff_%_ConfirmedtoPelicanOrder (copy)_4611263846109401088]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-(sum([pelican_confirmed_orders]) - sum([orders_eligible_for_replacement])) / sum([pelican_confirmed_orders])' />
      </column>
      <column caption='4Dropoff_%_StartedtoShownOrder' datatype='real' name='[Dropoff_%_EligibletoStartedOrder (copy)_4611263846111727618]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-(sum([replacement_started]) - sum([replacement_suggested_eligible_for_replacement])) / sum([replacement_started])' />
      </column>
      <column caption='3Dropoff_%_EligibletoStartedOrder' datatype='real' name='[Dropoff_%_PelicantoEligibleOrder (copy)_4611263846110781441]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-(sum([item_not_found]) - sum([replacement_started])) / sum([item_not_found])' />
      </column>
      <column caption='Dynamic Date STR' datatype='string' name='[Dynamic Date (copy)_3541307062713298949]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(DATE(CASE [Parameters].[Parameter 1] &#10;WHEN &apos;Day&apos; THEN DATETRUNC(&apos;day&apos;, [local_date],&apos;Monday&apos;) &#10;WHEN &apos;Week&apos; THEN DATETRUNC(&apos;week&apos;, [local_date],&apos;Monday&apos;)&#10;WHEN &apos;Month&apos; THEN DATETRUNC(&apos;month&apos;, [local_date],&apos;Monday&apos;)  &#10;WHEN &apos;Quarter&apos; THEN DATETRUNC(&apos;quarter&apos;, [local_date],&apos;Monday&apos;) &#10;END))' />
      </column>
      <column caption='Timeline metric selection' datatype='real' default-format='p0.0%' name='[Dynamic metric selection (copy)_230387323708977165]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='If [Parameters].[Select Metrics(PELICAN ORDERS) (copy)_230387323708497932] = &apos;1&apos; then [Calculation_1207668441211351042]&#10;ELSEIF [Parameters].[Select Metrics(PELICAN ORDERS) (copy)_230387323708497932] = &apos;2&apos; then [Calculation_3212755418220572672]&#10;ELSEIF [Parameters].[Select Metrics(PELICAN ORDERS) (copy)_230387323708497932] = &apos;3&apos; then [Calculation_763852778178813953]&#10;ELSEIF [Parameters].[Select Metrics(PELICAN ORDERS) (copy)_230387323708497932] = &apos;4&apos; then [Calculation_230387323702554635]&#10;ELSEIF [Parameters].[Select Metrics(PELICAN ORDERS) (copy)_230387323708497932] = &apos;5&apos; then [CVR1 - Not found to started (copy)_230387323695685636]&#10;ELSEIF [Parameters].[Select Metrics(PELICAN ORDERS) (copy)_230387323708497932] = &apos;6&apos; then [CVR2 - Started to suggested (copy)_230387323696893959]&#10;//ELSEIF [Timeline metric] = &apos;7&apos; then [CVR3 - Sent to Answered]&#10;//ELSEIF [Timeline metric] = &apos;8&apos; then [CVR4 - Answered to replaced]&#10;ELSEIF [Parameters].[Select Metrics(PELICAN ORDERS) (copy)_230387323708497932] = &apos;9&apos; then [CVR3 - Sent to Confirmed (copy)_763852778203865092]&#10;ELSEIF [Parameters].[Select Metrics(PELICAN ORDERS) (copy)_230387323708497932] = &apos;10&apos; then [CVR4 - Answered to replaced (copy)_253960857604853761]&#10;ELSEIF [Parameters].[Select Metrics(PELICAN ORDERS) (copy)_230387323708497932] = &apos;11&apos; then [Calculation_763852778178813953]&#10;ELSEIF [Parameters].[Select Metrics(PELICAN ORDERS) (copy)_230387323708497932] = &apos;12&apos; then [% Confirmation Rate backend only (copy) (copy)_763852778179452931]&#10;ELSEIF [Parameters].[Select Metrics(PELICAN ORDERS) (copy)_230387323708497932] = &apos;13&apos; then [% Confirmation Rate backend only (copy)_763852778179440642]&#10;ELSEIF [Parameters].[Select Metrics(PELICAN ORDERS) (copy)_230387323708497932] = &apos;14&apos; THEN [CVR1 - Eligible to initiated replacement (copy)_273030743614816256]// in order level this code is 16&#10;ELSEIF [Parameters].[Select Metrics(PELICAN ORDERS) (copy)_230387323708497932] = &apos;15&apos; THEN [Item % Add Products from eligible (copy)_273030743618002946]&#10;// Confirmed not selected would be 16, doesn&apos;t make sense in order level&#10;ELSEIF [Parameters].[Select Metrics(PELICAN ORDERS) (copy)_230387323708497932] = &apos;17&apos; THEN [% Replaced from eligible (copy)_3726236131322966024]&#10;END' />
      </column>
      <column caption='Dynamic metric label' datatype='string' name='[Dynamic metric selection (copy)_3580009910059421704]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='If [Parameters].[Parameter 2] = &apos;OOS GMV Loss&apos; then &apos;€&apos;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;OOS vendor fail rate&apos; then &apos;%&apos;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Pelican Partial fulfillment rate&apos; then &apos;%&apos;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Pelican Partial fulfillment rate old&apos; then &apos;%&apos;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Avg Order Items&apos; then &apos; &apos;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Avg Sent Items&apos; then &apos; &apos;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;(%)orders triggered for IR&apos; then &apos;%&apos;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;(%)Orders w replacement started&apos; then &apos;%&apos;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;%Pelican Contacted Order&apos; then &apos;%&apos;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;(%)Eligible orders replaced&apos; then &apos;%&apos;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;ABV&apos; then &apos;€&apos;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;(%)Fill Rate&apos; then &apos;%&apos;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Picker Compliance Rate&apos; then &apos;%&apos;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;(%)Items Replaced from Eligible&apos; then &apos;%&apos;&#10;END' />
      </column>
      <column caption='Flag(Order Triggered for IR) String' datatype='string' name='[Flag(Order Triggered for IR) (copy)_3580009911185420297]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if sum([item_not_found]) &gt; 0 then &apos;1&apos; else &apos;0&apos; END' />
      </column>
      <column caption='Flag(Call Initiated for IR) String' datatype='string' name='[Flag(Order Triggered for IR) String (copy)_140033818694770688]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if [PickerCallingRate exclude talabat (copy)_5391653226120253440] &gt; 0 then &apos;1&apos; else &apos;0&apos; END' />
