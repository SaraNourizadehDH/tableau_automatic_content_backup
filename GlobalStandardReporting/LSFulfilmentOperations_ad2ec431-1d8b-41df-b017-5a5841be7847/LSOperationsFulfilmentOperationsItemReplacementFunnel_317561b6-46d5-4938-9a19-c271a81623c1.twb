    <worksheet name='Exit Glossary'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontname='Tableau Medium' fontsize='9'>Glossary</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Attribuition flow' name='federated.1ljdeyr0xkancj144zsfc0iwdzuk' />
          </datasources>
          <datasource-dependencies datasource='federated.1ljdeyr0xkancj144zsfc0iwdzuk'>
            <column caption='Icon Glossary' datatype='string' name='[Calculation_5500795126460055552]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;1&apos;' />
            </column>
            <column-instance column='[Calculation_5500795126460055552]' derivation='None' name='[none:Calculation_5500795126460055552:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='height' value='118' />
          </style-rule>
          <style-rule element='table'>
            <format attr='background-color' value='#00000000' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Shape' />
            <encodings>
              <shape column='[federated.1ljdeyr0xkancj144zsfc0iwdzuk].[none:Calculation_5500795126460055552:nk]' />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run bold='true' fontsize='11' indent='2520' underline='true'>Glossary</run>
                <run bold='true' fontsize='11' indent='2520'>:</run>
                <run indent='2520'>Æ&#10;</run>
                <run bold='true' indent='2520'>– GIR-1 = </run>
                <run indent='2520'>Global Item Replacement Phase 1: Initial replacement strategy, used during transition to GIR-2. </run>
                <run bold='true' indent='2520'>Does not</run>
                <run indent='2520'> show suggestions to customer.&#10;</run>
                <run bold='true' indent='2520'>– GIR-2 = </run>
                <run indent='2520'>Global Item Replacement Phase 2: Current QC strategy. Starts with grid-view and shows item suggestions to customer.
</run>
                <run bold='true' indent='2520'>– No-flow = </run>
                <run indent='2520'>Vendor doesn&apos;t enable either GIR-1 or GIR-2.
</run>
                <run bold='true' indent='2520'>– Initiation = </run>
                <run indent='2520'>Happens when the grid-view is shown to the picker.
</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000'>1. Grid-view</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>Visual interface shown to pickers with replacement suggestions in grid format.</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000'>2. Partial Fulfillment</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>Product available but not in the requested quantity. Tipically doesn&apos;t trigger replacement flow. (i.e.: Ordered 6 cans of soda but vendor has only 3) </run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000'>3. Cancelled Orders</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>Replacement not initiated because the order was cancelled by vendor. Tipically doesn&apos;t trigger replacement flow.</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000'>4. POS Direct</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>Vendor uses POS Direct integration. Tipically doesn&apos;t trigger replacement flow.</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000'>5. Old App Version</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>Replacement not initiated due to outdated Pelican app.</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000'>6. Not Enabled</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>Vendor choses to not enable replacements on its settings.</run>
              </formatted-text>
            </customized-tooltip>
            <style>
              <style-rule element='mark'>
                <format attr='shape' value='Info Icon/search.png' />
                <format attr='mark-labels-cull' value='true' />
                <format attr='mark-labels-show' value='false' />
              </style-rule>
              <style-rule element='pane'>
                <format attr='minheight' value='-1' />
                <format attr='maxheight' value='-1' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
      <simple-id uuid='{793905A9-0810-4A87-B69C-B6856828CB21}' />
    </worksheet>
    <worksheet name='Exit L0'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontname='Tableau Medium' fontsize='12'>Level 0: Items Eligible for Replacement</run>
            <run>Æ&#10;</run>
            <run fontname='Tableau Medium' fontsize='10'>How many items are eligible for replacement? </run>
            <run fontname='Tableau Medium' fontsize='9' italic='true'>(First box on the top in the diagram)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='ls_ops_ir_rl' name='federated.1ex1aqh01b3tvm1enjguy0hjrfl2' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Monthly' caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
              <aliases>
                <alias key='&quot;Day&quot;' value='Daily' />
                <alias key='&quot;Month&quot;' value='Monthly' />
                <alias key='&quot;Quarter&quot;' value='Quarterly' />
                <alias key='&quot;Week&quot;' value='Weekly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ex1aqh01b3tvm1enjguy0hjrfl2'>
            <column caption='# Items eligible (total) (copy)' datatype='real' name='[# Items eligible (total) (copy)_1603281492348948485]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([eligible_replacement_items])' />
            </column>
            <column caption='% No-flow Total Eligible Items' datatype='real' default-format='p0%' name='[% GIR-1 Total Items (copy)_4453919318663348233]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([exit_no_flow_total_items])/SUM([eligible_replacement_items])' />
            </column>
            <column caption='Refresh rule' datatype='boolean' name='[Calculation_1038783420879003652]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[local_date] &lt;= {MAX([local_date])} - 2' />
            </column>
            <column caption='concat_chain_country' datatype='string' name='[Calculation_167477668810276865]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[chain_name]+&quot; (&quot;+[country]+&quot;)&quot;' />
            </column>
            <column caption='concat_entity_country' datatype='string' name='[Calculation_167477668842803202]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;(&quot;+[management_entity]+&quot;) &quot; + [country]' />
            </column>
            <column caption='Pelican Replacement L30 Flag Boolean' datatype='boolean' name='[Calculation_2459950625618546688]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [pelican_replacement_l30_flag] = 1 then TRUE else FALSE end' />
            </column>
            <column caption='Dynamic Date' datatype='date' name='[Calculation_3571213798266298371]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 1] &#10;WHEN &apos;Day&apos; THEN DATETRUNC(&apos;day&apos;, [local_date],&apos;Monday&apos;) &#10;WHEN &apos;Week&apos; THEN DATETRUNC(&apos;week&apos;, [local_date],&apos;Monday&apos;)&#10;WHEN &apos;Month&apos; THEN DATETRUNC(&apos;month&apos;, [local_date],&apos;Monday&apos;)  &#10;WHEN &apos;Quarter&apos; THEN DATETRUNC(&apos;quarter&apos;, [local_date],&apos;Monday&apos;) &#10;END)' />
            </column>
            <column caption='pelican_replacement_l30_flag_cf' datatype='string' name='[Calculation_4113123466683564033]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [pelican_replacement_l30_flag] &gt; 0 then &apos;Yes&apos; else &apos;No&apos; end' />
            </column>
            <column caption='Replacement Flow Gir1&amp;2' datatype='string' name='[Calculation_5697757283087187968]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//IF replacement_flow_gir_ph1_flag &gt; 0 then &apos;GIR-Phase1&apos; &#10;//ELSEIF replacement_flow_talabat_inapp_flag &gt; 0 then &apos;Talabat-inapp&apos; &#10;//ELSEIF replacement_flow_new_product_added_flag &gt; 0 then &apos;New-Product-Added&apos; &#10;//ELSEIF replacement_flow_custom_flow_replaced_flag &gt; 0 then &apos;Custom-Flow&apos; &#10;//ELSEIF replacement_flow_gir_ph2_flag &gt; 0 then &apos;GIR-Phase2&apos;&#10;//ELSE &apos;Others&apos;&#10;//END&#10;&#10;//If [Replacement Flow All] = &apos;GIR-Phase1&apos; then &apos;GIR-Phase1&apos;&#10;//ELSEIF [Replacement Flow All] = &apos;GIR-Phase2&apos; then &apos;GIR-Phase2&apos;&#10;//END&#10;&#10;If be_customer_sent&gt;0 then &apos;GIR-Phase2&apos;&#10;ELSEIf [Replacement Flow Gir1&amp;2 (copy)_6601854909039779842] = &apos;GIR-Phase1&apos; then &apos;GIR-Phase1&apos;&#10;END' />
            </column>
            <column caption='# Items eligible (total)' datatype='real' name='[Item Customer Confirmed (GIR 2) (copy)_2416603422407880704]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([eligible_replacement_items])' />
            </column>
            <column caption='Replacement Flow All' datatype='string' name='[Replacement Flow Gir1&amp;2 (copy)_6601854909039779842]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF replacement_flow_gir_ph1_flag &gt; 0 then &apos;GIR-Phase1&apos;&#10;ELSEIF replacement_flow_gir_ph2_flag &gt; 0 then &apos;GIR-Phase2&apos;&#10;//ELSEIF replacement_flow_talabat_inapp_flag &gt; 0 then &apos;Talabat-inapp&apos;&#10;ELSEIF replacement_flow_talabat_inapp_flag &gt; 0 then &apos;GIR-Phase2&apos;&#10;ELSEIF replacement_flow_new_product_added_flag &gt; 0 then &apos;New-Product-Added&apos;&#10;//ELSEIF replacement_flow_custom_flow_replaced_flag &gt; 0 then &apos;Custom-Flow&apos; DEPRECATED&#10;ELSE &apos;Others&apos;&#10;END' />
            </column>
            <column datatype='string' name='[Vendor_App]' role='dimension' type='nominal' />
            <column-instance column='[management_entity]' derivation='Attribute' name='[attr:management_entity:nk]' pivot='key' type='nominal' />
