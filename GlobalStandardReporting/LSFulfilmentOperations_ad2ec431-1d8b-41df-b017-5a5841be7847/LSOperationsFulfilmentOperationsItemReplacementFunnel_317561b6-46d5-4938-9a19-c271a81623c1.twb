            <column caption='# Replaced GIR 1' datatype='integer' name='[elg_pelican_replacement_orders_gir1&amp;2 (copy)_263108790774509577]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if (([be_customer_sent] = 0 OR ISNULL([be_customer_sent]) AND [replacement_flow_talabat_inapp_flag] =0)  )&#10;&#10; then [elg_pelican_replacement_orders] else 0 end)' />
