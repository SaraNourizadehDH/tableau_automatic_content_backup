                </zone>
                <zone forceUpdate='true' h='2356' id='448' type-v2='text' w='72637' x='26636' y='29422'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000'>Def: </run>
                    <run fontcolor='#000000' fontname='Tableau Light'>This metric is calculated by dividing the total number of items sent by the total number of pelican orders made during a period.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2622' id='211' type-v2='text' w='25909' x='727' y='31778'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontsize='12'>(%)Orders Replacements from Eligible </run>
                    <run bold='true' fontcolor='#000000' fontsize='8'>(Prev. Eligible orders replaced)</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#f5f5f5' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2622' id='212' type-v2='text' w='72637' x='26636' y='31778'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Light'>Def:</run>
                    <run fontcolor='#000000' fontname='Tableau Light'> The rate calculated by dividing the number of replaced pelican orders from the total number of orders that were Partial Fulfillment (PF) or failed due to Out of Stock (OOS) issues or replaced.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#f5f5f5' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2356' id='205' type-v2='text' w='25909' x='727' y='34400'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontsize='12'>(%)Orders triggered for IR</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2356' id='206' type-v2='text' w='72637' x='26636' y='34400'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000'>Def:</run>
                    <run fontcolor='#000000'>Æ </run>
                    <run fontcolor='#000000' fontname='Benton Sans Book'>Æ </run>
                    <run fontcolor='#000000' fontname='Tableau Light'>The rate calculated by dividing the number of Pelican orders in which the picker clicked on &quot;Item is &apos;out of stock&apos;&quot; (indicating eligibility for replacement) by the total number of Pelican orders placed. </run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2400' id='201' type-v2='text' w='25909' x='727' y='36756'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontsize='12'>(%)Picker Compliance Rate</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#f5f5f5' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2400' id='202' type-v2='text' w='72637' x='26636' y='36756'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Light'>Def: </run>
                    <run fontcolor='#000000' fontname='Tableau Light'>The rate is calculated by dividing the number of pelican orders where picker send the suggestion to the customer from the total number of pelican orders eligible for replacement(Partial Fulfillment (PF) or failed due to Out of Stock (OOS) or replaced)</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#f5f5f5' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2311' id='207' type-v2='text' w='25909' x='727' y='39156'>
