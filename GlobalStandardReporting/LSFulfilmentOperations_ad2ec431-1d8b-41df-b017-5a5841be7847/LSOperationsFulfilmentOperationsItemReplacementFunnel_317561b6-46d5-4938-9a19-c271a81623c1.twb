                  <format attr='border-width' value='1' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#f5f5f5' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='2044' id='240' type-v2='text' w='72182' x='27091' y='53867'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontname='Tableau Light'>Def:</run>
                  <run fontcolor='#000000' fontname='Tableau Light'> Total number of confirmed orders/Items  processed on pelican device</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='1' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='2044' id='241' type-v2='text' w='26364' x='727' y='53867'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontsize='12'>Confirmed Pelican Orders/Items</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='1' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='2667' id='242' type-v2='text' w='26364' x='727' y='58622'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontsize='12'>Orders/Items triggered for Item Replacment</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
