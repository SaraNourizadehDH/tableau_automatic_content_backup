            <column datatype='integer' name='[orders_eligible_for_replacement]' role='measure' type='quantitative' />
            <column caption='Pelican Confirmed Orders' datatype='integer' name='[pelican_confirmed_orders]' role='measure' type='quantitative' />
            <column datatype='integer' name='[pelican_replacement_l30_flag]' role='measure' type='quantitative' />
            <column caption='Region' datatype='string' name='[region]' role='dimension' type='nominal' />
            <column datatype='integer' name='[replacement_confirmed_eligible_for_replacement_v2]' role='measure' type='quantitative' />
            <column datatype='integer' name='[replacement_done_eligible_for_replacement_v2]' role='measure' type='quantitative' />
            <column datatype='integer' name='[replacement_flow_gir_ph1_flag]' role='measure' type='quantitative' />
            <column datatype='integer' name='[replacement_flow_gir_ph2_flag]' role='measure' type='quantitative' />
