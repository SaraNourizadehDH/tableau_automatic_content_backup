                <zone forceUpdate='true' h='2534' id='544' type-v2='text' w='72273' x='27000' y='92533'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Light'>Def: </run>
                    <run fontcolor='#000000' fontname='Tableau Light'>This filter is designated to flag the vendors who had active item replacement in the last 30 days</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
