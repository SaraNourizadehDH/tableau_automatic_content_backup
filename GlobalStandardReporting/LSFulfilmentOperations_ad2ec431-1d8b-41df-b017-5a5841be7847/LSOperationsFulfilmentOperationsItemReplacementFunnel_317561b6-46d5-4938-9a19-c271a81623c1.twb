        <column-instance column='[Calculation_3571213798266298371]' derivation='None' name='[none:Calculation_3571213798266298371:qk]' pivot='key' type='quantitative' />
        <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
        <column-instance column='[is_aaa_supermarket]' derivation='None' name='[none:is_aaa_supermarket:nk]' pivot='key' type='nominal' />
        <column-instance column='[is_aaa_vendor]' derivation='None' name='[none:is_aaa_vendor:nk]' pivot='key' type='nominal' />
        <column-instance column='[management_entity]' derivation='None' name='[none:management_entity:nk]' pivot='key' type='nominal' />
