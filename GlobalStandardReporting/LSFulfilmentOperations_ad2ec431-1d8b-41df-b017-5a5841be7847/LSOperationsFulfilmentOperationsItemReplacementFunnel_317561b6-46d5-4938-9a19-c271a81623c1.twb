            <member alias='% CVR2 - Initiated replacement to sent' value='&quot;6&quot;' />
            <member alias='% CVR3 - Sent to Confirmed' value='&quot;9&quot;' />
            <member alias='% CVR4 - Confirmed to replaced' value='&quot;10&quot;' />
            <member alias='% Replaced from eligible' value='&quot;2&quot;' />
            <member alias='% Replaced+Add Products from eligible' value='&quot;14&quot;' />
            <member alias='% Add Products from eligible' value='&quot;15&quot;' />
            <member alias='% Picker Compliance Rate' value='&quot;1&quot;' />
            <member alias='% Replaced from sent' value='&quot;4&quot;' />
            <member alias='% Confirmation rate' value='&quot;11&quot;' />
            <member alias='% Rejection rate' value='&quot;12&quot;' />
            <member alias='% Partial rejection rate' value='&quot;17&quot;' />
