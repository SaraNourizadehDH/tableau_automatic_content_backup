              <zone forceUpdate='true' h='2311' id='299' type-v2='text' w='72637' x='26636' y='22089'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000'>Def:</run>
                  <run fontcolor='#000000'>Æ </run>
                  <run fontcolor='#000000' fontname='Tableau Light'>This rate is calculated by dividing the total number of partially fulfilled orders with replacement by the overall number of confirmed pelican orders</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='1' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#f5f5f5' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='2800' id='302' type-v2='text' w='26364' x='727' y='79422'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontsize='12'>PickerCallingOrders(#Orders)(Rate)</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='1' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='2800' id='303' type-v2='text' w='72182' x='27091' y='79422'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000'>Def: (#Orders)(Rate)</run>
                  <run fontcolor='#000000' fontname='Tableau Light'>The metric is calculated by dividing the total number of Pelican orders where the picker clicked on &apos;Call Customer&apos; to confirm item replacement by the total number of Pelican orders where the picker clicked on &apos;Item is out of stock&apos; to activate the item replacement flow. [</run>
                  <run bold='true' fontcolor='#000000' fontname='Tableau Light'>Excluding Talabat</run>
                  <run fontcolor='#000000' fontname='Tableau Light'>]</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='1' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='2667' id='304' type-v2='text' w='25909' x='727' y='43822'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='12'>(€)ABV Sent</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='1' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='2667' id='305' type-v2='text' w='72637' x='26636' y='43822'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000'>Def:</run>
                  <run fontcolor='#000000'>Æ </run>
                  <run fontcolor='#000000' fontname='Tableau Light'>This is calculated by dividing the total value of merchandise sent, after subtracting discounts and delivery fees, by the total number of orders </run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='1' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='1867' id='306' type-v2='text' w='25909' x='727' y='46489'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontsize='12'>(%)Fill Rate</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='1' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#f5f5f5' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='1867' id='307' type-v2='text' w='72637' x='26636' y='46489'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000'>Def:</run>
                  <run fontcolor='#000000'>Æ </run>
                  <run fontcolor='#000000' fontname='Tableau Light'>This is calculated by dividing the number of items sold by the number of items ordered</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='1' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#f5f5f5' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='2311' id='298' type-v2='text' w='25909' x='727' y='22089'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontsize='12'>(%)PF Rate(New)</run>
                </formatted-text>
