              <zone forceUpdate='true' h='2622' id='490' type-v2='text' w='72182' x='27091' y='82222'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontname='Tableau Light'>Def: </run>
                  <run fontcolor='#000000' fontname='Tableau Light'>The rate is calculated by dividing the  number of pelican orders where picker clicks on replace item from the total number of pelican orders eligible for replacement(Partial Fulfillment (PF) or failed due to Out of Stock (OOS) or replaced)</run>
                </formatted-text>
                <zone-style>
