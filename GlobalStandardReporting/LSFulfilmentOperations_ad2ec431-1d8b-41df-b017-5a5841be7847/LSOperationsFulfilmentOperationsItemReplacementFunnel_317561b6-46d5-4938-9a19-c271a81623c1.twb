                <zone forceUpdate='true' h='2755' id='247' type-v2='text' w='72182' x='27091' y='63778'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Light'>Def: </run>
                    <run fontcolor='#000000' fontname='Tableau Light'>The number of Pelican orders/items in which the replacement flow was initiated, and the picker was presented with a grid view containing a list of SKU suggestions for item replacement</run>
                  </formatted-text>
