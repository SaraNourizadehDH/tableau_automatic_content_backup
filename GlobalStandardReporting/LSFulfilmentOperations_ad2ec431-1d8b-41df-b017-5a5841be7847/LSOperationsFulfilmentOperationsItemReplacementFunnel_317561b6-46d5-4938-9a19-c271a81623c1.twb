                <alias key='&quot;16&quot;' value='% Items eligible from total ordered' />
                <alias key='&quot;17&quot;' value='% Partial rejection rate' />
                <alias key='&quot;18&quot;' value='€ GMV Replacements' />
                <alias key='&quot;19&quot;' value='% Replaced from Eligible (€ GMV)' />
                <alias key='&quot;2&quot;' value='% Replaced from eligible' />
                <alias key='&quot;20&quot;' value='€ GMV added directly' />
                <alias key='&quot;21&quot;' value='% GMV Replaced + Added directly from Eligible' />
                <alias key='&quot;4&quot;' value='% Replaced from sent' />
                <alias key='&quot;5&quot;' value='% CVR1 - Eligible to initiated replacement' />
                <alias key='&quot;6&quot;' value='% CVR2 - Initiated replacement to sent' />
                <alias key='&quot;9&quot;' value='% CVR3 - Sent to Confirmed' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ex1aqh01b3tvm1enjguy0hjrfl2'>
            <column caption='% GMV Replacements + Added directly from Eligible' datatype='real' default-format='p0.0%' name='[$ GMV Replacements + Added directly (copy)_5351894887976640516]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([replacements_pelican_total_price_eur])+SUM([gmv_added_directly]))/SUM([gmv_eligible_for_replacement])' />
            </column>
            <column caption='$ GMV Eligible for Replacement' datatype='real' default-format='c&quot;€&quot;#,##0;-&quot;€&quot;#,##0' name='[$ Replacements GMV (copy)_5351894887910281216]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_eligible_for_replacement])' />
            </column>
            <column caption='$ GMV Added directly' datatype='real' default-format='c&quot;€&quot;#,##0;-&quot;€&quot;#,##0' name='[$ Replacements GMV (copy)_5351894887975436290]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_added_directly])' />
            </column>
            <column caption='Item % Confirmation Rate backend only' datatype='real' default-format='p0.0%' name='[% Confirmation Rate backend only (copy)_2010505394411159563]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos; THEN [be_customer_confirmed] END) &#10;/ &#10;SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos; THEN [be_customer_sent] END)' />
            </column>
            <column caption='Item % Expiration Rate backend only' datatype='real' default-format='p0.0%' name='[% Expiration Rate backend only (copy)_2010505394411638797]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos; THEN [be_customer_expired] ELSE 0 END) &#10;/SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos; THEN[be_customer_sent] ELSE 0 END)' />
            </column>
            <column caption='Item % Rejection Rate backend only' datatype='real' default-format='p0.0%' name='[% Rejection Rate backend only (copy)_2010505394411270156]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos; THEN [be_customer_rejected] +[be_customer_confirmed_not_selected] ELSE 0 END) &#10;/SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos; THEN[be_customer_sent] ELSE 0 END)' />
            </column>
            <column caption='Item % Replaced from eligible' datatype='real' default-format='p0.0%' name='[% Replaced from eligible (copy)_2010505394408988677]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//sum([Pelican Replacements Orders]) / sum([partial_orders_old] + [Failed Due To Oos])&#10;&#10;//New definition&#10;sum([replacements_pelican_items_v2]) / SUM([eligible_replacement_items])&#10;//[Eligible orders for replacement Old]' />
            </column>
            <column caption='Item % Replaced from sent' datatype='real' default-format='p0.0%' name='[% Replaced from sent (copy)_2010505394410823689]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos; THEN [replacements_pelican_items_only_selected] END)&#10; / &#10;SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos; THEN [be_customer_sent] END)' />
            </column>
            <column caption='% Items Eligible from total ordered' datatype='real' default-format='p0.0%' name='[Avg Order Items (copy)_2578873743273709568]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([eligible_replacement_items])/sum(if [Vendor_App] = &apos;pelican&apos; then [qty_ordered] else 0 end)' />
            </column>
            <column caption='Item CVR1 - Eligible to initiated replacement' datatype='real' default-format='p0.0%' name='[CVR1 - Eligible to initiated replacement (copy)_2010505394403991552]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([be_replacement_suggestion_qty])/SUM([eligible_replacement_items])' />
            </column>
            <column caption='Item CVR2 - Initiated replacement to sent' datatype='real' default-format='p0.0%' name='[CVR2 - Initiated replacement to sent (copy)_2010505394404290561]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN(SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos; THEN [be_customer_sent] END)/&#10;SUM([be_replacement_suggestion_qty]),1)&#10;//Investigate why over 100% in some cases' />
            </column>
            <column caption='Item CVR3 - Sent to Confirmed (plus talabat)' datatype='real' default-format='p0.0%' name='[CVR3 - Sent to Confirmed (plus talabat) (copy)_2010505394405126147]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUm([be_customer_confirmed])&#10;/SUM([be_customer_sent])' />
            </column>
            <column caption='Refresh rule' datatype='boolean' name='[Calculation_1038783420879003652]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[local_date] &lt;= {MAX([local_date])} - 2' />
            </column>
            <column caption='concat_chain_country' datatype='string' name='[Calculation_167477668810276865]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[chain_name]+&quot; (&quot;+[country]+&quot;)&quot;' />
            </column>
            <column caption='concat_entity_country' datatype='string' name='[Calculation_167477668842803202]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;(&quot;+[management_entity]+&quot;) &quot; + [country]' />
            </column>
            <column caption='Pelican Replacement L30 Flag Boolean' datatype='boolean' name='[Calculation_2459950625618546688]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [pelican_replacement_l30_flag] = 1 then TRUE else FALSE end' />
            </column>
            <column caption='$ GMV Replacements' datatype='real' default-format='c&quot;€&quot;#,##0;-&quot;€&quot;#,##0' name='[Calculation_2538833970026364928]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([replacements_pelican_total_price_eur])' />
            </column>
            <column caption='Dynamic Date' datatype='date' name='[Calculation_3571213798266298371]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 1] &#10;WHEN &apos;Day&apos; THEN DATETRUNC(&apos;day&apos;, [local_date],&apos;Monday&apos;) &#10;WHEN &apos;Week&apos; THEN DATETRUNC(&apos;week&apos;, [local_date],&apos;Monday&apos;)&#10;WHEN &apos;Month&apos; THEN DATETRUNC(&apos;month&apos;, [local_date],&apos;Monday&apos;)  &#10;WHEN &apos;Quarter&apos; THEN DATETRUNC(&apos;quarter&apos;, [local_date],&apos;Monday&apos;) &#10;END)' />
            </column>
            <column caption='Metric Value' datatype='real' name='[Calculation_3960564077725003778]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Timeline metric (copy)_2010505394417131534]&#10;    WHEN &apos;1&apos; THEN [Picker Compliance (copy)_2010505394410926090]&#10;    WHEN &apos;2&apos; THEN [% Replaced from eligible (copy)_2010505394408988677]&#10;    WHEN &apos;3&apos; THEN [% Confirmation Rate backend only (copy)_2010505394411159563]&#10;    WHEN &apos;4&apos; THEN [% Replaced from sent (copy)_2010505394410823689]&#10;    WHEN &apos;5&apos; THEN [CVR1 - Eligible to initiated replacement (copy)_2010505394403991552]&#10;    WHEN &apos;6&apos; THEN [CVR2 - Initiated replacement to sent (copy)_2010505394404290561]&#10;    WHEN &apos;9&apos; THEN [CVR3 - Sent to Confirmed (plus talabat) (copy)_2010505394405126147]&#10;    WHEN &apos;10&apos; THEN [Item CVR4 - Confirmed to replaced (copy)_769200749606723585]&#10;    WHEN &apos;11&apos; THEN [% Confirmation Rate backend only (copy)_2010505394411159563]&#10;    WHEN &apos;12&apos; THEN [% Rejection Rate backend only (copy)_2010505394411270156]&#10;    WHEN &apos;13&apos; THEN [% Expiration Rate backend only (copy)_2010505394411638797]&#10;    WHEN &apos;14&apos; THEN [Item % Replaced from eligible (copy)_6507419991450529795]&#10;    WHEN &apos;15&apos; THEN [Item % Replaced from eligible +Add Products (copy)_6507419991450976260]&#10;    WHEN &apos;16&apos; THEN [Avg Order Items (copy)_2578873743273709568]&#10;    WHEN &apos;17&apos; THEN [Item % Rejection Rate backend only (copy)_951033586048462850]&#10;    WHEN &apos;18&apos; THEN [Calculation_2538833970026364928]&#10;    WHEN &apos;19&apos; THEN [Calculation_5351894887910461441]&#10;    WHEN &apos;20&apos; THEN [$ Replacements GMV (copy)_5351894887975436290]&#10;    WHEN &apos;21&apos; THEN [$ GMV Replacements + Added directly (copy)_5351894887976640516]&#10;END' />
            </column>
            <column caption='Metric Display' datatype='string' name='[Calculation_3960564077725749251]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Timeline metric (copy)_2010505394417131534] IN  (&apos;18&apos;,&apos;20&apos;) &#10;THEN &#10;    &quot;€ &quot; + &#10;    LEFT(STR(INT([Calculation_3960564077725003778])), LEN(STR(INT([Calculation_3960564077725003778]))) - 3) + &#10;    &quot;.&quot; + &#10;    RIGHT(STR(INT([Calculation_3960564077725003778])), 3) &#10;     + &#10;    RIGHT(&quot;00&quot; + STR(ROUND(([Calculation_3960564077725003778] - INT([Calculation_3960564077725003778])) * 100, 0)), 0)&#10;ELSE &#10;    STR(ROUND([Calculation_3960564077725003778] * 100,1)) + &quot; %&quot;&#10;END' />
            </column>
            <column caption='pelican_replacement_l30_flag_cf' datatype='string' name='[Calculation_4113123466683564033]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [pelican_replacement_l30_flag] &gt; 0 then &apos;Yes&apos; else &apos;No&apos; end' />
            </column>
            <column caption='% GMV Replaced from eligible' datatype='real' default-format='p0.0%' name='[Calculation_5351894887910461441]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2538833970026364928]/[$ Replacements GMV (copy)_5351894887910281216]' />
            </column>
            <column caption='Replacement Flow Gir1&amp;2' datatype='string' name='[Calculation_5697757283087187968]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//IF replacement_flow_gir_ph1_flag &gt; 0 then &apos;GIR-Phase1&apos; &#10;//ELSEIF replacement_flow_talabat_inapp_flag &gt; 0 then &apos;Talabat-inapp&apos; &#10;//ELSEIF replacement_flow_new_product_added_flag &gt; 0 then &apos;New-Product-Added&apos; &#10;//ELSEIF replacement_flow_custom_flow_replaced_flag &gt; 0 then &apos;Custom-Flow&apos; &#10;//ELSEIF replacement_flow_gir_ph2_flag &gt; 0 then &apos;GIR-Phase2&apos;&#10;//ELSE &apos;Others&apos;&#10;//END&#10;&#10;//If [Replacement Flow All] = &apos;GIR-Phase1&apos; then &apos;GIR-Phase1&apos;&#10;//ELSEIF [Replacement Flow All] = &apos;GIR-Phase2&apos; then &apos;GIR-Phase2&apos;&#10;//END&#10;&#10;If be_customer_sent&gt;0 then &apos;GIR-Phase2&apos;&#10;ELSEIf [Replacement Flow Gir1&amp;2 (copy)_6601854909039779842] = &apos;GIR-Phase1&apos; then &apos;GIR-Phase1&apos;&#10;END' />
            </column>
            <column caption='Item % Confirmed not selected rate' datatype='real' default-format='p0.0%' name='[Item % Rejection Rate backend only (copy)_951033586048462850]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([be_customer_confirmed_not_selected])/SUM([be_customer_sent])' />
            </column>
            <column caption='Item % Replaced+Add Products from eligible ' datatype='real' default-format='p0.0%' name='[Item % Replaced from eligible (copy)_6507419991450529795]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//sum([Pelican Replacements Orders]) / sum([partial_orders_old] + [Failed Due To Oos])&#10;&#10;//New definition&#10;sum([replacements_pelican_items_v2] + [replacement_flow_new_product_added_item_qty_sold_total]) / SUM([eligible_replacement_items])&#10;//[Eligible orders for replacement Old]' />
            </column>
            <column caption='Item % Add Products from eligible' datatype='real' default-format='p0.0%' name='[Item % Replaced from eligible +Add Products (copy)_6507419991450976260]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//sum([Pelican Replacements Orders]) / sum([partial_orders_old] + [Failed Due To Oos])&#10;&#10;//New definition&#10;sum([replacement_flow_new_product_added_item_qty_sold_total]) / SUM([eligible_replacement_items])&#10;//[Eligible orders for replacement Old]' />
            </column>
            <column caption='Item CVR4 - Confirmed to replaced (GIR 2)' datatype='real' default-format='p0.0%' name='[Item CVR4 - Confirmed to replaced (copy)_769200749606723585]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos;  THEN ([replacements_pelican_items_only_selected]) END)&#10;/&#10;SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos; THEN ([be_customer_confirmed]) END)&#10;//Considers 100% max once might have miss-attribuition in flow' />
            </column>
            <column caption='Item Picker Compliance' datatype='real' default-format='p0.0%' name='[Picker Compliance (copy)_2010505394410926090]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos; THEN [be_customer_sent] END)&#10;/SUM([eligible_replacement_items])' />
            </column>
            <column caption='Replacement Flow All' datatype='string' name='[Replacement Flow Gir1&amp;2 (copy)_6601854909039779842]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF replacement_flow_gir_ph1_flag &gt; 0 then &apos;GIR-Phase1&apos;&#10;ELSEIF replacement_flow_gir_ph2_flag &gt; 0 then &apos;GIR-Phase2&apos;&#10;//ELSEIF replacement_flow_talabat_inapp_flag &gt; 0 then &apos;Talabat-inapp&apos;&#10;ELSEIF replacement_flow_talabat_inapp_flag &gt; 0 then &apos;GIR-Phase2&apos;&#10;ELSEIF replacement_flow_new_product_added_flag &gt; 0 then &apos;New-Product-Added&apos;&#10;//ELSEIF replacement_flow_custom_flow_replaced_flag &gt; 0 then &apos;Custom-Flow&apos; DEPRECATED&#10;ELSE &apos;Others&apos;&#10;END' />
            </column>
            <column caption='Item Timeline metric selection' datatype='real' default-format='p0.0%' name='[Timeline metric selection (copy)_2010505394417348623]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='If [Parameters].[Timeline metric (copy)_2010505394417131534] = &apos;1&apos; then [Picker Compliance (copy)_2010505394410926090]&#10;ELSEIF [Parameters].[Timeline metric (copy)_2010505394417131534] = &apos;2&apos; then [% Replaced from eligible (copy)_2010505394408988677]&#10;ELSEIF [Parameters].[Timeline metric (copy)_2010505394417131534] = &apos;3&apos; then [% Confirmation Rate backend only (copy)_2010505394411159563]&#10;ELSEIF [Parameters].[Timeline metric (copy)_2010505394417131534] = &apos;4&apos; then [% Replaced from sent (copy)_2010505394410823689]&#10;ELSEIF [Parameters].[Timeline metric (copy)_2010505394417131534] = &apos;5&apos; then [CVR1 - Eligible to initiated replacement (copy)_2010505394403991552]&#10;ELSEIF [Parameters].[Timeline metric (copy)_2010505394417131534] = &apos;6&apos; then [CVR2 - Initiated replacement to sent (copy)_2010505394404290561]&#10;//ELSEIF [Timeline metric] = &apos;7&apos; then [CVR3 - Sent to Answered]&#10;//ELSEIF [Timeline metric] = &apos;8&apos; then [CVR4 - Answered to replaced]&#10;//ELSEIF [Item Timeline metric] = &apos;9&apos; then [Item CVR3 - Sent to Confirmed (GIR 2)]&#10;ELSEIF [Parameters].[Timeline metric (copy)_2010505394417131534] = &apos;9&apos; then [CVR3 - Sent to Confirmed (plus talabat) (copy)_2010505394405126147]&#10;ELSEIF [Parameters].[Timeline metric (copy)_2010505394417131534] = &apos;10&apos; then [Item CVR4 - Confirmed to replaced (copy)_769200749606723585]&#10;ELSEIF [Parameters].[Timeline metric (copy)_2010505394417131534] = &apos;11&apos; then [% Confirmation Rate backend only (copy)_2010505394411159563]&#10;ELSEIF [Parameters].[Timeline metric (copy)_2010505394417131534] = &apos;12&apos; then [% Rejection Rate backend only (copy)_2010505394411270156]&#10;ELSEIF [Parameters].[Timeline metric (copy)_2010505394417131534] = &apos;13&apos; then [% Expiration Rate backend only (copy)_2010505394411638797]&#10;ELSEIF [Parameters].[Timeline metric (copy)_2010505394417131534] = &apos;14&apos; then [Item % Replaced from eligible (copy)_6507419991450529795]&#10;ELSEIF [Parameters].[Timeline metric (copy)_2010505394417131534] = &apos;15&apos; then [Item % Replaced from eligible +Add Products (copy)_6507419991450976260]&#10;ELSEIF [Parameters].[Timeline metric (copy)_2010505394417131534] = &apos;16&apos; then [Avg Order Items (copy)_2578873743273709568]&#10;ELSEIF [Parameters].[Timeline metric (copy)_2010505394417131534] = &apos;17&apos; then [Item % Rejection Rate backend only (copy)_951033586048462850]&#10;ELSEIF [Parameters].[Timeline metric (copy)_2010505394417131534] = &apos;18&apos; then [Calculation_2538833970026364928]&#10;ELSEIF [Parameters].[Timeline metric (copy)_2010505394417131534] = &apos;19&apos; then [Calculation_5351894887910461441]&#10;ELSEIF [Parameters].[Timeline metric (copy)_2010505394417131534] = &apos;20&apos; then [$ Replacements GMV (copy)_5351894887975436290]&#10;ELSEIF [Parameters].[Timeline metric (copy)_2010505394417131534] = &apos;21&apos; then [$ GMV Replacements + Added directly (copy)_5351894887976640516]&#10;END' />
            </column>
