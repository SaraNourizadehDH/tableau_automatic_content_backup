      <column caption='MOCK eligible items' datatype='real' name='[Item # Replaced GIR 1 (copy)_4375950729594314752]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;  IF ([be_customer_sent] = 0 OR ISNULL([be_customer_sent]))&#10;     AND [replacement_flow_talabat_inapp_flag] = 0&#10;  THEN [eligible_replacement_items]&#10;  ELSE 0&#10;  END&#10;)' />
      </column>
      <column caption='Order # Replaced others' datatype='integer' name='[Item # Replaced others (copy)_835065903728214016]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([elg_pelican_replacement_orders]) - [elg_pelican_replacement_orders_gir1&amp;2 (copy)_263108790774509577]- [# Replaced GIR 1 (copy)_263108790774849546]' />
      </column>
      <column caption='Order % Add Products from eligible' datatype='real' default-format='p0.0%' name='[Item % Add Products from eligible (copy)_273030743618002946]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//sum([Pelican Replacements Orders]) / sum([partial_orders_old] + [Failed Due To Oos])&#10;&#10;//New definition&#10;sum([replacement_flow_new_product_added_flag]) / SUM([orders_eligible_for_replacement])&#10;//[Eligible orders for replacement Old]' />
      </column>
      <column caption='Item % Add Products from eligible (growth)' datatype='real' default-format='p0.0%' name='[Item % Add Products from eligible (copy)_5446048230439940105]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//sum([Pelican Replacements Orders]) / sum([partial_orders_old] + [Failed Due To Oos])&#10;&#10;//New definition&#10;sum([replacement_flow_new_product_added_item_qty_sold_total]) / SUM([eligible_replacement_items])/&#10;LOOKUP(sum([replacement_flow_new_product_added_item_qty_sold_total]) / SUM([eligible_replacement_items])&#10;,1)&#10;-1&#10;//[Eligible orders for replacement Old]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Item % Confirmed not selected rate' datatype='real' default-format='p0.0%' name='[Item % Rejection Rate backend only (copy)_951033586048462850]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([be_customer_confirmed_not_selected])/SUM([be_customer_sent])' />
      </column>
      <column caption='Item % Replaced from eligible (no partial ff or oos)' datatype='real' default-format='p0.0%' name='[Item % Replaced from eligible (copy)_2416603422408708099]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//sum([Pelican Replacements Orders]) / sum([partial_orders_old] + [Failed Due To Oos])&#10;&#10;//New definition&#10;sum([replacements_pelican_items_v2]) /[# Items eligible (not found + replaced) (copy)_2416603422408368130]&#10;//[Eligible orders for replacement Old]' />
      </column>
      <column caption='Item % Replaced from eligible (growth)' datatype='real' default-format='p0.0%' name='[Item % Replaced from eligible (copy)_5446048230420074503]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([replacements_pelican_items_v2]) / SUM([eligible_replacement_items])&#10;/&#10;LOOKUP(sum([replacements_pelican_items_v2]) / SUM([eligible_replacement_items]),1)&#10;-1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Item % Replaced+Add Products from eligible ' datatype='real' default-format='p0.0%' name='[Item % Replaced from eligible (copy)_6507419991450529795]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//sum([Pelican Replacements Orders]) / sum([partial_orders_old] + [Failed Due To Oos])&#10;&#10;//New definition&#10;sum([replacements_pelican_items_v2] + [replacement_flow_new_product_added_item_qty_sold_total]) / SUM([eligible_replacement_items])&#10;//[Eligible orders for replacement Old]' />
      </column>
      <column caption='Item % Add Products from eligible' datatype='real' default-format='p0.0%' name='[Item % Replaced from eligible +Add Products (copy)_6507419991450976260]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//sum([Pelican Replacements Orders]) / sum([partial_orders_old] + [Failed Due To Oos])&#10;&#10;//New definition&#10;sum([replacement_flow_new_product_added_item_qty_sold_total]) / SUM([eligible_replacement_items])&#10;//[Eligible orders for replacement Old]' />
      </column>
      <column caption='Item % Replaced+Add Products from eligible  (no pf and OOS)' datatype='real' default-format='p0.0%' name='[Item % Replaced+Add Products from eligible  (copy)_2416603422445359109]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//sum([Pelican Replacements Orders]) / sum([partial_orders_old] + [Failed Due To Oos])&#10;&#10;//New definition&#10;sum([replacements_pelican_items_v2] + [replacement_flow_new_product_added_item_qty_sold_total]) / [# Items eligible (not found + replaced) (copy)_2416603422408368130]&#10;//[Eligible orders for replacement Old]' />
      </column>
      <column caption='Item CVR1 - Eligible to initiated replacement (growth)' datatype='real' default-format='p0.0%' name='[Item CVR1 - Eligible to initiated replacement (copy)_5446048230415167491]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([be_replacement_suggestion_qty])/SUM([eligible_replacement_items])&#10;/&#10;LOOKUP(SUM([be_replacement_suggestion_qty])/SUM([eligible_replacement_items]),1)&#10;&#10;-1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Item CVR2 - Initiated replacement to sent (growth)' datatype='real' default-format='p0.0%' name='[Item CVR2 - Initiated replacement to sent (copy)_5446048230417817604]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN(SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos; THEN [be_customer_sent] END)/&#10;SUM([be_replacement_suggestion_qty]),1)&#10;/&#10;LOOKUP((MIN(SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos; THEN [be_customer_sent] END)/&#10;SUM([be_replacement_suggestion_qty]),1)),1)&#10;-1&#10;//Investigate why over 100% in some cases'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Item Customer Sent (GIR 2)' datatype='real' name='[Item CVR3 - Sent to Confirmed (GIR 2) (copy)_284148997805502464]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos; THEN [be_customer_sent] END)' />
      </column>
      <column caption='Item CVR3 - Sent to Confirmed (GIR 2) (growth)' datatype='real' default-format='p0.0%' name='[Item CVR3 - Sent to Confirmed (GIR 2) (copy)_5446048230419103749]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos; THEN [be_customer_confirmed] END) &#10;/ &#10;SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos; THEN [be_customer_sent] END))&#10;/&#10;LOOKUP(SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos; THEN [be_customer_confirmed] END) &#10;/ &#10;SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos; THEN [be_customer_sent] END),1)&#10;-1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Item CVR3 - Sent to Confirmed (GIR 2)' datatype='real' default-format='p0.0%' name='[Item CVR3 - Sent to Confirmed (plus talabat) (copy)_769200749604261888]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos; THEN [be_customer_confirmed] END) &#10;/ &#10;SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos; THEN [be_customer_sent] END)' />
      </column>
      <column caption='Item CVR4 - Confirmed to replaced (GIR 2) (growth)' datatype='real' default-format='p0.0%' name='[Item CVR4 - Confirmed to replaced (GIR 2) (copy)_5446048230419554310]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos;  THEN ([replacements_pelican_items_only_selected]) END)&#10;/&#10;SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos; THEN ([be_customer_confirmed]) END))&#10;/&#10;LOOKUP(SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos;  THEN ([replacements_pelican_items_only_selected]) END)&#10;/&#10;SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos; THEN ([be_customer_confirmed]) END),1)&#10;-1&#10;&#10;//Considers 100% max once might have miss-attribuition in flow'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Item CVR4 - Confirmed to replaced (GIR 2)' datatype='real' default-format='p0.0%' name='[Item CVR4 - Confirmed to replaced (copy)_769200749606723585]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos;  THEN ([replacements_pelican_items_only_selected]) END)&#10;/&#10;SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos; THEN ([be_customer_confirmed]) END)&#10;//Considers 100% max once might have miss-attribuition in flow' />
      </column>
      <column caption='Replacements GIR2' datatype='real' name='[Item CVR4 - Confirmed to replaced (only GIR 2) (copy)_769200749617393666]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos; AND [be_customer_confirmed]&gt;0 THEN (replacements_pelican_items_v2) END)&#10;&#10;//Considers 100% max once might have miss-attribuition in flow' />
      </column>
      <column caption='# Items eligible (total)' datatype='real' name='[Item Customer Confirmed (GIR 2) (copy)_2416603422407880704]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([eligible_replacement_items])' />
