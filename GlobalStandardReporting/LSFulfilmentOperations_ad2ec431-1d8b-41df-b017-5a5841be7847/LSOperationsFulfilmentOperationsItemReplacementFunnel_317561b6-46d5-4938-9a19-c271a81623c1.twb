      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontname='Tableau Medium' fontsize='12'>CVR 3 - Sent to confirmed items (growth)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='ls_ops_ir_rl' name='federated.1ex1aqh01b3tvm1enjguy0hjrfl2' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Monthly' caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
              <aliases>
                <alias key='&quot;Day&quot;' value='Daily' />
                <alias key='&quot;Month&quot;' value='Monthly' />
                <alias key='&quot;Quarter&quot;' value='Quarterly' />
                <alias key='&quot;Week&quot;' value='Weekly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ex1aqh01b3tvm1enjguy0hjrfl2'>
            <column caption='Refresh rule' datatype='boolean' name='[Calculation_1038783420879003652]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[local_date] &lt;= {MAX([local_date])} - 2' />
            </column>
            <column caption='concat_chain_country' datatype='string' name='[Calculation_167477668810276865]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[chain_name]+&quot; (&quot;+[country]+&quot;)&quot;' />
            </column>
            <column caption='concat_entity_country' datatype='string' name='[Calculation_167477668842803202]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;(&quot;+[management_entity]+&quot;) &quot; + [country]' />
            </column>
            <column caption='Pelican Replacement L30 Flag Boolean' datatype='boolean' name='[Calculation_2459950625618546688]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [pelican_replacement_l30_flag] = 1 then TRUE else FALSE end' />
            </column>
            <column caption='Dynamic Date' datatype='date' name='[Calculation_3571213798266298371]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 1] &#10;WHEN &apos;Day&apos; THEN DATETRUNC(&apos;day&apos;, [local_date],&apos;Monday&apos;) &#10;WHEN &apos;Week&apos; THEN DATETRUNC(&apos;week&apos;, [local_date],&apos;Monday&apos;)&#10;WHEN &apos;Month&apos; THEN DATETRUNC(&apos;month&apos;, [local_date],&apos;Monday&apos;)  &#10;WHEN &apos;Quarter&apos; THEN DATETRUNC(&apos;quarter&apos;, [local_date],&apos;Monday&apos;) &#10;END)' />
            </column>
            <column caption='pelican_replacement_l30_flag_cf' datatype='string' name='[Calculation_4113123466683564033]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [pelican_replacement_l30_flag] &gt; 0 then &apos;Yes&apos; else &apos;No&apos; end' />
            </column>
            <column caption='Replacement Flow Gir1&amp;2' datatype='string' name='[Calculation_5697757283087187968]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//IF replacement_flow_gir_ph1_flag &gt; 0 then &apos;GIR-Phase1&apos; &#10;//ELSEIF replacement_flow_talabat_inapp_flag &gt; 0 then &apos;Talabat-inapp&apos; &#10;//ELSEIF replacement_flow_new_product_added_flag &gt; 0 then &apos;New-Product-Added&apos; &#10;//ELSEIF replacement_flow_custom_flow_replaced_flag &gt; 0 then &apos;Custom-Flow&apos; &#10;//ELSEIF replacement_flow_gir_ph2_flag &gt; 0 then &apos;GIR-Phase2&apos;&#10;//ELSE &apos;Others&apos;&#10;//END&#10;&#10;//If [Replacement Flow All] = &apos;GIR-Phase1&apos; then &apos;GIR-Phase1&apos;&#10;//ELSEIF [Replacement Flow All] = &apos;GIR-Phase2&apos; then &apos;GIR-Phase2&apos;&#10;//END&#10;&#10;If be_customer_sent&gt;0 then &apos;GIR-Phase2&apos;&#10;ELSEIf [Replacement Flow Gir1&amp;2 (copy)_6601854909039779842] = &apos;GIR-Phase1&apos; then &apos;GIR-Phase1&apos;&#10;END' />
            </column>
            <column caption='Dynamic Date STR' datatype='string' name='[Dynamic Date (copy)_3541307062713298949]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(DATE(CASE [Parameters].[Parameter 1] &#10;WHEN &apos;Day&apos; THEN DATETRUNC(&apos;day&apos;, [local_date],&apos;Monday&apos;) &#10;WHEN &apos;Week&apos; THEN DATETRUNC(&apos;week&apos;, [local_date],&apos;Monday&apos;)&#10;WHEN &apos;Month&apos; THEN DATETRUNC(&apos;month&apos;, [local_date],&apos;Monday&apos;)  &#10;WHEN &apos;Quarter&apos; THEN DATETRUNC(&apos;quarter&apos;, [local_date],&apos;Monday&apos;) &#10;END))' />
            </column>
            <column caption='Item CVR3 - Sent to Confirmed (GIR 2) (growth)' datatype='real' default-format='p0.0%' name='[Item CVR3 - Sent to Confirmed (GIR 2) (copy)_5446048230419103749]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos; THEN [be_customer_confirmed] END) &#10;/ &#10;SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos; THEN [be_customer_sent] END))&#10;/&#10;LOOKUP(SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos; THEN [be_customer_confirmed] END) &#10;/ &#10;SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos; THEN [be_customer_sent] END),1)&#10;-1'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='# Items eligible (total)' datatype='real' name='[Item Customer Confirmed (GIR 2) (copy)_2416603422407880704]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([eligible_replacement_items])' />
            </column>
            <column caption='Replacement Flow All' datatype='string' name='[Replacement Flow Gir1&amp;2 (copy)_6601854909039779842]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF replacement_flow_gir_ph1_flag &gt; 0 then &apos;GIR-Phase1&apos;&#10;ELSEIF replacement_flow_gir_ph2_flag &gt; 0 then &apos;GIR-Phase2&apos;&#10;//ELSEIF replacement_flow_talabat_inapp_flag &gt; 0 then &apos;Talabat-inapp&apos;&#10;ELSEIF replacement_flow_talabat_inapp_flag &gt; 0 then &apos;GIR-Phase2&apos;&#10;ELSEIF replacement_flow_new_product_added_flag &gt; 0 then &apos;New-Product-Added&apos;&#10;//ELSEIF replacement_flow_custom_flow_replaced_flag &gt; 0 then &apos;Custom-Flow&apos; DEPRECATED&#10;ELSE &apos;Others&apos;&#10;END' />
            </column>
