        <calculation class='tableau' formula='SUM(&#10;  IF ([be_customer_sent] &gt; 0 )&#10;     AND [replacement_flow_talabat_inapp_flag] = 0&#10;  THEN [oos_failed_pelican_items]&#10;  ELSE 0&#10;  END&#10;)&#10;&#10;/SUM(&#10;  IF ([be_customer_sent] &gt; 0 )&#10;     AND [replacement_flow_talabat_inapp_flag] = 0&#10;  THEN [eligible_replacement_items]&#10;  ELSE 0&#10;  END&#10;)' />
      </column>
      <column caption='MoM %Eligible Items from total ordered' datatype='real' default-format='p0.0%' name='[MoM #Eligible Items for Replacement (copy)_3541307062712279043]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([eligible_replacement_items])/sum(if [Vendor_App] = &apos;pelican&apos; then [qty_ordered] else 0 end) / LOOKUP(SUM([eligible_replacement_items])/sum(if [Vendor_App] = &apos;pelican&apos; then [qty_ordered] else 0 end) ,-1) -1'>
          <table-calc ordering-type='Rows' />
