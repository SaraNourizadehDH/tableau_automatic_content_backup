      <aliases enabled='yes' />
      <column caption='# Items eligible (not found + replaced)' datatype='real' name='[# Items eligible (not found + replaced) (copy)_2416603422408368130]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([items_eligible_for_replacement_new_definition])' />
      </column>
      <column caption='# Orders eligible (not found + replaced)' datatype='integer' name='[# Items eligible (not found + replaced) (copy)_3726236131321729030]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([order_eligible_for_replacement_new_definition])' />
      </column>
      <column caption='# Items eligible (total) (copy)' datatype='real' name='[# Items eligible (total) (copy)_1603281492348948485]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([eligible_replacement_items])' />
      </column>
      <column caption='# Replaced GIR 2' datatype='integer' name='[# Replaced GIR 1 (copy)_263108790774849546]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if([be_customer_sent] &gt; 0   )&#10;&#10; then [elg_pelican_replacement_orders] else 0 end)' />
      </column>
      <column caption='Item # Replaced GIR 1' datatype='real' name='[# Replaced GIR 1 (copy)_6507419991449112577]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if (([be_customer_sent] = 0 OR ISNULL([be_customer_sent]) AND [replacement_flow_talabat_inapp_flag] =0)  )&#10;&#10; then replacements_pelican_items_v2 else 0 end)' />
      </column>
      <column caption='# Replaced custom flow (deprecated)' datatype='boolean' name='[# Replaced GIR 2 (copy)_263108790776610829]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//sum(if replacement_flow_custom_flow_replaced_flag &gt; 0 then &#10;//  [elg_pelican_replacement_orders] else 0 end)&#10;&#10;NULL' />
      </column>
      <column caption='Item # Replaced GIR 2 (deprecated)' datatype='real' name='[# Replaced GIR 2 (copy)_6507419991449497602]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if be_customer_sent &gt; 0 THEN [replacements_pelican_items_v2] ELSE 0 END)' />
      </column>
      <column caption='Item # Replaced others' datatype='real' name='[# Replaced others Flow (copy)_263108790797586449]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([replacements_pelican_items_v2]) - [# Replaced GIR 1 (copy)_6507419991449112577]- [Item Customer Sent (GIR 2) (copy)_284148997812977668]' />
      </column>
      <column caption='$ GMV Replacements (growth)' datatype='real' default-format='p0.0%' name='[$ GMV Replacements (copy)_5446048230421213192]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([replacements_pelican_total_price_eur])/&#10;LOOKUP(SUM([replacements_pelican_total_price_eur]),1)&#10;-1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% GMV Replacements + Added directly from Eligible' datatype='real' default-format='p0.0%' name='[$ GMV Replacements + Added directly (copy)_5351894887976640516]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([replacements_pelican_total_price_eur])+SUM([gmv_added_directly]))/SUM([gmv_eligible_for_replacement])' />
      </column>
      <column caption='$ GMV Eligible for Replacement' datatype='real' default-format='c&quot;€&quot;#,##0;-&quot;€&quot;#,##0' name='[$ Replacements GMV (copy)_5351894887910281216]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gmv_eligible_for_replacement])' />
      </column>
      <column caption='$ GMV Added directly' datatype='real' default-format='c&quot;€&quot;#,##0;-&quot;€&quot;#,##0' name='[$ Replacements GMV (copy)_5351894887975436290]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gmv_added_directly])' />
      </column>
      <column caption='$ GMV Replacements + Added directly' datatype='real' default-format='c&quot;€&quot;#,##0;-&quot;€&quot;#,##0' name='[$ Replacements GMV (copy)_5351894887976157187]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([replacements_pelican_total_price_eur])+SUM([gmv_added_directly])' />
      </column>
      <column caption='% Rejection Rate backend only' datatype='real' default-format='p0.0%' name='[% Confirmation Rate backend only (copy) (copy)_763852778179452931]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos; THEN [rejected_answer_backend_eligible_for_replacement] END) &#10;/&#10;SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos; THEN replacement_sent_eligible_for_replacement_v2 END)' />
      </column>
      <column caption='Item % Confirmation Rate backend only' datatype='real' default-format='p0.0%' name='[% Confirmation Rate backend only (copy)_2010505394411159563]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos; THEN [be_customer_confirmed] END) &#10;/ &#10;SUM(IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos; THEN [be_customer_sent] END)' />
      </column>
