                  <run bold='true' fontcolor='#000000' fontname='Tableau Light'>Def:</run>
                  <run fontcolor='#000000' fontname='Tableau Light'> Total number of confirmed order/item from pelican platform only</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
