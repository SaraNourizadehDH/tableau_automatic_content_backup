                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2400' id='198' type-v2='text' w='72637' x='26636' y='17422'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Light'>Def:</run>
                    <run fontcolor='#000000' fontname='Tableau Light'>  The OOS GMV loss refers to the total Gross Merchandise Value (GMV) lost due to orders that are either partially fulfilled or unable to be fulfilled because the items are out of stock (OOS). </run>
                    <run>Æ&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#f5f5f5' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2267' id='199' type-v2='text' w='25909' x='727' y='19822'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontsize='12'>(%)OOS fail rate</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2267' id='200' type-v2='text' w='72637' x='26636' y='19822'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000'>Def:</run>
                    <run fontcolor='#000000'>Æ </run>
                    <run fontcolor='#000000' fontname='Tableau Light'>Percentage of orders that fail due to vendor Out of Stock (OOS) issues, calculated by dividing the total number of failed orders caused by vendor OOS by the total number of orders placed.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2311' id='298' type-v2='text' w='25909' x='727' y='22089'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontsize='12'>(%)PF Rate(New)</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#f5f5f5' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2311' id='299' type-v2='text' w='72637' x='26636' y='22089'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000'>Def:</run>
                    <run fontcolor='#000000'>Æ </run>
                    <run fontcolor='#000000' fontname='Tableau Light'>This rate is calculated by dividing the total number of partially fulfilled orders with replacement by the overall number of confirmed pelican orders</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#f5f5f5' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2489' id='300' type-v2='text' w='25909' x='727' y='24400'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontsize='12'>(%)PF Rate(Old)</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#ffffff' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2489' id='301' type-v2='text' w='72637' x='26636' y='24400'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000'>Def:</run>
                    <run fontcolor='#000000'>Æ </run>
                    <run fontcolor='#000000' fontname='Tableau Light'>This rate is calculated by dividing the total number of partially fulfilled orders without replacement by the overall number of confirmed pelican orders</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#ffffff' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2533' id='203' type-v2='text' w='25909' x='727' y='26889'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontsize='12'>Avg Order Items</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#f5f5f5' />
