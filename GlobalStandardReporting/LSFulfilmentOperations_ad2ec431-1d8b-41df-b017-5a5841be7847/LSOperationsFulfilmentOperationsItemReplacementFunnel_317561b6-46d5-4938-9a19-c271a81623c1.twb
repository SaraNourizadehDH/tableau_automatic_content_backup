        <calculation class='tableau' formula='SUM(&#10;  IF ([be_customer_sent] = 0 OR ISNULL([be_customer_sent]))&#10;     AND [replacement_flow_talabat_inapp_flag] = 0&#10;  THEN [item_not_found_qty]&#10;  ELSE 0&#10;  END&#10;)/ SUM([eligible_replacement_items])' />
      </column>
