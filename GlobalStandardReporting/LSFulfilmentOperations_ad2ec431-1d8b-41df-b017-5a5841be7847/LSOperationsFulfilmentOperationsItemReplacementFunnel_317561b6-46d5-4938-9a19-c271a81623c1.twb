            <column-instance column='[vendor_name]' derivation='None' name='[none:vendor_name:nk]' pivot='key' type='nominal' />
            <column caption='Pelican Confirmed Orders' datatype='integer' name='[pelican_confirmed_orders]' role='measure' type='quantitative' />
            <column datatype='integer' name='[pelican_replacement_l30_flag]' role='measure' type='quantitative' />
            <column caption='Qty Ordered' datatype='real' name='[qty_ordered]' role='measure' type='quantitative' />
            <column caption='Region' datatype='string' name='[region]' role='dimension' type='nominal' />
            <column datatype='integer' name='[replacement_flow_gir_ph1_flag]' role='measure' type='quantitative' />
