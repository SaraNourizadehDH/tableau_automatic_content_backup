            <column caption='Item % Replaced from eligible (growth)' datatype='real' default-format='p0.0%' name='[Item % Replaced from eligible (copy)_5446048230420074503]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([replacements_pelican_items_v2]) / SUM([eligible_replacement_items])&#10;/&#10;LOOKUP(sum([replacements_pelican_items_v2]) / SUM([eligible_replacement_items]),1)&#10;-1'>
