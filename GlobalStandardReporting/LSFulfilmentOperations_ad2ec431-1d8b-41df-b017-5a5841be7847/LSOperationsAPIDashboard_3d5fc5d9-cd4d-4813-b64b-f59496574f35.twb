    <worksheet name='Score - Country'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Tableau Bold' fontsize='14'>&lt;</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Bold' fontsize='14'>[Parameters].[Parameter 6]</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Bold' fontsize='14'>&gt; by Country</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Main View' name='federated.15w313a16lxy7n1dyvkx90hmistu' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Show Vendors WO SFTP Jobs' datatype='boolean' name='[Deep Dive Metric (copy)]' param-domain-type='list' role='measure' type='nominal' value='false'>
              <calculation class='tableau' formula='false' />
            </column>
            <column alias='Yes' caption='Do you want to see the actual (last) period' datatype='boolean' name='[How many periods do you want to see (copy)]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
              <aliases>
                <alias key='false' value='No' />
                <alias key='true' value='Yes' />
              </aliases>
            </column>
            <column alias='Chain Name without Id (Curated data)' caption='Chain Name' datatype='string' name='[In / Out (copy 2)]' param-domain-type='list' role='measure' type='nominal' value='&quot;1&quot;'>
              <calculation class='tableau' formula='&quot;1&quot;' />
              <aliases>
                <alias key='&quot;1&quot;' value='Chain Name without Id (Curated data)' />
                <alias key='&quot;2&quot;' value='Chain Name with Id (Non-curated data)' />
              </aliases>
            </column>
            <column alias='Any Vendor with API Jobs' caption='API Jobs to See' datatype='string' name='[Parameter 12]' param-domain-type='list' role='measure' type='nominal' value='&quot;1&quot;'>
              <calculation class='tableau' formula='&quot;1&quot;' />
              <aliases>
                <alias key='&quot;1&quot;' value='Any Vendor with API Jobs' />
                <alias key='&quot;2&quot;' value='Any Vendor with API Jobs that Updates Stock' />
                <alias key='&quot;3&quot;' value='Any Vendor with API Jobs that Updates Prices' />
              </aliases>
            </column>
            <column caption='Vendor IDs Filter' datatype='string' name='[Parameter 1]' param-domain-type='any' role='measure' type='nominal' value='&quot;&quot;'>
              <calculation class='tableau' formula='&quot;&quot;' />
            </column>
            <column alias='In' caption='In / Out' datatype='boolean' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
              <aliases>
                <alias key='false' value='Out' />
                <alias key='true' value='In' />
              </aliases>
            </column>
            <column caption='Cards Period 1' datatype='integer' name='[Parameter 5]' param-domain-type='any' role='measure' type='quantitative' value='2'>
              <calculation class='tableau' formula='2' />
            </column>
            <column alias='# API Jobs' caption='Metrics Cards' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;2&quot;'>
              <calculation class='tableau' formula='&quot;2&quot;' />
              <aliases>
                <alias key='&quot;1&quot;' value='$ GMV Net' />
                <alias key='&quot;10&quot;' value='% Items Stock Updates through API' />
                <alias key='&quot;11&quot;' value='% of Processed Items through API' />
                <alias key='&quot;12&quot;' value='% of Failed Items through API' />
                <alias key='&quot;13&quot;' value='% of Unchanged Items through API' />
                <alias key='&quot;14&quot;' value='% of Not Processed Items through API' />
                <alias key='&quot;15&quot;' value='# API Vendors' />
                <alias key='&quot;16&quot;' value='# Items Stock Updates through API' />
                <alias key='&quot;2&quot;' value='# API Jobs' />
                <alias key='&quot;3&quot;' value='# Every How Many Days Vendors Updates API' />
                <alias key='&quot;4&quot;' value='# Average Num. of API Updates per Day' />
                <alias key='&quot;5&quot;' value='% Not Delivered' />
                <alias key='&quot;6&quot;' value='% OOS Fail Rate' />
                <alias key='&quot;7&quot;' value='% Ratio API Updates vs Total Assortment' />
                <alias key='&quot;8&quot;' value='% API Vendors' />
                <alias key='&quot;9&quot;' value='% API Jobs with Stock Updates' />
              </aliases>
            </column>
            <column caption='How many periods do you want to see' datatype='integer' name='[Replaced Pelican Items Parameter]' param-domain-type='any' role='measure' type='quantitative' value='7'>
              <calculation class='tableau' formula='7' />
            </column>
            <column caption='Chain IDs Filter' datatype='string' name='[Vendors List to Filter (copy)_3194529905697562660]' param-domain-type='any' role='measure' type='nominal' value='&quot;&quot;'>
              <calculation class='tableau' formula='&quot;&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.15w313a16lxy7n1dyvkx90hmistu'>
            <column caption='               % of Items with Stock Changed' datatype='real' default-format='p0.0%' name='[          % of Changed Products (copy)_262686577375961122]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([nr_updated_stock_count_products_completed]) / SUM([nr_changed_products_completed])' />
            </column>
            <column caption='               % of Unchanged Items' datatype='real' default-format='p0.0%' name='[          % of Failed Items (copy)_262686577379766312]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([nr_total_count_completed]) - SUM([nr_processed_products_completed]) &#10;- SUM([nr_failed_count_completed]))&#10;/ SUM([nr_total_count_completed])' />
            </column>
            <column caption='          % of Processed Items' datatype='real' default-format='p0.0%' name='[          % of Jobs with New Items Updates (copy)_262686577379205158]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([nr_processed_products_completed]) / SUM([nr_total_count_completed])' />
            </column>
            <column caption='               % of Failed Items' datatype='real' default-format='p0.0%' name='[          % of Processed Items (copy)_262686577379475495]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([nr_failed_count_completed]) / SUM([nr_total_count_completed])' />
            </column>
            <column caption='          % of Not Processed Items' datatype='real' default-format='p0.0%' name='[          % of Processed Items (copy)_262686577705320495]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([          % of Processed Items (copy)_262686577379475495] + [          % of Failed Items (copy)_262686577379766312])' />
            </column>
            <column caption='          % of SFTP Jobs with Stock Updates' datatype='real' default-format='p0.0%' name='[          Nr Jobs New Product Completed (copy)_262686577296982041]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([nr_jobs_updated_product_completed]) / SUM([nr_jobs_completed])' />
            </column>
            <column caption='% OOS Failed Orders' datatype='real' default-format='p0.00%' name='[% Partial Fulfilled Items (copy)_1860831095852757033]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([oos_failed_pelican_orders]) / SUM([total_orders])' />
            </column>
            <column caption='% SFTP Vendors' datatype='real' default-format='p0.0%' name='[% SFTP Vendors (card) (copy)_161707402988531715]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;IF [gmv_net_eur] &gt; 0 AND [Calculation_262686577636798505] &gt; 0  THEN&#10;    [vendor_id]&#10;    ELSE NULL&#10;END&#10;) / &#10;COUNTD(&#10;IF [gmv_net_eur] &gt; 0 THEN&#10;    [vendor_id]&#10;    ELSE NULL&#10;END&#10;)' />
            </column>
            <column caption='Ov. Avg. num. of Updates per Day' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg. num. of Updates per Day (copy 2)_4140004383230488581]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 12]&#10;&#10;WHEN &quot;1&quot; THEN&#10;&#10;    SUM(&#10;    IF [gmv_net_eur] &gt; 0 AND [avg_number_of_updates_per_day] &gt; 0 THEN&#10;        [avg_number_of_updates_per_day] * [gmv_net_eur]&#10;        ELSE NULL&#10;    END&#10;    ) / &#10;    SUM(&#10;    IF [gmv_net_eur] &gt; 0 AND [avg_number_of_updates_per_day] &gt; 0 THEN&#10;       [gmv_net_eur]&#10;        ELSE NULL&#10;    END&#10;    )&#10;&#10;WHEN &quot;2&quot; THEN&#10;&#10;    SUM(&#10;    IF [gmv_net_eur] &gt; 0 AND [avg_number_of_updates_stock_per_day] &gt; 0 THEN&#10;        [avg_number_of_updates_stock_per_day] * [gmv_net_eur]&#10;        ELSE NULL&#10;    END&#10;    ) / &#10;    SUM(&#10;    IF [gmv_net_eur] &gt; 0 AND [avg_number_of_updates_stock_per_day] &gt; 0 THEN&#10;       [gmv_net_eur]&#10;        ELSE NULL&#10;    END&#10;    )&#10;&#10;WHEN &quot;3&quot; THEN&#10;&#10;    SUM(&#10;    IF [gmv_net_eur] &gt; 0 AND [avg_number_of_updates_price_per_day] &gt; 0 THEN&#10;        [avg_number_of_updates_price_per_day] * [gmv_net_eur]&#10;        ELSE NULL&#10;    END&#10;    ) / &#10;    SUM(&#10;    IF [gmv_net_eur] &gt; 0 AND [avg_number_of_updates_price_per_day] &gt; 0 THEN&#10;       [gmv_net_eur]&#10;        ELSE NULL&#10;    END&#10;    )&#10;&#10;ELSE NULL&#10;&#10;END' />
            </column>
            <column caption='Metrics Cards' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1278529740269060131]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;    WHEN  &apos;1&apos; THEN ROUND(SUM([gmv_net_eur]) / 1000, 2)&#10;    WHEN  &apos;2&apos; THEN ROUND(SUM([Calculation_262686577636798505]) / 1000, 2)&#10;    WHEN  &apos;3&apos; THEN [Every how many days Vendors update their stock (copy 2)_4140004383225536515]&#10;    WHEN  &apos;4&apos; THEN [Avg. num. of Updates per Day (copy 2)_4140004383230488581]&#10;    WHEN  &apos;5&apos; THEN [Calculation_1860831095894679597] * 100&#10;    WHEN  &apos;6&apos; THEN [% Partial Fulfilled Items (copy)_1860831095852757033] * 100&#10;    WHEN  &apos;7&apos; THEN [Ratio # updates items vs total assortment (copy 2)_4140004383234433030] * 100&#10;    WHEN  &apos;8&apos; THEN [% SFTP Vendors (card) (copy)_161707402988531715] * 100&#10;    WHEN  &apos;9&apos; THEN [          Nr Jobs New Product Completed (copy)_262686577296982041] * 100&#10;    WHEN  &apos;10&apos; THEN [          % of Changed Products (copy)_262686577375961122] * 100&#10;    WHEN  &apos;11&apos; THEN [          % of Jobs with New Items Updates (copy)_262686577379205158] * 100&#10;    WHEN  &apos;12&apos; THEN [          % of Processed Items (copy)_262686577379475495] * 100&#10;    WHEN  &apos;13&apos; THEN [          % of Failed Items (copy)_262686577379766312] * 100&#10;    WHEN  &apos;14&apos; THEN [          % of Processed Items (copy)_262686577705320495] * 100&#10;    WHEN  &apos;15&apos; THEN COUNTD(IF [gmv_net_eur] &gt; 0 AND [Calculation_262686577636798505] &gt; 0  THEN [vendor_id] ELSE NULL END)&#10;    WHEN  &apos;16&apos; THEN SUM([nr_updated_stock_count_products]) / 1000&#10;    WHEN  &apos;17&apos; THEN ROUND(SUM([nr_jobs_updated_product_completed]) / 1000, 2)&#10;END' />
            </column>
            <column caption='Selected Period' datatype='boolean' name='[Calculation_1278529740277645362]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = MAX([period_num]) THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Filter Outliers (card)' datatype='boolean' name='[Calculation_1278529741041209407]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = &apos;8&apos; THEN TRUE ELSE&#10;&#10;    CASE [granularity]&#10;    &#10;        WHEN &apos;daily&apos; THEN&#10;&#10;            IF [confirmed_orders] &gt; 1 THEN&#10;                IF [Calculation_262686577636798505] &lt;= 3  THEN&#10;                    IF [gmv_net_eur] / [Calculation_262686577636798505] &lt; 100 THEN TRUE ELSE FALSE END&#10;                ELSE TRUE END&#10;            ELSE TRUE END&#10;    &#10;        WHEN &apos;weekly&apos; THEN&#10;&#10;            IF [confirmed_orders] &gt; 1 THEN&#10;                IF [Calculation_262686577636798505] &lt;= 3  THEN&#10;                    IF [gmv_net_eur] / [Calculation_262686577636798505] &lt; 100 THEN TRUE ELSE FALSE END&#10;                ELSE TRUE END&#10;            ELSE TRUE END&#10;&#10;        WHEN &apos;monthly&apos; THEN&#10;&#10;            IF [confirmed_orders] &gt; 1 THEN&#10;                IF [Calculation_262686577636798505] &lt;= 15  THEN&#10;                    IF [gmv_net_eur] / [Calculation_262686577636798505] &lt; 700 THEN TRUE ELSE FALSE END&#10;                ELSE TRUE END&#10;            ELSE TRUE END&#10;&#10;        WHEN &apos;quarterly&apos; THEN&#10;&#10;            IF [confirmed_orders] &gt; 1 THEN&#10;                IF [Calculation_262686577636798505] &lt;= 30  THEN&#10;                    IF [gmv_net_eur] / [Calculation_262686577636798505] &lt; 1400 THEN TRUE ELSE FALSE END&#10;                ELSE TRUE END&#10;            ELSE TRUE END&#10;&#10;    END&#10;END' />
            </column>
            <column caption='Local Date ' datatype='string' name='[Calculation_1860831094529859592]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [granularity]&#10;    WHEN &apos;daily&apos; THEN RIGHT(STR(DATE([local_date])),5) + &quot;  &quot; + LEFT(DATENAME(&apos;weekday&apos;, [local_date]), 3)&#10;    WHEN &apos;weekly&apos; THEN RIGHT(STR(DATE(DATETRUNC(&apos;week&apos;,[local_date], &apos;monday&apos;))),8)&#10;    WHEN &apos;monthly&apos; THEN LEFT(RIGHT(STR(DATE(DATETRUNC(&apos;month&apos;,[local_date]))),8), 5)&#10;    WHEN &apos;quarterly&apos; THEN LEFT(RIGHT(STR(DATE(DATETRUNC(&apos;quarter&apos;,[local_date]))),8), 5)&#10;END' />
            </column>
            <column caption='Period Filter' datatype='boolean' name='[Calculation_1860831095232335902]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [period_num] &lt;= [Parameters].[Replaced Pelican Items Parameter] + 1 &#10;THEN &#10;    IF [Parameters].[How many periods do you want to see (copy)] &#10;    THEN &#10;        IF [period_num] &lt;= [Parameters].[Replaced Pelican Items Parameter] &#10;        THEN TRUE &#10;        ELSE FALSE &#10;        END &#10;    ELSE &#10;        IF [period_num] &gt; 1 &#10;        THEN TRUE &#10;        ELSE FALSE &#10;        END&#10;    END &#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='% Not Delivered' datatype='real' default-format='p0.00%' name='[Calculation_1860831095894679597]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([confirmed_orders_pelican]) &gt; 0 THEN&#10;SUM(&#10;    ([in_cart_pelican_items] - [in_cart_pelican_items_sold])     &#10;    + [not_found_pelican_items] &#10;    + ([replaced_pelican_items] - [replaced_pelican_items_sold] - [replacements_pelican_items])&#10;    + [oos_failed_pelican_items]&#10;) / &#10;SUM(&#10;    [in_cart_pelican_items]&#10;    + [not_found_pelican_items] &#10;    + [not_processed_pelican_items] &#10;    + [replaced_pelican_items]&#10;    + [replacements_pelican_items]&#10;    + [oos_failed_pelican_items]&#10;)&#10;ELSE NULL END' />
            </column>
            <column caption='     $ GMV Net Eur' datatype='real' default-format='c#,##0,K&quot; €&quot;;-#,##0,K&quot; €&quot;' name='[Calculation_262686577291255820]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_net_eur])' />
            </column>
            <column caption='SFTP Jobs to see' datatype='integer' name='[Calculation_262686577636798505]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 12]&#10;WHEN &apos;1&apos; THEN [nr_jobs_completed]&#10;WHEN &apos;2&apos; THEN [nr_jobs_updated_product_completed]&#10;WHEN &apos;3&apos; THEN [nr_jobs_updated_price_completed]&#10;WHEN &apos;4&apos; THEN [nr_jobs_new_product_completed]&#10;END' />
            </column>
            <column caption='Vendor Name + id' datatype='string' name='[Calculation_3194529904736956426]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[vendor_id] + &quot; - &quot; +[vendor_name]' />
            </column>
            <column caption='Has Complete Jobs to Update Stock (card)' datatype='boolean' name='[Calculation_3194529905047035928]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = &apos;8&apos; THEN TRUE &#10;ELSEIF [Calculation_262686577636798505] &gt;= 1 THEN TRUE &#10;ELSEIF [Parameters].[Deep Dive Metric (copy)] = TRUE THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='SFTP Type' datatype='string' name='[Calculation_3194529905058963481]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [sftp_type_is_central] THEN &apos;Central SFTP&apos; ELSEIF [sftp_type_is_legacy] THEN &apos;Legacy SFTP&apos; ELSE &apos;Non SFTP&apos; END' />
            </column>
            <column caption='Vendors List to Filter Calc' datatype='boolean' name='[Calculation_3194529905693958179]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] THEN&#10;    IF [Parameters].[Parameter 1] != &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Parameter 1], [vendor_id]) THEN TRUE ELSE FALSE END&#10;        ELSE TRUE&#10;    END&#10;ELSE&#10;    IF [Parameters].[Parameter 1] != &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Parameter 1], [vendor_id]) THEN FALSE ELSE TRUE END&#10;        ELSE TRUE&#10;    END&#10;END' />
            </column>
            <column caption='Chain Name + Country' datatype='string' name='[Calculation_3194529905745088555]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[In / Out (copy 2)]&#10;WHEN &quot;1&quot; THEN [chain_name] + &quot; (&quot; + [country_code] + &quot;)&quot;&#10;ELSE [chain_id] + &quot; - &quot; + [chain_name]&#10;END' />
            </column>
            <column caption='Ov. Every how many days Vendors update their stock' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Every how many days Vendors update their stock (copy 2)_4140004383225536515]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 12]&#10;&#10;WHEN &quot;1&quot; THEN&#10;&#10;    SUM(&#10;    IF [gmv_net_eur] &gt; 0 AND [every_how_many_days_vendors_update_their_sftp] &gt; 0 THEN&#10;        [every_how_many_days_vendors_update_their_sftp] * [gmv_net_eur]&#10;        ELSE NULL&#10;    END&#10;    ) / &#10;    SUM(&#10;    IF [gmv_net_eur] &gt; 0 AND [every_how_many_days_vendors_update_their_sftp] &gt; 0 THEN&#10;       [gmv_net_eur]&#10;        ELSE NULL&#10;    END&#10;    )&#10;&#10;WHEN &quot;2&quot; THEN&#10;&#10;    SUM(&#10;    IF [gmv_net_eur] &gt; 0 AND [every_how_many_days_vendors_update_their_stock] &gt; 0 THEN&#10;        [every_how_many_days_vendors_update_their_stock] * [gmv_net_eur]&#10;        ELSE NULL&#10;    END&#10;    ) / &#10;    SUM(&#10;    IF [gmv_net_eur] &gt; 0 AND [every_how_many_days_vendors_update_their_stock] &gt; 0 THEN&#10;       [gmv_net_eur]&#10;        ELSE NULL&#10;    END&#10;    )&#10;&#10;WHEN &quot;3&quot; THEN&#10;&#10;    SUM(&#10;    IF [gmv_net_eur] &gt; 0 AND [every_how_many_days_vendors_update_their_price] &gt; 0 THEN&#10;        [every_how_many_days_vendors_update_their_price] * [gmv_net_eur]&#10;        ELSE NULL&#10;    END&#10;    ) / &#10;    SUM(&#10;    IF [gmv_net_eur] &gt; 0 AND [every_how_many_days_vendors_update_their_price] &gt; 0 THEN&#10;       [gmv_net_eur]&#10;        ELSE NULL&#10;    END&#10;    )&#10;&#10;ELSE NULL&#10;&#10;END' />
            </column>
            <column caption='Metrics Cards (Symbol)' datatype='string' default-format='n#,##0.00;-#,##0.00' name='[Metrics Cards (copy)_1278529740283846711]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;    WHEN &apos;1&apos; THEN &quot;k&quot;&#10;    WHEN &apos;2&apos; THEN &quot;k&quot;&#10;    WHEN &apos;3&apos; THEN &quot;&quot;&#10;    WHEN &apos;4&apos; THEN &quot;&quot;&#10;    WHEN &apos;5&apos; THEN &quot;%&quot;&#10;    WHEN &apos;6&apos; THEN &quot;%&quot;&#10;    WHEN &apos;7&apos; THEN &quot;%&quot;&#10;    WHEN &apos;8&apos; THEN &quot;%&quot;&#10;    WHEN &apos;9&apos; THEN &quot;%&quot;&#10;    WHEN &apos;10&apos; THEN &quot;%&quot;&#10;    WHEN &apos;11&apos; THEN &quot;%&quot;&#10;    WHEN &apos;12&apos; THEN &quot;%&quot;&#10;    WHEN &apos;13&apos; THEN &quot;%&quot;&#10;    WHEN &apos;14&apos; THEN &quot;%&quot;&#10;    WHEN &apos;16&apos; THEN &quot;k&quot;&#10;    WHEN &apos;17&apos; THEN &quot;k&quot;&#10;END' />
            </column>
            <column caption='Ov. Ratio # updates items vs total assortment' datatype='real' default-format='p0.0%' name='[Ratio # updates items vs total assortment (copy 2)_4140004383234433030]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 12]&#10;&#10;WHEN &quot;1&quot; THEN&#10;&#10;    SUM(&#10;    IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_items_vs_total_assortment] &gt; 0 THEN&#10;        [ratio_num_updates_items_vs_total_assortment] * [gmv_net_eur]&#10;        ELSE NULL&#10;    END&#10;    ) / &#10;    SUM(&#10;    IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_items_vs_total_assortment] &gt; 0 THEN&#10;       [gmv_net_eur]&#10;        ELSE NULL&#10;    END&#10;    )&#10;&#10;WHEN &quot;2&quot; THEN&#10;&#10;    SUM(&#10;    IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_stock_items_vs_total_assortment] &gt; 0 THEN&#10;        [ratio_num_updates_stock_items_vs_total_assortment] * [gmv_net_eur]&#10;        ELSE NULL&#10;    END&#10;    ) / &#10;    SUM(&#10;    IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_stock_items_vs_total_assortment] &gt; 0 THEN&#10;       [gmv_net_eur]&#10;        ELSE NULL&#10;    END&#10;    )&#10;&#10;WHEN &quot;3&quot; THEN&#10;&#10;    SUM(&#10;    IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_price_items_vs_total_assortment] &gt; 0 THEN&#10;        [ratio_num_updates_price_items_vs_total_assortment] * [gmv_net_eur]&#10;        ELSE NULL&#10;    END&#10;    ) / &#10;    SUM(&#10;    IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_price_items_vs_total_assortment] &gt; 0 THEN&#10;       [gmv_net_eur]&#10;        ELSE NULL&#10;    END&#10;    )&#10;&#10;ELSE NULL&#10;&#10;END' />
            </column>
            <column caption='Chain List to Filter Calc' datatype='boolean' name='[Vendors List to Filter Calc (copy)_3194529905697677349]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] THEN&#10;    IF [Parameters].[Vendors List to Filter (copy)_3194529905697562660] != &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Vendors List to Filter (copy)_3194529905697562660], [chain_id]) THEN TRUE ELSE FALSE END&#10;        ELSE TRUE&#10;    END&#10;ELSE&#10;    IF [Parameters].[Vendors List to Filter (copy)_3194529905697562660] != &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Vendors List to Filter (copy)_3194529905697562660], [chain_id]) THEN FALSE ELSE TRUE END&#10;        ELSE TRUE&#10;    END&#10;END' />
