      <column caption='% Not Delivered GMV Loss' datatype='real' default-format='p0.00%' name='[$ Not Found Rate / Items Not Delivered GMV Loss (copy)_3194529905392672801]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([confirmed_orders_pelican]) &gt; 0 THEN &#10;    SUM(&#10;        ([in_cart_pelican_total_price_eur] - [in_cart_pelican_total_price_eur_sold])     &#10;        + [not_found_pelican_total_price_eur]&#10;        + ([replaced_pelican_total_price_eur] - [replaced_pelican_total_price_eur_sold] - [replacements_pelican_total_price_eur])&#10;        + [oos_failed_pelican_orders_items_price_eur]&#10;    ) / &#10;    SUM(&#10;        [gmv_net_eur]&#10;    )&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='% Partial Fulfilled Items' datatype='real' default-format='p0.00%' hidden='true' name='[% Not Found Items (copy)_1860831095851520040]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([in_cart_pelican_items] - [in_cart_pelican_items_sold]) / SUM([in_cart_pelican_items])' />
      </column>
      <column caption='% OOS Failed Orders (card)' datatype='real' default-format='p0.00%' name='[% Not Found Rate / Items Not Delivered (card) (copy)_1278529740261871648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [period_num] = [Parameters].[Parameter 5] THEN [oos_failed_pelican_orders] ELSE NULL END) &#10;/ SUM(IF [period_num] = [Parameters].[Parameter 5] THEN [total_orders] ELSE NULL END)' />
      </column>
      <column caption='$ Not Delivered GMV Loss' datatype='real' default-format='c#,##0,.0K&quot; €&quot;;-#,##0,.0K&quot; €&quot;' name='[% Not Found Rate / Items Not Delivered (copy)_3194529905381822494]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    ([in_cart_pelican_total_price_eur] - [in_cart_pelican_total_price_eur_sold])     &#10;    + [not_found_pelican_total_price_eur]&#10;    + ([replaced_pelican_total_price_eur] - [replaced_pelican_total_price_eur_sold] - [replacements_pelican_total_price_eur])&#10;    + [oos_failed_pelican_orders_items_price_eur]&#10;)' />
      </column>
      <column caption='% OOS Failed Orders - Diff (card)' datatype='real' default-format='n0.00;-0.00' name='[% Not Found Rate / Items Not Delivered - Diff (card) (copy)_1278529740261871649]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(&#10;    (&#10;        SUM(IF [period_num] = [Parameters].[Parameter 5] THEN [oos_failed_pelican_orders] ELSE NULL END) &#10;        / SUM(IF [period_num] = [Parameters].[Parameter 5] THEN [total_orders] ELSE NULL END)&#10;    ) -&#10;    (&#10;        SUM(IF [period_num] = [Parameters].[Cards Period 1 (copy)_1278529740053532683] THEN [oos_failed_pelican_orders] ELSE NULL END) &#10;        / SUM(IF [period_num] = [Parameters].[Cards Period 1 (copy)_1278529740053532683] THEN [total_orders] ELSE NULL END)&#10;    )&#10;) * 100' />
      </column>
      <column caption='% OOS Failed Orders - Diff Icon (card)' datatype='string' default-format='p0.0%' name='[% Not Found Rate / Items Not Delivered - Diff Icon (card) (copy)_1278529740261871650]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [% Not Found Rate / Items Not Delivered - Diff (card) (copy)_1278529740261871649] &gt; 0 THEN &quot;▲&quot; &#10;ELSEIF [% Not Found Rate / Items Not Delivered - Diff (card) (copy)_1278529740261871649] &lt; 0 THEN &quot;▼&quot; &#10;ELSE &quot;●&quot;&#10;END' />
      </column>
      <column caption='% OOS Failed Orders' datatype='real' default-format='p0.00%' name='[% Partial Fulfilled Items (copy)_1860831095852757033]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([oos_failed_pelican_orders]) / SUM([total_orders])' />
