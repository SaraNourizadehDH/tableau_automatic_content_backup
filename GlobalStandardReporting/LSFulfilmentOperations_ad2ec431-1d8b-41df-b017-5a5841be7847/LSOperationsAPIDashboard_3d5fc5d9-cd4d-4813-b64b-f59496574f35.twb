      <column caption='Filter Outliers (adjusted)' datatype='boolean' name='[Adjust Has Complete Jobs to Update Stock (copy)_153052048043872258]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = &apos;8&apos; THEN &#10;CASE [granularity]&#10;    &#10;    WHEN &apos;daily&apos; THEN&#10;&#10;            IF [confirmed_orders] &gt; 1 THEN&#10;                IF [Calculation_262686577636798505] &lt;= 3  THEN&#10;                    IF [gmv_net_eur] / [Calculation_262686577636798505] &lt; 100 THEN TRUE ELSE FALSE END&#10;                ELSE TRUE END&#10;            ELSE TRUE END&#10;    &#10;        WHEN &apos;weekly&apos; THEN&#10;&#10;        IF [confirmed_orders] &gt; 1 THEN&#10;            IF [Calculation_262686577636798505] &lt;= 3  THEN&#10;                IF [gmv_net_eur] / [Calculation_262686577636798505] &lt; 100 THEN TRUE ELSE FALSE END&#10;            ELSE TRUE END&#10;        ELSE TRUE END&#10;&#10;    WHEN &apos;monthly&apos; THEN&#10;&#10;        IF [confirmed_orders] &gt; 1 THEN&#10;            IF [Calculation_262686577636798505] &lt;= 15  THEN&#10;                IF [gmv_net_eur] / [Calculation_262686577636798505] &lt; 700 THEN TRUE ELSE FALSE END&#10;            ELSE TRUE END&#10;        ELSE TRUE END&#10;&#10;    WHEN &apos;quarterly&apos; THEN&#10;&#10;        IF [confirmed_orders] &gt; 1 THEN&#10;            IF [Calculation_262686577636798505] &lt;= 30  THEN&#10;                IF [gmv_net_eur] / [Calculation_262686577636798505] &lt; 1400 THEN TRUE ELSE FALSE END&#10;            ELSE TRUE END&#10;        ELSE TRUE END&#10;&#10;END&#10;ELSE TRUE&#10;END' />
      </column>
      <column caption='Avg GMV per Vendor (Score Group)' datatype='real' default-format='c#,##0,.0K&quot; €&quot;;-#,##0,.0K&quot; €&quot;' name='[Avg Confirmed Orders per Vendor (copy)_3194529905720688679]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gmv_net_eur]) / [Calculation_3194529904780869646]' />
      </column>
      <column caption='Ratio # updates items vs total assortment (card)' datatype='real' default-format='p0.0%' name='[Avg. num. of Updates per Day (card) (copy)_1278529740258992155]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 12]&#10;&#10;WHEN &quot;1&quot; THEN&#10;&#10;    SUM(&#10;    IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_items_vs_total_assortment] &gt; 0 AND [period_num] = [Parameters].[Parameter 5] THEN&#10;        [ratio_num_updates_items_vs_total_assortment] * [gmv_net_eur]&#10;        ELSE NULL&#10;    END&#10;    ) / &#10;    SUM(&#10;    IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_items_vs_total_assortment] &gt; 0 AND [period_num] = [Parameters].[Parameter 5] THEN&#10;       [gmv_net_eur]&#10;        ELSE NULL&#10;    END&#10;    )&#10;&#10;WHEN &quot;2&quot; THEN&#10;&#10;    SUM(&#10;    IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_stock_items_vs_total_assortment] &gt; 0 AND [period_num] = [Parameters].[Parameter 5] THEN&#10;        [ratio_num_updates_stock_items_vs_total_assortment] * [gmv_net_eur]&#10;        ELSE NULL&#10;    END&#10;    ) / &#10;    SUM(&#10;    IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_stock_items_vs_total_assortment] &gt; 0 AND [period_num] = [Parameters].[Parameter 5] THEN&#10;       [gmv_net_eur]&#10;        ELSE NULL&#10;    END&#10;    )&#10;&#10;WHEN &quot;3&quot; THEN&#10;&#10;    SUM(&#10;    IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_price_items_vs_total_assortment] &gt; 0 AND [period_num] = [Parameters].[Parameter 5] THEN&#10;        [ratio_num_updates_price_items_vs_total_assortment] * [gmv_net_eur]&#10;        ELSE NULL&#10;    END&#10;    ) / &#10;    SUM(&#10;    IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_price_items_vs_total_assortment] &gt; 0 AND [period_num] = [Parameters].[Parameter 5] THEN&#10;       [gmv_net_eur]&#10;        ELSE NULL&#10;    END&#10;    )&#10;&#10;ELSE NULL&#10;&#10;END' />
      </column>
      <column caption='% Not Delivered (card)' datatype='real' default-format='p0.00%' name='[Avg. num. of Updates per Day (card) (copy)_1278529740259676190]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([confirmed_orders_pelican]) &gt; 0 THEN&#10;SUM(&#10;    IF [period_num] = [Parameters].[Parameter 5] THEN&#10;        ([in_cart_pelican_items] - [in_cart_pelican_items_sold])     &#10;        + [not_found_pelican_items] &#10;        + ([replaced_pelican_items] - [replaced_pelican_items_sold] - [replacements_pelican_items])&#10;        + [oos_failed_pelican_items]&#10;    ELSE NULL&#10;    END&#10;) / &#10;SUM(&#10;    IF [period_num] = [Parameters].[Parameter 5] THEN&#10;        [in_cart_pelican_items]&#10;        + [not_found_pelican_items] &#10;        + [not_processed_pelican_items] &#10;        + [replaced_pelican_items]&#10;        + [replacements_pelican_items]&#10;        + [oos_failed_pelican_items]&#10;    ELSE NULL&#10;    END&#10;)&#10;ELSE NULL END' />
      </column>
      <column caption='Ov. Avg. num. of Updates per Day' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg. num. of Updates per Day (copy 2)_4140004383230488581]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 12]&#10;&#10;WHEN &quot;1&quot; THEN&#10;&#10;    SUM(&#10;    IF [gmv_net_eur] &gt; 0 AND [avg_number_of_updates_per_day] &gt; 0 THEN&#10;        [avg_number_of_updates_per_day] * [gmv_net_eur]&#10;        ELSE NULL&#10;    END&#10;    ) / &#10;    SUM(&#10;    IF [gmv_net_eur] &gt; 0 AND [avg_number_of_updates_per_day] &gt; 0 THEN&#10;       [gmv_net_eur]&#10;        ELSE NULL&#10;    END&#10;    )&#10;&#10;WHEN &quot;2&quot; THEN&#10;&#10;    SUM(&#10;    IF [gmv_net_eur] &gt; 0 AND [avg_number_of_updates_stock_per_day] &gt; 0 THEN&#10;        [avg_number_of_updates_stock_per_day] * [gmv_net_eur]&#10;        ELSE NULL&#10;    END&#10;    ) / &#10;    SUM(&#10;    IF [gmv_net_eur] &gt; 0 AND [avg_number_of_updates_stock_per_day] &gt; 0 THEN&#10;       [gmv_net_eur]&#10;        ELSE NULL&#10;    END&#10;    )&#10;&#10;WHEN &quot;3&quot; THEN&#10;&#10;    SUM(&#10;    IF [gmv_net_eur] &gt; 0 AND [avg_number_of_updates_price_per_day] &gt; 0 THEN&#10;        [avg_number_of_updates_price_per_day] * [gmv_net_eur]&#10;        ELSE NULL&#10;    END&#10;    ) / &#10;    SUM(&#10;    IF [gmv_net_eur] &gt; 0 AND [avg_number_of_updates_price_per_day] &gt; 0 THEN&#10;       [gmv_net_eur]&#10;        ELSE NULL&#10;    END&#10;    )&#10;&#10;ELSE NULL&#10;&#10;END' />
      </column>
      <column caption='Avg. num. of Updates per Day (copy)' datatype='real' default-format='n#,##0.00;-#,##0.00' hidden='true' name='[Avg. num. of Updates per Day (copy)_1278529740250648597]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([nr_jobs_updated_product_completed]) / [Calculation_1860831095266058273]) / [Calculation_1860831094933049357]' />
      </column>
      <column caption='Ratio # updates items vs total assortment - Diff (card)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg. num. of Updates per Day - Diff (card) (copy)_1278529740258992154]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(&#10;    (&#10;        CASE [Parameters].[Parameter 12]&#10;&#10;        WHEN &quot;1&quot; THEN&#10;&#10;            SUM(&#10;            IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_items_vs_total_assortment] &gt; 0 AND [period_num] = [Parameters].[Parameter 5] THEN&#10;                [ratio_num_updates_items_vs_total_assortment] * [gmv_net_eur]&#10;                ELSE NULL&#10;            END&#10;            ) / &#10;            SUM(&#10;            IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_items_vs_total_assortment] &gt; 0 AND [period_num] = [Parameters].[Parameter 5] THEN&#10;               [gmv_net_eur]&#10;                ELSE NULL&#10;            END&#10;            )&#10;&#10;        WHEN &quot;2&quot; THEN&#10;&#10;            SUM(&#10;            IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_stock_items_vs_total_assortment] &gt; 0 AND [period_num] = [Parameters].[Parameter 5] THEN&#10;                [ratio_num_updates_stock_items_vs_total_assortment] * [gmv_net_eur]&#10;                ELSE NULL&#10;            END&#10;            ) / &#10;            SUM(&#10;            IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_stock_items_vs_total_assortment] &gt; 0 AND [period_num] = [Parameters].[Parameter 5] THEN&#10;               [gmv_net_eur]&#10;                ELSE NULL&#10;            END&#10;            )&#10;&#10;        WHEN &quot;3&quot; THEN&#10;&#10;            SUM(&#10;            IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_price_items_vs_total_assortment] &gt; 0 AND [period_num] = [Parameters].[Parameter 5] THEN&#10;                [ratio_num_updates_price_items_vs_total_assortment] * [gmv_net_eur]&#10;                ELSE NULL&#10;            END&#10;            ) / &#10;            SUM(&#10;            IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_price_items_vs_total_assortment] &gt; 0 AND [period_num] = [Parameters].[Parameter 5] THEN&#10;               [gmv_net_eur]&#10;                ELSE NULL&#10;            END&#10;            )&#10;&#10;        ELSE NULL&#10;&#10;        END&#10;    ) / &#10;    (&#10;        CASE [Parameters].[Parameter 12]&#10;&#10;        WHEN &quot;1&quot; THEN&#10;&#10;            SUM(&#10;            IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_items_vs_total_assortment] &gt; 0 AND [period_num] = [Parameters].[Cards Period 1 (copy)_1278529740053532683] THEN&#10;                [ratio_num_updates_items_vs_total_assortment] * [gmv_net_eur]&#10;                ELSE NULL&#10;            END&#10;            ) / &#10;            SUM(&#10;            IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_items_vs_total_assortment] &gt; 0 AND [period_num] = [Parameters].[Cards Period 1 (copy)_1278529740053532683] THEN&#10;               [gmv_net_eur]&#10;                ELSE NULL&#10;            END&#10;            )&#10;&#10;        WHEN &quot;2&quot; THEN&#10;&#10;            SUM(&#10;            IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_stock_items_vs_total_assortment] &gt; 0 AND [period_num] = [Parameters].[Cards Period 1 (copy)_1278529740053532683] THEN&#10;                [ratio_num_updates_stock_items_vs_total_assortment] * [gmv_net_eur]&#10;                ELSE NULL&#10;            END&#10;            ) / &#10;            SUM(&#10;            IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_stock_items_vs_total_assortment] &gt; 0 AND [period_num] = [Parameters].[Cards Period 1 (copy)_1278529740053532683] THEN&#10;               [gmv_net_eur]&#10;                ELSE NULL&#10;            END&#10;            )&#10;&#10;        WHEN &quot;3&quot; THEN&#10;&#10;            SUM(&#10;            IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_price_items_vs_total_assortment] &gt; 0 AND [period_num] = [Parameters].[Cards Period 1 (copy)_1278529740053532683] THEN&#10;                [ratio_num_updates_price_items_vs_total_assortment] * [gmv_net_eur]&#10;                ELSE NULL&#10;            END&#10;            ) / &#10;            SUM(&#10;            IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_price_items_vs_total_assortment] &gt; 0 AND [period_num] = [Parameters].[Cards Period 1 (copy)_1278529740053532683] THEN&#10;               [gmv_net_eur]&#10;                ELSE NULL&#10;            END&#10;            )&#10;&#10;        ELSE NULL&#10;&#10;        END&#10;    )&#10;-1 )' />
      </column>
      <column caption='% Not Delivered - Diff (card)' datatype='real' default-format='n0.00;-0.00' name='[Avg. num. of Updates per Day - Diff (card) (copy)_1278529740259676189]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(&#10;    (&#10;        IF SUM([confirmed_orders_pelican]) &gt; 0 THEN&#10;        SUM(&#10;            IF [period_num] = [Parameters].[Parameter 5] THEN&#10;                ([in_cart_pelican_items] - [in_cart_pelican_items_sold])     &#10;                + [not_found_pelican_items] &#10;                + ([replaced_pelican_items] - [replaced_pelican_items_sold] - [replacements_pelican_items])&#10;                + [oos_failed_pelican_items]&#10;            ELSE NULL&#10;            END&#10;        ) / &#10;        SUM(&#10;            IF [period_num] = [Parameters].[Parameter 5] THEN&#10;                [in_cart_pelican_items]&#10;                + [not_found_pelican_items] &#10;                + [not_processed_pelican_items] &#10;                + [replaced_pelican_items]&#10;                + [replacements_pelican_items]&#10;                + [oos_failed_pelican_items]&#10;            ELSE NULL&#10;            END&#10;        )&#10;        ELSE NULL END&#10;    ) -&#10;    (&#10;        IF SUM([confirmed_orders_pelican]) &gt; 0 THEN&#10;        SUM(&#10;            IF [period_num] = [Parameters].[Cards Period 1 (copy)_1278529740053532683] THEN&#10;                ([in_cart_pelican_items] - [in_cart_pelican_items_sold])     &#10;                + [not_found_pelican_items] &#10;                + ([replaced_pelican_items] - [replaced_pelican_items_sold] - [replacements_pelican_items])&#10;                + [oos_failed_pelican_items]&#10;            ELSE NULL&#10;            END&#10;        ) / &#10;        SUM(&#10;            IF [period_num] = [Parameters].[Cards Period 1 (copy)_1278529740053532683] THEN&#10;                [in_cart_pelican_items]&#10;                + [not_found_pelican_items] &#10;                + [not_processed_pelican_items] &#10;                + [replaced_pelican_items]&#10;                + [replacements_pelican_items]&#10;                + [oos_failed_pelican_items]&#10;            ELSE NULL&#10;            END&#10;        )&#10;        ELSE NULL END&#10;    )&#10; ) * 100' />
      </column>
      <column caption='Ratio # updates items vs total assortment - Diff Icon (card)' datatype='string' default-format='p0.0%' name='[Avg. num. of Updates per Day - Diff Icon (card) (copy)_1278529740258992156]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Avg. num. of Updates per Day - Diff (card) (copy)_1278529740258992154] &gt; 0 THEN &quot;▲&quot; &#10;ELSEIF [Avg. num. of Updates per Day - Diff (card) (copy)_1278529740258992154] &lt; 0 THEN &quot;▼&quot; &#10;ELSE &quot;●&quot;&#10;END' />
      </column>
      <column caption='% Not Delivered - Diff Icon (card)' datatype='string' default-format='p0.0%' name='[Avg. num. of Updates per Day - Diff Icon (card) (copy)_1278529740259676191]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Avg. num. of Updates per Day - Diff (card) (copy)_1278529740259676189] &gt; 0 THEN &quot;▲&quot; &#10;ELSEIF [Avg. num. of Updates per Day - Diff (card) (copy)_1278529740259676189] &lt; 0 THEN &quot;▼&quot; &#10;ELSE &quot;●&quot;&#10;END' />
      </column>
      <column caption='Every how many days Vendors update their stock' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;IF [gmv_net_eur] &gt; 0 AND [every_how_many_days_vendors_update_their_stock] &gt; 0 THEN&#10;    [every_how_many_days_vendors_update_their_stock] * [gmv_net_eur]&#10;    ELSE NULL&#10;END&#10;) / &#10;SUM(&#10;IF [gmv_net_eur] &gt; 0 AND [every_how_many_days_vendors_update_their_stock] &gt; 0 THEN&#10;   [gmv_net_eur]&#10;    ELSE NULL&#10;END&#10;)' />
      </column>
      <column caption='Entity or Country' datatype='string' name='[Calculation_115897350132613120]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF {FIXED : COUNTD([entity])} &gt; 1 THEN [entity] ELSE country END' />
      </column>
      <column caption='View 1' datatype='string' hidden='true' name='[Calculation_1278529739994845184]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;1&apos; THEN &apos;1&apos; &#10;WHEN &apos;2&apos; THEN &apos;2&apos;&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Metrics 1' datatype='real' hidden='true' name='[Calculation_1278529740003389442]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;    WHEN &apos;1&apos; THEN COUNTD([vendor_id])&#10;    WHEN &apos;2&apos; THEN SUM([confirmed_orders])&#10;    WHEN &apos;3&apos; THEN SUM([gmv_net_eur])&#10;    WHEN &apos;4&apos; THEN [% Not Found Rate / Items Not Delivered (copy)_3194529905381822494] / COUNTD([vendor_id])&#10;    WHEN &apos;5&apos; THEN SUM([oos_failed_pelican_orders_items_price_eur]) / COUNTD([vendor_id])&#10;    WHEN &apos;6&apos; THEN SUM([nr_jobs_updated_product_completed]) / COUNTD([vendor_id])&#10;    WHEN &apos;7&apos; THEN SUM([nr_changed_products_completed]) / COUNTD([vendor_id])&#10;END' />
      </column>
      <column caption='Stocks SFTP Jobs (card)' datatype='integer' name='[Calculation_1278529740044296199]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [period_num] = [Parameters].[Parameter 5]&#10;        THEN [Calculation_262686577636798505]&#10;        ELSE 0&#10;    END&#10;)' />
      </column>
      <column caption='Metrics Cards' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1278529740269060131]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;    WHEN  &apos;1&apos; THEN ROUND(SUM([gmv_net_eur]) / 1000, 2)&#10;    WHEN  &apos;2&apos; THEN ROUND(SUM([Calculation_262686577636798505]) / 1000, 2)&#10;    WHEN  &apos;3&apos; THEN [Every how many days Vendors update their stock (copy 2)_4140004383225536515]&#10;    WHEN  &apos;4&apos; THEN [Avg. num. of Updates per Day (copy 2)_4140004383230488581]&#10;    WHEN  &apos;5&apos; THEN [Calculation_1860831095894679597] * 100&#10;    WHEN  &apos;6&apos; THEN [% Partial Fulfilled Items (copy)_1860831095852757033] * 100&#10;    WHEN  &apos;7&apos; THEN [Ratio # updates items vs total assortment (copy 2)_4140004383234433030] * 100&#10;    WHEN  &apos;8&apos; THEN [% SFTP Vendors (card) (copy)_161707402988531715] * 100&#10;    WHEN  &apos;9&apos; THEN [          Nr Jobs New Product Completed (copy)_262686577296982041] * 100&#10;    WHEN  &apos;10&apos; THEN [          % of Changed Products (copy)_262686577375961122] * 100&#10;    WHEN  &apos;11&apos; THEN [          % of Jobs with New Items Updates (copy)_262686577379205158] * 100&#10;    WHEN  &apos;12&apos; THEN [          % of Processed Items (copy)_262686577379475495] * 100&#10;    WHEN  &apos;13&apos; THEN [          % of Failed Items (copy)_262686577379766312] * 100&#10;    WHEN  &apos;14&apos; THEN [          % of Processed Items (copy)_262686577705320495] * 100&#10;    WHEN  &apos;15&apos; THEN COUNTD(IF [gmv_net_eur] &gt; 0 AND [Calculation_262686577636798505] &gt; 0  THEN [vendor_id] ELSE NULL END)&#10;    WHEN  &apos;16&apos; THEN SUM([nr_updated_stock_count_products]) / 1000&#10;    WHEN  &apos;17&apos; THEN ROUND(SUM([nr_jobs_updated_product_completed]) / 1000, 2)&#10;END' />
      </column>
      <column caption='Selected Period' datatype='boolean' name='[Calculation_1278529740277645362]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = MAX([period_num]) THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Dymension Cards' datatype='string' name='[Calculation_1278529740281888822]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[In / Out (copy)]&#10;    WHEN &quot;1&quot; THEN [sftp_score_group]&#10;    WHEN &quot;2&quot; THEN [entity]&#10;    WHEN &quot;3&quot; THEN [Calculation_3194529905058963481]&#10;    WHEN &quot;4&quot; THEN [picking_app]&#10;    WHEN &quot;5&quot; THEN STR([is_aaa_vendor])&#10;    WHEN &quot;6&quot; THEN STR([is_aaa_supermarket])&#10;ELSE &quot;&quot;&#10;END' />
      </column>
      <column caption='2nd Ratio of Items updates' datatype='real' default-format='p0.0%' hidden='true' name='[Calculation_1278529740685598776]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(&#10;    (   SUM([nr_changed_products_completed]) &#10;        / SUM(IF [nr_changed_products_completed] &gt; 0 THEN [nr_jobs_updated_product_completed] ELSE 0 END)&#10;    ) / &#10;    SUM(&#10;        IF [nr_changed_products_completed] &gt; 0 &#10;            AND [nr_jobs_updated_product_completed] &gt; 0&#10;        THEN [vendor_assortment_total] ELSE 0 END)&#10;)' />
      </column>
      <column caption='Filter Outliers (card)' datatype='boolean' name='[Calculation_1278529741041209407]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = &apos;8&apos; THEN TRUE ELSE&#10;&#10;    CASE [granularity]&#10;    &#10;        WHEN &apos;daily&apos; THEN&#10;&#10;            IF [confirmed_orders] &gt; 1 THEN&#10;                IF [Calculation_262686577636798505] &lt;= 3  THEN&#10;                    IF [gmv_net_eur] / [Calculation_262686577636798505] &lt; 100 THEN TRUE ELSE FALSE END&#10;                ELSE TRUE END&#10;            ELSE TRUE END&#10;    &#10;        WHEN &apos;weekly&apos; THEN&#10;&#10;            IF [confirmed_orders] &gt; 1 THEN&#10;                IF [Calculation_262686577636798505] &lt;= 3  THEN&#10;                    IF [gmv_net_eur] / [Calculation_262686577636798505] &lt; 100 THEN TRUE ELSE FALSE END&#10;                ELSE TRUE END&#10;            ELSE TRUE END&#10;&#10;        WHEN &apos;monthly&apos; THEN&#10;&#10;            IF [confirmed_orders] &gt; 1 THEN&#10;                IF [Calculation_262686577636798505] &lt;= 15  THEN&#10;                    IF [gmv_net_eur] / [Calculation_262686577636798505] &lt; 700 THEN TRUE ELSE FALSE END&#10;                ELSE TRUE END&#10;            ELSE TRUE END&#10;&#10;        WHEN &apos;quarterly&apos; THEN&#10;&#10;            IF [confirmed_orders] &gt; 1 THEN&#10;                IF [Calculation_262686577636798505] &lt;= 30  THEN&#10;                    IF [gmv_net_eur] / [Calculation_262686577636798505] &lt; 1400 THEN TRUE ELSE FALSE END&#10;                ELSE TRUE END&#10;            ELSE TRUE END&#10;&#10;    END&#10;END' />
      </column>
      <column caption='Cards Title' datatype='string' name='[Calculation_1278529741365178433]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(&quot;Date: &quot;) &#10;+ STR(IF [period_num] = [Parameters].[Parameter 5] THEN [Calculation_1860831094529859592] ELSE NULL END) &#10;+ STR(&quot; (&quot; + [granularity] + &quot;)&quot;) &#10;+ STR(IF[Parameters].[Parameter 5] = 1 THEN &quot; - This Period is still in progress    &quot; ELSE &quot;   &quot; END)' />
      </column>
      <column caption='Has Complete Jobs to Update Stock (adjusted)' datatype='boolean' name='[Calculation_153052048041078785]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = &apos;8&apos; THEN &#10;    IF [Calculation_262686577636798505] &gt;= 1 THEN TRUE ELSE&#10;    IF [Parameters].[Deep Dive Metric (copy)] = TRUE THEN TRUE ELSE FALSE END END&#10;ELSE TRUE&#10;END' />
      </column>
      <column caption='Local Date ' datatype='string' name='[Calculation_1860831094529859592]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [granularity]&#10;    WHEN &apos;daily&apos; THEN RIGHT(STR(DATE([local_date])),5) + &quot;  &quot; + LEFT(DATENAME(&apos;weekday&apos;, [local_date]), 3)&#10;    WHEN &apos;weekly&apos; THEN RIGHT(STR(DATE(DATETRUNC(&apos;week&apos;,[local_date], &apos;monday&apos;))),8)&#10;    WHEN &apos;monthly&apos; THEN LEFT(RIGHT(STR(DATE(DATETRUNC(&apos;month&apos;,[local_date]))),8), 5)&#10;    WHEN &apos;quarterly&apos; THEN LEFT(RIGHT(STR(DATE(DATETRUNC(&apos;quarter&apos;,[local_date]))),8), 5)&#10;END' />
      </column>
      <column caption='# of Vendors using SFTP Jobs' datatype='integer' default-format='n#,##0;-#,##0' hidden='true' name='[Calculation_1860831094933049357]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [has_sftp_jobs] THEN [vendor_id] END)' />
      </column>
      <column caption='% Vendors Using Central SFTP' datatype='real' default-format='p0.0%' hidden='true' name='[Calculation_1860831095202131996]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(COUNTD(IF [has_sftp_jobs] AND [sftp_type_is_central] THEN [vendor_id] END) / [Calculation_1860831094933049357])' />
      </column>
      <column caption='Period Filter' datatype='boolean' name='[Calculation_1860831095232335902]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [period_num] &lt;= [Parameters].[Replaced Pelican Items Parameter] + 1 &#10;THEN &#10;    IF [Parameters].[How many periods do you want to see (copy)] &#10;    THEN &#10;        IF [period_num] &lt;= [Parameters].[Replaced Pelican Items Parameter] &#10;        THEN TRUE &#10;        ELSE FALSE &#10;        END &#10;    ELSE &#10;        IF [period_num] &gt; 1 &#10;        THEN TRUE &#10;        ELSE FALSE &#10;        END&#10;    END &#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='Avg. num. of Updates per Day' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1860831095256268831]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;IF [gmv_net_eur] &gt; 0 AND [avg_number_of_updates_stock_per_day] &gt; 0 THEN&#10;    [avg_number_of_updates_stock_per_day] * [gmv_net_eur]&#10;    ELSE NULL&#10;END&#10;) / &#10;SUM(&#10;IF [gmv_net_eur] &gt; 0 AND [avg_number_of_updates_stock_per_day] &gt; 0 THEN&#10;   [gmv_net_eur]&#10;    ELSE NULL&#10;END&#10;)' />
      </column>
      <column caption='# of Days ' datatype='integer' hidden='true' name='[Calculation_1860831095266058273]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([num_of_days])' />
      </column>
      <column caption='% of Stock Jobs that Failed' datatype='real' default-format='p0.0%' name='[Calculation_1860831095546413092]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nr_jobs_failed]) / SUM([nr_jobs])' />
      </column>
      <column caption='Ratio # updates items vs total assortment' datatype='real' default-format='p0.0%' name='[Calculation_1860831095615938598]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_stock_items_vs_total_assortment] &gt; 0 THEN&#10;    [ratio_num_updates_stock_items_vs_total_assortment] * [gmv_net_eur]&#10;    ELSE NULL&#10;END&#10;) / &#10;SUM(&#10;IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_stock_items_vs_total_assortment] &gt; 0 THEN&#10;   [gmv_net_eur]&#10;    ELSE NULL&#10;END&#10;)' />
      </column>
      <column caption='% Not Found Items' datatype='real' default-format='p0.00%' hidden='true' name='[Calculation_1860831095850856487]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([not_found_pelican_items]) / SUM(&#10;    [in_cart_pelican_items] &#10;    + [not_found_pelican_items] &#10;    + [not_processed_pelican_items] &#10;    + [replaced_pelican_items] &#10;    + [replacements_pelican_items]&#10;)' />
      </column>
      <column caption='# of Products impacted by Campaigns' datatype='real' default-format='n#,##0.0;-#,##0.0' hidden='true' name='[Calculation_1860831095882592300]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sftp_campaign_total_product_impacted]) / SUM([sftp_campaign_counting_total])' />
      </column>
      <column caption='% Not Delivered' datatype='real' default-format='p0.00%' name='[Calculation_1860831095894679597]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([confirmed_orders_pelican]) &gt; 0 THEN&#10;SUM(&#10;    ([in_cart_pelican_items] - [in_cart_pelican_items_sold])     &#10;    + [not_found_pelican_items] &#10;    + ([replaced_pelican_items] - [replaced_pelican_items_sold] - [replacements_pelican_items])&#10;    + [oos_failed_pelican_items]&#10;) / &#10;SUM(&#10;    [in_cart_pelican_items]&#10;    + [not_found_pelican_items] &#10;    + [not_processed_pelican_items] &#10;    + [replaced_pelican_items]&#10;    + [replacements_pelican_items]&#10;    + [oos_failed_pelican_items]&#10;)&#10;ELSE NULL END' />
      </column>
      <column caption='Score' datatype='real' default-format='n#,##0;-#,##0' hidden='true' name='[Calculation_1860831096239075374]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Calculation_1860831096249008176]) &gt; 0 THEN&#10;    (&#10;        (&#10;            (&#10;                IF [Calculation1] &gt;= 1.00 THEN 10&#10;                ELSEIF [Calculation1] &gt;= 1.50 THEN 7.5&#10;                ELSEIF [Calculation1] &gt;= 2.00 THEN 5&#10;                ELSEIF [Calculation1] &gt;= 5.00 THEN 2.5&#10;                ELSE 0 END&#10;            ) + (&#10;                IF [Calculation_1860831095256268831] &gt;= 2.00 THEN 10&#10;                ELSEIF [Calculation_1860831095256268831] &gt;= 1.25 THEN 7.5&#10;                ELSEIF [Calculation_1860831095256268831] &gt;= 0.80 THEN 5&#10;                ELSEIF [Calculation_1860831095256268831] &gt;= 0.40 THEN 2.5&#10;                ELSE 0 END&#10;            ) + (&#10;                IF [Calculation_1860831095615938598] &gt;= 2.50 THEN 10&#10;                ELSEIF [Calculation_1860831095615938598] &gt;= 2.00 THEN 7.5&#10;                ELSEIF [Calculation_1860831095615938598] &gt;= 1.00 THEN 5&#10;                ELSEIF [Calculation_1860831095615938598] &gt;= 0.50 THEN 2.5&#10;                ELSE 0 END&#10;            ) + (&#10;                IF [Calculation_1860831095894679597] &lt;= 0.01 THEN 10&#10;                ELSEIF [Calculation_1860831095894679597] &lt;= 0.02 THEN 7.5&#10;                ELSEIF [Calculation_1860831095894679597] &lt;= 0.05 THEN 5&#10;                ELSEIF [Calculation_1860831095894679597] &lt;= 0.10 THEN 2.5&#10;                ELSE 0 END&#10;            ) + (&#10;                IF [% Partial Fulfilled Items (copy)_1860831095852757033] &lt;= 0.005 THEN 10&#10;                ELSEIF [% Partial Fulfilled Items (copy)_1860831095852757033] &lt;= 0.01 THEN 7.5&#10;                ELSEIF [% Partial Fulfilled Items (copy)_1860831095852757033] &lt;= 0.03 THEN 5&#10;                ELSEIF [% Partial Fulfilled Items (copy)_1860831095852757033] &lt;= 0.075 THEN 2.5&#10;                ELSE 0 END&#10;            )&#10;        ) / 50&#10;    ) * 100&#10;ELSE&#10;    (&#10;        (&#10;            (&#10;                IF [Calculation1] &gt;= 1.00 THEN 10&#10;                ELSEIF [Calculation1] &gt;= 1.50 THEN 7.5&#10;                ELSEIF [Calculation1] &gt;= 2.00 THEN 5&#10;                ELSEIF [Calculation1] &gt;= 5.00 THEN 2.5&#10;                ELSE 0 END&#10;            ) + (&#10;                IF [Calculation_1860831095256268831] &gt;= 2.00 THEN 10&#10;                ELSEIF [Calculation_1860831095256268831] &gt;= 1.25 THEN 7.5&#10;                ELSEIF [Calculation_1860831095256268831] &gt;= 0.80 THEN 5&#10;                ELSEIF [Calculation_1860831095256268831] &gt;= 0.40 THEN 2.5&#10;                ELSE 0 END&#10;            ) + (&#10;                IF [Calculation_1860831095615938598] &gt;= 2.50 THEN 10&#10;                ELSEIF [Calculation_1860831095615938598] &gt;= 2.00 THEN 7.5&#10;                ELSEIF [Calculation_1860831095615938598] &gt;= 1.00 THEN 5&#10;                ELSEIF [Calculation_1860831095615938598] &gt;= 0.50 THEN 2.5&#10;                ELSE 0 END&#10;            ) + (&#10;                IF [% Partial Fulfilled Items (copy)_1860831095852757033] &lt;= 0.005 THEN 10&#10;                ELSEIF [% Partial Fulfilled Items (copy)_1860831095852757033] &lt;= 0.01 THEN 7.5&#10;                ELSEIF [% Partial Fulfilled Items (copy)_1860831095852757033] &lt;= 0.03 THEN 5&#10;                ELSEIF [% Partial Fulfilled Items (copy)_1860831095852757033] &lt;= 0.075 THEN 2.5&#10;                ELSE 0 END&#10;            )&#10;        ) / 40&#10;    ) * 100&#10;END' />
      </column>
      <column caption='Total Ordered Items (granular)' datatype='real' hidden='true' name='[Calculation_1860831096249008176]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[in_cart_pelican_items] &#10;+ [not_found_pelican_items] &#10;+ [not_processed_pelican_items] &#10;+ [replaced_pelican_items] &#10;+ [replacements_pelican_items] &#10;+ [oos_failed_pelican_items]' />
      </column>
      <column caption='SFTP Score Group' datatype='string' name='[Calculation_1860831096295628849]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Score (copy)_3194529904769355787] &lt; 50 THEN &apos;Underperforming&apos; ELSEIF [Score (copy)_3194529904769355787] &gt; 74.99 THEN &apos;Overperforming&apos; ELSE &apos;Neutral&apos; END' />
      </column>
      <column caption='METRICS' datatype='integer' hidden='true' name='[Calculation_262686577281499143]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(NULL)' />
      </column>
      <column caption='% of SFTP Jobs for Stock' datatype='real' default-format='p0.0%' hidden='true' name='[Calculation_262686577284239370]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nr_jobs_updated_product_completed]) / (SUM([nr_jobs_updated_price_completed]) + SUM([nr_jobs_updated_product_completed]))' />
      </column>
      <column caption='     $ GMV Net Eur' datatype='real' default-format='c#,##0,K&quot; €&quot;;-#,##0,K&quot; €&quot;' name='[Calculation_262686577291255820]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gmv_net_eur])' />
      </column>
      <column caption='     % SFTP Vendors' datatype='real' default-format='p0.0%' hidden='true' name='[Calculation_262686577291444237]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[% SFTP Vendors (card) (copy)_161707402988531715]' />
      </column>
      <column caption='     Every How Many Days Vendors Update through API' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_262686577292001294]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Every how many days Vendors update their stock (copy 2)_4140004383225536515]' />
      </column>
      <column caption='     Avg Num of SFTP Updates per Day' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_262686577292214287]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Avg. num. of Updates per Day (copy 2)_4140004383230488581]' />
      </column>
      <column caption='     Ratio SFTP Updates vs Total Assortment' datatype='real' default-format='p0.0%' name='[Calculation_262686577292288016]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Ratio # updates items vs total assortment (copy 2)_4140004383234433030]' />
      </column>
      <column caption='     % Items Not Delivered' datatype='real' default-format='p0.00%' name='[Calculation_262686577293156369]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1860831095894679597]' />
      </column>
      <column caption='     # of SFTP Jobs' datatype='integer' name='[Calculation_262686577294442519]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nr_jobs_completed])' />
      </column>
      <column caption='          % of SFTP Jobs with New Items Updates' datatype='real' default-format='p0.0%' name='[Calculation_262686577296416792]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nr_jobs_new_product_completed]) / SUM([nr_jobs_completed])' />
      </column>
      <column caption='          % of Changed Items' datatype='real' default-format='p0.0%' name='[Calculation_262686577374875681]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nr_changed_products_completed]) / SUM([nr_processed_products_completed])' />
      </column>
      <column caption='SFTP Jobs to see' datatype='integer' name='[Calculation_262686577636798505]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 12]&#10;WHEN &apos;1&apos; THEN [nr_jobs_completed]&#10;WHEN &apos;2&apos; THEN [nr_jobs_updated_product_completed]&#10;WHEN &apos;3&apos; THEN [nr_jobs_updated_price_completed]&#10;WHEN &apos;4&apos; THEN [nr_jobs_new_product_completed]&#10;END' />
      </column>
      <column caption='Active full download table' datatype='boolean' name='[Calculation_262686577651908651]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Selected Vendor (copy)] = TRUE then TRUE ELSE FALSE END' />
      </column>
      <column caption='Avg. shared assortment from API' datatype='real' default-format='p0%' name='[Calculation_3174545187022356480]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF COUNTD([Calculation_3194529904736956426]) = 1 THEN&#10;(&#10;MAX([nr_total_count_products_max])&#10;)&#10;/ MAX(IF [nr_jobs_completed] &gt; 0 THEN [vendor_assortment_total] ELSE 0 END)&#10;ELSE NULL END' />
      </column>
      <column caption='Validation' datatype='real' hidden='true' name='[Calculation_3194529904729645064]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Score (copy)_3194529904769355787] - SUM([sftp_score])' />
      </column>
      <column caption='Vendor Name + id' datatype='string' name='[Calculation_3194529904736956426]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[vendor_id] + &quot; - &quot; +[vendor_name]' />
      </column>
      <column caption='SFTP Score Group Count' datatype='integer' name='[Calculation_3194529904780869646]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([sftp_score_group])' />
      </column>
      <column caption='Exclude last period' datatype='boolean' hidden='true' name='[Calculation_3194529904956862481]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[How many periods do you want to see (copy)] = FALSE THEN &#10;    IF [period_num] != 1 THEN TRUE ELSE FALSE END&#10;ELSE TRUE END' />
      </column>
      <column caption='Has Complete Jobs to Update Stock (card)' datatype='boolean' name='[Calculation_3194529905047035928]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = &apos;8&apos; THEN TRUE &#10;ELSEIF [Calculation_262686577636798505] &gt;= 1 THEN TRUE &#10;ELSEIF [Parameters].[Deep Dive Metric (copy)] = TRUE THEN TRUE&#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='SFTP Type' datatype='string' name='[Calculation_3194529905058963481]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [sftp_type_is_central] THEN &apos;Central SFTP&apos; ELSEIF [sftp_type_is_legacy] THEN &apos;Legacy SFTP&apos; ELSE &apos;Non SFTP&apos; END' />
      </column>
      <column caption='% GMV Loss Due to OOS Failed Orders' datatype='real' default-format='p0.00%' name='[Calculation_3194529905401241634]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([oos_failed_pelican_orders_items_price_eur]) / SUM([gmv_net_eur])' />
      </column>
      <column caption='Vendors List to Filter Calc' datatype='boolean' name='[Calculation_3194529905693958179]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] THEN&#10;    IF [Parameters].[Parameter 1] != &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Parameter 1], [vendor_id]) THEN TRUE ELSE FALSE END&#10;        ELSE TRUE&#10;    END&#10;ELSE&#10;    IF [Parameters].[Parameter 1] != &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Parameter 1], [vendor_id]) THEN FALSE ELSE TRUE END&#10;        ELSE TRUE&#10;    END&#10;END' />
      </column>
      <column caption='Avg Confirmed Orders per Vendor (Score Group)' datatype='real' default-format='n#,##0.0;-#,##0.0' hidden='true' name='[Calculation_3194529905720311846]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([confirmed_orders]) / [Calculation_3194529904780869646]' />
      </column>
      <column caption='Chain Name + Country' datatype='string' name='[Calculation_3194529905745088555]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[In / Out (copy 2)]&#10;WHEN &quot;1&quot; THEN [chain_name] + &quot; (&quot; + [country_code] + &quot;)&quot;&#10;ELSE [chain_id] + &quot; - &quot; + [chain_name]&#10;END' />
      </column>
      <column caption='SFTP Jobs to See Text' datatype='string' hidden='true' name='[Calculation_4140004382867722240]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 12] != &apos;2&apos; THEN &quot;To see this metrics select SFTP Jobs with Stock Jobs&quot; ELSE &quot; &quot; END' />
      </column>
      <column caption='User_Entitlement ' datatype='boolean' name='[Calculation_701435693259743233]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]=USERNAME()' />
      </column>
