      <column caption='% of Failed lines in CSV Files - No outliers' datatype='real' default-format='p0.0%' hidden='true' name='[% of Failed lines in CSV Files (copy)_1860831095863836715]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [nr_failed_count_completed] &gt; ([vendor_assortment_total] * 3) OR [nr_processed_products_completed] &gt; ([vendor_assortment_total] * 3) THEN&#10;NULL ELSE&#10;[nr_failed_count_completed]&#10;END)&#10;/ &#10;SUM(IF [nr_failed_count_completed] &gt; ([vendor_assortment_total] * 3) OR [nr_processed_products_completed] &gt; ([vendor_assortment_total] * 3) THEN&#10;NULL ELSE&#10;[nr_failed_count_completed] + [nr_processed_products_completed]&#10;END)' />
      </column>
      <column caption='% of Unchanged lines in CSV Files' datatype='real' default-format='p0.0%' name='[% of Failed lines in CSV Files (copy)_262686577662119980]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([nr_total_count_completed]) - SUM([nr_failed_count_completed]) - SUM([nr_processed_products_completed])) / SUM([nr_total_count_completed])' />
