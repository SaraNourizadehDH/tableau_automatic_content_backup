                <zone fixed-size='280' h='22100' id='211' is-fixed='true' name='Score by Chain' w='49338' x='50000' y='32700'>
                  <layout-cache fixed-size-h='69' minwidth='332' type-h='fixed' type-w='scalable' />
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='11900' id='585' type-v2='text' w='40515' x='6838' y='35100'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='16'>How to read this chart?</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='10' underline='true'>Important clarification: this does not refer to a score of the account manager per se, but to the scores of the Vendors who are under the responsibility of the Account Manager.</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#000000' fontsize='10'>Each bar represents a </run>
                    <run bold='true' fontcolor='#000000' fontsize='10'>Account Manager</run>
                    <run fontcolor='#000000' fontsize='10'> and they are organized from largest to smallest based on Total GMV (represented by the circles). The color of the bar corresponds to the SFTP Score Group, and the number displayed on the bar refers to the SFTP Score of the Vendors that Manage that Acc. Manager.</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#000000' fontsize='8' italic='true'>Note: For a detailed explanation of the &apos;SFTP Score&apos; and how it is calculated, you can click on the icon located in the top right corner of this dashboard. </run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#ffffff' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='9300' id='589' type-v2='text' w='29412' x='53971' y='35100'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='16'>How to read this chart?</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='10'>Each bar represents a Chain and they are organized from largest to smallest based on Total GMV (represented by the circles). The color of the bar corresponds to the SFTP Score Group, and the number displayed on the bar refers to the Chain&apos;s SFTP Score.</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#000000' fontsize='8' italic='true'>Note: For a detailed explanation of the &apos;SFTP Score&apos; and how it is calculated, you can click on the icon located in the top right corner of this dashboard. </run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#ffffff' />
                  </zone-style>
                </zone>
                <zone fixed-size='280' h='22500' id='322' is-fixed='true' name='General Table' w='99264' x='368' y='55000'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='1200' id='2230' type-v2='text' w='20294' x='77353' y='55600'>
                  <formatted-text>
                    <run fontalignment='2'>Click here to see the General Score calculation:</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='42550' id='2226' type-v2='text' w='25515' x='73897' y='57150'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontsize='16'>General Score Calculation</run>
                    <run bold='true' fontcolor='#000000'>:</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000'>Æ    </run>
                    <run bold='true' fontcolor='#000000' fontsize='10'>General Score formula for Pelican</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000'>Æ        </run>
                    <run fontcolor='#000000' fontsize='10'>((A + B + C + D + E) / 5)  * 10 = </run>
                    <run bold='true' fontcolor='#000000' fontsize='10'>Æ </run>
                    <run fontcolor='#000000' fontsize='10'>General Score </run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000'>Æ    </run>
                    <run bold='true' fontcolor='#000000' fontsize='10'>General Score formula for Godroid</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000'>Æ        </run>
                    <run fontcolor='#000000' fontsize='10'>((A + B + C + E) / 4)  * 10 = </run>
                    <run bold='true' fontcolor='#000000' fontsize='10'>Æ </run>
                    <run fontcolor='#000000' fontsize='10'>General Score </run>
                    <run>Æ&#10;&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000'>    A - Every How Many Days Vendors Update Their Stock:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>          &lt;= 2 day scores 10.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>          &lt;= 4 days scores 7.5.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>          &lt;= 6 days scores 5.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>          &lt;= 8 days scores 2.5.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>          Else scores 0.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000'>     B - Avg. # Stock Updates per Day:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>          &gt;= 3 updates/day scores 10.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>          &gt;= 2 updates/day scores 7.5.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>          &gt;= 1 update/day scores 5.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>          &gt;= 0.5 updates/day scores 2.5.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>          Else scores 0.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000'>     C - Ratio Stock SFTP Updates vs Total Assortment:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>          &gt;= 5.0% ratio scores 10.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>          &gt;= 4.0% ratio scores 7.5.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>          &gt;= 2.0% ratio scores 5.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>          &gt;= 1.0% ratio scores 2.5.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>          Else scores 0.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000'>     D - % Items Not Delivered:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>          &lt;= 1% scores 10.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>          &lt;= 2% scores 7.5.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>          &lt;= 5% scores 5.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>          &lt;= 10% scores 2.5.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>          Else scores 0.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000'>     E - % OOS Fail Rate:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>          &lt;= 1% scores 10.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>          &lt;= 2% scores 7.5.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>          &lt;= 5% scores 5.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>          &lt;= 10% scores 2.5.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>          Else scores 0.                 </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>Æ   </run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#666666' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#ffffff' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='8600' id='593' type-v2='text' w='27794' x='31618' y='57500'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='16'>How to read this table?</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='10'>Each row in this table represents a Vendor, and in the columns, you can see each of the metrics we are measuring for them. For a detailed explanation of each of these metrics, click on the icon located in the top right corner of this dashboard.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#ffffff' />
                  </zone-style>
                </zone>
                <zone fixed-size='280' h='22500' id='309' is-fixed='true' name='Score by Date' w='99264' x='368' y='77500'>
                  <layout-cache cell-count-w='86' minheight='254' non-cell-size-w='1' type-h='scalable' type-w='cell' />
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='7950' id='599' type-v2='text' w='32132' x='52500' y='81250'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='16'>How to read this chart?</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='10'>In this line graph, you can see the evolution of the SFTP Score over the last four quarters. This graph will be displayed by week, month, or quarter, depending on the granularity selected.</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#000000' fontsize='8' italic='true'>Note: For a detailed explanation of the &apos;SFTP Score&apos; and how it is calculated, you can click on the icon located in the top right corner of this dashboard. </run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#ffffff' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
      <simple-id uuid='{7B0CBCFA-E1D6-44A3-ADC1-B40661470777}' />
