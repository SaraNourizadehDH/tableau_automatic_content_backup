          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Cards Period 2' datatype='integer' name='[Cards Period 1 (copy)_1278529740053532683]' param-domain-type='any' role='measure' type='quantitative' value='3'>
              <calculation class='tableau' formula='3' />
            </column>
            <column caption='Show Vendors WO SFTP Jobs' datatype='boolean' name='[Deep Dive Metric (copy)]' param-domain-type='list' role='measure' type='nominal' value='false'>
