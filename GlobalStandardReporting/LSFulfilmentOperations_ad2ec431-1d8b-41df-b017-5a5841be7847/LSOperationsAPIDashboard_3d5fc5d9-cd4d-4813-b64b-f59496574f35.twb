            <column caption='# SFTP Stock Jobs per Order (country avg)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[# SFTP Stock Jobs per Order (copy)_1537979325877133312]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF COUNTD([country]) &gt; 1 OR COUNTD([Calculation_146789252127698948]) &gt; 1 THEN NULL ELSE&#10;    SUM(&#10;        {FIXED [management_entity], [country], [granularity], [Calculation_2049700832507019265]&#10;        : &#10;        SUM(IF &#10;            [has_confirmed_orders] = TRUE&#10;            AND [has_sftp_jobs] = TRUE&#10;            AND [Calculation_146789251840057347] = TRUE&#10;            AND [Calculation_146789251839336450] = TRUE&#10;            AND LOWER([picking_app]) = &apos;pelican&apos;&#10;            AND [Calculation_3379458992373030916]&#10;            THEN [nr_jobs_updated_product_completed]&#10;            END)&#10;        /&#10;        SUM(IF &#10;            [has_confirmed_orders] = TRUE&#10;            AND [has_sftp_jobs] = TRUE&#10;            AND [Calculation_146789251840057347] = TRUE&#10;            AND [Calculation_146789251839336450] = TRUE&#10;            AND LOWER([picking_app]) = &apos;pelican&apos;&#10;            AND [Calculation_3379458992373030916]&#10;            THEN [confirmed_orders]&#10;            END) &#10;        }&#10;    )&#10;END' />
            </column>
            <column caption='# SFTP Stock Items Updated per Ordered Item' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[# SFTP Stock Jobs per Order (copy)_2049700832503750656]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([nr_updated_active_count_products_completed]) / SUM([qty_ordered])' />
            </column>
            <column caption='# SFTP Stock Items Updated per Ordered Item (country avg)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[# SFTP Stock Jobs per Order (country avg) (copy)_1537979325883822081]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF COUNTD([country]) &gt; 1 OR COUNTD([Calculation_146789252127698948]) &gt; 1 THEN NULL ELSE&#10;    SUM(&#10;        {FIXED [management_entity], [country], [granularity], [Calculation_2049700832507019265]&#10;        : &#10;        SUM(IF &#10;            [has_confirmed_orders] = TRUE&#10;            AND [has_sftp_jobs] = TRUE&#10;            AND [Calculation_146789251840057347] = TRUE&#10;            AND [Calculation_146789251839336450] = TRUE&#10;            AND LOWER([picking_app]) = &apos;pelican&apos;&#10;            AND [Calculation_3379458992373030916]&#10;            THEN [nr_updated_active_count_products_completed]&#10;            END)&#10;        /&#10;        SUM(IF &#10;            [has_confirmed_orders] = TRUE&#10;            AND [has_sftp_jobs] = TRUE&#10;            AND [Calculation_146789251840057347] = TRUE&#10;            AND [Calculation_146789251839336450] = TRUE&#10;            AND LOWER([picking_app]) = &apos;pelican&apos;&#10;            AND [Calculation_3379458992373030916]&#10;            THEN [qty_ordered]&#10;            END) &#10;        }&#10;    )&#10;END' />
            </column>
            <column caption='% Not Delivered (country avg)' datatype='real' default-format='p0.0%' name='[# SFTP Stock Jobs per Order (country avg) (copy)_1537979325901737986]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF COUNTD([country]) &gt; 1 OR COUNTD([Calculation_146789252127698948]) &gt; 1 THEN NULL ELSE&#10;    SUM(&#10;        {FIXED [management_entity], [country], [granularity], [Calculation_2049700832507019265]&#10;        : &#10;        SUM(IF &#10;            [has_confirmed_orders] = TRUE&#10;            AND [has_sftp_jobs] = TRUE&#10;            AND [Calculation_146789251840057347] = TRUE&#10;            AND [Calculation_146789251839336450] = TRUE&#10;            AND LOWER([picking_app]) = &apos;pelican&apos;&#10;            AND [Calculation_3379458992373030916]&#10;            THEN &#10;            (&#10;                ([in_cart_pelican_items] - [in_cart_pelican_items_sold])&#10;                + [not_found_pelican_items]&#10;                + ([replaced_pelican_items] - [replaced_pelican_items_sold] - [replacements_pelican_items])&#10;                + [oos_failed_pelican_items]&#10;            )&#10;            END)&#10;        /&#10;        SUM(IF &#10;            [has_confirmed_orders] = TRUE&#10;            AND [has_sftp_jobs] = TRUE&#10;            AND [Calculation_146789251840057347] = TRUE&#10;            AND [Calculation_146789251839336450] = TRUE&#10;            AND LOWER([picking_app]) = &apos;pelican&apos;&#10;            AND [Calculation_3379458992373030916]&#10;            THEN (&#10;                [in_cart_pelican_items]&#10;                + [not_found_pelican_items]&#10;                + [not_processed_pelican_items]&#10;                + [replaced_pelican_items]&#10;                + [oos_failed_pelican_items]&#10;            )&#10;            END) &#10;        }&#10;    )&#10;END' />
            </column>
            <column caption='# SFTP Stock Jobs per Vendor (country avg)' datatype='real' default-format='n#,##0;-#,##0' name='[# SFTP Stock Jobs per Order (country avg) (copy)_2987082874811224065]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF COUNTD([country]) &gt; 1 OR COUNTD([Calculation_146789252127698948]) &gt; 1 THEN NULL ELSE&#10;    SUM(&#10;        {FIXED [management_entity], [country], [granularity], [Calculation_2049700832507019265]&#10;        : &#10;        SUM(IF &#10;            [has_confirmed_orders] = TRUE&#10;            AND [has_sftp_jobs] = TRUE&#10;            AND [Calculation_146789251840057347] = TRUE&#10;            AND [Calculation_146789251839336450] = TRUE&#10;            AND LOWER([picking_app]) = &apos;pelican&apos;&#10;            AND [Calculation_3379458992373030916]&#10;            THEN [nr_jobs_updated_product_completed]&#10;            END)&#10;        /&#10;        COUNTD(IF &#10;            [has_confirmed_orders] = TRUE&#10;            AND [has_sftp_jobs] = TRUE&#10;            AND [Calculation_146789251840057347] = TRUE&#10;            AND [Calculation_146789251839336450] = TRUE&#10;            AND LOWER([picking_app]) = &apos;pelican&apos;&#10;            AND [Calculation_3379458992373030916]&#10;            THEN [Chain Name + Id (copy)_146789252132700165]&#10;            END) &#10;        }&#10;    )&#10;END' />
            </column>
            <column caption='$ Not Delivered GMV Loss ' datatype='real' default-format='c#,##0&quot; €&quot;;-#,##0&quot; €&quot;' name='[$ Not Delivered GMV Loss (copy 2)_4889572243188088835]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    SUM(&#10;        ([in_cart_pelican_total_price_eur] - [in_cart_pelican_total_price_eur_sold])&#10;        + [not_found_pelican_total_price_eur]&#10;        + ([replaced_pelican_total_price_eur] - [replaced_pelican_total_price_eur_sold] - [replacements_pelican_total_price_eur])&#10;        + [oos_failed_pelican_orders_items_price_eur]&#10;    ) /&#10;    COUNTD([Calculation_2049700832507019265])&#10;)' />
            </column>
            <column caption='# SFTP Stock Jobs per Vendor' datatype='real' default-format='n#,##0;-#,##0' name='[$ Not Delivered GMV Loss per Vendor (copy)_2987082874780422144]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([nr_jobs_updated_product_completed]) / COUNTD([Chain Name + Id (copy)_146789252132700165])' />
            </column>
            <column caption='$ Not Delivered GMV Loss per Vendor ' datatype='real' default-format='c#,##0&quot; €&quot;;-#,##0&quot; €&quot;' name='[$ Not Delivered GMV Loss per Vendor (copy)_4889572243187986434]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[% Not Delivered (copy)_146789252174286860] / COUNTD([Chain Name + Id (copy)_146789252132700165])' />
