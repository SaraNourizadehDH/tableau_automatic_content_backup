                <zone h='2500' id='2887' mode='checkdropdown' name='Score by Country' param='[federated.15w313a16lxy7n1dyvkx90hmistu].[none:both_sftp_api_jobs_flag:ok]' show-apply='true' type-v2='filter' values='database' w='6617' x='93015' y='6250'>
