      <aliases enabled='yes' />
      <column caption='               % of Items with Stock &amp; Price Changed' datatype='real' default-format='p0.0%' name='[               % of Products with Stock Changed (copy)_262686577377456164]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([          % of Changed Products (copy)_262686577375961122] + [          % of Changed Products - Stock (copy)_262686577376079907])&#10;- 1' />
      </column>
      <column caption='               % of Items with Stock Changed' datatype='real' default-format='p0.0%' name='[          % of Changed Products (copy)_262686577375961122]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nr_updated_stock_count_products_completed]) / SUM([nr_changed_products_completed])' />
      </column>
      <column caption='               % of Items with Price Changed' datatype='real' default-format='p0.0%' name='[          % of Changed Products - Stock (copy)_262686577376079907]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nr_updated_price_count_products_completed]) / SUM([nr_changed_products_completed])' />
      </column>
      <column caption='               % of Unchanged Items' datatype='real' default-format='p0.0%' name='[          % of Failed Items (copy)_262686577379766312]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([nr_total_count_completed]) - SUM([nr_processed_products_completed]) &#10;- SUM([nr_failed_count_completed]))&#10;/ SUM([nr_total_count_completed])' />
      </column>
      <column caption='          % of SFTP Jobs with Unchanged Items Updated' datatype='real' default-format='p0.0%' name='[          % of Jobs with Items Updates Failed or Unchanged  (copy)_262686577359249439]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nr_jobs_with_unchanged_items_updated_completed]) / SUM([nr_jobs_completed])' />
      </column>
      <column caption='          % of Processed Items' datatype='real' default-format='p0.0%' name='[          % of Jobs with New Items Updates (copy)_262686577379205158]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nr_processed_products_completed]) / SUM([nr_total_count_completed])' />
      </column>
      <column caption='               % of Failed Items' datatype='real' default-format='p0.0%' name='[          % of Processed Items (copy)_262686577379475495]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nr_failed_count_completed]) / SUM([nr_total_count_completed])' />
      </column>
      <column caption='          % of Not Processed Items' datatype='real' default-format='p0.0%' name='[          % of Processed Items (copy)_262686577705320495]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([          % of Processed Items (copy)_262686577379475495] + [          % of Failed Items (copy)_262686577379766312])' />
      </column>
      <column caption='          % of SFTP Jobs with Failed Items Updated' datatype='real' default-format='p0.0%' name='[          Nr Jobs New Product (copy)_262686577299267614]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nr_jobs_with_failed_items_updated_completed]) / SUM([nr_jobs_completed])' />
      </column>
      <column caption='          % of SFTP Jobs with Stock Updates' datatype='real' default-format='p0.0%' name='[          Nr Jobs New Product Completed (copy)_262686577296982041]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nr_jobs_updated_product_completed]) / SUM([nr_jobs_completed])' />
      </column>
      <column caption='          % of New Items' datatype='real' default-format='p0.0%' name='[          Nr Jobs Updated Price Completed (copy)_262686577298649117]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nr_new_count_products_completed]) / SUM([nr_processed_products_completed])' />
      </column>
      <column caption='          % of SFTP Jobs with Price Updates' datatype='real' default-format='p0.0%' name='[          Nr Jobs Updated Product Completed (copy)_262686577297809434]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nr_jobs_updated_price_completed]) / SUM([nr_jobs_completed])' />
      </column>
      <column caption='     # of Processed Items' datatype='integer' name='[          Nr Jobs Updated Product Completed (copy)_262686577298161692]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nr_processed_products_completed])' />
      </column>
      <column caption='     % OOS Fail Rate' datatype='real' default-format='p0.00%' name='[     % Not Delivered (copy)_262686577293525012]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[% Partial Fulfilled Items (copy)_1860831095852757033]' />
      </column>
      <column caption='     % of SFTP Jobs for Stock' datatype='real' default-format='p0.00%' hidden='true' name='[     % OOS Failed Orders (copy)_262686577293774869]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_262686577284239370]' />
      </column>
      <column caption='     % of Items Update for Stock' datatype='real' default-format='p0.00%' hidden='true' name='[     % of SFTP Jobs for Stock (copy)_262686577294037014]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[% of Stock SFTP Jobs (copy)_262686577284640779]' />
      </column>
      <column caption='     # of Items send in SFTP Files [/ 1M] (completed jobs)' datatype='integer' default-format='n#,##0,,.0M;-#,##0,,.0M' name='[     Nr Processed Products (copy)_262686577377992741]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nr_total_count_completed])' />
      </column>
      <column caption='# Campaigns Updates - (promo card)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[# Campaigns - (promo card) (copy)_169799810258542604]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [period_num] = [Parameters].[Parameter 5] THEN&#10;        IF [Parameters].[Parameter 8] THEN [sftp_campaign_total_num_of_updates_active]&#10;        ELSE [sftp_campaign_total_num_of_updates] END&#10;        ELSE 0&#10;    END&#10;) / &#10;SUM(&#10;    IF [period_num] = [Parameters].[Parameter 5] THEN&#10;        IF [Parameters].[Parameter 8] THEN [sftp_campaign_counting_active]&#10;        ELSE [sftp_campaign_counting_total] END&#10;        ELSE 0&#10;    END&#10;)' />
      </column>
      <column caption='# Impacted Products - (promo card)' datatype='integer' default-format='n#,##0,,.00M;-#,##0,,.00M' name='[# Campaigns - (promo card) (copy)_169799810272096274]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [period_num] = [Parameters].[Parameter 5] THEN&#10;        IF [Parameters].[Parameter 8] THEN [sftp_campaign_total_product_impacted_active]&#10;        ELSE [sftp_campaign_total_product_impacted] END&#10;        ELSE 0&#10;    END&#10;)' />
      </column>
      <column caption='# Campaigns' datatype='integer' default-format='n#,##0,.0K;-#,##0,.0K' name='[# Campaigns - (promo card) (copy)_169799810287341601]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Parameters].[Parameter 8] THEN [sftp_campaign_counting_active] &#10;ELSE [sftp_campaign_counting_total] END)' />
      </column>
      <column caption='# Campaigns Updates - Diff (promo card)' datatype='real' default-format='p0.0%' name='[# Campaigns - Diff (promo card) (copy)_169799810258542605]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(((&#10;    SUM(&#10;        IF [period_num] = [Parameters].[Parameter 5] THEN&#10;            IF [Parameters].[Parameter 8] THEN [sftp_campaign_total_num_of_updates_active]&#10;            ELSE [sftp_campaign_total_num_of_updates] END&#10;            ELSE 0&#10;        END&#10;    ) / &#10;    SUM(&#10;        IF [period_num] = [Parameters].[Parameter 5] THEN&#10;            IF [Parameters].[Parameter 8] THEN [sftp_campaign_counting_active]&#10;            ELSE [sftp_campaign_counting_total] END&#10;            ELSE 0&#10;        END&#10;    ))&#10;    /(&#10;    SUM(&#10;        IF [period_num] = [Parameters].[Cards Period 1 (copy)_1278529740053532683] THEN&#10;            IF [Parameters].[Parameter 8] THEN [sftp_campaign_total_num_of_updates_active]&#10;            ELSE [sftp_campaign_total_num_of_updates] END&#10;            ELSE 0&#10;        END&#10;    ) / &#10;    SUM(&#10;        IF [period_num] = [Parameters].[Cards Period 1 (copy)_1278529740053532683] THEN&#10;            IF [Parameters].[Parameter 8] THEN [sftp_campaign_counting_active]&#10;            ELSE [sftp_campaign_counting_total] END&#10;            ELSE 0&#10;        END&#10;    )&#10;)) -1 )' />
      </column>
      <column caption='# Impacted Products - Diff (promo card)' datatype='real' default-format='p0.0%' name='[# Campaigns - Diff (promo card) (copy)_169799810272096275]' role='measure' type='quantitative'>
