      <column caption='% Not Delivered (country avg)' datatype='real' default-format='p0.0%' name='[# SFTP Stock Jobs per Order (country avg) (copy)_1537979325901737986]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF COUNTD([country]) &gt; 1 OR COUNTD([Calculation_146789252127698948]) &gt; 1 THEN NULL ELSE&#10;    SUM(&#10;        {FIXED [management_entity], [country], [granularity], [Calculation_2049700832507019265]&#10;        : &#10;        SUM(IF &#10;            [has_confirmed_orders] = TRUE&#10;            AND [has_sftp_jobs] = TRUE&#10;            AND [Calculation_146789251840057347] = TRUE&#10;            AND [Calculation_146789251839336450] = TRUE&#10;            AND LOWER([picking_app]) = &apos;pelican&apos;&#10;            AND [Calculation_3379458992373030916]&#10;            THEN &#10;            (&#10;                ([in_cart_pelican_items] - [in_cart_pelican_items_sold])&#10;                + [not_found_pelican_items]&#10;                + ([replaced_pelican_items] - [replaced_pelican_items_sold] - [replacements_pelican_items])&#10;                + [oos_failed_pelican_items]&#10;            )&#10;            END)&#10;        /&#10;        SUM(IF &#10;            [has_confirmed_orders] = TRUE&#10;            AND [has_sftp_jobs] = TRUE&#10;            AND [Calculation_146789251840057347] = TRUE&#10;            AND [Calculation_146789251839336450] = TRUE&#10;            AND LOWER([picking_app]) = &apos;pelican&apos;&#10;            AND [Calculation_3379458992373030916]&#10;            THEN (&#10;                [in_cart_pelican_items]&#10;                + [not_found_pelican_items]&#10;                + [not_processed_pelican_items]&#10;                + [replaced_pelican_items]&#10;                + [oos_failed_pelican_items]&#10;            )&#10;            END) &#10;        }&#10;    )&#10;END' />
      </column>
