          <alias key='&quot;[federated.1fuq3z8183xyzc1emsxbk122blh0].[usr:\% Not Delivered (copy)_1537979325925670916:qk]&quot;' value='     % ND due to In Cart Diff' />
          <alias key='&quot;[federated.1fuq3z8183xyzc1emsxbk122blh0].[usr:\% Not Delivered (copy)_1537979325925945349:qk]&quot;' value='     % ND due to Not Found' />
          <alias key='&quot;[federated.1fuq3z8183xyzc1emsxbk122blh0].[usr:\% Not Delivered (copy)_1537979325926338566:qk]&quot;' value='     % ND due to OOS Failed Items' />
          <alias key='&quot;[federated.1fuq3z8183xyzc1emsxbk122blh0].[usr:$ Not Delivered GMV Loss per Vendor (copy)_2987082874780422144:qk]&quot;' value='     # API Stock Jobs per Vendor' />
          <alias key='&quot;[federated.1fuq3z8183xyzc1emsxbk122blh0].[usr:$ Not Delivered GMV Loss per Vendor (copy)_4889572243187986434:qk]&quot;' value='     $ Not Delivered GMV Loss per Vendor ' />
          <alias key='&quot;[federated.1fuq3z8183xyzc1emsxbk122blh0].[usr:Calculation_146789252162138121:qk]&quot;' value='     # API Stock Jobs per Order' />
          <alias key='&quot;[federated.1fuq3z8183xyzc1emsxbk122blh0].[usr:Calculation_3876754904291196936:qk]&quot;' value='% Items Not Delivered' />
        </aliases>
      </column>
      <column caption='Chain List to Filter Calc' datatype='boolean' name='[Calculation_146789251835453440]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] THEN&#10;    IF [Parameters].[Vendors List to Filter (copy)_3194529905697562660] != &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Vendors List to Filter (copy)_3194529905697562660], [chain_id]) THEN TRUE ELSE FALSE END&#10;        ELSE TRUE&#10;    END&#10;ELSE&#10;    IF [Parameters].[Vendors List to Filter (copy)_3194529905697562660] != &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Vendors List to Filter (copy)_3194529905697562660], [chain_id]) THEN FALSE ELSE TRUE END&#10;        ELSE TRUE&#10;    END&#10;END' />
      </column>
      <column caption='Vendors List to Filter Calc' datatype='boolean' name='[Calculation_146789251835617281]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] THEN&#10;    IF [Parameters].[Parameter 1] != &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Parameter 1], [vendor_id]) THEN TRUE ELSE FALSE END&#10;        ELSE TRUE&#10;    END&#10;ELSE&#10;    IF [Parameters].[Parameter 1] != &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Parameter 1], [vendor_id]) THEN FALSE ELSE TRUE END&#10;        ELSE TRUE&#10;    END&#10;END' />
      </column>
      <column caption='Filter Outliers' datatype='boolean' name='[Calculation_146789251839336450]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [granularity]&#10;    &#10;        WHEN &apos;daily&apos; THEN&#10;&#10;            IF [confirmed_orders] &gt; 1 THEN&#10;                IF [nr_jobs_updated_product_completed] &lt;= 3  THEN&#10;                    IF [gmv_net_eur] / [nr_jobs_updated_product_completed] &lt; 100 THEN TRUE ELSE FALSE END&#10;                ELSE TRUE END&#10;            ELSE TRUE END&#10;&#10;    WHEN &apos;weekly&apos; THEN&#10;&#10;        IF [confirmed_orders] &gt; 1 THEN&#10;            IF [nr_jobs_updated_product_completed] &lt;= 3  THEN&#10;                IF [gmv_net_eur] / [nr_jobs_updated_product_completed] &lt; 100 THEN TRUE ELSE FALSE END&#10;            ELSE TRUE END&#10;        ELSE TRUE END&#10;&#10;    WHEN &apos;monthly&apos; THEN&#10;&#10;        IF [confirmed_orders] &gt; 1 THEN&#10;            IF [nr_jobs_updated_product_completed] &lt;= 15  THEN&#10;                IF [gmv_net_eur] / [nr_jobs_updated_product_completed] &lt; 700 THEN TRUE ELSE FALSE END&#10;            ELSE TRUE END&#10;        ELSE TRUE END&#10;&#10;    WHEN &apos;quarterly&apos; THEN&#10;&#10;        IF [confirmed_orders] &gt; 1 THEN&#10;            IF [nr_jobs_updated_product_completed] &lt;= 30  THEN&#10;                IF [gmv_net_eur] / [nr_jobs_updated_product_completed] &lt; 1400 THEN TRUE ELSE FALSE END&#10;            ELSE TRUE END&#10;        ELSE TRUE END&#10;&#10;END' />
      </column>
      <column caption='Has SFTP Stock Job' datatype='boolean' name='[Calculation_146789251840057347]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [nr_jobs_updated_product_completed] &gt;= 1 THEN TRUE &#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='Chain Name + Country' datatype='string' name='[Calculation_146789252127698948]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[In / Out (copy 2)]&#10;WHEN &quot;1&quot; THEN [chain_name] + &quot; (&quot; + [country_code] + &quot;)&quot;&#10;ELSE [chain_id] + &quot; - &quot; + [chain_name]&#10;END' />
      </column>
      <column caption='Vendor (by Chain)' datatype='string' name='[Calculation_146789252133146630]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_146789252127698948] = [Parameters].[Parameter 10] THEN [Chain Name + Id (copy)_146789252132700165] ELSE &quot;&quot; END' />
      </column>
      <column caption='Filter Vendors' datatype='boolean' name='[Calculation_146789252137971720]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Selected Chain (copy)_146789252136169479] = &quot;&quot; THEN TRUE ELSE&#10;IF [Chain Name + Id (copy)_146789252132700165] = [Parameters].[Selected Chain (copy)_146789252136169479] THEN TRUE ELSE FALSE END&#10;END' />
      </column>
      <column caption='# SFTP Stock Jobs per Order' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_146789252162138121]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nr_jobs_updated_product_completed]) / SUM([confirmed_orders])' />
      </column>
      <column caption='% of SFTP Stock Jobs' datatype='real' default-format='p0%' name='[Calculation_146789252164927498]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nr_jobs_updated_product_completed])/ SUM([nr_jobs_completed])' />
      </column>
      <column caption='# of Vendors' datatype='integer' name='[Calculation_146789252171833355]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Chain Name + Id (copy)_146789252132700165])' />
      </column>
      <column caption='Local Date ' datatype='string' name='[Calculation_2049700832507019265]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([local_date])' />
      </column>
      <column caption='Filter Date' datatype='boolean' name='[Calculation_2049700832507432962]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 11] = &quot;&quot; THEN TRUE ELSE&#10;IF [Parameters].[Parameter 11] = [Calculation_2049700832507019265] THEN TRUE ELSE FALSE END&#10;END' />
      </column>
      <column caption='% Failed Lines' datatype='real' default-format='p0.0%' name='[Calculation_3379458992367747074]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nr_failed_count_products]) &#10;/ SUM([nr_failed_count_products] + [nr_processed_products_completed])' />
      </column>
      <column caption='No new vendors' datatype='boolean' name='[Calculation_3379458992373030916]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [vendor_activation_local_date] &lt; TODAY() - 90 THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='% Not Delivered' datatype='real' default-format='p0.0%' name='[Calculation_3876754904291196936]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;    SUM(&#10;        ([in_cart_pelican_items] - [in_cart_pelican_items_sold])&#10;        + [not_found_pelican_items]&#10;        + ([replaced_pelican_items] - [replaced_pelican_items_sold] - [replacements_pelican_items])&#10;        + [oos_failed_pelican_items]&#10;    )&#10;    /&#10;    SUM(&#10;        [in_cart_pelican_items]&#10;        + [not_found_pelican_items]&#10;        + [not_processed_pelican_items]&#10;        + [replaced_pelican_items]&#10;        + [oos_failed_pelican_items]&#10;    )&#10;)' />
      </column>
      <column caption='YearMonth' datatype='string' name='[Calculation_3876754904632078350]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(DATE(DATETRUNC(&apos;month&apos;,[local_date])))' />
      </column>
      <column caption='Metric' datatype='real' name='[Calculation_3876754904689086483]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 9]&#10;    WHEN &apos;1&apos; THEN INT(ROUND(SUM([nr_jobs_completed]), 0))&#10;    WHEN &apos;2&apos; THEN INT(ROUND(SUM([nr_jobs_updated_product_completed]), 0))&#10;    WHEN &apos;3&apos; THEN INT(ROUND(SUM([nr_jobs_updated_price_completed]), 0))&#10;    WHEN &apos;4&apos; THEN FLOAT(ROUND(SUM([nr_jobs_updated_product_completed]) / SUM([total_orders]), 4))&#10;END' />
      </column>
      <column caption='SFTP Type' datatype='string' name='[Calculation_3876754905706356760]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [sftp_type_is_central] THEN &apos;Central SFTP&apos; ELSEIF [sftp_type_is_legacy] THEN &apos;Legacy SFTP&apos; ELSE &apos;Non SFTP&apos; END' />
      </column>
      <column caption='Text SFTP' datatype='string' name='[Calculation_4140004383241224199]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 12]&#10;WHEN &quot;1&quot; THEN &quot;These metrics are being calculated considering all API Jobs.&quot;&#10;WHEN &quot;2&quot; THEN &quot;These metrics are being calculated only considering Jobs with Stock Updates.&quot;&#10;WHEN &quot;3&quot; THEN &quot;These metrics are being calculated only considering Jobs with Price Updates.&quot;&#10;END' />
      </column>
      <column caption='Show Actual Period' datatype='boolean' name='[Calculation_4889572243176935424]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[How many periods do you want to see (copy)] = TRUE &#10;    THEN TRUE&#10;    ELSEIF [period_num] = &apos;1&apos; THEN FALSE &#10;    ELSE TRUE&#10;END' />
      </column>
      <column caption='Periods to see' datatype='boolean' name='[Calculation_4889572243184984065]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF INT([period_num]) &lt;= [Parameters].[Replaced Pelican Items Parameter] + 1 &#10;THEN &#10;    IF [Parameters].[How many periods do you want to see (copy)] &#10;    THEN &#10;        IF INT([period_num]) &lt;= [Parameters].[Replaced Pelican Items Parameter] &#10;        THEN TRUE &#10;        ELSE FALSE &#10;        END &#10;    ELSE &#10;        IF INT([period_num]) &gt; 1 &#10;        THEN TRUE &#10;        ELSE FALSE &#10;        END&#10;    END &#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_701435693256691712]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]=USERNAME()' />
      </column>
      <column caption='Vendor Name + Id' datatype='string' name='[Chain Name + Id (copy)_146789252132700165]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[vendor_id] + &quot; - &quot; + [vendor_name]' />
      </column>
      <column caption='Filter Hour' datatype='boolean' name='[Filter Date (copy)_2049700832509202436]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Selected Date 2 (copy)_2049700832509140995] = &quot;&quot; THEN TRUE ELSE&#10;IF [Parameters].[Selected Date 2 (copy)_2049700832509140995] = [Local Hour Grouped 1] THEN TRUE ELSE FALSE END&#10;END' />
      </column>
      <column caption='Filter Chains' datatype='boolean' name='[Filter Vendors (copy)_6770036145858301953]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 10] = &quot;&quot; THEN TRUE ELSE&#10;IF [Calculation_146789252127698948] = [Parameters].[Parameter 10] THEN TRUE ELSE FALSE END&#10;END' />
      </column>
      <column datatype='date' default-format='*yy/mm/dd' name='[Local Date (Exact)]' role='dimension' type='quantitative' user:agg-type='None' user:base-field='local_date' user:ui-builder='date-bin-builder'>
        <calculation class='tableau' formula='[local_date]' />
      </column>
