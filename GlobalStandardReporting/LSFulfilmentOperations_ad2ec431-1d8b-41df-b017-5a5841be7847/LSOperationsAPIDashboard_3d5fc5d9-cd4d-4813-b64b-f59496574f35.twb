                <alias key='&quot;2&quot;' value='Chain Name with Id (Non-curated data)' />
              </aliases>
            </column>
            <column alias='Any Vendor with API Jobs' caption='API Jobs to See' datatype='string' name='[Parameter 12]' param-domain-type='list' role='measure' type='nominal' value='&quot;1&quot;'>
              <calculation class='tableau' formula='&quot;1&quot;' />
              <aliases>
                <alias key='&quot;1&quot;' value='Any Vendor with API Jobs' />
                <alias key='&quot;2&quot;' value='Any Vendor with API Jobs that Updates Stock' />
                <alias key='&quot;3&quot;' value='Any Vendor with API Jobs that Updates Prices' />
              </aliases>
            </column>
            <column caption='Vendor IDs Filter' datatype='string' name='[Parameter 1]' param-domain-type='any' role='measure' type='nominal' value='&quot;&quot;'>
              <calculation class='tableau' formula='&quot;&quot;' />
            </column>
            <column alias='In' caption='In / Out' datatype='boolean' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
              <aliases>
                <alias key='false' value='Out' />
                <alias key='true' value='In' />
              </aliases>
            </column>
            <column caption='Cards Period 1' datatype='integer' name='[Parameter 5]' param-domain-type='any' role='measure' type='quantitative' value='2'>
              <calculation class='tableau' formula='2' />
            </column>
            <column alias='# API Jobs' caption='Metrics Cards' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;2&quot;'>
              <calculation class='tableau' formula='&quot;2&quot;' />
              <aliases>
                <alias key='&quot;1&quot;' value='$ GMV Net' />
                <alias key='&quot;10&quot;' value='% Items Stock Updates through API' />
                <alias key='&quot;11&quot;' value='% of Processed Items through API' />
                <alias key='&quot;12&quot;' value='% of Failed Items through API' />
                <alias key='&quot;13&quot;' value='% of Unchanged Items through API' />
                <alias key='&quot;14&quot;' value='% of Not Processed Items through API' />
                <alias key='&quot;15&quot;' value='# API Vendors' />
                <alias key='&quot;16&quot;' value='# Items Stock Updates through API' />
                <alias key='&quot;2&quot;' value='# API Jobs' />
                <alias key='&quot;3&quot;' value='# Every How Many Days Vendors Updates API' />
                <alias key='&quot;4&quot;' value='# Average Num. of API Updates per Day' />
                <alias key='&quot;5&quot;' value='% Not Delivered' />
                <alias key='&quot;6&quot;' value='% OOS Fail Rate' />
                <alias key='&quot;7&quot;' value='% Ratio API Updates vs Total Assortment' />
                <alias key='&quot;8&quot;' value='% API Vendors' />
                <alias key='&quot;9&quot;' value='% API Jobs with Stock Updates' />
              </aliases>
            </column>
            <column caption='Chain IDs Filter' datatype='string' name='[Vendors List to Filter (copy)_3194529905697562660]' param-domain-type='any' role='measure' type='nominal' value='&quot;&quot;'>
              <calculation class='tableau' formula='&quot;&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.15w313a16lxy7n1dyvkx90hmistu'>
            <column caption='Filter Outliers (card)' datatype='boolean' name='[Calculation_1278529741041209407]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = &apos;8&apos; THEN TRUE ELSE&#10;&#10;    CASE [granularity]&#10;    &#10;        WHEN &apos;daily&apos; THEN&#10;&#10;            IF [confirmed_orders] &gt; 1 THEN&#10;                IF [Calculation_262686577636798505] &lt;= 3  THEN&#10;                    IF [gmv_net_eur] / [Calculation_262686577636798505] &lt; 100 THEN TRUE ELSE FALSE END&#10;                ELSE TRUE END&#10;            ELSE TRUE END&#10;    &#10;        WHEN &apos;weekly&apos; THEN&#10;&#10;            IF [confirmed_orders] &gt; 1 THEN&#10;                IF [Calculation_262686577636798505] &lt;= 3  THEN&#10;                    IF [gmv_net_eur] / [Calculation_262686577636798505] &lt; 100 THEN TRUE ELSE FALSE END&#10;                ELSE TRUE END&#10;            ELSE TRUE END&#10;&#10;        WHEN &apos;monthly&apos; THEN&#10;&#10;            IF [confirmed_orders] &gt; 1 THEN&#10;                IF [Calculation_262686577636798505] &lt;= 15  THEN&#10;                    IF [gmv_net_eur] / [Calculation_262686577636798505] &lt; 700 THEN TRUE ELSE FALSE END&#10;                ELSE TRUE END&#10;            ELSE TRUE END&#10;&#10;        WHEN &apos;quarterly&apos; THEN&#10;&#10;            IF [confirmed_orders] &gt; 1 THEN&#10;                IF [Calculation_262686577636798505] &lt;= 30  THEN&#10;                    IF [gmv_net_eur] / [Calculation_262686577636798505] &lt; 1400 THEN TRUE ELSE FALSE END&#10;                ELSE TRUE END&#10;            ELSE TRUE END&#10;&#10;    END&#10;END' />
            </column>
            <column caption='Cards Title' datatype='string' name='[Calculation_1278529741365178433]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(&quot;Date: &quot;) &#10;+ STR(IF [period_num] = [Parameters].[Parameter 5] THEN [Calculation_1860831094529859592] ELSE NULL END) &#10;+ STR(&quot; (&quot; + [granularity] + &quot;)&quot;) &#10;+ STR(IF[Parameters].[Parameter 5] = 1 THEN &quot; - This Period is still in progress    &quot; ELSE &quot;   &quot; END)' />
            </column>
            <column caption='Local Date ' datatype='string' name='[Calculation_1860831094529859592]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [granularity]&#10;    WHEN &apos;daily&apos; THEN RIGHT(STR(DATE([local_date])),5) + &quot;  &quot; + LEFT(DATENAME(&apos;weekday&apos;, [local_date]), 3)&#10;    WHEN &apos;weekly&apos; THEN RIGHT(STR(DATE(DATETRUNC(&apos;week&apos;,[local_date], &apos;monday&apos;))),8)&#10;    WHEN &apos;monthly&apos; THEN LEFT(RIGHT(STR(DATE(DATETRUNC(&apos;month&apos;,[local_date]))),8), 5)&#10;    WHEN &apos;quarterly&apos; THEN LEFT(RIGHT(STR(DATE(DATETRUNC(&apos;quarter&apos;,[local_date]))),8), 5)&#10;END' />
            </column>
            <column caption='SFTP Jobs to see' datatype='integer' name='[Calculation_262686577636798505]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 12]&#10;WHEN &apos;1&apos; THEN [nr_jobs_completed]&#10;WHEN &apos;2&apos; THEN [nr_jobs_updated_product_completed]&#10;WHEN &apos;3&apos; THEN [nr_jobs_updated_price_completed]&#10;WHEN &apos;4&apos; THEN [nr_jobs_new_product_completed]&#10;END' />
            </column>
            <column caption='Vendor Name + id' datatype='string' name='[Calculation_3194529904736956426]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[vendor_id] + &quot; - &quot; +[vendor_name]' />
            </column>
            <column caption='Has Complete Jobs to Update Stock (card)' datatype='boolean' name='[Calculation_3194529905047035928]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = &apos;8&apos; THEN TRUE &#10;ELSEIF [Calculation_262686577636798505] &gt;= 1 THEN TRUE &#10;ELSEIF [Parameters].[Deep Dive Metric (copy)] = TRUE THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='SFTP Type' datatype='string' name='[Calculation_3194529905058963481]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [sftp_type_is_central] THEN &apos;Central SFTP&apos; ELSEIF [sftp_type_is_legacy] THEN &apos;Legacy SFTP&apos; ELSE &apos;Non SFTP&apos; END' />
            </column>
            <column caption='Vendors List to Filter Calc' datatype='boolean' name='[Calculation_3194529905693958179]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] THEN&#10;    IF [Parameters].[Parameter 1] != &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Parameter 1], [vendor_id]) THEN TRUE ELSE FALSE END&#10;        ELSE TRUE&#10;    END&#10;ELSE&#10;    IF [Parameters].[Parameter 1] != &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Parameter 1], [vendor_id]) THEN FALSE ELSE TRUE END&#10;        ELSE TRUE&#10;    END&#10;END' />
            </column>
            <column caption='Chain Name + Country' datatype='string' name='[Calculation_3194529905745088555]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[In / Out (copy 2)]&#10;WHEN &quot;1&quot; THEN [chain_name] + &quot; (&quot; + [country_code] + &quot;)&quot;&#10;ELSE [chain_id] + &quot; - &quot; + [chain_name]&#10;END' />
            </column>
            <column caption='Chain List to Filter Calc' datatype='boolean' name='[Vendors List to Filter Calc (copy)_3194529905697677349]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] THEN&#10;    IF [Parameters].[Vendors List to Filter (copy)_3194529905697562660] != &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Vendors List to Filter (copy)_3194529905697562660], [chain_id]) THEN TRUE ELSE FALSE END&#10;        ELSE TRUE&#10;    END&#10;ELSE&#10;    IF [Parameters].[Vendors List to Filter (copy)_3194529905697562660] != &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Vendors List to Filter (copy)_3194529905697562660], [chain_id]) THEN FALSE ELSE TRUE END&#10;        ELSE TRUE&#10;    END&#10;END' />
            </column>
            <column aggregation='Sum' datatype='integer' name='[both_sftp_api_jobs_flag]' role='dimension' type='ordinal'>
              <aliases>
                <alias key='0' value='NO' />
                <alias key='1' value='YES' />
              </aliases>
            </column>
            <column caption='Chain Id' datatype='string' name='[chain_id]' role='dimension' type='nominal' />
            <column caption='Chain Name' datatype='string' name='[chain_name]' role='dimension' type='nominal' />
