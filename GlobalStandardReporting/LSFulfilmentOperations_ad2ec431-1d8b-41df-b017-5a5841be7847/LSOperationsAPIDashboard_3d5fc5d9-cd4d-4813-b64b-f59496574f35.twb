                <zone h='2500' id='2826' mode='checkdropdown' name='Score by Chain' param='[federated.15w313a16lxy7n1dyvkx90hmistu].[none:Calculation_3194529904736956426:nk]' show-apply='true' type-v2='filter' values='relevant' w='6618' x='66544' y='6250'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
