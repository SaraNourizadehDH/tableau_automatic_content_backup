        <zone forceUpdate='true' h='9350' hidden-by-user='true' id='560' type-v2='text' w='20147' x='79118' y='5100'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='12'>How to read this chart?</run>
            <run>Æ&#10;&#10;</run>
          </formatted-text>
