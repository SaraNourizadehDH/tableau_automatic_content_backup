                <run fontcolor='#000000'>((A + B + C + E) / 4)  * 10 = </run>
                <run bold='true' fontcolor='#000000'>Æ </run>
                <run fontcolor='#000000'>General Score </run>
                <run>Æ&#10;&#10;</run>
