        <calculation class='tableau' formula='COUNTD(&#10;IF [gmv_net_eur] &gt; 0 AND [Calculation_262686577636798505] &gt; 0  THEN&#10;    [vendor_id]&#10;    ELSE NULL&#10;END&#10;) / &#10;COUNTD(&#10;IF [gmv_net_eur] &gt; 0 THEN&#10;    [vendor_id]&#10;    ELSE NULL&#10;END&#10;)' />
