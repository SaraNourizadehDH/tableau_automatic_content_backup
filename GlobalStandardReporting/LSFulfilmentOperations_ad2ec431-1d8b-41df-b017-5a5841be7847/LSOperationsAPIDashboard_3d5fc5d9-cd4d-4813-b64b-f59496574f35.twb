        <calculation class='tableau' formula='IF COUNTD([country]) &gt; 1 OR COUNTD([Calculation_146789252127698948]) &gt; 1 THEN NULL ELSE&#10;    SUM(&#10;        {FIXED [management_entity], [country], [granularity], [Calculation_2049700832507019265]&#10;        : &#10;        SUM(IF &#10;            [has_confirmed_orders] = TRUE&#10;            AND [has_sftp_jobs] = TRUE&#10;            AND [Calculation_146789251840057347] = TRUE&#10;            AND [Calculation_146789251839336450] = TRUE&#10;            AND LOWER([picking_app]) = &apos;pelican&apos;&#10;            AND [Calculation_3379458992373030916]&#10;            THEN [nr_jobs_updated_product_completed]&#10;            END)&#10;        /&#10;        COUNTD(IF &#10;            [has_confirmed_orders] = TRUE&#10;            AND [has_sftp_jobs] = TRUE&#10;            AND [Calculation_146789251840057347] = TRUE&#10;            AND [Calculation_146789251839336450] = TRUE&#10;            AND LOWER([picking_app]) = &apos;pelican&apos;&#10;            AND [Calculation_3379458992373030916]&#10;            THEN [Chain Name + Id (copy)_146789252132700165]&#10;            END) &#10;        }&#10;    )&#10;END' />
