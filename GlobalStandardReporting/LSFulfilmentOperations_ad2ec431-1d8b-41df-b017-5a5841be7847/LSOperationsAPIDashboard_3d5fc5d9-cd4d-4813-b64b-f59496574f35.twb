    <worksheet name='General Table'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Light' fontsize='14'>API Jobs Score Metrics (&amp; more) </run>
            <run bold='true' fontname='Tableau Bold' fontsize='14'><![CDATA[by Vendor - <[federated.15w313a16lxy7n1dyvkx90hmistu].[none:Local Date  (copy)_3194529904708677634:ok]> (<[federated.15w313a16lxy7n1dyvkx90hmistu].[none:granularity:nk]>)]]></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Main View' name='federated.15w313a16lxy7n1dyvkx90hmistu' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Chain Name without Id (Curated data)' caption='Chain Name' datatype='string' name='[In / Out (copy 2)]' param-domain-type='list' role='measure' type='nominal' value='&quot;1&quot;'>
              <calculation class='tableau' formula='&quot;1&quot;' />
              <aliases>
                <alias key='&quot;1&quot;' value='Chain Name without Id (Curated data)' />
                <alias key='&quot;2&quot;' value='Chain Name with Id (Non-curated data)' />
              </aliases>
            </column>
            <column alias='Any Vendor with API Jobs' caption='API Jobs to See' datatype='string' name='[Parameter 12]' param-domain-type='list' role='measure' type='nominal' value='&quot;1&quot;'>
              <calculation class='tableau' formula='&quot;1&quot;' />
              <aliases>
                <alias key='&quot;1&quot;' value='Any Vendor with API Jobs' />
                <alias key='&quot;2&quot;' value='Any Vendor with API Jobs that Updates Stock' />
                <alias key='&quot;3&quot;' value='Any Vendor with API Jobs that Updates Prices' />
              </aliases>
            </column>
            <column caption='Vendor IDs Filter' datatype='string' name='[Parameter 1]' param-domain-type='any' role='measure' type='nominal' value='&quot;&quot;'>
              <calculation class='tableau' formula='&quot;&quot;' />
            </column>
            <column alias='In' caption='In / Out' datatype='boolean' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
              <aliases>
                <alias key='false' value='Out' />
                <alias key='true' value='In' />
              </aliases>
            </column>
            <column caption='Chain IDs Filter' datatype='string' name='[Vendors List to Filter (copy)_3194529905697562660]' param-domain-type='any' role='measure' type='nominal' value='&quot;&quot;'>
              <calculation class='tableau' formula='&quot;&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.15w313a16lxy7n1dyvkx90hmistu'>
            <column caption='% OOS Failed Orders' datatype='real' default-format='p0.00%' name='[% Partial Fulfilled Items (copy)_1860831095852757033]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([oos_failed_pelican_orders]) / SUM([total_orders])' />
            </column>
            <column caption='% of Unchanged lines in CSV Files' datatype='real' default-format='p0.0%' name='[% of Failed lines in CSV Files (copy)_262686577662119980]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([nr_total_count_completed]) - SUM([nr_failed_count_completed]) - SUM([nr_processed_products_completed])) / SUM([nr_total_count_completed])' />
            </column>
            <column caption='% of Processed lines in CSV Files' datatype='real' default-format='p0.0%' name='[% of Failed lines in CSV Files (copy)_262686577662623789]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([nr_processed_products_completed]) / SUM([nr_total_count_completed])' />
            </column>
            <column caption='% of Failed lines in CSV Files' datatype='real' default-format='p0.0%' name='[% of Stock Jobs that Failed (copy)_1860831095547813925]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([nr_failed_count_completed]) / SUM([nr_total_count_completed])' />
            </column>
            <column caption='Every how many days Vendors update their stock' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;IF [gmv_net_eur] &gt; 0 AND [every_how_many_days_vendors_update_their_stock] &gt; 0 THEN&#10;    [every_how_many_days_vendors_update_their_stock] * [gmv_net_eur]&#10;    ELSE NULL&#10;END&#10;) / &#10;SUM(&#10;IF [gmv_net_eur] &gt; 0 AND [every_how_many_days_vendors_update_their_stock] &gt; 0 THEN&#10;   [gmv_net_eur]&#10;    ELSE NULL&#10;END&#10;)' />
            </column>
            <column caption='Entity or Country' datatype='string' name='[Calculation_115897350132613120]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF {FIXED : COUNTD([entity])} &gt; 1 THEN [entity] ELSE country END' />
            </column>
            <column caption='Local Date ' datatype='string' name='[Calculation_1860831094529859592]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [granularity]&#10;    WHEN &apos;daily&apos; THEN RIGHT(STR(DATE([local_date])),5) + &quot;  &quot; + LEFT(DATENAME(&apos;weekday&apos;, [local_date]), 3)&#10;    WHEN &apos;weekly&apos; THEN RIGHT(STR(DATE(DATETRUNC(&apos;week&apos;,[local_date], &apos;monday&apos;))),8)&#10;    WHEN &apos;monthly&apos; THEN LEFT(RIGHT(STR(DATE(DATETRUNC(&apos;month&apos;,[local_date]))),8), 5)&#10;    WHEN &apos;quarterly&apos; THEN LEFT(RIGHT(STR(DATE(DATETRUNC(&apos;quarter&apos;,[local_date]))),8), 5)&#10;END' />
            </column>
            <column caption='Avg. num. of Updates per Day' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1860831095256268831]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;IF [gmv_net_eur] &gt; 0 AND [avg_number_of_updates_stock_per_day] &gt; 0 THEN&#10;    [avg_number_of_updates_stock_per_day] * [gmv_net_eur]&#10;    ELSE NULL&#10;END&#10;) / &#10;SUM(&#10;IF [gmv_net_eur] &gt; 0 AND [avg_number_of_updates_stock_per_day] &gt; 0 THEN&#10;   [gmv_net_eur]&#10;    ELSE NULL&#10;END&#10;)' />
            </column>
            <column caption='% of Stock Jobs that Failed' datatype='real' default-format='p0.0%' name='[Calculation_1860831095546413092]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([nr_jobs_failed]) / SUM([nr_jobs])' />
            </column>
            <column caption='Ratio # updates items vs total assortment' datatype='real' default-format='p0.0%' name='[Calculation_1860831095615938598]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_stock_items_vs_total_assortment] &gt; 0 THEN&#10;    [ratio_num_updates_stock_items_vs_total_assortment] * [gmv_net_eur]&#10;    ELSE NULL&#10;END&#10;) / &#10;SUM(&#10;IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_stock_items_vs_total_assortment] &gt; 0 THEN&#10;   [gmv_net_eur]&#10;    ELSE NULL&#10;END&#10;)' />
            </column>
            <column caption='% Not Delivered' datatype='real' default-format='p0.00%' name='[Calculation_1860831095894679597]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([confirmed_orders_pelican]) &gt; 0 THEN&#10;SUM(&#10;    ([in_cart_pelican_items] - [in_cart_pelican_items_sold])     &#10;    + [not_found_pelican_items] &#10;    + ([replaced_pelican_items] - [replaced_pelican_items_sold] - [replacements_pelican_items])&#10;    + [oos_failed_pelican_items]&#10;) / &#10;SUM(&#10;    [in_cart_pelican_items]&#10;    + [not_found_pelican_items] &#10;    + [not_processed_pelican_items] &#10;    + [replaced_pelican_items]&#10;    + [replacements_pelican_items]&#10;    + [oos_failed_pelican_items]&#10;)&#10;ELSE NULL END' />
            </column>
            <column caption='SFTP Score Group' datatype='string' name='[Calculation_1860831096295628849]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Score (copy)_3194529904769355787] &lt; 50 THEN &apos;Underperforming&apos; ELSEIF [Score (copy)_3194529904769355787] &gt; 74.99 THEN &apos;Overperforming&apos; ELSE &apos;Neutral&apos; END' />
            </column>
            <column caption='SFTP Jobs to see' datatype='integer' name='[Calculation_262686577636798505]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 12]&#10;WHEN &apos;1&apos; THEN [nr_jobs_completed]&#10;WHEN &apos;2&apos; THEN [nr_jobs_updated_product_completed]&#10;WHEN &apos;3&apos; THEN [nr_jobs_updated_price_completed]&#10;WHEN &apos;4&apos; THEN [nr_jobs_new_product_completed]&#10;END' />
            </column>
            <column caption='Avg. shared assortment from API' datatype='real' default-format='p0%' name='[Calculation_3174545187022356480]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF COUNTD([Calculation_3194529904736956426]) = 1 THEN&#10;(&#10;MAX([nr_total_count_products_max])&#10;)&#10;/ MAX(IF [nr_jobs_completed] &gt; 0 THEN [vendor_assortment_total] ELSE 0 END)&#10;ELSE NULL END' />
            </column>
            <column caption='Vendor Name + id' datatype='string' name='[Calculation_3194529904736956426]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[vendor_id] + &quot; - &quot; +[vendor_name]' />
            </column>
            <column caption='SFTP Type' datatype='string' name='[Calculation_3194529905058963481]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [sftp_type_is_central] THEN &apos;Central SFTP&apos; ELSEIF [sftp_type_is_legacy] THEN &apos;Legacy SFTP&apos; ELSE &apos;Non SFTP&apos; END' />
            </column>
            <column caption='Vendors List to Filter Calc' datatype='boolean' name='[Calculation_3194529905693958179]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] THEN&#10;    IF [Parameters].[Parameter 1] != &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Parameter 1], [vendor_id]) THEN TRUE ELSE FALSE END&#10;        ELSE TRUE&#10;    END&#10;ELSE&#10;    IF [Parameters].[Parameter 1] != &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Parameter 1], [vendor_id]) THEN FALSE ELSE TRUE END&#10;        ELSE TRUE&#10;    END&#10;END' />
            </column>
            <column caption='Chain Name + Country' datatype='string' name='[Calculation_3194529905745088555]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[In / Out (copy 2)]&#10;WHEN &quot;1&quot; THEN [chain_name] + &quot; (&quot; + [country_code] + &quot;)&quot;&#10;ELSE [chain_id] + &quot; - &quot; + [chain_name]&#10;END' />
            </column>
            <column caption='Filter Outliers (cv performance)' datatype='boolean' name='[Filter Outliers (copy)_161707402996469765]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [granularity]&#10;    &#10;    WHEN &apos;daily&apos; THEN&#10;&#10;            IF [confirmed_orders] &gt; 1 THEN&#10;                IF [Calculation_262686577636798505] &lt;= 3  THEN&#10;                    IF [gmv_net_eur] / [Calculation_262686577636798505] &lt; 100 THEN TRUE ELSE FALSE END&#10;                ELSE TRUE END&#10;            ELSE TRUE END&#10;    &#10;        WHEN &apos;weekly&apos; THEN&#10;&#10;        IF [confirmed_orders] &gt; 1 THEN&#10;            IF [nr_jobs_updated_product_completed] &lt;= 3  THEN&#10;                IF [gmv_net_eur] / [nr_jobs_updated_product_completed] &lt; 100 THEN TRUE ELSE FALSE END&#10;            ELSE TRUE END&#10;        ELSE TRUE END&#10;&#10;    WHEN &apos;monthly&apos; THEN&#10;&#10;        IF [confirmed_orders] &gt; 1 THEN&#10;            IF [nr_jobs_updated_product_completed] &lt;= 15  THEN&#10;                IF [gmv_net_eur] / [nr_jobs_updated_product_completed] &lt; 700 THEN TRUE ELSE FALSE END&#10;            ELSE TRUE END&#10;        ELSE TRUE END&#10;&#10;    WHEN &apos;quarterly&apos; THEN&#10;&#10;        IF [confirmed_orders] &gt; 1 THEN&#10;            IF [nr_jobs_updated_product_completed] &lt;= 30  THEN&#10;                IF [gmv_net_eur] / [nr_jobs_updated_product_completed] &lt; 1400 THEN TRUE ELSE FALSE END&#10;            ELSE TRUE END&#10;        ELSE TRUE END&#10;&#10;END' />
            </column>
            <column caption='Has Complete Jobs to Update Stock (cv performance)' datatype='boolean' name='[Has Complete Jobs to Update Stock (copy)_161707402996539398]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [nr_jobs_updated_product_completed] &gt;= 1 THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Local Date  ' datatype='datetime' default-format='*dd/mm/yy' name='[Local Date  (copy)_3194529904708677634]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [granularity]&#10;WHEN &apos;weekly&apos; THEN DATETRUNC(&apos;week&apos;, [local_date], &apos;monday&apos;)&#10;WHEN &apos;monthly&apos; THEN DATETRUNC(&apos;month&apos;, [local_date])&#10;WHEN &apos;quarterly&apos; THEN DATETRUNC(&apos;quarter&apos;, [local_date])&#10;ELSE [local_date]&#10;END' />
            </column>
            <column caption='API Score ' datatype='real' default-format='n#,##0;-#,##0' name='[Score (copy)_3194529904769355787]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [has_sftp_jobs] THEN [sftp_score] * [gmv_net_eur] ELSE NULL END))&#10;/ SUM(IF [has_sftp_jobs] THEN [gmv_net_eur] ELSE NULL END)' />
            </column>
            <column caption='SFTP Score Group (dark)' datatype='string' name='[Score Description (copy)_3194529905026936855]' role='measure' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1860831096295628849]' />
            </column>
            <column caption='Chain List to Filter Calc' datatype='boolean' name='[Vendors List to Filter Calc (copy)_3194529905697677349]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] THEN&#10;    IF [Parameters].[Vendors List to Filter (copy)_3194529905697562660] != &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Vendors List to Filter (copy)_3194529905697562660], [chain_id]) THEN TRUE ELSE FALSE END&#10;        ELSE TRUE&#10;    END&#10;ELSE&#10;    IF [Parameters].[Vendors List to Filter (copy)_3194529905697562660] != &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Vendors List to Filter (copy)_3194529905697562660], [chain_id]) THEN FALSE ELSE TRUE END&#10;        ELSE TRUE&#10;    END&#10;END' />
            </column>
