                </bin>
              </calculation>
            </column>
            <column datatype='string' name='[Local Hour Grouped 1]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[Local Hour (group)]' new-bin='true'>
                <bin default-name='false' value='&quot;00 - 04&quot;'>
                  <value>&quot;0 &amp; 1&quot;</value>
                  <value>&quot;2 &amp; 3&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;04 - 08&quot;'>
                  <value>&quot;4 &amp; 5&quot;</value>
