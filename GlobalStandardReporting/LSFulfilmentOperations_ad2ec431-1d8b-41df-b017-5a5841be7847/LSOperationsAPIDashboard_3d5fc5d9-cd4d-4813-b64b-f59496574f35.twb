          <datasource-dependencies datasource='federated.15w313a16lxy7n1dyvkx90hmistu'>
            <column caption='Filter Outliers (adjusted)' datatype='boolean' name='[Adjust Has Complete Jobs to Update Stock (copy)_153052048043872258]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = &apos;8&apos; THEN &#10;CASE [granularity]&#10;    &#10;    WHEN &apos;daily&apos; THEN&#10;&#10;            IF [confirmed_orders] &gt; 1 THEN&#10;                IF [Calculation_262686577636798505] &lt;= 3  THEN&#10;                    IF [gmv_net_eur] / [Calculation_262686577636798505] &lt; 100 THEN TRUE ELSE FALSE END&#10;                ELSE TRUE END&#10;            ELSE TRUE END&#10;    &#10;        WHEN &apos;weekly&apos; THEN&#10;&#10;        IF [confirmed_orders] &gt; 1 THEN&#10;            IF [Calculation_262686577636798505] &lt;= 3  THEN&#10;                IF [gmv_net_eur] / [Calculation_262686577636798505] &lt; 100 THEN TRUE ELSE FALSE END&#10;            ELSE TRUE END&#10;        ELSE TRUE END&#10;&#10;    WHEN &apos;monthly&apos; THEN&#10;&#10;        IF [confirmed_orders] &gt; 1 THEN&#10;            IF [Calculation_262686577636798505] &lt;= 15  THEN&#10;                IF [gmv_net_eur] / [Calculation_262686577636798505] &lt; 700 THEN TRUE ELSE FALSE END&#10;            ELSE TRUE END&#10;        ELSE TRUE END&#10;&#10;    WHEN &apos;quarterly&apos; THEN&#10;&#10;        IF [confirmed_orders] &gt; 1 THEN&#10;            IF [Calculation_262686577636798505] &lt;= 30  THEN&#10;                IF [gmv_net_eur] / [Calculation_262686577636798505] &lt; 1400 THEN TRUE ELSE FALSE END&#10;            ELSE TRUE END&#10;        ELSE TRUE END&#10;&#10;END&#10;ELSE TRUE&#10;END' />
            </column>
            <column caption='Ratio # updates items vs total assortment (card)' datatype='real' default-format='p0.0%' name='[Avg. num. of Updates per Day (card) (copy)_1278529740258992155]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 12]&#10;&#10;WHEN &quot;1&quot; THEN&#10;&#10;    SUM(&#10;    IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_items_vs_total_assortment] &gt; 0 AND [period_num] = [Parameters].[Parameter 5] THEN&#10;        [ratio_num_updates_items_vs_total_assortment] * [gmv_net_eur]&#10;        ELSE NULL&#10;    END&#10;    ) / &#10;    SUM(&#10;    IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_items_vs_total_assortment] &gt; 0 AND [period_num] = [Parameters].[Parameter 5] THEN&#10;       [gmv_net_eur]&#10;        ELSE NULL&#10;    END&#10;    )&#10;&#10;WHEN &quot;2&quot; THEN&#10;&#10;    SUM(&#10;    IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_stock_items_vs_total_assortment] &gt; 0 AND [period_num] = [Parameters].[Parameter 5] THEN&#10;        [ratio_num_updates_stock_items_vs_total_assortment] * [gmv_net_eur]&#10;        ELSE NULL&#10;    END&#10;    ) / &#10;    SUM(&#10;    IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_stock_items_vs_total_assortment] &gt; 0 AND [period_num] = [Parameters].[Parameter 5] THEN&#10;       [gmv_net_eur]&#10;        ELSE NULL&#10;    END&#10;    )&#10;&#10;WHEN &quot;3&quot; THEN&#10;&#10;    SUM(&#10;    IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_price_items_vs_total_assortment] &gt; 0 AND [period_num] = [Parameters].[Parameter 5] THEN&#10;        [ratio_num_updates_price_items_vs_total_assortment] * [gmv_net_eur]&#10;        ELSE NULL&#10;    END&#10;    ) / &#10;    SUM(&#10;    IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_price_items_vs_total_assortment] &gt; 0 AND [period_num] = [Parameters].[Parameter 5] THEN&#10;       [gmv_net_eur]&#10;        ELSE NULL&#10;    END&#10;    )&#10;&#10;ELSE NULL&#10;&#10;END' />
            </column>
            <column caption='Ratio # updates items vs total assortment - Diff (card)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg. num. of Updates per Day - Diff (card) (copy)_1278529740258992154]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(&#10;    (&#10;        CASE [Parameters].[Parameter 12]&#10;&#10;        WHEN &quot;1&quot; THEN&#10;&#10;            SUM(&#10;            IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_items_vs_total_assortment] &gt; 0 AND [period_num] = [Parameters].[Parameter 5] THEN&#10;                [ratio_num_updates_items_vs_total_assortment] * [gmv_net_eur]&#10;                ELSE NULL&#10;            END&#10;            ) / &#10;            SUM(&#10;            IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_items_vs_total_assortment] &gt; 0 AND [period_num] = [Parameters].[Parameter 5] THEN&#10;               [gmv_net_eur]&#10;                ELSE NULL&#10;            END&#10;            )&#10;&#10;        WHEN &quot;2&quot; THEN&#10;&#10;            SUM(&#10;            IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_stock_items_vs_total_assortment] &gt; 0 AND [period_num] = [Parameters].[Parameter 5] THEN&#10;                [ratio_num_updates_stock_items_vs_total_assortment] * [gmv_net_eur]&#10;                ELSE NULL&#10;            END&#10;            ) / &#10;            SUM(&#10;            IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_stock_items_vs_total_assortment] &gt; 0 AND [period_num] = [Parameters].[Parameter 5] THEN&#10;               [gmv_net_eur]&#10;                ELSE NULL&#10;            END&#10;            )&#10;&#10;        WHEN &quot;3&quot; THEN&#10;&#10;            SUM(&#10;            IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_price_items_vs_total_assortment] &gt; 0 AND [period_num] = [Parameters].[Parameter 5] THEN&#10;                [ratio_num_updates_price_items_vs_total_assortment] * [gmv_net_eur]&#10;                ELSE NULL&#10;            END&#10;            ) / &#10;            SUM(&#10;            IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_price_items_vs_total_assortment] &gt; 0 AND [period_num] = [Parameters].[Parameter 5] THEN&#10;               [gmv_net_eur]&#10;                ELSE NULL&#10;            END&#10;            )&#10;&#10;        ELSE NULL&#10;&#10;        END&#10;    ) / &#10;    (&#10;        CASE [Parameters].[Parameter 12]&#10;&#10;        WHEN &quot;1&quot; THEN&#10;&#10;            SUM(&#10;            IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_items_vs_total_assortment] &gt; 0 AND [period_num] = [Parameters].[Cards Period 1 (copy)_1278529740053532683] THEN&#10;                [ratio_num_updates_items_vs_total_assortment] * [gmv_net_eur]&#10;                ELSE NULL&#10;            END&#10;            ) / &#10;            SUM(&#10;            IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_items_vs_total_assortment] &gt; 0 AND [period_num] = [Parameters].[Cards Period 1 (copy)_1278529740053532683] THEN&#10;               [gmv_net_eur]&#10;                ELSE NULL&#10;            END&#10;            )&#10;&#10;        WHEN &quot;2&quot; THEN&#10;&#10;            SUM(&#10;            IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_stock_items_vs_total_assortment] &gt; 0 AND [period_num] = [Parameters].[Cards Period 1 (copy)_1278529740053532683] THEN&#10;                [ratio_num_updates_stock_items_vs_total_assortment] * [gmv_net_eur]&#10;                ELSE NULL&#10;            END&#10;            ) / &#10;            SUM(&#10;            IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_stock_items_vs_total_assortment] &gt; 0 AND [period_num] = [Parameters].[Cards Period 1 (copy)_1278529740053532683] THEN&#10;               [gmv_net_eur]&#10;                ELSE NULL&#10;            END&#10;            )&#10;&#10;        WHEN &quot;3&quot; THEN&#10;&#10;            SUM(&#10;            IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_price_items_vs_total_assortment] &gt; 0 AND [period_num] = [Parameters].[Cards Period 1 (copy)_1278529740053532683] THEN&#10;                [ratio_num_updates_price_items_vs_total_assortment] * [gmv_net_eur]&#10;                ELSE NULL&#10;            END&#10;            ) / &#10;            SUM(&#10;            IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_price_items_vs_total_assortment] &gt; 0 AND [period_num] = [Parameters].[Cards Period 1 (copy)_1278529740053532683] THEN&#10;               [gmv_net_eur]&#10;                ELSE NULL&#10;            END&#10;            )&#10;&#10;        ELSE NULL&#10;&#10;        END&#10;    )&#10;-1 )' />
            </column>
            <column caption='Ratio # updates items vs total assortment - Diff Icon (card)' datatype='string' default-format='p0.0%' name='[Avg. num. of Updates per Day - Diff Icon (card) (copy)_1278529740258992156]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Avg. num. of Updates per Day - Diff (card) (copy)_1278529740258992154] &gt; 0 THEN &quot;▲&quot; &#10;ELSEIF [Avg. num. of Updates per Day - Diff (card) (copy)_1278529740258992154] &lt; 0 THEN &quot;▼&quot; &#10;ELSE &quot;●&quot;&#10;END' />
            </column>
            <column caption='&quot;7&quot;' datatype='string' name='[Calculation_1278529740992716861]' role='dimension' type='nominal' user:unnamed='Score - Ratio Updates'>
              <calculation class='tableau' formula='&quot;7&quot;' />
            </column>
            <column caption='Filter Outliers (card)' datatype='boolean' name='[Calculation_1278529741041209407]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = &apos;8&apos; THEN TRUE ELSE&#10;&#10;    CASE [granularity]&#10;    &#10;        WHEN &apos;daily&apos; THEN&#10;&#10;            IF [confirmed_orders] &gt; 1 THEN&#10;                IF [Calculation_262686577636798505] &lt;= 3  THEN&#10;                    IF [gmv_net_eur] / [Calculation_262686577636798505] &lt; 100 THEN TRUE ELSE FALSE END&#10;                ELSE TRUE END&#10;            ELSE TRUE END&#10;    &#10;        WHEN &apos;weekly&apos; THEN&#10;&#10;            IF [confirmed_orders] &gt; 1 THEN&#10;                IF [Calculation_262686577636798505] &lt;= 3  THEN&#10;                    IF [gmv_net_eur] / [Calculation_262686577636798505] &lt; 100 THEN TRUE ELSE FALSE END&#10;                ELSE TRUE END&#10;            ELSE TRUE END&#10;&#10;        WHEN &apos;monthly&apos; THEN&#10;&#10;            IF [confirmed_orders] &gt; 1 THEN&#10;                IF [Calculation_262686577636798505] &lt;= 15  THEN&#10;                    IF [gmv_net_eur] / [Calculation_262686577636798505] &lt; 700 THEN TRUE ELSE FALSE END&#10;                ELSE TRUE END&#10;            ELSE TRUE END&#10;&#10;        WHEN &apos;quarterly&apos; THEN&#10;&#10;            IF [confirmed_orders] &gt; 1 THEN&#10;                IF [Calculation_262686577636798505] &lt;= 30  THEN&#10;                    IF [gmv_net_eur] / [Calculation_262686577636798505] &lt; 1400 THEN TRUE ELSE FALSE END&#10;                ELSE TRUE END&#10;            ELSE TRUE END&#10;&#10;    END&#10;END' />
            </column>
            <column caption='Has Complete Jobs to Update Stock (adjusted)' datatype='boolean' name='[Calculation_153052048041078785]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = &apos;8&apos; THEN &#10;    IF [Calculation_262686577636798505] &gt;= 1 THEN TRUE ELSE&#10;    IF [Parameters].[Deep Dive Metric (copy)] = TRUE THEN TRUE ELSE FALSE END END&#10;ELSE TRUE&#10;END' />
            </column>
            <column caption='SFTP Jobs to see' datatype='integer' name='[Calculation_262686577636798505]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 12]&#10;WHEN &apos;1&apos; THEN [nr_jobs_completed]&#10;WHEN &apos;2&apos; THEN [nr_jobs_updated_product_completed]&#10;WHEN &apos;3&apos; THEN [nr_jobs_updated_price_completed]&#10;WHEN &apos;4&apos; THEN [nr_jobs_new_product_completed]&#10;END' />
            </column>
            <column caption='Vendor Name + id' datatype='string' name='[Calculation_3194529904736956426]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[vendor_id] + &quot; - &quot; +[vendor_name]' />
            </column>
            <column caption='Has Complete Jobs to Update Stock (card)' datatype='boolean' name='[Calculation_3194529905047035928]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = &apos;8&apos; THEN TRUE &#10;ELSEIF [Calculation_262686577636798505] &gt;= 1 THEN TRUE &#10;ELSEIF [Parameters].[Deep Dive Metric (copy)] = TRUE THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='SFTP Type' datatype='string' name='[Calculation_3194529905058963481]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [sftp_type_is_central] THEN &apos;Central SFTP&apos; ELSEIF [sftp_type_is_legacy] THEN &apos;Legacy SFTP&apos; ELSE &apos;Non SFTP&apos; END' />
            </column>
            <column caption='Vendors List to Filter Calc' datatype='boolean' name='[Calculation_3194529905693958179]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] THEN&#10;    IF [Parameters].[Parameter 1] != &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Parameter 1], [vendor_id]) THEN TRUE ELSE FALSE END&#10;        ELSE TRUE&#10;    END&#10;ELSE&#10;    IF [Parameters].[Parameter 1] != &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Parameter 1], [vendor_id]) THEN FALSE ELSE TRUE END&#10;        ELSE TRUE&#10;    END&#10;END' />
            </column>
            <column caption='Chain Name + Country' datatype='string' name='[Calculation_3194529905745088555]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[In / Out (copy 2)]&#10;WHEN &quot;1&quot; THEN [chain_name] + &quot; (&quot; + [country_code] + &quot;)&quot;&#10;ELSE [chain_id] + &quot; - &quot; + [chain_name]&#10;END' />
            </column>
            <column caption='Chain List to Filter Calc' datatype='boolean' name='[Vendors List to Filter Calc (copy)_3194529905697677349]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] THEN&#10;    IF [Parameters].[Vendors List to Filter (copy)_3194529905697562660] != &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Vendors List to Filter (copy)_3194529905697562660], [chain_id]) THEN TRUE ELSE FALSE END&#10;        ELSE TRUE&#10;    END&#10;ELSE&#10;    IF [Parameters].[Vendors List to Filter (copy)_3194529905697562660] != &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Vendors List to Filter (copy)_3194529905697562660], [chain_id]) THEN FALSE ELSE TRUE END&#10;        ELSE TRUE&#10;    END&#10;END' />
            </column>
            <column aggregation='Sum' datatype='integer' name='[both_sftp_api_jobs_flag]' role='dimension' type='ordinal'>
              <aliases>
