              <calculation class='tableau' formula='(&#10;    SUM(&#10;        ([in_cart_pelican_items] - [in_cart_pelican_items_sold])&#10;    )&#10;    /&#10;    SUM(&#10;        [in_cart_pelican_items]&#10;        + [not_found_pelican_items]&#10;        + [not_processed_pelican_items]&#10;        + [replaced_pelican_items]&#10;        + [oos_failed_pelican_items]&#10;    )&#10;)' />
            </column>
            <column caption='% ND due to Not Found' datatype='real' default-format='p0.0%' name='[% Not Delivered (copy)_1537979325925945349]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    SUM(&#10;        [not_found_pelican_items]&#10;    )&#10;    /&#10;    SUM(&#10;        [in_cart_pelican_items]&#10;        + [not_found_pelican_items]&#10;        + [not_processed_pelican_items]&#10;        + [replaced_pelican_items]&#10;        + [oos_failed_pelican_items]&#10;    )&#10;)' />
            </column>
            <column caption='% ND due to OOS Failed Items' datatype='real' default-format='p0.0%' name='[% Not Delivered (copy)_1537979325926338566]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    SUM(&#10;        [oos_failed_pelican_items]&#10;    )&#10;    /&#10;    SUM(&#10;        [in_cart_pelican_items]&#10;        + [not_found_pelican_items]&#10;        + [not_processed_pelican_items]&#10;        + [replaced_pelican_items]&#10;        + [oos_failed_pelican_items]&#10;    )&#10;)' />
            </column>
            <column caption='Chain List to Filter Calc' datatype='boolean' name='[Calculation_146789251835453440]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] THEN&#10;    IF [Parameters].[Vendors List to Filter (copy)_3194529905697562660] != &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Vendors List to Filter (copy)_3194529905697562660], [chain_id]) THEN TRUE ELSE FALSE END&#10;        ELSE TRUE&#10;    END&#10;ELSE&#10;    IF [Parameters].[Vendors List to Filter (copy)_3194529905697562660] != &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Vendors List to Filter (copy)_3194529905697562660], [chain_id]) THEN FALSE ELSE TRUE END&#10;        ELSE TRUE&#10;    END&#10;END' />
            </column>
            <column caption='Vendors List to Filter Calc' datatype='boolean' name='[Calculation_146789251835617281]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] THEN&#10;    IF [Parameters].[Parameter 1] != &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Parameter 1], [vendor_id]) THEN TRUE ELSE FALSE END&#10;        ELSE TRUE&#10;    END&#10;ELSE&#10;    IF [Parameters].[Parameter 1] != &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Parameter 1], [vendor_id]) THEN FALSE ELSE TRUE END&#10;        ELSE TRUE&#10;    END&#10;END' />
            </column>
            <column caption='Filter Outliers' datatype='boolean' name='[Calculation_146789251839336450]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [granularity]&#10;    &#10;        WHEN &apos;daily&apos; THEN&#10;&#10;            IF [confirmed_orders] &gt; 1 THEN&#10;                IF [nr_jobs_updated_product_completed] &lt;= 3  THEN&#10;                    IF [gmv_net_eur] / [nr_jobs_updated_product_completed] &lt; 100 THEN TRUE ELSE FALSE END&#10;                ELSE TRUE END&#10;            ELSE TRUE END&#10;&#10;    WHEN &apos;weekly&apos; THEN&#10;&#10;        IF [confirmed_orders] &gt; 1 THEN&#10;            IF [nr_jobs_updated_product_completed] &lt;= 3  THEN&#10;                IF [gmv_net_eur] / [nr_jobs_updated_product_completed] &lt; 100 THEN TRUE ELSE FALSE END&#10;            ELSE TRUE END&#10;        ELSE TRUE END&#10;&#10;    WHEN &apos;monthly&apos; THEN&#10;&#10;        IF [confirmed_orders] &gt; 1 THEN&#10;            IF [nr_jobs_updated_product_completed] &lt;= 15  THEN&#10;                IF [gmv_net_eur] / [nr_jobs_updated_product_completed] &lt; 700 THEN TRUE ELSE FALSE END&#10;            ELSE TRUE END&#10;        ELSE TRUE END&#10;&#10;    WHEN &apos;quarterly&apos; THEN&#10;&#10;        IF [confirmed_orders] &gt; 1 THEN&#10;            IF [nr_jobs_updated_product_completed] &lt;= 30  THEN&#10;                IF [gmv_net_eur] / [nr_jobs_updated_product_completed] &lt; 1400 THEN TRUE ELSE FALSE END&#10;            ELSE TRUE END&#10;        ELSE TRUE END&#10;&#10;END' />
            </column>
            <column caption='Has SFTP Stock Job' datatype='boolean' name='[Calculation_146789251840057347]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [nr_jobs_updated_product_completed] &gt;= 1 THEN TRUE &#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='Chain Name + Country' datatype='string' name='[Calculation_146789252127698948]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[In / Out (copy 2)]&#10;WHEN &quot;1&quot; THEN [chain_name] + &quot; (&quot; + [country_code] + &quot;)&quot;&#10;ELSE [chain_id] + &quot; - &quot; + [chain_name]&#10;END' />
            </column>
            <column caption='Filter Vendors' datatype='boolean' name='[Calculation_146789252137971720]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Selected Chain (copy)_146789252136169479] = &quot;&quot; THEN TRUE ELSE&#10;IF [Chain Name + Id (copy)_146789252132700165] = [Parameters].[Selected Chain (copy)_146789252136169479] THEN TRUE ELSE FALSE END&#10;END' />
            </column>
            <column caption='# SFTP Stock Jobs per Order' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_146789252162138121]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([nr_jobs_updated_product_completed]) / SUM([confirmed_orders])' />
