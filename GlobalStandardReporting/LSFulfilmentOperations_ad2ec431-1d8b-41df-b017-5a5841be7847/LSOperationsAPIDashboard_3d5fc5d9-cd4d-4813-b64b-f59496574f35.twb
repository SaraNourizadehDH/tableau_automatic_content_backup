        <calculation class='tableau' formula='ZN(&#10;    (&#10;        CASE [Parameters].[Parameter 12]&#10;&#10;        WHEN &quot;1&quot; THEN&#10;&#10;            SUM(&#10;            IF [gmv_net_eur] &gt; 0 AND [avg_number_of_updates_per_day] &gt; 0 AND [period_num] = [Parameters].[Parameter 5] THEN&#10;                [avg_number_of_updates_per_day] * [gmv_net_eur]&#10;                ELSE NULL&#10;            END&#10;            ) / &#10;            SUM(&#10;            IF [gmv_net_eur] &gt; 0 AND [avg_number_of_updates_per_day] &gt; 0 AND [period_num] = [Parameters].[Parameter 5] THEN&#10;               [gmv_net_eur]&#10;                ELSE NULL&#10;            END&#10;            )&#10;&#10;        WHEN &quot;2&quot; THEN&#10;&#10;            SUM(&#10;            IF [gmv_net_eur] &gt; 0 AND [avg_number_of_updates_stock_per_day] &gt; 0 AND [period_num] = [Parameters].[Parameter 5] THEN&#10;                [avg_number_of_updates_stock_per_day] * [gmv_net_eur]&#10;                ELSE NULL&#10;            END&#10;            ) / &#10;            SUM(&#10;            IF [gmv_net_eur] &gt; 0 AND [avg_number_of_updates_stock_per_day] &gt; 0 AND [period_num] = [Parameters].[Parameter 5] THEN&#10;               [gmv_net_eur]&#10;                ELSE NULL&#10;            END&#10;            )&#10;&#10;        WHEN &quot;3&quot; THEN&#10;&#10;            SUM(&#10;            IF [gmv_net_eur] &gt; 0 AND [avg_number_of_updates_price_per_day] &gt; 0 AND [period_num] = [Parameters].[Parameter 5] THEN&#10;                [avg_number_of_updates_price_per_day] * [gmv_net_eur]&#10;                ELSE NULL&#10;            END&#10;            ) / &#10;            SUM(&#10;            IF [gmv_net_eur] &gt; 0 AND [avg_number_of_updates_price_per_day] &gt; 0 AND [period_num] = [Parameters].[Parameter 5] THEN&#10;               [gmv_net_eur]&#10;                ELSE NULL&#10;            END&#10;            )&#10;&#10;        ELSE NULL&#10;&#10;        END&#10;    ) / &#10;      