                <zone h='2500' id='2825' mode='checkdropdown' name='Score by Chain' param='[federated.15w313a16lxy7n1dyvkx90hmistu].[none:Calculation_3194529905745088555:nk]' show-apply='true' type-v2='filter' values='relevant' w='6618' x='59926' y='6250'>
