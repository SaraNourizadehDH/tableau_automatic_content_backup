            <button-visual-state>
              <image-path>Image/360_F_322639135_8stIcJcX4X84m56tV5wNnDmhFd6ZIYRG.jpeg</image-path>
              <tooltip-text>Click here if you have any questions related to this chart</tooltip-text>
            </button-visual-state>
            <button-visual-state>
              <image-path>Image/360_F_322639135_8stIcJcX4X84m56tV5wNnDmhFd6ZIYRG.jpeg</image-path>
