                <zone custom-title='true' h='2280' id='2524' mode='compact' param='[Parameters].[Parameter 12]' type-v2='paramctrl' w='24191' x='809' y='22320'>
                  <formatted-text>
                    <run bold='true' fontalignment='0'>API Jobs to See </run>
                    <run bold='true' fontalignment='0' fontcolor='#e15759' fontname='Tableau Book'>Æ </run>
                    <run bold='true' fontalignment='0' fontcolor='#e15759' fontname='Tableau Book' fontsize='8'>(important filter)</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone custom-title='true' h='2280' id='2670' mode='compact' param='[Parameters].[Deep Dive Metric (copy)]' type-v2='paramctrl' w='24191' x='809' y='26880'>
                  <formatted-text>
                    <run bold='true' fontalignment='0'>Show Vendors without API Jobs</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='8360' id='2675' type-v2='text' w='48824' x='8824' y='29080'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontsize='10'>The filter operates as follows:</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#000000' fontsize='10'><![CDATA[Daily / Weekly: any vendor with 0 Confirmed Orders, fewer than 3 SFTP Jobs, and a GMV / SFTP Jobs ratio not < 100 will be filtered out. This is to prevent a vendor with excessive GMV and very few SFTP Jobs from skewing the average.]]></run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#000000' fontsize='10'><![CDATA[Monthly: any vendor with 0 Confirmed Orders, fewer than 15 SFTP Jobs, and a GMV / SFTP Jobs ratio not < 700 will be filtered.]]></run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#000000' fontsize='10'><![CDATA[Quarterly: any vendor with 0 Confirmed Orders, fewer than 30 SFTP Jobs, and a GMV / SFTP Jobs ratio not < 1400 will be filtered out.]]></run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#ffffff' />
                  </zone-style>
                </zone>
                <zone custom-title='true' fixed-size='51' h='2280' id='811' mode='type_in' param='[Parameters].[Replaced Pelican Items Parameter]' type-v2='paramctrl' w='12132' x='809' y='31440'>
