              <calculation class='tableau' formula='&quot;Brand&quot;' />
              <aliases>
                <alias key='&quot;All&quot;' value='All' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0f17j4b1sl9xab1em78d60mnfp3i'>
            <column caption='Is Current Month Full' datatype='boolean' name='[Calculation_5061131210837270528]' role='dimension' type='nominal'>
