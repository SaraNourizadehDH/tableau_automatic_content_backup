      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0f17j4b1sl9xab1em78d60mnfp3i]&quot;' value='Vendors' />
        </aliases>
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_4632796670011654144]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]=USERNAME()' />
      </column>
      <column caption='Is Current Month Full' datatype='boolean' name='[Calculation_5061131210837270528]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF(DAY(TODAY())&lt;=28, False, True)' />
      </column>
      <column caption='Last Date Flag - Month' datatype='boolean' name='[Calculation_5061131210837737473]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [created_date], TODAY(), &apos;Monday&apos;) = IIF([Calculation_5061131210837270528], 0, 1)' />
      </column>
      <column caption='Group' datatype='string' name='[Calculation_5466666317189828609]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([Parameters].[Group By (copy)_5466666317189656576]=&apos;All&apos;, &apos;&apos;, [country_name])' />
      </column>
      <column caption='Metric - Article Opened' datatype='real' name='[Calculation_5534009172379136000]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([action_type]=&apos;article_display&apos;,[metric_value], 0))' />
      </column>
      <column caption='Last Date Of Month' datatype='date' datatype-customized='true' name='[Calculation_5534009172382240778]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATEADD(&apos;day&apos;,-1,(DATEADD(&apos;month&apos;,1,DATETRUNC(&apos;month&apos;,[created_date])))))' />
      </column>
      <column caption='Dimension ' datatype='string' name='[Calculation_5534009172383707147]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[metric_value Parameter]&#10;WHEN &apos;Brand&apos; then [brand_name]&#10;WHEN &apos;Country&apos; then [country_name]&#10;WHEN &apos;All&apos; then &apos;All&apos;&#10;END' />
      </column>
      <column caption='Contend Name and ID is null' datatype='boolean' name='[Calculation_791578024477609984]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='ISNULL([content_id]) AND ISNULL([content_name])' />
      </column>
      <column caption='Metric - Plugin Opened' datatype='real' name='[Metric - Article Opened (copy)_5534009172379623425]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([action_type]=&apos;plugin_usage&apos;,[metric_value], 0))' />
      </column>
      <column caption='Vendors (copy)' datatype='real' name='[Vendors (copy)_5061131210841825284]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[metric_value]' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='growth_vendor_university_dashboard' datatype='table' name='[__tableau_internal_object_id__].[growth_vendor_university_dashboard_885DD5E063354CD8B1EC276CD02E3BA6]' role='measure' type='quantitative' />
      <column caption='Access Group' datatype='string' name='[access_group]' role='dimension' type='nominal' />
      <column caption='Action Type' datatype='string' name='[action_type]' role='dimension' type='nominal'>
        <aliases>
          <alias key='%null%' value='Plugin Display' />
          <alias key='&quot;article_display&quot;' value='Article Showed' />
          <alias key='&quot;category_click&quot;' value='Category Clicked' />
          <alias key='&quot;plugin_usage&quot;' value='Plugin Opened' />
          <alias key='&quot;search_used&quot;' value='Search Used' />
        </aliases>
      </column>
      <column caption='Brand Name' datatype='string' name='[brand_name]' role='dimension' type='nominal' />
      <column caption='Client Name' datatype='string' name='[client_name]' role='dimension' type='nominal' />
      <column caption='Content Id' datatype='string' name='[content_id]' role='dimension' type='nominal' />
