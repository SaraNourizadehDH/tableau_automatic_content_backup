    <worksheet name='Bayesian Mean (line)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='10'>Bayesian Mean Over Time</run>
            <run fontalignment='1'>Æ&#10;</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontsize='8'>The chart above tracks </run>
            <run bold='true' fontsize='8'>variants&apos; Bayesian Means and confidence intervals</run>
            <run fontsize='8'>, which refine with data accumulation. Variants are </run>
            <run bold='true' fontsize='8'>dropped</run>
            <run fontsize='8'> if, for three consecutive days, the difference between their overlapping confidence intervals fall below the statistical significance threshold. </run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='mab_results' name='federated.0o0p4c21kx9b7415g30f615h6tmg' />
            <datasource caption='Setup Configuration' name='federated.0kzzi8u1ktlbrx1dvn03f02xlfyu' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Start date' datatype='date' name='[Parameter 3]' param-domain-type='any' role='measure' type='quantitative' value='#2025-05-23#'>
              <calculation class='tableau' formula='#2025-05-23#' />
            </column>
            <column caption='End Date' datatype='date' name='[Parameter 4]' param-domain-type='any' role='measure' type='quantitative' value='#2025-05-23#'>
              <calculation class='tableau' formula='#2025-05-23#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0kzzi8u1ktlbrx1dvn03f02xlfyu'>
            <column caption='Global Calendar' datatype='boolean' name='[Calculation_275423277639495709]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] &gt;= {FIXED [entity_id], [test_name]: MIN([first_date])}&#10;AND&#10;[Parameters].[Parameter 4] &lt;= {FIXED [entity_id], [test_name]: MAX([last_date])} THEN TRUE&#10;ELSE FALSE END' />
            </column>
            <column datatype='string' name='[entity_id]' role='dimension' type='nominal' />
            <column datatype='date' name='[first_date]' role='dimension' type='ordinal' />
            <column datatype='date' name='[last_date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_275423277639495709]' derivation='None' name='[none:Calculation_275423277639495709:nk]' pivot='key' type='nominal' />
            <column datatype='string' name='[test_name]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0o0p4c21kx9b7415g30f615h6tmg'>
            <column caption='hdi_band' datatype='real' name='[Calculation_2170735027759853589]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [kpi] = [target_kpi] THEN [hdi_upper_bound] - [hdi_lower_bound] END' />
            </column>
            <column caption='calculated_upper_bound' datatype='real' name='[Calculation_2170735027763781661]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if[kpi] = [target_kpi] then [hdi_lower_bound] END' />
            </column>
            <column caption='calculated_lower_bound' datatype='real' name='[Calculation_2170735027763896350]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [kpi] = [target_kpi] THEN [hdi_lower_bound] END' />
            </column>
            <column caption='if [kpi]=[target_kpi] THEN [bayesian_mean] END' datatype='real' name='[Calculation_3419358024093061131]' role='measure' type='quantitative' user:unnamed='Bayesian Mean'>
              <calculation class='tableau' formula='if [kpi]=[target_kpi] THEN [bayesian_mean] END' />
