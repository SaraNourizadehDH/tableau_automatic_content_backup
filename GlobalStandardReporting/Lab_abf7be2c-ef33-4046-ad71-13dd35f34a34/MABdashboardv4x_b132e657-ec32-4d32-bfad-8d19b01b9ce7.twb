      <aliases enabled='yes' />
      <column caption='hdi_band' datatype='real' name='[Calculation_2170735027759853589]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [kpi] = [target_kpi] THEN [hdi_upper_bound] - [hdi_lower_bound] END' />
      </column>
      <column caption='calculated_upper_bound' datatype='real' name='[Calculation_2170735027763781661]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if[kpi] = [target_kpi] then [hdi_lower_bound] END' />
      </column>
      <column caption='calculated_lower_bound' datatype='real' name='[Calculation_2170735027763896350]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [kpi] = [target_kpi] THEN [hdi_lower_bound] END' />
      </column>
      <column caption='variant_min_date' datatype='date' name='[Calculation_275423277028343829]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED [entity_id], [test_name], [variant_name] : MIN([created_date])}' />
      </column>
      <column caption='variant_max_date' datatype='date' name='[Calculation_275423277028487190]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED [entity_id], [test_name], [variant_name] : MAX([created_date])}' />
      </column>
      <column caption='variant_dead/alive' datatype='string' name='[Calculation_275423277028560919]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF&#10;    MIN([Calculation_275423277028343829]) &lt;= MAX([created_date])&#10;    AND MIN([Calculation_275423277028487190]) &gt;= MIN([created_date])&#10;THEN &quot;Alive&quot;&#10;ELSE &quot;Dead&quot;&#10;END' />
      </column>
