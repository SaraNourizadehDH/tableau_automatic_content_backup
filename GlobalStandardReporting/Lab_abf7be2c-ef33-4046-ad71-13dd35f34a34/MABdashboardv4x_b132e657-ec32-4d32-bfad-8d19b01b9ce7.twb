          <relation connection='bigquery.08336el06pyp4d14fxi3s1y2ueio' name='Custom SQL Query' type='text'><![CDATA[--Updated
--On 22/05/2025
--Change query back to `log-data-science-production.pricing_multi_armed_bandit.mab_dps_payload` after getting access back


--Updated Query from:
--MAB_dashboard_Roni
--On 15/05/2025


WITH parse AS( --Get 'winning_probability' and 'target_kpi'
SELECT 
      country_code
      ,  created_at
       , created_date
       , analysed_date
       , entity_id
       , test_name
       , test_id
       , JSON_VALUE(dps_payload, '$.target_kpi') AS target_kpi
       , JSON_VALUE(kpi, '$.name') AS kpi
       , JSON_VALUE(variant, '$.variant_name') AS variant_name
       , JSON_VALUE(variant, '$.winning_probability') AS winning_probability

  FROM `log-data-science-production.pricing_multi_armed_bandit.mab_dps_payload`,
  UNNEST(CAST(JSON_QUERY_ARRAY(dps_payload, '$.kpis') AS ARRAY<<STRING>>)) AS kpi,
  UNNEST(CAST(JSON_QUERY_ARRAY(kpi, '$.winning_variant_probabilities') AS ARRAY<<STRING>>)) AS variant
),

dps_exp AS( --get 'share'
SELECT
          A.name test_name
        , A.id
        , A.country_code
        , date(max(updated_at)) created_date
        , JSON_EXTRACT_SCALAR(variant_share, '$.variant') variant
        , CAST(JSON_EXTRACT_SCALAR(variant_share, '$.share') as numeric) share

FROM `fulfillment-dwh-production.hl.dynamic_pricing_experiment` A, 
 UNNEST(JSON_EXTRACT_ARRAY(shares, '$.variant_shares')) AS variant_share
WHERE LOWER(experiment_type)="ab_mab"
AND created_at>>='2023-01-01'
AND (active OR already_executed) --already_executed = TRUE
GROUP BY ALL
),

base AS(
  SELECT 
         -- From 'ds_pricing_multi_armed_bandit_mab_bayesian_updating_results'
         p.country_code
        , bay.created_date
        , bay.created_at
        , MAX(bay.analysed_date) AS analysed_date
        , bay.entity_id
        , bay.test_id
        , bay.test_name
        , MAX(bay.version) AS version
        , bay.target_kpi AS kpi
        , AVG(bay.p_var_greater_all) AS winning_probability
        , bay.variant AS variant_name
        , AVG(bayesian_mean) AS bayesian_mean
        , AVG(lower_quartile) AS lower_quartile
        , AVG(upper_quartile) AS upper_quartile
        , AVG(bay.hdi_lower_bound) AS hdi_lower_bound
        , AVG(bay.hdi_upper_bound) AS hdi_upper_bound

        -- From 'pricing_multi_armed_bandit.mab_dps_payload'
       , MAX(p.target_kpi) AS target_kpi
       
       --From `fulfillment-dwh-production.hl.dynamic_pricing_experiment`
       , AVG(share) AS share

FROM `fulfillment-dwh-production.dl.ds_pricing_multi_armed_bandit_mab_bayesian_updating_results` bay
  LEFT JOIN parse p
  ON   p.entity_id = bay.entity_id
      AND p.created_date = bay.created_date
      AND p.test_name = bay.test_name
      AND p.test_id = bay.test_id
      AND p.kpi = bay.target_kpi
      AND p.variant_name = bay.variant
  
  LEFT JOIN dps_exp dps
  ON  dps.country_code = bay.country_code
      AND dps.test_name = bay.test_name
      AND dps.id = bay.test_id
      AND dps.created_date = bay.created_date
      AND dps.variant = bay.variant

WHERE bay.test_name IN(
	SELECT test_name
	FROM dps_exp
)

GROUP BY ALL
),

base2 AS(
SELECT 
  created_date
, created_at
, analysed_date
, country_code
, entity_id
, test_id
, test_name
, version
, kpi
, winning_probability
, variant_name
, bayesian_mean
, hdi_lower_bound
, hdi_upper_bound
, lower_quartile
, upper_quartile
, target_kpi
, COALESCE(share, LAST_VALUE(share IGNORE NULLS) OVER(PARTITION BY entity_id, test_name, kpi, variant_name ORDER BY created_date ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)) AS share

FROM base
)


-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

-- Generate dates and value for 3 days before each test starts
, enriched_data AS(
    SELECT 
        created_date,
        created_at,
        country_code,
        entity_id,
        test_name,
        test_id,
        version,
        target_kpi,
        kpi,
        variant_name,
        share,
        hdi_lower_bound,
        hdi_upper_bound,
        FIRST_VALUE(created_date) OVER (PARTITION BY entity_id, test_name, kpi ORDER BY created_date ASC) AS first_created_date,
        COUNT(DISTINCT variant_name) OVER (PARTITION BY entity_id, test_name, kpi, created_date) AS variant_count,
    FROM base
)


, FirstTestDates AS (
    SELECT
        entity_id
        , test_name
        , kpi
        , MIN(created_date) AS first_created_date
    FROM
        enriched_data
    GROUP BY
        entity_id
        , test_name
        , kpi
)


, processed_data1 AS(
SELECT 
    DATE_SUB(ed.first_created_date, INTERVAL 1 DAY) AS created_date,  -- Shift date back
    MAX(created_at) AS created_at,
    DATE_SUB(ed.first_created_date, INTERVAL 3 DAY) AS analysed_date,
    ed.country_code,
    ed.entity_id,
    MIN(ed.test_id) AS test_id,
    ed.test_name,
    MIN(version) AS version,
    ed.kpi,
    1.0 / variant_count AS winning_probability,  -- Compute new Bayesian mean
    variant_name,
    NULL AS bayesian_mean,
    NULL AS hdi_lower_bound,
    NULL AS hdi_upper_bound,
    NULL AS lower_quartile,
    NULL AS upper_quartile,
    ANY_VALUE(target_kpi) AS target_kpi,
    NULL AS share,
    --NULL AS uplift_percentage

FROM enriched_data ed
    INNER JOIN FirstTestDates ftd ON ed.entity_id = ftd.entity_id
                                       AND ed.test_name = ftd.test_name
                                       AND ed.created_date = ftd.first_created_date
                                       AND ed.kpi = ftd.kpi
GROUP BY ed.entity_id, ed.test_name, ed.kpi, variant_name, ed.first_created_date, variant_count, country_code
),

processed_data2 AS(
SELECT 
    DATE_SUB(ed.first_created_date, INTERVAL 2 DAY) AS created_date,  -- Shift date back
    MAX(ed.created_at) AS created_at,
    DATE_SUB(ed.first_created_date, INTERVAL 4 DAY) AS analysed_date,
    ed.country_code,
    ed.entity_id,
    MIN(ed.test_id) AS test_id,
    ed.test_name,
    MIN(version) AS version,
    ed.kpi,
    1.0 / variant_count AS winning_probability,  -- Compute new Bayesian mean
    variant_name,
    NULL AS bayesian_mean,
    NULL AS hdi_lower_bound,
    NULL AS hdi_upper_bound,
    NULL AS lower_quartile,
    NULL AS upper_quartile,
    ANY_VALUE(target_kpi) AS target_kpi,
    NULL AS share,
    --NULL AS uplift_percentage

FROM enriched_data ed
    INNER JOIN FirstTestDates ftd ON ed.entity_id = ftd.entity_id
                                       AND ed.test_name = ftd.test_name
                                       AND ed.created_date = ftd.first_created_date
                                       AND ed.kpi = ftd.kpi
GROUP BY ed.entity_id, ed.test_name, ed.kpi, ed.variant_name, ed.first_created_date, variant_count, country_code
),

processed_data3 AS(
SELECT 
    DATE_SUB(ed.first_created_date, INTERVAL 3 DAY) AS created_date,  -- Shift date back
    MAX(ed.created_at) AS created_at,
    DATE_SUB(ed.first_created_date, INTERVAL 5 DAY) AS analysed_date,
    ed.country_code,
    ed.entity_id,
    MIN(ed.test_id) AS test_id,
    ed.test_name,
    MIN(ed.version) AS version,
    ed.kpi,
    1.0 / variant_count AS winning_probability,  -- Compute new Bayesian mean
    variant_name,
    NULL AS bayesian_mean,
    NULL AS hdi_lower_bound,
    NULL AS hdi_upper_bound,
    NULL AS lower_quartile,
    NULL AS upper_quartile,
    ANY_VALUE(target_kpi) AS target_kpi,
    NULL AS share,
    --NULL AS uplift_percentage

FROM enriched_data ed
    INNER JOIN FirstTestDates ftd ON ed.entity_id = ftd.entity_id
                                       AND ed.test_name = ftd.test_name
                                       AND ed.created_date = ftd.first_created_date
                                       AND ed.kpi = ftd.kpi
GROUP BY ed.entity_id, ed.test_name, ed.kpi, ed.variant_name, ed.first_created_date, variant_count, country_code
)


, union_tabs AS(
-- Adding the generated date tables to the base table
SELECT *
FROM base2

UNION ALL
SELECT * FROM processed_data1
UNION ALL
SELECT * FROM processed_data2
UNION ALL
SELECT * FROM processed_data3
)


-- EXPERIMENT SETUP - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -


-- How to recuperate component's details for partial experiments? -->> example: TW_20250313_Z_K0_O_MAB_Priority
-- , base_config_setup AS(
-- SELECT  
-- entity_id
-- , test_id
-- , test_name
-- , test_start_date
-- , test_end_date
-- , variation_group AS variant
-- , scheme_component_ids.priority_fee_config_id
-- , scheme_component_ids.travel_time_config_id
-- FROM `fulfillment-dwh-production.cl.dps_experiment_setups`
-- WHERE experiment_type = 'AB_MAB'
-- UNION ALL
-- SELECT  entity_id
--         , test_id
--         , test_name
--         , TIMESTAMP(created_at) AS test_start_date --closest value, but not ideal if test starts at <<>> date/time than its creation / execution_date is of date type, so not precise enough in some cases
--         , NULL AS test_end_date --no data point on this
--         , name AS variant
--         , NULL AS priority_fee_config_id -- no data on this, hence how to join to pricing_component_configuration_versions_priority_fee?
--         , NULL AS travel_time_config_id --possibly use travel_time_fees or travel_time_thresholds?
-- FROM `logistics-data-storage-staging.pricing_multi_armed_bandit.mab_new_variant`
-- )

-- , base_config_setup2 AS(
-- SELECT expe.*
--       , conf.config.percentage_fee
--       , conf.config.min_fee
--       , conf.config.max_fee
-- FROM base_config_setup expe
-- JOIN `fulfillment-dwh-production.cl.pricing_component_configuration_versions_priority_fee` conf
-- ON expe.entity_id = conf.entity_id AND expe.priority_fee_config_id = conf.component_id
-- WHERE active_from <<= test_start_date AND (active_to >>= test_end_date OR active_to IS NULL)
-- )


-- Tests Total Population- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

--Retrieve the total population to later use to determine the share per variant
, total_pop AS(
  SELECT
          A.name test_name
        , A.id
        , A.global_entity_id
        , JSON_EXTRACT_SCALAR(variant_share, '$.variant') variant
        , CAST(JSON_EXTRACT_SCALAR(variant_share, '$.share') as numeric) share

FROM `fulfillment-dwh-production.dl.dynamic_pricing_experiment` A, 
 UNNEST(JSON_EXTRACT_ARRAY(shares, '$.variant_shares')) AS variant_share
WHERE LOWER(experiment_type)="ab_mab"
AND created_at>>='2023-01-01'
AND already_executed = TRUE
GROUP BY ALL
)

, total_pop_final AS(
SELECT  test_name
        , id
        , global_entity_id
        , SUM(share) total_pop
FROM total_pop
GROUP BY ALL
)


-- FINALIZING QUERY- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

SELECT  created_date
        , created_at
        , analysed_date
        , ut.country_code
        , ut.entity_id
        , ut.test_id
        , ut.test_name
        , version
        , kpi
        , winning_probability
        , variant_name
        , bayesian_mean
        , hdi_lower_bound
        , hdi_upper_bound
        , lower_quartile
        , upper_quartile
        , COALESCE(target_kpi, MAX(target_kpi) OVER(PARTITION BY entity_id, ut.test_name)) AS target_kpi
        , total_pop
        --replace NULL for the first days of share -- still need to automate the diff between MIN(created_date) and first_date of variant record, to automate the interval
, CASE WHEN created_date << (MIN(created_date) OVER(PARTITION BY ut.entity_id, ut.test_name, kpi ORDER BY created_date) + interval 6 day) THEN COALESCE(total_pop / COUNT(DISTINCT variant_name) OVER(PARTITION BY ut.entity_id, ut.test_name, kpi, created_date))
      ELSE share END AS share
FROM union_tabs AS ut
LEFT JOIN total_pop_final tpf
ON ut.entity_id = tpf.global_entity_id AND ut.test_name = tpf.test_name --AND ut.test_id = tpf.id]]></relation>
