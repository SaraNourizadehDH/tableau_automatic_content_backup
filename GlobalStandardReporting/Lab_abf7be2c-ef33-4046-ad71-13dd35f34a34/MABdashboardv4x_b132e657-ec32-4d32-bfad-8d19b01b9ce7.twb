                <relation connection='bigquery.1f0tzdd09k8cbv10q33dw1fziycy' name='Custom SQL Query' type='text'>WITH prio_orders AS (
  SELECT 
  entity_id, 
  platform_order_code,
  priority_fee_eur,
  priority_fee_local,
  FROM `logistics-data-storage-staging.shared_pricing.prio_orders` 
  WHERE created_date_local &gt;&gt;= &apos;2024-11-01&apos;
  AND entity_id LIKE (&apos;PY_%&apos;) OR entity_id LIKE (&apos;AP_%&apos;)
  AND has_dps_priority_fee IS TRUE
)

, base_orders AS (
  SELECT
  country_code,
  created_date,
  region,
  entity_id,
  perseus_client_id, 
  DATE(created_date) order_date,
  zone_name,
  test_name,
  platform_order_code,
  test_variant,
  is_in_treatment,
  ROUND(mean_delay) as mean_delay, 
  ROUND(actual_delivery_time) as delivery_time,
  dps_delivery_fee_local,
  gfv_local,
  dps_priority_fee_local,
  dps_priority_fee_eur,
  priority_fee_eur,
  priority_fee_local
  FROM `fulfillment-dwh-production.cl.dps_test_orders`
  WHERE created_date &gt;&gt;= &apos;2024-11-01&apos;
  AND test_name IN (SELECT 
    DISTINCT test_name
    FROM `fulfillment-dwh-production.cl.dps_experiment_setups`
    WHERE scheme_component_ids.priority_fee_config_id is not null
    AND (test_name LIKE (&apos;%MAB%&apos;) OR test_name LIKE(&apos;%Var_Gen%&apos;))
    AND (is_active OR is_already_executed)
    )
  AND vendor_vertical_parent NOT IN (&apos;courier&apos;, &apos;courier_business&apos;)
  AND dps_priority_fee_local is not null
  AND dps_priority_fee_local IS NOT NULL
  AND is_sent
  AND is_own_delivery
  AND platform_order_code IS NOT NULL
)

  SELECT 
  dps.country_code,
  dps.region,
  dps.entity_id,
  dps.perseus_client_id,
  dps.order_date,
  dps.zone_name,
  dps.test_name,
  dps.platform_order_code,
  dps.test_variant,
  dps.is_in_treatment,
  dps.delivery_time,
  dps.dps_delivery_fee_local,
  dps.gfv_local,
  dps.dps_priority_fee_local,
  dps.dps_priority_fee_eur,
  CASE WHEN dps.region = &apos;Americas&apos; THEN IFNULL(prio.priority_fee_local,0) ELSE IFNULL(dps.priority_fee_local,0) END as priority_fee_local,
  CASE WHEN dps.region = &apos;Americas&apos; THEN IFNULL(prio.priority_fee_eur,0) ELSE IFNULL(dps.priority_fee_eur,0) END as priority_fee_eur
  FROM base_orders dps
  LEFT JOIN prio_orders prio 
  ON dps.entity_id = prio.entity_id
  AND dps.platform_order_code = prio.platform_order_code</relation>
                <relation connection='bigquery.1f0tzdd09k8cbv10q33dw1fziycy' name='_tableau_country_user_entitlements' table='[fulfillment-dwh-production.cl].[_tableau_country_user_entitlements]' type='table' />
              </relation>
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='Setup Configuration' inline='true' name='federated.0kzzi8u1ktlbrx1dvn03f02xlfyu' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.104o0v71x8tke0181vzfk1ueweag'>
            <connection CATALOG='publicdata' EXECCATALOG='logistics-customer-staging' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='publicdata' schema='samples' server-oauth='' username='saptarshi.bhattacharya@deliveryhero.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.104o0v71x8tke0181vzfk1ueweag' name='Custom SQL Query' type='text'>--Update 23/05/2025
-- In Setup Configuration: Fixed DBDF Configuration display when test is for Priority

-- Update 22/05/2025
-- Added last value for TT threshold if NULL
-- Added first_date and last_date for variants to determine in Tableau if variants are &apos;alive&apos; or &apos;dead&apos;

-- Retrieve Priority ID for missing
WITH valid_test_names AS(
SELECT 
                      DISTINCT test_name
                              , test_start_date
                      FROM `fulfillment-dwh-production.cl.dps_experiment_setups`
                      WHERE (test_name LIKE &apos;%MAB%&apos; OR test_name LIKE &apos;%Var_Gen%&apos;)
                      AND DATE(test_start_date) &gt;&gt; DATE(&apos;2023-01-01&apos;)
                      AND (is_active OR is_already_executed)            
)


--retrieve first and last date for each variant in test
, first_last_date AS(
  SELECT 
  DISTINCT 
  entity_id
  , test_name
  , test_variant
  , FIRST_VALUE(created_date) OVER(PARTITION BY entity_id, test_name, test_variant ORDER BY created_date) AS first_date
  , LAST_VALUE(created_date) OVER(PARTITION BY entity_id, test_name, test_variant ORDER BY created_date) AS last_date
  FROM `fulfillment-dwh-production.cl.dps_test_orders`
  WHERE test_name IN (SELECT test_name FROM valid_test_names)
)


, valid_variants_prio AS (
  SELECT 
  DISTINCT 
  dto.entity_id
  , dto.test_name
  , dto.test_variant
  , components.priority_fee_id
  , COUNT(platform_order_code) AS orders
  , RANK() OVER(PARTITION BY dto.test_name, dto.test_variant ORDER BY COUNT(platform_order_code) DESC) AS ranked
  FROM `fulfillment-dwh-production.cl.dps_test_orders` dto
  LEFT JOIN first_last_date fld
  ON dto.entity_id = fld.entity_id AND dto.test_variant = fld.test_variant AND dto.test_name = fld.test_name
  WHERE dto.test_name IN (SELECT test_name FROM valid_test_names)
        AND is_in_treatment
  GROUP BY 1,2,3, 4
)

, prio_config AS(
SELECT  vv.entity_id
        , vv.test_name
        , test_variant
        , NULL AS travel_time_fee_id
        , priority_fee_id

        , prio.active_from AS active_from_prio
        , prio.active_to AS active_to_prio
        , TIMESTAMP(NULL) AS active_from_dbdf
        , TIMESTAMP(NULL) AS active_to_dbdf

        , prio.config.percentage_fee
        , prio.config.min_fee
        , prio.config.max_fee
        , CAST(NULL AS STRING) AS travel_time_threshold
        , NULL AS travel_time_fee
FROM valid_variants_prio vv
JOIN `fulfillment-dwh-production.cl.pricing_component_configuration_versions_priority_fee` prio 
ON vv.entity_id = prio.entity_id AND vv.priority_fee_id = prio.component_id
JOIN valid_test_names vtn
ON vv.test_name = vtn.test_name
WHERE ranked = 1
      AND (test_start_date &gt;&gt;= prio.active_from AND (prio.active_to &gt;&gt;= test_start_date OR prio.active_to IS NULL)) 
      AND (vv.test_name NOT LIKE &apos;%DBDF%&apos;)
)

-- Retrieve DBDF config setup
, valid_variants_dbdf AS (
  SELECT 
  DISTINCT 
  dto.entity_id
  , dto.test_name
  , dto.test_variant
  , components.travel_time_fee_id
  , test_components.priority_fee_id -- being tested
  , COUNT(platform_order_code) AS orders
  FROM `fulfillment-dwh-production.cl.dps_test_orders` dto
  WHERE dto.test_name IN (SELECT test_name FROM valid_test_names)
        AND is_in_treatment
        AND dto.test_name NOT IN (SELECT --Exclude Priority tests
                      DISTINCT test_name
                      FROM `fulfillment-dwh-production.cl.dps_experiment_setups`
                      WHERE (test_name LIKE &apos;%MAB%&apos; OR test_name LIKE &apos;%Var_Gen%&apos;)
                      AND DATE(test_start_date) &gt;&gt; DATE(&apos;2023-01-01&apos;)
                      AND (is_active OR is_already_executed)            
               
AND scheme_component_ids.priority_fee_config_id IS NOT NULL)
  GROUP BY 1,2,3, 4, 5
)

, dbdf_config AS(
SELECT  vv.entity_id
        , vv.test_name
        , test_variant
        , travel_time_fee_id
        , NULL AS priority_fee_id
        , TIMESTAMP(NULL) AS active_from_prio
        , TIMESTAMP(NULL) AS active_to_prio
        , ttf.active_from AS active_from_dbdf
        , ttf.active_to AS active_to_dbdf
        , NULL AS percentage_fee
        , NULL AS min_fee
        , NULL AS max_fee
        , CAST(COALESCE(CAST(ttt[0] AS STRING), CONCAT(&apos;&gt;&gt; &apos;, CAST(MAX(travel_time_threshold) OVER(PARTITION BY vv.entity_id, vv.test_name, vv.test_variant, travel_time_fee_id) AS STRING))) AS STRING) AS travel_time_threshold
        , ttt[1] AS travel_time_fee
FROM valid_variants_dbdf vv
JOIN  `fulfillment-dwh-production.cl.pricing_component_configuration_versions_travel_time_fee` ttf 
ON vv.entity_id = ttf.entity_id AND vv.travel_time_fee_id = ttf.component_id
JOIN valid_test_names vtn
ON vv.test_name = vtn.test_name,
UNNEST(config) AS ttt WITH OFFSET offset1
WHERE ttf.is_dbdf
      AND (test_start_date &gt;&gt;= ttf.active_from AND (ttf.active_to &gt;&gt;= test_start_date OR ttf.active_to IS NULL))
      AND priority_fee_id IS NULL
)

, config AS(
SELECT *
FROM prio_config
UNION ALL
SELECT *
FROM dbdf_config
)

-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - 

-- Retrieve new variant for MAB Prio test
, new_variant_prio AS(
SELECT DISTINCT
        des.entity_id
        , des.test_name
        , des.test_variant
        , NULL AS travel_time_fee_id
        , NULL AS priority_fee_id
        , active_from AS active_from_prio
        , active_to AS active_to_prio
        , TIMESTAMP(NULL) AS active_from_dbdf
        , TIMESTAMP(NULL) AS active_to_dbdf
        , config.percentage_fee
        , config.min_fee
        , config.max_fee
        , CAST(NULL AS STRING) AS travel_time_threshold
        , NULL AS travel_time_fee
FROM `fulfillment-dwh-production.cl.dps_test_orders` des
LEFT JOIN `fulfillment-dwh-production.cl.pricing_component_configuration_versions_priority_fee` pc
ON pc.entity_id = des.entity_id
AND pc.component_id = test_components.priority_fee_id
AND test_components.priority_fee_id is not null
AND pc.config.min_fee IS NOT NULL
AND pc.config.max_fee IS NOT NULL
WHERE active_from IS NOT NULL
AND (des.test_name LIKE &apos;%MAB%&apos; OR des.test_name LIKE &apos;%Var_Gen%&apos;)
ORDER BY test_variant
)


-- Retrieve new variant for MAB DBDF test
, new_variant_dbdf AS(
SELECT DISTINCT
        des.entity_id
        , des.test_name
        , des.test_variant
        , component_id AS travel_time_fee_id
        , NULL AS priority_fee_id
        , TIMESTAMP(NULL) AS active_from_prio
        , TIMESTAMP(NULL) AS active_to_prio
        , active_from AS active_from_dbdf
        , active_to AS active_to_dbdf
        , NULL AS percentage_fee
        , NULL AS min_fee
        , NULL AS max_fee
        , CAST(COALESCE(CAST(ttt[0] AS STRING), CONCAT(&apos;&gt;&gt; &apos;, CAST(MAX(travel_time_threshold) OVER(PARTITION BY des.entity_id, des.test_name, des.test_variant, component_id) AS STRING))) AS STRING) AS travel_time_threshold
        , ttt[1] AS travel_time_fee
FROM `fulfillment-dwh-production.cl.dps_test_orders` des
LEFT JOIN `fulfillment-dwh-production.cl.pricing_component_configuration_versions_travel_time_fee` pc
ON pc.entity_id = des.entity_id AND pc.component_id = test_setup_components.travel_time_config_id,
UNNEST(config) AS ttt
WHERE (des.test_name LIKE &apos;%MAB%&apos; OR des.test_name LIKE &apos;%Var_Gen%&apos;)
AND active_from IS NOT NULL
AND test_components.priority_fee_id IS NULL
)


, new_variant AS(
        SELECT * FROM new_variant_prio
        UNION ALL
        SELECT * FROM new_variant_dbdf
)


-- Final UNION between Base variants configurations and new variants configurations
, final_config AS(
SELECT DISTINCT mnv.*
FROM new_variant mnv
-- LEFT JOIN (
--     SELECT DISTINCT entity_id, test_name, test_variant
--     FROM config
-- ) AS distinct_config ON mnv.entity_id = distinct_config.entity_id
--                        AND mnv.test_name = distinct_config.test_name
--                        AND mnv.test_variant = distinct_config.test_variant
-- WHERE distinct_config.test_variant IS NULL

UNION ALL

SELECT * FROM config
)

SELECT fc.*
        , MAX(fld.first_date) AS first_date
        , MAX(fld.last_date) AS last_date
FROM final_config fc
LEFT JOIN first_last_date fld
ON fc.entity_id = fld.entity_id AND fc.test_name = fld.test_name AND fc.test_variant = fld.test_variant
GROUP BY ALL</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.104o0v71x8tke0181vzfk1ueweag' name='Custom SQL Query' type='text'>--Update 23/05/2025
-- In Setup Configuration: Fixed DBDF Configuration display when test is for Priority

-- Update 22/05/2025
-- Added last value for TT threshold if NULL
-- Added first_date and last_date for variants to determine in Tableau if variants are &apos;alive&apos; or &apos;dead&apos;

-- Retrieve Priority ID for missing
WITH valid_test_names AS(
SELECT 
                      DISTINCT test_name
                              , test_start_date
                      FROM `fulfillment-dwh-production.cl.dps_experiment_setups`
                      WHERE (test_name LIKE &apos;%MAB%&apos; OR test_name LIKE &apos;%Var_Gen%&apos;)
                      AND DATE(test_start_date) &gt;&gt; DATE(&apos;2023-01-01&apos;)
                      AND (is_active OR is_already_executed)            
)


--retrieve first and last date for each variant in test
, first_last_date AS(
  SELECT 
  DISTINCT 
  entity_id
  , test_name
  , test_variant
  , FIRST_VALUE(created_date) OVER(PARTITION BY entity_id, test_name, test_variant ORDER BY created_date) AS first_date
  , LAST_VALUE(created_date) OVER(PARTITION BY entity_id, test_name, test_variant ORDER BY created_date) AS last_date
  FROM `fulfillment-dwh-production.cl.dps_test_orders`
  WHERE test_name IN (SELECT test_name FROM valid_test_names)
)


, valid_variants_prio AS (
  SELECT 
  DISTINCT 
  dto.entity_id
  , dto.test_name
  , dto.test_variant
  , components.priority_fee_id
  , COUNT(platform_order_code) AS orders
  , RANK() OVER(PARTITION BY dto.test_name, dto.test_variant ORDER BY COUNT(platform_order_code) DESC) AS ranked
  FROM `fulfillment-dwh-production.cl.dps_test_orders` dto
  LEFT JOIN first_last_date fld
  ON dto.entity_id = fld.entity_id AND dto.test_variant = fld.test_variant AND dto.test_name = fld.test_name
  WHERE dto.test_name IN (SELECT test_name FROM valid_test_names)
        AND is_in_treatment
  GROUP BY 1,2,3, 4
)

, prio_config AS(
SELECT  vv.entity_id
        , vv.test_name
        , test_variant
        , NULL AS travel_time_fee_id
        , priority_fee_id

        , prio.active_from AS active_from_prio
        , prio.active_to AS active_to_prio
        , TIMESTAMP(NULL) AS active_from_dbdf
        , TIMESTAMP(NULL) AS active_to_dbdf

        , prio.config.percentage_fee
        , prio.config.min_fee
        , prio.config.max_fee
        , CAST(NULL AS STRING) AS travel_time_threshold
        , NULL AS travel_time_fee
FROM valid_variants_prio vv
JOIN `fulfillment-dwh-production.cl.pricing_component_configuration_versions_priority_fee` prio 
ON vv.entity_id = prio.entity_id AND vv.priority_fee_id = prio.component_id
JOIN valid_test_names vtn
ON vv.test_name = vtn.test_name
WHERE ranked = 1
      AND (test_start_date &gt;&gt;= prio.active_from AND (prio.active_to &gt;&gt;= test_start_date OR prio.active_to IS NULL)) 
      AND (vv.test_name NOT LIKE &apos;%DBDF%&apos;)
)

-- Retrieve DBDF config setup
, valid_variants_dbdf AS (
  SELECT 
  DISTINCT 
  dto.entity_id
  , dto.test_name
  , dto.test_variant
  , components.travel_time_fee_id
  , test_components.priority_fee_id -- being tested
  , COUNT(platform_order_code) AS orders
  FROM `fulfillment-dwh-production.cl.dps_test_orders` dto
  WHERE dto.test_name IN (SELECT test_name FROM valid_test_names)
        AND is_in_treatment
        AND dto.test_name NOT IN (SELECT --Exclude Priority tests
                      DISTINCT test_name
                      FROM `fulfillment-dwh-production.cl.dps_experiment_setups`
                      WHERE (test_name LIKE &apos;%MAB%&apos; OR test_name LIKE &apos;%Var_Gen%&apos;)
                      AND DATE(test_start_date) &gt;&gt; DATE(&apos;2023-01-01&apos;)
                      AND (is_active OR is_already_executed)            
               
AND scheme_component_ids.priority_fee_config_id IS NOT NULL)
  GROUP BY 1,2,3, 4, 5
)

, dbdf_config AS(
SELECT  vv.entity_id
        , vv.test_name
        , test_variant
        , travel_time_fee_id
        , NULL AS priority_fee_id
        , TIMESTAMP(NULL) AS active_from_prio
        , TIMESTAMP(NULL) AS active_to_prio
        , ttf.active_from AS active_from_dbdf
        , ttf.active_to AS active_to_dbdf
        , NULL AS percentage_fee
        , NULL AS min_fee
        , NULL AS max_fee
        , CAST(COALESCE(CAST(ttt[0] AS STRING), CONCAT(&apos;&gt;&gt; &apos;, CAST(MAX(travel_time_threshold) OVER(PARTITION BY vv.entity_id, vv.test_name, vv.test_variant, travel_time_fee_id) AS STRING))) AS STRING) AS travel_time_threshold
        , ttt[1] AS travel_time_fee
FROM valid_variants_dbdf vv
JOIN  `fulfillment-dwh-production.cl.pricing_component_configuration_versions_travel_time_fee` ttf 
ON vv.entity_id = ttf.entity_id AND vv.travel_time_fee_id = ttf.component_id
JOIN valid_test_names vtn
ON vv.test_name = vtn.test_name,
UNNEST(config) AS ttt WITH OFFSET offset1
WHERE ttf.is_dbdf
      AND (test_start_date &gt;&gt;= ttf.active_from AND (ttf.active_to &gt;&gt;= test_start_date OR ttf.active_to IS NULL))
      AND priority_fee_id IS NULL
)

, config AS(
SELECT *
FROM prio_config
UNION ALL
SELECT *
FROM dbdf_config
)

-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - 

-- Retrieve new variant for MAB Prio test
, new_variant_prio AS(
SELECT DISTINCT
        des.entity_id
        , des.test_name
        , des.test_variant
        , NULL AS travel_time_fee_id
        , NULL AS priority_fee_id
        , active_from AS active_from_prio
        , active_to AS active_to_prio
        , TIMESTAMP(NULL) AS active_from_dbdf
        , TIMESTAMP(NULL) AS active_to_dbdf
        , config.percentage_fee
        , config.min_fee
        , config.max_fee
        , CAST(NULL AS STRING) AS travel_time_threshold
        , NULL AS travel_time_fee
FROM `fulfillment-dwh-production.cl.dps_test_orders` des
LEFT JOIN `fulfillment-dwh-production.cl.pricing_component_configuration_versions_priority_fee` pc
ON pc.entity_id = des.entity_id
AND pc.component_id = test_components.priority_fee_id
AND test_components.priority_fee_id is not null
AND pc.config.min_fee IS NOT NULL
AND pc.config.max_fee IS NOT NULL
WHERE active_from IS NOT NULL
AND (des.test_name LIKE &apos;%MAB%&apos; OR des.test_name LIKE &apos;%Var_Gen%&apos;)
ORDER BY test_variant
)


-- Retrieve new variant for MAB DBDF test
, new_variant_dbdf AS(
SELECT DISTINCT
        des.entity_id
        , des.test_name
        , des.test_variant
        , component_id AS travel_time_fee_id
        , NULL AS priority_fee_id
        , TIMESTAMP(NULL) AS active_from_prio
        , TIMESTAMP(NULL) AS active_to_prio
        , active_from AS active_from_dbdf
        , active_to AS active_to_dbdf
        , NULL AS percentage_fee
        , NULL AS min_fee
        , NULL AS max_fee
        , CAST(COALESCE(CAST(ttt[0] AS STRING), CONCAT(&apos;&gt;&gt; &apos;, CAST(MAX(travel_time_threshold) OVER(PARTITION BY des.entity_id, des.test_name, des.test_variant, component_id) AS STRING))) AS STRING) AS travel_time_threshold
        , ttt[1] AS travel_time_fee
FROM `fulfillment-dwh-production.cl.dps_test_orders` des
LEFT JOIN `fulfillment-dwh-production.cl.pricing_component_configuration_versions_travel_time_fee` pc
ON pc.entity_id = des.entity_id AND pc.component_id = test_setup_components.travel_time_config_id,
UNNEST(config) AS ttt
WHERE (des.test_name LIKE &apos;%MAB%&apos; OR des.test_name LIKE &apos;%Var_Gen%&apos;)
AND active_from IS NOT NULL
AND test_components.priority_fee_id IS NULL
)


, new_variant AS(
        SELECT * FROM new_variant_prio
        UNION ALL
        SELECT * FROM new_variant_dbdf
)


-- Final UNION between Base variants configurations and new variants configurations
, final_config AS(
SELECT DISTINCT mnv.*
FROM new_variant mnv
-- LEFT JOIN (
--     SELECT DISTINCT entity_id, test_name, test_variant
--     FROM config
-- ) AS distinct_config ON mnv.entity_id = distinct_config.entity_id
--                        AND mnv.test_name = distinct_config.test_name
--                        AND mnv.test_variant = distinct_config.test_variant
-- WHERE distinct_config.test_variant IS NULL

UNION ALL

SELECT * FROM config
)

SELECT fc.*
        , MAX(fld.first_date) AS first_date
        , MAX(fld.last_date) AS last_date
FROM final_config fc
LEFT JOIN first_last_date fld
ON fc.entity_id = fld.entity_id AND fc.test_name = fld.test_name AND fc.test_variant = fld.test_variant
GROUP BY ALL</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
