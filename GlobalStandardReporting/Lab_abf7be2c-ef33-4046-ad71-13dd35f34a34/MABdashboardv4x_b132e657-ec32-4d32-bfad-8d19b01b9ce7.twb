      <column caption='Calc_Count_Non-Priority_Order(calc. field) ' datatype='integer' name='[Calc_Priority_Order_Count (calc. field) (copy)_275423276958879759]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='{FIXED [platform_order_code] : MAX(IF [priority_fee_local] = 0 THEN 1 END)}' />
      </column>
      <column caption='Calc_prio_fee_total_eur (calc. field) ' datatype='real' name='[Calc_prio_fee_total_local (calc. field) (copy)_275423276954382349]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [platform_order_code] : AVG([priority_fee_eur])}' />
      </column>
      <column caption='Calc_Count_Total_Orders (calc. field)' datatype='integer' name='[Calculation_275423276682027011]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calc_Priority_Order_Count (calc. field) (copy)_275423276958879759]) + SUM([Calculation_275423276956143630])' />
      </column>
      <column caption='Calc_prio_fee_total_local (calc. field)' datatype='real' name='[Calculation_275423276952272908]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [platform_order_code] : AVG([priority_fee_local])}' />
      </column>
      <column caption='Calc_Count_Priority_Order(calc. field)' datatype='integer' name='[Calculation_275423276956143630]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='{FIXED [platform_order_code] : MAX(IF [priority_fee_local] &gt; 0 THEN 1 END)}' />
      </column>
      <column caption='Calc_Adoption_Rate (calc. field)' datatype='real' name='[Calculation_275423276959748113]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_275423276956143630]) /&#10;(SUM([Calc_Priority_Order_Count (calc. field) (copy)_275423276958879759]) + SUM([Calculation_275423276956143630]))' />
      </column>
      <column caption='Calc_Avg_Prio_Fee (calc. field)' datatype='real' name='[Calculation_275423276982603794]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_275423276952272908]) / SUM([Calculation_275423276956143630])' />
      </column>
