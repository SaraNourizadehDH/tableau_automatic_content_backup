      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_9CDCEFDDE71D43679C40EA332DFE3CCA'>
            <properties context=''>
              <relation join='inner' type='join'>
                <clause type='join'>
