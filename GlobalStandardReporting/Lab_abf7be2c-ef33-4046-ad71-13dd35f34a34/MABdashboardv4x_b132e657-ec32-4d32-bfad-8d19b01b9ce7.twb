      <aliases enabled='yes' />
      <column caption='State' datatype='string' name='[Calculation_275423277378580505]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF {FIXED [entity_id], [test_name], [test_variant]: MAX([last_date])} &gt;= DATEADD(&apos;day&apos;, -2, TODAY())&#10;THEN &quot;Alive&quot;&#10;ELSE &quot;Dead&quot;&#10;END' />
      </column>
      <column caption='Percentage Fee' datatype='real' name='[Calculation_275423277391605786]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([percentage_fee])' />
      </column>
      <column caption='Max Fee' datatype='real' name='[Calculation_275423277391888411]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([max_fee])' />
      </column>
      <column caption='Min Fee' datatype='real' name='[Calculation_275423277392125980]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([min_fee])' />
      </column>
      <column caption='Global Calendar' datatype='boolean' name='[Calculation_275423277639495709]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] &gt;= {FIXED [entity_id], [test_name]: MIN([first_date])}&#10;AND&#10;[Parameters].[Parameter 4] &lt;= {FIXED [entity_id], [test_name]: MAX([last_date])} THEN TRUE&#10;ELSE FALSE END' />
      </column>
      <column caption='Last Date - 2 days (calc. field)' datatype='datetime' name='[Calculation_275423277641687070]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEADD(&apos;day&apos;, -2, [last_date])' />
      </column>
      <column caption='Adjusted date (calc. field)' datatype='datetime' name='[Calculation_275423277684178975]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEADD(&apos;day&apos;, 3, [first_date])' />
      </column>
