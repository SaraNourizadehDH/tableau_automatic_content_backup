              <calculation class='tableau' formula='if[kpi] = [target_kpi] then [hdi_lower_bound] END' />
            </column>
            <column caption='calculated_lower_bound' datatype='real' name='[Calculation_2170735027763896350]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [kpi] = [target_kpi] THEN [hdi_lower_bound] END' />
            </column>
            <column caption='Upper_bound (calc. field)' datatype='real' name='[Calculation_3108961498453983232]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN([Calculation_2170735027763781661]) + MIN([Calculation_2170735027759853589])' />
            </column>
            <column caption='if [kpi]=[target_kpi] THEN [bayesian_mean] END' datatype='real' name='[Calculation_3419358024093061131]' role='measure' type='quantitative' user:unnamed='Bayesian Mean'>
              <calculation class='tableau' formula='if [kpi]=[target_kpi] THEN [bayesian_mean] END' />
            </column>
            <column caption='if [kpi]= [target_kpi] THEN ([hdi_upper_bound_fixed (calc. fi...' datatype='real' name='[Calculation_3419358024093904908]' role='measure' type='quantitative' user:unnamed='Bayesian Mean'>
              <calculation class='tableau' formula='if [kpi]= [target_kpi] THEN ([Calculation_6366189919515492353]) END' />
            </column>
            <column caption='if [kpi] = [target_kpi] THEN [hdi_lower_bound_fixed (calc. fi...' datatype='real' name='[Calculation_3419358024094105613]' role='measure' type='quantitative' user:unnamed='Bayesian Mean'>
              <calculation class='tableau' formula='if [kpi] = [target_kpi] THEN [Calculation_6366189919514091520] END' />
            </column>
            <column caption='hdi_lower_bound_fixed (calc. field)' datatype='real' name='[Calculation_6366189919514091520]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [entity_id], [test_name], [analysed_date], [kpi]: AVG([hdi_lower_bound])}' />
            </column>
            <column caption='hdi_upper_bound_fixed (calc. field)' datatype='real' name='[Calculation_6366189919515492353]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [entity_id], [test_name], [kpi], [analysed_date]: AVG([hdi_upper_bound])}' />
            </column>
            <column datatype='date' name='[analysed_date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_3419358024093904908]' derivation='Avg' name='[avg:Calculation_3419358024093904908:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_3419358024094105613]' derivation='Avg' name='[avg:Calculation_3419358024094105613:qk]' pivot='key' type='quantitative' />
            <column datatype='real' name='[bayesian_mean]' role='measure' type='quantitative' />
            <column datatype='date' name='[created_date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[entity_id]' role='dimension' type='nominal' />
            <column datatype='real' name='[hdi_lower_bound]' role='measure' type='quantitative' />
            <column datatype='real' name='[hdi_upper_bound]' role='measure' type='quantitative' />
            <column datatype='string' name='[kpi]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2170735027763896350]' derivation='Max' name='[max:Calculation_2170735027763896350:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2170735027759853589]' derivation='Min' name='[min:Calculation_2170735027759853589:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2170735027763781661]' derivation='Min' name='[min:Calculation_2170735027763781661:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2170735027763896350]' derivation='Min' name='[min:Calculation_2170735027763896350:qk]' pivot='key' type='quantitative' />
