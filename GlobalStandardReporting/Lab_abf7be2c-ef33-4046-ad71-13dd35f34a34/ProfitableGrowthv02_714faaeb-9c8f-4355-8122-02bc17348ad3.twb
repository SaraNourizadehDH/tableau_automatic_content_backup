      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.16abyg00colr271d2ooa00hrexfp].[sum:analytical_profit_post_holdout_duplicated:qk]&quot;' value='Analytical Profit Duplicate HO' />
          <alias key='&quot;[federated.16abyg00colr271d2ooa00hrexfp].[sum:analytical_profit_post_non_holdout_duplicated:qk]&quot;' value='Analytical Profit Duplicate Non-HO' />
          <alias key='&quot;[federated.16abyg00colr271d2ooa00hrexfp].[sum:orders_holdout_mode:qk]&quot;' value='orders_post_holdout_all' />
          <alias key='&quot;[federated.16abyg00colr271d2ooa00hrexfp].[sum:orders_post_holdout_duplicated:qk]&quot;' value='Order Duplicate HO' />
          <alias key='&quot;[federated.16abyg00colr271d2ooa00hrexfp].[sum:orders_post_non_holdout_duplicated:qk]&quot;' value='Order Duplicate Non-HO' />
        </aliases>
      </column>
      <column caption='Diff_order_per_user' datatype='real' name='[Calculation_169518331201888264]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[orders_per_user_holdout_all] - [orders_per_user_holdout_all_removing_duplicates]' />
      </column>
      <column caption='Release Date Agg (calc. field)' datatype='date' name='[Calculation_2446299039503466496]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MAX([release_date])' />
      </column>
      <column caption='holdout_share' datatype='real' name='[Calculation_3841429769434460172]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[users_only_holdout] / ([users_only_holdout] + [users_only_non_holdout])' />
      </column>
      <column caption='% Users with holdout and non holdout assignments' datatype='real' name='[Calculation_3841429769597759501]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[users_with_duplicate_sessions] / ([users_with_duplicate_sessions] + [users_only_holdout])' />
      </column>
      <column caption='% orders duplicated' datatype='real' name='[Calculation_3841429769600692238]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='orders_post_non_holdout_duplicated / ([orders_holdout_mode] + orders_post_non_holdout_duplicated)' />
      </column>
      <column caption='% fallback' datatype='real' name='[Calculation_3841429769601679375]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[holdout_orders_w_fallback] / [orders_holdout_mode]' />
      </column>
      <column caption='% FLGP Duplicated' datatype='real' name='[Calculation_3841429769617358864]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ABS([flgp_post_non_holdout_duplicated]) / (abs([flgp_holdout_mode]) + abs([flgp_post_non_holdout_duplicated]))' />
      </column>
      <column caption='Order level Conditional Formating' datatype='real' name='[Calculation_3841429769622663185]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3841429769597759501]' />
      </column>
      <column caption='order_lvl_MIN(1) - 1 - users_only_holdout' datatype='integer' name='[Calculation_3841429769625124882]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN(1)' />
      </column>
      <column caption='Brand (calc. field)' datatype='string' name='[Calculation_4197847450450690048]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF STARTSWITH([entity_id], &apos;AP&apos;) THEN &apos;PedyDosia&apos; &#10;ELSEIF STARTSWITH([entity_id], &apos;DJ&apos;) THEN &apos;Foodora&apos;&#10;ELSEIF STARTSWITH([entity_id], &apos;EF&apos;) THEN &apos;eFood&apos;&#10;ELSEIF STARTSWITH([entity_id], &apos;FO&apos;) THEN &apos;Foodora&apos;&#10;ELSEIF STARTSWITH([entity_id], &apos;FP&apos;) THEN &apos;FoodPanda&apos;&#10;ELSEIF STARTSWITH([entity_id], &apos;FY&apos;) THEN &apos;eFood&apos;&#10;ELSEIF STARTSWITH([entity_id], &apos;GV&apos;) THEN &apos;Glovo&apos;&#10;ELSEIF STARTSWITH([entity_id], &apos;HF&apos;) THEN &apos;Talabat&apos;&#10;ELSEIF STARTSWITH([entity_id], &apos;HS&apos;) THEN &apos;HungerStation&apos;&#10;ELSEIF STARTSWITH([entity_id], &apos;MJM&apos;) THEN &apos;Foodora&apos;&#10;ELSEIF STARTSWITH([entity_id], &apos;NP&apos;) THEN &apos;Foodora&apos;&#10;ELSEIF STARTSWITH([entity_id], &apos;OP&apos;) THEN &apos;Foodora&apos;&#10;ELSEIF STARTSWITH([entity_id], &apos;PO&apos;) THEN &apos;Foodora&apos;&#10;ELSEIF STARTSWITH([entity_id], &apos;PY&apos;) THEN &apos;PediDosya&apos;&#10;ELSEIF STARTSWITH([entity_id], &apos;TB&apos;) THEN &apos;Talabat&apos;&#10;ELSEIF STARTSWITH([entity_id], &apos;YS&apos;) THEN &apos;Yemeksepeti&apos;&#10;END' />
      </column>
      <column caption='Flag ' datatype='integer' name='[Calculation_4197847450455789570]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IF [Calculation_6734499940932448259] &gt; 0 THEN 1 ELSE 0 END' />
      </column>
      <column caption='Percentage diff profit post/pre' datatype='real' name='[Calculation_5190750430845575168]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([analytical_profit_post]) - SUM([analytical_profit_pre])) / SUM([analytical_profit_pre])' />
      </column>
      <column caption='Total profit duplicated (calc. field)' datatype='real' name='[Calculation_5190750430847459329]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([analytical_profit_post_holdout_duplicated]) + SUM([analytical_profit_post_non_holdout_duplicated])' />
      </column>
      <column caption='Total Order Duplicate' datatype='integer' name='[Calculation_6734499940932448259]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_post_holdout_duplicated]) + SUM([orders_post_non_holdout_duplicated])' />
      </column>
      <column caption='Total Analytical Profit Duplicate' datatype='real' name='[Calculation_6734499940932702212]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([analytical_profit_post_holdout_duplicated]) + SUM([analytical_profit_post_non_holdout_duplicated])' />
      </column>
      <column caption='Diff_flgp_per_user' datatype='real' name='[Diff_order_per_user (copy)_169518331203174409]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[flgp_per_user_holdout_all] - [flgp_per_user_holdout_all_removing_duplicates]' />
      </column>
