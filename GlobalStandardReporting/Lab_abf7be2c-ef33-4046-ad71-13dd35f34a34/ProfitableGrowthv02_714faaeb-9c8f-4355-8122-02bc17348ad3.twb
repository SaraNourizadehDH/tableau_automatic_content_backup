        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1o1irm80igvwi415ixww81kwdnaf' name='Custom SQL Query' type='text'>WITH test AS(SELECT brand_name,
       entity_id,
       group_type,
       vertical_type,
       week,
       as_of_date,
       observed_profitable_growth profitable_growth,
       ci_low profitable_growth_ci_low,
       ci_high profitable_growth_ci_high,
       analytical_profit_post_holdout_cuped_pct_diff analytical_profit_pct_diff,--analytical_profit_post_cuped_pct_diff analytical_profit_pct_diff,
       analytical_profit_post_holdout_cuped_pct_ci_low analytical_profit_pct_ci_low,--analytical_profit_post_cuped_pct_ci_low analytical_profit_pct_ci_low,
       analytical_profit_post_holdout_cuped_pct_ci_high analytical_profit_pct_ci_high, -- analytical_profit_post_cuped_pct_ci_high analytical_profit_pct_ci_high,
       orders_post_holdout_cuped_pct_diff orders_pct_diff, --orders_post_cuped_pct_diff orders_pct_diff,
       orders_post_holdout_cuped_pct_ci_low orders_pct_diff_ci_low, --orders_post_cuped_pct_ci_low orders_pct_diff_ci_low,
       orders_post_holdout_cuped_pct_ci_high orders_pct_diff_ci_high, --orders_post_cuped_pct_ci_high orders_pct_diff_ci_high

       analytical_profit_post_holdout_cuped_abs_diff profit_abs, --analytical_profit_post_cuped_abs_lift profit_abs
       analytical_profit_post_holdout_cuped_abs_diff_ci_low profit_ci_low_abs, --analytical_profit_post_cuped_abs_ci_low profit_ci_low_abs
       analytical_profit_post_holdout_cuped_abs_diff_ci_high profit_ci_high_abs, --analytical_profit_post_cuped_abs_ci_high profit_ci_high_abs

      orders_post_holdout_cuped_abs_diff orders_abs, --orders_post_cuped_abs_lift orders_abs,
      orders_post_holdout_cuped_abs_diff_ci_low orders_ci_low_abs, --orders_post_cuped_abs_ci_low orders_ci_low_abs,
      orders_post_holdout_cuped_abs_diff_ci_high orders_ci_high_abs, --orders_post_cuped_abs_ci_high orders_ci_high_abs

      orders_post_holdout_cuped_p_value,
      analytical_profit_post_holdout_cuped_p_value,
      delivery_type,

      orders_post_holdout_cuped_mean_holdout,
      orders_post_holdout_cuped_mean_non_holdout,

      analytical_profit_post_holdout_cuped_mean_holdout,
      analytical_profit_post_holdout_cuped_mean_non_holdout


FROM `logistics-data-storage-staging.long_term_pricing.profitable_performance`
)

SELECT tt.*,
            p.brandname entity_level_brand_name,
            p.region
FROM test tt
LEFT JOIN (
      select DISTINCT
            p.entity_id,
            c.country_name,
            c.region,
            (CASE 
                WHEN p.brand_name = &quot;Foodpanda&quot; THEN &quot;FP APAC&quot;
                WHEN p.brand_name = &quot;Foodora&quot; OR p.brand_name = &quot;Yemeksepeti&quot; THEN &quot;Foodora&quot;
                WHEN p.brand_name = &quot;Foodora&quot; OR p.brand_name = &quot;Foodpanda&quot; OR p.brand_name = &quot;Yemeksepeti&quot; THEN &quot;Pandora&quot;
                WHEN p.brand_name = &quot;eFood&quot; OR p.brand_name = &quot;Foody&quot; THEN &quot;GR/CY&quot;
                WHEN p.brand_name = &quot;PedidosYa&quot; THEN &quot;PEYA&quot;
                WHEN p.brand_name = &quot;Baemin&quot; THEN &quot;Woowa&quot;
                ELSE p.brand_name
                END) brandname
    from `fulfillment-dwh-production.cl.countries` c
    left join unnest(c.platforms) p
    where brand_name is not null
) p on p.entity_id = tt.entity_id</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1o1irm80igvwi415ixww81kwdnaf' name='Custom SQL Query' type='text'>WITH test AS(SELECT brand_name,
