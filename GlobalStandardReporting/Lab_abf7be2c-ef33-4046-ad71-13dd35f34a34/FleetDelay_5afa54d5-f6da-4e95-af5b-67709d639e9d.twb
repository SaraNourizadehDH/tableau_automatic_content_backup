        <_.fcp.ObjectModelEncapsulateLegacy.false...relation join='inner' type='join'>
          <clause type='join'>
            <expression op='='>
              <expression op='[Custom SQL Query].[entity_id]' />
              <expression op='[_tableau_entity_user_entitlements_entity_id].[entity_id]' />
            </expression>
          </clause>
          <relation connection='bigquery.0b38rx70yamqrs1d95sle0q9mzox' name='Custom SQL Query' type='text'><![CDATA[SELECT
  region,
  entity_id,
  date_trunc(created_date,month) month,
  sum(mean_delay) mean_delay,
  count(*) orders,
  count(case when mean_delay << 00 then platform_order_code end) share_below_0,
  count(case when mean_delay >>= 00 and mean_delay << 05 then platform_order_code end) share_00,
  count(case when mean_delay >>= 05 and mean_delay << 10 then platform_order_code end) share_05_10,
  count(case when mean_delay >>= 10 and mean_delay << 15 then platform_order_code end) share_10_15,
  count(case when mean_delay >>= 15 and mean_delay << 20 then platform_order_code end) share_15_20,
  count(case when mean_delay >>= 20 and mean_delay << 25 then platform_order_code end) share_20_25,
  count(case when mean_delay >>= 25 and mean_delay << 30 then platform_order_code end) share_25_30,
  count(case when mean_delay >>= 30 and mean_delay << 45 then platform_order_code end) share_30_45,
  count(case when mean_delay >>= 45 and mean_delay << 60 then platform_order_code end) share_45_60,
  count(case when mean_delay >>= 60 then platform_order_code end) share_above_60,
FROM `fulfillment-dwh-production.cl.dps_sessions_mapped_to_orders_v2`
WHERE created_date >>= date_add(date_trunc(current_date(), month), interval - 13 month)
    and is_own_delivery
    and is_sent
    and mean_delay is not null
group by 1,2,3
ORDER BY 1,2,3]]></relation>
          <relation connection='bigquery.0b38rx70yamqrs1d95sle0q9mzox' name='_tableau_entity_user_entitlements_entity_id' table='[fulfillment-dwh-production.cl].[_tableau_entity_user_entitlements_entity_id]' type='table' />
