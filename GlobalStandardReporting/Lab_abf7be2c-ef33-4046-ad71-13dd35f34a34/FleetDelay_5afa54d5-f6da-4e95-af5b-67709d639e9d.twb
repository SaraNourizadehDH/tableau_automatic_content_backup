      <aliases enabled='yes' />
      <column caption='Reference' datatype='integer' name='[Calculation_1341509780942266369]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Percentage&apos; THEN 80 ELSE NULL END' />
      </column>
      <column caption='Share 45-60' datatype='real' name='[Calculation_1341509780942528514]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Percentage&apos; THEN&#13;&#10;     SUM([share_45_60])/SUM([orders])*100&#13;&#10;ELSE SUM([share_45_60])&#13;&#10;END' />
      </column>
