          <datasource-dependencies datasource='federated.1tmlt1v0j0l8s412xlhok1rzptir (copy)'>
            <column caption='Alternative' datatype='string' default-format='p0%' name='[Alternative KPI (copy)_1561060249312657419]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF&#13;&#10;    [objective] = &apos;Max Profit Total Growth&apos; THEN &apos;Total Revenue Growth&apos;&#13;&#10;ELSEIF&#13;&#10;    [objective] = &apos;Max Orders Total Growth&apos; THEN &apos;Total Revenue Growth&apos;&#13;&#10;ELSEIF&#13;&#10;    [objective] = &apos;Max Revenue Total Growth&apos; THEN &apos;Total Profit Growth&apos;&#13;&#10;ELSE &#13;&#10;    &apos;Total Revenue Growth&apos;&#13;&#10;END' />
            </column>
            <column aggregation='Avg' caption='Main KPI growth' datatype='real' default-format='p0.0%' name='[Calculation_1561060249308876807]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF&#13;&#10;    [objective] = &apos;Max Profit Total Growth&apos; THEN [profit_total_growth]&#13;&#10;ELSEIF&#13;&#10;    [objective] = &apos;Max Orders Total Growth&apos; THEN [orders_total_growth]&#13;&#10;ELSEIF&#13;&#10;    [objective] = &apos;Max Revenue Total Growth&apos; THEN [revenue_total_growth]&#13;&#10;ELSE &#13;&#10;    [profit_total_growth]&#13;&#10;END' />
            </column>
            <column caption='Quadrant' datatype='string' name='[Calculation_1561060249309990921]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='REPLACE(&#13;&#10;REPLACE(&#13;&#10;    IF [Calculation_1561060249308876807] &gt;= 0 AND [Main KPI (copy)_1561060249309626376] &gt;= 0 THEN [Main KPI (copy)_1561060249313316879] + &apos; and &apos; + [Main Constraint (copy)_1561060249313140748] + &apos; up&apos;&#13;&#10;    ELSEIF [Calculation_1561060249308876807] &gt;= 0 AND [Main KPI (copy)_1561060249309626376] &lt; 0 THEN [Main KPI (copy)_1561060249313316879] + &apos; up, &apos; + [Main Constraint (copy)_1561060249313140748] + &apos; down&apos;&#13;&#10;    ELSEIF [Calculation_1561060249308876807] &lt; 0 AND [Main KPI (copy)_1561060249309626376] &gt;= 0 THEN [Main KPI (copy)_1561060249313316879] + &apos; down, &apos; +[Main Constraint (copy)_1561060249313140748] + &apos; up&apos;&#13;&#10;    ELSEIF [Main KPI (copy)_1561060249311117322] &gt;= 0 THEN &apos;Only&apos; + [Alternative KPI (copy)_1561060249312657419] + &apos; up&apos;&#13;&#10;    ELSEIF [Main KPI (copy)_1561060249311117322] &lt; 0 THEN &apos;Orders, Profit and Revenue down&apos;&#13;&#10;    ELSE &apos;??&apos;&#13;&#10;    END,&apos; Growth&apos;,&apos;&apos;)&#13;&#10;,&apos;Total &apos;,&apos;&apos;)' />
            </column>
            <column caption='Location' datatype='string' name='[Calculation_1561060249324322832]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='UPPER([country_code]) + &apos;-&apos; + [city_name]' />
            </column>
            <column caption='Setup type size' datatype='integer' name='[Calculation_1770196165499998212]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_winning_fee] THEN 10 ELSE 1 END' />
            </column>
            <column caption='Setup type' datatype='string' name='[Calculation_1770196165523980300]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF abs([avg_fee_converted_growth])&gt;0.05 OR abs([avg_fee_listed_growth])&gt;0.1 THEN &apos;Too aggressive&apos; ELSEIF [is_winning_fee] THEN &apos;Winning&apos; ELSE &apos;Normal&apos; END' />
