    <worksheet name='Metric Names'>
      <table>
        <view>
          <datasources>
            <datasource caption='simple_flow_contact_customer_experiment+ (Multiple Connections)' name='federated.0hr6f8u087m4kg1bqrbfm17yze5s' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Date Level' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0hr6f8u087m4kg1bqrbfm17yze5s'>
            <column caption='  GMV Call Customer Dismissed Completed Orders Orders (∆ Divergence)' datatype='real' name='[  GMV Saved Orders (∆ Divergence) (copy)_7010697278630490138]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    SUM({ INCLUDE [date_type]:&#10; &#10;    SUM(IF [experiment_group] = &apos;Variant A&apos; AND [rollout_phase] = &apos;POST&apos; THEN [call_customer_dismissed_completed_orders_gmv] END)&#10;    })&#10;&#10;    /&#10;&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;POST&apos; THEN [call_customer_dismissed_completed_orders_gmv] END)&#10;    })&#10;&#10;    - 1&#10;)&#10;-&#10;(&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Variant A&apos; AND [rollout_phase] = &apos;PRE&apos; THEN [call_customer_dismissed_completed_orders_gmv] END)&#10;    })&#10;    /&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;PRE&apos; THEN [call_customer_accepted_orders_gmv] END)&#10;    })&#10;    - 1&#10;)' />
            </column>
            <column caption='%  Simple Flow Orders (∆ Divergence)' datatype='real' name='[%  Call Customer Accept Failed Orders (∆ Divergence) (copy)_4565524149151113233]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Variant A&apos; AND [rollout_phase] = &apos;POST&apos; THEN [simple_flow_orders] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Variant A&apos; AND [rollout_phase] = &apos;POST&apos; THEN [reconcilliation_funnel_orders] END)&#10;    })&#10;&#10;    /&#10;&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;POST&apos; THEN [simple_flow_orders] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;POST&apos; THEN [reconcilliation_funnel_orders] END)&#10;    })&#10;&#10;    - 1&#10;)&#10;-&#10;(&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Variant A&apos; AND [rollout_phase] = &apos;PRE&apos; THEN [simple_flow_orders] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Variant A&apos; AND [rollout_phase] = &apos;PRE&apos; THEN [reconcilliation_funnel_orders] END)&#10;    })&#10;    /&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;PRE&apos; THEN [simple_flow_orders] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;PRE&apos; THEN [reconcilliation_funnel_orders] END)&#10;    })&#10;    - 1&#10;)' />
