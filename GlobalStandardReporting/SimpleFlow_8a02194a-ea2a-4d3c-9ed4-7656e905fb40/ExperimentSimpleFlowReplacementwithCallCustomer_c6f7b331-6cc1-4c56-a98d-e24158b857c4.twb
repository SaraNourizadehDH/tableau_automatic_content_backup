    <worksheet name='Funnel (%)'>
      <table>
        <view>
          <datasources>
            <datasource caption='simple_flow_contact_customer_experiment+ (Multiple Connections)' name='federated.0hr6f8u087m4kg1bqrbfm17yze5s' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Date Level' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
            <column alias='Tabular View' caption='Select % or # Orders or Tabular View' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;tab&quot;'>
              <calculation class='tableau' formula='&quot;tab&quot;' />
              <aliases>
                <alias key='&quot;\#&quot;' value='# Orders' />
                <alias key='&quot;\%&quot;' value='% Orders' />
                <alias key='&quot;tab&quot;' value='Tabular View' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0hr6f8u087m4kg1bqrbfm17yze5s'>
            <column caption='   % Call Customer Accepted Orders' datatype='real' name='[   % Call Customer Accept Failed Orders (copy)_4565524149346148418]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([call_customer_accepted_orders]) / SUM([reconcilliation_funnel_orders])' />
            </column>
            <column caption='   % Call Customer Declined Orders' datatype='real' name='[   % Call Customer Accepted Orders (copy)_4565524149346275395]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([call_customer_declined_orders]) / SUM([reconcilliation_funnel_orders])' />
            </column>
            <column caption='   % Simple Flow Orders' datatype='real' name='[   % Call Customer Declined Orders (copy) (copy) (copy)_4565524149346566214]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([simple_flow_orders]) / SUM([reconcilliation_funnel_orders])' />
            </column>
            <column caption='   % Call Customer No Action Orders' datatype='real' name='[   % Call Customer Declined Orders (copy) (copy)_4565524149346558021]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([call_customer_no_action_orders]) / SUM([reconcilliation_funnel_orders])' />
            </column>
            <column caption='   % Call Customer Dismissed Orders' datatype='real' name='[   % Call Customer Declined Orders (copy)_4565524149346545732]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([call_customer_dismissed_orders]) / SUM([reconcilliation_funnel_orders])' />
            </column>
            <column caption='   % Not Reconciled Failed Agent Other Orders' datatype='real' name='[   % Simple Flow Orders (copy)_4565524149347012679]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([not_reconciled_failed_agent_other_orders]) / SUM([reconcilliation_funnel_orders])' />
            </column>
            <column caption='   % Partial Acceptance Orders' datatype='real' name='[   % Simple Flow Orders (copy)_4565524149396955212]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([partial_acceptance_orders]) / SUM([reconcilliation_funnel_orders])' />
            </column>
            <column caption='_granularity_filter' datatype='boolean' name='[Calculation_4565524148946161665]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;&#10;WHEN &quot;Daily&quot; THEN [date_type] = &quot;Daily&quot;&#10;WHEN &quot;Weekly&quot; THEN [date_type] = &quot;Weekly&quot;&#10;&#10;END' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_4565524148946345986]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [date_type]&#10;WHEN &quot;Daily&quot; THEN STR(DATE([created_date_local]))&#10;WHEN &quot;Weekly&quot; THEN STR(YEAR([created_date_local]))+&quot;-W&quot;+STR([weeks])&#10;END' />
            </column>
            <column caption='   % Call Customer Accept Failed Orders' datatype='real' name='[Calculation_4565524149345865793]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([call_customer_accept_failed_orders]) / SUM([reconcilliation_funnel_orders])' />
            </column>
            <column caption='_view_item_unavailable' datatype='string' name='[Calculation_4565524149402353741]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 3]' />
            </column>
            <column caption='Call Customer Accept Failed Orders' datatype='integer' name='[call_customer_accept_failed_orders]' role='measure' type='quantitative' />
            <column caption='Call Customer Accepted Orders' datatype='integer' name='[call_customer_accepted_orders]' role='measure' type='quantitative' />
            <column caption='Call Customer Declined Orders' datatype='integer' name='[call_customer_declined_orders]' role='measure' type='quantitative' />
            <column caption='Call Customer Dismissed Orders' datatype='integer' name='[call_customer_dismissed_orders]' role='measure' type='quantitative' />
            <column caption='Call Customer No Action Orders' datatype='integer' name='[call_customer_no_action_orders]' role='measure' type='quantitative' />
