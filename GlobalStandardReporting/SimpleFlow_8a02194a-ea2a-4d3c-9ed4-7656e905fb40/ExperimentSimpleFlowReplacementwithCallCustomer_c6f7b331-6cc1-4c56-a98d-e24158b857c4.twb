              <groupfilter function='member' level='[none:Calculation_7010697278600056849:nk]' member='&quot;Call Customer Dismissed Completed Orders GMV&quot;' />
              <groupfilter function='member' level='[none:Calculation_7010697278600056849:nk]' member='&quot;Call Customer Orders&quot;' />
