          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0hr6f8u087m4kg1bqrbfm17yze5s'>
            <column caption='   % Call Customer Accepted Orders' datatype='real' name='[   % Call Customer Accept Failed Orders (copy)_4565524149346148418]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([call_customer_accepted_orders]) / SUM([reconcilliation_funnel_orders])' />
            </column>
            <column caption='   % Call Customer Declined Orders' datatype='real' name='[   % Call Customer Accepted Orders (copy)_4565524149346275395]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([call_customer_declined_orders]) / SUM([reconcilliation_funnel_orders])' />
            </column>
            <column caption='   % Simple Flow Orders' datatype='real' name='[   % Call Customer Declined Orders (copy) (copy) (copy)_4565524149346566214]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([simple_flow_orders]) / SUM([reconcilliation_funnel_orders])' />
            </column>
            <column caption='   % Call Customer No Action Orders' datatype='real' name='[   % Call Customer Declined Orders (copy) (copy)_4565524149346558021]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([call_customer_no_action_orders]) / SUM([reconcilliation_funnel_orders])' />
            </column>
            <column caption='   % Call Customer Dismissed Orders' datatype='real' name='[   % Call Customer Declined Orders (copy)_4565524149346545732]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([call_customer_dismissed_orders]) / SUM([reconcilliation_funnel_orders])' />
            </column>
            <column caption='   % Not Reconciled Failed Agent Other Orders' datatype='real' name='[   % Simple Flow Orders (copy)_4565524149347012679]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([not_reconciled_failed_agent_other_orders]) / SUM([reconcilliation_funnel_orders])' />
            </column>
            <column caption='%  Call Customer Orders' datatype='real' default-format='p0.000%' name='[%  Call Customer Accepted Orders  (copy)_7010697278789357608]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([call_customer_orders])&#10;    /&#10;    SUM([reconcilliation_funnel_orders])' />
            </column>
            <column caption='Metrics (∆)' datatype='real' default-format='p0.00%' name='[%  Item Unavailable Fail Rate Orders (∆) (copy)_4565524149420912732]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(   // varient A&#10;    (SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [Metrics (copy)_4565524149414187091] END)&#10;      / [Delta Metrics Nominator (copy)_4565524149414867029]&#10;     ) &#10;    &#10;/&#10;  // Baseline&#10;    (SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [Metrics (copy)_4565524149414187091] END)&#10;    /[∆  Metrics Denominator Variant (copy)_4565524149416140887]&#10;    )&#10;)&#10;- 1' />
            </column>
            <column caption='   % Call Customer Dismissed Completed Orders' datatype='real' default-format='p0.000%' name='[% Call Customer Dismissed Orders  (copy)_7010697278492770313]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([call_customer_dismissed_completed_orders])&#10;    /&#10;    SUM([reconcilliation_funnel_orders])' />
            </column>
            <column caption='% Vendor Fail Rate' datatype='real' default-format='p0.00%' name='[% Item Unavailable Fail Rate (copy)_4565524149295542293]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_failed_orders])/SUM([orders])' />
            </column>
            <column caption='% Contact Rate' datatype='real' default-format='p0.000%' name='[% Vendor Contact Rate (copy)_7010697278586339343]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_7010697278586179598])/SUM([orders])' />
            </column>
            <column caption='% Vendor Contact Rate' datatype='real' default-format='p0.000%' name='[% Vendor Fail Rate (copy)_4565524149295779862]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_contacts])/SUM([orders])' />
            </column>
            <column caption='_granularity_filter' datatype='boolean' name='[Calculation_4565524148946161665]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;&#10;WHEN &quot;Daily&quot; THEN [date_type] = &quot;Daily&quot;&#10;WHEN &quot;Weekly&quot; THEN [date_type] = &quot;Weekly&quot;&#10;&#10;END' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_4565524148946345986]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [date_type]&#10;WHEN &quot;Daily&quot; THEN STR(DATE([created_date_local]))&#10;WHEN &quot;Weekly&quot; THEN STR(YEAR([created_date_local]))+&quot;-W&quot;+STR([weeks])&#10;END' />
            </column>
            <column caption='% Item Unavailable Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_4565524149076819972]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([item_unavailable_vendor_failed_orders])/SUM([orders])' />
            </column>
            <column caption='   % Call Customer Accept Failed Orders' datatype='real' name='[Calculation_4565524149345865793]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([call_customer_accept_failed_orders]) / SUM([reconcilliation_funnel_orders])' />
            </column>
            <column caption='Metrics' datatype='real' name='[Calculation_4565524149410283601]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;// based on total orders&#10;WHEN &quot;Item Unavailable Fail Rate&quot; THEN [Calculation_4565524149076819972]&#10;WHEN &quot;Vendor Fail Rate&quot; THEN [% Item Unavailable Fail Rate (copy)_4565524149295542293]&#10;WHEN &quot;Vendor Contact Rate&quot; THEN [% Vendor Fail Rate (copy)_4565524149295779862]&#10;&#10;// based on the item unavailable funnel&#10;WHEN &quot;Simple Flow&quot; THEN [   % Call Customer Declined Orders (copy) (copy) (copy)_4565524149346566214]&#10;WHEN &quot;Call Customer Accept Failed Orders&quot; THEN [Calculation_4565524149345865793]&#10;WHEN &quot;Call Customer Accepted Orders&quot; THEN [   % Call Customer Accept Failed Orders (copy)_4565524149346148418]&#10;WHEN &quot;Call Customer Declined Orders&quot; THEN [   % Call Customer Accepted Orders (copy)_4565524149346275395]&#10;WHEN &quot;Call Customer Dismissed Orders&quot; THEN [   % Call Customer Declined Orders (copy)_4565524149346545732]&#10;WHEN &quot;Call Customer No Action Orders&quot; THEN [   % Call Customer Declined Orders (copy) (copy)_4565524149346558021]&#10;WHEN &quot;Not Reconciled Failed Agent Other Orders&quot; THEN [   % Simple Flow Orders (copy)_4565524149347012679]&#10;&#10;// save rate&#10;WHEN &quot;Save Rate&quot; THEN [Calculation_7010697278100475906]&#10;WHEN &quot;Call Customer Dismissed Completed Orders&quot; THEN [% Call Customer Dismissed Orders  (copy)_7010697278492770313]&#10;WHEN &quot;Contact Rate&quot; THEN [% Vendor Contact Rate (copy)_7010697278586339343]&#10;WHEN &quot;Call Customer&quot; THEN [%  Call Customer Accepted Orders  (copy)_7010697278789357608]&#10;END' />
            </column>
            <column caption='% Save Rate Call Customer' datatype='real' name='[Calculation_7010697278100475906]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([call_customer_accepted_orders]) / SUM([call_customer_orders])' />
            </column>
            <column caption='Total Contacts' datatype='integer' name='[Calculation_7010697278586179598]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[vendor_contacts]+[rider_contacts]+[customer_contacts]' />
            </column>
            <column caption='_view_filter_line_bar_chart' datatype='string' name='[Calculation_7010697278600056849]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 4]' />
            </column>
            <column caption='# Metrics Divergence' datatype='real' name='[Calculation_7010697278615355415]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    (SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [Metrics (copy)_7010697278484426760] END)) &#10;    /&#10;    (SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [Metrics (copy)_7010697278484426760] END))&#10;)&#10;- 1' />
            </column>
            <column caption='Saved Orders Call Customer' datatype='integer' name='[Calculation_7010697278841020470]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[call_customer_accepted_orders]' />
            </column>
            <column caption='∆  Metrics Denominator - Variant A' datatype='integer' name='[Delta Metrics Nominator (copy)_4565524149414867029]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;// based on total orders&#10;WHEN &quot;Item Unavailable Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;Vendor Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;Vendor Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;&#10;// based on the item unavailable funnel&#10;WHEN &quot;Simple Flow&quot; THEN SUM([Funnel Total (copy) (copy)_4565524149417394266])&#10;WHEN &quot;Call Customer&quot; THEN SUM([Funnel Total (copy) (copy)_4565524149417394266])&#10;WHEN &quot;Call Customer Accept Failed Orders&quot; THEN SUM([Funnel Total (copy) (copy)_4565524149417394266])&#10;WHEN &quot;Call Customer Accepted Orders&quot; THEN SUM([Funnel Total (copy) (copy)_4565524149417394266])&#10;WHEN &quot;Call Customer Declined Orders&quot; THEN SUM([Funnel Total (copy) (copy)_4565524149417394266])&#10;WHEN &quot;Call Customer Dismissed Orders&quot; THEN SUM([Funnel Total (copy) (copy)_4565524149417394266])&#10;WHEN &quot;Call Customer Dismissed Completed Orders&quot; THEN SUM([Funnel Total (copy) (copy)_4565524149417394266])&#10;WHEN &quot;Call Customer No Action Orders&quot; THEN SUM([Funnel Total (copy) (copy)_4565524149417394266])&#10;WHEN &quot;Not Reconciled Failed Agent Other Orders&quot; THEN SUM([Funnel Total (copy) (copy)_4565524149417394266])&#10;&#10;// save rate&#10;WHEN &quot;Save Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [call_customer_orders] END)&#10;WHEN &quot;Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;END' />
            </column>
            <column caption='Reconcilliation Funnel - Variant A' datatype='integer' name='[Funnel Total (copy) (copy)_4565524149417394266]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [experiment_group] = &apos;Variant A&apos; THEN [reconcilliation_funnel_orders] END' />
            </column>
            <column caption='Reconcilliation Funnel - Baseline' datatype='integer' name='[Funnel Total (copy)_4565524149417381977]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [experiment_group] = &apos;Baseline&apos; THEN [reconcilliation_funnel_orders] END' />
            </column>
            <column caption='∆  Metrics Numerator' datatype='integer' name='[Metrics (copy)_4565524149414187091]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;&#10;// based on total orders&#10;WHEN &quot;Item Unavailable Fail Rate&quot; THEN [item_unavailable_vendor_failed_orders]&#10;WHEN &quot;Vendor Fail Rate&quot; THEN [vendor_failed_orders]&#10;WHEN &quot;Vendor Contact Rate&quot; THEN [vendor_contacts]&#10;&#10;// based on the item unavailable funnel&#10;WHEN &quot;Simple Flow&quot; THEN [simple_flow_orders]&#10;WHEN &quot;Call Customer&quot; THEN [call_customer_orders]&#10;WHEN &quot;Call Customer Accept Failed Orders&quot; THEN [call_customer_accept_failed_orders]&#10;WHEN &quot;Call Customer Accepted Orders&quot; THEN [call_customer_accepted_orders]&#10;WHEN &quot;Call Customer Declined Orders&quot; THEN [call_customer_declined_orders]&#10;WHEN &quot;Call Customer Dismissed Orders&quot; THEN [call_customer_dismissed_orders]&#10;WHEN &quot;Call Customer Dismissed Completed Orders&quot; THEN [call_customer_dismissed_completed_orders]&#10;WHEN &quot;Call Customer No Action Orders&quot; THEN [call_customer_no_action_orders]&#10;WHEN &quot;Not Reconciled Failed Agent Other Orders&quot; THEN [not_reconciled_failed_agent_other_orders]&#10;&#10;// save rate&#10;WHEN &quot;Save Rate&quot; THEN [call_customer_accepted_orders]&#10;WHEN &quot;Contact Rate&quot; THEN [Calculation_7010697278586179598]&#10;&#10;END' />
            </column>
            <column caption='# Metrics' datatype='real' name='[Metrics (copy)_7010697278484426760]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;&#10;WHEN &quot;Call Customer Orders&quot; THEN [call_customer_orders]&#10;&#10;WHEN &quot;Saved Orders GMV&quot; THEN [call_customer_accepted_orders_gmv]&#10;WHEN &quot;Saved Orders&quot; THEN [Calculation_7010697278841020470]&#10;&#10;WHEN &quot;Call Customer Dismissed Completed Orders GMV&quot; THEN [call_customer_dismissed_completed_orders_gmv]&#10;&#10;WHEN &quot;Simple Flow Orders&quot; THEN [simple_flow_orders]&#10;&#10;WHEN &quot;Orders&quot; THEN [orders]&#10;&#10;END' />
            </column>
