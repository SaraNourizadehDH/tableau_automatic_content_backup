      <layout-options>
        <title>
          <formatted-text>
            <run>Per Management Entity Group and Stakeholder</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='contact_reason_match_hc_vs_contact (rl)' name='federated.0jkl9xh0rd15861a4tgd119ueuio' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0jkl9xh0rd15861a4tgd119ueuio'>
            <column caption='% Contacts with CR unchanged' datatype='real' default-format='p0.0%' name='[Calculation_1906148560284577792]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([match_count]) / SUM([contact_count])' />
            </column>
            <column caption='Selected Date Granularity' datatype='string' name='[Calculation_1906148560303247362]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;WHEN  &apos;Week&apos; THEN [created_week_local_time]&#13;&#10;WHEN &apos;Month&apos; THEN [created_month_localtime]&#13;&#10;END' />
            </column>
            <column caption='Relative Created Week Sunday' datatype='date' name='[Created Week Sunday (copy)_1070167898091540480]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[created_week_sunday_localtime]' />
            </column>
            <column caption='Channel' datatype='string' name='[channel]' role='dimension' type='nominal' />
            <column caption='Contact Center' datatype='string' name='[contact_center]' role='dimension' type='nominal' />
