      <aliases enabled='yes' />
      <column caption='% Contacts with CR unchanged (fixed)' datatype='real' default-format='p0.0%' name='[% Contacts with CR unchanged (copy)_310748430642769921]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [HC CR Code (copy)_1362057467954708481]: SUM([match_count]) / SUM([contact_count])}' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_1070167898093383681]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='% Contacts with CR unchanged' datatype='real' default-format='p0.0%' name='[Calculation_1906148560284577792]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([match_count]) / SUM([contact_count])' />
      </column>
      <column caption='Selected Date Granularity' datatype='string' name='[Calculation_1906148560303247362]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;WHEN  &apos;Week&apos; THEN [created_week_local_time]&#13;&#10;WHEN &apos;Month&apos; THEN [created_month_localtime]&#13;&#10;END' />
      </column>
      <column caption='Contact Count(changed)' datatype='integer' name='[Contact Cnt (copy)_310748430647750658]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF NOT [HC CR Code (copy)_1362057467954323456] THEN [contact_count] END)' />
      </column>
      <column caption='Contact Count (fixed)' datatype='real' default-format='p0.0%' name='[Contact Cnt (fixed) (copy)_100486566694457344]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [HC CR Code (copy)_1362057467954708481]: SUM([contact_count])}&#13;&#10;/ &#13;&#10;{ FIXED : SUM([contact_count])}' />
      </column>
      <column caption='Relative Created Week Sunday' datatype='date' name='[Created Week Sunday (copy)_1070167898091540480]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[created_week_sunday_localtime]' />
      </column>
      <column caption='Is Help Center &amp; Contact CR matched' datatype='boolean' name='[HC CR Code (copy)_1362057467954323456]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[helpcenter_cr_code] = [contact_cr_code]' />
      </column>
      <column caption='MEG &amp; HC CR Code' datatype='string' name='[HC CR Code (copy)_1362057467954708481]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[management_entity_group] + &apos;-&apos;+[helpcenter_cr_code]+&apos; (&apos;+[stakeholder]+&apos;)&apos;' />
      </column>
