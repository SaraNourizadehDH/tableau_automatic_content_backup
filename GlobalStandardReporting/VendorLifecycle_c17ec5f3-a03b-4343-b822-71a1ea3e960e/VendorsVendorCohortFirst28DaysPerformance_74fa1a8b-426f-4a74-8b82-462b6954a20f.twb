      </column>
      <column caption='% ITEM UNAVAILABLE Fail Rate' datatype='real' name='[% Fail Rate (copy) (copy) (copy)_1593992861386702851]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fail_orders_item_unavailable_ct]) / SUM([orders_ct])' />
      </column>
      <column caption='% CLOSED Fail Rate' datatype='real' name='[% Fail Rate (copy) (copy)_1593992861386694658]' role='measure' type='quantitative'>
