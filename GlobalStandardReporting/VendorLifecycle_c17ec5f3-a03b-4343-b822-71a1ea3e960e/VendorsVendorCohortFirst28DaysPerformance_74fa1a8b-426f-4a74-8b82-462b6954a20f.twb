  <worksheets>
    <worksheet name='(OLD) Vendor Grade Table'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='11'>*) The table shows the vendor grade segment shares for vendors at week </run>
            <run bold='true' fontsize='11'><![CDATA[<[federated.048pzb81jbcusv181gc950brvrjv].[none:date_diff:ok]>]]></run>
            <run fontsize='11'> from their respective cohort date.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='vendor_gsr_cohort_dashboard (rl)' name='federated.048pzb81jbcusv181gc950brvrjv' />
          </datasources>
          <datasource-dependencies datasource='federated.048pzb81jbcusv181gc950brvrjv'>
            <column caption='% Grade NA' datatype='real' name='[% Grade A (copy) (copy) (copy) (copy)_1593992861674668062]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([grade_NA_cohort_size])/SUM([Calculation_1593992861674143769])' />
            </column>
            <column caption='% Grade D' datatype='real' name='[% Grade A (copy) (copy) (copy)_1593992861674659869]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([grade_D_cohort_size])/SUM([Calculation_1593992861674143769])' />
            </column>
            <column caption='% Grade C' datatype='real' name='[% Grade A (copy) (copy)_1593992861674651676]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([grade_C_cohort_size])/SUM([Calculation_1593992861674143769])' />
            </column>
            <column caption='% Grade B' datatype='real' name='[% Grade A (copy)_1593992861674639387]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([grade_B_cohort_size])/SUM([Calculation_1593992861674143769])' />
            </column>
            <column aggregation='Attribute' caption='Fixed Cohort Size' datatype='integer' name='[Calculation_1593992861405941776]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ EXCLUDE [date_diff]: SUM({ INCLUDE [first_order_created_week_local]&#10;                                       , [region]&#10;                                       , [brand_name]&#10;                                       , [country_name]&#10;                                       , [first_delivery_type]&#10;                                       , [first_vertical_type]&#10;                                       , [first_client_name]&#10;                                       , [first_pos_integration_type]&#10;                                       , [first_is_ngt]&#10;                                       , [has_tutorial]&#10;                                       , [has_test_order]&#10;                                       , [has_test_order] : MAX([cohort_size])})}' />
            </column>
            <column caption='Cohort Size' datatype='integer' name='[Calculation_1593992861407969299]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='[Calculation_1593992861405941776]' />
            </column>
            <column caption='All grades cohort size' datatype='integer' name='[Calculation_1593992861674143769]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[grade_A_cohort_size] + [grade_B_cohort_size] + [grade_C_cohort_size] + [grade_D_cohort_size] + [grade_NA_cohort_size]' />
            </column>
            <column caption='% Grade A' datatype='real' name='[Calculation_1593992861674475546]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([grade_A_cohort_size])/SUM([Calculation_1593992861674143769])' />
            </column>
            <column-instance column='[Calculation_1593992861407969299]' derivation='Attribute' name='[attr:Calculation_1593992861407969299:ok]' pivot='key' type='ordinal' />
            <column caption='Brand Name' datatype='string' name='[brand_name]' role='dimension' type='nominal' />
            <column caption='Cohort Size_' datatype='integer' name='[cohort_size]' role='measure' type='quantitative' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Report Week' datatype='integer' name='[date_diff]' role='measure' type='ordinal' />
            <column caption='First Client Name' datatype='string' name='[first_client_name]' role='dimension' type='nominal' />
            <column caption='First Delivery Type' datatype='string' name='[first_delivery_type]' role='dimension' type='nominal' />
            <column caption='First Is Ngt' datatype='string' name='[first_is_ngt]' role='dimension' type='nominal' />
            <column caption='Cohort' datatype='date' default-format='*yyyy-ww' name='[first_order_created_week_local]' role='dimension' type='ordinal' />
            <column caption='First Pos Integration Type' datatype='string' name='[first_pos_integration_type]' role='dimension' type='nominal' />
            <column caption='First Vertical Type' datatype='string' name='[first_vertical_type]' role='dimension' type='nominal' />
            <column caption='grade A cohort size' datatype='integer' name='[grade_A_cohort_size]' role='measure' type='quantitative' />
            <column caption='grade B cohort size' datatype='integer' name='[grade_B_cohort_size]' role='measure' type='quantitative' />
