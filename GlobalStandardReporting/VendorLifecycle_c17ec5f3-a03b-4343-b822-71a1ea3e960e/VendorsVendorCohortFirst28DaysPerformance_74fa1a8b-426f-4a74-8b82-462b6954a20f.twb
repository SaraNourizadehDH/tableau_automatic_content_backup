      <layout-options>
        <title>
          <formatted-text>
            <run>Vendor Cohort</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='vendor_gsr_cohort_dashboard (rl)' name='federated.048pzb81jbcusv181gc950brvrjv' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose Metric' datatype='string' datatype-customized='true' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% Vendors with Orders&quot;'>
              <calculation class='tableau' formula='&quot;% Vendors with Orders&quot;' />
            </column>
            <column caption='Choose Dimension' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.048pzb81jbcusv181gc950brvrjv].[week_cohort]' caption='Choose First Cohort' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;1970-01&quot;'>
              <calculation class='tableau' formula='&quot;1970-01&quot;' />
            </column>
            <column caption='Choose Report Week' datatype='integer' name='[Parameter 4]' param-domain-type='range' role='measure' type='quantitative' value='24'>
              <calculation class='tableau' formula='24' />
              <range max='24' min='1' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.048pzb81jbcusv181gc950brvrjv'>
            <column caption='% UNKNOWN Fail Rate' datatype='real' name='[% Fail Rate (copy) (copy) (copy) (copy) (copy) (copy)_1593992861386735622]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_orders_unknown_ct]) / SUM([orders_ct])' />
            </column>
            <column caption='% TOO BUSY Fail Rate' datatype='real' name='[% Fail Rate (copy) (copy) (copy) (copy) (copy)_1593992861386727429]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_orders_too_busy_ct]) / SUM([orders_ct])' />
            </column>
            <column caption='% NO RESPONSE Fail Rate' datatype='real' name='[% Fail Rate (copy) (copy) (copy) (copy)_1593992861386715140]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_orders_no_response_ct]) / SUM([orders_ct])' />
            </column>
            <column caption='% ITEM UNAVAILABLE Fail Rate' datatype='real' name='[% Fail Rate (copy) (copy) (copy)_1593992861386702851]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_orders_item_unavailable_ct]) / SUM([orders_ct])' />
            </column>
            <column caption='% CLOSED Fail Rate' datatype='real' name='[% Fail Rate (copy) (copy)_1593992861386694658]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_orders_closed_ct]) / SUM([orders_ct])' />
            </column>
            <column caption='% Vendor Fail Rate' datatype='real' name='[% Fail Rate (copy)_1593992861386686465]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_orders_vendor_ct]) / SUM([orders_ct])' />
            </column>
            <column caption='% UNREACHABLE Fail Rate' datatype='real' name='[% Fail Rate (copy)_1593992861387689991]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_orders_unreachable_ct]) / SUM([orders_ct])' />
            </column>
            <column caption='% Vendors without Orders' datatype='real' name='[% Vendors with Orders (copy)_378302396641665024]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - (SUM([vendors_with_orders_size])/SUM([cohort_size]))' />
            </column>
            <column caption='% Fail Rate' datatype='real' name='[Calculation_1593992861386223616]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_orders_ct]) / SUM([orders_ct])' />
            </column>
            <column caption='% Unreachable Duration' datatype='real' name='[Calculation_1593992861388275721]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([unreachable_duration])/ SUM([slots_duration])' />
            </column>
            <column caption='% Vendor Late &gt; 10' datatype='real' name='[Calculation_1593992861388599306]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_10_ct]) / SUM([od_pickedup_orders_ct])' />
            </column>
            <column caption='Avg Response Time' datatype='real' name='[Calculation_1593992861401001995]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([total_response_time]) / SUM([accepted_orders]), 1)' />
            </column>
            <column aggregation='Attribute' caption='Fixed Cohort Size' datatype='integer' name='[Calculation_1593992861405941776]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ EXCLUDE [date_diff]: SUM({ INCLUDE [first_order_created_week_local]&#10;                                       , [region]&#10;                                       , [brand_name]&#10;                                       , [country_name]&#10;                                       , [first_delivery_type]&#10;                                       , [first_vertical_type]&#10;                                       , [first_client_name]&#10;                                       , [first_pos_integration_type]&#10;                                       , [first_is_ngt]&#10;                                       , [has_tutorial]&#10;                                       , [has_test_order]&#10;                                       , [has_test_order] : MAX([cohort_size])})}' />
            </column>
            <column caption='Cohort Size' datatype='integer' name='[Calculation_1593992861407969299]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='[Calculation_1593992861405941776]' />
            </column>
            <column caption='% Vendor Retention' datatype='real' name='[Calculation_1593992861408534548]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([cohort_size]) / ATTR([Calculation_1593992861405941776]) = 0 &#10;  THEN NULL&#10;ELSE &#10;  SUM([cohort_size]) / ATTR([Calculation_1593992861405941776])&#10;END' />
            </column>
            <column caption='Metric to Show' datatype='real' name='[Calculation_1593992861410680853]' role='measure' type='quantitative'>
