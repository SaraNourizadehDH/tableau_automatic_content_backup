ELSE 0 END)&#10;WHEN &apos;    % GoWin Vendors&apos; THEN SUM(IF [cte_type] = &apos;order&apos; THEN [vendor_gowin_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;order&apos; THEN [vendors_with_orders_ct] ELSE 0 END)&#10;WHEN &apos;    % Item Unavailable FR&apos; THEN SUM(IF [cte_type] = &apos;order&apos; THEN [fail_orders_item_unavailable_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;order&apos; THEN [orders_ct] ELSE 0 END)&#10;WHEN &apos;    % Unreachable FR&apos; THEN SUM(IF [cte_type] = &apos;order&apos; THEN [fail_orders_unreachable_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;order&apos; THEN [orders_ct] ELSE 0 END)&#10;WHEN &apos;    % No Response FR&apos; THEN SUM(IF [cte_type] = &apos;order&apos; THEN [fail_orders_no_response_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;order&apos; THEN [orders_ct] ELSE 0 END)&#10;WHEN &apos;    % Too Busy FR&apos; THEN SUM(IF [cte_type] = &apos;order&apos; THEN [fail_orders_too_busy_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;order&apos; THEN [orders_ct] ELSE 0 END)&#10;WHEN &apos;    % Closed FR&apos; THEN SUM(IF [cte_type] = &apos;order&apos; THEN [fail_orders_closed_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;order&apos; THEN [orders_ct] ELSE 0 END)&#10;WHEN &apos;% Vendor Grade AAA&apos; THEN SUM(IF [vendor_grade] = &apos;AAA&apos; AND [cte_type] = &apos;order&apos; THEN [vendors_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;order&apos; THEN [vendors_ct] ELSE 0 END)&#10;WHEN &apos;% Vendor Grade AA&apos; THEN SUM(IF [vendor_grade] = &apos;AA&apos; AND [cte_type] = &apos;order&apos; THEN [vendors_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;order&apos; THEN [vendors_ct] ELSE 0 END)&#10;WHEN &apos;% Vendor Grade A&apos; THEN SUM(IF [vendor_grade] = &apos;A&apos; AND [cte_type] = &apos;order&apos; THEN [vendors_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;order&apos; THEN [vendors_ct] ELSE 0 END)&#10;WHEN &apos;% Vendor Grade B&apos; THEN SUM(IF [vendor_grade] = &apos;B&apos; AND [cte_type] = &apos;order&apos; THEN [vendors_ct] ELSE 0 END)/SUM(IF [cte