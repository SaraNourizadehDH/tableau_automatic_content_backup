    <worksheet name='_custTab_time'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Tableau Regular' fontsize='11'>&lt;</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Regular' fontsize='11'>[Parameters].[Choose Date Granularity (copy)]</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Regular' fontsize='11'>&gt; of &lt;</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Regular' fontsize='11'>[Parameters].[Parameter 6]</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Regular' fontsize='11'>&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='vendor_gsr_business_reporting_custom_tabular' name='federated.00ypnok05nyjnl13hhkrj0k9dyjl' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose Metrics to Show' datatype='string' name='[Choose Date Granularity (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;\# Received Orders&quot;'>
              <calculation class='tableau' formula='&quot;# Received Orders&quot;' />
              <aliases>
                <alias key='&quot;\% Busy Failed Rate&quot;' value='..........% Busy' />
                <alias key='&quot;\% Closed Failed Rate&quot;' value='..........% Closed' />
                <alias key='&quot;\% Customer-owned Failed Rate&quot;' value='.....% Customer-owned' />
                <alias key='&quot;\% Item Unavailable Failed Rate&quot;' value='..........% Item Unavailable' />
                <alias key='&quot;\% No Response Failed Rate&quot;' value='..........% No Response' />
                <alias key='&quot;\% Offline Duration&quot;' value='.....% Offline Duration' />
                <alias key='&quot;\% Offline Special Day Duration&quot;' value='.....% Offline Special Day Duration' />
                <alias key='&quot;\% Offline Unreachable Duration&quot;' value='.....% Offline Unreachable Duration' />
                <alias key='&quot;\% Pickup Order Shares&quot;' value='.....% Pickup Order Shares' />
                <alias key='&quot;\% Platform-owned Failed Rate&quot;' value='.....% Platform-owned' />
                <alias key='&quot;\% Preorder Shares&quot;' value='.....% Preorder Shares' />
                <alias key='&quot;\% Transport-owned Failed Rate&quot;' value='.....% Transport-owned' />
                <alias key='&quot;\% Unreachable Failed Rate&quot;' value='..........% Unreachable' />
                <alias key='&quot;\% Vendor-owned Failed Rate&quot;' value='.....% Vendor-owned' />
              </aliases>
            </column>
            <column caption='Choose Dimension B' datatype='string' name='[Choose Dimension A (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;Vendor Maturity&quot;'>
              <calculation class='tableau' formula='&quot;Vendor Maturity&quot;' />
            </column>
            <column caption='Choose Dimension A' datatype='string' name='[Choose Metrics to Show (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
              <calculation class='tableau' formula='&quot;Country&quot;' />
            </column>
            <column caption='Choose Date Granularity' datatype='string' name='[Parameter 1 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
            <column caption='Choose Y-Axis' datatype='string' name='[Parameter 2 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Time Dimension&quot;'>
              <calculation class='tableau' formula='&quot;Time Dimension&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.00ypnok05nyjnl13hhkrj0k9dyjl'>
            <column caption='Avg. At Vendor Time (Seconds)' datatype='real' name='[Calculation_128915565328510976]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([at_vendor_cleaned_time])/[Calculation_5860871990223896576]' />
            </column>
            <column caption='Avg. Dropoff Distance' datatype='real' name='[Calculation_128915565328687105]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum([dropoff_distance])/[Calculation_5860871990223896576]' />
            </column>
            <column caption='Avg. Estimated Prep Time (Seconds)' datatype='real' name='[Calculation_128915565329100802]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([estimated_prep_time])/[Calculation_5860871990223896576]' />
            </column>
            <column caption='Avg. Pickup Distance' datatype='real' name='[Calculation_128915565329334275]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pickup_distance])/[Calculation_5860871990223896576]' />
            </column>
            <column caption='Avg. Rider Acceptance Time (Seconds)' datatype='real' name='[Calculation_128915565329920004]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_accepting_time])/[Calculation_5860871990223896576]' />
            </column>
            <column caption='Avg. Delivery Time (Seconds)' datatype='real' name='[Calculation_128915565330075653]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_delivery_time])/[Calculation_5860871990223896576]' />
            </column>
            <column caption='Avg. Response Time (Seconds)' datatype='real' name='[Calculation_128915565330296838]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_response_time])/[Calculation_5860871990223896576]' />
            </column>
            <column caption='% NGT Order Shares' datatype='real' name='[Calculation_128915565332135944]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([ngt_cnt])/[Calculation_5860871990223896576])*100' />
            </column>
            <column caption='Schedule Duration' datatype='real' name='[Calculation_128915565332332553]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([slot_duration])' />
            </column>
            <column caption='% Offline Unreachable Duration' datatype='real' name='[Calculation_128915565332721674]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([unreachable_duration])/[Calculation_128915565332332553])*100' />
            </column>
            <column caption='% Offline Duration' datatype='real' name='[Calculation_128915565332938763]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([offline_duration])/[Calculation_128915565332332553])*100' />
            </column>
            <column caption='% Offline Special Day Duration' datatype='real' name='[Calculation_128915565336543244]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([special_day])/[Calculation_128915565332332553])*100' />
            </column>
            <column caption='Dimension A' datatype='string' name='[Calculation_128915565338325006]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Choose Metrics to Show (copy)] &#10;WHEN &apos;Region&apos; THEN [region]&#10;WHEN &apos;Brand Name&apos; THEN [brand_name]&#10;WHEN &apos;Country&apos; THEN [country]&#10;WHEN &apos;Vendor Grade&apos; THEN [vendor_grade]&#10;WHEN &apos;Vertical Type&apos; THEN [vertical_type]&#10;WHEN &apos;Client Name&apos; THEN [client_name]&#10;WHEN &apos;Vendor Maturity&apos; THEN [Calculation_31243725931130880]&#10;END' />
            </column>
            <column caption='_chosen metrics' datatype='real' name='[Calculation_128915565340053520]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Choose Date Granularity (copy)]&#10;WHEN &apos;# Cancelled Orders&apos; THEN [Calculation_5860871990224162818]&#10;WHEN &apos;# Completed Orders&apos; THEN [Calculation_5860871990224052225]&#10;WHEN &apos;# Received Orders&apos; THEN [Calculation_5860871990223896576]&#10;WHEN &apos;# Stacked Deliveries Orders&apos; THEN [Calculation_5860871990335107093]&#10;WHEN &apos;% Busy Failed Rate&apos; THEN [Calculation_5860871990229643271]&#10;WHEN &apos;% Closed Failed Rate&apos; THEN [Calculation_5860871990229987336]&#10;WHEN &apos;% Customer-owned Failed Rate&apos; THEN [Calculation_5860871990230224905]&#10;WHEN &apos;% Unreachable Failed Rate&apos; THEN [Calculation_5860871990332768273]&#10;WHEN &apos;% Failed Rate&apos; THEN [Calculation_5860871990229413893]&#10;WHEN &apos;% Item Unavailable Failed Rate&apos; THEN [Calculation_5860871990291619852]&#10;WHEN &apos;% NGT Order Shares&apos; THEN [Calculation_128915565332135944]&#10;WHEN &apos;% No Response Failed Rate&apos; THEN [Calculation_5860871990292238349]&#10;WHEN &apos;% Pickup Order Shares&apos; THEN [Calculation_5860871990333403156]&#10;WHEN &apos;% Platform-owned Failed Rate&apos; THEN [Calculation_5860871990292598798]&#10;WHEN &apos;% Preorder Shares&apos; THEN [Calculation_5860871990333202451]&#10;WHEN &apos;% Transport-owned Failed Rate&apos; THEN [Calculation_5860871990324359184]&#10;WHEN &apos;% Unreachable Failed Rate&apos; THEN [Calculation_5860871990332768273]&#10;WHEN &apos;% Vendor-owned Failed Rate&apos; THEN [Calculation_5860871990224556036]&#10;WHEN &apos;Avg. At Vendor Time (Seconds)&apos; THEN [Calculation_128915565328510976]&#10;WHEN &apos;Avg. Delivery Time (Seconds)&apos; THEN [Calculation_128915565330075653]&#10;WHEN &apos;Avg. Estimated Prep Time (Seconds)&apos; THEN [Calculation_128915565329100802]&#10;WHEN &apos;Avg. Response Time (Seconds)&apos; THEN [Calculation_128915565330296838]&#10;WHEN &apos;Avg. Rider Acceptance Time (Seconds)&apos; THEN [Calculation_128915565329920004]&#10;WHEN &apos;Avg. Pickup Distance&apos; THEN [Calculation_128915565329334275]&#10;WHEN &apos;Avg. Dropoff Distance&apos; THEN [Calculation_128915565328687105]&#10;WHEN &apos;% Offline Duration&apos; THEN [Calculation_128915565332938763]&#10;WHEN &apos;% Offline Special Day Duration&apos; THEN [Calculation_128915565336543244]&#10;WHEN &apos;% Offline Unreachable Duration&apos; THEN [Calculation_128915565332721674]&#10;WHEN &apos;Vendors with Orders&apos; THEN [Calculation_141581928416874497]&#10;END' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_128915565480652817]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1 1]&#10;    WHEN &apos;Daily&apos; THEN STR([created_date])&#10;WHEN &apos;Weekly&apos; THEN [Calculation_128915565481050130]&#10;WHEN &apos;Monthly&apos; THEN [Calculation_128915565482999827]&#10;WHEN &apos;Quarterly&apos; THEN STR(DATE(DATETRUNC(&apos;quarter&apos;,[created_date])))&#10;END' />
            </column>
            <column caption='Created Date Week' datatype='string' name='[Calculation_128915565481050130]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;&apos; &#10;+ STR(YEAR([created_date]))&#10;+ &apos;-&apos; &#10;+ IF( WEEK([created_date]) &gt; 9) THEN STR(WEEK([created_date]))&#10;ELSE   &apos;0&apos; +  STR(WEEK([created_date]))&#10;END' />
            </column>
            <column caption='Created Date Month' datatype='string' name='[Calculation_128915565482999827]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;&apos; &#10;+  STR(YEAR([created_date]))&#10;+ &apos;-&apos; &#10;+  IF( MONTH([created_date]) &gt; 9) THEN STR(MONTH([created_date]))&#10;ELSE   &apos;0&apos; +  STR(MONTH([created_date]))&#10;END' />
            </column>
            <column caption='_filter_y_axis' datatype='string' name='[Calculation_130393288260218880]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 2 1]' />
            </column>
            <column caption='Platform Vendor' datatype='string' name='[Calculation_131871041718714368]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[entity_id] + STR([vendor_code])' />
            </column>
            <column caption='# Vendors with Orders' datatype='integer' name='[Calculation_141581928416874497]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [orders_received_ct] &gt; 0 THEN [Calculation_131871041718714368] END)' />
            </column>
            <column caption='_user_entitlement' datatype='boolean' name='[Calculation_172544202867093504]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[username] = USERNAME()' />
            </column>
            <column caption='_is today?' datatype='boolean' name='[Calculation_2235826142796382209]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[created_date] =  DATE(TODAY())' />
            </column>
            <column caption='Vendor Maturity' datatype='string' name='[Calculation_31243725931130880]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_new_vendor]&#10;    THEN &apos;New Vendors (First 28 Days)&apos;&#10;    ELSE &apos;Mature Vendors&apos;&#10;END' />
            </column>
            <column caption='# Received Orders' datatype='integer' name='[Calculation_5860871990223896576]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_received_ct])' />
            </column>
            <column caption='# Completed Orders' datatype='integer' name='[Calculation_5860871990224052225]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_completed_ct])' />
            </column>
            <column caption='# Cancelled Orders' datatype='integer' name='[Calculation_5860871990224162818]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_failed_ct])' />
            </column>
            <column caption='% Vendor Failed Rate' datatype='real' name='[Calculation_5860871990224556036]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([order_vendor_failed_ct])/[Calculation_5860871990223896576])*100' />
            </column>
            <column caption='% Failed Rate' datatype='real' name='[Calculation_5860871990229413893]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_5860871990224162818]/[Calculation_5860871990223896576])*100' />
            </column>
            <column caption='% Busy Failed Rate' datatype='real' name='[Calculation_5860871990229643271]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([order_busy_failed_ct])/[Calculation_5860871990223896576])*100' />
            </column>
            <column caption='% Closed Failed Rate' datatype='real' name='[Calculation_5860871990229987336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([order_closed_failed_ct])/[Calculation_5860871990223896576])*100' />
            </column>
            <column caption='% Customer-owned Failed Rate' datatype='real' name='[Calculation_5860871990230224905]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([order_customer_failed_ct])/[Calculation_5860871990223896576])*100' />
            </column>
            <column caption='% Item Unavailable Failed Rate' datatype='real' name='[Calculation_5860871990291619852]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([order_item_unavailable_failed_ct])/[Calculation_5860871990223896576])*100' />
            </column>
            <column caption='% No Response Failed Rate' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_5860871990292238349]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([order_no_response_failed_ct])/[Calculation_5860871990223896576])*100' />
            </column>
            <column caption='% Platform-owned Failed Rate' datatype='real' name='[Calculation_5860871990292598798]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([order_platform_failed_ct])/[Calculation_5860871990223896576])*100' />
            </column>
            <column caption='% Transport-owned Failed Rate' datatype='real' name='[Calculation_5860871990324359184]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([order_transport_failed_ct])/[Calculation_5860871990223896576])*100' />
            </column>
            <column caption='% Unreachable Failed Rate' datatype='real' name='[Calculation_5860871990332768273]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([order_unreachable_failed_ct])/[Calculation_5860871990223896576])*100' />
            </column>
            <column caption='% Preorder Shares' datatype='real' name='[Calculation_5860871990333202451]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([preorder_cnt])/[Calculation_5860871990223896576])*100' />
            </column>
            <column caption='% Pickup Order Shares' datatype='real' name='[Calculation_5860871990333403156]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([pu_cnt])/[Calculation_5860871990223896576])*100' />
            </column>
            <column caption='# Stacked Deliveries Orders' datatype='integer' name='[Calculation_5860871990335107093]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([stacked_deliveries_cnt])' />
