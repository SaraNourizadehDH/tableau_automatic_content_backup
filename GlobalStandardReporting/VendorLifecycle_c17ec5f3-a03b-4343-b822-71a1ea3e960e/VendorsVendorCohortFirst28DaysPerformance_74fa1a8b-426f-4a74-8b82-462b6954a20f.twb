      </column>
      <column caption='% Grade NA' datatype='real' name='[% Grade A (copy) (copy) (copy) (copy)_1593992861674668062]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([grade_NA_cohort_size])/SUM([Calculation_1593992861674143769])' />
      </column>
      <column caption='% Grade D' datatype='real' name='[% Grade A (copy) (copy) (copy)_1593992861674659869]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([grade_D_cohort_size])/SUM([Calculation_1593992861674143769])' />
      </column>
      <column caption='% Grade C' datatype='real' name='[% Grade A (copy) (copy)_1593992861674651676]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([grade_C_cohort_size])/SUM([Calculation_1593992861674143769])' />
      </column>
      <column caption='% Grade B' datatype='real' name='[% Grade A (copy)_1593992861674639387]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([grade_B_cohort_size])/SUM([Calculation_1593992861674143769])' />
      </column>
      <column caption='% Vendor Retention (copy)' datatype='real' name='[% Vendor Retention (copy)_4793237380765245441]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([cohort_size]) / ATTR([Fixed Cohort Size (copy)_5164432506321833984]) = 0 &#10;  THEN NULL&#10;ELSE &#10;  SUM([cohort_size]) / ATTR([Fixed Cohort Size (copy)_5164432506321833984])&#10;END' />
      </column>
      <column caption='% Vendors without Orders' datatype='real' name='[% Vendors with Orders (copy)_378302396641665024]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - (SUM([vendors_with_orders_size])/SUM([cohort_size]))' />
      </column>
      <column caption='% Fail Rate' datatype='real' name='[Calculation_1593992861386223616]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fail_orders_ct]) / SUM([orders_ct])' />
      </column>
      <column caption='% Unreachable Duration' datatype='real' name='[Calculation_1593992861388275721]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([unreachable_duration])/ SUM([slots_duration])' />
      </column>
      <column caption='% Vendor Late &gt; 10' datatype='real' name='[Calculation_1593992861388599306]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendor_late_10_ct]) / SUM([od_pickedup_orders_ct])' />
      </column>
      <column caption='Avg Response Time' datatype='real' name='[Calculation_1593992861401001995]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([total_response_time]) / SUM([accepted_orders]), 1)' />
      </column>
      <column aggregation='Attribute' caption='Fixed Cohort Size' datatype='integer' name='[Calculation_1593992861405941776]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ EXCLUDE [date_diff]: SUM({ INCLUDE [first_order_created_week_local]&#10;                                       , [region]&#10;                                       , [brand_name]&#10;                                       , [country_name]&#10;                                       , [first_delivery_type]&#10;                                       , [first_vertical_type]&#10;                                       , [first_client_name]&#10;                                       , [first_pos_integration_type]&#10;                                       , [first_is_ngt]&#10;                                       , [has_tutorial]&#10;                                       , [has_test_order]&#10;                                       , [has_test_order] : MAX([cohort_size])})}' />
      </column>
      <column caption='Cohort Size' datatype='integer' name='[Calculation_1593992861407969299]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='[Calculation_1593992861405941776]' />
      </column>
      <column caption='% Vendor Retention' datatype='real' name='[Calculation_1593992861408534548]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([cohort_size]) / ATTR([Calculation_1593992861405941776]) = 0 &#10;  THEN NULL&#10;ELSE &#10;  SUM([cohort_size]) / ATTR([Calculation_1593992861405941776])&#10;END' />
      </column>
      <column caption='Metric to Show' datatype='real' name='[Calculation_1593992861410680853]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &quot;% Vendor Retention&quot;&#10;        THEN [Calculation_1593992861408534548]&#10;    WHEN &quot;# Orders Received&quot;&#10;        THEN SUM([orders_ct])&#10;    WHEN &quot;# Failed Orders&quot;&#10;        THEN SUM([fail_orders_ct])&#10;    WHEN &quot;% Fail Rate&quot;&#10;        THEN [Calculation_1593992861386223616]&#10;    WHEN &quot;% Vendor Fail Rate&quot;&#10;        THEN [% Fail Rate (copy)_1593992861386686465]&#10;    WHEN &quot;% UNREACHABLE Fail Rate&quot;&#10;        THEN [% Fail Rate (copy)_1593992861387689991]&#10;    WHEN &quot;% TOO BUSY Fail Rate&quot;&#10;        THEN [% Fail Rate (copy) (copy) (copy) (copy) (copy)_1593992861386727429]&#10;    WHEN &quot;% ITEM UNAVAILABLE Fail Rate&quot;&#10;        THEN [% Fail Rate (copy) (copy) (copy)_1593992861386702851]&#10;    WHEN &quot;% NO RESPONSE Fail Rate&quot;&#10;        THEN [% Fail Rate (copy) (copy) (copy) (copy)_1593992861386715140]&#10;    WHEN &quot;% CLOSED Fail Rate&quot;&#10;        THEN [% Fail Rate (copy) (copy)_1593992861386694658]&#10;    WHEN &quot;% UNKNOWN Fail Rate&quot;&#10;        THEN [% Fail Rate (copy) (copy) (copy) (copy) (copy) (copy)_1593992861386735622]&#10;    WHEN &quot;# Schedule Duration (h)&quot;&#10;        THEN [Calculation_4793237380752007168]&#10;    WHEN &quot;% Unreachable Duration&quot;&#10;        THEN [Calculation_1593992861388275721]&#10;    WHEN &quot;# OD Pickedup Orders&quot;&#10;        THEN SUM([od_pickedup_orders_ct])&#10;    WHEN &quot;% Vendor Late &gt; 10&quot;&#10;        THEN [Calculation_1593992861388599306]&#10;    WHEN &quot;# Accepted Orders&quot;&#10;        THEN SUM([accepted_orders])&#10;    WHEN &quot;Avg Response Time&quot;&#10;        THEN [Calculation_1593992861401001995]&#10;    WHEN &quot;% Vendors with Orders&quot;&#10;        THEN [Calculation_574631170500419584]&#10;    WHEN &quot;% Vendors without Orders&quot;&#10;        THEN [% Vendors with Orders (copy)_378302396641665024]&#10;END' />
      </column>
      <column caption='_Choose Metric to show' datatype='string' name='[Calculation_1593992861434818582]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
      </column>
      <column caption='Dimension' datatype='string' name='[Calculation_1593992861438677015]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;All&apos; THEN &apos;&apos;&#10;WHEN &apos;Cohort&apos; THEN STR([first_order_created_week_local])&#10;WHEN &apos;Region&apos; THEN [region]&#10;WHEN &apos;Brand Name&apos; THEN [brand_name]&#10;WHEN &apos;Country Name&apos; THEN [country_name]&#10;WHEN &apos;Delivery Type&apos; THEN [first_delivery_type]&#10;WHEN &apos;Vertical Type&apos; THEN [first_vertical_type]&#10;WHEN &apos;Client Name&apos; THEN [first_client_name]&#10;WHEN &apos;POS Integration Flow&apos; THEN [first_pos_integration_type]&#10;WHEN &apos;Is NGT&apos; THEN [first_is_ngt]&#10;WHEN &apos;Has Tutorial&apos; THEN STR([has_tutorial])&#10;WHEN &apos;Has Test Order&apos; THEN STR([has_test_order])&#10;WHEN &apos;Has Self Activation&apos; THEN STR([has_self_activation])&#10;END' />
      </column>
      <column caption='All grades cohort size' datatype='integer' name='[Calculation_1593992861674143769]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[grade_A_cohort_size] + [grade_B_cohort_size] + [grade_C_cohort_size] + [grade_D_cohort_size] + [grade_NA_cohort_size]' />
      </column>
      <column caption='% Grade A' datatype='real' name='[Calculation_1593992861674475546]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([grade_A_cohort_size])/SUM([Calculation_1593992861674143769])' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_1640084360134225920]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='_chosen report week' datatype='boolean' name='[Calculation_1844364797967679488]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 4] &gt;= [date_diff]' />
      </column>
      <column caption='Schedule Duration (h)' datatype='real' name='[Calculation_4793237380752007168]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([slots_duration]) / 60, 0)' />
      </column>
      <column caption='% Vendors with Orders' datatype='real' name='[Calculation_574631170500419584]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendors_with_orders_size])/SUM([cohort_size])' />
      </column>
      <column aggregation='Attribute' caption='Fixed Cohort Size (copy)' datatype='integer' name='[Fixed Cohort Size (copy)_5164432506321833984]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ EXCLUDE [date_diff]: SUM({ INCLUDE [first_order_created_week_local]&#10;                                       , [region]&#10;                                       , [brand_name]&#10;                                       , [country_name]&#10;                                       , [first_delivery_type]&#10;                                       , [first_vertical_type]&#10;                                       , [first_client_name]&#10;                                       , [first_pos_integration_type]&#10;                                       , [first_is_ngt]&#10;                                       , [has_tutorial]&#10;                                       , [has_test_order]&#10;                                       , [has_test_order] : MAX([cohort_size])})}' />
      </column>
      <column caption='_Choose Chort to show' datatype='boolean' name='[_Choose Metric to show (copy)_844284230206025728]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[week_cohort] &gt;= [Parameters].[Parameter 3]' />
