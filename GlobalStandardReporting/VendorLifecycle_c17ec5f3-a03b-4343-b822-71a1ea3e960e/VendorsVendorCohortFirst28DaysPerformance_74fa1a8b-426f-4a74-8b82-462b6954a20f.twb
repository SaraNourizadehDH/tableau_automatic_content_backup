            <column caption='Dimension' datatype='string' name='[Calculation_1593992861438677015]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;All&apos; THEN &apos;&apos;&#10;WHEN &apos;Cohort&apos; THEN STR([first_order_created_week_local])&#10;WHEN &apos;Region&apos; THEN [region]&#10;WHEN &apos;Brand Name&apos; THEN [brand_name]&#10;WHEN &apos;Country Name&apos; THEN [country_name]&#10;WHEN &apos;Delivery Type&apos; THEN [first_delivery_type]&#10;WHEN &apos;Vertical Type&apos; THEN [first_vertical_type]&#10;WHEN &apos;Client Name&apos; THEN [first_client_name]&#10;WHEN &apos;POS Integration Flow&apos; THEN [first_pos_integration_type]&#10;WHEN &apos;Is NGT&apos; THEN [first_is_ngt]&#10;WHEN &apos;Has Tutorial&apos; THEN STR([has_tutorial])&#10;WHEN &apos;Has Test Order&apos; THEN STR([has_test_order])&#10;WHEN &apos;Has Self Activation&apos; THEN STR([has_self_activation])&#10;END' />
