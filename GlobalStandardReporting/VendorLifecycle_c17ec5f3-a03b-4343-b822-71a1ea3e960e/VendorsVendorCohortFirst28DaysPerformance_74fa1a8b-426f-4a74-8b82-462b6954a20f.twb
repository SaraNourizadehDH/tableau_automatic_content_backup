      <column caption='% Cohort Vendors have Orders in Period' datatype='real' name='[Calculation_5219109043053993984]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Date Granularity (copy)] &#10;WHEN &apos;# Vendors with Orders&apos; THEN &#10;SUM(IF [cte_type] = &apos;cohort&apos; THEN [vendors_with_orders_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;cohort&apos; THEN [vendors_ct] ELSE 0 END)&#10;END' />
      </column>
      <column caption='# Cohort Vendors Have Orders In Period' datatype='integer' name='[Calculation_5219109043064205313]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [cte_type] = &apos;cohort&apos; THEN [vendors_with_orders_ct] ELSE 0 END)' />
      </column>
      <column caption='% Cohort GoDroid Vendors in Period' datatype='real' name='[Calculation_5219109043064369154]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [cte_type] = &apos;cohort&apos; THEN [vendor_godroid_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;cohort&apos; THEN [vendors_with_orders_ct] ELSE 0 END)' />
      </column>
      <column caption='% Cohort GoWeb Vendors in Period' datatype='real' name='[Calculation_5219109043064659971]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [cte_type] = &apos;cohort&apos; THEN [vendor_goweb_ct] ELSE 0 END)/SUM(IF [cte_type] = &apos;cohort&apos; THEN [vendors_with_orders_ct] ELSE 0 END)' />
