      <aliases enabled='yes' />
      <column caption='# Cohort Vendors' datatype='integer' name='[Calculation_2039075110154764292]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendors_ct])' />
      </column>
      <column caption='Dimension (A)' datatype='string' name='[Calculation_2360941744907505688]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Metric (copy)] = &apos;(All)&apos; THEN &apos;(All)&apos;&#10;ELSEIF [Parameters].[Metric (copy)] = &apos;Region&apos; THEN [region]&#10;ELSEIF [Parameters].[Metric (copy)] = &apos;Brand Name&apos; THEN [brand_name]&#10;ELSEIF [Parameters].[Metric (copy)] = &apos;Country&apos; THEN [country_name]&#10;ELSEIF [Parameters].[Metric (copy)] = &apos;Is Self Activated&apos; THEN STR([is_self_activated])&#10;ELSEIF [Parameters].[Metric (copy)] = &apos;Vendor Grade&apos; THEN [vendor_grade]&#10;ELSEIF [Parameters].[Metric (copy)] = &apos;Vertical Food&apos; THEN [first_vertical_type]&#10;ELSEIF [Parameters].[Metric (copy)] = &apos;Transmission Type&apos; THEN [transmission_type]&#10;ELSEIF [Parameters].[Metric (copy)] = &apos;First Delivery Type&apos; THEN [first_delivery_type]&#10;END' />
      </column>
      <column caption='Shown Metric' datatype='real' name='[Calculation_2360941744910172185]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Date Granularity (copy)] &#10;WHEN &apos;# Orders&apos; THEN SUM([orders_ct])&#10;WHEN &apos;# Vendors with Orders&apos; THEN SUM([vendors_with_orders_ct])&#10;WHEN &apos;% Vendors with Orders&apos; THEN SUM([vendors_with_orders_ct])/SUM([vendors_ct])&#10;WHEN &apos;# OD Orders&apos; THEN SUM([od_orders_ct])&#10;WHEN &apos;# POS Orders&apos; THEN SUM([pos_orders_ct])&#10;WHEN &apos;% Fail Rate&apos; THEN SUM([fail_orders_ct])/SUM([orders_ct])&#10;WHEN &apos;  % Vendor Fail Rate&apos; THEN SUM([fail_orders_vendor_ct])/SUM([orders_ct])&#10;WHEN &apos;# GoWin Orders&apos; THEN SUM([gowin_orders_ct])&#10;WHEN &apos;# GoWeb Orders&apos; THEN SUM([goweb_orders_ct])&#10;WHEN &apos;# GoDroid Orders&apos; THEN SUM([godroid_orders_ct])&#10;WHEN &apos;# GoWin Vendors&apos; THEN SUM([vendor_gowin_ct])&#10;WHEN &apos;# GoWeb Vendors&apos; THEN SUM([vendor_goweb_ct])&#10;WHEN &apos;# GoDroid Vendors&apos; THEN SUM([vendor_godroid_ct])&#10;WHEN &apos;% GoDroid Vendors&apos; THEN SUM([vendor_godroid_ct])/SUM([vendors_with_orders_ct])&#10;WHEN &apos;% GoWeb Vendors&apos; THEN SUM([vendor_goweb_ct])/SUM([vendors_with_orders_ct])&#10;WHEN &apos;% GoWin Vendors&apos; THEN SUM([vendor_gowin_ct])/SUM([vendors_with_orders_ct])&#10;WHEN &apos;    % Item Unavailable FR&apos; THEN SUM([fail_orders_item_unavailable_ct])/SUM([orders_ct])&#10;WHEN &apos;    % Unreachable FR&apos; THEN SUM([fail_orders_unreachable_ct])/SUM([orders_ct])&#10;WHEN &apos;    % No Response FR&apos; THEN SUM([fail_orders_no_response_ct])/SUM([orders_ct])&#10;WHEN &apos;    % Too Busy FR&apos; THEN SUM([fail_orders_too_busy_ct])/SUM([orders_ct])&#10;WHEN &apos;    % Closed FR&apos; THEN SUM([fail_orders_closed_ct])/SUM([orders_ct])&#10;END' />
      </column>
      <column caption='_is_filter' datatype='integer' name='[Calculation_2360941744957775899]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Date Granularity (copy)]&#10;WHEN &apos;# Vendors with Orders&apos; THEN 1&#10;WHEN &apos;# Orders&apos; THEN 2&#10;WHEN &apos;# OD Orders&apos; THEN 2&#10;WHEN &apos;# POS Orders&apos; THEN 2&#10;WHEN &apos;# GoWin Orders&apos; THEN 2&#10;WHEN &apos;# GoWeb Orders&apos; THEN 2&#10;WHEN &apos;# GoDroid Orders&apos; THEN 2&#10;WHEN &apos;Vendor Grade Distribution&apos; THEN 3&#10;WHEN &apos;% Fail Rate&apos; THEN 4&#10;WHEN &apos;  % Vendor Fail Rate&apos; THEN 4&#10;WHEN &apos;    % Item Unavailable FR&apos; THEN 4&#10;WHEN &apos;    % Unreachable FR&apos; THEN 4&#10;WHEN &apos;    % No Response FR&apos; THEN 4&#10;WHEN &apos;    % Too Busy FR&apos; THEN 4&#10;WHEN &apos;    % Closed FR&apos; THEN 4&#10;WHEN &apos;GO Vendors&apos; THEN 5&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Fixed Cohort Size' datatype='real' name='[Calculation_2360941745946132508]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG({ INCLUDE [cohort_week], [time_period]&#10;                                        , [region]&#10;                                        , [brand_name]&#10;                                        , [country_name]&#10;                                        , [is_self_activated]&#10;                                        , [first_client_name]&#10;                                        , [first_delivery_type]&#10;                                        , [first_pos_integration_type]&#10;                                        , [first_vertical_type] : SUM([vendors_ct])})' />
      </column>
      <column caption='Dimension (B)' datatype='string' name='[Calculation_3501126516723589120]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Dimension (A) (copy)_1165939739784396800] = &apos;(All)&apos; THEN &apos;(All)&apos;&#10;ELSEIF [Parameters].[Dimension (A) (copy)_1165939739784396800] = &apos;Region&apos; THEN [region]&#10;ELSEIF [Parameters].[Dimension (A) (copy)_1165939739784396800] = &apos;Brand Name&apos; THEN [brand_name]&#10;ELSEIF [Parameters].[Dimension (A) (copy)_1165939739784396800] = &apos;Country&apos; THEN [country_name]&#10;ELSEIF [Parameters].[Dimension (A) (copy)_1165939739784396800] = &apos;Is Self Activated&apos; THEN STR([is_self_activated])&#10;ELSEIF [Parameters].[Dimension (A) (copy)_1165939739784396800] = &apos;Vendor Grade&apos; THEN [vendor_grade]&#10;ELSEIF [Parameters].[Dimension (A) (copy)_1165939739784396800] = &apos;Vertical Food&apos; THEN [first_vertical_type]&#10;ELSEIF [Parameters].[Dimension (A) (copy)_1165939739784396800] = &apos;Transmission Type&apos; THEN [transmission_type]&#10;ELSEIF [Parameters].[Dimension (A) (copy)_1165939739784396800] = &apos;First Delivery Type&apos; THEN [first_delivery_type]&#10;END' />
      </column>
      <column caption='User_filter' datatype='boolean' name='[Calculation_3742420953267798016]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='% Cohort Vendors with Orders' datatype='real' name='[Calculation_6689323215228657664]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendors_with_orders_ct])/SUM([vendors_ct])' />
