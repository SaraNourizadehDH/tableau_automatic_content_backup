            <column caption='Schedule Duration (h)' datatype='real' name='[Calculation_4793237380752007168]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([slots_duration]) / 60, 0)' />
            </column>
            <column caption='% Vendors with Orders' datatype='real' name='[Calculation_574631170500419584]' role='measure' type='quantitative'>
