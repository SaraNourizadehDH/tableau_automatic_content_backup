              <calculation class='tableau' formula='IF [Parameters].[Metric (copy)] = &apos;(All)&apos; THEN &apos;(All)&apos;&#10;ELSEIF [Parameters].[Metric (copy)] = &apos;Region&apos; THEN [region]&#10;ELSEIF [Parameters].[Metric (copy)] = &apos;Brand Name&apos; THEN [brand_name]&#10;ELSEIF [Parameters].[Metric (copy)] = &apos;Country&apos; THEN [country_name]&#10;ELSEIF [Parameters].[Metric (copy)] = &apos;Is Self Activated&apos; THEN STR([is_self_activated])&#10;ELSEIF [Parameters].[Metric (copy)] = &apos;Vendor Grade&apos; THEN [vendor_grade]&#10;ELSEIF [Parameters].[Metric (copy)] = &apos;Transmission Type&apos; THEN [transmission_type]&#10;ELSEIF [Parameters].[Metric (copy)] = &apos;Vertical Food&apos; THEN [vertical_food]&#10;ELSEIF [Parameters].[Metric (copy)] = &apos;First Delivery Type&apos; THEN [first_delivery_type]&#10;END' />
