            <column caption='Event' datatype='string' name='[event]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2089177702245564417]' derivation='None' name='[none:Calculation_2089177702245564417:nk]' pivot='key' type='nominal' />
