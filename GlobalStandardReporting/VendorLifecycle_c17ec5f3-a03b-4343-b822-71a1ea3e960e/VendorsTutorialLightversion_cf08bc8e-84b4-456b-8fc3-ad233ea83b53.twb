            </column>
            <column caption='Minutes' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_2188819842563964942]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[seconds]/60' />
            </column>
            <column caption='last_flow_of_vendor' datatype='string' name='[Calculation_2188819842567929871]' role='dimension' type='nominal'>
