    <worksheet name='Trends in Timings'>
      <table>
        <view>
          <datasources>
            <datasource caption='vendor_gsr_tutorial_lighter_timing_dashboard (rl)' name='federated.05dhw2w1j55h9e0zipbho1fqyuaw' />
            <datasource caption='vendor_gsr_tutorial_lighter_dashboard (rl)' name='federated.1r6v5yl0h51rcl18ivyug1d8mhcu' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Is Self-Activation Vendor' datatype='string' name='[# Absolute/ % (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;Yes&quot;'>
              <calculation class='tableau' formula='&quot;Yes&quot;' />
            </column>
            <column caption='Choose Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.05dhw2w1j55h9e0zipbho1fqyuaw'>
            <column caption='Tutorial Phase' datatype='string' name='[Calculation_1822902374177574913]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [flow_phase]&#10;WHEN &apos;p1_test_order_sent&apos; THEN &apos;2- First Test Order Sent Vendors&apos;&#10;WHEN &apos;p2_test_order_accept_flow_completed&apos; THEN &apos;3- Test Order Accepted Vendors&apos;&#10;WHEN &apos;p3_second_test_order_sent&apos; THEN &apos;4- Second Test Order Sent Vendors&apos;&#10;WHEN &apos;p4_test_order_decline_flow_completed&apos; THEN &apos;5- Test Order Declined Vendors&apos;&#10;WHEN &apos;p5_busy_mode_flow_completed&apos; THEN &apos;6- Busy Mode Completed Vendors&apos;&#10;WHEN &apos;p6_self_activation_done&apos; THEN &apos;7- Self-Activated Vendors&apos;&#10;END' />
            </column>
            <column caption='Is Activated Vendor?' datatype='boolean' name='[Calculation_1822902374182539266]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[# Absolute/ % (copy)]&#10;WHEN &apos;Yes&apos; THEN [Calculation_2188819842567929871] == &apos;6&apos;&#10;WHEN &apos;All&apos; THEN 1 = 1&#10;END' />
            </column>
            <column caption='last_flow_of_vendor' datatype='string' name='[Calculation_2188819842567929871]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ FIXED [entity_id]+[vendor_code]:MAX(MID([flow_phase],2,1))}' />
            </column>
            <column caption='is_not_negative_time' datatype='integer' name='[Calculation_2188819842602012689]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [seconds] &lt; 0 THEN 0 ELSE 1 END' />
            </column>
            <column caption='90 percentile' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_4018547930596503552]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RAWSQLAGG_REAL(&quot;APPROX_QUANTILES(%1,100)[OFFSET(90)]&quot;, [seconds]/60)' />
            </column>
            <column caption='Median' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_4018547930600345601]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RAWSQLAGG_REAL(&quot;APPROX_QUANTILES(%1,100)[OFFSET(50)]&quot;, [seconds]/60)' />
            </column>
            <column caption='t-dimension' datatype='string' name='[Calculation_4201365927985188866]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Daily&apos;&#10;        THEN STR([created_date])&#10;    WHEN &apos;Weekly&apos;&#10;        THEN STR([created_week])&#10;    WHEN &apos;Monthly&apos;&#10;        THEN STR([created_month])&#10;    WHEN &apos;Quarterly&apos;&#10;        THEN STR(DATE(DATETRUNC(&apos;quarter&apos;, [created_date])))&#10;    WHEN &apos;Yearly&apos;&#10;        THEN STR([created_year])&#10;END' />
            </column>
            <column caption='75 percentile' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_5170906485701242880]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RAWSQLAGG_REAL(&quot;APPROX_QUANTILES(%1,100)[OFFSET(75)]&quot;, [seconds]/60)' />
            </column>
            <column caption='Brand Name' datatype='string' name='[brand_name]' role='dimension' type='nominal' />
            <column caption='Client' datatype='string' name='[client_name]' role='dimension' type='nominal' />
            <column caption='Client Version' datatype='string' name='[client_version]' role='dimension' type='nominal' />
            <column caption='Date' datatype='date' name='[created_date]' role='dimension' type='ordinal' />
            <column caption='Created Month' datatype='string' name='[created_month]' role='dimension' type='nominal' />
            <column caption='Created Week' datatype='string' name='[created_week]' role='dimension' type='nominal' />
            <column caption='Created Year' datatype='integer' name='[created_year]' role='dimension' type='quantitative' />
            <column caption='Entity Id' datatype='string' name='[entity_id]' role='dimension' type='nominal' />
            <column caption='Flow Phase' datatype='string' name='[flow_phase]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1822902374177574913]' derivation='None' name='[none:Calculation_1822902374177574913:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1822902374182539266]' derivation='None' name='[none:Calculation_1822902374182539266:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2188819842602012689]' derivation='None' name='[none:Calculation_2188819842602012689:ok]' pivot='key' type='ordinal' />
