    <worksheet name='Postponers Behaviors with Dimension'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Postponers Behavior</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='vendor_gsr_tutorial_lighter_dashboard (rl)' name='federated.1r6v5yl0h51rcl18ivyug1d8mhcu' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Metric' datatype='string' name='[Choose Date Granularity (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;Percentage&quot;'>
              <calculation class='tableau' formula='&quot;Percentage&quot;' />
            </column>
            <column caption='Choose Dimension (B)' datatype='string' name='[Choose Dimension (A) (copy)_635781659671650311]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
              <calculation class='tableau' formula='&quot;Country&quot;' />
            </column>
            <column caption='Choose Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
            <column caption='Choose Dimension (A)' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Region&quot;'>
              <calculation class='tableau' formula='&quot;Region&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1r6v5yl0h51rcl18ivyug1d8mhcu'>
            <column caption='_abs_percent_percent_filter' datatype='boolean' name='[Calculation_2089177702245564417]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Choose Date Granularity (copy)] = &apos;Percentage&apos;&#10;THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='Postponers Self-Activated' datatype='real' name='[Calculation_2188819842521407496]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [event] = &apos;s8_1_postponers_selfactivated&apos; THEN [vendors] ELSE 0 END)/SUM(IF [event] = &apos;s8_postponed_vendors&apos; THEN [vendors] ELSE 0 END)' />
            </column>
            <column caption='Postponers Re-postponed' datatype='real' name='[Calculation_2188819842521694217]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [event] = &apos;s8_2_postponers_postponed&apos; THEN [vendors] ELSE 0 END)/SUM(IF [event] = &apos;s8_postponed_vendors&apos; THEN [vendors] ELSE 0 END)' />
            </column>
            <column caption='Postponers Opened' datatype='real' name='[Calculation_2188819842522058762]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [event] = &apos;s8_3_postponers_reopened&apos; THEN [vendors] ELSE 0 END)/SUM(IF [event] = &apos;s8_postponed_vendors&apos; THEN [vendors] ELSE 0 END)' />
            </column>
            <column caption='Dimension A' datatype='string' name='[Calculation_635781659670880262]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;Country&apos; THEN [country_name]&#10;WHEN &apos;Region&apos; THEN [region]&#10;WHEN &apos;Brand Name&apos; THEN [brand_name]&#10;WHEN &apos;Client&apos; THEN [client_name]&#10;WHEN &apos;Client Version&apos; THEN [client_version]&#10;WHEN &apos;Wrapper Version&apos; THEN [client_wrapper_version]&#10;END' />
            </column>
            <column caption='Dimension B' datatype='string' name='[Calculation_635781659671826440]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Choose Dimension (A) (copy)_635781659671650311]&#10;WHEN &apos;Country&apos; THEN [country_name]&#10;WHEN &apos;Region&apos; THEN [region]&#10;WHEN &apos;Brand Name&apos; THEN [brand_name]&#10;WHEN &apos;Client&apos; THEN [client_name]&#10;WHEN &apos;Client Version&apos; THEN [client_version]&#10;WHEN &apos;Wrapper Version&apos; THEN [client_wrapper_version]&#10;WHEN &apos;(All)&apos; THEN &apos;&apos;&#10;END' />
            </column>
            <column caption='t-dimension' datatype='string' name='[Calculation_635781659685330953]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Daily&apos;&#10;        THEN STR([created_date])&#10;    WHEN &apos;Weekly&apos;&#10;        THEN STR([created_week])&#10;    WHEN &apos;Monthly&apos;&#10;        THEN STR([created_month])&#10;    WHEN &apos;Quarterly&apos;&#10;        THEN STR(DATE(DATETRUNC(&apos;quarter&apos;, [created_date])))&#10;    WHEN &apos;Yearly&apos;&#10;        THEN STR([created_year])&#10;END' />
            </column>
            <column caption='Postponers Co-Activated' datatype='real' name='[Calculation_6812327755858391042]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [event] = &apos;s8_4_postponers_coactivated&apos; THEN [vendors] ELSE 0 END)/SUM(IF [event] = &apos;s8_postponed_vendors&apos; THEN [vendors] ELSE 0 END)' />
            </column>
            <column caption='Brand Name' datatype='string' name='[brand_name]' role='dimension' type='nominal' />
            <column caption='Client' datatype='string' name='[client_name]' role='dimension' type='nominal' />
            <column caption='Client Version' datatype='string' name='[client_version]' role='dimension' type='nominal' />
            <column caption='Client Wrapper Version' datatype='string' name='[client_wrapper_version]' role='dimension' type='nominal' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
