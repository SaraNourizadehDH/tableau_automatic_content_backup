    <worksheet name='usage_dimension_abs'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Usage of Tutorial (Evolution) with dimensions</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='vendor_gsr_tutorial_lighter_dashboard (rl)' name='federated.1r6v5yl0h51rcl18ivyug1d8mhcu' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose Type of Activation' datatype='string' name='[Choose Date Granularity (copy 2)]' param-domain-type='list' role='measure' type='nominal' value='&quot;Self-Activate&quot;'>
              <calculation class='tableau' formula='&quot;Self-Activate&quot;' />
            </column>
            <column caption='Metric' datatype='string' name='[Choose Date Granularity (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;Percentage&quot;'>
              <calculation class='tableau' formula='&quot;Percentage&quot;' />
            </column>
            <column caption='Choose Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1r6v5yl0h51rcl18ivyug1d8mhcu'>
            <column caption='_abs_percent_abs_filter' datatype='boolean' name='[Calculation_2089177702247632898]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Choose Date Granularity (copy)] = &apos;Absolute Number&apos; &#10;THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='1 - Started Tutorial Vendors' datatype='real' name='[Calculation_2188819842477764609]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [event] = &apos;s1_started_tutorial_vendor&apos; THEN [vendors] ELSE 0 END)/SUM(IF [event] = &apos;s1_started_tutorial_vendor&apos; THEN [vendors] ELSE 0 END)' />
            </column>
            <column caption='2- First Test Order Sent Vendors' datatype='real' name='[Calculation_2188819842479407106]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [event] = &apos;s2_first_test_order_sent_vendors&apos; THEN [vendors] ELSE 0 END)/SUM(IF [event] = &apos;s1_started_tutorial_vendor&apos; THEN [vendors] ELSE 0 END)' />
            </column>
            <column caption='3- Test Order Accepted Vendors' datatype='real' name='[Calculation_2188819842480111619]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [event] = &apos;s3_test_order_accepted_vendors&apos; THEN [vendors] ELSE 0 END)/SUM(IF [event] = &apos;s1_started_tutorial_vendor&apos; THEN [vendors] ELSE 0 END)' />
            </column>
            <column caption='4- Second Test Order Sent Vendors' datatype='real' name='[Calculation_2188819842480304132]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [event] = &apos;s4_second_test_order_sent_vendors&apos; THEN [vendors] ELSE 0 END)/SUM(IF [event] = &apos;s1_started_tutorial_vendor&apos; THEN [vendors] ELSE 0 END)' />
            </column>
            <column caption='5- Test Order Declined Vendors' datatype='real' name='[Calculation_2188819842480504837]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [event] = &apos;s5_test_order_declined_vendors&apos; THEN [vendors] ELSE 0 END)/SUM(IF [event] = &apos;s1_started_tutorial_vendor&apos; THEN [vendors] ELSE 0 END)' />
            </column>
            <column caption='6- Busy Mode Completed Vendors' datatype='real' name='[Calculation_2188819842480668678]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [event] = &apos;s6_busy_mode_completed_vendors&apos; THEN [vendors] ELSE 0 END)/SUM(IF [event] = &apos;s1_started_tutorial_vendor&apos; THEN [vendors] ELSE 0 END)' />
            </column>
            <column caption='7- Self-Activated Vendors' datatype='real' name='[Calculation_2188819842480840711]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [event] = &apos;s7_self_activated_vendors&apos; THEN [vendors] ELSE 0 END)/SUM(IF [event] = &apos;s1_started_tutorial_vendor&apos; THEN [vendors] ELSE 0 END)' />
            </column>
            <column caption='Event Name' datatype='string' name='[Calculation_635781659583721472]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [event] = &apos;s1_started_tutorial_vendor&apos; THEN &apos;1- Started Tutorial Vendors&apos;&#10;ELSEIF [event] = &apos;s2_first_test_order_sent_vendors&apos; THEN &apos;2- First Test Order Sent Vendors&apos;&#10;ELSEIF [event] = &apos;s3_test_order_accepted_vendors&apos; THEN &apos;3- Test Order Accept Vendors&apos;&#10;ELSEIF [event] = &apos;s4_second_test_order_sent_vendors&apos; THEN &apos;4- Second Test Order Sent Vendors&apos;&#10;ELSEIF [event] = &apos;s5_test_order_declined_vendors&apos; THEN &apos;5- Test Order Declined Vendors&apos;&#10;ELSEIF [event] = &apos;s6_busy_mode_completed_vendors&apos; THEN &apos;6- Busy Mode Completed Vendors&apos;&#10;ELSEIF [event] = &apos;s7_self_activated_vendors&apos; THEN &apos;7- Self-Activated Vendors&apos;&#10;ELSEIF [event] = &apos;s8_postponed_vendors&apos; THEN &apos;Postponed Vendors&apos;&#10;ELSEIF [event] = &apos;s9_exited_vendors&apos; THEN &apos;Exited Vendors&apos;&#10;ELSEIF [event] = &apos;s10_coactivated_vendors&apos; THEN &apos;8- Co-Activated Vendors&apos;&#10;ELSEIF [event] = &apos;s8_1_postponers_selfactivated&apos; THEN &apos;Postponers Self-Activated&apos;&#10;ELSEIF [event] = &apos;s8_2_postponers_postponed&apos; THEN &apos;Postponers Postponed&apos;&#10;ELSEIF [event] = &apos;s8_3_postponers_reopened&apos; THEN &apos;Postponers Reopened&apos;&#10;ELSEIF [event] = &apos;s8_4_postponers_coactivated&apos; THEN &apos;Postponers Co-Activated&apos;&#10;END' />
            </column>
            <column caption='t-dimension' datatype='string' name='[Calculation_635781659685330953]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Daily&apos;&#10;        THEN STR([created_date])&#10;    WHEN &apos;Weekly&apos;&#10;        THEN STR([created_week])&#10;    WHEN &apos;Monthly&apos;&#10;        THEN STR([created_month])&#10;    WHEN &apos;Quarterly&apos;&#10;        THEN STR(DATE(DATETRUNC(&apos;quarter&apos;, [created_date])))&#10;    WHEN &apos;Yearly&apos;&#10;        THEN STR([created_year])&#10;END' />
            </column>
            <column caption='_is_self_activate' datatype='boolean' name='[Calculation_6812327756103352324]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Choose Date Granularity (copy 2)] WHEN &apos;Self-Activate&apos; THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='Brand Name' datatype='string' name='[brand_name]' role='dimension' type='nominal' />
            <column caption='Client' datatype='string' name='[client_name]' role='dimension' type='nominal' />
            <column caption='Client Version' datatype='string' name='[client_version]' role='dimension' type='nominal' />
            <column caption='Client Wrapper Version' datatype='string' name='[client_wrapper_version]' role='dimension' type='nominal' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Created Date' datatype='date' name='[created_date]' role='dimension' type='ordinal' />
            <column caption='Created Month' datatype='string' name='[created_month]' role='dimension' type='nominal' />
            <column caption='Created Week' datatype='string' name='[created_week]' role='dimension' type='nominal' />
            <column aggregation='Sum' caption='Created Year' datatype='integer' name='[created_year]' role='dimension' type='quantitative' />
            <column caption='Event' datatype='string' name='[event]' role='dimension' type='nominal' />
