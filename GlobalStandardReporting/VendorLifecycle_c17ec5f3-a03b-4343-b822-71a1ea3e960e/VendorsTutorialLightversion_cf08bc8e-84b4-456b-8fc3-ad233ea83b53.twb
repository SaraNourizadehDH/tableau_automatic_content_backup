              <calculation class='tableau' formula='IF [Parameters].[Choose Date Granularity (copy)] = &apos;Absolute Number&apos; &#10;THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='Event Name' datatype='string' name='[Calculation_635781659583721472]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [event] = &apos;s1_started_tutorial_vendor&apos; THEN &apos;1- Started Tutorial Vendors&apos;&#10;ELSEIF [event] = &apos;s2_first_test_order_sent_vendors&apos; THEN &apos;2- First Test Order Sent Vendors&apos;&#10;ELSEIF [event] = &apos;s3_test_order_accepted_vendors&apos; THEN &apos;3- Test Order Accept Vendors&apos;&#10;ELSEIF [event] = &apos;s4_second_test_order_sent_vendors&apos; THEN &apos;4- Second Test Order Sent Vendors&apos;&#10;ELSEIF [event] = &apos;s5_test_order_declined_vendors&apos; THEN &apos;5- Test Order Declined Vendors&apos;&#10;ELSEIF [event] = &apos;s6_busy_mode_completed_vendors&apos; THEN &apos;6- Busy Mode Completed Vendors&apos;&#10;ELSEIF [event] = &apos;s7_self_activated_vendors&apos; THEN &apos;7- Self-Activated Vendors&apos;&#10;ELSEIF [event] = &apos;s8_postponed_vendors&apos; THEN &apos;Postponed Vendors&apos;&#10;ELSEIF [event] = &apos;s9_exited_vendors&apos; THEN &apos;Exited Vendors&apos;&#10;ELSEIF [event] = &apos;s10_coactivated_vendors&apos; THEN &apos;8- Co-Activated Vendors&apos;&#10;ELSEIF [event] = &apos;s8_1_postponers_selfactivated&apos; THEN &apos;Postponers Self-Activated&apos;&#10;ELSEIF [event] = &apos;s8_2_postponers_postponed&apos; THEN &apos;Postponers Postponed&apos;&#10;ELSEIF [event] = &apos;s8_3_postponers_reopened&apos; THEN &apos;Postponers Reopened&apos;&#10;ELSEIF [event] = &apos;s8_4_postponers_coactivated&apos; THEN &apos;Postponers Co-Activated&apos;&#10;END' />
            </column>
            <column caption='Dimension A' datatype='string' name='[Calculation_635781659670880262]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;Country&apos; THEN [country_name]&#10;WHEN &apos;Region&apos; THEN [region]&#10;WHEN &apos;Brand Name&apos; THEN [brand_name]&#10;WHEN &apos;Client&apos; THEN [client_name]&#10;WHEN &apos;Client Version&apos; THEN [client_version]&#10;WHEN &apos;Wrapper Version&apos; THEN [client_wrapper_version]&#10;END' />
            </column>
            <column caption='Dimension B' datatype='string' name='[Calculation_635781659671826440]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Choose Dimension (A) (copy)_635781659671650311]&#10;WHEN &apos;Country&apos; THEN [country_name]&#10;WHEN &apos;Region&apos; THEN [region]&#10;WHEN &apos;Brand Name&apos; THEN [brand_name]&#10;WHEN &apos;Client&apos; THEN [client_name]&#10;WHEN &apos;Client Version&apos; THEN [client_version]&#10;WHEN &apos;Wrapper Version&apos; THEN [client_wrapper_version]&#10;WHEN &apos;(All)&apos; THEN &apos;&apos;&#10;END' />
            </column>
            <column caption='Abs/% Vendors' datatype='real' name='[Calculation_635781659751817226]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Choose Date Granularity (copy)]&#10;WHEN &apos;Absolute Number&apos; THEN SUM([vendors])&#10;WHEN &apos;Percentage&apos; THEN &#10;SUM([vendors])/SUM(IF [Calculation_635781659583721472] = &apos;1- Started Tutorial Vendors&apos; THEN [vendors] ELSE 0 END)&#10;END' />
