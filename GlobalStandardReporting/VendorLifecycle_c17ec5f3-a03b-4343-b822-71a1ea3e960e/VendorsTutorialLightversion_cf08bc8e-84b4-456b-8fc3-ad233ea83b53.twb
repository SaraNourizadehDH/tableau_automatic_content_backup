      <column caption='User Entitlement' datatype='boolean' name='[Calculation_1014295109040173056]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='_abs_percent_percent_filter' datatype='boolean' name='[Calculation_2089177702245564417]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Choose Date Granularity (copy)] = &apos;Percentage&apos;&#10;THEN TRUE&#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='_abs_percent_abs_filter' datatype='boolean' name='[Calculation_2089177702247632898]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Choose Date Granularity (copy)] = &apos;Absolute Number&apos; &#10;THEN TRUE&#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='1 - Started Tutorial Vendors' datatype='real' name='[Calculation_2188819842477764609]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [event] = &apos;s1_started_tutorial_vendor&apos; THEN [vendors] ELSE 0 END)/SUM(IF [event] = &apos;s1_started_tutorial_vendor&apos; THEN [vendors] ELSE 0 END)' />
      </column>
      <column caption='2- First Test Order Sent Vendors' datatype='real' name='[Calculation_2188819842479407106]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [event] = &apos;s2_first_test_order_sent_vendors&apos; THEN [vendors] ELSE 0 END)/SUM(IF [event] = &apos;s1_started_tutorial_vendor&apos; THEN [vendors] ELSE 0 END)' />
      </column>
      <column caption='3- Test Order Accepted Vendors' datatype='real' name='[Calculation_2188819842480111619]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [event] = &apos;s3_test_order_accepted_vendors&apos; THEN [vendors] ELSE 0 END)/SUM(IF [event] = &apos;s1_started_tutorial_vendor&apos; THEN [vendors] ELSE 0 END)' />
      </column>
      <column caption='4- Second Test Order Sent Vendors' datatype='real' name='[Calculation_2188819842480304132]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [event] = &apos;s4_second_test_order_sent_vendors&apos; THEN [vendors] ELSE 0 END)/SUM(IF [event] = &apos;s1_started_tutorial_vendor&apos; THEN [vendors] ELSE 0 END)' />
      </column>
      <column caption='5- Test Order Declined Vendors' datatype='real' name='[Calculation_2188819842480504837]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [event] = &apos;s5_test_order_declined_vendors&apos; THEN [vendors] ELSE 0 END)/SUM(IF [event] = &apos;s1_started_tutorial_vendor&apos; THEN [vendors] ELSE 0 END)' />
      </column>
      <column caption='6- Busy Mode Completed Vendors' datatype='real' name='[Calculation_2188819842480668678]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [event] = &apos;s6_busy_mode_completed_vendors&apos; THEN [vendors] ELSE 0 END)/SUM(IF [event] = &apos;s1_started_tutorial_vendor&apos; THEN [vendors] ELSE 0 END)' />
      </column>
      <column caption='7- Self-Activated Vendors' datatype='real' name='[Calculation_2188819842480840711]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [event] = &apos;s7_self_activated_vendors&apos; THEN [vendors] ELSE 0 END)/SUM(IF [event] = &apos;s1_started_tutorial_vendor&apos; THEN [vendors] ELSE 0 END)' />
      </column>
      <column caption='Postponers Self-Activated' datatype='real' name='[Calculation_2188819842521407496]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [event] = &apos;s8_1_postponers_selfactivated&apos; THEN [vendors] ELSE 0 END)/SUM(IF [event] = &apos;s8_postponed_vendors&apos; THEN [vendors] ELSE 0 END)' />
      </column>
      <column caption='Postponers Re-postponed' datatype='real' name='[Calculation_2188819842521694217]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [event] = &apos;s8_2_postponers_postponed&apos; THEN [vendors] ELSE 0 END)/SUM(IF [event] = &apos;s8_postponed_vendors&apos; THEN [vendors] ELSE 0 END)' />
