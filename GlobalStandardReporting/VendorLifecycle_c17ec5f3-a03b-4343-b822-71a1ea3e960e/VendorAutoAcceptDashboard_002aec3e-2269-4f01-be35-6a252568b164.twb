  <worksheets>
    <worksheet name='AA Tabular'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='12'>Auto Accept Vendors Performance over Time</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='vendor_gsr_auto_accept_over_time (van)' name='federated.1ko5iyd0e3yc6m1b1wm5h192uq7k' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose Tabular View' datatype='string' name='[Choose Date Granularity (copy 2)]' param-domain-type='list' role='measure' type='nominal' value='&quot;Before After Comparison (B)&quot;'>
              <calculation class='tableau' formula='&quot;Before After Comparison (B)&quot;' />
            </column>
            <column caption='Choose Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ko5iyd0e3yc6m1b1wm5h192uq7k'>
            <column caption='Avg. #Orders per Vendor' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1633258605372665856]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders])/ [Calculation_6858841547723370511]' />
            </column>
            <column caption='_choose_tabular_view' datatype='boolean' name='[Calculation_3501970976481927172]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Choose Date Granularity (copy 2)] = &apos;Auto Accept Performance Over Time (A)&apos; THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='_cohort_vendor_v2' datatype='integer' name='[Calculation_6385963588931305473]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Calculation_6858841547638530048], [order_date_local]: &#10;MIN(IF [order_date_local] = {EXCLUDE [order_date_local]: MIN([order_date_local])} THEN 1 ELSe 0 END)}' />
            </column>
            <column caption='_Running_SUM vendors' datatype='integer' name='[Calculation_6385963588934754308]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM(SUM([Calculation_6385963588931305473]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Vendor' datatype='string' name='[Calculation_6858841547638530048]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[entity_id]+[vendor_code]' />
            </column>
            <column caption='Order Date' datatype='string' name='[Calculation_6858841547643707393]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Daily&apos; &#10;  THEN STR([order_date_local])&#10;ELSEIF  [Parameters].[Parameter 1] = &apos;Weekly&apos; &#10;  THEN STR([order_week])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Monthly&apos; &#10;  THEN STR([order_month])&#10;END' />
            </column>
            <column caption='_is_auto_accept' datatype='boolean' name='[Calculation_6858841547661803522]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [days_since_auto_accept] &gt;= 0 THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='At Vendor Time Cleaned (mins)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6858841547698315267]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_at_vendor_time_cleaned])/(SUM([count_at_vendor_time_cleaned])*60)' />
            </column>
            <column caption='Delivery Time (mins)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6858841547700748292]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_actual_delivery_time])/(SUM([count_delivery_time])*60)' />
            </column>
            <column caption='% Fail Rate' datatype='real' name='[Calculation_6858841547701022725]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_orders])/SUM([orders])' />
            </column>
            <column caption='% Vendor Fail Rate' datatype='real' name='[Calculation_6858841547701420038]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vendor_fail_orders])/ sum([orders])' />
            </column>
            <column caption='% On Time Orders' datatype='real' name='[Calculation_6858841547701620743]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([on_time_orders])/SUM([orders])' />
            </column>
            <column caption='% Contact Rate [V]' datatype='real' default-format='p0.0%' name='[Calculation_6858841547701989384]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_contact_ind_orders])/SUM([orders])' />
            </column>
            <column caption='% Contact Rate [C]' datatype='real' name='[Calculation_6858841547702652937]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([customer_contact_ind_orders])/SUM([orders])' />
            </column>
            <column caption='Avg. Closed Hours' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6858841547702812682]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_offline_duration]/3600)/COUNTD([Calculation_6858841547638530048])' />
            </column>
            <column caption='Avg. Closed Mins due to Vendor Busy' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6858841547703037963]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_too_busy_kitchen_duration]/60)/COUNTD([Calculation_6858841547638530048])' />
            </column>
            <column caption='% Vendor Late Over 10' datatype='real' name='[Calculation_6858841547715035148]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_10_orders])/SUM([vendor_late_orders])' />
            </column>
            <column caption='# Vendors' datatype='integer' name='[Calculation_6858841547723370511]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_6858841547638530048])' />
            </column>
