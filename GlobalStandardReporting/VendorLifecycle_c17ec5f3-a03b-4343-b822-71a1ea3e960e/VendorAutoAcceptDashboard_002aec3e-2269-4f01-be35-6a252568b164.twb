            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='integer' name='[customer_contact_ind_orders]' role='measure' type='quantitative' />
            <column aggregation='Sum' datatype='integer' name='[days_since_auto_accept]' role='dimension' type='ordinal' />
            <column caption='Entity Id' datatype='string' name='[entity_id]' role='dimension' type='nominal' />
