  <dashboards>
    <dashboard name='Auto Accept Before &amp; After'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/Vendor-AutoAcceptDashboard/AutoAcceptBeforeAfter?rev=' id='AutoAcceptBeforeAfter' path='/t/GlobalStandardReporting/workbooks/Vendor-AutoAcceptDashboard' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='dash-text'>
          <format attr='vertical-align' id='dash-text_32' value='top' />
          <format attr='vertical-align' id='dash-text_33' value='top' />
          <format attr='vertical-align' id='dash-text_34' value='top' />
