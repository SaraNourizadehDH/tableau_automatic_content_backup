    <worksheet name='Cohort [%] [Line]'>
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='vendor_gsr_auto_accept_over_time (van)' name='federated.1ko5iyd0e3yc6m1b1wm5h192uq7k' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose View' datatype='string' name='[Choose Cohort Granularity (copy 2)]' param-domain-type='list' role='measure' type='nominal' value='&quot;Number&quot;'>
              <calculation class='tableau' formula='&quot;Number&quot;' />
            </column>
            <column caption='t-dimension Granularity' datatype='string' name='[Choose Cohort Granularity (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
            <column caption='Number of Cohorts' datatype='string' name='[Choose Date Granularity (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;28 Days&quot;'>
              <calculation class='tableau' formula='&quot;28 Days&quot;' />
            </column>
            <column alias='% Fail Rate' caption='Choose Metric' datatype='string' name='[Fir After Dropped Off Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Fail Rate&quot;'>
              <calculation class='tableau' formula='&quot;Fail Rate&quot;' />
              <aliases>
                <alias key='&quot;Contact Rate [C]&quot;' value='% Contact Rate [C]' />
                <alias key='&quot;Contact Rate [V]&quot;' value='% Contact Rate [V]' />
                <alias key='&quot;Fail Rate&quot;' value='% Fail Rate' />
                <alias key='&quot;On Time Order Rate&quot;' value='% On Time Order Rate' />
                <alias key='&quot;Vendor Fail Rate&quot;' value='% Vendor Fail Rate' />
                <alias key='&quot;Vendor Late Over 10&quot;' value='% Vendor Late Over 10' />
              </aliases>
            </column>
            <column caption='Choose Cohort Granularity' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ko5iyd0e3yc6m1b1wm5h192uq7k'>
            <column caption='Cohort' datatype='string' name='[Calculation_1375286789157339136]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;Daily&apos; &#10;  THEN STR([cohort_date])&#10;ELSEIF  [Parameters].[Parameter 2] = &apos;Weekly&apos; &#10;  THEN STR(DATEPART(&apos;year&apos;, DATETRUNC(&apos;week&apos;, [cohort_date]))) +&apos;-&apos; + (IF(DATEPART(&apos;week&apos;,DATETRUNC(&apos;week&apos;, [cohort_date])) &lt; 10) THEN &apos;0&apos;+STR(DATEPART(&apos;week&apos;,DATETRUNC(&apos;week&apos;, [cohort_date])))&#10;    ELSE STR(DATEPART(&apos;week&apos;,DATETRUNC(&apos;week&apos;, [cohort_date]))) END)&#10;END' />
            </column>
            <column caption='Metric' datatype='real' default-format='*#,##0.0;0.0%' name='[Calculation_1447344383207489536]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Fir After Dropped Off Parameter]&#10;WHEN &apos;Fail Rate&apos; THEN [Calculation_6858841547701022725]&#10;WHEN &apos;Vendor Fail Rate&apos; THEN [Calculation_6858841547701420038]&#10;WHEN &apos;Vendor Late Over 10&apos; THEN [Calculation_6858841547715035148]&#10;WHEN &apos;On Time Order Rate&apos; THEN [Calculation_6858841547701620743]&#10;WHEN &apos;At Vendor Time Cleaned&apos; THEN [Calculation_6858841547698315267]&#10;WHEN &apos;Delivery Time&apos; THEN [Calculation_6858841547700748292]&#10;WHEN &apos;Contact Rate [V]&apos; THEN [Calculation_6858841547701989384]&#10;WHEN &apos;Contact Rate [C]&apos; THEN [Calculation_6858841547702652937]&#10;WHEN &apos;Avg. Closed Hours&apos; THEN [Calculation_6858841547702812682]&#10;WHEN &apos;Avg. Closed Mins due to Vendor Busy&apos; THEN [Calculation_6858841547703037963]&#10;WHEN &apos;# Vendors&apos; THEN [Calculation_6858841547723370511]&#10;END' />
            </column>
            <column caption='_View' datatype='string' name='[Calculation_1447344383224504321]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Fir After Dropped Off Parameter]' />
            </column>
            <column caption='_choose_view' datatype='boolean' name='[Calculation_3501970976405405696]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Choose Cohort Granularity (copy 2)]&#10; WHEN &apos;Line Chart&apos; THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Vendor' datatype='string' name='[Calculation_6858841547638530048]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[entity_id]+[vendor_code]' />
            </column>
            <column caption='At Vendor Time Cleaned (mins)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6858841547698315267]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_at_vendor_time_cleaned])/(SUM([count_at_vendor_time_cleaned])*60)' />
            </column>
            <column caption='Delivery Time (mins)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6858841547700748292]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_actual_delivery_time])/(SUM([count_delivery_time])*60)' />
            </column>
            <column caption='% Fail Rate' datatype='real' name='[Calculation_6858841547701022725]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_orders])/SUM([orders])' />
            </column>
            <column caption='% Vendor Fail Rate' datatype='real' name='[Calculation_6858841547701420038]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vendor_fail_orders])/ sum([orders])' />
            </column>
            <column caption='% On Time Orders' datatype='real' name='[Calculation_6858841547701620743]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([on_time_orders])/SUM([orders])' />
            </column>
            <column caption='% Contact Rate [V]' datatype='real' default-format='p0.0%' name='[Calculation_6858841547701989384]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_contact_ind_orders])/SUM([orders])' />
            </column>
            <column caption='% Contact Rate [C]' datatype='real' name='[Calculation_6858841547702652937]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([customer_contact_ind_orders])/SUM([orders])' />
            </column>
            <column caption='Avg. Closed Hours' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6858841547702812682]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_offline_duration]/3600)/COUNTD([Calculation_6858841547638530048])' />
            </column>
            <column caption='Avg. Closed Mins due to Vendor Busy' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6858841547703037963]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_too_busy_kitchen_duration]/60)/COUNTD([Calculation_6858841547638530048])' />
            </column>
            <column caption='% Vendor Late Over 10' datatype='real' name='[Calculation_6858841547715035148]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_10_orders])/SUM([vendor_late_orders])' />
            </column>
            <column caption='_cohort_filter' datatype='boolean' name='[Calculation_6858841547716952077]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Choose Date Granularity (copy)]&#10;  WHEN &apos;7 Days&apos; THEN [days_since_auto_accept] &lt;= 6 AND [days_since_auto_accept] &gt;= -7&#10;  WHEN &apos;14 Days&apos; THEN [days_since_auto_accept] &lt;= 13 AND [days_since_auto_accept] &gt;= -14&#10;  WHEN &apos;28 Days&apos; THEN [days_since_auto_accept] &lt;= 27 AND [days_since_auto_accept] &gt;= -28&#10;END' />
            </column>
            <column caption='t-dimension' datatype='string' name='[Calculation_6858841547721093134]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Choose Cohort Granularity (copy)]&#10;WHEN  &apos;Daily&apos; THEN &#10;&apos;T &apos;+STR([days_since_auto_accept])&#10;WHEN &apos;Weekly&apos; THEN &#10;&apos;T &apos; +STR([weeks_since_auto_accept])&#10;END' />
            </column>
            <column caption='# Vendors' datatype='integer' name='[Calculation_6858841547723370511]' role='measure' type='quantitative'>
