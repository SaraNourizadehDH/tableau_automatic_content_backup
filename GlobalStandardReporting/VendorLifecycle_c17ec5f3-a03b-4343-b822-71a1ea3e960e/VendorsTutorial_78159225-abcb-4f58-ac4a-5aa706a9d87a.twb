          <datasource-dependencies datasource='Parameters'>
            <column caption='Dimension A' datatype='string' name='[Choose Dimension to show (copy)_814096025135124480]' param-domain-type='list' role='measure' type='nominal' value='&quot;Region&quot;'>
              <calculation class='tableau' formula='&quot;Region&quot;' />
            </column>
            <column caption='Dimension B' datatype='string' name='[Dimension A (copy)_814096025142210566]' param-domain-type='list' role='measure' type='nominal' value='&quot;Brand&quot;'>
              <calculation class='tableau' formula='&quot;Brand&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1k1zrjk0w6ib3o104wur905r05mc'>
            <column caption='# Avg Daily New Client Vendors (Regional)' datatype='real' name='[# Avg Daily Vendors (Regional) (copy)_728105417981325350]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([new_client_vendors_ct])&#10;/(DATEDIFF(&apos;day&apos;, MIN([created_date_local]), TODAY()))' />
            </column>
            <column caption='# Avg Daily Vendors (Regional)' datatype='real' name='[# Avg Daily Vendors (copy)_728105417691734020]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_ct])/(DATEDIFF(&apos;day&apos;, MIN([created_date_local]), TODAY()))' />
            </column>
            <column caption='# Avg Daily Vendors using Guided Tutorials Flow - Accept Order (Regional) ' datatype='real' name='[# Avg Daily Vendors using Guided Tutorials (Regional)  (copy)_728105418010157095]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_using_guided_tutorial_flow_accept_order_ct])/(DATEDIFF(&apos;day&apos;, MIN([created_date_local]), TODAY()))' />
            </column>
            <column caption='# Avg Daily Vendors using Guided Tutorials Flow - Decline Order (Regional)' datatype='real' name='[# Avg Daily Vendors using Guided Tutorials Flow - Accept Order (Regional)  (copy)_728105418010316840]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_using_guided_tutorial_flow_decline_order_ct])/(DATEDIFF(&apos;day&apos;, MIN([created_date_local]), TODAY()))' />
            </column>
            <column caption='# Avg Daily Vendors using Guided Tutorials Flow - Dispatch Order (Regional)' datatype='real' name='[# Avg Daily Vendors using Guided Tutorials Flow - Decline Order (Regional) (copy)_728105418010415145]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_using_guided_tutorial_flow_dispatch_order_ct])/(DATEDIFF(&apos;day&apos;, MIN([created_date_local]), TODAY()))' />
            </column>
            <column caption='# Avg Daily Vendors using Guided Tutorials Flow - Vendor Availability (Regional) ' datatype='real' name='[# Avg Daily Vendors using Guided Tutorials Flow - Dispatch Order (Regional) (copy)_728105418010488874]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_using_guided_tutorial_flow_vendor_availability_ct])/(DATEDIFF(&apos;day&apos;, MIN([created_date_local]), TODAY()))' />
            </column>
            <column caption='# Avg Daily Vendors using Guided Tutorials (Regional) ' datatype='real' name='[# Avg Daily Vendors using Test Order (Regional) (copy)_728105417693888519]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_using_guided_tutorial_ct])/(DATEDIFF(&apos;day&apos;, MIN([created_date_local]), TODAY()))' />
            </column>
            <column caption='% Tutorial Guided Tutorial Flow Ended - Decline Order' datatype='real' name='[% Tutorial Onboarding Guided Tutorial Flow Ended - Accept Order (copy)_523613837922414614]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([tutorial_guided_tutorial_flow_decline_order_ended_ct])/SUM([tutorial_guided_tutorial_flow_decline_order_started_ct])' />
            </column>
            <column caption='% Tutorial Guided Tutorial Flow Ended - Dispatch Order' datatype='real' name='[% Tutorial Onboarding Guided Tutorial Flow Ended - Decline Order (copy)_523613837922480151]' role='measure' type='quantitative'>
