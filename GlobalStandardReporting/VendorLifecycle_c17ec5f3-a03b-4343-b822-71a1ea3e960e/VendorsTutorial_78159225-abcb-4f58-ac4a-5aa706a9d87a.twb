          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose bin size - Late Self Activation' datatype='real' name='[Choose bin size - Self Activation (copy)_398568613398994945]' param-domain-type='any' role='measure' type='quantitative' value='24.0'>
              <calculation class='tableau' formula='24.0' />
            </column>
            <column caption='Choose max bin - Late Self Activation' datatype='integer' datatype-customized='true' name='[Choose max bin - Self Activation (copy)_398568613399048194]' param-domain-type='range' role='measure' type='quantitative' value='40320'>
              <calculation class='tableau' formula='40320' />
              <range granularity='60' max='40320' min='60' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1k1zrjk0w6ib3o104wur905r05mc'>
            <column caption='% Running Sum (Late Self Activations)' datatype='real' name='[Calculation1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM([Calculation_398568613411233803])&#10;/TOTAL([Calculation_398568613411233803])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='# Late Self Activations' datatype='integer' name='[Calculation_398568613411233803]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Since the rl table behind is on Vendor &amp; daily level, SUM of Vendors is the usage of the component here&#10;SUM([vendors_using_self_activation_component_activate_ct])' />
            </column>
            <column caption='_NOT TODAY' datatype='boolean' name='[Calculation_523613837930233883]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[created_date_local] &lt;&gt; TODAY()' />
            </column>
            <column caption='_IS Clean data only' datatype='boolean' name='[_NOT TODAY (copy)_728105417979367461]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([created_date_local]) &gt;= &apos;2021-03-09&apos;' />
