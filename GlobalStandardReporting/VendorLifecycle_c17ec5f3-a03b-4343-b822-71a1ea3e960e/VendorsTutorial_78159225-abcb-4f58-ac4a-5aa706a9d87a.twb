            <column caption='# Avg Daily Vendors using Test Order (Regional)' datatype='real' name='[# Avg Daily Vendors using Intro Screens (Regional) (copy)_728105417692868614]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_using_test_order_ct])/(DATEDIFF(&apos;day&apos;, MIN([created_date_local]), TODAY()))' />
