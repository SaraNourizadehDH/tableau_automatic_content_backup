    <worksheet name='Usage Trend'>
      <table>
        <view>
          <datasources>
            <datasource caption='vendor_gsr_tutorial_dashboard_usage (rl)' name='federated.1k1zrjk0w6ib3o104wur905r05mc' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[created_week Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1k1zrjk0w6ib3o104wur905r05mc'>
            <column caption='# Avg Daily Vendors using Intro Screens ' datatype='real' name='[# Avg Daily Vendors (copy)_728105417699319822]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[created_week Parameter] = &apos;Daily&apos;&#10;    THEN SUM([vendors_using_intro_screens_ct])&#10;ELSEIF [Parameters].[created_week Parameter] = &apos;Weekly&apos;&#10;    THEN SUM([vendors_using_intro_screens_ct])/7&#10;ELSEIF [Parameters].[created_week Parameter] = &apos;Monthly&apos;&#10;    THEN SUM([vendors_using_intro_screens_ct])/30&#10;END' />
            </column>
            <column caption='# Avg Daily New Client Vendors' datatype='real' name='[# Avg Daily Vendors (copy)_728105417979101220]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[created_week Parameter] = &apos;Daily&apos;&#10;    THEN SUM([new_client_vendors_ct])&#10;ELSEIF [Parameters].[created_week Parameter] = &apos;Weekly&apos;&#10;    THEN SUM([new_client_vendors_ct])/7&#10;ELSEIF [Parameters].[created_week Parameter] = &apos;Monthly&apos;&#10;    THEN SUM([new_client_vendors_ct])/30&#10;END' />
            </column>
            <column caption='# Avg Daily Vendors using Test Order ' datatype='real' name='[# Avg Daily Vendors using Intro Screens  (copy)_728105417702518799]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[created_week Parameter] = &apos;Daily&apos;&#10;    THEN SUM([vendors_using_test_order_ct])&#10;ELSEIF [Parameters].[created_week Parameter] = &apos;Weekly&apos;&#10;    THEN SUM([vendors_using_test_order_ct])/7&#10;ELSEIF [Parameters].[created_week Parameter] = &apos;Monthly&apos;&#10;    THEN SUM([vendors_using_test_order_ct])/30&#10;END' />
            </column>
            <column caption='# Avg Daily Vendors using Self Activation ' datatype='real' name='[# Avg Daily Vendors using Intro Screens  (copy)_728105417705504789]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[created_week Parameter] = &apos;Daily&apos;&#10;    THEN SUM([vendors_using_self_activation_ct])&#10;ELSEIF [Parameters].[created_week Parameter] = &apos;Weekly&apos;&#10;    THEN SUM([vendors_using_self_activation_ct])/7&#10;ELSEIF [Parameters].[created_week Parameter] = &apos;Monthly&apos;&#10;    THEN SUM([vendors_using_self_activation_ct])/30&#10;END' />
            </column>
            <column caption='# Avg Daily Vendors using Guided Tutorials' datatype='real' name='[# Avg Daily Vendors using Test Order  (copy)_728105417702748176]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[created_week Parameter] = &apos;Daily&apos;&#10;    THEN SUM([vendors_using_guided_tutorial_ct])&#10;ELSEIF [Parameters].[created_week Parameter] = &apos;Weekly&apos;&#10;    THEN SUM([vendors_using_guided_tutorial_ct])/7&#10;ELSEIF [Parameters].[created_week Parameter] = &apos;Monthly&apos;&#10;    THEN SUM([vendors_using_guided_tutorial_ct])/30&#10;END' />
            </column>
            <column caption='# Tutorial Self Activation Screen Shown' datatype='integer' name='[Calculation_4640044661972631552]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[tutorial_self_activation_screen_activate_ct]&#10;+ [tutorial_self_activation_screen_skip_ct]&#10;+ [tutorial_self_activation_fail_ct]' />
            </column>
            <column caption='t-dimension' datatype='string' name='[Calculation_523613837879599104]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[created_week Parameter] &#10;    WHEN &apos;Daily&apos;&#10;        THEN STR([created_date_local])&#10;    WHEN &apos;Weekly&apos;&#10;        THEN [created_week]&#10;    WHEN &apos;Monthly&apos;&#10;        THEN [created_month]&#10;END' />
            </column>
            <column caption='_NOT TODAY' datatype='boolean' name='[Calculation_523613837930233883]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[created_date_local] &lt;&gt; TODAY()' />
            </column>
            <column caption='# Avg Daily Vendors' datatype='real' name='[Calculation_728105417689305091]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[created_week Parameter] = &apos;Daily&apos;&#10;    THEN SUM([vendors_ct])&#10;ELSEIF [Parameters].[created_week Parameter] = &apos;Weekly&apos;&#10;    THEN SUM([vendors_ct])/7&#10;ELSEIF [Parameters].[created_week Parameter] = &apos;Monthly&apos;&#10;    THEN SUM([vendors_ct])/30&#10;END' />
            </column>
            <column caption='_IS Clean data only' datatype='boolean' name='[_NOT TODAY (copy)_728105417979367461]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([created_date_local]) &gt;= &apos;2021-03-09&apos;' />
            </column>
