              <calculation class='tableau' formula='CASE [Parameters].[Dimension B (copy)_814096025137123332]&#10;    WHEN &apos;# Avg Daily Vendors&apos;&#10;        THEN [Calculation_728105417689305091]&#10;    WHEN &apos;# Avg Daily New Clients Vendors&apos;&#10;        THEN [# Avg Daily Vendors (copy)_728105417979101220]&#10;    WHEN &apos;# Avg Daily Vendors using Intro Screens&apos;&#10;        THEN [# Avg Daily Vendors (copy)_728105417699319822]&#10;    WHEN &apos;# Avg Daily Vendors using Test Orders&apos;&#10;        THEN [# Avg Daily Vendors using Intro Screens  (copy)_728105417702518799]&#10;    WHEN &apos;# Avg Daily Vendors using Guided Tutorial&apos;&#10;        THEN [# Avg Daily Vendors using Test Order  (copy)_728105417702748176]&#10;    WHEN &apos;# Avg Daily Vendors using Self Activation&apos;&#10;        THEN [# Avg Daily Vendors using Intro Screens  (copy)_728105417705504789]&#10;    WHEN &apos;# Login Events&apos;&#10;        THEN SUM([login_events_ct])&#10;    WHEN &apos;# Tutorial Intro Screens launched&apos;&#10;        THEN SUM([tutorial_intro_screens_launch_ct])&#10;    WHEN &apos;# Tutorial Test Order button clicked&apos;&#10;        THEN SUM([tutorial_test_order_button_clicked_ct])&#10;    WHEN &apos;# Tutorial Guided Tutorial Started&apos;&#10;        THEN SUM([tutorial_guided_tutorial_started_ct])&#10;    WHEN &apos;# Tutorial Guided Tutorial Flow Started - Accept Order&apos;&#10;        THEN SUM([tutorial_guided_tutorial_flow_accept_order_started_ct])&#10;    WHEN &apos;# Tutorial Guided Tutorial Flow Started - Decline Order&apos;&#10;        THEN SUM([tutorial_guided_tutorial_flow_decline_order_started_ct])&#10;    WHEN &apos;# Tutorial Guided Tutorial Flow Started - Dispatch Order&apos;&#10;        THEN SUM([tutorial_guided_tutorial_flow_dispatch_order_started_ct])&#10;    WHEN &apos;# Tutorial Guided Tutorial Flow Started - Vendor Availability&apos;&#10;        THEN SUM([tutorial_guided_tutorial_flow_vendor_availability_started_ct])