              <calculation class='tableau' formula='[tutorial_self_activation_screen_activate_ct]&#10;+ [tutorial_self_activation_screen_skip_ct]&#10;+ [tutorial_self_activation_fail_ct]' />
            </column>
            <column caption='t-dimension' datatype='string' name='[Calculation_523613837879599104]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[created_week Parameter] &#10;    WHEN &apos;Daily&apos;&#10;        THEN STR([created_date_local])&#10;    WHEN &apos;Weekly&apos;&#10;        THEN [created_week]&#10;    WHEN &apos;Monthly&apos;&#10;        THEN [created_month]&#10;END' />
            </column>
            <column caption='% Tutorial Test Order Success Shown' datatype='real' name='[Calculation_523613837901541378]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([tutorial_test_order_success_shown_ct])/SUM([tutorial_test_order_button_clicked_ct])' />
            </column>
            <column caption='% Tutorial Intro Screens Delivery Type Selected - OD' datatype='real' name='[Calculation_523613837901869059]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([tutorial_intro_screens_delivery_type_selected_od_ct])/ SUM([tutorial_intro_screens_delivery_type_selected_ct])' />
            </column>
            <column caption='% Tutorial Guided Tutorial Flow Ended' datatype='real' name='[Calculation_523613837903925255]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([tutorial_guided_tutorial_flow_ended_ct])/SUM([tutorial_guided_tutorial_flow_started_ct])' />
            </column>
            <column caption='% Tutorial Guided Tutorial Flow Ended - Accept Order' datatype='real' name='[Calculation_523613837922283541]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([tutorial_guided_tutorial_flow_accept_order_ended_ct])/SUM([tutorial_guided_tutorial_flow_accept_order_started_ct])' />
            </column>
            <column caption='% Tutorial Intro Screens Language Selected - English' datatype='real' name='[Calculation_523613837926182937]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([tutorial_intro_screens_language_selected_english_ct])/SUM([tutorial_intro_screens_language_selected_ct])' />
            </column>
            <column caption='% Tutorial Intro Screens Language Selected - Chinese' datatype='real' name='[Calculation_523613837927637018]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([tutorial_intro_screens_language_selected_chinese_traditional_ct])/SUM([tutorial_intro_screens_language_selected_ct])' />
            </column>
            <column caption='_NOT TODAY' datatype='boolean' name='[Calculation_523613837930233883]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[created_date_local] &lt;&gt; TODAY()' />
            </column>
            <column caption='# Tutorial Intro Screens Language Selected - Others' datatype='integer' name='[Calculation_523613837946679324]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[tutorial_intro_screens_language_selected_ct]&#10;- [tutorial_intro_screens_language_selected_english_ct]&#10;- [tutorial_intro_screens_language_selected_chinese_traditional_ct]' />
            </column>
            <column caption='% Tutorial Intro Screens Language Selected - Others' datatype='real' name='[Calculation_523613837946818589]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_523613837946679324])/SUM([tutorial_intro_screens_language_selected_ct])' />
            </column>
            <column caption='% Tutorial Guided Tutorial Ended' datatype='real' name='[Calculation_523613837955936287]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([tutorial_guided_tutorial_ended_ct])/SUM([tutorial_guided_tutorial_started_ct])' />
            </column>
            <column caption='% Tutorial Self Activation Screen Skip' datatype='real' name='[Calculation_523613837960871968]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([tutorial_self_activation_screen_skip_ct])&#10;/SUM([Calculation_4640044661972631552])' />
            </column>
            <column caption='% Tutorial Self Activation Component Activated' datatype='real' name='[Calculation_523613837962428450]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([tutorial_self_activation_component_activate_ct])/SUM([tutorial_self_activation_component_shown_ct])' />
            </column>
            <column caption='% Tutorial Guided Tutorial Failed' datatype='real' name='[Calculation_523613837965877287]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([tutorial_guided_tutorial_failed_ct])/SUM([tutorial_guided_tutorial_started_ct])' />
