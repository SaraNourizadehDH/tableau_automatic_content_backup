            <column caption='% Tutorial Intro Screens Ended' datatype='real' name='[Calculation_728105417351372800]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([tutorial_intro_screens_intro_screens_ended])/SUM([tutorial_intro_screens_launch_ct])' />
