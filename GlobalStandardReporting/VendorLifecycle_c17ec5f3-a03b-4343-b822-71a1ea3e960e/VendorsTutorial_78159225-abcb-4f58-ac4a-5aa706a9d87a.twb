          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose Dimension to show' datatype='string' name='[Date Granularity (copy)_728105417605861377]' param-domain-type='list' role='measure' type='nominal' value='&quot;regional dimension (Vendors)&quot;'>
              <calculation class='tableau' formula='&quot;regional dimension (Vendors)&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1k1zrjk0w6ib3o104wur905r05mc'>
            <column caption='# Avg Daily Vendors using Intro Screens (Regional)' datatype='real' name='[# Avg Daily Vendors (Regional) (copy)_728105417692483589]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_using_intro_screens_ct])/(DATEDIFF(&apos;day&apos;, MIN([created_date_local]), TODAY()))' />
            </column>
            <column caption='# Avg Daily New Client Vendors (Regional)' datatype='real' name='[# Avg Daily Vendors (Regional) (copy)_728105417981325350]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([new_client_vendors_ct])&#10;/(DATEDIFF(&apos;day&apos;, MIN([created_date_local]), TODAY()))' />
            </column>
            <column caption='# Avg Daily Vendors (Regional)' datatype='real' name='[# Avg Daily Vendors (copy)_728105417691734020]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_ct])/(DATEDIFF(&apos;day&apos;, MIN([created_date_local]), TODAY()))' />
            </column>
            <column caption='# Avg Daily Vendors using Self Activation (Regional) ' datatype='real' name='[# Avg Daily Vendors using Guided Tutorial (Regional)  (copy)_728105417695305736]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_using_self_activation_ct])/(DATEDIFF(&apos;day&apos;, MIN([created_date_local]), TODAY()))' />
