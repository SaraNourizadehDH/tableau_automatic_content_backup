      </datasource-dependencies>
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98770' id='138' param='horz' type-v2='layout-flow' w='98858' x='571' y='615'>
            <zone h='98770' id='136' type-v2='layout-basic' w='98858' x='571' y='615'>
              <zone h='88923' id='8' param='horz' type-v2='layout-flow' w='98858' x='571' y='10462'>
                <zone h='88923' id='6' type-v2='layout-basic' w='98858' x='571' y='10462'>
                  <zone h='28184' id='12' name='all in table view' show-title='false' w='37143' x='571' y='13769'>
                    <zone-style>
                      <format attr='border-color' value='#d4d4d4' />
                      <format attr='border-style' value='solid' />
                      <format attr='border-width' value='1' />
                      <format attr='margin' value='4' />
                    </zone-style>
