      <aliases enabled='yes' />
      <column caption='Warehouse Count' datatype='integer' name='[Calculation_2834945616757682176]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([warehouse_id])' />
      </column>
      <column caption='closed or live' datatype='string' name='[Calculation_3108891142025121793]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_5814921199807127552] = &quot;Dmart Live&quot; THEN &quot;store live&quot; &#10;ELSE IF [Calculation_5814921199807127552] = &quot;Permanently Closed&quot; Then &quot;closed&quot; &#10;ELSE IF [Calculation_5814921199807127552] = &quot;temporarily closed&quot; Then &quot;closed&quot;&#10;ELSE &quot;others&quot; END END END' />
      </column>
      <column caption='Overall number of stores in the month end' datatype='integer' name='[Calculation_3108891142041411590]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP((ZN([Calculation_3522237161287335937])),LAST()) - LOOKUP(ZN(([Calculation_3522237161287335937])),FIRST())'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Live stores at the beginning of a month' datatype='integer' name='[Calculation_3108891142156861452]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL(Lookup( [Calculation_3108891142342828047], -1)) THEN Lookup( [Calculation_3108891142342828047], -2) ELSE Lookup( [Calculation_3108891142342828047], -1) END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='live-perstatus' datatype='integer' name='[Calculation_3108891142173044750]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[no_live_status]-[no_permanently_closed_status]' />
      </column>
      <column caption='C Calculated' datatype='integer' name='[Calculation_3108891142342828047]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_3108891142173044750]) + PREVIOUS_VALUE(0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Store Status Calculated' datatype='string' name='[Calculation_3451235086328442880]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Calculation_5814921199807127552] WHEN &quot;Property Identified stores&quot; THEN &quot;Property Identified Stores&quot;&#10;WHEN &quot;Legal and Ops Reviewed stores&quot; THEN &quot;Legal and Ops Reviewed Stores&quot;&#10;WHEN &quot;in Contract Negotiation status&quot; THEN &quot;Contract Negotiation Status&quot;&#10;WHEN &quot;under Construction&quot; THEN &quot;Under Construction&quot;&#10;WHEN &quot;stores in Set-up and Inbounding status&quot; THEN &quot;Set-up and Inbounding&quot;&#10;WHEN &quot;opened stores&quot; THEN &quot;Opened Stores&quot;&#10;WHEN &quot;Permanently Closed stores&quot; THEN &quot;Permanently Closed Stores&quot;&#10;WHEN &quot;Rejected stores&quot; THEN &quot;Rejected Stores&quot;&#10;ELSE &quot;Others&quot;&#10;END' />
      </column>
      <column caption='Number of stores per month c' datatype='integer' name='[Calculation_3522237161287335937]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([store_id])' />
      </column>
      <column caption='Store Count' datatype='integer' name='[Calculation_3619346028263387136]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([store_id])' />
      </column>
      <column caption='Store Status' datatype='string' name='[Calculation_5814921199807127552]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [store_status] WHEN &quot;Construction&quot; THEN &quot;under Construction&quot;&#10;WHEN &quot;Contract Negotiation&quot; THEN &quot;in Contract Negotiation status&quot;&#10;WHEN &quot;Dmart Live&quot; THEN &quot;opened stores&quot;&#10;WHEN &quot;Legal and Ops Review&quot; THEN &quot;Legal and Ops Reviewed stores&quot;&#10;WHEN &quot;Permanently Closed&quot; THEN &quot;Permanently Closed stores&quot;&#10;WHEN &quot;Property Identification&quot; THEN &quot;Property Identified stores&quot;&#10;WHEN &quot;Rejected&quot; THEN &quot;Rejected stores&quot;&#10;WHEN &quot;Store Set-up and Inbounding&quot; THEN &quot;stores in Set-up and Inbounding status&quot;&#10;ELSE &quot;Others&quot;&#10;END' />
      </column>
      <column caption='Dmart Live Calculated' datatype='integer' name='[Calculation_6481242851471888386]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_3108891142025121793] = &quot;Dmart Live&quot; THEN 1 ELSE 0 END)' />
      </column>
