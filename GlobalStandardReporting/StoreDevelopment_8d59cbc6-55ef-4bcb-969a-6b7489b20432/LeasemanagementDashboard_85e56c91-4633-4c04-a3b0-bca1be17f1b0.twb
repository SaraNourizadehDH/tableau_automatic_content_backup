              <calculation class='tableau' formula='IF [Calculation_600315824745865258] &gt; SUM({ FIXED [City]:[Calculation_600315824745865258]}) THEN 1 ELSE 0 END' />
            </column>
            <column caption='% of Stores RSQM &gt; City RSQM Avg' datatype='real' name='[Calculation_4084553824443179019]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([City level])/COUNTD([Record ID])' />
