    <worksheet name='kpis map'>
      <table>
        <view>
          <datasources>
            <datasource caption='choice_index_geo_level (rl)' name='federated.1hczb1e0me1z471e5efvf0hcd24i' />
            <datasource name='Parameters' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='CVR' caption='Choose KPI - Map' datatype='integer' datatype-customized='true' name='[Choose KPI (1) (copy)_6641894681413439490]' param-domain-type='list' role='measure' type='quantitative' value='7'>
              <calculation class='tableau' formula='7' />
              <aliases>
                <alias key='1' value='Choice Index' />
                <alias key='2' value='Density Score' />
                <alias key='3' value='Popularity Score' />
                <alias key='4' value='Variety Score' />
                <alias key='5' value='Vendor Count' />
                <alias key='6' value='Main Cuisines Count' />
                <alias key='7' value='CVR' />
                <alias key='8' value='Sessions' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1hczb1e0me1z471e5efvf0hcd24i'>
            <column caption='Sessions' datatype='integer' name='[Calculation_1783636600363728896]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([sessions],0)' />
            </column>
            <column caption='CVR' datatype='real' name='[Calculation_4672625392284463105]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM([sessions_with_transaction])/SUM([sessions]),0)' />
            </column>
            <column caption='Vendor Count Max Country' datatype='integer' name='[Calculation_504543936144965632]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [country_name]: MAX([vendor_count])}' />
            </column>
            <column caption='Vendor Count as % of Country' datatype='real' name='[Calculation_504543936145170433]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[vendor_count]/[Calculation_504543936144965632]' />
            </column>
            <column caption='Longitude' datatype='real' datatype-customized='true' name='[Calculation_5305099647952039940]' role='dimension' semantic-role='[Geographical].[Longitude]' type='ordinal'>
              <calculation class='tableau' formula='FLOAT([long_l9])' />
            </column>
            <column caption='Latitude' datatype='real' datatype-customized='true' name='[Calculation_5305099647952396293]' role='dimension' semantic-role='[Geographical].[Latitude]' type='ordinal'>
              <calculation class='tableau' formula='FLOAT([lat_l9])' />
            </column>
            <column caption='Point Id' datatype='integer' name='[Calculation_5514446661898760192]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[point_id_l9]' />
            </column>
            <column caption='KPI - Color Map' datatype='real' default-format='n#,##0;-#,##0' name='[KPI (copy)_504543936145301506]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Choose KPI (1) (copy)_6641894681413439490] = 1&#10;  THEN avg([choice_index])&#10;ELSEIF [Parameters].[Choose KPI (1) (copy)_6641894681413439490] = 2&#10;  THEN avg([density_score])&#10;ELSEIF [Parameters].[Choose KPI (1) (copy)_6641894681413439490] = 3&#10;  THEN avg([popularity_score])&#10;ELSEIF [Parameters].[Choose KPI (1) (copy)_6641894681413439490] = 4&#10;  THEN avg([variety_score])&#10;ELSEIF [Parameters].[Choose KPI (1) (copy)_6641894681413439490] = 5&#10;  THEN avg([Calculation_504543936145170433])&#10;ELSEIF [Parameters].[Choose KPI (1) (copy)_6641894681413439490] = 6&#10;  THEN avg([Vendor Count as % of Country (copy)_504543936145862660])&#10;ELSEIF [Parameters].[Choose KPI (1) (copy)_6641894681413439490] = 7&#10;  THEN avg([sessions_with_transaction]/[sessions])&#10;ELSEIF [Parameters].[Choose KPI (1) (copy)_6641894681413439490] = 8&#10;  THEN avg([Calculation_1783636600363728896])&#10;ENd' />
            </column>
            <column caption='Polygon' datatype='string' name='[Point Id (copy)_5514446661898858497]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[level_9_polygon]' />
            </column>
            <column caption='Main Cuisines Max Country' datatype='integer' name='[Vendor Count Max Country (copy)_504543936145752067]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [country_name]: MAX([main_cuisines_count])}' />
            </column>
            <column caption='Main Cuisines Count as % of Country (copy)' datatype='real' name='[Vendor Count as % of Country (copy)_504543936145862660]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[main_cuisines_count]/[Vendor Count Max Country (copy)_504543936145752067]' />
            </column>
