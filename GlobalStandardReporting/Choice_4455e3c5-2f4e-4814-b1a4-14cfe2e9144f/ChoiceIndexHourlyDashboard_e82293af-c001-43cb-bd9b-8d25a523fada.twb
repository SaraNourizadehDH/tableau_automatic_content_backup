    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Glossary'>
      <repository-location derived-from='http://ip-172-31-0-77:8405/t/GlobalStandardReporting/workbooks/ChoiceIndexDEV/Glossary?rev=' id='Glossary' path='/t/GlobalStandardReporting/workbooks/ChoiceIndexHourlyDashboard' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='1200' maxwidth='1200' minheight='1200' minwidth='1200' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98666' id='1128' param='horz' type-v2='layout-flow' w='98666' x='667' y='667'>
            <zone h='98666' id='779' type-v2='layout-basic' w='98666' x='667' y='667'>
              <zone h='12916' id='776' param='horz' type-v2='layout-flow' w='98666' x='667' y='667'>
                <zone h='12916' id='618' type-v2='layout-basic' w='98666' x='667' y='667'>
                  <zone h='12916' id='96' param='horz' type-v2='layout-flow' w='98666' x='667' y='667'>
                    <zone h='12916' id='91' type-v2='layout-basic' w='98666' x='667' y='667'>
                      <zone forceUpdate='true' h='12916' id='16' type-v2='text' w='31844' x='23500' y='667'>
                        <formatted-text>
                          <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='20'>Glossary</run>
                          <run fontalignment='1'>Æ&#10;</run>
                        </formatted-text>
                        <zone-style>
                          <format attr='border-color' value='#000000' />
                          <format attr='border-style' value='none' />
                          <format attr='border-width' value='0' />
                          <format attr='margin' value='4' />
                        </zone-style>
                      </zone>
                      <zone h='12916' id='55' is-scaled='1' param='Image/DH Logistics Logo.png' type-v2='bitmap' w='22833' x='667' y='667'>
                        <zone-style>
                          <format attr='border-color' value='#000000' />
                          <format attr='border-style' value='none' />
                          <format attr='border-width' value='0' />
                          <format attr='margin' value='4' />
                        </zone-style>
                      </zone>
                      <zone h='12916' id='1123' type-v2='empty' w='43989' x='55344' y='667'>
                        <zone-style>
                          <format attr='border-color' value='#000000' />
                          <format attr='border-style' value='none' />
                          <format attr='border-width' value='0' />
                          <format attr='margin' value='4' />
                        </zone-style>
                      </zone>
                    </zone>
                  </zone>
                </zone>
              </zone>
              <zone h='85750' id='777' param='vert' type-v2='layout-flow' w='98666' x='667' y='13583'>
                <zone fixed-size='585' forceUpdate='true' h='49417' id='1146' is-fixed='true' type-v2='text' w='98666' x='667' y='13583'>
                  <formatted-text>
                    <run bold='true' fontsize='11'>Choice Index: </run>
                    <run fontsize='11'>Index created as the weighted sum of Density, Variety and Popularity scores. </run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontsize='11'>Choice index</run>
                    <run fontsize='11'> = (W_Density * Score_Density) + (W_Variety * Score_Variety) + (W_Popularity * Score_Popularity)</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontsize='11'>Popularity Score:</run>
                    <run fontsize='11'> Measures the availability of the most popular stores in terms of orders. </run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontsize='11'>Variety Score:</run>
                    <run fontsize='11'> Measures how much variety we offer in terms of cuisines. </run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontsize='11'>Density Score:</run>
                    <run fontsize='11'> Measures the count of vendors available per session. </run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontsize='11'>Vendor Count:</run>
                    <run fontsize='11'> Average number of vendors that their delivery area covers a given hexagon. </run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontsize='11'>Main Cuisines Count:</run>
                    <run fontsize='11'> Average number of different main cuisines of the vendors that deliver in a given hexagon.</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontsize='11'>Availability Label</run>
                    <run fontsize='11'> is one of:</run>
                    <run>Æ&#10;</run>
                    <run fontsize='11'>&quot;</run>
                    <run bold='true' fontsize='11'>all_vendors</run>
                    <run fontsize='11'>&quot;: Uses all vendors from AVA response regardless of availability (i.e. ignores schedule, offline, geo).</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontsize='11'>&quot;</run>
                    <run bold='true' fontsize='11'>available_vendors</run>
                    <run fontsize='11'>&quot;: Only considers vendors which were shown to the customer (i.e. schedule, offline, geo should be available).</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontsize='11'>&quot;</run>
                    <run bold='true' fontsize='11'>available_vendors_ignore_events</run>
                    <run fontsize='11'>&quot;: Considers schedule and temporary closures but ignores events (ignores lockdown, shrinking, etc. but takes schedule and offline into account).</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontsize='11'> &quot;</run>
                    <run bold='true' fontsize='11'>available_vendors_schedule_only</run>
                    <run fontsize='11'>&quot;: Only considers vendor schedules for availability and ignores the rest of the filters.</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#4996b2' hyperlink='tabdoc:load-url url=&amp;quot;https://docs.google.com/document/d/1fcRdanjd3jIovQZhn1FMs1aGMnr9JNUSCJaneFf5ygc/edit?tab=t.0#heading=h.pfu07d2fgctg&amp;quot;'>More info about Choice Index</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                  </zone-style>
                </zone>
                <zone h='36333' id='1235' param='horz' type-v2='layout-flow' w='98666' x='667' y='63000' />
              </zone>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
