      <aliases enabled='yes' />
      <column caption='Sessions' datatype='integer' name='[Calculation_1783636600364601345]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([sessions],0)' />
      </column>
      <column caption='Density Score' datatype='real' name='[Calculation_4240631646946566144]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN 1 THEN [density_score_agg_weighted]&#10;WHEN 2 THEN [density_score_agg_unweighted]&#10;END' />
      </column>
      <column caption='CVR' datatype='real' name='[Calculation_4672625392283590656]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(SUM([sessions_with_transaction])/SUM([sessions]),0)' />
      </column>
      <column caption='Last 3 Weeks' datatype='boolean' name='[Calculation_6205467725689040897]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;week&apos;, [score_date], TODAY()) &lt; 3 AND [score_date] &lt;= TODAY()' />
      </column>
      <column caption='Variety Score' datatype='real' name='[Density Score (copy)_4240631646946734081]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN 1 THEN [variety_score_agg_weighted]&#10;WHEN 2 THEN [variety_score_agg_unweighted]&#10;END' />
      </column>
      <column caption='Popularity Score ' datatype='real' name='[Variety Score (copy)_4240631646946897922]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN 1 THEN [popularity_score_agg_weighted]&#10;WHEN 2 THEN [popularity_score_agg_unweighted]&#10;END' />
      </column>
