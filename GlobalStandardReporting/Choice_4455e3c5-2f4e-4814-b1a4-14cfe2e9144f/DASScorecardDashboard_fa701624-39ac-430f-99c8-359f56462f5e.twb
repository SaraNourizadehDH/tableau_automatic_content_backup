      <aliases enabled='yes' />
      <column caption='default delivery areas settings' datatype='integer' name='[Calculation_2256303431598194691]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [has_default_delivery_area_settings]                       THEN 1 ELSE 0 END' />
      </column>
      <column caption='automated events' datatype='integer' name='[Calculation_2256303431598370820]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF   [has_automated_events]  THEN  1&#13;&#10;&#13;&#10;ELSE   0&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='% Zones W default DAS settings' datatype='real' default-format='p0.0%' name='[Calculation_2256303431598583813]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_2256303431598194691])  /COUNT([id])' />
      </column>
      <column caption='% Zones W Automated Events' datatype='real' default-format='p0.0%' name='[Calculation_2256303431599112198]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_2256303431598370820])  /COUNT([id])' />
      </column>
      <column caption='User Entitlements' datatype='boolean' name='[Calculation_4309311590177300481]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
        <calculation class='tableau' formula='1' />
      </column>
