  <worksheets>
    <worksheet name='Vendor Scores'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='13'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='das_scorecard_vendors' name='federated.1ilydgf1pmhecx10x9ddk09f5iey' />
          </datasources>
          <datasource-dependencies datasource='federated.1ilydgf1pmhecx10x9ddk09f5iey'>
            <column caption='% Active VD Vendors with  Delivery Areas' datatype='real' name='[%  OD vendors (copy)_3151604985691222018]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vd_vendor_w_deliveryareas_nominator]) / SUM([vd_vendors])' />
            </column>
            <column caption='% Active OD Vendors with Delivery Areas' datatype='real' name='[Calculation_3151604985690263552]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(od_vendor_w_deliveryareas_nominator) / SUM([od_vendors])' />
            </column>
            <column caption='% OD Vendors Based on Drive Time' datatype='real' name='[Calculation_3151604985693134852]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([od_vendors_based_on_drive_time_nominator]) / SUM([od_vendors])' />
            </column>
            <column caption='% Vendors  with Custom Vehicle Profiles' datatype='real' name='[Calculation_3151604985694093317]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_cust_vehicle_profiles_nominator]) / SUM([vendors_cust_vehicle_profiles_denominator])' />
            </column>
            <column caption='% OD Vendors with Dymanic Delivery Fees' datatype='real' name='[Calculation_3151604985699618822]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([od_vendors_w_dynamic_delivery_fee_nominator]) / SUM([od_vendors])' />
            </column>
            <column caption='% OD Vendors Outside of Any Zone' datatype='real' name='[Calculation_3151604985700843527]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([od_vendors_out_of_zone_nominator]) / SUM([od_vendors])' />
            </column>
            <column caption='% OD Vendors with Delivery Area Fully in Zone' datatype='real' name='[Calculation_3151604985701777416]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([od_vendors_with_delivery_area_fully_contained_nominator]) / SUM([od_vendors])' />
            </column>
            <column caption='% OD Vendors Outside of Delivery Area' datatype='real' name='[Calculation_3151604985708826633]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([od_vendors_outside_deliveryarea_nominator]) / SUM([od_vendors])' />
            </column>
