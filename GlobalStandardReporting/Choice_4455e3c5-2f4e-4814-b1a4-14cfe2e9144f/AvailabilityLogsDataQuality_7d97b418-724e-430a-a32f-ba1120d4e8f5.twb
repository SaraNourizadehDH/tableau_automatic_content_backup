              <calculation class='tableau' formula='1.' />
              <aliases>
                <alias key='1.' value='% Requests Matched Perseus Clients' />
                <alias key='2.' value='% Requests Matched Perseus Sessions' />
                <alias key='6.' value='% Requests with NULL Client ID' />
                <alias key='7.' value='% Requests with NULL Session ID' />
                <alias key='10.' value='# Clients in AVA logs' />
                <alias key='11.' value='# Clients in Perseus logs' />
                <alias key='12.' value='# Requests with NULL Client ID' />
                <alias key='13.' value='# Requests with NULL Session ID' />
                <alias key='14.' value='# Requests' />
