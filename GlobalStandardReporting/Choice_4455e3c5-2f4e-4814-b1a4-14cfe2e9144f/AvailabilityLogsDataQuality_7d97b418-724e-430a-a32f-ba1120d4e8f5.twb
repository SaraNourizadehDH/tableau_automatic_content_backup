                <alias key='16.' value='# Sessions in Perseus logs' />
                <alias key='17.' value='% Requests with NULL Client ID &amp; Session ID' />
              </aliases>
            </column>
            <column alias='Week' caption='Choose Time Dimension' datatype='real' name='[Parameter 5]' param-domain-type='list' role='measure' type='quantitative' value='2.'>
              <calculation class='tableau' formula='2.' />
              <aliases>
                <alias key='1.' value='Month' />
                <alias key='2.' value='Week' />
                <alias key='3.' value='Day' />
              </aliases>
            </column>
