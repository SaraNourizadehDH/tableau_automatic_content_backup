            <column alias='User Agent' caption='Choose Dimension (A)' datatype='real' name='[Choose Dimension (1) (copy)_5547449643418075145]' param-domain-type='list' role='measure' type='quantitative' value='9.'>
              <calculation class='tableau' formula='9.' />
              <aliases>
                <alias key='1.' value='Region' />
