      <aliases enabled='yes' />
      <column caption='% Requests Matched Perseus Clients' datatype='real' name='[% Matched Perseus Sessions (copy)_5523031687826165765]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([no_clients_perseus])/sum([no_requests])' />
      </column>
      <column caption='% Requests with NULL Client ID &amp; Session ID' datatype='real' name='[% Requests with NULL Client ID (copy)_5828432003937423360]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([no_null_client_session_ids])/SUM([no_requests])' />
      </column>
      <column caption='% order difference' datatype='real' name='[% metric difference (copy)_5547449643426664470]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_5547449643392454656] - [Metric Avg (copy)_5547449643426304020]) / [Calculation_5547449643392454656]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='+/- Metric' datatype='real' name='[+/- Metric Difference (copy)_5547449643435278365]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN 1 THEN [Calculation_5547449643404963846]&#10;WHEN 2 THEN [Calculation_5547449643404963846]&#10;WHEN 6 THEN 100-[Calculation_5547449643404963846]&#10;WHEN 7 THEN 100-[Calculation_5547449643404963846]&#10;WHEN 10 THEN 90&#10;WHEN 11 THEN 90&#10;WHEN 12 THEN 90&#10;WHEN 13 THEN 90&#10;WHEN 14 THEN 90&#10;WHEN 15 THEN 90&#10;WHEN 16 THEN 90&#10;WHEN 17 THEN 100-[Calculation_5547449643404963846]&#10;&#10;END' />
      </column>
      <column caption='Frontend Platorm' datatype='string' name='[Calculation_1375779320699916288]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='Lower([platform])' />
      </column>
      <column caption='Format Metric' datatype='string' name='[Calculation_2414422047481245696]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN 1 THEN  &apos;%&apos;&#10;WHEN 2 THEN &apos;%&apos;&#10;WHEN 4 THEN &apos;%&apos;&#10;WHEN 5 THEN &apos;%&apos;&#10;WHEN 6 THEN &apos;%&apos;&#10;WHEN 7 THEN &apos;%&apos;&#10;WHEN 17 THEN &apos;%&apos;&#10;ELSE &apos;&apos;&#10;&#10;END' />
      </column>
      <column caption='User Entitlements' datatype='boolean' name='[Calculation_3942971908526690304]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username (_tableau_entity_user_entitlements_entity_id1)] = USERNAME()' />
      </column>
      <column caption='% Requests with NULL Session ID' datatype='real' name='[Calculation_5523031686770257920]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([no_null_session_ids])/SUM([no_requests])' />
