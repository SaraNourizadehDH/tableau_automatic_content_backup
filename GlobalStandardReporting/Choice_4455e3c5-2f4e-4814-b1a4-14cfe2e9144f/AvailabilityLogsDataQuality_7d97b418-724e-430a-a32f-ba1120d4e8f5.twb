          <datasource-dependencies datasource='federated.0mezbhy03mstry1af439y04pbiz0'>
            <column caption='% Requests Matched Perseus Clients' datatype='real' name='[% Matched Perseus Sessions (copy)_5523031687826165765]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_clients_perseus])/sum([no_requests])' />
            </column>
            <column caption='% Requests with NULL Client ID &amp; Session ID' datatype='real' name='[% Requests with NULL Client ID (copy)_5828432003937423360]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_null_client_session_ids])/SUM([no_requests])' />
            </column>
            <column caption='+/- Metric' datatype='real' name='[+/- Metric Difference (copy)_5547449643435278365]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN 1 THEN [Calculation_5547449643404963846]&#10;WHEN 2 THEN [Calculation_5547449643404963846]&#10;WHEN 6 THEN 100-[Calculation_5547449643404963846]&#10;WHEN 7 THEN 100-[Calculation_5547449643404963846]&#10;WHEN 10 THEN 90&#10;WHEN 11 THEN 90&#10;WHEN 12 THEN 90&#10;WHEN 13 THEN 90&#10;WHEN 14 THEN 90&#10;WHEN 15 THEN 90&#10;WHEN 16 THEN 90&#10;WHEN 17 THEN 100-[Calculation_5547449643404963846]&#10;&#10;END' />
            </column>
            <column caption='Frontend Platorm' datatype='string' name='[Calculation_1375779320699916288]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='Lower([platform])' />
            </column>
            <column caption='Format Metric' datatype='string' name='[Calculation_2414422047481245696]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN 1 THEN  &apos;%&apos;&#10;WHEN 2 THEN &apos;%&apos;&#10;WHEN 4 THEN &apos;%&apos;&#10;WHEN 5 THEN &apos;%&apos;&#10;WHEN 6 THEN &apos;%&apos;&#10;WHEN 7 THEN &apos;%&apos;&#10;WHEN 17 THEN &apos;%&apos;&#10;ELSE &apos;&apos;&#10;&#10;END' />
            </column>
            <column caption='% Requests with NULL Session ID' datatype='real' name='[Calculation_5523031686770257920]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_null_session_ids])/SUM([no_requests])' />
            </column>
            <column caption='% Requests with NULL Client ID' datatype='real' name='[Calculation_5523031686770434049]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_null_client_ids])/SUM([no_requests])' />
            </column>
            <column caption='% Requests Matched Perseus Sessions' datatype='real' name='[Calculation_5523031687826038788]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_sessions_perseus])/sum([no_requests])' />
            </column>
            <column caption='Time Dimension' datatype='string' name='[Calculation_5547449643396120579]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN 1 THEN [created_month]&#10;WHEN 2 THEN [created_week]&#10;WHEN 3 THEN STR([created_date])&#10;END' />
            </column>
            <column caption='Metric' datatype='real' name='[Calculation_5547449643404963846]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN 1 THEN  100*[% Matched Perseus Sessions (copy)_5523031687826165765]&#10;WHEN 2 THEN 100*[Calculation_5523031687826038788]&#10;WHEN 6 THEN 100*[Calculation_5523031686770434049]&#10;WHEN 7 THEN 100*[Calculation_5523031686770257920]&#10;WHEN 10 THEN SUM([no_clients_ava])&#10;WHEN 11 THEN SUM([no_clients_perseus])&#10;WHEN 12 THEN SUM([no_null_client_ids])&#10;WHEN 13 THEN SUM([no_null_session_ids])&#10;WHEN 14 THEN SUM([no_requests])&#10;WHEN 15 THEN SUM([no_sessions_ava])&#10;WHEN 16 THEN SUM([no_sessions_perseus])&#10;WHEN 17 THEN 100*[% Requests with NULL Client ID (copy)_5828432003937423360]&#10;END' />
            </column>
            <column caption='Dimension A' datatype='string' name='[Dimension 1  (copy)_5547449643418357771]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Choose Dimension (1) (copy)_5547449643418075145]&#10;WHEN 1 THEN [region]&#10;WHEN 2 THEN [entity_id]&#10;WHEN 3 THEN [Calculation_1375779320699916288]&#10;WHEN 4 THEN [dh_platform_detailed]&#10;&#10;WHEN 6 THEN [experiment_id]&#10;WHEN 7 THEN [variant_id]&#10;WHEN 9 THEN [user_agent]&#10;END' />
