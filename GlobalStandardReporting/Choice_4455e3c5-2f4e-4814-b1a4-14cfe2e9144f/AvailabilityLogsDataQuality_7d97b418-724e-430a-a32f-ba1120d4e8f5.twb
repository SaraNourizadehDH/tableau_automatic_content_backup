              <zone forceUpdate='true' h='93000' id='343' type-v2='text' w='98858' x='571' y='6429'>
                <formatted-text>
                  <run bold='true' fontalignment='0' fontcolor='#333333' fontname='Verdana' fontsize='14'># Requests</run>
                  <run fontalignment='0'>Æ&#10;</run>
                  <run fontalignment='0' fontcolor='#333333' fontsize='10'>Total number of requests in the Availability logs. </run>
                  <run fontalignment='0'>Æ&#10;&#10;</run>
                  <run bold='true' fontalignment='0' fontcolor='#333333' fontname='Verdana' fontsize='14'># Clients in AVA logs</run>
                  <run fontalignment='0'>Æ&#10;</run>
                  <run fontalignment='0' fontcolor='#333333' fontsize='10'>Total number of distinct Client IDs coming from the Availability logs.</run>
                  <run fontalignment='0'>Æ&#10;&#10;</run>
                  <run bold='true' fontalignment='0' fontcolor='#333333' fontname='Verdana' fontsize='14'># Clients in Perseus logs</run>
                  <run fontalignment='0'>Æ&#10;</run>
                  <run fontalignment='0' fontcolor='#333333' fontsize='10'>Total number of distinct Client IDs that exist in the Availability logas and the Perseus logs.</run>
                  <run fontalignment='0'>Æ&#10;&#10;</run>
                  <run bold='true' fontalignment='0' fontcolor='#333333' fontname='Verdana' fontsize='14'># Sessions in AVA logs</run>
                  <run fontalignment='0'>Æ&#10;</run>
                  <run fontalignment='0' fontcolor='#333333' fontsize='10'>Total number of distinct Session IDs coming from the Availability logs.</run>
                  <run fontalignment='0'>Æ&#10;&#10;</run>
                  <run bold='true' fontalignment='0' fontcolor='#333333' fontname='Verdana' fontsize='14'># Sessions in Perseus logs</run>
                  <run fontalignment='0'>Æ&#10;</run>
                  <run fontalignment='0' fontcolor='#333333' fontsize='10'>Total number of distinct Session IDs that exist in the Availability logs and the Perseus logs.</run>
                  <run fontalignment='0'>Æ&#10;&#10;</run>
                  <run bold='true' fontalignment='0' fontcolor='#333333' fontname='Verdana' fontsize='14'># Requests with NULL Client ID</run>
                  <run fontalignment='0'>Æ&#10;</run>
                  <run fontalignment='0' fontcolor='#333333' fontsize='10'>Total number of requests in the Availability logs where Client ID is NULL.</run>
                  <run fontalignment='0'>Æ&#10;&#10;</run>
                  <run bold='true' fontalignment='0' fontcolor='#333333' fontname='Verdana' fontsize='14'># Requests with NULL Session ID</run>
                  <run fontalignment='0'>Æ&#10;</run>
                  <run fontalignment='0' fontcolor='#333333' fontsize='10'>Total number of requests in the Availability logs where Session ID is NULL.</run>
                  <run fontalignment='0'>Æ&#10;&#10;</run>
                  <run bold='true' fontalignment='0' fontcolor='#333333' fontname='Verdana' fontsize='14'>% Request Matched Perseus Clients</run>
                  <run fontalignment='0'>Æ&#10;</run>
                  <run fontalignment='0' fontcolor='#333333' fontsize='10'>Percentage of total requests from availability sessions where there is a matching Client ID in Perseus Sessions.</run>
                  <run fontalignment='0'>Æ&#10;&#10;</run>
                  <run bold='true' fontalignment='0' fontcolor='#333333' fontname='Verdana' fontsize='14'>% Request Matched Perseus Sessions</run>
