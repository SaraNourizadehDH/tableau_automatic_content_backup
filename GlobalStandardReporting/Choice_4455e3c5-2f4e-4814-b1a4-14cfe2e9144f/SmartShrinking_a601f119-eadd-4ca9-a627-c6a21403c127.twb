      <column caption='Vendor Fail Rate' datatype='real' name='[Calculation_354377055830138880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_failed_vendor])/SUM([total_orders])' />
      </column>
      <column caption='% Orders with Events' datatype='real' name='[Calculation_354377055830228993]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([orders_with_events])/sum([total_orders])' />
      </column>
      <column caption='% Time with Events' datatype='real' name='[Calculation_354377055830335490]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_event_minutes])/SUM([total_zone_minutes])' />
      </column>
      <column caption='% Stacking' datatype='real' name='[Calculation_354377055830417411]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([orders_stacked])/sum([total_orders])' />
      </column>
      <column caption='% Vendor Late &gt; 10 min' datatype='real' name='[Calculation_354377055830487044]' role='measure' type='quantitative'>
