            <column-instance column='[gp_eur (copy)_1740359812750811163]' derivation='Sum' name='[sum:gp_eur (copy)_1740359812750811163:qk]' pivot='key' type='quantitative' />
            <column-instance column='[gp_eur (copy)_345651302347509764]' derivation='Sum' name='[sum:gp_eur (copy)_345651302347509764:qk]' pivot='key' type='quantitative' />
            <column-instance column='[revenue_eur (copy)_806425839041638430]' derivation='Sum' name='[sum:revenue_eur (copy)_806425839041638430:qk]' pivot='key' type='quantitative' />
            <column-instance column='[sof_as_a_pct_of_customer_fees (copy)_345651302362955782]' derivation='Sum' name='[sum:sof_as_a_pct_of_customer_fees (copy)_345651302362955782:qk]' pivot='key' type='quantitative' />
