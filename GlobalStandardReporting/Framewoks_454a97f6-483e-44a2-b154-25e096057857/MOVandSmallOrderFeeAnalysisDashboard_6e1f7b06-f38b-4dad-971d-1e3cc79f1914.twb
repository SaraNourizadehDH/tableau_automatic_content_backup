          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1qndjhx0radn5w18m0r9d1bxa73y'>
            <column caption='sof_eur_theor' datatype='real' name='[Calculation_1589207749829435392]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[sof_local_theor] / [exchange_rate]' />
            </column>
            <column caption='sof_diff_theor_reported' datatype='real' name='[Calculation_1589207749845192705]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1589207749829435392] - [Calculation_806425838994763791]' />
            </column>
            <column caption='sof_share_of_tot_revenue' datatype='real' name='[Calculation_1740359812719099922]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_806425838994763791]) / SUM([Calculation_806425838982746120])' />
            </column>
            <column caption='actual_df_paid_by_customer_eur' datatype='real' name='[Calculation_345651302416097297]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[actual_df_paid_by_customer] / [exchange_rate]' />
            </column>
            <column caption='service_fee_eur' datatype='real' name='[Calculation_345651302419132438]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[service_fee_local] / [exchange_rate]' />
            </column>
            <column caption='is_sof_flag' datatype='boolean' name='[Calculation_806425838965964801]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [sof_local] &gt; 0 THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='order_count_with_sof' datatype='integer' name='[Calculation_806425838971457540]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [Calculation_806425838965964801] THEN [platform_order_code] END)' />
            </column>
            <column caption='is_sof_exists_in_entity' datatype='boolean' name='[Calculation_806425838982266887]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF {FIXED [entity_id]: COUNTD(IF [Calculation_806425838965964801] THEN [platform_order_code] END)} &gt; 0 THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='revenue_eur' datatype='real' name='[Calculation_806425838982746120]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(([actual_df_paid_by_customer] + [commission_local] + [joker_vendor_fee_local] + [service_fee_local] + [sof_local]) / [exchange_rate])' />
            </column>
            <column caption='dummy' datatype='integer' name='[Calculation_806425838984192009]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='order_share_with_sof' datatype='real' name='[Calculation_806425838985453579]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_806425838971457540] / COUNTD([platform_order_code])' />
            </column>
            <column caption='revenue_share_with_sof' datatype='real' name='[Calculation_806425838985789452]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[order_count_with_sof (copy)_806425838984687626] / SUM([Calculation_806425838982746120])' />
