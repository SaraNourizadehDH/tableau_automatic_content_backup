      <column caption='sof_eur_hyp' datatype='real' name='[avg_sof_eur_per_bin_hypothetical (copy)_1740359812775202854]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(&#13;&#10;    IF [Calculation_806425838963998720] &lt; [Parameters].[Parameter 2] // If GFV &lt; MOV&#13;&#10;    THEN IF [Calculation_806425838965964801] THEN MIN(MAX([Parameters].[Parameter 2] - [Calculation_806425838963998720], 0), [Parameters].[Parameter 4]) END // Check if the order has no refund. If yes, override the SOF. If no, do nothing&#13;&#10;    ELSE 0 // If the GFV &gt;= MOV, apply a 0 SOF&#13;&#10;    END // We apply the SOF model only to the orders without refunds. For orders below MOV with refunds, we keep them at 0 SOF. For orders above MOV, we keep them at 0 SOF too&#13;&#10;    , 0&#13;&#10;)' />
