    <worksheet name='GP Simulation Supp Table (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run>GP Simulation Table Supplementary Table (SOF and Customer Fees)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='order_data_sof_analysis' name='federated.1qndjhx0radn5w18m0r9d1bxa73y' />
            <datasource caption='order_wtd_mov_sof_analysis' name='federated.1jsb8160n8vnym15um9sz0x7nw5j' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='gfv_bin_size' datatype='real' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='0.5'>
              <calculation class='tableau' formula='0.5' />
              <range granularity='0.25' max='10.0' min='0.25' />
            </column>
            <column caption='hypothetical_soft_mov_eur' datatype='real' datatype-customized='true' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='12.'>
              <calculation class='tableau' formula='12.' />
              <range granularity='0.1' max='30.0' min='0.0' />
            </column>
            <column caption='small_basket_cap_eur' datatype='real' name='[Parameter 4]' param-domain-type='range' role='measure' type='quantitative' value='2.5000000000000004'>
              <calculation class='tableau' formula='2.5000000000000004' />
              <range granularity='0.1' max='20.0' min='0.0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1jsb8160n8vnym15um9sz0x7nw5j'>
            <column caption='Entity Id' datatype='string' name='[entity_id]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1qndjhx0radn5w18m0r9d1bxa73y'>
            <column caption='sof_eur_cf' datatype='real' name='[Calculation_1740359812745060377]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// This is a field to calculate a counterfactual gross profit that we will compare to the hypothetical gross profit&#13;&#10;// We calculate this counterfactual gross profit because there are many orders where the SOF is not as it should be because of basket value amendments&#13;&#10;// (e.g., order n7no-w2ib in SG) or different MOV values&#13;&#10;IFNULL(&#13;&#10;    IF [Calculation_806425838963998720] &lt; [entity_order_wtd_mov_eur (order_wtd_mov_sof_analysis1)] // If GFV &lt; Entity MOV&#13;&#10;    THEN IF [Calculation_806425838965964801] THEN MIN(MAX([entity_order_wtd_mov_eur (order_wtd_mov_sof_analysis1)] - [Calculation_806425838963998720], 0), [Parameters].[Parameter 4]) END&#13;&#10;    ELSE 0 // If GFV &gt;= Entity MOV, set the SOF to 0&#13;&#10;    END,&#13;&#10;    0 // If the result is NULL, replace with zero&#13;&#10;)' />
            </column>
            <column caption='actual_df_paid_by_customer_eur' datatype='real' name='[Calculation_345651302416097297]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[actual_df_paid_by_customer] / [exchange_rate]' />
            </column>
            <column caption='service_fee_eur' datatype='real' name='[Calculation_345651302419132438]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[service_fee_local] / [exchange_rate]' />
            </column>
            <column caption='gfv_eur' datatype='real' name='[Calculation_806425838963998720]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[gfv_local]/[exchange_rate]' />
            </column>
            <column caption='is_sof_flag' datatype='boolean' name='[Calculation_806425838965964801]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [sof_local] &gt; 0 THEN TRUE ELSE FALSE END' />
            </column>
            <column aggregation='None' caption='Gfv Eur (bin)' datatype='integer' name='[Gfv Eur (bin)]' role='dimension' type='ordinal'>
              <calculation class='bin' decimals='0' formula='[Calculation_806425838963998720]' peg='0' size-parameter='[Parameters].[Parameter 1]' />
            </column>
            <column caption='Actual Df Paid By Customer' datatype='real' name='[actual_df_paid_by_customer]' role='measure' type='quantitative' />
            <column caption='sof_eur_hyp' datatype='real' name='[avg_sof_eur_per_bin_hypothetical (copy)_1740359812775202854]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(&#13;&#10;    IF [Calculation_806425838963998720] &lt; [Parameters].[Parameter 2] // If GFV &lt; MOV&#13;&#10;    THEN IF [Calculation_806425838965964801] THEN MIN(MAX([Parameters].[Parameter 2] - [Calculation_806425838963998720], 0), [Parameters].[Parameter 4]) END // Check if the order has no refund. If yes, override the SOF. If no, do nothing&#13;&#10;    ELSE 0 // If the GFV &gt;= MOV, apply a 0 SOF&#13;&#10;    END // We apply the SOF model only to the orders without refunds. For orders below MOV with refunds, we keep them at 0 SOF. For orders above MOV, we keep them at 0 SOF too&#13;&#10;    , 0&#13;&#10;)' />
