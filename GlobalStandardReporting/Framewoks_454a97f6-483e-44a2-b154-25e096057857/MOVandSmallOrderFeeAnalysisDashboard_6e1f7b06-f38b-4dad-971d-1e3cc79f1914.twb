    <worksheet name='GP Simulation'>
      <layout-options>
        <title>
          <formatted-text>
            <run>KPIs Per Basket Value Bin (Simulations)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='order_data_sof_analysis' name='federated.1qndjhx0radn5w18m0r9d1bxa73y' />
            <datasource caption='order_wtd_mov_sof_analysis' name='federated.1jsb8160n8vnym15um9sz0x7nw5j' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='gfv_bin_size' datatype='real' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='0.5'>
              <calculation class='tableau' formula='0.5' />
              <range granularity='0.25' max='10.0' min='0.25' />
            </column>
            <column caption='hypothetical_soft_mov_eur' datatype='real' datatype-customized='true' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='12.'>
              <calculation class='tableau' formula='12.' />
              <range granularity='0.1' max='30.0' min='0.0' />
            </column>
            <column caption='order_drop' datatype='real' default-format='p0%' name='[Parameter 3]' param-domain-type='range' role='measure' type='quantitative' value='-0.070000000000000007'>
              <calculation class='tableau' formula='-0.070000000000000007' />
              <range granularity='0.005' max='0.0' min='-0.2' />
            </column>
            <column caption='small_basket_cap_eur' datatype='real' name='[Parameter 4]' param-domain-type='range' role='measure' type='quantitative' value='2.5000000000000004'>
              <calculation class='tableau' formula='2.5000000000000004' />
              <range granularity='0.1' max='20.0' min='0.0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1jsb8160n8vnym15um9sz0x7nw5j'>
            <column caption='Entity Id' datatype='string' name='[entity_id]' role='dimension' type='nominal' />
            <column datatype='real' name='[entity_order_wtd_mov_eur]' role='measure' type='quantitative' />
            <column-instance column='[entity_order_wtd_mov_eur]' derivation='Sum' name='[sum:entity_order_wtd_mov_eur:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1qndjhx0radn5w18m0r9d1bxa73y'>
            <column caption='cumulative_order_share_static' datatype='real' name='[Calculation_1740359812658360329]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM(COUNTD([platform_order_code])) / SUM({FIXED [entity_id]: COUNTD([platform_order_code])})'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='sof_eur_cf' datatype='real' name='[Calculation_1740359812745060377]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// This is a field to calculate a counterfactual gross profit that we will compare to the hypothetical gross profit&#13;&#10;// We calculate this counterfactual gross profit because there are many orders where the SOF is not as it should be because of basket value amendments&#13;&#10;// (e.g., order n7no-w2ib in SG) or different MOV values&#13;&#10;IFNULL(&#13;&#10;    IF [Calculation_806425838963998720] &lt; [entity_order_wtd_mov_eur (order_wtd_mov_sof_analysis1)] // If GFV &lt; Entity MOV&#13;&#10;    THEN IF [Calculation_806425838965964801] THEN MIN(MAX([entity_order_wtd_mov_eur (order_wtd_mov_sof_analysis1)] - [Calculation_806425838963998720], 0), [Parameters].[Parameter 4]) END&#13;&#10;    ELSE 0 // If GFV &gt;= Entity MOV, set the SOF to 0&#13;&#10;    END,&#13;&#10;    0 // If the result is NULL, replace with zero&#13;&#10;)' />
            </column>
            <column caption='0' datatype='integer' name='[Calculation_345651302410391568]' role='measure' type='quantitative' user:unnamed='Totals with Ref Lines'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='actual_df_paid_by_customer_eur' datatype='real' name='[Calculation_345651302416097297]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[actual_df_paid_by_customer] / [exchange_rate]' />
            </column>
            <column caption='commission_eur' datatype='real' name='[Calculation_345651302416228370]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[commission_local] / [exchange_rate]' />
            </column>
            <column caption='delivery_costs_eur' datatype='real' name='[Calculation_345651302416785428]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[delivery_costs_local] / [exchange_rate]' />
            </column>
            <column caption='joker_vendor_fee_eur' datatype='real' name='[Calculation_345651302419083285]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[joker_vendor_fee_local] / [exchange_rate]' />
            </column>
            <column caption='service_fee_eur' datatype='real' name='[Calculation_345651302419132438]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[service_fee_local] / [exchange_rate]' />
            </column>
            <column caption='commission_base_eur' datatype='real' name='[Calculation_345651302429368347]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[commission_base_local] / [exchange_rate]' />
            </column>
            <column caption='gfv_eur' datatype='real' name='[Calculation_806425838963998720]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[gfv_local]/[exchange_rate]' />
            </column>
            <column caption='is_sof_flag' datatype='boolean' name='[Calculation_806425838965964801]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [sof_local] &gt; 0 THEN TRUE ELSE FALSE END' />
            </column>
            <column aggregation='None' caption='Gfv Eur (bin)' datatype='integer' name='[Gfv Eur (bin)]' role='dimension' type='ordinal'>
              <calculation class='bin' decimals='0' formula='[Calculation_806425838963998720]' peg='0' size-parameter='[Parameters].[Parameter 1]' />
            </column>
            <column caption='Actual Df Paid By Customer' datatype='real' name='[actual_df_paid_by_customer]' role='measure' type='quantitative' />
            <column caption='sof_eur_hyp' datatype='real' name='[avg_sof_eur_per_bin_hypothetical (copy)_1740359812775202854]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(&#13;&#10;    IF [Calculation_806425838963998720] &lt; [Parameters].[Parameter 2] // If GFV &lt; MOV&#13;&#10;    THEN IF [Calculation_806425838965964801] THEN MIN(MAX([Parameters].[Parameter 2] - [Calculation_806425838963998720], 0), [Parameters].[Parameter 4]) END // Check if the order has no refund. If yes, override the SOF. If no, do nothing&#13;&#10;    ELSE 0 // If the GFV &gt;= MOV, apply a 0 SOF&#13;&#10;    END // We apply the SOF model only to the orders without refunds. For orders below MOV with refunds, we keep them at 0 SOF. For orders above MOV, we keep them at 0 SOF too&#13;&#10;    , 0&#13;&#10;)' />
            </column>
            <column caption='Commission Base Local' datatype='real' name='[commission_base_local]' role='measure' type='quantitative' />
            <column caption='Commission Local' datatype='real' name='[commission_local]' role='measure' type='quantitative' />
            <column-instance column='[platform_order_code]' derivation='CountD' name='[ctd:platform_order_code:qk]' pivot='key' type='quantitative' />
            <column caption='cust_fees_eur_cf' datatype='real' name='[customer_fees_eur_hypothetical_row_wise (copy)_1740359812825182252]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1740359812745060377] + [Calculation_345651302416097297] + [Calculation_345651302419132438]' />
            </column>
            <column caption='Delivery Costs Local' datatype='real' name='[delivery_costs_local]' role='measure' type='quantitative' />
            <column caption='Entity Id' datatype='string' name='[entity_id]' role='dimension' type='nominal' />
            <column caption='Entity Order Wtd Mov Eur' datatype='real' name='[entity_order_wtd_mov_eur (order_wtd_mov_sof_analysis1)]' role='measure' type='quantitative' />
            <column caption='Exchange Rate' datatype='real' name='[exchange_rate]' role='measure' type='quantitative' />
            <column caption='Gfv Local' datatype='real' name='[gfv_local]' role='measure' type='quantitative' />
            <column caption='gp_eur_cf' datatype='real' name='[gp_eur (copy)_1740359812750811163]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_345651302416097297] + [Calculation_345651302416228370] + [Calculation_345651302419083285] + [Calculation_345651302419132438] + [Calculation_1740359812745060377] - [Calculation_345651302416785428])' />
            </column>
            <column caption='gp_eur_hyp' datatype='real' name='[gp_eur_hypothetical (copy)_1740359812775329831]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;    ( &#13;&#10;      IF [Calculation_806425838963998720] &lt; [Parameters].[Parameter 2] &#13;&#10;        THEN ([Calculation_806425838963998720] / [entity_order_wtd_mov_eur (order_wtd_mov_sof_analysis1)] * [Parameters].[Parameter 2]) * ([Calculation_345651302416228370] / [Calculation_345651302429368347])&#13;&#10;        ELSE [Calculation_345651302416228370]&#13;&#10;      END&#13;&#10;    ) + // New Avg Commission&#13;&#10;    [avg_sof_eur_per_bin_hypothetical (copy)_1740359812775202854] + // New Avg SOF&#13;&#10;    [Calculation_345651302416097297] + [Calculation_345651302419083285] + [Calculation_345651302419132438] - [Calculation_345651302416785428] // DF, SF, JVF, and delivery costs stay constant&#13;&#10;)' />
            </column>
            <column caption='cust_fees_eur_hyp' datatype='real' name='[gp_eur_hypothetical_row_wise (copy)_1740359812824649771]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[avg_sof_eur_per_bin_hypothetical (copy)_1740359812775202854] + [Calculation_345651302416097297] + [Calculation_345651302419132438]' />
            </column>
            <column caption='gp_eur_hyp_diluted' datatype='real' name='[gp_eur_hypothetical_row_wise (copy)_1740359812826615853]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(&#13;&#10;    ( &#13;&#10;      IF [Calculation_806425838963998720] &lt; [Parameters].[Parameter 2] &#13;&#10;        THEN ([Calculation_806425838963998720] / [entity_order_wtd_mov_eur (order_wtd_mov_sof_analysis1)] * [Parameters].[Parameter 2]) * ([Calculation_345651302416228370] / [Calculation_345651302429368347])&#13;&#10;        ELSE [Calculation_345651302416228370]&#13;&#10;      END&#13;&#10;    ) + // New Avg Commission&#13;&#10;    [avg_sof_eur_per_bin_hypothetical (copy)_1740359812775202854] + // New Avg SOF&#13;&#10;    [Calculation_345651302416097297] + [Calculation_345651302419083285] + [Calculation_345651302419132438] - [Calculation_345651302416785428] // DF, SF, JVF, and delivery costs stay constant&#13;&#10;) * COUNTD([platform_order_code]) * (1 + [Parameters].[Parameter 3]) // Multiply the average GP components by the number of orders in each bin to obtain the total GP' />
            </column>
            <column caption='Joker Vendor Fee Local' datatype='real' name='[joker_vendor_fee_local]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_345651302410391568]' derivation='None' name='[none:Calculation_345651302410391568:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_806425838963998720]' derivation='None' name='[none:Calculation_806425838963998720:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Gfv Eur (bin)]' derivation='None' name='[none:Gfv Eur (bin):qk]' pivot='key' type='quantitative' />
            <column-instance column='[entity_id]' derivation='None' name='[none:entity_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[region]' derivation='None' name='[none:region:nk]' pivot='key' type='nominal' />
            <column caption='Platform Order Code' datatype='string' name='[platform_order_code]' role='dimension' type='nominal' />
            <column datatype='string' name='[region]' role='dimension' type='nominal' />
            <column caption='Service Fee Local' datatype='real' name='[service_fee_local]' role='measure' type='quantitative' />
            <column caption='sof_pct_cust_fees_cf' datatype='real' default-format='p0.0%' name='[sof_as_a_pct_of_customer_fees (copy)_345651302362955782]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [entity_id]: SUM([Calculation_1740359812745060377]) / SUM([customer_fees_eur_hypothetical_row_wise (copy)_1740359812825182252])}' />
            </column>
            <column caption='Sof Local' datatype='real' name='[sof_local]' role='measure' type='quantitative' />
            <column caption='sof_pct_cust_fees_hyp' datatype='real' default-format='p0.0%' name='[sof_pct_of_cust_fees_entity_current (copy)_1740359812769783843]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [entity_id]: SUM([avg_sof_eur_per_bin_hypothetical (copy)_1740359812775202854]) / SUM([gp_eur_hypothetical_row_wise (copy)_1740359812824649771])}' />
