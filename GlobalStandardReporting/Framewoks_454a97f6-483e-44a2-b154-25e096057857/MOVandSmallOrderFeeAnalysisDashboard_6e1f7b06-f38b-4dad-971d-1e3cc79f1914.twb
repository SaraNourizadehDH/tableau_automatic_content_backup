    <worksheet name='How High is the SOF?'>
      <layout-options>
        <title>
          <formatted-text>
            <run>&lt;Sheet Name&gt; </run>
            <run fontcolor='#ff0000' fontsize='10' italic='true'>(Only analyzing Small Basket Orders &quot;SBO&quot; where a SBF was charged. Orders with refunds and basket value amendments after order placement are excluded)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='order_data_sof_analysis' name='federated.1qndjhx0radn5w18m0r9d1bxa73y' />
            <datasource caption='order_wtd_mov_sof_analysis' name='federated.1jsb8160n8vnym15um9sz0x7nw5j' />
            <datasource caption='entity_mov_type_pandora' name='federated.0f40win0nsp88010lgou11j6gsvd' />
          </datasources>
          <datasource-dependencies datasource='federated.0f40win0nsp88010lgou11j6gsvd'>
            <column caption='Mov Type' datatype='string' name='[mov_type]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1jsb8160n8vnym15um9sz0x7nw5j'>
            <column datatype='real' name='[entity_order_wtd_mov_eur]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1qndjhx0radn5w18m0r9d1bxa73y'>
            <column caption='actual_df_paid_by_customer_eur' datatype='real' name='[Calculation_345651302416097297]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[actual_df_paid_by_customer] / [exchange_rate]' />
            </column>
            <column caption='service_fee_eur' datatype='real' name='[Calculation_345651302419132438]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[service_fee_local] / [exchange_rate]' />
            </column>
            <column caption='gfv_eur' datatype='real' name='[Calculation_806425838963998720]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[gfv_local]/[exchange_rate]' />
            </column>
            <column caption='is_sof_flag' datatype='boolean' name='[Calculation_806425838965964801]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [sof_local] &gt; 0 THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='order_count_with_sof' datatype='integer' name='[Calculation_806425838971457540]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [Calculation_806425838965964801] THEN [platform_order_code] END)' />
            </column>
            <column caption='is_sof_exists_in_entity' datatype='boolean' name='[Calculation_806425838982266887]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF {FIXED [entity_id]: COUNTD(IF [Calculation_806425838965964801] THEN [platform_order_code] END)} &gt; 0 THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='revenue_eur' datatype='real' name='[Calculation_806425838982746120]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(([actual_df_paid_by_customer] + [commission_local] + [joker_vendor_fee_local] + [service_fee_local] + [sof_local]) / [exchange_rate])' />
            </column>
            <column caption='dummy' datatype='integer' name='[Calculation_806425838984192009]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='mov_type' datatype='string' name='[Calculation_806425838987509773]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IFNULL(&#13;&#10;    ATTR([federated.0f40win0nsp88010lgou11j6gsvd].[mov_type]),&#13;&#10;    IF SUM([federated.1jsb8160n8vnym15um9sz0x7nw5j].[entity_order_wtd_mov_eur]) &lt;= 1 THEN &apos;No or Low MOV&apos;&#13;&#10;    ELSEIF SUM([federated.1jsb8160n8vnym15um9sz0x7nw5j].[entity_order_wtd_mov_eur]) &gt; 1 AND [Calculation_806425838971457540] = 0 THEN &apos;Hard MOV&apos;&#13;&#10;    ELSEIF SUM([federated.1jsb8160n8vnym15um9sz0x7nw5j].[entity_order_wtd_mov_eur]) &gt; 1 AND [Calculation_806425838971457540] &gt; 0 THEN &apos;Soft MOV&apos;&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='sof_eur' datatype='real' name='[Calculation_806425838994763791]' role='measure' type='quantitative'>
