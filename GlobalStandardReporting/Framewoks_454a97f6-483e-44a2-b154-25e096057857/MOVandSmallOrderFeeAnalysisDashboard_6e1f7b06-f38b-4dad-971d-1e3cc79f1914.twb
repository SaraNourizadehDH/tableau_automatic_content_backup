      <column caption='sof_eur_theor' datatype='real' name='[Calculation_1589207749829435392]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[sof_local_theor] / [exchange_rate]' />
      </column>
      <column caption='sof_diff_theor_reported' datatype='real' name='[Calculation_1589207749845192705]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1589207749829435392] - [Calculation_806425838994763791]' />
      </column>
      <column caption='cumulative_order_share_static' datatype='real' name='[Calculation_1740359812658360329]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(COUNTD([platform_order_code])) / SUM({FIXED [entity_id]: COUNTD([platform_order_code])})'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='sof_share_of_tot_revenue' datatype='real' name='[Calculation_1740359812719099922]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_806425838994763791]) / SUM([Calculation_806425838982746120])' />
      </column>
      <column caption='sof_eur_cf' datatype='real' name='[Calculation_1740359812745060377]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// This is a field to calculate a counterfactual gross profit that we will compare to the hypothetical gross profit&#13;&#10;// We calculate this counterfactual gross profit because there are many orders where the SOF is not as it should be because of basket value amendments&#13;&#10;// (e.g., order n7no-w2ib in SG) or different MOV values&#13;&#10;IFNULL(&#13;&#10;    IF [Calculation_806425838963998720] &lt; [entity_order_wtd_mov_eur (order_wtd_mov_sof_analysis1)] // If GFV &lt; Entity MOV&#13;&#10;    THEN IF [Calculation_806425838965964801] THEN MIN(MAX([entity_order_wtd_mov_eur (order_wtd_mov_sof_analysis1)] - [Calculation_806425838963998720], 0), [Parameters].[Parameter 4]) END&#13;&#10;    ELSE 0 // If GFV &gt;= Entity MOV, set the SOF to 0&#13;&#10;    END,&#13;&#10;    0 // If the result is NULL, replace with zero&#13;&#10;)' />
      </column>
      <column caption='commission_eur_hyp' datatype='real' hidden='true' name='[Calculation_1740359812814729258]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_806425838963998720] &lt; [Parameters].[Parameter 2] &#13;&#10;THEN ([Calculation_806425838963998720] / [entity_order_wtd_mov_eur (order_wtd_mov_sof_analysis1)] * [Parameters].[Parameter 2]) * ([Calculation_345651302416228370] / [Calculation_345651302429368347])&#13;&#10;ELSE [Calculation_345651302416228370]&#13;&#10;END' />
      </column>
      <column caption='gp_pct_chng' datatype='real' name='[Calculation_1740359812828917806]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[gp_eur_hypothetical_row_wise (copy)_1740359812826615853] / SUM([gp_eur (copy)_1740359812750811163]) - 1' />
      </column>
      <column caption='actual_df_paid_by_customer_eur' datatype='real' name='[Calculation_345651302416097297]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[actual_df_paid_by_customer] / [exchange_rate]' />
      </column>
      <column caption='commission_eur' datatype='real' name='[Calculation_345651302416228370]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[commission_local] / [exchange_rate]' />
      </column>
      <column caption='delivery_costs_eur' datatype='real' name='[Calculation_345651302416785428]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[delivery_costs_local] / [exchange_rate]' />
      </column>
      <column caption='joker_vendor_fee_eur' datatype='real' name='[Calculation_345651302419083285]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[joker_vendor_fee_local] / [exchange_rate]' />
      </column>
      <column caption='service_fee_eur' datatype='real' name='[Calculation_345651302419132438]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[service_fee_local] / [exchange_rate]' />
