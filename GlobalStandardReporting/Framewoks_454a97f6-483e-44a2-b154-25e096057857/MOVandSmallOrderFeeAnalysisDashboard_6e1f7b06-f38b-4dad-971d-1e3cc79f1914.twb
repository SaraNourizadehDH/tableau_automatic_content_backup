        <calculation class='tableau' formula='[order_count_with_sof (copy)_806425838984687626] / SUM([Calculation_806425838982746120])' />
      </column>
      <column caption='mov_type' datatype='string' name='[Calculation_806425838987509773]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IFNULL(&#13;&#10;    ATTR([federated.0f40win0nsp88010lgou11j6gsvd].[mov_type]),&#13;&#10;    IF SUM([federated.1jsb8160n8vnym15um9sz0x7nw5j].[entity_order_wtd_mov_eur]) &lt;= 1 THEN &apos;No or Low MOV&apos;&#13;&#10;    ELSEIF SUM([federated.1jsb8160n8vnym15um9sz0x7nw5j].[entity_order_wtd_mov_eur]) &gt; 1 AND [Calculation_806425838971457540] = 0 THEN &apos;Hard MOV&apos;&#13;&#10;    ELSEIF SUM([federated.1jsb8160n8vnym15um9sz0x7nw5j].[entity_order_wtd_mov_eur]) &gt; 1 AND [Calculation_806425838971457540] &gt; 0 THEN &apos;Soft MOV&apos;&#13;&#10;    END&#13;&#10;)' />
