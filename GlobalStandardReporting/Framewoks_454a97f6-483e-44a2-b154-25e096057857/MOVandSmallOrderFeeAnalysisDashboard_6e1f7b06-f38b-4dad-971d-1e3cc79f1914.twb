        <calculation class='tableau' formula='[avg_sof_eur_per_bin_hypothetical (copy)_1740359812775202854] + [Calculation_345651302416097297] + [Calculation_345651302419132438]' />
      </column>
      <column caption='gp_eur_hyp_diluted' datatype='real' name='[gp_eur_hypothetical_row_wise (copy)_1740359812826615853]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#13;&#10;    ( &#13;&#10;      IF [Calculation_806425838963998720] &lt; [Parameters].[Parameter 2] &#13;&#10;        THEN ([Calculation_806425838963998720] / [entity_order_wtd_mov_eur (order_wtd_mov_sof_analysis1)] * [Parameters].[Parameter 2]) * ([Calculation_345651302416228370] / [Calculation_345651302429368347])&#13;&#10;        ELSE [Calculation_345651302416228370]&#13;&#10;      END&#13;&#10;    ) + // New Avg Commission&#13;&#10;    [avg_sof_eur_per_bin_hypothetical (copy)_1740359812775202854] + // New Avg SOF&#13;&#10;    [Calculation_345651302416097297] + [Calculation_345651302419083285] + [Calculation_345651302419132438] - [Calculation_345651302416785428] // DF, SF, JVF, and delivery costs stay constant&#13;&#10;) * COUNTD([platform_order_code]) * (1 + [Parameters].[Parameter 3]) // Multiply the average GP components by the number of orders in each bin to obtain the total GP' />
      </column>
