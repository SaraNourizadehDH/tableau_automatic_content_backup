      <column caption='commission_base_eur' datatype='real' name='[Calculation_345651302429368347]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[commission_base_local] / [exchange_rate]' />
      </column>
      <column caption='order_count_hyp' datatype='real' name='[Calculation_345651302679846967]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([platform_order_code]) * (1 + [Parameters].[Parameter 3])' />
      </column>
      <column caption='gfv_eur' datatype='real' name='[Calculation_806425838963998720]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[gfv_local]/[exchange_rate]' />
      </column>
      <column caption='is_sof_flag' datatype='boolean' name='[Calculation_806425838965964801]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [sof_local] &gt; 0 THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='order_count_with_sof' datatype='integer' name='[Calculation_806425838971457540]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Calculation_806425838965964801] THEN [platform_order_code] END)' />
      </column>
      <column caption='is_sof_exists_in_entity' datatype='boolean' name='[Calculation_806425838982266887]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF {FIXED [entity_id]: COUNTD(IF [Calculation_806425838965964801] THEN [platform_order_code] END)} &gt; 0 THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='revenue_eur' datatype='real' name='[Calculation_806425838982746120]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(([actual_df_paid_by_customer] + [commission_local] + [joker_vendor_fee_local] + [service_fee_local] + [sof_local]) / [exchange_rate])' />
