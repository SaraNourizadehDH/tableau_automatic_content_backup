    <worksheet name='cohorts-lines'>
      <layout-options>
        <title>
          <formatted-text>
            <run><![CDATA[Cohorts trends - <[Parameters].[Parameter 1]> <[federated.0qt8ty30dczooj13n23kp0l3u4ws].[attr:Selected Metric (copy)_3175530328836587525:nk]>
]]></run>
            <run fontname='Tableau Book' fontsize='10'>Each Grant Date Cohort is a separate line</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='bnpl_cohorts_view (rl_fintech)' name='federated.0qt8ty30dczooj13n23kp0l3u4ws' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Activity Rate' caption='Metrics Parameter' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;activity_rate&quot;'>
              <calculation class='tableau' formula='&quot;activity_rate&quot;' />
              <aliases>
                <alias key='&quot;activation_rate&quot;' value='Activation Rate' />
                <alias key='&quot;activity_rate&quot;' value='Activity Rate' />
                <alias key='&quot;avg_limit_per&quot;' value='Avg. Limit Granted/MAU' />
                <alias key='&quot;bnpl_grants_platform_active_share&quot;' value='Share of grants platform active' />
                <alias key='&quot;bnpl_platform_active&quot;' value='Grants platform active' />
                <alias key='&quot;bnpl_share_spend&quot;' value='BNPL Share of Spend' />
                <alias key='&quot;cumulative_activation&quot;' value='Cumulative Activation Share' />
                <alias key='&quot;mau&quot;' value='MAU' />
                <alias key='&quot;new_activations&quot;' value='New Activations' />
                <alias key='&quot;platform_spend_mau&quot;' value='Platform Spend/MAU' />
                <alias key='&quot;utilisation_rate&quot;' value='Utilisation Rate' />
                <alias key='&quot;utilised_limit_mau&quot;' value='Utilised Limit/MAU' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0qt8ty30dczooj13n23kp0l3u4ws'>
            <column caption='Cumulative Activation Rate' datatype='real' default-format='p0.0%' name='[Activation Rate (copy)_803611076946493440]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/* &#10;For this one to work as requested (the cumulative numbers),&#10;instead of Active Users we should have &apos;New Users per month&apos; as a field.&#10;We would then be able to calculate the cumulative numbers &#10;with RUNNING_SUM(SUM([New Users])) as shown below.&#10;*/&#10;&#10;RUNNING_SUM(SUM([new_activations]))/SUM([total_customers_granted_segment])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Cohort Month' datatype='string' name='[Calculation_3175530328795451392]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='/* Returns the Cohort Month as a formatted string. To use in labels/axis */&#10;LEFT(DATENAME(&apos;month&apos;, [cohort_month]),3) + &apos;-&apos; + DATENAME(&apos;year&apos;, [cohort_month])' />
            </column>
            <column caption='Activity Rate' datatype='real' default-format='p0.0%' name='[Calculation_3175530328796897281]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/* &#10;This metric measure the % of Active users in a given month out &#10;of the total users granted in the grant date&#10;*/&#10;&#10;SUM([active_users])/sum([total_customers_granted_segment])' />
            </column>
            <column caption='Selected Metric' datatype='real' name='[Calculation_3175530328801120258]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// To normalise the axis to percentage/rates values&#10;// , we multiply them by 100 and round by 2 decimals&#10;CASE [Parameters].[Parameter 1]&#10;WHEN &apos;activity_rate&apos;  THEN ROUND([Calculation_3175530328796897281]*100, 2)&#10;WHEN &apos;activation_rate&apos; THEN ROUND([Calculation_463378201317285888]*100, 2)&#10;WHEN &apos;mau&apos;              THEN ROUND(SUM([active_users]),0)&#10;WHEN &apos;new_activations&apos;  THEN ROUND(SUM([new_activations]),0)&#10;WHEN &apos;avg_limit_per&apos;    THEN ROUND([Calculation_3175530329128005638],2)&#10;WHEN &apos;granted&apos;          THEN SUM([total_customers_granted_segment])&#10;WHEN &apos;cumulative_activation&apos; THEN ROUND([Activation Rate (copy)_803611076946493440]*100,2) &#10;WHEN &apos;utilised_limit_mau&apos; THEN ROUND([Calculation_803611077302837250],2)&#10;WHEN &apos;utilisation_rate&apos; THEN round([Calculation_803611077651849221]*100,2)&#10;WHEN &apos;platform_spend_mau&apos; THEN ROUND([Calculation_803611077646409731],2)&#10;WHEN &apos;bnpl_share_spend&apos; THEN ROUND([Calculation_803611077647126532]*100,2)&#10;WHEN &apos;bnpl_platform_active&apos; THEN SUM([bnpl_grants_platform_active])&#10;when &apos;bnpl_grants_platform_active_share&apos; THEN ROUND([Calculation_3768175901461549056]*100,2)&#10;ELSE Null&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Avg limit Granted per MAU' datatype='real' name='[Calculation_3175530329128005638]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_of_limits_active_users])/sum([active_users])' />
            </column>
            <column caption='Share of Granted - Platform Active' datatype='real' name='[Calculation_3768175901461549056]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([bnpl_grants_platform_active])/SUM([total_customers_granted_segment])' />
            </column>
            <column caption='Activation Rate' datatype='real' name='[Calculation_463378201317285888]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([new_activations])/SUM([total_customers_granted_segment])' />
            </column>
            <column caption='Utilised limit per MAU' datatype='real' name='[Calculation_803611077302837250]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([disbursed_gmv])/sum([active_users])' />
            </column>
            <column caption='Platform Spend per MAU' datatype='real' name='[Calculation_803611077646409731]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/* Average money spend by BNPL active users overall &#10;in the platform*/&#10;&#10;SUM([sum_platform_gmv_local])/sum([active_users])' />
            </column>
            <column caption='BNPL share of spend on platform' datatype='real' name='[Calculation_803611077647126532]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/* Calculated the average percentage Spent GMV on platform&#10;thats spent on BNPL orders */&#10;&#10;[Calculation_803611077302837250]/[Calculation_803611077646409731]' />
            </column>
            <column caption='Utilisation Rate' datatype='real' name='[Calculation_803611077651849221]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_803611077302837250]/[Calculation_3175530329128005638]' />
            </column>
            <column caption='Cohort Date - To Date' datatype='date' name='[Calculation_988188297500676096]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATEADD(&apos;day&apos;, (INT([month_number_numeric]+1)*30),[cohort_month]))' />
            </column>
            <column caption='Cohort Date - From Date' datatype='date' name='[Cohort Date - To Date (copy)_988188297502334977]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATEADD(&apos;day&apos;, (INT([month_number_numeric])*30),[cohort_month]))' />
            </column>
            <column caption='Selected Metric.suffix' datatype='string' name='[Selected Metric (copy)_3175530328836587525]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='/* The function of this calculation is creating the proper suffix or unit&#10; for the metrics labels. */&#10;CASE [Parameters].[Parameter 1]&#10;WHEN &apos;activation_rate&apos;  THEN &apos;%&apos;&#10;WHEN &apos;activity_rate&apos; THEN &apos;%&apos;&#10;WHEN &apos;mau_share&apos;        THEN &apos;%&apos;&#10;WHEN &apos;cumulative_activation&apos; THEN &apos;%&apos;&#10;WHEN &apos;utilisation_rate&apos; THEN &apos;%&apos;&#10;when &apos;bnpl_share_spend&apos; THEN &apos;%&apos;&#10;WHEN &apos;bnpl_grants_platform_active_share&apos; THEN &apos;%&apos;&#10;WHEN &apos;avg_limit_per&apos; THEN &apos;(AED)&apos;&#10;WHEN &apos;utilised_limit_mau&apos; THEN &apos;(AED)&apos;&#10;WHEN &apos;platform_spend_mau&apos; THEN &apos;(AED)&apos;&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='Active Users' datatype='integer' name='[active_users]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_988188297500676096]' derivation='Attribute' name='[attr:Calculation_988188297500676096:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Cohort Date - To Date (copy)_988188297502334977]' derivation='Attribute' name='[attr:Cohort Date - To Date (copy)_988188297502334977:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Selected Metric (copy)_3175530328836587525]' derivation='Attribute' name='[attr:Selected Metric (copy)_3175530328836587525:nk]' pivot='key' type='nominal' />
            <column datatype='integer' name='[bnpl_grants_platform_active]' role='measure' type='quantitative' />
            <column caption='Cohort Date Exact' datatype='date' name='[cohort_month]' role='dimension' type='ordinal' />
            <column caption='Grant Date Cohorts' datatype='string' name='[cohort_month_string]' role='dimension' type='nominal' />
            <column caption='Country Code' datatype='string' name='[country_code]' role='dimension' semantic-role='' type='nominal' />
            <column caption='Disbursed Gmv' datatype='real' name='[disbursed_gmv]' role='measure' type='quantitative' />
            <column-instance column='[cohort_month]' derivation='Min' name='[min:cohort_month:qk]' pivot='key' type='quantitative' />
            <column caption='Activity Group' datatype='string' name='[month_number]' role='dimension' type='nominal' />
            <column datatype='real' name='[month_number_numeric]' role='measure' type='quantitative' />
            <column-instance column='[cohort_month]' derivation='MY' name='[my:cohort_month:ok]' pivot='key' type='ordinal' />
            <column datatype='integer' name='[new_activations]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_3175530328795451392]' derivation='None' name='[none:Calculation_3175530328795451392:nk]' pivot='key' type='nominal' />
            <column-instance column='[cohort_month]' derivation='None' name='[none:cohort_month:qk]' pivot='key' type='quantitative' />
            <column-instance column='[cohort_month_string]' derivation='None' name='[none:cohort_month_string:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_code]' derivation='None' name='[none:country_code:nk]' pivot='key' type='nominal' />
            <column-instance column='[month_number]' derivation='None' name='[none:month_number:nk]' pivot='key' type='nominal' />
            <column-instance column='[month_number_numeric]' derivation='None' name='[none:month_number_numeric:qk]' pivot='key' type='quantitative' />
            <column-instance column='[segment]' derivation='None' name='[none:segment:nk]' pivot='key' type='nominal' />
            <column caption='Segment' datatype='string' name='[segment]' role='dimension' type='nominal' />
            <column caption='Sum Of Limits Active Users' datatype='real' name='[sum_of_limits_active_users]' role='measure' type='quantitative' />
            <column caption='Sum Platform Gmv Local' datatype='real' name='[sum_platform_gmv_local]' role='measure' type='quantitative' />
            <column datatype='integer' name='[total_customers_granted_segment]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_3175530328801120258]' derivation='User' name='[usr:Calculation_3175530328801120258:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' />
              <table-calc field='[federated.0qt8ty30dczooj13n23kp0l3u4ws].[Activation Rate (copy)_803611076946493440]' ordering-type='Rows' />
            </column-instance>
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0qt8ty30dczooj13n23kp0l3u4ws].[Exclusions (Cohort Month,cohort_month_string,Reference Month)]' />
          <computed-sort column='[federated.0qt8ty30dczooj13n23kp0l3u4ws].[none:Calculation_3175530328795451392:nk]' direction='ASC' using='[federated.0qt8ty30dczooj13n23kp0l3u4ws].[min:cohort_month:qk]' />
          <filter class='categorical' column='[federated.0qt8ty30dczooj13n23kp0l3u4ws].[none:month_number:nk]' filter-group='4'>
            <groupfilter function='except' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[none:month_number:nk]' />
              <groupfilter function='union'>
                <groupfilter function='member' level='[none:month_number:nk]' member='&quot;inactive&quot;' />
                <groupfilter function='member' level='[none:month_number:nk]' member='%null%' />
