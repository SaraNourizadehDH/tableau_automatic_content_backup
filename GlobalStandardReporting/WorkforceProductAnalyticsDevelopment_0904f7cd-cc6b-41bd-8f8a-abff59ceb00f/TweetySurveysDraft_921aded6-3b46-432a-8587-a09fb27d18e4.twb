      <aliases enabled='yes' />
      <column caption='Answer INTEGER CM' datatype='integer' name='[# Satisfied CM (copy)_2416462727427215364]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF(([Calculation_6422696056136945673]), ([Calculation_5066690360834867200]), NULL)' />
      </column>
      <column caption='% Satisfied CM' datatype='real' default-format='p0.00%' name='[% Satisfied (copy)_2416462727425556481]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Calculation_2416462727427014659]) / COUNT([# Satisfied CM (copy)_2416462727427215364])' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0x0o50e1q2bnfu1c2f1ry1tn20ip].[usr:Calculation_5065986679652118528:qk]&quot;' value='Finished Rate' />
        </aliases>
      </column>
      <column aggregation='Sum' caption='Answer INTEGER Dimention' datatype='integer' hidden='true' name='[Answer INTEGER (copy)_6887833460484931585]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [answer_value] WHEN &apos;1&apos; THEN 1&#10;WHEN &apos;2&apos; THEN 2&#10;WHEN &apos;3&apos; THEN 3&#10;WHEN &apos;4&apos; THEN 4&#10;WHEN &apos;5&apos; THEN 5&#10;END' />
      </column>
      <column caption='# Satisfied CM' datatype='integer' name='[Calculation_2416462727427014659]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF(([Calculation_6422696056136945673]), ([Calculation_3974637820630347776]), NULL)' />
      </column>
      <column caption='% Satisfied CM Delta' datatype='real' default-format='p0.00%' name='[Calculation_2416462727428358150]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_3974637820630622209] - [% Satisfied (copy)_2416462727425556481]) * -1' />
      </column>
      <column caption='Unique Month Survey Users -1 [%]' datatype='real' default-format='p0.00%' name='[Calculation_310537311909072898]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(&#10;  (ZN(SUM([unique_month_survey_users])) - LOOKUP(ZN(SUM([unique_month_survey_users])), -1)) &#10;  / LOOKUP(ZN(SUM([unique_month_survey_users])), -1)&#10;, 0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Answers per Response' datatype='real' name='[Calculation_310537311909765123]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_answers])/SUM([total_survey_responses])' />
      </column>
      <column caption='Switch Module Type' datatype='string' name='[Calculation_3355815093513883649]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 7] WHEN &apos;RSAT Related Modules&apos; THEN [rsat_question]&#10;ELSE [module]&#10;END' />
      </column>
      <column caption='# Satisfied' datatype='integer' name='[Calculation_3974637820630347776]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Calculation_5066690360834867200] WHEN 4 THEN 1&#10;  WHEN 5 THEN 1&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='% Satisfied' datatype='real' default-format='p0.00%' name='[Calculation_3974637820630622209]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Calculation_3974637820630347776]) / COUNT([Calculation_5066690360834867200])' />
      </column>
      <column caption='% Satisfied -1 [%]' datatype='real' default-format='p0.00%' name='[Calculation_3974637820632489986]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(&#10;  (ZN(([Calculation_3974637820630622209])) - LOOKUP(ZN(([Calculation_3974637820630622209])), -1)) &#10;  / LOOKUP(ZN(([Calculation_3974637820630622209])), -1)&#10;, 0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Dimension 1' datatype='string' name='[Calculation_3974637820671950853]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6] WHEN &apos;Region&apos; THEN [region]&#10;  WHEN &apos;Country Name&apos; THEN [country_name]&#10;  WHEN &apos;Survey Name&apos; Then [survey_name]&#10;  WHEN &apos;Template Group&apos; THEN [template_group_display_name]&#10;  WHEN &apos;Report Month&apos; THEN [report_month]&#10;  WHEN &apos;Is Required&apos; THEN STR([is_required])&#10;  WHEN &apos;Module&apos; THEN [module]&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='# Surveys' datatype='integer' name='[Calculation_3974637820673208328]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([survey_name])' />
      </column>
      <column caption='Is RSAT (main)' datatype='boolean' name='[Calculation_4452863805252907008]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [rsat_question] WHEN &apos;GENERAL SATISFACTION&apos; THEN TRUE&#10;ELSE FALSE&#10;END' />
      </column>
