            </column>
            <column caption='Dimension 2' datatype='string' name='[Dimention 1 (copy)_3974637820672327686]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Dimention 1 (copy)_3974637820671860739] WHEN &apos;Region&apos; THEN [region]&#10;  WHEN &apos;Country Name&apos; THEN [country_name]&#10;  WHEN &apos;Survey Name&apos; Then [survey_name]&#10;  WHEN &apos;Template Group&apos; THEN [template_group_display_name]&#10;  WHEN &apos;Report Month&apos; THEN [report_month]&#10;  WHEN &apos;Is Required&apos; THEN STR([is_required])&#10;  WHEN &apos;Module&apos; THEN [module]&#10;ELSE NULL&#10;END' />
