      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0ffj9550t7mw29147ls0u0z142ij].[sum:messages:qk]&quot;' value='Inbox related messages' />
        </aliases>
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([receives]) / TOTAL(SUM([receives]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Relative - Percentage Switch' datatype='string' name='[Calculation_1570841479876251649]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 6]' />
      </column>
      <column caption='# Campaigns per User' datatype='real' name='[Calculation_1570841479924989954]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([campaign_name]) / SUM([users])' />
      </column>
      <column caption='Avg Time to Read [min]' datatype='integer' datatype-customized='true' default-format='n0;-0' name='[Calculation_2518989935341408259]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT((SUM([time_to_read]/60))&#10;/&#10;SUM([reads]))' />
      </column>
      <column caption='# Messages per User' datatype='real' name='[Calculation_2518989935372734474]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([all_messages])/SUM([users])' />
      </column>
      <column caption='% Read Rate' datatype='real' default-format='p0.00%' name='[Calculation_2518989935388364811]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([reads])/SUM([receives])' />
      </column>
      <column caption='% Delivered' datatype='real' default-format='p0.00%' name='[Calculation_2518989935388745740]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([receives]) / SUM([inbox_messages])' />
      </column>
      <column caption='Weeks after receiving' datatype='date' name='[Calculation_2518989935396794381]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATE(DATEADD(&apos;week&apos;, (DATEDIFF(&apos;week&apos;, {FIXED [channel]: MIN([received_date])},#1-1-2016#)), [received_date]))' />
      </column>
      <column caption='Dimension 1' datatype='string' name='[Calculation_2518990003865186305]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;  WHEN &apos;Region&apos; THEN [region]&#10;  WHEN &apos;Country Code&apos; THEN [country_code]&#10;  WHEN &apos;Application Name&apos; THEN [application_name]&#10;  WHEN &apos;Campaign Name&apos; THEN [campaign_name]&#10;  WHEN &apos;Channel&apos; THEN [channel]&#10;  WHEN &apos;Report Week&apos; THEN [report_week]&#10;  WHEN &apos;Platform&apos; THEN [platform]&#10;END' />
      </column>
      <column caption='Inbox Messages read within 24h' datatype='real' name='[Calculation_3580995027842605056]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([reads_24h]) / SUM([inbox_messages])' />
      </column>
      <column caption='Sort metric' datatype='real' name='[Calculation_3640315874208833541]' role='measure' type='quantitative'>
