            <connection CATALOG='dhh-ncr-stg' EXECCATALOG='dhh-ncr-stg' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='dhh-ncr-stg' schema='dev_sales_revenue' server-oauth='' username='yexi.yuan@foodpanda.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1ptl62j10m0k6a12wruc110pa3e4' name='Custom SQL Query' type='text'>WITH entity AS (
  SELECT
    management_entity
    ,segment
    ,country_name
    ,brand_name
    ,global_entity_id
   FROM
        `fulfillment-dwh-production.curated_data_shared_coredata.global_entities`
    WHERE is_entity_online = TRUE
      AND management_entity NOT IN (&apos;Instashop&apos;, &apos;Zomato&apos;, &apos;Woowa&apos;)
)

,orders AS (
  SELECT
    order_id
    ,vendor_id
    ,o.global_entity_id
    ,placed_at
    ,placed_at_local
    ,fx_rate_eur fx_rate
    ,MAX(COALESCE(value.gmv_eur, 0)) gmv_eur
    ,MAX(COALESCE(value.gbv_eur, 0)) gfv_eur
    ,MAX(COALESCE(value.gmv_local, 0)) gmv_local
    ,MAX(COALESCE(value.gbv_local, 0)) gfv_local
  FROM `fulfillment-dwh-production.curated_data_shared_central_dwh.orders` AS o
  WHERE is_sent IS TRUE
    AND DATE(placed_at) &gt;&gt;= &apos;2023-07-03&apos;
    AND is_net_order IS TRUE
  GROUP BY 1,2,3,4,5,6
)

,orders_inct AS (
  SELECT 
    TIMESTAMP_TRUNC(transaction_timestamp, HOUR) transaction_timestamp
    ,EXTRACT(HOUR FROM transaction_timestamp) txn_hour
    ,transaction_date
    ,txn.global_entity_id
    ,management_entity
    ,country_name
    ,brand_name
    ,txn.order_id
    ,SAFE_DIVIDE(total_incentive_value_local, fx_rate) total_incentives_eur
    ,SAFE_DIVIDE(sponsor_value_local_vendor, fx_rate) vendor_funded_incentives_eur
    ,SAFE_DIVIDE(sponsor_value_local_platform, fx_rate) platform_funded_incentives_eur
    ,SAFE_DIVIDE(sponsor_value_local_third_party, fx_rate) third_party_funded_incentives_eur
  FROM `dhh-ncr-live.dbt_sales_revenue_curated.customer_incentive_transactions` txn
    INNER JOIN orders ord
      ON txn.order_id = ord.order_id
      AND txn.global_entity_id = ord.global_entity_id
    LEFT JOIN entity ent
      ON txn.global_entity_id = ent.global_entity_id
  WHERE transaction_date &gt;&gt;= &quot;2023-07-03&quot;
    AND txn.global_entity_id IN (SELECT global_entity_id FROM entity)
)

SELECT
  transaction_timestamp
  ,txn_hour
  ,transaction_date
  ,management_entity
  ,country_name
  ,brand_name
  ,COUNT(order_id) num_inct_orders
  ,COUNT(CASE WHEN vendor_funded_incentives_eur &gt;&gt; 0 THEN order_id END) num_vendor_inct_orders
  ,COUNT(CASE WHEN platform_funded_incentives_eur &gt;&gt; 0 THEN order_id END) num_platform_inct_orders
  ,COUNT(CASE WHEN third_party_funded_incentives_eur &gt;&gt; 0 THEN order_id END) num_third_party_inct_orders
  ,SUM(total_incentives_eur) total_incentives_eur
  ,SUM(vendor_funded_incentives_eur) vendor_funded_incentives_eur
  ,SUM(platform_funded_incentives_eur) platform_funded_incentives_eur
  ,SUM(third_party_funded_incentives_eur) third_party_funded_incentives_eur
FROM orders_inct
GROUP BY 1,2,3,4,5,6</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
