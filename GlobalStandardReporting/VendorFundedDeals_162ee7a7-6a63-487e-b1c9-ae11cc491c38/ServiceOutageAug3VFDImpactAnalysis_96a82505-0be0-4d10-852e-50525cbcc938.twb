      <aliases enabled='yes' />
      <column caption='VFD Amount (3Aug)' datatype='real' name='[Calculation_2538482133830316032]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [transaction_date] = DATE(&apos;2023-08-03&apos;) THEN [vendor_funded_incentives_eur] END)' />
      </column>
      <column caption='VFD Amount (-1D)' datatype='real' name='[Calculation_2538482133830725633]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [transaction_date] = DATE(&apos;2023-08-02&apos;) THEN [vendor_funded_incentives_eur] END)' />
      </column>
      <column caption='vs VFD Amount 1 Day Ago' datatype='real' name='[Calculation_2538482133831737348]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2538482133830316032]/[Calculation_2538482133830725633]-1' />
      </column>
      <column caption='Est. VFD Amount Loss (vs 1 Day)' datatype='real' name='[Calculation_2538482133833310215]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2538482133830316032] - [Calculation_2538482133830725633]' />
      </column>
      <column caption='Est. Avg VFD Amount Loss' datatype='real' name='[Calculation_2538482133834264586]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_2538482133833310215]+[Est. VFD Amount Loss (vs 1 Week) (copy)_2538482133834178569]+[Est. VFD Amount Loss (vs 1 Day) (copy)_2538482133834027016])/3' />
      </column>
      <column caption='Est. % Avg VFD Amount Loss ' datatype='real' name='[Calculation_2538482133835206668]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_2538482133831737348]+[vs VFD Amount 1 Day Ago (copy)_2538482133832208389]+[vs VFD Amount 1 Day Ago (copy)_2538482133832208389])/3' />
      </column>
      <column caption='Est. VFD Amount Loss (vs 1 Week)' datatype='real' name='[Est. VFD Amount Loss (vs 1 Day) (copy)_2538482133834027016]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2538482133830316032] - [VFD Amount (-1D) (copy)_2538482133831139330]' />
      </column>
      <column caption='Est. VFD Amount Loss (vs 1 Month)' datatype='real' name='[Est. VFD Amount Loss (vs 1 Week) (copy)_2538482133834178569]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2538482133830316032] - [VFD Amount (-1W) (copy)_2538482133831520259]' />
      </column>
      <column caption='VFD Amount (-1W)' datatype='real' name='[VFD Amount (-1D) (copy)_2538482133831139330]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [transaction_date] = DATE(&apos;2023-07-27&apos;) THEN [vendor_funded_incentives_eur] END)' />
      </column>
      <column caption='VFD Amount (-1M)' datatype='real' name='[VFD Amount (-1W) (copy)_2538482133831520259]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [transaction_date] = DATE(&apos;2023-07-06&apos;) THEN [vendor_funded_incentives_eur] END)' />
      </column>
