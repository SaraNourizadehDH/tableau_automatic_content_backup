    <worksheet name='KPI New Or Reactivated Vendors'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontname='Tableau Bold' fontsize='12'>% New Or Reactivated Vendors With Active Deals</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='vfd_vendor_lifecycle' name='federated.0244iyr1sr38la15ykcsi095ogua' />
          </datasources>
          <datasource-dependencies datasource='federated.0244iyr1sr38la15ykcsi095ogua'>
            <column caption='Include Current Month?' datatype='boolean' name='[Calculation_1356779823286517760]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,{MAX(DATETRUNC(&apos;month&apos;,[active_month]))},DATETRUNC(&apos;month&apos;,[active_month])) = 0' />
            </column>
            <column caption='# New / Re-activated Vendors (SS)' datatype='integer' name='[Calculation_5877690096366227456]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([new_ss_vendors]) + SUM([reactivated_ss_vendors])' />
            </column>
            <column caption='Non-Discount Vendors (Lag 1)' datatype='integer' name='[Calculation_5877690096533209090]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([prev_period_vendors_online]) - SUM([prev_period_deal_vendors])' />
            </column>
            <column caption='% New / Reactivated Vendors' datatype='real' name='[Calculation_5877690096534560775]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5877690096366227456] / [Calculation_5877690096533209090]' />
            </column>
            <column caption='period' datatype='date' name='[active_month]' role='dimension' type='ordinal' />
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[active_month]' derivation='Month' name='[mn:active_month:ok]' pivot='key' type='ordinal' />
