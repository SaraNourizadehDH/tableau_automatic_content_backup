),

monthly_agg_portal_adoption AS (
  SELECT
    DATE_TRUNC(date, MONTH) active_month
    ,global_entity_id
    ,segment
    ,management_entity
    ,country
    ,SUM(portal_enabled) portal_enabled
    ,SUM(portal_active) portal_active
    ,SUM(portal_assumed_active) portal_assumed_active
    ,SUM(qty_vendors_online) qty_vendors_online
  FROM portal_active_agg
  WHERE TRUE
    -- AND is_zombie = FALSE
    AND store_type_l2 IN (&apos;restaurant&apos;, &apos;restaurants&apos;)
    AND device = &apos;All&apos;
    AND granularity = &apos;Monthly&apos;
  GROUP BY 1,2,3,4,5
),

weekly_agg_portal_adoption AS (
  SELECT
    DATE_TRUNC(date, ISOWEEK) active_week
    ,global_entity_id
    ,segment
    ,management_entity
    ,country
    ,SUM(portal_enabled) portal_enabled
    ,SUM(portal_active) portal_active
    ,SUM(portal_assumed_active) portal_assumed_active
    ,SUM(qty_vendors_online) qty_vendors_online
  FROM portal_active_agg
  WHERE TRUE
    -- AND is_zombie = FALSE
    AND store_type_l2 IN (&apos;restaurant&apos;, &apos;restaurants&apos;)
    AND device = &apos;All&apos;
    AND granularity = &apos;Weekly&apos;
  GROUP BY 1,2,3,4,5
),
-- NON VFD Vendors --
active_deal_vendors AS (
  SELECT
    date active_date
    ,global_entity_id
    ,vendor_id
    ,CONCAT(global_entity_id,&apos;,&apos;,vendor_id) global_vendor_id
    ,LAG(date) OVER (PARTITION BY global_entity_id, vendor_id ORDER BY date) prev_active_date
  FROM `dhh-ncr-live.analytics.vendor_funded_deals_daily_active_status`
    WHERE num_ss_active_deals &gt;&gt; 0 
      AND date &gt;&gt;= &apos;2022-01-01&apos;
      AND global_entity_id IN (SELECT global_entity_id FROM entity WHERE management_entity IN (&apos;Foodpanda APAC&apos;, &apos;DH Europe&apos;, &apos;Pedidosya&apos;, &apos;Yemeksepeti&apos;))
),
prev_active_month AS (
  SELECT
    *
    ,DATE_DIFF(active_date, prev_active_date, MONTH) &gt;&gt; 1 new_active
    ,DATE_DIFF(active_date, prev_active_date, MONTH) IS NULL first_active
  FROM active_deal_vendors
),
monthly_agg_non_vfd_active_deals AS (
  SELECT
    DATE_TRUNC(active_date, MONTH) active_month
    ,global_entity_id
    ,COUNT(DISTINCT CASE WHEN new_active = TRUE THEN global_vendor_id END) new_vfd_active_vendors
    ,COUNT(DISTINCT CASE WHEN first_active = TRUE THEN global_vendor_id END) first_vfd_active_vendors
    ,COUNT(DISTINCT CASE WHEN new_active = TRUE OR first_active = TRUE THEN global_vendor_id END) non_vfd_active_vendors
  FROM prev_active_month
  GROUP BY 1,2
),
weekly_agg_non_vfd_active_deals AS (
  SELECT
    DATE_TRUNC(active_date, ISOWEEK) active_week
    ,global_entity_id
    ,COUNT(DISTINCT CASE WHEN new_active = TRUE THEN global_vendor_id END) new_vfd_active_vendors
    ,COUNT(DISTINCT CASE WHEN first_active = TRUE THEN global_vendor_id END) first_vfd_active_vendors
    ,COUNT(DISTINCT CASE WHEN new_active = TRUE OR first_active = TRUE THEN global_vendor_id END) non_vfd_active_vendors
  FROM prev_active_month
  GROUP BY 1,2
),
-- NON VFD Vendors End --

monthly_online_active AS (
  SELECT
    agg.active_month active_period
    ,&apos;Monthly&apos; granularity
    ,CASE
      WHEN agg.management_entity IN (&apos;DH Austria&apos;,&apos;DH CEE&apos;,&apos;DH Nordics&apos;,&apos;DH Europe&apos;) THEN &apos;Pandora Europe&apos;
      ELSE agg.management_entity
    END region
    ,agg.global_entity_id
    ,agg.segment
    ,agg.management_entity
    ,agg.country
    ,agg.portal_enabled portal_enabled_vendors
    ,agg.portal_active low_band_vendor_adoption
    ,agg.portal_assumed_active high_band_vendor_adoption
    ,agg.qty_vendors_online vendors_online
    ,avd.vendors_w_deals
    ,avd.vendors_w_ss_deals
  FROM monthly_agg_portal_adoption agg
    LEFT JOIN monthly_active_deal avd
      ON agg.active_month = avd.active_month
      AND agg.global_entity_id = avd.global_entity_id
  WHERE agg.global_entity_id IN (SELECT global_entity_id FROM entity)
),

monthly_online_active_non_vfd AS (
  SELECT
    act.*
    ,LAG(act.vendors_online - act.vendors_w_deals, 1) OVER (PARTITION BY act.global_entity_id ORDER BY active_period) prev_vendors_w_no_active_deals
    ,non.new_vfd_active_vendors
    ,non.first_vfd_active_vendors
    ,non.non_vfd_active_vendors
  FROM monthly_online_active act
    LEFT JOIN monthly_agg_non_vfd_active_deals non
      ON act.active_period = non.active_month
      AND act.global_entity_id = non.global_entity_id
),

weekly_online_active AS (
  SELECT
    agg.active_week active_period
    ,&apos;Weekly&apos; granularity
    ,CASE
      WHEN agg.management_entity IN (&apos;DH Austria&apos;,&apos;DH CEE&apos;,&apos;DH Nordics&apos;,&apos;DH Europe&apos;) THEN &apos;DH Europe&apos;
      ELSE agg.management_entity
    END region
    ,agg.global_entity_id
    ,agg.segment
    ,agg.management_entity
    ,agg.country
    ,agg.portal_enabled portal_enabled_vendors
    ,agg.portal_active low_band_vendor_adoption
    ,agg.portal_assumed_active high_band_vendor_adoption
    ,agg.qty_vendors_online vendors_online
    ,avd.vendors_w_deals
    ,avd.vendors_w_ss_deals
  FROM weekly_agg_portal_adoption agg
    LEFT JOIN weekly_active_deal avd
      ON agg.active_week = avd.active_week
      AND agg.global_entity_id = avd.global_entity_id
  WHERE agg.global_entity_id IN (SELECT global_entity_id FROM entity)
),

weekly_online_active_non_vfd AS (
  SELECT
    act.*
    ,LAG(act.vendors_online - act.vendors_w_deals, 1) OVER (PARTITION BY act.global_entity_id ORDER BY active_period) prev_vendors_w_no_active_deals
    ,non.new_vfd_active_vendors
    ,non.first_vfd_active_vendors
    ,non.non_vfd_active_vendors
  FROM weekly_online_active act
    LEFT JOIN weekly_agg_non_vfd_active_deals non
      ON act.active_period = non.active_week
      AND act.global_entity_id = non.global_entity_id
)

SELECT
  *
FROM (
  SELECT * FROM monthly_online_active_non_vfd
  UNION ALL
  SELECT * FROM weekly_online_active_non_vfd
)
WHERE region IN (&apos;Foodpanda APAC&apos;, &apos;DH Europe&apos;, &apos;Yemeksepeti&apos;, &apos;Pedidosya&apos;, &apos;Talabat&apos;, &apos;HungerStation&apos;)</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
