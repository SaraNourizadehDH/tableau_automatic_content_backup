last_180_days_visits_flag AS (
  SELECT
    *
    ,DATE_DIFF(session_date, prev_session_date, DAY) days_since_last_visit
    ,CASE WHEN DATE_DIFF(session_date, prev_session_date, DAY) &gt;&gt; 180 THEN TRUE ELSE FALSE END is_new_visit
    ,CASE WHEN DATE_DIFF(session_date, prev_session_date, DAY) IS NULL THEN TRUE ELSE FALSE END is_first_time_visit
  FROM vfd_sessions
),

total_monthly_logins AS (
  SELECT
    DATE_TRUNC(session_date, MONTH) visit_month
    ,global_entity_id
    ,COUNT(DISTINCT user_id) total_users
  FROM total_sessions
  WHERE session_date &gt;&gt;= &apos;2022-01-01&apos;
    AND global_entity_id IN (SELECT global_entity_id FROM entity)
  GROUP BY 1,2
),

cte_monthly_non_vfd_users AS (
  SELECT
    DATE_TRUNC(session_date, MONTH) visit_month
    ,global_entity_id
    ,COUNT(DISTINCT user_id) total_vfd_users
    ,COUNT(DISTINCT CASE WHEN is_new_visit = TRUE AND is_first_time_visit = FALSE THEN user_id END) new_vfd_users
    ,COUNT(DISTINCT CASE WHEN is_first_time_visit = TRUE AND is_new_visit = FALSE THEN user_id END) first_visit_vfd_users
    ,COUNT(DISTINCT CASE WHEN is_first_time_visit = TRUE OR is_new_visit = TRUE THEN user_id END) non_vfd_users
  FROM prev_month_visits_flag vfd
  WHERE session_date &gt;&gt;= &apos;2022-01-01&apos;
    AND global_entity_id IN (SELECT global_entity_id FROM entity)
  GROUP BY 1,2
),

total_daily_logins AS (
  SELECT
    DATE_TRUNC(session_date, DAY) visit_day
    ,global_entity_id
    ,COUNT(DISTINCT user_id) total_users
  FROM total_sessions
  WHERE session_date &gt;&gt;= &apos;2022-01-01&apos;
    AND global_entity_id IN (SELECT global_entity_id FROM entity)
  GROUP BY 1,2
),

cte_daily_non_vfd_users AS (
  SELECT
    DATE_TRUNC(session_date, DAY) visit_day
    ,global_entity_id
    ,COUNT(DISTINCT user_id) total_vfd_users
    ,COUNT(DISTINCT CASE WHEN is_new_visit = TRUE AND is_first_time_visit = FALSE THEN user_id END) new_vfd_users
    ,COUNT(DISTINCT CASE WHEN is_first_time_visit = TRUE AND is_new_visit = FALSE THEN user_id END) first_visit_vfd_users
    ,COUNT(DISTINCT CASE WHEN is_first_time_visit = TRUE OR is_new_visit = TRUE THEN user_id END) non_vfd_users
  FROM prev_month_visits_flag vfd
  WHERE session_date &gt;&gt;= &apos;2022-01-01&apos;
    AND global_entity_id IN (SELECT global_entity_id FROM entity)
  GROUP BY 1,2
),

monthly_agg_non_vfd_users AS (
  SELECT
    total.visit_month visit_period
    ,&apos;monthly&apos; granularity
    ,total.global_entity_id
    ,management_entity
    ,brand
    ,country_name
    ,CASE
      WHEN entity.global_entity_id = &apos;YS_TR&apos; THEN &apos;Yemeksepeti&apos;
      ELSE entity.management_entity
    END reporting_entity
    ,total.total_users
    ,total_vfd_users
    ,new_vfd_users
    ,first_visit_vfd_users
    ,non_vfd_users
  FROM total_monthly_logins total
    LEFT JOIN cte_monthly_non_vfd_users vfd
      ON total.visit_month = vfd.visit_month
      AND total.global_entity_id = vfd.global_entity_id
    LEFT JOIN entity
      ON total.global_entity_id = entity.global_entity_id
  WHERE management_entity IS NOT NULL
  ORDER BY 1
),

daily_agg_non_vfd_users AS (
  SELECT
    total.visit_day visit_period
    ,&apos;daily&apos; granularity
    ,total.global_entity_id
    ,management_entity
    ,brand
    ,country_name
    ,CASE
      WHEN entity.global_entity_id = &apos;YS_TR&apos; THEN &apos;Yemeksepeti&apos;
      ELSE entity.management_entity
    END reporting_entity
    ,total.total_users
    ,total_vfd_users
    ,new_vfd_users
    ,first_visit_vfd_users
    ,non_vfd_users
  FROM total_daily_logins total
    LEFT JOIN cte_daily_non_vfd_users vfd
      ON total.visit_day = vfd.visit_day
      AND total.global_entity_id = vfd.global_entity_id
    LEFT JOIN entity
      ON total.global_entity_id = entity.global_entity_id
  WHERE management_entity IS NOT NULL
  ORDER BY 1
)

SELECT
  *
FROM (
  SELECT * FROM monthly_agg_non_vfd_users
  UNION ALL
  SELECT * FROM daily_agg_non_vfd_users
)</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
