prev_month_visits_flag AS (
  SELECT
    *
    ,DATE_DIFF(session_date, prev_session_date, DAY) days_since_last_visit
    ,CASE WHEN DATE_DIFF(session_date, prev_session_date, MONTH) &gt;&gt; 1 THEN TRUE ELSE FALSE END is_new_visit
    ,CASE WHEN DATE_DIFF(session_date, prev_session_date, MONTH) IS NULL THEN TRUE ELSE FALSE END is_first_time_visit
  FROM vfd_sessions
