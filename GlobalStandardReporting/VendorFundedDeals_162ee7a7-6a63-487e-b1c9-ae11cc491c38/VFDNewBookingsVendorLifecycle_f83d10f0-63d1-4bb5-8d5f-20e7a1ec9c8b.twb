            <map to='#fc7d0b'>
              <bucket>&quot;[federated.0szzl741o9scrr1ckgng90zyxrw9 (copy)].[usr:Calculation_5081678925276180487:qk]&quot;</bucket>
            </map>
          </encoding>
        </style-rule>
      </style>
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;Singapore&quot;' />
      </semantic-values>
      <filter class='categorical' column='[management_entity]' filter-group='2'>
        <groupfilter function='except' user:ui-domain='database' user:ui-enumeration='exclusive' user:ui-marker='enumerate'>
          <groupfilter function='level-members' level='[management_entity]' />
          <groupfilter function='member' level='[management_entity]' member='&quot;HungerStation&quot;' />
        </groupfilter>
      </filter>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_99E3B14A84814A8E8130F0A6A3F6B944'>
            <properties context=''>
              <relation connection='bigquery.1bnxlve0wdga851b5tn341743pzs (copy)' name='Custom SQL Query' type='text'>WITH entity AS (
  SELECT
    management_entity
    ,segment
    ,country_name
    ,sub_entity
    ,brand_name
    ,global_entity_id
  FROM `fulfillment-dwh-production.curated_data_shared_coredata.global_entities`
    WHERE is_entity_online = TRUE
      AND is_reporting_enabled = TRUE
)

SELECT
  CASE
    WHEN global_entity_id = &apos;YS_TR&apos; THEN &apos;Yemeksepeti&apos;
  ELSE entity.management_entity
  END reporting_entity
  ,entity.sub_entity
  ,entity.country_name
  ,entity.segment
  ,entity.brand_name
  ,entity.management_entity

  ,DATE_TRUNC(created_date, QUARTER) report_period
  -- === INCENTIVES === --
  -- TOTAL INCENTIVES --
  ,COUNT(DISTINCT pkey) incentive_count
  ,COUNT(DISTINCT customer_incentive_id) incentive_id_count
  
  -- DISCOUNT VS VOUCHERS --
  ,COUNT(DISTINCT
    CASE WHEN incentive_category = &apos;discount&apos; THEN pkey END
  ) discount_incentive_count
  ,COUNT(DISTINCT
    CASE WHEN incentive_category = &apos;voucher&apos; THEN pkey END
  ) voucher_incentive_count

  -- SELF-SERVICE --
  ,COUNT(DISTINCT
    CASE 
      WHEN is_self_service = TRUE 
      THEN pkey
    END
  ) ss_incentive_count
  ,COUNT(DISTINCT
    CASE 
      WHEN incentive_category = &apos;discount&apos;  
      AND is_self_service = TRUE 
      THEN pkey
    END
  ) ss_discount_incentive_count
  ,COUNT(DISTINCT
    CASE 
      WHEN incentive_category = &apos;voucher&apos; 
      AND is_self_service = TRUE 
      THEN pkey
    END
  ) ss_voucher_incentive_count

  -- ITEM-LEVEL --
  ,COUNT(DISTINCT
    CASE 
      WHEN incentive_category = &apos;discount&apos;  
      AND is_item_level = TRUE
      THEN pkey
    END
  ) item_discount_incentive_count
  ,COUNT(DISTINCT
    CASE 
      WHEN incentive_category = &apos;discount&apos;  
      AND is_self_service = TRUE 
      AND is_item_level = TRUE
      THEN pkey
    END
  ) ss_item_discount_incentive_count
  ,COUNT(DISTINCT
    CASE 
      WHEN incentive_category = &apos;voucher&apos; 
      AND is_item_level = TRUE
      THEN pkey
    END
  ) item_voucher_incentive_count
  ,COUNT(DISTINCT
    CASE 
      WHEN incentive_category = &apos;voucher&apos; 
      AND is_self_service = TRUE 
      AND is_item_level = TRUE
      THEN pkey
    END
  ) ss_item_voucher_incentive_count

  -- === VENDORS === --
  -- TOTAL INCENTIVES --
  ,COUNT(DISTINCT vendor_id) incentive_vendor_count
  
  -- DISCOUNT VS VOUCHERS --
  ,COUNT(DISTINCT
    CASE WHEN incentive_category = &apos;discount&apos; THEN vendor_id END
  ) discount_vendor_count
  ,COUNT(DISTINCT
    CASE WHEN incentive_category = &apos;voucher&apos; THEN vendor_id END
  ) voucher_vendor_count

  -- SELF-SERVICE --
  ,COUNT(DISTINCT
    CASE 
      WHEN is_self_service = TRUE 
      THEN vendor_id
    END
  ) ss_incentive_vendor_count
  ,COUNT(DISTINCT
    CASE 
      WHEN incentive_category = &apos;discount&apos;  
      AND is_self_service = TRUE 
      THEN vendor_id
    END
  ) ss_discount_vendor_count
  ,COUNT(DISTINCT
    CASE 
      WHEN incentive_category = &apos;voucher&apos; 
      AND is_self_service = TRUE 
      THEN vendor_id
    END
  ) ss_voucher_vendor_count

  -- ITEM-LEVEL --
  ,COUNT(DISTINCT
    CASE 
      WHEN incentive_category = &apos;discount&apos;  
      AND is_item_level = TRUE
      THEN vendor_id
    END
  ) item_discount_vendor_count
  ,COUNT(DISTINCT
    CASE 
      WHEN incentive_category = &apos;discount&apos;  
      AND is_self_service = TRUE 
      AND is_item_level = TRUE
      THEN vendor_id
    END
  ) ss_item_discount_vendor_count
  ,COUNT(DISTINCT
    CASE 
      WHEN incentive_category = &apos;voucher&apos; 
      AND is_item_level = TRUE
      THEN vendor_id
    END
  ) item_voucher_vendor_count
  ,COUNT(DISTINCT
    CASE 
      WHEN incentive_category = &apos;voucher&apos; 
      AND is_self_service = TRUE 
      AND is_item_level = TRUE
      THEN vendor_id
    END
  ) ss_item_voucher_vendor_count

FROM `dhh-ncr-stg.dev_sales_revenue.vendor_funded_incentive_bookings`
  LEFT JOIN entity USING(global_entity_id)
WHERE created_date &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 24 MONTH)
GROUP BY 1,2,3,4,5,6,7</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
