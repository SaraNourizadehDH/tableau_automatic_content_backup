    WHERE management_entity IN (&apos;Foodpanda APAC&apos;, &apos;DH Europe&apos;, &apos;Pedidosya&apos;)
      AND is_platform_online = TRUE
),

total_sessions AS (
  SELECT
    session_id
    ,user_id
    ,session_date
    ,MAX(CASE WHEN cust.index=3 THEN SPLIT(cust.value,&apos;;&apos;)[OFFSET(0)] END) global_entity_id
    ,LAG(session_date) OVER (PARTITION BY user_id ORDER BY session_date) prev_session_date
  FROM `fulfillment-dwh-production.cl_sales_revenue.vp_ga_sessions`
    LEFT JOIN UNNEST(hits) AS hits
    LEFT JOIN UNNEST(hits.custom_dimensions) cust
  WHERE TRUE
    AND session_date &gt;&gt;= &apos;2021-06-01&apos;
    AND ga_export_name = &apos;Web&apos;
  GROUP BY 1,2,3
),

vfd_sessions AS (
  SELECT
    session_id
    ,user_id
    ,session_date
    ,MAX(CASE WHEN cust.index=3 THEN SPLIT(cust.value,&apos;;&apos;)[OFFSET(0)] END) global_entity_id
    ,LAG(session_date) OVER (PARTITION BY user_id ORDER BY session_date) prev_session_date
  FROM `fulfillment-dwh-production.cl_sales_revenue.vp_ga_sessions`
    LEFT JOIN UNNEST(hits) AS hits
    LEFT JOIN UNNEST(hits.custom_dimensions) cust
  WHERE TRUE
    AND session_date &gt;&gt;= &apos;2021-06-01&apos;
    AND ga_export_name = &apos;Web&apos;
    AND hits.event_info.event_category LIKE &apos;%vfd&apos;
  GROUP BY 1,2,3
