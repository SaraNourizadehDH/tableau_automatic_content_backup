      <aliases enabled='yes' />
      <column caption='# New / Re-activated Vendors (Overall)' datatype='integer' name='[# New / Re-activated Vendors (SS) (copy)_5081678924876754946]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([new_total_vendors]) + SUM([reactivated_total_vendors])' />
      </column>
      <column caption='% MoM Self-Service Growth' datatype='real' name='[% MoM Churn Rate (copy)_1356779823288991746]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ss_vendors]) / SUM([prev_period_ss_vendors]) - 1' />
      </column>
      <column caption='% MoM Overall Growth' datatype='real' name='[% MoM Self-Service Growth (copy)_5081678924875415553]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([deal_vendors]) / SUM([prev_period_deal_vendors]) - 1' />
      </column>
      <column caption='% New / Reactivated Vendors (Overall)' datatype='real' name='[% New / Reactivated Vendors (copy)_5081678924877287427]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[# New / Re-activated Vendors (SS) (copy)_5081678924876754946] / [Calculation_5877690096533209090]' />
      </column>
      <column caption='% New Or Reactivated Non-VFD Vendors (Ex-Talabat)' datatype='real' name='[% New Or Reactivated Non-VFD Vendors (copy)_5877690096536236040]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5877690096534081541] / [Calculation_5877690096533209090]' />
      </column>
      <column caption='% Overall Churn' datatype='real' name='[% Self-Service Churn (copy)_5081678924881715204]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([churned_total_vendors])/SUM([prev_period_deal_vendors])' />
      </column>
      <column caption='% New Vendors (SS)' datatype='real' name='[% Self-Service Churn (copy)_739505199280865282]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([new_ss_vendors])/SUM([ss_vendors])' />
      </column>
      <column caption='% Self-Service New Or Re-activated' datatype='real' name='[% Self-Service New (copy)_5877690096367579137]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([new_ss_vendors]) + SUM([reactivated_ss_vendors])) / SUM([ss_vendors])' />
      </column>
      <column caption='% Re-activated Vendors (SS)' datatype='real' name='[% Self-Service New (copy)_739505199281360899]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([reactivated_ss_vendors])/SUM([ss_vendors])' />
      </column>
      <column caption='% Overall Retention' datatype='real' name='[% Self-Service Retention (copy)_5081678924871675904]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([retained_total_vendors])/SUM([prev_period_deal_vendors])' />
      </column>
      <column caption='% Self-Service Churn' datatype='real' name='[% Self-Service Retention (copy)_739505199279628289]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([churned_ss_vendors])/SUM([prev_period_ss_vendors])' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0244iyr1sr38la15ykcsi095ogua].[usr:Calculation_5877690096534560775:qk]&quot;' value='% New / Reactivated Vendors (SS)' />
        </aliases>
      </column>
      <column caption='Include Current Month?' datatype='boolean' name='[Calculation_1356779823286517760]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,{MAX(DATETRUNC(&apos;month&apos;,[active_month]))},DATETRUNC(&apos;month&apos;,[active_month])) = 0' />
      </column>
      <column caption='% Active Self-Service Vendors' datatype='real' name='[Calculation_5834342951002415104]' role='measure' type='quantitative'>
