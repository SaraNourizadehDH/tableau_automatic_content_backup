            </column>
            <column caption='# Vendors with VP Visit' datatype='integer' name='[Calculation_1916422379704471575]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    IF [vp_sessions] &gt; 0 &#10;    AND [Calculation_1916422379209945091] = FALSE&#10;    THEN [vendor_id] END&#10;)' />
            </column>
            <column caption='# Potential Vendors Converted' datatype='real' name='[Calculation_1916422379712282650]' role='measure' type='quantitative'>
