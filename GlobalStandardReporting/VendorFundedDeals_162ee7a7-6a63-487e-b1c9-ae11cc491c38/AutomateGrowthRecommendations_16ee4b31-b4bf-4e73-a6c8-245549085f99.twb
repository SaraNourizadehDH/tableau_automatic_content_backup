      <column caption='Eligibility' datatype='string' name='[Calculation_1916422379211321348]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1916422379209945091] = FALSE &#10;THEN &apos;Already have existing SL booking&apos; ELSE &apos;Eligible for AG&apos; END' />
      </column>
      <column caption='Is Low Rating?' datatype='boolean' name='[Calculation_1916422379251163141]' role='dimension' type='nominal'>
