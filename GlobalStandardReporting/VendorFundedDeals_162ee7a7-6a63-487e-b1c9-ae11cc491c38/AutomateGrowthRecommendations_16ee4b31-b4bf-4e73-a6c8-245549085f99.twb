          <datasource-dependencies datasource='federated.08y5zqt19gk6ne14oa8ji0us750o'>
            <column caption='# Potential Vendors AG Visit' datatype='real' name='[# Potential Vendors Converted (copy)_1916422379713269787]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1] * [Calculation_1916422379704471575]' />
            </column>
            <column caption='# Vendors without Existing SL' datatype='integer' name='[# Vendors with Existing SL (copy)_1916422379710992409]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    IF [Calculation_1916422379209945091] = FALSE THEN [vendor_id] END&#10;)' />
            </column>
            <column caption='# Vendors with VFD Visit' datatype='integer' name='[# Vendors with VP Visit (copy)_1916422379709788184]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    IF [vfd_sessions] &gt; 0 THEN [vendor_id] END&#10;)' />
            </column>
            <column caption='# Vendors' datatype='integer' name='[Calculation_1916422378993889280]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([vendor_id])' />
            </column>
            <column caption='Have CPC Booking' datatype='boolean' name='[Calculation_1916422379209945091]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [booking_source] != &apos;Null&apos; THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='# Vendors with Rating &lt; 3.0' datatype='integer' name='[Calculation_1916422379701252116]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    IF [original_rating_total] &lt; 3&#10;    THEN [vendor_id] END&#10;)' />
            </column>
            <column caption='# Vendors with VP Visit' datatype='integer' name='[Calculation_1916422379704471575]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    IF [vp_sessions] &gt; 0 &#10;    AND [Calculation_1916422379209945091] = FALSE&#10;    THEN [vendor_id] END&#10;)' />
            </column>
            <column caption='# Potential Vendors Converted' datatype='real' name='[Calculation_1916422379712282650]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Parameters].[Parameter 2] * [# Potential Vendors Converted (copy)_1916422379713269787]' />
            </column>
