          <datasource-dependencies datasource='federated.08y5zqt19gk6ne14oa8ji0us750o'>
            <column caption='% Vendors' datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1916422378993889280] / TOTAL([Calculation_1916422378993889280])'>
                <table-calc ordering-type='Columns' />
              </calculation>
            </column>
            <column caption='# Vendors' datatype='integer' name='[Calculation_1916422378993889280]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([vendor_id])' />
            </column>
            <column caption='GMV (€)' datatype='real' name='[Calculation_1916422379209469954]' role='measure' type='quantitative'>
