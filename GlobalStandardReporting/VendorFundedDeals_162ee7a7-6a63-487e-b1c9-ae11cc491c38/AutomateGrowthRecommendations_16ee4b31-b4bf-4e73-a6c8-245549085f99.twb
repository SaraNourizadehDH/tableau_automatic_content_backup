      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_1F8964CA05CC41AB93929992D010E734'>
            <properties context=''>
              <relation connection='bigquery.1gy91uq04bumle16d9rt9009y7q4' name='Custom SQL Query' type='text'><![CDATA[WITH entity AS (
  SELECT
    global_entity_id
  FROM `fulfillment-dwh-production.curated_data_shared_coredata.global_entities`
  WHERE is_entity_online = TRUE
    AND is_reporting_enabled = TRUE
    AND management_entity IN ('Talabat')
)

-- , cpc_reco AS (
--   SELECT
--     *
--   FROM `dhh-ncr-live.analytics.ceb_log_with_bookings`
-- )

, cpc_bookings AS (
  SELECT
    -- date_month
    global_entity_id
    ,vendor_id
    ,MAX(booking_source) AS booking_source
  FROM `dhh-ncr-live.analytics.ad_tech_il_cpc`
  WHERE management_entity = 'Talabat'
    AND date_month = DATE_TRUNC(CURRENT_DATE, MONTH)
  GROUP BY 1,2
)

, vendor_ratings AS (
  SELECT
    global_entity_id
    ,vendor_id
    ,DATE_TRUNC(DATE(rating_timestamp), MONTH) rating_month
    ,COUNT(order_id) rated_orders
    ,AVG(original_rating) AS avg_original_rating
    ,AVG(converted_rating) AS avg_converted_rating
  FROM `fulfillment-dwh-production.curated_data_shared_coredata_business.ratings`
  WHERE TRUE
    AND DATE_TRUNC(DATE(rating_timestamp), MONTH) = DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 1 MONTH)
    AND is_latest = TRUE
  GROUP BY 1,2,3
)

, vp_vfd_visits AS (
  SELECT
    -- event_date
    global_entity_id
    ,SPLIT(selected_vendor_id, ';')[SAFE_OFFSET(1)] AS vendor_id
    ,COUNT(DISTINCT session_id) vp_sessions
    ,COUNT(DISTINCT CASE WHEN plugin_loaded >> 0 THEN session_id END) vfd_sessions
  FROM `fulfillment-dwh-production.cl_vendor.vp_vfd_plugin_metrics`
  WHERE TRUE
    AND event_date >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 31 DAY)
    AND event_date << DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 1 DAY)
    AND global_entity_id IN (SELECT global_entity_id FROM entity)
  GROUP BY 1,2
)

, ag_reco AS (
  SELECT
    *
  FROM `dhh-ncr-stg.dev_sales_revenue.automate_growth_output_tmp`
)

, final AS (
  SELECT
    ag.*

    ,bk.booking_source

    ,COALESCE(vp.vp_sessions, 0) AS vp_sessions
    ,COALESCE(vp.vfd_sessions, 0) AS vfd_sessions

    ,COALESCE(r.rated_orders, 0) AS r_rated_orders
    ,COALESCE(r.avg_original_rating, 0) AS r_avg_original_rating
    ,COALESCE(r.avg_converted_rating, 0) AS r_avg_converted_rating
    
    -- ,cpc.budget_tier_low AS cpc_budget_tier_low
    -- ,cpc.budget_tier_mid AS cpc_budget_tier_mid
    -- ,cpc.budget_tier_high AS cpc_budget_tier_high
    -- ,cpc.order_estimation_low AS cpc_order_estimation_low
    -- ,cpc.order_estimation_mid AS cpc_order_estimation_mid
    -- ,cpc.order_estimation_high AS cpc_order_estimation_high
    -- ,cpc.has_booking
  FROM ag_reco ag
    LEFT JOIN cpc_bookings bk
      ON ag.global_entity_id = bk.global_entity_id
      AND ag.vendor_id = bk.vendor_id
    LEFT JOIN vendor_ratings r
      ON ag.global_entity_id = r.global_entity_id
      AND ag.vendor_id = r.vendor_id
    -- LEFT JOIN cpc_reco cpc
    --   ON ag.global_entity_id = cpc.global_entity_id
    --   AND ag.vendor_id = cpc.vendor_id
    LEFT JOIN vp_vfd_visits vp
      ON ag.global_entity_id = vp.global_entity_id
      AND ag.vendor_id = vp.vendor_id
)

SELECT * FROM final]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
