        <calculation class='tableau' formula='CASE   [Parameters].[Parameter 1]&#13;&#10;&#13;&#10;WHEN &apos;Variant&apos; THEN [dps_test_variant]   &#13;&#10;WHEN &apos;DPS Customer Tag&apos; THEN [dps_customer_tag]&#13;&#10;WHEN &apos;Zone&apos; THEN [zone_name]&#13;&#10;WHEN &apos;Hour&apos; THEN STR([Calculation_1105633769948565504])&#13;&#10;WHEN &apos;Weekday&apos; THEN STR([Calculation_794603921684353025])&#13;&#10;WHEN &apos;Treatment&apos; THEN STR([treatment])&#13;&#10;WHEN &apos;Target Group&apos; THEN STR([target_group])&#13;&#10;&#13;&#10;END' />
