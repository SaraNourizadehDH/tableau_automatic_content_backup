              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN 1 THEN RIGHT(&quot;0&quot;+STR(DAY([created_date_local])),2) + &quot;-&quot; + LEFT(STR(DATENAME(&quot;month&quot;,[created_date_local])),3) + &quot;-&quot; + RIGHT(STR(YEAR([created_date_local])),2)&#13;&#10;WHEN 2 THEN STR([Calculation_323133335039143937])&#13;&#10;WHEN 3 THEN STR([Calculation_794603921684353025])&#13;&#10;END' />
            </column>
            <column caption='Hour (string)' datatype='string' name='[Calculation_323133335039143937]' role='dimension' type='nominal'>
