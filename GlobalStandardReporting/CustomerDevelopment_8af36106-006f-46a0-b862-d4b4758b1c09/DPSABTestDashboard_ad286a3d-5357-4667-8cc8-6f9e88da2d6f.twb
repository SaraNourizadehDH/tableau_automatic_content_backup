            </column>
            <column caption='Chosen Avg Metric (D1)' datatype='real' name='[Calculation_1177691362563993604]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[D1 Choose Metrics (copy)_1177691362562220035]&#13;&#10;&#13;&#10;WHEN &apos;MOV&apos; THEN [Avg Small Order Fee (copy)_778841320228560926]&#13;&#10;WHEN &apos;GMV&apos; THEN [Avg GFV (copy)_778841320227962906]&#13;&#10;WHEN &apos;GFV&apos; THEN [Avg Revenue (copy)_778841320226840599]&#13;&#10;WHEN &apos;Delivery Fee&apos; THEN [Avg DPS Travel Time Fee (copy)_778841320224731149]&#13;&#10;WHEN &apos;Commission&apos; THEN [Avg Dps Travel Time Fee (copy 2)_778841320224079883]&#13;&#10;WHEN &apos;Joker Vendor Fee&apos; THEN 0&#13;&#10;WHEN &apos;Service Fee&apos; THEN [Avg GFV (copy) (copy)_778841320227971099]&#13;&#10;WHEN &apos;Small Order Fee&apos; THEN [Avg GFV (copy) (copy) (copy)_778841320227979292]&#13;&#10;WHEN &apos;Priority Fee&apos; THEN [Avg Service Fee (copy)_778841320228311069]&#13;&#10;WHEN &apos;Delivery Fee&apos; THEN [Avg DPS Travel Time Fee (copy)_778841320224731149]&#13;&#10;WHEN &apos;Revenue&apos; THEN [Avg DPS Travel Time Fee (copy) (copy 2) (copy)_778841320224751632]&#13;&#10;WHEN &apos;Delivery Costs&apos; THEN [Avg Dps Travel Time Fee (copy 3)_778841320224092172]&#13;&#10;WHEN &apos;Profit&apos; THEN [Avg DPS Travel Time Fee (copy) (copy)_778841320224735246]&#13;&#10;WHEN &apos;DH Incentives&apos; THEN [Avg Revenue (copy 2) (copy)_778841320226856985]&#13;&#10;WHEN &apos;FLGP&apos; THEN [Avg Revenue (copy 2)_778841320226848792]&#13;&#10;WHEN &apos;DPS Delivery Fee&apos; THEN [Avg Basket Discount (copy)_778841320199057410]&#13;&#10;WHEN &apos;DPS Surge Fee&apos; THEN [Avg Dps Travel Time Fee (copy)_778841320200593414]&#13;&#10;WHEN &apos;DPS Travel Time Fee&apos; THEN [Avg Basket Discount (copy) (copy 2)_778841320199073796]&#13;&#10;WHEN &apos;DPS Surge Fee&apos; THEN [Avg Dps Travel Time Fee (copy)_778841320200593414]&#13;&#10;WHEN &apos;Travel Time&apos; THEN [Avg Delivery Time (copy)_778841320225804306]&#13;&#10;WHEN &apos;Delivery Distance&apos; THEN [Avg DPS Travel Time Fee (copy) (copy 2)_778841320224743439]&#13;&#10;WHEN &apos;To Customer Time&apos; THEN [Avg Travel Time (copy)_778841320225951763]&#13;&#10;WHEN &apos;Fleet Delay&apos; THEN [Avg Travel Time (copy)_778841320226263061]&#13;&#10;&#13;&#10;END' />
