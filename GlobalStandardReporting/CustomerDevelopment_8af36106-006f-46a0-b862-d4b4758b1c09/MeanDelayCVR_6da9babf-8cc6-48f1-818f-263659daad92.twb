      </column>
      <column caption='OD CVR' datatype='real' name='[Calculation_2685130544219267072]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(orders)/sum([sessions])' />
      </column>
      <column caption='% Lost Orders' datatype='real' name='[Calculation_2685130544220082177]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([lost_orders_mean_delay])/sum([lost_orders_mean_delay] + [completed_orders])' />
      </column>
      <column caption='% Seamless Orders' datatype='real' name='[Calculation_5167247258294525955]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([seamless_orders])/SUM([orders])' />
      </column>
      <column caption='OD CVR Non Seamless' datatype='real' name='[OD CVR (copy) (copy)_5167247257907286018]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(orders)-sum([seamless_orders]))/sum([sessions])' />
      </column>
      <column caption='OD CVR Seamless' datatype='real' name='[OD CVR (copy)_5167247257907265537]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([seamless_orders])/sum([sessions])' />
      </column>
      <column caption='AVG Delay' datatype='real' name='[Period Delay (copy)_2685130544475160578]' role='measure' type='quantitative'>
