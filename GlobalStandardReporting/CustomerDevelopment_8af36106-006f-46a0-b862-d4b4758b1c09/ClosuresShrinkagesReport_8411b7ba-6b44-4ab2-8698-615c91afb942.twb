      <column caption='Dimension (A)' datatype='string' name='[Calculation_5390738446800027650]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#10;WHEN &quot;Region&quot; THEN [region]&#10;WHEN &quot;Country&quot; THEN [country_name]&#10;WHEN &quot;City&quot; THEN [city_name]&#10;WHEN &quot;Zone&quot; THEN [zone_name]&#10;END' />
      </column>
      <column caption='Dimension (B)' datatype='string' name='[Calculation_5390738446800265219]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Choose Dimension (A) (copy)_5390738446797824000]&#10;WHEN &quot;Region&quot; THEN [region]&#10;WHEN &quot;Country&quot; THEN [country_name]&#10;WHEN &quot;City&quot; THEN [city_name]&#10;WHEN &quot;Zone&quot; THEN [zone_name]&#10;END' />
      </column>
      <column caption='Metric' datatype='real' datatype-customized='true' name='[Calculation_5390738446800326660]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 8]&#10;WHEN &quot;# Starting closures&quot; THEN SUM([starting_closures])&#10;/// WHEN &quot;# Running closures&quot; THEN SUM([running_closures])&#10;WHEN &quot;# Ending closures&quot; THEN SUM([ending_closures])&#10;WHEN &quot;Closure duration within interval&quot; THEN SUM([closure_split_duration])&#10;WHEN &quot;Total duration of starting closures&quot; THEN SUM([closure_total_duration])&#10;WHEN &quot;# Lost orders (closures)&quot; THEN SUM([orders_lost_net_close])&#10;WHEN &quot;% Lost orders (closures)&quot; THEN [Calculation_6741255385763880960]&#10;&#10;WHEN &quot;# Starting shrinkages&quot; THEN SUM([starting_shrinkages])&#10;/// WHEN &quot;# Running shrinkages&quot; THEN SUM([running_shrinkages])&#10;WHEN &quot;# Ending shrinkages&quot; THEN SUM([ending_shrinkages])&#10;WHEN &quot;Shrinkage duration within interval&quot; THEN SUM([shrinkage_split_duration])&#10;WHEN &quot;Total duration of starting shrinkages&quot; THEN SUM([shrinkage_total_duration])&#10;WHEN &quot;# Lost orders (shrinkages)&quot; THEN SUM([orders_lost_net_shrink])&#10;WHEN &quot;% Lost orders (shrinkages)&quot; THEN [Calculation_6741255385764052993]&#10;&#10;WHEN &quot;# Starting events (all included)&quot; THEN SUM([starting_shrinkages]) + SUM([starting_closures])&#10;/// WHEN &quot;# Running events (all included)&quot; THEN SUM([running_shrinkages]) + SUM([running_closures])&#10;WHEN &quot;# Ending events (all included)&quot; THEN SUM([ending_shrinkages]) + SUM([ending_closures])&#10;WHEN &quot;Event duration within interval&quot; THEN SUM([shrinkage_split_duration]) + SUM([closure_split_duration])&#10;WHEN &quot;Total duration of starting events&quot; THEN SUM([shrinkage_total_duration]) + SUM([closure_total_duration])&#10;WHEN &quot;# Lost orders (all included)&quot; THEN SUM([orders_lost_net_shrink]) + SUM([orders_lost_net_close])&#10;&#10;END' />
      </column>
      <column caption='Time Dimension (CTV)' datatype='string' name='[Calculation_5537035065954525184]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 9]&#10;WHEN &quot;Week&quot; THEN str([Calculation_6807190905468850180])&#10;WHEN &quot;Day&quot; THEN str([report_date])&#10;WHEN &quot;Day of week&quot; THEN str([day_of_week])&#10;WHEN &quot;Time of day&quot; THEN str([time_of_day])&#10;WHEN &quot;Hour of day&quot; THEN str([Calculation_5537035065955221505])&#10;WHEN &quot;30 minute window&quot; THEN str([start_datetime])&#10;END' />
      </column>
      <column caption='Hour of day' datatype='integer' name='[Calculation_5537035065955221505]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEPART(&apos;hour&apos;, [start_datetime])' />
