                <run bold='true'><![CDATA[<[federated.0ufwfzu16mg64m1d4j09z0mzonco].[none:report_date:ok]>]]></run>
                <run>Æ&#10;</run>
                <run fontcolor='#787878'>Event Total Duration:&#9;</run>
                <run bold='true'><![CDATA[<[federated.0ufwfzu16mg64m1d4j09z0mzonco].[sum:event_duration:qk]>]]></run>
                <run>Æ&#10;</run>
