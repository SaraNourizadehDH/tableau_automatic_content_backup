      <table>
        <view>
          <datasources>
            <datasource caption='closures_shrinkages_report (rl)' name='federated.0ufwfzu16mg64m1d4j09z0mzonco' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose Dimension (B)' datatype='string' name='[Choose Dimension (A) (copy)_5390738446797824000]' param-domain-type='list' role='measure' type='nominal' value='&quot;City&quot;'>
              <calculation class='tableau' formula='&quot;City&quot;' />
            </column>
            <column caption='Choose Dimension (A)' datatype='string' name='[Parameter 7]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
              <calculation class='tableau' formula='&quot;Country&quot;' />
            </column>
            <column caption='Choose Metric' datatype='string' name='[Parameter 8]' param-domain-type='list' role='measure' type='nominal' value='&quot;\# Starting closures&quot;'>
              <calculation class='tableau' formula='&quot;# Starting closures&quot;' />
              <aliases>
                <alias key='&quot;Closure duration within interval&quot;' value='Closure duration within interval (in minutes)' />
                <alias key='&quot;Shrinkage duration within interval&quot;' value='Shrinkage duration within interval (in minutes)' />
                <alias key='&quot;Total duration of starting closures&quot;' value='Total duration of starting closures (in minutes)' />
                <alias key='&quot;Total duration of starting events&quot;' value='Total duration of starting events (minutes)' />
                <alias key='&quot;Total duration of starting shrinkages&quot;' value='Total duration of starting shrinkages (in minutes)' />
              </aliases>
            </column>
            <column caption='Choose Time Dimension' datatype='string' name='[Parameter 9]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ufwfzu16mg64m1d4j09z0mzonco'>
            <column caption='Orders Lost' datatype='integer' name='[Calculation_289848920903602176]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[orders_lost_net_close] + [orders_lost_net_shrink]' />
            </column>
            <column caption='Dimension (A)' datatype='string' name='[Calculation_5390738446800027650]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#10;WHEN &quot;Region&quot; THEN [region]&#10;WHEN &quot;Country&quot; THEN [country_name]&#10;WHEN &quot;City&quot; THEN [city_name]&#10;WHEN &quot;Zone&quot; THEN [zone_name]&#10;END' />
            </column>
            <column caption='Dimension (B)' datatype='string' name='[Calculation_5390738446800265219]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Choose Dimension (A) (copy)_5390738446797824000]&#10;WHEN &quot;Region&quot; THEN [region]&#10;WHEN &quot;Country&quot; THEN [country_name]&#10;WHEN &quot;City&quot; THEN [city_name]&#10;WHEN &quot;Zone&quot; THEN [zone_name]&#10;END' />
            </column>
            <column caption='Metric' datatype='real' datatype-customized='true' name='[Calculation_5390738446800326660]' role='measure' type='ordinal'>
