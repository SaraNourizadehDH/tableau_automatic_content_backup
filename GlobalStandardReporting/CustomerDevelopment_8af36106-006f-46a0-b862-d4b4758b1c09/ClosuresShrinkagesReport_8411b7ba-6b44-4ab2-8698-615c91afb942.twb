      <column caption='% orders lost (closures)' datatype='real' name='[Calculation_6741255385763880960]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='SUM([orders_lost_net_close]) / SUM([Calculation_289848920903602176])' />
