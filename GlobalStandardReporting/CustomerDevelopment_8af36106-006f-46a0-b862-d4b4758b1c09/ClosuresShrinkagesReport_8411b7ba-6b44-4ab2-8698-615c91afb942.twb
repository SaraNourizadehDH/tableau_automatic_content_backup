      <column caption='_total_events' datatype='integer' name='[Calculation_6807190905432989697]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{EXCLUDE [Calculation_5390738446800027650]&#10;    , [Calculation_5390738446800265219]&#10;    , [Calculation_5537035065954525184]&#10;    , [region]&#10;    , [country_code]&#10;    , [city_id]&#10;    , [zone_name]&#10;: SUM([starting_shrinkages]) + SUM([starting_closures])&#10;}' />
      </column>
      <column caption='# Total events' datatype='real' name='[Calculation_6807190905435639810]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG({EXCLUDE [Calculation_5537035065954525184] : SUM([starting_shrinkages]) + SUM([starting_closures])})' />
