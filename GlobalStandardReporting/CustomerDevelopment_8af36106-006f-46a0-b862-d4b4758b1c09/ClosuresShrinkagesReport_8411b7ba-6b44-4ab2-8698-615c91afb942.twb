      <column caption='Time Dimension' datatype='string' name='[Calculation_198862132642471942]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Month&apos;&#10;THEN str(YEAR([starts_at_local]))+&quot;-&quot;&#10;+str(MONTH([starts_at_local]))&#10;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Week&apos;&#10;THEN str(YEAR([starts_at_local]))+&quot;-&quot;&#10;+str(DATEPART(&apos;week&apos;, [starts_at_local]))&#10;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Day&apos;&#10;THEN str(YEAR([starts_at_local]))+&quot;/&quot;&#10;+str(MONTH([starts_at_local]))+&quot;/&quot;&#10;+str(DAY([starts_at_local]))&#10;&#10;END' />
