      <column caption='Lost orders with type of event' datatype='integer' name='[Calculation_289848920923762689]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = &apos;Closures&apos;&#10;THEN [orders_lost_net_close]&#10;ELSEIF [Parameters].[Parameter 6] = &apos;Shrinkages&apos;&#10;THEN [orders_lost_net_shrink]&#10;ELSEIF [Parameters].[Parameter 6] = &apos;All&apos;&#10;THEN [Calculation_289848920903602176]&#10;END' />
