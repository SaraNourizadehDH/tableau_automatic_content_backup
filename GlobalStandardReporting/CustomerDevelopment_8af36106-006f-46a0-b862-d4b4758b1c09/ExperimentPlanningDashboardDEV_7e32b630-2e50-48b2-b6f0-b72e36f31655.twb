              <calculation class='tableau' formula='IF [domain] = &quot;Choice&quot; AND [source] = &quot;choice_backend&quot; THEN&#10;    &quot;https://tableau.deliveryhero.net/#/site/GlobalStandardReporting/views/AvailabilityTestsDashboard/OrdersView?Choose%20Experiment=&quot; + [Calculation_5454140659772125190]&#10;ELSEIF [domain] = &quot;Pricing&quot; AND [source] = &quot;pricing_backend&quot; THEN&#10;    &quot;https://tableau.deliveryhero.net/#/site/GlobalStandardReporting/views/DPSABTestSignificanceDashboard_17346057420020/SignificanceLevels?Test%20Name=&quot; + [Calculation_5454140659772125190]&#10;ELSEIF [domain] = &quot;Seamless&quot; AND [source] = &quot;seamless_backend&quot; THEN&#10;    &quot;https://tableau.deliveryhero.net/#/site/GlobalStandardReporting/views/ABTestingDashboardV1/ABTestingSummaryGeneralDashboard?Test%20Name=&quot; + [Calculation_5454140659772125190] + &quot;&amp;test_status=&quot; + [status] + &quot;&amp;Owner=&quot; + [sub_domain]&#10;ELSE&#10;    NULL&#10;END' />
            </column>
