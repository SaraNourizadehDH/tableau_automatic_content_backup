            </column>
            <column caption='Dimension 1' datatype='string' name='[Calculation_3504433868381425668]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &quot;Platform&quot; THEN [platform]&#10;WHEN &quot;Domain&quot; THEN [domain]&#10;WHEN &quot;Owner&quot; THEN [operation_scope]&#10;WHEN &quot;Country&quot; THEN [country]&#10;WHEN &quot;Topic&quot; THEN [topic]&#10;END' />
            </column>
            <column caption='Date Check' datatype='boolean' name='[Calculation_5454140659765018627]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([start_date]) &gt;= &apos;2024-09-01&apos;' />
