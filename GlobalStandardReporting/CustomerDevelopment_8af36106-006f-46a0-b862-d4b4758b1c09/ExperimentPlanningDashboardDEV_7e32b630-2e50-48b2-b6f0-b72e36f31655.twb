            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1c3l0wt1ggyz6g155x1k10nxdvuw'>
            <column caption='Analytics Testing Filter' datatype='boolean' name='[Calculation_1506383761120669697]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT STARTSWITH([Calculation_5454140659772125190], &quot;ANALYTICS_TESTING&quot;)' />
            </column>
            <column caption='Experiment Count' datatype='integer' name='[Calculation_3504433868360101888]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [platform],[domain],[source],[Calculation_5454140659772125190], [status], [topic], [start_date], [country]: COUNT([Calculation_5454140659772125190])}' />
            </column>
            <column caption='Dimension 1' datatype='string' name='[Calculation_3504433868381425668]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &quot;Platform&quot; THEN [platform]&#10;WHEN &quot;Domain&quot; THEN [domain]&#10;WHEN &quot;Owner&quot; THEN [operation_scope]&#10;WHEN &quot;Country&quot; THEN [country]&#10;WHEN &quot;Topic&quot; THEN [topic]&#10;END' />
            </column>
            <column caption='Date Check' datatype='boolean' name='[Calculation_5454140659765018627]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([start_date]) &gt;= &apos;2024-09-01&apos;' />
            </column>
            <column caption='Experiments' datatype='string' name='[Calculation_5454140659772125190]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [experiment_name] = &apos;TBD&apos;&#10;THEN [experiment_name]+ &apos;_&apos; + IFNULL([domain],&quot; &quot;) + &apos;_&apos; +IFNULL([topic],&quot; &quot;)&#10;ELSE [experiment_name]&#10;END' />
            </column>
            <column caption='Quarter' datatype='string' name='[Calculation_5454140660162899984]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATEPART(&apos;quarter&apos;, [start_date]) = DATEPART(&apos;quarter&apos;, TODAY())&#10;AND DATEPART(&apos;year&apos;, [start_date]) = DATEPART(&apos;year&apos;, TODAY()) THEN &quot;Current Quarter&quot;&#10;ELSE &quot;Other&quot;&#10;END' />
            </column>
            <column caption='Countries filter' datatype='boolean' name='[Calculation_5582774749315211274]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_6558085536834830338] != &apos;SUB_SAHARA_AFRICA&apos; AND [Calculation_6558085536834830338] != &apos;ASIA_EUROPE&apos;' />
            </column>
            <column caption='Countries*' datatype='string' name='[Calculation_6558085536834830338]' role='dimension' type='nominal'>
