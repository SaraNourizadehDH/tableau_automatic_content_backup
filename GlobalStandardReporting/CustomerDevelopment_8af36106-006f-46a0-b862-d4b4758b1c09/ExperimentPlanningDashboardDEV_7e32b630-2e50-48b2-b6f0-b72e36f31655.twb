              <calculation class='tableau' formula='&quot;Domain&quot;' />
            </column>
            <column caption='Choose Dimension 1' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Platform&quot;'>
              <calculation class='tableau' formula='&quot;Platform&quot;' />
            </column>
