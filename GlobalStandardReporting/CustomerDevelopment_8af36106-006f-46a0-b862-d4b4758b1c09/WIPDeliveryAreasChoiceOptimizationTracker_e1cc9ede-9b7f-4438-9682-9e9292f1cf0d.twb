    <worksheet name='Hexagon Level KPIs'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Weekly GMV Evolution Euros</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='underserved_areas_impact (rl)' name='federated.059gn991dfg4d01561h041plfaua' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Week' caption='Select Date Granularity' datatype='real' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='2.'>
              <calculation class='tableau' formula='2.' />
              <aliases>
                <alias key='1.' value='Day' />
                <alias key='2.' value='Week' />
                <alias key='3.' value='Month' />
              </aliases>
            </column>
            <column alias='Total GMV' caption='Select Metric' datatype='real' name='[Parameter 2]' param-domain-type='list' role='measure' type='quantitative' value='2.'>
              <calculation class='tableau' formula='2.' />
              <aliases>
                <alias key='1.' value='Total Orders' />
                <alias key='2.' value='Total GMV' />
                <alias key='3.' value='Avg GMV' />
                <alias key='4.' value='GPO Eur' />
                <alias key='5.' value='CPO Eur' />
                <alias key='6.' value='Avg Delivery Fee Eur' />
                <alias key='7.' value='Avg Actual Delivery Time Mins' />
                <alias key='8.' value='Avg To Customer Time Mins' />
                <alias key='9.' value='% Seamless Orders' />
                <alias key='10.' value='Fail Rate - late delivery' />
                <alias key='11.' value='% Orders with Contacts - late delivery' />
                <alias key='12.' value='% Orders with Events' />
                <alias key='13.' value='% Orders with DT &gt; 45 min' />
                <alias key='14.' value='% Orders with Stacked Deliveries' />
                <alias key='15.' value='CVR' />
                <alias key='16.' value='mCVR2' />
                <alias key='17.' value='Fail Rate - all reasons' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.059gn991dfg4d01561h041plfaua'>
            <column caption='Date Axis' datatype='date' name='[Both periods (copy)_5640688183641735170]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN 1 THEN (([created_date]))&#10;WHEN 2  THEN ([week])&#10;WHEN 3 THEN ([month])&#10;END' />
            </column>
            <column caption='Total Orders' datatype='integer' name='[Calculation_3249769361999503360]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum([orders])' />
            </column>
            <column caption='CVR' datatype='real' name='[Calculation_3249769361999757313]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sessions_with_transaction])/SUM([sessions])' />
            </column>
            <column caption='Total GMV Eur' datatype='real' name='[Calculation_3249769362008711171]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_eur])' />
            </column>
            <column caption='Avg GMV Eur' datatype='real' name='[Calculation_3249769362008911876]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_eur])/SUM([completed_orders])' />
            </column>
            <column caption='Avg Delivery Fee Euro' datatype='real' name='[Calculation_3249769362009505797]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_fee_euro])/SUM([completed_orders])' />
            </column>
            <column caption='Avg GPO Eur' datatype='real' name='[Calculation_3249769362041012230]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gross_profit_eur])/[Calculation_3249769361999503360]' />
            </column>
            <column caption='Avg CPO Euro' datatype='real' name='[Calculation_3249769362041311239]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_cost_eur])/[Calculation_3249769361999503360]' />
            </column>
            <column caption='Avg Actual Delivery Time Mins' datatype='real' name='[Calculation_3249769362042736648]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([actual_delivery_time_mins])/SUM([completed_orders])' />
            </column>
            <column caption='% Seamless Orders' datatype='real' name='[Calculation_3947686566920515591]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([seamless_orders])/[Calculation_3249769361999503360]' />
            </column>
            <column caption='Fail Rate' datatype='real' name='[Calculation_3947686566920667144]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_3249769361999503360]-sum([completed_orders]))/[Calculation_3249769361999503360]' />
            </column>
            <column caption='% Orders with Contact' datatype='real' name='[Calculation_3947686566920863753]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([contacted_orders])/[Calculation_3249769361999503360]' />
