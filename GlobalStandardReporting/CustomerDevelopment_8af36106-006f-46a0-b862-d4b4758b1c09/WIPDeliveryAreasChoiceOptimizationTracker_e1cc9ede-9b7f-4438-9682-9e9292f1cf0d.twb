          <datasource-dependencies datasource='federated.059gn991dfg4d01561h041plfaua'>
            <column caption='Baseline After' datatype='datetime' name='[2 weeks before rollout (copy)_5436196617707462657]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN 1 THEN  DATEADD(&apos;day&apos;, [Parameters].[Parameter 6], [Calculation_5436196617741172743])&#10;WHEN 2 THEN DATEADD(&apos;day&apos;, 7*[Parameters].[Parameter 6], [Calculation_5436196617741172743])&#10;WHEN 3 THEN DATEADD(&apos;month&apos;, [Parameters].[Parameter 6], [Calculation_5436196617741172743])&#10;END' />
            </column>
            <column caption='After Filter' datatype='boolean' name='[Calculation_3947686566908940289]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3] WHEN &apos;All&apos; THEN&#10;([created_date]&gt;= [Parameters].[Before Start Date (copy)_1532068322630041601] AND&#10;[created_date]&lt;= [Parameters].[After Start Date (copy)_1532068322630111234]&#10;) &#10;ELSE  &#10;([created_date]&lt; [2 weeks before rollout (copy)_5436196617707462657] &#10;AND [created_date]&gt;= [rollout_date])&#10;END' />
            </column>
            <column caption='Baseline Before' datatype='datetime' name='[Calculation_5436196617707360256]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN 1 THEN  DATEADD(&apos;day&apos;, -[Parameters].[Parameter 6], [Calculation_5436196617741172743])&#10;WHEN 2 THEN DATEADD(&apos;day&apos;, -7*[Parameters].[Parameter 6], [Calculation_5436196617741172743])&#10;WHEN 3 THEN DATEADD(&apos;month&apos;, -[Parameters].[Parameter 6], [Calculation_5436196617741172743])&#10;END' />
            </column>
            <column caption='Selected rollout' datatype='boolean' name='[Calculation_5436196617718693893]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3] WHEN  &apos;All&apos; THEN TRUE&#10;ELSE [Parameters].[Parameter 3] = [rollout_name]&#10;END' />
            </column>
            <column caption='Baseline Date' datatype='date' name='[Calculation_5436196617741172743]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN TRUE THEN [rollout_date]&#10;ELSE [Parameters].[Parameter 5]&#10;&#10;END' />
            </column>
            <column caption='Both periods 2' datatype='boolean' name='[Calculation_5640688183660666889]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Week After Filter (copy)_3947686566909087746] or [Calculation_3947686566908940289]' />
            </column>
            <column caption='Rollout Names' datatype='string' name='[Calculation_978547782390738944]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([rollout_name] , &apos;All&apos;)' />
            </column>
            <column caption='Completed Orders After' datatype='integer' name='[Completed Orders Before (copy)_5436196617977053203]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if ([Calculation_3947686566908940289]) then [completed_orders] END' />
            </column>
            <column caption='Delta Avg GMV' datatype='real' name='[Delta Orders (copy)_5436196617977171988]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;(sum([GMV Before (copy)_5436196617976967186])/SUM([Completed Orders Before (copy)_5436196617977053203]))&#10;/&#10;(SUM([Total Orders Before (copy)_5436196617976315919])/SUM([Total Orders Before (copy)_5436196617976836112]))&#10;) - 1' />
            </column>
            <column caption='GMV After' datatype='real' name='[GMV Before (copy)_5436196617976967186]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if ([Calculation_3947686566908940289]) then [gmv_eur] END' />
            </column>
            <column caption='GMV Before' datatype='real' name='[Total Orders Before (copy)_5436196617976315919]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if ([Week After Filter (copy)_3947686566909087746]) then [gmv_eur] END' />
            </column>
            <column caption='Completed Orders Before' datatype='integer' name='[Total Orders Before (copy)_5436196617976836112]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if ([Week After Filter (copy)_3947686566909087746]) then [completed_orders] END' />
            </column>
            <column caption='Before Filter' datatype='boolean' name='[Week After Filter (copy)_3947686566909087746]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3] WHEN &apos;All&apos; THEN&#10;([created_date]&gt;= [Parameters].[Parameter 7] AND&#10;[created_date]&lt;= [Parameters].[Before Start Date (copy)_1532068322629971968]&#10;) &#10;ELSE  &#10;([created_date]&gt;= [Calculation_5436196617707360256] AND [created_date]&lt; [rollout_date])&#10;END' />
            </column>
