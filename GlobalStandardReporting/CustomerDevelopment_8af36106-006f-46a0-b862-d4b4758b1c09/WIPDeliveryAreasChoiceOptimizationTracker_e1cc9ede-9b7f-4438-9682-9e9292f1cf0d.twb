            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.059gn991dfg4d01561h041plfaua].[created_date]' caption='Before End Date' datatype='date' name='[Before Start Date (copy)_1532068322629971968]' param-domain-type='list' role='measure' type='quantitative' value='#2024-04-30#'>
              <calculation class='tableau' formula='#2024-04-30#' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.059gn991dfg4d01561h041plfaua].[created_date]' caption='After Start Date' datatype='date' name='[Before Start Date (copy)_1532068322630041601]' param-domain-type='list' role='measure' type='quantitative' value='#2024-05-13#'>
              <calculation class='tableau' formula='#2024-05-13#' />
            </column>
            <column alias='Week' caption='Select Date Granularity' datatype='real' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='2.'>
              <calculation class='tableau' formula='2.' />
              <aliases>
                <alias key='1.' value='Day' />
                <alias key='2.' value='Week' />
                <alias key='3.' value='Month' />
              </aliases>
            </column>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.059gn991dfg4d01561h041plfaua].[Calculation_978547782390738944]' caption='Select Rollout' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column alias='No, I want to chose my own dates' caption='Use Rollout Date' datatype='boolean' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='false'>
              <calculation class='tableau' formula='false' />
              <aliases>
                <alias key='false' value='No, I want to chose my own dates' />
                <alias key='true' value='Yes' />
              </aliases>
            </column>
            <column _.fcp.RefreshableParameterRanges.true...source-field='[federated.059gn991dfg4d01561h041plfaua].[created_date]' caption='Alternative Date' datatype='date' default-format='*YYYY-MM-DD' name='[Parameter 5]' param-domain-type='range' role='measure' type='quantitative' value='#2024-03-24#'>
              <calculation class='tableau' formula='#2024-03-24#' />
            </column>
            <column caption='Periods Before and After' datatype='integer' name='[Parameter 6]' param-domain-type='any' role='measure' type='quantitative' value='2'>
              <calculation class='tableau' formula='2' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.059gn991dfg4d01561h041plfaua].[created_date]' caption='Before Start Date' datatype='date' name='[Parameter 7]' param-domain-type='list' role='measure' type='quantitative' value='#2024-04-17#'>
              <calculation class='tableau' formula='#2024-04-17#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.059gn991dfg4d01561h041plfaua'>
            <column caption='Baseline After' datatype='datetime' name='[2 weeks before rollout (copy)_5436196617707462657]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN 1 THEN  DATEADD(&apos;day&apos;, [Parameters].[Parameter 6], [Calculation_5436196617741172743])&#10;WHEN 2 THEN DATEADD(&apos;day&apos;, 7*[Parameters].[Parameter 6], [Calculation_5436196617741172743])&#10;WHEN 3 THEN DATEADD(&apos;month&apos;, [Parameters].[Parameter 6], [Calculation_5436196617741172743])&#10;END' />
            </column>
            <column caption='After Filter' datatype='boolean' name='[Calculation_3947686566908940289]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3] WHEN &apos;All&apos; THEN&#10;([created_date]&gt;= [Parameters].[Before Start Date (copy)_1532068322630041601] AND&#10;[created_date]&lt;= [Parameters].[After Start Date (copy)_1532068322630111234]&#10;) &#10;ELSE  &#10;([created_date]&lt; [2 weeks before rollout (copy)_5436196617707462657] &#10;AND [created_date]&gt;= [rollout_date])&#10;END' />
            </column>
            <column caption='Baseline Before' datatype='datetime' name='[Calculation_5436196617707360256]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN 1 THEN  DATEADD(&apos;day&apos;, -[Parameters].[Parameter 6], [Calculation_5436196617741172743])&#10;WHEN 2 THEN DATEADD(&apos;day&apos;, -7*[Parameters].[Parameter 6], [Calculation_5436196617741172743])&#10;WHEN 3 THEN DATEADD(&apos;month&apos;, -[Parameters].[Parameter 6], [Calculation_5436196617741172743])&#10;END' />
            </column>
            <column caption='Selected rollout' datatype='boolean' name='[Calculation_5436196617718693893]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3] WHEN  &apos;All&apos; THEN TRUE&#10;ELSE [Parameters].[Parameter 3] = [rollout_name]&#10;END' />
            </column>
            <column caption='Baseline Date' datatype='date' name='[Calculation_5436196617741172743]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN TRUE THEN [rollout_date]&#10;ELSE [Parameters].[Parameter 5]&#10;&#10;END' />
            </column>
            <column caption='Total Orders Before' datatype='integer' name='[Calculation_5436196617745891336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if ([Week After Filter (copy)_3947686566909087746]) then [orders] END' />
            </column>
