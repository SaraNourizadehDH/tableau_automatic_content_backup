      <column caption='# Lost Orders By Mean Delay' datatype='integer' name='[Calculation_4859384016732803074]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([lost_orders_mean_delay])' />
      </column>
      <column caption='# Avg Vendors Available' datatype='real' name='[Calculation_4859384016733175811]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([ava_session_cnt]*[avg_available_vendors])/sum([ava_session_cnt])' />
      </column>
      <column caption='Column Dimension' datatype='string' name='[Calculation_5054868409398706208]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Custom Dimension - CD (copy)_5054868409398640671] &#10;when &quot;Country Code&quot; then [country_code]&#10;when &quot;Region&quot; then [Calculation_2027534664725880840]&#10;when &quot;Entity ID&quot; then [global_entity_id]&#10;when &quot;Local Hour of Day&quot; then STR([hour_of_local])&#10;when &quot;Date Field&quot; then STR([Calculation_2027534664681193477])&#10;when &quot;DH Platform&quot; then [dh_platform]&#10;when &quot;Platform&quot; then [platform]&#10;end' />
      </column>
      <column caption='Date Field' datatype='date' name='[Calculation_582231021974126611]' role='dimension' type='ordinal'>
