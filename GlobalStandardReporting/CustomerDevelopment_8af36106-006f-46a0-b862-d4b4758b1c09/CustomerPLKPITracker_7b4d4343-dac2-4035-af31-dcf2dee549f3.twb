            <column caption='Est Driving Time' datatype='real' name='[Est Delivery Duration Buffer (copy)_2019512645966172165]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([estimated_driving_time]*[all_orders])/sum([all_orders])' />
