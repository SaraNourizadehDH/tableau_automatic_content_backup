            <column caption='# of Countries - No PM' datatype='real' name='[# of Countries - 1 PM (copy)_1454170131027718148]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(AVG([pm0]),0)' />
            </column>
            <column caption='# of Countries - 1 PM' datatype='real' name='[# of Countries - 2 PMs (copy)_1454170131027632131]' role='measure' type='quantitative'>
