    <worksheet name='CPL Tabular'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Tabular View</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='mla_cpl_tracker_north_star (rl)' name='federated.0vps2uw1r55c6p1bphex30nz8axg' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Weekly' caption='Time Dimension - ALL' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
              <calculation class='tableau' formula='&quot;week&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;quarter&quot;' value='Quarterly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0vps2uw1r55c6p1bphex30nz8axg'>
            <column caption='% Lost Orders Mean Delay' datatype='real' name='[% Lost Orders (copy)_2671127183306739713]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([lost_orders_mean_delay])*100/(sum([total_orders]))' />
            </column>
            <column caption='% Cancelled Orders' datatype='real' name='[% Lost Orders Mean Delay (copy)_2671127183306846210]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cancelled_orders])*100/(sum([total_orders])+sum([lost_orders_mean_delay]))' />
            </column>
            <column caption='EPT' datatype='real' name='[AVTC (copy)_6662723849323888644]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([ept]*[total_completed_orders_sd (mla_cpl_tracker_north_star)])/sum([total_completed_orders_sd (mla_cpl_tracker_north_star)])' />
            </column>
            <column caption='AVTC' datatype='real' name='[Avg PDT (copy)_6662723849323577347]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([avtc]*[total_completed_orders_sd (mla_cpl_tracker_north_star)])/sum([total_completed_orders_sd (mla_cpl_tracker_north_star)])' />
            </column>
            <column caption='% Lost Orders' datatype='real' name='[Calculation_2671127183306584064]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([lost_orders])*100/(sum([total_orders]))' />
            </column>
            <column caption='# Completed Orders' datatype='integer' name='[Calculation_45317512769376256]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_completed_orders_sd (mla_cpl_tracker_north_star)])' />
            </column>
            <column caption='Avg DT' datatype='real' name='[Calculation_45317512769687554]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([dt]*[total_completed_orders_sd (mla_cpl_tracker_north_star)])/sum([total_completed_orders_sd (mla_cpl_tracker_north_star)])' />
            </column>
            <column caption='Avg PDT' datatype='real' name='[Calculation_45317512770134022]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([pdt]*[total_completed_orders_sd (mla_cpl_tracker_north_star)])/sum([total_completed_orders_sd (mla_cpl_tracker_north_star)])' />
            </column>
            <column caption='% Stacked Orders' datatype='real' name='[Calculation_45317512770347016]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([stacked_orders])*100/sum([total_completed_orders_sd (mla_cpl_tracker_north_star)])' />
            </column>
            <column caption='Date Dimension' datatype='string' name='[Calculation_5054868408733102081]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;[Parameters].[Parameter 1] = &quot;day&quot; THEN&#10;STR(DATEPART(&quot;year&quot;, [local_created_date])) + &quot;-&quot; + STR(DATEPART(&quot;month&quot;, [local_created_date])) + &quot;-&quot; + STR(DATEPART(&quot;day&quot;, [local_created_date]))&#10;ELSEIF [Parameters].[Parameter 1] = &quot;week&quot; AND week_num = 52 AND DATEPART(&quot;month&quot;, [local_created_date]) = 1 THEN &#10;STR(DATEPART(&quot;year&quot;, [local_created_date])-1) + &quot; W&quot; + STR([week_num])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;week&quot; AND week_num = 1 AND DATEPART(&quot;month&quot;, [local_created_date]) = 12 THEN &#13;&#10;STR(DATEPART(&quot;year&quot;, [local_created_date])+1) + &quot; W&quot; + STR([week_num])&#10;ELSEIF [Parameters].[Parameter 1] = &quot;week&quot; THEN &#10;STR(DATEPART(&quot;year&quot;, [local_created_date])) + &quot; W&quot; + STR([week_num])&#10;ELSEIF [Parameters].[Parameter 1] = &quot;month&quot; then &#10;STR(DATEPART(&quot;year&quot;, [local_created_date])) + &quot;-&quot; + STR(DATEPART(&quot;month&quot;, [local_created_date]))&#10;ELSEIF [Parameters].[Parameter 1] = &quot;quarter&quot; then&#10;STR(DATEPART(&quot;year&quot;, [local_created_date])) + &quot; Q&quot; + STR(DATEPART(&quot;quarter&quot;, [local_created_date]))&#10;ELSEIF [Parameters].[Parameter 1] = &quot;year&quot; then &#10;&quot;Year - &quot; + STR(DATEPART(&quot;year&quot;, [local_created_date]))&#10;END' />
            </column>
            <column caption='Local Date' datatype='date' name='[Calculation_5054868408733544450]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='date([local_created_date])' />
            </column>
            <column caption='% Seamless Orders' datatype='real' name='[Calculation_5054868409045950476]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([seamless_numerator_sd (mla_cpl_tracker_north_star)])*100/sum([seamless_denom_sd (mla_cpl_tracker_north_star)])' />
            </column>
            <column caption='% On Time Orders' datatype='real' name='[Calculation_5054868409046241293]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([ontime_orders_sd (mla_cpl_tracker_north_star)])*100/sum([total_completed_orders_no_preorder_sd (mla_cpl_tracker_north_star)])' />
            </column>
            <column caption='% Contact (Live Order Status)' datatype='real' name='[Calculation_5054868409046347790]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([delay_based_contact_orders_sd (mla_cpl_tracker_north_star)])*100/sum([all_orders_sd (mla_cpl_tracker_north_star)])' />
            </column>
            <column caption='% Help Center (HC Session) Rate' datatype='real' name='[Calculation_5054868409046446095]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([hc_session_orders_sd (mla_cpl_tracker_north_star)])*100/sum([all_orders_sd (mla_cpl_tracker_north_star)])' />
            </column>
            <column caption='% Customer Cancellation Rate (Item Unavailable/ Late ETA/ Delivery Too Long/ Error)' datatype='real' name='[Calculation_5054868409046552592]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cust_cancelled_orders_sd (mla_cpl_tracker_north_star)])*100/sum([all_orders_sd (mla_cpl_tracker_north_star)])' />
            </column>
            <column caption='% CVR' datatype='real' name='[Calculation_5054868409047375889]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([sessions_with_txn_CD])*100/sum([ttl_sessions_CD])' />
            </column>
            <column caption='% mCVR2' datatype='real' name='[Calculation_5054868409047613458]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([mcvr2_num_CD])*100/sum([mcvr2_denom_CD])' />
            </column>
            <column caption='Customer Fees (€)' datatype='real' name='[Calculation_5054868409047953428]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([customer_fees_PD]*[ttl_orders_PD])/sum([ttl_orders_PD])' />
            </column>
            <column caption='% Non Delivery Fees Orders' datatype='real' name='[Calculation_5054868409048133653]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders_with_non_del_fees_PD])*100/sum([ttl_orders_PD])' />
            </column>
            <column caption='% Service Fees Orders' datatype='real' name='[Calculation_5054868409048277014]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders_with_service_fee_PD])*100/sum([ttl_orders_PD])' />
            </column>
            <column caption='% MOV Fees Orders' datatype='real' name='[Calculation_5054868409048387607]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders_with_mov_PD])*100/sum([ttl_orders_PD])' />
            </column>
            <column caption='Region' datatype='string' name='[Calculation_5054868409054203932]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [region]&#10;when &quot;ap&quot; then &quot;APAC&quot;&#10;when &quot;eu&quot; then &quot;EU&quot;&#10;when &quot;kr&quot; then &quot;Korea&quot;&#10;when &quot;mena&quot; then &quot;MENA&quot;&#10;when &quot;us&quot; then &quot;US&quot;&#10;else &quot;No Region Name&quot;&#10;END' />
            </column>
            <column caption='% Customer Fee/ Basket Value' datatype='real' name='[Calculation_6688267710229831685]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(customer_fees_PD*ttl_orders_PD)*100/sum([basket_value_PD]*ttl_orders_PD)' />
            </column>
            <column caption='Non DF as % of Customer Fee' datatype='real' name='[Customer Fees (€) (copy)_6662723849028665345]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(([customer_fees_PD] - [delivery_fee_dh_PD])*[ttl_orders_PD])*100/sum([customer_fees_PD]*[ttl_orders_PD])' />
            </column>
