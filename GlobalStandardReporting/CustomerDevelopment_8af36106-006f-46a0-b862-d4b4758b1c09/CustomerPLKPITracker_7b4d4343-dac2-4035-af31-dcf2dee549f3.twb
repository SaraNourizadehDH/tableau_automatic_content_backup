              <calculation class='tableau' formula='ROUND(AVG([pm4]),0)' />
            </column>
            <column caption='Date Dimension' datatype='string' name='[Calculation_2027534664680992772]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;[Parameters].[Parameter 1] = &quot;day&quot; THEN&#10;STR(DATEPART(&quot;year&quot;, [created_date_local])) + &quot;-&quot; + STR(DATEPART(&quot;month&quot;, [created_date_local])) + &quot;-&quot; + STR(DATEPART(&quot;day&quot;, [created_date_local]))&#10;ELSEIF [Parameters].[Parameter 1] = &quot;week&quot; AND week_num = 52 AND DATEPART(&quot;month&quot;, [created_date_local]) = 1 THEN &#10;STR(DATEPART(&quot;year&quot;, [created_date_local])-1) + &quot; W&quot; + STR([week_num])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;week&quot; AND week_num = 1 AND DATEPART(&quot;month&quot;, [created_date_local]) = 12 THEN &#13;&#10;STR(DATEPART(&quot;year&quot;, [created_date_local])+1) + &quot; W&quot; + STR([week_num])&#10;ELSEIF [Parameters].[Parameter 1] = &quot;week&quot; THEN &#10;STR(DATEPART(&quot;year&quot;, [created_date_local])) + &quot; W&quot; + STR([week_num])&#10;ELSEIF [Parameters].[Parameter 1] = &quot;month&quot; then &#10;STR(DATEPART(&quot;year&quot;, [created_date_local])) + &quot;-&quot; + STR(DATEPART(&quot;month&quot;, [created_date_local]))&#10;ELSEIF [Parameters].[Parameter 1] = &quot;quarter&quot; then&#10;STR(DATEPART(&quot;year&quot;, [created_date_local])) + &quot; Q&quot; + STR(DATEPART(&quot;quarter&quot;, [created_date_local]))&#10;ELSEIF [Parameters].[Parameter 1] = &quot;year&quot; then &#10;&quot;Year - &quot; + STR(DATEPART(&quot;year&quot;, [created_date_local]))&#10;END' />
            </column>
            <column caption='Non-DF as % of Cust Fee' datatype='real' name='[Calculation_2677038176968216607]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(([customer_fees] - [delivery_fee_dh])*[ttl_orders_1])*100/sum([customer_fees]*[ttl_orders_1])' />
            </column>
            <column caption='Local Date' datatype='date' name='[Calculation_582231021359263746]' role='dimension' type='ordinal'>
