      <column caption='# of Countries - 4 or more PMs' datatype='real' name='[Calculation_1454170131027419136]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(AVG([pm4]),0)' />
      </column>
      <column caption='Feedback' datatype='string' name='[Calculation_157977885724938240]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;🚨 Submit dashboard feedback here&quot;' />
      </column>
      <column caption='Date Dimension' datatype='string' name='[Calculation_2027534664680992772]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;[Parameters].[Parameter 1] = &quot;day&quot; THEN&#10;STR(DATEPART(&quot;year&quot;, [created_date_local])) + &quot;-&quot; + STR(DATEPART(&quot;month&quot;, [created_date_local])) + &quot;-&quot; + STR(DATEPART(&quot;day&quot;, [created_date_local]))&#10;ELSEIF [Parameters].[Parameter 1] = &quot;week&quot; AND week_num = 52 AND DATEPART(&quot;month&quot;, [created_date_local]) = 1 THEN &#10;STR(DATEPART(&quot;year&quot;, [created_date_local])-1) + &quot; W&quot; + STR([week_num])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;week&quot; AND week_num = 1 AND DATEPART(&quot;month&quot;, [created_date_local]) = 12 THEN &#13;&#10;STR(DATEPART(&quot;year&quot;, [created_date_local])+1) + &quot; W&quot; + STR([week_num])&#10;ELSEIF [Parameters].[Parameter 1] = &quot;week&quot; THEN &#10;STR(DATEPART(&quot;year&quot;, [created_date_local])) + &quot; W&quot; + STR([week_num])&#10;ELSEIF [Parameters].[Parameter 1] = &quot;month&quot; then &#10;STR(DATEPART(&quot;year&quot;, [created_date_local])) + &quot;-&quot; + STR(DATEPART(&quot;month&quot;, [created_date_local]))&#10;ELSEIF [Parameters].[Parameter 1] = &quot;quarter&quot; then&#10;STR(DATEPART(&quot;year&quot;, [created_date_local])) + &quot; Q&quot; + STR(DATEPART(&quot;quarter&quot;, [created_date_local]))&#10;ELSEIF [Parameters].[Parameter 1] = &quot;year&quot; then &#10;&quot;Year - &quot; + STR(DATEPART(&quot;year&quot;, [created_date_local]))&#10;END' />
      </column>
      <column caption='Orders Multiple PM' datatype='integer' hidden='true' name='[Calculation_2677038176691499026]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [country_name]: SUM([multiple_pm_order_qty])}' />
      </column>
      <column caption='PM Majority ' datatype='string' name='[Calculation_2677038176953356308]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;[multiple_pm_order_qty] &gt;= &#10;0.5*([triple_pm_order_qty] + [double_pm_order_qty] + [single_pm_order_qty] + [multiple_pm_order_qty] )&#10;then &apos;Multiple (&gt;= 4) PM&apos;&#10;&#10;ELSEIF [triple_pm_order_qty] &gt;=&#10;0.5*([triple_pm_order_qty] + [double_pm_order_qty] + [single_pm_order_qty] + [multiple_pm_order_qty] ) &#10;then &apos;Triple PM&apos;&#10;&#10;ELSEIF [double_pm_order_qty] &gt;= &#10;0.5*([triple_pm_order_qty] + [double_pm_order_qty] + [single_pm_order_qty] + [multiple_pm_order_qty] )&#10;then &apos;Double PM&apos;&#10;&#10;ELSE &apos;Single PM&apos;&#10;END' />
      </column>
      <column caption='PM Majority Overall' datatype='string' name='[Calculation_2677038176954957849]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;[Calculation_2677038176691499026] &gt;=&#10;0.5*([Orders Multiple PM (copy 2)_2677038176954298390] + [Calculation_2677038176691499026] + [Orders Multiple PM (copy 3)_2677038176954327063] + [Orders Multiple PM (copy)_2677038176954273813])&#10;then &apos;Multiple (&gt;= 4) PM&apos;&#10;&#10;ELSEIF [Orders Multiple PM (copy 2)_2677038176954298390] &gt;=&#10;0.5*([Orders Multiple PM (copy 2)_2677038176954298390] + [Calculation_2677038176691499026] + [Orders Multiple PM (copy 3)_2677038176954327063] + [Orders Multiple PM (copy)_2677038176954273813])&#10;then &apos;Triple PM&apos;&#10;&#10;ELSEIF [Orders Multiple PM (copy 3)_2677038176954327063] &gt;=&#10;0.5*([Orders Multiple PM (copy 2)_2677038176954298390] + [Calculation_2677038176691499026] + [Orders Multiple PM (copy 3)_2677038176954327063] + [Orders Multiple PM (copy)_2677038176954273813])&#10;then &apos;Double PM&apos;&#10;&#10;ELSE &apos;Single PM&apos;&#10;END' />
      </column>
      <column caption='Non-DF as % of Cust Fee' datatype='real' name='[Calculation_2677038176968216607]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(([customer_fees] - [delivery_fee_dh])*[ttl_orders_1])*100/sum([customer_fees]*[ttl_orders_1])' />
      </column>
      <column caption='User Entitlements' datatype='boolean' name='[Calculation_4561583526560894976]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Column Dimension' datatype='string' name='[Calculation_5054868409396994078]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Custom Tabular Dimension - PD (copy)_5054868409396650013]&#10;when &quot;Country Code&quot; then [country_code]&#10;when &quot;Region&quot; then [region]&#10;when &quot;Entity ID&quot; then [entity_id]&#10;when &quot;Date Field&quot; then STR([Calculation_2027534664680992772])&#10;end' />
      </column>
      <column caption='Date Field' datatype='date' name='[Calculation_582231021358542848]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parameter 1], [created_date_local]))' />
      </column>
      <column caption='Local Date' datatype='date' name='[Calculation_582231021359263746]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE([created_date_local])' />
      </column>
      <column caption='Customer Fees (€)' datatype='real' name='[Calculation_582231021367463946]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(&#10;[customer_fees]*[ttl_orders_1]&#10;)/sum([ttl_orders_1])' />
      </column>
      <column caption='Customer Fees/ Basket Value %' datatype='real' name='[Calculation_582231021368094731]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(&#10;[customer_fees]*[ttl_orders_1]&#10;)*100/sum([basket_value]*[ttl_orders_1])' />
      </column>
      <column caption='% of Orders with Non Delivery-Fee Fees' datatype='real' name='[Calculation_582231021370327054]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [customer_fees] - [delivery_fee_dh] &gt; 0 THEN [ttl_orders_1] else 0 end)*100/sum([ttl_orders_1])' />
      </column>
      <column caption='% of Orders with MOV Fee' datatype='real' name='[Calculation_582231021372084239]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [mov_fee] &gt; 0 THEN [ttl_orders_1] else 0 end)*100/sum([ttl_orders_1])' />
      </column>
      <column caption='% of Orders with Service Fee' datatype='real' name='[Calculation_582231021372284944]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [service_fee] &gt; 0 THEN [ttl_orders_1] else 0 end)*100/sum([ttl_orders_1])' />
      </column>
      <column caption='# of A/ B Tests Launched' datatype='integer' name='[Calculation_582231021374246929]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([tests_launched])' />
