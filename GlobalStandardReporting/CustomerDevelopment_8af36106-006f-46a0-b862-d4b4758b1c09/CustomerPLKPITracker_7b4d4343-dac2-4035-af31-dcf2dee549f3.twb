            <column caption='Est Vendor Walkout Time' datatype='real' name='[Est Courier Delay (copy)_2019512645967368199]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([estimated_vendor_walkout_time_minutes]*[all_orders])/sum([all_orders])' />
