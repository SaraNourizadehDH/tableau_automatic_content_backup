    <worksheet name='Choice Crosstab'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Region Wise Crosstab View</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='mla_cpl_tracker_choice_domain (rl)' name='federated.1mjmaji00tmimr0zs6sca0waoazu' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Weekly' caption='Time Dimension - ALL' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
              <calculation class='tableau' formula='&quot;week&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;quarter&quot;' value='Quarterly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1mjmaji00tmimr0zs6sca0waoazu'>
            <column caption='Date Dimension' datatype='string' name='[Calculation_2027534664681193477]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;[Parameters].[Parameter 1] = &quot;day&quot; THEN&#10;STR(DATEPART(&quot;year&quot;, [local_created_DATE])) + &quot;-&quot; + STR(DATEPART(&quot;month&quot;, [local_created_DATE])) + &quot;-&quot; + STR(DATEPART(&quot;day&quot;, [local_created_DATE]))&#10;ELSEIF [Parameters].[Parameter 1] = &quot;week&quot; AND week_num = 52 AND DATEPART(&quot;month&quot;, [local_created_DATE]) = 1 THEN &#10;STR(DATEPART(&quot;year&quot;, [local_created_DATE])-1) + &quot; W&quot; + STR([week_num])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;week&quot; AND week_num = 1 AND DATEPART(&quot;month&quot;, [local_created_DATE]) = 12 THEN &#13;&#10;STR(DATEPART(&quot;year&quot;, [local_created_DATE])+1) + &quot; W&quot; + STR([week_num])&#10;ELSEIF [Parameters].[Parameter 1] = &quot;week&quot; THEN &#10;STR(DATEPART(&quot;year&quot;, [local_created_DATE])) + &quot; W&quot; + STR([week_num])&#10;ELSEIF [Parameters].[Parameter 1] = &quot;month&quot; then &#10;STR(DATEPART(&quot;year&quot;, [local_created_DATE])) + &quot;-&quot; + STR(DATEPART(&quot;month&quot;, [local_created_DATE]))&#10;ELSEIF [Parameters].[Parameter 1] = &quot;quarter&quot; then&#10;STR(DATEPART(&quot;year&quot;, [local_created_DATE])) + &quot; Q&quot; + STR(DATEPART(&quot;quarter&quot;, [local_created_DATE]))&#10;ELSEIF [Parameters].[Parameter 1] = &quot;year&quot; then &#10;&quot;Year - &quot; + STR(DATEPART(&quot;year&quot;, [local_created_DATE]))&#10;END' />
            </column>
            <column caption='Region' datatype='string' name='[Calculation_2027534664725880840]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [region] = &quot;ap&quot; then &quot;APAC&quot;&#10;ELSEIF [region] = &quot;eu&quot; then &quot;EU&quot;&#10;ELSEIF [region] = &quot;kr&quot; then &quot;Korea&quot;&#10;ELSEIF [region] = &quot;us&quot; then &quot;US&quot;&#10;ELSEIF [region] = &quot;mena&quot; then &quot;MENA&quot;&#10;ELSE &quot;No Region Name Found&quot;&#10;END' />
            </column>
            <column caption='Include Lost Orders Outliers' datatype='boolean' name='[Calculation_2744944008919482368]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [is_outlier_day] = 1 then TRUE ELSE FALSE END' />
            </column>
            <column caption='% CVR ' datatype='real' name='[Calculation_582231021977051158]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [hAS_order] &gt; 0 then [session_cnt] end)*100/sum([session_cnt])' />
            </column>
            <column caption='Local Date' datatype='date' name='[Calculation_582231021978030103]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='date([local_created_DATE])' />
            </column>
            <column caption='% mCVR1' datatype='real' name='[Calculation_582231021988618264]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [mcvr1] &gt; 0 then [session_cnt] end)*100/&#10;sum(if [mcvr1] &gt;= 0 then [session_cnt] END)' />
            </column>
            <column caption='% mCVR2' datatype='real' name='[Calculation_582231021989097497]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [mcvr2] &gt; 0 then [session_cnt] end)*100/&#10;sum(if [mcvr2] &gt;= 0 then [session_cnt] end)' />
            </column>
            <column caption='% mCVR3' datatype='real' name='[Calculation_582231021989462042]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [mcvr3] &gt; 0 then [session_cnt] end)*100/&#10;sum(if [mcvr3] &gt;= 0 then [session_cnt] end)' />
            </column>
            <column caption='% mCVR4' datatype='real' name='[Calculation_582231021990051867]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [mcvr4] &gt; 0 then [session_cnt] end)*100/&#10;sum(if [mcvr4] &gt;= 0 then [session_cnt] end)' />
            </column>
            <column caption='% CVR1' datatype='real' name='[Calculation_582231021990252572]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [mcvr1] &gt;= 0 and [hAS_order] &gt; 0 then [session_cnt] end)*100/&#10;sum(if [mcvr1] &gt;= 0 then [session_cnt] end)' />
            </column>
            <column caption='% CVR2' datatype='real' name='[Calculation_582231021990510621]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [mcvr2] &gt;= 0 and [hAS_order] &gt; 0 then [session_cnt] end)*100/&#10;sum(if [mcvr2] &gt;= 0 then [session_cnt] end)' />
