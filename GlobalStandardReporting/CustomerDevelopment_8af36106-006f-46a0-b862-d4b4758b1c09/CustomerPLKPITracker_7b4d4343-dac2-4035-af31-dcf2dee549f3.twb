    <worksheet name='Seamless Custom Tabular View'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Custom Tabular View</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='mla_cpl_tracker_seamless_domain (rl)' name='federated.0f7n7px1lfejpd11hnbd21219hn9' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Weekly' caption='Time Dimension - ALL' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
              <calculation class='tableau' formula='&quot;week&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;quarter&quot;' value='Quarterly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
            <column caption='Pivot Dimension - SD' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Stack Rank&quot;'>
              <calculation class='tableau' formula='&quot;Stack Rank&quot;' />
              <aliases>
                <alias key='&quot;Country Code&quot;' value='Country Code' />
                <alias key='&quot;Region&quot;' value='Region' />
              </aliases>
            </column>
            <column caption='Dimension #2 - SD' datatype='string' name='[Pivot Dimension (copy)_2027534665084317712]' param-domain-type='list' role='measure' type='nominal' value='&quot;Date Field&quot;'>
              <calculation class='tableau' formula='&quot;Date Field&quot;' />
              <aliases>
                <alias key='&quot;Country Code&quot;' value='Country Code' />
                <alias key='&quot;Region&quot;' value='Region' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0f7n7px1lfejpd11hnbd21219hn9'>
            <column caption='PDT Buckets' datatype='string' name='[Calculation_2019512645604470784]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [pdt (mla_cpl_tracker_seamless_domain)] &gt;= 0 and [pdt (mla_cpl_tracker_seamless_domain)] &lt;=10 then &quot;0-10 mins&quot;&#10;ELSEIF  [pdt (mla_cpl_tracker_seamless_domain)] &gt; 10 and [pdt (mla_cpl_tracker_seamless_domain)] &lt;= 20 then &quot;10-20 mins&quot;&#10;ELSEIF  [pdt (mla_cpl_tracker_seamless_domain)] &gt; 20 and [pdt (mla_cpl_tracker_seamless_domain)] &lt;= 30 then &quot;20-30 mins&quot;&#10;ELSEIF  [pdt (mla_cpl_tracker_seamless_domain)] &gt; 30 and [pdt (mla_cpl_tracker_seamless_domain)] &lt;= 40 then &quot;30-40 mins&quot;&#10;ELSEIF  [pdt (mla_cpl_tracker_seamless_domain)] &gt; 40 and [pdt (mla_cpl_tracker_seamless_domain)] &lt;= 50 then &quot;40-50 mins&quot;&#10;ELSEIF  [pdt (mla_cpl_tracker_seamless_domain)] &gt; 50 and [pdt (mla_cpl_tracker_seamless_domain)] &lt;= 60 then &quot;50-60 mins&quot;&#10;ELSEIF  [pdt (mla_cpl_tracker_seamless_domain)] &gt; 60 then &quot;&gt; 60 mins&quot; &#10;END' />
            </column>
            <column caption='DT Buckets' datatype='string' name='[Calculation_2019512645605199874]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [dt (mla_cpl_tracker_seamless_domain)] &gt;= 0 and [dt (mla_cpl_tracker_seamless_domain)] &lt;=10 then &quot;0-10 mins&quot;&#10;ELSEIF  [dt (mla_cpl_tracker_seamless_domain)] &gt; 10 and [dt (mla_cpl_tracker_seamless_domain)] &lt;= 20 then &quot;10-20 mins&quot;&#10;ELSEIF  [dt (mla_cpl_tracker_seamless_domain)] &gt; 20 and [dt (mla_cpl_tracker_seamless_domain)] &lt;= 30 then &quot;20-30 mins&quot;&#10;ELSEIF  [dt (mla_cpl_tracker_seamless_domain)] &gt; 30 and [dt (mla_cpl_tracker_seamless_domain)] &lt;= 40 then &quot;30-40 mins&quot;&#10;ELSEIF  [dt (mla_cpl_tracker_seamless_domain)] &gt; 40 and [dt (mla_cpl_tracker_seamless_domain)] &lt;= 50 then &quot;40-50 mins&quot;&#10;ELSEIF  [dt (mla_cpl_tracker_seamless_domain)] &gt; 50 and [dt (mla_cpl_tracker_seamless_domain)] &lt;= 60 then &quot;50-60 mins&quot;&#10;ELSEIF  [dt (mla_cpl_tracker_seamless_domain)] &gt; 60 then &quot;&gt; 60 mins&quot; &#10;END' />
            </column>
            <column caption='Region' datatype='string' name='[Calculation_2027534664719454214]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [region] = &quot;ap&quot; then &quot;APAC&quot;&#10;ELSEIF [region] = &quot;eu&quot; then &quot;EU&quot;&#10;ELSEIF [region] = &quot;kr&quot; then &quot;Korea&quot;&#10;ELSEIF [region] = &quot;us&quot; then &quot;US&quot;&#10;ELSEIF [region] = &quot;mena&quot; then &quot;MENA&quot;&#10;ELSEIF ISNULL([region]) then &quot;No Region Name Found&quot;&#10;END' />
            </column>
            <column caption='% Orders On Time [+/-10 mins]' datatype='real' name='[Calculation_2899121911351926784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ontime_orders])*100/sum([total_completed_orders_no_preorder])' />
            </column>
            <column caption='% Cancelled Orders' datatype='real' name='[Calculation_2899121913159335953]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cancelled_orders])*100/sum([all_orders])' />
            </column>
            <column caption='Dimension' datatype='string' name='[Calculation_4128323143499538435]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2] &#10;when &quot;Country Code&quot; then [country_code]&#10;when &quot;Region&quot; then [Calculation_2027534664719454214]&#10;when &quot;City ID&quot; then [city_id]&#10;when &quot;Entity ID&quot; then [platform]&#10;when &quot;Vertical Type&quot; then [vertical_type]&#10;when &quot;Brand Name&quot; then [brand_name]&#10;when &quot;Stacked Orders&quot; then [stacked_tag]&#10;when &quot;Delivery Tag&quot; then [delivery_tag]&#10;when &quot;PDT Buckets&quot; then [Calculation_2019512645604470784]&#10;when &quot;DT Buckets&quot; then [Calculation_2019512645605199874]&#10;when &quot;Stack Rank&quot; then STR([stack_rank])&#10;when &quot;Hour of Day&quot; then STR([local_hour_of_day])&#10;end' />
            </column>
            <column caption='Date Dimension' datatype='string' name='[Calculation_5054868409432371233]' role='dimension' type='nominal'>
