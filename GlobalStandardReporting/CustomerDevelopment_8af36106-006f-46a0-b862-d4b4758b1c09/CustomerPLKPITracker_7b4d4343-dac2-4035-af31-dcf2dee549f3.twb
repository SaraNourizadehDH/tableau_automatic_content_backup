      <aliases enabled='yes' />
      <column caption='% Cancelled Orders (Service Level Reasons)' datatype='real' name='[# Cancelled Orders (copy)_2532008176037978115]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([cancelled_orders])*100/(sum([daily_orders])+sum([lost_orders_mean_delay]))' />
      </column>
      <column caption='% Lost Orders (Mean Delay + Cancellations)' datatype='real' name='[# Lost Orders (copy)_2532008176037818369]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([lost_orders])*100/(sum([daily_orders]))' />
      </column>
      <column caption='% Lost Orders (Mean Delay)' datatype='real' name='[# Lost Orders By Mean Delay (copy)_2532008176037892098]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([lost_orders_mean_delay])*100/(sum([daily_orders]))' />
      </column>
      <column caption='% Zones on AVR' datatype='real' name='[% Orders on AVR (copy)_5951999546586066945]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([avr_zone_num])*100/sum([avr_zone_denom])' />
      </column>
      <column caption='% Vendors with Zone Overlap' datatype='real' name='[% Orders with Zone Overlap (copy)_733031256276951042]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [overlap_flag] &gt; 0 then [dist_vendors] end)*100/sum([dist_vendors])' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1mjmaji00tmimr0zs6sca0waoazu].[usr:\# Cancelled Orders (copy)_2532008176037978115:qk]&quot;' value='% Cancelled Orders (Service Level Reasons)*' />
        </aliases>
      </column>
      <column caption='Feedback button' datatype='string' name='[Calculation_157977885728641026]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Submit dashboard feedback here&quot;' />
      </column>
      <column caption='Date Dimension' datatype='string' name='[Calculation_2027534664681193477]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;[Parameters].[Parameter 1] = &quot;day&quot; THEN&#10;STR(DATEPART(&quot;year&quot;, [local_created_DATE])) + &quot;-&quot; + STR(DATEPART(&quot;month&quot;, [local_created_DATE])) + &quot;-&quot; + STR(DATEPART(&quot;day&quot;, [local_created_DATE]))&#10;ELSEIF [Parameters].[Parameter 1] = &quot;week&quot; AND week_num = 52 AND DATEPART(&quot;month&quot;, [local_created_DATE]) = 1 THEN &#10;STR(DATEPART(&quot;year&quot;, [local_created_DATE])-1) + &quot; W&quot; + STR([week_num])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;week&quot; AND week_num = 1 AND DATEPART(&quot;month&quot;, [local_created_DATE]) = 12 THEN &#13;&#10;STR(DATEPART(&quot;year&quot;, [local_created_DATE])+1) + &quot; W&quot; + STR([week_num])&#10;ELSEIF [Parameters].[Parameter 1] = &quot;week&quot; THEN &#10;STR(DATEPART(&quot;year&quot;, [local_created_DATE])) + &quot; W&quot; + STR([week_num])&#10;ELSEIF [Parameters].[Parameter 1] = &quot;month&quot; then &#10;STR(DATEPART(&quot;year&quot;, [local_created_DATE])) + &quot;-&quot; + STR(DATEPART(&quot;month&quot;, [local_created_DATE]))&#10;ELSEIF [Parameters].[Parameter 1] = &quot;quarter&quot; then&#10;STR(DATEPART(&quot;year&quot;, [local_created_DATE])) + &quot; Q&quot; + STR(DATEPART(&quot;quarter&quot;, [local_created_DATE]))&#10;ELSEIF [Parameters].[Parameter 1] = &quot;year&quot; then &#10;&quot;Year - &quot; + STR(DATEPART(&quot;year&quot;, [local_created_DATE]))&#10;END' />
      </column>
      <column caption='Region' datatype='string' name='[Calculation_2027534664725880840]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [region] = &quot;ap&quot; then &quot;APAC&quot;&#10;ELSEIF [region] = &quot;eu&quot; then &quot;EU&quot;&#10;ELSEIF [region] = &quot;kr&quot; then &quot;Korea&quot;&#10;ELSEIF [region] = &quot;us&quot; then &quot;US&quot;&#10;ELSEIF [region] = &quot;mena&quot; then &quot;MENA&quot;&#10;ELSE &quot;No Region Name Found&quot;&#10;END' />
      </column>
      <column caption='Vendor/ Order Density' datatype='real' name='[Calculation_2580140423699546112]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([daily_orders_completed])*COUNTD([local_created_DATE])/sum([vendor_areas_value])' />
      </column>
      <column caption='# Orders Completed' datatype='integer' name='[Calculation_2580140423700860929]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([daily_orders_completed])' />
      </column>
      <column caption='Total Vendor Area (km2)' datatype='real' name='[Calculation_2580140423700987906]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vendor_areas_value])/countd([local_created_DATE])' />
      </column>
      <column caption='Include Lost Orders Outliers' datatype='boolean' name='[Calculation_2744944008919482368]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [is_outlier_day] = 1 then TRUE ELSE FALSE END' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_4561583526561779713]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='# Lost Orders' datatype='integer' name='[Calculation_4859384016732233728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([lost_orders])' />
      </column>
      <column caption='# Cancelled Orders' datatype='integer' name='[Calculation_4859384016732581889]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([cancelled_orders])' />
