        <objects>
          <object caption='ABC OKRs Global' id='_104A0A4BC6244D019849C1B15AA4A39C'>
            <properties context=''>
              <relation connection='bigquery.1ox9mq710n9j2917gzumj02sz20b' name='Custom SQL Query' type='text'>SELECT DISTINCT 
  -- window functions needed to avoid duplicate values
  week
  -- pricing metrics
  , MAX(prio_fee_revenue_global) OVER(PARTITION BY week) AS prio_fee_revenue_global
  , MAX(sustainable_growth_global) OVER(PARTITION BY week) AS sustainable_growth_global
  -- seamless metrics
  , MAX(on_time_okr_weighted_per_pdt_global) OVER(PARTITION BY week) AS on_time_okr_weighted_per_pdt_global
  , MAX(on_time_okr_weighted_per_pdt_global_grocery) OVER(PARTITION BY week) AS on_time_okr_weighted_per_pdt_global_grocery
  , MAX(hc_session_rate_global) OVER(PARTITION BY week) AS hc_session_rate_global
  , MAX(avg_awt_global) OVER(PARTITION BY week) AS avg_awt_global
  -- choice metrics
  , MAX(incremental_orders_global) OVER(PARTITION BY week) AS incremental_orders_global
  , MAX(incremental_gmv_eur_global) OVER(PARTITION BY week) AS incremental_gmv_eur_global
  , MAX(gmv_gained_eur_global) OVER(PARTITION BY week) AS gmv_gained_eur_global
FROM `logistics-data-storage-staging.sandbox_Balint._cpl_abcs_reporting`
order by week</relation>
            </properties>
