    <worksheet name='Seamless Metrics Trend'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Metric Trend Over Time</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='mla_cpl_tracker_seamless_domain (rl)' name='federated.0f7n7px1lfejpd11hnbd21219hn9' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Weekly' caption='Time Dimension - ALL' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
              <calculation class='tableau' formula='&quot;week&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;quarter&quot;' value='Quarterly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0f7n7px1lfejpd11hnbd21219hn9'>
            <column caption='Region' datatype='string' name='[Calculation_2027534664719454214]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [region] = &quot;ap&quot; then &quot;APAC&quot;&#10;ELSEIF [region] = &quot;eu&quot; then &quot;EU&quot;&#10;ELSEIF [region] = &quot;kr&quot; then &quot;Korea&quot;&#10;ELSEIF [region] = &quot;us&quot; then &quot;US&quot;&#10;ELSEIF [region] = &quot;mena&quot; then &quot;MENA&quot;&#10;ELSEIF ISNULL([region]) then &quot;No Region Name Found&quot;&#10;END' />
            </column>
            <column caption='% Delivery Duration Buffer Orders' datatype='real' name='[Calculation_2899121913141293072]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_with_delay_buffer])*100/sum([total_completed_orders])' />
            </column>
            <column caption='% Cancelled Orders' datatype='real' name='[Calculation_2899121913159335953]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cancelled_orders])*100/sum([all_orders])' />
            </column>
            <column caption='Date Dimension' datatype='string' name='[Calculation_5054868409432371233]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;[Parameters].[Parameter 1] = &quot;day&quot; THEN&#10;STR(DATEPART(&quot;year&quot;, [local_created_date])) + &quot;-&quot; + STR(DATEPART(&quot;month&quot;, [local_created_date])) + &quot;-&quot; + STR(DATEPART(&quot;day&quot;, [local_created_date]))&#10;ELSEIF [Parameters].[Parameter 1] = &quot;week&quot; AND week_num = 52 AND DATEPART(&quot;month&quot;, [local_created_date]) = 1 THEN &#10;STR(DATEPART(&quot;year&quot;, [local_created_date])-1) + &quot; W&quot; + STR([week_num])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;week&quot; AND week_num = 1 AND DATEPART(&quot;month&quot;, [local_created_date]) = 12 THEN &#13;&#10;STR(DATEPART(&quot;year&quot;, [local_created_date])+1) + &quot; W&quot; + STR([week_num])&#10;ELSEIF [Parameters].[Parameter 1] = &quot;week&quot; THEN &#10;STR(DATEPART(&quot;year&quot;, [local_created_date])) + &quot; W&quot; + STR([week_num])&#10;ELSEIF [Parameters].[Parameter 1] = &quot;month&quot; then &#10;STR(DATEPART(&quot;year&quot;, [local_created_date])) + &quot;-&quot; + STR(DATEPART(&quot;month&quot;, [local_created_date]))&#10;ELSEIF [Parameters].[Parameter 1] = &quot;quarter&quot; then&#10;STR(DATEPART(&quot;year&quot;, [local_created_date])) + &quot; Q&quot; + STR(DATEPART(&quot;quarter&quot;, [local_created_date]))&#10;ELSEIF [Parameters].[Parameter 1] = &quot;year&quot; then &#10;&quot;Year - &quot; + STR(DATEPART(&quot;year&quot;, [local_created_date]))&#10;END' />
            </column>
            <column caption='Date Range' datatype='date' name='[Calculation_521291701238829056]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE([local_created_date])' />
            </column>
            <column caption='# Orders' datatype='integer' name='[all_orders]' role='measure' type='quantitative' />
            <column caption='Brand Name' datatype='string' name='[brand_name]' role='dimension' type='nominal' />
            <column caption='Cancelled Orders' datatype='integer' hidden='true' name='[cancelled_orders]' role='measure' type='quantitative' />
            <column caption='City Id' datatype='string' name='[city_id]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
