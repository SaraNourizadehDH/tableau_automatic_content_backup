    <worksheet name='Seamless Metrics Tabular'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Tabular View</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='mla_cpl_tracker_seamless_domain (rl)' name='federated.0f7n7px1lfejpd11hnbd21219hn9' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Weekly' caption='Time Dimension - ALL' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
              <calculation class='tableau' formula='&quot;week&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;quarter&quot;' value='Quarterly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0f7n7px1lfejpd11hnbd21219hn9'>
            <column caption='% Orders with Delay &gt; 20 mins' datatype='real' name='[% Cancelled Orders (copy)_1442418535904620544]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [delay_more_than_20mins] = &quot;Yes&quot; then [all_orders] end)*100/sum([all_orders])' />
            </column>
            <column caption='% D7 Re-Order Rate' datatype='real' name='[% D30 Re-Order Rate  (copy) (copy)_6688267710216187907]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([ror_num_7])*100/sum([ror_denom_7])' />
            </column>
            <column caption='% D15 Re-Order Rate' datatype='real' name='[% D30 Re-Order Rate  (copy)_6688267710216175618]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([ror_num_15])*100/sum([ror_denom_15])' />
            </column>
            <column caption='% Timestamp Jump Rate' datatype='real' name='[% ETA Jump Rate (copy)_3151604980299325440]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([ts_jump_orders])*100/sum([all_orders])' />
            </column>
            <column caption='% ETA Stuck' datatype='real' name='[% Jump Score (copy 2)_6172042606482374658]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([eta_stuck_order])*100/sum([all_orders])' />
            </column>
            <column caption='% Upward Jumps' datatype='real' name='[% Jump Score (copy)_6172042606482350081]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([jump_orders])*100/sum([all_orders])' />
            </column>
            <column caption='% Orders with Delay &gt; 30 mins' datatype='real' name='[% Orders with Delay &gt; 20 mins (copy)_1442418535905644545]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [delay_more_than_30mins] = &quot;Yes&quot; then [all_orders] end)*100/sum([all_orders])' />
            </column>
            <column caption='AAPT_V2' datatype='real' name='[AVTC (copy)_536069120154550272]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([avtc_v2]*[total_completed_orders])/sum([total_completed_orders])' />
            </column>
            <column caption='AVTC_V2' datatype='real' name='[AVTC_V2 (copy)_536069120154673153]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([aapt_v2]*[total_completed_orders])/sum([total_completed_orders])' />
            </column>
            <column caption='Est Delivery Duration Buffer' datatype='real' name='[Avg Courier Delay (copy)_2019512645965553668]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([estimated_delivery_duration_buffer]*[all_orders])/sum([all_orders])' />
            </column>
            <column caption='AVTC' datatype='real' name='[Calculation_1658802430376423428]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([avtc]*[total_completed_orders])/sum([total_completed_orders])' />
            </column>
            <column caption='AVTC (Without Fixed PDT Vendors)' datatype='real' name='[Calculation_1658802430376493061]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([avtc_without_fixed_preptimes]*[total_completed_orders])/sum([total_completed_orders])' />
            </column>
            <column caption='% Customer Contact Rate (Delay Reason) After Notif' datatype='real' name='[Calculation_1658802430746427402]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([contacts_after_notif])*100/sum([ttl_contacts])' />
            </column>
            <column caption='Time To Contact (Live Order Status) After Notif' datatype='real' name='[Calculation_1658802430747021324]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([avg_time_to_contact_after_notif]*[orders_with_contact_after_notif])/sum([orders_with_contact_after_notif])' />
            </column>
            <column caption='Time To Contact (Live Order Status)' datatype='real' name='[Calculation_1658802430747738125]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([avg_time_to_contact]*[delay_based_contact_orders])/sum([delay_based_contact_orders])' />
            </column>
            <column caption='Time To Notify' datatype='real' name='[Calculation_1658802430748164110]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([avg_time_to_notify]*[cust_notif_orders])/sum([cust_notif_orders])' />
            </column>
            <column caption='% Stacked Orders' datatype='real' name='[Calculation_191121541148971008]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [stacked_tag] = &quot;Stacked Order&quot; then &#10;[total_completed_orders]&#10;END)*100&#10;/&#10;sum([total_completed_orders])' />
            </column>
            <column caption='% Cancelled Orders - Customer Reasons (Mistake/ Late ETA/ Item Unavailable)' datatype='real' name='[Calculation_191121541152358401]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;sum([cancelled_orders_mistake_error])&#10;+ &#10;sum([cancelled_orders_late_eta])&#10;+&#10;sum([cancelled_orders_item_unavailable])&#10;)*100/sum([all_orders])' />
            </column>
            <column caption='Est Courier Delay' datatype='real' name='[Calculation_2019512645964787715]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([estimated_courier_delay]*[all_orders])/sum([all_orders])' />
            </column>
            <column caption='Region' datatype='string' name='[Calculation_2027534664719454214]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [region] = &quot;ap&quot; then &quot;APAC&quot;&#10;ELSEIF [region] = &quot;eu&quot; then &quot;EU&quot;&#10;ELSEIF [region] = &quot;kr&quot; then &quot;Korea&quot;&#10;ELSEIF [region] = &quot;us&quot; then &quot;US&quot;&#10;ELSEIF [region] = &quot;mena&quot; then &quot;MENA&quot;&#10;ELSEIF ISNULL([region]) then &quot;No Region Name Found&quot;&#10;END' />
            </column>
            <column caption='% On-Time [Ranges]' datatype='real' name='[Calculation_2643472311440146503]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([abc_ontime_num])*100/sum([abc_denom])' />
            </column>
            <column caption='% Late Orders [Ranges]' datatype='real' name='[Calculation_2643472311440425032]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([abc_late_num])*100/sum([abc_denom])' />
            </column>
            <column caption='% Early Orders [Ranges]' datatype='real' name='[Calculation_2643472311440584777]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([abc_early_num])*100/sum([abc_denom])' />
            </column>
            <column caption='% Customer Notif Orders' datatype='real' name='[Calculation_2867033747621736448]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(cust_notif_orders)*100/sum(all_orders)' />
            </column>
            <column caption='% Orders On Time [+/-10 mins]' datatype='real' name='[Calculation_2899121911351926784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ontime_orders])*100/sum([total_completed_orders_no_preorder])' />
            </column>
            <column caption='% Early Orders [+/-10 mins]' datatype='real' name='[Calculation_2899121911352381441]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([early_orders_10_mins])*100/sum([total_completed_orders_no_preorder])' />
            </column>
            <column caption='% Late Orders [+/-10 mins]' datatype='real' name='[Calculation_2899121911352827906]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([late_orders_10_mins])*100/sum([total_completed_orders_no_preorder])' />
            </column>
            <column caption='% Early Orders &gt; 5 mins' datatype='real' name='[Calculation_2899121911356506115]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([early_orders_5_mins])*100/sum([total_completed_orders_no_preorder])' />
            </column>
            <column caption='% Late Orders &gt; 5 mins' datatype='real' name='[Calculation_2899121911356735492]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([late_orders_5_mins])*100/sum([total_completed_orders_no_preorder])' />
            </column>
            <column caption='% Seamless Orders' datatype='real' name='[Calculation_2899121911357075461]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([seamless_numerator])*100/sum([seamless_denom])' />
            </column>
            <column caption='% Customer Contact Rate  [Seamless Reasons]' datatype='real' name='[Calculation_2899121911357571078]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([delay_based_contact_orders])*100/sum([all_orders])' />
            </column>
            <column caption='% HC Session Rate [Seamless Reasons]' datatype='real' name='[Calculation_2899121911358017543]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([hc_session_orders])*100/sum([all_orders])' />
            </column>
            <column caption='Avg PDT' datatype='real' name='[Calculation_2899121912705187850]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([pdt (mla_cpl_tracker_seamless_domain)]*[total_completed_orders])/sum([total_completed_orders])' />
            </column>
            <column caption='Avg DT' datatype='real' name='[Calculation_2899121912705961995]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([dt (mla_cpl_tracker_seamless_domain)]*[total_completed_orders])/sum([total_completed_orders])' />
            </column>
            <column caption='Avg EPT' datatype='real' name='[Calculation_2899121913132777487]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([ept (mla_cpl_tracker_seamless_domain)]*[total_completed_orders])/sum([total_completed_orders])' />
            </column>
            <column caption='% Delivery Duration Buffer Orders' datatype='real' name='[Calculation_2899121913141293072]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_with_delay_buffer])*100/sum([total_completed_orders])' />
            </column>
            <column caption='% Cancelled Orders' datatype='real' name='[Calculation_2899121913159335953]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cancelled_orders])*100/sum([all_orders])' />
            </column>
            <column caption='% Cancelled Orders - Mistake/ Error' datatype='real' name='[Calculation_2899121913159512082]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cancelled_orders_mistake_error])*100/sum([all_orders])' />
            </column>
            <column caption='% Cancelled Orders - No Courier' datatype='real' name='[Calculation_2899121913159823380]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cancelled_orders_no_courier (mla_cpl_tracker_seamless_domain)])*100/sum([all_orders])' />
            </column>
            <column caption='% Cancelled Orders - ETA Too Long/ Late' datatype='real' name='[Calculation_2899121913159991317]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cancelled_orders_late_eta])*100/sum([all_orders])' />
            </column>
            <column caption='% Orders with Fixed Prep Time' datatype='real' name='[Calculation_2899121913441923096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([fixed_pt_orders])*100/sum([all_orders])' />
            </column>
            <column caption='Local Date' datatype='date' name='[Calculation_4921519628160028673]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='date([local_created_date])' />
            </column>
            <column caption='Date Dimension' datatype='string' name='[Calculation_5054868409432371233]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;[Parameters].[Parameter 1] = &quot;day&quot; THEN&#10;STR(DATEPART(&quot;year&quot;, [local_created_date])) + &quot;-&quot; + STR(DATEPART(&quot;month&quot;, [local_created_date])) + &quot;-&quot; + STR(DATEPART(&quot;day&quot;, [local_created_date]))&#10;ELSEIF [Parameters].[Parameter 1] = &quot;week&quot; AND week_num = 52 AND DATEPART(&quot;month&quot;, [local_created_date]) = 1 THEN &#10;STR(DATEPART(&quot;year&quot;, [local_created_date])-1) + &quot; W&quot; + STR([week_num])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;week&quot; AND week_num = 1 AND DATEPART(&quot;month&quot;, [local_created_date]) = 12 THEN &#13;&#10;STR(DATEPART(&quot;year&quot;, [local_created_date])+1) + &quot; W&quot; + STR([week_num])&#10;ELSEIF [Parameters].[Parameter 1] = &quot;week&quot; THEN &#10;STR(DATEPART(&quot;year&quot;, [local_created_date])) + &quot; W&quot; + STR([week_num])&#10;ELSEIF [Parameters].[Parameter 1] = &quot;month&quot; then &#10;STR(DATEPART(&quot;year&quot;, [local_created_date])) + &quot;-&quot; + STR(DATEPART(&quot;month&quot;, [local_created_date]))&#10;ELSEIF [Parameters].[Parameter 1] = &quot;quarter&quot; then&#10;STR(DATEPART(&quot;year&quot;, [local_created_date])) + &quot; Q&quot; + STR(DATEPART(&quot;quarter&quot;, [local_created_date]))&#10;ELSEIF [Parameters].[Parameter 1] = &quot;year&quot; then &#10;&quot;Year - &quot; + STR(DATEPART(&quot;year&quot;, [local_created_date]))&#10;END' />
            </column>
            <column caption='Date Range' datatype='date' name='[Calculation_521291701238829056]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE([local_created_date])' />
            </column>
            <column caption='% Rider Late &gt; 5 mins' datatype='real' name='[Calculation_5571304588595470336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([rider_late_5mins])*100/sum(all_orders)' />
            </column>
            <column caption='% Rider Late &gt; 10 mins' datatype='real' name='[Calculation_5571304588595724289]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([rider_late_10mins])*100/sum(all_orders)' />
            </column>
            <column caption='% Vendor Late &gt; 5 mins' datatype='real' name='[Calculation_5571304588595843074]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vendor_late_5mins])*100/sum(all_orders)' />
            </column>
            <column caption='% Vendor Late &gt; 10 mins' datatype='real' name='[Calculation_5571304588595986435]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vendor_late_10mins])*100/sum(all_orders)' />
            </column>
            <column caption='% ETA Jump Rate' datatype='real' name='[Calculation_6172042606482206720]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([jump_score_orders])*100/sum([all_orders])' />
            </column>
            <column caption='% Orders with DT &gt; 45' datatype='real' name='[Calculation_6172042606483406851]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([dt_more_than_45m_comp_orders])*100/sum([total_completed_orders_no_preorder])' />
            </column>
            <column caption='% D30 Re-Order Rate ' datatype='real' name='[Calculation_6688267710215983105]' role='measure' type='quantitative'>
