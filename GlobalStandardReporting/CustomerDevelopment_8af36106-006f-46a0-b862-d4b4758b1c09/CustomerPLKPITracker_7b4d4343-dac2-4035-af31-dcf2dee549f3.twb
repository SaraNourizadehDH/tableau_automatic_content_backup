      <column caption='% Orders with Delay &gt; 20 mins' datatype='real' name='[% Cancelled Orders (copy)_1442418535904620544]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [delay_more_than_20mins] = &quot;Yes&quot; then [all_orders] end)*100/sum([all_orders])' />
