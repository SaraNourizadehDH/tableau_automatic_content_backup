    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Glossary'>
      <repository-location id='Glossary' path='/t/GlobalStandardReporting/workbooks/WIP-ContentScore' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='1200' maxwidth='1200' minheight='1200' minwidth='1200' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98666' id='1128' param='horz' type-v2='layout-flow' w='98666' x='667' y='667'>
            <zone h='98666' id='779' type-v2='layout-basic' w='98666' x='667' y='667'>
              <zone h='12916' id='776' param='horz' type-v2='layout-flow' w='98666' x='667' y='667'>
                <zone h='12916' id='618' type-v2='layout-basic' w='98666' x='667' y='667'>
                  <zone h='12916' id='96' param='horz' type-v2='layout-flow' w='98666' x='667' y='667'>
                    <zone h='12916' id='91' type-v2='layout-basic' w='98666' x='667' y='667'>
                      <zone forceUpdate='true' h='12916' id='16' type-v2='text' w='31844' x='23500' y='667'>
                        <formatted-text>
                          <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='20'>Glossary</run>
                          <run fontalignment='1'>Æ&#10;</run>
                        </formatted-text>
                        <zone-style>
                          <format attr='border-color' value='#000000' />
                          <format attr='border-style' value='none' />
                          <format attr='border-width' value='0' />
                          <format attr='margin' value='4' />
                        </zone-style>
                      </zone>
                      <zone h='12916' id='55' is-scaled='1' param='Image/DH Logistics Logo.png' type-v2='bitmap' w='22833' x='667' y='667'>
                        <zone-style>
                          <format attr='border-color' value='#000000' />
                          <format attr='border-style' value='none' />
                          <format attr='border-width' value='0' />
                          <format attr='margin' value='4' />
                        </zone-style>
                      </zone>
                      <zone h='12916' id='1123' type-v2='empty' w='43989' x='55344' y='667'>
                        <zone-style>
                          <format attr='border-color' value='#000000' />
                          <format attr='border-style' value='none' />
                          <format attr='border-width' value='0' />
                          <format attr='margin' value='4' />
                        </zone-style>
                      </zone>
                    </zone>
                  </zone>
                </zone>
              </zone>
              <zone h='85750' id='777' param='vert' type-v2='layout-flow' w='98666' x='667' y='13583'>
                <zone fixed-size='358' forceUpdate='true' h='30500' id='1146' is-fixed='true' type-v2='text' w='98666' x='667' y='13583'>
                  <formatted-text>
                    <run bold='true' fontsize='12'>Choice Index:  </run>
                    <run fontsize='12'>Index created as the weighted sum of Density, Variety and Popularity scores. </run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#000000'>Choice index = (</run>
                    <run fontcolor='#ff00ff'>W_Density * Score_Density</run>
                    <run fontcolor='#000000'>) + (</run>
                    <run fontcolor='#e69138'>W_Variety * Score_Variety</run>
                    <run fontcolor='#000000'>) + (</run>
                    <run fontcolor='#4a86e8'>W_Popularity * Score_Popularity</run>
                    <run fontcolor='#000000'>)</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontsize='12'>Popularity Score:</run>
                    <run fontsize='12'> Measures the availability of the most popular stores in terms of orders. </run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontsize='12'>Variety Score: </run>
                    <run fontsize='12'>Measures how much variety we offer in terms of cuisines. </run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontsize='12'>Density Score:</run>
                    <run fontsize='12'> Measures the count of vendors available per session. </run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontsize='12'>Vendor Count: </run>
                    <run fontsize='12'>Average number of vendors that their delivery area covers a given hexagon. </run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontsize='12'>Main Cuisines Count: </run>
                    <run fontcolor='#000000a8' fontsize='12'>Average number of different main cuisines of the vendors that deliver in a given  hexagon.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                  </zone-style>
                </zone>
              </zone>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
        <zone h='2786' id='1057' param='horz' type-v2='layout-flow' w='101571' x='-571' y='0'>
          <zone fixed-size='821' h='2620' id='1121' is-fixed='true' type-v2='empty' w='101405' x='-488' y='83'>
