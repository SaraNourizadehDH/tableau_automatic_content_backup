    <worksheet name='D4-df bins'>
      <table>
        <view>
          <datasources>
            <datasource caption='dps_ab_test_dashboard_orders_distribution' name='federated.0z9i7141jphcae10ynvfb0vkqvxz' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose Distribution View' datatype='string' name='[Choose Metric to Bin (copy)_656047842581549057]' param-domain-type='list' role='measure' type='nominal' value='&quot;Shared&quot;'>
              <calculation class='tableau' formula='&quot;Shared&quot;' />
            </column>
            <column caption='Choose Currency' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Euro&quot;'>
              <calculation class='tableau' formula='&quot;Euro&quot;' />
            </column>
            <column caption='Bin Size' datatype='real' name='[Parameter 4]' param-domain-type='range' role='measure' type='quantitative' value='2.'>
              <calculation class='tableau' formula='2.' />
              <range max='10000.0' min='1.0' />
            </column>
            <column caption='Choose Metric to Bin' datatype='string' name='[Parameter 8]' param-domain-type='list' role='measure' type='nominal' value='&quot;Food Value&quot;'>
              <calculation class='tableau' formula='&quot;Food Value&quot;' />
            </column>
            <column alias='0.1%' caption='Bin Threshold -  % of Orders' datatype='real' name='[Parameter 9]' param-domain-type='list' role='measure' type='quantitative' value='0.001'>
              <calculation class='tableau' formula='0.001' />
              <aliases>
                <alias key='0.' value='None' />
                <alias key='0.0001' value='0.01%' />
                <alias key='0.001' value='0.1%' />
                <alias key='0.01' value='1%' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0z9i7141jphcae10ynvfb0vkqvxz'>
            <column caption='Food Value Bins' datatype='string' name='[Calculation_3194741047599722497]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 8] = &apos;Food Value&apos; AND [Parameters].[Parameter 3] = &apos;Euro&apos; AND [gfv_eur] &gt;= 100 &#10;  THEN &apos;&gt;= 100&apos;&#10;&#10;ELSEIF [Parameters].[Parameter 8] = &apos;Food Value&apos; AND [Parameters].[Parameter 3] = &apos;Euro&apos; AND [gfv_eur] &lt; 100&#10;  THEN STR(FLOOR([gfv_eur]/ [Parameters].[Parameter 4]) * [Parameters].[Parameter 4])&#10;&#10;ELSEIF [Parameters].[Parameter 8] = &apos;Food Value&apos; AND [Parameters].[Parameter 3] = &apos;Local&apos; &#10;  THEN STR(FLOOR([gfv_local]/ [Parameters].[Parameter 4]) * [Parameters].[Parameter 4])&#10;&#10;END' />
            </column>
            <column caption='Orders' datatype='integer' name='[Calculation_3194741047603007490]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([fe_platform_order_code])' />
            </column>
            <column caption='% of Total Orders' datatype='real' default-format='p0.0%' name='[Calculation_3194741047603109891]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3194741047603007490] / TOTAL(COUNTD([fe_platform_order_code]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Metric to bin' datatype='string' name='[Calculation_3194741047614566407]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 8]' />
            </column>
            <column caption='Variant Rank' datatype='integer' name='[Calculation_3194741047659769871]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [dps_test_variant] &#10;WHEN &apos;Control&apos; THEN 0&#10;WHEN &apos;Original&apos; THEN 9999&#10;WHEN NULL THEN 1000000&#10;ELSE INT(RIGHT([dps_test_variant], 1))&#10;END' />
            </column>
            <column caption='is above threshold' datatype='boolean' name='[Calculation_3194741047921946651]' role='measure' type='nominal'>
              <calculation class='tableau' formula='[Calculation_3194741047603109891] &gt; [Parameters].[Parameter 9]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Distribution View' datatype='string' name='[Calculation_656047842581970946]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Choose Metric to Bin (copy)_656047842581549057]' />
            </column>
            <column caption='Delivery Fee Bins' datatype='string' name='[Food Value Bins (copy)_2985323669850558464]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 8] = &apos;DPS Delivery Fee&apos; AND [Parameters].[Parameter 3] = &apos;Euro&apos;&#10;  THEN STR(FLOOR([dps_delivery_fee_eur]/ [Parameters].[Parameter 4]) * [Parameters].[Parameter 4])&#10;&#10;ELSEIF [Parameters].[Parameter 8] = &apos;DPS Delivery Fee&apos; AND [Parameters].[Parameter 3] = &apos;Local&apos; &#10;  THEN STR(FLOOR([dps_delivery_fee_local]/ [Parameters].[Parameter 4]) * [Parameters].[Parameter 4])&#10;&#10;END' />
            </column>
            <column caption='Travel Time Bins' datatype='string' name='[Food Value Bins (copy)_3194741047615119368]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 8] = &apos;Travel Time&apos; AND [travel_time] &gt;= 200 THEN &apos;&gt;= 200&apos;&#10;  ELSE STR(FLOOR([travel_time]/ [Parameters].[Parameter 4]) * [Parameters].[Parameter 4])&#10;END' />
