              <zone forceUpdate='true' h='2222' id='528' type-v2='text' w='64000' x='35200' y='46790'>
                <formatted-text>
                  <run fontcolor='#333333' fontname='Tableau Light' fontsize='8'> % in the header - User Share, calculated on the test level for all the report dates regardless of any filters above.</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#333333' fontname='Tableau Light' fontsize='8'>* Adjusted Orders is calculated by Total Orders * Weight Factor, where</run>
                  <run fontcolor='#333333' fontname='Tableau Light' fontsize='8' italic='true'> Weight Factor = % User Shares (Control) / % User Shares (VariationX)</run>
                  <run>Æ&#10;</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
