    <worksheet name='D1-FeeBreakdownByHour'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>Fee Breakdown By Weekday/Hour</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='dps_ab_tests_dashboard_orders' name='federated.0w9n00s0qz28z41eqc4f50igx0w2' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.0w9n00s0qz28z41eqc4f50igx0w2].[test_name]' caption='Test Name' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;AE_20_11_DBDF_w_HigherPP_Ajman&quot;'>
              <calculation class='tableau' formula='&quot;AE_20_11_DBDF_w_HigherPP_Ajman&quot;' />
            </column>
            <column caption='Show Original' datatype='string' name='[Variant Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;False&quot;'>
              <calculation class='tableau' formula='&quot;False&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0w9n00s0qz28z41eqc4f50igx0w2'>
            <column caption='Avg DF (local)' datatype='real' name='[Avg DF (euro) (copy)_6340646114708828163]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_fee_local_sum])/ SUM([delivery_fee_local_count])' />
            </column>
            <column caption='Avg Surge Fee (local)' datatype='real' name='[Avg DF (euro) (copy)_6340646114718908420]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dps_surge_fee_sum])/ SUM([dps_surge_fee_count])' />
            </column>
            <column caption='Avg Fleet Delay (min)' datatype='real' name='[Avg To Vendor Time (min) (copy)_6340646115599810569]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([mean_delay_sum])/ SUM([mean_delay_count])' />
            </column>
            <column caption='Customer Tag' datatype='string' name='[Calculation_2923891743211126788]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([dps_customer_tag]) THEN &apos;Null&apos;&#10;ELSE [dps_customer_tag]&#10;END' />
            </column>
            <column caption='Selected Test Name' datatype='boolean' name='[Calculation_3027122641037082631]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 4] = [test_name]' />
            </column>
            <column caption='Chain Tag' datatype='string' name='[Calculation_5679109506331693058]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [dps_key_account]&#10;&#10;WHEN True THEN &apos;Key Chain Vendors&apos;&#10;WHEN False THEN &apos;Others&apos;&#13;&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='created_date_weekday' datatype='string' name='[Calculation_6340646115753631766]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;, [created_hour_local])' />
            </column>
            <column caption='Show Original' datatype='boolean' name='[Calculation_6340646115765952536]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Variant Parameter]&#10;&#10;WHEN &apos;False&apos; THEN ([dps_test_variant] != &apos;Original&apos;) AND NOT(ISNULL([dps_test_variant]))&#10;WHEN &apos;True&apos; THEN ([created_date_local] != &apos;1999&apos;)&#10;END' />
            </column>
            <column caption='Country Code' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
