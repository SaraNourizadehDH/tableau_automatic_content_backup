            <datasource caption='dps_ab_tests_dashboard_cvr' name='federated.1p54svq183ik2q18yso2g1r8ztdq' />
            <datasource caption='dps_ab_tests_dashboard_orders' name='federated.0w9n00s0qz28z41eqc4f50igx0w2' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose Metrics CVR' datatype='string' datatype-customized='true' name='[Choose Metrics (copy)_3027122641026084868]' param-domain-type='list' role='measure' type='nominal' value='&quot;CVR&quot;'>
              <calculation class='tableau' formula='&quot;CVR&quot;' />
              <aliases>
                <alias key='&quot;Total Sessions&quot;' value='# Sessions' />
                <alias key='&quot;Total Users&quot;' value='# Users' />
                <alias key='&quot;Total Users per day&quot;' value='# Users per day' />
              </aliases>
            </column>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.0w9n00s0qz28z41eqc4f50igx0w2].[test_name]' caption='Test Name' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;AE_20_11_DBDF_w_HigherPP_Ajman&quot;'>
              <calculation class='tableau' formula='&quot;AE_20_11_DBDF_w_HigherPP_Ajman&quot;' />
            </column>
            <column caption='Show Original-cvr' datatype='string' name='[Show Original (copy)_1824872698418741251]' param-domain-type='list' role='measure' type='nominal' value='&quot;False&quot;'>
              <calculation class='tableau' formula='&quot;False&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0w9n00s0qz28z41eqc4f50igx0w2'>
            <column datatype='string' name='[test_name]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1p54svq183ik2q18yso2g1r8ztdq'>
            <column caption='Customer Tag' datatype='string' name='[Calculation_2923891743236423687]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([customer_tag]) THEN &apos;Null&apos;&#10;ELSE [customer_tag]&#10;END' />
            </column>
            <column caption='Zones ID/Zones Name' datatype='string' name='[Calculation_2923891743525847051]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[zones_id] + &apos; (&apos;+ [zones_name] + &apos; )&apos;' />
            </column>
            <column caption='Selected Test Name' datatype='boolean' name='[Calculation_3027122641038233608]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 4] = [test_name]' />
            </column>
            <column caption='KPI view filter' datatype='string' name='[Calculation_3027122641063067659]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Choose Metrics (copy)_3027122641026084868]' />
            </column>
            <column caption='CVR' datatype='real' default-format='p0.00%' name='[Calculation_6340646115994644505]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([transaction_no_count]) / SUM([session_id_count])' />
            </column>
            <column caption='Show Original' datatype='boolean' name='[Calculation_6340646115996811293]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Show Original (copy)_1824872698418741251]&#10;&#10;WHEN &apos;False&apos; THEN ([variant] != &apos;Original&apos;) AND NOT(ISNULL([variant]))&#10;WHEN &apos;True&apos; THEN ([created_date] != &apos;1999&apos;)&#10;END' />
            </column>
            <column-instance column='[variant_description]' derivation='Attribute' name='[attr:variant_description:nk]' pivot='key' type='nominal' />
            <column caption='Country Code' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
