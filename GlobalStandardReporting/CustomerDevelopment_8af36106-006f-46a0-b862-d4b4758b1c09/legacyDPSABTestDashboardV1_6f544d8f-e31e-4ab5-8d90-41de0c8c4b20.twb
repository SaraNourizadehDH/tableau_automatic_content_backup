          <alias key='&quot;[federated.1p54svq183ik2q18yso2g1r8ztdq].[usr:Total Sessions (copy)_3027122641023188993:qk]&quot;' value='# Users' />
        </aliases>
      </column>
      <column caption='Total Sessions' datatype='integer' name='[CVR (copy)_3027122641022816256]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([session_id_count])' />
      </column>
      <column caption='mCVR2' datatype='real' name='[CVR (copy)_6340646115994927130]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([list_menu_count]) / SUM([shop_list_no_count])' />
      </column>
      <column caption='Customer Tag' datatype='string' name='[Calculation_2923891743236423687]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([customer_tag]) THEN &apos;Null&apos;&#10;ELSE [customer_tag]&#10;END' />
      </column>
      <column caption='Zones ID/Zones Name' datatype='string' name='[Calculation_2923891743525847051]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[zones_id] + &apos; (&apos;+ [zones_name] + &apos; )&apos;' />
      </column>
      <column caption='Metrics' datatype='integer' name='[Calculation_3027122641028079622]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE   [Parameters].[Choose Metrics (copy)_3027122641026084868]&#10;WHEN &apos;Total Sessions&apos;  THEN [CVR (copy)_3027122641022816256]&#10;WHEN &apos;Total Users&apos;  THEN [Total Sessions (copy)_3027122641023188993]&#10;WHEN &apos;Total Users per day&apos; THEN [Total Users (copy)_3714625271970017280]&#10;END' />
      </column>
      <column caption='Selected Test Name' datatype='boolean' name='[Calculation_3027122641038233608]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 4] = [test_name]' />
      </column>
      <column caption='KPI view filter' datatype='string' name='[Calculation_3027122641063067659]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Choose Metrics (copy)_3027122641026084868]' />
      </column>
      <column caption='CVR' datatype='real' default-format='p0.00%' name='[Calculation_6340646115994644505]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([transaction_no_count]) / SUM([session_id_count])' />
      </column>
      <column caption='Show Original' datatype='boolean' name='[Calculation_6340646115996811293]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Show Original (copy)_1824872698418741251]&#10;&#10;WHEN &apos;False&apos; THEN ([variant] != &apos;Original&apos;) AND NOT(ISNULL([variant]))&#10;WHEN &apos;True&apos; THEN ([created_date] != &apos;1999&apos;)&#10;END' />
      </column>
      <column caption='Total Users' datatype='integer' name='[Total Sessions (copy)_3027122641023188993]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([users_count])' />
      </column>
      <column caption='% Sessions with PersuesID' datatype='real' default-format='p0.0%' name='[Total Users (copy)_3027122641024196610]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([session_with_pid_count]) / SUM([session_id_count])' />
      </column>
      <column caption='Total Users per day' datatype='integer' name='[Total Users (copy)_3714625271970017280]' role='measure' type='quantitative'>
