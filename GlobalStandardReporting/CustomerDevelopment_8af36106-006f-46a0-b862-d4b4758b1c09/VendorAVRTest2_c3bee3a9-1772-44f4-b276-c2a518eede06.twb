    <worksheet name='Additional Commission due to Commission Packages'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Additional Commission due to Commission Packages
</run>
            <run fontsize='7'>* Out of the vendors that have Commission Packages, Commission in Green comes from the increase in DTP. </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='_vendor_avr_week_comparison+ (rl)' name='federated.16hv2xy0pqb43j183xtn204rbn69' />
          </datasources>
          <datasource-dependencies datasource='federated.16hv2xy0pqb43j183xtn204rbn69'>
            <column caption='Has Commission Package' datatype='boolean' name='[Calculation_55239465552756736]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [enable_group] IN (&quot;Gold&quot;, &quot;Silver&quot;, &quot;Platinum&quot;)&#10;THEN TRUE&#10;ELSE FALSE END' />
            </column>
            <column caption='Commission from Boosted Vendors AVG DTP' datatype='real' name='[Calculation_575123748260675586]' role='measure' type='quantitative'>
