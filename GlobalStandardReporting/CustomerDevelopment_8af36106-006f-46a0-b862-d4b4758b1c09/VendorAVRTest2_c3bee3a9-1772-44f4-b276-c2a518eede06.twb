      <aliases enabled='yes' />
      <column caption='To Customer Time Indicator' datatype='string' name='[At Vendor Time Indicator (copy)_415034858836111363]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ([Calculation_5862349746752987141]) &gt; LOOKUP([Calculation_5862349746752987141], -1) THEN &apos;Improved&apos;&#10;ELSEIF [Calculation_5862349746752987141] &lt; LOOKUP([Calculation_5862349746752987141], -1) THEN &apos;Worsened&apos;&#10;ELSE &apos;No Change&apos; END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Delivery Area km2 Indicator' datatype='string' name='[At Vendor Time Indicator (copy)_415034858836533252]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ([Calculation_6626343202318528512]) &gt; LOOKUP([Calculation_6626343202318528512], -1) THEN &apos;Improved&apos;&#10;ELSEIF [Calculation_6626343202318528512] &lt; LOOKUP([Calculation_6626343202318528512], -1) THEN &apos;Worsened&apos;&#10;ELSE &apos;No Change&apos; END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
