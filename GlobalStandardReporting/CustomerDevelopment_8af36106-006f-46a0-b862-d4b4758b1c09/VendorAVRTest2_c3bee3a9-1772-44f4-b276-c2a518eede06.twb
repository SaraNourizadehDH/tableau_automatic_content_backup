        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10; WHEN &apos;Total Orders&apos; THEN [Calculation_986006844949229581]&#10;WHEN &apos;Avg Delivery Time&apos; THEN -[Calculation_986006844949229581]&#10;WHEN &apos;Avg At Vendor Time Cleaned&apos; THEN -[Calculation_986006844949229581]&#10;WHEN &apos;Avg To Customer Time&apos; THEN -[Calculation_986006844949229581]&#10;WHEN &apos;Avg Delivery Area km2&apos; THEN -[Calculation_986006844949229581]&#10;WHEN &apos;CVR&apos; THEN 100*[Calculation_986006844949229581]&#10;WHEN &apos;Reorder Rate 7d&apos; THEN 100*[Calculation_986006844949229581]&#10;WHEN &apos;Reorder Rate 14d&apos; THEN 100*[Calculation_986006844949229581]&#10;WHEN &apos;Reorder Rate 30d&apos; THEN 100*[Calculation_986006844949229581]&#10;WHEN &apos;Avg Distance km&apos; THEN -[Calculation_986006844949229581]&#10;WHEN &apos;CPO OD Eur&apos; THEN -[Calculation_986006844949229581]&#10;WHEN &apos;GPO OD Eur&apos; THEN [Calculation_986006844949229581]&#10;WHEN &apos;Avg Vendor Late&apos; THEN -[Calculation_986006844949229581]&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
