            </column>
            <column caption='Avg To Customer Time' datatype='real' name='[Calculation_5862349746752987141]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([to_customer_time_mins_numerator])/SUM([to_customer_time_mins_denominator])' />
            </column>
            <column caption='Avg At Vendor Time Cleaned' datatype='real' name='[Calculation_6398489208669175808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([at_vendor_time_cleaned_mins_numerator])/sum([at_vendor_time_cleaned_mins_denominator])' />
