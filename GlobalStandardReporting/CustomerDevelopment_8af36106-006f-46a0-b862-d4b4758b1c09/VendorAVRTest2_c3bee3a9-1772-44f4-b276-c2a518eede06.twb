          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Vendor Late Indicator' datatype='string' name='[At Vendor Time Indicator (copy)_415034858839322636]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ([Calculation_6626343202340605959]) &gt; LOOKUP([Calculation_6626343202340605959], -1) THEN &apos;Improved&apos;&#10;ELSEIF [Calculation_6626343202340605959] &lt; LOOKUP([Calculation_6626343202340605959], -1) THEN &apos;Worsened&apos;&#10;ELSE &apos;No Change&apos; END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='GPO Indicator' datatype='string' name='[CPO Indicator (copy)_415034858839048203]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ([Calculation_6626343202339921926]) &gt; LOOKUP([Calculation_6626343202339921926], -1) THEN &apos;Improved&apos;&#10;ELSEIF [Calculation_6626343202339921926]&lt; LOOKUP([Calculation_6626343202339921926], -1) THEN &apos;Worsened&apos;&#10;ELSE &apos;No Change&apos; END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Reorder Rate 7 Indicator' datatype='string' name='[CVR Indicator (copy)_415034858837577734]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ([Calculation_6626343202325921793]) &gt; LOOKUP([Calculation_6626343202325921793], -1) THEN &apos;Improved&apos;&#10;ELSEIF [Calculation_6626343202325921793] &lt; LOOKUP([Calculation_6626343202325921793], -1) THEN &apos;Worsened&apos;&#10;ELSE &apos;No Change&apos; END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='CPO Indicator' datatype='string' name='[CVR Indicator (copy)_415034858838773770]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ([Calculation_6626343202329563141]) &gt; LOOKUP([Calculation_6626343202329563141], -1) THEN &apos;Improved&apos;&#10;ELSEIF [Calculation_6626343202329563141] &lt; LOOKUP([Calculation_6626343202329563141], -1) THEN &apos;Worsened&apos;&#10;ELSE &apos;No Change&apos; END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Configurations' datatype='integer' name='[Calculation_1203798117097521152]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [no_configs_per_city] WHEN 0 THEN NULL &#10;ELSE [no_configs_per_city] END' />
      </column>
      <column caption='zone_vendor' datatype='string' name='[Calculation_156992717705424896]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([zone_id])+&quot;_&quot;+[VendorCodeZoneShrinkingEnabled]' />
      </column>
      <column caption='Calculation2' datatype='integer' name='[Calculation_2222104240155815936]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[orders]' />
      </column>
      <column caption='Inactive Zones Filter' datatype='integer' name='[Calculation_2222104241115041793]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [country_code], [zone_id] : SUM([orders])}' />
      </column>
      <column caption='Vendors' datatype='integer' name='[Calculation_273171499489910784]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([vendor_code])' />
      </column>
      <column caption='Active' datatype='boolean' name='[Calculation_2983775507805573120]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{fixed  [distinct_zones] : MAX([is_active])}' />
      </column>
      <column caption='Filter Reorder 7 days' datatype='boolean' name='[Calculation_3923339003604586496]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if &#10;YEAR(today()) &gt;= INT(left([start_week], 4))&#10;AND &#10;WEEK(today()) - 2 &gt; INT(right([start_week],2))&#10;then true else false &#10;end' />
      </column>
      <column caption='Total Orders Indicator' datatype='string' name='[Calculation_415034858833891328]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([total_orders]) &gt; LOOKUP(SUM([total_orders]), -1) THEN &apos;Improved&apos;&#10;ELSEIF SUM([total_orders]) &lt; LOOKUP(SUM([total_orders]), -1) THEN &apos;Worsened&apos;&#10;ELSE &apos;No Change&apos; END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Is multiple AVR' datatype='boolean' name='[Calculation_4390376329416699904]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Calculation_1203798117097521152] WHEN 0 THEN FALSE&#10;WHEN 1 THEN FALSE&#10;WHEN NULL THEN FALSE &#10;ELSE TRUE END' />
      </column>
      <column caption='multiple avr city' datatype='integer' name='[Calculation_4390376329418838018]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Calculation_4390376329416699904] WHEN TRUE THEN [city_id]&#10;END' />
      </column>
      <column caption='% multiple avr city' datatype='real' name='[Calculation_4390376329419145219]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(CASE [Calculation_4390376329416699904] WHEN TRUE THEN [city_name]&#10;END)/ COUNTD([city_name])' />
      </column>
      <column caption='Is Smart Shrinking' datatype='boolean' name='[Calculation_481814817181143040]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{fixed  [distinct_zones] : MAX([smart_shrinking_enabled])}' />
      </column>
      <column caption='Has Commission Package' datatype='boolean' name='[Calculation_55239465552756736]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [enable_group] IN (&quot;Gold&quot;, &quot;Silver&quot;, &quot;Platinum&quot;)&#10;THEN TRUE&#10;ELSE FALSE END' />
      </column>
      <column caption='Calculation1' datatype='boolean' name='[Calculation_5620492354979098624]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [optimization_type] WHEN &apos;AVR&apos; THEN TRUE&#10;ELSE FALSE END' />
      </column>
      <column caption='Orders from Boosted Vendors AVG DTP' datatype='integer' name='[Calculation_575123748255948800]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_from_boosted_vendors]) - SUM([boosted_orders])' />
      </column>
      <column caption='Revenue from Boosted Vendors AVG DTP' datatype='real' name='[Calculation_575123748259414017]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([all_revenue_boosted_vendors_eur])- sum([revenue_from_boosted_orders_eur])' />
      </column>
      <column caption='Commission from Boosted Vendors AVG DTP' datatype='real' name='[Calculation_575123748260675586]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([all_commission_boosted_vendors_eur]) - sum([commission_from_boosted_orders_eur])' />
      </column>
      <column caption='Total Vendors' datatype='integer' name='[Calculation_5772137027459022848]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_156992717705424896])' />
      </column>
      <column caption='Zones' datatype='integer' name='[Calculation_5772137027459313665]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([distinct_zones])' />
      </column>
      <column caption='CVR' datatype='real' name='[Calculation_5862349746735923202]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vendor_cvr_numerator])/sum([vendor_cvr_denominator])' />
      </column>
      <column caption='Avg Delivery Time' datatype='real' name='[Calculation_5862349746749706243]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([actual_dt_mins_numerator])/SUM([actual_dt_mins_denominator])' />
      </column>
      <column caption='Avg To Customer Time' datatype='real' name='[Calculation_5862349746752987141]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([to_customer_time_mins_numerator])/SUM([to_customer_time_mins_denominator])' />
      </column>
      <column caption='User Entitlements' datatype='boolean' name='[Calculation_604819399293730816]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Avg At Vendor Time Cleaned' datatype='real' name='[Calculation_6398489208669175808]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([at_vendor_time_cleaned_mins_numerator])/sum([at_vendor_time_cleaned_mins_denominator])' />
      </column>
      <column caption='Avg Delivery Area km2' datatype='real' name='[Calculation_6626343202318528512]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([da_area_km2])/[Calculation_273171499489910784]' />
      </column>
      <column caption='Reorder Rate 7 Days' datatype='real' name='[Calculation_6626343202325921793]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([reorder_rate_7_days_numerator])/sum([reorder_rate_denominator])' />
      </column>
      <column caption='Avg Distance Km' datatype='real' name='[Calculation_6626343202327797764]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([delivery_distance_km_numerator])/SUM([delivery_distance_km_denominator])' />
      </column>
      <column caption='CPO Eur' datatype='real' name='[Calculation_6626343202329563141]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cpo_eur_numerator])/SUM([cpo_eur_denominator])' />
      </column>
      <column caption='Gpo OD Eur' datatype='real' name='[Calculation_6626343202339921926]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gpo_od_eur_numerator])/SUM([gpo_od_eur_denominator])' />
      </column>
      <column caption='Avg Vendor Late' datatype='real' name='[Calculation_6626343202340605959]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vendor_late_mins_numerator])/sum([vendor_late_mins_denominator])' />
      </column>
      <column caption='Show Comparison' datatype='boolean' name='[Calculation_6626343202356281352]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='Case [Parameters].[Parameter 5] when TRUE THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Last Two Weeks' datatype='string' name='[Calculation_74309399813648385]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATE(DATE(STR(LEFT([start_week], 4)) + &quot;-01-01&quot;) + (INT(RIGHT([start_week], 2)) - 1) * 7)&#10;   &gt;= DATEADD(&apos;week&apos;, -2, TODAY())  // Adjusted to check for 2 weeks prior&#10;   AND DATE(DATE(STR(LEFT([start_week], 4)) + &quot;-01-01&quot;) + (INT(RIGHT([start_week], 2)) - 1) * 7)&#10;   &lt;= TODAY()&#10;THEN &apos;Last Two Weeks&apos;&#10;ELSE &apos;Other&apos;&#10;END' />
      </column>
      <column caption='Start Week Date' datatype='date' name='[Calculation_74309399828439042]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATE(STR(LEFT([start_week], 4)) + &quot;-01-01&quot;) + (INT(RIGHT([start_week], 2)) - 1) * 7)' />
      </column>
      <column caption='Week Selection Logic' datatype='string' name='[Calculation_74309399830016004]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_74309399828439042] &gt;= DATEADD(&apos;week&apos;, -2, TODAY())&#10;   AND [Calculation_74309399828439042] &lt;= TODAY() THEN &apos;Last Two Weeks&apos;&#10;ELSEIF NOT ISNULL([start_week]) THEN &apos;Selected Weeks&apos;&#10;ELSE &apos;Other&apos;&#10;END' />
      </column>
      <column caption='Default Last Two Weeks' datatype='string' name='[Calculation_74309399830937605]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_74309399828439042] &gt;= DATEADD(&apos;week&apos;, -2, TODAY())&#10;AND [Calculation_74309399828439042] &lt;= TODAY() THEN &apos;Last Two Weeks&apos;&#10;ELSE &apos;Other&apos;&#10;END' />
      </column>
      <column caption='Final Display Logic' datatype='string' name='[Calculation_74309399842091014]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_74309399830937605] = &apos;Last Two Weeks&apos; THEN&#10;    IF [Calculation_74309399828439042] &gt;= DATEADD(&apos;week&apos;, -2, TODAY())&#10;       AND [Calculation_74309399828439042] &lt;= TODAY() THEN&#10;        &apos;Show Last Two Weeks&apos;&#10;    ELSE&#10;        &apos;Hide&apos;&#10;    END&#10;ELSEIF [Calculation_74309399830937605] = &apos;Other&apos; THEN&#10;    IF NOT ISNULL([start_week]) THEN&#10;        &apos;Show Selected Weeks&apos;&#10;    ELSE&#10;        &apos;Hide&apos;&#10;    END&#10;ELSE&#10;    &apos;Hide&apos;&#10;END' />
      </column>
      <column caption='Dimension A' datatype='string' name='[Calculation_986006844653535233]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Country Name Parameter]&#10;WHEN &apos;Region&apos; THEN [region]&#10;WHEN &apos;Country Name&apos; THEN [country_name]&#10;WHEN &apos;City Name&apos; THEN [city_name]&#10;WHEN &apos;Enable Group&apos; THEN [enable_group]&#10;WHEN &apos;Vehicle Profile&apos; THEN [vehicle_profile]&#10;WHEN &apos;Event&apos; THEN [event]&#10;WHEN &apos;None&apos; THEN NULL&#10;&#10;END' />
      </column>
      <column caption='Metric (1)' datatype='real' name='[Calculation_986006844655828997]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10; WHEN &apos;Total Orders&apos; THEN sum([total_orders])&#10;WHEN &apos;Avg Delivery Time&apos; THEN [Calculation_5862349746749706243]&#10;WHEN &apos;Avg At Vendor Time Cleaned&apos; THEN [Calculation_6398489208669175808]&#10;WHEN &apos;Avg To Customer Time&apos; THEN [Calculation_5862349746752987141]&#10;WHEN &apos;Avg Delivery Area km2&apos; THEN [Calculation_6626343202318528512]&#10;WHEN &apos;CVR&apos; THEN 100*[Calculation_5862349746735923202]&#10;WHEN &apos;Reorder Rate 7d&apos; THEN 100*[Calculation_6626343202325921793]&#10;WHEN &apos;Reorder Rate 14d&apos; THEN 100*[Reorder Rate 7 Days (copy)_6626343202326102018]&#10;WHEN &apos;Reorder Rate 30d&apos; THEN 100*[Reorder Rate 7 Days (copy) (copy)_6626343202326114307]&#10;WHEN &apos;Avg Distance km&apos; THEN [Calculation_6626343202327797764]&#10;WHEN &apos;CPO OD Eur&apos; THEN [Calculation_6626343202329563141]&#10;WHEN &apos;GPO OD Eur&apos; THEN [Calculation_6626343202339921926]&#10;WHEN &apos;Avg Vendor Late&apos; THEN [Calculation_6626343202340605959]&#10;END' />
      </column>
      <column caption='Metric Average' datatype='real' name='[Calculation_986006844946489353]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#10;WHEN &apos;Row&apos; THEN [Calculation_986006844950888462]&#10;WHEN &apos;Column&apos; THEN [Calculation_986006844947623946]&#10;WHEN &apos;Dimension(A) - Column&apos; THEN [Metric Avg Down (copy)_986006844947714059]&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Metric Avg Down' datatype='real' name='[Calculation_986006844947623946]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG([Calculation_986006844655828997])'>
