        <calculation class='tableau' formula='IF ([Calculation_6398489208669175808]) &gt; LOOKUP([Calculation_6398489208669175808], -1) THEN &apos;Improved&apos;&#10;ELSEIF [Calculation_6398489208669175808] &lt; LOOKUP([Calculation_6398489208669175808], -1) THEN &apos;Worsened&apos;&#10;ELSE &apos;No Change&apos; END'>
