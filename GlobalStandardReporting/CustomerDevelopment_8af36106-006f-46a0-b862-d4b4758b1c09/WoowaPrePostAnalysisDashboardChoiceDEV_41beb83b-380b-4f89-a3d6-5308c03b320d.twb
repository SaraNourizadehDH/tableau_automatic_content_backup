      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0mxelq91qqo7la1c27d61158hnyy].[avg:delivery_fee:qk]&quot;' value='Avg DF incl. VFD (in won)' />
          <alias key='&quot;[federated.0mxelq91qqo7la1c27d61158hnyy].[avg:experiments_launched:qk]&quot;' value='Experiments Launched' />
          <alias key='&quot;[federated.0mxelq91qqo7la1c27d61158hnyy].[max:experiments_launched:qk]&quot;' value='Experiments launched' />
          <alias key='&quot;[federated.0mxelq91qqo7la1c27d61158hnyy].[pcto:sum:total_orders:qk:2]&quot;' value='% of Orders (Bucket Share)' />
          <alias key='&quot;[federated.0mxelq91qqo7la1c27d61158hnyy].[sum:experiments_launched:qk]&quot;' value='# Experiments Launched' />
          <alias key='&quot;[federated.0mxelq91qqo7la1c27d61158hnyy].[sum:gfv_eur_n:qk]&quot;' value='GFV' />
          <alias key='&quot;[federated.0mxelq91qqo7la1c27d61158hnyy].[usr:Calculation_211387758733709313:qk]&quot;' value='Avg Delivery Time (min)' />
          <alias key='&quot;[federated.0mxelq91qqo7la1c27d61158hnyy].[usr:Calculation_211387758734794755:qk]&quot;' value='Avg Dropoff Distance (m)' />
        </aliases>
      </column>
      <column caption='Fail Rate' datatype='real' name='[Calculation_211387758733504512]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cancelled_orders])/SUM([total_orders])' />
      </column>
      <column caption='Avg Delivery Time' datatype='real' name='[Calculation_211387758733709313]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dt_numerator])/SUM([dt_denominator])' />
      </column>
      <column caption='% Orders with DT &gt; 60' datatype='real' name='[Calculation_211387758734049282]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_with_dt_over_60_mins])/SUM([total_orders])' />
      </column>
      <column caption='Avg Dropoff Distance' datatype='real' name='[Calculation_211387758734794755]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dropoff_distance_numerator])/SUM([dropoff_distance_denominator])' />
      </column>
      <column caption='CVR' datatype='real' name='[Calculation_211387758735720452]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_sessions_with_transaction])/SUM([total_sessions])' />
      </column>
      <column caption='Orders &gt; 0' datatype='boolean' name='[Calculation_2199726994598678528]' role='measure' type='nominal'>
        <calculation class='tableau' formula='SUM([total_orders]) &gt; 0' />
      </column>
      <column aggregation='CountD' caption='Delivery Fee Metrics' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_2779917287843835904]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Delivery Fee&quot;' />
      </column>
      <column caption='Pre Dates' datatype='date' name='[Calculation_6708745006384775174]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [period] = &quot;Pre&quot; THEN [report_date] ELSE NULL END' />
      </column>
      <column caption='Post Dates' datatype='date' name='[Calculation_6708745006386368519]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [period] = &quot;Post&quot; THEN [report_date] ELSE NULL END' />
      </column>
      <column caption='Report Quarter' datatype='string' name='[Calculation_6708745006388961288]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT(STR(DATETRUNC(&apos;quarter&apos;, [report_date])), 7) // to format as 2025-01, 2025-02 etc.' />
      </column>
      <column caption='Time Period' datatype='string' name='[Calculation_6708745006389542921]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Day&apos; THEN STR([report_date])&#10;    WHEN &apos;Week&apos; THEN [report_week]&#10;    WHEN &apos;Month&apos; THEN [report_month]&#10;    WHEN &apos;Quarter&apos; THEN [Calculation_6708745006388961288]&#10;END' />
      </column>
      <column caption='Dimension [Pre Post]' datatype='string' name='[Calculation_6708745006390398986]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_6708745006389542921]' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='_woowa_pre_post_choice' datatype='table' name='[__tableau_internal_object_id__].[_woowa_pre_post_choice_588991136E8F471F8EFBFBC492E04303]' role='measure' type='quantitative' />
      <column caption='_Level' datatype='string' name='[_level]' role='dimension' type='nominal' />
