      <aliases enabled='yes' />
      <column caption='Daily Unique Experiment Count' datatype='integer' name='[Calculation_4735253577664524288]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(COUNTD([experiment_name]) - LOOKUP(COUNTD([experiment_name]), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='nec' datatype='integer' name='[Calculation_4735253577666121729]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_4735253577667624962] THEN 1 ELSE 0 END' />
      </column>
      <column caption='First Appearance' datatype='boolean' name='[Calculation_4735253577667624962]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [experiment_name] : MIN([report_date]) } = [report_date]' />
      </column>
      <column caption='dec' datatype='integer' name='[Calculation_4735253577669234691]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_SUM(SUM([Calculation_4735253577666121729]), 0, 0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Calculation3' datatype='string' name='[Calculation_4735253577669427204]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_4735253577667624962] THEN [experiment_name] END' />
      </column>
      <column caption='en' datatype='string' name='[Calculation_4735253577672458245]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [experiment_name], [report_date]: MIN(IF [Calculation_4735253577667624962] THEN [experiment_name] END) }' />
      </column>
      <column caption='New Experiments' datatype='string' name='[Calculation_4735253577674350598]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [report_date], [experiment_name]: MAX(IF [Calculation_4735253577667624962] THEN [experiment_name] END) }' />
      </column>
      <column caption='New Exp Count' datatype='integer' name='[Calculation_4735253577678770183]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF { FIXED [experiment_name] : MIN([report_date]) } = [report_date] THEN 1 ELSE 0 END' />
      </column>
      <column caption='Daily Exp Cnt' datatype='integer' name='[Calculation_4735253577678884872]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF FIRST() = 0 THEN 0  // Check if it&apos;s the first row in the partition (first date)&#10;ELSE SUM([Calculation_4735253577678770183])&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column aggregation='Sum' caption='Week' datatype='integer' name='[Calculation_4735253577679519753]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEPART(&apos;week&apos;, [report_date])' />
      </column>
      <column caption='Prev Day Status' datatype='string' name='[Calculation_4735253577681178634]' role='measure' type='nominal'>
        <calculation class='tableau' formula='LOOKUP(MIN([Calculation_4735253577710284813]), -1) // -1 means look back one row'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Status Change' datatype='string' name='[Calculation_4735253577681289227]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Calculation_4735253577711333390]) THEN &quot;First Day&quot;&#10;ELSEIF [Calculation_4735253577710284813] != [Calculation_4735253577711333390] THEN &quot;Changed&quot;&#10;ELSE &quot;No Change&quot;&#10;END' />
      </column>
      <column caption='Latest Status Per Day' datatype='string' name='[Calculation_4735253577682583564]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [experiment_name], [report_date]: MAX([status]) }' />
      </column>
      <column caption='Aggregated Status' datatype='string' name='[Calculation_4735253577710284813]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{FIXED [experiment_name], [report_date]: MAX([status])} // Or MIN, or whatever aggregation is appropriate' />
      </column>
      <column caption='Prev Day Aggregated Status' datatype='string' name='[Calculation_4735253577711333390]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{FIXED [experiment_name], DATEADD(&apos;day&apos;, -1, [report_date]): MAX([Calculation_4735253577710284813])}' />
      </column>
      <column caption='Prev Day Status 2' datatype='string' name='[Calculation_4735253577714438159]' role='measure' type='nominal'>
        <calculation class='tableau' formula='LOOKUP(ATTR([Calculation_4735253577721810961]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Status Change to completed' datatype='integer' name='[Calculation_4735253577714556944]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_4735253577710284813] = &quot;Completed&quot; AND [Calculation_4735253577711333390] != &quot;Completed&quot; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Exp Status' datatype='string' name='[Calculation_4735253577721810961]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [experiment_name], [report_date]: MIN([status]) }' />
      </column>
      <column caption='Experiment Count' datatype='integer' name='[Calculation_5951506951819509760]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([experiment_name])' />
      </column>
      <column caption='New Additions' datatype='integer' name='[Calculation_5951506951859126274]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL(ZN(LOOKUP(COUNTD([experiment_name]), -1))) THEN COUNTD([experiment_name]) - 0&#10;ELSE COUNTD([experiment_name]) - LOOKUP(COUNTD([experiment_name]), -1)&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='New Experiments Per Day' datatype='integer' name='[Calculation_5951506951864635396]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([experiment_name]) - LOOKUP(COUNTD([experiment_name]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Is New Experiment' datatype='string' name='[Calculation_5951506951866105861]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF INDEX() &gt; 1 AND &#10;ISNULL(LOOKUP(MIN([experiment_name]), -1)) THEN &quot;New&quot;&#10;ELSE &quot;Existing&quot;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='New Exp Flag' datatype='integer' name='[Calculation_5951506951877554183]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IF ISNULL(LOOKUP(MIN([experiment_name]), -1)) THEN 1&#10;ELSEIF MIN([experiment_name]) != LOOKUP(MIN([experiment_name]), -1) THEN 1&#10;ELSE 0&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Prev day exp' datatype='string' name='[Calculation_5951506951881084937]' role='measure' type='nominal'>
        <calculation class='tableau' formula='LOOKUP(ATTR([experiment_name]),-1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Status Change Flag' datatype='string' name='[Status Change to completed (copy)_4735253577722249234]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [status] &lt;&gt; [Calculation_4735253577721810961] THEN &quot;Changed&quot; ELSE &quot;No Change&quot; END' />
      </column>
