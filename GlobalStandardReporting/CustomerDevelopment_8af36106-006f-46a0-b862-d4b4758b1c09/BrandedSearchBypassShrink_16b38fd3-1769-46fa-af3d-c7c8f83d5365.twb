    <worksheet name='KPIs  Entity Level'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Experiment Level KPIs</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='branded_search_bypass_shrinking_ab_tests (rl)' name='federated.1titesb0db4a0z1h3vfd61it1mb5' />
          </datasources>
          <datasource-dependencies datasource='federated.1titesb0db4a0z1h3vfd61it1mb5'>
            <column caption='% Search Sessions / User' datatype='real' name='[Calculation_2812427645101838337]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sessions_exact_match])/(IF SUM([users]) =0 then  sum([clients]) else sum([users]) end)' />
            </column>
            <column caption='CVR' datatype='real' name='[Calculation_2812427645113991171]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sessions_with_transaction])/SUM([sessions])' />
            </column>
            <column caption='Avg DT (min)' datatype='real' name='[Calculation_3366088885766213635]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([actual_dt_numerator])/SUM([actual_dt_denominator])' />
            </column>
            <column caption='GMV Per Customer Food w Event (Eur)' datatype='real' name='[Calculation_3366088885766733829]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_food_shrink_sessions])/SUM([food_customers_with_shrink])' />
            </column>
            <column caption='Search CVR' datatype='real' name='[Calculation_3493597087006093314]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([conversions_exact_match])/SUM([sessions_exact_match])' />
            </column>
            <column caption='Contact Rate' datatype='real' name='[Calculation_3493597087006986243]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders_w_contact])/sum([orders])' />
            </column>
            <column caption='Fail Rate' datatype='real' name='[Calculation_5436055864128229377]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([orders])- sum([completed_orders]))/sUM([orders])' />
            </column>
            <column caption='% DT &gt; 60' datatype='real' name='[Calculation_5436055864128319490]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_60_min])/SUM([orders])' />
            </column>
            <column caption='% Order Late &gt; 10 min' datatype='real' name='[Calculation_5436055864128483332]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_late_10_min])/SUM([orders])' />
            </column>
            <column caption='Orders Per Customer Food' datatype='real' name='[GMV Per Customer Food (copy)_3493597087005691905]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([food_orders])/SUM([food_customers])' />
            </column>
            <column caption='GMV Per User Food ' datatype='real' name='[GMV Per Customer Food (copy)_44754568224935940]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_eur_food])/SUM([users])' />
            </column>
            <column caption='GMV Per Customer Food (Eur)' datatype='real' name='[GMV Per Customer Food w Event (copy)_3493597087005208576]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_eur_food])/SUM([food_customers])' />
            </column>
            <column caption='% Search Orders/ User' datatype='real' name='[Search CVR (copy)_2812427645102178306]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([conversions_exact_match])/(IF SUM([users]) =0 then  sum([clients]) else sum([users]) end)' />
            </column>
            <column caption='Actual Dt Denominator' datatype='integer' name='[actual_dt_denominator]' role='measure' type='quantitative' />
            <column caption='Actual Dt Numerator' datatype='real' name='[actual_dt_numerator]' role='measure' type='quantitative' />
            <column datatype='integer' name='[clients]' role='measure' type='quantitative' />
            <column caption='Completed Orders' datatype='integer' name='[completed_orders]' role='measure' type='quantitative' />
