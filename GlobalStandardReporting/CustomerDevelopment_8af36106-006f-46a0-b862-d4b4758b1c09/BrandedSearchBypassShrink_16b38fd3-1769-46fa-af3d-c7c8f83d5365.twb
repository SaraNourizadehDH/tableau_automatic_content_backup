          <format attr='background-color' value='#f5f5f581' />
        </style-rule>
        <style-rule element='dash-text'>
          <format attr='vertical-align' id='dash-text_38' value='top' />
          <format attr='vertical-align' id='dash-text_37' value='top' />
        </style-rule>
      </style>
      <size maxheight='1600' maxwidth='1000' minheight='1600' minwidth='1000' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='6' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='92500' id='9' param='horz' type-v2='layout-flow' w='98400' x='800' y='7000'>
            <zone h='92500' id='5' param='vert' type-v2='layout-flow' w='98400' x='800' y='7000'>
              <zone fixed-size='36' h='2750' id='292' is-fixed='true' type-v2='empty' w='98400' x='800' y='7000'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#ffffff' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='35063' id='311' type-v2='text' w='98400' x='800' y='9750'>
                <formatted-text>
                  <run bold='true' fontcolor='#333333' fontsize='11'>GMV Per Customer Food :</run>
                  <run fontcolor='#333333' fontsize='11'> Total GMV from Food orders/ Total Customers with a Food Order</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#333333' fontsize='11'>GMV Per Customer Food w Event:</run>
                  <run fontcolor='#333333' fontsize='11'> Total GMV from Food orders/ Total Customers with a Food Order during a session with event. </run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#333333' fontsize='11'>Orders Per Customer Food:  </run>
                  <run fontcolor='#333333' fontsize='11'>Total Food orders/ Total Customers with a Food Order</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#333333' fontsize='11'>Orders Per Customer Food w Event:</run>
                  <run fontcolor='#333333' fontsize='11'> Total Food orders/ Total Customers with a Food Order during a session with event. </run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#333333' fontsize='11'>CVR : </run>
                  <run fontcolor='#333333' fontsize='11'>Total Sessions with Transaction / Total Sessions. </run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#333333' fontsize='11'>Search CVR:</run>
                  <run fontcolor='#333333' fontsize='11'> Total Sessions with Transaction from exact match search/ Total sessions with exact match search. </run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#333333' fontsize='11'>Fail Rate:</run>
                  <run fontcolor='#333333' fontsize='11'> Total Non Successful Orders/ Total Orders</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#333333' fontsize='11'>Avg DT: </run>
                  <run fontcolor='#333333' fontsize='11'>Total Delivery Time/ Completed OD Orders</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#333333' fontsize='11'>% DT &gt; 60%:</run>
                  <run fontcolor='#333333' fontsize='11'>  Total orders where actual delivery time &gt; 60 / Total Orders</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#333333' fontsize='11'>% Orders Late &gt; 10 min:</run>
                  <run fontcolor='#333333' fontsize='11'> Total orders where delay &gt; 10 minutes / Total Orders</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#333333' fontsize='11'>Contact Rate:</run>
                  <run fontcolor='#333333' fontsize='11'> Total Orders with Contact / Total Orders</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#333333' fontsize='11'>Sessions:</run>
                  <run fontcolor='#333333' fontsize='11'> Total number of Perseus Sessions. </run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#333333' fontsize='11'>Food Orders:</run>
                  <run fontcolor='#333333' fontsize='11'> Total number of orders with Vertical Parent = &quot;Food&quot;</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#333333' fontsize='11'>% Search Sessions / User :</run>
                  <run fontcolor='#333333' fontsize='11'> Total number of search sessions / Total Users</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#333333' fontsize='11'>% Search Orders/ User: </run>
                  <run fontcolor='#333333' fontsize='11'>Total number of orders from search/ Total Users</run>
                </formatted-text>
                <zone-style>
