      <column caption='Significance Bottom Line' datatype='string' name='[Calculation_3751287402078126081]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF&#10;  (&#10;     (&#10;        [Calculation_1126533277014171648] &lt;= [Parameters].[Parameter 4 1]&#10;        AND&#10;        [anova_p_value] &lt;= [Parameters].[Parameter 4 1]&#10;     )&#10;      OR &#10;     (&#10;        [Calculation_1126533277014171648] &lt;= [Parameters].[Parameter 4 1]&#10;        AND&#10;        ISNULL([anova_p_value])&#10;     )&#10;  )&#10;THEN &quot;Statistically Significant&quot;&#10;ELSE &quot;Statistically Insignificant&quot;&#10;END' />
      </column>
