              <calculation class='tableau' formula='SUM([orders_late_over_10_mins])/SUM([Calculation_4789296741597290511])' />
            </column>
            <column caption='- Other Fail Rate' datatype='real' name='[Calculation_2101984788860813312]' role='measure' type='quantitative'>
