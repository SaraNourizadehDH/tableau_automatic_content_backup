          <datasource-dependencies datasource='federated.0egu66n0n0x3nb13ddi3w0naufdx'>
            <column caption='% Order Early 10 Mins' datatype='real' name='[% Order Late 10 Mins (copy)_5814358242335653900]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_early_over_10_mins])/SUM([Calculation_4789296741597290511])' />
            </column>
            <column caption='% Order Late 10 Mins' datatype='real' name='[% Order Late 5 Mins (copy)_5814358242335576075]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_late_over_10_mins])/SUM([Calculation_4789296741597290511])' />
            </column>
            <column caption='Avg At Vendor Time Cleaned Mins' datatype='real' name='[Avg At Vendor Time Mins (copy)_5814358242334429192]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([at_vendor_time_cleaned_mins])/SUM([Calculation_4789296741597290511])' />
            </column>
            <column caption='Avg Dropoff Distance Mh km' datatype='real' name='[Avg Pickup Distance Mh km (copy)_5814358242339807248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dropoff_distance_manhattan_km])/SUM([dropoff_distance_manhattan_km_numerator])' />
            </column>
            <column caption='Avg Compensation Eur' datatype='real' name='[Calculation_2147935591208939521]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([compensation_refund_eur])/SUM([compensated_refunded_orders])' />
            </column>
            <column caption='Report Date' datatype='string' name='[Calculation_4789296741238648838]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([created_date (availability_test_sessions)])' />
            </column>
            <column caption='Total Orders' datatype='integer' name='[Calculation_4789296741583007751]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders])' />
            </column>
            <column caption='Fail Rate' datatype='real' name='[Calculation_4789296741583093768]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([failed_orders])/[Calculation_4789296741583007751]' />
            </column>
            <column caption='% Seamless Orders' datatype='real' name='[Calculation_4789296741584085001]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([seamless_orders])/ [Calculation_4789296741583007751]' />
            </column>
            <column caption='Orders with contact' datatype='real' name='[Calculation_4789296741587853323]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([contacted_orders])/[Calculation_4789296741583007751]' />
            </column>
            <column caption='% Orders with Stacked Deliveries' datatype='real' name='[Calculation_4789296741593100300]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders_with_stacked_deliveries])/[Calculation_4789296741583007751]' />
            </column>
            <column caption='Completed OD Orders' datatype='integer' name='[Calculation_4789296741597290511]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_own_delivery] = TRUE THEN [completed_orders] END' />
            </column>
            <column caption='% Rider Late 10 Mins' datatype='real' name='[Calculation_4789296741597417488]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_with_rider_late_10])/SUM([Calculation_4789296741597290511])' />
            </column>
            <column caption='% Vendor Late 10 Mins' datatype='real' name='[Calculation_4789296741598007314]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders_with_vendor_late_10])/sum([Calculation_4789296741597290511])' />
            </column>
            <column caption='Avg To Vendor Time Mins' datatype='real' name='[Calculation_5814358242331492352]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([to_vendor_time_mins])/SUM([Calculation_4789296741597290511])' />
            </column>
            <column caption='Avg To Customer Time Mins' datatype='real' name='[Calculation_5814358242331930625]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([to_customer_time_mins])/sum([Calculation_4789296741597290511])' />
            </column>
            <column caption='Avg Promised Delivery Time Mins' datatype='real' name='[Calculation_5814358242332045314]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum([promised_delivery_time_mins])/sum([orders])' />
            </column>
            <column caption='Avg Actual Delivery Time' datatype='real' name='[Calculation_5814358242332553219]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([actual_delivery_time_mins])/SUM([Calculation_4789296741597290511])' />
            </column>
            <column caption='% Orders with DT over 45 Mins' datatype='real' name='[Calculation_5814358242333663236]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_with_dt_over_45_mins])/SUM([Calculation_4789296741597290511])' />
            </column>
            <column caption='% Orders with DT under 20 Mins' datatype='real' name='[Calculation_5814358242333880325]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders_with_dt_under_20_mins])/sum([Calculation_4789296741597290511])' />
            </column>
            <column caption='% Orders with DT over 60 Mins' datatype='real' name='[Calculation_5814358242334023686]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders_with_dt_over_60_mins])/sum([Calculation_4789296741597290511])' />
            </column>
            <column caption='Avg At Vendor Time Mins' datatype='real' name='[Calculation_5814358242334298119]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([at_vendor_time_mins])/SUM([Calculation_4789296741597290511])' />
            </column>
            <column caption='Avg Order Delay Mins' datatype='real' name='[Calculation_5814358242334662665]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([order_delay_mins])/sum([Calculation_4789296741597290511])' />
            </column>
            <column caption='% Order Late 5 Mins' datatype='real' name='[Calculation_5814358242335436810]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_late_over_5_mins])/SUM([Calculation_4789296741597290511])' />
            </column>
            <column caption='% On Time Orders' datatype='real' name='[Calculation_5814358242336583693]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders_on_time])/sum([Calculation_4789296741597290511])' />
            </column>
            <column caption='Avg Pickup Distance Mh km' datatype='real' name='[Calculation_5814358242339639311]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pickup_distance_manhattan_km])/SUM([pickup_distance_manhattan_km_numerator])' />
            </column>
            <column caption='Avg Delivery Distance Km' datatype='real' name='[Calculation_5814358242339995665]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum([delivery_distance_km])/sum([Calculation_4789296741597290511])' />
            </column>
            <column caption='CPO OD Eur' datatype='real' name='[Calculation_5814358242340245522]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_cost_eur])/SUM([Calculation_4789296741597290511])' />
            </column>
            <column caption='Avg GMV Eur' datatype='real' name='[Calculation_5814358242340450323]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_eur])/SUM([completed_orders])' />
            </column>
            <column caption='FLGPO Eur' datatype='real' name='[Calculation_5814358242340769812]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fully_loaded_gross_profit_eur])/SUM([Calculation_4789296741597290511])' />
            </column>
            <column caption='Avg CM1 Eur' datatype='real' name='[Calculation_5814358242341068821]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cm1_eur (availability_test_orders)])/SUM([completed_orders])' />
