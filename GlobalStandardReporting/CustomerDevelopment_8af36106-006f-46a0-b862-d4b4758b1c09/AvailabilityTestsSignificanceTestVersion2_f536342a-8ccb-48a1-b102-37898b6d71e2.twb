                              </zone>
                              <zone fixed-size='58' h='3666' id='2177' is-fixed='true' mode='dropdown' name='Intervals' param='[federated.0egu66n0n0x3nb13ddi3w0naufdx].[none:kpi_label:nk]' type-v2='filter' values='database' w='99000' x='500' y='20709'>
                                <zone-style>
