    <worksheet name='Orders Data'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Overall KPIs</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='availability_test_orders+ (rl)' name='federated.0egu66n0n0x3nb13ddi3w0naufdx' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.0egu66n0n0x3nb13ddi3w0naufdx].[experiment_name]' caption='Choose Experiment' datatype='string' name='[Choose Entity (copy)_6029897706276470785]' param-domain-type='list' role='measure' type='nominal' value='&quot;2024-07-03_TH_Choice-Index-Opt-expansion_Prachuap khiri khan&quot;'>
              <calculation class='tableau' formula='&quot;2024-07-03_TH_Choice-Index-Opt-expansion_Prachuap khiri khan&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0egu66n0n0x3nb13ddi3w0naufdx'>
            <column caption='% Order Late 10 Mins' datatype='real' name='[% Order Late 5 Mins (copy)_5814358242335576075]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_late_over_10_mins])/SUM([Calculation_4789296741597290511])' />
            </column>
            <column caption='- Other Fail Rate' datatype='real' name='[Calculation_2101984788860813312]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4789296741583093768] - [Calculation_2606387938641784833]- [Calculation_2606387938641870850]' />
            </column>
            <column caption='Total GMV' datatype='real' name='[Calculation_2514064156604510212]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([gmv_eur])' />
            </column>
            <column caption='  - Customer Fail Rate' datatype='real' name='[Calculation_2606387938641784833]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([customer_failed_orders])/[Calculation_4789296741583007751]' />
            </column>
            <column caption='  - Vendor Fail Rate' datatype='real' name='[Calculation_2606387938641870850]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_failed_orders])/[Calculation_4789296741583007751]' />
            </column>
            <column caption='Expansion/Reduction Diff Orders' datatype='integer' name='[Calculation_2606387938650312709]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if CONTAINS([Parameters].[Choose Entity (copy)_6029897706276470785],&apos;Expansion&apos;) THEN &#10;[experiment_diff_orders]&#10;elseif CONTAINS([Parameters].[Choose Entity (copy)_6029897706276470785],&apos;Reduction&apos;) THEN &#10;[experiment_diff_orders]&#10;ELSE 0&#10;END' />
            </column>
            <column caption='% Crossborder Orders' datatype='real' name='[Calculation_2606387938665807878]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([crossborder_orders])/[Calculation_4789296741583007751]' />
            </column>
            <column caption='Report Date' datatype='string' name='[Calculation_4789296741238648838]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([created_date (availability_test_sessions)])' />
            </column>
            <column caption='Total Orders' datatype='integer' name='[Calculation_4789296741583007751]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders])' />
            </column>
            <column caption='Fail Rate' datatype='real' name='[Calculation_4789296741583093768]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([failed_orders])/[Calculation_4789296741583007751]' />
            </column>
            <column caption='% Seamless Orders' datatype='real' name='[Calculation_4789296741584085001]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([seamless_orders])/ [Calculation_4789296741583007751]' />
            </column>
            <column caption='Orders with contact' datatype='real' name='[Calculation_4789296741587853323]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([contacted_orders])/[Calculation_4789296741583007751]' />
            </column>
            <column caption='Completed OD Orders' datatype='integer' name='[Calculation_4789296741597290511]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_own_delivery] = TRUE THEN [completed_orders] END' />
            </column>
            <column caption='Avg To Customer Time Mins' datatype='real' name='[Calculation_5814358242331930625]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([to_customer_time_mins])/sum([Calculation_4789296741597290511])' />
            </column>
            <column caption='Avg Actual Delivery Time' datatype='real' name='[Calculation_5814358242332553219]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([actual_delivery_time_mins])/SUM([Calculation_4789296741597290511])' />
            </column>
            <column caption='% Orders with DT over 45 Mins' datatype='real' name='[Calculation_5814358242333663236]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_with_dt_over_45_mins])/SUM([Calculation_4789296741597290511])' />
            </column>
            <column caption='Avg Delivery Distance Km' datatype='real' name='[Calculation_5814358242339995665]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum([delivery_distance_km])/sum([Calculation_4789296741597290511])' />
            </column>
            <column caption='FLGPO Eur' datatype='real' name='[Calculation_5814358242340769812]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fully_loaded_gross_profit_eur])/SUM([Calculation_4789296741597290511])' />
            </column>
            <column caption='Experiment Filter' datatype='boolean' name='[Calculation_6029897706276536322]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Choose Entity (copy)_6029897706276470785]= [experiment_name]' />
            </column>
            <column caption='Actual Delivery Time Mins' datatype='real' name='[actual_delivery_time_mins]' role='measure' type='quantitative' />
            <column caption='Choice Bucket' datatype='string' name='[choice_bucket]' role='dimension' type='nominal' />
            <column caption='Completed Orders' datatype='integer' name='[completed_orders]' role='measure' type='quantitative' />
            <column caption='Contacted Orders' datatype='integer' name='[contacted_orders]' role='measure' type='quantitative' />
            <column caption='Created Date (Availability Test Sessions)' datatype='date' name='[created_date (availability_test_sessions)]' role='dimension' type='ordinal' />
