              <calculation class='tableau' formula='SUM([at_vendor_time_mins])/SUM([Calculation_4789296741597290511])' />
            </column>
            <column caption='Avg Order Delay Mins' datatype='real' name='[Calculation_5814358242334662665]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([order_delay_mins])/sum([Calculation_4789296741597290511])' />
            </column>
            <column caption='% Order Late 5 Mins' datatype='real' name='[Calculation_5814358242335436810]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_late_over_5_mins])/SUM([Calculation_4789296741597290511])' />
            </column>
            <column caption='% On Time Orders' datatype='real' name='[Calculation_5814358242336583693]' role='measure' type='quantitative'>
