                  </zone-style>
                </zone>
                <zone h='3555' id='2226' mode='compact' param='[Parameters].[Choose Entity (copy)_6029897706276470785]' type-v2='paramctrl' w='22500' x='500' y='12389'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
