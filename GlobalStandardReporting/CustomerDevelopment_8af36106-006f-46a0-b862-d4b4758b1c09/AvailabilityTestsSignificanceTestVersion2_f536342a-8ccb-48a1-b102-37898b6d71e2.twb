    <worksheet name='Sessions Daily View'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Selected metric: &lt;</run>
            <run>[Parameters].[Choose Metric (copy)_6529304683412283392]</run>
            <run>&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='availability_test_orders+ (rl)' name='federated.0egu66n0n0x3nb13ddi3w0naufdx' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.0egu66n0n0x3nb13ddi3w0naufdx].[experiment_name]' caption='Choose Experiment' datatype='string' name='[Choose Entity (copy)_6029897706276470785]' param-domain-type='list' role='measure' type='nominal' value='&quot;2024-07-03_TH_Choice-Index-Opt-expansion_Prachuap khiri khan&quot;'>
              <calculation class='tableau' formula='&quot;2024-07-03_TH_Choice-Index-Opt-expansion_Prachuap khiri khan&quot;' />
            </column>
            <column alias='Avg Available Vendors' caption='Choose Session Metric' datatype='integer' datatype-customized='true' name='[Choose Metric (copy)_6529304683412283392]' param-domain-type='list' role='measure' type='quantitative' value='6'>
              <calculation class='tableau' formula='6' />
              <aliases>
                <alias key='1' value='Orders per User/Day' />
                <alias key='2' value='CVR' />
                <alias key='3' value='mCVR2' />
                <alias key='4' value='Sessions' />
                <alias key='5' value='Sessions with Transaction' />
                <alias key='6' value='Avg Available Vendors' />
                <alias key='7' value='Avg Vendors in Area' />
                <alias key='8' value='Avg Time To Order Minutes' />
                <alias key='9' value='% Sessions with DAS event' />
                <alias key='10' value='Avg DAS event value' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0egu66n0n0x3nb13ddi3w0naufdx'>
            <column caption='Avg Available Vendors' datatype='real' name='[Avg Vendors in Area (copy)_4789296741225738243]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum([available_vendor_count_denominator])/sum([available_vendor_count_numerator])' />
            </column>
            <column caption='Avg DAS Event Value' datatype='real' name='[Calculation_2514064156602343426]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([das_event_value_denominator])/sum([das_event_value_numerator])' />
            </column>
            <column caption='ROUND([Session Metric], 2)' datatype='real' name='[Calculation_2514064156603125763]' role='measure' type='quantitative' user:unnamed='Sessions Daily View'>
              <calculation class='tableau' formula='ROUND([Calculation_6529304683413225473], 2)' />
            </column>
            <column caption='ROUND([Session Metric], 2)' datatype='real' name='[Calculation_341006966272008192]' role='measure' type='quantitative' user:unnamed='Sessions Daily View'>
              <calculation class='tableau' formula='ROUND([Calculation_6529304683413225473], 2)' />
            </column>
            <column caption='Sessions with Transaction' datatype='integer' name='[Calculation_4789296741224603648]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF[has_transaction] = TRUE THEN [sessions] END' />
            </column>
            <column caption='CVR' datatype='real' name='[Calculation_4789296741224890369]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_4789296741224603648]) / SUM([sessions])' />
            </column>
            <column caption='Avg Vendors in Area' datatype='real' name='[Calculation_4789296741225590786]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum([vendor_count_denominator])/sum([vendor_count_numerator])' />
            </column>
            <column caption='Orders per User/Day' datatype='real' name='[Calculation_4789296741231931396]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders])/SUM([users])' />
            </column>
            <column caption='Avg Time To Order Minutes' datatype='real' name='[Calculation_4789296741236625413]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([time_to_order_minutes])/SUM([time_to_order_denominator])' />
            </column>
            <column caption='Report Date' datatype='string' name='[Calculation_4789296741238648838]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([created_date (availability_test_sessions)])' />
            </column>
            <column caption='Experiment Filter' datatype='boolean' name='[Calculation_6029897706276536322]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Choose Entity (copy)_6029897706276470785]= [experiment_name]' />
            </column>
            <column caption='Session Metric' datatype='real' name='[Calculation_6529304683413225473]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Choose Metric (copy)_6529304683412283392]&#10;&#10;WHEN 1 THEN [Calculation_4789296741231931396]&#10;WHEN 2 THEN [Calculation_4789296741224890369]*100&#10;WHEN 3 THEN [Calculation_6529304683467202566]*100&#10;WHEN 4 THEN SUM([sessions])&#10;WHEN 5 THEN SUM([Calculation_4789296741224603648])&#10;WHEN 6 THEN [Avg Vendors in Area (copy)_4789296741225738243]&#10;WHEN 7 THEN [Calculation_4789296741225590786]&#10;WHEN 8 THEN [Calculation_4789296741236625413]&#10;WHEN 9 THEN [Calculation_76068637276966913]*100&#10;when 10 then [Calculation_2514064156602343426]&#10;&#10;END' />
            </column>
            <column caption='Mcvr2 denominator' datatype='integer' name='[Calculation_6529304683466629123]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [mcvr2] = 0 then [sessions]&#10;elseif [mcvr2] = 1 then [sessions]&#10;else 0&#10;end' />
            </column>
            <column caption='MCVR2' datatype='real' name='[Calculation_6529304683467202566]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Mcvr2 denominator (copy)_6529304683467120645])/SUM([Calculation_6529304683466629123])' />
            </column>
            <column caption='Total sessions with event' datatype='integer' name='[Calculation_76068637276786688]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [session_has_event (availability_test_sessions)] = true then [sessions] end' />
            </column>
            <column caption='% Sessions with DAS event' datatype='real' name='[Calculation_76068637276966913]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_76068637276786688])/sum([sessions])' />
            </column>
            <column caption='Mcvr2 numerator' datatype='integer' name='[Mcvr2 denominator (copy)_6529304683467120645]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if  [mcvr2] = 1 then [sessions]&#10;else 0&#10;end' />
            </column>
            <column caption='Suffix' datatype='string' name='[Session Metric (copy)_76068637277523970]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Choose Metric (copy)_6529304683412283392]&#10;&#10;WHEN 1 THEN &apos;&apos;&#10;WHEN 2 THEN &apos;%&apos;&#10;WHEN 3 THEN &apos;%&apos;&#10;WHEN 4 THEN &apos;&apos;&#10;WHEN 5 THEN &apos;&apos;&#10;WHEN 6 THEN &apos;&apos;&#10;WHEN 7 THEN &apos;&apos;&#10;WHEN 8 THEN &apos;&apos;&#10;WHEN 9 THEN &apos;%&apos;&#10;&#10;END' />
            </column>
            <column datatype='integer' name='[available_vendor_count_denominator]' role='measure' type='quantitative' />
            <column datatype='integer' name='[available_vendor_count_numerator]' role='measure' type='quantitative' />
