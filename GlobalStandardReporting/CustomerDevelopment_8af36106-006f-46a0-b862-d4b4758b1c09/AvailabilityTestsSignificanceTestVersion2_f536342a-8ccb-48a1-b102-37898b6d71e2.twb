            </column>
            <column caption='Avg Promised Delivery Time Mins' datatype='real' name='[Calculation_5814358242332045314]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum([promised_delivery_time_mins])/sum([orders])' />
