            <column caption='Detail' datatype='real' name='[Calculation_1347420781044244480]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Orders&apos; THEN SUM([daily_orders])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Vendors&apos; THEN COUNTD([vendor_code])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;ABV&apos; THEN [Avg DF (copy)_1238208485773914113]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Avg. DF&apos; THEN [Calculation_1238208485773688832]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;DF/ABV&apos; THEN [Avg DF (copy)_1238208485773996034]*100&#13;&#10;END' />
