          <datasource-dependencies datasource='federated.1cy7ysg0cvo19f190kivo0bzc3wr'>
            <column caption='ABV' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg DF (copy)_1238208485773914113]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_basket_value])/SUM([total_orders])' />
