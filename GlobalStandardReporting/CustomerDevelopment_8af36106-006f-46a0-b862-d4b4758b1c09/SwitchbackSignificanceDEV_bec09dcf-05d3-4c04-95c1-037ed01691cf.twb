          <alias key='&quot;[federated.09xwtww0kqo30p12s7p4e164fs9c].[avg:Calculation_5868331087210852355:qk]&quot;' value='Mean B/Adjusted Value B*' />
          <alias key='&quot;[federated.09xwtww0kqo30p12s7p4e164fs9c].[avg:Calculation_5868331087211020292:qk]&quot;' value='Delta (Percent)' />
          <alias key='&quot;[federated.09xwtww0kqo30p12s7p4e164fs9c].[avg:Calculation_5868331087211466759:qk]&quot;' value='Statistical Significance' />
