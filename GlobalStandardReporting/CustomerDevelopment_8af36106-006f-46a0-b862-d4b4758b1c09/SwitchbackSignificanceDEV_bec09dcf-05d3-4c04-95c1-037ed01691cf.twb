    <worksheet name='Significance Bottom Line'>
      <table>
        <view>
          <datasources>
            <datasource caption='switchback_significance_rl (bhagyesh)' name='federated.09xwtww0kqo30p12s7p4e164fs9c' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Use CUPED' datatype='boolean' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.09xwtww0kqo30p12s7p4e164fs9c].[experiment_name]' caption='Choose Experiment' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;AR|Switchback ar - Tandil PDT-12|2025-01-28&quot;'>
              <calculation class='tableau' formula='&quot;AR|Switchback ar - Tandil PDT-12|2025-01-28&quot;' />
            </column>
            <column caption='Choose Alpha' datatype='real' name='[Parameter 3]' param-domain-type='range' role='measure' type='quantitative' value='0.050000000000000003'>
              <calculation class='tableau' formula='0.050000000000000003' />
              <range granularity='0.01' max='0.1' min='0.01' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.09xwtww0kqo30p12s7p4e164fs9c'>
            <column caption='VariantA=VariantB' datatype='boolean' name='[Calculation_5868331087209140224]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[variant_a] == [variant_b]' />
            </column>
            <column caption='Mean A Exists' datatype='boolean' name='[Calculation_5868331087212449800]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF NOT ISNULL([mean_a]) THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Experiment Filter' datatype='boolean' name='[Calculation_5868331087212748809]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 2]= [experiment_name]' />
            </column>
            <column caption='Significance Bottom Line' datatype='string' name='[Calculation_5868331087219343370]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF&#10;  (&#10;     (&#10;        [Calculation_5868331087220203531] &lt;= [Parameters].[Parameter 3]&#10;        AND&#10;        [anova_p_value] &lt;= [Parameters].[Parameter 3]&#10;     )&#10;      OR &#10;     (&#10;        [Calculation_5868331087220203531] &lt;= [Parameters].[Parameter 3]&#10;        AND&#10;        ISNULL([anova_p_value])&#10;     )&#10;  )&#10;THEN &quot;Statistically Significant&quot;&#10;ELSE &quot;Statistically Insignificant&quot;&#10;END' />
            </column>
            <column caption='Final P Value' datatype='real' name='[Calculation_5868331087220203531]' role='measure' type='quantitative'>
