        </aliases>
      </column>
      <column caption='VariantA=VariantB' datatype='boolean' name='[Calculation_5868331087209140224]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[variant_a] == [variant_b]' />
      </column>
      <column caption='Mean A/Adjusted Value A*' datatype='real' name='[Calculation_5868331087210278913]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1] when TRUE THEN [cuped_mean_a]&#10;ELSE [mean_a]&#10;END' />
      </column>
      <column caption='Mean B/Adjusted Value B*' datatype='real' name='[Calculation_5868331087210852355]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1] when TRUE THEN [cuped_mean_b]&#10;ELSE [mean_b]&#10;END' />
      </column>
      <column caption='Delta (Percent)' datatype='real' name='[Calculation_5868331087211020292]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] WHEN TRUE THEN [Calculation_5868331087211200518]&#10;ELSE [Calculation_5868331087211118597]&#10;END' />
      </column>
      <column caption='Mean Delta (Percent)' datatype='real' name='[Calculation_5868331087211118597]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [variant_a] &lt;&gt; [variant_b] THEN ([mean_b]-[mean_a])/ABS([mean_a]) END' />
      </column>
      <column caption='Mean Delta Cuped (Percent) ' datatype='real' name='[Calculation_5868331087211200518]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [variant_a] &lt;&gt; [variant_b] THEN ([cuped_mean_b]-[cuped_mean_a])/ABS([cuped_mean_a]) END' />
      </column>
      <column caption='Statistical Significance' datatype='integer' name='[Calculation_5868331087211466759]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF FALSE THEN 0 ELSE NULL END' />
      </column>
      <column caption='Mean A Exists' datatype='boolean' name='[Calculation_5868331087212449800]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF NOT ISNULL([mean_a]) THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Experiment Filter' datatype='boolean' name='[Calculation_5868331087212748809]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 2]= [experiment_name]' />
      </column>
      <column caption='Significance Bottom Line' datatype='string' name='[Calculation_5868331087219343370]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF&#10;  (&#10;     (&#10;        [Calculation_5868331087220203531] &lt;= [Parameters].[Parameter 3]&#10;        AND&#10;        [anova_p_value] &lt;= [Parameters].[Parameter 3]&#10;     )&#10;      OR &#10;     (&#10;        [Calculation_5868331087220203531] &lt;= [Parameters].[Parameter 3]&#10;        AND&#10;        ISNULL([anova_p_value])&#10;     )&#10;  )&#10;THEN &quot;Statistically Significant&quot;&#10;ELSE &quot;Statistically Insignificant&quot;&#10;END' />
      </column>
      <column caption='Final P Value' datatype='real' name='[Calculation_5868331087220203531]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1] when true &#10;then IFNULL([corrected_cuped_p_value], [cuped_p_value])&#10;else IFNULL([corrected_p_value], [p_value])&#10;end' />
      </column>
