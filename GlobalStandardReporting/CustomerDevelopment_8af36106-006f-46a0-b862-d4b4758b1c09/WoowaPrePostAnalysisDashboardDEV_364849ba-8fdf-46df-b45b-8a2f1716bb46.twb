      <column caption='DF w/o Discounts (Euro)' datatype='real' name='[Calculation_2183401438143401984]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([delivery_fee_before_discount_eur_n])/SUM([delivery_fee_before_discount_eur_d])' />
      </column>
      <column caption='Profit (Euro)' datatype='real' name='[Calculation_2183401438144438273]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([profit_eur_n])/SUM([profit_eur_d])' />
      </column>
      <column caption='FLGPO (Euro)' datatype='real' name='[Calculation_2183401438144749570]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fully_loaded_gross_profit_eur_n])/SUM([fully_loaded_gross_profit_eur_d])' />
      </column>
      <column caption='Choose Dimension 1' datatype='string' name='[Calculation_2328501793901240321]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &apos;Period&apos; THEN [period]&#10;    WHEN &apos;Rollout Batch&apos; THEN [Calculation_2779917287850033154]&#10;END' />
      </column>
      <column aggregation='CountD' caption='Delivery Fee Metrics' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_2779917287843835904]' role='dimension' type='nominal'>
