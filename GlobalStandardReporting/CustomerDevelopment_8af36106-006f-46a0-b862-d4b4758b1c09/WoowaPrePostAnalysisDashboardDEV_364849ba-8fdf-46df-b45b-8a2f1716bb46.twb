      </column>
      <column caption='Rollout Batch' datatype='string' name='[Calculation_2779917287850033154]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [city_id] = &apos;41370&apos; THEN &apos;Batch 1&apos; ELSE &apos;Batch 2&apos; END' />
      </column>
      <column caption='DF in Local Currency' datatype='real' name='[Calculation_6532541676945375232]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([delivery_fee_local_n])/SUM([delivery_fee_local_d])' />
      </column>
      <column caption='% OD Orders' datatype='real' name='[Calculation_6591510680311169024]' role='measure' type='quantitative'>
