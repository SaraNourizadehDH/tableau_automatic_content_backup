    <worksheet name='KPIs'>
      <table>
        <view>
          <datasources>
            <datasource caption='_woowa_pre_post_dps (cl)' name='federated.0mxelq91qqo7la1c27d61158hnyy' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose Time Dimension' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
              <calculation class='tableau' formula='&quot;Day&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0mxelq91qqo7la1c27d61158hnyy'>
            <column aggregation='CountD' caption='Delivery Fee Metrics' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_2779917287843835904]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;Delivery Fee&quot;' />
            </column>
            <column caption='Rollout Batch' datatype='string' name='[Calculation_2779917287850033154]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [city_id] = &apos;41370&apos; THEN &apos;Batch 1&apos; ELSE &apos;Batch 2&apos; END' />
            </column>
            <column caption='% OD Orders' datatype='real' name='[Calculation_6591510680311169024]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([own_delivery_orders])/SUM([orders])' />
            </column>
            <column caption='% Non Subscription Orders' datatype='real' name='[Calculation_6708745006374670341]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([non_subscription_orders])/SUM([orders])' />
            </column>
            <column caption='Pre Dates' datatype='date' name='[Calculation_6708745006384775174]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [period] = &quot;Pre&quot; THEN [report_date] ELSE NULL END' />
            </column>
            <column caption='Post Dates' datatype='date' name='[Calculation_6708745006386368519]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [period] = &quot;Post&quot; THEN [report_date] ELSE NULL END' />
            </column>
            <column caption='Report Quarter' datatype='string' name='[Calculation_6708745006388961288]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(STR(DATETRUNC(&apos;quarter&apos;, [report_date])), 7) // to format as 2025-01, 2025-02 etc.' />
            </column>
            <column caption='Time Period' datatype='string' name='[Calculation_6708745006389542921]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Day&apos; THEN STR([report_date])&#10;    WHEN &apos;Week&apos; THEN [report_week]&#10;    WHEN &apos;Month&apos; THEN [report_month]&#10;    WHEN &apos;Quarter&apos; THEN [Calculation_6708745006388961288]&#10;END' />
            </column>
            <column caption='% Free Delivery Orders' datatype='real' name='[Calculation_892064618750955521]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dbdf_free_delivery])/SUM([dbdf_count])' />
            </column>
