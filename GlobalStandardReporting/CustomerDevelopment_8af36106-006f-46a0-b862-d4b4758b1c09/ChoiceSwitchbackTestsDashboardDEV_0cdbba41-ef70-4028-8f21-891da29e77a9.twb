    <worksheet name='WT KPIs Experiment Level'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Experiment Level KPIs</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='rl.switchback_dashboard_watcher' name='federated.1xnm1g2165fsdx16bmmun1fegmb6' />
          </datasources>
          <datasource-dependencies datasource='federated.1xnm1g2165fsdx16bmmun1fegmb6'>
            <column caption='Order Count Filter' datatype='boolean' name='[Calculation_1349391048039186434]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[total_orders] &gt; 0' />
            </column>
            <column caption='Completed Order Per Client' datatype='real' name='[Calculation_1735082154838847490]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([completed_orders])/SUM([total_clients])' />
            </column>
            <column caption='Order Per Client' datatype='real' name='[Calculation_3366088885756968960]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUm([total_orders])/SUM([total_clients])' />
            </column>
            <column caption='Avg DT' datatype='real' name='[Calculation_3366088885757374465]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_actual_dt])/SUM([total_orders])' />
            </column>
            <column caption='Avg Dropoff Distance' datatype='real' name='[Calculation_3366088885758210050]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_dropoff_distance_manhattan_km])/SUM([total_orders])' />
            </column>
            <column caption='CVR %' datatype='real' name='[Calculation_5436055864187752457]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cvr_numerator])/SUM([cvr_denominator])' />
            </column>
            <column caption='Fail Rate' datatype='real' name='[Calculation_5436055864187871242]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cancelled_orders])/SUM([total_orders])' />
            </column>
            <column caption='Order Early Rate' datatype='real' name='[Calculation_5436055864188354571]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_early_over_10])/SUM([total_orders])' />
            </column>
            <column caption='Order Late Rate' datatype='real' name='[Calculation_5436055864188461068]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_late_over_10])/SUM([total_orders])' />
            </column>
            <column caption='Seamless Rate' datatype='real' name='[Calculation_5436055864188567565]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_seamless_orders])/SUM([total_orders])' />
            </column>
            <column caption='Stacked Rate' datatype='real' name='[Calculation_5436055864188755982]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([stacked_deliveries_count])/SUM([total_orders])' />
            </column>
            <column caption='% DT &gt; 45' datatype='real' name='[Calculation_5436055864189386767]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_dt_over_45_min])/SUM([total_orders])' />
            </column>
            <column datatype='string' name='[action]' role='dimension' type='nominal' />
            <column caption='Cancelled Orders' datatype='integer' name='[cancelled_orders]' role='measure' type='quantitative' />
