            <column caption='Mean Delta (Percent)' datatype='real' name='[Calculation_6869044999222419477]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [variant_a] &lt;&gt; [variant_b] THEN ([mean_b]-[mean_a])/ABS([mean_a]) END' />
