      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1xjczpu0thmgsj116jhkt1jb78sm].[avg:Calculation_6869044999221829650:qk]&quot;' value='Mean A/Adjusted Value A*' />
          <alias key='&quot;[federated.1xjczpu0thmgsj116jhkt1jb78sm].[avg:Calculation_6869044999222063123:qk]&quot;' value='Mean B/Adjusted Value B*' />
          <alias key='&quot;[federated.1xjczpu0thmgsj116jhkt1jb78sm].[avg:Calculation_6869044999222288404:qk]&quot;' value='Delta (Percent)' />
          <alias key='&quot;[federated.1xjczpu0thmgsj116jhkt1jb78sm].[avg:Calculation_6869044999222890519:qk]&quot;' value='Statistical Significance' />
          <alias key='&quot;[federated.1xjczpu0thmgsj116jhkt1jb78sm].[avg:values_count_a:qk]&quot;' value='Values Count A' />
          <alias key='&quot;[federated.1xjczpu0thmgsj116jhkt1jb78sm].[avg:values_count_b:qk]&quot;' value='Values Count B' />
        </aliases>
      </column>
      <column caption='Country Code' datatype='string' name='[Calculation_1145462456854118400]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT([experiment_name], FIND([experiment_name], &quot;|&quot;) -1)' />
      </column>
      <column caption='Experiment Name + Zone ID' datatype='string' name='[Calculation_5378212786544218113]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[experiment_name] + &quot;|&quot; + &quot;zone_id&quot; + &quot;-&quot; + STR([zone_id])' />
      </column>
      <column caption='Variant A = Variant B' datatype='boolean' name='[Calculation_6869044999218167823]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[variant_a] == [variant_b]' />
      </column>
      <column caption='Mean A/Adjusted Value A*' datatype='real' name='[Calculation_6869044999221829650]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 2] when TRUE THEN [cuped_mean_a]&#10;ELSE [mean_a]&#10;END' />
      </column>
      <column caption='Mean B/Adjusted Value B*' datatype='real' name='[Calculation_6869044999222063123]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 2] when TRUE THEN [cuped_mean_b]&#10;ELSE [mean_b]&#10;END' />
      </column>
      <column caption='Delta (Percent)' datatype='real' name='[Calculation_6869044999222288404]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2] WHEN TRUE THEN [Calculation_6869044999222525974]&#10;ELSE [Calculation_6869044999222419477]&#10;END' />
      </column>
      <column caption='Mean Delta (Percent)' datatype='real' name='[Calculation_6869044999222419477]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [variant_a] &lt;&gt; [variant_b] THEN ([mean_b]-[mean_a])/ABS([mean_a]) END' />
      </column>
      <column caption='Mean Delta Cuped (Percent)' datatype='real' name='[Calculation_6869044999222525974]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [variant_a] &lt;&gt; [variant_b] THEN ([cuped_mean_b]-[cuped_mean_a])/ABS([cuped_mean_a]) END' />
      </column>
      <column caption='Statistical Significance' datatype='integer' name='[Calculation_6869044999222890519]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF FALSE THEN 0 ELSE NULL END' />
      </column>
      <column caption='Mean A Exists' datatype='boolean' name='[Calculation_6869044999224934424]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF NOT ISNULL([mean_a]) THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Significance Bottiom Line' datatype='string' name='[Calculation_6869044999225241625]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF&#10;  (&#10;     (&#10;        [Calculation_6869044999225413658] &lt;= [Parameters].[Parameter 3]&#10;        AND&#10;        [anova_p_value] &lt;= [Parameters].[Parameter 3]&#10;     )&#10;      OR &#10;     (&#10;        [Calculation_6869044999225413658] &lt;= [Parameters].[Parameter 3]&#10;        AND&#10;        ISNULL([anova_p_value])&#10;     )&#10;  )&#10;THEN &quot;Statistically Significant&quot;&#10;ELSE &quot;Statistically Insignificant&quot;&#10;END' />
      </column>
      <column caption='Final P Value' datatype='real' name='[Calculation_6869044999225413658]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 2] when true &#10;then IFNULL([corrected_cuped_p_value], [cuped_p_value])&#10;else IFNULL([corrected_p_value], [p_value])&#10;end' />
      </column>
