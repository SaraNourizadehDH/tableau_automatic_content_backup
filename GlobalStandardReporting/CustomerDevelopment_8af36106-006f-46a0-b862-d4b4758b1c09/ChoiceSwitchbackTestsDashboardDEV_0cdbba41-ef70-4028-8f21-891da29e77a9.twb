      <table>
        <view>
          <datasources>
            <datasource caption='rl.switchback_dashboard_events' name='federated.0ues72r00az37218swqog0zfi2k3' />
          </datasources>
          <datasource-dependencies datasource='federated.0ues72r00az37218swqog0zfi2k3'>
            <column caption='Order Count Filter' datatype='boolean' name='[Calculation_1349391048032071680]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[total_orders]&gt;0' />
            </column>
            <column caption='variant' datatype='string' name='[Calculation_1349391048032391169]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [variant] = &apos;variant&apos; THEN &apos;treatment&apos; ELSE [variant] END' />
            </column>
            <column caption='Avg DT' datatype='real' name='[Calculation_3366088885766213635]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_actual_dt])/SUM([total_orders])' />
            </column>
            <column caption='Avg Dropoff Distance' datatype='real' name='[Calculation_3366088885766336516]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_dropoff_distance_manhattan_km])/SUM([total_orders])' />
            </column>
            <column caption='CVR %' datatype='real' name='[Calculation_5436055864128139264]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cvr_numerator])/SUM([cvr_denominator])' />
            </column>
            <column caption='Fail Rate' datatype='real' name='[Calculation_5436055864128229377]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cancelled_orders])/SUM([total_orders])' />
            </column>
            <column caption='% DT &gt; 45' datatype='real' name='[Calculation_5436055864128319490]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_dt_over_45_min])/SUM([total_orders])' />
            </column>
            <column caption='Order Early Rate' datatype='real' name='[Calculation_5436055864128442371]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_early_over_10])/SUM([total_orders])' />
            </column>
            <column caption='Order Late Rate' datatype='real' name='[Calculation_5436055864128483332]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_late_over_10])/SUM([total_orders])' />
            </column>
            <column caption='Seamless Rate' datatype='real' name='[Calculation_5436055864128585733]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_seamless_orders])/SUM([total_orders])' />
            </column>
            <column caption='Stacked Rate' datatype='real' name='[Calculation_5436055864128692230]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([stacked_deliveries_count])/SUM([total_orders])' />
            </column>
            <column aggregation='None' caption='Mean Delay Buckets' datatype='integer' name='[Mean Delay (bin)]' role='dimension' type='ordinal'>
