    <worksheet name='WT Significance Bottom Line'>
      <table>
        <view>
          <datasources>
            <datasource caption='rl.switchback_tset_significance_watcher' name='federated.1xjczpu0thmgsj116jhkt1jb78sm' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Use CUPED' datatype='boolean' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
            </column>
            <column caption='Choose Alpha' datatype='real' name='[Parameter 3]' param-domain-type='range' role='measure' type='quantitative' value='0.05'>
              <calculation class='tableau' formula='0.05' />
              <range granularity='0.01' max='0.1' min='0.01' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1xjczpu0thmgsj116jhkt1jb78sm'>
            <column caption='Country Code' datatype='string' name='[Calculation_1145462456854118400]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT([experiment_name], FIND([experiment_name], &quot;|&quot;) -1)' />
            </column>
            <column caption='Variant A = Variant B' datatype='boolean' name='[Calculation_6869044999218167823]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[variant_a] == [variant_b]' />
            </column>
            <column caption='Mean A Exists' datatype='boolean' name='[Calculation_6869044999224934424]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF NOT ISNULL([mean_a]) THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Significance Bottiom Line' datatype='string' name='[Calculation_6869044999225241625]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF&#10;  (&#10;     (&#10;        [Calculation_6869044999225413658] &lt;= [Parameters].[Parameter 3]&#10;        AND&#10;        [anova_p_value] &lt;= [Parameters].[Parameter 3]&#10;     )&#10;      OR &#10;     (&#10;        [Calculation_6869044999225413658] &lt;= [Parameters].[Parameter 3]&#10;        AND&#10;        ISNULL([anova_p_value])&#10;     )&#10;  )&#10;THEN &quot;Statistically Significant&quot;&#10;ELSE &quot;Statistically Insignificant&quot;&#10;END' />
            </column>
            <column caption='Final P Value' datatype='real' name='[Calculation_6869044999225413658]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 2] when true &#10;then IFNULL([corrected_cuped_p_value], [cuped_p_value])&#10;else IFNULL([corrected_p_value], [p_value])&#10;end' />
            </column>
