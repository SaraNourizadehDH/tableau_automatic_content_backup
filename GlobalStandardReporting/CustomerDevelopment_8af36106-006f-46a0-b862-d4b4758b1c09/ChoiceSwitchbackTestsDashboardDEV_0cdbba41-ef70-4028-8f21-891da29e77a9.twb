    <worksheet name='SB Significance Bottom Line'>
      <table>
        <view>
          <datasources>
            <datasource caption='rl.switchback_test_significance_events' name='federated.0thwa2j034jhmb1avtuof1dd73t9' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Use CUPED' datatype='boolean' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
            </column>
            <column caption='Choose Alpha' datatype='real' name='[Parameter 3]' param-domain-type='range' role='measure' type='quantitative' value='0.05'>
              <calculation class='tableau' formula='0.05' />
              <range granularity='0.01' max='0.1' min='0.01' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0thwa2j034jhmb1avtuof1dd73t9'>
            <column caption='VariantA=VariantB' datatype='boolean' name='[Calculation_6869044999198388224]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[variant_a] == [variant_b]' />
            </column>
            <column caption='Mean A Exists' datatype='boolean' name='[Calculation_6869044999204016137]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF NOT ISNULL([mean_a]) THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Significance Bottom Line' datatype='string' name='[Calculation_6869044999204106250]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF&#10;  (&#10;     (&#10;        [Calculation_6869044999204225035] &lt;= [Parameters].[Parameter 3]&#10;        AND&#10;        [anova_p_value] &lt;= [Parameters].[Parameter 3]&#10;     )&#10;      OR &#10;     (&#10;        [Calculation_6869044999204225035] &lt;= [Parameters].[Parameter 3]&#10;        AND&#10;        ISNULL([anova_p_value])&#10;     )&#10;  )&#10;THEN &quot;Statistically Significant&quot;&#10;ELSE &quot;Statistically Insignificant&quot;&#10;END' />
            </column>
            <column caption='Final P Value' datatype='real' name='[Calculation_6869044999204225035]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 2] when true &#10;then IFNULL([corrected_cuped_p_value], [cuped_p_value])&#10;else IFNULL([corrected_p_value], [p_value])&#10;end' />
            </column>
            <column caption='Country Code' datatype='string' name='[Calculation_935974705425436672]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT([experiment_name], FIND([experiment_name], &quot;|&quot;) -1)' />
            </column>
            <column caption='Analysis Level' datatype='string' name='[analysis_level]' role='dimension' type='nominal' />
            <column caption='Anova P Value' datatype='real' name='[anova_p_value]' role='measure' type='quantitative' />
            <column caption='Corrected Cuped P Value' datatype='real' name='[corrected_cuped_p_value]' role='measure' type='quantitative' />
            <column caption='Corrected P Value' datatype='real' name='[corrected_p_value]' role='measure' type='quantitative' />
            <column caption='Cuped P Value' datatype='real' name='[cuped_p_value]' role='measure' type='quantitative' />
            <column caption='Experiment Name' datatype='string' name='[experiment_name]' role='dimension' type='nominal' />
            <column caption='Kpi Label' datatype='string' name='[kpi_label]' role='dimension' type='nominal' />
            <column caption='Mean A' datatype='real' name='[mean_a]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_6869044999198388224]' derivation='None' name='[none:Calculation_6869044999198388224:nk]' pivot='key' type='nominal' />
