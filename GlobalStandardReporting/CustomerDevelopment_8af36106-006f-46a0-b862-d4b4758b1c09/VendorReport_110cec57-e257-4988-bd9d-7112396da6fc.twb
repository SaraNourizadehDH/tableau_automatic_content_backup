            <column caption='Avg At Vendor Time - Cleaned (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1113796530716098581]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([o_at_restaurant_time_cleaned_sum])/SUM([o_at_restaurant_time_cleaned_count])' />
