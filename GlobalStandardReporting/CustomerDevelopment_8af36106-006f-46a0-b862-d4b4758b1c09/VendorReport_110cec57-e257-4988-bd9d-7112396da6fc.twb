      <column caption='Dimension' datatype='string' name='[Calculation_947444824443674626]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;&#13;&#10;WHEN &quot;All Weeks (6 weeks)&quot; then [delivery_week]&#13;&#10;&#13;&#10;WHEN &quot;Hour Bucket (past week)&quot; then [hour_bucket]&#13;&#10;&#13;&#10;&#13;&#10;WHEN    &quot;Weekday (past week)&quot; then [delivery_weekday]&#13;&#10;&#13;&#10;WHEN     &quot;Hour (past week)&quot; then [report_time]&#13;&#10;&#13;&#10;WHEN &quot;Hour Bucket (6 weeks)&quot; then [hour_bucket]&#13;&#10;&#13;&#10;&#13;&#10;WHEN    &quot;Weekday (6 weeks)&quot; then [delivery_weekday]&#13;&#10;&#13;&#10;WHEN     &quot;Hour (6 weeks)&quot; then [report_time]&#13;&#10;&#13;&#10;end' />
