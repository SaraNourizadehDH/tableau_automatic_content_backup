      <column caption='time filter for dimension' datatype='boolean' name='[Calculation_947444824444338179]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2]= &apos;All Weeks (6 weeks)&apos;&#13;&#10;THEN [week_relative]&lt;= &apos;current_week&apos;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 2]=&apos;Weekday (past week)&apos;&#13;&#10;THEN [week_relative]= &apos;1_week_ago&apos;&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 2]=&apos;Hour Bucket (past week)&apos;&#13;&#10;THEN [week_relative]= &apos;1_week_ago&apos;&#13;&#10;&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 2]=&apos;Hour (past week)&apos;&#13;&#10;THEN [week_relative]= &apos;1_week_ago&apos;&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 2]=&apos;Weekday (6 weeks)&apos;&#13;&#10;THEN [week_relative]&lt;= &apos;current_week&apos;&#13;&#10;&#13;&#10;ELSE [week_relative] &lt;=&apos;current week&apos;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;END' />
