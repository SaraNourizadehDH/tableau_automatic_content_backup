      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/VendorReport_16959140401310/VendorReport-HourlyView?rev=' id='VendorReport-HourlyView' path='/t/GlobalStandardReporting/workbooks/VendorReport' revision='' site='GlobalStandardReporting' />
      <table>
        <view>
          <datasources>
            <datasource caption='vendor_report (temp)' name='federated.1ep7de413bvf9i10lyrz71lux9hx' />
          </datasources>
          <datasource-dependencies datasource='federated.1ep7de413bvf9i10lyrz71lux9hx'>
            <column caption='% vendor Late &gt; 5   ' datatype='real' default-format='p0.0%' name='[% vendor late &gt; 5 (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_over_5_count])/SUM([vendor_late_count])' />
            </column>
            <column caption='Avg DT' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1113796530400108545]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_time_sum])/SUM([delivery_time_count])' />
            </column>
            <column caption='Avg Est. Prep. Duration (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1113796530402074626]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([estimated_prep_duration_sum])/SUM([estimated_prep_time_count])' />
            </column>
            <column caption='unreliability factor' datatype='real' default-format='p0%' name='[Calculation_1113796530404585477]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([reliable_rate_n])/SUM([reliable_rate_d])' />
            </column>
            <column caption='Reliability Factor' datatype='real' default-format='p0.0%' name='[Calculation_1113796530404950022]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1113796530404585477]' />
            </column>
            <column caption='% Near pickup error' datatype='real' default-format='p0.0%' name='[Calculation_1113796530424721416]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([near_pickup])/SUM([successful_deliveries])' />
            </column>
            <column caption='Avg Delivery Distance (km)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1113796530426159113]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_distance_sum])/SUM([delivery_distance_count])' />
            </column>
            <column caption='Avg Pickup Distance Manhattan (km)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1113796530426331146]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pickup_distance_sum])/SUM([pickup_distance_count])' />
            </column>
            <column caption='% Cross Border Orders' datatype='real' default-format='p0.0%' name='[Calculation_1113796530426490891]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cross_border_orders]) /SUM([successful_orders])' />
            </column>
            <column caption='% Vendor Late &gt; 10' datatype='real' default-format='p0.0%' name='[Calculation_1113796530682368015]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_over_10_count])/SUM([vendor_late_count])' />
