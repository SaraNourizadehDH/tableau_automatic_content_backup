            <column caption='Avg To Customer Time (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1113796530716803096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([d_driving_to_customer_time_sum])/SUM([d_driving_to_customer_time_count])' />
