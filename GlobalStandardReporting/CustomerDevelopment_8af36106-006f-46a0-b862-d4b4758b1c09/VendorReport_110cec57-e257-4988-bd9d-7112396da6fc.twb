    <worksheet name='Vendor Report - Table'>
      <layout-options>
        <title>
          <formatted-text>
            <run>&lt;Sheet Name&gt;&#10;</run>
            <run bold='true' fontcolor='#e15759' fontsize='8'>Please note: The report now opens on blank. Please use the &quot;Country Code&quot; filter to select the country needed. This modification is due to resources consumption reduction</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run bold='true' fontcolor='#e15759'>Please note: The report now opens to the last available date.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/VendorReport/VendorReport-Table?rev=' id='VendorReport-Table' path='/t/GlobalStandardReporting/workbooks/VendorReport' revision='' site='GlobalStandardReporting' />
      <table>
        <view>
          <datasources>
            <datasource caption='vendor_report (temp)' name='federated.1ep7de413bvf9i10lyrz71lux9hx' />
          </datasources>
          <datasource-dependencies datasource='federated.1ep7de413bvf9i10lyrz71lux9hx'>
            <column caption='% vendor Late &gt; 5   ' datatype='real' default-format='p0.0%' name='[% vendor late &gt; 5 (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_over_5_count])/SUM([vendor_late_count])' />
            </column>
            <column caption='Avg DT' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1113796530400108545]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_time_sum])/SUM([delivery_time_count])' />
            </column>
            <column caption='Avg Est. Prep. Duration (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1113796530402074626]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([estimated_prep_duration_sum])/SUM([estimated_prep_time_count])' />
            </column>
            <column caption='unreliability factor' datatype='real' default-format='p0%' name='[Calculation_1113796530404585477]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([reliable_rate_n])/SUM([reliable_rate_d])' />
            </column>
            <column caption='Reliability Factor' datatype='real' default-format='p0.0%' name='[Calculation_1113796530404950022]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1113796530404585477]' />
            </column>
            <column caption='% Near pickup error' datatype='real' default-format='p0.0%' name='[Calculation_1113796530424721416]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([near_pickup])/SUM([successful_deliveries])' />
            </column>
            <column caption='% Cross Border Orders' datatype='real' default-format='p0.0%' name='[Calculation_1113796530426490891]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cross_border_orders]) /SUM([successful_orders])' />
            </column>
            <column caption='% Vendor Late &gt; 10' datatype='real' default-format='p0.0%' name='[Calculation_1113796530682368015]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_over_10_count])/SUM([vendor_late_count])' />
            </column>
            <column caption='% vendor late over 15' datatype='real' default-format='p0%' name='[Calculation_1113796530682523665]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_over_15_count])/SUM([vendor_late_count])' />
            </column>
            <column caption='% Cancelled Orders' datatype='real' default-format='p0.0%' name='[Calculation_1113796530718220313]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cancelled_orders]) /&#10;(SUM([cancelled_orders]) + SUM([successful_orders]))' />
            </column>
            <column caption='Avg Promised DT' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1426515241851310080]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([promised_delivery_time_sum])/SUM([promised_delivery_time_count])' />
            </column>
            <column caption='% Delivery Late &gt;10' datatype='real' default-format='p0.0%' name='[Calculation_1426515241851756545]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_delay_over_10_count])/SUM([delivery_delay_count])' />
            </column>
            <column caption='% Delivery Late &gt; 15' datatype='real' default-format='p0.0%' name='[Calculation_1426515241852133378]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_delay_over_15_count])/SUM([delivery_delay_count])' />
            </column>
            <column caption='% DT &gt; 60' datatype='real' default-format='p0.0%' name='[Calculation_1426515241852489731]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_time_over_60_count])/SUM([delivery_time_count])' />
            </column>
            <column caption='Avg Est. Prep Buffer (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1426515241852768260]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([estimated_prep_buffer_sum])/SUM([estimated_prep_buffer_count])' />
            </column>
            <column caption='Avg Dispatching Time (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1426515241853890565]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dispatching_time_sum])/SUM([dispatching_time_count])' />
            </column>
            <column caption='Avg Rider Accepting Time (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1426515241854205958]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([accepting_time_sum])/SUM([accepting_time_count])' />
            </column>
            <column caption='Avg Bag Time (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1426515241855258634]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([bag_time_sum])/SUM([bag_time_count])' />
            </column>
            <column caption='% Stacked Deliveries' datatype='real' default-format='p0.0%' name='[Calculation_1426515241855590411]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([stacked_deliveries])/SUM([successful_deliveries])' />
            </column>
            <column caption='% Stacked Deliveries (Intravendor)' datatype='real' default-format='p0.0%' name='[Calculation_1426515241856016396]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([stacked_deliveries_intravendor])/SUM([successful_deliveries])' />
            </column>
            <column caption='Avg Assumed Actual Prep Duration (min)' datatype='real' default-format='n#,##0.0' name='[Calculation_3555099329787842561]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([assumed_actual_preparation_time_sum]) /  SUM([assumed_actual_preparation_time_count])' />
            </column>
            <column caption='% DT &gt; 45' datatype='real' default-format='p0.0%' name='[Calculation_768145268899213313]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_time_over_45_count])/SUM([delivery_time_count])' />
            </column>
