    <datasource hasconnection='false' inline='true' name='Parameters' version='18.1'>
      <aliases enabled='yes' />
      <column caption='Top Vendors by x % of Orders' datatype='real' default-format='p0%' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='1.0'>
        <calculation class='tableau' formula='1.0' />
        <range granularity='0.050000000000000003' max='1.0' min='0.0' />
      </column>
      <column caption='Choose Dimension ' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;All Weeks (6 weeks)&quot;'>
        <calculation class='tableau' formula='&quot;All Weeks (6 weeks)&quot;' />
        <members>
          <member value='&quot;All Weeks (6 weeks)&quot;' />
          <member value='&quot;Weekday (past week)&quot;' />
          <member value='&quot;Hour Bucket (past week)&quot;' />
          <member value='&quot;Hour (past week)&quot;' />
          <member value='&quot;Weekday (6 weeks)&quot;' />
          <member value='&quot;Hour Bucket (6 weeks)&quot;' />
          <member value='&quot;Hour (6 weeks)&quot;' />
        </members>
      </column>
      <column caption='Top N' datatype='integer' name='[Parameter 3]' param-domain-type='any' role='measure' type='quantitative' value='10'>
        <calculation class='tableau' formula='10' />
      </column>
      <column caption='Set 1 Parameter' datatype='string' datatype-customized='true' name='[Set 1 Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;top 60 vendors&quot;'>
        <calculation class='tableau' formula='&quot;top 60 vendors&quot;' />
        <members>
          <member value='&quot;top 60 vendors&quot;' />
          <member value='&quot;all vendors&quot;' />
        </members>
      </column>
    </datasource>
