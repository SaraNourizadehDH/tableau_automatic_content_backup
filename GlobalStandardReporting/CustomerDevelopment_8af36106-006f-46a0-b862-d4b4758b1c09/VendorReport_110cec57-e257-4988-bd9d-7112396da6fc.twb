      <aliases enabled='yes' />
      <column caption='% vendor Late &gt; 5   ' datatype='real' default-format='p0.0%' name='[% vendor late &gt; 5 (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendor_late_over_5_count])/SUM([vendor_late_count])' />
      </column>
      <column caption='Avg DT' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1113796530400108545]' role='measure' type='quantitative'>
