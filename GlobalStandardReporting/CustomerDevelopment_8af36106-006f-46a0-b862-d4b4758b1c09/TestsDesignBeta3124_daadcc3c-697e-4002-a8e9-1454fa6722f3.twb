      <style>
        <style-rule element='dash-text'>
          <format attr='vertical-align' id='dash-text_14' value='top' />
        </style-rule>
      </style>
      <size maxheight='1100' maxwidth='1400' minheight='1100' minwidth='1400' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='dps_experiment_setups (cl)' name='federated.0b13o2o0p129vi11wms580qf83kr' />
