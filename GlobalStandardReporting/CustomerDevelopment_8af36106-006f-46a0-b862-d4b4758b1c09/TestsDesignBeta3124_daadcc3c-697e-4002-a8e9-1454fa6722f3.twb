      <datasource-dependencies datasource='Parameters'>
        <column caption='Parent Vertical Measure Names Parameter' datatype='string' name='[DBDF detail (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
          <calculation class='tableau' formula='&quot;All&quot;' />
          <members>
            <member value='&quot;All&quot;' />
            <member value='&quot;Restaurant&quot;' />
            <member value='&quot;Shop&quot;' />
            <member value='&quot;Darkstore&quot;' />
            <member value='&quot;Dmart&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.0b13o2o0p129vi11wms580qf83kr'>
