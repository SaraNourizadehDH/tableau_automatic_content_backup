              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Tier&apos;&#13;&#10;THEN (&quot;Tier &quot; + RIGHT(&quot;0&quot;+STR([dbdf_tier]),2))&#13;&#10;ELSE RIGHT(&quot;0&quot;+STR(INT([travel_time_threshold])),2)+&quot;:&quot;+RIGHT(&quot;0&quot;+STR(ROUND([travel_time_threshold]*60%60)),2)&#13;&#10;END' />
