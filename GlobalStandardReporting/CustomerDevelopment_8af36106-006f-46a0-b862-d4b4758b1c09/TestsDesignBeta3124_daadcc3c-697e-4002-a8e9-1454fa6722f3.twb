          <datasource-dependencies datasource='Parameters'>
            <column caption='MOV Minutes detail' datatype='string' name='[Fleet Delay Minutes detail (copy)_2224215319865962536]' param-domain-type='list' role='measure' type='nominal' value='&quot;Delay&quot;'>
              <calculation class='tableau' formula='&quot;Delay&quot;' />
            </column>
            <column caption='MOV TT detail' datatype='string' name='[Fleet Delay TT detail (copy)_2224215319866167337]' param-domain-type='list' role='measure' type='nominal' value='&quot;Travel Time&quot;'>
