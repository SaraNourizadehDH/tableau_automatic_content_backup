      <column caption='Target Group Header' datatype='string' name='[Calculation_1051379446883504128]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Target Group&quot;' />
      </column>
      <column caption='PV Darkstore' datatype='string' name='[Calculation_1192539135607918596]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;  [is_parent_vertical_darkstore] = TRUE&#10;  THEN [test_name]&#10;END' />
      </column>
      <column caption='Sub Period Length' datatype='real' name='[Calculation_1329969324990205952]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([test_sub_period_to], Today())-[test_sub_period_from]' />
      </column>
      <column caption='Share of Vendors' datatype='real' default-format='p0.0%' name='[Calculation_2224215317861920770]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([vendors])/MAX([total_vendors])' />
      </column>
      <column caption='Travel Time Threshold ' datatype='string' default-format='*nn:ss' name='[Calculation_2224215317897228313]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Tier&apos;&#13;&#10;THEN (&quot;Tier &quot; + RIGHT(&quot;0&quot;+STR([dbdf_tier]),2))&#13;&#10;ELSE RIGHT(&quot;0&quot;+STR(INT([travel_time_threshold])),2)+&quot;:&quot;+RIGHT(&quot;0&quot;+STR(ROUND([travel_time_threshold]*60%60)),2)&#13;&#10;END' />
      </column>
      <column caption='Type' datatype='integer' name='[Calculation_2390848503689347088]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [service_fee_type] = &apos;Percentage&apos; THEN 1 ELSEIF [service_fee_type] = &apos;Absolute&apos; THEN 2 ELSE 3 END' />
      </column>
      <column caption='Selected Parent Vertical Dmart' datatype='boolean' name='[Calculation_253960827211845634]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[DBDF detail (copy)] = &apos;Dmart&apos; THEN [is_parent_vertical_dmart] ELSE TRUE END' />
      </column>
      <column caption='Experiment Design Cell Size' datatype='integer' name='[Calculation_2861263530099802112]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Vendor Group Updated At Per Variation Nicer' datatype='string' name='[Calculation_4118541892672221184]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='REPLACE([vendor_group_updated_at_per_variation], &quot;, Vendor Group&quot;, &quot;&#10;Vendor Group&quot;)' />
      </column>
      <column caption='Vendor Group Changes Per Test' datatype='integer' name='[Calculation_4256464631274205184]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [test_name]: MAX([vendor_group_changes_per_variation])}' />
      </column>
      <column caption='Test length' datatype='integer' default-format='*0 days' name='[Calculation_521573162913959943]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[test_start_date],IFNULL([test_end_date],TODAY()))' />
      </column>
      <column caption='Conditions' datatype='string' name='[Calculation_894246032162422796]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [has_time_condition] AND [has_customer_condition] AND [has_location_condition] THEN &apos;Time+Customer+Location&apos;&#13;&#10;ELSEIF [has_time_condition] AND [has_customer_condition] THEN &apos;Time+Customer&apos;&#13;&#10;ELSEIF [has_time_condition] AND [has_location_condition] THEN &apos;Time+Location&apos;&#13;&#10;ELSEIF [has_customer_condition] AND [has_location_condition] THEN &apos;Customer+Location&apos;&#13;&#10;ELSEIF [has_time_condition] THEN &apos;Time&apos;&#13;&#10;ELSEIF [has_customer_condition] THEN &apos;Customer&apos;&#13;&#10;ELSEIF [has_location_condition] THEN &apos;Location&apos;&#13;&#10;ELSE &apos;-&apos;&#13;&#10;END' />
      </column>
      <column caption='Customer Target' datatype='string' name='[Conditions (copy)_894246032167825422]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [has_vertical_customer_target] AND [has_zone_customer_target] THEN &apos;Vert/Zone&apos;&#13;&#10;ELSEIF [has_vertical_customer_target] THEN &apos;Vert&apos;&#13;&#10;ELSEIF [has_zone_customer_target] THEN &apos;Zone&apos;&#13;&#10;ELSE &apos;None&apos;&#13;&#10;END' />
      </column>
      <column caption='Basket Value Tier/Threshold' datatype='string' default-format='N' name='[DBDF Threshold (copy)_2224215319870779434]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[DBDF detail (copy)_2224215319870836779] = &apos;Tier&apos; &#13;&#10;THEN (&quot;Tier &quot; + RIGHT(&quot;0&quot;+STR([basket_value_tier]),2))&#13;&#10;ELSE STR([basket_value_threshold])&#13;&#10;END' />
      </column>
      <column caption='Fleet Delay Minutes Threshold' datatype='string' default-format='*nn:ss' name='[Fleet Delay Minutes Threshold (copy)_1159958440066736128]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[DBDF detail (copy)_2224215319865651238] = &apos;Fleet Delay Tier&apos; &#13;&#10;THEN (&quot;Tier &quot; + RIGHT(&quot;0&quot;+STR([delay_tier]),2))&#13;&#10;ELSE RIGHT(&quot;0&quot;+STR(INT([delay_threshold])),2)+&quot;:&quot;+RIGHT(&quot;0&quot;+STR(ROUND([delay_threshold]%60/60)),2)&#13;&#10;END' />
      </column>
      <column caption='Fleet Delay Travel Time Threshold' datatype='string' default-format='*nn:ss' name='[Fleet Delay Travel Time Threshold (copy)_1159958440069025793]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Fleet Delay detail (copy)_2224215319865782311] = &apos;Tier&apos;&#13;&#10;THEN (&quot;Tier &quot; + RIGHT(&quot;0&quot;+STR([delay_travel_time_tier]),2))&#13;&#10;ELSE RIGHT(&quot;0&quot;+STR(INT([delay_travel_time_threshold])),2)+&quot;:&quot;+RIGHT(&quot;0&quot;+STR(ROUND([delay_travel_time_threshold]*60%60)),2)&#13;&#10;END' />
      </column>
