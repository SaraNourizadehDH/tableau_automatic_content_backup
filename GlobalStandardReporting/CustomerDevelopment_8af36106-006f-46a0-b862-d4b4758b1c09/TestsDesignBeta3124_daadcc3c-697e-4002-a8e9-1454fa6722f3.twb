          <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[test_start_date],IFNULL([test_end_date],TODAY()))' />
        </column>
        <column caption='Already Executed' datatype='boolean' name='[already_executed]' role='dimension' type='nominal'>
          <aliases>
