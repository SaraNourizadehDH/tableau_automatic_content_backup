              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0b13o2o0p129vi11wms580qf83kr'>
            <column caption='Share of Vendors' datatype='real' default-format='p0.0%' name='[Calculation_2224215317861920770]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX([vendors])/MAX([total_vendors])' />
            </column>
            <column caption='Selected Parent Vertical Dmart' datatype='boolean' name='[Calculation_253960827211845634]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[DBDF detail (copy)] = &apos;Dmart&apos; THEN [is_parent_vertical_dmart] ELSE TRUE END' />
            </column>
            <column caption='Experiment Design Cell Size' datatype='integer' name='[Calculation_2861263530099802112]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Test length' datatype='integer' default-format='*0 days' name='[Calculation_521573162913959943]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[test_start_date],IFNULL([test_end_date],TODAY()))' />
            </column>
            <column caption='Conditions' datatype='string' name='[Calculation_894246032162422796]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [has_time_condition] AND [has_customer_condition] AND [has_location_condition] THEN &apos;Time+Customer+Location&apos;&#13;&#10;ELSEIF [has_time_condition] AND [has_customer_condition] THEN &apos;Time+Customer&apos;&#13;&#10;ELSEIF [has_time_condition] AND [has_location_condition] THEN &apos;Time+Location&apos;&#13;&#10;ELSEIF [has_customer_condition] AND [has_location_condition] THEN &apos;Customer+Location&apos;&#13;&#10;ELSEIF [has_time_condition] THEN &apos;Time&apos;&#13;&#10;ELSEIF [has_customer_condition] THEN &apos;Customer&apos;&#13;&#10;ELSEIF [has_location_condition] THEN &apos;Location&apos;&#13;&#10;ELSE &apos;-&apos;&#13;&#10;END' />
            </column>
            <column caption='Selected Parent Vertical Restaurant' datatype='boolean' name='[Selected Parent Vertical Darkstore (copy)_253960827220291588]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[DBDF detail (copy)] = &apos;Restaurant&apos; THEN [is_parent_vertical_restaurant] ELSE TRUE END' />
            </column>
            <column caption='Selected Parent Vertical Darkstore' datatype='boolean' name='[Selected Parent Vertical Dmart (copy)_253960827212214275]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[DBDF detail (copy)] = &apos;Darkstore&apos; THEN [is_parent_vertical_darkstore] ELSE TRUE END' />
