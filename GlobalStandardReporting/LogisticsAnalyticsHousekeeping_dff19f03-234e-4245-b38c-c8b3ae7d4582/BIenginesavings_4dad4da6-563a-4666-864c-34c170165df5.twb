  <worksheets>
    <worksheet name='crosstab'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Light' fontsize='12'>&lt;</run>
            <run fontname='Tableau Light' fontsize='12'>[federated.0tz9jcu0ckthq418b16sq0xt24yd].[max:created_date:ok]</run>
            <run fontname='Tableau Light' fontsize='12'>&gt; Overview</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='on_demand_gcp_projects_query_costs (sandbox_ankur)' name='federated.0tz9jcu0ckthq418b16sq0xt24yd' />
          </datasources>
          <datasource-dependencies datasource='federated.0tz9jcu0ckthq418b16sq0xt24yd'>
            <column caption='BI Engine CPTb' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[BI Engine CPQ per 100 Q (copy)_4542372863520792578]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED :&#10;    SUM(IF [has_bi_engine_enabled] AND (ZN([cost_bi_engine]) / [total_cost] &gt; 0.5) THEN [total_cost] ELSE 0 END)&#10;    /&#10;    SUM(IF [has_bi_engine_enabled] THEN MAX([total_processed_terabytes], 1) ELSE 1 END)&#10;}' />
            </column>
            <column caption='% BI engine cost' datatype='real' default-format='p0%' name='[Calculation_4297630360999374850]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([cost_bi_engine])) / SUM(MAX([total_cost], 1))' />
            </column>
            <column caption='Approx Cost w/ BI engine' datatype='real' name='[Calculation_4297630361010429957]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// use BI engine CPQ or at least ~25 USD per day, whichever is greater&#10;// ~25 USD calculated based on BI engine pricing of $0.0416 per GiB per hour&#10;//  with 25 GB of reservation. For comparison, Logistics uses 40GiB reservation on&#10;//  a project that runs ~1M queries per month, all against rl tables directly.&#10;&#10;// It is likely that most projects can make do with 5 to 10 GiB reservation.&#10;// Some will benefit from a larger reservation size, with even lower CPQ.&#10;&#10;IF [has_bi_engine_enabled]&#10;    THEN [total_cost]&#10;    ELSE MAX([BI Engine CPQ per 100 Q (copy)_4542372863520792578] * ([total_processed_terabytes] / 100), 25*30)&#10;END' />
            </column>
            <column caption='Potential Savings' datatype='real' name='[Calculation_4297630361010720774]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// ignoring cases where expected savings are below 500&#10;IF [total_cost] - [Calculation_4297630361010429957] &gt;= 500&#10;    THEN [total_cost] - [Calculation_4297630361010429957]&#10;    ELSE 0&#10;END' />
            </column>
            <column caption='Cost per Processed TB' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Cost per 100 Queries (copy)_4542372863516483584]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM(ZN([total_cost])) / SUM([total_processed_terabytes]), 2)' />
            </column>
            <column caption='Cost Bi Engine' datatype='real' name='[cost_bi_engine]' role='measure' type='quantitative' />
            <column caption='Count Queries' datatype='integer' name='[count_queries]' role='measure' type='quantitative' />
            <column caption='Created Date' datatype='date' name='[created_date]' role='dimension' type='ordinal' />
            <column caption='Has Bi Engine Enabled' datatype='boolean' name='[has_bi_engine_enabled]' role='dimension' type='nominal' />
            <column-instance column='[created_date]' derivation='Max' name='[max:created_date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[created_date]' derivation='None' name='[none:created_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[has_bi_engine_enabled]' derivation='None' name='[none:has_bi_engine_enabled:nk]' pivot='key' type='nominal' />
            <column-instance column='[project_id]' derivation='None' name='[none:project_id:nk]' pivot='key' type='nominal' />
            <column caption='Project Id' datatype='string' name='[project_id]' role='dimension' type='nominal' />
