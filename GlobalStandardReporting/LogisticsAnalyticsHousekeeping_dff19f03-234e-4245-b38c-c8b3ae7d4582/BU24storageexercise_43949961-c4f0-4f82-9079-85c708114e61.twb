    <worksheet name='WoW ∆'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Medium' fontsize='14'>Week-over-Week change in table costs</run>
            <run fontsize='10'> (based on monthly rate)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='bigquery_storage_metrics_table_day (rl)' name='federated.0gvc0g71v5bkwd1c6vmbo1e0akon' />
          </datasources>
          <datasource-dependencies datasource='federated.0gvc0g71v5bkwd1c6vmbo1e0akon'>
            <column caption='Week ID' datatype='string' name='[Calculation_5258234083928371207]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATETRUNC(&apos;week&apos;, [created_date], &apos;monday&apos;) = DATETRUNC(&apos;week&apos;, TODAY(), &apos;monday&apos;)&#10;    THEN &apos;Current Week&apos;&#10;ELSEIF DATETRUNC(&apos;week&apos;, [created_date], &apos;monday&apos;) = DATETRUNC(&apos;week&apos;, DATETRUNC(&apos;week&apos;, TODAY(), &apos;monday&apos;) - 1, &apos;monday&apos;)&#10;    THEN &apos;Prior Week&apos;&#10;END' />
            </column>
            <column caption='Avg. Monthly Cost' datatype='real' default-format='c&quot; € &quot;#,##0.0;-&quot; € &quot;#,##0.0' name='[Calculation_5258234083929153544]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_monthly_cost]) / COUNTD([created_date])' />
            </column>
            <column caption='Absolute WoW ∆' datatype='real' name='[Calculation_5795006864579993605]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ABS(ZN([Calculation_5258234083929153544]) - LOOKUP(ZN([Calculation_5258234083929153544]), 1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Project|Dataset|Table' datatype='string' name='[Project|Dataset (copy)_5258234083924123654]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[project_id] + &quot; | &quot; + [dataset_id] + &quot; | &quot; + [table_name]' />
            </column>
            <column caption='Created Date' datatype='date' name='[created_date]' role='dimension' type='ordinal' />
            <column caption='Dataset Id' datatype='string' name='[dataset_id]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_5258234083929153544]' derivation='User' name='[diff:usr:Calculation_5258234083929153544:qk:4]' pivot='key' type='quantitative'>
              <table-calc diff-options='Relative' ordering-type='Rows' type='Difference'>
                <address>
                  <value>1</value>
                </address>
              </table-calc>
            </column-instance>
            <column-instance column='[Calculation_5258234083928371207]' derivation='None' name='[none:Calculation_5258234083928371207:nk]' pivot='key' type='nominal' />
            <column-instance column='[Project|Dataset (copy)_5258234083924123654]' derivation='None' name='[none:Project|Dataset (copy)_5258234083924123654:nk]' pivot='key' type='nominal' />
