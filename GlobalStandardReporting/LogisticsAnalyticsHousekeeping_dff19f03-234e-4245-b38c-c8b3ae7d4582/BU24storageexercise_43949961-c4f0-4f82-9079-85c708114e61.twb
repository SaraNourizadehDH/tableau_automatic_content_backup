      <aliases enabled='yes' />
      <column caption='Avg. Partitions Count' datatype='real' name='[Avg. Monthly Cost (copy)_5795006864578191361]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_partitions]) / COUNTD([created_date])' />
      </column>
      <column caption='Avg Daily Storage GB' datatype='real' name='[Calculation_3175811860564070402]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_billable_gb]) / COUNTD([created_date])' />
      </column>
      <column caption='Total Storage per Partition (Gb)' datatype='real' name='[Calculation_5258234083917025280]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_billable_gb]) / SUM([count_partitions])' />
      </column>
      <column caption='Is Yesterday' datatype='boolean' name='[Calculation_5258234083917590530]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[created_date] = TODAY()-1' />
      </column>
      <column caption='Is Top N?' datatype='boolean' name='[Calculation_5258234083920875524]' role='measure' type='nominal'>
        <calculation class='tableau' formula='INDEX() &lt;= [Parameters].[Parameter 1]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Project|Dataset' datatype='string' name='[Calculation_5258234083923374085]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[project_id] + &quot; | &quot; + [dataset_id]' />
      </column>
      <column caption='Week ID' datatype='string' name='[Calculation_5258234083928371207]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATETRUNC(&apos;week&apos;, [created_date], &apos;monday&apos;) = DATETRUNC(&apos;week&apos;, TODAY(), &apos;monday&apos;)&#10;    THEN &apos;Current Week&apos;&#10;ELSEIF DATETRUNC(&apos;week&apos;, [created_date], &apos;monday&apos;) = DATETRUNC(&apos;week&apos;, DATETRUNC(&apos;week&apos;, TODAY(), &apos;monday&apos;) - 1, &apos;monday&apos;)&#10;    THEN &apos;Prior Week&apos;&#10;END' />
      </column>
      <column caption='Avg. Monthly Cost' datatype='real' default-format='c&quot; € &quot;#,##0.0;-&quot; € &quot;#,##0.0' name='[Calculation_5258234083929153544]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_monthly_cost]) / COUNTD([created_date])' />
      </column>
      <column caption='Absolute WoW ∆' datatype='real' name='[Calculation_5795006864579993605]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ABS(ZN([Calculation_5258234083929153544]) - LOOKUP(ZN([Calculation_5258234083929153544]), 1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Is Regulated?' datatype='boolean' name='[Calculation_5795006864599859207]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Project Id (group)] = &apos;Regulated&apos;' />
      </column>
      <column datatype='string' name='[Project Id (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[project_id]' default='&quot;Other&quot;' new-bin='true'>
          <bin default-name='false' value='&quot;Regulated&quot;'>
            <value>&quot;fulfillment-dwh-production&quot;</value>
            <value>&quot;fulfillment-dwh-staging&quot;</value>
            <value>&quot;log-data-science-production&quot;</value>
            <value>&quot;log-data-science-staging&quot;</value>
            <value>&quot;logistics-54934&quot;</value>
          </bin>
        </calculation>
      </column>
      <column caption='Project|Dataset|Table' datatype='string' name='[Project|Dataset (copy)_5258234083924123654]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[project_id] + &quot; | &quot; + [dataset_id] + &quot; | &quot; + [table_name]' />
      </column>
      <column caption='Total Cost per Partition' datatype='real' default-format='c&quot; € &quot;#,##0.0;-&quot; € &quot;#,##0.0' name='[Total Storage per Partition (Gb) (copy)_5258234083917139969]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_monthly_cost]) / SUM([count_partitions])' />
      </column>
