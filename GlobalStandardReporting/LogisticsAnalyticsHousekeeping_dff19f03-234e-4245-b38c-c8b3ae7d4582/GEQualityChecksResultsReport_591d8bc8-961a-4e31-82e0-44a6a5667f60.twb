      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_34A542B8E54148DC8712C313B989254F'>
            <properties context=''>
              <relation connection='bigquery.1iofdzj0xjjwxq1fibslo07ndm61' name='Custom SQL Query' type='text'>WITH base AS (
  SELECT *
  FROM `fulfillment-dwh-production.data_quality_gcc_service.incidents`
), dataset_cte AS (
  SELECT metric, created_at, percent, l.key, l.value
  FROM fulfillment-dwh-production.data_quality.metrics_v2,
  UNNEST (labels) l
), dataset_name AS (
  SELECT distinct dataset, table_name
  FROM dataset_cte
  PIVOT (ANY_VALUE(value) for key IN (&apos;dataset&apos;, &apos;table_name&apos;))
), final AS (
  SELECT created_date
    , FORMAT_DATE(&quot;%G-%V&quot;, created_date) AS iso_week
    , FORMAT_DATE(&quot;%E4Y-%m&quot;, created_date) AS calendar_month
    , record_created_at AS created_at
    , alert_id
    , dataset
    , a.table_name
    , dimension
    , std_threshold
    , metric
    , segment
    , value
    , avg_value
    , std
    , std_diff
  FROM base a
  LEFT JOIN dataset_name b
  ON a.table_name=b.table_name
)
SELECT *
FROM final</relation>
            </properties>
