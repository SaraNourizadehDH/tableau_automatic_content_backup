      <column caption='Search Filter' datatype='boolean' name='[Calculation_4290523108482314240]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1 1] &lt;&gt; &quot;&quot;&#10;    THEN CONTAINS(UPPER([table_id]), UPPER([Parameters].[Parameter 1 1]))&#10;ELSE TRUE&#10;END' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Custom SQL Query' datatype='table' name='[__tableau_internal_object_id__].[_0D24694B37B24F0E8A01D6C95211A3B6]' role='measure' type='quantitative' />
      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
      <date-options start-of-week='monday' />
      <datasource-dependencies datasource='Parameters'>
        <column caption='Table Search' datatype='string' name='[Parameter 1 1]' param-domain-type='any' role='measure' type='nominal' value='&quot;&quot;'>
          <calculation class='tableau' formula='&quot;&quot;' />
        </column>
      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_0D24694B37B24F0E8A01D6C95211A3B6'>
            <properties context=''>
              <relation connection='bigquery.0wnfp5e0clk6y31bxbpiy1kv1l15' name='Custom SQL Query' type='text'><![CDATA[WITH latest_dag_executions AS (
  SELECT dataset
    , table_name
    , TIMESTAMP_DIFF(CURRENT_TIMESTAMP, MAX(next_execution_date), MINUTE) AS time_lapsed_since_next_execution
  FROM `fulfillment-dwh-production.cl.dag_executions` 
  GROUP BY 1,2
), bigquery_metadata AS (
  SELECT dataset_id
    , table_id
    , TIMESTAMP_DIFF(CURRENT_TIMESTAMP(), TIMESTAMP_MILLIS(last_modified_time), MINUTE) AS time_lapsed_since_last_modified
  FROM `fulfillment-dwh-production.dl.bigquery_raw_tables`
)
SELECT bigquery_metadata.dataset_id
  , bigquery_metadata.table_id
  , CASE
      WHEN bigquery_metadata.time_lapsed_since_last_modified << 480 -- if latest modified time in the table is less than this threshold, use it, or else check when the import DAG last ran
        THEN bigquery_metadata.time_lapsed_since_last_modified
      ELSE latest_dag_executions.time_lapsed_since_next_execution
    END AS data_freshness_minutes
FROM bigquery_metadata 
LEFT JOIN latest_dag_executions ON bigquery_metadata.dataset_id = latest_dag_executions.dataset 
  AND bigquery_metadata.table_id = latest_dag_executions.table_name]]></relation>
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
