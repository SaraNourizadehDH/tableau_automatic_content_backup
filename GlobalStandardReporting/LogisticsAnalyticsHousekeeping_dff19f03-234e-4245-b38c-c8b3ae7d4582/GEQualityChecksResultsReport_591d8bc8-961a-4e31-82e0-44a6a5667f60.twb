      <column caption='KPI Selected' datatype='real' name='[Calculation_6058819280218636288]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4] WHEN 1 THEN [value]&#10;WHEN 2 THEN [avg_value]&#10;WHEN 3 THEN [std]&#10;WHEN 4 THEN [std_diff]&#10;END' />
