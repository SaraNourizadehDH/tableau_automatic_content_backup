      </column>
      <column caption='Date Granularity' datatype='string' name='[Calculation_6058819280219758596]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Monthly&apos; THEN [calendar_month]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Weekly&apos; THEN [iso_week]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Daily&apos; THEN STR([Daily])&#10;END' />
      </column>
      <column datatype='date' name='[Daily]' role='dimension' type='quantitative' user:agg-type='Day-Trunc' user:base-field='created_date' user:ui-builder='date-bin-builder'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;day&apos;, [created_date]))' />
      </column>
