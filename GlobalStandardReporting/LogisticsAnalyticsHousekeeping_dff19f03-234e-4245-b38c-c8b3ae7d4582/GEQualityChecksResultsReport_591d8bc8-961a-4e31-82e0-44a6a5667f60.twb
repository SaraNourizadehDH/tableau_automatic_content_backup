FROM bigquery_metadata 
LEFT JOIN latest_dag_executions ON bigquery_metadata.dataset_id = latest_dag_executions.dataset 
  AND bigquery_metadata.table_id = latest_dag_executions.table_name]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
