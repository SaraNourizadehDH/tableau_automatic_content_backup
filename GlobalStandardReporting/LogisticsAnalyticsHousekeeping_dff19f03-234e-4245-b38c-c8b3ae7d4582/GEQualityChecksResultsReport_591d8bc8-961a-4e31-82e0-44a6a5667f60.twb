            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='logistics-data-staging-flat' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='DataHub Production' schema='data_quality_gcc_service' server-oauth='' username='moksha.rajawat@deliveryhero.com' workgroup-auth-mode='prompt' />
