      </column>
      <column caption='Timeframe' datatype='string' name='[Calculation_1897352496705916934]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Day&apos; THEN [report_date_local]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Week&apos; THEN [report_week_local]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Hour&apos; THEN [report_hour]&#10;END' />
      </column>
      <column caption='Choose Type' datatype='string' name='[Calculation_1897352496718835719]' role='dimension' type='nominal'>
