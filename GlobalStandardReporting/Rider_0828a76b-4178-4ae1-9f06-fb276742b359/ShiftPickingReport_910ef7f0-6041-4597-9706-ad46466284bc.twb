      <column caption='Avg. Planned Hours' datatype='real' name='[Avg. Working Hours (copy)_1897352496683450369]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([planned_minutes]/60)/COUNT([shift_id])' />
      </column>
      <column caption='City Config' datatype='real' name='[Calculation_1362620409578385408]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='RAWSQLAGG_REAL(&quot;AVG(%1)/100&quot;, [config_percentage])' />
      </column>
      <column caption='Measure' datatype='string' name='[Calculation_155655713100591104]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 5]' />
      </column>
      <column caption='Avg. Working Hours' datatype='real' name='[Calculation_1897352496682835968]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([actual_minutes]/60)/COUNT([shift_id])' />
      </column>
      <column caption='Avg. Shift Duration (h)' datatype='real' name='[Calculation_1897352496683921410]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([shift_duration_hours])/COUNT([shift_id])' />
      </column>
      <column caption='# Shifts' datatype='integer' name='[Calculation_1897352496684531715]' role='measure' type='quantitative'>
