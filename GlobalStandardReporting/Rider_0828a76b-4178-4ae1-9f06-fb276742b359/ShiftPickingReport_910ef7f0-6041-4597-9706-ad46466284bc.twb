        <calculation class='tableau' formula='[Parameters].[Parameter 6]' />
      </column>
      <column caption='% Shifts Worked' datatype='real' name='[Calculation_2938106223423250432]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([actual_minutes]) / SUM([planned_minutes])' />
      </column>
      <column caption='Dimension A' datatype='string' name='[Calculation_2938106223430115330]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Region&apos; THEN [region]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Country Code&apos; THEN [country_code]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Country Name&apos; THEN [country_name]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;City Name&apos; THEN [city_name]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Zone Name&apos; THEN [zone_name]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Batch Number&apos; THEN STR([batch_number])&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Is Incentivized Shift&apos; THEN STR([is_incentivized_shift])&#10;ELSEIF [Parameters].[Parameter 3] = &apos;None&apos; THEN &apos;&apos; &#10;END' />
      </column>
      <column caption='KPI' datatype='real' name='[Calculation_2938106223435509765]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;# Shifts&apos; THEN [Calculation_1897352496684531715]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;% Shifts Worked&apos; THEN ROUND([Calculation_2938106223423250432]*100, 2)&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Avg. Shift Duration (h)&apos; THEN [Calculation_1897352496683921410]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Avg. Planned Hours&apos; THEN [Avg. Working Hours (copy)_1897352496683450369]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Avg. Working Hours&apos; THEN [Calculation_1897352496682835968]&#10;END' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_448178595251679232]' role='dimension' type='nominal'>
