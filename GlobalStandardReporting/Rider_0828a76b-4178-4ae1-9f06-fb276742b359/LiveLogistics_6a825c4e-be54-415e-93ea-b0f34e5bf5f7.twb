    <worksheet name='Today vs 7 Days Ago'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#e8c039' fontname='Tableau Medium' fontsize='12'>Today</run>
            <run bold='true' fontname='Tableau Medium' fontsize='12'> vs </run>
            <run bold='true' fontcolor='#65aaa3' fontname='Tableau Medium' fontsize='12'>&lt;[Parameters].[Parameter 5]&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='live_orders_global (rl)' name='federated.0n3p8040z3ffzi10k3rof0ovjy3z' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='WoW (same day last week)' caption='Reference Period' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;WoW&quot;'>
              <calculation class='tableau' formula='&quot;WoW&quot;' />
              <aliases>
                <alias key='&quot;WoW&quot;' value='WoW (same day last week)' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0n3p8040z3ffzi10k3rof0ovjy3z'>
            <column caption='city name (lower case)' datatype='string' name='[Calculation_4246824134683820042]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LOWER([city_name])' />
            </column>
            <column caption='Time Period' datatype='string' name='[Calculation_853009964457644034]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [report_date] = TODAY() THEN &apos;Today&apos;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;DoD&apos; AND [report_date] = TODAY()-1 THEN &apos;Yesterday&apos;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;WoW&apos; AND [report_date] = TODAY()-7 THEN &apos;7 Days Ago&apos;&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Cumulative Orders Created' datatype='integer' name='[Calculation_853009964458422275]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF(SUM([orders_created]) &gt; 0, RUNNING_SUM(SUM([orders_created])), NULL)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Brand' datatype='string' name='[brand]' role='dimension' type='nominal' />
            <column caption='City Code' datatype='string' name='[city_code]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='City Name' datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column aggregation='Sum' caption='Created Hour' datatype='integer' name='[created_hour]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_4246824134683820042]' derivation='None' name='[none:Calculation_4246824134683820042:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_853009964457644034]' derivation='None' name='[none:Calculation_853009964457644034:nk]' pivot='key' type='nominal' />
            <column-instance column='[brand]' derivation='None' name='[none:brand:nk]' pivot='key' type='nominal' />
            <column-instance column='[city_code]' derivation='None' name='[none:city_code:nk]' pivot='key' type='nominal' />
