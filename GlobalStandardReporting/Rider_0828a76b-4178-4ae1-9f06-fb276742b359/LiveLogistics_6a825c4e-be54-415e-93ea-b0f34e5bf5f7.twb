      <column caption='Today Most Recent Timestamp' datatype='integer' name='[Calculation_6344586777684135936]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [country_name] : MAX((DATEPART(&apos;hour&apos;, IF [report_date] = TODAY() THEN [Last Event At (copy)_6344586777733689345] END) * 60)&#10;            + DATEPART(&apos;minute&apos;, IF [report_date] = TODAY() THEN [Last Event At (copy)_6344586777733689345] END)) &#10;}' />
