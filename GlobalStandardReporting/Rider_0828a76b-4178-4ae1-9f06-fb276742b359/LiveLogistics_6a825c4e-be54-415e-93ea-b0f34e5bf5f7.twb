            <column caption='Is Today?' datatype='boolean' name='[Calculation_1088604520258093063]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [report_date] = TODAY()&#10;    THEN TRUE&#10;ELSEIF [Parameters].[Parameter 5] = &apos;DoD&apos; AND [report_date] = TODAY()-1 // DoD comparison&#10;    THEN FALSE&#10;ELSEIF [Parameters].[Parameter 5] = &apos;WoW&apos; AND [report_date] = TODAY()-7 // WoW comparison&#10;    THEN FALSE&#10;ELSE NULL&#10;END' />
