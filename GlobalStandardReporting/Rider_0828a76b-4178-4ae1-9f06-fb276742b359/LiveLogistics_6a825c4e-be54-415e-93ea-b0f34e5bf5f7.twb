            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[created_hour]' derivation='None' name='[none:created_hour:ok]' pivot='key' type='ordinal' />
            <column-instance column='[report_date]' derivation='None' name='[none:report_date:qk]' pivot='key' type='quantitative' />
            <column caption='Orders Created' datatype='integer' name='[orders_created]' role='measure' type='quantitative' />
            <column caption='Report Date' datatype='date' name='[report_date]' role='dimension' type='ordinal' />
            <column-instance column='[orders_created]' derivation='Sum' name='[sum:orders_created:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_853009964458422275]' derivation='User' name='[usr:Calculation_853009964458422275:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' />
            </column-instance>
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0n3p8040z3ffzi10k3rof0ovjy3z].[none:Calculation_853009964457644034:nk]' kind='hide'>
