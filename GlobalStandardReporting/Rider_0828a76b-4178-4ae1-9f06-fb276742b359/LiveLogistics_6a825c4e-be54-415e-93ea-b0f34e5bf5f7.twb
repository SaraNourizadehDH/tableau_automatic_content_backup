              <calculation class='tableau' formula='LOWER([city_name])' />
            </column>
            <column caption='DT (mins)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_445011985580785664]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dt_dh_numerator] / 60)&#10;/&#10;SUM([dt_dh_denominator])' />
            </column>
            <column caption='% Fail Rate' datatype='real' default-format='p0.0%' name='[Calculation_445011985586565131]' role='measure' type='quantitative'>
