    <worksheet name='Hourly KPIs'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Medium' fontsize='12'>&lt;Sheet Name&gt; (in Local Times) | </run>
            <run fontsize='10'>Period ∆ compares cumulative orders of &lt;[Parameters].[Parameter 5]&gt; vs today up until most recent data snapshot</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='live_orders_global (rl)' name='federated.0n3p8040z3ffzi10k3rof0ovjy3z' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='WoW (same day last week)' caption='Reference Period' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;WoW&quot;'>
              <calculation class='tableau' formula='&quot;WoW&quot;' />
              <aliases>
                <alias key='&quot;WoW&quot;' value='WoW (same day last week)' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0n3p8040z3ffzi10k3rof0ovjy3z'>
            <column caption='% On Time Orders' datatype='real' default-format='p0.0%' name='[% Late Orders [DH]] (copy)_1088604520202919940]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([on_time_numerator])&#10;/&#10;SUM([on_time_denominator])' />
            </column>
            <column caption='% Early Orders' datatype='real' default-format='p0.0%' name='[% On Time Orders [DH]] (copy)_1088604520203124741]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([early_orders_numerator])&#10;/&#10;SUM([early_orders_denominator])' />
            </column>
            <column caption='Basic CPO [EUR]' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Basic CPO [LC]] (copy)_1088604520273522702]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cpo_eur_numerator])&#10;/&#10;SUM([cpo_denominator])' />
            </column>
            <column caption='PDT' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1088604520178884608]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pdt_numerator])&#10;/&#10;SUM([pdt_denominator])' />
            </column>
            <column caption='% Late Orders' datatype='real' default-format='p0.0%' name='[Calculation_1088604520201166851]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([late_orders_dh_numerator])&#10;/&#10;SUM([late_orders_dh_denominator])' />
            </column>
            <column caption='Is Today?' datatype='boolean' name='[Calculation_1088604520258093063]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [report_date] = TODAY()&#10;    THEN TRUE&#10;ELSEIF [Parameters].[Parameter 5] = &apos;DoD&apos; AND [report_date] = TODAY()-1 // DoD comparison&#10;    THEN FALSE&#10;ELSEIF [Parameters].[Parameter 5] = &apos;WoW&apos; AND [report_date] = TODAY()-7 // WoW comparison&#10;    THEN FALSE&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Period ∆' datatype='real' default-format='p0%' name='[Calculation_1088604520258805770]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF(SUM([orders_created]) &gt; 0&#10;    , (ZN(SUM([orders_created]) - LOOKUP(ZN(SUM([equivalent_orders_created])), -1))&#10;        / ABS(LOOKUP(ZN(SUM([equivalent_orders_created])), -1)))&#10;    , NULL)'>
                <table-calc ordering-field='[federated.0n3p8040z3ffzi10k3rof0ovjy3z].[Calculation_1088604520258093063]' ordering-type='Field' />
              </calculation>
            </column>
            <column caption='Basic CPO [LC]' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1088604520273330189]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cpo_local_numerator])&#10;/&#10;SUM([cpo_denominator])' />
            </column>
            <column caption='Order Accepting Time' datatype='real' name='[Calculation_1716012232352604214]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_accepting_time_numerator])/SUM([order_accepting_time_denominator])' />
            </column>
            <column caption='Rider Accepting Time' datatype='real' name='[Calculation_1716012232352796727]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(rider_accepting_time_numerator)&#10;/ SUM([rider_accepting_time_denominator])' />
            </column>
            <column caption='Rider Securing Time' datatype='real' name='[Calculation_1716012232353038392]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(rider_securing_time_numerator)&#10;/&#10;SUM([rider_securing_time_denominator])' />
            </column>
            <column caption='city name (lower case)' datatype='string' name='[Calculation_4246824134683820042]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LOWER([city_name])' />
            </column>
            <column caption='DT (mins)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_445011985580785664]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dt_dh_numerator] / 60)&#10;/&#10;SUM([dt_dh_denominator])' />
            </column>
            <column caption='To Vendor Time' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_445011985581166594]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([to_vendor_time_numerator])&#10;/&#10;SUM([to_vendor_time_denominator])' />
            </column>
            <column caption='At Vendor Time' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_445011985581305859]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([at_vendor_time_numerator])&#10;/&#10;SUM([at_vendor_time_denominator])' />
            </column>
            <column caption='To Customer Time' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_445011985581420548]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([to_customer_time_numerator])&#10;/&#10;SUM([to_customer_time_denominator])' />
            </column>
            <column caption='At Customer Time' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_445011985581654021]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([at_customer_time_numerator])&#10;/&#10;SUM([at_customer_time_denominator])' />
            </column>
            <column caption='% Fail Rate' datatype='real' default-format='p0.0%' name='[Calculation_445011985586565131]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_cancelled]) / SUM([orders_created])' />
            </column>
            <column caption='% DT &gt; 60' datatype='real' default-format='p0.0%' name='[Calculation_445011985623056397]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dt_dh_gt_60_numerator])&#10;/&#10;SUM([dt_dh_gt_60_denominator])' />
            </column>
            <column caption='% Stacked' datatype='real' default-format='p0.0%' name='[Calculation_810155408848343040]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([stacked_numerator])&#10;/&#10;SUM([stacked_denominator])' />
            </column>
            <column caption='At Customer Time Denominator' datatype='integer' name='[at_customer_time_denominator]' role='measure' type='quantitative' />
            <column caption='At Customer Time Numerator' datatype='real' name='[at_customer_time_numerator]' role='measure' type='quantitative' />
            <column caption='At Vendor Time Denominator' datatype='integer' name='[at_vendor_time_denominator]' role='measure' type='quantitative' />
