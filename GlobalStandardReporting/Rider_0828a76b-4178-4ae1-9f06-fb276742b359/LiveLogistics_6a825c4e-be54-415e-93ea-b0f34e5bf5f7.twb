      <column caption='Brand Exclusions' datatype='boolean' name='[Calculation_2436588203521859584]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[brand] = &apos;Amrest&apos;&#10;OR [brand] = &apos;OnDemandRider&apos;&#10;OR [brand] = &apos;InstaShop&apos;' />
