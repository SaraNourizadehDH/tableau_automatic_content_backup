            <column caption='[Brand, Time Period]' datatype='string' name='[Calculation_5502624756181770240]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[brand] + &quot;, &quot; + [Calculation_853009964457644034]' />
            </column>
            <column caption='Time Period' datatype='string' name='[Calculation_853009964457644034]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [report_date] = TODAY() THEN &apos;Today&apos;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;DoD&apos; AND [report_date] = TODAY()-1 THEN &apos;Yesterday&apos;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;WoW&apos; AND [report_date] = TODAY()-7 THEN &apos;7 Days Ago&apos;&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Cumulative Orders Created' datatype='integer' name='[Calculation_853009964458422275]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF(SUM([orders_created]) &gt; 0, RUNNING_SUM(SUM([orders_created])), NULL)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Brand' datatype='string' name='[brand]' role='dimension' type='nominal' />
