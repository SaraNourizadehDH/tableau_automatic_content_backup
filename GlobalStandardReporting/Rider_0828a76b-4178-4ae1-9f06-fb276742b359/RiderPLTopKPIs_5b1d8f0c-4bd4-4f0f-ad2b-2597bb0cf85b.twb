      <column caption='Earnings Per Hour Change' datatype='real' default-format='p0.0%' name='[% App Score Change (copy)_3569243472398405720]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([% App Score (Current Date) (copy)_3569243472398405715] - &#10; [% App Score (Previous Date) (copy)_3569243472398405716])&#10;/&#10;[% App Score (Previous Date) (copy)_3569243472398405716]' />
