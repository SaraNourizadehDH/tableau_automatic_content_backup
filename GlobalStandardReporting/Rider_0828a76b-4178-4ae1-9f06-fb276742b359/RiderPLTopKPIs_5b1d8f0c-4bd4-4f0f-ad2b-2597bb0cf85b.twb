            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Time granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
            </column>
            <column alias='No' caption='Show KPIs as Columns' datatype='boolean' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='false'>
              <calculation class='tableau' formula='false' />
              <aliases>
                <alias key='false' value='No' />
                <alias key='true' value='Yes' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.15kdr5r01c749q13zd9tb03xg9ad'>
            <column caption='Region' datatype='string' name='[region]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.15kdr5r01c749q13zd9tb03xg9ad (copy)'>
            <column caption='Earnings Per Hour' datatype='real' default-format='C1031%' name='[% App Score (copy)_3569243472398405717]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [metric_name] = &apos;earnings_per_hour&apos; THEN [metric_num] ELSE 0 END)&#10;/ &#10;SUM(IF [metric_name] = &apos;earnings_per_hour&apos; THEN [metric_den] ELSE 0 END)' />
            </column>
            <column caption='AOV' datatype='real' default-format='c#,##0.00&quot; €&quot;;-#,##0.00&quot; €&quot;' name='[% Fail Rate (copy)_3197485406132195328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [metric_name] = &apos;order_value&apos; THEN [metric_num] ELSE 0 END)&#10;/ &#10;SUM(IF [metric_name] = &apos;order_value&apos; THEN [metric_den] ELSE 0 END)' />
            </column>
            <column caption='App Score' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[% On Time (copy)_3569243472397828178]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [metric_name] = &apos;app_easeofuse&apos; THEN [metric_num] ELSE 0 END)&#10;/ &#10;SUM(IF [metric_name] = &apos;app_easeofuse&apos; THEN [metric_den] ELSE 0 END)&#10;+&#10;SUM(IF [metric_name] = &apos;app_functionalities&apos; THEN [metric_num] ELSE 0 END)&#10;/ &#10;SUM(IF [metric_name] = &apos;app_functionalities&apos; THEN [metric_den] ELSE 0 END)&#10;)&#10;/ 2' />
            </column>
            <column caption='AR (%)' datatype='real' default-format='p0.00%' name='[% Stacking (copy)_3197485406134009863]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [metric_name] = &apos;acceptance_rate&apos; THEN [metric_num] ELSE 0 END)&#10;/ &#10;SUM(IF [metric_name] = &apos;acceptance_rate&apos; THEN [metric_den] ELSE 0 END)' />
            </column>
            <column caption='OD Contact Rate %' datatype='real' default-format='p0.00%' name='[% Stacking (copy)_3197485406134235144]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [metric_name] = &apos;contact_rate&apos; THEN [metric_num] ELSE 0 END)&#10;/ &#10;SUM(IF [metric_name] = &apos;contact_rate&apos; THEN [metric_den] ELSE 0 END)' />
            </column>
            <column caption='CPO' datatype='real' default-format='c#,##0.00&quot; €&quot;;-#,##0.00&quot; €&quot;' name='[AOV (copy)_3197485406132396033]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [metric_name] = &apos;cpo&apos; THEN [metric_num] ELSE 0 END)&#10;/ &#10;SUM(IF [metric_name] = &apos;cpo&apos; THEN [metric_den] ELSE 0 END)' />
            </column>
            <column caption='CPO/AOV' datatype='real' default-format='p0.0%' name='[CPO (copy)_3197485406133092354]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[AOV (copy)_3197485406132396033]/[% Fail Rate (copy)_3197485406132195328]' />
            </column>
            <column caption='% Seamless Orders' datatype='real' default-format='p0.0%' name='[Calculation_3569243471344521216]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [metric_name] = &apos;seamless_orders&apos; THEN [metric_num] ELSE 0 END)&#10;/ &#10;SUM(IF [metric_name] = &apos;seamless_orders&apos; THEN [metric_den] ELSE 0 END)' />
            </column>
            <column caption='% Fail Rate' datatype='real' default-format='p0.0%' name='[Calculation_3569243471345680386]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [metric_name] = &apos;fail_rate&apos; THEN [metric_num] ELSE 0 END)&#10;/ &#10;SUM(IF [metric_name] = &apos;fail_rate&apos; THEN [metric_den] ELSE 0 END)' />
            </column>
            <column caption='% On Time' datatype='real' default-format='p0.0%' name='[Calculation_3569243471346593796]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [metric_name] = &apos;orders_ontime&apos; THEN [metric_num] ELSE 0 END)&#10;/ &#10;SUM(IF [metric_name] = &apos;orders_ontime&apos; THEN [metric_den] ELSE 0 END)' />
            </column>
            <column caption='UTR' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_3569243471347273735]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [metric_name] = &apos;utr&apos; THEN [metric_num] ELSE 0 END)&#10;/ &#10;SUM(IF [metric_name] = &apos;utr&apos; THEN [metric_den] ELSE 0 END)' />
            </column>
            <column caption='Delivery Time' datatype='real' default-format='*0.0' name='[Calculation_3569243471347372040]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [metric_name] = &apos;delivery_time&apos; THEN [metric_num] ELSE 0 END)&#10;/ &#10;SUM(IF [metric_name] = &apos;delivery_time&apos; THEN [metric_den] ELSE 0 END)' />
            </column>
            <column caption='Logistics Index' datatype='real' default-format='*0.0' name='[Calculation_3569243471347580937]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3569243471347372040]/[Calculation_3569243471347273735]' />
            </column>
            <column caption='Rider NPS' datatype='real' default-format='*0.0' name='[Calculation_3569243471352127498]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [metric_name] = &apos;rider_nps&apos; THEN [metric_num]*100 ELSE 0 END)&#10;/ &#10;SUM(IF [metric_name] = &apos;rider_nps&apos; THEN [metric_den] ELSE 0 END)' />
            </column>
            <column caption='Selected time granularity' datatype='string' name='[Calculation_3569243471738298379]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Quarter&apos; THEN [report_quarter]&#10;    WHEN &apos;Month&apos; THEN [report_month]&#10;    WHEN &apos;Week&apos; THEN [report_week]&#10;    WHEN &apos;Day&apos; THEN STR([report_date])&#10;END' />
            </column>
            <column caption='Total Orders' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_3801882543188103192]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [metric_name] = &apos;total_orders&apos; THEN [metric_num] ELSE 0 END)' />
            </column>
            <column caption='Show KPIs as Columns?' datatype='boolean' name='[Calculation_6856519366255374336]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 5]' />
            </column>
            <column caption='P-D Distance' datatype='real' default-format='*0.00' name='[Delivery Time (copy)_3197485406133374980]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [metric_name] = &apos;p_d_distance&apos; THEN [metric_num] ELSE 0 END)&#10;/ &#10;SUM(IF [metric_name] = &apos;p_d_distance&apos; THEN [metric_den] ELSE 0 END)' />
            </column>
            <column caption='% Stacking' datatype='real' default-format='p0.0%' name='[Earnings Per Hour (copy)_3197485406133846022]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [metric_name] = &apos;stacked_deliveries&apos; THEN [metric_num] ELSE 0 END)&#10;/ &#10;SUM(IF [metric_name] = &apos;stacked_deliveries&apos; THEN [metric_den] ELSE 0 END)' />
            </column>
            <column caption='Rider Contact Rate %' datatype='real' default-format='p0.00%' name='[OD Contact Rate % (copy)_1673368778074607616]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [metric_name] = &apos;rider_contact_rate&apos; THEN [metric_num] ELSE 0 END)&#10;/ &#10;SUM(IF [metric_name] = &apos;rider_contact_rate&apos; THEN [metric_den] ELSE 0 END)' />
            </column>
            <column caption='LI/P-D Distance' datatype='real' default-format='*0.0' name='[P-D Distance (copy)_3197485406133534725]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3569243471347580937]/[Delivery Time (copy)_3197485406133374980]' />
            </column>
