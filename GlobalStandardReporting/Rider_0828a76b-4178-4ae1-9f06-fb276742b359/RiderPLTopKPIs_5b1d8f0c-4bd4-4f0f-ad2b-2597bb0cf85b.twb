      <table>
        <view>
          <datasources>
            <datasource caption='rider_abcs_report' name='federated.15kdr5r01c749q13zd9tb03xg9ad' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Guided Analytics - Metric' datatype='string' name='[Parameter 2]' param-domain-type='any' role='measure' type='nominal' value='&quot;\% Seamless Orders&quot;'>
              <calculation class='tableau' formula='&quot;% Seamless Orders&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.15kdr5r01c749q13zd9tb03xg9ad'>
            <column caption='Earnings Per Hour' datatype='real' default-format='C1031%' name='[% App Score (copy)_3569243472398405717]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [metric_name] = &apos;earnings_per_hour&apos; THEN [metric_num] ELSE 0 END)&#10;/ &#10;SUM(IF [metric_name] = &apos;earnings_per_hour&apos; THEN [metric_den] ELSE 0 END)' />
            </column>
            <column caption='App Score' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[% On Time (copy)_3569243472397828178]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [metric_name] = &apos;app_easeofuse&apos; THEN [metric_num] ELSE 0 END)&#10;/ &#10;SUM(IF [metric_name] = &apos;app_easeofuse&apos; THEN [metric_den] ELSE 0 END)&#10;+&#10;SUM(IF [metric_name] = &apos;app_functionalities&apos; THEN [metric_num] ELSE 0 END)&#10;/ &#10;SUM(IF [metric_name] = &apos;app_functionalities&apos; THEN [metric_den] ELSE 0 END)&#10;)&#10;/ 2' />
            </column>
            <column caption='% Seamless Orders' datatype='real' default-format='p0.0%' name='[Calculation_3569243471344521216]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [metric_name] = &apos;seamless_orders&apos; THEN [metric_num] ELSE 0 END)&#10;/ &#10;SUM(IF [metric_name] = &apos;seamless_orders&apos; THEN [metric_den] ELSE 0 END)' />
            </column>
            <column caption='% Fail Rate' datatype='real' default-format='p0.0%' name='[Calculation_3569243471345680386]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [metric_name] = &apos;fail_rate&apos; THEN [metric_num] ELSE 0 END)&#10;/ &#10;SUM(IF [metric_name] = &apos;fail_rate&apos; THEN [metric_den] ELSE 0 END)' />
            </column>
            <column caption='% On Time' datatype='real' default-format='p0.0%' name='[Calculation_3569243471346593796]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [metric_name] = &apos;orders_ontime&apos; THEN [metric_num] ELSE 0 END)&#10;/ &#10;SUM(IF [metric_name] = &apos;orders_ontime&apos; THEN [metric_den] ELSE 0 END)' />
            </column>
            <column caption='UTR' datatype='real' name='[Calculation_3569243471347273735]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [metric_name] = &apos;utr&apos; THEN [metric_num] ELSE 0 END)&#10;/ &#10;SUM(IF [metric_name] = &apos;utr&apos; THEN [metric_den] ELSE 0 END)' />
            </column>
            <column caption='Delivery Time' datatype='real' default-format='*0.0' name='[Calculation_3569243471347372040]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [metric_name] = &apos;delivery_time&apos; THEN [metric_num] ELSE 0 END)&#10;/ &#10;SUM(IF [metric_name] = &apos;delivery_time&apos; THEN [metric_den] ELSE 0 END)' />
            </column>
            <column caption='Logistics Index' datatype='real' default-format='*0.0' name='[Calculation_3569243471347580937]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3569243471347372040]/[Calculation_3569243471347273735]' />
            </column>
            <column caption='Rider NPS' datatype='real' default-format='*0.0' name='[Calculation_3569243471352127498]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [metric_name] = &apos;rider_nps&apos; THEN [metric_num]*100 ELSE 0 END)&#10;/ &#10;SUM(IF [metric_name] = &apos;rider_nps&apos; THEN [metric_den] ELSE 0 END)' />
            </column>
            <column caption='Selected Metric' datatype='real' name='[Calculation_3569243472107274293]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2] &#10;WHEN &apos;% Seamless Orders&apos; THEN [Calculation_3569243471344521216]&#10;WHEN &apos;Rider NPS&apos; THEN [Calculation_3569243471352127498]&#10;WHEN &apos;Logistics Index&apos; THEN [Calculation_3569243471347580937]&#10;WHEN &apos;App Score&apos; THEN [% On Time (copy)_3569243472397828178]&#10;WHEN &apos;Earnings Per Hour&apos; THEN [% App Score (copy)_3569243472398405717]&#10;WHEN &apos;UTR&apos; THEN [Calculation_3569243471347273735]&#10;WHEN &apos;Delivery Time&apos; THEN [Calculation_3569243471347372040]&#10;WHEN &apos;% Fail Rate&apos; THEN [Calculation_3569243471345680386]&#10;WHEN &apos;% On Time&apos; THEN [Calculation_3569243471346593796]&#10;END' />
            </column>
            <column caption='Selected Metric (STR)' datatype='string' name='[Calculation_3569243472107769914]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2] &#10;WHEN &apos;% Seamless Orders&apos; THEN STR(ROUND([Calculation_3569243471344521216]*100, 1)) + &apos; %&apos;&#10;WHEN &apos;Rider NPS&apos; THEN STR(ROUND([Calculation_3569243471352127498], 1))&#10;WHEN &apos;Logistics Index&apos; THEN STR(ROUND([Calculation_3569243471347580937], 2))&#10;WHEN &apos;App Score&apos; THEN STR(ROUND([% On Time (copy)_3569243472397828178], 2))&#10;WHEN &apos;Earnings Per Hour&apos; THEN STR(ROUND([% App Score (copy)_3569243472398405717], 2)) + &apos; €&apos;&#10;WHEN &apos;UTR&apos; THEN STR(ROUND([Calculation_3569243471347273735], 2))&#10;WHEN &apos;Delivery Time&apos; THEN STR(ROUND([Calculation_3569243471347372040], 1))&#10;WHEN &apos;% Fail Rate&apos; THEN STR(ROUND([Calculation_3569243471345680386]*100, 1)) + &apos;%&apos;&#10;WHEN &apos;% On Time&apos; THEN STR(ROUND([Calculation_3569243471346593796]*100, 1)) + &apos;%&apos;&#10;END' />
            </column>
            <column caption='Total Orders' datatype='real' name='[Calculation_3801882543188103192]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [metric_name] = &apos;total_orders&apos; THEN [metric_num] ELSE 0 END)' />
