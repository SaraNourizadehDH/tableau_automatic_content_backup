      <column caption='Earnings Per Hour (Current Date)' datatype='real' default-format='p0.0%' name='[% App Score (Current Date) (copy)_3569243472398405715]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;IF [Calculation_3569243471738298379] = [Calculation_3801882543168708629]&#10;AND [metric_name] = &quot;earnings_per_hour&quot;&#10;THEN [metric_num] ELSE 0 END)&#10;/ &#10;SUM(&#10;IF [Calculation_3569243471738298379] = [Calculation_3801882543168708629]&#10;AND [metric_name] = &quot;earnings_per_hour&quot;&#10;THEN [metric_den] ELSE 0 END)' />
