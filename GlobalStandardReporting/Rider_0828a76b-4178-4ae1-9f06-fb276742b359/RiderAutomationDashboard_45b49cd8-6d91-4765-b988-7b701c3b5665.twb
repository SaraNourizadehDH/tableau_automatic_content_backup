      <table>
        <view>
          <datasources>
            <datasource caption='rider_automation_dashboard' name='federated.115v6i11i1js2313i5oa81t1vzb9' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose Time Dimension' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Report Date&quot;'>
              <calculation class='tableau' formula='&quot;Report Date&quot;' />
            </column>
            <column caption='Choose Graph Type' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Percentages&quot;'>
              <calculation class='tableau' formula='&quot;Percentages&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.115v6i11i1js2313i5oa81t1vzb9'>
            <column caption='Time Dimension' datatype='string' name='[Calculation_5668624587161583616]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;&#10;when  &apos;Report Hour&apos; THEN [report_hour]&#10;when &apos;Report Date&apos; THEN [report_date]&#10;when &apos;Report Week&apos; then [report_week]&#10;end' />
            </column>
            <column caption='fixed sessions no contact day' datatype='integer' name='[Calculation_5668624587217920006]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [country_code], [city_name], [batch_number], [report_week],[report_date]: max([sessions_no_contact_day])}' />
            </column>
            <column caption='fixed sessions no contact week' datatype='integer' name='[Calculation_5668624587218006023]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [country_code], [city_name], [batch_number], [report_week]: max([sessions_no_contact_week])}' />
            </column>
            <column caption='Sessions with no contact ' datatype='integer' name='[Calculation_5668624587218378761]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;&#10;when  &apos;Report Hour&apos; THEN SUM([sessions_no_contact_hour])&#10;when &apos;Report Date&apos; THEN SUM([Calculation_5668624587217920006])&#10;when &apos;Report Week&apos; then SUM([Calculation_5668624587218006023])&#10;end' />
            </column>
            <column caption='fixed sessions day' datatype='integer' name='[Calculation_5668624587218612235]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [country_code], [city_name], [batch_number], [report_week],[report_date]: max([sessions_day])}' />
            </column>
            <column caption='fixed sessions week' datatype='integer' name='[Calculation_5668624587218755596]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [country_code], [city_name], [batch_number], [report_week]: max([sessions_week])}' />
            </column>
            <column caption='# Sessions' datatype='integer' name='[Calculation_5668624587218972686]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;&#10;when  &apos;Report Hour&apos; THEN SUM([sessions_hour])&#10;when &apos;Report Date&apos; THEN SUM([Calculation_5668624587218612235])&#10;when &apos;Report Week&apos; then SUM([Calculation_5668624587218755596])&#10;end' />
            </column>
            <column caption='Deflection Rate' datatype='real' default-format='p0.0%' name='[Calculation_5668624587219513360]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5668624587218378761]/ [Calculation_5668624587218972686]' />
            </column>
            <column caption='Absolute or Percentages' datatype='string' name='[Calculation_6615436045048922113]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 3]' />
            </column>
            <column caption='% Call Customer' datatype='real' default-format='p0.0%' name='[Calculation_747316096880152576]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([call_customer]) / SUM([actions])' />
            </column>
            <column caption='% Dismiss' datatype='real' default-format='p0.0%' name='[Calculation_747316096880254977]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dismiss]) / SUM([actions])' />
            </column>
            <column caption='% End Break' datatype='real' default-format='p0.0%' name='[Calculation_747316096880332802]' role='measure' type='quantitative'>
