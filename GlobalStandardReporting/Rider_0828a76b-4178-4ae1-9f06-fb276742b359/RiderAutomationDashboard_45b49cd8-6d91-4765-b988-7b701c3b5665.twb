          <datasource-dependencies datasource='federated.115v6i11i1js2313i5oa81t1vzb9'>
            <column caption='# Users' datatype='integer' default-format='N' name='[# Sessions with multiple topics (copy)_5668624587247038494]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;&#10;when  &apos;Report Hour&apos; THEN SUM([users_per_hour])&#10;when &apos;Report Date&apos; THEN SUM([fixed sessions no contact day (copy)_5668624587246845980])&#10;when &apos;Report Week&apos; then SUM([fixed users day (copy)_5668624587246936093])&#10;end' />
            </column>
            <column caption='Break Duration (mins)' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1309632734714478592]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([selected_break_duration_sum]) / SUM([selected_break_duration_count])' />
            </column>
            <column caption='Level of Detail' datatype='string' name='[Calculation_4529847203741646848]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;&#10;WHEN 1 THEN &quot;&quot;&#10;WHEN 2 THEN [region]&#10;WHEN 3 THEN [country_name]&#10;WHEN 4 THEN [city_name]&#10;WHEN 5 THEN [batch_number]&#10;END' />
            </column>
            <column caption='Time Dimension' datatype='string' name='[Calculation_5668624587161583616]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;&#10;when  &apos;Report Hour&apos; THEN [report_hour]&#10;when &apos;Report Date&apos; THEN [report_date]&#10;when &apos;Report Week&apos; then [report_week]&#10;end' />
            </column>
            <column caption='# Active Riders' datatype='integer' name='[Calculation_5668624587162390530]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;&#10;when  &apos;Report Hour&apos; THEN SUM([riders_hour])&#10;when &apos;Report Date&apos; THEN SUM([Calculation_5668624587173425155])&#10;when &apos;Report Week&apos; then SUM([fixed riders day (copy)_5668624587174084612])&#10;end' />
            </column>
            <column caption='fixed riders day' datatype='integer' name='[Calculation_5668624587173425155]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [country_code], [city_name], [batch_number], [report_week],[report_date]: max([riders_day])}' />
