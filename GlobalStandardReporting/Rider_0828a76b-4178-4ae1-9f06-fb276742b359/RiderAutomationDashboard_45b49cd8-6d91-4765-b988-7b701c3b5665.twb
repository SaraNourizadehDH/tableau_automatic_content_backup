              <calculation class='tableau' formula='CASE   [Parameters].[Parameter 5]&#10;&#10;WHEN    1   THEN      [region]&#10;WHEN    2 THEN     [country_name]&#10;WHEN     3  THEN     [city_name]&#10;WHEN    4  then     [batch_number]&#10;WHEN    5  then     [country_code]&#10;WHEN 6 THEN &quot;&quot;&#10;END' />
