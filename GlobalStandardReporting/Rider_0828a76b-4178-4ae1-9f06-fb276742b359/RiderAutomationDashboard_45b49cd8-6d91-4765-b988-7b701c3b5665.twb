        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;&#10;WHEN &apos;# Sessions&apos; then [Calculation_5668624587218972686]&#10;WHEN &apos;% Sessions With Actions&apos; then ([Calculation_5668624587245203476] * 100)&#10;WHEN &apos;Deflection Rate&apos; then ([Calculation_5668624587219513360] * 100)&#10;WHEN &apos;Contact Session Duration (mins)&apos; then [Calculation_5668624587217297413]&#10;WHEN &apos;Non Contact Session Duration (mins)&apos; then [Calculation_5668624587217297413]&#10;WHEN &apos;Usage Rate&apos; THEN ([Calculation_6769543590166835201] * 100)&#10;WHEN &apos;Sessions Per User&apos; then [Calculation_5668624587247181855]&#10;WHEN &apos;# Acknowledge&apos; THEN SUM([acknowledge])&#10;WHEN &apos;% Acknowledge&apos; then ([Calculation_747316096881651720] * 100)&#10;WHEN &apos;# Call Customer&apos; then SUM([call_customer])&#10;WHEN &apos; % Call Customer&apos; then ([Calculation_747316096880152576] * 100)&#10;WHEN &apos;# Dismiss&apos; then SUM([dismiss])&#10;WHEN &apos;% Dismiss&apos; then ([Calculation_747316096880254977] * 100)&#10;WHEN &apos;# Request Break&apos; then sum([request_break])&#10;WHEN &apos;% Request Break&apos; then ([Calculation_747316096880713734] * 100)&#10;WHEN &apos;# End Break&apos; then SUM([end_break])&#10;WHEN &apos;% End Break&apos; then ([Calculation_747316096880332802] * 100)&#10;WHEN &apos;# Open Chat&apos; then SUM([open_chat])&#10;WHEN &apos;% Open Chat&apos; then ([Calculation_747316096880422915] * 100)&#10;WHEN &apos;# Open Customer Chat&apos; then SUM([open_customer_chat])&#10;WHEN &apos;% Open Customer Chat&apos; then ([Calculation_747316096880517124] * 100)&#10;WHEN &apos;# Select Break Duration&apos; then sum([select_item])&#10;WHEN &apos;% Select Break Duration&apos; then ([Calculation_747316096880807943] * 100)&#10;WHEN &apos;# Redispatch Order&apos; then sum([redispatch_order])&#10;WHEN &apos;% Redispatch Order&apos; then ([Calculation_747316096880623621] * 100)&#10;WHEN &apos;# Actions&apos; then sum([actions])&#10;WHEN &apos;# Break Until End of Shift&apos; then sum([break_until_end_of_shift])&#10;WHEN &apos;Break Duration (mins)&apos; then [Calculation_1309632734714478592]&#10;END' />
      </column>
