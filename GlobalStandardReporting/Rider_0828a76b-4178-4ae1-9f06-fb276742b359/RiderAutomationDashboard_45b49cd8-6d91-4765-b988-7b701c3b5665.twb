              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;&#10;when  &apos;Report Hour&apos; THEN SUM([users_per_hour])&#10;when &apos;Report Date&apos; THEN SUM([fixed sessions no contact day (copy)_5668624587246845980])&#10;when &apos;Report Week&apos; then SUM([fixed users day (copy)_5668624587246936093])&#10;end' />
