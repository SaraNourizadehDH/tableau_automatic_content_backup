      <column caption='# Active Riders' datatype='integer' name='[Calculation_5668624587162390530]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;&#10;when  &apos;Report Hour&apos; THEN SUM([riders_hour])&#10;when &apos;Report Date&apos; THEN SUM([Calculation_5668624587173425155])&#10;when &apos;Report Week&apos; then SUM([fixed riders day (copy)_5668624587174084612])&#10;end' />
      </column>
      <column caption='fixed riders day' datatype='integer' name='[Calculation_5668624587173425155]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [country_code], [city_name], [batch_number], [report_week],[report_date]: max([riders_day])}' />
