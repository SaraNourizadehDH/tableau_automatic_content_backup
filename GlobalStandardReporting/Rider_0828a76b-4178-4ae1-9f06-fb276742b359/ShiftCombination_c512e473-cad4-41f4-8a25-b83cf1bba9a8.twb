    <worksheet name='Actual - Shift Duration'>
      <table>
        <view>
          <datasources>
            <datasource caption='shift_combination (rl)' name='federated.0p1m7ul1gxxztg10ud89y16ikqj0' />
          </datasources>
          <datasource-dependencies datasource='federated.0p1m7ul1gxxztg10ud89y16ikqj0'>
            <column caption='Planned Shift Duration' datatype='real' name='[Calculation_2036964058315948037]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([shift_duration_sum]/3600)/SUM([shift_duration_count])' />
