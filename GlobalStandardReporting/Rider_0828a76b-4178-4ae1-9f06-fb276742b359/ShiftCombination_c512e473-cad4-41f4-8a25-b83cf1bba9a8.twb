      <column caption='Sum Shift duration in hours' datatype='real' name='[Calculation_1143984739708416000]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([shift_duration_sum]/3600)' />
      </column>
      <column caption='Select Type of Graphic' datatype='string' name='[Calculation_1143984739726934017]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 2]' />
      </column>
      <column caption='Actual Working Time (h)' datatype='real' name='[Calculation_2036964058303553536]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[actual_working_time_sum] / 3600' />
      </column>
      <column caption='UTR' datatype='real' name='[Calculation_2036964058303934465]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([completed_orders]) / SUM([Calculation_2036964058303553536])' />
      </column>
      <column caption='% No Show' datatype='real' name='[Calculation_2036964058311680003]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([no_show])/SUM([shifts])' />
      </column>
      <column caption='Acceptance Rate' datatype='real' name='[Calculation_2036964058313322500]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([accepted_deliveries])/SUM([notified_deliveries])' />
      </column>
      <column caption='Planned Shift Duration' datatype='real' name='[Calculation_2036964058315948037]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([shift_duration_sum]/3600)/SUM([shift_duration_count])' />
      </column>
      <column caption='Shift Maker Switch' datatype='string' name='[Calculation_2036964058419847175]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
      </column>
