  <worksheets>
    <worksheet name='Significance'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Statistical Significance</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='_dt_experiments_results (rl)' name='federated.15b475716vnod711ml2ku1shi7o4 (copy)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Alpha-level' datatype='real' default-format='p0%' name='[Parameter 8]' param-domain-type='range' role='measure' type='quantitative' value='0.05'>
              <calculation class='tableau' formula='0.05' />
              <range max='0.05' min='0.01' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.15b475716vnod711ml2ku1shi7o4 (copy)'>
            <column caption='Not null and different groups' datatype='boolean' name='[Calculation_1016265419126304769]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT ISNULL([group_a]) AND NOT ISNULL([group_b]) AND [group_a] != [group_b]' />
            </column>
            <column caption='p-value' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[Calculation_1016265419376644098]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([corrected_cuped_p_value], IFNULL([cuped_p_value], IFNULL([corrected_p_value], [p_value])))' />
            </column>
            <column caption='Metric Name' datatype='string' name='[Calculation_1016265419377655812]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [kpi_label]&#10;WHEN &apos;rcr&apos; THEN &apos;RCR&apos;&#10;WHEN &apos;ccr&apos; THEN &apos;CCR&apos;&#10;WHEN &apos;orders&apos; THEN &apos;Orders per customer&apos;&#10;WHEN &apos;gmv&apos; THEN &apos;GMV per customer&apos;&#10;WHEN &apos;dt&apos; THEN &apos;DT (min)&apos;&#10;WHEN &apos;pdt&apos; THEN &apos;Promised DT (min)&apos;&#10;WHEN &apos;order_late_5min&apos; THEN &apos;% Orders late &gt; 5 min&apos;&#10;WHEN &apos;order_late_10min&apos; THEN &apos;% Orders late &gt; 10 min&apos;&#10;WHEN &apos;fail_rate&apos; THEN &apos;% Fail rate&apos;&#10;WHEN &apos;dt_below_pdt_range&apos; THEN &apos;% DT below PDT range&apos;&#10;WHEN &apos;dt_within_pdt_range&apos; THEN &apos;% DT within PDT range&apos;&#10;WHEN &apos;dt_above_pdt_range&apos; THEN &apos;% DT above PDT range&apos;&#10;WHEN &apos;dt_over_55min&apos; THEN &apos;% DT &gt; 55 min&apos;&#10;ELSE [kpi_label]&#10;END' />
            </column>
            <column caption='Is Significant' datatype='string' name='[Calculation_1016265419379671045]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If [Calculation_1016265419376644098] &lt; [Parameters].[Parameter 8] THEN &apos;YES&apos; ELSE &apos;NO&apos; END' />
            </column>
            <column caption='Mean Group A' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1016265419432697880]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [kpi_label]&#10;WHEN &apos;rcr&apos; THEN [mean_a] * 100&#10;WHEN &apos;rcr_dropoff&apos; THEN [mean_a] * 100&#10;WHEN &apos;ccr&apos; THEN [mean_a] * 100&#10;WHEN &apos;orders&apos; THEN [mean_a]&#10;WHEN &apos;gmv&apos; THEN [mean_a]&#10;WHEN &apos;dt&apos; THEN [mean_a]&#10;WHEN &apos;pdt&apos; THEN [mean_a]&#10;WHEN &apos;order_late_5min&apos; THEN [mean_a] * 100&#10;WHEN &apos;order_late_10min&apos; THEN [mean_a] * 100&#10;WHEN &apos;fail_rate&apos; THEN [mean_a] * 100&#10;WHEN &apos;dt_below_pdt_range&apos; THEN [mean_a] * 100&#10;WHEN &apos;dt_within_pdt_range&apos; THEN [mean_a] * 100&#10;WHEN &apos;dt_above_pdt_range&apos; THEN [mean_a] * 100&#10;WHEN &apos;dt_over_55min&apos; THEN [mean_a] * 100&#10;ELSE [mean_a]&#10;END' />
            </column>
            <column caption='Outcome direction' datatype='string' name='[Calculation_1807069393159602328]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1016265419379671045] = &apos;YES&apos; THEN&#10;  IF ([kpi_label] = &apos;orders&apos; OR [kpi_label] = &apos;gmv&apos;) THEN&#10;  &#9;IF [Delta (copy)_690317387676749901] &gt; 0 THEN &apos;positive&apos;&#10;    ELSE &apos;negative&apos;&#10;    END&#10;  ELSEIF [kpi_label] = &apos;dt_within_pdt_range&apos; &#10;  &#9;OR [kpi_label] = &apos;dt_below_pdt_range&apos;&#10;    OR [kpi_label] = &apos;dt_above_pdt_range&apos;&#10;    THEN &apos;neutral&apos;&#10;  ELSE&#10;  &#9;IF [Delta (copy)_690317387676749901] &gt; 0 THEN &apos;negative&apos;&#10;  &#9;ELSE &apos;positive&apos;&#10;    END&#10;  END&#10;ELSE &apos;no impact&apos;&#10;END' />
            </column>
            <column caption='Relative Delta' datatype='real' name='[Calculation_5800706732338495490]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Mean Group A (copy)_1016265419432935449] - [Calculation_1016265419432697880]) / [Calculation_1016265419432697880]' />
            </column>
            <column caption='Target' datatype='string' name='[Calculation_6925551130653646848]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [label] = &apos;by_groups&apos; THEN [country_group] ELSE [country_code] END' />
            </column>
            <column caption='Absolute Delta' datatype='real' name='[Delta (copy)_690317387676749901]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Mean Group A (copy)_1016265419432935449] - [Calculation_1016265419432697880]' />
            </column>
            <column caption='Mean Group B' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Mean Group A (copy)_1016265419432935449]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [kpi_label]&#10;WHEN &apos;rcr&apos; THEN [mean_b] * 100&#10;WHEN &apos;rcr_dropoff&apos; THEN [mean_b] * 100&#10;WHEN &apos;ccr&apos; THEN [mean_b] * 100&#10;WHEN &apos;orders&apos; THEN [mean_b]&#10;WHEN &apos;gmv&apos; THEN [mean_b]&#10;WHEN &apos;dt&apos; THEN [mean_b]&#10;WHEN &apos;pdt&apos; THEN [mean_b]&#10;WHEN &apos;order_late_5min&apos; THEN [mean_b] * 100&#10;WHEN &apos;order_late_10min&apos; THEN [mean_b] * 100&#10;WHEN &apos;fail_rate&apos; THEN [mean_b] * 100&#10;WHEN &apos;dt_below_pdt_range&apos; THEN [mean_b] * 100&#10;WHEN &apos;dt_within_pdt_range&apos; THEN [mean_b] * 100&#10;WHEN &apos;dt_above_pdt_range&apos; THEN [mean_b] * 100&#10;WHEN &apos;dt_over_55min&apos; THEN [mean_b] * 100&#10;ELSE [mean_b]&#10;END' />
            </column>
