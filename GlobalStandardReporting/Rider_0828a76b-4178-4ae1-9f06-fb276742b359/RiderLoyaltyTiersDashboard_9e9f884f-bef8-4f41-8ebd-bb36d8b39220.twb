      <column caption='Percent Difference Working Hours' datatype='real' name='[Percent Difference Deliveries (copy)_6791991227897774083]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_6791991227896754178]- [Calculation_6791991227896602625])/[Calculation_6791991227896602625]' />
      </column>
      <column caption='Percentage Difference 8w retention' datatype='real' name='[Percentage Difference 4w retention (copy)_6791991227899404297]' role='measure' type='quantitative'>
