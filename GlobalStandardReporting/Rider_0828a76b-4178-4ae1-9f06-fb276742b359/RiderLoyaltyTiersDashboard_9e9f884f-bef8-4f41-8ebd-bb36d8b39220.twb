      <column caption='Before deliveries' datatype='real' name='[Calculation_2931139709520900106]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF([period_difference] &lt; 0 AND [period_difference] &gt; -13) THEN [sum_deliveries] ELSE NULL END)/SUM(IF([period_difference] &lt; 0 AND [period_difference] &gt; -13) THEN [rider_count] ELSE NULL END)' />
      </column>
      <column caption='Percent Difference Deliveries' datatype='real' name='[Calculation_2931139709521887244]' role='measure' type='quantitative'>
