    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Custom Tabular View'>
      <repository-location id='CustomTabularView' path='/t/GlobalStandardReporting/workbooks/RiderLoyaltyTiersDashboard' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='1500' maxwidth='1200' minheight='1500' minwidth='1200' sizing-mode='range' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='cl._rider_loyalty_tiers_performance_summary' name='federated.1or4r2404pjmuf1104tjc1pepvr1' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Choose Row Dimension' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Tier Name&quot;'>
          <calculation class='tableau' formula='&quot;Tier Name&quot;' />
          <members>
            <member value='&quot;Tier Name&quot;' />
            <member value='&quot;Cycle Number&quot;' />
            <member value='&quot;None&quot;' />
