      <aliases enabled='yes' />
      <column caption='After 8w retention' datatype='real' name='[After 4w retention (copy)_6791991227899203591]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF([period_difference] &gt;= 0 AND [period_difference] &lt; 13) THEN [rider_count_8w] ELSE NULL END)/SUM(IF([period_difference] &gt;= 0 AND [period_difference] &lt; 13) THEN [cohort_rider_count] ELSE NULL END)' />
      </column>
      <column caption='After 4w retention' datatype='real' name='[After deliveries (copy)_6791991227898351621]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF([period_difference] &gt;= 0 AND [period_difference] &lt; 13) THEN [rider_count_4w] ELSE NULL END)/SUM(IF([period_difference] &gt;= 0 AND [period_difference] &lt; 13) THEN [cohort_rider_count] ELSE NULL END)' />
      </column>
      <column caption='Before 8w retention' datatype='real' name='[Before 4w retention (copy)_6791991227899301896]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF([period_difference] &lt; 0 AND [period_difference] &gt; -13) THEN [rider_count_8w] ELSE NULL END)/SUM(IF([period_difference] &lt; 0 AND [period_difference] &gt; -13) THEN [cohort_rider_count] ELSE NULL END)' />
      </column>
      <column caption='After deliveries' datatype='real' name='[Before deliveries (copy)_2931139709521678347]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF([period_difference] &gt;= 0 AND [period_difference] &lt; 13) THEN [sum_deliveries] ELSE NULL END)/SUM(IF([period_difference] &gt;= 0 AND [period_difference] &lt; 13) THEN [rider_count] ELSE NULL END)' />
      </column>
      <column caption='Granularity Breakdown' datatype='string' name='[Calculation_2049419349559185408]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Region&apos; THEN [region]&#10;WHEN &apos;Country&apos; THEN [country_name]&#10;WHEN &apos;Global&apos; THEN &apos;&apos;&#10;END' />
