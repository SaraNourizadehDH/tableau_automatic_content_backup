      </column>
      <column caption='Before working hours' datatype='real' name='[Calculation_6791991227896602625]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF([period_difference] &lt; 0 AND [period_difference] &gt; -13) THEN [sum_working_hours] ELSE NULL END)/SUM(IF([period_difference] &lt; 0 AND [period_difference] &gt; -13) THEN [rider_count] ELSE NULL END)' />
      </column>
      <column caption='After working hours' datatype='real' name='[Calculation_6791991227896754178]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF([period_difference] &gt;= 0 AND [period_difference] &lt; 13) THEN [sum_working_hours] ELSE NULL END)/SUM(IF([period_difference] &gt;= 0 AND [period_difference] &lt; 13) THEN [rider_count] ELSE NULL END)' />
      </column>
      <column caption='Before 4w retention' datatype='real' name='[Calculation_6791991227898183684]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF([period_difference] &lt; 0 AND [period_difference] &gt; -13) THEN [rider_count_4w] ELSE NULL END)/SUM(IF([period_difference] &lt; 0 AND [period_difference] &gt; -13) THEN [cohort_rider_count] ELSE NULL END)' />
      </column>
      <column caption='Percentage Difference 4w retention' datatype='real' name='[Calculation_6791991227898494982]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([After deliveries (copy)_6791991227898351621] - [Calculation_6791991227898183684])/[Calculation_6791991227898183684]' />
      </column>
      <column caption='Average Deliveries' datatype='real' name='[Calculation_6826542279164534784]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sum_deliveries])/SUM([rider_count])' />
