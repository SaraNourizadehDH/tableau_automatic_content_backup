                    </zone>
                    <zone fixed-size='36' forceUpdate='true' h='2933' id='166' is-fixed='true' type-v2='text' w='27358' x='571' y='24267'>
                      <formatted-text>
                        <run bold='true' fontcolor='#333333' underline='true'>* Scores:</run>
                        <run fontcolor='#333333'> AVG hours per shift previous 4 weeks</run>
                        <run>Æ&#10;</run>
                        <run bold='true' fontcolor='#333333'>1 </run>
                        <run fontcolor='#333333'>== &gt; 8                </run>
                        <run bold='true' fontcolor='#333333'> 2</run>
                        <run fontcolor='#333333'> == &lt; 8              </run>
                        <run bold='true' fontcolor='#333333'>3 </run>
                        <run fontcolor='#333333'>== &lt; 6             </run>
                        <run bold='true' fontcolor='#333333'>4 </run>
                        <run fontcolor='#333333'>== &lt; 4.5</run>
                        <run>Æ&#10;</run>
                      </formatted-text>
                      <zone-style>
                        <format attr='border-color' value='#000000' />
                        <format attr='border-style' value='none' />
                        <format attr='border-width' value='0' />
                        <format attr='margin' value='4' />
                      </zone-style>
                    </zone>
