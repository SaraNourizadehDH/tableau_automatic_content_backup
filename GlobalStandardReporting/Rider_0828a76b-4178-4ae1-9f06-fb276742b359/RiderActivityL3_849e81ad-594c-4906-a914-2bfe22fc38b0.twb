    <worksheet name='Hires - hire date'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Hires</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='mkt_rider_activity' name='federated.00umw3e13yqk011bp92z80dnhmbd' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;EUR&quot;'>
              <calculation class='tableau' formula='&quot;EUR&quot;' />
            </column>
            <column caption='Select Date View' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.00umw3e13yqk011bp92z80dnhmbd'>
            <column caption='Costs' datatype='real' name='[Calculation_1840424165750149120]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;EUR&apos; THEN [costs_eur]&#10;WHEN &apos;USD&apos; THEN [costs_usd]&#10;WHEN &apos;Local Currency&apos; THEN [costs_lc]&#10;END' />
            </column>
            <column caption='CPH' datatype='real' default-format='*#,##0.00;-#,##0.00' name='[Calculation_1840424165752729601]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1840424165750149120])/SUM([hired])' />
