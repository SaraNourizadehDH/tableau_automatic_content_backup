                  <zone forceUpdate='true' h='6205' id='155' type-v2='text' w='27357' x='55286' y='50995'>
                    <formatted-text>
                      <run bold='true' fontcolor='#1b1b1b' underline='true'>* Scores:</run>
                      <run fontcolor='#1b1b1b'> AVG # of worked hours previous 4 weeks</run>
                      <run>Æ&#10;</run>
                      <run bold='true' fontcolor='#1b1b1b'>1</run>
                      <run fontcolor='#1b1b1b'> == &gt; 45 h/wk                          </run>
                      <run bold='true' fontcolor='#1b1b1b'>4</run>
                      <run fontcolor='#1b1b1b'> == &lt; 20 h/wk</run>
                      <run>Æ&#10;</run>
                      <run bold='true' fontcolor='#1b1b1b'>2 </run>
                      <run fontcolor='#1b1b1b'><![CDATA[== < 45 h/wk                          ]]></run>
                      <run bold='true' fontcolor='#1b1b1b'>5</run>
                      <run fontcolor='#1b1b1b'> == &lt; 10 h/wk</run>
                      <run>Æ&#10;</run>
                      <run bold='true' fontcolor='#1b1b1b'>3</run>
