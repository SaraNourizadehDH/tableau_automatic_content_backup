              <calculation class='tableau' formula='&quot;EUR&quot;' />
            </column>
            <column caption='Select Date View' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.00umw3e13yqk011bp92z80dnhmbd'>
            <column caption='AVG Tenure (weeks)' datatype='real' name='[AVG Efficiency (copy 2)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_tenure])/ SUM([hired_and_active])' />
            </column>
            <column caption='AVG Recency  (days)' datatype='real' name='[AVG Efficiency (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_recency])/ SUM([hired])' />
            </column>
            <column caption='AVG Frequency (h/last 4 weeks)' datatype='real' name='[AVG Recency (copy)]' role='measure' type='quantitative'>
