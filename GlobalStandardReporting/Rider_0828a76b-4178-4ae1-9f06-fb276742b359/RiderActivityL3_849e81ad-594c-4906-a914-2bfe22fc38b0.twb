    <dashboard name='Overview - Hires'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/L3RiderActivity_16553723052280/Overview-Hires?rev=' id='Overview-Hires' path='/t/GlobalStandardReporting/workbooks/RiderActivityL3' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='2000' maxwidth='1400' minheight='1500' minwidth='1200' sizing-mode='range' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='mkt_rider_activity' name='federated.00umw3e13yqk011bp92z80dnhmbd' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;EUR&quot;'>
          <calculation class='tableau' formula='&quot;EUR&quot;' />
          <members>
            <member value='&quot;EUR&quot;' />
            <member value='&quot;USD&quot;' />
            <member value='&quot;Local Currency&quot;' />
          </members>
        </column>
        <column caption='Select Date View' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
          <calculation class='tableau' formula='&quot;Monthly&quot;' />
