      <aliases enabled='yes' />
      <column caption='AVG Tenure (weeks)' datatype='real' name='[AVG Efficiency (copy 2)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_tenure])/ SUM([hired_and_active])' />
      </column>
      <column caption='AVG Recency  (days)' datatype='real' name='[AVG Efficiency (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_recency])/ SUM([hired])' />
      </column>
      <column caption='AVG Time to Hire' datatype='real' name='[AVG Processing Time (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([time_to_hire])/ SUM([hired])' />
      </column>
      <column caption='AVG Frequency (h/last 4 weeks)' datatype='real' name='[AVG Recency (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_frequency])/ SUM([hired_and_active])' />
      </column>
      <column caption='AVG Time to first 5 shifts' datatype='real' name='[AVG Time Hired to Work (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([time_to_fifth_shift])/SUM([hired])' />
      </column>
      <column datatype='integer' name='[Batch Number (copy)]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[batch_number]' />
      </column>
      <column caption='CR # Completed 9h after 14d' datatype='real' name='[CR # Completed 5 shifts (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([completed_9h_in_14d])/SUM([hired])' />
      </column>
      <column caption='CR # Completed 5 shifts' datatype='real' name='[CR # Hired &amp; Active (copy 2)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fifth_shift_reached])/SUM([hired])' />
      </column>
      <column caption='CR # Hired' datatype='real' name='[CR # Hired &amp; Active (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([hired])/SUM([hired])' />
      </column>
      <column caption='CR # Hired &amp; Active' datatype='real' name='[CR Education (copy 2)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([hired_and_active])/SUM([hired])' />
      </column>
      <column caption='CVR Hire to Active' datatype='real' name='[CVR Lead to Hire (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([hired_and_active])/SUM([hired])' />
      </column>
      <column caption='AVG Time Hired to Work' datatype='real' name='[Calculation_1256433956361482245]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([time_to_first_shift])/SUM([hired])' />
      </column>
      <column caption='Costs' datatype='real' name='[Calculation_1840424165750149120]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;EUR&apos; THEN [costs_eur]&#10;WHEN &apos;USD&apos; THEN [costs_usd]&#10;WHEN &apos;Local Currency&apos; THEN [costs_lc]&#10;END' />
      </column>
      <column caption='CPH' datatype='real' default-format='*#,##0.00;-#,##0.00' name='[Calculation_1840424165752729601]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1840424165750149120])/SUM([hired])' />
      </column>
      <column caption='Date View' datatype='date' default-format='*YY-MM-DD' name='[Calculation_1840424165991165954]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE( &#10;IF [Parameters].[Parameter 2] = &quot;Daily&quot; THEN [report_date]&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Weekly&quot; THEN DATETRUNC(&apos;week&apos;,[report_date],&apos;sunday&apos;)&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Monthly&quot; THEN DATETRUNC(&apos;month&apos;,[report_date],&apos;sunday&apos;)&#10;END&#10;)' />
      </column>
      <column caption='Worked Hours' datatype='real' name='[Calculation_1840424166057537540]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([rider_hours])' />
      </column>
      <column caption='No shift yet' datatype='integer' name='[Calculation_2281213951514968064]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([hired])- SUM([hired_and_active])' />
      </column>
      <column caption='AVG Efficiency (h/shift)' datatype='real' name='[Calculation_2281213953223098369]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_efficiency])/ SUM([hired_and_active])' />
      </column>
      <column caption='only past' datatype='boolean' name='[Calculation_3439835341951500289]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1840424165991165954] &lt;= TODAY()' />
      </column>
      <column caption='Channel Param' datatype='string' name='[Calculation_4027977303428403200]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &apos;UTM Channel&apos; THEN CASE [channel] WHEN &apos;UNKNOWN&apos; THEN &apos;BRAND&apos; ELSE [channel] END&#10;WHEN &apos;Exit Poll Channel&apos; THEN [channel_ep]&#10;END' />
      </column>
      <column caption='1' datatype='integer' default-format='p0.00%' name='[Calculation_4280249268785799168]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_4401424277404041216]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Channel - Exit Poll' datatype='string' name='[Channel Ep (copy)]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[channel_ep]' />
      </column>
      <column caption='Country Iso ' datatype='string' name='[Country Iso (copy)]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
        <calculation class='tableau' formula='[country_iso]' />
      </column>
      <column caption='Efficiency (no NULL)' datatype='string' name='[Efficiency (copy)]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[efficiency]' />
      </column>
      <column datatype='string' name='[Frequency (copy)]' role='dimension' type='nominal'>
