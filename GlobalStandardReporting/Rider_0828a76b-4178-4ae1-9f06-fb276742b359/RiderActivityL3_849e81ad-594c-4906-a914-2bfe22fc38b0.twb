                <zone h='30000' id='156' param='vert' type-v2='layout-flow' w='27357' x='27929' y='27200'>
                  <zone h='23800' id='170' name='Recency' w='27357' x='27929' y='27200'>
                    <layout-cache cell-count-w='1' minheight='172' non-cell-size-w='66' type-h='scalable' type-w='cell' />
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
                    </zone-style>
                  </zone>
                  <zone forceUpdate='true' h='6200' id='157' type-v2='text' w='27357' x='27929' y='51000'>
                    <formatted-text>
                      <run bold='true' fontcolor='#1b1b1b' underline='true'>* Scores:</run>
                      <run fontcolor='#1b1b1b'> Time since the last shift</run>
                      <run>Æ&#10;</run>
                      <run bold='true' fontcolor='#1b1b1b'>1</run>
                      <run fontcolor='#1b1b1b'> == Active (at least 1 shift in the last 2 weeks)</run>
                      <run>Æ&#10;</run>
                      <run bold='true' fontcolor='#1b1b1b'>2</run>
                      <run fontcolor='#1b1b1b'> == At risk (no shift last week + current week, but one or more the week before)</run>
                      <run>Æ&#10;</run>
                      <run bold='true' fontcolor='#1b1b1b'>3 </run>
                      <run fontcolor='#1b1b1b'>== Churned (no shift for the past 4-8 weeks)</run>
                    </formatted-text>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
                    </zone-style>
                  </zone>
