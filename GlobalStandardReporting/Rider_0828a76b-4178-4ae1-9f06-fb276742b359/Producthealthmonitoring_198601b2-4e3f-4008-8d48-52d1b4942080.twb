            <properties context=''>
              <relation connection='bigquery.0onc3x714z7wd219qwkqt0cbvarg' name='Custom SQL Query' type='text'>SELECT
  *,
  LAG(completed_orders, 7) OVER w AS completed_orders_prev_week,
  LAG(completed_deliveries, 7) OVER w AS completed_deliveries_prev_week,
  LAG(deliveries, 7) OVER w AS deliveries_prev_week,
  LAG(orders, 7) OVER w AS orders_prev_week,
  LAG(dt, 7) OVER w AS dt_prev_week,
  LAG(pending, 7) OVER w AS pending_prev_week,
  LAG(queued, 7) OVER w AS queued_prev_week,
  LAG(near_pickup, 7) OVER w AS near_pickup_prev_week,
  LAG(completed, 7) OVER w AS completed_prev_week,
  LAG(cancelled, 7) OVER w AS cancelled_prev_week,
  LAG(near_dropoff, 7) OVER w AS near_dropoff_prev_week,
  LAG(courier_notified, 7) OVER w AS courier_notified_prev_week,
  LAG(scheduled, 7) OVER w AS scheduled_prev_week,
  LAG(left_pickup, 7) OVER w AS left_pickup_prev_week,
  LAG(dispatched, 7) OVER w AS dispatched_prev_week,
  LAG(picked_up, 7) OVER w AS picked_up_prev_week,
  LAG(accepted, 7) OVER w AS accepted_prev_week,
  LAG(order_early_5, 7) OVER w AS order_early_5_prev_week,
  LAG(order_early_10, 7) OVER w AS order_early_10_prev_week,
  LAG(order_late_5, 7) OVER w AS order_late_5_prev_week,
  LAG(order_late_10, 7) OVER w AS order_late_10_prev_week,
  LAG(to_queued, 7) OVER w AS to_queued_prev_week,
  LAG(to_first_dispatch, 7) OVER w AS to_first_dispatch_prev_week,
  LAG(dispatching_time, 7) OVER w AS dispatching_time_prev_week,
  LAG(rider_reaction_time, 7) OVER w AS rider_reaction_time_prev_week,
  LAG(to_vendor_time, 7) OVER w AS to_vendor_time_prev_week,
  LAG(at_vendor_time, 7) OVER w AS at_vendor_time_prev_week,
  LAG(to_customer_time, 7) OVER w AS to_customer_time_prev_week,
  LAG(issues, 7) OVER w AS issues_prev_week,
  LAG(stacked, 7) OVER w AS stacked_prev_week,
  LAG(riders, 7) OVER w AS riders_prev_week,
FROM `fulfillment-dwh-production.rl.pa_optimisation_product_health_monitoring`
WHERE created_date &gt;&gt;= CURRENT_DATE() - 37
WINDOW w AS (
  PARTITION BY
    subtable,
    region,
    country_code,
    city_id,
    vertical_type,
    is_preorder,
    full_utilisation,
    wait_for_assembled
  ORDER BY created_date)</relation>
            </properties>
