    <worksheet name='Transitions by country'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Order state transitions per delivery – diff from previous week</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='with_prev_week' name='federated.0til7z61tf4gqf18qfciq0mbscw9' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date' datatype='date' name='[Parameter 1]' param-domain-type='any' role='measure' type='quantitative' value='#2023-02-27#'>
              <calculation class='tableau' formula='#2023-02-27#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0til7z61tf4gqf18qfciq0mbscw9'>
            <column caption='Near pickup' datatype='real' name='[Accepted (copy)_3550032824064098317]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([near_pickup])/SUM([deliveries]) - SUM([near_pickup_prev_week])/SUM([deliveries_prev_week]))&#10;/&#10;(SUM([near_pickup_prev_week])/SUM([deliveries_prev_week]))' />
            </column>
            <column caption='Cancelled' datatype='real' name='[Completed (copy)_3550032824065875986]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([cancelled])/SUM([deliveries]) - SUM([cancelled_prev_week])/SUM([deliveries_prev_week]))&#10;/&#10;(SUM([cancelled_prev_week])/SUM([deliveries_prev_week]))' />
            </column>
            <column caption='Accepted' datatype='real' name='[Courier notified (copy)_3550032824062525451]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([accepted])/SUM([deliveries]) - SUM([accepted_prev_week])/SUM([deliveries_prev_week]))&#10;/&#10;(SUM([accepted_prev_week])/SUM([deliveries_prev_week]))' />
            </column>
            <column caption='Near dropoff' datatype='real' name='[Left pickup (copy)_3550032824065171472]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([near_dropoff])/SUM([deliveries]) - SUM([near_dropoff_prev_week])/SUM([deliveries_prev_week]))&#10;/&#10;(SUM([near_dropoff_prev_week])/SUM([deliveries_prev_week]))' />
            </column>
            <column caption='Completed' datatype='real' name='[Near dropoff (copy)_3550032824065486865]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([completed])/SUM([deliveries]) - SUM([completed_prev_week])/SUM([deliveries_prev_week]))&#10;/&#10;(SUM([completed_prev_week])/SUM([deliveries_prev_week]))' />
            </column>
            <column caption='Picked up' datatype='real' name='[Near pickup (copy)_3550032824064434190]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([picked_up])/SUM([deliveries]) - SUM([picked_up_prev_week])/SUM([deliveries_prev_week]))&#10;/&#10;(SUM([picked_up_prev_week])/SUM([deliveries_prev_week]))' />
            </column>
            <column caption='Scheduled' datatype='real' name='[Pending (copy)_3550032824066457620]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([scheduled])/SUM([deliveries]) - SUM([scheduled_prev_week])/SUM([deliveries_prev_week]))&#10;/&#10;(SUM([scheduled_prev_week])/SUM([deliveries_prev_week]))' />
            </column>
            <column caption='Left pickup' datatype='real' name='[Picked up (copy)_3550032824064954383]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([left_pickup])/SUM([deliveries]) - SUM([left_pickup_prev_week])/SUM([deliveries_prev_week]))&#10;/&#10;(SUM([left_pickup_prev_week])/SUM([deliveries_prev_week]))' />
            </column>
            <column caption='Dispatched' datatype='real' name='[Queued (copy)_3550032824060817417]' role='measure' type='quantitative'>
