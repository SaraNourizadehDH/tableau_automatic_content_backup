  <worksheets>
    <worksheet name='Basic metrics'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Logistics metrics vs Logistics metrics previous week</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='with_prev_week' name='federated.0til7z61tf4gqf18qfciq0mbscw9' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date' datatype='date' name='[Parameter 1]' param-domain-type='any' role='measure' type='quantitative' value='#2023-02-27#'>
              <calculation class='tableau' formula='#2023-02-27#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0til7z61tf4gqf18qfciq0mbscw9'>
            <column caption='Stacked diff' datatype='real' name='[Calculation_159948215919276032]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([stacked])/SUM([orders]) - SUM([stacked_prev_week])/SUM([orders_prev_week]))&#10;/&#10;(SUM([stacked_prev_week])/SUM([orders_prev_week]))' />
            </column>
            <column caption='Stacked' datatype='real' name='[Calculation_159948215920300033]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([stacked])/SUM([orders])' />
            </column>
            <column caption='Order diff' datatype='real' name='[Calculation_302796754887217152]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([orders]) - SUM([orders_prev_week]))/SUM([orders_prev_week])' />
            </column>
            <column caption='Order early &gt;10' datatype='real' name='[Calculation_302796754955755521]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_early_10])/SUM([completed_orders])' />
            </column>
            <column caption='Order late &gt;10' datatype='real' name='[Calculation_302796754956091394]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_late_10])/SUM([completed_orders])' />
            </column>
            <column caption='Order early &gt;10 last week' datatype='real' name='[Calculation_302796754956238851]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_early_10_prev_week])/SUM([completed_orders_prev_week])' />
            </column>
            <column caption='Order late &gt;10 last week' datatype='real' name='[Calculation_302796754956435460]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_late_10_prev_week])/SUM([completed_orders_prev_week])' />
            </column>
            <column caption='Order early &gt;10 diff' datatype='real' name='[Calculation_302796754956537861]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_302796754955755521] - [Calculation_302796754956238851])/[Calculation_302796754956238851]' />
            </column>
            <column caption='Order late &gt;10 diff' datatype='real' name='[Calculation_302796754956693510]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_302796754956091394] - [Calculation_302796754956435460])/[Calculation_302796754956435460]' />
            </column>
            <column caption='DT' datatype='real' name='[Calculation_4827718109674016774]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF NOT [is_preorder] THEN [dt] ELSE 0 END)&#10;/&#10;SUM(IF NOT [is_preorder] THEN [completed_orders] ELSE 0 END)' />
            </column>
            <column caption='Fail rate' datatype='real' name='[Calculation_4827718109928534039]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders] - [completed_orders])/SUM([orders])' />
            </column>
            <column caption='DT diff' datatype='real' name='[DT (copy)_4827718109928030230]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_4827718109674016774] - [DT (copy)_4827718109930623002])/[DT (copy)_4827718109930623002]' />
            </column>
            <column caption='DT last week' datatype='real' name='[DT (copy)_4827718109930623002]' role='measure' type='quantitative'>
