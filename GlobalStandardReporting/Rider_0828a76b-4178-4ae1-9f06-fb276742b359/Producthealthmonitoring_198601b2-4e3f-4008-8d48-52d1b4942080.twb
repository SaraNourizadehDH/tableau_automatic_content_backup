        <calculation class='tableau' formula='(SUM([completed])/SUM([deliveries]) - SUM([completed_prev_week])/SUM([deliveries_prev_week]))&#10;/&#10;(SUM([completed_prev_week])/SUM([deliveries_prev_week]))' />
      </column>
      <column caption='Picked up' datatype='real' name='[Near pickup (copy)_3550032824064434190]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([picked_up])/SUM([deliveries]) - SUM([picked_up_prev_week])/SUM([deliveries_prev_week]))&#10;/&#10;(SUM([picked_up_prev_week])/SUM([deliveries_prev_week]))' />
      </column>
      <column caption='Scheduled' datatype='real' name='[Pending (copy)_3550032824066457620]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([scheduled])/SUM([deliveries]) - SUM([scheduled_prev_week])/SUM([deliveries_prev_week]))&#10;/&#10;(SUM([scheduled_prev_week])/SUM([deliveries_prev_week]))' />
      </column>
      <column caption='Left pickup' datatype='real' name='[Picked up (copy)_3550032824064954383]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([left_pickup])/SUM([deliveries]) - SUM([left_pickup_prev_week])/SUM([deliveries_prev_week]))&#10;/&#10;(SUM([left_pickup_prev_week])/SUM([deliveries_prev_week]))' />
      </column>
      <column caption='Dispatched' datatype='real' name='[Queued (copy)_3550032824060817417]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([dispatched])/SUM([deliveries]) - SUM([dispatched_prev_week])/SUM([deliveries_prev_week]))&#10;/&#10;(SUM([dispatched_prev_week])/SUM([deliveries_prev_week]))' />
      </column>
      <column caption='Courier notified' datatype='real' name='[Queued (copy)_3550032824062283786]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([courier_notified])/SUM([deliveries]) - SUM([courier_notified_prev_week])/SUM([deliveries_prev_week]))&#10;/&#10;(SUM([courier_notified_prev_week])/SUM([deliveries_prev_week]))' />
      </column>
      <column caption='Queued' datatype='real' name='[Queued per delivery last week (copy)_3550032824053936132]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([queued])/SUM([deliveries]) - SUM([queued_prev_week])/SUM([deliveries_prev_week]))&#10;/&#10;(SUM([queued_prev_week])/SUM([deliveries_prev_week]))' />
      </column>
      <column caption='Riders diff' datatype='real' name='[Riders last week (copy)_6743859032724889600]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([riders]) - SUM([riders_prev_week]))&#10;/&#10;SUM([riders_prev_week])' />
      </column>
      <column caption='Stacked last week' datatype='real' name='[Stacked (copy)_159948215920390146]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([stacked_prev_week])/SUM([orders_prev_week])' />
      </column>
      <column caption='Total dispatched diff' datatype='real' name='[Total queued diff (copy)_3550032824057053191]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([dispatched]) - SUM([dispatched_prev_week]))/SUM([dispatched_prev_week])' />
      </column>
