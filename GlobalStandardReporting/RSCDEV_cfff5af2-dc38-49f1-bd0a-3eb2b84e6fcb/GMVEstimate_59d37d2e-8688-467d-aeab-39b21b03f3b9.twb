    <datasource caption='Custom SQL Query (rl_sales_revenue)' inline='true' name='federated.0vnci1f1o4prl9143yl7c0g82pf0' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0qs61v11gfddf71c2de1k13suqvv'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dh-vt-rsc-6006' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='rl_sales_revenue' server-oauth='' username='johann.grobler@deliveryhero.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0qs61v11gfddf71c2de1k13suqvv' name='Custom SQL Query' type='text'><![CDATA[WITH currency_value AS (
  SELECT currency_code
    , fx_rate_eur AS value
  FROM `fulfillment-dwh-production.curated_data_shared_central_dwh.fx_rates` aa
  WHERE currency_code = 'USD'
  AND aa.fx_rate_date = DATE_SUB(CAST(current_date() AS DATE), INTERVAL 1 DAY)
), Shopify_data AS (
  SELECT a.account_name
    , a.id
    , a.total_price_usd
    , COUNT (DISTINCT cc.product_id) AS No_Products
    , SUM(cc.quantity) AS Quantity
  FROM `fulfillment-dwh-production.dl_sales_revenue.shopify_orders` a
    , UNNEST(a.line_items) cc
  WHERE a.account_name IS NOT NULL
    AND tags LIKE '%app_created%'
    AND cast(date_trunc(a.created_at,WEEK(MONDAY)) as date) >>= Date_sub(current_date(), interval 3 month)
  GROUP BY 1,2,3
), RSC_Shopify AS (
  SELECT a.entity_id
    , a.name
    , a.restaurant_id
    , c.code as supp_code
    , a.supplier_id
    , ee.code as rest_code
    , ee.name as restaurant_name
    , c.name as supplier_name
    , a.id
    , DATE(a.created_at) AS created_at
    , DATE_TRUNC(DATE(a.created_at), month) AS created_at_month
    , cast(date_trunc(a.created_at,WEEK(MONDAY)) as date) as Week_date
    , a.Hide_prices
    , b.No_products
    , b.Quantity
    , b.total_price_usd/ dd.value AS total_price_eu
    , dd.value
  FROM`fulfillment-dwh-production.dl_sales_revenue.rsc_app_data_orders` a 
  INNER JOIN `fulfillment-dwh-production.dl_sales_revenue.rsc_app_data_suppliers` c
  ON a.entity_id = c.entity_id
    AND c.id = a.supplier_id
  INNER JOIN `fulfillment-dwh-production.dl_sales_revenue.rsc_app_data_restaurants` ee
  ON ee.id = a.restaurant_id
    AND ee.region = a.region
  INNER JOIN Shopify_data b 
  ON CAST(a.source_id AS int64) = b.id
  CROSS JOIN currency_value dd
  WHERE cast(date_trunc(a.created_at,WEEK(MONDAY)) as date) >>= Date_sub(current_date(), interval 3 month)
    AND a.status NOT LIKE '%cancel%'
    AND a.status not like '%rejected%'
    AND c.name not like '%stock_balance%'
    AND a.deleted = FALSE
    AND NOT CONTAINS_SUBSTR(LOWER(c.name), 'test_') 
    AND (
      (a.entity_id = 'FP_HK' AND LOWER(c.name) NOT LIKE '%foodpanda rest%') 
      OR a.entity_id = 'FP_SG' 
      OR (a.entity_id = 'MJM_AT' AND LOWER(c.name) NOT LIKE '%mjam%') 
      OR (
        a.entity_id= 'PY_CL' 
        AND LOWER(c.name) <<>>'efe test supplier' 
        AND LOWER(c.name) <<>> 'valentin cl email' 
        AND a.created_at >> '2022-01-16'
      )
      OR a.entity_id = 'FP_MY'
      OR a.entity_id = 'FP_TH'
    )
    AND DATE(a.merge_layer_updated_at) >> '2022-11-01'
), pre_final AS (
  SELECT a.entity_id
    , a.week_date
    , a.restaurant_id
    , a.rest_code
    , a.restaurant_name
    , a.supplier_id
    , a.supp_code
    , a.supplier_name
    , COUNT (
        CASE 
          WHEN Hide_prices = FALSE
            THEN 1 
        END) AS total_orders_show_price
    , COALESCE(SUM (
        CASE 
          WHEN Hide_prices = FALSE
            THEN total_price_eu 
        END),0) AS Total_eu_value_show_price
    , COALESCE(COUNT (
        CASE
          WHEN Hide_prices = TRUE
            THEN 1 
        END),0) AS Total_Orders_Hide_price
    , AVG(Quantity) AS avg_qty_per_order
    , AVG(No_products) AS avg_no_distinct_products_per_order
  FROM RSC_Shopify a

  GROUP BY 1,2,3,4,5,6,7,8
), window_rollup as (
SELECT*,
sum(total_orders_show_price) over (partition by entity_id, restaurant_id) as total_orders_show_price_rest
, sum(Total_Orders_Hide_price) over (partition by entity_id, restaurant_id) as total_orders_hide_price_rest
, sum(total_orders_show_price) over (partition by entity_id, supplier_id) as total_orders_show_price_supp
, sum(Total_Orders_Hide_price) over (partition by entity_id, supplier_id) as total_orders_hide_price_supp

, sum(total_orders_show_price) over (partition by entity_id, supplier_id, restaurant_id) as total_orders_show_price_rest_supp
, sum(Total_Orders_Hide_price) over (partition by entity_id, supplier_id, restaurant_id) as total_orders_hide_price_rest_supp
FROM pre_final
WHERE Week_date >> Date_sub(current_date(), interval 3 month)
)
select *,
cast(total_orders_show_price_rest / (total_orders_show_price_rest + total_orders_hide_price_rest) AS numeric) as L3M_rest_show_price,
CAST(total_orders_show_price_supp / (total_orders_show_price_supp + total_orders_hide_price_supp) AS NUMERIC) as L3M_supp_show_price,
CAST(total_orders_show_price_rest_supp / (total_orders_show_price_rest_supp + total_orders_hide_price_rest_supp) AS NUMERIC) as L3M_rest_supp_show_price
FROM window_rollup]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
