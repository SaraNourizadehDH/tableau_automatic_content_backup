    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Defintions and Scope For GMV Estimation'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/GMVEstimate/DefintionsandScopeForGMVEstimation?rev=' id='DefintionsandScopeForGMVEstimation' path='/t/GlobalStandardReporting/workbooks/GMVEstimate_16826036966920' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='768' maxwidth='1366' minheight='768' minwidth='1366' preset-index='0' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='97916' id='3' type-v2='text' w='98828' x='586' y='1042'>
            <formatted-text>
              <run bold='true' fontsize='18'>Definitions</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontsize='14' underline='true'>Applicable to All Entities (excluding MJAM_AT):</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontsize='11'>Orders showing prices:</run>
              <run fontsize='11'> The order </run>
              <run fontsize='11' underline='true'>has not</run>
              <run fontsize='11'> been flagged to &apos;hide prices&apos; and thus the total order value is visible</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontsize='11'>Orders hiding prices:</run>
              <run fontsize='11'> The order </run>
              <run fontsize='11' underline='true'>has</run>
              <run fontsize='11'> been flagged to &apos;hide prices&apos; and thus no reliable price information is available</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontsize='11'>Total GMV estimate for Orders showing prices:</run>
              <run fontsize='11'> The total monetary value of all orders showing prices</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontsize='11'>Total GMV estimate  for Orders hiding prices: </run>
              <run>Æ&#10;</run>
              <run fontsize='11'>(The monthly average order value for all orders that show prices) X (Total number of orders hiding price)</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontsize='11'>Average Order Value (AOV) for Orders showing price</run>
              <run fontsize='11'>: (The total monetary value of all orders showing prices) / (Total orders showing price)</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontsize='11'>Average Order Value (AOV) for  Orders hiding price: </run>
              <run fontsize='11'> Use the same average as Orders showing price</run>
              <run>Æ&#10;&#10;&#10;</run>
              <run bold='true' fontsize='14' underline='true'>MJAM_AT Specific:</run>
              <run>Æ&#10;</run>
              <run fontsize='11'>Context: MJAM has 90%+ orders not showing prices and estimating any accurate value for MJAM is currently not achievable.</run>
              <run>Æ&#10;&#10;</run>
              <run fontsize='11'>Order Value estimation method: </run>
              <run>Æ&#10;</run>
              <run fontsize='11'>For MJAM an Average order value is calculated quarterly by using the following  method:</run>
              <run>Æ&#10;</run>
              <run fontsize='11'>1. Sampling the contribution of different item categories in orders</run>
              <run>Æ&#10;</run>
              <run fontsize='11'>2. Sampling actual invoices to estimate an average order value per category</run>
              <run>Æ&#10;</run>
              <run fontsize='11'>3. Building the estimated average order value by multiplying the category contribution by estimated category order value</run>
              <run>Æ&#10;&#10;&#10;</run>
              <run bold='true' fontsize='11'>Total GMV estimate for Orders showing prices:</run>
              <run fontsize='11'> ( Estimated order value from estimation method) X Total number of orders showing price</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontsize='11'>Total GMV estimate  for Orders hiding prices:  </run>
              <run fontsize='11'>( Estimated order value from estimation method) X (Total number of orders hiding price)</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontsize='11'>Average Order Value (AOV) for Orders showing price</run>
              <run fontsize='11'>: Exact number as estimated from estimation method</run>
              <run>Æ&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='128' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='97916' id='127' param='vert' type-v2='layout-flow' w='98828' x='586' y='1042'>
                <zone forceUpdate='true' h='97916' id='3' type-v2='text' w='98828' x='586' y='1042'>
                  <formatted-text>
                    <run bold='true' fontsize='18'>Definitions</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontsize='14' underline='true'>Applicable to All Entities (excluding MJAM_AT):</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontsize='11'>Orders showing prices:</run>
                    <run fontsize='11'> The order </run>
                    <run fontsize='11' underline='true'>has not</run>
                    <run fontsize='11'> been flagged to &apos;hide prices&apos; and thus the total order value is visible</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontsize='11'>Orders hiding prices:</run>
                    <run fontsize='11'> The order </run>
                    <run fontsize='11' underline='true'>has</run>
                    <run fontsize='11'> been flagged to &apos;hide prices&apos; and thus no reliable price information is available</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontsize='11'>Total GMV estimate for Orders showing prices:</run>
                    <run fontsize='11'> The total monetary value of all orders showing prices</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontsize='11'>Total GMV estimate  for Orders hiding prices: </run>
                    <run>Æ&#10;</run>
                    <run fontsize='11'>(The monthly average order value for all orders that show prices) X (Total number of orders hiding price)</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontsize='11'>Average Order Value (AOV) for Orders showing price</run>
                    <run fontsize='11'>: (The total monetary value of all orders showing prices) / (Total orders showing price)</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontsize='11'>Average Order Value (AOV) for  Orders hiding price: </run>
                    <run fontsize='11'> Use the same average as Orders showing price</run>
                    <run>Æ&#10;&#10;&#10;</run>
                    <run bold='true' fontsize='14' underline='true'>MJAM_AT Specific:</run>
                    <run>Æ&#10;</run>
                    <run fontsize='11'>Context: MJAM has 90%+ orders not showing prices and estimating any accurate value for MJAM is currently not achievable.</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontsize='11'>Order Value estimation method: </run>
                    <run>Æ&#10;</run>
                    <run fontsize='11'>For MJAM an Average order value is calculated quarterly by using the following  method:</run>
                    <run>Æ&#10;</run>
                    <run fontsize='11'>1. Sampling the contribution of different item categories in orders</run>
                    <run>Æ&#10;</run>
                    <run fontsize='11'>2. Sampling actual invoices to estimate an average order value per category</run>
                    <run>Æ&#10;</run>
                    <run fontsize='11'>3. Building the estimated average order value by multiplying the category contribution by estimated category order value</run>
                    <run>Æ&#10;&#10;&#10;</run>
                    <run bold='true' fontsize='11'>Total GMV estimate for Orders showing prices:</run>
                    <run fontsize='11'> ( Estimated order value from estimation method) X Total number of orders showing price</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontsize='11'>Total GMV estimate  for Orders hiding prices:  </run>
                    <run fontsize='11'>( Estimated order value from estimation method) X (Total number of orders hiding price)</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontsize='11'>Average Order Value (AOV) for Orders showing price</run>
                    <run fontsize='11'>: Exact number as estimated from estimation method</run>
                    <run>Æ&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
      <simple-id uuid='{DBDA08EC-2D2F-4EE6-A211-5F77908C0301}' />
    </dashboard>
    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Defintions and Scope for Details Views'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/GMVEstimate/DefintionsandScopeforDetailsViews?rev=' id='DefintionsandScopeforDetailsViews' path='/t/GlobalStandardReporting/workbooks/GMVEstimate_16826036966920' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='768' maxwidth='1366' minheight='768' minwidth='1366' preset-index='0' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='97916' id='3' type-v2='text' w='98828' x='586' y='1042'>
            <formatted-text>
              <run>Æ&#10;</run>
              <run bold='true' fontsize='18'>Scope &amp; Definitions for Restaurant, Supplier and Restaurant-Supplier Detail views:</run>
              <run>Æ&#10;&#10;&#10;</run>
              <run bold='true' fontsize='18'>Scope:</run>
              <run>Æ&#10;</run>
              <run fontsize='12'>Only orders that</run>
              <run bold='true' fontsize='12'> show prices</run>
              <run fontsize='12'> are included in the 3 details views</run>
              <run>Æ&#10;</run>
              <run fontsize='12'>Data is displayed on a weekly level for the latest running 3 months</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontsize='18'>Definitions:</run>
              <run>Æ&#10;</run>
              <run fontsize='12'>L3M_show_price: % of Total orders placed that showed prices</run>
              <run>Æ&#10;</run>
              <run fontsize='12'>L3M_total: Total Euro value of GMV generated for all orders that showed prices</run>
              <run>Æ&#10;&#10;&#10;&#10;&#10;&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
