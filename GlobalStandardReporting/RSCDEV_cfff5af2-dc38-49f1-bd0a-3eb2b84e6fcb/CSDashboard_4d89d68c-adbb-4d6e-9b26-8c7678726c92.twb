      <column datatype='string' name='[Account_owner]' role='dimension' type='nominal' />
      <column datatype='real' default-format='p0.00%' name='[Calculation3]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([vendor_id]) / TOTAL(COUNT([vendor_id]))'>
          <table-calc ordering-type='Columns' />
        </calculation>
      </column>
      <column caption='Acc_manager_assigned' datatype='string' name='[Calculation_182677290186887168]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if ISNULL([Account_owner]) &#13;&#10;then &quot;NO&quot;&#13;&#10;else &quot;YES&quot;&#13;&#10;END' />
        <aliases>
          <alias key='&quot;NO&quot;' value='Not-Assigned' />
          <alias key='&quot;YES&quot;' value='Assigned' />
        </aliases>
      </column>
      <column caption='Supplier_Cat' datatype='string' name='[Calculation_282882410295988225]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Suppliers_for_active_rests] &lt; 10&#13;&#10;then STR([Suppliers_for_active_rests])&#13;&#10;else   &quot;10+&quot;&#13;&#10;END' />
      </column>
      <column caption='Assigned_acc_manager' datatype='string' name='[Calculation_468374389087035392]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if NOT ISNULL([Account_owner])and [Account_owner] &lt;&gt; &apos;&apos;&#13;&#10;then  [vendor_code]&#13;&#10;else null&#13;&#10;END' />
      </column>
      <column caption='Count_D_acc_manager' datatype='integer' name='[Calculation_468374389088473090]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_468374389087035392])' />
      </column>
      <column aggregation='Sum' caption='Active_Flag' datatype='integer' name='[Calculation_468374389141405700]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if [report_date]&gt;= [rest_activation_date]&#13;&#10;then 1&#13;&#10;else 0&#13;&#10;end' />
      </column>
      <column caption='Prev End Date' datatype='date' name='[Calculation_468374389148811269]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATEADD(&apos;week&apos;,-1,[latest_reporting_date]))' />
      </column>
      <column caption='Range' datatype='boolean' name='[Calculation_468374389149868041]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1] = true&#13;&#10;then&#13;&#10;[report_date]&lt;= [latest_reporting_date] AND [report_date]&gt;= [Calculation_468374389150138378]&#13;&#10;else &#13;&#10;[report_date]&lt; [latest_reporting_date] AND [report_date]&gt;= [Calculation_468374389150138378]&#13;&#10;END' />
      </column>
      <column caption='Start Date' datatype='date' name='[Calculation_468374389150138378]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATEADD(&apos;week&apos;,-[Parameters].[Parameter 2],[latest_reporting_date]))' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_468374389158268939]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = username()' />
      </column>
      <column caption='Rests_per_type' datatype='integer' name='[Calculation_837951031788548096]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([vendor_id])' />
      </column>
      <column caption='Unique_vendor_code' datatype='string' name='[Calculation_837951032108294148]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[vendor_code]+ [global_entity_id]' />
      </column>
      <column caption='Count_D_Unique_Vendor_Code' datatype='integer' name='[Calculation_837951032108400645]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_837951032108294148])' />
      </column>
      <column caption='Active_flag' datatype='string' name='[Calculation_837951032116666374]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if DATEDIFF(&apos;week&apos;,[max_prev_order],[report_date]) = 0&#13;&#10;then &apos;Active&apos;&#13;&#10;ELSEIF  DATEDIFF(&apos;week&apos;,[max_prev_order],[report_date]) = 1&#13;&#10;then &apos;Prev_wk_active&apos;&#13;&#10;ELSEIF  DATEDIFF(&apos;week&apos;,[max_prev_order],[report_date]) &gt; 1 and DATEDIFF(&apos;week&apos;,[max_prev_order],[report_date]) &lt; 5&#13;&#10;then &apos;re-engage&apos;&#13;&#10;else &apos;churn&apos;&#13;&#10;END' />
        <aliases>
          <alias key='&quot;churn&quot;' value='Churned' />
          <alias key='&quot;re-engage&quot;' value='Re-engage' />
        </aliases>
      </column>
