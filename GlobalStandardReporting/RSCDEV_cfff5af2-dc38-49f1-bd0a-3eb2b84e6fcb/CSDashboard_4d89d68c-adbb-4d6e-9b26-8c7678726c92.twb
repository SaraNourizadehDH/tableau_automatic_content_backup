            <column caption='Assigned_acc_manager' datatype='string' name='[Calculation_468374389087035392]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if NOT ISNULL([Account_owner])and [Account_owner] &lt;&gt; &apos;&apos;&#13;&#10;then  [vendor_code]&#13;&#10;else null&#13;&#10;END' />
            </column>
            <column aggregation='Sum' caption='Active_Flag' datatype='integer' name='[Calculation_468374389141405700]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if [report_date]&gt;= [rest_activation_date]&#13;&#10;then 1&#13;&#10;else 0&#13;&#10;end' />
            </column>
            <column caption='Range' datatype='boolean' name='[Calculation_468374389149868041]' role='dimension' type='nominal'>
