            <column caption='Supplier_Cat' datatype='string' name='[Calculation_282882410295988225]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Suppliers_for_active_rests] &lt; 10&#13;&#10;then STR([Suppliers_for_active_rests])&#13;&#10;else   &quot;10+&quot;&#13;&#10;END' />
            </column>
            <column caption='Range' datatype='boolean' name='[Calculation_468374389149868041]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = true&#13;&#10;then&#13;&#10;[report_date]&lt;= [latest_reporting_date] AND [report_date]&gt;= [Calculation_468374389150138378]&#13;&#10;else &#13;&#10;[report_date]&lt; [latest_reporting_date] AND [report_date]&gt;= [Calculation_468374389150138378]&#13;&#10;END' />
