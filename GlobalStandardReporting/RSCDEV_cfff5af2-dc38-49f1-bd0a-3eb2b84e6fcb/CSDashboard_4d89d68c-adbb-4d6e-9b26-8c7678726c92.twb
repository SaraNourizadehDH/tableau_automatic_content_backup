    <worksheet name='Supp CatPerc'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='11'>Percentage of active rests ordering from </run>
            <run bold='true' fontcolor='#4e79a7' fontsize='11'>1</run>
            <run bold='true' fontsize='11'> - </run>
            <run bold='true' fontcolor='#bab0ac' fontsize='11'>10+</run>
            <run bold='true' fontsize='11'> suppliers</run>
          </formatted-text>
        </title>
      </layout-options>
