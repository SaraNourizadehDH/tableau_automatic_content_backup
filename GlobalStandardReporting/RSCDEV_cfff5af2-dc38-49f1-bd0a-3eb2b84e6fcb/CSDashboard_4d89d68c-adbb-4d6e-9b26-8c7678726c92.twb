            <column caption='Unique_vendor_code' datatype='string' name='[Calculation_837951032108294148]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[vendor_code]+ [global_entity_id]' />
            </column>
            <column caption='Count_D_Unique_Vendor_Code' datatype='integer' name='[Calculation_837951032108400645]' role='measure' type='quantitative'>
