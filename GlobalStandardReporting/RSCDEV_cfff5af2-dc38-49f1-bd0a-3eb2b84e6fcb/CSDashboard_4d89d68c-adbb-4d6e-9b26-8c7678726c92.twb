    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Definitions'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/CSDashboard_16514821209560/Definitions?rev=' id='Definitions' path='/t/GlobalStandardReporting/workbooks/CSDashboard' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='768' maxwidth='1366' minheight='768' minwidth='1366' preset-index='0' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='97916' id='3' type-v2='text' w='98828' x='586' y='1042'>
            <formatted-text>
              <run bold='true' fontcolor='#555555' fontsize='18'>Definitions: Main CS Dashboard</run>
              <run>Æ&#10;</run>
              <run bold='true' fontsize='12'>Context and scope:</run>
              <run>Æ&#10;</run>
              <run fontsize='10'>&gt; Restaurants - Only previously activated restaurants are included in all metrics (Restaurants after their 2nd order day)</run>
              <run>Æ&#10;</run>
              <run fontsize='10'>&gt; Orders: Cancelled and deleted  orders are removed from all numbers</run>
              <run>Æ&#10;</run>
              <run fontsize='10'>&gt; Suppliers: All test suppliers are removed from all metrics</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#555555' fontsize='12'>Chart 1: Total Orders from Active Restaurants:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555' fontsize='10'>&gt; Total orders placed by restaurants who have previously been activated</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#555555' fontsize='12'>Chart 2: Avg Orders and Avg number of suppliers per active rest:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555' fontsize='10'>&gt; Average orders placed by restaurants who have been previously activated</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555' fontsize='10'>&gt; Distinct number of suppliers order from restaurants who have been previously activated</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#555555' fontsize='12'>Chart 3: Rest activity status with Assigned AMs:</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#555555' fontsize='10'>&gt; Context - only activated restaurants who also have an assigned account manager are in this view</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#555555' fontsize='10'>&gt; Metric definition:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555' fontsize='10'>                   &gt; Active - last order placed in the current calendar week</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555' fontsize='10'>                   &gt; Prev_wk_active - last order placed in the previous calendar week</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555' fontsize='10'>                   &gt; Re-engage - last order placed before the previous calendar week but within 4 calendar weeks ago</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555' fontsize='10'>                   &gt; Churned: Last order place more than 4 weeks ago</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#555555' fontsize='12'>Chart 4: New Rest-Supplier relationships activated</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555' fontsize='10'>&gt; The metric counts new distinct suppliers that a restaurant placed an uncancelled order from</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#555555' fontsize='12'>Chart 5: Total active rests ordering from 1 - 10+ suppliers</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555' fontsize='10'>&gt; % of total active restaurants who are ordering from 1- 10+ distinct supplier per calendar week</run>
              <run>Æ&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='80' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='97916' id='79' param='vert' type-v2='layout-flow' w='98828' x='586' y='1042'>
                <zone forceUpdate='true' h='97916' id='3' type-v2='text' w='98828' x='586' y='1042'>
                  <formatted-text>
                    <run bold='true' fontcolor='#555555' fontsize='18'>Definitions: Main CS Dashboard</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontsize='12'>Context and scope:</run>
                    <run>Æ&#10;</run>
                    <run fontsize='10'>&gt; Restaurants - Only previously activated restaurants are included in all metrics (Restaurants after their 2nd order day)</run>
                    <run>Æ&#10;</run>
                    <run fontsize='10'>&gt; Orders: Cancelled and deleted  orders are removed from all numbers</run>
                    <run>Æ&#10;</run>
                    <run fontsize='10'>&gt; Suppliers: All test suppliers are removed from all metrics</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#555555' fontsize='12'>Chart 1: Total Orders from Active Restaurants:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#555555' fontsize='10'>&gt; Total orders placed by restaurants who have previously been activated</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#555555' fontsize='12'>Chart 2: Avg Orders and Avg number of suppliers per active rest:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#555555' fontsize='10'>&gt; Average orders placed by restaurants who have been previously activated</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#555555' fontsize='10'>&gt; Distinct number of suppliers order from restaurants who have been previously activated</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#555555' fontsize='12'>Chart 3: Rest activity status with Assigned AMs:</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#555555' fontsize='10'>&gt; Context - only activated restaurants who also have an assigned account manager are in this view</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#555555' fontsize='10'>&gt; Metric definition:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#555555' fontsize='10'>                   &gt; Active - last order placed in the current calendar week</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#555555' fontsize='10'>                   &gt; Prev_wk_active - last order placed in the previous calendar week</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#555555' fontsize='10'>                   &gt; Re-engage - last order placed before the previous calendar week but within 4 calendar weeks ago</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#555555' fontsize='10'>                   &gt; Churned: Last order place more than 4 weeks ago</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#555555' fontsize='12'>Chart 4: New Rest-Supplier relationships activated</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#555555' fontsize='10'>&gt; The metric counts new distinct suppliers that a restaurant placed an uncancelled order from</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#555555' fontsize='12'>Chart 5: Total active rests ordering from 1 - 10+ suppliers</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#555555' fontsize='10'>&gt; % of total active restaurants who are ordering from 1- 10+ distinct supplier per calendar week</run>
                    <run>Æ&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
      <simple-id uuid='{5D2657FB-3CB7-44E7-B3A8-65CA9595872C}' />
    </dashboard>
