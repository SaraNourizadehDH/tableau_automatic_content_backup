      <filter class='categorical' column='[global_entity_id]' filter-group='2'>
        <groupfilter expression='ISNULL([global_entity_id]) OR (NOT(CONTAINS(LOWER([global_entity_id]), LOWER(&apos;FP_TH&apos;))))' function='filter' user:ui-enumeration='exclusive' user:ui-pattern-include-all-when-empty='true' user:ui-pattern_text='FP_TH' user:ui-pattern_type='contains'>
          <groupfilter function='level-members' level='[global_entity_id]' user:ui-enumeration='all' user:ui-marker='enumerate' />
        </groupfilter>
