      <aliases enabled='yes' />
      <column caption='Shop Position trimmed' datatype='integer' name='[Calculation_1696238636379131904]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF ISNULL([shop_position]) THEN NULL&#10;ELSEIF [shop_position] &lt; 15 THEN [shop_position]&#10;ELSE 99 END' />
      </column>
      <column caption='Entity Id (in exp)' datatype='string' name='[Calculation_1696238636471484421]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF(NOT ISNULL([variant]),[global_entity_id],NULL)' />
      </column>
      <column caption='Target Placement' datatype='string' name='[Calculation_1696238636642746384]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [placement_screen] IN (&apos;shop_list&apos;, &apos;shop_list_cusine&apos;) THEN &apos;Vendor list&apos;&#10;ELSEIF [placement_screen] IN (&apos;search&apos;, &apos;home_search&apos;) THEN &apos;Search placements&apos;&#10;ELSEIF [placement_type] IN (&apos;swimlane&apos;, &apos;swimlane_feature_cpc&apos;, &apos;swimlane_item&apos;) THEN &apos;Swimlanes&apos;&#10;ELSEIF [placement_screen] = &apos;home&apos; THEN &apos;Home&apos;&#10;ELSE &apos;other&apos; END' />
      </column>
      <column caption='Macro entity' datatype='string' name='[Calculation_3575998899891060736]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='REGEXP_EXTRACT([global_entity_id], &apos;([a-zA-Z]*)&apos;)' />
      </column>
      <column caption='Entity' datatype='string' name='[Calculation_3575998899906519041]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&apos;Entity&apos; THEN [global_entity_id] ELSE &apos;&apos; END' />
      </column>
