      <aliases enabled='yes' />
      <column caption='% budget achieved cumulative' datatype='real' name='[% budget achieved (copy)_30891927091773441]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//sum(ZN([Total Cpc Revenue]))/sum(ZN([Total Budget]))&#10;AVG([cumulative_cpc_revenue 1]) / sum([total_budget])' />
      </column>
      <column caption='% cpc clicks 1' datatype='real' name='[% cpc clicks (copy)_3717932652310880257]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[total_cpc_clicks] / [total_clicks]' />
      </column>
      <column caption='weekend' datatype='string' name='[Calculation_1517642751312367616]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Partition Date (Weekdays)] = 7 OR [Partition Date (Weekdays)] = 1 THEN &apos;Weekend&apos;&#10;elseif NOT ([Partition Date (Weekdays)] = 7 OR [Partition Date (Weekdays)] = 1) THEN &apos;Workday&apos;&#10;ENd' />
      </column>
      <column caption='% cpc clicks' datatype='real' name='[Calculation_1517642751561314306]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_cpc_clicks]) / SUM([total_clicks])' />
      </column>
      <column caption='Date Aggregation' datatype='date' name='[Calculation_1517642751584505860]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Month&apos; THEN [Partition Date (Months)]&#10;WHEN &apos;Week&apos; THEN [Partition Date (Weeks)]&#10;WHEN &apos;Day&apos; THEN [Partition Date (Days)]&#10;END' />
      </column>
      <column caption='% budget achieved' datatype='real' name='[Calculation_1517642751604723717]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//sum(ZN([Total Cpc Revenue]))/sum(ZN([Total Budget]))&#10;[cumulative_cpc_revenue 1] / [Calculation_30891927095693314]' />
      </column>
      <column caption='date remove' datatype='boolean' name='[Calculation_1517642751986405384]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[partition_date] &lt;= DATEADD(&apos;day&apos;, -2, TODAY())' />
      </column>
      <column caption='Budget' datatype='real' name='[Calculation_30891927095693314]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [partition_date],[region],[management_entity],[brand],[sub_entity] :&#10;SUM([total_budget])}' />
      </column>
      <column caption='% cpc median' datatype='real' name='[Calculation_3717932652310491136]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED DATEPART(&apos;month&apos;,[partition_date]) : MEDIAN([% cpc clicks (copy)_3717932652310880257])}' />
      </column>
      <column caption='Metric Selection' datatype='integer' name='[Calculation_4100457139348238336]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Clicks&apos; THEN [total_clicks]&#10;WHEN &apos;CPC Clicks&apos; THEN [total_cpc_clicks]&#10;END' />
      </column>
      <column caption='revenue treshold' datatype='boolean' name='[Calculation_4385872768870461440]' role='measure' type='nominal'>
        <calculation class='tableau' formula='SUM([total_cpc_revenue]) &gt;= 450000' />
      </column>
      <column caption='cpc orders treshold' datatype='boolean' name='[Calculation_4385872768872419329]' role='measure' type='nominal'>
        <calculation class='tableau' formula='(ZN(SUM([total_cpc_orders])) - LOOKUP(ZN(SUM([total_cpc_orders])), -1)) / ABS(LOOKUP(ZN(SUM([total_cpc_orders])), -1))&gt;0'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='cpc revenue treshold' datatype='boolean' name='[Calculation_4385872768872845314]' role='measure' type='nominal'>
        <calculation class='tableau' formula='(ZN(SUM([total_cpc_revenue])) - LOOKUP(ZN(SUM([total_cpc_revenue])), -1)) / ABS(LOOKUP(ZN(SUM([total_cpc_revenue])), -1))&gt;0'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='clicks treshold' datatype='boolean' name='[Calculation_4385872768874471427]' role='measure' type='nominal'>
        <calculation class='tableau' formula='(ZN(SUM([Calculation_4100457139348238336])) - LOOKUP(ZN(SUM([Calculation_4100457139348238336])), -1)) / ABS(LOOKUP(ZN(SUM([Calculation_4100457139348238336])), -1))&gt;0'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
