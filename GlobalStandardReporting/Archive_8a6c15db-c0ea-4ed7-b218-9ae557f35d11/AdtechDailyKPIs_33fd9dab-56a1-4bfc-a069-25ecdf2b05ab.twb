              <calculation class='tableau' formula='(ZN(SUM([total_cpc_revenue])) - LOOKUP(ZN(SUM([total_cpc_revenue])), -1)) / ABS(LOOKUP(ZN(SUM([total_cpc_revenue])), -1))&gt;0'>
