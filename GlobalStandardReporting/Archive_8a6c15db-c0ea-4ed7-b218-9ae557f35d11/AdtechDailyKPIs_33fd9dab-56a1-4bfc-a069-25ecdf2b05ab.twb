          <datasource-dependencies datasource='federated.0spgy921ki5p4k1f83nv514xlyq9'>
            <column caption='date remove' datatype='boolean' name='[Calculation_1517642751986405384]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[partition_date] &lt;= DATEADD(&apos;day&apos;, -2, TODAY())' />
