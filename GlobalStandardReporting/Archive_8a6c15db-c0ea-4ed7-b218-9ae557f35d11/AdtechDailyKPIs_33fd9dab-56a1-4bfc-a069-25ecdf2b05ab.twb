          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Aggregation' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
              <calculation class='tableau' formula='&quot;Day&quot;' />
            </column>
            <column alias='Clicks' caption='Metric' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Clicks&quot;'>
              <calculation class='tableau' formula='&quot;Clicks&quot;' />
              <aliases>
                <alias key='&quot;Clicks&quot;' value='Clicks' />
                <alias key='&quot;CPC Clicks&quot;' value='CPC CLICKS' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0spgy921ki5p4k1f83nv514xlyq9'>
            <column caption='% cpc clicks' datatype='real' name='[Calculation_1517642751561314306]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_cpc_clicks]) / SUM([total_clicks])' />
            </column>
            <column caption='date remove' datatype='boolean' name='[Calculation_1517642751986405384]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[partition_date] &lt;= DATEADD(&apos;day&apos;, -2, TODAY())' />
            </column>
            <column caption='Metric Selection' datatype='integer' name='[Calculation_4100457139348238336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Clicks&apos; THEN [total_clicks]&#10;WHEN &apos;CPC Clicks&apos; THEN [total_cpc_clicks]&#10;END' />
            </column>
            <column caption='date agg' datatype='string' name='[Calculation_6798394748545687552]' role='dimension' type='nominal'>
