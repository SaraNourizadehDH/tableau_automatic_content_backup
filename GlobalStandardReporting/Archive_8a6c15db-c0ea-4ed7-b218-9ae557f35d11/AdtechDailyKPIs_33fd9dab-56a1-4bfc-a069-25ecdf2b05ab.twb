          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='adtech_daily_kpis' name='federated.0spgy921ki5p4k1f83nv514xlyq9' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Aggregation' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
              <calculation class='tableau' formula='&quot;Day&quot;' />
            </column>
            <column alias='Clicks' caption='Metric' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Clicks&quot;'>
              <calculation class='tableau' formula='&quot;Clicks&quot;' />
              <aliases>
                <alias key='&quot;Clicks&quot;' value='Clicks' />
                <alias key='&quot;CPC Clicks&quot;' value='CPC CLICKS' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0spgy921ki5p4k1f83nv514xlyq9'>
            <column caption='Date Aggregation' datatype='date' name='[Calculation_1517642751584505860]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Month&apos; THEN [Partition Date (Months)]&#10;WHEN &apos;Week&apos; THEN [Partition Date (Weeks)]&#10;WHEN &apos;Day&apos; THEN [Partition Date (Days)]&#10;END' />
            </column>
            <column caption='date remove' datatype='boolean' name='[Calculation_1517642751986405384]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[partition_date] &lt;= DATEADD(&apos;day&apos;, -2, TODAY())' />
            </column>
            <column caption='Metric Selection' datatype='integer' name='[Calculation_4100457139348238336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Clicks&apos; THEN [total_clicks]&#10;WHEN &apos;CPC Clicks&apos; THEN [total_cpc_clicks]&#10;END' />
            </column>
            <column caption='clicks treshold' datatype='boolean' name='[Calculation_4385872768874471427]' role='measure' type='nominal'>
              <calculation class='tableau' formula='(ZN(SUM([Calculation_4100457139348238336])) - LOOKUP(ZN(SUM([Calculation_4100457139348238336])), -1)) / ABS(LOOKUP(ZN(SUM([Calculation_4100457139348238336])), -1))&gt;0'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='date agg text' datatype='string' name='[Calculation_6798394748571455489]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Day&apos; THEN &apos;daily&apos;&#10;WHEN &apos;Week&apos; THEN &apos;weekly&apos;&#10;WHEN &apos;Month&apos; THEN &apos;monthly&apos;&#10;END' />
            </column>
            <column datatype='date' name='[Partition Date (Days)]' role='dimension' type='quantitative' user:agg-type='Day-Trunc' user:base-field='partition_date' user:ui-builder='date-bin-builder'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;day&apos;, [partition_date]))' />
            </column>
            <column datatype='date' name='[Partition Date (Months)]' role='dimension' type='quantitative' user:agg-type='Month-Trunc' user:base-field='partition_date' user:ui-builder='date-bin-builder'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [partition_date]))' />
