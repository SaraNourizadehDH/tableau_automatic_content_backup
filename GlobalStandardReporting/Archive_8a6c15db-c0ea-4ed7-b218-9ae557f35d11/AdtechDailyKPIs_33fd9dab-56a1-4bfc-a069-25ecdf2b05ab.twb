            <column caption='d - this period first' datatype='date' name='[Calculation_6663357172019159040]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(STR(DATEPART(&apos;year&apos;,DATEADD(&apos;day&apos;,-2,NOW())))+&apos;-&apos;+STR(DATEPART(&apos;month&apos;,DATEADD(&apos;day&apos;,-2,NOW())))+&apos;-&apos;+&apos;1&apos;)' />
