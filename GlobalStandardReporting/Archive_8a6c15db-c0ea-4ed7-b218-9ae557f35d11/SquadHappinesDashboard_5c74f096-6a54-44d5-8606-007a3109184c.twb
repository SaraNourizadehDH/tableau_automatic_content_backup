              <calculation class='tableau' formula='[appreciation_score]+[celebration_score]+[comfort_inside_the_squad_score]+[enthusiasm_score]+[experimentation_score]+[meaningful_work_score]+[outcome_driven_score]+[role_clarity_score]&#10;+[safety_score]+[squad_nps_score]+[strengths_score]+[trust_score]+[value_score]+[work_clarity_score]' />
