      <column alias='My squad&apos;s work meaningfully advanced the tribe and stakeholders&apos; objectives.' caption='Choose Question' datatype='real' name='[Parameter 5]' param-domain-type='list' role='measure' type='quantitative' value='6.'>
        <calculation class='tableau' formula='6.' />
        <aliases>
          <alias key='1.' value='I was appreciated and recognized by colleagues for doing good work.' />
          <alias key='2.' value='My squad celebrated as much as I would have liked.' />
          <alias key='3.' value='I felt comfortable asking for advice and help from my squad.' />
          <alias key='4.' value='I went to work feeling enthusiastic to solve our work challenges together.' />
          <alias key='5.' value='I was encouraged to designate time to experiment and find the best solutions.' />
          <alias key='6.' value='My squad&apos;s work meaningfully advanced the tribe and stakeholders&apos; objectives.' />
          <alias key='7.' value='My squad focuses on the outcomes over outputs.' />
          <alias key='8.' value='If I had to describe my role and responsibilities to a colleague, I would be able to do so with clarity.' />
          <alias key='9.' value='In meetings, I felt safe sharing opinions with my squad.' />
          <alias key='10.' value='I would recommend joining my squad to a friend or a colleague.' />
          <alias key='11.' value='I used my strengths and skills to contribute to the squad on a daily basis.' />
          <alias key='12.' value='I felt trusted to make decisions related to our work.' />
          <alias key='13.' value='My contributions were instrumental to advance the work of my squad.' />
          <alias key='14.' value='My squad focused on the highest priority work every day.' />
          <alias key='15.' value='Overall Score' />
        </aliases>
