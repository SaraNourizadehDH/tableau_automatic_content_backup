            <column caption='Ticket Month' datatype='string' name='[month]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1582100542344032256]' derivation='None' name='[none:Calculation_1582100542344032256:nk]' pivot='key' type='nominal' />
