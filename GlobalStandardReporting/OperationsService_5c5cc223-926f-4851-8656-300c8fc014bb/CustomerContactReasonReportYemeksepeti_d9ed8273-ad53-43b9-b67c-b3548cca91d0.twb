      <column caption='Case AHT Live (m)' datatype='real' default-format='n#,##0;-#,##0' name='[Non Chat Case AHT (hours) (copy)_1194016888913399811]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Chat Case (m)&#10;&#10;(SUM(&#10;    CASE [channel] WHEN &apos;Chat&apos; THEN [handling_time_secs]&#10;    ELSE 0 END &#10;   )&#10; /&#10;SUM(&#10;    CASE [channel] WHEN &apos;Chat&apos; THEN [resolved_contact_ind]&#10;    ELSE 0 END &#10;   )&#10;)&#10;/60' />
