    <worksheet name='Tickets per Order (%) '>
      <layout-options>
        <title>
          <formatted-text />
        </title>
        <caption>
          <formatted-text>
            <run fontcolor='#000000' fontsize='8' italic='true'># of Tickets per CCR as percentage of  orders.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='8' italic='true'>Hover the mouse over &quot;CCR Category (L2)&quot; and click on [+] to see L3. In case you want to aggregate it back, click on [-].</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='avaya_ccr_report' name='federated.15cehv015dgmno1abds701w52j7r' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Cases by Delivery Type' datatype='string' datatype-customized='true' name='[Cases (copy)_2949294850072502276]' param-domain-type='list' role='measure' type='nominal' value='&quot;Cases per order - All&quot;'>
              <calculation class='tableau' formula='&quot;Cases per order - All&quot;' />
            </column>
            <column caption='Cases' datatype='string' datatype-customized='true' name='[KPIs Graphs (copy)_552535426223394821]' param-domain-type='list' role='measure' type='nominal' value='&quot;Incoming Cases&quot;'>
              <calculation class='tableau' formula='&quot;Incoming Cases&quot;' />
            </column>
            <column alias='Monthly' caption='Chose Dimension (Columns)' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
              <aliases>
                <alias key='&quot;Date&quot;' value='Daily' />
                <alias key='&quot;Month&quot;' value='Monthly' />
                <alias key='&quot;Week&quot;' value='Weekly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.15cehv015dgmno1abds701w52j7r'>
            <column caption='Orders' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1252000751479169032]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Old logic -- revised 28-Feb-21&#10;// { FIXED [Source Id],[Date Range], [Vertical], [Delivery Type] : MAX([Gross Orders]) }&#10;&#10;// Revised per bug reported in RASD-1347&#10;// After the CCR design was updated to insert gross_orders just once rather than being included in each record, the old LOD above no longer worked.&#10;// Revised logic first gets the max() at that level same as last time, but then uses EXCLUDE to remove the CCR granularity when &#10;// adding the orders. The final effect is that orders are again appropriately counted just once per date, delivery type, vertical &amp; source ID.&#10;&#10;{ EXCLUDE [contact_reason_l1], [contact_reason_l2], [contact_reason_l3] :&#10;&#9;SUM( { FIXED [report_date], [delivery_type], [vertical],[is_corporate], [is_preorder], [global_entity_id] : MAX([gross_orders]) }) &#10;}' />
            </column>
            <column caption='Cases per Order' datatype='real' default-format='p0.00%' name='[Calculation_1252000751479709705]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(CASE [Parameters].[Cases (copy)_2949294850072502276]&#10;        WHEN &apos;Cases per order - All&apos; THEN [KPIs Graphs (copy)_552535426223271940]&#10;        WHEN &apos;Cases per order - Own Delivery&apos; THEN IF [delivery_type] = &apos;Own Delivery&apos; THEN [KPIs Graphs (copy)_552535426223271940] END&#10;        WHEN &apos;Cases per order - Vendor Delivery&apos; THEN IF [delivery_type] = &apos;Vendor Delivery&apos; THEN [KPIs Graphs (copy)_552535426223271940] END&#10;        WHEN &apos;Cases per order - unknown&apos; THEN IF [delivery_type] = &apos;Unknown&apos; THEN [KPIs Graphs (copy)_552535426223271940] END&#10;        WHEN &apos;Cases per order - Pick-up&apos; THEN IF [delivery_type] = &apos;Pick-up&apos; THEN [KPIs Graphs (copy)_552535426223271940] END&#10;    END&#10;   )&#10;/&#10;SUM([Calculation_1252000751479169032])' />
            </column>
            <column caption='Flag Null CCR' datatype='boolean' name='[Calculation_1582100542344032256]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='ISNULL([contact_reason_l1]) OR [contact_reason_l1]=&apos;Unknown&apos;' />
            </column>
            <column caption='Cases for selected Delivery Type' datatype='real' name='[Calculation_5055431335537905664]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Cases (copy)_2949294850072502276]&#10;    WHEN &apos;Cases per order - All&apos; THEN [KPIs Graphs (copy)_552535426223271940]&#10;    WHEN &apos;Cases per order - Own Delivery&apos; THEN IF [delivery_type] = &apos;Own Delivery&apos; THEN [KPIs Graphs (copy)_552535426223271940] END&#10;    WHEN &apos;Cases per order - Vendor Delivery&apos; THEN IF [delivery_type] = &apos;Vendor Delivery&apos; THEN [KPIs Graphs (copy)_552535426223271940] END&#10;    WHEN &apos;Cases per order - unknown&apos; THEN IF [delivery_type] = &apos;unknown&apos; THEN [KPIs Graphs (copy)_552535426223271940] END&#10;    WHEN &apos;Cases per order - Pick-up&apos; THEN IF [delivery_type] = &apos;Pick-up&apos; THEN [KPIs Graphs (copy)_552535426223271940] END&#10;END' />
            </column>
            <column caption='Choosen Dimension' datatype='string' name='[Choosen Dimension Graphs (copy)_526358231826968593]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Month&apos; THEN STR([month])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Week&apos; THEN STR([week])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Date&apos; THEN STR([report_date])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Country&apos; THEN [country]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Contact Center&apos; THEN [contact_center]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;All&apos; THEN &apos;All&apos;&#10;END' />
            </column>
            <column caption='Cases' datatype='real' default-format='n#,##0;-#,##0' name='[KPIs Graphs (copy)_552535426223271940]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[KPIs Graphs (copy)_552535426223394821]=&apos;Incoming Cases&apos; then [inbound_contact_ind]&#13;&#10;ELSEIF [Parameters].[KPIs Graphs (copy)_552535426223394821]=&apos;Resolved Cases&apos; then [resolved_contact_ind]&#13;&#10;END' />
            </column>
            <column caption='Agent Facing Tool' datatype='string' name='[agent_facing_tool]' role='dimension' type='nominal'>
              <aliases>
                <alias key='%null%' value='N/A' />
              </aliases>
            </column>
            <column caption='Brand' datatype='string' name='[brand]' role='dimension' type='nominal' />
            <column caption='Channel' datatype='string' name='[channel]' role='dimension' type='nominal' />
            <column caption='Contact Center' datatype='string' name='[contact_center]' role='dimension' type='nominal' />
            <column caption='CCR Category L1' datatype='string' name='[contact_reason_l1]' role='dimension' type='nominal' />
            <column caption='CCR Category L2' datatype='string' name='[contact_reason_l2]' role='dimension' type='nominal' />
