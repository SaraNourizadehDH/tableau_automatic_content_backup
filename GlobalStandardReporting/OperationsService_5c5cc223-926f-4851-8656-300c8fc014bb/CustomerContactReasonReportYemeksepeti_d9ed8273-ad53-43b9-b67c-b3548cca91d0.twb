    <worksheet name='CCR L1'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontsize='11'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='avaya_ccr_report' name='federated.15cehv015dgmno1abds701w52j7r' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Monthly' caption='Chose Dimension (D/W/M)' datatype='string' name='[Chose Dimension (Columns) (copy)_526358231437660160]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
              <aliases>
                <alias key='&quot;Date&quot;' value='Daily' />
                <alias key='&quot;Month&quot;' value='Monthly' />
                <alias key='&quot;Week&quot;' value='Weekly' />
              </aliases>
            </column>
            <column caption='KPIs Graphs Evolution' datatype='string' datatype-customized='true' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Incoming Cases&quot;'>
              <calculation class='tableau' formula='&quot;Incoming Cases&quot;' />
              <aliases>
                <alias key='&quot;Case AHT (h)&quot;' value='Case AHT Non-Live (h)' />
                <alias key='&quot;CSAT&quot;' value='CSAT %' />
                <alias key='&quot;FullRT&quot;' value='FullRT (h)' />
                <alias key='&quot;Incoming Cases per order&quot;' value='Incoming Cases per order %' />
                <alias key='&quot;QA Score&quot;' value='QA Score %' />
                <alias key='&quot;Resolved Cases per order&quot;' value='Resolved Cases per order %' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.15cehv015dgmno1abds701w52j7r'>
            <column caption='Chat AHT (m)' datatype='real' name='[Calculation_1194016888929374213]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(&#10;    CASE [channel] WHEN &apos;Chats&apos; THEN [Handling Time (copy)_1194016888929615878]&#10;    ELSE 0 END &#10;   )&#10;/&#10;SUM(&#10;    CASE [channel] WHEN &apos;Chats&apos; THEN [Resolved Cases (copy)_1194016888930238471]&#10;    ELSE 0 END &#10;   )&#10;)/60' />
            </column>
            <column caption='Orders' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1252000751479169032]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Old logic -- revised 28-Feb-21&#10;// { FIXED [Source Id],[Date Range], [Vertical], [Delivery Type] : MAX([Gross Orders]) }&#10;&#10;// Revised per bug reported in RASD-1347&#10;// After the CCR design was updated to insert gross_orders just once rather than being included in each record, the old LOD above no longer worked.&#10;// Revised logic first gets the max() at that level same as last time, but then uses EXCLUDE to remove the CCR granularity when &#10;// adding the orders. The final effect is that orders are again appropriately counted just once per date, delivery type, vertical &amp; source ID.&#10;&#10;{ EXCLUDE [contact_reason_l1], [contact_reason_l2], [contact_reason_l3] :&#10;&#9;SUM( { FIXED [report_date], [delivery_type], [vertical],[is_corporate], [is_preorder], [global_entity_id] : MAX([gross_orders]) }) &#10;}' />
            </column>
            <column caption='Avg. Full Resolution Time (h)' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1515179817555480578]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([full_resolution_time_min]) / SUM([resolved_contact_ind]) /60' />
            </column>
            <column caption='Flag Null CCR' datatype='boolean' name='[Calculation_1582100542344032256]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='ISNULL([contact_reason_l1]) OR [contact_reason_l1]=&apos;Unknown&apos;' />
            </column>
            <column caption='CSAT (in percentage)' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_338121849629618177]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_ac_csat_4_5]) / SUM([count_ac_csat_responses]) * 100' />
            </column>
            <column caption='QA Score' datatype='real' name='[Calculation_526358231821787148]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([score_avg])/SUM([evaluations])' />
            </column>
            <column caption='Choosen Dimension Graphs' datatype='string' name='[Calculation_581245852810321921]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF[Parameters].[Chose Dimension (Columns) (copy)_526358231437660160]=&apos;Month&apos; THEN STR([month])&#13;&#10;ELSEIF [Parameters].[Chose Dimension (Columns) (copy)_526358231437660160]=&apos;Week&apos; THEN STR([week])&#13;&#10;ELSEIF [Parameters].[Chose Dimension (Columns) (copy)_526358231437660160]=&apos;Date&apos; THEN STR([report_date])&#13;&#10;ELSEIF [Parameters].[Chose Dimension (Columns) (copy)_526358231437660160]=&apos;Country&apos; THEN [country]&#13;&#10;ELSEIF [Parameters].[Chose Dimension (Columns) (copy)_526358231437660160]=&apos;Contact Center&apos; THEN STR([contact_center])&#13;&#10;END' />
            </column>
            <column caption='KPIs Graphs' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_735212659243257856]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 5]=&apos;Incoming Cases&apos; then sum(round([inbound_contact_ind],2))&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;Incoming Cases %&apos; then ROUND(SUM([inbound_contact_ind]) / TOTAL(SUM([inbound_contact_ind])),2)*100&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;Resolved Cases&apos; then round(sum([resolved_contact_ind]),2)&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;Resolved Cases %&apos; then ROUND(SUM([resolved_contact_ind]) / TOTAL(SUM([resolved_contact_ind])),2)*100&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;Case AHT (h)&apos; then ROUND([Case AHT (h) (copy)_1194016888909897728],1)&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;Chat AHT (m)&apos; then ROUND([Calculation_1194016888929374213],1)&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;Incoming Cases per order&apos; then ROUND([Cases per order (copy)_552535426687778822],3)*100&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;Resolved Cases per order&apos; then ROUND([Cases per order (copy) (copy)_552535426687787015],3)*100&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;FullRT&apos; then ROUND([Calculation_1515179817555480578],1)&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;QA Score&apos; then ROUND([Calculation_526358231821787148],3)*100&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;CSAT&apos; then ROUND([Calculation_338121849629618177],0)&#13;&#10;//ELSEIF  [KPIs Graphs Evolution]=&apos;% 1-time contact&apos; THEN ROUND([% 1-time contact],3)*100&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Case AHT Non-Live (h)' datatype='real' default-format='n#,##0;-#,##0' name='[Case AHT (h) (copy)_1194016888909897728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//Non Chat Case AHT (hours)&#10;(&#10;SUM(&#10;    CASE [channel] WHEN &apos;Chat&apos; THEN 0&#10;    ELSE [handling_time_secs] END &#10;   )&#10;/&#10;SUM(&#10;    CASE [channel] WHEN &apos;Chat&apos; THEN 0&#10;    ELSE [resolved_contact_ind] END &#10;   )&#10;   )&#10;/60&#10;&#10;/60' />
            </column>
            <column caption='Resolved Cases per order' datatype='real' default-format='p0.00%' name='[Cases per order (copy) (copy)_552535426687787015]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([resolved_contact_ind])/SUM([Calculation_1252000751479169032])' />
            </column>
            <column caption='Incoming Chats per order' datatype='real' default-format='p0.00%' name='[Cases per order (copy)_552535426687778822]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([inbound_contact_ind])/SUM([Calculation_1252000751479169032])' />
            </column>
            <column caption='Chat Handling Time' datatype='real' name='[Handling Time (copy)_1194016888929615878]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [channel] = &apos;Chats&apos;&#10;THEN [handling_time_secs]&#10;END' />
            </column>
            <column caption='Total Served Chats' datatype='real' name='[Resolved Cases (copy)_1194016888930238471]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [channel] = &apos;Chats&apos; THEN [inbound_contact_ind]&#10;END' />
            </column>
            <column caption='Agent Facing Tool' datatype='string' name='[agent_facing_tool]' role='dimension' type='nominal'>
              <aliases>
                <alias key='%null%' value='N/A' />
              </aliases>
            </column>
            <column caption='Brand' datatype='string' name='[brand]' role='dimension' type='nominal' />
            <column caption='Channel' datatype='string' name='[channel]' role='dimension' type='nominal' />
            <column caption='Contact Center' datatype='string' name='[contact_center]' role='dimension' type='nominal' />
            <column caption='CCR Category L1' datatype='string' name='[contact_reason_l1]' role='dimension' type='nominal' />
            <column caption='CCR Category L2' datatype='string' name='[contact_reason_l2]' role='dimension' type='nominal' />
            <column caption='CCR Category L3' datatype='string' name='[contact_reason_l3]' role='dimension' type='nominal' />
            <column caption='Count Ac Csat 4 5' datatype='real' name='[count_ac_csat_4_5]' role='measure' type='quantitative' />
            <column caption='# AC CSAT Responses' datatype='real' name='[count_ac_csat_responses]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Delivery Type' datatype='string' name='[delivery_type]' role='dimension' type='nominal' />
            <column caption='Evaluations' datatype='real' name='[evaluations]' role='measure' type='quantitative' />
            <column caption='Full Resolution Time Min' datatype='real' name='[full_resolution_time_min]' role='measure' type='quantitative' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Gross Orders' datatype='integer' name='[gross_orders]' role='measure' type='quantitative' />
            <column caption='Handling Time Secs' datatype='real' name='[handling_time_secs]' role='measure' type='quantitative' />
            <column caption='Incoming Chats' datatype='real' name='[inbound_contact_ind]' role='measure' type='quantitative' />
            <column caption='Is Corporate ?' datatype='boolean' name='[is_corporate]' role='dimension' type='nominal'>
              <aliases>
                <alias key='%null%' value='Unknown' />
                <alias key='false' value='No' />
                <alias key='true' value='Yes' />
              </aliases>
            </column>
            <column caption='Is Preorder ?' datatype='boolean' name='[is_preorder]' role='dimension' type='nominal'>
              <aliases>
                <alias key='%null%' value='Unknown' />
                <alias key='false' value='No' />
                <alias key='true' value='Yes' />
              </aliases>
            </column>
