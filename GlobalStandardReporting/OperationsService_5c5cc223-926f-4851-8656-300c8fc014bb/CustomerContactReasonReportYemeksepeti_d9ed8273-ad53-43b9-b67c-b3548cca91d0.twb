      <aliases enabled='yes' />
      <column caption='Chat AHT (m)' datatype='real' name='[Calculation_1194016888929374213]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(&#10;    CASE [channel] WHEN &apos;Chats&apos; THEN [Handling Time (copy)_1194016888929615878]&#10;    ELSE 0 END &#10;   )&#10;/&#10;SUM(&#10;    CASE [channel] WHEN &apos;Chats&apos; THEN [Resolved Cases (copy)_1194016888930238471]&#10;    ELSE 0 END &#10;   )&#10;)/60' />
      </column>
      <column caption='Orders' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1252000751479169032]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Old logic -- revised 28-Feb-21&#10;// { FIXED [Source Id],[Date Range], [Vertical], [Delivery Type] : MAX([Gross Orders]) }&#10;&#10;// Revised per bug reported in RASD-1347&#10;// After the CCR design was updated to insert gross_orders just once rather than being included in each record, the old LOD above no longer worked.&#10;// Revised logic first gets the max() at that level same as last time, but then uses EXCLUDE to remove the CCR granularity when &#10;// adding the orders. The final effect is that orders are again appropriately counted just once per date, delivery type, vertical &amp; source ID.&#10;&#10;{ EXCLUDE [contact_reason_l1], [contact_reason_l2], [contact_reason_l3] :&#10;&#9;SUM( { FIXED [report_date], [delivery_type], [vertical],[is_corporate], [is_preorder], [global_entity_id] : MAX([gross_orders]) }) &#10;}' />
      </column>
      <column caption='Cases per Order' datatype='real' default-format='p0.00%' name='[Calculation_1252000751479709705]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(CASE [Parameters].[Cases (copy)_2949294850072502276]&#10;        WHEN &apos;Cases per order - All&apos; THEN [KPIs Graphs (copy)_552535426223271940]&#10;        WHEN &apos;Cases per order - Own Delivery&apos; THEN IF [delivery_type] = &apos;Own Delivery&apos; THEN [KPIs Graphs (copy)_552535426223271940] END&#10;        WHEN &apos;Cases per order - Vendor Delivery&apos; THEN IF [delivery_type] = &apos;Vendor Delivery&apos; THEN [KPIs Graphs (copy)_552535426223271940] END&#10;        WHEN &apos;Cases per order - unknown&apos; THEN IF [delivery_type] = &apos;Unknown&apos; THEN [KPIs Graphs (copy)_552535426223271940] END&#10;        WHEN &apos;Cases per order - Pick-up&apos; THEN IF [delivery_type] = &apos;Pick-up&apos; THEN [KPIs Graphs (copy)_552535426223271940] END&#10;    END&#10;   )&#10;/&#10;SUM([Calculation_1252000751479169032])' />
      </column>
      <column caption='Avg. Full Resolution Time (h)' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1515179817555480578]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([full_resolution_time_min]) / SUM([resolved_contact_ind]) /60' />
      </column>
      <column caption='KPIs' datatype='real' default-format='N' name='[Calculation_1515179817556090885]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  [Parameters].[Parameter 4]=&apos;# Incoming Cases&apos; THEN sum([inbound_contact_ind])&#10;ELSEIF [Parameters].[Parameter 4]=&apos;# Resolved Cases&apos; THEN sum([resolved_contact_ind])&#10;ELSEIF  [Parameters].[Parameter 4]=&apos;Case AHT Non-Live (h)&apos; THEN ROUND([Case AHT (h) (copy)_1194016888909897728],1)&#10;//ELSEIF  [Parameters].[KPIs]=&apos;Case AHT Live (m)&apos; THEN ROUND([Case AHT Live (m)],1)&#10;ELSEIF  [Parameters].[Parameter 4]=&apos;Chat AHT (m)&apos; THEN ROUND([Calculation_1194016888929374213],1)&#10;ELSEIF  [Parameters].[Parameter 4]=&apos;Chat Avg. Wrap Time (m)&apos; THEN ROUND([Chat AHT (m) (copy)_5870160642275184642],1)&#10;ELSEIF  [Parameters].[Parameter 4]=&apos;Chat Avg. THT (m)&apos; THEN ROUND([Chat AHT (m) (copy)_5870160642274512896],1)&#10;ELSEIF  [Parameters].[Parameter 4]=&apos;Avg. Full Resolution Time&apos; THEN ROUND([Calculation_1515179817555480578],1)&#10;// NPS removed as part of RA-1134&#10;// ELSEIF  [Parameters].[KPIs]=&apos;AC NPS&apos; THEN ROUND([AC NPS],0)&#10;ELSEIF  [Parameters].[Parameter 4]=&apos;CSAT (in percentage)&apos; THEN ROUND([Calculation_338121849629618177],0)&#10;ELSEIF  [Parameters].[Parameter 4]=&apos;# CSAT Responses&apos; THEN SUM([count_ac_csat_responses])&#10;ELSEIF  [Parameters].[Parameter 4]=&apos;QA Score&apos; THEN ROUND([Calculation_526358231821787148], 0)&#10;//ELSEIF  [Parameters].[KPIs]=&apos;% 1-time contact&apos; THEN ROUND([% 1-time contact],2)*100&#10;END' />
      </column>
      <column caption='Flag Null CCR' datatype='boolean' name='[Calculation_1582100542344032256]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='ISNULL([contact_reason_l1]) OR [contact_reason_l1]=&apos;Unknown&apos;' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_2996441925137129472]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='CSAT (in percentage)' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_338121849629618177]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_ac_csat_4_5]) / SUM([count_ac_csat_responses]) * 100' />
      </column>
      <column caption='Cases for selected Delivery Type' datatype='real' name='[Calculation_5055431335537905664]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Cases (copy)_2949294850072502276]&#10;    WHEN &apos;Cases per order - All&apos; THEN [KPIs Graphs (copy)_552535426223271940]&#10;    WHEN &apos;Cases per order - Own Delivery&apos; THEN IF [delivery_type] = &apos;Own Delivery&apos; THEN [KPIs Graphs (copy)_552535426223271940] END&#10;    WHEN &apos;Cases per order - Vendor Delivery&apos; THEN IF [delivery_type] = &apos;Vendor Delivery&apos; THEN [KPIs Graphs (copy)_552535426223271940] END&#10;    WHEN &apos;Cases per order - unknown&apos; THEN IF [delivery_type] = &apos;unknown&apos; THEN [KPIs Graphs (copy)_552535426223271940] END&#10;    WHEN &apos;Cases per order - Pick-up&apos; THEN IF [delivery_type] = &apos;Pick-up&apos; THEN [KPIs Graphs (copy)_552535426223271940] END&#10;END' />
      </column>
      <column caption='QA Score' datatype='real' name='[Calculation_526358231821787148]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([score_avg])/SUM([evaluations])' />
      </column>
      <column caption='% 1-time contact' datatype='real' default-format='p0.0%' name='[Calculation_552535426702155790]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// FCR by CCR isn&apos;t applicable if CCR values are unavailable&#10;SUM(IF NOT ISNULL([contact_reason_l1]) AND [contact_reason_l1] &lt;&gt; &apos;Ticket without CCR&apos; THEN [count_first_contact_resolution] END)&#10;/&#10;SUM(IF NOT ISNULL([contact_reason_l1]) AND [contact_reason_l1] &lt;&gt; &apos;Ticket without CCR&apos; THEN [count_contacts_related_to_order] END)' />
      </column>
      <column caption='% of contacts with order number' datatype='real' default-format='p0%' name='[Calculation_552535426703106063]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([count_contacts_related_to_order]) / SUM([inbound_contact_ind])' />
      </column>
      <column caption='Choosen Dimension Graphs' datatype='string' name='[Calculation_581245852810321921]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF[Parameters].[Chose Dimension (Columns) (copy)_526358231437660160]=&apos;Month&apos; THEN STR([month])&#13;&#10;ELSEIF [Parameters].[Chose Dimension (Columns) (copy)_526358231437660160]=&apos;Week&apos; THEN STR([week])&#13;&#10;ELSEIF [Parameters].[Chose Dimension (Columns) (copy)_526358231437660160]=&apos;Date&apos; THEN STR([report_date])&#13;&#10;ELSEIF [Parameters].[Chose Dimension (Columns) (copy)_526358231437660160]=&apos;Country&apos; THEN [country]&#13;&#10;ELSEIF [Parameters].[Chose Dimension (Columns) (copy)_526358231437660160]=&apos;Contact Center&apos; THEN STR([contact_center])&#13;&#10;END' />
      </column>
      <column caption='KPIs Graphs' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_735212659243257856]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 5]=&apos;Incoming Cases&apos; then sum(round([inbound_contact_ind],2))&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;Incoming Cases %&apos; then ROUND(SUM([inbound_contact_ind]) / TOTAL(SUM([inbound_contact_ind])),2)*100&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;Resolved Cases&apos; then round(sum([resolved_contact_ind]),2)&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;Resolved Cases %&apos; then ROUND(SUM([resolved_contact_ind]) / TOTAL(SUM([resolved_contact_ind])),2)*100&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;Case AHT (h)&apos; then ROUND([Case AHT (h) (copy)_1194016888909897728],1)&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;Chat AHT (m)&apos; then ROUND([Calculation_1194016888929374213],1)&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;Incoming Cases per order&apos; then ROUND([Cases per order (copy)_552535426687778822],3)*100&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;Resolved Cases per order&apos; then ROUND([Cases per order (copy) (copy)_552535426687787015],3)*100&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;FullRT&apos; then ROUND([Calculation_1515179817555480578],1)&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;QA Score&apos; then ROUND([Calculation_526358231821787148],3)*100&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;CSAT&apos; then ROUND([Calculation_338121849629618177],0)&#13;&#10;//ELSEIF  [KPIs Graphs Evolution]=&apos;% 1-time contact&apos; THEN ROUND([% 1-time contact],3)*100&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Case AHT Non-Live (h)' datatype='real' default-format='n#,##0;-#,##0' name='[Case AHT (h) (copy)_1194016888909897728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//Non Chat Case AHT (hours)&#10;(&#10;SUM(&#10;    CASE [channel] WHEN &apos;Chat&apos; THEN 0&#10;    ELSE [handling_time_secs] END &#10;   )&#10;/&#10;SUM(&#10;    CASE [channel] WHEN &apos;Chat&apos; THEN 0&#10;    ELSE [resolved_contact_ind] END &#10;   )&#10;   )&#10;/60&#10;&#10;/60' />
      </column>
      <column caption='Orders for Delivery Type' datatype='integer' name='[Cases for Delivery Type (copy)_5055431335538511874]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Cases (copy)_2949294850072502276]&#10;    WHEN &apos;Cases per order - All&apos; THEN [Calculation_1252000751479169032]&#10;    ELSE { INCLUDE [report_date], [delivery_type] : SUM([Calculation_1252000751479169032]) }&#10;END' />
      </column>
      <column caption='Resolved Cases per order' datatype='real' default-format='p0.00%' name='[Cases per order (copy) (copy)_552535426687787015]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([resolved_contact_ind])/SUM([Calculation_1252000751479169032])' />
      </column>
      <column caption='Incoming Chats per order' datatype='real' default-format='p0.00%' name='[Cases per order (copy)_552535426687778822]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([inbound_contact_ind])/SUM([Calculation_1252000751479169032])' />
      </column>
      <column caption='Chat Avg Total HT (m)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Chat AHT (m) (copy)_5870160642274512896]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(&#10;    CASE [channel] WHEN &apos;Chats&apos; THEN ZN([Handling Time (copy)_1194016888929615878]) + ZN([wrap_up_time_secs])&#10;    ELSE 0 END &#10;   )&#10;/&#10;SUM(&#10;    CASE [channel] WHEN &apos;Chats&apos; THEN [Resolved Cases (copy)_1194016888930238471]&#10;    ELSE 0 END &#10;   )&#10;)/60' />
      </column>
      <column caption='Chat Avg. Wrap Time (m)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Chat AHT (m) (copy)_5870160642275184642]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(&#10;    CASE [channel] WHEN &apos;Chat&apos; THEN [wrap_up_time_secs]&#10;    ELSE 0 END &#10;   )&#10;/&#10;SUM(&#10;    CASE [channel] WHEN &apos;Chat&apos; THEN [Resolved Cases (copy)_1194016888930238471]&#10;    ELSE 0 END &#10;   )&#10;)/60' />
      </column>
      <column caption='Choosen Dimension' datatype='string' name='[Choosen Dimension Graphs (copy)_526358231826968593]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Month&apos; THEN STR([month])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Week&apos; THEN STR([week])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Date&apos; THEN STR([report_date])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Country&apos; THEN [country]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Contact Center&apos; THEN [contact_center]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;All&apos; THEN &apos;All&apos;&#10;END' />
      </column>
      <column caption='Chat Handling Time' datatype='real' name='[Handling Time (copy)_1194016888929615878]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [channel] = &apos;Chats&apos;&#10;THEN [handling_time_secs]&#10;END' />
      </column>
      <column caption='KPIs v2' datatype='real' default-format='*#,##0.0;0.0%' name='[KPIs (copy)_6291880589552766976]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;# Incoming Cases&apos; THEN SUM([inbound_contact_ind])&#13;&#10;ELSEIF [Parameters].[Parameter 4] = &apos;# Resolved Cases&apos; THEN SUM([resolved_contact_ind])&#10;ELSEIF [Parameters].[Parameter 4] = &apos;% Incoming Cases&apos; THEN -SUM([inbound_contact_ind]) / TOTAL(SUM([inbound_contact_ind])) &#10;ELSEIF [Parameters].[Parameter 4] = &apos;% Resolved Cases&apos; THEN -SUM([resolved_contact_ind]) / TOTAL(SUM([resolved_contact_ind]))&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Case AHT Non-Live (h)&apos; THEN [Case AHT (h) (copy)_1194016888909897728]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Case AHT Live (m)&apos; THEN [Non Chat Case AHT (hours) (copy)_1194016888913399811]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Chat AHT (m)&apos; THEN [Calculation_1194016888929374213]&#13;&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Avg. Full Resolution Time&apos; THEN [Calculation_1515179817555480578]&#13;&#10;ELSEIF [Parameters].[Parameter 4] = &apos;CSAT (in percentage)&apos; THEN [Calculation_338121849629618177]&#13;&#10;ELSEIF [Parameters].[Parameter 4] = &apos;QA Score&apos; THEN [Calculation_526358231821787148]&#13;&#10;//ELSEIF [Parameters].[KPIs] = &apos;% 1-time contact&apos; THEN -[% 1-time contact]&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Cases' datatype='real' default-format='n#,##0;-#,##0' name='[KPIs Graphs (copy)_552535426223271940]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[KPIs Graphs (copy)_552535426223394821]=&apos;Incoming Cases&apos; then [inbound_contact_ind]&#13;&#10;ELSEIF [Parameters].[KPIs Graphs (copy)_552535426223394821]=&apos;Resolved Cases&apos; then [resolved_contact_ind]&#13;&#10;END' />
      </column>
      <column caption='KPIs Graphs v2' datatype='real' default-format='n#,##0;-#,##0' name='[KPIs Graphs (copy)_6291880589552807937]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 5]=&apos;Incoming Cases&apos; then sum(round([inbound_contact_ind],2))&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;Incoming Cases %&apos; then ROUND(SUM([inbound_contact_ind]) / TOTAL(SUM([inbound_contact_ind])),2)*100&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;Resolved Cases&apos; then round(sum([resolved_contact_ind]),2)&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;Resolved Cases %&apos; then ROUND(SUM([resolved_contact_ind]) / TOTAL(SUM([resolved_contact_ind])),2)*100&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;Case AHT (h)&apos; then ROUND([Case AHT (h) (copy)_1194016888909897728],1)&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;Chat AHT (m)&apos; then ROUND([Calculation_1194016888929374213],1)&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;Incoming Cases per order&apos; then ROUND([Cases per order (copy)_552535426687778822],3)*100&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;Resolved Cases per order&apos; then ROUND([Cases per order (copy) (copy)_552535426687787015],3)*100&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;FullRT&apos; then ROUND([Calculation_1515179817555480578],1)&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;QA Score&apos; then ROUND([Calculation_526358231821787148],3)*100&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;CSAT&apos; then ROUND([Calculation_338121849629618177],0)&#13;&#10;//ELSEIF  [KPIs Graphs Evolution]=&apos;% 1-time contact&apos; THEN ROUND([% 1-time contact],3)*100&#13;&#10;END'>
