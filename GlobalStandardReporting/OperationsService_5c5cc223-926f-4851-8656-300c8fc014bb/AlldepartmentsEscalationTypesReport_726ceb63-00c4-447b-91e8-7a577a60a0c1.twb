            </column>
            <column caption='Case SLA 24 Hrs' datatype='real' default-format='p0.0%' name='[SLA L1 (copy)_5558638216490434561]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([case_within_sla])/sum([incoming_case_ind])' />
            </column>
            <column caption='% Escalations' datatype='integer' default-format='p0%' name='[Work Item L2 (copy)_1184165250224807940]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[count_escalations]' />
