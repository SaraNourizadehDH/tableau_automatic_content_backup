    <worksheet name='Esc. within CC'>
      <layout-options>
        <caption>
          <formatted-text>
            <run># Work Items L2 inlcudes all work items  after an escalation, not only the first one right after the escalation.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='escalation_types_report' name='federated.0gqoovo0dtggoq11xfe5g16gaz4t' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Granularity Level' datatype='string' name='[Completed Week Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0gqoovo0dtggoq11xfe5g16gaz4t'>
            <column caption='AHT L2 (hrs)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[AHT L2 (copy)_1184165250557022215]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([handling_time_l2])/sum([working_item_l2])/60' />
            </column>
            <column caption='Avg First Reply TIme L2' datatype='real' name='[Avg First Reply TIme L1 Close (copy) (copy)_6481594722565971972]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ticket_first_reply_time_l2]) / SUM([working_item_l2]) // in mins' />
            </column>
            <column caption='Avg First Reply TIme L2 (hrs)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg First Reply TIme L2 (copy)_1184165250557870088]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ticket_first_reply_time_l2]) / SUM([working_item_l2])/60 // in hrs' />
            </column>
            <column caption='CSAT' datatype='real' default-format='p0%' name='[CSAT (Chats) (copy)_3562980665898053633]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_csat_4_5])/SUM([count_csat_responses])' />
            </column>
            <column caption='Case SLA 48 Hrs' datatype='real' default-format='p0.0%' name='[Calculation_216735767526223873]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([case_within_sla_48h])/sum([incoming_case_ind])' />
            </column>
            <column caption='% Risk Fraud Cases' datatype='real' default-format='p0%' name='[Calculation_5640406726724624384]' role='measure' type='quantitative' visual-totals='Sum'>
              <calculation class='tableau' formula='SUM([risk_fraud_ind]) &#10;/ SUM([count_escalations])' />
            </column>
            <column caption='SLA L2' datatype='real' name='[Calculation_592504881661399041]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(ifnull([count_within_sla_l2],0))/sum([working_item_l2])' />
            </column>
            <column caption='Granularity' datatype='string' name='[Calculation_772930316894855168]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Completed Week Parameter]=&apos;Daily&apos; THEN STR([report_date])&#13;&#10;ELSEIF [Parameters].[Completed Week Parameter]=&apos;Weekly&apos; THEN STR([week])&#13;&#10;ELSEIF [Parameters].[Completed Week Parameter]=&apos;Monthly&apos; THEN STR([month])&#13;&#10;END' />
            </column>
            <column caption='AHT L2' datatype='real' name='[Calculation_93168273245642754]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([handling_time_l2])/sum([working_item_l2])' />
            </column>
            <column caption='Escalation Date  (Range)' datatype='date' name='[Escalation Date  (copy)_1608488811840110592]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[report_date]' />
            </column>
            <column caption='Case SLA 24 Hrs' datatype='real' default-format='p0.0%' name='[SLA L1 (copy)_5558638216490434561]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([case_within_sla])/sum([incoming_case_ind])' />
            </column>
            <column caption='% Escalations' datatype='integer' default-format='p0%' name='[Work Item L2 (copy)_1184165250224807940]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[count_escalations]' />
            </column>
            <column caption='Brand' datatype='string' name='[brand]' role='dimension' type='nominal' />
            <column caption='Case Origin' datatype='string' name='[case_origin]' role='dimension' type='nominal' />
            <column caption='Case Within Sla' datatype='integer' name='[case_within_sla]' role='measure' type='quantitative' />
            <column caption='Case Within Sla 48H' datatype='integer' name='[case_within_sla_48h]' role='measure' type='quantitative' />
            <column caption='Contact Center' datatype='string' name='[contact_center]' role='dimension' type='nominal' />
            <column caption='PCR Category L1' datatype='string' name='[contact_reason_l1]' role='dimension' type='nominal' />
            <column caption='PCR Category L2' datatype='string' name='[contact_reason_l2]' role='dimension' type='nominal' />
            <column caption='# CSAT Responses' datatype='integer' name='[count_csat_responses]' role='measure' type='quantitative' />
            <column caption='# Escalations' datatype='integer' name='[count_escalations]' role='measure' type='quantitative' />
            <column caption='Count Within Sla L2' datatype='integer' name='[count_within_sla_l2]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
