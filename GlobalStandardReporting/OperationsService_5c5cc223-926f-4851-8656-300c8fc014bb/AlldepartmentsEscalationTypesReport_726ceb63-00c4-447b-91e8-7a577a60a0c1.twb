            <column-instance column='[Calculation_772930316894855168]' derivation='None' name='[none:Calculation_772930316894855168:nk]' pivot='key' type='nominal' />
            <column-instance column='[Escalation Date  (copy)_1608488811840110592]' derivation='None' name='[none:Escalation Date  (copy)_1608488811840110592:qk]' pivot='key' type='quantitative' />
