      <column caption='Amt Commission Base Eur (unique)' datatype='real' name='[Amt Commission Base Eur (copy)_1857031198849208323]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [analytical_customer_id], [order_id], [global_entity_id]: MIN([amt_commission_base_eur])}' />
      </column>
      <column caption='Amt Commission Eur (unique)' datatype='real' name='[Amt Commission Eur (copy)_1857031198848970754]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [analytical_customer_id], [order_id], [global_entity_id]: MIN([amt_commission_eur])}' />
      </column>
      <column caption='Amt Discount Eur (unique)' datatype='real' name='[Amt Discount Eur (copy)_1857031198850371588]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [analytical_customer_id], [order_id], [global_entity_id]: MIN([amt_discount_eur])}' />
      </column>
      <column caption='Amt Voucher Eur (uniquey)' datatype='real' name='[Amt Voucher Eur (copy)_1857031198851751941]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [analytical_customer_id], [order_id], [global_entity_id]: MIN([amt_voucher_eur])}' />
      </column>
      <column caption='Level (2)' datatype='string' name='[Breakdown (copy)_3005660209780588553]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Select Breakdown (copy)_3005660209780527112]&#10;WHEN &quot;1&quot; THEN STR([vendor_name])&#10;WHEN &quot;2&quot; THEN STR([chain_name])&#10;WHEN &quot;3&quot; THEN STR([global_entity_id])&#10;WHEN &quot;4&quot; THEN STR([country_name])&#10;WHEN &quot;5&quot; THEN STR([is_acquisition_darkstore])&#10;WHEN &quot;6&quot; THEN [region]&#10;WHEN &quot;7&quot; THEN [management_entity]&#10;//WHEN &quot;8&quot; THEN [city]&#10;WHEN &quot;9&quot; THEN [store_type]&#10;WHEN &quot;10&quot; THEN [global_view]&#10;END' />
      </column>
      <column caption='Date Range' datatype='datetime' name='[Calculation_1190428074206552064]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN 1 THEN&#10;// Last 12 Months (from current month) Logic&#10;IF [Order Placed Localtime At (Months)] &gt;= DATEADD(&quot;month&quot;,-12,[Parameters].[Parameter 4])&#10;AND [Order Placed Localtime At (Months)] &lt;= DATEADD(&quot;month&quot;,-1,[Parameters].[Parameter 4])&#10;THEN [Order Placed Localtime At (Months)]&#10;END&#10;WHEN 2 THEN&#10;// Last 13 Weeks (from current week) Logic&#10;IF [Order Placed Localtime At (Week numbers)] &gt;= DATEADD(&quot;week&quot;,-12,DATETRUNC(&quot;week&quot;,[Parameters].[Parameter 4]))&#10;AND [Order Placed Localtime At (Week numbers)] &lt;= DATEADD(&quot;week&quot;,-1,DATETRUNC(&quot;week&quot;,[Parameters].[Parameter 4]))&#10;THEN [Order Placed Localtime At (Week numbers)]&#10;END&#10;WHEN 3 THEN&#10;// Last 14 Days (from Today) Logic&#10;IF [Order Placed Localtime At (Days)]&gt;= DATEADD(&quot;day&quot;,-14,[Parameters].[Parameter 4])&#10;AND [Order Placed Localtime At (Days)]&lt;= DATEADD(&quot;day&quot;,-1,[Parameters].[Parameter 4])&#10;THEN [Order Placed Localtime At (Days)]&#10;END&#10;END' />
      </column>
      <column caption='Measure' datatype='real' name='[Calculation_1190428074207330305]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;GMV&quot; THEN SUM([Calculation_1190428074264276999])&#10;WHEN &quot;GBV&quot; THEN sum([Calculation_5504102458154209297])&#10;WHEN &quot;#Orders&quot; THEN COUNTD([order_id])&#10;WHEN &quot;#Customers&quot; THEN COUNTD([analytical_customer_id])&#10;WHEN &quot;#SKUs SOLD&quot; THEN sum([sum_sku])&#10;WHEN &quot;#Items Sold&quot; THEN SUM([qty_sold])&#10;WHEN &quot;#Active Vendors&quot; THEN COUNTD([platform_vendor_id])&#10;WHEN &quot;Commission Base (Eur)&quot; THEN SUM([Amt Commission Base Eur (copy)_1857031198849208323])&#10;WHEN &quot;Commission Amt. (Eur)&quot; THEN SUM([Amt Commission Eur (copy)_1857031198848970754])&#10;WHEN &quot;Delivery Fee (Eur)&quot; THEN SUM([Calculation_5504102458154639378])&#10;WHEN &quot;Qty. Ordered&quot; THEN SUM([Calculation_790522476498026496])&#10;WHEN &quot;Qty. Sold&quot; THEN SUM([Calculation_790522476498112513])&#10;END' />
      </column>
      <column caption='Date Label' datatype='string' name='[Calculation_1190428074253799429]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3]=1&#10;THEN&#10;DATENAME(&quot;month&quot;,[order_date])&#10;&#10;ELSEIF [Parameters].[Parameter 3]=2&#10;THEN &quot;Week &quot;+ STR(DATENAME(&quot;week&quot;,[order_date])) + &quot;&#10;&quot; + &quot; ( &quot; +&#10;STR(MONTH(DATETRUNC(&apos;week&apos;,[order_date])))+&quot;/&quot;+&#10;STR(DAY(DATETRUNC(&apos;week&apos;,[order_date])))&#10;+ &quot; - &quot; +&#10;STR(MONTH(DATETRUNC(&apos;week&apos;,DATEADD(&apos;week&apos;,1,[order_date]))-1))+&quot;/&quot;+&#10;STR(DAY(DATETRUNC(&apos;week&apos;,DATEADD(&apos;week&apos;,1,[order_date]))-1))&#10;+ &quot; ) &quot;&#10;&#10;ELSEIF [Parameters].[Parameter 3]=3 &#10;THEN STR(DATEPART(&quot;month&quot;,[order_date]))+&quot;/&quot;+STR(DATEPART(&quot;day&quot;,[order_date]))&#10;END' />
      </column>
      <column caption='Amt Gmv Eur (unique)' datatype='real' name='[Calculation_1190428074264276999]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [analytical_customer_id], [order_id], [global_entity_id]: MIN([amt_gmv_eur])}' />
      </column>
      <column caption='Basket Penetration' datatype='real' name='[Calculation_1190428074361303049]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([order_id])/ sum({ FIXED [region] : COUNTD( if not ISNULL([level_one]) then [order_id] end)})' />
      </column>
      <column caption='Zombie(%)' datatype='real' name='[Calculation_1242782395109285889]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd([sku]) / COUNTD([pim_sku])' />
      </column>
      <column caption='Avg. SKU per Vendor' datatype='real' name='[Calculation_1440940785339867136]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_753227058167840768])/COUNTD([pim_vendor_id])' />
      </column>
      <column caption='Frequency' datatype='real' name='[Calculation_1857031198869749766]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(COUNTD([order_id])/COUNTD([analytical_customer_id]), 2)' />
      </column>
      <column caption='Top 3' datatype='boolean' name='[Calculation_3005660209716801540]' role='measure' type='nominal'>
        <calculation class='tableau' formula='LAST()&lt;3'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Apply' datatype='string' name='[Calculation_3406269436258721793]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Apply&quot;' />
      </column>
      <column caption='ABS' datatype='real' name='[Calculation_4551028201882918912]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_790522476498112513])/countd(IF [Calculation_790522476498026496]&gt;0 AND ISNULL([order_id])=FALSE THEN [order_id] END)' />
      </column>
      <column caption='ABV' datatype='real' name='[Calculation_5121929805740396544]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='round(sum([Calculation_5504102458154209297])/COUNTD([order_id]), 2)' />
      </column>
      <column caption='Order Amt Total Price Paid Eur' datatype='real' name='[Calculation_5428456038427230208]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [global_entity_id], [order_id], [analytical_customer_id]: max([amt_total_price_paid_eur])}' />
      </column>
      <column caption='#Customers' datatype='integer' name='[Calculation_5504102457499443208]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([analytical_customer_id])' />
      </column>
      <column caption='#Vendors' datatype='integer' name='[Calculation_5504102457499828233]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([platform_vendor_id])' />
      </column>
      <column caption='Delivery Fee %' datatype='real' name='[Calculation_5504102457871159312]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='round(sum([Calculation_5504102458154639378])/sum([Calculation_5504102458154209297]), 2)' />
      </column>
      <column caption='Amt Gbv Eur (unique)' datatype='real' name='[Calculation_5504102458154209297]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [analytical_customer_id], [order_id], [global_entity_id]: MIN([amt_gbv_eur])}' />
      </column>
      <column caption='Amt Delivery Fee Eur (unique)' datatype='real' name='[Calculation_5504102458154639378]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [analytical_customer_id], [order_id], [global_entity_id]: MIN([amt_delivery_fee_eur])}' />
      </column>
      <column caption='Date_str' datatype='string' name='[Calculation_6032360661050830848]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='str(date([order_date]))' />
      </column>
      <column caption='Min Order Date' datatype='date' name='[Calculation_752875241350209536]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [analytical_customer_id] : min(if [is_acquisition_qcommerce] = true then [order_date] else null end)}' />
      </column>
      <column caption='Repurchase Order' datatype='string' name='[Calculation_752875241350520833]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [analytical_customer_id] : min(IF [order_date]&gt;[Calculation_752875241350209536] then [order_id] else NULL end)}' />
      </column>
      <column caption='Qty Ordered (unique)' datatype='integer' name='[Calculation_790522476498026496]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [analytical_customer_id], [order_id], [global_entity_id]: MIN([qty_ordered])}' />
      </column>
      <column caption='Qty Sold (Unique)' datatype='integer' name='[Calculation_790522476498112513]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [analytical_customer_id], [order_id], [global_entity_id]: MIN([qty_sold])}' />
      </column>
      <column caption='Commission %' datatype='real' name='[Calculation_896568212385193989]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='round(sum([Amt Commission Eur (copy)_1857031198848970754])/sum([Amt Commission Base Eur (copy)_1857031198849208323]), 2)' />
