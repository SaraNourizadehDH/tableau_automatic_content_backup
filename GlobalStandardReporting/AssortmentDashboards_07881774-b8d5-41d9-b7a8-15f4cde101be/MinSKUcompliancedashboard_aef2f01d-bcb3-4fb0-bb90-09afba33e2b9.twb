      <aliases enabled='yes' />
      <column caption='Diff_SKU (from Shops)' datatype='real' name='[Calculation_2052867434271051776]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [Region], [country], [pim_level_one_category]: AVG([Calculation_2052867434310778882])} - {FIXED [region], [country_name], [pim_level_one_name], [vendor_name] : AVG([distinct_online_sku])}' />
      </column>
      <column caption='Compliance_flag' datatype='string' name='[Calculation_2052867434286460929]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_2052867434271051776] &lt; 0 then &apos;compliant&apos; else &apos;non-compliant&apos; end' />
        <aliases>
          <alias key='&quot;compliant&quot;' value='#Compliant' />
          <alias key='&quot;non-compliant&quot;' value='#Non-compliant' />
        </aliases>
      </column>
      <column caption='Shops_min_SKU' datatype='integer' name='[Calculation_2052867434310778882]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Vertical] in (&apos;Shops&apos;) then [min_sku] end' />
      </column>
      <column caption='Count_flag' datatype='integer' name='[Calculation_3265461634331348993]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF {fixed [vendor_name], [pim_level_one_category]: avg([Calculation_2052867434271051776])} &lt; 0 then 1 END' />
      </column>
      <column caption='F/UF Assortment Completeness' datatype='string' name='[Calculation_3265461634358169607]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF TOTAL(SUM([Calculation_3265461634331348993]))&gt;= 5 THEN &apos;Complete F/UF Assortment&apos;&#10;&#10;ELSE &apos;Partial F/UF Assortment&apos;&#10;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Non_compliant_vendors' datatype='integer' name='[Calculation_3265461634371710985]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='{fixed [vendor_name]: countd(if [Calculation_2052867434271051776] &gt; 0 then [vendor_name] end)}' />
      </column>
      <column caption='Compliance_count' datatype='integer' name='[Calculation_3265461634381217802]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [vendor_name] : sum([Calculation_3265461634331348993])}' />
      </column>
      <column caption='Non_compliant_%' datatype='real' name='[Calculation_3265461634387562507]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_3265461634371710985])/COUNTD([vendor_name])' />
      </column>
      <column caption='Compliance_flag (DMarts)' datatype='string' name='[Compliance_flag (copy)_2052867434313768965]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Diff_SKU (copy)_2052867434311593988] &lt; 0 then &apos;compliant&apos; else &apos;non-compliant&apos; end' />
      </column>
      <column caption='Compliance_flag (copy)' datatype='integer' name='[Compliance_flag (copy)_3265461634345009157]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if [Calculation_2052867434271051776] &lt; 0 then 1 else 0 end' />
      </column>
      <column caption='Count_flag (copy)' datatype='integer' name='[Count_flag (copy)_3265461634365861896]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='//IF {fixed [Vendor Name], [Pim Level One Category]: avg([Diff_SKU (from Shops)])} &lt; 0 then 1 END&#10;//IF &#10;{FIXED [pim_level_one_category]: COUNTD([Calculation_3265461634331348993])}&#10;// / {FIXED [Pim Level Zero Category]: COUNTD([Pim Level One Category])} &lt; 1 THEN &quot;YES&quot; ELSE &quot;NO&quot; END' />
      </column>
      <column caption='Diff_SKU (from DMarts)' datatype='real' name='[Diff_SKU (copy)_2052867434311593988]' role='measure' type='quantitative'>
