              <calculation class='tableau' formula='countd([pim_vendor_id])' />
            </column>
            <column caption='LT5Categories' datatype='boolean' name='[Calculation_1242782395120762882]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{FIXED [pim_vendor_id]: COUNTD(IF [pim_category_role] IN (&apos;Core&apos;) then [pim_pim_level_two_name] END)&lt;=5}' />
            </column>
