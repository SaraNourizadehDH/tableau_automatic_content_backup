            <column-instance column='[pim_main_store_type]' derivation='None' name='[none:pim_main_store_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[pim_region]' derivation='None' name='[none:pim_region:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1242782395095822336]' derivation='User' name='[pcto:usr:Calculation_1242782395095822336:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Columns' type='PctTotal' />
            </column-instance>
            <column datatype='string' name='[pim_category_role]' role='dimension' type='nominal' />
            <column caption='Pim Chain Name' datatype='string' name='[pim_chain_name]' role='dimension' type='nominal' />
            <column caption='Pim City' datatype='string' name='[pim_city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Pim Is Active' datatype='boolean' name='[pim_is_active]' role='dimension' type='nominal' />
            <column datatype='string' name='[pim_main_store_type]' role='dimension' type='nominal' />
            <column caption='Pim Pim Level Two Name' datatype='string' name='[pim_pim_level_two_name]' role='dimension' type='nominal' />
