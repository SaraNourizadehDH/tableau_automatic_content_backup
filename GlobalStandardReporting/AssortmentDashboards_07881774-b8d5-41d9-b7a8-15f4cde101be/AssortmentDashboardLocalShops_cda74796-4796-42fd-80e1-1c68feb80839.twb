            <column-instance column='[Calculation_5504102457499828233]' derivation='User' name='[usr:Calculation_5504102457499828233:qk]' pivot='key' type='quantitative' />
            <column caption='Vendor Id' datatype='string' name='[vendor_id]' role='dimension' type='nominal' />
