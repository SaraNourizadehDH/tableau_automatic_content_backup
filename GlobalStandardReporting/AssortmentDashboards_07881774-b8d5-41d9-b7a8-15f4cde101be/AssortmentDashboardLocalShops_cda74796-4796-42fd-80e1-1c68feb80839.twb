            <column-instance column='[Calculation_1242782395120762882]' derivation='None' name='[none:Calculation_1242782395120762882:nk]' pivot='key' type='nominal' />
            <column-instance column='[pim_chain_name]' derivation='None' name='[none:pim_chain_name:nk]' pivot='key' type='nominal' />
