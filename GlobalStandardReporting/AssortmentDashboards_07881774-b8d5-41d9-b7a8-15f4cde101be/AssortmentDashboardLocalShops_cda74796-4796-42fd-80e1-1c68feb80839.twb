    <worksheet name='Graph - tab 1'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Bold' fontsize='12'>Trend Over Time </run>
            <run fontcolor='#ffffff' fontname='Tableau Light' fontsize='8' italic='true'>(based on </run>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Light' fontsize='8' italic='true'>Measure</run>
            <run fontcolor='#ffffff' fontname='Tableau Light' fontsize='8' italic='true'> and </run>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Light' fontsize='8' italic='true'>Breakdown</run>
            <run fontcolor='#ffffff' fontname='Tableau Light' fontsize='8' italic='true'> selection)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='assortment_master_table_full_outer (local_shops_analytics)' name='federated.0oji0s203z8y8e0zrdbpy1a2iem2' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Measure' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;\#Orders&quot;'>
              <calculation class='tableau' formula='&quot;#Orders&quot;' />
            </column>
            <column alias='Date' caption='Select Date Range' datatype='integer' name='[Parameter 3]' param-domain-type='list' role='measure' type='quantitative' value='3'>
              <calculation class='tableau' formula='3' />
              <aliases>
                <alias key='1' value='Months' />
                <alias key='2' value='Weeks' />
                <alias key='3' value='Date' />
              </aliases>
            </column>
            <column alias='Region' caption='Pim Breakdown (A)' datatype='string' name='[Pim Breakdown (copy)_896568212338388993]' param-domain-type='list' role='measure' type='nominal' value='&quot;6&quot;'>
              <calculation class='tableau' formula='&quot;6&quot;' />
              <aliases>
                <alias key='&quot;1&quot;' value='Vendor Name' />
                <alias key='&quot;10&quot;' value='Global View' />
                <alias key='&quot;2&quot;' value='Chain Name' />
                <alias key='&quot;3&quot;' value='Global Entity ID' />
                <alias key='&quot;4&quot;' value='Country' />
                <alias key='&quot;5&quot;' value='Is Acquisition Darkstore' />
                <alias key='&quot;6&quot;' value='Region' />
                <alias key='&quot;7&quot;' value='Mgmt. Entity' />
                <alias key='&quot;8&quot;' value='City' />
                <alias key='&quot;9&quot;' value='Shop type' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0oji0s203z8y8e0zrdbpy1a2iem2'>
            <column caption='Amt Commission Base Eur (unique)' datatype='real' name='[Amt Commission Base Eur (copy)_1857031198849208323]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [analytical_customer_id], [order_id], [global_entity_id]: MIN([amt_commission_base_eur])}' />
            </column>
            <column caption='Amt Commission Eur (unique)' datatype='real' name='[Amt Commission Eur (copy)_1857031198848970754]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [analytical_customer_id], [order_id], [global_entity_id]: MIN([amt_commission_eur])}' />
            </column>
            <column caption='Measure' datatype='real' name='[Calculation_1190428074207330305]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;GMV&quot; THEN SUM([Calculation_1190428074264276999])&#10;WHEN &quot;GBV&quot; THEN sum([Calculation_5504102458154209297])&#10;WHEN &quot;#Orders&quot; THEN COUNTD([order_id])&#10;WHEN &quot;#Customers&quot; THEN COUNTD([analytical_customer_id])&#10;WHEN &quot;#SKUs SOLD&quot; THEN COUNTD([sku])&#10;WHEN &quot;#Items Sold&quot; THEN SUM([Qty Sold (copy)_896568212355977220])&#10;WHEN &quot;#Active Vendors&quot; THEN COUNTD([vendor_id])&#10;WHEN &quot;Commission Base (Eur)&quot; THEN SUM([Amt Commission Base Eur (copy)_1857031198849208323])&#10;WHEN &quot;Commission Amt. (Eur)&quot; THEN SUM([Amt Commission Eur (copy)_1857031198848970754])&#10;WHEN &quot;Delivery Fee (Eur)&quot; THEN SUM([Calculation_5504102458154639378])&#10;WHEN &quot;Qty. Ordered&quot; THEN SUM([Qty Ordered (copy)_896568212349198339])&#10;END' />
            </column>
            <column caption='Date Label' datatype='string' name='[Calculation_1190428074253799429]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3]=1&#10;THEN&#10;DATENAME(&quot;month&quot;,[order_placed_localtime_at])&#10;&#10;ELSEIF [Parameters].[Parameter 3]=2&#10;THEN &quot;Week &quot;+ STR(DATENAME(&quot;week&quot;,[order_placed_localtime_at])) + &quot;&#10;&quot; + &quot; ( &quot; +&#10;STR(MONTH(DATETRUNC(&apos;week&apos;,[order_placed_localtime_at])))+&quot;/&quot;+&#10;STR(DAY(DATETRUNC(&apos;week&apos;,[order_placed_localtime_at])))&#10;+ &quot; - &quot; +&#10;STR(MONTH(DATETRUNC(&apos;week&apos;,DATEADD(&apos;week&apos;,1,[order_placed_localtime_at]))-1))+&quot;/&quot;+&#10;STR(DAY(DATETRUNC(&apos;week&apos;,DATEADD(&apos;week&apos;,1,[order_placed_localtime_at]))-1))&#10;+ &quot; ) &quot;&#10;&#10;ELSEIF [Parameters].[Parameter 3]=3 &#10;THEN STR(DATEPART(&quot;month&quot;,[order_placed_localtime_at]))+&quot;/&quot;+STR(DATEPART(&quot;day&quot;,[order_placed_localtime_at]))&#10;END' />
            </column>
            <column caption='Amt Gmv Eur (unique)' datatype='real' name='[Calculation_1190428074264276999]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [analytical_customer_id], [order_id], [global_entity_id]: MIN([amt_gmv_eur])}' />
            </column>
            <column caption='Amt Gbv Eur (unique)' datatype='real' name='[Calculation_5504102458154209297]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [analytical_customer_id], [order_id], [global_entity_id]: MIN([amt_gbv_eur])}' />
            </column>
            <column caption='Amt Delivery Fee Eur (unique)' datatype='real' name='[Calculation_5504102458154639378]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [analytical_customer_id], [order_id], [global_entity_id]: MIN([amt_delivery_fee_eur])}' />
            </column>
            <column caption='Dimension A' datatype='string' name='[Measure (copy)_3005660209668468737]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Pim Breakdown (copy)_896568212338388993]&#10;WHEN &quot;1&quot; THEN STR([vendor_name])&#10;WHEN &quot;2&quot; THEN STR([chain_name])&#10;WHEN &quot;3&quot; THEN STR([global_entity_id])&#10;WHEN &quot;4&quot; THEN STR([country_name])&#10;WHEN &quot;5&quot; THEN STR([is_acquisition_darkstore])&#10;WHEN &quot;6&quot; THEN [region]&#10;WHEN &quot;7&quot; THEN [management_entity]&#10;WHEN &quot;8&quot; THEN [city]&#10;WHEN &quot;9&quot; THEN [main_store_type]&#10;WHEN &quot;10&quot; THEN [global_view]&#10;END' />
            </column>
            <column caption='Qty Ordered (unique)' datatype='integer' name='[Qty Ordered (copy)_896568212349198339]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [analytical_customer_id], [order_id], [global_entity_id]:MIN([qty_ordered])}' />
            </column>
            <column caption='Qty Sold (unique)' datatype='integer' name='[Qty Sold (copy)_896568212355977220]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [analytical_customer_id], [order_id], [global_entity_id]:min([qty_sold])}' />
