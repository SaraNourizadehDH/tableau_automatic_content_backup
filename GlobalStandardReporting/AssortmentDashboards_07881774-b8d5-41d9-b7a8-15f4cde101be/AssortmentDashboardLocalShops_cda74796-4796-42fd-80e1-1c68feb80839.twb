    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='GLOSSARY'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/AssortmentDashboard-LocalShops/GLOSSARY?rev=' id='GLOSSARY' path='/t/GlobalStandardReporting/workbooks/AssortmentDashboard-LocalShops' revision='' site='GlobalStandardReporting' />
      <style />
      <size sizing-mode='automatic' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='25060' id='3' type-v2='text' w='98698' x='651' y='24939'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontname='Tableau Bold' underline='true'>&quot;Health Metrics&quot; Definition:</run>
              <run>Æ&#10;</run>
              <run bold='true'>1. </run>
              <run bold='true' fontcolor='#000000'>ABV Eur</run>
              <run bold='true'> : Total GBV (in Euros) per unique successful orders</run>
              <run>Æ&#10;</run>
              <run bold='true'>2. </run>
              <run bold='true' fontcolor='#000000'>#Orders</run>
              <run bold='true'> : Number of successful orders</run>
              <run>Æ&#10;</run>
              <run bold='true'>3.</run>
              <run bold='true' fontcolor='#000000'> Amt GMV Eur</run>
              <run bold='true'> : Total Gross Merchandise Value (in Euros)</run>
              <run>Æ&#10;</run>
              <run bold='true'>4. </run>
              <run bold='true' fontcolor='#000000'>#Customers</run>
              <run bold='true'> : Unique customer count</run>
              <run>Æ&#10;</run>
              <run bold='true'>5. </run>
              <run bold='true' fontcolor='#000000'>#Vendors</run>
              <run bold='true'> : Unique vendor count</run>
              <run>Æ&#10;</run>
              <run bold='true'>6.</run>
              <run bold='true' fontcolor='#000000'> Qty Ordered (unique)</run>
              <run bold='true'> : Total quantity of items ordered</run>
              <run>Æ&#10;</run>
              <run bold='true'>7.</run>
              <run bold='true' fontcolor='#000000'> Qty Sold</run>
              <run bold='true'> : Total quantity of items sold</run>
              <run>Æ&#10;</run>
              <run bold='true'>8. </run>
              <run bold='true' fontcolor='#000000'>#Distinct SKU Sold</run>
              <run bold='true'> : Distinct SKU sold</run>
              <run>Æ&#10;</run>
              <run bold='true'>9.</run>
              <run bold='true' fontcolor='#000000'> #Orders</run>
              <run bold='true'> : Total orders</run>
              <run>Æ&#10;</run>
              <run bold='true'>10. </run>
              <run bold='true' fontcolor='#000000'>Amt Commission Base (Eur)</run>
              <run bold='true'> : Total Commission Base on which Commission is charged (in Euros)</run>
              <run>Æ&#10;</run>
              <run bold='true'>11. </run>
              <run bold='true' fontcolor='#000000'>Amt Commission (Eur)</run>
              <run bold='true'> : Total Commission charged (in Euros)</run>
              <run>Æ&#10;</run>
              <run bold='true'>12.</run>
              <run bold='true' fontcolor='#000000'> Amt Delivery Fee (Eur)</run>
              <run bold='true'> : Total Delivery Fee charged (in Euros)</run>
              <run>Æ&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
