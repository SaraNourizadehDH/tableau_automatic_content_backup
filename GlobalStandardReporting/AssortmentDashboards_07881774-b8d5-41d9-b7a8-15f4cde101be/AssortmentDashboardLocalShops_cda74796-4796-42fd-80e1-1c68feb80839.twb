        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Bold' fontsize='12'>OKR - Supermarket + Hypermarket ABS (*</run>
            <run fontcolor='#ffffff' fontname='Tableau Light' fontsize='10'>no filter applicable</run>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Bold' fontsize='12'>)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='assortment_master_table_full_outer (local_shops_analytics)' name='federated.0oji0s203z8y8e0zrdbpy1a2iem2' />
          </datasources>
          <datasource-dependencies datasource='federated.0oji0s203z8y8e0zrdbpy1a2iem2'>
            <column caption='ABS (Qty per basket)' datatype='real' name='[ABS (copy)_3406269436256325632]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Qty Ordered (copy)_896568212349198339])/countd(IF [Qty Ordered (copy)_896568212349198339]&gt;0 AND ISNULL([order_id])=FALSE THEN [order_id] END)' />
            </column>
            <column caption='#Vendors' datatype='integer' name='[Calculation_5504102457499828233]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([vendor_id])' />
            </column>
            <column datatype='datetime' name='[Order Placed Localtime At (Days)]' role='dimension' type='quantitative' user:agg-type='Day-Trunc' user:base-field='order_placed_localtime_at' user:ui-builder='date-bin-builder'>
              <calculation class='tableau' formula='DATETRUNC(&apos;day&apos;, [order_placed_localtime_at])' />
            </column>
            <column caption='Qty Ordered (unique)' datatype='integer' name='[Qty Ordered (copy)_896568212349198339]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [analytical_customer_id], [order_id], [global_entity_id]:MIN([qty_ordered])}' />
            </column>
            <column caption='Analytical Customer Id' datatype='string' name='[analytical_customer_id]' role='dimension' type='nominal' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Is Sent' datatype='boolean' name='[is_sent]' role='dimension' type='nominal' />
            <column caption='Main Store Type' datatype='string' name='[main_store_type]' role='dimension' type='nominal' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column-instance column='[Order Placed Localtime At (Days)]' derivation='None' name='[none:Order Placed Localtime At (Days):ok]' pivot='key' type='ordinal' />
            <column-instance column='[is_sent]' derivation='None' name='[none:is_sent:nk]' pivot='key' type='nominal' />
            <column-instance column='[main_store_type]' derivation='None' name='[none:main_store_type:nk]' pivot='key' type='nominal' />
