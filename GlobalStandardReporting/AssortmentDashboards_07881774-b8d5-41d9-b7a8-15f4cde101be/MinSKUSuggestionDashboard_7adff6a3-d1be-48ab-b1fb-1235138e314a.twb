      <aliases enabled='yes' />
      <column caption='Adjusted Item COGS' datatype='real' name='[Adjusted_Item_COGS]' role='measure' type='quantitative' />
      <column caption='Adjusted Item Subtotal' datatype='real' name='[Adjusted_Item_Subtotal]' role='measure' type='quantitative' />
      <column caption='Vendor_level_listed_SKU_count' datatype='integer' name='[Calculation_3341600593737801728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{Fixed [pim_region], [pim_country_name], [pim_management_entity], [pim_store_type], [pim_chain_name], [pim_vendor_name], [pim_pim_level_one_name]: COUNTD([pim_sku])}' />
      </column>
      <column caption='Healthy Vendor Flag' datatype='boolean' name='[Calculation_3341600593748697090]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_3341600593737801728] &gt; [Vendor_level_listed_SKU_count (copy)_3341600593747599361] then True else False end' />
      </column>
      <column caption='Z-Score' datatype='real' name='[Calculation_3341600593893531654]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_3341600593737801728] - [Vendor_level_listed_SKU_count (copy)_3341600593747599361]) / [Vertical_level_listed_SKU_count (copy)_3341600593899778055]' />
      </column>
      <column caption='Size' datatype='integer' name='[Calculation_3341600593906225160]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SIZE()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Vertical Basket Penetration (%)' datatype='real' name='[Calculation_3341600593952796681]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Vertical_level_order_count (copy)_3341600593979359243]) / AVG([Calculation_3341600593953439754])' />
      </column>
      <column caption='Vertical_level_order_count' datatype='integer' name='[Calculation_3341600593953439754]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [region], [country_name], [management_entity], [store_type]: COUNTD([order_id])}' />
      </column>
      <column caption='Growth Avenue (%)' datatype='real' name='[Calculation_3341600593981804557]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_3341600593952796681] - [Vertical Basket Penetration (%) (copy)_3341600593980043276])' />
      </column>
      <column caption='!Size' datatype='integer' name='[Calculation_3341600594063556622]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Top Percentile' datatype='boolean' name='[Calculation_3341600594077564943]' role='measure' type='nominal'>
        <calculation class='tableau' formula='SUM([item_qty_sold]) &gt;= WINDOW_PERCENTILE(SUM([item_qty_sold]),.8)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Top 100' datatype='boolean' name='[Calculation_3341600594079268880]' role='measure' type='nominal'>
        <calculation class='tableau' formula='INDEX() &lt;= 100'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Fulfilled Quantity' datatype='real' name='[Fulfilled_Quantity]' role='measure' type='quantitative' />
      <column caption='Growth Avenue (%) (Chain level)' datatype='real' name='[Growth Avenue (%) (copy)_5658350758908833793]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_3341600593952796681] - [Vendor Basket Penetration (%) (copy)_5658350758907920384])' />
      </column>
      <column caption='Healthy Vendor Flag (copy)' datatype='integer' name='[Healthy Vendor Flag (copy)_3341600593892167685]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_3341600593737801728] &gt; [Vendor_level_listed_SKU_count (copy)_3341600593747599361] then 1 else 0 end' />
      </column>
      <column caption='Order Status' datatype='string' name='[Order_Status]' role='dimension' type='nominal' />
      <column caption='Ordered Quantity' datatype='real' name='[Ordered_Quantity]' role='measure' type='quantitative' />
