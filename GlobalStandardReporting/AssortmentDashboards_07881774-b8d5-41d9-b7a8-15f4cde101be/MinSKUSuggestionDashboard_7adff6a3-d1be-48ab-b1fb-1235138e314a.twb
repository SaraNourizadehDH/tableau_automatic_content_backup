      <column caption='Chain Basket Penetration (%)' datatype='real' name='[Vendor Basket Penetration (%) (copy)_5658350758907920384]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG({fixed [region], [country_name], [management_entity], [chain_id], [chain_name], [pim_level_one_name] : COUNTD([order_id])}) / AVG({fixed [region], [country_name], [management_entity], [store_type], [pim_level_one_name] : COUNTD([order_id])})' />
