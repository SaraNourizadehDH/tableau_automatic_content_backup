      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1f51fbd1xe8tzf19lg7kq1sds9k0]&quot;' value='Min Price Sold (Local Currency)' />
          <alias key='&quot;[federated.1f51fbd1xe8tzf19lg7kq1sds9k0].[avg:rev_per_vendor:qk]&quot;' value='Revenue / Vendor (Eur)' />
          <alias key='&quot;[federated.1f51fbd1xe8tzf19lg7kq1sds9k0].[min:min_catalog_original_price_lc:qk]&quot;' value='Min Catalog Original Price (LC) [Current]' />
        </aliases>
      </column>
      <column caption='Vendor Info' datatype='string' name='[Calculation_1489706344300732416]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot; ( &quot; + [platform_vendor_id] + &quot; ) - &quot; + [vendor_name] + &quot; - &quot; + [global_entity_id]&#10;&#10;//&quot; ( &quot; + [Platform Vendor Id] + &quot; ) - &quot; + [vendor_name] + &quot; - &quot; + [Global Entity Id] + &quot; - &quot; + [City]' />
      </column>
      <column caption='Catalog Status' datatype='string' name='[Calculation_3093902604589355008]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='If [is_present_in_assortment] = 0 then &apos;Not present in Catalog&apos;&#10;elseif [status] = &apos;Off&apos; then &apos;Inactive&apos;&#10;ELSEIF [status] = &apos;Out of Catalog&apos; then &apos;Deleted from Catalog&apos;&#10;ELSEIF [status] = &apos;In Catalog&apos; then &apos;Present in Catalog&apos;&#10;end' />
      </column>
      <column caption='Revenue / Vendor (EUR)' datatype='real' name='[Calculation_5955588321266012160]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND((SUM([total_price_paid_eur])/COUNT([platform_vendor_id])),2)' />
      </column>
      <column caption='25th Percentile Price LC' datatype='real' name='[Calculation_5955588321272782850]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_PERCENTILE(SUM([avg_price_sold]), 0.25)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Country or City Level' datatype='string' name='[Calculation_600597261854785536]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [city] = &apos;country_level&apos; then &apos;Country Level&apos;&#10;else &apos;City Level&apos; end' />
      </column>
