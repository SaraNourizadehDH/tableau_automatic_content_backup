    <worksheet name='Variant A (% Metric)'>
      <table>
        <view>
          <datasources>
            <datasource caption='waiting_for_transport_orders_cancellation_experiment' name='federated.0vg9gty0jlgoxv1anoide144u8d9' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='% Metric' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Vendor Fail Rate&quot;'>
              <calculation class='tableau' formula='&quot;Vendor Fail Rate&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0vg9gty0jlgoxv1anoide144u8d9'>
            <column caption='Date' datatype='string' name='[Calculation_693061775437230082]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [date_type]&#10;WHEN &quot;Daily&quot; THEN STR(DATE([created_date]))&#10;WHEN &quot;Weekly&quot; THEN STR(YEAR([created_date]))+&quot;-W&quot;+STR(ISOWEEK([created_date]))&#10;END' />
            </column>
            <column caption='% Metric Numerator' datatype='integer' name='[Calculation_693061775494160390]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &quot;Vendor Fail Rate&quot; THEN [vendor_failed_orders]&#10;WHEN &quot;Closed Vendor Fail Rate&quot; THEN [closed_vendor_failed_orders]&#10;WHEN &quot;Too Busy Vendor Fail Rate&quot; THEN [too_busy_vendor_failed_orders]&#10;WHEN &quot;Unreachable Vendor Fail Rate&quot; THEN [unreachable_vendor_failed_orders]&#10;WHEN &quot;No Response Vendor Fail Rate&quot; THEN [no_response_vendor_failed_orders]&#10;WHEN &quot;Item Unavailable Vendor Fail Rate&quot; THEN [item_unavailable_vendor_failed_orders]&#10;WHEN &quot;Item Unavailable Vendor Failed Waiting For Transport Orders Share %&quot; THEN [item_unavailable_vendor_failed_waiting_for_transport_orders]&#10;WHEN &quot;Reconciliation Save Rate&quot; THEN [reconciled_orders]&#10;WHEN &quot;Reconciliable Order Share %&quot; THEN [reconcile_flow_orders]&#10;END' />
            </column>
            <column caption='% Metric Denominator' datatype='integer' name='[Calculation_693061775494680583]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &quot;Vendor Fail Rate&quot; THEN [orders]&#10;WHEN &quot;Closed Vendor Fail Rate&quot; THEN [orders]&#10;WHEN &quot;Too Busy Vendor Fail Rate&quot; THEN [orders]&#10;WHEN &quot;Unreachable Vendor Fail Rate&quot; THEN [orders]&#10;WHEN &quot;No Response Vendor Fail Rate&quot; THEN [orders]&#10;WHEN &quot;Item Unavailable Vendor Fail Rate&quot; THEN [orders]&#10;WHEN &quot;Item Unavailable Vendor Failed Waiting For Transport Orders Share %&quot; THEN [item_unavailable_vendor_failed_orders]&#10;WHEN &quot;Reconciliation Save Rate&quot; THEN [reconcilable_orders]&#10;WHEN &quot;Reconciliable Order Share %&quot; THEN [orders]&#10;END' />
