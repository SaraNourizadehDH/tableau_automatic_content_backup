    <worksheet name='Overall Experiment Post - Pre'>
      <table>
        <view>
          <datasources>
            <datasource caption='waiting_for_transport_orders_cancellation_experiment' name='federated.0vg9gty0jlgoxv1anoide144u8d9' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Variant' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Variant A&quot;'>
              <calculation class='tableau' formula='&quot;Variant A&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0vg9gty0jlgoxv1anoide144u8d9'>
            <column caption='Post ∆ - Pre ∆ Tag' datatype='string' name='[Calculation_337277410518667266]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;Post ∆ - Pre ∆&quot;' />
            </column>
            <column caption='Timespan' datatype='boolean' name='[Calculation_396387155265060867]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_418201462836531203] != &quot;N/A&quot; OR [Calculation_418201462828920833] != &quot;N/A&quot; THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Analysis Timespan (Pre-Rollout)' datatype='string' name='[Calculation_418201462828920833]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [experiment_name] = &apos;APAC-PH&apos; AND [created_date] &gt;= DATE(&apos;2023-01-23&apos;) AND [created_date] &lt;= DATE(&apos;2023-03-05&apos;) THEN &quot;W04-W09&quot;&#10;ELSEIF [experiment_name] = &apos;APAC-SG&apos; AND [created_date] &gt;= DATE(&apos;2023-01-23&apos;) AND [created_date] &lt;= DATE(&apos;2023-03-05&apos;) THEN &quot;W04-W09&quot;&#10;ELSEIF [experiment_name] = &apos;APAC-TH&apos; AND [created_date] &gt;= DATE(&apos;2023-01-23&apos;) AND [created_date] &lt;= DATE(&apos;2023-03-05&apos;) THEN &quot;W04-W09&quot;&#10;ELSEIF [experiment_name] = &apos;APAC-TW&apos; AND [created_date] &gt;= DATE(&apos;2023-01-23&apos;) AND [created_date] &lt;= DATE(&apos;2023-03-05&apos;) THEN &quot;W04-W09&quot;&#10;ELSE &quot;N/A&quot;&#10;END' />
            </column>
            <column caption='Analysis Timespan (Post-Rollout)' datatype='string' name='[Calculation_418201462836531203]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [experiment_name] = &apos;APAC-PH&apos; AND [created_date] &gt;= DATE(&apos;2023-03-13&apos;) AND [created_date] &lt;= DATE(&apos;2023-04-23&apos;) THEN &quot;W11-W16&quot;&#10;ELSEIF [experiment_name] = &apos;APAC-SG&apos; AND [created_date] &gt;= DATE(&apos;2023-03-13&apos;) AND [created_date] &lt;= DATE(&apos;2023-04-23&apos;) THEN &quot;W11-W16&quot;&#10;ELSEIF [experiment_name] = &apos;APAC-TH&apos; AND [created_date] &gt;= DATE(&apos;2023-03-13&apos;) AND [created_date] &lt;= DATE(&apos;2023-04-23&apos;) THEN &quot;W11-W16&quot;&#10;ELSEIF [experiment_name] = &apos;APAC-TW&apos; AND [created_date] &gt;= DATE(&apos;2023-03-13&apos;) AND [created_date] &lt;= DATE(&apos;2023-04-23&apos;) THEN &quot;W11-W16&quot;&#10;ELSE &quot;N/A&quot;&#10;END' />
            </column>
            <column caption='Variant' datatype='boolean' name='[Calculation_4848195386621218820]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1] = [experiment_group]&#10;OR [experiment_group] = &quot;Baseline&quot;' />
            </column>
            <column caption='Reconciliation Save Rate (Post ∆ - Pre ∆)' datatype='real' name='[Offline Duration % (Post ∆ - Pre ∆) (copy)_1164110140431171589]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] != &apos;Baseline&apos; AND [Calculation_418201462836531203] != &apos;N/A&apos; THEN [reconciled_orders] END)&#10;    /&#10;    SUM(IF [experiment_group] != &apos;Baseline&apos; AND [Calculation_418201462836531203] != &apos;N/A&apos; THEN [reconcilable_orders] END)&#10;    })&#10;    -&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [Calculation_418201462836531203] != &apos;N/A&apos; THEN [reconciled_orders] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [Calculation_418201462836531203] != &apos;N/A&apos; THEN [reconcilable_orders] END)&#10;    })&#10;)&#10;-&#10;(&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] != &apos;Baseline&apos; AND [Calculation_418201462828920833] != &apos;N/A&apos; THEN [reconciled_orders] END)&#10;    /&#10;    SUM(IF [experiment_group] != &apos;Baseline&apos; AND [Calculation_418201462828920833] != &apos;N/A&apos; THEN [reconcilable_orders] END)&#10;    })&#10;    -&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [Calculation_418201462828920833] != &apos;N/A&apos; THEN [reconciled_orders] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [Calculation_418201462828920833] != &apos;N/A&apos; THEN [reconcilable_orders] END)&#10;    })&#10;)' />
            </column>
            <column caption='Vendor Fail Rate (Post ∆ - Pre ∆)' datatype='real' name='[Offline Duration % (Post ∆ - Pre ∆) (copy)_337277410519207941]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] != &apos;Baseline&apos; AND [Calculation_418201462836531203] != &apos;N/A&apos; THEN [vendor_failed_orders] END)&#10;    /&#10;    SUM(IF [experiment_group] != &apos;Baseline&apos; AND [Calculation_418201462836531203] != &apos;N/A&apos; THEN [orders] END)&#10;    })&#10;    -&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [Calculation_418201462836531203] != &apos;N/A&apos; THEN [vendor_failed_orders] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [Calculation_418201462836531203] != &apos;N/A&apos; THEN [orders] END)&#10;    })&#10;)&#10;-&#10;(&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] != &apos;Baseline&apos; AND [Calculation_418201462828920833] != &apos;N/A&apos; THEN [vendor_failed_orders] END)&#10;    /&#10;    SUM(IF [experiment_group] != &apos;Baseline&apos; AND [Calculation_418201462828920833] != &apos;N/A&apos; THEN [orders] END)&#10;    })&#10;    -&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [Calculation_418201462828920833] != &apos;N/A&apos; THEN [vendor_failed_orders] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [Calculation_418201462828920833] != &apos;N/A&apos; THEN [orders] END)&#10;    })&#10;)' />
