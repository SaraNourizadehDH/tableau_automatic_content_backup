              <calculation class='tableau' formula='SUM([reconcile_flow_orders])/SUM([orders])' />
            </column>
            <column caption='Metric Phase' datatype='string' name='[Rollout Phase (copy)_396387155264122882]' role='dimension' type='nominal'>
