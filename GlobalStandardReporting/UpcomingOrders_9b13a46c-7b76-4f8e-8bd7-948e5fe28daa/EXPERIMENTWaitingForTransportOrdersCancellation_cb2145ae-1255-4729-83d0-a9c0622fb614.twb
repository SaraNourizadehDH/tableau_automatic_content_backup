      <column caption='Post-Rollout Timespan' datatype='string' name='[Analysis Timespan (Post-Rollout) (copy)_203858272671715331]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [experiment_name] = &apos;APAC-PH&apos; THEN &quot;W11-W16&quot;&#10;ELSEIF [experiment_name] = &apos;APAC-SG&apos; THEN &quot;W11-W16&quot;&#10;ELSEIF [experiment_name] = &apos;APAC-TH&apos; THEN &quot;W11-W16&quot;&#10;ELSEIF [experiment_name] = &apos;APAC-TW&apos; THEN &quot;W11-W16&quot;&#10;ELSE &quot;N/A&quot;&#10;END' />
      </column>
      <column caption='Pre-Rollout Timespan' datatype='string' name='[Analysis Timespan (Pre-Rollout) (copy)_203858272671973380]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [experiment_name] = &apos;APAC-PH&apos; THEN &quot;W04-W09&quot;&#10;ELSEIF [experiment_name] = &apos;APAC-SG&apos; THEN &quot;W04-W09&quot;&#10;ELSEIF [experiment_name] = &apos;APAC-TH&apos; THEN &quot;W04-W09&quot;&#10;ELSEIF [experiment_name] = &apos;APAC-TW&apos; THEN &quot;W04-W09&quot;&#10;ELSE &quot;N/A&quot;&#10;END' />
      </column>
      <column aggregation='Sum' caption='Inventory' datatype='integer' name='[Calculation_203858272667717633]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [experiment_name]&#10;WHEN &quot;APAC-PH&quot; THEN 37000&#10;WHEN &quot;APAC-SG&quot; THEN 13000&#10;WHEN &quot;APAC-TH&quot; THEN 59000&#10;WHEN &quot;APAC-TW&quot; THEN 66000&#10;END' />
      </column>
      <column caption='Pre-Post Checker' datatype='string' name='[Calculation_337277410516295680]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF RIGHT([Rollout Phase (copy)_396387155264122882], 3) = &quot;Pre&quot; THEN &quot;Pre&quot;&#10;ELSEIF RIGHT([Rollout Phase (copy)_396387155264122882], 4) = &quot;Post&quot; THEN &quot;Post&quot;&#10;END' />
      </column>
      <column caption='Post ∆ - Pre ∆ Tag' datatype='string' name='[Calculation_337277410518667266]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Post ∆ - Pre ∆&quot;' />
      </column>
      <column caption='Timespan' datatype='boolean' name='[Calculation_396387155265060867]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_418201462836531203] != &quot;N/A&quot; OR [Calculation_418201462828920833] != &quot;N/A&quot; THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Analysis Timespan (Pre-Rollout)' datatype='string' name='[Calculation_418201462828920833]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [experiment_name] = &apos;APAC-PH&apos; AND [created_date] &gt;= DATE(&apos;2023-01-23&apos;) AND [created_date] &lt;= DATE(&apos;2023-03-05&apos;) THEN &quot;W04-W09&quot;&#10;ELSEIF [experiment_name] = &apos;APAC-SG&apos; AND [created_date] &gt;= DATE(&apos;2023-01-23&apos;) AND [created_date] &lt;= DATE(&apos;2023-03-05&apos;) THEN &quot;W04-W09&quot;&#10;ELSEIF [experiment_name] = &apos;APAC-TH&apos; AND [created_date] &gt;= DATE(&apos;2023-01-23&apos;) AND [created_date] &lt;= DATE(&apos;2023-03-05&apos;) THEN &quot;W04-W09&quot;&#10;ELSEIF [experiment_name] = &apos;APAC-TW&apos; AND [created_date] &gt;= DATE(&apos;2023-01-23&apos;) AND [created_date] &lt;= DATE(&apos;2023-03-05&apos;) THEN &quot;W04-W09&quot;&#10;ELSE &quot;N/A&quot;&#10;END' />
      </column>
      <column caption='Analysis Timespan (Post-Rollout)' datatype='string' name='[Calculation_418201462836531203]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [experiment_name] = &apos;APAC-PH&apos; AND [created_date] &gt;= DATE(&apos;2023-03-13&apos;) AND [created_date] &lt;= DATE(&apos;2023-04-23&apos;) THEN &quot;W11-W16&quot;&#10;ELSEIF [experiment_name] = &apos;APAC-SG&apos; AND [created_date] &gt;= DATE(&apos;2023-03-13&apos;) AND [created_date] &lt;= DATE(&apos;2023-04-23&apos;) THEN &quot;W11-W16&quot;&#10;ELSEIF [experiment_name] = &apos;APAC-TH&apos; AND [created_date] &gt;= DATE(&apos;2023-03-13&apos;) AND [created_date] &lt;= DATE(&apos;2023-04-23&apos;) THEN &quot;W11-W16&quot;&#10;ELSEIF [experiment_name] = &apos;APAC-TW&apos; AND [created_date] &gt;= DATE(&apos;2023-03-13&apos;) AND [created_date] &lt;= DATE(&apos;2023-04-23&apos;) THEN &quot;W11-W16&quot;&#10;ELSE &quot;N/A&quot;&#10;END' />
      </column>
      <column caption='Rollout Phase' datatype='string' name='[Calculation_4848195386618671104]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_418201462836531203] = &apos;N/A&apos; THEN &quot;Pre&quot;&#10;ELSEIF [Calculation_418201462828920833] = &apos;N/A&apos; THEN &quot;Post&quot;&#10;END' />
      </column>
      <column caption='Vendor Fail Rate' datatype='real' name='[Calculation_4848195386620370947]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendor_failed_orders])/SUM([orders])' />
      </column>
      <column caption='Variant' datatype='boolean' name='[Calculation_4848195386621218820]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1] = [experiment_group]&#10;OR [experiment_group] = &quot;Baseline&quot;' />
      </column>
      <column caption='Delta Phase' datatype='string' name='[Calculation_4848195386623766534]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_4848195386618671104] = &quot;Post&quot; THEN &quot;Post ∆ (&quot; + [Parameters].[Parameter 1] + &quot; - Baseline)&quot;&#10;ELSEIF [Calculation_4848195386618671104] = &quot;Pre&quot; THEN &quot;Pre ∆ (&quot; + [Parameters].[Parameter 1] + &quot; - Baseline)&quot;&#10;END' />
      </column>
      <column caption='Days Till/Since Rollout' datatype='integer' name='[Calculation_485825823130701828]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [rollout_date], [created_date])' />
      </column>
      <column caption='_user_entitlement' datatype='boolean' name='[Calculation_693061775433273344]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Parameters' datatype='string' name='[Calculation_693061775434362881]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [experiment_group]&#10;WHEN &quot;Baseline&quot; THEN &quot;Disabled&quot;&#10;WHEN &quot;Variant A&quot; THEN &quot;Enabled&quot;&#10;END' />
      </column>
      <column caption='Date' datatype='string' name='[Calculation_693061775437230082]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [date_type]&#10;WHEN &quot;Daily&quot; THEN STR(DATE([created_date]))&#10;WHEN &quot;Weekly&quot; THEN STR(YEAR([created_date]))+&quot;-W&quot;+STR(ISOWEEK([created_date]))&#10;END' />
      </column>
      <column caption='Successful Orders' datatype='integer' name='[Calculation_693061775476678660]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[orders] - [failed_orders]' />
      </column>
      <column caption='% Metric Numerator' datatype='integer' name='[Calculation_693061775494160390]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &quot;Vendor Fail Rate&quot; THEN [vendor_failed_orders]&#10;WHEN &quot;Closed Vendor Fail Rate&quot; THEN [closed_vendor_failed_orders]&#10;WHEN &quot;Too Busy Vendor Fail Rate&quot; THEN [too_busy_vendor_failed_orders]&#10;WHEN &quot;Unreachable Vendor Fail Rate&quot; THEN [unreachable_vendor_failed_orders]&#10;WHEN &quot;No Response Vendor Fail Rate&quot; THEN [no_response_vendor_failed_orders]&#10;WHEN &quot;Item Unavailable Vendor Fail Rate&quot; THEN [item_unavailable_vendor_failed_orders]&#10;WHEN &quot;Item Unavailable Vendor Failed Waiting For Transport Orders Share %&quot; THEN [item_unavailable_vendor_failed_waiting_for_transport_orders]&#10;WHEN &quot;Reconciliation Save Rate&quot; THEN [reconciled_orders]&#10;WHEN &quot;Reconciliable Order Share %&quot; THEN [reconcile_flow_orders]&#10;END' />
      </column>
      <column caption='% Metric Denominator' datatype='integer' name='[Calculation_693061775494680583]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &quot;Vendor Fail Rate&quot; THEN [orders]&#10;WHEN &quot;Closed Vendor Fail Rate&quot; THEN [orders]&#10;WHEN &quot;Too Busy Vendor Fail Rate&quot; THEN [orders]&#10;WHEN &quot;Unreachable Vendor Fail Rate&quot; THEN [orders]&#10;WHEN &quot;No Response Vendor Fail Rate&quot; THEN [orders]&#10;WHEN &quot;Item Unavailable Vendor Fail Rate&quot; THEN [orders]&#10;WHEN &quot;Item Unavailable Vendor Failed Waiting For Transport Orders Share %&quot; THEN [item_unavailable_vendor_failed_orders]&#10;WHEN &quot;Reconciliation Save Rate&quot; THEN [reconcilable_orders]&#10;WHEN &quot;Reconciliable Order Share %&quot; THEN [orders]&#10;END' />
      </column>
      <column caption='Target Inventory' datatype='real' name='[Inventory (copy)_203858272668831746]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [experiment_name]&#10;WHEN &quot;APAC-PH&quot; THEN&#10;    CASE [experiment_group]&#10;    WHEN &quot;Baseline&quot; THEN 0.5&#10;    WHEN &quot;Variant A&quot; THEN 0.5&#10;    END&#10;WHEN &quot;APAC-SG&quot; THEN&#10;    CASE [experiment_group]&#10;    WHEN &quot;Baseline&quot; THEN 0.5&#10;    WHEN &quot;Variant A&quot; THEN 0.5&#10;    END&#10;WHEN &quot;APAC-TH&quot; THEN&#10;    CASE [experiment_group]&#10;    WHEN &quot;Baseline&quot; THEN 0.5&#10;    WHEN &quot;Variant A&quot; THEN 0.5&#10;    END&#10;WHEN &quot;APAC-TW&quot; THEN&#10;    CASE [experiment_group]&#10;    WHEN &quot;Baseline&quot; THEN 0.5&#10;    WHEN &quot;Variant A&quot; THEN 0.5&#10;    END&#10;END' />
      </column>
      <column caption='Item Unavailable Vendor Failed Waiting For Transport Orders Share % (Post ∆ - Pre ∆) (copy)' datatype='real' name='[Item Unavailable Vendor Failed Waiting For Transport Orders Share % (Post ∆ - Pre ∆) (copy)_3231332751893372931]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] != &apos;Baseline&apos; AND [Calculation_418201462836531203] != &apos;N/A&apos; THEN [item_unavailable_vendor_failed_waiting_for_transport_orders] END)&#10;    /&#10;    SUM(IF [experiment_group] != &apos;Baseline&apos; AND [Calculation_418201462836531203] != &apos;N/A&apos; THEN [item_unavailable_vendor_failed_orders] END)&#10;    })&#10;    -&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [Calculation_418201462836531203] != &apos;N/A&apos; THEN [item_unavailable_vendor_failed_waiting_for_transport_orders] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [Calculation_418201462836531203] != &apos;N/A&apos; THEN [item_unavailable_vendor_failed_orders] END)&#10;    })&#10;)&#10;-&#10;(&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] != &apos;Baseline&apos; AND [Calculation_418201462828920833] != &apos;N/A&apos; THEN [item_unavailable_vendor_failed_waiting_for_transport_orders] END)&#10;    /&#10;    SUM(IF [experiment_group] != &apos;Baseline&apos; AND [Calculation_418201462828920833] != &apos;N/A&apos; THEN [item_unavailable_vendor_failed_orders] END)&#10;    })&#10;    -&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [Calculation_418201462828920833] != &apos;N/A&apos; THEN [item_unavailable_vendor_failed_waiting_for_transport_orders] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [Calculation_418201462828920833] != &apos;N/A&apos; THEN [item_unavailable_vendor_failed_orders] END)&#10;    })&#10;)' />
      </column>
