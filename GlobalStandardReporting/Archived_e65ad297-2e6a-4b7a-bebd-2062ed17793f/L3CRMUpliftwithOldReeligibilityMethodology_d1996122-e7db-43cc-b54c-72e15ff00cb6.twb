          <datasource-dependencies datasource='sqlproxy.1smpvr51xvc3af17pnuch1igedqu'>
            <column aggregation='Count' caption='Canvas Name Keyword Filter' datatype='boolean' default-type='nominal' layered='true' name='[Calculation_1190287367040897024]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default'>
              <calculation class='tableau' formula='CONTAINS([canvas_name], [Parameters].[Parameter 7])' />
            </column>
            <column aggregation='User' caption='FIXED Control: Orders' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_1583507884844228609]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
              <calculation class='tableau' formula='SUM(&#13;&#10;{ FIXED   &#13;&#10;[date],&#13;&#10;[date_type],&#13;&#10;[management_entity],&#13;&#10;[country],&#13;&#10;[display_name],&#13;&#10;[campaign_type],&#13;&#10;[canvas_name],&#10;[expedition_type],&#10;[shop_type]:&#13;&#10;sum( if [in_control] = true then [Calculation_2477261275902283776] end)&#13;&#10;}&#13;&#10;)' />
            </column>
            <column aggregation='Sum' caption='Orders (cases)' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_2477261275902283776]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
              <calculation class='tableau' formula='case &#10;    [Parameters].[Time After Enter (copy)_6134817547588083712] when 1 then&#10;    IF [Parameters].[Parameter 8 1]=1 Then [orders_day]&#10;        ELSEIF [Parameters].[Parameter 8 1]=2 then [orders_week]&#10;        ELSEIF [Parameters].[Parameter 8 1]=3 then [orders_month]&#10;        ELSEIF [Parameters].[Parameter 8 1]=4 then [orders_2months]&#10;        ELSEIF [Parameters].[Parameter 8 1]=5 then [orders_3months]&#10;    END&#10;    when 2 then&#10;    IF [Parameters].[Parameter 8 1]=1 AND [shop_type]=&quot;restaurants&quot; then [orders_day]&#10;        ELSEIF [Parameters].[Parameter 8 1]=2  AND [shop_type]=&quot;restaurants&quot; then [orders_week]&#10;        ELSEIF [Parameters].[Parameter 8 1]=3  AND [shop_type]=&quot;restaurants&quot; then [orders_month]&#10;        ELSEIF [Parameters].[Parameter 8 1]=4  AND [shop_type]=&quot;restaurants&quot; then [orders_2months]&#10;        ELSEIF [Parameters].[Parameter 8 1]=5  AND [shop_type]=&quot;restaurants&quot; then [orders_3months]&#10;    end&#10;    when 3 then&#10;    IF [Parameters].[Parameter 8 1]=1 AND [shop_type]=&quot;darkstores&quot; then [orders_day]&#10;        ELSEIF [Parameters].[Parameter 8 1]=2  AND [shop_type]=&quot;darkstores&quot; then [orders_week]&#10;        ELSEIF [Parameters].[Parameter 8 1]=3  AND [shop_type]=&quot;darkstores&quot; then [orders_month]&#10;        ELSEIF [Parameters].[Parameter 8 1]=4  AND [shop_type]=&quot;darkstores&quot; then [orders_2months]&#10;        ELSEIF [Parameters].[Parameter 8 1]=5  AND [shop_type]=&quot;darkstores&quot; then [orders_3months]&#10;    end&#10;    when 4 then&#10;    IF [Parameters].[Parameter 8 1]=1 AND [shop_type]&lt;&gt;&quot;restaurants&quot; then [orders_day]&#10;        ELSEIF [Parameters].[Parameter 8 1]=2  AND [shop_type]&lt;&gt;&quot;restaurants&quot; then [orders_week]&#10;        ELSEIF [Parameters].[Parameter 8 1]=3  AND [shop_type]&lt;&gt;&quot;restaurants&quot; then [orders_month]&#10;        ELSEIF [Parameters].[Parameter 8 1]=4  AND [shop_type]&lt;&gt;&quot;restaurants&quot; then [orders_2months]&#10;        ELSEIF [Parameters].[Parameter 8 1]=5  AND [shop_type]&lt;&gt;&quot;restaurants&quot; then [orders_3months]&#10;    end&#10;    when 5 then&#10;    IF [Parameters].[Parameter 8 1]=1 AND [shop_type] &lt;&gt; &quot;restaurants&quot; and [shop_type] &lt;&gt;&quot;darkstores&quot; then [orders_day]&#10;        ELSEIF [Parameters].[Parameter 8 1]=2  AND [shop_type] &lt;&gt; &quot;restaurants&quot; and [shop_type] &lt;&gt;&quot;darkstores&quot; then [orders_week]&#10;        ELSEIF [Parameters].[Parameter 8 1]=3  AND [shop_type] &lt;&gt; &quot;restaurants&quot; and [shop_type] &lt;&gt;&quot;darkstores&quot; then [orders_month]&#10;        ELSEIF [Parameters].[Parameter 8 1]=4  AND [shop_type] &lt;&gt; &quot;restaurants&quot; and [shop_type] &lt;&gt;&quot;darkstores&quot; then [orders_2months]&#10;        ELSEIF [Parameters].[Parameter 8 1]=5  AND [shop_type] &lt;&gt; &quot;restaurants&quot; and [shop_type] &lt;&gt;&quot;darkstores&quot; then [orders_3months]&#10;    end&#10;end' />
            </column>
            <column aggregation='Sum' caption='Users (cases)' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_2477261275903102977]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
              <calculation class='tableau' formula='{ FIXED   &#10;[date],&#10;[date_type],&#10;[region],&#10;[management_entity],&#10;[country],&#10;[display_name],&#10;[campaign_type],&#10;[canvas_name],&#10;[variation_name],&#10;[expedition_type]:&#10;case &#10;[Parameters].[Time After Enter (copy)_6134817547588083712] when 1 then&#10;    case MIN([Parameters].[Parameter 8 1])&#10;    when 1 then MIN([users_day])&#10;    when 2 then MIN([users_week])&#10;    when 3 then MIN([users_month])&#10;    when 4 then MIN([users_2months])&#10;    when 5 then MIN([users_3months])&#10;    end&#10; when 3 then case MIN([Parameters].[Parameter 8 1])&#10;    when 1 then MIN([users_day_dmart])&#10;    when 2 then MIN([users_week_dmart])&#10;    when 3 then MIN([users_month_dmart])&#10;    when 4 then MIN([users_2months_dmart])&#10;    when 5 then MIN([users_3months_dmart])&#10;    end &#10;when 2 then&#10;    case MIN([Parameters].[Parameter 8 1])&#10;    when 1 then MIN([users_day_restaurant])&#10;    when 2 then MIN([users_week_restaurant])&#10;    when 3 then MIN([users_month_restaurant])&#10;    when 4 then MIN([users_2months_restaurant])&#10;    when 5 then MIN([users_3months_restaurant])&#10;    end&#10;when 4 then&#10;    case MIN([Parameters].[Parameter 8 1])&#10;    when 1 then MIN([users_day_quickcommerce])&#10;    when 2 then MIN([users_week_quickcommerce])&#10;    when 3 then MIN([users_month_quickcommerce])&#10;    when 4 then MIN([users_2months_quickcommerce])&#10;    when 5 then MIN([users_3months_quickcommerce])&#10;    end&#10;when 5 then&#10;    case MIN([Parameters].[Parameter 8 1])&#10;    when 1 then MIN([users_day_localshop])&#10;    when 2 then MIN([users_week_localshop])&#10;    when 3 then MIN([users_month_localshop])&#10;    when 4 then MIN([users_2months_localshop])&#10;    when 5 then MIN([users_3months_localshop])&#10;    end&#10;end &#10;}' />
            </column>
            <column aggregation='Sum' caption='SWITCH: Receivers' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_3773594308397547521]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
              <calculation class='tableau' formula='{ FIXED   &#13;&#10;[date],&#13;&#10;[date_type],&#13;&#10;[region],&#13;&#10;[management_entity],&#13;&#10;[country],&#13;&#10;[display_name],&#13;&#10;[campaign_type],&#13;&#10;[canvas_name],&#13;&#10;[variation_name]:&#13;&#10;case min([Parameters].[Parameter 9])&#13;&#10;when 1 then min([receivers_external_id])&#13;&#10;when 2 then min([receivers])&#13;&#10;end&#13;&#10;}' />
            </column>
            <column aggregation='User' caption='Control: Receivers' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_427982738192842757]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
              <calculation class='tableau' formula='SUM({ FIXED   &#13;&#10;[date],&#13;&#10;[date_type],&#13;&#10;[Calculation_6282802981652971520],&#13;&#10;[region],&#13;&#10;[management_entity],&#13;&#10;[country],&#13;&#10;[display_name],&#13;&#10;[campaign_type],&#13;&#10;[canvas_name],&#13;&#10;[variation_name]:&#13;&#10;case min([in_control])&#13;&#10;when true then min([Calculation_3773594308397547521])&#13;&#10;end&#13;&#10;})' />
            </column>
            <column aggregation='User' caption='Control: Orders Per Receiver' datatype='real' default-format='n#,##0.00;-#,##0.00' default-type='quantitative' layered='true' name='[Calculation_427982738193100807]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='[Calculation_1583507884844228609]&#10;/ &#10;sum([FIXED Control: Receivers (copy 2)_968273957765865497])' />
            </column>
            <column aggregation='User' caption='Target: Orders Per Receiver' datatype='real' default-format='n#,##0.00;-#,##0.00' default-type='quantitative' layered='true' name='[Calculation_427982738193240072]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='[Control: Orders (copy)]&#10;/&#10;[Control: Users (copy)]' />
            </column>
            <column aggregation='User' caption='Incremental Orders' datatype='real' default-format='n#,##0;-#,##0' default-type='quantitative' layered='true' name='[Calculation_427982738193461257]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='//([Target: Orders Per Receiver] - [Control: Orders Per Receiver]) * [Target: Receivers]&#10;&#10;SUM({INCLUDE [canvas_name] : ([Calculation_427982738193240072] - [Calculation_427982738193100807]) * [Control: Users (copy)]})' />
            </column>
            <column aggregation='Count' caption='Expedition Type*' datatype='string' default-type='nominal' layered='true' name='[Calculation_449797051598225408]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
              <calculation class='tableau' formula='IF [expedition_type]= TRUE THEN &quot;Takeout&quot; &#10;ELSEIF [expedition_type]= FALSE THEN &quot;Delivery&quot; &#10;END' />
            </column>
            <column aggregation='Count' caption='Campaign Vertical' datatype='string' default-type='nominal' layered='true' name='[Calculation_449797051639517185]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
              <calculation class='tableau' formula='IF UPPER(LEFT([canvas_name],4))=&apos;DMA_&apos; THEN &quot;dmart&quot;&#10;ELSEIF UPPER(LEFT([canvas_name],4))=&apos;LOC_&apos; THEN &quot;local stores&quot;&#10;ELSEIF UPPER(LEFT([canvas_name],4))=&apos;MIX_&apos; THEN &quot;mixed&quot;&#10;ELSEIF UPPER(LEFT([canvas_name],4))=&apos;EAT_&apos; THEN &quot;restaurants&quot;&#10;ELSEIF UPPER(LEFT([canvas_name],4))=&apos;QUI_&apos; THEN &quot;quick commerce&quot;&#10;ELSE &quot;others&quot;&#10;END' />
            </column>
            <column aggregation='Count' caption='User Entitlement' datatype='boolean' default-type='nominal' layered='true' name='[Calculation_5870723615677390848]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default' />
            <column aggregation='Sum' caption='Source Id' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_6282802981652971520]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
              <calculation class='tableau' formula='1' />
            </column>
            <column aggregation='User' caption='Target: Orders' datatype='integer' default-type='quantitative' layered='true' name='[Control: Orders (copy)]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
              <calculation class='tableau' formula='sum(&#10;if [in_control] = false &#10;then [Calculation_2477261275902283776]&#10;end &#10;)' />
            </column>
            <column aggregation='User' caption='Target: Users' datatype='integer' default-type='quantitative' layered='true' name='[Control: Users (copy 2)_2179038590000627712]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
              <calculation class='tableau' formula='SUM({ FIXED   &#13;&#10;[date],&#13;&#10;[date_type],&#13;&#10;[Calculation_6282802981652971520],&#13;&#10;[region],&#13;&#10;[management_entity],&#13;&#10;[country],&#13;&#10;[display_name],&#13;&#10;[campaign_type],&#13;&#10;[canvas_name],&#13;&#10;[variation_name],&#10;[expedition_type]:&#13;&#10;min( if [in_control] = false then [Calculation_2477261275903102977] end)&#13;&#10;})' />
            </column>
            <column aggregation='User' caption='Target: Receivers' datatype='integer' default-type='quantitative' layered='true' name='[Control: Users (copy)]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
              <calculation class='tableau' formula='SUM({ FIXED   &#13;&#10;[date],&#13;&#10;[date_type],&#13;&#10;[Calculation_6282802981652971520],&#13;&#10;[region],&#13;&#10;[management_entity],&#13;&#10;[country],&#13;&#10;[display_name],&#13;&#10;[campaign_type],&#13;&#10;[canvas_name],&#13;&#10;[variation_name]:&#13;&#10;case min([in_control])&#13;&#10;when FALSE then min([Calculation_3773594308397547521])&#13;&#10;end&#13;&#10;})' />
            </column>
            <column aggregation='Sum' caption='FIXED Control: Receivers verticals' datatype='integer' default-type='quantitative' layered='true' name='[FIXED Control: Receivers (copy 2)_968273957765865497]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
              <calculation class='tableau' formula='{ FIXED   &#13;&#10;[date],&#13;&#10;[date_type],&#13;&#10;[management_entity],&#13;&#10;[country],&#13;&#10;[display_name],&#13;&#10;[campaign_type],&#13;&#10;[canvas_name]:&#13;&#10;MIN(if [in_control] = true then [Calculation_3773594308397547521] end)&#13;&#10;}' />
            </column>
            <column aggregation='User' caption='Control: Users' datatype='integer' default-type='quantitative' layered='true' name='[FIXED Control: Users (copy 2)]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
              <calculation class='tableau' formula='SUM({ FIXED   &#13;&#10;[date],&#13;&#10;[date_type],&#13;&#10;[Calculation_6282802981652971520],&#13;&#10;[region],&#13;&#10;[management_entity],&#13;&#10;[country],&#13;&#10;[display_name],&#13;&#10;[campaign_type],&#13;&#10;[canvas_name],&#13;&#10;[variation_name],&#10;[expedition_type]:&#13;&#10;min( if [in_control] = true then [Calculation_2477261275903102977] end)&#13;&#10;})' />
            </column>
            <column aggregation='User' caption='Incremental Activation' datatype='real' default-type='quantitative' layered='true' name='[Incremental Activation (FIXED logic) (copy 3)]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='SUM(&#10;{ FIXED   &#10;[date],&#10;[management_entity],&#10;[country],&#10;[display_name],&#10;[campaign_type],&#10;[canvas_name]:&#10;SUM({INCLUDE [canvas_name] : ([Control: Users (copy 2)_2179038590000627712] / [Control: Users (copy)] - [FIXED Control: Users (copy 2)] / [Calculation_427982738192842757]) * [Control: Users (copy)]})&#10;})' />
            </column>
            <column aggregation='Count' caption='New Campaign Type' datatype='string' default-type='nominal' layered='true' name='[Orders (cases) (copy)_4892809212478590976]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
              <calculation class='tableau' formula='if contains(LOWER([canvas_name]),&quot;probot&quot;) THEN &quot;ProBot&quot; else [campaign_type]&#10;END' />
