  <column aggregation='Sum' caption='Receiver Threshold (Date View dependent)' datatype='integer' default-type='quantitative' hidden='true' name='[Calculation_1583507885161340935]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
    <calculation class='tableau' formula='CASE [date_type]&\#10;when &apos;2-monthly&apos; then 15&\#10;when &apos;monthly&apos; then 15&\#10;when &apos;weekly&apos; then 7&\#10;when &apos;daily&apos; then 1&\#10;end' />
  </column>
  <column aggregation='Count' caption='Receiver Threshold satisfied' datatype='boolean' default-type='nominal' hidden='true' name='[Calculation_1583507885163405320]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default'>
