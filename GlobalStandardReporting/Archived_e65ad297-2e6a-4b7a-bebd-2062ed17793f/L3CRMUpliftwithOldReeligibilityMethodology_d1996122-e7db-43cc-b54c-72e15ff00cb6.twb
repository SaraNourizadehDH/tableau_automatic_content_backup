        <column aggregation='Count' caption='Campaign Vertical' datatype='string' default-type='nominal' layered='true' name='[Calculation_449797051639517185]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
          <calculation class='tableau' formula='IF UPPER(LEFT([canvas_name],4))=&apos;DMA_&apos; THEN &quot;dmart&quot;&#10;ELSEIF UPPER(LEFT([canvas_name],4))=&apos;LOC_&apos; THEN &quot;local stores&quot;&#10;ELSEIF UPPER(LEFT([canvas_name],4))=&apos;MIX_&apos; THEN &quot;mixed&quot;&#10;ELSEIF UPPER(LEFT([canvas_name],4))=&apos;EAT_&apos; THEN &quot;restaurants&quot;&#10;ELSEIF UPPER(LEFT([canvas_name],4))=&apos;QUI_&apos; THEN &quot;quick commerce&quot;&#10;ELSE &quot;others&quot;&#10;END' />
