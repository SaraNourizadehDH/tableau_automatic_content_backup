    IF [Parameters].[Parameter 8 1]=1 AND [shop_type]<>\"restaurants\" then [gmv_eur_day]
        ELSEIF [Parameters].[Parameter 8 1]=2  AND [shop_type]<>\"restaurants\" then [gmv_eur_week]
