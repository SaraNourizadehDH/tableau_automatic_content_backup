              <calculation class='tableau' formula='case &#10;    [Parameters].[Time After Enter (copy)_6134817547588083712] when 1 then&#10;    IF [Parameters].[Parameter 8 1]=1 Then [gmv_eur_day]&#10;        ELSEIF [Parameters].[Parameter 8 1]=2 then [gmv_eur_week]&#10;        ELSEIF [Parameters].[Parameter 8 1]=3 then [gmv_eur_month]&#10;        ELSEIF [Parameters].[Parameter 8 1]=4 then [gmv_eur_2months]&#10;        ELSEIF [Parameters].[Parameter 8 1]=5 then [gmv_eur_3months]&#10;    END&#10;    when 2 then&#10;    IF [Parameters].[Parameter 8 1]=1 AND [shop_type]=&quot;restaurants&quot; then [gmv_eur_day]&#10;        ELSEIF [Parameters].[Parameter 8 1]=2  AND [shop_type]=&quot;restaurants&quot; then [gmv_eur_week]&#10;        ELSEIF [Parameters].[Parameter 8 1]=3  AND [shop_type]=&quot;restaurants&quot; then [gmv_eur_month]&#10;        ELSEIF [Parameters].[Parameter 8 1]=4  AND [shop_type]=&quot;restaurants&quot; then [gmv_eur_2months]&#10;        ELSEIF [Parameters].[Parameter 8 1]=5  AND [shop_type]=&quot;restaurants&quot; then [gmv_eur_3months]&#10;    end&#10;    when 3 then&#10;    IF [Parameters].[Parameter 8 1]=1 AND [shop_type]=&quot;darkstores&quot; then [gmv_eur_day]&#10;        ELSEIF [Parameters].[Parameter 8 1]=2  AND [shop_type]=&quot;darkstores&quot; then [gmv_eur_week]&#10;        ELSEIF [Parameters].[Parameter 8 1]=3  AND [shop_type]=&quot;darkstores&quot; then [gmv_eur_month]&#10;        ELSEIF [Parameters].[Parameter 8 1]=4  AND [shop_type]=&quot;darkstores&quot; then [gmv_eur_2months]&#10;        ELSEIF [Parameters].[Parameter 8 1]=5  AND [shop_type]=&quot;darkstores&quot; then [gmv_eur_3months]&#10;    end&#10;    when 4 then&#10;    IF [Parameters].[Parameter 8 1]=1 AND [shop_type]&lt;&gt;&quot;restaurants&quot; then [gmv_eur_day]&#10;        ELSEIF [Parameters].[Parameter 8 1]=2  AND [shop_type]&lt;&gt;&quot;restaurants&quot; then [gmv_eur_week]&#10;        ELSEIF [Parameters].[Parameter 8 1]=3  AND [shop_type]&lt;&gt;&quot;restaurants&qu