    <calculation class='tableau' formula='SUM(&\#13;&\#10;{ FIXED   &\#13;&\#10;[date],&\#13;&\#10;[date_type],&\#13;&\#10;[management_entity],&\#13;&\#10;[country],&\#13;&\#10;[display_name],&\#13;&\#10;[campaign_type],&\#13;&\#10;[canvas_name],&\#10;[expedition_type],&\#10;[shop_type]:&\#13;&\#10;sum( if [in_control] = true then [Calculation_2477261275902283776] end)&\#13;&\#10;}&\#13;&\#10;)' />
