  <column aggregation='User' caption='Incremental Activation (FIXED logic)' datatype='real' default-type='quantitative' name='[Calculation_1583507885203116041]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
    <calculation class='tableau' formula='SUM({ FIXED   &\#10;[date],&\#10;[date_type],&\#10;[management_entity],&\#10;[country],&\#10;[display_name],&\#10;[campaign_type],&\#10;[canvas_name],&\#10;[variation_name]:&\#10;([Orders Per Receiver (copy)_968273957774950429] - sum([Control: Orders Per Receiver (FIXED logic) (copy)_968273957774630940])) * [Control: Users (copy)]&\#10;})&\#10;//(sum(if [In Control] = false then [Users (cases)] end ) / [Target: Receivers] - [Control: Receivers]/ sum([FIXED Control: Receivers verticals])) * [Target: Receivers]' />
