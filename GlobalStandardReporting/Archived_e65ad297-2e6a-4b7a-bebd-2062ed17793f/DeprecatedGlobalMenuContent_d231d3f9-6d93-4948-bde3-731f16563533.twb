    <worksheet name='Trend (dlp,mcvr,gmv)'>
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='bima_tableau_menu_content_dlm+ (rl_mkt)' name='federated.0thvdiw0uqaufn15bd0ji1yua7vo' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
            </column>
            <column caption='Metric' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Pictures&quot;'>
              <calculation class='tableau' formula='&quot;Pictures&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0thvdiw0uqaufn15bd0ji1yua7vo'>
            <column caption='Final CR3' datatype='real' name='[Calculation_2064689348291657731]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([checkout_visits])/SUM([menu_visits])' />
            </column>
            <column caption='Vendors' datatype='integer' name='[Calculation_3009178638457888769]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([vendor_id])' />
            </column>
            <column caption='Date Granular' datatype='date' name='[Calculation_586875343749910529]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(IF [Parameters].[Parameter 1] = &quot;Month&quot; &#13;&#10;    THEN DATETRUNC(&apos;month&apos;,[date])&#13;&#10;ELSEIF  [Parameters].[Parameter 1] = &quot;Quarter&quot; &#13;&#10;    THEN DATETRUNC(&apos;quarter&apos;,[date])&#13;&#10;ELSEIF  [Parameters].[Parameter 1] = &quot;Year&quot; &#13;&#10;    THEN DATETRUNC(&apos;year&apos;,[date])&#13;&#10;ELSE [date]&#13;&#10;END)' />
            </column>
            <column caption='DATE TEST' datatype='boolean' name='[Calculation_710161382861869056]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF { FIXED [Calculation_586875343749910529] : MAX([date]) } = [date]&#13;&#10;THEN TRUE&#13;&#10;ELSE FALSE&#13;&#10;END' />
            </column>
            <column caption='Date_Filter' datatype='string' name='[Calculation_759138028033142784]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF&#13;&#10;    [Calculation_586875343749910529] = DATEADD(&apos;week&apos;,-1,{MAX([Calculation_586875343749910529])}) //If the order date is the most recent date in data set&#13;&#10;THEN&#13;&#10;    &quot;Latest Complete Date&quot;  //Then set as &quot;Latest&quot; for quick filter.&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Month&quot; &#13;&#10;    THEN str(DATENAME(&apos;year&apos;,[date])+&quot; &quot;+DATENAME(&apos;month&apos;,[date]))&#13;&#10;ELSEIF  [Parameters].[Parameter 1] = &quot;Quarter&quot; &#13;&#10;    THEN str(DATENAME(&apos;year&apos;,[date])+&quot; Q&quot;+DATENAME(&apos;quarter&apos;,[date]))&#13;&#10;ELSEIF  [Parameters].[Parameter 1] = &quot;Year&quot; &#13;&#10;    THEN str(DATENAME(&apos;year&apos;,[date]))&#13;&#10;ELSE        &#13;&#10;    str(DATENAME(&apos;year&apos;,[date])+&quot; &quot;+DATENAME(&apos;week&apos;,[date])) &#13;&#10;END' />
            </column>
            <column caption='Product with Metric Count' datatype='integer' name='[Calculation_785596676532006915]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;Pictures&quot;&#13;&#10;THEN &#13;&#10;    [product_with_image_count]&#13;&#10;ELSE&#13;&#10;    [product_with_description_count]&#13;&#10;END' />
            </column>
            <column caption='Vertical Filter' datatype='boolean' name='[Calculation_84301793402413057]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[vertical_type] in (&apos;restaurant&apos;,&apos;restaurants&apos;)&#10;or ([management_entity] = &apos;Talabat&apos; and [vertical_type] = &apos;food&apos;)&#10;or ([management_entity] = &apos;Pedidosya&apos; and [vertical_type] in (&apos;coffee&apos;,&apos;restaurant&apos;))&#13;&#10;or ([management_entity] = &apos;Glovo&apos; and [vertical_type] = &apos;Food&apos;)' />
            </column>
            <column caption='DLM Coverage' datatype='real' name='[DLM Coverage (copy)_586875343748038656]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_785596676532006915])&#13;&#10;/&#13;&#10;SUM([product_count])' />
            </column>
            <column caption='DLM Coverage_' datatype='real' name='[DLP Coverage (copy)_785596676509937666]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([Calculation_710161382861869056],[Calculation_785596676532006915],0))&#13;&#10;/&#13;&#10;SUM(IIF([Calculation_710161382861869056],[product_count],0))' />
            </column>
            <column caption='Title Var' datatype='string' name='[Product with Metric Count (copy)_785596676534796292]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;Pictures&quot;&#13;&#10;THEN &#13;&#10;    &quot;P&quot;&#13;&#10;ELSE&#13;&#10;    &quot;D&quot;&#13;&#10;END' />
            </column>
            <column datatype='string' name='[Vendor Type (group)]' role='dimension' type='nominal'>
