    <worksheet name='Image coverage trend'>
      <repository-location id='Imagecoveragetrend' path='/t/GlobalStandardReporting/workbooks/GlobalMenuContent' revision='' site='GlobalStandardReporting' />
      <table>
        <view>
          <datasources>
            <datasource caption='bima_tableau_menu_content_dlm+ (rl_mkt)' name='federated.0thvdiw0uqaufn15bd0ji1yua7vo' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
            </column>
            <column caption='Metric' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Pictures&quot;'>
              <calculation class='tableau' formula='&quot;Pictures&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0thvdiw0uqaufn15bd0ji1yua7vo'>
            <column caption='% Products with DLM' datatype='real' name='[% Products with DLP  (copy)_759138028074344450]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// [Product with Image Cnt]&#13;&#10;SUM([Calculation_759138028074471427])&#13;&#10;/SUM([product_count])&#13;&#10;//[Product Count]' />
            </column>
            <column caption='% Products with DLP ' datatype='real' name='[% Products with DLP (copy)_1732619259271802884]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([product_with_image_count])/SUM([product_count])' />
            </column>
            <column caption='Date Granular' datatype='date' name='[Calculation_586875343749910529]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(IF [Parameters].[Parameter 1] = &quot;Month&quot; &#13;&#10;    THEN DATETRUNC(&apos;month&apos;,[date])&#13;&#10;ELSEIF  [Parameters].[Parameter 1] = &quot;Quarter&quot; &#13;&#10;    THEN DATETRUNC(&apos;quarter&apos;,[date])&#13;&#10;ELSEIF  [Parameters].[Parameter 1] = &quot;Year&quot; &#13;&#10;    THEN DATETRUNC(&apos;year&apos;,[date])&#13;&#10;ELSE [date]&#13;&#10;END)' />
            </column>
            <column caption='DLP' datatype='real' name='[Calculation_6378856328759484416]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([product_with_image_count])/SUM([product_count])' />
            </column>
            <column caption='Product With Metric Count' datatype='integer' name='[Calculation_759138028074471427]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;Pictures&quot;&#13;&#10;    THEN [product_with_image_count]&#13;&#10;ELSE [product_with_description_count]&#13;&#10;END' />
            </column>
            <column caption='Titles Word' datatype='string' name='[Calculation_759138028084142094]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]= &quot;Pictures&quot; &#13;&#10;    THEN &quot;Pict.&quot;&#13;&#10;    ELSE &quot;Descr.&quot;&#13;&#10;END' />
            </column>
            <column caption='zn([% Products with DLM])' datatype='real' name='[Calculation_785596676506210304]' role='measure' type='quantitative' user:unnamed='Image coverage trend'>
              <calculation class='tableau' formula='zn([% Products with DLP  (copy)_759138028074344450])' />
            </column>
            <column caption='Vertical Filter' datatype='boolean' name='[Calculation_84301793402413057]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[vertical_type] in (&apos;restaurant&apos;,&apos;restaurants&apos;)&#10;or ([management_entity] = &apos;Talabat&apos; and [vertical_type] = &apos;food&apos;)&#10;or ([management_entity] = &apos;Pedidosya&apos; and [vertical_type] in (&apos;coffee&apos;,&apos;restaurant&apos;))&#13;&#10;or ([management_entity] = &apos;Glovo&apos; and [vertical_type] = &apos;Food&apos;)' />
            </column>
            <column caption='zn([DLP])' datatype='real' name='[Calculation_997547378958934016]' role='measure' type='quantitative' user:unnamed='Image coverage trend'>
              <calculation class='tableau' formula='zn([Calculation_6378856328759484416])' />
            </column>
            <column caption='zn([DLD])' datatype='real' name='[Calculation_997547378958987265]' role='measure' type='quantitative' user:unnamed='Image coverage trend'>
              <calculation class='tableau' formula='zn([DLP Coverage (copy)_785596676508049409])' />
            </column>
            <column caption='DLD' datatype='real' name='[DLP Coverage (copy)_785596676508049409]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([product_with_description_count])/SUM([product_count])' />
            </column>
