              <calculation class='tableau' formula='SUM([product_with_image_count])/SUM([product_count])' />
            </column>
            <column caption='Last Filter' datatype='boolean' name='[Calculation_1017532059104333834]' role='measure' type='nominal'>
              <calculation class='tableau' formula='LAST() = 0'>
