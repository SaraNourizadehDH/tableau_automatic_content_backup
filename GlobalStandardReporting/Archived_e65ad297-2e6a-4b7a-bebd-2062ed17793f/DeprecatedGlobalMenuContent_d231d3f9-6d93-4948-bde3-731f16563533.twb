    <worksheet name='HungerStation Menu Content TS'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>Product Coverage:</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='bima_tableau_menu_content_dlm+ (rl_mkt)' name='federated.0thvdiw0uqaufn15bd0ji1yua7vo' />
          </datasources>
          <datasource-dependencies datasource='federated.0thvdiw0uqaufn15bd0ji1yua7vo'>
            <column caption='Content Score' datatype='real' name='[Calculation_1176846936281931778]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([DLP Coverage (copy)_1176846936278310912]*0.7)+([DLP Score (copy)_1176846936280875009]*0.3)' />
            </column>
            <column caption='Complete Months' datatype='boolean' name='[Calculation_4676214194072055820]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEADD(&apos;day&apos;, -1, &#13;&#10;DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [date]))) &lt;= &#13;&#10;{ FIXED : MAX([date]) }' />
            </column>
            <column caption='DLP' datatype='real' name='[Calculation_6378856328759484416]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([product_with_image_count])/SUM([product_count])' />
            </column>
            <column caption='Vertical Filter' datatype='boolean' name='[Calculation_84301793402413057]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[vertical_type] in (&apos;restaurant&apos;,&apos;restaurants&apos;)&#10;or ([management_entity] = &apos;Talabat&apos; and [vertical_type] = &apos;food&apos;)&#10;or ([management_entity] = &apos;Pedidosya&apos; and [vertical_type] in (&apos;coffee&apos;,&apos;restaurant&apos;))&#13;&#10;or ([management_entity] = &apos;Glovo&apos; and [vertical_type] = &apos;Food&apos;)' />
            </column>
            <column caption='DLP Score' datatype='integer' name='[DLP Coverage (copy)_1176846936278310912]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF              [Calculation_6378856328759484416] &lt;= 0.1 THEN 0&#13;&#10;    ELSEIF      [Calculation_6378856328759484416] &lt;= 0.3 THEN 1&#13;&#10;    ELSEIF      [Calculation_6378856328759484416] &lt;= 0.5 THEN 2&#13;&#10;    ELSEIF      [Calculation_6378856328759484416] &lt;= 0.7 THEN 3&#13;&#10;    ELSEIF      [Calculation_6378856328759484416] &lt;= 0.9 THEN 4&#13;&#10;    ELSE                          5 END' />
            </column>
            <column caption='DLD' datatype='real' name='[DLP Coverage (copy)_785596676508049409]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([product_with_description_count])/SUM([product_count])' />
            </column>
            <column caption='DLD Score' datatype='integer' name='[DLP Score (copy)_1176846936280875009]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF              [DLP Coverage (copy)_785596676508049409] &lt;= 0.1 THEN 0&#13;&#10;    ELSEIF      [DLP Coverage (copy)_785596676508049409] &lt;= 0.3 THEN 1&#13;&#10;    ELSEIF      [DLP Coverage (copy)_785596676508049409] &lt;= 0.5 THEN 2&#13;&#10;    ELSEIF      [DLP Coverage (copy)_785596676508049409] &lt;= 0.7 THEN 3&#13;&#10;    ELSEIF      [DLP Coverage (copy)_785596676508049409] &lt;= 0.9 THEN 4&#13;&#10;    ELSE                          5 END' />
            </column>
            <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
