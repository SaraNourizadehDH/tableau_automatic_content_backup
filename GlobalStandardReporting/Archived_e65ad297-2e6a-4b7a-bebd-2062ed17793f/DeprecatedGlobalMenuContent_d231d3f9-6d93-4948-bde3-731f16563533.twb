                <relation connection='bigquery.0h2gaqh0dnojae12nfbcx0o5o9wg' name='Custom SQL Query' type='text'>SELECT &#13;
	CASE &#13;
      WHEN `tableau_gsr_entitlements_marketing_global_entity_id`.`global_entity_id` = &apos;CG_QA&apos; THEN&#13;
      &apos;Carriage&apos;&#13;
      WHEN `tableau_gsr_entitlements_marketing_global_entity_id`.`global_entity_id` in (&apos;FO_NO&apos;, &apos;OP_SE&apos;, &apos;MJM_AT&apos;, &apos;HN_DK&apos;, &apos;PO_FI&apos;, &apos;NP_HU&apos;, &apos;FP_SK&apos;, &apos;DJ_CZ&apos;) THEN&#13;
      &apos;DH Europe&apos;&#13;
      WHEN `tableau_gsr_entitlements_marketing_global_entity_id`.`global_entity_id` in (&apos;YS_TR&apos;) THEN&#13;
      &apos;Yemeksepeti&apos;&#13;
      WHEN `tableau_gsr_entitlements_marketing_global_entity_id`.`global_entity_id` in (&apos;FY_CY&apos;, &apos;EF_GR&apos;) THEN&#13;
      &apos;DH Greece&apos;&#13;
      WHEN `tableau_gsr_entitlements_marketing_global_entity_id`.`global_entity_id` in ( &apos;FP_LA&apos;, &apos;FP_TW&apos;, &apos;FP_MM&apos;, &apos;FP_KH&apos;, &apos;FP_MY&apos;, &apos;FP_PK&apos;, &apos;FP_TH&apos;, &apos;FP_HK&apos;, &apos;FP_SG&apos;, &apos;FP_BD&apos;, &apos;FP_PH&apos;) THEN&#13;
      &apos;Foodpanda APAC&apos;&#13;
      WHEN `tableau_gsr_entitlements_marketing_global_entity_id`.`global_entity_id` in (&apos;HS_BH&apos;, &apos;HS_SA&apos;) THEN&#13;
      &apos;HungerStation&apos;&#13;
      WHEN `tableau_gsr_entitlements_marketing_global_entity_id`.`global_entity_id` in (&apos;IN_OM&apos;, &apos;IN_EG&apos;, &apos;IN_QA&apos;, &apos;IN_GR&apos;, &apos;IN_BH&apos;, &apos;IN_LB&apos;, &apos;IN_AE&apos;) THEN&#13;
      &apos;Instashop&apos;&#13;
      WHEN `tableau_gsr_entitlements_marketing_global_entity_id`.`global_entity_id` in (&apos;PY_PE&apos;, &apos;PY_CL&apos;, &apos;AP_PA&apos;, &apos;PY_BO&apos;, &apos;PY_EC&apos;, &apos;PY_UY&apos;, &apos;PY_HN&apos;, &apos;PY_PY&apos;, &apos;PY_AR&apos;, &apos;PY_GT&apos;, &apos;PY_NI&apos;, &apos;PY_VE&apos;, &apos;PY_CR&apos;, &apos;PY_SV&apos;, &apos;PY_DO&apos;) THEN&#13;
      &apos;Pedidosya&apos;&#13;
      WHEN `tableau_gsr_entitlements_marketing_global_entity_id`.`global_entity_id` in (&apos;TB_IQ&apos;, &apos;TB_OM&apos;, &apos;HF_EG&apos;, &apos;TB_QA&apos;, &apos;TB_JO&apos;, &apos;TB_KW&apos;, &apos;TB_BH&apos;, &apos;TB_SA&apos;, &apos;TB_AE&apos;) THEN&#13;
      &apos;Talabat&apos;&#13;
      WHEN `tableau_gsr_entitlements_marketing_global_entity_id`.`global_entity_id` in (&apos;BM_VN&apos;, &apos;BM_KR&apos;) THEN&#13;
      &apos;Woowa&apos;&#13;
      WHEN `tableau_gsr_entitlements_marketing_global_entity_id`.`global_entity_id` in (&apos;ZO_AE&apos;) THEN&#13;
      &apos;Zomato&apos;&#13;
    END AS entitlments_management_entity,&#13;
	`tableau_gsr_entitlements_marketing_global_entity_id`.`username`&#13;
FROM `fulfillment-dwh-production.rl_mkt`.`tableau_gsr_entitlements_marketing_global_entity_id` `tableau_gsr_entitlements_marketing_global_entity_id`</relation>
