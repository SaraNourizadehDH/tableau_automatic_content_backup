            </column>
            <column caption='Max Date per M' datatype='boolean' name='[Max Date per Q (copy)_1211749835519332356]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{FIXED [Date Quarters (copy)_1211749835512856579] : MAX([date])} = [date]' />
