    <worksheet name='Highest Coverage Country DLD'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='12'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='bima_tableau_menu_content_dlm+ (rl_mkt)' name='federated.0thvdiw0uqaufn15bd0ji1yua7vo' />
          </datasources>
          <datasource-dependencies datasource='federated.0thvdiw0uqaufn15bd0ji1yua7vo'>
            <column caption='Complete Months' datatype='boolean' name='[Calculation_4676214194072055820]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEADD(&apos;day&apos;, -1, &#13;&#10;DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [date]))) &lt;= &#13;&#10;{ FIXED : MAX([date]) }' />
            </column>
            <column caption='Vertical Filter' datatype='boolean' name='[Calculation_84301793402413057]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[vertical_type] in (&apos;restaurant&apos;,&apos;restaurants&apos;)&#10;or ([management_entity] = &apos;Talabat&apos; and [vertical_type] = &apos;food&apos;)&#10;or ([management_entity] = &apos;Pedidosya&apos; and [vertical_type] in (&apos;coffee&apos;,&apos;restaurant&apos;))&#13;&#10;or ([management_entity] = &apos;Glovo&apos; and [vertical_type] = &apos;Food&apos;)' />
            </column>
            <column caption='Country with Highest Coverage % DLD' datatype='real' name='[Country with Highest Coverage % (copy)_1017532059188273170]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{INCLUDE  : MAX( { INCLUDE  [country] : sum([product_with_description_count])/sum([product_count]) } ) }' />
            </column>
            <column caption='Name of Country with highest % DLD' datatype='string' name='[Name of Country with highest % DLP (copy)_1017532059188650003]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF { INCLUDE  [country] : sum([product_with_description_count])/sum([product_count]) } = [Country with Highest Coverage % (copy)_1017532059188273170]&#10;THEN [country]&#10;END' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column-instance column='[Name of Country with highest % DLP (copy)_1017532059188650003]' derivation='Min' name='[min:Name of Country with highest % DLP (copy)_1017532059188650003:nk]' pivot='key' type='nominal' />
            <column-instance column='[date]' derivation='MY' name='[my:date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_4676214194072055820]' derivation='None' name='[none:Calculation_4676214194072055820:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_84301793402413057]' derivation='None' name='[none:Calculation_84301793402413057:nk]' pivot='key' type='nominal' />
            <column-instance column='[date]' derivation='None' name='[none:date:qk]' pivot='key' type='quantitative' />
            <column caption='Product Count' datatype='integer' name='[product_count]' role='measure' type='quantitative' />
            <column caption='Product With Description Count' datatype='integer' name='[product_with_description_count]' role='measure' type='quantitative' />
            <column-instance column='[Country with Highest Coverage % (copy)_1017532059188273170]' derivation='Sum' name='[sum:Country with Highest Coverage % (copy)_1017532059188273170:qk]' pivot='key' type='quantitative' />
            <column caption='Vertical Type' datatype='string' name='[vertical_type]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0thvdiw0uqaufn15bd0ji1yua7vo].[none:Calculation_4676214194072055820:nk]' context='true' filter-group='5'>
