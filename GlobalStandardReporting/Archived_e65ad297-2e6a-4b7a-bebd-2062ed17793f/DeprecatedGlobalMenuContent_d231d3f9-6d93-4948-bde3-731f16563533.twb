    <worksheet name='High Level order KPIs'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>Order and Conversion KPIs</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location id='HighLevelorderKPIs' path='/t/GlobalStandardReporting/workbooks/GlobalMenuContent' revision='' site='GlobalStandardReporting' />
      <table>
        <view>
          <datasources>
            <datasource caption='bima_tableau_menu_content_dlm+ (rl_mkt)' name='federated.0thvdiw0uqaufn15bd0ji1yua7vo' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
            </column>
            <column caption='Metric' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Pictures&quot;'>
              <calculation class='tableau' formula='&quot;Pictures&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0thvdiw0uqaufn15bd0ji1yua7vo'>
            <column caption='Vendor Unique ID' datatype='string' name='[Calculation_1015561743190167553]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[vendor_id]+[global_entity_id]' />
            </column>
            <column caption='MIN(0.0)' datatype='real' name='[Calculation_1732619259266789379]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN(0.0)' />
            </column>
            <column caption='Date Granular' datatype='date' name='[Calculation_586875343749910529]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(IF [Parameters].[Parameter 1] = &quot;Month&quot; &#13;&#10;    THEN DATETRUNC(&apos;month&apos;,[date])&#13;&#10;ELSEIF  [Parameters].[Parameter 1] = &quot;Quarter&quot; &#13;&#10;    THEN DATETRUNC(&apos;quarter&apos;,[date])&#13;&#10;ELSEIF  [Parameters].[Parameter 1] = &quot;Year&quot; &#13;&#10;    THEN DATETRUNC(&apos;year&apos;,[date])&#13;&#10;ELSE [date]&#13;&#10;END)' />
            </column>
            <column caption='Date Filter' datatype='string' name='[Calculation_586875343750086658]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF&#13;&#10;    [Calculation_586875343749910529] = {MAX([Calculation_586875343749910529])} //If the order date is the most recent date in data set&#13;&#10;THEN&#13;&#10;    &quot;Latest Date&quot;  //Then set as &quot;Latest&quot; for quick filter&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Month&quot; &#13;&#10;    THEN str(DATENAME(&apos;year&apos;,[date])+&quot; &quot;+DATENAME(&apos;month&apos;,[date]))&#13;&#10;ELSEIF  [Parameters].[Parameter 1] = &quot;Quarter&quot; &#13;&#10;    THEN str(DATENAME(&apos;year&apos;,[date])+&quot; Q&quot;+DATENAME(&apos;quarter&apos;,[date]))&#13;&#10;ELSEIF  [Parameters].[Parameter 1] = &quot;Year&quot; &#13;&#10;    THEN str(DATENAME(&apos;year&apos;,[date]))&#13;&#10;ELSE        &#13;&#10;    str(DATENAME(&apos;year&apos;,[date]))+&quot; &quot;+ str([iso_week_number])&#13;&#10;END' />
            </column>
            <column caption='Product Metric Coverage' datatype='real' name='[Calculation_759138028045492225]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;Pictures&quot;&#13;&#10;Then [product_image_coverage]&#13;&#10;ELSE [product_description_coverage]&#13;&#10;END' />
            </column>
            <column caption='Vertical Filter' datatype='boolean' name='[Calculation_84301793402413057]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[vertical_type] in (&apos;restaurant&apos;,&apos;restaurants&apos;)&#10;or ([management_entity] = &apos;Talabat&apos; and [vertical_type] = &apos;food&apos;)&#10;or ([management_entity] = &apos;Pedidosya&apos; and [vertical_type] in (&apos;coffee&apos;,&apos;restaurant&apos;))&#13;&#10;or ([management_entity] = &apos;Glovo&apos; and [vertical_type] = &apos;Food&apos;)' />
            </column>
            <column caption='Titles Tittle' datatype='string' name='[Titles Word (copy)_586875343768518662]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]= &quot;Pictures&quot; &#13;&#10;    THEN &quot;P&quot;&#13;&#10;    ELSE &quot;D&quot;&#13;&#10;END' />
            </column>
            <column caption='Vendor GMV with 90% DLM' datatype='real' name='[Vendor GFV with 90% DLP (copy)_759138028082274314]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF&#13;&#10;    [Calculation_759138028045492225] &gt;= 0.9 &#13;&#10;        THEN [gmv_eur] END)&#13;&#10;/&#10;COUNTD(IF &#13;&#10;    [Calculation_759138028045492225] &gt;= 0.9 &#10;        THEN [Calculation_1015561743190167553] END)' />
            </column>
            <column caption='Vendor GMV without DLM' datatype='real' name='[Vendor GFV without DLP (copy)_759138028082806795]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF &#13;&#10;    [Calculation_759138028045492225] = 0 &#13;&#10;        THEN [gmv_eur] END)&#13;&#10;/&#10;COUNTD(IF [Calculation_759138028045492225] = 0&#10;        THEN [Calculation_1015561743190167553] END)' />
            </column>
            <column datatype='string' name='[Vendor Type (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[vendor_type]' new-bin='true'>
                <bin default-name='false' value='&quot;Existing Vendor&quot;'>
                  <value>&quot;existing vendor&quot;</value>
                  <value>&quot;Existing vendor&quot;</value>
                  <value>&quot;Existing Vendor&quot;</value>
                  <value>&quot;false&quot;</value>
                  <value>&quot;old vendor&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;New Vendor&quot;'>
                  <value>&quot;new vendor&quot;</value>
                  <value>&quot;New vendor&quot;</value>
                  <value>&quot;New Vendor&quot;</value>
                  <value>&quot;true&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='Vendor mCVR3 with 90% or more DLM' datatype='real' name='[Vendor mCVR3 with 90% or more DLP (copy)_759138028083367948]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_759138028045492225] &gt;= 0.9 THEN [checkout_visits] END)&#13;&#10;/&#10;SUM(IF [Calculation_759138028045492225] &gt;= 0.9 THEN [menu_visits] END)' />
            </column>
            <column caption='Vendor mCVR3 without DLM' datatype='real' name='[Vendor mCVR3 without DLP (copy)_759138028083609613]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [Calculation_759138028045492225] = 0 THEN [checkout_visits] END)/&#10;sum(IF [Calculation_759138028045492225] = 0 THEN [menu_visits] END)' />
            </column>
            <column caption='Checkout Visits' datatype='real' name='[checkout_visits]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Gmv Eur' datatype='real' name='[gmv_eur]' role='measure' type='quantitative' />
            <column caption='Iso Week Number' datatype='integer' name='[iso_week_number]' role='dimension' type='ordinal' />
