            <column caption='% Vendors with 70% or More DLM' datatype='real' name='[% Vendors with 70% or More DLP (copy)_759138028075245572]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if [Calculation_759138028045492225] &gt;= 0.7 THEN [Calculation_1015561743190167553] end)/&#10;COUNTD([Calculation_1015561743190167553])' />
            </column>
            <column caption='% vendors with 70% DLD' datatype='real' name='[% vendors with 70% DLP (copy)_1017532059172245517]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if [product_with_description_count]/[product_count] &gt;= 0.7&#10;THEN [Calculation_1015561743190167553] END)/COUNTD([Calculation_1015561743190167553])' />
            </column>
            <column caption='Vendor Unique ID' datatype='string' name='[Calculation_1015561743190167553]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[vendor_id]+[global_entity_id]' />
            </column>
            <column caption='Complete Months' datatype='boolean' name='[Calculation_4676214194072055820]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEADD(&apos;day&apos;, -1, &#13;&#10;DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [date]))) &lt;= &#13;&#10;{ FIXED : MAX([date]) }' />
            </column>
            <column caption='Product Metric Coverage' datatype='real' name='[Calculation_759138028045492225]' role='measure' type='quantitative'>
