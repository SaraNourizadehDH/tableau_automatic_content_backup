    <worksheet name='Talabat Pict QoQ'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>Product Coverage:</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='bima_tableau_menu_content_dlm+ (rl_mkt)' name='federated.0thvdiw0uqaufn15bd0ji1yua7vo' />
          </datasources>
          <datasource-dependencies datasource='federated.0thvdiw0uqaufn15bd0ji1yua7vo'>
            <column caption='% Products with DLP ' datatype='real' name='[% Products with DLP (copy)_1732619259271802884]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([product_with_image_count])/SUM([product_count])' />
            </column>
            <column caption='Last Filter' datatype='boolean' name='[Calculation_1017532059104333834]' role='measure' type='nominal'>
              <calculation class='tableau' formula='LAST() = 0'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Max Date per Q' datatype='boolean' name='[Calculation_1211749835508195330]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATETRUNC(&apos;month&apos;,[date]) = DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,TODAY()))&#13;&#10;    THEN {FIXED [Date Quarters (copy)_1211749835512856579] : MAX([date])} = [date]&#13;&#10;    ELSE {FIXED [Date Granular (copy)_1222164366983532551] : MAX([date])} = [date]&#13;&#10;END' />
            </column>
            <column caption='Complete Months' datatype='boolean' name='[Calculation_4676214194072055820]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEADD(&apos;day&apos;, -1, &#13;&#10;DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [date]))) &lt;= &#13;&#10;{ FIXED : MAX([date]) }' />
            </column>
            <column caption='Vertical Filter' datatype='boolean' name='[Calculation_84301793402413057]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[vertical_type] in (&apos;restaurant&apos;,&apos;restaurants&apos;)&#10;or ([management_entity] = &apos;Talabat&apos; and [vertical_type] = &apos;food&apos;)&#10;or ([management_entity] = &apos;Pedidosya&apos; and [vertical_type] in (&apos;coffee&apos;,&apos;restaurant&apos;))&#13;&#10;or ([management_entity] = &apos;Glovo&apos; and [vertical_type] = &apos;Food&apos;)' />
            </column>
            <column caption='Date Quarters' datatype='datetime' default-format='*yyyy &quot;Q&quot;q' name='[Date Granular (copy)_1222164366983532551]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;quarter&apos;,[date])' />
            </column>
            <column caption='Date Months' datatype='datetime' name='[Date Quarters (copy)_1211749835512856579]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[date])' />
            </column>
            <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
