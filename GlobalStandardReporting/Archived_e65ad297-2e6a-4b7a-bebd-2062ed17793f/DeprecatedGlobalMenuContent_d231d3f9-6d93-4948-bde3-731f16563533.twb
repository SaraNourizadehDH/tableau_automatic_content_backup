            <column-instance column='[Vendor GFV with 90% DLP (copy)_759138028082274314]' derivation='User' name='[usr:Vendor GFV with 90% DLP (copy)_759138028082274314:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Vendor GFV without DLP (copy)_759138028082806795]' derivation='User' name='[usr:Vendor GFV without DLP (copy)_759138028082806795:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Vendor mCVR3 with 90% or more DLP (copy)_759138028083367948]' derivation='User' name='[usr:Vendor mCVR3 with 90% or more DLP (copy)_759138028083367948:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Vendor mCVR3 without DLP (copy)_759138028083609613]' derivation='User' name='[usr:Vendor mCVR3 without DLP (copy)_759138028083609613:qk]' pivot='key' type='quantitative' />
