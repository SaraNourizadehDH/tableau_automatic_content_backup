          <zone forceUpdate='true' h='98934' id='3' type-v2='text' w='98926' x='537' y='533'>
            <formatted-text>
              <run bold='true' fontcolor='#d60265' fontname='Tableau Book,serif' fontsize='12' underline='true'>1. High level view</run>
              <run bold='true' fontcolor='#d60265' fontname='Benton Sans Book' fontsize='12'>Æ </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Book,serif' fontsize='11'>1.1 Vendor summary</run>
              <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>Æ </run>
              <run>Æ&#10;</run>
              <run fontname='Tableau Book,serif' fontsize='11'>-</run>
              <run fontname='Times New Roman' fontsize='11'>Æ          </run>
              <run fontcolor='#000000' fontname='Tableau Book,serif' fontsize='11'>Vendor count: Number of vendors that are active, not private and not vendor testing</run>
              <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>Æ </run>
              <run>Æ&#10;</run>
              <run fontname='Tableau Book,serif' fontsize='11'>-</run>
              <run fontname='Times New Roman' fontsize='11'>Æ          </run>
              <run fontcolor='#000000' fontname='Tableau Book,serif' fontsize='11'>Independent vendors: Number of active vendors that are not part of a chain (i.e. no chain ID tagged to them)</run>
              <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>Æ </run>
              <run>Æ&#10;</run>
              <run fontname='Tableau Book,serif' fontsize='11'>-</run>
              <run fontname='Times New Roman' fontsize='11'>Æ          </run>
              <run fontcolor='#000000' fontname='Tableau Book,serif' fontsize='11'>Chain vendors that are part of a chain (i.e. have a chain ID tagged to them)</run>
              <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>Æ </run>
              <run>Æ&#10;</run>
              <run fontname='Tableau Book,serif' fontsize='11'>-</run>
              <run fontname='Times New Roman' fontsize='11'>Æ          </run>
              <run fontcolor='#000000' fontname='Tableau Book,serif' fontsize='11'>Vendors (belong to chain …): Number of vendors belonging to a chain that has the number of vendors of the given range</run>
              <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>Æ </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Book,serif' fontsize='11'>Æ </run>
              <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>Æ </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Book,serif' fontsize='11'>1.2 Product summary</run>
              <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>Æ </run>
              <run>Æ&#10;</run>
              <run fontname='Tableau Book,serif' fontsize='11'>-</run>
              <run fontname='Times New Roman' fontsize='11'>Æ          </run>
              <run fontcolor='#000000' fontname='Tableau Book,serif' fontsize='11'>Average product count: Count of distinct product IDs that are active, not a hidden product and the product is not deleted</run>
              <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>Æ </run>
              <run>Æ&#10;</run>
              <run fontname='Tableau Book,serif' fontsize='11'>-</run>
              <run fontname='Times New Roman' fontsize='11'>Æ          </run>
              <run fontcolor='#000000' fontname='Tableau Book,serif' fontsize='11'>Median product count: Median count of distinct product IDs that are active, not a hidden product</run>
              <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>Æ </run>
              <run>Æ&#10;</run>
              <run fontname='Tableau Book,serif' fontsize='11'>-</run>
              <run fontname='Times New Roman' fontsize='11'>Æ          </run>
              <run fontcolor='#000000' fontname='Tableau Book,serif' fontsize='11'>Average category count: Average count of distinct menu category IDs per vendor</run>
              <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>Æ </run>
              <run>Æ&#10;</run>
              <run fontname='Tableau Book,serif' fontsize='11'>-</run>
              <run fontname='Times New Roman' fontsize='11'>Æ          </run>
              <run fontcolor='#000000' fontname='Tableau Book,serif' fontsize='11'>Average share of toppings per menu: Average proportion of products that have at least 1 topping</run>
              <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>Æ </run>
              <run>Æ&#10;</run>
              <run fontname='Tableau Book,serif' fontsize='11'>-</run>
              <run fontname='Times New Roman' fontsize='11'>Æ          </run>
              <run fontcolor='#000000' fontname='Tableau Book,serif' fontsize='11'>Average toppings per template: Average number of toppings tagged to a topping template</run>
              <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>Æ </run>
              <run>Æ&#10;</run>
              <run fontname='Tableau Book,serif' fontsize='11'>-</run>
              <run fontname='Times New Roman' fontsize='11'>Æ          </run>
              <run fontcolor='#000000' fontname='Tableau Book,serif' fontsize='11'>Average share of variations: Average proportion of products that have at least 1 variation</run>
              <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>Æ </run>
              <run>Æ&#10;</run>
