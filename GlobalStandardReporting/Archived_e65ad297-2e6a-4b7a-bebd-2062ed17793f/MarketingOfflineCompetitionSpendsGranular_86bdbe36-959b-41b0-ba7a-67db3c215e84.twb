      <aliases enabled='yes' />
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_1432989174326165504]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='spend_local_toggle' datatype='real' name='[Calculation_189925286994681856]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Absolute&apos; THEN (SUM([spend_local])/1000)&#10;WHEN &apos;Percent Share&apos; THEN ROUND((SUM([spend_local]) / SUM( { FIXED  [country], [report_month] : SUM([spend_local]) } )*100),1)&#10;END' />
      </column>
      <column caption='daypart_numbers' datatype='string' name='[Calculation_3220495990766157824]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [daypart] WHEN &apos;Nighttime&apos; THEN &apos;1-5h&apos;&#10;WHEN &apos;Early Morning&apos; then &apos;6-8h&apos;&#10;WHEN &apos;Morning&apos; THEN &apos;9-12h&apos;&#10;WHEN &apos;Daytime&apos; THEN &apos;13-16h&apos;&#10;WHEN &apos;Access Time&apos; THEN &apos;17-19h&apos;&#10;WHEN &apos;Prime Time&apos; THEN &apos;20-22h&apos;&#10;WHEN &apos;Post Prime Time&apos; THEN &apos;23-0h&apos;&#10;ELSE NULL &#10;END' />
      </column>
      <column caption='disclaimer_grps' datatype='string' name='[Calculation_6700722981004816384]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([country] = &apos;Taiwan&apos; OR [country] = &apos;Thailand&apos;, &apos;&apos;, &apos;Please note: GRPs data are not available for this market.&apos;)' />
      </column>
      <column caption='spend_toggle_sign' datatype='string' name='[Calculation_875598332373479427]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 1] = &apos;Absolute&apos;, &apos;K&apos;, &apos;%&apos;)' />
      </column>
      <column caption='grps_toggle_weekday_grp' datatype='real' name='[Calculation_883901839560941575]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Absolute&apos; THEN SUM([grps])&#10;WHEN &apos;Percent Share&apos; THEN ROUND((SUM([grps]) / SUM( { FIXED  [country], [media_type], [weekday] : SUM([grps]) } )*100),1)&#10;END' />
