            <column caption='grps_toggle_daypart_grp' datatype='real' name='[grps_toggle_weekday_grp (copy)_883901839576506379]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Absolute&apos; THEN SUM([grps])&#10;WHEN &apos;Percent Share&apos; THEN ROUND((SUM([grps]) / SUM( { FIXED  [country], [media_type], [daypart] : SUM([grps]) } )*100),1)&#10;END' />
            </column>
            <column caption='Media Type' datatype='string' name='[media_type]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_3220495990766157824]' derivation='None' name='[none:Calculation_3220495990766157824:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_883901839571767305]' derivation='None' name='[none:Calculation_883901839571767305:nk]' pivot='key' type='nominal' />
