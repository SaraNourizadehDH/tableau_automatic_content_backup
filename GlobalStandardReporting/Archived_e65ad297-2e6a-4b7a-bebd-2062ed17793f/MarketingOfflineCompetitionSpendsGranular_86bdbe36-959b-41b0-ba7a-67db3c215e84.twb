    <worksheet name='tv_spend_daypart'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontname='Tableau Bold'>TV Spend per Daypart (&lt;</run>
            <run bold='true' fontname='Tableau Bold'>[Parameters].[Parameter 1]</run>
            <run bold='true' fontname='Tableau Bold'>&gt;)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='bima_competition_marketing_offline_spends_granular (rl_mkt)' name='federated.13ecpfu1qzg6vg1dx6auv03gptho' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Absolute vs Percent' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Percent Share&quot;'>
              <calculation class='tableau' formula='&quot;Percent Share&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.13ecpfu1qzg6vg1dx6auv03gptho'>
            <column caption='daypart_numbers' datatype='string' name='[Calculation_3220495990766157824]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [daypart] WHEN &apos;Nighttime&apos; THEN &apos;1-5h&apos;&#10;WHEN &apos;Early Morning&apos; then &apos;6-8h&apos;&#10;WHEN &apos;Morning&apos; THEN &apos;9-12h&apos;&#10;WHEN &apos;Daytime&apos; THEN &apos;13-16h&apos;&#10;WHEN &apos;Access Time&apos; THEN &apos;17-19h&apos;&#10;WHEN &apos;Prime Time&apos; THEN &apos;20-22h&apos;&#10;WHEN &apos;Post Prime Time&apos; THEN &apos;23-0h&apos;&#10;ELSE NULL &#10;END' />
            </column>
            <column caption='spend_toggle_sign' datatype='string' name='[Calculation_875598332373479427]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 1] = &apos;Absolute&apos;, &apos;K&apos;, &apos;%&apos;)' />
            </column>
            <column caption='Brand' datatype='string' name='[brand]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Daypart' datatype='string' name='[daypart]' role='dimension' type='nominal' />
            <column caption='Media Type' datatype='string' name='[media_type]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_3220495990766157824]' derivation='None' name='[none:Calculation_3220495990766157824:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_875598332373479427]' derivation='None' name='[none:Calculation_875598332373479427:nk]' pivot='key' type='nominal' />
            <column-instance column='[brand]' derivation='None' name='[none:brand:nk]' pivot='key' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column-instance column='[daypart]' derivation='None' name='[none:daypart:nk]' pivot='key' type='nominal' />
            <column-instance column='[media_type]' derivation='None' name='[none:media_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[report_month]' derivation='None' name='[none:report_month:qk]' pivot='key' type='quantitative' />
            <column caption='Report Month' datatype='date' name='[report_month]' role='dimension' type='ordinal' />
            <column caption='Spend Euro' datatype='integer' name='[spend_euro]' role='measure' type='quantitative' />
            <column caption='spend_tv_daypart_toggle' datatype='real' name='[spend_toggle (copy)_875598332385177608]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Absolute&apos; THEN (SUM([spend_euro])/1000)&#10;WHEN &apos;Percent Share&apos; THEN ROUND((SUM([spend_euro]) / SUM( { FIXED  [country], [media_type], [Calculation_3220495990766157824], [daypart] : SUM([spend_euro]) } )*100),1)&#10;END' />
            </column>
            <column-instance column='[spend_toggle (copy)_875598332385177608]' derivation='User' name='[usr:spend_toggle (copy)_875598332385177608:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
