        <calculation class='tableau' formula='//Weighted FLGPO (non subs)&#10;(&#10;sum(&#10;    (if [Reporting_month] = DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1]) THEN ([FLGP_non_subscribers_eur]/[Monthly_active_non_subscribers]) END)&#10;    *&#10;    (if [Reporting_month] = DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1]) THEN [Subscribers_total_month] END)&#10;)&#10;/&#10;sum(if [Reporting_month] = DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1]) THEN [Subscribers_total_month] END)&#10;)' />
      </column>
      <column caption='Reporting Month-1 Weighted Previous AFV' datatype='real' name='[Reporting Month-1 Weighted Previous Frequency (copy)_239324150184681517]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;IF [Reporting_month] = DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1]) THEN&#10;([M_1_months_cohort_AFV_two_months_ago])&#10;*&#10;([Subscribers_total_month])&#10;END)&#10;/&#10;SUM(if [Reporting_month] = DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1]) THEN [Subscribers_total_month] END)' />
      </column>
      <column caption='Reporting Year-1 FLGPO (subscribers) (copy)' datatype='real' name='[Reporting Year-1 FLGPO (subscribers) (copy)_5182306187628245005]' role='measure' type='quantitative'>
