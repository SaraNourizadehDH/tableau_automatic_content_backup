      <column caption='Legend' datatype='string' name='[Calculation_2560366808999563265]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([central_pipeline] = 0 OR ISNULL([central_pipeline])) AND (ISNULL([local_pipeline]) OR [local_pipeline] = 0) THEN &quot;Data Not Exists&quot;&#10;ELSEIF  [metrics_name] = &quot;4.1. Churned Subscribers&quot; AND [management_entity] IN (&quot;DH Europe&quot;,&quot;Pedidosya&quot;) THEN &quot;Different Definition&quot;&#10;ELSEIF  [metrics_name] IN (&quot;4.3. Voluntarily Churned Subscribers&quot;,&quot;4.4. Involuntarily Churned Subscribers&quot;) AND [management_entity] IN (&quot;Foodpanda APAC&quot;,&quot;Pedidosya&quot;) THEN &quot;Different Definition&quot;&#10;ELSEIF  [metrics_name] IN (&quot;3. New Subscribers&quot;) AND [management_entity] IN (&quot;Pedidosya&quot;) THEN &quot;Different Definition&quot;&#10;ELSEIF  [metrics_name] IN (&quot;1. Subscribers Total Month&quot;,&quot;2. Susbcribers EOM&quot;) AND [management_entity] IN (&quot;HungerStation&quot;) THEN &quot;Different Definition&quot;&#10;ELSEIF  [metrics_name] IN (&quot;2. Susbcribers EOM&quot;) AND [management_entity] IN (&quot;Pedidosya&quot;) THEN &quot;Different Definition&quot;&#10;ELSEIF  [metrics_name] IN (&quot;6. Vendor Funded Subscription Benefits Eur&quot;) AND [management_entity] IN (&quot;Talabat&quot;) THEN &quot;Different Definition&quot;&#10;ELSEIF (ISNULL([local_pipeline]) OR [local_pipeline] = 0) THEN &quot;Local Data Not Exists&quot;&#10;ELSEIF ([central_pipeline] = 0 OR ISNULL([central_pipeline])) THEN &quot;Central Data Not Exists&quot;&#10;ELSEIF [Calculation_2560366808997163008]&gt;=-0.05 AND [Calculation_2560366808997163008]&lt;0.05 THEN &quot;Low Discrepancy&quot;&#10;ELSEIF [Calculation_2560366808997163008]&gt;=-0.1 AND [Calculation_2560366808997163008]&lt;0.1 THEN &quot;Medium Discrepancy&quot;&#10;ELSEIF [Calculation_2560366808997163008]&gt;0.1 or [Calculation_2560366808997163008]&lt;-0.1 THEN &quot;High Discrepancy&quot;&#10;END' />
