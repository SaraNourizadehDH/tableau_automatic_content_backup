              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2 2]&#13;&#10;    WHEN 1 THEN STR([sub_entity])&#13;&#10;    WHEN 2 THEN STR([cohort_month])&#13;&#10;    WHEN 3 THEN STR([subscription_type])&#13;&#10;    WHEN 4 THEN STR([subscription_duration]) + &apos; Months&apos;&#13;&#10;    WHEN 5 THEN [subscription_type] + &apos; &apos; + STR([subscription_duration]) + &apos; Months&apos;&#13;&#10;    WHEN 6 THEN &apos;Overall&apos;&#13;&#10;END' />
