      <column caption='User Entitlement' datatype='boolean' name='[Calculation_1197957557683433475]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] == USERNAME()' />
      </column>
      <column caption='%MAU (pp Diff)' datatype='real' name='[Calculation_1420604240216461312]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Retention Rate (LaL) (copy)_946037435181170692] - [Calculation_946037435181068291]' />
      </column>
      <column caption='Z Value Flag (Orders)' datatype='string' name='[Calculation_1725441646337306627]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([months_from_cohort_date] &lt; 0, &quot;Pre Period&quot;, IIF(ABS([T Value Flag (Orders) (copy)_1725441646337658884]) &gt;= 1.96, &quot;Significant&quot;, &quot;Not Significant&quot;))' />
      </column>
      <column caption='SI.Text' datatype='string' name='[Calculation_1725441646347927564]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Hover Here for More Information&quot;' />
      </column>
      <column caption='Δ FLGPO' datatype='real' name='[Calculation_3742772805925502976]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Orders pp (Subs) (copy)_1411315590074478595] - [Orders pp (LaL) (copy)_1411315590074470402]' />
      </column>
      <column caption='Δ Card Fee Revenue (Order)' datatype='real' name='[Calculation_7950331126527700992]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([test_card_fee_revenue_cpo_eur]) / SUM([test_orders])) - &#10;(SUM([ctrl_card_fee_revenue_cpo_eur]) / SUM([ctrl_orders]))' />
      </column>
      <column caption='CPIO' datatype='real' name='[Calculation_915919598124404736]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF(&#13;&#10;    [Δ FLGPO (copy)_1411315590076522500] &lt; 0 AND SUM([Δ FLGP (copy)_681662065407049730]) &lt; 0, &#13;&#10;    NULL, &#13;&#10;    [Δ FLGPO (copy)_1411315590076522500] / SUM([Orders (LaL) (copy)_1725441646340587530])&#13;&#10;)' />
      </column>
      <column caption='Z Value Flag (Profitability)' datatype='string' datatype-customized='true' name='[Calculation_946037435140685824]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([months_from_cohort_date] &lt; 0, &quot;Pre Period&quot;, IIF(ABS([T Value (Orders) (copy)_1197957557668954113]) &gt;= 1.96, &quot;Significant&quot;, &quot;Not Significant&quot;))' />
      </column>
      <column caption='%MAU (LaL)' datatype='real' name='[Calculation_946037435181068291]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// works only across different cohorts. &#13;&#10;SUM([ctrl_customers_with_orders]) / SUM([group_size])' />
      </column>
      <column caption='Relative Month (STR)' datatype='string' datatype-customized='true' name='[Calculation_946037435186487301]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;M &quot; + STR([months_from_cohort_date])' />
      </column>
      <column caption='FLGPU (LaL)' datatype='real' name='[FLGPO (LaL) (copy)_1411315590081634311]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Orders (LaL) (copy)_1411315590074445824]) / &#13;&#10;SUM([group_size])' />
      </column>
      <column caption='FLGPU (Subs)' datatype='real' name='[FLGPO (Subs) (copy)_1411315590081634312]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Orders (Subs) (copy)_1411315590074454017]) / &#13;&#10;SUM([group_size])' />
      </column>
      <column caption='QC FLGPU (LaL)' datatype='real' name='[FLGPU (LaL) (copy)_1411315590109310994]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ctrl_qc_flgp_eur]) / &#13;&#10;SUM([group_size])' />
      </column>
      <column caption='QC FLGPU (Subs)' datatype='real' name='[FLGPU (Subs) (copy)_1411315590109310995]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([test_qc_flgp_eur]) / &#13;&#10;SUM([group_size])' />
      </column>
      <column caption='FLGP (LaL)' datatype='real' name='[Orders (LaL) (copy)_1411315590074445824]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Restaurant Orders pp (Subs) Parameter]&#13;&#10;WHEN 1 THEN [ctrl_flgp_eur]&#13;&#10;WHEN 2 THEN [ctrl_restaurant_flgp_eur]&#13;&#10;WHEN 3 THEN [ctrl_qc_flgp_eur]&#13;&#10;END' />
      </column>
      <column caption='Orders (Subs)' datatype='integer' name='[Orders (LaL) (copy)_1725441646340141063]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Restaurant Orders pp (Subs) Parameter]&#13;&#10;WHEN 1 THEN [test_orders]&#13;&#10;WHEN 2 THEN [test_restaurant_orders]&#13;&#10;WHEN 3 THEN [test_qc_orders]&#13;&#10;END' />
      </column>
      <column caption='Δ Orders pp' datatype='real' name='[Orders (LaL) (copy)_1725441646340587530]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Restaurant Orders pp (Subs) Parameter]&#13;&#10;WHEN 1 THEN [orders_per_customer_difference]&#13;&#10;WHEN 2 THEN [restaurant_orders_per_customer_difference]&#13;&#10;WHEN 3 THEN [qc_orders_per_customer_difference]&#13;&#10;END' />
