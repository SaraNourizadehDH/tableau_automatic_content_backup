            <column caption='Reporting Year-1 Previous Month Subscribers' datatype='real' name='[Reporting Month-1 Previous Month Subscribers (copy)_427067921506000913]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Reporting_month]=DATEADD(&apos;year&apos;, -1, [Parameters].[Parameter 1]) THEN [Previous_month_subscribers] END)' />
            </column>
            <column caption='Reporting Month-1 Monthly Active Users' datatype='real' name='[Reporting Month-1 Subscribers EOM (copy)_239324150160728066]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Reporting_month]=DATEADD(&apos;month&apos;, -1, [Parameters].[Parameter 1]) THEN [Monthly_active_users] END)' />
            </column>
            <column caption='Reporting Month-1 Subscribers Total Month' datatype='real' name='[Reporting Month-1 Subscribers EOM (copy)_239324150176030751]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Reporting_month]=DATEADD(&apos;month&apos;, -1, [Parameters].[Parameter 1]) THEN [Subscribers_total_month] END)' />
            </column>
            <column caption='Reporting Year-1 Subscribers EOM ' datatype='real' name='[Reporting Month-1 Subscribers EOM (copy)_427067921481568263]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='SUM(IF DATE([Reporting_month])=DATE(DATEADD(&apos;year&apos;, -1, DATE([Parameters].[Parameter 1]))) THEN [Susbcribers_EOM] END)' />
            </column>
            <column caption='Reporting Year-1 Subscribers Total Month ' datatype='real' name='[Reporting Month-1 Subscribers Total Month (copy)_5182306187677839375]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Reporting_month]=DATEADD(&apos;year&apos;, -1, [Parameters].[Parameter 1]) THEN [Subscribers_total_month] END)' />
            </column>
            <column caption='Reporting Year-1 Subscription Orders' datatype='real' name='[Reporting Month-1 Subscription Orders (copy)_5182306187608829961]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Reporting_month]=DATEADD(&apos;year&apos;, -1, [Parameters].[Parameter 1]) THEN [Subscription_orders] END)' />
            </column>
            <column caption='Reporting 30d Weighted Previous Frequency' datatype='real' name='[Reporting Month-1 Weighted Current Frequency (copy)_239324150182277158]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;IF [Reporting_month] = DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1]) THEN&#10;([Pre_subs_frequency_30d_before])&#10;*&#10;([Subscribers_total_month])&#10;END)&#10;/&#10;SUM(if [Reporting_month] = DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1]) THEN [Subscribers_total_month] END)' />
            </column>
            <column caption='Reporting Year-1 Weighted FLGPO (non-subs)' datatype='real' name='[Reporting Month-1 Weighted FLGPO (non-subs) (copy)_427067921514545175]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;sum(&#10;    (if [Reporting_month] = DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1]) THEN ([FLGP_non_subscribers_eur]/[Non_subscription_orders]) END)&#10;    *&#10;    (if [Reporting_month] = DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1]) THEN [Subscription_orders] END)&#10;)&#10;/&#10;sum(if [Reporting_month] = DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1]) THEN [Subscription_orders] END)&#10;)' />
            </column>
