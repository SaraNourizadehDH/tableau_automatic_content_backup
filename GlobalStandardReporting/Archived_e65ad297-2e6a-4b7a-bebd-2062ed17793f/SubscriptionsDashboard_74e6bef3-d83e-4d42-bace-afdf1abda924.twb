  <worksheets>
    <worksheet name='% MAU among Cohort: LaL / Subs'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='12'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Subs Incrementality' name='federated.0stqs3r138lfb911whugh1s7bqgb' />
          </datasources>
          <datasource-dependencies datasource='federated.0stqs3r138lfb911whugh1s7bqgb'>
            <column caption='%MAU (LaL)' datatype='real' name='[Calculation_946037435181068291]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// works only across different cohorts. &#13;&#10;SUM([ctrl_customers_with_orders]) / SUM([group_size])' />
            </column>
            <column caption='%MAU (Subs)' datatype='real' name='[Retention Rate (LaL) (copy)_946037435181170692]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// works only across different cohorts. &#13;&#10;SUM([test_customers_with_orders]) / SUM([group_size])' />
            </column>
            <column caption='Cohort Month' datatype='date' name='[cohort_month]' role='dimension' type='ordinal' />
            <column caption='MAU (LaL)' datatype='integer' name='[ctrl_customers_with_orders]' role='measure' type='quantitative' />
            <column caption='Month' datatype='date' name='[date_month]' role='dimension' type='ordinal' />
            <column caption='Cohort Size' datatype='integer' name='[group_size]' role='measure' type='quantitative' />
            <column caption='L30D Order Frequency Bins' datatype='string' name='[l30d_freq_bin]' role='dimension' type='nominal' />
