            <column-instance column='[Calculation_2560366808999563265]' derivation='None' name='[none:Calculation_2560366808999563265:nk]' pivot='key' type='nominal' />
            <column-instance column='[Reporting_month]' derivation='None' name='[none:Reporting_month:ok]' pivot='key' type='ordinal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column-instance column='[management_entity]' derivation='None' name='[none:management_entity:nk]' pivot='key' type='nominal' />
            <column-instance column='[metric_type]' derivation='None' name='[none:metric_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[metrics_name]' derivation='None' name='[none:metrics_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2560366808997163008]' derivation='Sum' name='[sum:Calculation_2560366808997163008:qk]' pivot='key' type='quantitative' />
            <column-instance column='[central_pipeline]' derivation='Sum' name='[sum:central_pipeline:qk]' pivot='key' type='quantitative' />
            <column-instance column='[local_pipeline]' derivation='Sum' name='[sum:local_pipeline:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
