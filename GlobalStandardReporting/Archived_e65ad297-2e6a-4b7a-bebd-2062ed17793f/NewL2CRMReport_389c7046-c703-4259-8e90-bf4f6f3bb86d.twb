          <datasource-dependencies datasource='federated.1bcfran00nqg9l12ezxrp164zw8a'>
            <column caption='Order Frequency' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_2572822087651901441]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders]) / SUM([active_customers])' />
            </column>
            <column caption='MoM Order Frequency' datatype='real' name='[Calculation_6669056994032173061]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN([Calculation_2572822087651901441]) - LOOKUP(ZN([Calculation_2572822087651901441]), -1)) / ABS(LOOKUP(ZN([Calculation_2572822087651901441]), -1))'>
