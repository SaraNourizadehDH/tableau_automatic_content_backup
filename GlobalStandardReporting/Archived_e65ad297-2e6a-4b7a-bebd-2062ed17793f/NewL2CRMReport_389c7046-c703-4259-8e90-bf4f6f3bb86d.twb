      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1bcfran00nqg9l12ezxrp164zw8a (copy)].[sum:new_customers:qk]&quot;' value='New' />
          <alias key='&quot;[federated.1bcfran00nqg9l12ezxrp164zw8a (copy)].[sum:reactivated_customers:qk]&quot;' value='Reactivated' />
          <alias key='&quot;[federated.1bcfran00nqg9l12ezxrp164zw8a (copy)].[sum:reactivated_plus_customers:qk]&quot;' value='Reactivated Plus' />
          <alias key='&quot;[federated.1bcfran00nqg9l12ezxrp164zw8a (copy)].[sum:retained_1er_customers:qk]&quot;' value='Retained - 1er' />
          <alias key='&quot;[federated.1bcfran00nqg9l12ezxrp164zw8a (copy)].[sum:retained_high_customers:qk]&quot;' value='Retained - High' />
          <alias key='&quot;[federated.1bcfran00nqg9l12ezxrp164zw8a (copy)].[sum:retained_low_customers:qk]&quot;' value='Retained - Low' />
          <alias key='&quot;[federated.1bcfran00nqg9l12ezxrp164zw8a (copy)].[sum:retained_mid_customers:qk]&quot;' value='Retained - Mid' />
        </aliases>
      </column>
      <column caption='Previous Reporting Month' datatype='date' name='[Calculation_188095718684676096]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATEADD(&apos;month&apos;, -1, [Parameters].[Parameter 3]))' />
      </column>
      <column caption='Sankey Stable Movement Filter' datatype='boolean' name='[Calculation_188095718688878594]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_4600567822036283394] = [Calculation_4600567822035533825] THEN TRUE&#10;ELSE FALSE END' />
      </column>
      <column caption='Sankey Stable Movement Include Filter' datatype='boolean' name='[Calculation_188095718689013763]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = TRUE THEN [Calculation_188095718688878594] = TRUE OR [Calculation_188095718688878594] = FALSE&#10;ELSEIF [Parameters].[Parameter 4] = FALSE THEN [Calculation_188095718688878594] = FALSE&#10;END' />
      </column>
      <column caption='Segment Movement Way Filter' datatype='string' name='[Calculation_188095718736740362]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 5]' />
      </column>
      <column caption='Sankey CM KPI Selector' datatype='integer' name='[Calculation_188095718744109067]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [global_entity_id], [management_entity], [country_name], [Parameters].[Parameter 3], [Calculation_4600567822035533825] : SUM([Calculation_4600567822040137749]) }' />
      </column>
      <column caption='Current Segment' datatype='string' name='[Calculation_4600567822035533825]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE&#10;    [customer_segment_movement]&#10;        WHEN &quot;new_customers&quot; THEN &quot;New&quot;&#10;        WHEN &quot;reactivated_plus_customers&quot; THEN &quot;Reactivated &gt; 365d&quot;&#10;        WHEN &quot;retained_from_new&quot; THEN &quot;Retained&quot;&#10;        WHEN &quot;retained_from_reactivated_plus&quot; THEN &quot;Retained&quot;&#10;        WHEN &quot;retained_from_retained&quot; THEN &quot;Retained&quot;&#10;        WHEN &quot;retained_from_reactivated&quot; THEN &quot;Retained&quot;&#10;        WHEN &quot;reactivated_from_churned&quot; THEN &quot;Reactivated&quot;&#10;        WHEN &quot;reactivated_from_inactive&quot; THEN &quot;Reactivated&quot;&#10;        WHEN &quot;churned_from_new&quot; THEN &quot;Churned&quot;&#10;        WHEN &quot;churned_from_reactivated_plus&quot; THEN &quot;Churned&quot;&#10;        WHEN &quot;churned_from_retained&quot; THEN &quot;Churned&quot;&#10;        WHEN &quot;churned_from_reactivated&quot; THEN &quot;Churned&quot;&#10;        WHEN &quot;churned_from_churned&quot; THEN &quot;Churned&quot;&#10;        WHEN &quot;inactive_from_churned&quot; THEN &quot;Inactive&quot;&#10;        WHEN &quot;inactive_from_inactive&quot; THEN &quot;Inactive&quot;&#10;        WHEN &quot;lost_from_inactive&quot; THEN &quot;Lost&quot;&#10;        WHEN &quot;lost_from_lost&quot; THEN &quot;Lost&quot;&#10;END' />
        <aliases>
          <alias key='&quot;Reactivated Plus&quot;' value='Reactivated &gt; 365d' />
        </aliases>
      </column>
      <column caption='Previous Segment' datatype='string' name='[Calculation_4600567822036283394]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE&#10;    [customer_segment_movement]&#10;        WHEN &quot;new_customers&quot; THEN &quot;Prospect&quot;&#10;        WHEN &quot;reactivated_plus_customers&quot; THEN &quot;Lost&quot;&#10;        WHEN &quot;retained_from_new&quot; THEN &quot;New&quot;&#10;        WHEN &quot;retained_from_reactivated_plus&quot; THEN &quot;Reactivated &gt; 365d&quot;&#10;        WHEN &quot;retained_from_retained&quot; THEN &quot;Retained&quot;&#10;        WHEN &quot;retained_from_reactivated&quot; THEN &quot;Reactivated&quot;&#10;        WHEN &quot;reactivated_from_churned&quot; THEN &quot;Churned&quot;&#10;        WHEN &quot;reactivated_from_inactive&quot; THEN &quot;Inactive&quot;&#10;        WHEN &quot;churned_from_new&quot; THEN &quot;New&quot;&#10;        WHEN &quot;churned_from_reactivated_plus&quot; THEN &quot;Reactivated &gt; 365d&quot;&#10;        WHEN &quot;churned_from_retained&quot; THEN &quot;Retained&quot;&#10;        WHEN &quot;churned_from_reactivated&quot; THEN &quot;Reactivated&quot;&#10;        WHEN &quot;churned_from_churned&quot; THEN &quot;Churned&quot;&#10;        WHEN &quot;inactive_from_churned&quot; THEN &quot;Churned&quot;&#10;        WHEN &quot;inactive_from_inactive&quot; THEN &quot;Inactive&quot;&#10;        WHEN &quot;lost_from_inactive&quot; THEN &quot;Inactive&quot;&#10;        WHEN &quot;lost_from_lost&quot; THEN &quot;Lost&quot;&#10;END' />
      </column>
      <column caption='SC - T' datatype='real' name='[Calculation_4600567822038097923]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_4600567822038155268] &lt; 50 THEN (([Calculation_4600567822038155268]-1)%49)/4-6 ELSE 12 - (([Calculation_4600567822038155268]-1)%49)/4-6 END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='SC - Index' datatype='integer' name='[Calculation_4600567822038155268]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='SC - Sigmoid' datatype='real' name='[Calculation_4600567822038220805]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1/(1+EXP(1)^-[Calculation_4600567822038097923])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='SC - Polygons' datatype='real' name='[Calculation_4600567822038302726]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_4600567822038155268] &gt; 49&#10;    THEN [Calculation_4600567822039506960]+([Calculation_4600567822039269390]-[Calculation_4600567822039506960])*[Calculation_4600567822038220805]&#10;ELSE [Calculation_4600567822038769674]+([Calculation_4600567822038568968]-[Calculation_4600567822038769674])*[Calculation_4600567822038220805]&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='SC - Path Frame' datatype='integer' name='[Calculation_4600567822038396935]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_4600567822040137749] = {FIXED : MIN([Calculation_4600567822040137749])} THEN 0 ELSE 97 END' />
      </column>
      <column caption='SC - Min Position 2 Wrap' datatype='real' name='[Calculation_4600567822038568968]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_SUM([Calculation_4600567822038671369])'>
