      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='bima_tableau_customer_monthly_summary' id='bima_tableau_customer_monthly_summary_C199E65ADDA34F11A7A36316BECEBD39'>
            <properties context=''>
              <relation join='inner' type='join'>
                <clause type='join'>
                  <expression op='='>
                    <expression op='[Custom SQL Query].[global_entity_id]' />
                    <expression op='[tableau_gsr_entitlements_marketing_global_entity_id].[global_entity_id]' />
                  </expression>
                </clause>
                <relation connection='bigquery.1tkrx8a1ww0tvj16bliee1jlp0ol (copy)' name='Custom SQL Query' type='text'>SELECT
  global_entity_id,
  brand,
  management_entity,
  country_name,
  city,
  month_date,
  customer_segment_movement,
  SUM(customer_count) AS customer_count
FROM `fulfillment-dwh-production.rl_mkt.bima_tableau_customer_monthly_summary`
UNPIVOT (
  customer_count FOR customer_segment_movement IN (
      new_customers,
      reactivated_plus_customers,
      retained_from_new,
      retained_from_reactivated_plus,
      retained_from_retained,
      retained_from_reactivated,
      reactivated_from_churned,
      reactivated_from_inactive,
      churned_from_new,
      churned_from_reactivated_plus,
      churned_from_retained,
      churned_from_reactivated,
      churned_from_churned,
      inactive_from_churned,
      inactive_from_inactive,
      lost_from_inactive,
      lost_from_lost
  )
)
GROUP BY 
    global_entity_id,
    brand,
    management_entity,
    country_name,
    city,
    month_date,
    customer_segment_movement</relation>
                <relation connection='bigquery.1tkrx8a1ww0tvj16bliee1jlp0ol (copy)' name='tableau_gsr_entitlements_marketing_global_entity_id' table='[fulfillment-dwh-production.rl_mkt].[tableau_gsr_entitlements_marketing_global_entity_id]' type='table' />
              </relation>
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
