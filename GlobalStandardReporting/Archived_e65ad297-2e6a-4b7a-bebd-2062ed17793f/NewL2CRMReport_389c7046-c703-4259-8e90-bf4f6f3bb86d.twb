      <column caption='Customer Base Detail - Dashboard Title' datatype='string' name='[Calculation_300826445107007489]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE&#10;    [Parameters].[Parameter 2]&#10;        WHEN &quot;Active Segments&quot; THEN &quot;Customer Base Growth - Active Segments&quot;&#10;        WHEN &quot;All Segments&quot; THEN &quot;Customer Base Growth - All Segments&quot;&#10;END' />
      </column>
      <column caption='Total Customer Base (p Active / All Segments)' datatype='integer' name='[Calculation_300826445110865922]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE&#10;    [Parameters].[Parameter 2]&#10;    WHEN &quot;Active Segments&quot; THEN [new_customers] + [reactivated_plus_customers] + [retained_customers] + [reactivated_customers]&#10;    WHEN &quot;All Segments&quot; THEN [new_customers] + [reactivated_plus_customers] + [retained_customers] + [reactivated_customers] + [churned_customers] + [inactive_customers] + [lost_customers]&#10;END' />
