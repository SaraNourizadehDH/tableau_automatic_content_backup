            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='9'>Retained</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='9'>Customers %</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Customer Monthly Summary' name='federated.1bcfran00nqg9l12ezxrp164zw8a' />
          </datasources>
          <datasource-dependencies datasource='federated.1bcfran00nqg9l12ezxrp164zw8a'>
            <column caption='Customer Base' datatype='integer' name='[Calculation_2572822087639019520]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[user_base]' />
            </column>
            <column caption='Retained Customers %' datatype='real' default-format='p0.0%' name='[Calculation_2572822087670992898]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([retained_customers]) / SUM([Calculation_2572822087639019520])' />
            </column>
            <column caption='Retained 1Er Customers % in Retained' datatype='real' default-format='p0.0%' name='[Calculation_2572822087672684547]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([retained_1er_customers]) / SUM([retained_customers])' />
            </column>
            <column caption='Churn Risk % in Retained Customers' datatype='real' default-format='p0.0%' name='[Calculation_2572822087677358087]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([churn_risk_customers]) / SUM([retained_customers])' />
            </column>
            <column caption='Management entity' datatype='string' name='[Calculation_5939544225650028545]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [brand]&#10;    WHEN &quot;Yemeksepeti&quot; THEN [brand]&#10;    ELSE [management_entity]&#10;END' />
            </column>
            <column caption='MoM Retained Customers %' datatype='real' name='[Calculation_6669056994034122760]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN([Calculation_2572822087670992898]) - LOOKUP(ZN([Calculation_2572822087670992898]), -1)) / ABS(LOOKUP(ZN([Calculation_2572822087670992898]), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Label Down Retained Customers %' datatype='real' default-format='p0.0%' name='[Label Down Order Frequency (copy)_6669056994034294793]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_6669056994034122760] &lt; 0 THEN [Calculation_2572822087670992898] END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Label Up Retained Customers %' datatype='real' default-format='p0.0%' name='[Label Down Retained Customers % (copy)_6669056994034503690]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_6669056994034122760] &gt;= 0 THEN [Calculation_2572822087670992898] END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Retained Low Customers % in Retained' datatype='real' default-format='p0.0%' name='[Retained 1Er Customers % in Retained (copy)_2572822087673155588]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([retained_low_customers]) / SUM([retained_customers])' />
            </column>
            <column caption='Retained Mid Customers % in Retained' datatype='real' default-format='p0.0%' name='[Retained Low Customers % in Retained (copy) (copy)_2572822087673270277]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([retained_mid_customers]) / SUM([retained_customers])' />
            </column>
