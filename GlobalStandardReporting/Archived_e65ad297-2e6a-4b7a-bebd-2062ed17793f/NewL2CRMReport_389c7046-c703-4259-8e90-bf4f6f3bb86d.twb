    <worksheet name='Europe - Summary - Reactivated Customers %'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='9'>Reactivated&#10;Customers %</run>
            <run fontalignment='1'>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Customer Monthly Summary' name='federated.1bcfran00nqg9l12ezxrp164zw8a' />
          </datasources>
          <datasource-dependencies datasource='federated.1bcfran00nqg9l12ezxrp164zw8a'>
            <column caption='Customer Base' datatype='integer' name='[Calculation_2572822087639019520]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[user_base]' />
            </column>
            <column caption='Reactivated Customers %' datatype='real' default-format='p0.0%' name='[Calculation_2572822087686443018]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([reactivated_customers]) / SUM([Calculation_2572822087639019520])' />
            </column>
            <column caption='Management entity' datatype='string' name='[Calculation_5939544225650028545]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [brand]&#10;    WHEN &quot;Yemeksepeti&quot; THEN [brand]&#10;    ELSE [management_entity]&#10;END' />
            </column>
            <column caption='Share of Reactivated From Inactive in Reactivated Customers' datatype='real' default-format='p0.0%' name='[Calculation_6669056993999912963]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([reactivated_from_inactive]) / SUM([reactivated_customers])' />
            </column>
            <column caption='MoM Reactivated Customers %' datatype='real' name='[Calculation_6669056994035568651]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN([Calculation_2572822087686443018]) - LOOKUP(ZN([Calculation_2572822087686443018]), -1)) / ABS(LOOKUP(ZN([Calculation_2572822087686443018]), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Label Up Reactivated Customers %' datatype='real' default-format='p0.0%' name='[Label Down Reacticated Customers % (copy)_6669056994036396046]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_6669056994035568651] &gt;= 0 THEN [Calculation_2572822087686443018] END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Label Down Reactivated Customers %' datatype='real' default-format='p0.0%' name='[Label Down Retained Customers % (copy)_6669056994036199437]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_6669056994035568651] &lt; 0 THEN [Calculation_2572822087686443018] END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Share of Reactivated From Churned in Reactivated Customers' datatype='real' default-format='p0.0%' name='[Share of Reactivated From Inactive in Reactivated Customers (copy)_6669056994000166916]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([reactivated_from_churned]) / SUM([reactivated_customers])' />
            </column>
            <column caption='Brand' datatype='string' name='[brand]' role='dimension' type='nominal' />
