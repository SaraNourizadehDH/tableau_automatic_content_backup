      <table>
        <view>
          <datasources>
            <datasource caption='Customer Monthly Summary' name='federated.1bcfran00nqg9l12ezxrp164zw8a' />
          </datasources>
          <datasource-dependencies datasource='federated.1bcfran00nqg9l12ezxrp164zw8a'>
            <column caption='% Active Customers' datatype='real' default-format='p0.0%' name='[Calculation_1352909538279907334]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([active_customers]) / SUM([user_base])' />
            </column>
            <column caption='MoM % Active Customers' datatype='real' name='[Calculation_6669056993975488512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN([Calculation_1352909538279907334]) - LOOKUP(ZN([Calculation_1352909538279907334]), -1)) / ABS(LOOKUP(ZN([Calculation_1352909538279907334]), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Label Down % Active Customers' datatype='real' default-format='p0.0%' name='[Calculation_6669056993997996033]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_6669056993975488512] &lt; 0 THEN [Calculation_1352909538279907334] END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Label Up % Active Customers' datatype='real' default-format='p0.0%' name='[Label Down % Active Customers (copy)_6669056993998372866]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_6669056993975488512] &gt;= 0 THEN [Calculation_1352909538279907334] END'>
                <table-calc ordering-type='Rows' />
              </calculation>
