    <worksheet name='LATAM - Summary - Non Active Customers %'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='9'>Non Active</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='9'>Customers %</run>
            <run fontalignment='1'>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Customer Monthly Summary' name='federated.1bcfran00nqg9l12ezxrp164zw8a' />
          </datasources>
          <datasource-dependencies datasource='federated.1bcfran00nqg9l12ezxrp164zw8a'>
            <column caption='Customer Base' datatype='integer' name='[Calculation_2572822087639019520]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[user_base]' />
            </column>
            <column caption='Non Active Customers %' datatype='real' default-format='p0.0%' name='[Calculation_2572822087693357069]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([churned_customers] + [inactive_customers] + [lost_customers]) / SUM([Calculation_2572822087639019520])' />
            </column>
            <column caption='Churned Customers in Non Active Segments %' datatype='real' default-format='p0.0%' name='[Calculation_2572822087696429072]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([churned_customers]) / SUM([Non Active Customers % (copy)_2572822087693631502])' />
            </column>
            <column caption='MoM Non Active Customers %' datatype='real' name='[Calculation_6669056994040389653]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN([Calculation_2572822087693357069]) - LOOKUP(ZN([Calculation_2572822087693357069]), -1)) / ABS(LOOKUP(ZN([Calculation_2572822087693357069]), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Inactive Customers in Non Active Segments %' datatype='real' default-format='p0.0%' name='[Churned Customers in Non Active Segments % (copy)_2572822087696642065]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([inactive_customers]) / SUM([Non Active Customers % (copy)_2572822087693631502])' />
            </column>
            <column caption='Lost Customers in Non Active Segments %' datatype='real' default-format='p0.0%' name='[Churned Customers in Non Active Segments % (copy)_2572822087696896018]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([lost_customers]) / SUM([Non Active Customers % (copy)_2572822087693631502])' />
            </column>
            <column caption='Label Up Non Active Customers %' datatype='real' default-format='p0.0%' name='[Label Down Non Active Customers % (copy)_6669056994040717335]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_6669056994040389653] &lt;= 0 THEN [Calculation_2572822087693357069] END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Label Down Non Active Customers %' datatype='real' default-format='p0.0%' name='[Label Down Retained Customers % (copy)_6669056994040475670]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_6669056994040389653] &gt; 0 THEN [Calculation_2572822087693357069] END'>
                <table-calc ordering-type='Rows' />
