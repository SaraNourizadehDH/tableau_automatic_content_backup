      <column caption='Current Month Segments' datatype='string' name='[Calculation_1352909538234867714]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//Retained&#10;IF [retained_from_new] &gt; 0 THEN &quot;Retained&quot;&#10;ELSEIF [retained_from_reactivated] &gt; 0 THEN &quot;Retained&quot;&#10;ELSEIF [retained_from_reactivated_plus] &gt; 0 THEN &quot;Retained&quot;&#10;ELSEIF [retained_from_retained] &gt; 0 THEN &quot;Retained&quot;&#10;//Reactivated&#10;ELSEIF [reactivated_from_churned] &gt; 0 THEN &quot;Reactivated&quot;&#10;ELSEIF [reactivated_from_inactive] &gt; 0 THEN &quot;Reactivated&quot;&#10;//Churned&#10;ELSEIF [churned_from_new] &gt; 0 THEN &quot;Churned&quot;&#10;ELSEIF [churned_from_reactivated_plus] &gt; 0 THEN &quot;Churned&quot;&#10;ELSEIF [churned_from_retained] &gt; 0 THEN &quot;Churned&quot;&#10;ELSEIF [churned_from_reactivated] &gt; 0 THEN &quot;Churned&quot;&#10;ELSEIF [churned_from_churned] &gt; 0 THEN &quot;Churned&quot;&#10;//Inactive&#10;ELSEIF [inactive_from_churned] &gt; 0 THEN &quot;Inactive&quot;&#10;ELSEIF [inactive_from_inactive] &gt; 0 THEN &quot;Inactive&quot;&#10;//Lost&#10;ELSEIF [lost_from_inactive] &gt; 0 THEN &quot;Lost&quot;&#10;ELSEIF [lost_from_lost] &gt; 0 THEN &quot;Lost&quot;&#10;END' />
      </column>
      <column caption='% Active Customers' datatype='real' default-format='p0.0%' name='[Calculation_1352909538279907334]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([active_customers]) / SUM([user_base])' />
      </column>
      <column caption='Raw Data Options Filter' datatype='string' name='[Calculation_188095718766571533]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 6]' />
      </column>
      <column caption='Last 6 Months Filter' datatype='boolean' name='[Calculation_188095718779379726]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[month_date] &lt;= [Parameters].[Parameter 3] AND &#10;[month_date] &gt; DATEADD(&apos;month&apos;, -6, [Parameters].[Parameter 3])' />
      </column>
      <column caption='MoM % Orders Qc And Restaurant' datatype='real' default-format='p0.0%' name='[Calculation_188095718780063759]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([orders_qc_and_restaurant]) / SUM([orders_qc_and_restaurant_mom])) - 1' />
      </column>
      <column caption='MoM % Orders Only QC Down' datatype='real' default-format='*▲ 0.0%; ▼ -0.0%; 0.0%' name='[Calculation_188095718784278551]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [MoM % Orders Only Restaurant (copy)_188095718783070228] &lt; 0 THEN [MoM % Orders Only Restaurant (copy)_188095718783070228] ELSE NULL END' />
      </column>
      <column caption='Reporting Month Filter' datatype='boolean' name='[Calculation_188095718787272733]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 3] = [month_date]' />
      </column>
      <column caption='Customer Base' datatype='integer' name='[Calculation_2572822087639019520]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[user_base]' />
      </column>
      <column caption='Order Frequency' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_2572822087651901441]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders]) / SUM([active_customers])' />
      </column>
      <column caption='Retained Customers %' datatype='real' default-format='p0.0%' name='[Calculation_2572822087670992898]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([retained_customers]) / SUM([Calculation_2572822087639019520])' />
      </column>
      <column caption='Retained 1Er Customers % in Retained' datatype='real' default-format='p0.0%' name='[Calculation_2572822087672684547]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([retained_1er_customers]) / SUM([retained_customers])' />
      </column>
      <column caption='Churn Risk % in Retained Customers' datatype='real' default-format='p0.0%' name='[Calculation_2572822087677358087]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([churn_risk_customers]) / SUM([retained_customers])' />
      </column>
      <column caption='Reactivated Customers %' datatype='real' default-format='p0.0%' name='[Calculation_2572822087686443018]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([reactivated_customers]) / SUM([Calculation_2572822087639019520])' />
      </column>
      <column caption='New Customers %' datatype='real' default-format='p0.0%' name='[Calculation_2572822087687684107]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([new_customers]) / SUM([Calculation_2572822087639019520])' />
      </column>
      <column caption='Reactivated &gt; 365d Customers %' datatype='real' default-format='p0.0%' name='[Calculation_2572822087692185612]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([reactivated_plus_customers]) / SUM([Calculation_2572822087639019520])' />
      </column>
      <column caption='Non Active Customers %' datatype='real' default-format='p0.0%' name='[Calculation_2572822087693357069]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([churned_customers] + [inactive_customers] + [lost_customers]) / SUM([Calculation_2572822087639019520])' />
      </column>
      <column caption='Churned Customers in Non Active Segments %' datatype='real' default-format='p0.0%' name='[Calculation_2572822087696429072]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([churned_customers]) / SUM([Non Active Customers % (copy)_2572822087693631502])' />
      </column>
      <column caption='Filter Customer Base Detail' datatype='string' name='[Calculation_300826445104893952]' role='dimension' type='nominal'>
