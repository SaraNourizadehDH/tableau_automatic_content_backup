      <aliases enabled='yes' />
      <column caption='User Entitlement Filter' datatype='boolean' name='[Calculation_1099300584141987841]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='USERNAME()=[username]' />
      </column>
      <column caption='Retention-Text' datatype='string' name='[Calculation_3300434886521446400]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IIF([Calculation_5554205023555784708] == 1, &#10;    STR(ROUND(SUM([returning_customers] / 1000), 0)) + &apos;K&apos;,&#10;    STR(ROUND([Calculation_5554205023555784708] * 100, 1)) + &apos;%&apos;)' />
      </column>
      <column caption='Orders (w/o Incentives)' datatype='real' name='[Calculation_5554205023555354627]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[orders] - [orders_with_incentives]' />
      </column>
      <column caption='Retention Rate' datatype='real' name='[Calculation_5554205023555784708]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;CASE [Parameters].[Parameter 5]&#10;WHEN &apos;1&apos; THEN [returning_customers]&#10;WHEN &apos;2&apos; THEN [returning_customers_food]&#10;WHEN &apos;3&apos; THEN [returning_customers_dmarts]&#10;WHEN &apos;4&apos; THEN [returning_customers_localshops]&#10;END&#10;)&#10;/ &#10;SUM([customers])' />
      </column>
      <column caption='Frequency' datatype='real' name='[Calculation_5554205023556071429]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;CASE [Parameters].[Parameter 5]&#10;WHEN &apos;1&apos; THEN [orders]&#10;WHEN &apos;2&apos; THEN [orders_food]&#10;WHEN &apos;3&apos; THEN [orders_dmarts]&#10;WHEN &apos;4&apos; THEN [orders_localshops]&#10;END&#10;)&#10;/ &#10;SUM([customers])' />
      </column>
      <column caption='Activity' datatype='real' name='[Calculation_5554205023556276230]' role='measure' type='quantitative'>
