    <worksheet name='Fraud Inspection I'>
      <table>
        <view>
          <datasources>
            <datasource caption='Incentive Fraud' name='federated.0prsli40gonshk1a3b61c1fmv7rk' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Orders' caption='Fraud Parameter I' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;3&quot;'>
              <calculation class='tableau' formula='&quot;3&quot;' />
              <aliases>
                <alias key='&quot;1&quot;' value='Acquisitions' />
                <alias key='&quot;2&quot;' value='Trials' />
                <alias key='&quot;3&quot;' value='Orders' />
                <alias key='&quot;4&quot;' value='Customers' />
                <alias key='&quot;5&quot;' value='DH Incentive Spend (Euros)' />
                <alias key='&quot;6&quot;' value='Incentive Spend (Euros)' />
                <alias key='&quot;7&quot;' value='GBV (Euros)' />
                <alias key='&quot;8&quot;' value='GMV (Euros)' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0prsli40gonshk1a3b61c1fmv7rk'>
            <column caption='Inspection Parameter I' datatype='real' name='[Calculation_1270929933586763789]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;1&apos; THEN [acquisitions]&#10;WHEN &apos;2&apos; THEN [trials]&#10;WHEN &apos;3&apos; THEN [orders]&#10;WHEN &apos;4&apos; THEN [customers]&#10;WHEN &apos;5&apos; THEN [dh_incentives_eur]&#10;WHEN &apos;6&apos; THEN [total_incentives_eur]&#10;WHEN &apos;7&apos; THEN [gbv_eur]&#10;WHEN &apos;8&apos; THEN [gmv_eur]&#10;END' />
            </column>
            <column caption='Filter on Incentives' datatype='string' name='[Calculation_6102377555243843584]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([customer_type] == &apos;A: 0%&apos; OR ISNULL([customer_type]), &apos;Non-Incentivised Only&apos;, &apos;Incentivised Only&apos;)' />
            </column>
            <column caption='Inspection Parameter I (text)' datatype='string' name='[Inspection Parameter I (copy)_4334714686588157953]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;1&apos; THEN &apos;Acquisitions&apos;&#10;WHEN &apos;2&apos; THEN &apos;Trials&apos;&#10;WHEN &apos;3&apos; THEN &apos;Orders&apos;&#10;WHEN &apos;4&apos; THEN &apos;Customers&apos;&#10;WHEN &apos;5&apos; THEN &apos;DH Incentives (€)&apos;&#10;WHEN &apos;6&apos; THEN &apos;Total Incentives (€)&apos;&#10;WHEN &apos;7&apos; THEN &apos;GBV (€)&apos;&#10;WHEN &apos;8&apos; THEN &apos;GMV (€)&apos;&#10;END' />
            </column>
            <column caption='Acquisitions' datatype='real' name='[acquisitions]' role='measure' type='quantitative' />
            <column caption='Analysis Frequency' datatype='string' name='[analysis_frequency]' role='dimension' type='nominal' />
            <column-instance column='[Inspection Parameter I (copy)_4334714686588157953]' derivation='Attribute' name='[attr:Inspection Parameter I (copy)_4334714686588157953:nk]' pivot='key' type='nominal' />
            <column-instance column='[analysis_frequency]' derivation='Attribute' name='[attr:analysis_frequency:nk]' pivot='key' type='nominal' />
            <column caption='Customer Type' datatype='string' name='[customer_type]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;0\%&quot;' value='0.00%' />
                <alias key='&quot;Trial Zombie&quot;' value='QC Trial Zombie' />
              </aliases>
            </column>
            <column caption='Customers' datatype='real' name='[customers]' role='measure' type='quantitative' />
            <column caption='DH Incentives (€)' datatype='real' name='[dh_incentives_eur]' role='measure' type='quantitative' />
            <column caption='Display Name' datatype='string' name='[display_name]' role='dimension' type='nominal' />
            <column caption='GBV (€)' datatype='real' name='[gbv_eur]' role='measure' type='quantitative' />
            <column caption='GMV (€)' datatype='real' name='[gmv_eur]' role='measure' type='quantitative' />
            <column caption='Lifetime Order Bins' datatype='string' name='[lifetime_order_bins]' role='dimension' type='nominal' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_6102377555243843584]' derivation='None' name='[none:Calculation_6102377555243843584:nk]' pivot='key' type='nominal' />
            <column-instance column='[analysis_frequency]' derivation='None' name='[none:analysis_frequency:nk]' pivot='key' type='nominal' />
            <column-instance column='[customer_type]' derivation='None' name='[none:customer_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[display_name]' derivation='None' name='[none:display_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[lifetime_order_bins]' derivation='None' name='[none:lifetime_order_bins:nk]' pivot='key' type='nominal' />
            <column-instance column='[management_entity]' derivation='None' name='[none:management_entity:nk]' pivot='key' type='nominal' />
            <column-instance column='[order_date]' derivation='None' name='[none:order_date:ok]' pivot='key' type='ordinal' />
