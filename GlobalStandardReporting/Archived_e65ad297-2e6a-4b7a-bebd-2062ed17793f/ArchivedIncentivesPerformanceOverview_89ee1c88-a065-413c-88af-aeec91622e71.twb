      <aliases enabled='yes' />
      <column caption='User Entitlement Filter' datatype='boolean' name='[Calculation_1099300584167673862]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]=USERNAME()' />
      </column>
      <column caption='% of Orders w/ Incentives (Amount)' datatype='real' name='[Calculation_940267221320331265]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([incentive_type] = &apos;amount&apos; , [order_count], 0)) / SUM([order_count])' />
      </column>
      <column caption='% of Orders w/ Incentives (Delivery Fee)' datatype='real' name='[Calculation_940267221321072642]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([incentive_type] = &apos;delivery_fee&apos;, [order_count], 0)) / SUM([order_count])' />
      </column>
      <column caption='% of Orders w/ Incentives (Item Incentives)' datatype='real' name='[Calculation_940267221321265155]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([incentive_type] IN (&apos;bxgy&apos;, &apos;free_gift&apos;), [order_count], 0)) / SUM([order_count])' />
      </column>
      <column caption='% of Orders w/ Incentives (Percentage)' datatype='real' name='[Calculation_940267221321342980]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([incentive_type] = &apos;percentage&apos;, [order_count], 0)) / SUM([order_count])' />
      </column>
      <column caption='Data Validity (Amount)' datatype='real' name='[Calculation_940267221321506821]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([incentive_type] = &apos;amount&apos; AND &#10;        [is_incentive_cit] AND&#10;        [is_cit_monetary_data_available] AND&#10;        [is_ci_data_available] AND &#10;        [is_ci_monetary_data_available] AND&#10;        NOT [exceeds_max_discount] AND &#10;        NOT [exceeds_maxOV] AND &#10;        NOT ([is_stacked] AND NOT [is_stackable]) AND&#10;        NOT (NOT [is_marketing_channel_available] AND [is_marketing_spend]),&#10;        [order_count],&#10;        0)) &#10;/ &#10;SUM(IIF([incentive_type] = &apos;amount&apos;  AND [is_incentive_cit], [order_count], 0))' />
      </column>
      <column caption='Data Validity (Delivery Fee)' datatype='real' name='[Calculation_940267221322027014]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([incentive_type] = &apos;delivery_fee&apos; AND&#10;        [is_incentive_cit] AND&#10;        [is_cit_monetary_data_available] AND&#10;        [is_ci_data_available] AND &#10;        [is_ci_monetary_data_available] AND&#10;        NOT [exceeds_max_discount] AND &#10;        NOT [exceeds_maxOV] AND &#10;        NOT ([is_stacked] AND NOT [is_stackable]) AND&#10;        NOT (NOT [is_marketing_channel_available] AND [is_marketing_spend]),&#10;        [order_count],&#10;        0)) &#10;/ &#10;SUM(IIF([incentive_type] = &apos;delivery_fee&apos; AND [is_incentive_cit], [order_count], 0))' />
      </column>
      <column caption='Data Validity (Item Incentives)' datatype='real' name='[Calculation_940267221322334215]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([incentive_type] IN (&apos;bxgy&apos;, &apos;free_gift&apos;) AND &#10;        [is_incentive_cit] AND&#10;        [is_cit_monetary_data_available] AND&#10;        [is_ci_data_available] AND &#10;        [is_ci_monetary_data_available] AND&#10;        NOT [exceeds_max_discount] AND &#10;        NOT [exceeds_maxOV] AND &#10;        NOT ([is_stacked] AND NOT [is_stackable]) AND&#10;        NOT (NOT [is_marketing_channel_available] AND [is_marketing_spend]),&#10;        [order_count],&#10;        0)) &#10;/ &#10;SUM(IIF([incentive_type] IN (&apos;bxgy&apos;, &apos;free_gift&apos;) AND [is_incentive_cit], [order_count], 0))' />
      </column>
      <column caption='Data Validity (Percentage)' datatype='real' name='[Calculation_940267221322539016]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([incentive_type] = &apos;percentage&apos; AND &#10;        [is_incentive_cit] AND&#10;        [is_cit_monetary_data_available] AND&#10;        [is_ci_data_available] AND &#10;        [is_ci_monetary_data_available] AND&#10;        NOT [exceeds_max_discount] AND &#10;        NOT [exceeds_maxOV] AND &#10;        NOT ([is_stacked] AND NOT [is_stackable]) AND&#10;        NOT (NOT [is_marketing_channel_available] AND [is_marketing_spend]),&#10;        [order_count],&#10;        0)) &#10;/ &#10;SUM(IIF([incentive_type] = &apos;percentage&apos;  AND [is_incentive_cit], [order_count], 0))' />
      </column>
      <column caption='Value Accuracy (Amount)' datatype='real' name='[Calculation_940267221322653705]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([incentive_type] = &apos;amount&apos; AND [incentive_value_matches], [order_count], 0)) / SUM(IIF([incentive_type] = &apos;amount&apos;, [order_count], 0))' />
      </column>
      <column caption='Value Accuracy (Percentage)' datatype='real' name='[Calculation_940267221322772490]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([incentive_type] = &apos;percentage&apos; AND [incentive_value_matches], [order_count], 0)) / &#10;SUM(IIF([incentive_type] = &apos;percentage&apos;, [order_count], 0))' />
      </column>
      <column caption='Readiness Score' datatype='real' name='[Calculation_940267221323051019]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_940267221323378701] * [Calculation_940267221323165708] * 0.7) + (&#10;    IIF(SUM(IIF([has_voucher],1,0)) &gt; 0, 0.1, 0) + &#10;    IIF(SUM(IIF([has_discount], 1,0)) &gt; 0, 0.1, 0) + &#10;    IIF(SUM(IIF([has_deliveryfee_inc], 1, 0)) &gt; 0, 0.05, 0) + &#10;    IIF(SUM(IIF([has_item_inc], 1, 0)) &gt; 0, 0.05, 0)&#10;)' />
      </column>
      <column caption='Data Validity' datatype='real' name='[Calculation_940267221323165708]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([is_incentive_cit] AND&#10;        [is_cit_monetary_data_available] AND&#10;        [is_ci_data_available] AND &#10;        [is_ci_monetary_data_available] AND&#10;        ([is_within_valid_period] OR ISNULL([is_within_valid_period])) AND&#10;        NOT [exceeds_max_discount] AND &#10;        NOT [exceeds_maxOV] AND &#10;        NOT ([is_stacked] AND NOT [is_stackable]) AND&#10;        NOT (NOT [is_marketing_channel_available] AND [is_marketing_spend]),&#10;        [order_count],&#10;        0)) &#10;/ &#10;SUM(IIF([is_incentive_cit], [order_count], 0))' />
      </column>
      <column caption='Value Accuracy (Amount/Percentage Incentives)' datatype='real' name='[Calculation_940267221323378701]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([incentive_type] IN (&apos;amount&apos;, &apos;percentage&apos;) AND [incentive_value_matches], [order_count], 0)) / &#10;SUM(IIF([incentive_type] IN (&apos;amount&apos;, &apos;percentage&apos;), [order_count], 0))' />
      </column>
      <column caption='Analysis Period' datatype='date' name='[Calculation_940267221327990798]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parameter 1 1], [created_date], &apos;monday&apos;))' />
      </column>
