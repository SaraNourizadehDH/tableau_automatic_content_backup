      <aliases enabled='yes' />
      <column caption='Acqs / Trials (text)' datatype='string' name='[Acqs / Trials (copy)_4714917011445075983]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;1&apos; THEN &apos;Acquisitions&apos;&#10;WHEN &apos;2&apos; THEN &apos;QC Trials&apos;&#10;END' />
      </column>
      <column caption='User Entitlement Filter' datatype='boolean' name='[Calculation_1099300584146161667]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='USERNAME()=[username]' />
      </column>
      <column caption='Inspection Parameter I' datatype='real' name='[Calculation_1270929933586763789]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;1&apos; THEN [acquisitions]&#10;WHEN &apos;2&apos; THEN [trials]&#10;WHEN &apos;3&apos; THEN [orders]&#10;WHEN &apos;4&apos; THEN [customers]&#10;WHEN &apos;5&apos; THEN [dh_incentives_eur]&#10;WHEN &apos;6&apos; THEN [total_incentives_eur]&#10;WHEN &apos;7&apos; THEN [gbv_eur]&#10;WHEN &apos;8&apos; THEN [gmv_eur]&#10;END' />
      </column>
      <column caption='Activity' datatype='real' name='[Calculation_1270929933596102672]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders]) / SUM([customers])' />
      </column>
      <column caption='Acqs / QC Trials' datatype='real' name='[Calculation_4714917011442110464]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;1&apos; THEN [acquisitions]&#10;WHEN &apos;2&apos; THEN [trials]&#10;END' />
      </column>
      <column caption='Spend' datatype='real' name='[Calculation_4714917011442319361]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;1&apos; THEN [dh_incentives_eur]&#10;WHEN &apos;2&apos; THEN [total_incentives_eur]&#10;END' />
      </column>
      <column caption='GMV / GBV' datatype='real' name='[Calculation_4714917011443777542]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;1&apos; THEN [gmv_eur]&#10;WHEN &apos;2&apos; THEN [gbv_eur]&#10;END' />
      </column>
      <column caption='Filter on Incentives' datatype='string' name='[Calculation_6102377555243843584]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([customer_type] == &apos;A: 0%&apos; OR ISNULL([customer_type]), &apos;Non-Incentivised Only&apos;, &apos;Incentivised Only&apos;)' />
      </column>
