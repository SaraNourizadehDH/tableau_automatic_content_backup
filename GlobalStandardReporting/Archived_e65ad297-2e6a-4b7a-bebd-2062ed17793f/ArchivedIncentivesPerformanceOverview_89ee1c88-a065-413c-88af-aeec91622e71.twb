      </column>
      <column caption='Acqs / QC Trials' datatype='real' name='[Calculation_1270929933247164417]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;1&apos; THEN [acquisitions]&#10;WHEN &apos;2&apos; THEN [trials]&#10;END' />
      </column>
      <column caption='Cost on Voucher' datatype='real' name='[Calculation_1270929933247578115]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;1&apos; THEN [dh_incentive_cost] - [stacked_other_dh_cost]&#10;WHEN &apos;2&apos; THEN [incentive_cost] - [stacked_other_cost]&#10;END' />
      </column>
      <column caption='inCPO (€) (Voucher Only)' datatype='real' name='[Calculation_2681471407786409987]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1270929933247578115]) / SUM([orders])' />
      </column>
      <column caption='% Stacked' datatype='real' name='[Calculation_2681471407786536964]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([stacked_orders]) / SUM([orders])' />
      </column>
      <column caption='inCPGMV % (Voucher Only)' datatype='real' name='[Calculation_2681471407787237381]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1270929933247578115]) / SUM([gmv] - [gmv_share_of_stacked])' />
      </column>
      <column caption='Incentive Cost (€)' datatype='real' name='[Calculation_2681471407787646982]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;1&apos; THEN [dh_incentive_cost]&#10;WHEN &apos;2&apos; THEN [incentive_cost]&#10;END' />
      </column>
      <column caption='Other Stacked Incentive Cost (€)' datatype='real' name='[Calculation_2681471407787888647]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;1&apos; THEN [stacked_other_dh_cost]&#10;WHEN &apos;2&apos; THEN [stacked_other_cost]&#10;END' />
      </column>
      <column caption='% Stacked Cost' datatype='real' name='[Calculation_2681471407789002760]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_2681471407787888647]) / SUM([Calculation_2681471407787646982])' />
      </column>
      <column caption='Country Cost (€)' datatype='real' name='[Calculation_2681471407790981130]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;1&apos; THEN [country_dh_contribution_eur]&#10;WHEN &apos;2&apos; THEN [country_total_incentives_eur]&#10;END' />
      </column>
      <column caption='% from Country Share' datatype='real' name='[Calculation_2681471407791153163]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_2681471407787646982] - [Calculation_2681471407787888647]) /&#10;SUM([Calculation_2681471407790981130])' />
      </column>
      <column caption='Cost on Order' datatype='real' name='[Cost on Voucher (copy)_1270929933247844356]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;1&apos; THEN [dh_incentive_cost]&#10;WHEN &apos;2&apos; THEN [incentive_cost]&#10;END' />
