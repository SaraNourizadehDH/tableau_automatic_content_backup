              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.06b8ia20c36l9e11i63851fqsdgf].[sum:DH funded  voucher with incentive no stacking (copy)_4062176526549827588:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.06b8ia20c36l9e11i63851fqsdgf].[sum:DH funded voucher with incentive no stacking (copy)_4062176526550433797:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.06b8ia20c36l9e11i63851fqsdgf].[sum:DH funded  voucher with incentive stacking (copy)_4062176526548496385:qk]&quot;' />
            </groupfilter>
          </filter>
          <manual-sort column='[federated.06b8ia20c36l9e11i63851fqsdgf].[:Measure Names]' direction='ASC'>
