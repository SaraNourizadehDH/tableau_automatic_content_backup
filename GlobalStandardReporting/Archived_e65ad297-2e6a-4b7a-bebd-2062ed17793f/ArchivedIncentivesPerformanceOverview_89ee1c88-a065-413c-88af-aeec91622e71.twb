            <column-instance column='[segment]' derivation='None' name='[none:segment:nk]' pivot='key' type='nominal' />
            <column-instance column='[vouchers_first_entry_date]' derivation='None' name='[none:vouchers_first_entry_date:ok]' pivot='key' type='ordinal' />
            <column caption='Orders' datatype='real' name='[order_count]' role='measure' type='quantitative' />
            <column caption='Segment' datatype='string' name='[segment]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_940267221323051019]' derivation='User' name='[usr:Calculation_940267221323051019:qk]' pivot='key' type='quantitative' />
            <column caption='First Voucher Data Received' datatype='date' name='[vouchers_first_entry_date]' role='dimension' type='quantitative' />
          </datasource-dependencies>
          <filter class='quantitative' column='[federated.0321c3312biaqd1e5uugv1q151se].[none:Calculation_940267221327990798:qk]' included-values='all' />
          <filter class='categorical' column='[federated.0321c3312biaqd1e5uugv1q151se].[none:display_name:nk]'>
