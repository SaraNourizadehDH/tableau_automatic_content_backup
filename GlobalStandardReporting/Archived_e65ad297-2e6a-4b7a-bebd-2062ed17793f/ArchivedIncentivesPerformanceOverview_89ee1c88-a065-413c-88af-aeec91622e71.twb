              <groupfilter function='member' level='[none:incentive_type:nk]' member='&quot;free_gift&quot;' />
              <groupfilter function='member' level='[none:incentive_type:nk]' member='&quot;multi_level&quot;' />
              <groupfilter function='member' level='[none:incentive_type:nk]' member='&quot;No Incentive&quot;' />
              <groupfilter function='member' level='[none:incentive_type:nk]' member='&quot;percentage&quot;' />
              <groupfilter function='member' level='[none:incentive_type:nk]' member='&quot;Stacked&quot;' />
            </groupfilter>
          </filter>
