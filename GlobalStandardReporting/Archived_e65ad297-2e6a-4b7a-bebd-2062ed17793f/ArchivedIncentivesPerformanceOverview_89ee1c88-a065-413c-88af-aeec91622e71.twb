    <worksheet name='Data Readiness'>
      <layout-options>
        <title>
          <formatted-text>
            <run>&lt;Sheet Name&gt;&#10;</run>
            <run fontname='Tableau Light' fontsize='10'>30% of data readiness come from if any data for vouchers (10%), discounts (10%), item inc. (5%), delivery fee inc. (5%) are sent. When any of them is filtered out, a drop in the score is expected due to the exclusion of such incentives.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='IDAQ' name='federated.0321c3312biaqd1e5uugv1q151se' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Monthly' caption='Analysis Frequency 1' datatype='string' name='[Parameter 1 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
              <aliases>
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0321c3312biaqd1e5uugv1q151se'>
            <column caption='Readiness Score' datatype='real' name='[Calculation_940267221323051019]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_940267221323378701] * [Calculation_940267221323165708] * 0.7) + (&#10;    IIF(SUM(IIF([has_voucher],1,0)) &gt; 0, 0.1, 0) + &#10;    IIF(SUM(IIF([has_discount], 1,0)) &gt; 0, 0.1, 0) + &#10;    IIF(SUM(IIF([has_deliveryfee_inc], 1, 0)) &gt; 0, 0.05, 0) + &#10;    IIF(SUM(IIF([has_item_inc], 1, 0)) &gt; 0, 0.05, 0)&#10;)' />
            </column>
            <column caption='Data Validity' datatype='real' name='[Calculation_940267221323165708]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([is_incentive_cit] AND&#10;        [is_cit_monetary_data_available] AND&#10;        [is_ci_data_available] AND &#10;        [is_ci_monetary_data_available] AND&#10;        ([is_within_valid_period] OR ISNULL([is_within_valid_period])) AND&#10;        NOT [exceeds_max_discount] AND &#10;        NOT [exceeds_maxOV] AND &#10;        NOT ([is_stacked] AND NOT [is_stackable]) AND&#10;        NOT (NOT [is_marketing_channel_available] AND [is_marketing_spend]),&#10;        [order_count],&#10;        0)) &#10;/ &#10;SUM(IIF([is_incentive_cit], [order_count], 0))' />
            </column>
            <column caption='Value Accuracy (Amount/Percentage Incentives)' datatype='real' name='[Calculation_940267221323378701]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([incentive_type] IN (&apos;amount&apos;, &apos;percentage&apos;) AND [incentive_value_matches], [order_count], 0)) / &#10;SUM(IIF([incentive_type] IN (&apos;amount&apos;, &apos;percentage&apos;), [order_count], 0))' />
            </column>
            <column caption='Analysis Period' datatype='date' name='[Calculation_940267221327990798]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parameter 1 1], [created_date], &apos;monday&apos;))' />
            </column>
            <column caption='Created Date' datatype='date' name='[created_date]' role='dimension' type='ordinal' />
            <column caption='First Discount Data Received' datatype='date' name='[discounts_first_entry_date]' role='dimension' type='quantitative' />
            <column caption='Display Name' datatype='string' name='[display_name]' role='dimension' type='nominal' />
            <column caption='Exceeds Max OV' datatype='boolean' name='[exceeds_maxOV]' role='dimension' type='nominal' />
            <column caption='Exceeds Max Discount' datatype='boolean' name='[exceeds_max_discount]' role='dimension' type='nominal' />
            <column caption='Has Deliveryfee Inc' datatype='boolean' name='[has_deliveryfee_inc]' role='dimension' type='nominal' />
            <column caption='Has Discount' datatype='boolean' name='[has_discount]' role='dimension' type='nominal' />
            <column caption='Has Item Inc' datatype='boolean' name='[has_item_inc]' role='dimension' type='nominal' />
            <column caption='Has Voucher' datatype='boolean' name='[has_voucher]' role='dimension' type='nominal' />
            <column caption='Incentive Category (on Order Level)' datatype='string' name='[incentive_category]' role='dimension' type='nominal' />
            <column caption='Incentive Type (on Order Level)' datatype='string' name='[incentive_type]' role='dimension' type='nominal' />
            <column caption='Incentive Value Matches' datatype='boolean' name='[incentive_value_matches]' role='dimension' type='nominal' />
            <column caption='First Incentive Data Received' datatype='date' name='[incentives_first_entry_date]' role='dimension' type='quantitative' />
            <column caption='CI Data Availability' datatype='boolean' name='[is_ci_data_available]' role='dimension' type='nominal' />
            <column caption='Is Ci Monetary Data Available' datatype='boolean' name='[is_ci_monetary_data_available]' role='dimension' type='nominal' />
            <column caption='Is Cit Monetary Data Available' datatype='boolean' name='[is_cit_monetary_data_available]' role='dimension' type='nominal' />
            <column caption='CIT Data Availability' datatype='boolean' name='[is_incentive_cit]' role='dimension' type='nominal' />
            <column caption='Is Marketing Channel Available' datatype='boolean' name='[is_marketing_channel_available]' role='dimension' type='nominal' />
            <column caption='Is Marketing Spend' datatype='boolean' name='[is_marketing_spend]' role='dimension' type='nominal' />
            <column caption='Is Stackable' datatype='boolean' name='[is_stackable]' role='dimension' type='nominal' />
            <column caption='Is Stacked' datatype='boolean' name='[is_stacked]' role='dimension' type='nominal' />
            <column caption='Within Valid Period' datatype='boolean' name='[is_within_valid_period]' role='dimension' type='nominal' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_940267221327990798]' derivation='None' name='[none:Calculation_940267221327990798:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_940267221327990798]' derivation='None' name='[none:Calculation_940267221327990798:qk]' pivot='key' type='quantitative' />
            <column-instance column='[discounts_first_entry_date]' derivation='None' name='[none:discounts_first_entry_date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[display_name]' derivation='None' name='[none:display_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[incentive_category]' derivation='None' name='[none:incentive_category:nk]' pivot='key' type='nominal' />
            <column-instance column='[incentives_first_entry_date]' derivation='None' name='[none:incentives_first_entry_date:ok]' pivot='key' type='ordinal' />
