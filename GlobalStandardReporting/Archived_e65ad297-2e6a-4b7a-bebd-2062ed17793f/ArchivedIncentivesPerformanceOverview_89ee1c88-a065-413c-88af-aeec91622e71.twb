        <calculation class='tableau' formula='CASE [Parameters].[Fraud Parameter I (copy)_1270929933586362378]&#10;WHEN &apos;1&apos; THEN [acquisitions]&#10;WHEN &apos;2&apos; THEN [trials]&#10;WHEN &apos;3&apos; THEN [orders]&#10;WHEN &apos;4&apos; THEN [customers]&#10;WHEN &apos;5&apos; THEN [dh_incentives_eur]&#10;WHEN &apos;6&apos; THEN [total_incentives_eur]&#10;WHEN &apos;7&apos; THEN [gbv_eur]&#10;WHEN &apos;8&apos; THEN [gmv_eur]&#10;END' />
