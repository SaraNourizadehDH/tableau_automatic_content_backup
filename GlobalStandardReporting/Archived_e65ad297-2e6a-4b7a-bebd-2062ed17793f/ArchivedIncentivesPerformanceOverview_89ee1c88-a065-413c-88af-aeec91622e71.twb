      <column caption='% Incentivised Orders' datatype='real' name='[Calculation_1105070807428739072]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([incentivised_order]) / SUM([orders])' />
      </column>
      <column caption='% Incentives over GMV' datatype='real' name='[Calculation_1105070807428837377]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_incentives_eur]) / SUM([gbv_eur])' />
      </column>
      <column caption='% Incentives over Revenue' datatype='real' name='[Calculation_1105070807428952066]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_incentives_eur]) / SUM([dh_revenue_eur])' />
