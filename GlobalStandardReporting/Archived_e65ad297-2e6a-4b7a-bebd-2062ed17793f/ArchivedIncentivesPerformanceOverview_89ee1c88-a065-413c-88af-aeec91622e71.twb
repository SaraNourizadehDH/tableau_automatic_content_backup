            <groupfilter function='level-members' level='[none:is_competitive_city:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.06b8ia20c36l9e11i63851fqsdgf].[:Measure Names]</column>
            <column>[federated.06b8ia20c36l9e11i63851fqsdgf].[none:is_competitive_city:nk]</column>
            <column>[federated.06b8ia20c36l9e11i63851fqsdgf].[none:incentive_source_of_funding:nk]</column>
