          <filter class='categorical' column='[federated.0321c3312biaqd1e5uugv1q151se].[none:incentive_category:nk]'>
            <groupfilter function='except' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[none:incentive_category:nk]' />
              <groupfilter function='empty-level' member='[none:incentive_category:nk]' />
            </groupfilter>
          </filter>
          <filter class='categorical' column='[federated.0321c3312biaqd1e5uugv1q151se].[none:management_entity:nk]'>
            <groupfilter function='except' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[none:management_entity:nk]' />
