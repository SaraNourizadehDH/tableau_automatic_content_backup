      <aliases enabled='yes' />
      <column caption='% of Orders/Acquisitions w/ Incentive Stacking' datatype='real' default-format='p0.00%' name='[% Incentivised orders (copy)_4062176526573998092]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Orders with incentives (copy)_4062176526573752331]) / sum([Calculation_805299958268043265])' />
      </column>
      <column caption='% of Spend on Non-Competitive Cities (DH Only)' datatype='real' name='[% Spend without MDV (CARC) (copy)_4102427468855644162]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([is_competitive_city] == FALSE OR ISNULL([is_competitive_city]), [dh_contribution_eur], 0)) /&#10;SUM([dh_contribution_eur])' />
      </column>
      <column caption='% of Spend on Non-Competitive Cities' datatype='real' name='[% Spend without MDV (copy)_4102427468855644163]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([is_competitive_city] == FALSE OR ISNULL([is_competitive_city]), [total_incentives_eur], 0)) /&#10;SUM([total_incentives_eur])' />
      </column>
      <column caption='% Spend without MDV (DH Only)' datatype='real' name='[% Spend without MOV (CARC) (copy)_4102427468854755328]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([has_mdv] == FALSE OR ISNULL([has_mdv]), [dh_contribution_eur], 0)) /&#10;SUM([dh_contribution_eur])' />
      </column>
      <column caption='% Spend without MDV' datatype='real' name='[% Spend without MOV (copy)_4102427468854755329]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([has_mdv] == FALSE OR ISNULL([has_mdv]), [total_incentives_eur], 0)) /&#10;SUM([total_incentives_eur])' />
      </column>
      <column caption='% Spend without MOV (DH Only)' datatype='real' name='[% Spend without MOV (copy)_6374000898237288449]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([has_mov] == FALSE OR ISNULL([has_mov]), [dh_contribution_eur], 0)) /&#10;SUM([dh_contribution_eur])' />
      </column>
      <column caption='NCC Share of DH Spend' datatype='real' default-format='p0.0%' name='[% voucher spend Non-competitive city 1  (copy)_2485353709023047692]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({ FIXED [Calculation_6152761569167699973] : SUM(IIF(NOT [is_competitive_city], [dh_contribution_eur], 0))}) / &#10;SUM({FIXED [Calculation_6152761569167699973]: SUM([dh_contribution_eur])})' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.06b8ia20c36l9e11i63851fqsdgf].[sum:Calculation_3663256143813529603:qk]&quot;' value='Acquisitions' />
        </aliases>
      </column>
      <column caption='QC Trials' datatype='real' name='[Acquisitions (copy)_1768507325393768448]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([is_qc_trial], [orders], 0)' />
      </column>
      <column caption='User Entitlement Filter' datatype='boolean' name='[Calculation_1099300584143556610]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='USERNAME()=[username]' />
      </column>
      <column caption='% DH Funded' datatype='real' name='[Calculation_1219138539529060354]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dh_contribution_eur]) / SUM([total_incentives_eur])' />
      </column>
      <column caption='Share of Retention Spend' datatype='real' name='[Calculation_148337363687813121]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({ FIXED [Calculation_6152761569167699973]: SUM(IIF([is_acquisition], 0, [dh_contribution_eur]))}) / SUM({ FIXED [Calculation_6152761569167699973]: SUM([dh_contribution_eur])})' />
      </column>
      <column caption='Competitiveness Flag' datatype='string' name='[Calculation_1495476600877752320]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [is_competitive_city]&#13;&#10;WHEN TRUE THEN &apos;Competitive&apos;&#13;&#10;WHEN FALSE THEN &apos;Non-Competitive&apos;&#13;&#10;END' />
      </column>
      <column caption='Incentive Channel' datatype='string' name='[Calculation_1612570191526498305]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF     UPPER([channel_subchannel]) = &apos;WOM_RAF&apos; THEN &apos;Refer a friend&apos;&#13;&#10;ELSEIF UPPER([channel_subchannel]) = &apos;CRM_RMA&apos; THEN &apos;CRM RMA - Vouchers&apos;&#13;&#10;ELSEIF UPPER([channel_subchannel]) = &apos;CRM_RMO&apos; THEN &apos;CRM RMO - Vouchers&apos;&#13;&#10;ELSEIF UPPER([channel_subchannel]) = &apos;OTHER_SUBSIDIES&apos; AND     [is_acquisition] THEN &apos;DH funded Discounts - Acquisition&apos;&#13;&#10;ELSEIF UPPER([channel_subchannel]) = &apos;OTHER_SUBSIDIES&apos; AND NOT [is_acquisition] THEN &apos;DH funded Discounts - Retention&apos;&#13;&#10;ELSEIF UPPER([channel_subchannel]) IN (&apos;OTHER_CUSTOMERCOMPENSATION&apos;, &apos;OTHER_AUTOCOMP&apos;) THEN &apos;Customer compensation - Vouchers / Wallet&apos;&#13;&#10;ELSEIF UPPER([channel_subchannel]) = &apos;OTHER_DELIVERY FEE&apos; THEN &apos;Delivery Fee Incentives&apos;&#13;&#10;ELSEIF UPPER([channel_subchannel]) = &apos;WALLET_INCENTIVES&apos; THEN &apos;Wallet Incentives&apos;&#13;&#10;ELSEIF NOT ISNULL([channel_subchannel]) AND     [is_acquisition] THEN &apos;Vouchers Generic - Acquisition&apos;&#13;&#10;ELSEIF NOT ISNULL([channel_subchannel]) AND NOT [is_acquisition] THEN &apos;Vouchers Generic - Retention&apos;&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='Which Orders?' datatype='string' name='[Calculation_1787929114010013696]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([is_acquisition], &apos;Acquisitions Only&apos;, &apos;Reorders Only&apos;)' />
      </column>
      <column caption='Notes.CP' datatype='string' name='[Calculation_2773865573765836800]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Please Hover Here for More Info&quot;' />
        <aliases>
          <alias key='&quot;&quot;' value='PLEASE HOVER HERE TO GET MORE INFORMATION' />
          <alias key='&quot;&#10;&quot;' value='Please Click Here for More Info' />
        </aliases>
      </column>
      <column caption='Notes.QoA/QCT' datatype='string' name='[Calculation_2773865573769142273]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Please Hover Here for More Info&quot;' />
      </column>
      <column caption='Share of DH Spend on Orders w/ Incentive Stacking' datatype='real' default-format='p0.0%' name='[Calculation_4062176526552903688]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([DH funded  voucher with incentive stacking (copy)_4062176526548496385]) + sum([DH funded voucher with incentive no stacking (copy)_4062176526550433797]))&#10;/ (sum([dh_contribution_eur]))' />
      </column>
      <column caption='Report Date' datatype='date' name='[Calculation_6152761569167699973]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parameter 6],[created_date], &apos;monday&apos;))' />
      </column>
      <column caption='inCPGMV' datatype='real' name='[Calculation_6204201113617321984]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Source of Cost (copy)_1219138539526680576]&#10;WHEN &apos;1&apos; THEN SUM([dh_contribution_eur]) &#10;WHEN &apos;2&apos; THEN SUM([vendor_contribution_eur] + [thirdparty_contribution_eur])  &#10;WHEN &apos;3&apos; THEN SUM([total_incentives_eur]) &#10;END&#10;/ SUM([gmv_eur])' />
      </column>
      <column caption='inCPO' datatype='real' name='[Calculation_6204201113617412097]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Source of Cost (copy)_1219138539526680576]&#10;WHEN &apos;1&apos; THEN SUM([dh_contribution_eur]) &#10;WHEN &apos;2&apos; THEN SUM([vendor_contribution_eur] + [thirdparty_contribution_eur])  &#10;WHEN &apos;3&apos; THEN SUM([total_incentives_eur]) &#10;END&#10;/ SUM([orders])' />
      </column>
      <column caption='Incentive Spend' datatype='real' name='[Calculation_6204201113622073347]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Source of Cost (copy)_1219138539526680576]&#10;WHEN &apos;1&apos; THEN SUM([dh_contribution_eur]) &#10;WHEN &apos;2&apos; THEN SUM([vendor_contribution_eur] + [thirdparty_contribution_eur])  &#10;WHEN &apos;3&apos; THEN SUM([total_incentives_eur]) &#10;END' />
      </column>
      <column caption='% Spend without MOV' datatype='real' name='[Calculation_6374000898237091840]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([has_mov] == FALSE OR ISNULL([has_mov]), [total_incentives_eur], 0)) /&#10;SUM([total_incentives_eur])' />
      </column>
      <column caption='Orders/Acquisitions' datatype='real' name='[Calculation_805299958268043265]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5 2]&#13;&#10;WHEN 1 THEN [orders]&#13;&#10;WHEN 2 THEN IIF([is_acquisition], [orders], 0)&#13;&#10;END' />
      </column>
      <column caption='CPO' datatype='real' name='[DH Cost per GMV (copy)_1249326728521277445]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dh_contribution_eur]) / SUM([orders])' />
      </column>
      <column caption='DH Vouchers (€) w/out Incentive Stacking' datatype='real' name='[DH funded  voucher (copy)_4062176526547972096]' role='measure' type='quantitative'>
