              <groupfilter function='level-members' level='[none:segment:nk]' />
              <groupfilter function='member' level='[none:segment:nk]' member='%null%' />
            </groupfilter>
          </filter>
          <slices>
            <column>[federated.0321c3312biaqd1e5uugv1q151se].[none:segment:nk]</column>
