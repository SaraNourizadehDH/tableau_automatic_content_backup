    <worksheet name='SWITCH: All to Inactive'>
      <table>
        <view>
          <datasources>
            <datasource caption='bima_tableau_mkt_active_customer_report+ (rl_mkt)' name='federated.0vv50l01f2ptjn18mniuy0y8b090' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Number' caption='Number or %' datatype='integer' name='[Parameter 7]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='Number' />
                <alias key='2' value='Percent' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0vv50l01f2ptjn18mniuy0y8b090'>
            <column caption='Seg LEFT: Inactive 2+ years' datatype='integer' name='[Calculation_1645502775337164800]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='If [months_inactive] &gt;= 24&#10;then &#10;[Inactive Customer mom (copy)]&#10;end' />
            </column>
            <column caption='Seg: 2+ years Inactive to Inactive' datatype='integer' name='[Calculation_1645502775347011587]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [months_inactive] &gt;= 24&#10;then &#10;ifnull([Inactive Customer mom (copy)],0) - ifnull([reactivated_customers],0) &#10;else 0 &#10;end' />
            </column>
            <column caption='% Seg: 2+ years Inactive to Inactive' datatype='real' name='[Calculation_1645502775347421188]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_1645502775347011587])&#10;/&#10;sum({exclude [smaller group (to inactive) (copy 2)]: sum([Calculation_1645502775337164800])})' />
            </column>
            <column caption='Switch: Loyal Churning to Inactive' datatype='real' name='[Calculation_1784129168880496660]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 7] = 1 then (if sum(ifnull( [Seg: Loyal Churning to Churning (copy)],0)) &gt; 0 then sum( ifnull([Seg: Loyal Churning to Churning (copy)],0)) else null end )&#10;elseif [Parameters].[Parameter 7] = 2 then (if round([Seg: Loyal Churning to Inactive (copy)]*100,2) &gt; 0 then round([Seg: Loyal Churning to Inactive (copy)]*100,2) else null end )&#10;end' />
            </column>
