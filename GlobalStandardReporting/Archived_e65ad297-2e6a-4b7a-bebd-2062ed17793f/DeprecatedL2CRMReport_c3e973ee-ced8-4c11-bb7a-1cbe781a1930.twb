            </column>
            <column caption='Latest Month' datatype='date' name='[Calculation_572168273164574722]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{MAX(DATE([month_date]))}' />
            </column>
            <column caption='Placeholder' datatype='integer' name='[Calculation_856528417932349440]' role='measure' type='quantitative'>
