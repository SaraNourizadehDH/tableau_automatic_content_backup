              <formatted-text>
                <run bold='true' fontcolor='#499894' fontsize='9'>Definitions:</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontsize='9'>Customer Count:</run>
                <run bold='true' fontcolor='#499894' fontsize='9'>Æ </run>
                <run fontcolor='#000000' fontsize='9'>Count unique of customers who placed at least 1 order.</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontsize='9'>Customer Placed Subsequent Order:</run>
                <run fontcolor='#000000' fontsize='9'> Count unique of customers placing a 2nd order.</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontsize='9'>Avg. Days Between Order And Subsequent Order:</run>
                <run fontcolor='#000000' fontsize='9'> For all customers that placed a 2nd order, average number of days between 1st and 2nd order.</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontsize='9'>Subsequent Order Rate:</run>
                <run fontcolor='#000000' fontsize='9'> (Customer Placed Subsequent Order/Total Acquisitions) *100</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#499894' fontsize='9'>Note:</run>
                <run fontcolor='#000000' fontsize='9'> Customers count include welcome, active retained, returning and reactivated customers.</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#499894' fontsize='9'>Note2: </run>
                <run fontcolor='#000000' fontsize='9'>The dashboard shows default </run>
                <run bold='true' fontcolor='#000000' fontsize='9'>Welcome</run>
                <run fontcolor='#000000' fontsize='9'> as Customer Segment and the </run>
                <run bold='true' fontcolor='#000000' fontsize='9'>last 12 months</run>
                <run fontcolor='#000000' fontsize='9'>.</run>
              </formatted-text>
            </customized-tooltip>
            <style>
              <style-rule element='mark'>
                <format attr='size' value='8.308629035949707' />
              </style-rule>
