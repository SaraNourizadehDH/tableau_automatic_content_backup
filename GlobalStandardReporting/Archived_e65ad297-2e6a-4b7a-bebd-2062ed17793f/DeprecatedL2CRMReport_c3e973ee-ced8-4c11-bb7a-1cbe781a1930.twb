    <worksheet name='All to Inactive TOTAL'>
      <table>
        <view>
          <datasources>
            <datasource caption='bima_tableau_mkt_active_customer_report+ (rl_mkt)' name='federated.0vv50l01f2ptjn18mniuy0y8b090' />
          </datasources>
          <datasource-dependencies datasource='federated.0vv50l01f2ptjn18mniuy0y8b090'>
            <column caption='Seg: 2+ years Inactive to Inactive' datatype='integer' name='[Calculation_1645502775347011587]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [months_inactive] &gt;= 24&#10;then &#10;ifnull([Inactive Customer mom (copy)],0) - ifnull([reactivated_customers],0) &#10;else 0 &#10;end' />
            </column>
            <column caption='smaller group' datatype='string' name='[Calculation_2564448168798150661]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [is_loyal] = true then &apos;true&apos;&#10;else [Lt Orders (group) (copy) (copy) (copy)]&#10;end' />
              <aliases>
                <alias key='&quot;1 LT Orders&quot;' value='1 LT Orders (Not Loyal)' />
                <alias key='&quot;2-4 LT Orders&quot;' value='2-4 LT Orders (Not Loyal)' />
                <alias key='&quot;5+ LT Orders&quot;' value='5+ LT Orders (Not Loyal)' />
                <alias key='&quot;true&quot;' value='Loyal' />
              </aliases>
            </column>
            <column caption='Seg Inactive TOTAL' datatype='integer' name='[Calculation_262827288104779781]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([Seg: Loyal Churning to Churning (copy)],0))&#10;+SUM(IFNULL([Seg: 2+ Churning (non-loyal) to Churning (copy)],0))&#10;+SUM(IFNULL([Seg: 1 Churning (non-loyal) to Churning (copy)],0))&#10;+SUM(IFNULL([Calculation_86835093581987841],0))&#10;+SUM(IFNULL([Seg: 2+ Inactive to Active (copy)],0))&#10;+SUM(IFNULL([Seg: 1 Inactive to Active (copy)],0)) &#10;+SUM(IFNULL([Calculation_1645502775347011587], 0))' />
            </column>
            <column caption='Boolean: Current Month' datatype='boolean' name='[Calculation_3339841340074151938]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, TODAY()) = [month_date]' />
            </column>
            <column caption='NULL ' datatype='integer' name='[Calculation_4582694122330669089]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='LOOKUP(sum([acquisitions]), -5)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Seg: Loyal Inactive to Inactive CORRECT' datatype='integer' name='[Calculation_86835093581987841]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// we need to be careful about the edge case inactives_mom with months_inactive = 23!!&#10;&#10;if [is_loyal_at_last_months_last_order_month] and [months_inactive] &lt; 23 &#10;then &#10;[Inactive Customer mom (copy)] - [reactivated_customers]&#10;else 0&#10;end&#10;&#10;+&#10;&#10;if [is_loyal_at_last_months_last_order_month] and [months_inactive] = 24 &#10;then &#10;[Inactive Customer (copy)]&#10;else 0 &#10;end' />
            </column>
            <column caption='Seg Inactive TOTAL 2+ years' datatype='integer' name='[Calculation_86835093942571018]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL(if [months_inactive] &gt;= 24 then [Calculation_86835093581987841] end,0))&#10;+SUM(IFNULL(if [months_inactive] &gt;= 24 then [Seg: 2+ Inactive to Active (copy)] end,0))&#10;+SUM(IFNULL(if [months_inactive] &gt;= 24 then [Seg: 1 Inactive to Active (copy)] end,0)) &#10;+SUM(IFNULL([Calculation_1645502775347011587], 0))' />
            </column>
            <column caption='Inactive Customer (NO Churn)' datatype='integer' name='[Inactive Customer (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([new_inactive_customers], 0) + &#10;IFNULL([old_inactive_customers_6m], 0) + &#10;IFNULL([old_inactive_customers], 0)' />
            </column>
            <column caption='Inactive Customer (NO Churn) mom' datatype='integer' name='[Inactive Customer mom (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([new_inactive_customers_mom], 0) + &#10;IFNULL([old_inactive_customers_6m_mom], 0) + &#10;IFNULL([old_inactive_customers_mom], 0)' />
            </column>
            <column caption='Lt Orders smaller' datatype='string' name='[Lt Orders (group) (copy) (copy) (copy)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[lt_orders]' new-bin='true'>
                <bin default-name='false' value='&quot;1 LT Orders&quot;'>
                  <value>&quot;1lt&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;2+ LT Orders&quot;'>
                  <value>&quot;2-4lt&quot;</value>
                  <value>&quot;5+lt&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='Month Date (for segment migrations)' datatype='datetime' default-format='*YYYY-MM' name='[Month Date (copy 2)]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[month_date]' />
            </column>
            <column datatype='datetime' default-format='*YYYY-MM' name='[Month Date (copy)]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[month_date]' />
            </column>
            <column datatype='integer' name='[NULL  (copy) (copy)]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='LOOKUP(sum([acquisitions]), -5)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='integer' name='[NULL  (copy)]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='LOOKUP(sum([acquisitions]), -5)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Seg: 1 Churning (non-loyal) to Inactive' datatype='integer' name='[Seg: 1 Churning (non-loyal) to Churning (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if ([lt_orders_last_month] = &apos;1lt&apos;)&#10;and [is_loyal_at_last_months_last_order_month] = false&#10;then [new_inactive_customers]&#10;else null &#10;end' />
            </column>
            <column caption='Seg: 1 Inactive to Inactive' datatype='integer' name='[Seg: 1 Inactive to Active (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if ([lt_orders] = &apos;1lt&apos;)&#10;and [is_loyal_at_last_months_last_order_month] = false &#10;and [months_inactive] &lt; 23 &#10;then [Inactive Customer mom (copy)] - [reactivated_customers]&#10;else 0 &#10;end&#10;+ &#10;if ([lt_orders] = &apos;1lt&apos;)&#10;and [is_loyal_at_last_months_last_order_month] = false &#10;and [months_inactive] = 24 &#10;then [Inactive Customer (copy)] &#10;else 0 &#10;end' />
            </column>
            <column caption='Seg: 2+ Churning (non-loyal) to Inactive' datatype='integer' name='[Seg: 2+ Churning (non-loyal) to Churning (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if ([lt_orders_last_month] = &apos;2-4lt&apos; or [lt_orders_last_month] = &apos;5+lt&apos;)&#10;and [is_loyal_at_last_months_last_order_month] = false &#10;then [new_inactive_customers]&#10;else null &#10;end' />
            </column>
            <column caption='Seg: 2+ Inactive to Inactive' datatype='integer' name='[Seg: 2+ Inactive to Active (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if ([lt_orders] = &apos;2-4lt&apos; or [lt_orders] = &apos;5+lt&apos;)&#10;and [is_loyal_at_last_months_last_order_month] = false &#10;and [months_inactive] &lt; 23 &#10;then&#10;[Inactive Customer mom (copy)] - [reactivated_customers]&#10;else 0 &#10;end &#10;+ &#10;if ([lt_orders] = &apos;2-4lt&apos; or [lt_orders] = &apos;5+lt&apos;)&#10;and [is_loyal_at_last_months_last_order_month] = false &#10;and [months_inactive] = 24 &#10;then&#10;[Inactive Customer (copy)]&#10;else 0 &#10;end' />
            </column>
            <column caption='Seg: Loyal Churning to Inactive' datatype='integer' name='[Seg: Loyal Churning to Churning (copy)]' role='measure' type='quantitative'>
