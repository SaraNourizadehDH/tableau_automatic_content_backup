    <worksheet name='Table 2'>
      <layout-options>
        <title>
          <formatted-text>
            <run>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='bima_tableau_mkt_active_customer_report+ (rl_mkt)' name='federated.0vv50l01f2ptjn18mniuy0y8b090' />
          </datasources>
          <datasource-dependencies datasource='federated.0vv50l01f2ptjn18mniuy0y8b090'>
            <column caption='Active Customers WITHOUT Acquisitions mom [not aggregated]' datatype='integer' name='[Active Customers WITHOUT Acquisitions mom (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4582694120617635843] - [acquisitions_mom]' />
            </column>
            <column caption='Channel (old)' datatype='string' name='[Calculation_1187402204411432961]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;Placeholder&apos;' />
            </column>
            <column caption='Channel' datatype='string' name='[Calculation_1988128189455618048]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='UPPER([Calculation_1187402204411432961])' />
            </column>
            <column caption='% Almost Churned from Ch. Loy.' datatype='real' default-format='p0.0%' name='[Calculation_2477261277057200131]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Loyal Active from Churning (copy)] / sum([Calculation_4582694122367475748])' />
            </column>
            <column caption='% Almost Churned from Ch. NL' datatype='real' default-format='p0.0%' name='[Calculation_2477261277058383876]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Loyal Active from Loyal Churning  (copy)] / (sum([Seg LEFT: Churning Loyal (copy)]) + sum([Seg LEFT: 2+ Churning non-loyal  (copy)]))' />
            </column>
            <column caption='% Retained Loyal' datatype='real' default-format='p0.0%' name='[Calculation_2477261277059153925]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6942861809498628114] / sum([Calculation_4582694122366173218])' />
            </column>
            <column caption='% Active Loyal from Active NL' datatype='real' default-format='p0.0%' name='[Calculation_2477261277059530758]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6942861809498279953] / sum([Calculation_4582694122366566435])' />
            </column>
            <column caption='Boolean: Current Month' datatype='boolean' name='[Calculation_3339841340074151938]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, TODAY()) = [month_date]' />
            </column>
            <column caption='Active Customer' datatype='integer' name='[Calculation_3515059544965722113]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([retained_customers], 0) + &#10;IFNULL([acquisitions], 0) + &#10;IFNULL([reactivated_customers], 0) +&#10;IFNULL([almost_churned_customers], 0)' />
            </column>
            <column caption='Active Customer mom' datatype='integer' name='[Calculation_4582694120617635843]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([retained_customers_mom], 0) + &#10;IFNULL([acquisitions_mom], 0) + &#10;IFNULL([reactivated_customers_mom], 0) +&#10;IFNULL([almost_churned_customers_mom], 0)' />
            </column>
            <column caption='Seg LEFT: Loyal Active Customer NO ACQ' datatype='integer' name='[Calculation_4582694122366173218]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='If [is_loyal] = true &#10;then [Active Customers WITHOUT Acquisitions mom (copy)]&#10;end' />
            </column>
            <column caption='Seg LEFT: Active Customer non-loyal' datatype='integer' name='[Calculation_4582694122366566435]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [is_loyal] = false &#10;then &#10;[Active Customers WITHOUT Acquisitions mom (copy)]&#10;end' />
            </column>
            <column caption='Seg LEFT: Churning Loyal' datatype='integer' name='[Calculation_4582694122367475748]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [is_loyal_at_last_months_last_order_month] = true &#10;then &#10;[churning_mom]&#10;end' />
            </column>
            <column caption='Loyalty Base (ACT + CHU)' datatype='integer' name='[Calculation_6687352907468722180]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([Calculation_3515059544965722113],0) &#10;+ IFNULL([churning],0)  &#10;- IFNULL([acquisitions],0) &#10;- IFNULL([acquisitions_mom],0)' />
            </column>
            <column caption='Loyal*  OVER Loyalty Base' datatype='real' default-format='p0.0%' name='[Calculation_6687352907469697029]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_6942861807022764033]) &#10;/ &#10;sum([Calculation_6687352907468722180])' />
            </column>
            <column caption='Loyal Active Customer' datatype='integer' name='[Calculation_6942861807022764033]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [is_loyal] = true &#10;then [Calculation_3515059544965722113]&#10;end' />
            </column>
            <column caption='Loyal Active from NL Active' datatype='integer' name='[Calculation_6942861809498279953]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [is_loyal_1m_ago] = false and [is_loyal] = true &#10;then &#10;[retained_customers]&#10;end )' />
            </column>
            <column caption='Loyal Active from Loyal Active' datatype='integer' name='[Calculation_6942861809498628114]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(&#10;if [is_loyal_1m_ago] = true and [is_loyal] = true &#10;then &#10;[retained_customers]&#10;end &#10;)' />
            </column>
            <column caption='Loyal Active from Loyal Churning ' datatype='integer' name='[Loyal Active from Churning (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(&#10;if [is_loyal] = true and [is_loyal_at_last_months_last_order_month] = true &#10;then &#10;[almost_churned_customers]&#10;end &#10;)' />
            </column>
            <column caption='Loyal Active from NL Churning' datatype='integer' name='[Loyal Active from Loyal Churning  (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(&#10;if [is_loyal] = true and [is_loyal_at_last_months_last_order_month] = false &#10;then &#10;[almost_churned_customers]&#10;end &#10;)' />
            </column>
            <column caption='Seg LEFT: 1 Churning non-loyal' datatype='integer' name='[Seg LEFT: 2+ Churning non-loyal  (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [is_loyal_at_last_months_last_order_month] = false &#10;and [lt_orders] = &apos;1lt&apos;&#10;then &#10;[churning_mom]&#10;end' />
            </column>
            <column caption='Seg LEFT: 2+ Churning non-loyal ' datatype='integer' name='[Seg LEFT: Churning Loyal (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [is_loyal_at_last_months_last_order_month] = false &#10;and ([lt_orders] = &apos;2-4lt&apos; or [lt_orders] = &apos;5+lt&apos;)&#10;then &#10;[churning_mom]&#10;end' />
            </column>
            <column caption='Acquisitions' datatype='integer' name='[acquisitions]' role='measure' type='quantitative' />
            <column caption='Acquisitions Mom' datatype='integer' name='[acquisitions_mom]' role='measure' type='quantitative' />
            <column caption='Almost Churned' datatype='integer' name='[almost_churned_customers]' role='measure' type='quantitative' />
            <column caption='Almost Churned Customers Mom' datatype='integer' name='[almost_churned_customers_mom]' role='measure' type='quantitative' />
            <column caption='Churning Customers' datatype='integer' name='[churning]' role='measure' type='quantitative' />
            <column caption='Churning Mom' datatype='integer' name='[churning_mom]' role='measure' type='quantitative' />
            <column caption='City' datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Is Crm Voucher' datatype='string' name='[is_crm_voucher]' role='dimension' type='nominal' />
            <column caption='Is Loyal' datatype='boolean' name='[is_loyal]' role='dimension' type='nominal' />
            <column caption='Is Loyal 1M Ago' datatype='boolean' name='[is_loyal_1m_ago]' role='dimension' type='nominal' />
            <column caption='Is Loyal At Last Months Last Order Month' datatype='boolean' name='[is_loyal_at_last_months_last_order_month]' role='dimension' type='nominal' />
            <column caption='Lt Orders' datatype='string' name='[lt_orders]' role='dimension' type='nominal' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column caption='Month Date' datatype='datetime' datatype-customized='true' name='[month_date]' role='dimension' type='ordinal' />
