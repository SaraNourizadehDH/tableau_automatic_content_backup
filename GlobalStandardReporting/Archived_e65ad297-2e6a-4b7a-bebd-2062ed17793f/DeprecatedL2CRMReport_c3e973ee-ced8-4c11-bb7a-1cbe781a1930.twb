            <zone forceUpdate='true' h='3375' id='470' type-v2='text' w='98770' x='615' y='88875'>
              <formatted-text>
                <run bold='true' fontname='Tableau Bold' fontsize='8'>*</run>
                <run fontsize='8'> Customer Base is the number of customers who ever </run>
                <run bold='true' fontsize='8'>place an order</run>
                <run fontsize='8'>Æ </run>
                <run bold='true' fontsize='8' underline='true'>for the whole period</run>
                <run bold='true' fontsize='8'>.</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone forceUpdate='true' h='3375' id='485' type-v2='text' w='98770' x='615' y='92250'>
              <formatted-text>
                <run bold='true' fontsize='8'>**</run>
                <run fontsize='8'> Reachable users on Braze are based on the </run>
                <run bold='true' fontsize='8'>last 24 months</run>
                <run fontsize='8'>. That&apos;s why, </run>
                <run fontsize='8' underline='true'>there can be differences between Reachable users on Braze and Customer Base on Tableau.</run>
              </formatted-text>
