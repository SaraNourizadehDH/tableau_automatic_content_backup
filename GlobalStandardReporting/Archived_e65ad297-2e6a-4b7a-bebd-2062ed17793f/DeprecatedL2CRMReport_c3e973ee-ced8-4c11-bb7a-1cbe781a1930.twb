    <worksheet name='Inactive to Active Trend - EE Chart'>
      <table>
        <view>
          <datasources>
            <datasource caption='bima_tableau_mkt_active_customer_report+ (rl_mkt)' name='federated.0vv50l01f2ptjn18mniuy0y8b090' />
          </datasources>
          <datasource-dependencies datasource='federated.0vv50l01f2ptjn18mniuy0y8b090'>
            <column caption='Inactive Customer mom' datatype='integer' name='[Calculation_4582694120626712586]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([new_inactive_customers_mom], 0) + &#10;IFNULL([old_inactive_customers_6m_mom], 0) + &#10;IFNULL([old_inactive_customers_mom], 0) +&#10;IFNULL([churning_mom], 0)' />
            </column>
            <column caption='Move: Inactive to Active last month - Reactivated Share from Inactive prev. Month' datatype='real' default-format='p0.00%' name='[Reactivated Share from Inactive prev. Month (copy)_584060645120811010]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([reactivated_customers])&#10;/&#10;sum([test 3 (copy)])' />
            </column>
            <column caption='Churning Mom' datatype='integer' name='[churning_mom]' role='measure' type='quantitative' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='group PAST (colours: react)' datatype='string' name='[group PAST (copy)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [is_loyal_at_last_months_last_order_month] = true then &apos;true&apos;&#10;else [lt_orders]&#10;end' />
              <aliases>
                <alias key='&quot;1 LT Orders&quot;' value='1 LT Orders (Not Loyal)' />
                <alias key='&quot;1lt&quot;' value='1 NL' />
                <alias key='&quot;2-4 LT Orders&quot;' value='2-4 LT Orders (Not Loyal)' />
                <alias key='&quot;2-4lt&quot;' value='2-4 NL' />
                <alias key='&quot;5+ LT Orders&quot;' value='5+ LT Orders (Not Loyal)' />
                <alias key='&quot;5+lt&quot;' value='5+ NL' />
                <alias key='&quot;true&quot;' value='Loyal' />
              </aliases>
            </column>
            <column caption='Is Loyal At Last Months Last Order Month' datatype='boolean' name='[is_loyal_at_last_months_last_order_month]' role='dimension' type='nominal' />
            <column caption='Lt Orders' datatype='string' name='[lt_orders]' role='dimension' type='nominal' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column caption='Month Date' datatype='datetime' datatype-customized='true' name='[month_date]' role='dimension' type='ordinal' />
            <column caption='New Inactive Customers Mom' datatype='integer' name='[new_inactive_customers_mom]' role='measure' type='quantitative' />
            <column-instance column='[management_entity]' derivation='None' name='[none:management_entity:nk]' pivot='key' type='nominal' />
            <column-instance column='[month_date]' derivation='None' name='[none:month_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[sub_entity]' derivation='None' name='[none:sub_entity:nk]' pivot='key' type='nominal' />
            <column caption='Old Inactive Customers 6M Mom' datatype='integer' name='[old_inactive_customers_6m_mom]' role='measure' type='quantitative' />
            <column caption='Old Inactive Customers Mom' datatype='integer' name='[old_inactive_customers_mom]' role='measure' type='quantitative' />
            <column caption='Reactivated Customers' datatype='integer' name='[reactivated_customers]' role='measure' type='quantitative' />
            <column caption='Display Name' datatype='string' name='[sub_entity]' role='dimension' type='nominal' />
            <column caption='FIXED: Inactive Customer mom' datatype='integer' name='[test 3 (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ fixed &#10;[group PAST (copy)],&#10;[month_date],&#10;[global_entity_id]&#10;:&#10;SUM([Calculation_4582694120626712586])&#10;}' />
