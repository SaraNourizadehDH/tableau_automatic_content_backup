              <calculation class='tableau' formula='sum(if [is_loyal_1m_ago] = false &#10;then &#10;IFNULL([retained_from_retained],0) + &#10;IFNULL([retained_from_almost_churned],0) +  &#10;IFNULL([retained_from_reactivated],0) &#10;end &#10;)&#10;/ sum({exclude [smaller group (copy 2)]: sum([Calculation_4582694122366566435])})' />
            </column>
            <column caption='% Seg: Loyal Active (Non-Acq.) to Active' datatype='real' default-format='p0.0%' name='[Seg: Loyal Active (Non-Acq.) to Active (copy 2)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [is_loyal_1m_ago] = true &#10;then &#10;[retained_customers] - [retained_from_acquisition]&#10;end) / sum({exclude [smaller group (copy 2)]: sum([Calculation_4582694122366173218])})' />
