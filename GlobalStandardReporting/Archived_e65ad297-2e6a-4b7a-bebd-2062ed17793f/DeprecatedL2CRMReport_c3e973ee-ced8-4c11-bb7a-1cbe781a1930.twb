    <datasource caption='Time between 1st - 2nd order+ (rl_mkt) (active_customer / reactivated_customer)' inline='true' name='federated.1jkvqm01ailpvb1e5j70v1debtnh' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0dohpmv0x3muts0zjkirs0grg7yl'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dh-marketing-analytics' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='rl_mkt' server-oauth='' username='ebru.serter@deliveryhero.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation join='inner' type='join'>
          <clause type='join'>
            <expression op='='>
              <expression op='[Custom SQL Query].[global_entity_id]' />
              <expression op='[tableau_gsr_entitlements_marketing_global_entity_id].[global_entity_id]' />
            </expression>
          </clause>
          <relation connection='bigquery.0dohpmv0x3muts0zjkirs0grg7yl' name='Custom SQL Query' type='text'>SELECT 
    r.global_entity_id,
    c.management_entity,
    c.display_name,
    r.month_date,
    AVG(r.days_between_first_two_orders*1.0) AS avg_days_between_first_two_orders
FROM `fulfillment-dwh-production.rl_mkt.bima_reactivated_customer` r
JOIN (SELECT global_entity_id, sub_entity AS display_name, management_entity FROM `fulfillment-dwh-production.rl_mkt.bima_tableau_mkt_active_customer_report` GROUP BY 1, 2, 3) c
