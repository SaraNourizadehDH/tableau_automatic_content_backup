    <worksheet name='Churning Loyal Trend - ASIA Chart'>
      <table>
        <view>
          <datasources>
            <datasource caption='bima_tableau_mkt_active_customer_report+ (rl_mkt)' name='federated.0vv50l01f2ptjn18mniuy0y8b090' />
          </datasources>
          <datasource-dependencies datasource='federated.0vv50l01f2ptjn18mniuy0y8b090'>
            <column caption='% Churning Loyals - Last Month Active to Churning' datatype='real' default-format='p0.0%' name='[% Last Month Active to Churning (copy)_584060645116084224]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='( sum([churning_from_acquisition]) &#13;&#10;+ sum([churning_from_almost_churned]) &#13;&#10;+ sum([churning_from_reactivated])&#13;&#10;+ sum([churning_from_retained]) )&#13;&#10;/ &#13;&#10;//sum( {exclude [group PAST (colours: Newly Inact)]: sum([Active Customer mom]) })&#13;&#10;SUM({fixed [city], [country_name], [sub_entity], [management_entity], [month_date], [Calculation_1988128189455618048], [Is Voucher (copy)]: sum([Calculation_4582694120617635843])})' />
            </column>
            <column caption='Channel (old)' datatype='string' name='[Calculation_1187402204411432961]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;Placeholder&apos;' />
            </column>
            <column caption='Channel' datatype='string' name='[Calculation_1988128189455618048]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='UPPER([Calculation_1187402204411432961])' />
            </column>
            <column caption='Active Customer mom' datatype='integer' name='[Calculation_4582694120617635843]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([retained_customers_mom], 0) + &#10;IFNULL([acquisitions_mom], 0) + &#10;IFNULL([reactivated_customers_mom], 0) +&#10;IFNULL([almost_churned_customers_mom], 0)' />
            </column>
            <column datatype='string' name='[Is Voucher (copy)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[is_voucher]' />
            </column>
            <column caption='Acquisitions Mom' datatype='integer' name='[acquisitions_mom]' role='measure' type='quantitative' />
            <column caption='Almost Churned Customers Mom' datatype='integer' name='[almost_churned_customers_mom]' role='measure' type='quantitative' />
            <column caption='Churning From Acquisition' datatype='integer' name='[churning_from_acquisition]' role='measure' type='quantitative' />
            <column caption='Churning From Almost Churned' datatype='integer' name='[churning_from_almost_churned]' role='measure' type='quantitative' />
            <column caption='Churning From Reactivated' datatype='integer' name='[churning_from_reactivated]' role='measure' type='quantitative' />
            <column caption='Churning From Retained' datatype='integer' name='[churning_from_retained]' role='measure' type='quantitative' />
            <column caption='City' datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Is Loyal At Last Months Last Order Month' datatype='boolean' name='[is_loyal_at_last_months_last_order_month]' role='dimension' type='nominal' />
            <column caption='Is Voucher' datatype='string' name='[is_voucher]' role='dimension' type='nominal' />
            <column caption='Lt Orders' datatype='string' name='[lt_orders]' role='dimension' type='nominal' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column caption='Month Date' datatype='datetime' datatype-customized='true' name='[month_date]' role='dimension' type='ordinal' />
            <column-instance column='[management_entity]' derivation='None' name='[none:management_entity:nk]' pivot='key' type='nominal' />
            <column-instance column='[month_date]' derivation='None' name='[none:month_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[smaller group PAST (copy)]' derivation='None' name='[none:smaller group PAST (copy):nk]' pivot='key' type='nominal' />
            <column-instance column='[sub_entity]' derivation='None' name='[none:sub_entity:nk]' pivot='key' type='nominal' />
            <column caption='Reactivated Customers Mom' datatype='integer' name='[reactivated_customers_mom]' role='measure' type='quantitative' />
            <column caption='Retained Customers Mom' datatype='integer' name='[retained_customers_mom]' role='measure' type='quantitative' />
            <column caption='group PAST (colours: Newly Inact)' datatype='string' name='[smaller group PAST (copy)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [is_loyal_at_last_months_last_order_month] = true then &apos;true&apos;&#10;else [lt_orders]&#10;end' />
              <aliases>
                <alias key='&quot;0lt&quot;' value='0 NL' />
                <alias key='&quot;1 LT Orders&quot;' value='1 LT Orders (Not Loyal)' />
                <alias key='&quot;1lt&quot;' value='1 NL' />
