              <zone custom-title='true' h='4276' id='191' mode='compact' param='[Parameters].[Parameter 7]' type-v2='paramctrl' w='9579' x='90080' y='40336'>
                <formatted-text>
                  <run fontcolor='#4e79a7'>Number or %</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone h='18298' id='254' type-v2='empty' w='9579' x='90080' y='44612'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='11842' id='172' type-v2='text' w='9579' x='90080' y='62910'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000'>Definition:</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000'>A Customer A is called </run>
                  <run fontcolor='#000000' italic='true'>loyal</run>
                  <run fontcolor='#000000'> if A</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000'>1) ordered in 3 of the previous 6 months and </run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000'>2) ordered in the last month and</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000'>3) placed ≥ n  orders in the last 6 months, where n &gt; 0 is an integer that depends on the Brand / Country. </run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='24589' id='168' type-v2='text' w='9579' x='90080' y='74752'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000'>Note:</run>
                  <run fontcolor='#000000'> In the cases &apos;Churning&apos; and &apos;Inactive&apos;,  loyalty refers to the last order month.</run>
                  <run>&#10;&#10;&#10;&#10;&#10;Legend:&#10;</run>
                  <run bold='true' fontcolor='#000000'>NL </run>
                  <run fontcolor='#000000'>= Not Loyal</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000'>NL 2+ </run>
                  <run fontcolor='#000000'><![CDATA[= Not Loyal, ≥ 2 Lifetime Orders and last order was <2 years ago]]></run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000'>NL 1</run>
                  <run fontcolor='#000000'><![CDATA[ = Not Loyal, 1 Lifetime Order and last order was <2 years ago]]></run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000'>≥2 years </run>
                  <run fontcolor='#000000'>= last order was ≥2 years ago</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#545454' fontname='arial,sans-serif' fontsize='12'>Δ</run>
                  <run bold='true' fontcolor='#000000'>Æ </run>
                  <run fontcolor='#000000'>gives the delta for the respective groups on the left.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
