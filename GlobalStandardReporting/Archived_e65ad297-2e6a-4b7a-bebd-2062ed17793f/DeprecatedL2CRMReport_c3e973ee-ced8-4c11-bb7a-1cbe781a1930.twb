    <worksheet name='Almost Churned Customers '>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='bima_tableau_mkt_active_customer_report+ (rl_mkt)' name='federated.0vv50l01f2ptjn18mniuy0y8b090' />
          </datasources>
          <datasource-dependencies datasource='federated.0vv50l01f2ptjn18mniuy0y8b090'>
            <column caption='Channel (old)' datatype='string' name='[Calculation_1187402204411432961]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;Placeholder&apos;' />
            </column>
            <column caption='FIXED: Churning mom' datatype='integer' name='[Calculation_1784129169282469918]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ fixed &#10;[group PAST (copy)],&#10;[month_date],&#10;[global_entity_id],&#10;[Calculation_1988128189455618048]&#10;:&#10;sum([churning_mom])&#10;}' />
            </column>
            <column caption='Channel' datatype='string' name='[Calculation_1988128189455618048]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='UPPER([Calculation_1187402204411432961])' />
            </column>
            <column caption='Boolean: Current Month' datatype='boolean' name='[Calculation_3339841340074151938]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, TODAY()) = [month_date]' />
            </column>
            <column datatype='string' name='[Lt Orders (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[lt_orders]' new-bin='true'>
                <bin default-name='false' value='&quot;1 LT Orders&quot;'>
                  <value>&quot;1lt&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;2-4 LT Orders&quot;'>
                  <value>&quot;2-4lt&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;5+ LT Orders&quot;'>
                  <value>&quot;5+lt&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='Move: Churning to Almost Churned' datatype='real' default-format='p0.00%' name='[Move: Inactive to Reactivated  (copy) 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([almost_churned_customers]) &#10;/ &#10;sum([Calculation_1784129169282469918])' />
            </column>
            <column caption='Almost Churned' datatype='integer' name='[almost_churned_customers]' role='measure' type='quantitative' />
            <column caption='Churning Mom' datatype='integer' name='[churning_mom]' role='measure' type='quantitative' />
            <column caption='City' datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='group PAST (colours: react from chu)' datatype='string' name='[group PAST (colours: Newly Inact) (copy)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [is_loyal_at_last_months_last_order_month] = true then &apos;true&apos;&#10;else [lt_orders]&#10;end' />
              <aliases>
                <alias key='&quot;1 LT Orders&quot;' value='1 LT Orders (Not Loyal)' />
                <alias key='&quot;1lt&quot;' value='1 NL' />
                <alias key='&quot;2-4 LT Orders&quot;' value='2-4 LT Orders (Not Loyal)' />
                <alias key='&quot;2-4lt&quot;' value='2-4 NL' />
                <alias key='&quot;5+ LT Orders&quot;' value='5+ LT Orders (Not Loyal)' />
                <alias key='&quot;5+lt&quot;' value='5+ NL' />
                <alias key='&quot;true&quot;' value='Loyal' />
              </aliases>
