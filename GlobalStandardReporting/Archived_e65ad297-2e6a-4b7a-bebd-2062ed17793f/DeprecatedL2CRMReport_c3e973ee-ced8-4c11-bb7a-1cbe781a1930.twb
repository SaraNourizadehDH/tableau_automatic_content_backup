        <calculation class='tableau' formula='sum(if [is_loyal_1m_ago] = false &#10;then &#10;IFNULL([retained_from_retained],0) + &#10;IFNULL([retained_from_almost_churned],0) +  &#10;IFNULL([retained_from_reactivated],0) &#10;end &#10;)&#10;/ sum({exclude [smaller group (copy 2)]: sum([Calculation_4582694122366566435])})' />
