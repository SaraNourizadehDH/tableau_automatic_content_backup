    <worksheet name='Inactive'>
      <table>
        <view>
          <datasources>
            <datasource caption='bima_tableau_mkt_active_customer_report+ (rl_mkt)' name='federated.0vv50l01f2ptjn18mniuy0y8b090' />
          </datasources>
          <datasource-dependencies datasource='federated.0vv50l01f2ptjn18mniuy0y8b090'>
            <column caption='Boolean: Current Month' datatype='boolean' name='[Calculation_3339841340074151938]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, TODAY()) = [month_date]' />
            </column>
            <column caption='Inactive Customer yoy' datatype='integer' name='[Calculation_4582694120628035596]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([new_inactive_customers_yoy], 0) + &#10;IFNULL([old_inactive_customers_yoy], 0)' />
            </column>
            <column caption='Inactive Customer (NO Churn)' datatype='integer' name='[Inactive Customer (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([new_inactive_customers], 0) + &#10;IFNULL([old_inactive_customers_6m], 0) + &#10;IFNULL([old_inactive_customers], 0)' />
            </column>
            <column caption='Inactive Customer (NO Churn) mom' datatype='integer' name='[Inactive Customer mom (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([new_inactive_customers_mom], 0) + &#10;IFNULL([old_inactive_customers_6m_mom], 0) + &#10;IFNULL([old_inactive_customers_mom], 0)' />
            </column>
            <column caption='Lt Orders smaller' datatype='string' name='[Lt Orders (group) (copy) (copy) (copy)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[lt_orders]' new-bin='true'>
                <bin default-name='false' value='&quot;1 LT Orders&quot;'>
                  <value>&quot;1lt&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;2+ LT Orders&quot;'>
                  <value>&quot;2-4lt&quot;</value>
                  <value>&quot;5+lt&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='MoM Inactive Customer (No Churn)' datatype='real' default-format='p0.0%' name='[MoM Inactive Customer (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{include [smaller group (to inactive) (copy 2)]:sum([Inactive Customer (copy)])}&#10;/&#10; {include [smaller group (to inactive) (copy 2)]:sum([Inactive Customer mom (copy)])} - 1' />
            </column>
            <column caption='Month Date (for segment migrations)' datatype='datetime' default-format='*YYYY-MM' name='[Month Date (copy 2)]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[month_date]' />
            </column>
            <column datatype='datetime' default-format='*YYYY-MM' name='[Month Date (copy)]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[month_date]' />
            </column>
            <column caption='YoY Inactive Customer (No Churn)' datatype='real' default-format='p0.0%' name='[YoY Inactive Customer (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{include [smaller group (to inactive) (copy 2)]: sum([Inactive Customer (copy)])} &#10;/ &#10;{include [smaller group (to inactive) (copy 2)]: sum([Calculation_4582694120628035596])} - 1' />
            </column>
            <column caption='City' datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Is Loyal At Last Months Last Order Month' datatype='boolean' name='[is_loyal_at_last_months_last_order_month]' role='dimension' type='nominal' />
            <column caption='Lt Orders' datatype='string' name='[lt_orders]' role='dimension' type='nominal' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column caption='Month Date' datatype='datetime' datatype-customized='true' name='[month_date]' role='dimension' type='ordinal' />
            <column caption='Months Inactive' datatype='integer' name='[months_inactive]' role='measure' type='quantitative' />
            <column-instance column='[Month Date (copy 2)]' derivation='MY' name='[my:Month Date (copy 2):ok]' pivot='key' type='ordinal' />
            <column caption='New Inactive Customers' datatype='integer' name='[new_inactive_customers]' role='measure' type='quantitative' />
            <column caption='New Inactive Customers Mom' datatype='integer' name='[new_inactive_customers_mom]' role='measure' type='quantitative' />
            <column caption='New Inactive Customers [last year]' datatype='integer' name='[new_inactive_customers_yoy]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_3339841340074151938]' derivation='None' name='[none:Calculation_3339841340074151938:nk]' pivot='key' type='nominal' />
            <column-instance column='[city]' derivation='None' name='[none:city:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[management_entity]' derivation='None' name='[none:management_entity:nk]' pivot='key' type='nominal' />
            <column-instance column='[smaller group (to inactive) (copy 2)]' derivation='None' name='[none:smaller group (to inactive) (copy 2):nk]' pivot='key' type='nominal' />
            <column-instance column='[sub_entity]' derivation='None' name='[none:sub_entity:nk]' pivot='key' type='nominal' />
            <column caption='Old Inactive Customers' datatype='integer' name='[old_inactive_customers]' role='measure' type='quantitative' />
            <column caption='Old Inactive Customers 6M' datatype='integer' name='[old_inactive_customers_6m]' role='measure' type='quantitative' />
            <column caption='Old Inactive Customers 6M Mom' datatype='integer' name='[old_inactive_customers_6m_mom]' role='measure' type='quantitative' />
            <column caption='Old Inactive Customers Mom' datatype='integer' name='[old_inactive_customers_mom]' role='measure' type='quantitative' />
            <column caption='Old Inactive Customer [last year]' datatype='integer' name='[old_inactive_customers_yoy]' role='measure' type='quantitative' />
            <column caption='smaller group (to inactive) NEW' datatype='string' name='[smaller group (to inactive) (copy 2)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [months_inactive] &gt;= 24 then &apos;2+ years Inactive&apos;&#10;elseif [is_loyal_at_last_months_last_order_month] = true then &apos;true&apos;&#10;else [Lt Orders (group) (copy) (copy) (copy)]&#10;end' />
              <aliases>
                <alias key='&quot;1 LT Orders&quot;' value='1 LT Orders (Not Loyal)' />
                <alias key='&quot;2-4 LT Orders&quot;' value='2-4 LT Orders (Not Loyal)' />
                <alias key='&quot;5+ LT Orders&quot;' value='5+ LT Orders (Not Loyal)' />
                <alias key='&quot;true&quot;' value='Loyal' />
              </aliases>
            </column>
            <column caption='Display Name' datatype='string' name='[sub_entity]' role='dimension' type='nominal' />
            <column-instance column='[Inactive Customer (copy)]' derivation='Sum' name='[sum:Inactive Customer (copy):qk]' pivot='key' type='quantitative' />
            <column-instance column='[Inactive Customer mom (copy)]' derivation='Sum' name='[sum:Inactive Customer mom (copy):qk]' pivot='key' type='quantitative' />
            <column-instance column='[MoM Inactive Customer (copy)]' derivation='Sum' name='[sum:MoM Inactive Customer (copy):qk]' pivot='key' type='quantitative' />
            <column-instance column='[YoY Inactive Customer (copy)]' derivation='Sum' name='[sum:YoY Inactive Customer (copy):qk]' pivot='key' type='quantitative' />
            <column-instance column='[Month Date (copy)]' derivation='Month-Trunc' name='[tmn:Month Date (copy):ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0vv50l01f2ptjn18mniuy0y8b090].[:Measure Names]'>
            <groupfilter function='union' user:op='manual'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0vv50l01f2ptjn18mniuy0y8b090].[sum:Inactive Customer (copy):qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0vv50l01f2ptjn18mniuy0y8b090].[sum:MoM Inactive Customer (copy):qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0vv50l01f2ptjn18mniuy0y8b090].[sum:YoY Inactive Customer (copy):qk]&quot;' />
