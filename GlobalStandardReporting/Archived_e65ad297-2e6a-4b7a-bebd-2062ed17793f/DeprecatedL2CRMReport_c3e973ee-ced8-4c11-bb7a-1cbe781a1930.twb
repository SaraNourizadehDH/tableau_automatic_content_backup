      <layout-options>
        <title>
          <formatted-text>
            <run>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='bima_tableau_mkt_active_customer_report+ (rl_mkt)' name='federated.0vv50l01f2ptjn18mniuy0y8b090' />
          </datasources>
          <datasource-dependencies datasource='federated.0vv50l01f2ptjn18mniuy0y8b090'>
            <column caption='Acquisitions - Tooltip Format' datatype='integer' name='[Acquisitions (copy)_3010515628638056448]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[acquisitions]' />
            </column>
            <column caption='Almost Churned - Tooltip Format' datatype='integer' name='[Almost Churned (copy)_3010515628638298114]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[almost_churned_customers]' />
            </column>
            <column caption='Channel (old)' datatype='string' name='[Calculation_1187402204411432961]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;Placeholder&apos;' />
            </column>
            <column caption='Channel' datatype='string' name='[Calculation_1988128189455618048]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='UPPER([Calculation_1187402204411432961])' />
            </column>
            <column caption='Churning (-)' datatype='integer' name='[Calculation_2330683197569777665]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[churning] * -1' />
            </column>
            <column caption='New Inactive Customers (-)' datatype='integer' hidden='true' name='[Calculation_2330683197569896450]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[new_inactive_customers] * -1' />
            </column>
            <column caption='Boolean: Current Month' datatype='boolean' name='[Calculation_3339841340074151938]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, TODAY()) = [month_date]' />
            </column>
            <column caption='Active Base Growth' datatype='integer' name='[Calculation_5963539986990718976]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[acquisitions] +&#10;[almost_churned_customers] + [reactivated_customers] + [Newly Churning Customers (copy)_1272266948883972096]' />
            </column>
            <column caption='Newly Churning Customers (-) - Tooltip Format' datatype='integer' name='[Newly Churning Customers (-) (copy)_3010515628638412803]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([churning_from_acquisition] + [churning_from_retained] + [churning_from_almost_churned] + [churning_from_reactivated])*(-1)' />
            </column>
            <column caption='Newly Churning Customers (-)' datatype='integer' name='[Newly Churning Customers (copy)_1272266948883972096]' role='measure' type='quantitative'>
