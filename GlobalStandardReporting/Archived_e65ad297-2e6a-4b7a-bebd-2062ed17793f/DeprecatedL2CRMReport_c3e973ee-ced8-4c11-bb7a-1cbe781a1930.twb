              <calculation class='tableau' formula='{ fixed &#10;[group PAST (copy)],&#10;[month_date],&#10;[global_entity_id],&#10;[Calculation_1988128189455618048]&#10;:&#10;sum([churning_mom])&#10;}' />
            </column>
            <column caption='Channel' datatype='string' name='[Calculation_1988128189455618048]' role='dimension' type='nominal'>
