            <column caption='% Seg: 1 Churning (non-loyal) to Active' datatype='real' default-format='p0.0%' name='[Seg: 1 Churning (non-loyal) to Active (copy 2)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if ([lt_orders_last_month] = &apos;1lt&apos;)&#10;and [is_loyal_at_last_months_last_order_month] = false &#10;then [almost_churned_from_churning]&#10;else null &#10;end)&#10;/ &#10;sum({exclude [smaller group (copy 2)]: sum([Seg LEFT: 2+ Churning non-loyal  (copy)])})' />
            </column>
            <column caption='% Seg: 1 Inactive to Active' datatype='real' default-format='p0.0%' name='[Seg: 1 Inactive to Active (copy 2)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum( [Calculation_4582694122303918112] )&#10;/ &#10;sum({exclude [smaller group (copy 2)]: sum([Calculation_4582694122369179687])})' />
            </column>
            <column caption='% Seg: 2+ Churning (non-loyal) to Active' datatype='real' default-format='p0.0%' name='[Seg: 2+ Churning (non-loyal) to Active (copy 2)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if ([lt_orders_last_month] = &apos;2-4lt&apos; or [lt_orders_last_month] = &apos;5+lt&apos;)&#10;and [is_loyal_at_last_months_last_order_month] = false &#10;then [almost_churned_from_churning]&#10;else 0 &#10;end)&#10;/ &#10;sum({exclude [smaller group (copy 2)]: sum([Seg LEFT: Churning Loyal (copy)])})' />
