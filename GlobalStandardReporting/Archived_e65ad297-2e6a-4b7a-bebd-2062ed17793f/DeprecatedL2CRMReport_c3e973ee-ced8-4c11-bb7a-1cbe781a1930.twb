      <aliases enabled='yes' />
      <column caption='% Vertical Orders (of Overall Orders within Category)' datatype='real' default-format='p0.000%' name='[% Vertical Orders (of Overall Orders) (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vertical_orders]) / sum({exclude [Shop Type (copy)]: sum([overall_orders FIXED (copy)])})' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_1187402204410871808]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Customer Category' datatype='string' name='[Calculation_1626292086620360706]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [is_loyal] then &apos;Loyal&apos;&#10;elseif [is_active_frequent] then &apos;Active Frequent&apos;&#10;elseif [is_active_steady] then &apos;Active Steady&apos;&#10;else &apos;Rest&apos;&#10;end' />
      </column>
      <column aggregation='Attribute' caption='AVG Monthly Orders (Per User)' datatype='real' default-format='n#,##0.00;-#,##0.00' hidden='true' name='[Calculation_1626292086622253059]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ EXCLUDE  [monthly_orders]: SUM( INT([monthly_orders]) * [cnt_monthly_orders]) }&#10;/&#10;{EXCLUDE [monthly_orders]: SUM([cnt_monthly_orders])}' />
      </column>
      <column aggregation='Sum' caption='Filter Frequency Abs/Rel' datatype='integer' hidden='true' name='[Calculation_2894547966067679232]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='Case [Parameters].[Parameter 2 1]&#10;when 1 then 1&#10;when 2 then 2&#10;end' />
      </column>
      <column caption='SWITCH: Total Actives' datatype='real' name='[Calculation_5248663935853793284]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 11]&#10;when 1 then [Calculation_6986420071229566981] / {exclude [Calculation_1626292086620360706]: sum([Calculation_6986420071229566981])}&#10;when 2 then [Calculation_6986420071229566981]&#10;end' />
      </column>
      <column caption='SWITCH: Orders (STR)' datatype='string' name='[Calculation_5248663935860203525]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR( ROUND( ATTR([Calculation_1626292086622253059]), 2) )&#10;// case [Orders Abs/Rel/Avg]&#10;// when 1 then STR( ROUND( sum([Overall Orders]) / SUM({EXCLUDE [Customer Category]: SUM([Overall Orders]) })* 100, 1) ) + &apos;%&apos; // limit to only AVG&#10;// when 2 then REGEXP_REPLACE( STR( sum([Overall Orders]) ) ,&quot;(\d)(?=(\d{3})+$)&quot;,&quot;$0,&quot;) // removed Abs Orders from the dashboard&#10;// when 3 then &#10;// end' />
      </column>
      <column aggregation='Sum' caption='Filter: Apply Segmentation' datatype='integer' name='[Calculation_602215764550496256]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 13]&#10;when 1 then 1&#10;when 2 then 2&#10;end' />
      </column>
      <column caption='Filter Verticals Abs/Rel' datatype='integer' name='[Calculation_6986420071218712578]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1 2]&#10;when 1 then 1&#10;when 2 then 2&#10;when 3 then 3&#10;end' />
      </column>
      <column caption='Total Vertical Orders' datatype='integer' name='[Calculation_6986420071224258563]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{exclude [Shop Type (copy)]: sum([vertical_orders])}' />
      </column>
      <column caption='% Vertical Orders (of Total Vertical Orders)' datatype='real' default-format='p0.0%' name='[Calculation_6986420071224635396]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vertical_orders]) / sum([Calculation_6986420071224258563])' />
      </column>
      <column aggregation='Attribute' caption='Total Active Customers' datatype='integer' hidden='true' name='[Calculation_6986420071229566981]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{exclude [monthly_orders]: sum([cnt_monthly_orders])}' />
      </column>
      <column caption='SWITCH: Orders ' datatype='real' hidden='true' name='[SWITCH: Orders (copy)]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 12]&#10;when 1 then sum([overall_orders]) / SUM({EXCLUDE [Calculation_1626292086620360706]: SUM([overall_orders]) } )&#10;when 2 then sum([overall_orders])&#10;when 3 then ATTR([Calculation_1626292086622253059])&#10;end' />
      </column>
      <column caption='SWITCH: Total Actives (STR)' datatype='string' hidden='true' name='[SWITCH: Total Actives (copy)]' role='measure' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 11]&#10;when 1 then //STR( [Total Active Customers] / {exclude [Customer Category]: sum([Total Active Customers])} ) + &apos;%&apos;&#10; STR( ROUND( sum( [Calculation_6986420071229566981]) / sum({exclude [Calculation_1626292086620360706]: sum([Calculation_6986420071229566981])}) * 100, 1) ) + &apos;%&apos;&#10;when 2 then REGEXP_REPLACE(STR(sum([Calculation_6986420071229566981])),&quot;(\d)(?=(\d{3})+$)&quot;,&quot;$0,&quot;)&#10;end' />
      </column>
      <column caption='Shop Type (GROUPED)' datatype='string' name='[Shop Type (copy)]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [shop_type]&#10;when &apos;baby_supplies&apos;            then &apos;health products&apos; &#10;when &apos;cosmetics&apos;                then &apos;health products&apos;&#10;when &apos;health_supplements&apos;       then &apos;health products&apos;&#10;when &apos;optics&apos;                   then &apos;health products&apos; &#10;when &apos;pharmacies&apos;               then &apos;health products&apos;&#10;when NULL                       then &apos;unmapped&apos;&#10;when &apos;supermarket&apos;              then &apos;groceries&apos;&#10;when &apos;cross_vertical&apos;           then &apos;groceries&apos;&#10;when &apos;courier&apos;                  then &apos;groceries&apos;&#10;when &apos;furniture&apos;                then &apos;groceries&apos;&#10;else [shop_type]&#10;end' />
      </column>
