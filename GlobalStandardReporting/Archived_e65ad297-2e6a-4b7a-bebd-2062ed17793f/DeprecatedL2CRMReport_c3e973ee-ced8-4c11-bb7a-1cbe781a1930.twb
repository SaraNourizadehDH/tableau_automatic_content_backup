    <worksheet name='Acquisitions vs Reorders '>
      <table>
        <view>
          <datasources>
            <datasource caption='bima_tableau_mkt_crm_acquisitions_vs_reorders+ (rl_mkt)' name='federated.0qp6ev11khq95q17irqv31oxlw6h' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Customer Segment Parameter' datatype='string' name='[Parameter 14]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0qp6ev11khq95q17irqv31oxlw6h'>
            <column caption='Avg First Next Order Days Filtered By Customer Segment' datatype='integer' datatype-customized='true' default-format='n#,##0;-#,##0' name='[Avg First Next Order Days (copy)_1315051144815599625]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [customer_segment]= [Parameters].[Parameter 14]&#13;&#10;OR [Parameters].[Parameter 14]= &quot;All&quot;&#13;&#10;THEN [avg_first_next_order_days]&#13;&#10;END' />
            </column>
            <column caption='Customers Filtered By Customer Segment' datatype='integer' name='[Calculation_1315051144813985799]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [customer_segment]= [Parameters].[Parameter 14]&#13;&#10;OR [Parameters].[Parameter 14]= &quot;All&quot;&#13;&#10;THEN [customer_count]&#13;&#10;END' />
            </column>
            <column caption='Subsequent Order Rate' datatype='real' default-format='p0.00%' name='[Calculation_479070458587082752]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([second_time_customer_count])/SUM([customer_count])' />
            </column>
            <column caption='M1 Retention' datatype='real' default-format='p0.00%' name='[Calculation_479070458615971843]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([m1_reorder])/SUM([customer_count])&#13;&#10;//([M1 Inactive RR]/[M1 Welcome RR]) - 1' />
            </column>
            <column caption='M1 Activity Rate  ' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[M1 Retention (copy)_913667825567653908]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([m1_reorder_sum])/ SUM([customer_count])&#13;&#10;//[M1 Inactive RR SUM]/[M1 Welcome RR SUM]) - 1)' />
            </column>
            <column caption='M3 Retention' datatype='real' default-format='p0.00%' name='[M1 retention (copy) (copy)_479070458619187205]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([m3_reorder])/SUM([customer_count])&#13;&#10;//([M3 Inactive RR]/[M3 Welcome RR]) - 1' />
            </column>
            <column caption='M2 Retention' datatype='real' default-format='p0.00%' name='[M1 retention (copy)_479070458619170820]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([m2_reorder])/SUM([customer_count])&#13;&#10;//([M2 Inactive RR]/[M2 Welcome RR]) - 1' />
            </column>
            <column caption='M2 Activity Rate' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[M2 Retention (copy)_913667825567903765]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([m2_reorder_sum])/ SUM([customer_count])&#13;&#10;//([M2 Inactive RR SUM]/[M2 Welcome RR SUM]) - 1' />
