            </column>
            <column caption='Seg: Loyal Inactive to Inactive CORRECT' datatype='integer' name='[Calculation_86835093581987841]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// we need to be careful about the edge case inactives_mom with months_inactive = 23!!&#10;&#10;if [is_loyal_at_last_months_last_order_month] and [months_inactive] &lt; 23 &#10;then &#10;[Inactive Customer mom (copy)] - [reactivated_customers]&#10;else 0&#10;end&#10;&#10;+&#10;&#10;if [is_loyal_at_last_months_last_order_month] and [months_inactive] = 24 &#10;then &#10;[Inactive Customer (copy)]&#10;else 0 &#10;end' />
            </column>
            <column caption='test inactives' datatype='integer' hidden='true' name='[Calculation_86835093627609091]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [is_loyal_at_last_months_last_order_month] and &#10;[months_inactive] = 18&#10;then &#10;//[Inactive Customer (NO Churn) mom] - [Reactivated Customers]&#10;[Inactive Customer (copy)]&#10;else 0 &#10;end' />
            </column>
            <column caption='Inactive Customer (NO Churn)' datatype='integer' name='[Inactive Customer (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([new_inactive_customers], 0) + &#10;IFNULL([old_inactive_customers_6m], 0) + &#10;IFNULL([old_inactive_customers], 0)' />
