    <worksheet name='Orders (Switchable)'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#f28e2b'>Average</run>
            <run> Loyal Orders</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='bima_tableau_mkt_verticals_by_customers_segments+ (rl_mkt)' name='federated.1dh0m4g0m4f0la1gfbz9z13o6r1b' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='AVG' caption='Orders Abs/Rel/Av' datatype='integer' name='[Parameter 12]' param-domain-type='list' role='measure' type='quantitative' value='3'>
              <calculation class='tableau' formula='3' />
              <aliases>
                <alias key='1' value='Relative' />
                <alias key='2' value='Absolute' />
                <alias key='3' value='AVG' />
              </aliases>
            </column>
            <column alias='Absolute' caption='Frequency Abs/Rel' datatype='integer' name='[Parameter 2 1]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='Absolute' />
                <alias key='2' value='Relative' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1dh0m4g0m4f0la1gfbz9z13o6r1b'>
            <column caption='Customer Category' datatype='string' name='[Calculation_1626292086620360706]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [is_loyal] then &apos;Loyal&apos;&#10;elseif [is_active_frequent] then &apos;Active Frequent&apos;&#10;elseif [is_active_steady] then &apos;Active Steady&apos;&#10;else &apos;Rest&apos;&#10;end' />
            </column>
            <column aggregation='Attribute' caption='AVG Monthly Orders (Per User)' datatype='real' default-format='n#,##0.00;-#,##0.00' hidden='true' name='[Calculation_1626292086622253059]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ EXCLUDE  [monthly_orders]: SUM( INT([monthly_orders]) * [cnt_monthly_orders]) }&#10;/&#10;{EXCLUDE [monthly_orders]: SUM([cnt_monthly_orders])}' />
            </column>
            <column aggregation='Sum' caption='Filter Frequency Abs/Rel' datatype='integer' hidden='true' name='[Calculation_2894547966067679232]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='Case [Parameters].[Parameter 2 1]&#10;when 1 then 1&#10;when 2 then 2&#10;end' />
            </column>
            <column caption='SWITCH: Orders (STR)' datatype='string' name='[Calculation_5248663935860203525]' role='measure' type='nominal'>
              <calculation class='tableau' formula='STR( ROUND( ATTR([Calculation_1626292086622253059]), 2) )&#10;// case [Orders Abs/Rel/Avg]&#10;// when 1 then STR( ROUND( sum([Overall Orders]) / SUM({EXCLUDE [Customer Category]: SUM([Overall Orders]) })* 100, 1) ) + &apos;%&apos; // limit to only AVG&#10;// when 2 then REGEXP_REPLACE( STR( sum([Overall Orders]) ) ,&quot;(\d)(?=(\d{3})+$)&quot;,&quot;$0,&quot;) // removed Abs Orders from the dashboard&#10;// when 3 then &#10;// end' />
            </column>
            <column caption='SWITCH: Orders ' datatype='real' hidden='true' name='[SWITCH: Orders (copy)]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 12]&#10;when 1 then sum([overall_orders]) / SUM({EXCLUDE [Calculation_1626292086620360706]: SUM([overall_orders]) } )&#10;when 2 then sum([overall_orders])&#10;when 3 then ATTR([Calculation_1626292086622253059])&#10;end' />
            </column>
            <column caption='Cnt Monthly Orders' datatype='integer' name='[cnt_monthly_orders]' role='measure' type='quantitative' />
            <column caption='Is Acquisition 2M' datatype='boolean' name='[is_acquisition_2m]' role='dimension' type='nominal' />
            <column caption='Is Active Frequent' datatype='boolean' name='[is_active_frequent]' role='dimension' type='nominal' />
            <column caption='Is Active Steady' datatype='boolean' name='[is_active_steady]' role='dimension' type='nominal' />
            <column caption='Is Loyal' datatype='boolean' name='[is_loyal]' role='dimension' type='nominal' />
            <column datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column caption='Month Date' datatype='date' name='[month_date]' role='dimension' type='ordinal' />
            <column caption='Monthly Orders' datatype='integer' name='[monthly_orders]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1626292086620360706]' derivation='None' name='[none:Calculation_1626292086620360706:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2894547966067679232]' derivation='None' name='[none:Calculation_2894547966067679232:ok]' pivot='key' type='ordinal' />
            <column-instance column='[management_entity]' derivation='None' name='[none:management_entity:nk]' pivot='key' type='nominal' />
            <column-instance column='[month_date]' derivation='None' name='[none:month_date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[month_date]' derivation='None' name='[none:month_date:qk]' pivot='key' type='quantitative' />
            <column caption='Overall Orders' datatype='integer' name='[overall_orders]' role='measure' type='quantitative' />
            <column-instance column='[month_date]' derivation='Month-Trunc' name='[tmn:month_date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_5248663935860203525]' derivation='User' name='[usr:Calculation_5248663935860203525:nk]' pivot='key' type='nominal' />
            <column-instance column='[SWITCH: Orders (copy)]' derivation='User' name='[usr:SWITCH: Orders (copy):qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1dh0m4g0m4f0la1gfbz9z13o6r1b].[Is Acquisition 2m Without Nulls]' filter-group='7'>
