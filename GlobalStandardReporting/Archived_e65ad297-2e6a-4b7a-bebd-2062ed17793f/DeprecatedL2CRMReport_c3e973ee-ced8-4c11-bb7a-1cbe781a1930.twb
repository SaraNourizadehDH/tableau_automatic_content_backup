    <worksheet name='Loyal (3)'>
      <table>
        <view>
          <datasources>
            <datasource caption='bima_tableau_mkt_verticals_by_customers_segments+ (rl_mkt)' name='federated.1dh0m4g0m4f0la1gfbz9z13o6r1b' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Absolute' caption='Verticals Abs/Rel' datatype='integer' name='[Parameter 1 2]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='Absolute' />
                <alias key='2' value='Relative to Total Vertical Orders' />
                <alias key='3' value='Relative to Total Orders Within Category' />
              </aliases>
            </column>
            <column alias='No' caption='Apply Segmentation' datatype='integer' name='[Parameter 13]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='No' />
                <alias key='2' value='Yes' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1dh0m4g0m4f0la1gfbz9z13o6r1b'>
            <column caption='% Vertical Orders (of Overall Orders within Category)' datatype='real' default-format='p0.000%' name='[% Vertical Orders (of Overall Orders) (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vertical_orders]) / sum({exclude [Shop Type (copy)]: sum([overall_orders FIXED (copy)])})' />
            </column>
            <column caption='Customer Category' datatype='string' name='[Calculation_1626292086620360706]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [is_loyal] then &apos;Loyal&apos;&#10;elseif [is_active_frequent] then &apos;Active Frequent&apos;&#10;elseif [is_active_steady] then &apos;Active Steady&apos;&#10;else &apos;Rest&apos;&#10;end' />
            </column>
            <column aggregation='Sum' caption='Filter: Apply Segmentation' datatype='integer' name='[Calculation_602215764550496256]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 13]&#10;when 1 then 1&#10;when 2 then 2&#10;end' />
            </column>
            <column caption='Filter Verticals Abs/Rel' datatype='integer' name='[Calculation_6986420071218712578]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1 2]&#10;when 1 then 1&#10;when 2 then 2&#10;when 3 then 3&#10;end' />
            </column>
            <column caption='Shop Type (GROUPED)' datatype='string' name='[Shop Type (copy)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [shop_type]&#10;when &apos;baby_supplies&apos;            then &apos;health products&apos; &#10;when &apos;cosmetics&apos;                then &apos;health products&apos;&#10;when &apos;health_supplements&apos;       then &apos;health products&apos;&#10;when &apos;optics&apos;                   then &apos;health products&apos; &#10;when &apos;pharmacies&apos;               then &apos;health products&apos;&#10;when NULL                       then &apos;unmapped&apos;&#10;when &apos;supermarket&apos;              then &apos;groceries&apos;&#10;when &apos;cross_vertical&apos;           then &apos;groceries&apos;&#10;when &apos;courier&apos;                  then &apos;groceries&apos;&#10;when &apos;furniture&apos;                then &apos;groceries&apos;&#10;else [shop_type]&#10;end' />
            </column>
            <column caption='Display Name' datatype='string' name='[display_name]' role='dimension' type='nominal' />
            <column caption='Is Active Frequent' datatype='boolean' name='[is_active_frequent]' role='dimension' type='nominal' />
            <column caption='Is Active Steady' datatype='boolean' name='[is_active_steady]' role='dimension' type='nominal' />
            <column caption='Is Loyal' datatype='boolean' name='[is_loyal]' role='dimension' type='nominal' />
            <column datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column caption='Month Date' datatype='date' name='[month_date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1626292086620360706]' derivation='None' name='[none:Calculation_1626292086620360706:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_602215764550496256]' derivation='None' name='[none:Calculation_602215764550496256:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_6986420071218712578]' derivation='None' name='[none:Calculation_6986420071218712578:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Shop Type (copy)]' derivation='None' name='[none:Shop Type (copy):nk]' pivot='key' type='nominal' />
            <column-instance column='[management_entity]' derivation='None' name='[none:management_entity:nk]' pivot='key' type='nominal' />
            <column-instance column='[month_date]' derivation='None' name='[none:month_date:ok]' pivot='key' type='ordinal' />
