              <calculation class='tableau' formula='sum(if [is_loyal_at_last_months_last_order_month] = true&#10;and [months_inactive] &lt; 24&#10;then [reactivated_customers]&#10;else null &#10;end)&#10;/ &#10;sum({exclude [smaller group (copy 2)]: sum([Calculation_4582694122368450597])})' />
            </column>
