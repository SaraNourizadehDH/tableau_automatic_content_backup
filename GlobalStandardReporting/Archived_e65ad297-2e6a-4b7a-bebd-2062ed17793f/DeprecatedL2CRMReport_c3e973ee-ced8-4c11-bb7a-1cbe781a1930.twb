            <column-instance column='[shop_type]' derivation='None' name='[none:shop_type:nk]' pivot='key' type='nominal' />
            <column datatype='integer' name='[overall_orders FIXED (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull({FIXED [display_name], [month_date], [Calculation_1626292086620360706]: sum( [overall_orders])},0)' />
            </column>
            <column caption='Overall Orders' datatype='integer' name='[overall_orders]' role='measure' type='quantitative' />
