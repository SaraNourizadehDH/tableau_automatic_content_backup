      </layout-options>
      <repository-location id='ActiveCustomersSwitchable' path='/t/GlobalStandardReporting/workbooks/L2CRMReport' revision='' site='GlobalStandardReporting' />
      <table>
        <view>
          <datasources>
            <datasource caption='bima_tableau_mkt_verticals_by_customers_segments+ (rl_mkt)' name='federated.1dh0m4g0m4f0la1gfbz9z13o6r1b' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Absolute' caption='Total Actives Abs/Rel' datatype='integer' name='[Parameter 11]' param-domain-type='list' role='measure' type='quantitative' value='2'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='1' value='Relative' />
                <alias key='2' value='Absolute' />
              </aliases>
            </column>
            <column alias='Absolute' caption='Frequency Abs/Rel' datatype='integer' name='[Parameter 2 1]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='Absolute' />
                <alias key='2' value='Relative' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1dh0m4g0m4f0la1gfbz9z13o6r1b'>
            <column caption='Customer Category' datatype='string' name='[Calculation_1626292086620360706]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [is_loyal] then &apos;Loyal&apos;&#10;elseif [is_active_frequent] then &apos;Active Frequent&apos;&#10;elseif [is_active_steady] then &apos;Active Steady&apos;&#10;else &apos;Rest&apos;&#10;end' />
            </column>
            <column aggregation='Sum' caption='Filter Frequency Abs/Rel' datatype='integer' hidden='true' name='[Calculation_2894547966067679232]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='Case [Parameters].[Parameter 2 1]&#10;when 1 then 1&#10;when 2 then 2&#10;end' />
            </column>
            <column caption='SWITCH: Total Actives' datatype='real' name='[Calculation_5248663935853793284]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 11]&#10;when 1 then [Calculation_6986420071229566981] / {exclude [Calculation_1626292086620360706]: sum([Calculation_6986420071229566981])}&#10;when 2 then [Calculation_6986420071229566981]&#10;end' />
            </column>
            <column aggregation='Attribute' caption='Total Active Customers' datatype='integer' hidden='true' name='[Calculation_6986420071229566981]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{exclude [monthly_orders]: sum([cnt_monthly_orders])}' />
            </column>
            <column caption='SWITCH: Total Actives (STR)' datatype='string' hidden='true' name='[SWITCH: Total Actives (copy)]' role='measure' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 11]&#10;when 1 then //STR( [Total Active Customers] / {exclude [Customer Category]: sum([Total Active Customers])} ) + &apos;%&apos;&#10; STR( ROUND( sum( [Calculation_6986420071229566981]) / sum({exclude [Calculation_1626292086620360706]: sum([Calculation_6986420071229566981])}) * 100, 1) ) + &apos;%&apos;&#10;when 2 then REGEXP_REPLACE(STR(sum([Calculation_6986420071229566981])),&quot;(\d)(?=(\d{3})+$)&quot;,&quot;$0,&quot;)&#10;end' />
            </column>
            <column-instance column='[Calculation_5248663935853793284]' derivation='Attribute' name='[attr:Calculation_5248663935853793284:qk]' pivot='key' type='quantitative' />
            <column caption='Cnt Monthly Orders' datatype='integer' name='[cnt_monthly_orders]' role='measure' type='quantitative' />
            <column caption='Common Name' datatype='string' name='[common_name]' role='dimension' type='nominal' />
            <column caption='Display Name' datatype='string' name='[display_name]' role='dimension' type='nominal' />
            <column caption='Is Acquisition' datatype='boolean' name='[is_acquisition]' role='dimension' type='nominal' />
            <column caption='Is Acquisition 2M' datatype='boolean' name='[is_acquisition_2m]' role='dimension' type='nominal' />
