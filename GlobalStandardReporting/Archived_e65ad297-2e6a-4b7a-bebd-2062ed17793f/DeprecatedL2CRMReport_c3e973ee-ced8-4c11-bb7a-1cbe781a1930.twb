        <calculation class='tableau' formula='if [Parameters].[Parameter 7] = 1 then sum([Seg: Loyal Active (Non-Acq.) to Active (copy)])&#10;elseif [Parameters].[Parameter 7] = 2 then round([Seg: Loyal Active (Non-Acq.) to Churning (copy)]*100,2)&#10;end' />
      </column>
      <column caption='Switch: Active (non-Acq., non-loyal) to Churning' datatype='real' name='[Calculation_1784129168878895120]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 7] = 1 then (if sum([Seg: Active (non-Acq., Non-Loyal) to Active (copy)]) &gt; 0 then sum([Seg: Active (non-Acq., Non-Loyal) to Active (copy)]) else null end )&#10;elseif [Parameters].[Parameter 7] = 2 then (if round([Seg: Active (non-Acq., Non-Loyal) to Churning (copy)]*100,2) &gt; 0 then round([Seg: Active (non-Acq., Non-Loyal) to Churning (copy)]*100,2) else null end ) &#10;end' />
      </column>
      <column caption='Switch: Loyal Churning to Churning' datatype='real' name='[Calculation_1784129168879214609]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 7] = 1 then sum([Seg: Loyal Churning to Active (copy)])&#10;elseif [Parameters].[Parameter 7] = 2 then round([Seg: Loyal Churning to Churning (copy 2)]*100,2)&#10;end' />
      </column>
      <column caption='Switch: 2+ Churning (non-loyal) to Churning' datatype='real' name='[Calculation_1784129168879513618]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 7] = 1 then sum( [Seg: 2+ Churning (non-loyal) to Active (copy)])&#10;elseif [Parameters].[Parameter 7] = 2 then round([Seg: 2+ Churning (non-loyal) to Churning (copy 2)]*100,2)&#10;end' />
      </column>
      <column caption='Switch: 1 Churning (non-loyal) to Churning' datatype='real' name='[Calculation_1784129168879824915]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 7] = 1 then ( if sum( [Seg: 1 Churning (non-loyal) to Active (copy)]) &gt; 0 then sum( [Seg: 1 Churning (non-loyal) to Active (copy)]) else null end ) &#10;elseif [Parameters].[Parameter 7] = 2 then ( if round([Seg: 1 Churning (non-loyal) to Churning (copy 2)]*100,2) &gt; 0 then round([Seg: 1 Churning (non-loyal) to Churning (copy 2)]*100,2) else null end ) &#10;end' />
      </column>
      <column caption='Switch: Loyal Churning to Inactive' datatype='real' name='[Calculation_1784129168880496660]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 7] = 1 then (if sum(ifnull( [Seg: Loyal Churning to Churning (copy)],0)) &gt; 0 then sum( ifnull([Seg: Loyal Churning to Churning (copy)],0)) else null end )&#10;elseif [Parameters].[Parameter 7] = 2 then (if round([Seg: Loyal Churning to Inactive (copy)]*100,2) &gt; 0 then round([Seg: Loyal Churning to Inactive (copy)]*100,2) else null end )&#10;end' />
      </column>
      <column caption='Switch: 2+ Churning (non-loyal) to Inactive' datatype='real' name='[Calculation_1784129168880697365]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 7] = 1 then (if sum( ifnull([Seg: 2+ Churning (non-loyal) to Churning (copy)],0)) &gt; 0 then sum( ifnull([Seg: 2+ Churning (non-loyal) to Churning (copy)],0)) else null end )&#10;elseif [Parameters].[Parameter 7] = 2 then (if round([Seg: 2+ Churning (non-loyal) to Inactive (copy)]*100,2) &gt; 0 then round([Seg: 2+ Churning (non-loyal) to Inactive (copy)]*100,2) else null end)&#10;end' />
      </column>
      <column caption='Switch: 1 Churning (non-loyal) to Inactive' datatype='real' name='[Calculation_1784129168880881686]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 7] = 1 then (if sum( ifnull([Seg: 1 Churning (non-loyal) to Churning (copy)],0)) &gt; 0 then sum( ifnull([Seg: 1 Churning (non-loyal) to Churning (copy)],0)) else null end )&#10;elseif [Parameters].[Parameter 7] = 2 then ( if round([Seg: 1 Churning (non-loyal) to Inactive (copy)]*100,2) &gt; 0 then round([Seg: 1 Churning (non-loyal) to Inactive (copy)]*100,2) else null end )&#10;end' />
      </column>
      <column caption='Switch: Loyal Inactive to Inactive' datatype='real' name='[Calculation_1784129168881025047]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 7] = 1 then (if sum(ifnull([Calculation_86835093581987841],0)) &gt; 0 then sum(ifnull([Calculation_86835093581987841],0)) else null end)&#10;elseif [Parameters].[Parameter 7] = 2 then (if round([Seg: Loyal Inactive to Inactive (copy)]*100,2) &gt; 0 then round([Seg: Loyal Inactive to Inactive (copy)]*100,2) else null end)&#10;end' />
      </column>
      <column caption='Switch: 2+ Inactive to Inactive' datatype='real' name='[Calculation_1784129168881197080]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 7] = 1 then (if sum(ifnull([Seg: 2+ Inactive to Active (copy)],0))&gt;0 then sum(ifnull([Seg: 2+ Inactive to Active (copy)],0)) else null end )&#10;elseif [Parameters].[Parameter 7] = 2 then (if round([Seg: 2+ Inactive to Inactive (copy)]*100,2) &gt; 0 then  round([Seg: 2+ Inactive to Inactive (copy)]*100,2) else null end)&#10;end' />
      </column>
      <column caption='Switch: 1 Inactive to Inactive' datatype='real' name='[Calculation_1784129168881385497]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 7] = 1 then ( if sum( ifnull([Seg: 1 Inactive to Active (copy)],0)) &gt; 0 then sum(ifnull( [Seg: 1 Inactive to Active (copy)],0)) else null end )&#10;elseif [Parameters].[Parameter 7] = 2 then ( if round([Seg: 1 Inactive to Inactive (copy)]*100,2) &gt; 0 then round([Seg: 1 Inactive to Inactive (copy)]*100,2) else null end ) &#10;end' />
      </column>
      <column caption='FIXED: Churning mom' datatype='integer' name='[Calculation_1784129169282469918]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ fixed &#10;[group PAST (copy)],&#10;[month_date],&#10;[global_entity_id],&#10;[Calculation_1988128189455618048]&#10;:&#10;sum([churning_mom])&#10;}' />
      </column>
      <column caption='Channel' datatype='string' name='[Calculation_1988128189455618048]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='UPPER([Calculation_1187402204411432961])' />
      </column>
      <column caption='Churning (-)' datatype='integer' name='[Calculation_2330683197569777665]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[churning] * -1' />
      </column>
      <column caption='New Inactive Customers (-)' datatype='integer' hidden='true' name='[Calculation_2330683197569896450]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[new_inactive_customers] * -1' />
      </column>
      <column caption='% Almost Churned from Ch. Loy.' datatype='real' default-format='p0.0%' name='[Calculation_2477261277057200131]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Loyal Active from Churning (copy)] / sum([Calculation_4582694122367475748])' />
      </column>
      <column caption='% Almost Churned from Ch. NL' datatype='real' default-format='p0.0%' name='[Calculation_2477261277058383876]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Loyal Active from Loyal Churning  (copy)] / (sum([Seg LEFT: Churning Loyal (copy)]) + sum([Seg LEFT: 2+ Churning non-loyal  (copy)]))' />
      </column>
      <column caption='% Retained Loyal' datatype='real' default-format='p0.0%' name='[Calculation_2477261277059153925]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_6942861809498628114] / sum([Calculation_4582694122366173218])' />
      </column>
      <column caption='% Active Loyal from Active NL' datatype='real' default-format='p0.0%' name='[Calculation_2477261277059530758]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_6942861809498279953] / sum([Calculation_4582694122366566435])' />
      </column>
      <column caption='smaller group' datatype='string' name='[Calculation_2564448168798150661]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [is_loyal] = true then &apos;true&apos;&#10;else [Lt Orders (group) (copy) (copy) (copy)]&#10;end' />
        <aliases>
          <alias key='&quot;1 LT Orders&quot;' value='1 LT Orders (Not Loyal)' />
          <alias key='&quot;2-4 LT Orders&quot;' value='2-4 LT Orders (Not Loyal)' />
          <alias key='&quot;5+ LT Orders&quot;' value='5+ LT Orders (Not Loyal)' />
          <alias key='&quot;true&quot;' value='Loyal' />
        </aliases>
      </column>
      <column caption='User Base (last month)' datatype='integer' name='[Calculation_2564448168838254598]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([user_base_mom]) + sum([old_inactive_customers_6m_mom])' />
      </column>
      <column caption='MoM User Base' datatype='real' default-format='p0.0%' name='[Calculation_2564448168839061512]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_2694208137144508416]) / [Calculation_2564448168838254598] - 1' />
      </column>
      <column caption='Seg LEFT: TOTAL' datatype='integer' name='[Calculation_262827288092168194]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([acquisitions_mom])+SUM([Calculation_4582694122366173218])+SUM([Calculation_4582694122366566435])+SUM([Calculation_4582694122367475748])+SUM([Seg LEFT: Churning Loyal (copy)])+SUM([Seg LEFT: 2+ Churning non-loyal  (copy)])+SUM([Calculation_4582694122368450597])+SUM([Calculation_4582694122368663590])+SUM([Calculation_4582694122369179687])+SUM([Calculation_1645502775337164800])' />
      </column>
      <column caption='Seg Active: TOTAL' datatype='integer' name='[Calculation_262827288093081603]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IFNULL([Calculation_4582694120960806935], 0)) &#10;+ SUM(IFNULL([Calculation_4582694120965554200],0))&#10;+ SUM(IFNULL([Calculation_4582694120968650777],0))&#10;+SUM(IFNULL([Calculation_4582694120973029402],0))&#10;+SUM(IFNULL([Calculation_4582694122291761180],0))&#10;+SUM(IFNULL([Calculation_4582694122301276189],0))&#10;+SUM(IFNULL([Calculation_4582694122303053854],0))&#10;+SUM(IFNULL([Calculation_4582694122303574047],0))&#10;+SUM(IFNULL([Calculation_4582694122303918112],0))&#10;+ sum(IFNULL([Calculation_1645502775342997505],0))' />
      </column>
      <column caption='Seg Churning: TOTAL' datatype='integer' name='[Calculation_262827288096129028]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Seg: Acq. to Active (copy)])+sum(IFNULL([Seg: Loyal Active (Non-Acq.) to Active (copy)],0))+SUM(IFNULL([Seg: Active (non-Acq., Non-Loyal) to Active (copy)],0))+SUM(IFNULL([Seg: Loyal Churning to Active (copy)],0))+SUM(IFNULL([Seg: 2+ Churning (non-loyal) to Active (copy)],0))+SUM(IFNULL([Seg: 1 Churning (non-loyal) to Active (copy)],0))' />
      </column>
      <column caption='Seg Inactive TOTAL' datatype='integer' name='[Calculation_262827288104779781]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL([Seg: Loyal Churning to Churning (copy)],0))&#10;+SUM(IFNULL([Seg: 2+ Churning (non-loyal) to Churning (copy)],0))&#10;+SUM(IFNULL([Seg: 1 Churning (non-loyal) to Churning (copy)],0))&#10;+SUM(IFNULL([Calculation_86835093581987841],0))&#10;+SUM(IFNULL([Seg: 2+ Inactive to Active (copy)],0))&#10;+SUM(IFNULL([Seg: 1 Inactive to Active (copy)],0)) &#10;+SUM(IFNULL([Calculation_1645502775347011587], 0))' />
      </column>
      <column caption='User Base' datatype='integer' name='[Calculation_2694208137144508416]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ([global_entity_id] = &quot;MJM_AT&quot; OR [global_entity_id] = &quot;HN_DK&quot;) THEN [braze_user_base]&#10;ELSE [user_base] + [old_inactive_customers_6m]&#10;END' />
      </column>
      <column caption='Boolean: Current Month' datatype='boolean' name='[Calculation_3339841340074151938]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, TODAY()) = [month_date]' />
      </column>
      <column caption='Active Customer' datatype='integer' name='[Calculation_3515059544965722113]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([retained_customers], 0) + &#10;IFNULL([acquisitions], 0) + &#10;IFNULL([reactivated_customers], 0) +&#10;IFNULL([almost_churned_customers], 0)' />
      </column>
      <column caption='NPS AO' datatype='real' name='[Calculation_3769794429203070976]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100 * (sum([nps_ao_promoters]) - sum([nps_ao_detractors])) / sum([nps_ao_responses])' />
      </column>
      <column caption='CVR' datatype='real' default-format='p0.0%' name='[Calculation_3769794429203402753]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='( sum([transactions_new])+sum([transactions_returning]) ) / (sum([sessions_new]) + sum([sessions_returning]))' />
      </column>
      <column caption='Hard Fail Rate' datatype='real' default-format='p0.0%' name='[Calculation_3769794429203632130]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([hard_failed_orders]) / sum( [total_orders_exc_call] )' />
      </column>
      <column caption='Reactivated Share from Inactive prev. Month' datatype='real' default-format='p0.00%' name='[Calculation_4054365632507748352]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([reactivated_customers])&#10;/&#10;sum([test 3 (copy)])' />
      </column>
      <column caption='Latest Month of Data' datatype='boolean' name='[Calculation_4214806317615894528]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_572168273164574722] = [month_date]' />
      </column>
      <column caption='% Last Month Active to Churning' datatype='real' default-format='p0.0%' name='[Calculation_4580723819735707648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='( sum([churning_from_acquisition]) &#10;+ sum([churning_from_almost_churned]) &#10;+ sum([churning_from_reactivated])&#10;+ sum([churning_from_retained]) )&#10;/ &#10;//sum( {exclude [group PAST (colours: Newly Inact)]: sum([Active Customer mom]) })&#10;SUM({fixed [city], [country_name], [sub_entity], [management_entity], [month_date], [Calculation_1988128189455618048], [Is Voucher (copy)]: sum([Calculation_4582694120617635843])})&#10;//change as of 25.03.2020 JIRA DATA-3939&#10;//SUM({fixed [City], [Country Name], [Display Name], [Management Entity], [Month Date], [Channel], [Is Voucher (copy)], [group PAST (colours: Newly Inact)]: sum([Active Customer mom])})' />
      </column>
      <column caption='MoM Acquisitions' datatype='real' default-format='p0.0%' name='[Calculation_4582694120615018496]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([acquisitions]) / sum([acquisitions_mom]) - 1' />
      </column>
      <column caption='YoY Acquisitions' datatype='real' default-format='p0.0%' name='[Calculation_4582694120615280641]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([acquisitions]) / sum([acquisitions_yoy]) - 1' />
      </column>
      <column caption='Active Customers WITHOUT Acquisitions' datatype='integer' name='[Calculation_4582694120617058306]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_3515059544965722113]) - sum([acquisitions])' />
      </column>
      <column caption='Active Customer mom' datatype='integer' name='[Calculation_4582694120617635843]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([retained_customers_mom], 0) + &#10;IFNULL([acquisitions_mom], 0) + &#10;IFNULL([reactivated_customers_mom], 0) +&#10;IFNULL([almost_churned_customers_mom], 0)' />
      </column>
      <column caption='Active Customers WITHOUT Acquisitions mom' datatype='integer' name='[Calculation_4582694120617922564]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_4582694120617635843]) - sum([acquisitions_mom])' />
      </column>
      <column caption='MoM Active Customers WITHOUT Acquisitions ' datatype='real' default-format='p0.0%' name='[Calculation_4582694120618344453]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_4582694120617058306] / [Calculation_4582694120617922564] - 1' />
      </column>
      <column caption='YoY Active Customers WITHOUT Acquisitions' datatype='real' default-format='p0.0%' name='[Calculation_4582694120618885126]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([Calculation_3515059544965722113]) - sum([acquisitions]))&#10;/&#10;(SUM([active_customers_yoy]) - sum([acquisitions_yoy]))&#10;- 1' />
      </column>
      <column caption='MoM Churning Customers' datatype='real' default-format='p0.0%' name='[Calculation_4582694120624791560]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([churning]) / sum([churning_mom]) - 1' />
      </column>
      <column caption='YoY Churning Customers' datatype='real' default-format='p0.0%' name='[Calculation_4582694120625070089]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([churning]) / sum([churning_yoy]) - 1' />
      </column>
      <column caption='Inactive Customer mom' datatype='integer' name='[Calculation_4582694120626712586]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([new_inactive_customers_mom], 0) + &#10;IFNULL([old_inactive_customers_6m_mom], 0) + &#10;IFNULL([old_inactive_customers_mom], 0) +&#10;IFNULL([churning_mom], 0)' />
      </column>
      <column caption='Inactive Customer yoy' datatype='integer' name='[Calculation_4582694120628035596]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([new_inactive_customers_yoy], 0) + &#10;IFNULL([old_inactive_customers_yoy], 0)' />
      </column>
      <column caption='&apos;MoM&apos;' datatype='string' name='[Calculation_4582694120878022675]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;MoM&apos;' />
      </column>
      <column caption='&apos;YoY&apos;' datatype='string' name='[Calculation_4582694120878092308]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;YoY&apos;' />
      </column>
      <column caption='&apos;Month&apos;' datatype='string' name='[Calculation_4582694120878178325]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Month&apos;' />
      </column>
      <column caption='Seg: Acq. to Active' datatype='integer' name='[Calculation_4582694120960806935]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='[retained_from_acquisition]' />
      </column>
      <column caption='Seg: Loyal Active (Non-Acq.) to Active' datatype='integer' name='[Calculation_4582694120965554200]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [is_loyal_1m_ago] = true &#10;then &#10;[retained_customers] - [retained_from_acquisition]&#10;end' />
      </column>
      <column caption='Seg: Active (non-Acq., Non-Loyal) to Active' datatype='integer' name='[Calculation_4582694120968650777]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [is_loyal_1m_ago] = false &#10;then &#10;[retained_from_retained] + &#10;[retained_from_almost_churned] +  &#10;[retained_from_reactivated]&#10;end' />
      </column>
      <column caption='Seg: Loyal Churning to Active' datatype='integer' name='[Calculation_4582694120973029402]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [is_loyal_at_last_months_last_order_month] = true&#10;then&#10;[almost_churned_from_churning]&#10;end' />
      </column>
      <column caption='Seg: 2+ Churning (non-loyal) to Active' datatype='integer' name='[Calculation_4582694122291761180]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if ([lt_orders_last_month] = &apos;2-4lt&apos; or [lt_orders_last_month] = &apos;5+lt&apos;)&#10;and [is_loyal_at_last_months_last_order_month] = false &#10;then [almost_churned_from_churning]&#10;else 0 &#10;end' />
      </column>
      <column caption='Seg: 1 Churning (non-loyal) to Active' datatype='integer' name='[Calculation_4582694122301276189]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if ([lt_orders_last_month] = &apos;1lt&apos;)&#10;and [is_loyal_at_last_months_last_order_month] = false &#10;then [almost_churned_from_churning]&#10;else null &#10;end' />
      </column>
      <column caption='Seg: Loyal Inactive to Active' datatype='integer' name='[Calculation_4582694122303053854]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [is_loyal_at_last_months_last_order_month] = true&#10;and [months_inactive] &lt; 24&#10;then [reactivated_customers]&#10;else 0&#10;end' />
      </column>
      <column caption='Seg: 2+ Inactive to Active' datatype='integer' name='[Calculation_4582694122303574047]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if ([lt_orders] = &apos;2-4lt&apos; or [lt_orders] = &apos;5+lt&apos;)&#10;and [is_loyal_at_last_months_last_order_month] = false &#10;and [months_inactive] &lt; 24&#10;then [reactivated_customers]&#10;else 0 &#10;end' />
      </column>
      <column caption='Seg: 1 Inactive to Active' datatype='integer' name='[Calculation_4582694122303918112]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if ([lt_orders_last_month] = &apos;1lt&apos;)&#10;and [is_loyal_at_last_months_last_order_month] = false &#10;and [months_inactive] &lt; 24&#10;then [reactivated_customers]&#10;else 0&#10;end' />
      </column>
      <column caption='NULL ' datatype='integer' name='[Calculation_4582694122330669089]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='LOOKUP(sum([acquisitions]), -5)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Seg LEFT: Loyal Active Customer NO ACQ' datatype='integer' name='[Calculation_4582694122366173218]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='If [is_loyal] = true &#10;then [Active Customers WITHOUT Acquisitions mom (copy)]&#10;end' />
      </column>
      <column caption='Seg LEFT: Active Customer non-loyal' datatype='integer' name='[Calculation_4582694122366566435]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [is_loyal] = false &#10;then &#10;[Active Customers WITHOUT Acquisitions mom (copy)]&#10;end' />
      </column>
      <column caption='Seg LEFT: Churning Loyal' datatype='integer' name='[Calculation_4582694122367475748]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [is_loyal_at_last_months_last_order_month] = true &#10;then &#10;[churning_mom]&#10;end' />
      </column>
      <column caption='Seg LEFT: Inactive Loyal' datatype='integer' name='[Calculation_4582694122368450597]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [is_loyal_at_last_months_last_order_month] = true &#10;and [months_inactive] &lt; 24&#10;then &#10;[Inactive Customer mom (copy)]&#10;end' />
      </column>
      <column caption='Seg LEFT: 2+ Inactive non-loyal' datatype='integer' name='[Calculation_4582694122368663590]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [is_loyal_at_last_months_last_order_month] = false &#10;and ([lt_orders] = &apos;2-4lt&apos; or [lt_orders] = &apos;5+lt&apos;)&#10;and [months_inactive] &lt; 24&#10;then &#10;[Inactive Customer mom (copy)]&#10;end' />
      </column>
      <column caption='Seg LEFT: 1 Inactive non-loyal' datatype='integer' name='[Calculation_4582694122369179687]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [is_loyal_at_last_months_last_order_month] = false &#10;and [lt_orders] = &apos;1lt&apos;&#10;and [months_inactive] &lt; 24&#10;then &#10;[Inactive Customer mom (copy)]&#10;end' />
      </column>
      <column caption='Latest Month' datatype='date' name='[Calculation_572168273164574722]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{MAX(DATE([month_date]))}' />
      </column>
      <column caption='Active Base Growth' datatype='integer' name='[Calculation_5963539986990718976]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[acquisitions] +&#10;[almost_churned_customers] + [reactivated_customers] + [Newly Churning Customers (copy)_1272266948883972096]' />
      </column>
      <column caption='Loyalty Base (ACT + CHU)' datatype='integer' name='[Calculation_6687352907468722180]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Calculation_3515059544965722113],0) &#10;+ IFNULL([churning],0)  &#10;- IFNULL([acquisitions],0) &#10;- IFNULL([acquisitions_mom],0)' />
      </column>
      <column caption='Loyal*  OVER Loyalty Base' datatype='real' default-format='p0.0%' name='[Calculation_6687352907469697029]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_6942861807022764033]) &#10;/ &#10;sum([Calculation_6687352907468722180])' />
      </column>
      <column caption='Loyal Active Customer' datatype='integer' name='[Calculation_6942861807022764033]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [is_loyal] = true &#10;then [Calculation_3515059544965722113]&#10;end' />
      </column>
      <column caption='Loyal Active from NL Active' datatype='integer' name='[Calculation_6942861809498279953]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [is_loyal_1m_ago] = false and [is_loyal] = true &#10;then &#10;[retained_customers]&#10;end )' />
      </column>
      <column caption='Loyal Active from Loyal Active' datatype='integer' name='[Calculation_6942861809498628114]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(&#10;if [is_loyal_1m_ago] = true and [is_loyal] = true &#10;then &#10;[retained_customers]&#10;end &#10;)' />
      </column>
      <column caption='Placeholder' datatype='integer' name='[Calculation_856528417932349440]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN(0)' />
      </column>
      <column caption='% Active Customer' datatype='real' default-format='p0.00%' name='[Calculation_856528417969364994]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([active_customers])/SUM([Calculation_2694208137144508416])' />
      </column>
      <column caption='Orders Per Loyal' datatype='real' name='[Calculation_856528417970774019]' role='measure' type='quantitative' visual-totals='Avg'>
        <calculation class='tableau' formula='SUM(CASE [is_loyal] WHEN TRUE THEN [orders] ELSE 0 END)/SUM(CASE [is_loyal] WHEN TRUE THEN [Calculation_2694208137144508416] ELSE 0 END)' />
      </column>
      <column caption='% Vouchers By Reactivated' datatype='real' default-format='p0.00%' name='[Calculation_856528417982808072]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Reactivated from Inactive&#13;&#10;SUM(IF [is_voucher] = &apos;is_voucher&apos; THEN [reactivated_customers] ELSE 0 END)&#13;&#10;/SUM([reactivated_customers])' />
      </column>
      <column caption='Seg: Loyal Inactive to Inactive CORRECT' datatype='integer' name='[Calculation_86835093581987841]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// we need to be careful about the edge case inactives_mom with months_inactive = 23!!&#10;&#10;if [is_loyal_at_last_months_last_order_month] and [months_inactive] &lt; 23 &#10;then &#10;[Inactive Customer mom (copy)] - [reactivated_customers]&#10;else 0&#10;end&#10;&#10;+&#10;&#10;if [is_loyal_at_last_months_last_order_month] and [months_inactive] = 24 &#10;then &#10;[Inactive Customer (copy)]&#10;else 0 &#10;end' />
      </column>
      <column caption='test inactives' datatype='integer' hidden='true' name='[Calculation_86835093627609091]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [is_loyal_at_last_months_last_order_month] and &#10;[months_inactive] = 18&#10;then &#10;//[Inactive Customer (NO Churn) mom] - [Reactivated Customers]&#10;[Inactive Customer (copy)]&#10;else 0 &#10;end' />
      </column>
      <column caption='DELTA Churning 2+' datatype='integer' name='[Calculation_86835093931552772]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Seg Churning: TOTAL (copy 2)] - sum([Seg LEFT: Churning Loyal (copy)])' />
      </column>
      <column caption='Switch: DELTA 2+ Churning' datatype='real' name='[Calculation_86835093931819013]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 7] = 1 then [Calculation_86835093931552772]&#10;elseif [Parameters].[Parameter 7] = 2 then round([Calculation_86835093931552772] / sum([Seg LEFT: Churning Loyal (copy)]) *100,2) &#10;end' />
      </column>
      <column caption='DELTA Churning 1' datatype='integer' name='[Calculation_86835093935771654]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Seg Churning: TOTAL 2+ (copy)] - sum([Seg LEFT: 2+ Churning non-loyal  (copy)])' />
      </column>
      <column caption='Seg Inactive TOTAL Loyal' datatype='integer' name='[Calculation_86835093940809735]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL([Seg: Loyal Churning to Churning (copy)],0))&#10;+SUM(IFNULL(if [months_inactive] &lt; 24 then [Calculation_86835093581987841] end ,0))' />
      </column>
      <column caption='Seg Inactive TOTAL 2+' datatype='integer' name='[Calculation_86835093941960712]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL([Seg: 2+ Churning (non-loyal) to Churning (copy)],0))&#10;+SUM(IFNULL( if [months_inactive] &lt; 24 then [Seg: 2+ Inactive to Active (copy)] end ,0))' />
      </column>
      <column caption='Seg Inactive TOTAL 1' datatype='integer' name='[Calculation_86835093942190089]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL([Seg: 1 Churning (non-loyal) to Churning (copy)],0))&#10;+SUM(IFNULL(if [months_inactive] &lt; 24 then [Seg: 1 Inactive to Active (copy)] end ,0))' />
      </column>
      <column caption='Seg Inactive TOTAL 2+ years' datatype='integer' name='[Calculation_86835093942571018]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL(if [months_inactive] &gt;= 24 then [Calculation_86835093581987841] end,0))&#10;+SUM(IFNULL(if [months_inactive] &gt;= 24 then [Seg: 2+ Inactive to Active (copy)] end,0))&#10;+SUM(IFNULL(if [months_inactive] &gt;= 24 then [Seg: 1 Inactive to Active (copy)] end,0)) &#10;+SUM(IFNULL([Calculation_1645502775347011587], 0))' />
      </column>
      <column caption='DELTA Inactive Loyal' datatype='integer' name='[Calculation_86835093942997004]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_86835093940809735] - sum( [Calculation_4582694122368450597] )' />
      </column>
      <column caption='DELTA Inactive 2+' datatype='integer' name='[Calculation_86835093943140365]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_86835093941960712] -  sum([Calculation_4582694122368663590])' />
      </column>
      <column caption='DELTA Inactive 1' datatype='integer' name='[Calculation_86835093943312398]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_86835093942190089] - sum( [Calculation_4582694122369179687] )' />
      </column>
      <column caption='DELTA Inactive 2+ years' datatype='integer' name='[Calculation_86835093943422991]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_86835093942571018] - sum( [Calculation_1645502775337164800] )' />
      </column>
      <column caption='Switch: DELTA Loyal Inactive' datatype='real' name='[Calculation_86835093950496784]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 7] = 1 then [Calculation_86835093942997004]&#10;elseif [Parameters].[Parameter 7] = 2 then round([Calculation_86835093942997004] / sum([Calculation_4582694122368450597]) *100,2) &#10;end' />
      </column>
      <column caption='Switch: DELTA 2+ Inactive' datatype='real' name='[Calculation_86835093952061457]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 7] = 1 then [Calculation_86835093943140365]&#10;elseif [Parameters].[Parameter 7] = 2 then round([Calculation_86835093943140365] / sum([Calculation_4582694122368663590]) *100,2) &#10;end' />
      </column>
      <column caption='DELTA Churning Loyal' datatype='integer' name='[DELTA NL Active Customer (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Seg Churning: TOTAL (copy)] - sum( If [is_loyal_at_last_months_last_order_month]&#10;then [churning_mom] &#10;end)' />
      </column>
      <column caption='Inactive Customer (NO Churn)' datatype='integer' name='[Inactive Customer (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([new_inactive_customers], 0) + &#10;IFNULL([old_inactive_customers_6m], 0) + &#10;IFNULL([old_inactive_customers], 0)' />
      </column>
      <column caption='Inactive Customer (NO Churn) mom' datatype='integer' name='[Inactive Customer mom (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([new_inactive_customers_mom], 0) + &#10;IFNULL([old_inactive_customers_6m_mom], 0) + &#10;IFNULL([old_inactive_customers_mom], 0)' />
      </column>
      <column datatype='string' name='[Is Voucher (copy)]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[is_voucher]' />
      </column>
      <column caption='Loyal Active from Loyal Churning ' datatype='integer' name='[Loyal Active from Churning (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(&#10;if [is_loyal] = true and [is_loyal_at_last_months_last_order_month] = true &#10;then &#10;[almost_churned_customers]&#10;end &#10;)' />
      </column>
      <column caption='Loyal Active from NL Churning' datatype='integer' name='[Loyal Active from Loyal Churning  (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(&#10;if [is_loyal] = true and [is_loyal_at_last_months_last_order_month] = false &#10;then &#10;[almost_churned_customers]&#10;end &#10;)' />
      </column>
      <column caption='Lt Orders smaller' datatype='string' name='[Lt Orders (group) (copy) (copy) (copy)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[lt_orders]' new-bin='true'>
          <bin default-name='false' value='&quot;1 LT Orders&quot;'>
            <value>&quot;1lt&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;2+ LT Orders&quot;'>
            <value>&quot;2-4lt&quot;</value>
            <value>&quot;5+lt&quot;</value>
          </bin>
        </calculation>
      </column>
      <column datatype='string' name='[Lt Orders (group) (copy)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[lt_orders]' new-bin='true'>
          <bin default-name='false' value='&quot;1 LT Orders&quot;'>
            <value>&quot;1lt&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;2-4 LT Orders&quot;'>
            <value>&quot;2-4lt&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;5+ LT Orders&quot;'>
            <value>&quot;5+lt&quot;</value>
          </bin>
        </calculation>
      </column>
      <column datatype='string' name='[Lt Orders (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[lt_orders]' new-bin='true'>
          <bin default-name='false' value='&quot;1 LT Orders&quot;'>
            <value>&quot;1lt&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;2-4 LT Orders&quot;'>
            <value>&quot;2-4lt&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;5+ LT Orders&quot;'>
            <value>&quot;5+lt&quot;</value>
          </bin>
        </calculation>
      </column>
      <column caption='MoM Inactive Customer (No Churn)' datatype='real' default-format='p0.0%' name='[MoM Inactive Customer (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{include [smaller group (to inactive) (copy 2)]:sum([Inactive Customer (copy)])}&#10;/&#10; {include [smaller group (to inactive) (copy 2)]:sum([Inactive Customer mom (copy)])} - 1' />
      </column>
      <column caption='Month Date (for segment migrations)' datatype='datetime' default-format='*YYYY-MM' name='[Month Date (copy 2)]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[month_date]' />
      </column>
      <column datatype='datetime' default-format='*YYYY-MM' name='[Month Date (copy)]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[month_date]' />
      </column>
      <column caption='Move: Churning to Almost Churned  - Summary View' datatype='real' default-format='p0.00%' name='[Move: Churning to Almost Churned (copy 2)_584060645119754241]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([almost_churned_customers]) &#10;/ &#10;sum([Calculation_1784129169282469918])' />
      </column>
      <column caption='% prev. Month Churning to New Inactive' datatype='real' default-format='p0.00%' name='[Move: Churning to Almost Churned (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([new_inactive_customers]) / sum([churning_mom])' />
      </column>
      <column caption='Move: Churning to Almost Churned' datatype='real' default-format='p0.00%' name='[Move: Inactive to Reactivated  (copy) 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([almost_churned_customers]) &#10;/ &#10;sum([Calculation_1784129169282469918])' />
      </column>
      <column datatype='integer' name='[NULL  (copy 2)]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='LOOKUP(sum([acquisitions]), -5)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='integer' hidden='true' name='[NULL  (copy 5)]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='LOOKUP(sum([acquisitions]), -5)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='integer' name='[NULL  (copy) (copy)]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='LOOKUP(sum([acquisitions]), -5)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='integer' name='[NULL  (copy)]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='LOOKUP(sum([acquisitions]), -5)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Newly Churning Customers (-) - Tooltip Format' datatype='integer' name='[Newly Churning Customers (-) (copy)_3010515628638412803]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([churning_from_acquisition] + [churning_from_retained] + [churning_from_almost_churned] + [churning_from_reactivated])*(-1)' />
      </column>
      <column caption='Newly Churning Customers (-)' datatype='integer' name='[Newly Churning Customers (copy)_1272266948883972096]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([churning_from_acquisition] + [churning_from_retained] + [churning_from_almost_churned] + [churning_from_reactivated])*(-1)' />
      </column>
      <column caption='Reactivated Customers - Tooltip Format' datatype='integer' name='[Reactivated Customers (copy)_3010515628638212097]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[reactivated_customers]' />
      </column>
      <column caption='Move: Inactive to Active last month - Reactivated Share from Inactive prev. Month' datatype='real' default-format='p0.00%' name='[Reactivated Share from Inactive prev. Month (copy)_584060645120811010]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([reactivated_customers])&#10;/&#10;sum([test 3 (copy)])' />
