              <calculation class='tableau' formula='sum ([Calculation_1645502775342997505] )&#10;/ &#10;sum({exclude [smaller group (copy 2)]: sum([Calculation_1645502775337164800])})' />
            </column>
            <column caption='% Seg: Acq. to Active ' datatype='real' default-format='p0.0%' name='[Seg: Acq. to Active (copy 3)]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='sum([retained_from_acquisition]) / sum([acquisitions_mom])' />
