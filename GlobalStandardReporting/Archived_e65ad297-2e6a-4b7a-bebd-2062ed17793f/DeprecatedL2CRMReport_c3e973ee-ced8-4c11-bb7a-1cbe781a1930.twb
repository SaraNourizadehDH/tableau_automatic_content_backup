        <calculation class='tableau' formula='if [Parameters].[Parameter 7] = 1 then [Seg LEFT: Loyal Active Customer NO ACQ (copy)]&#10;elseif [Parameters].[Parameter 7] = 2 then round([Seg LEFT: Loyal Active Customer NO ACQ (copy)] / (sum( if [is_loyal] then [Calculation_4582694120617635843]end )) *100,2) &#10;end' />
