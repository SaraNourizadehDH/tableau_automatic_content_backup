      </connection>
      <aliases enabled='yes' />
      <column caption='% Churning Loyals - Last Month Active to Churning' datatype='real' default-format='p0.0%' name='[% Last Month Active to Churning (copy)_584060645116084224]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='( sum([churning_from_acquisition]) &#13;&#10;+ sum([churning_from_almost_churned]) &#13;&#10;+ sum([churning_from_reactivated])&#13;&#10;+ sum([churning_from_retained]) )&#13;&#10;/ &#13;&#10;//sum( {exclude [group PAST (colours: Newly Inact)]: sum([Active Customer mom]) })&#13;&#10;SUM({fixed [city], [country_name], [sub_entity], [management_entity], [month_date], [Calculation_1988128189455618048], [Is Voucher (copy)]: sum([Calculation_4582694120617635843])})' />
      </column>
      <column caption='% Vouchers By Returned' datatype='real' default-format='p0.00%' name='[% Vouchers By Reactivated (copy)_856528417984749577]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Returned from Churning&#13;&#10;SUM(IF [is_voucher] = &apos;is_voucher&apos; THEN [almost_churned_customers] ELSE 0 END)&#13;&#10;/SUM([almost_churned_customers])' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0vv50l01f2ptjn18mniuy0y8b090].[sum:Newly Churning Customers (copy)_1272266948883972096:qk]&quot;' value='Newly Churning' />
          <alias key='&quot;[federated.0vv50l01f2ptjn18mniuy0y8b090].[sum:reactivated_customers:qk]&quot;' value='Reactivated' />
        </aliases>
      </column>
      <column caption='Acquisitions - Tooltip Format' datatype='integer' name='[Acquisitions (copy)_3010515628638056448]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[acquisitions]' />
      </column>
      <column caption='Active Customers WITHOUT Acquisitions mom [not aggregated]' datatype='integer' name='[Active Customers WITHOUT Acquisitions mom (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_4582694120617635843] - [acquisitions_mom]' />
      </column>
      <column caption='Customers Base Δ YoY' datatype='real' default-format='p0.00%' name='[Active Customers Δ YoY (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;SUM([Calculation_2694208137144508416])&#10;/&#10;SUM([User Base (copy)])&#10;)&#10;- 1' />
      </column>
      <column caption='Almost Churned - Tooltip Format' datatype='integer' name='[Almost Churned (copy)_3010515628638298114]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[almost_churned_customers]' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_1187402204410871808]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Channel (old)' datatype='string' name='[Calculation_1187402204411432961]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Placeholder&apos;' />
      </column>
      <column caption='Seg LEFT: Inactive 2+ years' datatype='integer' name='[Calculation_1645502775337164800]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='If [months_inactive] &gt;= 24&#10;then &#10;[Inactive Customer mom (copy)]&#10;end' />
      </column>
      <column caption='Seg: 2+ years Inactive to Active' datatype='integer' name='[Calculation_1645502775342997505]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [months_inactive] &gt;= 24&#10;then [reactivated_customers]&#10;else 0 &#10;end' />
      </column>
      <column caption='Switch: 2+ years Inactive to Active' datatype='real' name='[Calculation_1645502775343415298]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 7] = 1 then ( if  sum([Calculation_1645502775342997505]) &gt; 0 then sum([Calculation_1645502775342997505]) else null end )&#10;elseif [Parameters].[Parameter 7] = 2 then ( if round([Seg: 2+ years Inactive to Active (copy)]*100,2) &gt; 0 then round([Seg: 2+ years Inactive to Active (copy)]*100,2) else null end )&#10;end' />
      </column>
      <column caption='Seg: 2+ years Inactive to Inactive' datatype='integer' name='[Calculation_1645502775347011587]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [months_inactive] &gt;= 24&#10;then &#10;ifnull([Inactive Customer mom (copy)],0) - ifnull([reactivated_customers],0) &#10;else 0 &#10;end' />
      </column>
      <column caption='% Seg: 2+ years Inactive to Inactive' datatype='real' name='[Calculation_1645502775347421188]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_1645502775347011587])&#10;/&#10;sum({exclude [smaller group (to inactive) (copy 2)]: sum([Calculation_1645502775337164800])})' />
      </column>
      <column caption='DELTA NL Active Customer' datatype='integer' name='[Calculation_1645502775750270984]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Seg Active: TOTAL Loyal (copy)] - sum( If [is_loyal] = false &#10;then [Active Customers WITHOUT Acquisitions mom (copy)] &#10;end)' />
      </column>
      <column caption='Newly Churning Customers' datatype='integer' name='[Calculation_1784129168585904128]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[churning_from_acquisition] + [churning_from_retained] + [churning_from_almost_churned] + [churning_from_reactivated]' />
      </column>
      <column caption='Switch: Acq. to Active' datatype='real' name='[Calculation_1784129168857370628]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 7] = 1 then (if sum([Calculation_4582694120960806935]) &gt; 0 then sum([Calculation_4582694120960806935]) else NULL end )&#10;elseif [Parameters].[Parameter 7] = 2 then (if round([Seg: Acq. to Active (copy 3)]*100,2) &gt; 0 then round([Seg: Acq. to Active (copy 3)]*100,2) else null end )&#10;end' />
      </column>
      <column caption='Switch: Loyal Active (Non-Acq.) to Active' datatype='real' name='[Calculation_1784129168859029509]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 7] = 1 then ( if sum([Calculation_4582694120965554200]) &gt; 0 then sum([Calculation_4582694120965554200]) else null end ) &#10;elseif [Parameters].[Parameter 7] = 2 then ( if round([Seg: Loyal Active (Non-Acq.) to Active (copy 2)]*100,2) &gt; 0 then round([Seg: Loyal Active (Non-Acq.) to Active (copy 2)]*100,2) else null end ) &#10;end' />
