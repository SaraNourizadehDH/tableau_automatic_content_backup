          <datasource-dependencies datasource='federated.0vv50l01f2ptjn18mniuy0y8b090'>
            <column caption='smaller group' datatype='string' name='[Calculation_2564448168798150661]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [is_loyal] = true then &apos;true&apos;&#10;else [Lt Orders (group) (copy) (copy) (copy)]&#10;end' />
              <aliases>
                <alias key='&quot;1 LT Orders&quot;' value='1 LT Orders (Not Loyal)' />
                <alias key='&quot;2-4 LT Orders&quot;' value='2-4 LT Orders (Not Loyal)' />
                <alias key='&quot;5+ LT Orders&quot;' value='5+ LT Orders (Not Loyal)' />
                <alias key='&quot;true&quot;' value='Loyal' />
              </aliases>
            </column>
            <column caption='Seg Churning: TOTAL' datatype='integer' name='[Calculation_262827288096129028]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Seg: Acq. to Active (copy)])+sum(IFNULL([Seg: Loyal Active (Non-Acq.) to Active (copy)],0))+SUM(IFNULL([Seg: Active (non-Acq., Non-Loyal) to Active (copy)],0))+SUM(IFNULL([Seg: Loyal Churning to Active (copy)],0))+SUM(IFNULL([Seg: 2+ Churning (non-loyal) to Active (copy)],0))+SUM(IFNULL([Seg: 1 Churning (non-loyal) to Active (copy)],0))' />
            </column>
            <column caption='Boolean: Current Month' datatype='boolean' name='[Calculation_3339841340074151938]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, TODAY()) = [month_date]' />
            </column>
            <column caption='NULL ' datatype='integer' name='[Calculation_4582694122330669089]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='LOOKUP(sum([acquisitions]), -5)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Lt Orders smaller' datatype='string' name='[Lt Orders (group) (copy) (copy) (copy)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[lt_orders]' new-bin='true'>
                <bin default-name='false' value='&quot;1 LT Orders&quot;'>
                  <value>&quot;1lt&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;2+ LT Orders&quot;'>
                  <value>&quot;2-4lt&quot;</value>
                  <value>&quot;5+lt&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='Month Date (for segment migrations)' datatype='datetime' default-format='*YYYY-MM' name='[Month Date (copy 2)]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[month_date]' />
            </column>
            <column datatype='datetime' default-format='*YYYY-MM' name='[Month Date (copy)]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[month_date]' />
            </column>
            <column datatype='integer' name='[NULL  (copy) (copy)]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='LOOKUP(sum([acquisitions]), -5)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='integer' name='[NULL  (copy)]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='LOOKUP(sum([acquisitions]), -5)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Seg: 1 Churning (non-loyal) to Churning' datatype='integer' name='[Seg: 1 Churning (non-loyal) to Active (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if ([lt_orders_last_month] = &apos;1lt&apos;)&#10;and [is_loyal_at_last_months_last_order_month] = false &#10;then [churning_from_churning]&#10;else null &#10;end' />
            </column>
            <column caption='Seg: 2+ Churning (non-loyal) to Churning' datatype='integer' name='[Seg: 2+ Churning (non-loyal) to Active (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if ([lt_orders_last_month] = &apos;2-4lt&apos; or [lt_orders_last_month] = &apos;5+lt&apos;)&#10;and [is_loyal_at_last_months_last_order_month] = false &#10;then [churning_from_churning]&#10;else null &#10;end' />
            </column>
            <column caption='Seg: Acq. to Churning' datatype='integer' name='[Seg: Acq. to Active (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[churning_from_acquisition]' />
            </column>
            <column caption='Seg: Active (non-Acq., Non-Loyal) to Churning' datatype='integer' name='[Seg: Active (non-Acq., Non-Loyal) to Active (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [is_loyal_1m_ago] = false &#10;then &#10;[churning_from_retained] + &#10;[churning_from_almost_churned] +  &#10;[churning_from_reactivated]&#10;end' />
            </column>
            <column caption='Seg: Loyal Active (Non-Acq.) to Churning' datatype='integer' name='[Seg: Loyal Active (Non-Acq.) to Active (copy)]' role='measure' type='quantitative'>
