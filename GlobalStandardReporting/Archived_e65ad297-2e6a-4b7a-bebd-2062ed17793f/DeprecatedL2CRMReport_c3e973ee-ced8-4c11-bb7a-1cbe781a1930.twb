    <worksheet name='DELTA'>
      <table>
        <view>
          <datasources>
            <datasource caption='bima_tableau_mkt_active_customer_report+ (rl_mkt)' name='federated.0vv50l01f2ptjn18mniuy0y8b090' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Number' caption='Number or %' datatype='integer' name='[Parameter 7]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='Number' />
                <alias key='2' value='Percent' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0vv50l01f2ptjn18mniuy0y8b090'>
            <column caption='Active Customers WITHOUT Acquisitions mom [not aggregated]' datatype='integer' name='[Active Customers WITHOUT Acquisitions mom (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4582694120617635843] - [acquisitions_mom]' />
            </column>
            <column caption='Seg LEFT: Inactive 2+ years' datatype='integer' name='[Calculation_1645502775337164800]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='If [months_inactive] &gt;= 24&#10;then &#10;[Inactive Customer mom (copy)]&#10;end' />
            </column>
            <column caption='Seg: 2+ years Inactive to Active' datatype='integer' name='[Calculation_1645502775342997505]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [months_inactive] &gt;= 24&#10;then [reactivated_customers]&#10;else 0 &#10;end' />
            </column>
            <column caption='Seg: 2+ years Inactive to Inactive' datatype='integer' name='[Calculation_1645502775347011587]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [months_inactive] &gt;= 24&#10;then &#10;ifnull([Inactive Customer mom (copy)],0) - ifnull([reactivated_customers],0) &#10;else 0 &#10;end' />
            </column>
            <column caption='DELTA NL Active Customer' datatype='integer' name='[Calculation_1645502775750270984]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Seg Active: TOTAL Loyal (copy)] - sum( If [is_loyal] = false &#10;then [Active Customers WITHOUT Acquisitions mom (copy)] &#10;end)' />
            </column>
            <column caption='Boolean: Current Month' datatype='boolean' name='[Calculation_3339841340074151938]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, TODAY()) = [month_date]' />
            </column>
            <column caption='Active Customer mom' datatype='integer' name='[Calculation_4582694120617635843]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([retained_customers_mom], 0) + &#10;IFNULL([acquisitions_mom], 0) + &#10;IFNULL([reactivated_customers_mom], 0) +&#10;IFNULL([almost_churned_customers_mom], 0)' />
            </column>
            <column caption='Seg: Acq. to Active' datatype='integer' name='[Calculation_4582694120960806935]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='[retained_from_acquisition]' />
            </column>
            <column caption='Seg: Loyal Active (Non-Acq.) to Active' datatype='integer' name='[Calculation_4582694120965554200]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [is_loyal_1m_ago] = true &#10;then &#10;[retained_customers] - [retained_from_acquisition]&#10;end' />
            </column>
            <column caption='Seg: Active (non-Acq., Non-Loyal) to Active' datatype='integer' name='[Calculation_4582694120968650777]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [is_loyal_1m_ago] = false &#10;then &#10;[retained_from_retained] + &#10;[retained_from_almost_churned] +  &#10;[retained_from_reactivated]&#10;end' />
            </column>
            <column caption='Seg: Loyal Churning to Active' datatype='integer' name='[Calculation_4582694120973029402]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [is_loyal_at_last_months_last_order_month] = true&#10;then&#10;[almost_churned_from_churning]&#10;end' />
            </column>
            <column caption='Seg: 2+ Churning (non-loyal) to Active' datatype='integer' name='[Calculation_4582694122291761180]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if ([lt_orders_last_month] = &apos;2-4lt&apos; or [lt_orders_last_month] = &apos;5+lt&apos;)&#10;and [is_loyal_at_last_months_last_order_month] = false &#10;then [almost_churned_from_churning]&#10;else 0 &#10;end' />
            </column>
            <column caption='Seg: 1 Churning (non-loyal) to Active' datatype='integer' name='[Calculation_4582694122301276189]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if ([lt_orders_last_month] = &apos;1lt&apos;)&#10;and [is_loyal_at_last_months_last_order_month] = false &#10;then [almost_churned_from_churning]&#10;else null &#10;end' />
            </column>
            <column caption='Seg: Loyal Inactive to Active' datatype='integer' name='[Calculation_4582694122303053854]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [is_loyal_at_last_months_last_order_month] = true&#10;and [months_inactive] &lt; 24&#10;then [reactivated_customers]&#10;else 0&#10;end' />
            </column>
            <column caption='Seg: 2+ Inactive to Active' datatype='integer' name='[Calculation_4582694122303574047]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if ([lt_orders] = &apos;2-4lt&apos; or [lt_orders] = &apos;5+lt&apos;)&#10;and [is_loyal_at_last_months_last_order_month] = false &#10;and [months_inactive] &lt; 24&#10;then [reactivated_customers]&#10;else 0 &#10;end' />
            </column>
            <column caption='Seg: 1 Inactive to Active' datatype='integer' name='[Calculation_4582694122303918112]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if ([lt_orders_last_month] = &apos;1lt&apos;)&#10;and [is_loyal_at_last_months_last_order_month] = false &#10;and [months_inactive] &lt; 24&#10;then [reactivated_customers]&#10;else 0&#10;end' />
            </column>
            <column caption='NULL ' datatype='integer' name='[Calculation_4582694122330669089]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='LOOKUP(sum([acquisitions]), -5)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Seg LEFT: Churning Loyal' datatype='integer' name='[Calculation_4582694122367475748]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [is_loyal_at_last_months_last_order_month] = true &#10;then &#10;[churning_mom]&#10;end' />
            </column>
            <column caption='Seg LEFT: Inactive Loyal' datatype='integer' name='[Calculation_4582694122368450597]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [is_loyal_at_last_months_last_order_month] = true &#10;and [months_inactive] &lt; 24&#10;then &#10;[Inactive Customer mom (copy)]&#10;end' />
            </column>
            <column caption='Seg LEFT: 2+ Inactive non-loyal' datatype='integer' name='[Calculation_4582694122368663590]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [is_loyal_at_last_months_last_order_month] = false &#10;and ([lt_orders] = &apos;2-4lt&apos; or [lt_orders] = &apos;5+lt&apos;)&#10;and [months_inactive] &lt; 24&#10;then &#10;[Inactive Customer mom (copy)]&#10;end' />
            </column>
            <column caption='Seg LEFT: 1 Inactive non-loyal' datatype='integer' name='[Calculation_4582694122369179687]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [is_loyal_at_last_months_last_order_month] = false &#10;and [lt_orders] = &apos;1lt&apos;&#10;and [months_inactive] &lt; 24&#10;then &#10;[Inactive Customer mom (copy)]&#10;end' />
            </column>
            <column caption='Seg: Loyal Inactive to Inactive CORRECT' datatype='integer' name='[Calculation_86835093581987841]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// we need to be careful about the edge case inactives_mom with months_inactive = 23!!&#10;&#10;if [is_loyal_at_last_months_last_order_month] and [months_inactive] &lt; 23 &#10;then &#10;[Inactive Customer mom (copy)] - [reactivated_customers]&#10;else 0&#10;end&#10;&#10;+&#10;&#10;if [is_loyal_at_last_months_last_order_month] and [months_inactive] = 24 &#10;then &#10;[Inactive Customer (copy)]&#10;else 0 &#10;end' />
            </column>
            <column caption='DELTA Churning 2+' datatype='integer' name='[Calculation_86835093931552772]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Seg Churning: TOTAL (copy 2)] - sum([Seg LEFT: Churning Loyal (copy)])' />
            </column>
            <column caption='Switch: DELTA 2+ Churning' datatype='real' name='[Calculation_86835093931819013]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 7] = 1 then [Calculation_86835093931552772]&#10;elseif [Parameters].[Parameter 7] = 2 then round([Calculation_86835093931552772] / sum([Seg LEFT: Churning Loyal (copy)]) *100,2) &#10;end' />
            </column>
            <column caption='DELTA Churning 1' datatype='integer' name='[Calculation_86835093935771654]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Seg Churning: TOTAL 2+ (copy)] - sum([Seg LEFT: 2+ Churning non-loyal  (copy)])' />
            </column>
            <column caption='Seg Inactive TOTAL Loyal' datatype='integer' name='[Calculation_86835093940809735]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([Seg: Loyal Churning to Churning (copy)],0))&#10;+SUM(IFNULL(if [months_inactive] &lt; 24 then [Calculation_86835093581987841] end ,0))' />
            </column>
            <column caption='Seg Inactive TOTAL 2+' datatype='integer' name='[Calculation_86835093941960712]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([Seg: 2+ Churning (non-loyal) to Churning (copy)],0))&#10;+SUM(IFNULL( if [months_inactive] &lt; 24 then [Seg: 2+ Inactive to Active (copy)] end ,0))' />
            </column>
            <column caption='Seg Inactive TOTAL 1' datatype='integer' name='[Calculation_86835093942190089]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([Seg: 1 Churning (non-loyal) to Churning (copy)],0))&#10;+SUM(IFNULL(if [months_inactive] &lt; 24 then [Seg: 1 Inactive to Active (copy)] end ,0))' />
            </column>
            <column caption='Seg Inactive TOTAL 2+ years' datatype='integer' name='[Calculation_86835093942571018]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL(if [months_inactive] &gt;= 24 then [Calculation_86835093581987841] end,0))&#10;+SUM(IFNULL(if [months_inactive] &gt;= 24 then [Seg: 2+ Inactive to Active (copy)] end,0))&#10;+SUM(IFNULL(if [months_inactive] &gt;= 24 then [Seg: 1 Inactive to Active (copy)] end,0)) &#10;+SUM(IFNULL([Calculation_1645502775347011587], 0))' />
            </column>
            <column caption='DELTA Inactive Loyal' datatype='integer' name='[Calculation_86835093942997004]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_86835093940809735] - sum( [Calculation_4582694122368450597] )' />
            </column>
            <column caption='DELTA Inactive 2+' datatype='integer' name='[Calculation_86835093943140365]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_86835093941960712] -  sum([Calculation_4582694122368663590])' />
            </column>
            <column caption='DELTA Inactive 1' datatype='integer' name='[Calculation_86835093943312398]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_86835093942190089] - sum( [Calculation_4582694122369179687] )' />
            </column>
            <column caption='DELTA Inactive 2+ years' datatype='integer' name='[Calculation_86835093943422991]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_86835093942571018] - sum( [Calculation_1645502775337164800] )' />
            </column>
            <column caption='Switch: DELTA Loyal Inactive' datatype='real' name='[Calculation_86835093950496784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 7] = 1 then [Calculation_86835093942997004]&#10;elseif [Parameters].[Parameter 7] = 2 then round([Calculation_86835093942997004] / sum([Calculation_4582694122368450597]) *100,2) &#10;end' />
            </column>
            <column caption='Switch: DELTA 2+ Inactive' datatype='real' name='[Calculation_86835093952061457]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 7] = 1 then [Calculation_86835093943140365]&#10;elseif [Parameters].[Parameter 7] = 2 then round([Calculation_86835093943140365] / sum([Calculation_4582694122368663590]) *100,2) &#10;end' />
            </column>
            <column caption='DELTA Churning Loyal' datatype='integer' name='[DELTA NL Active Customer (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Seg Churning: TOTAL (copy)] - sum( If [is_loyal_at_last_months_last_order_month]&#10;then [churning_mom] &#10;end)' />
            </column>
            <column caption='Inactive Customer (NO Churn)' datatype='integer' name='[Inactive Customer (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([new_inactive_customers], 0) + &#10;IFNULL([old_inactive_customers_6m], 0) + &#10;IFNULL([old_inactive_customers], 0)' />
            </column>
            <column caption='Inactive Customer (NO Churn) mom' datatype='integer' name='[Inactive Customer mom (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([new_inactive_customers_mom], 0) + &#10;IFNULL([old_inactive_customers_6m_mom], 0) + &#10;IFNULL([old_inactive_customers_mom], 0)' />
            </column>
            <column caption='Month Date (for segment migrations)' datatype='datetime' default-format='*YYYY-MM' name='[Month Date (copy 2)]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[month_date]' />
            </column>
            <column datatype='datetime' default-format='*YYYY-MM' name='[Month Date (copy)]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[month_date]' />
            </column>
            <column datatype='integer' hidden='true' name='[NULL  (copy 5)]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='LOOKUP(sum([acquisitions]), -5)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Seg Active: TOTAL Loyal' datatype='integer' name='[Seg Active: TOTAL (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IFNULL(if [is_loyal] then [Calculation_4582694120960806935] end , 0)) &#10;+ SUM(IFNULL(if [is_loyal] then [Calculation_4582694120965554200] end,0))&#10;+ SUM(IFNULL(if [is_loyal] then [Calculation_4582694120968650777] end,0))&#10;+SUM(IFNULL(if [is_loyal] then [Calculation_4582694120973029402] end,0))&#10;+SUM(IFNULL(if [is_loyal] then [Calculation_4582694122291761180] end,0))&#10;+SUM(IFNULL(if [is_loyal] then [Calculation_4582694122301276189] end,0))&#10;+SUM(IFNULL(if [is_loyal] then [Calculation_4582694122303053854] end,0))&#10;+SUM(IFNULL(if [is_loyal] then [Calculation_4582694122303574047] end,0))&#10;+SUM(IFNULL(if [is_loyal] then [Calculation_4582694122303918112] end,0))&#10;+ sum(IFNULL(if [is_loyal] then [Calculation_1645502775342997505] end,0))' />
            </column>
            <column caption='Seg Active: TOTAL NL' datatype='integer' name='[Seg Active: TOTAL Loyal (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IFNULL(if [is_loyal] = false then [Calculation_4582694120960806935] end , 0)) &#10;+ SUM(IFNULL(if [is_loyal] = false then [Calculation_4582694120965554200] end,0))&#10;+ SUM(IFNULL(if [is_loyal] = false then [Calculation_4582694120968650777] end,0))&#10;+SUM(IFNULL(if [is_loyal] = false then [Calculation_4582694120973029402] end,0))&#10;+SUM(IFNULL(if [is_loyal] = false then [Calculation_4582694122291761180] end,0))&#10;+SUM(IFNULL(if [is_loyal] = false then [Calculation_4582694122301276189] end,0))&#10;+SUM(IFNULL(if [is_loyal] = false then [Calculation_4582694122303053854] end,0))&#10;+SUM(IFNULL(if [is_loyal] = false then [Calculation_4582694122303574047] end,0))&#10;+SUM(IFNULL(if [is_loyal] = false then [Calculation_4582694122303918112] end,0))&#10;+ sum(IFNULL(if [is_loyal] = false then [Calculation_1645502775342997505] end,0))' />
            </column>
            <column caption='Seg Churning: TOTAL 2+' datatype='integer' name='[Seg Churning: TOTAL (copy 2)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum( if ([lt_orders] = &apos;2-4lt&apos; or [lt_orders] = &apos;5+lt&apos;) then [Seg: Acq. to Active (copy)] else 0 end )&#10;//+sum(IFNULL([Seg: Loyal Active (Non-Acq.) to Churning],0))&#10;+SUM(IFNULL(if ([lt_orders] = &apos;2-4lt&apos; or [lt_orders] = &apos;5+lt&apos;) then [Seg: Active (non-Acq., Non-Loyal) to Active (copy)] end,0))&#10;//+SUM(IFNULL([Seg: Loyal Churning to Churning],0))&#10;+SUM(IFNULL([Seg: 2+ Churning (non-loyal) to Active (copy)],0))&#10;//+SUM(IFNULL([Seg: 1 Churning (non-loyal) to Churning],0))' />
            </column>
            <column caption='Seg Churning: TOTAL Loyal' datatype='integer' name='[Seg Churning: TOTAL (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//sum([Seg: Acq. to Churning]) impossible by definition+&#10;sum(IFNULL([Seg: Loyal Active (Non-Acq.) to Active (copy)],0))&#10;//+SUM(IFNULL([Seg: Active (non-Acq., Non-Loyal) to Churning],0))&#10;+SUM(IFNULL([Seg: Loyal Churning to Active (copy)] ,0))&#10;//+SUM(IFNULL([Seg: 2+ Churning (non-loyal) to Churning],0))&#10;//+SUM(IFNULL([Seg: 1 Churning (non-loyal) to Churning],0))' />
            </column>
            <column caption='Seg Churning: TOTAL 1' datatype='integer' name='[Seg Churning: TOTAL 2+ (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum( if [lt_orders] = &apos;1lt&apos; then [Seg: Acq. to Active (copy)] else 0 end )&#10;//+sum(IFNULL(if [smaller group (to churning)] = &apos;1 NL&apos; then [Seg: Loyal Active (Non-Acq.) to Churning]end ,0))&#10;+SUM(IFNULL(if [lt_orders] = &apos;1lt&apos; then [Seg: Active (non-Acq., Non-Loyal) to Active (copy)] end,0))&#10;//+SUM(IFNULL([Seg: Loyal Churning to Churning],0))&#10;//+SUM(IFNULL([Seg: 2+ Churning (non-loyal) to Churning],0))&#10;+SUM(IFNULL([Seg: 1 Churning (non-loyal) to Active (copy)],0))' />
            </column>
            <column caption='Seg LEFT: 1 Churning non-loyal' datatype='integer' name='[Seg LEFT: 2+ Churning non-loyal  (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [is_loyal_at_last_months_last_order_month] = false &#10;and [lt_orders] = &apos;1lt&apos;&#10;then &#10;[churning_mom]&#10;end' />
            </column>
            <column caption='Seg LEFT: 2+ Churning non-loyal ' datatype='integer' name='[Seg LEFT: Churning Loyal (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [is_loyal_at_last_months_last_order_month] = false &#10;and ([lt_orders] = &apos;2-4lt&apos; or [lt_orders] = &apos;5+lt&apos;)&#10;then &#10;[churning_mom]&#10;end' />
            </column>
            <column caption='DELTA Loyal Active Customer' datatype='integer' name='[Seg LEFT: Loyal Active Customer NO ACQ (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Seg Active: TOTAL (copy)] - sum( If [is_loyal] = true &#10;then [Active Customers WITHOUT Acquisitions mom (copy)] &#10;end)' />
            </column>
            <column caption='Seg: 1 Churning (non-loyal) to Churning' datatype='integer' name='[Seg: 1 Churning (non-loyal) to Active (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if ([lt_orders_last_month] = &apos;1lt&apos;)&#10;and [is_loyal_at_last_months_last_order_month] = false &#10;then [churning_from_churning]&#10;else null &#10;end' />
            </column>
            <column caption='Seg: 1 Churning (non-loyal) to Inactive' datatype='integer' name='[Seg: 1 Churning (non-loyal) to Churning (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if ([lt_orders_last_month] = &apos;1lt&apos;)&#10;and [is_loyal_at_last_months_last_order_month] = false&#10;then [new_inactive_customers]&#10;else null &#10;end' />
            </column>
            <column caption='Seg: 1 Inactive to Inactive' datatype='integer' name='[Seg: 1 Inactive to Active (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if ([lt_orders] = &apos;1lt&apos;)&#10;and [is_loyal_at_last_months_last_order_month] = false &#10;and [months_inactive] &lt; 23 &#10;then [Inactive Customer mom (copy)] - [reactivated_customers]&#10;else 0 &#10;end&#10;+ &#10;if ([lt_orders] = &apos;1lt&apos;)&#10;and [is_loyal_at_last_months_last_order_month] = false &#10;and [months_inactive] = 24 &#10;then [Inactive Customer (copy)] &#10;else 0 &#10;end' />
            </column>
            <column caption='Seg: 2+ Churning (non-loyal) to Churning' datatype='integer' name='[Seg: 2+ Churning (non-loyal) to Active (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if ([lt_orders_last_month] = &apos;2-4lt&apos; or [lt_orders_last_month] = &apos;5+lt&apos;)&#10;and [is_loyal_at_last_months_last_order_month] = false &#10;then [churning_from_churning]&#10;else null &#10;end' />
            </column>
            <column caption='Seg: 2+ Churning (non-loyal) to Inactive' datatype='integer' name='[Seg: 2+ Churning (non-loyal) to Churning (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if ([lt_orders_last_month] = &apos;2-4lt&apos; or [lt_orders_last_month] = &apos;5+lt&apos;)&#10;and [is_loyal_at_last_months_last_order_month] = false &#10;then [new_inactive_customers]&#10;else null &#10;end' />
            </column>
            <column caption='Seg: 2+ Inactive to Inactive' datatype='integer' name='[Seg: 2+ Inactive to Active (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if ([lt_orders] = &apos;2-4lt&apos; or [lt_orders] = &apos;5+lt&apos;)&#10;and [is_loyal_at_last_months_last_order_month] = false &#10;and [months_inactive] &lt; 23 &#10;then&#10;[Inactive Customer mom (copy)] - [reactivated_customers]&#10;else 0 &#10;end &#10;+ &#10;if ([lt_orders] = &apos;2-4lt&apos; or [lt_orders] = &apos;5+lt&apos;)&#10;and [is_loyal_at_last_months_last_order_month] = false &#10;and [months_inactive] = 24 &#10;then&#10;[Inactive Customer (copy)]&#10;else 0 &#10;end' />
            </column>
            <column caption='Seg: Acq. to Churning' datatype='integer' name='[Seg: Acq. to Active (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[churning_from_acquisition]' />
            </column>
            <column caption='Seg: Active (non-Acq., Non-Loyal) to Churning' datatype='integer' name='[Seg: Active (non-Acq., Non-Loyal) to Active (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [is_loyal_1m_ago] = false &#10;then &#10;[churning_from_retained] + &#10;[churning_from_almost_churned] +  &#10;[churning_from_reactivated]&#10;end' />
            </column>
            <column caption='Seg: Loyal Active (Non-Acq.) to Churning' datatype='integer' name='[Seg: Loyal Active (Non-Acq.) to Active (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [is_loyal_1m_ago] = true &#10;then &#10;[churning_from_almost_churned] + &#10;[churning_from_reactivated] +  &#10;[churning_from_retained]&#10;end' />
            </column>
            <column caption='Seg: Loyal Churning to Churning' datatype='integer' name='[Seg: Loyal Churning to Active (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [is_loyal_at_last_months_last_order_month] = true &#10;then&#10;[churning_from_churning]&#10;end' />
            </column>
            <column caption='Seg: Loyal Churning to Inactive' datatype='integer' name='[Seg: Loyal Churning to Churning (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [is_loyal_at_last_months_last_order_month] = true &#10;then&#10;[new_inactive_customers]&#10;end' />
            </column>
            <column caption='Switch: DELTA Loyal Active Customer' datatype='real' name='[Switch: 1 Churning (non-loyal) to Active (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 7] = 1 then [Seg LEFT: Loyal Active Customer NO ACQ (copy)]&#10;elseif [Parameters].[Parameter 7] = 2 then round([Seg LEFT: Loyal Active Customer NO ACQ (copy)] / (sum( if [is_loyal] then [Calculation_4582694120617635843]end )) *100,2) &#10;end' />
            </column>
            <column caption='Switch: DELTA 1 Churning' datatype='real' name='[Switch: DELTA 2+ Churning (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 7] = 1 then [Calculation_86835093935771654]&#10;elseif [Parameters].[Parameter 7] = 2 then round([Calculation_86835093935771654] / sum([Seg LEFT: 2+ Churning non-loyal  (copy)]) *100,2) &#10;end' />
            </column>
            <column caption='Switch: DELTA 2+ years Inactive' datatype='real' name='[Switch: DELTA 2+ Inactive (copy 2)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 7] = 1 then [Calculation_86835093943422991]&#10;elseif [Parameters].[Parameter 7] = 2 then round([Calculation_86835093943422991] / sum([Calculation_1645502775337164800]) *100,2) &#10;end' />
            </column>
            <column caption='Switch: DELTA 1 Inactive' datatype='real' name='[Switch: DELTA 2+ Inactive (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 7] = 1 then [Calculation_86835093943312398]&#10;elseif [Parameters].[Parameter 7] = 2 then round([Calculation_86835093943312398] / sum([Calculation_4582694122369179687]) *100,2) &#10;end' />
            </column>
            <column caption='Switch: DELTA NL Active Customer' datatype='real' name='[Switch: DELTA Loyal Active Customer (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 7] = 1 then [Calculation_1645502775750270984]&#10;elseif [Parameters].[Parameter 7] = 2 then round([Calculation_1645502775750270984] / (sum( if [is_loyal] = false then [Calculation_4582694120617635843]end )) *100,2) &#10;end' />
            </column>
            <column caption='Switch: DELTA Loyal Churning' datatype='real' name='[Switch: DELTA NL Active Customer (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 7] = 1 then [DELTA NL Active Customer (copy)]&#10;elseif [Parameters].[Parameter 7] = 2 then round([DELTA NL Active Customer (copy)] / sum( [Calculation_4582694122367475748]) *100,2) &#10;end' />
            </column>
