                  <formatted-text>
                    <run bold='true' fontname='Tableau Bold' fontsize='8'>*</run>
                    <run fontsize='8'> Customer Base is that the number of customers who ever </run>
                    <run bold='true' fontsize='8'>place order</run>
                    <run fontsize='8'>Æ </run>
                    <run bold='true' fontsize='8' underline='true'>for whole period</run>
