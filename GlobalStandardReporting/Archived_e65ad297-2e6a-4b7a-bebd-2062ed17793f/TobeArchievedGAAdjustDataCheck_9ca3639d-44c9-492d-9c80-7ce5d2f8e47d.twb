      <aliases enabled='yes' />
      <column datatype='string' name='[Backend Platform (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[backend_platform]' new-bin='true'>
          <bin default-name='false' value='&quot;other&quot;'>
            <value>&quot;other&quot;</value>
            <value>&quot;others&quot;</value>
          </bin>
        </calculation>
      </column>
      <column caption='% Orders Tracked' datatype='real' name='[Calculation_4246261198488301568]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_api])/SUM([orders_backend])' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_5280329892548763648]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Username Entitlement Filter' datatype='boolean' hidden='true' name='[Calculation_604678680690720768]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='USERNAME()=[username]' />
      </column>
      <column caption='Date View' datatype='date' default-format='*yyyy-mm-dd' name='[Calculation_727331388575903745]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE( &#13;&#10;IF [Parameters].[Parameter 1 1] = &quot;Daily&quot; THEN [order_date]&#13;&#10;ELSEIF [Parameters].[Parameter 1 1] = &quot;Weekly&quot; THEN DATETRUNC(&apos;week&apos;,[order_date],&apos;monday&apos;)&#13;&#10;ELSEIF [Parameters].[Parameter 1 1] = &quot;Monthly&quot; THEN DATETRUNC(&apos;month&apos;,[order_date],&apos;monday&apos;)&#13;&#10;END&#13;&#10;)' />
      </column>
