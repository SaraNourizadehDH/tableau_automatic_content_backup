    <worksheet name='Duplicates Table'>
      <table>
        <view>
          <datasources>
            <datasource caption='2: bima_tableau_ga_data_check_duplicates_final+ (rl_mkt)' name='federated.1oznh4k1pz3413199yfti0au5l8x' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Date View' datatype='string' name='[Parameter 1 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1oznh4k1pz3413199yfti0au5l8x'>
            <column caption='% Duplicates' datatype='real' name='[Calculation_6885511254168289281]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([orders_ga])/SUM([orders_backend]))-1' />
            </column>
            <column caption='Date View' datatype='date' default-format='*yyyy-mm-dd' name='[Calculation_727331388575903745]' role='dimension' type='ordinal'>
