      <column caption='Sub Channel Alarm Cost' datatype='string' name='[Country Alarm Cost (copy)_1269733626621595661]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ATTR([sub_channel]) = &quot;acquisition&quot; THEN&#13;&#10;    CASE [Parameters].[Parameter 5]&#13;&#10;        WHEN &quot;Weekly&quot; THEN&#13;&#10;            IF [Calculation2] &gt; 0.20 THEN &quot;Alarm&quot;&#13;&#10;            ELSEIF [Calculation2] &lt; -0.15 THEN &quot;Alarm&quot;&#13;&#10;            ELSE &quot;No Alarm&quot;&#13;&#10;            END&#13;&#10;        WHEN &quot;Daily&quot; THEN&#13;&#10;            IF [Calculation2] &gt; 0.25 THEN &quot;Alarm&quot;&#13;&#10;            ELSEIF [Calculation2] &lt; -0.20 THEN &quot;Alarm&quot;&#13;&#10;            ELSE &quot;No Alarm&quot;&#13;&#10;            END&#13;&#10;    END&#13;&#10;&#13;&#10;ELSEIF ATTR([sub_channel]) = &quot;activation&quot; THEN&#13;&#10;    CASE [Parameters].[Parameter 5]&#13;&#10;        WHEN &quot;Weekly&quot; THEN&#13;&#10;            IF [Calculation2] &gt; 0.40 THEN &quot;Alarm&quot;&#13;&#10;            ELSEIF [Calculation2] &lt; -0.25 THEN &quot;Alarm&quot;&#13;&#10;            ELSE &quot;No Alarm&quot;&#13;&#10;            END&#13;&#10;        WHEN &quot;Daily&quot; THEN&#13;&#10;            IF [Calculation2] &gt; 0.25 THEN &quot;Alarm&quot;&#13;&#10;            ELSEIF [Calculation2] &lt; -0.20 THEN &quot;Alarm&quot;&#13;&#10;            ELSE &quot;No Alarm&quot;&#13;&#10;            END&#13;&#10;    END&#13;&#10;&#13;&#10;ELSEIF ATTR([sub_channel]) = &quot;brand_protection&quot; THEN&#13;&#10;    CASE [Parameters].[Parameter 5]&#13;&#10;        WHEN &quot;Weekly&quot; THEN&#13;&#10;            IF [Calculation2] &gt; 0.40 THEN &quot;Alarm&quot;&#13;&#10;            ELSEIF [Calculation2] &lt; -0.20 THEN &quot;Alarm&quot;&#13;&#10;            ELSE &quot;No Alarm&quot;&#13;&#10;            END&#13;&#10;        WHEN &quot;Daily&quot; THEN&#13;&#10;            IF [Calculation2] &gt; 0.40 THEN &quot;Alarm&quot;&#13;&#10;            ELSEIF [Calculation2] &lt; -0.40 THEN &quot;Alarm&quot;&#13;&#10;            ELSE &quot;No Alarm&quot;&#13;&#10;            END&#13;&#10;    END&#13;&#10;&#13;&#10;ELSEIF ATTR([sub_channel]) = &quot;consideration&quot; THEN&#13;&#10;    CASE [Parameters].[Parameter 5]&#13;&#10;        WHEN &quot;Weekly&quot; THEN&#13;&#10;            IF [Calculation2] &gt; 0.50 THEN &quot;Alarm&quot;&#13;&#10;            ELSEIF [Calculation2] &lt; -0.45 THEN &quot;Alarm&quot;&#13;&#10;            ELSE &quot;No Alarm&quot;&#13;&#10;            END&#13;&#10;        WHEN &quot;Daily&quot; THEN&#13;&#10;            IF [Calculation2] &gt; 0.50 THEN &quot;Alarm&quot;&#13;&#10;            ELSEIF [Calculation2] &lt; -0.50 THEN &quot;Alarm&quot;&#13;&#10;            ELSE &quot;No Alarm&quot;&#13;&#10;            END&#13;&#10;    END&#13;&#10;&#13;&#10;ELSEIF ATTR([sub_channel]) = &quot;non_brand&quot; THEN&#13;&#10;    CASE [Parameters].[Parameter 5]&#13;&#10;        WHEN &quot;Weekly&quot; THEN&#13;&#10;            IF [Calculation2] &gt; 0.30 THEN &quot;Alarm&quot;&#13;&#10;            ELSEIF [Calculation2] &lt; -0.30 THEN &quot;Alarm&quot;&#13;&#10;            ELSE &quot;No Alarm&quot;&#13;&#10;            END&#13;&#10;        WHEN &quot;Daily&quot; THEN&#13;&#10;            IF [Calculation2] &gt; 0.40 THEN &quot;Alarm&quot;&#13;&#10;            ELSEIF [Calculation2] &lt; -0.40 THEN &quot;Alarm&quot;&#13;&#10;            ELSE &quot;No Alarm&quot;&#13;&#10;            END&#13;&#10;    END&#13;&#10;&#13;&#10;ELSEIF ATTR([sub_channel]) = &quot;reactivation&quot; THEN&#13;&#10;    CASE [Parameters].[Parameter 5]&#13;&#10;        WHEN &quot;Weekly&quot; THEN&#13;&#10;            IF [Calculation2] &gt; 0.60 THEN &quot;Alarm&quot;&#13;&#10;            ELSEIF [Calculation2] &lt; -0.40 THEN &quot;Alarm&quot;&#13;&#10;            ELSE &quot;No Alarm&quot;&#13;&#10;            END&#13;&#10;        WHEN &quot;Daily&quot; THEN&#13;&#10;            IF [Calculation2] &gt; 0.50 THEN &quot;Alarm&quot;&#13;&#10;            ELSEIF [Calculation2] &lt; -0.50 THEN &quot;Alarm&quot;&#13;&#10;            ELSE &quot;No Alarm&quot;&#13;&#10;            END&#13;&#10;    END&#13;&#10;&#13;&#10;ELSEIF ATTR([sub_channel]) = &quot;reengagement&quot; THEN&#13;&#10;    CASE [Parameters].[Parameter 5]&#13;&#10;        WHEN &quot;Weekly&quot; THEN&#13;&#10;            IF [Calculation2] &gt; 0.40 THEN &quot;Alarm&quot;&#13;&#10;            ELSEIF [Calculation2] &lt; -0.30 THEN &quot;Alarm&quot;&#13;&#10;            ELSE &quot;No Alarm&quot;&#13;&#10;            END&#13;&#10;        WHEN &quot;Daily&quot; THEN&#13;&#10;            IF [Calculation2] &gt; 0.50 THEN &quot;Alarm&quot;&#13;&#10;            ELSEIF [Calculation2] &lt; -0.50 THEN &quot;Alarm&quot;&#13;&#10;            ELSE &quot;No Alarm&quot;&#13;&#10;            END&#13;&#10;    END&#13;&#10;END'>
