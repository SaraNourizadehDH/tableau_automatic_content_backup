          <filter class='categorical' column='[sqlproxy.0356uoq1lwylun1baswyc0cv3nd9].[none:Time Range Selector Group (copy)_580401437412540418:nk]'>
            <groupfilter function='member' level='[none:Time Range Selector Group (copy)_580401437412540418:nk]' member='&quot;2.Current&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[sqlproxy.0356uoq1lwylun1baswyc0cv3nd9].[none:sub_channel:nk]'>
            <groupfilter function='member' level='[none:sub_channel:nk]' member='&quot;acquisition&quot;' user:ui-domain='cascading' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[sqlproxy.0356uoq1lwylun1baswyc0cv3nd9].[sub_channel Set 2]' />
          <slices>
            <column>[sqlproxy.0356uoq1lwylun1baswyc0cv3nd9].[none:Time Range Selector Group (copy)_580401437412540418:nk]</column>
            <column>[sqlproxy.0356uoq1lwylun1baswyc0cv3nd9].[Glovo Region Set]</column>
