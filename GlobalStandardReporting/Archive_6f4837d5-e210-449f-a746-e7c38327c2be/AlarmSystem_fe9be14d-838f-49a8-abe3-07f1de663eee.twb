            </column-instance>
            <column-instance column='[Calculation_1269733626615009286]' derivation='User' name='[usr:Calculation_1269733626615009286:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2047167540703764525]' derivation='User' name='[usr:Calculation_2047167540703764525:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Cost By Country Alarm Line (copy)_1269733626618486794]' derivation='User' name='[usr:Cost By Country Alarm Line (copy)_1269733626618486794:qk]' pivot='key' type='quantitative' />
