      <column caption='Semester of Date' datatype='string' name='[Quarter of Date (copy)_17381123652599813]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(YEAR([date])) + &quot;S&quot; + &#10;IF MONTH([date]) &lt;= 6 THEN &#10;    &quot;1&quot; &#10;ELSE &#10;    &quot;2&quot; &#10;END' />
