  IF [Calculation2] &gt; 0.30 THEN &quot;Alarm&quot;&#13;&#10;            ELSEIF [Calculation2] &lt; -0.35 THEN &quot;Alarm&quot;&#13;&#10;            ELSE &quot;No Alarm&quot;&#13;&#10;            END&#13;&#10;    END&#13;&#10;&#13;&#10;ELSEIF ATTR([Calculation_2001005655449128961]) = &quot;Poland&quot; THEN&#13;&#10;    CASE [Parameters].[Parameter 5]&#13;&#10;        WHEN &quot;Weekly&quot; THEN&#13;&#10;            IF [Calculation2] &gt; 0.30 THEN &quot;Alarm&quot;&#13;&#10;            ELSEIF [Calculation2] &lt; -0.20 THEN &quot;Alarm&quot;&#13;&#10;            ELSE &quot;No Alarm&quot;&#13;&#10;            END&#13;&#10;        WHEN &quot;Daily&quot; THEN&#13;&#10;            IF [Calculation2] &gt; 0.30 THEN &quot;Alarm&quot;&#13;&#10;            ELSEIF [Calculation2] &lt; -0.35 THEN &quot;Alarm&quot;&#13;&#10;            ELSE &quot;No Alarm&quot;&#13;&#10;            END&#13;&#10;    END&#13;&#10;&#13;&#10;ELSEIF ATTR([Calculation_2001005655449128961]) = &quot;Romania&quot; THEN&#13;&#10;    CASE [Parameters].[Parameter 5]&#13;&#10;        WHEN &quot;Weekly&quot; THEN&#13;&#10;            IF [Calculation2] &gt; 0.20 THEN &quot;Alarm&quot;&#13;&#10;            ELSEIF [Calculation2] &lt; -0.20 THEN &quot;Alarm&quot;&#13;&#10;            ELSE &quot;No Alarm&quot;&#13;&#10;            END&#13;&#10;        WHEN &quot;Daily&quot; THEN&#13;&#10;            IF [Calculation2] &gt; 0.30 THEN &quot;Alarm&quot;&#13;&#10;            ELSEIF [Calculation2] &lt; -0.20 THEN &quot;Alarm&quot;&#13;&#10;            ELSE &quot;No Alarm&quot;&#13;&#10;            END&#13;&#10;    END&#13;&#10;&#13;&#10;ELSEIF ATTR([Calculation_2001005655449128961]) = &quot;Serbia&quot; THEN&#13;&#10;    CASE [Parameters].[Parameter 5]&#13;&#10;        WHEN &quot;Weekly&quot; THEN&#13;&#10;            IF [Calculation2] &gt; 0.40 THEN &quot;Alarm&quot;&#13;&#10;            ELSEIF [Calculation2] &lt; -0.25 THEN &quot;Alarm&quot;&#13;&#10;            ELSE &quot;No Alarm&quot;&#13;&#10;            END&#1