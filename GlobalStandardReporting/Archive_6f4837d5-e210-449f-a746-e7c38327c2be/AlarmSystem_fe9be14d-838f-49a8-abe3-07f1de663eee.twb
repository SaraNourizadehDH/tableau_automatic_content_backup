&quot;Alarm&quot;&#13;&#10;            ELSE &quot;No Alarm&quot;&#13;&#10;            END&#13;&#10;        WHEN &quot;Daily&quot; THEN&#13;&#10;            IF abs([%PP Installs (copy)_1269733626601922563]) &gt; 0.35 THEN &quot;Alarm&quot;&#13;&#10;            ELSE &quot;No Alarm&quot;&#13;&#10;            END&#13;&#10;    END&#13;&#10;&#13;&#10;ELSEIF ATTR([network]) = &quot;ironsource&quot; THEN&#13;&#10;    CASE [Parameters].[Parameter 5]&#13;&#10;        WHEN &quot;Weekly&quot; THEN&#13;&#10;            IF abs([%PP Installs (copy)_1269733626601922563]) &gt; 0.15 THEN &quot;Alarm&quot;&#13;&#10;            ELSE &quot;No Alarm&quot;&#13;&#10;            END&#13;&#10;        WHEN &quot;Daily&quot; THEN&#13;&#10;            IF abs([%PP Installs (copy)_1269733626601922563]) &gt; 0.60 THEN &quot;Alarm&quot;&#13;&#10;            ELSE &quot;No Alarm&quot;&#13;&#10;            END&#13;&#10;    END&#13;&#10;&#13;&#10;ELSEIF ATTR([network]) = &quot;snapchat&quot; THEN&#13;&#10;    CASE [Parameters].[Parameter 5]&#13;&#10;        WHEN &quot;Weekly&quot; THEN&#13;&#10;            IF abs([%PP Installs (copy)_1269733626601922563]) &gt; 0.40 THEN &quot;Alarm&quot;&#13;&#10;            ELSE &quot;No Alarm&quot;&#13;&#10;            END&#13;&#10;        WHEN &quot;Daily&quot; THEN&#13;&#10;            IF abs([%PP Installs (copy)_1269733626601922563]) &gt; 0.50 THEN &quot;Alarm&quot;&#13;&#10;            ELSE &quot;No Alarm&quot;&#13;&#10;            END&#13;&#10;    END&#13;&#10;&#13;&#10;ELSEIF ATTR([network]) = &quot;tiktok&quot; THEN&#13;&#10;    CASE [Parameters].[Parameter 5]&#13;&#10;        WHEN &quot;Weekly&quot; THEN&#13;&#10;            IF abs([%PP Installs (copy)_1269733626601922563]) &gt; 0.30 THEN &quot;Alarm&quot;&#13;&#10;            ELSE &quot;No Alarm&quot;&#13;&#10;            END&#13;&#10;        WHEN &quot;Daily&quot; THEN&#13;&#10;            IF abs([%PP Installs (copy)_1269733626601922563]) &gt; 0.40 THEN &quot;Alarm&quot;&#13;&#10;            ELSE &quot;No Alarm&quot;&#13;&#10;            END&#13;&#10;    END&#13;&#10;&#13;&#10;END'>
