    <worksheet name='Installs by OS'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/AlarmSystem/InstallsbyOS?rev=' id='229255' path='/t/GlobalStandardReporting/workbooks/AlarmSystem' revision='' site='GlobalStandardReporting' />
      <layout-options>
        <title>
          <formatted-text>
            <run>&lt;Sheet Name&gt;:</run>
            <run bold='true' fontcolor='#1b1b1b'><![CDATA[<[sqlproxy.0356uoq1lwylun1baswyc0cv3nd9].[none:os_name:nk]>]]></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='master_attribution (trimmed)' name='sqlproxy.0356uoq1lwylun1baswyc0cv3nd9' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Time Range Selector' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Last 90 days&quot;'>
              <calculation class='tableau' formula='&quot;Last 90 days&quot;' />
            </column>
            <column caption='Date Granularity Selector' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
            <column caption='Start Date' datatype='date' name='[Parameter 8]' param-domain-type='any' role='measure' type='quantitative' value='#2024-07-29#'>
              <calculation class='tableau' formula='#2024-07-29#' />
            </column>
            <column caption='End Date' datatype='date' name='[Parameter 9]' param-domain-type='any' role='measure' type='quantitative' value='#2024-11-04#'>
              <calculation class='tableau' formula='#2024-11-04#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.0356uoq1lwylun1baswyc0cv3nd9'>
            <column caption='%PP Installs' datatype='real' default-format='p0.00%' name='[%PP Cost (copy)_1269733626601771010]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN([Calculation_2047167540703465516]) - LOOKUP(ZN([Calculation_2047167540703465516]), -1)) / ABS(LOOKUP(ZN([Calculation_2047167540703465516]), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Quarter of Date' datatype='string' name='[Actual Month? (copy)_2047167540625985548]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(YEAR([date])) + &quot;Q&quot; + DATENAME(&apos;quarter&apos;,[date])' />
            </column>
            <column caption='Last Month' datatype='string' name='[Calculation_171699771262914561]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;DATETRUNC(&apos;month&apos;,[date])=DATETRUNC(&apos;month&apos;,dateadd(&apos;month&apos;,-1,TODAY()-1))THEN &apos;2.Current&apos; &#13;&#10;ELSEIF DATETRUNC(&apos;month&apos;,[date])=DATETRUNC(&apos;month&apos;,dateadd(&apos;month&apos;,-2,TODAY()-1))&#13;&#10;THEN &apos;1.Previous&apos; END' />
            </column>
            <column caption='MTD' datatype='string' name='[Calculation_171699771263401986]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF MONTH([date]) = MONTH(TODAY()-1) and YEAR([date]) = YEAR(TODAY()) and [date] &lt;= TODAY() Then &apos;2.Current&apos;&#13;&#10;ELSEIF DATEDIFF(&apos;month&apos;, [date],TODAY()-1) = 1 and DAY([date]) &lt;= DAY(TODAY()-1) then &apos;1.Previous&apos;&#13;&#10;END' />
            </column>
            <column caption='Last Week Completed' datatype='string' name='[Calculation_171699771263967235]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;DATETRUNC(&apos;week&apos;,[date])=DATETRUNC(&apos;week&apos;,dateadd(&apos;week&apos;,-1,TODAY()))THEN &apos;2.Current&apos; &#13;&#10;ELSEIF DATETRUNC(&apos;week&apos;,[date])=DATETRUNC(&apos;week&apos;,dateadd(&apos;week&apos;,-2,TODAY()))&#13;&#10;THEN &apos;1.Previous&apos; END' />
            </column>
            <column caption='Date Granularity Selector' datatype='string' name='[Calculation_1836905733738844164]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 5] when &apos;Daily&apos; then STR(MONTH([date])) + &quot;-&quot; + str((STR(DAY([date]))))   &#13;&#10;when &apos;Weekly&apos; then [Quarter of Date (copy)_2047167540626092045]&#13;&#10;when &apos;Month&apos; then  [Week of Date (copy)_2047167540626223118]&#13;&#10;when &apos;Quarter&apos; then [Actual Month? (copy)_2047167540625985548]&#13;&#10;when &apos;Year&apos; then str((STR(YEAR([date]))))   &#13;&#10;END' />
            </column>
            <column caption='Current Start' datatype='datetime' name='[Calculation_1981020938831675393]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEADD(&quot;day&quot;,-0,[Parameters].[Parameter 8])' />
            </column>
            <column caption='Last 7 Days' datatype='string' name='[Calculation_2047167540612460544]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATEDIFF(&apos;day&apos;,[date],TODAY()) &gt;= 1 and DATEDIFF(&apos;day&apos;, [date], TODAY()) &lt;= 7 Then &apos;2.Current&apos;&#13;&#10;ELSEIF DATEDIFF(&apos;day&apos;,[date],TODAY()) &gt;= 8 and DATEDIFF(&apos;day&apos;, [date], TODAY()) &lt; 15 then &apos;1.Previous&apos;&#13;&#10;END' />
            </column>
            <column caption='Installs' datatype='real' name='[Calculation_2047167540703465516]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_installs])' />
            </column>
            <column caption='Current End' datatype='datetime' name='[Current Start (copy)_1981020938831757314]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEADD(&quot;day&quot;,-0,[Parameters].[Parameter 9])' />
            </column>
            <column caption='Installs By OS line Lower' datatype='real' name='[Installs By OS line upper (copy)_1269733626637910044]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([os_name]) = &quot;ios&quot; THEN&#13;&#10;    CASE [Parameters].[Parameter 5]&#13;&#10;        WHEN &quot;Weekly&quot; THEN -0.10&#13;&#10;        WHEN &quot;Daily&quot; THEN -0.30&#13;&#10;    END&#13;&#10;&#13;&#10;ELSEIF ATTR([os_name]) = &quot;android&quot; THEN&#13;&#10;    CASE [Parameters].[Parameter 5]&#13;&#10;        WHEN &quot;Weekly&quot; THEN -0.10&#13;&#10;        WHEN &quot;Daily&quot; THEN -0.25&#13;&#10;    END&#13;&#10;&#13;&#10;ELSEIF ATTR([os_name]) = &quot;web&quot; THEN&#13;&#10;    NULL  // Since thresholds are n/a&#13;&#10;END' />
            </column>
            <column caption='Installs By OS line upper' datatype='real' name='[Installs By Sub Channel line upper (copy)_1269733626637254682]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([os_name]) = &quot;ios&quot; THEN&#13;&#10;    CASE [Parameters].[Parameter 5]&#13;&#10;        WHEN &quot;Weekly&quot; THEN 0.10&#13;&#10;        WHEN &quot;Daily&quot; THEN 0.30&#13;&#10;    END&#13;&#10;&#13;&#10;ELSEIF ATTR([os_name]) = &quot;android&quot; THEN&#13;&#10;    CASE [Parameters].[Parameter 5]&#13;&#10;        WHEN &quot;Weekly&quot; THEN 0.10&#13;&#10;        WHEN &quot;Daily&quot; THEN 0.25&#13;&#10;    END&#13;&#10;&#13;&#10;ELSEIF ATTR([os_name]) = &quot;web&quot; THEN&#13;&#10;    NULL  // Since thresholds are n/a&#13;&#10;END' />
            </column>
            <column caption='Customized Time Period' datatype='string' name='[Last 4 Weeks (copy)_1981020938829774848]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [date] &gt;= [Calculation_1981020938831675393] AND [date] &lt;= [Current Start (copy)_1981020938831757314] THEN &apos;2.Current&apos;&#13;&#10;        ELSEIF [date] &gt;= DATEADD(&apos;day&apos;, -DATEDIFF(&apos;day&apos;, [Calculation_1981020938831675393], [Current Start (copy)_1981020938831757314]), DATEADD(&apos;day&apos;, -1, [Calculation_1981020938831675393])) AND [date] &lt;= DATEADD(&apos;day&apos;, -1, [Calculation_1981020938831675393]) THEN &apos;1.Previous&apos;&#13;&#10;        END' />
            </column>
            <column caption='Last 90 days' datatype='string' name='[Last 7 Days (copy)_1055542419980339]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATEDIFF(&apos;day&apos;,[date],TODAY()) &gt;= 1 and DATEDIFF(&apos;day&apos;, [date], TODAY()) &lt;= 90 Then &apos;2.Current&apos;&#13;&#10;ELSEIF DATEDIFF(&apos;day&apos;,[date],TODAY()) &gt;= 91 and DATEDIFF(&apos;day&apos;, [date], TODAY()) &lt; 180 then &apos;1.Previous&apos;&#13;&#10;END' />
            </column>
            <column caption='Last 4 Weeks' datatype='string' name='[Last 7 Days (copy)_2047167540613005313]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;DATEADD(&apos;week&apos;,-1, {MAX([date])})&gt;= [date] and&#13;&#10;[date] &gt;= DATEADD(&apos;week&apos;,-5, {MAX([date])}) THEN &apos;2.Current&apos; &#13;&#10;ELSEIF DATEADD(&apos;week&apos;,-5, {MAX([date])})&gt;=[date]&#13;&#10;AND [date] &gt;= DATEADD(&apos;week&apos;,-9, {MAX([date])})&#13;&#10;THEN &apos;1.Previous&apos; END' />
            </column>
            <column caption='Last Semester' datatype='string' name='[Last Month (copy)_1836905733821898763]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATEPART(&apos;month&apos;, TODAY()) &lt;= 6 THEN&#13;&#10;    IF DATEPART(&apos;month&apos;, [date]) &gt;= 1 AND DATEPART(&apos;month&apos;, [date]) &lt;= 6 AND DATEPART(&apos;year&apos;, [date]) = DATEPART(&apos;year&apos;, TODAY())-1 THEN&#13;&#10;        &quot;1.Previous&quot;&#13;&#10;    ELSEIF DATEPART(&apos;month&apos;, [date]) &gt;= 7 AND DATEPART(&apos;month&apos;, [date]) &lt;= 12 AND DATEPART(&apos;year&apos;, [date]) = DATEPART(&apos;year&apos;, TODAY()) - 1 THEN&#13;&#10;        &quot;2.Current&quot;&#13;&#10;    ELSE Null &#13;&#10;    END&#13;&#10;ELSE&#13;&#10;    IF DATEPART(&apos;month&apos;, [date]) &gt;= 1 AND DATEPART(&apos;month&apos;, [date]) &lt;= 6 AND DATEPART(&apos;year&apos;, [date]) = DATEPART(&apos;year&apos;, TODAY()) THEN&#13;&#10;        &quot;2.Current&quot;&#13;&#10;    ELSEIF DATEPART(&apos;month&apos;, [date]) &gt;= 7 AND DATEPART(&apos;month&apos;, [date]) &lt;= 12 AND DATEPART(&apos;year&apos;, [date]) = DATEPART(&apos;year&apos;, TODAY()) - 1 THEN&#13;&#10;        &quot;1.Previous&quot;&#13;&#10;    ELSE Null&#13;&#10;    END&#13;&#10;END' />
            </column>
            <column caption='Last Quarter' datatype='string' name='[Last Semester (copy)_1981020938841624588]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATEPART(&apos;month&apos;, TODAY()) IN (1, 2, 3) THEN&#13;&#10;    // Q4 of the previous year is the last complete quarter&#13;&#10;    IF DATEPART(&apos;month&apos;, [date]) IN (10, 11, 12) AND DATEPART(&apos;year&apos;, [date]) = DATEPART(&apos;year&apos;, TODAY()) - 1 THEN&#13;&#10;        &quot;2.Current&quot;&#13;&#10;    ELSEIF DATEPART(&apos;month&apos;, [date]) IN (7, 8, 9) AND DATEPART(&apos;year&apos;, [date]) = DATEPART(&apos;year&apos;, TODAY()) - 1 THEN&#13;&#10;        &quot;1.Previous&quot;&#13;&#10;    ELSE Null&#13;&#10;    END&#13;&#10;ELSEIF DATEPART(&apos;month&apos;, TODAY()) IN (4, 5, 6) THEN&#13;&#10;    // Q1 of the current year is the last complete quarter&#13;&#10;    IF DATEPART(&apos;month&apos;, [date]) IN (1, 2, 3) AND DATEPART(&apos;year&apos;, [date]) = DATEPART(&apos;year&apos;, TODAY()) THEN&#13;&#10;        &quot;2.Current&quot;&#13;&#10;    ELSEIF DATEPART(&apos;month&apos;, [date]) IN (10, 11, 12) AND DATEPART(&apos;year&apos;, [date]) = DATEPART(&apos;year&apos;, TODAY()) - 1 THEN&#13;&#10;        &quot;1.Previous&quot;&#13;&#10;    ELSE Null&#13;&#10;    END&#13;&#10;ELSEIF DATEPART(&apos;month&apos;, TODAY()) IN (7, 8, 9) THEN&#13;&#10;    // Q2 of the current year is the last complete quarter&#13;&#10;    IF DATEPART(&apos;month&apos;, [date]) IN (4, 5, 6) AND DATEPART(&apos;year&apos;, [date]) = DATEPART(&apos;year&apos;, TODAY()) THEN&#13;&#10;        &quot;2.Current&quot;&#13;&#10;    ELSEIF DATEPART(&apos;month&apos;, [date]) IN (1, 2, 3) AND DATEPART(&apos;year&apos;, [date]) = DATEPART(&apos;year&apos;, TODAY()) THEN&#13;&#10;        &quot;1.Previous&quot;&#13;&#10;    ELSE Null&#13;&#10;    END&#13;&#10;ELSEIF DATEPART(&apos;month&apos;, TODAY()) IN (10, 11, 12) THEN&#13;&#10;    // Q3 of the current year is the last complete quarter&#13;&#10;    IF DATEPART(&apos;month&apos;, [date]) IN (7, 8, 9) AND DATEPART(&apos;year&apos;, [date]) = DATEPART(&apos;year&apos;, TODAY()) THEN&#13;&#10;        &quot;2.Current&quot;&#13;&#10;    ELSEIF DATEPART(&apos;month&apos;, [date]) IN (4, 5, 6) AND DATEPART(&apos;year&apos;, [date]) = DATEPART(&apos;year&apos;, TODAY()) THEN&#13;&#10;        &quot;1.Previous&quot;&#13;&#10;    ELSE Null&#13;&#10;    END&#13;&#10;END' />
            </column>
            <column caption='OS Alarm Installs' datatype='string' name='[Network Alarm Installs  (copy)_1269733626637647899]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ATTR([os_name]) = &quot;ios&quot; THEN&#13;&#10;    CASE [Parameters].[Parameter 5]&#13;&#10;        WHEN &quot;Weekly&quot; THEN&#13;&#10;            IF abs([%PP Cost (copy)_1269733626601771010]) &gt; 0.10 THEN &quot;Alarm&quot;&#13;&#10;            ELSE &quot;No Alarm&quot;&#13;&#10;            END&#13;&#10;        WHEN &quot;Daily&quot; THEN&#13;&#10;            IF abs([%PP Cost (copy)_1269733626601771010]) &gt; 0.30 THEN &quot;Alarm&quot;&#13;&#10;            ELSE &quot;No Alarm&quot;&#13;&#10;            END&#13;&#10;    END&#13;&#10;&#13;&#10;ELSEIF ATTR([os_name]) = &quot;android&quot; THEN&#13;&#10;    CASE [Parameters].[Parameter 5]&#13;&#10;        WHEN &quot;Weekly&quot; THEN&#13;&#10;            IF abs([%PP Cost (copy)_1269733626601771010]) &gt; 0.10 THEN &quot;Alarm&quot;&#13;&#10;            ELSE &quot;No Alarm&quot;&#13;&#10;            END&#13;&#10;        WHEN &quot;Daily&quot; THEN&#13;&#10;            IF abs([%PP Cost (copy)_1269733626601771010]) &gt; 0.25 THEN &quot;Alarm&quot;&#13;&#10;            ELSE &quot;No Alarm&quot;&#13;&#10;            END&#13;&#10;    END&#13;&#10;&#13;&#10;ELSEIF ATTR([os_name]) = &quot;web&quot; THEN&#13;&#10;    &quot;No Alarm&quot;  // Since thresholds are n/a&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Week of Date' datatype='string' name='[Quarter of Date (copy)_2047167540626092045]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(DATEPART(&apos;year&apos;, [date])) + &quot;W&quot; + RIGHT(&quot;0&quot; + STR(DATEPART(&apos;week&apos;, [date])), 2)' />
            </column>
            <column caption='Dynamic Time Range Selector' datatype='string' name='[Time Range Selector Group (copy)_580401437412540418]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='Case [Parameters].[Parameter 4]&#13;&#10;WHEN &apos;MTD&apos; then [Calculation_171699771263401986]&#13;&#10;WHEN &apos;Last 90 days&apos; then [Last 7 Days (copy)_1055542419980339]&#13;&#10;WHEN &apos;Last 4 Weeks&apos; then [Last 7 Days (copy)_2047167540613005313]&#13;&#10;when &apos;Last 7 Days&apos; then [Calculation_2047167540612460544]&#13;&#10;when &apos;Last Month&apos; then [Calculation_171699771262914561]&#13;&#10;when &apos;Last Semester&apos; then [Last Month (copy)_1836905733821898763]&#13;&#10;when &apos;Last Week Completed&apos; then [Calculation_171699771263967235]&#13;&#10;when &apos;Custom Time Range&apos; then [Last 4 Weeks (copy)_1981020938829774848]&#13;&#10;when &apos;Last Quarter&apos; then [Last Semester (copy)_1981020938841624588]&#13;&#10;ELSE null&#13;&#10;END' />
            </column>
            <column caption='Year-Month of Date ' datatype='string' name='[Week of Date (copy)_2047167540626223118]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(YEAR([date])) + &quot;-&quot; + STR(MONTH([date]))' />
            </column>
            <column aggregation='Count' caption='Country' datatype='string' default-type='nominal' layered='true' name='[country]' pivot='key' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Year' caption='Date' datatype='date' default-type='ordinal' layered='true' name='[date]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default' />
            <column-instance column='[Calculation_1836905733738844164]' derivation='None' name='[none:Calculation_1836905733738844164:nk]' pivot='key' type='nominal' />
            <column-instance column='[Time Range Selector Group (copy)_580401437412540418]' derivation='None' name='[none:Time Range Selector Group (copy)_580401437412540418:nk]' pivot='key' type='nominal' />
