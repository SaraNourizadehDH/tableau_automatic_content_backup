      <column caption='Previous' datatype='date' name='[Current (copy)_1981020938832834566]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [Time Range Selector Group (copy)_580401437412540418] = &apos;1.Previous&apos; THEN&#13;&#10;[date] END' />
      </column>
      <column caption='Previous Period' datatype='string' name='[Current Period (copy)_90072028675530769]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#13;&#10;    WHEN &apos;Last 7 Days&apos; THEN &#13;&#10;        IF DATEDIFF(&apos;day&apos;, [date], TODAY()) &gt;= 8 AND DATEDIFF(&apos;day&apos;, [date], TODAY()) &lt;= 14 THEN &apos;1.Previous&apos; END&#13;&#10;    WHEN &apos;Last 14 Days&apos; THEN &#13;&#10;        IF DATEDIFF(&apos;day&apos;, [date], TODAY()) &gt;= 15 AND DATEDIFF(&apos;day&apos;, [date], TODAY()) &lt;= 28 THEN &apos;1.Previous&apos; END&#13;&#10;    WHEN &apos;Last Month&apos; THEN &#13;&#10;        IF DATEDIFF(&apos;month&apos;, [date], TODAY()) = 1 THEN &apos;1.Previous&apos; END&#13;&#10;    WHEN &apos;Last Semester&apos; THEN &#13;&#10;        IF DATEDIFF(&apos;month&apos;, [date], TODAY()) &gt;= 6 AND DATEDIFF(&apos;month&apos;, [date], TODAY()) &lt; 12 THEN &apos;1.Previous&apos; END&#13;&#10;    WHEN &apos;Last Week Completed&apos; THEN &#13;&#10;        IF DATEDIFF(&apos;week&apos;, [date], TODAY()) = 1 THEN &apos;1.Previous&apos; END&#13;&#10;END' />
      </column>
      <column caption='Current End' datatype='datetime' name='[Current Start (copy)_1981020938831757314]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEADD(&quot;day&quot;,-0,[Parameters].[Parameter 9])' />
      </column>
      <column caption='Previous End' datatype='datetime' name='[Current Start (copy)_1981020938831933443]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEADD(&quot;day&quot;,-1, [Parameters].[Parameter 8])' />
      </column>
