      <column caption='CPH 7 Days' datatype='real' name='[CPH (copy)_2213237797938524174]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//Cost per lead&#10;SUM([Calculation_2213237797584023557])/[Calculation_2213237797934870539]' />
      </column>
      <column caption='CPH 30 Days' datatype='real' name='[CPH 15 Days (copy)_2213237797939671056]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//Cost per lead&#10;SUM([Calculation_2213237797584023557])/[Hire 15 Days (copy)_2213237797935529997]' />
      </column>
      <column caption='CPH 15 Days' datatype='real' name='[CPH 7 Days (copy)_2213237797938683919]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//Cost per lead&#10;SUM([Calculation_2213237797584023557])/[Hire 7 Days (copy)_2213237797935378444]' />
      </column>
      <column caption='CPH' datatype='real' name='[CPL (copy)_2213237797585350663]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//Cost per lead&#10;SUM([Calculation_2213237797584023557])/SUM([hired])' />
      </column>
      <column caption='Date' datatype='date' name='[Calculation_2213237797576937473]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE( &#10;IF [Parameters].[lost_applications Parameter] = &quot;Daily&quot; THEN [report_date]&#10;ELSEIF [Parameters].[lost_applications Parameter] = &quot;Weekly&quot; THEN DATETRUNC(&apos;week&apos;,[report_date],&apos;sunday&apos;)&#10;ELSEIF [Parameters].[lost_applications Parameter] = &quot;Monthly&quot; THEN DATETRUNC(&apos;month&apos;,[report_date],&apos;sunday&apos;)&#10;ELSEIF [Parameters].[lost_applications Parameter] = &quot;Quarterly&quot; THEN DATETRUNC(&apos;quarter&apos;,[report_date],&apos;sunday&apos;)&#10;END&#10;)' />
      </column>
      <column caption='Channel ' datatype='string' name='[Calculation_2213237797578674178]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Select Date View (copy)]&#10;WHEN &apos;UTM Channel&apos; THEN [channel]&#10;WHEN &apos;Exit Poll Channel&apos; THEN [channel_ep]&#10;END' />
      </column>
      <column caption='Channel (filter costs)' datatype='string' name='[Calculation_2213237797581537283]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[channel]' />
      </column>
      <column caption='Costs' datatype='real' name='[Calculation_2213237797584023557]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Channel Type (copy)]&#10;WHEN &apos;EUR&apos; THEN [costs_eur]&#10;WHEN &apos;USD&apos; THEN [costs_usd]&#10;WHEN &apos;Local Currency&apos; THEN [costs_lc]&#10;END' />
      </column>
      <column caption='CPL' datatype='real' name='[Calculation_2213237797584154630]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//Cost per lead&#10;SUM([Calculation_2213237797584023557])/SUM([leads])' />
      </column>
      <column caption='CVR Lead to Hire' datatype='real' name='[Calculation_2213237797597667336]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([hired])/SUM([leads])' />
      </column>
      <column caption='Actual Time To Hire' datatype='integer' name='[Calculation_2213237797930676234]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='//SUM([time_to_hire])/SUM([Leads])&#10;DATEDIFF(&apos;day&apos;,[report_date],[hire_date])' />
      </column>
      <column caption='Hire 7 Days' datatype='integer' name='[Calculation_2213237797934870539]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_2213237797930676234] &lt;= 7 THEN [hired] END)' />
      </column>
      <column caption='CTR' datatype='real' default-format='p0.00%' name='[Calculation_2213237797941415953]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([clicks])/SUM([impressions])' />
      </column>
      <column caption='CPC' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2213237797941760018]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_2213237797584023557])/SUM([clicks])' />
      </column>
      <column caption='CTA' datatype='real' default-format='p0.00%' name='[Calculation_2213237797942005779]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([leads])/SUM([clicks])' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_4371376823636160512]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Hire 30 Days' datatype='integer' name='[Hire 15 Days (copy)_2213237797935529997]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_2213237797930676234] &lt;= 30 THEN [hired] ELSE 0 END)' />
      </column>
      <column caption='Hire 15 Days' datatype='integer' name='[Hire 7 Days (copy)_2213237797935378444]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_2213237797930676234] &lt;= 15 THEN [hired] END)' />
      </column>
