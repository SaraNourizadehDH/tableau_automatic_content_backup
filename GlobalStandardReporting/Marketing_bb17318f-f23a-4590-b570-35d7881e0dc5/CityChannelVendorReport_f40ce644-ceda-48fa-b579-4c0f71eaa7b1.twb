        <calculation class='tableau' formula='&quot;All&quot;' />
        <members />
      </column>
      <column caption='Sub-Entity' datatype='string' name='[Display Name Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
        <calculation class='tableau' formula='&quot;All&quot;' />
        <members />
      </column>
      <column caption='Management Entity' datatype='string' name='[Management Entity Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
