      <column alias='Successful Orders' caption='KPI Selector' datatype='integer' name='[Parameter 1 (copy)]' param-domain-type='list' role='measure' type='quantitative' value='1'>
        <calculation class='tableau' formula='1' />
        <members />
      </column>
      <column caption='Select Date View' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
        <calculation class='tableau' formula='&quot;Monthly&quot;' />
        <members>
          <member value='&quot;Daily&quot;' />
          <member value='&quot;Weekly&quot;' />
          <member value='&quot;Monthly&quot;' />
        </members>
      </column>
      <column caption='KPI Parameter' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Acquisitions&quot;'>
        <calculation class='tableau' formula='&quot;Acquisitions&quot;' />
        <members>
          <member value='&quot;Acquisitions&quot;' />
          <member value='&quot;Reorders&quot;' />
          <member value='&quot;Orders&quot;' />
          <member value='&quot;Commission Revenue&quot;' />
          <member value='&quot;Declines&quot;' />
          <member value='&quot;Not Sent&quot;' />
        </members>
      </column>
      <column caption='Run Rate Values' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Orders&quot;'>
        <calculation class='tableau' formula='&quot;Orders&quot;' />
        <aliases>
          <alias key='&quot;Revenue&quot;' value='GMV' />
        </aliases>
        <members>
          <member value='&quot;Orders&quot;' />
          <member alias='GMV' value='&quot;Revenue&quot;' />
          <member value='&quot;Acquisitions&quot;' />
        </members>
      </column>
      <column caption='Currency' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;EUR&quot;'>
        <calculation class='tableau' formula='&quot;EUR&quot;' />
        <members>
          <member value='&quot;EUR&quot;' />
          <member value='&quot;USD&quot;' />
          <member value='&quot;Local Currency&quot;' />
        </members>
      </column>
      <column caption='Top N' datatype='integer' name='[Parameter 5 1]' param-domain-type='range' role='measure' type='quantitative' value='7'>
        <calculation class='tableau' formula='7' />
        <range max='30' min='1' />
      </column>
      <column caption='Voucher' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
        <calculation class='tableau' formula='&quot;All&quot;' />
        <members>
          <member value='&quot;True&quot;' />
          <member value='&quot;False&quot;' />
          <member value='&quot;All&quot;' />
