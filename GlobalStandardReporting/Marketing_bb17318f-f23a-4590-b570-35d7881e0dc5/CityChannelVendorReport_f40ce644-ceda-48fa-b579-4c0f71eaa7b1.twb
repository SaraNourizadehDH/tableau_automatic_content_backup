      <aliases enabled='yes' />
      <column caption='Header' datatype='integer' name='[Calculation_2242933412848136194]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Fail Rate' datatype='real' default-format='p0.0%' name='[Calculation_3284812994241085446]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([failed_orders])/sum([total_orders])' />
      </column>
      <column caption='Reorder Rate' datatype='real' name='[Calculation_3543629235370770433]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([returning_customers])/sum([acquisitions_rr])' />
      </column>
      <column caption='Online D Share' datatype='real' default-format='p0.0%' name='[Calculation_5033124479751364608]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([online_d_outlets]) / SUM([online_outlets])' />
      </column>
      <column caption='Vendor city switch 1' datatype='string' name='[Calculation_5219249793026596865]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 8]&#10;WHEN &apos;Vendor&apos; THEN [brand_name]&#10;WHEN &apos;City&apos; THEN [city]&#10;WHEN &apos;&lt;hide&gt;&apos; THEN &apos;&apos;&#10;END' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_5280329892552253441]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='City (List)' datatype='string' name='[City (copy)]' role='dimension' semantic-role='[City].[Name]' type='nominal'>
        <calculation class='tableau' formula='UPPER([city])' />
      </column>
      <column caption='Orders Per Restaurant' datatype='real' name='[Overall Orders Per Restaurant (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [brand_name], [city]: (SUM([successful_orders]) /SUM([online_outlets]))}' />
      </column>
      <column caption='Vendor city switch 2' datatype='string' name='[Vendor city switch 1 (copy)]' role='dimension' semantic-role='[City].[Name]' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Choose Primary Dimension (copy)]&#10;WHEN &apos;Vendor&apos; THEN [brand_name]&#10;WHEN &apos;City&apos; THEN [city]&#10;WHEN &apos;&lt;hide&gt;&apos; THEN &apos;&apos;&#10;END' />
      </column>
