      <aliases enabled='yes' />
      <column caption='Date Filter' datatype='date' hidden='true' name='[Calculation_4311774433218969615]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='lookup(max([Calculation_457678357363400717]),0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Date View' datatype='date' default-format='*yyyy-mm-dd' name='[Calculation_457678357363400717]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE( &#13;&#10;IF [Parameters].[Parameter 1] = &quot;Daily&quot; THEN [placed_at_local]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Weekly&quot; THEN DATETRUNC(&apos;week&apos;,[placed_at_local],&apos;monday&apos;)&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Monthly&quot; THEN DATETRUNC(&apos;month&apos;,[placed_at_local],&apos;monday&apos;)&#13;&#10;END&#13;&#10;)' />
      </column>
      <column caption='Total Acquisitions' datatype='real' name='[Calculation_4910471744090103808]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &apos;True&apos; THEN [acq_voucher]&#10;WHEN &apos;False&apos; THEN [acq_no_voucher]&#10;WHEN &apos;All&apos; THEN [acq_voucher]+[acq_no_voucher]&#10;END' />
      </column>
      <column caption='Channel Analysis Dimension' datatype='string' name='[Calculation_4910471744845221899]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;WHEN &apos;Management Entity&apos;        THEN [management_entity]&#10;WHEN &apos;Sub-Entity&apos;               THEN [sub_entity]&#10;WHEN &apos;Country&apos;                  THEN [country]&#10;WHEN &apos;Platform Type&apos;            THEN [platform_type]&#10;WHEN &apos;Device&apos;                   THEN [platform]&#10;WHEN &apos;Channel&apos;                  THEN [channel]&#10;WHEN &apos;Sub-Channel&apos;              THEN [subchannel]&#10;END' />
      </column>
      <column caption='Channel Analysis' datatype='string' hidden='true' name='[Calculation_4910471744851161103]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;WHEN &apos;Management Entity&apos;        THEN [management_entity]&#10;WHEN &apos;Sub-Entity&apos;               THEN [sub_entity]&#10;WHEN &apos;Country&apos;                  THEN [country]&#10;WHEN &apos;Platform Type&apos;            THEN [platform_type]&#10;WHEN &apos;Device&apos;                   THEN [platform]&#10;WHEN &apos;Channel&apos;                  THEN [channel]&#10;WHEN &apos;Sub-Channel&apos;              THEN [subchannel]&#10;END' />
      </column>
      <column caption='KPI Switch - delta' datatype='real' name='[Calculation_4910471745102675985]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_4910471744090103808]) / LOOKUP(SUM([Calculation_4910471744090103808]), -1) ) -1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='KPI Switch - delta shape' datatype='integer' name='[Calculation_4910471745103151122]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] != &apos;Declines&apos; and [Parameters].[Parameter 2] != &apos;Not Sent&apos;&#10;    THEN IF [Calculation_4910471745102675985] &gt; 0 THEN 2 ELSEIF [Calculation_4910471745102675985] &lt; 0 then -2 ELSE 0 END&#10;ELSE IF [Calculation_4910471745102675985] &lt; 0 THEN 1 ELSEIF [Calculation_4910471745102675985] &gt; 0 then -1 ELSE 0 END&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='1' datatype='integer' name='[Calculation_4910471745106702355]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_5280329892552253441]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
