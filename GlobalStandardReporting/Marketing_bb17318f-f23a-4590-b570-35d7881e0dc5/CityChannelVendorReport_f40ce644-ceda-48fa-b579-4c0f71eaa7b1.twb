      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/CityChannelReport/ChannelDrillDown?rev=' id='ChannelDrillDown' path='/t/GlobalStandardReporting/workbooks/CityChannelReport' revision='' site='GlobalStandardReporting' />
