      <column caption='Cost eur param for bars' datatype='real' default-format='c&quot;€ &quot;#,##0;-&quot;€ &quot;#,##0' name='[Calculation_2005509245696983041]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SIZE() = 1 THEN 10000 ELSE [Calculation_5313684645578252299] END'>
          <table-calc ordering-type='Rows' />
