      <column caption='% Cost regional' datatype='real' default-format='p0.00%' name='[Calculation_2005509245725343754]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SIZE() = 1 THEN&#10;&#10;// for the total, we use a different calculation&#10;// https://community.tableau.com/s/question/0D54T00000C6f7SSAR/grand-total-for-lod-calc-incorrect-when-missing-data&#10;&#10;SUM({FIXED [region], [month], [cf_source] : SUM([cost_eur])})&#10;&#10;/&#10;&#10;SUM({FIXED : SUM([cost_eur])})&#10;&#10;ELSE&#10;&#10;SUM({FIXED [region], [month], [cf_source] : SUM([cost_eur])})&#10;&#10;/&#10;&#10;SUM({FIXED [region] : SUM([cost_eur])})&#10;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Entity/Region' datatype='string' name='[Calculation_3163497309560844289]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[CF Recency Type (copy)] = &quot;Management Entity&quot; THEN [management_entity]&#13;&#10;ELSEIF [Parameters].[CF Recency Type (copy)] = &quot;Region&quot; THEN [region]&#13;&#10;END' />
      </column>
      <column caption='CF Recency' datatype='string' name='[Calculation_3531103643670077440]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN &apos;Detailed&apos; THEN [cf_recency]&#10;    WHEN &apos;Overview&apos; THEN IF ([cf_recency] &lt;&gt; &apos;N/A&apos; AND [cf_recency] &lt;&gt; &apos;&gt; 12 months&apos;) THEN &apos;Calibrated&apos; ELSE &apos;Uncalibrated&apos; END&#10;END' />
        <aliases>
          <alias key='&quot;N/A&quot;' value='Not calibrated' />
        </aliases>
      </column>
      <column caption='Dimension 1' datatype='string' name='[Calculation_5235997564381757454]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Month&apos; THEN STR([month])&#10;WHEN &apos;Quarter&apos; THEN STR(YEAR([month])) + &apos; Q&apos; + STR(QUARTER([month]))&#10;WHEN &apos;Region&apos; THEN [region]&#10;WHEN &apos;Brand&apos; THEN [management_entity]&#10;WHEN &apos;Entity&apos; THEN [global_entity_id]&#10;WHEN &apos;Channel&apos; THEN [channel]&#10;WHEN &apos;Sub channel&apos; THEN [sub_channel]&#10;WHEN &apos;Objective&apos; THEN [objective]&#10;WHEN &apos;OS&apos; THEN [os]&#10;WHEN &apos;Calibration recency&apos; THEN [cf_recency]&#10;WHEN &apos;Calibration source&apos; THEN [cf_source]&#10;WHEN &apos;Total&apos; THEN &apos;Total&apos;&#10;END' />
      </column>
      <column caption='€ Spend calibrated' datatype='real' default-format='c&quot;€ &quot;#,##0;-&quot;€ &quot;#,##0' name='[Calculation_5235997564387799064]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_calibrated] THEN [cost_eur] ELSE 0 END' />
      </column>
      <column caption='% Spend calibrated' datatype='real' default-format='p0.0%' name='[Calculation_5235997564388372506]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_5235997564387799064]) / SUM([cost_eur])' />
      </column>
      <column caption='% Cost calibrated (region month)' datatype='real' default-format='p0%' name='[Calculation_5313684645529681920]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({FIXED [region], [month], [cf_source] : SUM(IF [Calculation_5380746084751183880] THEN [cost_eur] ELSE 0 END)})&#10;&#10;/&#10;&#10;SUM({FIXED [region], [month] : SUM([cost_eur])})' />
      </column>
      <column caption='% Contribution total PM spend' datatype='real' default-format='p0.0%' name='[Calculation_5313684645540405249]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cost_eur]) / SUM({ FIXED : SUM([cost_eur]) })' />
      </column>
      <column caption='cost eur param' datatype='real' default-format='c&quot;€ &quot;#,##0;-&quot;€ &quot;#,##0' name='[Calculation_5313684645578252299]' role='measure' type='quantitative'>
