      <column caption='% Spend not calibrated' datatype='real' default-format='p0.0%' name='[% Spend calibrated (copy)_5235997564388966427]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([€ Spend calibrated (copy)_5235997564388212761]) / SUM([cost_eur])' />
