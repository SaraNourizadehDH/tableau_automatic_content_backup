    <worksheet name='_overview_regional_recency_perc'>
      <table>
        <view>
          <datasources>
            <datasource caption='bima_tableau_acquisition_measurement_geotest_coverage_dashboard_v2+ (rl_mkt)' name='federated.0f07z6r0s63mrs1h0q01j16hcrhl' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='CF Recency Type' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Overview&quot;'>
              <calculation class='tableau' formula='&quot;Overview&quot;' />
            </column>
            <column caption='Last 3 months only ?' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Yes&quot;'>
              <calculation class='tableau' formula='&quot;Yes&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0f07z6r0s63mrs1h0q01j16hcrhl'>
            <column caption='% Cost regional recency' datatype='real' default-format='p0.00%' name='[% Cost regional (copy)_3171589718909546505]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SIZE() = 1 THEN&#10;&#10;// for the total, we use a different calculation&#10;// https://community.tableau.com/s/question/0D54T00000C6f7SSAR/grand-total-for-lod-calc-incorrect-when-missing-data&#10;&#10;SUM({FIXED [region], [month], [Calculation_1020417192402554885], [cf_recency], [cf_source] : SUM([cost_eur])})&#10;&#10;/&#10;&#10;SUM({FIXED : SUM([cost_eur])})&#10;&#10;ELSE&#10;&#10;SUM({FIXED [region], [month], [Calculation_1020417192402554885], [cf_recency], [cf_source] : SUM([cost_eur])})&#10;&#10;/&#10;&#10;SUM({FIXED [region] : SUM([cost_eur])})&#10;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Month should show' datatype='string' name='[Calculation_1020417192402554885]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Yes&apos; AND [month] &gt;= DATEADD(&apos;month&apos;, -3, TODAY()) THEN &apos;Yes&apos;&#10;ELSEIF [Parameters].[Parameter 4] = &apos;No&apos; THEN &apos;Yes&apos; ELSE &apos;No&apos; END' />
            </column>
            <column caption='CF Recency' datatype='string' name='[Calculation_3531103643670077440]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN &apos;Detailed&apos; THEN [cf_recency]&#10;    WHEN &apos;Overview&apos; THEN IF ([cf_recency] &lt;&gt; &apos;N/A&apos; AND [cf_recency] &lt;&gt; &apos;&gt; 12 months&apos;) THEN &apos;Calibrated&apos; ELSE &apos;Uncalibrated&apos; END&#10;END' />
              <aliases>
                <alias key='&quot;N/A&quot;' value='Not calibrated' />
              </aliases>
            </column>
            <column caption='Cf Recency' datatype='string' name='[cf_recency]' role='dimension' type='nominal' />
            <column caption='Cf Source' datatype='string' name='[cf_source]' role='dimension' type='nominal' />
            <column caption='Cost Eur' datatype='real' name='[cost_eur]' role='measure' type='quantitative' />
            <column caption='Month' datatype='date' default-format='*mmm yyyy' name='[month]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1020417192402554885]' derivation='None' name='[none:Calculation_1020417192402554885:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_3531103643670077440]' derivation='None' name='[none:Calculation_3531103643670077440:nk]' pivot='key' type='nominal' />
            <column-instance column='[region]' derivation='None' name='[none:region:nk]' pivot='key' type='nominal' />
            <column-instance column='[cost_eur]' derivation='Sum' name='[pcto:sum:cost_eur:qk:3]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' type='PctTotal' />
            </column-instance>
            <column caption='Region' datatype='string' name='[region]' role='dimension' type='nominal' />
            <column-instance column='[cost_eur]' derivation='Sum' name='[sum:cost_eur:qk]' pivot='key' type='quantitative' />
            <column-instance column='[% Cost regional (copy)_3171589718909546505]' derivation='User' name='[usr:% Cost regional (copy)_3171589718909546505:qk:1]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Columns' />
            </column-instance>
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0f07z6r0s63mrs1h0q01j16hcrhl].[none:Calculation_1020417192402554885:nk]' context='true' filter-group='8'>
            <groupfilter function='member' level='[none:Calculation_1020417192402554885:nk]' member='&quot;Yes&quot;' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <manual-sort column='[federated.0f07z6r0s63mrs1h0q01j16hcrhl].[none:Calculation_3531103643670077440:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;N/A&quot;</bucket>
              <bucket>&quot;Uncalibrated&quot;</bucket>
              <bucket>&quot;&gt;12 months&quot;</bucket>
              <bucket>&quot;&gt; 12 months&quot;</bucket>
              <bucket>&quot;10-12 months&quot;</bucket>
              <bucket>&quot;6-9 months&quot;</bucket>
              <bucket>&quot;&lt;6 months&quot;</bucket>
              <bucket>&quot;7-9 months&quot;</bucket>
              <bucket>&quot;&lt;= 6 months&quot;</bucket>
              <bucket>&quot;Calibrated&quot;</bucket>
            </dictionary>
