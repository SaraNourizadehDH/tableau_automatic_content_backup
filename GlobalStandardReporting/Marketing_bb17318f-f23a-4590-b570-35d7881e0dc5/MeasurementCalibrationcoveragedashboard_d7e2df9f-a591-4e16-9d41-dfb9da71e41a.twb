      <aliases enabled='yes' />
      <column caption='% Contribution regional PM spend' datatype='real' default-format='p0.0%' name='[% Contribution total PM spend (copy)_5313684645566939143]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cost_eur]) / SUM({ FIXED [region] : SUM([cost_eur]) })' />
      </column>
      <column caption='% Contribution local PM spend' datatype='real' default-format='p0.0%' name='[% Contribution total PM spend (copy)_5313684645567475720]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cost_eur]) / SUM({ FIXED [global_entity_id] : SUM([cost_eur]) })' />
      </column>
      <column caption='% Cost calibrated (mgmt month)' datatype='real' default-format='p0%' name='[% Cost calibrated (region month) (copy)_3171589718852120580]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({FIXED [Calculation_3163497309560844289], [month], [Calculation_1020417192402554885], [cf_source] : SUM(IF [Calculation_5380746084751183880] THEN [cost_eur] ELSE 0 END)})&#10;&#10;/&#10;&#10;SUM({FIXED [Calculation_3163497309560844289], [month], [Calculation_1020417192402554885] : SUM([cost_eur])})' />
      </column>
      <column caption='% Cost mgmt' datatype='real' default-format='p0.00%' name='[% Cost regional (copy)_3171589718847983618]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SIZE() = 1 THEN&#10;&#10;// for the total, we use a different calculation&#10;// https://community.tableau.com/s/question/0D54T00000C6f7SSAR/grand-total-for-lod-calc-incorrect-when-missing-data&#10;&#10;SUM({FIXED [management_entity], [month], [cf_source] : SUM([cost_eur])})&#10;&#10;/&#10;&#10;SUM({FIXED : SUM([cost_eur])})&#10;&#10;ELSE&#10;&#10;SUM({FIXED [management_entity], [month], [cf_source] : SUM([cost_eur])})&#10;&#10;/&#10;&#10;SUM({FIXED [management_entity] : SUM([cost_eur])})&#10;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% Cost regional recency' datatype='real' default-format='p0.00%' name='[% Cost regional (copy)_3171589718909546505]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SIZE() = 1 THEN&#10;&#10;// for the total, we use a different calculation&#10;// https://community.tableau.com/s/question/0D54T00000C6f7SSAR/grand-total-for-lod-calc-incorrect-when-missing-data&#10;&#10;SUM({FIXED [region], [month], [Calculation_1020417192402554885], [cf_recency], [cf_source] : SUM([cost_eur])})&#10;&#10;/&#10;&#10;SUM({FIXED : SUM([cost_eur])})&#10;&#10;ELSE&#10;&#10;SUM({FIXED [region], [month], [Calculation_1020417192402554885], [cf_recency], [cf_source] : SUM([cost_eur])})&#10;&#10;/&#10;&#10;SUM({FIXED [region] : SUM([cost_eur])})&#10;&#10;END'>
