      <column caption='Month should show' datatype='string' name='[Calculation_1020417192402554885]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Yes&apos; AND [month] &gt;= DATEADD(&apos;month&apos;, -3, TODAY()) THEN &apos;Yes&apos;&#10;ELSEIF [Parameters].[Parameter 4] = &apos;No&apos; THEN &apos;Yes&apos; ELSE &apos;No&apos; END' />
