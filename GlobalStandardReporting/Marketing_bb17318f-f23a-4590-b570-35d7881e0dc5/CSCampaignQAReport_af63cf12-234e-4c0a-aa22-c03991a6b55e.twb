      <aliases enabled='yes' />
      <column caption='2. Dimension' datatype='string' name='[1. Dimension (copy)_243475868554575872]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[1. Dimension Switch (copy)]&#10;WHEN &apos;Date&apos;                     THEN STR(DATE([Calculation_671317880946876416]))&#10;WHEN &apos;Management Entity&apos;        THEN [management_entity]&#10;WHEN &apos;Display Name&apos;             THEN [sub_entity]&#10;WHEN &apos;Country&apos;                  THEN [country_name]&#13;&#10;WHEN &apos;Campaign&apos;                 THEN [campaign]&#10;WHEN &apos;Platform Type&apos;            THEN [platform_type]&#10;WHEN &apos;Platform&apos;                 THEN [platform]&#10;WHEN &apos;Channel - Sub-Channel&apos;    THEN [channel_mapping]&#10;END' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_145311516515344384]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='USERNAME()=[username]' />
      </column>
      <column caption='Costs' datatype='real' name='[Calculation_1779695940233924609]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;EUR&apos; THEN [cost_eur]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;USD&apos; THEN [cost_usd]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;LC&apos; THEN [cost_lc]&#10;END' />
      </column>
      <column caption='1. Dimension' datatype='string' name='[Calculation_239535208155246593]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Date&apos;                     THEN STR(DATE([Calculation_671317880946876416]))&#10;WHEN &apos;Management Entity&apos;        THEN [management_entity]&#10;WHEN &apos;Display Name&apos;             THEN [sub_entity]&#10;WHEN &apos;Country&apos;                  THEN [country_name]&#13;&#10;WHEN &apos;Campaign&apos;                 THEN [campaign]&#10;WHEN &apos;Platform Type&apos;            THEN [platform_type]&#10;WHEN &apos;Platform&apos;                 THEN [platform]&#10;WHEN &apos;Channel - Sub-Channel&apos;    THEN [channel_mapping]&#10;END' />
      </column>
      <column caption='CPA' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_239535208184770565]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1779695940233924609]) / SUM([Calculation_5742089557526224896])' />
      </column>
      <column caption='Date Filter' datatype='boolean' name='[Calculation_4301148783956627456]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[cost_date] &lt;= TODAY()' />
      </column>
      <column caption='Acquisitions Attr.' datatype='real' name='[Calculation_5742089557526224896]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6] &#13;&#10;WHEN &apos;40-20-40&apos; THEN [acq]&#13;&#10;WHEN &apos;Calibrated&apos; THEN [acq_cal]&#13;&#10;WHEN &apos;40-20-40 with iOS 14.5 Fix&apos; THEN [acquisitions_ios14fix]&#13;&#10;WHEN &apos;Calibrated with iOS 14.5 Fix&apos; THEN [acquisitions_cal_ios14fix]&#13;&#10;END' />
      </column>
      <column caption='Noted' datatype='string' name='[Calculation_639511184137678854]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Note&quot;' />
        <aliases>
