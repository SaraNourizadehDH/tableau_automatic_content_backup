        <calculation class='tableau' formula='[Calculation_1134484955561709571]*SUM([Calculation_164381441401962500])&#10;&#10;//16.02.2023&#10;//Target receivers formula is fixed for non-transactional KPIs. &#10;//That&apos;s why, the fixed calculation is not needed for Incremental calculations thanks to this fixing.&#10;/*&#10;SUM({ FIXED   &#10;[Sent Date],&#10;[Management Entity],&#10;[Country],&#10;[Display Name],&#10;[Campaign Type],&#10;[Campaign Name]:&#10;[[New]] Increment % of All Orders]*SUM([Target: Receivers])&#10;})*/' />
