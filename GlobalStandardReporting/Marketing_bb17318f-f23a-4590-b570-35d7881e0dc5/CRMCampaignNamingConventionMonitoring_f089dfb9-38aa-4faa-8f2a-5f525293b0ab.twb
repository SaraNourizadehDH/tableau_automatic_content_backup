  <column aggregation='User' caption='MoM Incremental GMV' datatype='real' default-type='quantitative' name='[Calculation_1254885854406803458]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
    <calculation class='tableau' formula='(ZN([Incremental Orders (FIXED logic) (copy)_6919429020978581504]) - LOOKUP(ZN([Incremental Orders (FIXED logic) (copy)_6919429020978581504]), -1)) / ABS(LOOKUP(ZN([Incremental Orders (FIXED logic) (copy)_6919429020978581504]), -1))'>
