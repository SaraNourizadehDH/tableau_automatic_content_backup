            OR CONTAINS(LOWER([campaign_name]), \&quot;encuesta\&quot;)
            OR CONTAINS(LOWER([campaign_name]), \&quot;helpcenter\&quot;)
    WHEN &apos;Foodpanda APAC&apos;
        THEN CONTAINS(LOWER([campaign_name]), \&quot;optin\&quot;)
            OR CONTAINS(LOWER([campaign_name]), \&quot;nps\&quot;)
            OR CONTAINS(LOWER([campaign_name]), \&quot;survey\&quot;)
