            <local-type>boolean</local-type>
            <aggregation>Count</aggregation>
            <contains-null>true</contains-null>
            <attributes>
              <attribute datatype='integer' name='field-type'>2</attribute>
              <attribute datatype='string' name='formula'>&quot;CASE [management_entity]
    WHEN &apos;Pedidosya&apos;
        THEN CONTAINS(LOWER([canvas_name]), \&quot;optin\&quot;)
            OR CONTAINS(LOWER([canvas_name]), \&quot;opt-in\&quot;)
            OR CONTAINS(LOWER([canvas_name]), \&quot;nps\&quot;)
            OR CONTAINS(LOWER([canvas_name]), \&quot;survey\&quot;)
            OR CONTAINS(LOWER([canvas_name]), \&quot;encuesta\&quot;)
            OR CONTAINS(LOWER([canvas_name]), \&quot;helpcenter\&quot;)
    WHEN &apos;Foodpanda APAC&apos;
        THEN CONTAINS(LOWER([canvas_name]), \&quot;optin\&quot;)
            OR CONTAINS(LOWER([canvas_name]), \&quot;nps\&quot;)
            OR CONTAINS(LOWER([canvas_name]), \&quot;survey\&quot;)
            OR CONTAINS(LOWER([canvas_name]), \&quot;ta\&quot;)
            OR CONTAINS(LOWER([canvas_name]), \&quot;rmo\&quot;)
            OR CONTAINS(LOWER([canvas_name]), \&quot;rma\&quot;)
    WHEN &apos;DH Europe&apos;
        THEN CONTAINS(LOWER([canvas_name]), \&quot;nps\&quot;)
            OR CONTAINS(LOWER([canvas_name]), \&quot;survey\&quot;)
            OR CONTAINS(LOWER([canvas_name]), \&quot;optin and email\&quot;)
            OR CONTAINS(LOWER([canvas_name]), \&quot;optin and push\&quot;)
    WHEN &apos;HungerStation&apos;
        THEN CONTAINS(LOWER([canvas_name]), \&quot;optin\&quot;)
            OR CONTAINS(LOWER([canvas_name]), \&quot;opt-in\&quot;)
            OR CONTAINS(LOWER([canvas_name]), \&quot;opt in\&quot;)
            OR CONTAINS(LOWER([canvas_name]), \&quot;nps\&quot;)
            OR CONTAINS(LOWER([canvas_name]), \&quot;survey\&quot;)
            OR CONTAINS(LOWER([canvas_name]), \&quot;rmo\&quot;)
            OR CONTAINS(LOWER([canvas_name]), \&quot;audience reporting\&quot;)
    WHEN &apos;Talabat&apos;
        THEN CONTAINS(LOWER([canvas_name]), \&quot;optin\&quot;)
            OR CONTAINS(LOWER([canvas_name]), \&quot;nps\&quot;)
            OR CONTAINS(LOWER([canvas_name]), \&quot;survey\&quot;)
    ELSE CONTAINS(LOWER([canvas_name]), \&quot;rmo\&quot;)
        OR CONTAINS(LOWER([canvas_name]), \&quot;rma\&quot;)
END&quot;</attribute>
