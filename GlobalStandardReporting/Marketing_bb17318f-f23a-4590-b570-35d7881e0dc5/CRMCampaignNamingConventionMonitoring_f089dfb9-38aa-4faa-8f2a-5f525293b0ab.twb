        <calculation class='tableau' formula='{ FIXED &#10;    [sent_date],&#10;    [display_name],&#10;    [campaign_name],&#10;    [campaign_type],&#10;    [channel],&#10;    [loyalty_status]:&#10;MIN([opened_email])&#10;}' />
