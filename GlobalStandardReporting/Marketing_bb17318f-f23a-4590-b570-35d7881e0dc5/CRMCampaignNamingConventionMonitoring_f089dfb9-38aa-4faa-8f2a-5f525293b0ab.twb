  <column aggregation='Sum' caption='Activation Statistical Significant (cases)' datatype='integer' default-format='n\#,\#\#0;-\#,\#\#0' default-type='quantitative' name='[Calculation_1392104922434547719]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
    <calculation class='tableau' formula='IF [Parameters].[Date View (copy)] = &apos;12h&apos; THEN [activation_12h_ss]&\#10;ELSEIF [Parameters].[Date View (copy)] = &apos;1Day&apos;  THEN [activation_day_ss]&\#10;ELSEIF [Parameters].[Date View (copy)] = &apos;7Days&apos; THEN [activation_week_ss]&\#10;END' />
