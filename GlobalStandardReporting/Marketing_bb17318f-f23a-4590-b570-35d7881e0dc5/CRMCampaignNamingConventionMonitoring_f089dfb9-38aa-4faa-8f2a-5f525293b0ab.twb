    <datasource caption='marketing_bi_weekly_tableau_mkt_crm_campaign_verticals+ (rl_mkt)' inline='true' name='sqlproxy.0n1iw3h1y1uo7v1dakz0f1dme5nt' version='18.1'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/datasources/marketing_bi_weekly_tableau_mkt_crm_campaign_verticalsrl_mkt?rev=3.0' id='marketing_bi_weekly_tableau_mkt_crm_campaign_verticalsrl_mkt' path='/t/GlobalStandardReporting/datasources' revision='1.2' site='GlobalStandardReporting' />
      <connection channel='https' class='sqlproxy' dbname='marketing_bi_weekly_tableau_mkt_crm_campaign_verticalsrl_mkt' directory='/dataserver' port='443' references-user='true' server='tableau.deliveryhero.net' server-oauth='' username='' workgroup-auth-mode='prompt'>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation name='sqlproxy' table='[sqlproxy]' type='table' />
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation name='sqlproxy' table='[sqlproxy]' type='table' />
        <calculations>
          <calculation column='[Activation Statistical Significant (cases) (copy)_1392104922434924552]' formula='IF [Parameters].[Date View (copy)] = &apos;12h&apos; THEN [orders_12h_ss]&#10;ELSEIF [Parameters].[Date View (copy)] = &apos;1Day&apos;  THEN [orders_day_ss]&#10;ELSEIF [Parameters].[Date View (copy)] = &apos;7Days&apos; THEN [orders_week_ss]&#10;END' />
          <calculation column='[CG: GMV (cases) (copy)_5062468221975343109]' formula='CASE [Parameters].[Date View (copy)]&#10;WHEN &apos;12h&apos; THEN [hva_eur_cg_12h]&#10;WHEN &apos;1Day&apos; THEN [hva_eur_cg_day]&#10;WHEN &apos;7Days&apos; THEN [hva_eur_cg_week]      &#10;END' />
          <calculation column='[CG: GMV per Receivers (copy)_1029354044233064469]' formula='SUM(IFNULL([TG: Orders (cases) (copy)_1029354044232286225],0)) &#10;/ &#10;IFNULL([Calculation_1029354044214095872],0)' />
          <calculation column='[CG: GMV per Receivers (copy)_1029354044235472921]' formula='SUM(IFNULL([TG: Voucher (cases) (copy)_1029354044235108376],0)) &#10;/ &#10;IFNULL([Target: Receivers (copy)_1029354044216369155],0)' />
          <calculation column='[CG: GMV per Receivers (copy)_5062468221975183364]' formula='//MAX(IFNULL([CG: LT GMV (cases)],0)) &#10;SUM({ FIXED   &#10;[sent_date],&#10;[management_entity],&#10;[country],&#10;[display_name],&#10;[campaign_type],&#10;[campaign_name]:&#10;MAX([CG: GMV (cases) (copy)_5062468221975343109])&#10;})&#10;/ &#10;IFNULL([Target: Receivers (copy)_1029354044216369155],0)' />
          <calculation column='[CG: GMV per Receivers for Incr GMV (copy)_1768436947279400961]' formula='[_Orders Tg (Case) (copy)_3395854857861492743] /[Calculation_164381441401962500]' />
          <calculation column='[CG: Orders per Receivers (copy)_1029354044228399119]' formula='SUM(IFNULL([TG: Users (cases) (copy)_1029354044224536587],0)) &#10;/ &#10;IFNULL([Calculation_1029354044214095872],0)' />
          <calculation column='[CG: Orders per Receivers (copy)_1029354044232908820]' formula='SUM(IFNULL([TG: GMV (cases) (copy)_1029354044232622098],0)) &#10;/ &#10;IFNULL([Target: Receivers (copy)_1029354044216369155],0)' />
          <calculation column='[CG: Users per Receivers (copy)_1029354044228243470]' formula='SUM(IFNULL([TG: Orders (cases) (copy)_1029354044227850253],0)) &#10;/ &#10;IFNULL([Target: Receivers (copy)_1029354044216369155],0)' />
          <calculation column='[CG: Voucher per Receivers (copy)_1029354044235620378]' formula='SUM(IFNULL([TG: GMV (cases) (copy)_1029354044234854423],0)) &#10;/ &#10;IFNULL([Calculation_1029354044214095872],0)' />
          <calculation column='[Calculation_1029354044214095872]' formula='SUM({ FIXED   &#10;[sent_date],&#10;[management_entity],&#10;[country],&#10;[display_name],&#10;[campaign_type],&#10;[campaign_name],&#10;[channel]:&#10;CASE MIN([Parameters].[Parameter 9])&#10;    WHEN 1 THEN MIN([users_tg])&#10;    WHEN 2 THEN MIN([users_aid_tg])&#10;end&#10;})' />
          <calculation column='[Calculation_1029354044217122820]' formula='{ FIXED   &#10;[sent_date],&#10;[management_entity],&#10;[country],&#10;[display_name],&#10;[is_shopping],&#10;[campaign_name],&#10;[expedition_type]:&#10;CASE &#10;[Parameters].[Time After Enter (copy)_6134817547588083712]&#10;WHEN 1 THEN //ALL&#10;    CASE MIN([Parameters].[Date View (copy)])&#10;        WHEN &apos;12h&apos; THEN MIN([users_conversions_tg_12h])&#10;        WHEN &apos;1Day&apos; THEN MIN([users_conversions_tg_day])&#10;        WHEN &apos;7Days&apos; THEN MIN([users_conversions_tg_week])&#10;    END&#10;WHEN 2 THEN //Restaurants&#10;    CASE MIN([Parameters].[Date View (copy)])&#10;        WHEN &apos;12h&apos; THEN MIN([users_conversions_tg_12h_restaurant])&#10;        WHEN &apos;1Day&apos; THEN MIN([users_conversions_tg_day_restaurant])&#10;        WHEN &apos;7Days&apos; THEN MIN([users_conversions_tg_week_restaurant])&#10;    END&#10;WHEN 3 THEN //DMart&#10;    CASE MIN([Parameters].[Date View (copy)])&#10;        WHEN &apos;12h&apos; THEN MIN([users_conversions_tg_12h_dmart])&#10;        WHEN &apos;1Day&apos; THEN MIN([users_conversions_tg_day_dmart])&#10;        WHEN &apos;7Days&apos; THEN MIN([users_conversions_tg_week_dmart])&#10;    END&#10;WHEN 4 THEN //Quick Commerce&#10;    CASE MIN([Parameters].[Date View (copy)])&#10;        WHEN &apos;12h&apos; THEN MIN([users_conversions_tg_12h_quickcommerce])&#10;        WHEN &apos;1Day&apos; THEN MIN([users_conversions_tg_day_quickcommerce])&#10;        WHEN &apos;7Days&apos; THEN MIN([users_conversions_tg_week_quickcommerce])&#10;    END&#10;WHEN 5 THEN //Local Shop&#10;    CASE MIN([Parameters].[Date View (copy)])&#10;        WHEN &apos;12h&apos; THEN MIN([users_conversions_tg_12h_localshop])&#10;        WHEN &apos;1Day&apos; THEN MIN([users_conversions_tg_day_localshop])&#10;        WHEN &apos;7Days&apos; THEN MIN([users_conversions_tg_week_localshop])&#10;    END&#10;END&#10;}' />
          <calculation column='[Calculation_1029354044220739589]' formula='SUM(IFNULL([Calculation_1029354044217122820],0)) &#10;/ &#10;IFNULL([Calculation_1029354044214095872],0)' />
          <calculation column='[Calculation_1029354044222869512]' formula='SUM(IFNULL([Calculation_1029354044217122820],0)) &#10;/ &#10;IFNULL([Calculation_1029354044214095872],0)' />
          <calculation column='[Calculation_1029354044223512586]' formula='SUM({ FIXED   &#10;[sent_date],&#10;[management_entity],&#10;[country],&#10;[display_name],&#10;[campaign_type],&#10;[campaign_name]:&#10;([Calculation_1029354044222869512] - [TG: Users per Receivers (copy)_1029354044223320073]) * [Calculation_1029354044214095872]&#10;})' />
          <calculation column='[Calculation_1029354044236791836]' formula='[Total Opens (copy)_1029354044237398045] + [Total Opens (copy)_1029354044237508638] + [Total Opens (copy)_1029354044237672479]' />
          <calculation column='[Calculation_1029354044239990822]' formula='CONTAINS(LOWER([campaign_name]), LOWER([Parameters].[Parameter 11]))' />
          <calculation column='[Calculation_1029354044240175143]' formula='IF UPPER(LEFT([campaign_name],4))=&apos;DMA_&apos; THEN &quot;dmart&quot;&#10;ELSEIF UPPER(LEFT([campaign_name],4))=&apos;LOC_&apos; THEN &quot;local stores&quot;&#10;ELSEIF UPPER(LEFT([campaign_name],4))=&apos;MIX_&apos; THEN &quot;mixed&quot;&#10;ELSEIF UPPER(LEFT([campaign_name],4))=&apos;EAT_&apos; THEN &quot;restaurants&quot;&#10;ELSEIF UPPER(LEFT([campaign_name],4))=&apos;QUI_&apos; THEN &quot;quick commerce&quot;&#10;ELSEIF UPPER(LEFT([campaign_name],4))=&apos;SUB_&apos; THEN &quot;subscription&quot;&#10;ELSEIF UPPER(LEFT([campaign_name],4))=&apos;LOY_&apos; THEN &quot;loyalty&quot;&#10;ELSE &quot;others&quot;&#10;END' />
          <calculation column='[Calculation_1029354044241575976]' formula='[Target: Receivers (copy)_1029354044216369155]/([Target: Receivers (copy)_1029354044216369155]+[Calculation_1029354044214095872])' />
          <calculation column='[Calculation_1029354044259135531]' formula='[Parameters].[Parameter 4]' />
          <calculation column='[Calculation_1134484955555418112]' formula='DATETRUNC([Parameters].[Users Tg Parameter],[sent_date],&apos;monday&apos;)' />
          <calculation column='[Calculation_1134484955556564993]' formula='IF [Calculation_956663138992021504]&gt;0 THEN &apos;positive&apos;&#10;ELSE &apos;negative&apos; END' />
          <calculation column='[Calculation_1134484955558875138]' formula='COUNTD([campaign_name])' />
          <calculation column='[Calculation_1134484955561709571]' formula='([_Orders/Customers TG (copy)_114771466801725477]-[_Orders/Customers CG (copy)_114771466801635364])' />
          <calculation column='[Calculation_1134484955566833668]' formula='SUM([Orders Cg (Case) (copy)_326511010489282561])/SUM([Calculation_164381441401962500])' />
          <calculation column='[Calculation_1236519611853770752]' formula='{ FIXED &#10;    [Calculation_1134484955555418112],&#10;    [display_name],&#10;    [campaign_name],&#10;    [campaign_type],&#10;    [channel],&#10;    [loyalty_status]:&#10;SUM([opened_email]+[opened_push_direct]+[opened_push_web])&#10;}&#10;&#10;// 16.02.2023&#10;// Non-transactional KPIs don&apos;t have vertical information. That&apos;s means, these KPIs should be same for every vertical.&#10;// Transactional KPIs have vertical information. That&apos;s means, these KPIs should change for every vertical.&#10;// Opens is a non-transactional KPI so fixed LOD calculation is used.' />
          <calculation column='[Calculation_1254885854413574152]' formula='[Calculation_1134484955555418112] = [Parameters].[Parameter 2]' />
          <calculation column='[Calculation_1392104922434547719]' formula='IF [Parameters].[Date View (copy)] = &apos;12h&apos; THEN [activation_12h_ss]&#10;ELSEIF [Parameters].[Date View (copy)] = &apos;1Day&apos;  THEN [activation_day_ss]&#10;ELSEIF [Parameters].[Date View (copy)] = &apos;7Days&apos; THEN [activation_week_ss]&#10;END' />
          <calculation column='[Calculation_1510887370073456647]' formula='//IF { FIXED [Campaign Name]: [Increment Orders 7Days]} &lt; 0 AND [Significant Campaign]=TRUE THEN &quot;negative&quot;&#10;//ELSEIF { FIXED [Campaign Name]: [Increment Orders 7Days]} &gt;= 0 AND [Significant Campaign]=TRUE THEN &quot;positive&quot;&#10;//ELSE &quot;CG too small&quot;&#10;//END&#10;&#10;IF [Parameters].[Date View (copy)]=&apos;12h&apos; THEN &#10;    IF { FIXED [campaign_name]: [Increment Orders (copy)]} &lt; 0 AND [Calculation_956663138992619522]=TRUE THEN &quot;negative&quot;&#10;    ELSEIF { FIXED [campaign_name]: [Increment Orders (copy)]} &gt;= 0 AND [Calculation_956663138992619522]=TRUE THEN &quot;positive&quot;&#10;    ELSE &quot;CG too small&quot;&#10;    END&#10;ELSEIF [Parameters].[Date View (copy)]=&apos;1Day&apos; THEN&#10;    IF { FIXED [campaign_name]: [Calculation_941252330473996298]} &lt; 0 AND [Calculation_956663138992619522]=TRUE THEN &quot;negative&quot;&#10;    ELSEIF { FIXED [campaign_name]: [Calculation_941252330473996298]} &gt;= 0 AND [Calculation_956663138992619522]=TRUE THEN &quot;positive&quot;&#10;    ELSE &quot;CG too small&quot;&#10;    END&#10;ELSEIF [Parameters].[Date View (copy)]=&apos;7Days&apos; THEN&#10;    IF { FIXED [campaign_name]: [Calculation_941252330474115083]} &lt; 0 AND [Calculation_956663138992619522]=TRUE THEN &quot;negative&quot;&#10;    ELSEIF { FIXED [campaign_name]: [Calculation_941252330474115083]} &gt;= 0 AND [Calculation_956663138992619522]=TRUE THEN &quot;positive&quot;&#10;    ELSE &quot;CG too small&quot;&#10;    END&#10;END' />
          <calculation column='[Calculation_1600888989917003777]' formula='SUM(&#10;{ FIXED&#10;    [display_name],&#10;    [campaign_name],&#10;    [channel]:&#10;    MAX([TG: GMV (cases) (copy)_5062468221971324928]) &#10;}&#10;)' />
          <calculation column='[Calculation_164381441401962500]' formula='{ FIXED &#10;    [sent_date],&#10;    [display_name],&#10;    [campaign_name],&#10;    [campaign_type],&#10;    [channel],&#10;    [loyalty_status]:&#10;SUM(CASE [Parameters].[Parameter 9]&#10;        WHEN 1 THEN [users_tg]&#10;        WHEN 2 THEN [users_aid_tg]&#10;    END)&#10;}&#10;&#10;// 16.02.2023&#10;// Non-transactional KPIs don&apos;t have vertical information. That&apos;s means, these KPIs should be same for every vertical.&#10;// Transactional KPIs have vertical information. That&apos;s means, these KPIs should change for every vertical.&#10;// &lt;Receivers&gt; is a non-transactional KPI so fixed LOD calculation is used.' />
          <calculation column='[Calculation_1703627337928110085]' formula='CASE [management_entity]&#10;    WHEN &apos;Pedidosya&apos;&#10;        THEN CONTAINS(LOWER([campaign_name]), &quot;optin&quot;)&#10;            OR CONTAINS(LOWER([campaign_name]), &quot;opt-in&quot;)&#10;            OR CONTAINS(LOWER([campaign_name]), &quot;nps&quot;)&#10;            OR CONTAINS(LOWER([campaign_name]), &quot;survey&quot;)&#10;            OR CONTAINS(LOWER([campaign_name]), &quot;encuesta&quot;)&#10;            OR CONTAINS(LOWER([campaign_name]), &quot;helpcenter&quot;)&#10;    WHEN &apos;Foodpanda APAC&apos;&#10;        THEN CONTAINS(LOWER([campaign_name]), &quot;optin&quot;)&#10;            OR CONTAINS(LOWER([campaign_name]), &quot;nps&quot;)&#10;            OR CONTAINS(LOWER([campaign_name]), &quot;survey&quot;)&#10;            OR CONTAINS(LOWER([campaign_name]), &quot;ta&quot;)&#10;            OR CONTAINS(LOWER([campaign_name]), &quot;rmo&quot;)&#10;            OR CONTAINS(LOWER([campaign_name]), &quot;rma&quot;)&#10;    WHEN &apos;DH Europe&apos;&#10;        THEN CONTAINS(LOWER([campaign_name]), &quot;nps&quot;)&#10;            OR CONTAINS(LOWER([campaign_name]), &quot;survey&quot;)&#10;            OR CONTAINS(LOWER([campaign_name]), &quot;optin and email&quot;)&#10;            OR CONTAINS(LOWER([campaign_name]), &quot;optin and push&quot;)&#10;    WHEN &apos;HungerStation&apos;&#10;        THEN CONTAINS(LOWER([campaign_name]), &quot;optin&quot;)&#10;            OR CONTAINS(LOWER([campaign_name]), &quot;opt-in&quot;)&#10;            OR CONTAINS(LOWER([campaign_name]), &quot;opt in&quot;)&#10;            OR CONTAINS(LOWER([campaign_name]), &quot;nps&quot;)&#10;            OR CONTAINS(LOWER([campaign_name]), &quot;survey&quot;)&#10;            OR CONTAINS(LOWER([campaign_name]), &quot;rmo&quot;)&#10;            OR CONTAINS(LOWER([campaign_name]), &quot;audience reporting&quot;)&#10;    WHEN &apos;Talabat&apos;&#10;        THEN CONTAINS(LOWER([campaign_name]), &quot;optin&quot;)&#10;            OR CONTAINS(LOWER([campaign_name]), &quot;nps&quot;)&#10;            OR CONTAINS(LOWER([campaign_name]), &quot;survey&quot;)&#10;    ELSE CONTAINS(LOWER([campaign_name]), &quot;rmo&quot;)&#10;        OR CONTAINS(LOWER([campaign_name]), &quot;rma&quot;)&#10;END' />
