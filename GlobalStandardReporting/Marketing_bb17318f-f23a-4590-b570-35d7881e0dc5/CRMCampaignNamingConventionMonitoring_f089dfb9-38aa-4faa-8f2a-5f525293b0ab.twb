        <calculation class='tableau' formula='SUM({ FIXED   &#10;[sent_date],&#10;[management_entity],&#10;[country],&#10;[display_name],&#10;[campaign_type],&#10;[campaign_name],&#10;[channel]:&#10;CASE MIN([Parameters].[Parameter 9])&#10;    WHEN 1 THEN MIN([users_cg])&#10;    WHEN 2 THEN MIN([users_aid_cg])&#10;end&#10;})' />
      </column>
      <column aggregation='Sum' caption='Push Direct Opens' datatype='integer' default-type='quantitative' layered='true' name='[Total Opens (copy)_1029354044237398045]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
