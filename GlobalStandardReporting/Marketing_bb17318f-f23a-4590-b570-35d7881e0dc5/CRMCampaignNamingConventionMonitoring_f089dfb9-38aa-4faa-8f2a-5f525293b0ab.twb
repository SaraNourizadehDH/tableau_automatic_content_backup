          <datasource-dependencies datasource='Parameters'>
            <column caption='Canvas Keyword' datatype='string' name='[Parameter 7]' param-domain-type='any' role='measure' type='nominal' value='&quot;&quot;'>
              <calculation class='tableau' formula='&quot;&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.0donhi209jq1p61eo660o0tvrmi7'>
            <column aggregation='Count' caption='Canvas Name Keyword Filter' datatype='boolean' default-type='nominal' layered='true' name='[Calculation_1190287367040897024]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default'>
              <calculation class='tableau' formula='CONTAINS(LOWER([canvas_name]), LOWER([Parameters].[Parameter 7]))' />
            </column>
            <column caption='AUT, MA, UC' datatype='string' name='[Calculation_1957588119710429189]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE SPLIT([canvas_name], &apos;_&apos;, 2)&#10;    WHEN &quot;AUT&quot; THEN &quot;AUT&quot;&#10;    WHEN &quot;MA&quot; THEN &quot;MA&quot;&#10;    ELSE &quot;UC&quot;&#10;END' />
            </column>
            <column caption='Naming Convention Filter (for Retention Performance Report)' datatype='boolean' name='[Calculation_1957588119711137798]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CONTAINS([canvas_name], &quot;_PT_&quot;)&#10;OR&#10;CONTAINS([canvas_name], &quot;_WC_&quot;)&#10;OR&#10;CONTAINS([canvas_name], &quot;_AC_&quot;)&#10;OR&#10;CONTAINS([canvas_name], &quot;_NV_&quot;)&#10;OR&#10;CONTAINS([canvas_name], &quot;_OF_&quot;)&#10;OR&#10;CONTAINS([canvas_name], &quot;_PB_&quot;)&#10;OR&#10;CONTAINS([canvas_name], &quot;_AB_&quot;)&#10;OR&#10;CONTAINS([canvas_name], &quot;_CP_&quot;)&#10;OR&#10;CONTAINS([canvas_name], &quot;_EG_&quot;)&#10;OR&#10;CONTAINS([canvas_name], &quot;_CH_&quot;)&#10;OR&#10;CONTAINS([canvas_name], &quot;_REA_&quot;)&#10;OR&#10;CONTAINS([canvas_name], &quot;_AH_&quot;)&#10;OR&#10;CONTAINS([canvas_name], &quot;_LOS_&quot;)&#10;OR&#10;CONTAINS([canvas_name], &quot;_CR_&quot;)' />
            </column>
            <column caption='TA Exclusion' datatype='boolean' name='[Calculation_1957588119719473159]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CONTAINS([canvas_name], &quot;SURVEY&quot;)&#10;OR&#10;CONTAINS([canvas_name], &quot;TRIGGER&quot;)&#10;OR&#10;CONTAINS([canvas_name], &quot;_TA_&quot;)' />
            </column>
            <column caption='Flag Campaign Naming' datatype='string' name='[Calculation_4519573352771710978]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF&#10;    LEFT([Canvas Name (copy 2)_86342471074004994],1) = &apos;1&apos;&#10;    OR LEFT([Canvas Name (copy 2)_86342471074004994],1) = &apos;2&apos;&#10;        THEN &apos;Old&apos;&#10;ELSEIF&#10;    LEFT([Canvas Name (copy 2)_86342471074004994],1) = &apos;E&apos; //EAT&#10;    OR LEFT([Canvas Name (copy 2)_86342471074004994],1) = &apos;M&apos; //MIX&#10;    OR LEFT([Canvas Name (copy 2)_86342471074004994],1) = &apos;Q&apos;  //QUI&#10;    OR LEFT([Canvas Name (copy 2)_86342471074004994],1) = &apos;D&apos; //DMA&#10;    OR LEFT([Canvas Name (copy 2)_86342471074004994],1) = &apos;L&apos; //LOC&#10;    OR LEFT([Canvas Name (copy 2)_86342471074004994],1) = &apos;S&apos; //SUB&#10;    OR LEFT([Canvas Name (copy 2)_86342471074004994],3) = &apos;COU&apos;&#10;    OR LEFT([Canvas Name (copy 2)_86342471074004994],3) = &apos;AT_&apos;&#10;    OR LEFT([Canvas Name (copy 2)_86342471074004994],3) = &apos;PU_&apos;&#10;        THEN &apos;New&apos;&#10;ELSE &apos;Other&apos;&#10;END' />
            </column>
            <column caption='Campaign Name' datatype='string' name='[Canvas Name (copy 2)_86342471074004994]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[canvas_name]' />
            </column>
            <column aggregation='Count' caption='Canvas Name' datatype='string' default-type='nominal' layered='true' name='[canvas_name]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Count' caption='Country' datatype='string' default-type='nominal' layered='true' name='[country]' pivot='key' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' user-datatype='string' visual-totals='Default' />
