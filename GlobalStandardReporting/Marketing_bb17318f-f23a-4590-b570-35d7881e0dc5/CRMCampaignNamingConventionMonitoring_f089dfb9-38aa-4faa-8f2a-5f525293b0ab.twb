        <calculation class='tableau' formula='IF UPPER(LEFT([campaign_name],4))=&apos;DMA_&apos; THEN &quot;dmart&quot;&#10;ELSEIF UPPER(LEFT([campaign_name],4))=&apos;LOC_&apos; THEN &quot;local stores&quot;&#10;ELSEIF UPPER(LEFT([campaign_name],4))=&apos;MIX_&apos; THEN &quot;mixed&quot;&#10;ELSEIF UPPER(LEFT([campaign_name],4))=&apos;EAT_&apos; THEN &quot;restaurants&quot;&#10;ELSEIF UPPER(LEFT([campaign_name],4))=&apos;QUI_&apos; THEN &quot;quick commerce&quot;&#10;ELSEIF UPPER(LEFT([campaign_name],4))=&apos;SUB_&apos; THEN &quot;subscription&quot;&#10;ELSEIF UPPER(LEFT([campaign_name],4))=&apos;LOY_&apos; THEN &quot;loyalty&quot;&#10;ELSE &quot;others&quot;&#10;END' />
