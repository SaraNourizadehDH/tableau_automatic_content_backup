            <local-type>real</local-type>
            <aggregation>Sum</aggregation>
            <contains-null>true</contains-null>
            <attributes>
              <attribute datatype='integer' name='field-type'>0</attribute>
              <attribute datatype='string' name='formula'>&quot;<![CDATA[case 
    [Parameters].[Time After Enter (copy)_6134817547588083712] when 1 then
    IF [Parameters].[Parameter 8 1]=1 Then [gmv_eur_day]
        ELSEIF [Parameters].[Parameter 8 1]=2 then [gmv_eur_week]
        ELSEIF [Parameters].[Parameter 8 1]=3 then [gmv_eur_15days]
        ELSEIF [Parameters].[Parameter 8 1]=4 then [gmv_eur_month]
    END
    when 2 then
    IF [Parameters].[Parameter 8 1]=1 AND [shop_type]=\"restaurants\" then [gmv_eur_day]
        ELSEIF [Parameters].[Parameter 8 1]=2  AND [shop_type]=\"restaurants\" then [gmv_eur_week]
        ELSEIF [Parameters].[Parameter 8 1]=3  AND [shop_type]=\"restaurants\" then [gmv_eur_15days]
        ELSEIF [Parameters].[Parameter 8 1]=4  AND [shop_type]=\"restaurants\" then [gmv_eur_month]
    end
    when 3 then
    IF [Parameters].[Parameter 8 1]=1 AND [shop_type]=\"darkstores\" then [gmv_eur_day]
        ELSEIF [Parameters].[Parameter 8 1]=2  AND [shop_type]=\"darkstores\" then [gmv_eur_week]
        ELSEIF [Parameters].[Parameter 8 1]=3  AND [shop_type]=\"darkstores\" then [gmv_eur_15days]
        ELSEIF [Parameters].[Parameter 8 1]=4  AND [shop_type]=\"darkstores\" then [gmv_eur_month]
    end
    when 4 then
    IF [Parameters].[Parameter 8 1]=1 AND [shop_type]<>\"restaurants\" then [gmv_eur_day]
        ELSEIF [Parameters].[Parameter 8 1]=2  AND [shop_type]<>\"restaurants\" then [gmv_eur_week]
        ELSEIF [Parameters].[Parameter 8 1]=3  AND [shop_type]<>\"restaurants\" then [gmv_eur_15days]
        ELSEIF [Parameters].[Parameter 8 1]=4  AND [shop_type]<>\"restaurants\" then [gmv_eur_month]
    end
    when 5 then
    IF [Parameters].[Parameter 8 1]=1 AND [shop_type] <> \"restaurants\" and [shop_type] <>\"darkstores\" then [gmv_eur_day]
        ELSEIF [Parameters].[Parameter 8 1]=2  AND [shop_type] <> \"restaurants\" and [shop_type] <>\"darkstores\" then [gmv_eur_week]
        ELSEIF [Parameters].[Parameter 8 1]=3  AND [shop_type] <> \"restaurants\" and [shop_type] <>\"darkstores\" then [gmv_eur_15days]
        ELSEIF [Parameters].[Parameter 8 1]=4  AND [shop_type] <> \"restaurants\" and [shop_type] <>\"darkstores\" then [gmv_eur_month]
    end
end]]>&quot;</attribute>
            </attributes>
