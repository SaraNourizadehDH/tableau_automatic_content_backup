      <aliases enabled='yes' />
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_1957588119700422659]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Flag Campaign Naming' datatype='string' name='[Calculation_1957588119701950468]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF LEFT([campaign_name],1) = &apos;1&apos; or LEFT([campaign_name],1) = &apos;2&apos;&#10;THEN &apos;Old&apos;&#10;ELSEIF LEFT([campaign_name],1) = &apos;E&apos; or LEFT([campaign_name],1) = &apos;M&apos;&#10;OR LEFT([campaign_name],1) = &apos;Q&apos; or LEFT([campaign_name],1) = &apos;D&apos;&#10;OR LEFT([campaign_name],1) = &apos;L&apos; or LEFT([campaign_name],3) = &apos;COU&apos; &#10;or LEFT([campaign_name],3) = &apos;AT_&apos; or LEFT([campaign_name],3) = &apos;PU_&apos;&#10;Then &apos;New&apos;&#10;ELSE &apos;Other&apos;&#10;END' />
      </column>
      <column caption='AUT, MA, UC' datatype='string' name='[Calculation_3220214496552701952]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE SPLIT([campaign_name], &apos;_&apos;, 2)&#10;    WHEN &quot;AUT&quot; THEN &quot;AUT&quot;&#10;    WHEN &quot;MA&quot; THEN &quot;MA&quot;&#10;    ELSE &quot;UC&quot;&#10;END' />
      </column>
      <column caption='TA Exclusion' datatype='boolean' name='[Calculation_3220214496552902657]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CONTAINS([campaign_name], &quot;SURVEY&quot;)&#10;OR&#10;CONTAINS([campaign_name], &quot;TRIGGER&quot;)&#10;OR&#10;CONTAINS([campaign_name], &quot;_TA_&quot;)' />
      </column>
      <column caption='Naming Convention Filter (for Retention Performance Report)' datatype='boolean' name='[Calculation_3220214496554119170]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CONTAINS([campaign_name], &quot;_PT_&quot;)&#10;OR&#10;CONTAINS([campaign_name], &quot;_WC_&quot;)&#10;OR&#10;CONTAINS([campaign_name], &quot;_AC_&quot;)&#10;OR&#10;CONTAINS([campaign_name], &quot;_NV_&quot;)&#10;OR&#10;CONTAINS([campaign_name], &quot;_OF_&quot;)&#10;OR&#10;CONTAINS([campaign_name], &quot;_PB_&quot;)&#10;OR&#10;CONTAINS([campaign_name], &quot;_AB_&quot;)&#10;OR&#10;CONTAINS([campaign_name], &quot;_CP_&quot;)&#10;OR&#10;CONTAINS([campaign_name], &quot;_EG_&quot;)&#10;OR&#10;CONTAINS([campaign_name], &quot;_CH_&quot;)&#10;OR&#10;CONTAINS([campaign_name], &quot;_REA_&quot;)&#10;OR&#10;CONTAINS([campaign_name], &quot;_AH_&quot;)&#10;OR&#10;CONTAINS([campaign_name], &quot;_LOS_&quot;)&#10;OR&#10;CONTAINS([campaign_name], &quot;_CR_&quot;)' />
      </column>
      <column caption='Campaign Name Keyword Filter' datatype='boolean' name='[Calculation_3220214496554737668]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CONTAINS(LOWER([campaign_name]), LOWER([Parameters].[Parameter 11]))' />
      </column>
      <column datatype='string' name='[Flag Campaign Naming (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[Calculation_1957588119701950468]' new-bin='true'>
          <bin default-name='false' value='&quot;Bladerunner Campaigns (Old &amp; Other)&quot;'>
            <value>&quot;Old&quot;</value>
            <value>&quot;Other&quot;</value>
          </bin>
        </calculation>
      </column>
