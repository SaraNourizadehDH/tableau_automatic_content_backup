  <column aggregation='Sum' caption='total opens' datatype='integer' default-format='n\#,\#\#0;-\#,\#\#0' default-type='quantitative' name='[Calculation_1236519611853770752]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
    <calculation class='tableau' formula='{ FIXED &\#10;    [Calculation_1134484955555418112],&\#10;    [display_name],&\#10;    [campaign_name],&\#10;    [campaign_type],&\#10;    [channel],&\#10;    [loyalty_status]:&\#10;SUM([opened_email]+[opened_push_direct]+[opened_push_web])&\#10;}&\#10;&\#10;// 16.02.2023&\#10;// Non-transactional KPIs don&apos;t have vertical information. That&apos;s means, these KPIs should be same for every vertical.&\#10;// Transactional KPIs have vertical information. That&apos;s means, these KPIs should change for every vertical.&\#10;// Opens is a non-transactional KPI so fixed LOD calculation is used.' />
