      <column aggregation='User' caption='Incr GMV' datatype='real' default-format='n#,##0;-#,##0' default-type='quantitative' layered='true' name='[[New]] Incremental GMV (copy)_7032863454196322316]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='SUM(([CG: GMV per Receivers for Incr GMV (copy)_1768436947279400961]-[Calculation_1768436947279200256])*[Calculation_164381441401962500])&#10;&#10;//16.02.2023&#10;//Target receivers formula is fixed for non-transactional KPIs. &#10;//That&apos;s why, the fixed calculation is not needed for Incremental calculations thanks to this fixing.&#10;/*&#10;SUM({ FIXED   &#10;[Sent Date],&#10;[Management Entity],&#10;[Country],&#10;[Display Name],&#10;[Campaign Type],&#10;[Campaign Name]:&#10;([GMV per Receiver Tg]-[GMV per Receiver Cg])*SUM([Target: Receivers])&#10;})&#10;*/' />
