  <column aggregation='Sum' caption='Target: Receivers' datatype='integer' default-format='n\#,\#\#0;-\#,\#\#0' default-type='quantitative' name='[Calculation_164381441401962500]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
    <calculation class='tableau' formula='{ FIXED &\#10;    [sent_date],&\#10;    [display_name],&\#10;    [campaign_name],&\#10;    [campaign_type],&\#10;    [channel],&\#10;    [loyalty_status]:&\#10;SUM(CASE [Parameters].[Parameter 9]&\#10;        WHEN 1 THEN [users_tg]&\#10;        WHEN 2 THEN [users_aid_tg]&\#10;    END)&\#10;}&\#10;&\#10;// 16.02.2023&\#10;// Non-transactional KPIs don&apos;t have vertical information. That&apos;s means, these KPIs should be same for every vertical.&\#10;// Transactional KPIs have vertical information. That&apos;s means, these KPIs should change for every vertical.&\#10;// &lt;Receivers&gt; is a non-transactional KPI so fixed LOD calculation is used.' />
