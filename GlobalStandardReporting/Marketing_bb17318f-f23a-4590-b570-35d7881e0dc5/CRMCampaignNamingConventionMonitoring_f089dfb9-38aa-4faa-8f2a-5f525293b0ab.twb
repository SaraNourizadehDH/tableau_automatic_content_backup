      <column aggregation='Sum' caption='Target: Receivers' datatype='integer' default-format='n#,##0;-#,##0' default-type='quantitative' layered='true' name='[Calculation_164381441401962500]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
        <calculation class='tableau' formula='{ FIXED &#10;    [sent_date],&#10;    [display_name],&#10;    [campaign_name],&#10;    [campaign_type],&#10;    [channel],&#10;    [loyalty_status]:&#10;SUM(CASE [Parameters].[Parameter 9]&#10;        WHEN 1 THEN [users_tg]&#10;        WHEN 2 THEN [users_aid_tg]&#10;    END)&#10;}&#10;&#10;// 16.02.2023&#10;// Non-transactional KPIs don&apos;t have vertical information. That&apos;s means, these KPIs should be same for every vertical.&#10;// Transactional KPIs have vertical information. That&apos;s means, these KPIs should change for every vertical.&#10;// &lt;Receivers&gt; is a non-transactional KPI so fixed LOD calculation is used.' />
      </column>
      <column aggregation='Count' caption='TA Campaign Filter' datatype='boolean' datatype-customized='true' default-type='nominal' layered='true' name='[Calculation_1703627337928110085]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default'>
        <calculation class='tableau' formula='CASE [management_entity]&#10;    WHEN &apos;Pedidosya&apos;&#10;        THEN CONTAINS(LOWER([campaign_name]), &quot;optin&quot;)&#10;            OR CONTAINS(LOWER([campaign_name]), &quot;opt-in&quot;)&#10;            OR CONTAINS(LOWER([campaign_name]), &quot;nps&quot;)&#10;            OR CONTAINS(LOWER([campaign_name]), &quot;survey&quot;)&#10;            OR CONTAINS(LOWER([campaign_name]), &quot;encuesta&quot;)&#10;            OR CONTAINS(LOWER([campaign_name]), &quot;helpcenter&quot;)&#10;    WHEN &apos;Foodpanda APAC&apos;&#10;        THEN CONTAINS(LOWER([campaign_name]), &quot;optin&quot;)&#10;            OR CONTAINS(LOWER([campaign_name]), &quot;nps&quot;)&#10;            OR CONTAINS(LOWER([campaign_name]), &quot;survey&quot;)&#10;            OR CONTAINS(LOWER([campaign_name]), &quot;ta&quot;)&#10;            OR CONTAINS(LOWER([campaign_name]), &quot;rmo&quot;)&#10;            OR CONTAINS(LOWER([campaign_name]), &quot;rma&quot;)&#10;    WHEN &apos;DH Europe&apos;&#10;        THEN CONTAINS(LOWER([campaign_name]), &quot;nps&quot;)&#10;            OR CONTAINS(LOWER([campaign_name]), &quot;survey&quot;)&#10;            OR CONTAINS(LOWER([campaign_name]), &quot;optin and email&quot;)&#10;            OR CONTAINS(LOWER([campaign_name]), &quot;optin and push&quot;)&#10;    WHEN &apos;HungerStation&apos;&#10;        THEN CONTAINS(LOWER([campaign_name]), &quot;optin&quot;)&#10;            OR CONTAINS(LOWER([campaign_name]), &quot;opt-in&quot;)&#10;            OR CONTAINS(LOWER([campaign_name]), &quot;opt in&quot;)&#10;            OR CONTAINS(LOWER([campaign_name]), &quot;nps&quot;)&#10;            OR CONTAINS(LOWER([campaign_name]), &quot;survey&quot;)&#10;            OR CONTAINS(LOWER([campaign_name]), &quot;rmo&quot;)&#10;            OR CONTAINS(LOWER([campaign_name]), &quot;audience reporting&quot;)&#10;    WHEN &apos;Talabat&apos;&#10;        THEN CONTAINS(LOWER([campaign_name]), &quot;optin&quot;)&#10;            OR CONTAINS(LOWER([campaign_name]), &quot;nps&quot;)&#10;            OR CONTAINS(LOWER([campaign_name]), &quot;survey&quot;)&#10;    ELSE CONTAINS(LOWER([campaign_name]), &quot;rmo&quot;)&#10;        OR CONTAINS(LOWER([campaign_name]), &quot;rma&quot;)&#10;END' />
      </column>
