      <column aggregation='Count' caption='Filter: Show Variants = True' datatype='boolean' default-type='nominal' layered='true' name='[Calculation_1583507885147652102]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default'>
        <calculation class='tableau' formula='[Calculation_1583507885144969220] = TRUE' />
