    <datasource caption='marketing_bi_weekly_tableau_mkt_crm_canvas_verticals+ (rl_mkt)' inline='true' name='sqlproxy.0donhi209jq1p61eo660o0tvrmi7' version='18.1'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/datasources/marketing_bi_weekly_tableau_mkt_crm_canvas_verticalsrl_mkt?rev=4.4' id='marketing_bi_weekly_tableau_mkt_crm_canvas_verticalsrl_mkt' path='/t/GlobalStandardReporting/datasources' revision='1.2' site='GlobalStandardReporting' />
      <connection channel='https' class='sqlproxy' dbname='marketing_bi_weekly_tableau_mkt_crm_canvas_verticalsrl_mkt' directory='/dataserver' port='443' references-user='true' server='tableau.deliveryhero.net' server-oauth='' username='' workgroup-auth-mode='prompt'>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation name='sqlproxy' table='[sqlproxy]' type='table' />
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation name='sqlproxy' table='[sqlproxy]' type='table' />
        <calculations>
          <calculation column='[Calculation_1190287367040897024]' formula='CONTAINS(LOWER([canvas_name]), LOWER([Parameters].[Parameter 7]))' />
          <calculation column='[Calculation_1379931107142189056]' formula='[Control: Users (copy 2)_2179038590000627712] / [Control: Users (copy)]' />
          <calculation column='[Calculation_1379931107149676545]' formula='&quot;Note&quot;' />
          <calculation column='[Calculation_1384294003434049537]' formula='[Incremental CPO (copy 2)_6919429020998705157]/SUM([Orders (cases) (copy)_6698330426771251201])' />
          <calculation column='[Calculation_1384294003434602498]' formula='//Based on Baseline&#10;//[Incremental GMV (FIXED Logic)]/([Target: Receivers] * [Control: GMV Per Receiver (FIXED Logic)])&#10;&#10;//Based on Target&#10;[Incremental Orders (FIXED logic) (copy)_6919429020978581504] / [Target: Orders (copy)_6919429020999331848]' />
          <calculation column='[Calculation_1392104922421796864]' formula='DATEADD(&apos;day&apos;, -1, [execution_date])' />
          <calculation column='[Calculation_1583507884844228609]' formula='SUM(&#13;&#10;{ FIXED   &#13;&#10;[date],&#13;&#10;[date_type],&#13;&#10;[management_entity],&#13;&#10;[country],&#13;&#10;[display_name],&#13;&#10;[campaign_type],&#13;&#10;[canvas_name],&#10;[expedition_type],&#10;[shop_type]:&#13;&#10;sum( if [in_control] = true then [Calculation_2477261275902283776] end)&#13;&#10;}&#13;&#10;)' />
          <calculation column='[Calculation_1583507885144969220]' formula='case [Parameters].[Parameter 10]&#10;when 1 then FALSE&#10;when 2 then TRUE&#10;end' />
          <calculation column='[Calculation_1583507885147652102]' formula='[Calculation_1583507885144969220] = TRUE' />
          <calculation column='[Calculation_1583507885161340935]' formula='CASE [date_type]&#10;when &apos;2-monthly&apos; then 15&#10;when &apos;monthly&apos; then 15&#10;when &apos;weekly&apos; then 7&#10;when &apos;daily&apos; then 1&#10;end' />
