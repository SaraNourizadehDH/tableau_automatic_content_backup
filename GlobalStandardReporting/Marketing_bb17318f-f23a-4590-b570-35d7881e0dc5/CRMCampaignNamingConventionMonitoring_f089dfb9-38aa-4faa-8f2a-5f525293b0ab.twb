tores&quot; then [orders_day]&\#10;        ELSEIF [Parameters].[Parameter 8 1]=2  AND [shop_type] &lt;&gt; &quot;restaurants&quot; and [shop_type] &lt;&gt;&quot;darkstores&quot; then [orders_week]&\#10;        ELSEIF [Parameters].[Parameter 8 1]=3  AND [shop_type] &lt;&gt; &quot;restaurants&quot; and [shop_type] &lt;&gt;&quot;darkstores&quot; then [orders_15days]&\#10;        ELSEIF [Parameters].[Parameter 8 1]=4  AND [shop_type] &lt;&gt; &quot;restaurants&quot; and [shop_type] &lt;&gt;&quot;darkstores&quot; then [orders_month]&\#10;    end&\#10;end' />
