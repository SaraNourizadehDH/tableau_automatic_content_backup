        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN 1 THEN [Calculation_3984841284389101569]&#10;    WHEN 2 THEN ROUND([Calculation_1029354044223512586],0)&#10;    WHEN 11 THEN ROUND([Incremental Order Proportion (copy)_282671301043052549] * 100,1)&#10;    WHEN 12 THEN ROUND([Incremental Activation (copy)_1029354044229570576],0)&#10;    WHEN 3 THEN ROUND([Calculation_282671301040062465] * 100,1)&#10;    WHEN 4 THEN ROUND([Incremental Orders (copy)_1029354044233289750],0)&#10;    WHEN 5 THEN ROUND([Incremental Activation Proportion (copy)_282671301044285446] * 100,1)&#10;    WHEN 13 THEN ROUND([Incremental GMV (copy)_5062468221974839298],0)&#10;    WHEN 14 THEN ROUND([Incremental GMV Proportion (copy)_5062468221984698376] * 100,1)&#10;    WHEN 6 THEN ROUND([Incremental GMV (copy)_1029354044235829275],0)&#10;    WHEN 7 THEN ROUND([Incremental GMV Proportion (copy)_282671301044408327] * 100,1)&#10;    WHEN 8 THEN ROUND([Calculation_282671301042380804],1)&#10;    WHEN 9 THEN ROUND([iCPO (copy)_1392104922431062021],1)&#10;    WHEN 10 THEN ROUND([iCPO (copy)_1392104922431614982],1)&#10;END' />
      </column>
      <column aggregation='Count' caption='ADHOC KPIs Parameter Name' datatype='string' default-type='nominal' layered='true' name='[Calculation_5133681401980108823]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN 1 THEN &quot;Number of Campaigns&quot;&#10;    WHEN 2 THEN &quot;Incr. Activations&quot;&#10;    WHEN 3 THEN &quot;Incr. Order Proportion (%) - The values represent percentages&quot;&#10;    WHEN 4 THEN &quot;Incr. GMV Proportion (%) - The values represent percentages&quot;&#10;    WHEN 5 THEN &quot;iCPO&quot;&#10;    WHEN 6 THEN &quot;iCPA&quot;&#10;END' />
