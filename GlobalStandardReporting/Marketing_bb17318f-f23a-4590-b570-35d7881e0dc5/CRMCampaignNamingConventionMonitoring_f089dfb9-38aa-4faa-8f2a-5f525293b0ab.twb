  <column aggregation='Count' caption='Uplift Proportion' datatype='string' default-role='measure' default-type='ordinal' name='[Calculation_1510887370073456647]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
    <calculation class='tableau' formula='//IF { FIXED [Campaign Name]: [Increment Orders 7Days]} &lt; 0 AND [Significant Campaign]=TRUE THEN &quot;negative&quot;&\#10;//ELSEIF { FIXED [Campaign Name]: [Increment Orders 7Days]} &gt;= 0 AND [Significant Campaign]=TRUE THEN &quot;positive&quot;&\#10;//ELSE &quot;CG too small&quot;&\#10;//END&\#10;&\#10;IF [Parameters].[Date View (copy)]=&apos;12h&apos; THEN &\#10;    IF { FIXED [campaign_name]: [Increment Orders (copy)]} &lt; 0 AND [Calculation_956663138992619522]=TRUE THEN &quot;negative&quot;&\#10;    ELSEIF { FIXED [campaign_name]: [Increment Orders (copy)]} &gt;= 0 AND [Calculation_956663138992619522]=TRUE THEN &quot;positive&quot;&\#10;    ELSE &quot;CG too small&quot;&\#10;    END&\#10;ELSEIF [Parameters].[Date View (copy)]=&apos;1Day&apos; THEN&\#10;    IF { FIXED [campaign_name]: [Calculation_941252330473996298]} &lt; 0 AND [Calculation_956663138992619522]=TRUE THEN &quot;negative&quot;&\#10;    ELSEIF { FIXED [campaign_name]: [Calculation_941252330473996298]} &gt;= 0 AND [Calculation_956663138992619522]=TRUE THEN &quot;positive&quot;&\#10;    ELSE &quot;CG too small&quot;&\#10;    END&\#10;ELSEIF [Parameters].[Date View (copy)]=&apos;7Days&apos; THEN&\#10;    IF { FIXED [campaign_name]: [Calculation_941252330474115083]} &lt; 0 AND [Calculation_956663138992619522]=TRUE THEN &quot;negative&quot;&\#10;    ELSEIF { FIXED [campaign_name]: [Calculation_941252330474115083]} &gt;= 0 AND [Calculation_956663138992619522]=TRUE THEN &quot;positive&quot;&\#10;    ELSE &quot;CG too small&quot;&\#10;    END&\#10;END' />
  </column>
  <column aggregation='User' caption='TG: LT GMV (for Proportion Calc)' datatype='real' default-type='quantitative' name='[Calculation_1600888989917003777]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
    <calculation class='tableau' formula='SUM(&\#10;{ FIXED&\#10;    [display_name],&\#10;    [campaign_name],&\#10;    [channel]:&\#10;    MAX([TG: GMV (cases) (copy)_5062468221971324928]) &\#10;}&\#10;)' />
  </column>
  <column aggregation='User' caption='MoM Incr Activation' datatype='real' default-format='p0.00\%' default-type='quantitative' name='[Calculation_1635721514903879683]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
    <calculation class='tableau' formula='(ZN([Calculation_1029354044223512586]) - LOOKUP(ZN([Calculation_1029354044223512586]), -1)) / ABS(LOOKUP(ZN([Calculation_1029354044223512586]), -1))'>
      <table-calc ordering-type='Rows' />
