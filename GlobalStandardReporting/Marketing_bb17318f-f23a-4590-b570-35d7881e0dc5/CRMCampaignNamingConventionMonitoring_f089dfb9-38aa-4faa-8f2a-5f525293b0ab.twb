  <column aggregation='User' caption='Incremental Activation (FIXED logic)' datatype='real' default-type='quantitative' name='[Calculation_1583507885203116041]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
    <calculation class='tableau' formula='SUM({ FIXED   &\#10;[date],&\#10;[date_type],&\#10;[management_entity],&\#10;[country],&\#10;[display_name],&\#10;[campaign_type],&\#10;[canvas_name],&\#10;[variation_name]:&\#10;([Orders Per Receiver (copy)_968273957774950429] - [Control: Orders Per Receiver (FIXED logic) (copy)_968273957774630940]) * [Control: Users (copy)]&\#10;})&\#10;//(sum(if [In Control] = false then [Users (cases)] end ) / [Target: Receivers] - [Control: Receivers]/ sum([FIXED Control: Receivers verticals])) * [Target: Receivers]' />
  </column>
  <column aggregation='Count' caption='TA Canvas Filter' datatype='boolean' default-type='nominal' name='[Calculation_1703627337930067974]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default'>
    <calculation class='tableau' formula='CASE [management_entity]&\#10;    WHEN &apos;Pedidosya&apos;&\#10;        THEN CONTAINS(LOWER([canvas_name]), &quot;optin&quot;)&\#10;            OR CONTAINS(LOWER([canvas_name]), &quot;opt-in&quot;)&\#10;            OR CONTAINS(LOWER([canvas_name]), &quot;nps&quot;)&\#10;            OR CONTAINS(LOWER([canvas_name]), &quot;survey&quot;)&\#10;            OR CONTAINS(LOWER([canvas_name]), &quot;encuesta&quot;)&\#10;            OR CONTAINS(LOWER([canvas_name]), &quot;helpcenter&quot;)&\#10;    WHEN &apos;Foodpanda APAC&apos;&\#10;        THEN CONTAINS(LOWER([canvas_name]), &quot;optin&quot;)&\#10;            OR CONTAINS(LOWER([canvas_name]), &quot;nps&quot;)&\#10;            OR CONTAINS(LOWER([canvas_name]), &quot;survey&quot;)&\#10;            OR CONTAINS(LOWER([canvas_name]), &quot;ta&quot;)&\#10;            OR CONTAINS(LOWER([canvas_name]), &quot;rmo&quot;)&\#10;            OR CONTAINS(LOWER([canvas_name]), &quot;rma&quot;)&\#10;    WHEN &apos;DH Europe&apos;&\#10;        THEN CONTAINS(LOWER([canvas_name]), &quot;nps&quot;)&\#10;            OR CONTAINS(LOWER([canvas_name]), &quot;survey&quot;)&\#10;            OR CONTAINS(LOWER([canvas_name]), &quot;optin and email&quot;)&\#10;            OR CONTAINS(LOWER([canvas_name]), &quot;optin and push&quot;)&\#10;    WHEN &apos;HungerStation&apos;&\#10;        THEN CONTAINS(LOWER([canvas_name]), &quot;optin&quot;)&\#10;            OR CONTAINS(LOWER([canvas_name]), &quot;opt-in&quot;)&\#10;            OR CONTAINS(LOWER([canvas_name]), &quot;opt in&quot;)&\#10;            OR CONTAINS(LOWER([canvas_name]), &quot;nps&quot;)&\#10;            OR CONTAINS(LOWER([canvas_name]), &quot;survey&quot;)&\#10;            OR CONTAINS(LOWER([canvas_name]), &quot;rmo&quot;)&\#10;            OR CONTAINS(LOWER([canvas_name]), &quot;audience reporting&quot;)&\#10;    WHEN &apos;Talabat&apos;&\#10;        THEN CONTAINS(LOWER([canvas_name]), &quot;optin&quot;)&\#10;            OR CONTAINS(LOWER([canvas_name]), &quot;nps&quot;)&\#10;            OR CONTAINS(LOWER([canvas_name]), &quot;survey&quot;)&\#10;    ELSE CONTAINS(LOWER([canvas_name]), &quot;rmo&quot;)&\#10;        OR CONTAINS(LOWER([canvas_name]), &quot;rma&quot;)&\#10;END' />
  </column>
