      <column aggregation='User' caption='GMV Proportion (FIXED Logic)' datatype='real' default-format='p0.0%' default-type='quantitative' layered='true' name='[Calculation_1384294003434602498]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
