  <column aggregation='User' caption='GMV Proportion' datatype='real' default-format='p0.0\%' default-type='quantitative' hidden='true' name='[Calculation_1384294003434049537]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
