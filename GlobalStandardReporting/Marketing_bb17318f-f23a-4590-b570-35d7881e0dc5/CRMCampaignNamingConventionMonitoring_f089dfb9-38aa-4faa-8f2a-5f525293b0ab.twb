            <caption>TG: Users (cases)</caption>
            <local-type>integer</local-type>
            <aggregation>Sum</aggregation>
            <contains-null>true</contains-null>
            <attributes>
              <attribute datatype='integer' name='field-type'>0</attribute>
              <attribute datatype='string' name='formula'>&quot;{ FIXED   
[sent_date],
[management_entity],
[country],
[display_name],
[is_shopping],
[campaign_name],
[expedition_type]:
CASE 
[Parameters].[Time After Enter (copy)_6134817547588083712]
WHEN 1 THEN //ALL
    CASE MIN([Parameters].[Date View (copy)])
        WHEN &apos;12h&apos; THEN MIN([users_conversions_tg_12h])
        WHEN &apos;1Day&apos; THEN MIN([users_conversions_tg_day])
        WHEN &apos;7Days&apos; THEN MIN([users_conversions_tg_week])
    END
WHEN 2 THEN //Restaurants
    CASE MIN([Parameters].[Date View (copy)])
        WHEN &apos;12h&apos; THEN MIN([users_conversions_tg_12h_restaurant])
        WHEN &apos;1Day&apos; THEN MIN([users_conversions_tg_day_restaurant])
        WHEN &apos;7Days&apos; THEN MIN([users_conversions_tg_week_restaurant])
    END
WHEN 3 THEN //DMart
    CASE MIN([Parameters].[Date View (copy)])
        WHEN &apos;12h&apos; THEN MIN([users_conversions_tg_12h_dmart])
        WHEN &apos;1Day&apos; THEN MIN([users_conversions_tg_day_dmart])
        WHEN &apos;7Days&apos; THEN MIN([users_conversions_tg_week_dmart])
    END
WHEN 4 THEN //Quick Commerce
    CASE MIN([Parameters].[Date View (copy)])
        WHEN &apos;12h&apos; THEN MIN([users_conversions_tg_12h_quickcommerce])
        WHEN &apos;1Day&apos; THEN MIN([users_conversions_tg_day_quickcommerce])
        WHEN &apos;7Days&apos; THEN MIN([users_conversions_tg_week_quickcommerce])
    END
WHEN 5 THEN //Local Shop
    CASE MIN([Parameters].[Date View (copy)])
