  <column aggregation='Count' caption='Canvas Name Keyword Filter' datatype='boolean' default-type='nominal' name='[Calculation_1190287367040897024]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default'>
