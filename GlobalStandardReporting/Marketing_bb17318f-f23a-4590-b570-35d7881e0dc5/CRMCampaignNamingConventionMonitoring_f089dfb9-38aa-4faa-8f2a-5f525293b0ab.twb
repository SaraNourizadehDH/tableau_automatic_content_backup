  <column aggregation='Sum' caption='Receiver Threshold (Date View dependent)' datatype='integer' default-type='quantitative' name='[Calculation_1583507885161340935]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
    <calculation class='tableau' formula='CASE [date_type]&\#10;when &apos;2-monthly&apos; then 15&\#10;when &apos;monthly&apos; then 15&\#10;when &apos;weekly&apos; then 7&\#10;when &apos;daily&apos; then 1&\#10;end' />
