        <calculation class='tableau' formula='CASE &#10;[Parameters].[Time After Enter (copy)_6134817547588083712]&#10;WHEN 1 THEN //ALL&#10;    IF [Parameters].[Date View (copy)] = &apos;12h&apos; THEN [voucher_eur_cg_12h]&#10;        ELSEIF [Parameters].[Date View (copy)] = &apos;1Day&apos; THEN [voucher_eur_cg_day]&#10;        ELSEIF [Parameters].[Date View (copy)] = &apos;7Days&apos; THEN [voucher_eur_cg_week]&#10;    END&#10;WHEN 2 THEN //Restaurants&#10;    IF [Parameters].[Date View (copy)] = &apos;12h&apos; AND [shop_type]= &apos;restaurants&apos; THEN [voucher_eur_cg_12h]&#10;        ELSEIF [Parameters].[Date View (copy)] = &apos;1Day&apos; AND [shop_type]= &apos;restaurants&apos; THEN [voucher_eur_cg_day]&#10;        ELSEIF [Parameters].[Date View (copy)] = &apos;7Days&apos; AND [shop_type]= &apos;restaurants&apos; THEN [voucher_eur_cg_week]&#10;    END&#10;WHEN 3 THEN //DMart&#10;    IF [Parameters].[Date View (copy)] = &apos;12h&apos; AND [shop_type]= &apos;darkstores&apos; THEN [voucher_eur_cg_12h]&#10;        ELSEIF [Parameters].[Date View (copy)] = &apos;1Day&apos; AND [shop_type]= &apos;darkstores&apos; THEN [voucher_eur_cg_day]&#10;        ELSEIF [Parameters].[Date View (copy)] = &apos;7Days&apos; AND [shop_type]= &apos;darkstores&apos; THEN [voucher_eur_cg_week]&#10;    END&#10;WHEN 4 THEN //Quick Commerce&#10;    IF [Parameters].[Date View (copy)] = &apos;12h&apos; AND [shop_type] &lt;&gt; &apos;restaurants&apos; THEN [voucher_eur_cg_12h]&#10;        ELSEIF [Parameters].[Date View (copy)] = &apos;1Day&apos; AND [shop_type] &lt;&gt; &apos;restaurants&apos; THEN [voucher_eur_cg_day]&#10;        ELSEIF [Parameters].[Date View (copy)] = &apos;7Days&apos; AND [shop_type] &lt;&gt; &apos;restaurants&apos; THEN [voucher_eur_cg_week]&#10;    END&#10;WHEN 5 THEN //Local Shop&#10;    IF [Parameters].[Date View (copy)] = &apos;12h&apos; AND [shop_type] &lt;&gt; &apos;restaurants&apos; AND [shop_type] &lt;&gt; &apos;darkstores&apos; THEN [voucher_eur_cg_12h]&#10;        ELSEIF [Parameters].[Date View (copy)] = &apos;1Day&apos; AND [shop_type] &lt;&gt; &apos;restaurants&apos; AND [shop_type] &lt;&gt; &apos;darkstores&apos; THEN [voucher_eur_cg_day]&#10;        ELSEIF [Parameters].[Date View (copy)] = &apos;7Days&apos; AND [shop_type] &lt;&gt; &apos;restaurants&apos; AND [shop_type] &lt;&gt; &apos;darkstores&apos; THEN [voucher_eur_cg_week]&#10;    END&#10;END' />
      </column>
      <column aggregation='Sum' caption='Control: Receivers' datatype='integer' default-format='n#,##0;-#,##0' default-type='quantitative' layered='true' name='[Target Group Users (copy)_164381441402490885]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
        <calculation class='tableau' formula='{ FIXED &#10;    [Calculation_1134484955555418112],&#10;    [display_name],&#10;    [campaign_name],&#10;    [campaign_type],&#10;    [channel],&#10;    [loyalty_status]:&#10;SUM(CASE [Parameters].[Parameter 9]&#10;        WHEN 1 THEN [users_cg]&#10;        WHEN 2 THEN [users_aid_cg]&#10;    END)&#10;}&#10;&#10;// 16.02.2023&#10;// Non-transactional KPIs don&apos;t have vertical information. That&apos;s means, these KPIs should be same for every vertical.&#10;// Transactional KPIs have vertical information. That&apos;s means, these KPIs should change for every vertical.&#10;// &lt;Receivers&gt; is a non-transactional KPI so fixed LOD calculation is used.' />
      </column>
