    <calculation class='tableau' formula='//IF { FIXED [Campaign Name]: [Increment Orders 7Days]} &lt; 0 AND [Significant Campaign]=TRUE THEN &quot;negative&quot;&\#10;//ELSEIF { FIXED [Campaign Name]: [Increment Orders 7Days]} &gt;= 0 AND [Significant Campaign]=TRUE THEN &quot;positive&quot;&\#10;//ELSE &quot;CG too small&quot;&\#10;//END&\#10;&\#10;IF [Parameters].[Date View (copy)]=&apos;12h&apos; THEN &\#10;    IF &\#10;{ FIXED   &\#10;[sent_date],&\#10;[management_entity],&\#10;[country],&\#10;[display_name],&\#10;[campaign_type],&\#10;[campaign_name]: [Increment Orders (copy)]} &lt; 0 AND [Calculation_956663138992619522]=TRUE THEN &quot;negative&quot;&\#10;    ELSEIF { FIXED   &\#10;[sent_date],&\#10;[management_entity],&\#10;[country],&\#10;[display_name],&\#10;[campaign_type],&\#10;[campaign_name]: [Increment Orders (copy)]} &gt;= 0 AND [Calculation_956663138992619522]=TRUE THEN &quot;positive&quot;&\#10;    ELSE &quot;CG too small&quot;&\#10;    END&\#10;ELSEIF [Parameters].[Date View (copy)]=&apos;1Day&apos; THEN&\#10;    IF { FIXED   &\#10;[sent_date],&\#10;[management_entity],&\#10;[country],&\#10;[display_name],&\#10;[campaign_type],&\#10;[campaign_name]: [Calculation_941252330473996298]} &lt; 0 AND [Calculation_956663138992619522]=TRUE THEN &quot;negative&quot;&\#10;    ELSEIF { FIXED   &\#10;[sent_date],&\#10;[management_entity],&\#10;[country],&\#10;[display_name],&\#10;[campaign_type],&\#10;[campaign_name]: [Calculation_941252330473996298]} &gt;= 0 AND [Calculation_956663138992619522]=TRUE THEN &quot;positive&quot;&\#10;    ELSE &quot;CG too small&quot;&\#10;    END&\#10;ELSEIF [Parameters].[Date View (copy)]=&apos;7Days&apos; THEN&\#10;    IF { FIXED   &\#10;[sent_date],&\#10;[management_entity],&\#10;[country],&\#10;[display_name],&\#10;[campaign_type],&\#10;[campaign_name]: [Calculation_941252330474115083]} &lt; 0 AND [Calculation_956663138992619522]=TRUE THEN &quot;negative&quot;&\#10;    ELSEIF { FIXED   &\#10;[sent_date],&\#10;[management_entity],&\#10;[country],&\#10;[display_name],&\#10;[campaign_type],&\#10;[campaign_name]: [Calculation_941252330474115083]} &gt;= 0 AND [Calculation_956663138992619522]=TRUE THEN &quot;positive&quot;&\#10;    ELSE &quot;CG too small&quot;&\#10;    END&\#10;END' />
  </column>
