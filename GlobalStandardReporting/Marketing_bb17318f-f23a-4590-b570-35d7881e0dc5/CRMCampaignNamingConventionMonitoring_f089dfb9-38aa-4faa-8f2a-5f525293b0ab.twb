  <column aggregation='User' caption='GMV Proportion (FIXED Logic)' datatype='real' default-format='p0.0\%' default-type='quantitative' name='[Calculation_1384294003434602498]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
    <calculation class='tableau' formula='//Based on Baseline&\#10;//[Incremental GMV (FIXED Logic)]/([Target: Receivers] * [Control: GMV Per Receiver (FIXED Logic)])&\#10;&\#10;//Based on Target&\#10;[Incremental Orders (FIXED logic) (copy)_6919429020978581504] / [Target: Orders (copy)_6919429020999331848]' />
  </column>
  <column aggregation='Year' caption='Execute Date - 1' datatype='datetime' default-type='ordinal' name='[Calculation_1392104922421796864]' pivot='key' role='dimension' type='ordinal' user-datatype='datetime' visual-totals='Default'>
