            <column caption='Second Variant To Compare' datatype='string' name='[First Variant To Compare (copy)_3321897337257922562]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Variant A vs Baseline&quot; THEN &quot;Baseline&quot;&#10;WHEN &quot;Variant B vs Baseline&quot; THEN &quot;Baseline&quot;&#10;WHEN &quot;Variant B vs Variant A&quot; THEN &quot;Variant A&quot;&#10;END' />
            </column>
            <column caption='Variants' datatype='boolean' name='[Variants (copy)_1879126963555889156]' role='dimension' type='nominal'>
