    <worksheet name='Post ∆'>
      <table>
        <view>
          <datasources>
            <datasource caption='triple_trouble_experiment_hs_sa' name='federated.0hr6f8u087m4kg1bqrbfm17yze5s' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Date Level' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
            <column caption='Select Variants' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Variant A vs Baseline&quot;'>
              <calculation class='tableau' formula='&quot;Variant A vs Baseline&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0hr6f8u087m4kg1bqrbfm17yze5s'>
            <column caption='% Live Order Inquiries Contact Rate ' datatype='real' default-format='p0.000%' name='[%  Live Order Inquiries Contact Rate (∆ Divergence) (copy)_4565524149296615449]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([live_order_inquiries_contacts])&#10;    /&#10;    SUM([orders])' />
            </column>
            <column caption='% Seamless Orders' datatype='real' default-format='p0.000%' name='[% Customer Fail Rate (copy)_6910281072209108992]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([seamless_orders])/SUM([orders])' />
            </column>
            <column caption='% Vendor Fail Rate' datatype='real' default-format='p0.00%' name='[% Item Unavailable Fail Rate (copy)_4565524149295542293]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_failed_orders])/SUM([orders])' />
            </column>
            <column caption='% Compensated Orders' datatype='real' default-format='p0.000%' name='[% Seamless Orders (copy)_4087509276688703492]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([compensated_orders])/SUM([orders])' />
            </column>
            <column caption='% Refunded Orders' datatype='real' default-format='p0.000%' name='[% Seamless Orders (copy)_4087509276689014791]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([refunded_orders])/SUM([orders])' />
            </column>
            <column caption='% Closed Vendor Fail Rate' datatype='real' default-format='p0.00%' name='[% Vendor Fail Rate (copy)_3638345580065656832]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([closed_vendor_failed_orders])/SUM([orders])' />
            </column>
            <column caption='% Too Busy Vendor Fail Rate' datatype='real' default-format='p0.00%' name='[% Vendor Fail Rate (copy)_3638345580065923075]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([too_busy_vendor_failed_orders])/SUM([orders])' />
            </column>
            <column caption='% Vendor Contact Rate' datatype='real' default-format='p0.000%' name='[% Vendor Fail Rate (copy)_4565524149295779862]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_contacts])/SUM([orders])' />
            </column>
            <column caption='% Fail Rate' datatype='real' default-format='p0.00%' name='[% Vendor Fail Rate (copy)_4868320897008328704]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_orders])/SUM([orders])' />
            </column>
            <column caption='% No Response Vendor Fail Rate' datatype='real' name='[Calculation_1984680089613533184]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_response_vendor_failed_orders])/SUM([orders])' />
            </column>
            <column caption='aVTC (minutes)' datatype='real' name='[Calculation_1984680089634066440]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([at_vendor_time_cleaned])/SUM([at_vendor_time_cleaned_orders])' />
            </column>
            <column caption='Vendor Late' datatype='real' name='[Calculation_1984680089637269513]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_10_orders])/SUM([vendor_late_orders])' />
            </column>
            <column caption='% On Time Orders' datatype='real' name='[Calculation_1984680089640300558]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([on_time_orders])/SUM([orders])' />
            </column>
            <column caption='% Rider Contact Rate' datatype='real' name='[Calculation_2434195638697463808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_contacts])/SUM([orders])' />
            </column>
            <column caption='% Customer Contact Rate' datatype='real' name='[Calculation_2434195638697549825]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([customer_contacts])/SUM([orders])' />
            </column>
