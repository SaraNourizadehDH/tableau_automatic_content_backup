    <worksheet name='Metrics Line Chart + Delta'>
      <layout-options>
        <title>
          <formatted-text>
            <run>&lt;</run>
            <run>[Parameters].[Parameter 4]</run>
            <run>&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='triple_trouble_experiment_hs_sa' name='federated.0hr6f8u087m4kg1bqrbfm17yze5s' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Date Level' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
            <column caption='Select Variants' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Variant A vs Baseline&quot;'>
              <calculation class='tableau' formula='&quot;Variant A vs Baseline&quot;' />
            </column>
            <column caption='Select Metric' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% Refunded Orders&quot;'>
              <calculation class='tableau' formula='&quot;% Refunded Orders&quot;' />
              <aliases>
                <alias key='&quot;\% Contact Rate&quot;' value='% Contact Rate' />
                <alias key='&quot;\% Item Unavailable Vendor Fail Rate&quot;' value='% Item Unavailable Fail Rate' />
                <alias key='&quot;\% Vendor Fail Rate&quot;' value='% Vendor Fail Rate' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0hr6f8u087m4kg1bqrbfm17yze5s'>
            <column caption='% Live Order Inquiries Contact Rate ' datatype='real' default-format='p0.000%' name='[%  Live Order Inquiries Contact Rate (∆ Divergence) (copy)_4565524149296615449]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([live_order_inquiries_contacts])&#10;    /&#10;    SUM([orders])' />
            </column>
            <column caption='% Seamless Orders' datatype='real' default-format='p0.000%' name='[% Customer Fail Rate (copy)_6910281072209108992]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([seamless_orders])/SUM([orders])' />
            </column>
            <column caption='% Vendor Fail Rate' datatype='real' default-format='p0.00%' name='[% Item Unavailable Fail Rate (copy)_4565524149295542293]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_failed_orders])/SUM([orders])' />
            </column>
            <column caption='% Compensated Orders' datatype='real' default-format='p0.000%' name='[% Seamless Orders (copy)_4087509276688703492]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([compensated_orders])/SUM([orders])' />
            </column>
            <column caption='% Refunded Orders' datatype='real' default-format='p0.000%' name='[% Seamless Orders (copy)_4087509276689014791]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([refunded_orders])/SUM([orders])' />
            </column>
            <column caption='% Closed Vendor Fail Rate' datatype='real' default-format='p0.00%' name='[% Vendor Fail Rate (copy)_3638345580065656832]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([closed_vendor_failed_orders])/SUM([orders])' />
            </column>
            <column caption='% Too Busy Vendor Fail Rate' datatype='real' default-format='p0.00%' name='[% Vendor Fail Rate (copy)_3638345580065923075]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([too_busy_vendor_failed_orders])/SUM([orders])' />
            </column>
            <column caption='% Vendor Contact Rate' datatype='real' default-format='p0.000%' name='[% Vendor Fail Rate (copy)_4565524149295779862]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_contacts])/SUM([orders])' />
            </column>
            <column caption='% Fail Rate' datatype='real' default-format='p0.00%' name='[% Vendor Fail Rate (copy)_4868320897008328704]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_orders])/SUM([orders])' />
            </column>
            <column caption='% No Response Vendor Fail Rate' datatype='real' name='[Calculation_1984680089613533184]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_response_vendor_failed_orders])/SUM([orders])' />
            </column>
            <column caption='aVTC (minutes)' datatype='real' name='[Calculation_1984680089634066440]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([at_vendor_time_cleaned])/SUM([at_vendor_time_cleaned_orders])' />
            </column>
            <column caption='Vendor Late' datatype='real' name='[Calculation_1984680089637269513]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_10_orders])/SUM([vendor_late_orders])' />
            </column>
            <column caption='% On Time Orders' datatype='real' name='[Calculation_1984680089640300558]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([on_time_orders])/SUM([orders])' />
            </column>
            <column caption='% Rider Contact Rate' datatype='real' name='[Calculation_2434195638697463808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_contacts])/SUM([orders])' />
            </column>
            <column caption='% Customer Contact Rate' datatype='real' name='[Calculation_2434195638697549825]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([customer_contacts])/SUM([orders])' />
            </column>
            <column caption='% Auto Accept Orders ' datatype='real' name='[Calculation_2434195638708011014]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([auto_accepted_orders])/SUM([orders])' />
            </column>
            <column caption='First Variant To Compare' datatype='string' name='[Calculation_3321897337252679681]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Variant A vs Baseline&quot; THEN &quot;Variant A&quot;&#10;WHEN &quot;Variant B vs Baseline&quot; THEN &quot;Variant B&quot;&#10;WHEN &quot;Variant B vs Variant A&quot; THEN &quot;Variant B&quot;&#10;END' />
            </column>
            <column caption='Metrics' datatype='real' name='[Calculation_3902369094159556608]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;&#10;WHEN &quot;% Fail Rate&quot; THEN [% Vendor Fail Rate (copy)_4868320897008328704]&#10;WHEN &quot;% Vendor Fail Rate&quot; THEN [% Item Unavailable Fail Rate (copy)_4565524149295542293]&#10;WHEN &quot;% Item Unavailable Vendor Fail Rate&quot; THEN [Calculation_4565524149076819972]&#10;WHEN &quot;% Closed Vendor Fail Rate&quot; THEN [% Vendor Fail Rate (copy)_3638345580065656832]&#10;WHEN &quot;% Too Busy Vendor Fail Rate&quot; THEN [% Vendor Fail Rate (copy)_3638345580065923075]&#10;WHEN &quot;% No Response Vendor Fail Rate&quot; THEN [Calculation_1984680089613533184]&#10;&#10;WHEN &quot;% Contact Rate&quot; THEN [Calculation_6910281072216588291]&#10;WHEN &quot;% Vendor Contact Rate&quot; THEN [% Vendor Fail Rate (copy)_4565524149295779862]&#10;WHEN &quot;% Rider Contact Rate&quot; THEN [Calculation_2434195638697463808]&#10;WHEN &quot;% Customer Contact Rate&quot; THEN [Calculation_2434195638697549825]&#10;WHEN &quot;% Live Order Inquiries Contact Rate&quot; THEN [%  Live Order Inquiries Contact Rate (∆ Divergence) (copy)_4565524149296615449]&#10;&#10;WHEN &quot;aVTC&quot; THEN [Calculation_1984680089634066440]&#10;WHEN &quot;Vendor Late Above 10&quot; THEN [Calculation_1984680089637269513]&#10;&#10;WHEN &quot;% Auto Accept Orders&quot; THEN [Calculation_2434195638708011014]&#10;WHEN &quot;% On Time Orders&quot; THEN [Calculation_1984680089640300558]&#10;WHEN &quot;% Seamless Orders&quot; THEN [% Customer Fail Rate (copy)_6910281072209108992]&#10;&#10;WHEN &quot;% Compensated Orders&quot; THEN [% Seamless Orders (copy)_4087509276688703492]&#10;WHEN &quot;% Refunded Orders&quot; THEN [% Seamless Orders (copy)_4087509276689014791]&#10;&#10;END' />
            </column>
            <column caption='Metrics (∆)' datatype='real' name='[Calculation_3902369094162780161]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;(SUM(IF [experiment_group] = [Calculation_3321897337252679681] THEN [Calculation_3902369094162980866] END) / [Calculation_3902369094168502277])&#10;   &#10;/&#10;&#10;(SUM(IF [experiment_group] = [First Variant To Compare (copy)_3321897337257922562] THEN [Calculation_3902369094162980866] END) / [Calculation_3902369094168055812])&#10;)&#10;&#10;- 1' />
            </column>
            <column caption='∆  Metrics Numerator' datatype='integer' name='[Calculation_3902369094162980866]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &quot;% Fail Rate&quot; THEN [failed_orders]&#10;WHEN &quot;% Vendor Fail Rate&quot; THEN [vendor_failed_orders]&#10;WHEN &quot;% Item Unavailable Vendor Fail Rate&quot; THEN [item_unavailable_vendor_failed_orders]&#10;WHEN &quot;% Closed Vendor Fail Rate&quot; THEN [closed_vendor_failed_orders]&#10;WHEN &quot;% Too Busy Vendor Fail Rate&quot; THEN [too_busy_vendor_failed_orders]&#10;WHEN &quot;% No Response Vendor Fail Rate&quot; THEN [too_busy_vendor_failed_orders]&#10;&#10;WHEN &quot;% Contact Rate&quot; THEN [total_contacts]&#10;WHEN &quot;% Vendor Contact Rate&quot; THEN [vendor_contacts]&#10;WHEN &quot;% Rider Contact Rate&quot; THEN [rider_contacts]&#10;WHEN &quot;% Customer Contact Rate&quot; THEN [customer_contacts]&#10;WHEN &quot;% Live Order Inquiries Contact Rate&quot; THEN [live_order_inquiries_contacts]&#10;&#10;WHEN &quot;aVTC&quot; THEN [at_vendor_time_cleaned]&#10;WHEN &quot;Vendor Late&quot; THEN [vendor_late_10_orders]&#10;&#10;WHEN &quot;% Auto Accept Orders&quot; THEN [auto_accepted_orders]&#10;WHEN &quot;% On Time Orders&quot; THEN [on_time_orders]&#10;WHEN &quot;% Seamless Orders&quot; THEN [seamless_orders]&#10;&#10;WHEN &quot;% Compensated Orders&quot; THEN [compensated_orders]&#10;WHEN &quot;% Refunded Orders&quot; THEN [refunded_orders]&#10;&#10;END' />
            </column>
            <column caption='∆  Metrics Denominator - Second Variant' datatype='integer' name='[Calculation_3902369094168055812]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;&#10;WHEN &quot;% Fail Rate&quot; THEN SUM(IF [experiment_group] = [First Variant To Compare (copy)_3321897337257922562] THEN [orders] END)&#10;WHEN &quot;% Vendor Fail Rate&quot; THEN SUM(IF [experiment_group] = [First Variant To Compare (copy)_3321897337257922562] THEN [orders] END)&#10;WHEN &quot;% Item Unavailable Vendor Fail Rate&quot; THEN SUM(IF [experiment_group] = [First Variant To Compare (copy)_3321897337257922562] THEN [orders] END)&#10;WHEN &quot;% Closed Vendor Fail Rate&quot; THEN SUM(IF [experiment_group] = [First Variant To Compare (copy)_3321897337257922562] THEN [orders] END)&#10;WHEN &quot;% Too Busy Vendor Fail Rate&quot; THEN SUM(IF [experiment_group] = [First Variant To Compare (copy)_3321897337257922562] THEN [orders] END)&#10;WHEN &quot;% No Response Vendor Fail Rate&quot; THEN SUM(IF [experiment_group] = [First Variant To Compare (copy)_3321897337257922562] THEN [orders] END)&#10;&#10;WHEN &quot;% Contact Rate&quot; THEN SUM(IF [experiment_group] = [First Variant To Compare (copy)_3321897337257922562] THEN [orders] END)&#10;WHEN &quot;% Vendor Contact Rate&quot; THEN SUM(IF [experiment_group] = [First Variant To Compare (copy)_3321897337257922562] THEN [orders] END)&#10;WHEN &quot;% Rider Contact Rate&quot; THEN SUM(IF [experiment_group] = [First Variant To Compare (copy)_3321897337257922562] THEN [orders] END)&#10;WHEN &quot;% Customer Contact Rate&quot; THEN SUM(IF [experiment_group] = [First Variant To Compare (copy)_3321897337257922562] THEN [orders] END)&#10;WHEN &quot;% Live Order Inquiries Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;&#10;WHEN &quot;aVTC&quot; THEN SUM(IF [experiment_group] = [First Variant To Compare (copy)_3321897337257922562] THEN [at_vendor_time_cleaned_orders] END)&#10;WHEN &quot;Vendor Late&quot; THEN SUM(IF [experiment_group] = [First Variant To Compare (copy)_3321897337257922562] THEN [vendor_late_10_orders] END)&#10;&#10;WHEN &quot;% Auto Accept Orders&quot; THEN SUM(IF [experiment_group] = [First Variant To Compare (copy)_3321897337257922562] THEN [orders] END)&#10;WHEN &quot;% On Time Orders&quot; THEN SUM(IF [experiment_group] = [First Variant To Compare (copy)_3321897337257922562] THEN [orders] END)&#10;WHEN &quot;% Seamless Orders&quot; THEN SUM(IF [experiment_group] = [First Variant To Compare (copy)_3321897337257922562] THEN [orders] END)&#10;&#10;WHEN &quot;% Compensated Orders&quot; THEN SUM(IF [experiment_group] = [First Variant To Compare (copy)_3321897337257922562] THEN [orders] END)&#10;WHEN &quot;% Refunded Orders&quot; THEN SUM(IF [experiment_group] = [First Variant To Compare (copy)_3321897337257922562] THEN [orders] END)&#10;&#10;END' />
            </column>
            <column caption='∆  Metrics Denominator - First Variant' datatype='integer' name='[Calculation_3902369094168502277]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;&#10;WHEN &quot;% Fail Rate&quot; THEN SUM(IF [experiment_group] = [Calculation_3321897337252679681] THEN [orders] END)&#10;WHEN &quot;% Vendor Fail Rate&quot; THEN SUM(IF [experiment_group] = [Calculation_3321897337252679681] THEN [orders] END)&#10;WHEN &quot;% Item Unavailable Vendor Fail Rate&quot; THEN SUM(IF [experiment_group] = [Calculation_3321897337252679681] THEN [orders] END)&#10;WHEN &quot;% Closed Vendor Fail Rate&quot; THEN SUM(IF [experiment_group] = [Calculation_3321897337252679681] THEN [orders] END)&#10;WHEN &quot;% Too Busy Vendor Fail Rate&quot; THEN SUM(IF [experiment_group] = [Calculation_3321897337252679681] THEN [orders] END)&#10;WHEN &quot;% No Response Vendor Fail Rate&quot; THEN SUM(IF [experiment_group] = [Calculation_3321897337252679681] THEN [orders] END)&#10;&#10;WHEN &quot;% Contact Rate&quot; THEN SUM(IF [experiment_group] = [Calculation_3321897337252679681] THEN [orders] END)&#10;WHEN &quot;% Vendor Contact Rate&quot; THEN SUM(IF [experiment_group] = [Calculation_3321897337252679681] THEN [orders] END)&#10;WHEN &quot;% Rider Contact Rate&quot; THEN SUM(IF [experiment_group] = [Calculation_3321897337252679681] THEN [orders] END)&#10;WHEN &quot;% Customer Contact Rate&quot; THEN SUM(IF [experiment_group] = [Calculation_3321897337252679681] THEN [orders] END)&#10;WHEN &quot;% Live Order Inquiries Contact Rate&quot; THEN SUM(IF [experiment_group] = [Calculation_3321897337252679681] THEN [orders] END)&#10;&#10;WHEN &quot;aVTC&quot; THEN SUM(IF [experiment_group] = [Calculation_3321897337252679681] THEN [at_vendor_time_cleaned_orders] END)&#10;WHEN &quot;Vendor Late&quot; THEN SUM(IF [experiment_group] = [Calculation_3321897337252679681] THEN [vendor_late_10_orders] END)&#10;&#10;WHEN &quot;% Auto Accept Orders&quot; THEN SUM(IF [experiment_group] = [Calculation_3321897337252679681] THEN [orders] END)&#10;WHEN &quot;% On Time Orders&quot; THEN SUM(IF [experiment_group] = [Calculation_3321897337252679681] THEN [orders] END)&#10;WHEN &quot;% Seamless Orders&quot; THEN SUM(IF [experiment_group] = [Calculation_3321897337252679681] THEN [orders] END)&#10;&#10;WHEN &quot;% Compensated Orders&quot; THEN SUM(IF [experiment_group] = [Calculation_3321897337252679681] THEN [orders] END)&#10;WHEN &quot;% Refunded Orders&quot; THEN SUM(IF [experiment_group] = [Calculation_3321897337252679681] THEN [orders] END)&#10;&#10;&#10;END' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_4565524148946345986]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Daily&quot; THEN STR(DATE([created_date_local]))&#10;WHEN &quot;Weekly&quot; THEN STR(YEAR([created_date_local]))+&quot;-W&quot;+STR(WEEK([created_date_local]))&#10;END' />
