              <calculation class='tableau' formula='(&#10;    SUM({ INCLUDE [Calculation_4565524148946345986]:&#10;    SUM(IF [experiment_group] = [Calculation_3321897337252679681] AND [rollout_phase] = &apos;POST&apos; THEN [live_order_inquiries_contacts] END)&#10;    /&#10;    SUM(IF [experiment_group] = [Calculation_3321897337252679681] AND [rollout_phase] = &apos;POST&apos; THEN [orders] END)&#10;    })&#10;&#10;    -&#10;&#10;    SUM({ INCLUDE [Calculation_4565524148946345986]:&#10;    SUM(IF [experiment_group] = [First Variant To Compare (copy)_3321897337257922562] AND [rollout_phase] = &apos;POST&apos; THEN [live_order_inquiries_contacts] END)&#10;    /&#10;    SUM(IF [experiment_group] = [First Variant To Compare (copy)_3321897337257922562] AND [rollout_phase] = &apos;POST&apos; THEN [orders] END)&#10;    })&#10;)&#10;-&#10;(&#10;    SUM({ INCLUDE [Calculation_4565524148946345986]:&#10;    SUM(IF [experiment_group] = [Calculation_3321897337252679681] AND [rollout_phase] = &apos;PRE&apos; THEN [live_order_inquiries_contacts] END)&#10;    /&#10;    SUM(IF [experiment_group] = [Calculation_3321897337252679681] AND [rollout_phase] = &apos;PRE&apos; THEN [orders] END)&#10;    })&#10;    -&#10;    SUM({ INCLUDE [Calculation_4565524148946345986]:&#10;    SUM(IF [experiment_group] = [First Variant To Compare (copy)_3321897337257922562] AND [rollout_phase] = &apos;PRE&apos; THEN [live_order_inquiries_contacts] END)&#10;    /&#10;    SUM(IF [experiment_group] = [First Variant To Compare (copy)_3321897337257922562] AND [rollout_phase] = &apos;PRE&apos; THEN [orders] END)&#10;    })&#10;)' />
