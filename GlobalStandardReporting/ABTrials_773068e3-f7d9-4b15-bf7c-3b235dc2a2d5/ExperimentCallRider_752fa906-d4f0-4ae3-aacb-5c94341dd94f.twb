      </column>
      <column caption='∆  Metrics Numerator' datatype='real' name='[Calculation_3902369094162980866]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;// based on total orders&#10;WHEN &quot;% Fail Rate&quot; THEN [failed_orders]&#10;WHEN &quot;% Customer Fail Rate&quot; THEN [customer_failed_orders]&#10;WHEN &quot;% Vendor Fail Rate&quot; THEN [vendor_failed_orders]&#10;WHEN &quot;% Rider Fail Rate&quot; THEN [rider_failed_orders]&#10;&#10;// contacts&#10;WHEN &quot;% Contact Rate&quot; THEN [vendor_customer_contacts]&#10;WHEN &quot;% Vendor Contact Rate&quot; THEN [vendor_contacts]&#10;WHEN &quot;...% V Delivery Late Contact Rate&quot; THEN [vendor_late_delivery_contacts]&#10;WHEN &quot;...% Order Picked by Wrong Rider Contact Rate&quot; THEN [order_picked_wrong_rider_contacts]&#10;WHEN &quot;...% Rider Left Some Items Contact Rate&quot; THEN [rider_left_items_contacts]&#10;WHEN &quot;% Rider Contact Rate&quot; THEN [rider_contacts]&#10;WHEN &quot;...% Rider Late Preparation Contact Rate&quot; THEN [rider_late_preparation_contacts]&#10;WHEN &quot;% Customer Contact Rate&quot; THEN [customer_contacts]&#10;WHEN &quot;% Live Order Inquiries Contact Rate&quot; THEN [live_order_inquiries_contacts]&#10;WHEN &quot;...% Vendor Live Order CR&quot; THEN [vendor_live_order_contacts]&#10;&#10;&#10;WHEN &quot;% Inaccurate Order CR&quot; THEN [inaccurate_order_contacts]&#10;WHEN &quot;...% C Wrong Item Contact Rate&quot; THEN [customer_wrong_item_contacts]&#10;WHEN &quot;...% C Wrong Order Contact Rate&quot; THEN  [customer_wrong_order_contacts]&#10;WHEN &quot;...% C Missing Item Contact Rate&quot; THEN [customer_missing_item_contacts]&#10;&#10;&#10;//&#10;WHEN &quot;aVTC&quot; THEN [avtc]&#10;WHEN &quot;Vendor Late Above 10&quot; THEN [_pcnt_vendor_late_10]&#10;//orders&#10;WHEN &quot;Orders on Time&quot; THEN [on_time_order]&#10;&#10;&#10;WHEN &quot;# Events&quot; THEN [num_events]&#10;WHEN &quot;# Vendors with event&quot; THEN [vendors_with_events]&#10;WHEN &quot;# Vendors with event&quot; THEN [vendors_with_events]&#10;WHEN &quot;% Vendors with &gt;1 event&quot; THEN [vendors_with_multiple_events]&#10;WHEN &quot;# Vendors with &gt;1 event&quot; THEN [vendors_with_multiple_events]&#10;&#10;WHEN &quot;% Orders with events&quot; THEN [orders_with_events]&#10;WHEN &quot;# Orders with event&quot; THEN [orders_with_events]&#10;WHEN &quot;% Orders with &gt;1 event&quot; THEN [orders_with_multiple_events]&#10;WHEN &quot;# Orders with &gt;1 event&quot; THEN[orders_with_multiple_events]&#10;END' />
      </column>
      <column caption='∆  Metrics Denominator - Baseline' datatype='integer' name='[Calculation_3902369094168055812]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;// based on total orders&#10;WHEN &quot;% Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;% Customer Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;% Vendor Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;% Rider Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;&#10;// contacts&#10;WHEN &quot;% Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;% Vendor Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;% Rider Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;% Customer Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;% Live Order Inquiries Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;&#10;WHEN &quot;...% V Delivery Late Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;...% Order Picked by Wrong Rider Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;...% Rider Left Some Items Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;...% Rider Late Preparation Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;% Customer Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;...% Vendor Live Order CR&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;&#10;&#10;WHEN &quot;% Inaccurate Order CR&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;...% C Wrong Item Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;...% C Wrong Order Contact Rate&quot; THEN  SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;...% C Missing Item Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;&#10;//&#10;WHEN &quot;aVTC&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [platform_order_code_avtc] END)&#10;WHEN &quot;Vendor Late Above 10&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [vendor_late_calculation] END)&#10;//orders&#10;WHEN &quot;Auto Accept Orders&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;Orders on Time&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;Seamless Orders&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;&#10;WHEN &quot;% Vendors with &gt;1 event&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;&#10;WHEN &quot;% Orders with &gt;1 event&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;&#10;END' />
      </column>
      <column caption='∆  Metrics Denominator - Variant A' datatype='integer' name='[Calculation_3902369094168502277]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;// based on total orders&#10;WHEN &quot;% Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;% Customer Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;% Vendor Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;% Rider Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;&#10;// contacts&#10;WHEN &quot;% Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;% Vendor Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;% Rider Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;% Customer Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;% Live Order Inquiries Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;&#10;WHEN &quot;...% V Delivery Late Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;...% Order Picked by Wrong Rider Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;...% Rider Left Some Items Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;...% Rider Late Preparation Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;% Customer Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;...% Vendor Live Order CR&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;&#10;&#10;WHEN &quot;% Inaccurate Order CR&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;...% C Wrong Item Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;...% C Wrong Order Contact Rate&quot; THEN  SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;...% C Missing Item Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;&#10;//&#10;WHEN &quot;aVTC&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [platform_order_code_avtc] END)&#10;WHEN &quot;Vendor Late Above 10&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [vendor_late_calculation] END)&#10;//orders&#10;WHEN &quot;Auto Accept Orders&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;Orders on Time&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;Seamless Orders&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;&#10;WHEN &quot;% Vendors with &gt;1 event&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;&#10;WHEN &quot;% Orders with &gt;1 event&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;&#10;END' />
