        <calculation class='tableau' formula='(&#10;    (&#10;    SUM({ INCLUDE [date_type]:&#10;     &#10;        SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;POST&apos; THEN [avtc] END)&#10;        })&#10;    /&#10;&#10;    SUM({ INCLUDE [date_type]:&#10;     &#10;        SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;POST&apos; THEN [platform_order_code_avtc] END)&#10;        })&#10;    )&#10;    &#10;    -&#10;    &#10;    (&#10;         SUM({ INCLUDE [date_type]:&#10;            SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;POST&apos; THEN [avtc] END)&#10;            })&#10;        /&#10;         SUM({ INCLUDE [date_type]:&#10;            SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;POST&apos; THEN [platform_order_code_avtc] END)&#10;            })&#10;    )&#10;&#10;)&#10;&#10;-&#10;&#10;(&#10;    (&#10;    SUM({ INCLUDE [date_type]:&#10;     &#10;        SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;PRE&apos; THEN [avtc] END)&#10;        })&#10;    /&#10;&#10;    SUM({ INCLUDE [date_type]:&#10;     &#10;        SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;PRE&apos; THEN [platform_order_code_avtc] END)&#10;        })&#10;    )&#10;    &#10;    -&#10;    &#10;    (&#10;         SUM({ INCLUDE [date_type]:&#10;            SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;PRE&apos; THEN [avtc] END)&#10;            })&#10;        /&#10;         SUM({ INCLUDE [date_type]:&#10;            SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;PRE&apos; THEN [platform_order_code_avtc] END)&#10;            })&#10;    )&#10;&#10;)' />
      </column>
      <column caption='#On Time Orders (∆ Divergence)' datatype='real' name='[Calculation_1984680089898557462]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;    SUM({ INCLUDE [date_type]:&#10; &#10;    SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;POST&apos; THEN [on_time_order] END)&#10;    })&#10;&#10;    /&#10;&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;POST&apos; THEN [on_time_order] END)&#10;    })&#10;&#10;    - 1&#10;)&#10;-&#10;(&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;PRE&apos; THEN [on_time_order] END)&#10;    })&#10;    /&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;PRE&apos; THEN [on_time_order] END)&#10;    })&#10;    - 1&#10;)' />
