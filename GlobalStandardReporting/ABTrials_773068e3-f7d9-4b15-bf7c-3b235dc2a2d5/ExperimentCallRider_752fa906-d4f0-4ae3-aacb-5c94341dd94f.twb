      <column caption='_int_metrics' datatype='integer' name='[Calculation_4047962031569936392]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;aVTC&apos; THEN 1&#10;WHEN &apos;# Vendors with event&apos; THEN 1&#10;WHEN &apos;# Order&apos; THEN 1&#10;WHEN &apos;# Events&apos; THEN 1&#10;WHEN &quot;# Orders with events&quot; THEN 1&#10;WHEN &quot;# Orders with &gt;1 event&quot; THEN 1&#10;WHEN &quot;# Vendors with &gt;1 event&quot; THEN 1&#10;&#10;ELSE 0&#10;END' />
