      <column caption='Reset All Button' datatype='string' name='[Apply All Button (copy)_5490380533408673801]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Reset All&quot;' />
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendors_with_events]) / TOTAL(SUM([vendors_with_events]))'>
          <table-calc ordering-type='CellInPane' />
        </calculation>
      </column>
      <column caption='Vendors view rider location' datatype='integer' name='[Calculation_1241234335264649218]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vendors_with_events])' />
      </column>
      <column caption='_user_entitlement_' datatype='boolean' name='[Calculation_1257559829120208896]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='info button' datatype='string' name='[Calculation_1313291885395673088]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;i&quot;&#10;&#10;//this is a placeholder calculation that is going to create the shape of info button' />
      </column>
      <column caption='Where?' datatype='string' name='[Calculation_1322791664377708565]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE[entity_id]&#10;WHEN &apos;FP_BD&apos;&#10;THEN &apos;Rolled out in FP_BD on 28.10&apos;&#10;ELSE &apos;Rolled out everywhere else on 30.10&apos;&#10;END' />
      </column>
      <column caption='Date?' datatype='boolean' name='[Calculation_1322791664381227033]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_4565524148946345986] &gt;= &apos;2024-10-28&apos;' />
      </column>
      <column caption='Fail Rate Delta' datatype='real' name='[Calculation_138133844993904643]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(   // varient A&#10;    (SUM(IF [experiment_group] = [Parameters].[Parameter 2] THEN [failed_orders] END)&#10;      / SUM(IF [experiment_group] = [Parameters].[Parameter 2] THEN [orders] END) &#10;     ) &#10;    &#10;/&#10;  // Baseline&#10;    (SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [failed_orders] END)&#10;    / SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END) &#10;    )&#10;)&#10;- 1' />
      </column>
      <column caption='Variant A' datatype='string' name='[Calculation_147492907181047814]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Variant A&quot;' />
      </column>
      <column caption='Variants' datatype='boolean' name='[Calculation_1879126963554250754]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;&#10;WHEN &quot;Variant A&quot; THEN [experiment_group] = &quot;Variant A&quot;&#10;&#10;END' />
      </column>
      <column caption='% Closed Fail Rate' datatype='real' name='[Calculation_1899745034836893697]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([closed_failed_vendor])/SUM([orders])' />
      </column>
      <column caption='% No Response Fail Rate' datatype='real' name='[Calculation_1984680089613533184]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([no_response_failed_vendor])/SUM([orders])' />
      </column>
      <column caption='% No Response Fail Rate (∆ Divergence)' datatype='real' name='[Calculation_1984680089614422018]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;POST&apos; THEN [no_response_failed_vendor] END)&#10;    /&#10;    SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;POST&apos; THEN [orders] END)&#10;    })&#10;&#10;    /&#10;&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;POST&apos; THEN [no_response_failed_vendor] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;POST&apos; THEN [orders] END)&#10;    })&#10;&#10;    - 1&#10;)&#10;-&#10;(&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;PRE&apos; THEN [no_response_failed_vendor] END)&#10;    /&#10;    SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;PRE&apos; THEN [orders] END)&#10;    })&#10;    /&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;PRE&apos; THEN [no_response_failed_vendor] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;PRE&apos; THEN [orders] END)&#10;    })&#10;    - 1&#10;)' />
      </column>
      <column caption='No Response Fail Rate Delta' datatype='real' name='[Calculation_1984680089619181571]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(   // varient A&#10;    (SUM(IF [experiment_group] = [Parameters].[Parameter 2] THEN [no_response_failed_vendor] END)&#10;      / SUM(IF [experiment_group] = [Parameters].[Parameter 2] THEN [orders] END) &#10;     ) &#10;    &#10;/&#10;  // Baseline&#10;    (SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [no_response_failed_vendor] END)&#10;    / SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END) &#10;    )&#10;)&#10;- 1' />
      </column>
      <column caption='aVTC Delta' datatype='real' name='[Calculation_1984680089633767431]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(   // varient A&#10;  SUM(IF [experiment_group] = [Parameters].[Parameter 2] THEN [avtc] END)&#10;/  SUM(IF [experiment_group] = [Parameters].[Parameter 2] THEN [platform_order_code_avtc] END) &#10;)    &#10;    &#10;/&#10;(  // Baseline&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [avtc] END)&#10;/SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [platform_order_code_avtc] END) &#10;    &#10;)&#10;- 1' />
      </column>
      <column caption='aVTC (minutes)' datatype='real' name='[Calculation_1984680089634066440]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([avtc])/SUM([platform_order_code_avtc])' />
      </column>
      <column caption='Vendor Late Above 10' datatype='real' name='[Calculation_1984680089637269513]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([_pcnt_vendor_late_10])/SUM([vendor_late_calculation])' />
      </column>
      <column caption='Vendor Late Above 10 Delta' datatype='real' name='[Calculation_1984680089637769228]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(   // varient A&#10;  SUM(IF [experiment_group] = [Parameters].[Parameter 2] THEN [_pcnt_vendor_late_10] END)&#10;/  SUM(IF [experiment_group] = [Parameters].[Parameter 2] THEN [vendor_late_calculation] END) &#10;)    &#10;    &#10;/&#10;(  // Baseline&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [_pcnt_vendor_late_10] END)&#10;/SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [vendor_late_calculation] END) &#10;    &#10;)&#10;- 1' />
      </column>
      <column caption='On Time Orders Delta' datatype='real' name='[Calculation_1984680089640124429]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(   // varient A&#10;  SUM(IF [experiment_group] = [Parameters].[Parameter 2] THEN [on_time_order] END)&#10;/  SUM(IF [experiment_group] = [Parameters].[Parameter 2] THEN [orders] END) &#10;)    &#10;    &#10;/&#10;(  // Baseline&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [on_time_order] END)&#10;/SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END) &#10;    &#10;)&#10;- 1' />
