              <calculation class='tableau' formula='SUM([customer_wrong_order_contacts])/SUM([orders])' />
            </column>
            <column caption='% C Missing Item Contact Rate' datatype='real' name='[% Customer Contact Rate (copy)_2700119132167036970]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([customer_missing_item_contacts])/SUM([orders])' />
            </column>
            <column caption='% Vendor Fail Rate' datatype='real' default-format='p0.00%' name='[% Item Unavailable Fail Rate (copy)_4565524149295542293]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_failed_orders])/SUM([orders])' />
            </column>
            <column caption='% Rider Late Preparation Contact Rate' datatype='real' default-format='p0.00%' name='[% Rider Late Delivery (copy)_5390949534337957912]' role='measure' type='quantitative'>
