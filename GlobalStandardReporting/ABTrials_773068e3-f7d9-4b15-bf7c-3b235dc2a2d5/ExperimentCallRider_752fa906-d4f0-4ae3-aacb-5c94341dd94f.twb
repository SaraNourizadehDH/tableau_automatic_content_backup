          <datasource-dependencies datasource='federated.0hr6f8u087m4kg1bqrbfm17yze5s'>
            <column caption='% Contact Rate (∆ Divergence)   ' datatype='real' name='[%  Live Order Inquiries Contact Rate (∆ Divergence) (copy 2)_7010697278633095197]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;POST&apos; THEN [vendor_customer_contacts] END)&#10;    /&#10;    SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;POST&apos; THEN [orders] END)&#10;    })&#10;&#10;    /&#10;&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;POST&apos; THEN [vendor_customer_contacts] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;POST&apos; THEN [orders] END)&#10;    })&#10;&#10;    - 1&#10;)&#10;-&#10;(&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;PRE&apos; THEN [vendor_customer_contacts] END)&#10;    /&#10;    SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;PRE&apos; THEN [orders] END)&#10;    })&#10;    /&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;PRE&apos; THEN [vendor_customer_contacts] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;PRE&apos; THEN [orders] END)&#10;    })&#10;    - 1&#10;)' />
            </column>
            <column caption='% Vendor Live Order CR (∆ Divergence)' datatype='real' name='[%  Live Order Inquiries Contact Rate (∆ Divergence) (copy)_1322791664332062721]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;POST&apos; THEN [vendor_live_order_contacts] END)&#10;    /&#10;    SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;POST&apos; THEN [orders] END)&#10;    })&#10;&#10;    /&#10;&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;POST&apos; THEN [vendor_live_order_contacts] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;POST&apos; THEN [orders] END)&#10;    })&#10;&#10;    - 1&#10;)&#10;-&#10;(&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;PRE&apos; THEN [vendor_live_order_contacts] END)&#10;    /&#10;    SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;PRE&apos; THEN [orders] END)&#10;    })&#10;    /&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;PRE&apos; THEN [vendor_live_order_contacts] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;PRE&apos; THEN [orders] END)&#10;    })&#10;    - 1&#10;)' />
            </column>
            <column caption='% Order Picked by Wrong Rider Contact Rate(∆ Divergence)' datatype='real' name='[%  Live Order Inquiries Contact Rate (∆ Divergence) (copy)_1322791664359809040]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;POST&apos; THEN [order_picked_wrong_rider_contacts] END)&#10;    /&#10;    SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;POST&apos; THEN [orders] END)&#10;    })&#10;&#10;    /&#10;&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;POST&apos; THEN [order_picked_wrong_rider_contacts] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;POST&apos; THEN [orders] END)&#10;    })&#10;&#10;    - 1&#10;)&#10;-&#10;(&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;PRE&apos; THEN [order_picked_wrong_rider_contacts] END)&#10;    /&#10;    SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;PRE&apos; THEN [orders] END)&#10;    })&#10;    /&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;PRE&apos; THEN [order_picked_wrong_rider_contacts] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;PRE&apos; THEN [orders] END)&#10;    })&#10;    - 1&#10;)' />
