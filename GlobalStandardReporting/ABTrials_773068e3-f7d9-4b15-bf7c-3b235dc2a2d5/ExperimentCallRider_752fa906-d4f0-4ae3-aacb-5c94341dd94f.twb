        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;// based on total orders&#10;WHEN &quot;% Fail Rate&quot; THEN [% Vendor Fail Rate (copy)_4868320897008328704]&#10;WHEN &quot;% Vendor Fail Rate&quot; THEN [% Item Unavailable Fail Rate (copy)_4565524149295542293]&#10;WHEN &quot;% Rider Fail Rate&quot; THEN [% Vendor Fail Rate (copy)_5390949534315581440]&#10;&#10;// contacts&#10;WHEN &quot;% Contact Rate&quot; THEN[% Vendor Contact Rate (copy)_7010697278586339343]&#10;WHEN &quot;% Vendor Contact Rate&quot; THEN [% Vendor Fail Rate (copy)_4565524149295779862]&#10;WHEN &quot;...% V Delivery Late Contact Rate&quot; THEN [% Vendor Contact Rate (copy)_2700119132122447902]&#10;WHEN &quot;...% Order Picked by Wrong Rider Contact Rate&quot; THEN [% C Missing Item Contact Rate (copy)_1322791664359682063]&#10;WHEN &quot;...% Rider Left Some Items Contact Rate&quot; THEN [% V Late Delivery Contact Rate (copy)_1322791664358719499]&#10;WHEN &quot;% Rider Contact Rate&quot; THEN [Calculation_2434195638697463808]&#10;WHEN &quot;...% Rider Late Preparation Contact Rate&quot; THEN [% Rider Late Delivery (copy)_5390949534337957912]&#10;WHEN &quot;% Customer Contact Rate&quot; THEN [Calculation_2434195638697549825]&#10;WHEN &quot;% Live Order Inquiries Contact Rate&quot; THEN [%  Live Order Inquiries Contact Rate (∆ Divergence) (copy)_4565524149296615449]&#10;WHEN &quot;...% Vendor Live Order CR&quot; THEN [%  Live Order Inquiries Contact Rate    (copy)_1322791664331886592]&#10;&#10;WHEN &quot;% Inaccurate Order CR&quot; THEN [% Vendor Live Order CR (copy)_1322791664334012420]&#10;WHEN &quot;...% C Wrong Item Contact Rate&quot; THEN [% C Late Order Rate (copy)_2700119132169367600]&#10;WHEN &quot;...% C Wrong Order Contact Rate&quot; THEN  [% C Wrong Item Contact Rate (copy)_1322791664336154632]&#10;WHEN &quot;...% C Missing Item Contact Rate&quot; THEN [% Customer Contact Rate (copy)_2700119132167036970]&#10;&#10;WHEN &quot;aVTC&quot; THEN [Calculation_1984680089634066440]&#10;WHEN &quot;Vendor Late Above 10&quot; THEN [Calculation_1984680089637269513]&#10;&#10;WHEN &quot;# Orders&quot; THEN SUM([orders])&#10;WHEN &quot;Orders on Time&quot; THEN [Calculation_1984680089640300558]&#10;&#10;&#10;WHEN &quot;# Events&quot; THEN SUM([num_events])&#10;&#10;WHEN &quot;% Vendors with events&quot; THEN [Calculation_2658108999950708736]&#10;WHEN &quot;# Vendors with event&quot; THEN SUM([vendors_with_events])&#10;WHEN &quot;% Vendors with &gt;1 event&quot; THEN [% Vendors with events (copy)_1322791664378986520]&#10;WHEN &quot;# Vendors with &gt;1 event&quot; THEN SUM([vendors_with_multiple_events])&#10;&#10;WHEN &quot;% Orders with events&quot; THEN [% Vendors with events (copy)_1322791664378425366]&#10;WHEN &quot;# Orders with event&quot; THEN SUM([orders_with_events])&#10;WHEN &quot;% Orders with &gt;1 event&quot; THEN [% Orders with events (copy)_1322791664378884119]&#10;WHEN &quot;# Orders with &gt;1 event&quot; THEN SUM([orders_with_multiple_events])&#10;END' />
