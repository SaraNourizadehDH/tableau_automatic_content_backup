    <worksheet name='Metrics Line Chart + Delta'>
      <layout-options>
        <title>
          <formatted-text>
            <run>&lt;</run>
            <run>[Parameters].[Parameter 4]</run>
            <run>&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='call rider' name='federated.0hr6f8u087m4kg1bqrbfm17yze5s' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Date Level' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
            <column alias='Variant A' caption='Select Variant' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Variant A&quot;'>
              <calculation class='tableau' formula='&quot;Variant A&quot;' />
              <aliases>
                <alias key='&quot;Variant A&quot;' value='Variant A' />
              </aliases>
            </column>
            <column caption='Select Metric' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% Fail Rate&quot;'>
              <calculation class='tableau' formula='&quot;% Fail Rate&quot;' />
              <aliases>
                <alias key='&quot;...&quot;' value='.' />
                <alias key='&quot;\% Contact Rate&quot;' value='% Contact Rate' />
                <alias key='&quot;\% Vendor Fail Rate&quot;' value='% Vendor Fail Rate' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0hr6f8u087m4kg1bqrbfm17yze5s'>
            <column caption='% Vendor Live Order CR' datatype='real' default-format='p0.000%' name='[%  Live Order Inquiries Contact Rate    (copy)_1322791664331886592]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_live_order_contacts])&#10;    /&#10;    SUM([orders])' />
            </column>
            <column caption='%  Live Order Inquiries Contact Rate   ' datatype='real' default-format='p0.000%' name='[%  Live Order Inquiries Contact Rate (∆ Divergence) (copy)_4565524149296615449]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([live_order_inquiries_contacts])&#10;    /&#10;    SUM([orders])' />
            </column>
            <column caption='% C Wrong Item Contact Rate' datatype='real' name='[% C Late Order Rate (copy)_2700119132169367600]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([customer_wrong_item_contacts])/SUM([orders])' />
            </column>
            <column caption='% Order Picked by Wrong Rider Contact Rate' datatype='real' name='[% C Missing Item Contact Rate (copy)_1322791664359682063]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_picked_wrong_rider_contacts])/SUM([orders])' />
            </column>
            <column caption='% C Wrong Order Contact Rate' datatype='real' name='[% C Wrong Item Contact Rate (copy)_1322791664336154632]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([customer_wrong_order_contacts])/SUM([orders])' />
            </column>
            <column caption='% C Missing Item Contact Rate' datatype='real' name='[% Customer Contact Rate (copy)_2700119132167036970]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([customer_missing_item_contacts])/SUM([orders])' />
            </column>
            <column caption='% Vendor Fail Rate' datatype='real' default-format='p0.00%' name='[% Item Unavailable Fail Rate (copy)_4565524149295542293]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_failed_orders])/SUM([orders])' />
            </column>
            <column caption='% Orders with multiple events' datatype='real' name='[% Orders with events (copy)_1322791664378884119]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_with_multiple_events]) / SUM([orders])' />
            </column>
            <column caption='% Rider Late Preparation Contact Rate' datatype='real' default-format='p0.00%' name='[% Rider Late Delivery (copy)_5390949534337957912]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_late_preparation_contacts])/SUM([orders])' />
            </column>
            <column caption='% Rider Left Some Items Contact Rate' datatype='real' default-format='p0.000%' name='[% V Late Delivery Contact Rate (copy)_1322791664358719499]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_left_items_contacts])/SUM([orders])' />
            </column>
            <column caption='% V Late Delivery Contact Rate' datatype='real' default-format='p0.000%' name='[% Vendor Contact Rate (copy)_2700119132122447902]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_delivery_contacts])/SUM([orders])' />
            </column>
            <column caption='% Contact Rate' datatype='real' default-format='p0.000%' name='[% Vendor Contact Rate (copy)_7010697278586339343]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_customer_contacts])/SUM([orders])' />
            </column>
            <column caption='% Vendor Contact Rate' datatype='real' default-format='p0.000%' name='[% Vendor Fail Rate (copy)_4565524149295779862]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_contacts])/SUM([orders])' />
            </column>
            <column caption='% Fail Rate' datatype='real' default-format='p0.00%' name='[% Vendor Fail Rate (copy)_4868320897008328704]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_orders])/SUM([orders])' />
            </column>
            <column caption='% Rider Fail Rate' datatype='real' default-format='p0.00%' name='[% Vendor Fail Rate (copy)_5390949534315581440]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_failed_orders])/SUM([orders])' />
            </column>
            <column caption='% Inaccurate Order CR' datatype='real' default-format='p0.000%' name='[% Vendor Live Order CR (copy)_1322791664334012420]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([inaccurate_order_contacts])&#10;    /&#10;    SUM([orders])' />
            </column>
            <column caption='% Orders with events' datatype='real' name='[% Vendors with events (copy)_1322791664378425366]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_with_events]) / SUM([orders])' />
            </column>
            <column caption='% Vendors with multiple events' datatype='real' name='[% Vendors with events (copy)_1322791664378986520]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_with_multiple_events]) / SUM([vendors])' />
            </column>
            <column caption='aVTC (minutes)' datatype='real' name='[Calculation_1984680089634066440]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([avtc])/SUM([platform_order_code_avtc])' />
            </column>
            <column caption='Vendor Late Above 10' datatype='real' name='[Calculation_1984680089637269513]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([_pcnt_vendor_late_10])/SUM([vendor_late_calculation])' />
            </column>
            <column caption='%On Time Orders' datatype='real' name='[Calculation_1984680089640300558]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([on_time_order])/SUM([orders])' />
            </column>
            <column caption='% Rider Contact Rate' datatype='real' name='[Calculation_2434195638697463808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_contacts])/SUM([orders])' />
            </column>
            <column caption='% Customer Contact Rate' datatype='real' name='[Calculation_2434195638697549825]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([customer_contacts])/SUM([orders])' />
            </column>
            <column caption='% Vendors with events' datatype='real' name='[Calculation_2658108999950708736]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_with_events]) / SUM([vendors])' />
            </column>
            <column caption='Metrics' datatype='real' name='[Calculation_3902369094159556608]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;// based on total orders&#10;WHEN &quot;% Fail Rate&quot; THEN [% Vendor Fail Rate (copy)_4868320897008328704]&#10;WHEN &quot;% Vendor Fail Rate&quot; THEN [% Item Unavailable Fail Rate (copy)_4565524149295542293]&#10;WHEN &quot;% Rider Fail Rate&quot; THEN [% Vendor Fail Rate (copy)_5390949534315581440]&#10;&#10;// contacts&#10;WHEN &quot;% Contact Rate&quot; THEN[% Vendor Contact Rate (copy)_7010697278586339343]&#10;WHEN &quot;% Vendor Contact Rate&quot; THEN [% Vendor Fail Rate (copy)_4565524149295779862]&#10;WHEN &quot;...% V Delivery Late Contact Rate&quot; THEN [% Vendor Contact Rate (copy)_2700119132122447902]&#10;WHEN &quot;...% Order Picked by Wrong Rider Contact Rate&quot; THEN [% C Missing Item Contact Rate (copy)_1322791664359682063]&#10;WHEN &quot;...% Rider Left Some Items Contact Rate&quot; THEN [% V Late Delivery Contact Rate (copy)_1322791664358719499]&#10;WHEN &quot;% Rider Contact Rate&quot; THEN [Calculation_2434195638697463808]&#10;WHEN &quot;...% Rider Late Preparation Contact Rate&quot; THEN [% Rider Late Delivery (copy)_5390949534337957912]&#10;WHEN &quot;% Customer Contact Rate&quot; THEN [Calculation_2434195638697549825]&#10;WHEN &quot;% Live Order Inquiries Contact Rate&quot; THEN [%  Live Order Inquiries Contact Rate (∆ Divergence) (copy)_4565524149296615449]&#10;WHEN &quot;...% Vendor Live Order CR&quot; THEN [%  Live Order Inquiries Contact Rate    (copy)_1322791664331886592]&#10;&#10;WHEN &quot;% Inaccurate Order CR&quot; THEN [% Vendor Live Order CR (copy)_1322791664334012420]&#10;WHEN &quot;...% C Wrong Item Contact Rate&quot; THEN [% C Late Order Rate (copy)_2700119132169367600]&#10;WHEN &quot;...% C Wrong Order Contact Rate&quot; THEN  [% C Wrong Item Contact Rate (copy)_1322791664336154632]&#10;WHEN &quot;...% C Missing Item Contact Rate&quot; THEN [% Customer Contact Rate (copy)_2700119132167036970]&#10;&#10;WHEN &quot;aVTC&quot; THEN [Calculation_1984680089634066440]&#10;WHEN &quot;Vendor Late Above 10&quot; THEN [Calculation_1984680089637269513]&#10;&#10;WHEN &quot;# Orders&quot; THEN SUM([orders])&#10;WHEN &quot;Orders on Time&quot; THEN [Calculation_1984680089640300558]&#10;&#10;&#10;WHEN &quot;# Events&quot; THEN SUM([num_events])&#10;&#10;WHEN &quot;% Vendors with events&quot; THEN [Calculation_2658108999950708736]&#10;WHEN &quot;# Vendors with event&quot; THEN SUM([vendors_with_events])&#10;WHEN &quot;% Vendors with &gt;1 event&quot; THEN [% Vendors with events (copy)_1322791664378986520]&#10;WHEN &quot;# Vendors with &gt;1 event&quot; THEN SUM([vendors_with_multiple_events])&#10;&#10;WHEN &quot;% Orders with events&quot; THEN [% Vendors with events (copy)_1322791664378425366]&#10;WHEN &quot;# Orders with event&quot; THEN SUM([orders_with_events])&#10;WHEN &quot;% Orders with &gt;1 event&quot; THEN [% Orders with events (copy)_1322791664378884119]&#10;WHEN &quot;# Orders with &gt;1 event&quot; THEN SUM([orders_with_multiple_events])&#10;END' />
            </column>
            <column caption='Metrics (∆)' datatype='real' name='[Calculation_3902369094162780161]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(   // varient A&#10;    (SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [Calculation_3902369094162980866] END)&#10;      / [Calculation_3902369094168502277]&#10;     ) &#10;    &#10;/&#10;  // Baseline&#10;    (SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [Calculation_3902369094162980866] END)&#10;    /[Calculation_3902369094168055812]&#10;    )&#10;)&#10;- 1' />
            </column>
            <column caption='∆  Metrics Numerator' datatype='real' name='[Calculation_3902369094162980866]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;// based on total orders&#10;WHEN &quot;% Fail Rate&quot; THEN [failed_orders]&#10;WHEN &quot;% Customer Fail Rate&quot; THEN [customer_failed_orders]&#10;WHEN &quot;% Vendor Fail Rate&quot; THEN [vendor_failed_orders]&#10;WHEN &quot;% Rider Fail Rate&quot; THEN [rider_failed_orders]&#10;&#10;// contacts&#10;WHEN &quot;% Contact Rate&quot; THEN [vendor_customer_contacts]&#10;WHEN &quot;% Vendor Contact Rate&quot; THEN [vendor_contacts]&#10;WHEN &quot;...% V Delivery Late Contact Rate&quot; THEN [vendor_late_delivery_contacts]&#10;WHEN &quot;...% Order Picked by Wrong Rider Contact Rate&quot; THEN [order_picked_wrong_rider_contacts]&#10;WHEN &quot;...% Rider Left Some Items Contact Rate&quot; THEN [rider_left_items_contacts]&#10;WHEN &quot;% Rider Contact Rate&quot; THEN [rider_contacts]&#10;WHEN &quot;...% Rider Late Preparation Contact Rate&quot; THEN [rider_late_preparation_contacts]&#10;WHEN &quot;% Customer Contact Rate&quot; THEN [customer_contacts]&#10;WHEN &quot;% Live Order Inquiries Contact Rate&quot; THEN [live_order_inquiries_contacts]&#10;WHEN &quot;...% Vendor Live Order CR&quot; THEN [vendor_live_order_contacts]&#10;&#10;&#10;WHEN &quot;% Inaccurate Order CR&quot; THEN [inaccurate_order_contacts]&#10;WHEN &quot;...% C Wrong Item Contact Rate&quot; THEN [customer_wrong_item_contacts]&#10;WHEN &quot;...% C Wrong Order Contact Rate&quot; THEN  [customer_wrong_order_contacts]&#10;WHEN &quot;...% C Missing Item Contact Rate&quot; THEN [customer_missing_item_contacts]&#10;&#10;&#10;//&#10;WHEN &quot;aVTC&quot; THEN [avtc]&#10;WHEN &quot;Vendor Late Above 10&quot; THEN [_pcnt_vendor_late_10]&#10;//orders&#10;WHEN &quot;Orders on Time&quot; THEN [on_time_order]&#10;&#10;&#10;WHEN &quot;# Events&quot; THEN [num_events]&#10;WHEN &quot;# Vendors with event&quot; THEN [vendors_with_events]&#10;WHEN &quot;# Vendors with event&quot; THEN [vendors_with_events]&#10;WHEN &quot;% Vendors with &gt;1 event&quot; THEN [vendors_with_multiple_events]&#10;WHEN &quot;# Vendors with &gt;1 event&quot; THEN [vendors_with_multiple_events]&#10;&#10;WHEN &quot;% Orders with events&quot; THEN [orders_with_events]&#10;WHEN &quot;# Orders with event&quot; THEN [orders_with_events]&#10;WHEN &quot;% Orders with &gt;1 event&quot; THEN [orders_with_multiple_events]&#10;WHEN &quot;# Orders with &gt;1 event&quot; THEN[orders_with_multiple_events]&#10;END' />
            </column>
            <column caption='∆  Metrics Denominator - Baseline' datatype='integer' name='[Calculation_3902369094168055812]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;// based on total orders&#10;WHEN &quot;% Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;% Customer Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;% Vendor Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;% Rider Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;&#10;// contacts&#10;WHEN &quot;% Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;% Vendor Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;% Rider Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;% Customer Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;% Live Order Inquiries Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;&#10;WHEN &quot;...% V Delivery Late Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;...% Order Picked by Wrong Rider Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;...% Rider Left Some Items Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;...% Rider Late Preparation Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;% Customer Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;...% Vendor Live Order CR&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;&#10;&#10;WHEN &quot;% Inaccurate Order CR&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;...% C Wrong Item Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;...% C Wrong Order Contact Rate&quot; THEN  SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;...% C Missing Item Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;&#10;//&#10;WHEN &quot;aVTC&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [platform_order_code_avtc] END)&#10;WHEN &quot;Vendor Late Above 10&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [vendor_late_calculation] END)&#10;//orders&#10;WHEN &quot;Auto Accept Orders&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;Orders on Time&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;Seamless Orders&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;&#10;WHEN &quot;% Vendors with &gt;1 event&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;&#10;WHEN &quot;% Orders with &gt;1 event&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;&#10;END' />
