      <table>
        <view>
          <datasources>
            <datasource caption='call rider' name='federated.0hr6f8u087m4kg1bqrbfm17yze5s' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Date Level' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
            <column alias='Variant A' caption='Select Variant' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Variant A&quot;'>
              <calculation class='tableau' formula='&quot;Variant A&quot;' />
              <aliases>
                <alias key='&quot;Variant A&quot;' value='Variant A' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0hr6f8u087m4kg1bqrbfm17yze5s'>
            <column caption='% Vendor Live Order CR' datatype='real' default-format='p0.000%' name='[%  Live Order Inquiries Contact Rate    (copy)_1322791664331886592]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_live_order_contacts])&#10;    /&#10;    SUM([orders])' />
            </column>
            <column caption='%  Live Order Inquiries Contact Rate   ' datatype='real' default-format='p0.000%' name='[%  Live Order Inquiries Contact Rate (∆ Divergence) (copy)_4565524149296615449]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([live_order_inquiries_contacts])&#10;    /&#10;    SUM([orders])' />
            </column>
            <column caption='% C Wrong Item Contact Rate' datatype='real' name='[% C Late Order Rate (copy)_2700119132169367600]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([customer_wrong_item_contacts])/SUM([orders])' />
            </column>
            <column caption='% Order Picked by Wrong Rider Contact Rate' datatype='real' name='[% C Missing Item Contact Rate (copy)_1322791664359682063]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_picked_wrong_rider_contacts])/SUM([orders])' />
            </column>
            <column caption='% C Wrong Order Contact Rate' datatype='real' name='[% C Wrong Item Contact Rate (copy)_1322791664336154632]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([customer_wrong_order_contacts])/SUM([orders])' />
            </column>
            <column caption='% C Missing Item Contact Rate' datatype='real' name='[% Customer Contact Rate (copy)_2700119132167036970]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([customer_missing_item_contacts])/SUM([orders])' />
            </column>
            <column caption='% Vendor Fail Rate' datatype='real' default-format='p0.00%' name='[% Item Unavailable Fail Rate (copy)_4565524149295542293]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_failed_orders])/SUM([orders])' />
            </column>
            <column caption='% Rider Late Preparation Contact Rate' datatype='real' default-format='p0.00%' name='[% Rider Late Delivery (copy)_5390949534337957912]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_late_preparation_contacts])/SUM([orders])' />
            </column>
            <column caption='% Rider Left Some Items Contact Rate' datatype='real' default-format='p0.000%' name='[% V Late Delivery Contact Rate (copy)_1322791664358719499]' role='measure' type='quantitative'>
