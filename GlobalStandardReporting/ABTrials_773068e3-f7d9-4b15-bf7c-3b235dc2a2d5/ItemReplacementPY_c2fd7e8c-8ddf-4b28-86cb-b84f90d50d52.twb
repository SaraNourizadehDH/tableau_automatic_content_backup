      <aliases enabled='yes' />
      <column caption='suggest item save rate' datatype='real' name='[Calculation_5509661579774803968]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([suggest_items_saved_orders])/sum([suggest_item_ga_intent_orders])' />
      </column>
      <column caption='Contact Customer Save Rate' datatype='real' name='[Calculation_5509661579776286721]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([contact_customer_saved_orders])/SUM([contact_customer_ga_intent_orders])' />
      </column>
      <column caption='Suggest Item Contact Customer Save Rate' datatype='real' name='[Calculation_5509661579776917506]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([suggest_items_contact_customer_saved_orders])/sum([suggest_items_contact_customer_ga_intent_orders])' />
      </column>
      <column caption='Saved Orders by Type' datatype='integer' name='[Calculation_654147870561554435]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;&#10;WHEN &apos;Suggest Items Saved Orders&apos; THEN SUM([suggest_items_saved_orders]) &#10;WHEN &apos;Contact Customer Saved Orders&apos; THEN SUM([contact_customer_saved_orders]) &#10;WHEN &apos;Total Saved Orders&apos; THEN SUM([suggest_items_contact_customer_saved_orders])&#10;END' />
      </column>
      <column caption='_user_entitlement' datatype='boolean' name='[Calculation_742671770494558208]' role='dimension' type='nominal'>
