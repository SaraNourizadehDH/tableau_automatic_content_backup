            <column caption='% Metrics (∆)' datatype='real' name='[Calculation_3902369094162780161]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;(SUM(IF [experiment_group] = [Calculation_3149001364965367808] THEN [Calculation_3902369094162980866] END) / [Calculation_3149001364966883330])&#10;   &#10;/&#10;&#10;(SUM(IF [experiment_group] = [Calculation_3149001364966473729] THEN [Calculation_3902369094162980866] END) / [Calculation_3149001364967428099])&#10;)&#10;&#10;- 1' />
            </column>
