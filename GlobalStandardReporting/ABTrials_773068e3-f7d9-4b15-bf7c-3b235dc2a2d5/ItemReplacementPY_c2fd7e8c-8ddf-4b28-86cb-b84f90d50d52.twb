            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0v9qp7q1uhvcfd1gg84a31hg0wu1'>
            <column caption='% Vendor Live Order Inquiry Contacts' datatype='real' name='[% Contact Rate (copy)_5158310476993855507]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_live_order_inquiry_contacts])/SUM([orders])' />
            </column>
            <column caption='% Vendor Delivery Late Contacts' datatype='real' name='[% Contact Rate (copy)_5158310476994150422]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_delivery_late_contacts])/SUM([orders])' />
            </column>
            <column caption='% Rider Late Preparation Contacts' datatype='real' name='[% Contact Rate (copy)_5158310476994773020]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_late_preparation_contacts])/SUM([orders])' />
            </column>
            <column caption='% Customer Complain About Late Order Cancel Contacts' datatype='real' name='[% Contact Rate (copy)_5158310476995100703]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([customer_complain_about_late_order_cancel_contacts])/SUM([orders])' />
            </column>
            <column caption='% Customer Complain About Late Orders Contacts' datatype='real' name='[% Customer Complain About Late Order Cancel Contacts (copy)_5158310476995350561]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([customer_complain_about_late_orders_contacts])/SUM([orders])' />
            </column>
            <column caption='% Vendor Fail Rate' datatype='real' default-format='p0.00%' name='[% Item Unavailable Fail Rate (copy)_4565524149295542293]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_failed_orders])/SUM([orders])' />
            </column>
            <column caption='% Compensated Orders' datatype='real' default-format='p0.000%' name='[% Seamless Orders (copy)_4087509276688703492]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([compensated_orders])/SUM([orders])' />
            </column>
            <column caption='% Refunded Orders' datatype='real' default-format='p0.000%' name='[% Seamless Orders (copy)_4087509276689014791]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([refunded_orders])/SUM([orders])' />
            </column>
            <column caption='% Closed Vendor Fail Rate' datatype='real' default-format='p0.00%' name='[% Vendor Fail Rate (copy)_3638345580065656832]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([closed_vendor_failed_orders])/SUM([orders])' />
            </column>
            <column caption='% Too Busy Vendor Fail Rate' datatype='real' default-format='p0.00%' name='[% Vendor Fail Rate (copy)_3638345580065923075]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([too_busy_vendor_failed_orders])/SUM([orders])' />
