Offline Duration&quot; THEN [availability_offline_duration_seconds]&#10;WHEN &quot;% Client Offline Duration&quot; THEN [client_offline_duration_seconds]&#10;WHEN &quot;% Monitor Offline Duration&quot; THEN [monitor_offline_duration_seconds]&#10;WHEN &quot;% Platform Offline Duration&quot; THEN [platform_offline_duration_seconds]&#10;WHEN &quot;% Order Save Rate&quot; THEN [Calculation_877427885971542018]&#10;WHEN &quot;% Suggest Items Save Rate&quot; THEN [suggest_items_saved_orders] &#10;WHEN &quot;% Partial Acceptance Save Rate&quot; THEN [contact_customer_ga_intent_orders] &#10;&#10;END' />
            </column>
            <column caption='% Offline Duration' datatype='real' name='[Calculation_4335207285548163072]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(offline_duration_seconds)/sum(schedule_duration_seconds)' />
            </column>
            <column caption='% Availibility Offline Duration' datatype='real' name='[Calculation_4335207285549412353]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(availability_offline_duration_seconds)/sum([schedule_duration_seconds])' />
            </column>
            <column caption='% Monitor Offline Duration' datatype='real' name='[Calculation_4335207285549957122]' role='measure' type='quantitative'>
