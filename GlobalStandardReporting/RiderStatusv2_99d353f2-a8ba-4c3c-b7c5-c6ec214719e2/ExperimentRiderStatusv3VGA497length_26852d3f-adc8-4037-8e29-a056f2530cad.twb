            <column caption='Select Metric' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% Live Order Inquiries Contact Rate&quot;'>
              <calculation class='tableau' formula='&quot;% Live Order Inquiries Contact Rate&quot;' />
              <aliases>
                <alias key='&quot;...&quot;' value='.' />
                <alias key='&quot;...\% Late Delivery Contact Rate&quot;' value='...% Delivery Late Contact Rate' />
                <alias key='&quot;\# Orders&quot;' value='# Orders' />
                <alias key='&quot;\% Contact Rate&quot;' value='% Contact Rate' />
                <alias key='&quot;\% Vendor Fail Rate&quot;' value='% Vendor Fail Rate' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0hr6f8u087m4kg1bqrbfm17yze5s'>
            <column caption='%  Live Order Inquiries Contact Rate   ' datatype='real' default-format='p0.000%' name='[%  Live Order Inquiries Contact Rate (∆ Divergence) (copy)_4565524149296615449]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([live_order_inquiries_contacts])&#10;    /&#10;    SUM([orders])' />
            </column>
            <column caption='% Too Busy Fail rate' datatype='real' default-format='p0.00%' name='[% Item Unavailable Fail Rate (copy)_1899745034839228420]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([too_busy_failed_orders])/SUM([orders])' />
            </column>
            <column caption='% Vendor Fail Rate' datatype='real' default-format='p0.00%' name='[% Item Unavailable Fail Rate (copy)_4565524149295542293]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_failed_orders])/SUM([orders])' />
            </column>
            <column caption='% R Unable To Contact Contact Rate' datatype='real' name='[% Rider Contact Rate (copy)_3239143712579383296]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_unable_to_contact_contacts])/SUM([orders])' />
            </column>
            <column caption='% R Late Preparation Contact Rate' datatype='real' name='[% Rider Contact Rate (copy)_3239143712580329475]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_late_preparation_contacts])/SUM([orders])' />
            </column>
            <column caption='% R App Issue Contact Rate' datatype='real' name='[% Rider Contact Rate (copy)_3239143712581218310]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_app_issue_contacts])/SUM([orders])' />
            </column>
            <column caption='% Rider Never Delivered' datatype='real' default-format='p0.00%' name='[% Rider ETA Too Long (copy)_2700119132099747842]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_never_delivered])/SUM([orders])' />
            </column>
            <column caption='% Rider No Courier' datatype='real' default-format='p0.00%' name='[% Rider Fail Rate (copy)_5390949534322077705]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_no_courier])/SUM([orders])' />
            </column>
            <column caption='% Rider ETA Too Long' datatype='real' default-format='p0.00%' name='[% Rider Late Delivery (copy)_5390949534337957912]' role='measure' type='quantitative'>
