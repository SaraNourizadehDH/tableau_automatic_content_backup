            <column caption='_line_break 4' datatype='integer' name='[_line_break (copy) (copy) (copy)_7010697278829940787]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(NULL)' />
              <aliases>
                <alias key='%null%' value='  ' />
              </aliases>
            </column>
