    <worksheet name='KPI Trends - Tabular'>
      <layout-options>
        <title>
          <formatted-text>
            <run>KPI Trends - Tabular</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='VGA-141 (experiment + entitlement)' name='federated.0hr6f8u087m4kg1bqrbfm17yze5s' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Date Level' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
            <column alias='Variant A' caption='Select Variant' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Variant A&quot;'>
              <calculation class='tableau' formula='&quot;Variant A&quot;' />
              <aliases>
                <alias key='&quot;Variant A&quot;' value='Variant A' />
              </aliases>
            </column>
            <column alias='Tabular View' caption='Select Charts or Tabular View' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;tab&quot;'>
              <calculation class='tableau' formula='&quot;tab&quot;' />
              <aliases>
                <alias key='&quot;charts&quot;' value='Charts' />
                <alias key='&quot;tab&quot;' value='Tabular View' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0hr6f8u087m4kg1bqrbfm17yze5s'>
            <column caption='% Too Busy Fail rate' datatype='real' default-format='p0.00%' name='[% Item Unavailable Fail Rate (copy)_1899745034839228420]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([too_busy_failed_orders])/SUM([orders])' />
            </column>
            <column caption='% Vendor Fail Rate' datatype='real' default-format='p0.00%' name='[% Item Unavailable Fail Rate (copy)_4565524149295542293]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_failed_orders])/SUM([orders])' />
            </column>
            <column caption='% Rider No Courier' datatype='real' default-format='p0.00%' name='[% Rider Fail Rate (copy)_5390949534322077705]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_no_courier])/SUM([orders])' />
            </column>
            <column caption='% Rider ETA Too Long' datatype='real' default-format='p0.00%' name='[% Rider Late Delivery (copy)_5390949534337957912]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_eta_too_long])/SUM([orders])' />
            </column>
            <column caption='% Rider Late Delivery' datatype='real' default-format='p0.00%' name='[% Rider No Courier (copy)_5390949534323716107]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_late_delivery])/SUM([orders])' />
            </column>
            <column caption='% Unreachable Fail Rate' datatype='real' default-format='p0.000%' name='[% Transport Fail Rate (copy)_50876604597469192]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([unreachable_failed_vendor])&#10;/SUM([orders])' />
            </column>
            <column caption='% V Request Rider ETA Contact Rate' datatype='real' default-format='p0.000%' name='[% V Late Delivery Contact Rate (copy)_3725743584547450880]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([req_rider_eta_delivery_contacts])/SUM([orders])' />
            </column>
            <column caption='% V Late Delivery Contact Rate' datatype='real' default-format='p0.000%' name='[% Vendor Contact Rate (copy)_2700119132122447902]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_delivery_contacts])/SUM([orders])' />
            </column>
            <column caption='% Contact Rate' datatype='real' default-format='p0.000%' name='[% Vendor Contact Rate (copy)_7010697278586339343]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_customer_contacts])/SUM([orders])' />
            </column>
            <column caption='% Vendor Contact Rate' datatype='real' default-format='p0.000%' name='[% Vendor Fail Rate (copy)_4565524149295779862]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_contacts])/SUM([orders])' />
            </column>
            <column caption='% Fail Rate' datatype='real' default-format='p0.00%' name='[% Vendor Fail Rate (copy)_4868320897008328704]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_orders])/SUM([orders])' />
            </column>
            <column caption='% Rider Fail Rate' datatype='real' default-format='p0.00%' name='[% Vendor Fail Rate (copy)_5390949534315581440]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_failed_orders])/SUM([orders])' />
            </column>
            <column caption='% No Response Fail Rate' datatype='real' name='[Calculation_1984680089613533184]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_response_failed_vendor])/SUM([orders])' />
            </column>
            <column caption='aVTC (minutes)' datatype='real' name='[Calculation_1984680089634066440]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([avtc])/SUM([platform_order_code_avtc])' />
            </column>
            <column caption='Vendor Late Above 10' datatype='real' name='[Calculation_1984680089637269513]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([_pcnt_vendor_late_10])/SUM([vendor_late_calculation])' />
            </column>
            <column caption='% Rider Contact Rate' datatype='real' name='[Calculation_2434195638697463808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_contacts])/SUM([orders])' />
            </column>
            <column caption='_granularity_filter' datatype='boolean' name='[Calculation_4565524148946161665]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;&#10;WHEN &quot;Daily&quot; THEN [date_type] = &quot;Daily&quot;&#10;WHEN &quot;Weekly&quot; THEN [date_type] = &quot;Weekly&quot;&#10;&#10;END' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_4565524148946345986]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [date_type]&#10;WHEN &quot;Daily&quot; THEN STR(DATE([created_date_local]))&#10;WHEN &quot;Weekly&quot; THEN STR(YEAR([created_date_local]))+&quot;-W&quot;+STR([weeks])&#10;END' />
            </column>
            <column caption='% Item Unavailable Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_4565524149076819972]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([item_unavailable_vendor_failed_orders])/SUM([orders])' />
            </column>
            <column caption='_view_charts_or_tab' datatype='string' name='[Calculation_4565524149402353741]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 3]' />
            </column>
            <column caption='Variants filter' datatype='boolean' name='[Variants (copy)_1879126963555889156]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;&#10;WHEN &quot;Variant A&quot; THEN [experiment_group] IN (&quot;Variant A&quot;, &quot;Baseline&quot;)&#10;WHEN &quot;Variant B&quot; THEN [experiment_group] IN (&quot;Variant B&quot;, &quot;Baseline&quot;)&#10;&#10;END' />
