            <column caption='% V Late Delivery Contact Rate (rider late &gt; 5)' datatype='real' default-format='p0.000%' name='[% V Late Delivery Contact Rate (rider late &gt; 0) (copy)_3836996515216928774]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_delivery_contacts_rl_5])/SUM([orders_rl_5])' />
