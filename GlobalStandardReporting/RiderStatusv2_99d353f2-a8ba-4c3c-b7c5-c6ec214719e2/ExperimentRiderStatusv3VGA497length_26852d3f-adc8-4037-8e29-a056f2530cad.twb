            <column caption='Metrics' datatype='real' name='[Calculation_3902369094159556608]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;// based on total orders&#10;WHEN &quot;% Fail Rate&quot; THEN [% Vendor Fail Rate (copy)_4868320897008328704]&#10;WHEN &quot;% Vendor Fail Rate&quot; THEN [% Item Unavailable Fail Rate (copy)_4565524149295542293]&#10;WHEN &quot;...% No Response Fail Rate&quot; THEN [Calculation_1984680089613533184]&#10;WHEN &quot;...% Item Unavailable Fail Rate&quot; THEN [Calculation_4565524149076819972]&#10;WHEN &quot;% Rider Fail Rate&quot; THEN [% Vendor Fail Rate (copy)_5390949534315581440]&#10;WHEN &quot;...% Closed Fail Rate&quot; THEN [Calculation_1899745034836893697]&#10;WHEN &quot;...% Too Busy Fail Rate&quot; THEN [% Item Unavailable Fail Rate (copy)_1899745034839228420]&#10;WHEN &quot;...% Rider No Courier&quot; THEN [% Rider Fail Rate (copy)_5390949534322077705]&#10;WHEN &quot;...% Rider Late Delivery&quot; THEN [% Rider No Courier (copy)_5390949534323716107]&#10;WHEN &quot;...% Rider ETA Too Long&quot; THEN [% Rider Late Delivery (copy)_5390949534337957912]&#10;WHEN &quot;...% Rider Never Delivered&quot; THEN [% Rider ETA Too Long (copy)_2700119132099747842]&#10;&#10;// contacts&#10;WHEN &quot;% Contact Rate&quot; THEN[% Vendor Contact Rate (copy)_7010697278586339343]&#10;WHEN &quot;% Vendor Contact Rate&quot; THEN [% Vendor Fail Rate (copy)_4565524149295779862]&#10;WHEN &quot;...%Vendor Order Cancellation Inquiry Contact Rate&quot; THEN [% Vendor Contact Rate (copy)_2700119132115935256]&#10;WHEN &quot;...%Vendor Product Unavailable Contact Rate&quot; THEN [% Vendor Contact Rate (copy)_2700119132118372379]&#10;WHEN &quot;...%Vendor Late Delivery Contact Rate&quot; THEN [% Vendor Contact Rate (copy)_2700119132122447902]&#10;WHEN &quot;% Rider Contact Rate&quot; THEN [Calculation_2434195638697463808]&#10;WHEN &quot;...% Rider Unable To Contact Contact Rate&quot; THEN [% Rider Contact Rate (copy)_3239143712579383296]&#10;WHEN &quot;...% Rider Late Preparation Contact Rate&quot; THEN [% Rider Contact Rate (copy)_3239143712580329475]&#10;WHEN &quot;...% Rider App Issue Contact Rate&quot; THEN [% Rider Contact Rate (copy)_3239143712581218310]&#10;WHEN &quot;% Live Order Inquiries Contact Rate&quot; THEN [%  Live Order Inquiries Contact Rate (∆ Divergence) (copy)_4565524149296615449]&#10;&#10;WHEN &quot;...% Late Delivery Contact Rate&quot; THEN [% Vendor Contact Rate (copy)_2700119132122447902]&#10;WHEN &quot;.....% Late Delivery Contact Rate (rider late &gt;0)&quot; THEN [% V Late Delivery Contact Rate (copy)_3836996515215962112]&#10;WHEN &quot;.....% Late Delivery Contact Rate (rider late &gt;5)&quot; THEN [% V Late Delivery Contact Rate (rider late &gt; 0) (copy)_3836996515216928774]&#10;WHEN &quot;.....% Late Delivery Contact Rate (rider late &gt;10)&quot; THEN [% V Late Delivery Contact Rate (rider late &gt; 5) (copy)_3836996516923256841]&#10;&#10;WHEN &quot;...% Request Rider ETA Contact Rate&quot; THEN [% V Late Delivery Contact Rate (copy)_3725743584547450880]&#10;WHEN &quot;.....% Request Rider ETA Contact Rate (rider late &gt;0)&quot; THEN [% V Request Rider ETA Contact Rate (copy)_3836996516924227596]&#10;WHEN &quot;.....% Request Rider ETA Contact Rate (rider late &gt;5)&quot; THEN [% V Request Rider ETA Contact Rate (rider late &gt; 0) (copy)_3836996516924751887]&#10;WHEN &quot;.....% Request Rider ETA Contact Rate (rider late &gt;10)&quot; THEN [% V Request Rider ETA Contact Rate (rider late &gt; 5) (copy)_3836996516925071378]&#10;&#10;&#10;WHEN &quot;aVTC&quot; THEN [Calculation_1984680089634066440]&#10;WHEN &quot;Vendor Late Above 10&quot; THEN [Calculation_1984680089637269513]&#10;&#10;WHEN &quot;# Orders&quot; THEN SUM([orders])&#10;WHEN &quot;Orders on Time&quot; THEN [Calculation_1984680089640300558]&#10;&#10;&#10;WHEN &quot;# Events (view rider location)&quot; THEN SUM([num_events])&#10;WHEN &quot;% Vendors with events&quot; THEN [Calculation_2658108999950708736]&#10;WHEN &quot;# Vendors with event&quot; THEN SUM([vendors_with_events])&#10;END' />
            </column>
            <column caption='Metrics (∆)' datatype='real' name='[Calculation_3902369094162780161]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(   // varient A&#10;    (SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [Calculation_3902369094162980866] END)&#10;      / [Calculation_3902369094168502277]&#10;     ) &#10;    &#10;/&#10;  // Baseline&#10;    (SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [Calculation_3902369094162980866] END)&#10;    /[Calculation_3902369094168055812]&#10;    )&#10;)&#10;- 1' />
            </column>
            <column caption='∆  Metrics Numerator' datatype='real' name='[Calculation_3902369094162980866]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;// based on total orders&#10;WHEN &quot;% Fail Rate&quot; THEN [failed_orders]&#10;WHEN &quot;% Customer Fail Rate&quot; THEN [customer_failed_orders]&#10;WHEN &quot;% Vendor Fail Rate&quot; THEN [vendor_failed_orders]&#10;WHEN &quot;...% No Response Fail Rate&quot; THEN [no_response_failed_vendor]&#10;WHEN &quot;...% Item Unavailable Fail Rate&quot; THEN [item_unavailable_vendor_failed_orders]&#10;// contacts&#10;WHEN &quot;% Contact Rate&quot; THEN [vendor_customer_contacts]&#10;WHEN &quot;% Vendor Contact Rate&quot; THEN [vendor_contacts]&#10;WHEN &quot;% Rider Contact Rate&quot; THEN [rider_contacts]&#10;WHEN &quot;% Customer Contact Rate&quot; THEN [customer_contacts]&#10;WHEN &quot;% Live Order Inquiries Contact Rate&quot; THEN [live_order_inquiries_contacts]&#10;&#10;WHEN &quot;...% Late Delivery Contact Rate&quot; THEN [vendor_late_delivery_contacts]&#10;WHEN &quot;.....% Late Delivery Contact Rate (rider late &gt;0)&quot; THEN [vendor_late_delivery_contacts_rl_0]&#10;WHEN &quot;.....% Late Delivery Contact Rate (rider late &gt;5)&quot; THEN [vendor_late_delivery_contacts_rl_5]&#10;WHEN &quot;.....% Late Delivery Contact Rate (rider late &gt;10)&quot; THEN [vendor_late_delivery_contacts_rl_10]&#10;&#10;WHEN &quot;...% Request Rider ETA Contact Rate&quot; THEN [req_rider_eta_delivery_contacts]&#10;WHEN &quot;.....% Request Rider ETA Contact Rate (rider late &gt;0)&quot; THEN [req_rider_eta_delivery_contacts_rl_0]&#10;WHEN &quot;.....% Request Rider ETA Contact Rate (rider late &gt;5)&quot; THEN [req_rider_eta_delivery_contacts_rl_5]&#10;WHEN &quot;.....% Request Rider ETA Contact Rate (rider late &gt;10)&quot; THEN [req_rider_eta_delivery_contacts_rl_10]&#10;&#10;//&#10;WHEN &quot;aVTC&quot; THEN [avtc]&#10;WHEN &quot;Vendor Late Above 10&quot; THEN [_pcnt_vendor_late_10]&#10;//orders&#10;WHEN &quot;Orders on Time&quot; THEN [on_time_order]&#10;&#10;&#10;WHEN &quot;# Events (view rider location)&quot; THEN [num_events]&#10;WHEN &quot;# Vendors with event&quot; THEN [vendors_with_events]&#10;END' />
            </column>
            <column caption='∆  Metrics Denominator - Baseline' datatype='integer' name='[Calculation_3902369094168055812]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;// based on total orders&#10;WHEN &quot;% Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;% Customer Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;% Vendor Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;...% No Response Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;...% Item Unavailable Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;// contacts&#10;WHEN &quot;% Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;% Vendor Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;% Rider Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;% Customer Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;% Live Order Inquiries Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;&#10;WHEN &quot;...% Late Delivery Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;.....% Late Delivery Contact Rate (rider late &gt;0)&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders_rl_0] END)&#10;WHEN &quot;.....% Late Delivery Contact Rate (rider late &gt;5)&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders_rl_5] END)&#10;WHEN &quot;.....% Late Delivery Contact Rate (rider late &gt;10)&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders_rl_10] END)&#10;&#10;&#10;WHEN &quot;...% Request Rider ETA Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;.....% Request Rider ETA Contact Rate (rider late &gt;0)&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders_rl_0] END)&#10;WHEN &quot;.....% Request Rider ETA Contact Rate (rider late &gt;5)&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders_rl_5] END)&#10;WHEN &quot;.....% Request Rider ETA Contact Rate (rider late &gt;10)&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders_rl_10] END)&#10;//&#10;WHEN &quot;aVTC&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [platform_order_code_avtc] END)&#10;WHEN &quot;Vendor Late Above 10&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [vendor_late_calculation] END)&#10;//orders&#10;WHEN &quot;Auto Accept Orders&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;Orders on Time&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;Seamless Orders&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;&#10;&#10;END' />
            </column>
            <column caption='∆  Metrics Denominator - Variant A' datatype='integer' name='[Calculation_3902369094168502277]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;// based on total orders&#10;WHEN &quot;% Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;% Customer Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;% Vendor Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;...% No Response Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;...% Item Unavailable Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;// contacts&#10;WHEN &quot;% Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;% Vendor Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;% Rider Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;% Customer Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;% Live Order Inquiries Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;&#10;WHEN &quot;...% Late Delivery Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;.....% Late Delivery Contact Rate (rider late &gt;0)&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders_rl_0] END)&#10;WHEN &quot;.....% Late Delivery Contact Rate (rider late &gt;5)&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders_rl_5] END)&#10;WHEN &quot;.....% Late Delivery Contact Rate (rider late &gt;10)&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders_rl_10] END)&#10;&#10;WHEN &quot;...% Request Rider ETA Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;.....% Request Rider ETA Contact Rate (rider late &gt;0)&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders_rl_0] END)&#10;WHEN &quot;.....% Request Rider ETA Contact Rate (rider late &gt;5)&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders_rl_5] END)&#10;WHEN &quot;.....% Request Rider ETA Contact Rate (rider late &gt;10)&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders_rl_10] END)&#10;//&#10;WHEN &quot;aVTC&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [platform_order_code_avtc] END)&#10;WHEN &quot;Vendor Late Above 10&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [vendor_late_calculation] END)&#10;//orders&#10;WHEN &quot;Orders on Time&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;Seamless Orders&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;&#10;END' />
            </column>
            <column caption='_int_metrics' datatype='integer' name='[Calculation_4047962031569936392]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;aVTC&apos; THEN 1&#10;WHEN &apos;# Vendors with event&apos; THEN 1&#10;WHEN &apos;# Order&apos; THEN 1&#10;WHEN &apos;# Events (view rider location)&apos; THEN 1&#10;&#10;ELSE 0&#10;END' />
            </column>
            <column caption='_granularity_filter' datatype='boolean' name='[Calculation_4565524148946161665]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;&#10;WHEN &quot;Daily&quot; THEN [date_type] = &quot;Daily&quot;&#10;WHEN &quot;Weekly&quot; THEN [date_type] = &quot;Weekly&quot;&#10;&#10;END' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_4565524148946345986]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [date_type]&#10;WHEN &quot;Daily&quot; THEN STR(DATE([created_date_local]))&#10;WHEN &quot;Weekly&quot; THEN STR(YEAR([created_date_local]))+&quot;-W&quot;+STR([weeks])&#10;END' />
            </column>
            <column caption='% Item Unavailable Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_4565524149076819972]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([item_unavailable_vendor_failed_orders])/SUM([orders])' />
            </column>
            <column caption='Variants filter' datatype='boolean' name='[Variants (copy)_1879126963555889156]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;&#10;WHEN &quot;Variant A&quot; THEN [experiment_group] IN (&quot;Variant A&quot;, &quot;Baseline&quot;)&#10;WHEN &quot;Variant B&quot; THEN [experiment_group] IN (&quot;Variant B&quot;, &quot;Baseline&quot;)&#10;&#10;END' />
            </column>
