        <calculation class='tableau' formula='(&#10;    SUM(&#10;    { INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;POST&apos; THEN [avtc] END)&#10;    /&#10;    SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;POST&apos; THEN [platform_order_code_avtc] END)&#10;    })&#10;&#10;    /&#10;&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;POST&apos; THEN [avtc] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;POST&apos; THEN [platform_order_code_avtc] END)&#10;    })&#10;&#10;    - 1&#10;)&#10;-&#10;(&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;PRE&apos; THEN [avtc] END)&#10;    /&#10;    SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;PRE&apos; THEN [platform_order_code_avtc] END)&#10;    })&#10;    /&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;PRE&apos; THEN [avtc] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;PRE&apos; THEN [platform_order_code_avtc] END)&#10;    })&#10;    - 1&#10;)' />
