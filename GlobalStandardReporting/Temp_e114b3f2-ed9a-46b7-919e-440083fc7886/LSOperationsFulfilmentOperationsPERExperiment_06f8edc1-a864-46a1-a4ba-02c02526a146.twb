    <worksheet name='Significance'>
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='edu_per_experiment_235 (qc_product_analytics)' name='federated.1ldqbsf1ojdw9j1e21cgs0wkmpoo' />
          </datasources>
          <datasource-dependencies datasource='federated.1ldqbsf1ojdw9j1e21cgs0wkmpoo'>
            <column caption='T-Score' datatype='real' name='[Calculation_2053922920397111303]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ABS(([Calculation_2053922920409325584])-([Calculation_2053922920409108495]))/&#10;SQRT(&#10;(POWER(STDEV([Calculation_2053922920409325584]),2)/ [Calculation_2053922920397819914])&#10;+&#10;    (POWER(STDEV([Calculation_2053922920409108495]),2)/[Calculation_2053922920397889547]))' />
            </column>
            <column caption='Sample Size CTRL' datatype='integer' name='[Calculation_2053922920397819914]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF  [model_strategy] = &apos;LS3&apos; &#10;AND  [item_not_found] = 1 &#10;//AND [Replacement Sent Items] = 1&#10;then [order_id] + [product_sku] END)' />
            </column>
            <column caption='Sample Size Test' datatype='integer' name='[Calculation_2053922920397889547]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( &#10;IF  [model_strategy] = &apos;PER&apos; &#10;AND  [item_not_found] = 1 &#10;//AND [Replacement Sent Items] = 1&#10;then [order_id] + [product_sku] &#10;END)' />
            </column>
            <column caption='%CVR test SentToConfirmed' datatype='real' default-format='p0.0%' name='[Calculation_2053922920409108495]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;IF [model_strategy] = &apos;PER&apos; and &#10;([item_pelican_status] = &apos;NOT_FOUND&apos; OR [item_pelican_status]= &apos;REPLACED&apos;) AND&#10;[replacement_answered_confirmed_items] = 1&#10;THEN [order_id] + [product_sku] ELSE NULL END) &#10;&#10;/&#10;COUNTD( &#10;IF  [model_strategy] = &apos;PER&apos; &#10;//AND  [Item Not Found] = 1 &#10;AND ([item_pelican_status] = &apos;NOT_FOUND&apos; OR [item_pelican_status]= &apos;REPLACED&apos;)&#10;AND [replacement_sent_items] = 1&#10;then [order_id] + [product_sku] &#10;END)' />
            </column>
            <column caption='%CVR Ctr SentToConfirmed' datatype='real' default-format='p0.0%' name='[Calculation_2053922920409325584]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;IF [model_strategy] = &apos;LS3&apos; and &#10;([item_pelican_status] = &apos;NOT_FOUND&apos; OR [item_pelican_status]= &apos;REPLACED&apos;) AND&#10;[replacement_answered_confirmed_items] = 1&#10;THEN [order_id] + [product_sku] ELSE NULL END) &#10;&#10;/&#10;COUNTD( &#10;IF  [model_strategy] = &apos;LS3&apos; &#10;AND ([item_pelican_status] = &apos;NOT_FOUND&apos; OR [item_pelican_status]= &apos;REPLACED&apos;)&#10;//AND  [Item Not Found] = 1 &#10;AND [replacement_sent_items] = 1&#10;then [order_id] + [product_sku] &#10;END)' />
            </column>
            <column caption='Significance' datatype='string' name='[Calculation_278941719328980993]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IIF([Calculation_307933640167813120] &lt;= 0.05, &quot;Significant&quot;,&#10;&#10;&quot;No-significant&quot;)' />
            </column>
            <column caption='p-value' datatype='real' name='[Calculation_307933640167813120]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='2*(0.5*exp(-1.2*power(abs([Calculation_2053922920397111303]),1.3)))' />
            </column>
            <column caption='Item Not Found' datatype='integer' name='[item_not_found]' role='measure' type='quantitative' />
            <column caption='Item Pelican Status' datatype='string' name='[item_pelican_status]' role='dimension' type='nominal' />
            <column caption='Local Date' datatype='date' name='[local_date]' role='dimension' type='ordinal' />
            <column caption='Model Strategy' datatype='string' name='[model_strategy]' role='dimension' type='nominal' />
            <column-instance column='[local_date]' derivation='None' name='[none:local_date:qk]' pivot='key' type='quantitative' />
            <column caption='Order Id' datatype='string' name='[order_id]' role='dimension' type='nominal' />
            <column caption='Product Sku' datatype='string' name='[product_sku]' role='dimension' type='nominal' />
            <column caption='Replacement Answered Confirmed Items' datatype='integer' name='[replacement_answered_confirmed_items]' role='measure' type='quantitative' />
            <column caption='Replacement Sent Items' datatype='integer' name='[replacement_sent_items]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_278941719328980993]' derivation='User' name='[usr:Calculation_278941719328980993:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='quantitative' column='[federated.1ldqbsf1ojdw9j1e21cgs0wkmpoo].[none:local_date:qk]' filter-group='3' included-values='in-range'>
