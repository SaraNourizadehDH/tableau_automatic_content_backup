      <aliases enabled='yes' />
      <column caption='%CVR Ctr EvaluationToConfirmed ' datatype='real' default-format='p0.0%' name='[%CVR Ctr SentToConfirmed (copy)_3059773758459691022]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;IF [model_strategy] = &apos;LS3&apos; and &#10;([item_pelican_status] = &apos;NOT_FOUND&apos; OR [item_pelican_status]= &apos;REPLACED&apos;) AND&#10;[replacement_answered_confirmed_items] = 1&#10;THEN [order_id] + [product_sku] ELSE NULL END) &#10;&#10;/&#10;COUNTD( &#10;IF  [model_strategy] = &apos;LS3&apos; &#10;AND  [item_not_found] = 1 &#10;//AND [Replacement Sent Items] = 1&#10;then [order_id] + [product_sku] &#10;END)' />
      </column>
      <column caption='%CVR Ctr ViewToSent' datatype='real' default-format='p0.0%' name='[%CVR Ctr SentToConfirmed (copy)_3864932929719377920]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;IF [model_strategy] = &apos;LS3&apos; and &#10;([item_pelican_status] = &apos;NOT_FOUND&apos; OR [item_pelican_status]= &apos;REPLACED&apos;) AND&#10;[replacement_sent_items] = 1&#10;THEN [order_id] + [product_sku] ELSE NULL END) &#10;/&#10;COUNTD( &#10;IF  [model_strategy] = &apos;LS3&apos; &#10;AND ([item_pelican_status] = &apos;NOT_FOUND&apos; OR [item_pelican_status]= &apos;REPLACED&apos;)&#10;//AND  [Item Not Found] = 1 &#10;AND [replacement_suggestion_items] = 1&#10;then [order_id] + [product_sku] &#10;END)' />
      </column>
      <column caption='%CVR test ViewToSent' datatype='real' default-format='p0.0%' name='[%CVR Ctr ViewToSent (copy)_3864932929719922689]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;IF [model_strategy] = &apos;PER&apos; and &#10;([item_pelican_status] = &apos;NOT_FOUND&apos; OR [item_pelican_status]= &apos;REPLACED&apos;) AND&#10;[replacement_sent_items] = 1&#10;THEN [order_id] + [product_sku] ELSE NULL END) &#10;/&#10;COUNTD( &#10;IF  [model_strategy] = &apos;PER&apos; &#10;AND ([item_pelican_status] = &apos;NOT_FOUND&apos; OR [item_pelican_status]= &apos;REPLACED&apos;)&#10;//AND  [Item Not Found] = 1 &#10;AND [replacement_suggestion_items] = 1&#10;then [order_id] + [product_sku] &#10;END)' />
      </column>
      <column caption='%CVR test EvaluationToConfirmed ' datatype='real' default-format='p0.0%' name='[%CVR test SentToConfirmed (copy)_3059773758459846671]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;IF [model_strategy] = &apos;PER&apos; and &#10;([item_pelican_status] = &apos;NOT_FOUND&apos; OR [item_pelican_status]= &apos;REPLACED&apos;) AND&#10;[replacement_answered_confirmed_items] = 1&#10;THEN [order_id] + [product_sku] ELSE NULL END) &#10;&#10;/&#10;COUNTD( &#10;IF  [model_strategy] = &apos;PER&apos; &#10;AND  [item_not_found] = 1 &#10;//AND [Replacement Sent Items] = 1&#10;then [order_id] + [product_sku] &#10;END)' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1ldqbsf1ojdw9j1e21cgs0wkmpoo].[usr:Calculation_2053922920409108495:qk]&quot;' value='%CVR test ' />
          <alias key='&quot;[federated.1ldqbsf1ojdw9j1e21cgs0wkmpoo].[usr:Calculation_2053922920409325584:qk]&quot;' value='%CVR Ctr ' />
