      </column>
      <column caption='TEST' datatype='integer' name='[CTRL (copy)_2053922920396951558]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [random] &gt;= 3 THEN [replacement_ans_conf_items]&#10;&#10;END' />
      </column>
      <column caption='CTRL' datatype='integer' name='[Calculation_2053922920392404993]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [random] &lt; 3 THEN [replacement_ans_conf_items]&#10;&#10;END' />
      </column>
      <column caption='T-Score' datatype='real' name='[Calculation_2053922920397111303]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ABS(([Calculation_2053922920409325584])-([Calculation_2053922920409108495]))/&#10;SQRT(&#10;(POWER(STDEV([Calculation_2053922920409325584]),2)/ [Calculation_2053922920397819914])&#10;+&#10;    (POWER(STDEV([Calculation_2053922920409108495]),2)/[Calculation_2053922920397889547]))' />
      </column>
      <column caption='Order id CTRL' datatype='string' name='[Calculation_2053922920397373448]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [random] &lt;3 THEN [order_id] END' />
      </column>
      <column caption='Order id TEST' datatype='string' name='[Calculation_2053922920397737993]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [random] &gt;=3 THEN [order_id] END' />
      </column>
      <column caption='Sample Size CTRL' datatype='integer' name='[Calculation_2053922920397819914]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( IF  [model_strategy] = &apos;LS3&apos; &#10;AND  [item_not_found] = 1 &#10;//AND [Replacement Sent Items] = 1&#10;then [order_id] + [product_sku] END)' />
      </column>
      <column caption='Sample Size Test' datatype='integer' name='[Calculation_2053922920397889547]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( &#10;IF  [model_strategy] = &apos;PER&apos; &#10;AND  [item_not_found] = 1 &#10;//AND [Replacement Sent Items] = 1&#10;then [order_id] + [product_sku] &#10;END)' />
