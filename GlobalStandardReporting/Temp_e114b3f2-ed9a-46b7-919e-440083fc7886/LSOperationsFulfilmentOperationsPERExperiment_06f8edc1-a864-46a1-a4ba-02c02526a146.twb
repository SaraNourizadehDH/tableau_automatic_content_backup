          <datasource-dependencies datasource='federated.1ldqbsf1ojdw9j1e21cgs0wkmpoo'>
            <column caption='Sample Size CTRL' datatype='integer' name='[Calculation_2053922920397819914]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF  [model_strategy] = &apos;LS3&apos; &#10;AND  [item_not_found] = 1 &#10;//AND [Replacement Sent Items] = 1&#10;then [order_id] + [product_sku] END)' />
            </column>
            <column caption='Sample Size Test' datatype='integer' name='[Calculation_2053922920397889547]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( &#10;IF  [model_strategy] = &apos;PER&apos; &#10;AND  [item_not_found] = 1 &#10;//AND [Replacement Sent Items] = 1&#10;then [order_id] + [product_sku] &#10;END)' />
            </column>
            <column caption='%CVR test SentToConfirmed' datatype='real' default-format='p0.0%' name='[Calculation_2053922920409108495]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;IF [model_strategy] = &apos;PER&apos; and &#10;([item_pelican_status] = &apos;NOT_FOUND&apos; OR [item_pelican_status]= &apos;REPLACED&apos;) AND&#10;[replacement_answered_confirmed_items] = 1&#10;THEN [order_id] + [product_sku] ELSE NULL END) &#10;&#10;/&#10;COUNTD( &#10;IF  [model_strategy] = &apos;PER&apos; &#10;//AND  [Item Not Found] = 1 &#10;AND ([item_pelican_status] = &apos;NOT_FOUND&apos; OR [item_pelican_status]= &apos;REPLACED&apos;)&#10;AND [replacement_sent_items] = 1&#10;then [order_id] + [product_sku] &#10;END)' />
            </column>
            <column caption='%CVR Ctr SentToConfirmed' datatype='real' default-format='p0.0%' name='[Calculation_2053922920409325584]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;IF [model_strategy] = &apos;LS3&apos; and &#10;([item_pelican_status] = &apos;NOT_FOUND&apos; OR [item_pelican_status]= &apos;REPLACED&apos;) AND&#10;[replacement_answered_confirmed_items] = 1&#10;THEN [order_id] + [product_sku] ELSE NULL END) &#10;&#10;/&#10;COUNTD( &#10;IF  [model_strategy] = &apos;LS3&apos; &#10;AND ([item_pelican_status] = &apos;NOT_FOUND&apos; OR [item_pelican_status]= &apos;REPLACED&apos;)&#10;//AND  [Item Not Found] = 1 &#10;AND [replacement_sent_items] = 1&#10;then [order_id] + [product_sku] &#10;END)' />
