              <aliases>
                <alias key='&quot;How use when OOO&quot;' value='How do you use this device when product is OOS' />
                <alias key='&quot;The information is provided?&quot;' value='Pelican offer you the product information you need?' />
              </aliases>
            </column>
            <column caption='Response' datatype='string' name='[Pivot Field Values]' role='dimension' type='nominal' />
            <column datatype='string' name='[Question name (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[Pivot Field Names]' new-bin='true'>
                <bin default-name='false' value='&quot;Attributes&quot;'>
                  <value>&quot;Do you fulfill orders?&quot;</value>
                  <value>&quot;How long working?&quot;</value>
                  <value>&quot;Role&quot;</value>
