                <bin default-name='false' value='&quot;Training&quot;'>
                  <value>&quot;Best training&quot;</value>
                  <value>&quot;Have trained?&quot;</value>
                  <value>&quot;How many times presented to device&quot;</value>
                </bin>
              </calculation>
            </column>
