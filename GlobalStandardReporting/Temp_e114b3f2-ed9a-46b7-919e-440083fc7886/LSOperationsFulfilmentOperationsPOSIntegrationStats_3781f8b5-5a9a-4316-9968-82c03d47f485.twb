            <column caption='Partial Orders' datatype='integer' name='[partial_orders]' role='measure' type='quantitative' />
            <column caption='Picking Time Seconds' datatype='real' name='[picking_time_seconds]' role='measure' type='quantitative' />
            <column aggregation='CountD' caption='Platform Vendor Id' datatype='string' default-role='measure' default-type='quantitative' name='[platform_vendor_id]' role='dimension' type='nominal' />
            <column caption='Region' datatype='string' name='[region]' role='dimension' type='nominal' />
