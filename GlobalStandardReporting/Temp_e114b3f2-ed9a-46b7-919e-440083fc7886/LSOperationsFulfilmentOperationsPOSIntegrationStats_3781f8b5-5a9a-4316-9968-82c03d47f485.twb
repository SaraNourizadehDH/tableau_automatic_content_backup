            </column>
            <column caption='Is POS' datatype='integer' name='[Calculation_1856327511271936000]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='CASE [integration_type_sftp] &#13;&#10;WHEN &apos;POS_DIRECT_INTEGRATED&apos; then 1&#13;&#10;WHEN &apos;POS_INDIRECT_INTEGRATED&apos; THEN 1&#13;&#10;else 0&#13;&#10;END' />
