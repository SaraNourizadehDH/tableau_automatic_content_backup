            <column-instance column='[Failed Orders (%) (copy)_2353130831076614176]' derivation='User' name='[usr:Failed Orders (%) (copy)_2353130831076614176:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Failed Orders Logistics (%) (copy)_2353130831076786209]' derivation='User' name='[usr:Failed Orders Logistics (%) (copy)_2353130831076786209:qk]' pivot='key' type='quantitative' />
