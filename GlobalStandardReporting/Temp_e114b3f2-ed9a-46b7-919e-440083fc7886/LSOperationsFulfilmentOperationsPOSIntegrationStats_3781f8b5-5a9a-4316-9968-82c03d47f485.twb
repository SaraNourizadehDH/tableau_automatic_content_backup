    <worksheet name='Sheet 11'>
      <table>
        <view>
          <datasources>
            <datasource caption='_tableau_local_shops_sc_v2 (dev_dmart)' name='federated.1b1pxy60d5rv7918qhnm61k9tqia' />
          </datasources>
          <datasource-dependencies datasource='federated.1b1pxy60d5rv7918qhnm61k9tqia'>
            <column caption='% Partial Fulfilled orders' datatype='real' name='[Calculation_2353130828561588224]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([partial_orders])/sum(CASE [is_pelican] WHEN TRUE THEN [confirmed_orders] ELSE 0 END)' />
            </column>
            <column caption='NULL' datatype='integer' name='[Calculation_2353130830725185555]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF FALSE THEN 0 ELSE NULL END' />
            </column>
            <column caption='Failed Orders (%)' datatype='real' name='[Calculation_2353130830727802903]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_orders])/SUM([total_orders])' />
            </column>
            <column caption='Picking Time (min)' datatype='real' name='[Calculation_2353130831029186586]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([picking_time_seconds])/sum([has_picking_time_orders])/60' />
            </column>
            <column caption='Basket Value' datatype='real' name='[Calculation_2353130831063846943]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([gbv_gross_of_vat_2])/sum([confirmed_orders])' />
            </column>
            <column caption='Failed Orders Logistics (%)' datatype='real' name='[Failed Orders (%) (copy)_2353130831076614176]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([transport_failed_orders])/SUM([total_orders])' />
            </column>
            <column caption='Failed Orders Vendor (%)' datatype='real' name='[Failed Orders Logistics (%) (copy)_2353130831076786209]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Failed Orders Vendor (%) (copy)_917889931537559581])/SUM([total_orders])' />
            </column>
            <column caption='vendor_failed_orders' datatype='integer' name='[Failed Orders Vendor (%) (copy)_917889931537559581]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Failure Owner (%) (copy)_2353130835787022385] == &quot;VENDOR&quot; THEN 1 ELSE 0 end' />
            </column>
            <column caption='Failure Owner' datatype='string' name='[Failure Owner (%) (copy)_2353130835787022385]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [failure_owner] &#13;&#10;when &quot;CUSTOMER&quot; then &quot;CUSTOMER&quot;&#13;&#10;when  &quot;VENDOR&quot; THEN &quot;VENDOR&quot;&#13;&#10;WHEN  &quot;TRANSPORT&quot; THEN &quot;TRANSPORT&quot;&#13;&#10;WHEN   &quot;PLATFORM&quot; THEN  &quot;PLATFORM&quot;&#13;&#10;ELSE NULL END' />
              <aliases>
                <alias key='&quot;CUSTOMER&quot;' value='Customer' />
                <alias key='&quot;PLATFORM&quot;' value='Platform' />
                <alias key='&quot;TRANSPORT&quot;' value='Logistics' />
                <alias key='&quot;VENDOR&quot;' value='Vendor' />
              </aliases>
            </column>
            <column caption='NULL 2' datatype='integer' name='[NULL (copy)_2353130830725386260]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF FALSE THEN 0 ELSE NULL END' />
            </column>
            <column caption='Delivery Time (min)' datatype='real' name='[Picking Time (min) (copy)_2353130831059673118]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([delivery_time_minutes])/sum([has_delivery_time_orders])' />
            </column>
            <column caption='Confirmed Orders' datatype='integer' name='[confirmed_orders]' role='measure' type='quantitative' />
            <column-instance column='[platform_vendor_id]' derivation='CountD' name='[ctd:platform_vendor_id:qk]' pivot='key' type='quantitative' />
            <column caption='Delivery Time Minutes' datatype='real' name='[delivery_time_minutes]' role='measure' type='quantitative' />
            <column caption='Failed Orders' datatype='integer' name='[failed_orders]' role='measure' type='quantitative' />
            <column datatype='string' name='[failure_owner]' role='dimension' type='nominal' />
            <column caption='Gbv Gross Of Vat 2' datatype='real' name='[gbv_gross_of_vat_2]' role='measure' type='quantitative' />
            <column caption='Has Delivery Time Orders' datatype='integer' name='[has_delivery_time_orders]' role='measure' type='quantitative' />
            <column caption='Has Picking Time Orders' datatype='integer' name='[has_picking_time_orders]' role='measure' type='quantitative' />
            <column caption='Is Pelican' datatype='boolean' name='[is_pelican]' role='dimension' type='nominal'>
              <aliases>
                <alias key='false' value='Godroid Vendors' />
                <alias key='true' value='Pelican Vendors' />
              </aliases>
            </column>
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column-instance column='[management_entity]' derivation='None' name='[none:management_entity:nk]' pivot='key' type='nominal' />
            <column-instance column='[report_week]' derivation='None' name='[none:report_week:ok]' pivot='key' type='ordinal' />
            <column-instance column='[store_type_l1]' derivation='None' name='[none:store_type_l1:nk]' pivot='key' type='nominal' />
            <column caption='Partial Orders' datatype='integer' name='[partial_orders]' role='measure' type='quantitative' />
            <column caption='Picking Time Seconds' datatype='real' name='[picking_time_seconds]' role='measure' type='quantitative' />
            <column aggregation='CountD' caption='Platform Vendor Id' datatype='string' default-role='measure' default-type='quantitative' name='[platform_vendor_id]' role='dimension' type='nominal' />
            <column caption='Report Week' datatype='date' name='[report_week]' role='dimension' type='ordinal' />
            <column caption='Store Type L1' datatype='string' name='[store_type_l1]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2353130830725185555]' derivation='Sum' name='[sum:Calculation_2353130830725185555:qk]' pivot='key' type='quantitative' />
            <column-instance column='[NULL (copy)_2353130830725386260]' derivation='Sum' name='[sum:NULL (copy)_2353130830725386260:qk]' pivot='key' type='quantitative' />
            <column-instance column='[confirmed_orders]' derivation='Sum' name='[sum:confirmed_orders:qk]' pivot='key' type='quantitative' />
