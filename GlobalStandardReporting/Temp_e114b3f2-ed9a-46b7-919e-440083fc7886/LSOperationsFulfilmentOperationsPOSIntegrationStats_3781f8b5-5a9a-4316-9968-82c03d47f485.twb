    <worksheet name='Product Rollout'>
      <table>
        <view>
          <datasources>
            <datasource caption='_tableau_local_shops_sc_v2 (dev_dmart)' name='federated.1b1pxy60d5rv7918qhnm61k9tqia' />
          </datasources>
          <datasource-dependencies datasource='federated.1b1pxy60d5rv7918qhnm61k9tqia'>
            <column caption='% Catalog Vendors' datatype='real' name='[% Pelican Vendors (copy)_2353130830701985807]' role='measure' type='quantitative' visual-totals='Sum'>
              <calculation class='tableau' formula='countd([Global_vendor_id_SFTP (copy)_2353130830701535245])/countd([Calculation_2353130828590903298])' />
            </column>
            <column caption='% SFTP Vendors' datatype='real' name='[% Pelican Vendors (copy)_2353130830702141456]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd([Calculation_2353130830678937611])/countd([Calculation_2353130828590903298])' />
            </column>
            <column caption='Pelican Orders (%)' datatype='real' name='[% share of Pelican (copy)_2353130830416297993]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2353130828589621249]/sum([confirmed_orders])' />
            </column>
            <column caption='Is POS' datatype='integer' name='[Calculation_1856327511271936000]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='CASE [integration_type_sftp] &#13;&#10;WHEN &apos;POS_DIRECT_INTEGRATED&apos; then 1&#13;&#10;WHEN &apos;POS_INDIRECT_INTEGRATED&apos; THEN 1&#13;&#10;else 0&#13;&#10;END' />
              <aliases>
                <alias key='0' value='Non-Integrated' />
                <alias key='1' value='Integrated' />
              </aliases>
            </column>
            <column caption='Pelican Orders (#)' datatype='integer' name='[Calculation_2353130828589621249]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(CASE  [is_pelican] WHEN TRUE THEN [confirmed_orders] END)' />
            </column>
            <column aggregation='CountD' caption='Global_VendorId' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_2353130828590903298]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[global_entity_id]+[platform_vendor_id]' />
            </column>
            <column aggregation='CountD' caption='Global_vendor_id_pelican' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_2353130828595814404]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [is_pelican] when TRUE then [Calculation_2353130828590903298] END' />
            </column>
            <column caption='% Pelican Vendors' datatype='real' name='[Calculation_2353130828598181893]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd([Calculation_2353130828595814404])/countd([Calculation_2353130828590903298])' />
            </column>
            <column caption='% sftp orders' datatype='real' name='[Calculation_2353130830675308554]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([is_sftp])/sum([total_orders])' />
            </column>
            <column aggregation='CountD' caption='Global_vendor_id_SFTP' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_2353130830678937611]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [is_sftp] when 1 then [Calculation_2353130828590903298] END' />
            </column>
            <column caption='Pelican Vendors' datatype='integer' name='[Calculation_2353130831029985307]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_2353130828595814404])' />
            </column>
            <column caption='Global_vendor_id_Catalog' datatype='string' name='[Global_vendor_id_SFTP (copy)_2353130830701535245]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [is_catalog] when 1 then [Calculation_2353130828590903298] END' />
            </column>
            <column caption='Region ' datatype='string' name='[POS orders (copy)_1856327511277821954]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [region] &#13;&#10;WHEN &apos;MENA&apos; then [management_entity]&#13;&#10;else [region]&#13;&#10;END' />
            </column>
            <column caption='POS Orders (%)' datatype='real' name='[Pelican Orders (%) (copy)_1856327511272615937]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1856327511271936000])/sum([confirmed_orders])' />
            </column>
            <column caption='Confirmed Orders' datatype='integer' name='[confirmed_orders]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_2353130828595814404]' derivation='CountD' name='[ctd:Calculation_2353130828595814404:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2353130830678937611]' derivation='CountD' name='[ctd:Calculation_2353130830678937611:qk]' pivot='key' type='quantitative' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column datatype='string' name='[integration_type_sftp]' role='dimension' type='nominal' />
            <column datatype='integer' name='[is_catalog]' role='measure' type='quantitative'>
              <aliases>
                <alias key='0' value='Non-Catalog' />
                <alias key='1' value='Catalog' />
              </aliases>
            </column>
            <column caption='Is Pelican' datatype='boolean' name='[is_pelican]' role='dimension' type='nominal'>
              <aliases>
