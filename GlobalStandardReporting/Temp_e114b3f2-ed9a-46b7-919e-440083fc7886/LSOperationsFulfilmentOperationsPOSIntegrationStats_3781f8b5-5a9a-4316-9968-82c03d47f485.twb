            <column caption='Partial Orders' datatype='integer' name='[partial_orders]' role='measure' type='quantitative' />
            <column caption='Region' datatype='string' name='[region]' role='dimension' type='nominal' />
            <column caption='Report Week' datatype='date' name='[report_week]' role='dimension' type='ordinal' />
            <column caption='Store Type L1' datatype='string' name='[store_type_l1]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2353130828561588224]' derivation='User' name='[usr:Calculation_2353130828561588224:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1b1pxy60d5rv7918qhnm61k9tqia].[none:is_pelican:nk]'>
            <groupfilter function='level-members' level='[none:is_pelican:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.1b1pxy60d5rv7918qhnm61k9tqia].[none:management_entity:nk]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter from='&quot;Carriage&quot;' function='range' level='[none:management_entity:nk]' to='&quot;HungerStation&quot;' />
