    <worksheet name='Partial Fulfillment SFTP'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Partial Fulfillment for Chains Using SFTP</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='_tableau_local_shops_sc_v2 (dev_dmart)' name='federated.1b1pxy60d5rv7918qhnm61k9tqia' />
          </datasources>
          <datasource-dependencies datasource='federated.1b1pxy60d5rv7918qhnm61k9tqia'>
            <column caption='# SFTP' datatype='string' name='[# Catalog Vendors (copy)_2353130836055945271]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [is_sftp] &#13;&#10;when 1  then &quot;SFTP&quot;&#13;&#10;else &quot;No SFTP&quot;&#13;&#10;END' />
            </column>
            <column caption='% Partial Fulfilled orders' datatype='real' name='[Calculation_2353130828561588224]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([partial_orders])/sum(CASE [is_pelican] WHEN TRUE THEN [confirmed_orders] ELSE 0 END)' />
            </column>
            <column caption='Global_vendorId_discrete' datatype='string' name='[Calculation_2353130836056907833]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[global_entity_id]+[platform_vendor_id]' />
            </column>
            <column caption='Chain Name' datatype='string' name='[chain_name]' role='dimension' type='nominal' />
            <column caption='Confirmed Orders' datatype='integer' name='[confirmed_orders]' role='measure' type='quantitative' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Is Pelican' datatype='boolean' name='[is_pelican]' role='dimension' type='nominal'>
              <aliases>
                <alias key='false' value='Godroid Vendors' />
                <alias key='true' value='Pelican Vendors' />
