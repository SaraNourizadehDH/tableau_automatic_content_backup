    <worksheet name='Item Heartbeat V1 (during exp.)'>
      <table>
        <view>
          <datasources>
            <datasource caption='_tableau_local_shops_sc_v2 (dev_dmart)' name='federated.1b1pxy60d5rv7918qhnm61k9tqia' />
          </datasources>
          <datasource-dependencies datasource='federated.1b1pxy60d5rv7918qhnm61k9tqia'>
            <column caption='% Partial Fulfilled orders' datatype='real' name='[Calculation_2353130828561588224]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([partial_orders])/sum(CASE [is_pelican] WHEN TRUE THEN [confirmed_orders] ELSE 0 END)' />
            </column>
            <column aggregation='CountD' caption='Global_VendorId' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_2353130828590903298]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[global_entity_id]+[platform_vendor_id]' />
            </column>
            <column caption='Picking Time (min)' datatype='real' name='[Calculation_2353130831029186586]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([picking_time_seconds])/sum([has_picking_time_orders])/60' />
            </column>
            <column caption='ABV' datatype='real' name='[Calculation_2353130831368994853]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Gbv Gross Of Vat 2 (copy)_1721782475298234368])/SUM([confirmed_orders])' />
            </column>
            <column caption='Failure Owner (%)' datatype='real' name='[Calculation_2353130835655344173]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([Failure Owner (%) (copy)_2353130835787022385]) / SUM( { EXCLUDE  [Failure Owner (%) (copy)_2353130835787022385] : SUM([Calculation_2353130835669901360]) } )' />
            </column>
            <column caption='1' datatype='integer' name='[Calculation_2353130835669901360]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Failure Reason' datatype='string' name='[Calculation_2353130836038262835]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='replace([failure_reason], &apos;_&apos;, &apos; &apos;)' />
            </column>
            <column caption='OOS Fail Rate' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_2797016889827160065]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_2353130836038262835] = &quot;ITEM UNAVAILABLE&quot; and [Failure Owner (%) (copy)_2353130835787022385] = &apos;VENDOR&apos; then &apos;OOS Fail Rate&apos; ELSE NULL END' />
            </column>
            <column caption='OOS Fail Rate  (%)' datatype='real' name='[Calculation_2797016889846480898]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([Calculation_2797016889827160065])/sum([total_orders])' />
            </column>
            <column caption='Failed Orders Vendor (%)' datatype='real' name='[Failed Orders Logistics (%) (copy)_2353130831076786209]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Failed Orders Vendor (%) (copy)_917889931537559581])/SUM([total_orders])' />
            </column>
            <column caption='vendor_failed_orders' datatype='integer' name='[Failed Orders Vendor (%) (copy)_917889931537559581]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Failure Owner (%) (copy)_2353130835787022385] == &quot;VENDOR&quot; THEN 1 ELSE 0 end' />
            </column>
            <column caption='Failure Owner' datatype='string' name='[Failure Owner (%) (copy)_2353130835787022385]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [failure_owner] &#13;&#10;when &quot;CUSTOMER&quot; then &quot;CUSTOMER&quot;&#13;&#10;when  &quot;VENDOR&quot; THEN &quot;VENDOR&quot;&#13;&#10;WHEN  &quot;TRANSPORT&quot; THEN &quot;TRANSPORT&quot;&#13;&#10;WHEN   &quot;PLATFORM&quot; THEN  &quot;PLATFORM&quot;&#13;&#10;ELSE NULL END' />
              <aliases>
                <alias key='&quot;CUSTOMER&quot;' value='Customer' />
                <alias key='&quot;PLATFORM&quot;' value='Platform' />
                <alias key='&quot;TRANSPORT&quot;' value='Logistics' />
                <alias key='&quot;VENDOR&quot;' value='Vendor' />
              </aliases>
            </column>
            <column caption='Partial Fulfillment (GMV)' datatype='real' name='[Gbv Gross Of Vat - Partial Orders (copy)_1721782475298459649]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([gbv_gross_of_vat_2])/sum([gbv_gross_of_vat_2_including_not_send])' />
            </column>
            <column caption='Gbv Gross Of Vat - sent Orders' datatype='real' name='[Gbv Gross Of Vat 2 (copy)_1721782475298234368]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [confirmed_orders]&#13;&#10;when 1 then [gbv_gross_of_vat_2] else 0&#13;&#10;END' />
            </column>
            <column caption='GMV Loss' datatype='real' name='[Partial Fulfillment (GMV) (copy)_1721782476044238851]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([gbv_gross_of_vat_2_including_not_send])-sum([gbv_gross_of_vat_2])' />
            </column>
            <column caption='Delivery Time (min)' datatype='real' name='[Picking Time (min) (copy)_2353130831059673118]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([delivery_time_minutes])/sum([has_delivery_time_orders])' />
            </column>
            <column caption='Confirmed Orders' datatype='integer' name='[confirmed_orders]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_2353130828590903298]' derivation='CountD' name='[ctd:Calculation_2353130828590903298:qk]' pivot='key' type='quantitative' />
            <column caption='Delivery Time Minutes' datatype='real' name='[delivery_time_minutes]' role='measure' type='quantitative' />
            <column datatype='string' name='[failure_owner]' role='dimension' type='nominal' />
            <column datatype='string' name='[failure_reason]' role='dimension' type='nominal' />
            <column caption='Gbv Gross Of Vat 2' datatype='real' name='[gbv_gross_of_vat_2]' role='measure' type='quantitative' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Has Delivery Time Orders' datatype='integer' name='[has_delivery_time_orders]' role='measure' type='quantitative' />
            <column caption='Has Picking Time Orders' datatype='integer' name='[has_picking_time_orders]' role='measure' type='quantitative' />
            <column-instance column='[Item Heartbeat 2+1 (copy)]' derivation='InOut' name='[io:Item Heartbeat 2+1 (copy):nk]' pivot='key' type='nominal' />
            <column caption='Is Pelican' datatype='boolean' name='[is_pelican]' role='dimension' type='nominal'>
