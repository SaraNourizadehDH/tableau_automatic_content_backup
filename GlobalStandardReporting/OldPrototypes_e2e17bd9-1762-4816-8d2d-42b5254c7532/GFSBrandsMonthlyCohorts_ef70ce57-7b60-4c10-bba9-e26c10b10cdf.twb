      <column caption='Cumulative_Order_fixed' datatype='real' name='[Calculation_2018738589216595968]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  MAX(DATE(DATEADD(&apos;month&apos;,[yr_mon_int_final],[brand_acq_yr_mon_int]))) &lt; DATETRUNC(&quot;month&quot;,TODAY()) THEN RUNNING_SUM(SUM([gmv_eur])) ELSE NULL END'>
