      <column caption='Measure_val_by_PM_2' datatype='real' name='[Measure_val_by_PM (copy)_1623547714044727296]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Measure to show (copy)_1623547714044821505] == &apos;Customers&apos; THEN SUM([customers])&#13;&#10;ELSEIF [Parameters].[Measure to show (copy)_1623547714044821505] == &apos;Reorder Rate&apos; THEN SUM([customers])*100/SUM([cus_in_cohort])&#13;&#10;ELSEIF [Parameters].[Measure to show (copy)_1623547714044821505] == &apos;Activity&apos; THEN SUM([orders])/SUM([customers])&#13;&#10;ELSEIF [Parameters].[Measure to show (copy)_1623547714044821505] == &apos;Frequency&apos; THEN SUM([orders])/SUM([cus_in_cohort])&#13;&#10;ELSEIF [Parameters].[Measure to show (copy)_1623547714044821505] == &apos;Orders&apos; THEN SUM([orders])&#13;&#10;ELSEIF [Parameters].[Measure to show (copy)_1623547714044821505] == &apos;Orders Per Customer&apos; THEN SUM([orders])/SUM([cus_in_cohort])&#13;&#10;ELSEIF [Parameters].[Measure to show (copy)_1623547714044821505] == &apos;Gmv Eur&apos; THEN SUM([gmv_eur])&#13;&#10;ELSEIF [Parameters].[Measure to show (copy)_1623547714044821505] ==&apos;Cumm Gmv&apos; AND MAX(DATE(DATEADD(&apos;month&apos;,[yr_mon_int_final],[brand_acq_yr_mon_int]))) &lt; DATETRUNC(&quot;month&quot;,TODAY()) THEN RUNNING_SUM(SUM([gmv_eur]))&#13;&#10;ELSEIF [Parameters].[Measure to show (copy)_1623547714044821505] ==&apos;Cumm Orders&apos; AND MAX(DATE(DATEADD(&apos;month&apos;,[yr_mon_int_final],[brand_acq_yr_mon_int]))) &lt; DATETRUNC(&quot;month&quot;,TODAY()) THEN RUNNING_SUM(SUM([orders]))&#13;&#10;ELSEIF [Parameters].[Measure to show (copy)_1623547714044821505] == &apos;Gmv Eur Per Customer&apos; THEN SUM([gmv_eur])/SUM([customers])&#13;&#10;ELSEIF [Parameters].[Measure to show (copy)_1623547714044821505] == &apos;Total Subsidies&apos; THEN SUM([total_subsidies])&#13;&#10;ELSEIF [Parameters].[Measure to show (copy)_1623547714044821505] == &apos;Total Subsidies Per Customer&apos; THEN SUM([total_subsidies])/SUM([customers])&#13;&#10;ELSEIF [Parameters].[Measure to show (copy)_1623547714044821505] ==&apos;Items Per Order&apos; THEN SUM([total_items])/SUM([orders])&#13;&#10;ELSEIF [Parameters].[Measure to show (copy)_1623547714044821505] ==&apos;Subsidies Per Order&apos; THEN SUM([total_subsidies])/SUM([orders])&#13;&#10;ELSEIF [Parameters].[Measure to show (copy)_1623547714044821505] ==&apos;Gmv Per Order&apos; THEN SUM([gmv_eur])/SUM([orders])&#13;&#10;ELSE Null&#13;&#10;END'>
