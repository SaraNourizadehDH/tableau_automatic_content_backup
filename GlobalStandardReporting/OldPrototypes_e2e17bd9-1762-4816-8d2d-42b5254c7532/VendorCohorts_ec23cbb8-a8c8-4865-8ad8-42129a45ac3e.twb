      <column caption='gfs_other_Brand' datatype='string' name='[Calculation_278941757758398464]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [is_gfs] THEN [brand] ELSE &apos;Non GFS&apos; END' />
      </column>
      <column caption='Measure_val_by_PM' datatype='real' name='[Calculation_278941757764145153]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] == &apos;Customers&apos; THEN SUM([customers])&#13;&#10;ELSEIF [Parameters].[Parameter 1] == &apos;Reorder Rate&apos; THEN SUM([customers])*100/SUM([cohort_customers])&#13;&#10;ELSEIF [Parameters].[Parameter 1] == &apos;Activity&apos; THEN SUM([orders])/SUM([customers])&#13;&#10;ELSEIF [Parameters].[Parameter 1] == &apos;Frequency&apos; THEN SUM([orders])/SUM([cohort_customers])&#13;&#10;ELSEIF [Parameters].[Parameter 1] == &apos;Orders&apos; THEN SUM([orders])&#13;&#10;ELSEIF [Parameters].[Parameter 1] == &apos;Orders Per Customer&apos; THEN SUM([orders])/SUM([customers])&#13;&#10;//ELSEIF [Measure_to_show] == &apos;Cumm Orders&apos; THEN SUM([cumm_order])&#13;&#10;ELSEIF [Parameters].[Parameter 1] == &apos;Gmv Eur&apos; THEN SUM([gmv_eur])&#13;&#10;//ELSEIF [Measure_to_show] == &apos;Cumm Gmv&apos; THEN SUM([cumm_gmv])&#13;&#10;ELSEIF [Parameters].[Parameter 1] == &apos;Gmv Eur Per Customer&apos; THEN SUM([gmv_eur])/SUM([customers])&#13;&#10;ELSEIF [Parameters].[Parameter 1] == &apos;Total Subsidies&apos; THEN SUM([total_subsidies])&#13;&#10;ELSEIF [Parameters].[Parameter 1] == &apos;Total Subsidies Per Customer&apos; THEN SUM([total_subsidies])/SUM([customers])&#13;&#10;ELSEIF [Parameters].[Parameter 1] ==&apos;Items Per Order&apos; THEN SUM([total_items])/SUM([orders])&#13;&#10;ELSEIF [Parameters].[Parameter 1] ==&apos;Subsidies Per Order&apos; THEN SUM([total_subsidies])/SUM([orders])&#13;&#10;ELSEIF [Parameters].[Parameter 1] ==&apos;Gmv Per Order&apos; THEN SUM([gmv_eur])/SUM([orders])&#13;&#10;ELSEIF [Parameters].[Parameter 1] ==&apos;Cumm Gmv&apos; AND MAX(DATE(DATEADD(&apos;month&apos;,[yr_mon_int_final],[ven_acq_yr_mon_int]))) &lt; DATETRUNC(&quot;month&quot;,TODAY()) THEN RUNNING_SUM(SUM([gmv_eur]))&#13;&#10;ELSEIF [Parameters].[Parameter 1] ==&apos;Cumm Ord&apos; AND MAX(DATE(DATEADD(&apos;month&apos;,[yr_mon_int_final],[ven_acq_yr_mon_int]))) &lt; DATETRUNC(&quot;month&quot;,TODAY()) THEN RUNNING_SUM(SUM([orders]))&#13;&#10;ELSE Null&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Prefix' datatype='string' name='[Calculation_278941757770686466]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ([Parameters].[Parameter 1] == &apos;Gmv Eur&apos; AND NOT ISNULL([Calculation_278941757764145153])) THEN &apos;€&apos;&#13;&#10;ELSEIF ([Parameters].[Parameter 1] == &apos;Cumm Gmv&apos; AND NOT ISNULL([Calculation_278941757764145153])) THEN &apos;€&apos;&#13;&#10;ELSEIF ([Parameters].[Parameter 1] == &apos;Gmv Eur Per Customer&apos; AND NOT ISNULL([Calculation_278941757764145153])) THEN &apos;€&apos;&#13;&#10;ELSEIF ([Parameters].[Parameter 1] == &apos;Total Subsidies&apos; AND NOT ISNULL([Calculation_278941757764145153])) THEN &apos;€&apos;&#13;&#10;ELSEIF ([Parameters].[Parameter 1] == &apos;Total Subsidies Per Customer&apos; AND NOT ISNULL([Calculation_278941757764145153])) THEN &apos;€&apos;&#13;&#10;ELSEIF ([Parameters].[Parameter 1] == &apos;Subsidies Per Order&apos; AND NOT ISNULL([Calculation_278941757764145153])) THEN &apos;€&apos;&#13;&#10;ELSEIF ([Parameters].[Parameter 1] == &apos;Gmv Per Order&apos; AND NOT ISNULL([Calculation_278941757764145153])) THEN &apos;€&apos;&#13;&#10;ELSEIF ([Parameters].[Parameter 1] == &apos;cumm_gmv&apos; AND NOT ISNULL([Calculation_278941757764145153]))THEN &apos;€&apos;&#13;&#10;&#13;&#10;ELSE Null&#13;&#10;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Suffix' datatype='string' name='[Calculation_278941757771046915]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ([Parameters].[Parameter 1] == &apos;Reorder Rate&apos; AND NOT ISNULL([Calculation_278941757764145153]))  THEN &apos;%&apos;&#13;&#10;ELSE Null&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Key_acc_or_gfs' datatype='boolean' name='[Calculation_278941757789368326]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[is_key_account] OR [is_gfs]' />
      </column>
      <column caption='Param_filter' datatype='string' name='[Calculation_3486349117684039680]' role='dimension' type='nominal'>
