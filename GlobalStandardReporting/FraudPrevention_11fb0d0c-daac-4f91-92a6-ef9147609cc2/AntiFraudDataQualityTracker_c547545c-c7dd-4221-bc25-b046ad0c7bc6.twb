      <column caption='Bin Coverage % Sc' datatype='real' name='[Bin Coverage % (copy)_1413567362831630337]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - (SUM( IIF([Payment Method Name Curated (group) (copy)_1413567362830983168] &#10;IN (&apos;Card&apos;, &apos;Mixed Payment - OP&apos;), [null_card_bin], 0) ) / &#10;SUM( IIF([Payment Method Name Curated (group) (copy)_1413567362830983168] &#10;IN (&apos;Card&apos;, &apos;Mixed Payment - OP&apos;), &#10;[total_scoring_attempts], 0) ))' />
