              </aliases>
            </column>
            <column alias='Weekly' caption='Timeframe_Deep_dive - sc selection' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
              <calculation class='tableau' formula='&quot;week&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;quarter&quot;' value='Quarterly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
            <column caption='Measure Selector' datatype='string' name='[Parameter Selector (copy)_5764748275832926228]' param-domain-type='list' role='measure' type='nominal' value='&quot;Card Hash Coverage\%&quot;'>
              <calculation class='tableau' formula='&quot;Card Hash Coverage%&quot;' />
            </column>
            <column alias='Monthly' caption='Timeframe_Deep_dive (copy)' datatype='string' name='[Timeframe_Deep_dive (copy)_700802358088556545]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;quarter&quot;' value='Quarterly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0abq5ou1to97kl17zt0et1tuo4bi'>
            <column datatype='string' name='[Payment Method Name Curated (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[payment_method_name_curated]' new-bin='true'>
                <bin default-name='true' value='&quot;Card&quot;'>
                  <value>&quot;Card&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Cash&quot;'>
                  <value>&quot;CashOnDelivery&quot;</value>
                </bin>
                <bin default-name='true' value='&quot;ExternalWallet&quot;'>
                  <value>&quot;ExternalWallet&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Mixed Payment - Cash + Wallet&quot;'>
                  <value>&quot;CashOnDelivery,Wallet&quot;</value>
                  <value>&quot;CashOnDelivery,Wallet,Wallet&quot;</value>
                  <value>&quot;CashOnDelivery,Wallet,Wallet,Wallet&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Mixed Payment - OP&quot;'>
                  <value>&quot;Card,ExternalWallet&quot;</value>
                  <value>&quot;Card,ExternalWallet,Wallet&quot;</value>
                  <value>&quot;Card,Wallet&quot;</value>
                  <value>&quot;Card,Wallet,Wallet&quot;</value>
                  <value>&quot;Card,Wallet,Wallet,Wallet&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Mixed Payment - Wallets&quot;'>
                  <value>&quot;ExternalWallet,Wallet&quot;</value>
                  <value>&quot;ExternalWallet,Wallet,Wallet&quot;</value>
                  <value>&quot;ExternalWallet,Wallet,Wallet,Wallet&quot;</value>
                </bin>
                <bin default-name='true' value='&quot;Null&quot;'>
                  <value>%null%</value>
                </bin>
              </calculation>
            </column>
            <column caption='File Date' datatype='date' name='[file_date]' role='dimension' type='ordinal' />
            <column-instance column='[file_date]' derivation='None' name='[none:file_date:qk]' pivot='key' type='quantitative' />
            <column caption='Payment Method Name Curated' datatype='string' name='[payment_method_name_curated]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0dhmmhy0df957q1bgbn4u0wmwbl5'>
            <column caption='Bin Coverage %' datatype='real' name='[Bin Coverage Country% (copy)_6104558946788798484]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - (SUM( IIF([Payment Method Name Curated (group)] &#10;IN (&apos;Card&apos;, &apos;Mixed Payment - OP&apos;), [null_bin], 0) ) / &#10;SUM( IIF([Payment Method Name Curated (group)] &#10;IN (&apos;Card&apos;, &apos;Mixed Payment - OP&apos;), &#10;[total_attempts], 0) ))' />
            </column>
            <column caption='Timeframe' datatype='string' name='[Calculation_3344274593027256323]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &apos;day&apos; THEN STR(DAY([file_date])) + &apos; &apos; + LEFT(DATENAME(&apos;month&apos;,[file_date]),3) +&apos; &apos;+ RIGHT(STR(YEAR([file_date])),2)&#10;WHEN &apos;week&apos; THEN LEFT(STR(DATETRUNC(&apos;week&apos;,date([file_date]),&apos;Monday&apos;)),10)&#10;WHEN &apos;month&apos; THEN LEFT(DATENAME(&apos;month&apos;,[file_date]),3) + &apos; &apos; + STR(YEAR([file_date]))&#10;WHEN &apos;quarter&apos; THEN &apos;Q&apos;+STR(DATEPART(&apos;quarter&apos;,[file_date])) + &apos; &apos; + STR(YEAR([file_date]))&#10;END' />
            </column>
            <column caption='Operation Status Coverage %' datatype='real' name='[Calculation_5764748275809652741]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-sum([missing_operation_status])/sum([total_attempts])' />
            </column>
            <column caption='Operation Type Coverage %' datatype='real' name='[Calculation_5764748275825721350]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-sum([missing_operation_type])/sum([total_attempts])' />
            </column>
            <column caption='Order Coverage %' datatype='real' name='[Calculation_5764748275829370888]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-sum([missing_orders])/sum([total_attempts])' />
            </column>
            <column caption='Card Country Coverage %' datatype='real' name='[Calculation_5764748275829551113]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - (SUM( IIF([Payment Method Name Curated (group)] &#10;IN (&apos;Card&apos;, &apos;Mixed Payment - OP&apos;), [null_country], 0) ) / &#10;SUM( IIF([Payment Method Name Curated (group)] &#10;IN (&apos;Card&apos;, &apos;Mixed Payment - OP&apos;), &#10;[total_attempts], 0) ))' />
            </column>
            <column caption='Card Hash Coverage %' datatype='real' name='[Calculation_5764748275829850122]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - (SUM( IIF([Payment Method Name Curated (group)] &#10;IN (&apos;Card&apos;, &apos;Mixed Payment - OP&apos;), [null_hash], 0) ) / &#10;SUM( IIF([Payment Method Name Curated (group)] &#10;IN (&apos;Card&apos;, &apos;Mixed Payment - OP&apos;), &#10;[total_attempts], 0) ))' />
            </column>
            <column caption='Card Last4 Coverage %' datatype='real' name='[Calculation_5764748275830001675]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - (SUM( IIF([Payment Method Name Curated (group)] &#10;IN (&apos;Card&apos;, &apos;Mixed Payment - OP&apos;), [null_last4], 0) ) / &#10;SUM( IIF([Payment Method Name Curated (group)] &#10;IN (&apos;Card&apos;, &apos;Mixed Payment - OP&apos;), &#10;[total_attempts], 0) ))' />
            </column>
            <column caption='Card Token Coverage %' datatype='real' name='[Calculation_5764748275830099980]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - (SUM( IIF([Payment Method Name Curated (group)] &#10;IN (&apos;Card&apos;, &apos;Mixed Payment - OP&apos;), [null_token], 0) ) / &#10;SUM( IIF([Payment Method Name Curated (group)] &#10;IN (&apos;Card&apos;, &apos;Mixed Payment - OP&apos;), &#10;[total_attempts], 0) ))' />
            </column>
            <column caption='Payment Method Coverage %' datatype='real' name='[Calculation_5764748275830181901]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-sum([missing_payment_method_name])/sum([total_attempts])' />
            </column>
            <column caption='Payment Status Coverage %' datatype='real' name='[Calculation_5764748275830284302]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-sum([missing_payment_status])/sum([total_attempts])' />
            </column>
            <column caption='Payment Type Coverage %' datatype='real' name='[Calculation_5764748275830366223]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-sum([missing_payment_type])/sum([total_attempts])' />
            </column>
            <column caption='Issuer Coverage%' datatype='real' name='[Calculation_5764748275830464528]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - (SUM( IIF([Payment Method Name Curated (group)] &#10;IN (&apos;Card&apos;, &apos;Mixed Payment - OP&apos;), [null_issuer], 0) ) / &#10;SUM( IIF([Payment Method Name Curated (group)] &#10;IN (&apos;Card&apos;, &apos;Mixed Payment - OP&apos;), &#10;[total_attempts], 0) ))' />
            </column>
            <column caption='Card Holder Name Coverage %' datatype='real' name='[Calculation_5764748275830587409]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - (SUM( IIF([Payment Method Name Curated (group)] &#10;IN (&apos;Card&apos;, &apos;Mixed Payment - OP&apos;), [null_fullname], 0) ) / &#10;SUM( IIF([Payment Method Name Curated (group)] &#10;IN (&apos;Card&apos;, &apos;Mixed Payment - OP&apos;), &#10;[total_attempts], 0) ))' />
            </column>
            <column caption='3DS Status Coverage %' datatype='real' name='[Calculation_5764748275830689810]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - (SUM( IIF([Payment Method Name Curated (group)] &#10;IN (&apos;Card&apos;, &apos;Mixed Payment - OP&apos;) AND [decision]=&apos;Review&apos;, [null_three_dstatus], 0) ) / &#10;SUM( IIF([Payment Method Name Curated (group)] &#10;IN (&apos;Card&apos;, &apos;Mixed Payment - OP&apos;) AND [decision]=&apos;Review&apos;, &#10;[total_attempts], 0) ))' />
            </column>
            <column caption='3DS Version Coverage %' datatype='real' name='[Calculation_5764748275830788115]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - (SUM( IIF([Payment Method Name Curated (group)] &#10;IN (&apos;Card&apos;, &apos;Mixed Payment - OP&apos;) AND [decision]=&apos;Review&apos;, [null_three_dsversion], 0) ) / &#10;SUM( IIF([Payment Method Name Curated (group)] &#10;IN (&apos;Card&apos;, &apos;Mixed Payment - OP&apos;) AND [decision]=&apos;Review&apos;, &#10;[total_attempts], 0) ))' />
            </column>
            <column caption='Measure Selected' datatype='real' name='[Calculation_5764748275833171989]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter Selector (copy)_5764748275832926228]&#10;when &quot;Bin Coverage%&quot; then [Bin Coverage Country% (copy)_6104558946788798484] &#10;when &quot;Card Hash Coverage%&quot; then [Calculation_5764748275829850122]&#10;when &quot;Card Token Coverage%&quot; then [Calculation_5764748275830099980]&#10;when &quot;3DS Status Coverage%&quot; then [Calculation_5764748275830689810]&#10;when &quot;3DS Version Coverage%&quot; then [Calculation_5764748275830788115]&#10;when &quot;Card Country Coverage%&quot; then [Calculation_5764748275829551113]&#10;when &quot;Card Holder Name Coverage%&quot; then [Calculation_5764748275830587409]&#10;when &quot;Card Last4 Coverage%&quot; then [Calculation_5764748275830001675]&#10;when &quot;Issuer Coverage%&quot; then [Calculation_5764748275830464528]&#10;when &quot;Operation Status Coverage%&quot; then [Calculation_5764748275809652741]&#10;when &quot;Operation Type Coverage%&quot; then [Calculation_5764748275825721350]&#10;when &quot;Order Coverage%&quot; then [Calculation_5764748275829370888]&#10;when &quot;Payment Method Coverage%&quot; then [Calculation_5764748275830181901]&#10;when &quot;Payment Type Coverage%&quot; then [Calculation_5764748275830366223]&#10;when &quot;Payment Status Coverage%&quot; then [Calculation_5764748275830284302]&#10;end' />
            </column>
            <column caption='Dimension Selected 1' datatype='string' name='[Calculation_6104558946790969365]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &quot;Global Entity Id&quot; then [global_entity_id] &#10;when &quot;Country&quot; then [Country]&#10;when &quot;Region&quot; then [region]&#10;when &quot;Decision&quot; then [decision]&#10;when &quot;Operation Type&quot; then [operation_type]&#10;when &quot;Operation Status&quot; then [operation_status]&#10;when &quot;Payment Method Name Curated (group)&quot; then [Payment Method Name Curated (group)]&#10;when &quot;Payment Gateway&quot; then [payment_method_name]&#10;when &quot;File Date&quot; then [Calculation_3344274593027256323]&#10;end' />
            </column>
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Dimension Selected 2' datatype='string' name='[Dimension Selected 1 (copy)_6104558951000043545]' role='dimension' type='nominal'>
