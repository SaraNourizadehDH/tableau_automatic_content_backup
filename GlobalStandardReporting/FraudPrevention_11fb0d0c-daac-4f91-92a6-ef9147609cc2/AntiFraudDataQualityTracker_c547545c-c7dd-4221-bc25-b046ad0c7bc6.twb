    <worksheet name='Payment Scores- Coverage Check - Global Entity View'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#202442'>Evolution of  </run>
            <run bold='true' fontcolor='#e03531'><![CDATA[<[Parameters].[Parameter Selector (copy)_5764748275832926228]>]]></run>
            <run bold='true' fontcolor='#202442'><![CDATA[, by <[Parameters].[Dimension 1 (copy)_1413567362876252194]> and <[Parameters].[Dimension 1 - Sc (copy)_1413567362876629028]>]]></run>
            <run>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='antifraud_data_quality_payment_score_groups (rl_fintech)' name='federated.0abq5ou1to97kl17zt0et1tuo4bi' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Dimension 1 - Sc' datatype='string' name='[Dimension 1 (copy)_1413567362876252194]' param-domain-type='list' role='measure' type='nominal' value='&quot;Region&quot;'>
              <calculation class='tableau' formula='&quot;Region&quot;' />
              <aliases>
                <alias key='&quot;Gateway&quot;' value='Payment Gateway' />
                <alias key='&quot;Payment Method Name Curated (group) - Score&quot;' value='Payment Method Name Curated (group) - Score' />
              </aliases>
            </column>
            <column caption='Dimension 2 - Sc' datatype='string' name='[Dimension 1 - Sc (copy)_1413567362876629028]' param-domain-type='list' role='measure' type='nominal' value='&quot;Global Entity Id&quot;'>
              <calculation class='tableau' formula='&quot;Global Entity Id&quot;' />
              <aliases>
                <alias key='&quot;Gateway&quot;' value='Payment Gateway' />
                <alias key='&quot;Payment Method Name Curated (group) - Score&quot;' value='Payment Method Name Curated (group) - Score' />
              </aliases>
            </column>
            <column caption='Measure Selector - Score' datatype='string' name='[Measure Selector (copy)_1016617280153743363]' param-domain-type='list' role='measure' type='nominal' value='&quot;Card Hash Coverage\%&quot;'>
              <calculation class='tableau' formula='&quot;Card Hash Coverage%&quot;' />
              <aliases>
                <alias key='&quot;Adjust Id Coverage\%&quot;' value='Adjust Id Coverage%' />
              </aliases>
            </column>
            <column alias='Weekly' caption='Timeframe_Deep_dive - sc selection' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
              <calculation class='tableau' formula='&quot;week&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;quarter&quot;' value='Quarterly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
            <column caption='Measure Selector' datatype='string' name='[Parameter Selector (copy)_5764748275832926228]' param-domain-type='list' role='measure' type='nominal' value='&quot;Card Hash Coverage\%&quot;'>
              <calculation class='tableau' formula='&quot;Card Hash Coverage%&quot;' />
            </column>
            <column alias='Weekly' caption='Timeframe_Deep_dive (copy) - Sc' datatype='string' name='[Timeframe_Deep_dive (copy) (copy)_700802358732005382]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
              <calculation class='tableau' formula='&quot;week&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;quarter&quot;' value='Quarterly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
            <column alias='Weekly' caption='Timeframe_Deep_dive - sc selection (copy)' datatype='string' name='[Timeframe_Deep_dive - BEST (copy)_700802358750089223]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
              <calculation class='tableau' formula='&quot;week&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;quarter&quot;' value='Quarterly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0abq5ou1to97kl17zt0et1tuo4bi'>
            <column caption='Bin Coverage % Sc' datatype='real' name='[Bin Coverage % (copy)_1413567362831630337]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - (SUM( IIF([Payment Method Name Curated (group) (copy)_1413567362830983168] &#10;IN (&apos;Card&apos;, &apos;Mixed Payment - OP&apos;), [null_card_bin], 0) ) / &#10;SUM( IIF([Payment Method Name Curated (group) (copy)_1413567362830983168] &#10;IN (&apos;Card&apos;, &apos;Mixed Payment - OP&apos;), &#10;[total_scoring_attempts], 0) ))' />
            </column>
            <column caption='3DS Status Coverage% - Sc' datatype='real' name='[Calculation_1413567362863669250]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - (SUM( IIF([Payment Method Name Curated (group) (copy)_1413567362830983168] &#10;IN (&apos;Card&apos;, &apos;Mixed Payment - OP&apos;) AND [decision]=&apos;Review&apos;, [null_card_3d_status], 0) ) / &#10;SUM( IIF([Payment Method Name Curated (group) (copy)_1413567362830983168] &#10;IN (&apos;Card&apos;, &apos;Mixed Payment - OP&apos;) AND [decision]=&apos;Review&apos;, &#10;[total_scoring_attempts], 0) ))' />
            </column>
            <column caption='3DS Version Coverage% - Sc' datatype='real' name='[Calculation_1413567362865733636]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - (SUM( IIF([Payment Method Name Curated (group) (copy)_1413567362830983168] &#10;IN (&apos;Card&apos;, &apos;Mixed Payment - OP&apos;) AND [decision]=&apos;Review&apos;, [null_card_3d_version], 0) ) / &#10;SUM( IIF([Payment Method Name Curated (group) (copy)_1413567362830983168] &#10;IN (&apos;Card&apos;, &apos;Mixed Payment - OP&apos;) AND [decision]=&apos;Review&apos;, &#10;[total_scoring_attempts], 0) ))' />
            </column>
            <column caption='Adjust Id Coverage% - Sc' datatype='real' name='[Calculation_1413567362866360325]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-sum([null_adjust_id])/sum([total_scoring_attempts])' />
            </column>
            <column caption='Card Last4 Coverage%-Sc' datatype='real' name='[Calculation_1413567362867630088]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - (SUM( IIF([Payment Method Name Curated (group) (copy)_1413567362830983168] &#10;IN (&apos;Card&apos;, &apos;Mixed Payment - OP&apos;), [null_card_last4], 0) ) / &#10;SUM( IIF([Payment Method Name Curated (group) (copy)_1413567362830983168] &#10;IN (&apos;Card&apos;, &apos;Mixed Payment - OP&apos;), &#10;[total_scoring_attempts], 0) ))' />
            </column>
            <column caption='Card Hash Coverage% - Sc' datatype='real' name='[Calculation_1413567362868334601]' role='measure' type='quantitative'>
