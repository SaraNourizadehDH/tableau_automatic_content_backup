      <column caption='Bin Coverage% (copy)' datatype='real' name='[Bin Coverage% (copy)_6104558951037542429]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1-sum([null_bin])/sum([total_attempts])' />
      </column>
      <column caption='Moving Avg' datatype='real' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG([Calculation_5764748275833171989], -7, -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Bin Coverage - scala' datatype='string' name='[Calculation_1367757305825853441]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Bin Coverage Country% (copy)_6104558946788798484]&gt;= 75 THEN &quot;1&quot;&#10;ELSEIF [Bin Coverage Country% (copy)_6104558946788798484]&gt;= 50 and [Bin Coverage Country% (copy)_6104558946788798484] &lt; 75 THEN &quot;2&quot;&#10;ELSEIF [Bin Coverage Country% (copy)_6104558946788798484]&gt;= 25 and [Bin Coverage Country% (copy)_6104558946788798484]&lt; 50 THEN &quot;3&quot;&#10;ELSEIF [Bin Coverage Country% (copy)_6104558946788798484]&gt;= 0 and [Bin Coverage Country% (copy)_6104558946788798484]&lt; 25 THEN &quot;4&quot;&#10;End' />
      </column>
      <column caption='TEST - CARD COVERAGE %' datatype='real' name='[Calculation_1367757305842769922]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Payment Method Name Curated (group)] = &apos;Card&apos; &#10;OR [Payment Method Name Curated (group)] = &apos;Mixed Payments - OP&apos; THEN&#10;    1 - (SUM(IIF(ISNULL([null_bin], 1, 0)) / COUNT([total_attempts]))&#10;END&#10;&#10;&#10;&#10;&#10;IF [Payment Method Name Curated (group)] = &apos;Card&apos; &#10;OR [Payment Method Name Curated (group)] = &apos;Mixed Payments - OP&apos; &#10;THEN&#10;    1 - SUM(IIF(ISNULL([null_bin]), 1, 0)) &#10;/ SUM(IIF([Payment Method Name Curated (group)] = &apos;Card&apos; &#10;OR [Payment Method Name Curated (group)] = &apos;Mixed Payments&apos;, 1, 0)) * 1.0&#10;END' />
      </column>
      <column caption='TEST - Bin Coverage%' datatype='real' name='[Calculation_1367757305844944899]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - (SUM( IIF([Payment Method Name Curated (group)] &#10;IN (&apos;Card&apos;, &apos;Mixed Payment - OP&apos;), [null_bin], 0) ) / &#10;SUM( IIF([Payment Method Name Curated (group)] &#10;IN (&apos;Card&apos;, &apos;Mixed Payment - OP&apos;), &#10;[total_attempts], 0) ))' />
      </column>
      <column caption='Timeframe' datatype='string' name='[Calculation_3344274593027256323]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &apos;day&apos; THEN STR(DAY([file_date])) + &apos; &apos; + LEFT(DATENAME(&apos;month&apos;,[file_date]),3) +&apos; &apos;+ RIGHT(STR(YEAR([file_date])),2)&#10;WHEN &apos;week&apos; THEN LEFT(STR(DATETRUNC(&apos;week&apos;,date([file_date]),&apos;Monday&apos;)),10)&#10;WHEN &apos;month&apos; THEN LEFT(DATENAME(&apos;month&apos;,[file_date]),3) + &apos; &apos; + STR(YEAR([file_date]))&#10;WHEN &apos;quarter&apos; THEN &apos;Q&apos;+STR(DATEPART(&apos;quarter&apos;,[file_date])) + &apos; &apos; + STR(YEAR([file_date]))&#10;END' />
      </column>
