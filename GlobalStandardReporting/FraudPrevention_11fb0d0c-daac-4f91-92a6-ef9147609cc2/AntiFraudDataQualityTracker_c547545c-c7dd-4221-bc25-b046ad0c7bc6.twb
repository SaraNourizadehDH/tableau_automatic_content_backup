            <column caption='Measure Selected - Score' datatype='real' name='[Measure Selected (copy)_1016617280131297280]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Measure Selector (copy)_1016617280153743363]&#10;when &quot;Bin Coverage%&quot; then [Bin Coverage % (copy)_1413567362831630337] &#10;when &quot;Card Hash Coverage%&quot; then [Calculation_1413567362868334601]&#10;when &quot;Card Token Coverage%&quot; then [Calculation_1413567362868760587]&#10;when &quot;3DS Status Coverage%&quot; then [Calculation_1413567362863669250]&#10;when &quot;3DS Version Coverage%&quot; then [Calculation_1413567362865733636]&#10;when &quot;Card Country Coverage%&quot; then [Card Fullname Coverage% - Sc (copy)_1413567362871848981]&#10;when &quot;Card Holder Name Coverage%&quot; then [Calculation_1413567362871091217]&#10;when &quot;Card Last4 Coverage%&quot; then [Calculation_1413567362867630088]&#10;when &quot;Issuer Coverage%&quot; then [Card Fullname Coverage% - Sc (copy)_1413567362872324118]&#10;when &quot;Payment Method Name Coverage%&quot; then [Calculation_1413567362870579216]&#10;when &quot;Adjust Id Coverage%&quot; THEN [Calculation_1413567362866360325]&#10;when &quot;Customer Email Coverage%&quot; then [Calculation_1413567362874703901]&#10;when &quot;Customer Phone Coverage%&quot; then [Calculation_1413567362875318302]&#10;end' />
            </column>
            <column caption='Payment Method Name Curated (group) - Score' datatype='string' name='[Payment Method Name Curated (group) (copy)_1413567362830983168]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[payment_method_name_curated]' new-bin='true'>
                <bin default-name='true' value='&quot;Card&quot;'>
                  <value>&quot;Card&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Cash&quot;'>
                  <value>&quot;CashOnDelivery&quot;</value>
                </bin>
                <bin default-name='true' value='&quot;ExternalWallet&quot;'>
                  <value>&quot;ExternalWallet&quot;</value>
