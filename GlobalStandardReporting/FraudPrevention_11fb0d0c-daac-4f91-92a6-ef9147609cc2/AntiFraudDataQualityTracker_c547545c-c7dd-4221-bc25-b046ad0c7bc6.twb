            </column>
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Dimension Selected 1 - Sc' datatype='string' name='[Dimension Selected 1 (copy)_1413567362876194849]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Dimension 1 (copy)_1413567362876252194]&#10;when &quot;Global Entity Id&quot; then [global_entity_id] &#10;when &quot;Country&quot; then [Country]&#10;when &quot;Region&quot; then [region]&#10;when &quot;Decision&quot; then [decision]&#10;when &quot;Payment Method Name Curated (group) - Score&quot; then [Payment Method Name Curated (group) (copy)_1413567362830983168]&#10;when &quot;Payment Gateway&quot; then [gateway]&#10;when &quot;File Date&quot; then [Calculation_3344274593027256323]&#10;when &quot;Type&quot; then [type]&#10;when &quot;Owner Type&quot; then [owner_type]&#10;when &quot;Delivery Type&quot; then [delivery_type]&#10;end' />
