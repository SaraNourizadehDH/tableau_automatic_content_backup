      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='complete_flow_dq_agg (tmp)' name='federated.0co6c0j1cl8wdw1bgay1w1xuy5v7' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Dimension Switcher 3' datatype='string' name='[Dimension Switcher 2 (copy)_3093058165598924822]' param-domain-type='list' role='measure' type='nominal' value='&quot;Payment Type&quot;'>
              <calculation class='tableau' formula='&quot;Payment Type&quot;' />
            </column>
            <column caption='Dimension Switcher 2' datatype='string' name='[Dimension Switcher 3 (copy)_1512576173268508675]' param-domain-type='list' role='measure' type='nominal' value='&quot;Global Entity Id&quot;'>
              <calculation class='tableau' formula='&quot;Global Entity Id&quot;' />
            </column>
            <column caption='Metric Selector' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Total attempts&quot;'>
              <calculation class='tableau' formula='&quot;Total attempts&quot;' />
            </column>
            <column alias='Week' caption='Date Granularity' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;w&quot;'>
              <calculation class='tableau' formula='&quot;w&quot;' />
              <aliases>
                <alias key='&quot;d&quot;' value='Daily' />
                <alias key='&quot;m&quot;' value='Month' />
                <alias key='&quot;q&quot;' value='Quarter' />
                <alias key='&quot;w&quot;' value='Week' />
              </aliases>
            </column>
            <column caption='Unit Selector' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Minutes&quot;'>
              <calculation class='tableau' formula='&quot;Minutes&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0co6c0j1cl8wdw1bgay1w1xuy5v7'>
            <column caption='10-Avg Time until Last Order Update' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[09-Avg Time until Last payment Update (copy)_1758233464801034242]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case&#10;[Parameters].[Parameter 4]&#10;WHEN &quot;Seconds&quot; then [Calculation_3093058165670227995]&#10;WHEN &quot;Minutes&quot; then [Calculation_3093058165672046621]&#10;END' />
            </column>
            <column caption='Attempt Date range' datatype='date' name='[Attempt Date (copy)_6136928573982511104]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[attempt_date]' />
            </column>
            <column caption='Timeframe' datatype='string' datatype-customized='true' name='[Calculation_1758233464719441920]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// In this calc, we want to return FORMATTED dates. So the calc return should be STRINGS&#10;// To get the date elements, there&apos;s basically two options:&#10;// DATEPART() returns the desired element as numbers. So those need to be converted to strings with STR()&#10;// DAY() and YEAR() are convenience functions that do the same thing as DATEPART()&#10;// DATENAME() already returns text strings.&#10;// The rest of it is basically concatenating everything to return a nicely formatted date string&#10;// Don&apos;t forget that you need to fix the SORT of the dates. By default, Tableau will order those dates alphabetically&#10;&#10;CASE [Parameters].[Parameter 3]&#10;WHEN &apos;d&apos; THEN STR(DAY([attempt_date])) + &apos; &apos; + LEFT(DATENAME(&apos;month&apos;,[attempt_date]),3) +&apos; &apos;+ RIGHT(STR(YEAR([attempt_date])),2)&#10;WHEN &apos;w&apos; THEN LEFT(STR(DATETRUNC(&apos;week&apos;,date([attempt_date]),&apos;Monday&apos;)),10)&#10;WHEN &apos;m&apos; THEN LEFT(DATENAME(&apos;month&apos;,[attempt_date]),3) + &apos; &apos; + STR(YEAR([attempt_date]))&#10;WHEN &apos;q&apos; THEN &apos;Q&apos;+STR(DATEPART(&apos;quarter&apos;,[attempt_date])) + &apos; &apos; + STR(YEAR([attempt_date]))&#10;END' />
            </column>
            <column caption='09-Avg Time until Last payment Update' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1758233464799969281]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case&#10;[Parameters].[Parameter 4]&#10;WHEN &quot;Seconds&quot; then [Calculation_3093058165669531673]&#10;WHEN &quot;Minutes&quot; then [Calculation_3093058165671915548]&#10;END' />
            </column>
            <column caption='cart_to_order_perc' datatype='real' name='[Calculation_3093058163497816071]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND((sum([daily_total_orders])/sum([daily_total_carts]))*100,2)' />
            </column>
            <column caption='Global total attempts' datatype='integer' name='[Calculation_3093058164971225101]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_total_attempts])' />
            </column>
            <column caption='Global total carts' datatype='integer' name='[Calculation_3093058164971323406]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_total_carts])' />
            </column>
            <column caption='Global total orders' datatype='integer' name='[Calculation_3093058164971405327]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_total_orders])' />
            </column>
            <column caption='Cart To order Ratio' datatype='real' name='[Calculation_3093058164973322256]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum([daily_total_carts])/sum([daily_total_orders])' />
            </column>
            <column caption='00 - Avg Payment Updates' datatype='real' name='[Calculation_3093058165594554388]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_sum_total_payment_updates])/sum([daily_total_carts])' />
            </column>
            <column caption='01- Avg Order Updates per order' datatype='real' name='[Calculation_3093058165594779669]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_sum_total_order_updates])/sum([daily_total_orders])' />
            </column>
            <column caption='Metric Selected' datatype='real' name='[Calculation_3093058165646356504]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;when &apos;Avg Qty Payment Updates&apos; then [Calculation_3093058165594554388]&#10;when &apos;Avg Qty Order Updates&apos; then [Calculation_3093058165594779669]&#10;WHEN &apos;Avg time until last payment update&apos; then [Calculation_1758233464799969281]&#10;WHEN &apos;Avg time until last order update&apos; then [09-Avg Time until Last payment Update (copy)_1758233464801034242]&#10;WHEN &apos;Cart to order ratio&apos; then [Calculation_3093058164973322256]&#10;WHEN &apos;Cart to order percentage&apos; then [Calculation_3093058163497816071]&#10;when &apos;Total attempts&apos; then [Calculation_3093058164971225101]&#10;when &apos;Total carts&apos; then [Calculation_3093058164971323406]&#10;when &apos;Total Orders&apos; then [Calculation_3093058164971405327]&#10; END' />
            </column>
            <column caption='02 - Avg Qty seconds last payment update' datatype='real' name='[Calculation_3093058165669531673]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_sum_seconds_to_last_payment_updates])/sum([daily_total_attempts])' />
            </column>
            <column caption='03- Avg Qty seconds last order update' datatype='real' name='[Calculation_3093058165670227995]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_sum_seconds_to_last_order_updates])/sum(daily_total_orders)' />
            </column>
            <column caption='04- Avg minutes last payment update' datatype='real' name='[Calculation_3093058165671915548]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_sum_minutes_to_last_payment_update])/sum([daily_total_attempts])' />
            </column>
            <column caption='05- Avg minutes last order update' datatype='real' name='[Calculation_3093058165672046621]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_sum_minutes_to_last_order_update])/sum([daily_total_orders])' />
            </column>
            <column caption='Dimension selected 3' datatype='string' name='[Dimension selected 2 (copy)_3093058165599019031]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Dimension Switcher 2 (copy)_3093058165598924822]&#10;WHEN &apos;Platform&apos; then [platform]&#10;when &apos;Global Entity Id&apos; then [global_entity_id]&#10;WHEN &apos;Payment Type&apos; then [Payment Type (group)]&#10;WHEN &apos;Transaction Type&apos; then [transaction_type]&#10;WHEN &apos;Payment Method Name&apos; then [payment_method_name]&#10;WHEN &apos;Last Payment Status&apos; then [last_payment_status]&#10;when &apos;Final Order Status&apos; then [final_order_status]&#10;when &apos;Unfiltered final status&apos; then [unfiltered_final_status]&#10;WHEN &apos;None&apos; then NULL&#10;END' />
            </column>
            <column caption='Dimension selected 2' datatype='string' name='[Dimension selected 3 (copy)_1512576173268844548]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Dimension Switcher 3 (copy)_1512576173268508675]&#10;WHEN &apos;Platform&apos; then [platform]&#10;when &apos;Global Entity Id&apos; then [global_entity_id]&#10;WHEN &apos;Payment Type&apos; then [Payment Type (group)]&#10;WHEN &apos;Transaction Type&apos; then [transaction_type]&#10;WHEN &apos;Payment Method Name&apos; then [payment_method_name]&#10;WHEN &apos;Last Payment Status&apos; then [last_payment_status]&#10;when &apos;Final Order Status&apos; then [final_order_status]&#10;when &apos;Unfiltered final status&apos; then [unfiltered_final_status]&#10;WHEN &apos;None&apos; then NULL&#10;END' />
            </column>
            <column datatype='string' name='[Payment Type (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[payment_type]' new-bin='true'>
                <bin default-name='true' value='&quot;Card&quot;'>
                  <value>&quot;Card&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Cash&quot;'>
                  <value>&quot;CashOnDelivery&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Mixed Payment - Cash + Wallet&quot;'>
                  <value>&quot;CashOnDelivery,Wallet&quot;</value>
                  <value>&quot;CashOnDelivery,Wallet,Wallet&quot;</value>
                  <value>&quot;CashOnDelivery,Wallet,Wallet,Wallet&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Mixed Payment - OP&quot;'>
                  <value>&quot;Card,ExternalWallet&quot;</value>
                  <value>&quot;Card,ExternalWallet,Wallet&quot;</value>
                  <value>&quot;Card,Wallet&quot;</value>
                  <value>&quot;Card,Wallet,Wallet&quot;</value>
                  <value>&quot;Card,Wallet,Wallet,Wallet&quot;</value>
                  <value>&quot;Wallet,Card&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Mixed Payments - Wallets&quot;'>
                  <value>&quot;ExternalWallet,Wallet&quot;</value>
                  <value>&quot;ExternalWallet,Wallet,Wallet&quot;</value>
                  <value>&quot;ExternalWallet,Wallet,Wallet,Wallet&quot;</value>
                  <value>&quot;Wallet,ExternalWallet&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Wallet&quot;'>
                  <value>&quot;Wallet&quot;</value>
                  <value>&quot;Wallet,Wallet&quot;</value>
                  <value>&quot;Wallet,Wallet,Wallet&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='Attempt Date' datatype='date' name='[attempt_date]' role='dimension' type='ordinal' />
            <column caption='Daily Sum Minutes To Last Order Update' datatype='real' name='[daily_sum_minutes_to_last_order_update]' role='measure' type='quantitative' />
