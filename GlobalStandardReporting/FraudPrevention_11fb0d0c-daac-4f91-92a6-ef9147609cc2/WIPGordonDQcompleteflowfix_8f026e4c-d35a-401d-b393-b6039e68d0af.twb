                <zone fixed-size='96' h='3715' id='30' name='Pay Updates per cart' pane-specification-id='1' param='[federated.0co6c0j1cl8wdw1bgay1w1xuy5v7].[none:platform:nk]' type-v2='color' w='12444' x='86963' y='40644'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
