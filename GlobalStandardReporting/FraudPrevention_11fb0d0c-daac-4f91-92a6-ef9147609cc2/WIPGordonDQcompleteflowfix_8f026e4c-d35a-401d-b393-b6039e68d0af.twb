              <calculation class='tableau' formula='case&#10;[Parameters].[Parameter 4]&#10;WHEN &quot;Seconds&quot; then [Calculation_3093058165669531673]&#10;WHEN &quot;Minutes&quot; then [Calculation_3093058165671915548]&#10;END' />
            </column>
            <column caption='cart_to_order_perc' datatype='real' name='[Calculation_3093058163497816071]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND((sum([daily_total_orders])/sum([daily_total_carts]))*100,2)' />
