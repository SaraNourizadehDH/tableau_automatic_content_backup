                <zone h='1572' id='15' leg-item-layout='horz' name='Attempts by platform/transaction type' pane-specification-id='0' param='[federated.0co6c0j1cl8wdw1bgay1w1xuy5v7].[none:transaction_type:nk]' type-v2='color' w='49333' x='667' y='15572'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
