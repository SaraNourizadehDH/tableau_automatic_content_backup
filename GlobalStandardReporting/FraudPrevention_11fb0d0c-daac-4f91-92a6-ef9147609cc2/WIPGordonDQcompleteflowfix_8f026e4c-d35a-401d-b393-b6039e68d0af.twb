    <worksheet name='Total Attempts, Carts and Orders'>
      <layout-options>
        <title>
          <formatted-text>
            <run>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='complete_flow_dq_agg (tmp)' name='federated.0co6c0j1cl8wdw1bgay1w1xuy5v7' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Week' caption='Date Granularity' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;w&quot;'>
              <calculation class='tableau' formula='&quot;w&quot;' />
              <aliases>
                <alias key='&quot;d&quot;' value='Daily' />
                <alias key='&quot;m&quot;' value='Month' />
                <alias key='&quot;q&quot;' value='Quarter' />
                <alias key='&quot;w&quot;' value='Week' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0co6c0j1cl8wdw1bgay1w1xuy5v7'>
            <column caption='Attempt Date range' datatype='date' name='[Attempt Date (copy)_6136928573982511104]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[attempt_date]' />
            </column>
            <column caption='Timeframe' datatype='string' datatype-customized='true' name='[Calculation_1758233464719441920]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// In this calc, we want to return FORMATTED dates. So the calc return should be STRINGS&#10;// To get the date elements, there&apos;s basically two options:&#10;// DATEPART() returns the desired element as numbers. So those need to be converted to strings with STR()&#10;// DAY() and YEAR() are convenience functions that do the same thing as DATEPART()&#10;// DATENAME() already returns text strings.&#10;// The rest of it is basically concatenating everything to return a nicely formatted date string&#10;// Don&apos;t forget that you need to fix the SORT of the dates. By default, Tableau will order those dates alphabetically&#10;&#10;CASE [Parameters].[Parameter 3]&#10;WHEN &apos;d&apos; THEN STR(DAY([attempt_date])) + &apos; &apos; + LEFT(DATENAME(&apos;month&apos;,[attempt_date]),3) +&apos; &apos;+ RIGHT(STR(YEAR([attempt_date])),2)&#10;WHEN &apos;w&apos; THEN LEFT(STR(DATETRUNC(&apos;week&apos;,date([attempt_date]),&apos;Monday&apos;)),10)&#10;WHEN &apos;m&apos; THEN LEFT(DATENAME(&apos;month&apos;,[attempt_date]),3) + &apos; &apos; + STR(YEAR([attempt_date]))&#10;WHEN &apos;q&apos; THEN &apos;Q&apos;+STR(DATEPART(&apos;quarter&apos;,[attempt_date])) + &apos; &apos; + STR(YEAR([attempt_date]))&#10;END' />
            </column>
            <column caption='Daily attempt to carts Ratio' datatype='real' name='[Calculation_3093058163473014784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3093058164971225101]/[Calculation_3093058164971323406]' />
            </column>
            <column caption='Global total attempts' datatype='integer' name='[Calculation_3093058164971225101]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_total_attempts])' />
            </column>
            <column caption='Global total carts' datatype='integer' name='[Calculation_3093058164971323406]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_total_carts])' />
            </column>
            <column caption='Attempt Date' datatype='date' name='[attempt_date]' role='dimension' type='ordinal' />
            <column caption='Daily attempts to order Ratio' datatype='real' name='[attempts_per_cart (copy)_3093058163473227777]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([daily_total_attempts])/sum([daily_total_orders])' />
            </column>
            <column caption='Total Attempts' datatype='integer' name='[daily_total_attempts]' role='measure' type='quantitative' />
            <column caption='Total Carts' datatype='integer' name='[daily_total_carts]' role='measure' type='quantitative' />
            <column caption='Total Orders' datatype='integer' name='[daily_total_orders]' role='measure' type='quantitative' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column-instance column='[Attempt Date (copy)_6136928573982511104]' derivation='None' name='[none:Attempt Date (copy)_6136928573982511104:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1758233464719441920]' derivation='None' name='[none:Calculation_1758233464719441920:nk]' pivot='key' type='nominal' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[platform]' derivation='None' name='[none:platform:nk]' pivot='key' type='nominal' />
            <column-instance column='[transaction_type]' derivation='None' name='[none:transaction_type:nk]' pivot='key' type='nominal' />
            <column caption='Platform' datatype='string' name='[platform]' role='dimension' type='nominal' />
            <column-instance column='[daily_total_attempts]' derivation='Sum' name='[sum:daily_total_attempts:qk]' pivot='key' type='quantitative' />
            <column-instance column='[daily_total_carts]' derivation='Sum' name='[sum:daily_total_carts:qk]' pivot='key' type='quantitative' />
            <column-instance column='[daily_total_orders]' derivation='Sum' name='[sum:daily_total_orders:qk]' pivot='key' type='quantitative' />
            <column caption='Transaction Type' datatype='string' name='[transaction_type]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;donation&quot;' value='Donation' />
                <alias key='&quot;purchase&quot;' value='Purchase' />
                <alias key='&quot;subscription&quot;' value='Subscription' />
                <alias key='&quot;topup&quot;' value='Topup' />
              </aliases>
            </column>
            <column-instance column='[Calculation_3093058163473014784]' derivation='User' name='[usr:Calculation_3093058163473014784:qk]' pivot='key' type='quantitative' />
            <column-instance column='[attempts_per_cart (copy)_3093058163473227777]' derivation='User' name='[usr:attempts_per_cart (copy)_3093058163473227777:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0co6c0j1cl8wdw1bgay1w1xuy5v7].[:Measure Names]'>
            <groupfilter function='union' user:op='manual'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0co6c0j1cl8wdw1bgay1w1xuy5v7].[sum:daily_total_attempts:qk]&quot;' />
