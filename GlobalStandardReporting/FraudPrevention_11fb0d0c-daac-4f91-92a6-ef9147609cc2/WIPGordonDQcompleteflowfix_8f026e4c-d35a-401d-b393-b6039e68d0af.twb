            <column caption='Cart To order Ratio' datatype='real' name='[Calculation_3093058164973322256]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum([daily_total_carts])/sum([daily_total_orders])' />
            </column>
            <column caption='00 - Avg Payment Updates' datatype='real' name='[Calculation_3093058165594554388]' role='measure' type='quantitative'>
