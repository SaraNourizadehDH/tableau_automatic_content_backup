      <column caption='Timeframe' datatype='string' datatype-customized='true' name='[Calculation_1758233464719441920]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// In this calc, we want to return FORMATTED dates. So the calc return should be STRINGS&#10;// To get the date elements, there&apos;s basically two options:&#10;// DATEPART() returns the desired element as numbers. So those need to be converted to strings with STR()&#10;// DAY() and YEAR() are convenience functions that do the same thing as DATEPART()&#10;// DATENAME() already returns text strings.&#10;// The rest of it is basically concatenating everything to return a nicely formatted date string&#10;// Don&apos;t forget that you need to fix the SORT of the dates. By default, Tableau will order those dates alphabetically&#10;&#10;CASE [Parameters].[Parameter 3]&#10;WHEN &apos;d&apos; THEN STR(DAY([attempt_date])) + &apos; &apos; + LEFT(DATENAME(&apos;month&apos;,[attempt_date]),3) +&apos; &apos;+ RIGHT(STR(YEAR([attempt_date])),2)&#10;WHEN &apos;w&apos; THEN LEFT(STR(DATETRUNC(&apos;week&apos;,date([attempt_date]),&apos;Monday&apos;)),10)&#10;WHEN &apos;m&apos; THEN LEFT(DATENAME(&apos;month&apos;,[attempt_date]),3) + &apos; &apos; + STR(YEAR([attempt_date]))&#10;WHEN &apos;q&apos; THEN &apos;Q&apos;+STR(DATEPART(&apos;quarter&apos;,[attempt_date])) + &apos; &apos; + STR(YEAR([attempt_date]))&#10;END' />
      </column>
      <column caption='09-Avg Time until Last payment Update' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1758233464799969281]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case&#10;[Parameters].[Parameter 4]&#10;WHEN &quot;Seconds&quot; then [Calculation_3093058165669531673]&#10;WHEN &quot;Minutes&quot; then [Calculation_3093058165671915548]&#10;END' />
      </column>
      <column caption='06- Total attempts current week' datatype='integer' name='[Calculation_219972711769894912]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF&#10;&#10;DATEDIFF(&apos;week&apos;,[attempt_date],TODAY()-1)=0&#10;&#10;THEN&#10;&#10;[daily_total_attempts]&#10;&#10;END' />
      </column>
      <column caption='07 - Total attempts previous week' datatype='integer' name='[Calculation_219972711770124289]' role='measure' type='quantitative'>
