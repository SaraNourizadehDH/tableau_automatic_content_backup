      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='4000' minheight='4000' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='122' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='99428' id='121' param='vert' type-v2='layout-flow' w='98814' x='593' y='286'>
                <zone fixed-size='890' forceUpdate='true' h='3571' id='9' type-v2='text' w='66519' x='593' y='286'>
                  <formatted-text>
                    <run fontname='Tableau Bold' fontsize='20'>Gordon DQ Complete Flow Dashboard</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontsize='12'>Update Schedule:</run>
                    <run fontsize='12'> Daily</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontsize='12'>Point of contact:</run>
                    <run fontsize='12'>Æ </run>
                    <run bold='true' fontcolor='#0052cc' fontname='-apple-system' fontsize='10' underline='true'>fintech_risk_analytics@deliveryhero.com</run>
                    <run>Æ&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='92' h='3571' id='26' is-centered='0' is-fixed='true' is-scaled='1' param='Image/DH_Fintech_Full_RGB.png' type-v2='bitmap' w='32295' x='67112' y='286'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone h='2500' id='31' mode='compact' param='[Parameters].[Parameter 3]' type-v2='paramctrl' w='49407' x='50000' y='3857'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='72' forceUpdate='true' h='2857' id='8' type-v2='text' w='98666' x='667' y='6393'>
                  <formatted-text>
                    <run fontcolor='#000000' fontname='Benton Sans Book'>In our Anti-Fraud system, we evaluate the payment intents associated with placing a transaction for acquiring a product, referred to as </run>
                    <run bold='true' fontcolor='#337ea9' fontname='Benton Sans Book'>attempts or scoring attempts</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book'>. A user may make several </run>
                    <run bold='true' fontcolor='#4e79a7' fontname='Benton Sans Book'>attempts</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book'> to finalize a transaction. If these </run>
                    <run bold='true' fontcolor='#4e79a7' fontname='Benton Sans Book'>attempts</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book'> are connected to the same intention, we classify them as part of the same </run>
                    <run bold='true' fontcolor='#d44c47' fontname='Benton Sans Book'>cart</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book'>. Following one try or multiple retries, the user may successfully complete the purchase, transforming the </run>
                    <run bold='true' fontcolor='#e15759' fontname='Benton Sans Book'>cart</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book'> into an </run>
                    <run bold='true' fontcolor='#cb912f' fontname='Benton Sans Book'>order</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book'>. </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book'>Note: Non-purchase events such as topups, subscriptions or donations do not have an associated </run>
                    <run bold='true' fontcolor='#d3b348' fontname='Benton Sans Book'>order</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book'> or </run>
                    <run bold='true' fontcolor='#e15759' fontname='Benton Sans Book'>cart</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book'>, just </run>
                    <run bold='true' fontcolor='#4e79a7' fontname='Benton Sans Book'>scoring attempts</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book'>.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='169' h='6322' id='11' is-fixed='true' name='Attempts by platform/transaction type' w='49333' x='667' y='9250'>
                  <layout-cache fixed-size-h='169' minwidth='200' type-h='fixed' type-w='scalable' />
                  <zone-style>
