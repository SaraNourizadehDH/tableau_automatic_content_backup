          <datasource-dependencies datasource='Parameters'>
            <column caption='Match Option' datatype='string' name='[View by - 1-1 (copy)_71635426368614402]' param-domain-type='list' role='measure' type='nominal' value='&quot;Match Rate&quot;'>
              <calculation class='tableau' formula='&quot;Match Rate&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0dvnm4a14lg3of0zufj090f1rv2n'>
            <column caption='Match Rate' datatype='real' default-format='p0%' name='[Calculation_340232921483968513]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(&#10;SUM(&#10;    IIF([value_comparison] = &apos;dl = tt&apos;, [record_count], 0)&#10;)&#10;/&#10;SUM([record_count])&#10;,0)' />
            </column>
            <column caption='Match if TT &gt; 0' datatype='real' default-format='p0%' name='[Calculation_340232921484066818 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(&#10;SUM(&#10;    IIF([value_comparison] = &apos;dl = tt&apos; AND [tt_greater_than_zero] = TRUE, [record_count], 0)&#10;)&#10;/&#10;SUM([record_count])&#10;,0)' />
            </column>
            <column caption='Param.Match' datatype='real' default-format='p0%' name='[Calculation_71635426378002439]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[View by - 1-1 (copy)_71635426368614402]&#10;        WHEN &apos;Match Rate&apos;        THEN [Calculation_340232921483968513]&#10;        WHEN &apos;Match if DL &gt; 0&apos;   THEN [TT &gt; 0 Match Rate (copy)_340232921484337156 1]&#10;        WHEN &apos;Match if TT &gt; 0&apos;   THEN [Calculation_340232921484066818 1]&#10;        WHEN &apos;DL &gt; TT&apos;           THEN [Match Rate (copy)_2001920447651794947]&#10;        WHEN &apos;DL &lt; TT&apos;           THEN [dl_greater_rate (copy)_2001920447651995652]&#10;        WHEN &apos;Both Zero&apos;         THEN [Match Rate (copy)_2001920447646470146]&#10;        WHEN &apos;DL &lt; 0&apos;            THEN [both_zero_rate (copy)_2001920447653576709]&#10;    END' />
            </column>
            <column caption='Both Zero' datatype='real' default-format='p0%' name='[Match Rate (copy)_2001920447646470146]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(&#10;SUM(&#10;    IIF([zero_comparison] = &apos;both_zero&apos;, [record_count], 0)&#10;)&#10;/&#10;SUM([record_count])&#10;,0)' />
            </column>
            <column caption='DL &gt; TT' datatype='real' default-format='p0%' name='[Match Rate (copy)_2001920447651794947]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(&#10;SUM(&#10;    IIF([value_comparison] = &apos;dl &gt; tt&apos;, [record_count], 0)&#10;)&#10;/&#10;SUM([record_count])&#10;,0)' />
