    <worksheet name='Metrics List'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='8'>Æ </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Semibold'>Metrics Match Summary</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='dl_vs_tt_metric_value_comparison' name='federated.13jhioi1emln9s1h16tz20riuujm' />
          </datasources>
          <datasource-dependencies datasource='federated.13jhioi1emln9s1h16tz20riuujm'>
            <column caption='Match if TT &gt; 0' datatype='real' default-format='p0%' name='[Calculation_340232921484066818]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(&#10;SUM(&#10;    IIF([value_comparison] = &apos;dl = tt&apos; AND [tt_greater_than_zero] = TRUE, [record_count], 0)&#10;)&#10;/&#10;SUM(&#10;    IIF([tt_greater_than_zero] = TRUE, [record_count], 0)&#10;)&#10;,0)' />
            </column>
            <column caption='From' datatype='date' default-format='*DD.MM.YYYY' name='[Calculation_5989506081717202945]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='min([order_date])' />
            </column>
            <column caption='Is Flink?' datatype='boolean' name='[Calculation_71635426483597321]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF(&#10;    [platform] = &apos;Glovo&apos;&#10;    AND (&#10;        REGEXP_MATCH([metric_name], &quot;.*[0-9]+h.*&quot;)&#10;        OR REGEXP_MATCH([metric_name], &quot;.*1d.*&quot;)&#10;    ),&#10;    TRUE,&#10;    FALSE&#10;)' />
            </column>
            <column caption='DL Null' datatype='real' default-format='p0%' name='[DL Zero (copy)_71635426707496973]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(&#10;SUM(&#10;    IIF([null_comparison] = &apos;dl_null&apos;, [record_count], 0)&#10;)&#10;/&#10;SUM([record_count])&#10;,0)' />
            </column>
            <column caption='To' datatype='date' default-format='*DD.MM.YYYY' name='[From (copy)_5989506081717452802]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='max([order_date])' />
            </column>
            <column caption='Match Rate' datatype='real' default-format='p0%' name='[Match Rate (DL &gt; 0) (copy)_2001920447646257153]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(&#10;SUM(&#10;    IIF([value_comparison] = &apos;dl = tt&apos;, [record_count], 0)&#10;)&#10;/&#10;SUM([record_count])&#10;,0)' />
            </column>
            <column caption='Both Zero' datatype='real' default-format='p0%' name='[Match Rate (copy)_2001920447646470146]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(&#10;SUM(&#10;    IIF([zero_comparison] = &apos;both_zero&apos;, [record_count], 0)&#10;)&#10;/&#10;SUM([record_count])&#10;,0)' />
            </column>
            <column caption='DL &gt; TT' datatype='real' default-format='p0%' name='[Match Rate (copy)_2001920447651794947]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(&#10;SUM(&#10;    IIF([value_comparison] = &apos;dl &gt; tt&apos;, [record_count], 0)&#10;)&#10;/&#10;SUM([record_count])&#10;,0)' />
            </column>
            <column caption='Match if DL &gt; 0' datatype='real' default-format='p0%' name='[TT &gt; 0 Match Rate (copy)_340232921484337156]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(&#10;SUM(&#10;    IIF([value_comparison] = &apos;dl = tt&apos; AND [dl_greater_than_zero] = TRUE, [record_count], 0)&#10;)&#10;/&#10;SUM(&#10;    IIF([dl_greater_than_zero] = TRUE, [record_count], 0)&#10;)&#10;,0)' />
            </column>
            <column-instance column='[avg_value_diff]' derivation='Avg' name='[avg:avg_value_diff:qk]' pivot='key' type='quantitative' />
            <column-instance column='[avg_value_diff_pct_change]' derivation='Avg' name='[avg:avg_value_diff_pct_change:qk]' pivot='key' type='quantitative' />
            <column caption='Avg Value Diff' datatype='real' name='[avg_value_diff]' role='measure' type='quantitative' />
            <column caption='Avg Value Diff Δ%' datatype='real' default-format='p0%' name='[avg_value_diff_pct_change]' role='measure' type='quantitative' />
            <column caption='DL &lt; 0' datatype='real' default-format='p0%' name='[both_zero_rate (copy)_2001920447653576709]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(&#10;SUM(&#10;    IIF([negative_comparison] = &apos;dl_negative&apos;, [record_count], 0)&#10;)&#10;/&#10;SUM([record_count])&#10;,0)' />
