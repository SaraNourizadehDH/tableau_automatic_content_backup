            <column caption='DL &lt; 0' datatype='real' default-format='p0%' name='[both_zero_rate (copy)_2001920447653576709]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(&#10;SUM(&#10;    IIF([negative_comparison] = &apos;dl_negative&apos;, [record_count], 0)&#10;)&#10;/&#10;SUM([record_count])&#10;,0)' />
            </column>
            <column caption='DL &lt; TT' datatype='real' default-format='p0%' name='[dl_greater_rate (copy)_2001920447651995652]' role='measure' type='quantitative'>
