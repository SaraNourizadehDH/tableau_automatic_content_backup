      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_1B9585121BD24744875A28674C994D14'>
            <properties context=''>
              <relation connection='bigquery.0tde0of0wd52ka1bpoha904l8t0t' name='Custom SQL Query' type='text'><![CDATA[with dl as (select order_date,
                   global_entity_id,
                   attempt_id,
                   numeric_value as dl_value
            from fulfillment-dwh-production.rl_fintech.antifraud_metrics_long_sample
            where order_date >>= <[Parameters].[Parameter 6]>
              and order_date <<= <[Parameters].[Parameter 7]>
              and platform = <[Parameters].[Parameter 8]>
              and (global_entity_id = <[Parameters].[Parameter 3]>
                     or <[Parameters].[Parameter 3]> = 'All')
              and metric_name = <[Parameters].[Parameter 4]>),

     tt as (select sent_at_date as order_date,
                   global_entity_id,
                   attempt_id,
                   metric_value as tt_value
            from fulfillment-dwh-production.rl_fintech.time_travel_calculated_metrics_long_sample
            where sent_at_date >>= <[Parameters].[Parameter 6]>
              and sent_at_date <<= <[Parameters].[Parameter 7]>
              and platform = <[Parameters].[Parameter 8]>
              and (global_entity_id = <[Parameters].[Parameter 3]>
                     or <[Parameters].[Parameter 3]> = 'All')
              and metric_name = <[Parameters].[Parameter 5]>),

     comparison as (select order_date,
                           case
                               when dl_value = tt_value then 'dl = tt'
                               when dl_value >> tt_value then 'dl >> tt'
                               when dl_value << tt_value then 'dl << tt' end                       as value_comparison,
                           case
                               when dl_value is null and tt_value is null then 'both_null'
                               when dl_value is null and tt_value is not null then 'dl_null'
                               when tt_value is null and dl_value is not null then 'tt_null' end as null_comparison,
                           case
                               when dl_value = 0 and tt_value = 0 then 'both_zero'
                               when dl_value = 0 and tt_value != 0 then 'dl_zero'
                               when tt_value = 0 and dl_value != 0 then 'tt_zero' end            as zero_comparison,
                           case
                               when dl_value << 0 and tt_value << 0 then 'both_negative'
                               when dl_value << 0 and tt_value >>= 0 then 'dl_negative'
                               when tt_value << 0 and dl_value >>= 0 then 'tt_negative' end        as negative_comparison,
                           tt_value >> 0                                                          as tt_greater_than_zero,
                           dl_value >> 0                                                          as dl_greater_than_zero,
                           count(1)                                                              as record_count,
                           round(avg(case
                                when dl_value is not null and tt_value is not null
                                    and dl_value <<>> tt_value
                                then abs(dl_value - tt_value) end), 2)                           as avg_value_diff,
                           round(SAFE_DIVIDE(avg(abs(dl_value - tt_value)), avg(tt_value)), 2)   as avg_value_diff_pct_change
                    from tt
                             inner join dl using (attempt_id, order_date, global_entity_id)
                    group by all),

     dl_stats as (select order_date,
                         min(dl_value)                               as min_value,
                         max(dl_value)                               as max_value,
                         avg(dl_value)                               as avg_value,
                         STDDEV_SAMP(dl_value)                       as std_value,
                         approx_quantiles(dl_value, 100)[offset(1)]  as p1,
                         approx_quantiles(dl_value, 100)[offset(5)]  as p5,
                         approx_quantiles(dl_value, 100)[offset(10)] as p10,
                         approx_quantiles(dl_value, 100)[offset(25)] as p25,
                         approx_quantiles(dl_value, 100)[offset(50)] as p50,
                         approx_quantiles(dl_value, 100)[offset(75)] as p75,
                         approx_quantiles(dl_value, 100)[offset(90)] as p90,
                         approx_quantiles(dl_value, 100)[offset(95)] as p95,
                         approx_quantiles(dl_value, 100)[offset(99)] as p99,
                         approx_quantiles(dl_value, 100)[offset(80)] -
                         approx_quantiles(dl_value, 100)[offset(20)] as spread,
                         approx_quantiles(dl_value, 100)[offset(75)] -
                         approx_quantiles(dl_value, 100)[offset(25)] as iqr,
                         count(1)                                    as row_count
                  from dl
                  group by 1),

     tt_stats as (select order_date,
                         min(tt_value)                               as min_value,
                         max(tt_value)                               as max_value,
                         avg(tt_value)                               as avg_value,
                         STDDEV_SAMP(tt_value)                       as std_value,
                         approx_quantiles(tt_value, 100)[offset(1)]  as p1,
                         approx_quantiles(tt_value, 100)[offset(5)]  as p5,
                         approx_quantiles(tt_value, 100)[offset(10)] as p10,
                         approx_quantiles(tt_value, 100)[offset(25)] as p25,
                         approx_quantiles(tt_value, 100)[offset(50)] as p50,
                         approx_quantiles(tt_value, 100)[offset(75)] as p75,
                         approx_quantiles(tt_value, 100)[offset(90)] as p90,
                         approx_quantiles(tt_value, 100)[offset(95)] as p95,
                         approx_quantiles(tt_value, 100)[offset(99)] as p99,
                         approx_quantiles(tt_value, 100)[offset(80)] -
                         approx_quantiles(tt_value, 100)[offset(20)] as spread,
                         approx_quantiles(tt_value, 100)[offset(75)] -
                         approx_quantiles(tt_value, 100)[offset(25)] as iqr,
                         count(1)                                    as row_count
                  from tt
                  group by 1),

     dl_unpivot as (select order_date,
                           s.stat,
                           s.val as dl_value
                    from dl_stats,
                         unnest([
                             struct ('min' as stat, cast(min_value as float64) as val),
                             struct ('max', cast(max_value as float64)),
                             struct ('avg', cast(avg_value as float64)),
                             struct ('std', cast(std_value as float64)),
                             struct ('p1', cast(p1 as float64)),
                             struct ('p5', cast(p5 as float64)),
                             struct ('p10', cast(p10 as float64)),
                             struct ('p25', cast(p25 as float64)),
                             struct ('p50', cast(p50 as float64)),
                             struct ('p75', cast(p75 as float64)),
                             struct ('p90', cast(p90 as float64)),
                             struct ('p95', cast(p95 as float64)),
                             struct ('p99', cast(p99 as float64)),
                             struct ('spread', cast(spread as float64)),
                             struct ('iqr', cast(iqr as float64)),
                             struct ('row_count', cast(row_count as float64))
                             ]) s),

     tt_unpivot as (select order_date,
                           s.stat,
                           s.val as tt_value
                    from tt_stats,
                         unnest([
                             struct ('min' as stat, cast(min_value as float64) as val),
                             struct ('max', cast(max_value as float64)),
                             struct ('avg', cast(avg_value as float64)),
                             struct ('std', cast(std_value as float64)),
                             struct ('p1', cast(p1 as float64)),
                             struct ('p5', cast(p5 as float64)),
                             struct ('p10', cast(p10 as float64)),
                             struct ('p25', cast(p25 as float64)),
                             struct ('p50', cast(p50 as float64)),
                             struct ('p75', cast(p75 as float64)),
                             struct ('p90', cast(p90 as float64)),
                             struct ('p95', cast(p95 as float64)),
                             struct ('p99', cast(p99 as float64)),
                             struct ('spread', cast(spread as float64)),
                             struct ('iqr', cast(iqr as float64)),
                             struct ('row_count', cast(row_count as float64))
                             ]) s),

     stat_rows as (select t.order_date,
                          t.stat,
                          t.tt_value,
                          d.dl_value
                   from tt_unpivot t
                            inner join dl_unpivot d
                                       using (order_date, stat))

select 'comparison'          as section,
       order_date,
       cast(null as string)  as stat,
       cast(null as float64) as dl_value,
       cast(null as float64) as tt_value,
       value_comparison,
       null_comparison,
       zero_comparison,
       negative_comparison,
       tt_greater_than_zero,
       dl_greater_than_zero,
       record_count,
       avg_value_diff,
       avg_value_diff_pct_change
from comparison

union all

select 'stats' as section,
       order_date,
       stat,
       dl_value,
       tt_value,
       cast(null as string),
       cast(null as string),
       cast(null as string),
       cast(null as string),
       cast(null as bool),
       cast(null as bool),
       cast(null as int64),
       cast(null as float64),
       cast(null as float64)
from stat_rows]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
