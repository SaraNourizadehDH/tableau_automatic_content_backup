        <objects>
          <object caption='Custom SQL Query' id='_622291FA062B4150A2939323097EA4D2'>
            <properties context=''>
              <relation join='left' type='join'>
                <clause type='join'>
                  <expression op='AND'>
                    <expression op='='>
                      <expression op='[Base].[order_date]' />
                      <expression op='[Models].[date]' />
                    </expression>
                    <expression op='='>
                      <expression op='[Base].[platform]' />
                      <expression op='[Models].[platform]' />
                    </expression>
                    <expression op='='>
                      <expression op='[Base].[metric_name]' />
                      <expression op='[Models].[metric_name]' />
                    </expression>
                  </expression>
                </clause>
                <relation connection='bigquery.12kxyln0vvkxpx16a4y6919fdml2' name='Base' type='text'>select * from `fulfillment-dwh-production`.rl_fintech.dl_vs_tt_metric_value_comparison</relation>
                <relation connection='bigquery.12kxyln0vvkxpx16a4y6919fdml2' name='Models' type='text'>select distinct date(snapshot_date) as date,
                platform,
                case
                    when metric.version is null then metric.name
                    else CONCAT(metric.name, &apos;_v&apos;, metric.version)
                    end             as metric_name,
                a.name              as model_id
from fulfillment-dwh-production.dm_fintech.antifraud_relational_metadata a,
     unnest(a.metrics) as metric
where date(snapshot_date) &gt;&gt;= &apos;2025-08-19&apos;
  and upper(a.type) = &apos;MODEL&apos;
  and metric.name is not null</relation>
              </relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
