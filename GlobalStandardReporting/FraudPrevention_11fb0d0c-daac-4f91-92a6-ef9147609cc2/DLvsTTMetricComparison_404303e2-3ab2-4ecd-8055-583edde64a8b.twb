      <datasource-dependencies datasource='Parameters'>
        <column caption='View by - Multi' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Match Rate&quot;'>
          <calculation class='tableau' formula='&quot;Match Rate&quot;' />
          <members>
            <member value='&quot;Match Rate&quot;' />
            <member value='&quot;Match if DL &gt; 0&quot;' />
            <member value='&quot;Match if TT &gt; 0&quot;' />
            <member value='&quot;DL &gt; TT&quot;' />
            <member value='&quot;DL &lt; TT&quot;' />
            <member value='&quot;Both Zero&quot;' />
            <member value='&quot;DL &lt; 0&quot;' />
          </members>
        </column>
        <column caption='Split By' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;None&quot;'>
          <calculation class='tableau' formula='&quot;None&quot;' />
          <members>
            <member value='&quot;None&quot;' />
            <member value='&quot;Global Entity ID&quot;' />
            <member value='&quot;Metric Topic&quot;' />
            <member value='&quot;Metric Function&quot;' />
            <member value='&quot;Is Flink?&quot;' />
            <member value='&quot;Model&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.13jhioi1emln9s1h16tz20riuujm'>
        <column caption='Is Flink?' datatype='boolean' name='[Calculation_71635426483597321]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IIF(&#10;    [platform] = &apos;Glovo&apos;&#10;    AND (&#10;        REGEXP_MATCH([metric_name], &quot;.*[0-9]+h.*&quot;)&#10;        OR REGEXP_MATCH([metric_name], &quot;.*1d.*&quot;)&#10;    ),&#10;    TRUE,&#10;    FALSE&#10;)' />
