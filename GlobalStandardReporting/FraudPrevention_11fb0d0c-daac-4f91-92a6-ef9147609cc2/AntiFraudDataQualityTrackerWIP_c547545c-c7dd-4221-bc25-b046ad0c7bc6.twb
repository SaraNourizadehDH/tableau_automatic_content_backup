      <column caption='Window Avg' datatype='real' name='[Calculation_6104558946724831249]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter Selector (copy)_5764748275832926228]&#10;when &quot;Bin Coverage%&quot; then WINDOW_AVG([Bin Coverage% (copy)_6104558944304889871])&#10;when &quot;Card Hash Coverage%&quot; then WINDOW_AVG([Card Hash Coverage% (copy)_6104558944275955717])&#10;when &quot;Card Token Coverage%&quot; then WINDOW_AVG([Calculation_5764748275830099980])&#10;when &quot;3DS Status Coverage%&quot; then WINDOW_AVG([3DS Status Coverage% (copy)_6104558944304611341])&#10;when &quot;3DS Version Coverage%&quot; then WINDOW_AVG([3DS Version Coverage% (copy)_6104558944304795662])&#10;when &quot;Card Country Coverage%&quot; then WINDOW_AVG([Calculation_5764748275829551113])&#10;when &quot;Card Holder Name Coverage%&quot; then WINDOW_AVG([Calculation_5764748275830587409])&#10;when &quot;Card Last4 Coverage%&quot; then WINDOW_AVG([Calculation_5764748275830001675])&#10;when &quot;Issuer Coverage%&quot; then WINDOW_AVG([Calculation_5764748275830464528])&#10;when &quot;Operation Status Coverage%&quot; then WINDOW_AVG([Calculation_5764748275809652741])&#10;when &quot;Operation Type Coverage%&quot; then WINDOW_AVG([Calculation_5764748275825721350])&#10;when &quot;Order Coverage%&quot; then WINDOW_AVG([Calculation_5764748275829370888])&#10;when &quot;Payment Method Coverage%&quot; then WINDOW_AVG([Calculation_5764748275830181901])&#10;when &quot;Payment Type Coverage%&quot; then WINDOW_AVG([Calculation_5764748275830366223])&#10;when &quot;Payment Status Coverage%&quot; then WINDOW_AVG([Calculation_5764748275830284302])&#10;end'>
          <table-calc ordering-type='Rows' />
