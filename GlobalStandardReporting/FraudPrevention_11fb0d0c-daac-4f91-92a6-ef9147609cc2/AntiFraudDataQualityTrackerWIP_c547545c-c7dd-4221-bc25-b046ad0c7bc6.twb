      </column>
      <column caption='is_Last full month' datatype='boolean' name='[Calculation_6104558946784505874]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;, -1, TODAY())) = DATETRUNC(&apos;month&apos;, [file_date])' />
      </column>
      <column caption='is_Last full month -1' datatype='boolean' name='[Calculation_6104558946784600083]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;, -2, TODAY())) = DATETRUNC(&apos;month&apos;, [file_date])' />
      </column>
      <column caption='Dimension Selected 1' datatype='string' name='[Calculation_6104558946790969365]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &quot;Global Entity Id&quot; then [global_entity_id] &#10;when &quot;Country&quot; then [Country]&#10;when &quot;Region&quot; then [region]&#10;when &quot;Decision&quot; then [decision]&#10;when &quot;Operation Type&quot; then [operation_type]&#10;when &quot;Operation Status&quot; then [operation_status]&#10;when &quot;Payment Method Name Curated (group)&quot; then [Payment Method Name Curated (group)]&#10;when &quot;Payment Gateway&quot; then [payment_method_name]&#10;when &quot;File Date&quot; then [Calculation_3344274593027256323]&#10;end' />
      </column>
      <column caption='Timewindow' datatype='string' name='[Calculation_6104558946792251414]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;day&apos; THEN STR(DAY([file_date])) + &apos; &apos; + LEFT(DATENAME(&apos;month&apos;,[file_date]),3) +&apos; &apos;+ RIGHT(STR(YEAR([file_date])),2)&#10;WHEN &apos;week&apos; THEN LEFT(STR(DATETRUNC(&apos;week&apos;,date([file_date]),&apos;Monday&apos;)),10)&#10;WHEN &apos;month&apos; THEN LEFT(DATENAME(&apos;month&apos;,[file_date]),3) + &apos; &apos; + STR(YEAR([file_date]))&#10;WHEN &apos;quarter&apos; THEN &apos;Q&apos;+STR(DATEPART(&apos;quarter&apos;,[file_date])) + &apos; &apos; + STR(YEAR([file_date]))&#10;END' />
      </column>
      <column caption='Card Total Attempts - calculation' datatype='integer' name='[Calculation_6104558951003664411]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( IIF([Payment Method Name Curated (group)] in (&apos;Card&apos;, &apos;Mixed Payments - OP&apos;), [total_attempts], 0))' />
