  <dashboards>
    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Information'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/OrderLossReport-RiskWiP/Information?rev=' id='Information' path='/t/GlobalStandardReporting/workbooks/OrderLossReport-RiskWiP' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='dash-text'>
          <format attr='vertical-align' id='dash-text_8' value='top' />
          <format attr='vertical-align' id='dash-text_6' value='top' />
        </style-rule>
      </style>
      <size maxheight='1200' maxwidth='1350' minheight='1200' minwidth='1350' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98666' id='3' param='vert' type-v2='layout-flow' w='98814' x='593' y='667'>
            <zone h='9832' id='7' param='horz' type-v2='layout-flow' w='98814' x='593' y='667'>
              <zone fixed-size='1069' forceUpdate='true' h='9832' id='8' is-fixed='true' type-v2='text' w='79778' x='593' y='667'>
                <formatted-text>
                  <run fontcolor='#050038' fontname='Tableau Semibold' fontsize='20'>Information</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#555555' fontname='Tableau Regular' fontsize='10'>Point of contact:</run>
                  <run fontcolor='#555555' fontname='Tableau Regular' fontsize='10'>Æ </run>
                  <run fontcolor='#707070' fontname='Tableau Regular' fontsize='10'>fintech_risk_analytics@deliveryhero.com - Fintech Data Risk Analytics Team</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#555555' fontname='Tableau Regular' fontsize='10'>Update schedule: </run>
                  <run fontcolor='#555555' fontname='Tableau Regular' fontsize='10'>daily</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone h='9832' id='10' is-centered='0' is-scaled='1' param='Image/DH_Fintech_Full_RGB.png' type-v2='bitmap' w='19036' x='80371' y='667'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
            </zone>
            <zone fixed-size='1058' forceUpdate='true' h='88834' id='6' is-fixed='true' type-v2='text' w='98814' x='593' y='10499'>
              <formatted-text>
                <run fontcolor='#333333' fontsize='11'>We have incidents in our fraud prevention set up because of multiple causes and with different potential outcomes/impact (FFS unresponsive, Feedzai unstable, human error, etc.). Therefore the goal of this dashboard is to track and measure order loss due to incidents.</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#333333' fontsize='11'>Overview: </run>
                <run fontcolor='#333333' fontsize='11'>provides a general overview of the main KPI&apos;s we use in measuring order loss.</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#333333' fontsize='11'>Scenario 1 - overtriggering declines, </run>
                <run fontcolor='#333333' fontsize='11'>allows a dashboard user to measure order loss due to this particular scenario and being calculated the following way:</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontname='Tableau Semibold' fontsize='11' italic='true'>Order Loss = (Total orders on Incident * Delta of Decline Rate)</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#333333' fontsize='11'>Scenario 2 - ovetrigerring reviews/3DS, </run>
                <run fontcolor='#333333' fontsize='11'>allows a dashboard user to measure order loss due to this particular scenario and being calculated the following way:</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontname='Tableau Semibold' fontsize='11' italic='true'>Order Loss = (Total Orders on Incident * Delta of Review Rate * (1-Delta of 3DS Success Rate))</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#333333' fontsize='11'>Scenario 3 - underscoring orders, </run>
                <run fontcolor='#333333' fontsize='11'>allows a dashboard user to measure order loss due to this particular scenario and being calculated the following way:</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontname='Tableau Semibold' fontsize='11' italic='true'>Order Loss = (Failed Scored Orders * AVG Decline Rate) + (Failed Scored Orders * AVG Review Rate * (1-Delta of 3DS Success Rate))</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#333333' fontname='Tableau Bold' fontsize='11' underline='true'>Report Update:</run>
                <run>Æ&#10;</run>
                <run fontcolor='#333333' fontname='Tableau Light' fontsize='11'>The table and report gets updated daily at 11.30pm CET.</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#333333' fontname='Tableau Bold' fontsize='11' underline='true'>Metrics used in Order Loss Calculation:</run>
                <run>Æ&#10;</run>
                <run fontcolor='#333333' fontname='Tableau Bold' fontsize='11'>- Decline Rate -&gt; </run>
                <run fontcolor='#333333' fontname='Tableau Light' fontsize='11'># of orders declined by FinFS / # of all orders going through FinFS. </run>
                <run>Æ&#10;</run>
                <run fontcolor='#333333' fontname='Tableau Bold' fontsize='11'>- Review Rate -&gt; </run>
                <run fontcolor='#333333' fontname='Tableau Light' fontsize='11'># of orders sent to 3DS  by FinFS / # of all orders in FinFS (exluding cash orders)</run>
                <run>Æ&#10;</run>
                <run fontcolor='#333333' fontname='Tableau Bold' fontsize='11'>- Failed Scored Orders -&gt; </run>
                <run fontcolor='#333333' fontname='Tableau Light' fontsize='11'>Orders that were failed to be scored by FinFS and is_gordon_error = true.</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#333333' fontname='Tableau Bold' fontsize='11' underline='true'>How to use this report?</run>
                <run>Æ&#10;</run>
                <run fontsize='11'>1. You can use the view </run>
                <run fontcolor='#333333' fontname='Tableau Bold' fontsize='11'>Overview </run>
                <run fontsize='11'>as a starting point, there you can see the  trends of the metrics that are used in the Order Loss Calculation (e.g. Decline Rate, Review Rate, Failed Scored Orders)</run>
                <run>Æ&#10;</run>
                <run fontsize='11'>2. Then judging by unusual trends or by already known incident choose a tab with the Scenario you need: </run>
                <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Bold' fontsize='11'>Overtriggering declines</run>
                <run fontsize='11'>, </run>
                <run bold='true' fontcolor='#1b1b1b' fontsize='11'>Overtriggering reviews/3DS</run>
                <run fontsize='11'> or </run>
                <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Bold' fontsize='11'>Underscoring orders</run>
                <run fontsize='11'>. </run>
                <run>Æ&#10;</run>
                <run fontsize='11'>3. Now when you are on the page with the scenario you&apos;re intersted in you need to choose the </run>
                <run bold='true' fontcolor='#1b1b1b' fontsize='11'>Incident Date</run>
                <run fontsize='11'>.</run>
                <run>Æ&#10;</run>
                <run fontsize='11'>4. Choose if you want to see the Order loss/other metrics in # of orders or GMV.</run>
                <run>Æ&#10;</run>
                <run fontsize='11'>5. Choose the </run>
                <run bold='true' fontcolor='#1b1b1b' fontsize='11'>Comparison Mode</run>
                <run fontsize='11'> in </run>
                <run bold='true' fontcolor='#1b1b1b' fontsize='11' italic='true'>Weekdays</run>
                <run fontsize='11'> (compare to the the same weekdays of the incident) or </run>
                <run bold='true' fontcolor='#1b1b1b' fontsize='11' italic='true'>Days</run>
                <run fontsize='11'>.</run>
                <run>Æ&#10;</run>
                <run fontsize='11'>6. Choose the number of the weeks you would like to compare to.</run>
                <run>Æ&#10;</run>
                <run fontsize='11'>This field was created in order to see what was the average number of a specific metric (e.g. AVG Decline Orders, AVG Decline Rate) for the chosen number of weeks (</run>
                <run bold='true' fontcolor='#333333' fontsize='11'>#Weeks to compare</run>
                <run fontsize='11'> filter).  For instance we want to compare todays number of Decline Orders at 2pm on Tuesday with average chosen # of Tuesdays/Days before the incidents time.</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#333333' fontname='Tableau Bold' fontsize='11' underline='true'>Sources:</run>
                <run>Æ&#10;</run>
                <run fontcolor='#333333' fontname='Tableau Bold' fontsize='11'>Used table:</run>
                <run>Æ&#10;</run>
                <run fontcolor='#333333' fontname='Tableau Light' fontsize='11'>fulfillment-dwh-production.cl_fintech.gordon_datamart</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#333333' fontname='Tableau Bold' fontsize='11' underline='true'>Report query:</run>
                <run>Æ&#10;</run>
                <run fontcolor='#333333' fontname='Tableau Light' fontsize='11'>fulfillment-dwh-production.rl_fintech.order_loss_report -&gt;  </run>
                <run auto-url='true' fontcolor='#333333' fontname='Tableau Light' fontsize='11' hyperlink='tabdoc:load-url url=&amp;quot;https://github.com/deliveryhero/datahub-airflow/blob/84c9181a2a91651eb751e27519cd57baa86f2441/dags/fintech/analytics_scripts/sql/fraud/order_loss_risk_report.sql&amp;quot;'>https://github.com/deliveryhero/datahub-airflow/blob/84c9181a2a91651eb751e27519cd57baa86f2441/dags/fintech/analytics_scripts/sql/fraud/order_loss_risk_report.sql</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#333333' fontsize='11'>More information about the topic  -&gt; </run>
                <run auto-url='true' fontcolor='#333333' fontsize='11' hyperlink='tabdoc:load-url url=&amp;quot;https://confluence.deliveryhero.com/pages/viewpage.action?pageId=476374103&amp;quot;'>https://confluence.deliveryhero.com/pages/viewpage.action?pageId=476374103</run>
                <run>Æ&#10;</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='118' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='98666' id='117' param='vert' type-v2='layout-flow' w='98814' x='593' y='667'>
                <zone fixed-size='1069' forceUpdate='true' h='9832' id='8' type-v2='text' w='79778' x='593' y='667'>
                  <formatted-text>
                    <run fontcolor='#050038' fontname='Tableau Semibold' fontsize='20'>Information</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#555555' fontname='Tableau Regular' fontsize='10'>Point of contact:</run>
                    <run fontcolor='#555555' fontname='Tableau Regular' fontsize='10'>Æ </run>
                    <run fontcolor='#707070' fontname='Tableau Regular' fontsize='10'>fintech_risk_analytics@deliveryhero.com - Fintech Data Risk Analytics Team</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#555555' fontname='Tableau Regular' fontsize='10'>Update schedule: </run>
                    <run fontcolor='#555555' fontname='Tableau Regular' fontsize='10'>daily</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='110' h='9832' id='10' is-centered='0' is-fixed='true' is-scaled='1' param='Image/DH_Fintech_Full_RGB.png' type-v2='bitmap' w='19036' x='80371' y='667'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='1058' forceUpdate='true' h='88834' id='6' type-v2='text' w='98814' x='593' y='10499'>
                  <formatted-text>
                    <run fontcolor='#333333' fontsize='11'>We have incidents in our fraud prevention set up because of multiple causes and with different potential outcomes/impact (FFS unresponsive, Feedzai unstable, human error, etc.). Therefore the goal of this dashboard is to track and measure order loss due to incidents.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#333333' fontsize='11'>Overview: </run>
                    <run fontcolor='#333333' fontsize='11'>provides a general overview of the main KPI&apos;s we use in measuring order loss.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#333333' fontsize='11'>Scenario 1 - overtriggering declines, </run>
                    <run fontcolor='#333333' fontsize='11'>allows a dashboard user to measure order loss due to this particular scenario and being calculated the following way:</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontname='Tableau Semibold' fontsize='11' italic='true'>Order Loss = (Total orders on Incident * Delta of Decline Rate)</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#333333' fontsize='11'>Scenario 2 - ovetrigerring reviews/3DS, </run>
                    <run fontcolor='#333333' fontsize='11'>allows a dashboard user to measure order loss due to this particular scenario and being calculated the following way:</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontname='Tableau Semibold' fontsize='11' italic='true'>Order Loss = (Total Orders on Incident * Delta of Review Rate * (1-Delta of 3DS Success Rate))</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#333333' fontsize='11'>Scenario 3 - underscoring orders, </run>
                    <run fontcolor='#333333' fontsize='11'>allows a dashboard user to measure order loss due to this particular scenario and being calculated the following way:</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontname='Tableau Semibold' fontsize='11' italic='true'>Order Loss = (Failed Scored Orders * AVG Decline Rate) + (Failed Scored Orders * AVG Review Rate * (1-Delta of 3DS Success Rate))</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#333333' fontname='Tableau Bold' fontsize='11' underline='true'>Report Update:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#333333' fontname='Tableau Light' fontsize='11'>The table and report gets updated daily at 11.30pm CET.</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#333333' fontname='Tableau Bold' fontsize='11' underline='true'>Metrics used in Order Loss Calculation:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#333333' fontname='Tableau Bold' fontsize='11'>- Decline Rate -&gt; </run>
                    <run fontcolor='#333333' fontname='Tableau Light' fontsize='11'># of orders declined by FinFS / # of all orders going through FinFS. </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#333333' fontname='Tableau Bold' fontsize='11'>- Review Rate -&gt; </run>
                    <run fontcolor='#333333' fontname='Tableau Light' fontsize='11'># of orders sent to 3DS  by FinFS / # of all orders in FinFS (exluding cash orders)</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#333333' fontname='Tableau Bold' fontsize='11'>- Failed Scored Orders -&gt; </run>
                    <run fontcolor='#333333' fontname='Tableau Light' fontsize='11'>Orders that were failed to be scored by FinFS and is_gordon_error = true.</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#333333' fontname='Tableau Bold' fontsize='11' underline='true'>How to use this report?</run>
                    <run>Æ&#10;</run>
                    <run fontsize='11'>1. You can use the view </run>
                    <run fontcolor='#333333' fontname='Tableau Bold' fontsize='11'>Overview </run>
                    <run fontsize='11'>as a starting point, there you can see the  trends of the metrics that are used in the Order Loss Calculation (e.g. Decline Rate, Review Rate, Failed Scored Orders)</run>
                    <run>Æ&#10;</run>
                    <run fontsize='11'>2. Then judging by unusual trends or by already known incident choose a tab with the Scenario you need: </run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Bold' fontsize='11'>Overtriggering declines</run>
                    <run fontsize='11'>, </run>
                    <run bold='true' fontcolor='#1b1b1b' fontsize='11'>Overtriggering reviews/3DS</run>
                    <run fontsize='11'> or </run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Bold' fontsize='11'>Underscoring orders</run>
                    <run fontsize='11'>. </run>
                    <run>Æ&#10;</run>
                    <run fontsize='11'>3. Now when you are on the page with the scenario you&apos;re intersted in you need to choose the </run>
                    <run bold='true' fontcolor='#1b1b1b' fontsize='11'>Incident Date</run>
                    <run fontsize='11'>.</run>
                    <run>Æ&#10;</run>
                    <run fontsize='11'>4. Choose if you want to see the Order loss/other metrics in # of orders or GMV.</run>
                    <run>Æ&#10;</run>
                    <run fontsize='11'>5. Choose the </run>
                    <run bold='true' fontcolor='#1b1b1b' fontsize='11'>Comparison Mode</run>
                    <run fontsize='11'> in </run>
                    <run bold='true' fontcolor='#1b1b1b' fontsize='11' italic='true'>Weekdays</run>
                    <run fontsize='11'> (compare to the the same weekdays of the incident) or </run>
                    <run bold='true' fontcolor='#1b1b1b' fontsize='11' italic='true'>Days</run>
                    <run fontsize='11'>.</run>
                    <run>Æ&#10;</run>
                    <run fontsize='11'>6. Choose the number of the weeks you would like to compare to.</run>
                    <run>Æ&#10;</run>
                    <run fontsize='11'>This field was created in order to see what was the average number of a specific metric (e.g. AVG Decline Orders, AVG Decline Rate) for the chosen number of weeks (</run>
                    <run bold='true' fontcolor='#333333' fontsize='11'>#Weeks to compare</run>
                    <run fontsize='11'> filter).  For instance we want to compare todays number of Decline Orders at 2pm on Tuesday with average chosen # of Tuesdays/Days before the incidents time.</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#333333' fontname='Tableau Bold' fontsize='11' underline='true'>Sources:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#333333' fontname='Tableau Bold' fontsize='11'>Used table:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#333333' fontname='Tableau Light' fontsize='11'>fulfillment-dwh-production.cl_fintech.gordon_datamart</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#333333' fontname='Tableau Bold' fontsize='11' underline='true'>Report query:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#333333' fontname='Tableau Light' fontsize='11'>fulfillment-dwh-production.rl_fintech.order_loss_report -&gt;  </run>
                    <run auto-url='true' fontcolor='#333333' fontname='Tableau Light' fontsize='11' hyperlink='tabdoc:load-url url=&amp;quot;https://github.com/deliveryhero/datahub-airflow/blob/84c9181a2a91651eb751e27519cd57baa86f2441/dags/fintech/analytics_scripts/sql/fraud/order_loss_risk_report.sql&amp;quot;'>https://github.com/deliveryhero/datahub-airflow/blob/84c9181a2a91651eb751e27519cd57baa86f2441/dags/fintech/analytics_scripts/sql/fraud/order_loss_risk_report.sql</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#333333' fontsize='11'>More information about the topic  -&gt; </run>
                    <run auto-url='true' fontcolor='#333333' fontsize='11' hyperlink='tabdoc:load-url url=&amp;quot;https://confluence.deliveryhero.com/pages/viewpage.action?pageId=476374103&amp;quot;'>https://confluence.deliveryhero.com/pages/viewpage.action?pageId=476374103</run>
                    <run>Æ&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
      <simple-id uuid='{5B4FF848-04A1-4B46-B389-F5AEC6E98F1A}' />
    </dashboard>
    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Overtriggering Declines'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/OrderLossReport-RiskWiP/OvertriggeringDeclines?rev=' id='OvertriggeringDeclines' path='/t/GlobalStandardReporting/workbooks/OrderLossReport-RiskWiP' revision='' site='GlobalStandardReporting' />
