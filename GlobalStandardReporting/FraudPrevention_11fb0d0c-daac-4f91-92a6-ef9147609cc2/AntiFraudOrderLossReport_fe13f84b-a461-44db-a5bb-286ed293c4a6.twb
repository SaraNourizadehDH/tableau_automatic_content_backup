      <column caption='Decline Count Trx (LOD: DAY) non selected' datatype='real' name='[Calculation_3022126511942217751]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Calculation_3022126511937638417],[Calculation_3022126511939379219], [Calculation_3022126511940366357], DATE([Calculation_3022126511936643087]) : SUM(if [Calculation_3022126511937638417] = false and [gordon_decision] = &apos;Decline&apos; then [Calculation_4836654950319706113] end) }' />
      </column>
      <column caption='AVG Decline Count Trx (LOD: DAY)' datatype='real' name='[Calculation_3022126511942619160]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_3022126511942217751])/[Parameters].[Parameter 5]' />
      </column>
