              <calculation class='tableau' formula='IF [Parameters].[Parameter 4] == &quot;weekdays&quot; then&#10;    IF [Calculation_3022126511936643087] &gt;= DATEADD(&quot;day&quot;,([Parameters].[Parameter 5] * 7)*-1,[Parameters].[Parameter 3]) and [Calculation_3022126511936643087] &lt; DATEADD(&quot;day&quot;,1,[Parameters].[Parameter 3]) THEN TRUE ELSE FALSE END&#10;ELSEIF [Parameters].[Parameter 4] == &quot;days&quot; then&#10;    IF [Calculation_3022126511936643087] &gt;= DATEADD(&quot;day&quot;,[Parameters].[Parameter 5]*-1,[Parameters].[Parameter 3]) and [Calculation_3022126511936643087] &lt; DATEADD(&quot;day&quot;,1,[Parameters].[Parameter 3]) THEN TRUE ELSE FALSE END&#10;END' />
