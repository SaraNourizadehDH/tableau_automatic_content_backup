              <calculation class='tableau' formula='if [Calculation_3022126511939379219] = true and [Calculation_3022126511937638417] = false &#10;then STR(DATEPART(&quot;day&quot;,[Calculation_3022126511936643087])) + &quot;-&quot; + STR(DATEPART(&quot;month&quot;,[Calculation_3022126511936643087])) + &quot;-&quot; + STR(DATEPART(&quot;year&quot;,[Calculation_3022126511936643087])) &#10;ELSEIF [Calculation_3022126511939379219] = true and [Calculation_3022126511937638417] = true&#10;then &quot;Incident Date&quot;&#10;END' />
