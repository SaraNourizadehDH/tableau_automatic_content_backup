              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;day&apos; THEN STR(DAY([order_date])) + &apos; &apos; + LEFT(DATENAME(&apos;month&apos;,[order_date]),3) +&apos; &apos;+ RIGHT(STR(YEAR([order_date])),2)&#10;WHEN &apos;week&apos; THEN LEFT(STR(DATETRUNC(&apos;week&apos;,date([order_date]),&apos;Monday&apos;)),10)&#10;WHEN &apos;month&apos; THEN LEFT(DATENAME(&apos;month&apos;,[order_date]),3) + &apos; &apos; + STR(YEAR([order_date]))&#10;WHEN &apos;quarter&apos; THEN &apos;Q&apos;+STR(DATEPART(&apos;quarter&apos;,[order_date])) + &apos; &apos; + STR(YEAR([order_date]))&#10;END' />
