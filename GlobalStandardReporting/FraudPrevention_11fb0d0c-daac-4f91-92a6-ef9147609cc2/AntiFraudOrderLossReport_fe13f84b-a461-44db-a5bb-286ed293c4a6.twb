                  <zone fixed-size='996' forceUpdate='true' h='8948' id='54' is-fixed='true' type-v2='text' w='74333' x='533' y='842'>
                    <formatted-text>
                      <run fontcolor='#050038' fontname='Tableau Semibold' fontsize='20'>Overtriggering Declines</run>
                      <run>Æ&#10;</run>
                      <run bold='true' fontcolor='#555555' fontname='Tableau Regular' fontsize='10'>Point of contact:</run>
                      <run fontcolor='#555555' fontname='Tableau Regular' fontsize='10'>Æ </run>
                      <run fontcolor='#707070' fontname='Tableau Regular' fontsize='10'>fintech_risk_analytics@deliveryhero.com - Fintech Data Risk Analytics Team</run>
                      <run>Æ&#10;</run>
                      <run bold='true' fontcolor='#555555' fontname='Tableau Regular' fontsize='10'>Update schedule: </run>
                      <run fontcolor='#555555' fontname='Tableau Regular' fontsize='10'>daily</run>
                    </formatted-text>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
                    </zone-style>
                  </zone>
                  <zone h='3368' id='57' name='Update Time' w='74333' x='533' y='9790'>
                    <layout-cache cell-count-h='1' cell-count-w='1' non-cell-size-h='42' type-h='cell' type-w='cell' />
                    <zone-style>
