              <calculation class='tableau' formula='IF DATE([Calculation_3022126511936643087]) == [Parameters].[Parameter 3]&#10;    THEN True&#10;ELSEIF DATEDIFF(&apos;day&apos;, DATE([Calculation_3022126511936643087]), [Parameters].[Parameter 3]) % 7 = 0 AND [Parameters].[Parameter 4] = &quot;weekdays&quot;&#10;    THEN True&#10;ELSEIF DATEDIFF(&apos;day&apos;, DATE([Calculation_3022126511936643087]), [Parameters].[Parameter 3]) &lt;= [Parameters].[Parameter 5] AND [Parameters].[Parameter 4] = &quot;days&quot;&#10;    THEN True&#10;ELSE False&#10;END' />
