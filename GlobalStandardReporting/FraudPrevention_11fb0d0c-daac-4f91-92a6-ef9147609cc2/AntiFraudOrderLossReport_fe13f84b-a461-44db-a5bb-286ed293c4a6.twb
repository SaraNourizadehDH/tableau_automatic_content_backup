            <column-instance column='[Calculation_56576529884110850]' derivation='None' name='[none:Calculation_56576529884110850:nk]' pivot='key' type='nominal' />
            <column-instance column='[Order Date (copy)_3022126511119097868]' derivation='None' name='[none:Order Date (copy)_3022126511119097868:qk]' pivot='key' type='quantitative' />
