        <calculation class='tableau' formula='IFNULL({ FIXED [Calculation_3022126511939379219], [Calculation_3022126511940366357], DAY([order_date]) : SUM(if [Calculation_3022126511937638417] =  TRUE and [gordon_decision] = &apos;Review&apos; then [total_trx] END) },0)' />
