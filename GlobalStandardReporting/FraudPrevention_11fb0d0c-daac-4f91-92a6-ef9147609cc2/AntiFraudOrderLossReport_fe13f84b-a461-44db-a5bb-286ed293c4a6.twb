        <calculation class='tableau' formula='SUM([Total Count Trx (LOD: DAY) selected (copy)_3022126511940947990]) - [Calculation_3022126511942619160]' />
      </column>
      <column caption='% Decline Count Trx (LOD: DAY) Delta' datatype='real' default-format='p0.00%' name='[Calculation_3022126511955423260]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Total Count Trx (LOD: DAY) selected (copy)_3022126511940947990]) - AVG([Calculation_3022126511942217751]))/AVG([Calculation_3022126511942217751])' />
