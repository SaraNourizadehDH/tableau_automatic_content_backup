    <worksheet name='(UO) #Order per Hour Table Delta (7)'>
      <table>
        <view>
          <datasources>
            <datasource caption='order_loss_report+ (curated_data_shared_govops)' name='federated.0hselac1t6895j16go6i71ohsaq6' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='CET' caption='Time Zone' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;cet&quot;'>
              <calculation class='tableau' formula='&quot;cet&quot;' />
              <aliases>
                <alias key='&quot;cet&quot;' value='CET' />
                <alias key='&quot;utc&quot;' value='UTC' />
              </aliases>
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0hselac1t6895j16go6i71ohsaq6].[Calculation_3022126511937347600]' caption='Incident Date' datatype='date' name='[Parameter 3]' param-domain-type='any' role='measure' type='quantitative' value='#2024-08-21#'>
              <calculation class='tableau' formula='#2024-08-21#' />
            </column>
            <column alias='Weekdays' caption='Benchmark Mode' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;weekdays&quot;'>
              <calculation class='tableau' formula='&quot;weekdays&quot;' />
              <aliases>
                <alias key='&quot;days&quot;' value='Days' />
                <alias key='&quot;weekdays&quot;' value='Weekdays' />
              </aliases>
            </column>
            <column caption='#Weeks (Benchmark)' datatype='integer' name='[Parameter 5]' param-domain-type='range' role='measure' type='quantitative' value='4'>
              <calculation class='tableau' formula='4' />
              <range max='16' min='1' />
            </column>
            <column alias='Orders #' caption='Select a metric' datatype='integer' name='[Parameter 6]' param-domain-type='list' role='measure' type='quantitative' value='0'>
              <calculation class='tableau' formula='0' />
              <aliases>
                <alias key='0' value='Orders #' />
                <alias key='1' value='GMV €' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0hselac1t6895j16go6i71ohsaq6'>
            <column caption='Time range filter' datatype='boolean' name='[Calculation_1148910542261710848]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4] == &quot;weekdays&quot; then&#10;    IF [Calculation_3022126511936643087] &gt;= DATEADD(&quot;day&quot;,([Parameters].[Parameter 5] * 7)*-1,[Parameters].[Parameter 3]) and [Calculation_3022126511936643087] &lt; DATEADD(&quot;day&quot;,1,[Parameters].[Parameter 3]) THEN TRUE ELSE FALSE END&#10;ELSEIF [Parameters].[Parameter 4] == &quot;days&quot; then&#10;    IF [Calculation_3022126511936643087] &gt;= DATEADD(&quot;day&quot;,[Parameters].[Parameter 5]*-1,[Parameters].[Parameter 3]) and [Calculation_3022126511936643087] &lt; DATEADD(&quot;day&quot;,1,[Parameters].[Parameter 3]) THEN TRUE ELSE FALSE END&#10;END' />
            </column>
            <column caption='Order Datetime with Timezone' datatype='datetime' name='[Calculation_3022126511936643087]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;utc&quot; then [order_datetime]&#10;ELSEIF [Parameters].[Parameter 2] = &quot;cet&quot; then [order_datetime_cet]&#10;END' />
            </column>
            <column caption='Max Date of Incident' datatype='datetime' name='[Calculation_3022126511937347600]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='{ MAX([Calculation_3022126511936643087])}' />
            </column>
            <column caption='is_selected_date' datatype='boolean' name='[Calculation_3022126511937638417]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] == DATE([Calculation_3022126511936643087]) THEN True Else False END' />
            </column>
            <column caption='is_date_benchmark' datatype='boolean' name='[Calculation_3022126511939379219]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATE([Calculation_3022126511936643087]) == [Parameters].[Parameter 3]&#10;    THEN True&#10;ELSEIF DATEDIFF(&apos;day&apos;, DATE([Calculation_3022126511936643087]), [Parameters].[Parameter 3]) % 7 = 0 AND [Parameters].[Parameter 4] = &quot;weekdays&quot;&#10;    THEN True&#10;ELSEIF DATEDIFF(&apos;day&apos;, DATE([Calculation_3022126511936643087]), [Parameters].[Parameter 3]) &lt;= [Parameters].[Parameter 5] AND [Parameters].[Parameter 4] = &quot;days&quot;&#10;    THEN True&#10;ELSE False&#10;END' />
            </column>
            <column caption='Order Hour' datatype='string' name='[Calculation_3022126511940366357]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(DATEPART(&quot;hour&quot;,[Calculation_3022126511936643087])) + &quot;:00&quot;' />
            </column>
            <column caption='Decline Rate (LOD: DAY) selected' datatype='real' name='[Calculation_3022126511959810083]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL({ FIXED [Calculation_3022126511939379219], [Calculation_3022126511940366357], DATE([order_date]) : (SUM(if [Calculation_3022126511937638417] =  TRUE and [gordon_decision] = &apos;Decline&apos; THEN [Calculation_4836654950319706113] end)/SUM(if [Calculation_3022126511937638417] =  TRUE THEN [Calculation_4836654950319706113] END))*100 },0)' />
            </column>
            <column caption='Decline Rate (LOD: DAY) non selected' datatype='real' name='[Calculation_3022126511960039460]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Calculation_3022126511939379219], [Calculation_3022126511940366357], DATE([Calculation_3022126511936643087]) : (SUM(if [Calculation_3022126511937638417] = false and [gordon_decision] = &apos;Decline&apos; THEN [Calculation_4836654950319706113] end)/SUM(if [Calculation_3022126511937638417] = false then [Calculation_4836654950319706113] end))*100 }' />
            </column>
            <column caption='Date Selected' datatype='string' name='[Calculation_3022126511961837605]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_3022126511939379219] = true and [Calculation_3022126511937638417] = false &#10;then STR(DATEPART(&quot;day&quot;,[Calculation_3022126511936643087])) + &quot;-&quot; + STR(DATEPART(&quot;month&quot;,[Calculation_3022126511936643087])) + &quot;-&quot; + STR(DATEPART(&quot;year&quot;,[Calculation_3022126511936643087])) &#10;ELSEIF [Calculation_3022126511939379219] = true and [Calculation_3022126511937638417] = true&#10;then &quot;Incident Date&quot;&#10;END' />
            </column>
            <column caption='&quot;Delta of Decline Rate&quot;' datatype='string' name='[Calculation_3022126511962677287]' role='dimension' type='nominal' user:unnamed='#Order per Hour Table Delta (5)'>
              <calculation class='tableau' formula='&quot;Delta of Decline Rate&quot;' />
            </column>
            <column caption='Decline Rate (LOD: DAY) Delta' datatype='real' name='[Calculation_3022126511962808360]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_3022126511959810083]) - AVG([Calculation_3022126511960039460])' />
            </column>
            <column caption='Metrics Prefix' datatype='string' name='[Calculation_3022126512198397995]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;%&quot;' />
            </column>
            <column caption='Metric Actuals - Total' datatype='real' name='[Calculation_4836654950319706113]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;WHEN 0 THEN [total_trx]&#10;WHEN 1 THEN [total_amount]&#10;END' />
            </column>
            <column caption='Order Date Range' datatype='date' name='[Order Date (copy)_3022126511119097868]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[order_date]' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Entity Name' datatype='string' name='[entity_name]' role='dimension' type='nominal' />
            <column caption='Gordon Decision' datatype='string' name='[gordon_decision]' role='dimension' type='nominal' />
            <column caption='Is_Mixed_Payment' datatype='boolean' name='[is_mixed_payment]' role='dimension' type='nominal' />
