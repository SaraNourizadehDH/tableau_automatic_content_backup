      <column caption='Euro_sign' datatype='string' name='[Calculation_4836654950328766466]' role='measure' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;WHEN 1 THEN &#10;        IF SUM([Calculation_4836654950319706113])&gt;0 THEN &quot;€&quot; &#10;    ELSE &quot;&quot;&#10;END&#10;END' />
      </column>
      <column caption='Metric Actuals - Total - OP' datatype='real' name='[Calculation_544583772213542912]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [payment_type] != &apos;CashOnDelivery&apos; &#10;    AND [payment_type] != &apos;PaymentOnDelivery&apos; &#10;    AND [payment_type] != &apos;CardOnDelivery&apos; &#10;    then [Calculation_4836654950319706113]&#10;    ELSE 0&#10;END' />
      </column>
