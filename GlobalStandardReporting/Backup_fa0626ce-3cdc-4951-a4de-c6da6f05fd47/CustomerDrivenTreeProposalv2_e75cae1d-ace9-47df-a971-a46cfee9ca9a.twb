              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN 1 THEN ZN([cm_gmv_eur])&#10;WHEN 2 THEN ZN([cm_group_size])&#10;WHEN 3 THEN ZN([cm_orders_count])&#10;END' />
