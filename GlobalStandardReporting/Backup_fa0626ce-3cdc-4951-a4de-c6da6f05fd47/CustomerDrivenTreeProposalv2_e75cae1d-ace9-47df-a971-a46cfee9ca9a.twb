      <column caption='Layer Rank' datatype='integer' name='[Calculation_2746773578519617553]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [cm_layer_2] = &apos;Retained&apos; THEN 1&#10;ELSEIF [cm_layer_2] = &apos;Reactivated&apos; THEN 2&#10;ELSEIF [cm_layer_2] = &apos;Churned&apos; THEN 3&#10;ELSEIF [cm_layer_3] = &apos;Inactive&apos; THEN 4&#10;END' />
