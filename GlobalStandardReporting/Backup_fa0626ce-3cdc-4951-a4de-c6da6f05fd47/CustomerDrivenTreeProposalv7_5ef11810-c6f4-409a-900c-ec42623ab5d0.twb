    <worksheet name='Tree-Layer-3-Existing-Retained'>
      <table>
        <view>
          <datasources>
            <datasource caption='bima_tableau_customer_tree_summary+ (Multiple Connections)' name='federated.153p22p1ywzlbo1djd4ka0wjbf70' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Customer Count' caption='KPI Selector' datatype='integer' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='2'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='1' value='GMV' />
                <alias key='2' value='Customer Count' />
                <alias key='3' value='Orders' />
              </aliases>
            </column>
            <column caption='Reporting Month' datatype='date' default-format='*MMMM YYYY' name='[Parameter 3]' param-domain-type='list' role='measure' type='quantitative' value='#2023-09-01#'>
              <calculation class='tableau' formula='#2023-09-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.153p22p1ywzlbo1djd4ka0wjbf70'>
            <column caption='PM KPI Selector' datatype='real' name='[Calculation_220043082649493511]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF DATEADD(&apos;month&apos;, -1, [Parameters].[Parameter 3]) = [month_date] THEN [Calculation_4156752100440735777] ELSE 0 END' />
            </column>
            <column caption='KPI Selector' datatype='real' name='[Calculation_4156752100440735777]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN 1 THEN ZN([cm_gmv_eur])&#10;WHEN 2 THEN ZN([cm_group_size])&#10;WHEN 3 THEN ZN([cm_orders_count])&#10;END' />
            </column>
            <column caption='Hide Bar Graph' datatype='boolean' name='[Calculation_6135310082249281548]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='TRUE' />
            </column>
            <column caption='MoM KPI Selector' datatype='real' default-format='p0.0%' name='[Calculation_6135310082252402704]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([PM KPI Selector (copy)_220043082651029512])) - ZN(SUM([Calculation_220043082649493511]))) / ABS(ZN(SUM([Calculation_220043082649493511])))' />
            </column>
            <column caption='KPI Selector Label' datatype='string' name='[KPI Selector (copy)_4156752100512948282]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN 1 THEN &apos;GMV&apos;&#10;WHEN 2 THEN &apos;Customers&apos;&#10;WHEN 3 THEN &apos;Orders&apos;&#10;END' />
            </column>
            <column caption='YoY KPI Selector' datatype='real' default-format='p0.0%' name='[MoM KPI Selector (copy)_988117925692280838]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([PM KPI Selector (copy)_220043082651029512])) - ZN(SUM([PM KPI Selector (copy)_988117925692104709]))) / ABS(ZN(SUM([PM KPI Selector (copy)_988117925692104709])))' />
            </column>
            <column caption='MoM KPI Selector Zero' datatype='real' default-format='*▲ 0.0%; ▼ -0.0%; 0.0%' name='[MoM KPI Selector Down (copy)_2746773578316091394]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_6135310082252402704] = 0 THEN [Calculation_6135310082252402704] &#10;ELSEIF ISNULL([Calculation_6135310082252402704]) THEN 0&#10;ELSE NULL &#10;END' />
            </column>
            <column caption='MoM KPI Selector Up' datatype='real' default-format='*▲ 0.0%; ▼ -0.0%; 0.0%' name='[MoM KPI Selector Down (copy)_2746773578420846605]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_6135310082252402704] &gt; 0 THEN [Calculation_6135310082252402704] ELSE NULL END' />
            </column>
            <column caption='YoY KPI Selector Down' datatype='real' default-format='*▲ 0.0%; ▼ -0.0%; 0.0%' name='[MoM KPI Selector Down (copy)_988117925692383239]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [MoM KPI Selector (copy)_988117925692280838] &lt; 0 THEN [MoM KPI Selector (copy)_988117925692280838] ELSE NULL END' />
            </column>
            <column caption='MoM KPI Selector Down' datatype='real' default-format='*▲ 0.0%; ▼ -0.0%; 0.0%' name='[MoM KPI Selector Up (copy)_2746773578316021761]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_6135310082252402704] &lt; 0 THEN [Calculation_6135310082252402704] ELSE NULL END' />
