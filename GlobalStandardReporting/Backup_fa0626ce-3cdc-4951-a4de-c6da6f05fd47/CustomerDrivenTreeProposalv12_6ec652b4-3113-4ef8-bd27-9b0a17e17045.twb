            <column caption='MoM Customer Count' datatype='real' default-format='*▲ 0.0%; ▼ -0.0%; 0.0%' name='[MoM GMV (copy)_5157888231366717448]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([PM Customer Count Total (copy)_5157888231365439493])) - ZN(SUM([PM GMV Total (copy)_5157888231354785793]))) / ABS(ZN(SUM([PM GMV Total (copy)_5157888231354785793])))' />
