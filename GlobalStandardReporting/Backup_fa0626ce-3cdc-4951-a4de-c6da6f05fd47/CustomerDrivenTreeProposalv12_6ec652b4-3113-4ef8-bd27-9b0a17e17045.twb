    <worksheet name='GMV Table MoM'>
      <table>
        <view>
          <datasources>
            <datasource caption='bima_tableau_customer_tree_summary+ (Multiple Connections)' name='federated.153p22p1ywzlbo1djd4ka0wjbf70' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Reporting Month' datatype='date' default-format='*MMMM YYYY' name='[Parameter 3]' param-domain-type='list' role='measure' type='quantitative' value='#2023-09-01#'>
              <calculation class='tableau' formula='#2023-09-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.153p22p1ywzlbo1djd4ka0wjbf70'>
            <column caption='PM AOV' datatype='real' name='[CM AOV (copy)_6006464917538390021]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([PM KPI Selector (copy)_5157888231354699776]) / SUM([PM Customer Count Total (copy)_5157888231354904578])' />
            </column>
            <column caption='PM Frequency' datatype='real' name='[CM Frequency (copy)_6006464917538275332]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([PM Customer Count Total (copy)_5157888231354904578]) / SUM([PM GMV Total (copy)_5157888231354785793])&#10;&#10;// customer count represent users who placed an order. (not churned and inactive customers)' />
            </column>
            <column caption='Dummy Layer 3' datatype='string' name='[Calculation_6006464917531598848]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [cm_layer_2] = &apos;New&apos; AND [cm_layer_3] = &apos;Low Frequency&apos; THEN &apos;TOM&apos;&#10;ELSEIF [cm_layer_2] = &apos;New&apos; AND [cm_layer_3] = &apos;Mid Frequency&apos; THEN &apos;PM&apos;&#10;ELSEIF [cm_layer_2] = &apos;New&apos; AND [cm_layer_3] = &apos;High Frequency&apos; THEN &apos;Other&apos;&#10;ELSEIF [cm_layer_2] = &apos;Re-acquired&apos; AND [cm_layer_3] = &apos;Low Frequency&apos; THEN &apos;CRM&apos;&#10;ELSEIF [cm_layer_2] = &apos;Re-acquired&apos; AND [cm_layer_3] = &apos;Mid Frequency&apos; THEN &apos;PM&apos;&#10;ELSEIF [cm_layer_2] = &apos;Re-acquired&apos; AND [cm_layer_3] = &apos;High Frequency&apos; THEN &apos;Other&apos;&#10;ELSEIF [cm_layer_2] = &apos;Retained&apos; AND [cm_layer_3] = &apos;High Frequency&apos; THEN &apos;Frequent&apos;&#10;ELSEIF [cm_layer_2] = &apos;Retained&apos; AND [cm_layer_3] = &apos;Mid Frequency&apos; THEN &apos;Infrequent&apos;&#10;ELSEIF [cm_layer_2] = &apos;Retained&apos; AND [cm_layer_3] = &apos;Low Frequency&apos; THEN &apos;1-ers&apos;&#10;ELSE [cm_layer_3]&#10;END' />
              <aliases>
                <alias key='&quot;Reactivated from Churned&quot;' value='Reac. from Churned' />
                <alias key='&quot;Reactivated from Inactive&quot;' value='Reac. from Inactive' />
              </aliases>
            </column>
            <column caption='CM Frequency' datatype='real' name='[Calculation_6006464917535645698]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([PM Orders Count Total (copy)_5157888231365541894]) / SUM([PM Customer Count Total (copy)_5157888231365439493])&#10;&#10;// customer count represent users who placed an order. (not churned and inactive customers)' />
            </column>
            <column caption='CM AOV' datatype='real' name='[Calculation_6006464917536980995]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([PM GMV Total (copy)_5157888231365308420]) / SUM([PM Orders Count Total (copy)_5157888231365541894])' />
            </column>
            <column caption='MoM AOV' datatype='real' default-format='*▲ 0.0%; ▼ -0.0%; 0.0%' name='[MoM Frequency (copy)_6006464917539012615]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN([Calculation_6006464917536980995]) - ZN([CM AOV (copy)_6006464917538390021])) / ABS(ZN([CM AOV (copy)_6006464917538390021]))' />
            </column>
            <column caption='MoM Customer Count' datatype='real' default-format='*▲ 0.0%; ▼ -0.0%; 0.0%' name='[MoM GMV (copy)_5157888231366717448]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([PM Customer Count Total (copy)_5157888231365439493])) - ZN(SUM([PM GMV Total (copy)_5157888231354785793]))) / ABS(ZN(SUM([PM GMV Total (copy)_5157888231354785793])))' />
            </column>
            <column caption='MoM Frequency' datatype='real' default-format='*▲ 0.0%; ▼ -0.0%; 0.0%' name='[MoM GMV (copy)_6006464917538492422]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN([Calculation_6006464917535645698]) - ZN([CM Frequency (copy)_6006464917538275332])) / ABS(ZN([CM Frequency (copy)_6006464917538275332]))' />
            </column>
            <column caption='MoM GMV' datatype='real' default-format='*▲ 0.0%; ▼ -0.0%; 0.0%' name='[MoM KPI Selector (copy)_5157888231355052035]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([PM GMV Total (copy)_5157888231365308420])) - ZN(SUM([PM KPI Selector (copy)_5157888231354699776]))) / ABS(ZN(SUM([PM KPI Selector (copy)_5157888231354699776])))' />
            </column>
            <column caption='Previous Month Orders Count' datatype='integer' name='[PM Customer Count Total (copy)_5157888231354904578]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF DATEADD(&apos;month&apos;, -1, [Parameters].[Parameter 3]) = [month_date] THEN [cm_orders_count] ELSE 0 END' />
            </column>
            <column caption='Reporting Month Customer Count' datatype='integer' default-format='n#,##0,,.00M;-#,##0,,.00M' name='[PM Customer Count Total (copy)_5157888231365439493]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = [month_date] THEN [cm_customer_count] ELSE 0 END' />
            </column>
            <column caption='Previous Month Customer Count' datatype='integer' name='[PM GMV Total (copy)_5157888231354785793]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF DATEADD(&apos;month&apos;, -1, [Parameters].[Parameter 3]) = [month_date] THEN [cm_customer_count] ELSE 0 END' />
            </column>
            <column caption='Reporting Month GMV' datatype='real' default-format='n#,##0,,.00M;-#,##0,,.00M' name='[PM GMV Total (copy)_5157888231365308420]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = [month_date] THEN [cm_gmv_eur] ELSE 0 END' />
            </column>
            <column caption='Previous Month GMV' datatype='real' name='[PM KPI Selector (copy)_5157888231354699776]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF DATEADD(&apos;month&apos;, -1, [Parameters].[Parameter 3]) = [month_date] THEN [cm_gmv_eur] ELSE 0 END' />
            </column>
            <column caption='Reporting Month Orders Count' datatype='integer' default-format='n#,##0,,.00M;-#,##0,,.00M' name='[PM Orders Count Total (copy)_5157888231365541894]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = [month_date] THEN [cm_orders_count] ELSE 0 END' />
            </column>
            <column aggregation='None' caption='Path (bin)' datatype='integer' name='[Path (bin)]' role='dimension' type='ordinal'>
