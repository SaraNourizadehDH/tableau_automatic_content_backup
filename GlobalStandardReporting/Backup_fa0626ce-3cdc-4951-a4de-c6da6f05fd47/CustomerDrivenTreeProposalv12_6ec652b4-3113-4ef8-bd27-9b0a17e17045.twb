      <table>
        <view>
          <datasources>
            <datasource caption='bima_tableau_customer_tree_summary+ (Multiple Connections)' name='federated.153p22p1ywzlbo1djd4ka0wjbf70' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='GMV' caption='KPI Selector' datatype='integer' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='GMV' />
                <alias key='2' value='Customer Count' />
                <alias key='3' value='Orders' />
              </aliases>
            </column>
            <column caption='Reporting Month' datatype='date' default-format='*MMMM YYYY' name='[Parameter 3]' param-domain-type='list' role='measure' type='quantitative' value='#2023-09-01#'>
              <calculation class='tableau' formula='#2023-09-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.153p22p1ywzlbo1djd4ka0wjbf70'>
            <column caption='@Y Layer 3' datatype='real' name='[@Y Layer 2 (copy)_4156752100510908472]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4156752100442710056]*([Calculation_4156752100442210342]-(WINDOW_MAX([Calculation_4156752100442210342])+1)/2)/300&#10;+ 0.009999999&#10;&#10;&#10;//[@Sigmoid]*([@Rank]-(WINDOW_MAX([@Rank])+1)/2)/100  -0.009999970'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Reporting Month Filter' datatype='boolean' name='[Calculation_220043082654380042]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 3] = [month_date]' />
            </column>
            <column caption='KPI Selector' datatype='real' name='[Calculation_4156752100440735777]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN 1 THEN ZN([cm_gmv_eur])&#10;WHEN 2 THEN ZN([cm_customer_count])&#10;WHEN 3 THEN ZN([cm_orders_count])&#10;END' />
            </column>
            <column caption='@CM KPI Selector' datatype='real' name='[Calculation_4156752100441305122]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_SUM(SUM([PM KPI Selector (copy)_220043082651029512])) / 2'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='@Rank' datatype='integer' name='[Calculation_4156752100442210342]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK_UNIQUE([Calculation_4156752100441305122],&quot;asc&quot;)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='@X' datatype='real' name='[Calculation_4156752100442435623]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(((INDEX()-1)*0.12)-6)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='@sigmoid' datatype='real' name='[Calculation_4156752100442710056]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1/(1+EXP(-[Calculation_4156752100442435623]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Hide Bar Graph' datatype='boolean' name='[Calculation_6135310082249281548]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='TRUE' />
