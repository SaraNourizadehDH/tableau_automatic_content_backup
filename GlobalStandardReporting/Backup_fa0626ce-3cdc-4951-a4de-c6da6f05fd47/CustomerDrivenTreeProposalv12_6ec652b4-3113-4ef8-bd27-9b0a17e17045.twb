    <worksheet name='Tree-Layer 4-Subscriber-Label'>
      <table>
        <view>
          <datasources>
            <datasource caption='bima_tableau_customer_tree_summary+ (Multiple Connections)' name='federated.153p22p1ywzlbo1djd4ka0wjbf70' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='GMV' caption='KPI Selector' datatype='integer' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='GMV' />
                <alias key='2' value='Customer Count' />
                <alias key='3' value='Orders' />
              </aliases>
            </column>
            <column caption='Reporting Month' datatype='date' default-format='*MMMM YYYY' name='[Parameter 3]' param-domain-type='list' role='measure' type='quantitative' value='#2023-09-01#'>
              <calculation class='tableau' formula='#2023-09-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.153p22p1ywzlbo1djd4ka0wjbf70'>
            <column caption='PM KPI Selector' datatype='real' name='[Calculation_220043082649493511]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF DATEADD(&apos;month&apos;, -1, [Parameters].[Parameter 3]) = [month_date] THEN [Calculation_4156752100440735777] ELSE 0 END' />
            </column>
            <column caption='KPI Selector' datatype='real' name='[Calculation_4156752100440735777]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN 1 THEN ZN([cm_gmv_eur])&#10;WHEN 2 THEN ZN([cm_customer_count])&#10;WHEN 3 THEN ZN([cm_orders_count])&#10;END' />
            </column>
            <column caption='Total Reporting Month KPI Selector' datatype='real' name='[Calculation_4156752100556578879]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Parameters].[Parameter 3], [management_entity], [brand_name], [country_name], [Path (bin)]: SUM([PM KPI Selector (copy)_220043082651029512]) }' />
            </column>
            <column caption='CM KPI Selector SOB' datatype='real' default-format='p0.0%' name='[Calculation_5157888231439769615]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([PM KPI Selector (copy)_220043082651029512]) / SUM([Calculation_4156752100556578879])' />
            </column>
            <column caption='Dummy Layer 3' datatype='string' name='[Calculation_6006464917531598848]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [cm_layer_2] = &apos;New&apos; AND [cm_layer_3] = &apos;Low Frequency&apos; THEN &apos;TOM&apos;&#10;ELSEIF [cm_layer_2] = &apos;New&apos; AND [cm_layer_3] = &apos;Mid Frequency&apos; THEN &apos;PM&apos;&#10;ELSEIF [cm_layer_2] = &apos;New&apos; AND [cm_layer_3] = &apos;High Frequency&apos; THEN &apos;Other&apos;&#10;ELSEIF [cm_layer_2] = &apos;Re-acquired&apos; AND [cm_layer_3] = &apos;Low Frequency&apos; THEN &apos;CRM&apos;&#10;ELSEIF [cm_layer_2] = &apos;Re-acquired&apos; AND [cm_layer_3] = &apos;Mid Frequency&apos; THEN &apos;PM&apos;&#10;ELSEIF [cm_layer_2] = &apos;Re-acquired&apos; AND [cm_layer_3] = &apos;High Frequency&apos; THEN &apos;Other&apos;&#10;ELSEIF [cm_layer_2] = &apos;Retained&apos; AND [cm_layer_3] = &apos;High Frequency&apos; THEN &apos;Frequent&apos;&#10;ELSEIF [cm_layer_2] = &apos;Retained&apos; AND [cm_layer_3] = &apos;Mid Frequency&apos; THEN &apos;Infrequent&apos;&#10;ELSEIF [cm_layer_2] = &apos;Retained&apos; AND [cm_layer_3] = &apos;Low Frequency&apos; THEN &apos;1-ers&apos;&#10;ELSE [cm_layer_3]&#10;END' />
              <aliases>
                <alias key='&quot;Reactivated from Churned&quot;' value='Reac. from Churned' />
                <alias key='&quot;Reactivated from Inactive&quot;' value='Reac. from Inactive' />
              </aliases>
            </column>
            <column caption='MoM KPI Selector' datatype='real' default-format='*▲ 0.0%; ▼ -0.0%; 0.0%' name='[Calculation_6135310082252402704]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([PM KPI Selector (copy)_220043082651029512])) - ZN(SUM([Calculation_220043082649493511]))) / ABS(ZN(SUM([Calculation_220043082649493511])))' />
            </column>
            <column caption='KPI Selector Label' datatype='string' name='[KPI Selector (copy)_4156752100512948282]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN 1 THEN &apos;GMV&apos;&#10;WHEN 2 THEN &apos;Customers&apos;&#10;WHEN 3 THEN &apos;Orders&apos;&#10;END' />
            </column>
            <column caption='YoY KPI Selector' datatype='real' default-format='*▲ 0.0%; ▼ -0.0%; 0.0%' name='[MoM KPI Selector (copy)_988117925692280838]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([PM KPI Selector (copy)_220043082651029512])) - ZN(SUM([PM KPI Selector (copy)_988117925692104709]))) / ABS(ZN(SUM([PM KPI Selector (copy)_988117925692104709])))' />
            </column>
            <column caption='MoM KPI Selector Zero' datatype='real' default-format='*▲ 0.0%; ▼ -0.0%; 0.0%' name='[MoM KPI Selector Down (copy)_2746773578316091394]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_6135310082252402704] = 0 THEN [Calculation_6135310082252402704] &#10;ELSEIF ISNULL([Calculation_6135310082252402704]) THEN 0&#10;ELSE NULL &#10;END' />
            </column>
            <column caption='MoM KPI Selector Up' datatype='real' default-format='*▲ 0.0%; ▼ -0.0%; 0.0%' name='[MoM KPI Selector Down (copy)_2746773578420846605]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_6135310082252402704] &gt; 0 THEN [Calculation_6135310082252402704] ELSE NULL END' />
            </column>
            <column caption='YoY KPI Selector Down' datatype='real' default-format='*▲ 0.0%; ▼ -0.0%; 0.0%' name='[MoM KPI Selector Down (copy)_988117925692383239]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [MoM KPI Selector (copy)_988117925692280838] &lt; 0 THEN [MoM KPI Selector (copy)_988117925692280838] ELSE NULL END' />
            </column>
