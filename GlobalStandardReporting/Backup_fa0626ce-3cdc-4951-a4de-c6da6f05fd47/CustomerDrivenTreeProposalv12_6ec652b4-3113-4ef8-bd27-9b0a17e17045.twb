              <calculation class='tableau' formula='#2023-09-01#' />
            </column>
            <column caption='Swap' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;L1 base waterfall&quot;'>
              <calculation class='tableau' formula='&quot;L1 base waterfall&quot;' />
