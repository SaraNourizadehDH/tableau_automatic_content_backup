              <calculation class='tableau' formula='CASE ATTR([Cm Layer 1&amp;2 (group)])&#13;&#10;    WHEN &quot;Previous Month&quot; THEN MAX([Calculation_914230742799179779])&#13;&#10;    WHEN &quot;Churned&quot; THEN SUM([Orders of Selected Month (copy)_1389079029588918282])&#13;&#10;    WHEN &quot;Retained&quot; THEN SUM([Acquisitions (copy)_1568378590137171968])&#13;&#10;    ELSE SUM([Calculation_914230742799028226])&#13;&#10;END&#13;&#10;/ [Calculation_1934296059798851590]' />
            </column>
            <column caption='Tree label tooltip' datatype='string' name='[Calculation_1482528722946732033]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF FIRST()=LAST() THEN Left(DATENAME(&apos;month&apos;,[Parameters].[Parameter 3]), 3)+&quot;-&quot;+DATENAME(&apos;year&apos;,[Parameters].[Parameter 3])&#13;&#10;ELSEIF ATTR([Cm Layer 1&amp;2 (group)]) = &quot;Previous Month&quot; THEN Left(DATENAME(&apos;month&apos;,[Calculation_914230742793347072]), 3)+&quot;-&quot;+DATENAME(&apos;year&apos;,[Calculation_914230742793347072])&#13;&#10;ELSE ATTR([Cm Layer 1&amp;2 (group)])&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Swap' datatype='string' name='[Calculation_1619888511887368192]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 4]' />
            </column>
            <column caption='CM KPI Value' datatype='real' name='[Calculation_1934296059794722818]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN 1 THEN [cm_gmv_eur]&#13;&#10;    WHEN 2 THEN [cm_customer_count]&#13;&#10;    WHEN 3 THEN [cm_orders_count]&#13;&#10;END' />
            </column>
            <column caption='denominator tree' datatype='real' name='[Calculation_1934296059798851590]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3 1]&#13;&#10;    WHEN 0 THEN MAX([Calculation_914230742799179779])&#13;&#10;    WHEN 1 THEN 1&#13;&#10;END' />
            </column>
            <column caption='tree value label' datatype='string' name='[Calculation_1934296059806683144]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3 1]&#13;&#10;WHEN 0 THEN STR(ROUND([Calculation_1389079029560193027]*100,1))+&quot;%&quot;&#13;&#10;WHEN 1 THEN STR(ROUND([Calculation_1389079029560193027]/1000000,2))+&quot;M&quot;&#13;&#10;END' />
            </column>
            <column caption='Swap Reset' datatype='string' name='[Calculation_2336805277618704384]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;L1 base waterfall&quot;' />
            </column>
            <column caption='Previous Month' datatype='datetime' name='[Calculation_914230742793347072]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEADD(&apos;month&apos;, -1, [Parameters].[Parameter 3])' />
            </column>
            <column caption='KPI Value Selected Month' datatype='real' name='[Calculation_914230742799028226]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MONTH([month_date]) = MONTH([Parameters].[Parameter 3]) AND YEAR([month_date]) = YEAR([Parameters].[Parameter 3]) THEN [Calculation_1934296059794722818]&#13;&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column caption='KPI Previous Month Total' datatype='real' name='[Calculation_914230742799179779]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [month_date], [global_entity_id]: SUM(IF [month_date] = [Calculation_914230742793347072]&#13;&#10;                     THEN [Calculation_1934296059794722818]&#13;&#10;                     ELSE 0&#13;&#10;                     END) }' />
            </column>
            <column datatype='string' name='[Cm Layer 1&amp;2 (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[Cm Layer 1 &amp; Cm Layer 2 (Combined)]' new-bin='true'>
                <bin default-name='false' value='&quot;Acquisitions&quot;'>
                  <value>(&quot;New&quot;,&quot;New&quot;)</value>
                  <value>(&quot;New&quot;,&quot;Re-acquired&quot;)</value>
                </bin>
                <bin default-name='false' value='&quot;Churned&quot;'>
                  <value>(&quot;Existing&quot;,&quot;Churned&quot;)</value>
                </bin>
                <bin default-name='false' value='&quot;Previous Month&quot;'>
                  <value>(&quot;Existing&quot;,&quot;Inactive&quot;)</value>
                </bin>
                <bin default-name='false' value='&quot;Reactivated&quot;'>
                  <value>(&quot;Existing&quot;,&quot;Reactivated&quot;)</value>
                </bin>
                <bin default-name='false' value='&quot;Retained&quot;'>
                  <value>(&quot;Existing&quot;,&quot;Retained&quot;)</value>
                </bin>
              </calculation>
            </column>
            <column caption='Churned of Selected Month' datatype='real' name='[Orders of Selected Month (copy)_1389079029588918282]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#13;&#10;    MONTH([month_date]) = MONTH([Parameters].[Parameter 3]) &#13;&#10;    AND YEAR([month_date]) = YEAR([Parameters].[Parameter 3]) &#13;&#10;        THEN -[CM KPI Value (copy)_1934296059797266435]&#13;&#10;ELSE 0&#13;&#10;END' />
