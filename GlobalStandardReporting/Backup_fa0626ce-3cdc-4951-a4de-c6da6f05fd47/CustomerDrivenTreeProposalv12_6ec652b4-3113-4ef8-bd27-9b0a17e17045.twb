              <calculation class='tableau' formula='IF [Calculation_6135310082252402704] &lt; 0 THEN [Calculation_6135310082252402704] ELSE NULL END' />
            </column>
            <column caption='CM KPI Selector' datatype='real' name='[PM KPI Selector (copy)_220043082651029512]' role='measure' type='quantitative'>
