  <worksheets>
    <worksheet name='Acquisitions Tooltip'>
      <table>
        <view>
          <datasources>
            <datasource caption='bima_tableau_customer_tree_summary (rl_mkt) (2)' name='federated.15ltqcc19rvj7i118hpnc16xeykg (copy)' />
            <datasource name='Parameters' />
            <datasource caption='bima_tableau_customer_tree_summary+ (Multiple Connections)' name='federated.153p22p1ywzlbo1djd4ka0wjbf70' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='GMV' caption='KPI Selector' datatype='integer' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='GMV' />
                <alias key='2' value='Customer Count' />
                <alias key='3' value='Orders' />
              </aliases>
            </column>
            <column alias='Relative' caption='impact display' datatype='integer' name='[Parameter 3 1]' param-domain-type='list' role='measure' type='quantitative' value='0'>
              <calculation class='tableau' formula='0' />
              <aliases>
                <alias key='0' value='Relative' />
                <alias key='1' value='Absolute' />
              </aliases>
            </column>
            <column caption='Reporting Month' datatype='date' default-format='*MMMM YYYY' name='[Parameter 3]' param-domain-type='list' role='measure' type='quantitative' value='#2023-09-01#'>
              <calculation class='tableau' formula='#2023-09-01#' />
            </column>
            <column alias='Churned' caption='Swap Tooltip' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Churned&quot;'>
              <calculation class='tableau' formula='&quot;Churned&quot;' />
              <aliases>
                <alias key='&quot;Churned&quot;' value='Churned' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.153p22p1ywzlbo1djd4ka0wjbf70'>
            <column caption='Brand Name' datatype='string' name='[brand_name]' role='dimension' type='nominal' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column-instance column='[brand_name]' derivation='None' name='[none:brand_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[management_entity]' derivation='None' name='[none:management_entity:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.15ltqcc19rvj7i118hpnc16xeykg (copy)'>
            <column caption='Retention' datatype='real' name='[Acquisitions (copy)_1568378590137171968]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Cm Layer 1&amp;2 (group)]&#13;&#10;    WHEN &quot;Retained&quot; THEN [Calculation_914230742799028226]-[Orders of Selected Month (copy)_1568378590137634817]&#13;&#10;END' />
            </column>
            <column caption='PM KPI Value' datatype='real' name='[CM KPI Value (copy)_1934296059797266435]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN 1 THEN [pm_gmv_eur]&#13;&#10;    WHEN 2 THEN [pm_customer_count]&#13;&#10;    WHEN 3 THEN [pm_orders_count]&#13;&#10;END' />
            </column>
            <column caption='Tree Values Negative' datatype='real' name='[CM Layer 2 TEST (copy)_1389079029586219017]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-[Calculation_1389079029560193027]' />
            </column>
            <column caption='Tree Values' datatype='real' name='[Calculation_1389079029560193027]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE ATTR([Cm Layer 1&amp;2 (group)])&#13;&#10;    WHEN &quot;Previous Month&quot; THEN MAX([Calculation_914230742799179779])&#13;&#10;    WHEN &quot;Churned&quot; THEN SUM([Orders of Selected Month (copy)_1389079029588918282])&#13;&#10;    WHEN &quot;Retained&quot; THEN SUM([Acquisitions (copy)_1568378590137171968])&#13;&#10;    ELSE SUM([Calculation_914230742799028226])&#13;&#10;END&#13;&#10;/ [Calculation_1934296059798851590]' />
            </column>
            <column caption='Tree label tooltip' datatype='string' name='[Calculation_1482528722946732033]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF FIRST()=LAST() THEN Left(DATENAME(&apos;month&apos;,[Parameters].[Parameter 3]), 3)+&quot;-&quot;+DATENAME(&apos;year&apos;,[Parameters].[Parameter 3])&#13;&#10;ELSEIF ATTR([Cm Layer 1&amp;2 (group)]) = &quot;Previous Month&quot; THEN Left(DATENAME(&apos;month&apos;,[Calculation_914230742793347072]), 3)+&quot;-&quot;+DATENAME(&apos;year&apos;,[Calculation_914230742793347072])&#13;&#10;ELSE ATTR([Cm Layer 1&amp;2 (group)])&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='CM KPI Value' datatype='real' name='[Calculation_1934296059794722818]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN 1 THEN [cm_gmv_eur]&#13;&#10;    WHEN 2 THEN [cm_customer_count]&#13;&#10;    WHEN 3 THEN [cm_orders_count]&#13;&#10;END' />
            </column>
            <column caption='denominator tree' datatype='real' name='[Calculation_1934296059798851590]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3 1]&#13;&#10;    WHEN 0 THEN MAX([Calculation_914230742799179779])&#13;&#10;    WHEN 1 THEN 1&#13;&#10;END' />
            </column>
            <column caption='tree value label' datatype='string' name='[Calculation_1934296059806683144]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3 1]&#13;&#10;WHEN 0 THEN STR(ROUND([Calculation_1389079029560193027]*100,1))+&quot;%&quot;&#13;&#10;WHEN 1 THEN STR(ROUND([Calculation_1389079029560193027]/1000000,2))+&quot;M&quot;&#13;&#10;END' />
            </column>
            <column caption='Swap Reset' datatype='string' name='[Calculation_2336805277618704384]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;L1 base waterfall&quot;' />
            </column>
            <column caption='Tooltip Selector' datatype='string' name='[Calculation_2336805277623861249]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#13;&#10;   WHEN &quot;Churned&quot; THEN &apos;Churned Tooltip&apos;&#13;&#10;   WHEN &quot;Acquisitions&quot; THEN &apos;Acquisitions Tooltip&apos;&#13;&#10;   WHEN &quot;Reactivated&quot; THEN &apos;Reactivated Tooltip&apos;&#13;&#10;   WHEN &quot;Retained&quot; THEN &apos;Retained Tooltip&apos;&#13;&#10;END' />
            </column>
            <column caption='Previous Month' datatype='datetime' name='[Calculation_914230742793347072]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEADD(&apos;month&apos;, -1, [Parameters].[Parameter 3])' />
            </column>
            <column caption='KPI Value Selected Month' datatype='real' name='[Calculation_914230742799028226]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MONTH([month_date]) = MONTH([Parameters].[Parameter 3]) AND YEAR([month_date]) = YEAR([Parameters].[Parameter 3]) THEN [Calculation_1934296059794722818]&#13;&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column caption='KPI Previous Month Total' datatype='real' name='[Calculation_914230742799179779]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [month_date], [global_entity_id]: SUM(IF [month_date] = [Calculation_914230742793347072]&#13;&#10;                     THEN [Calculation_1934296059794722818]&#13;&#10;                     ELSE 0&#13;&#10;                     END) }' />
            </column>
            <column datatype='string' name='[Cm Layer 1&amp;2 (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[Cm Layer 1 &amp; Cm Layer 2 (Combined)]' new-bin='true'>
                <bin default-name='false' value='&quot;Acquisitions&quot;'>
                  <value>(&quot;New&quot;,&quot;New&quot;)</value>
                  <value>(&quot;New&quot;,&quot;Re-acquired&quot;)</value>
                </bin>
                <bin default-name='false' value='&quot;Churned&quot;'>
                  <value>(&quot;Existing&quot;,&quot;Churned&quot;)</value>
                </bin>
                <bin default-name='false' value='&quot;Previous Month&quot;'>
                  <value>(&quot;Existing&quot;,&quot;Inactive&quot;)</value>
                </bin>
                <bin default-name='false' value='&quot;Reactivated&quot;'>
                  <value>(&quot;Existing&quot;,&quot;Reactivated&quot;)</value>
                </bin>
                <bin default-name='false' value='&quot;Retained&quot;'>
                  <value>(&quot;Existing&quot;,&quot;Retained&quot;)</value>
                </bin>
              </calculation>
