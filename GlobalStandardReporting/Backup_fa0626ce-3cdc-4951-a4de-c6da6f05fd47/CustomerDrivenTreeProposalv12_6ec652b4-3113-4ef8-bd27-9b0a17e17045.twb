      <column caption='Retention' datatype='real' name='[Acquisitions (copy)_1568378590137171968]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Cm Layer 1&amp;2 (group)]&#13;&#10;    WHEN &quot;Retained&quot; THEN [Calculation_914230742799028226]-[Orders of Selected Month (copy)_1568378590137634817]&#13;&#10;END' />
      </column>
      <column caption='PM KPI Value' datatype='real' name='[CM KPI Value (copy)_1934296059797266435]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN 1 THEN [pm_gmv_eur]&#13;&#10;    WHEN 2 THEN [pm_customer_count]&#13;&#10;    WHEN 3 THEN [pm_orders_count]&#13;&#10;END' />
