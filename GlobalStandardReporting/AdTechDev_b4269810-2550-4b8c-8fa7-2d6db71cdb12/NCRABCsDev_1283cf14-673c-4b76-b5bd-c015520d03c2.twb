            </column>
            <column caption='YoY Active Advertisers' datatype='real' default-format='*▲#%;▼-#%;' name='[MoM Active Advertisers (copy)_3040070552446062596]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if LAST()=1 then (sum(ZN([active_advertiser])) / LOOKUP(sum(ZN([active_advertiser])), -12))-1 END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='MoM Active Advertisers' datatype='real' default-format='*▲#%;▼-#%;' name='[MoM Cpc Budget Achieved pp. (copy)_3040070552424034305]' role='measure' type='quantitative'>
