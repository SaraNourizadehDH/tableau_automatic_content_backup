              <calculation class='tableau' formula='if LAST()=1 then ZN(IF [MoM Cpc Budget Achieved pp. (copy)_3040070552424034305] &lt;0 then [MoM Cpc Budget Achieved pp. (copy)_3040070552424034305] END) END'>
                <table-calc ordering-type='Rows' />
