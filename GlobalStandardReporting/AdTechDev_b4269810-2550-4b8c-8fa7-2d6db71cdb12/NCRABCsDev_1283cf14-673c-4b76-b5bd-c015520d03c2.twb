            <column caption='Revenue per Advertiser last month' datatype='real' name='[Active Advertisers last month (copy)_3040070552454275082]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if LAST()=1 then [Calculation_3040070552451579911] END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Revenue per Advertiser' datatype='real' name='[Calculation_3040070552451579911]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([total_ncr_revenue]))/sum(ZN([active_advertiser]))' />
            </column>
            <column caption='last periodth' datatype='boolean' name='[Calculation_5882967779386351632]' role='measure' type='nominal'>
