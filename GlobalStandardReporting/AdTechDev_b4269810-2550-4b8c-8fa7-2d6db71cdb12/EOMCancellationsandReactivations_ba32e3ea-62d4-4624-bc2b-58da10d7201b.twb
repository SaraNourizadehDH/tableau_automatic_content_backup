      <aliases enabled='yes' />
      <column caption='Reactivation %' datatype='real' default-format='p0%' name='[Calculation_3326963887660580864]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([reactivations]) / SUM([cancellations_from_26])' />
      </column>
      <column caption='Cancellation %' datatype='real' default-format='p0%' name='[Calculation_3326963887667499010]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cancellations_from_26]) / SUM([vendors])' />
      </column>
      <column caption='Cancellations or Reactivations' datatype='integer' name='[Calculation_3326963887687983107]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;Cancellations&quot; THEN SUM([cancellations_from_26])&#10;ELSE SUM([reactivations])&#10;END' />
      </column>
      <column caption='Auto Biding, ROAS, UTR' datatype='string' name='[Calculation_3326963887759560713]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &quot;Auto Biding&quot; THEN STR([is_auto_biding])&#10;ELSEIF [Parameters].[Parameter 3] = &quot;ROAS&quot; THEN [roas]&#10;ELSEIF [Parameters].[Parameter 3] = &quot;UTR&quot; THEN [utr]&#10;END' />
      </column>
      <column caption='Budget Cancelled %' datatype='real' default-format='p0%' name='[Cancellation % (copy)_3326963887749644293]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([budget_cancelled]) / SUM([budget])' />
      </column>
      <column caption='Budget cancelled or recovered %' datatype='real' default-format='p0%' name='[Cancellations or Reactivations % (copy)_3326963887754252296]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;Cancellations&quot; THEN [Cancellation % (copy)_3326963887749644293]&#10;ELSE [Reactivation % (copy)_3326963887753981958]&#10;END' />
      </column>
      <column caption='Cancellations or Reactivations %' datatype='real' default-format='p0%' name='[Cancellations or Reactivations (copy)_3326963887688171524]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;Cancellations&quot; THEN [Calculation_3326963887667499010]&#10;ELSE [Calculation_3326963887660580864]&#10;END' />
      </column>
      <column caption='Budget cancelled or recovered' datatype='real' default-format='c#,##0&quot; €&quot;;-#,##0&quot; €&quot;' name='[Cancellations or Reactivations (copy)_3326963887754108935]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;Cancellations&quot; THEN SUM([budget_cancelled])&#10;ELSE SUM([budget_recovered])&#10;END' />
      </column>
      <column caption='Budget recovered %' datatype='real' default-format='p0%' name='[Reactivation % (copy)_3326963887753981958]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([budget_recovered]) / SUM([budget_cancelled])' />
      </column>
