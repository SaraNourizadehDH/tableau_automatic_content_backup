            <column caption='cf_new_customers_ratio' datatype='real' default-format='p0.0%' name='[Calculation_2413084977381281796]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MEDIAN([customers_new])/MEDIAN([customers_all])' />
            </column>
