      <column caption='cf_new_customers_ratio' datatype='real' default-format='p0.0%' name='[Calculation_2413084977381281796]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MEDIAN([customers_new])/MEDIAN([customers_all])' />
      </column>
      <column caption='corr_gmv' datatype='real' name='[Calculation_2437432628767387649]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CORR([gmv_eur_incentive], [gmv_eur_all])' />
      </column>
      <column caption='corr_wind_gmv' datatype='real' name='[Calculation_2437432628799176707]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_CORR(sum([gmv_eur_incentive]), sum([gmv_eur_all]), -1,0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='customers_all_mom_growth_cmgr' datatype='real' default-format='p0.00%' name='[Calculation_3030429970363310081]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='POWER(&#10;    (&#10;        SUM(IF [date_month] = { EXCLUDE [date_month]: MAX([date_month])} THEN [customers_all] END)&#10;        /&#10;        SUM(IF [date_month] = { EXCLUDE [date_month]: MIN([date_month])} THEN [customers_all] END)&#10;    ),&#10;    (1 / COUNTD([date_month]))&#10;) - 1' />
      </column>
      <column caption='cf_net_customer_growth_value' datatype='integer' name='[Calculation_3949445769363083265]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[customers_new] - ([customers_all_previous]-([customers_all] - [customers_new]))' />
      </column>
      <column caption='gmv_eur_all_pct_change' datatype='real' default-format='p0.00%' name='[Calculation_3949445769430167556]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(([gmv_eur_all]-[gmv_eur_all_previous])/[gmv_eur_all_previous])' />
      </column>
      <column caption='same_months' datatype='boolean' name='[Calculation_3949445769441034246]' role='measure' type='nominal'>
        <calculation class='tableau' formula='countd([date_month]) = ATTR({FIXED :COUNTD([date_month])})' />
      </column>
      <column caption='cf_discount_incentives_ratio' datatype='real' default-format='p0.0%' name='[Calculation_3949445770079059982]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[discount_total_eur]/[total_incentives_eur]' />
      </column>
      <column caption='cf_metric_1' datatype='real' name='[Calculation_4973522169401196555]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;    when &apos;gmv_eur_all_orders&apos; then [gmv_eur_all]&#10;    when &apos;gmv_eur_regular_orders&apos; then [gmv_eur_regular]&#10;    when &apos;gmv_eur_incentives_orders&apos; then [gmv_eur_incentive]&#10;    when &apos;gmv_local_all_orders&apos; then [gmv_local_all]&#10;    when &apos;gmv_local_regular_orders&apos; then [gmv_local_regular]&#10;    when &apos;gmv_local_incentives_orders&apos; then [gmv_local_incentive]&#10;    when &apos;order_all&apos; then [orders_all]&#10;    when &apos;order_regular&apos; then [orders_regular]&#10;    when &apos;order_incentives&apos; then [orders_incentive]&#10;    when &apos;aov_gmv_regular&apos; then [aov_gmv_regular_orders]&#10;    when &apos;aov_gmv_incentives&apos; then [aov_gmv_incentive_orders]&#10;    when &apos;customers_all&apos; then [customers_all]&#10;    when &apos;customers_all_incentives&apos; then [customers_all_w_incentives]&#10;    when &apos;customers_new&apos; then [customers_new]&#10;    when &apos;customers_new_w_incentives&apos; then [customers_new_w_incentives]&#10;    when &apos;customers_new_first_order_w_incentives&apos; then [customers_new_first_order_w_incentives]&#10;    when &apos;vendors_w_active_incentives&apos; then [vendors_with_active_incentives]&#10;    when &apos;incentive_perc_median&apos; then [incentive_perc_median]&#10;    when &apos;total_incentives_eur&apos; then [total_incentives_eur]&#10;    when &apos;total_incentives_local&apos; then [total_incentives_local]&#10;    when &apos;orders_per_customer_median&apos; then [orders_per_customer_median]&#10;    when &apos;orders_w_incentives_per_customer_median&apos; then [orders_w_incentives_per_customer_median]&#10;    when &apos;days_since_last_order_median&apos; then [days_since_last_order_median]&#10;    when &apos;days_since_last_incentive_median&apos; then [days_since_last_incentive_median]&#10;    when &apos;customers_old_first_incentive&apos; then [customers_old_first_incentive]&#10;    when &apos;orders_regular_per_customer_median&apos; then [orders_regular_per_customer_median]&#10;    when &apos;orders_w_incentives_per_customer_median&apos; then [orders_w_incentives_per_customer_median]&#10;    when &apos;incentive_acquired_customer&apos; then [incentive_acquired_customer]&#10;    when &apos;incentive_acquired_customer_total_incentives&apos; then [incentive_acquired_customer_total_incentives]&#10;    when &apos;regular_customer_gmv&apos; then [regular_customer_gmv]&#10;    when &apos;regular_customer&apos; then [regular_customer]&#10;    when &apos;gmv_eur_all_mom_growth&apos; then [gmv_eur_all_mom_growth]&#10;    when &apos;cf_new_customers_w_incentives_ratio_new_customers&apos; then [cf_new_customers_w_incentives_ratio (copy)_6428114415122096128]&#10;    when &apos;cf_total_incentives_eur_pe_ratio&apos; then [cf_total_incentives_eur_am_ratio (copy)_6758917881808166915]&#10;end' />
      </column>
      <column caption='cf_win_corr_metric1_x_metric2' datatype='real' name='[Calculation_4973522169403465741]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_CORR(MEDIAN([Calculation_4973522169401196555]), median([cf_metric_1 (copy)_4973522169403355148]), -[Parameters].[Parameter 2],0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='cf_customers_cohort' datatype='real' name='[Calculation_4973522169447338005]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 3]&#10;    when false then sum([customers_with_incentives_orders_cohort])&#10;    else sum(&#10;end' />
      </column>
      <column caption='key_city' datatype='string' name='[Calculation_548665099339804673]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[global_entity_id] + &apos;-&apos; + [city]' />
      </column>
      <column caption='total_incentives_eur_log' datatype='real' name='[Calculation_548665099872956418]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='log([total_incentives_eur])' />
      </column>
      <column caption='gmv_eur_all_log' datatype='real' name='[Calculation_548665099874426883]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='log([gmv_eur_all])' />
      </column>
      <column caption='gmv_eur_mom_growth_log' datatype='real' name='[Calculation_548665099875057668]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='log([gmv_eur_all_mom_growth])' />
      </column>
      <column caption='gmv_eur_mom_growth_sqrt' datatype='real' name='[Calculation_548665099876577285]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SQRT([Calculation_548665099875057668])' />
      </column>
      <column caption='gmv_eur_all_mom_growth_log_avg_aggr' datatype='real' name='[Calculation_548665099879702537]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='log(median([gmv_eur_all_mom_growth]))' />
      </column>
      <column caption='incentives_over_gmc_log' datatype='real' name='[Calculation_548665099880296459]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='log(median([cf_orders_per_customers (copy 2)_3949445769359638528])*100)' />
      </column>
      <column caption='gmv_eur_all_mom_growth_values_avg' datatype='real' name='[Calculation_548665100034543672]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [Calculation_548665099339804673]: avg([gmv_eur_all_mom_growth_values])}' />
      </column>
      <column caption='had_incentives' datatype='boolean' name='[Calculation_548665100059652171]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[total_incentives_eur] &gt; 0' />
      </column>
      <column caption='is_platform_growing' datatype='boolean' name='[Calculation_548665100060090444]' role='measure' type='nominal'>
        <calculation class='tableau' formula='MEDIAN([Calculation_3949445769430167556]) &gt; 0' />
      </column>
      <column caption='cf_orders_per_customers' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_548665100093096015]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[orders_all]/[customers_all]' />
      </column>
      <column caption='cf_acquire_customer_total_incentive_ratio' datatype='real' default-format='p0.0%' name='[Calculation_6428114415292534787]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[customers_new_first_order_w_incentives_total_incentives]/[total_incentives_eur]' />
      </column>
      <column caption='cf_customers_old_with_incentives_total_incentives_ration' datatype='real' default-format='p0.0%' name='[Calculation_6428114415294238724]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[customers_old_with_incentives_total_incentives]/[total_incentives_eur]' />
      </column>
      <column caption='cf_orders_fm_ration' datatype='real' default-format='p0.0%' name='[Calculation_6758917881805438976]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[orders_fm]/[orders_incentive]' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='vfd_gmv_growth_aggr' datatype='table' name='[__tableau_internal_object_id__].[vfd_gmv_growth_aggr_E0B30279AA8D402EB4C7D978F87E084B]' role='measure' type='quantitative' />
      <_.fcp.ObjectModelTableType.true...column caption='vfd_gmv_growth_aggr_clv' datatype='table' name='[__tableau_internal_object_id__].[vfd_gmv_growth_aggr_clv_7E3C2E721318428BAA3EA3B6BC0417A6]' role='measure' type='quantitative' />
      <column datatype='real' default-format='p0.0%' name='[aaov_gmv_all_median_mom_growth]' role='measure' type='quantitative' />
