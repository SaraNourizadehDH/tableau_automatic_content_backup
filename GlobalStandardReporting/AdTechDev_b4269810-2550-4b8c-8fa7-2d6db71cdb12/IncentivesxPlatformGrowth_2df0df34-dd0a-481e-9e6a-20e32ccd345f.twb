            <column caption='cf_total_incentives_eur_pe_ratio' datatype='real' default-format='p0.0%' name='[cf_total_incentives_eur_am_ratio (copy)_6758917881808166915]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_incentives_eur_pe]/[total_incentives_eur]' />
