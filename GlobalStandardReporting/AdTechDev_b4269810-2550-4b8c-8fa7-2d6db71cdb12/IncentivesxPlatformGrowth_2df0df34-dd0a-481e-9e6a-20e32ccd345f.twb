      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='adhoc_vfd_gmv_growth_aggr (analytics)' name='federated.1eyh3c40gggs5n10v1t0218kzsf1' />
          </datasources>
          <datasource-dependencies datasource='federated.1eyh3c40gggs5n10v1t0218kzsf1'>
            <column caption='gmv_eur_all_pct_change' datatype='real' default-format='p0.00%' name='[Calculation_3949445769430167556]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(([gmv_eur_all]-[gmv_eur_all_previous])/[gmv_eur_all_previous])' />
            </column>
            <column caption='cf_discount_incentives_ratio' datatype='real' default-format='p0.0%' name='[Calculation_3949445770079059982]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[discount_total_eur]/[total_incentives_eur]' />
            </column>
            <column caption='key_city' datatype='string' name='[Calculation_548665099339804673]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[global_entity_id] + &apos;-&apos; + [city]' />
            </column>
            <column caption='had_incentives' datatype='boolean' name='[Calculation_548665100059652171]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[total_incentives_eur] &gt; 0' />
            </column>
            <column caption='is_platform_growing' datatype='boolean' name='[Calculation_548665100060090444]' role='measure' type='nominal'>
              <calculation class='tableau' formula='MEDIAN([Calculation_3949445769430167556]) &gt; 0' />
            </column>
            <column caption='cf_orders_per_customers' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_548665100093096015]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[orders_all]/[customers_all]' />
            </column>
            <column caption='cf_acquire_customer_total_incentive_ratio' datatype='real' default-format='p0.0%' name='[Calculation_6428114415292534787]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[customers_new_first_order_w_incentives_total_incentives]/[total_incentives_eur]' />
            </column>
            <column caption='cf_customers_old_with_incentives_total_incentives_ration' datatype='real' default-format='p0.0%' name='[Calculation_6428114415294238724]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[customers_old_with_incentives_total_incentives]/[total_incentives_eur]' />
            </column>
            <column caption='cf_orders_fm_ration' datatype='real' default-format='p0.0%' name='[Calculation_6758917881805438976]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[orders_fm]/[orders_incentive]' />
            </column>
            <column datatype='real' default-format='p0.0%' name='[aaov_gmv_all_median_mom_growth]' role='measure' type='quantitative' />
            <column datatype='real' default-format='C1031%' name='[aov_gmv_all_median]' role='measure' type='quantitative' />
            <column datatype='real' default-format='C1031%' name='[aov_gmv_incentive_orders]' role='measure' type='quantitative' />
            <column datatype='real' default-format='C1031%' name='[aov_gmv_regular_orders]' role='measure' type='quantitative' />
            <column datatype='string' name='[brand]' role='dimension' type='nominal' />
            <column caption='cf_voucher_incentives_ratio' datatype='real' default-format='p0.0%' name='[cf_discount_incentives_ratio (copy)_3949445770080325647]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[voucher_total_eur]/[total_incentives_eur]' />
            </column>
            <column caption='cf_joker_incentives_ratio' datatype='real' default-format='p0.0%' name='[cf_discount_incentives_ratio (copy)_3949445770080432144]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[joker_customer_discount_eur]/[total_incentives_eur]' />
            </column>
            <column caption='cf_vouchers_orders_share' datatype='real' default-format='p0.0%' name='[cf_discount_orders_share (copy)_5779103487451791361]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([orders_voucher]/[orders_incentive])' />
            </column>
            <column caption='cf_joker_orders_share' datatype='real' default-format='p0.0%' name='[cf_discount_orders_share (copy)_5779103487451942914]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([orders_joker]/[orders_incentive])' />
            </column>
            <column caption='cf_aov_incentives_diff' datatype='real' default-format='p0.0%' name='[cf_discount_orders_share (copy)_6428114415129563137]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(MEDIAN([aov_gmv_incentive_orders])/median([aov_gmv_regular_orders]))-1' />
            </column>
            <column caption='cf_customers_w_incentives_ratio' datatype='real' default-format='p0.0%' name='[cf_incentives_orders_ratio (copy)_3949445769737961484]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[customers_all_w_incentives]/[customers_all]' />
            </column>
            <column caption='cf_discount_orders_share' datatype='real' default-format='p0.0%' name='[cf_incentives_orders_share (copy)_5779103487451660288]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([orders_discount]/[orders_incentive])' />
            </column>
            <column caption='cf_free_delivery_orders_share' datatype='real' default-format='p0.0%' name='[cf_joker_orders_share (copy)_5779103487453089795]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([orders_free_delivery]/[orders_all])' />
            </column>
            <column caption='cf_replacement_rate' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[cf_net_customer_growth (copy)_5804225129151684608]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[customers_new]&#10;/&#10;(&#10;    if  ([customers_all] - [customers_new]) &gt; [customers_all_previous] then [customers_new] else&#10;        ([customers_all_previous] - ([customers_all] - [customers_new]))&#10;    end&#10;)' />
            </column>
            <column caption='cf_incentives_orders_ratio' datatype='real' default-format='p0.0%' name='[cf_new_customers_ratio (copy)_2413084977382195205]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MEDIAN([orders_incentive])/MEDIAN([orders_all])' />
            </column>
            <column caption='cf_new_customers_w_incentives_ratio_new_customers' datatype='real' default-format='p0.0%' name='[cf_new_customers_w_incentives_ratio (copy)_6428114415122096128]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[customers_new_first_order_w_incentives]/[customers_new]' />
