        <calculation class='tableau' formula='case [Parameters].[p_corr_metric_1 (copy)_4973522169410121742]&#10;    when &apos;gmv_eur_all_orders&apos; then [gmv_eur_all]&#10;    when &apos;gmv_eur_regular_orders&apos; then [gmv_eur_regular]&#10;    when &apos;gmv_eur_incentives_orders&apos; then [gmv_eur_incentive]&#10;    when &apos;gmv_local_all_orders&apos; then [gmv_local_all]&#10;    when &apos;gmv_local_regular_orders&apos; then [gmv_local_regular]&#10;    when &apos;gmv_local_incentives_orders&apos; then [gmv_local_incentive]&#10;    when &apos;order_all&apos; then [orders_all]&#10;    when &apos;order_regular&apos; then [orders_regular]&#10;    when &apos;order_incentives&apos; then [orders_incentive]&#10;    when &apos;aov_gmv_regular&apos; then [aov_gmv_regular_orders]&#10;    when &apos;aov_gmv_incentives&apos; then [aov_gmv_incentive_orders]&#10;    when &apos;customers_all&apos; then [customers_all]&#10;    when &apos;customers_all_incentives&apos; then [customers_all_w_incentives]&#10;    when &apos;customers_new&apos; then [customers_new]&#10;    when &apos;customers_new_w_incentives&apos; then [customers_new_w_incentives]&#10;    when &apos;customers_new_first_order_w_incentives&apos; then [customers_new_first_order_w_incentives]&#10;    when &apos;vendors_w_active_incentives&apos; then [vendors_with_active_incentives]&#10;    when &apos;incentive_perc_median&apos; then [incentive_perc_median]&#10;    when &apos;total_incentives_eur&apos; then [total_incentives_eur]&#10;    when &apos;total_incentives_local&apos; then [total_incentives_local]&#10;    when &apos;orders_per_customer_median&apos; then [orders_per_customer_median]&#10;    when &apos;orders_w_incentives_per_customer_median&apos; then [orders_w_incentives_per_customer_median]&#10;    when &apos;days_since_last_order_median&apos; then [days_since_last_order_median]&#10;    when &apos;days_since_last_incentive_median&apos; then [days_since_last_incentive_median]&#10;    when &apos;customers_old_first_incentive&apos; then [customers_old_first_incentive]&#10;    when &apos;orders_regular_per_customer_median&apos; then [orders_regular_per_customer_median]&#10;    when &apos;orders_w_incentives_per_customer_median&apos; then [orders_w_incentives_per_customer_median]&#10;    when &apos;incentive_acquired_customer&apos; then [incentive_acquired_customer]&#10;    when &apos;incentive_acquired_customer_total_incentives&apos; then [incentive_acquired_customer_total_incentives]&#10;    when &apos;regular_customer_gmv&apos; then [regular_customer_gmv]&#10;    when &apos;regular_customer&apos; then [regular_customer]&#10;    when &apos;gmv_eur_all_mom_growth&apos; then [gmv_eur_all_mom_growth]&#10;    when &apos;cf_new_customers_w_incentives_ratio_new_customers&apos; then [cf_new_customers_w_incentives_ratio (copy)_6428114415122096128]&#10;    when &apos;cf_total_incentives_eur_pe_ratio&apos; then [cf_total_incentives_eur_am_ratio (copy)_6758917881808166915]&#10;end' />
      </column>
      <column caption='cf_replacement_rate' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[cf_net_customer_growth (copy)_5804225129151684608]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[customers_new]&#10;/&#10;(&#10;    if  ([customers_all] - [customers_new]) &gt; [customers_all_previous] then [customers_new] else&#10;        ([customers_all_previous] - ([customers_all] - [customers_new]))&#10;    end&#10;)' />
      </column>
      <column caption='cf_net_customer_growth' datatype='real' default-format='p0.00%' name='[cf_net_customer_growth_value (copy)_3949445769374765058]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;    ([customers_all_previous] + ([customers_new] - ([customers_all_previous]-([customers_all] - [customers_new]))))&#10;    /&#10;    [customers_all_previous]&#10;) - 1' />
