              <calculation class='tableau' formula='[orders_il]/[orders_incentive]' />
            </column>
            <column caption='cf_total_incentives_eur_am_ratio' datatype='real' default-format='p0.0%' name='[cf_orders_fm_ration (copy)_6758917881807581186]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_incentives_eur_am]/[total_incentives_eur]' />
