          <member value='&quot;Eur&quot;' />
          <member value='&quot;Local&quot;' />
        </members>
      </column>
      <column caption='Top' datatype='integer' name='[Parameter 6]' param-domain-type='range' role='measure' type='quantitative' value='100'>
