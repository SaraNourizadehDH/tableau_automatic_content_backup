    <datasource hasconnection='false' inline='true' name='Parameters' version='18.1'>
      <aliases enabled='yes' />
      <column caption='No. σ desviations' datatype='integer' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='6'>
        <calculation class='tableau' formula='6' />
        <range granularity='1' max='6' min='1' />
      </column>
      <column alias='Exclude canceled budget' caption='Canceled Budget' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Exclude&quot;'>
        <calculation class='tableau' formula='&quot;Exclude&quot;' />
        <aliases>
          <alias key='&quot;Exclude&quot;' value='Exclude canceled budget' />
          <alias key='&quot;Include&quot;' value='Include canceled budget' />
        </aliases>
        <members>
          <member alias='Exclude canceled budget' value='&quot;Exclude&quot;' />
          <member alias='Include canceled budget' value='&quot;Include&quot;' />
        </members>
      </column>
      <column alias='Exclude' caption='Outliers Bookings Budget' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Non outliers&quot;'>
        <calculation class='tableau' formula='&quot;Non outliers&quot;' />
        <aliases>
          <alias key='&quot;All&quot;' value='Include' />
          <alias key='&quot;Non outliers&quot;' value='Exclude' />
        </aliases>
        <members>
          <member alias='Exclude' value='&quot;Non outliers&quot;' />
          <member alias='Include' value='&quot;All&quot;' />
        </members>
      </column>
      <column caption='Number of periods' datatype='integer' name='[Parameter 4]' param-domain-type='range' role='measure' type='quantitative' value='3'>
        <calculation class='tableau' formula='3' />
        <range granularity='1' max='12' min='1' />
