          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='v_tableau_user_global_entity_id (analytics)' name='federated.12dem5f0rnyfot10qun9c0nmxkff' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='KPI' datatype='string' name='[Status (Ab Tests Tableau) Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;CTR&quot;'>
              <calculation class='tableau' formula='&quot;CTR&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.12dem5f0rnyfot10qun9c0nmxkff'>
            <column caption='KPI ' datatype='real' name='[Calculation_2970335063920750592]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Status (Ab Tests Tableau) Parameter] WHEN &apos;CTR&apos; THEN SUM([num_clicks])/SUM([num_requests])&#10;         WHEN &apos;CVR (o/c)&apos; THEN SUM([num_orders])/SUM([num_clicks])&#10;         WHEN &apos;CVR (o/r)&apos; THEN SUM([num_orders])/SUM([num_requests])&#10;         WHEN &apos;CPC Revenue&apos; THEN SUM([cpc_revenue_eur])&#10;         WHEN &apos;GMV&apos; THEN SUM([gmv_eur])&#10;END' />
            </column>
            <column caption='Strategy + Country' datatype='string' name='[Calculation_641481479247675392]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[strategy] + &apos; &apos; + [country]' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
