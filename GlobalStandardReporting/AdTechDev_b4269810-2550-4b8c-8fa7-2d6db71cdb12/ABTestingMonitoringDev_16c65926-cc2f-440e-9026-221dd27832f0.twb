      <column caption='Commission Price' datatype='real' name='[CTR (copy)_4147674525997477889]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([commission_eur])/SUM([num_orders])' />
      </column>
      <column caption='CTR' datatype='real' name='[Calculation_1478236211227914240]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_clicks])/SUM([num_requests])' />
      </column>
      <column caption='CVR (o/c)' datatype='real' name='[Calculation_1478236211227992065]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_orders])/SUM([num_clicks])' />
      </column>
      <column caption='CVR (o/r)' datatype='real' name='[Calculation_1478236211228049410]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_orders])/SUM([num_requests])' />
      </column>
      <column caption='ROAS' datatype='real' name='[Calculation_1478236211228114947]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(SUM([gmv_eur])/SUM([cpc_revenue_eur]),0)' />
      </column>
      <column caption='Order Value' datatype='real' name='[Calculation_1478236211228180484]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(SUM([gmv_eur])/SUM([num_orders]),0)' />
      </column>
      <column caption='CPC Price' datatype='real' name='[Calculation_1478236211228286981]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cpc_revenue_eur])/SUM([num_clicks])' />
      </column>
      <column caption='KPI ' datatype='real' name='[Calculation_2970335063920750592]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Status (Ab Tests Tableau) Parameter] WHEN &apos;CTR&apos; THEN SUM([num_clicks])/SUM([num_requests])&#10;         WHEN &apos;CVR (o/c)&apos; THEN SUM([num_orders])/SUM([num_clicks])&#10;         WHEN &apos;CVR (o/r)&apos; THEN SUM([num_orders])/SUM([num_requests])&#10;         WHEN &apos;CPC Revenue&apos; THEN SUM([cpc_revenue_eur])&#10;         WHEN &apos;GMV&apos; THEN SUM([gmv_eur])&#10;END' />
      </column>
      <column caption='Order Cancellation Rate' datatype='real' name='[Calculation_4323385292107923457]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cancelled_orders])/SUM([all_orders])' />
      </column>
      <column caption='Blank' datatype='string' name='[Calculation_4323385294564921346]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;&quot;' />
      </column>
      <column caption='Color Test' datatype='string' name='[Calculation_5026439400682377217]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [uplift_variant_1] &gt; 0 AND [uplift_variant_1] &gt; [uplift_variant_2] &#10;        THEN &apos;Green&apos;&#10;   ELSEIF [uplift_variant_2] &gt; 0 AND [uplift_variant_2] &gt; [uplift_variant_1]&#10;        THEN &apos;Green&apos;&#10;END' />
      </column>
      <column caption='Commission' datatype='real' name='[Calculation_5026439400709746690]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([commission_eur],0)' />
      </column>
      <column caption='Variant 2 Requests' datatype='integer' name='[Calculation_5026439400711155716]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([variant_2_requests],0)' />
