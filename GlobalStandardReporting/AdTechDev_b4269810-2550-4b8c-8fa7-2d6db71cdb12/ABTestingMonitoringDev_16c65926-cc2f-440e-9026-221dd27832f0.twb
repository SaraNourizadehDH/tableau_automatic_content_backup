            <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column caption='Entity' datatype='string' name='[entity]' role='dimension' type='nominal' />
            <column caption='Gmv Eur' datatype='real' name='[gmv_eur]' role='measure' type='quantitative' />
