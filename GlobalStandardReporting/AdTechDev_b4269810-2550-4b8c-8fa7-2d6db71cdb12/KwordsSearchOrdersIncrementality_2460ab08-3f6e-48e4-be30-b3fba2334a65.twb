      </column>
      <column caption='Clicks % change bin' datatype='string' name='[Calculation_1940136709116583936]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [orders_per_day_prev_month_diff] &lt;= -0.75 THEN &quot;-100% to -75%&quot;&#10;ELSEIF [clicks_per_day_prev_month_diff] &lt;= -0.50 THEN &quot;-75% to -50%&quot;&#10;ELSEIF [clicks_per_day_prev_month_diff] &lt;= -0.25 THEN &quot;-50% to -25%&quot;&#10;ELSEIF [clicks_per_day_prev_month_diff] &lt;= -0.05 THEN &quot;-25% to -5%&quot;&#10;ELSEIF [clicks_per_day_prev_month_diff] &lt;= 0.05 THEN &quot;No change&quot;&#10;ELSEIF [clicks_per_day_prev_month_diff] &lt;= 0.25 THEN &quot;5% to 25%&quot;&#10;ELSEIF [clicks_per_day_prev_month_diff] &lt;= 0.5 THEN &quot;25% to 50%&quot;&#10;ELSEIF [clicks_per_day_prev_month_diff] &lt;= 0.75 THEN &quot;50% to 75%&quot;&#10;ELSEIF [clicks_per_day_prev_month_diff] &lt;= 1 THEN &quot;75% to 100%&quot;&#10;ELSEIF [clicks_per_day_prev_month_diff] &lt;= 2 THEN &quot;100% to 200%&quot;&#10;ELSEIF [clicks_per_day_prev_month_diff] &lt;= 5 THEN &quot;200% to 500%&quot;&#10;ELSEIF [clicks_per_day_prev_month_diff] &gt; 5 THEN &quot;500%+&quot;&#10;END' />
      </column>
      <column caption='Organic clicks % change bin' datatype='string' name='[Calculation_1940136709142568964]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [organic_post_to_pre_ratio] - 1 &lt;= -0.75 THEN &quot;-100% to -75%&quot;&#10;ELSEIF [organic_post_to_pre_ratio (sl_clicks_incrementality_w_type)] - 1 &lt;= -0.50 THEN &quot;-75% to -50%&quot;&#10;ELSEIF [organic_post_to_pre_ratio (sl_clicks_incrementality_w_type)] - 1 &lt;= -0.25 THEN &quot;-50% to -25%&quot;&#10;ELSEIF [organic_post_to_pre_ratio (sl_clicks_incrementality_w_type)] - 1 &lt;= -0.05 THEN &quot;-25% to -5%&quot;&#10;ELSEIF [organic_post_to_pre_ratio (sl_clicks_incrementality_w_type)] - 1 &lt;= 0.05 THEN &quot;No change&quot;&#10;ELSEIF [organic_post_to_pre_ratio (sl_clicks_incrementality_w_type)] - 1 &lt;= 0.25 THEN &quot;5% to 25%&quot;&#10;ELSEIF [organic_post_to_pre_ratio (sl_clicks_incrementality_w_type)] - 1 &lt;= 0.5 THEN &quot;25% to 50%&quot;&#10;ELSEIF [organic_post_to_pre_ratio (sl_clicks_incrementality_w_type)] - 1 &lt;= 0.75 THEN &quot;50% to 75%&quot;&#10;ELSEIF [organic_post_to_pre_ratio (sl_clicks_incrementality_w_type)] - 1 &lt;= 1 THEN &quot;75% to 100%&quot;&#10;ELSEIF [organic_post_to_pre_ratio (sl_clicks_incrementality_w_type)] - 1 &lt;= 2 THEN &quot;100% to 200%&quot;&#10;ELSEIF [organic_post_to_pre_ratio (sl_clicks_incrementality_w_type)] - 1 &lt;= 5 THEN &quot;200% to 500%&quot;&#10;ELSEIF [organic_post_to_pre_ratio (sl_clicks_incrementality_w_type)] - 1 &gt; 5 THEN &quot;500%+&quot;&#10;END' />
      </column>
      <column caption='Ranking: organic to sponsored, % change bin' datatype='string' name='[Calculation_1940136709469564933]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [organic_to_sponsored_ranking_improvement] - 1 &lt;= -0.75 THEN &quot;-100% to -75%&quot;&#10;ELSEIF [organic_to_sponsored_ranking_improvement] - 1 &lt;= -0.50 THEN &quot;-75% to -50%&quot;&#10;ELSEIF [organic_to_sponsored_ranking_improvement] - 1 &lt;= -0.25 THEN &quot;-50% to -25%&quot;&#10;ELSEIF [organic_to_sponsored_ranking_improvement] - 1 &lt;= -0.05 THEN &quot;-25% to -5%&quot;&#10;ELSEIF [organic_to_sponsored_ranking_improvement] - 1 &lt;= 0.05 THEN &quot;No change&quot;&#10;ELSEIF [organic_to_sponsored_ranking_improvement] - 1 &lt;= 0.25 THEN &quot;5% to 25%&quot;&#10;ELSEIF [organic_to_sponsored_ranking_improvement] - 1 &lt;= 0.5 THEN &quot;25% to 50%&quot;&#10;ELSEIF [organic_to_sponsored_ranking_improvement] - 1 &lt;= 0.75 THEN &quot;50% to 75%&quot;&#10;ELSEIF [organic_to_sponsored_ranking_improvement] - 1 &lt;= 1 THEN &quot;75% to 100%&quot;&#10;ELSEIF [organic_to_sponsored_ranking_improvement] - 1 &lt;= 2 THEN &quot;100% to 200%&quot;&#10;ELSEIF [organic_to_sponsored_ranking_improvement] - 1 &lt;= 5 THEN &quot;200% to 500%&quot;&#10;ELSEIF [organic_to_sponsored_ranking_improvement] - 1 &gt; 5 THEN &quot;500%+&quot;&#10;END' />
      </column>
      <column caption='Search orders % change bin' datatype='string' name='[Calculation_4451597187264987137]' role='dimension' type='nominal'>
