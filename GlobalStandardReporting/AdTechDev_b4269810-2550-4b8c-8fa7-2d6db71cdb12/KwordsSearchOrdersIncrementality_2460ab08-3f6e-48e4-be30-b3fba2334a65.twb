            <dictionary>
              <bucket>%null%</bucket>
              <bucket>&quot;-100\% to -75\%&quot;</bucket>
              <bucket>&quot;-75\% to -50\%&quot;</bucket>
              <bucket>&quot;-50\% to -25\%&quot;</bucket>
              <bucket>&quot;-25\% to -5\%&quot;</bucket>
              <bucket>&quot;No change&quot;</bucket>
              <bucket>&quot;5\% to 25\%&quot;</bucket>
              <bucket>&quot;25\% to 50\%&quot;</bucket>
              <bucket>&quot;50\% to 75\%&quot;</bucket>
