      </column>
      <column caption='Organic impressions % change bin' datatype='string' name='[Calculation_669840137041625089]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [organic_post_to_pre_ratio] - 1 &lt;= -0.75 THEN &quot;-100% to -75%&quot;&#10;ELSEIF [organic_post_to_pre_ratio] - 1 &lt;= -0.50 THEN &quot;-75% to -50%&quot;&#10;ELSEIF [organic_post_to_pre_ratio] - 1 &lt;= -0.25 THEN &quot;-50% to -25%&quot;&#10;ELSEIF [organic_post_to_pre_ratio] - 1 &lt;= -0.05 THEN &quot;-25% to -5%&quot;&#10;ELSEIF [organic_post_to_pre_ratio] - 1 &lt;= 0.05 THEN &quot;No change&quot;&#10;ELSEIF [organic_post_to_pre_ratio] - 1 &lt;= 0.25 THEN &quot;5% to 25%&quot;&#10;ELSEIF [organic_post_to_pre_ratio] - 1 &lt;= 0.5 THEN &quot;25% to 50%&quot;&#10;ELSEIF [organic_post_to_pre_ratio] - 1 &lt;= 0.75 THEN &quot;50% to 75%&quot;&#10;ELSEIF [organic_post_to_pre_ratio] - 1 &lt;= 1 THEN &quot;75% to 100%&quot;&#10;ELSEIF [organic_post_to_pre_ratio] - 1 &lt;= 2 THEN &quot;100% to 200%&quot;&#10;ELSEIF [organic_post_to_pre_ratio] - 1 &lt;= 5 THEN &quot;200% to 500%&quot;&#10;ELSEIF [organic_post_to_pre_ratio] - 1 &gt; 5 THEN &quot;500%+&quot;&#10;END' />
      </column>
