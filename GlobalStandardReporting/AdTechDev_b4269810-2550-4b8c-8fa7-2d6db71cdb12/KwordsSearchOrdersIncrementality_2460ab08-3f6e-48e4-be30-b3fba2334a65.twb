          <datasource-dependencies datasource='federated.0m3l91c0rrcnjx13hjcnk1an1vn7'>
            <column caption='Percentage of total' datatype='real' default-format='p0.0%' name='[Calculation1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([vendor_id]) / TOTAL(COUNTD([vendor_id]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Difference in vendor %' datatype='real' name='[Calculation_709105893456580610]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF LOOKUP(MIN([period]), 0) &gt; LOOKUP(MIN([period]), -1)&#10;   THEN&#10;    (LOOKUP([Calculation1], 0) - LOOKUP([Calculation1], -1)) * 100&#10;ELSE NULL&#10;END'>
