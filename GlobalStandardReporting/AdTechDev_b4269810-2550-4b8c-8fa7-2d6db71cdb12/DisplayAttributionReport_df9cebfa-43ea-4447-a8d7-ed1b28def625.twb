              <calculation class='tableau' formula='(sum(zn([gmv_eur_post_click]))+sum(zn([gmv_eur_marketing_effect])))/sum(zn([revenue_eur]))' />
            </column>
            <column caption='Impressions (budgeted)' datatype='real' name='[Calculation_6790302339300933638]' role='measure' type='quantitative'>
