          <alias key='&quot;[federated.0kccot8172eqkd1572uvc0n417vs].[sum:gmv_eur_post_click:qk]&quot;' value='GMV (post click), eur' />
          <alias key='&quot;[federated.0kccot8172eqkd1572uvc0n417vs].[sum:impressions:qk]&quot;' value='Impressions (loaded)' />
          <alias key='&quot;[federated.0kccot8172eqkd1572uvc0n417vs].[sum:orders_marketing_effect:qk]&quot;' value='Orders (post view)' />
          <alias key='&quot;[federated.0kccot8172eqkd1572uvc0n417vs].[sum:orders_post_click:qk]&quot;' value='Orders (post click)' />
          <alias key='&quot;[federated.0kccot8172eqkd1572uvc0n417vs].[sum:Revenue Eur (copy)_6790302339300642821:qk]&quot;' value='Budget utilized, eur' />
          <alias key='&quot;[federated.0kccot8172eqkd1572uvc0n417vs].[sum:revenue_eur:qk]&quot;' value='Revenue, eur' />
          <alias key='&quot;[federated.0kccot8172eqkd1572uvc0n417vs].[usr:Calculation_6790302339297325058:qk]&quot;' value='ROAS (post click + post view)' />
          <alias key='&quot;[federated.0kccot8172eqkd1572uvc0n417vs].[usr:Calculation_6790302339300245508:qk]&quot;' value='ROAS (post view)' />
          <alias key='&quot;[federated.0kccot8172eqkd1572uvc0n417vs].[usr:Calculation_6790302339301593095:qk]&quot;' value='Budget UTR%, eur' />
        </aliases>
      </column>
      <column caption='ROAS (post click + post view)' datatype='real' name='[Calculation_6790302339297325058]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum(zn([gmv_eur_post_click]))+sum(zn([gmv_eur_marketing_effect])))/sum(zn([revenue_eur]))' />
      </column>
      <column caption='ROAS (post click)' datatype='real' name='[Calculation_6790302339300159491]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(zn([gmv_eur_post_click]))/sum(zn([revenue_eur]))' />
      </column>
      <column caption='ROAS (post view)' datatype='real' name='[Calculation_6790302339300245508]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(zn([gmv_eur_marketing_effect]))/sum([revenue_eur])' />
      </column>
      <column caption='Impressions (budgeted)' datatype='real' name='[Calculation_6790302339300933638]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([budget_excl_cancelled_eur])*1000/avg([cpm_price_eur])' />
      </column>
      <column caption='Budget UTR%' datatype='real' name='[Calculation_6790302339301593095]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([revenue_eur])/sum([budget_excl_cancelled_eur])' />
      </column>
      <column caption='Budget UTR%, impressions' datatype='real' name='[Calculation_6790302339302727688]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([impressions])/[Calculation_6790302339300933638]' />
      </column>
      <column caption='CTR Total' datatype='real' name='[Calculation_6790302339303690249]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(zn([clicks_nonunique]))/sum([impressions])' />
      </column>
      <column caption='Orders (post click + post view)' datatype='integer' name='[Calculation_6790302339304083466]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([orders_post_click]) + sum([orders_marketing_effect])' />
      </column>
      <column caption='GMV (post click + post view), eur' datatype='real' name='[Calculation_6790302339304603659]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([gmv_eur_post_click]) + sum([gmv_eur_marketing_effect])' />
      </column>
      <column caption='ROAS (post click + post view + repeated orders)' datatype='real' name='[Calculation_6790302339305340940]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([Calculation_6790302339300159491])+Zn([Calculation_6790302339300245508])+Zn([Calculation_6790302339307130893])' />
      </column>
      <column caption='ROAS (repeated orders)' datatype='real' name='[Calculation_6790302339307130893]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(zn([gmv_eur_repeat_orders]))/sum([revenue_eur])' />
      </column>
      <column caption='CTR Unique' datatype='real' name='[Calculation_6790302339310641166]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(zn([clicks_unique]))/sum([impressions])' />
      </column>
      <column caption='Budget utilized Eur' datatype='real' name='[Revenue Eur (copy)_6790302339300642821]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[revenue_eur]' />
      </column>
