      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0kccot8172eqkd1572uvc0n417vs].[avg:cpm_price_eur:qk]&quot;' value='CPM, eur' />
          <alias key='&quot;[federated.0kccot8172eqkd1572uvc0n417vs].[sum:budget_excl_cancelled_eur:qk]&quot;' value='Budget booked, eur' />
