    <worksheet name='Where have they gone ORDER MoM'>
      <repository-location id='WherehavetheygoneORDERMoM' path='/t/GlobalStandardReporting/workbooks/Postchurnanalysis' revision='' site='GlobalStandardReporting' />
      <table>
        <view>
          <datasources>
            <datasource caption='Cohort' name='federated.19sl2c50kegch611aupoh0e1r6ky' />
          </datasources>
          <datasource-dependencies datasource='federated.19sl2c50kegch611aupoh0e1r6ky'>
            <column caption='months sicne first try' datatype='integer' name='[Calculation_6123839990103986177]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,[first_cpc_try],[date_month])' />
            </column>
            <column caption='ROAS' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_6123839990132027399]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([cpc_sent_gmv_eur])/ZN([cpc_revenue])' />
            </column>
            <column caption='Next Status' datatype='string' name='[Calculation_6123839990174380042]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if CONTAINS([status_next_month],&apos;keep&apos;) then &apos;Keep in ads&apos;&#10;ELSEIF CONTAINS([status_next_month],&apos;zombie&apos;) or CONTAINS([status_next_month],&apos;platform&apos;) then &apos;Inactive&apos; &#10;ELSE [status_next_month] END' />
              <aliases>
                <alias key='%null%' value='CPC Active' />
                <alias key='&quot;ads churn&quot;' value='No CPC/Joker/VFD' />
                <alias key='&quot;Keep in ads&quot;' value='Keep in Joker or VFD' />
              </aliases>
            </column>
            <column caption='Orders MoM Variation' datatype='real' default-format='p0.0%' name='[Calculation_6123839990187642892]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='round(if [Calculation_6123839990103986177]=0 and [successful_orders_previous_month]&gt;10 THEN (([successful_orders])/([successful_orders_previous_month]))-1&#10;END,1)' />
            </column>
