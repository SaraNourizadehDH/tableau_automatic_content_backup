      </semantic-values>
      <date-options start-of-week='monday' />
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_7A162FA2C8044AC4B9F83DB4E1AD051B'>
            <properties context=''>
              <relation connection='bigquery.1hncvhx15csqel1488xn51pqzhur' name='Custom SQL Query' type='text'><![CDATA[with budget_burn as (
SELECT  
date_month,
EXTRACT(DAY FROM report_date) day,
global_entity_id, 
vendor_id,
sum(cpc_revenue_up_to_date_local_currency)/sum(budget_local_currency_incl_canceled) budget_utr
FROM `dhh-ncr-live.analytics.ad_tech_il_cpc_daily` 
group by 1,2,3,4
having sum(cpc_revenue_up_to_date_local_currency)/sum(budget_local_currency_incl_canceled)>>0.95
),

run_out_of_budget as (
select
date_month,
global_entity_id, 
vendor_id,
min(day) day, --when they hit 95% UTR
max(budget_utr) total_btr,
from budget_burn
where budget_utr>>0.95
group by 1,2,3
),

base as (
select 
a.vendor_id,
a.global_entity_id, 
a.accounts_segment,
a.date_month,
min(case when a.cpc_active_vendor then a.date_month end) over(partition by a.vendor_id, a.global_entity_id) as first_cpc_try,
a.cpc_active_vendor,
case when a.cpc_active_vendor and a.vfd_amount_eur>>0 then 'CPC + VFD'
     when a.cpc_active_vendor and coalesce(a.vfd_amount_eur,0)=0 then 'CPC' 
     else 'Non Active CPC' end hibrid_product,
a.cpc_revenue,
a.budget_excl_canceled,
a.cpc_sent_gmv_eur,
a.cpc_clicks,
a.cpc_orders,
a.successful_orders,
c.successful_orders as successful_orders_previous_month,
b.successful_orders as successful_orders_next_month,
case when a.vfd_amount_eur>>0 then TRUE else FALSE end as vfd_active,
case when b.vfd_amount_eur>>0 then TRUE else FALSE end as vfd_active_next_month,
a.joker_active_vendor,
b.joker_active_vendor as joker_active_next_month,
b.date_month as next_month,
case when (a.cpc_active_vendor and (b.cpc_active_vendor is false or b.vendor_id is null)) then TRUE else FALSE end as cpc_churn_next_month,
a.joker_new,
case when coalesce(c.vfd_amount_eur,0)=0 and a.vfd_amount_eur>>0 then TRUE else FALSE end vfd_new,
case when a.joker_new then TRUE 
     when b.joker_new then TRUE end 
 as Joker_new_2,
case when (coalesce(c.vfd_amount_eur,0)=0 and a.vfd_amount_eur>>0) then TRUE --vfd_new
     when (coalesce(a.vfd_amount_eur,0)=0 and b.vfd_amount_eur>>0) then TRUE end--vfd_new_next_month 
 as vfd_new_2,
case when b.vendor_id is null then true else false end as platform_churn, 
--coalesce(a.vfd_new,b.vfd_new) as vfd_new_2,
from `dhh-ncr-live.analytics.ad_tech_il_ncr_vendor_penetration` a
left join `dhh-ncr-live.analytics.ad_tech_il_ncr_vendor_penetration` b
on a.vendor_id=b.vendor_id
and a.global_entity_id=b.global_entity_id
and a.date_month=date_sub(b.date_month, interval 1 month)

left join `dhh-ncr-live.analytics.ad_tech_il_ncr_vendor_penetration` c
on a.vendor_id=c.vendor_id
and a.global_entity_id=c.global_entity_id
and a.date_month=date_add(c.date_month, interval 1 month)

where a.global_entity_id<<>>'BM_KR'
--and a.date_month>>='2023-05-01' and a.date_month <<='2023-10-01' 
),

final as(
select * except(joker_new_2,vfd_new_2), 
case when platform_churn then 'platform churn' 
     when successful_orders_next_month<<1 then 'zombie'
     when joker_new_2 and cpc_churn_next_month then 'switch to joker' 
     when vfd_new_2 and cpc_churn_next_month then 'switch to VFD' 
     when platform_churn is false and cpc_churn_next_month and vfd_active_next_month and joker_active_next_month then 'keep active vfd and joker'
     when platform_churn is false and cpc_churn_next_month and vfd_active_next_month and joker_active_next_month is false then 'keep active vfd'
     when platform_churn is false and cpc_churn_next_month and vfd_active_next_month is false and joker_active_next_month then 'keep active joker'
     when platform_churn is false and cpc_churn_next_month and vfd_active_next_month is false and joker_active_next_month is false and cpc_churn_next_month then 'ads churn'     
     end as status_next_month,
     safe_divide(successful_orders_previous_month,successful_orders) orders_mom_vendor_level,
run_out_of_budget.day as running_out_of_budget_day
from base 
left join run_out_of_budget
using(date_month, vendor_id, global_entity_id)

where first_cpc_try>>='2022-11-01' and date_month <<='2023-10-01' )

select * from final]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
