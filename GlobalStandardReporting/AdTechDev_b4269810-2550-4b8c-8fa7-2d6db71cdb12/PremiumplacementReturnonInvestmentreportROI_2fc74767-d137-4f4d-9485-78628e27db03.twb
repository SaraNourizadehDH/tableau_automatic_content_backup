      <column caption='Premium Area Orders Ct Good' datatype='real' name='[Area Orders Ct Good (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [year_month],[promo_area_id]:MAX([premium_area_orders_ct])}' />
      </column>
      <column caption='Premium Area Restaurant Ct Good' datatype='integer' name='[Area Restaurant Ct Good (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [year_month],[promo_area_id]:MAX([premium_area_restaurant_ct])}' />
      </column>
      <column caption='Average Area Orders ' datatype='real' name='[Calculation_3098195076288028672]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3098195077026639882]/[Premium Area Orders Ct Good (copy)]' />
      </column>
      <column caption='Premium Average Area Orders Ct' datatype='real' name='[Calculation_3098195076288487425]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Area Orders Ct Good (copy)]/[Area Restaurant Ct Good (copy)]' />
      </column>
      <column caption='Delta Area' datatype='real' name='[Calculation_3098195076289445890]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [year_month],[promo_area_id]:MAX(([Calculation_3098195076288487425]-[Calculation_3098195076288028672])/([Calculation_3098195076288028672]))}' />
      </column>
      <column caption='Delta Restaurant' datatype='real' name='[Calculation_3098195076291063811]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [booking_id]:MAX(([premium_restaurant_orders_ct]-[restaurant_orders_ct])/[restaurant_orders_ct])}' />
      </column>
      <column caption='Var. Incremental Restaurant Orders' datatype='real' name='[Calculation_3098195076291551236]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [booking_id]:MAX([Calculation_3098195076291063811]-[Calculation_3098195076289445890])}' />
      </column>
      <column caption='Incremental Restaurant Orders' datatype='real' name='[Calculation_3098195076291829765]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [booking_id]:MAX([Calculation_3098195076291551236]*[restaurant_orders_ct])}' />
      </column>
      <column caption='Incremental Restaurant GMV LC' datatype='real' name='[Calculation_3098195076292091910]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [booking_id]:MAX([Calculation_3098195076291829765]*[premium_restaurant_gmv_lc]/[premium_restaurant_orders_ct])}' />
      </column>
      <column caption='ROI Area - Restaurant' datatype='real' name='[Calculation_3098195076292349959]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_3098195076292091910])-SUM([price]))/SUM([price])' />
      </column>
      <column caption='Price AGG' datatype='real' name='[Calculation_3098195076295782408]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [booking_id]:MAX([price])}' />
      </column>
      <column caption='Area Orders Ct Good' datatype='real' name='[Calculation_3098195077026639882]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [year_month],[promo_area_id]:MAX([area_orders_ct])}' />
