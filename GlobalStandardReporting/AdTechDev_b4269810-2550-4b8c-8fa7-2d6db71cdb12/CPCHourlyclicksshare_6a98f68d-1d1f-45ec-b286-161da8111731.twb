        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1bfnyle0nx5bho16ju3g61evrf36' name='Custom SQL Query' type='text'>SELECT 
partition_date,
global_entity_id,
timezone,
date_trunc(datetime(click.event_timestamp, timezone),hour) hour_local,
date_trunc(datetime(click.event_timestamp),hour) hour_utc,
count(*) total_clicks,
count(case when click.is_sponsored then click.event_id end) sponsored,
count(case when click.is_billable then click.event_id end) billable
FROM `fulfillment-dwh-production.curated_data_shared_adtech.fct_clicks` 
where partition_date between &apos;2024-01-31&apos; and &apos;2024-03-01&apos;
and date(date_trunc(datetime(click.event_timestamp, timezone),month)) = &apos;2024-02-01&apos;
and click.event_action=&apos;shop.clicked&apos;
and global_entity_id in(&apos;TB_AE&apos;,&apos;PY_AR&apos;,&apos;YS_TR&apos;,&apos;FP_HK&apos;,&apos;PO_FI&apos;)
group by 1,2,3,4,5</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
