    <worksheet name='VFD Summary'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='VFD Monthly Live' name='federated.1vrs4y91yj6bez13em7hs04c8umk' />
          </datasources>
          <datasource-dependencies datasource='federated.1vrs4y91yj6bez13em7hs04c8umk'>
            <column caption='% Discount Value over GFV' datatype='real' default-format='p0.0%' name='[% Discount Value over GMV (copy)_3558195588035915791]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_discount_value_eur]) / SUM([order_gfv_eur])' />
            </column>
            <column caption='Deals per Vendor' datatype='real' name='[Active Deals per Vendor (copy)_3558195588036157457]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_deals]) / SUM([vfd_vendors])' />
            </column>
            <column caption='% VFD Orders Vendor Penetration' datatype='real' default-format='p0.0%' name='[Calculation_194639988243689472]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([incentive_orders_vendors]) / SUM([online_vendors])' />
            </column>
            <column caption='Discount Value' datatype='real' name='[Calculation_2196630760535863296]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([discount_dh_eur]) + sum([discount_other_eur])' />
            </column>
            <column caption='% Discount Depth' datatype='real' default-format='p0.0%' name='[Calculation_2196630760535977985]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vendor_discount_value_eur]) / SUM([incentive_order_gfv_eur])' />
            </column>
            <column caption='% Weighted Vendor Coverage' datatype='real' default-format='p0.0%' name='[Calculation_3558195588021207041]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([incentive_order_gfv_eur]) / SUM([order_gfv_eur])' />
            </column>
            <column caption='% New SS Deals' datatype='real' default-format='p0.0%' name='[Calculation_3558195588021379074]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_new_active_ss_deals]) / SUM([total_new_active_deals])' />
            </column>
            <column caption='% New Deals' datatype='real' default-format='p0.0%' name='[Calculation_3558195588021919747]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_new_active_deals]) / SUM([total_active_deals])' />
            </column>
            <column caption='% SS Discount' datatype='real' default-format='p0.0%' name='[Calculation_3558195588024016900]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ss_vendor_discount_value_eur]) / SUM([vendor_discount_value_eur])' />
            </column>
            <column caption='% SS Vendors Share' datatype='real' default-format='p0.0%' name='[Calculation_3558195588029542409]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vfd_ss_vendors]) / SUM([vfd_vendors])' />
            </column>
            <column caption='% SS Deals Share' datatype='real' default-format='p0.0%' name='[Calculation_3558195588029657098]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_ss_deals]) / SUM([total_deals])' />
            </column>
            <column caption='% Order Penetration' datatype='real' default-format='p0.0%' name='[Calculation_3558195588033691659]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_incentive_orders]) / SUM([total_orders])' />
            </column>
            <column caption='% SS Order Penetration' datatype='real' default-format='p0.0%' name='[Calculation_3558195588033974284]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_ss_incentive_orders]) / SUM([total_orders])' />
            </column>
            <column caption='% VFD Order Penetration' datatype='real' default-format='p0.0%' name='[Calculation_3558195588034084877]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_incentive_orders]) / SUM([total_orders])' />
            </column>
            <column caption='% Discount Value over GMV' datatype='real' default-format='p0.0%' name='[Calculation_3558195588035776526]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_discount_value_eur]) / SUM([order_gmv_eur])' />
            </column>
            <column caption='Entity (copy)' datatype='string' name='[Entity (copy)_3558195588147109908]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[management_entity]' />
            </column>
            <column caption='Account Segment' datatype='string' name='[account_segment]' role='dimension' type='nominal' />
            <column-instance column='[avg_active_days]' derivation='Avg' name='[avg:avg_active_days:qk]' pivot='key' type='quantitative' />
            <column caption='Avg Active Days' datatype='real' name='[avg_active_days]' role='measure' type='quantitative' />
            <column caption='Discount Dh Eur' datatype='real' name='[discount_dh_eur]' role='measure' type='quantitative' />
            <column caption='Discount Other Eur' datatype='real' name='[discount_other_eur]' role='measure' type='quantitative' />
            <column caption='Incentive Order Gfv Eur' datatype='real' name='[incentive_order_gfv_eur]' role='measure' type='quantitative' />
            <column caption='Incentive Order Gmv Eur' datatype='real' name='[incentive_order_gmv_eur]' role='measure' type='quantitative' />
            <column caption='Incentive Orders Vendors' datatype='integer' name='[incentive_orders_vendors]' role='measure' type='quantitative' />
            <column caption='Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
