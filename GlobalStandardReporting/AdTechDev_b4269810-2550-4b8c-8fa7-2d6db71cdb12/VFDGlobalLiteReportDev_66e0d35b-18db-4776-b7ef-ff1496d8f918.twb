      <aliases enabled='yes' />
      <column caption='% Order Penetration' datatype='real' default-format='p0.0%' name='[Calculation_3393954954049732608]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([monetised_deal_orders]) / SUM([total_orders])' />
      </column>
      <column caption='Targeting Charge' datatype='real' default-format='p0.0%' name='[Calculation_3393954954089082881]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([deal_charge_local]) / SUM([gfv_local])' />
      </column>
      <column caption='KPI' datatype='real' name='[Calculation_3393954954098769922]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Vendors&apos; THEN SUM([vendors])&#10;    WHEN &apos;Orders&apos; THEN SUM([monetised_deal_orders])&#10;    WHEN &apos;Order Penetration&apos; THEN [Calculation_3393954954049732608]&#10;    WHEN &apos;Deal Charge, Eur&apos; THEN SUM([deal_charge_eur])&#10;    WHEN &apos;Deal Charge, Local Currency&apos; THEN SUM([deal_charge_local])&#10;    WHEN &apos;GFV, Eur&apos; THEN SUM([gfv_eur])&#10;    WHEN &apos;GFV, Local Currency&apos; THEN SUM([gfv_local])&#10;END' />
      </column>
      <column caption='KPI CW' datatype='integer' name='[Calculation_3393954954100854787]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF DATEDIFF(&apos;week&apos;,[report_date],TODAY()) = 0 AND [report_date] &lt;= TODAY() THEN [vendors] END' />
      </column>
      <column caption='KPI &lt; 1' datatype='real' default-format='p0.0%' name='[Calculation_3393954954101334021]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_3393954954098769922] &lt; 1 THEN [Calculation_3393954954098769922] END' />
      </column>
      <column caption='KPI &gt; 1' datatype='real' name='[Calculation_3393954954101411846]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_3393954954098769922] &gt; 1 THEN [Calculation_3393954954098769922] END' />
      </column>
      <column caption='KPI PW' datatype='integer' name='[Calculation_3393954954102120455]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF DATEDIFF(&apos;week&apos;,[report_date],TODAY()) = 1 AND DATEPART(&apos;weekday&apos;,[report_date]) &lt;= DATEPART(&apos;weekday&apos;,TODAY()) THEN [vendors] END' />
      </column>
      <column caption='KPI WoW' datatype='real' default-format='p0.0%' name='[Calculation_3393954954102575113]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3393954954100854787] / [Calculation_3393954954102120455] - 1' />
      </column>
      <column caption='KPI Name' datatype='string' name='[KPI (copy)_3393954954106556426]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Vendors&apos; THEN &apos;Vendors&apos;&#10;    WHEN &apos;Orders&apos; THEN &apos;Orders&apos;&#10;    WHEN &apos;Order Penetration&apos; THEN &apos;Order Penetration&apos;&#10;    WHEN &apos;Deal Charge, Eur&apos; THEN &apos;Deal Charge, Eur&apos;&#10;    WHEN &apos;Deal Charge, Local Currency&apos; THEN &apos;Deal Charge, Local Currency&apos;&#10;    WHEN &apos;GFV, Eur&apos; THEN &apos;GFV, Eur&apos;&#10;    WHEN &apos;GFV, Local Currency&apos; THEN &apos;GFV, Local Currency&apos;&#10;END' />
      </column>
