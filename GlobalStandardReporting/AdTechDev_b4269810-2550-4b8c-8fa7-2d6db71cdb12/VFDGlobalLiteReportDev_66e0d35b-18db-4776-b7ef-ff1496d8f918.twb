              <zone forceUpdate='true' h='9187' id='521' type-v2='text' w='98400' x='800' y='12093'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontsize='10'>DISCLAIMER:</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000'>1.</run>
                  <run fontcolor='#000000'> The data in the dashboard currently has the data on </run>
                  <run bold='true' fontcolor='#000000'>Discounts</run>
                  <run fontcolor='#000000'> only that contributes to </run>
                  <run bold='true' fontcolor='#000000'>over 80%</run>
                  <run fontcolor='#000000'> of GMV / GFV, </run>
                  <run bold='true' fontcolor='#000000'>Vouchers</run>
                  <run fontcolor='#000000'> that hold </run>
                  <run bold='true' fontcolor='#000000'>under 20%</run>
                  <run fontcolor='#000000'> will be added later</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000'>2.</run>
                  <run fontcolor='#000000'> The </run>
                  <run bold='true' fontcolor='#000000'>data is subject to change</run>
                  <run fontcolor='#000000'> once the data source will be expanded and improved</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000'>3. The currently known discrepancy between the data stream and local team reporting </run>
                  <run bold='true' fontcolor='#000000'>in APAC is 10%</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
