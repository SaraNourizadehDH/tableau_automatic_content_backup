      <column caption='imps' datatype='integer' name='[CTR (copy)_78672267431018497]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [event_action]=&apos;shop_impressions.loaded&apos; THEN [m_events] ELSE 0 END' />
      </column>
      <column caption='Short Entity' datatype='string' name='[Calculation_1536290481552293891]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='REGEXP_EXTRACT([global_entity_id],&apos;([A-Z]*)&apos;)' />
      </column>
      <column caption='Split' datatype='string' name='[Calculation_1536290481555025926]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&apos;entity&apos; THEN [global_entity_id]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;management entity&apos; THEN [Calculation_1536290481552293891]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;platform&apos; THEN [platform]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;is with ncr token&apos; THEN STR([is_with_ncr_request_token])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;shop sponsoring&apos; THEN [shop_sponsoring]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;shop sponsoring placement&apos; THEN [shop_sponsoring_placement]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;shop click origin&apos; THEN [shop_click_origin]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;screen type&apos; THEN [screen_type]&#10;ELSE &apos;overall&apos; END' />
      </column>
      <column caption='colored events' datatype='integer' name='[Calculation_6176546210138263552]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 2], [m_events], NULL)' />
      </column>
      <column caption='CTR' datatype='real' name='[Calculation_78672267400691712]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [event_action]=&apos;shop.clicked&apos; THEN [m_events] ELSE 0 END) / SUM(IF [event_action]=&apos;shop_impressions.loaded&apos; THEN [m_events] ELSE 0 END)' />
