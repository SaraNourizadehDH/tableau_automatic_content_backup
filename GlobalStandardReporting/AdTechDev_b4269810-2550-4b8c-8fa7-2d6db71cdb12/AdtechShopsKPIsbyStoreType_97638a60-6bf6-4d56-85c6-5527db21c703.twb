        <column caption='Placement Screen ' datatype='string' name='[Calculation_2278891804746915843]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='if contains([placement_screen],&apos;not set&apos;)&#10;    or contains([placement_screen],&apos;not_set&apos;)&#10;    or contains([placement_screen],&apos;na&apos;) &#10;    or contains([placement_screen],&apos;NA&apos;)&#10;    or contains([placement_screen],&apos;n/a&apos;)&#10;    or CONTAINS([placement_screen],&apos;N/A&apos;)&#10;    or isnull([placement_screen])&#10;    or [placement_screen] = &apos; &apos; or [placement_screen] = &apos;&apos;&#10;then &apos;N/A&apos;&#10;elseif CONTAINS([placement_screen],&apos;:home:&apos;) then &apos;home&apos;&#10;else [placement_screen]&#10;end' />
        </column>
        <column caption='Platform ' datatype='string' name='[Calculation_2278891804753145862]' role='dimension' type='nominal'>
