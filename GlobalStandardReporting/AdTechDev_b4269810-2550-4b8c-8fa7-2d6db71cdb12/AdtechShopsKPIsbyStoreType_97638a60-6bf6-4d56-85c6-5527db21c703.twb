      <column caption='Total Advertising Revenue over GMV %' datatype='real' name='[Calculation_730427615967993857]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(zn([total_ncr_revenue]))/sum(zn([gmv_eur]))' />
