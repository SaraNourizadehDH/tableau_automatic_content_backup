    <worksheet name='Vendor Booking KPIs'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontsize='14'>&lt;</run>
            <run bold='true' fontalignment='1' fontsize='14'>[Parameters].[Management Entity Parameter]</run>
            <run bold='true' fontalignment='1' fontsize='14'>&gt; Booking KPIs by Vertical Type</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='adtech_shops_il_cpc (analytics)' name='federated.1ci2ixa1o77mvl1ax012c1p8da49' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Management Entity Filter' datatype='string' name='[Management Entity Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column alias='Exclude Canceled &amp; Outliers' caption='Canceled Budget/outliers' datatype='string' name='[Parameter 2 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Outliers&quot;'>
              <calculation class='tableau' formula='&quot;Outliers&quot;' />
              <aliases>
                <alias key='&quot;Exclude&quot;' value='Exclude canceled budget' />
                <alias key='&quot;Include&quot;' value='Include canceled budget' />
                <alias key='&quot;Outliers&quot;' value='Exclude Canceled &amp; Outliers' />
              </aliases>
            </column>
            <column caption='Max Position' datatype='integer' name='[Parameter 8]' param-domain-type='range' role='measure' type='quantitative' value='2'>
              <calculation class='tableau' formula='2' />
              <range granularity='1' max='10' min='1' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ci2ixa1o77mvl1ax012c1p8da49'>
            <column caption='CPC Type' datatype='string' name='[Calculation_1512646572307587072]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if  CONTAINS([type],&apos;placements&apos;) then &apos;Premium Placement&apos;&#13;&#10;ELSEIF [type]=&apos;kwords_placements&apos; then &apos;Kwords Placement&apos; &#13;&#10;ELSEIF [type]=&apos;featured_products&apos; then &apos;Feature Product&apos; &#13;&#10;ELSEIF [type]=&apos;kwords_search&apos; then &apos;Kwords Search&apos; &#13;&#10;END' />
            </column>
            <column caption='% Budget Achieved' datatype='real' default-format='p0.0%' name='[Calculation_1512646572325818379]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(ZN([cpc_revenue]))/sum(ZN([budget_excl_outliers]))' />
            </column>
            <column caption='Vendors' datatype='integer' name='[Calculation_1998472372129169409]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([vendor_id])' />
            </column>
            <column caption='Management Entity Filtered Data' datatype='string' name='[Calculation_1998472372134903811]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Management Entity Parameter] = &quot;All&quot; THEN &quot;True&quot;&#13;&#10;     ELSEIF [management_entity] = [Parameters].[Management Entity Parameter] THEN &quot;True&quot;&#13;&#10;     ELSE &quot;False&quot;&#13;&#10;     END' />
            </column>
            <column caption='Dynamic Clicks by Vertical  Type' datatype='integer' name='[Calculation_1998472372135337988]' role='measure' type='quantitative'>
