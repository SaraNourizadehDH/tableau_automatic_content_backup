      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0h1rik21xq9epg186ulzp0g5jqbj].[avg:cpc_clicks:qk]&quot;' value='Cpc Clicks ' />
          <alias key='&quot;[federated.0h1rik21xq9epg186ulzp0g5jqbj].[avg:total_clicks:qk]&quot;' value='Total Clicks ' />
        </aliases>
      </column>
      <column caption='Management Entity Filtered Data' datatype='string' name='[Calculation_116249197748547592]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Management Entity Parameter] = &quot;All&quot; THEN &quot;True&quot;&#13;&#10;     ELSEIF [management_entity] = [Parameters].[Management Entity Parameter] THEN &quot;True&quot;&#13;&#10;     ELSE &quot;False&quot;&#13;&#10;     END' />
      </column>
      <column caption='% CPC CVR' datatype='real' name='[Calculation_1462332893039792135]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(((SUM([cpc_orders])/SUM([cpc_clicks]))),2)' />
      </column>
      <column caption='Clicks Performing Metric' datatype='real' name='[Calculation_1462332893039890440]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 14]&#10;    WHEN &apos;ROAS&apos; THEN [Calculation_85005463232663552]&#10;    WHEN &apos;CPC Clicks&apos; THEN SUM([cpc_clicks])&#10;    WHEN &apos;CPC CVR&apos; THEN [Calculation_1462332893039792135]&#13;&#10;    WHEN  &apos;All Clicks&apos; THEN SUM([total_clicks])&#13;&#10;WHEN &apos;CPC GMV Eur&apos; THEN SUM([cpc_gmv_eur])&#13;&#10;WHEN &apos;CPC Revenue&apos; THEN SUM([cpc_revenue_eur])&#13;&#10;WHEN &apos;Click Utilisation Rate&apos; THEN ROUND([Calculation_85005463235727361],2)&#13;&#10;WHEN &apos;CPC Orders&apos; THEN SUM([cpc_orders])&#13;&#10;END' />
      </column>
      <column caption='Data up to' datatype='date' default-format='*mmmm d, yyyy' name='[Calculation_1648036034576551937]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MAX([partition_date])' />
      </column>
      <column caption='Dynamic Clicks by Store Type' datatype='integer' name='[Calculation_185773517183660032]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [vertical_type]: SUM(IF [Calculation_116249197748547592]  = &apos;True&apos; THEN [cpc_clicks] ELSE 0 END)}' />
      </column>
      <column caption='Store Type with Other' datatype='string' name='[Calculation_185773517184696323]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [Store Type (Adtech Shops By Store Type V2) Set]&#13;&#10;&#13;&#10;THEN [vertical_type]&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
      </column>
      <column caption='Placement Screen ' datatype='string' name='[Calculation_2278891804746915843]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if contains([placement_screen],&apos;not set&apos;)&#10;    or contains([placement_screen],&apos;not_set&apos;)&#10;    or contains([placement_screen],&apos;na&apos;) &#10;    or contains([placement_screen],&apos;NA&apos;)&#10;    or contains([placement_screen],&apos;n/a&apos;)&#10;    or CONTAINS([placement_screen],&apos;N/A&apos;)&#10;    or isnull([placement_screen])&#10;    or [placement_screen] = &apos; &apos; or [placement_screen] = &apos;&apos;&#10;then &apos;N/A&apos;&#10;elseif CONTAINS([placement_screen],&apos;:home:&apos;) then &apos;home&apos;&#10;else [placement_screen]&#10;end' />
      </column>
      <column caption='Performing Metrics %' datatype='real' default-format='p0.00%' name='[Calculation_2278891804750458884]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1462332893039890440] &lt;= 1 THEN [Calculation_1462332893039890440] END' />
      </column>
      <column caption='Platform ' datatype='string' name='[Calculation_2278891804753145862]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [platform] = &apos;ios&apos; or [platform] = &apos;iOS&apos; then &apos;iOS&apos;&#10;ELSEIF [platform] = &apos;Android&apos; or [platform] = &apos;android&apos; then &apos;Android&apos;&#10;ELSE [platform]&#10;END' />
      </column>
      <column caption='ROAS' datatype='real' name='[Calculation_85005463232663552]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cpc_gmv_eur])/SUM([cpc_revenue_eur])' />
      </column>
      <column caption='CPC Utilization Rate' datatype='real' default-format='p0.0%' name='[Calculation_85005463235727361]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(((SUM([cpc_clicks])/SUM([total_clicks]))),2)' />
      </column>
      <column caption='Management Entity (copy)' datatype='string' name='[Management Entity (copy)_2278891804741083136]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[management_entity]' />
      </column>
      <column caption='Performing Metrics' datatype='real' name='[Performing Metrics % (copy)_2278891804750692357]' role='measure' type='quantitative'>
