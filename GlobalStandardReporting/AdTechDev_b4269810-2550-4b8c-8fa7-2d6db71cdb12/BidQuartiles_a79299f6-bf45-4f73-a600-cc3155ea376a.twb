        <view>
          <datasources>
            <datasource caption='base_bid_ctr_data' name='federated.0m3l91c0rrcnjx13hjcnk1an1vn7' />
          </datasources>
          <datasource-dependencies datasource='federated.0m3l91c0rrcnjx13hjcnk1an1vn7'>
            <column caption='Monthly Budget' datatype='real' name='[Calculation_2420684850721083399]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({INCLUDE [campaign_id], [vendor_id], [Partition Date (copy)_2420684850719993861]: MAX([budget])})' />
            </column>
            <column caption='UTR' datatype='real' default-format='p0.00%' name='[Calculation_3601753854344339460]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cpc_revenue_up_to_date]) / [Calculation_2420684850721083399]' />
            </column>
            <column caption='Is Full Month' datatype='string' name='[Calculation_3601753854711840774]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [started_at_utc] &lt;= DATE(&quot;2024-07-01&quot;) THEN &apos;Full month&apos;&#10;ELSE &apos;Not full month&apos;&#10;END' />
            </column>
            <column caption='Month' datatype='integer' name='[Partition Date (copy)_2420684850719993861]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='MONTH([partition_date])' />
            </column>
            <column caption='Daily Budget' datatype='real' name='[budget]' role='measure' type='quantitative' />
            <column caption='Campaign Id' datatype='string' name='[campaign_id]' role='dimension' type='nominal' />
            <column datatype='real' name='[cpc_revenue_up_to_date]' role='measure' type='quantitative' />
