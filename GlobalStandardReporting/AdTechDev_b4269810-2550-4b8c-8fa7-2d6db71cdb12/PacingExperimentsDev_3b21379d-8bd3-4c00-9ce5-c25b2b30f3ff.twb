      <column caption='Greater or Lower' datatype='string' name='[Calculation_3160823319596392453]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_3160823319593951234]&gt;0 then &apos;Greater&apos; ELSE &apos;Lower&apos; end' />
