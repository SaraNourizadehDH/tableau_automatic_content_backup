      <table>
        <view>
          <datasources>
            <datasource caption='Monthly Pacing' name='federated.1fa0b8l02wkuxv15ij4tp1dwnbzp' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='KPI' datatype='string' name='[CPC Revenue Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;CTR&quot;'>
              <calculation class='tableau' formula='&quot;CTR&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1fa0b8l02wkuxv15ij4tp1dwnbzp'>
            <column caption='KPI' datatype='real' name='[Calculation_7020900744528764935]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[CPC Revenue Parameter] WHEN &apos;CTR&apos; THEN SUM([num_clicks])/SUM([num_requests])&#10;         WHEN &apos;CVR (o/r)&apos; THEN SUM([num_orders])/SUM([num_requests])&#10;         WHEN &apos;CPC Revenue per Request&apos; THEN SUM([cpc_revenue_eur])/SUM([num_requests])&#10;         WHEN &apos;Commission Revenue per Request&apos; THEN SUM([commission_eur])/SUM([num_requests])&#10;         WHEN &apos;Total Revenue per Request&apos; THEN (SUM([commission_eur])+SUM([cpc_revenue_eur]))/SUM([num_requests])&#10;END' />
            </column>
            <column caption='Commission Revenue' datatype='real' default-format='c#,##0,.00K&quot; €&quot;;-#,##0,.00K&quot; €&quot;' name='[commission_eur]' role='measure' type='quantitative' />
