      <column caption='Commission Revenue per Request' datatype='real' default-format='c#,##0.0000&quot; €&quot;;-#,##0.0000&quot; €&quot;' name='[Calculation_4481644638482448385]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([commission_eur])/SUM([num_requests])' />
