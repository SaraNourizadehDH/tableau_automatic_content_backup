            <column caption='Clicks' datatype='integer' name='[num_clicks]' role='measure' type='quantitative' />
            <column caption='Num Orders' datatype='integer' name='[num_orders]' role='measure' type='quantitative' />
            <column caption='Requests' datatype='integer' name='[num_requests]' role='measure' type='quantitative' />
            <column caption='Strategy' datatype='string' name='[strategy]' role='dimension' type='nominal' />
            <column-instance column='[date]' derivation='Day-Trunc' name='[tdy:date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_7020900744528764935]' derivation='User' name='[usr:Calculation_7020900744528764935:qk]' pivot='key' type='quantitative' />
            <column caption='Vendor Code' datatype='string' name='[vendor_code]' role='dimension' type='nominal' />
