      <aliases enabled='yes' />
      <column caption='CTR' datatype='real' default-format='p0.00%' name='[Calculation_7020900744524742656]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_clicks])/SUM([num_requests])' />
      </column>
      <column caption='CVR (o/r)' datatype='real' default-format='p0.00%' name='[Calculation_7020900744524873729]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_orders])/SUM([num_requests])' />
      </column>
      <column caption='CPC Revenue per Request' datatype='real' default-format='c#,##0.0000&quot; €&quot;;-#,##0.0000&quot; €&quot;' name='[Calculation_7020900744525127682]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cpc_revenue_eur])/SUM([num_requests])' />
      </column>
      <column caption='Commission Revenue per Request' datatype='real' default-format='c#,##0.0000&quot; €&quot;;-#,##0.0000&quot; €&quot;' name='[Calculation_7020900744525414403]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([commission_eur])/SUM([num_requests])' />
      </column>
      <column caption='Total Revenue' datatype='real' default-format='c#,##0,.00K&quot; €&quot;;-#,##0,.00K&quot; €&quot;' name='[Calculation_7020900744525606916]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cpc_revenue_eur]) + SUM([commission_eur])' />
      </column>
      <column caption='Total Revenue per Request' datatype='real' default-format='c#,##0.0000&quot; €&quot;;-#,##0.0000&quot; €&quot;' name='[Calculation_7020900744525729797]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([cpc_revenue_eur]) + SUM([commission_eur]))&#10;/&#10;SUM([num_requests])' />
      </column>
      <column caption='Days Active' datatype='integer' datatype-customized='true' name='[Calculation_7020900744526774278]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='COUNTD([date])' />
      </column>
      <column caption='KPI' datatype='real' name='[Calculation_7020900744528764935]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[CPC Revenue Parameter] WHEN &apos;CTR&apos; THEN SUM([num_clicks])/SUM([num_requests])&#10;         WHEN &apos;CVR (o/r)&apos; THEN SUM([num_orders])/SUM([num_requests])&#10;         WHEN &apos;CPC Revenue per Request&apos; THEN SUM([cpc_revenue_eur])/SUM([num_requests])&#10;         WHEN &apos;Commission Revenue per Request&apos; THEN SUM([commission_eur])/SUM([num_requests])&#10;         WHEN &apos;Total Revenue per Request&apos; THEN (SUM([commission_eur])+SUM([cpc_revenue_eur]))/SUM([num_requests])&#10;END' />
      </column>
      <column caption='Budget Utilization' datatype='real' default-format='p0.00%' name='[Calculation_7020900744540651542]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cpc_revenue_eur])/SUM([budget_excl_outliers])' />
      </column>
