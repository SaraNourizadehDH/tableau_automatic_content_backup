      <aliases enabled='yes' />
      <column caption='# Discrepancies' datatype='real' name='[% Discrepancies (copy)_3160823319594504195]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([gross_revenue_bookings_daily]))-SUM(zn([gross_cpc_revenue_adtech_events]))' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.12dem5f0rnyfot10qun9c0nmxkff].[avg:time_online:qk]&quot;' value='Time Online' />
          <alias key='&quot;[federated.12dem5f0rnyfot10qun9c0nmxkff].[pcdf:sum:cpc_bookings_revenue_adtech_events:qk]&quot;' value='% DoD Adtech Events' />
          <alias key='&quot;[federated.12dem5f0rnyfot10qun9c0nmxkff].[pcdf:sum:cpc_bookings_revenue:qk]&quot;' value='% DoD Bookings Daily' />
          <alias key='&quot;[federated.12dem5f0rnyfot10qun9c0nmxkff].[pcdf:sum:gross_cpc_revenue_adtech_events:qk]&quot;' value='DoD % gross Revenue Adtech events' />
          <alias key='&quot;[federated.12dem5f0rnyfot10qun9c0nmxkff].[pcdf:sum:gross_revenue_bookings_daily:qk]&quot;' value='DoD % gross Revenue Bookings Daily' />
          <alias key='&quot;[federated.12dem5f0rnyfot10qun9c0nmxkff].[sum:cpc_bookings_revenue_adtech_events:qk]&quot;' value='Adtech events revenue' />
          <alias key='&quot;[federated.12dem5f0rnyfot10qun9c0nmxkff].[sum:cpc_bookings_revenue:qk]&quot;' value='Bookings daily revenue' />
          <alias key='&quot;[federated.12dem5f0rnyfot10qun9c0nmxkff].[sum:gross_cpc_revenue_adtech_events:qk]&quot;' value='Gross Revenue Adtech events' />
          <alias key='&quot;[federated.12dem5f0rnyfot10qun9c0nmxkff].[sum:gross_revenue_bookings_daily:qk]&quot;' value='Gross Revenue Booking Daily' />
          <alias key='&quot;[federated.12dem5f0rnyfot10qun9c0nmxkff].[sum:num_requests:qk]&quot;' value='Requests' />
          <alias key='&quot;[federated.12dem5f0rnyfot10qun9c0nmxkff].[usr:Calculation_3160823319593951234:qk]&quot;' value='% Discrepancies BD vs Adtech' />
          <alias key='&quot;[federated.12dem5f0rnyfot10qun9c0nmxkff].[usr:Calculation_876724219345133569:qk]&quot;' value='Days Active' />
        </aliases>
      </column>
      <column caption='Budget Util ' datatype='real' default-format='p0.00%' name='[Budget Util (copy)_1798062187954675712]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cpc_budget_consumed])/MAX([total_monthly_budget])' />
      </column>
      <column caption='CVR' datatype='real' name='[CTR (copy)_1922896341534494722]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_orders])/SUM([num_clicks])' />
      </column>
      <column caption='Strategy copy' datatype='string' name='[Calculation_1508987385784561664]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [strategy] = &apos;pacing&apos; &#10;    AND date &lt;= DATE(2022-11-23) &#10;THEN &apos;no_pacing&apos; &#10;ELSEIF [strategy] = &apos;no_pacing&apos; THEN &apos;no_pacing&apos;&#10;ELSE &apos;pacing&apos; &#10;END' />
      </column>
      <column caption='CPC Revenue per Request' datatype='real' name='[Calculation_1922896341447086081]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cpc_revenue])/SUM([num_requests])' />
      </column>
      <column caption='Timekey Date' datatype='datetime' name='[Calculation_2688930481813221377]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETIME([timekey_24min_local])' />
      </column>
      <column caption='Budget Util per Hour' datatype='real' default-format='p0.00%' name='[Calculation_2688930484642598918]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([cpc_budget_consumed])/MAX([total_monthly_budget])' />
      </column>
      <column caption='Days Active' datatype='integer' name='[Calculation_3058929316602908673]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOOR((TODAY() - MIN([date (hourly_ctr)]) ) /2)' />
      </column>
      <column caption='filter last 2 days' datatype='boolean' name='[Calculation_3160823319592214529]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[partition_date]&lt;TODAY()-1' />
      </column>
      <column caption='% Discrepancies' datatype='real' name='[Calculation_3160823319593951234]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(zn([gross_cpc_revenue_adtech_events]))/SUM(ZN([gross_revenue_bookings_daily]))-1' />
      </column>
      <column caption='k' datatype='integer' name='[Calculation_3160823319595347972]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
