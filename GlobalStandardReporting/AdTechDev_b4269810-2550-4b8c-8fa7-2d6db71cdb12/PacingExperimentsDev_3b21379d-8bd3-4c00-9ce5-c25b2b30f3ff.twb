      <column caption='Total Revenue per Request' datatype='real' datatype-customized='true' default-format='c#,##0.0000&quot; €&quot;;-#,##0.0000&quot; €&quot;' name='[Calculation_4481644638482571266]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([cpc_revenue])+SUM([commission_eur]))/SUM([num_requests])' />
