            <column aggregation='None' caption='Impressions: Sponsored to Organic ratio (bin)' datatype='integer' name='[sponsored_to_organic_ratio (bin)]' role='dimension' type='ordinal'>
              <calculation class='bin' decimals='-1' formula='[sponsored_to_organic_ratio]' peg='0' size='0.5' />
            </column>
            <column datatype='real' name='[sponsored_to_organic_ratio]' role='measure' type='quantitative' />
            <column caption='Vendor Start Date' datatype='date' name='[start_date_vendor]' role='dimension' type='ordinal' />
            <column datatype='string' name='[vendor_class]' role='dimension' type='nominal' />
