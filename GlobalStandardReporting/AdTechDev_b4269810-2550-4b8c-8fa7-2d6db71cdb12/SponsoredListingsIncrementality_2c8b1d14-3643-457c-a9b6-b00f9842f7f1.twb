    <worksheet name='Clicks dist change'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000'>% of vendors per Clicks % change 30 days post joining Sponsored Listings</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='data' name='federated.0m3l91c0rrcnjx13hjcnk1an1vn7' />
          </datasources>
          <datasource-dependencies datasource='federated.0m3l91c0rrcnjx13hjcnk1an1vn7'>
            <column caption='Clicks % change bin' datatype='string' name='[Calculation_1940136709116583936]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [orders_per_day_prev_month_diff] &lt;= -0.75 THEN &quot;-100% to -75%&quot;&#10;ELSEIF [clicks_per_day_prev_month_diff] &lt;= -0.50 THEN &quot;-75% to -50%&quot;&#10;ELSEIF [clicks_per_day_prev_month_diff] &lt;= -0.25 THEN &quot;-50% to -25%&quot;&#10;ELSEIF [clicks_per_day_prev_month_diff] &lt;= -0.05 THEN &quot;-25% to -5%&quot;&#10;ELSEIF [clicks_per_day_prev_month_diff] &lt;= 0.05 THEN &quot;No change&quot;&#10;ELSEIF [clicks_per_day_prev_month_diff] &lt;= 0.25 THEN &quot;5% to 25%&quot;&#10;ELSEIF [clicks_per_day_prev_month_diff] &lt;= 0.5 THEN &quot;25% to 50%&quot;&#10;ELSEIF [clicks_per_day_prev_month_diff] &lt;= 0.75 THEN &quot;50% to 75%&quot;&#10;ELSEIF [clicks_per_day_prev_month_diff] &lt;= 1 THEN &quot;75% to 100%&quot;&#10;ELSEIF [clicks_per_day_prev_month_diff] &lt;= 2 THEN &quot;100% to 200%&quot;&#10;ELSEIF [clicks_per_day_prev_month_diff] &lt;= 5 THEN &quot;200% to 500%&quot;&#10;ELSEIF [clicks_per_day_prev_month_diff] &gt; 5 THEN &quot;500%+&quot;&#10;END' />
            </column>
            <column caption='Clicks Per Day Prev Month Diff' datatype='real' name='[clicks_per_day_prev_month_diff]' role='measure' type='quantitative' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column-instance column='[start_date_vendor]' derivation='MY' name='[my:start_date_vendor:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_1940136709116583936]' derivation='None' name='[none:Calculation_1940136709116583936:nk]' pivot='key' type='nominal' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[management_entity]' derivation='None' name='[none:management_entity:nk]' pivot='key' type='nominal' />
            <column-instance column='[vendor_class]' derivation='None' name='[none:vendor_class:nk]' pivot='key' type='nominal' />
            <column-instance column='[vendor_id]' derivation='None' name='[none:vendor_id:nk]' pivot='key' type='nominal' />
            <column caption='Orders Per Day Prev Month Diff' datatype='real' name='[orders_per_day_prev_month_diff]' role='measure' type='quantitative' />
            <column-instance column='[vendor_id]' derivation='CountD' name='[pcto:ctd:vendor_id:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' type='PctTotal' />
            </column-instance>
            <column caption='Vendor Start Date' datatype='date' name='[start_date_vendor]' role='dimension' type='ordinal' />
            <column datatype='string' name='[vendor_class]' role='dimension' type='nominal' />
            <column caption='Vendor Id' datatype='string' name='[vendor_id]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0m3l91c0rrcnjx13hjcnk1an1vn7].[none:Calculation_1940136709116583936:nk]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:Calculation_1940136709116583936:nk]' member='&quot;-100\% to -75\%&quot;' />
              <groupfilter function='member' level='[none:Calculation_1940136709116583936:nk]' member='&quot;-25\% to -5\%&quot;' />
              <groupfilter function='member' level='[none:Calculation_1940136709116583936:nk]' member='&quot;-50\% to -25\%&quot;' />
              <groupfilter function='member' level='[none:Calculation_1940136709116583936:nk]' member='&quot;-75\% to -50\%&quot;' />
              <groupfilter function='member' level='[none:Calculation_1940136709116583936:nk]' member='&quot;100\% to 200\%&quot;' />
              <groupfilter function='member' level='[none:Calculation_1940136709116583936:nk]' member='&quot;200\% to 500\%&quot;' />
              <groupfilter function='member' level='[none:Calculation_1940136709116583936:nk]' member='&quot;25\% to 50\%&quot;' />
              <groupfilter function='member' level='[none:Calculation_1940136709116583936:nk]' member='&quot;5\% to 25\%&quot;' />
              <groupfilter function='member' level='[none:Calculation_1940136709116583936:nk]' member='&quot;50\% to 75\%&quot;' />
              <groupfilter function='member' level='[none:Calculation_1940136709116583936:nk]' member='&quot;500\%+&quot;' />
              <groupfilter function='member' level='[none:Calculation_1940136709116583936:nk]' member='&quot;75\% to 100\%&quot;' />
              <groupfilter function='member' level='[none:Calculation_1940136709116583936:nk]' member='&quot;No change&quot;' />
