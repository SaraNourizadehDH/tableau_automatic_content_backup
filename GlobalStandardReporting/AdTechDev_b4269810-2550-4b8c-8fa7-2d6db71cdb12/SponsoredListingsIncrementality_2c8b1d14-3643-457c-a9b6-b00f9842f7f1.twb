    <worksheet name='Impressions dist change'>
      <table>
        <view>
          <datasources>
            <datasource caption='data' name='federated.0m3l91c0rrcnjx13hjcnk1an1vn7' />
          </datasources>
          <datasource-dependencies datasource='federated.0m3l91c0rrcnjx13hjcnk1an1vn7'>
            <column caption='Impressions % change bin' datatype='string' name='[Calculation_709105893494353925]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [imp_per_day_prev_month_diff] &lt;= -0.75 THEN &quot;-100% to -75%&quot;&#10;ELSEIF [imp_per_day_prev_month_diff] &lt;= -0.50 THEN &quot;-75% to -50%&quot;&#10;ELSEIF [imp_per_day_prev_month_diff] &lt;= -0.25 THEN &quot;-50% to -25%&quot;&#10;ELSEIF [imp_per_day_prev_month_diff] &lt;= -0.05 THEN &quot;-25% to -5%&quot;&#10;ELSEIF [imp_per_day_prev_month_diff] &lt;= 0.05 THEN &quot;No change&quot;&#10;ELSEIF [imp_per_day_prev_month_diff] &lt;= 0.25 THEN &quot;5% to 25%&quot;&#10;ELSEIF [imp_per_day_prev_month_diff] &lt;= 0.5 THEN &quot;25% to 50%&quot;&#10;ELSEIF [imp_per_day_prev_month_diff] &lt;= 0.75 THEN &quot;50% to 75%&quot;&#10;ELSEIF [imp_per_day_prev_month_diff] &lt;= 1 THEN &quot;75% to 100%&quot;&#10;ELSEIF [imp_per_day_prev_month_diff] &lt;= 2 THEN &quot;100% to 200%&quot;&#10;ELSEIF [imp_per_day_prev_month_diff] &lt;= 5 THEN &quot;200% to 500%&quot;&#10;ELSEIF [imp_per_day_prev_month_diff] &gt; 5 THEN &quot;500%+&quot;&#10;END' />
            </column>
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column datatype='real' name='[imp_per_day_prev_month_diff]' role='measure' type='quantitative' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column-instance column='[start_date_vendor]' derivation='MY' name='[my:start_date_vendor:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_709105893494353925]' derivation='None' name='[none:Calculation_709105893494353925:nk]' pivot='key' type='nominal' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[management_entity]' derivation='None' name='[none:management_entity:nk]' pivot='key' type='nominal' />
            <column-instance column='[vendor_class]' derivation='None' name='[none:vendor_class:nk]' pivot='key' type='nominal' />
