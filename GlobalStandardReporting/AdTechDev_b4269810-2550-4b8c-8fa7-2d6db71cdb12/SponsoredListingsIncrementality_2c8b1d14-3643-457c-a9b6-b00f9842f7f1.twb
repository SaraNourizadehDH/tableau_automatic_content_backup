    <worksheet name='Orders dist'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='15'>% of vendors per Orders per day bucket 30 days pre-post joining Sponsored Listings</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='data' name='federated.0m3l91c0rrcnjx13hjcnk1an1vn7' />
          </datasources>
          <datasource-dependencies datasource='federated.0m3l91c0rrcnjx13hjcnk1an1vn7'>
            <column caption='Percentage of total' datatype='real' default-format='p0.0%' name='[Calculation1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([vendor_id]) / TOTAL(COUNTD([vendor_id]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Difference in vendor %' datatype='real' name='[Calculation_709105893456580610]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF LOOKUP(MIN([period]), 0) &gt; LOOKUP(MIN([period]), -1)&#10;   THEN&#10;    (LOOKUP([Calculation1], 0) - LOOKUP([Calculation1], -1)) * 100&#10;ELSE NULL&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column aggregation='None' caption='Orders per day (bin)' datatype='integer' name='[Cpc Orders Per Day (bin)]' role='dimension' type='ordinal'>
              <calculation class='bin' decimals='0' formula='[cpc_orders_per_day]' peg='0' size='5' />
            </column>
            <column caption='Cpc Orders Per Day' datatype='real' name='[cpc_orders_per_day]' role='dimension' type='quantitative' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column-instance column='[start_date_vendor]' derivation='MY' name='[my:start_date_vendor:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Cpc Orders Per Day (bin)]' derivation='None' name='[none:Cpc Orders Per Day (bin):ok]' pivot='key' type='ordinal' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[management_entity]' derivation='None' name='[none:management_entity:nk]' pivot='key' type='nominal' />
            <column-instance column='[period]' derivation='None' name='[none:period:nk]' pivot='key' type='nominal' />
            <column-instance column='[vendor_class]' derivation='None' name='[none:vendor_class:nk]' pivot='key' type='nominal' />
            <column-instance column='[vendor_id]' derivation='None' name='[none:vendor_id:nk]' pivot='key' type='nominal' />
            <column caption='Period' datatype='string' name='[period]' role='dimension' type='nominal' />
            <column caption='Vendor Start Date' datatype='date' name='[start_date_vendor]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation1]' derivation='User' name='[usr:Calculation1:qk:5]' pivot='key' type='quantitative'>
              <table-calc ordering-field='[federated.0m3l91c0rrcnjx13hjcnk1an1vn7].[Cpc Orders Per Day (bin)]' ordering-type='Field' />
            </column-instance>
            <column-instance column='[Calculation_709105893456580610]' derivation='User' name='[usr:Calculation_709105893456580610:qk:16]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Field'>
                <order field='[federated.0m3l91c0rrcnjx13hjcnk1an1vn7].[Cpc Orders Per Day (bin)]' />
                <order field='[federated.0m3l91c0rrcnjx13hjcnk1an1vn7].[period]' />
              </table-calc>
              <table-calc field='[federated.0m3l91c0rrcnjx13hjcnk1an1vn7].[Calculation1]' ordering-type='Rows' />
            </column-instance>
            <column datatype='string' name='[vendor_class]' role='dimension' type='nominal' />
            <column caption='Vendor Id' datatype='string' name='[vendor_id]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0m3l91c0rrcnjx13hjcnk1an1vn7].[none:Cpc Orders Per Day (bin):ok]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:Cpc Orders Per Day (bin):ok]' member='0' />
