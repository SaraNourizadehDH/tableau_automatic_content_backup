          </datasource-dependencies>
          <filter class='categorical' column='[federated.0m3l91c0rrcnjx13hjcnk1an1vn7].[none:sponsored_to_organic_ratio (bin):ok]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:sponsored_to_organic_ratio (bin):ok]' member='0' />
