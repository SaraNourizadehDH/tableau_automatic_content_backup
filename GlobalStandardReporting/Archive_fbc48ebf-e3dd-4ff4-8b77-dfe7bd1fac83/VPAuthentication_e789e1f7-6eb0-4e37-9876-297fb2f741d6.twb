      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.179jdf30l05eiy18iirj90lilrtu].[usr:Calculation_5845179770146463749:qk]&quot;' value='Phone Auth Volume Share, %' />
        </aliases>
      </column>
      <column caption='Phone success rate, %' datatype='real' name='[Calculation_1299288504365346824]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([login__phone__succeeded])/sum([login__phone__verification_code__page_loaded])' />
      </column>
      <column caption='Splitted hostname' datatype='string' name='[Calculation_1299288504371159052]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='SPLIT([hostname],&apos;.&apos;,1)' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_1299288504377143325]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='USERNAME()=[username]' />
      </column>
      <column caption='Overall success rate, % ' datatype='real' name='[Email success rate, % (copy)_1299288504365666314]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([login_success])/sum([login_attempt])' />
      </column>
      <column caption='Email success rate, %' datatype='real' name='[Phone success rate, % (copy)_1299288504365481993]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([login__email__page_succeeded])/sum([login__email__page_loaded])' />
