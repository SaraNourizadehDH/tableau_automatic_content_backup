      <aliases enabled='yes' />
      <column caption='% Daily User Penetration (Menu)' datatype='real' name='[% User Penetration (Menu) (copy)_2341027387633020930]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([daily_menu_users_sum])/SUM([daily_users_sum])' />
      </column>
      <column caption='Entity Selector' datatype='string' name='[Calculation_2341027387624062976]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Period Granularity (copy)_1896226601799151619] = &apos;Country&apos; THEN [country_name]&#10;ELSEIF [Parameters].[Period Granularity (copy)_1896226601799151619] = &apos;Brand&apos; THEN [brand_name]&#10;END' />
      </column>
      <column caption='Daily Menu Users' datatype='real' name='[Calculation_2341027387632775169 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([daily_menu_users_sum])/MAX([days])' />
      </column>
      <column caption='% User Penetration (Menu)' datatype='real' name='[Calculation_2341027387632775169]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([menu_users])/SUM([users])' />
      </column>
      <column caption='Daily Portal Users' datatype='real' name='[Daily Menu Users (copy)_2341027387633250307]' role='measure' type='quantitative'>
