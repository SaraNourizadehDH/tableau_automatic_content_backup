    <datasource caption='vg_mss_availability' inline='true' name='federated.0bw819a1ifh8qy18v10iy1hrzhx2' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1xz9oq71axgxnp1dzjlh70im5zgn'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhh-ncr-live' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='rl_sales_revenue' server-oauth='' username='dilys.ong@foodpanda.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1xz9oq71axgxnp1dzjlh70im5zgn' name='Custom SQL Query' type='text'><![CDATA[WITH entities AS (
  SELECT
  global_entity_id
  , country_name
  , management_entity
  , brand_name
  FROM fulfillment-dwh-production.curated_data_shared_coredata.global_entities
  WHERE TRUE
  AND brand_name = 'PedidosYa'
)
,newmss AS (
  SELECT 
  'v2' version
  ,DATE(created_at) day_period
  ,DATE_TRUNC(DATE(created_at), WEEK(MONDAY)) week_period
  ,DATE_TRUNC(DATE(created_at), MONTH) month_period
  ,DATE_TRUNC(DATE(created_at), QUARTER) quarter_period
  ,global_entity_id
  ,COUNT(1) changes
  ,COUNT(CASE WHEN type_of_change IN ('OptionAvailabilityChange','ProductAvailabilityChange') THEN 1 END) availabilitychanges
  ,COUNT(CASE WHEN type_of_change = 'OptionAvailabilityChange' THEN 1 END) optionavailabilitychanges
  ,COUNT(CASE WHEN type_of_change = 'ProductAvailabilityChange' THEN 1 END) productavailabilitychanges
  FROM fulfillment-dwh-production.curated_data_shared_sales_revenue.vp_mss_history_item_availability
  WHERE TRUE 
  -- AND type_of_change IN ('OptionAvailabilityChange', 'ProductAvailabilityChange')
  AND DATE(created_at) >>= '2024-03-18'
  AND DATE(created_at) <<= '2024-06-30'
  GROUP BY 1,2,3,4,5,6
)
,oldmss AS (
  SELECT 
  'v1' version
  ,PARSE_DATE('%Y-%m-%d',day_period) day_period
  ,DATE_TRUNC(PARSE_DATE('%Y-%m-%d',day_period), WEEK(MONDAY)) week_period
  ,DATE_TRUNC(PARSE_DATE('%Y-%m-%d',day_period), MONTH) month_period
  ,DATE_TRUNC(PARSE_DATE('%Y-%m-%d',day_period), QUARTER) quarter_period
  ,global_entity_id
  ,COUNT(DISTINCT mss_id) changes
  ,COUNT(DISTINCT CASE WHEN type_of_change IN ('ChoiceAvailabilityChange','ProductAvailabilityChange') THEN mss_id END) availabilitychanges
  ,COUNT(DISTINCT CASE WHEN type_of_change = 'ChoiceAvailabilityChange' THEN mss_id END) optionavailabilitychanges
  ,COUNT(DISTINCT CASE WHEN type_of_change = 'ProductAvailabilityChange' THEN mss_id END) productavailabilitychanges
  FROM fulfillment-dwh-production.rl_sales_revenue.mss_changes
  WHERE TRUE 
  -- AND mapped_type_of_change IN ('ChoiceAvailabilityChange', 'ProductAvailabilityChange')
  AND day_period >>= '2024-03-18'
  AND day_period <<= '2024-06-30'
  AND status = 'approved'
  AND global_entity_id IN (SELECT DISTINCT global_entity_id FROM newmss)
  GROUP BY 1,2,3,4,5,6
)

SELECT 
entities.brand_name
,entities.country_name
,agg.*
,DENSE_RANK() OVER (ORDER BY week_period DESC) week_ranking
,DENSE_RANK() OVER (ORDER BY month_period DESC) month_ranking
,DENSE_RANK() OVER (ORDER BY quarter_period DESC) quarter_ranking
FROM (
  SELECT * FROM newmss 
  UNION ALL 
  SELECT * FROM oldmss
) agg
LEFT JOIN entities
ON agg.global_entity_id = entities.global_entity_id]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1xz9oq71axgxnp1dzjlh70im5zgn' name='Custom SQL Query' type='text'><![CDATA[WITH entities AS (
