      <column caption='% Option Availability Changes' datatype='real' name='[% Availability Changes (copy)_3867325464055394308]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([optionavailabilitychanges]) / SUM([changes])' />
      </column>
      <column caption='% Product Availability Changes' datatype='real' name='[% Option Availability Changes (copy)_3867325464055472133]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([productavailabilitychanges]) / SUM([changes])' />
      </column>
      <column caption='Period' datatype='date' datatype-customized='true' name='[Calculation_3867325464051998721]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;    WHEN &apos;day&apos; THEN [day_period]&#10;    WHEN &apos;week&apos; THEN [week_period]&#10;    WHEN &apos;month&apos; THEN [month_period]&#10;    WHEN &apos;quarter&apos; THEN [quarter_period]&#10;END' />
      </column>
      <column caption='Entity Selector' datatype='string' name='[Calculation_3867325464065712134]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Period Granularity (copy)_1896226601799151619] = &apos;Country&apos; THEN [country_name]&#10;ELSEIF [Parameters].[Period Granularity (copy)_1896226601799151619] = &apos;Brand&apos; THEN [brand_name]&#10;END' />
      </column>
      <column caption='max_period' datatype='boolean' datatype-customized='true' name='[Calculation_3867325464100651016]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Calculation_3867325464051998721] WHEN ({FIXED: MAX([Calculation_3867325464051998721])}) THEN TRUE END' />
      </column>
      <column caption='Period Ranking' datatype='integer' datatype-customized='true' name='[Period (copy)_6133058302593843201]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;    WHEN &apos;week&apos; THEN [week_ranking]&#10;    WHEN &apos;month&apos; THEN [month_ranking]&#10;    WHEN &apos;quarter&apos; THEN [quarter_ranking]&#10;END' />
      </column>
      <column caption='% Availability Changes' datatype='real' name='[Product Availability Changes (copy)_3867325464055275523]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([availabilitychanges]) / SUM([changes])' />
      </column>
