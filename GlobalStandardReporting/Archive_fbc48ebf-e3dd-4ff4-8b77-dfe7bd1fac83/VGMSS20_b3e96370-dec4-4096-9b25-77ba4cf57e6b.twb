      <datasource-dependencies datasource='Parameters'>
        <column alias='Week' caption='Period Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
          <calculation class='tableau' formula='&quot;week&quot;' />
          <aliases>
            <alias key='&quot;month&quot;' value='Month' />
            <alias key='&quot;quarter&quot;' value='Quarter' />
            <alias key='&quot;week&quot;' value='Week' />
          </aliases>
        </column>
        <column caption='Entity Granularity' datatype='string' name='[Period Granularity (copy)_1896226601799151619]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
          <calculation class='tableau' formula='&quot;Country&quot;' />
        </column>
      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_C68514CD5E74422D98537DCDCC9EB6BC'>
            <properties context=''>
              <relation connection='bigquery.1xz9oq71axgxnp1dzjlh70im5zgn' name='Custom SQL Query' type='text'><![CDATA[WITH entities AS (
  SELECT
  global_entity_id
  , country_name
  , management_entity
  , brand_name
  FROM fulfillment-dwh-production.curated_data_shared_coredata.global_entities
  WHERE TRUE
  AND brand_name = 'PedidosYa'
)
,newmss AS (
  SELECT 
  'v2' version
  ,DATE(created_at) day_period
  ,DATE_TRUNC(DATE(created_at), WEEK(MONDAY)) week_period
  ,DATE_TRUNC(DATE(created_at), MONTH) month_period
  ,DATE_TRUNC(DATE(created_at), QUARTER) quarter_period
  ,global_entity_id
  ,COUNT(1) changes
  ,COUNT(CASE WHEN type_of_change IN ('OptionAvailabilityChange','ProductAvailabilityChange') THEN 1 END) availabilitychanges
  ,COUNT(CASE WHEN type_of_change = 'OptionAvailabilityChange' THEN 1 END) optionavailabilitychanges
  ,COUNT(CASE WHEN type_of_change = 'ProductAvailabilityChange' THEN 1 END) productavailabilitychanges
  FROM fulfillment-dwh-production.curated_data_shared_sales_revenue.vp_mss_history_item_availability
  WHERE TRUE 
  -- AND type_of_change IN ('OptionAvailabilityChange', 'ProductAvailabilityChange')
  AND DATE(created_at) >>= '2024-03-18'
  AND DATE(created_at) <<= '2024-06-30'
  GROUP BY 1,2,3,4,5,6
)
,oldmss AS (
  SELECT 
  'v1' version
  ,PARSE_DATE('%Y-%m-%d',day_period) day_period
  ,DATE_TRUNC(PARSE_DATE('%Y-%m-%d',day_period), WEEK(MONDAY)) week_period
  ,DATE_TRUNC(PARSE_DATE('%Y-%m-%d',day_period), MONTH) month_period
  ,DATE_TRUNC(PARSE_DATE('%Y-%m-%d',day_period), QUARTER) quarter_period
  ,global_entity_id
  ,COUNT(DISTINCT mss_id) changes
  ,COUNT(DISTINCT CASE WHEN type_of_change IN ('ChoiceAvailabilityChange','ProductAvailabilityChange') THEN mss_id END) availabilitychanges
  ,COUNT(DISTINCT CASE WHEN type_of_change = 'ChoiceAvailabilityChange' THEN mss_id END) optionavailabilitychanges
  ,COUNT(DISTINCT CASE WHEN type_of_change = 'ProductAvailabilityChange' THEN mss_id END) productavailabilitychanges
  FROM fulfillment-dwh-production.rl_sales_revenue.mss_changes
  WHERE TRUE 
  -- AND mapped_type_of_change IN ('ChoiceAvailabilityChange', 'ProductAvailabilityChange')
  AND day_period >>= '2024-03-18'
  AND day_period <<= '2024-06-30'
  AND status = 'approved'
  AND global_entity_id IN (SELECT DISTINCT global_entity_id FROM newmss)
  GROUP BY 1,2,3,4,5,6
)

SELECT 
entities.brand_name
,entities.country_name
,agg.*
,DENSE_RANK() OVER (ORDER BY week_period DESC) week_ranking
,DENSE_RANK() OVER (ORDER BY month_period DESC) month_ranking
,DENSE_RANK() OVER (ORDER BY quarter_period DESC) quarter_ranking
FROM (
  SELECT * FROM newmss 
  UNION ALL 
  SELECT * FROM oldmss
) agg
LEFT JOIN entities
ON agg.global_entity_id = entities.global_entity_id]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='vg_mss_user_penetration' inline='true' name='federated.0hmtbi0064rz1b14zeksy1g1kv9b' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.00bxfhf0zul1hc10uwddl17lrqxs'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='vendor-growth-266803' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='rl_sales_revenue' server-oauth='' username='dilys.ong@foodpanda.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.00bxfhf0zul1hc10uwddl17lrqxs' name='Custom SQL Query' type='text'>WITH vpuser AS (
  SELECT DISTINCT
  user_id
  ,global_entity_id
  FROM fulfillment-dwh-production.cl_vendor.vp_users_stats
)
,entities AS (
  SELECT
  global_entity_id
  , country_name
  , management_entity
  , brand_name
  FROM fulfillment-dwh-production.curated_data_shared_coredata.global_entities
  WHERE TRUE
)
,raw AS (
  SELECT 
  event.fielddate
  ,vpuser.global_entity_id
  ,event.user_id
  ,event.section
  ,event_source
  ,MAX(event_timestamp_utc) event_timestamp
  ,COUNT(DISTINCT session_id) sessions
  ,COUNT(DISTINCT CASE WHEN section IN (&apos;menu.main&apos;) AND event_name = &apos;page_load&apos; THEN session_id END) menu_sessions
  ,COUNT(DISTINCT CASE WHEN vpm_webview_id IS NULL THEN session_id END) non_mweb_sessions
  ,COUNT(DISTINCT CASE WHEN vpm_webview_id IS NULL AND section IN (&apos;menu.main&apos;) AND event_name = &apos;page_load&apos; THEN session_id END) non_mweb_menu_sessions
  FROM fulfillment-dwh-production.cl_vendor.vp_events event
  LEFT JOIN UNNEST(event_params) param
  JOIN vpuser
  ON event.user_id = vpuser.user_id
  WHERE TRUE
  AND fielddate &gt;&gt;= &apos;2024-04-01&apos;
  AND COALESCE(is_impersonated,&apos;no&apos;) = &apos;no&apos;
  AND vpuser.global_entity_id IS NOT NULL 
  AND device_platform = &apos;WEB&apos;
  GROUP BY 1,2,3,4,5
)
,daily AS (
  SELECT 
  &apos;day&apos; period_granularity
  ,fielddate period -- week always start from Monday
  ,raw.global_entity_id
  ,raw.event_source
  ,MAX(event_timestamp) max_timestamp
  ,COUNT(DISTINCT raw.fielddate) days
  ,COUNT(DISTINCT raw.user_id) users
  ,COUNT(DISTINCT CONCAT(raw.fielddate,&apos;-&apos;,raw.user_id)) daily_users_sum
  ,COUNT(DISTINCT CASE WHEN menu_sessions&gt;&gt;0 THEN raw.user_id END) menu_users
  ,COUNT(DISTINCT CASE WHEN menu_sessions&gt;&gt;0 THEN CONCAT(raw.fielddate,&apos;-&apos;,raw.user_id) END) daily_menu_users_sum
  ,SUM(sessions) sessions
  ,SUM(menu_sessions) menu_sessions
  ,COUNT(DISTINCT CASE WHEN non_mweb_sessions &gt;&gt;0 THEN raw.user_id END) non_mweb_users
  ,COUNT(DISTINCT CASE WHEN non_mweb_sessions &gt;&gt;0 THEN CONCAT(raw.fielddate,&apos;-&apos;,raw.user_id) END) non_mweb_daily_users_sum
  ,COUNT(DISTINCT CASE WHEN non_mweb_menu_sessions&gt;&gt;0 THEN raw.user_id END) non_mweb_menu_users
  ,COUNT(DISTINCT CASE WHEN non_mweb_menu_sessions&gt;&gt;0 THEN CONCAT(raw.fielddate,&apos;-&apos;,raw.user_id) END) non_mweb_daily_menu_users_sum
  ,SUM(non_mweb_sessions) non_mweb_sessions
  ,SUM(non_mweb_menu_sessions) non_mweb_menu_sessions
  FROM raw 
  WHERE TRUE 
  AND fielddate &gt;&gt;= DATE_SUB(CURRENT_DATE(),INTERVAL 21 DAY)
  GROUP BY 1,2,3,4
)
,weekly AS (
  SELECT 
  &apos;week&apos; period_granularity
  ,DATE_TRUNC(raw.fielddate,WEEK(MONDAY)) period -- week always start from Monday
  ,raw.global_entity_id
  ,raw.event_source
  ,MAX(event_timestamp) max_timestamp
  ,COUNT(DISTINCT raw.fielddate) days
  ,COUNT(DISTINCT raw.user_id) users
  ,COUNT(DISTINCT CONCAT(raw.fielddate,&apos;-&apos;,raw.user_id)) daily_users_sum
  ,COUNT(DISTINCT CASE WHEN menu_sessions&gt;&gt;0 THEN raw.user_id END) menu_users
  ,COUNT(DISTINCT CASE WHEN menu_sessions&gt;&gt;0 THEN CONCAT(raw.fielddate,&apos;-&apos;,raw.user_id) END) daily_menu_users_sum
  ,SUM(sessions) sessions
  ,SUM(menu_sessions) menu_sessions
  ,COUNT(DISTINCT CASE WHEN non_mweb_sessions &gt;&gt;0 THEN raw.user_id END) non_mweb_users
  ,COUNT(DISTINCT CASE WHEN non_mweb_sessions &gt;&gt;0 THEN CONCAT(raw.fielddate,&apos;-&apos;,raw.user_id) END) non_mweb_daily_users_sum
  ,COUNT(DISTINCT CASE WHEN non_mweb_menu_sessions&gt;&gt;0 THEN raw.user_id END) non_mweb_menu_users
  ,COUNT(DISTINCT CASE WHEN non_mweb_menu_sessions&gt;&gt;0 THEN CONCAT(raw.fielddate,&apos;-&apos;,raw.user_id) END) non_mweb_daily_menu_users_sum
  ,SUM(non_mweb_sessions) non_mweb_sessions
  ,SUM(non_mweb_menu_sessions) non_mweb_menu_sessions
  FROM raw 
  WHERE TRUE 
  AND fielddate &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(),WEEK(MONDAY)), INTERVAL 10 WEEK)
  GROUP BY 1,2,3,4
)
,monthly AS (
  SELECT 
  &apos;month&apos; period_granularity
  ,DATE_TRUNC(raw.fielddate,MONTH) period
  ,raw.global_entity_id
  ,raw.event_source
  ,MAX(event_timestamp) max_timestamp
  ,COUNT(DISTINCT raw.fielddate) days
  ,COUNT(DISTINCT raw.user_id) users
  ,COUNT(DISTINCT CONCAT(raw.fielddate,&apos;-&apos;,raw.user_id)) daily_users_sum
  ,COUNT(DISTINCT CASE WHEN menu_sessions&gt;&gt;0 THEN raw.user_id END) menu_users
  ,COUNT(DISTINCT CASE WHEN menu_sessions&gt;&gt;0 THEN CONCAT(raw.fielddate,&apos;-&apos;,raw.user_id) END) daily_menu_users_sum
  ,SUM(sessions) sessions
  ,SUM(menu_sessions) menu_sessions
  ,COUNT(DISTINCT CASE WHEN non_mweb_sessions &gt;&gt;0 THEN raw.user_id END) non_mweb_users
  ,COUNT(DISTINCT CASE WHEN non_mweb_sessions &gt;&gt;0 THEN CONCAT(raw.fielddate,&apos;-&apos;,raw.user_id) END) non_mweb_daily_users_sum
  ,COUNT(DISTINCT CASE WHEN non_mweb_menu_sessions&gt;&gt;0 THEN raw.user_id END) non_mweb_menu_users
  ,COUNT(DISTINCT CASE WHEN non_mweb_menu_sessions&gt;&gt;0 THEN CONCAT(raw.fielddate,&apos;-&apos;,raw.user_id) END) non_mweb_daily_menu_users_sum
  ,SUM(non_mweb_sessions) non_mweb_sessions
  ,SUM(non_mweb_menu_sessions) non_mweb_menu_sessions
  FROM raw 
  WHERE TRUE 
  AND fielddate &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(),MONTH), INTERVAL 8 MONTH)
  GROUP BY 1,2,3,4
)
,quarterly AS (
  SELECT 
  &apos;quarter&apos; period_granularity
  ,DATE_TRUNC(raw.fielddate,QUARTER) period
  ,raw.global_entity_id
  ,raw.event_source
  ,MAX(event_timestamp) max_timestamp
  ,COUNT(DISTINCT raw.fielddate) days
  ,COUNT(DISTINCT raw.user_id) users
  ,COUNT(DISTINCT CONCAT(raw.fielddate,&apos;-&apos;,raw.user_id)) daily_users_sum
  ,COUNT(DISTINCT CASE WHEN menu_sessions&gt;&gt;0 THEN raw.user_id END) menu_users
  ,COUNT(DISTINCT CASE WHEN menu_sessions&gt;&gt;0 THEN CONCAT(raw.fielddate,&apos;-&apos;,raw.user_id) END) daily_menu_users_sum
  ,SUM(sessions) sessions
  ,SUM(menu_sessions) menu_sessions
  ,COUNT(DISTINCT CASE WHEN non_mweb_sessions &gt;&gt;0 THEN raw.user_id END) non_mweb_users
  ,COUNT(DISTINCT CASE WHEN non_mweb_sessions &gt;&gt;0 THEN CONCAT(raw.fielddate,&apos;-&apos;,raw.user_id) END) non_mweb_daily_users_sum
  ,COUNT(DISTINCT CASE WHEN non_mweb_menu_sessions&gt;&gt;0 THEN raw.user_id END) non_mweb_menu_users
  ,COUNT(DISTINCT CASE WHEN non_mweb_menu_sessions&gt;&gt;0 THEN CONCAT(raw.fielddate,&apos;-&apos;,raw.user_id) END) non_mweb_daily_menu_users_sum
  ,SUM(non_mweb_sessions) non_mweb_sessions
  ,SUM(non_mweb_menu_sessions) non_mweb_menu_sessions
  FROM raw 
  WHERE TRUE 
  AND fielddate &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(),QUARTER), INTERVAL 6 QUARTER)
  GROUP BY 1,2,3,4
)

SELECT 
overall.period_granularity
,overall.period
,entities.brand_name
,entities.country_name
,overall.global_entity_id
,overall.max_timestamp
,overall.event_source
,overall.days
,overall.users
,overall.daily_users_sum
,overall.menu_users
,overall.daily_menu_users_sum
,overall.sessions
,overall.menu_sessions
,overall.non_mweb_users
,overall.non_mweb_daily_users_sum
,overall.non_mweb_menu_users
,overall.non_mweb_daily_menu_users_sum
,overall.non_mweb_sessions
,overall.non_mweb_menu_sessions
FROM (
  SELECT * FROM daily UNION ALL
  SELECT * FROM weekly UNION ALL
  SELECT * FROM monthly UNION ALL
  SELECT * FROM quarterly
) overall 
LEFT JOIN entities 
ON overall.global_entity_id = entities.global_entity_id
ORDER BY period ASC</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.00bxfhf0zul1hc10uwddl17lrqxs' name='Custom SQL Query' type='text'>WITH vpuser AS (
  SELECT DISTINCT
  user_id
  ,global_entity_id
  FROM fulfillment-dwh-production.cl_vendor.vp_users_stats
)
,entities AS (
  SELECT
  global_entity_id
  , country_name
  , management_entity
  , brand_name
  FROM fulfillment-dwh-production.curated_data_shared_coredata.global_entities
  WHERE TRUE
)
,raw AS (
  SELECT 
  event.fielddate
  ,vpuser.global_entity_id
  ,event.user_id
  ,event.section
  ,event_source
  ,MAX(event_timestamp_utc) event_timestamp
  ,COUNT(DISTINCT session_id) sessions
  ,COUNT(DISTINCT CASE WHEN section IN (&apos;menu.main&apos;) AND event_name = &apos;page_load&apos; THEN session_id END) menu_sessions
  ,COUNT(DISTINCT CASE WHEN vpm_webview_id IS NULL THEN session_id END) non_mweb_sessions
  ,COUNT(DISTINCT CASE WHEN vpm_webview_id IS NULL AND section IN (&apos;menu.main&apos;) AND event_name = &apos;page_load&apos; THEN session_id END) non_mweb_menu_sessions
  FROM fulfillment-dwh-production.cl_vendor.vp_events event
  LEFT JOIN UNNEST(event_params) param
  JOIN vpuser
  ON event.user_id = vpuser.user_id
  WHERE TRUE
  AND fielddate &gt;&gt;= &apos;2024-04-01&apos;
  AND COALESCE(is_impersonated,&apos;no&apos;) = &apos;no&apos;
  AND vpuser.global_entity_id IS NOT NULL 
  AND device_platform = &apos;WEB&apos;
  GROUP BY 1,2,3,4,5
)
,daily AS (
  SELECT 
  &apos;day&apos; period_granularity
  ,fielddate period -- week always start from Monday
  ,raw.global_entity_id
  ,raw.event_source
  ,MAX(event_timestamp) max_timestamp
  ,COUNT(DISTINCT raw.fielddate) days
  ,COUNT(DISTINCT raw.user_id) users
  ,COUNT(DISTINCT CONCAT(raw.fielddate,&apos;-&apos;,raw.user_id)) daily_users_sum
  ,COUNT(DISTINCT CASE WHEN menu_sessions&gt;&gt;0 THEN raw.user_id END) menu_users
  ,COUNT(DISTINCT CASE WHEN menu_sessions&gt;&gt;0 THEN CONCAT(raw.fielddate,&apos;-&apos;,raw.user_id) END) daily_menu_users_sum
  ,SUM(sessions) sessions
  ,SUM(menu_sessions) menu_sessions
  ,COUNT(DISTINCT CASE WHEN non_mweb_sessions &gt;&gt;0 THEN raw.user_id END) non_mweb_users
  ,COUNT(DISTINCT CASE WHEN non_mweb_sessions &gt;&gt;0 THEN CONCAT(raw.fielddate,&apos;-&apos;,raw.user_id) END) non_mweb_daily_users_sum
  ,COUNT(DISTINCT CASE WHEN non_mweb_menu_sessions&gt;&gt;0 THEN raw.user_id END) non_mweb_menu_users
  ,COUNT(DISTINCT CASE WHEN non_mweb_menu_sessions&gt;&gt;0 THEN CONCAT(raw.fielddate,&apos;-&apos;,raw.user_id) END) non_mweb_daily_menu_users_sum
  ,SUM(non_mweb_sessions) non_mweb_sessions
  ,SUM(non_mweb_menu_sessions) non_mweb_menu_sessions
  FROM raw 
  WHERE TRUE 
  AND fielddate &gt;&gt;= DATE_SUB(CURRENT_DATE(),INTERVAL 21 DAY)
  GROUP BY 1,2,3,4
)
,weekly AS (
  SELECT 
  &apos;week&apos; period_granularity
  ,DATE_TRUNC(raw.fielddate,WEEK(MONDAY)) period -- week always start from Monday
  ,raw.global_entity_id
  ,raw.event_source
  ,MAX(event_timestamp) max_timestamp
  ,COUNT(DISTINCT raw.fielddate) days
  ,COUNT(DISTINCT raw.user_id) users
  ,COUNT(DISTINCT CONCAT(raw.fielddate,&apos;-&apos;,raw.user_id)) daily_users_sum
  ,COUNT(DISTINCT CASE WHEN menu_sessions&gt;&gt;0 THEN raw.user_id END) menu_users
  ,COUNT(DISTINCT CASE WHEN menu_sessions&gt;&gt;0 THEN CONCAT(raw.fielddate,&apos;-&apos;,raw.user_id) END) daily_menu_users_sum
  ,SUM(sessions) sessions
  ,SUM(menu_sessions) menu_sessions
  ,COUNT(DISTINCT CASE WHEN non_mweb_sessions &gt;&gt;0 THEN raw.user_id END) non_mweb_users
  ,COUNT(DISTINCT CASE WHEN non_mweb_sessions &gt;&gt;0 THEN CONCAT(raw.fielddate,&apos;-&apos;,raw.user_id) END) non_mweb_daily_users_sum
  ,COUNT(DISTINCT CASE WHEN non_mweb_menu_sessions&gt;&gt;0 THEN raw.user_id END) non_mweb_menu_users
  ,COUNT(DISTINCT CASE WHEN non_mweb_menu_sessions&gt;&gt;0 THEN CONCAT(raw.fielddate,&apos;-&apos;,raw.user_id) END) non_mweb_daily_menu_users_sum
  ,SUM(non_mweb_sessions) non_mweb_sessions
  ,SUM(non_mweb_menu_sessions) non_mweb_menu_sessions
  FROM raw 
  WHERE TRUE 
  AND fielddate &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(),WEEK(MONDAY)), INTERVAL 10 WEEK)
  GROUP BY 1,2,3,4
)
,monthly AS (
  SELECT 
  &apos;month&apos; period_granularity
  ,DATE_TRUNC(raw.fielddate,MONTH) period
  ,raw.global_entity_id
  ,raw.event_source
  ,MAX(event_timestamp) max_timestamp
  ,COUNT(DISTINCT raw.fielddate) days
  ,COUNT(DISTINCT raw.user_id) users
  ,COUNT(DISTINCT CONCAT(raw.fielddate,&apos;-&apos;,raw.user_id)) daily_users_sum
  ,COUNT(DISTINCT CASE WHEN menu_sessions&gt;&gt;0 THEN raw.user_id END) menu_users
  ,COUNT(DISTINCT CASE WHEN menu_sessions&gt;&gt;0 THEN CONCAT(raw.fielddate,&apos;-&apos;,raw.user_id) END) daily_menu_users_sum
  ,SUM(sessions) sessions
  ,SUM(menu_sessions) menu_sessions
  ,COUNT(DISTINCT CASE WHEN non_mweb_sessions &gt;&gt;0 THEN raw.user_id END) non_mweb_users
  ,COUNT(DISTINCT CASE WHEN non_mweb_sessions &gt;&gt;0 THEN CONCAT(raw.fielddate,&apos;-&apos;,raw.user_id) END) non_mweb_daily_users_sum
  ,COUNT(DISTINCT CASE WHEN non_mweb_menu_sessions&gt;&gt;0 THEN raw.user_id END) non_mweb_menu_users
  ,COUNT(DISTINCT CASE WHEN non_mweb_menu_sessions&gt;&gt;0 THEN CONCAT(raw.fielddate,&apos;-&apos;,raw.user_id) END) non_mweb_daily_menu_users_sum
  ,SUM(non_mweb_sessions) non_mweb_sessions
  ,SUM(non_mweb_menu_sessions) non_mweb_menu_sessions
  FROM raw 
  WHERE TRUE 
  AND fielddate &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(),MONTH), INTERVAL 8 MONTH)
  GROUP BY 1,2,3,4
)
,quarterly AS (
  SELECT 
  &apos;quarter&apos; period_granularity
  ,DATE_TRUNC(raw.fielddate,QUARTER) period
  ,raw.global_entity_id
  ,raw.event_source
  ,MAX(event_timestamp) max_timestamp
  ,COUNT(DISTINCT raw.fielddate) days
  ,COUNT(DISTINCT raw.user_id) users
  ,COUNT(DISTINCT CONCAT(raw.fielddate,&apos;-&apos;,raw.user_id)) daily_users_sum
  ,COUNT(DISTINCT CASE WHEN menu_sessions&gt;&gt;0 THEN raw.user_id END) menu_users
  ,COUNT(DISTINCT CASE WHEN menu_sessions&gt;&gt;0 THEN CONCAT(raw.fielddate,&apos;-&apos;,raw.user_id) END) daily_menu_users_sum
  ,SUM(sessions) sessions
  ,SUM(menu_sessions) menu_sessions
  ,COUNT(DISTINCT CASE WHEN non_mweb_sessions &gt;&gt;0 THEN raw.user_id END) non_mweb_users
  ,COUNT(DISTINCT CASE WHEN non_mweb_sessions &gt;&gt;0 THEN CONCAT(raw.fielddate,&apos;-&apos;,raw.user_id) END) non_mweb_daily_users_sum
  ,COUNT(DISTINCT CASE WHEN non_mweb_menu_sessions&gt;&gt;0 THEN raw.user_id END) non_mweb_menu_users
  ,COUNT(DISTINCT CASE WHEN non_mweb_menu_sessions&gt;&gt;0 THEN CONCAT(raw.fielddate,&apos;-&apos;,raw.user_id) END) non_mweb_daily_menu_users_sum
  ,SUM(non_mweb_sessions) non_mweb_sessions
  ,SUM(non_mweb_menu_sessions) non_mweb_menu_sessions
  FROM raw 
  WHERE TRUE 
  AND fielddate &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(),QUARTER), INTERVAL 6 QUARTER)
  GROUP BY 1,2,3,4
)

