  AND status = 'approved'
  AND global_entity_id IN (SELECT DISTINCT global_entity_id FROM newmss)
  GROUP BY 1,2,3,4,5,6
)

SELECT 
entities.brand_name
,entities.country_name
,agg.*
,DENSE_RANK() OVER (ORDER BY week_period DESC) week_ranking
,DENSE_RANK() OVER (ORDER BY month_period DESC) month_ranking
,DENSE_RANK() OVER (ORDER BY quarter_period DESC) quarter_ranking
FROM (
  SELECT * FROM newmss 
  UNION ALL 
  SELECT * FROM oldmss
) agg
LEFT JOIN entities
ON agg.global_entity_id = entities.global_entity_id]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
