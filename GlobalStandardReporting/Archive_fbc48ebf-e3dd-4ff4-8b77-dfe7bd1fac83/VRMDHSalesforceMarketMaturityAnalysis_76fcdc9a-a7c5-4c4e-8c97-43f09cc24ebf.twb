              <calculation class='tableau' formula='SUM(if [kpi_calculation] = &apos;sum_1_div_sum_2&apos; then [kpi_1] end) &#10;/ &#10;SUM(if [kpi_calculation] = &apos;sum_1_div_sum_2&apos; then [kpi_2] end)' />
            </column>
            <column caption='Entity' datatype='string' name='[Calculation_3177078458981003264]' role='dimension' type='nominal'>
