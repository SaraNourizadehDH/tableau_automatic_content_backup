              <calculation class='tableau' formula='SUM(if [kpi_calculation] = &apos;sum_1_mtoh_div_sum_2&apos; then [kpi_1]/60 end) &#10;/ &#10;SUM(if [kpi_calculation] = &apos;sum_1_mtoh_div_sum_2&apos; then [kpi_2] end)' />
            </column>
            <column caption='sum_1_div_sum_2_perc ' datatype='real' default-format='p0.0%' name='[sum_1_div_sum_2 (copy)_1209638762586685447]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [kpi_calculation] = &apos;sum_1_div_sum_2_perc&apos; then [kpi_1] end) &#10;/ &#10;SUM(if [kpi_calculation] = &apos;sum_1_div_sum_2_perc&apos; then [kpi_2] end)&#10;&#10;&#10;/*&#10;SUM(if [Kpi Calculation] = &apos;sum_1_div_sum_2_perc&apos; and ([Kpi Name Final] = &apos;OD CR% (LN data)&apos; OR [Kpi Name Final] = &apos;MP CR% (LN data)&apos;) and TODAY()&gt;=DATE(DATEADD(&apos;day&apos;,50,[Tim Day])) THEN [Kpi 1]&#10;        ELSEIF [Kpi Calculation] = &apos;sum_1_div_sum_2_perc&apos; and ([Kpi Name Final] != &apos;OD CR% (LN data)&apos; AND [Kpi Name Final] != &apos;MP CR% (LN data)&apos;) THEN [Kpi 1]&#10;        ELSE 0 end) &#10;    / &#10;    SUM(if [Kpi Calculation] = &apos;sum_1_div_sum_2_perc&apos; and ([Kpi Name Final] = &apos;OD CR% (LN data)&apos; OR [Kpi Name Final] = &apos;MP CR% (LN data)&apos;) and TODAY()&gt;=DATE(DATEADD(&apos;day&apos;,50,[Tim Day])) THEN [Kpi 2]&#10;        ELSEIF [Kpi Calculation] = &apos;sum_1_div_sum_2_perc&apos; and ([Kpi Name Final] != &apos;OD CR% (LN data)&apos; AND [Kpi Name Final] != &apos;MP CR% (LN data)&apos;) THEN [Kpi 2]&#10;        ELSE 0 end)&#10;*/' />
            </column>
            <column caption='sum_1_div_sum_2_min_to_hours ' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[sum_1_div_sum_2_perc (copy)_4989425496524021760]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='( SUM(if [kpi_calculation] = &apos;sum_1_div_sum_2_min_to_hours&apos; then [kpi_1] end) &#10;  / &#10;  SUM(if [kpi_calculation] = &apos;sum_1_div_sum_2_min_to_hours&apos; then [kpi_2] end)&#10;)&#10;/60' />
            </column>
            <column caption='sum_1_mtod_div_sum_2' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[sum_1_mtoh_div_sum_2 (copy)_187743831257153539]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [kpi_calculation] = &apos;sum_1_mtod_div_sum_2&apos; then [kpi_1]/(60*24) end) &#10;/ &#10;sum(if [kpi_calculation] = &apos;sum_1_mtod_div_sum_2&apos; then [kpi_2] end)' />
