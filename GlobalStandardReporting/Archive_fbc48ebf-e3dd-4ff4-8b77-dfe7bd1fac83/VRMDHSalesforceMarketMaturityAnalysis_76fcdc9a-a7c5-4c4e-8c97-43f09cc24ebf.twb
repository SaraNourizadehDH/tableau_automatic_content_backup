      <aliases enabled='yes' />
      <column caption='sum_1_div_sum_2 ' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1209638762244542464]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [kpi_calculation] = &apos;sum_1_div_sum_2&apos; then [kpi_1] end) &#10;/ &#10;SUM(if [kpi_calculation] = &apos;sum_1_div_sum_2&apos; then [kpi_2] end)' />
      </column>
      <column caption='Total_months_selected' datatype='integer' name='[Calculation_2556426138143510532]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(MONTH([tim_day]))' />
      </column>
      <column caption='Entity' datatype='string' name='[Calculation_3177078458981003264]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT([global_entity_id],2) + &quot; - &quot; + [country]' />
      </column>
      <column caption='Feature Enablement' datatype='boolean' name='[Calculation_3177078458989936642]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [enablement]=&quot;true&quot; then TRUE else FALSE end' />
      </column>
      <column caption='sum_1 ' datatype='real' name='[Calculation_389139183725850624]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [kpi_calculation] = &apos;sum_1&apos; then [kpi_1] end)' />
      </column>
      <column caption='MAX(0.2)' datatype='real' name='[Calculation_389139184775761921]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX(0.0)' />
      </column>
      <column caption='Enablement Measure' datatype='integer' name='[Calculation_389139184827342850]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [enablement] =&apos;true&apos; then 1 else 0 end' />
      </column>
      <column caption='Total Enablement count' datatype='integer' name='[Calculation_389139184831983620]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([enablement])' />
      </column>
      <column caption='% Completion' datatype='real' name='[Calculation_389139184832110597]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_389139184827342850])/[Calculation_389139184831983620]' />
      </column>
      <column caption='String % completion' datatype='string' name='[Calculation_389139184842133510]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR([Calculation_389139184832110597]) + str(min([Calculation_3177078458981003264]))' />
      </column>
      <column caption='sum_1 PREVIOUS VALUE DELTA' datatype='real' default-format='p0.0%' name='[Calculation_4584945899085148173]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_389139183725850624]-[sum_1  (copy)_4584945899080040455])&#10;/&#10;[sum_1  (copy)_4584945899080040455]' />
      </column>
