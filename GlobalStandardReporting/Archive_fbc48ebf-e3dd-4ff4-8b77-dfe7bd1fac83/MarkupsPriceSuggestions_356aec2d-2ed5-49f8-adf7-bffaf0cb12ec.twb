      <aliases enabled='yes' />
      <column caption='% Vendors Interacting with Suggestions' datatype='real' name='[% Has OW Sessions (copy)_63402257177956359]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([suggestion_interacted])&#10;/&#10;SUM([suggestion_load])' />
      </column>
      <column caption='% Vendors with Suggestions Loaded' datatype='real' name='[% Price Suggestions Interacted (copy)_63402257178054664]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([suggestion_load])&#10;/&#10;SUM([has_ow_sessions])' />
      </column>
      <column caption='% Suggestions Rejected' datatype='real' name='[% Suggestions Accepted (copy)_63402257169965060]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([suggestion_rejected])/SUM([suggestion_load])' />
      </column>
      <column caption='% Suggestions Accepted' datatype='real' name='[% Suggestions Interacted (copy)_63402257169817603]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([suggestion_accepted])/SUM([suggestion_load])' />
      </column>
      <column caption='% Vendors Rejecting Suggestions' datatype='real' name='[% Vendors Accepting Suggestions (copy)_63402257181487114]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([suggestion_rejected])&#10;/&#10;SUM([suggestion_interacted])' />
      </column>
      <column caption='% Vendors Accepting Suggestions' datatype='real' name='[% Vendors Interacting with Suggestions (copy)_63402257181401097]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([suggestion_accepted])&#10;/&#10;SUM([suggestion_interacted])' />
      </column>
      <column caption='Last week detection ' datatype='boolean' name='[Calculation_180284744127946752]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [detection_date],TODAY(), &apos;monday&apos;) &gt;= 7' />
      </column>
      <column caption='Time Granularity - PS Events' datatype='string' name='[Calculation_63402257167740928]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = 1 AND [agg_granularity] = &apos;day&apos;&#10;  THEN [week_month]&#10;ELSEIF [Parameters].[Parameter 1] = 2 AND [agg_granularity] = &apos;week&apos;&#10;  THEN [week_month]&#10;END' />
      </column>
      <column caption='TG Filter' datatype='boolean' name='[Calculation_63402257168904193]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = 1 AND [agg_granularity] = &apos;day&apos;&#10;  THEN TRUE&#10;ELSEIF [Parameters].[Parameter 1] = 2 and [agg_granularity] = &apos;week&apos;&#10;  THEN TRUE&#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='% Suggestions Interacted' datatype='real' name='[Calculation_63402257169682434]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([suggestion_interacted])/SUM([suggestion_load])' />
      </column>
      <column caption='% Vendors with OW Sessions' datatype='real' name='[Calculation_63402257177825286]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([has_ow_sessions])&#10;/&#10;SUM([detected_vendors])' />
      </column>
      <column caption='OKR Success Metric - last week' datatype='real' name='[Calculation_63402257198243852]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([suggestion_accepted])&#10;/&#10;SUM([has_ow_sessions])' />
      </column>
      <column caption='Is Latest Detection Date' datatype='boolean' name='[Calculation_63402257198583821]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[detection_date] = [Calculation_63402257202827278]' />
      </column>
      <column caption='Max Detection Date' datatype='date' name='[Calculation_63402257202827278]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [source], [Calculation_180284744127946752]: MAX([detection_date])}' />
      </column>
      <column caption='_user_entitlements' datatype='boolean' name='[Calculation_63402257268006931]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='OKR Success Metric - Detection Date' datatype='real' name='[OKR Success Metric - 1 week (copy)_180284744128815106]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([suggestion_accepted])&#10;/&#10;SUM([has_ow_sessions])' />
      </column>
