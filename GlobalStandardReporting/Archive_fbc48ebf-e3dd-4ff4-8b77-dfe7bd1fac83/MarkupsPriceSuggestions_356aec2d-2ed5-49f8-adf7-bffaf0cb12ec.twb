        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Overall Detected Vendors' datatype='integer' name='[Calculation_6923017857612832768]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_5600789093649670144] + STR([detection_date]))' />
      </column>
      <column caption='Is Qualified' datatype='boolean' name='[Calculation_6923017857678536714]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [qualified] &gt; 0&#10;  THEN TRUE&#10;  ELSE FALSE&#10;END' />
      </column>
      <column caption='LB - Detection Date' datatype='string' name='[Calculation_6923017857697959959]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;For the funnel view, please select just 1 Detection Date, as some vendors could be detected across &#10;different weeks and can be counted multiple times in the funnel, leading to unexpected funnel shapes.&apos;' />
      </column>
      <column caption='Def - Overall' datatype='string' name='[Calculation_6923017857698590744]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;The vendors detected by Monitor to have price markups and sent to Appcues&apos;' />
