      </column>
      <column caption='Def - Qualified' datatype='string' name='[Def - Overall (copy)_6923017857698861081]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;The vendors qualified after Appcues conditions:&#10;1. Scrape date &lt; 30 days prior&#10;2. Consecutively Marked up&#10;3. User has not seen Appcues in the last 5 days&apos;' />
      </column>
      <column caption='Def - Has OW Sessions' datatype='string' name='[Def - Qualified (copy)_6923017857699213338]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Vendors have logged into OneWeb/Partner Portal in the week of the detection&apos;' />
