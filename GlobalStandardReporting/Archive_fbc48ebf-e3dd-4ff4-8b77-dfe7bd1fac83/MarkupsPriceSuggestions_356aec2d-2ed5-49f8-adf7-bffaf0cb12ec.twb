    <worksheet name='PS Events'>
      <table>
        <view>
          <datasources>
            <datasource caption='growth_price_suggestions_funnel+ (rl_vendor)' name='federated.1w0l67i08ba5sk11zuldc13kegr3' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Day' caption='Time Granularity - PS Events' datatype='integer' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='Day' />
                <alias key='2' value='Week' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1w0l67i08ba5sk11zuldc13kegr3'>
            <column caption='% Suggestions Rejected' datatype='real' name='[% Suggestions Accepted (copy)_63402257169965060]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([suggestion_rejected])/SUM([suggestion_load])' />
            </column>
            <column caption='% Suggestions Accepted' datatype='real' name='[% Suggestions Interacted (copy)_63402257169817603]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([suggestion_accepted])/SUM([suggestion_load])' />
            </column>
            <column caption='Time Granularity - PS Events' datatype='string' name='[Calculation_63402257167740928]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = 1 AND [agg_granularity] = &apos;day&apos;&#10;  THEN [week_month]&#10;ELSEIF [Parameters].[Parameter 1] = 2 AND [agg_granularity] = &apos;week&apos;&#10;  THEN [week_month]&#10;END' />
            </column>
            <column caption='TG Filter' datatype='boolean' name='[Calculation_63402257168904193]' role='dimension' type='nominal'>
