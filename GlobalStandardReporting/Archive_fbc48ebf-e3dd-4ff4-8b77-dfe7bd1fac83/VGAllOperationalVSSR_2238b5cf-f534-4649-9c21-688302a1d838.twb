        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0b2mdz10ryhqe11dnbegv1ows9fj' name='Custom SQL Query' type='text'>with ot as (
SELECT  
created_at,
main_product as change_type,
date_granularity,
global_entity_id,
total_request_count,
vendor_request_count_high_band as vendor_request_count,
country_name,
brand_name,
&quot;operational&quot; as main_product
FROM `fulfillment-dwh-production.cl_vendor.vssr_opening_time_datasource` 
),
ops as (
  select 
created_at,
main_product as change_type,
date_granularity,
global_entity_id,
total_request_count,
vendor_request_count,
country_name,
brand_name,
&quot;operational&quot; as main_product
  from `fulfillment-dwh-production.cl_vendor.vssr_operational_datasource`
)

select * from ot
union all
select * from ops</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
