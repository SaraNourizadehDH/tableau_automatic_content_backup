      <column caption='test' datatype='string' name='[Calculation_3737424762406932493]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF RANK_UNIQUE([Calculation_3737424762390462474]) = 1 THEN &quot;🏆&quot;&#10;ELSEIF RANK_UNIQUE([Calculation_3737424762390462474]) = 2 THEN &quot;🟢&quot;&#10;ELSEIF RANK_UNIQUE([Calculation_3737424762390462474]) = 3 THEN &quot;🟡&quot;&#10;ELSEIF RANK_UNIQUE([Calculation_3737424762390462474]) = 4 THEN &quot;🔴&quot;&#10;ELSE &quot;&quot;&#10;END'>
