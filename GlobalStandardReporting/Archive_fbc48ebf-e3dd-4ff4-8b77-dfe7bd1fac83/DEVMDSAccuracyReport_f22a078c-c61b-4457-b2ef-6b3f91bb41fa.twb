      <column caption='Radians' datatype='real' name='[Calculation_3737424762073649153]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_3737424762073542656]=5 THEN PI()/2&#10;ELSE PI()/2 - ([Calculation_3737424762073542656]-1)*2*PI()/4&#10;END' />
      </column>
      <column caption='X-Axis' datatype='real' name='[Calculation_3737424762073747458]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[metric_value] * COS([Calculation_3737424762073649153])' />
      </column>
      <column caption='test weighted' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_3737424762390462474]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([metric_value] * [number_of_total_menus]) / [Number Of Total Menus (copy)_3737424762363039751]' />
