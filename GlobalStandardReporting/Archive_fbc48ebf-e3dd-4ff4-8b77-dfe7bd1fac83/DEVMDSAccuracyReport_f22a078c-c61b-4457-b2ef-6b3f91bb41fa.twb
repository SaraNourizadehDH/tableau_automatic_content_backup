      <column caption='Path' datatype='integer' name='[Calculation_3737424762073542656]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [metric]&#10;WHEN &apos;recall&apos; THEN 1&#10;WHEN &apos;f1&apos; THEN 2&#10;WHEN &apos;coverage&apos; THEN 3&#10;WHEN &apos;precision&apos; THEN 4&#10;ELSE 5&#10;END' />
