      <aliases enabled='yes' />
      <column caption='Mobile Count' datatype='integer' name='[Calculation_1480065803517153280]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [device_platform]=&quot;Mobile&quot; THEN [operations] END' />
      </column>
      <column caption='Month' datatype='datetime' name='[Calculation_1480065803526557700]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='datetrunc(&apos;month&apos;,[event_date])' />
      </column>
      <column caption='Dimension Calculation' datatype='string' name='[Calculation_1480065803529453575]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Entity&quot; THEN [entity]&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Region&quot; THEN [region]&#10;ELSEIF [Parameters].[Parameter 1]= &quot;Country&quot; THEN [country]&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Account Type&quot; THEN [account_type]&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Key Account Sub Category&quot; THEN [key_account_sub_category]&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Operation&quot; THEN [operation]&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Priority Queried Entities&quot; THEN [Priority Queried Entities]&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Relevant Source&quot; THEN [relevant_source]&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Vendor Grade&quot; THEN [vendor_grade]&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Vertical&quot; THEN [vertical]&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Vertical Segment&quot; THEN [vertical_segment]&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Os Name&quot; THEN [os_name]&#10;END' />
      </column>
      <column caption='Time Calculation' datatype='datetime' default-format='*Mmm dd yyyy' name='[Calculation_1480065803531341832]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&quot;Day&quot; THEN [Week (copy)_1480065803526778886]&#10;ELSEIF [Parameters].[Parameter 2]=&quot;Week&quot; THEN [Month (copy)_1480065803526660101]&#10;ELSEIF [Parameters].[Parameter 2]=&quot;Month&quot; THEN [Calculation_1480065803526557700]&#10;END' />
      </column>
      <column caption='Desktop Stats' datatype='string' name='[Calculation_1652328489299353600]' role='measure' type='nominal'>
        <calculation class='tableau' formula='REGEXP_REPLACE(REGEXP_REPLACE(STR(round(sum(round(ZN([Mobile Count (copy)_1480065803522695170]),0)),0)), &apos;([0-9](?=(?:[0-9]{3})+(?![0-9])))&apos;, &apos;$1,&apos;), &apos;:\s&apos;, &apos;: $&apos;)&#10;+&quot; (&quot;+STR(Round(ZN([Mobile Percentage (copy)_1480065803522707459])*100,2))+&quot;%)&quot;' />
      </column>
      <column caption='Time Based Metrics' datatype='boolean' name='[Calculation_5542312667432312832]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 3] = &apos;Time Based Metrics&apos;' />
      </column>
      <column caption='op create' datatype='integer' name='[Calculation_5542312667435765764]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='if [operation] = &apos;Create&apos; then [operations] end' />
      </column>
      <column caption='Mobile Stats' datatype='string' name='[Desktop Stats (copy)_1652328489303724034]' role='measure' type='nominal'>
        <calculation class='tableau' formula='REGEXP_REPLACE(REGEXP_REPLACE(STR(round(sum(round(0+ZN([Calculation_1480065803517153280]),0)),0)), &apos;([0-9](?=(?:[0-9]{3})+(?![0-9])))&apos;, &apos;$1.&apos;), &apos;:\s&apos;, &apos;: $&apos;)&#10;+&quot; (&quot;+STR(Round(0+ZN([Mobile Count (copy)_1480065803520200705])*100,2))+&quot;%)&quot;' />
      </column>
      <column caption='Dimension 2 Calculation' datatype='string' name='[Dimension Calculation (copy)_1480065803534876681]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Dimension Parameter (copy)_1480065803534962698] = &quot;Entity&quot; THEN [entity]&#10;ELSEIF [Parameters].[Dimension Parameter (copy)_1480065803534962698] = &quot;Region&quot; THEN [region]&#10;ELSEIF [Parameters].[Dimension Parameter (copy)_1480065803534962698]= &quot;Country&quot; THEN [country]&#10;ELSEIF [Parameters].[Dimension Parameter (copy)_1480065803534962698]=&quot;Account Type&quot; THEN [account_type]&#10;ELSEIF [Parameters].[Dimension Parameter (copy)_1480065803534962698]=&quot;Key Account Sub Category&quot; THEN [key_account_sub_category]&#10;ELSEIF [Parameters].[Dimension Parameter (copy)_1480065803534962698]=&quot;Operation&quot; THEN [operation]&#10;ELSEIF [Parameters].[Dimension Parameter (copy)_1480065803534962698]=&quot;Priority Queried Entities&quot; THEN [Priority Queried Entities]&#10;ELSEIF [Parameters].[Dimension Parameter (copy)_1480065803534962698]=&quot;Relevant Source&quot; THEN [relevant_source]&#10;ELSEIF [Parameters].[Dimension Parameter (copy)_1480065803534962698]=&quot;Vendor Grade&quot; THEN [vendor_grade]&#10;ELSEIF [Parameters].[Dimension Parameter (copy)_1480065803534962698]=&quot;Vertical&quot; THEN [vertical]&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Vertical Segment&quot; THEN [vertical_segment]&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Os Name&quot; THEN [os_name]&#10;END' />
      </column>
      <column caption='Mobile Percentage' datatype='real' default-format='p0.00%' name='[Mobile Count (copy)_1480065803520200705]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_1480065803517153280])/sum([operations])' />
      </column>
      <column caption='Desktop Count' datatype='integer' default-format='n#,##0;-#,##0' name='[Mobile Count (copy)_1480065803522695170]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [device_platform]=&quot;Desktop&quot; THEN [operations] END' />
      </column>
