      </semantic-values>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Entity Granularity' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Brand&quot;'>
          <calculation class='tableau' formula='&quot;Brand&quot;' />
        </column>
      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_6DA829AE83E044CB862732676D512A1A'>
            <properties context=''>
              <relation connection='bigquery.0ol4ntg09vmhom16vgqix1p6gux8' name='Custom SQL Query' type='text'><![CDATA[WITH entity AS (
    SELECT 
        management_entity
        ,segment
        ,global_entity_id
        ,brand
        ,country_name
    FROM `fulfillment-dwh-production.curated_data_shared_central_dwh.global_entities`
)
,messages AS (
  SELECT 
  -- CURRENT_DATETIME() report_date
  FORMAT_DATE('%Y-%m-%d',created_at) day_period
  ,FORMAT_DATE('%Y-W%W',DATE_TRUNC(created_at,WEEK(MONDAY))) week_period -- week always start from Monday
  ,FORMAT_DATE('%Y-%m',DATE_TRUNC(created_at,MONTH)) month_period
  ,FORMAT_DATE('%Y-Q%Q',DATE_TRUNC(created_at,QUARTER)) quarter_period
  ,DENSE_RANK() OVER (ORDER BY FORMAT_DATE('%Y-W%W',DATE_TRUNC(created_at,WEEK(MONDAY))) DESC) week_period_rank
  ,DENSE_RANK() OVER (ORDER BY FORMAT_DATE('%Y-%m',DATE_TRUNC(created_at,MONTH)) DESC) month_period_rank
  ,DENSE_RANK() OVER (ORDER BY FORMAT_DATE('%Y-Q%Q',DATE_TRUNC(created_at,QUARTER)) DESC) quarter_period_rank
  ,global_entity_id
  ,campaign_source
  ,campaign_name
  ,campaign_id
  ,created_at
  ,read_at
  ,received_at
  ,message_id
  ,CASE WHEN received_at IS NOT NULL THEN 1 ELSE 0 END is_received
  ,CASE WHEN read_at IS NOT NULL THEN 1 ELSE 0 END is_read
  ,CASE WHEN TIMESTAMP_DIFF(read_at,received_at,DAY)<<=1 THEN 1 ELSE 0 END is_read_1_day
  ,CASE WHEN TIMESTAMP_DIFF(read_at,received_at,DAY)<<=3 THEN 1 ELSE 0 END is_read_3_day
  ,TIMESTAMP_DIFF(read_at,received_at,MILLISECOND) time_received_read
  FROM fulfillment-dwh-production.curated_data_shared.notification_inbox_messages 
  WHERE platform = 'VPO'
  AND campaign_name NOT LIKE '%VC squad test%'
  AND global_entity_id IS NOT NULL
) 
,messages_weekly AS (
  SELECT 
  'week' time_granularity
  ,week_period time_period
  ,week_period_rank time_period_rank 
  ,global_entity_id
  ,campaign_source
  ,campaign_id
  ,campaign_name
  ,FORMAT_DATE('%Y-%m-%d',created_at) created_date
  ,MAX(FORMAT_DATE('%Y-%m-%d',read_at)) max_read_date
  ,COUNT(DISTINCT message_id) messages
  ,SUM(is_received) received_messages
  ,SUM(is_read) read_messages
  ,SUM(is_read_1_day) read_messages_1_day
  ,SUM(is_read_3_day) read_messages_3_day
  ,SUM(time_received_read) time_received_read
  FROM messages
  WHERE week_period_rank<<=12
  GROUP BY 1,2,3,4,5,6,7,8
)
,messages_monthly AS (
  SELECT 
  'month' time_granularity
  ,month_period time_period
  ,month_period_rank time_period_rank 
  ,global_entity_id
  ,campaign_source
  ,campaign_id
  ,campaign_name
  ,FORMAT_DATE('%Y-%m-%d',created_at) created_date
  ,MAX(FORMAT_DATE('%Y-%m-%d',read_at)) max_read_date
  ,COUNT(DISTINCT message_id) messages
  ,SUM(is_received) received_messages
  ,SUM(is_read) read_messages
  ,SUM(is_read_1_day) read_messages_1_day
  ,SUM(is_read_3_day) read_messages_3_day
  ,SUM(time_received_read) time_received_read
  FROM messages
  WHERE month_period_rank<<=12
  GROUP BY 1,2,3,4,5,6,7,8
)
,messages_quarterly AS (
  SELECT 
  'quarter' time_granularity
  ,quarter_period time_period
  ,quarter_period_rank time_period_rank 
  ,global_entity_id
  ,campaign_source
  ,campaign_id
  ,campaign_name
  ,FORMAT_DATE('%Y-%m-%d',created_at) created_date
  ,MAX(FORMAT_DATE('%Y-%m-%d',read_at)) max_read_date
  ,COUNT(DISTINCT message_id) messages
  ,SUM(is_received) received_messages
  ,SUM(is_read) read_messages
  ,SUM(is_read_1_day) read_messages_1_day
  ,SUM(is_read_3_day) read_messages_3_day
  ,SUM(time_received_read) time_received_read
  FROM messages
  WHERE quarter_period_rank<<=6
  GROUP BY 1,2,3,4,5,6,7,8
)

SELECT 
agg.time_granularity
,agg.time_period
,agg.time_period_rank
,entity.management_entity
,entity.segment
,entity.global_entity_id
,entity.brand
,entity.country_name
,agg.campaign_source
,agg.campaign_id
,agg.campaign_name
,agg.created_date
,agg.max_read_date
,agg.messages
,agg.received_messages
,agg.read_messages
,agg.read_messages_1_day
,agg.read_messages_3_day
,agg.time_received_read
FROM (
  SELECT * FROM messages_weekly
  UNION ALL 
  SELECT * FROM messages_monthly
  UNION ALL 
  SELECT * FROM messages_quarterly
) agg
LEFT JOIN entity
ON agg.global_entity_id = entity.global_entity_id]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
