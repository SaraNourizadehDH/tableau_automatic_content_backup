      <column caption='Map Color' datatype='integer' name='[Calculation_101893973715181569]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Delivery Type&apos;&#10;    THEN&#10;        IF SUM(IF [is_dh_delivery] THEN 1 END) &gt; 0 THEN 2&#10;        ELSE 3&#10;    END&#10;WHEN &apos;None&apos; THEN NULL&#10;END' />
