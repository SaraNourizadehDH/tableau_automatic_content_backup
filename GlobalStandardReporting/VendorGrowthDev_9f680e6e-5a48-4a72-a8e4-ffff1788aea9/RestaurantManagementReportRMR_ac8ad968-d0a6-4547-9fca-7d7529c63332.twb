    <worksheet name='Platform Share'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#5073a4'>Android</run>
            <run>Æ </run>
            <run bold='true' fontcolor='#fe9d28'>IOS</run>
            <run>Æ </run>
            <run bold='true' fontcolor='#47a076'>Web</run>
            <run>Æ </run>
            <run bold='true' fontcolor='#e95757'>MobWeb</run>
            <run>Æ </run>
            <run bold='true' fontcolor='#7bb6be'>Other</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location id='PlatformShare' path='/t/GlobalStandardReporting/workbooks/RMRBQtest' revision='' site='GlobalStandardReporting' />
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (rl_sales_revenue)' name='federated.0nyvuat0pi6woa11ugd520fmyobj' />
          </datasources>
          <datasource-dependencies datasource='federated.0nyvuat0pi6woa11ugd520fmyobj'>
            <column caption='Orders per Rest' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_341992127898173441]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Successful Orders (copy 2)_1787295791378124800])&#13;&#10;/&#13;&#10;[Calculation_710724352696320001]' />
            </column>
            <column caption='User Entitlement' datatype='boolean' name='[Calculation_527484127180668928]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[username]=USERNAME()' />
            </column>
            <column caption='Rests' datatype='integer' name='[Calculation_710724352696320001]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Restaurant ID (copy) (copy)])' />
            </column>
            <column caption='Restaurant Online PKey' datatype='string' name='[Restaurant ID (copy) (copy)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_online] THEN [restaurant_id] END' />
            </column>
            <column caption='Successful Orders' datatype='integer' default-format='n#,##0;-#,##0' name='[Successful Orders (copy 2)_1787295791378124800]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(IF [is_contracted] THEN [successful_orders] END, 0)' />
            </column>
            <column caption='Successful Orders All Platforms' datatype='integer' default-format='n#,##0;-#,##0' name='[Successful Orders (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders_android])&#10;+ SUM([successful_orders_ios])&#10;+ SUM([successful_orders_web])&#10;+ SUM([successful_orders_mobile_web])&#10;+ SUM([successful_orders_other_platform])' />
            </column>
            <column caption='Successful Orders IOS %' datatype='real' default-format='p0.0%' name='[Successful Orders Android % (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders_ios])&#10;/&#10;[Successful Orders (copy)]' />
            </column>
            <column caption='Successful Orders Android %' datatype='real' default-format='p0.0%' name='[Successful Orders Android (copy)]' role='measure' type='quantitative'>
