      <column caption='AOV YoY' datatype='real' default-format='p0%' name='[AOV MoM (copy 2)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_341992127902597124]&#13;&#10;/&#13;&#10;[Calculation_110056743087624192]&#13;&#10;-1' />
