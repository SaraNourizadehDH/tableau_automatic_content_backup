          <relation connection='bigquery.0zsskhv0snqjqy189tyjl10fd6sd' name='Custom SQL Query' type='text'>SELECT 
  global_entity_id as source_id
  , vendor_id as restaurant_id
  , report_month
  , &quot;&quot; as primary_key
  , city
  , vendor_name as restaurant_name
  , brand_name
  , is_online
  , is_contracted
  , is_key_account
  , is_crosslisting
  , store_type_l2 as shop_type
  ,  is_kitchen
  , is_concept
  , main_cuisine_group_global
  , latitude
  , longitude
  , new_online
  , is_online_previous_year
  , is_own_delivery as is_dh_delivery
  , total_orders
  , total_orders_previous_month
  , total_orders_previous_year
  , successful_orders
  , successful_orders_previous_month
  , successful_orders_previous_year  
  , failed_orders
  , failed_orders_previous_month
  , failed_orders_previous_year
  , cancelled_orders
  , fail_rate_rest_level
  , financial_results.commission_eur as amt_commission_eur
  , financial_results.commission_eur_previous_month as amt_commission_eur_previous_month
  , financial_results.commission_eur_previous_year as amt_commission_eur_previous_year
  , financial_results.gmv_eur as amt_gmv_eur
  , financial_results.gmv_eur_previous_month as amt_gmv_eur_previous_month
  , financial_results.gmv_eur_previous_year as amt_gmv_eur_previous_year
  , financial_results.commission_base_eur as amt_cv_eur
  , financial_results.commission_base_eur_previous_month as amt_cv_eur_previous_month 
  , financial_results.commission_base_eur_previous_year as amt_cv_eur_previous_year
  , financial_results.delivery_fee_eur as amt_delivery_fee_eur
  , converted_rating_total
  , rated_order_count
  , total_customers
  , acquisition_customers
  , commission_rate_bucket
  , fail_rate_bucket
  , &quot;&quot; as joker_accepted
  , &quot;&quot; as joker_sold_all
  , &quot;&quot; as joker_sold_successful
  , successful_orders_voucher
  , successful_orders_online_payment
  , successful_orders_mobile_app
  , successful_orders_ios
  , successful_orders_android
  , successful_orders_mobile_web
  , successful_orders_web
  , successful_orders_other_platform
  , financial_results.voucher_eur as amt_voucher_eur
  , delivery_time_m_sum
  , delivery_time_m_count
  , segment as region
  , management_entity as management_entity_group
  , sub_entity as display_name
  , country_name as common_name
FROM `fulfillment-dwh-production.rl_sales_revenue.vendor_management_report`</relation>
