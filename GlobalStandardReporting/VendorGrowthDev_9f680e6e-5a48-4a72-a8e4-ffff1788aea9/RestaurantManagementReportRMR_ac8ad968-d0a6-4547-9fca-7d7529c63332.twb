          <datasource-dependencies datasource='federated.0nyvuat0pi6woa11ugd520fmyobj'>
            <column caption='AOV Previous Month' datatype='real' name='[AOV Previous Year (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([amt_gmv_eur_previous_month])&#10;/&#10;SUM([successful_orders_previous_month])' />
            </column>
            <column caption='Amt CV EUR' datatype='real' default-format='c&quot;€&quot;#,##0;(&quot;€&quot;#,##0)' name='[Amt Cv Eur (copy)_1787295791380127747]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_contracted] THEN [amt_cv_eur] END' />
            </column>
            <column caption='Orders Voucher %' datatype='real' default-format='p0.0%' name='[Calculation_1009650773044383745]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders_voucher])&#13;&#10;/&#13;&#10;SUM([Successful Orders (copy 2)_1787295791378124800])' />
            </column>
            <column caption='Commission Rate' datatype='real' default-format='p0.00%' name='[Calculation_1027946645448007682]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Commission Eur (copy)_1787295791379755010])&#13;&#10;/&#13;&#10;SUM([Amt Cv Eur (copy)_1787295791380127747])' />
            </column>
            <column caption='Delivery Time' datatype='real' default-format='n#,##0&quot;m&quot;;-#,##0&quot;m&quot;' name='[Calculation_1027946645467688963]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_time_m_sum])&#13;&#10;/&#13;&#10;SUM([delivery_time_m_count])' />
            </column>
            <column caption='Fail Rate' datatype='real' default-format='p0.0%' name='[Calculation_1027946645471223813]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_orders])&#13;&#10;/&#13;&#10;SUM([total_orders])' />
            </column>
            <column caption='AOV' datatype='real' default-format='c&quot;€&quot;#,##0.00;(&quot;€&quot;#,##0.00)' name='[Calculation_341992127902597124]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([amt_gmv_eur])&#13;&#10;/&#13;&#10;SUM([successful_orders])' />
            </column>
            <column caption='Avg. Rating' datatype='real' default-format='p0.0%' name='[Calculation_341992127914827782]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([converted_rating_total])&#13;&#10;/&#13;&#10;SUM([rated_order_count])' />
            </column>
            <column caption='User Entitlement' datatype='boolean' name='[Calculation_527484127180668928]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[username]=USERNAME()' />
            </column>
            <column caption='Rests' datatype='integer' name='[Calculation_710724352696320001]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Restaurant ID (copy) (copy)])' />
            </column>
            <column caption='Orders MoM' datatype='real' default-format='p0%' name='[Calculation_825566138244321282]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Successful Orders (copy 2)_1787295791378124800])&#13;&#10;/&#13;&#10;SUM([successful_orders_previous_month])&#13;&#10;-1' />
            </column>
            <column caption='Commission EUR' datatype='real' default-format='c&quot;€&quot;#,##0;-&quot;€&quot;#,##0' name='[Commission Eur (copy)_1787295791379755010]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_contracted] THEN [amt_commission_eur] END' />
            </column>
            <column caption='GMV EUR' datatype='real' default-format='c&quot;€&quot;#,##0;(&quot;€&quot;#,##0)' name='[GMV (copy)_1787295791378759681]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_contracted] THEN [amt_gmv_eur] END' />
            </column>
            <column caption='AOV MoM' datatype='real' default-format='p0%' name='[GMV MoM (copy 2)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_341992127902597124]&#13;&#10;/&#13;&#10;[AOV Previous Year (copy)]&#13;&#10;-1' />
            </column>
            <column caption='Fail Rate MoM (pp)' datatype='real' default-format='n#,##0.0&quot;pp&quot;;-#,##0.0&quot;pp&quot;' name='[GMV MoM (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1027946645471223813]&#13;&#10;-&#13;&#10;(&#13;&#10;    SUM([failed_orders_previous_month])&#13;&#10;    /&#13;&#10;    SUM([total_orders_previous_month])&#13;&#10;))&#13;&#10;*100' />
            </column>
            <column caption='GMV MoM' datatype='real' default-format='p0%' name='[Orders MoM (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([GMV (copy)_1787295791378759681])&#13;&#10;/&#13;&#10;SUM([amt_gmv_eur_previous_month])&#13;&#10;-1' />
            </column>
            <column caption='Restaurant Online PKey' datatype='string' name='[Restaurant ID (copy) (copy)]' role='dimension' type='nominal'>
