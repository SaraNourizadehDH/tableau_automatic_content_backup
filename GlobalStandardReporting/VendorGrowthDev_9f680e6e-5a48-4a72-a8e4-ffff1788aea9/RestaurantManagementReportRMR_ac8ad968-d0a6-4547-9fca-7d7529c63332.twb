    <worksheet name='Card - Comm'>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (rl_sales_revenue)' name='federated.0nyvuat0pi6woa11ugd520fmyobj' />
          </datasources>
          <datasource-dependencies datasource='federated.0nyvuat0pi6woa11ugd520fmyobj'>
            <column caption='Commission Rate MoM' datatype='real' default-format='n#,##0.00&quot;pp&quot;;-#,##0.00&quot;pp&quot;' name='[AOV MoM (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;    [Calculation_1027946645448007682]&#13;&#10;    -&#13;&#10;    (&#13;&#10;        SUM([amt_commission_eur_previous_month])&#13;&#10;        /&#13;&#10;        SUM([amt_cv_eur_previous_month])&#13;&#10;    )&#13;&#10;)&#13;&#10;*100' />
            </column>
            <column caption='Amt CV EUR' datatype='real' default-format='c&quot;€&quot;#,##0;(&quot;€&quot;#,##0)' name='[Amt Cv Eur (copy)_1787295791380127747]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_contracted] THEN [amt_cv_eur] END' />
            </column>
            <column caption='Commission Rate' datatype='real' default-format='p0.00%' name='[Calculation_1027946645448007682]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Commission Eur (copy)_1787295791379755010])&#13;&#10;/&#13;&#10;SUM([Amt Cv Eur (copy)_1787295791380127747])' />
            </column>
            <column caption='User Entitlement' datatype='boolean' name='[Calculation_527484127180668928]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[username]=USERNAME()' />
            </column>
            <column caption='Commission EUR' datatype='real' default-format='c&quot;€&quot;#,##0;-&quot;€&quot;#,##0' name='[Commission Eur (copy)_1787295791379755010]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_contracted] THEN [amt_commission_eur] END' />
            </column>
            <column caption='Commission Rate YoY' datatype='real' default-format='n#,##0.00&quot;pp&quot;;-#,##0.00&quot;pp&quot;' name='[Commission Rate MoM (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;    [Calculation_1027946645448007682]&#13;&#10;    -&#13;&#10;    (&#13;&#10;        SUM([amt_commission_eur_previous_month])&#13;&#10;        /&#13;&#10;        SUM([amt_cv_eur_previous_year])&#13;&#10;    )&#13;&#10;)&#13;&#10;*100' />
            </column>
            <column datatype='real' name='[amt_commission_eur]' role='measure' type='quantitative' />
            <column datatype='real' name='[amt_commission_eur_previous_month]' role='measure' type='quantitative' />
            <column datatype='real' name='[amt_cv_eur]' role='measure' type='quantitative' />
