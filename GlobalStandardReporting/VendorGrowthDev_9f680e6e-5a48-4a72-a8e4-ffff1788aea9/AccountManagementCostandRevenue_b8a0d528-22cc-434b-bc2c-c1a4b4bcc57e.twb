    <worksheet name='Management Entity - Share %'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontname='Euphemia UCAS' fontsize='14'>Share %</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (curated_data_shared_intl_markets)' name='federated.1bw8ldv0zarhil1d8aavz1m91ku7' />
          </datasources>
          <datasource-dependencies datasource='federated.1bw8ldv0zarhil1d8aavz1m91ku7'>
            <column caption='User Entitlement' datatype='boolean' name='[Calculation_1088604473691594752]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[username]=USERNAME()' />
            </column>
            <column caption='Commission' datatype='real' name='[Calculation_4647011195534999552]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[com_mp]+[com_od]' />
            </column>
            <column caption='Share %' datatype='real' name='[Calculation_4647011195535126529]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([kam]/[fx_rate])+SUM([sam]/[fx_rate]))/(SUM([ncr])+SUM([Calculation_4647011195534999552]/[fx_rate])+SUM([vfd_amount]))' />
            </column>
            <column caption='AM Costs' datatype='real' name='[Calculation_4647011195538735106]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([kam]/[fx_rate])+SUM([sam]/[fx_rate])' />
            </column>
            <column-instance column='[date]' derivation='Attribute' name='[attr:date:ok]' pivot='key' type='ordinal' />
            <column datatype='real' name='[com_mp]' role='measure' type='quantitative' />
            <column datatype='real' name='[com_od]' role='measure' type='quantitative' />
            <column datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column datatype='real' name='[fx_rate]' role='measure' type='quantitative' />
            <column datatype='real' name='[kam]' role='measure' type='quantitative' />
            <column caption='Management_Entity' datatype='string' name='[management_entity (Custom SQL Query)]' role='dimension' type='nominal' />
            <column datatype='real' name='[ncr]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1088604473691594752]' derivation='None' name='[none:Calculation_1088604473691594752:nk]' pivot='key' type='nominal' />
            <column-instance column='[management_entity (Custom SQL Query)]' derivation='None' name='[none:management_entity (Custom SQL Query):nk]' pivot='key' type='nominal' />
            <column datatype='real' name='[sam]' role='measure' type='quantitative' />
            <column-instance column='[date]' derivation='Month-Trunc' name='[tmn:date:ok]' pivot='key' type='ordinal' />
            <column caption='Username' datatype='string' name='[username]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_4647011195535126529]' derivation='User' name='[usr:Calculation_4647011195535126529:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_4647011195538735106]' derivation='User' name='[usr:Calculation_4647011195538735106:qk]' pivot='key' type='quantitative' />
            <column caption='Vfd Amount' datatype='real' name='[vfd_amount]' role='measure' type='quantitative' />
          </datasource-dependencies>
