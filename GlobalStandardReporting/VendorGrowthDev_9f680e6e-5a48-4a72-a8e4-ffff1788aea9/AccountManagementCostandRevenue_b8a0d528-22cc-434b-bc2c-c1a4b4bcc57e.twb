          <datasource-dependencies datasource='federated.1bw8ldv0zarhil1d8aavz1m91ku7'>
            <column caption='User Entitlement' datatype='boolean' name='[Calculation_1088604473691594752]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[username]=USERNAME()' />
            </column>
            <column caption='Commission' datatype='real' name='[Calculation_4647011195534999552]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[com_mp]+[com_od]' />
            </column>
            <column caption='Share %' datatype='real' name='[Calculation_4647011195535126529]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([kam]/[fx_rate])+SUM([sam]/[fx_rate]))/(SUM([ncr])+SUM([Calculation_4647011195534999552]/[fx_rate])+SUM([vfd_amount]))' />
            </column>
            <column caption='AM Costs' datatype='real' name='[Calculation_4647011195538735106]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([kam]/[fx_rate])+SUM([sam]/[fx_rate])' />
            </column>
