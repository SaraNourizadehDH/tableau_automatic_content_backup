            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[management_entity (Custom SQL Query)]' derivation='None' name='[none:management_entity (Custom SQL Query):nk]' pivot='key' type='nominal' />
            <column datatype='real' name='[sam]' role='measure' type='quantitative' />
            <column-instance column='[date]' derivation='Month-Trunc' name='[tmn:date:ok]' pivot='key' type='ordinal' />
            <column caption='Username' datatype='string' name='[username]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_4647011195535126529]' derivation='User' name='[usr:Calculation_4647011195535126529:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_4647011195538735106]' derivation='User' name='[usr:Calculation_4647011195538735106:qk]' pivot='key' type='quantitative' />
            <column caption='Vfd Amount' datatype='real' name='[vfd_amount]' role='measure' type='quantitative' />
