            <relation connection='bigquery.1ed7yi218zs76y1d3vm0h0li5ekp' name='Custom SQL Query' type='text'>WITH lucanet AS (
  SELECT DATE(date) AS date,
  global_entity_id,
  ABS(sam_personnel_costs) as sam,
  ABS(COALESCE(kam_personnel_costs, 0)) as  kam,
  commission_revenue__delivery as com_od,
  coalesce(commission_revenue_marketplace,0) as com_mp
  FROM `fulfillment-dwh-production.curated_data_shared_intl_markets.lucanet_actuals`
  WHERE date &gt;&gt;=&apos;2022-03-01&apos;
),
mbr AS (
  select
  date_month,
  global_entity_id,
  sum(total_ncr_revenue	) as total_revenue,
  sum(ifnull(cpc_revenue, 0)) as cpc_revenue,
  sum(ifnull(cpp_revenue, 0)) as cpp_revenue,
  sum(ifnull(joker_revenue_eur, 0)) as joker_revenue_eur,
  from dhh-ncr-live.analytics.ad_tech_il_mbr
  WHERE date_month &gt;&gt;=&apos;2022-03-01&apos;
  group by 1,2
),
fx as (
  SELECT DATE_TRUNC(fx_rate_date, MONTH) AS fx_month,
  global_entity_id,
  management_entity,
  f.currency_code,
  AVG(fx_rate_eur) as fx_rate
  FROM `fulfillment-dwh-production.curated_data_shared_central_dwh.fx_rates` as f
  INNER JOIN `fulfillment-dwh-production.curated_data_shared_central_dwh.global_entities` as ge
  ON f.currency_code=ge.currency_code
  WHERE DATE_TRUNC(fx_rate_date, MONTH) &gt;&gt;=&apos;2022-03-01&apos;
  AND is_platform_online is true
  AND is_reporting_enabled is true
  GROUP BY 1,2,3,4
  
)

SELECT
l.date,
l.global_entity_id,
management_entity,
fx.fx_rate,
l.sam,
l.kam,
round(l.sam / fx.fx_rate, 2) as sam_eur,
round(kam / fx.fx_rate, 2) as kam_eur,
cpc_revenue + cpp_revenue+joker_revenue_eur as ncr,
l.com_mp,
l.com_od
FROM lucanet l
JOIN mbr
ON mbr.date_month=l.date
and mbr.global_entity_id=l.global_entity_id
JOIN fx
ON fx.fx_month=l.date and fx.global_entity_id=l.global_entity_id</relation>
