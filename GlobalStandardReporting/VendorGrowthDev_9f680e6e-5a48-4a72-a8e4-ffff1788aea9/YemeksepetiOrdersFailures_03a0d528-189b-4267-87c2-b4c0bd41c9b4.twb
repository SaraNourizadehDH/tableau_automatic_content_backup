                <relation connection='bigquery.0kq7ds710tfeau18db22c0vglvlh' name='Custom SQL Query' type='text'>SELECT global_entity_id,placed_date_local as order_date,cd.city,SUM(cd.orders_failed) as failed_orders,SUM(cd.orders) as successful_orders,
FROM `fulfillment-dwh-production.curated_data_shared_central_dwh.agg_orders_city_daily`  as cd
WHERE placed_date_local &gt;&gt;=&apos;2021-01-01&apos; AND global_entity_id=&apos;YS_TR&apos; and city IN (&apos;Istanbul&apos;,&apos;Ankara&apos;,&apos;Izmir&apos;,&apos;Antalya&apos;,&apos;Bursa&apos;,&apos;Adana&apos;,&apos;Kocaeli&apos;,&apos;Eskisehir&apos;,&apos;Mugla&apos;,&apos;Mersin&apos;)
GROUP BY 1,2,3
ORDER BY 1,2,3</relation>
                <relation connection='bigquery.0kq7ds710tfeau18db22c0vglvlh' name='tableau_gsr_entitlements_global_entity_id' table='[fulfillment-dwh-production.curated_data_shared_govops].[tableau_gsr_entitlements_global_entity_id]' type='table' />
