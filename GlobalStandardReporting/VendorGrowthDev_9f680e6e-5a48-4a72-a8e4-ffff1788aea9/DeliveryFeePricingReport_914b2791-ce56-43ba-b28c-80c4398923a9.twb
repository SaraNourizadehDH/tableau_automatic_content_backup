    <worksheet name='Weekly Average DF &amp; Successful Orders '>
      <table>
        <view>
          <datasources>
            <datasource caption='delivery_fee_pricing_report (rl_sales_revenue)' name='federated.1oc25tk1du1ej20zr1u6l1eh7y64' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='# Orders Lower Threshold' datatype='integer' name='[Parameter 1]' param-domain-type='any' role='measure' type='quantitative' value='10'>
              <calculation class='tableau' formula='10' />
            </column>
            <column caption='% Orders Lower Threshold' datatype='real' name='[Parameter 2]' param-domain-type='any' role='measure' type='quantitative' value='1.5'>
              <calculation class='tableau' formula='1.5' />
            </column>
            <column caption='DF Upper Threshold' datatype='real' name='[Parameter 3]' param-domain-type='range' role='measure' type='quantitative' value='100000000.'>
              <calculation class='tableau' formula='100000000.' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1oc25tk1du1ej20zr1u6l1eh7y64'>
            <column caption='User Entitlement' datatype='boolean' name='[Calculation_177047781090508800]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[username]=USERNAME()' />
            </column>
            <column caption='Delivery Type DF Orders' datatype='integer' name='[Calculation_6618673023091159042]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [global_entity_id], [is_own_delivery], [delivery_fee_local]: SUM([successful_orders])}' />
            </column>
            <column caption='Delivery Type Orders' datatype='integer' name='[Calculation_6618673023092281347]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [global_entity_id], [is_own_delivery]: SUM([successful_orders])}' />
            </column>
            <column caption='DF Type' datatype='string' name='[Calculation_6618673023092486148]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [delivery_fee_local] = 0 THEN &quot;Free&quot;&#10;ELSEIF [Calculation_6618673023092654085] &lt;  [Parameters].[Parameter 2]/100&#10;    OR [Calculation_6618673023091159042] &lt; [Parameters].[Parameter 1]&#10;    OR [delivery_fee_local] &gt; [Parameters].[Parameter 3]&#10;    THEN &quot;Other&quot;&#10;ELSE  &quot;Main Del. Fees&quot;&#10;END' />
            </column>
            <column caption='DF % of Orders' datatype='real' name='[Calculation_6618673023092654085]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6618673023091159042]/[Calculation_6618673023092281347]' />
            </column>
            <column caption='Avg DF' datatype='real' name='[Calculation_6618673023137009675]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF ISNULL([delivery_fee_local]) = FALSE THEN [successful_orders] * [delivery_fee_local] END)&#10;/&#10;SUM(IF ISNULL([delivery_fee_local]) = FALSE THEN [successful_orders] END)' />
            </column>
            <column caption='Brand Name' datatype='string' name='[brand_name]' role='dimension' type='nominal' />
            <column aggregation='Sum' caption='Brand Rank' datatype='integer' name='[brand_rank]' role='dimension' type='ordinal'>
