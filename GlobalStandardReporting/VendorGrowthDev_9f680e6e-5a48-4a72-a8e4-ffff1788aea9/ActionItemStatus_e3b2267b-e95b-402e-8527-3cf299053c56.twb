                </clause>
                <relation connection='bigquery.0cyokmi1q8lrxd188z4ux0yskd95' name='Custom SQL Query' type='text'>WITH action_items AS (
  SELECT *
  FROM (
    SELECT global_entity_id
    , content.action_item_id
    , content.type
    , content.owner
    , content.name
    , content.start_date
    , content.end_date
    , content.status
    , content.root_cause
    , content.account_grid
    , content.timestamp
    , ROW_NUMBER() OVER(PARTITION BY content.action_item_id ORDER BY content.timestamp DESC, content.status DESC) AS rn
  FROM `fulfillment-dwh-production.curated_data_shared_data_stream.salesforce_action_item_stream`
  )
)
SELECT global_entity_id,
        status,
        date(timestamp) as timestamp,
        root_cause,
        date(start_date) as start_date,
        date(end_date) as end_date,
        count(status) as num_item
FROM action_items
WHERE date(start_date) &gt;&gt;= &quot;2022-08-25&quot;
        AND type = &apos;Order Drop Alert&apos;
        AND global_entity_id = &apos;TB_BH&apos;
GROUP BY 1,2,3,4,5,6
ORDER BY 4, 5 asc</relation>
                <relation connection='bigquery.0cyokmi1q8lrxd188z4ux0yskd95' name='tableau_gsr_entitlements_global_entity_id' table='[fulfillment-dwh-production.curated_data_shared_govops].[tableau_gsr_entitlements_global_entity_id]' type='table' />
