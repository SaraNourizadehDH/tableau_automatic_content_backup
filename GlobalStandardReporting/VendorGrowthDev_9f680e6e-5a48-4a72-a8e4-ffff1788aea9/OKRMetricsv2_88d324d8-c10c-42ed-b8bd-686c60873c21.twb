        <view>
          <datasources>
            <datasource caption='Custom SQL Query (curated_data_shared_central_dwh)' name='federated.0vojhub04e43rm14eu0fp1lao5u1' />
          </datasources>
          <datasource-dependencies datasource='federated.0vojhub04e43rm14eu0fp1lao5u1'>
            <column caption='GMV_Amount' datatype='real' name='[Calculation_2208171214905974786]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[vfd_amount]/[vfd_gmv_2]' />
            </column>
            <column caption='% VFD GMV Share' datatype='real' name='[Calculation_2208171214906122243]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vfd_amount])/SUM([Calculation_2208171214905974786])' />
            </column>
            <column caption='% Order Penetration' datatype='real' name='[Calculation_2208171215158579205]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vfd_orders])/SUM([all_orders (Sheet1)])' />
            </column>
            <column caption='vendors_vfd' datatype='real' name='[Calculation_2208171215166754822]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[active_vendors]*[vendor_penetration]' />
            </column>
            <column caption='% Vendor Penetration' datatype='real' name='[Calculation_2208171215167094791]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2208171215166754822])/SUM([active_vendors])' />
            </column>
            <column caption='30 Days Zombie' datatype='integer' name='[Calculation_3264828256289869824]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([all_30_days])-SUM([all_actives_30])' />
            </column>
            <column caption='% First 30 Days Zombies' datatype='real' name='[Calculation_3264828256290025473]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3264828256289869824]/SUM([all_30_days])' />
            </column>
            <column caption='% First 30 Days Low Orders ' datatype='real' name='[Calculation_3264828256290349058]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([low_orders_30])/SUM([all_30_days])' />
            </column>
            <column caption='All Zombies' datatype='integer' name='[Calculation_3264828256290611203]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_online])-SUM([vendors_active])' />
            </column>
            <column caption='% Zombies' datatype='real' name='[Calculation_3264828256290770948]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3264828256290611203]/SUM([vendors_online])' />
            </column>
            <column caption='Average Days to First Order' datatype='real' name='[Calculation_3264828256291450885]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([days_between])/SUM([vendors])' />
            </column>
            <column caption='Column Name' datatype='string' name='[Calculation_4367436127858692096]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;Trend&apos;' />
            </column>
            <column caption='% Low Orders' datatype='real' name='[Calculation_4854880399948001280]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([low_order_vendors])/SUM([vendors_online])' />
            </column>
            <column caption='% Zombies and Low Orders' datatype='real' name='[Calculation_4854880399990566916]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4854880399948001280]+[Calculation_3264828256290770948]' />
            </column>
            <column datatype='integer' name='[active_vendors]' role='measure' type='quantitative' />
