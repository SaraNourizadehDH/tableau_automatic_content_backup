            <column-instance column='[management_entity (Custom SQL Query)]' derivation='None' name='[none:management_entity (Custom SQL Query):nk]' pivot='key' type='nominal' />
            <column datatype='date' name='[report_month]' role='dimension' type='ordinal' />
            <column datatype='real' name='[ss_discount_other_eur]' role='measure' type='quantitative' />
