    <dashboard name='Summary' type='storyboard'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='14'>Vendor Performance Executive Summary</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/OKRMetrics_v2/Summary?rev=' id='Summary' path='/t/GlobalStandardReporting/workbooks/OKRMetrics_v2' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='964' maxwidth='1256' minheight='964' minwidth='1256' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98340' id='1' param='vert' removable='false' type-v2='layout-flow' w='98726' x='637' y='830'>
            <zone h='2697' id='3' type-v2='title' w='98726' x='637' y='830' />
            <zone h='10477' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='98726' x='637' y='3527' />
            <zone h='85166' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='98726' x='637' y='14004'>
              <flipboard active-id='2' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='Introduction' captured-sheet='Dashboard 8' id='4'>
                    <capturedDeltas>
                      <dashboard name='Dashboard 8'>
                        <zone id='3'>
                          <formatted-text>
                            <run>The first draft of OKR Metrics Dashboard, the metrics are still launching and ongoing phase on global level. Some metrics is included with entire global visibility but mostly on product portal feature based metrics are not globally launched yet. Please find the overview about the metrics availability below .

</run>
                            <run bold='true' fontsize='10'>Global Data based metrics:</run>
                            <run>Æ&#10;</run>
                            <run bold='true'>Zombies-Low Orders and First 30 Days Related Metrics: </run>
                            <run>Global visibility&#10;&#10;</run>
                            <run bold='true'>VFD Related Metrics: </run>
                            <run>
Not available for Woova,Instashop,Zomato,Carriage 

</run>
                            <run bold='true' fontsize='10'>Portal Related Metrics:</run>
                            <run>Æ&#10;&#10;</run>
                            <run bold='true'>Montly Portal Active:</run>
                            <run>Not available for DH Greece,Woowa,Insta,Zomato and Carriage
</run>
                            <run bold='true'>Menu Management:</run>
                            <run> For Talabat, Foodpanda  APAC and Yemeksepeti available
</run>
                            <run bold='true'>VFD Self Service: </run>
                            <run>For Pedidos,</run>
                            <run bold='true'>Æ </run>
                            <run>Foodpanda  APAC and Yemeksepeti available

</run>
                            <run bold='true' fontsize='10'>Salesforce Data based metrics:</run>
                            <run>Æ&#10;&#10;</run>
                            <run bold='true'>Average Onboarding Time:</run>
                            <run> Not available for DH Greece,Yemeksepeti,Woowa,Insta,Zomato and Carriage 

</run>
                            <run bold='true'>Contact Rate: </run>
                            <run>Not available for DH Greece,Yemeksepeti,Woowa,Insta,Zomato and Carriage 

The portal related contact reasons list: </run>
                            <run auto-url='true' hyperlink='tabdoc:load-url url=&amp;quot;https://docs.google.com/spreadsheets/d/16jrYXRezBbu82JxpJEcuvz657f68dPboi6LoPW2NQrQ/edit#gid=466451364&amp;quot;'>https://docs.google.com/spreadsheets/d/16jrYXRezBbu82JxpJEcuvz657f68dPboi6LoPW2NQrQ/edit#gid=466451364</run>
                            <run>Æ&#10;&#10;</run>
                            <run bold='true' fontsize='10'>Surveys based metrics:</run>
                            <run>Æ&#10;&#10;</run>
                            <run bold='true'>MM Plugin CSAT Menu Management:</run>
                            <run> Only available for Foodpanda APAC and Talabat 
</run>
                            <run bold='true'>Opening Times Plugin CSAT: </run>
                            <run>Only available for Foodpanda APAC and Talabat
</run>
                            <run bold='true'>NPS Existing Vendors:</run>
                            <run>Not available for Yemeksepeti,Woowa,Insta,Zomato and Carriage
</run>
                            <run bold='true'>NPS New Vendors:</run>
                            <run>Not available for Yemeksepeti,Woowa,Insta,Zomato and Carriage</run>
                          </formatted-text>
                        </zone>
                      </dashboard>
                    </capturedDeltas>
                  </story-point>
                  <story-point caption='OKR Group 1' captured-sheet='OKR 1 Dash' id='1'>
                    <capturedDeltas>
                      <worksheet name='ÓKR View'>
                        <filter class='categorical' column='[federated.0vojhub04e43rm14eu0fp1lao5u1].[none:management_entity (Custom SQL Query):nk]'>
