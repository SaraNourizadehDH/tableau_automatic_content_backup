          <datasource-dependencies datasource='federated.0vojhub04e43rm14eu0fp1lao5u1'>
            <column caption='Average Onboarding Days' datatype='real' name='[Calculation_1463810637502869505]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([OB_hours])/ SUM([total]))/24' />
            </column>
            <column caption='% MSS Vendor Penetration ' datatype='real' name='[Calculation_1463810637844901890]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([mss_vendors])/SUM([active_vendors_mss])' />
            </column>
            <column caption='% Portal Active ' datatype='real' name='[Calculation_2141039413118894080]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([portal_active_vendors])/SUM([available_vendors])' />
            </column>
            <column caption='% Self Service VFD/GMV Share' datatype='real' name='[Calculation_2208171214892445696]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ss_gmv_eur])/SUM([total_gmv_eur])' />
            </column>
            <column caption='% Self Service VFD Orders Share' datatype='real' name='[Calculation_2208171214892871681]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([ss_num_orders])/sum([all_orders])' />
            </column>
            <column caption='% Self Service VFD/GMV' datatype='real' name='[Calculation_2208171214917435396]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ss_discount_other_eur])/SUM([total_gmv_eur])' />
            </column>
            <column caption='Contacts per Order' datatype='real' name='[Calculation_3132323927899344896]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cases])/SUM([orders])' />
            </column>
            <column caption='VFD SS/VFD Total' datatype='real' name='[Calculation_6014557362356858881]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ss_discount_other_eur])/SUM([vfd_amount])' />
            </column>
