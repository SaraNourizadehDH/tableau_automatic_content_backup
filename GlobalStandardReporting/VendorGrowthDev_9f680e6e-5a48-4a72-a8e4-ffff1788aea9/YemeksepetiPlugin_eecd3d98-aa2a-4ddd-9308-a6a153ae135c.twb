          <relation connection='bigquery.10ats380pwflz01a04x3e13g2fds' name='Custom SQL Query' type='text'>with plugin as
(with pl_sessions as
(SELECT DISTINCT
    vs.session_date AS date
    , vs.session_id
    , vs.global_entity_id
    , vs.vendor_id
    , vs.device_category
    , vs.is_bounced_session
    , page_visits.page_name AS page_name
    , page_visits.qty_visits AS qty_visits
  FROM `fulfillment-dwh-production.cl_sales_revenue.vp_vendor_sessions` AS vs
  LEFT JOIN UNNEST(vs.page_visits) AS page_visits
  WHERE TRUE
    AND vs.session_date &gt;&gt;&apos;2022-04-30&apos; AND global_entity_id=&apos;YS_TR&apos; )

     SELECT
       date
      , pl.page_name
      , pl.global_entity_id
      , COUNT(DISTINCT pl.session_id) AS qty_sessions_with_visits
      , COUNT(DISTINCT pl.global_entity_id || pl.vendor_id) AS qty_vendors_with_visits
    FROM pl_sessions AS pl
    WHERE TRUE
      AND pl.date &gt;&gt;=&apos;2022-04-30&apos;
      AND pl.page_name IS NOT NULL
    GROUP BY 1, 2, 3 ), 
   
    portal as
  ( with sessions as 
 (SELECT DISTINCT
    ga.session_date AS date
    , REGEXP_EXTRACT((SELECT value FROM UNNEST(hits.custom_dimensions) WHERE index = 3), r&apos;(.*);&apos;) AS global_entity_id
    , REGEXP_EXTRACT((SELECT value FROM UNNEST(hits.custom_dimensions) WHERE index = 3), r&apos;;(.*)&apos;) AS vendor_id
    , ga.session_id
    , ga.user_id
    , device.device_category as device
    , CASE WHEN totals.bounces = 1 THEN TRUE ELSE FALSE END AS is_bounced_session
  FROM `fulfillment-dwh-production.cl_sales_revenue.vp_ga_sessions` AS ga
  CROSS JOIN UNNEST(ga.hits) AS hits
  WHERE TRUE
    AND ga.session_date &gt;&gt; &apos;2022-04-30&apos;
    AND (SELECT value FROM UNNEST(hits.custom_dimensions) WHERE index = 3) IS NOT NULL)
    

    SELECT date,global_entity_id,COUNT(DISTINCT vendor_id)as qty_vendors_with_sessions,COUNT(DISTINCT session_id) as sessions
    FROM sessions
    WHERE sessions.global_entity_id=&apos;YS_TR&apos; GROUP BY 1,2) 

    SELECT pl.date,pl.global_entity_id, pl.page_name, p.qty_vendors_with_sessions,qty_vendors_with_visits, qty_sessions_with_visits,sessions, ROUND(qty_vendors_with_visits/p.qty_vendors_with_sessions,4) as vendor_ratio, ROUND(qty_sessions_with_visits/sessions,4) as sessions_ratio
    FROM portal p
    JOIN plugin pl
    ON p.date=pl.date 
    ORDER BY 4 DESC</relation>
          <relation connection='bigquery.10ats380pwflz01a04x3e13g2fds' name='tableau_gsr_entitlements_global_entity_id' table='[fulfillment-dwh-production.curated_data_shared_govops].[tableau_gsr_entitlements_global_entity_id]' type='table' />
        </_.fcp.ObjectModelEncapsulateLegacy.false...relation>
