    FROM pl_sessions AS pl
    WHERE TRUE
      AND pl.date &gt;&gt;=&apos;2022-04-30&apos;
      AND pl.page_name IS NOT NULL
    GROUP BY 1, 2, 3 ), 
   
    portal as
  ( with sessions as 
 (SELECT DISTINCT
    ga.session_date AS date
    , REGEXP_EXTRACT((SELECT value FROM UNNEST(hits.custom_dimensions) WHERE index = 3), r&apos;(.*);&apos;) AS global_entity_id
    , REGEXP_EXTRACT((SELECT value FROM UNNEST(hits.custom_dimensions) WHERE index = 3), r&apos;;(.*)&apos;) AS vendor_id
    , ga.session_id
    , ga.user_id
    , device.device_category as device
