  FROM `fulfillment-dwh-production.cl_sales_revenue.vp_ga_sessions` AS ga
  CROSS JOIN UNNEST(ga.hits) AS hits
  WHERE TRUE
    AND ga.session_date &gt;&gt; &apos;2022-04-30&apos;
    AND (SELECT value FROM UNNEST(hits.custom_dimensions) WHERE index = 3) IS NOT NULL)
    

    SELECT date,global_entity_id,COUNT(DISTINCT vendor_id)as qty_vendors_with_sessions,COUNT(DISTINCT session_id) as sessions
    FROM sessions
    WHERE sessions.global_entity_id=&apos;YS_TR&apos; GROUP BY 1,2) 

    SELECT pl.date,pl.global_entity_id, pl.page_name, p.qty_vendors_with_sessions,qty_vendors_with_visits, qty_sessions_with_visits,sessions, ROUND(qty_vendors_with_visits/p.qty_vendors_with_sessions,4) as vendor_ratio, ROUND(qty_sessions_with_visits/sessions,4) as sessions_ratio
    FROM portal p
    JOIN plugin pl
    ON p.date=pl.date 
    ORDER BY 4 DESC</relation>
