            <column caption='QC Saver Order Proportion No Brainer' datatype='real' default-format='*#,##0.0%;(#,##0.0%);-' name='[Saver Order Proportion No Brainer (copy)_1603070392436777023]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(&#10;SUM(IF ISNULL([saver_fee_component_id]) = FALSE&#10;    AND&#10;[saver_fee_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;SaverFee&apos;)&#10;    AND&#10;[is_dps] = TRUE&#10;    AND&#10;[dps_saver_discount_opted_in_eur] &lt;&gt; 0&#10;&#10;    AND&#10;[vertical_parent] IN(&apos;Dmarts&apos;, &apos;Local Shops&apos;)&#10;    AND&#10;[channel] = &apos;Own Delivery&apos;&#10;THEN 1 ELSE 0 END)&#10;&#10;&#10;  /&#10;&#10;SUM(IF &#10;/*&#10;[saver_fee_assignment_type] IN (&apos;SaverFee&apos;)&#10;    AND&#10;*/&#10;[is_dps] = TRUE&#10;&#10;    AND&#10;[vertical_parent] IN(&apos;Dmarts&apos;, &apos;Local Shops&apos;)&#10;    AND&#10;[channel] = &apos;Own Delivery&apos;&#10;THEN 1 ELSE 0 END)&#10;)' />
            </column>
            <column caption='Saver Order Proportion No Brainer' datatype='real' default-format='*#,##0.0%;(#,##0.0%);-' name='[Saver Well Configured No Brainer (copy)_1603070391107498030]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(&#10;SUM(IF ISNULL([saver_fee_component_id]) = FALSE&#10;    AND&#10;[saver_fee_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;SaverFee&apos;)&#10;    AND&#10;[is_dps] = TRUE&#10;    AND&#10;[dps_saver_discount_opted_in_eur] &lt;&gt; 0&#10;&#10;    AND&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[channel] = &apos;Own Delivery&apos;&#10;THEN 1 ELSE 0 END)&#10;&#10;&#10;  /&#10;&#10;SUM(IF &#10;/*&#10;[saver_fee_assignment_type] IN (&apos;SaverFee&apos;)&#10;    AND&#10;*/&#10;[is_dps] = TRUE&#10;&#10;    AND&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[channel] = &apos;Own Delivery&apos;&#10;THEN 1 ELSE 0 END)&#10;)' />
            </column>
            <column caption='QC Saver Well Configured No Brainer' datatype='real' default-format='*#,##0.0%;(#,##0.0%);-' name='[Saver Well Configured No Brainer (copy)_1603070392436908096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(&#10;SUM(IF ISNULL([saver_fee_component_id]) = FALSE&#10;    AND&#10;[saver_fee_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;SaverFee&apos;)&#10;    AND&#10;(IFNULL([max_saver_fee], 0) - IFNULL([min_saver_fee], 0)) &lt;&gt; 0 &#10;    AND&#10;[is_dps] = TRUE&#10;    AND&#10;[dps_saver_discount_opted_in_eur] &lt;&gt; 0&#10;    AND&#10;[vertical_parent] IN(&apos;Dmarts&apos;, &apos;Local Shops&apos;)&#10;    AND&#10;[channel] = &apos;Own Delivery&apos;&#10;THEN 1 ELSE 0 END)&#10;&#10;    /&#10;&#10;SUM(IF ISNULL([saver_fee_component_id]) = FALSE&#10;    AND&#10;[saver_fee_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;SaverFee&apos;)&#10;    AND&#10;[is_dps] = TRUE&#10;    AND&#10;[vertical_parent] IN(&apos;Dmarts&apos;, &apos;Local Shops&apos;)&#10;    AND&#10;[channel] = &apos;Own Delivery&apos;&#10;THEN 1 ELSE 0 END)&#10;)' />
            </column>
            <column caption='QC Service Fee Flag No Brainer' datatype='string' name='[Service Fee Flag No Brainer (copy)_1603070392426090553]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Service Fee No Brainer (copy)_1603070392425328696] &gt;= 0.9 AND COUNT([service_fee_component_id]) &gt; 0 THEN &apos;TRUE&apos; &#10;ELSEIF [Service Fee No Brainer (copy)_1603070392425328696] &lt; 0.9 AND COUNT([service_fee_component_id]) &gt; 0 THEN &apos;FALSE&apos;&#10;ELSEIF COUNT([service_fee_component_id]) = 0 THEN &apos;NULL&apos;&#10;END' />
            </column>
            <column caption='Service Fee Proportion Order No Brainer' datatype='real' default-format='*#,##0.0%;(#,##0.0%);-' name='[Service Fee No Brainer (copy)_1603070391141773360]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(&#10;SUM(IF &#10;ISNULL(service_fee_type) = FALSE&#10;    AND&#10;[service_fee_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;Service Fee Override&apos;, &apos;Subscription&apos;)&#10;&#10;    AND&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[channel] = &apos;Pick-up&apos;&#10;THEN 1 ELSE 0&#10;END)&#10;&#10;/&#10;&#10;SUM(IF [is_dps] = TRUE &#10;&#10;    AND&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[channel] = &apos;Pick-up&apos;&#10;THEN 1 ELSE 0 END)&#10;)' />
            </column>
            <column caption='QC Service Fee No Brainer' datatype='real' default-format='*#,##0.0%;(#,##0.0%);-' name='[Service Fee No Brainer (copy)_1603070392425328696]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(&#10;SUM(IF &#10;service_fee_type = &apos;Percentage&apos;&#10;    AND&#10;[max_service_fee] &lt;&gt; [min_service_fee]&#10;    AND&#10;/*&#10;[service_fee_condition_type] &lt;&gt; &apos;New Customer&apos;&#10;*/&#10;[service_fee_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;Service Fee Override&apos;, &apos;Subscription&apos;)&#10;    AND&#10;[vertical_parent] IN (&apos;Dmarts&apos;, &apos;Local Shops&apos;)&#10;    AND&#10;[channel] = &apos;Pick-up&apos;&#10;THEN 1 ELSE 0&#10;END)&#10;&#10;/&#10;&#10;SUM(IF [is_dps] = TRUE &#10;    AND&#10;/*&#10;[service_fee_condition_type] &lt;&gt; &apos;New Customer&apos;&#10;*/&#10;[service_fee_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;Service Fee Override&apos;, &apos;Subscription&apos;)&#10;&#10;    AND&#10;[vertical_parent] IN (&apos;Dmarts&apos;, &apos;Local Shops&apos;)&#10;    AND&#10;[channel] = &apos;Pick-up&apos;&#10;THEN 1 ELSE 0 END)&#10;)' />
            </column>
            <column caption='QC Service Fee Proportion Order No Brainer' datatype='real' default-format='*#,##0.0%;(#,##0.0%);-' name='[Service Fee Proportion Order No Brainer (copy)_1603070392426663994]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(&#10;SUM(IF &#10;ISNULL(service_fee_type) = FALSE&#10;    AND&#10;[service_fee_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;Service Fee Override&apos;, &apos;Subscription&apos;)&#10;&#10;    AND&#10;[vertical_parent] IN(&apos;Dmarts&apos;, &apos;Local Shops&apos;)&#10;    AND&#10;[channel] = &apos;Pick-up&apos;&#10;THEN 1 ELSE 0&#10;END)&#10;&#10;/&#10;&#10;SUM(IF [is_dps] = TRUE &#10;&#10;    AND&#10;[vertical_parent] IN(&apos;Dmarts&apos;, &apos;Local Shops&apos;)&#10;    AND&#10;[channel] = &apos;Pick-up&apos;&#10;THEN 1 ELSE 0 END)&#10;)' />
            </column>
            <column caption='Reference' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Volume (copy)_139330180158468118]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Aggregation (copy)_166351713677688839]&#13;&#10;WHEN &apos;Orders (Total)&apos; THEN SUM(IF [is_successful] THEN 1 ELSE 0 END) / [Calculation_7704110864525000788]&#13;&#10;WHEN &apos;Customer Accounts (Total)&apos; THEN COUNTD([global_entity_id] + &apos;-&apos; + [customer_account_id]) / [Calculation_7704110864525000788]&#13;&#10;WHEN &apos;Analytical Customers (Total)&apos; THEN COUNTD([global_entity_id] + &apos;-&apos; + [analytical_customer_id]) / [Calculation_7704110864525000788]&#13;&#10;WHEN &apos;Vendors (Total)&apos; THEN COUNTD([global_entity_id] + &apos;-&apos; + [vendor_id]) / [Calculation_7704110864525000788]&#13;&#10;WHEN &apos;GMV (Total)&apos; THEN SUM([gmv_eur]) / [Calculation_7704110864525000788]&#13;&#10;WHEN &apos;Basket Value (Total)&apos; THEN SUM([basket_value_paid_eur]) / [Calculation_7704110864525000788]&#13;&#10;WHEN &apos;Total Fees Paid (Total)&apos; THEN SUM([total_fees_paid_eur]) / [Calculation_7704110864525000788]&#13;&#10;WHEN &apos;Total Fees Net (Total)&apos; THEN SUM([total_fees_paid_net_eur]) / [Calculation_7704110864525000788]&#13;&#10;END' />
            </column>
