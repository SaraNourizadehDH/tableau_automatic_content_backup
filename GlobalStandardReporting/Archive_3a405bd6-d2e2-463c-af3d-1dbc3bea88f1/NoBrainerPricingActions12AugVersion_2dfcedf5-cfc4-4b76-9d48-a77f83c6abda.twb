        <calculation class='tableau' formula='ROUND(SUM(IF [has_dps_incentive] THEN [dps_standard_travel_time_fee_eur] ELSE [dps_travel_time_fee_eur] END)/[Aggregation (copy)_1846475850361638916],2)' />
