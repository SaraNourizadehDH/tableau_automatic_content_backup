      <column caption='Analytical Profit (% of GMV) MoM pp' datatype='real' default-format='*0.0 pp;-0.0 pp;-' hidden='true' name='[Basket Value Paid (per order) MoM % (copy)_1132936785200381987]' role='measure' type='quantitative'>
