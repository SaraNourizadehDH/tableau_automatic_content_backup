        <calculation class='tableau' formula='ROUND(&#13;&#10;&#13;&#10;SUM(IF [total_fees_dps_eur] = 0 THEN [customer_fees_dh_funded]&#13;&#10;ELSEIF [customer_fees_paid_eur] &gt;= [total_fees_dps_eur] THEN 0&#13;&#10;ELSE [total_fees_dps_eur] - [customer_fees_paid_eur]&#13;&#10;END)&#13;&#10;&#13;&#10;/ [Calculation_1139973721956712471], 2)' />
