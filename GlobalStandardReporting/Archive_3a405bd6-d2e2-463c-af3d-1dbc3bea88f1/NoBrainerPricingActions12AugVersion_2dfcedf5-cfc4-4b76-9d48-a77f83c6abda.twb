        <calculation class='tableau' formula='ZN(&#10;SUM(IF [is_df_discount_basket_value_deal] = TRUE &#10;    AND&#10;[basket_value_discount_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Manual&apos;, &apos;Subscription&apos;)&#10;    AND&#10;[is_dps] = TRUE &#10;&#10;    AND &#10;([vertical_parent] = &apos;Dmarts&apos;&#10;    OR&#10;[vertical_type] IN(&apos;supermarket&apos;, &apos;hypermarket&apos;))&#10;    AND&#10;[channel] IN(&apos;Own Delivery&apos;)&#10;THEN 1 ELSE 0 END)&#10;&#10;/&#10;&#10;SUM(IF [is_dps] = TRUE &#10;&#10;    AND &#10;([vertical_parent] = &apos;Dmarts&apos;&#10;    OR&#10;[vertical_type] IN(&apos;supermarket&apos;, &apos;hypermarket&apos;))&#10;    AND&#10;[channel] IN(&apos;Own Delivery&apos;)&#10;THEN 1 ELSE 0 END)&#10;)' />
