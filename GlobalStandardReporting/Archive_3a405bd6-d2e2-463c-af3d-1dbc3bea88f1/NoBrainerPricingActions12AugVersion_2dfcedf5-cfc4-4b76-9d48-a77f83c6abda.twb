        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &apos;Weekday&apos; THEN [Calculation_5564126972843753524] // makes Monday the first day&#13;&#10;WHEN &apos;Time of Day&apos; THEN [occasion_time_of_day]&#13;&#10;WHEN &apos;Day of Week&apos; THEN [occasion_day_of_week]&#13;&#10;&#13;&#10;WHEN &apos;Month&apos; THEN LEFT(DATENAME(&apos;month&apos;, [order_placed_at]),3) + &apos;/&apos; + RIGHT(DATENAME(&apos;year&apos;, [order_placed_at]),2)&#13;&#10;WHEN &apos;Week&apos; THEN &apos;CW&apos; + DATENAME(&apos;week&apos;, [order_placed_at]) + &quot; &quot; + RIGHT(DATENAME(&apos;year&apos;, [order_placed_at]),2)&#13;&#10;WHEN &apos;Day&apos; THEN DATENAME(&apos;day&apos;, [order_placed_at]) + &apos;/&apos; + LEFT(DATENAME(&apos;month&apos;, [order_placed_at]),3) + &apos;/&apos; + RIGHT(DATENAME(&apos;year&apos;, [order_placed_at]),2)&#13;&#10;&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
