      <column caption='Median Basket Paid' datatype='real' default-format='n#,##0.00;-#,##0.00' hidden='true' name='[Basket Buckets (copy)_1829305887451750418]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RAWSQLAGG_REAL(&quot;APPROX_QUANTILES(%1,1000)[OFFSET(500)]&quot;, [basket_value_paid_eur])/[Calculation_1139973721956712471]' />
      </column>
      <column caption='# of Main Dishes Paid' datatype='real' default-format='n#,##0.00;-#,##0.00' hidden='true' name='[Basket Buckets (copy)_1829305888014835839]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [basket_value_paid_eur] &gt; 5 * [main_dish_price_eur] THEN 5&#13;&#10;ELSEIF [basket_value_paid_eur] &lt; 0 THEN 0&#13;&#10;ELSE ROUND([basket_value_paid_eur] / [main_dish_price_eur])&#13;&#10;END' />
        <aliases>
          <alias key='5.0' value='5+' />
        </aliases>
      </column>
      <column caption='DPS Distance Based Fee (median)' datatype='real' default-format='n#,##0.00;-#,##0.00' hidden='true' name='[Basket Buckets (median) (copy)_1829305887734747215]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RAWSQLAGG_REAL(&quot;APPROX_QUANTILES(%1,1000)[OFFSET(500)]&quot;, [dps_travel_time_fee_local]) &#13;&#10;* COUNT([__tableau_internal_object_id__].[pricing_framework_31443A764E8F4C8ABB81B0659FA41FC5])&#13;&#10;/ [Calculation_1139973721956712471] &#13;&#10;/ (SUM([fx_rate_eur]*[gmv_eur])/SUM([gmv_eur]))' />
      </column>
