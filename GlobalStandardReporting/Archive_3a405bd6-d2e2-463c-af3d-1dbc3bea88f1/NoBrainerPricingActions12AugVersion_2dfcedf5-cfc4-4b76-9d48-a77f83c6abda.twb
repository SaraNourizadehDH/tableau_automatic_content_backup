      <column caption='Breakdown ungrouped' datatype='string' hidden='true' name='[Breakdown (copy)_1132936785213071400]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Sub-Detail (copy)_1132936785167228938]&#13;&#10;WHEN &apos;Brand Name&apos; THEN [Brand Name (group)]&#13;&#10;WHEN &apos;Chain Name&apos; THEN [chain_name]&#13;&#10;WHEN &apos;Channel&apos; THEN [channel]&#13;&#10;WHEN &apos;City Name&apos; THEN [city_name] + &quot; (&quot; + [country_code] + &quot;)&quot;&#13;&#10;WHEN &apos;City Tier&apos; THEN [city_tier]&#13;&#10;WHEN &apos;Country Code&apos; THEN [country_code]&#13;&#10;WHEN &apos;Global Entity Id&apos; THEN [global_entity_id]&#13;&#10;WHEN &apos;Has DPS Incentive&apos; THEN&#13;&#10;&#9;CASE [has_dps_incentive]&#13;&#10;    WHEN TRUE THEN &apos;Has DPS Incentive&apos;&#13;&#10;    WHEN FALSE THEN &apos;&apos;&#13;&#10;&#9;ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Holdout&apos; THEN&#13;&#10;    CASE [is_customer_holdout]&#13;&#10;    WHEN TRUE THEN &apos;Holdout&apos;&#13;&#10;    WHEN FALSE THEN &apos;Usual&apos;&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Is DPS&apos; THEN &#13;&#10;CASE [is_dps]&#13;&#10;    WHEN TRUE THEN &apos;Has DPS data&apos;&#13;&#10;    WHEN FALSE THEN &apos;No DPS data&apos;&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Is Subscriber&apos; THEN&#13;&#10;&#9;CASE [is_subscriber]&#13;&#10;    WHEN TRUE THEN &apos;Subscriber&apos;&#13;&#10;    WHEN FALSE THEN &apos;Non-Subscriber&apos;&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Is Preorder&apos; THEN&#13;&#10;&#9;CASE [is_preorder]&#13;&#10;    WHEN TRUE THEN &apos;Preorder&apos;&#13;&#10;    WHEN FALSE THEN &apos;On-demand&apos;&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Key Account Category&apos; THEN [key_account_category]&#13;&#10;WHEN &apos;Market Archetype&apos; THEN [market_archetype]&#13;&#10;WHEN &apos;Meal for One&apos; THEN&#13;&#10;    CASE [is_meal_for_one]&#13;&#10;    WHEN TRUE THEN &apos;Is Meal for One&apos;&#13;&#10;    WHEN FALSE THEN &apos;&apos;&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Occasion - Day of Week&apos; THEN [occasion_day_of_week]&#13;&#10;WHEN &apos;Occasion - Time of Day&apos; THEN [occasion_time_of_day]&#13;&#10;WHEN &apos;Online Payment&apos; THEN&#13;&#10;    CASE [is_paid_online]&#13;&#10;    WHEN TRUE THEN &apos;Online&apos;&#13;&#10;    WHEN FALSE THEN &apos;Offline&apos;&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Segment&apos; THEN [segment]&#13;&#10;WHEN &apos;Sub-Segment&apos; THEN [Global Entity Id (group)]&#13;&#10;WHEN &apos;Sub Entity&apos; THEN [sub_entity]&#13;&#10;WHEN &apos;Vendor Class&apos; THEN [vendor_class]&#13;&#10;WHEN &apos;Vendor Name&apos; THEN [vendor_name]&#13;&#10;WHEN &apos;Vertical Parent&apos; THEN [vertical_parent]&#13;&#10;WHEN &apos;Vertical Type&apos; THEN [vertical_type]&#13;&#10;&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
      </column>
      <column caption='Delivery Fee Net MoM %' datatype='real' default-format='p0.0%' hidden='true' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN([Delivery Fee Net (copy)_1132936785174052885]) - LOOKUP(ZN([Delivery Fee Net (copy)_1132936785174052885]), -1)) / ABS(LOOKUP(ZN([Delivery Fee Net (copy)_1132936785174052885]), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Months Elapsed' datatype='boolean' hidden='true' name='[Calculation_1132936785160491009]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,[Parameters].[Parameter 5], [Calculation_1139973722200334376]) = 0' />
      </column>
      <column caption='Delivery Fee Net YoY%' datatype='real' default-format='p0.0%' hidden='true' name='[Calculation_1132936785161998342]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN([Delivery Fee Net (copy)_1132936785174052885]) - LOOKUP(ZN([Delivery Fee Net (copy)_1132936785174052885]), -2)) / ABS(LOOKUP(ZN([Delivery Fee Net (copy)_1132936785174052885]), -2))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Orders (Total)' datatype='real' default-format='n#,##0.00;-#,##0.00' hidden='true' name='[Calculation_1132936785171419150]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([__tableau_internal_object_id__].[pricing_framework_31443A764E8F4C8ABB81B0659FA41FC5]) / [Calculation_7704110864525000788] / [Calculation_1132936785236541487]' />
      </column>
      <column caption='Default month' datatype='date' datatype-customized='true' name='[Calculation_1132936785207181350]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ MAX(DATE(DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, [order_placed_at])))) }' />
      </column>
      <column caption='Scaling Adjustment' datatype='real' hidden='true' name='[Calculation_1132936785236541487]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 6] THEN &#13;&#10;DATEPART(&apos;day&apos;, MAX([order_placed_at])) &#13;&#10;//COUNTD([Order Placed At])&#13;&#10;/ 30 ELSE 1 END' />
      </column>
      <column caption='Distance Buckets (km)' datatype='real' default-format='n#,##0.00;-#,##0.00' hidden='true' name='[Calculation_1139973721946095621]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(&#13;&#10;    IF [delivery_distance] &gt; [Parameters].[Basket Bucket Cap (copy)_166351713726308367] THEN [Parameters].[Basket Bucket Cap (copy)_166351713726308367]&#13;&#10;    //ELSEIF [Delivery Distance] &gt; 9 THEN ROUND([Delivery Distance] / 1) * 1&#13;&#10;    //ELSEIF [Delivery Distance] &gt; 6 THEN ROUND([Delivery Distance] / 0.75) * 0.75&#13;&#10;    ELSE ROUND([delivery_distance] / [Parameters].[Basket Bucket Size (copy)_166351713726308366]) * [Parameters].[Basket Bucket Size (copy)_166351713726308366]&#13;&#10;    END&#13;&#10;,2)' />
      </column>
      <column caption='Total Fees DPS' datatype='real' default-format='n#,##0.00;-#,##0.00' hidden='true' name='[Calculation_1139973721946988551]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([total_fees_dps_eur])/[Aggregation (copy)_1846475850361638916],2)' />
      </column>
      <column caption='Customer Fees Paid' datatype='real' default-format='n#,##0.00;-#,##0.00' hidden='true' name='[Calculation_1139973721947025416]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([customer_fees_paid_eur])/[Calculation_1139973721956712471],2)' />
      </column>
      <column caption='Total Fees Paid Net' datatype='real' default-format='n#,##0.00;-#,##0.00' hidden='true' name='[Calculation_1139973721947041801]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([total_fees_paid_net_eur])/[Calculation_1139973721956712471],2)' />
      </column>
      <column caption='Analytical Profit' datatype='real' default-format='n#,##0.00;-#,##0.00' hidden='true' name='[Calculation_1139973721947475979]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([analytical_profit])/[Calculation_1139973721956712471],2)' />
      </column>
      <column caption='Is Profitable' datatype='boolean' hidden='true' name='[Calculation_1139973721947762704]' role='measure' type='nominal'>
        <calculation class='tableau' formula='SUM([analytical_profit])/COUNT([__tableau_internal_object_id__].[pricing_framework_31443A764E8F4C8ABB81B0659FA41FC5])&gt;=0' />
      </column>
      <column caption='Detail Ungrouped' datatype='string' hidden='true' name='[Calculation_1139973721954193430]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Vertical Type Parameter]&#13;&#10;WHEN &apos;Brand Name&apos; THEN [Brand Name (group)]&#13;&#10;WHEN &apos;Chain Name&apos; THEN [chain_name]&#13;&#10;WHEN &apos;Channel&apos; THEN [channel]&#13;&#10;WHEN &apos;City Name&apos; THEN [city_name] + &quot; (&quot; + [country_code] + &quot;)&quot;&#13;&#10;WHEN &apos;City Tier&apos; THEN [city_tier]&#13;&#10;WHEN &apos;Country Code&apos; THEN [country_code]&#13;&#10;WHEN &apos;Global Entity Id&apos; THEN [global_entity_id]&#13;&#10;WHEN &apos;Has DPS Incentive&apos; THEN&#13;&#10;&#9;CASE [has_dps_incentive]&#13;&#10;    WHEN TRUE THEN &apos;Has DPS Incentive&apos;&#13;&#10;    WHEN FALSE THEN &apos;&apos;&#13;&#10;&#9;ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Holdout&apos; THEN&#13;&#10;    CASE [is_customer_holdout]&#13;&#10;    WHEN TRUE THEN &apos;Holdout&apos;&#13;&#10;    WHEN FALSE THEN &apos;Usual&apos;&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Is DPS&apos; THEN &#13;&#10;CASE [is_dps]&#13;&#10;    WHEN TRUE THEN &apos;Has DPS data&apos;&#13;&#10;    WHEN FALSE THEN &apos;No DPS data&apos;&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Is Subscriber&apos; THEN&#13;&#10;&#9;CASE [is_subscriber]&#13;&#10;    WHEN TRUE THEN &apos;Subscriber&apos;&#13;&#10;    WHEN FALSE THEN &apos;Non-Subscriber&apos;&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Is Preorder&apos; THEN&#13;&#10;&#9;CASE [is_preorder]&#13;&#10;    WHEN TRUE THEN &apos;Preorder&apos;&#13;&#10;    WHEN FALSE THEN &apos;On-demand&apos;&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Key Account Category&apos; THEN [key_account_category]&#13;&#10;WHEN &apos;Market Archetype&apos; THEN [market_archetype]&#13;&#10;WHEN &apos;Meal for One&apos; THEN&#13;&#10;    CASE [is_meal_for_one]&#13;&#10;    WHEN TRUE THEN &apos;Is Meal for One&apos;&#13;&#10;    WHEN FALSE THEN &apos;&apos;&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Occasion - Day of Week&apos; THEN [occasion_day_of_week]&#13;&#10;WHEN &apos;Occasion - Time of Day&apos; THEN [occasion_time_of_day]&#13;&#10;WHEN &apos;Online Payment&apos; THEN&#13;&#10;    CASE [is_paid_online]&#13;&#10;    WHEN TRUE THEN &apos;Online&apos;&#13;&#10;    WHEN FALSE THEN &apos;Offline&apos;&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Segment&apos; THEN [segment]&#13;&#10;WHEN &apos;Sub-Segment&apos; THEN [Global Entity Id (group)]&#13;&#10;WHEN &apos;Sub Entity&apos; THEN [sub_entity]&#13;&#10;WHEN &apos;Vendor Class&apos; THEN [vendor_class]&#13;&#10;WHEN &apos;Vendor Name&apos; THEN [vendor_name]&#13;&#10;WHEN &apos;Vertical Parent&apos; THEN [vertical_parent]&#13;&#10;WHEN &apos;Vertical Type&apos; THEN [vertical_type]&#13;&#10;&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
      </column>
      <column caption='Aggregation' datatype='real' default-format='n#,##0.00;-#,##0.00' hidden='true' name='[Calculation_1139973721956712471]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Total&apos; THEN 1&#13;&#10;WHEN &apos;Total (M)&apos; THEN 1000000&#13;&#10;WHEN &apos;Total (k)&apos; THEN 1000&#13;&#10;WHEN &apos;Per Order&apos; THEN COUNT([__tableau_internal_object_id__].[pricing_framework_31443A764E8F4C8ABB81B0659FA41FC5])&#13;&#10;WHEN &apos;Per Customer Account&apos; THEN COUNTD([customer_account_id])&#13;&#10;WHEN &apos;Per Analyt. Customer&apos; THEN COUNTD([analytical_customer_id])&#13;&#10;WHEN &apos;Per Day&apos; THEN COUNTD([order_placed_at])&#13;&#10;/**&#13;&#10;WHEN &apos;Per Day&apos; THEN &#13;&#10;&#9;MAX(IF DATETRUNC(&apos;month&apos;,[Order Placed At]) &lt; DATETRUNC(&apos;month&apos;, TODAY())&#13;&#10;    &#9;THEN DATEPART(&apos;day&apos;,(DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,1,[Order Placed At])) - 1))&#13;&#10;&#9;&#9;ELSE DATEPART(&apos;day&apos;,[Order Placed At])&#13;&#10;&#9;END)&#13;&#10;**/&#13;&#10;WHEN &apos;% GMV&apos; THEN SUM([gmv_eur]) / 100&#13;&#10;WHEN &apos;Per Basket/Minute&apos; THEN SUM([basket_value_paid_eur] * [promised_eta_m]) / 100&#13;&#10;WHEN &apos;Per Minute&apos; THEN SUM([promised_eta_m])&#13;&#10;WHEN &apos;% Basket Value&apos; THEN SUM([basket_value_paid_eur]) / 100&#13;&#10;WHEN &apos;% Main Dish Price&apos; THEN SUM([main_dish_price_eur]) / 100&#13;&#10;WHEN &apos;% Total Fees&apos; THEN SUM([total_fees_paid_eur]) / 100&#13;&#10;WHEN &apos;% Total Fees Net&apos; THEN SUM([total_fees_paid_net_eur]) / 100&#13;&#10;//WHEN &apos;% of Orders&apos; THEN WINDOW_SUM(COUNT([pricing_framework])) / 100&#13;&#10;END' />
      </column>
      <column caption='Customer Fees Vendor Funded' datatype='real' default-format='n#,##0.00;-#,##0.00' hidden='true' name='[Calculation_1139973722179629090]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([customer_fees_vendor_funded])/[Calculation_1139973721956712471],2)' />
      </column>
      <column caption='Customer Fees Third Party Funded' datatype='real' default-format='n#,##0.00;-#,##0.00' hidden='true' name='[Calculation_1139973722179649571]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([customer_fees_third_party_funded])/[Calculation_1139973721956712471],2)' />
      </column>
      <column caption='Customer Fees DH Funded' datatype='real' default-format='n#,##0.00;-#,##0.00' hidden='true' name='[Calculation_1139973722179665956]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([customer_fees_dh_funded])/[Calculation_1139973721956712471],2)' />
      </column>
      <column caption='Customer Fees Nominal' datatype='real' default-format='n#,##0.00;-#,##0.00' hidden='true' name='[Calculation_1139973722183237669]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([customer_fees_paid_eur])/[Calculation_1139973721956712471],2) + [Calculation_2515823408474148870]' />
      </column>
      <column aggregation='Sum' caption='Dimension (1)' datatype='real' hidden='true' name='[Calculation_1139973722196611111]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &apos;Basket Bucket&apos; THEN [Distance Buckets (Km) (copy)_1139973722194489382]&#13;&#10;WHEN &apos;Distance Bucket&apos; THEN [Calculation_1139973721946095621]&#13;&#10;WHEN &apos;Month&apos; THEN DATEDIFF(&apos;month&apos;,TODAY(), [order_placed_at])&#13;&#10;WHEN &apos;Week&apos; THEN DATEDIFF(&apos;week&apos;,TODAY(), [order_placed_at])&#13;&#10;WHEN &apos;Day&apos; THEN DATEDIFF(&apos;day&apos;,TODAY(), [order_placed_at])&#13;&#10;WHEN &apos;Weekday&apos; THEN [Calculation_3085810177798340641] // makes Monday the first day&#13;&#10;WHEN &apos;Time of Day&apos; THEN [Calculation_3085810177788899355]&#13;&#10;WHEN &apos;Hour&apos; THEN DATEPART(&apos;hour&apos;, [order_datetime_local])&#13;&#10;WHEN &apos;Day of Week&apos; THEN [Calculation_3085810177789280284]&#13;&#10;WHEN &apos;Unhealthy Score&apos; THEN ROUND([customer_unhealthy_score]/0.1)*0.1&#13;&#10;WHEN &apos;Delivery Fee Score&apos; THEN ROUND([customer_delivery_fee_score]/0.1)*0.1&#13;&#10;WHEN &apos;Reorder Probability within 28d&apos; THEN ROUND([customer_reorder_probability_all_verts_general_28_days]/10)*10&#13;&#10;END' />
      </column>
      <column caption='Month' datatype='date' datatype-customized='true' default-format='*mmm&apos;yy' name='[Calculation_1139973722200334376]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [order_placed_at]))' />
      </column>
      <column caption='Sub-Detail' datatype='string' hidden='true' name='[Calculation_139330180155559956]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Sub-Detail Set] THEN [Detail (copy)_8643885495196205074] ELSE &apos;[Others]&apos; END' />
      </column>
      <column caption='total order per entity' datatype='integer' hidden='true' name='[Calculation_1603070390011740160]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [global_entity_id] : COUNT([order_id])}' />
      </column>
      <column caption='pct order type' datatype='real' hidden='true' name='[Calculation_1603070390012227585]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [global_entity_id], [travel_time_fee_type]:COUNT([order_id])} / {FIXED [global_entity_id] : COUNT([order_id])}' />
      </column>
      <column caption='DBDF Flag No Brainer' datatype='string' name='[Calculation_1603070390034264066]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [DBDF Flag 2 (copy)_1603070390419382303] &gt;= 0.9 AND COUNT([Calculation_1987494825937719297]) &gt; 0  THEN &apos;TRUE&apos;&#10;ELSEIF [DBDF Flag 2 (copy)_1603070390419382303] &lt; 0.9 AND COUNT([Calculation_1987494825937719297]) &gt; 0 THEN &apos;FALSE&apos;&#10;ELSEIF COUNT([Calculation_1987494825937719297]) = 0 THEN &apos;NULL&apos;&#10;END' />
      </column>
      <column caption='[Reference (%)] * 100' datatype='real' hidden='true' name='[Calculation_1603070390038753283]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Aggregation (copy)_1139973721959792666] * 100'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='DF vs CPO' datatype='real' hidden='true' name='[Calculation_1603070390041300996]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Customer Service Fee (copy)_5755600392049983538] / AVG([delivery_fee_eur])' />
      </column>
      <column caption='DBDF Step Count' datatype='real' hidden='true' name='[Calculation_1603070390051495941]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(1 - (COUNT([Calculation_1987494825939615747]) / COUNT([Calculation_1987494825937719297]))) * 100' />
      </column>
      <column caption='Priority Well Configured No Brainer' datatype='real' default-format='*#,##0.0%;(#,##0.0%);-' name='[Calculation_1603070390091292679]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(&#10;SUM(IF [Calculation_1829305887812501618] = TRUE&#10;    AND&#10;[priority_fee_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Priority Fee Override&apos;)&#10;    AND&#10;(IFNULL([max_prio_fee], 0) - IFNULL([min_prio_fee], 0)) &lt;&gt; 0 &#10;    AND&#10;[is_dps] = TRUE&#10;&#10;    AND&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[channel] = &apos;Own Delivery&apos;&#10;THEN 1 ELSE 0 END)&#10;&#10;    /&#10;SUM(IF [Calculation_1829305887812501618] = TRUE &#10;    AND&#10;[priority_fee_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Priority Fee Override&apos;)&#10;    AND&#10;[is_dps] = TRUE&#10;&#10;    AND&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[channel] = &apos;Own Delivery&apos;&#10;THEN 1 ELSE 0 END)&#10;)' />
      </column>
      <column caption='Priority No Brainer Flag No Brainer' datatype='string' name='[Calculation_1603070390096588810]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1603070390091292679] &gt;= 0.9 AND COUNT([priority_fee_component_id]) &gt; 0 THEN &apos;&gt;= Expectation&apos;&#10;ELSEIF [Calculation_1603070390091292679] &lt; 0.9 AND COUNT([priority_fee_component_id]) &gt; 0 THEN &apos;&lt; Expectation&apos;&#10;ELSEIF COUNT([priority_fee_component_id]) = 0 THEN &apos;No Component&apos;&#10;END' />
      </column>
      <column caption='Min(1)' datatype='integer' name='[Calculation_1603070390097866763]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Min(1)' />
      </column>
      <column caption='Time Condition Applied No Brainer' datatype='real' default-format='*#,##0.0%;(#,##0.0%);-' name='[Calculation_1603070390321971215]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(&#10;SUM(IF (CONTAINS([travel_time_fee_condition_type], &quot;Time&quot;) OR CONTAINS([travel_time_fee_condition_type], &quot;Schedule&quot;))&#10;    AND &#10;[travel_time_fee_assignment_type] IN &#10;(&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;Subscription&apos;)&#10;    AND&#10;[is_dps] = TRUE&#10;    AND&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[channel] = &apos;Own Delivery&apos;&#10;THEN 1 ELSE 0&#10;END) &#10;&#10;/&#10;&#10;SUM(IF &#10;[travel_time_fee_assignment_type] IN &#10;(&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;Subscription&apos;)&#10;    AND&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[is_dps] = TRUE &#10;THEN 1 ELSE 0 END)&#10;)' />
      </column>
      <column caption='Time Condition Applied  Flag No Brainer' datatype='string' name='[Calculation_1603070390326657040]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1603070390321971215] &gt; 0.5 THEN &apos;TRUE&apos; &#10;ELSEIF  [Calculation_1603070390321971215] &lt;= 0.5 THEN &apos;FALSE&apos; &#10;ELSEIF ISNULL([Calculation_1603070390321971215]) = TRUE THEN &apos;NULL&apos;&#10;END' />
      </column>
      <column caption='MOV No Brainer' datatype='real' default-format='*#,##0.0%;(#,##0.0%);-' name='[Calculation_1603070390348779537]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM(IF [Has Paid DF (copy)_1829305887816900732] = TRUE&#10;        AND&#10;    [Paid Small Basket Fee (copy)_1829305887584337993] = TRUE&#10;        AND&#10;    [hard_mov] &gt;= 0&#10;        AND &#10;    IFNULL([sbf_cap], 0) &gt; 0&#10;        AND&#10;    [minimum_order_value_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;MOV Override&apos;, &apos;Subscription&apos;)&#10;&#10;AND [dps_minimum_order_value_eur] &gt; 0&#10;&#10;        AND&#10;[vertical_parent] = &apos;Food&apos;&#10;        AND&#10;    [channel] = &apos;Own Delivery&apos;&#10;     THEN 1 ELSE 0&#10;END)&#10;&#10;/&#10;&#10;SUM(if [is_dps] = TRUE &#10;    AND&#10;[minimum_order_value_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;MOV Override&apos;, &apos;Subscription&apos;)&#10;&#10;AND [dps_minimum_order_value_eur] &gt; 0&#10;&#10;    AND&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[channel] = &apos;Own Delivery&apos;&#10;THEN 1 ELSE 0 END)&#10;)' />
      </column>
      <column caption='MOV Flag No Brainer' datatype='string' name='[Calculation_1603070390351749138]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1603070390348779537] &gt;= 0.9 AND COUNT([Calculation_1987494825938444290]) &gt; 0 THEN &apos;TRUE&apos;&#10;ELSEIF [Calculation_1603070390348779537] &lt; 0.9 AND COUNT([Calculation_1987494825938444290]) &gt; 0 THEN &apos;FALSE&apos;&#10;ELSEIF COUNT([Calculation_1987494825938444290]) &gt; 0 THEN &apos;NULL&apos;&#10;END' />
      </column>
      <column caption='Hard MOV at 0 with SBF Flag No Brainer' datatype='boolean' hidden='true' name='[Calculation_1603070390366695445]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [MOV No Brainer - only Hard MOV (copy)_1603070390353911828] &gt; 0.0 THEN FALSE ELSE TRUE END' />
      </column>
      <column caption='Service Fee No Brainer' datatype='real' default-format='*#,##0.0%;(#,##0.0%);-' name='[Calculation_1603070390374772759]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(&#10;SUM(IF &#10;service_fee_type = &apos;Percentage&apos;&#10;&#10;    AND&#10;[max_service_fee] &lt;&gt; [min_service_fee]&#10;    AND&#10;/*&#10;[service_fee_condition_type] &lt;&gt; &apos;New Customer&apos;&#10;*/&#10;[service_fee_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;Service Fee Override&apos;, &apos;Subscription&apos;)&#10;    AND&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[channel] = &apos;Pick-up&apos;&#10;THEN 1 ELSE 0&#10;END)&#10;&#10;/&#10;&#10;SUM(IF [is_dps] = TRUE &#10;    AND&#10;/*&#10;[service_fee_condition_type] &lt;&gt; &apos;New Customer&apos;&#10;*/&#10;[service_fee_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;Service Fee Override&apos;, &apos;Subscription&apos;)&#10;&#10;    AND&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[channel] = &apos;Pick-up&apos;&#10;THEN 1 ELSE 0 END)&#10;)' />
      </column>
      <column caption='Service Fee Flag No Brainer' datatype='string' name='[Calculation_1603070390378274840]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1603070390374772759] &gt;= 0.9 AND COUNT([service_fee_component_id]) &gt; 0 THEN &apos;TRUE&apos;&#10;ELSEIF [Calculation_1603070390374772759] &lt; 0.9 AND COUNT([service_fee_component_id]) &gt; 0 THEN &apos;FALSE&apos;&#10;ELSEIF COUNT([service_fee_component_id]) = 0 THEN &apos;NULL&apos;&#10;END' />
      </column>
      <column caption='QC BBDF No Brainer' datatype='real' default-format='*#,##0.0%;(#,##0.0%);-' name='[Calculation_1603070390695165988]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(&#10;SUM(IF [is_df_discount_basket_value_deal] = TRUE &#10;    AND&#10;[basket_value_discount_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Manual&apos;, &apos;Subscription&apos;)&#10;    AND&#10;[is_dps] = TRUE &#10;    AND&#10;([vertical_parent] = &apos;Dmarts&apos;&#10;    OR&#10;[vertical_type] =&apos;supermarket&apos;&#10;    OR &#10;[vertical_type] = &apos;hypermarket&apos;)&#10;    AND&#10;[channel] IN(&apos;Own Delivery&apos;)&#10;THEN 1 ELSE 0 END)&#10;&#10;/&#10;&#10;SUM(IF [is_dps] = TRUE &#10;&#10;&#10;//    AND&#10;//[basket_value_discount_assignment_type] IN (&apos;Automatic scheme&apos;,  &apos;Manual&apos;, &apos;Subscription&apos;)&#10;&#10;    AND &#10;([vertical_parent] = &apos;Dmarts&apos;&#10;    OR&#10;[vertical_type] =&apos;supermarket&apos;&#10;    OR &#10;[vertical_type] = &apos;hypermarket&apos;)&#10;    AND&#10;[channel] IN(&apos;Own Delivery&apos;)&#10;THEN 1 ELSE 0 END)&#10;)' />
      </column>
      <column caption='QC BBDF Flag No Brainer' datatype='string' name='[Calculation_1603070390699339814]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1603070390695165988] &gt;= 0.9 AND COUNT([basket_value_discount_component_id]) &gt; 0 THEN &apos;TRUE&apos;&#10;ELSEIF  [Calculation_1603070390695165988] &lt; 0.9 AND COUNT([basket_value_discount_component_id]) &gt; 0 THEN &apos;FALSE&apos;&#10;ELSEIF COUNT([basket_value_discount_component_id]) = 0 THEN &apos;NULL&apos;&#10;END' />
      </column>
      <column caption='BBDF Vertical Type' datatype='string' hidden='true' name='[Calculation_1603070390722175015]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [vertical_type] = &apos;darkstores&apos; THEN &apos;darkstores&apos;&#10;ELSEIF  [vertical_type] IN(&apos;hypermarket&apos;, &apos;supermarket&apos;) THEN &apos;AAA Groceries&apos;&#10;ELSE null&#10;END' />
      </column>
      <column caption='Legend Current' datatype='string' hidden='true' name='[Calculation_166351713654349825]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Current&apos;' />
      </column>
      <column caption='Legend Reference' datatype='string' hidden='true' name='[Calculation_166351713655070726]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Reference&quot;' />
      </column>
      <column caption='Cohort' datatype='datetime' default-format='*mmm/yy' hidden='true' name='[Calculation_1829305887477674011]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [first_order_placed_at])' />
      </column>
      <column caption='Mean Delay Bucket' datatype='real' hidden='true' name='[Calculation_1829305887558262845]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [dps_mean_delay] &gt; 30 THEN 30&#13;&#10;ELSE ROUND([dps_mean_delay] / 5) * 5&#13;&#10;END' />
      </column>
      <column caption='SBF type' datatype='string' hidden='true' name='[Calculation_1829305887570227264]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [sbf_cap] &lt;&gt; 0 THEN &apos;Has Cap&apos;&#13;&#10;ELSEIF [hard_mov] &lt;&gt; 0 THEN &apos;Has Hard MOV&apos;&#13;&#10;ELSEIF [is_small_order_fee] THEN &apos;SBF&apos;&#13;&#10;ELSE [mov_type]&#13;&#10;END' />
      </column>
      <column caption='Paid Small Basket Fee' datatype='boolean' hidden='true' name='[Calculation_1829305887583002696]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([small_basket_fee_eur],0)+IFNULL([small_basket_fee_net],0)&gt;0' />
      </column>
      <column caption='DPS Distance Based Fee (IQR)' datatype='real' hidden='true' name='[Calculation_1829305887735279698]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Delivery Fee (median) (copy)_1829305887735001169]-[Delivery Fee (median) (copy)_1829305887734886480]' />
      </column>
      <column caption='Has Paid Prio Fee' datatype='boolean' name='[Calculation_1829305887812501618]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='ABS(IFNULL([priority_fee_eur],0))&#10;+ ABS(IFNULL([priority_fee_net],0))&#10;+ ABS(IFNULL([dps_priority_fee_opted_in_local],0))&#10;&gt; 0' />
      </column>
      <column caption='Result without Fees' datatype='real' hidden='true' name='[Calculation_1829305888042827908]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([revenue_net])/[Calculation_1139973721956712471] &#13;&#10;- ([Calculation_1139973721947041801]) &#13;&#10;+ SUM([cost_of_sales])/[Calculation_1139973721956712471] &#13;&#10;+ SUM([dh_funded_basket_incentives])/[Calculation_1139973721956712471]' />
      </column>
      <column caption='Metric 2' datatype='real' default-format='n#,##0.00;-#,##0.00' hidden='true' name='[Calculation_1846475850324656128]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Metric 1 (copy)_1846475850326323201]&#13;&#10;//WHEN &apos;Aggregation&apos; THEN [Aggregation]&#13;&#10;WHEN &apos;Analytical Profit&apos; THEN [Calculation_1139973721947475979]&#13;&#10;WHEN &apos;Bad Weather Fee Net&apos; THEN [Delivery Fee Net (copy)_1139973722153857056]&#13;&#10;WHEN &apos;Bad Weather Fee Paid&apos; THEN [Bad Weather Fee Net (copy)_5755600392040185896]&#13;&#10;//WHEN &apos;Basket Buckets&apos; THEN [Basket Buckets]&#13;&#10;WHEN &apos;Basket Value Nominal&apos; THEN [Bad Weather Fee Net (copy)_5755600392040370217]&#13;&#10;WHEN &apos;Basket Value Paid&apos; THEN [Basket Value Nominal (copy)_5755600392040484906]&#13;&#10;WHEN &apos;Commission Fee Net&apos; THEN [Basket Value Paid (copy)_5755600392040583211]&#13;&#10;WHEN &apos;Count of Orders&apos; THEN SUM(1)&#13;&#10;WHEN &apos;Customer Fees DH Funded&apos; THEN [Calculation_1139973722179665956]&#13;&#10;WHEN &apos;Customer Fees Nominal&apos; THEN [Calculation_1139973722183237669]&#13;&#10;WHEN &apos;Customer Fees Other Funded&apos; THEN [Calculation_1139973722179629090]&#13;&#10;WHEN &apos;Customer Fees Paid&apos; THEN [Calculation_1139973721947025416]&#13;&#10;WHEN &apos;Customer Fees Third Party Funded&apos; THEN [Calculation_1139973722179649571]&#13;&#10;WHEN &apos;Customer Service Fee&apos; THEN [Service Fee Net (copy)_5755600392050638902]&#13;&#10;WHEN &apos;Customer Service Fee Net&apos; THEN [Customer Fees Paid (copy)_1139973722151665692]&#13;&#10;WHEN &apos;DPS Bad Weather Fee&apos; THEN [DPS Delivery Fee (copy)_6532541696563433535]&#13;&#10;WHEN &apos;DPS Delivery Fee&apos; THEN [DPS Delivery Fee (inc. Std) (copy)_5648006582348574733]&#13;&#10;WHEN &apos;DPS Delivery Fee (inc. Std)&apos; THEN [GMV (copy)_5755600392050266164]&#13;&#10;WHEN &apos;DPS Incentive&apos; THEN [Calculation_2515823408474148870]&#13;&#10;WHEN &apos;DPS Priority Fee&apos; THEN [DPS Service Fee (copy)_6532541696563617857]&#13;&#10;WHEN &apos;DPS Priority Fee (opted-in)&apos; THEN [DPS Priority Fee (copy)_5755600392125005885]&#13;&#10;WHEN &apos;DPS Service Fee&apos; THEN [DPS Bad Weather Fee (copy)_6532541696563535936]&#13;&#10;WHEN &apos;DPS Small Basket Fee&apos; THEN [DPS Priority Fee (copy)_6532541696563712066]&#13;&#10;WHEN &apos;DPS Standard Fee&apos; THEN [DPS Delivery Fee (copy)_5755600392050372661]&#13;&#10;WHEN &apos;Delivery Costs&apos; THEN [Customer Service Fee (copy)_5755600392049983538]&#13;&#10;//WHEN &apos;Delivery Distance (km)&apos; THEN [Delivery Distance (km)]&#13;&#10;WHEN &apos;Delivery Fee Net&apos; THEN [Service Fee Net (copy)_1139973722152026141]&#13;&#10;WHEN &apos;Delivery Fee Net (Core)&apos; THEN [Delivery Fee Net (copy)_5755600392050769975]&#13;&#10;WHEN &apos;Delivery Fee Nominal&apos; THEN [Delivery Fee Net (copy)_5755600392051003448]&#13;&#10;WHEN &apos;Delivery Fee Paid&apos; THEN [Delivery Fee Gross (copy)_5755600392051531834]&#13;&#10;//WHEN &apos;Dimension&apos; THEN [Dimension]&#13;&#10;//WHEN &apos;Distance Buckets (km)&apos; THEN [Distance Buckets (km)]&#13;&#10;WHEN &apos;GMV&apos; THEN [Delivery Costs (copy)_5755600392050180147]&#13;&#10;WHEN &apos;Other DH Reductions&apos; THEN [Customer Fees DPS (copy)_1139973722258194473]&#13;&#10;WHEN &apos;Other Reductions&apos; THEN [Other DH Reductions (copy)_2515823408475398152]&#13;&#10;WHEN &apos;Priority Fee Net&apos; THEN [Service Fee Net (copy)_1139973722152595486]&#13;&#10;WHEN &apos;Priority Fee Paid&apos; THEN [Delivery Fee Net (copy)_5755600392041246766]&#13;&#10;//WHEN &apos;Reference&apos; THEN [Reference]&#13;&#10;//WHEN &apos;Reference (%)&apos; THEN [Reference (%)]&#13;&#10;WHEN &apos;Service Fee Net&apos; THEN [Customer Fees Paid (copy)_1139973722151665692]&#13;&#10;WHEN &apos;Service Fee Paid&apos; THEN [Service Fee Net (copy)_5755600392050638902]&#13;&#10;WHEN &apos;Small Basket Fee Net&apos; THEN [Service Fee Net (copy)_1139973722153009183]&#13;&#10;WHEN &apos;Small Basket Fee Paid&apos; THEN [Small Basket Fee Net (copy)_5755600392052346940]&#13;&#10;WHEN &apos;Subscription Vendor Subsidy Net&apos; THEN [Small Basket Net (copy)_1139973722288521258]&#13;&#10;//WHEN &apos;Taxes&apos; THEN [Taxes]&#13;&#10;WHEN &apos;Total Fees DPS&apos; THEN [Calculation_1139973721946988551]&#13;&#10;//WHEN &apos;Total Fees DPS (exc. Std)&apos; THEN [Total Fees DPS (exc. Std)]&#13;&#10;WHEN &apos;Total Fees Paid&apos; THEN [Total Fees Paid Net (copy)_5755600392043515951]&#13;&#10;WHEN &apos;Total Fees Paid Net&apos; THEN [Calculation_1139973721947041801]&#13;&#10;//WHEN &apos;Vendor Age (Days)&apos; THEN [Vendor Age (Days)]&#13;&#10;WHEN &apos;Vendor Fees Paid&apos; THEN [Vendor Funded Delivery Fee Subsidy Net (copy)_5755600392051896379]&#13;&#10;WHEN &apos;Vendor Funded Delivery Fee Subsidy Net&apos; THEN [Subscription Vendor Subsidy Net (copy)_1139973722288619563]&#13;&#10;END' />
      </column>
      <column aggregation='Sum' caption='Travel Time Fee Component Id' datatype='real' name='[Calculation_1987494825937719297]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [travel_time_fee_component_id Set] THEN [travel_time_fee_component_id]&#13;&#10;ELSE 0&#13;&#10;END' />
        <aliases>
          <alias key='0.0' value='Other' />
        </aliases>
      </column>
      <column aggregation='Sum' caption='Minimum Order Value Component Id' datatype='real' name='[Calculation_1987494825938444290]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [minimum_order_value_component_id Set] THEN [minimum_order_value_component_id] ELSE 0 END' />
      </column>
      <column aggregation='Sum' caption='Travel Time Fee Tier' datatype='integer' hidden='true' name='[Calculation_1987494825939615747]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [travel_time_fee_tier] &gt; 10 THEN 10&#13;&#10;ELSE [travel_time_fee_tier] END' />
        <aliases>
          <alias key='10' value='10+' />
        </aliases>
      </column>
      <column caption='Filter Relevant Months on Summary' datatype='boolean' hidden='true' name='[Calculation_2409144337476128804]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [order_placed_at]) = [Parameters].[Parameter 5]&#13;&#10;OR DATETRUNC(&apos;month&apos;, [order_placed_at]) = DATEADD(&apos;month&apos;, -1, [Parameters].[Parameter 5])&#13;&#10;OR DATETRUNC(&apos;month&apos;, [order_placed_at]) = DATEADD(&apos;month&apos;, -12, [Parameters].[Parameter 5])' />
      </column>
      <column caption='Promo Range %' datatype='real' default-format='p0.0%' hidden='true' name='[Calculation_2515260398881148928]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([promo_price_range_eur])/SUM([avg_basket_eur])' />
      </column>
      <column caption='mean_acceptable_price_range_eur' datatype='real' hidden='true' name='[Calculation_2515260399165648906]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([min_acceptable_price_range_eur]+[max_acceptable_price_range_eur])/2' />
      </column>
      <column caption='DH Incentives' datatype='real' hidden='true' name='[Calculation_2515260399196712986]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([dh_funded_basket_incentives]) / [Calculation_1139973721956712471], 2)' />
      </column>
      <column caption='VW Range (CF)' datatype='string' hidden='true' name='[Calculation_2515823408463073283]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [customer_fees_paid_eur] = 0 THEN &apos;Free&apos;&#13;&#10;ELSEIF [customer_fees_paid_eur] &lt;= [promo_price_range_eur] THEN &apos;Very Cheap&apos;&#13;&#10;ELSEIF [customer_fees_paid_eur] &lt;= [min_acceptable_price_range_eur] THEN &apos;Cheap&apos;&#13;&#10;ELSEIF [customer_fees_paid_eur] &lt;= [Calculation_2515260399165648906] THEN &apos;Middle point&apos;&#13;&#10;ELSEIF [customer_fees_paid_eur] &lt;= [max_acceptable_price_range_eur] THEN &apos;Expensive&apos;&#13;&#10;ELSEIF [customer_fees_paid_eur] &lt;= [long_price_range_eur] THEN &apos;Too Expensive&apos;&#13;&#10;ELSEIF [customer_fees_paid_eur] &gt; [long_price_range_eur] THEN &apos;Not Acceptable&apos;&#13;&#10;ELSE &apos;Unknown&apos;&#13;&#10;END' />
      </column>
      <column caption='Taxes' datatype='integer' default-format='n#,##0.00;-#,##0.00' hidden='true' name='[Calculation_2515823408472817669]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(0)' />
      </column>
      <column caption='DPS Incentives' datatype='real' default-format='n#,##0.00;-#,##0.00' hidden='true' name='[Calculation_2515823408474148870]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF [has_dps_incentive] THEN [dps_standard_fee_eur] ELSE [dps_delivery_fee_eur] END) &#10;- SUM([dps_delivery_fee_eur])) &#10;/ [Aggregation (copy)_1846475850361638916]' />
      </column>
      <column caption='Order Type' datatype='string' hidden='true' name='[Calculation_2635168734501298176]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF NULL THEN NULL&#13;&#10;ELSEIF [is_subscriber] AND [total_fees_paid_eur] = 0 THEN &apos;No fees Sub&apos;&#13;&#10;ELSEIF [is_subscriber] AND [total_fees_paid_eur] &gt; 0 THEN &apos;Paying Sub&apos;&#13;&#10;ELSEIF [channel] = &apos;Pick-up&apos; AND [total_fees_paid_eur] = 0 THEN &apos;No fees PU&apos;&#13;&#10;ELSEIF [channel] = &apos;Pick-up&apos; AND [total_fees_paid_eur] &gt; 0 THEN &apos;Paying PU&apos;&#13;&#10;ELSEIF [channel] = &apos;Vendor Delivery&apos; AND [delivery_fee_eur] = 0 THEN &apos;Free DF VD&apos;&#13;&#10;ELSEIF [channel] = &apos;Vendor Delivery&apos; THEN &apos;Paid DF VD&apos;&#13;&#10;ELSEIF [has_dps_incentive] THEN &apos;Incentivized&apos;&#13;&#10;ELSEIF [delivery_fee_eur] = 0 THEN &apos;Free DF OD&apos;&#13;&#10;ELSE &apos;Regular&apos;&#13;&#10;END' />
      </column>
      <column caption='Slope' datatype='real' hidden='true' name='[Calculation_2767461991343317021]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(&#13;&#10;(WINDOW_COVAR(AVG([Calculation_1139973721946095621]), [DPS Surge Fee (copy)_3085810177997971507])/WINDOW_VAR(AVG([Calculation_1139973721946095621])))&#13;&#10;/(WINDOW_COVAR(AVG([Calculation_1139973721946095621]), -[Customer Service Fee (copy)_5755600392049983538])/WINDOW_VAR(AVG([Calculation_1139973721946095621])))&#13;&#10;*100,2)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='DPS Prio Orders' datatype='real' hidden='true' name='[Calculation_2825305104109449251]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [dps_priority_fee_opted_in_eur] &lt;&gt; 0 THEN 1 ELSE 0 END) / SUM(IF [is_dps] THEN 1 ELSE 0 END) * 100' />
      </column>
      <column caption='Profitable Orders' datatype='integer' hidden='true' name='[Calculation_3085810177769197570]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_successful] AND [analytical_profit] &gt;= 0 THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Successful Orders' datatype='integer' hidden='true' name='[Calculation_3085810177769836549]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_successful] THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Is Basket Bucket Selected (2/3)' datatype='boolean' hidden='true' name='[Calculation_3085810177785458713]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Dimension (copy)_3085810177783541781] = &quot;Basket Bucket&quot; OR [Parameters].[Dimension (copy) (copy)_3085810177783549974] = &quot;Basket Bucket&quot;' />
      </column>
      <column aggregation='Sum' caption='Time of Day' datatype='integer' hidden='true' name='[Calculation_3085810177788899355]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [occasion_time_of_day]&#13;&#10;    WHEN &apos;breakfast&apos; THEN 1&#13;&#10;    WHEN &apos;lunch&apos; THEN 2&#13;&#10;    WHEN &apos;afternoon&apos; THEN 3&#13;&#10;    WHEN &apos;dinner&apos; THEN 4&#13;&#10;    WHEN &apos;late_night&apos; THEN 5&#13;&#10;END' />
      </column>
      <column aggregation='Sum' caption='Day of Week' datatype='integer' hidden='true' name='[Calculation_3085810177789280284]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [occasion_day_of_week]&#13;&#10;WHEN &apos;weekday&apos; THEN 1&#13;&#10;WHEN &apos;weekend&apos; THEN 2&#13;&#10;END' />
      </column>
      <column aggregation='Sum' caption='Weekday (#)' datatype='integer' hidden='true' name='[Calculation_3085810177798340641]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEPART(&apos;weekday&apos;, [order_placed_at] - 1)' />
      </column>
      <column caption='Is Financial' datatype='boolean' hidden='true' name='[Calculation_3085810177973600292]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 7] = &apos;Financial&apos;' />
      </column>
      <column caption='Is Operational' datatype='boolean' hidden='true' name='[Calculation_3085810177973698597]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 7]=&quot;Operational&quot;' />
      </column>
      <column caption='Retention Month' datatype='integer' hidden='true' name='[Calculation_3085810178731069492]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='//FLOOR(&#13;&#10;DATEDIFF(&apos;month&apos;,&#13;&#10;    DATETRUNC(&apos;month&apos;, [first_order_placed_at]),&#13;&#10;    DATETRUNC(&apos;month&apos;, [order_placed_at])&#13;&#10;)&#13;&#10;///30)' />
      </column>
      <column caption='Retention Month between 0 and 16' datatype='boolean' hidden='true' name='[Calculation_3085810178955874367]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_3085810178731069492] &gt;= 0 AND [Calculation_3085810178731069492] &lt;= 15' />
      </column>
      <column caption='Months since Acquisition between 0 and 15' datatype='boolean' hidden='true' name='[Calculation_3085810178957115458]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Months on Book (copy)_3085810178956902465] &gt;= 0 AND [Months on Book (copy)_3085810178956902465] &lt;= 15' />
      </column>
      <column caption='Travel Time Distinct Fees' datatype='integer' hidden='true' name='[Calculation_343680961428262912]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [travel_time_distinct_fees] &gt; 20 THEN 20&#13;&#10;ELSE [travel_time_distinct_fees] END' />
        <aliases>
          <alias key='20' value='20+' />
        </aliases>
      </column>
      <column caption='Reference Date' datatype='datetime' hidden='true' name='[Calculation_5564126972833857571]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [Calculation_5564126972853960759] AND DATEADD(&apos;week&apos;, -[Parameters].[Weeks Displayed (copy)_5564126972860436536], [order_placed_at]) &lt;= { FIXED : MAX([order_placed_at])}&#10;THEN DATETRUNC(&apos;day&apos;, DATEADD(&apos;week&apos;, -[Parameters].[Weeks Displayed (copy)_5564126972860436536], [order_placed_at]))&#10;END' />
      </column>
      <column caption='Current Date' datatype='datetime' hidden='true' name='[Calculation_5564126972838146096]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [order_placed_at] &gt;= DATEADD(&apos;week&apos;,-[Parameters].[Channel Parameter], { FIXED : MAX([order_placed_at])}) &#10;THEN DATETRUNC(&apos;day&apos;, [order_placed_at]) &#10;END' />
      </column>
      <column caption='Weekday' datatype='string' hidden='true' name='[Calculation_5564126972843753524]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;,[order_placed_at])' />
      </column>
      <column caption='Weeks Displayed' datatype='boolean' hidden='true' name='[Calculation_5564126972853960759]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEADD(&apos;week&apos;, -[Parameters].[Weeks Displayed (copy)_5564126972860436536], [order_placed_at]) &#10;&gt;= DATEADD(&apos;week&apos;,-[Parameters].[Channel Parameter], { FIXED : MAX([order_placed_at])})' />
      </column>
      <column caption='Unit' datatype='integer' name='[Calculation_7704110864525000788]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Total Fees Paid Net (M) Parameter]&#10;WHEN &apos;Standard&apos; THEN 1&#10;WHEN &apos;Thousand (k)&apos; THEN 1000&#10;WHEN &apos;Million (M)&apos; THEN 1000000&#10;WHEN &apos;Billion (B)&apos; THEN 1000000000&#10;END' />
      </column>
      <column caption='Revenue Net' datatype='real' default-format='n#,##0.00;-#,##0.00' hidden='true' name='[Commission Fee Net (copy)_2767461991321042956]' role='measure' type='quantitative'>
