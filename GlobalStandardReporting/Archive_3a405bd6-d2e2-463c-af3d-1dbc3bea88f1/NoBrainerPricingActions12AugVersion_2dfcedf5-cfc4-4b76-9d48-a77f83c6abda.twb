    <worksheet name='Sheet 2'>
      <table>
        <view>
          <datasources>
            <datasource caption='pricing_framework (growth_pricing)' name='federated.16xq89b15ombu418amgk303gpxk5' />
          </datasources>
          <datasource-dependencies datasource='federated.16xq89b15ombu418amgk303gpxk5'>
            <column datatype='string' name='[Brand Name (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[brand_name]' new-bin='true'>
                <bin default-name='false' value='&quot;DH Greece&quot;'>
                  <value>&quot;eFood&quot;</value>
                  <value>&quot;Foody&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='Priority Well Configured No Brainer' datatype='real' default-format='*#,##0.0%;(#,##0.0%);-' name='[Calculation_1603070390091292679]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(&#10;SUM(IF [Calculation_1829305887812501618] = TRUE&#10;    AND&#10;[priority_fee_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Priority Fee Override&apos;)&#10;    AND&#10;(IFNULL([max_prio_fee], 0) - IFNULL([min_prio_fee], 0)) &lt;&gt; 0 &#10;    AND&#10;[is_dps] = TRUE&#10;&#10;    AND&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[channel] = &apos;Own Delivery&apos;&#10;THEN 1 ELSE 0 END)&#10;&#10;    /&#10;SUM(IF [Calculation_1829305887812501618] = TRUE &#10;    AND&#10;[priority_fee_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Priority Fee Override&apos;)&#10;    AND&#10;[is_dps] = TRUE&#10;&#10;    AND&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[channel] = &apos;Own Delivery&apos;&#10;THEN 1 ELSE 0 END)&#10;)' />
            </column>
            <column caption='Time Condition Applied No Brainer' datatype='real' default-format='*#,##0.0%;(#,##0.0%);-' name='[Calculation_1603070390321971215]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(&#10;SUM(IF (CONTAINS([travel_time_fee_condition_type], &quot;Time&quot;) OR CONTAINS([travel_time_fee_condition_type], &quot;Schedule&quot;))&#10;    AND &#10;[travel_time_fee_assignment_type] IN &#10;(&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;Subscription&apos;)&#10;    AND&#10;[is_dps] = TRUE&#10;    AND&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[channel] = &apos;Own Delivery&apos;&#10;THEN 1 ELSE 0&#10;END) &#10;&#10;/&#10;&#10;SUM(IF &#10;[travel_time_fee_assignment_type] IN &#10;(&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;Subscription&apos;)&#10;    AND&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[is_dps] = TRUE &#10;THEN 1 ELSE 0 END)&#10;)' />
            </column>
            <column caption='MOV No Brainer' datatype='real' default-format='*#,##0.0%;(#,##0.0%);-' name='[Calculation_1603070390348779537]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM(IF [Has Paid DF (copy)_1829305887816900732] = TRUE&#10;        AND&#10;    [Paid Small Basket Fee (copy)_1829305887584337993] = TRUE&#10;        AND&#10;    [hard_mov] &gt;= 0&#10;        AND &#10;    IFNULL([sbf_cap], 0) &gt; 0&#10;        AND&#10;    [minimum_order_value_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;MOV Override&apos;, &apos;Subscription&apos;)&#10;&#10;AND [dps_minimum_order_value_eur] &gt; 0&#10;&#10;        AND&#10;[vertical_parent] = &apos;Food&apos;&#10;        AND&#10;    [channel] = &apos;Own Delivery&apos;&#10;     THEN 1 ELSE 0&#10;END)&#10;&#10;/&#10;&#10;SUM(if [is_dps] = TRUE &#10;    AND&#10;[minimum_order_value_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;MOV Override&apos;, &apos;Subscription&apos;)&#10;&#10;AND [dps_minimum_order_value_eur] &gt; 0&#10;&#10;    AND&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[channel] = &apos;Own Delivery&apos;&#10;THEN 1 ELSE 0 END)&#10;)' />
            </column>
            <column caption='Service Fee No Brainer' datatype='real' default-format='*#,##0.0%;(#,##0.0%);-' name='[Calculation_1603070390374772759]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(&#10;SUM(IF &#10;service_fee_type = &apos;Percentage&apos;&#10;&#10;    AND&#10;[max_service_fee] &lt;&gt; [min_service_fee]&#10;    AND&#10;/*&#10;[service_fee_condition_type] &lt;&gt; &apos;New Customer&apos;&#10;*/&#10;[service_fee_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;Service Fee Override&apos;, &apos;Subscription&apos;)&#10;    AND&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[channel] = &apos;Pick-up&apos;&#10;THEN 1 ELSE 0&#10;END)&#10;&#10;/&#10;&#10;SUM(IF [is_dps] = TRUE &#10;    AND&#10;/*&#10;[service_fee_condition_type] &lt;&gt; &apos;New Customer&apos;&#10;*/&#10;[service_fee_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;Service Fee Override&apos;, &apos;Subscription&apos;)&#10;&#10;    AND&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[channel] = &apos;Pick-up&apos;&#10;THEN 1 ELSE 0 END)&#10;)' />
            </column>
            <column caption='QC BBDF No Brainer' datatype='real' default-format='*#,##0.0%;(#,##0.0%);-' name='[Calculation_1603070390695165988]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(&#10;SUM(IF [is_df_discount_basket_value_deal] = TRUE &#10;    AND&#10;[basket_value_discount_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Manual&apos;, &apos;Subscription&apos;)&#10;    AND&#10;[is_dps] = TRUE &#10;    AND&#10;([vertical_parent] = &apos;Dmarts&apos;&#10;    OR&#10;[vertical_type] =&apos;supermarket&apos;&#10;    OR &#10;[vertical_type] = &apos;hypermarket&apos;)&#10;    AND&#10;[channel] IN(&apos;Own Delivery&apos;)&#10;THEN 1 ELSE 0 END)&#10;&#10;/&#10;&#10;SUM(IF [is_dps] = TRUE &#10;&#10;&#10;//    AND&#10;//[basket_value_discount_assignment_type] IN (&apos;Automatic scheme&apos;,  &apos;Manual&apos;, &apos;Subscription&apos;)&#10;&#10;    AND &#10;([vertical_parent] = &apos;Dmarts&apos;&#10;    OR&#10;[vertical_type] =&apos;supermarket&apos;&#10;    OR &#10;[vertical_type] = &apos;hypermarket&apos;)&#10;    AND&#10;[channel] IN(&apos;Own Delivery&apos;)&#10;THEN 1 ELSE 0 END)&#10;)' />
            </column>
            <column caption='Has Paid Prio Fee' datatype='boolean' name='[Calculation_1829305887812501618]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='ABS(IFNULL([priority_fee_eur],0))&#10;+ ABS(IFNULL([priority_fee_net],0))&#10;+ ABS(IFNULL([dps_priority_fee_opted_in_local],0))&#10;&gt; 0' />
            </column>
            <column caption='DBDF No Brainer (flat DF)' datatype='real' default-format='*#,##0.0%;(#,##0.0%);-' name='[DBDF Flag 2 (component level) (copy)_1603070390420414496]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(&#10;SUM(if [travel_time_fee_type] &lt;&gt; &apos;Variable&apos; &#10;    AND &#10;[travel_time_fee_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;Subscription&apos;)&#10;    AND &#10;ISNULL([travel_time_fee_type]) = FALSE &#10;&#10;    AND&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[channel] = &apos;Own Delivery&apos;&#10;THEN 1 ELSE 0 END)&#10;&#10;/&#10;&#10;SUM(if &#10;[travel_time_fee_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;Subscription&apos;)&#10;    AND &#10;[is_dps] = TRUE &#10;&#10;    AND&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[channel] = &apos;Own Delivery&apos;&#10;THEN 1 ELSE 0 END)&#10;)' />
            </column>
            <column caption='DBDF No Brainer' datatype='real' default-format='*#,##0.0%;(#,##0.0%);-' name='[DBDF Flag 2 (copy)_1603070390419382303]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(&#10;SUM(if &#10;[travel_time_fee_assignment_type] IN  (&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;Subscription&apos;)&#10;    AND&#10;[travel_time_fee_type] = &apos;Variable&apos; &#10;    AND &#10;&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[channel] = &apos;Own Delivery&apos;&#10;THEN 1 ELSE 0 END)&#10;&#10;/&#10;&#10;SUM(if &#10;[travel_time_fee_assignment_type] IN &#10;(&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;Subscription&apos;)&#10;    AND&#10;[is_dps] = TRUE &#10;    AND&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[channel] = &apos;Own Delivery&apos;&#10;THEN 1 ELSE 0 END)&#10;)' />
            </column>
            <column caption='Has MOV' datatype='boolean' name='[Has Paid DF (copy)_1829305887816900732]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT ISNULL([minimum_order_value_eur])' />
            </column>
            <column caption='QC MOV No Brainer' datatype='real' default-format='*#,##0.0%;(#,##0.0%);-' name='[MOV No Brainer (copy)_1603070390390984732]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(&#10;SUM(IF &#10;    [Paid Small Basket Fee (copy)_1829305887584337993] = TRUE&#10;        AND&#10;    [hard_mov] &gt;= 0&#10;        AND &#10;    IFNULL([sbf_cap], 0) &gt; 0&#10;        AND&#10;    [minimum_order_value_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;MOV Override&apos;, &apos;Subscription&apos;)&#10;    &#10;&#10;AND [dps_minimum_order_value_eur] &gt; 0&#10;&#10;    AND &#10;[vertical_parent] IN(&apos;Dmarts&apos;, &apos;Local Shops&apos;)&#10;    AND&#10;[channel] IN(&apos;Own Delivery&apos;)&#10; THEN 1 ELSE 0&#10;END)&#10;&#10;/&#10;&#10;SUM(if [is_dps] = TRUE &#10; AND&#10;    [minimum_order_value_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;MOV Override&apos;, &apos;Subscription&apos;)&#10;AND [dps_minimum_order_value_eur] &gt; 0&#10;&#10;    AND &#10;[vertical_parent] IN(&apos;Dmarts&apos;, &apos;Local Shops&apos;)&#10;    AND&#10;[channel] IN(&apos;Own Delivery&apos;)&#10;THEN 1 ELSE 0 END)&#10;)' />
            </column>
            <column caption='MOV Order Proportion No Brainer' datatype='real' default-format='*#,##0.0%;(#,##0.0%);-' name='[MOV No Brainer (copy)_1603070391140958255]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(&#10;SUM(IF [Has Paid DF (copy)_1829305887816900732] = TRUE&#10;AND [dps_minimum_order_value_eur] &gt; 0&#10;&#10;        AND&#10;    [minimum_order_value_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;MOV Override&apos;, &apos;Subscription&apos;)&#10;        AND&#10;[vertical_parent] = &apos;Food&apos;&#10;        AND&#10;    [channel] = &apos;Own Delivery&apos;&#10;     THEN 1 ELSE 0&#10;END)&#10;/&#10;SUM(if [is_dps] = TRUE&#10;    AND&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[channel] = &apos;Own Delivery&apos;&#10;    THEN 1 ELSE 0 END)&#10;)' />
            </column>
            <column caption='Is Small Basket Fee Enabled' datatype='boolean' name='[Paid Small Basket Fee (copy)_1829305887584337993]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([small_basket_fee_eur],0)+IFNULL([small_basket_fee_net],0) &gt; 0 OR [is_small_order_fee]' />
            </column>
            <column caption='Saver Well Configured No Brainer' datatype='real' default-format='*#,##0.0%;(#,##0.0%);-' name='[Priority No Brainer (copy)_1603070390129582092]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(&#10;SUM(IF ISNULL([saver_fee_component_id]) = FALSE&#10;    AND&#10;[saver_fee_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;SaverFee&apos;)&#10;    AND&#10;(IFNULL([max_saver_fee], 0) - IFNULL([min_saver_fee], 0)) &lt;&gt; 0 &#10;    AND&#10;[is_dps] = TRUE&#10;    AND&#10;[dps_saver_discount_opted_in_eur] &lt;&gt; 0&#10;    AND&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[channel] = &apos;Own Delivery&apos;&#10;THEN 1 ELSE 0 END)&#10;&#10;    /&#10;&#10;SUM(IF ISNULL([saver_fee_component_id]) = FALSE&#10;    AND&#10;[saver_fee_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;SaverFee&apos;)&#10;    AND&#10;[is_dps] = TRUE&#10;    AND&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[channel] = &apos;Own Delivery&apos;&#10;THEN 1 ELSE 0 END)&#10;)' />
            </column>
