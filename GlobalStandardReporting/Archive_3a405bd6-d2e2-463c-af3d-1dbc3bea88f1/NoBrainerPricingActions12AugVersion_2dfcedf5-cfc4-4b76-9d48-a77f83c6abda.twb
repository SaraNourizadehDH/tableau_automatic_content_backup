              <calculation class='tableau' formula='ZN(&#10;SUM(IF ISNULL([saver_fee_component_id]) = FALSE&#10;    AND&#10;[saver_fee_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;SaverFee&apos;)&#10;    AND&#10;[is_dps] = TRUE&#10;    AND&#10;[dps_saver_discount_opted_in_eur] &lt;&gt; 0&#10;&#10;    AND&#10;[vertical_parent] IN(&apos;Dmarts&apos;, &apos;Local Shops&apos;)&#10;    AND&#10;[channel] = &apos;Own Delivery&apos;&#10;THEN 1 ELSE 0 END)&#10;&#10;&#10;  /&#10;&#10;SUM(IF &#10;/*&#10;[saver_fee_assignment_type] IN (&apos;SaverFee&apos;)&#10;    AND&#10;*/&#10;[is_dps] = TRUE&#10;&#10;    AND&#10;[vertical_parent] IN(&apos;Dmarts&apos;, &apos;Local Shops&apos;)&#10;    AND&#10;[channel] = &apos;Own Delivery&apos;&#10;THEN 1 ELSE 0 END)&#10;)' />
            </column>
            <column caption='Saver Order Proportion No Brainer' datatype='real' default-format='*#,##0.0%;(#,##0.0%);-' name='[Saver Well Configured No Brainer (copy)_1603070391107498030]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(&#10;SUM(IF ISNULL([saver_fee_component_id]) = FALSE&#10;    AND&#10;[saver_fee_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;SaverFee&apos;)&#10;    AND&#10;[is_dps] = TRUE&#10;    AND&#10;[dps_saver_discount_opted_in_eur] &lt;&gt; 0&#10;&#10;    AND&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[channel] = &apos;Own Delivery&apos;&#10;THEN 1 ELSE 0 END)&#10;&#10;&#10;  /&#10;&#10;SUM(IF &#10;/*&#10;[saver_fee_assignment_type] IN (&apos;SaverFee&apos;)&#10;    AND&#10;*/&#10;[is_dps] = TRUE&#10;&#10;    AND&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[channel] = &apos;Own Delivery&apos;&#10;THEN 1 ELSE 0 END)&#10;)' />
            </column>
            <column caption='QC Saver Well Configured No Brainer' datatype='real' default-format='*#,##0.0%;(#,##0.0%);-' name='[Saver Well Configured No Brainer (copy)_1603070392436908096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(&#10;SUM(IF ISNULL([saver_fee_component_id]) = FALSE&#10;    AND&#10;[saver_fee_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;SaverFee&apos;)&#10;    AND&#10;(IFNULL([max_saver_fee], 0) - IFNULL([min_saver_fee], 0)) &lt;&gt; 0 &#10;    AND&#10;[is_dps] = TRUE&#10;    AND&#10;[dps_saver_discount_opted_in_eur] &lt;&gt; 0&#10;    AND&#10;[vertical_parent] IN(&apos;Dmarts&apos;, &apos;Local Shops&apos;)&#10;    AND&#10;[channel] = &apos;Own Delivery&apos;&#10;THEN 1 ELSE 0 END)&#10;&#10;    /&#10;&#10;SUM(IF ISNULL([saver_fee_component_id]) = FALSE&#10;    AND&#10;[saver_fee_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;SaverFee&apos;)&#10;    AND&#10;[is_dps] = TRUE&#10;    AND&#10;[vertical_parent] IN(&apos;Dmarts&apos;, &apos;Local Shops&apos;)&#10;    AND&#10;[channel] = &apos;Own Delivery&apos;&#10;THEN 1 ELSE 0 END)&#10;)' />
