      <column caption='Service Fee Proportion Order No Brainer' datatype='real' default-format='*#,##0.0%;(#,##0.0%);-' name='[Service Fee No Brainer (copy)_1603070391141773360]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(&#10;SUM(IF &#10;ISNULL(service_fee_type) = FALSE&#10;    AND&#10;[service_fee_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;Service Fee Override&apos;, &apos;Subscription&apos;)&#10;&#10;    AND&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[channel] = &apos;Pick-up&apos;&#10;THEN 1 ELSE 0&#10;END)&#10;&#10;/&#10;&#10;SUM(IF [is_dps] = TRUE &#10;&#10;    AND&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[channel] = &apos;Pick-up&apos;&#10;THEN 1 ELSE 0 END)&#10;)' />
      </column>
      <column caption='QC Service Fee No Brainer' datatype='real' default-format='*#,##0.0%;(#,##0.0%);-' name='[Service Fee No Brainer (copy)_1603070392425328696]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(&#10;SUM(IF &#10;service_fee_type = &apos;Percentage&apos;&#10;    AND&#10;[max_service_fee] &lt;&gt; [min_service_fee]&#10;    AND&#10;/*&#10;[service_fee_condition_type] &lt;&gt; &apos;New Customer&apos;&#10;*/&#10;[service_fee_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;Service Fee Override&apos;, &apos;Subscription&apos;)&#10;    AND&#10;[vertical_parent] IN (&apos;Dmarts&apos;, &apos;Local Shops&apos;)&#10;    AND&#10;[channel] = &apos;Pick-up&apos;&#10;THEN 1 ELSE 0&#10;END)&#10;&#10;/&#10;&#10;SUM(IF [is_dps] = TRUE &#10;    AND&#10;/*&#10;[service_fee_condition_type] &lt;&gt; &apos;New Customer&apos;&#10;*/&#10;[service_fee_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;Service Fee Override&apos;, &apos;Subscription&apos;)&#10;&#10;    AND&#10;[vertical_parent] IN (&apos;Dmarts&apos;, &apos;Local Shops&apos;)&#10;    AND&#10;[channel] = &apos;Pick-up&apos;&#10;THEN 1 ELSE 0 END)&#10;)' />
      </column>
      <column caption='Service Fee No Brainer with pct' datatype='real' hidden='true' name='[Service Fee No Brainer with absolute (copy)_1603070390385385498]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='SUM(IF &#10;service_fee_type = &apos;Percentage&apos;&#10;    AND&#10;/*&#10;[service_fee_condition_type] &lt;&gt; &apos;New Customer&apos;&#10;*/&#10;[service_fee_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;Service Fee Override&apos;, &apos;Subscription&apos;)&#10;&#10;    AND&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[channel] = &apos;Pick-up&apos;&#10;THEN 1 ELSE 0&#10;END)&#10;&#10;/&#10;&#10;SUM(IF [is_dps] = TRUE &#10;    AND&#10;/*&#10;[service_fee_condition_type] &lt;&gt; &apos;New Customer&apos;&#10;*/&#10;[service_fee_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;Service Fee Override&apos;, &apos;Subscription&apos;)&#10;&#10;    AND&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[channel] = &apos;Pick-up&apos;&#10;THEN 1 ELSE 0 END)' />
      </column>
      <column caption='QC Service Fee Proportion Order No Brainer' datatype='real' default-format='*#,##0.0%;(#,##0.0%);-' name='[Service Fee Proportion Order No Brainer (copy)_1603070392426663994]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(&#10;SUM(IF &#10;ISNULL(service_fee_type) = FALSE&#10;    AND&#10;[service_fee_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;Service Fee Override&apos;, &apos;Subscription&apos;)&#10;&#10;    AND&#10;[vertical_parent] IN(&apos;Dmarts&apos;, &apos;Local Shops&apos;)&#10;    AND&#10;[channel] = &apos;Pick-up&apos;&#10;THEN 1 ELSE 0&#10;END)&#10;&#10;/&#10;&#10;SUM(IF [is_dps] = TRUE &#10;&#10;    AND&#10;[vertical_parent] IN(&apos;Dmarts&apos;, &apos;Local Shops&apos;)&#10;    AND&#10;[channel] = &apos;Pick-up&apos;&#10;THEN 1 ELSE 0 END)&#10;)' />
      </column>
