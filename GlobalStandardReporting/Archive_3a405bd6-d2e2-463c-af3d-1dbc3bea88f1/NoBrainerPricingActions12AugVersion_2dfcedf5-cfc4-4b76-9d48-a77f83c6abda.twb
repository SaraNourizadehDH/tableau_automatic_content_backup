            <column caption='Service Fee Proportion Order No Brainer' datatype='real' default-format='*#,##0.0%;(#,##0.0%);-' name='[Service Fee No Brainer (copy)_1603070391141773360]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(&#10;SUM(IF &#10;ISNULL(service_fee_type) = FALSE&#10;    AND&#10;[service_fee_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;Service Fee Override&apos;, &apos;Subscription&apos;)&#10;&#10;    AND&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[channel] = &apos;Pick-up&apos;&#10;THEN 1 ELSE 0&#10;END)&#10;&#10;/&#10;&#10;SUM(IF [is_dps] = TRUE &#10;&#10;    AND&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[channel] = &apos;Pick-up&apos;&#10;THEN 1 ELSE 0 END)&#10;)' />
