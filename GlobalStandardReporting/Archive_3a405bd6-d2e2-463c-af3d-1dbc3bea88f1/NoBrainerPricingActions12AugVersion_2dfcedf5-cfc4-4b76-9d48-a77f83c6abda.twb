      <column caption='Basket Value Paid (per order)' datatype='real' default-format='n#,##0.00;-#,##0.00' hidden='true' name='[Basket Value Paid (copy)_1132936785174761494]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([basket_value_paid_eur])/COUNT([__tableau_internal_object_id__].[pricing_framework_31443A764E8F4C8ABB81B0659FA41FC5]),8)' />
