              <calculation class='tableau' formula='ZN(&#10;SUM(IF [Calculation_1829305887812501618] = TRUE&#10;    AND&#10;[priority_fee_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Priority Fee Override&apos;)&#10;    AND&#10;[is_dps] = TRUE&#10;&#10;    AND&#10;[vertical_parent] IN(&apos;Dmarts&apos;, &apos;Local Shops&apos;)&#10;    AND&#10;[channel] = &apos;Own Delivery&apos;&#10;THEN 1 ELSE 0 END)&#10;&#10;    /&#10;SUM(IF [is_dps] = TRUE &#10;    AND&#10;[priority_fee_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Priority Fee Override&apos;)&#10;    AND&#10;[is_dps] = TRUE&#10;&#10;    AND&#10;[vertical_parent] IN(&apos;Dmarts&apos;, &apos;Local Shops&apos;)&#10;    AND&#10;[channel] = &apos;Own Delivery&apos;&#10;THEN 1 ELSE 0 END)&#10;)' />
            </column>
            <column caption='Priority Proportion No Brainer' datatype='real' default-format='*#,##0.0%;(#,##0.0%);-' name='[Priority Well Configured No Brainer (copy)_1603070391102771245]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(&#10;SUM(IF [Calculation_1829305887812501618] = TRUE&#10;    AND&#10;[priority_fee_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Priority Fee Override&apos;)&#10;    AND&#10;[is_dps] = TRUE&#10;&#10;    AND&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[channel] = &apos;Own Delivery&apos;&#10;THEN 1 ELSE 0 END)&#10;&#10;    /&#10;SUM(IF [is_dps] = TRUE &#10;    AND&#10;[priority_fee_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Priority Fee Override&apos;)&#10;    AND&#10;[is_dps] = TRUE&#10;&#10;    AND&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[channel] = &apos;Own Delivery&apos;&#10;THEN 1 ELSE 0 END)&#10;)' />
