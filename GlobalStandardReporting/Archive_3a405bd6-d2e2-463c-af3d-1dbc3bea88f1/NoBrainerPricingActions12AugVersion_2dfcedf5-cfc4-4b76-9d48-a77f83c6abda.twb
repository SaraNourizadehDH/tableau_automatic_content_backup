      <column caption='VW (CF) Affordable' datatype='boolean' hidden='true' name='[VW Bucket (copy)_139330180141162499]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[customer_fees_paid_eur] &lt;= [max_acceptable_price_range_eur]' />
      </column>
      <column caption='VW Range (DF)' datatype='string' hidden='true' name='[VW Range (CF) (copy)_4419720106191073304]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [delivery_fee_eur] = 0 THEN &apos;Free&apos;&#13;&#10;ELSEIF [delivery_fee_eur] &lt;= [promo_price_range_eur] THEN &apos;Very Cheap&apos;&#13;&#10;ELSEIF [delivery_fee_eur] &lt;= [min_acceptable_price_range_eur] THEN &apos;Cheap&apos;&#13;&#10;ELSEIF [delivery_fee_eur] &lt;= [Calculation_2515260399165648906] THEN &apos;Middle point&apos;&#13;&#10;ELSEIF [delivery_fee_eur] &lt;= [max_acceptable_price_range_eur] THEN &apos;Expensive&apos;&#13;&#10;ELSEIF [delivery_fee_eur] &lt;= [long_price_range_eur] THEN &apos;Too Expensive&apos;&#13;&#10;ELSEIF [delivery_fee_eur] &gt; [long_price_range_eur] THEN &apos;Not Acceptable&apos;&#13;&#10;ELSE &apos;Unknown&apos;&#13;&#10;END' />
      </column>
      <column caption='Total Vendor Funded Fees' datatype='real' default-format='n#,##0.00;-#,##0.00' hidden='true' name='[Vendor Funded Delivery Fee Subsidy Net (copy)_5755600392051896379]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([customer_fees_vendor_funded])/[Calculation_1139973721956712471],2)' />
