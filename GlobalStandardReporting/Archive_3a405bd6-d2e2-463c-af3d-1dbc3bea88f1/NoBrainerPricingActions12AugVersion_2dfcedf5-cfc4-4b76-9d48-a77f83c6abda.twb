        <calculation class='tableau' formula='ZN(&#10;SUM(IF [Has Paid DF (copy)_1829305887816900732] = TRUE&#10;&#10;        AND [minimum_order_value_eur] &gt; 0.0&#10;        AND&#10;    [minimum_order_value_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;MOV Override&apos;, &apos;Subscription&apos;)&#10;    &#10;    AND &#10;[vertical_parent] IN(&apos;Dmarts&apos;, &apos;Local Shops&apos;)&#10;    AND&#10;[channel] IN(&apos;Own Delivery&apos;)&#10; THEN 1 ELSE 0&#10;END)&#10;&#10;/&#10;&#10;SUM(if [is_dps] = TRUE &#10;&#10;    AND &#10;[vertical_parent] IN(&apos;Dmarts&apos;, &apos;Local Shops&apos;)&#10;    AND&#10;[channel] IN(&apos;Own Delivery&apos;)&#10;THEN 1 ELSE 0 END)&#10;)' />
      </column>
      <column caption='Reference (2)' datatype='real' default-format='n#,##0.00;-#,##0.00' hidden='true' name='[Reference (copy)_3085810179161337931]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Reference (copy)_3085810179161309258]&#13;&#10;WHEN &apos;Orders&apos; THEN SUM(IF [is_successful] THEN 1 ELSE 0 END)&#13;&#10;WHEN &apos;Orders (M)&apos; THEN SUM(IF [is_successful] THEN 1 ELSE 0 END) / 1000000&#13;&#10;WHEN &apos;Customer Accounts&apos; THEN COUNTD([global_entity_id] + &apos;-&apos; + [customer_account_id])&#13;&#10;WHEN &apos;Customer Accounts (M)&apos; THEN COUNTD([global_entity_id] + &apos;-&apos; + [customer_account_id]) / 1000000&#13;&#10;WHEN &apos;Analytical Customers&apos; THEN COUNTD([global_entity_id] + &apos;-&apos; + [analytical_customer_id])&#13;&#10;WHEN &apos;Analytical Customers (M)&apos; THEN COUNTD([global_entity_id] + &apos;-&apos; + [analytical_customer_id]) / 1000000&#13;&#10;WHEN &apos;Vendors&apos; THEN COUNTD([global_entity_id] + &apos;-&apos; + [vendor_id])&#13;&#10;WHEN &apos;Vendors (M)&apos; THEN COUNTD([global_entity_id] + &apos;-&apos; + [vendor_id]) / 1000000&#13;&#10;WHEN &apos;GMV&apos; THEN SUM([gmv_eur])&#13;&#10;WHEN &apos;GMV (M)&apos; THEN SUM([gmv_eur]) / 1000000&#13;&#10;WHEN &apos;Basket Value&apos; THEN SUM([basket_value_paid_eur])&#13;&#10;WHEN &apos;Basket Value (M)&apos; THEN SUM([basket_value_paid_eur]) / 1000000&#13;&#10;WHEN &apos;Total Fees Paid&apos; THEN SUM([total_fees_paid_eur])&#13;&#10;WHEN &apos;Total Fees Paid (M)&apos; THEN SUM([total_fees_paid_eur]) / 1000000&#13;&#10;WHEN &apos;Total Fees Net&apos; THEN SUM([total_fees_paid_net_eur])&#13;&#10;WHEN &apos;Total Fees Net (M)&apos; THEN SUM([total_fees_paid_net_eur]) / 1000000&#13;&#10;END' />
      </column>
      <column caption='Retention Month over 0' datatype='boolean' hidden='true' name='[Retention Month between 0 and 16 (copy)_1829305887474933785]' role='dimension' type='nominal'>
