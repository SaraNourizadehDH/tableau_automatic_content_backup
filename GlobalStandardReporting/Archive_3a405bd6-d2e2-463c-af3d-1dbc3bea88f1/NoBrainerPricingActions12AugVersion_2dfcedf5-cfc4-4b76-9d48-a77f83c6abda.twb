      <column caption='DBDF No Brainer (flat DF)' datatype='real' default-format='*#,##0.0%;(#,##0.0%);-' name='[DBDF Flag 2 (component level) (copy)_1603070390420414496]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(&#10;SUM(if [travel_time_fee_type] &lt;&gt; &apos;Variable&apos; &#10;    AND &#10;[travel_time_fee_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;Subscription&apos;)&#10;    AND &#10;ISNULL([travel_time_fee_type]) = FALSE &#10;&#10;    AND&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[channel] = &apos;Own Delivery&apos;&#10;THEN 1 ELSE 0 END)&#10;&#10;/&#10;&#10;SUM(if &#10;[travel_time_fee_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;Subscription&apos;)&#10;    AND &#10;[is_dps] = TRUE &#10;&#10;    AND&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[channel] = &apos;Own Delivery&apos;&#10;THEN 1 ELSE 0 END)&#10;)' />
      </column>
      <column caption='DBDF No Brainer' datatype='real' default-format='*#,##0.0%;(#,##0.0%);-' name='[DBDF Flag 2 (copy)_1603070390419382303]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(&#10;SUM(if &#10;[travel_time_fee_assignment_type] IN  (&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;Subscription&apos;)&#10;    AND&#10;[travel_time_fee_type] = &apos;Variable&apos; &#10;    AND &#10;&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[channel] = &apos;Own Delivery&apos;&#10;THEN 1 ELSE 0 END)&#10;&#10;/&#10;&#10;SUM(if &#10;[travel_time_fee_assignment_type] IN &#10;(&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;Subscription&apos;)&#10;    AND&#10;[is_dps] = TRUE &#10;    AND&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[channel] = &apos;Own Delivery&apos;&#10;THEN 1 ELSE 0 END)&#10;)' />
      </column>
      <column caption='DBDF Proportion No Brainer' datatype='real' hidden='true' name='[DBDF No Brainer (copy)_1603070391395356724]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(&#10;SUM(if &#10;[travel_time_fee_assignment_type] IN &#10;(&apos;Automatic scheme&apos;, &apos;Campaign Override&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;Subscription&apos;)&#10;    AND&#10;[travel_time_fee_type] = &apos;Variable&apos; &#10;    AND &#10;&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[channel] = &apos;Own Delivery&apos;&#10;THEN 1 ELSE 0 END)&#10;&#10;/&#10;&#10;SUM(if &#10;[is_dps] = TRUE &#10;    AND&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[channel] = &apos;Own Delivery&apos;&#10;THEN 1 ELSE 0 END)&#10;)' />
      </column>
      <column caption='DPS Aggregation (ops)' datatype='real' default-format='n#,##0.00;-#,##0.00' hidden='true' name='[DPS Aggregation (copy)_3085810177977397289]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Aggregation (copy)_3085810177976442919]&#13;&#10;WHEN &apos;Total&apos; THEN 1&#13;&#10;WHEN &apos;Total (M)&apos; THEN 1000000&#13;&#10;WHEN &apos;Total (k)&apos; THEN 1000&#13;&#10;WHEN &apos;Per Cent&apos; THEN COUNT([__tableau_internal_object_id__].[pricing_framework_31443A764E8F4C8ABB81B0659FA41FC5]) / 100&#13;&#10;WHEN &apos;Per Order&apos; THEN SUM(IF [is_dps] THEN 1 END)&#13;&#10;WHEN &apos;Per Customer Account&apos; THEN COUNTD(IF [is_dps] THEN [customer_account_id] END)&#13;&#10;WHEN &apos;Per Analyt. Customer&apos; THEN COUNTD(IF [is_dps] THEN [analytical_customer_id] END)&#13;&#10;WHEN &apos;Per Day&apos; THEN COUNTD(IF [is_dps] THEN [order_placed_at] END)&#13;&#10;/**&#13;&#10;WHEN &apos;Per Day&apos; THEN &#13;&#10;&#9;MAX(IF DATETRUNC(&apos;month&apos;,[Order Placed At]) &lt; DATETRUNC(&apos;month&apos;, TODAY())&#13;&#10;    &#9;THEN DATEPART(&apos;day&apos;,(DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,1,[Order Placed At])) - 1))&#13;&#10;&#9;&#9;ELSE DATEPART(&apos;day&apos;,[Order Placed At])&#13;&#10;&#9;END)&#13;&#10;**/&#13;&#10;WHEN &apos;% GMV&apos; THEN SUM(IF [is_dps] THEN [gmv_eur] END) / 100&#13;&#10;WHEN &apos;% Basket Value&apos; THEN SUM(IF [is_dps] THEN [basket_value_paid_eur] END) / 100&#13;&#10;WHEN &apos;% Main Dish Price&apos; THEN SUM([main_dish_price_eur]) / 100&#13;&#10;WHEN &apos;% Total Fees&apos; THEN SUM(IF [is_dps] THEN [total_fees_paid_eur] END) / 100&#13;&#10;WHEN &apos;% Total Fees Net&apos; THEN SUM(IF [is_dps] THEN [total_fees_paid_net_eur] END) / 100&#13;&#10;//WHEN &apos;% of Orders&apos; THEN WINDOW_SUM(COUNT([pricing_framework])) / 100&#13;&#10;END' />
      </column>
      <column caption='DPS Service Fee' datatype='real' default-format='n#,##0.00;-#,##0.00' hidden='true' name='[DPS Bad Weather Fee (copy)_6532541696563535936]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([dps_service_fee_eur])/[Aggregation (copy)_1846475850361638916],2)' />
