; THEN SUM([promised_eta_m])/[Aggregation (copy)_3085810177976483880]&#13;&#10;        WHEN &apos;Vendor Age&apos; THEN SUM([days_since_activation])/[Aggregation (copy)_3085810177976483880]&#13;&#10;        WHEN &apos;Profitable Orders&apos; THEN [Calculation_3085810177769197570]/[Aggregation (copy)_3085810177976483880]&#13;&#10;        // DPS components&#13;&#10;        WHEN &apos;Service Fee Enabled&apos; THEN [Profitable Orders (copy)_3085810177970946083]/[DPS Aggregation (copy)_3085810177977397289]&#13;&#10;        WHEN &apos;Surge Fee Enabled&apos; THEN [Service Fee Enabled (copy)_3085810177978617898]/[DPS Aggregation (copy)_3085810177977397289]&#13;&#10;        WHEN &apos;Prio Fee Enabled&apos; THEN [DPS Prio Orders (copy)_2825305104109748260]&#13;&#10;        WHEN &apos;Prio Fee Orders&apos; THEN [Calculation_2825305104109449251]&#13;&#10;    END&#13;&#10;END' />
