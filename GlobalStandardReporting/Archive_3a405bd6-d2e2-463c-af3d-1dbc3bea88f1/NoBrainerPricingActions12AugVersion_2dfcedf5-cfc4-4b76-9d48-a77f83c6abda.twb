            <column caption='QC Priority Well Configured No Brainer' datatype='real' default-format='*#,##0.0%;(#,##0.0%);-' name='[Priority Well Configured No Brainer (copy)_1603070392434253885]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(&#10;SUM(IF [Calculation_1829305887812501618] = TRUE&#10;    AND&#10;[priority_fee_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Priority Fee Override&apos;)&#10;    AND&#10;(IFNULL([max_prio_fee], 0) - IFNULL([min_prio_fee], 0)) &lt;&gt; 0 &#10;    AND&#10;[is_dps] = TRUE&#10;&#10;    AND&#10;[vertical_parent] IN(&apos;Dmarts&apos;, &apos;Local Shops&apos;)&#10;    AND&#10;[channel] = &apos;Own Delivery&apos;&#10;THEN 1 ELSE 0 END)&#10;&#10;    /&#10;SUM(IF [Calculation_1829305887812501618] = TRUE &#10;    AND&#10;[priority_fee_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Priority Fee Override&apos;)&#10;    AND&#10;[is_dps] = TRUE&#10;&#10;    AND&#10;[vertical_parent] IN(&apos;Dmarts&apos;, &apos;Local Shops&apos;)&#10;    AND&#10;[channel] = &apos;Own Delivery&apos;&#10;THEN 1 ELSE 0 END)&#10;)' />
            </column>
            <column caption='QC MOV Proportion No Brainer' datatype='real' default-format='*#,##0.0%;(#,##0.0%);-' name='[QC MOV No Brainer (copy)_1603070391385436210]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(&#10;SUM(IF [Has Paid DF (copy)_1829305887816900732] = TRUE&#10;&#10;        AND [minimum_order_value_eur] &gt; 0.0&#10;        AND&#10;    [minimum_order_value_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;MOV Override&apos;, &apos;Subscription&apos;)&#10;    &#10;    AND &#10;[vertical_parent] IN(&apos;Dmarts&apos;, &apos;Local Shops&apos;)&#10;    AND&#10;[channel] IN(&apos;Own Delivery&apos;)&#10; THEN 1 ELSE 0&#10;END)&#10;&#10;/&#10;&#10;SUM(if [is_dps] = TRUE &#10;&#10;    AND &#10;[vertical_parent] IN(&apos;Dmarts&apos;, &apos;Local Shops&apos;)&#10;    AND&#10;[channel] IN(&apos;Own Delivery&apos;)&#10;THEN 1 ELSE 0 END)&#10;)' />
