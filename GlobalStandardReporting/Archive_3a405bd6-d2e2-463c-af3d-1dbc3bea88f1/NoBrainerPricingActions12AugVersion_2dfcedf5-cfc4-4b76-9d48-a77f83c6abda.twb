        <calculation class='tableau' formula='[Calculation_1139973722179629090] + [Small Basket Net (copy)_1139973722288521258] + [Subscription Vendor Subsidy Net (copy)_1139973722288619563]' />
      </column>
      <column caption='Affordable Orders %' datatype='real' default-format='p0.0%' hidden='true' name='[Customer Fees Paid (copy)_2515260399185506323]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;IF [VW Bucket (copy)_139330180141162499] THEN 1&#13;&#10;ELSEIF NOT [VW Bucket (copy)_139330180141162499] THEN 0&#13;&#10;ELSE NULL &#13;&#10;END)&#13;&#10;/&#13;&#10;SUM(&#13;&#10;IF [VW Bucket (copy)_139330180141162499] THEN 1&#13;&#10;ELSEIF NOT [VW Bucket (copy)_139330180141162499] THEN 1&#13;&#10;ELSE NULL&#13;&#10;END)' />
