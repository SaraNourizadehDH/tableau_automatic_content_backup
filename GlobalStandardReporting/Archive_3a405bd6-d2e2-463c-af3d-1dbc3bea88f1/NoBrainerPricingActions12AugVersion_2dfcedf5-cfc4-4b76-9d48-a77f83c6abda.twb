      <column caption='Basket Value Nominal' datatype='real' default-format='n#,##0.00;-#,##0.00' hidden='true' name='[Bad Weather Fee Net (copy)_5755600392040370217]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([basket_value_nominal_eur])/[Calculation_1139973721956712471],2)' />
