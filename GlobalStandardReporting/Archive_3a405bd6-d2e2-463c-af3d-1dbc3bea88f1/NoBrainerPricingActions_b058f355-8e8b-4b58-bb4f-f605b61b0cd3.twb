        <calculation class='tableau' formula='IF [Priority Well Configured No Brainer (copy)_1603070392434253885] &gt;= 0.9 AND COUNT([priority_fee_component_id]) &gt; 0 THEN &apos;TRUE&apos;&#10;ELSEIF [Priority Well Configured No Brainer (copy)_1603070392434253885] &lt; 0.9 AND COUNT([priority_fee_component_id]) &gt; 0 THEN &apos;FALSE&apos;&#10;ELSEIF COUNT([priority_fee_component_id]) = 0 THEN &apos;NULL&apos;&#10;END' />
      </column>
