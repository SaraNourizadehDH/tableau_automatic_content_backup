              <calculation class='tableau' formula='ROUND(SUM([subscription_vendor_subsidy_net])/[Calculation_1139973721956712471],2)' />
            </column>
            <column caption='Vendor Funded Delivery Fee Subsidy Net' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Subscription Vendor Subsidy Net (copy)_1139973722288619563]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([vendor_funded_delivery_fee_subsidy_net])/[Calculation_1139973721956712471],2)' />
            </column>
            <column caption='VW Range (DF)' datatype='string' name='[VW Range (CF) (copy)_4419720106191073304]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [delivery_fee_eur] = 0 THEN &apos;Free&apos;&#13;&#10;ELSEIF [delivery_fee_eur] &lt;= [promo_price_range_eur] THEN &apos;Very Cheap&apos;&#13;&#10;ELSEIF [delivery_fee_eur] &lt;= [min_acceptable_price_range_eur] THEN &apos;Cheap&apos;&#13;&#10;ELSEIF [delivery_fee_eur] &lt;= [Calculation_2515260399165648906] THEN &apos;Middle point&apos;&#13;&#10;ELSEIF [delivery_fee_eur] &lt;= [max_acceptable_price_range_eur] THEN &apos;Expensive&apos;&#13;&#10;ELSEIF [delivery_fee_eur] &lt;= [long_price_range_eur] THEN &apos;Too Expensive&apos;&#13;&#10;ELSEIF [delivery_fee_eur] &gt; [long_price_range_eur] THEN &apos;Not Acceptable&apos;&#13;&#10;ELSE &apos;Unknown&apos;&#13;&#10;END' />
            </column>
            <column caption='Reference' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Volume (copy)_139330180158468118]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Aggregation (copy)_166351713677688839]&#13;&#10;WHEN &apos;Orders (Total)&apos; THEN SUM(IF [is_successful] THEN 1 ELSE 0 END) / [Calculation_7704110864525000788]&#13;&#10;WHEN &apos;Customer Accounts (Total)&apos; THEN COUNTD([global_entity_id] + &apos;-&apos; + [customer_account_id]) / [Calculation_7704110864525000788]&#13;&#10;WHEN &apos;Analytical Customers (Total)&apos; THEN COUNTD([global_entity_id] + &apos;-&apos; + [analytical_customer_id]) / [Calculation_7704110864525000788]&#13;&#10;WHEN &apos;Vendors (Total)&apos; THEN COUNTD([global_entity_id] + &apos;-&apos; + [vendor_id]) / [Calculation_7704110864525000788]&#13;&#10;WHEN &apos;GMV (Total)&apos; THEN SUM([gmv_eur]) / [Calculation_7704110864525000788]&#13;&#10;WHEN &apos;Basket Value (Total)&apos; THEN SUM([basket_value_paid_eur]) / [Calculation_7704110864525000788]&#13;&#10;WHEN &apos;Total Fees Paid (Total)&apos; THEN SUM([total_fees_paid_eur]) / [Calculation_7704110864525000788]&#13;&#10;WHEN &apos;Total Fees Net (Total)&apos; THEN SUM([total_fees_paid_net_eur]) / [Calculation_7704110864525000788]&#13;&#10;END' />
            </column>
            <column caption='Reference Name' datatype='string' name='[Volume (copy)_2515823408466898948]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Aggregation (copy)_166351713677688839]' />
            </column>
            <_.fcp.ObjectModelTableType.false...column caption='Orders' datatype='integer' name='[__tableau_internal_object_id__].[pricing_framework_31443A764E8F4C8ABB81B0659FA41FC5]' role='measure' type='quantitative' />
