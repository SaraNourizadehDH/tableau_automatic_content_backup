                  <value>&quot;GV_RS&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;South&quot;'>
                  <value>&quot;PY_BO&quot;</value>
                  <value>&quot;PY_CL&quot;</value>
                  <value>&quot;PY_PE&quot;</value>
                  <value>&quot;PY_PY&quot;</value>
                  <value>&quot;PY_UY&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Tail&quot;'>
