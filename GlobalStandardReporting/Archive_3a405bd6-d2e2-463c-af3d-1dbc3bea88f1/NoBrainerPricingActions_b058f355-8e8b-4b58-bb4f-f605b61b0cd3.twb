            <column caption='Long Price Range %' datatype='real' default-format='p0.0%' name='[Min Acceptable Range % (copy) (copy)_2515260398881517571]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([long_price_range_eur])/SUM([avg_basket_eur])' />
            </column>
            <column caption='Max Acceptable Range %' datatype='real' default-format='p0.0%' name='[Min Acceptable Range % (copy)_2515260398881505282]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([max_acceptable_price_range_eur])/SUM([avg_basket_eur])' />
            </column>
            <column caption='Middle Point Range %' datatype='real' default-format='p0.0%' name='[Not Acceptable Range % (copy)_2515260399166738443]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2515260399165648906])/SUM([avg_basket_eur])' />
