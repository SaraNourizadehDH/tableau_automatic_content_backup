              <calculation class='tableau' formula='CASE [Parameters].[Aggregation (copy)_166351713677688839]&#13;&#10;WHEN &apos;Orders (Total)&apos; THEN SUM(IF [is_successful] THEN 1 ELSE 0 END) / [Calculation_7704110864525000788]&#13;&#10;WHEN &apos;Customer Accounts (Total)&apos; THEN COUNTD([global_entity_id] + &apos;-&apos; + [customer_account_id]) / [Calculation_7704110864525000788]&#13;&#10;WHEN &apos;Analytical Customers (Total)&apos; THEN COUNTD([global_entity_id] + &apos;-&apos; + [analytical_customer_id]) / [Calculation_7704110864525000788]&#13;&#10;WHEN &apos;Vendors (Total)&apos; THEN COUNTD([global_entity_id] + &apos;-&apos; + [vendor_id]) / [Calculation_7704110864525000788]&#13;&#10;WHEN &apos;GMV (Total)&apos; THEN SUM([gmv_eur]) / [Calculation_7704110864525000788]&#13;&#10;WHEN &apos;Basket Value (Total)&apos; THEN SUM([basket_value_paid_eur]) / [Calculation_7704110864525000788]&#13;&#10;WHEN &apos;Total Fees Paid (Total)&apos; THEN SUM([total_fees_paid_eur]) / [Calculation_7704110864525000788]&#13;&#10;WHEN &apos;Total Fees Net (Total)&apos; THEN SUM([total_fees_paid_net_eur]) / [Calculation_7704110864525000788]&#13;&#10;END' />
