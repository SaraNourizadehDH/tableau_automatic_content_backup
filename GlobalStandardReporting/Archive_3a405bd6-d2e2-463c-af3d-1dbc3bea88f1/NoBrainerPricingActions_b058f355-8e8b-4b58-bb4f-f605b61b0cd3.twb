            <column caption='Delivery Fee (Q3)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Delivery Fee (Q3) (copy)_1829305887747752025]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RAWSQLAGG_REAL(&quot;APPROX_QUANTILES(%1,1000)[OFFSET(750)]&quot;, [delivery_fee_eur]) * COUNT([__tableau_internal_object_id__].[pricing_framework_31443A764E8F4C8ABB81B0659FA41FC5]) / [Calculation_1139973721956712471]' />
            </column>
            <column caption='Delivery Fee (median)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Delivery Fee (median) (copy)_1829305887747752021]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RAWSQLAGG_REAL(&quot;APPROX_QUANTILES(%1,1000)[OFFSET(500)]&quot;, [delivery_fee_eur]) * COUNT([__tableau_internal_object_id__].[pricing_framework_31443A764E8F4C8ABB81B0659FA41FC5]) / [Calculation_1139973721956712471]' />
