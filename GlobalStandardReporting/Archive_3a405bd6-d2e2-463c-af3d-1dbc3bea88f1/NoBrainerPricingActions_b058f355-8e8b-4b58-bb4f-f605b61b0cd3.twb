          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='pricing_framework (growth_pricing)' name='federated.16xq89b15ombu418amgk303gpxk5' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Reference' datatype='string' name='[Aggregation (copy)_166351713677688839]' param-domain-type='list' role='measure' type='nominal' value='&quot;Orders (Total)&quot;'>
              <calculation class='tableau' formula='&quot;Orders (Total)&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.16xq89b15ombu418amgk303gpxk5].[Calculation_1132936785207181350]' _.fcp.ParameterDefaultValues.true...source-field='[federated.16xq89b15ombu418amgk303gpxk5].[Calculation_1139973722200334376]' caption='Month Analyzed' datatype='date' default-format='*mmm-yyyy' name='[Parameter 5]' param-domain-type='list' role='measure' type='quantitative' value='#2025-07-01#'>
              <calculation class='tableau' formula='#2025-07-01#' />
            </column>
            <column alias='Days recorded' caption='Scale' datatype='boolean' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='false'>
              <calculation class='tableau' formula='false' />
              <aliases>
                <alias key='false' value='Days recorded' />
                <alias key='true' value='30-day equivalent' />
              </aliases>
            </column>
            <column caption='Breakdown' datatype='string' name='[Sub-Detail (copy)_1132936785167228938]' param-domain-type='list' role='measure' type='nominal' value='&quot;Sub-Segment&quot;'>
              <calculation class='tableau' formula='&quot;Sub-Segment&quot;' />
            </column>
            <column caption='Unit' datatype='string' name='[Total Fees Paid Net (M) Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Million (M)&quot;'>
              <calculation class='tableau' formula='&quot;Million (M)&quot;' />
            </column>
            <column caption='Detail' datatype='string' name='[Vertical Type Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Brand Name&quot;'>
              <calculation class='tableau' formula='&quot;Brand Name&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.16xq89b15ombu418amgk303gpxk5'>
            <column datatype='string' name='[Brand Name (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[brand_name]' new-bin='true'>
                <bin default-name='false' value='&quot;DH Greece&quot;'>
                  <value>&quot;eFood&quot;</value>
                  <value>&quot;Foody&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='Breakdown ungrouped' datatype='string' name='[Breakdown (copy)_1132936785213071400]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Sub-Detail (copy)_1132936785167228938]&#13;&#10;WHEN &apos;Brand Name&apos; THEN [Brand Name (group)]&#13;&#10;WHEN &apos;Chain Name&apos; THEN [chain_name]&#13;&#10;WHEN &apos;Channel&apos; THEN [channel]&#13;&#10;WHEN &apos;City Name&apos; THEN [city_name] + &quot; (&quot; + [country_code] + &quot;)&quot;&#13;&#10;WHEN &apos;City Tier&apos; THEN [city_tier]&#13;&#10;WHEN &apos;Country Code&apos; THEN [country_code]&#13;&#10;WHEN &apos;Global Entity Id&apos; THEN [global_entity_id]&#13;&#10;WHEN &apos;Has DPS Incentive&apos; THEN&#13;&#10;&#9;CASE [has_dps_incentive]&#13;&#10;    WHEN TRUE THEN &apos;Has DPS Incentive&apos;&#13;&#10;    WHEN FALSE THEN &apos;&apos;&#13;&#10;&#9;ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Holdout&apos; THEN&#13;&#10;    CASE [is_customer_holdout]&#13;&#10;    WHEN TRUE THEN &apos;Holdout&apos;&#13;&#10;    WHEN FALSE THEN &apos;Usual&apos;&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Is DPS&apos; THEN &#13;&#10;CASE [is_dps]&#13;&#10;    WHEN TRUE THEN &apos;Has DPS data&apos;&#13;&#10;    WHEN FALSE THEN &apos;No DPS data&apos;&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Is Subscriber&apos; THEN&#13;&#10;&#9;CASE [is_subscriber]&#13;&#10;    WHEN TRUE THEN &apos;Subscriber&apos;&#13;&#10;    WHEN FALSE THEN &apos;Non-Subscriber&apos;&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Is Preorder&apos; THEN&#13;&#10;&#9;CASE [is_preorder]&#13;&#10;    WHEN TRUE THEN &apos;Preorder&apos;&#13;&#10;    WHEN FALSE THEN &apos;On-demand&apos;&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Key Account Category&apos; THEN [key_account_category]&#13;&#10;WHEN &apos;Market Archetype&apos; THEN [market_archetype]&#13;&#10;WHEN &apos;Meal for One&apos; THEN&#13;&#10;    CASE [is_meal_for_one]&#13;&#10;    WHEN TRUE THEN &apos;Is Meal for One&apos;&#13;&#10;    WHEN FALSE THEN &apos;&apos;&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Occasion - Day of Week&apos; THEN [occasion_day_of_week]&#13;&#10;WHEN &apos;Occasion - Time of Day&apos; THEN [occasion_time_of_day]&#13;&#10;WHEN &apos;Online Payment&apos; THEN&#13;&#10;    CASE [is_paid_online]&#13;&#10;    WHEN TRUE THEN &apos;Online&apos;&#13;&#10;    WHEN FALSE THEN &apos;Offline&apos;&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Segment&apos; THEN [segment]&#13;&#10;WHEN &apos;Sub-Segment&apos; THEN [Global Entity Id (group)]&#13;&#10;WHEN &apos;Sub Entity&apos; THEN [sub_entity]&#13;&#10;WHEN &apos;Vendor Class&apos; THEN [vendor_class]&#13;&#10;WHEN &apos;Vendor Name&apos; THEN [vendor_name]&#13;&#10;WHEN &apos;Vertical Parent&apos; THEN [vertical_parent]&#13;&#10;WHEN &apos;Vertical Type&apos; THEN [vertical_type]&#13;&#10;&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
            </column>
            <column caption='Months Elapsed' datatype='boolean' name='[Calculation_1132936785160491009]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,[Parameters].[Parameter 5], [Calculation_1139973722200334376]) = 0' />
            </column>
            <column caption='Default month' datatype='date' datatype-customized='true' name='[Calculation_1132936785207181350]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ MAX(DATE(DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, [order_placed_at])))) }' />
            </column>
            <column caption='Scaling Adjustment' datatype='real' name='[Calculation_1132936785236541487]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 6] THEN &#13;&#10;DATEPART(&apos;day&apos;, MAX([order_placed_at])) &#13;&#10;//COUNTD([Order Placed At])&#13;&#10;/ 30 ELSE 1 END' />
            </column>
            <column caption='Detail Ungrouped' datatype='string' name='[Calculation_1139973721954193430]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Vertical Type Parameter]&#13;&#10;WHEN &apos;Brand Name&apos; THEN [Brand Name (group)]&#13;&#10;WHEN &apos;Chain Name&apos; THEN [chain_name]&#13;&#10;WHEN &apos;Channel&apos; THEN [channel]&#13;&#10;WHEN &apos;City Name&apos; THEN [city_name] + &quot; (&quot; + [country_code] + &quot;)&quot;&#13;&#10;WHEN &apos;City Tier&apos; THEN [city_tier]&#13;&#10;WHEN &apos;Country Code&apos; THEN [country_code]&#13;&#10;WHEN &apos;Global Entity Id&apos; THEN [global_entity_id]&#13;&#10;WHEN &apos;Has DPS Incentive&apos; THEN&#13;&#10;&#9;CASE [has_dps_incentive]&#13;&#10;    WHEN TRUE THEN &apos;Has DPS Incentive&apos;&#13;&#10;    WHEN FALSE THEN &apos;&apos;&#13;&#10;&#9;ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Holdout&apos; THEN&#13;&#10;    CASE [is_customer_holdout]&#13;&#10;    WHEN TRUE THEN &apos;Holdout&apos;&#13;&#10;    WHEN FALSE THEN &apos;Usual&apos;&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Is DPS&apos; THEN &#13;&#10;CASE [is_dps]&#13;&#10;    WHEN TRUE THEN &apos;Has DPS data&apos;&#13;&#10;    WHEN FALSE THEN &apos;No DPS data&apos;&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Is Subscriber&apos; THEN&#13;&#10;&#9;CASE [is_subscriber]&#13;&#10;    WHEN TRUE THEN &apos;Subscriber&apos;&#13;&#10;    WHEN FALSE THEN &apos;Non-Subscriber&apos;&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Is Preorder&apos; THEN&#13;&#10;&#9;CASE [is_preorder]&#13;&#10;    WHEN TRUE THEN &apos;Preorder&apos;&#13;&#10;    WHEN FALSE THEN &apos;On-demand&apos;&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Key Account Category&apos; THEN [key_account_category]&#13;&#10;WHEN &apos;Market Archetype&apos; THEN [market_archetype]&#13;&#10;WHEN &apos;Meal for One&apos; THEN&#13;&#10;    CASE [is_meal_for_one]&#13;&#10;    WHEN TRUE THEN &apos;Is Meal for One&apos;&#13;&#10;    WHEN FALSE THEN &apos;&apos;&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Occasion - Day of Week&apos; THEN [occasion_day_of_week]&#13;&#10;WHEN &apos;Occasion - Time of Day&apos; THEN [occasion_time_of_day]&#13;&#10;WHEN &apos;Online Payment&apos; THEN&#13;&#10;    CASE [is_paid_online]&#13;&#10;    WHEN TRUE THEN &apos;Online&apos;&#13;&#10;    WHEN FALSE THEN &apos;Offline&apos;&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Segment&apos; THEN [segment]&#13;&#10;WHEN &apos;Sub-Segment&apos; THEN [Global Entity Id (group)]&#13;&#10;WHEN &apos;Sub Entity&apos; THEN [sub_entity]&#13;&#10;WHEN &apos;Vendor Class&apos; THEN [vendor_class]&#13;&#10;WHEN &apos;Vendor Name&apos; THEN [vendor_name]&#13;&#10;WHEN &apos;Vertical Parent&apos; THEN [vertical_parent]&#13;&#10;WHEN &apos;Vertical Type&apos; THEN [vertical_type]&#13;&#10;&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
            </column>
            <column caption='Month' datatype='date' datatype-customized='true' default-format='*mmm&apos;yy' name='[Calculation_1139973722200334376]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [order_placed_at]))' />
            </column>
