            <column caption='Small Basket Fee Net' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Service Fee Net (copy)_1139973722153009183]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([small_basket_fee_net])/[Calculation_1139973721956712471],2)' />
            </column>
            <column caption='Service Fee Paid' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Service Fee Net (copy)_5755600392050638902]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([service_fee_eur])/[Calculation_1139973721956712471],2)' />
            </column>
            <column caption='Small Basket Fee Paid' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Small Basket Fee Net (copy)_5755600392052346940]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([small_basket_fee_eur])/[Calculation_1139973721956712471],2)' />
            </column>
            <column caption='Subscription Vendor Subsidy Net' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Small Basket Net (copy)_1139973722288521258]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([subscription_vendor_subsidy_net])/[Calculation_1139973721956712471],2)' />
            </column>
            <column caption='Color' datatype='string' name='[Sub-Detail (copy)_6657657258483863554]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Color Ungrouped Set] THEN [Sub-Detail Ungrouped (copy)_6657657258483818497] ELSE &apos;[Others]&apos; END' />
            </column>
            <column caption='Color Ungrouped' datatype='string' name='[Sub-Detail Ungrouped (copy)_6657657258483818497]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Sub-Detail (copy)_6657657258483912707]&#13;&#10;WHEN &apos;Brand Name&apos; THEN [Brand Name (group)]&#13;&#10;WHEN &apos;Chain Name&apos; THEN [chain_name]&#13;&#10;WHEN &apos;Channel&apos; THEN [channel]&#13;&#10;WHEN &apos;City Name&apos; THEN [city_name]&#13;&#10;WHEN &apos;Country Code&apos; THEN [country_code]&#13;&#10;WHEN &apos;Global Entity Id&apos; THEN [global_entity_id]&#13;&#10;WHEN &apos;Has DPS Incentive&apos; THEN STR([has_dps_incentive])&#13;&#10;WHEN &apos;Is Preorder&apos; THEN STR([is_preorder])&#13;&#10;WHEN &apos;Is Subscriber&apos; THEN STR([is_subscriber])&#13;&#10;WHEN &apos;Market Archetype&apos; THEN [market_archetype]&#13;&#10;WHEN &apos;Segment&apos; THEN [segment]&#13;&#10;WHEN &apos;Sub-Segment&apos; THEN [Global Entity Id (group)]&#13;&#10;WHEN &apos;Sub Entity&apos; THEN [sub_entity]&#13;&#10;WHEN &apos;Vendor Name&apos; THEN [vendor_name]&#13;&#10;WHEN &apos;Vertical Parent&apos; THEN [vertical_parent]&#13;&#10;WHEN &apos;Vertical Type&apos; THEN [vertical_type]&#13;&#10;WHEN &apos;Holdout&apos; THEN&#13;&#10;    CASE [is_customer_holdout]&#13;&#10;    WHEN TRUE THEN &apos;Holdout&apos;&#13;&#10;    WHEN FALSE THEN &apos;Usual&apos;&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Occasion - Time of Day&apos; THEN [occasion_time_of_day]&#13;&#10;WHEN &apos;Occasion - Day of Week&apos; THEN [occasion_day_of_week]&#13;&#10;WHEN &apos;Online Payment&apos; THEN&#13;&#10;    CASE [is_paid_online]&#13;&#10;    WHEN TRUE THEN &apos;Online&apos;&#13;&#10;    WHEN FALSE THEN &apos;Offline&apos;&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Key Account Category&apos; THEN [key_account_category]&#13;&#10;WHEN &apos;Meal for One&apos; THEN&#13;&#10;    CASE [is_meal_for_one]&#13;&#10;    WHEN TRUE THEN &apos;MFO&apos;&#13;&#10;    WHEN FALSE THEN &apos;Normal&apos;&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Vendor Class&apos; THEN [vendor_class]&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
            </column>
            <column caption='Vendor Funded Delivery Fee Subsidy Net' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Subscription Vendor Subsidy Net (copy)_1139973722288619563]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([vendor_funded_delivery_fee_subsidy_net])/[Calculation_1139973721956712471],2)' />
            </column>
            <column caption='Total Fees Paid' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Total Fees Paid Net (copy)_5755600392043515951]' role='measure' type='quantitative'>
