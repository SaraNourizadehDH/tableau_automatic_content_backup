    <worksheet name='QC BBDF Flag'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>QC BBDF Proporition in Order For Dmart and AAA Groceries</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='pricing_framework (growth_pricing)' name='federated.16xq89b15ombu418amgk303gpxk5' />
          </datasources>
          <datasource-dependencies datasource='federated.16xq89b15ombu418amgk303gpxk5'>
            <column datatype='string' name='[Brand Name (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[brand_name]' new-bin='true'>
                <bin default-name='false' value='&quot;DH Greece&quot;'>
                  <value>&quot;eFood&quot;</value>
                  <value>&quot;Foody&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='Min(1)' datatype='integer' name='[Calculation_1603070390097866763]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Min(1)' />
            </column>
            <column caption='QC BBDF No Brainer' datatype='real' name='[Calculation_1603070390695165988]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(&#10;SUM(IF [is_df_discount_basket_value_deal] = TRUE &#10;    AND&#10;[basket_value_discount_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Manual&apos;, &apos;Subscription&apos;)&#10;    AND&#10;[is_dps] = TRUE &#10;    AND&#10;([vertical_parent] = &apos;Dmarts&apos;&#10;    OR&#10;[vertical_type] =&apos;supermarket&apos;&#10;    OR &#10;[vertical_type] = &apos;hypermarket&apos;)&#10;    AND&#10;[channel] IN(&apos;Own Delivery&apos;)&#10;THEN 1 ELSE 0 END)&#10;&#10;/&#10;&#10;SUM(IF [is_dps] = TRUE &#10;&#10;&#10;//    AND&#10;//[basket_value_discount_assignment_type] IN (&apos;Automatic scheme&apos;,  &apos;Manual&apos;, &apos;Subscription&apos;)&#10;&#10;    AND &#10;([vertical_parent] = &apos;Dmarts&apos;&#10;    OR&#10;[vertical_type] =&apos;supermarket&apos;&#10;    OR &#10;[vertical_type] = &apos;hypermarket&apos;)&#10;    AND&#10;[channel] IN(&apos;Own Delivery&apos;)&#10;THEN 1 ELSE 0 END)&#10;)' />
            </column>
            <column caption='QC BBDF Flag No Brainer' datatype='string' name='[Calculation_1603070390699339814]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1603070390695165988] &gt;= 0.9 AND COUNT([basket_value_discount_component_id]) &gt; 0 THEN &apos;TRUE&apos;&#10;ELSEIF  [Calculation_1603070390695165988] &lt; 0.9 AND COUNT([basket_value_discount_component_id]) &gt; 0 THEN &apos;FALSE&apos;&#10;ELSEIF COUNT([basket_value_discount_component_id]) = 0 THEN &apos;NULL&apos;&#10;END' />
            </column>
            <column caption='BBDF Vertical Type' datatype='string' name='[Calculation_1603070390722175015]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [vertical_type] = &apos;darkstores&apos; THEN &apos;darkstores&apos;&#10;ELSEIF  [vertical_type] IN(&apos;hypermarket&apos;, &apos;supermarket&apos;) THEN &apos;AAA Groceries&apos;&#10;ELSE null&#10;END' />
            </column>
            <column caption='QC BBDF Proportion No Brainer' datatype='real' name='[QC BBDF No Brainer (copy)_1603070391387648051]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(&#10;SUM(IF [is_df_discount_basket_value_deal] = TRUE &#10;    AND&#10;[basket_value_discount_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Manual&apos;, &apos;Subscription&apos;)&#10;    AND&#10;[is_dps] = TRUE &#10;&#10;    AND &#10;([vertical_parent] = &apos;Dmarts&apos;&#10;    OR&#10;[vertical_type] IN(&apos;supermarket&apos;, &apos;hypermarket&apos;))&#10;    AND&#10;[channel] IN(&apos;Own Delivery&apos;)&#10;THEN 1 ELSE 0 END)&#10;&#10;/&#10;&#10;SUM(IF [is_dps] = TRUE &#10;&#10;    AND &#10;([vertical_parent] = &apos;Dmarts&apos;&#10;    OR&#10;[vertical_type] IN(&apos;supermarket&apos;, &apos;hypermarket&apos;))&#10;    AND&#10;[channel] IN(&apos;Own Delivery&apos;)&#10;THEN 1 ELSE 0 END)&#10;)' />
            </column>
            <column datatype='string' name='[basket_value_discount_assignment_type]' role='dimension' type='nominal' />
            <column aggregation='Sum' datatype='real' name='[basket_value_discount_component_id]' role='dimension' type='ordinal' />
            <column caption='Brand Name' datatype='string' name='[brand_name]' role='dimension' type='nominal' />
            <column caption='Channel' datatype='string' name='[channel]' role='dimension' type='nominal' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column datatype='string' name='[hva_type]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[is_df_discount_basket_value_deal]' role='dimension' type='nominal' />
            <column caption='Is Dps' datatype='boolean' name='[is_dps]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1603070390722175015]' derivation='None' name='[none:Calculation_1603070390722175015:nk]' pivot='key' type='nominal' />
            <column-instance column='[channel]' derivation='None' name='[none:channel:nk]' pivot='key' type='nominal' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[hva_type]' derivation='None' name='[none:hva_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[vertical_parent]' derivation='None' name='[none:vertical_parent:nk]' pivot='key' type='nominal' />
            <column-instance column='[vertical_type]' derivation='None' name='[none:vertical_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1603070390097866763]' derivation='User' name='[usr:Calculation_1603070390097866763:vtavg:qk]' pivot='key' type='quantitative' visual-totals='Avg' />
            <column-instance column='[Calculation_1603070390695165988]' derivation='User' name='[usr:Calculation_1603070390695165988:vtavg:qk]' pivot='key' type='quantitative' visual-totals='Avg' />
            <column-instance column='[Calculation_1603070390699339814]' derivation='User' name='[usr:Calculation_1603070390699339814:nk]' pivot='key' type='nominal' />
            <column-instance column='[QC BBDF No Brainer (copy)_1603070391387648051]' derivation='User' name='[usr:QC BBDF No Brainer (copy)_1603070391387648051:qk]' pivot='key' type='quantitative' />
            <column caption='Vertical Parent' datatype='string' name='[vertical_parent]' role='dimension' type='nominal' />
            <column caption='Vertical Type' datatype='string' name='[vertical_type]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.16xq89b15ombu418amgk303gpxk5].[none:channel:nk]'>
            <groupfilter function='level-members' level='[none:channel:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.16xq89b15ombu418amgk303gpxk5].[none:hva_type:nk]'>
            <groupfilter function='level-members' level='[none:hva_type:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.16xq89b15ombu418amgk303gpxk5].[none:vertical_parent:nk]'>
            <groupfilter function='union' user:ui-domain='cascading' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:vertical_parent:nk]' member='&quot;Dmarts&quot;' />
              <groupfilter function='member' level='[none:vertical_parent:nk]' member='&quot;Local Shops&quot;' />
            </groupfilter>
          </filter>
          <filter class='categorical' column='[federated.16xq89b15ombu418amgk303gpxk5].[none:vertical_type:nk]'>
            <groupfilter function='union' user:ui-domain='cascading' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:vertical_type:nk]' member='&quot;darkstores&quot;' />
              <groupfilter function='member' level='[none:vertical_type:nk]' member='&quot;hypermarket&quot;' />
              <groupfilter function='member' level='[none:vertical_type:nk]' member='&quot;supermarket&quot;' />
            </groupfilter>
          </filter>
          <slices>
            <column>[federated.16xq89b15ombu418amgk303gpxk5].[none:channel:nk]</column>
            <column>[federated.16xq89b15ombu418amgk303gpxk5].[none:hva_type:nk]</column>
            <column>[federated.16xq89b15ombu418amgk303gpxk5].[none:vertical_type:nk]</column>
            <column>[federated.16xq89b15ombu418amgk303gpxk5].[none:vertical_parent:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <encoding attr='space' class='0' field='[federated.16xq89b15ombu418amgk303gpxk5].[usr:Calculation_1603070390097866763:vtavg:qk]' field-type='quantitative' major-origin='0.0' major-show='false' major-spacing='1.0' max='1.0' min='0.0' minor-origin='0.0' minor-show='false' minor-spacing='1.0' range-type='fixed' scope='cols' type='space' />
            <format attr='title' class='0' field='[federated.16xq89b15ombu418amgk303gpxk5].[usr:Calculation_1603070390097866763:vtavg:qk]' scope='cols' value='QC BBDF Proportion' />
