            </column>
            <column caption='Unit' datatype='string' name='[Total Fees Paid Net (M) Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Million (M)&quot;'>
              <calculation class='tableau' formula='&quot;Million (M)&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.16xq89b15ombu418amgk303gpxk5'>
            <column caption='DPS Aggregation' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Aggregation (copy)_1846475850361638916]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Total&apos; THEN 1&#13;&#10;WHEN &apos;Total (M)&apos; THEN 1000000&#13;&#10;WHEN &apos;Total (k)&apos; THEN 1000&#13;&#10;WHEN &apos;Per Order&apos; THEN SUM(IF [is_dps] THEN 1 END)&#13;&#10;WHEN &apos;Per Customer Account&apos; THEN COUNTD(IF [is_dps] THEN [customer_account_id] END)&#13;&#10;WHEN &apos;Per Analyt. Customer&apos; THEN COUNTD(IF [is_dps] THEN [analytical_customer_id] END)&#13;&#10;WHEN &apos;Per Day&apos; THEN COUNTD(IF [is_dps] THEN [order_placed_at] END)&#13;&#10;/**&#13;&#10;WHEN &apos;Per Day&apos; THEN &#13;&#10;&#9;MAX(IF DATETRUNC(&apos;month&apos;,[Order Placed At]) &lt; DATETRUNC(&apos;month&apos;, TODAY())&#13;&#10;    &#9;THEN DATEPART(&apos;day&apos;,(DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,1,[Order Placed At])) - 1))&#13;&#10;&#9;&#9;ELSE DATEPART(&apos;day&apos;,[Order Placed At])&#13;&#10;&#9;END)&#13;&#10;**/&#13;&#10;WHEN &apos;% GMV&apos; THEN SUM(IF [is_dps] THEN [gmv_eur] END) / 100&#13;&#10;WHEN &apos;% Basket Value&apos; THEN SUM(IF [is_dps] THEN [basket_value_paid_eur] END) / 100&#13;&#10;WHEN &apos;% Main Dish Price&apos; THEN SUM([main_dish_price_eur]) / 100&#13;&#10;WHEN &apos;% Total Fees&apos; THEN SUM(IF [is_dps] THEN [total_fees_paid_eur] END) / 100&#13;&#10;WHEN &apos;% Total Fees Net&apos; THEN SUM(IF [is_dps] THEN [total_fees_paid_net_eur] END) / 100&#13;&#10;//WHEN &apos;% of Orders&apos; THEN WINDOW_SUM(COUNT([pricing_framework])) / 100&#13;&#10;END' />
            </column>
            <column caption='Aggregation (ops)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Aggregation (copy)_3085810177976483880]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Aggregation (copy)_3085810177976442919]&#13;&#10;WHEN &apos;Total&apos; THEN 1&#13;&#10;WHEN &apos;Total (M)&apos; THEN 1000000&#13;&#10;WHEN &apos;Total (k)&apos; THEN 1000&#13;&#10;WHEN &apos;Per Cent&apos; THEN COUNT([__tableau_internal_object_id__].[pricing_framework_31443A764E8F4C8ABB81B0659FA41FC5]) / 100&#13;&#10;WHEN &apos;Per Order&apos; THEN COUNT([__tableau_internal_object_id__].[pricing_framework_31443A764E8F4C8ABB81B0659FA41FC5])&#13;&#10;WHEN &apos;Per Customer Account&apos; THEN COUNTD([customer_account_id])&#13;&#10;WHEN &apos;Per Analyt. Customer&apos; THEN COUNTD([analytical_customer_id])&#13;&#10;WHEN &apos;Per Day&apos; THEN COUNTD([order_placed_at])&#13;&#10;/**&#13;&#10;WHEN &apos;Per Day&apos; THEN &#13;&#10;&#9;MAX(IF DATETRUNC(&apos;month&apos;,[Order Placed At]) &lt; DATETRUNC(&apos;month&apos;, TODAY())&#13;&#10;    &#9;THEN DATEPART(&apos;day&apos;,(DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,1,[Order Placed At])) - 1))&#13;&#10;&#9;&#9;ELSE DATEPART(&apos;day&apos;,[Order Placed At])&#13;&#10;&#9;END)&#13;&#10;**/&#13;&#10;WHEN &apos;% GMV&apos; THEN SUM([gmv_eur]) / 100&#13;&#10;WHEN &apos;% Basket Value&apos; THEN SUM([basket_value_paid_eur]) / 100&#13;&#10;WHEN &apos;Per Basket/Minute&apos; THEN SUM([basket_value_paid_eur] * [promised_eta_m]) / 100&#13;&#10;WHEN &apos;Per Minute&apos; THEN SUM([promised_eta_m])&#13;&#10;WHEN &apos;% Basket Value&apos; THEN SUM([basket_value_paid_eur]) / 100&#13;&#10;WHEN &apos;% Main Dish Price&apos; THEN SUM([main_dish_price_eur]) / 100&#13;&#10;WHEN &apos;% Total Fees&apos; THEN SUM([total_fees_paid_eur]) / 100&#13;&#10;WHEN &apos;% Total Fees Net&apos; THEN SUM([total_fees_paid_net_eur]) / 100&#13;&#10;//WHEN &apos;% of Orders&apos; THEN WINDOW_SUM(COUNT([pricing_framework])) / 100&#13;&#10;END' />
            </column>
            <column caption='Bad Weather Fee Paid' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Bad Weather Fee Net (copy)_5755600392040185896]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([bad_weather_fee_eur])/[Calculation_1139973721956712471],2)' />
            </column>
            <column caption='Basket Value Nominal' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Bad Weather Fee Net (copy)_5755600392040370217]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([basket_value_nominal_eur])/[Calculation_1139973721956712471],2)' />
            </column>
            <column caption='Basket Value Paid' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Basket Value Nominal (copy)_5755600392040484906]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([basket_value_paid_eur])/[Calculation_1139973721956712471],2)' />
            </column>
            <column caption='Commission Fee Net' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Basket Value Paid (copy)_5755600392040583211]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([commission_fee_net])/[Calculation_1139973721956712471],2)' />
            </column>
            <column caption='Total Fees DPS' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1139973721946988551]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([total_fees_dps_eur])/[Aggregation (copy)_1846475850361638916],2)' />
            </column>
            <column caption='Customer Fees Paid' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1139973721947025416]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([customer_fees_paid_eur])/[Calculation_1139973721956712471],2)' />
            </column>
            <column caption='Total Fees Paid Net' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1139973721947041801]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([total_fees_paid_net_eur])/[Calculation_1139973721956712471],2)' />
            </column>
            <column caption='Analytical Profit' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1139973721947475979]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([analytical_profit])/[Calculation_1139973721956712471],2)' />
            </column>
            <column caption='Aggregation' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1139973721956712471]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Total&apos; THEN 1&#13;&#10;WHEN &apos;Total (M)&apos; THEN 1000000&#13;&#10;WHEN &apos;Total (k)&apos; THEN 1000&#13;&#10;WHEN &apos;Per Order&apos; THEN COUNT([__tableau_internal_object_id__].[pricing_framework_31443A764E8F4C8ABB81B0659FA41FC5])&#13;&#10;WHEN &apos;Per Customer Account&apos; THEN COUNTD([customer_account_id])&#13;&#10;WHEN &apos;Per Analyt. Customer&apos; THEN COUNTD([analytical_customer_id])&#13;&#10;WHEN &apos;Per Day&apos; THEN COUNTD([order_placed_at])&#13;&#10;/**&#13;&#10;WHEN &apos;Per Day&apos; THEN &#13;&#10;&#9;MAX(IF DATETRUNC(&apos;month&apos;,[Order Placed At]) &lt; DATETRUNC(&apos;month&apos;, TODAY())&#13;&#10;    &#9;THEN DATEPART(&apos;day&apos;,(DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,1,[Order Placed At])) - 1))&#13;&#10;&#9;&#9;ELSE DATEPART(&apos;day&apos;,[Order Placed At])&#13;&#10;&#9;END)&#13;&#10;**/&#13;&#10;WHEN &apos;% GMV&apos; THEN SUM([gmv_eur]) / 100&#13;&#10;WHEN &apos;Per Basket/Minute&apos; THEN SUM([basket_value_paid_eur] * [promised_eta_m]) / 100&#13;&#10;WHEN &apos;Per Minute&apos; THEN SUM([promised_eta_m])&#13;&#10;WHEN &apos;% Basket Value&apos; THEN SUM([basket_value_paid_eur]) / 100&#13;&#10;WHEN &apos;% Main Dish Price&apos; THEN SUM([main_dish_price_eur]) / 100&#13;&#10;WHEN &apos;% Total Fees&apos; THEN SUM([total_fees_paid_eur]) / 100&#13;&#10;WHEN &apos;% Total Fees Net&apos; THEN SUM([total_fees_paid_net_eur]) / 100&#13;&#10;//WHEN &apos;% of Orders&apos; THEN WINDOW_SUM(COUNT([pricing_framework])) / 100&#13;&#10;END' />
            </column>
            <column caption='Customer Fees Vendor Funded' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1139973722179629090]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([customer_fees_vendor_funded])/[Calculation_1139973721956712471],2)' />
            </column>
            <column caption='Customer Fees Third Party Funded' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1139973722179649571]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([customer_fees_third_party_funded])/[Calculation_1139973721956712471],2)' />
            </column>
            <column caption='Customer Fees DH Funded' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1139973722179665956]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([customer_fees_dh_funded])/[Calculation_1139973721956712471],2)' />
            </column>
            <column caption='Customer Fees Nominal' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1139973722183237669]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([customer_fees_paid_eur])/[Calculation_1139973721956712471],2) + [Calculation_2515823408474148870]' />
            </column>
            <column caption='Month' datatype='date' datatype-customized='true' default-format='*mmm&apos;yy' name='[Calculation_1139973722200334376]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [order_placed_at]))' />
            </column>
            <column caption='Cohort' datatype='datetime' default-format='*mmm/yy' name='[Calculation_1829305887477674011]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [first_order_placed_at])' />
            </column>
            <column caption='DPS Incentives' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2515823408474148870]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [has_dps_incentive] THEN [dps_standard_fee_eur] ELSE [dps_delivery_fee_eur] END) &#10;- SUM([dps_delivery_fee_eur])) &#10;/ [Aggregation (copy)_1846475850361638916]' />
            </column>
            <column caption='DPS Prio Orders' datatype='real' name='[Calculation_2825305104109449251]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [dps_priority_fee_opted_in_eur] &lt;&gt; 0 THEN 1 ELSE 0 END) / SUM(IF [is_dps] THEN 1 ELSE 0 END) * 100' />
            </column>
            <column caption='Profitable Orders' datatype='integer' name='[Calculation_3085810177769197570]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_successful] AND [analytical_profit] &gt;= 0 THEN 1 ELSE 0 END)' />
            </column>
            <column caption='Successful Orders' datatype='integer' name='[Calculation_3085810177769836549]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_successful] THEN 1 ELSE 0 END)' />
            </column>
            <column caption='Retention Month' datatype='integer' name='[Calculation_3085810178731069492]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='//FLOOR(&#13;&#10;DATEDIFF(&apos;month&apos;,&#13;&#10;    DATETRUNC(&apos;month&apos;, [first_order_placed_at]),&#13;&#10;    DATETRUNC(&apos;month&apos;, [order_placed_at])&#13;&#10;)&#13;&#10;///30)' />
            </column>
            <column caption='Retention Month between 0 and 16' datatype='boolean' name='[Calculation_3085810178955874367]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_3085810178731069492] &gt;= 0 AND [Calculation_3085810178731069492] &lt;= 15' />
            </column>
            <column caption='Months since Acquisition between 0 and 15' datatype='boolean' name='[Calculation_3085810178957115458]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Months on Book (copy)_3085810178956902465] &gt;= 0 AND [Months on Book (copy)_3085810178956902465] &lt;= 15' />
            </column>
            <column caption='Unit' datatype='integer' name='[Calculation_7704110864525000788]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Total Fees Paid Net (M) Parameter]&#10;WHEN &apos;Standard&apos; THEN 1&#10;WHEN &apos;Thousand (k)&apos; THEN 1000&#10;WHEN &apos;Million (M)&apos; THEN 1000000&#10;WHEN &apos;Billion (B)&apos; THEN 1000000000&#10;END' />
            </column>
            <column caption='Other DH Reductions' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Customer Fees DPS (copy)_1139973722258194473]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1139973721946988551]-[Calculation_1139973721947025416]-[Calculation_1139973722179665956]-[Calculation_1139973722179649571]-[Calculation_1139973722179629090]' />
            </column>
            <column caption='Service Fee Net' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Customer Fees Paid (copy)_1139973722151665692]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([service_fee_net])/[Calculation_1139973721956712471],2)' />
            </column>
            <column caption='Delivery Costs' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Customer Service Fee (copy)_5755600392049983538]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([delivery_costs])/[Calculation_1139973721956712471],2)' />
            </column>
            <column caption='DPS Aggregation (ops)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[DPS Aggregation (copy)_3085810177977397289]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Aggregation (copy)_3085810177976442919]&#13;&#10;WHEN &apos;Total&apos; THEN 1&#13;&#10;WHEN &apos;Total (M)&apos; THEN 1000000&#13;&#10;WHEN &apos;Total (k)&apos; THEN 1000&#13;&#10;WHEN &apos;Per Cent&apos; THEN COUNT([__tableau_internal_object_id__].[pricing_framework_31443A764E8F4C8ABB81B0659FA41FC5]) / 100&#13;&#10;WHEN &apos;Per Order&apos; THEN SUM(IF [is_dps] THEN 1 END)&#13;&#10;WHEN &apos;Per Customer Account&apos; THEN COUNTD(IF [is_dps] THEN [customer_account_id] END)&#13;&#10;WHEN &apos;Per Analyt. Customer&apos; THEN COUNTD(IF [is_dps] THEN [analytical_customer_id] END)&#13;&#10;WHEN &apos;Per Day&apos; THEN COUNTD(IF [is_dps] THEN [order_placed_at] END)&#13;&#10;/**&#13;&#10;WHEN &apos;Per Day&apos; THEN &#13;&#10;&#9;MAX(IF DATETRUNC(&apos;month&apos;,[Order Placed At]) &lt; DATETRUNC(&apos;month&apos;, TODAY())&#13;&#10;    &#9;THEN DATEPART(&apos;day&apos;,(DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,1,[Order Placed At])) - 1))&#13;&#10;&#9;&#9;ELSE DATEPART(&apos;day&apos;,[Order Placed At])&#13;&#10;&#9;END)&#13;&#10;**/&#13;&#10;WHEN &apos;% GMV&apos; THEN SUM(IF [is_dps] THEN [gmv_eur] END) / 100&#13;&#10;WHEN &apos;% Basket Value&apos; THEN SUM(IF [is_dps] THEN [basket_value_paid_eur] END) / 100&#13;&#10;WHEN &apos;% Main Dish Price&apos; THEN SUM([main_dish_price_eur]) / 100&#13;&#10;WHEN &apos;% Total Fees&apos; THEN SUM(IF [is_dps] THEN [total_fees_paid_eur] END) / 100&#13;&#10;WHEN &apos;% Total Fees Net&apos; THEN SUM(IF [is_dps] THEN [total_fees_paid_net_eur] END) / 100&#13;&#10;//WHEN &apos;% of Orders&apos; THEN WINDOW_SUM(COUNT([pricing_framework])) / 100&#13;&#10;END' />
            </column>
            <column caption='DPS Service Fee' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[DPS Bad Weather Fee (copy)_6532541696563535936]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([dps_service_fee_eur])/[Aggregation (copy)_1846475850361638916],2)' />
            </column>
            <column caption='DPS Standard Fee' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[DPS Delivery Fee (copy)_5755600392050372661]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([dps_standard_fee_eur])/[Aggregation (copy)_1846475850361638916],2)' />
            </column>
