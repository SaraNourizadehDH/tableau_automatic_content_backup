            <column caption='GMV (Total)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Orders (M) (copy)_1132936785172951058]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_eur]) / [Calculation_7704110864525000788] / [Calculation_1132936785236541487]' />
