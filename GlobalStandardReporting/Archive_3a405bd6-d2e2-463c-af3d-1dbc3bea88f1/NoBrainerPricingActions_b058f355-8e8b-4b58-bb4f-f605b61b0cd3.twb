            <_.fcp.ObjectModelTableType.true...column caption='Orders' datatype='table' name='[__tableau_internal_object_id__].[pricing_framework_31443A764E8F4C8ABB81B0659FA41FC5]' role='measure' type='quantitative' />
            <column caption='Analytical Customer Id' datatype='string' name='[analytical_customer_id]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1139973722200334376]' derivation='Attribute' name='[attr:Calculation_1139973722200334376:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_5564126972843753524]' derivation='Attribute' name='[attr:Calculation_5564126972843753524:nk]' pivot='key' type='nominal' />
            <column-instance column='[Volume (copy)_2515823408466898948]' derivation='Attribute' name='[attr:Volume (copy)_2515823408466898948:nk]' pivot='key' type='nominal' />
            <column-instance column='[Weekday (copy)_166351713705713675]' derivation='Attribute' name='[attr:Weekday (copy)_166351713705713675:nk]' pivot='key' type='nominal' />
            <column-instance column='[order_placed_at]' derivation='Attribute' name='[attr:order_placed_at:ok]' pivot='key' type='ordinal' />
