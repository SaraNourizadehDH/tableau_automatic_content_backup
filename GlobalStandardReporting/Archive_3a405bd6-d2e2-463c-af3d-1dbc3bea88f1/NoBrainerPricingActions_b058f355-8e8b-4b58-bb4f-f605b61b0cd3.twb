            </column>
            <column caption='Financial Metric 1' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Delivery Fee Paid&quot;'>
              <calculation class='tableau' formula='&quot;Delivery Fee Paid&quot;' />
