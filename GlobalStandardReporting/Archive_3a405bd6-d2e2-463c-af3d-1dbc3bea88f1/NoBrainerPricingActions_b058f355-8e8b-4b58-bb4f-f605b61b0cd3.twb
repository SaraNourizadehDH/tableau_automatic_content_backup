    <worksheet name='QC MOV Flag - Dmarts &amp; Groceries'>
      <layout-options>
        <title>
          <formatted-text>
            <run>QC Soft MOV + SBF + Max SBF cap Proportion (over the last month)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='pricing_framework (growth_pricing)' name='federated.16xq89b15ombu418amgk303gpxk5' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Reference' datatype='string' name='[Aggregation (copy)_166351713677688839]' param-domain-type='list' role='measure' type='nominal' value='&quot;Orders (Total)&quot;'>
              <calculation class='tableau' formula='&quot;Orders (Total)&quot;' />
            </column>
            <column caption='Unit' datatype='string' name='[Total Fees Paid Net (M) Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Million (M)&quot;'>
              <calculation class='tableau' formula='&quot;Million (M)&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.16xq89b15ombu418amgk303gpxk5'>
            <column datatype='string' name='[Brand Name (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[brand_name]' new-bin='true'>
                <bin default-name='false' value='&quot;DH Greece&quot;'>
                  <value>&quot;eFood&quot;</value>
                  <value>&quot;Foody&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='Min(1)' datatype='integer' name='[Calculation_1603070390097866763]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Min(1)' />
            </column>
            <column caption='Hard MOV at 0 with SBF Flag No Brainer' datatype='boolean' name='[Calculation_1603070390366695445]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [MOV No Brainer - only Hard MOV (copy)_1603070390353911828] &gt; 0.0 THEN FALSE ELSE TRUE END' />
            </column>
            <column aggregation='Sum' caption='Minimum Order Value Component Id' datatype='real' name='[Calculation_1987494825938444290]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [minimum_order_value_component_id Set] THEN [minimum_order_value_component_id] ELSE 0 END' />
            </column>
            <column caption='Unit' datatype='integer' name='[Calculation_7704110864525000788]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Total Fees Paid Net (M) Parameter]&#10;WHEN &apos;Standard&apos; THEN 1&#10;WHEN &apos;Thousand (k)&apos; THEN 1000&#10;WHEN &apos;Million (M)&apos; THEN 1000000&#10;WHEN &apos;Billion (B)&apos; THEN 1000000000&#10;END' />
            </column>
            <column caption='MOV Hard MOV &gt; 0 with no SBF Flag No Brainer' datatype='boolean' name='[Flag Hard MOV at 0 with SBF (copy)_1603070390369845270]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [MOV No Brainer (copy)_1603070390353600531] &gt; 0.0 THEN FALSE ELSE TRUE END' />
            </column>
            <column caption='Has MOV' datatype='boolean' name='[Has Paid DF (copy)_1829305887816900732]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT ISNULL([minimum_order_value_eur])' />
            </column>
            <column caption='QC MOV Flag No Brainer' datatype='string' name='[MOV Flag No Brainer (copy)_1603070391383834673]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [MOV No Brainer (copy)_1603070390390984732] &gt;= 0.5 AND COUNT([Calculation_1987494825938444290]) &gt; 0 THEN &apos;TRUE&apos;&#10;ELSEIF [MOV No Brainer (copy)_1603070390390984732] &lt; 0.5 AND COUNT([Calculation_1987494825938444290]) &gt; 0 THEN &apos;FALSE&apos; &#10;ELSEIF COUNT([Calculation_1987494825938444290]) = 0 THEN &apos;Null&apos;&#10;END' />
            </column>
            <column caption='MOV No Brainer - Hard MOV &gt; 0 with no SBF' datatype='real' name='[MOV No Brainer (copy)_1603070390353600531]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Has Paid DF (copy)_1829305887816900732] = TRUE&#10;        AND&#10;    [Paid Small Basket Fee (copy)_1829305887584337993] = TRUE&#10;        AND&#10;    ([hard_mov] &gt; 0)&#10;        AND &#10;    (ISNULL([sbf_cap]) = TRUE OR [sbf_cap] = 0)&#10;        AND&#10;    [minimum_order_value_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;MOV Override&apos;, &apos;Subscription&apos;)&#10;    &#10;        AND&#10;[vertical_parent] = &apos;Food&apos;&#10;        AND&#10;    [channel] = &apos;Own Delivery&apos;&#10; THEN 1 ELSE 0&#10;END)&#10;&#10;/&#10;&#10;SUM(if [is_dps] = TRUE &#10;        AND&#10;    [minimum_order_value_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;MOV Override&apos;, &apos;Subscription&apos;)&#10;&#10;    AND&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[channel] = &apos;Own Delivery&apos;&#10;THEN 1 ELSE 0 END)' />
            </column>
            <column caption='QC MOV No Brainer' datatype='real' name='[MOV No Brainer (copy)_1603070390390984732]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(&#10;SUM(IF &#10;    [Paid Small Basket Fee (copy)_1829305887584337993] = TRUE&#10;        AND&#10;    [hard_mov] &gt;= 0&#10;        AND &#10;    IFNULL([sbf_cap], 0) &gt; 0&#10;        AND&#10;    [minimum_order_value_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;MOV Override&apos;, &apos;Subscription&apos;)&#10;    &#10;&#10;AND [dps_minimum_order_value_eur] &gt; 0&#10;&#10;    AND &#10;[vertical_parent] IN(&apos;Dmarts&apos;, &apos;Local Shops&apos;)&#10;    AND&#10;[channel] IN(&apos;Own Delivery&apos;)&#10; THEN 1 ELSE 0&#10;END)&#10;&#10;/&#10;&#10;SUM(if [is_dps] = TRUE &#10; AND&#10;    [minimum_order_value_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;MOV Override&apos;, &apos;Subscription&apos;)&#10;AND [dps_minimum_order_value_eur] &gt; 0&#10;&#10;    AND &#10;[vertical_parent] IN(&apos;Dmarts&apos;, &apos;Local Shops&apos;)&#10;    AND&#10;[channel] IN(&apos;Own Delivery&apos;)&#10;THEN 1 ELSE 0 END)&#10;)' />
            </column>
            <column caption='QC MOV No Brainer - Hard MOV &gt; 0 with no SBF' datatype='real' name='[MOV No Brainer - Hard MOV &gt; 0 with no SBF (copy)_1603070391032942632]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Has Paid DF (copy)_1829305887816900732] = TRUE&#10;        AND&#10;    [Paid Small Basket Fee (copy)_1829305887584337993] = TRUE&#10;        AND&#10;    ([hard_mov] &gt; 0)&#10;        AND &#10;    (ISNULL([sbf_cap]) = TRUE OR [sbf_cap] = 0)&#10;        AND&#10;    [vertical_type] &lt;&gt; &apos;restaurants&apos;&#10; AND&#10;    [minimum_order_value_assignment_type] IN (&apos;Automatic scheme&apos;,&apos;Country fallback&apos;, &apos;Manual&apos;, &apos;MOV Override&apos;, &apos;Subscription&apos;)&#10;    &#10;    &#10;    AND &#10;[vertical_parent] IN(&apos;Dmarts&apos;, &apos;Local Shops&apos;)&#10;    AND&#10;[channel] IN(&apos;Own Delivery&apos;)&#10; THEN 1 ELSE 0&#10;END)&#10;&#10;/&#10;&#10;SUM(if [is_dps] = TRUE &#10; AND&#10;    [minimum_order_value_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;MOV Override&apos;, &apos;Subscription&apos;)&#10;&#10;    AND &#10;[vertical_parent] IN(&apos;Dmarts&apos;, &apos;Local Shops&apos;)&#10;    AND&#10;[channel] IN(&apos;Own Delivery&apos;)&#10;    THEN 1 ELSE 0 END)' />
            </column>
            <column caption='QC MOV No Brainer - Hard MOV at 0 with SBF' datatype='real' name='[MOV No Brainer - Hard MOV at 0 with SBF (copy)_1603070391033298985]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Has Paid DF (copy)_1829305887816900732] = TRUE&#10;        AND&#10;    [Paid Small Basket Fee (copy)_1829305887584337993] = TRUE&#10;        AND&#10;    [hard_mov] = 0&#10;        AND &#10;    ISNULL([sbf_cap]) = FALSE&#10;        AND&#10;    [sbf_cap] &gt; 0&#10; AND&#10;    [minimum_order_value_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;MOV Override&apos;, &apos;Subscription&apos;)&#10;    &#10;&#10;    AND &#10;[vertical_parent] IN(&apos;Dmarts&apos;, &apos;Local Shops&apos;)&#10;    AND&#10;[channel] IN(&apos;Own Delivery&apos;)&#10;     THEN 1 ELSE 0&#10;END)&#10;&#10;/&#10;&#10;SUM(if [is_dps] = TRUE &#10; AND&#10;    [minimum_order_value_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;MOV Override&apos;, &apos;Subscription&apos;)&#10;&#10;    AND &#10;[vertical_parent] IN(&apos;Dmarts&apos;, &apos;Local Shops&apos;)&#10;    AND&#10;[channel] IN(&apos;Own Delivery&apos;)&#10;    THEN 1 ELSE 0 END)' />
            </column>
            <column caption='MOV No Brainer - Hard MOV at 0 with SBF' datatype='real' name='[MOV No Brainer - only Hard MOV (copy)_1603070390353911828]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Has Paid DF (copy)_1829305887816900732] = TRUE&#10;        AND&#10;    [Paid Small Basket Fee (copy)_1829305887584337993] = TRUE&#10;        AND&#10;    [hard_mov] = 0&#10;        AND &#10;    ISNULL([sbf_cap]) = FALSE&#10;        AND&#10;    [sbf_cap] &gt; 0&#10;        AND&#10;    [minimum_order_value_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;MOV Override&apos;, &apos;Subscription&apos;)&#10;    &#10;        AND&#10;[vertical_parent] = &apos;Food&apos;&#10;        AND&#10;    [channel] = &apos;Own Delivery&apos;&#10; THEN 1 ELSE 0&#10;END)&#10;&#10;/&#10;&#10;SUM(if [is_dps] = TRUE &#10;        AND&#10;    [minimum_order_value_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;MOV Override&apos;, &apos;Subscription&apos;)&#10;&#10;    AND&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[channel] = &apos;Own Delivery&apos;&#10;THEN 1 ELSE 0 END)' />
            </column>
            <column caption='Is Small Basket Fee Enabled' datatype='boolean' name='[Paid Small Basket Fee (copy)_1829305887584337993]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([small_basket_fee_eur],0)+IFNULL([small_basket_fee_net],0) &gt; 0 OR [is_small_order_fee]' />
            </column>
            <column caption='QC MOV Proportion No Brainer' datatype='real' name='[QC MOV No Brainer (copy)_1603070391385436210]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(&#10;SUM(IF [Has Paid DF (copy)_1829305887816900732] = TRUE&#10;&#10;        AND [minimum_order_value_eur] &gt; 0.0&#10;        AND&#10;    [minimum_order_value_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;MOV Override&apos;, &apos;Subscription&apos;)&#10;    &#10;    AND &#10;[vertical_parent] IN(&apos;Dmarts&apos;, &apos;Local Shops&apos;)&#10;    AND&#10;[channel] IN(&apos;Own Delivery&apos;)&#10; THEN 1 ELSE 0&#10;END)&#10;&#10;/&#10;&#10;SUM(if [is_dps] = TRUE &#10;&#10;    AND &#10;[vertical_parent] IN(&apos;Dmarts&apos;, &apos;Local Shops&apos;)&#10;    AND&#10;[channel] IN(&apos;Own Delivery&apos;)&#10;THEN 1 ELSE 0 END)&#10;)' />
            </column>
            <column caption='Reference' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Volume (copy)_139330180158468118]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Aggregation (copy)_166351713677688839]&#13;&#10;WHEN &apos;Orders (Total)&apos; THEN SUM(IF [is_successful] THEN 1 ELSE 0 END) / [Calculation_7704110864525000788]&#13;&#10;WHEN &apos;Customer Accounts (Total)&apos; THEN COUNTD([global_entity_id] + &apos;-&apos; + [customer_account_id]) / [Calculation_7704110864525000788]&#13;&#10;WHEN &apos;Analytical Customers (Total)&apos; THEN COUNTD([global_entity_id] + &apos;-&apos; + [analytical_customer_id]) / [Calculation_7704110864525000788]&#13;&#10;WHEN &apos;Vendors (Total)&apos; THEN COUNTD([global_entity_id] + &apos;-&apos; + [vendor_id]) / [Calculation_7704110864525000788]&#13;&#10;WHEN &apos;GMV (Total)&apos; THEN SUM([gmv_eur]) / [Calculation_7704110864525000788]&#13;&#10;WHEN &apos;Basket Value (Total)&apos; THEN SUM([basket_value_paid_eur]) / [Calculation_7704110864525000788]&#13;&#10;WHEN &apos;Total Fees Paid (Total)&apos; THEN SUM([total_fees_paid_eur]) / [Calculation_7704110864525000788]&#13;&#10;WHEN &apos;Total Fees Net (Total)&apos; THEN SUM([total_fees_paid_net_eur]) / [Calculation_7704110864525000788]&#13;&#10;END' />
            </column>
