                  <value>&quot;TB_KW&quot;</value>
                  <value>&quot;TB_OM&quot;</value>
                  <value>&quot;TB_QA&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Greek&quot;'>
                  <value>&quot;EF_GR&quot;</value>
                  <value>&quot;FY_CY&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Hungerstation&quot;'>
                  <value>&quot;HS_SA&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Instashop&quot;'>
                  <value>&quot;IN_AE&quot;</value>
                  <value>&quot;IN_EG&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Nordics&quot;'>
                  <value>&quot;FO_NO&quot;</value>
                  <value>&quot;OP_SE&quot;</value>
                  <value>&quot;PO_FI&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;North&quot;'>
                  <value>&quot;AP_PA&quot;</value>
                  <value>&quot;PY_CR&quot;</value>
                  <value>&quot;PY_DO&quot;</value>
                  <value>&quot;PY_EC&quot;</value>
                  <value>&quot;PY_GT&quot;</value>
                  <value>&quot;PY_HN&quot;</value>
