      <column caption='Prio Fee (10th)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[MOV (10th) (copy)_1829305887809912939]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RAWSQLAGG_REAL(&quot;APPROX_QUANTILES(%1,1000)[OFFSET(100)]&quot;, [priority_fee_eur]) * COUNT([__tableau_internal_object_id__].[pricing_framework_31443A764E8F4C8ABB81B0659FA41FC5]) / [Calculation_1139973721956712471]' />
