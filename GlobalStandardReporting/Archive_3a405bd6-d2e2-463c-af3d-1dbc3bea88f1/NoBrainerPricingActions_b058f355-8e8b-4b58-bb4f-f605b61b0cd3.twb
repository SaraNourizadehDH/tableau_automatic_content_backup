            <column caption='Unhealthy Score' datatype='real' name='[customer_unhealthy_score]' role='measure' type='quantitative' />
            <column caption='Delivery Distance' datatype='real' default-format='n#,##0.00;-#,##0.00' hidden='true' name='[delivery_distance]' role='measure' type='quantitative' />
