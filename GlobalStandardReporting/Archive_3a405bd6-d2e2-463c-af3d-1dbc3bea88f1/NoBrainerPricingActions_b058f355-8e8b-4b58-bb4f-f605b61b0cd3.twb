            <column caption='Total Fees Paid' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Total Fees Paid Net (copy)_5755600392043515951]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([total_fees_paid_eur])/[Calculation_1139973721956712471],2)' />
