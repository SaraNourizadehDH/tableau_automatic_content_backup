      <column caption='Max Service Fee' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Min Service Fee (copy)_1829305887600742475]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([max_service_fee] / [fx_rate_eur])/[Aggregation (copy)_1846475850361638916],2)' />
      </column>
      <column caption='DPS Minimum Order Value' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Minimum Order Value (copy)_1829305887576633413]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([dps_minimum_order_value_eur])/[Calculation_1139973721956712471],2)' />
      </column>
      <column caption='Months since Acquisition' datatype='integer' name='[Months on Book (copy)_3085810178956902465]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, DATETRUNC(&apos;month&apos;, [first_order_placed_at]), DATETRUNC(&apos;month&apos;, TODAY() - 1))' />
