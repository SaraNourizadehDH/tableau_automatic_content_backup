          <datasource-dependencies datasource='federated.16xq89b15ombu418amgk303gpxk5'>
            <column caption='DPS Aggregation' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Aggregation (copy)_1846475850361638916]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Total&apos; THEN 1&#13;&#10;WHEN &apos;Total (M)&apos; THEN 1000000&#13;&#10;WHEN &apos;Total (k)&apos; THEN 1000&#13;&#10;WHEN &apos;Per Order&apos; THEN SUM(IF [is_dps] THEN 1 END)&#13;&#10;WHEN &apos;Per Customer Account&apos; THEN COUNTD(IF [is_dps] THEN [customer_account_id] END)&#13;&#10;WHEN &apos;Per Analyt. Customer&apos; THEN COUNTD(IF [is_dps] THEN [analytical_customer_id] END)&#13;&#10;WHEN &apos;Per Day&apos; THEN COUNTD(IF [is_dps] THEN [order_placed_at] END)&#13;&#10;/**&#13;&#10;WHEN &apos;Per Day&apos; THEN &#13;&#10;&#9;MAX(IF DATETRUNC(&apos;month&apos;,[Order Placed At]) &lt; DATETRUNC(&apos;month&apos;, TODAY())&#13;&#10;    &#9;THEN DATEPART(&apos;day&apos;,(DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,1,[Order Placed At])) - 1))&#13;&#10;&#9;&#9;ELSE DATEPART(&apos;day&apos;,[Order Placed At])&#13;&#10;&#9;END)&#13;&#10;**/&#13;&#10;WHEN &apos;% GMV&apos; THEN SUM(IF [is_dps] THEN [gmv_eur] END) / 100&#13;&#10;WHEN &apos;% Basket Value&apos; THEN SUM(IF [is_dps] THEN [basket_value_paid_eur] END) / 100&#13;&#10;WHEN &apos;% Main Dish Price&apos; THEN SUM([main_dish_price_eur]) / 100&#13;&#10;WHEN &apos;% Total Fees&apos; THEN SUM(IF [is_dps] THEN [total_fees_paid_eur] END) / 100&#13;&#10;WHEN &apos;% Total Fees Net&apos; THEN SUM(IF [is_dps] THEN [total_fees_paid_net_eur] END) / 100&#13;&#10;//WHEN &apos;% of Orders&apos; THEN WINDOW_SUM(COUNT([pricing_framework])) / 100&#13;&#10;END' />
            </column>
            <column datatype='string' name='[Brand Name (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[brand_name]' new-bin='true'>
                <bin default-name='false' value='&quot;DH Greece&quot;'>
                  <value>&quot;eFood&quot;</value>
                  <value>&quot;Foody&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='Distance Buckets (km)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1139973721946095621]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(&#13;&#10;    IF [delivery_distance] &gt; [Parameters].[Basket Bucket Cap (copy)_166351713726308367] THEN [Parameters].[Basket Bucket Cap (copy)_166351713726308367]&#13;&#10;    //ELSEIF [Delivery Distance] &gt; 9 THEN ROUND([Delivery Distance] / 1) * 1&#13;&#10;    //ELSEIF [Delivery Distance] &gt; 6 THEN ROUND([Delivery Distance] / 0.75) * 0.75&#13;&#10;    ELSE ROUND([delivery_distance] / [Parameters].[Basket Bucket Size (copy)_166351713726308366]) * [Parameters].[Basket Bucket Size (copy)_166351713726308366]&#13;&#10;    END&#13;&#10;,2)' />
            </column>
            <column caption='Detail Ungrouped' datatype='string' name='[Calculation_1139973721954193430]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Vertical Type Parameter]&#13;&#10;WHEN &apos;Brand Name&apos; THEN [Brand Name (group)]&#13;&#10;WHEN &apos;Chain Name&apos; THEN [chain_name]&#13;&#10;WHEN &apos;Channel&apos; THEN [channel]&#13;&#10;WHEN &apos;City Name&apos; THEN [city_name] + &quot; (&quot; + [country_code] + &quot;)&quot;&#13;&#10;WHEN &apos;City Tier&apos; THEN [city_tier]&#13;&#10;WHEN &apos;Country Code&apos; THEN [country_code]&#13;&#10;WHEN &apos;Global Entity Id&apos; THEN [global_entity_id]&#13;&#10;WHEN &apos;Has DPS Incentive&apos; THEN&#13;&#10;&#9;CASE [has_dps_incentive]&#13;&#10;    WHEN TRUE THEN &apos;Has DPS Incentive&apos;&#13;&#10;    WHEN FALSE THEN &apos;&apos;&#13;&#10;&#9;ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Holdout&apos; THEN&#13;&#10;    CASE [is_customer_holdout]&#13;&#10;    WHEN TRUE THEN &apos;Holdout&apos;&#13;&#10;    WHEN FALSE THEN &apos;Usual&apos;&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Is DPS&apos; THEN &#13;&#10;CASE [is_dps]&#13;&#10;    WHEN TRUE THEN &apos;Has DPS data&apos;&#13;&#10;    WHEN FALSE THEN &apos;No DPS data&apos;&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Is Subscriber&apos; THEN&#13;&#10;&#9;CASE [is_subscriber]&#13;&#10;    WHEN TRUE THEN &apos;Subscriber&apos;&#13;&#10;    WHEN FALSE THEN &apos;Non-Subscriber&apos;&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Is Preorder&apos; THEN&#13;&#10;&#9;CASE [is_preorder]&#13;&#10;    WHEN TRUE THEN &apos;Preorder&apos;&#13;&#10;    WHEN FALSE THEN &apos;On-demand&apos;&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Key Account Category&apos; THEN [key_account_category]&#13;&#10;WHEN &apos;Market Archetype&apos; THEN [market_archetype]&#13;&#10;WHEN &apos;Meal for One&apos; THEN&#13;&#10;    CASE [is_meal_for_one]&#13;&#10;    WHEN TRUE THEN &apos;Is Meal for One&apos;&#13;&#10;    WHEN FALSE THEN &apos;&apos;&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Occasion - Day of Week&apos; THEN [occasion_day_of_week]&#13;&#10;WHEN &apos;Occasion - Time of Day&apos; THEN [occasion_time_of_day]&#13;&#10;WHEN &apos;Online Payment&apos; THEN&#13;&#10;    CASE [is_paid_online]&#13;&#10;    WHEN TRUE THEN &apos;Online&apos;&#13;&#10;    WHEN FALSE THEN &apos;Offline&apos;&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Segment&apos; THEN [segment]&#13;&#10;WHEN &apos;Sub-Segment&apos; THEN [Global Entity Id (group)]&#13;&#10;WHEN &apos;Sub Entity&apos; THEN [sub_entity]&#13;&#10;WHEN &apos;Vendor Class&apos; THEN [vendor_class]&#13;&#10;WHEN &apos;Vendor Name&apos; THEN [vendor_name]&#13;&#10;WHEN &apos;Vertical Parent&apos; THEN [vertical_parent]&#13;&#10;WHEN &apos;Vertical Type&apos; THEN [vertical_type]&#13;&#10;&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
            </column>
            <column caption='Aggregation' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1139973721956712471]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Total&apos; THEN 1&#13;&#10;WHEN &apos;Total (M)&apos; THEN 1000000&#13;&#10;WHEN &apos;Total (k)&apos; THEN 1000&#13;&#10;WHEN &apos;Per Order&apos; THEN COUNT([__tableau_internal_object_id__].[pricing_framework_31443A764E8F4C8ABB81B0659FA41FC5])&#13;&#10;WHEN &apos;Per Customer Account&apos; THEN COUNTD([customer_account_id])&#13;&#10;WHEN &apos;Per Analyt. Customer&apos; THEN COUNTD([analytical_customer_id])&#13;&#10;WHEN &apos;Per Day&apos; THEN COUNTD([order_placed_at])&#13;&#10;/**&#13;&#10;WHEN &apos;Per Day&apos; THEN &#13;&#10;&#9;MAX(IF DATETRUNC(&apos;month&apos;,[Order Placed At]) &lt; DATETRUNC(&apos;month&apos;, TODAY())&#13;&#10;    &#9;THEN DATEPART(&apos;day&apos;,(DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,1,[Order Placed At])) - 1))&#13;&#10;&#9;&#9;ELSE DATEPART(&apos;day&apos;,[Order Placed At])&#13;&#10;&#9;END)&#13;&#10;**/&#13;&#10;WHEN &apos;% GMV&apos; THEN SUM([gmv_eur]) / 100&#13;&#10;WHEN &apos;Per Basket/Minute&apos; THEN SUM([basket_value_paid_eur] * [promised_eta_m]) / 100&#13;&#10;WHEN &apos;Per Minute&apos; THEN SUM([promised_eta_m])&#13;&#10;WHEN &apos;% Basket Value&apos; THEN SUM([basket_value_paid_eur]) / 100&#13;&#10;WHEN &apos;% Main Dish Price&apos; THEN SUM([main_dish_price_eur]) / 100&#13;&#10;WHEN &apos;% Total Fees&apos; THEN SUM([total_fees_paid_eur]) / 100&#13;&#10;WHEN &apos;% Total Fees Net&apos; THEN SUM([total_fees_paid_net_eur]) / 100&#13;&#10;//WHEN &apos;% of Orders&apos; THEN WINDOW_SUM(COUNT([pricing_framework])) / 100&#13;&#10;END' />
            </column>
            <column aggregation='Sum' caption='Dimension (1)' datatype='real' name='[Calculation_1139973722196611111]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &apos;Basket Bucket&apos; THEN [Distance Buckets (Km) (copy)_1139973722194489382]&#13;&#10;WHEN &apos;Distance Bucket&apos; THEN [Calculation_1139973721946095621]&#13;&#10;WHEN &apos;Month&apos; THEN DATEDIFF(&apos;month&apos;,TODAY(), [order_placed_at])&#13;&#10;WHEN &apos;Week&apos; THEN DATEDIFF(&apos;week&apos;,TODAY(), [order_placed_at])&#13;&#10;WHEN &apos;Day&apos; THEN DATEDIFF(&apos;day&apos;,TODAY(), [order_placed_at])&#13;&#10;WHEN &apos;Weekday&apos; THEN [Calculation_3085810177798340641] // makes Monday the first day&#13;&#10;WHEN &apos;Time of Day&apos; THEN [Calculation_3085810177788899355]&#13;&#10;WHEN &apos;Hour&apos; THEN DATEPART(&apos;hour&apos;, [order_datetime_local])&#13;&#10;WHEN &apos;Day of Week&apos; THEN [Calculation_3085810177789280284]&#13;&#10;WHEN &apos;Unhealthy Score&apos; THEN ROUND([customer_unhealthy_score]/0.1)*0.1&#13;&#10;WHEN &apos;Delivery Fee Score&apos; THEN ROUND([customer_delivery_fee_score]/0.1)*0.1&#13;&#10;WHEN &apos;Reorder Probability within 28d&apos; THEN ROUND([customer_reorder_probability_all_verts_general_28_days]/10)*10&#13;&#10;END' />
            </column>
            <column caption='Month' datatype='date' datatype-customized='true' default-format='*mmm&apos;yy' name='[Calculation_1139973722200334376]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [order_placed_at]))' />
            </column>
            <column aggregation='Sum' caption='Time of Day' datatype='integer' name='[Calculation_3085810177788899355]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [occasion_time_of_day]&#13;&#10;    WHEN &apos;breakfast&apos; THEN 1&#13;&#10;    WHEN &apos;lunch&apos; THEN 2&#13;&#10;    WHEN &apos;afternoon&apos; THEN 3&#13;&#10;    WHEN &apos;dinner&apos; THEN 4&#13;&#10;    WHEN &apos;late_night&apos; THEN 5&#13;&#10;END' />
            </column>
            <column aggregation='Sum' caption='Day of Week' datatype='integer' name='[Calculation_3085810177789280284]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [occasion_day_of_week]&#13;&#10;WHEN &apos;weekday&apos; THEN 1&#13;&#10;WHEN &apos;weekend&apos; THEN 2&#13;&#10;END' />
            </column>
            <column aggregation='Sum' caption='Weekday (#)' datatype='integer' name='[Calculation_3085810177798340641]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEPART(&apos;weekday&apos;, [order_placed_at] - 1)' />
            </column>
            <column caption='Weekday' datatype='string' name='[Calculation_5564126972843753524]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;,[order_placed_at])' />
            </column>
            <column caption='Unit' datatype='integer' name='[Calculation_7704110864525000788]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Total Fees Paid Net (M) Parameter]&#10;WHEN &apos;Standard&apos; THEN 1&#10;WHEN &apos;Thousand (k)&apos; THEN 1000&#10;WHEN &apos;Million (M)&apos; THEN 1000000&#10;WHEN &apos;Billion (B)&apos; THEN 1000000000&#10;END' />
            </column>
            <column caption='DPS Priority Fee (opted-in)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[DPS Priority Fee (copy)_5755600392125005885]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM(dps_priority_fee_opted_in_eur)/[Aggregation (copy)_1846475850361638916],2)' />
