              <calculation class='tableau' formula='CASE [Parameters].[Total Fees Paid Net (M) Parameter]&#10;WHEN &apos;Standard&apos; THEN 1&#10;WHEN &apos;Thousand (k)&apos; THEN 1000&#10;WHEN &apos;Million (M)&apos; THEN 1000000&#10;WHEN &apos;Billion (B)&apos; THEN 1000000000&#10;END' />
            </column>
            <column caption='DPS Saver Discount Opted-In' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[DPS Service Fee (copy)_1829305887765737578]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([dps_saver_discount_opted_in_eur])/[Aggregation (copy)_1846475850361638916],2)' />
