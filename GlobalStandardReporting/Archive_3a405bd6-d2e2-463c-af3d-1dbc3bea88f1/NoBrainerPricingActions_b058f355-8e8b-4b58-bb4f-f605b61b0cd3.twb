            <column caption='Time Condition Applied No Brainer' datatype='real' name='[Calculation_1603070390321971215]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(&#10;SUM(IF (CONTAINS([travel_time_fee_condition_type], &quot;Time&quot;) OR CONTAINS([travel_time_fee_condition_type], &quot;Schedule&quot;))&#10;    AND &#10;[travel_time_fee_assignment_type] IN &#10;(&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;Subscription&apos;)&#10;    AND&#10;[is_dps] = TRUE&#10;    AND&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[channel] = &apos;Own Delivery&apos;&#10;THEN 1 ELSE 0&#10;END) &#10;&#10;/&#10;&#10;SUM(IF &#10;[travel_time_fee_assignment_type] IN &#10;(&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;Subscription&apos;)&#10;    AND&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[is_dps] = TRUE &#10;THEN 1 ELSE 0 END)&#10;)' />
            </column>
            <column caption='Time Condition Applied  Flag No Brainer' datatype='string' name='[Calculation_1603070390326657040]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1603070390321971215] &gt; 0.5 THEN &apos;TRUE&apos; &#10;ELSEIF  [Calculation_1603070390321971215] &lt;= 0.5 THEN &apos;FALSE&apos; &#10;ELSEIF ISNULL([Calculation_1603070390321971215]) = TRUE THEN &apos;NULL&apos;&#10;END' />
            </column>
            <column caption='MOV No Brainer' datatype='real' name='[Calculation_1603070390348779537]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM(IF [Has Paid DF (copy)_1829305887816900732] = TRUE&#10;        AND&#10;    [Paid Small Basket Fee (copy)_1829305887584337993] = TRUE&#10;        AND&#10;    [hard_mov] &gt;= 0&#10;        AND &#10;    IFNULL([sbf_cap], 0) &gt; 0&#10;        AND&#10;    [minimum_order_value_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;MOV Override&apos;, &apos;Subscription&apos;)&#10;&#10;AND [dps_minimum_order_value_eur] &gt; 0&#10;&#10;        AND&#10;[vertical_parent] = &apos;Food&apos;&#10;        AND&#10;    [channel] = &apos;Own Delivery&apos;&#10;     THEN 1 ELSE 0&#10;END)&#10;&#10;/&#10;&#10;SUM(if [is_dps] = TRUE &#10;    AND&#10;[minimum_order_value_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;MOV Override&apos;, &apos;Subscription&apos;)&#10;&#10;AND [dps_minimum_order_value_eur] &gt; 0&#10;&#10;    AND&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[channel] = &apos;Own Delivery&apos;&#10;THEN 1 ELSE 0 END)&#10;)' />
            </column>
            <column caption='MOV Flag No Brainer' datatype='string' name='[Calculation_1603070390351749138]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1603070390348779537] &gt;= 0.9 AND COUNT([Calculation_1987494825938444290]) &gt; 0 THEN &apos;TRUE&apos;&#10;ELSEIF [Calculation_1603070390348779537] &lt; 0.9 AND COUNT([Calculation_1987494825938444290]) &gt; 0 THEN &apos;FALSE&apos;&#10;ELSEIF COUNT([Calculation_1987494825938444290]) &gt; 0 THEN &apos;NULL&apos;&#10;END' />
            </column>
            <column caption='Service Fee No Brainer' datatype='real' name='[Calculation_1603070390374772759]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='ZN(&#10;SUM(IF &#10;service_fee_type = &apos;Percentage&apos;&#10;&#10;    AND&#10;[max_service_fee] &lt;&gt; [min_service_fee]&#10;    AND&#10;/*&#10;[service_fee_condition_type] &lt;&gt; &apos;New Customer&apos;&#10;*/&#10;[service_fee_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;Service Fee Override&apos;, &apos;Subscription&apos;)&#10;    AND&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[channel] = &apos;Pick-up&apos;&#10;THEN 1 ELSE 0&#10;END)&#10;&#10;/&#10;&#10;SUM(IF [is_dps] = TRUE &#10;    AND&#10;/*&#10;[service_fee_condition_type] &lt;&gt; &apos;New Customer&apos;&#10;*/&#10;[service_fee_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;Service Fee Override&apos;, &apos;Subscription&apos;)&#10;&#10;    AND&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[channel] = &apos;Pick-up&apos;&#10;THEN 1 ELSE 0 END)&#10;)' />
            </column>
            <column caption='Service Fee Flag No Brainer' datatype='string' name='[Calculation_1603070390378274840]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1603070390374772759] &gt;= 0.9 AND COUNT([service_fee_component_id]) &gt; 0 THEN &apos;TRUE&apos;&#10;ELSEIF [Calculation_1603070390374772759] &lt; 0.9 AND COUNT([service_fee_component_id]) &gt; 0 THEN &apos;FALSE&apos;&#10;ELSEIF COUNT([service_fee_component_id]) = 0 THEN &apos;NULL&apos;&#10;END' />
            </column>
            <column caption='QC BBDF No Brainer' datatype='real' name='[Calculation_1603070390695165988]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(&#10;SUM(IF [is_df_discount_basket_value_deal] = TRUE &#10;    AND&#10;[basket_value_discount_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Manual&apos;, &apos;Subscription&apos;)&#10;    AND&#10;[is_dps] = TRUE &#10;    AND&#10;([vertical_parent] = &apos;Dmarts&apos;&#10;    OR&#10;[vertical_type] =&apos;supermarket&apos;&#10;    OR &#10;[vertical_type] = &apos;hypermarket&apos;)&#10;    AND&#10;[channel] IN(&apos;Own Delivery&apos;)&#10;THEN 1 ELSE 0 END)&#10;&#10;/&#10;&#10;SUM(IF [is_dps] = TRUE &#10;&#10;&#10;//    AND&#10;//[basket_value_discount_assignment_type] IN (&apos;Automatic scheme&apos;,  &apos;Manual&apos;, &apos;Subscription&apos;)&#10;&#10;    AND &#10;([vertical_parent] = &apos;Dmarts&apos;&#10;    OR&#10;[vertical_type] =&apos;supermarket&apos;&#10;    OR &#10;[vertical_type] = &apos;hypermarket&apos;)&#10;    AND&#10;[channel] IN(&apos;Own Delivery&apos;)&#10;THEN 1 ELSE 0 END)&#10;)' />
            </column>
            <column caption='QC BBDF Flag No Brainer' datatype='string' name='[Calculation_1603070390699339814]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1603070390695165988] &gt;= 0.9 AND COUNT([basket_value_discount_component_id]) &gt; 0 THEN &apos;TRUE&apos;&#10;ELSEIF  [Calculation_1603070390695165988] &lt; 0.9 AND COUNT([basket_value_discount_component_id]) &gt; 0 THEN &apos;FALSE&apos;&#10;ELSEIF COUNT([basket_value_discount_component_id]) = 0 THEN &apos;NULL&apos;&#10;END' />
            </column>
            <column caption='Has Paid Prio Fee' datatype='boolean' name='[Calculation_1829305887812501618]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='ABS(IFNULL([priority_fee_eur],0))&#10;+ ABS(IFNULL([priority_fee_net],0))&#10;+ ABS(IFNULL([dps_priority_fee_opted_in_local],0))&#10;&gt; 0' />
