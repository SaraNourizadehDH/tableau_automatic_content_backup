      <column caption='Delivery Fee Net (per order) YoY%' datatype='real' default-format='p0.0%' name='[Delivery Fee Net YoY% (copy)_1132936785176014875]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN([Delivery Fee Net (M) (copy)_1132936785175916569]) - LOOKUP(ZN([Delivery Fee Net (M) (copy)_1132936785175916569]), -12)) / ABS(LOOKUP(ZN([Delivery Fee Net (M) (copy)_1132936785175916569]), -12))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Sub-Detail Ungrouped' datatype='string' name='[Detail (copy)_8643885495196205074]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Detail (copy)_8643885495196147729]&#13;&#10;WHEN &apos;Brand Name&apos; THEN [Brand Name (group)]&#13;&#10;WHEN &apos;Chain Name&apos; THEN [chain_name]&#13;&#10;WHEN &apos;Channel&apos; THEN [channel]&#13;&#10;WHEN &apos;City Name&apos; THEN [city_name] + &quot; (&quot; + [country_code] + &quot;)&quot;&#13;&#10;WHEN &apos;City Tier&apos; THEN [city_tier]&#13;&#10;WHEN &apos;Country Code&apos; THEN [country_code]&#13;&#10;WHEN &apos;Global Entity Id&apos; THEN [global_entity_id]&#13;&#10;WHEN &apos;Has DPS Incentive&apos; THEN&#13;&#10;&#9;CASE [has_dps_incentive]&#13;&#10;    WHEN TRUE THEN &apos;Has DPS Incentive&apos;&#13;&#10;    WHEN FALSE THEN &apos;&apos;&#13;&#10;&#9;ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Holdout&apos; THEN&#13;&#10;    CASE [is_customer_holdout]&#13;&#10;    WHEN TRUE THEN &apos;Holdout&apos;&#13;&#10;    WHEN FALSE THEN &apos;Usual&apos;&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Is DPS&apos; THEN &#13;&#10;CASE [is_dps]&#13;&#10;    WHEN TRUE THEN &apos;Has DPS data&apos;&#13;&#10;    WHEN FALSE THEN &apos;No DPS data&apos;&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Is Subscriber&apos; THEN&#13;&#10;&#9;CASE [is_subscriber]&#13;&#10;    WHEN TRUE THEN &apos;Subscriber&apos;&#13;&#10;    WHEN FALSE THEN &apos;Non-Subscriber&apos;&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Is Preorder&apos; THEN&#13;&#10;&#9;CASE [is_preorder]&#13;&#10;    WHEN TRUE THEN &apos;Preorder&apos;&#13;&#10;    WHEN FALSE THEN &apos;On-demand&apos;&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Key Account Category&apos; THEN [key_account_category]&#13;&#10;WHEN &apos;Market Archetype&apos; THEN [market_archetype]&#13;&#10;WHEN &apos;Meal for One&apos; THEN&#13;&#10;    CASE [is_meal_for_one]&#13;&#10;    WHEN TRUE THEN &apos;Is Meal for One&apos;&#13;&#10;    WHEN FALSE THEN &apos;&apos;&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Occasion - Day of Week&apos; THEN [occasion_day_of_week]&#13;&#10;WHEN &apos;Occasion - Time of Day&apos; THEN [occasion_time_of_day]&#13;&#10;WHEN &apos;Online Payment&apos; THEN&#13;&#10;    CASE [is_paid_online]&#13;&#10;    WHEN TRUE THEN &apos;Online&apos;&#13;&#10;    WHEN FALSE THEN &apos;Offline&apos;&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Segment&apos; THEN [segment]&#13;&#10;WHEN &apos;Sub-Segment&apos; THEN [Global Entity Id (group)]&#13;&#10;WHEN &apos;Sub Entity&apos; THEN [sub_entity]&#13;&#10;WHEN &apos;Vendor Class&apos; THEN [vendor_class]&#13;&#10;WHEN &apos;Vendor Name&apos; THEN [vendor_name]&#13;&#10;WHEN &apos;Vertical Parent&apos; THEN [vertical_parent]&#13;&#10;WHEN &apos;Vertical Type&apos; THEN [vertical_type]&#13;&#10;&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
      </column>
      <column caption='Dimension (2) (detail)' datatype='string' name='[Dimension (2) (copy)_3085810179207762005]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Dimension (copy)_3085810177783541781]&#13;&#10;WHEN &apos;Weekday&apos; THEN [Calculation_5564126972843753524] // makes Monday the first day&#13;&#10;WHEN &apos;Time of Day&apos; THEN [occasion_time_of_day]&#13;&#10;WHEN &apos;Day of Week&apos; THEN [occasion_day_of_week]&#13;&#10;&#13;&#10;WHEN &apos;Month&apos; THEN LEFT(DATENAME(&apos;month&apos;, [order_placed_at]),3) + &apos;/&apos; + RIGHT(DATENAME(&apos;year&apos;, [order_placed_at]),2)&#13;&#10;WHEN &apos;Week&apos; THEN &apos;CW&apos; + DATENAME(&apos;week&apos;, [order_placed_at]) + &quot; &quot; + RIGHT(DATENAME(&apos;year&apos;, [order_placed_at]),2)&#13;&#10;WHEN &apos;Day&apos; THEN DATENAME(&apos;day&apos;, [order_placed_at]) + &apos;/&apos; + LEFT(DATENAME(&apos;month&apos;, [order_placed_at]),3) + &apos;/&apos; + RIGHT(DATENAME(&apos;year&apos;, [order_placed_at]),2)&#13;&#10;&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
      </column>
      <column aggregation='Sum' caption='Level' datatype='real' name='[Dimension (3) (copy)_3085810179190714447]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Dimension (3) (copy)_3085810179190685774]&#13;&#10;WHEN &apos;Total&apos; THEN 1&#13;&#10;WHEN &apos;Basket Bucket&apos; THEN [Distance Buckets (Km) (copy)_1139973722194489382]&#13;&#10;WHEN &apos;Distance Bucket&apos; THEN [Calculation_1139973721946095621]&#13;&#10;WHEN &apos;Weekday&apos; THEN [Calculation_3085810177798340641] // makes Monday the first day&#13;&#10;WHEN &apos;Time of Day&apos; THEN [Calculation_3085810177788899355]&#13;&#10;WHEN &apos;Day of Week&apos; THEN [Calculation_3085810177789280284]&#13;&#10;END' />
      </column>
      <column caption='Dimension (3) (detail)' datatype='string' name='[Dimension (3) (copy)_3085810179207397460]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Dimension (copy) (copy)_3085810177783549974]&#13;&#10;WHEN &apos;Weekday&apos; THEN [Calculation_5564126972843753524] // makes Monday the first day&#13;&#10;WHEN &apos;Time of Day&apos; THEN [occasion_time_of_day]&#13;&#10;WHEN &apos;Day of Week&apos; THEN [occasion_day_of_week]&#13;&#10;&#13;&#10;WHEN &apos;Month&apos; THEN DATENAME(&apos;month&apos;, [order_placed_at]) + &apos;/&apos; + DATENAME(&apos;year&apos;, [order_placed_at])&#13;&#10;WHEN &apos;Week&apos; THEN &apos;CW&apos; + DATENAME(&apos;week&apos;, [order_placed_at]) + &quot; &quot; + DATENAME(&apos;year&apos;, [order_placed_at])&#13;&#10;WHEN &apos;Day&apos; THEN DATENAME(&apos;day&apos;, [order_placed_at]) + &apos;/&apos; + DATENAME(&apos;month&apos;, [order_placed_at]) + DATENAME(&apos;year&apos;, [order_placed_at])&#13;&#10;&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
      </column>
      <column aggregation='Sum' caption='Dimension (3)' datatype='real' name='[Dimension (copy) (copy)_3085810177783488532]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Dimension (copy) (copy)_3085810177783549974]&#13;&#10;WHEN &apos;Basket Bucket&apos; THEN [Distance Buckets (Km) (copy)_1139973722194489382]&#13;&#10;WHEN &apos;Distance Bucket&apos; THEN [Calculation_1139973721946095621]&#13;&#10;WHEN &apos;Month&apos; THEN DATEDIFF(&apos;month&apos;,TODAY(), [order_placed_at])&#13;&#10;WHEN &apos;Week&apos; THEN DATEDIFF(&apos;week&apos;,TODAY(), [order_placed_at])&#13;&#10;WHEN &apos;Day&apos; THEN DATEDIFF(&apos;day&apos;,TODAY(), [order_placed_at])&#13;&#10;WHEN &apos;Weekday&apos; THEN [Calculation_3085810177798340641] // makes Monday the first day&#13;&#10;WHEN &apos;Hour&apos; THEN DATEPART(&apos;hour&apos;, [order_datetime_local])&#13;&#10;WHEN &apos;Time of Day&apos; THEN [Calculation_3085810177788899355]&#13;&#10;WHEN &apos;Day of Week&apos; THEN [Calculation_3085810177789280284]&#13;&#10;WHEN &apos;Unhealthy Score&apos; THEN ROUND([customer_unhealthy_score]/0.1)*0.1&#13;&#10;WHEN &apos;Delivery Fee Score&apos; THEN ROUND([customer_delivery_fee_score]/0.1)*0.1&#13;&#10;WHEN &apos;Reorder Probability within 28d&apos; THEN ROUND([customer_reorder_probability_all_verts_general_28_days]/10)*10&#13;&#10;END' />
      </column>
      <column aggregation='Sum' caption='Dimension (2)' datatype='real' name='[Dimension (copy)_3085810177783472147]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Dimension (copy)_3085810177783541781]&#13;&#10;WHEN &apos;Basket Bucket&apos; THEN [Distance Buckets (Km) (copy)_1139973722194489382]&#13;&#10;WHEN &apos;Distance Bucket&apos; THEN [Calculation_1139973721946095621]&#13;&#10;WHEN &apos;Month&apos; THEN DATEDIFF(&apos;month&apos;,TODAY(), [order_placed_at])&#13;&#10;WHEN &apos;Week&apos; THEN DATEDIFF(&apos;week&apos;,TODAY(), [order_placed_at])&#13;&#10;WHEN &apos;Day&apos; THEN DATEDIFF(&apos;day&apos;,TODAY(), [order_placed_at])&#13;&#10;WHEN &apos;Weekday&apos; THEN [Calculation_3085810177798340641] // makes Monday the first day&#13;&#10;WHEN &apos;Hour&apos; THEN DATEPART(&apos;hour&apos;, [order_datetime_local])&#13;&#10;WHEN &apos;Time of Day&apos; THEN [Calculation_3085810177788899355]&#13;&#10;WHEN &apos;Day of Week&apos; THEN [Calculation_3085810177789280284]&#13;&#10;WHEN &apos;Unhealthy Score&apos; THEN ROUND([customer_unhealthy_score]/0.1)*0.1&#13;&#10;WHEN &apos;Delivery Fee Score&apos; THEN ROUND([customer_delivery_fee_score]/0.1)*0.1&#13;&#10;WHEN &apos;Reorder Probability within 28d&apos; THEN ROUND([customer_reorder_probability_all_verts_general_28_days]/10)*10&#13;&#10;END' />
      </column>
