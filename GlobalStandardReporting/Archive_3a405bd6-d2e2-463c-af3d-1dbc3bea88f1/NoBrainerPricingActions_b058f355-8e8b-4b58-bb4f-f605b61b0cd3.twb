            <column caption='Saver Well Configured No Brainer' datatype='real' name='[Priority No Brainer (copy)_1603070390129582092]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='ZN(&#10;SUM(IF ISNULL([saver_fee_component_id]) = FALSE&#10;    AND&#10;[saver_fee_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;SaverFee&apos;)&#10;    AND&#10;(IFNULL([max_saver_fee], 0) - IFNULL([min_saver_fee], 0)) &lt;&gt; 0 &#10;    AND&#10;[is_dps] = TRUE&#10;    AND&#10;[dps_saver_discount_opted_in_eur] &lt;&gt; 0&#10;    AND&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[channel] = &apos;Own Delivery&apos;&#10;THEN 1 ELSE 0 END)&#10;&#10;    /&#10;&#10;SUM(IF ISNULL([saver_fee_component_id]) = FALSE&#10;    AND&#10;[saver_fee_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;SaverFee&apos;)&#10;    AND&#10;[is_dps] = TRUE&#10;    AND&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[channel] = &apos;Own Delivery&apos;&#10;THEN 1 ELSE 0 END)&#10;)' />
            </column>
            <column caption='Saver No Brainer Flag No Brainer' datatype='string' name='[Priority No Brainer Flag (copy)_1603070390130130957]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Priority No Brainer (copy)_1603070390129582092] &gt;= 0.9 AND COUNT([saver_fee_component_id]) &gt; 0 THEN &apos;TRUE&apos;&#10;ELSEIF [Priority No Brainer (copy)_1603070390129582092] &lt; 0.9 AND COUNT([saver_fee_component_id]) &gt; 0 THEN &apos;FALSE&apos;&#10;ELSEIF COUNT([saver_fee_component_id]) = 0 THEN &apos;NULL&apos;&#10;END' />
            </column>
