      </column>
      <column caption='QC BBDF Proportion No Brainer' datatype='real' name='[QC BBDF No Brainer (copy)_1603070391387648051]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(&#10;SUM(IF [is_df_discount_basket_value_deal] = TRUE &#10;    AND&#10;[basket_value_discount_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Manual&apos;, &apos;Subscription&apos;)&#10;    AND&#10;[is_dps] = TRUE &#10;&#10;    AND &#10;([vertical_parent] = &apos;Dmarts&apos;&#10;    OR&#10;[vertical_type] IN(&apos;supermarket&apos;, &apos;hypermarket&apos;))&#10;    AND&#10;[channel] IN(&apos;Own Delivery&apos;)&#10;THEN 1 ELSE 0 END)&#10;&#10;/&#10;&#10;SUM(IF [is_dps] = TRUE &#10;&#10;    AND &#10;([vertical_parent] = &apos;Dmarts&apos;&#10;    OR&#10;[vertical_type] IN(&apos;supermarket&apos;, &apos;hypermarket&apos;))&#10;    AND&#10;[channel] IN(&apos;Own Delivery&apos;)&#10;THEN 1 ELSE 0 END)&#10;)' />
      </column>
      <column caption='QC MOV Proportion No Brainer' datatype='real' name='[QC MOV No Brainer (copy)_1603070391385436210]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(&#10;SUM(IF [Has Paid DF (copy)_1829305887816900732] = TRUE&#10;&#10;        AND [minimum_order_value_eur] &gt; 0.0&#10;        AND&#10;    [minimum_order_value_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;Country fallback&apos;, &apos;Manual&apos;, &apos;MOV Override&apos;, &apos;Subscription&apos;)&#10;    &#10;    AND &#10;[vertical_parent] IN(&apos;Dmarts&apos;, &apos;Local Shops&apos;)&#10;    AND&#10;[channel] IN(&apos;Own Delivery&apos;)&#10; THEN 1 ELSE 0&#10;END)&#10;&#10;/&#10;&#10;SUM(if [is_dps] = TRUE &#10;&#10;    AND &#10;[vertical_parent] IN(&apos;Dmarts&apos;, &apos;Local Shops&apos;)&#10;    AND&#10;[channel] IN(&apos;Own Delivery&apos;)&#10;THEN 1 ELSE 0 END)&#10;)' />
      </column>
      <column caption='Reference (2)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Reference (copy)_3085810179161337931]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Reference (copy)_3085810179161309258]&#13;&#10;WHEN &apos;Orders&apos; THEN SUM(IF [is_successful] THEN 1 ELSE 0 END)&#13;&#10;WHEN &apos;Orders (M)&apos; THEN SUM(IF [is_successful] THEN 1 ELSE 0 END) / 1000000&#13;&#10;WHEN &apos;Customer Accounts&apos; THEN COUNTD([global_entity_id] + &apos;-&apos; + [customer_account_id])&#13;&#10;WHEN &apos;Customer Accounts (M)&apos; THEN COUNTD([global_entity_id] + &apos;-&apos; + [customer_account_id]) / 1000000&#13;&#10;WHEN &apos;Analytical Customers&apos; THEN COUNTD([global_entity_id] + &apos;-&apos; + [analytical_customer_id])&#13;&#10;WHEN &apos;Analytical Customers (M)&apos; THEN COUNTD([global_entity_id] + &apos;-&apos; + [analytical_customer_id]) / 1000000&#13;&#10;WHEN &apos;Vendors&apos; THEN COUNTD([global_entity_id] + &apos;-&apos; + [vendor_id])&#13;&#10;WHEN &apos;Vendors (M)&apos; THEN COUNTD([global_entity_id] + &apos;-&apos; + [vendor_id]) / 1000000&#13;&#10;WHEN &apos;GMV&apos; THEN SUM([gmv_eur])&#13;&#10;WHEN &apos;GMV (M)&apos; THEN SUM([gmv_eur]) / 1000000&#13;&#10;WHEN &apos;Basket Value&apos; THEN SUM([basket_value_paid_eur])&#13;&#10;WHEN &apos;Basket Value (M)&apos; THEN SUM([basket_value_paid_eur]) / 1000000&#13;&#10;WHEN &apos;Total Fees Paid&apos; THEN SUM([total_fees_paid_eur])&#13;&#10;WHEN &apos;Total Fees Paid (M)&apos; THEN SUM([total_fees_paid_eur]) / 1000000&#13;&#10;WHEN &apos;Total Fees Net&apos; THEN SUM([total_fees_paid_net_eur])&#13;&#10;WHEN &apos;Total Fees Net (M)&apos; THEN SUM([total_fees_paid_net_eur]) / 1000000&#13;&#10;END' />
      </column>
      <column caption='Retention Month over 0' datatype='boolean' name='[Retention Month between 0 and 16 (copy)_1829305887474933785]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_3085810178731069492] &gt;= 0' />
      </column>
      <column caption='Other Revenue Net' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Revenue Net (copy)_2767461991332261905]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Commission Fee Net (copy)_2767461991321042956]-[Basket Value Paid (copy)_5755600392040583211]-[Calculation_1139973721947041801]' />
      </column>
      <column caption='Detail' datatype='string' name='[SD (copy)_139330180157165589]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Detail Set] THEN [Calculation_1139973721954193430] ELSE &apos;[Others]&apos; END' />
      </column>
      <column caption='QC Saver No Brainer Flag No Brainer' datatype='string' name='[Saver No Brainer Flag No Brainer (copy)_1603070392437260354]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Saver Well Configured No Brainer (copy)_1603070392436908096] &gt;= 0.9 AND COUNT([saver_fee_component_id]) &gt; 0 THEN &apos;TRUE&apos;&#10;ELSEIF [Saver Well Configured No Brainer (copy)_1603070392436908096] &lt; 0.9 AND COUNT([saver_fee_component_id]) &gt; 0 THEN &apos;FALSE&apos;&#10;ELSEIF COUNT([saver_fee_component_id]) = 0 THEN &apos;NULL&apos;&#10;END' />
      </column>
      <column caption='QC Saver Order Proportion No Brainer' datatype='real' name='[Saver Order Proportion No Brainer (copy)_1603070392436777023]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='ZN(&#10;SUM(IF ISNULL([saver_fee_component_id]) = FALSE&#10;    AND&#10;[saver_fee_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;SaverFee&apos;)&#10;    AND&#10;[is_dps] = TRUE&#10;    AND&#10;[dps_saver_discount_opted_in_eur] &lt;&gt; 0&#10;&#10;    AND&#10;[vertical_parent] IN(&apos;Dmarts&apos;, &apos;Local Shops&apos;)&#10;    AND&#10;[channel] = &apos;Own Delivery&apos;&#10;THEN 1 ELSE 0 END)&#10;&#10;&#10;  /&#10;&#10;SUM(IF &#10;/*&#10;[saver_fee_assignment_type] IN (&apos;SaverFee&apos;)&#10;    AND&#10;*/&#10;[is_dps] = TRUE&#10;&#10;    AND&#10;[vertical_parent] IN(&apos;Dmarts&apos;, &apos;Local Shops&apos;)&#10;    AND&#10;[channel] = &apos;Own Delivery&apos;&#10;THEN 1 ELSE 0 END)&#10;)' />
      </column>
      <column caption='Saver Order Proportion No Brainer' datatype='real' name='[Saver Well Configured No Brainer (copy)_1603070391107498030]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='ZN(&#10;SUM(IF ISNULL([saver_fee_component_id]) = FALSE&#10;    AND&#10;[saver_fee_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;SaverFee&apos;)&#10;    AND&#10;[is_dps] = TRUE&#10;    AND&#10;[dps_saver_discount_opted_in_eur] &lt;&gt; 0&#10;&#10;    AND&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[channel] = &apos;Own Delivery&apos;&#10;THEN 1 ELSE 0 END)&#10;&#10;&#10;  /&#10;&#10;SUM(IF &#10;/*&#10;[saver_fee_assignment_type] IN (&apos;SaverFee&apos;)&#10;    AND&#10;*/&#10;[is_dps] = TRUE&#10;&#10;    AND&#10;[vertical_parent] = &apos;Food&apos;&#10;    AND&#10;[channel] = &apos;Own Delivery&apos;&#10;THEN 1 ELSE 0 END)&#10;)' />
      </column>
      <column caption='QC Saver Well Configured No Brainer' datatype='real' name='[Saver Well Configured No Brainer (copy)_1603070392436908096]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='ZN(&#10;SUM(IF ISNULL([saver_fee_component_id]) = FALSE&#10;    AND&#10;[saver_fee_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;SaverFee&apos;)&#10;    AND&#10;(IFNULL([max_saver_fee], 0) - IFNULL([min_saver_fee], 0)) &lt;&gt; 0 &#10;    AND&#10;[is_dps] = TRUE&#10;    AND&#10;[dps_saver_discount_opted_in_eur] &lt;&gt; 0&#10;    AND&#10;[vertical_parent] IN(&apos;Dmarts&apos;, &apos;Local Shops&apos;)&#10;    AND&#10;[channel] = &apos;Own Delivery&apos;&#10;THEN 1 ELSE 0 END)&#10;&#10;    /&#10;&#10;SUM(IF ISNULL([saver_fee_component_id]) = FALSE&#10;    AND&#10;[saver_fee_assignment_type] IN (&apos;Automatic scheme&apos;, &apos;SaverFee&apos;)&#10;    AND&#10;[is_dps] = TRUE&#10;    AND&#10;[vertical_parent] IN(&apos;Dmarts&apos;, &apos;Local Shops&apos;)&#10;    AND&#10;[channel] = &apos;Own Delivery&apos;&#10;THEN 1 ELSE 0 END)&#10;)' />
      </column>
      <column caption='Surge Fee Enabled' datatype='integer' name='[Service Fee Enabled (copy)_3085810177978617898]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF &#13;&#10;    NOT ISNULL([surge_fee_component_id]) &#13;&#10;THEN 1 ELSE 0 END)' />
      </column>
      <column caption='QC Service Fee Flag No Brainer' datatype='string' name='[Service Fee Flag No Brainer (copy)_1603070392426090553]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Service Fee No Brainer (copy)_1603070392425328696] &gt;= 0.9 AND COUNT([service_fee_component_id]) &gt; 0 THEN &apos;TRUE&apos; &#10;ELSEIF [Service Fee No Brainer (copy)_1603070392425328696] &lt; 0.9 AND COUNT([service_fee_component_id]) &gt; 0 THEN &apos;FALSE&apos;&#10;ELSEIF COUNT([service_fee_component_id]) = 0 THEN &apos;NULL&apos;&#10;END' />
      </column>
