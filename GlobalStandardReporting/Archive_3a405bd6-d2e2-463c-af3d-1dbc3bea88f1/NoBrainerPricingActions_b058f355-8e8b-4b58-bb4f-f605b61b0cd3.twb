          <datasource-dependencies datasource='federated.16xq89b15ombu418amgk303gpxk5'>
            <column caption='DPS Aggregation' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Aggregation (copy)_1846475850361638916]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Total&apos; THEN 1&#13;&#10;WHEN &apos;Total (M)&apos; THEN 1000000&#13;&#10;WHEN &apos;Total (k)&apos; THEN 1000&#13;&#10;WHEN &apos;Per Order&apos; THEN SUM(IF [is_dps] THEN 1 END)&#13;&#10;WHEN &apos;Per Customer Account&apos; THEN COUNTD(IF [is_dps] THEN [customer_account_id] END)&#13;&#10;WHEN &apos;Per Analyt. Customer&apos; THEN COUNTD(IF [is_dps] THEN [analytical_customer_id] END)&#13;&#10;WHEN &apos;Per Day&apos; THEN COUNTD(IF [is_dps] THEN [order_placed_at] END)&#13;&#10;/**&#13;&#10;WHEN &apos;Per Day&apos; THEN &#13;&#10;&#9;MAX(IF DATETRUNC(&apos;month&apos;,[Order Placed At]) &lt; DATETRUNC(&apos;month&apos;, TODAY())&#13;&#10;    &#9;THEN DATEPART(&apos;day&apos;,(DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,1,[Order Placed At])) - 1))&#13;&#10;&#9;&#9;ELSE DATEPART(&apos;day&apos;,[Order Placed At])&#13;&#10;&#9;END)&#13;&#10;**/&#13;&#10;WHEN &apos;% GMV&apos; THEN SUM(IF [is_dps] THEN [gmv_eur] END) / 100&#13;&#10;WHEN &apos;% Basket Value&apos; THEN SUM(IF [is_dps] THEN [basket_value_paid_eur] END) / 100&#13;&#10;WHEN &apos;% Main Dish Price&apos; THEN SUM([main_dish_price_eur]) / 100&#13;&#10;WHEN &apos;% Total Fees&apos; THEN SUM(IF [is_dps] THEN [total_fees_paid_eur] END) / 100&#13;&#10;WHEN &apos;% Total Fees Net&apos; THEN SUM(IF [is_dps] THEN [total_fees_paid_net_eur] END) / 100&#13;&#10;//WHEN &apos;% of Orders&apos; THEN WINDOW_SUM(COUNT([pricing_framework])) / 100&#13;&#10;END' />
            </column>
            <column caption='Aggregation (ops)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Aggregation (copy)_3085810177976483880]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Aggregation (copy)_3085810177976442919]&#13;&#10;WHEN &apos;Total&apos; THEN 1&#13;&#10;WHEN &apos;Total (M)&apos; THEN 1000000&#13;&#10;WHEN &apos;Total (k)&apos; THEN 1000&#13;&#10;WHEN &apos;Per Cent&apos; THEN COUNT([__tableau_internal_object_id__].[pricing_framework_31443A764E8F4C8ABB81B0659FA41FC5]) / 100&#13;&#10;WHEN &apos;Per Order&apos; THEN COUNT([__tableau_internal_object_id__].[pricing_framework_31443A764E8F4C8ABB81B0659FA41FC5])&#13;&#10;WHEN &apos;Per Customer Account&apos; THEN COUNTD([customer_account_id])&#13;&#10;WHEN &apos;Per Analyt. Customer&apos; THEN COUNTD([analytical_customer_id])&#13;&#10;WHEN &apos;Per Day&apos; THEN COUNTD([order_placed_at])&#13;&#10;/**&#13;&#10;WHEN &apos;Per Day&apos; THEN &#13;&#10;&#9;MAX(IF DATETRUNC(&apos;month&apos;,[Order Placed At]) &lt; DATETRUNC(&apos;month&apos;, TODAY())&#13;&#10;    &#9;THEN DATEPART(&apos;day&apos;,(DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,1,[Order Placed At])) - 1))&#13;&#10;&#9;&#9;ELSE DATEPART(&apos;day&apos;,[Order Placed At])&#13;&#10;&#9;END)&#13;&#10;**/&#13;&#10;WHEN &apos;% GMV&apos; THEN SUM([gmv_eur]) / 100&#13;&#10;WHEN &apos;% Basket Value&apos; THEN SUM([basket_value_paid_eur]) / 100&#13;&#10;WHEN &apos;Per Basket/Minute&apos; THEN SUM([basket_value_paid_eur] * [promised_eta_m]) / 100&#13;&#10;WHEN &apos;Per Minute&apos; THEN SUM([promised_eta_m])&#13;&#10;WHEN &apos;% Basket Value&apos; THEN SUM([basket_value_paid_eur]) / 100&#13;&#10;WHEN &apos;% Main Dish Price&apos; THEN SUM([main_dish_price_eur]) / 100&#13;&#10;WHEN &apos;% Total Fees&apos; THEN SUM([total_fees_paid_eur]) / 100&#13;&#10;WHEN &apos;% Total Fees Net&apos; THEN SUM([total_fees_paid_net_eur]) / 100&#13;&#10;//WHEN &apos;% of Orders&apos; THEN WINDOW_SUM(COUNT([pricing_framework])) / 100&#13;&#10;END' />
            </column>
            <column caption='Bad Weather Fee Paid' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Bad Weather Fee Net (copy)_5755600392040185896]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([bad_weather_fee_eur])/[Calculation_1139973721956712471],2)' />
            </column>
            <column caption='Basket Value Nominal' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Bad Weather Fee Net (copy)_5755600392040370217]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([basket_value_nominal_eur])/[Calculation_1139973721956712471],2)' />
            </column>
            <column caption='Basket Value Paid' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Basket Value Nominal (copy)_5755600392040484906]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([basket_value_paid_eur])/[Calculation_1139973721956712471],2)' />
