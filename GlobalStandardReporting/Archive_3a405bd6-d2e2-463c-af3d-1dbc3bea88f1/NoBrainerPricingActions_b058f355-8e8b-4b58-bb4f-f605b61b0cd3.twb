            <column aggregation='Sum' caption='Travel Time Fee Component Id' datatype='real' name='[Calculation_1987494825937719297]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [travel_time_fee_component_id Set] THEN [travel_time_fee_component_id]&#13;&#10;ELSE 0&#13;&#10;END' />
