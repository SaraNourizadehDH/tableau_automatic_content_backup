              <calculation class='tableau' formula='RAWSQLAGG_REAL(&quot;APPROX_QUANTILES(%1,1000)[OFFSET(250)]&quot;, [delivery_fee_eur]) * COUNT([__tableau_internal_object_id__].[pricing_framework_31443A764E8F4C8ABB81B0659FA41FC5]) / [Calculation_1139973721956712471]' />
