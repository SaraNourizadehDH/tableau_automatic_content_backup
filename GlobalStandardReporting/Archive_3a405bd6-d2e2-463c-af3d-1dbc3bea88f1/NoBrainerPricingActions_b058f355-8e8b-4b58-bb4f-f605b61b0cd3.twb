            <column caption='Analytical Profit Eur' datatype='real' default-format='n#,##0.00;-#,##0.00' hidden='true' name='[analytical_profit]' role='measure' type='quantitative' />
            <column caption='Basket Value Paid Eur' datatype='real' default-format='n#,##0.00;-#,##0.00' hidden='true' name='[basket_value_paid_eur]' role='measure' type='quantitative' />
            <column caption='Brand Name' datatype='string' name='[brand_name]' role='dimension' type='nominal' />
