            <column caption='Metric 1' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Metric 2 (copy)_1846475850327351298]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#13;&#10;//WHEN &apos;Aggregation&apos; THEN [Aggregation]&#13;&#10;WHEN &apos;Analytical Profit&apos; THEN [Calculation_1139973721947475979]&#13;&#10;WHEN &apos;Bad Weather Fee Net&apos; THEN [Delivery Fee Net (copy)_1139973722153857056]&#13;&#10;WHEN &apos;Bad Weather Fee Paid&apos; THEN [Bad Weather Fee Net (copy)_5755600392040185896]&#13;&#10;//WHEN &apos;Basket Buckets&apos; THEN [Basket Buckets]&#13;&#10;WHEN &apos;Basket Value Nominal&apos; THEN [Bad Weather Fee Net (copy)_5755600392040370217]&#13;&#10;WHEN &apos;Basket Value Paid&apos; THEN [Basket Value Nominal (copy)_5755600392040484906]&#13;&#10;WHEN &apos;Commission Fee Net&apos; THEN [Basket Value Paid (copy)_5755600392040583211]&#13;&#10;WHEN &apos;Count of Orders&apos; THEN SUM(1)&#13;&#10;WHEN &apos;Customer Fees DH Funded&apos; THEN [Calculation_1139973722179665956]&#13;&#10;WHEN &apos;Customer Fees Nominal&apos; THEN [Calculation_1139973722183237669]&#13;&#10;WHEN &apos;Customer Fees Other Funded&apos; THEN [Calculation_1139973722179629090]&#13;&#10;WHEN &apos;Customer Fees Paid&apos; THEN [Calculation_1139973721947025416]&#13;&#10;WHEN &apos;Customer Fees Third Party Funded&apos; THEN [Calculation_1139973722179649571]&#13;&#10;WHEN &apos;Customer Service Fee&apos; THEN [Service Fee Net (copy)_5755600392050638902]&#13;&#10;WHEN &apos;Customer Service Fee Net&apos; THEN [Customer Fees Paid (copy)_1139973722151665692]&#13;&#10;WHEN &apos;DPS Bad Weather Fee&apos; THEN [DPS Delivery Fee (copy)_6532541696563433535]&#13;&#10;WHEN &apos;DPS Delivery Fee&apos; THEN [DPS Delivery Fee (inc. Std) (copy)_5648006582348574733]&#13;&#10;WHEN &apos;DPS Delivery Fee (inc. Std)&apos; THEN [GMV (copy)_5755600392050266164]&#13;&#10;WHEN &apos;DPS Incentive&apos; THEN [Calculation_2515823408474148870]&#13;&#10;WHEN &apos;DPS Priority Fee&apos; THEN [DPS Service Fee (copy)_6532541696563617857]&#13;&#10;WHEN &apos;DPS Priority Fee (opted-in)&apos; THEN [DPS Priority Fee (copy)_5755600392125005885]&#13;&#10;WHEN &apos;DPS Service Fee&apos; THEN [DPS Bad Weather Fee (copy)_6532541696563535936]&#13;&#10;WHEN &apos;DPS Small Basket Fee&apos; THEN [DPS Priority Fee (copy)_6532541696563712066]&#13;&#10;WHEN &apos;DPS Standard Fee&apos; THEN [DPS Delivery Fee (copy)_5755600392050372661]&#13;&#10;WHEN &apos;Delivery Costs&apos; THEN [Customer Service Fee (copy)_5755600392049983538]&#13;&#10;//WHEN &apos;Delivery Distance (km)&apos; THEN [Delivery Distance (km)]&#13;&#10;WHEN &apos;Delivery Fee Net&apos; THEN [Service Fee Net (copy)_1139973722152026141]&#13;&#10;WHEN &apos;Delivery Fee Net (Core)&apos; THEN [Delivery Fee Net (copy)_5755600392050769975]&#13;&#10;WHEN &apos;Delivery Fee Nominal&apos; THEN [Delivery Fee Net (copy)_5755600392051003448]&#13;&#10;WHEN &apos;Delivery Fee Paid&apos; THEN [Delivery Fee Gross (copy)_5755600392051531834]&#13;&#10;//WHEN &apos;Dimension&apos; THEN [Dimension]&#13;&#10;//WHEN &apos;Distance Buckets (km)&apos; THEN [Distance Buckets (km)]&#13;&#10;WHEN &apos;GMV&apos; THEN [Delivery Costs (copy)_5755600392050180147]&#13;&#10;WHEN &apos;Other DH Reductions&apos; THEN [Customer Fees DPS (copy)_1139973722258194473]&#13;&#10;WHEN &apos;Other Reductions&apos; THEN [Other DH Reductions (copy)_2515823408475398152]&#13;&#10;WHEN &apos;Priority Fee Net&apos; THEN [Service Fee Net (copy)_1139973722152595486]&#13;&#10;WHEN &apos;Priority Fee Paid&apos; THEN [Delivery Fee Net (copy)_5755600392041246766]&#13;&#10;//WHEN &apos;Reference&apos; THEN [Reference]&#13;&#10;//WHEN &apos;Reference (%)&apos; THEN [Reference (%)]&#13;&#10;WHEN &apos;Service Fee Net&apos; THEN [Customer Fees Paid (copy)_1139973722151665692]&#13;&#10;WHEN &apos;Service Fee Paid&apos; THEN [Service Fee Net (copy)_5755600392050638902]&#13;&#10;WHEN &apos;Small Basket Fee Net&apos; THEN [Service Fee Net (copy)_1139973722153009183]&#13;&#10;WHEN &apos;Small Basket Fee Paid&apos; THEN [Small Basket Fee Net (copy)_5755600392052346940]&#13;&#10;WHEN &apos;Subscription Vendor Subsidy Net&apos; THEN [Small Basket Net (copy)_1139973722288521258]&#13;&#10;//WHEN &apos;Taxes&apos; THEN [Taxes]&#13;&#10;WHEN &apos;Total Fees DPS&apos; THEN [Calculation_1139973721946988551]&#13;&#10;//WHEN &apos;Total Fees DPS (exc. Std)&apos; THEN [Total Fees DPS (exc. Std)]&#13;&#10;WHEN &apos;Total Fees Paid&apos; THEN [Total Fees Paid Net (copy)_5755600392043515951]&#13;&#10;WHEN &apos;Total Fees Paid Net&apos; THEN [Calculation_1139973721947041801]&#13;&#10;//WHEN &apos;Vendor Age (Days)&apos; THEN [Vendor Age (Days)]&#13;&#10;WHEN &apos;Vendor Fees Paid&apos; THEN [Vendor Funded Delivery Fee Subsidy Net (copy)_5755600392051896379]&#13;&#10;WHEN &apos;Vendor Funded Delivery Fee Subsidy Net&apos; THEN [Subscription Vendor Subsidy Net (copy)_1139973722288619563]&#13;&#10;END' />
            </column>
            <column caption='Other Reductions' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Other DH Reductions (copy)_2515823408475398152]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX([Calculation_1139973721946988551] - ([Calculation_2515823408474148870] + [Calculation_1139973721947041801]),0)' />
            </column>
            <column caption='Delivery Fee Net' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Service Fee Net (copy)_1139973722152026141]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([delivery_fee_net])/[Calculation_1139973721956712471],2)' />
