              <calculation class='tableau' formula='RAWSQLAGG_REAL(&quot;APPROX_QUANTILES(%1,1000)[OFFSET(250)]&quot;, [service_fee_eur]) * COUNT([__tableau_internal_object_id__].[pricing_framework_31443A764E8F4C8ABB81B0659FA41FC5]) / [Calculation_1139973721956712471]' />
            </column>
            <column caption='MOV (Q1)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Distance Based Fee (Q1) (copy)_1829305887750877284]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RAWSQLAGG_REAL(&quot;APPROX_QUANTILES(%1,1000)[OFFSET(250)]&quot;, [minimum_order_value_eur]) * COUNT([__tableau_internal_object_id__].[pricing_framework_31443A764E8F4C8ABB81B0659FA41FC5]) / [Calculation_1139973721956712471]' />
