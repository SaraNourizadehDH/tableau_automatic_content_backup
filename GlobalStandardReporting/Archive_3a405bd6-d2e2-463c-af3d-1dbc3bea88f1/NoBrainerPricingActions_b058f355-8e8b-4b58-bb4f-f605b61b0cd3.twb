            <column caption='Detail' datatype='string' name='[SD (copy)_139330180157165589]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Detail Set] THEN [Calculation_1139973721954193430] ELSE &apos;[Others]&apos; END' />
