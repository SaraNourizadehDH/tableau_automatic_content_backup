              <calculation class='tableau' formula='(ZN([Basket Value Paid (copy)_1132936785174761494]) - LOOKUP(ZN([Basket Value Paid (copy)_1132936785174761494]), -1)) / ABS(LOOKUP(ZN([Basket Value Paid (copy)_1132936785174761494]), -1))'>
