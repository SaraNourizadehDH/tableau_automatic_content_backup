      <aliases enabled='yes' />
      <column caption='% Not Sold 30D ' datatype='real' name='[% Sold 30D (copy)_109775267956441100]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_109775267955613707] / [Calculation_4851713845577093124]' />
      </column>
      <column caption='% Sold 30D' datatype='real' name='[% Sold 7D (copy)_109775267952861194]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_4851713845582356488]) / [Calculation_4851713845577093124]' />
      </column>
      <column aggregation='Attribute' caption='AVG Available Products Last 30D ' datatype='integer' name='[AVG Available Products Last 7D (copy)_4851713845582544905]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{EXCLUDE [stock_date]: COUNTD(IF [stock_date] &gt;= DATEADD(&apos;day&apos;,-30,TODAY()) AND [is_available] = TRUE THEN [product_name] END)}' />
      </column>
      <column caption='Main Category' datatype='string' name='[Calculation_109775267942825988]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN 1 THEN [category_new]&#10;WHEN 2 THEN [category_old]&#10;END' />
      </column>
      <column caption='Sub-Category' datatype='string' name='[Calculation_109775267943137285]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN 1 THEN [subcategory_new]&#10;WHEN 2 THEN [subcategory_old]&#10;END' />
      </column>
      <column aggregation='Attribute' caption='Orders Last 7D' datatype='integer' name='[Calculation_109775267945730055]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{EXCLUDE [stock_date]: SUM(IF [stock_date] &gt;= DATEADD(&apos;day&apos;, -7, TODAY()) THEN [orders] END)}' />
      </column>
      <column caption='% Sold 7D' datatype='real' name='[Calculation_109775267952746505]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_4851713845567053824]) / [Calculation_4851713845577093124]' />
      </column>
      <column caption='Products Not Sold Last 30D' datatype='integer' name='[Calculation_109775267955613707]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_4851713845577093124] - SUM([Calculation_4851713845582356488])' />
      </column>
      <column caption='Products Ordered / Not Sold Last 30D' datatype='integer' name='[Calculation_109775267963486222]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [sku]: COUNTD(IF ISNULL([Calculation_4851713845582143495]) AND [purchase_orders] &gt; 0  &#10;THEN [sku] END)}' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_1340102429486686208]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]=USERNAME()' />
      </column>
      <column caption='Products Sold Last 7D' datatype='integer' name='[Calculation_4851713845567053824]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [sku]: COUNTD(IF [Calculation_109775267945730055] &gt; 0 THEN [sku] END)}' />
      </column>
      <column caption='AVG Products' datatype='integer' name='[Calculation_4851713845577093124]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([sku])' />
      </column>
      <column aggregation='Attribute' caption='AVG Available Products Last 7D' datatype='integer' name='[Calculation_4851713845577334789]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{EXCLUDE [stock_date]: COUNTD(IF [stock_date] &gt;= DATEADD(&apos;day&apos;,-7,TODAY()) AND [is_available] = TRUE THEN [sku] END)}' />
      </column>
      <column aggregation='Attribute' caption='Orders Last 30D' datatype='integer' name='[Calculation_4851713845582143495]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{EXCLUDE [stock_date]: SUM(IF [stock_date] &gt;= DATEADD(&apos;day&apos;, -30, TODAY()) THEN [orders] END)}' />
      </column>
      <column caption='Products Sold Last 30D' datatype='integer' name='[Calculation_4851713845582356488]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [sku]: COUNTD(IF [Calculation_4851713845582143495] &gt; 0 THEN [sku] END)}' />
      </column>
      <column aggregation='Attribute' caption='Qty Sold Last 7D' datatype='real' name='[Calculation_4851713845586931723]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{EXCLUDE [stock_date]: SUM(IF [stock_date] &gt;= DATEADD(&apos;day&apos;, -7, TODAY()) THEN [qty_sold] END)}' />
      </column>
      <column caption='Product Status' datatype='string' name='[Calculation_4851713846326468622]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_active] = TRUE AND [is_available 1] = TRUE THEN &apos;Active/ Available&apos; &#10;ELSEIF [is_active] = TRUE  AND [is_available 1] = FALSE THEN &apos;Active/ Unavailable&apos;&#10;ELSEIF [is_active] = FALSE AND [is_available 1] = TRUE  THEN &apos;Inactive/ Available&apos; &#10;ELSEIF [is_active] = FALSE AND [is_available 1] = FALSE THEN &apos;Inactive/ Unavailable&apos;&#10;END' />
      </column>
      <column caption='Total SKUs' datatype='integer' name='[Calculation_4851713846328123409]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='{FIXED [warehouse_name]:COUNTD([sku])}' />
      </column>
      <column caption='Action To be Taken' datatype='string' name='[Calculation_4851713846349664274]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_active] = FALSE&#10;AND [on_hand_qty] &gt; 0 THEN&#10;&quot;Activate product to sell remaining stock OR dispose stock/return to supplier and then deactivate it.&quot;&#10;ELSEIF&#10;[is_active] = TRUE AND [on_hand_qty] = 0&#10;AND {FIXED [sku]:COUNT([sku])} &gt;30&#10;THEN &#10;&quot;Stock-out for &gt;30 days, place new PO or deactivate product. &quot;&#10;ELSEIF&#10;[is_active] = TRUE AND [on_hand_qty] &gt; 0&#10;AND [on_hand_qty] &lt; [min_qty]&#10;THEN &#10;&quot;Place new PO so product is shown in the frontend and can be ordered OR dispose stock/return to the supplier and then deactivate it.&quot; &#10;END' />
      </column>
      <column caption='Days Out of Stock' datatype='integer' name='[Calculation_4851713846354235411]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [sku]: COUNT([sku])}' />
      </column>
      <column caption='SKUs' datatype='integer' name='[Calculation_4851713846375817237]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [warehouse_name],[is_active]:COUNTD([sku])}' />
      </column>
      <column caption='AVG Basket Sizes' datatype='real' name='[Calculation_869405861608181763]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Qty Sold Last 7D (copy)_4851713845589520396]) / SUM([Calculation_4851713845582143495])' />
      </column>
      <column caption='Cost of Products Not Sold Last 30D' datatype='real' name='[Products Not Sold Last 30D (copy)_109775267961634829]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [sku]: SUM(IF (ISNULL([Calculation_4851713845582143495]) OR [Calculation_4851713845582143495] = 0) AND [purchase_orders] &gt; 0&#10;THEN [cost_delivered_goods_eur] END)}' />
      </column>
      <column aggregation='Attribute' caption='Qty Sold Last 30D' datatype='real' name='[Qty Sold Last 7D (copy)_4851713845589520396]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{EXCLUDE [stock_date]: SUM(IF [stock_date] &gt;= DATEADD(&apos;day&apos;, -30, TODAY()) THEN [qty_sold] END)}' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='_tableau_sku_report' datatype='table' name='[__tableau_internal_object_id__].[_tableau_sku_report_49304A800C2449E0853E62234F0E9BF1]' role='measure' type='quantitative' />
