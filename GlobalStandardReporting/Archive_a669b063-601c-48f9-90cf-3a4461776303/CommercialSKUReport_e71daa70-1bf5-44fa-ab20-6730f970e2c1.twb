              <calculation class='tableau' formula='IF [is_active] = FALSE&#10;AND [on_hand_qty] &gt; 0 THEN&#10;&quot;Activate product to sell remaining stock OR dispose stock/return to supplier and then deactivate it.&quot;&#10;ELSEIF&#10;[is_active] = TRUE AND [on_hand_qty] = 0&#10;AND {FIXED [sku]:COUNT([sku])} &gt;30&#10;THEN &#10;&quot;Stock-out for &gt;30 days, place new PO or deactivate product. &quot;&#10;ELSEIF&#10;[is_active] = TRUE AND [on_hand_qty] &gt; 0&#10;AND [on_hand_qty] &lt; [min_qty]&#10;THEN &#10;&quot;Place new PO so product is shown in the frontend and can be ordered OR dispose stock/return to the supplier and then deactivate it.&quot; &#10;END' />
