      <aliases enabled='yes' />
      <column caption='Median score 1 vs 2 abs' datatype='real' name='[Calculation_2174183099485876224]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_MEDIAN(MAX([Score 1 vs 2 (copy)_5515009626705575943]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Vendor name (ID)' datatype='string' name='[Calculation_4709850432421580802]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([vendor_name] + &quot;(&quot;+[platform_vendor_id]+&quot;)&quot;, [platform_vendor_id])' />
      </column>
      <column caption='Score 1 vs 2' datatype='integer' name='[Calculation_5515009626704384006]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Final Ranking (copy)_5515009626703880196]-[Score 1 (copy)_5515009626703962117]' />
      </column>
      <column caption='Product Count' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_5515009626707435528]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([global_product_id])' />
      </column>
      <column caption='Catg Rank (range)' datatype='integer' name='[Catg Rank (copy)_127508171788255232]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='[vendor_catg_order_rank]' />
      </column>
      <column caption='Score 1' datatype='integer' default-format='n#,##0;-#,##0' name='[Final Ranking (copy)_5515009626703880196]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF     [Parameters].[Parameter 1]=&apos;Brand Focused&apos;      THEN [rank_score_brand_focused_rank]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Novelty Focused&apos;    THEN [rank_score_novelty_focused_rank]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Popularity Focused&apos; THEN [rank_score_popularity_focused_rank]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Reorder Focused&apos;    THEN [reorder_score_rank]&#10;END' />
      </column>
      <column caption='Score 2' datatype='integer' default-format='n#,##0;-#,##0' name='[Score 1 (copy)_5515009626703962117]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF     [Parameters].[Choose Score 1 (copy)_5515009626703007747]=&apos;Brand Focused&apos;      THEN [rank_score_brand_focused_rank]&#10;ELSEIF [Parameters].[Choose Score 1 (copy)_5515009626703007747]=&apos;Novelty Focused&apos;    THEN [rank_score_novelty_focused_rank]&#10;ELSEIF [Parameters].[Choose Score 1 (copy)_5515009626703007747]=&apos;Popularity Focused&apos; THEN [rank_score_popularity_focused_rank]&#10;ELSEIF [Parameters].[Choose Score 1 (copy)_5515009626703007747]=&apos;Reorder Focused&apos;    THEN [reorder_score_rank]&#10;END' />
      </column>
      <column caption='Score 1 vs 2 abs' datatype='integer' name='[Score 1 vs 2 (copy)_5515009626705575943]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ABS([Final Ranking (copy)_5515009626703880196]-[Score 1 (copy)_5515009626703962117])' />
