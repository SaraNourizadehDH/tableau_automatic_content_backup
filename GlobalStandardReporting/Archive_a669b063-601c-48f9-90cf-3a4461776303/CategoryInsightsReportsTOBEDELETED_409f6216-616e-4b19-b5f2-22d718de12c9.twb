      <column caption='% Change in ASP' datatype='real' default-format='p0.0%' name='[% Change in ABV (copy)_2096566370915426342]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Current Period ABV (copy)_2096566370914680868] / [Prior Period ABV (copy)_2096566370914975781]) - 1' />
      </column>
      <column caption='% Change in AVG SKUs Available Per Store' datatype='real' name='[% Change in AVG SKUs Sold per Store (copy)_1942318084296433687]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Current Period Avg SKUs Sold (copy)_1942318084294799381] / [Prior Period SKUs Sold (copy)_1942318084296327190]) - 1' />
      </column>
      <column caption='% Change in Front Margin' datatype='real' name='[% Change in Customers (copy)_1942318084058652682]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Current Period COGS (copy)_1942318084058066951] - [Prior Period Customers (copy)_1942318084058394633])' />
      </column>
      <column caption='% Change in AVG SKUs Sold' datatype='real' name='[% Change in Customers (copy)_1942318084267122708]' role='measure' type='quantitative'>
