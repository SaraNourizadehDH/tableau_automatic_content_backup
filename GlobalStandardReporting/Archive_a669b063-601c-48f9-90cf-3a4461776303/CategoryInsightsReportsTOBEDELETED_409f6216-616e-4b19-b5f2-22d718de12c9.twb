      <column caption='% Change in AVG Sales Price (Category)' datatype='real' name='[Calculation_5269704190577565710]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(([CP Net Retail Revenue (Category) (copy)_5269704190576906252] / [Calculation_5269704190577373197]) - 1)' />
      </column>
      <column caption='CP Front Margin % (Category)' datatype='real' name='[Calculation_5269704190597578769]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(([CP Net Retail Revenue (copy)_5269704190572191746] - [CP Net Retail Revenue (Category) (copy)_5269704190597079055]) / [CP Net Retail Revenue (copy)_5269704190572191746])' />
      </column>
      <column caption='CP Active Products (Category)' datatype='integer' name='[Calculation_5269704190598668308]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Calculation_6160924302408085527] &gt;= [Parameters].[Parameter 1] AND [Calculation_6160924302408085527] &lt;= [Parameters].[Parameter 2] THEN [sku] END)' />
      </column>
      <column caption='CP Availability (Category)' datatype='real' name='[Calculation_5269704190599610390]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_6160924302408085527] &gt;= [Parameters].[Parameter 1] AND [Calculation_6160924302408085527] &lt;= [Parameters].[Parameter 2] THEN [available_instances] END) &#10;/ &#10;SUM(IF [Calculation_6160924302408085527] &gt;= [Parameters].[Parameter 1] AND [Calculation_6160924302408085527] &lt;= [Parameters].[Parameter 2] THEN [total_instances] END)' />
      </column>
      <column caption='CP Basket Penetration (Category)' datatype='real' name='[Calculation_5269704190601420826]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM(IF [Calculation_6160924302408085527] &gt;= [Parameters].[Parameter 1] AND [Calculation_6160924302408085527] &lt;= [Parameters].[Parameter 2] THEN [orders] END)&#10; /&#10;[Total Orders (copy)_5269704190601232409])' />
      </column>
      <column caption='% Change in Customer Penetration (Category)' datatype='real' name='[Calculation_5269704190612471847]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([CP Basket Penetration (Category) (copy)_5269704190611886117] - [CP Customer Penetration (Category) (copy)_5269704190612160550])' />
      </column>
      <column caption='CP SKU Unit Velocity (Weekly)' datatype='real' name='[Calculation_5269704190619054127]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// qty sold / products sold / warehouses selling / weeks &#10;&#10;[CP Net Retail Revenue (Category) (copy)_5269704190575751177] &#10;/ [CP Active Products (Category) (copy)_5269704190613999657] &#10;/ [CP Active Products (Category) (copy)_5269704190619787312]&#10;/ (IF AVG(DATEDIFF(&apos;week&apos;, [Parameters].[Parameter 1], [Parameters].[Parameter 2])) = 0 THEN 1 &#10;ELSE AVG(DATEDIFF(&apos;week&apos;, [Parameters].[Parameter 1], [Parameters].[Parameter 2]))  END)' />
      </column>
      <column caption='% Change in SKU Unit Velocity (Weekly)' datatype='real' name='[Calculation_5269704190621962292]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_5269704190619054127] / [CP SKU Velocity (Weekly) (copy)_5269704190621556787] ) - 1' />
      </column>
      <column caption='Unit Cost' datatype='real' name='[Calculation_6160924302098034688]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;EUR&apos; THEN [unit_cost_eur]&#10;WHEN &apos;Local&apos; THEN [unit_cost_lc]&#10;END' />
      </column>
      <column caption='Unit Price Listed' datatype='real' name='[Calculation_6160924302098333697]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;EUR&apos; THEN [unit_price_listed_eur]&#10;WHEN &apos;Local&apos; THEN [unit_price_listed_lc]&#10;END' />
      </column>
      <column caption='Selling Price' datatype='real' name='[Calculation_6160924302098726914]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;EUR&apos; THEN [average_selling_price_eur]&#10;WHEN &apos;Local&apos; THEN [average_selling_price_lc]&#10;END' />
      </column>
      <column caption='Stores Selling Last Week' datatype='integer' name='[Calculation_6160924302269145092]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='COUNTD(IF DATETRUNC(&apos;week&apos;,[stock_date]) = DATETRUNC(&apos;week&apos;,DATEADD(&apos;week&apos;,-1,TODAY()))&#10; AND [orders] &gt; 0 THEN [warehouse_name] END)' />
      </column>
      <column caption='Stores Stocking' datatype='integer' name='[Calculation_6160924302270820357]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='COUNTD([warehouse_name])' />
      </column>
      <column caption='Sales/ GMV' datatype='real' name='[Calculation_6160924302271447046]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN((CASE [Parameters].[Parameter 3] &#10;WHEN &apos;EUR&apos; THEN [total_price_paid_eur]&#10;WHEN &apos;Local&apos; THEn [total_price_paid_lc]&#10;END))' />
      </column>
      <column caption='Availability' datatype='real' name='[Calculation_6160924302274392071]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([available_times]) / SUM([total_products])' />
      </column>
      <column caption='Products' datatype='integer' name='[Calculation_6160924302274977800]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([global_product_id])' />
      </column>
      <column caption='Only Full Week' datatype='boolean' name='[Calculation_6160924302376464394]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[stock_date] &lt;= DATEADD(&apos;week&apos;, -1, TODAY())' />
      </column>
      <column caption='Rate of Sale' datatype='real' name='[Calculation_6160924302379237387]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// units sold last week / # stores stocking last week&#10;&#10;ZN(SUM([qty_sold]) / COUNTD([warehouse_name]))' />
      </column>
      <column caption='Total Orders' datatype='integer' name='[Calculation_6160924302380400655]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED  [warehouse_name], [stock_date]: SUM([orders])}' />
      </column>
      <column caption='Basket Penetration' datatype='real' name='[Calculation_6160924302380568592]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([orders]) / SUM([Calculation_6160924302380400655]))' />
      </column>
      <column caption='Promotional participation' datatype='real' default-format='p0.00%' name='[Calculation_6160924302396375057]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//Units sold on promotion/units sold by list price&#10;&#10;ZN(SUM([units_with_discount]) / (SUM([units_without_discount]) + SUM([units_with_discount])) )' />
      </column>
      <column caption='COGS' datatype='real' name='[Calculation_6160924302405914642]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN((CASE [Parameters].[Parameter 3]&#10;WHEN &apos;EUR&apos; THEN [cogs_eur]&#10;WHEN &apos;Local&apos; THEN [cogs_lc]&#10;END))' />
      </column>
      <column caption='Net Retail Revenue' datatype='real' name='[Calculation_6160924302406176787]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN((CASE [Parameters].[Parameter 3]&#10;WHEN &apos;EUR&apos; THEN [total_price_paid_net_eur]&#10;WHEN &apos;Local&apos; THEN [total_price_paid_net_lc]&#10;END))' />
      </column>
      <column caption='Front Margin %' datatype='real' name='[Calculation_6160924302406340628]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN((SUM([Calculation_6160924302406176787]) - SUM([Calculation_6160924302405914642]) /SUM([Calculation_6160924302406176787])))' />
      </column>
      <column caption='Date' datatype='date' name='[Calculation_6160924302408085527]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE([stock_date])' />
      </column>
      <column caption='Units' datatype='real' name='[Calculation_6160924302409244696]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(([qty_sold]))' />
      </column>
      <column caption='Date Limitation' datatype='boolean' name='[Calculation_6160924302585344026]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[stock_date] &gt;= DATEADD([Parameters].[Parameter 5],-([Parameters].[Parameter 7]), DATETRUNC([Parameters].[Parameter 5],TODAY()))&#10;&#10;AND [stock_date] &lt; DATETRUNC([Parameters].[Parameter 5], TODAY()) - 1' />
      </column>
      <column caption='CP COGS' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6160924302591389724]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_6160924302585344026] = True THEN [Calculation_6160924302405914642] END)' />
      </column>
      <column caption='Status' datatype='string' name='[Calculation_6160924302594248737]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_active] = TRUE THEN &apos;Active&apos; &#10;ELSE &apos;Inactive&apos;&#10;END' />
      </column>
      <column caption='Previous Period Filter' datatype='boolean' name='[Calculation_6160924302595285026]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[stock_date] &lt; DATEADD([Parameters].[Parameter 5],-([Parameters].[Parameter 7]), DATETRUNC([Parameters].[Parameter 5],TODAY())) - 1&#10;&#10;AND [stock_date] &gt;= DATEADD([Parameters].[Parameter 5], -2 * [Parameters].[Parameter 7], DATETRUNC([Parameters].[Parameter 5], TODAY()))' />
      </column>
      <column caption='CP Shrink %' datatype='real' default-format='p0.00%' name='[Calculation_6160924302605664309]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//Shrink as % of sales&#10;ZN([Selected Period COGS (copy)_6160924302604718131] / [Selected Period COGS (copy)_6160924302591688733])' />
      </column>
      <column caption='Current Period ' datatype='string' name='[Calculation_6160924302607155254]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Current Period Metrics&apos;' />
      </column>
      <column caption='% Change Net Retail Revenue' datatype='real' name='[Calculation_6160924302620860476]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(([Selected Period COGS (copy)_6160924302591688733] / [Selected Period Sales/ GMV (copy)_6160924302595874851]) - 1)' />
      </column>
      <column caption='Top/Bottom Measure' datatype='real' name='[Calculation_6160924305166090328]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 9]&#10;WHEN &apos;Selected Period Sales&apos; THEN [Selected Period COGS (copy)_6160924302591688733]&#10;WHEN &apos;Selected Period Front Margin&apos; THEN [Front Margin % (copy)_6160924302598889512]&#10;WHEN &apos;Selected Period Qty Sold&apos; THEN [Selected Period COGS (copy) (copy)_6160924302591893534]&#10;WHEN &apos;Selected Period Basket Penetration&apos; THEN [Basket Penetration (copy)_6160924302597959718]&#10;WHEN &apos;Total Sales&apos; THEN SUM([Calculation_6160924302271447046])&#10;WHEN &apos;Total Front Margin&apos; THEN [Front Margin % (copy)_6160924302407270422]&#10;WHEN &apos;Total Qty&apos; THEN SUM([qty_sold])&#10;WHEN &apos;Total Basket Penetration&apos; THEN [Calculation_6160924302380568592]&#10;END' />
      </column>
      <column caption='Index' datatype='integer' name='[Calculation_6160924305456459865]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Dimension' datatype='string' name='[Calculation_6160924305480368227]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 11]&#10;WHEN &apos;Country&apos; THEN [global_entity_id]&#10;WHEN &apos;Category&apos; THEN [category_parent_english]&#10;WHEN &apos;Subcategory&apos; THEN [category_english]&#10;WHEN &apos;Supplier&apos; THEN [supplier_name]&#10;WHEN &apos;Warehouse&apos; THEN [warehouse_name]&#10;END' />
      </column>
      <column caption='CP Stores Selling' datatype='integer' default-format='N' name='[Calculation_6160924307289653364]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(COUNTD(IF [Calculation_6160924302585344026] = True THEN [warehouse_id_selling] END))' />
      </column>
      <column caption='Listed SKU Per warehouse fixed' datatype='real' name='[Calculation_618470931631521800]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [global_entity_id],[warehouse_name],[category_parent_english], [category_english], [stock_date]: Avg([listed_sku_count_per_warehouse])}' />
      </column>
      <column caption='Retail Revenue' datatype='real' name='[Calculation_6197727152945995777]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;EUR&apos; THEN [total_price_paid_eur]&#10;WHEN &apos;Local&apos; THEN [total_price_paid_lc]&#10;END' />
      </column>
      <column caption='Days In Range' datatype='integer' name='[Calculation_6516427220859899908]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(IF [Parameters].[Date Level (copy)_6516427220856385536] = &apos;week&apos; THEN [Parameters].[Parameter 7] * 7 &#10;   ELSEIF [Parameters].[Date Level (copy)_6516427220856385536] = &apos;month&apos; THEN [Parameters].[Parameter 7] * 30&#10;   ELSEIF [Parameters].[Date Level (copy)_6516427220856385536] = &apos;quarter&apos; THEN [Parameters].[Parameter 7] * 90&#10;   END)' />
      </column>
      <column caption='SKU Age' datatype='integer' name='[Calculation_6929984329390661658]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;week&apos;, &#10;{FIXED [global_entity_id], [sku]: MIN([product_created_at])}, TODAY())' />
