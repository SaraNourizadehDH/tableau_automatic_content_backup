              <calculation class='tableau' formula='AVG({FIXED [region], [global_entity_id], [Calculation_5269704190573768709]:AVG(&#10;&#10;{FIXED [region], [global_entity_id], [category_parent_english], [category_english], [warehouse_name], [sku], [Calculation_5269704190573768709]: AVG(IF [Calculation_5269704190573768709] &gt;= [Parameters].[Parameter 1] &#10;AND [Calculation_5269704190573768709] &lt;= [Parameters].[Parameter 2] THEN&#10;[avg_units_per_basket] END)})})' />
