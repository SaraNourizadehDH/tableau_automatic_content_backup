      <column caption='PP AVG Sales Price (Category)' datatype='real' name='[Calculation_5269704190577373197]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([PP Net Retail Revenue (copy)_5269704190572453891]/[PP Net Retail Revenue (Category) (copy)_5269704190575886346])' />
      </column>
      <column caption='% Change in AVG Sales Price (Category)' datatype='real' name='[Calculation_5269704190577565710]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(([CP Net Retail Revenue (Category) (copy)_5269704190576906252] / [Calculation_5269704190577373197]) - 1)' />
      </column>
      <column caption='CP Front Margin % (Category)' datatype='real' name='[Calculation_5269704190597578769]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(([CP Net Retail Revenue (copy)_5269704190572191746] - [CP Net Retail Revenue (Category) (copy)_5269704190597079055]) / [CP Net Retail Revenue (copy)_5269704190572191746])' />
      </column>
      <column caption='CP Active Products (Category)' datatype='integer' name='[Calculation_5269704190598668308]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Calculation_5269704190573768709] &gt;= [Parameters].[Parameter 1] AND [Calculation_5269704190573768709] &lt;= [Parameters].[Parameter 2] THEN [sku] END)' />
      </column>
      <column caption='CP Availability (Category)' datatype='real' name='[Calculation_5269704190599610390]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_5269704190573768709] &gt;= [Parameters].[Parameter 1] AND [Calculation_5269704190573768709] &lt;= [Parameters].[Parameter 2] THEN [available_instances] END) &#10;/ &#10;SUM(IF [Calculation_5269704190573768709] &gt;= [Parameters].[Parameter 1] AND [Calculation_5269704190573768709] &lt;= [Parameters].[Parameter 2] THEN [total_instances] END)' />
      </column>
      <column caption='CP Basket Penetration (Category)' datatype='real' name='[Calculation_5269704190601420826]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM(IF [Calculation_5269704190573768709] &gt;= [Parameters].[Parameter 1] AND [Calculation_5269704190573768709] &lt;= [Parameters].[Parameter 2] THEN [orders] END)&#10; /&#10;[Total Orders (copy)_5269704190601232409])' />
      </column>
      <column caption='% Change in Customer Penetration (Category)' datatype='real' name='[Calculation_5269704190612471847]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([CP Basket Penetration (Category) (copy)_5269704190611886117] - [CP Customer Penetration (Category) (copy)_5269704190612160550])' />
      </column>
      <column caption='CP SKU Unit Velocity (Weekly)' datatype='real' name='[Calculation_5269704190619054127]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// qty sold / products sold / warehouses selling / weeks &#10;&#10;[CP Net Retail Revenue (Category) (copy)_5269704190575751177] &#10;/ [CP Active Products (Category) (copy)_5269704190613999657] &#10;/ [CP Active Products (Category) (copy)_5269704190619787312]&#10;/ (IF AVG(DATEDIFF(&apos;week&apos;, [Parameters].[Parameter 1], [Parameters].[Parameter 2])) = 0 THEN 1 &#10;ELSE AVG(DATEDIFF(&apos;week&apos;, [Parameters].[Parameter 1], [Parameters].[Parameter 2]))  END)' />
      </column>
      <column caption='% Change in SKU Unit Velocity (Weekly)' datatype='real' name='[Calculation_5269704190621962292]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_5269704190619054127] / [CP SKU Velocity (Weekly) (copy)_5269704190621556787] ) - 1' />
      </column>
      <column caption='Unit Cost' datatype='real' name='[Calculation_6160924302098034688]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;EUR&apos; THEN [unit_cost_eur]&#10;WHEN &apos;Local&apos; THEN [unit_cost_lc]&#10;END' />
      </column>
      <column caption='Unit Price Listed' datatype='real' name='[Calculation_6160924302098333697]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;EUR&apos; THEN [unit_price_listed_eur]&#10;WHEN &apos;Local&apos; THEN [unit_price_listed_lc]&#10;END' />
      </column>
      <column caption='Selling Price' datatype='real' name='[Calculation_6160924302098726914]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;EUR&apos; THEN [average_selling_price_eur]&#10;WHEN &apos;Local&apos; THEN [average_selling_price_lc]&#10;END' />
      </column>
      <column caption='Stores Stocking' datatype='integer' name='[Calculation_6160924302270820357]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='COUNTD([warehouse_name])' />
      </column>
      <column caption='Sales/ GMV' datatype='real' name='[Calculation_6160924302271447046]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN((CASE [Parameters].[Parameter 3] &#10;WHEN &apos;EUR&apos; THEN [total_price_paid_eur]&#10;WHEN &apos;Local&apos; THEn [total_price_paid_lc]&#10;END))' />
      </column>
      <column caption='Only Full Week' datatype='boolean' name='[Calculation_6160924302376464394]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[stock_date] &lt;= DATEADD(&apos;week&apos;, -1, TODAY())' />
      </column>
      <column caption='Total Orders' datatype='integer' name='[Calculation_6160924302380400655]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED  [warehouse_name], [stock_date]: SUM([orders])}' />
      </column>
      <column caption='Basket Penetration' datatype='real' name='[Calculation_6160924302380568592]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([orders]) / SUM([Calculation_6160924302380400655]))' />
      </column>
      <column caption='COGS' datatype='real' name='[Calculation_6160924302405914642]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN((CASE [Parameters].[Parameter 3]&#10;WHEN &apos;EUR&apos; THEN [cogs_eur]&#10;WHEN &apos;Local&apos; THEN [cogs_lc]&#10;END))' />
      </column>
      <column caption='Net Retail Revenue' datatype='real' name='[Calculation_6160924302406176787]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN((CASE [Parameters].[Parameter 3]&#10;WHEN &apos;EUR&apos; THEN [total_price_paid_net_eur]&#10;WHEN &apos;Local&apos; THEN [total_price_paid_net_lc]&#10;END))' />
      </column>
      <column caption='Units' datatype='real' name='[Calculation_6160924302409244696]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(([qty_sold]))' />
      </column>
      <column caption='Date Limitation' datatype='boolean' name='[Calculation_6160924302585344026]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[stock_date] &gt;= DATEADD([Parameters].[Parameter 5],-([Parameters].[Parameter 7]), DATETRUNC([Parameters].[Parameter 5],TODAY()))&#10;&#10;AND [stock_date] &lt; DATETRUNC([Parameters].[Parameter 5], TODAY()) - 1' />
      </column>
      <column caption='CP COGS' datatype='real' name='[Calculation_6160924302591389724]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_6160924302585344026] = True THEN [Calculation_6160924302405914642] END)' />
      </column>
      <column caption='Status' datatype='string' name='[Calculation_6160924302594248737]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_active] = TRUE THEN &apos;Active&apos; &#10;ELSE &apos;Inactive&apos;&#10;END' />
      </column>
      <column caption='Previous Period Filter' datatype='boolean' name='[Calculation_6160924302595285026]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[stock_date] &lt; DATEADD([Parameters].[Parameter 5],-([Parameters].[Parameter 7]), DATETRUNC([Parameters].[Parameter 5],TODAY())) - 1&#10;&#10;AND [stock_date] &gt;= DATEADD([Parameters].[Parameter 5], -2 * [Parameters].[Parameter 7], DATETRUNC([Parameters].[Parameter 5], TODAY()))' />
      </column>
      <column caption='CP Shrink %' datatype='real' name='[Calculation_6160924302605664309]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//Shrink as % of sales&#10;ZN([Selected Period COGS (copy)_6160924302604718131] / [Selected Period COGS (copy)_6160924302591688733])' />
      </column>
      <column caption='% Change Net Retail Revenue' datatype='real' name='[Calculation_6160924302620860476]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(([Selected Period COGS (copy)_6160924302591688733] / [Selected Period Sales/ GMV (copy)_6160924302595874851]) - 1)' />
      </column>
      <column caption='Top/Bottom Measure' datatype='real' name='[Calculation_6160924305166090328]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 9]&#10;WHEN &apos;Selected Period Sales&apos; THEN [Selected Period COGS (copy)_6160924302591688733]&#10;WHEN &apos;Selected Period Front Margin&apos; THEN [Front Margin % (copy)_6160924302598889512]&#10;WHEN &apos;Selected Period Qty Sold&apos; THEN [Selected Period COGS (copy) (copy)_6160924302591893534]&#10;WHEN &apos;Selected Period Basket Penetration&apos; THEN [Basket Penetration (copy)_6160924302597959718]&#10;WHEN &apos;Total Sales&apos; THEN SUM([Calculation_6160924302271447046])&#10;WHEN &apos;Total Front Margin&apos; THEN [Front Margin % (copy)_6160924302407270422]&#10;WHEN &apos;Total Qty&apos; THEN SUM([qty_sold])&#10;WHEN &apos;Total Basket Penetration&apos; THEN [Calculation_6160924302380568592]&#10;END' />
      </column>
      <column caption='Index' datatype='integer' name='[Calculation_6160924305456459865]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Dimension' datatype='string' name='[Calculation_6160924305480368227]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 11]&#10;WHEN &apos;Country&apos; THEN [global_entity_id]&#10;WHEN &apos;Category&apos; THEN [category_parent_english]&#10;WHEN &apos;Subcategory&apos; THEN [category_english]&#10;WHEN &apos;Supplier&apos; THEN [supplier_name]&#10;WHEN &apos;Warehouse&apos; THEN [warehouse_name]&#10;END' />
      </column>
      <column caption='CP Stores Selling' datatype='integer' name='[Calculation_6160924307280879730]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(COUNTD(IF [Calculation_6160924302585344026] = True THEN [warehouse_id_selling] END))' />
      </column>
      <column caption='CP Stores Stocking' datatype='integer' name='[Calculation_6160924307281113203]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(COUNTD(IF [Calculation_6160924302585344026] = True THEN [warehouse_id_stocking] END))' />
      </column>
      <column caption='Listed SKU Per warehouse fixed' datatype='real' name='[Calculation_618470931630133255]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [global_entity_id],[warehouse_name],[category_parent_english], [category_english], [stock_date]: Avg([listed_sku_count_per_warehouse])}' />
      </column>
      <column caption='Retail Revenue' datatype='real' name='[Calculation_6197727152945995777]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;EUR&apos; THEN [total_price_paid_eur]&#10;WHEN &apos;Local&apos; THEN [total_price_paid_lc]&#10;END' />
      </column>
      <column caption='Days In Range' datatype='integer' name='[Calculation_6516427220859854851]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(IF [Parameters].[Date Level (copy)_6516427220856385536] = &apos;week&apos; THEN [Parameters].[Parameter 7] * 7 &#10;   ELSEIF [Parameters].[Date Level (copy)_6516427220856385536] = &apos;month&apos; THEN [Parameters].[Parameter 7] * 30&#10;   ELSEIF [Parameters].[Date Level (copy)_6516427220856385536] = &apos;quarter&apos; THEN [Parameters].[Parameter 7] * 90&#10;   END)' />
      </column>
      <column caption='SKU Age' datatype='integer' name='[Calculation_6929984329390620697]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;week&apos;, &#10;{FIXED [global_entity_id], [sku]: MIN([product_created_at])}, TODAY())' />
      </column>
      <column caption='Sub Category count' datatype='integer' name='[Calculation_854558044969672728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([category_english])' />
      </column>
      <column caption='CP All Orders Per Country Category Fixed' datatype='real' name='[Calculation_854558044969730073]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [global_entity_id], [warehouse_id_selling], [category_parent_english], [stock_date]: &#13;&#10;Avg(IF ([Calculation_5269704190573768709] &gt;= [Parameters].[Parameter 1] AND [Calculation_5269704190573768709] &lt;= [Parameters].[Parameter 2]&#13;&#10;AND NOT ISNULL([warehouse_id_selling]))&#13;&#10; THEN [orders_per_warehouse_cat] END)}' />
      </column>
      <column caption='CP All Orders Per Country SubCategory Fixed' datatype='real' name='[Calculation_854558044969791514]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [global_entity_id], [warehouse_id_selling], [category_parent_english], [category_english], [stock_date]: &#13;&#10;Avg(IF ([Calculation_5269704190573768709] &gt;= [Parameters].[Parameter 1] AND [Calculation_5269704190573768709] &lt;= [Parameters].[Parameter 2]&#13;&#10;AND NOT ISNULL([warehouse_id_selling]))&#13;&#10; THEN [orders_per_warehouse_subcat] END)}' />
      </column>
      <column caption='CP All Orders Per Country Fixed' datatype='real' name='[Calculation_854558044969840667]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [global_entity_id], [stock_date]: &#13;&#10;Avg(IF ([Calculation_5269704190573768709] &gt;= [Parameters].[Parameter 1] AND [Calculation_5269704190573768709] &lt;= [Parameters].[Parameter 2])&#13;&#10; THEN [all_orders_per_country] END)}' />
      </column>
      <column caption='CP Basket Penetration %' datatype='real' name='[Calculation_854558044969902108]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE  [Calculation_854558044969672728]&#13;&#10;    WHEN  1&#13;&#10;    THEN&#13;&#10;    ZN(SUM([Calculation_854558044969791514])/SUM([Calculation_854558044969840667]))&#13;&#10;    ELSE&#13;&#10;    ZN(SUM([Calculation_854558044969730073])/SUM([Calculation_854558044969840667]))&#13;&#10;END' />
      </column>
      <column caption='PP All Orders Per Country Category Fixed' datatype='real' name='[Calculation_854558044969947165]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [global_entity_id], [warehouse_id_selling], [category_parent_english], [stock_date]: &#13;&#10;Avg(IF ([Calculation_5269704190573768709] &gt;= [Parameters].[CP Start Date (copy)_5269704190572032001] AND [Calculation_5269704190573768709] &lt;= [Parameters].[CP End Date (copy)_5269704190572023808]&#13;&#10;AND NOT ISNULL([warehouse_id_selling]))&#13;&#10; THEN [orders_per_warehouse_cat] END)}' />
      </column>
      <column caption='PP All Orders Per Country Fixed' datatype='real' name='[Calculation_854558044970020894]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [global_entity_id], [stock_date]: &#13;&#10;Avg(IF ([Calculation_5269704190573768709] &gt;= [Parameters].[CP Start Date (copy)_5269704190572032001] AND [Calculation_5269704190573768709] &lt;= [Parameters].[CP End Date (copy)_5269704190572023808])&#13;&#10; THEN [all_orders_per_country] END)}' />
      </column>
      <column caption='PP All Orders Per Country SubCategory Fixed' datatype='real' name='[Calculation_854558044970070047]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [global_entity_id], [warehouse_id_selling], [category_parent_english], [category_english], [stock_date]: &#13;&#10;Avg(IF ([Calculation_5269704190573768709] &gt;= [Parameters].[CP Start Date (copy)_5269704190572032001] AND [Calculation_5269704190573768709] &lt;= [Parameters].[CP End Date (copy)_5269704190572023808]&#13;&#10;AND NOT ISNULL([warehouse_id_selling]))&#13;&#10; THEN [orders_per_warehouse_subcat] END)}' />
      </column>
      <column caption='PP Basket Penetration %' datatype='real' name='[Calculation_854558044970131488]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE  [Calculation_854558044969672728]&#13;&#10;    WHEN  1&#13;&#10;    THEN&#13;&#10;    ZN(SUM([Calculation_854558044970070047])/SUM([Calculation_854558044970020894]))&#13;&#10;    ELSE&#13;&#10;    ZN(SUM([Calculation_854558044969947165])/SUM([Calculation_854558044970020894]))&#13;&#10;END' />
      </column>
      <column caption='% Change CP BASKET PENETRATION' datatype='real' name='[Calculation_854558044970184737]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([Calculation_854558044969902108] - [Calculation_854558044970131488])' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_986006901333659651]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] =   USERNAME()' />
      </column>
      <column caption='CP Front (net) Margin' datatype='real' name='[Front (net) Margin (copy)_6160924302598246439]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM(IF [Calculation_6160924302585344026] = TRUE THEN [Calculation_6160924302406176787] END) &#10;- [Calculation_6160924302591389724])' />
      </column>
      <column caption='Front (net) Margin' datatype='real' name='[Front Margin % (copy)_6160924302407270422]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([Calculation_6160924302406176787]) - SUM([Calculation_6160924302405914642]))' />
      </column>
      <column caption='CP Front Margin % ' datatype='real' name='[Front Margin % (copy)_6160924302598889512]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN((SUM(IF [Calculation_6160924302585344026] = TRUE THEN [Calculation_6160924302406176787] END) - [Calculation_6160924302591389724]) &#10;/(SUM(IF [Calculation_6160924302585344026] = TRUE THEN [Calculation_6160924302406176787] END)))' />
      </column>
      <column caption='PPP' datatype='real' name='[Net Retail Revenue (copy)_4706402398880399361]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN((CASE [Parameters].[Parameter 3]&#10;WHEN &apos;EUR&apos; THEN [total_ppp_eur]&#10;WHEN &apos;Local&apos; THEN [total_ppp_lc]&#10;END))' />
      </column>
      <column caption='Shrinkage ' datatype='real' name='[Net Retail Revenue (copy)_6160924302604517426]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN((CASE [Parameters].[Parameter 3]&#10;WHEN &apos;EUR&apos; THEN [shrinkage_amt_eur]&#10;WHEN &apos;Local&apos; THEN [shrinkage_amt_lc]&#10;END))' />
      </column>
      <column caption='PP Basket Penetration (Supplier)' datatype='real' name='[PP Basket Penetration (Category)  (copy)_3793790151022714882]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM(IF [Calculation_5269704190573768709] &gt;= [Parameters].[CP Start Date (copy)_5269704190572032001] AND [Calculation_5269704190573768709] &lt;= [Parameters].[CP End Date (copy)_5269704190572023808] THEN [orders] END)&#10; /&#10;[PP Total Orders (Category) (copy)_3793790151022862339])' />
      </column>
      <column caption='PP Orders (Category)' datatype='real' name='[PP COGS (Category)  (copy)_1189161454550392833]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [region], [global_entity_id], [Calculation_5269704190573768709]:AVG(&#10;&#10;{FIXED [region], [global_entity_id], [category_parent_english], [category_english], [warehouse_name], [sku], [Calculation_5269704190573768709]: AVG(IF [Calculation_5269704190573768709] &gt;= [Parameters].[CP Start Date (copy)_5269704190572032001] &#10;AND [Calculation_5269704190573768709] &lt;= [Parameters].[CP End Date (copy)_5269704190572023808] THEN&#10;[all_orders_per_country] END)})}' />
      </column>
      <column caption='PP Customer Penetration (Supplier)' datatype='real' name='[PP Customer Penetration (Category)  (copy)_3793790151023955976]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([CP Customers (Category) (copy)_5269704190611570723]&#10; /&#10;[PP Total Customers (Category) (copy)_3793790151023640582] )' />
      </column>
      <column caption='PP Quantity Sold (Category)' datatype='real' name='[PP Net Retail Revenue (Category) (copy)_5269704190575886346]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_5269704190573768709] &gt;= [Parameters].[CP Start Date (copy)_5269704190572032001] AND [Calculation_5269704190573768709] &lt;= [Parameters].[CP End Date (copy)_5269704190572023808]&#10; THEN [Calculation_6160924302409244696] END)' />
      </column>
      <column caption='PP COGS (Category) ' datatype='real' name='[PP Net Retail Revenue (Category) (copy)_5269704190597193744]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_5269704190573768709] &gt;= [Parameters].[CP Start Date (copy)_5269704190572032001] AND [Calculation_5269704190573768709] &lt;= [Parameters].[CP End Date (copy)_5269704190572023808]&#10; THEN [Calculation_6160924302405914642] END)' />
      </column>
      <column caption='PP Net Retail Revenue (Category)' datatype='real' name='[PP Net Retail Revenue (copy)_5269704190572453891]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_5269704190573768709] &gt;= [Parameters].[CP Start Date (copy)_5269704190572032001] AND [Calculation_5269704190573768709] &lt;= [Parameters].[CP End Date (copy)_5269704190572023808]&#10; THEN [Calculation_6160924302406176787] END)' />
      </column>
      <column caption='PP Total Customers (Supplier) ' datatype='integer' name='[PP Total Customers (Category) (copy)_3793790151023640582]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({EXCLUDE  [supplier_name], [brand_name], [product_name]: &#10;SUM(IF [Calculation_5269704190573768709] &gt;= [Parameters].[CP Start Date (copy)_5269704190572032001] AND [Calculation_5269704190573768709] &lt;= [Parameters].[CP End Date (copy)_5269704190572023808] THEN [customers] END)})' />
      </column>
      <column caption='PP Total Orders (Supplier)' datatype='integer' name='[PP Total Orders (Category) (copy)_3793790151022862339]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({EXCLUDE  [supplier_name], [brand_name], [product_name]: &#10;SUM(IF [Calculation_5269704190573768709] &gt;= [Parameters].[CP Start Date (copy)_5269704190572032001] AND [Calculation_5269704190573768709] &lt;= [Parameters].[CP End Date (copy)_5269704190572023808] THEN [orders] END)})' />
