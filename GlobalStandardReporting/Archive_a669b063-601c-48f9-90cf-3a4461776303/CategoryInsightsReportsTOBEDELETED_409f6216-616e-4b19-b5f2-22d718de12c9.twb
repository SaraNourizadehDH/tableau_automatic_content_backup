      </column>
      <column caption='CP Basket Penetration %' datatype='real' name='[Calculation_854558044971216934]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE  [Calculation_854558044971012130]&#13;&#10;    WHEN  1&#13;&#10;    THEN&#13;&#10;    ZN(SUM([Calculation_854558044971126820])/SUM([Calculation_854558044971171877]))&#13;&#10;    ELSE&#13;&#10;    ZN(SUM([Calculation_854558044971081763])/SUM([Calculation_854558044971171877]))&#13;&#10;END' />
