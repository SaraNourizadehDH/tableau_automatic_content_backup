      <column caption='Listed SKU per warehouse subcat fixed' datatype='real' name='[Calculation_1727974890608832524]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [global_entity_id],[warehouse_name],[category_parent_english], [category_english], [stock_date]: &#13;&#10;Avg(IF ([Calculation_5269704190573768709] &gt;= [Parameters].[Parameter 1] AND [Calculation_5269704190573768709] &lt;= [Parameters].[Parameter 2])&#13;&#10; THEN [listed_sku_count_per_warehouse] END)}' />
      </column>
      <column caption='Avg Listed SKU count per warehouse (Category)' datatype='real' name='[Calculation_1727974890608926733]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Calculation_1727974890607063047]&#13;&#10;    when 1 then [Calculation_1727974890609041422]&#13;&#10;    else [Calculation_1727974890608631819] end' />
      </column>
      <column caption='Avg Listed Sku count per warehouse (Country)' datatype='real' name='[Calculation_1727974890609041422]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn(sum([Calculation_1727974890608832524])/[Calculation_1727974890606866437])' />
