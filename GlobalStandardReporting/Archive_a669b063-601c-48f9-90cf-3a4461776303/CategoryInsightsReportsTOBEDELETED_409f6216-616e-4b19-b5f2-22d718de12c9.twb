              <calculation class='tableau' formula='AVG({FIXED [region], [global_entity_id], [Calculation_5269704190573768709]:AVG(&#10;&#10;{FIXED [region], [global_entity_id], [category_parent_english], [category_english], [warehouse_name], [sku], [Calculation_5269704190573768709]: AVG(IF [Calculation_5269704190573768709] &gt;= [Parameters].[CP Start Date (copy)_5269704190572032001] &#10;AND [Calculation_5269704190573768709] &lt;= [Parameters].[CP End Date (copy)_5269704190572023808] THEN&#10;[avg_units_per_basket] END)})})' />
            </column>
            <column caption='CP Products Sold (Category) ' datatype='integer' name='[CP Active Products (Category) (copy)_5269704190613999657]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [Calculation_5269704190573768709] &gt;= [Parameters].[Parameter 1] AND [Calculation_5269704190573768709] &lt;= [Parameters].[Parameter 2] THEN [product_id_sold] END)' />
