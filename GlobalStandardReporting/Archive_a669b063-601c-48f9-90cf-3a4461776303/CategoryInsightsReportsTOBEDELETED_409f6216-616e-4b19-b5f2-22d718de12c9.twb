              <calculation class='tableau' formula='ZN(([CP Net Retail Revenue (copy)_5269704190572191746] / [PP Net Retail Revenue (copy)_5269704190572453891]) - 1)' />
            </column>
            <column caption='% Change Customers (Country) ' datatype='real' name='[% Change Orders (Category) (copy)_1189161456056619036]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN((SUM([Calculation_1189161456055918618]) / SUM([CP Total Customers (Category) (copy)_1189161456056221723])) - 1)' />
            </column>
            <column caption='% Change in AVG Units Per Basket' datatype='real' default-format='p0.0%' name='[% Change in AVG Sales Price (Category) (copy)_4706402399026241551]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(([Calculation_4706402399023345677] / [CP AVG Units Per Basket (copy)_4706402399026069518]) - 1)' />
            </column>
            <column caption='% Change in ABV (Category)' datatype='real' name='[% Change in Quantity Sold (copy)_1189161454754701328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1189161454753685516] / [Calculation_1189161454754459662]) - 1' />
