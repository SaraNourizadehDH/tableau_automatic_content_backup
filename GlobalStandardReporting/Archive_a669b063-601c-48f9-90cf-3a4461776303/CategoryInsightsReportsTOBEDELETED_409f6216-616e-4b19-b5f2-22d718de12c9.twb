      <column caption='CP All Orders Per Country Category Fixed' datatype='real' name='[Calculation_854558044971081763]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [global_entity_id], [warehouse_id_selling], [category_parent_english], [stock_date]: &#13;&#10;Avg(IF ([Calculation_6160924302408085527] &gt;= [Parameters].[Parameter 1] AND [Calculation_6160924302408085527] &lt;= [Parameters].[Parameter 2]&#13;&#10;AND NOT ISNULL([warehouse_id_selling]))&#13;&#10; THEN [orders_per_warehouse_cat] END)}' />
      </column>
      <column caption='CP All Orders Per Country SubCategory Fixed' datatype='real' name='[Calculation_854558044971126820]' role='measure' type='quantitative'>
