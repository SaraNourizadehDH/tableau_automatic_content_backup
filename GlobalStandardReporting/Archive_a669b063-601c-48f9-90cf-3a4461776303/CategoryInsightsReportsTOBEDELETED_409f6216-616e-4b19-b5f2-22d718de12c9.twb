            <column caption='Avg Listed Sku count per entity (Country)' datatype='real' name='[Calculation_1727974891207327786]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  ([Calculation_1727974890607378442] = 1 and AVG([Calculation_1727974891221127214] )&gt; 1)&#13;&#10;     then NULL&#13;&#10;ELSE zn(sum([Calculation_1727974891207180328])/sum([Calculation_1727974891207098407])) END' />
