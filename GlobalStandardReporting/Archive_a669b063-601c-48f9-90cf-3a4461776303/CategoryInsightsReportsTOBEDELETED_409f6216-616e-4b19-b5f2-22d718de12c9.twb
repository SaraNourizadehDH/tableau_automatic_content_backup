            </column>
            <column caption='CP SKU Unit Velocity (Weekly)' datatype='real' name='[Calculation_5269704190619054127]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// qty sold / products sold / warehouses selling / weeks &#10;&#10;[CP Net Retail Revenue (Category) (copy)_5269704190575751177] &#10;/ [CP Active Products (Category) (copy)_5269704190613999657] &#10;/ [CP Active Products (Category) (copy)_5269704190619787312]&#10;/ (IF AVG(DATEDIFF(&apos;week&apos;, [Parameters].[Parameter 1], [Parameters].[Parameter 2])) = 0 THEN 1 &#10;ELSE AVG(DATEDIFF(&apos;week&apos;, [Parameters].[Parameter 1], [Parameters].[Parameter 2]))  END)' />
