              <calculation class='tableau' formula='{ FIXED [global_entity_id], [warehouse_id_selling], [category_parent_english], [stock_date]: &#13;&#10;Avg(IF ([Calculation_5269704190573768709] &gt;= [Parameters].[Parameter 1] AND [Calculation_5269704190573768709] &lt;= [Parameters].[Parameter 2]&#13;&#10;AND NOT ISNULL([warehouse_id_selling]))&#13;&#10; THEN [orders_per_warehouse_cat] END)}' />
            </column>
            <column caption='PP All Orders Per Country Category Fixed' datatype='real' name='[CP All Orders Per Country Category Fixed (copy)_854558044958740489]' role='measure' type='quantitative'>
