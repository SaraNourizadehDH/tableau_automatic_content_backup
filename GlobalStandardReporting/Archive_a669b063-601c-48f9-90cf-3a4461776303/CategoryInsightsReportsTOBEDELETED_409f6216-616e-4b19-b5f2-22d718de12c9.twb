            </column>
            <column caption='% Change Front Margin %' datatype='real' name='[% Change Front Margin (copy)_6160924302623166531]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Front Margin % (copy)_6160924302598889512] - [Selected Period Front Margin %  (copy)_6160924302601674796])' />
            </column>
            <column caption='% Change Orders (Category)' datatype='real' name='[% Change Net Retail Revenue (Category) (copy)_1189161454550519810]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN((SUM([CP Quantity Sold (Category) (copy)_1189161454550126592]) / SUM([PP COGS (Category)  (copy)_1189161454550392833])) - 1)' />
            </column>
            <column caption='% Change Products Sold (Category) ' datatype='real' name='[% Change Net Retail Revenue (Category) (copy)_5269704190618177582]' role='measure' type='quantitative'>
