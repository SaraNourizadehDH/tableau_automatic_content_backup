    <dashboard name='Metric Definition'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/CategoryInsightsReports/MetricDefinition?rev=' id='MetricDefinition' path='/t/GlobalStandardReporting/workbooks/CategoryInsightsReports' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='800' maxwidth='1100' minheight='800' minwidth='1100' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='98000' id='3' type-v2='text' w='98546' x='727' y='1000'>
            <formatted-text>
              <run bold='true' fontname='Tableau Light'>CP </run>
              <run fontname='Tableau Light'>- Current (Selected) Period. Defined by Start and End Date Parameters on dashboard.</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontname='Tableau Light'>Metric vs Budget % - </run>
              <run fontname='Tableau Light'>Available for some metrics where budget numbers are provided. As budget numbers are on monthly level for </run>
              <run bold='true' fontname='Tableau Light'>orders</run>
              <run fontname='Tableau Light'> and </run>
              <run bold='true' fontname='Tableau Light'>net retail value </run>
              <run fontname='Tableau Light'>we split the number between the days of the month and sum for the period of days selected. For </run>
              <run bold='true' fontname='Tableau Light'>ABV</run>
              <run fontname='Tableau Light'> we take the monthly value as it is an average.</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontname='Tableau Light'>Orders</run>
              <run fontname='Tableau Light'> - Number of successful orders</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontname='Tableau Light'>Net Retail Value -</run>
              <run fontname='Tableau Light'> Revenue collected only from the sale of goods to the customer (Net of VAT). This does not include any vouchers or delivery fees.</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontname='Tableau Light'>ABV - </run>
              <run fontname='Tableau Light'>Average value of the customer&apos;s basket</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontname='Tableau Light'>ASP( Average sales Price) </run>
              <run fontname='Tableau Light'>- Net Retail Value / # Units</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontname='Tableau Light'>Customers</run>
              <run fontname='Tableau Light'> - Number of distinct customers who made an order in the selected period</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontname='Tableau Light'>COGS - </run>
              <run fontname='Tableau Light'>Costs associated with the sale of goods. In this case calculated as the WAC x quantity (</run>
              <run bold='true' fontname='Tableau Light'>weighted average cost of the product at the time of sale</run>
              <run fontname='Tableau Light'> x</run>
              <run bold='true' fontname='Tableau Light'> quantity sold)</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontname='Tableau Light'>Front Margin %</run>
              <run fontname='Tableau Light'> - Margin from sale of goods (net of vouchers), expressed as a percentage of retail revenue</run>
              <run fontname='Tableau Light' italic='true'>.  (Net retail revenue - COGS) / (Net retail revenue)</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontname='Tableau Light'>PPP % - </run>
              <run fontname='Tableau Light' italic='true'>(Net retail revenue - COGS + Supplier Funding) / (Net retail revenue)</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontname='Tableau Light'>AVG Listed SKU per warehouse</run>
              <run fontname='Tableau Light'>- AVG SKUs listed per warehouse, where </run>
              <run bold='true' fontname='Tableau Light'>listed </run>
              <run fontname='Tableau Light'>is defined as </run>
              <run fontname='Tableau Light' italic='true'>active, stock movement in last 30 days and has an open Purchase Order</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontname='Tableau Light'>AVG SKU Sold per Store </run>
              <run fontname='Tableau Light'>- AVG daily SKUs sold per warehouse.</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontname='Tableau Light'>Quantity Sold</run>
              <run fontname='Tableau Light'> - Number of units sold per dimension.</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontname='Tableau Light'>AVG Units per Basket - </run>
              <run fontname='Tableau Light'>how many units on avg did customers order per basket</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontname='Tableau Light'>Active SKUs - </run>
              <run fontname='Tableau Light'>Number of listed SKUs as of last refresh of data. No historic data available from catalog.</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontname='Tableau Light'>Basket Penetration </run>
              <run fontname='Tableau Light'>- number of category&apos;s (subcategory&apos;s) orders / Total Orders for country/ warehouse.</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontname='Tableau Light'>Availability</run>
              <run fontname='Tableau Light'>  -  (Number of SKUs available / Number of total SKUs)</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontname='Tableau Light'>Rate of Sale - </run>
              <run fontname='Tableau Light'>units sold / # stores stocking </run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontname='Tableau Light'>Promotional participation</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Light'> - </run>
              <run fontname='Tableau Light'>Units sold on promotion/units sold by list price</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontname='Tableau Light'>Supplier Funding - </run>
              <run fontname='Tableau Light'>funding of promotional discounts by the supplier</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontname='Tableau Light'>Shrinkage % </run>
              <run fontname='Tableau Light'>- Shrinkage as % of Sales</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontname='Tableau Light'>SKU Velocity</run>
              <run fontname='Tableau Light'> - units sold per SKU per store per week</run>
              <run>Æ&#10;&#10;&#10;&#10;&#10;&#10;&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='298' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='84000' id='297' param='vert' type-v2='layout-flow' w='84000' x='8000' y='8000'>
                <zone forceUpdate='true' h='98000' id='3' type-v2='text' w='98546' x='727' y='1000'>
                  <formatted-text>
                    <run bold='true' fontname='Tableau Light'>CP </run>
                    <run fontname='Tableau Light'>- Current (Selected) Period. Defined by Start and End Date Parameters on dashboard.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontname='Tableau Light'>Metric vs Budget % - </run>
                    <run fontname='Tableau Light'>Available for some metrics where budget numbers are provided. As budget numbers are on monthly level for </run>
                    <run bold='true' fontname='Tableau Light'>orders</run>
                    <run fontname='Tableau Light'> and </run>
                    <run bold='true' fontname='Tableau Light'>net retail value </run>
                    <run fontname='Tableau Light'>we split the number between the days of the month and sum for the period of days selected. For </run>
                    <run bold='true' fontname='Tableau Light'>ABV</run>
                    <run fontname='Tableau Light'> we take the monthly value as it is an average.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontname='Tableau Light'>Orders</run>
                    <run fontname='Tableau Light'> - Number of successful orders</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontname='Tableau Light'>Net Retail Value -</run>
                    <run fontname='Tableau Light'> Revenue collected only from the sale of goods to the customer (Net of VAT). This does not include any vouchers or delivery fees.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontname='Tableau Light'>ABV - </run>
                    <run fontname='Tableau Light'>Average value of the customer&apos;s basket</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontname='Tableau Light'>ASP( Average sales Price) </run>
                    <run fontname='Tableau Light'>- Net Retail Value / # Units</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontname='Tableau Light'>Customers</run>
                    <run fontname='Tableau Light'> - Number of distinct customers who made an order in the selected period</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontname='Tableau Light'>COGS - </run>
                    <run fontname='Tableau Light'>Costs associated with the sale of goods. In this case calculated as the WAC x quantity (</run>
                    <run bold='true' fontname='Tableau Light'>weighted average cost of the product at the time of sale</run>
                    <run fontname='Tableau Light'> x</run>
                    <run bold='true' fontname='Tableau Light'> quantity sold)</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontname='Tableau Light'>Front Margin %</run>
                    <run fontname='Tableau Light'> - Margin from sale of goods (net of vouchers), expressed as a percentage of retail revenue</run>
                    <run fontname='Tableau Light' italic='true'>.  (Net retail revenue - COGS) / (Net retail revenue)</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontname='Tableau Light'>PPP % - </run>
                    <run fontname='Tableau Light' italic='true'>(Net retail revenue - COGS + Supplier Funding) / (Net retail revenue)</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontname='Tableau Light'>AVG Listed SKU per warehouse</run>
                    <run fontname='Tableau Light'>- AVG SKUs listed per warehouse, where </run>
                    <run bold='true' fontname='Tableau Light'>listed </run>
                    <run fontname='Tableau Light'>is defined as </run>
                    <run fontname='Tableau Light' italic='true'>active, stock movement in last 30 days and has an open Purchase Order</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontname='Tableau Light'>AVG SKU Sold per Store </run>
                    <run fontname='Tableau Light'>- AVG daily SKUs sold per warehouse.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontname='Tableau Light'>Quantity Sold</run>
                    <run fontname='Tableau Light'> - Number of units sold per dimension.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontname='Tableau Light'>AVG Units per Basket - </run>
                    <run fontname='Tableau Light'>how many units on avg did customers order per basket</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontname='Tableau Light'>Active SKUs - </run>
                    <run fontname='Tableau Light'>Number of listed SKUs as of last refresh of data. No historic data available from catalog.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontname='Tableau Light'>Basket Penetration </run>
                    <run fontname='Tableau Light'>- number of category&apos;s (subcategory&apos;s) orders / Total Orders for country/ warehouse.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontname='Tableau Light'>Availability</run>
                    <run fontname='Tableau Light'>  -  (Number of SKUs available / Number of total SKUs)</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontname='Tableau Light'>Rate of Sale - </run>
                    <run fontname='Tableau Light'>units sold / # stores stocking </run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontname='Tableau Light'>Promotional participation</run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Light'> - </run>
                    <run fontname='Tableau Light'>Units sold on promotion/units sold by list price</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontname='Tableau Light'>Supplier Funding - </run>
                    <run fontname='Tableau Light'>funding of promotional discounts by the supplier</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontname='Tableau Light'>Shrinkage % </run>
                    <run fontname='Tableau Light'>- Shrinkage as % of Sales</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontname='Tableau Light'>SKU Velocity</run>
                    <run fontname='Tableau Light'> - units sold per SKU per store per week</run>
                    <run>Æ&#10;&#10;&#10;&#10;&#10;&#10;&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
      <simple-id uuid='{CB2210BC-9B27-4C0E-99CD-9A015FF637B7}' />
    </dashboard>
