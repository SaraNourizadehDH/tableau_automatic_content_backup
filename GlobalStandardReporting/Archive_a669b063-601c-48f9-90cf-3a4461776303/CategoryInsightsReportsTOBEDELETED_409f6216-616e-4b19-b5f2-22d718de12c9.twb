    <worksheet name='Current Period SKU Level APAC'>
      <table>
        <view>
          <datasources>
            <datasource caption='SKU Level APAC' name='federated.0ml98eq0rv4v8i1ckkalg0pshoxb' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Weekly' caption='Date Level (SKU)' datatype='string' name='[Date Level (copy)_6516427220856385536]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
              <calculation class='tableau' formula='&quot;week&quot;' />
              <aliases>
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;quarter&quot;' value='Quarterly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
            <column caption='Currency' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;EUR&quot;'>
              <calculation class='tableau' formula='&quot;EUR&quot;' />
            </column>
            <column alias='Weekly' caption='Date Level' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
              <calculation class='tableau' formula='&quot;week&quot;' />
              <aliases>
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;quarter&quot;' value='Quarterly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
            <column caption='Select How Many Periods' datatype='integer' name='[Parameter 7]' param-domain-type='any' role='measure' type='quantitative' value='3'>
              <calculation class='tableau' formula='3' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ml98eq0rv4v8i1ckkalg0pshoxb'>
            <column caption='% Change Front Margin' datatype='real' name='[% Change Basket Penetration (copy)_6160924302623023170]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(([Front (net) Margin (copy)_6160924302598246439] / [Selected Period Front (net) Margin (copy)_6160924302601953326])-1)' />
            </column>
            <column caption='% Change Shrinkage' datatype='real' name='[% Change Front Margin % (copy)_6160924302623260740]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(([Selected Period COGS (copy)_6160924302604718131] / [Selected Period Shrinkage (copy)_6160924302604812340]) - 1)' />
            </column>
            <column caption='% Change Shrinkage(%)' datatype='real' name='[% Change Front Margin % (copy)_6160924302623379525]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(([Calculation_6160924302605664309] / [Selected Period Shrink % (copy)_6160924302608547897]) - 1)' />
            </column>
            <column caption='% Change Supplier Funding' datatype='real' name='[% Change Front Margin (copy)_4706402399037288469]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(([CP Front (net) Margin (copy)_4706402399036313616] /  [CP Supplier Funding (copy)_4706402399036694546])-1)' />
            </column>
            <column caption='% Change Front Margin %' datatype='real' name='[% Change Front Margin (copy)_6160924302623166531]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Front Margin % (copy)_6160924302598889512] - [Selected Period Front Margin %  (copy)_6160924302601674796])' />
            </column>
            <column caption='% Change Basket Penetration' datatype='real' name='[% Change Promotional Participation (copy)_6160924302622879809]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(([Basket Penetration (copy)_6160924302597959718]) - ( [Selected Period Basket Penetration (copy)_6160924302601969711]))' />
            </column>
            <column caption='% Change Promotional Participation' datatype='real' name='[% Change Rate of Sale (copy)_6160924302621728832]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Promotional participation (copy)_6160924302597660709] - [Selected Period Promotional Participation (copy)_6160924302601539627])' />
            </column>
            <column caption='% Change Units' datatype='real' name='[% Change Sales/ GMV (copy)_6160924302621102141]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(([Selected Period COGS (copy) (copy)_6160924302591893534] / [Selected Period Units (copy)_6160924302599209001]) - 1)' />
            </column>
            <column caption='% Change PPP' datatype='real' name='[% Change Supplier Funding (copy)_4706402399038631958]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(([CP Supplier Funding (copy)_4706402399036911635] /  [CP PPP (copy)_4706402399037116436])-1)' />
            </column>
            <column caption='% Change Availability' datatype='real' name='[% Change Units (copy)_6160924302621241406]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Selected Period COGS (copy)_6160924302592356383] - [Selected Period Availability (copy)_6160924302601977904])' />
            </column>
            <column caption='% Change Rate of Sale' datatype='real' name='[% Change Units (copy)_6160924302621515839]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(([Rate of Sale (copy)_6160924302593490976] / [Selected Period Rate of Sale (copy)_6160924302601396266]) - 1)' />
            </column>
            <column caption='CP Basket Penetration' datatype='real' default-format='p0.00%' name='[Basket Penetration (copy)_6160924302597959718]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM(IF [Calculation_6160924302585344026] = TRUE THEN [orders] END) /&#10; SUM(IF [Calculation_6160924302585344026] = TRUE THEN [Calculation_6160924302380400655] END))' />
            </column>
            <column caption='CP Supplier Funding' datatype='real' name='[CP Front (net) Margin (copy)_4706402399036313616]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM(IF [Calculation_6160924302585344026] = TRUE THEN [PPP (copy)_4706402399014645769] END))' />
            </column>
            <column caption='PP PPP' datatype='real' name='[CP PPP (copy)_4706402399037116436]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Selected Period Sales/ GMV (copy)_6160924302595874851] - [Selected Period COGS (copy)_6160924302601711661] + [CP Supplier Funding (copy)_4706402399036694546])' />
            </column>
            <column caption='PP Supplier Funding' datatype='real' name='[CP Supplier Funding (copy)_4706402399036694546]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM(IF [Calculation_6160924302595285026] = TRUE THEN [PPP (copy)_4706402399014645769] END))' />
            </column>
            <column caption='CP PPP' datatype='real' name='[CP Supplier Funding (copy)_4706402399036911635]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Selected Period COGS (copy)_6160924302591688733] - [Calculation_6160924302591389724] + [CP Front (net) Margin (copy)_4706402399036313616])' />
            </column>
            <column caption='CP PPP %' datatype='real' default-format='p0.00%' name='[Calculation_4706402399038783511]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([CP Supplier Funding (copy)_4706402399036911635] / [Selected Period COGS (copy)_6160924302591688733])' />
            </column>
            <column caption='PP PPP% ' datatype='real' name='[Calculation_4706402399039021080]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([CP PPP (copy)_4706402399037116436] / [Selected Period Sales/ GMV (copy)_6160924302595874851])' />
            </column>
            <column caption='% Change PPP% ' datatype='real' name='[Calculation_4706402399039119385]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Calculation_4706402399038783511] - [Calculation_4706402399039021080])' />
            </column>
            <column caption='Unit Cost' datatype='real' name='[Calculation_6160924302098034688]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;EUR&apos; THEN [unit_cost_eur]&#10;WHEN &apos;Local&apos; THEN [unit_cost_lc]&#10;END' />
            </column>
            <column caption='Unit Price Listed' datatype='real' name='[Calculation_6160924302098333697]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;EUR&apos; THEN [unit_price_listed_eur]&#10;WHEN &apos;Local&apos; THEN [unit_price_listed_lc]&#10;END' />
            </column>
            <column caption='Selling Price' datatype='real' name='[Calculation_6160924302098726914]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;EUR&apos; THEN [average_selling_price_eur]&#10;WHEN &apos;Local&apos; THEN [average_selling_price_lc]&#10;END' />
            </column>
            <column caption='Only Full Week' datatype='boolean' name='[Calculation_6160924302376464394]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[stock_date] &lt;= DATEADD(&apos;week&apos;, -1, TODAY())' />
            </column>
            <column caption='Total Orders' datatype='integer' name='[Calculation_6160924302380400655]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED  [global_entity_id], [stock_date]: SUM([orders])}' />
            </column>
            <column caption='COGS' datatype='real' name='[Calculation_6160924302405914642]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN((CASE [Parameters].[Parameter 3]&#10;WHEN &apos;EUR&apos; THEN [cogs_eur]&#10;WHEN &apos;Local&apos; THEN [cogs_lc]&#10;END))' />
            </column>
            <column caption='Net Retail Revenue' datatype='real' name='[Calculation_6160924302406176787]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN((CASE [Parameters].[Parameter 3]&#10;WHEN &apos;EUR&apos; THEN [total_price_paid_net_eur]&#10;WHEN &apos;Local&apos; THEN [total_price_paid_net_lc]&#10;END))' />
            </column>
            <column caption='Units' datatype='real' name='[Calculation_6160924302409244696]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(([qty_sold]))' />
            </column>
            <column caption='Date Limitation' datatype='boolean' name='[Calculation_6160924302585344026]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[stock_date] &gt;= DATEADD([Parameters].[Parameter 5],-([Parameters].[Parameter 7]), DATETRUNC([Parameters].[Parameter 5],TODAY()))&#10;&#10;AND [stock_date] &lt; DATETRUNC([Parameters].[Parameter 5], TODAY()) - 1' />
            </column>
            <column caption='CP COGS' datatype='real' name='[Calculation_6160924302591389724]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_6160924302585344026] = True THEN [Calculation_6160924302405914642] END)' />
            </column>
            <column caption='Status' datatype='string' name='[Calculation_6160924302594248737]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_active] = TRUE THEN &apos;Active&apos; &#10;ELSE &apos;Inactive&apos;&#10;END' />
            </column>
            <column caption='Previous Period Filter' datatype='boolean' name='[Calculation_6160924302595285026]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[stock_date] &lt; DATEADD([Parameters].[Parameter 5],-([Parameters].[Parameter 7]), DATETRUNC([Parameters].[Parameter 5],TODAY())) - 1&#10;&#10;AND [stock_date] &gt;= DATEADD([Parameters].[Parameter 5], -2 * [Parameters].[Parameter 7], DATETRUNC([Parameters].[Parameter 5], TODAY()))' />
            </column>
            <column caption='CP Shrink %' datatype='real' name='[Calculation_6160924302605664309]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//Shrink as % of sales&#10;ZN([Selected Period COGS (copy)_6160924302604718131] / [Selected Period COGS (copy)_6160924302591688733])' />
            </column>
            <column caption='% Change Net Retail Revenue' datatype='real' name='[Calculation_6160924302620860476]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(([Selected Period COGS (copy)_6160924302591688733] / [Selected Period Sales/ GMV (copy)_6160924302595874851]) - 1)' />
            </column>
            <column caption='Days in Range' datatype='integer' name='[Calculation_6516427220858531841]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IF [Parameters].[Date Level (copy)_6516427220856385536] = &apos;week&apos; THEN [Parameters].[Parameter 7] * 7 &#10;   ELSEIF [Parameters].[Date Level (copy)_6516427220856385536] = &apos;month&apos; THEN [Parameters].[Parameter 7] * 30&#10;   ELSEIF [Parameters].[Date Level (copy)_6516427220856385536] = &apos;quarter&apos; THEN [Parameters].[Parameter 7] * 90&#10;   END)' />
            </column>
            <column caption='SKU Age' datatype='integer' name='[Calculation_6929984329384951831]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;week&apos;, &#10;{FIXED [global_entity_id], [sku]: MIN([product_created_at])}, TODAY())' />
            </column>
            <column caption='CP Front (net) Margin' datatype='real' name='[Front (net) Margin (copy)_6160924302598246439]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM(IF [Calculation_6160924302585344026] = TRUE THEN [Calculation_6160924302406176787] END) &#10;- [Calculation_6160924302591389724])' />
            </column>
            <column caption='CP Front Margin % ' datatype='real' name='[Front Margin % (copy)_6160924302598889512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN((SUM(IF [Calculation_6160924302585344026] = TRUE THEN [Calculation_6160924302406176787] END) - [Calculation_6160924302591389724]) &#10;/(SUM(IF [Calculation_6160924302585344026] = TRUE THEN [Calculation_6160924302406176787] END)))' />
            </column>
            <column caption='Shrinkage ' datatype='real' name='[Net Retail Revenue (copy)_6160924302604517426]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN((CASE [Parameters].[Parameter 3]&#10;WHEN &apos;EUR&apos; THEN [shrinkage_amt_eur]&#10;WHEN &apos;Local&apos; THEN [shrinkage_amt_lc]&#10;END))' />
            </column>
            <column caption='Supplier Funding' datatype='real' name='[PPP (copy)_4706402399014645769]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN((CASE [Parameters].[Parameter 3]&#10;WHEN &apos;EUR&apos; THEN [total_supplier_funding_eur]&#10;WHEN &apos;Local&apos; THEN [total_supplier_funding_lc]&#10;END))' />
            </column>
            <column caption='CP Promotional Participation' datatype='real' name='[Promotional participation (copy)_6160924302597660709]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//Units sold on promotion/units sold by list price&#10;&#10;ZN(SUM(IF [Calculation_6160924302585344026] = TRUE THEN [units_with_discount] END) /&#10; &#10;(SUM(IF [Calculation_6160924302585344026] = TRUE THEN [units_without_discount] END) &#10;+ SUM(IF [Calculation_6160924302585344026] = TRUE THEN [units_with_discount] END)))' />
            </column>
            <column caption='CP Rate of Sale' datatype='real' name='[Rate of Sale (copy)_6160924302593490976]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM(IF [Calculation_6160924302585344026] = TRUE THEN [qty_sold] END) / COUNTD(IF [Calculation_6160924302585344026] = TRUE THEN [warehouse_id_selling] END)&#10;/ AVG([Calculation_6516427220858531841])&#10;)' />
            </column>
            <column caption='PP Availability' datatype='real' name='[Selected Period Availability (copy)_6160924302601977904]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_6160924302595285026] = TRUE THEN [available_instances] END) / &#10;SUM(IF [Calculation_6160924302595285026] = TRUE THEN [total_instances] END)' />
            </column>
            <column caption='PP Basket Penetration' datatype='real' name='[Selected Period Basket Penetration (copy)_6160924302601969711]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM(IF [Calculation_6160924302595285026] = TRUE THEN [orders] END) /&#10; SUM(IF [Calculation_6160924302595285026] = TRUE THEN [Calculation_6160924302380400655] END))' />
            </column>
            <column caption='CP Units' datatype='real' name='[Selected Period COGS (copy) (copy)_6160924302591893534]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_6160924302585344026] = True THEN [Calculation_6160924302409244696] END)' />
            </column>
            <column caption='CP Net Retail Revenue' datatype='real' name='[Selected Period COGS (copy)_6160924302591688733]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_6160924302585344026] = True THEN [Calculation_6160924302406176787] END)' />
            </column>
            <column caption='CP Availability' datatype='real' name='[Selected Period COGS (copy)_6160924302592356383]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_6160924302585344026] = TRUE THEN [available_instances] END) / &#10;SUM(IF [Calculation_6160924302585344026] = TRUE THEN [total_instances] END)' />
            </column>
            <column caption='PP COGS' datatype='real' name='[Selected Period COGS (copy)_6160924302601711661]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_6160924302595285026] = True THEN [Calculation_6160924302405914642] END)' />
            </column>
            <column caption='CP Shrinkage' datatype='real' name='[Selected Period COGS (copy)_6160924302604718131]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_6160924302585344026] = True THEN [Net Retail Revenue (copy)_6160924302604517426] END)' />
            </column>
            <column caption='CP Stores Selling' datatype='integer' name='[Selected Period COGS (copy)_6160924307227500652]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(COUNTD(IF [Calculation_6160924302585344026] = True THEN [warehouse_id_selling] END))' />
            </column>
            <column caption='PP Front (net) Margin' datatype='real' name='[Selected Period Front (net) Margin (copy)_6160924302601953326]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM(IF [Calculation_6160924302595285026] = TRUE THEN [Calculation_6160924302406176787] END) &#10;- [Selected Period COGS (copy)_6160924302601711661])' />
            </column>
            <column caption='PP Front Margin % ' datatype='real' name='[Selected Period Front Margin %  (copy)_6160924302601674796]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN((SUM(IF [Calculation_6160924302595285026] = TRUE THEN [Calculation_6160924302406176787] END) - [Selected Period COGS (copy)_6160924302601711661]) &#10;/SUM(IF [Calculation_6160924302595285026] = TRUE THEN [Calculation_6160924302406176787] END))' />
            </column>
            <column caption='PP Promotional Participation' datatype='real' name='[Selected Period Promotional Participation (copy)_6160924302601539627]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//Units sold on promotion/units sold by list price&#10;&#10;ZN(&#10;SUM(IF [Calculation_6160924302595285026] = TRUE THEN [units_with_discount] END) /&#10;(SUM(IF [Calculation_6160924302595285026] = TRUE THEN [units_without_discount] END) + &#10;SUM(IF [Calculation_6160924302595285026] = TRUE THEN [units_with_discount] END))&#10;)' />
