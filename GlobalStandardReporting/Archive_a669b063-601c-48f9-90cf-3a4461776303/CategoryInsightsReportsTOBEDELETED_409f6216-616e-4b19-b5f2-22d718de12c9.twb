          <datasource-dependencies datasource='federated.04tyedl0wi3hfs11pht9u0ta4799'>
            <column caption='% Change PPP % (Category)' datatype='real' name='[% Change Front Margin % (Category) (copy)_4706402398881501190]' role='measure' type='quantitative'>
