        <calculation class='tableau' formula='AVG({FIXED [region], [global_entity_id], [Calculation_6160924302408085527]:AVG(&#10;&#10;{FIXED [region], [global_entity_id], [category_parent_english], [category_english], [warehouse_name], [sku], [Calculation_6160924302408085527]: AVG(IF [Calculation_6160924302408085527] &gt;= [Parameters].[Parameter 1] &#10;AND [Calculation_6160924302408085527] &lt;= [Parameters].[Parameter 2] THEN&#10;[avg_units_per_basket] END)})})' />
      </column>
      <column caption='CP PPP %' datatype='real' name='[Calculation_4706402399038783511]' role='measure' type='quantitative'>
