          <datasource-dependencies datasource='federated.0tmy4vj0f2pwiv11cranq0yn2kha'>
            <column caption='Budget ABV' datatype='real' name='[Budget Orders (copy)_2096566370863845409]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({FIXED [global_entity_id], DATETRUNC(&apos;month&apos;, [order_date]): AVG(&#10;&#10;{FIXED [global_entity_id], [order_date]: AVG(IF [Calculation_2096566370773766153] = True THEN [Calculation_2096566370855448600] END)})})' />
            </column>
            <column caption='Days In Range' datatype='integer' name='[Calculation_2096566370773192712]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[Parameters].[Parameter 1],[Parameters].[Parameter 2] +1)' />
            </column>
            <column caption='Date Filter CP' datatype='boolean' name='[Calculation_2096566370773766153]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[order_date] &gt;= [Parameters].[Parameter 1] AND [order_date] &lt;= [Parameters].[Parameter 2]' />
            </column>
            <column caption='Date Filter PP' datatype='boolean' name='[Calculation_2096566370773889034]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[order_date] &gt;= [Parameters].[Parameter 1] -  [Calculation_2096566370773192712]&#10;AND [order_date] &lt;= [Parameters].[Parameter 2] - [Calculation_2096566370773192712]' />
            </column>
            <column caption='Date Equalizer' datatype='date' name='[Calculation_2096566370774208523]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Calculation_2096566370773766153] = True THEN [order_date]&#10;ELSEIF [Calculation_2096566370773889034] = True THEN [order_date] + [Calculation_2096566370773192712]&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Average Basket Value' datatype='real' name='[Calculation_2096566370855108631]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;EUR&apos; THEN [average_basket_value_eur]&#10;WHEN &apos;Local&apos; THEN [average_basket_value_lc]&#10;END' />
            </column>
            <column caption='Budget ABV Per Period' datatype='real' name='[Calculation_2096566370855448600]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;EUR&apos; THEN [abv_budget_per_period_eur]&#10;WHEN &apos;Local&apos; THEN [abv_budget_per_period_lc]&#10;END' />
            </column>
            <column caption='Date*' datatype='date' name='[Calculation_2096566370922340396]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parameter 5], [Calculation_2096566370774208523]))' />
            </column>
            <column caption='Current Period ABV' datatype='real' name='[Current Period Orders (copy)_2096566370863071262]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF [Calculation_2096566370773766153] = True THEN [Calculation_2096566370855108631] END)' />
            </column>
            <column caption='Prior Period ABV' datatype='real' name='[Prior Period Net Retail Value (copy)_2096566370863435807]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF [Calculation_2096566370773889034] = True THEN [Calculation_2096566370855108631] END)' />
            </column>
            <column caption='Abv Budget Per Period Eur' datatype='real' name='[abv_budget_per_period_eur]' role='measure' type='quantitative' />
            <column caption='Abv Budget Per Period Lc' datatype='real' name='[abv_budget_per_period_lc]' role='measure' type='quantitative' />
