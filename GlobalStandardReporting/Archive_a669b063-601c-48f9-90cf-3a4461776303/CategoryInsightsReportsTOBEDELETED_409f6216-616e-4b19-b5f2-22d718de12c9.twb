          <datasource-dependencies datasource='federated.01unve11fp1a2915ldhu21i8dc4d'>
            <column caption='% Change PPP % (Category)' datatype='real' default-format='p0.0%' name='[% Change Front Margin % (Category) (copy)_4706402398881501190]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Calculation_4706402398881185796] - [CP PPP % (Category) (copy)_4706402398881386501])' />
            </column>
            <column caption='% Change Front Margin %' datatype='real' name='[% Change Front Margin (copy)_6160924302623166531]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Front Margin % (copy)_6160924302598889512] - [Selected Period Front Margin %  (copy)_6160924302601674796])' />
            </column>
            <column caption='% Change Orders (Category)' datatype='real' name='[% Change Net Retail Revenue (Category) (copy)_1189161454550519810]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN((SUM([CP Quantity Sold (Category) (copy)_1189161454550126592]) / SUM([PP COGS (Category)  (copy)_1189161454550392833])) - 1)' />
            </column>
            <column caption='% Change Products Sold (Category) ' datatype='real' name='[% Change Net Retail Revenue (Category) (copy)_5269704190618177582]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(([CP Active Products (Category) (copy)_5269704190613999657] / [CP Products Sold (Category)  (copy)_5269704190617002026]) - 1)' />
            </column>
            <column caption='% Change Net Retail Revenue (Category)' datatype='real' name='[% Change Net Retail Revenue (copy)_5269704190573207556]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(([CP Net Retail Revenue (copy)_5269704190572191746] / [PP Net Retail Revenue (copy)_5269704190572453891]) - 1)' />
            </column>
            <column caption='% Change Customers (Country) ' datatype='real' name='[% Change Orders (Category) (copy)_1189161456056619036]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN((SUM([Calculation_1189161456055918618]) / SUM([CP Total Customers (Category) (copy)_1189161456056221723])) - 1)' />
            </column>
            <column caption='% Change in AVG Units Per Basket' datatype='real' default-format='p0.0%' name='[% Change in AVG Sales Price (Category) (copy)_4706402399026241551]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(([Calculation_4706402399023345677] / [CP AVG Units Per Basket (copy)_4706402399026069518]) - 1)' />
            </column>
            <column caption='% Change in ABV (Category)' datatype='real' name='[% Change in Quantity Sold (copy)_1189161454754701328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1189161454753685516] / [Calculation_1189161454754459662]) - 1' />
            </column>
            <column caption='% ABV vs Budget' datatype='real' name='[% Orders vs Budget (copy)_1189161454755545107]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1189161454753685516]) / AVG([Budget Orders (copy)_1189161454755237906]) - 1' />
            </column>
            <column caption='Budget ABV' datatype='real' name='[Budget Orders (copy)_1189161454755237906]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [region], [global_entity_id], [Calculation_6160924302408085527]:AVG(&#10;&#10;{FIXED [region], [global_entity_id], [category_parent_english], [category_english], [warehouse_name], [sku], [Calculation_6160924302408085527]: AVG(IF [Calculation_6160924302408085527] &gt;= [Parameters].[Parameter 1] &#10;AND [Calculation_6160924302408085527] &lt;= [Parameters].[Parameter 2] THEN&#10;[Calculation_1189161454754988049] END)})}' />
            </column>
            <column caption='PP AVG Units Per Basket' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[CP AVG Units Per Basket (copy)_4706402399026069518]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({FIXED [region], [global_entity_id], [Calculation_6160924302408085527]:AVG(&#10;&#10;{FIXED [region], [global_entity_id], [category_parent_english], [category_english], [warehouse_name], [sku], [Calculation_6160924302408085527]: AVG(IF [Calculation_6160924302408085527] &gt;= [Parameters].[CP Start Date (copy)_5269704190572032001] &#10;AND [Calculation_6160924302408085527] &lt;= [Parameters].[CP End Date (copy)_5269704190572023808] THEN&#10;[avg_units_per_basket] END)})})' />
            </column>
            <column caption='CP Products Sold (Category) ' datatype='integer' name='[CP Active Products (Category) (copy)_5269704190613999657]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [Calculation_6160924302408085527] &gt;= [Parameters].[Parameter 1] AND [Calculation_6160924302408085527] &lt;= [Parameters].[Parameter 2] THEN [product_id_sold] END)' />
            </column>
            <column caption='CP Warehouses Selling (Category) ' datatype='integer' name='[CP Active Products (Category) (copy)_5269704190619787312]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [Calculation_6160924302408085527] &gt;= [Parameters].[Parameter 1] AND [Calculation_6160924302408085527] &lt;= [Parameters].[Parameter 2] THEN [warehouse_id_selling] END)' />
            </column>
            <column caption='PP PPP (Category) ' datatype='real' name='[CP Net PPP (Category)  (copy)_4706402398880546818]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[PP Net Retail Revenue (copy)_5269704190572453891] - [PP Net Retail Revenue (Category) (copy)_5269704190597193744] + [CP Supplier Funding (Category)  (copy)_4706402399020576780]' />
            </column>
            <column caption='CP Retail Revenue (Category) ' datatype='real' name='[CP Net Retail Revenue (Category) (copy)_1189161454753112075]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_6160924302408085527] &gt;= [Parameters].[Parameter 1] AND [Calculation_6160924302408085527] &lt;= [Parameters].[Parameter 2]&#10; THEN [Calculation_6197727152945995777] END)' />
            </column>
            <column caption='CP PPP (Category) ' datatype='real' name='[CP Net Retail Revenue (Category) (copy)_4706402398880280576]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[CP Net Retail Revenue (copy)_5269704190572191746] - [CP Net Retail Revenue (Category) (copy)_5269704190597079055] + [CP PPP (Category)  (copy)_4706402399014830090]' />
            </column>
            <column caption='CP Quantity Sold (Category)' datatype='real' name='[CP Net Retail Revenue (Category) (copy)_5269704190575751177]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_6160924302408085527] &gt;= [Parameters].[Parameter 1] AND [Calculation_6160924302408085527] &lt;= [Parameters].[Parameter 2]&#10; THEN [Calculation_6160924302409244696] END)' />
            </column>
            <column caption='CP AVG Sales Price (Category)' datatype='real' name='[CP Net Retail Revenue (Category) (copy)_5269704190576906252]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([CP Net Retail Revenue (copy)_5269704190572191746]/[CP Net Retail Revenue (Category) (copy)_5269704190575751177])' />
