              <calculation class='tableau' formula='COUNTD(IF [Calculation_5269704190573768709] &gt;= [Parameters].[CP Start Date (copy)_5269704190572032001] AND [Calculation_5269704190573768709] &lt;= [Parameters].[CP End Date (copy)_5269704190572023808] THEN [product_id_sold] END)' />
