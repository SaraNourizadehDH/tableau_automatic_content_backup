    <dashboard name='Top/ Bottom Performing SKUs Europe'>
      <style />
      <size maxheight='800' maxwidth='1600' minheight='800' minwidth='1600' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='SKU Level Europe' name='federated.02hl0g90g3xvuy1h99jr40wfqlzu (copy)' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column alias='Weekly' caption='Date Level (SKU)' datatype='string' name='[Date Level (copy)_6516427220856385536]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
          <calculation class='tableau' formula='&quot;week&quot;' />
          <aliases>
            <alias key='&quot;month&quot;' value='Monthly' />
            <alias key='&quot;quarter&quot;' value='Quarterly' />
            <alias key='&quot;week&quot;' value='Weekly' />
          </aliases>
          <members>
            <member alias='Weekly' value='&quot;week&quot;' />
            <member alias='Monthly' value='&quot;month&quot;' />
            <member alias='Quarterly' value='&quot;quarter&quot;' />
          </members>
        </column>
        <column caption='Dimension' datatype='string' name='[Parameter 11]' param-domain-type='list' role='measure' type='nominal' value='&quot;Category&quot;'>
          <calculation class='tableau' formula='&quot;Category&quot;' />
          <members>
            <member value='&quot;Country&quot;' />
            <member value='&quot;Category&quot;' />
            <member value='&quot;Supcategory&quot;' />
            <member value='&quot;Warehouse&quot;' />
            <member value='&quot;Supplier&quot;' />
          </members>
        </column>
        <column caption='Select How Many Periods' datatype='integer' name='[Parameter 7]' param-domain-type='any' role='measure' type='quantitative' value='3'>
          <calculation class='tableau' formula='3' />
        </column>
        <column caption='Top/ Bottom By Measure' datatype='string' name='[Parameter 9]' param-domain-type='list' role='measure' type='nominal' value='&quot;Selected Period Sales&quot;'>
          <calculation class='tableau' formula='&quot;Selected Period Sales&quot;' />
          <members>
            <member value='&quot;Selected Period Sales&quot;' />
            <member value='&quot;Selected Period Front Margin&quot;' />
            <member value='&quot;Selected Period Qty Sold&quot;' />
            <member value='&quot;Selected Period Basket Penetration&quot;' />
            <member value='&quot;Total Sales&quot;' />
            <member value='&quot;Total Front Margin&quot;' />
            <member value='&quot;Total Qty&quot;' />
            <member value='&quot;Total Basket Penetration&quot;' />
