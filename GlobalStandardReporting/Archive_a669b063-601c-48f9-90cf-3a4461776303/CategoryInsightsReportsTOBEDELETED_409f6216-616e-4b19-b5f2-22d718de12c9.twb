              <calculation class='tableau' formula='#2022-11-15#' />
              <range max='#2023-12-31#' min='#2020-01-01#' />
            </column>
            <column caption='CP Start Date' datatype='date' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='#2022-12-15#'>
              <calculation class='tableau' formula='#2022-12-15#' />
              <range max='#2023-12-31#' min='#2020-01-01#' />
            </column>
            <column caption='CP End Date' datatype='date' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='#2022-12-31#'>
              <calculation class='tableau' formula='#2022-12-31#' />
              <range max='#2023-12-31#' min='#2021-01-01#' />
            </column>
            <column caption='Currency' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;EUR&quot;'>
              <calculation class='tableau' formula='&quot;EUR&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.02hl0g90g3xvuy1h99jr40wfqlzu (copy)'>
            <column caption='% Change Availability (Category)' datatype='real' name='[% Change Availability (copy)_5269704190600466456]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Calculation_5269704190599610390] - [CP Availability (Category) (copy)_5269704190600323095])' />
            </column>
            <column caption='% Change PPP % (Category)' datatype='real' name='[% Change Front Margin % (Category) (copy)_4706402398881501190]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Calculation_4706402398881185796] - [CP PPP % (Category) (copy)_4706402398881386501])' />
            </column>
            <column caption='% Change Front Margin % (Category)' datatype='real' name='[% Change Front Margin % (copy)_5269704190598148115]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Calculation_5269704190597578769] - [CP Front Margin % (Category) (copy)_5269704190597963794])' />
            </column>
            <column caption='% Change Products Sold (Category) ' datatype='real' name='[% Change Net Retail Revenue (Category) (copy)_5269704190618177582]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(([CP Active Products (Category) (copy)_5269704190613999657] / [CP Products Sold (Category)  (copy)_5269704190617002026]) - 1)' />
            </column>
            <column caption='% Change Net Retail Revenue (Category)' datatype='real' name='[% Change Net Retail Revenue (copy)_5269704190573207556]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(([CP Net Retail Revenue (copy)_5269704190572191746] / [PP Net Retail Revenue (copy)_5269704190572453891]) - 1)' />
            </column>
            <column caption='% Change Quantity Sold (Category)' datatype='real' name='[% Change Units (copy)_5269704190576275467]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(([CP Net Retail Revenue (Category) (copy)_5269704190575751177] / [PP Net Retail Revenue (Category) (copy)_5269704190575886346]) - 1)' />
            </column>
            <column caption='CP Products Sold (Category) ' datatype='integer' name='[CP Active Products (Category) (copy)_5269704190613999657]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [Calculation_5269704190573768709] &gt;= [Parameters].[Parameter 1] AND [Calculation_5269704190573768709] &lt;= [Parameters].[Parameter 2] THEN [product_id_sold] END)' />
            </column>
            <column caption='CP Warehouses Selling (Category) ' datatype='integer' name='[CP Active Products (Category) (copy)_5269704190619787312]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [Calculation_5269704190573768709] &gt;= [Parameters].[Parameter 1] AND [Calculation_5269704190573768709] &lt;= [Parameters].[Parameter 2] THEN [warehouse_id_selling] END)' />
            </column>
            <column caption='PP Availability (Category) ' datatype='real' name='[CP Availability (Category) (copy)_5269704190600323095]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_5269704190573768709] &gt;= [Parameters].[CP Start Date (copy)_5269704190572032001] AND [Calculation_5269704190573768709] &lt;= [Parameters].[CP End Date (copy)_5269704190572023808] THEN [available_instances] END) &#10;/ &#10;SUM(IF [Calculation_5269704190573768709] &gt;= [Parameters].[CP Start Date (copy)_5269704190572032001] AND [Calculation_5269704190573768709] &lt;= [Parameters].[CP End Date (copy)_5269704190572023808] THEN [total_instances] END)' />
            </column>
            <column caption='PP Front Margin % (Category) ' datatype='real' name='[CP Front Margin % (Category) (copy)_5269704190597963794]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(([PP Net Retail Revenue (copy)_5269704190572453891] - [PP Net Retail Revenue (Category) (copy)_5269704190597193744]) / [PP Net Retail Revenue (copy)_5269704190572453891])' />
            </column>
            <column caption='PP PPP (Category) ' datatype='real' name='[CP Net PPP (Category)  (copy)_4706402398880546818]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[PP Net Retail Revenue (copy)_5269704190572453891] - [PP Net Retail Revenue (Category) (copy)_5269704190597193744] + [CP Supplier Funding (Category)  (copy)_4706402399020576780]' />
            </column>
            <column caption='CP PPP (Category) ' datatype='real' name='[CP Net Retail Revenue (Category) (copy)_4706402398880280576]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[CP Net Retail Revenue (copy)_5269704190572191746] - [CP Net Retail Revenue (Category) (copy)_5269704190597079055] + [CP PPP (Category)  (copy)_4706402399014830090]' />
            </column>
            <column caption='CP Quantity Sold (Category)' datatype='real' name='[CP Net Retail Revenue (Category) (copy)_5269704190575751177]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_5269704190573768709] &gt;= [Parameters].[Parameter 1] AND [Calculation_5269704190573768709] &lt;= [Parameters].[Parameter 2]&#10; THEN [Calculation_6160924302409244696] END)' />
            </column>
            <column caption='CP AVG Sales Price (Category)' datatype='real' name='[CP Net Retail Revenue (Category) (copy)_5269704190576906252]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[CP Net Retail Revenue (copy)_5269704190572191746] / [CP Net Retail Revenue (Category) (copy)_5269704190575751177]' />
            </column>
            <column caption='CP COGS (Category)' datatype='real' name='[CP Net Retail Revenue (Category) (copy)_5269704190597079055]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_5269704190573768709] &gt;= [Parameters].[Parameter 1] AND [Calculation_5269704190573768709] &lt;= [Parameters].[Parameter 2]&#10; THEN [Calculation_6160924302405914642] END)' />
            </column>
            <column caption='CP Net Retail Revenue (Category)' datatype='real' name='[CP Net Retail Revenue (copy)_5269704190572191746]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_5269704190573768709] &gt;= [Parameters].[Parameter 1] AND [Calculation_5269704190573768709] &lt;= [Parameters].[Parameter 2]&#10; THEN [Calculation_6160924302406176787] END)' />
            </column>
            <column caption='PP PPP % (Category) ' datatype='real' name='[CP PPP % (Category) (copy)_4706402398881386501]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([CP Net PPP (Category)  (copy)_4706402398880546818] / [PP Net Retail Revenue (copy)_5269704190572453891])' />
            </column>
