            <column caption='Avg Listed Sku count per entity (Country)' datatype='real' name='[Calculation_1727974891203878949]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  ([Calculation_1727974890607063047] = 1 and AVG([Calculation_1727974891297435697] )&gt; 1)&#13;&#10;     then NULL&#13;&#10;ELSE zn(sum([Calculation_1727974891203690531])/sum([Calculation_1727974891203588130])) END' />
            </column>
            <column caption='Distinct Warehouse Combinations fixed' datatype='integer' name='[Calculation_1727974891297435697]' role='measure' type='quantitative'>
