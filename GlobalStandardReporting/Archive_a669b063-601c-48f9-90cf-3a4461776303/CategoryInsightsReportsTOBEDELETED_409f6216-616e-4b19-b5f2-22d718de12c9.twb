            </column>
            <column caption='PP All Orders Per Country Category Fixed' datatype='real' name='[Calculation_854558044971266087]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], [warehouse_id_selling], [category_parent_english], [stock_date]: &#13;&#10;Avg(IF ([Calculation_6160924302408085527] &gt;= [Parameters].[CP Start Date (copy)_5269704190572032001] AND [Calculation_6160924302408085527] &lt;= [Parameters].[CP End Date (copy)_5269704190572023808]&#13;&#10;AND NOT ISNULL([warehouse_id_selling]))&#13;&#10; THEN [orders_per_warehouse_cat] END)}' />
            </column>
            <column caption='PP All Orders Per Country Fixed' datatype='real' name='[Calculation_854558044971307048]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], [stock_date]: &#13;&#10;Avg(IF ([Calculation_6160924302408085527] &gt;= [Parameters].[CP Start Date (copy)_5269704190572032001] AND [Calculation_6160924302408085527] &lt;= [Parameters].[CP End Date (copy)_5269704190572023808])&#13;&#10; THEN [all_orders_per_country] END)}' />
            </column>
            <column caption='PP All Orders Per Country SubCategory Fixed' datatype='real' name='[Calculation_854558044971393065]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], [warehouse_id_selling], [category_parent_english], [category_english], [stock_date]: &#13;&#10;Avg(IF ([Calculation_6160924302408085527] &gt;= [Parameters].[CP Start Date (copy)_5269704190572032001] AND [Calculation_6160924302408085527] &lt;= [Parameters].[CP End Date (copy)_5269704190572023808]&#13;&#10;AND NOT ISNULL([warehouse_id_selling]))&#13;&#10; THEN [orders_per_warehouse_subcat] END)}' />
            </column>
            <column caption='PP Basket Penetration %' datatype='real' name='[Calculation_854558044971442218]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE  [Calculation_854558044971012130]&#13;&#10;    WHEN  1&#13;&#10;    THEN&#13;&#10;    ZN(SUM([Calculation_854558044971393065])/SUM([Calculation_854558044971307048]))&#13;&#10;    ELSE&#13;&#10;    ZN(SUM([Calculation_854558044971266087])/SUM([Calculation_854558044971307048]))&#13;&#10;END' />
            </column>
            <column caption='% Change CP BASKET PENETRATION' datatype='real' name='[Calculation_854558044971495467]' role='measure' type='quantitative'>
