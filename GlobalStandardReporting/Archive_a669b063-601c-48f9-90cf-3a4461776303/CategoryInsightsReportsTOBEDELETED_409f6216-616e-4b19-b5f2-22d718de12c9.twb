    <worksheet name='Bottom X Products'>
      <table>
        <view>
          <datasources>
            <datasource caption='SKU level MENA' name='federated.01unve11fp1a2915ldhu21i8dc4d' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Dimension' datatype='string' name='[Parameter 11]' param-domain-type='list' role='measure' type='nominal' value='&quot;Category&quot;'>
              <calculation class='tableau' formula='&quot;Category&quot;' />
            </column>
            <column caption='Currency' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;EUR&quot;'>
              <calculation class='tableau' formula='&quot;EUR&quot;' />
            </column>
            <column alias='Weekly' caption='Date Level' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
              <calculation class='tableau' formula='&quot;week&quot;' />
              <aliases>
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;quarter&quot;' value='Quarterly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
            <column caption='Select How Many Periods' datatype='integer' name='[Parameter 7]' param-domain-type='any' role='measure' type='quantitative' value='3'>
              <calculation class='tableau' formula='3' />
            </column>
            <column caption='Top/ Bottom By Measure' datatype='string' name='[Parameter 9]' param-domain-type='list' role='measure' type='nominal' value='&quot;Selected Period Sales&quot;'>
              <calculation class='tableau' formula='&quot;Selected Period Sales&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.01unve11fp1a2915ldhu21i8dc4d'>
            <column caption='CP Basket Penetration' datatype='real' default-format='p0.00%' name='[Basket Penetration (copy)_6160924302597959718]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM(IF [Calculation_6160924302585344026] = TRUE THEN [orders] END) /&#10; SUM(IF [Calculation_6160924302585344026] = TRUE THEN [Calculation_6160924302380400655] END))' />
            </column>
            <column caption='Sales/ GMV' datatype='real' name='[Calculation_6160924302271447046]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN((CASE [Parameters].[Parameter 3] &#10;WHEN &apos;EUR&apos; THEN [total_price_paid_eur]&#10;WHEN &apos;Local&apos; THEn [total_price_paid_lc]&#10;END))' />
            </column>
            <column caption='Total Orders' datatype='integer' name='[Calculation_6160924302380400655]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED  [warehouse_name], [stock_date]: SUM([orders])}' />
            </column>
            <column caption='Basket Penetration' datatype='real' name='[Calculation_6160924302380568592]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([orders]) / SUM([Calculation_6160924302380400655]))' />
            </column>
            <column caption='COGS' datatype='real' name='[Calculation_6160924302405914642]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN((CASE [Parameters].[Parameter 3]&#10;WHEN &apos;EUR&apos; THEN [cogs_eur]&#10;WHEN &apos;Local&apos; THEN [cogs_lc]&#10;END))' />
            </column>
            <column caption='Net Retail Revenue' datatype='real' name='[Calculation_6160924302406176787]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN((CASE [Parameters].[Parameter 3]&#10;WHEN &apos;EUR&apos; THEN [total_price_paid_net_eur]&#10;WHEN &apos;Local&apos; THEN [total_price_paid_net_lc]&#10;END))' />
            </column>
            <column caption='Units' datatype='real' name='[Calculation_6160924302409244696]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(([qty_sold]))' />
            </column>
            <column caption='Date Limitation' datatype='boolean' name='[Calculation_6160924302585344026]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[stock_date] &gt;= DATEADD([Parameters].[Parameter 5],-([Parameters].[Parameter 7]), DATETRUNC([Parameters].[Parameter 5],TODAY()))&#10;&#10;AND [stock_date] &lt; DATETRUNC([Parameters].[Parameter 5], TODAY()) - 1' />
            </column>
            <column caption='CP COGS' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6160924302591389724]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_6160924302585344026] = True THEN [Calculation_6160924302405914642] END)' />
            </column>
            <column caption='Top/Bottom Measure' datatype='real' name='[Calculation_6160924305166090328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 9]&#10;WHEN &apos;Selected Period Sales&apos; THEN [Selected Period COGS (copy)_6160924302591688733]&#10;WHEN &apos;Selected Period Front Margin&apos; THEN [Front Margin % (copy)_6160924302598889512]&#10;WHEN &apos;Selected Period Qty Sold&apos; THEN [Selected Period COGS (copy) (copy)_6160924302591893534]&#10;WHEN &apos;Selected Period Basket Penetration&apos; THEN [Basket Penetration (copy)_6160924302597959718]&#10;WHEN &apos;Total Sales&apos; THEN SUM([Calculation_6160924302271447046])&#10;WHEN &apos;Total Front Margin&apos; THEN [Front Margin % (copy)_6160924302407270422]&#10;WHEN &apos;Total Qty&apos; THEN SUM([qty_sold])&#10;WHEN &apos;Total Basket Penetration&apos; THEN [Calculation_6160924302380568592]&#10;END' />
            </column>
            <column caption='Index' datatype='integer' name='[Calculation_6160924305456459865]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='INDEX()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Dimension' datatype='string' name='[Calculation_6160924305480368227]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 11]&#10;WHEN &apos;Country&apos; THEN [global_entity_id]&#10;WHEN &apos;Category&apos; THEN [category_parent_english]&#10;WHEN &apos;Subcategory&apos; THEN [category_english]&#10;WHEN &apos;Supplier&apos; THEN [supplier_name]&#10;WHEN &apos;Warehouse&apos; THEN [warehouse_name]&#10;END' />
            </column>
            <column caption='Front (net) Margin' datatype='real' name='[Front Margin % (copy)_6160924302407270422]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([Calculation_6160924302406176787]) - SUM([Calculation_6160924302405914642]))' />
            </column>
            <column caption='CP Front Margin % ' datatype='real' default-format='p0.00%' name='[Front Margin % (copy)_6160924302598889512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN((SUM(IF [Calculation_6160924302585344026] = TRUE THEN [Calculation_6160924302406176787] END) - [Calculation_6160924302591389724]) &#10;/(SUM(IF [Calculation_6160924302585344026] = TRUE THEN [Calculation_6160924302406176787] END)))' />
            </column>
            <column caption='CP Units' datatype='real' default-format='N' name='[Selected Period COGS (copy) (copy)_6160924302591893534]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_6160924302585344026] = True THEN [Calculation_6160924302409244696] END)' />
            </column>
            <column caption='CP Net Retail Revenue' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Selected Period COGS (copy)_6160924302591688733]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_6160924302585344026] = True THEN [Calculation_6160924302406176787] END)' />
