    <worksheet name='Net Retail Value'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Country Level' name='federated.0tmy4vj0f2pwiv11cranq0yn2kha' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='CP Start Date' datatype='date' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='#2022-12-15#'>
              <calculation class='tableau' formula='#2022-12-15#' />
              <range max='#2023-12-31#' min='#2020-01-01#' />
            </column>
            <column caption='CP End Date' datatype='date' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='#2022-12-31#'>
              <calculation class='tableau' formula='#2022-12-31#' />
              <range max='#2023-12-31#' min='#2021-01-01#' />
            </column>
            <column caption='Currency' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;EUR&quot;'>
              <calculation class='tableau' formula='&quot;EUR&quot;' />
            </column>
            <column alias='Weekly' caption='Date Level' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
              <calculation class='tableau' formula='&quot;week&quot;' />
              <aliases>
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;quarter&quot;' value='Quarterly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0tmy4vj0f2pwiv11cranq0yn2kha'>
            <column caption='Budget Net Retail Value ' datatype='real' name='[Budget Orders (copy)_2096566370856845340]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_2096566370773766153] = True THEN [Calculation_2096566370855747610] END)' />
            </column>
            <column caption='Days In Range' datatype='integer' name='[Calculation_2096566370773192712]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[Parameters].[Parameter 1],[Parameters].[Parameter 2] +1)' />
            </column>
            <column caption='Date Filter CP' datatype='boolean' name='[Calculation_2096566370773766153]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[order_date] &gt;= [Parameters].[Parameter 1] AND [order_date] &lt;= [Parameters].[Parameter 2]' />
            </column>
            <column caption='Date Filter PP' datatype='boolean' name='[Calculation_2096566370773889034]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[order_date] &gt;= [Parameters].[Parameter 1] -  [Calculation_2096566370773192712]&#10;AND [order_date] &lt;= [Parameters].[Parameter 2] - [Calculation_2096566370773192712]' />
            </column>
            <column caption='Date Equalizer' datatype='date' name='[Calculation_2096566370774208523]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Calculation_2096566370773766153] = True THEN [order_date]&#10;ELSEIF [Calculation_2096566370773889034] = True THEN [order_date] + [Calculation_2096566370773192712]&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Net Retail Value' datatype='real' name='[Calculation_2096566370853683219]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;EUR&apos; THEN [net_retail_value_eur]&#10;WHEN &apos;Local&apos; THEN [net_retail_value_lc]&#10;END' />
            </column>
            <column caption='Budget Revenue ' datatype='real' name='[Calculation_2096566370855747610]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;EUR&apos; THEN [revenue_budget_per_period_eur]&#10;WHEN &apos;Local&apos; THEN [revenue_budget_per_period_lc]&#10;END' />
            </column>
            <column caption='Date*' datatype='date' name='[Calculation_2096566370922340396]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parameter 5], [Calculation_2096566370774208523]))' />
            </column>
            <column caption='Current Period Net Retail Value' datatype='real' name='[Current Period Orders (copy)_2096566370853818388]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_2096566370773766153] = True THEN [Calculation_2096566370853683219] END)' />
            </column>
            <column caption='Prior Period Net Retail Value' datatype='real' name='[Prior Period Orders (copy)_2096566370853933077]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_2096566370773889034] = True THEN [Calculation_2096566370853683219] END)' />
            </column>
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
