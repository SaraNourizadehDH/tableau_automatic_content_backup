    <dashboard name='Top/ Bottom Performing SKUs APAC'>
      <style />
      <size maxheight='800' maxwidth='1600' minheight='800' minwidth='1600' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='SKU Level APAC' name='federated.0ml98eq0rv4v8i1ckkalg0pshoxb' />
