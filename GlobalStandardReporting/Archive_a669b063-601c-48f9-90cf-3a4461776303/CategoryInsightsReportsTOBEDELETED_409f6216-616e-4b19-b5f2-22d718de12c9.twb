            <column caption='DIstinct Warehouse Week Combinations (country)' datatype='integer' name='[Calculation_1727974890607247368]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [Calculation_5269704190573768709] &gt;= [Parameters].[Parameter 1] AND [Calculation_5269704190573768709] &lt;= [Parameters].[Parameter 2]&#13;&#10; THEN [warehouse_name] + str([stock_date]) END)' />
