      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/GeoClustersCustomers/Delivery?rev=' id='Delivery' path='/t/GlobalStandardReporting/workbooks/GeoClustersCustomers' revision='' site='GlobalStandardReporting' />
      <table>
        <view>
          <datasources>
            <datasource caption='_customer_geo_cluster_metrics (cl_dmart)' name='federated.0jupwsl12bjpct1c3e2dy1jq2ygb' />
            <datasource name='Parameters' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='16w' caption='Select Density' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Density 16w&quot;'>
              <calculation class='tableau' formula='&quot;Density 16w&quot;' />
              <aliases>
                <alias key='&quot;Density 16w&quot;' value='16w' />
                <alias key='&quot;Density 16w log&quot;' value='16w log' />
              </aliases>
            </column>
            <column alias='AOV' caption='Select Metric' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;GMV&quot;'>
              <calculation class='tableau' formula='&quot;GMV&quot;' />
              <aliases>
                <alias key='&quot;GMV&quot;' value='AOV' />
                <alias key='&quot;GMV after Trial&quot;' value='AOV after Trial' />
                <alias key='&quot;GMV QC/RS&quot;' value='AOV QC/RS' />
              </aliases>
            </column>
            <column alias='Restaurants' caption='Select Verticals' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Rs&quot;'>
              <calculation class='tableau' formula='&quot;Rs&quot;' />
              <aliases>
                <alias key='&quot;Rs&quot;' value='Restaurants' />
              </aliases>
            </column>
            <column caption='Select Delivery Metric' datatype='string' name='[Select Density (copy)_758293632295059458]' param-domain-type='list' role='measure' type='nominal' value='&quot;Distance&quot;'>
              <calculation class='tableau' formula='&quot;Distance&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0jupwsl12bjpct1c3e2dy1jq2ygb'>
            <column caption='Metric' datatype='real' name='[Calculation_3714625306547769344]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF     &#10;// AOV or GMV&#10;       ([Parameters].[Parameter 2]=&apos;GMV&apos; AND [Parameters].[Parameter 3]=&apos;Rs&apos;)  THEN [gmv_avg_l16w_vert_rs]&#10;ELSEIF ([Parameters].[Parameter 2]=&apos;GMV&apos; AND [Parameters].[Parameter 3]=&apos;QC&apos;)  THEN [gmv_avg_l16w_vert_qc]&#10;ELSEIF ([Parameters].[Parameter 2]=&apos;GMV&apos; AND [Parameters].[Parameter 3]=&apos;Dmart&apos;)  THEN [gmv_avg_l16w_vert_dmart]&#10;&#10;//Order Frequency&#10;ELSEIF ([Parameters].[Parameter 2]=&apos;Frequency&apos; AND [Parameters].[Parameter 3]=&apos;Rs&apos;) THEN [order_count_sum_l16w_vert_rs]&#10;ELSEIF ([Parameters].[Parameter 2]=&apos;Frequency&apos;AND [Parameters].[Parameter 3]=&apos;QC&apos;)  THEN [order_count_sum_l16w_vert_qc]&#10;ELSEIF ([Parameters].[Parameter 2]=&apos;Frequency&apos; AND [Parameters].[Parameter 3]=&apos;Dmart&apos;)  THEN [order_count_sum_l16w_vert_dmart]&#10;&#10;//Order Hour&#10;//ELSEIF ([Select Metric]=&apos;Order Hour&apos; AND [Select Verticals]=&apos;Rs&apos;)THEN [order_hour_avg_l16w_vert_rs]&#10;//ELSEIF ([Select Metric]=&apos;Order Hour&apos; AND [Select Verticals]=&apos;QC&apos;) THEN [order_hour_avg_l16w_vert_qc]&#10;//ELSEIF ([Select Metric]=&apos;Order Hour&apos; AND [Select Verticals]=&apos;Dmart&apos;) THEN [order_hour_avg_l16w_vert_dmart]&#10;&#10;//Vouchers&#10;ELSEIF ([Parameters].[Parameter 2]=&apos;Voucher&apos; AND [Parameters].[Parameter 3]=&apos;Rs&apos;)   THEN [voucher_avg_l16w_vert_rs]&#10;ELSEIF ([Parameters].[Parameter 2]=&apos;Voucher&apos;  AND [Parameters].[Parameter 3]=&apos;QC&apos;) THEN [voucher_avg_l16w_vert_qc]&#10;ELSEIF ([Parameters].[Parameter 2]=&apos;Voucher&apos; AND [Parameters].[Parameter 3]=&apos;Dmart&apos;)THEN [voucher_avg_l16w_vert_dmart]&#10;&#10;//All/Others&#10;ELSEIF ([Parameters].[Parameter 2]=&apos;Acquisition Probability&apos;  AND [Parameters].[Parameter 3]=&apos;All/Others&apos;) THEN [prediction_acquisition_general_qc]&#10;ELSEIF ([Parameters].[Parameter 2]=&apos;Organic Acq. Probability&apos; AND  [Parameters].[Parameter 3]=&apos;All/Others&apos;) THEN [prediction_acquisition_organic_qc]&#10;ELSEIF ([Parameters].[Parameter 2]=&apos;Acquisition Probability&apos;  AND [Parameters].[Parameter 3]=&apos;Dmart&apos;) THEN [prediction_acquisition_general_dmart]&#10;//ELSEIF ([Select Metric]=&apos;Acquisition Probability&apos;  AND [Select Verticals]=&apos;Dmart&apos;) THEN [prediction_acquisition_general_ls]&#10;ELSEIF ([Parameters].[Parameter 2]=&apos;GMV after Trial&apos;     AND  [Parameters].[Parameter 3]=&apos;All/Others&apos;)       THEN [prediction_gmv_avg_qc]&#10;ELSEIF ([Parameters].[Parameter 2]=&apos;Freq. after Trial&apos; AND  [Parameters].[Parameter 3]=&apos;All/Others&apos;) THEN [prediction_order_freq_4w_qc]&#10;ELSEIF ([Parameters].[Parameter 2]=&apos;GMV QC/RS&apos;       AND  [Parameters].[Parameter 3]=&apos;All/Others&apos;)   THEN [gmv_avg_l16w_vert_qc] / [gmv_avg_l16w_vert_rs]&#10;&#10;&#10;END' />
            </column>
            <column caption='Density QC/all' datatype='real' default-format='p0.00%' name='[Calculation_758293632276656129]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[customer_count_active_l16w_vert_qc]/[customer_count_total]' />
            </column>
            <column caption='Customers active 16w log2' datatype='real' name='[Calculation_758293632299601924]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='LOG([customer_count_total]+1, 3)' />
            </column>
            <column caption='Customer Cluster' datatype='integer' name='[Calculation_973481260453576704]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF     CONTAINS([Parameters].[Parameter 1],&apos;QC&apos;)  THEN [customer_count_active_l16w_vert_qc]&#10;ELSEIF CONTAINS([Parameters].[Parameter 1],&apos;Dmart&apos;)  THEN [customer_count_active_l16w_vert_dmart]&#10;ELSEIF  CONTAINS([Parameters].[Parameter 1],&apos;Rs&apos;)  THEN [customer_count_active_l16w_vert_rs]&#10;ELSE [customer_count_total]&#10;END' />
            </column>
            <column caption='Delay Metric' datatype='real' name='[Calculation_981644034799009793]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF     &#10;       [Parameters].[Parameter 3]=&apos;QC&apos;    THEN [delivery_delay_min_avg_l16w_vert_qc]&#10;ELSEIF [Parameters].[Parameter 3]=&apos;Rs&apos;    THEN [delivery_delay_min_avg_l16w_vert_rs]&#10;ELSEIF [Parameters].[Parameter 3]=&apos;Dmart&apos; THEN [delivery_delay_min_avg_l16w_vert_dmart]&#10;END' />
            </column>
            <column caption='Dmart Customers active 16w log2' datatype='real' name='[Customers active 16w log2 (copy)_1921066767710294016]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='LOG([customer_count_active_l16w_vert_dmart]+1, 3)' />
            </column>
            <column caption='Density Dmart/all' datatype='real' default-format='p0.00%' name='[Density QC/all (copy)_910712338547113984]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[customer_count_active_l16w_vert_dmart]/[customer_count_total]' />
            </column>
            <column caption='Density Select' datatype='real' name='[Metric (copy)_758293632270368768]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF     &#10;//Density 16w&#10;  ([Parameters].[Parameter 1]=&apos;Density 16w&apos; AND [Parameters].[Parameter 3]=&apos;All/Others&apos;)  THEN [customer_count_total]&#10;ELSEIF ([Parameters].[Parameter 1]=&apos;Density 16w&apos; AND [Parameters].[Parameter 3]=&apos;Rs&apos;)   THEN [customer_count_active_l16w_vert_rs]&#10;ELSEIF([Parameters].[Parameter 1]=&apos;Density 16w&apos; AND [Parameters].[Parameter 3]=&apos;QC&apos;)   THEN [customer_count_active_l16w_vert_qc]  &#10;ELSEIF([Parameters].[Parameter 1]=&apos;Density 16w&apos; AND [Parameters].[Parameter 3]=&apos;Dmart&apos;)THEN [customer_count_active_l16w_vert_dmart] &#10;&#10;//Density 16w log&#10;ELSEIF ([Parameters].[Parameter 1]=&apos;Density 16w log&apos; AND [Parameters].[Parameter 3]=&apos;All/Others&apos;) THEN [Calculation_758293632299601924]&#10;//ELSEIF ([Select Density]=&apos;Density 16w log&apos; AND [Select Verticals]=&apos;Rs&apos;)THEN [Rs Customers active 16w log2]&#10;//ELSEIF ([Select Density]=&apos;Density 16w log&apos; AND [Select Verticals]=&apos;QC&apos;) THEN [QC Customers active 16w log2]&#10;ELSEIF  ([Parameters].[Parameter 1]=&apos;Density 16w log&apos; AND [Parameters].[Parameter 3]=&apos;Dmart&apos;) THEN [Customers active 16w log2 (copy)_1921066767710294016]&#10;&#10;//Select Vertical/All&#10;//ELSEIF ([Select Density]=&apos;Vertical/All&apos; AND [Select Verticals]=&apos;Rs&apos;)  THEN [Density Rs/all]&#10;ELSEIF ([Parameters].[Parameter 1]=&apos;Vertical/All&apos; AND [Parameters].[Parameter 3]=&apos;QC&apos;)  THEN [Calculation_758293632276656129]&#10;ELSEIF ([Parameters].[Parameter 1]=&apos;Vertical/All&apos; AND [Parameters].[Parameter 3]=&apos;Dmart&apos;) THEN [Density QC/all (copy)_910712338547113984]&#10;&#10;END' />
            </column>
            <column caption='Delivery Metric' datatype='real' name='[Metric (copy)_758293632296046595]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#10;//Distance&#10;       ([Parameters].[Select Density (copy)_758293632295059458]=&apos;Distance&apos; AND [Parameters].[Parameter 3]=&apos;Rs&apos;)    THEN [delivery_distance_m_avg_l16w_vert_rs] &#10;ELSEIF ([Parameters].[Select Density (copy)_758293632295059458]=&apos;Distance&apos; AND [Parameters].[Parameter 3]=&apos;QC&apos;)    THEN [delivery_distance_m_avg_l16w_vert_qc]&#10;ELSEIF ([Parameters].[Select Density (copy)_758293632295059458]=&apos;Distance&apos; AND [Parameters].[Parameter 3]=&apos;Dmart&apos;) THEN [delivery_distance_m_avg_l16w_vert_dmart]&#10;//Time&#10;ELSEIF ([Parameters].[Select Density (copy)_758293632295059458]=&apos;Time&apos; AND [Parameters].[Parameter 3]=&apos;Rs&apos;)     THEN [delivery_time_promised_min_avg_l16w_vert_rs]&#10;ELSEIF ([Parameters].[Select Density (copy)_758293632295059458]=&apos;Time&apos; AND [Parameters].[Parameter 3]=&apos;QC&apos;)     THEN [delivery_time_promised_min_avg_l16w_vert_qc]&#10;ELSEIF ([Parameters].[Select Density (copy)_758293632295059458]=&apos;Time&apos; AND [Parameters].[Parameter 3]=&apos;Dmart&apos;)  THEN [delivery_time_promised_min_avg_l16w_vert_dmart]&#10;//Fees&#10;ELSEIF ([Parameters].[Select Density (copy)_758293632295059458]=&apos;Fees&apos; AND [Parameters].[Parameter 3]=&apos;Rs&apos;)      THEN [delivery_fee_avg_l16w_vert_rs]&#10;ELSEIF ([Parameters].[Select Density (copy)_758293632295059458]=&apos;Fees&apos; AND [Parameters].[Parameter 3]=&apos;QC&apos;)      THEN [delivery_fee_avg_l16w_vert_qc]&#10;ELSEIF ([Parameters].[Select Density (copy)_758293632295059458]=&apos;Fees&apos; AND [Parameters].[Parameter 3]=&apos;Dmart&apos;)  THEN [delivery_fee_avg_l16w_vert_dmart]&#10;END' />
            </column>
