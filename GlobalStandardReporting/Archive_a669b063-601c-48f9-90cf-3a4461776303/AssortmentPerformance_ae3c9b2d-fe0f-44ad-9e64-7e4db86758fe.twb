    <worksheet name='KPIs-  Comparison'>
      <table>
        <view>
          <datasources>
            <datasource caption='_tableau_assortment_performance' name='federated.1w5y3lz0ydy78g157ipmo1n78ecq' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Timeframe' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
            <column caption='Warehouse Maturity' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;Mature&quot;' value='Mature ( &gt;= 30 Days)' />
                <alias key='&quot;Non Mature&quot;' value='Non Mature ( &lt; 30 Days)' />
              </aliases>
            </column>
            <column caption='Currency' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Euro&quot;'>
              <calculation class='tableau' formula='&quot;Euro&quot;' />
              <aliases>
                <alias key='&quot;LC&quot;' value='Local Currency' />
              </aliases>
            </column>
            <column caption='KPI' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;ABS&quot;'>
              <calculation class='tableau' formula='&quot;ABS&quot;' />
              <aliases>
                <alias key='&quot;GPV&quot;' value='GPV per Warehouse per Day' />
                <alias key='&quot;No Orders&quot;' value='No Orders per Warehouse per Day' />
              </aliases>
            </column>
            <column caption='Geographical Aggregation' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
              <calculation class='tableau' formula='&quot;Country&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1w5y3lz0ydy78g157ipmo1n78ecq'>
            <column caption='ABV (Monthly)' datatype='real' name='[ABS (Monthly) (copy)_3187633795250503693]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [rank] = 1 THEN [Calculation_3207970362319273985] END)/&#10;SUM(IF [rank] = 1 THEN [no_orders_month] END)' />
            </column>
            <column caption='ABV (Weekly)' datatype='real' name='[ABS (Weekly) (copy)_3207970362319785988]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_3207970362319273985])/&#10;SUM([no_orders_week])' />
            </column>
            <column caption='Avg No of Listed SKUs Warehouse (Monthly)' datatype='real' name='[Avg # of Listed SKUs Warehouse (Weekly) (copy)_3187633795247267842]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2] WHEN &apos;All&apos; THEN SUM([no_listed_sku_warehouse_month])/SUM([no_warehouses_month_country])&#10;WHEN &apos;Mature&apos; THEN SUM([no_listed_sku_warehouse_month_mature])/SUM([no_warehouses_month_mature_country])&#10;WHEN &apos;Non Mature&apos; THEN SUM([no_listed_sku_warehouse_month_non_mature])/SUM([no_warehouses_month_non_mature_country])&#10;END' />
            </column>
            <column caption='No of Listed SKUs Country' datatype='real' name='[Avg No of Listed SKUs Warehouse (copy)_3207970362327228425]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] WHEN &apos;Weekly&apos; THEN [Country-Month Listed SKU Country (copy)_3272779927184666625]&#10;WHEN &apos;Monthly&apos; THEN [Calculation_3272779927184027648]&#10;END' />
            </column>
            <column caption='Avg No of Listed SKUs Warehouse (Weekly)' datatype='real' name='[Calculation_3187633795246653441]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2] WHEN &apos;All&apos; THEN SUM([no_listed_sku_warehouse_week])/SUM([no_warehouses_week_country]) &#10;WHEN &apos;Mature&apos; THEN SUM([no_listed_sku_warehouse_week_mature])/SUM([no_warehouses_week_mature_country])&#10;WHEN &apos;Non Mature&apos; THEN SUM([no_listed_sku_warehouse_week_non_mature])/SUM([no_warehouses_week_non_mature_country])&#10;END' />
            </column>
            <column caption='Avg No of Listed SKUs per Warehouse' datatype='real' name='[Calculation_3187633795247484931]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] WHEN &apos;Weekly&apos; THEN [Calculation_3187633795246653441]&#10;WHEN &apos;Monthly&apos; THEN [Avg # of Listed SKUs Warehouse (Weekly) (copy)_3187633795247267842]&#10;END' />
            </column>
            <column caption='Time' datatype='date' name='[Calculation_3187633795247927300]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] WHEN &apos;Weekly&apos; THEN [week]&#10;WHEN &apos;Monthly&apos; THEN [month]&#10;END' />
            </column>
            <column caption='Frequency (Monthly)' datatype='real' name='[Calculation_3187633795249389573]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [rank] = 1 THEN [no_orders_month] END)/&#10;SUM(IF [rank] = 1 THEN [no_customer_month] END)' />
            </column>
            <column caption='Frequency' datatype='real' name='[Calculation_3187633795249721351]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] WHEN &apos;Weekly&apos; THEN [Frequency (Monthly) (copy)_3187633795249582086]&#10;WHEN &apos;Monthly&apos; THEN [Calculation_3187633795249389573]&#10;END' />
            </column>
            <column caption='GPV Week' datatype='real' name='[Calculation_3187633795250741262]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3] WHEN &apos;Euro&apos; THEN [gmv_eur_week]&#10;WHEN &apos;LC&apos; THEN [gmv_lc_week]&#10;END' />
            </column>
            <column caption='GPV' datatype='real' name='[Calculation_3207970362319273985]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] WHEN &apos;Weekly&apos; THEN [Calculation_3187633795250741262]&#10;WHEN &apos;Monthly&apos; THEN [GMV Week (copy)_3207970362319200256]&#10;END' />
            </column>
            <column caption='ABV' datatype='real' name='[Calculation_3207970362319941637]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] WHEN &apos;Weekly&apos; THEN [ABS (Weekly) (copy)_3207970362319785988]&#10;WHEN &apos;Monthly&apos; THEN [ABS (Monthly) (copy)_3187633795250503693]&#10;END' />
            </column>
            <column caption='No Orders' datatype='integer' name='[Calculation_3207970362324090886]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] WHEN &apos;Weekly&apos; THEN [no_orders_week]&#10;WHEN &apos;Monthly&apos; THEN [no_orders_month]&#10;END' />
            </column>
            <column caption='KPI' datatype='real' name='[Calculation_3207970362332299275]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4] WHEN &apos;ABS&apos; THEN [Frequency (copy)_3187633795250311179]&#10;WHEN &apos;ABV&apos; THEN [Calculation_3207970362319941637]&#10;WHEN &apos;Frequency&apos; THEN [Calculation_3187633795249721351]&#10;WHEN &apos;No Orders&apos; THEN SUM([Calculation_3207970362324090886])/SUM([Calculation_4789578203996581888])&#10;WHEN &apos;GPV&apos; THEN SUM([Calculation_3207970362319273985])/SUM([Calculation_4789578203996581888])&#10;END' />
            </column>
            <column caption='Country Listed SKU Country - Month' datatype='real' name='[Calculation_3272779927184027648]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ INCLUDE [country]: SUM([no_listed_sku_country_month])/SUM([no_date_country_month])}' />
            </column>
            <column caption='Geo' datatype='string' name='[Calculation_4158159515222028289]' role='dimension' type='nominal'>
