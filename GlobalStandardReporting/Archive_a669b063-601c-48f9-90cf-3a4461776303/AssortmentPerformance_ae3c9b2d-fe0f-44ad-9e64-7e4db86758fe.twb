    <dashboard name='KPI Definitions'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/AssortmentPerformance_16445069000060/KPIDefinitions?rev=' id='KPIDefinitions' path='/t/GlobalStandardReporting/workbooks/AssortmentPerformance_16445069000060' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='800' maxwidth='1000' minheight='800' minwidth='1000' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98000' id='3' param='vert' type-v2='layout-flow' w='98400' x='800' y='1000'>
            <zone fixed-size='95' h='12875' id='5' is-fixed='true' type-v2='text' w='98400' x='800' y='1000'>
              <formatted-text>
                <run fontname='Tableau Bold' fontsize='14'>KPI Definitions</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone forceUpdate='true' h='76000' id='6' type-v2='text' w='98400' x='800' y='13875'>
              <formatted-text>
                <run bold='true' fontcolor='#000000'>Average Number of Listed SKUs per Warehouse</run>
                <run fontcolor='#000000'>: Sum of daily number of listed SKUs per  warehouse / Number of warehouse-day</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#000000'>Average Number of Listed SKUs</run>
                <run fontcolor='#000000'>: Average Number of listed SKUs per country</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#000000'>GPV</run>
                <run fontcolor='#000000'>: Gross Purchase Value - Average price paid by customers excluding vouchers and delivery fee per warehouse-day</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#000000'>ABV</run>
                <run fontcolor='#000000'>: Average Basket Value - Total GPV / Number of orders</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#000000'>ABS</run>
                <run fontcolor='#000000'>: Average Basket Size -  Total items sold / Number of orders</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#000000'>Frequency</run>
                <run fontcolor='#000000'>: Number of Orders / Number of Unique Customers</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#000000'>Efficiency</run>
                <run fontcolor='#000000'><![CDATA[: 1 - (Number of listed SKUs older than 90 days with average unit sold < 1 per warehouse-week / Number of listed SKUs older than 90 days)]]></run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#000000'>Newness:  </run>
                <run fontcolor='#000000'><![CDATA[Number of SKUs < 90 days old / Number of listed SKUs]]></run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#000000'>Avg. L3 Categories</run>
                <run fontcolor='#000000'>: The average of the number of listed Level 3 Categories per country</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#000000'>Avg. Coverage L3 Categories</run>
                <run fontcolor='#000000'>: The average number of  listed Level 3 Categories / total number Level 3 Categories per country</run>
                <run>Æ&#10;&#10;</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
