              <calculation class='tableau' formula='SUM([qty_sold_week])/&#10;SUM([no_orders_week])' />
            </column>
            <column caption='ABS' datatype='real' name='[Frequency (copy)_3187633795250311179]' role='measure' type='quantitative'>
