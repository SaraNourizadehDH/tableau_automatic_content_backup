            <column caption='Frequency (Weekly)' datatype='real' name='[Frequency (Monthly) (copy)_3187633795249582086]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_orders_week])/&#10;SUM([no_customer_week])' />
            </column>
            <column caption='ABS (Monthly)' datatype='real' name='[Frequency (Monthly) (copy)_3187633795250069513]' role='measure' type='quantitative'>
