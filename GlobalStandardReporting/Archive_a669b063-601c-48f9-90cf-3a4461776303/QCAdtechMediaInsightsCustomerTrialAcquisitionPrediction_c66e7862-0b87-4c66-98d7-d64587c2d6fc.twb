        <calculation class='tableau' formula='IF     [Parameters].[Parameter 2]=&apos;QC Acquisition Probability&apos;   THEN AVG([prediction_acquisition_general_qc])&#10;ELSEIF [Parameters].[Parameter 2]=&apos;QC Organic Acq. Probability&apos;  THEN AVG([prediction_acquisition_organic_qc])&#10;ELSEIF [Parameters].[Parameter 2]=&apos;QC Average GMV&apos;               THEN AVG([prediction_gmv_avg_qc])&#10;ELSEIF [Parameters].[Parameter 2]=&apos;QC Average Frequency 4 Weeks&apos; THEN AVG([prediction_order_freq_4w_qc])&#10;&#10;ELSEIF [Parameters].[Parameter 2]=&apos;Dmart Acquisition Probability&apos; THEN AVG([prediction_acquisition_general_dmart])&#10;ELSEIF [Parameters].[Parameter 2]=&apos;Localstores Acquisition Probability&apos; THEN AVG([prediction_acquisition_general_ls])&#10;&#10;&#10;END' />
      </column>
