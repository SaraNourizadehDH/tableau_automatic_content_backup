            <zone forceUpdate='true' h='35000' id='3' type-v2='text' w='98400' x='800' y='7125'>
              <formatted-text>
                <run fontcolor='#000000'>Overview of Trial/Acquisition model outputs, segmentation and feature importances.</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>The terms trial and acquisition are synoymous in this context.</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#000000'>Dataset contains 4 predictions for the metrics </run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>- acqusition general</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>- organic vs paid acquisition</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>- order frequency after acquisition</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>- average order value after acquisition</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#000000'>Each predicted is grouped into different segments.</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#000000'>The sheet &apos;Segmentation&apos; shows average or total values per chosen segment (parameter on the right side).</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#000000'>The sheet &apos;Feature Importances&apos; shows differences in the influence of each feature per market.</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#000000'>The sheet &apos;Geo Clusters&apos; shows prediction values per geographical cluster.</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
