      <column caption='Segmentation' datatype='string' name='[Calculation_1547056870172475392]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF     [Parameters].[Parameter 1]=&apos;QC Acquisition General&apos;        THEN [segm_acquisition_general_qc_general]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;QC Acquisition General thirds&apos; THEN [segm_acquisition_general_qc_thirds]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;QC Acquisition Organic&apos;        THEN [segm_acquisition_organic_qc_general]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;QC Acquisition Organic thirds&apos; THEN [segm_acquisition_organic_qc_thirds]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;QC GMV&apos;                        THEN [segm_gmv_avg_qc_thirds]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;QC Frequency 4 weeks&apos;          THEN [segm_order_freq_4w_qc_thirds]&#10;&#10;&#10;// Dmarts and Localstores&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Dmart Acquisition General&apos; THEN [segm_acquisition_general_dmart_general]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Dmart Acquisition General thirds&apos; THEN [segm_acquisition_general_dmart_thirds]&#10;&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Localstores Acquistion General&apos; THEN [segm_acquisition_general_ls_general]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Localstores Acquistion General thirds&apos; THEN [segm_acquisition_general_ls_thirds]&#10;END' />
      </column>
      <column caption='Customers' datatype='integer' name='[Calculation_1547056870173110273]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([analytical_customer_id])' />
      </column>
      <column caption='Prediction Metric' datatype='real' name='[Segmentation (copy)_1547056870175653890]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF     [Parameters].[Parameter 2]=&apos;QC Acquisition Probability&apos;  THEN [prediction_acquisition_general_qc]&#10;ELSEIF [Parameters].[Parameter 2]=&apos;QC Organic Acq. Probability&apos; THEN [prediction_acquisition_organic_qc]&#10;ELSEIF [Parameters].[Parameter 2]=&apos;QC Avg GMV&apos;                  THEN [prediction_gmv_avg_qc]&#10;ELSEIF [Parameters].[Parameter 2]=&apos;QC Avg Frequency 4 Weeks&apos;    THEN [prediction_order_freq_4w_qc]&#10;&#10;//Dmarts and localstores&#10;ELSEIF [Parameters].[Parameter 2]= &apos;Dmart Acquisition Probability&apos; THEN [prediction_acquisition_general_dmart]&#10;ELSEIF [Parameters].[Parameter 2]=&apos;Localstores Acquisition Probability&apos; THEN [prediction_acquisition_general_ls]&#10;&#10;END' />
      </column>
