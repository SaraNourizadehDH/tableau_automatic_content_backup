      <aliases enabled='yes' />
      <column caption='% Available Today' datatype='real' default-format='p0.00%' name='[% Available (copy)_314689079307423744]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_2693222964889382912]) / COUNTD([skus])' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0jf01z50vxgf2u18ah5sn1cqliz1]&quot;' value='Stock in Hand' />
          <alias key='&quot;[federated.0jf01z50vxgf2u18ah5sn1cqliz1].[pcdf:usr:Calculation_2693222964889485313:qk]&quot;' value='Delta % Availability' />
        </aliases>
      </column>
      <column caption='non null sku' datatype='string' name='[Calculation_2693222964889382912]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [on_hand_qty] = 0 then null else [skus] end' />
      </column>
      <column caption='% Available ' datatype='real' default-format='p0.00%' name='[Calculation_2693222964889485313]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_2693222964889382912]) / COUNTD([skus])' />
      </column>
      <column caption='Distinct SKUs' datatype='integer' name='[Calculation_2693222964899024899]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([skus])' />
      </column>
      <column caption='SKUs Available' datatype='integer' name='[Calculation_2693222964899061764]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [on_hand_qty] &gt; 0 then [skus] else null end)' />
      </column>
      <column caption='On Hand Qty &gt; 0' datatype='boolean' name='[Calculation_4825536647956594689]' role='dimension' type='nominal'>
