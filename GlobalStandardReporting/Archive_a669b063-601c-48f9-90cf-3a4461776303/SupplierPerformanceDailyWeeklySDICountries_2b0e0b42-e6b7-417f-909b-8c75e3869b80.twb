      <column caption='Brand % of Value of Category' datatype='real' name='[Brand % of Qty of Category (copy)_1530660974781558802]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([Total Qty by Category - Brand  (copy)_1530660974781366288])/SUM([Total Qty by Category (copy)_1530660974781263887]))' />
      </column>
      <column caption='Brand % of Value of Supplier-Category' datatype='real' name='[Brand % of Qty of Supplier-Category (copy)_1530660974781759507]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([Total Qty by Category - Brand  (copy)_1530660974781366288])/SUM([Total Qty by Category - Supplier  (copy)_1530660974781456401]))' />
      </column>
      <column caption='GMV' datatype='real' name='[Calculation_1530660974721089538]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(CASE [Parameters].[Parameter 1] WHEN &apos;Euro&apos; THEN [total_price_paid_eur]&#10;ELSE [total_price_paid_lc] END)' />
      </column>
      <column caption='Basket Penetration' datatype='real' name='[Calculation_1530660974722924548]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders])/SUM([aggregate_orders])' />
      </column>
      <column caption='Time' datatype='date' datatype-customized='true' name='[Calculation_1530660974725599237]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 2] &#10;WHEN &apos;Daily&apos; THEN DATETRUNC(&apos;day&apos;, [date]) &#10;WHEN &apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;, [date])&#10;END)' />
      </column>
      <column caption='Qty Delivered*' datatype='real' name='[Calculation_1530660974726664198]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([qty_delivered])' />
      </column>
      <column caption='Total Qty by Category' datatype='real' name='[Calculation_1530660974754512903]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [aggregation_level],[global_entity_id],[category],[date]:sum([qty_delivered])}' />
      </column>
      <column caption='Total Qty by Category - Brand ' datatype='real' name='[Calculation_1530660974754553864]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [aggregation_level],[global_entity_id],[supplier_name],[category], [brand_name],[date]:sum([qty_delivered])}' />
      </column>
      <column caption='Total Qty by Category - Supplier ' datatype='real' name='[Calculation_1530660974754615305]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [aggregation_level],[global_entity_id],[supplier_name],[category],[date]:sum([qty_delivered])}' />
      </column>
      <column caption='Brand % of Qty of Category' datatype='real' name='[Calculation_1530660974754951178]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([Calculation_1530660974754553864])/SUM([Calculation_1530660974754512903]))' />
      </column>
      <column caption='Brand % of Qty of Supplier-Category' datatype='real' name='[Calculation_1530660974754992139]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([Calculation_1530660974754553864])/SUM([Calculation_1530660974754615305]))' />
      </column>
      <column caption='Select Brand Name' datatype='string' name='[Calculation_1530660974757433356]' role='measure' type='nominal'>
        <calculation class='tableau' formula='LOOKUP(MIN([brand_name]),0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% of Promotion Sales' datatype='real' name='[Calculation_1530660974788739092]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(sum(zn([qty_delivered_promo]))/sum(zn([qty_delivered])))' />
      </column>
      <column caption='No Customer (Daily)' datatype='integer' name='[Calculation_1530660974794223638]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [aggregation_level] = &apos;supplier&apos; THEN [customers] &#10;ELSE NULL END' />
      </column>
      <column caption='No Customers' datatype='integer' name='[Calculation_1530660974794866712]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2] WHEN &apos;Weekly&apos; THEN [New Customer (Weekly)  (copy)_1530660974796034074]&#10;ELSE [Calculation_1530660974794223638] END' />
      </column>
      <column caption='Amount Delivered PO' datatype='real' name='[Calculation_2191423482848043008]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] WHEN &apos;Euro&apos; THEN [amt_delivered_eur_po]&#10;ELSE [amt_delivered_lc_po] END' />
      </column>
      <column caption='Amount Lost PO' datatype='real' name='[Calculation_2191423482848210945]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] WHEN &apos;Euro&apos; THEN [amt_lost_eur_po]&#10;ELSE [amt_lost_lc_po] END' />
      </column>
      <column caption='% of Successful Purchase Orders' datatype='real' name='[Calculation_2191423482851377154]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([number_succesful_po])/SUM([number_po])' />
      </column>
      <column caption='Purchase Orders Units Returned' datatype='integer' name='[Calculation_2191423482860318723]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn([quantity_returned_po])' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_267119814091481088]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='COGS' datatype='real' name='[Calculation_490329466505695234]' role='measure' type='quantitative'>
