      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/ChatsDashboardGeographicalOverview/Riders?rev=' id='Riders' path='/t/GlobalStandardReporting/workbooks/ChatsDashboard' revision='' site='GlobalStandardReporting' />
      <table>
