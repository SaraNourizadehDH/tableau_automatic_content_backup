            </column>
            <column caption='% Total Images Read' datatype='real' name='[Calculation_5750322680184254467]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(&#10;SUM([count_total_images_read])&#10; / SUM([Calculation_5750322680181239808])&#10;,0)' />
            </column>
            <column caption='% Customer Images Read' datatype='real' name='[Calculation_5750322680186114052]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(&#10;SUM([count_customer_locations_read])&#10;/ SUM([Calculation_5750322680182718465])&#10;, 0)' />
