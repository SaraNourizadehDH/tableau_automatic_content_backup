              <calculation class='tableau' formula='&quot;Chat Rate&quot;' />
            </column>
            <column caption='Dimensions' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Is Webapp&quot;'>
              <calculation class='tableau' formula='&quot;Is Webapp&quot;' />
              <aliases>
                <alias key='&quot;Contact Center&quot;' value='Contact Center' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.18hic5c0roi51q1cuczyp11sm7f4'>
            <column caption='# Rider Initiated Chats' datatype='integer' name='[# Chat Started by Customer (copy)_5273292997750095878]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF[chat_category] = &apos;rider&apos; THEN [total_chat_sessions] ELSE 0 END)' />
            </column>
            <column caption='% First Messages Read by Customers' datatype='real' default-format='p0.0%' name='[% Customer First Messages Read (copy)_4623789461316349957]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_first_messages_read]) / [# Chat Started by Customer (copy)_5273292997750095878]' />
            </column>
            <column caption='% First Messages Read by Riders' datatype='real' default-format='p0.0%' name='[% Customer Messages Read (copy)_4623789461311471619]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([customer_first_messages_read]) / [Calculation_5273292997749710853]' />
            </column>
            <column caption='% Served Chats' datatype='real' default-format='p0.0%' name='[% Missed Chats (copy)_5273292997751455755]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_served_chats]) &#10;/ &#10;SUM([total_chat_sessions])' />
            </column>
            <column caption='% Messages Read by Riders' datatype='real' default-format='p0.0%' name='[% Rider Messages Read (copy)_4623789461310722049]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_customer_messages_read]) / SUM([total_customer_messages])' />
            </column>
            <column caption='Avg. response time rider (min)' datatype='real' name='[Avg. response time (min) (copy)_3581698733181763585]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([sum_time_to_respond_rider_sec] / 60) / [count_responses_rider]' />
            </column>
            <column caption='Avg. response time customer (min)' datatype='real' name='[Avg. response time rider (min) (copy)_3581698733181845506]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([sum_time_to_respond_customer_sec] / 60) / [count_responses_customer]' />
            </column>
            <column caption='Contact Rate' datatype='real' default-format='p0.00%' name='[Calculation_2658742306123100161]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Has Contact (copy)_2658742306121293824] = &apos;true&apos; THEN [total_chat_sessions] END)&#10;/ SUM([total_chat_sessions])' />
            </column>
            <column caption='Dimension' datatype='string' name='[Calculation_3190096707021156352]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 6]=&apos;Country&apos; THEN [country]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;DH Regions&apos; THEN [dh_region]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Contact Center&apos; THEN [contact_center]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Management Entity&apos; THEN [management_entity_group]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Device Type&apos; THEN [device_type]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Global&apos; THEN &apos;Global&apos;&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Has Contact&apos; THEN [Has Contact (copy)_2658742306121293824]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Image Attachment Used&apos; THEN [has_image]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Contact Reason L1&apos; THEN [contact_reason_l1]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Contact Reason L2&apos; THEN [contact_reason_l2]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Contact Reason L3&apos; THEN [contact_reason_l3]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Rider Contact Reason L1&apos; THEN [rider_contact_reason_l1]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Rider Contact Reason L2&apos; THEN [rider_contact_reason_l2]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Rider Contact Reason L3&apos; THEN [rider_contact_reason_l3]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Is Webapp&apos; THEN [is_webapp]&#10;&#10;END' />
            </column>
            <column caption='P2P Fail Rate' datatype='real' default-format='p0.0%' name='[Calculation_4484107513828192256]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_cancelled] = &apos;1&apos; AND [is_in_cancellation_reasons] = 1 THEN 1 ELSE 0 END)/ SUM([total_chat_sessions])' />
            </column>
            <column caption='% Messages Read by Customers' datatype='real' default-format='p0.0%' name='[Calculation_4623789461310492672]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_rider_messages_read]) / SUM([total_rider_messages])' />
            </column>
            <column caption='Chat Rate' datatype='real' default-format='p0.0%' name='[Calculation_5273292997749370884]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_chat_sessions]) &#10;/ &#10;SUM([Calculation_725431432629899264])' />
            </column>
            <column caption='# Customer Initiated Chats' datatype='integer' name='[Calculation_5273292997749710853]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF[chat_category] = &apos;customer&apos; THEN [total_chat_sessions] ELSE 0 END)' />
            </column>
            <column caption='% Missed Chats' datatype='real' default-format='p0.0%' name='[Calculation_5273292997751230474]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_missed_chats]) &#10;/ &#10;SUM([total_chat_sessions])' />
            </column>
            <column caption='Granularity' datatype='string' name='[Calculation_5273292997752655886]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Chose Dimension (Columns) (copy)_526358231437660160]&#10;    WHEN &apos;Daily&apos; THEN STR([iso_date])&#10;    WHEN &apos;Weekly&apos; THEN [week]&#10;    WHEN &apos;Monthly&apos; THEN [month]&#10;END' />
            </column>
            <column caption='Customer Response Rate' datatype='real' name='[Calculation_5273292999099621394]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [chat_category] = &apos;rider&apos; THEN [total_served_chats] ELSE 0 END)&#10;/ &#10;SUM(IF [chat_category] = &apos;rider&apos; THEN [total_chat_sessions] ELSE 0 END)&#10;// proportion of chats where the customer answers to chats initiated by a rider //' />
            </column>
            <column caption='Rates Evolution Metric' datatype='real' name='[Calculation_6713881905954082816]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Contact Rate&apos; THEN [Calculation_2658742306123100161]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Served Chats&apos; THEN [% Missed Chats (copy)_5273292997751455755]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Chat Rate&apos; THEN [Calculation_5273292997749370884]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;P2P Fail Rate&apos; THEN [Calculation_4484107513828192256]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Missed Chats&apos; THEN [Calculation_5273292997751230474]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Customer Response Rate&apos; THEN [Calculation_5273292999099621394]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Rider Response Rate&apos; THEN [Customer Response Rate (copy)_5273292999101063187]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;First Messages Read by Customers&apos; THEN [% Customer First Messages Read (copy)_4623789461316349957]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;First Messages Read by Riders&apos; THEN [% Customer Messages Read (copy)_4623789461311471619]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Messages Read by Riders&apos; THEN [% Rider Messages Read (copy)_4623789461310722049]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Messages Read by Customers&apos; THEN [Calculation_4623789461310492672]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Average Response Time Customer (min)&apos; THEN AVG([Avg. response time rider (min) (copy)_3581698733181845506])&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Average Response Time Rider (min)&apos; THEN AVG([Avg. response time (min) (copy)_3581698733181763585])&#10;END' />
            </column>
            <column caption='Filter dates' datatype='boolean' name='[Calculation_6934276795705569280]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[iso_date (copy)_5273292999113953321] != TODAY()' />
            </column>
            <column caption='Has time axis (rates evolution)' datatype='integer' name='[Calculation_718605647307812865]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF CONTAINS(STR([Parameters].[Parameter 4]), &quot;Average Response Time&quot;) THEN 1 ELSE 0 END' />
            </column>
            <column caption='Total Gross Orders' datatype='integer' name='[Calculation_725431432629899264]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// because orders are duplicated for each row with the same combination of GE ID and Date&#10;&#10;{ FIXED [global_entity_id], [iso_date] : MAX([gross_orders]) }' />
            </column>
            <column caption='Rider Response Rate' datatype='real' name='[Customer Response Rate (copy)_5273292999101063187]' role='measure' type='quantitative'>
