    <worksheet name='Viz in Tooltip - line chart'>
      <repository-location id='VizinTooltip-linechart' path='/t/GlobalStandardReporting/workbooks/ChatsDashboard' revision='' site='GlobalStandardReporting' />
      <table>
        <view>
          <datasources>
            <datasource caption='rl.p2p_chats_report' name='federated.18hic5c0roi51q1cuczyp11sm7f4' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Daily' caption='Date Granularity' datatype='string' name='[Chose Dimension (Columns) (copy)_526358231437660160]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
              <aliases>
                <alias key='&quot;Daily&quot;' value='Daily' />
                <alias key='&quot;Monthly&quot;' value='Monthly' />
                <alias key='&quot;Weekly&quot;' value='Weekly' />
              </aliases>
            </column>
            <column caption='KPIs' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Contact Rate&quot;'>
              <calculation class='tableau' formula='&quot;Contact Rate&quot;' />
            </column>
            <column caption='Dimensions' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Is Webapp&quot;'>
              <calculation class='tableau' formula='&quot;Is Webapp&quot;' />
              <aliases>
                <alias key='&quot;Contact Center&quot;' value='Contact Center' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.18hic5c0roi51q1cuczyp11sm7f4'>
            <column caption='# Rider Initiated Chats' datatype='integer' name='[# Chat Started by Customer (copy)_5273292997750095878]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF[chat_category] = &apos;rider&apos; THEN [total_chat_sessions] ELSE 0 END)' />
            </column>
            <column caption='# Rider Messages' datatype='integer' default-format='n#,##0;-#,##0' name='[# Customer Messages (copy)_5273292999109189664]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_rider_messages])' />
            </column>
            <column caption='# Last Message sent by Customer' datatype='integer' default-format='n#,##0;-#,##0' name='[# Last Message sent by Rider (copy)_5273292999109038111]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([chat_ended_by_customer])' />
            </column>
            <column caption='# Served Rider Chats' datatype='integer' default-format='n#,##0;-#,##0' name='[# Served Customer Chats (copy)_5273292999111221287]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(If [chat_category] = &apos;rider&apos; THEN [total_served_chats] ELSE 0 END)' />
            </column>
            <column caption='% Android Rider Chats' datatype='real' name='[% Android Customer Chats (copy)_5273292999110770724]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [chat_category] = &apos;rider&apos; THEN [android_chats] ELSE 0 END) &#10;/ &#10;[# Chat Started by Customer (copy)_5273292997750095878]' />
            </column>
            <column caption='% IOS Rider Chats' datatype='real' name='[% IOS Customer Chats (copy)_5273292999110877221]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [chat_category] = &apos;rider&apos; THEN [ios_chats] ELSE 0 END) &#10;/ &#10;[# Chat Started by Customer (copy)_5273292997750095878]' />
            </column>
            <column caption='% Web Rider Chats' datatype='real' name='[% Web Customer Chats (copy)_5273292999111012390]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [chat_category] = &apos;rider&apos; THEN [web_chats] ELSE 0 END) &#10;/ &#10;[# Chat Started by Customer (copy)_5273292997750095878]' />
            </column>
            <column caption='Avg. Rider Messages per Chat' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg Customer Messages per Chat (copy)_5273292999110119457]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[# Customer Messages (copy)_5273292999109189664]&#10;/ &#10;SUM([total_chat_sessions])' />
            </column>
            <column caption='Avg. FRT for Rider Chats (min)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg FRT for Customer Chats (sec) (copy)_5273292999110492195]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [chat_category] = &apos;rider&apos; THEN [rider_first_reply_time] ELSE 0 END)&#10;/ &#10;[# Served Customer Chats (copy)_5273292999111221287]&#10;/ &#10;60' />
            </column>
            <column caption='KPIs' datatype='real' name='[Calculation_1460151492850184192]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;  WHEN &apos;#Messages&apos; THEN SUM([total_messages_sent])&#10;  WHEN &apos;#Chats&apos; THEN SUM([total_chat_sessions])&#10;  WHEN &apos;Contact Rate&apos; THEN [Calculation_2658742306123100161]&#10;  WHEN &apos;Chat Rate&apos; THEN [Calculation_5273292997749370884]&#10;END' />
            </column>
            <column caption='Contact Rate' datatype='real' default-format='p0.00%' name='[Calculation_2658742306123100161]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Has Contact (copy)_2658742306121293824] = &apos;true&apos; THEN [total_chat_sessions] END)&#10;/ SUM([total_chat_sessions])' />
            </column>
            <column caption='Hide &apos;no chat&apos; Chats' datatype='string' name='[Calculation_2858167334480240640]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [chat_category] = &apos;no chat&apos; THEN &apos;Hide&apos; ELSE &apos;Show&apos; END' />
            </column>
            <column caption='Dimension' datatype='string' name='[Calculation_3190096707021156352]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 6]=&apos;Country&apos; THEN [country]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;DH Regions&apos; THEN [dh_region]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Contact Center&apos; THEN [contact_center]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Management Entity&apos; THEN [management_entity_group]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Device Type&apos; THEN [device_type]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Global&apos; THEN &apos;Global&apos;&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Has Contact&apos; THEN [Has Contact (copy)_2658742306121293824]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Image Attachment Used&apos; THEN [has_image]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Contact Reason L1&apos; THEN [contact_reason_l1]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Contact Reason L2&apos; THEN [contact_reason_l2]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Contact Reason L3&apos; THEN [contact_reason_l3]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Rider Contact Reason L1&apos; THEN [rider_contact_reason_l1]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Rider Contact Reason L2&apos; THEN [rider_contact_reason_l2]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Rider Contact Reason L3&apos; THEN [rider_contact_reason_l3]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Is Webapp&apos; THEN [is_webapp]&#10;&#10;END' />
            </column>
            <column caption='Chat Rate' datatype='real' default-format='p0.0%' name='[Calculation_5273292997749370884]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_chat_sessions]) &#10;/ &#10;SUM([Calculation_725431432629899264])' />
            </column>
            <column caption='Granularity' datatype='string' name='[Calculation_5273292997752655886]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Chose Dimension (Columns) (copy)_526358231437660160]&#10;    WHEN &apos;Daily&apos; THEN STR([iso_date])&#10;    WHEN &apos;Weekly&apos; THEN [week]&#10;    WHEN &apos;Monthly&apos; THEN [month]&#10;END' />
            </column>
            <column caption='Filter dates' datatype='boolean' name='[Calculation_6934276795705569280]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[iso_date (copy)_5273292999113953321] != TODAY()' />
            </column>
            <column caption='Total Gross Orders' datatype='integer' name='[Calculation_725431432629899264]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// because orders are duplicated for each row with the same combination of GE ID and Date&#10;&#10;{ FIXED [global_entity_id], [iso_date] : MAX([gross_orders]) }' />
            </column>
            <column caption='Rider Response Rate' datatype='real' name='[Customer Response Rate (copy)_5273292999101063187]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [chat_category] = &apos;customer&apos; THEN [total_served_chats] ELSE 0 END)&#10;/ &#10;SUM(IF [chat_category] = &apos;customer&apos; THEN [total_chat_sessions] ELSE 0 END)' />
            </column>
            <column caption='Has Contact - string' datatype='string' datatype-customized='true' name='[Has Contact (copy)_2658742306121293824]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [has_contact] = TRUE THEN &apos;true&apos;&#10;ELSE &apos;false&apos;&#10;END' />
            </column>
            <column caption='KPIs Label' datatype='real' default-format='*#,##0.0;0.0%' name='[KPIs (copy)_1976376600230649858]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;  WHEN &apos;#Messages&apos; THEN SUM([total_messages_sent])&#10;  WHEN &apos;#Chats&apos; THEN SUM([total_chat_sessions])&#10;  WHEN &apos;Contact Rate&apos; THEN -[Calculation_2658742306123100161]&#10;  WHEN &apos;Chat Rate&apos; THEN -[Calculation_5273292997749370884]&#10;END' />
            </column>
