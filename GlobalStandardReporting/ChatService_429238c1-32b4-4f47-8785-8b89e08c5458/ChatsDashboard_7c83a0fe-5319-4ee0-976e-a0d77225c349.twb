              <calculation class='tableau' formula='IFNULL(&#10;SUM(IF [has_image] = &apos;true&apos; THEN [total_messages_sent] ELSE 0 END)&#10;/ &#10;SUM(IF [has_image] = &apos;true&apos; THEN [total_chat_sessions] ELSE 0 END)&#10;,0)' />
