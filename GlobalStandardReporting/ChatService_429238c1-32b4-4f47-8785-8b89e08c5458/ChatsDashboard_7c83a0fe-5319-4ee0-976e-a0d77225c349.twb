            </column>
            <column caption='Dimension' datatype='string' name='[Calculation_3190096707021156352]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 6]=&apos;Country&apos; THEN [country]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;DH Regions&apos; THEN [dh_region]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Contact Center&apos; THEN [contact_center]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Management Entity&apos; THEN [management_entity_group]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Device Type&apos; THEN [device_type]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Global&apos; THEN &apos;Global&apos;&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Has Contact&apos; THEN [Has Contact (copy)_2658742306121293824]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Image Attachment Used&apos; THEN [has_image]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Contact Reason L1&apos; THEN [contact_reason_l1]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Contact Reason L2&apos; THEN [contact_reason_l2]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Contact Reason L3&apos; THEN [contact_reason_l3]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Rider Contact Reason L1&apos; THEN [rider_contact_reason_l1]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Rider Contact Reason L2&apos; THEN [rider_contact_reason_l2]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Rider Contact Reason L3&apos; THEN [rider_contact_reason_l3]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Is Webapp&apos; THEN [is_webapp]&#10;&#10;END' />
            </column>
            <column caption='Avg. response time (min)' datatype='real' name='[Calculation_3581698733181628416]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([sum_time_to_respond_sec] / 60) / [count_responses]' />
            </column>
            <column caption='P2P Fail Rate' datatype='real' default-format='p0.0%' name='[Calculation_4484107513828192256]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_cancelled] = &apos;1&apos; AND [is_in_cancellation_reasons] = 1 THEN 1 ELSE 0 END)/ SUM([total_chat_sessions])' />
            </column>
            <column caption='% Messages Read by Customers' datatype='real' default-format='p0.0%' name='[Calculation_4623789461310492672]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_rider_messages_read]) / SUM([total_rider_messages])' />
            </column>
            <column caption='% Valid Chats' datatype='real' name='[Calculation_5273292997748850691]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_chat_sessions])&#10;/&#10;SUM([total_sessions])' />
            </column>
            <column caption='Chat Rate' datatype='real' default-format='p0.0%' name='[Calculation_5273292997749370884]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_chat_sessions]) &#10;/ &#10;SUM([Calculation_725431432629899264])' />
            </column>
            <column caption='# Customer Initiated Chats' datatype='integer' name='[Calculation_5273292997749710853]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF[chat_category] = &apos;customer&apos; THEN [total_chat_sessions] ELSE 0 END)' />
            </column>
            <column caption='% Customer Initiated Chats' datatype='real' name='[Calculation_5273292997750312967]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5273292997749710853]&#10;/&#10;SUM([total_chat_sessions])' />
            </column>
            <column caption='Avg. Message per Chat' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_5273292997750902793]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_messages_sent])&#10;/ &#10;SUM([total_chat_sessions])' />
            </column>
            <column caption='% Missed Chats' datatype='real' default-format='p0.0%' name='[Calculation_5273292997751230474]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_missed_chats]) &#10;/ &#10;SUM([total_chat_sessions])' />
            </column>
            <column caption='Avg. Duration Served (min)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_5273292997751820300]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([served_chat_duration]) &#10;/ &#10;SUM([total_served_chats])&#10;/ &#10;60' />
            </column>
            <column caption='Granularity' datatype='string' name='[Calculation_5273292997752655886]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Chose Dimension (Columns) (copy)_526358231437660160]&#10;    WHEN &apos;Daily&apos; THEN STR([iso_date])&#10;    WHEN &apos;Weekly&apos; THEN [week]&#10;    WHEN &apos;Monthly&apos; THEN [month]&#10;END' />
            </column>
            <column caption='% Web Chats' datatype='real' name='[Calculation_5273292999097171983]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([web_chats]) &#10;/ &#10;SUM([total_chat_sessions])' />
            </column>
            <column caption='Customer Response Rate' datatype='real' name='[Calculation_5273292999099621394]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [chat_category] = &apos;rider&apos; THEN [total_served_chats] ELSE 0 END)&#10;/ &#10;SUM(IF [chat_category] = &apos;rider&apos; THEN [total_chat_sessions] ELSE 0 END)&#10;// proportion of chats where the customer answers to chats initiated by a rider //' />
            </column>
            <column caption='Avg. Customer Messages per Chat' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_5273292999102992406]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[# Last Message sent by Rider (copy)_5273292999101837333]&#10;/ &#10;SUM([total_chat_sessions])' />
            </column>
            <column caption='Avg. FRT for Customer Chats (min)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_5273292999103918105]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [chat_category] = &apos;customer&apos; THEN [rider_first_reply_time] ELSE 0 END)&#10;/ &#10;[Calculation_5273292999104880667]&#10;/&#10;60' />
            </column>
            <column caption='% Customer First  Chats' datatype='real' default-format='p0.0%' name='[Calculation_5273292999104430106]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([customer_first_chats]) &#10;/ &#10;SUM([total_chat_sessions])' />
            </column>
            <column caption='# Served Customer Chats' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_5273292999104880667]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(If [chat_category] = &apos;customer&apos; THEN [total_served_chats] ELSE 0 END)' />
            </column>
            <column caption='Count Total Images' datatype='integer' name='[Calculation_5750322680181239808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([count_total_images], 0)' />
            </column>
            <column caption='Count Customer Locations' datatype='integer' name='[Calculation_5750322680182718465]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([count_customer_locations],0)' />
