      <column caption='First order failrate' datatype='real' name='[Calculation_120682443363627010]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendors_with_first_order_failed])/SUM([num_opportunties])' />
      </column>
      <column caption='% Vendors with valid orders F30D' datatype='real' name='[Calculation_120682443364028419]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendors_with_valid_orders]) / SUM([num_opportunties])' />
      </column>
      <column caption='Num of Incindences per Vendor with Incidence' datatype='real' name='[Calculation_120682443364413444]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_f30d_incidences])/(SUM([num_opportunties])-SUM([vendors_with_zero_incidence]))' />
      </column>
      <column caption='% Vendors with Incidecne F30D' datatype='real' name='[Calculation_120682443365122053]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([num_opportunties])-SUM([vendors_with_zero_incidence]))/SUM([num_opportunties])' />
      </column>
      <column caption='Entity Granularity' datatype='string' name='[Calculation_189573444203429888]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Global&apos; THEN &apos;Global&apos;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Segment&apos; THEN [segment]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Management Entity&apos; THEN [management_entity]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Sub Entity&apos; THEN [sub_entity]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Country&apos; THEN [country]&#10;END' />
      </column>
      <column caption='Latest Date' datatype='boolean' name='[Calculation_392094696701046784]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [time_granularity] = &apos;monthly&apos; THEN [sf_incubation_date] = {fixed [time_granularity]:max(If [time_granularity] = &apos;Monthly&apos; then [sf_incubation_date] end)}&#10;ELSEIF [time_granularity] = &apos;quarterly&apos; THEN [sf_incubation_date] = {fixed [time_granularity]:max(If [time_granularity] = &apos;Quarterly&apos; then [sf_incubation_date] end)}&#10;END' />
      </column>
      <column caption='Period End' datatype='date' name='[Calculation_392094696708890628]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IF MAX([time_granularity]) = &apos;Week&apos; THEN &#10;    IF LAST() = 0 THEN DATE(DATEADD(&apos;day&apos;, -1, DATEADD(&apos;week&apos;, 1, MAX([sf_incubation_date])))) END&#10;ELSEIF MAX([time_granularity]) = &apos;Month&apos; THEN &#10;    IF LAST() = 0 THEN DATE(DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, MAX([sf_incubation_date])))) END&#10;ELSEIF MAX([time_granularity]) = &apos;Quarter&apos; THEN &#10;    IF LAST() = 0 THEN DATE(DATEADD(&apos;day&apos;, -1, DATEADD(&apos;quarter&apos;, 1, MAX([sf_incubation_date])))) END &#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='dynamic_date' datatype='string' name='[Calculation_5137410964210970624]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [time_granularity] &#10;WHEN &apos;Week&apos; THEN RIGHT(STR(YEAR([sf_incubation_date])), 2)+&quot;-&quot;+&quot;W&quot;+RIGHT(&quot;0&quot;+STR(WEEK([sf_incubation_date])),2)&#10;WHEN &apos;Month&apos; THEN RIGHT(STR(YEAR([sf_incubation_date])), 2)+&quot;-&quot;+RIGHT(&quot;0&quot;+STR(MONTH([sf_incubation_date])),2)&#10;WHEN &apos;Quarter&apos; THEN RIGHT(STR(YEAR([sf_incubation_date])), 2)+&quot;-&quot;+&quot;Q&quot;+STR(QUARTER([sf_incubation_date]))&#10;END' />
      </column>
      <column caption='Startdate' datatype='date' name='[Calculation_5137410964221939715]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [time_granularity]&#10;WHEN &apos;Week&apos; then (IF(DATEDIFF(&apos;month&apos;,[sf_incubation_date],TODAY())&lt;= [Parameters].[Parameter 2]) THEN [sf_incubation_date] END)&#10;WHEN &apos;Month&apos; then (IF(DATEDIFF(&apos;month&apos;,[sf_incubation_date],TODAY())&lt;=[Parameters].[Parameter 2]) THEN [sf_incubation_date] END)&#10;WHEN &apos;Quarter&apos; then (IF(DATEDIFF(&apos;month&apos;,[sf_incubation_date],TODAY())&lt;=[Parameters].[Parameter 2]) THEN [sf_incubation_date] END)&#10;END' />
      </column>
      <column caption='time_parameter' datatype='boolean' name='[Calculation_5227623695334797312]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;  WHEN &apos;Week&apos; THEN [time_granularity] = &apos;Week&apos;&#10;  WHEN &apos;Month&apos; THEN [time_granularity] = &apos;Month&apos;&#10;  WHEN &apos;Quarter&apos; THEN [time_granularity] = &apos;Quarter&apos;&#10;END' />
      </column>
