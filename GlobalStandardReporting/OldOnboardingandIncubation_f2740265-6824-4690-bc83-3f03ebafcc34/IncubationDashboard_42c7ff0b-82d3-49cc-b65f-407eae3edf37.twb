      <column caption='Failrate F30D' datatype='real' default-format='p0.00%' name='[Calculation_120682443362025472]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_f30d_failed_orders])/SUM([num_f30d_gross_orders])' />
      </column>
      <column caption='Days to first valid order' datatype='real' name='[Calculation_120682443363307521]' role='measure' type='quantitative'>
