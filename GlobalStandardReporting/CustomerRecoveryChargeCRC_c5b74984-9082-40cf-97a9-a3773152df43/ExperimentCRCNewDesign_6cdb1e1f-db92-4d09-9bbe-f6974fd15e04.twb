            <column-instance column='[customer_failed_orders]' derivation='Sum' name='[sum:customer_failed_orders:qk]' pivot='key' type='quantitative' />
            <column-instance column='[% Contact Rate [Vendor&amp;Customer]] (copy)_50876604578615297]' derivation='User' name='[usr:% Contact Rate [Vendor&amp;Customer]] (copy)_50876604578615297:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Vendor Fail Rate Delta (copy)_50876604591833091]' derivation='User' name='[usr:Vendor Fail Rate Delta (copy)_50876604591833091:qk]' pivot='key' type='quantitative' />
            <column caption='Vendor Grade' datatype='string' name='[vendor_grade]' role='dimension' type='nominal' />
