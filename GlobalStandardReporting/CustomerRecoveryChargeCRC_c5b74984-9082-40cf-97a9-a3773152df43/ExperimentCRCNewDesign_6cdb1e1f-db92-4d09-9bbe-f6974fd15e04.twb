    <worksheet name='[Metrics Name] Seemless Orders'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Medium' fontsize='9'>(Pre-Post ∆ Divergence)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='simple_flow_contact_customer_experiment+ (Multiple Connections)' name='federated.0hr6f8u087m4kg1bqrbfm17yze5s' />
          </datasources>
          <datasource-dependencies datasource='federated.0hr6f8u087m4kg1bqrbfm17yze5s'>
            <column caption='[A] % Vendor Customer Contact Rate (Pre-Post ∆ Divergence) ' datatype='real' name='[% Vendor Contact Rate (Pre-Post ∆ Divergence) (copy)_147492907178180608]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &quot;Variant A&quot; AND [rollout_phase] = &apos;POST&apos; THEN [vendor_customer_contacts] END)&#10;    /&#10;    SUM(IF [experiment_group] = &quot;Variant A&quot; AND [rollout_phase] = &apos;POST&apos; THEN [orders] END)&#10;    })&#10;&#10;    -&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;POST&apos; THEN [vendor_customer_contacts] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;POST&apos; THEN [orders] END)&#10;    })&#10;)&#10;-&#10;(&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &quot;Variant A&quot; AND [rollout_phase] = &apos;PRE&apos; THEN [vendor_customer_contacts] END)&#10;    /&#10;    SUM(IF [experiment_group] = &quot;Variant A&quot; AND [rollout_phase] = &apos;PRE&apos; THEN [orders] END)&#10;    })&#10;    -&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;PRE&apos; THEN [vendor_customer_contacts] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;PRE&apos; THEN [orders] END)&#10;    })&#10;)' />
            </column>
            <column caption='[A] % Vendor Fail Rate (Pre-Post ∆ Divergence)' datatype='real' name='[% Vendor Fail Rate (Pre-Post ∆ Divergence) (copy)_147492907178672130]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &quot;Variant A&quot; AND [rollout_phase] = &apos;POST&apos; THEN [vendor_failed_orders] END)&#10;    /&#10;    SUM(IF [experiment_group] = &quot;Variant A&quot; AND [rollout_phase] = &apos;POST&apos; THEN [orders] END)&#10;    })&#10;&#10;    -&#10;&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;POST&apos; THEN [vendor_failed_orders] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;POST&apos; THEN [orders] END)&#10;    })&#10;)&#10;-&#10;(&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &quot;Variant A&quot; AND [rollout_phase] = &apos;PRE&apos; THEN [vendor_failed_orders] END)&#10;    /&#10;    SUM(IF [experiment_group] = &quot;Variant A&quot; AND [rollout_phase] = &apos;PRE&apos; THEN [orders] END)&#10;    })&#10;    -&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;PRE&apos; THEN [vendor_failed_orders] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;PRE&apos; THEN [orders] END)&#10;    })&#10;)' />
            </column>
            <column caption='[A] Seemless Orders' datatype='real' name='[Calculation_147492907180257284]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ABS([% Vendor Contact Rate (Pre-Post ∆ Divergence) (copy)_147492907178180608]&#10;+ [% Vendor Fail Rate (Pre-Post ∆ Divergence) (copy)_147492907178672130])' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_4565524148946345986]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [date_type]&#10;WHEN &quot;Daily&quot; THEN STR(DATE([created_date_local]))&#10;WHEN &quot;Weekly&quot; THEN STR(YEAR([created_date_local]))+&quot;-W&quot;+STR([weeks])&#10;END' />
            </column>
            <column caption='Created Date Local' datatype='date' name='[created_date_local]' role='dimension' type='ordinal' />
            <column caption='Date Type' datatype='string' name='[date_type]' role='dimension' type='nominal' />
