    <worksheet name='Metric Names'>
      <table>
        <view>
          <datasources>
            <datasource caption='simple_flow_contact_customer_experiment+ (Multiple Connections)' name='federated.0hr6f8u087m4kg1bqrbfm17yze5s' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Date Level' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
            <column alias='Variant A' caption='Select Variant' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Variant A&quot;'>
              <calculation class='tableau' formula='&quot;Variant A&quot;' />
              <aliases>
                <alias key='&quot;Variant A&quot;' value='Variant A' />
                <alias key='&quot;Variant B&quot;' value='Variant B' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0hr6f8u087m4kg1bqrbfm17yze5s'>
            <column caption='% Offline Duration' datatype='real' default-format='p0.000%' name='[%  Live Order Inquiries Contact Rate    (copy)_4868320897011572743]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([offline_duration])&#10;    /&#10;    SUM([schedule_duration])' />
            </column>
            <column caption='% Contact Rate [Vendor&amp;Customer] (∆ Divergence)   ' datatype='real' name='[%  Live Order Inquiries Contact Rate (∆ Divergence) (copy 2)_7010697278633095197]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;POST&apos; THEN [vendor_customer_contacts] END)&#10;    /&#10;    SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;POST&apos; THEN [orders] END)&#10;    })&#10;&#10;    /&#10;&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;POST&apos; THEN [vendor_customer_contacts] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;POST&apos; THEN [orders] END)&#10;    })&#10;&#10;    - 1&#10;)&#10;-&#10;(&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;PRE&apos; THEN [vendor_customer_contacts] END)&#10;    /&#10;    SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;PRE&apos; THEN [orders] END)&#10;    })&#10;    /&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;PRE&apos; THEN [vendor_customer_contacts] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;PRE&apos; THEN [orders] END)&#10;    })&#10;    - 1&#10;)' />
            </column>
            <column caption='Orders (∆ Divergence)' datatype='real' name='[%  Simple Flow Orders (∆ Divergence) (copy)_4565524149299990563]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    SUM({ INCLUDE [date_type]:&#10; &#10;    SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;POST&apos; THEN [orders] END)&#10;    })&#10;&#10;    /&#10;&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;POST&apos; THEN [orders] END)&#10;    })&#10;&#10;    - 1&#10;)&#10;-&#10;(&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;PRE&apos; THEN [orders] END)&#10;    })&#10;    /&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;PRE&apos; THEN [orders] END)&#10;    })&#10;    - 1&#10;)' />
            </column>
            <column caption='%  Product Unavailable Contact Rate (∆ Divergence)' datatype='real' name='[% Customer Contact Rate (∆ Divergence) (copy)_4565524149148491787]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;POST&apos; THEN [product_unavailable_contacts] END)&#10;    /&#10;    SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;POST&apos; THEN [orders] END)&#10;    })&#10;&#10;    /&#10;&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;POST&apos; THEN [product_unavailable_contacts] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;POST&apos; THEN [orders] END)&#10;    })&#10;&#10;    - 1&#10;)&#10;-&#10;(&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;PRE&apos; THEN [product_unavailable_contacts] END)&#10;    /&#10;    SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;PRE&apos; THEN [orders] END)&#10;    })&#10;    /&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;PRE&apos; THEN [product_unavailable_contacts] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;PRE&apos; THEN [orders] END)&#10;    })&#10;    - 1&#10;)' />
