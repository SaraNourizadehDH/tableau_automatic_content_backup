customer_changes_within_same_day+ customer_changes_within_10_days+ customer_changes_within_11_20_days+ customer_changes_within_21_30_days+customer_changes_within_31_60_days customer_changes_within_60_days, customer_changes_within_same_day+ customer_changes_within_10_days+ customer_changes_within_11_20_days+ customer_changes_within_21_30_days+customer_changes_within_31_60_days+ customer_changes_within_61_90_days customer_changes_within_90_days,
 customer_changes_within_same_day+ customer_changes_within_10_days+ customer_changes_within_11_20_days+ customer_changes_within_21_30_days+customer_changes_within_31_60_days+ customer_changes_within_61_90_days +customer_changes_within_91_180_days customer_changes_within_180_days,
  customer_changes_within_same_day+ customer_changes_within_10_days+ customer_changes_within_11_20_days+ customer_changes_within_21_30_days+customer_changes_within_31_60_days+ customer_changes_within_61_90_days +customer_changes_within_91_180_days +customer_changes_within_181_365_days customer_changes_within_365_days,
  customer_changes_after_365_days
FROM `dhub-cdp.data_quality.dq_cdp_phone_change_events_summary` WHERE 
partition_date in (select min(partition_date) from `dhub-cdp.data_quality.dq_cdp_phone_change_events_summary`
where EXTRACT(YEAR FROM date(partition_date))= EXTRACT(YEAR FROM current_date))</relation>
