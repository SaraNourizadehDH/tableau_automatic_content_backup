  <worksheets>
    <worksheet name='Behaviour Change Summary'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontsize='12'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='dq_cdp_phone_change_events_summary (data_quality) ' name='federated.0viz5b4191dtwn1gtl90c12iuap0 (copy 2)' />
          </datasources>
          <datasource-dependencies datasource='federated.0viz5b4191dtwn1gtl90c12iuap0 (copy 2)'>
            <column caption='Calculation Date' datatype='date' name='[Calculation_45950825915346944]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE([partition_date])' />
            </column>
            <column caption='% Customers with Phone Changes' datatype='real' name='[Calculation_45950825936183303]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([customers_with_2_to_10_phones]+[customers_with_more_than_10_phones])/[total_customers]' />
            </column>
            <column caption='% of Phones with Duplicated Customers' datatype='real' name='[Calculation_45950825939783689]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([phones_with_2_to_10_phones]+[phones_with_more_than_10_customers])/[total_phones]' />
            </column>
            <column caption='% Customer Changes Within one Day' datatype='real' name='[Calculation_45950825941147659]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[customer_changes_within_same_day]/([customers_with_2_to_10_phones]+[customers_with_more_than_10_phones])' />
            </column>
            <column caption='% Customer Changes Within 10 Days' datatype='real' name='[Calculation_45950825941606412]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([customer_changes_within_10_days]+[customer_changes_within_same_day])/([customers_with_2_to_10_phones]+[customers_with_more_than_10_phones])' />
            </column>
            <column caption='% Customer Changes Within 20 Days' datatype='real' name='[Calculation_45950825942056973]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([customer_changes_within_11_20_days]+[customer_changes_within_10_days]+[customer_changes_within_same_day])/([customers_with_2_to_10_phones]+[customers_with_more_than_10_phones])' />
            </column>
            <column caption='% Customer Changes Within 30 Days' datatype='real' name='[Calculation_45950825942216718]' role='measure' type='quantitative'>
