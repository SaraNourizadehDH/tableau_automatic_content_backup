        <objects>
          <object caption='First Date Data' id='_F5D3899D85F043A7939BD26FB3EFF49C'>
            <properties context=''>
              <relation connection='bigquery.1edu92i1f6p36j1fgu58a0556p8g (copy 2)' name='Custom SQL Query' type='text'>SELECT partition_date as minimum_date_of_year,global_entity_id,total_customers,total_phones,
(customers_with_more_than_10_phones+customers_with_2_to_10_phones) as customers_with_more_than_2_phones,
(phones_with_2_to_10_phones+ phones_with_more_than_10_customers) as phones_with_multiple_customers,
(customers_with_1_phone+ customers_with_2_to_10_phones+ customers_with_more_than_10_phones) as customers_with_phone,
customer_changes_within_same_day,
customer_changes_within_same_day+ customer_changes_within_10_days customer_changes_within_10_days, customer_changes_within_same_day+ customer_changes_within_10_days+ customer_changes_within_11_20_days customer_changes_within_20_days,
