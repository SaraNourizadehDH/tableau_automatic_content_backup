      </column>
      <column caption='Timeframe' datatype='string' name='[Calculation_1825576355037630464]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;day&apos; THEN STR(DAY([order_date])) + &apos; &apos; + LEFT(DATENAME(&apos;month&apos;,[order_date]),3) +&apos; &apos;+ RIGHT(STR(YEAR([order_date])),2)&#10;WHEN &apos;week&apos; THEN LEFT(STR(DATETRUNC(&apos;week&apos;,date([order_date]),&apos;Monday&apos;)),10)&#10;WHEN &apos;month&apos; THEN LEFT(DATENAME(&apos;month&apos;,[order_date]),3) + &apos; &apos; + STR(YEAR([order_date]))&#10;//WHEN &apos;quarter&apos; THEN &apos;Q&apos;+STR(DATEPART(&apos;quarter&apos;,[Order Date])) + &apos; &apos; + STR(YEAR([Order Date]))&#10;END' />
      </column>
      <column caption='Total' datatype='real' name='[Calculation_564286984370118656]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN 1 THEN [total_count_orders]&#10;WHEN 2 THEN [total_amount_eur]&#10;END' />
      </column>
      <column caption='False Negatives - Glovo' datatype='real' name='[Calculation_564286984370733059]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN 1 THEN [count_fn_gv_flag]&#10;WHEN 2 THEN [amt_fn_gv_flag]&#10;END' />
      </column>
      <column caption='Agg - False Negatives - Glovo' datatype='real' default-format='p0.00%' name='[Calculation_564286984371630088]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL([Calculation_564286984370733059],0))/SUM([Calculation_564286984370118656])' />
      </column>
      <column caption='Refund Rate' datatype='real' default-format='p0.00%' name='[Calculation_564286984372547595]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL([total_refund_amt_eur],0))/SUM([total_amount_eur])' />
      </column>
      <column caption='Dimension 1' datatype='string' name='[Calculation_564286984380194829]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Global Entity Id&apos; THEN [global_entity_id]&#10;WHEN &apos;Timeframe&apos; THEN [Calculation_1825576355037630464]&#10;WHEN &apos;Payment Type&apos; THEN [payment_type]&#10;WHEN &apos;Platform&apos; THEN [platform]&#10;WHEN &apos;Region&apos; THEN [region]&#10;END' />
