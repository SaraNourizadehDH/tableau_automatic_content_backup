      <column caption='Agg - False Positives - Glovo' datatype='real' default-format='p0.00%' name='[Agg - False Negatives - Glovo (copy)_564286984372391945]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL([False Negatives - Glovo (copy)_564286984371138564],0))/SUM([Calculation_564286984370118656])' />
      </column>
      <column caption='Agg - False Negatives - HS' datatype='real' default-format='p0.00%' name='[Agg - False Negatives - Glovo (copy)_564286984372494346]' role='measure' type='quantitative'>
