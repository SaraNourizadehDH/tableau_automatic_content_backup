          <datasource-dependencies datasource='Parameters'>
            <column alias='Alert' caption='Model Flags' datatype='string' datatype-customized='true' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;alert&quot;'>
              <calculation class='tableau' formula='&quot;alert&quot;' />
              <aliases>
                <alias key='&quot;alert&quot;' value='Alert' />
                <alias key='&quot;anomaly&quot;' value='Anomaly Score' />
                <alias key='&quot;deact&quot;' value='Deactivated Metric' />
                <alias key='&quot;delete&quot;' value='Deleted Metric' />
                <alias key='&quot;drift&quot;' value='Drifted Metric' />
                <alias key='&quot;missing&quot;' value='Missing Metric' />
              </aliases>
            </column>
            <column alias='Only Flagged' caption='Show only flagged?' datatype='integer' datatype-customized='true' name='[Parameter 9]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='0' value='Show All' />
                <alias key='1' value='Only Flagged' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0nmz43612ptrkm1adc7ig14zqhy1'>
            <column caption='Is Alert.Int' datatype='integer' name='[Calculation_1613414586920431621]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(IIF([is_alert], 1,0))' />
            </column>
            <column caption='Model' datatype='string' name='[Calculation_2613776656022093828]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(&apos;[&apos;)+[region]+STR(&apos;] &apos;) &#10;+ [model_id] &#10;+ STR(&apos;_&apos;)+[model_version]' />
            </column>
            <column caption='show_only_flagged' datatype='boolean' name='[Calculation_3142879259791720448]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{FIXED [Calculation_2613776656022093828]: MAX([Calculation_1613414586920431621])}&gt;=[Parameters].[Parameter 9]' />
            </column>
            <column caption='Model Flags.colors' datatype='string' name='[Calculation_3620894122550165504]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;alert&apos; THEN STR([is_alert])&#10;WHEN &apos;anomaly&apos; THEN STR([anomaly_score])&#10;WHEN &apos;deact&apos; THEN STR([is_metric_deactivated])&#10;WHEN &apos;delete&apos; THEN STR([is_metric_deleted])&#10;WHEN &apos;drift&apos; THEN STR([is_metric_drifted])&#10;WHEN &apos;missing&apos; THEN STR([is_metric_missing])&#10;ELSE NULL END' />
              <aliases>
                <alias key='&quot;f&quot;' value='No' />
                <alias key='&quot;t&quot;' value='Yes' />
              </aliases>
            </column>
            <column caption='Model Flags Note' datatype='string' name='[Calculation_4774448946599997466]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;anomaly&apos; THEN [anomaly_segment]&#10;WHEN &apos;alert&apos; THEN &quot;Anomaly Segment: &quot;+[anomaly_segment]+&quot;, Anomaly Score: &quot;+str([anomaly_score])&#10;WHEN &apos;deact&apos; THEN [deactivated_metrics]&#10;WHEN &apos;delete&apos; THEN [deleted_metrics]&#10;WHEN &apos;drift&apos; THEN [drifted_metrics] &#10;WHEN &apos;missing&apos; THEN [missing_metrics] &#10;END' />
            </column>
            <column caption='Anomaly Score' datatype='integer' name='[anomaly_score]' role='measure' type='quantitative' />
            <column caption='Anomaly Segment' datatype='string' name='[anomaly_segment]' role='dimension' type='nominal' />
