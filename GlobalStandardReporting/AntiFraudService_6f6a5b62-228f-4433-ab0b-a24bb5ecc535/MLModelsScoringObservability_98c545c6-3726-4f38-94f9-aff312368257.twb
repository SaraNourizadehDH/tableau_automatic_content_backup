      <column caption='Review.Metric' datatype='real' name='[Approve.Metric (copy)_4774448946538131464]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1 1]&#10;WHEN 0 THEN [total_review_orders]&#10;WHEN 1 THEN [total_review_customers]&#10;WHEN 2 THEN [total_review_amount_eur]&#10;WHEN 3 THEN [region_review_share]*100&#10;ELSE NULL END' />
      </column>
      <column caption='Decline.Metric' datatype='real' name='[Approve.Metric (copy)_4774448946538291209]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1 1]&#10;WHEN 0 THEN [total_decline_orders]&#10;WHEN 1 THEN [total_decline_customers]&#10;WHEN 2 THEN [total_decline_amount_eur]&#10;WHEN 3 THEN [region_decline_share]*100&#10;ELSE NULL END' />
      </column>
      <column caption='Fraud Block' datatype='real' name='[Approve.param (copy)_4774448946550710293]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 7] = &quot;Fraud Block&quot;, [FP.param (copy)_4774448946549477394], NULL)' />
      </column>
      <column caption='Decline.param' datatype='real' name='[Approve.param (copy)_6803813157208653826]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Parameters].[Hide Min/Max values? (copy)_1785747640032542720] = &quot;Decline&quot;, sum([Approve.Metric (copy)_4774448946538291209]), NULL)' />
      </column>
      <column caption='Review.param' datatype='real' name='[Approve.param (copy)_6803813157208788995]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Parameters].[Hide Min/Max values? (copy)_1785747640032542720] = &quot;Review&quot;, sum([Approve.Metric (copy)_4774448946538131464]), NULL)' />
      </column>
      <column caption='Metric Deactivated' datatype='integer' datatype-customized='true' name='[Calculation_153896461067091968]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT([is_metric_deactivated] OR [is_metric_deactivated_7d])' />
      </column>
      <column caption='Metric Deleted' datatype='integer' datatype-customized='true' name='[Calculation_153896461067276289]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT([is_metric_deleted] OR [is_metric_deleted_7d])' />
      </column>
      <column caption='Metric Drifted' datatype='integer' datatype-customized='true' name='[Calculation_153896461067337730]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT([is_metric_drifted] OR [is_metric_drifted_7d])' />
      </column>
      <column caption='Metric Missing' datatype='integer' datatype-customized='true' name='[Calculation_153896461067399171]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT([is_metric_missing] OR [is_metric_missing_7d])' />
      </column>
      <column caption='Order Date.Alert Date parameter' datatype='boolean' name='[Calculation_1613414586872647680]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1]=[order_date]' />
      </column>
      <column caption='Is Alert.size' datatype='integer' name='[Calculation_1613414586873921537]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([is_alert],1,0)' />
      </column>
      <column caption='Is Alert.Int' datatype='integer' name='[Calculation_1613414586920431621]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(IIF([is_alert], 1,0))' />
      </column>
      <column caption='Is Model Friction Anomaly.Int' datatype='integer' name='[Calculation_1613414586925912072]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX(IIF([is_model_friction_anomaly],1,0))' />
      </column>
      <column caption='Is Model Fraud Blocked Anomaly.Int' datatype='integer' name='[Calculation_1613414586928128010]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX(IIF([is_model_fraud_blocked_anomaly],1,0))' />
      </column>
      <column caption='Is Metric Deactivated?' datatype='integer' name='[Calculation_1613414586956800025]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(IIF([is_metric_deactivated],1,0))' />
      </column>
      <column caption='Order Date.MAX LOD' datatype='date' name='[Calculation_2559874197195313152]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{MAX([order_date])}' />
      </column>
      <column caption='p90.param' datatype='real' name='[Calculation_2613776656017731585]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 4] = &quot;P90&quot; OR [Parameters].[Parameter 4] = &quot;All&quot;, [p90], NULL)' />
      </column>
      <column caption='Model' datatype='string' name='[Calculation_2613776656022093828]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(&apos;[&apos;)+[region]+STR(&apos;] &apos;) &#10;+ [model_id] &#10;+ STR(&apos;_&apos;)+[model_version]' />
      </column>
      <column caption='Percentile' datatype='real' name='[Calculation_2613776656035377160]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &quot;P10&quot; THEN [p10]&#10;WHEN &quot;P25&quot; THEN [p25]&#10;WHEN &quot;P50&quot; THEN [p50]&#10;WHEN &quot;P75&quot; THEN [p75]&#10;WHEN &quot;P90&quot; THEN [p90]&#10;WHEN &quot;P95&quot; THEN [p95]&#10;WHEN &quot;P99&quot; THEN [p99]&#10;END' />
      </column>
      <column caption='Is Model Friction Anomaly?' datatype='integer' name='[Calculation_2613776656532582413]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT([is_model_friction_anomaly] OR [is_model_friction_share_anomaly])' />
      </column>
      <column caption='Approve.Metric' datatype='real' name='[Calculation_2815031248649113604]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1 1]&#10;WHEN 0 THEN [total_approve_orders]&#10;WHEN 1 THEN [total_approve_customers]&#10;WHEN 2 THEN [total_approve_amount_eur]&#10;WHEN 3 THEN [region_approve_share]*100&#10;ELSE NULL END' />
      </column>
      <column caption='show_only_flagged' datatype='boolean' name='[Calculation_3142879259791720448]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{FIXED [Calculation_2613776656022093828]: MAX([Calculation_1613414586920431621])}&gt;=[Parameters].[Parameter 9]' />
      </column>
      <column caption='Model Flags.colors' datatype='string' name='[Calculation_3620894122550165504]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;alert&apos; THEN STR([is_alert])&#10;WHEN &apos;anomaly&apos; THEN STR([anomaly_score])&#10;WHEN &apos;deact&apos; THEN STR([is_metric_deactivated])&#10;WHEN &apos;delete&apos; THEN STR([is_metric_deleted])&#10;WHEN &apos;drift&apos; THEN STR([is_metric_drifted])&#10;WHEN &apos;missing&apos; THEN STR([is_metric_missing])&#10;ELSE NULL END' />
        <aliases>
          <alias key='&quot;f&quot;' value='No' />
          <alias key='&quot;t&quot;' value='Yes' />
        </aliases>
      </column>
      <column caption='P90 Pct Change.param' datatype='real' name='[Calculation_4774448946527694848]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 5] = &quot;Upper Tail&quot;, [p90_pct_change], NULL)' />
      </column>
      <column caption='Fraud Block Cnt.param' datatype='real' name='[Calculation_4774448946545999883]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;WHEN &quot;Model&quot; THEN [model_fraud_blocked_orders]&#10;WHEN &quot;Region&quot; THEN [region_fraud_blocked_orders]&#10;END' />
      </column>
      <column caption='% tooltip' datatype='string' name='[Calculation_4774448946565427224]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 8]&#10;WHEN &quot;Count&quot; THEN &quot; Orders&quot;&#10;WHEN &quot;Share&quot; THEN &quot;%&quot;&#10;END' />
      </column>
      <column caption='Model Flags Note' datatype='string' name='[Calculation_4774448946599997466]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;anomaly&apos; THEN [anomaly_segment]&#10;WHEN &apos;alert&apos; THEN &quot;Anomaly Segment: &quot;+[anomaly_segment]+&quot;, Anomaly Score: &quot;+str([anomaly_score])&#10;WHEN &apos;deact&apos; THEN [deactivated_metrics]&#10;WHEN &apos;delete&apos; THEN [deleted_metrics]&#10;WHEN &apos;drift&apos; THEN [drifted_metrics] &#10;WHEN &apos;missing&apos; THEN [missing_metrics] &#10;END' />
      </column>
      <column caption='FP.param' datatype='real' name='[FP Share.param (copy)_4774448946548961297]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 8]&#10;WHEN &quot;Count&quot; THEN [Fraud Loss.param (copy)_4774448946547060749]&#10;WHEN &quot;Share&quot; THEN [FP.param (copy)_4774448946547613710]&#10;END' />
      </column>
      <column caption='FP Share.param' datatype='real' name='[FP.param (copy)_4774448946547613710]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;WHEN &quot;Model&quot; THEN [model_fp_orders_share]*100&#10;WHEN &quot;Region&quot; THEN [region_fp_orders_share]*100&#10;END' />
      </column>
      <column caption='Fraud Block.param' datatype='real' name='[FP.param (copy)_4774448946549477394]' role='measure' type='quantitative'>
