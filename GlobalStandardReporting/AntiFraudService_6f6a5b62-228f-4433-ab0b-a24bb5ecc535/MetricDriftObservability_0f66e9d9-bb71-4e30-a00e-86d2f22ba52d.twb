              <zone forceUpdate='true' h='6667' id='23' type-v2='text' w='81001' x='571' y='533'>
                <formatted-text>
                  <run fontcolor='#050038' fontname='Tableau Semibold' fontsize='20'>Information</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontname='Tableau Light'>Owner: </run>
                  <run fontname='Tableau Light'>Fintech Data - Risk Analytics (fintech_risk_analytics@deliveryhero.com)</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontname='Tableau Light'>Designed By:</run>
                  <run fontname='Tableau Light'> Daniel Lima de Souza (daniel.lima@deliveryhero.com)</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontname='Tableau Light'>Update Schedule:</run>
                  <run fontcolor='#000000' fontname='Tableau Light'>Æ </run>
                  <run fontname='Tableau Light'>Daily at 4pm CET</run>
                  <run>Æ&#10;</run>
                </formatted-text>
                <zone-style>
