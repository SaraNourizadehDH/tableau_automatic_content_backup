                <zone h='5522' id='12' name='trends_percentiles' pane-specification-id='1' param='[federated.0dvqwz01m8042f1aaj9ni0ikyh3s].[:Measure Names]' type-v2='color' w='12001' x='86785' y='64348'>
                  <zone-style>
