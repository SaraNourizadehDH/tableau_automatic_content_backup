      <column caption='Decline.param' datatype='real' name='[Approve.param (copy)_6803813157208653826]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Parameters].[Hide Min/Max values? (copy)_1785747640032542720] = &quot;Decline&quot;, sum([Impacted Approve.Metric (copy)_2815031248649330693]), NULL)' />
      </column>
      <column caption='Review.param' datatype='real' name='[Approve.param (copy)_6803813157208788995]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Parameters].[Hide Min/Max values? (copy)_1785747640032542720] = &quot;Review&quot;, sum([Impacted Decline.Metric (copy)_2815031248649457670]), NULL)' />
      </column>
      <column caption='Metric Root Name.Region.filter' datatype='boolean' name='[Calculation_2049982262659825664]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 5]=[Calculation_2049982262662291458]' />
      </column>
      <column caption='[Region] Metric' datatype='string' name='[Calculation_2049982262662291458]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(&apos;[&apos;)+[region]+STR(&apos;] &apos;) + [metric_root_name]' />
      </column>
      <column caption='Order Date.MAX.Fixed' datatype='date' name='[Calculation_2300635736856367104]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{MAX([order_date])}' />
      </column>
      <column caption='Order Date Filter' datatype='boolean' name='[Calculation_2815031247585406976]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Order Date Parameter]=[order_date]' />
      </column>
      <column caption='Prio' datatype='string' name='[Calculation_2815031247588474881]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([incident_alert]) AND NOT ISNULL([individual_alert]) THEN [individual_alert]&#10;ELSEIF ISNULL([incident_alert]) AND ISNULL([individual_alert]) THEN &apos;No alert&apos;&#10;ELSE [incident_alert]&#10;END' />
      </column>
      <column caption='Region Friction Share' datatype='real' name='[Calculation_2815031247660609538]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([region_decline_share]+[region_review_share])' />
      </column>
      <column caption='Approve.Metric' datatype='real' name='[Calculation_2815031248649113604]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN 0 THEN [total_approve_orders]&#10;WHEN 1 THEN [total_approve_customers]&#10;WHEN 2 THEN [total_approve_gmv]&#10;WHEN 3 THEN [region_approve_share]*100&#10;ELSE NULL END' />
      </column>
      <column caption='Metric Drifted_hist' datatype='boolean' name='[Calculation_2815031248661639175]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{FIXED [metric_root_name]: MAX([value_drift_flag])}&gt;=[Parameters].[Parameter 2]' />
      </column>
      <column caption='is_drifted_INT' datatype='integer' name='[Calculation_2815031248666238984]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([is_drifted], 1, 0)' />
      </column>
      <column caption='Global Entity ID.filter.logic' datatype='boolean' name='[Calculation_2815031248999751696]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;All&apos; THEN TRUE&#10;ELSE CONTAINS([global_entity_ids], [Parameters].[Parameter 3])&#10;END' />
      </column>
      <column caption='Metric Highlight' datatype='string' name='[Calculation_2815031249007362065]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;drift&apos; THEN [drift_severity]&#10;WHEN &apos;alert&apos; THEN [Calculation_2815031247588474881]&#10;WHEN &apos;updated&apos; THEN STR([is_metric_updated])&#10;WHEN &apos;impact&apos; THEN STR([Calculation_449937760022511617])&#10;ELSE NULL END' />
        <aliases>
          <alias key='&quot;f&quot;' value='No' />
          <alias key='&quot;t&quot;' value='Yes' />
        </aliases>
      </column>
      <column caption='Yesterday' datatype='datetime' name='[Calculation_2815031249012121618]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEADD(&apos;day&apos;, -1, TODAY())' />
      </column>
      <column caption='Priority.Cnt' datatype='integer' name='[Calculation_2894336825865928704]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Calculation_2815031247588474881]=&apos;No alert&apos;,0,1)' />
      </column>
      <column caption='Max Value.param' datatype='real' name='[Calculation_449937760021295104]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 6] = &quot;Max&quot;, MAX([max_value]), NULL)' />
      </column>
      <column caption='has_business_impact' datatype='boolean' name='[Calculation_449937760022511617]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([is_drifted] &#10;    AND (&#10;    abs([approve_pct_change])&gt;1 OR    &#10;    abs([review_pct_change])&gt;1 OR &#10;    abs([decline_pct_change])&gt;1&#10;    ),&#10;    TRUE,FALSE)' />
      </column>
      <column caption='Avg/Min/Max' datatype='real' name='[Calculation_6803813157206200320]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;WHEN &quot;Min&quot; THEN MIN([min_value])&#10;WHEN &quot;Max&quot; THEN MAX([max_value])&#10;WHEN &quot;Avg&quot; THEN SUM([avg_value])&#10;END' />
      </column>
      <column caption='ML Related?' datatype='boolean' name='[Calculation_6803813157213925380]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL(CONTAINS([impacted_rules], &quot;_ml_&quot;), FALSE)' />
      </column>
      <column caption='Decline.Metric' datatype='real' name='[Impacted Approve.Metric (copy)_2815031248649330693]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN 0 THEN [total_decline_orders]&#10;WHEN 1 THEN [total_decline_customers]&#10;WHEN 2 THEN [total_decline_gmv]&#10;WHEN 3 THEN [region_decline_share]*100&#10;ELSE NULL END' />
      </column>
      <column caption='Review.Metric' datatype='real' name='[Impacted Decline.Metric (copy)_2815031248649457670]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN 0 THEN [total_review_orders]&#10;WHEN 1 THEN [total_review_customers]&#10;WHEN 2 THEN [total_review_gmv]&#10;WHEN 3 THEN [region_review_share]*100&#10;ELSE NULL END' />
      </column>
      <column caption='Min Value.param' datatype='real' name='[Max Value.param (copy)_6373649014024355840]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 6] = &quot;Min&quot;, MIN([min_value]), NULL)' />
      </column>
      <column caption='Metric Highlight Note' datatype='string' name='[Metric Highlight (copy)_1944288418506342400]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;drift&apos; THEN [drift_summary]&#10;WHEN &apos;alert&apos; THEN [alert_message]&#10;WHEN &apos;updated&apos; THEN [metric_update_info]&#10;WHEN &apos;impact&apos; THEN &quot;Decline Pct Change: &quot; + str(round([decline_pct_change]*100)) + &quot;%&quot; + &quot;, Review Pct Change: &quot; + str(round([review_pct_change]*100)) + &quot;%&quot; + &quot;, Approve Pct Change: &quot; + str(round([approve_pct_change]*100)) + &quot;%&quot;&#10;ELSE NULL END' />
        <aliases>
          <alias key='&quot;f&quot;' value='No' />
          <alias key='&quot;t&quot;' value='Yes' />
        </aliases>
      </column>
      <column caption='Approve.param' datatype='real' name='[Min Value.param (copy)_1785747640032661505]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Parameters].[Hide Min/Max values? (copy)_1785747640032542720] = &quot;Approve&quot;, sum([Calculation_2815031248649113604]), NULL)' />
      </column>
      <column caption='Avg Value.param' datatype='real' name='[Min Value.param (copy)_6803813157206654977]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 6] = &quot;Avg&quot;, [avg_value], NULL)' />
      </column>
      <column caption='Yesterday-1' datatype='datetime' name='[Yesterday (copy)_4100245998673199104]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEADD(&apos;day&apos;, -2, TODAY())' />
      </column>
