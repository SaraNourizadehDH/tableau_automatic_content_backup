      <table>
        <view>
          <datasources>
            <datasource caption='agg_antifraud_metrics_drift_daily (rl_fintech)' name='federated.0dvqwz01m8042f1aaj9ni0ikyh3s' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Only Drifted' caption='Has Metric ever Drifted?' datatype='integer' name='[Parameter 2]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='0' value='Show All' />
                <alias key='1' value='Only Drifted' />
              </aliases>
            </column>
            <column alias='Drift severity' caption='Metric Highlight type' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;drift&quot;'>
              <calculation class='tableau' formula='&quot;drift&quot;' />
              <aliases>
                <alias key='&quot;alert&quot;' value='Alert priority' />
                <alias key='&quot;drift&quot;' value='Drift severity' />
                <alias key='&quot;impact&quot;' value='Had business impact?' />
