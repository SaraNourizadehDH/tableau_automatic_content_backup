      <aliases enabled='yes' />
      <column caption='Timeframe' datatype='string' name='[Calculation_283726809272029184]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;day&apos; then DATENAME(&apos;day&apos;,[claim_request_date]) + &quot; &quot; + LEFT(DATENAME(&apos;month&apos;,[claim_request_date]),3) + &quot; &quot; + RIGHT(DATENAME(&apos;year&apos;,[claim_request_date]),2)&#10;    WHEN &apos;week&apos; then &quot;W&quot; + DATENAME(&apos;week&apos;,[claim_request_date]) + &quot; &quot; + DATENAME(&apos;year&apos;,[claim_request_date])&#10;    WHEN &apos;month&apos; then LEFT(DATENAME(&apos;month&apos;,[claim_request_date]),3) + &quot; &quot; + DATENAME(&apos;year&apos;,[claim_request_date])&#10;    WHEN &apos;quarter&apos; then &quot;Q&quot; + DATENAME(&quot;quarter&quot;, [claim_request_date]) + &quot; &quot; + DATENAME(&apos;year&apos;,[claim_request_date])&#10;   // WHEN 5 then DATENAME(&apos;year&apos;,[Order Date])&#10;    &#10;END' />
      </column>
      <column caption='Total Claims' datatype='real' name='[Calculation_283726809277313025]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN 0 THEN [Calculation_4135571129485377567]&#10;WHEN 1 THEN [Calculation_4135571129485615136]&#10;END' />
      </column>
      <column caption='Total Orders AntiFraud' datatype='real' name='[Calculation_283726809278590982]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN 0 THEN [count_carts_antifraud]&#10;WHEN 1 THEN [amount_eur_antifraud]&#10;END' />
      </column>
      <column caption='Claim Rate' datatype='real' default-format='p0.000%' name='[Calculation_283726809278803975]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL( (SUM([Calculation_283726809277313025])/&#10;  SUM([Calculation_283726809278590982])  )&#10;, 0)' />
      </column>
      <column caption='Dimension' datatype='string' name='[Calculation_283726809293180938]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;claim_source&apos; THEN [claim_source]&#10;WHEN &apos;region&apos; THEN [region]&#10;WHEN &apos;antifraud_decision&apos; THEN [antifraud_decision]&#10;WHEN &apos;vendor_vertical&apos; THEN [vendor_vertical]&#10;WHEN &apos;management_entity&apos; THEN [management_entity]&#10;WHEN &apos;type&apos; THEN [type]&#10;WHEN &apos;global_entity_id&apos; then [global_entity_id]&#10;WHEN &apos;contact_type&apos; THEN [contact_type]&#10;WHEN &apos;claim_reason_code&apos; THEN [claim_reason_code]&#10;WHEN &apos;claim_type&apos; THEN [claim_type]&#10;END' />
      </column>
      <column caption='Review Claims' datatype='real' name='[Calculation_283726809296986123]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [antifraud_decision] = &apos;Review&apos; THEN [Calculation_283726809277313025] END' />
      </column>
      <column caption='Review Rate' datatype='real' name='[Calculation_283726809297113100]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(SUM([Calculation_283726809296986123])/SUM([Calculation_283726809277313025]),0)' />
      </column>
      <column caption='is_last full month' datatype='boolean' name='[Calculation_283726809328492562]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;, -1, TODAY())) = DATETRUNC(&apos;month&apos;, [claim_request_date])' />
      </column>
      <column caption='is_last full month - 1' datatype='boolean' name='[Calculation_283726809328603155]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;, -2, TODAY())) = DATETRUNC(&apos;month&apos;, [claim_request_date])' />
      </column>
      <column caption='Month name' datatype='date' default-format='*mmmm yyyy' name='[Calculation_283726809328730132]' role='dimension' type='ordinal'>
