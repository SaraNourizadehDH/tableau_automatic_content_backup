            <column caption='Timeframe' datatype='string' name='[Calculation_283726809272029184]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;day&apos; then DATENAME(&apos;day&apos;,[claim_request_date]) + &quot; &quot; + LEFT(DATENAME(&apos;month&apos;,[claim_request_date]),3) + &quot; &quot; + RIGHT(DATENAME(&apos;year&apos;,[claim_request_date]),2)&#10;    WHEN &apos;week&apos; then &quot;W&quot; + DATENAME(&apos;week&apos;,[claim_request_date]) + &quot; &quot; + DATENAME(&apos;year&apos;,[claim_request_date])&#10;    WHEN &apos;month&apos; then LEFT(DATENAME(&apos;month&apos;,[claim_request_date]),3) + &quot; &quot; + DATENAME(&apos;year&apos;,[claim_request_date])&#10;    WHEN &apos;quarter&apos; then &quot;Q&quot; + DATENAME(&quot;quarter&quot;, [claim_request_date]) + &quot; &quot; + DATENAME(&apos;year&apos;,[claim_request_date])&#10;   // WHEN 5 then DATENAME(&apos;year&apos;,[Order Date])&#10;    &#10;END' />
            </column>
