            <column caption='Claim Type' datatype='string' name='[claim_type]' role='dimension' type='nominal'>
              <aliases>
                <alias key='%null%' value='Unknown' />
                <alias key='&quot;cancellation&quot;' value='Cancellation' />
                <alias key='&quot;full-refund&quot;' value='Full Refund' />
                <alias key='&quot;partial-refund&quot;' value='Partial Refund' />
              </aliases>
            </column>
            <column caption='Count Carts Antifraud' datatype='integer' name='[count_carts_antifraud]' role='measure' type='quantitative' />
            <column caption='Count Claims Attempts' datatype='integer' name='[count_claims_attempts]' role='measure' type='quantitative' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Is Last Decision' datatype='string' name='[is_last_decision]' role='dimension' type='nominal' />
            <column caption='last_decision_amount' datatype='real' name='[last_decision_count (copy)_4135571129485226014]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_last_decision] = &apos;Yes&apos; then [amount_attempts_claim] END' />
