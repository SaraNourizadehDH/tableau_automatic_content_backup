            <datasource caption='antifraud_claims_tableau_report (rl_fintech)' name='federated.07dah4r1ucspjg1aj5c331r0kdsl' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Daily' caption='Timeframe' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;day&quot;'>
              <calculation class='tableau' formula='&quot;day&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;quarter&quot;' value='Quarterly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
            <column alias='Claims #' caption='Select a metric' datatype='integer' name='[Parameter 2]' param-domain-type='list' role='measure' type='quantitative' value='0'>
              <calculation class='tableau' formula='0' />
              <aliases>
                <alias key='0' value='Claims #' />
                <alias key='1' value='GMV €' />
              </aliases>
            </column>
            <column alias='Sum' caption='Sum or Rate' datatype='integer' name='[Parameter 4]' param-domain-type='list' role='measure' type='quantitative' value='0'>
              <calculation class='tableau' formula='0' />
              <aliases>
                <alias key='0' value='Sum' />
                <alias key='1' value='Rate' />
              </aliases>
            </column>
            <column alias='Yes' caption='Is Last Decision?' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;yes&quot;'>
              <calculation class='tableau' formula='&quot;yes&quot;' />
              <aliases>
                <alias key='&quot;no&quot;' value='No' />
                <alias key='&quot;yes&quot;' value='Yes' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.07dah4r1ucspjg1aj5c331r0kdsl'>
            <column caption='Timeframe' datatype='string' name='[Calculation_283726809272029184]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;day&apos; then DATENAME(&apos;day&apos;,[claim_request_date]) + &quot; &quot; + LEFT(DATENAME(&apos;month&apos;,[claim_request_date]),3) + &quot; &quot; + RIGHT(DATENAME(&apos;year&apos;,[claim_request_date]),2)&#10;    WHEN &apos;week&apos; then &quot;W&quot; + DATENAME(&apos;week&apos;,[claim_request_date]) + &quot; &quot; + DATENAME(&apos;year&apos;,[claim_request_date])&#10;    WHEN &apos;month&apos; then LEFT(DATENAME(&apos;month&apos;,[claim_request_date]),3) + &quot; &quot; + DATENAME(&apos;year&apos;,[claim_request_date])&#10;    WHEN &apos;quarter&apos; then &quot;Q&quot; + DATENAME(&quot;quarter&quot;, [claim_request_date]) + &quot; &quot; + DATENAME(&apos;year&apos;,[claim_request_date])&#10;   // WHEN 5 then DATENAME(&apos;year&apos;,[Order Date])&#10;    &#10;END' />
            </column>
            <column caption='Total Claims' datatype='real' name='[Calculation_283726809277313025]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN 0 THEN [Calculation_4135571129485377567]&#10;WHEN 1 THEN [Calculation_4135571129485615136]&#10;END' />
            </column>
            <column caption='last_decision_count' datatype='integer' name='[Calculation_4135571129484959773]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_last_decision] = &apos;Yes&apos; then [count_claims_attempts] END' />
            </column>
            <column caption='Count Attempts' datatype='integer' name='[Calculation_4135571129485377567]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &apos;yes&apos; then [Calculation_4135571129484959773]&#10;WHEN &apos;no&apos; then [count_claims_attempts]&#10;END' />
            </column>
            <column caption='Total Amount' datatype='real' name='[Calculation_4135571129485615136]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &apos;yes&apos; then [last_decision_count (copy)_4135571129485226014]&#10;WHEN &apos;no&apos; then [amount_attempts_claim]&#10;END' />
            </column>
            <column caption='Claim Request Date - Range' datatype='date' name='[Claim Request Date (copy)_283726809277734916]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[claim_request_date]' />
            </column>
            <column caption='Decline Claims Selector' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Decline Claims Selector (copy)_4135571129480306716]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN 0 THEN SUM([Review Claims (copy)_283726809297252365])&#10;WHEN 1 THEN ROUND([Review Rate (copy)_283726809297383438]*100,2)&#10;END' />
            </column>
            <column caption='Decline Claims' datatype='real' name='[Review Claims (copy)_283726809297252365]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [antifraud_decision] = &apos;Decline&apos; THEN [Calculation_283726809277313025] END' />
            </column>
            <column caption='Decline Rate' datatype='real' name='[Review Rate (copy)_283726809297383438]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM([Review Claims (copy)_283726809297252365])/SUM([Calculation_283726809277313025]),0)' />
            </column>
            <column caption='Amount Attempts Claim' datatype='real' name='[amount_attempts_claim]' role='measure' type='quantitative' />
            <column caption='Antifraud Decision' datatype='string' name='[antifraud_decision]' role='dimension' type='nominal'>
