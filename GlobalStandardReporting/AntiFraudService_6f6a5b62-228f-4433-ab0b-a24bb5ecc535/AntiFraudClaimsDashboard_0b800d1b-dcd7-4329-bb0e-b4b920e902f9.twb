            </column>
            <column caption='Claim Request Date' datatype='date' name='[claim_request_date]' role='dimension' type='ordinal' />
            <column caption='Claim Source' datatype='string' name='[claim_source]' role='dimension' type='nominal' />
            <column caption='Claim Type' datatype='string' name='[claim_type]' role='dimension' type='nominal'>
              <aliases>
                <alias key='%null%' value='Unknown' />
                <alias key='&quot;cancellation&quot;' value='Cancellation' />
                <alias key='&quot;full-refund&quot;' value='Full Refund' />
                <alias key='&quot;partial-refund&quot;' value='Partial Refund' />
              </aliases>
            </column>
            <column caption='Count Claims Attempts' datatype='integer' name='[count_claims_attempts]' role='measure' type='quantitative' />
            <column caption='Count Overwritten Orders' datatype='integer' name='[count_overwritten_orders]' role='measure' type='quantitative' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Is Last Decision' datatype='string' name='[is_last_decision]' role='dimension' type='nominal' />
            <column caption='last_decision_amount' datatype='real' name='[last_decision_count (copy)_4135571129485226014]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_last_decision] = &apos;Yes&apos; then [amount_attempts_claim] END' />
            </column>
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column-instance column='[claim_request_date]' derivation='Min' name='[min:claim_request_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_283726809272029184]' derivation='None' name='[none:Calculation_283726809272029184:nk]' pivot='key' type='nominal' />
            <column-instance column='[Claim Request Date (copy)_283726809277734916]' derivation='None' name='[none:Claim Request Date (copy)_283726809277734916:qk]' pivot='key' type='quantitative' />
            <column-instance column='[claim_reason_code]' derivation='None' name='[none:claim_reason_code:nk]' pivot='key' type='nominal' />
            <column-instance column='[claim_request_date]' derivation='None' name='[none:claim_request_date:qk]' pivot='key' type='quantitative' />
