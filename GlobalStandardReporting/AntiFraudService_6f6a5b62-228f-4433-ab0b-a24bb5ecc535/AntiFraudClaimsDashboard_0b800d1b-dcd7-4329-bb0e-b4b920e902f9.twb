            <zone fixed-size='189' h='10100' id='127' is-fixed='true' type-v2='text' w='15153' x='615' y='55000'>
              <formatted-text>
                <run>An Overwritten Granted Claim - is a claim was </run>
                <run bold='true'>Declined</run>
                <run> by AntiFraud, but at the end was granted by an agent.</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
