    <worksheet name='Claims Rate - Month'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontsize='10'>Claims Rate</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='antifraud_claims_tableau_report (rl_fintech)' name='federated.07dah4r1ucspjg1aj5c331r0kdsl' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Claims #' caption='Select a metric' datatype='integer' name='[Parameter 2]' param-domain-type='list' role='measure' type='quantitative' value='0'>
              <calculation class='tableau' formula='0' />
              <aliases>
                <alias key='0' value='Claims #' />
                <alias key='1' value='GMV €' />
              </aliases>
            </column>
            <column alias='Yes' caption='Is Last Decision?' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;yes&quot;'>
              <calculation class='tableau' formula='&quot;yes&quot;' />
              <aliases>
                <alias key='&quot;no&quot;' value='No' />
                <alias key='&quot;yes&quot;' value='Yes' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.07dah4r1ucspjg1aj5c331r0kdsl'>
            <column caption='Total Claims' datatype='real' name='[Calculation_283726809277313025]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN 0 THEN [Calculation_4135571129485377567]&#10;WHEN 1 THEN [Calculation_4135571129485615136]&#10;END' />
            </column>
            <column caption='Total Orders AntiFraud' datatype='real' name='[Calculation_283726809278590982]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN 0 THEN [count_carts_antifraud]&#10;WHEN 1 THEN [amount_eur_antifraud]&#10;END' />
            </column>
            <column caption='is_last full month' datatype='boolean' name='[Calculation_283726809328492562]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;, -1, TODAY())) = DATETRUNC(&apos;month&apos;, [claim_request_date])' />
            </column>
            <column caption='is_last full month - 1' datatype='boolean' name='[Calculation_283726809328603155]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;, -2, TODAY())) = DATETRUNC(&apos;month&apos;, [claim_request_date])' />
            </column>
            <column caption='Month name' datatype='date' default-format='*mmmm yyyy' name='[Calculation_283726809328730132]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;,IIF([Calculation_283726809328492562], [claim_request_date],Null)))' />
            </column>
            <column caption='Total Claims - Last Month' datatype='real' name='[Calculation_283726809328910357]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Calculation_283726809328492562],[Calculation_283726809277313025],Null)' />
            </column>
            <column caption='Total Claims - Prev Month' datatype='real' name='[Calculation_283726809329053718]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Calculation_283726809328603155],[Calculation_283726809277313025],Null)' />
            </column>
            <column caption='ABS([Claims Rate - diff])' datatype='real' name='[Calculation_4135571129479483418]' role='measure' type='quantitative' user:unnamed='Claims Rate - Month'>
              <calculation class='tableau' formula='ABS([Review Rate - diff (copy)_3402188077047246872])' />
            </column>
            <column caption='last_decision_count' datatype='integer' name='[Calculation_4135571129484959773]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_last_decision] = &apos;Yes&apos; then [count_claims_attempts] END' />
            </column>
            <column caption='Count Attempts' datatype='integer' name='[Calculation_4135571129485377567]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &apos;yes&apos; then [Calculation_4135571129484959773]&#10;WHEN &apos;no&apos; then [count_claims_attempts]&#10;END' />
            </column>
            <column caption='Total Amount' datatype='real' name='[Calculation_4135571129485615136]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &apos;yes&apos; then [last_decision_count (copy)_4135571129485226014]&#10;WHEN &apos;no&apos; then [amount_attempts_claim]&#10;END' />
            </column>
            <column caption='Claims Rate - arrow_down' datatype='string' name='[Claims Rate - arrow_down (copy)_4135571129479348248]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IIF([Review Rate - diff (copy)_3402188077047246872]&lt;0,&apos;▼&apos;,&apos;&apos;)' />
            </column>
            <column caption='Claims Rate - arrow_up' datatype='string' name='[Claims Rate - arrow_up (copy)_4135571129479389209]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IIF([Review Rate - diff (copy)_3402188077047246872]&gt;0,&apos;▲&apos;,&apos;&apos;)' />
            </column>
            <column caption='Claims Rate - Last Month' datatype='real' name='[Review Rate - Last Month (copy)_3402188077046976534]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_283726809328910357])/SUM([Total Claims - Last Month (copy)_3402188077046771732])' />
            </column>
            <column caption='Claims Rate - Prev Month' datatype='real' name='[Review Rate - Prev Month (copy)_3402188077047132183]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_283726809329053718])/SUM([Total Claims - Prev Month (copy)_3402188077046845461])' />
            </column>
            <column caption='Claims Rate - diff' datatype='real' name='[Review Rate - diff (copy)_3402188077047246872]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Review Rate - Last Month (copy)_3402188077046976534] - [Review Rate - Prev Month (copy)_3402188077047132183])*100' />
            </column>
            <column caption='Total Orders AF - Last Month' datatype='real' name='[Total Claims - Last Month (copy)_3402188077046771732]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Calculation_283726809328492562],[Calculation_283726809278590982],Null)' />
            </column>
            <column caption='Total Orders AF - Prev Month' datatype='real' name='[Total Claims - Prev Month (copy)_3402188077046845461]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Calculation_283726809328603155],[Calculation_283726809278590982],Null)' />
            </column>
            <column caption='Amount Attempts Claim' datatype='real' name='[amount_attempts_claim]' role='measure' type='quantitative' />
            <column caption='Amount Eur Antifraud' datatype='real' name='[amount_eur_antifraud]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_283726809328730132]' derivation='Attribute' name='[attr:Calculation_283726809328730132:ok]' pivot='key' type='ordinal' />
            <column caption='Claim Reason Code' datatype='string' name='[claim_reason_code]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;&quot;' value='Unknown' />
              </aliases>
            </column>
            <column caption='Claim Request Date' datatype='date' name='[claim_request_date]' role='dimension' type='ordinal' />
