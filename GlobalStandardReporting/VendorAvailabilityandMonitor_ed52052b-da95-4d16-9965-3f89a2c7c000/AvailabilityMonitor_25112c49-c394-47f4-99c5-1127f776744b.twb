            <column caption='Order Failure Reasons' datatype='string' name='[fail_reasons]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1798625105592877058]' derivation='None' name='[none:Calculation_1798625105592877058:nk]' pivot='key' type='nominal' />
