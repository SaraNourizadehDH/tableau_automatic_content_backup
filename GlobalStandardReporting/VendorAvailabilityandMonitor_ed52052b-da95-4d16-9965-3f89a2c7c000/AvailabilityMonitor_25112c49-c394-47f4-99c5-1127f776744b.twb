      <table>
        <view>
          <datasources>
            <datasource caption='vendor_monitor_availability_impact (rl)' name='federated.1hlvs7p07s331z1c81jci0ibei1g' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Has Orders L28 Days - Param Tab3' datatype='string' name='[Parameter 11]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column alias='Day' caption='Select Time Granularity' datatype='integer' name='[Parameter 21]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='Day' />
                <alias key='2' value='Week' />
                <alias key='3' value='Month' />
              </aliases>
            </column>
            <column caption='Table Dimension A' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Offline Author&quot;'>
              <calculation class='tableau' formula='&quot;Offline Author&quot;' />
            </column>
            <column caption='Table Metric' datatype='string' name='[Parameter 7]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% Offline Duration&quot;'>
              <calculation class='tableau' formula='&quot;% Offline Duration&quot;' />
            </column>
            <column caption='Table Column Dimensions' datatype='string' name='[Parameter 8]' param-domain-type='list' role='measure' type='nominal' value='&quot;Dates&quot;'>
              <calculation class='tableau' formula='&quot;Dates&quot;' />
              <aliases>
                <alias key='&quot;Check-in Reasons&quot;' value='Check-in Reasons' />
                <alias key='&quot;Client Reasons&quot;' value='Client Reasons' />
                <alias key='&quot;Monitor Reasons&quot;' value='Monitor Reasons' />
                <alias key='&quot;Platform Reasons&quot;' value='Platform Reasons' />
                <alias key='&quot;Vendor Portal Reasons&quot;' value='Vendor Portal Reasons' />
              </aliases>
            </column>
            <column caption='Table Dimension B' datatype='string' name='[Table Dimension A (copy)_52706191327735812]' param-domain-type='list' role='measure' type='nominal' value='&quot;Offline Reason&quot;'>
              <calculation class='tableau' formula='&quot;Offline Reason&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1hlvs7p07s331z1c81jci0ibei1g'>
            <column caption='L28 Days Filter' datatype='boolean' name='[Calculation_1798625105595969540]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 11] = &apos;All&apos;&#10;OR [Parameters].[Parameter 11] = &apos;No Orders&apos; AND [has_any_order_l28_days] = FALSE&#10;OR [Parameters].[Parameter 11] = &apos;Any Order&apos; AND [has_any_order_l28_days]&#10;OR [Parameters].[Parameter 11] = &apos;Successful Orders&apos; AND [has_successful_order_l28_days]' />
            </column>
            <column caption='Time Granularity - Offline' datatype='date' name='[Calculation_51932141999566864]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 21]&#10;WHEN 1&#10;THEN [Created Date (Days)]&#10;WHEN 2&#10;THEN [Created Date (Week numbers)]&#10;WHEN 3&#10;THEN [Created Date (Months)]&#10;END' />
            </column>
            <column caption='Dimension A' datatype='string' name='[Calculation_52706191327113219]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;  WHEN &apos;Offline Author&apos;&#10;    THEN [offline_author]&#10;  WHEN &apos;Offline Reason&apos;&#10;    THEN [offline_reason]&#10;  WHEN &apos;Region&apos;&#10;    THEN [region]  &#10;  WHEN &apos;Brand Name&apos;&#10;    THEN [brand_name]&#10;  WHEN &apos;Country&apos;&#10;    THEN [country_name]&#10;  WHEN &apos;Vendor Grade&apos;&#10;    THEN [vendor_grade]&#10;  WHEN &apos;Vertical Type&apos;&#10;    THEN [vertical_type]&#10;END' />
              <aliases>
                <alias key='%null%' value='.' />
                <alias key='&quot;DEVICE_CONNECTIVITY&quot;' value='..' />
              </aliases>
            </column>
            <column caption='Tabular Metric' datatype='real' name='[Calculation_52706191357886470]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#10;  WHEN &apos;Total Schedule Duration&apos;&#10;    THEN (-SUM([daily_slot_duration]))&#10;  WHEN &apos;% Offline Duration&apos;&#10;    THEN [Unreachable duration % (copy)_52706191363493897]&#10;  WHEN &apos;% Unreachable Duration&apos;&#10;    THEN [Offline duration % (copy)_52706191362887687]&#10;  WHEN &apos;% Monitor Unreachable Offline (MUO)&apos;&#10;    THEN [Unreachable duration % (copy)_52706191363723274]&#10;END' />
            </column>
            <column caption='Check-in Categories' datatype='string' name='[Calculation_52706191364706316]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_offline] = TRUE AND [offline_reason] = &apos;CHECK_IN_REQUIRED&apos;&#10;THEN [offline_reason]&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Monitor Categories' datatype='string' name='[Calculation_52706191365103629]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_offline] = TRUE AND [offline_author] = &apos;MONITOR&apos;&#10;THEN [offline_reason]&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Client Categories' datatype='string' name='[Calculation_52706191365210126]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_offline] = TRUE AND [offline_author] = &apos;CLIENT&apos;&#10;THEN [offline_reason]&#10;END' />
            </column>
            <column caption='Platform Categories' datatype='string' name='[Calculation_52706191365275663]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_offline] = TRUE AND [offline_author] = &apos;PLATFORM&apos;&#10;THEN [offline_reason]&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Vendor Portal Categories' datatype='string' name='[Calculation_52706191365341200]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_offline] = TRUE AND [offline_author] = &apos;VENDOR_PORTAL&apos;&#10;THEN [offline_reason]&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Tabular Column Dimensions' datatype='string' name='[Calculation_52706191365435409]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 8]&#10;  WHEN &apos;Dates&apos;&#10;    THEN STR([Calculation_51932141999566864])&#10;  WHEN &apos;Offline Authors&apos;&#10;    THEN IFNULL([offline_author], &apos;&apos;)&#10;  WHEN &apos;Check-in Reasons&apos;&#10;    THEN IFNULL([Calculation_52706191364706316], &apos;&apos;)&#10;  WHEN &apos;Monitor Reasons&apos;&#10;    THEN IFNULL([Calculation_52706191365103629], &apos;&apos;)&#10;  WHEN &apos;Client Reasons&apos;&#10;    THEN IFNULL([Calculation_52706191365210126], &apos;&apos;)&#10;  WHEN &apos;Platform Reasons&apos;&#10;    THEN IFNULL([Calculation_52706191365275663], &apos;&apos;)&#10;  WHEN &apos;Vendor Portal Reasons&apos;&#10;    THEN IFNULL([Calculation_52706191365341200], &apos;&apos;)&#10;END' />
            </column>
            <column datatype='date' name='[Created Date (Days)]' role='dimension' type='ordinal' user:agg-type='Day-Trunc' user:base-field='created_date' user:ui-builder='date-bin-builder'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;day&apos;, [created_date]))' />
            </column>
            <column datatype='date' name='[Created Date (Months)]' role='dimension' type='ordinal' user:agg-type='Month-Trunc' user:base-field='created_date' user:ui-builder='date-bin-builder'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [created_date]))' />
            </column>
            <column datatype='date' name='[Created Date (Week numbers)]' role='dimension' type='ordinal' user:agg-type='Week-Trunc' user:base-field='created_date' user:ui-builder='date-bin-builder'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;, [created_date]))' />
            </column>
            <column caption='Unreachable duration %' datatype='real' name='[Offline duration % (copy)_52706191362887687]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_unreachable] = TRUE AND [is_offline] = FALSE THEN [duration_seconds] ELSE 0 END)&#10;/&#10;SUM({FIXED [created_date] : SUM([daily_slot_duration])})' />
            </column>
            <column caption='Dimension B' datatype='string' name='[Tabular Dimension A (copy)_52706191349776389]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Table Dimension A (copy)_52706191327735812]&#10;  WHEN &apos;Offline Author&apos;&#10;    THEN [offline_author]&#10;  WHEN &apos;Offline Reason&apos;&#10;    THEN [offline_reason]&#10;  WHEN &apos;Region&apos;&#10;    THEN [region]&#10;  WHEN &apos;Brand Name&apos;&#10;    THEN [brand_name]&#10;  WHEN &apos;Country&apos;&#10;    THEN [country_name]&#10;  WHEN &apos;Vendor Grade&apos;&#10;    THEN [vendor_grade]&#10;  WHEN &apos;Vertical Type&apos;&#10;    THEN [vertical_type]&#10;END' />
              <aliases>
                <alias key='%null%' value='.' />
                <alias key='&quot;DEVICE_CONNECTIVITY&quot;' value='..' />
              </aliases>
            </column>
            <column caption='Offline duration % - Table' datatype='real' name='[Unreachable duration % (copy)_52706191363493897]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({ FIXED [Calculation_52706191327113219], [Tabular Dimension A (copy)_52706191349776389], [Calculation_52706191365435409] : SUM(&#10;IF [Calculation_52706191365435409] = &apos;&apos; // Forcing values where NULL to 0, to avoid extra data&#10;THEN 0&#10;ELSEIF [is_offline] &#10;THEN [duration_seconds] &#10;ELSE 0 &#10;END)})&#10;/&#10;IF [Parameters].[Parameter 8] = &apos;Dates&apos;&#10;THEN &#10;(IF [Parameters].[Parameter 6] IN (&apos;Offline Author&apos;, &apos;Offline Reason&apos;) AND [Parameters].[Table Dimension A (copy)_52706191327735812] IN (&apos;Offline Author&apos;, &apos;Offline Reason&apos;)&#10;THEN SUM({ FIXED [created_date] : SUM([daily_slot_duration])})&#10;ELSEIF [Parameters].[Parameter 6] IN (&apos;Offline Author&apos;, &apos;Offline Reason&apos;) AND NOT [Parameters].[Table Dimension A (copy)_52706191327735812] IN (&apos;Offline Author&apos;, &apos;Offline Reason&apos;)&#10;THEN SUM({ FIXED [created_date], [Tabular Dimension A (copy)_52706191349776389] : sum([daily_slot_duration])})&#10;ELSEIF NOT [Parameters].[Parameter 6] IN (&apos;Offline Author&apos;, &apos;Offline Reason&apos;) AND [Parameters].[Table Dimension A (copy)_52706191327735812] IN (&apos;Offline Author&apos;, &apos;Offline Reason&apos;)&#10;THEN SUM({ FIXED [created_date], [Calculation_52706191327113219] : sum([daily_slot_duration])})&#10;ELSE&#10;SUM([daily_slot_duration])&#10;END)&#10;ELSE SUM({ EXCLUDE [Calculation_52706191365435409] : SUM([daily_slot_duration])})&#10;END' />
            </column>
            <column caption='MUO duration %' datatype='real' name='[Unreachable duration % (copy)_52706191363723274]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_offline] = TRUE AND [offline_reason] = &apos;UNREACHABLE&apos; THEN [duration_seconds] ELSE 0 END)&#10;/&#10;SUM({FIXED [created_date] : SUM([daily_slot_duration])})' />
            </column>
