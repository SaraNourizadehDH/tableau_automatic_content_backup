      <aliases enabled='yes' />
      <column caption='Daily Slot Duration Mins' datatype='real' name='[Calculation_1344957807697575936]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{INCLUDE [region], [country_name], [brand_name], [is_dormant_vendor], [is_inoperative_vendor], [is_new_vendor], [is_unengaged_vendor]&#10;, [vendor_grade], [vertical_type], [Calculation_1798625105595969540] : SUM([daily_slot_duration])/60}' />
      </column>
      <column caption='L28 Days Filter' datatype='boolean' name='[Calculation_1798625105595969540]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 11] = &apos;All&apos;&#10;OR [Parameters].[Parameter 11] = &apos;No Orders&apos; AND [has_any_order_l28_days] = FALSE&#10;OR [Parameters].[Parameter 11] = &apos;Any Order&apos; AND [has_any_order_l28_days]&#10;OR [Parameters].[Parameter 11] = &apos;Successful Orders&apos; AND [has_successful_order_l28_days]' />
      </column>
      <column caption='Offline Chart Legend' datatype='real' name='[Calculation_1798625105597497349]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='{FIXED [Calculation_52706191291527169] : [Calculation_51369184860762117]}' />
      </column>
      <column caption='Offline Duration Secs' datatype='integer' name='[Calculation_1832190999025291270]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_offline] THEN ZN([duration_seconds]) ELSE 0 END)' />
      </column>
      <column caption='_user_entitlement' datatype='boolean' name='[Calculation_2862248691914706953]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='USERNAME() = [username]' />
      </column>
      <column caption='Overall Offline %' datatype='real' name='[Calculation_51369184858103811]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_offline] THEN [duration_seconds] ELSE 0 END)&#10;/&#10;SUM([daily_slot_duration])' />
      </column>
      <column caption='Offline duration % - Line chart' datatype='real' name='[Calculation_51369184860762117]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(CASE [Parameters].[Parameter 5]&#10;  WHEN IN (&apos;Overall&apos;, &apos;By Author&apos;)&#10;    THEN IF [is_offline] = TRUE THEN [duration_seconds] ELSE 0 END&#10;  ELSE IF [is_offline] = TRUE AND [offline_author] = [Parameters].[Parameter 5] THEN [duration_seconds] ELSE 0 END&#10;END)&#10;/&#10;SUM({ EXCLUDE [Calculation_52706191291527169] : SUM([daily_slot_duration])})' />
      </column>
      <column caption='Author Tooltip - Offline Duration Chart' datatype='string' name='[Calculation_51932140825378817]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN IN (&apos;Overall&apos;, &apos;By Author&apos;)&#10;THEN &apos;Overall&apos;&#10;ELSE [Parameters].[Parameter 5]&#10;END' />
      </column>
      <column caption='Tabular Filter' datatype='boolean' name='[Calculation_51932140862914562]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 8] IN (&apos;Dates&apos;, &apos;Offline Authors&apos;)&#10;THEN TRUE&#10;ELSEIF [Parameters].[Parameter 8] = [offline_author] OR [target_view] = &apos;DAILY_KPIS&apos;&#10;THEN TRUE&#10;END' />
      </column>
      <column caption='Label - Overall Offline %' datatype='string' name='[Calculation_51932141977255941]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;YTD Overall Offline %&apos;' />
      </column>
      <column caption='Time Granularity - Offline' datatype='date' name='[Calculation_51932141999566864]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 21]&#10;WHEN 1&#10;THEN [Created Date (Days)]&#10;WHEN 2&#10;THEN [Created Date (Week numbers)]&#10;WHEN 3&#10;THEN [Created Date (Months)]&#10;END' />
      </column>
      <column caption='Table schedule duration' datatype='real' name='[Calculation_52635839682121728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_offline] THEN [duration_seconds] ELSE 0 END)&#10;/&#10;SUM({ FIXED [created_date] : SUM([daily_slot_duration])})' />
      </column>
      <column caption='Offline Duration Dimension' datatype='string' name='[Calculation_52706191291527169]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;  WHEN &apos;Overall&apos;&#10;    THEN &apos;Overall&apos;&#10;  WHEN &apos;By Author&apos;&#10;    THEN [offline_author]&#10;  ELSE [offline_reason]&#10;END' />
      </column>
      <column caption='Offline Duration Filter' datatype='string' name='[Calculation_52706191292149762]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;  WHEN IN (&apos;Overall&apos;, &apos;By Author&apos;)&#10;    THEN NULL&#10;  WHEN &apos;Availability (VAS)&apos;&#10;    THEN &apos;AVAILABILITY&apos;&#10;  WHEN &apos;Monitor&apos;&#10;    THEN &apos;MONITOR&apos;&#10;  WHEN &apos;Client&apos;&#10;    THEN &apos;CLIENT&apos;&#10;  WHEN &apos;Platform&apos;&#10;    THEN &apos;PLATFORM&apos;&#10;  WHEN &apos;Portal&apos;&#10;    THEN &apos;VENDOR_PORTAL&apos;&#10;  ELSE &apos;Other&apos;&#10;END' />
      </column>
      <column caption='Dimension A' datatype='string' name='[Calculation_52706191327113219]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;  WHEN &apos;Offline Author&apos;&#10;    THEN [offline_author]&#10;  WHEN &apos;Offline Reason&apos;&#10;    THEN [offline_reason]&#10;  WHEN &apos;Region&apos;&#10;    THEN [region]  &#10;  WHEN &apos;Brand Name&apos;&#10;    THEN [brand_name]&#10;  WHEN &apos;Country&apos;&#10;    THEN [country_name]&#10;  WHEN &apos;Vendor Grade&apos;&#10;    THEN [vendor_grade]&#10;  WHEN &apos;Vertical Type&apos;&#10;    THEN [vertical_type]&#10;END' />
        <aliases>
          <alias key='%null%' value='.' />
          <alias key='&quot;DEVICE_CONNECTIVITY&quot;' value='..' />
        </aliases>
      </column>
      <column caption='Tabular Metric' datatype='real' name='[Calculation_52706191357886470]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#10;  WHEN &apos;Total Schedule Duration&apos;&#10;    THEN (-SUM([daily_slot_duration]))&#10;  WHEN &apos;% Offline Duration&apos;&#10;    THEN [Unreachable duration % (copy)_52706191363493897]&#10;  WHEN &apos;% Unreachable Duration&apos;&#10;    THEN [Offline duration % (copy)_52706191362887687]&#10;  WHEN &apos;% Monitor Unreachable Offline (MUO)&apos;&#10;    THEN [Unreachable duration % (copy)_52706191363723274]&#10;END' />
      </column>
      <column caption='Check-in Categories' datatype='string' name='[Calculation_52706191364706316]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_offline] = TRUE AND [offline_reason] = &apos;CHECK_IN_REQUIRED&apos;&#10;THEN [offline_reason]&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Monitor Categories' datatype='string' name='[Calculation_52706191365103629]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_offline] = TRUE AND [offline_author] = &apos;MONITOR&apos;&#10;THEN [offline_reason]&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Client Categories' datatype='string' name='[Calculation_52706191365210126]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_offline] = TRUE AND [offline_author] = &apos;CLIENT&apos;&#10;THEN [offline_reason]&#10;END' />
      </column>
      <column caption='Platform Categories' datatype='string' name='[Calculation_52706191365275663]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_offline] = TRUE AND [offline_author] = &apos;PLATFORM&apos;&#10;THEN [offline_reason]&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Vendor Portal Categories' datatype='string' name='[Calculation_52706191365341200]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_offline] = TRUE AND [offline_author] = &apos;VENDOR_PORTAL&apos;&#10;THEN [offline_reason]&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Tabular Column Dimensions' datatype='string' name='[Calculation_52706191365435409]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 8]&#10;  WHEN &apos;Dates&apos;&#10;    THEN STR([Calculation_51932141999566864])&#10;  WHEN &apos;Offline Authors&apos;&#10;    THEN IFNULL([offline_author], &apos;&apos;)&#10;  WHEN &apos;Check-in Reasons&apos;&#10;    THEN IFNULL([Calculation_52706191364706316], &apos;&apos;)&#10;  WHEN &apos;Monitor Reasons&apos;&#10;    THEN IFNULL([Calculation_52706191365103629], &apos;&apos;)&#10;  WHEN &apos;Client Reasons&apos;&#10;    THEN IFNULL([Calculation_52706191365210126], &apos;&apos;)&#10;  WHEN &apos;Platform Reasons&apos;&#10;    THEN IFNULL([Calculation_52706191365275663], &apos;&apos;)&#10;  WHEN &apos;Vendor Portal Reasons&apos;&#10;    THEN IFNULL([Calculation_52706191365341200], &apos;&apos;)&#10;END' />
      </column>
      <column caption='Unreachable? - label' datatype='string' name='[Calculation_564146224719257600]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [is_unreachable]&#10;WHEN TRUE&#10;THEN &apos;Unreachable&apos;&#10;ELSE&apos;Reachable&apos;&#10;END' />
      </column>
      <column caption='% Offline Duration - Dynamic Header' datatype='string' name='[Calculation_564146224780918789]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;% Offline Duration - &apos; + &#10;CASE [Parameters].[Parameter 5]&#10;WHEN IN (&apos;Overall&apos;, &apos;By Author&apos;)&#10;THEN [Parameters].[Parameter 5]&#10;WHEN &apos;AVAILABILITY&apos;&#10;THEN &apos;By Availability Reasons&apos;&#10;WHEN &apos;MONITOR&apos;&#10;THEN &apos;By Monitor Reasons&apos;&#10;WHEN &apos;CLIENT&apos;&#10;THEN &apos;By Client Reasons&apos;&#10;WHEN &apos;PLATFORM&apos;&#10;THEN &apos;By Platform Reasons&apos;&#10;WHEN &apos;VENDOR_PORTAL&apos;&#10;THEN &apos;By Vendor Portal Reasons&apos;&#10;END' />
      </column>
      <column caption='Tooltip - Offline Duration Line' datatype='string' name='[Calculation_634796450544476161]' role='measure' type='nominal'>
        <calculation class='tableau' formula='ATTR([Calculation_52706191291527169]) + &apos; Offline: &apos; + STR(ROUND([Calculation_51369184860762117]*100, 1)) + &apos;%&apos;' />
      </column>
