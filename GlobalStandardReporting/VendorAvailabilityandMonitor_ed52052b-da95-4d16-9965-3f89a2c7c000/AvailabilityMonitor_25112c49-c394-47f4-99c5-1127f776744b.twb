      <column caption='Offline Duration % - Unreachable Chart' datatype='real' name='[Offline Duration % - Unreachable Chart (copy)_1832190999001989125]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Calculation_51932141999566864], [is_unreachable], [offline_author], [offline_reason] : SUM(IF [is_offline] THEN [duration_seconds] ELSE 0 END)}&#10;/&#10;{ FIXED [Calculation_51932141999566864]: SUM([daily_slot_duration])}' />
