  <worksheets>
    <worksheet name='% Offline Duration - by Categories'>
      <table>
        <view>
          <datasources>
            <datasource caption='vendor_monitor_availability_impact (rl)' name='federated.1hlvs7p07s331z1c81jci0ibei1g' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Has Orders L28 Days - Param Tab3' datatype='string' name='[Parameter 11]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column alias='Day' caption='Select Time Granularity' datatype='integer' name='[Parameter 21]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='Day' />
                <alias key='2' value='Week' />
                <alias key='3' value='Month' />
              </aliases>
            </column>
            <column caption='Granularity - Offline Duration' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Overall&quot;'>
              <calculation class='tableau' formula='&quot;Overall&quot;' />
              <aliases>
                <alias key='&quot;AVAILABILITY&quot;' value='- Availability' />
                <alias key='&quot;By Author&quot;' value='Author' />
                <alias key='&quot;CLIENT&quot;' value='- Client' />
                <alias key='&quot;MONITOR&quot;' value='- Monitor' />
                <alias key='&quot;PLATFORM&quot;' value='- Platform' />
                <alias key='&quot;VENDOR_PORTAL&quot;' value='- Vendor Portal' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1hlvs7p07s331z1c81jci0ibei1g'>
            <column caption='Daily Slot Duration Mins' datatype='real' name='[Calculation_1344957807697575936]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{INCLUDE [region], [country_name], [brand_name], [is_dormant_vendor], [is_inoperative_vendor], [is_new_vendor], [is_unengaged_vendor]&#10;, [vendor_grade], [vertical_type], [Calculation_1798625105595969540] : SUM([daily_slot_duration])/60}' />
            </column>
            <column caption='L28 Days Filter' datatype='boolean' name='[Calculation_1798625105595969540]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 11] = &apos;All&apos;&#10;OR [Parameters].[Parameter 11] = &apos;No Orders&apos; AND [has_any_order_l28_days] = FALSE&#10;OR [Parameters].[Parameter 11] = &apos;Any Order&apos; AND [has_any_order_l28_days]&#10;OR [Parameters].[Parameter 11] = &apos;Successful Orders&apos; AND [has_successful_order_l28_days]' />
            </column>
            <column caption='Offline duration % - Line chart' datatype='real' name='[Calculation_51369184860762117]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(CASE [Parameters].[Parameter 5]&#10;  WHEN IN (&apos;Overall&apos;, &apos;By Author&apos;)&#10;    THEN IF [is_offline] = TRUE THEN [duration_seconds] ELSE 0 END&#10;  ELSE IF [is_offline] = TRUE AND [offline_author] = [Parameters].[Parameter 5] THEN [duration_seconds] ELSE 0 END&#10;END)&#10;/&#10;SUM({ EXCLUDE [Calculation_52706191291527169] : SUM([daily_slot_duration])})' />
            </column>
            <column caption='Time Granularity - Offline' datatype='date' name='[Calculation_51932141999566864]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 21]&#10;WHEN 1&#10;THEN [Created Date (Days)]&#10;WHEN 2&#10;THEN [Created Date (Week numbers)]&#10;WHEN 3&#10;THEN [Created Date (Months)]&#10;END' />
            </column>
            <column caption='Offline Duration Dimension' datatype='string' name='[Calculation_52706191291527169]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;  WHEN &apos;Overall&apos;&#10;    THEN &apos;Overall&apos;&#10;  WHEN &apos;By Author&apos;&#10;    THEN [offline_author]&#10;  ELSE [offline_reason]&#10;END' />
            </column>
            <column caption='Tooltip - Offline Duration Line' datatype='string' name='[Calculation_634796450544476161]' role='measure' type='nominal'>
              <calculation class='tableau' formula='ATTR([Calculation_52706191291527169]) + &apos; Offline: &apos; + STR(ROUND([Calculation_51369184860762117]*100, 1)) + &apos;%&apos;' />
            </column>
