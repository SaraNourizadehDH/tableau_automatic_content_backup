      <column caption='Daily Slot Duration Mins - tooltip' datatype='real' name='[Daily Slot Duration Mins (copy)_51932140824174592]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({ EXCLUDE [Calculation_52706191291527169] : SUM([daily_slot_duration])})/60' />
