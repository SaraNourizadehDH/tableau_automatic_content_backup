            <column caption='SF Vendor-level chart KPI Parameter' datatype='string' name='[SF Combo chart KPI Parameter (copy)_164944382551547924]' param-domain-type='list' role='measure' type='nominal' value='&quot;Distinct Salesforce Cases&quot;'>
              <calculation class='tableau' formula='&quot;Distinct Salesforce Cases&quot;' />
            </column>
