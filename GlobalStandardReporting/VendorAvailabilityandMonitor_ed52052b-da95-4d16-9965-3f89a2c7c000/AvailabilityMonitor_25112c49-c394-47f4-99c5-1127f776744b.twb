      <aliases enabled='yes' />
      <column caption='L28 Days Filter' datatype='boolean' name='[Calculation_1266989255785353217]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Has Orders L28 Days - Param (copy)_1266989255785578498] = &apos;All&apos;&#10;OR [Parameters].[Has Orders L28 Days - Param (copy)_1266989255785578498] = &apos;No Orders&apos; AND [has_any_order_l28_days] = FALSE&#10;OR [Parameters].[Has Orders L28 Days - Param (copy)_1266989255785578498] = &apos;Any Order&apos; AND [has_any_order_l28_days]&#10;OR [Parameters].[Has Orders L28 Days - Param (copy)_1266989255785578498] = &apos;Successful Orders&apos; AND [has_successful_order_l28_days]' />
      </column>
      <column caption='_user_entitlement' datatype='boolean' name='[Calculation_175429300976275457]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Blank column' datatype='string' name='[Calculation_1798625105536692224]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;&apos;' />
      </column>
      <column caption='Show/Hide' datatype='boolean' name='[Calculation_1798625105591296001]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 14] = 1' />
      </column>
      <column caption='Vendor Grade Calc' datatype='boolean' name='[Calculation_1798625105592877058]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 15] = &apos;All&apos;&#10;THEN TRUE&#10;ELSEIF [Parameters].[Parameter 15] = &apos;A&apos; AND ([vendor_grade] = &apos;A&apos; OR STARTSWITH([vendor_grade], &apos;A,&apos;))&#10;THEN TRUE&#10;ELSEIF [Parameters].[Parameter 15] = &apos;AA&apos; AND ([vendor_grade] = &apos;AA&apos; OR CONTAINS([vendor_grade], &apos;AA,&apos;) OR CONTAINS([vendor_grade], &apos;,AA&apos;))&#10;THEN TRUE&#10;ELSEIF [Parameters].[Parameter 15] = &apos;AAA&apos; AND ([vendor_grade] = &apos;AAA&apos; OR CONTAINS([vendor_grade], &apos;AAA,&apos;) OR CONTAINS([vendor_grade], &apos;,AAA&apos;))&#10;THEN TRUE&#10;ELSEIF [Parameters].[Parameter 15] = &apos;B&apos; AND ([vendor_grade] = &apos;B&apos; OR CONTAINS([vendor_grade], &apos;B&apos;))&#10;THEN TRUE&#10;ELSEIF [Parameters].[Parameter 15] = &apos;C&apos; AND ([vendor_grade] = &apos;C&apos; OR CONTAINS([vendor_grade], &apos;C&apos;))&#10;THEN TRUE&#10;ELSEIF [Parameters].[Parameter 15] = &apos;D&apos; AND ([vendor_grade] = &apos;D&apos; OR CONTAINS([vendor_grade], &apos;D&apos;))&#10;THEN TRUE&#10;ELSEIF [Parameters].[Parameter 15] = &apos;NA&apos; AND ([vendor_grade] = &apos;NA&apos; OR CONTAINS([vendor_grade], &apos;NA&apos;))&#10;THEN TRUE&#10;END' />
      </column>
      <column caption='Attributes' datatype='string' name='[Calculation_1832190999057936402]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos; &apos;' />
      </column>
      <column caption='Column 1' datatype='string' name='[Calculation_1832190999062958103]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Vendor Grades Parameter]&#10;WHEN &apos;Vendor Grades&apos;&#10;THEN [vendor_grade]&#10;WHEN &apos;Vendor Maturities&apos;&#10;THEN [vendor_maturities]&#10;WHEN &apos;Vendor Type&apos;&#10;THEN [vendor_type]&#10;WHEN &apos;Vendor Verticals&apos;&#10;THEN [vertical_type]&#10;WHEN &apos;Order Fail - Reasons&apos;&#10;THEN [fail_reasons]&#10;WHEN &apos;Order Fail - Delivery Types&apos;&#10;THEN [fail_delivery_type]&#10;WHEN &apos;Lookback Range&apos;&#10;THEN [lookback_range]&#10;WHEN &apos;Deployment Type&apos;&#10;THEN [deployment_type]&#10;WHEN &apos;Offline Duration&apos;&#10;THEN IFNULL(STR([config_offline_duration]), &apos;-&apos;)&#10;WHEN &apos;Inbox Message&apos;&#10;THEN IF ISNULL([config_inbox_message]) THEN &apos;-&apos; &#10;     ELSEIF [config_inbox_message] = TRUE THEN &apos;True&apos;&#10;     ELSE &apos;-&apos;&#10;     END&#10;WHEN &apos;Salesforce Ticket Priority&apos;&#10;THEN IFNULL([config_salesforce_priority], &apos;-&apos;)&#10;WHEN &apos;Is Checkin Required to Reopen?&apos;&#10;THEN IF ISNULL([config_is_check_in_required_reopen]) THEN &apos;-&apos; &#10;     ELSEIF [config_is_check_in_required_reopen] = TRUE THEN &apos;True&apos; &#10;     ELSE &apos;False&apos; &#10;     END&#10;END' />
      </column>
      <column caption='% of overall rules' datatype='real' name='[Calculation_1832190999071916062]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([rule_id])&#10;/&#10;SUM({ EXCLUDE [rule_type], [Calculation_508906760508780544] : COUNTD([rule_id])})' />
      </column>
      <column caption='% Issues Actioned' datatype='real' name='[Calculation_251849739414814720]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([issues_actioned])/SUM([issues_detected])' />
      </column>
      <column caption='% Vendors Actioned' datatype='real' name='[Calculation_251849739424251905]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendors_actioned])/SUM([vendors_detected])' />
      </column>
      <column caption='Show Data Calc' datatype='real' name='[Calculation_251849739428081666]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 14]' />
      </column>
      <column caption='View by - Issue Detection Action' datatype='string' name='[Calculation_251849739428872195]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 13]' />
      </column>
      <column caption='Bar Chart Width' datatype='integer' name='[Calculation_302093035874455552]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='10' />
      </column>
      <column caption='Is Enabled - Param Filter' datatype='boolean' name='[Calculation_4082653839793725440]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;  [Parameters].[Parameter 22] = &quot;(All)&quot;&#10;  THEN TRUE&#10;ELSEIF&#10;  [Parameters].[Parameter 22] = &quot;Enabled&quot; AND [is_enabled] = TRUE&#10;  THEN TRUE&#10;ELSEIF&#10;  [Parameters].[Parameter 22] = &quot;Not Enabled&quot; AND [is_enabled] = FALSE&#10;  THEN TRUE&#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='Rule Enablement' datatype='string' name='[Calculation_508906760508780544]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [is_enabled]&#10;WHEN TRUE&#10;THEN &apos;Enabled&apos;&#10;WHEN FALSE&#10;THEN &apos;Not Enabled&apos;&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Issue Created Date' datatype='date' name='[Calculation_51932141995761679]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 21]&#10;WHEN 1&#10;THEN [Issue Date (Days)]&#10;WHEN 2&#10;THEN [Issue Date (Week numbers)]&#10;WHEN 3&#10;THEN [Issue Date (Months)]&#10;END' />
      </column>
      <column caption='Vendor L28D Issues Detected' datatype='integer' name='[Calculation_51932142004543506]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED [issue_date] : SUM([issues_detected])}' />
