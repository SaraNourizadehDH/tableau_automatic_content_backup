      <aliases enabled='yes' />
      <column caption='# Issues Attributed to Open Cases' datatype='integer' name='[# Closed Cases (copy)_564849918858477583]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [case_closure] = &apos;Open&apos; THEN [case_id]+IFNULL([issue_id],&apos;&apos;) END)' />
      </column>
      <column caption='# Distinct Closed Cases' datatype='integer' name='[# Distinct Open Cases (copy)_164944382496428035]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [case_closure] != &apos;Open&apos; THEN [case_id] END)' />
      </column>
      <column caption='# Distinct Unsuccessful Cases' datatype='integer' name='[# Distinct Successful Cases (copy)_164944382498631686]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF STARTSWITH([case_closure], &apos;Unsuccessful&apos;) THEN [case_id] END)' />
      </column>
      <column caption='# Unsuccessful (Unreachable) Cases' datatype='integer' name='[# Invalid Cases (copy)_564849918861856785]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [case_closure] = &apos;Unsuccessful - Unreachable&apos; THEN [case_id]+IFNULL([issue_id],&apos;&apos;) END)' />
      </column>
      <column caption='# Distinct Successful Cases' datatype='integer' name='[# Issues Attributed to Successful Cases (copy)_164944382498222084]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [case_closure] = &apos;Successful&apos; THEN [case_id] END)' />
      </column>
      <column caption='# Issues Attributed to Unsuccessful Cases' datatype='integer' name='[# Issues Attributed to Successful Cases (copy)_164944382527701007]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF STARTSWITH([case_closure], &apos;Unsuccessful&apos;) THEN [case_id]+IFNULL([issue_id],&apos;&apos;) END)' />
      </column>
      <column caption='# Distinct Open Cases' datatype='integer' name='[# Open Cases (copy)_164944382493724674]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [case_closure] = &apos;Open&apos; THEN [case_id] END)' />
      </column>
      <column caption='# Issues Attributed to Invalid Cases' datatype='integer' name='[# Successful Cases (copy)_564849918861795344]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [case_closure] = &apos;Invalid&apos; THEN [case_id]+IFNULL([issue_id],&apos;&apos;) END)' />
      </column>
      <column caption='# Unsuccessful (Disagreement) Cases' datatype='integer' name='[# Unsuccessful (Unreachable) Cases (copy) (copy)_564849918862598163]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [case_closure] = &apos;Unsuccessful - Disagreement&apos; THEN [case_id]+IFNULL([issue_id],&apos;&apos;) END)' />
      </column>
      <column caption='# Unsuccessful (Others) Cases' datatype='integer' name='[# Unsuccessful (Unreachable) Cases (copy)_564849918862581778]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [case_closure] = &apos;Unsuccessful - Others&apos; THEN [case_id]+IFNULL([issue_id],&apos;&apos;) END)' />
      </column>
      <column caption='% Distinct Open Cases' datatype='real' name='[% Distinct Closed Cases (copy)_164944382546432017]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([# Open Cases (copy)_164944382493724674]/[Calculation_164944382493179905], 0)' />
      </column>
      <column caption='% Distinct Closed Cases' datatype='real' name='[% Distinct Successfully Closed Cases (copy)_164944382546083856]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([# Distinct Open Cases (copy)_164944382496428035]/[Calculation_164944382493179905], 0)' />
      </column>
      <column caption='% Distinct Successfully Closed Cases' datatype='real' name='[% Issues Attributed to Successfully Closed Cases (copy)_164944382498406405]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([# Issues Attributed to Successful Cases (copy)_164944382498222084]/[Calculation_164944382493179905], 0)' />
      </column>
      <column caption='% Issues Attributed to Unsuccessful Cases' datatype='real' name='[% Issues Attributed to Successfully Closed Cases (copy)_164944382527561742]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([# Issues Attributed to Successful Cases (copy)_164944382527701007]/[Calculation_564849918857854990], 0)' />
      </column>
      <column caption='% Issues Attributed to Open Cases' datatype='real' name='[% Successfully Closed Cases (copy)_5557582722724487192]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([# Closed Cases (copy)_564849918858477583]/[Calculation_564849918857854990], 0)' />
      </column>
      <column caption='# Issues Attributed to Successful Cases' datatype='integer' name='[All Cases (copy)_564849918813560835]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [case_closure] = &apos;Successful&apos; THEN [case_id]+IFNULL([issue_id],&apos;&apos;) END)' />
      </column>
      <column caption='SF L28 Days Filter' datatype='boolean' name='[Calculation_1266989255787446277]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Has Orders L28 Days - Param Tab3 (copy)_1266989255787528198] = &apos;All&apos;&#10;OR [Parameters].[Has Orders L28 Days - Param Tab3 (copy)_1266989255787528198] = &apos;No Orders&apos; AND [has_any_order_l28_days] = FALSE&#10;OR [Parameters].[Has Orders L28 Days - Param Tab3 (copy)_1266989255787528198] = &apos;Any Order&apos; AND [has_any_order_l28_days]&#10;OR [Parameters].[Has Orders L28 Days - Param Tab3 (copy)_1266989255787528198] = &apos;Successful Orders&apos; AND [has_successful_order_l28_days]' />
      </column>
      <column caption='SF Vendor-level Case details' datatype='string' name='[Calculation_164944382483308544]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 26]' />
      </column>
      <column caption='# Distinct Cases' datatype='integer' name='[Calculation_164944382493179905]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([case_id])' />
      </column>
      <column caption='Avg. Time to Read (hours)' datatype='real' name='[Calculation_164944382523490313]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([seconds_to_read])/3600)/SUM(IF [message_status] = &apos;READ&apos; THEN [messages] END)' />
      </column>
      <column caption='SF Combo Chart Display Filter' datatype='string' name='[Calculation_164944382527070221]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 27]' />
      </column>
      <column caption='SF Combo Chart Header' datatype='string' name='[Calculation_164944382547054610]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 27] = &apos;Issues Attributed to Salesforce Cases&apos;&#10;  THEN &apos;Issues Attributed to Salesforce Cases&apos;&#10;ELSE &apos;Distinct Salesforce Cases&apos;&#10;END' />
      </column>
      <column caption='SF Vendor-level Chart Display' datatype='string' name='[Calculation_164944382555021334]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[SF Combo chart KPI Parameter (copy)_164944382551547924]' />
      </column>
      <column caption='Entity ID | Vendor Code' datatype='string' name='[Calculation_164944382799724567]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[entity_id]+ &apos; | &apos; + [vendor_code]' />
      </column>
      <column caption='SF Vendor-level Chart KPI' datatype='integer' name='[Calculation_164944382800666648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[SF Combo chart KPI Parameter (copy)_164944382551547924] = &apos;Issues Attributed to Salesforce Cases&apos;&#10;  THEN [# Closed Cases (copy)_564849918858477583]&#10;ELSE [# Open Cases (copy)_164944382493724674]&#10;END' />
      </column>
      <column caption='Vendor Set Group' datatype='string' name='[Calculation_164944382801850393]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Top N Vendors by SF Cases]&#10;THEN &apos;Top &apos; + STR([Parameters].[Parameter 25]) + &apos; Vendors&apos;&#10;ELSE &apos;Others&apos;&#10;END' />
      </column>
      <column caption='_user_entitlement' datatype='boolean' name='[Calculation_175429300974366720]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Blank column' datatype='string' name='[Calculation_1798625105536692224]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;&apos;' />
      </column>
      <column caption='Attributes' datatype='string' name='[Calculation_1832190999057936402]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos; &apos;' />
      </column>
      <column caption='Avg. # Messages/Vendor' datatype='real' name='[Calculation_2256092353878077440]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5557582722722201622]/[Calculation_564849918822690823]' />
      </column>
      <column caption='SF Vendor-level Chart Rank' datatype='boolean' name='[Calculation_51369232233353216]' role='measure' type='nominal'>
        <calculation class='tableau' formula='RANK([Calculation_164944382800666648]) &lt;= [Parameters].[Parameter 25]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Time Period' datatype='date' name='[Calculation_51932141995761679]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 21]&#10;WHEN 1&#10;THEN [Created Date (Days)]&#10;WHEN 2&#10;THEN [Created Date (Week numbers)]&#10;WHEN 3&#10;THEN [Created Date (Months)]&#10;END' />
      </column>
      <column caption='Dimension A' datatype='string' name='[Calculation_5557582722482151427]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Table Dimension A (copy)_5557582722481463296]&#10;  WHEN &apos;Region&apos;&#10;    THEN [region]&#10;  WHEN &apos;Brand Name&apos;&#10;    THEN [brand_name]&#10;  WHEN &apos;Country&apos;&#10;    THEN [country_name]&#10;  WHEN &apos;Vendor Grade&apos;&#10;    THEN [vendor_grade]&#10;  WHEN &apos;Vertical Type&apos;&#10;    THEN [vertical_type]&#10;  WHEN &apos;Rule Type&apos;&#10;    THEN [rule_type]&#10;  WHEN &apos;Rule ID&apos;&#10;    THEN [rule_id]&#10;  WHEN &apos;Case Reason&apos;&#10;    THEN [case_reason]&#10;  WHEN &apos;Case Closure Reason&apos;&#10;    THEN [case_closure]&#10;END' />
      </column>
      <column caption='SF Table Metric' datatype='real' name='[Calculation_5557582722483286021]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 23]&#10;  WHEN &apos;# Issues Attributed to Cases&apos;&#10;    THEN -1*[Calculation_564849918857854990]&#10;  WHEN &apos;% Issues Attributed to Open Cases&apos;&#10;    THEN [# Closed Cases (copy)_564849918858477583]/[Calculation_564849918857854990]&#10;  WHEN &apos;% Issues Attributed to Closed Cases&apos;&#10;    THEN [Calculation_564849918825971720]/[Calculation_564849918857854990]&#10;  WHEN &apos;% Issues Attributed to Successfully Closed Cases&apos;&#10;    THEN [All Cases (copy)_564849918813560835]/[Calculation_564849918857854990]&#10;  WHEN &apos;% Issues Attributed to Unsuccessful Cases&apos;&#10;    THEN COUNTD(IF REGEXP_MATCH([case_closure], &apos;Unsuccessful&apos;) THEN [case_id]+[issue_id] ELSE NULL END)/[Calculation_564849918857854990]&#10;  WHEN &apos;# Distinct Cases&apos;&#10;    THEN -1*[Calculation_164944382493179905]&#10;  WHEN &apos;% Distinct Open Cases&apos;&#10;    THEN [# Open Cases (copy)_164944382493724674]/[Calculation_164944382493179905]&#10;  WHEN &apos;% Distinct Closed Cases&apos;&#10;    THEN [# Distinct Open Cases (copy)_164944382496428035]/[Calculation_164944382493179905]&#10;  WHEN &apos;% Distinct Successfully Closed Cases&apos;&#10;    THEN [# Issues Attributed to Successful Cases (copy)_164944382498222084]/[Calculation_164944382493179905]&#10;  WHEN &apos;% Distinct Unsuccessful Cases&apos;&#10;    THEN [# Distinct Successful Cases (copy)_164944382498631686]/[Calculation_164944382493179905]&#10;END' />
      </column>
      <column caption='SF X-Axis' datatype='string' name='[Calculation_5557582722486411271]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 24]&#10;  WHEN &apos;By Time&apos;&#10;    THEN &#10;STR(YEAR([Calculation_51932141995761679]))+ &quot;.&quot;&#10;+ (IF MONTH([Calculation_51932141995761679])&lt;10 THEN &quot;0&quot;+STR(MONTH([Calculation_51932141995761679])) ELSE STR(MONTH([Calculation_51932141995761679])) END) + &quot;.&quot;&#10;+(IF DAY([Calculation_51932141995761679])&lt;10 THEN &quot;0&quot;+STR(DAY([Calculation_51932141995761679])) ELSE STR(DAY([Calculation_51932141995761679])) END)&#10;&#10;  WHEN &apos;By Rule Type&apos;&#10;    THEN [rule_type]&#10;END' />
