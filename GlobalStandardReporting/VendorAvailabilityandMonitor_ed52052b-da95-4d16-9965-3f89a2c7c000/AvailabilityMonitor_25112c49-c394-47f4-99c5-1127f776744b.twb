    <worksheet name='Messages by Date'>
      <table>
        <view>
          <datasources>
            <datasource caption='vendor_monitor_salesforce_inbox (rl)' name='federated.04hfoha10oo2oa1cnvvp21d6ti0d (copy)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Has Orders L28 Days - Param Tab5' datatype='string' name='[Has Orders L28 Days - Param Tab4 (copy)_5557582722706337804]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column alias='Day' caption='Select Time Granularity' datatype='integer' name='[Parameter 21]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='Day' />
                <alias key='2' value='Week' />
                <alias key='3' value='Month' />
              </aliases>
            </column>
            <column caption='Inbox X-Axis Param' datatype='string' name='[SF X-Axis Param (copy)_5557582722712166417]' param-domain-type='list' role='measure' type='nominal' value='&quot;By Time&quot;'>
              <calculation class='tableau' formula='&quot;By Time&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.04hfoha10oo2oa1cnvvp21d6ti0d (copy)'>
            <column caption='Time Period' datatype='date' name='[Calculation_51932141995761679]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 21]&#10;WHEN 1&#10;THEN [Created Date (Days)]&#10;WHEN 2&#10;THEN [Created Date (Week numbers)]&#10;WHEN 3&#10;THEN [Created Date (Months)]&#10;END' />
            </column>
            <column caption='% Read Messages' datatype='real' name='[Calculation_5557582722703794185]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [message_status] = &apos;READ&apos; THEN [messages] ELSE 0 END)/SUM([messages])' />
            </column>
            <column caption='# Messages' datatype='integer' name='[Calculation_5557582722722201622]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([messages])' />
            </column>
            <column datatype='date' name='[Created Date (Days)]' role='dimension' type='ordinal' user:agg-type='Day-Trunc' user:base-field='created_date' user:ui-builder='date-bin-builder'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;day&apos;, [created_date]))' />
            </column>
            <column datatype='date' name='[Created Date (Months)]' role='dimension' type='ordinal' user:agg-type='Month-Trunc' user:base-field='created_date' user:ui-builder='date-bin-builder'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [created_date]))' />
            </column>
            <column datatype='date' name='[Created Date (Week numbers)]' role='dimension' type='ordinal' user:agg-type='Week-Trunc' user:base-field='created_date' user:ui-builder='date-bin-builder'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;, [created_date]))' />
            </column>
            <column caption='Inbox L28 Days Filter' datatype='boolean' name='[SF L28 Days Filter (copy)_5557582722713251861]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Has Orders L28 Days - Param Tab4 (copy)_5557582722706337804] = &apos;All&apos;&#10;OR [Parameters].[Has Orders L28 Days - Param Tab4 (copy)_5557582722706337804] = &apos;No Orders&apos; AND [has_any_order_l28_days] = FALSE&#10;OR [Parameters].[Has Orders L28 Days - Param Tab4 (copy)_5557582722706337804] = &apos;Any Order&apos; AND [has_any_order_l28_days]&#10;OR [Parameters].[Has Orders L28 Days - Param Tab4 (copy)_5557582722706337804] = &apos;Successful Orders&apos; AND [has_successful_order_l28_days]' />
            </column>
            <column caption='Inbox X-Axis' datatype='string' name='[X-Axis (copy)_5557582722712289298]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[SF X-Axis Param (copy)_5557582722712166417]&#10;  WHEN &apos;By Time&apos;&#10;    THEN &#10;STR(YEAR([Calculation_51932141995761679]))+ &quot;/&quot;&#10;+ (IF MONTH([Calculation_51932141995761679])&lt;10 THEN &quot;0&quot;+STR(MONTH([Calculation_51932141995761679])) ELSE STR(MONTH([Calculation_51932141995761679])) END) + &quot;/&quot;&#10;+(IF DAY([Calculation_51932141995761679])&lt;10 THEN &quot;0&quot;+STR(DAY([Calculation_51932141995761679])) ELSE STR(DAY([Calculation_51932141995761679])) END)&#10;&#10;  WHEN &apos;By Rule Type&apos;&#10;    THEN [rule_type]&#10;END' />
            </column>
            <column caption='Brand Name' datatype='string' name='[brand_name]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
