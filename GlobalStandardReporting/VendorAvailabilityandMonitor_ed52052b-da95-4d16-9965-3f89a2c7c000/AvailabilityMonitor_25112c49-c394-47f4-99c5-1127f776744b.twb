    <worksheet name='Inbox Custom Tabular View'>
      <table>
        <view>
          <datasources>
            <datasource caption='vendor_monitor_salesforce_inbox (rl)' name='federated.04hfoha10oo2oa1cnvvp21d6ti0d (copy)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Has Orders L28 Days - Param Tab5' datatype='string' name='[Has Orders L28 Days - Param Tab4 (copy)_5557582722706337804]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column caption='Inbox Table Dimension B' datatype='string' name='[Inbox Table Dimension A (copy)_5557582722706239499]' param-domain-type='list' role='measure' type='nominal' value='&quot;Vendor Grade&quot;'>
              <calculation class='tableau' formula='&quot;Vendor Grade&quot;' />
            </column>
            <column alias='Day' caption='Select Time Granularity' datatype='integer' name='[Parameter 21]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='Day' />
                <alias key='2' value='Week' />
                <alias key='3' value='Month' />
              </aliases>
            </column>
            <column caption='Inbox Metric' datatype='string' name='[SF Metric (copy)_5557582722707501072]' param-domain-type='list' role='measure' type='nominal' value='&quot;Avg. \# Messages/Vendor&quot;'>
              <calculation class='tableau' formula='&quot;Avg. # Messages/Vendor&quot;' />
            </column>
            <column caption='Inbox Table Dimension A' datatype='string' name='[SF Table Dimension A (copy)_5557582722706133002]' param-domain-type='list' role='measure' type='nominal' value='&quot;Region&quot;'>
              <calculation class='tableau' formula='&quot;Region&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.04hfoha10oo2oa1cnvvp21d6ti0d (copy)'>
            <column caption='Avg. Time to Read (hours)' datatype='real' name='[Calculation_164944382523490313]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([seconds_to_read])/3600)/SUM(IF [message_status] = &apos;READ&apos; THEN [messages] END)' />
            </column>
            <column caption='Avg. # Messages/Vendor' datatype='real' name='[Calculation_2256092353878077440]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5557582722722201622]/[Calculation_564849918822690823]' />
            </column>
            <column caption='Time Period' datatype='date' name='[Calculation_51932141995761679]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 21]&#10;WHEN 1&#10;THEN [Created Date (Days)]&#10;WHEN 2&#10;THEN [Created Date (Week numbers)]&#10;WHEN 3&#10;THEN [Created Date (Months)]&#10;END' />
            </column>
            <column caption='% Read Messages' datatype='real' name='[Calculation_5557582722703794185]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [message_status] = &apos;READ&apos; THEN [messages] ELSE 0 END)/SUM([messages])' />
            </column>
            <column caption='# Messages' datatype='integer' name='[Calculation_5557582722722201622]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([messages])' />
            </column>
            <column caption='# Vendors (messages)' datatype='integer' name='[Calculation_564849918822690823]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(COUNTD(IF [messages]&gt;0 THEN [vendor_code] ELSE NULL END), 0)' />
            </column>
