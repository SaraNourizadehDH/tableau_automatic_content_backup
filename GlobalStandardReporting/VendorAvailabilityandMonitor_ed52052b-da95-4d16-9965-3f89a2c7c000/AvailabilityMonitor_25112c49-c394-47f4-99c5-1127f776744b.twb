    <worksheet name='Active Rules - by Type - %'>
      <layout-options>
        <title>
          <formatted-text>
            <run>% Rules - by Enablement and Type</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='vendor_monitor_rule_level (rl)' name='federated.04hfoha10oo2oa1cnvvp21d6ti0d' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Rules - by Enablement and Type - Param' datatype='string' name='[Parameter 12]' param-domain-type='list' role='measure' type='nominal' value='&quot;Absolute Values&quot;'>
              <calculation class='tableau' formula='&quot;Absolute Values&quot;' />
            </column>
            <column caption='Vendor Grades - Param' datatype='string' name='[Parameter 15]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column caption='Vendor Vertical - Param' datatype='string' name='[Parameter 16]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column caption='Vendor Maturities - Param' datatype='string' name='[Parameter 17]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column caption='Delivery Type - Param' datatype='string' name='[Parameter 18]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column caption='Order Failure Reasons - Param' datatype='string' name='[Parameter 19]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column caption='Vendor Type - Param' datatype='string' name='[Parameter 20]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column caption='Is Enabled Parameter' datatype='string' name='[Parameter 22]' param-domain-type='list' role='measure' type='nominal' value='&quot;(All)&quot;'>
              <calculation class='tableau' formula='&quot;(All)&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.04hfoha10oo2oa1cnvvp21d6ti0d'>
            <column caption='Vendor Grade Calc' datatype='boolean' name='[Calculation_1798625105592877058]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 15] = &apos;All&apos;&#10;THEN TRUE&#10;ELSEIF [Parameters].[Parameter 15] = &apos;A&apos; AND ([vendor_grade] = &apos;A&apos; OR STARTSWITH([vendor_grade], &apos;A,&apos;))&#10;THEN TRUE&#10;ELSEIF [Parameters].[Parameter 15] = &apos;AA&apos; AND ([vendor_grade] = &apos;AA&apos; OR CONTAINS([vendor_grade], &apos;AA,&apos;) OR CONTAINS([vendor_grade], &apos;,AA&apos;))&#10;THEN TRUE&#10;ELSEIF [Parameters].[Parameter 15] = &apos;AAA&apos; AND ([vendor_grade] = &apos;AAA&apos; OR CONTAINS([vendor_grade], &apos;AAA,&apos;) OR CONTAINS([vendor_grade], &apos;,AAA&apos;))&#10;THEN TRUE&#10;ELSEIF [Parameters].[Parameter 15] = &apos;B&apos; AND ([vendor_grade] = &apos;B&apos; OR CONTAINS([vendor_grade], &apos;B&apos;))&#10;THEN TRUE&#10;ELSEIF [Parameters].[Parameter 15] = &apos;C&apos; AND ([vendor_grade] = &apos;C&apos; OR CONTAINS([vendor_grade], &apos;C&apos;))&#10;THEN TRUE&#10;ELSEIF [Parameters].[Parameter 15] = &apos;D&apos; AND ([vendor_grade] = &apos;D&apos; OR CONTAINS([vendor_grade], &apos;D&apos;))&#10;THEN TRUE&#10;ELSEIF [Parameters].[Parameter 15] = &apos;NA&apos; AND ([vendor_grade] = &apos;NA&apos; OR CONTAINS([vendor_grade], &apos;NA&apos;))&#10;THEN TRUE&#10;END' />
            </column>
            <column caption='Is Enabled - Param Filter' datatype='boolean' name='[Calculation_4082653839793725440]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;  [Parameters].[Parameter 22] = &quot;(All)&quot;&#10;  THEN TRUE&#10;ELSEIF&#10;  [Parameters].[Parameter 22] = &quot;Enabled&quot; AND [is_enabled] = TRUE&#10;  THEN TRUE&#10;ELSEIF&#10;  [Parameters].[Parameter 22] = &quot;Not Enabled&quot; AND [is_enabled] = FALSE&#10;  THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='Rule Enablement' datatype='string' name='[Calculation_508906760508780544]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [is_enabled]&#10;WHEN TRUE&#10;THEN &apos;Enabled&apos;&#10;WHEN FALSE&#10;THEN &apos;Not Enabled&apos;&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Chart Type - Rules - by Enablement and Type' datatype='string' name='[Calculation_564146224756473860]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 12]' />
            </column>
            <column caption='Vendor Vertical Filter' datatype='boolean' name='[Calculation_6395815163449012228]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 16] = &apos;All&apos;&#10;THEN TRUE&#10;ELSEIF [Parameters].[Parameter 16] = &apos;Restaurants&apos; AND CONTAINS([vertical_type], &apos;restaurant&apos;)&#10;THEN TRUE&#10;ELSEIF [Parameters].[Parameter 16] = &apos;Grocery &amp; Darkstores&apos; AND (CONTAINS([vertical_type], &apos;groceries&apos;) OR CONTAINS([vertical_type], &apos;darkstore&apos;))&#10;THEN TRUE&#10;ELSEIF [Parameters].[Parameter 16] = &apos;Others&apos; AND NOT(CONTAINS([vertical_type], &apos;restaurant&apos;)) AND NOT(CONTAINS([vertical_type], &apos;groceries&apos;)) AND NOT(CONTAINS([vertical_type], &apos;darkstore&apos;))&#10;THEN TRUE&#10;END' />
            </column>
            <column caption='Vendor Maturities - Filter' datatype='boolean' name='[Calculation_6395815163452616709]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 17] = &apos;All&apos;&#10;THEN TRUE&#10;ELSEIF [Parameters].[Parameter 17] = &apos;NEW_VENDOR&apos; AND CONTAINS([vendor_maturities], &apos;NEW_VENDOR&apos;)&#10;THEN TRUE&#10;ELSEIF [Parameters].[Parameter 17] = &apos;MATURE_VENDOR&apos; AND CONTAINS([vendor_maturities], &apos;MATURE_VENDOR&apos;)&#10;THEN TRUE&#10;END' />
            </column>
            <column caption='Order Failure Delivery Types - Filter' datatype='boolean' name='[Calculation_6395815163453313030]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 18] = &apos;All&apos;&#10;OR&#10;CONTAINS([fail_delivery_type], [Parameters].[Parameter 18])' />
            </column>
            <column caption='Order Failure Reasons - Filter' datatype='boolean' name='[Calculation_6395815163454160903]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 19] = &apos;All&apos;&#10;OR&#10;CONTAINS([fail_reasons],[Parameters].[Parameter 19])' />
            </column>
            <column caption='Vertical Type - Filter' datatype='boolean' name='[Calculation_6395815163457318920]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 20] = &apos;All&apos;&#10;OR&#10;CONTAINS([vendor_type], [Parameters].[Parameter 20])' />
            </column>
