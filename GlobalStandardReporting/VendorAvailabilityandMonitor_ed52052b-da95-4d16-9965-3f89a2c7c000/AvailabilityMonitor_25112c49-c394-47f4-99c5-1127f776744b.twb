          <datasource-dependencies datasource='federated.04hfoha10oo2oa1cnvvp21d6ti0d (copy)'>
            <column caption='# Issues Attributed to Open Cases' datatype='integer' name='[# Closed Cases (copy)_564849918858477583]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [case_closure] = &apos;Open&apos; THEN [case_id]+IFNULL([issue_id],&apos;&apos;) END)' />
            </column>
            <column caption='# Distinct Open Cases' datatype='integer' name='[# Open Cases (copy)_164944382493724674]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [case_closure] = &apos;Open&apos; THEN [case_id] END)' />
            </column>
            <column caption='SF L28 Days Filter' datatype='boolean' name='[Calculation_1266989255787446277]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Has Orders L28 Days - Param Tab3 (copy)_1266989255787528198] = &apos;All&apos;&#10;OR [Parameters].[Has Orders L28 Days - Param Tab3 (copy)_1266989255787528198] = &apos;No Orders&apos; AND [has_any_order_l28_days] = FALSE&#10;OR [Parameters].[Has Orders L28 Days - Param Tab3 (copy)_1266989255787528198] = &apos;Any Order&apos; AND [has_any_order_l28_days]&#10;OR [Parameters].[Has Orders L28 Days - Param Tab3 (copy)_1266989255787528198] = &apos;Successful Orders&apos; AND [has_successful_order_l28_days]' />
            </column>
            <column caption='SF Vendor-level Case details' datatype='string' name='[Calculation_164944382483308544]' role='dimension' type='nominal'>
