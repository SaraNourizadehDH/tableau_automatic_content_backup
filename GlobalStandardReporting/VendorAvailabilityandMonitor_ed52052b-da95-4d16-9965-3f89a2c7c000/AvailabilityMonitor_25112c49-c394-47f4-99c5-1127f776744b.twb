      <table>
        <view>
          <datasources>
            <datasource caption='vendor_monitor_salesforce_inbox (rl)' name='federated.04hfoha10oo2oa1cnvvp21d6ti0d (copy)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Has Orders L28 Days - Param Tab4' datatype='string' name='[Has Orders L28 Days - Param Tab3 (copy)_1266989255787528198]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column alias='Day' caption='Select Time Granularity' datatype='integer' name='[Parameter 21]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='Day' />
                <alias key='2' value='Week' />
                <alias key='3' value='Month' />
              </aliases>
            </column>
            <column caption='SF X-Axis Param' datatype='string' name='[Parameter 24]' param-domain-type='list' role='measure' type='nominal' value='&quot;By Time&quot;'>
              <calculation class='tableau' formula='&quot;By Time&quot;' />
            </column>
            <column caption='SF Combo chart KPI Parameter' datatype='string' name='[Parameter 27]' param-domain-type='list' role='measure' type='nominal' value='&quot;Distinct Salesforce Cases&quot;'>
              <calculation class='tableau' formula='&quot;Distinct Salesforce Cases&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.04hfoha10oo2oa1cnvvp21d6ti0d (copy)'>
            <column caption='# Issues Attributed to Open Cases' datatype='integer' name='[# Closed Cases (copy)_564849918858477583]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [case_closure] = &apos;Open&apos; THEN [case_id]+IFNULL([issue_id],&apos;&apos;) END)' />
            </column>
            <column caption='% Issues Attributed to Open Cases' datatype='real' name='[% Successfully Closed Cases (copy)_5557582722724487192]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([# Closed Cases (copy)_564849918858477583]/[Calculation_564849918857854990], 0)' />
            </column>
            <column caption='# Issues Attributed to Successful Cases' datatype='integer' name='[All Cases (copy)_564849918813560835]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [case_closure] = &apos;Successful&apos; THEN [case_id]+IFNULL([issue_id],&apos;&apos;) END)' />
            </column>
            <column caption='SF L28 Days Filter' datatype='boolean' name='[Calculation_1266989255787446277]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Has Orders L28 Days - Param Tab3 (copy)_1266989255787528198] = &apos;All&apos;&#10;OR [Parameters].[Has Orders L28 Days - Param Tab3 (copy)_1266989255787528198] = &apos;No Orders&apos; AND [has_any_order_l28_days] = FALSE&#10;OR [Parameters].[Has Orders L28 Days - Param Tab3 (copy)_1266989255787528198] = &apos;Any Order&apos; AND [has_any_order_l28_days]&#10;OR [Parameters].[Has Orders L28 Days - Param Tab3 (copy)_1266989255787528198] = &apos;Successful Orders&apos; AND [has_successful_order_l28_days]' />
            </column>
            <column caption='SF Combo Chart Display Filter' datatype='string' name='[Calculation_164944382527070221]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 27]' />
            </column>
            <column caption='Time Period' datatype='date' name='[Calculation_51932141995761679]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 21]&#10;WHEN 1&#10;THEN [Created Date (Days)]&#10;WHEN 2&#10;THEN [Created Date (Week numbers)]&#10;WHEN 3&#10;THEN [Created Date (Months)]&#10;END' />
            </column>
            <column caption='SF X-Axis' datatype='string' name='[Calculation_5557582722486411271]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 24]&#10;  WHEN &apos;By Time&apos;&#10;    THEN &#10;STR(YEAR([Calculation_51932141995761679]))+ &quot;.&quot;&#10;+ (IF MONTH([Calculation_51932141995761679])&lt;10 THEN &quot;0&quot;+STR(MONTH([Calculation_51932141995761679])) ELSE STR(MONTH([Calculation_51932141995761679])) END) + &quot;.&quot;&#10;+(IF DAY([Calculation_51932141995761679])&lt;10 THEN &quot;0&quot;+STR(DAY([Calculation_51932141995761679])) ELSE STR(DAY([Calculation_51932141995761679])) END)&#10;&#10;  WHEN &apos;By Rule Type&apos;&#10;    THEN [rule_type]&#10;END' />
            </column>
            <column caption='% Issues Attributed to Closed Cases' datatype='real' name='[Calculation_564849918825971720]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([Successful Cases (copy)_564849918813761540]/[Calculation_564849918857854990], 0)' />
            </column>
            <column caption='# Issues Attributed to Cases' datatype='integer' name='[Calculation_564849918857854990]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([case_id]+IFNULL([issue_id],&apos;&apos;))' />
            </column>
            <column caption='% Issues Attributed to Successfully Closed Cases' datatype='real' name='[Closed Cases % (copy)_564849918826037257]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([All Cases (copy)_564849918813560835]/[Calculation_564849918857854990], 0)' />
            </column>
            <column datatype='date' name='[Created Date (Days)]' role='dimension' type='ordinal' user:agg-type='Day-Trunc' user:base-field='created_date' user:ui-builder='date-bin-builder'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;day&apos;, [created_date]))' />
            </column>
            <column datatype='date' name='[Created Date (Months)]' role='dimension' type='ordinal' user:agg-type='Month-Trunc' user:base-field='created_date' user:ui-builder='date-bin-builder'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [created_date]))' />
