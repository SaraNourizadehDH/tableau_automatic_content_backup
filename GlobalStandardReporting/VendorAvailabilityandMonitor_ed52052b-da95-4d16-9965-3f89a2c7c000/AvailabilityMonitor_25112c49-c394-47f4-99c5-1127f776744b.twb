    <worksheet name='Rule Configs'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Rule Configurations</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='vendor_monitor_rule_level (rl)' name='federated.04hfoha10oo2oa1cnvvp21d6ti0d' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Vendor Grades - Param' datatype='string' name='[Parameter 15]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column caption='Vendor Vertical - Param' datatype='string' name='[Parameter 16]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column caption='Vendor Maturities - Param' datatype='string' name='[Parameter 17]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column caption='Delivery Type - Param' datatype='string' name='[Parameter 18]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column caption='Order Failure Reasons - Param' datatype='string' name='[Parameter 19]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column caption='Vendor Type - Param' datatype='string' name='[Parameter 20]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column caption='Rule Configs Col 2' datatype='string' name='[Rule Configs Col 1 (copy)_1832190999066902553]' param-domain-type='list' role='measure' type='nominal' value='&quot;Vendor Type&quot;'>
              <calculation class='tableau' formula='&quot;Vendor Type&quot;' />
            </column>
            <column caption='Rule Configs Col 3' datatype='string' name='[Rule Configs Col 2 (copy)_1832190999066943514]' param-domain-type='list' role='measure' type='nominal' value='&quot;Offline Duration&quot;'>
              <calculation class='tableau' formula='&quot;Offline Duration&quot;' />
            </column>
            <column caption='Rule Configs Col 4' datatype='string' name='[Rule Configs Col 3 (copy)_1832190999066988571]' param-domain-type='list' role='measure' type='nominal' value='&quot;Salesforce Ticket Priority&quot;'>
              <calculation class='tableau' formula='&quot;Salesforce Ticket Priority&quot;' />
            </column>
            <column caption='Rule Configs Col 1' datatype='string' name='[Vendor Grades Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Vendor Grades&quot;'>
              <calculation class='tableau' formula='&quot;Vendor Grades&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.04hfoha10oo2oa1cnvvp21d6ti0d'>
            <column caption='Blank column' datatype='string' name='[Calculation_1798625105536692224]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;&apos;' />
            </column>
            <column caption='Vendor Grade Calc' datatype='boolean' name='[Calculation_1798625105592877058]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 15] = &apos;All&apos;&#10;THEN TRUE&#10;ELSEIF [Parameters].[Parameter 15] = &apos;A&apos; AND ([vendor_grade] = &apos;A&apos; OR STARTSWITH([vendor_grade], &apos;A,&apos;))&#10;THEN TRUE&#10;ELSEIF [Parameters].[Parameter 15] = &apos;AA&apos; AND ([vendor_grade] = &apos;AA&apos; OR CONTAINS([vendor_grade], &apos;AA,&apos;) OR CONTAINS([vendor_grade], &apos;,AA&apos;))&#10;THEN TRUE&#10;ELSEIF [Parameters].[Parameter 15] = &apos;AAA&apos; AND ([vendor_grade] = &apos;AAA&apos; OR CONTAINS([vendor_grade], &apos;AAA,&apos;) OR CONTAINS([vendor_grade], &apos;,AAA&apos;))&#10;THEN TRUE&#10;ELSEIF [Parameters].[Parameter 15] = &apos;B&apos; AND ([vendor_grade] = &apos;B&apos; OR CONTAINS([vendor_grade], &apos;B&apos;))&#10;THEN TRUE&#10;ELSEIF [Parameters].[Parameter 15] = &apos;C&apos; AND ([vendor_grade] = &apos;C&apos; OR CONTAINS([vendor_grade], &apos;C&apos;))&#10;THEN TRUE&#10;ELSEIF [Parameters].[Parameter 15] = &apos;D&apos; AND ([vendor_grade] = &apos;D&apos; OR CONTAINS([vendor_grade], &apos;D&apos;))&#10;THEN TRUE&#10;ELSEIF [Parameters].[Parameter 15] = &apos;NA&apos; AND ([vendor_grade] = &apos;NA&apos; OR CONTAINS([vendor_grade], &apos;NA&apos;))&#10;THEN TRUE&#10;END' />
            </column>
            <column caption='Column 1' datatype='string' name='[Calculation_1832190999062958103]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Vendor Grades Parameter]&#10;WHEN &apos;Vendor Grades&apos;&#10;THEN [vendor_grade]&#10;WHEN &apos;Vendor Maturities&apos;&#10;THEN [vendor_maturities]&#10;WHEN &apos;Vendor Type&apos;&#10;THEN [vendor_type]&#10;WHEN &apos;Vendor Verticals&apos;&#10;THEN [vertical_type]&#10;WHEN &apos;Order Fail - Reasons&apos;&#10;THEN [fail_reasons]&#10;WHEN &apos;Order Fail - Delivery Types&apos;&#10;THEN [fail_delivery_type]&#10;WHEN &apos;Lookback Range&apos;&#10;THEN [lookback_range]&#10;WHEN &apos;Deployment Type&apos;&#10;THEN [deployment_type]&#10;WHEN &apos;Offline Duration&apos;&#10;THEN IFNULL(STR([config_offline_duration]), &apos;-&apos;)&#10;WHEN &apos;Inbox Message&apos;&#10;THEN IF ISNULL([config_inbox_message]) THEN &apos;-&apos; &#10;     ELSEIF [config_inbox_message] = TRUE THEN &apos;True&apos;&#10;     ELSE &apos;-&apos;&#10;     END&#10;WHEN &apos;Salesforce Ticket Priority&apos;&#10;THEN IFNULL([config_salesforce_priority], &apos;-&apos;)&#10;WHEN &apos;Is Checkin Required to Reopen?&apos;&#10;THEN IF ISNULL([config_is_check_in_required_reopen]) THEN &apos;-&apos; &#10;     ELSEIF [config_is_check_in_required_reopen] = TRUE THEN &apos;True&apos; &#10;     ELSE &apos;False&apos; &#10;     END&#10;END' />
            </column>
            <column caption='Vendor Vertical Filter' datatype='boolean' name='[Calculation_6395815163449012228]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 16] = &apos;All&apos;&#10;THEN TRUE&#10;ELSEIF [Parameters].[Parameter 16] = &apos;Restaurants&apos; AND CONTAINS([vertical_type], &apos;restaurant&apos;)&#10;THEN TRUE&#10;ELSEIF [Parameters].[Parameter 16] = &apos;Grocery &amp; Darkstores&apos; AND (CONTAINS([vertical_type], &apos;groceries&apos;) OR CONTAINS([vertical_type], &apos;darkstore&apos;))&#10;THEN TRUE&#10;ELSEIF [Parameters].[Parameter 16] = &apos;Others&apos; AND NOT(CONTAINS([vertical_type], &apos;restaurant&apos;)) AND NOT(CONTAINS([vertical_type], &apos;groceries&apos;)) AND NOT(CONTAINS([vertical_type], &apos;darkstore&apos;))&#10;THEN TRUE&#10;END' />
            </column>
            <column caption='Vendor Maturities - Filter' datatype='boolean' name='[Calculation_6395815163452616709]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 17] = &apos;All&apos;&#10;THEN TRUE&#10;ELSEIF [Parameters].[Parameter 17] = &apos;NEW_VENDOR&apos; AND CONTAINS([vendor_maturities], &apos;NEW_VENDOR&apos;)&#10;THEN TRUE&#10;ELSEIF [Parameters].[Parameter 17] = &apos;MATURE_VENDOR&apos; AND CONTAINS([vendor_maturities], &apos;MATURE_VENDOR&apos;)&#10;THEN TRUE&#10;END' />
            </column>
            <column caption='Order Failure Delivery Types - Filter' datatype='boolean' name='[Calculation_6395815163453313030]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 18] = &apos;All&apos;&#10;OR&#10;CONTAINS([fail_delivery_type], [Parameters].[Parameter 18])' />
            </column>
            <column caption='Order Failure Reasons - Filter' datatype='boolean' name='[Calculation_6395815163454160903]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 19] = &apos;All&apos;&#10;OR&#10;CONTAINS([fail_reasons],[Parameters].[Parameter 19])' />
            </column>
            <column caption='Vertical Type - Filter' datatype='boolean' name='[Calculation_6395815163457318920]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 20] = &apos;All&apos;&#10;OR&#10;CONTAINS([vendor_type], [Parameters].[Parameter 20])' />
            </column>
            <column caption='Column 2' datatype='string' name='[Rule Config Table - Col 1 (copy)_1832190999066755096]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Rule Configs Col 1 (copy)_1832190999066902553]&#10;WHEN &apos;Vendor Grades&apos;&#10;THEN [vendor_grade]&#10;WHEN &apos;Vendor Maturities&apos;&#10;THEN [vendor_maturities]&#10;WHEN &apos;Vendor Type&apos;&#10;THEN [vendor_type]&#10;WHEN &apos;Vendor Verticals&apos;&#10;THEN [vertical_type]&#10;WHEN &apos;Order Fail - Reasons&apos;&#10;THEN [fail_reasons]&#10;WHEN &apos;Order Fail - Delivery Types&apos;&#10;THEN [fail_delivery_type]&#10;WHEN &apos;Lookback Range&apos;&#10;THEN [lookback_range]&#10;WHEN &apos;Deployment Type&apos;&#10;THEN [deployment_type]&#10;WHEN &apos;Offline Duration&apos;&#10;THEN IFNULL(STR([config_offline_duration]), &apos;-&apos;)&#10;WHEN &apos;Inbox Message&apos;&#10;THEN IF ISNULL([config_inbox_message]) THEN &apos;-&apos; &#10;     ELSEIF [config_inbox_message] = TRUE THEN &apos;True&apos;&#10;     ELSE &apos;-&apos;&#10;     END&#10;WHEN &apos;Salesforce Ticket Priority&apos;&#10;THEN IFNULL([config_salesforce_priority], &apos;-&apos;)&#10;WHEN &apos;Is Checkin Required to Reopen?&apos;&#10;THEN IF ISNULL([config_is_check_in_required_reopen]) THEN &apos;-&apos; &#10;     ELSEIF [config_is_check_in_required_reopen] = TRUE THEN &apos;True&apos; &#10;     ELSE &apos;False&apos; &#10;     END&#10;END' />
            </column>
            <column caption='Column 3' datatype='string' name='[Rule Config Table - Col 2 (copy)_1832190999067054108]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Rule Configs Col 2 (copy)_1832190999066943514]&#10;WHEN &apos;Vendor Grades&apos;&#10;THEN [vendor_grade]&#10;WHEN &apos;Vendor Maturities&apos;&#10;THEN [vendor_maturities]&#10;WHEN &apos;Vendor Type&apos;&#10;THEN [vendor_type]&#10;WHEN &apos;Vendor Verticals&apos;&#10;THEN [vertical_type]&#10;WHEN &apos;Order Fail - Reasons&apos;&#10;THEN [fail_reasons]&#10;WHEN &apos;Order Fail - Delivery Types&apos;&#10;THEN [fail_delivery_type]&#10;WHEN &apos;Lookback Range&apos;&#10;THEN [lookback_range]&#10;WHEN &apos;Deployment Type&apos;&#10;THEN [deployment_type]&#10;WHEN &apos;Offline Duration&apos;&#10;THEN IFNULL(STR([config_offline_duration]), &apos;-&apos;)&#10;WHEN &apos;Inbox Message&apos;&#10;THEN IF ISNULL([config_inbox_message]) THEN &apos;-&apos; &#10;     ELSEIF [config_inbox_message] = TRUE THEN &apos;True&apos;&#10;     ELSE &apos;-&apos;&#10;     END&#10;WHEN &apos;Salesforce Ticket Priority&apos;&#10;THEN IFNULL([config_salesforce_priority], &apos;-&apos;)&#10;WHEN &apos;Is Checkin Required to Reopen?&apos;&#10;THEN IF ISNULL([config_is_check_in_required_reopen]) THEN &apos;-&apos; &#10;     ELSEIF [config_is_check_in_required_reopen] = TRUE THEN &apos;True&apos; &#10;     ELSE &apos;False&apos; &#10;     END&#10;END' />
            </column>
            <column caption='Column 4' datatype='string' name='[Rule Config Table - Col 3 (copy)_1832190999067099165]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Rule Configs Col 3 (copy)_1832190999066988571]&#10;WHEN &apos;Vendor Grades&apos;&#10;THEN [vendor_grade]&#10;WHEN &apos;Vendor Maturities&apos;&#10;THEN [vendor_maturities]&#10;WHEN &apos;Vendor Type&apos;&#10;THEN [vendor_type]&#10;WHEN &apos;Vendor Verticals&apos;&#10;THEN [vertical_type]&#10;WHEN &apos;Order Fail - Reasons&apos;&#10;THEN [fail_reasons]&#10;WHEN &apos;Order Fail - Delivery Types&apos;&#10;THEN [fail_delivery_type]&#10;WHEN &apos;Lookback Range&apos;&#10;THEN [lookback_range]&#10;WHEN &apos;Deployment Type&apos;&#10;THEN [deployment_type]&#10;WHEN &apos;Offline Duration&apos;&#10;THEN IFNULL(STR([config_offline_duration]), &apos;-&apos;)&#10;WHEN &apos;Inbox Message&apos;&#10;THEN IF ISNULL([config_inbox_message]) THEN &apos;-&apos; &#10;     ELSEIF [config_inbox_message] = TRUE THEN &apos;True&apos;&#10;     ELSE &apos;-&apos;&#10;     END&#10;WHEN &apos;Salesforce Ticket Priority&apos;&#10;THEN IFNULL([config_salesforce_priority], &apos;-&apos;)&#10;WHEN &apos;Is Checkin Required to Reopen?&apos;&#10;THEN IF ISNULL([config_is_check_in_required_reopen]) THEN &apos;-&apos; &#10;     ELSEIF [config_is_check_in_required_reopen] = TRUE THEN &apos;True&apos; &#10;     ELSE &apos;False&apos; &#10;     END&#10;END' />
            </column>
            <column caption='Action Type' datatype='string' name='[action_type]' role='dimension' type='nominal' />
            <column caption='Brand Name' datatype='string' name='[brand_name]' role='dimension' type='nominal' />
            <column caption='Send Inbox Message?' datatype='boolean' name='[config_inbox_message]' role='dimension' type='nominal' />
            <column caption='Checkin to Reopen?' datatype='boolean' name='[config_is_check_in_required_reopen]' role='dimension' type='nominal' />
            <column aggregation='Sum' caption='Offline Duration' datatype='integer' name='[config_offline_duration]' role='dimension' type='ordinal' />
            <column caption='Create SF Ticket?' datatype='string' name='[config_salesforce_priority]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Deployment Type' datatype='string' name='[deployment_type]' role='dimension' type='nominal' />
            <column caption='Order Failure Delivery Types' datatype='string' name='[fail_delivery_type]' role='dimension' type='nominal' />
