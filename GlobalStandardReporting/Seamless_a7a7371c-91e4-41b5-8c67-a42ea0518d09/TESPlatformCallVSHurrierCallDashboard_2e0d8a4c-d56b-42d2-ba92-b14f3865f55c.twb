            <column caption='Geo Selection' datatype='string' name='[Calculation_1227793888492670976]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&apos;None&apos; THEN NULL&#13;&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Entity Id&apos; THEN [entity_id]&#13;&#10;ELSEIF [Parameters].[Parameter 1]=&apos;platform&apos; THEN [platform]&#13;&#10;END' />
            </column>
            <column caption='SUM([perc_hurrier_orders_num])/sum([perc_hurrier_orders_denom])' datatype='real' name='[Calculation_1227793888494837765]' role='measure' type='quantitative' user:unnamed='Platform VS Hurrier'>
