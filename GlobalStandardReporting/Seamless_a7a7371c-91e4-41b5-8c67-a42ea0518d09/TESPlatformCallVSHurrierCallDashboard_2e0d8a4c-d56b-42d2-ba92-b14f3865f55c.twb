          <datasource-dependencies datasource='Parameters'>
            <column caption='Geo Dimension' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Entity Id&quot;'>
              <calculation class='tableau' formula='&quot;Entity Id&quot;' />
            </column>
            <column caption='Time Dimension' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Days&quot;'>
              <calculation class='tableau' formula='&quot;Days&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0h7uggo0plcp321cslbf80v757h2'>
            <column caption='% Walk Out Duration' datatype='real' default-format='p0%' name='[% Courier Delay (copy)_1121396339893039110]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([walk_out_duration])/sum([total_count])' />
            </column>
            <column caption='% PDT' datatype='real' default-format='p0%' name='[% Driving Time (copy)_1227793888500002824]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pdt])/sum([total_count])' />
            </column>
            <column caption='% items_count' datatype='real' default-format='p0%' name='[% GMV (copy)_1494069223516229634]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([items_count])/sum([total_count])' />
            </column>
            <column caption='% Delivery Duration Buffer' datatype='real' default-format='p0%' name='[% Preparation Time Buffer  (copy)_1121396339892416516]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_duration_buffer])/sum([total_count])' />
            </column>
            <column caption='% Courier Delay' datatype='real' default-format='p0%' name='[% Preparation Time Buffer  (copy)_1121396339892633605]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([courier_delay])/sum([total_count])' />
            </column>
            <column caption='% GMV' datatype='real' default-format='p0%' name='[% Preparation Time Buffer  (copy)_1494069223515783169]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv])/sum([total_count])' />
