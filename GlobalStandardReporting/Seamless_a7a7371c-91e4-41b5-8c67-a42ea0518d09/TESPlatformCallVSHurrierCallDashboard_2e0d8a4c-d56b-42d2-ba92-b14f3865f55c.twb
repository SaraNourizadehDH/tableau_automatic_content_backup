    <worksheet name='Platform VS Hurrier'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='10'>Comparison: Platform TES Call VS Hurrier TES Call</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='_tes_hurrier_calls+ (cl)' name='federated.0h7uggo0plcp321cslbf80v757h2' />
