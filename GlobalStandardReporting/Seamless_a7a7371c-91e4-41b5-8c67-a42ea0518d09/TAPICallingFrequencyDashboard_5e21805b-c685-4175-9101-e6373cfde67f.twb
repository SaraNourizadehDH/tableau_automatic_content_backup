  <dashboards>
    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Glossary'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/TAPICallingFrequencyDashboard_17379844709170/Dashboard3?rev=' id='Dashboard3' path='/t/GlobalStandardReporting/workbooks/TAPICallingFrequencyDashboard_17379844709170' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='1500' maxwidth='1000' minheight='1500' minwidth='1000' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='25' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
        <zone forceUpdate='true' h='70400' id='3' type-v2='text' w='95700' x='1900' y='800'>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#aa5500' fontname='Slack-Lato' fontsize='15' underline='true'>Glossary</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run>Æ&#10;</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato'>For the purpose of this dashboard, we are excluding the below user agents</run>
            <run>Æ&#10;</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato'>‘%okhttp%’ -- excluding old DNS user agent</run>
            <run>Æ&#10;</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato'> ‘%otif%’ -- excluding new DNS user agent</run>
            <run>Æ&#10;</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato'> ‘%utocomp%’ -- excluding autocomp</run>
            <run>Æ&#10;</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato'> ‘%oneview%’ -- excluding Onveview service used by CS</run>
            <run>Æ&#10;</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato'> ‘%GST Helpcenter Conditions%’</run>
            <run>Æ&#10;</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato'> ‘%Go-http-client%’</run>
            <run>Æ&#10;</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato'> ‘%Ktor client%’</run>
            <run>Æ&#10;</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato'> ‘%Vert.x-WebClient%’</run>
            <run>Æ&#10;</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato'> ‘%gfs-order-processing%’</run>
            <run>Æ&#10;</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato'> ‘%PostmanRuntime%’</run>
            <run>Æ&#10;</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato'> ‘%Faraday%’</run>
            <run>Æ&#10;</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato'> ‘%peya-risk%’</run>
            <run>Æ&#10;</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato'> ‘%peya-delivery-record%’</run>
            <run>Æ&#10;</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato'> ‘%service-oneview-fulfillment-api%’</run>
            <run>Æ&#10;</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato'> ‘%logistics-customer-notifications%’</run>
            <run>Æ&#10;</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato'> ‘%peya-peya-order-tracking-puller%’</run>
            <run>Æ&#10;</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato'>Æ          </run>
            <run>Æ&#10;</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato'> And hence we have the following user agents being considered:</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#1d1c1d' fontname='Slack-Lato'>Efood</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato'>Æ        </run>
            <run>Æ&#10;</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato'>efood-msnexus/</run>
            <run>Æ&#10;</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato'>foody-msnexus/</run>
            <run>Æ&#10;</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#1d1c1d' fontname='Slack-Lato'>Foodora inc Yemek </run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato'>Æ       </run>
            <run>Æ&#10;</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato'>OTTS/</run>
            <run>Æ&#10;</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato'>pandora-OTTS/</run>
            <run>Æ&#10;</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#1d1c1d' fontname='Slack-Lato'>Foodpanda</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato'>Æ        </run>
            <run>Æ&#10;</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato'>pandora-OTAPI/</run>
            <run>Æ&#10;</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato'>pandora-OTTS/</run>
            <run>Æ&#10;</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato'>pandago-c2c-workers/</run>
            <run>Æ&#10;</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato'>OTTS/</run>
            <run>Æ&#10;</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato'>pandago-c2c-workers/</run>
            <run>Æ&#10;</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato'>pandago-c2c-api</run>
            <run>Æ&#10;</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#1d1c1d' fontname='Slack-Lato'>Glovo</run>
            <run>Æ&#10;</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato'>customer-order-flow/</run>
            <run>Æ&#10;</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato'>order-eta/</run>
            <run>Æ&#10;</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato'>laas-engine/</run>
            <run>Æ&#10;</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato'>geofence/</run>
            <run>Æ&#10;</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato'>store-estimations/</run>
            <run>Æ&#10;</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#1d1c1d' fontname='Slack-Lato'>Hungerstation</run>
            <run>Æ&#10;</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato'>hungerstation-rider-experience/</run>
            <run>Æ&#10;</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato'>hungerstation-tracking/</run>
            <run>Æ&#10;</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#1d1c1d' fontname='Slack-Lato'>Pedidosya</run>
            <run>Æ&#10;</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato'>peya-order-location-service/</run>
            <run>Æ&#10;</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#1d1c1d' fontname='Slack-Lato'>Talabat</run>
            <run>Æ&#10;</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato'>OrderTracking/</run>
            <run>Æ&#10;</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#1d1c1d' fontname='Slack-Lato'>Any new user agent if added by the platform, will be automatically added to the dashboard until exclusively specified</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato'>.The data points rider_accepted_at, rider_picked_up_at, rider_near_customer_at from the </run>
            <run fontcolor='#000000' fontname='Slack-Lato'>orders table</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato'>.</run>
            <run>Æ&#10;</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#1d1c1d' fontname='Slack-Lato'>Before_rider_acceptance</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato'> - If the created_at from TAPI is before rider_accepted_at timestamp</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#1d1c1d' fontname='Slack-Lato'>Between_rider_acceptance_and_pickup</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato'> - If the created_at from TAPI is between rider_accepted_at and rider_picked_up_at timestamp</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#1d1c1d' fontname='Slack-Lato'>Between_pickup_and_rider_near_customer</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato'> - If the created_at from TAPI is between rider_picked_up_at and rider_near_customer_at</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#1d1c1d' fontname='Slack-Lato'>After_rider_near_customer</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato'> - If the created_at from TAPI is after rider_near_customer_at timestamp</run>
            <run>Æ&#10;</run>
            <run>Æ&#10;</run>
            <run fontcolor='#1d1c1d' fontname='Slack-Lato'>We exclude those requests from the dashboard for which the difference between the current and the next request is greater than or equal to 1 hour.</run>
          </formatted-text>
        </zone>
      </zones>
      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='75' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='98934' id='74' param='vert' type-v2='layout-flow' w='98400' x='800' y='533'>
                <zone forceUpdate='true' h='70400' id='3' type-v2='text' w='95700' x='1900' y='800'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontcolor='#aa5500' fontname='Slack-Lato' fontsize='15' underline='true'>Glossary</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1d1c1d' fontname='Slack-Lato'>For the purpose of this dashboard, we are excluding the below user agents</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1d1c1d' fontname='Slack-Lato'>‘%okhttp%’ -- excluding old DNS user agent</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1d1c1d' fontname='Slack-Lato'> ‘%otif%’ -- excluding new DNS user agent</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1d1c1d' fontname='Slack-Lato'> ‘%utocomp%’ -- excluding autocomp</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1d1c1d' fontname='Slack-Lato'> ‘%oneview%’ -- excluding Onveview service used by CS</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1d1c1d' fontname='Slack-Lato'> ‘%GST Helpcenter Conditions%’</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1d1c1d' fontname='Slack-Lato'> ‘%Go-http-client%’</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1d1c1d' fontname='Slack-Lato'> ‘%Ktor client%’</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1d1c1d' fontname='Slack-Lato'> ‘%Vert.x-WebClient%’</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1d1c1d' fontname='Slack-Lato'> ‘%gfs-order-processing%’</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1d1c1d' fontname='Slack-Lato'> ‘%PostmanRuntime%’</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1d1c1d' fontname='Slack-Lato'> ‘%Faraday%’</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1d1c1d' fontname='Slack-Lato'> ‘%peya-risk%’</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1d1c1d' fontname='Slack-Lato'> ‘%peya-delivery-record%’</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1d1c1d' fontname='Slack-Lato'> ‘%service-oneview-fulfillment-api%’</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1d1c1d' fontname='Slack-Lato'> ‘%logistics-customer-notifications%’</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1d1c1d' fontname='Slack-Lato'> ‘%peya-peya-order-tracking-puller%’</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1d1c1d' fontname='Slack-Lato'>Æ          </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1d1c1d' fontname='Slack-Lato'> And hence we have the following user agents being considered:</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1d1c1d' fontname='Slack-Lato'>Efood</run>
                    <run fontcolor='#1d1c1d' fontname='Slack-Lato'>Æ        </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1d1c1d' fontname='Slack-Lato'>efood-msnexus/</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1d1c1d' fontname='Slack-Lato'>foody-msnexus/</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1d1c1d' fontname='Slack-Lato'>Foodora inc Yemek </run>
                    <run fontcolor='#1d1c1d' fontname='Slack-Lato'>Æ       </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1d1c1d' fontname='Slack-Lato'>OTTS/</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1d1c1d' fontname='Slack-Lato'>pandora-OTTS/</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1d1c1d' fontname='Slack-Lato'>Foodpanda</run>
                    <run fontcolor='#1d1c1d' fontname='Slack-Lato'>Æ        </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1d1c1d' fontname='Slack-Lato'>pandora-OTAPI/</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1d1c1d' fontname='Slack-Lato'>pandora-OTTS/</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1d1c1d' fontname='Slack-Lato'>pandago-c2c-workers/</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1d1c1d' fontname='Slack-Lato'>OTTS/</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1d1c1d' fontname='Slack-Lato'>pandago-c2c-workers/</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1d1c1d' fontname='Slack-Lato'>pandago-c2c-api</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1d1c1d' fontname='Slack-Lato'>Glovo</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1d1c1d' fontname='Slack-Lato'>customer-order-flow/</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1d1c1d' fontname='Slack-Lato'>order-eta/</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1d1c1d' fontname='Slack-Lato'>laas-engine/</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1d1c1d' fontname='Slack-Lato'>geofence/</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1d1c1d' fontname='Slack-Lato'>store-estimations/</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1d1c1d' fontname='Slack-Lato'>Hungerstation</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1d1c1d' fontname='Slack-Lato'>hungerstation-rider-experience/</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1d1c1d' fontname='Slack-Lato'>hungerstation-tracking/</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1d1c1d' fontname='Slack-Lato'>Pedidosya</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1d1c1d' fontname='Slack-Lato'>peya-order-location-service/</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1d1c1d' fontname='Slack-Lato'>Talabat</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1d1c1d' fontname='Slack-Lato'>OrderTracking/</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1d1c1d' fontname='Slack-Lato'>Any new user agent if added by the platform, will be automatically added to the dashboard until exclusively specified</run>
                    <run fontcolor='#1d1c1d' fontname='Slack-Lato'>.The data points rider_accepted_at, rider_picked_up_at, rider_near_customer_at from the </run>
                    <run fontcolor='#000000' fontname='Slack-Lato'>orders table</run>
                    <run fontcolor='#1d1c1d' fontname='Slack-Lato'>.</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1d1c1d' fontname='Slack-Lato'>Before_rider_acceptance</run>
                    <run fontcolor='#1d1c1d' fontname='Slack-Lato'> - If the created_at from TAPI is before rider_accepted_at timestamp</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1d1c1d' fontname='Slack-Lato'>Between_rider_acceptance_and_pickup</run>
                    <run fontcolor='#1d1c1d' fontname='Slack-Lato'> - If the created_at from TAPI is between rider_accepted_at and rider_picked_up_at timestamp</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1d1c1d' fontname='Slack-Lato'>Between_pickup_and_rider_near_customer</run>
                    <run fontcolor='#1d1c1d' fontname='Slack-Lato'> - If the created_at from TAPI is between rider_picked_up_at and rider_near_customer_at</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1d1c1d' fontname='Slack-Lato'>After_rider_near_customer</run>
                    <run fontcolor='#1d1c1d' fontname='Slack-Lato'> - If the created_at from TAPI is after rider_near_customer_at timestamp</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1d1c1d' fontname='Slack-Lato'>We exclude those requests from the dashboard for which the difference between the current and the next request is greater than or equal to 1 hour.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
