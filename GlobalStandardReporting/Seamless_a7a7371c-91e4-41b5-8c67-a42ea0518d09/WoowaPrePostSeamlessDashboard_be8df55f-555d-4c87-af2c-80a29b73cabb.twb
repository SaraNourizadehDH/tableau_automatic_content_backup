      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1duz98i0u3wl6a1706ksn1sojdwo].[sum:total_completed_orders:qk]&quot;' value='Total Completed Orders' />
