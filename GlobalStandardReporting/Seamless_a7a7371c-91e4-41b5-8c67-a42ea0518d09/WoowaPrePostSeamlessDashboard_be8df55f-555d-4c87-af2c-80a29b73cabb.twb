          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Weekly' caption='Choose Time Dimension' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
              <calculation class='tableau' formula='&quot;week&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1duz98i0u3wl6a1706ksn1sojdwo'>
            <column caption='% Late Orders [+/-20 mins] ' datatype='real' name='[% Late Orders [+/-10 mins]] (copy)_6981705369689100312]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([late_orders_20_mins])*100/sum([total_completed_orders_no_preorder])' />
            </column>
            <column caption='% Orders DT&lt; PDT Max+10 min' datatype='real' name='[% Orders DT&lt; PDT Max (copy)_6981705369614831636]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([dt_less_than_pdt_max_plus10_woowa_n])*100/sum([total_completed_orders_no_preorder])' />
            </column>
            <column caption='Time Dimension' datatype='string' name='[Calculation_6981705369281093632]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;[Parameters].[Parameter 1] = &quot;day&quot; THEN&#13;&#10;STR(DATENAME(&quot;year&quot;, [local_created_date])) + &quot;-&quot; +&#13;&#10;RIGHT(&quot;00&quot; + STR(DATEPART(&quot;month&quot;, [local_created_date])), 2) + &quot;-&quot; +&#13;&#10;RIGHT(&quot;00&quot; + STR(DATEPART(&quot;day&quot;, [local_created_date])), 2)&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;week&quot; AND [week_num] = 52 AND DATEPART(&quot;month&quot;, [local_created_date]) = 1 THEN &#13;&#10;STR(DATEPART(&quot;year&quot;, [local_created_date])-1) + &quot; W&quot; + STR([week_num])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;week&quot; AND [week_num] = 1 AND DATEPART(&quot;month&quot;, [local_created_date]) = 12 THEN &#13;&#10;STR(DATEPART(&quot;year&quot;, [local_created_date])+1) + &quot; W&quot; + STR([week_num])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;week&quot; THEN &#13;&#10;STR(DATEPART(&quot;year&quot;, [local_created_date])) + &quot; W&quot; + STR([week_num])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;month&quot; then &#13;&#10;STR(DATEPART(&quot;year&quot;, [local_created_date])) + &quot;-&quot; + STR(DATEPART(&quot;month&quot;, [local_created_date]))&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;quarter&quot; then&#13;&#10;STR(DATEPART(&quot;year&quot;, [local_created_date])) + &quot; Q&quot; + STR(DATEPART(&quot;quarter&quot;, [local_created_date]))&#13;&#10;END' />
            </column>
            <column caption='% Orders On Time [+/-10 mins]' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6981705369298403332]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ontime_orders])*100/sum([total_completed_orders_no_preorder])' />
            </column>
            <column caption='% Late Orders [+/-10 mins]' datatype='real' name='[Calculation_6981705369299369989]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([late_orders_10_mins])*100/sum([total_completed_orders_no_preorder])' />
            </column>
            <column caption='% Early Orders [+/-10 mins]' datatype='real' name='[Calculation_6981705369299730438]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([early_orders_10_mins])*100/sum([total_completed_orders_no_preorder])' />
            </column>
            <column caption='PDT min/max Compliance rate (DT near DO)' datatype='real' name='[Calculation_6981705369318195207]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([dt_within_pdt_range_DH_num])*100/sum([total_completed_orders_no_preorder])' />
            </column>
            <column caption='% Weighted On Time' datatype='real' name='[Calculation_6981705369342939152]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100 * (&#13;&#10;    IF SUM([total_completed_orders_no_preorder_10]) = 0 THEN 0&#13;&#10;    ELSE SUM([ontime_orders_10]) * 0.07 / SUM([total_completed_orders_no_preorder_10]) END +&#13;&#10;&#13;&#10;    IF SUM([total_completed_orders_no_preorder_20]) = 0 THEN 0&#13;&#10;    ELSE SUM([ontime_orders_20]) * 0.35 / SUM([total_completed_orders_no_preorder_20]) END +&#13;&#10;&#13;&#10;    IF SUM([total_completed_orders_no_preorder_30]) = 0 THEN 0&#13;&#10;    ELSE SUM([ontime_orders_30]) * 0.35 / SUM([total_completed_orders_no_preorder_30]) END +&#13;&#10;&#13;&#10;    IF SUM([total_completed_orders_no_preorder_40]) = 0 THEN 0&#13;&#10;    ELSE SUM([ontime_orders_40]) * 0.16 / SUM([total_completed_orders_no_preorder_40]) END +&#13;&#10;&#13;&#10;    IF SUM([total_completed_orders_no_preorder_50]) = 0 THEN 0&#13;&#10;    ELSE SUM([ontime_orders_50]) * 0.05 / SUM([total_completed_orders_no_preorder_50]) END +&#13;&#10;&#13;&#10;    IF SUM([total_completed_orders_no_preorder_60]) = 0 THEN 0&#13;&#10;    ELSE SUM([ontime_orders_60]) * 0.02 / SUM([total_completed_orders_no_preorder_60]) END&#13;&#10;)' />
            </column>
            <column caption='dt &gt; 60 min' datatype='real' name='[Calculation_6981705369611661329]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([dt_60])*100/sum([total_completed_orders_no_preorder])' />
            </column>
            <column caption='Avg AWT' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6981705369615171605]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([awt_n])/sum([awt_d])' />
            </column>
            <column caption='Avg Delivery Time' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_6981705369615687702]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dt_n])/sum([dt_d])' />
            </column>
            <column caption='Avg Estimate Prep Time' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_6981705369616023575]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([ept_n])/sum([ept_d])' />
            </column>
            <column caption='% Orders DT&lt; PDT Max' datatype='real' name='[PDT min/max Compliance rate (DT Dropped Off) (copy)_6981705369613914131]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([dt_less_than_pdt_max_woowa_n])*100/sum([total_completed_orders_no_preorder])' />
            </column>
            <column caption='PDT min/max Compliance rate (DT Dropped Off)' datatype='real' name='[PDT min/max Compliance rate (DT near DO) (copy)_6981705369319002120]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([dt_within_pdt_range_woowa_n])*100/sum([total_completed_orders_no_preorder])' />
            </column>
