      <aliases enabled='yes' />
      <column caption='% HC Session Rate' datatype='real' name='[% Contact Rate (copy)_884816643076374534]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [HC_session_rate] = True then [order_cnt] end)*100/sum([order_cnt])' />
      </column>
      <column caption='% Fail Rate' datatype='real' name='[% HC Session Rate (copy)_884816643076431879]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [fail_Rate] = True then [order_cnt] end)*100/sum([order_cnt])' />
      </column>
      <column caption='% Orders with Teleportation &gt; 5 mins' datatype='real' name='[% Orders with Teleportation &gt; 2 mins (copy 2)_884816643069353987]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [rider_teleportation_5mins] = True then [order_cnt] end)*100/sum([order_cnt])' />
      </column>
      <column caption='% Orders with Teleportation &gt; 10 mins' datatype='real' name='[% Orders with Teleportation &gt; 2 mins (copy 3)_884816643069362180]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [rider_teleportation_10mins] = True then [order_cnt] end)*100/sum([order_cnt])' />
      </column>
      <column caption='% Orders with Teleportation &gt; 15 mins' datatype='real' name='[% Orders with Teleportation &gt; 2 mins (copy)_884816643069345794]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [rider_teleportation_15mins] = True then [order_cnt] end)*100/sum([order_cnt])' />
      </column>
      <column caption='# Daily Orders with Bad CX' datatype='real' name='[Calculation_5879730846580592640]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &quot;Contact Rate&quot; then round(sum(if [CCR] = True then [order_cnt] end)/7,0)&#10;when &quot;HC Session Rate&quot; then round(sum(if [HC_session_rate] = True then [order_cnt] end)/7,0)&#10;else round(sum(if [fail_Rate] = True then [order_cnt] end)/7,0) end' />
      </column>
      <column caption='# Daily Orders' datatype='real' name='[Calculation_884816643068162048]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(sum([order_cnt])/7,0)' />
      </column>
      <column caption='% Orders with Teleportation &gt; 2 mins' datatype='real' name='[Calculation_884816643068379137]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [rider_teleportation_2mins] = True then [order_cnt] end)*100/sum([order_cnt])' />
      </column>
      <column caption='% Contact Rate' datatype='real' name='[Calculation_884816643076263941]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [CCR] = True then [order_cnt] end)*100/sum([order_cnt])' />
      </column>
      <column caption='CX Metric' datatype='real' name='[Calculation_884816643110457353]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &quot;Contact Rate&quot; then [Calculation_884816643076263941]&#10;when &quot;HC Session Rate&quot; then [% Contact Rate (copy)_884816643076374534]&#10;else [% HC Session Rate (copy)_884816643076431879] end' />
      </column>
      <column caption='Dimension 1' datatype='string' name='[Calculation_884816644479881228]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 2]&#10;when &quot;Ontime Tag&quot; then STR([ontime_tag])&#10;when &quot;DT&quot; then STR([adt])&#10;when &quot;Stack Tag&quot; then STR([stack_tag])&#10;when &quot;Vertical Type&quot; then STR([vertical_type])&#10;when &quot;Order Status&quot; then STR([order_status])&#10;when &quot;On Time Tag&quot; then STR([ontime_tag])&#10;end' />
      </column>
      <column caption='Rider Teleportation Threshold' datatype='boolean' name='[Calculation_884816644481949713]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 3]&#10;when &quot;&gt; 2 mins&quot; then [rider_teleportation_2mins]&#10;when &quot;&gt; 5 mins&quot; then [rider_teleportation_5mins]&#10;when &quot;&gt; 10 mins&quot; then [rider_teleportation_10mins]&#10;when &quot;&gt; 15 mins&quot; then [rider_teleportation_15mins]&#10;end' />
