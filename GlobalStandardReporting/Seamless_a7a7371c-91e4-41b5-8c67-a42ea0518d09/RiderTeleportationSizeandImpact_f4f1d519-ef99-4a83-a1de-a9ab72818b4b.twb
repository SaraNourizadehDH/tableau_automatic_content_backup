          <datasources>
            <datasource caption='rider_teleportation_impact_on_cx_tableau (rl)' name='federated.02npcn11jcwyt51d6jey91ja5ef7' />
          </datasources>
          <datasource-dependencies datasource='federated.02npcn11jcwyt51d6jey91ja5ef7'>
            <column caption='% Orders with Teleportation &gt; 5 mins' datatype='real' name='[% Orders with Teleportation &gt; 2 mins (copy 2)_884816643069353987]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [rider_teleportation_5mins] = True then [order_cnt] end)*100/sum([order_cnt])' />
            </column>
            <column caption='% Orders with Teleportation &gt; 10 mins' datatype='real' name='[% Orders with Teleportation &gt; 2 mins (copy 3)_884816643069362180]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [rider_teleportation_10mins] = True then [order_cnt] end)*100/sum([order_cnt])' />
            </column>
            <column caption='% Orders with Teleportation &gt; 15 mins' datatype='real' name='[% Orders with Teleportation &gt; 2 mins (copy)_884816643069345794]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [rider_teleportation_15mins] = True then [order_cnt] end)*100/sum([order_cnt])' />
            </column>
            <column caption='# Daily Orders' datatype='real' name='[Calculation_884816643068162048]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(sum([order_cnt])/7,0)' />
            </column>
            <column caption='% Orders with Teleportation &gt; 2 mins' datatype='real' name='[Calculation_884816643068379137]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [rider_teleportation_2mins] = True then [order_cnt] end)*100/sum([order_cnt])' />
