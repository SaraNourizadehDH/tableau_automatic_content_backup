    <worksheet name='Score - Country'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Tableau Bold' fontsize='14'>By Country</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='fulfilment_ops_ls_sftp_dashboard_main_view (dev_dmart)' name='federated.15w313a16lxy7n1dyvkx90hmistu' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Yes' caption='Do you want to see the actual (last) period' datatype='boolean' name='[How many periods do you want to see (copy)]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
              <aliases>
                <alias key='false' value='No' />
                <alias key='true' value='Yes' />
              </aliases>
            </column>
            <column caption='Vendor IDs Filter' datatype='string' name='[Parameter 1]' param-domain-type='any' role='measure' type='nominal' value='&quot;&quot;'>
              <calculation class='tableau' formula='&quot;&quot;' />
            </column>
            <column alias='In' caption='In / Out' datatype='boolean' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
              <aliases>
                <alias key='false' value='Out' />
                <alias key='true' value='In' />
              </aliases>
            </column>
            <column caption='Cards Period 1' datatype='integer' name='[Parameter 5]' param-domain-type='any' role='measure' type='quantitative' value='2'>
              <calculation class='tableau' formula='2' />
            </column>
            <column alias='$ GMV' caption='Metrics Cards' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;1&quot;'>
              <calculation class='tableau' formula='&quot;1&quot;' />
              <aliases>
                <alias key='&quot;1&quot;' value='$ GMV' />
                <alias key='&quot;2&quot;' value='# SFTP Stocks Jobs' />
                <alias key='&quot;3&quot;' value='Every how many days vendor update stock' />
                <alias key='&quot;4&quot;' value='Average Updates per Day' />
                <alias key='&quot;5&quot;' value='% Not Found / Not Delivered' />
                <alias key='&quot;6&quot;' value='% OOS Failed Orders' />
                <alias key='&quot;7&quot;' value='% Ratio SFTP Updates vs Vendors Assortment' />
                <alias key='&quot;8&quot;' value='% SFTP Vendors' />
              </aliases>
            </column>
            <column caption='How many periods do you want to see' datatype='integer' name='[Replaced Pelican Items Parameter]' param-domain-type='any' role='measure' type='quantitative' value='7'>
              <calculation class='tableau' formula='7' />
            </column>
            <column caption='Chain IDs Filter' datatype='string' name='[Vendors List to Filter (copy)_3194529905697562660]' param-domain-type='any' role='measure' type='nominal' value='&quot;&quot;'>
              <calculation class='tableau' formula='&quot;&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.15w313a16lxy7n1dyvkx90hmistu'>
            <column caption='% OOS Failed Orders' datatype='real' default-format='p0.00%' name='[% Partial Fulfilled Items (copy)_1860831095852757033]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([oos_failed_pelican_orders]) / SUM([total_orders])' />
            </column>
            <column caption='% SFTP Vendors' datatype='real' default-format='p0.0%' name='[% SFTP Vendors (card) (copy)_161707402988531715]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;IF [gmv_net_eur] &gt; 0 AND [has_sftp_jobs] THEN&#10;    [vendor_id]&#10;    ELSE NULL&#10;END&#10;) / &#10;COUNTD(&#10;IF [gmv_net_eur] &gt; 0 THEN&#10;    [vendor_id]&#10;    ELSE NULL&#10;END&#10;)' />
            </column>
            <column caption='Every how many days Vendors update their stock' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;IF [gmv_net_eur] &gt; 0 AND [every_how_many_days_vendors_update_their_stock] &gt; 0 THEN&#10;    [every_how_many_days_vendors_update_their_stock] * [gmv_net_eur]&#10;    ELSE NULL&#10;END&#10;) / &#10;SUM(&#10;IF [gmv_net_eur] &gt; 0 AND [every_how_many_days_vendors_update_their_stock] &gt; 0 THEN&#10;   [gmv_net_eur]&#10;    ELSE NULL&#10;END&#10;)' />
            </column>
            <column caption='Metrics Cards' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1278529740269060131]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;    WHEN &apos;1&apos; THEN ROUND(SUM([gmv_net_eur]) / 1000, 2)&#10;    WHEN &apos;2&apos; THEN ROUND(SUM([nr_jobs_updated_product_completed]) / 1000, 2)&#10;    WHEN &apos;3&apos; THEN [Calculation1]&#10;    WHEN &apos;4&apos; THEN [Calculation_1860831095256268831]&#10;    WHEN &apos;5&apos; THEN [Calculation_1860831095894679597] * 100&#10;    WHEN &apos;6&apos; THEN [% Partial Fulfilled Items (copy)_1860831095852757033] * 100&#10;    WHEN &apos;7&apos; THEN [Calculation_1860831095615938598] * 100&#10;    WHEN &apos;8&apos; THEN [% SFTP Vendors (card) (copy)_161707402988531715] * 100&#10;END' />
            </column>
            <column caption='Selected Period' datatype='boolean' name='[Calculation_1278529740277645362]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = MAX([period_num]) THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='ATTR([Period Num]) + 1' datatype='integer' name='[Calculation_1278529740278988852]' role='measure' type='quantitative' user:unnamed='Score - Date'>
              <calculation class='tableau' formula='ATTR([period_num]) + 1' />
            </column>
            <column caption='Filter Outliers' datatype='boolean' name='[Calculation_1278529741041209407]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = &apos;8&apos; THEN TRUE ELSE&#10;&#10;    CASE [granularity]&#10;        &#10;        WHEN &apos;weekly&apos; THEN&#10;&#10;            IF [confirmed_orders] &gt; 1 THEN&#10;                IF [nr_jobs_updated_product_completed] &lt;= 3  THEN&#10;                    IF [gmv_net_eur] / [nr_jobs_updated_product_completed] &lt; 100 THEN TRUE ELSE FALSE END&#10;                ELSE TRUE END&#10;            ELSE TRUE END&#10;&#10;        WHEN &apos;monthly&apos; THEN&#10;&#10;            IF [confirmed_orders] &gt; 1 THEN&#10;                IF [nr_jobs_updated_product_completed] &lt;= 15  THEN&#10;                    IF [gmv_net_eur] / [nr_jobs_updated_product_completed] &lt; 700 THEN TRUE ELSE FALSE END&#10;                ELSE TRUE END&#10;            ELSE TRUE END&#10;&#10;        WHEN &apos;quarterly&apos; THEN&#10;&#10;            IF [confirmed_orders] &gt; 1 THEN&#10;                IF [nr_jobs_updated_product_completed] &lt;= 30  THEN&#10;                    IF [gmv_net_eur] / [nr_jobs_updated_product_completed] &lt; 1400 THEN TRUE ELSE FALSE END&#10;                ELSE TRUE END&#10;            ELSE TRUE END&#10;&#10;    END&#10;END' />
            </column>
            <column caption='Local Date ' datatype='string' name='[Calculation_1860831094529859592]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [granularity]&#10;    WHEN &apos;weekly&apos; THEN STR(DATE(DATETRUNC(&apos;week&apos;,[local_date], &apos;monday&apos;)))&#10;    WHEN &apos;monthly&apos; THEN STR(DATE(DATETRUNC(&apos;month&apos;,[local_date])))&#10;    WHEN &apos;quarterly&apos; THEN STR(DATE(DATETRUNC(&apos;quarter&apos;,[local_date])))&#10;END' />
            </column>
            <column caption='Period Filter' datatype='boolean' name='[Calculation_1860831095232335902]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [period_num] &lt;= [Parameters].[Replaced Pelican Items Parameter] + 1 &#10;THEN &#10;    IF [Parameters].[How many periods do you want to see (copy)] &#10;    THEN &#10;        IF [period_num] &lt;= [Parameters].[Replaced Pelican Items Parameter] &#10;        THEN TRUE &#10;        ELSE FALSE &#10;        END &#10;    ELSE &#10;        IF [period_num] &gt; 1 &#10;        THEN TRUE &#10;        ELSE FALSE &#10;        END&#10;    END &#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='Avg. num. of Updates per Day' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1860831095256268831]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;IF [gmv_net_eur] &gt; 0 AND [avg_number_of_updates_per_day] &gt; 0 THEN&#10;    [avg_number_of_updates_per_day] * [gmv_net_eur]&#10;    ELSE NULL&#10;END&#10;) / &#10;SUM(&#10;IF [gmv_net_eur] &gt; 0 AND [avg_number_of_updates_per_day] &gt; 0 THEN&#10;   [gmv_net_eur]&#10;    ELSE NULL&#10;END&#10;)' />
            </column>
            <column caption='Ratio # updates items vs total assortment' datatype='real' default-format='p0.0%' name='[Calculation_1860831095615938598]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_items_vs_total_assortment] &gt; 0 THEN&#10;    [ratio_num_updates_items_vs_total_assortment] * [gmv_net_eur]&#10;    ELSE NULL&#10;END&#10;) / &#10;SUM(&#10;IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_items_vs_total_assortment] &gt; 0 THEN&#10;   [gmv_net_eur]&#10;    ELSE NULL&#10;END&#10;)' />
            </column>
            <column caption='% Not Found Rate / Items Not Delivered' datatype='real' default-format='p0.00%' name='[Calculation_1860831095894679597]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([confirmed_orders_pelican]) &gt; 0 THEN&#10;SUM(&#10;    ([in_cart_pelican_items] - [in_cart_pelican_items_sold])     &#10;    + [not_found_pelican_items] &#10;    + ([replaced_pelican_items] - [replaced_pelican_items_sold] - [replacements_pelican_items])&#10;    + [oos_failed_pelican_items]&#10;) / &#10;SUM(&#10;    [in_cart_pelican_items]&#10;    + [not_found_pelican_items] &#10;    + [not_processed_pelican_items] &#10;    + [replaced_pelican_items]&#10;    + [replacements_pelican_items]&#10;    + [oos_failed_pelican_items]&#10;)&#10;ELSE NULL END' />
            </column>
            <column caption='Has Complete Jobs to Update Stock' datatype='boolean' name='[Calculation_3194529905047035928]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = &apos;8&apos; THEN TRUE &#10;ELSEIF [nr_jobs_updated_product_completed] &gt;= 1 THEN TRUE &#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='SFTP Type' datatype='string' name='[Calculation_3194529905058963481]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [sftp_type_is_central] THEN &apos;Central SFTP&apos; ELSEIF [sftp_type_is_legacy] THEN &apos;Legacy SFTP&apos; ELSE &apos;Non SFTP&apos; END' />
            </column>
            <column caption='Vendors List to Filter Calc' datatype='boolean' name='[Calculation_3194529905693958179]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] THEN&#10;    IF [Parameters].[Parameter 1] != &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Parameter 1], [vendor_id]) THEN TRUE ELSE FALSE END&#10;        ELSE TRUE&#10;    END&#10;ELSE&#10;    IF [Parameters].[Parameter 1] != &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Parameter 1], [vendor_id]) THEN FALSE ELSE TRUE END&#10;        ELSE TRUE&#10;    END&#10;END' />
            </column>
            <column caption='Metrics Cards (Symbol)' datatype='string' default-format='n#,##0.00;-#,##0.00' name='[Metrics Cards (copy)_1278529740283846711]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;    WHEN &apos;1&apos; THEN &quot;k&quot;&#10;    WHEN &apos;2&apos; THEN &quot;k&quot;&#10;    WHEN &apos;3&apos; THEN &quot;&quot;&#10;    WHEN &apos;4&apos; THEN &quot;&quot;&#10;    WHEN &apos;5&apos; THEN &quot;%&quot;&#10;    WHEN &apos;6&apos; THEN &quot;%&quot;&#10;    WHEN &apos;7&apos; THEN &quot;%&quot;&#10;    WHEN &apos;8&apos; THEN &quot;%&quot;&#10;END' />
            </column>
            <column caption='Chain List to Filter Calc' datatype='boolean' name='[Vendors List to Filter Calc (copy)_3194529905697677349]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] THEN&#10;    IF [Parameters].[Vendors List to Filter (copy)_3194529905697562660] != &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Vendors List to Filter (copy)_3194529905697562660], [chain_id]) THEN TRUE ELSE FALSE END&#10;        ELSE TRUE&#10;    END&#10;ELSE&#10;    IF [Parameters].[Vendors List to Filter (copy)_3194529905697562660] != &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Vendors List to Filter (copy)_3194529905697562660], [chain_id]) THEN FALSE ELSE TRUE END&#10;        ELSE TRUE&#10;    END&#10;END' />
            </column>
            <column-instance column='[period_num]' derivation='Attribute' name='[attr:period_num:qk]' pivot='key' type='quantitative' />
            <column caption='Avg. num. of Updates per Day _' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[avg_number_of_updates_per_day]' role='measure' type='quantitative' />
            <column caption='Chain Id' datatype='string' name='[chain_id]' role='dimension' type='nominal' />
