    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='SFTP Jobs Overview'>
      <repository-location id='SFTPJobsOverview' path='/t/GlobalStandardReporting/workbooks/SFTPDashboardv2indevelopment' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='parameter-ctrl-title'>
          <format attr='text-align' value='center' />
        </style-rule>
      </style>
      <size maxheight='2000' maxwidth='1360' minheight='2000' minwidth='1360' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='fulfilment_ops_ls_sftp_dashboard_main_view (dev_dmart)' name='federated.15w313a16lxy7n1dyvkx90hmistu' />
