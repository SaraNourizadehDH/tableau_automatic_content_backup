            <column-instance column='[vendor_name]' derivation='None' name='[none:vendor_name:nk]' pivot='key' type='nominal' />
            <column caption='Not Found Pelican Items' datatype='real' name='[not_found_pelican_items]' role='measure' type='quantitative' />
            <column caption='Not Processed Pelican Items' datatype='real' name='[not_processed_pelican_items]' role='measure' type='quantitative' />
            <column caption='Nr Updated Stock Count Products Completed' datatype='integer' default-format='n#,##0;-#,##0' name='[nr_changed_products_completed]' role='measure' type='quantitative' />
            <column caption='Nr Failed Count Products Completed' datatype='integer' default-format='n#,##0;-#,##0' name='[nr_failed_count_completed]' role='measure' type='quantitative' />
            <column caption='Nr Jobs' datatype='integer' default-format='n#,##0;-#,##0' name='[nr_jobs]' role='measure' type='quantitative' />
            <column caption='Nr Jobs Failed' datatype='integer' default-format='n#,##0;-#,##0' name='[nr_jobs_failed]' role='measure' type='quantitative' />
            <column caption='Nr Jobs Updated Product Completed' datatype='integer' default-format='n#,##0;-#,##0' name='[nr_jobs_updated_product_completed]' role='measure' type='quantitative' />
            <column caption='Nr Processed Products Completed' datatype='integer' default-format='n#,##0;-#,##0' name='[nr_processed_products_completed]' role='measure' type='quantitative' />
            <column caption='OOS Failed Items' datatype='real' name='[oos_failed_pelican_items]' role='measure' type='quantitative' />
            <column caption='OOS Failed Orders' datatype='integer' name='[oos_failed_pelican_orders]' role='measure' type='quantitative' />
            <column caption='Period Num' datatype='integer' datatype-customized='true' name='[period_num]' role='dimension' type='ordinal' />
            <column caption='Ratio # updates items vs total assortment _' datatype='real' default-format='p0.0%' name='[ratio_num_updates_items_vs_total_assortment]' role='measure' type='quantitative' />
