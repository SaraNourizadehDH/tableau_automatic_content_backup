          <button action='' active-visual-state-index='1'>
            <toggle-action>tabdoc:toggle-button-click-action window-id=&quot;{8DE65D2D-D05D-46CA-9431-D542D9913103}&quot; zone-id=&quot;590&quot; zone-ids=[589]</toggle-action>
