            <button action='tabdoc:goto-sheet window-id=&quot;{D56B660F-F8CB-419D-B9F9-34AFE245AC91}&quot;' button-type='text'>
              <button-visual-state>
                <caption>.                                                    .</caption>
                <button-caption-font-style fontcolor='#ffffff' fontname='Tableau Bold' fontsize='12' />
              </button-visual-state>
            </button>
            <zone-style>
              <format attr='border-color' value='#666666' />
