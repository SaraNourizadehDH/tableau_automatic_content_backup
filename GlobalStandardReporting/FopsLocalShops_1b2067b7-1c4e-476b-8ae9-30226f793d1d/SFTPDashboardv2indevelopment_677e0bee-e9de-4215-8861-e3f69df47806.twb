            <column caption='Vendors List to Filter Calc' datatype='boolean' name='[Calculation_3194529905693958179]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] THEN&#10;    IF [Parameters].[Parameter 1] != &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Parameter 1], [vendor_id]) THEN TRUE ELSE FALSE END&#10;        ELSE TRUE&#10;    END&#10;ELSE&#10;    IF [Parameters].[Parameter 1] != &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Parameter 1], [vendor_id]) THEN FALSE ELSE TRUE END&#10;        ELSE TRUE&#10;    END&#10;END' />
            </column>
            <column caption='Avg. num. of Updates per Day - Diff (card)' datatype='real' default-format='p0.0%' name='[Every how many days  - Diff (card) (copy)_1278529740256890904]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(&#10;    (&#10;        SUM(&#10;            IF [gmv_net_eur] &gt; 0 AND [avg_number_of_updates_per_day] &gt; 0 AND [period_num] = [Parameters].[Parameter 5] THEN&#10;                [avg_number_of_updates_per_day] * [gmv_net_eur]&#10;                ELSE NULL&#10;            END&#10;        ) / &#10;        SUM(&#10;            IF [gmv_net_eur] &gt; 0 AND [avg_number_of_updates_per_day] &gt; 0 AND [period_num] = [Parameters].[Parameter 5] THEN&#10;               [gmv_net_eur]&#10;                ELSE NULL&#10;            END&#10;        )&#10;    ) / &#10;    (&#10;        SUM(&#10;        IF [gmv_net_eur] &gt; 0 AND [avg_number_of_updates_per_day] &gt; 0 AND [period_num] = [Parameters].[Cards Period 1 (copy)_1278529740053532683] THEN&#10;            [avg_number_of_updates_per_day] * [gmv_net_eur]&#10;            ELSE NULL&#10;        END&#10;    ) / &#10;        SUM(&#10;        IF [gmv_net_eur] &gt; 0 AND [avg_number_of_updates_per_day] &gt; 0 AND [period_num] = [Parameters].[Cards Period 1 (copy)_1278529740053532683] THEN&#10;           [gmv_net_eur]&#10;            ELSE NULL&#10;        END&#10;        )&#10;    )&#10;-1 )' />
            </column>
            <column caption='Avg. num. of Updates per Day (card)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Every how many days (card) (copy)_1278529740256890903]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;IF [gmv_net_eur] &gt; 0 AND [avg_number_of_updates_per_day] &gt; 0 AND [period_num] = [Parameters].[Parameter 5] THEN&#10;    [avg_number_of_updates_per_day] * [gmv_net_eur]&#10;    ELSE NULL&#10;END&#10;) / &#10;SUM(&#10;IF [gmv_net_eur] &gt; 0 AND [avg_number_of_updates_per_day] &gt; 0 AND [period_num] = [Parameters].[Parameter 5] THEN&#10;   [gmv_net_eur]&#10;    ELSE NULL&#10;END&#10;)' />
