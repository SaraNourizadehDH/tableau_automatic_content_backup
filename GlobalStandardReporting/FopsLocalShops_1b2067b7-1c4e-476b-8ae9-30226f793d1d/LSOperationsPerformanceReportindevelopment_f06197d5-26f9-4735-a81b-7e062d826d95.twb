        <calculation class='tableau' formula='IF [Parameters].[Num of Periods (copy)] = &apos;Eur&apos; THEN IF [is_sent] THEN [gbv_net_eur] ELSE 0 END&#10;ELSE IF [is_sent] THEN [gbv_net_lc] ELSE 0 END&#10;END' />
      </column>
      <column caption='$ GMV Replaced' datatype='real' default-format='n#,##0;-#,##0' name='[$ GMV Loss due to Items Not Delivered (op) (copy)_1993194687401095170]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Num of Periods (copy)] = &apos;Eur&apos; THEN (&#10;        SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [replacements_pelican_total_price_eur] ELSE 0 END) &#10;) ELSE (&#10;        SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [replacements_pelican_total_price_lc] ELSE 0 END) &#10;) END' />
      </column>
      <column caption='% GMV Loss due to Items Not Delivered' datatype='real' default-format='p0.00%' name='[$ GMV Loss due to Items Not Delivered (op) (copy)_6549781977349857336]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Num of Periods (copy)] = &apos;Eur&apos; THEN (&#10;    (&#10;        (&#10;            SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [in_cart_pelican_total_price_eur] ELSE 0 END) &#10;            - SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [in_cart_pelican_total_price_eur_sold] ELSE 0 END)&#10;        )&#10;        + SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [not_found_pelican_total_price_eur] ELSE 0 END)&#10;        + (&#10;            SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [replaced_pelican_total_price_eur] ELSE 0 END) &#10;            - SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [replaced_pelican_total_price_eur_sold] ELSE 0 END) &#10;            - SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [replacements_pelican_total_price_eur] ELSE 0 END) &#10;        )&#10;        + SUM(IF [is_failed_due_to_out_of_stock] AND [vendor_app] = &apos;pelican&apos; = TRUE THEN [gmv_net_eur] ELSE 0 END)&#10;    ) /&#10;    (&#10;        SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [in_cart_pelican_total_price_eur] ELSE 0 END) &#10;        + SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [not_found_pelican_total_price_eur] ELSE 0 END)&#10;        + SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [not_processed_pelican_total_price_eur] ELSE 0 END)&#10;        + SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [replaced_pelican_total_price_eur] ELSE 0 END) &#10;        + SUM(IF [is_failed_due_to_out_of_stock] AND [vendor_app] = &apos;pelican&apos; = TRUE THEN [gmv_net_eur] ELSE 0 END)&#10;    )&#10;&#10;) ELSE (&#10;    (&#10;        (&#10;            SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [in_cart_pelican_total_price_lc] ELSE 0 END) &#10;            - SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [in_cart_pelican_total_price_lc_sold] ELSE 0 END)&#10;        )&#10;        + SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [not_found_pelican_total_price_lc] ELSE 0 END)&#10;        + (&#10;            SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [replaced_pelican_total_price_lc] ELSE 0 END) &#10;            - SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [replaced_pelican_total_price_lc_sold] ELSE 0 END) &#10;            - SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [replacements_pelican_total_price_lc] ELSE 0 END) &#10;        )&#10;        + SUM(IF [is_failed_due_to_out_of_stock] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [gmv_net_lc] ELSE 0 END)&#10;    ) /&#10;    (&#10;        SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [in_cart_pelican_total_price_lc] ELSE 0 END) &#10;        + SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [not_found_pelican_total_price_lc] ELSE 0 END)&#10;        + SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [not_processed_pelican_total_price_lc] ELSE 0 END)&#10;        + SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [replaced_pelican_total_price_lc] ELSE 0 END) &#10;        + SUM(IF [is_failed_due_to_out_of_stock] AND [vendor_app] = &apos;pelican&apos; = TRUE THEN [gmv_net_lc] ELSE 0 END)&#10;    )&#10;) END' />
      </column>
      <column caption='$ GMV Gross' datatype='real' default-format='n#,##0,,.00M;-#,##0,,.00M' name='[$ GMV Net (copy)_6549781977007771700]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Num of Periods (copy)] = &apos;Eur&apos; THEN IF [is_sent] THEN [gmv_gross_eur] ELSE 0 END&#10;ELSE IF [is_sent] THEN [gmv_gross_lc] ELSE 0 END&#10;END' />
      </column>
      <column caption='     $ GBV Net' datatype='real' default-format='c#,##0,,.00M;(#,##0,,.00M)' name='[$ GMV Net (copy)_6549781978420678748]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Num of Periods (copy)] = &apos;Eur&apos; THEN IF [is_sent] THEN [gbv_net_eur] ELSE 0 END&#10;ELSE IF [is_sent] THEN [gbv_net_lc] ELSE 0 END&#10;END' />
