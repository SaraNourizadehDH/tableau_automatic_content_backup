        <calculation class='tableau' formula='(&#10;    SUM(IF [is_sent] = TRUE THEN [in_cart_pelican_items] ELSE 0 END)&#10;    + SUM(IF [is_sent] = TRUE THEN [not_found_pelican_items] ELSE 0 END)&#10;    + SUM(IF [is_sent] = TRUE THEN [not_processed_pelican_items] ELSE 0 END)&#10;    + SUM(IF [is_sent] = TRUE THEN [replaced_pelican_items] ELSE 0 END)&#10;    + SUM(IF [is_failed_due_to_out_of_stock] = TRUE THEN [qty_ordered] ELSE 0 END)&#10;)' />
