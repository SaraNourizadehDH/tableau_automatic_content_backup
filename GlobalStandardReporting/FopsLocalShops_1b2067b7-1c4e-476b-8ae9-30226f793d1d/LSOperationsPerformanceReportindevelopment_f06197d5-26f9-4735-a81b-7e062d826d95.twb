              <calculation class='tableau' formula='SUM([$ GMV Gross (copy)_6549781978389921875] + [$ Discounts (copy)_6549781978390024276])&#10;/ SUM([$ GMV Net (copy)_6549781977007771700])' />
            </column>
            <column caption='# Confirmed Orders (op)' datatype='integer' default-format='n#,##0;-#,##0' name='[# Confirmed Orders (copy)_5316077153433296913]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [vendor_app] = &apos;pelican&apos; THEN [confirmed_orders] ELSE 0 END)' />
