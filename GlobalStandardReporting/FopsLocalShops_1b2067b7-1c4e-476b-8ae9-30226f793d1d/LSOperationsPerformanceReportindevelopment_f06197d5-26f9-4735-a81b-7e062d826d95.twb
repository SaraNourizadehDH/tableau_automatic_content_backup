            <column caption='Date' datatype='string' name='[Calculation_5316077153034825728]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [granularity]&#10;WHEN &quot;daily&quot; THEN RIGHT(STR([local_date]), 8) + &quot;&#10;&quot; + MID([local_weekday], 5, 3)&#10;WHEN &quot;weekly&quot; THEN RIGHT(STR([local_date]), 8)&#10;WHEN &quot;monthly&quot; THEN MID(STR([local_date]), 3, 5)&#10;WHEN &quot;quarterly&quot; THEN MID(STR([local_date]), 3, 5)&#10;END' />
            </column>
            <column caption='% Items Not Delivered' datatype='real' default-format='p0.00%' name='[Calculation_5316077153388728321]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    (&#10;        SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [in_cart_pelican_items] ELSE 0 END) &#10;        - SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [in_cart_pelican_items_sold] ELSE 0 END)&#10;    )&#10;    + SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [not_found_pelican_items] ELSE 0 END)&#10;    + (&#10;        SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [replaced_pelican_items] ELSE 0 END) &#10;        - SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [replaced_pelican_items_sold] ELSE 0 END) &#10;        - SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [replacements_pelican_items] ELSE 0 END) &#10;    )&#10;    + SUM(IF [is_failed_due_to_out_of_stock] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [qty_ordered] ELSE 0 END)&#10;) / &#10;(&#10;    SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [in_cart_pelican_items] ELSE 0 END)&#10;    + SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [not_found_pelican_items] ELSE 0 END)&#10;    + SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [not_processed_pelican_items] ELSE 0 END)&#10;    + SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [replaced_pelican_items] ELSE 0 END)&#10;    + SUM(IF [is_failed_due_to_out_of_stock] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [qty_ordered] ELSE 0 END)&#10;)' />
            </column>
            <column caption='Empty 01' datatype='integer' name='[Calculation_5316077153423130629]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(NULL)' />
            </column>
            <column caption='# Total Orders' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_5316077153424056326]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_orders])' />
            </column>
            <column caption='AAA Supermarket' datatype='string' name='[Calculation_5869879174709649410]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_aaa_supermarket] THEN &quot;AAA Supermarket&quot; ELSE &quot;Non AAA Supermarket&quot; END' />
            </column>
            <column caption='Entity or Country' datatype='string' name='[Calculation_5869879174721257475]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF {FIXED : COUNTD([entity])} = 1 THEN [country] ELSE [entity] END' />
            </column>
            <column caption='% Total Orders var due to Days Seasonality' datatype='real' default-format='p0.0%' name='[Calculation_6549781976610992134]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_5316077153424056326] / [# Total Orders (copy)_6549781976555294724]) - 1' />
            </column>
            <column caption='% Fully Filled Orders' datatype='real' default-format='p0.0%' name='[Calculation_6549781976614334471]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fully_filled_orders_pelican])/ [# Confirmed Orders (copy)_5316077153433296913]' />
            </column>
            <column caption='Vendor id + Country' datatype='string' name='[Calculation_6549781976631848979]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[vendor_id] + [country_code]' />
            </column>
            <column caption='# of Online Vendors' datatype='integer' name='[Calculation_6549781976643182618]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF COUNTD(IF [period_num] != 1 AND [granularity] != &apos;daily&apos; THEN 1 ELSE NULL END) = 1&#10;THEN COUNTD(IF [is_online] THEN [Calculation_6549781976631848979] ELSE NULL END)&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='% of New Vendors' datatype='real' default-format='p0.0%' name='[Calculation_6549781976666349601]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[# of Vendors (copy)_6549781976645992476] / [Calculation_6549781976643182618]' />
            </column>
            <column caption='$ GMV Net' datatype='real' default-format='n#,##0,,.00M;-#,##0,,.00M' name='[Calculation_6549781976997109802]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Num of Periods (copy)] = &apos;Eur&apos; THEN IF [is_sent] THEN [gmv_net_eur] ELSE 0 END&#10;ELSE IF [is_sent] THEN [gmv_net_lc] ELSE 0 END&#10;END' />
            </column>
            <column caption='# of Acc Managers' datatype='integer' name='[Calculation_6549781978326507583]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF COUNTD(IF [period_num] != 1 AND [granularity] != &apos;daily&apos; THEN 1 ELSE NULL END) = 1&#10;THEN COUNTD([acc_manager])&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='# Ordered Items' datatype='real' default-format='n#,##0,,.0M;-#,##0,,.0M' name='[Calculation_6549781978352226373]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qty_ordered])' />
            </column>
            <column caption='% Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_6549781978359410763]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_failed] THEN [total_orders] ELSE NULL END)&#10;/ SUM([total_orders])' />
            </column>
            <column caption='Vendor Id Filter' datatype='boolean' name='[Chain Id Filter (copy)_4694791515567165444]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] THEN&#10;    IF [Parameters].[Parameter 4] != &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Parameter 4], [vendor_id]) THEN TRUE ELSE FALSE END&#10;        ELSE TRUE&#10;    END&#10;ELSE&#10;    IF [Parameters].[Parameter 4] != &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Parameter 4], [vendor_id]) THEN FALSE ELSE TRUE END&#10;        ELSE TRUE&#10;    END&#10;END' />
            </column>
