              <calculation class='tableau' formula='COUNTD(IF [is_SFTP_integrated] AND [is_SFTP_stock_integrated] AND [is_active] THEN [Calculation_6549781976631848979] ELSE NULL END)&#10;/ COUNTD(IF [is_active] AND [is_SFTP_integrated] THEN [Calculation_6549781976631848979] ELSE NULL END)' />
            </column>
            <column caption='% of Active Vendors using No Integration' datatype='real' default-format='p0.0%' name='[% of Active Vendors using SFTP (copy)_1993194688089686041]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_SFTP_integrated] = FALSE AND [is_API_integrated] = FALSE AND [is_pos_indirect_integrated] = FALSE AND [is_ls3_plugin_integrated] = FALSE AND [is_active] THEN [Calculation_6549781976631848979] ELSE NULL END)&#10;/ COUNTD(IF [is_active] THEN [Calculation_6549781976631848979] ELSE NULL END)' />
            </column>
            <column caption='% of Active Vendors using a POS Indirect Integration' datatype='real' default-format='p0.0%' name='[% of Active Vendors using a POS Direct Integration (copy)_1993194688034807829]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_pos_indirect_integrated] AND [is_active] THEN [Calculation_6549781976631848979] ELSE NULL END)&#10;/ COUNTD(IF [is_active] THEN [Calculation_6549781976631848979] ELSE NULL END)' />
            </column>
            <column caption='% of Churns' datatype='real' default-format='p0.0%' name='[% of Recovered (copy)_6549781976900108326]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF COUNTD(IF [period_num] != 1 AND granularity != &apos;daily&apos; THEN 1 ELSE NULL END) = 1&#10;THEN COUNTD(IF [is_churn] THEN [Calculation_6549781976631848979] ELSE NULL END) / [Calculation_6549781976643182618]&#10;ELSE NULL&#10;END' />
