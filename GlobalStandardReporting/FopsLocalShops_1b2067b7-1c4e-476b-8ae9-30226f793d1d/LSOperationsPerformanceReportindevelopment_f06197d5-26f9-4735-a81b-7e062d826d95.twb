        <calculation class='tableau' formula='(&#10;    SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [not_found_pelican_items] ELSE 0 END)&#10;) / &#10;(&#10;    SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [in_cart_pelican_items] ELSE 0 END)&#10;    + SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [not_found_pelican_items] ELSE 0 END)&#10;    + SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [not_processed_pelican_items] ELSE 0 END)&#10;    + SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [replaced_pelican_items] ELSE 0 END)&#10;    + SUM(IF [is_failed_due_to_out_of_stock] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [qty_ordered] ELSE 0 END)&#10;)' />
      </column>
      <column caption='% Items Not Found' datatype='real' default-format='p0.00%' name='[% Items Not Delivered (op) (copy)_6549781978349953089]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;    (&#10;        SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [in_cart_pelican_items] ELSE 0 END) &#10;        - SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [in_cart_pelican_items_sold] ELSE 0 END)&#10;    )&#10;    + SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [not_found_pelican_items] ELSE 0 END)&#10;    + (&#10;        SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [replaced_pelican_items] ELSE 0 END) &#10;    )&#10;    + SUM(IF [is_failed_due_to_out_of_stock] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [qty_ordered] ELSE 0 END)&#10;) / &#10;(&#10;    SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [in_cart_pelican_items] ELSE 0 END)&#10;    + SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [not_found_pelican_items] ELSE 0 END)&#10;    + SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [not_processed_pelican_items] ELSE 0 END)&#10;    + SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [replaced_pelican_items] ELSE 0 END)&#10;    + SUM(IF [is_failed_due_to_out_of_stock] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [qty_ordered] ELSE 0 END)&#10;)' />
