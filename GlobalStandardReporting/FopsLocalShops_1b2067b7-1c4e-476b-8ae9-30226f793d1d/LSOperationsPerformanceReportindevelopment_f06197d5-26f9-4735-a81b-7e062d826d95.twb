            </column>
            <column caption='% of Active Vendors using API' datatype='real' default-format='p0.0%' name='[% of Active Vendors using SFTP (copy)_1993194688034123794]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_API_integrated] AND [is_active] THEN [Calculation_6549781976631848979] ELSE NULL END)&#10;/ COUNTD(IF [is_active] THEN [Calculation_6549781976631848979] ELSE NULL END)' />
