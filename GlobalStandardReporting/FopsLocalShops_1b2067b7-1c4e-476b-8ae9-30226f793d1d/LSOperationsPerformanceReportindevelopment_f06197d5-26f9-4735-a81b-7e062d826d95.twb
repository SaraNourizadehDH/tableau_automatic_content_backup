              <calculation class='tableau' formula='IF [Parameters].[Num of Periods (copy)] = &apos;Eur&apos; THEN (&#10;    &#10;    SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; AND [has_replacements_in_last_30_days] THEN [replacements_pelican_total_price_eur] ELSE 0 END) &#10;    /&#10;    (&#10;        ( &#10;            SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; AND [has_replacements_in_last_30_days] THEN [in_cart_pelican_total_price_eur] ELSE 0 END) &#10;            - SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; AND [has_replacements_in_last_30_days] THEN [in_cart_pelican_total_price_eur_sold] ELSE 0 END)&#10;        )&#10;        + SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; AND [has_replacements_in_last_30_days] THEN [not_found_pelican_total_price_eur] ELSE 0 END)&#10;        + (&#10;            SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; AND [has_replacements_in_last_30_days] THEN [replaced_pelican_total_price_eur] ELSE 0 END) &#10;            - SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; AND [has_replacements_in_last_30_days] THEN [replaced_pelican_total_price_eur_sold] ELSE 0 END) &#10;        )&#10;        + SUM(IF [is_failed_due_to_out_of_stock] AND [vendor_app] = &apos;pelican&apos; = TRUE AND [has_replacements_in_last_30_days] THEN [gmv_net_eur] ELSE 0 END)&#10;    )&#10;&#10;) ELSE (&#10;    SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; AND [has_replacements_in_last_30_days] THEN [replacements_pelican_total_price_lc] ELSE 0 END) &#10;    /&#10;    (&#10;        (&#10;            SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; AND [has_replacements_in_last_30_days] THEN [in_cart_pelican_total_price_lc] ELSE 0 END) &#10;            - SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; AND [has_replacements_in_last_30_days] THEN [in_cart_pelican_total_price_lc_sold] ELSE 0 END)&#10;        )&#10;        + SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; AND [has_replacements_in_last_30_days] THEN [not_found_pelican_total_price_lc] ELSE 0 END)&#10;        + (&#10;            SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; AND [has_replacements_in_last_30_days] THEN [replaced_pelican_total_price_lc] ELSE 0 END) &#10;            - SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; AND [has_replacements_in_last_30_days] THEN [replaced_pelican_total_price_lc_sold] ELSE 0 END) &#10;        )&#10;        + SUM(IF [is_failed_due_to_out_of_stock] = TRUE AND [vendor_app] = &apos;pelican&apos; AND [has_replacements_in_last_30_days] THEN [gmv_net_lc] ELSE 0 END)&#10;    )&#10;) END' />
