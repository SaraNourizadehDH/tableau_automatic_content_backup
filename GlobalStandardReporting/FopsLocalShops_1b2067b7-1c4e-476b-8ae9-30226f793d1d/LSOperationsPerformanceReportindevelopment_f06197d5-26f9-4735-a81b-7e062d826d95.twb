          <datasource-dependencies datasource='federated.07w3vlb128jhqj1g9llpw19ej4l4'>
            <column caption='# Total Orders (op)' datatype='integer' default-format='n#,##0;-#,##0' name='[     # Total Orders (copy)_5316077153429008398]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [vendor_app] = &apos;pelican&apos; THEN [total_orders] ELSE 0 END)' />
            </column>
            <column caption='          % Orders with Free Delivery' datatype='real' default-format='p0.0%' name='[     $ Delivery Fee - Nominal (copy)_6549781978691850334]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_free_delivery] THEN [confirmed_orders] ELSE 0 END) / SUM([confirmed_orders])' />
            </column>
            <column caption='     $ Service Fee' datatype='real' default-format='c#,##0.00;(#,##0.00)' name='[     $ Delivery Fee - Nominal (copy)_6549781978694234207]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Parameters].[Num of Periods (copy)] = &apos;Eur&apos; THEN IF [is_sent] THEN [service_fee_eur] ELSE 0 END&#10;ELSE IF [is_sent] THEN [service_fee_lc] ELSE 0 END&#10;END) / SUM([confirmed_orders])' />
            </column>
            <column caption='     $ Delivery Fee - Nominal' datatype='real' default-format='c#,##0.00;(#,##0.00)' name='[     $ Delivery Fee - Realized (copy)_6549781978690564189]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Parameters].[Num of Periods (copy)] = &apos;Eur&apos; THEN IF [is_sent] THEN [delivery_fee_eur] ELSE 0 END&#10;ELSE IF [is_sent] THEN [delivery_fee_lc] ELSE 0 END&#10;END) / SUM(IF [is_free_delivery] = FALSE THEN [confirmed_orders] ELSE 0 END)' />
            </column>
            <column caption='     $ Delivery Fee - Realized' datatype='real' default-format='c#,##0.00;(#,##0.00)' name='[     $ GBV Gross (copy)_6549781978412658777]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Parameters].[Num of Periods (copy)] = &apos;Eur&apos; THEN IF [is_sent] THEN [delivery_fee_eur] ELSE 0 END&#10;ELSE IF [is_sent] THEN [delivery_fee_lc] ELSE 0 END&#10;END) / [# Total Orders (copy)_5316077153424134151]' />
            </column>
            <column caption='     % Pelican' datatype='real' default-format='p0.0%' name='[     % Confirmed Orders (copy)_5316077153429626895]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [vendor_app] = &apos;pelican&apos; THEN [total_orders] ELSE 0 END)&#10;/ SUM([total_orders])' />
            </column>
            <column caption='     % Direct POS - Peya' datatype='real' default-format='p0.0%' name='[     % Direct POS (copy)_4694791515548590080]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [vendor_app] = &apos;direct pos - peya&apos; THEN [total_orders] ELSE 0 END)&#10;/ SUM([total_orders])' />
            </column>
            <column caption='% GMV Replaced from Eligible' datatype='real' default-format='p0.0%' name='[     % GMV Loss due to Items Not Delivered (op) (copy)_1993194687997554699]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Num of Periods (copy)] = &apos;Eur&apos; THEN (&#10;    &#10;    SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [replacements_pelican_total_price_eur] ELSE 0 END) &#10;    /&#10;    (&#10;        (&#10;            SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [in_cart_pelican_total_price_eur] ELSE 0 END) &#10;            - SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [in_cart_pelican_total_price_eur_sold] ELSE 0 END)&#10;        )&#10;        + SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [not_found_pelican_total_price_eur] ELSE 0 END)&#10;        + (&#10;            SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [replaced_pelican_total_price_eur] ELSE 0 END) &#10;            - SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [replaced_pelican_total_price_eur_sold] ELSE 0 END) &#10;        )&#10;        + SUM(IF [is_failed_due_to_out_of_stock] AND [vendor_app] = &apos;pelican&apos; = TRUE THEN [gmv_net_eur] ELSE 0 END)&#10;    )&#10;&#10;) ELSE (&#10;    SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [replacements_pelican_total_price_lc] ELSE 0 END) &#10;    /&#10;    (&#10;        (&#10;            SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [in_cart_pelican_total_price_lc] ELSE 0 END) &#10;            - SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [in_cart_pelican_total_price_lc_sold] ELSE 0 END)&#10;        )&#10;        + SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [not_found_pelican_total_price_lc] ELSE 0 END)&#10;        + (&#10;            SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [replaced_pelican_total_price_lc] ELSE 0 END) &#10;            - SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [replaced_pelican_total_price_lc_sold] ELSE 0 END) &#10;        )&#10;        + SUM(IF [is_failed_due_to_out_of_stock] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [gmv_net_lc] ELSE 0 END)&#10;    )&#10;) END' />
            </column>
            <column caption='     % Direct POS' datatype='real' default-format='p0.0%' name='[     % Pelican (copy)_4509440243371270144]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [vendor_app] = &apos;direct pos&apos; THEN [total_orders] ELSE 0 END)&#10;/ SUM([total_orders])' />
