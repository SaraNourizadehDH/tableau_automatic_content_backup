              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &quot;1&quot; THEN SUM([total_orders])&#10;WHEN &quot;2&quot; THEN [     % Confirmed Orders (copy)_5316077153429626895] * 100&#10;WHEN &quot;3&quot; THEN [     % Pelican Orders (copy)_6549781978787815532] * 100&#10;WHEN &quot;4&quot; THEN [     % Pelican (copy)_4509440243371270144] * 100&#10;WHEN &quot;5&quot; THEN [     % Direct POS (copy)_4694791515548590080] * 100&#10;WHEN &quot;6&quot; THEN [# Total Orders (copy)_5316077153424134151]&#10;WHEN &quot;7&quot; THEN [# Total Orders (copy)_5316077153432043536]&#10;WHEN &quot;8&quot; THEN [# Confirmed Orders per Vendor (copy)_6549781976630599698]&#10;WHEN &quot;9&quot; THEN [# Confirmed Orders per Day (copy)_6549781976624799757]&#10;WHEN &quot;10&quot; THEN IF [Calculation_6549781978359410763] = 1 THEN NULL ELSE [Calculation_6549781978359410763] END * 100&#10;WHEN &quot;11&quot; THEN IF [% Fail Rate due to Platform (copy)_6549781978368827471] = 1 THEN NULL ELSE [% Fail Rate due to Platform (copy)_6549781978368827471] END * 100&#10;WHEN &quot;12&quot; THEN IF [  - % due to Vendor (copy)_6549781978383962193] = 1 THEN NULL ELSE [  - % due to Vendor (copy)_6549781978383962193] END * 100&#10;WHEN &quot;13&quot; THEN IF [% Fail Rate (copy)_6549781978365853772] = 1 THEN NULL ELSE [% Fail Rate (copy)_6549781978365853772] END * 100&#10;WHEN &quot;14&quot; THEN IF [% Fail Rate due to Vendor (copy)_6549781978368876624] = 1 THEN NULL ELSE [% Fail Rate due to Vendor (copy)_6549781978368876624] END * 100&#10;WHEN &quot;15&quot; THEN IF [% Fail Rate due to Fulfilment (copy)_6549781978368712782] = 1 THEN NULL ELSE [% Fail Rate due to Fulfilment (copy)_6549781978368712782] END * 100&#10;WHEN &quot;16&quot; THEN IF [% Modify Orders (op) (copy)_6549781976621334539] = 1 THEN NULL ELSE [% Modify Orders (op) (copy)_6549781976621334539] END * 100&#10;WHEN &quot;17&quot; THEN IF [Calculation_6549781976614334471] = 1 THEN NULL ELSE [Calculation_6549781