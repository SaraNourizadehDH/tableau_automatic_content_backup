              <calculation class='tableau' formula='COUNTD(IF [is_ls3_plugin_integrated] AND [is_active] THEN [Calculation_6549781976631848979] ELSE NULL END)&#10;/ COUNTD(IF [is_active] THEN [Calculation_6549781976631848979] ELSE NULL END)' />
