      <table>
        <view>
          <datasources>
            <datasource caption='ls_ops_rt_evolution_table (dev_dmart)' name='federated.07w3vlb128jhqj1g9llpw19ej4l4' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='All Vendors' caption='Integration' datatype='string' name='[Chain IDs Filter (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;0&quot;'>
              <calculation class='tableau' formula='&quot;0&quot;' />
              <aliases>
                <alias key='&quot;0&quot;' value='All Vendors' />
                <alias key='&quot;1&quot;' value='SFTP' />
