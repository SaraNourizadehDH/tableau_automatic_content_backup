            <column caption='     % using SFTP Campaigns' datatype='real' default-format='p0.0%' name='[% of Active Vendors using SFTP (copy)_1993194688034504723]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_SFTP_integrated] AND [is_SFTP_Promos_integrated] AND [is_active] THEN [Calculation_6549781976631848979] ELSE NULL END)&#10;/ COUNTD(IF [is_active] AND [is_SFTP_integrated] THEN [Calculation_6549781976631848979] ELSE NULL END)' />
