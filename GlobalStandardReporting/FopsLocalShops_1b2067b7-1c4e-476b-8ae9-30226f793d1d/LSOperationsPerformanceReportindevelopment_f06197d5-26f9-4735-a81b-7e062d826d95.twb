            <column caption='% Share of Items Not Delivered from VUR' datatype='real' default-format='p0.0%' name='[% of Active Vendor using Replacements (copy)_1993194687644401668]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF COUNTD(IF [period_num] != 1 AND [granularity] != &apos;daily&apos; THEN 1 ELSE NULL END) = 1 THEN&#10;(&#10;    (&#10;        SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; ANd [has_replacements_in_last_30_days] THEN [in_cart_pelican_items] ELSE 0 END) &#10;        - SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; ANd [has_replacements_in_last_30_days] THEN [in_cart_pelican_items_sold] ELSE 0 END)&#10;    )&#10;    + SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; ANd [has_replacements_in_last_30_days] THEN [not_found_pelican_items] ELSE 0 END)&#10;    + (&#10;        SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; ANd [has_replacements_in_last_30_days] THEN [replaced_pelican_items] ELSE 0 END) &#10;        - SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; ANd [has_replacements_in_last_30_days] THEN [replaced_pelican_items_sold] ELSE 0 END) &#10;        - SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; ANd [has_replacements_in_last_30_days] THEN [replacements_pelican_items] ELSE 0 END) &#10;    )&#10;    + SUM(IF [is_failed_due_to_out_of_stock] = TRUE AND [vendor_app] = &apos;pelican&apos; ANd [has_replacements_in_last_30_days] THEN [qty_ordered] ELSE 0 END)&#10;)    &#10;/ &#10;(&#10;    (&#10;        SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [in_cart_pelican_items] ELSE 0 END) &#10;        - SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [in_cart_pelican_items_sold] ELSE 0 END)&#10;    )&#10;    + SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [not_found_pelican_items] ELSE 0 END)&#10;    + (&#10;        SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [replaced_pelican_items] ELSE 0 END) &#10;        - SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [replaced_pelican_items_sold] ELSE 0 END) &#10;        - SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [replacements_pelican_items] ELSE 0 END) &#10;    )&#10;    + SUM(IF [is_failed_due_to_out_of_stock] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [qty_ordered] ELSE 0 END)&#10;)&#10;ELSE NULL&#10;END' />
            </column>
