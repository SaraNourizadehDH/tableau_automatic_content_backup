              <calculation class='tableau' formula='SUM(IF [is_sent] THEN [$ GMV Net (copy)_6549781978420678748] ELSE 0 END) &#10;        / SUM(IF [is_sent] THEN [confirmed_orders] ELSE NULL END)' />
