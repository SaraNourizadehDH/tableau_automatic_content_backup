        <column caption='Integration Filter' datatype='boolean' name='[Calculation_1993194688902832154]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='CASE [Parameters].[Chain IDs Filter (copy)]&#10;WHEN &quot;0&quot; THEN TRUE&#10;WHEN &quot;1&quot; THEN IF [is_SFTP_integrated] THEN TRUE ELSE FALSE END&#10;WHEN &quot;2&quot; THEN IF [is_API_integrated] THEN TRUE ELSE FALSE END&#10;WHEN &quot;3&quot; THEN IF [is_pos_direct_integrated] THEN TRUE ELSE FALSE END&#10;WHEN &quot;4&quot; THEN IF [is_pos_indirect_integrated] THEN TRUE ELSE FALSE END&#10;WHEN &quot;5&quot; THEN IF [is_ls3_plugin_integrated] THEN TRUE ELSE FALSE END&#10;WHEN &quot;6&quot; THEN IF [is_SFTP_integrated] = FALSE AND [is_API_integrated] = FALSE AND [is_pos_indirect_integrated] = FALSE AND [is_ls3_plugin_integrated] = FALSE THEN TRUE ELSE FALSE END&#10;END' />
        </column>
        <column caption='Chain Id Filter' datatype='boolean' name='[Calculation_4694791515567050755]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [Parameters].[Parameter 2] THEN&#10;    IF [Parameters].[Vendors List to Filter (copy)_3194529905697562660] != &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Vendors List to Filter (copy)_3194529905697562660], [chain_id]) THEN TRUE ELSE FALSE END&#10;        ELSE TRUE&#10;    END&#10;ELSE&#10;    IF [Parameters].[Vendors List to Filter (copy)_3194529905697562660] != &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Vendors List to Filter (copy)_3194529905697562660], [chain_id]) THEN FALSE ELSE TRUE END&#10;        ELSE TRUE&#10;    END&#10;END' />
        </column>
        <column caption='Vendor Id Filter' datatype='boolean' name='[Chain Id Filter (copy)_4694791515567165444]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [Parameters].[Parameter 2] THEN&#10;    IF [Parameters].[Parameter 4] != &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Parameter 4], [vendor_id]) THEN TRUE ELSE FALSE END&#10;        ELSE TRUE&#10;    END&#10;ELSE&#10;    IF [Parameters].[Parameter 4] != &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Parameter 4], [vendor_id]) THEN FALSE ELSE TRUE END&#10;        ELSE TRUE&#10;    END&#10;END' />
        </column>
