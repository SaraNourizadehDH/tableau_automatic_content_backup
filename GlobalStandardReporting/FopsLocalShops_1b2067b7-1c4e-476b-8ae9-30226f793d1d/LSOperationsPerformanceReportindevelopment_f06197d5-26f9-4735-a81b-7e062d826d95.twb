              <calculation class='tableau' formula='IF COUNTD(IF [period_num] != 1 &#10;    AND [granularity] != &apos;daily&apos; THEN 1 ELSE NULL END) = 1 THEN&#10;        SUM(IF [is_sent] THEN [Calculation_6549781976997109802] ELSE 0 END) &#10;        / COUNTD(IF [is_sent] THEN [Vendor id + Country (copy)_6549781976631980052] ELSE NULL END)&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='$ GMV Net per Order' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[$ GMV per Vendor (copy)_6549781978409107542]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_sent] THEN [Calculation_6549781976997109802] ELSE 0 END) &#10;        / SUM(IF [is_sent] THEN [confirmed_orders] ELSE NULL END)' />
            </column>
            <column caption='          % Discounts' datatype='real' default-format='p0.0%' name='[% Discounts &amp; Vouchers (copy)_6549781978389803090]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([$ GMV Gross (copy)_6549781978389921875])&#10;/ SUM([$ GMV Net (copy)_6549781977007771700])' />
            </column>
            <column caption='          % Vouchers' datatype='real' default-format='p0.0%' name='[% Discounts (copy)_6549781978391195733]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([$ Discounts (copy)_6549781978390024276])&#10;/ SUM([$ GMV Net (copy)_6549781977007771700])' />
            </column>
            <column caption='     % due to Customer' datatype='real' default-format='p0.00%' name='[% Fail Rate (copy)_6549781978365853772]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_failed] AND [failure_owner] = &apos;CUSTOMER&apos; THEN [total_orders] ELSE NULL END)&#10;/ SUM([total_orders])' />
            </column>
            <column caption='     % due to Platform' datatype='real' default-format='p0.00%' name='[% Fail Rate due to Fulfilment (copy)_6549781978368712782]' role='measure' type='quantitative'>
