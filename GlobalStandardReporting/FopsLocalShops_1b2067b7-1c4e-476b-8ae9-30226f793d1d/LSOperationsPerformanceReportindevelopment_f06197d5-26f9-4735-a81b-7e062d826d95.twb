            <column caption='# Confirmed Orders per Vendor' datatype='real' default-format='n#,##0;-#,##0' name='[# Confirmed Orders per Day (copy)_6549781976624799757]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF COUNTD(IF [period_num] != 1 AND granularity != &apos;daily&apos; THEN 1 ELSE NULL END) = 1&#10;THEN &#10;SUM([confirmed_orders]&#10;) / COUNTD([Calculation_6549781976631848979])&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='# Confirmed Orders per Chain' datatype='real' default-format='n#,##0;-#,##0' name='[# Confirmed Orders per Vendor (copy)_6549781976630599698]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF COUNTD(IF [period_num] != 1 AND granularity != &apos;daily&apos; THEN 1 ELSE NULL END) = 1&#10;THEN &#10;SUM(&#10;    IF [chain_id] = NULL THEN 0 ELSE [confirmed_orders] END&#10;) / COUNTD([Vendor id + Country (copy)_6549781976631980052])&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='$ GMV Net per Vendor' datatype='real' default-format='n#,##0;-#,##0' name='[# Confirmed Orders per Vendor (copy)_6549781976996905001]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF COUNTD(IF [period_num] != 1 &#10;    AND [granularity] != &apos;daily&apos; THEN 1 ELSE NULL END) = 1 THEN&#10;        SUM(IF [is_sent] THEN [Calculation_6549781976997109802] ELSE 0 END) &#10;        / COUNTD(IF [is_sent] THEN [Calculation_6549781976631848979] ELSE NULL END)&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='# Sold Items' datatype='real' default-format='n#,##0,,.0M;-#,##0,,.0M' name='[# Ordered Items (copy)_6549781978352906310]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qty_sold])' />
            </column>
            <column caption='     # Basket Size' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[# Sold Items per Confirmed Order (copy)_4694791515560755201]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_sent] THEN [qty_ordered] ELSE 0 END) &#10;/ SUM([confirmed_orders])' />
