              <calculation class='tableau' formula='(&#13;&#10;    (&#13;&#10;        SUM([in_cart_pelican_items] + [not_found_pelican_items] + [replaced_pelican_items] + [replacements_pelican_items] + [not_processed_pelican_items]) &#13;&#10;        / [Calculation_2721581600462766086]&#13;&#10;    ) / COUNTD([local_hour])&#13;&#10;)' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_2580844109258727425]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [granularity]&#13;&#10;WHEN &quot;daily&quot; THEN RIGHT(STR([local_date]), 5)&#13;&#10;WHEN &quot;weekly&quot; THEN RIGHT(STR([local_date]), 8)&#13;&#10;WHEN &quot;monthly&quot; THEN MID(STR([local_date]), 3, 5)&#13;&#10;WHEN &quot;quarterly&quot; THEN MID(STR([local_date]), 3, 5)&#13;&#10;ELSE STR([local_date])&#13;&#10;END' />
            </column>
            <column caption='Entity' datatype='string' name='[Calculation_2580844109639041047]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF LOWER([country]) = &quot;turkey&quot; THEN &quot;Yemeksepeti&quot; ELSE [management_entity] END' />
            </column>
            <column caption='# of Pickers' datatype='integer' name='[Calculation_2721581600462766086]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([picker_id])' />
            </column>
            <column caption='# Orders by Picker per Hour' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_2721581600494665744]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([confirmed_orders]) / [Calculation_2721581600462766086]) / COUNTD([local_hour])' />
            </column>
            <column caption='Pelican Items' datatype='real' name='[Calculation_2905947710943956992]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[in_cart_pelican_items] + [not_found_pelican_items] + [replaced_pelican_items] + [replacements_pelican_items] + [not_processed_pelican_items]' />
            </column>
            <column caption='Picking App' datatype='string' name='[Calculation_2934095208520331270]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF LOWER([vendor_app]) = &quot;pelican&quot; AND [integration_type] = &quot;POS_DIRECT_INTEGRATED&quot; THEN &quot;Direct POS&quot;&#13;&#10;ELSEIF LOWER([vendor_app]) = &quot;pelican&quot; AND [integration_type] = &quot;POS_INDIRECT_INTEGRATED&quot; THEN &quot;Pelican - Indirect Pos&quot;&#13;&#10;ELSEIF LOWER([vendor_app]) = &quot;pelican&quot; THEN &quot;Pelican&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='Average Orders per Day' datatype='real' name='[Calculation_2934095208532836359]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([confirmed_orders])/MAX([num_of_days])' />
            </column>
            <column caption='More than x Order Filter' datatype='boolean' name='[Calculation_2934095208539262984]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;ROUND({ FIXED [Calculation_2580844109258727425], [Calculation_2934095208553451529] : [Calculation_2934095208532836359]}, 0)&#13;&#10;&gt;= [Parameters].[Parameter 7] THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Vendor Name' datatype='string' name='[Calculation_2934095208553451529]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[vendor_id] + &quot; - &quot; + [vendor_name]' />
            </column>
            <column caption='Chain Id Filter' datatype='boolean' name='[Calculation_2934095208586162186]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] THEN&#13;&#10;    IF [Parameters].[Parameter 6] != &quot;&quot; THEN&#13;&#10;        IF CONTAINS([Parameters].[Parameter 6], [chain_id]) THEN TRUE ELSE FALSE END&#13;&#10;        ELSE TRUE&#13;&#10;    END&#13;&#10;ELSE&#13;&#10;    IF [Parameters].[Parameter 6] != &quot;&quot; THEN&#13;&#10;        IF CONTAINS([Parameters].[Parameter 6], [chain_id]) THEN FALSE ELSE TRUE END&#13;&#10;        ELSE TRUE&#13;&#10;    END&#13;&#10;END' />
            </column>
            <column caption='Vendor Id Filter' datatype='boolean' name='[Calculation_2934095208586338315]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] THEN&#13;&#10;    IF [Parameters].[Chain IDs Filter (copy)_2934095208519184388] != &quot;&quot; THEN&#13;&#10;        IF CONTAINS([Parameters].[Chain IDs Filter (copy)_2934095208519184388], [vendor_id]) THEN TRUE ELSE FALSE END&#13;&#10;        ELSE TRUE&#13;&#10;    END&#13;&#10;ELSE&#13;&#10;    IF [Parameters].[Chain IDs Filter (copy)_2934095208519184388] != &quot;&quot; THEN&#13;&#10;        IF CONTAINS([Parameters].[Chain IDs Filter (copy)_2934095208519184388], [vendor_id]) THEN FALSE ELSE TRUE END&#13;&#10;        ELSE TRUE&#13;&#10;    END&#13;&#10;END' />
            </column>
            <column caption='Fulfilment Time (no filter)' datatype='real' default-format='n#,##0;-#,##0' name='[Full Picking Time (copy)_2580844109625507861]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(((&#13;&#10;    IF [Parameters].[Parameter 3] = &quot;0&quot; OR [Parameters].[Parameter 3] = &quot;1&quot; THEN SUM( IF [is_sent] AND [is_picker_sequence_complete_and_valid] THEN &#13;&#10;        [transmission_time_s] &#13;&#10;        + [hold_back_time_s] &#13;&#10;        + [started_time_s] &#13;&#10;        + [picking_time_s] &#13;&#10;        + [confirmed_checkout_time_s] &#13;&#10;        + [ready_to_pickup_time_s] &#13;&#10;        ELSE 0 END)&#13;&#10;    ELSEIF [Parameters].[Parameter 3] = &quot;2&quot; THEN (SUM(IF [is_sent] AND [is_picker_sequence_complete_and_valid] THEN [transmission_time_s] ELSE 0 END))&#13;&#10;    ELSEIF [Parameters].[Parameter 3] = &quot;3&quot; THEN (SUM(IF [is_sent] AND [is_picker_sequence_complete_and_valid] THEN [hold_back_time_s] ELSE 0 END))&#13;&#10;    ELSEIF [Parameters].[Parameter 3] = &quot;4&quot; THEN (SUM(IF [is_sent] AND [is_picker_sequence_complete_and_valid] THEN [started_time_s] ELSE 0 END))&#13;&#10;    ELSEIF [Parameters].[Parameter 3] = &quot;5&quot; THEN (SUM(IF [is_sent] AND [is_picker_sequence_complete_and_valid] THEN [picking_time_s] ELSE 0 END))&#13;&#10;    ELSEIF [Parameters].[Parameter 3] = &quot;6&quot; THEN (SUM(IF [is_sent] AND [is_picker_sequence_complete_and_valid] THEN [confirmed_checkout_time_s] ELSE 0 END))&#13;&#10;    ELSEIF [Parameters].[Parameter 3] = &quot;7&quot; THEN (SUM(IF [is_sent] AND [is_picker_sequence_complete_and_valid] THEN [ready_to_pickup_time_s] ELSE 0 END))&#13;&#10;    ELSE 0 END&#13;&#10;)&#13;&#10;    / &#13;&#10;        IF [Parameters].[Parameter 9] = &quot;1&quot; THEN&#13;&#10;            SUM(IF [is_sent] AND [is_picker_sequence_complete_and_valid] THEN [total_orders] ELSE 0 END)&#13;&#10;        ELSE&#13;&#10;            SUM(IF [is_sent] AND [is_picker_sequence_complete_and_valid] THEN [Calculation_2905947710943956992] ELSE 0 END)&#13;&#10;        END&#13;&#10;)&#13;&#10;/ IF [Parameters].[Parameter 1] = &quot;1&quot