        <calculation class='categorical-bin' column='[local_hour]' new-bin='true'>
          <bin default-name='false' value='&quot;0 - 2&quot;'>
            <value>0</value>
            <value>1</value>
          </bin>
          <bin default-name='false' value='&quot;10 - 12&quot;'>
            <value>10</value>
