          <datasource-dependencies datasource='Parameters'>
            <column caption='Vendor IDs Filter' datatype='string' name='[Chain IDs Filter (copy)_2934095208519184388]' param-domain-type='any' role='measure' type='nominal' value='&quot;&quot;'>
