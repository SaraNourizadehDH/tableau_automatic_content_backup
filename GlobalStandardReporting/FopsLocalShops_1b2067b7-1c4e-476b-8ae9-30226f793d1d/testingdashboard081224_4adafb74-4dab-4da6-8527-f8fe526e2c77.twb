          </bin>
          <bin default-name='false' value='&quot;12 - 14&quot;'>
            <value>12</value>
            <value>13</value>
          </bin>
          <bin default-name='false' value='&quot;14 - 16&quot;'>
            <value>14</value>
            <value>15</value>
          </bin>
          <bin default-name='false' value='&quot;16 - 18&quot;'>
            <value>16</value>
            <value>17</value>
          </bin>
          <bin default-name='false' value='&quot;18 - 20&quot;'>
            <value>18</value>
            <value>19</value>
          </bin>
          <bin default-name='false' value='&quot;2 - 4&quot;'>
            <value>2</value>
            <value>3</value>
          </bin>
          <bin default-name='false' value='&quot;20 - 22&quot;'>
            <value>20</value>
            <value>21</value>
          </bin>
          <bin default-name='false' value='&quot;22 - 24&quot;'>
            <value>22</value>
            <value>23</value>
          </bin>
          <bin default-name='false' value='&quot;4 - 6&quot;'>
            <value>4</value>
            <value>5</value>
          </bin>
          <bin default-name='false' value='&quot;6 - 8&quot;'>
            <value>6</value>
            <value>7</value>
          </bin>
          <bin default-name='false' value='&quot;8 - 10&quot;'>
            <value>8</value>
            <value>9</value>
          </bin>
        </calculation>
      </column>
      <column aggregation='Sum' caption='Hour' datatype='integer' name='[local_hour]' role='dimension' type='ordinal'>
        <aliases>
          <alias key='0' value='00' />
          <alias key='1' value='01' />
          <alias key='2' value='02' />
          <alias key='3' value='03' />
          <alias key='4' value='04' />
          <alias key='5' value='05' />
          <alias key='6' value='06' />
          <alias key='7' value='07' />
          <alias key='8' value='08' />
