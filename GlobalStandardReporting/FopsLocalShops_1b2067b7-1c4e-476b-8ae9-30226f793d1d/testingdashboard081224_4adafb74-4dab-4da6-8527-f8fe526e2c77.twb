            <column caption='# of Periods to Show Filter' datatype='boolean' name='[Calculation_2721581600030965763]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF INT([period_num]) &lt;= [Parameters].[Parameter 4] THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='granularity Filter' datatype='boolean' name='[Calculation_2721581600409817092]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [granularity] WHEN &quot;weekday&quot; THEN FALSE ELSE TRUE END' />
            </column>
            <column caption='Pelican Items' datatype='real' name='[Calculation_2905947710943956992]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[in_cart_pelican_items] + [not_found_pelican_items] + [replaced_pelican_items] + [replacements_pelican_items] + [not_processed_pelican_items]' />
            </column>
            <column caption='Picking App' datatype='string' name='[Calculation_2934095208520331270]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF LOWER([vendor_app]) = &quot;pelican&quot; AND [integration_type] = &quot;POS_DIRECT_INTEGRATED&quot; THEN &quot;Direct POS&quot;&#13;&#10;ELSEIF LOWER([vendor_app]) = &quot;pelican&quot; AND [integration_type] = &quot;POS_INDIRECT_INTEGRATED&quot; THEN &quot;Pelican - Indirect Pos&quot;&#13;&#10;ELSEIF LOWER([vendor_app]) = &quot;pelican&quot; THEN &quot;Pelican&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='Average Orders per Day' datatype='real' name='[Calculation_2934095208532836359]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([confirmed_orders])/MAX([num_of_days])' />
