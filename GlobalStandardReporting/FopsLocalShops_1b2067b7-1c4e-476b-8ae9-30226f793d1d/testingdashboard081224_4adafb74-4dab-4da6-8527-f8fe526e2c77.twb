            <column alias='Fulfilment Time' caption='Picker Time Metric' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;1&quot;'>
              <calculation class='tableau' formula='&quot;1&quot;' />
              <aliases>
                <alias key='&quot;0&quot;' value='Fulfilment Time Full' />
                <alias key='&quot;1&quot;' value='Fulfilment Time' />
                <alias key='&quot;2&quot;' value='Transmission Time' />
                <alias key='&quot;3&quot;' value='Hold Back Time' />
                <alias key='&quot;4&quot;' value='Started Time' />
                <alias key='&quot;5&quot;' value='Picking Time' />
                <alias key='&quot;6&quot;' value='Checkout Time' />
                <alias key='&quot;7&quot;' value='Ready to Pickup Time' />
              </aliases>
            </column>
            <column caption='# of Periods' datatype='integer' default-format='N' name='[Parameter 4]' param-domain-type='range' role='measure' type='quantitative' value='7'>
              <calculation class='tableau' formula='7' />
              <range max='15' min='1' />
            </column>
            <column alias='In' caption='In / Out (Chain &amp; Vendor IDs Filters)' datatype='boolean' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
              <aliases>
                <alias key='false' value='Out' />
                <alias key='true' value='In' />
              </aliases>
            </column>
            <column caption='Chain IDs Filter' datatype='string' name='[Parameter 6]' param-domain-type='any' role='measure' type='nominal' value='&quot;&quot;'>
              <calculation class='tableau' formula='&quot;&quot;' />
            </column>
            <column caption='Avg Daily Order &gt;=' datatype='integer' name='[Parameter 7]' param-domain-type='range' role='measure' type='quantitative' value='0'>
              <calculation class='tableau' formula='0' />
              <range granularity='25' max='1000' min='0' />
            </column>
            <column alias='Order' caption='Times Measured by' datatype='string' name='[Parameter 9]' param-domain-type='list' role='measure' type='nominal' value='&quot;1&quot;'>
              <calculation class='tableau' formula='&quot;1&quot;' />
              <aliases>
                <alias key='&quot;1&quot;' value='Order' />
                <alias key='&quot;2&quot;' value='Item' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.00hjioa1mi9lda132m1kj0cxud0u'>
            <column caption='Date' datatype='string' name='[Calculation_2580844109258727425]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [granularity]&#13;&#10;WHEN &quot;daily&quot; THEN RIGHT(STR([local_date]), 5)&#13;&#10;WHEN &quot;weekly&quot; THEN RIGHT(STR([local_date]), 8)&#13;&#10;WHEN &quot;monthly&quot; THEN MID(STR([local_date]), 3, 5)&#13;&#10;WHEN &quot;quarterly&quot; THEN MID(STR([local_date]), 3, 5)&#13;&#10;ELSE STR([local_date])&#13;&#10;END' />
            </column>
            <column caption='Transmission Time' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_2580844109264052226]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 9] = &quot;1&quot; THEN&#13;&#10;    IF [Parameters].[Parameter 3] = &quot;1&quot; OR [Parameters].[Parameter 3] = &quot;2&quot; THEN&#13;&#10;        (SUM(IF [is_sent] AND [is_picker_sequence_complete_and_valid] THEN [transmission_time_s] ELSE 0 END)&#13;&#10;        / SUM(IF [is_sent] AND [is_picker_sequence_complete_and_valid] THEN [total_orders] ELSE 0 END))&#13;&#10;        / IF [Parameters].[Parameter 1] = &quot;1&quot; THEN 1 ELSE 60 END&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;ELSE&#13;&#10;    IF [Parameters].[Parameter 3] = &quot;1&quot; OR [Parameters].[Parameter 3] = &quot;2&quot; THEN&#13;&#10;        (SUM(IF [is_sent] AND [is_picker_sequence_complete_and_valid] THEN [transmission_time_s] ELSE 0 END)&#13;&#10;        / SUM(IF [is_sent] AND [is_picker_sequence_complete_and_valid] THEN [Calculation_2905947710943956992] ELSE 0 END))&#13;&#10;        / IF [Parameters].[Parameter 1] = &quot;1&quot; THEN 1 ELSE 60 END&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;END' />
            </column>
            <column caption='Fulfilment Time' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_2580844109336137748]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 9] = &quot;1&quot; THEN&#13;&#10;    IF [Parameters].[Parameter 3] = &quot;0&quot; THEN&#13;&#10;        (&#13;&#10;        (SUM(IF [is_sent] AND [is_picker_sequence_complete_and_valid] THEN [transmission_time_s] ELSE 0 END)&#13;&#10;        / SUM(IF [is_sent] AND [is_picker_sequence_complete_and_valid] THEN [total_orders] ELSE 0 END))&#13;&#10;     &#13;&#10;        +(SUM(IF [is_sent] AND [is_picker_sequence_complete_and_valid] THEN [hold_back_time_s] ELSE 0 END)&#13;&#10;        / SUM(IF [is_sent] AND [is_picker_sequence_complete_and_valid] THEN [total_orders] ELSE 0 END)) &#13;&#10;&#13;&#10;        +(SUM(IF [is_sent] AND [is_picker_sequence_complete_and_valid] THEN [started_time_s] ELSE 0 END)&#13;&#10;        / SUM(IF [is_sent] AND [is_picker_sequence_complete_and_valid] THEN [total_orders] ELSE 0 END)) &#13;&#10;&#13;&#10;        +(SUM(IF [is_sent] AND [is_picker_sequence_complete_and_valid] THEN [picking_time_s] ELSE 0 END)&#13;&#10;        / SUM(IF [is_sent] AND [is_picker_sequence_complete_and_valid] THEN [total_orders] ELSE 0 END)) &#13;&#10;&#13;&#10;        +(SUM(IF [is_sent] AND [is_picker_sequence_complete_and_valid] THEN [confirmed_checkout_time_s] ELSE 0 END)&#13;&#10;        / SUM(IF [is_sent] AND [is_picker_sequence_complete_and_valid] THEN [total_orders] ELSE 0 END)) &#13;&#10;&#13;&#10;        +(SUM(IF [is_sent] AND [is_picker_sequence_complete_and_valid] THEN [ready_to_pickup_time_s] ELSE 0 END)&#13;&#10;        / SUM(IF [is_sent] AND [is_picker_sequence_complete_and_valid] THEN [total_orders] ELSE 0 END)&#13;&#10;        ) &#13;&#10;&#13;&#10;        )/ IF [Parameters].[Parameter 1] = &quot;1&quot; THEN 1 ELSE 60 END&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;ELSE&#13;&#10;    IF [Parameters].[Parameter 3] = &quot;0&quot; THEN&#13;&#10;        (&#13;&#10;        (SUM(IF [is_sent] AND [is_picker_sequence_complete_and_valid] THEN [transmission_time_s] ELSE 0 END)&#13;&#10;        / SUM(IF [is_sent] AND [is_picker_sequence_complete_and_valid] THEN [Calculation_2905947710943956992] ELSE 0 END))&#13;&#10;     &#13;&#10;        +(SUM(IF [is_sent] AND [is_picker_sequence_complete_and_valid] THEN [hold_back_time_s] ELSE 0 END)&#13;&#10;        / SUM(IF [is_sent] AND [is_picker_sequence_complete_and_valid] THEN [Calculation_2905947710943956992] ELSE 0 END)) &#13;&#10;&#13;&#10;        +(SUM(IF [is_sent] AND [is_picker_sequence_complete_and_valid] THEN [started_time_s] ELSE 0 END)&#13;&#10;        / SUM(IF [is_sent] AND [is_picker_sequence_complete_and_valid] THEN [Calculation_2905947710943956992] ELSE 0 END)) &#13;&#10;&#13;&#10;        +(SUM(IF [is_sent] AND [is_picker_sequence_complete_and_valid] THEN [picking_time_s] ELSE 0 END)&#13;&#10;        / SUM(IF [is_sent] AND [is_picker_sequence_complete_and_valid] THEN [Calculation_2905947710943956992] ELSE 0 END)) &#13;&#10;&#13;&#10;        +(SUM(IF [is_sent] AND [is_picker_sequence_complete_and_valid] THEN [confirmed_checkout_time_s] ELSE 0 END)&#13;&#10;        / SUM(IF [is_sent] AND [is_picker_sequence_complete_and_valid] THEN [Calculation_2905947710943956992] ELSE 0 END)) &#13;&#10;&#13;&#10;        +(SUM(IF [is_sent] AND [is_picker_sequence_complete_and_valid] THEN [ready_to_pickup_time_s] ELSE 0 END)&#13;&#10;        / SUM(IF [is_sent] AND [is_picker_sequence_complete_and_valid] THEN [Calculation_2905947710943956992] ELSE 0 END)&#13;&#10;        ) &#13;&#10;&#13;&#10;        )/ IF [Parameters].[Parameter 1] = &quot;1&quot; THEN 1 ELSE 60 END&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;END' />
            </column>
            <column caption='Granularity Text' datatype='string' name='[Calculation_2580844109636452374]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [granularity]&#13;&#10;WHEN &quot;daily&quot; THEN &quot;Day&quot;&#13;&#10;WHEN &quot;weekly&quot; THEN &quot;Week&quot;&#13;&#10;WHEN &quot;monthly&quot; THEN &quot;Month&quot;&#13;&#10;WHEN &quot;quarterly&quot; THEN &quot;Quarter&quot;&#13;&#10;END' />
            </column>
            <column caption='Entity' datatype='string' name='[Calculation_2580844109639041047]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF LOWER([country]) = &quot;turkey&quot; THEN &quot;Yemeksepeti&quot; ELSE [management_entity] END' />
            </column>
            <column caption='# of Periods to Show Filter' datatype='boolean' name='[Calculation_2721581600030965763]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF INT([period_num]) &lt;= [Parameters].[Parameter 4] THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='granularity Filter' datatype='boolean' name='[Calculation_2721581600409817092]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [granularity] WHEN &quot;weekday&quot; THEN FALSE ELSE TRUE END' />
            </column>
            <column caption='Pelican Items' datatype='real' name='[Calculation_2905947710943956992]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[in_cart_pelican_items] + [not_found_pelican_items] + [replaced_pelican_items] + [replacements_pelican_items] + [not_processed_pelican_items]' />
            </column>
            <column caption='Picking App' datatype='string' name='[Calculation_2934095208520331270]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF LOWER([vendor_app]) = &quot;pelican&quot; AND [integration_type] = &quot;POS_DIRECT_INTEGRATED&quot; THEN &quot;Direct POS&quot;&#13;&#10;ELSEIF LOWER([vendor_app]) = &quot;pelican&quot; AND [integration_type] = &quot;POS_INDIRECT_INTEGRATED&quot; THEN &quot;Pelican - Indirect Pos&quot;&#13;&#10;ELSEIF LOWER([vendor_app]) = &quot;pelican&quot; THEN &quot;Pelican&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='Average Orders per Day' datatype='real' name='[Calculation_2934095208532836359]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([confirmed_orders])/MAX([num_of_days])' />
            </column>
            <column caption='More than x Order Filter' datatype='boolean' name='[Calculation_2934095208539262984]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;ROUND({ FIXED [Calculation_2580844109258727425], [Calculation_2934095208553451529] : [Calculation_2934095208532836359]}, 0)&#13;&#10;&gt;= [Parameters].[Parameter 7] THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Vendor Name' datatype='string' name='[Calculation_2934095208553451529]' role='dimension' type='nominal'>
