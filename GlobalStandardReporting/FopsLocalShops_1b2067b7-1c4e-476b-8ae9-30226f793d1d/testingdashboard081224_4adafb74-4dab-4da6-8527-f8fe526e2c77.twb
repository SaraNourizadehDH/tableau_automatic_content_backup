                <alias key='&quot;weekly&quot;' value='Weekly' />
              </aliases>
            </column>
            <column alias='Minutes' caption='Unit' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;2&quot;'>
              <calculation class='tableau' formula='&quot;2&quot;' />
