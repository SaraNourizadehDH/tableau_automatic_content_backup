            <column alias='None' caption='Granularity' datatype='string' name='[Parameter 10]' param-domain-type='list' role='measure' type='nominal' value='&quot;none&quot;'>
              <calculation class='tableau' formula='&quot;none&quot;' />
              <aliases>
                <alias key='&quot;daily&quot;' value='Daily' />
                <alias key='&quot;monthly&quot;' value='Monthly' />
                <alias key='&quot;none&quot;' value='None' />
