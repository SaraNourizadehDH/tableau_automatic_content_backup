            <value>&quot;4 - Thursday&quot;</value>
            <value>&quot;5 - Friday&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Weekends&quot;'>
            <value>&quot;6 - Saturday&quot;</value>
            <value>&quot;7 - Sunday&quot;</value>
          </bin>
        </calculation>
