            <column caption='Rider Reaction Time' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Checkout Time (copy)_2580844109316952073]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [is_sent] AND [is_driver_sequence_complete_and_valid] THEN [rider_reaction_time_s] ELSE 0 END)&#13;&#10;/ SUM(IF [is_sent] AND [is_driver_sequence_complete_and_valid] THEN [total_orders] ELSE 0 END)) &#13;&#10;/ IF [Parameters].[Parameter 1] = &quot;1&quot; THEN 1 ELSE 60 END' />
