      <aliases enabled='yes' />
      <column caption='# of Items Sold for a Higher Price' datatype='real' name='[# Diff Paid - Listed (copy)_1581185724710268935]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [unit_price_paid_eur] &lt; [unit_price_listed_eur] THEN [item_qty_sold] ELSE 0 END)' />
      </column>
      <column caption='$ Items Sold for a Lower Price - Annually Estimation' datatype='real' name='[$ GMV loss (Sold Price - Listed Price) - Annually Estimation (copy)_3223240373550047238]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF DATETRUNC(&apos;month&apos;,[local_date]) = [Calculation_806496222168924160] THEN IF [unit_price_paid_eur] &lt; [unit_price_listed_eur] THEN [item_qty_sold] END ELSE 0 END) / AVG([Calculation_3223240373537955841])) * 365' />
      </column>
      <column caption='# of Order loss - Annually Estimation' datatype='real' name='[$ Items Sold for a Lower Price - Annually Estimation (copy)_3223240373577158663]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(((SUM(IF DATETRUNC(&apos;month&apos;,[local_date]) = [Calculation_806496222168924160] THEN [unit_price_paid_eur]-[unit_price_listed_eur] ELSE 0 END)&#10;  / AVG(IF DATETRUNC(&apos;month&apos;,[local_date]) = [Calculation_806496222168924160] THEN [gmv_net_eur] ELSE NULL END)) * -1) &#10;/ AVG([Calculation_3223240373537955841])) * 365&#10;&#10;//([# Diff Paid - Listed] / AVG({FIXED [Order Id]: AVG([Gmv Net Eur])})) * -1&#10;&#10;//[# Diff Paid - Listed] / (SUM([Gmv Net Eur per Order]) * -1)&#10;//(SUM(IF DATETRUNC(&apos;month&apos;,[Local Date]) = [Last Month] THEN IF [Unit Price Paid Eur] &lt; [Unit Price Listed Eur] THEN [Item Qty Sold] END ELSE 0 END) / AVG([Month Days - Last Month])) * 365' />
      </column>
      <column caption='# Diff Paid - Listed' datatype='real' name='[Calculation_1581185724330418176]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([unit_price_paid_eur] - [unit_price_listed_eur])' />
      </column>
      <column caption='% GMV Loss for Price Diff' datatype='real' default-format='p0.00%' name='[Calculation_1581185724340785154]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1581185724330418176] / SUM(IF [order_line] = 1 THEN [gmv_net_eur] ELSE 0 END)' />
      </column>
      <column caption='Gmv Net Eur per Order' datatype='real' name='[Calculation_1581185724704407556]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED : AVG([gmv_net_eur])}' />
      </column>
      <column caption='# of orders loss' datatype='real' name='[Calculation_1581185724704997381]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1581185724330418176] / AVG([gmv_net_eur])) * -1' />
      </column>
      <column caption='% of Items Sold for a Higher Price' datatype='real' default-format='p0.0%' name='[Calculation_1581185724718637064]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[# Diff Paid - Listed (copy)_1581185724710268935] / SUM([item_qty_sold])' />
      </column>
      <column caption='Is Fresh' datatype='boolean' name='[Calculation_1581185724740993034]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_fresh_SKU] = TRUE THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='% of orders loss' datatype='real' default-format='p0.00%' name='[Calculation_1581185724751097869]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1581185724704997381] / COUNTD([order_id])' />
      </column>
      <column caption='Month Days - Last Month' datatype='integer' name='[Calculation_3223240373537955841]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Calculation_806496222168924160], [Last Month (copy)_3223240373540065283])' />
      </column>
      <column caption='Actual Month x' datatype='string' name='[Calculation_3223240373540331524]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(DATE([Last Month (copy)_3223240373540065283]))' />
      </column>
      <column caption='Sold Price is lower or higher' datatype='string' name='[Calculation_695735818824224768]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [unit_price_paid_eur] - [unit_price_listed_eur] &lt;= 0 THEN &apos;Sold price is lower or equal&apos; ELSE &apos;Sold price is higher&apos; END' />
      </column>
      <column caption='Last Month' datatype='datetime' name='[Calculation_806496222168924160]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{MAX(IF DATEADD(&apos;month&apos;,0,DATETRUNC(&apos;month&apos;, [local_date])) &lt; {MAX(DATETRUNC(&apos;month&apos;, [local_date]))} THEN DATETRUNC(&apos;month&apos;, [local_date]) END)}' />
      </column>
      <column caption='$ GMV loss (Sold Price - Listed Price) - Annually Estimation' datatype='real' name='[Calculation_806496222170390529]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF DATETRUNC(&apos;month&apos;,[local_date]) = [Calculation_806496222168924160] THEN [unit_price_paid_eur] - [unit_price_listed_eur] ELSE 0 END) / AVG([Calculation_3223240373537955841])) * 365' />
      </column>
      <column caption='Actual Month' datatype='datetime' name='[Last Month (copy)_3223240373540065283]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{MAX(IF DATEADD(&apos;month&apos;,0,DATETRUNC(&apos;month&apos;, [local_date])) = {MAX(DATETRUNC(&apos;month&apos;, [local_date]))} THEN DATETRUNC(&apos;month&apos;, [local_date]) END)}' />
      </column>
