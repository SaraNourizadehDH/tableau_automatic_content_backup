    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='SFTP Jobs Overview'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/SFTPDashboardv2indevelopment/SFTPJobsOverview?rev=' id='SFTPJobsOverview' path='/t/GlobalStandardReporting/workbooks/inprocessLS-Operations-FulfilmentOperations-SFTPDashboard' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='parameter-ctrl-title'>
          <format attr='text-align' value='center' />
        </style-rule>
