              <calculation class='tableau' formula='ZN(((&#10;    SUM(&#10;        IF [period_num] = [Parameters].[Parameter 5] THEN&#10;            IF [Parameters].[Parameter 8] THEN [sftp_campaign_total_product_impacted_active]&#10;            ELSE [sftp_campaign_total_product_impacted] END&#10;            ELSE 0&#10;        END&#10;    )/&#10;    SUM(&#10;        IF [period_num] = [Parameters].[Parameter 5] THEN&#10;            IF [Parameters].[Parameter 8] THEN [sftp_campaign_counting_active] &#10;            ELSE [sftp_campaign_counting_total] END&#10;            ELSE 0&#10;        END&#10;    )&#10;    )/(&#10;    SUM(&#10;        IF [period_num] = [Parameters].[Cards Period 1 (copy)_1278529740053532683] THEN&#10;            IF [Parameters].[Parameter 8] THEN [sftp_campaign_total_product_impacted_active]&#10;            ELSE [sftp_campaign_total_product_impacted] END&#10;            ELSE 0&#10;        END&#10;    )/&#10;    SUM(&#10;        IF [period_num] = [Parameters].[Cards Period 1 (copy)_1278529740053532683] THEN&#10;            IF [Parameters].[Parameter 8] THEN [sftp_campaign_counting_active] &#10;            ELSE [sftp_campaign_counting_total] END&#10;            ELSE 0&#10;        END&#10;    )&#10;)) -1 )' />
            </column>
            <column caption='# Impacted Products pc - Diff Icon (promo card)' datatype='string' default-format='p0.0%' name='[# Impacted Products - Diff Icon (promo card) (copy)_169799810278121496]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [# Impacted Products - Diff (promo card) (copy)_169799810278121495] &gt; 0 THEN &quot;▲&quot; &#10;ELSEIF [# Impacted Products - Diff (promo card) (copy)_169799810278121495] &lt; 0 THEN &quot;▼&quot; &#10;ELSE &quot;●&quot;&#10;END' />
