        <zone forceUpdate='true' h='4500' id='337' type-v2='text' w='36765' x='735' y='750'>
          <formatted-text>
            <run bold='true' fontcolor='#476fa2' fontname='Tableau Bold' fontsize='36'>SFTP Jobs Dashboard</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#df4850' fontsize='12'>Chain &amp; Vendor Performance Analytics View</run>
          </formatted-text>
        </zone>
        <zone forceUpdate='true' h='8600' hidden-by-user='true' id='556' type-v2='text' w='29412' x='11250' y='12600'>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='16'>How to read this chart?</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='10'>Each entity is represented by a bar divided into three sections. The percentage of each section represents the proportion of vendors within that entity exhibiting an Underperforming, Neutral, or Overperforming performance in the SFTP Score.</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontsize='8' italic='true'>Note: For a detailed explanation of the &apos;SFTP Score&apos; and how it is calculated, you can click on the icon located in the top right corner of this dashboard. </run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='solid' />
            <format attr='border-width' value='1' />
            <format attr='background-color' value='#ffffff' />
          </zone-style>
        </zone>
        <zone h='1500' id='557' type-v2='dashboard-object' w='2206' x='24926' y='10450'>
