    <worksheet name='Score - Vendor Promo'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Tableau Bold' fontsize='14'>By Vendor</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='fulfilment_ops_ls_sftp_dashboard_main_view' name='federated.15w313a16lxy7n1dyvkx90hmistu' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Yes' caption='Do you want to see the actual (last) period' datatype='boolean' name='[How many periods do you want to see (copy)]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
              <aliases>
                <alias key='false' value='No' />
                <alias key='true' value='Yes' />
              </aliases>
            </column>
            <column alias='# of Campaigns' caption='Metrics Cards Promo' datatype='string' name='[Metrics Cards (copy)_169799810299666470]' param-domain-type='list' role='measure' type='nominal' value='&quot;12&quot;'>
              <calculation class='tableau' formula='&quot;12&quot;' />
              <aliases>
                <alias key='&quot;11&quot;' value='$ GMV' />
                <alias key='&quot;12&quot;' value='# of Campaigns' />
                <alias key='&quot;13&quot;' value='Avg. # of Updates per Campaign' />
                <alias key='&quot;14&quot;' value='# of Promoted Products' />
                <alias key='&quot;15&quot;' value='Avg. # of Promoted Products per Campaign' />
                <alias key='&quot;16&quot;' value='# of Promoted Products / Vendor Assortment' />
                <alias key='&quot;17&quot;' value='% Vendors using Promotions' />
              </aliases>
            </column>
            <column caption='Vendor IDs Filter' datatype='string' name='[Parameter 1]' param-domain-type='any' role='measure' type='nominal' value='&quot;&quot;'>
              <calculation class='tableau' formula='&quot;&quot;' />
            </column>
            <column alias='In' caption='In / Out' datatype='boolean' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
              <aliases>
                <alias key='false' value='Out' />
                <alias key='true' value='In' />
              </aliases>
            </column>
            <column caption='Cards Period 1' datatype='integer' name='[Parameter 5]' param-domain-type='any' role='measure' type='quantitative' value='2'>
              <calculation class='tableau' formula='2' />
            </column>
            <column caption='Only Active Campaigns' datatype='boolean' name='[Parameter 8]' param-domain-type='list' role='measure' type='nominal' value='false'>
              <calculation class='tableau' formula='false' />
            </column>
            <column caption='How many periods do you want to see' datatype='integer' name='[Replaced Pelican Items Parameter]' param-domain-type='any' role='measure' type='quantitative' value='7'>
              <calculation class='tableau' formula='7' />
            </column>
            <column caption='Chain IDs Filter' datatype='string' name='[Vendors List to Filter (copy)_3194529905697562660]' param-domain-type='any' role='measure' type='nominal' value='&quot;&quot;'>
              <calculation class='tableau' formula='&quot;&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.15w313a16lxy7n1dyvkx90hmistu'>
            <column caption='# Campaigns' datatype='integer' default-format='n#,##0,.0K;-#,##0,.0K' name='[# Campaigns - (promo card) (copy)_169799810287341601]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Parameters].[Parameter 8] THEN [sftp_campaign_counting_active] &#10;ELSE [sftp_campaign_counting_total] END)' />
            </column>
            <column caption='# Campaigns Updates' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[# Campaigns Updates - (promo card) (copy)_169799810287661090]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;    IF [Parameters].[Parameter 8] THEN [sftp_campaign_total_num_of_updates_active]&#10;    ELSE [sftp_campaign_total_num_of_updates] END&#10;) / &#10;SUM(&#10;    IF [Parameters].[Parameter 8] THEN [sftp_campaign_counting_active]&#10;    ELSE [sftp_campaign_counting_total] END&#10;)' />
            </column>
            <column caption='# Impacted Products' datatype='integer' default-format='n#,##0,,.00M;-#,##0,,.00M' name='[# Impacted Products - (promo card) (copy)_169799810287927331]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Parameters].[Parameter 8] THEN [sftp_campaign_total_product_impacted_active]&#10;ELSE [sftp_campaign_total_product_impacted] END)' />
            </column>
            <column caption='# Impacted Products pc' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[# Impacted Products pc - (promo card) (copy)_169799810288123940]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;    IF [Parameters].[Parameter 8] THEN [sftp_campaign_total_product_impacted_active]&#10;    ELSE [sftp_campaign_total_product_impacted] END&#10;)/&#10;SUM(&#10;    IF [Parameters].[Parameter 8] THEN [sftp_campaign_counting_active] &#10;    ELSE [sftp_campaign_counting_total] END&#10;)' />
            </column>
            <column caption='% Vendors using Promo' datatype='real' default-format='p0.00%' name='[% SFTP Vendors (copy)_169799810306056231]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;IF [gmv_net_eur] &gt; 0 AND [has_sftp_promotions_updates] THEN&#10;    [vendor_id]&#10;    ELSE NULL&#10;END&#10;) / &#10;COUNTD(&#10;IF [gmv_net_eur] &gt; 0 THEN&#10;    [vendor_id]&#10;    ELSE NULL&#10;END&#10;)' />
            </column>
            <column caption='% of Catalog Impacted by Promo' datatype='real' default-format='p0.0%' name='[% of Catalog Impacted by Promo - (promo card) (copy)_169799810288476197]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;    IF [Parameters].[Parameter 8] THEN [sftp_campaign_total_product_impacted_active]&#10;    ELSE [sftp_campaign_total_product_impacted] END&#10;)/&#10;SUM(&#10;    IF [Parameters].[Parameter 8] THEN [vendor_assortment_total]&#10;    ELSE [vendor_assortment_total] END&#10;)' />
            </column>
            <column caption='ATTR([Period Num]) + 1' datatype='integer' name='[Calculation_1278529740278988852]' role='measure' type='quantitative' user:unnamed='Score - Date'>
              <calculation class='tableau' formula='ATTR([period_num]) + 1' />
            </column>
            <column caption='Local Date ' datatype='string' name='[Calculation_1860831094529859592]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [granularity]&#10;    WHEN &apos;weekly&apos; THEN STR(DATE(DATETRUNC(&apos;week&apos;,[local_date], &apos;monday&apos;)))&#10;    WHEN &apos;monthly&apos; THEN STR(DATE(DATETRUNC(&apos;month&apos;,[local_date])))&#10;    WHEN &apos;quarterly&apos; THEN STR(DATE(DATETRUNC(&apos;quarter&apos;,[local_date])))&#10;END' />
            </column>
            <column caption='Period Filter' datatype='boolean' name='[Calculation_1860831095232335902]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [period_num] &lt;= [Parameters].[Replaced Pelican Items Parameter] + 1 &#10;THEN &#10;    IF [Parameters].[How many periods do you want to see (copy)] &#10;    THEN &#10;        IF [period_num] &lt;= [Parameters].[Replaced Pelican Items Parameter] &#10;        THEN TRUE &#10;        ELSE FALSE &#10;        END &#10;    ELSE &#10;        IF [period_num] &gt; 1 &#10;        THEN TRUE &#10;        ELSE FALSE &#10;        END&#10;    END &#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='Vendor Name + id' datatype='string' name='[Calculation_3194529904736956426]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[vendor_id] + &quot; - &quot; +[vendor_name]' />
            </column>
            <column caption='SFTP Type' datatype='string' name='[Calculation_3194529905058963481]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [sftp_type_is_central] THEN &apos;Central SFTP&apos; ELSEIF [sftp_type_is_legacy] THEN &apos;Legacy SFTP&apos; ELSE &apos;Non SFTP&apos; END' />
            </column>
            <column caption='Vendors List to Filter Calc' datatype='boolean' name='[Calculation_3194529905693958179]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] THEN&#10;    IF [Parameters].[Parameter 1] != &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Parameter 1], [vendor_id]) THEN TRUE ELSE FALSE END&#10;        ELSE TRUE&#10;    END&#10;ELSE&#10;    IF [Parameters].[Parameter 1] != &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Parameter 1], [vendor_id]) THEN FALSE ELSE TRUE END&#10;        ELSE TRUE&#10;    END&#10;END' />
            </column>
            <column caption='Chain Name + id' datatype='string' name='[Calculation_3194529905745088555]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[chain_id] + &quot; - &quot; + [chain_name]' />
            </column>
            <column caption='Has SFTP Promotions Updates (card)' datatype='boolean' name='[Has Complete Jobs to Update Stock (card) (copy)_169799810311102510]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Metrics Cards (copy)_169799810299666470] = &apos;17&apos; THEN TRUE &#10;ELSEIF [sftp_campaign_total_num_of_updates] &gt;= 1 THEN TRUE &#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='Metrics Cards Promo (Symbol)' datatype='string' default-format='n#,##0.00;-#,##0.00' name='[Metrics Cards (Symbol) (copy)_169799810286444576]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Metrics Cards (copy)_169799810299666470]&#10;    WHEN &apos;11&apos; THEN &quot;k&quot;&#10;    WHEN &apos;12&apos; THEN &quot;k&quot;&#10;    WHEN &apos;13&apos; THEN &quot;&quot;&#10;    WHEN &apos;14&apos; THEN &quot;k&quot;&#10;    WHEN &apos;15&apos; THEN &quot;&quot;&#10;    WHEN &apos;16&apos; THEN &quot;%&quot;&#10;    WHEN &apos;17&apos; THEN &quot;%&quot;&#10;    WHEN &apos;18&apos; THEN &quot;&quot;&#10;END' />
            </column>
            <column caption='Metrics Cards Promo' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Metrics Cards (copy)_169799810286411807]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Metrics Cards (copy)_169799810299666470]&#10;    WHEN &apos;11&apos; THEN ROUND(SUM([gmv_net_eur]) / 1000, 2)&#10;    WHEN &apos;12&apos; THEN [# Campaigns - (promo card) (copy)_169799810287341601] / 1000&#10;    WHEN &apos;13&apos; THEN [# Campaigns Updates - (promo card) (copy)_169799810287661090]&#10;    WHEN &apos;14&apos; THEN [# Impacted Products - (promo card) (copy)_169799810287927331] / 1000 &#10;    WHEN &apos;15&apos; THEN [# Impacted Products pc - (promo card) (copy)_169799810288123940]&#10;    WHEN &apos;16&apos; THEN [% of Catalog Impacted by Promo - (promo card) (copy)_169799810288476197] * 100&#10;    WHEN &apos;17&apos; THEN [% SFTP Vendors (copy)_169799810306056231] * 100&#10;END' />
            </column>
            <column caption='Selected Period Promo' datatype='boolean' name='[Selected Period (copy)_169799810280292378]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = MAX([period_num]) THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Chain List to Filter Calc' datatype='boolean' name='[Vendors List to Filter Calc (copy)_3194529905697677349]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] THEN&#10;    IF [Parameters].[Vendors List to Filter (copy)_3194529905697562660] != &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Vendors List to Filter (copy)_3194529905697562660], [chain_id]) THEN TRUE ELSE FALSE END&#10;        ELSE TRUE&#10;    END&#10;ELSE&#10;    IF [Parameters].[Vendors List to Filter (copy)_3194529905697562660] != &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Vendors List to Filter (copy)_3194529905697562660], [chain_id]) THEN FALSE ELSE TRUE END&#10;        ELSE TRUE&#10;    END&#10;END' />
            </column>
            <column-instance column='[period_num]' derivation='Attribute' name='[attr:period_num:qk]' pivot='key' type='quantitative' />
            <column caption='Chain Id' datatype='string' name='[chain_id]' role='dimension' type='nominal' />
            <column caption='Chain Name' datatype='string' name='[chain_name]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
