                  <formatted-text>
                    <run bold='true' fontalignment='1' fontcolor='#333333' fontsize='10'>% SFTP</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run bold='true' fontalignment='1' fontcolor='#333333' fontsize='10'>Vendors</run>
                    <run fontalignment='1'>Æ&#10;</run>
