                <zone h='2500' id='359' mode='checkdropdown' name='Avg. Num of Updates' param='[federated.15w313a16lxy7n1dyvkx90hmistu].[none:Calculation_3194529905058963481:nk]' type-v2='filter' values='database' w='8309' x='8676' y='6250'>
