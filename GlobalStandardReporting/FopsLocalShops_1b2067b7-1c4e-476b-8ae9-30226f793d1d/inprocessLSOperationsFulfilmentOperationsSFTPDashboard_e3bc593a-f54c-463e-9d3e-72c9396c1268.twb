    </worksheet>
    <worksheet name='Score by Country'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Light' fontsize='14'>SFTP Jobs Score </run>
            <run bold='true' fontname='Tableau Bold' fontsize='14'>by Country</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='fulfilment_ops_ls_sftp_dashboard_main_view' name='federated.15w313a16lxy7n1dyvkx90hmistu' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Vendor IDs Filter' datatype='string' name='[Parameter 1]' param-domain-type='any' role='measure' type='nominal' value='&quot;&quot;'>
              <calculation class='tableau' formula='&quot;&quot;' />
            </column>
            <column alias='In' caption='In / Out' datatype='boolean' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
              <aliases>
                <alias key='false' value='Out' />
                <alias key='true' value='In' />
              </aliases>
            </column>
            <column caption='Chain IDs Filter' datatype='string' name='[Vendors List to Filter (copy)_3194529905697562660]' param-domain-type='any' role='measure' type='nominal' value='&quot;&quot;'>
              <calculation class='tableau' formula='&quot;&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.15w313a16lxy7n1dyvkx90hmistu'>
            <column caption='% Not Found Rate / Items Not Delivered GMV Loss' datatype='real' default-format='p0.00%' name='[$ Not Found Rate / Items Not Delivered GMV Loss (copy)_3194529905392672801]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([confirmed_orders_pelican]) &gt; 0 THEN &#10;    SUM(&#10;        ([in_cart_pelican_total_price_eur] - [in_cart_pelican_total_price_eur_sold])     &#10;        + [not_found_pelican_total_price_eur]&#10;        + ([replaced_pelican_total_price_eur] - [replaced_pelican_total_price_eur_sold] - [replacements_pelican_total_price_eur])&#10;        + [oos_failed_pelican_orders_items_price_eur]&#10;    ) / &#10;    SUM(&#10;        [gmv_net_eur]&#10;    )&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='$ Not Found Rate / Items Not Delivered GMV Loss' datatype='real' default-format='c#,##0,.0K&quot; €&quot;;-#,##0,.0K&quot; €&quot;' name='[% Not Found Rate / Items Not Delivered (copy)_3194529905381822494]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;    ([in_cart_pelican_total_price_eur] - [in_cart_pelican_total_price_eur_sold])     &#10;    + [not_found_pelican_total_price_eur]&#10;    + ([replaced_pelican_total_price_eur] - [replaced_pelican_total_price_eur_sold] - [replacements_pelican_total_price_eur])&#10;    + [oos_failed_pelican_orders_items_price_eur]&#10;)' />
            </column>
            <column caption='Avg GMV per Vendor (Score Group)' datatype='real' default-format='c#,##0,.0K&quot; €&quot;;-#,##0,.0K&quot; €&quot;' name='[Avg Confirmed Orders per Vendor (copy)_3194529905720688679]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_net_eur]) / [Calculation_3194529904780869646]' />
            </column>
            <column caption='Every how many days Vendors update their stock' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;IF [gmv_net_eur] &gt; 0 AND [every_how_many_days_vendors_update_their_stock] &gt; 0 THEN&#10;    [every_how_many_days_vendors_update_their_stock] * [gmv_net_eur]&#10;    ELSE NULL&#10;END&#10;) / &#10;SUM(&#10;IF [gmv_net_eur] &gt; 0 AND [every_how_many_days_vendors_update_their_stock] &gt; 0 THEN&#10;   [gmv_net_eur]&#10;    ELSE NULL&#10;END&#10;)' />
            </column>
            <column caption='Entity or Country' datatype='string' name='[Calculation_115897350132613120]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF {FIXED : COUNTD([entity])} &gt; 1 THEN [entity] ELSE country END' />
            </column>
            <column caption='Avg. num. of Updates per Day' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1860831095256268831]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;IF [gmv_net_eur] &gt; 0 AND [avg_number_of_updates_per_day] &gt; 0 THEN&#10;    [avg_number_of_updates_per_day] * [gmv_net_eur]&#10;    ELSE NULL&#10;END&#10;) / &#10;SUM(&#10;IF [gmv_net_eur] &gt; 0 AND [avg_number_of_updates_per_day] &gt; 0 THEN&#10;   [gmv_net_eur]&#10;    ELSE NULL&#10;END&#10;)' />
            </column>
            <column caption='Ratio # updates items vs total assortment' datatype='real' default-format='p0.0%' name='[Calculation_1860831095615938598]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_items_vs_total_assortment] &gt; 0 THEN&#10;    [ratio_num_updates_items_vs_total_assortment] * [gmv_net_eur]&#10;    ELSE NULL&#10;END&#10;) / &#10;SUM(&#10;IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_items_vs_total_assortment] &gt; 0 THEN&#10;   [gmv_net_eur]&#10;    ELSE NULL&#10;END&#10;)' />
            </column>
            <column caption='% Not Found Rate / Items Not Delivered' datatype='real' default-format='p0.00%' name='[Calculation_1860831095894679597]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([confirmed_orders_pelican]) &gt; 0 THEN&#10;SUM(&#10;    ([in_cart_pelican_items] - [in_cart_pelican_items_sold])     &#10;    + [not_found_pelican_items] &#10;    + ([replaced_pelican_items] - [replaced_pelican_items_sold] - [replacements_pelican_items])&#10;    + [oos_failed_pelican_items]&#10;) / &#10;SUM(&#10;    [in_cart_pelican_items]&#10;    + [not_found_pelican_items] &#10;    + [not_processed_pelican_items] &#10;    + [replaced_pelican_items]&#10;    + [replacements_pelican_items]&#10;    + [oos_failed_pelican_items]&#10;)&#10;ELSE NULL END' />
            </column>
            <column caption='SFTP Score Group' datatype='string' name='[Calculation_1860831096295628849]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Score (copy)_3194529904769355787] &lt; 50 THEN &apos;Underperforming&apos; ELSEIF [Score (copy)_3194529904769355787] &gt; 74.99 THEN &apos;Overperforming&apos; ELSE &apos;Neutral&apos; END' />
            </column>
            <column caption='Vendor Name + id' datatype='string' name='[Calculation_3194529904736956426]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[vendor_id] + &quot; - &quot; +[vendor_name]' />
            </column>
            <column caption='SFTP Score Group Count' datatype='integer' name='[Calculation_3194529904780869646]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([sftp_score_group])' />
            </column>
            <column caption='SFTP Type' datatype='string' name='[Calculation_3194529905058963481]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [sftp_type_is_central] THEN &apos;Central SFTP&apos; ELSEIF [sftp_type_is_legacy] THEN &apos;Legacy SFTP&apos; ELSE &apos;Non SFTP&apos; END' />
            </column>
            <column caption='% GMV Loss Due to OOS Failed Orders' datatype='real' default-format='p0.00%' name='[Calculation_3194529905401241634]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([oos_failed_pelican_orders_items_price_eur]) / SUM([gmv_net_eur])' />
            </column>
            <column caption='Vendors List to Filter Calc' datatype='boolean' name='[Calculation_3194529905693958179]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] THEN&#10;    IF [Parameters].[Parameter 1] != &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Parameter 1], [vendor_id]) THEN TRUE ELSE FALSE END&#10;        ELSE TRUE&#10;    END&#10;ELSE&#10;    IF [Parameters].[Parameter 1] != &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Parameter 1], [vendor_id]) THEN FALSE ELSE TRUE END&#10;        ELSE TRUE&#10;    END&#10;END' />
            </column>
            <column caption='Chain Name + id' datatype='string' name='[Calculation_3194529905745088555]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[chain_id] + &quot; - &quot; + [chain_name]' />
            </column>
            <column caption='Filter Outliers (cv performance)' datatype='boolean' name='[Filter Outliers (copy)_161707402996469765]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [granularity]&#10;    &#10;    WHEN &apos;weekly&apos; THEN&#10;&#10;        IF [confirmed_orders] &gt; 1 THEN&#10;            IF [nr_jobs_updated_product_completed] &lt;= 3  THEN&#10;                IF [gmv_net_eur] / [nr_jobs_updated_product_completed] &lt; 100 THEN TRUE ELSE FALSE END&#10;            ELSE TRUE END&#10;        ELSE TRUE END&#10;&#10;    WHEN &apos;monthly&apos; THEN&#10;&#10;        IF [confirmed_orders] &gt; 1 THEN&#10;            IF [nr_jobs_updated_product_completed] &lt;= 15  THEN&#10;                IF [gmv_net_eur] / [nr_jobs_updated_product_completed] &lt; 700 THEN TRUE ELSE FALSE END&#10;            ELSE TRUE END&#10;        ELSE TRUE END&#10;&#10;    WHEN &apos;quarterly&apos; THEN&#10;&#10;        IF [confirmed_orders] &gt; 1 THEN&#10;            IF [nr_jobs_updated_product_completed] &lt;= 30  THEN&#10;                IF [gmv_net_eur] / [nr_jobs_updated_product_completed] &lt; 1400 THEN TRUE ELSE FALSE END&#10;            ELSE TRUE END&#10;        ELSE TRUE END&#10;&#10;END' />
            </column>
            <column caption='Has Complete Jobs to Update Stock (cv performance)' datatype='boolean' name='[Has Complete Jobs to Update Stock (copy)_161707402996539398]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [nr_jobs_updated_product_completed] &gt;= 1 THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Local Date  ' datatype='datetime' default-format='*dd/mm/yy' name='[Local Date  (copy)_3194529904708677634]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [granularity]&#10;WHEN &apos;weekly&apos; THEN DATETRUNC(&apos;week&apos;, [local_date], &apos;monday&apos;)&#10;WHEN &apos;monthly&apos; THEN DATETRUNC(&apos;month&apos;, [local_date])&#10;WHEN &apos;quarterly&apos; THEN DATETRUNC(&apos;quarter&apos;, [local_date])&#10;END' />
            </column>
            <column caption='SFTP Score ' datatype='real' default-format='n#,##0;-#,##0' name='[Score (copy)_3194529904769355787]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [has_sftp_jobs] THEN [sftp_score] * [gmv_net_eur] ELSE NULL END))&#10;/ SUM(IF [has_sftp_jobs] THEN [gmv_net_eur] ELSE NULL END)' />
            </column>
            <column caption='SFTP Score Group (dark)' datatype='string' name='[Score Description (copy)_3194529905026936855]' role='measure' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1860831096295628849]' />
            </column>
            <column caption='Chain List to Filter Calc' datatype='boolean' name='[Vendors List to Filter Calc (copy)_3194529905697677349]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] THEN&#10;    IF [Parameters].[Vendors List to Filter (copy)_3194529905697562660] != &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Vendors List to Filter (copy)_3194529905697562660], [chain_id]) THEN TRUE ELSE FALSE END&#10;        ELSE TRUE&#10;    END&#10;ELSE&#10;    IF [Parameters].[Vendors List to Filter (copy)_3194529905697562660] != &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Vendors List to Filter (copy)_3194529905697562660], [chain_id]) THEN FALSE ELSE TRUE END&#10;        ELSE TRUE&#10;    END&#10;END' />
            </column>
            <column caption='Account Manager' datatype='string' name='[account_manager]' role='dimension' type='nominal' />
            <column caption='Avg. num. of Updates per Day _' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[avg_number_of_updates_per_day]' role='measure' type='quantitative' />
            <column caption='Chain Id' datatype='string' name='[chain_id]' role='dimension' type='nominal' />
            <column caption='Chain Name' datatype='string' name='[chain_name]' role='dimension' type='nominal' />
            <column caption='Confirmed Orders' datatype='integer' default-format='n#,##0;-#,##0' name='[confirmed_orders]' role='measure' type='quantitative' />
            <column caption='Confirmed Orders Pelican' datatype='integer' name='[confirmed_orders_pelican]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Entity' datatype='string' name='[entity]' role='dimension' type='nominal' />
            <column caption='Every how many days Vendors update their stock _' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[every_how_many_days_vendors_update_their_stock]' role='measure' type='quantitative' />
            <column caption='Gmv Net Eur' datatype='real' default-format='c#,##0,.0K&quot; €&quot;;-#,##0,.0K&quot; €&quot;' name='[gmv_net_eur]' role='measure' type='quantitative' />
            <column caption='Granularity' datatype='string' name='[granularity]' role='dimension' type='nominal' />
            <column caption='Has Confirmed Orders' datatype='boolean' name='[has_confirmed_orders]' role='dimension' type='nominal' />
            <column caption='Has Sftp Jobs' datatype='boolean' name='[has_sftp_jobs]' role='dimension' type='nominal' />
            <column caption='In Cart Pelican Items' datatype='real' name='[in_cart_pelican_items]' role='measure' type='quantitative' />
            <column caption='In Cart Pelican Items Sold' datatype='real' name='[in_cart_pelican_items_sold]' role='measure' type='quantitative' />
            <column caption='In Cart Pelican Total Price Eur' datatype='real' name='[in_cart_pelican_total_price_eur]' role='measure' type='quantitative' />
            <column caption='In Cart Pelican Total Price Eur Sold' datatype='real' name='[in_cart_pelican_total_price_eur_sold]' role='measure' type='quantitative' />
            <column caption='Is AAA Supermarket' datatype='boolean' name='[is_aaa_supermarket]' role='dimension' type='nominal' />
            <column caption='Is AAA Vendor' datatype='boolean' name='[is_aaa_vendor]' role='dimension' type='nominal' />
            <column caption='Local Date' datatype='date' name='[local_date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_3194529905058963481]' derivation='None' name='[none:Calculation_3194529905058963481:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_3194529905693958179]' derivation='None' name='[none:Calculation_3194529905693958179:nk]' pivot='key' type='nominal' />
            <column-instance column='[Filter Outliers (copy)_161707402996469765]' derivation='None' name='[none:Filter Outliers (copy)_161707402996469765:nk]' pivot='key' type='nominal' />
            <column-instance column='[Has Complete Jobs to Update Stock (copy)_161707402996539398]' derivation='None' name='[none:Has Complete Jobs to Update Stock (copy)_161707402996539398:nk]' pivot='key' type='nominal' />
            <column-instance column='[Local Date  (copy)_3194529904708677634]' derivation='None' name='[none:Local Date  (copy)_3194529904708677634:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Vendors List to Filter Calc (copy)_3194529905697677349]' derivation='None' name='[none:Vendors List to Filter Calc (copy)_3194529905697677349:nk]' pivot='key' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column-instance column='[entity]' derivation='None' name='[none:entity:nk]' pivot='key' type='nominal' />
            <column-instance column='[granularity]' derivation='None' name='[none:granularity:nk]' pivot='key' type='nominal' />
            <column-instance column='[has_confirmed_orders]' derivation='None' name='[none:has_confirmed_orders:nk]' pivot='key' type='nominal' />
            <column-instance column='[is_aaa_supermarket]' derivation='None' name='[none:is_aaa_supermarket:nk]' pivot='key' type='nominal' />
            <column-instance column='[is_aaa_vendor]' derivation='None' name='[none:is_aaa_vendor:nk]' pivot='key' type='nominal' />
            <column-instance column='[picking_app]' derivation='None' name='[none:picking_app:nk]' pivot='key' type='nominal' />
            <column caption='Not Found Pelican Items' datatype='real' name='[not_found_pelican_items]' role='measure' type='quantitative' />
            <column caption='Not Found Pelican Total Price Eur' datatype='real' name='[not_found_pelican_total_price_eur]' role='measure' type='quantitative' />
            <column caption='Not Processed Pelican Items' datatype='real' name='[not_processed_pelican_items]' role='measure' type='quantitative' />
            <column caption='Nr Jobs Updated Product Completed' datatype='integer' default-format='n#,##0;-#,##0' name='[nr_jobs_updated_product_completed]' role='measure' type='quantitative' />
            <column caption='OOS Failed Items' datatype='real' name='[oos_failed_pelican_items]' role='measure' type='quantitative' />
            <column caption='OOS Failed GMV Loss' datatype='real' default-format='c#,##0,.0K&quot; €&quot;;-#,##0,.0K&quot; €&quot;' name='[oos_failed_pelican_orders_items_price_eur]' role='measure' type='quantitative' />
            <column-instance column='[gmv_net_eur]' derivation='Sum' name='[pcto:sum:gmv_net_eur:qk:2]' pivot='key' type='quantitative'>
