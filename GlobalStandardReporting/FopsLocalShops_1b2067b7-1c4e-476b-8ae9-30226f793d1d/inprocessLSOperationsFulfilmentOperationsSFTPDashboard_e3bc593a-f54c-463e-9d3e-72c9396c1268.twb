                <bin default-name='true' value='&quot;14 &amp; 15&quot;'>
                  <value>14</value>
                  <value>15</value>
                </bin>
                <bin default-name='true' value='&quot;16 &amp; 17&quot;'>
                  <value>16</value>
                  <value>17</value>
                </bin>
                <bin default-name='true' value='&quot;18 &amp; 19&quot;'>
                  <value>18</value>
                  <value>19</value>
                </bin>
                <bin default-name='true' value='&quot;2 &amp; 3&quot;'>
                  <value>2</value>
                  <value>3</value>
                </bin>
                <bin default-name='true' value='&quot;20 &amp; 21&quot;'>
                  <value>20</value>
                  <value>21</value>
                </bin>
                <bin default-name='true' value='&quot;22 &amp; 23&quot;'>
                  <value>22</value>
                  <value>23</value>
                </bin>
                <bin default-name='true' value='&quot;4 &amp; 5&quot;'>
                  <value>4</value>
                  <value>5</value>
                </bin>
                <bin default-name='true' value='&quot;6 &amp; 7&quot;'>
                  <value>6</value>
