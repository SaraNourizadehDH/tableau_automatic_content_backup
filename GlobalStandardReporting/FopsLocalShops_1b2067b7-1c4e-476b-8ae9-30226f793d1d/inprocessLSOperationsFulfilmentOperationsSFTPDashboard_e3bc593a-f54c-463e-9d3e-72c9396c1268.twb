      </column>
      <column caption='% of Catalog Impacted by Promo' datatype='real' default-format='p0.0%' name='[% of Catalog Impacted by Promo - (promo card) (copy)_169799810288476197]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [Parameters].[Parameter 8] THEN [sftp_campaign_total_product_impacted_active]&#10;    ELSE [sftp_campaign_total_product_impacted] END&#10;)/&#10;SUM(&#10;    IF [Parameters].[Parameter 8] THEN [vendor_assortment_total]&#10;    ELSE [vendor_assortment_total] END&#10;)' />
      </column>
      <column caption='% Vendors using Promo - (promo card)' datatype='real' default-format='p0.00%' name='[% of Catalog Impacted by Promo - (promo card) (copy)_169799810306232360]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;IF [gmv_net_eur] &gt; 0 AND [has_sftp_promotions_updates] AND [period_num] = [Parameters].[Parameter 5] THEN&#10;    [vendor_id]&#10;    ELSE NULL&#10;END&#10;) / &#10;COUNTD(&#10;IF [gmv_net_eur] &gt; 0 AND [period_num] = [Parameters].[Parameter 5] THEN&#10;    [vendor_id]&#10;    ELSE NULL&#10;END&#10;)' />
      </column>
      <column caption='% Vendors using Promo - Diff (promo card)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[% of Catalog Impacted by Promo - Diff (promo card) (copy)_169799810306232361]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(((&#10;    COUNTD(&#10;    IF [gmv_net_eur] &gt; 0 AND [has_sftp_promotions_updates] AND [period_num] = [Parameters].[Parameter 5] THEN&#10;        [vendor_id]&#10;        ELSE NULL&#10;    END&#10;    ) / &#10;    COUNTD(&#10;    IF [gmv_net_eur] &gt; 0 AND [period_num] = [Parameters].[Parameter 5] THEN&#10;        [vendor_id]&#10;        ELSE NULL&#10;    END&#10;    )&#10;    )-(&#10;    COUNTD(&#10;    IF [gmv_net_eur] &gt; 0 AND [has_sftp_promotions_updates] AND [period_num] = [Parameters].[Cards Period 1 (copy)_1278529740053532683] THEN&#10;        [vendor_id]&#10;        ELSE NULL&#10;    END&#10;    ) / &#10;    COUNTD(&#10;    IF [gmv_net_eur] &gt; 0 AND [period_num] = [Parameters].[Cards Period 1 (copy)_1278529740053532683] THEN&#10;        [vendor_id]&#10;        ELSE NULL&#10;    END&#10;    )&#10;)) * 100)' />
      </column>
      <column caption='% Vendors using Promo - Diff Icon (promo card)' datatype='string' default-format='p0.0%' name='[% of Catalog Impacted by Promo - Diff Icon (promo card) (copy)_169799810306232362]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [% of Catalog Impacted by Promo - Diff (promo card) (copy)_169799810306232361] &gt; 0 THEN &quot;▲&quot; &#10;ELSEIF [% of Catalog Impacted by Promo - Diff (promo card) (copy)_169799810306232361] &lt; 0 THEN &quot;▼&quot; &#10;ELSE &quot;●&quot;&#10;END' />
      </column>
      <column caption='% of Failed lines in CSV Files - No outliers' datatype='real' default-format='p0.0%' name='[% of Failed lines in CSV Files (copy)_1860831095863836715]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [nr_failed_count_completed] &gt; ([vendor_assortment_total] * 3) OR [nr_processed_products_completed] &gt; ([vendor_assortment_total] * 3) THEN&#10;NULL ELSE&#10;[nr_failed_count_completed]&#10;END)&#10;/ &#10;SUM(IF [nr_failed_count_completed] &gt; ([vendor_assortment_total] * 3) OR [nr_processed_products_completed] &gt; ([vendor_assortment_total] * 3) THEN&#10;NULL ELSE&#10;[nr_failed_count_completed] + [nr_processed_products_completed]&#10;END)' />
      </column>
      <column caption='% of Failed lines in CSV Files' datatype='real' default-format='p0.0%' name='[% of Stock Jobs that Failed (copy)_1860831095547813925]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nr_failed_count_completed]) / SUM([nr_failed_count_completed] + [nr_processed_products_completed])' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.15w313a16lxy7n1dyvkx90hmistu].[sum:confirmed_orders:qk]&quot;' value='# Confirmed Orders' />
          <alias key='&quot;[federated.15w313a16lxy7n1dyvkx90hmistu].[sum:gmv_net_eur:qk]&quot;' value='$ GMV' />
          <alias key='&quot;[federated.15w313a16lxy7n1dyvkx90hmistu].[sum:nr_changed_products_completed:qk]&quot;' value='Nr Updated Stock Products' />
          <alias key='&quot;[federated.15w313a16lxy7n1dyvkx90hmistu].[sum:nr_jobs_updated_product_completed:qk]&quot;' value='Nr Jobs to Update Stocks' />
          <alias key='&quot;[federated.15w313a16lxy7n1dyvkx90hmistu].[usr:Calculation_1860831094522793990:qk]&quot;' value='AVG products updated by job' />
        </aliases>
      </column>
      <column caption='Filter Outliers (adjusted)' datatype='boolean' name='[Adjust Has Complete Jobs to Update Stock (copy)_153052048043872258]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = &apos;8&apos; THEN &#10;CASE [granularity]&#10;    &#10;    WHEN &apos;weekly&apos; THEN&#10;&#10;        IF [confirmed_orders] &gt; 1 THEN&#10;            IF [nr_jobs_updated_product_completed] &lt;= 3  THEN&#10;                IF [gmv_net_eur] / [nr_jobs_updated_product_completed] &lt; 100 THEN TRUE ELSE FALSE END&#10;            ELSE TRUE END&#10;        ELSE TRUE END&#10;&#10;    WHEN &apos;monthly&apos; THEN&#10;&#10;        IF [confirmed_orders] &gt; 1 THEN&#10;            IF [nr_jobs_updated_product_completed] &lt;= 15  THEN&#10;                IF [gmv_net_eur] / [nr_jobs_updated_product_completed] &lt; 700 THEN TRUE ELSE FALSE END&#10;            ELSE TRUE END&#10;        ELSE TRUE END&#10;&#10;    WHEN &apos;quarterly&apos; THEN&#10;&#10;        IF [confirmed_orders] &gt; 1 THEN&#10;            IF [nr_jobs_updated_product_completed] &lt;= 30  THEN&#10;                IF [gmv_net_eur] / [nr_jobs_updated_product_completed] &lt; 1400 THEN TRUE ELSE FALSE END&#10;            ELSE TRUE END&#10;        ELSE TRUE END&#10;&#10;END&#10;ELSE TRUE&#10;END' />
      </column>
      <column caption='Avg GMV per Vendor (Score Group)' datatype='real' default-format='c#,##0,.0K&quot; €&quot;;-#,##0,.0K&quot; €&quot;' name='[Avg Confirmed Orders per Vendor (copy)_3194529905720688679]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gmv_net_eur]) / [Calculation_3194529904780869646]' />
      </column>
      <column caption='Ratio # updates items vs total assortment (card)' datatype='real' default-format='p0.00%' name='[Avg. num. of Updates per Day (card) (copy)_1278529740258992155]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_items_vs_total_assortment] &gt; 0 AND [period_num] = [Parameters].[Parameter 5]  THEN&#10;    [ratio_num_updates_items_vs_total_assortment] * [gmv_net_eur]&#10;    ELSE NULL&#10;END&#10;) / &#10;SUM(&#10;IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_items_vs_total_assortment] &gt; 0 AND [period_num] = [Parameters].[Parameter 5]  THEN&#10;   [gmv_net_eur]&#10;    ELSE NULL&#10;END&#10;)' />
      </column>
      <column caption='% Not Found Rate / Items Not Delivered (card)' datatype='real' default-format='p0.00%' name='[Avg. num. of Updates per Day (card) (copy)_1278529740259676190]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([confirmed_orders_pelican]) &gt; 0 THEN&#10;SUM(&#10;    IF [period_num] = [Parameters].[Parameter 5] THEN&#10;        ([in_cart_pelican_items] - [in_cart_pelican_items_sold])     &#10;        + [not_found_pelican_items] &#10;        + ([replaced_pelican_items] - [replaced_pelican_items_sold] - [replacements_pelican_items])&#10;        + [oos_failed_pelican_items]&#10;    ELSE NULL&#10;    END&#10;) / &#10;SUM(&#10;    IF [period_num] = [Parameters].[Parameter 5] THEN&#10;        [in_cart_pelican_items]&#10;        + [not_found_pelican_items] &#10;        + [not_processed_pelican_items] &#10;        + [replaced_pelican_items]&#10;        + [replacements_pelican_items]&#10;        + [oos_failed_pelican_items]&#10;    ELSE NULL&#10;    END&#10;)&#10;ELSE NULL END' />
      </column>
      <column caption='Avg. num. of Updates per Day (copy)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg. num. of Updates per Day (copy)_1278529740250648597]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([nr_jobs_updated_product_completed]) / [Calculation_1860831095266058273]) / [Calculation_1860831094933049357]' />
      </column>
      <column caption='Ratio # updates items vs total assortment - Diff (card)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg. num. of Updates per Day - Diff (card) (copy)_1278529740258992154]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(&#10;    (&#10;        SUM(&#10;        IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_items_vs_total_assortment] &gt; 0 AND [period_num] = [Parameters].[Parameter 5]  THEN&#10;            [ratio_num_updates_items_vs_total_assortment] * [gmv_net_eur]&#10;            ELSE NULL&#10;        END&#10;        ) / &#10;        SUM(&#10;        IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_items_vs_total_assortment] &gt; 0 AND [period_num] = [Parameters].[Parameter 5]  THEN&#10;           [gmv_net_eur]&#10;            ELSE NULL&#10;        END&#10;        )&#10;    ) - &#10;    (&#10;        SUM(&#10;        IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_items_vs_total_assortment] &gt; 0 AND [period_num] = [Parameters].[Cards Period 1 (copy)_1278529740053532683]  THEN&#10;            [ratio_num_updates_items_vs_total_assortment] * [gmv_net_eur]&#10;            ELSE NULL&#10;        END&#10;        ) / &#10;        SUM(&#10;        IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_items_vs_total_assortment] &gt; 0 AND [period_num] = [Parameters].[Cards Period 1 (copy)_1278529740053532683]  THEN&#10;           [gmv_net_eur]&#10;            ELSE NULL&#10;        END&#10;        )&#10;    )&#10;) * 100' />
      </column>
      <column caption='% Not Found Rate / Items Not Delivered - Diff (card)' datatype='real' default-format='n0.00;-0.00' name='[Avg. num. of Updates per Day - Diff (card) (copy)_1278529740259676189]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(&#10;    (&#10;        IF SUM([confirmed_orders_pelican]) &gt; 0 THEN&#10;        SUM(&#10;            IF [period_num] = [Parameters].[Parameter 5] THEN&#10;                ([in_cart_pelican_items] - [in_cart_pelican_items_sold])     &#10;                + [not_found_pelican_items] &#10;                + ([replaced_pelican_items] - [replaced_pelican_items_sold] - [replacements_pelican_items])&#10;                + [oos_failed_pelican_items]&#10;            ELSE NULL&#10;            END&#10;        ) / &#10;        SUM(&#10;            IF [period_num] = [Parameters].[Parameter 5] THEN&#10;                [in_cart_pelican_items]&#10;                + [not_found_pelican_items] &#10;                + [not_processed_pelican_items] &#10;                + [replaced_pelican_items]&#10;                + [replacements_pelican_items]&#10;                + [oos_failed_pelican_items]&#10;            ELSE NULL&#10;            END&#10;        )&#10;        ELSE NULL END&#10;    ) -&#10;    (&#10;        IF SUM([confirmed_orders_pelican]) &gt; 0 THEN&#10;        SUM(&#10;            IF [period_num] = [Parameters].[Cards Period 1 (copy)_1278529740053532683] THEN&#10;                ([in_cart_pelican_items] - [in_cart_pelican_items_sold])     &#10;                + [not_found_pelican_items] &#10;                + ([replaced_pelican_items] - [replaced_pelican_items_sold] - [replacements_pelican_items])&#10;                + [oos_failed_pelican_items]&#10;            ELSE NULL&#10;            END&#10;        ) / &#10;        SUM(&#10;            IF [period_num] = [Parameters].[Cards Period 1 (copy)_1278529740053532683] THEN&#10;                [in_cart_pelican_items]&#10;                + [not_found_pelican_items] &#10;                + [not_processed_pelican_items] &#10;                + [replaced_pelican_items]&#10;                + [replacements_pelican_items]&#10;                + [oos_failed_pelican_items]&#10;            ELSE NULL&#10;            END&#10;        )&#10;        ELSE NULL END&#10;    )&#10; ) * 100' />
      </column>
      <column caption='Ratio # updates items vs total assortment - Diff Icon (card)' datatype='string' default-format='p0.0%' name='[Avg. num. of Updates per Day - Diff Icon (card) (copy)_1278529740258992156]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Avg. num. of Updates per Day - Diff (card) (copy)_1278529740258992154] &gt; 0 THEN &quot;▲&quot; &#10;ELSEIF [Avg. num. of Updates per Day - Diff (card) (copy)_1278529740258992154] &lt; 0 THEN &quot;▼&quot; &#10;ELSE &quot;●&quot;&#10;END' />
      </column>
      <column caption='% Not Found Rate / Items Not Delivered - Diff Icon (card)' datatype='string' default-format='p0.0%' name='[Avg. num. of Updates per Day - Diff Icon (card) (copy)_1278529740259676191]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Avg. num. of Updates per Day - Diff (card) (copy)_1278529740259676189] &gt; 0 THEN &quot;▲&quot; &#10;ELSEIF [Avg. num. of Updates per Day - Diff (card) (copy)_1278529740259676189] &lt; 0 THEN &quot;▼&quot; &#10;ELSE &quot;●&quot;&#10;END' />
      </column>
      <column caption='Every how many days Vendors update their stock' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;IF [gmv_net_eur] &gt; 0 AND [every_how_many_days_vendors_update_their_stock] &gt; 0 THEN&#10;    [every_how_many_days_vendors_update_their_stock] * [gmv_net_eur]&#10;    ELSE NULL&#10;END&#10;) / &#10;SUM(&#10;IF [gmv_net_eur] &gt; 0 AND [every_how_many_days_vendors_update_their_stock] &gt; 0 THEN&#10;   [gmv_net_eur]&#10;    ELSE NULL&#10;END&#10;)' />
      </column>
      <column caption='Entity or Country' datatype='string' name='[Calculation_115897350132613120]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF {FIXED : COUNTD([entity])} &gt; 1 THEN [entity] ELSE country END' />
      </column>
      <column caption='View 1' datatype='string' name='[Calculation_1278529739994845184]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;1&apos; THEN &apos;1&apos; &#10;WHEN &apos;2&apos; THEN &apos;2&apos;&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Metrics 1' datatype='real' name='[Calculation_1278529740003389442]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;    WHEN &apos;1&apos; THEN COUNTD([vendor_id])&#10;    WHEN &apos;2&apos; THEN SUM([confirmed_orders])&#10;    WHEN &apos;3&apos; THEN SUM([gmv_net_eur])&#10;    WHEN &apos;4&apos; THEN [% Not Found Rate / Items Not Delivered (copy)_3194529905381822494] / COUNTD([vendor_id])&#10;    WHEN &apos;5&apos; THEN SUM([oos_failed_pelican_orders_items_price_eur]) / COUNTD([vendor_id])&#10;    WHEN &apos;6&apos; THEN SUM([nr_jobs_updated_product_completed]) / COUNTD([vendor_id])&#10;    WHEN &apos;7&apos; THEN SUM([nr_changed_products_completed]) / COUNTD([vendor_id])&#10;END' />
      </column>
      <column caption='Stocks SFTP Jobs (card)' datatype='integer' name='[Calculation_1278529740044296199]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [period_num] = [Parameters].[Parameter 5]&#10;        THEN [nr_jobs_updated_product_completed]&#10;        ELSE 0&#10;    END&#10;)' />
      </column>
      <column caption='Metrics Cards' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1278529740269060131]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;    WHEN &apos;1&apos; THEN ROUND(SUM([gmv_net_eur]) / 1000, 2)&#10;    WHEN &apos;2&apos; THEN ROUND(SUM([nr_jobs_updated_product_completed]) / 1000, 2)&#10;    WHEN &apos;3&apos; THEN [Calculation1]&#10;    WHEN &apos;4&apos; THEN [Calculation_1860831095256268831]&#10;    WHEN &apos;5&apos; THEN [Calculation_1860831095894679597] * 100&#10;    WHEN &apos;6&apos; THEN [% Partial Fulfilled Items (copy)_1860831095852757033] * 100&#10;    WHEN &apos;7&apos; THEN [Calculation_1860831095615938598] * 100&#10;    WHEN &apos;8&apos; THEN [% SFTP Vendors (card) (copy)_161707402988531715] * 100&#10;END' />
      </column>
      <column caption='Selected Period' datatype='boolean' name='[Calculation_1278529740277645362]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = MAX([period_num]) THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Dymension Cards' datatype='string' name='[Calculation_1278529740281888822]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[In / Out (copy)]&#10;    WHEN &quot;1&quot; THEN [sftp_score_group]&#10;    WHEN &quot;2&quot; THEN [entity]&#10;    WHEN &quot;3&quot; THEN [Calculation_3194529905058963481]&#10;    WHEN &quot;4&quot; THEN [picking_app]&#10;    WHEN &quot;5&quot; THEN STR([is_aaa_vendor])&#10;    WHEN &quot;6&quot; THEN STR([is_aaa_supermarket])&#10;ELSE &quot;&quot;&#10;END' />
      </column>
      <column caption='2nd Ratio of Items updates' datatype='real' default-format='p0.0%' name='[Calculation_1278529740685598776]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(&#10;    (   SUM([nr_changed_products_completed]) &#10;        / SUM(IF [nr_changed_products_completed] &gt; 0 THEN [nr_jobs_updated_product_completed] ELSE 0 END)&#10;    ) / &#10;    SUM(&#10;        IF [nr_changed_products_completed] &gt; 0 &#10;            AND [nr_jobs_updated_product_completed] &gt; 0&#10;        THEN [vendor_assortment_total] ELSE 0 END)&#10;)' />
      </column>
      <column caption='Filter Outliers (card)' datatype='boolean' name='[Calculation_1278529741041209407]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = &apos;8&apos; THEN TRUE ELSE&#10;&#10;    CASE [granularity]&#10;        &#10;        WHEN &apos;weekly&apos; THEN&#10;&#10;            IF [confirmed_orders] &gt; 1 THEN&#10;                IF [nr_jobs_updated_product_completed] &lt;= 3  THEN&#10;                    IF [gmv_net_eur] / [nr_jobs_updated_product_completed] &lt; 100 THEN TRUE ELSE FALSE END&#10;                ELSE TRUE END&#10;            ELSE TRUE END&#10;&#10;        WHEN &apos;monthly&apos; THEN&#10;&#10;            IF [confirmed_orders] &gt; 1 THEN&#10;                IF [nr_jobs_updated_product_completed] &lt;= 15  THEN&#10;                    IF [gmv_net_eur] / [nr_jobs_updated_product_completed] &lt; 700 THEN TRUE ELSE FALSE END&#10;                ELSE TRUE END&#10;            ELSE TRUE END&#10;&#10;        WHEN &apos;quarterly&apos; THEN&#10;&#10;            IF [confirmed_orders] &gt; 1 THEN&#10;                IF [nr_jobs_updated_product_completed] &lt;= 30  THEN&#10;                    IF [gmv_net_eur] / [nr_jobs_updated_product_completed] &lt; 1400 THEN TRUE ELSE FALSE END&#10;                ELSE TRUE END&#10;            ELSE TRUE END&#10;&#10;    END&#10;END' />
      </column>
      <column caption='Cards Title' datatype='string' name='[Calculation_1278529741365178433]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(&quot;Date: &quot;) &#10;+ STR(IF [period_num] = [Parameters].[Parameter 5] THEN [Calculation_1860831094529859592] ELSE NULL END) &#10;+ STR(&quot; (&quot; + [granularity] + &quot;)&quot;) &#10;+ STR(IF[Parameters].[Parameter 5] = 1 THEN &quot; - This Period is still in progress    &quot; ELSE &quot;   &quot; END)' />
      </column>
      <column caption='Has Complete Jobs to Update Stock (adjusted)' datatype='boolean' name='[Calculation_153052048041078785]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = &apos;8&apos; THEN &#10;    IF [nr_jobs_updated_product_completed] &gt;= 1 THEN TRUE ELSE FALSE END&#10;ELSE TRUE&#10;END' />
      </column>
      <column caption='Local Date ' datatype='string' name='[Calculation_1860831094529859592]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [granularity]&#10;    WHEN &apos;weekly&apos; THEN STR(DATE(DATETRUNC(&apos;week&apos;,[local_date], &apos;monday&apos;)))&#10;    WHEN &apos;monthly&apos; THEN STR(DATE(DATETRUNC(&apos;month&apos;,[local_date])))&#10;    WHEN &apos;quarterly&apos; THEN STR(DATE(DATETRUNC(&apos;quarter&apos;,[local_date])))&#10;END' />
      </column>
      <column caption='# of Vendors using SFTP Jobs' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1860831094933049357]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [has_sftp_jobs] THEN [vendor_id] END)' />
      </column>
      <column caption='% Vendors Using Central SFTP' datatype='real' default-format='p0.0%' name='[Calculation_1860831095202131996]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(COUNTD(IF [has_sftp_jobs] AND [sftp_type_is_central] THEN [vendor_id] END) / [Calculation_1860831094933049357])' />
      </column>
      <column caption='Period Filter' datatype='boolean' name='[Calculation_1860831095232335902]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [period_num] &lt;= [Parameters].[Replaced Pelican Items Parameter] + 1 &#10;THEN &#10;    IF [Parameters].[How many periods do you want to see (copy)] &#10;    THEN &#10;        IF [period_num] &lt;= [Parameters].[Replaced Pelican Items Parameter] &#10;        THEN TRUE &#10;        ELSE FALSE &#10;        END &#10;    ELSE &#10;        IF [period_num] &gt; 1 &#10;        THEN TRUE &#10;        ELSE FALSE &#10;        END&#10;    END &#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='Avg. num. of Updates per Day' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1860831095256268831]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;IF [gmv_net_eur] &gt; 0 AND [avg_number_of_updates_per_day] &gt; 0 THEN&#10;    [avg_number_of_updates_per_day] * [gmv_net_eur]&#10;    ELSE NULL&#10;END&#10;) / &#10;SUM(&#10;IF [gmv_net_eur] &gt; 0 AND [avg_number_of_updates_per_day] &gt; 0 THEN&#10;   [gmv_net_eur]&#10;    ELSE NULL&#10;END&#10;)' />
      </column>
      <column caption='# of Days ' datatype='integer' name='[Calculation_1860831095266058273]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([num_of_days])' />
      </column>
      <column caption='% of Stock Jobs that Failed' datatype='real' default-format='p0.0%' name='[Calculation_1860831095546413092]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nr_jobs_failed]) / SUM([nr_jobs])' />
      </column>
      <column caption='Ratio # updates items vs total assortment' datatype='real' default-format='p0.0%' name='[Calculation_1860831095615938598]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_items_vs_total_assortment] &gt; 0 THEN&#10;    [ratio_num_updates_items_vs_total_assortment] * [gmv_net_eur]&#10;    ELSE NULL&#10;END&#10;) / &#10;SUM(&#10;IF [gmv_net_eur] &gt; 0 AND [ratio_num_updates_items_vs_total_assortment] &gt; 0 THEN&#10;   [gmv_net_eur]&#10;    ELSE NULL&#10;END&#10;)' />
      </column>
      <column caption='% Not Found Items' datatype='real' default-format='p0.00%' name='[Calculation_1860831095850856487]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([not_found_pelican_items]) / SUM(&#10;    [in_cart_pelican_items] &#10;    + [not_found_pelican_items] &#10;    + [not_processed_pelican_items] &#10;    + [replaced_pelican_items] &#10;    + [replacements_pelican_items]&#10;)' />
      </column>
      <column caption='# of Products impacted by Campaigns' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1860831095882592300]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sftp_campaign_total_product_impacted]) / SUM([sftp_campaign_counting_total])' />
      </column>
      <column caption='% Not Found Rate / Items Not Delivered' datatype='real' default-format='p0.00%' name='[Calculation_1860831095894679597]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([confirmed_orders_pelican]) &gt; 0 THEN&#10;SUM(&#10;    ([in_cart_pelican_items] - [in_cart_pelican_items_sold])     &#10;    + [not_found_pelican_items] &#10;    + ([replaced_pelican_items] - [replaced_pelican_items_sold] - [replacements_pelican_items])&#10;    + [oos_failed_pelican_items]&#10;) / &#10;SUM(&#10;    [in_cart_pelican_items]&#10;    + [not_found_pelican_items] &#10;    + [not_processed_pelican_items] &#10;    + [replaced_pelican_items]&#10;    + [replacements_pelican_items]&#10;    + [oos_failed_pelican_items]&#10;)&#10;ELSE NULL END' />
      </column>
      <column caption='Score' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1860831096239075374]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Calculation_1860831096249008176]) &gt; 0 THEN&#10;    (&#10;        (&#10;            (&#10;                IF [Calculation1] &gt;= 1.00 THEN 10&#10;                ELSEIF [Calculation1] &gt;= 1.50 THEN 7.5&#10;                ELSEIF [Calculation1] &gt;= 2.00 THEN 5&#10;                ELSEIF [Calculation1] &gt;= 5.00 THEN 2.5&#10;                ELSE 0 END&#10;            ) + (&#10;                IF [Calculation_1860831095256268831] &gt;= 2.00 THEN 10&#10;                ELSEIF [Calculation_1860831095256268831] &gt;= 1.25 THEN 7.5&#10;                ELSEIF [Calculation_1860831095256268831] &gt;= 0.80 THEN 5&#10;                ELSEIF [Calculation_1860831095256268831] &gt;= 0.40 THEN 2.5&#10;                ELSE 0 END&#10;            ) + (&#10;                IF [Calculation_1860831095615938598] &gt;= 2.50 THEN 10&#10;                ELSEIF [Calculation_1860831095615938598] &gt;= 2.00 THEN 7.5&#10;                ELSEIF [Calculation_1860831095615938598] &gt;= 1.00 THEN 5&#10;                ELSEIF [Calculation_1860831095615938598] &gt;= 0.50 THEN 2.5&#10;                ELSE 0 END&#10;            ) + (&#10;                IF [Calculation_1860831095894679597] &lt;= 0.01 THEN 10&#10;                ELSEIF [Calculation_1860831095894679597] &lt;= 0.02 THEN 7.5&#10;                ELSEIF [Calculation_1860831095894679597] &lt;= 0.05 THEN 5&#10;                ELSEIF [Calculation_1860831095894679597] &lt;= 0.10 THEN 2.5&#10;                ELSE 0 END&#10;            ) + (&#10;                IF [% Partial Fulfilled Items (copy)_1860831095852757033] &lt;= 0.005 THEN 10&#10;                ELSEIF [% Partial Fulfilled Items (copy)_1860831095852757033] &lt;= 0.01 THEN 7.5&#10;                ELSEIF [% Partial Fulfilled Items (copy)_1860831095852757033] &lt;= 0.03 THEN 5&#10;                ELSEIF [% Partial Fulfilled Items (copy)_1860831095852757033] &lt;= 0.075 THEN 2.5&#10;                ELSE 0 END&#10;            )&#10;        ) / 50&#10;    ) * 100&#10;ELSE&#10;    (&#10;        (&#10;            (&#10;                IF [Calculation1] &gt;= 1.00 THEN 10&#10;                ELSEIF [Calculation1] &gt;= 1.50 THEN 7.5&#10;                ELSEIF [Calculation1] &gt;= 2.00 THEN 5&#10;                ELSEIF [Calculation1] &gt;= 5.00 THEN 2.5&#10;                ELSE 0 END&#10;            ) + (&#10;                IF [Calculation_1860831095256268831] &gt;= 2.00 THEN 10&#10;                ELSEIF [Calculation_1860831095256268831] &gt;= 1.25 THEN 7.5&#10;                ELSEIF [Calculation_1860831095256268831] &gt;= 0.80 THEN 5&#10;                ELSEIF [Calculation_1860831095256268831] &gt;= 0.40 THEN 2.5&#10;                ELSE 0 END&#10;            ) + (&#10;                IF [Calculation_1860831095615938598] &gt;= 2.50 THEN 10&#10;                ELSEIF [Calculation_1860831095615938598] &gt;= 2.00 THEN 7.5&#10;                ELSEIF [Calculation_1860831095615938598] &gt;= 1.00 THEN 5&#10;                ELSEIF [Calculation_1860831095615938598] &gt;= 0.50 THEN 2.5&#10;                ELSE 0 END&#10;            ) + (&#10;                IF [% Partial Fulfilled Items (copy)_1860831095852757033] &lt;= 0.005 THEN 10&#10;                ELSEIF [% Partial Fulfilled Items (copy)_1860831095852757033] &lt;= 0.01 THEN 7.5&#10;                ELSEIF [% Partial Fulfilled Items (copy)_1860831095852757033] &lt;= 0.03 THEN 5&#10;                ELSEIF [% Partial Fulfilled Items (copy)_1860831095852757033] &lt;= 0.075 THEN 2.5&#10;                ELSE 0 END&#10;            )&#10;        ) / 40&#10;    ) * 100&#10;END' />
      </column>
      <column caption='Total Ordered Items (granular)' datatype='real' name='[Calculation_1860831096249008176]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[in_cart_pelican_items] &#10;+ [not_found_pelican_items] &#10;+ [not_processed_pelican_items] &#10;+ [replaced_pelican_items] &#10;+ [replacements_pelican_items] &#10;+ [oos_failed_pelican_items]' />
      </column>
      <column caption='SFTP Score Group' datatype='string' name='[Calculation_1860831096295628849]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Score (copy)_3194529904769355787] &lt; 50 THEN &apos;Underperforming&apos; ELSEIF [Score (copy)_3194529904769355787] &gt; 74.99 THEN &apos;Overperforming&apos; ELSE &apos;Neutral&apos; END' />
      </column>
      <column caption='Avg. shared assortment from SFTP' datatype='real' default-format='p0%' name='[Calculation_3174545187022356480]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;    SUM(IF [nr_jobs_completed] &gt; 0 THEN [nr_processed_products_completed] ELSE 0 END) &#10;        + SUM(IF [nr_jobs_completed] &gt; 0 THEN [nr_failed_count_completed] ELSE 0 END)&#10;    /&#10;    SUM(IF [nr_jobs_completed] &gt; 0 THEN [nr_jobs_completed] ELSE 0 END) &#10;)&#10;/ SUM(IF [nr_jobs_completed] &gt; 0 THEN [vendor_assortment_total] ELSE 0 END)' />
      </column>
      <column caption='Validation' datatype='real' name='[Calculation_3194529904729645064]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Score (copy)_3194529904769355787] - SUM([sftp_score])' />
      </column>
      <column caption='Vendor Name + id' datatype='string' name='[Calculation_3194529904736956426]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[vendor_id] + &quot; - &quot; +[vendor_name]' />
      </column>
      <column caption='SFTP Score Group Count' datatype='integer' name='[Calculation_3194529904780869646]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([sftp_score_group])' />
      </column>
      <column caption='Exclude last period' datatype='boolean' name='[Calculation_3194529904956862481]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[How many periods do you want to see (copy)] = FALSE THEN &#10;    IF [period_num] != 1 THEN TRUE ELSE FALSE END&#10;ELSE TRUE END' />
      </column>
      <column caption='Has Complete Jobs to Update Stock (card)' datatype='boolean' name='[Calculation_3194529905047035928]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = &apos;8&apos; THEN TRUE &#10;ELSEIF [nr_jobs_updated_product_completed] &gt;= 1 THEN TRUE &#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='SFTP Type' datatype='string' name='[Calculation_3194529905058963481]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [sftp_type_is_central] THEN &apos;Central SFTP&apos; ELSEIF [sftp_type_is_legacy] THEN &apos;Legacy SFTP&apos; ELSE &apos;Non SFTP&apos; END' />
      </column>
      <column caption='% GMV Loss Due to OOS Failed Orders' datatype='real' default-format='p0.00%' name='[Calculation_3194529905401241634]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([oos_failed_pelican_orders_items_price_eur]) / SUM([gmv_net_eur])' />
      </column>
      <column caption='Vendors List to Filter Calc' datatype='boolean' name='[Calculation_3194529905693958179]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] THEN&#10;    IF [Parameters].[Parameter 1] != &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Parameter 1], [vendor_id]) THEN TRUE ELSE FALSE END&#10;        ELSE TRUE&#10;    END&#10;ELSE&#10;    IF [Parameters].[Parameter 1] != &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Parameter 1], [vendor_id]) THEN FALSE ELSE TRUE END&#10;        ELSE TRUE&#10;    END&#10;END' />
      </column>
      <column caption='Avg Confirmed Orders per Vendor (Score Group)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_3194529905720311846]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([confirmed_orders]) / [Calculation_3194529904780869646]' />
      </column>
      <column caption='Chain Name + id' datatype='string' name='[Calculation_3194529905745088555]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[chain_id] + &quot; - &quot; + [chain_name]' />
      </column>
      <column caption='Avg. num. of Updates per Day - Diff (card)' datatype='real' default-format='p0.0%' name='[Every how many days  - Diff (card) (copy)_1278529740256890904]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(&#10;    (&#10;        SUM(&#10;            IF [gmv_net_eur] &gt; 0 AND [avg_number_of_updates_per_day] &gt; 0 AND [period_num] = [Parameters].[Parameter 5] THEN&#10;                [avg_number_of_updates_per_day] * [gmv_net_eur]&#10;                ELSE NULL&#10;            END&#10;        ) / &#10;        SUM(&#10;            IF [gmv_net_eur] &gt; 0 AND [avg_number_of_updates_per_day] &gt; 0 AND [period_num] = [Parameters].[Parameter 5] THEN&#10;               [gmv_net_eur]&#10;                ELSE NULL&#10;            END&#10;        )&#10;    ) / &#10;    (&#10;        SUM(&#10;        IF [gmv_net_eur] &gt; 0 AND [avg_number_of_updates_per_day] &gt; 0 AND [period_num] = [Parameters].[Cards Period 1 (copy)_1278529740053532683] THEN&#10;            [avg_number_of_updates_per_day] * [gmv_net_eur]&#10;            ELSE NULL&#10;        END&#10;    ) / &#10;        SUM(&#10;        IF [gmv_net_eur] &gt; 0 AND [avg_number_of_updates_per_day] &gt; 0 AND [period_num] = [Parameters].[Cards Period 1 (copy)_1278529740053532683] THEN&#10;           [gmv_net_eur]&#10;            ELSE NULL&#10;        END&#10;        )&#10;    )&#10;-1 )' />
      </column>
      <column caption='Ratio Items Update - Diff (card)' datatype='real' default-format='p0.0%' name='[Every how many days  - Diff (card) (copy)_1278529740990058554]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(&#10;    (&#10;        SUM(&#10;            IF [gmv_net_eur] &gt; 0 AND [every_how_many_days_vendors_update_their_stock] &gt; 0 AND [period_num] = [Parameters].[Parameter 5] THEN&#10;                [every_how_many_days_vendors_update_their_stock] * [gmv_net_eur]&#10;                ELSE NULL&#10;            END&#10;        ) / &#10;        SUM(&#10;            IF [gmv_net_eur] &gt; 0 AND [every_how_many_days_vendors_update_their_stock] &gt; 0 AND [period_num] = [Parameters].[Parameter 5] THEN&#10;               [gmv_net_eur]&#10;                ELSE NULL&#10;            END&#10;        )&#10;    ) / &#10;    (&#10;        SUM(&#10;        IF [gmv_net_eur] &gt; 0 AND [every_how_many_days_vendors_update_their_stock] &gt; 0 AND [period_num] = [Parameters].[Cards Period 1 (copy)_1278529740053532683] THEN&#10;            [every_how_many_days_vendors_update_their_stock] * [gmv_net_eur]&#10;            ELSE NULL&#10;        END&#10;    ) / &#10;        SUM(&#10;        IF [gmv_net_eur] &gt; 0 AND [every_how_many_days_vendors_update_their_stock] &gt; 0 AND [period_num] = [Parameters].[Cards Period 1 (copy)_1278529740053532683] THEN&#10;           [gmv_net_eur]&#10;            ELSE NULL&#10;        END&#10;        )&#10;    )&#10;-1 )' />
      </column>
      <column caption='Avg. num. of Updates per Day (card)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Every how many days (card) (copy)_1278529740256890903]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;IF [gmv_net_eur] &gt; 0 AND [avg_number_of_updates_per_day] &gt; 0 AND [period_num] = [Parameters].[Parameter 5] THEN&#10;    [avg_number_of_updates_per_day] * [gmv_net_eur]&#10;    ELSE NULL&#10;END&#10;) / &#10;SUM(&#10;IF [gmv_net_eur] &gt; 0 AND [avg_number_of_updates_per_day] &gt; 0 AND [period_num] = [Parameters].[Parameter 5] THEN&#10;   [gmv_net_eur]&#10;    ELSE NULL&#10;END&#10;)' />
      </column>
      <column caption='Ratio Items Update (card)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Every how many days (card) (copy)_1278529740990058553]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;IF [gmv_net_eur] &gt; 0 AND [every_how_many_days_vendors_update_their_stock] &gt; 0 AND [period_num] = [Parameters].[Parameter 5] THEN&#10;    [every_how_many_days_vendors_update_their_stock] * [gmv_net_eur]&#10;    ELSE NULL&#10;END&#10;) / &#10;SUM(&#10;IF [gmv_net_eur] &gt; 0 AND [every_how_many_days_vendors_update_their_stock] &gt; 0 AND [period_num] = [Parameters].[Parameter 5] THEN&#10;   [gmv_net_eur]&#10;    ELSE NULL&#10;END&#10;)' />
      </column>
      <column caption='Avg. num. of Updates per Day - Diff Icon (card)' datatype='string' default-format='p0.0%' name='[Every how many days - Diff Icon (card) (copy)_1278529740256890905]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Every how many days  - Diff (card) (copy)_1278529740256890904] &gt; 0 THEN &quot;▲&quot; &#10;ELSEIF [Every how many days  - Diff (card) (copy)_1278529740256890904] &lt; 0 THEN &quot;▼&quot; &#10;ELSE &quot;●&quot;&#10;END' />
      </column>
      <column caption='Ratio Items Update  - Diff Icon (card)' datatype='string' default-format='p0.0%' name='[Every how many days - Diff Icon (card) (copy)_1278529740990058555]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Stocks SFTP Jobs - Diff (card) (copy)_1278529740072165393] &gt; 0 THEN &quot;▲&quot; &#10;ELSEIF [Stocks SFTP Jobs - Diff (card) (copy)_1278529740072165393] &lt; 0 THEN &quot;▼&quot; &#10;ELSE &quot;●&quot;&#10;END' />
      </column>
      <column caption='Every how many days Vendors update their stock (copy)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Every how many days Vendors update their stock (copy)_1278529740250648596]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Ratio Update Stocks (days) (copy)_1860831094976933915] &gt; 0.01 AND SUM([nr_jobs_updated_product_completed]) &gt; 0 THEN&#10;[Calculation_1860831095266058273] / [Ratio Update Stocks (days) (copy)_1860831094976933915]&#10;ELSE 0&#10;END' />
      </column>
      <column caption='Filter Outliers (cv performance)' datatype='boolean' name='[Filter Outliers (copy)_161707402996469765]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [granularity]&#10;    &#10;    WHEN &apos;weekly&apos; THEN&#10;&#10;        IF [confirmed_orders] &gt; 1 THEN&#10;            IF [nr_jobs_updated_product_completed] &lt;= 3  THEN&#10;                IF [gmv_net_eur] / [nr_jobs_updated_product_completed] &lt; 100 THEN TRUE ELSE FALSE END&#10;            ELSE TRUE END&#10;        ELSE TRUE END&#10;&#10;    WHEN &apos;monthly&apos; THEN&#10;&#10;        IF [confirmed_orders] &gt; 1 THEN&#10;            IF [nr_jobs_updated_product_completed] &lt;= 15  THEN&#10;                IF [gmv_net_eur] / [nr_jobs_updated_product_completed] &lt; 700 THEN TRUE ELSE FALSE END&#10;            ELSE TRUE END&#10;        ELSE TRUE END&#10;&#10;    WHEN &apos;quarterly&apos; THEN&#10;&#10;        IF [confirmed_orders] &gt; 1 THEN&#10;            IF [nr_jobs_updated_product_completed] &lt;= 30  THEN&#10;                IF [gmv_net_eur] / [nr_jobs_updated_product_completed] &lt; 1400 THEN TRUE ELSE FALSE END&#10;            ELSE TRUE END&#10;        ELSE TRUE END&#10;&#10;END' />
      </column>
      <column caption='GMV (promo card)' datatype='real' default-format='c#,##0,,.0M&quot; €&quot;;-#,##0,,.0M&quot; €&quot;' name='[GMV (card) (copy)_169799810211545092]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [period_num] = [Parameters].[Parameter 5]&#10;        THEN [gmv_net_eur]&#10;        ELSE 0&#10;    END&#10;)' />
      </column>
      <column caption='# Campaigns - (promo card)' datatype='integer' default-format='n#,##0,.0K;-#,##0,.0K' name='[GMV (promo card) (copy)_169799810214723592]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [period_num] = [Parameters].[Parameter 5] THEN&#10;        IF [Parameters].[Parameter 8] THEN [sftp_campaign_counting_active] &#10;        ELSE [sftp_campaign_counting_total] END&#10;        ELSE 0&#10;    END&#10;)' />
      </column>
      <column caption='GMV - Diff (promo card)' datatype='real' default-format='p0.0%' name='[GMV - Diff (card) (copy)_169799810211545093]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN((&#10;    SUM(&#10;        IF [period_num] = [Parameters].[Parameter 5]&#10;            THEN [gmv_net_eur]&#10;            ELSE 0&#10;        END&#10;    )&#10;    /&#10;    SUM(&#10;        IF [period_num] = [Parameters].[Cards Period 1 (copy)_1278529740053532683]&#10;            THEN [gmv_net_eur]&#10;            ELSE 0&#10;        END&#10;    )&#10;) -1 )' />
      </column>
      <column caption='# Campaigns - Diff (promo card)' datatype='real' default-format='p0.0%' name='[GMV - Diff (promo card) (copy)_169799810214723593]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN((&#10;    SUM(&#10;        IF [period_num] = [Parameters].[Parameter 5] THEN&#10;            IF [Parameters].[Parameter 8] THEN [sftp_campaign_counting_active] &#10;            ELSE [sftp_campaign_counting_total] END&#10;            ELSE 0&#10;        END&#10;    )&#10;    /&#10;    SUM(&#10;        IF [period_num] = [Parameters].[Cards Period 1 (copy)_1278529740053532683] THEN&#10;            IF [Parameters].[Parameter 8] THEN [sftp_campaign_counting_active] &#10;            ELSE [sftp_campaign_counting_total] END&#10;            ELSE 0&#10;        END&#10;    )&#10;) -1 )' />
      </column>
      <column caption='GMV - Diff Icon (promo card)' datatype='string' default-format='p0.0%' name='[GMV - Diff Icon (card) (copy)_169799810211545094]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [GMV - Diff (card) (copy)_169799810211545093] &gt; 0 THEN &quot;▲&quot; &#10;ELSEIF [GMV - Diff (card) (copy)_169799810211545093] &lt; 0 THEN &quot;▼&quot; &#10;ELSE &quot;●&quot;&#10;END' />
      </column>
      <column caption='# Campaigns - Diff Icon (promo card)' datatype='string' default-format='p0.0%' name='[GMV - Diff Icon (promo card) (copy)_169799810214723594]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [GMV - Diff (promo card) (copy)_169799810214723593] &gt; 0 THEN &quot;▲&quot; &#10;ELSEIF [GMV - Diff (promo card) (copy)_169799810214723593] &lt; 0 THEN &quot;▼&quot; &#10;ELSE &quot;●&quot;&#10;END' />
      </column>
      <column caption='SFTP Used in the last 30 Days (adjusted)' datatype='boolean' name='[Has Complete Jobs to Update Stock (adjusted) (copy)_169799809930981377]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = &apos;8&apos; THEN &#10;    IF [sftp_jobs_used_l30days] THEN TRUE ELSE FALSE END&#10;ELSE TRUE&#10;END' />
      </column>
      <column caption='SFTP Used in the last 30 Days (card)' datatype='boolean' name='[Has Complete Jobs to Update Stock (card) (copy)_169799809930989570]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = &apos;8&apos; THEN TRUE &#10;ELSEIF [sftp_jobs_used_l30days] THEN TRUE &#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='Has SFTP Promotions Updates (card)' datatype='boolean' name='[Has Complete Jobs to Update Stock (card) (copy)_169799810311102510]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Metrics Cards (copy)_169799810299666470] = &apos;17&apos; THEN TRUE &#10;ELSEIF [sftp_campaign_total_num_of_updates] &gt;= 1 THEN TRUE &#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='Has Complete Jobs to Update Stock (cv performance)' datatype='boolean' name='[Has Complete Jobs to Update Stock (copy)_161707402996539398]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [nr_jobs_updated_product_completed] &gt;= 1 THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='SFTP Used in the last 30 Days (cv performance)' datatype='boolean' name='[Has Complete Jobs to Update Stock (cv performance) (copy)_169799809930997763]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [sftp_jobs_used_l30days] THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Has SFTP Promotions Updates (adjusted)' datatype='boolean' name='[Has SFTP Promotions Updates (card) (copy)_169799810313207855]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Metrics Cards (copy)_169799810299666470] = &apos;17&apos; THEN  &#10;    IF [sftp_campaign_total_num_of_updates] &gt;= 1 THEN TRUE ELSE FALSE END&#10;ELSE TRUE&#10;END' />
      </column>
      <column caption='Local Date  ' datatype='datetime' default-format='*dd/mm/yy' name='[Local Date  (copy)_3194529904708677634]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [granularity]&#10;WHEN &apos;weekly&apos; THEN DATETRUNC(&apos;week&apos;, [local_date], &apos;monday&apos;)&#10;WHEN &apos;monthly&apos; THEN DATETRUNC(&apos;month&apos;, [local_date])&#10;WHEN &apos;quarterly&apos; THEN DATETRUNC(&apos;quarter&apos;, [local_date])&#10;END' />
      </column>
      <column caption='Metrics Cards Promo (Symbol)' datatype='string' default-format='n#,##0.00;-#,##0.00' name='[Metrics Cards (Symbol) (copy)_169799810286444576]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Metrics Cards (copy)_169799810299666470]&#10;    WHEN &apos;11&apos; THEN &quot;k&quot;&#10;    WHEN &apos;12&apos; THEN &quot;k&quot;&#10;    WHEN &apos;13&apos; THEN &quot;&quot;&#10;    WHEN &apos;14&apos; THEN &quot;k&quot;&#10;    WHEN &apos;15&apos; THEN &quot;&quot;&#10;    WHEN &apos;16&apos; THEN &quot;%&quot;&#10;    WHEN &apos;17&apos; THEN &quot;%&quot;&#10;    WHEN &apos;18&apos; THEN &quot;&quot;&#10;END' />
      </column>
      <column caption='Metrics Cards (Symbol)' datatype='string' default-format='n#,##0.00;-#,##0.00' name='[Metrics Cards (copy)_1278529740283846711]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;    WHEN &apos;1&apos; THEN &quot;k&quot;&#10;    WHEN &apos;2&apos; THEN &quot;k&quot;&#10;    WHEN &apos;3&apos; THEN &quot;&quot;&#10;    WHEN &apos;4&apos; THEN &quot;&quot;&#10;    WHEN &apos;5&apos; THEN &quot;%&quot;&#10;    WHEN &apos;6&apos; THEN &quot;%&quot;&#10;    WHEN &apos;7&apos; THEN &quot;%&quot;&#10;    WHEN &apos;8&apos; THEN &quot;%&quot;&#10;END' />
      </column>
      <column caption='Metrics Cards Promo' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Metrics Cards (copy)_169799810286411807]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Metrics Cards (copy)_169799810299666470]&#10;    WHEN &apos;11&apos; THEN ROUND(SUM([gmv_net_eur]) / 1000, 2)&#10;    WHEN &apos;12&apos; THEN [# Campaigns - (promo card) (copy)_169799810287341601] / 1000&#10;    WHEN &apos;13&apos; THEN [# Campaigns Updates - (promo card) (copy)_169799810287661090]&#10;    WHEN &apos;14&apos; THEN [# Impacted Products - (promo card) (copy)_169799810287927331] / 1000 &#10;    WHEN &apos;15&apos; THEN [# Impacted Products pc - (promo card) (copy)_169799810288123940]&#10;    WHEN &apos;16&apos; THEN [% of Catalog Impacted by Promo - (promo card) (copy)_169799810288476197] * 100&#10;    WHEN &apos;17&apos; THEN [% SFTP Vendors (copy)_169799810306056231] * 100&#10;END' />
      </column>
      <column caption='% SFTP Vendors (card)' datatype='real' default-format='p0.0%' name='[Ratio # updates items vs total assortment (card) (copy)_161707402986827776]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;IF [gmv_net_eur] &gt; 0 AND [has_sftp_jobs] AND [period_num] = [Parameters].[Parameter 5]  THEN&#10;    vendor_id&#10;    ELSE NULL&#10;END&#10;) / &#10;COUNTD(&#10;IF [gmv_net_eur] &gt; 0 AND [period_num] = [Parameters].[Parameter 5]  THEN&#10;    vendor_id&#10;    ELSE NULL&#10;END&#10;)' />
      </column>
      <column caption='Ratio # updates items vs total assortment (copy)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Ratio # updates items vs total assortment (copy)_1278529740250648598]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;    (&#10;    SUM(&#10;        [nr_changed_products_completed]&#10;        ) &#10;    /&#10;        [Ratio Update Stocks (days) (copy)_1860831094976933915]&#10;    )&#10;    / &#10;    SUM(&#10;        IF [nr_changed_products_completed] &gt; 0 &#10;            THEN [vendor_assortment_total] &#10;        ELSE 0 END&#10;        )&#10;) * 100' />
      </column>
      <column caption='% SFTP Vendors - Diff (card)' datatype='real' default-format='p0.0%' name='[Ratio # updates items vs total assortment - Diff (card) (copy)_161707402986827777]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(&#10;    COUNTD(&#10;    IF [gmv_net_eur] &gt; 0 AND [has_sftp_jobs] AND [period_num] = [Parameters].[Parameter 5]  THEN&#10;        [vendor_id]&#10;        ELSE NULL&#10;    END&#10;    ) / &#10;    COUNTD(&#10;    IF [gmv_net_eur] &gt; 0 AND [period_num] = [Parameters].[Parameter 5]  THEN&#10;        [vendor_id]&#10;        ELSE NULL&#10;    END&#10;    )&#10; -&#10;    COUNTD(&#10;    IF [gmv_net_eur] &gt; 0 AND [has_sftp_jobs] AND [period_num] = [Parameters].[Cards Period 1 (copy)_1278529740053532683]  THEN&#10;        [vendor_id]&#10;        ELSE NULL&#10;    END&#10;    ) / &#10;    COUNTD(&#10;    IF [gmv_net_eur] &gt; 0 AND [period_num] = [Parameters].[Cards Period 1 (copy)_1278529740053532683]  THEN&#10;        [vendor_id]&#10;        ELSE NULL&#10;    END&#10;    )&#10;) * 100' />
      </column>
      <column caption='% SFTP Vendors - Diff Icon (card)' datatype='string' default-format='p0.0%' name='[Ratio # updates items vs total assortment - Diff Icon (card) (copy)_161707402986827778]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Ratio # updates items vs total assortment - Diff (card) (copy)_161707402986827777] &gt; 0 THEN &quot;▲&quot; &#10;ELSEIF [Ratio # updates items vs total assortment - Diff (card) (copy)_161707402986827777] &lt; 0 THEN &quot;▼&quot; &#10;ELSE &quot;●&quot;&#10;END' />
      </column>
      <column caption='# of days with SFTP Jobs for Stock' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Ratio Update Stocks (days) (copy)_1860831094976933915]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [nr_days_updated_active_count_products] &gt; 0 THEN [nr_days_updated_active_count_products] END &#10;* IF [nr_days_updated_active_count_products] &gt; 0 THEN &#10;    IF [gmv_net_eur] &gt; 0 THEN [gmv_net_eur] ELSE 1 END&#10;  END)&#10;/ &#10;SUM(IF [nr_days_updated_active_count_products] &gt; 0 THEN &#10;    IF [gmv_net_eur] &gt; 0 THEN [gmv_net_eur] ELSE 1 END&#10;END)' />
      </column>
      <column caption='SFTP Score ' datatype='real' default-format='n#,##0;-#,##0' name='[Score (copy)_3194529904769355787]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF [has_sftp_jobs] THEN [sftp_score] * [gmv_net_eur] ELSE NULL END))&#10;/ SUM(IF [has_sftp_jobs] THEN [gmv_net_eur] ELSE NULL END)' />
      </column>
      <column caption='SFTP Score Group (dark)' datatype='string' name='[Score Description (copy)_3194529905026936855]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1860831096295628849]' />
      </column>
      <column caption='Selected Period Promo' datatype='boolean' name='[Selected Period (copy)_169799810280292378]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = MAX([period_num]) THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Stocks SFTP Jobs - Diff (card)' datatype='real' default-format='p0.0%' name='[Stocks SFTP Jobs (card) (copy)_1278529740046278664]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN((&#10;    SUM(&#10;        IF [period_num] = [Parameters].[Parameter 5]&#10;            THEN [nr_jobs_updated_product_completed]&#10;            ELSE 0&#10;        END&#10;    )&#10;    /&#10;    SUM(&#10;        IF [period_num] = [Parameters].[Cards Period 1 (copy)_1278529740053532683]&#10;            THEN [nr_jobs_updated_product_completed]&#10;            ELSE 0&#10;        END&#10;    )&#10;) -1 )' />
      </column>
      <column caption='GMV (card)' datatype='real' default-format='c#,##0,,.0M&quot; €&quot;;-#,##0,,.0M&quot; €&quot;' name='[Stocks SFTP Jobs (card) (copy)_1278529740069625869]' role='measure' type='quantitative'>
