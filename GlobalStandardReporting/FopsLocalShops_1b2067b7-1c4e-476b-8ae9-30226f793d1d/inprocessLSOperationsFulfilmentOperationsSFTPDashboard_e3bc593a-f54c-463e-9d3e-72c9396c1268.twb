                <zone forceUpdate='true' h='1900' id='1834' type-v2='text' w='98529' x='588' y='9200'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='16'>Selected Metric: &lt;</run>
                    <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='16'>[Parameters].[Parameter 6]</run>
