                <zone h='2500' id='300' mode='dropdown' name='Avg. Num of Updates' param='[federated.15w313a16lxy7n1dyvkx90hmistu].[none:picking_app:nk]' type-v2='filter' values='database' w='8309' x='16985' y='6250'>
