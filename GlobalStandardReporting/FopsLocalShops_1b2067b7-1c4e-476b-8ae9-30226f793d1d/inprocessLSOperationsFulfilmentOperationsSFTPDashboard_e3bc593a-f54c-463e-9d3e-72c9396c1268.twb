            <column caption='Nr Jobs Updated Product Completed' datatype='integer' default-format='n#,##0;-#,##0' name='[nr_jobs_updated_product_completed]' role='measure' type='quantitative' />
            <column caption='OOS Failed GMV Loss' datatype='real' default-format='c#,##0,.0K&quot; €&quot;;-#,##0,.0K&quot; €&quot;' name='[oos_failed_pelican_orders_items_price_eur]' role='measure' type='quantitative' />
            <column-instance column='[gmv_net_eur]' derivation='Sum' name='[pcto:sum:gmv_net_eur:qk:2]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Columns' type='PctTotal' />
            </column-instance>
            <column caption='Picking App' datatype='string' name='[picking_app]' role='dimension' type='nominal' />
            <column caption='Ratio # updates items vs total assortment _' datatype='real' default-format='p0.0%' name='[ratio_num_updates_items_vs_total_assortment]' role='measure' type='quantitative' />
            <column caption='Replaced Pelican Total Price Eur' datatype='real' name='[replaced_pelican_total_price_eur]' role='measure' type='quantitative' />
