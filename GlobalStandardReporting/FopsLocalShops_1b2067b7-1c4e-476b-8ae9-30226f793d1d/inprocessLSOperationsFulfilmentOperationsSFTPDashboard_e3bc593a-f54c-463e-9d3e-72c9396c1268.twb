                <zone forceUpdate='true' h='3100' id='1040' type-v2='text' w='18088' x='76765' y='1400'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontsize='11'>SFTP Promotions</run>
                    <run fontalignment='1'>Æ&#10;</run>
