      <table>
        <view>
          <datasources>
            <datasource caption='Main View' name='federated.0zxge8j1frhq461buylsa0vaaso6' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Monthly Vendor Fail Rate' datatype='real' datatype-customized='true' default-format='p0%' name='[Monthly Confirmed Orders (copy)_647533240642424954]' param-domain-type='range' role='measure' type='quantitative' value='0.25'>
              <calculation class='tableau' formula='0.25' />
              <range granularity='0.01' max='1.0' min='0.0' />
            </column>
            <column caption='Monthly CVR3' datatype='real' datatype-customized='true' default-format='p0%' name='[Monthly Vendor Fail Rate (copy)_3018537709788790792]' param-domain-type='range' role='measure' type='quantitative' value='0.01'>
              <calculation class='tableau' formula='0.01' />
              <range granularity='0.01' max='1.0' min='0.0' />
            </column>
            <column caption='Monthly Fill Rate' datatype='real' datatype-customized='true' default-format='p0%' name='[Monthly Vendor Fail Rate (copy)_647533241003376771]' param-domain-type='range' role='measure' type='quantitative' value='0.5'>
              <calculation class='tableau' formula='0.5' />
              <range granularity='0.01' max='1.0' min='0.0' />
            </column>
            <column caption='Monthly Confirmed Orders' datatype='integer' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='10'>
              <calculation class='tableau' formula='10' />
              <range granularity='1' max='100' min='0' />
            </column>
            <column caption='Logic' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;OR&quot;'>
              <calculation class='tableau' formula='&quot;OR&quot;' />
            </column>
            <column caption='Ignore Vendor with more than x Orders' datatype='integer' name='[Parameter 3]' param-domain-type='range' role='measure' type='quantitative' value='30'>
              <calculation class='tableau' formula='30' />
              <range granularity='1' max='500' min='1' />
            </column>
            <column caption='Monthly OOS FR' datatype='real' default-format='p0%' name='[Parameter 4]' param-domain-type='range' role='measure' type='quantitative' value='0.3'>
              <calculation class='tableau' formula='0.3' />
              <range granularity='0.01' max='1.0' min='0.0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0zxge8j1frhq461buylsa0vaaso6'>
            <column caption='# Basket Size (Not Filtered)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[# Basket Size (Filtered) (copy)_1756122380595982336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [# of Vendors (Filtered) (copy)_1495546972540223488] = FALSE AND [confirmed_orders] &gt; 0 THEN [qty_ordered] ELSE 0 END)&#10;/ SUM(IF [# of Vendors (Filtered) (copy)_1495546972540223488] = FALSE THEN [confirmed_orders] ELSE 0 END)' />
            </column>
            <column caption='# NPS AO (Not Filtered)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[# NPS AO (Filtered) (copy)_1756122380597174274]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF [has_NPS] AND [# of Vendors (Filtered) (copy)_1495546972540223488] = FALSE THEN [nps_ao_score] END)' />
            </column>
            <column caption='# Shop Details Sessions (Not Filtered)' datatype='real' name='[# Shop Details Sessions (Filtered) (copy)_1756122380597686279]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [# of Vendors (Filtered) (copy)_1495546972540223488] = FALSE THEN [shop_details_loaded] ELSE 0 END)' />
            </column>
            <column caption='# Total Orders (Not Filtered)' datatype='integer' name='[# Total Orders (Filtered) (copy)_1756122380596686849]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [# of Vendors (Filtered) (copy)_1495546972540223488] = FALSE THEN [total_orders] END)' />
            </column>
            <column caption='# of 1 Vendor Customers (Not Filtered)' datatype='real' name='[# of 1 Vendor Customers (Filtered) (copy)_1756122380597354499]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [# of Vendors (Filtered) (copy)_1495546972540223488] = FALSE THEN [unique_customers] ELSE 0 END) / COUNTD(MONTH([date]))' />
            </column>
            <column caption='# of Sessions per Vendors (Not Filtered)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[# of Sessions per Vendors (Filtered) (copy)_1756122380597448708]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [# of Vendors (Filtered) (copy)_1495546972540223488] = FALSE THEN [shop_details_loaded] ELSE 0 END) / COUNTD(CASE [is_online] AND [# of Vendors (Filtered) (copy)_1495546972540223488] = FALSE WHEN TRUE THEN [vendor_id] ELSE NULL END)' />
            </column>
            <column caption='Filter' datatype='boolean' name='[# of Vendors (Filtered) (copy)_1495546972540223488]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &apos;OR&apos; THEN&#10;        IF [Orders Filter (copy)_647533240706908288] THEN TRUE&#10;        ELSEIF [Calculation_647533240698142845] &#10;            AND [Has more orders than parameter (copy)_647533240698761342]&#10;            AND [Vendor FR Filter (copy)_647533240989343873]&#10;            AND [OOS FR Filter (copy)_647533241004765316]&#10;            AND [Vendor FR Filter (copy)_3018537709788381190]&#10;            THEN TRUE &#10;            ELSE FALSE &#10;        END&#10;    ELSE&#10;        IF [Orders Filter (copy)_647533240706908288] THEN TRUE&#10;        ELSEIF [Calculation_647533240698142845] THEN TRUE &#10;            ELSEIF [Has more orders than parameter (copy)_647533240698761342] THEN TRUE &#10;            ELSEIF [Vendor FR Filter (copy)_647533240989343873] THEN TRUE &#10;            ELSEIF [OOS FR Filter (copy)_647533241004765316] THEN TRUE &#10;            ELSEIF [Vendor FR Filter (copy)_3018537709788381190] THEN TRUE &#10;            ELSE FALSE &#10;        END&#10;END' />
            </column>
            <column caption='# of Vendors (Not Filtered)' datatype='integer' name='[# of Vendors (Filtered) (copy)_1756122380597563397]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(CASE [is_online] WHEN TRUE THEN &#10;IF [# of Vendors (Filtered) (copy)_1495546972540223488] = FALSE THEN [vendor_id] ELSE NULL END&#10;ELSE NULL END)' />
            </column>
            <column caption='# of Vendors per Acc Manager (Not Filtered)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[# of Vendors per Acc Manager (Filtered) (copy)_1756122380597624838]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(CASE [is_online] AND [# of Vendors (Filtered) (copy)_1495546972540223488] = FALSE WHEN TRUE THEN [vendor_id] ELSE NULL END) / COUNTD([account_manager])' />
            </column>
            <column caption='$ GMV Net Eur (Not Filtered)' datatype='real' default-format='n#,##0;-#,##0' name='[$ GMV Net Eur (Filtered) (copy)_1756122380598104085]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [# of Vendors (Filtered) (copy)_1495546972540223488] = FALSE AND [confirmed_orders] &gt; 0 THEN [gmv_net_eur] ELSE 0 END)' />
            </column>
            <column caption='$ GMV Net per Order (Not Filtered)' datatype='real' default-format='c#,##0.0;-#,##0.0' name='[$ GMV Net per Order (Filtered) (copy)_1756122380598112278]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [confirmed_orders] &gt; 0 AND [# of Vendors (Filtered) (copy)_1495546972540223488] = FALSE THEN [gmv_net_eur] ELSE 0 END) / SUM(IF [# of Vendors (Filtered) (copy)_1495546972540223488] = FALSE THEN [confirmed_orders] ELSE 0 END)' />
            </column>
            <column caption='$ GMV per Active Vendor (Not Filtered)' datatype='real' default-format='c#,##0;-#,##0' name='[$ GMV per Active Vendor (Filtered) (copy)_1756122380598120471]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [confirmed_orders] &gt; 0 AND [# of Vendors (Filtered) (copy)_1495546972540223488] = FALSE THEN [gmv_net_eur] ELSE 0 END) / COUNTD(IF [is_online] AND [# of Vendors (Filtered) (copy)_1495546972540223488] = FALSE AND [confirmed_orders] &gt; 0 THEN [vendor_id] ELSE NULL END)' />
            </column>
            <column caption='% CVR3 (Not Filtered)' datatype='real' default-format='p0.0%' name='[% CVR3 (Filtered) (copy)_1756122380597809161]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [# of Vendors (Filtered) (copy)_1495546972540223488] = FALSE THEN [transaction_and_shop_details_loaded] ELSE 0 END) / SUM(IF [# of Vendors (Filtered) (copy)_1495546972540223488] = FALSE THEN [shop_details_loaded] ELSE 0 END)' />
            </column>
            <column caption='% Confirmed Orders (Not Filtered)' datatype='real' default-format='p0.0%' name='[% Confirmed Orders (Filtered) (copy)_1756122380597747720]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [# of Vendors (Filtered) (copy)_1495546972540223488] = FALSE THEN [confirmed_orders] ELSE 0 END)/SUM(IF [# of Vendors (Filtered) (copy)_1495546972540223488] = FALSE THEN [total_orders] ELSE 0 END)' />
            </column>
            <column caption='% Discounts + Voucher / GMV Net (Not Filtered)' datatype='real' default-format='p0.0%' name='[% Discounts + Voucher / GMV Net (Filtered) (copy)_1756122380597907466]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [# of Vendors (Filtered) (copy)_1495546972540223488] = FALSE THEN [discount_eur] ELSE 0 END) + SUM(IF [# of Vendors (Filtered) (copy)_1495546972540223488] = FALSE THEN [vouchers_eur] ELSE 0 END))&#10;/ SUM(IF [# of Vendors (Filtered) (copy)_1495546972540223488] = FALSE THEN [gmv_net_eur] ELSE 0 END)' />
            </column>
            <column caption='% Fail Rate (Not Filtered)' datatype='real' default-format='p0.00%' name='[% Fail Rate (Filtered) (copy)_1756122380597981195]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [# of Vendors (Filtered) (copy)_1495546972540223488] = FALSE THEN [failed_orders] END)/SUM(IF [# of Vendors (Filtered) (copy)_1495546972540223488] = FALSE THEN [total_orders] END)' />
            </column>
            <column caption='% Fill Rate (Not Filtered)' datatype='real' default-format='p0.0%' name='[% Fill Rate (Filtered) (copy)_1756122380598013964]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [confirmed_orders] &gt; 0 and [picking_app] = &apos;pelican&apos; and [# of Vendors (Filtered) (copy)_1495546972540223488] = FALSE THEN [qty_sold] ELSE NULL END) &#10;/ SUM(IF [confirmed_orders] &gt; 0 and [picking_app] = &apos;pelican&apos; and [# of Vendors (Filtered) (copy)_1495546972540223488] = FALSE THEN [qty_ordered] ELSE NULL END)' />
            </column>
            <column caption='% GMV loss due to OOS (Not Filtered)' datatype='real' default-format='p0.0%' name='[% GMV loss due to OOS (Filtered) (copy)_1756122380598022157]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF LOWER([picking_app]) = &apos;pelican&apos; AND [# of Vendors (Filtered) (copy)_1495546972540223488] = FALSE THEN [partial_fulfillment_loss_eur_pelican] END) + &#10;SUM(IF [failed_due_to_oos] &gt; 0 AND LOWER([picking_app]) = &apos;pelican&apos; AND [# of Vendors (Filtered) (copy)_1495546972540223488] = FALSE THEN [gmv_net_eur] END))&#10;/ &#10;SUM(IF LOWER([picking_app]) = &apos;pelican&apos; AND [# of Vendors (Filtered) (copy)_1495546972540223488] = FALSE THEN [gmv_net_eur] ELSE 0 END)' />
            </column>
            <column caption='% OOS Fail Rate (Not Filtered)' datatype='real' default-format='p0.00%' name='[% OOS Fail Rate (Filtered) (copy)_1756122380598054928]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [failed_orders] &gt; 0 AND [failed_due_to_oos] &gt; 0 AND [# of Vendors (Filtered) (copy)_1495546972540223488] = FALSE THEN [total_orders] ELSE NULL END) &#10;/ SUM(IF [# of Vendors (Filtered) (copy)_1495546972540223488] = FALSE THEN [total_orders] ELSE 0 END)' />
            </column>
            <column caption='% Online Payment Orders (Not Filtered)' datatype='real' default-format='p0.0%' name='[% Online Payment Orders (Filtered) (copy)_1756122380598042639]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF LOWER([payment_type]) = &apos;online&apos; AND [# of Vendors (Filtered) (copy)_1495546972540223488] = FALSE THEN [confirmed_orders] END) / SUM(IF [# of Vendors (Filtered) (copy)_1495546972540223488] = FALSE THEN [confirmed_orders] END)' />
            </column>
            <column caption='% Online Payment Orders (Filtered)' datatype='real' default-format='p0.0%' name='[% Online Payment Orders (copy)_647533240284184642]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF LOWER([payment_type]) = &apos;online&apos; AND [# of Vendors (Filtered) (copy)_1495546972540223488] THEN [confirmed_orders] END) / SUM(IF [# of Vendors (Filtered) (copy)_1495546972540223488] THEN [confirmed_orders] END)' />
            </column>
            <column caption='% Partial Fulfilment (Not Filtered)' datatype='real' default-format='p0.0%' name='[% Partial Fulfilment (Filtered) (copy)_1756122380598063121]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [# of Vendors (Filtered) (copy)_1495546972540223488] = FALSE THEN [partial_orders_pelican] END)&#10;/ SUM(IF LOWER([picking_app]) = &apos;pelican&apos; AND [# of Vendors (Filtered) (copy)_1495546972540223488] = FALSE THEN [confirmed_orders] END)' />
            </column>
            <column caption='% Pelican Orders (Not Filtered)' datatype='real' default-format='p0.0%' name='[% Pelican Orders (Filtered) (copy)_1756122380598071314]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF LOWER([picking_app]) = &apos;pelican&apos; AND [# of Vendors (Filtered) (copy)_1495546972540223488] = FALSE THEN [confirmed_orders] END) / SUM(IF [# of Vendors (Filtered) (copy)_1495546972540223488] = FALSE THEN [confirmed_orders] END)' />
            </column>
            <column caption='% Replacement (Not Filtered)' datatype='real' default-format='p0.0%' name='[% Replacement (Filtered) (copy)_1756122380598083603]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF &#10;        CASE lower([picking_app])&#10;            WHEN &apos;pelican&apos;&#10;            THEN [failed_due_to_oos]&#10;            ELSE 0 &#10;        END &#10;        + [partial_orders_old] &gt; 0 &#10;        THEN IF [Calculation_647533240065122359] = TRUE AND [# of Vendors (Filtered) (copy)_1495546972540223488] = FALSE THEN [replacements_orders_pelican] ELSE 0 END&#10;        ELSE 0 &#10;    END)&#10;/ SUM(IF [Calculation_647533240065122359] = TRUE AND [# of Vendors (Filtered) (copy)_1495546972540223488] = FALSE THEN [Calculation_647533240064127029] ELSE 0 END)' />
            </column>
            <column caption='% Vendor Fail Rate (Not Filtered)' datatype='real' default-format='p0.00%' name='[% Vendor Fail Rate (Filtered) (copy)_1756122380598091796]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [failed_orders] &gt; 0 AND [failure_owner] = &apos;restaurant&apos; AND [# of Vendors (Filtered) (copy)_1495546972540223488] = FALSE THEN [total_orders] ELSE NULL END) &#10;/ SUM(IF [# of Vendors (Filtered) (copy)_1495546972540223488] = FALSE THEN [total_orders] ELSE 0 END)' />
            </column>
            <column caption='% mCVR3 (Not Filtered)' datatype='real' default-format='p0.0%' name='[% mCVR3 (Filtered) (copy)_1756122380598034446]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [# of Vendors (Filtered) (copy)_1495546972540223488] = FALSE THEN [checkout_loaded] ELSE 0 END) / SUM(IF [# of Vendors (Filtered) (copy)_1495546972540223488] = FALSE THEN [shop_details_loaded] ELSE 0 END)' />
            </column>
            <column caption='% CVR3' datatype='real' default-format='p0.0%' name='[CVR2 (copy)_444449047152603137]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([transaction_and_shop_details_loaded]) / SUM([shop_details_loaded])' />
            </column>
            <column caption='&apos;TO DELIST&apos;' datatype='string' name='[Calculation_1756122380602114072]' role='dimension' type='nominal' user:unnamed='Not Filtered'>
