  <worksheets>
    <worksheet name='Download List '>
      <table>
        <view>
          <datasources>
            <datasource caption='Main View' name='federated.0zxge8j1frhq461buylsa0vaaso6' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Monthly Vendor Fail Rate' datatype='real' datatype-customized='true' default-format='p0%' name='[Monthly Confirmed Orders (copy)_647533240642424954]' param-domain-type='range' role='measure' type='quantitative' value='0.25'>
              <calculation class='tableau' formula='0.25' />
              <range granularity='0.01' max='1.0' min='0.0' />
            </column>
            <column caption='Monthly CVR3' datatype='real' datatype-customized='true' default-format='p0%' name='[Monthly Vendor Fail Rate (copy)_3018537709788790792]' param-domain-type='range' role='measure' type='quantitative' value='0.01'>
              <calculation class='tableau' formula='0.01' />
              <range granularity='0.01' max='1.0' min='0.0' />
            </column>
            <column caption='Monthly Fill Rate' datatype='real' datatype-customized='true' default-format='p0%' name='[Monthly Vendor Fail Rate (copy)_647533241003376771]' param-domain-type='range' role='measure' type='quantitative' value='0.5'>
              <calculation class='tableau' formula='0.5' />
              <range granularity='0.01' max='1.0' min='0.0' />
            </column>
            <column caption='Monthly Confirmed Orders' datatype='integer' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='10'>
              <calculation class='tableau' formula='10' />
              <range granularity='1' max='100' min='0' />
            </column>
            <column caption='Logic' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;OR&quot;'>
              <calculation class='tableau' formula='&quot;OR&quot;' />
            </column>
            <column caption='Ignore Vendor with more than x Orders' datatype='integer' name='[Parameter 3]' param-domain-type='range' role='measure' type='quantitative' value='30'>
              <calculation class='tableau' formula='30' />
              <range granularity='1' max='500' min='1' />
            </column>
            <column caption='Monthly OOS FR' datatype='real' default-format='p0%' name='[Parameter 4]' param-domain-type='range' role='measure' type='quantitative' value='0.3'>
              <calculation class='tableau' formula='0.3' />
              <range granularity='0.01' max='1.0' min='0.0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0zxge8j1frhq461buylsa0vaaso6'>
            <column caption='Filter' datatype='boolean' name='[# of Vendors (Filtered) (copy)_1495546972540223488]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &apos;OR&apos; THEN&#10;        IF [Orders Filter (copy)_647533240706908288] THEN TRUE&#10;        ELSEIF [Calculation_647533240698142845] &#10;            AND [Has more orders than parameter (copy)_647533240698761342]&#10;            AND [Vendor FR Filter (copy)_647533240989343873]&#10;            AND [OOS FR Filter (copy)_647533241004765316]&#10;            AND [Vendor FR Filter (copy)_3018537709788381190]&#10;            THEN TRUE &#10;            ELSE FALSE &#10;        END&#10;    ELSE&#10;        IF [Orders Filter (copy)_647533240706908288] THEN TRUE&#10;        ELSEIF [Calculation_647533240698142845] THEN TRUE &#10;            ELSEIF [Has more orders than parameter (copy)_647533240698761342] THEN TRUE &#10;            ELSEIF [Vendor FR Filter (copy)_647533240989343873] THEN TRUE &#10;            ELSEIF [OOS FR Filter (copy)_647533241004765316] THEN TRUE &#10;            ELSEIF [Vendor FR Filter (copy)_3018537709788381190] THEN TRUE &#10;            ELSE FALSE &#10;        END&#10;END' />
            </column>
            <column caption='% CVR3' datatype='real' default-format='p0.0%' name='[CVR2 (copy)_444449047152603137]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([transaction_and_shop_details_loaded]) / SUM([shop_details_loaded])' />
            </column>
            <column caption='Vendor Activation Local Date ' datatype='string' name='[Calculation_1756122380796067867]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([vendor_activation_local_date])' />
            </column>
            <column caption='Vendors Monthly Orders' datatype='integer' name='[Calculation_270567873544331264]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [granularity], [date],[global_entity_id],[vendor_id] : ZN(SUM([confirmed_orders]))}' />
            </column>
            <column caption='Vendor Activation Month' datatype='date' name='[Calculation_2813623868326801410]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;,[vendor_activation_local_date]))' />
            </column>
            <column caption='Year Month Order Date' datatype='string' name='[Calculation_2813623868329828355]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(DATEPART(&apos;year&apos;, [date]))+&apos; - &apos;+STR(DATEPART(&apos;month&apos;, [date]))' />
            </column>
            <column caption='Brand - Country' datatype='string' name='[Calculation_3250261974472224773]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[brand]+[country]' />
            </column>
            <column caption='% Vendor Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_3713217946399465479]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [failed_orders] &gt; 0 AND [failure_owner] = &apos;restaurant&apos; THEN [total_orders] ELSE NULL END) &#10;/ SUM([total_orders])' />
            </column>
            <column caption='# Shop Details Sessions' datatype='real' name='[Calculation_444449047214571524]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([shop_details_loaded])' />
            </column>
            <column caption='# Basket Size' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_647533239948455937]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [confirmed_orders] &gt; 0 THEN [qty_ordered] ELSE 0 END)/SUM([confirmed_orders])' />
            </column>
            <column caption='% Fill Rate' datatype='real' default-format='p0.0%' name='[Calculation_647533239992664074]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [confirmed_orders] &gt; 0 and [picking_app] = &apos;pelican&apos; THEN [qty_sold] ELSE NULL END) &#10;/ SUM(IF [confirmed_orders] &gt; 0 and [picking_app] = &apos;pelican&apos; THEN [qty_ordered] ELSE NULL END)' />
            </column>
            <column caption='Eligible Order for Replacement' datatype='integer' name='[Calculation_647533240064127029]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF LOWER([picking_app]) = &apos;pelican&apos; THEN [failed_due_to_oos] + [partial_orders_old] END' />
            </column>
            <column caption='Has the vendor &gt; 1 replaced order per month' datatype='boolean' name='[Calculation_647533240065122359]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{FIXED [granularity], [global_entity_id], [vendor_name], DATETRUNC(&apos;month&apos;, [date]) :&#10;IF SUM([replacements_orders_pelican]) &gt; 0 THEN TRUE ELSE FALSE END }' />
            </column>
            <column caption='% Replacement' datatype='real' default-format='p0.0%' name='[Calculation_647533240065712184]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF &#10;        CASE lower([picking_app])&#10;            WHEN &apos;pelican&apos;&#10;            THEN [failed_due_to_oos]&#10;            ELSE 0 &#10;        END &#10;        + [partial_orders_old] &gt; 0 &#10;        THEN IF [Calculation_647533240065122359] = TRUE THEN [replacements_orders_pelican] ELSE 0 END&#10;        ELSE 0 &#10;    END)&#10;/ SUM(IF [Calculation_647533240065122359] = TRUE THEN [Calculation_647533240064127029] ELSE 0 END)' />
            </column>
            <column caption='% Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_647533240067129402]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_orders])/SUM([total_orders])' />
            </column>
            <column caption='% GMV loss due to OOS' datatype='real' default-format='p0.0%' name='[Calculation_647533240070008893]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF LOWER([picking_app]) = &apos;pelican&apos; THEN [partial_fulfillment_loss_eur_pelican] END) + &#10;SUM(IF [failed_due_to_oos] &gt; 0 AND LOWER([picking_app]) = &apos;pelican&apos; THEN [gmv_net_eur] END))&#10;/ &#10;SUM(IF LOWER([picking_app]) = &apos;pelican&apos; THEN [gmv_net_eur] ELSE 0 END)' />
            </column>
            <column caption='% Partial Fulfilment' datatype='real' default-format='p0.0%' name='[Calculation_647533240073936959]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([partial_orders_pelican])&#10;/ SUM(IF LOWER([picking_app]) = &apos;pelican&apos; THEN [confirmed_orders] END)' />
            </column>
            <column caption='% Online Payment Orders' datatype='real' default-format='p0.0%' name='[Calculation_647533240283680833]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF LOWER([payment_type]) = &apos;online&apos; THEN [confirmed_orders] END) / SUM([confirmed_orders])' />
            </column>
            <column caption='% Discounts + Voucher / GMV Net' datatype='real' default-format='p0.0%' name='[Calculation_647533240291176515]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([discount_eur]) + SUM([vouchers_eur])) / SUM([gmv_net_eur])' />
            </column>
            <column caption='# NPS AO' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_647533240293605445]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF [has_NPS] THEN [nps_ao_score] END)' />
            </column>
            <column caption='# Total Orders' datatype='integer' name='[Calculation_647533240303104078]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_orders])' />
            </column>
            <column caption='Orders Filter' datatype='boolean' name='[Calculation_647533240698142845]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_270567873544331264] &gt;= [Parameters].[Parameter 1] THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='ID' datatype='string' name='[Calculation_647533241036054664]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[global_entity_id] + [vendor_id]' />
            </column>
            <column caption='% Confirmed Orders ' datatype='real' default-format='p0.0%' name='[Confirmed Orders (Filtered) (copy)_647533240031666225]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([confirmed_orders])/SUM([total_orders])' />
            </column>
            <column caption='$ GMV Net per Order' datatype='real' default-format='c#,##0.0;-#,##0.0' name='[GMV Net (copy)_647533240060964915]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [confirmed_orders] &gt; 0 THEN [gmv_net_eur] ELSE 0 END) / SUM([confirmed_orders])' />
            </column>
            <column caption='$ GMV Net Eur' datatype='real' default-format='n#,##0;-#,##0' name='[GMV Net Eur (Filtered) (copy)_647533240060829746]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [confirmed_orders] &gt; 0 THEN [gmv_net_eur] ELSE 0 END)' />
            </column>
            <column caption='Vendor FR Filter' datatype='boolean' name='[Has more orders than parameter (copy)_647533240698761342]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Monthly Confirmed Orders (copy)_647533240642424954] = 1 THEN TRUE&#10;ELSEIF [Calculation_270567873544331264] = 0 THEN FALSE&#10;ELSEIF [Vendors Monthly Orders (copy)_647533240699199615] &gt; [Parameters].[Monthly Confirmed Orders (copy)_647533240642424954] THEN FALSE &#10;ELSE TRUE END' />
            </column>
            <column caption='Fill Rate Filter' datatype='boolean' name='[OOS FR Filter (copy)_647533241004765316]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Monthly Vendor Fail Rate (copy)_647533241003376771] = 1 THEN TRUE&#10;ELSEIF [picking_app] != &apos;pelican&apos; THEN TRUE&#10;ELSEIF [Vendors Monthly Vendor FR (copy)_647533241005138053] = 0 THEN FALSE&#10;ELSEIF [Vendors Monthly Vendor FR (copy)_647533241005138053] &lt; [Parameters].[Monthly Vendor Fail Rate (copy)_647533241003376771] THEN FALSE &#10;ELSE TRUE END' />
            </column>
            <column caption='Orders Filter (ignore)' datatype='boolean' name='[Orders Filter (copy)_647533240706908288]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_270567873544331264] &gt;= [Parameters].[Parameter 3] THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='CVR3 Filter' datatype='boolean' name='[Vendor FR Filter (copy)_3018537709788381190]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Monthly Vendor Fail Rate (copy)_3018537709788790792] = 0 THEN TRUE&#10;ELSEIF [Calculation_270567873544331264] = 0 THEN FALSE&#10;ELSEIF [Vendors Monthly Vendor FR (copy)_3018537709788459015] &lt; [Parameters].[Monthly Vendor Fail Rate (copy)_3018537709788790792] THEN FALSE &#10;ELSE TRUE END' />
            </column>
            <column caption='OOS FR Filter' datatype='boolean' name='[Vendor FR Filter (copy)_647533240989343873]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = 1 THEN TRUE&#10;ELSEIF [Calculation_270567873544331264] = 0 THEN FALSE&#10;ELSEIF [Vendors Monthly Vendor FR (copy)_647533240989405314] &gt; [Parameters].[Parameter 4] THEN FALSE &#10;ELSE TRUE END' />
            </column>
            <column caption='% OOS Fail Rate' datatype='real' default-format='p0.00%' name='[Vendor Fail Rate (copy)_3713217946405101580]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [failed_orders] &gt; 0 AND [failed_due_to_oos] &gt; 0 THEN [total_orders] ELSE NULL END) &#10;/ SUM([total_orders])' />
            </column>
            <column caption='Vendors Monthly Vendor FR' datatype='real' name='[Vendors Monthly Orders (copy)_647533240699199615]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [granularity], [date],[global_entity_id],[vendor_id] : [Calculation_3713217946399465479]}' />
            </column>
            <column caption='Vendors Monthly CVR3' datatype='real' name='[Vendors Monthly Vendor FR (copy)_3018537709788459015]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [granularity], [date],[global_entity_id],[vendor_id] : [CVR2 (copy)_444449047152603137]}' />
            </column>
            <column caption='Vendors Monthly OOS FR' datatype='real' name='[Vendors Monthly Vendor FR (copy)_647533240989405314]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [granularity], [date],[global_entity_id],[vendor_id] : [Vendor Fail Rate (copy)_3713217946405101580]}' />
            </column>
            <column caption='Vendors Monthly Fill Rate' datatype='real' name='[Vendors Monthly Vendor FR (copy)_647533241005138053]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [granularity], [date],[global_entity_id],[vendor_id] : [Calculation_647533239992664074]}' />
            </column>
