                <zone custom-title='true' h='9000' id='540' mode='slider' param='[Parameters].[Monthly Confirmed Orders (copy)_647533240642424954]' type-v2='paramctrl' w='31028' x='442' y='56667'>
                  <formatted-text>
                    <run>Filter vendors with </run>
                    <run fontcolor='#cc061e' italic='true'>Vendor Fail Rate </run>
