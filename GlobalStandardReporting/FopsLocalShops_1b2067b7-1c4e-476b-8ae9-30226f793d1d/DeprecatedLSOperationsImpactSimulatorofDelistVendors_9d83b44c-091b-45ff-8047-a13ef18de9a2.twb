                  <formatted-text>
                    <run>Filter vendors with </run>
                    <run fontcolor='#cc061e' italic='true'>Monthly Confirmed Orders &lt;</run>
                    <run>Æ </run>
                    <run fontcolor='#cc061e'>than:</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
