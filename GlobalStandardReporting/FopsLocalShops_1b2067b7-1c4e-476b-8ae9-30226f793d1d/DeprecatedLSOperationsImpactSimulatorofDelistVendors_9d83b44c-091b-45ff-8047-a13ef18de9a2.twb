                <zone custom-title='true' h='9000' id='538' mode='slider' param='[Parameters].[Parameter 3]' type-v2='paramctrl' w='25366' x='6104' y='38667'>
                  <formatted-text>
                    <run fontsize='11'>Ignore if </run>
                    <run fontcolor='#cc061e' fontsize='11' italic='true'>Monthly Confirmed Orders &gt;= than:</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
