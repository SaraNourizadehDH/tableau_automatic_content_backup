              <calculation class='tableau' formula='[# Total Orders (copy)_647533240303165519] - [Calculation_647533240303104078]' />
            </column>
            <column caption='# Total Orders (Filtered)' datatype='integer' name='[# Total Orders (copy)_647533240303165519]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [# of Vendors (Filtered) (copy)_1495546972540223488] THEN [total_orders] END)' />
            </column>
            <column caption='# Shop Details Sessions (Filtered)' datatype='real' name='[# Total Session (copy)_444449047215996936]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [# of Vendors (Filtered) (copy)_1495546972540223488] THEN [shop_details_loaded] ELSE 0 END)' />
            </column>
            <column caption='# of Customers (Filtered - Original)' datatype='integer' hidden='true' name='[# of Customers (Filtered) (copy)_3018537709562699779]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[# of Customers (copy)_3018537709562249217] - [Calculation_3018537709561655296]' />
            </column>
            <column caption='# of Customers (Filtered)' datatype='integer' hidden='true' name='[# of Customers (copy)_3018537709562249217]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [# of Vendors (Filtered) (copy)_1495546972540223488] THEN [customer_id] ELSE NULL END)' />
            </column>
            <column caption='# of 1 Vendor Customers (Filtered - Original)' datatype='real' name='[# of Unique Customers (Filtered) (copy)_444449047529701400]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[# of Unique Customers (copy)_444449047529189399] - [Calculation_444449047529111574]' />
            </column>
            <column caption='# of 1 Vendor Customers (Filtered)' datatype='real' name='[# of Unique Customers (copy)_444449047529189399]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [# of Vendors (Filtered) (copy)_1495546972540223488] THEN [unique_customers] ELSE 0 END) / COUNTD(MONTH(date))' />
            </column>
            <column caption='Filter' datatype='boolean' name='[# of Vendors (Filtered) (copy)_1495546972540223488]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &apos;OR&apos; THEN&#10;        IF [Orders Filter (copy)_647533240706908288] THEN TRUE&#10;        ELSEIF [Calculation_647533240698142845] &#10;            AND [Has more orders than parameter (copy)_647533240698761342]&#10;            AND [Vendor FR Filter (copy)_647533240989343873]&#10;            AND [OOS FR Filter (copy)_647533241004765316]&#10;            AND [Vendor FR Filter (copy)_3018537709788381190]&#10;            THEN TRUE &#10;            ELSE FALSE &#10;        END&#10;    ELSE&#10;        IF [Orders Filter (copy)_647533240706908288] THEN TRUE&#10;        ELSEIF [Calculation_647533240698142845] THEN TRUE &#10;            ELSEIF [Has more orders than parameter (copy)_647533240698761342] THEN TRUE &#10;            ELSEIF [Vendor FR Filter (copy)_647533240989343873] THEN TRUE &#10;            ELSEIF [OOS FR Filter (copy)_647533241004765316] THEN TRUE &#10;            ELSEIF [Vendor FR Filter (copy)_3018537709788381190] THEN TRUE &#10;            ELSE FALSE &#10;        END&#10;END' />
            </column>
            <column caption='# of Vendors (Filtered - Original)' datatype='integer' name='[# of Vendors (Filtered) (copy)_647533240320610389]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[# of Vendors (copy)_586382797465059333] - [Calculation_3250261974487134214]' />
            </column>
            <column caption='# of Vendors (Filtered)' datatype='integer' name='[# of Vendors (copy)_586382797465059333]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(CASE [is_online] WHEN TRUE THEN &#10;IF [# of Vendors (Filtered) (copy)_1495546972540223488] THEN [vendor_id] ELSE NULL END&#10;ELSE NULL END)' />
            </column>
            <column caption='# of Vendors per Acc Manager' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[# of Vendors (copy)_647533240012894234]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(CASE [is_online] WHEN TRUE THEN [vendor_id] ELSE NULL END) / COUNTD([account_manager])' />
            </column>
            <column caption='# of Sessions per Vendor (Filtered - Original)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[# of Vendors per Acc Manager (Filtered - Original) (copy)_444449047458783251]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[# of Vendors per Acc Manager (Filtered) (copy)_444449047458783252] - [# of Vendors per Acc Manager (copy)_444449047458783249]' />
            </column>
            <column caption='# of Sessions per Vendors (Filtered)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[# of Vendors per Acc Manager (Filtered) (copy)_444449047458783252]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [# of Vendors (Filtered) (copy)_1495546972540223488] THEN [shop_details_loaded] ELSE 0 END) / COUNTD(CASE [is_online] AND [# of Vendors (Filtered) (copy)_1495546972540223488] WHEN TRUE THEN [vendor_id] ELSE NULL END)' />
            </column>
            <column caption='# of Vendors per Acc Manager (Filtered - Original)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[# of Vendors per Acc Manager (Filtered) (copy)_647533240318107731]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[# of Vendors per Acc Manager (copy)_647533240013041691] - [# of Vendors (copy)_647533240012894234]' />
            </column>
            <column caption='# of Sessions per Vendors' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[# of Vendors per Acc Manager (copy)_444449047458783249]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([shop_details_loaded]) / COUNTD(CASE [is_online] WHEN TRUE THEN [vendor_id] ELSE NULL END)' />
            </column>
            <column caption='# of Vendors per Acc Manager (Filtered)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[# of Vendors per Acc Manager (copy)_647533240013041691]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(CASE [is_online] AND [# of Vendors (Filtered) (copy)_1495546972540223488] WHEN TRUE THEN [vendor_id] ELSE NULL END) / COUNTD([account_manager])' />
            </column>
            <column caption='$ GMV per Active Vendor' datatype='real' default-format='c#,##0;-#,##0' name='[# of Vendors per Acc Manager (copy)_647533240015921182]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [confirmed_orders] &gt; 0 THEN [gmv_net_eur] ELSE 0 END) / COUNTD(IF [is_online] AND [confirmed_orders] &gt; 0 THEN [vendor_id] ELSE NULL END)' />
            </column>
            <column caption='$ GMV Net Eur (Filtered - Original)' datatype='real' default-format='n#,##0;-#,##0' name='[$ GMV Net Eur (Filtered) (copy)_647533240354209903]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_270567873545916417] - [GMV Net Eur (Filtered) (copy)_647533240060829746]' />
            </column>
            <column caption='$ GMV Net per Order (Filtered - Original)' datatype='real' default-format='c#,##0.0;-#,##0.0' name='[$ GMV Net per Order (Filtered) (copy)_647533240354766961]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[GMV Net per Order (copy)_647533240061292596] - [GMV Net (copy)_647533240060964915]' />
            </column>
            <column caption='% CVR3 (Filtered - Original)' datatype='real' default-format='p0.0%' name='[% CVR3 (Filtered) (copy)_444449047442055177]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[% CVR3 (copy)_444449047215194118] - [CVR2 (copy)_444449047152603137]' />
            </column>
            <column caption='% CVR3 (Filtered)' datatype='real' default-format='p0.0%' name='[% CVR3 (copy)_444449047215194118]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [# of Vendors (Filtered) (copy)_1495546972540223488] THEN [transaction_and_shop_details_loaded] ELSE 0 END) / SUM(IF [# of Vendors (Filtered) (copy)_1495546972540223488] THEN [shop_details_loaded] ELSE 0 END)' />
            </column>
            <column caption='% Confirmed Orders (Filtered - Original)' datatype='real' default-format='p0.0%' name='[% Confirmed Orders (Filtered) (copy)_647533240300843082]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_647533240001052686] - [Confirmed Orders (Filtered) (copy)_647533240031666225]' />
            </column>
            <column caption='% Discounts + Voucher / GMV Net (Filtered - Original)' datatype='real' default-format='p0.0%' name='[% Discounts + Voucher / GMV Net (Filtered) (copy)_647533240347930713]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[% Discounts + Voucher / GMV Net (copy)_647533240292630596] - [Calculation_647533240291176515]' />
            </column>
            <column caption='% Discounts + Voucher / GMV Net (Filtered)' datatype='real' default-format='p0.0%' name='[% Discounts + Voucher / GMV Net (copy)_647533240292630596]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [# of Vendors (Filtered) (copy)_1495546972540223488] THEN [discount_eur] ELSE 0 END) + SUM(IF [# of Vendors (Filtered) (copy)_1495546972540223488] THEN [vouchers_eur] ELSE 0 END))&#10;/ SUM(IF [# of Vendors (Filtered) (copy)_1495546972540223488] THEN [gmv_net_eur] ELSE 0 END)' />
            </column>
            <column caption='% Fail Rate (Filtered - Original)' datatype='real' default-format='p0.00%' name='[% Fail Rate (Filtered) (copy)_647533240348483675]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[% Fail Rate (copy)_647533240067244091] - [Calculation_647533240067129402]' />
            </column>
            <column caption='% Fail Rate (Filtered)' datatype='real' default-format='p0.00%' name='[% Fail Rate (copy)_647533240067244091]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [# of Vendors (Filtered) (copy)_1495546972540223488] THEN [failed_orders] END)/SUM(IF [# of Vendors (Filtered) (copy)_1495546972540223488] THEN [total_orders] END)' />
            </column>
            <column caption='% Fill Rate (Filtered - Original)' datatype='real' default-format='p0.0%' name='[% Fill Rate (Filtered) (copy)_647533240348704861]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Fill Rate (copy)_647533240006869012] - [Calculation_647533239992664074]' />
            </column>
            <column caption='% GMV loss due to OOS (Filtered - Original)' datatype='real' default-format='p0.0%' name='[% GMV loss due to OOS (Filtered) (copy)_647533240350199903]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[% GMV loss due to Partial Orders (copy)_647533240070713406] - [Calculation_647533240070008893]' />
            </column>
            <column caption='% GMV loss due to OOS (Filtered)' datatype='real' default-format='p0.0%' name='[% GMV loss due to Partial Orders (copy)_647533240070713406]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF LOWER([picking_app]) = &apos;pelican&apos; THEN [partial_fulfillment_loss_eur_pelican] END) + &#10;SUM(IF [failed_due_to_oos] &gt; 0 AND LOWER([picking_app]) = &apos;pelican&apos; AND [# of Vendors (Filtered) (copy)_1495546972540223488] THEN [gmv_net_eur] END))&#10;/ &#10;SUM(IF LOWER([picking_app]) = &apos;pelican&apos; AND [# of Vendors (Filtered) (copy)_1495546972540223488] THEN [gmv_net_eur] ELSE 0 END)' />
            </column>
            <column caption='% OOS Fail Rate (Filtered - Original)' datatype='real' default-format='p0.00%' name='[% OOS Fail Rate (Filtered) (copy)_647533240352034917]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Vendor Fail Rate (Filtered) (copy)_3713217946405228557] - [Vendor Fail Rate (copy)_3713217946405101580]' />
            </column>
            <column caption='% Online Payment Orders (Filtered)' datatype='real' default-format='p0.0%' name='[% Online Payment Orders (copy)_647533240284184642]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF LOWER([payment_type]) = &apos;online&apos; AND [# of Vendors (Filtered) (copy)_1495546972540223488] THEN [confirmed_orders] END) / SUM(IF [# of Vendors (Filtered) (copy)_1495546972540223488] THEN [confirmed_orders] END)' />
            </column>
            <column caption='% Partial Fulfilment (Filtered - Original)' datatype='real' default-format='p0.0%' name='[% Partial Fulfilment (Filtered) (copy)_647533240352501863]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[% Partial Fulfilment (copy)_647533240074346560] - [Calculation_647533240073936959]' />
            </column>
            <column caption='% Partial Fulfilment (Filtered)' datatype='real' default-format='p0.0%' name='[% Partial Fulfilment (copy)_647533240074346560]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [# of Vendors (Filtered) (copy)_1495546972540223488] THEN [partial_orders_pelican] END)&#10;/ SUM(IF LOWER([picking_app]) = &apos;pelican&apos; AND [# of Vendors (Filtered) (copy)_1495546972540223488] THEN [confirmed_orders] END)' />
