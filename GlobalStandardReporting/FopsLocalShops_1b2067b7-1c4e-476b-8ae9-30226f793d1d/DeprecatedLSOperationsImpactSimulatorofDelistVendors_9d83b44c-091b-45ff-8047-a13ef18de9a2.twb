              <calculation class='tableau' formula='IF [Parameters].[Monthly Vendor Fail Rate (copy)_3018537709788790792] = 0 THEN TRUE&#10;ELSEIF [Calculation_270567873544331264] = 0 THEN FALSE&#10;ELSEIF [Vendors Monthly Vendor FR (copy)_3018537709788459015] &lt; [Parameters].[Monthly Vendor Fail Rate (copy)_3018537709788790792] THEN FALSE &#10;ELSE TRUE END' />
