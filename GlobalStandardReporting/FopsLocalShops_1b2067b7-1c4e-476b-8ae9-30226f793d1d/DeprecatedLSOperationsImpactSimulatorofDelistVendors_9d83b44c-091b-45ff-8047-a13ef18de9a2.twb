      <column caption='Vendors Monthly Orders' datatype='integer' name='[Calculation_270567873544331264]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [granularity], [date],[global_entity_id],[vendor_id] : ZN(SUM([confirmed_orders]))}' />
      </column>
      <column caption='$ GMV Net Eur (Filtered)' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_270567873545916417]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [# of Vendors (Filtered) (copy)_1495546972540223488] AND [confirmed_orders] &gt; 0 THEN [gmv_net_eur] ELSE 0 END)' />
      </column>
      <column caption='Date Month' datatype='date' name='[Calculation_2813623868324036609]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;,[date]))' />
      </column>
      <column caption='Vendor Activation Month' datatype='date' name='[Calculation_2813623868326801410]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;,[vendor_activation_local_date]))' />
      </column>
      <column caption='Year Month Order Date' datatype='string' name='[Calculation_2813623868329828355]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(DATEPART(&apos;year&apos;, [date]))+&apos; - &apos;+STR(DATEPART(&apos;month&apos;, [date]))' />
      </column>
      <column caption='# of Customers' datatype='integer' hidden='true' name='[Calculation_3018537709561655296]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([customer_id])' />
      </column>
      <column caption='Filter ve' datatype='boolean' hidden='true' name='[Calculation_3018537709574291461]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF {FIXED [global_entity_id], [vendor_id], date : SUM([unique_customers]) } &gt;&#10;{FIXED [global_entity_id], [vendor_id], date : COUNTD([customer_id]) } THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Date ' datatype='string' name='[Calculation_3250261974471843844]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([date])' />
      </column>
      <column caption='Brand - Country' datatype='string' name='[Calculation_3250261974472224773]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[brand]+[country]' />
      </column>
      <column caption='# of Vendors' datatype='integer' name='[Calculation_3250261974487134214]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(CASE [is_online] WHEN TRUE THEN [vendor_id] ELSE NULL END)' />
      </column>
      <column caption='Orders' datatype='integer' name='[Calculation_3250261974530793483]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(CASE [order_status] WHEN &apos;sent&apos; THEN [confirmed_orders] ELSE NULL END)' />
      </column>
      <column caption='Commission Rate' datatype='real' default-format='p0.0%' name='[Calculation_3250261974569639949]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([commission_eur])/SUM([commission_base_eur])' />
      </column>
      <column caption='Commision Rate Dimension' datatype='real' name='[Calculation_3250261974571413518]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [global_entity_id],[vendor_id], [vendor_name] : ROUND([Calculation_3250261974569639949] * 100, 0)}' />
      </column>
      <column caption='% Vendor Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_3713217946399465479]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [failed_orders] &gt; 0 AND [failure_owner] = &apos;restaurant&apos; THEN [total_orders] ELSE NULL END) &#10;/ SUM([total_orders])' />
      </column>
      <column caption='% Vendor Fail Rate (Filtered)' datatype='real' default-format='p0.00%' name='[Calculation_3713217946400010248]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [failed_orders] &gt; 0 AND [failure_owner] = &apos;restaurant&apos; AND [# of Vendors (Filtered) (copy)_1495546972540223488] THEN [total_orders] ELSE NULL END) &#10;/ SUM(IF [# of Vendors (Filtered) (copy)_1495546972540223488] THEN [total_orders] ELSE 0 END)' />
      </column>
      <column caption='# Shop Details Sessions' datatype='real' name='[Calculation_444449047214571524]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([shop_details_loaded])' />
      </column>
      <column caption='# of 1 Vendor Customers' datatype='real' name='[Calculation_444449047529111574]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([unique_customers]) / COUNTD(MONTH(date))' />
      </column>
      <column caption='# Basket Size' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_647533239948455937]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [confirmed_orders] &gt; 0 THEN [qty_ordered] ELSE 0 END)/SUM([confirmed_orders])' />
      </column>
      <column caption='% Fill Rate' datatype='real' default-format='p0.0%' name='[Calculation_647533239992664074]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [confirmed_orders] &gt; 0 and [picking_app] = &apos;pelican&apos; THEN [qty_sold] ELSE NULL END) &#10;/ SUM(IF [confirmed_orders] &gt; 0 and [picking_app] = &apos;pelican&apos; THEN [qty_ordered] ELSE NULL END)' />
      </column>
      <column caption='% Confirmed Orders (Filtered)' datatype='real' default-format='p0.0%' name='[Calculation_647533240001052686]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [# of Vendors (Filtered) (copy)_1495546972540223488] THEN [confirmed_orders] ELSE 0 END)/SUM(IF [# of Vendors (Filtered) (copy)_1495546972540223488] THEN [total_orders] ELSE 0 END)' />
      </column>
      <column caption='VENDORS' datatype='integer' name='[Calculation_647533240027078696]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(NULL)' />
      </column>
      <column caption='Eligible Order for Replacement' datatype='integer' name='[Calculation_647533240064127029]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF LOWER([picking_app]) = &apos;pelican&apos; THEN [failed_due_to_oos] + [partial_orders_old] END' />
      </column>
      <column caption='Has the vendor &gt; 1 replaced order per month' datatype='boolean' name='[Calculation_647533240065122359]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{FIXED [granularity], [global_entity_id], [vendor_name], DATETRUNC(&apos;month&apos;, [date]) :&#10;IF SUM([replacements_orders_pelican]) &gt; 0 THEN TRUE ELSE FALSE END }' />
      </column>
      <column caption='% Replacement' datatype='real' default-format='p0.0%' name='[Calculation_647533240065712184]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF &#10;        CASE lower([picking_app])&#10;            WHEN &apos;pelican&apos;&#10;            THEN [failed_due_to_oos]&#10;            ELSE 0 &#10;        END &#10;        + [partial_orders_old] &gt; 0 &#10;        THEN IF [Calculation_647533240065122359] = TRUE THEN [replacements_orders_pelican] ELSE 0 END&#10;        ELSE 0 &#10;    END)&#10;/ SUM(IF [Calculation_647533240065122359] = TRUE THEN [Calculation_647533240064127029] ELSE 0 END)' />
      </column>
      <column caption='% Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_647533240067129402]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([failed_orders])/SUM([total_orders])' />
      </column>
      <column caption='% GMV loss due to OOS' datatype='real' default-format='p0.0%' name='[Calculation_647533240070008893]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF LOWER([picking_app]) = &apos;pelican&apos; THEN [partial_fulfillment_loss_eur_pelican] END) + &#10;SUM(IF [failed_due_to_oos] &gt; 0 AND LOWER([picking_app]) = &apos;pelican&apos; THEN [gmv_net_eur] END))&#10;/ &#10;SUM(IF LOWER([picking_app]) = &apos;pelican&apos; THEN [gmv_net_eur] ELSE 0 END)' />
      </column>
      <column caption='% Partial Fulfilment' datatype='real' default-format='p0.0%' name='[Calculation_647533240073936959]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([partial_orders_pelican])&#10;/ SUM(IF LOWER([picking_app]) = &apos;pelican&apos; THEN [confirmed_orders] END)' />
      </column>
      <column caption='% Online Payment Orders' datatype='real' default-format='p0.0%' name='[Calculation_647533240283680833]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF LOWER([payment_type]) = &apos;online&apos; THEN [confirmed_orders] END) / SUM([confirmed_orders])' />
      </column>
      <column caption='% Discounts + Voucher / GMV Net' datatype='real' default-format='p0.0%' name='[Calculation_647533240291176515]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([discount_eur]) + SUM([vouchers_eur])) / SUM([gmv_net_eur])' />
      </column>
      <column caption='# NPS AO' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_647533240293605445]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [has_NPS] THEN [nps_ao_score] END)' />
      </column>
      <column caption='% Pelican Orders' datatype='real' default-format='p0.0%' name='[Calculation_647533240296206407]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF LOWER([picking_app]) = &apos;pelican&apos; THEN [confirmed_orders] END) / SUM([confirmed_orders])' />
      </column>
      <column caption='% Confirmed Orders (Filtered / Original)' datatype='real' default-format='p0.0%' name='[Calculation_647533240301236299]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[% Confirmed Orders (Filtered) (copy)_647533240300843082] / [Confirmed Orders (Filtered) (copy)_647533240031666225]' />
      </column>
      <column caption='# Basket Size (Filtered - Original)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_647533240301764684]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Basket Size (copy)_647533239949213698] - [Calculation_647533239948455937]' />
      </column>
      <column caption='# Basket Size (Filtered / Original)' datatype='real' default-format='p0.0%' name='[Calculation_647533240301891661]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_647533240301764684] / [Calculation_647533239948455937]' />
      </column>
      <column caption='# Total Orders' datatype='integer' name='[Calculation_647533240303104078]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_orders])' />
      </column>
      <column caption='% Online Payment Orders (Filtered - Original)' datatype='real' default-format='p0.0%' name='[Calculation_647533240351744099]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[% Online Payment Orders (copy)_647533240284184642] - [Calculation_647533240283680833]' />
      </column>
      <column caption='$ GMV per Active Vendor (Filtered - Original)' datatype='real' name='[Calculation_647533240354967667]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[GMV per Vendor (copy)_647533240016093215] - [# of Vendors per Acc Manager (copy)_647533240015921182]' />
      </column>
      <column caption='Orders Filter' datatype='boolean' name='[Calculation_647533240698142845]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_270567873544331264] &gt;= [Parameters].[Parameter 1] THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='ID' datatype='string' name='[Calculation_647533241036054664]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[global_entity_id] + [vendor_id]' />
      </column>
