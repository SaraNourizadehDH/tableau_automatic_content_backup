            <column caption='Eligible Order for Replacement' datatype='integer' name='[Calculation_647533240064127029]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF LOWER([picking_app]) = &apos;pelican&apos; THEN [failed_due_to_oos] + [partial_orders_old] END' />
            </column>
            <column caption='Has the vendor &gt; 1 replaced order per month' datatype='boolean' name='[Calculation_647533240065122359]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{FIXED [granularity], [global_entity_id], [vendor_name], DATETRUNC(&apos;month&apos;, [date]) :&#10;IF SUM([replacements_orders_pelican]) &gt; 0 THEN TRUE ELSE FALSE END }' />
            </column>
            <column caption='&apos;FILTERED&apos;' datatype='string' name='[Calculation_647533240297730121]' role='dimension' type='nominal' user:unnamed='Filtered'>
              <calculation class='tableau' formula='&apos;FILTERED&apos;' />
            </column>
            <column caption='Orders Filter' datatype='boolean' name='[Calculation_647533240698142845]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_270567873544331264] &gt;= [Parameters].[Parameter 1] THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='OPERATIONS' datatype='integer' name='[Economics (copy)_647533240031096880]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(NULL)' />
            </column>
            <column caption='% Fill Rate (Filtered)' datatype='real' default-format='p0.0%' name='[Fill Rate (copy)_647533240006869012]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [confirmed_orders] &gt; 0 and [picking_app] = &apos;pelican&apos; and [# of Vendors (Filtered) (copy)_1495546972540223488] THEN [qty_sold] ELSE NULL END) &#10;/ SUM(IF [confirmed_orders] &gt; 0 and [picking_app] = &apos;pelican&apos; and [# of Vendors (Filtered) (copy)_1495546972540223488] THEN [qty_ordered] ELSE NULL END)' />
            </column>
            <column caption='$ GMV Net per Order (Filtered)' datatype='real' default-format='c#,##0.0;-#,##0.0' name='[GMV Net per Order (copy)_647533240061292596]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [confirmed_orders] &gt; 0 AND [# of Vendors (Filtered) (copy)_1495546972540223488] THEN [gmv_net_eur] ELSE 0 END) / SUM(IF [# of Vendors (Filtered) (copy)_1495546972540223488] THEN [confirmed_orders] ELSE 0 END)' />
            </column>
            <column caption='$ GMV per Active Vendor (Filtered)' datatype='real' default-format='c#,##0;-#,##0' name='[GMV per Vendor (copy)_647533240016093215]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [confirmed_orders] &gt; 0 AND [# of Vendors (Filtered) (copy)_1495546972540223488] THEN [gmv_net_eur] ELSE 0 END) / COUNTD(IF [is_online] AND [# of Vendors (Filtered) (copy)_1495546972540223488] AND [confirmed_orders] &gt; 0 THEN [vendor_id] ELSE NULL END)' />
            </column>
            <column caption='Vendor FR Filter' datatype='boolean' name='[Has more orders than parameter (copy)_647533240698761342]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Monthly Confirmed Orders (copy)_647533240642424954] = 1 THEN TRUE&#10;ELSEIF [Calculation_270567873544331264] = 0 THEN FALSE&#10;ELSEIF [Vendors Monthly Orders (copy)_647533240699199615] &gt; [Parameters].[Monthly Confirmed Orders (copy)_647533240642424954] THEN FALSE &#10;ELSE TRUE END' />
            </column>
            <column caption='Fill Rate Filter' datatype='boolean' name='[OOS FR Filter (copy)_647533241004765316]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Monthly Vendor Fail Rate (copy)_647533241003376771] = 1 THEN TRUE&#10;ELSEIF [picking_app] != &apos;pelican&apos; THEN TRUE&#10;ELSEIF [Vendors Monthly Vendor FR (copy)_647533241005138053] = 0 THEN FALSE&#10;ELSEIF [Vendors Monthly Vendor FR (copy)_647533241005138053] &lt; [Parameters].[Monthly Vendor Fail Rate (copy)_647533241003376771] THEN FALSE &#10;ELSE TRUE END' />
            </column>
            <column caption='ITEMS' datatype='integer' name='[Orders  (copy)_647533240029933614]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(NULL)' />
            </column>
            <column caption='Orders Filter (ignore)' datatype='boolean' name='[Orders Filter (copy)_647533240706908288]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_270567873544331264] &gt;= [Parameters].[Parameter 3] THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='ECONOMICS' datatype='integer' name='[SKUs (copy)_647533240030928943]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(NULL)' />
