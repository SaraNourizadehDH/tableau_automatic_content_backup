          <datasource-dependencies datasource='federated.0zxge8j1frhq461buylsa0vaaso6'>
            <column caption='# NPS AO (Filtered - Original)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[# NPS AO (Filtered) (copy)_647533240317644880]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[# NPS AO (copy)_647533240295096390] - [Calculation_647533240293605445]' />
            </column>
            <column caption='# NPS AO (Filtered)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[# NPS AO (copy)_647533240295096390]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF [has_NPS] AND [# of Vendors (Filtered) (copy)_1495546972540223488] THEN [nps_ao_score] END)' />
            </column>
            <column caption='# Shop Details Sessions (Filtered - Original)' datatype='real' name='[# Shop Details Sessions (Filtered) (copy)_444449047455363087]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[# Total Session (copy)_444449047215996936] - [Calculation_444449047214571524]' />
