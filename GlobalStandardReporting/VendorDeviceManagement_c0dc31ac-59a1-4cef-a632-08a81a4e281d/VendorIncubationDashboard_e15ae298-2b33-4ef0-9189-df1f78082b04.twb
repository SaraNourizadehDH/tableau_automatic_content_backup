      <column caption='_LB_date' datatype='string' name='[Calculation_6160291003705954314]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;The number of vendors is unique only within each time period. Please select a single calendar week or month to view the correct count of unique vendors.&quot;' />
