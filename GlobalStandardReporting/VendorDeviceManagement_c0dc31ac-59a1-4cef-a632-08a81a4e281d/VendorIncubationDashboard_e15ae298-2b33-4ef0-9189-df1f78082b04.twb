        <calculation class='tableau' formula='CASE [Calculation_2378111724192108544]&#10;WHEN &quot;incubation_mode&quot; THEN 1&#10;WHEN &quot;early_graduation&quot; THEN 2&#10;WHEN &quot;post_incubation&quot; THEN 3&#10;WHEN &quot;extended_incubation&quot; THEN 4&#10;WHEN &quot;unknown&quot; THEN 5&#10;ELSE 6&#10;END' />
