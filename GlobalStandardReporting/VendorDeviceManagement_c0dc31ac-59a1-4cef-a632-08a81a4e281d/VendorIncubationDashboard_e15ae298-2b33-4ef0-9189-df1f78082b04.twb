      <aliases enabled='yes' />
      <column caption='Activation Date Local' datatype='string' name='[Calculation_6160291003660234752]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Time Granularity - Bookings (copy)_582723588887502848]&#10;WHEN &quot;Weekly&quot; THEN [activation_week_str]&#10;WHEN &quot;Monthly&quot; THEN [activation_month_str]&#10;END' />
      </column>
      <column caption='% Offline Duration' datatype='real' name='[Calculation_6160291003675013121]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([offline_duration])/SUM([schedule_seconds])' />
      </column>
      <column caption='% Vendors have Orders 30D' datatype='real' name='[Calculation_6160291003676815362]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [have_order_in_30d] = TRUE THEN [entity_id]+[vendor_code] ELSE NULL END)&#10;/&#10;COUNT([entity_id]+[vendor_code])' />
      </column>
      <column caption='Metric' datatype='real' name='[Calculation_6160291003683254277]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Select Flow Type (copy)_6160291003683115012]&#10;WHEN &quot;% Vendors with First Order F30D&quot; THEN [Calculation_6160291003676815362]&#10;WHEN &quot;% Offline Duration&quot; THEN [Calculation_6160291003675013121]&#10;END' />
      </column>
      <column caption='Selected Parameter' datatype='string' name='[Calculation_6160291003684106247]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Select Metric (copy)_6160291003683598342]&#10;WHEN &quot;Region&quot; THEN [region]&#10;WHEN &quot;Country Name&quot; THEN [country_name]&#10;WHEN &quot;Brand Name&quot; THEN [brand_name]&#10;WHEN &quot;Vertical Type&quot; THEN [vertical_type]&#10;WHEN &quot;(All)&quot; THEN &quot;(All)&quot;&#10;END' />
      </column>
      <column caption='_user_entitlement' datatype='boolean' name='[Calculation_6578210977388425216]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='USERNAME() = [username]' />
