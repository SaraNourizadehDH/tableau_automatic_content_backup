    <worksheet name='Incubation Event Funnel  (Early Grad)'>
      <table>
        <view>
          <datasources>
            <datasource caption='growth_vendor_incubation_dashboard' name='federated.17u869d0jg9xtp1dogrls0e49a4q' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Time Granularity' datatype='string' datatype-customized='true' name='[Time Granularity - Bookings (copy)_582723588887502848]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.17u869d0jg9xtp1dogrls0e49a4q'>
            <column caption='# Events - The Rest of Incubation Page Interaction ' datatype='integer' name='[# Vendors Engaged with the Rest of Incubation Page (copy)_6388567193056133120]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rest_of_incubation_click_events])' />
            </column>
            <column caption='# Events - Optimize Store Click' datatype='integer' name='[# Vendors clicked Optimize Store (copy)_6388567193079562244]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([optimize_store_click_events])' />
            </column>
            <column caption='Incubation Flow' datatype='string' name='[Calculation_2378111724192108544]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[flow_type]' />
            </column>
            <column caption='# Events - Incubation Display' datatype='integer' name='[Calculation_5271604113280495616]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([incubation_display_events])' />
            </column>
            <column caption='_Flow Type INT value' datatype='integer' name='[Calculation_5404178835036991493]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Calculation_2378111724192108544]&#10;WHEN &quot;incubation_mode&quot; THEN 1&#10;WHEN &quot;early_graduation&quot; THEN 2&#10;WHEN &quot;post_incubation&quot; THEN 3&#10;WHEN &quot;extended_incubation&quot; THEN 4&#10;WHEN &quot;unknown&quot; THEN 5&#10;ELSE 6&#10;END' />
            </column>
            <column caption='_time_granular_filter' datatype='boolean' name='[Calculation_6976427696104505344]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Time Granularity - Bookings (copy)_582723588887502848]&#10;WHEN &apos;Daily&apos; THEN [agg_granularity] = &apos;day&apos;&#10;WHEN &apos;Weekly&apos; THEN [agg_granularity] = &apos;week&apos;&#10;WHEN &apos;Monthly&apos; THEN [agg_granularity] = &apos;month&apos;&#10;WHEN &apos;Quarterly&apos; THEN [agg_granularity] = &apos;quarter&apos;&#10;END' />
            </column>
            <column caption='# Events - Incubation Widget Click ' datatype='integer' name='[Incubation Display Event (copy)_5271604113554190337]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([incubation_widget_click_events])' />
            </column>
            <column caption='_Is only early_graduation selected' datatype='boolean' name='[_Is only incubation_mode selected (copy)_5404178835069198345]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ FIXED : COUNTD(IF [Selected Incubation Flow] THEN [Calculation_2378111724192108544] END) } = 1&#10;AND &#10;{ FIXED : MAX(IF [Selected Incubation Flow] THEN [Calculation_5404178835036991493] END) } = 2' />
            </column>
            <column datatype='string' name='[agg_granularity]' role='dimension' type='nominal' />
            <column caption='Brand Name' datatype='string' name='[brand_name]' role='dimension' type='nominal' />
