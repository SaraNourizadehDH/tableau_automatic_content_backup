        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;fail_a&quot; THEN&#13;&#10;{ FIXED [Calculation_922323166786174976], [Calculation_744501349098053636], DATE([order_date]) : SUM(IF [Calculation_922323166788083714] = FALSE then [fail_order_count] END) }&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;success_a&quot; THEN&#13;&#10;{ FIXED [Calculation_922323166786174976], [Calculation_744501349098053636], DATE([order_date]) : SUM(IF [Calculation_922323166788083714] = FALSE then [success_order_count] END) }&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;recovery_a&quot; THEN&#13;&#10;{ FIXED [Calculation_922323166786174976], [Calculation_744501349098053636], DATE([order_date]) : SUM(IF [Calculation_922323166788083714] = FALSE then [recovery_order_count] END) }&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;acceptance_a&quot; THEN&#13;&#10;{ FIXED [Calculation_922323166786174976], [Calculation_744501349098053636], DATE([order_date]) : SUM(IF [Calculation_922323166788083714] = FALSE then [success_order_count] + [recovery_order_count] END) }&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;success&quot; THEN&#13;&#10;{ FIXED [Calculation_922323166786174976], [Calculation_744501349098053636], DATE([order_date]) : (SUM(IF [Calculation_922323166788083714] = FALSE then [success_order_count] END)/SUM(IF [Calculation_922323166788083714] = FALSE then [order_count] END))*100 }&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;recovery&quot; THEN&#13;&#10;{ FIXED [Calculation_922323166786174976], [Calculation_744501349098053636], DATE([order_date]) : (SUM(IF [Calculation_922323166788083714] = FALSE then [recovery_order_count] END)/SUM(IF [Calculation_922323166788083714] = FALSE then [order_count] END))*100 }&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;acceptance&quot; THEN&#13;&#10;{ FIXED [Calculation_922323166786174976], [Calculation_744501349098053636], DATE([order_date]) : (SUM(IF [Calculation_922323166788083714] = FALSE then [success_order_count] + [recovery_order_count] END)/SUM(IF [Calculation_922323166788083714] = FALSE then [order_count] END))*100 }&#13;&#10;ELSE &#13;&#10;{ FIXED [Calculation_922323166786174976], [Calculation_744501349098053636], DATE([order_date]) : (SUM(IF [Calculation_922323166788083714] = FALSE then [fail_order_count] END)/SUM(IF [Calculation_922323166788083714] = FALSE then [order_count] END))*100 }&#13;&#10;END' />
