              <aliases>
                <alias key='&quot;days&quot;' value='Days' />
                <alias key='&quot;weekdays&quot;' value='Weekdays' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1aglqsa0yiwl67195qene08ybmsn'>
            <column aggregation='CountD' caption='Metrics Prefix' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1044835152833945600]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] IN (&quot;fail&quot;,&quot;success&quot;,&quot;recovery&quot;,&quot;acceptance&quot;) then &quot;%&quot;&#13;&#10;ELSE &quot;&quot;&#13;&#10;END' />
            </column>
            <column caption='Max Date of Incident' datatype='datetime' name='[Calculation_257831142694006784]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='{ MAX([Calculation_936467289235865601])}' />
            </column>
            <column caption='Metrics (Field) (LOD : Day) Time Series' datatype='real' name='[Calculation_424745786936356864]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//IFNULL(AVG([Metrics (Field) (LOD : Day) non selected date]),AVG([Metrics (Field) (LOD : Day) selected date]))&#13;&#10;[Calculation_737464476128845829]/MAX(if [Calculation_922323166788083714] = FALSE and [Parameters].[Parameter 2] in (&quot;fail_a&quot;,&quot;acceptance_a&quot;,&quot;recovery_a&quot;,&quot;success_a&quot;) then [Parameters].[Parameter 5] else 1 END)' />
            </column>
            <column caption='Metrics (Field)' datatype='real' name='[Calculation_737464476128845829]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;fail_a&quot; then SUM([fail_order_count])&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;success_a&quot; then SUM([success_order_count])&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;recovery_a&quot; then SUM([recovery_order_count])&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;acceptance_a&quot; then SUM([recovery_order_count]) + SUM([success_order_count])&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;success&quot; then Round((SUM([success_order_count])/SUM([order_count]))*100,2)&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;recovery&quot; then Round((SUM([recovery_order_count])/SUM([order_count]))*100,2)&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;acceptance&quot; then Round(((SUM([success_order_count]) + SUM([recovery_order_count]))/SUM([order_count]))*100,2)&#13;&#10;ELSE Round((SUM([fail_order_count])/SUM([order_count]))*100,2)&#13;&#10;END' />
            </column>
            <column caption='Order Hour' datatype='string' name='[Calculation_744501349098053636]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(DATEPART(&quot;hour&quot;,[Calculation_936467289235865601])) + &quot;:00&quot;' />
            </column>
            <column caption='Incident Date Legend' datatype='string' name='[Calculation_900719965831720963]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_922323166788083714] = TRUE then &quot;Incident Date&quot; ELSE &quot;Benchmark&quot; END' />
            </column>
            <column caption='is_date_benchmark' datatype='boolean' name='[Calculation_922323166786174976]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATE([Calculation_936467289235865601]) == [Parameters].[Parameter 3]&#10;    THEN True&#10;ELSEIF DATEDIFF(&apos;day&apos;, DATE([Calculation_936467289235865601]), [Parameters].[Parameter 3]) % 7 = 0 AND [Parameters].[Parameter 6] = &quot;weekdays&quot;&#10;    THEN True&#13;&#10;ELSEIF DATEDIFF(&apos;day&apos;, DATE([Calculation_936467289235865601]), [Parameters].[Parameter 3]) &lt;= [Parameters].[Parameter 5] AND [Parameters].[Parameter 6] = &quot;days&quot;&#13;&#10;    THEN True&#10;ELSE False&#10;END' />
            </column>
            <column caption='is_selected_date' datatype='boolean' name='[Calculation_922323166788083714]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] == DATE([Calculation_936467289235865601]) THEN True ELse False END' />
            </column>
            <column caption='Order Datetime with Timezone' datatype='datetime' name='[Calculation_936467289235865601]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &quot;utc&quot; then [order_datetime]&#13;&#10;//ELSEIF [Time Zone] = &quot;local&quot; then DATEADD(&quot;hour&quot;,INT([Local Timezone Addition]),[Order Datetime])&#13;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;local&quot; then [order_datetime_local]&#13;&#10;//ELSE DATEADD(&quot;hour&quot;,1,[Order Datetime])&#13;&#10;ELSE [order_datetime_cet]&#13;&#10;END' />
            </column>
            <column caption='Date Selected' datatype='string' name='[Calculation_936467289311944707]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_922323166786174976] = true and [Calculation_922323166788083714] = false &#13;&#10;then STR(DATEPART(&quot;day&quot;,[Calculation_936467289235865601])) + &quot;-&quot; + STR(DATEPART(&quot;month&quot;,[Calculation_936467289235865601])) + &quot;-&quot; + STR(DATEPART(&quot;year&quot;,[Calculation_936467289235865601])) &#13;&#10;ELSEIF [Calculation_922323166786174976] = true and [Calculation_922323166788083714] = true&#13;&#10;then &quot;Incident Date&quot;&#13;&#10;END' />
            </column>
            <column caption='Time range filter' datatype='boolean' name='[Calculation_936467289359241222]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 6] == &quot;weekdays&quot; then&#13;&#10;    IF [Calculation_936467289235865601] &gt;= DATEADD(&quot;day&quot;,([Parameters].[Parameter 5] * 7)*-1,[Parameters].[Parameter 3]) and [Calculation_936467289235865601] &lt; DATEADD(&quot;day&quot;,1,[Parameters].[Parameter 3]) THEN TRUE ELSE FALSE END&#13;&#10;ELSEIF [Parameters].[Parameter 6] == &quot;days&quot; then&#13;&#10;    IF [Calculation_936467289235865601] &gt;= DATEADD(&quot;day&quot;,[Parameters].[Parameter 5]*-1,[Parameters].[Parameter 3]) and [Calculation_936467289235865601] &lt; DATEADD(&quot;day&quot;,1,[Parameters].[Parameter 3]) THEN TRUE ELSE FALSE END&#13;&#10;END' />
            </column>
