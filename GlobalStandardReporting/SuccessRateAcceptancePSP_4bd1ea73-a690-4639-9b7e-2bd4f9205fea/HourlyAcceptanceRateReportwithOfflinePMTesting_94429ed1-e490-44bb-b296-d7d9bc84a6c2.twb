      <datasource-dependencies datasource='Parameters'>
        <column alias='Acceptance Rate' caption='Metrics' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;acceptance&quot;'>
          <calculation class='tableau' formula='&quot;acceptance&quot;' />
          <aliases>
            <alias key='&quot;acceptance&quot;' value='Acceptance Rate' />
            <alias key='&quot;acceptance_a&quot;' value='Accepted Orders (Successful + Recovery)' />
            <alias key='&quot;fail&quot;' value='Fail Rate' />
            <alias key='&quot;fail_a&quot;' value='Fail Orders' />
            <alias key='&quot;recovery&quot;' value='Recovery Rate' />
            <alias key='&quot;recovery_a&quot;' value='Recovery Orders' />
            <alias key='&quot;success&quot;' value='Success Rate' />
            <alias key='&quot;success_a&quot;' value='Successful Orders' />
          </aliases>
          <members>
            <member alias='Acceptance Rate' value='&quot;acceptance&quot;' />
            <member alias='Success Rate' value='&quot;success&quot;' />
            <member alias='Recovery Rate' value='&quot;recovery&quot;' />
            <member alias='Fail Rate' value='&quot;fail&quot;' />
            <member alias='Accepted Orders (Successful + Recovery)' value='&quot;acceptance_a&quot;' />
            <member alias='Successful Orders' value='&quot;success_a&quot;' />
            <member alias='Recovery Orders' value='&quot;recovery_a&quot;' />
            <member alias='Fail Orders' value='&quot;fail_a&quot;' />
          </members>
        </column>
        <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1aglqsa0yiwl67195qene08ybmsn].[Calculation_257831142694006784]' caption='Incident Date' datatype='date' datatype-customized='true' default-format='*dd/mm/yyyy' name='[Parameter 3]' param-domain-type='any' role='measure' type='quantitative' value='#2024-09-27#'>
          <calculation class='tableau' formula='#2024-09-27#' />
        </column>
        <column alias='UTC' caption='Time Zone' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;utc&quot;'>
          <calculation class='tableau' formula='&quot;utc&quot;' />
          <aliases>
