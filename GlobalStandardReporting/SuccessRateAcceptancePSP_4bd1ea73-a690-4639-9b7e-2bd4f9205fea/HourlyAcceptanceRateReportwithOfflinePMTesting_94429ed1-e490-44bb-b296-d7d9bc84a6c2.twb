    <worksheet name='#Order per Hour Table Delta (3)'>
      <table>
        <view>
          <datasources>
            <datasource caption='hourly_acceptance_rate (rl_fintech)' name='federated.1aglqsa0yiwl67195qene08ybmsn' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1aglqsa0yiwl67195qene08ybmsn].[Calculation_257831142694006784]' caption='Incident Date' datatype='date' datatype-customized='true' default-format='*dd/mm/yyyy' name='[Parameter 3]' param-domain-type='any' role='measure' type='quantitative' value='#2024-09-27#'>
              <calculation class='tableau' formula='#2024-09-27#' />
            </column>
            <column alias='UTC' caption='Time Zone' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;utc&quot;'>
              <calculation class='tableau' formula='&quot;utc&quot;' />
              <aliases>
                <alias key='&quot;cet&quot;' value='CET' />
                <alias key='&quot;local&quot;' value='Local Time Zone' />
                <alias key='&quot;utc&quot;' value='UTC' />
              </aliases>
            </column>
            <column caption='#Weeks (Benchmark)' datatype='integer' name='[Parameter 5]' param-domain-type='range' role='measure' type='quantitative' value='4'>
              <calculation class='tableau' formula='4' />
              <range max='16' min='3' />
            </column>
            <column alias='Weekdays' caption='Benchmark Mode' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;weekdays&quot;'>
              <calculation class='tableau' formula='&quot;weekdays&quot;' />
              <aliases>
                <alias key='&quot;days&quot;' value='Days' />
                <alias key='&quot;weekdays&quot;' value='Weekdays' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1aglqsa0yiwl67195qene08ybmsn'>
            <column caption='Order Loss' datatype='real' name='[Calculation_1220475541554761733]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_673006716337197059] &lt; 0 THEN&#13;&#10;(SUM([Calculation_298082039977029632])*ABS([Calculation_673006716337197059]))/100&#13;&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column caption='Max Date of Incident' datatype='datetime' name='[Calculation_257831142694006784]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='{ MAX([Calculation_936467289235865601])}' />
            </column>
            <column caption='Order Count (LOD: DAY) selected' datatype='integer' name='[Calculation_298082039977029632]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL({ FIXED [Calculation_922323166786174976], [Calculation_744501349098053636], DAY([order_date]) : SUM(if [Calculation_922323166788083714] =  TRUE THEN [order_count] END) },0)' />
            </column>
            <column caption='&quot;Order Loss (Total  Orders on Incindent * Delta of Fail Rate)&quot;' datatype='string' name='[Calculation_660058865742192653]' role='dimension' type='nominal' user:unnamed='#Order per Hour Table Delta (3)'>
              <calculation class='tableau' formula='&quot;Order Loss (Total  Orders on Incindent * Delta of Fail Rate)&quot;' />
            </column>
            <column caption='&quot;Order Loss (Total  Orders on Incident * Delta of Fail Rate)&quot;' datatype='string' name='[Calculation_660058865742540815]' role='dimension' type='nominal' user:unnamed='#Order per Hour Table Delta (3)'>
              <calculation class='tableau' formula='&quot;Order Loss&#13;&#10;(Total  Orders on Incident * Delta of Fail Rate)&quot;' />
            </column>
            <column caption='Fail Rate (LOD: DAY) Delta' datatype='real' name='[Calculation_673006716337197059]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Order Count (LOD: DAY) non selected (copy)_673006716331204608])-SUM([Order Count (LOD: DAY) selected (copy)_673006716331491329])' />
            </column>
            <column caption='Order Hour' datatype='string' name='[Calculation_744501349098053636]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(DATEPART(&quot;hour&quot;,[Calculation_936467289235865601])) + &quot;:00&quot;' />
            </column>
            <column caption='is_date_benchmark' datatype='boolean' name='[Calculation_922323166786174976]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATE([Calculation_936467289235865601]) == [Parameters].[Parameter 3]&#10;    THEN True&#10;ELSEIF DATEDIFF(&apos;day&apos;, DATE([Calculation_936467289235865601]), [Parameters].[Parameter 3]) % 7 = 0 AND [Parameters].[Parameter 6] = &quot;weekdays&quot;&#10;    THEN True&#13;&#10;ELSEIF DATEDIFF(&apos;day&apos;, DATE([Calculation_936467289235865601]), [Parameters].[Parameter 3]) &lt;= [Parameters].[Parameter 5] AND [Parameters].[Parameter 6] = &quot;days&quot;&#13;&#10;    THEN True&#10;ELSE False&#10;END' />
            </column>
            <column caption='is_selected_date' datatype='boolean' name='[Calculation_922323166788083714]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] == DATE([Calculation_936467289235865601]) THEN True ELse False END' />
            </column>
            <column caption='Order Datetime with Timezone' datatype='datetime' name='[Calculation_936467289235865601]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &quot;utc&quot; then [order_datetime]&#13;&#10;//ELSEIF [Time Zone] = &quot;local&quot; then DATEADD(&quot;hour&quot;,INT([Local Timezone Addition]),[Order Datetime])&#13;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;local&quot; then [order_datetime_local]&#13;&#10;//ELSE DATEADD(&quot;hour&quot;,1,[Order Datetime])&#13;&#10;ELSE [order_datetime_cet]&#13;&#10;END' />
            </column>
            <column caption='Date Selected' datatype='string' name='[Calculation_936467289311944707]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_922323166786174976] = true and [Calculation_922323166788083714] = false &#13;&#10;then STR(DATEPART(&quot;day&quot;,[Calculation_936467289235865601])) + &quot;-&quot; + STR(DATEPART(&quot;month&quot;,[Calculation_936467289235865601])) + &quot;-&quot; + STR(DATEPART(&quot;year&quot;,[Calculation_936467289235865601])) &#13;&#10;ELSEIF [Calculation_922323166786174976] = true and [Calculation_922323166788083714] = true&#13;&#10;then &quot;Incident Date&quot;&#13;&#10;END' />
            </column>
            <column caption='Time range filter' datatype='boolean' name='[Calculation_936467289359241222]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 6] == &quot;weekdays&quot; then&#13;&#10;    IF [Calculation_936467289235865601] &gt;= DATEADD(&quot;day&quot;,([Parameters].[Parameter 5] * 7)*-1,[Parameters].[Parameter 3]) and [Calculation_936467289235865601] &lt; DATEADD(&quot;day&quot;,1,[Parameters].[Parameter 3]) THEN TRUE ELSE FALSE END&#13;&#10;ELSEIF [Parameters].[Parameter 6] == &quot;days&quot; then&#13;&#10;    IF [Calculation_936467289235865601] &gt;= DATEADD(&quot;day&quot;,[Parameters].[Parameter 5]*-1,[Parameters].[Parameter 3]) and [Calculation_936467289235865601] &lt; DATEADD(&quot;day&quot;,1,[Parameters].[Parameter 3]) THEN TRUE ELSE FALSE END&#13;&#10;END' />
            </column>
            <column caption='Fail Rate (LOD: DAY) non selected' datatype='real' name='[Order Count (LOD: DAY) non selected (copy)_673006716331204608]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Calculation_922323166786174976], [Calculation_744501349098053636], DATE([Calculation_936467289235865601]) : (SUM(if [Calculation_922323166788083714] = false then [fail_order_count] end)/SUM(if [Calculation_922323166788083714] = false then [order_count] end))*100 }' />
            </column>
            <column caption='Fail Rate (LOD: DAY) selected' datatype='real' name='[Order Count (LOD: DAY) selected (copy)_673006716331491329]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL({ FIXED [Calculation_922323166786174976], [Calculation_744501349098053636], DATE([order_date]) : (SUM(if [Calculation_922323166788083714] =  TRUE THEN [fail_order_count] END)/SUM(if [Calculation_922323166788083714] =  TRUE THEN [order_count] END))*100 },0)' />
            </column>
