            <column caption='Metrics (Field) (LOD : PM) selected date' datatype='real' name='[Calculation_1044835152838778881]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;fail_a&quot; THEN&#13;&#10;{ FIXED [Calculation_922323166786174976], [Calculation_744501349098053636], DATE([Calculation_936467289235865601]), [first_payment_method] : SUM(IF [Calculation_922323166788083714] = TRUE then [fail_order_count] END) }&#13;&#10;ELSE &#13;&#10;{ FIXED [Calculation_922323166786174976], [Calculation_744501349098053636], DATE([Calculation_936467289235865601]), [first_payment_method] : (SUM(IF [Calculation_922323166788083714] = TRUE then [fail_order_count] END)/SUM(IF [Calculation_922323166788083714] = TRUE then [order_count] END))*100 }&#13;&#10;END' />
