              <calculation class='tableau' formula='IFNULL({ FIXED [vertical], [Calculation_922323166786174976], [Calculation_744501349098053636], DAY([order_date]) : SUM(if [Calculation_922323166788083714] =  TRUE THEN [success_order_count] END) + SUM(if [Calculation_922323166788083714] =  TRUE THEN [recovery_order_count] END) },0)' />
