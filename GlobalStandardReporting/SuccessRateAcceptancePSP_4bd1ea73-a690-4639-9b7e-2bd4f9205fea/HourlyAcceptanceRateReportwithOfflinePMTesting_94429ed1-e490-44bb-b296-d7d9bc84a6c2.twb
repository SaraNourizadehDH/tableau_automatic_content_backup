    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Order Loss Calculation - vertical (temp)'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/ARIncidentreportWiP/OrderLossCalculation-verticaltemp?rev=' id='OrderLossCalculation-verticaltemp' path='/t/GlobalStandardReporting/workbooks/HourlyAcceptanceRateReportwithCashTesting' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='1500' maxwidth='1350' minheight='1500' minwidth='1350' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='hourly_acceptance_rate (rl_fintech)' name='federated.1aglqsa0yiwl67195qene08ybmsn' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column alias='Acceptance Rate' caption='Metrics' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;acceptance&quot;'>
          <calculation class='tableau' formula='&quot;acceptance&quot;' />
          <aliases>
            <alias key='&quot;acceptance&quot;' value='Acceptance Rate' />
            <alias key='&quot;acceptance_a&quot;' value='Accepted Orders (Successful + Recovery)' />
            <alias key='&quot;fail&quot;' value='Fail Rate' />
            <alias key='&quot;fail_a&quot;' value='Fail Orders' />
            <alias key='&quot;recovery&quot;' value='Recovery Rate' />
            <alias key='&quot;recovery_a&quot;' value='Recovery Orders' />
            <alias key='&quot;success&quot;' value='Success Rate' />
            <alias key='&quot;success_a&quot;' value='Successful Orders' />
          </aliases>
          <members>
            <member alias='Acceptance Rate' value='&quot;acceptance&quot;' />
            <member alias='Success Rate' value='&quot;success&quot;' />
            <member alias='Recovery Rate' value='&quot;recovery&quot;' />
            <member alias='Fail Rate' value='&quot;fail&quot;' />
            <member alias='Accepted Orders (Successful + Recovery)' value='&quot;acceptance_a&quot;' />
            <member alias='Successful Orders' value='&quot;success_a&quot;' />
            <member alias='Recovery Orders' value='&quot;recovery_a&quot;' />
            <member alias='Fail Orders' value='&quot;fail_a&quot;' />
          </members>
        </column>
        <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1aglqsa0yiwl67195qene08ybmsn].[Calculation_257831142694006784]' caption='Incident Date' datatype='date' datatype-customized='true' default-format='*dd/mm/yyyy' name='[Parameter 3]' param-domain-type='any' role='measure' type='quantitative' value='#2024-09-27#'>
          <calculation class='tableau' formula='#2024-09-27#' />
        </column>
        <column alias='UTC' caption='Time Zone' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;utc&quot;'>
          <calculation class='tableau' formula='&quot;utc&quot;' />
          <aliases>
            <alias key='&quot;cet&quot;' value='CET' />
            <alias key='&quot;local&quot;' value='Local Time Zone' />
            <alias key='&quot;utc&quot;' value='UTC' />
          </aliases>
          <members>
            <member alias='UTC' value='&quot;utc&quot;' />
            <member alias='CET' value='&quot;cet&quot;' />
            <member alias='Local Time Zone' value='&quot;local&quot;' />
          </members>
        </column>
        <column caption='#Weeks (Benchmark)' datatype='integer' name='[Parameter 5]' param-domain-type='range' role='measure' type='quantitative' value='4'>
          <calculation class='tableau' formula='4' />
          <range max='16' min='3' />
        </column>
        <column alias='Weekdays' caption='Benchmark Mode' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;weekdays&quot;'>
          <calculation class='tableau' formula='&quot;weekdays&quot;' />
          <aliases>
            <alias key='&quot;days&quot;' value='Days' />
            <alias key='&quot;weekdays&quot;' value='Weekdays' />
          </aliases>
          <members>
            <member alias='Weekdays' value='&quot;weekdays&quot;' />
            <member alias='Days' value='&quot;days&quot;' />
          </members>
        </column>
      </datasource-dependencies>
