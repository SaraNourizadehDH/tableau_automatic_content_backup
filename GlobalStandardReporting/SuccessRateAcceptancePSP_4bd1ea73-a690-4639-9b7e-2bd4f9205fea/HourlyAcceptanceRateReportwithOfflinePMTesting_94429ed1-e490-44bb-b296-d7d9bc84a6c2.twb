      <column caption='AVG Accepted Order Count (LOD: DAY) (copy)' datatype='real' name='[AVG Accepted Order Count (LOD: DAY) (copy)_1324621244517130242]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Accepted Order Count (LOD: DAY) non selected (copy)_1324621244517257219])/[Parameters].[Parameter 5]' />
      </column>
      <column caption='Accepted Order Count (LOD: DAY) Delta (copy)' datatype='real' name='[Accepted Order Count (LOD: DAY) Delta (copy)_1324621244518342660]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Accepted Order Count (LOD: DAY) selected (copy)_1324621244516880385]) - [AVG Accepted Order Count (LOD: DAY) (copy)_1324621244517130242]' />
      </column>
      <column caption='% Accepted Order Count (LOD: DAY) Delta' datatype='real' name='[Accepted Order Count (LOD: DAY) Delta (copy)_738027445944893445]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Order Count (LOD: DAY) selected (copy)_738027445939490818]) - AVG([Order Count (LOD: DAY) non selected (copy)_738027445940629507]))/AVG([Order Count (LOD: DAY) non selected (copy)_738027445940629507])' />
      </column>
      <column caption='Accepted Order Count (LOD: DAY) non selected (copy)' datatype='integer' name='[Accepted Order Count (LOD: DAY) non selected (copy)_1324621244517257219]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [vertical], [Calculation_922323166788083714],[Calculation_922323166786174976], [Calculation_744501349098053636], DATE([Calculation_936467289235865601]) : SUM(if [Calculation_922323166788083714] = false then [success_order_count] end) + SUM(if [Calculation_922323166788083714] = false then [recovery_order_count] end) }' />
      </column>
      <column caption='Accepted Order Count (LOD: DAY) Delta' datatype='real' name='[Accepted Order Count (LOD: DAY) non selected (copy)_738027445941485572]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Order Count (LOD: DAY) selected (copy)_738027445939490818]) - [Calculation_1389360542364241921]' />
      </column>
      <column caption='Accepted Order Count (LOD: DAY) selected (copy)' datatype='integer' name='[Accepted Order Count (LOD: DAY) selected (copy)_1324621244516880385]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL({ FIXED [vertical], [Calculation_922323166786174976], [Calculation_744501349098053636], DAY([order_date]) : SUM(if [Calculation_922323166788083714] =  TRUE THEN [success_order_count] END) + SUM(if [Calculation_922323166788083714] =  TRUE THEN [recovery_order_count] END) },0)' />
      </column>
      <column aggregation='CountD' caption='Metrics Prefix' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1044835152833945600]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] IN (&quot;fail&quot;,&quot;success&quot;,&quot;recovery&quot;,&quot;acceptance&quot;) then &quot;%&quot;&#13;&#10;ELSE &quot;&quot;&#13;&#10;END' />
      </column>
      <column caption='Metrics (Field) (LOD : PM) selected date' datatype='real' name='[Calculation_1044835152838778881]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;fail_a&quot; THEN&#13;&#10;{ FIXED [Calculation_922323166786174976], [Calculation_744501349098053636], DATE([Calculation_936467289235865601]), [first_payment_method] : SUM(IF [Calculation_922323166788083714] = TRUE then [fail_order_count] END) }&#13;&#10;ELSE &#13;&#10;{ FIXED [Calculation_922323166786174976], [Calculation_744501349098053636], DATE([Calculation_936467289235865601]), [first_payment_method] : (SUM(IF [Calculation_922323166788083714] = TRUE then [fail_order_count] END)/SUM(IF [Calculation_922323166788083714] = TRUE then [order_count] END))*100 }&#13;&#10;END' />
      </column>
      <column caption='More than Average PM' datatype='string' name='[Calculation_1044835152897040388]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF AVG([Calculation_1044835152838778881]) &gt;=  AVG([Metrics (Field) (LOD : PM) selected date (copy)_298082039995465734]) THEN &quot;Greater than Average&quot; ELSE &quot;Less than Average&quot; END' />
      </column>
      <column caption='Legend Detailed Date' datatype='string' name='[Calculation_1076923317566824449]' role='dimension' type='nominal'>
