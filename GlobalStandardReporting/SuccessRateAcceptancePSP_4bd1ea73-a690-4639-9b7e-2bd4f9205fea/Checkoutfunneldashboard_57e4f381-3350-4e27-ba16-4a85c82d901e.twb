                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#555555' fontsize='12'>Point of contact: </run>
                <run fontcolor='#555555' fontsize='12'>Fintech Data - Payments Analytics (fintech_data_payments@deliveryhero.com)</run>
                <run>Æ&#10;</run>
