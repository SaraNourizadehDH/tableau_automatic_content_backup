                  </zone-style>
                </zone>
                <zone fixed-size='120' h='9143' id='9' is-fixed='true' is-scaled='1' param='Image/DH_Fintech_Full_RGB.png' type-v2='bitmap' w='27332' x='72001' y='571'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
