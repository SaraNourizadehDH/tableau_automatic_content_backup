      <aliases enabled='yes' />
      <column caption='Checkout loaded %' datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([checkout_loaded]) / TOTAL(SUM([checkout_loaded]))'>
          <table-calc ordering-type='Columns' />
        </calculation>
      </column>
      <column caption='Tokenization checkout' datatype='boolean' name='[Calculation_1393582657077276673]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [is_tokenized_payment_checkout] = &apos;true&apos; then true else false end' />
      </column>
      <column caption='index' datatype='integer' name='[Calculation_1654932185088552960]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='index()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Checkout loaded variation' datatype='integer' name='[Calculation_1654932185307844609]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(sum([checkout_loaded]))*100 - LOOKUP(ZN(sum([checkout_loaded]))*100, -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='transaction failed reasons - dynamic grouping' datatype='string' name='[Calculation_1654932185338544133]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Transaction Failed Reasons Set] THEN [transaction_failed_reasons]&#10;ELSE &quot;Others combined&quot;&#10;END' />
      </column>
      <column aggregation='Sum' caption='transaction dailed reasons - ranking' datatype='integer' name='[Calculation_1654932185338970118]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Calculation_1654932185338544133]&#10;WHEN &apos;Others combined&apos; THEN 1&#10;ELSE 0&#10;END' />
      </column>
      <column caption='metric selection' datatype='real' name='[Calculation_1654932185403486219]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 4] = 1 then sum([checkout_loaded])&#10;elseif [Parameters].[Parameter 4] = 2 then [Calculation1]*100&#10;end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Timeframe Date' datatype='date' datatype-customized='true' name='[Calculation_1924796273437519872]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parameter 3 1], [partition_date]))' />
      </column>
      <column caption='max date' datatype='date' name='[Calculation_2342645919450517504]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{MAX([partition_date])}' />
      </column>
      <column caption='TF' datatype='boolean' name='[Calculation_2342645919450886145]' role='measure' type='nominal'>
        <calculation class='tableau' formula='INDEX()=(IF MAX([partition_date]) = [Parameters].[Parameter 1] THEN INDEX() END)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='mCVR4 variation' datatype='real' name='[Calculation_2342645919451480066]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([Calculation_5456322109243101184])*100 - LOOKUP(ZN([Calculation_5456322109243101184])*100, -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='View by' datatype='string' name='[Calculation_2646920369508712448]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 2] = 2 then [country] &#10;elseif [Parameters].[Parameter 2] = 3 then [platform] &#10;elseif [Parameters].[Parameter 2] = 4 then [transaction_type]&#10;elseif [Parameters].[Parameter 2] = 1 then &apos;Total&apos;&#10;end' />
      </column>
      <column caption='mCVR4 (transaction/checkout)' datatype='real' name='[Calculation_5456322109243101184]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([transaction_total])/sum([checkout_loaded])' />
      </column>
      <column caption='Partition Date (copy)' datatype='date' name='[Partition Date (copy)_1393582657064476672]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[partition_date]' />
      </column>
      <column caption='Tokenization payment method selected' datatype='boolean' name='[Tokenization checkout (copy)_2665145874287235072]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [is_payment_method_selected_tokenized] = &apos;true&apos; then true &#10;elseif [is_payment_method_selected_tokenized] = &apos;1&apos; then true &#10;else false end' />
      </column>
      <column caption='Transaction Failed Reasons (copy)' datatype='string' name='[Transaction Failed Reasons (copy)_1654932185321861122]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[transaction_failed_reasons]' />
      </column>
