      <aliases enabled='yes' />
      <column caption='Trx.Success' datatype='integer' name='[Calculation_1025554092412567553]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF(UPPER([Status])=&apos;SUCCESS&apos;,[count_of_transactions],0)' />
      </column>
      <column caption='Record Datetime CET' datatype='datetime' name='[Calculation_1025554092414615555]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF DATEPART(&apos;month&apos;,TODAY() ) &gt;= 4 AND DATEPART(&apos;month&apos;,TODAY() ) &lt;= 10&#10;THEN DATEADD(&apos;hour&apos;,2,[record_datetime])&#10;ELSE DATEADD(&apos;hour&apos;,1,[record_datetime])&#10;END' />
      </column>
      <column caption='Datetime CET' datatype='datetime' name='[Calculation_1025554092414832644]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETIME((INT(FLOAT(&#10;    //Conversion to UTC, considering Daylight Saving Time change&#10;    IF DATEPART(&apos;month&apos;,TODAY() ) &gt;= 4 AND DATEPART(&apos;month&apos;,TODAY() ) &lt;= 10&#10;        THEN DATEADD(&apos;hour&apos;,2,[record_datetime])&#10;        ELSE DATEADD(&apos;hour&apos;,1,[record_datetime])&#10;        END&#10;    )*[Parameters].[Parameter 2]))/[Parameters].[Parameter 2])' />
      </column>
      <column caption='Trx.Count' datatype='integer' name='[Calculation_1025554092432261129]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL([count_of_transactions],0))' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_289848903927472128]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]=USERNAME()' />
      </column>
      <column caption='Payment Method.Is NULL' datatype='boolean' hidden='true' name='[Calculation_349662305742385153]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='ISNULL([payment_method])' />
      </column>
      <column caption='Trx.Total.minusPending' datatype='integer' name='[Calculation_5115174401686233088]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Status]!=&apos;Pending&apos;,IFNULL([count_of_transactions],0),0)' />
      </column>
      <column caption='Trx.SuccessRate' datatype='real' default-format='p0.00%' name='[Calculation_672795622903320579]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1025554092412567553]+[Trx.Success (copy)_1401112091497975808])/SUM(ZN([count_of_transactions]))' />
      </column>
      <column caption='Time Detail.Size' datatype='real' name='[Calculation_672795622923485191]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// 1/[Time detail]&#10;1/[Parameters].[Parameter 2] * 0.8' />
      </column>
      <column caption='Record Datetime UTC - refine' datatype='datetime' name='[Record Datetime UTC (copy)_424956885307547648]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[record_datetime]' />
      </column>
      <column datatype='string' name='[Status]' role='dimension' type='nominal' />
      <column caption='Trx.Failure' datatype='integer' name='[Trx.Pending (copy)_1401112091499220993]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF(UPPER([Status])=&apos;FAILURE&apos;,[count_of_transactions],0)' />
      </column>
      <column caption='Trx.Pending' datatype='integer' name='[Trx.Success (copy)_1401112091497975808]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF(UPPER([Status])=&apos;PENDING&apos;,[count_of_transactions],0)' />
      </column>
