      <group delimiter=' - ' name='[Gateway Id, Gateway Version, Payment Method (Combined)]' name-style='unqualified' user:ui-builder='nest-group'>
        <groupfilter function='crossjoin'>
          <groupfilter function='level-members' level='[gateway_id]' />
          <groupfilter function='level-members' level='[gateway_version]' />
          <groupfilter function='level-members' level='[payment_method]' />
        </groupfilter>
      </group>
      <group name='[User Filter - Global Entity ID]' name-style='unqualified' user:ui-builder='identity-set'>
        <groupfilter function='intersection'>
          <groupfilter function='level-members' level='[global_entity_id]' />
          <groupfilter function='union'>
            <groupfilter expression='false' function='filter'>
              <groupfilter function='level-members' level='[global_entity_id]' />
            </groupfilter>
            <groupfilter expression='ISMEMBEROF(&apos;gsr_payment_developer&apos;)' function='filter'>
              <groupfilter function='union'>
                <groupfilter function='member' level='[global_entity_id]' member='&quot;AP_PA&quot;' />
                <groupfilter function='member' level='[global_entity_id]' member='&quot;DJ_CZ&quot;' />
