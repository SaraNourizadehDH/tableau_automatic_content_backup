          <datasource-dependencies datasource='federated.16pmonl1x7ou5m13afwts14h957x'>
            <column caption='BR (%) usr' datatype='real' default-format='p0.0%' name='[BR (%) (copy)_1507791105633050631]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([bank_refusal_user_count])/sum([user_count])' />
            </column>
            <column caption='Last Month' datatype='datetime' datatype-customized='true' name='[Calculation_1002543522353696769]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED: MAX(&#10;   [Calculation_1002543522354552834]&#10;)}' />
