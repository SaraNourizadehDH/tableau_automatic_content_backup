    <dashboard name='Performance Deep Dive'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/PaymentPerformance/PerformanceDeepDive?rev=' id='PerformanceDeepDive' path='/t/GlobalStandardReporting/workbooks/PaymentPerformance' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='table'>
          <format attr='background-color' value='#f5f5f6' />
        </style-rule>
        <style-rule element='dash-text'>
          <format attr='text-align' id='dash-text_16' value='left' />
        </style-rule>
      </style>
      <size maxheight='1000' maxwidth='1300' minheight='1000' minwidth='1300' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='psp_payment_performance+ (rl_fintech)' name='federated.16pmonl1x7ou5m13afwts14h957x' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column alias='Transaction level' caption='KPI type' datatype='integer' datatype-customized='true' name='[Parameter 2]' param-domain-type='list' role='measure' type='quantitative' value='1'>
          <calculation class='tableau' formula='1' />
          <aliases>
            <alias key='1' value='Transaction level' />
            <alias key='2' value='User level' />
          </aliases>
          <members>
            <member alias='Transaction level' value='1' />
            <member alias='User level' value='2' />
          </members>
        </column>
        <column alias='Day' caption='Time Dimension' datatype='integer' datatype-customized='true' name='[Parameter 6]' param-domain-type='list' role='measure' type='quantitative' value='1'>
          <calculation class='tableau' formula='1' />
          <aliases>
            <alias key='1' value='Day' />
            <alias key='2' value='Week' />
            <alias key='3' value='Month' />
            <alias key='4' value='Year' />
          </aliases>
          <members>
            <member alias='Day' value='1' />
            <member alias='Week' value='2' />
            <member alias='Month' value='3' />
            <member alias='Year' value='4' />
          </members>
        </column>
        <column alias='Total' caption='View by' datatype='integer' datatype-customized='true' name='[Parameter 7]' param-domain-type='list' role='measure' type='quantitative' value='1'>
          <calculation class='tableau' formula='1' />
