              </aliases>
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.16pmonl1x7ou5m13afwts14h957x].[Calculation_1002543522353696769]' _.fcp.ParameterDefaultValues.true...source-field='[federated.16pmonl1x7ou5m13afwts14h957x].[Calculation_1002543522367414286]' caption='Month Selection' datatype='date' default-format='*MMMM &apos;YY' name='[Parameter 8]' param-domain-type='list' role='measure' type='quantitative' value='#2023-04-01#'>
              <calculation class='tableau' formula='#2023-04-01#' />
            </column>
            <column alias='Success Rate' caption='KPI selection - overview tab' datatype='integer' datatype-customized='true' name='[Parameter 9]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='Success Rate' />
                <alias key='2' value='Bank Refusal Rate' />
                <alias key='3' value='Drop Rate' />
                <alias key='4' value='Fraud Rate' />
              </aliases>
