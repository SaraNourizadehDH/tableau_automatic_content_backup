            <column caption='SR (%)' datatype='real' name='[Calculation_3464956985616486405]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([approved_trx_count])/sum([trx_count])' />
            </column>
            <column caption='DT (%) usr' datatype='real' name='[DT (%) (copy)_1507791105633148936]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([dropped_user_count])/sum([user_count])' />
            </column>
            <column caption='FT (%) usr' datatype='real' name='[FT (%) (copy)_1507791105633226761]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([fraud_user_count])/sum([user_count])' />
            </column>
            <column caption='SR (%) usr' datatype='real' name='[SR (%) (copy)_1507791105633308682]' role='measure' type='quantitative'>
