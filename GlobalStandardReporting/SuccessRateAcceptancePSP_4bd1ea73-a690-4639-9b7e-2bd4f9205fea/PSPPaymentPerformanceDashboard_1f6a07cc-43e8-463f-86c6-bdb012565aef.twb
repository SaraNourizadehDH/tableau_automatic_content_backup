            </column>
            <column caption='date - month (filter)' datatype='boolean' name='[Calculation_1002543522357735428]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1002543522367414286] = [Parameters].[Parameter 8]' />
            </column>
            <column caption='date - month' datatype='date' datatype-customized='true' name='[Calculation_1002543522367414286]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [psp_receive_date]))' />
            </column>
            <column caption='KPI Selection - overview tab' datatype='real' name='[Calculation_1002543522393751574]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = 1 //&apos;transaction-level&apos;&#10;THEN&#10;    CASE [Parameters].[Parameter 9]&#10;        WHEN 1 THEN [Calculation_3464956985616486405]&#10;        WHEN 2 THEN [approved_trx_% (copy)_3464956985616650246]&#10;        WHEN 4 THEN [dropped_trx_% (copy)_3464956985617219592]&#10;    ELSE [bank_refusal_trx_% (copy)_3464956985617108999]&#10;    END&#10;ELSE&#10;   CASE [Parameters].[Parameter 9]&#10;        WHEN 1 THEN [SR (%) (copy)_1507791105633308682]&#10;        WHEN 2 THEN [BR (%) (copy)_1507791105633050631]&#10;        WHEN 4 THEN [FT (%) (copy)_1507791105633226761]&#10;    ELSE [DT (%) (copy)_1507791105633148936]&#10;    END&#10;END' />
            </column>
            <column caption='order_device' datatype='string' name='[Calculation_179299605992923137]' role='dimension' type='nominal'>
