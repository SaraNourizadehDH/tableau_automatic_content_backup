          <datasource-dependencies datasource='federated.16pmonl1x7ou5m13afwts14h957x'>
            <column caption='BR (%) usr' datatype='real' default-format='p0.0%' name='[BR (%) (copy)_1507791105633050631]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([bank_refusal_user_count])/sum([user_count])' />
            </column>
            <column caption='Time Dimension' datatype='string' name='[Calculation_1002543522350039040]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;// DAY&#10;WHEN 1 then DATENAME(&apos;day&apos;,[psp_receive_date]) + &quot; &quot; + LEFT(DATENAME(&apos;month&apos;,[psp_receive_date]),3) + &quot; &apos;&quot; + RIGHT(DATENAME(&apos;year&apos;,[psp_receive_date]),2)&#10;// WEEK&#10;WHEN 2 then &quot;WK &quot; + DATENAME(&apos;week&apos;,[psp_receive_date]) + &quot; &quot; + DATENAME(&apos;year&apos;,[psp_receive_date])&#10;// MONTH&#10;WHEN 3 then DATENAME(&apos;month&apos;,[psp_receive_date]) + &quot; &quot; + DATENAME(&apos;year&apos;,[psp_receive_date])&#10;// YEAR&#10;WHEN 4 then DATENAME(&apos;year&apos;,[psp_receive_date])&#10;END' />
            </column>
            <column caption='View by' datatype='string' name='[Calculation_1002543522356379651]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#10;    WHEN 4 THEN [psp]&#10;    WHEN 3 THEN [country]&#10;    WHEN 2 THEN [region]&#10;    WHEN 10 THEN STR([threeds_flag])&#10;    WHEN 6 THEN [payment_method_be]&#10;    WHEN 7 THEN [psp_payment_method]&#10;    WHEN 8 THEN [authorization_type]&#10;    WHEN 9 THEN [Calculation_179299605992923137]&#10;    WHEN 11 THEN [alfred_flag (copy)_1823465305400635392]&#10;    //WHEN &apos;Vendor Type&apos; THEN [vertical_type_be]&#10;    WHEN 5 THEN [merchant_account]&#10;ELSE &apos;Total&apos;&#10;END' />
            </column>
            <column caption='KPI Selection - overview tab' datatype='real' name='[Calculation_1002543522393751574]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = 1 //&apos;transaction-level&apos;&#10;THEN&#10;    CASE [Parameters].[Parameter 9]&#10;        WHEN 1 THEN [Calculation_3464956985616486405]&#10;        WHEN 2 THEN [approved_trx_% (copy)_3464956985616650246]&#10;        WHEN 4 THEN [dropped_trx_% (copy)_3464956985617219592]&#10;    ELSE [bank_refusal_trx_% (copy)_3464956985617108999]&#10;    END&#10;ELSE&#10;   CASE [Parameters].[Parameter 9]&#10;        WHEN 1 THEN [SR (%) (copy)_1507791105633308682]&#10;        WHEN 2 THEN [BR (%) (copy)_1507791105633050631]&#10;        WHEN 4 THEN [FT (%) (copy)_1507791105633226761]&#10;    ELSE [DT (%) (copy)_1507791105633148936]&#10;    END&#10;END' />
            </column>
