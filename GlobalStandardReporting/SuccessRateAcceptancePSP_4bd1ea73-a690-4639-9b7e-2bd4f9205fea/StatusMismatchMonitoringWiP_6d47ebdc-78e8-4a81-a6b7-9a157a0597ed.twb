            <column caption='LOD Orders Mismatch NPBC' datatype='real' name='[LOD Orders Mismatch PBNP (copy)_3240480710043213834]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//SUM([# Orders])&#13;&#10;//SUM({FIXED [Date], [display_delivered_only], [Country] : SUM([# Orders])})&#13;&#10;&#10;    IF [Parameters].[Parameter 2] == &quot;percent&quot; THEN&#13;&#10;        IF TOTAL(COUNTD( [country] )) != 1 THEN&#13;&#10;            SUM([% Not processed but charged (copy)_3240480710043070473])/SUM({FIXED [order_date], [display_delivered_only] : SUM([order_count])})*100&#13;&#10;        elseif TOTAL(COUNTD( [country] )) = 1 THEN&#13;&#10;            SUM([% Not processed but charged (copy)_3240480710043070473])/SUM({FIXED [order_date], [display_delivered_only], [country] : SUM([order_count])})*100&#13;&#10;&#10;        END&#13;&#10;    ELSE&#13;&#10;    SUM([% Not processed but charged (copy)_3240480710043070473])&#13;&#10;    END'>
                <table-calc ordering-type='Rows' />
