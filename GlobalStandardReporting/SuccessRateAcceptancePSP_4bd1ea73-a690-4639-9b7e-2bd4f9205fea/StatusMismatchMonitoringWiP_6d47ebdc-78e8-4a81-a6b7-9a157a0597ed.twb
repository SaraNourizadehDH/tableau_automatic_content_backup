            <column caption='LOD Orders Mismatch' datatype='real' name='[Calculation_1314488157046968320]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//SUM([# Orders])&#13;&#10;//SUM({FIXED [Date], [display_delivered_only], [Country] : SUM([# Orders])})&#13;&#10;IF [Parameters].[Parameter 2] == &quot;percent&quot; THEN&#13;&#10;    IF TOTAL(COUNTD( [country] )) != 1 THEN&#13;&#10;        SUM([order_count])/SUM({FIXED [order_date], [display_delivered_only] : SUM([order_count])})*100&#13;&#10;    else&#13;&#10;        SUM([order_count])/SUM({FIXED [order_date], [display_delivered_only], [country] : SUM([order_count])})*100&#13;&#10;    END&#13;&#10;ELSE&#13;&#10;SUM([order_count])&#13;&#10;END'>
