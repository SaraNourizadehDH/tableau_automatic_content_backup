    <worksheet name='sheet - Mismatch by Date'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='11'>% Mismatch by Date</run>
            <run>Æ&#10;</run>
            <run fontsize='10'>Please select a percentage to see the details</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='status_mismatch_monitoring (rl_fintech)' name='federated.1m6im6p09x594k1ejhh9t1r0ttf5' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Time Frame' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
              <calculation class='tableau' formula='&quot;Day&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1m6im6p09x594k1ejhh9t1r0ttf5'>
            <column caption='Order Share of Total' datatype='real' default-format='p0.00%' name='[Calculation1 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_count]) / TOTAL(SUM([order_count]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Based on' datatype='string' name='[Calculation_238127892552081408]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [display_delivered_only] = TRUE then &quot;Delivered Transactions&quot;&#13;&#10;ELSE &quot;Processed Transactions&quot;&#13;&#10;END' />
            </column>
            <column caption='Time Frame' datatype='string' name='[Calculation_3055551660444409857]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Day&apos; THEN [Calculation_3055551660446998531] + &quot;.&quot; + [Day (copy)_3055551660447592453]&#10;WHEN &apos;Week&apos; THEN &quot;WK&quot; + [Day (copy)_3055551660447391748]&#10;WHEN &apos;Month&apos; THEN [Month Number (copy)_3055551660447969286]&#10;WHEN &apos;Year&apos; THEN [Calculation_3055551660448182279]&#10;END' />
            </column>
            <column caption='Day' datatype='string' name='[Calculation_3055551660446998531]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF INT(DATENAME(&apos;day&apos;,[order_date])) &lt; 10 THEN &quot;0&quot; + DATENAME(&apos;day&apos;,[order_date])&#10;ELSE DATENAME(&apos;day&apos;,[order_date])&#10;END' />
            </column>
            <column caption='Year' datatype='string' name='[Calculation_3055551660448182279]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;year&apos;,[order_date])' />
            </column>
            <column caption='Mixed Payment Flag' datatype='string' name='[Calculation_649362777053175808]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_mixed_payment] = TRUE THEN &apos;Mixed Payment&apos; &#13;&#10;ELSEIF  [is_mixed_payment] = FALSE THEN &apos;Non Mixed Payment&apos;&#13;&#10;ELSE &apos;Unknown&apos;&#13;&#10;END' />
            </column>
            <column caption='Week' datatype='string' name='[Day (copy)_3055551660447391748]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF INT(DATENAME(&apos;week&apos;,[order_date])) &lt; 10 THEN &quot;0&quot; + DATENAME(&apos;week&apos;,[order_date])&#10;ELSE DATENAME(&apos;week&apos;,[order_date])&#10;END' />
            </column>
            <column caption='Month Number' datatype='string' name='[Day (copy)_3055551660447592453]' role='dimension' type='nominal'>
