            <column caption='LOD Orders Mismatch PBNP' datatype='real' name='[LOD Orders Mismatch (copy)_3240480710027403266]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//SUM([# Orders])&#13;&#10;//SUM({FIXED [Date], [display_delivered_only], [Country] : SUM([# Orders])})&#13;&#10;&#10;    IF [Parameters].[Parameter 2] == &quot;percent&quot; THEN&#13;&#10;        IF TOTAL(COUNTD( [country] )) != 1 THEN&#13;&#10;            SUM([% Processed but not paid (copy)_3240480710028972035])/SUM({FIXED [order_date], [display_delivered_only] : SUM([order_count])})*100&#13;&#10;        elseif TOTAL(COUNTD( [country] )) = 1 THEN&#13;&#10;            SUM([% Processed but not paid (copy)_3240480710028972035])/SUM({FIXED [order_date], [display_delivered_only], [country] : SUM([order_count])})*100&#13;&#10;&#10;        END&#13;&#10;    ELSE&#13;&#10;    SUM([% Processed but not paid (copy)_3240480710028972035])&#13;&#10;    END'>
