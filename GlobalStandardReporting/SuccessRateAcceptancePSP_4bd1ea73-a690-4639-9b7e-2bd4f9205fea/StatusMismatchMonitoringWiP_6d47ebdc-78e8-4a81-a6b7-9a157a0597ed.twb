      <aliases enabled='yes' />
      <column caption='# Orders (Cleaned)' datatype='integer' name='[# Orders (copy)_1314488157070602241]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([order_count])' />
      </column>
      <column caption='% Non-Mismatch' datatype='real' name='[% Mismatch (copy)_1921981549934907401]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - [Calculation_1921981549918658560]' />
      </column>
      <column caption='% Not processed but charged (from Total)' datatype='real' name='[% Not processed but charged (copy)_1575134009547632641]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Processed but not paid (copy)_600104688524886019]/[LOD Orders Mismatch (copy)_600104688527056900]' />
      </column>
      <column caption='# Not processed but charged' datatype='integer' name='[% Not processed but charged (copy)_3240480710043070473]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [mismatch_category] = &apos;Not processed but charged the customer&apos; THEN [order_count] ELSE 0 END' />
      </column>
      <column caption='% Processed but not paid (from Total)' datatype='real' name='[% Processed but not paid (copy)_1575134009547886594]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_600104688498917377]/[LOD Orders Mismatch (copy)_600104688527056900]' />
      </column>
      <column caption='# Processed but not paid' datatype='integer' name='[% Processed but not paid (copy)_3240480710028972035]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [mismatch_category] = &apos;Processed but not paid&apos; THEN [order_count] ELSE 0 END' />
      </column>
      <column caption='Anomaly Type' datatype='string' name='[Anomaly Category (copy)_1314488157107879946]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='/*IF NOT ISNULL([npbc_value_abs]) &#13;&#10;then &quot;Absolute&quot;&#13;&#10;ELSEIF  NOT ISNULL([npbc_value_perc]) &#13;&#10;then &quot;Percent&quot;&#13;&#10;ELSEIF NOT ISNULL([pbnp_value_abs])&#13;&#10;then &quot;Absolute&quot;&#13;&#10;ELSEIF NOT ISNULL([pbnp_value_perc])&#13;&#10;then &quot;Percent&quot;&#13;&#10;END*/&#13;&#10;&#13;&#10;IF [Calculation_1314488157105754121] = &quot;Not processed but charged the customer&quot; and NOT ISNULL([npbc_value_abs]) and NOT ISNULL([npbc_value_perc]) THEN&#13;&#10;&quot;Percent and Absolute&quot;&#13;&#10;ELSEIF [Calculation_1314488157105754121] = &quot;Not processed but charged the customer&quot; and ISNULL([npbc_value_abs]) and NOT ISNULL([npbc_value_perc]) THEN&#13;&#10;&quot;Percent&quot;&#13;&#10;ELSEIF [Calculation_1314488157105754121] = &quot;Not processed but charged the customer&quot; and NOT ISNULL([npbc_value_abs]) and ISNULL([npbc_value_perc]) THEN&#13;&#10;&quot;Absolute&quot;&#13;&#10;ELSEIF [Calculation_1314488157105754121] = &quot;Processed but not paid&quot; and NOT ISNULL([pbnp_value_abs]) and NOT ISNULL([pbnp_value_perc]) THEN&#13;&#10;&quot;Percent and Absolute&quot;&#13;&#10;ELSEIF [Calculation_1314488157105754121] = &quot;Processed but not paid&quot; and ISNULL([pbnp_value_abs]) and NOT ISNULL([pbnp_value_perc]) THEN&#13;&#10;&quot;Percent&quot;&#13;&#10;ELSEIF [Calculation_1314488157105754121] = &quot;Processed but not paid&quot; and NOT ISNULL([pbnp_value_abs]) and ISNULL([pbnp_value_perc]) THEN&#13;&#10;&quot;Absolute&quot;&#13;&#10;END' />
      </column>
      <column caption='Order Share of Total' datatype='real' default-format='p0.00%' name='[Calculation1 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([order_count]) / TOTAL(SUM([order_count]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Mismatch_%_color' datatype='real' default-format='p0.00%' name='[Calculation2]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE ATTR([mismatch_category])&#10;WHEN &apos;Success&apos; THEN (WINDOW_MAX(SUM([order_count]) / TOTAL(SUM([order_count]))))&#10;                    -SUM([order_count]) / TOTAL(SUM([order_count]))&#10;ELSE SUM([order_count]) / TOTAL(SUM([order_count]))&#10;END'>
          <table-calc ordering-type='Columns' />
        </calculation>
      </column>
      <column caption='Processed but not paid (param)' datatype='real' name='[Calculation_1002895387580116992]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] == &quot;percent&quot; THEN&#13;&#10;    [% Processed but not paid (copy)_1575134009547886594]*100&#13;&#10;else&#13;&#10;    [Calculation_600104688498917377]&#13;&#10;END' />
      </column>
      <column caption='Calculation1' datatype='integer' name='[Calculation_1016124694175461376]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [mismatch_category] =  [Calculation_1314488157105754121] and [display_delivered_only] = TRUE then [order_count] END)' />
      </column>
      <column caption='Username Active' datatype='boolean' name='[Calculation_110619714756390912]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]=USERNAME()' />
      </column>
      <column caption='LOD Orders Mismatch' datatype='real' name='[Calculation_1314488157046968320]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//SUM([# Orders])&#13;&#10;//SUM({FIXED [Date], [display_delivered_only], [Country] : SUM([# Orders])})&#13;&#10;IF [Parameters].[Parameter 2] == &quot;percent&quot; THEN&#13;&#10;    IF TOTAL(COUNTD( [country] )) != 1 THEN&#13;&#10;        SUM([order_count])/SUM({FIXED [order_date], [display_delivered_only] : SUM([order_count])})*100&#13;&#10;    else&#13;&#10;        SUM([order_count])/SUM({FIXED [order_date], [display_delivered_only], [country] : SUM([order_count])})*100&#13;&#10;    END&#13;&#10;ELSE&#13;&#10;SUM([order_count])&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Severity' datatype='string' name='[Calculation_1314488157079543812]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] == &quot;percent&quot; and [mismatch_category] == &quot;Processed but not paid&quot; then&#13;&#10;[pbnp_sev_cat_perc]&#13;&#10;ELSEIF [Parameters].[Parameter 2] == &quot;absolute&quot; and [mismatch_category] == &quot;Processed but not paid&quot; then &#13;&#10;[pbnp_sev_cat_abs]&#13;&#10;ELSEIF [Parameters].[Parameter 2] == &quot;percent&quot; and [mismatch_category] == &quot;Not processed but charged the customer&quot; then&#13;&#10;[npbc_sev_cat_perc]&#13;&#10;ELSEIF [Parameters].[Parameter 2] == &quot;absolute&quot; and [mismatch_category] == &quot;Not processed but charged the customer&quot; then&#13;&#10;[npbc_sev_cat_abs]&#13;&#10;END' />
      </column>
      <column caption='Mismatch Suffix' datatype='string' name='[Calculation_1314488157099831302]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] == &quot;percent&quot; then &quot;%&quot; else &quot;&quot; END' />
      </column>
      <column caption='LOD Orders Mismatch (Label)' datatype='real' name='[Calculation_1314488157101453319]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Severity (copy)_1314488157083365381] != &quot;Non Anomaly&quot; then [Calculation_1314488157046968320] END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Anomaly Category' datatype='string' name='[Calculation_1314488157105754121]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF NOT ISNULL([npbc_value_abs]) &#13;&#10;then &quot;Not processed but charged the customer&quot;&#13;&#10;ELSEIF  NOT ISNULL([npbc_value_perc]) &#13;&#10;then &quot;Not processed but charged the customer&quot;&#13;&#10;ELSEIF NOT ISNULL([pbnp_value_abs])&#13;&#10;then &quot;Processed but not paid&quot;&#13;&#10;ELSEIF NOT ISNULL([pbnp_value_perc])&#13;&#10;then &quot;Processed but not paid&quot;&#13;&#10;END' />
      </column>
      <column caption='Top PSP' datatype='string' name='[Calculation_1314488157134733333]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1314488157105754121] = &quot;Not processed but charged the customer&quot; and [Anomaly Category (copy)_1314488157107879946] = &quot;Percent and Absolute&quot; THEN&#13;&#10;&quot;Percent: &quot; + [npbc_top_psp_perc] + &quot;, Absolute: &quot; + [npbc_top_psp_abs]&#13;&#10;ELSEIF [Calculation_1314488157105754121] = &quot;Not processed but charged the customer&quot; and [Anomaly Category (copy)_1314488157107879946] = &quot;Absolute&quot; THEN&#13;&#10;[npbc_top_psp_abs]&#13;&#10;ELSEIF [Calculation_1314488157105754121] = &quot;Not processed but charged the customer&quot; and [Anomaly Category (copy)_1314488157107879946] = &quot;Percent&quot; THEN&#13;&#10;[npbc_top_psp_perc]&#13;&#10;ELSEIF [Calculation_1314488157105754121] = &quot;Processed but not paid&quot; and [Anomaly Category (copy)_1314488157107879946] = &quot;Percent and Absolute&quot; THEN&#13;&#10;&quot;Percent: &quot; + [pbnp_top_psp_perc] + &quot;, Absolute: &quot; + [pbnp_top_psp_abs]&#13;&#10;ELSEIF [Calculation_1314488157105754121] = &quot;Processed but not paid&quot; and [Anomaly Category (copy)_1314488157107879946] = &quot;Absolute&quot; THEN&#13;&#10;[pbnp_top_psp_abs]&#13;&#10;ELSEIF [Calculation_1314488157105754121] = &quot;Processed but not paid&quot; and [Anomaly Category (copy)_1314488157107879946] = &quot;Percent&quot; THEN&#13;&#10;[pbnp_top_psp_perc]&#13;&#10;END' />
      </column>
      <column caption='% Mismatch Orders' datatype='real' name='[Calculation_1575134009551441923]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1921981549927096324]/[LOD Orders Mismatch (copy)_600104688527056900]' />
      </column>
      <column caption='% Mismatch' datatype='real' name='[Calculation_1921981549918658560]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1921981549927096324] / SUM( [order_count])' />
      </column>
      <column caption='#' datatype='integer' name='[Calculation_1921981549922009089]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% Pre-PSP Failure' datatype='real' name='[Calculation_1921981549923282946]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1921981549927239685] / SUM([order_count])' />
      </column>
      <column caption='# Delivered Orders' datatype='integer' name='[Calculation_1921981549926940675]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_delivered] = True THEN [order_count] ELSE 0 END)' />
      </column>
      <column caption='# Mismatch Orders' datatype='integer' name='[Calculation_1921981549927096324]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_mismatch] = 1 THEN [order_count] ELSE 0 END)' />
      </column>
      <column caption='# Pre-PSP Failure Orders' datatype='integer' name='[Calculation_1921981549927239685]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [mismatch_category] = &apos;Pre PSP Failure&apos; THEN [order_count] ELSE 0 END)' />
      </column>
      <column caption='(filter) is outlier' datatype='string' name='[Calculation_1921981549928968199]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF country = &apos;Hungary&apos; AND DATE([order_date]) &lt; DATE(&apos;2020-09-01&apos;) THEN &apos;Yes&apos;&#10;ELSE &apos;No&apos;&#10;END' />
      </column>
      <column caption='Based on' datatype='string' name='[Calculation_238127892552081408]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [display_delivered_only] = TRUE then &quot;Delivered Transactions&quot;&#13;&#10;ELSE &quot;Processed Transactions&quot;&#13;&#10;END' />
      </column>
      <column caption='Time Frame' datatype='string' name='[Calculation_3055551660444409857]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Day&apos; THEN [Calculation_3055551660446998531] + &quot;.&quot; + [Day (copy)_3055551660447592453]&#10;WHEN &apos;Week&apos; THEN &quot;WK&quot; + [Day (copy)_3055551660447391748]&#10;WHEN &apos;Month&apos; THEN [Month Number (copy)_3055551660447969286]&#10;WHEN &apos;Year&apos; THEN [Calculation_3055551660448182279]&#10;END' />
      </column>
      <column caption='Day' datatype='string' name='[Calculation_3055551660446998531]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF INT(DATENAME(&apos;day&apos;,[order_date])) &lt; 10 THEN &quot;0&quot; + DATENAME(&apos;day&apos;,[order_date])&#10;ELSE DATENAME(&apos;day&apos;,[order_date])&#10;END' />
      </column>
      <column caption='Year' datatype='string' name='[Calculation_3055551660448182279]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;year&apos;,[order_date])' />
      </column>
      <column caption='Country - anomalies count' datatype='integer' name='[Calculation_3240480710024282113]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([Country (List) (copy)_3240480710022959104]) = &apos;no anomaly&apos; then 0&#10;ELSE COUNTD([Country (List) (copy)_3240480710022959104])&#10;END' />
      </column>
      <column caption='Test_color_conditional' datatype='real' name='[Calculation_3531877652703502338]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([mismatch_category]) = &quot;Success&quot;&#10;THEN (1-[Calculation1 1])/WINDOW_MAX(1-[Calculation1 1])&#10;ELSEIF ATTR([mismatch_category]) != &quot;Success&quot;&#10;THEN ([Calculation1 1])/WINDOW_MAX([Calculation1 1])&#10;ELSE NUll&#10;END'>
          <table-calc ordering-field='[federated.1m6im6p09x594k1ejhh9t1r0ttf5].[mismatch_category]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='BE Order Status (Grouped)' datatype='string' name='[Calculation_5740048872800112642]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;    CONTAINS(LOWER([be_order_status]), &quot;unfinished order&quot;) OR &#10;    CONTAINS(LOWER([be_order_status]), &quot;unifinished order&quot;) OR &#10;    CONTAINS(LOWER([be_order_status]), &quot;waiting for payment validation&quot;) OR &#10;    CONTAINS(LOWER([be_order_status]), &quot;incomplete order&quot;)&#10;THEN &quot;Incomplete&quot;&#10;ELSEIF [is_delivered] = True&#10;THEN &quot;Delivered&quot;&#10;ELSE &quot;Not Delivered but processed&quot;&#10;END' />
      </column>
      <column caption='% Processed but not paid' datatype='real' name='[Calculation_5740048872824487940]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [mismatch_category] = &apos;Processed but not paid&apos; THEN [order_count] ELSE 0 END)&#10;/ SUM([order_count])' />
      </column>
      <column caption='% Not processed but charged' datatype='real' name='[Calculation_5740048872824872965]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [mismatch_category] = &apos;Not processed but charged the customer&apos; THEN [order_count] ELSE 0 END)&#10;/ SUM([order_count])' />
      </column>
      <column caption='Pie category share' datatype='string' name='[Calculation_600104688486666240]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [is_mismatch] = 1 then [mismatch_category] else &quot;Not mismatch orders&quot; END' />
      </column>
      <column caption='Processed but not paid' datatype='integer' name='[Calculation_600104688498917377]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [mismatch_category] = &quot;Processed but not paid&quot; then [order_count] END)' />
      </column>
      <column caption='Mixed Payment Flag' datatype='string' name='[Calculation_649362777053175808]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_mixed_payment] = TRUE THEN &apos;Mixed Payment&apos; &#13;&#10;ELSEIF  [is_mixed_payment] = FALSE THEN &apos;Non Mixed Payment&apos;&#13;&#10;ELSE &apos;Unknown&apos;&#13;&#10;END' />
      </column>
      <column caption='# Mismatch' datatype='real' name='[Calculation_84161056833138689]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;absolute&quot; then&#13;&#10;    IF [Parameters].[Parameter 3] = &quot;all&quot; then&#13;&#10;        [Calculation_1921981549927096324]&#13;&#10;    ELSEIF  [Parameters].[Parameter 3] = &quot;pbnp&quot; then&#13;&#10;        [Calculation_600104688498917377]&#13;&#10;    ELSEIF  [Parameters].[Parameter 3] = &quot;npbc&quot; then&#13;&#10;        [Processed but not paid (copy)_600104688524886019]&#13;&#10;    END&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;percent&quot; then&#13;&#10;    IF [Parameters].[Parameter 3] = &quot;all&quot; then&#13;&#10;        ([Calculation_1921981549927096324]/[LOD Orders Mismatch (copy)_600104688527056900]) * 100&#13;&#10;    ELSEIF  [Parameters].[Parameter 3] = &quot;pbnp&quot; then&#13;&#10;        ([Calculation_600104688498917377]/[LOD Orders Mismatch (copy)_600104688527056900]) * 100&#13;&#10;    ELSEIF  [Parameters].[Parameter 3] = &quot;npbc&quot; then&#13;&#10;        ([Processed but not paid (copy)_600104688524886019]/[LOD Orders Mismatch (copy)_600104688527056900]) * 100&#13;&#10;    END&#13;&#10;END' />
      </column>
      <column caption='Country (List) (copy)' datatype='string' name='[Country (List) (copy)_3240480710022959104]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
        <calculation class='tableau' formula='IF NOT ISNULL([npbc_value_abs]) &#13;&#10;then [country]&#13;&#10;ELSEIF  NOT ISNULL([npbc_value_perc]) &#13;&#10;then [country]&#13;&#10;ELSEIF NOT ISNULL([pbnp_value_abs])&#13;&#10;then [country]&#13;&#10;ELSEIF NOT ISNULL([pbnp_value_perc])&#13;&#10;then [country]&#10;ELSEIF NOT ISNULL ([order_count])&#10;THEN &apos;no anomaly&apos;&#13;&#10;END' />
      </column>
      <column caption='Week' datatype='string' name='[Day (copy)_3055551660447391748]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF INT(DATENAME(&apos;week&apos;,[order_date])) &lt; 10 THEN &quot;0&quot; + DATENAME(&apos;week&apos;,[order_date])&#10;ELSE DATENAME(&apos;week&apos;,[order_date])&#10;END' />
      </column>
      <column caption='Month Number' datatype='string' name='[Day (copy)_3055551660447592453]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF INT(month([order_date])) &lt; 10 THEN &quot;0&quot; + STR(month([order_date]))&#10;ELSE STR(month([order_date]))&#10;END' />
      </column>
      <column caption='LOD Orders Mismatch PBND (Label)' datatype='real' name='[LOD Orders Mismatch (Label) (copy)_3240480710038732807]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF MAX([Severity_PBNP (copy)_3240480710313324559]) &gt;0 then [LOD Orders Mismatch (copy)_3240480710027403266] END'>
          <table-calc ordering-type='Rows' />
        </calculation>
