          <datasource-dependencies datasource='federated.1m6im6p09x594k1ejhh9t1r0ttf5'>
            <column caption='Anomaly Type' datatype='string' name='[Anomaly Category (copy)_1314488157107879946]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='/*IF NOT ISNULL([npbc_value_abs]) &#13;&#10;then &quot;Absolute&quot;&#13;&#10;ELSEIF  NOT ISNULL([npbc_value_perc]) &#13;&#10;then &quot;Percent&quot;&#13;&#10;ELSEIF NOT ISNULL([pbnp_value_abs])&#13;&#10;then &quot;Absolute&quot;&#13;&#10;ELSEIF NOT ISNULL([pbnp_value_perc])&#13;&#10;then &quot;Percent&quot;&#13;&#10;END*/&#13;&#10;&#13;&#10;IF [Calculation_1314488157105754121] = &quot;Not processed but charged the customer&quot; and NOT ISNULL([npbc_value_abs]) and NOT ISNULL([npbc_value_perc]) THEN&#13;&#10;&quot;Percent and Absolute&quot;&#13;&#10;ELSEIF [Calculation_1314488157105754121] = &quot;Not processed but charged the customer&quot; and ISNULL([npbc_value_abs]) and NOT ISNULL([npbc_value_perc]) THEN&#13;&#10;&quot;Percent&quot;&#13;&#10;ELSEIF [Calculation_1314488157105754121] = &quot;Not processed but charged the customer&quot; and NOT ISNULL([npbc_value_abs]) and ISNULL([npbc_value_perc]) THEN&#13;&#10;&quot;Absolute&quot;&#13;&#10;ELSEIF [Calculation_1314488157105754121] = &quot;Processed but not paid&quot; and NOT ISNULL([pbnp_value_abs]) and NOT ISNULL([pbnp_value_perc]) THEN&#13;&#10;&quot;Percent and Absolute&quot;&#13;&#10;ELSEIF [Calculation_1314488157105754121] = &quot;Processed but not paid&quot; and ISNULL([pbnp_value_abs]) and NOT ISNULL([pbnp_value_perc]) THEN&#13;&#10;&quot;Percent&quot;&#13;&#10;ELSEIF [Calculation_1314488157105754121] = &quot;Processed but not paid&quot; and NOT ISNULL([pbnp_value_abs]) and ISNULL([pbnp_value_perc]) THEN&#13;&#10;&quot;Absolute&quot;&#13;&#10;END' />
            </column>
            <column caption='Anomaly Category' datatype='string' name='[Calculation_1314488157105754121]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF NOT ISNULL([npbc_value_abs]) &#13;&#10;then &quot;Not processed but charged the customer&quot;&#13;&#10;ELSEIF  NOT ISNULL([npbc_value_perc]) &#13;&#10;then &quot;Not processed but charged the customer&quot;&#13;&#10;ELSEIF NOT ISNULL([pbnp_value_abs])&#13;&#10;then &quot;Processed but not paid&quot;&#13;&#10;ELSEIF NOT ISNULL([pbnp_value_perc])&#13;&#10;then &quot;Processed but not paid&quot;&#13;&#10;END' />
            </column>
            <column caption='Country - anomalies count' datatype='integer' name='[Calculation_3240480710024282113]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([Country (List) (copy)_3240480710022959104]) = &apos;no anomaly&apos; then 0&#10;ELSE COUNTD([Country (List) (copy)_3240480710022959104])&#10;END' />
            </column>
            <column caption='Country (List) (copy)' datatype='string' name='[Country (List) (copy)_3240480710022959104]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='tableau' formula='IF NOT ISNULL([npbc_value_abs]) &#13;&#10;then [country]&#13;&#10;ELSEIF  NOT ISNULL([npbc_value_perc]) &#13;&#10;then [country]&#13;&#10;ELSEIF NOT ISNULL([pbnp_value_abs])&#13;&#10;then [country]&#13;&#10;ELSEIF NOT ISNULL([pbnp_value_perc])&#13;&#10;then [country]&#10;ELSEIF NOT ISNULL ([order_count])&#10;THEN &apos;no anomaly&apos;&#13;&#10;END' />
            </column>
            <column caption='Country (List)' datatype='string' name='[Severity (List) (copy)_1314488157112918028]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF NOT ISNULL([npbc_value_abs]) &#13;&#10;then [country]&#13;&#10;ELSEIF  NOT ISNULL([npbc_value_perc]) &#13;&#10;then [country]&#13;&#10;ELSEIF NOT ISNULL([pbnp_value_abs])&#13;&#10;then [country]&#13;&#10;ELSEIF NOT ISNULL([pbnp_value_perc])&#13;&#10;then [country]&#13;&#10;END' />
            </column>
            <column caption='Severity (List Legend)' datatype='string' name='[Severity (List) (copy)_1314488157130264589]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='/*IF [Anomaly Category] = &quot;Processed but not paid&quot; and [Anomaly Type] = &quot;Percent&quot; then&#13;&#10;[pbnp_sev_cat_perc]&#13;&#10;ELSEIF [Anomaly Category] = &quot;Processed but not paid&quot; and [Anomaly Type] = &quot;Absolute&quot; then&#13;&#10;[pbnp_sev_cat_abs]&#13;&#10;ELSEIF [Anomaly Category] = &quot;Not processed but charged the customer&quot; and [Anomaly Type] = &quot;Percent&quot; then&#13;&#10;[npbc_sev_cat_perc]&#13;&#10;ELSEIF [Anomaly Category] = &quot;Not processed but charged the customer&quot; and [Anomaly Type] = &quot;Absolute&quot; then&#13;&#10;[npbc_sev_cat_abs]&#13;&#10;END*/&#13;&#10;&#13;&#10;IF [Calculation_1314488157105754121] = &quot;Not processed but charged the customer&quot; and [Anomaly Category (copy)_1314488157107879946] = &quot;Percent and Absolute&quot; THEN&#13;&#10;    IF CONTAINS(&quot;Percent: &quot; + [npbc_sev_cat_perc] + &quot;, Absolute: &quot; + [npbc_sev_cat_abs],&quot;Severe&quot;) THEN &quot;Severe Anomaly&quot; ELSE &quot;Minor Anomaly&quot; end&#13;&#10;ELSEIF [Calculation_1314488157105754121] = &quot;Not processed but charged the customer&quot; and [Anomaly Category (copy)_1314488157107879946] = &quot;Absolute&quot; THEN&#13;&#10;[npbc_sev_cat_abs]&#13;&#10;ELSEIF [Calculation_1314488157105754121] = &quot;Not processed but charged the customer&quot; and [Anomaly Category (copy)_1314488157107879946] = &quot;Percent&quot; THEN&#13;&#10;[npbc_sev_cat_perc]&#13;&#10;ELSEIF [Calculation_1314488157105754121] = &quot;Processed but not paid&quot; and [Anomaly Category (copy)_1314488157107879946] = &quot;Percent and Absolute&quot; THEN&#13;&#10;    IF CONTAINS(&quot;Percent: &quot; + [pbnp_sev_cat_perc] + &quot;, Absolute: &quot; + [pbnp_sev_cat_abs],&quot;Severe&quot;) THEN &quot;Severe Anomaly&quot; ELSE &quot;Minor Anomaly&quot; end&#13;&#10;ELSEIF [Calculation_1314488157105754121] = &quot;Processed but not paid&quot; and [Anomaly Category (copy)_1314488157107879946] = &quot;Absolute&quot; THEN&#13;&#10;[pbnp_sev_cat_abs]&#13;&#10;ELSEIF [Calculation_1314488157105754121] = &quot;Processed but not paid&quot; and [Anomaly Category (copy)_1314488157107879946] = &quot;Percent&quot; THEN&#13;&#10;[pbnp_sev_cat_perc]&#13;&#10;END' />
            </column>
