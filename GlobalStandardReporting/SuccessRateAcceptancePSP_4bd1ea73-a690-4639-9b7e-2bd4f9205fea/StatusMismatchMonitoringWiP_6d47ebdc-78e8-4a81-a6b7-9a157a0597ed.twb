    <worksheet name='Time Series'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='12'>Status Mismatch Development</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='status_mismatch_monitoring (rl_fintech)' name='federated.1m6im6p09x594k1ejhh9t1r0ttf5' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Time Frame' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
              <calculation class='tableau' formula='&quot;Day&quot;' />
            </column>
            <column alias='Percent' caption='Display as' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;percent&quot;'>
              <calculation class='tableau' formula='&quot;percent&quot;' />
              <aliases>
                <alias key='&quot;absolute&quot;' value='Absolute' />
                <alias key='&quot;percent&quot;' value='Percent' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1m6im6p09x594k1ejhh9t1r0ttf5'>
            <column caption='% Not processed but charged (from Total)' datatype='real' name='[% Not processed but charged (copy)_1575134009547632641]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Processed but not paid (copy)_600104688524886019]/[LOD Orders Mismatch (copy)_600104688527056900]' />
            </column>
            <column caption='% Processed but not paid (from Total)' datatype='real' name='[% Processed but not paid (copy)_1575134009547886594]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_600104688498917377]/[LOD Orders Mismatch (copy)_600104688527056900]' />
            </column>
            <column caption='Processed but not paid (param)' datatype='real' name='[Calculation_1002895387580116992]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] == &quot;percent&quot; THEN&#13;&#10;    [% Processed but not paid (copy)_1575134009547886594]*100&#13;&#10;else&#13;&#10;    [Calculation_600104688498917377]&#13;&#10;END' />
            </column>
            <column caption='Mismatch Suffix' datatype='string' name='[Calculation_1314488157099831302]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] == &quot;percent&quot; then &quot;%&quot; else &quot;&quot; END' />
            </column>
            <column caption='Based on' datatype='string' name='[Calculation_238127892552081408]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [display_delivered_only] = TRUE then &quot;Delivered Transactions&quot;&#13;&#10;ELSE &quot;Processed Transactions&quot;&#13;&#10;END' />
            </column>
            <column caption='Time Frame' datatype='string' name='[Calculation_3055551660444409857]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Day&apos; THEN [Calculation_3055551660446998531] + &quot;.&quot; + [Day (copy)_3055551660447592453]&#10;WHEN &apos;Week&apos; THEN &quot;WK&quot; + [Day (copy)_3055551660447391748]&#10;WHEN &apos;Month&apos; THEN [Month Number (copy)_3055551660447969286]&#10;WHEN &apos;Year&apos; THEN [Calculation_3055551660448182279]&#10;END' />
            </column>
            <column caption='Day' datatype='string' name='[Calculation_3055551660446998531]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF INT(DATENAME(&apos;day&apos;,[order_date])) &lt; 10 THEN &quot;0&quot; + DATENAME(&apos;day&apos;,[order_date])&#10;ELSE DATENAME(&apos;day&apos;,[order_date])&#10;END' />
            </column>
            <column caption='Year' datatype='string' name='[Calculation_3055551660448182279]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;year&apos;,[order_date])' />
            </column>
            <column caption='Pie category share' datatype='string' name='[Calculation_600104688486666240]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [is_mismatch] = 1 then [mismatch_category] else &quot;Not mismatch orders&quot; END' />
            </column>
            <column caption='Processed but not paid' datatype='integer' name='[Calculation_600104688498917377]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [mismatch_category] = &quot;Processed but not paid&quot; then [order_count] END)' />
            </column>
            <column caption='Week' datatype='string' name='[Day (copy)_3055551660447391748]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF INT(DATENAME(&apos;week&apos;,[order_date])) &lt; 10 THEN &quot;0&quot; + DATENAME(&apos;week&apos;,[order_date])&#10;ELSE DATENAME(&apos;week&apos;,[order_date])&#10;END' />
            </column>
            <column caption='Month Number' datatype='string' name='[Day (copy)_3055551660447592453]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF INT(month([order_date])) &lt; 10 THEN &quot;0&quot; + STR(month([order_date]))&#10;ELSE STR(month([order_date]))&#10;END' />
            </column>
            <column caption='LOD Orders All' datatype='integer' name='[LOD Orders Mismatch (copy)_600104688527056900]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({FIXED [order_date], [country], [display_delivered_only] : SUM([order_count])})' />
            </column>
            <column caption='Month Name' datatype='string' name='[Month Number (copy)_3055551660447969286]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;month&apos;,[order_date])' />
            </column>
            <column caption='Not processed but charged the customer' datatype='integer' name='[Processed but not paid (copy)_600104688524886019]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [mismatch_category] = &quot;Not processed but charged the customer&quot; then [order_count] END)' />
