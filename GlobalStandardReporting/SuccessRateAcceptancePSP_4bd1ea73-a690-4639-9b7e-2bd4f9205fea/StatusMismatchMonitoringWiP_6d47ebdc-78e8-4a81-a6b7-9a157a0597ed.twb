            </column>
            <column caption='# Mismatch' datatype='real' name='[Calculation_84161056833138689]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;absolute&quot; then&#13;&#10;    IF [Parameters].[Parameter 3] = &quot;all&quot; then&#13;&#10;        [Calculation_1921981549927096324]&#13;&#10;    ELSEIF  [Parameters].[Parameter 3] = &quot;pbnp&quot; then&#13;&#10;        [Calculation_600104688498917377]&#13;&#10;    ELSEIF  [Parameters].[Parameter 3] = &quot;npbc&quot; then&#13;&#10;        [Processed but not paid (copy)_600104688524886019]&#13;&#10;    END&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;percent&quot; then&#13;&#10;    IF [Parameters].[Parameter 3] = &quot;all&quot; then&#13;&#10;        ([Calculation_1921981549927096324]/[LOD Orders Mismatch (copy)_600104688527056900]) * 100&#13;&#10;    ELSEIF  [Parameters].[Parameter 3] = &quot;pbnp&quot; then&#13;&#10;        ([Calculation_600104688498917377]/[LOD Orders Mismatch (copy)_600104688527056900]) * 100&#13;&#10;    ELSEIF  [Parameters].[Parameter 3] = &quot;npbc&quot; then&#13;&#10;        ([Processed but not paid (copy)_600104688524886019]/[LOD Orders Mismatch (copy)_600104688527056900]) * 100&#13;&#10;    END&#13;&#10;END' />
            </column>
            <column caption='LOD Orders All' datatype='integer' name='[LOD Orders Mismatch (copy)_600104688527056900]' role='measure' type='quantitative'>
