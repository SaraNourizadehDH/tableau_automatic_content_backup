    <worksheet name='Country mismatch'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='12'>Status Mismatch per Country</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='status_mismatch_monitoring (rl_fintech)' name='federated.1m6im6p09x594k1ejhh9t1r0ttf5' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Percent' caption='Display as' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;percent&quot;'>
              <calculation class='tableau' formula='&quot;percent&quot;' />
              <aliases>
                <alias key='&quot;absolute&quot;' value='Absolute' />
                <alias key='&quot;percent&quot;' value='Percent' />
              </aliases>
            </column>
            <column alias='All Mismatches' caption='Mismatch Category' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;all&quot;'>
              <calculation class='tableau' formula='&quot;all&quot;' />
              <aliases>
                <alias key='&quot;all&quot;' value='All Mismatches' />
                <alias key='&quot;npbc&quot;' value='Not processed but charged the customer' />
                <alias key='&quot;pbnp&quot;' value='Processed but not paid' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1m6im6p09x594k1ejhh9t1r0ttf5'>
            <column caption='# Mismatch Orders' datatype='integer' name='[Calculation_1921981549927096324]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_mismatch] = 1 THEN [order_count] ELSE 0 END)' />
            </column>
            <column caption='Based on' datatype='string' name='[Calculation_238127892552081408]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [display_delivered_only] = TRUE then &quot;Delivered Transactions&quot;&#13;&#10;ELSE &quot;Processed Transactions&quot;&#13;&#10;END' />
            </column>
            <column caption='Pie category share' datatype='string' name='[Calculation_600104688486666240]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [is_mismatch] = 1 then [mismatch_category] else &quot;Not mismatch orders&quot; END' />
            </column>
            <column caption='Processed but not paid' datatype='integer' name='[Calculation_600104688498917377]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [mismatch_category] = &quot;Processed but not paid&quot; then [order_count] END)' />
            </column>
            <column caption='# Mismatch' datatype='real' name='[Calculation_84161056833138689]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;absolute&quot; then&#13;&#10;    IF [Parameters].[Parameter 3] = &quot;all&quot; then&#13;&#10;        [Calculation_1921981549927096324]&#13;&#10;    ELSEIF  [Parameters].[Parameter 3] = &quot;pbnp&quot; then&#13;&#10;        [Calculation_600104688498917377]&#13;&#10;    ELSEIF  [Parameters].[Parameter 3] = &quot;npbc&quot; then&#13;&#10;        [Processed but not paid (copy)_600104688524886019]&#13;&#10;    END&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;percent&quot; then&#13;&#10;    IF [Parameters].[Parameter 3] = &quot;all&quot; then&#13;&#10;        ([Calculation_1921981549927096324]/[LOD Orders Mismatch (copy)_600104688527056900]) * 100&#13;&#10;    ELSEIF  [Parameters].[Parameter 3] = &quot;pbnp&quot; then&#13;&#10;        ([Calculation_600104688498917377]/[LOD Orders Mismatch (copy)_600104688527056900]) * 100&#13;&#10;    ELSEIF  [Parameters].[Parameter 3] = &quot;npbc&quot; then&#13;&#10;        ([Processed but not paid (copy)_600104688524886019]/[LOD Orders Mismatch (copy)_600104688527056900]) * 100&#13;&#10;    END&#13;&#10;END' />
            </column>
            <column caption='LOD Orders All' datatype='integer' name='[LOD Orders Mismatch (copy)_600104688527056900]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({FIXED [order_date], [country], [display_delivered_only] : SUM([order_count])})' />
            </column>
            <column caption='Mismatch Suffix (copy)' datatype='string' name='[Mismatch Suffix (copy)_84161056838311939]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] == &quot;percent&quot; and ISNULL([Calculation_84161056833138689]) = FALSE then &quot;%&quot; else &quot;&quot; END' />
            </column>
            <column caption='Not processed but charged the customer' datatype='integer' name='[Processed but not paid (copy)_600104688524886019]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [mismatch_category] = &quot;Not processed but charged the customer&quot; then [order_count] END)' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='boolean' name='[display_delivered_only]' role='dimension' type='nominal' />
            <column aggregation='Sum' caption='Is Mismatch?' datatype='integer' name='[is_mismatch]' role='dimension' type='ordinal' />
            <column caption='Category' datatype='string' name='[mismatch_category]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_238127892552081408]' derivation='None' name='[none:Calculation_238127892552081408:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_600104688486666240]' derivation='None' name='[none:Calculation_600104688486666240:nk]' pivot='key' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column-instance column='[is_mismatch]' derivation='None' name='[none:is_mismatch:ok]' pivot='key' type='ordinal' />
            <column-instance column='[mismatch_category]' derivation='None' name='[none:mismatch_category:nk]' pivot='key' type='nominal' />
            <column-instance column='[order_date]' derivation='None' name='[none:order_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[region]' derivation='None' name='[none:region:nk]' pivot='key' type='nominal' />
            <column caption='# Orders' datatype='integer' name='[order_count]' role='measure' type='quantitative' />
            <column caption='Date' datatype='date' name='[order_date]' role='dimension' type='ordinal' />
            <column caption='Region' datatype='string' name='[region]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_84161056833138689]' derivation='User' name='[usr:Calculation_84161056833138689:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Mismatch Suffix (copy)_84161056838311939]' derivation='User' name='[usr:Mismatch Suffix (copy)_84161056838311939:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1m6im6p09x594k1ejhh9t1r0ttf5].[none:Calculation_238127892552081408:nk]' filter-group='38'>
