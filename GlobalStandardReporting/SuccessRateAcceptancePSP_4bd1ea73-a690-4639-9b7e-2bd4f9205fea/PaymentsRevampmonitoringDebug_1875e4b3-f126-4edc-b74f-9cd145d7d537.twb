            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1gjkgdu1nvthsy1drx84c0ydjpaa].[Calculation_215891312211312654]' caption='Day reference' datatype='date' name='[Parameter 2]' param-domain-type='any' role='measure' type='quantitative' value='#2024-02-05#'>
              <calculation class='tableau' formula='#2024-02-05#' />
