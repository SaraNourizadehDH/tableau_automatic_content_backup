            </column>
            <column caption='Max PSP Status name LOD' datatype='string' name='[Calculation_997125120672591874]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ FIXED : MAX(&#10;&#10;IF [Calculation_997125120669167617] =  { FIXED [Calculation_2306054160532103169],&#10;    [global_entity_id], [region], [payment_method], [payment_service]: SUM([fail_order_count]) }&#10;&#10;THEN [Calculation_2306054160532103169]&#10;&#10;END&#10;&#10;)}' />
            </column>
            <column caption='PSP Operation Status' datatype='string' name='[Calculation_997125120674897924]' role='dimension' type='nominal'>
