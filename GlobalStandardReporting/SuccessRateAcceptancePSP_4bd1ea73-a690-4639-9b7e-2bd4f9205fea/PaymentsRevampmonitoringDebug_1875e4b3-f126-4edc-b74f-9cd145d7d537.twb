            <column alias='Order Count' caption='Decline Metrics' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;count&quot;'>
              <calculation class='tableau' formula='&quot;count&quot;' />
              <aliases>
                <alias key='&quot;count&quot;' value='Order Count' />
                <alias key='&quot;dist&quot;' value='Decline reasons share' />
                <alias key='&quot;rate&quot;' value='Decline Rate' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1gjkgdu1nvthsy1drx84c0ydjpaa'>
            <column caption='Decline reasons distribution' datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_order_count]) / TOTAL(SUM([fail_order_count]))'>
                <table-calc ordering-type='Columns' />
              </calculation>
            </column>
            <column caption='Order Date - timeframe' datatype='date' datatype-customized='true' name='[Calculation_215891311842963457]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parameter 1], [order_date], &apos;Monday&apos;))' />
            </column>
            <column caption='Date filter parameter' datatype='boolean' name='[Calculation_215891311847628807]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 2]=[Calculation_215891311842963457]' />
            </column>
            <column caption='MAX Order Date - timeframe' datatype='date' name='[Calculation_215891312211312654]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{MAX([Calculation_215891311842963457])}' />
            </column>
            <column caption='PSP Operation Status - param' datatype='string' name='[Calculation_2306054160526520320]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 10]&#10;WHEN &apos;group&apos; THEN [Calculation_997125120674897924]&#10;WHEN &apos;raw&apos; THEN IFNULL([acquirer_raw_response], [Calculation_997125120674897924])&#10;ELSE Null&#10;END' />
            </column>
            <column caption='Fail Orders - non-zero filter' datatype='boolean' name='[Calculation_3356448405189910528]' role='measure' type='nominal'>
              <calculation class='tableau' formula='SUM([fail_order_count])&gt;0' />
            </column>
            <column caption='Filter report_name' datatype='boolean' name='[Calculation_6435573507004825602]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_name]=[Parameters].[Parameter 4]' />
            </column>
            <column caption='Decline Rate over Totals' datatype='real' default-format='p0.00%' name='[Calculation_997125120634564608]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_order_count])/TOTAL(SUM([total_order]))'>
                <table-calc ordering-field='[federated.1gjkgdu1nvthsy1drx84c0ydjpaa].[payment_service]' ordering-type='Field' />
              </calculation>
            </column>
            <column caption='PSP Operation Status' datatype='string' name='[Calculation_997125120674897924]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF(ZN([fail_order_count]) &gt; 0,IFNULL([operation_status],&apos;&lt;No Data&gt;&apos;),Null)' />
            </column>
            <column caption='Decline metrics' datatype='real' default-format='N' name='[Calculation_997125120954744838]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;WHEN &apos;count&apos; THEN SUM([fail_order_count])&#10;WHEN &apos;dist&apos; THEN ROUND([Calculation1]*100,2)&#10;WHEN &apos;rate&apos; THEN ROUND([Calculation_997125120634564608]*100,2)&#10;ELSE Null&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Metrics Suffix.Declines' datatype='string' default-format='N' name='[Decline metrics (copy)_997125121018142729]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;WHEN &apos;count&apos; THEN &apos;&apos;&#10;WHEN &apos;dist&apos; THEN IIF(ISNULL([Calculation_997125120954744838]),&apos;&apos;,&apos;%&apos;)&#10;WHEN &apos;rate&apos; THEN IIF(ISNULL([Calculation_997125120954744838]),&apos;&apos;,&apos;%&apos;)&#10;ELSE Null&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Order Date - timeframe STR' datatype='string' datatype-customized='true' name='[Order Date - timeframe (copy)_215891312204046349]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;day&apos; THEN STR(DAY([order_date]))+&apos;.&apos;+ LEFT(DATENAME(&apos;month&apos;, [order_date]),3) +&apos;.&apos;+ RIGHT(DATENAME(&apos;year&apos;, [order_date]),2)&#10;WHEN &apos;week&apos; THEN &apos;W&apos;+DATENAME(&apos;week&apos;,[order_date],&apos;Monday&apos;) + &apos; &apos; + DATENAME(&apos;year&apos;, [order_date])&#10;WHEN &apos;month&apos; THEN LEFT(DATENAME(&apos;month&apos;, [order_date]),3) + &apos; &apos; + DATENAME(&apos;year&apos;, [order_date])&#10;ELSE Null&#10;END' />
            </column>
