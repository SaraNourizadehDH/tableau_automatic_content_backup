        <calculation class='tableau' formula='SUM(IIF([payment_service]=&apos;new_flow&apos;,[total_order], Null))&#10;/&#10;SUM([total_order])' />
      </column>
      <column caption='Acceptance Rate.new_flow' datatype='real' default-format='p0.00%' name='[Acceptance Rate.old_flow (copy)_215891311846227972]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([payment_service]=&apos;new_flow&apos;,[Calculation_5833850391768276992], Null))&#10;/&#10;SUM(IIF([payment_service]=&apos;new_flow&apos;,[total_order], Null))' />
      </column>
      <column caption='Acceptance Rate.diffTimeframe' datatype='real' default-format='p0.00%' name='[Acceptance Rate.old_flow (copy)_215891311852523531]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='( SUM(IIF([Calculation_215891311851241480]=&apos;Reporting period&apos; AND [payment_service]=&apos;new_flow&apos;,[Calculation_5833850391768276992], Null))&#10;/&#10;SUM(IIF([Calculation_215891311851241480]=&apos;Reporting period&apos; AND [payment_service]=&apos;new_flow&apos;,[total_order], Null)) )&#10;-&#10;( SUM(IIF([Calculation_215891311851241480]=&apos;Comparison period&apos; AND [payment_service]=&apos;new_flow&apos;,[Calculation_5833850391768276992], Null))&#10;/&#10;SUM(IIF([Calculation_215891311851241480]=&apos;Comparison period&apos; AND [payment_service]=&apos;new_flow&apos;,[total_order], Null)) )' />
      </column>
      <column caption='Decline reasons distribution' datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fail_order_count]) / TOTAL(SUM([fail_order_count]))'>
