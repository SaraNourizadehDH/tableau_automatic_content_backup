      <table>
        <view>
          <datasources>
            <datasource caption='payment_revamp_analytics (rl_fintech)' name='federated.1gjkgdu1nvthsy1drx84c0ydjpaa' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Order Count' caption='Recovery Metrics' datatype='string' name='[Decline Metrics (copy)_1432355811231178759]' param-domain-type='list' role='measure' type='nominal' value='&quot;count&quot;'>
              <calculation class='tableau' formula='&quot;count&quot;' />
              <aliases>
                <alias key='&quot;count&quot;' value='Order Count' />
                <alias key='&quot;dist&quot;' value='Recovery share' />
                <alias key='&quot;rate&quot;' value='Recovery rate' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1gjkgdu1nvthsy1drx84c0ydjpaa'>
            <column caption='Last Payment Method (grouped)' datatype='string' name='[Calculation_685673090087522304]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS(UPPER([last_payment_method]),&quot;COD&quot;) THEN &quot;COD&quot; ELSE [last_payment_method] END' />
            </column>
            <column caption='Recovery over Totals' datatype='real' default-format='p0.00%' name='[Decline Rate over Totals (copy)_1432355811231678474]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([recovery_order_count])/TOTAL(SUM([total_order]))'>
                <table-calc ordering-field='[federated.1gjkgdu1nvthsy1drx84c0ydjpaa].[payment_service]' ordering-type='Field' />
              </calculation>
            </column>
            <column caption='Recovery metrics' datatype='real' default-format='N' name='[Decline metrics (copy)_1432355811231301640]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Decline Metrics (copy)_1432355811231178759]&#10;WHEN &apos;count&apos; THEN SUM([recovery_order_count])&#10;WHEN &apos;dist&apos; THEN ROUND([Decline reasons distribution (copy)_1432355811231465481]*100,2)&#10;WHEN &apos;rate&apos; THEN ROUND([Decline Rate over Totals (copy)_1432355811231678474]*100,2)&#10;ELSE Null&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Metrics Suffix.Recovery' datatype='string' default-format='N' name='[Decline metrics Suffix (copy)_1432355811232411660]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Decline Metrics (copy)_1432355811231178759]&#10;WHEN &apos;count&apos; THEN &apos;&apos;&#10;WHEN &apos;dist&apos; THEN IIF(ISNULL([Decline metrics (copy)_1432355811231301640]),&apos;&apos;,&apos;%&apos;)&#10;WHEN &apos;rate&apos; THEN IIF(ISNULL([Decline metrics (copy)_1432355811231301640]),&apos;&apos;,&apos;%&apos;)&#10;ELSE Null&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Recovery distribution' datatype='real' default-format='p0.00%' name='[Decline reasons distribution (copy)_1432355811231465481]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([recovery_order_count]) / TOTAL(SUM([recovery_order_count]))'>
                <table-calc ordering-field='[federated.1gjkgdu1nvthsy1drx84c0ydjpaa].[payment_service]' ordering-type='Field' />
