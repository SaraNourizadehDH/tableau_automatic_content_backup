    <worksheet name='AR-diff-flows'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Performance on &lt;</run>
            <run>[federated.1gjkgdu1nvthsy1drx84c0ydjpaa].[none:Order Date - timeframe (copy)_215891312204046349:nk]</run>
            <run>&gt;</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontcolor='#333333' fontsize='10'>New flow x Old flow</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='payment_revamp_analytics (rl_fintech)' name='federated.1gjkgdu1nvthsy1drx84c0ydjpaa' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Daily' caption='Select a timeframe' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;day&quot;'>
              <calculation class='tableau' formula='&quot;day&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1gjkgdu1nvthsy1drx84c0ydjpaa].[Calculation_215891312211312654]' caption='Day reference' datatype='date' name='[Parameter 2]' param-domain-type='any' role='measure' type='quantitative' value='#2024-02-05#'>
              <calculation class='tableau' formula='#2024-02-05#' />
            </column>
            <column alias='Acceptance Rate' caption='Select aggregation' datatype='string' datatype-customized='true' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Acceptance Rate&quot;'>
              <calculation class='tableau' formula='&quot;Acceptance Rate&quot;' />
              <aliases>
                <alias key='&quot;Acceptance Rate&quot;' value='Acceptance Rate' />
                <alias key='&quot;Transaction Success Rate&quot;' value='Transaction Success Rate' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1gjkgdu1nvthsy1drx84c0ydjpaa'>
            <column caption='Acceptance Rate.old_flow' datatype='real' default-format='p0.00%' name='[Acceptance Rate (copy)_215891311845933059]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([payment_service]=&apos;old_flow&apos;,[Calculation_5833850391768276992], Null))&#10;/&#10;SUM(IIF([payment_service]=&apos;old_flow&apos;,[total_order], Null))' />
            </column>
            <column caption='Acceptance Rate.new_flow' datatype='real' default-format='p0.00%' name='[Acceptance Rate.old_flow (copy)_215891311846227972]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([payment_service]=&apos;new_flow&apos;,[Calculation_5833850391768276992], Null))&#10;/&#10;SUM(IIF([payment_service]=&apos;new_flow&apos;,[total_order], Null))' />
            </column>
            <column caption='Label - p.p. for Diff' datatype='string' name='[Calculation_1432355811153649664]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IIF(ISNULL([Calculation_215891311846481925]), &apos;&apos;, &apos;p.p.&apos;)' />
            </column>
            <column caption='Order Date - timeframe' datatype='date' datatype-customized='true' name='[Calculation_215891311842963457]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parameter 1], [order_date], &apos;Monday&apos;))' />
            </column>
            <column caption='Acceptance Rate.diff-old-new' datatype='real' default-format='p0.00%' name='[Calculation_215891311846481925]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Acceptance Rate.old_flow (copy)_215891311846227972]-[Acceptance Rate (copy)_215891311845933059]' />
            </column>
            <column caption='Date filter parameter' datatype='boolean' name='[Calculation_215891311847628807]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 2]=[Calculation_215891311842963457]' />
            </column>
            <column caption='MAX Order Date - timeframe' datatype='date' name='[Calculation_215891312211312654]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{MAX([Calculation_215891311842963457])}' />
            </column>
            <column caption='Successful Orders/Trx' datatype='integer' name='[Calculation_5833850391768276992]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([report_name] = &quot;Transaction Success Rate&quot; , [success_order_count] , [accepted_order_count])' />
            </column>
            <column caption='Filter report_name' datatype='boolean' name='[Calculation_6435573507004825602]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_name]=[Parameters].[Parameter 4]' />
            </column>
            <column caption='Order Date - timeframe STR' datatype='string' datatype-customized='true' name='[Order Date - timeframe (copy)_215891312204046349]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;day&apos; THEN STR(DAY([order_date]))+&apos;.&apos;+ LEFT(DATENAME(&apos;month&apos;, [order_date]),3) +&apos;.&apos;+ RIGHT(DATENAME(&apos;year&apos;, [order_date]),2)&#10;WHEN &apos;week&apos; THEN &apos;W&apos;+DATENAME(&apos;week&apos;,[order_date],&apos;Monday&apos;) + &apos; &apos; + DATENAME(&apos;year&apos;, [order_date])&#10;WHEN &apos;month&apos; THEN LEFT(DATENAME(&apos;month&apos;, [order_date]),3) + &apos; &apos; + DATENAME(&apos;year&apos;, [order_date])&#10;ELSE Null&#10;END' />
            </column>
            <column caption='Accepted Order Count' datatype='integer' name='[accepted_order_count]' role='measure' type='quantitative' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_215891311842963457]' derivation='None' name='[none:Calculation_215891311842963457:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_215891311847628807]' derivation='None' name='[none:Calculation_215891311847628807:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_6435573507004825602]' derivation='None' name='[none:Calculation_6435573507004825602:nk]' pivot='key' type='nominal' />
            <column-instance column='[Order Date - timeframe (copy)_215891312204046349]' derivation='None' name='[none:Order Date - timeframe (copy)_215891312204046349:nk]' pivot='key' type='nominal' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[order_date]' derivation='None' name='[none:order_date:qk]' pivot='key' type='quantitative' />
