      <column caption='Acceptance Rate.old_flow' datatype='real' default-format='p0.00%' name='[Acceptance Rate (copy)_215891311845933059]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([payment_service]=&apos;old_flow&apos;,[Calculation_5833850391768276992], Null))&#10;/&#10;SUM(IIF([payment_service]=&apos;old_flow&apos;,[total_order], Null))' />
      </column>
      <column caption='Acceptance Rate.diffAvg' datatype='real' default-format='p0.00%' name='[Acceptance Rate.diffTimeframe (copy)_215891312883744787]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([Period logic (copy)_215891312883425298]=&apos;Reporting period&apos;,[Calculation_5833850391768276992], Null))&#10;/&#10;SUM(IIF([Period logic (copy)_215891312883425298]=&apos;Reporting period&apos;,[total_order], Null))&#10;-&#10;SUM(IIF([Period logic (copy)_215891312883425298]=&apos;Comparison period&apos;,[Calculation_5833850391768276992], Null))&#10;/&#10;SUM(IIF([Period logic (copy)_215891312883425298]=&apos;Comparison period&apos;,[total_order], Null))' />
      </column>
