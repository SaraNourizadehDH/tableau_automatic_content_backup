          <datasource-dependencies datasource='federated.1gjkgdu1nvthsy1drx84c0ydjpaa'>
            <column caption='Decline reasons distribution' datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
