    <worksheet name='recovered_line'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Medium' fontsize='12'>Recovery % &lt;</run>
            <run fontname='Tableau Medium' fontsize='12'>[Parameters].[Parameter 1]</run>
            <run fontname='Tableau Medium' fontsize='12'>&gt; trend</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='payment_revamp_analytics (rl_fintech)' name='federated.1gjkgdu1nvthsy1drx84c0ydjpaa' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Daily' caption='Select a timeframe' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;day&quot;'>
              <calculation class='tableau' formula='&quot;day&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1gjkgdu1nvthsy1drx84c0ydjpaa'>
            <column caption='Recovered Orders %' datatype='real' default-format='p0.00%' name='[Calculation_1432355811214581766]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([recovery_order_count])/SUM([total_order])' />
            </column>
            <column caption='Order Date - timeframe' datatype='date' datatype-customized='true' name='[Calculation_215891311842963457]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parameter 1], [order_date], &apos;Monday&apos;))' />
            </column>
            <column caption='Order Date - timeframe STR' datatype='string' datatype-customized='true' name='[Order Date - timeframe (copy)_215891312204046349]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;day&apos; THEN STR(DAY([order_date]))+&apos;.&apos;+ LEFT(DATENAME(&apos;month&apos;, [order_date]),3) +&apos;.&apos;+ RIGHT(DATENAME(&apos;year&apos;, [order_date]),2)&#10;WHEN &apos;week&apos; THEN &apos;W&apos;+DATENAME(&apos;week&apos;,[order_date],&apos;Monday&apos;) + &apos; &apos; + DATENAME(&apos;year&apos;, [order_date])&#10;WHEN &apos;month&apos; THEN LEFT(DATENAME(&apos;month&apos;, [order_date]),3) + &apos; &apos; + DATENAME(&apos;year&apos;, [order_date])&#10;ELSE Null&#10;END' />
