      </column>
      <column caption='PSP Operation Status - param' datatype='string' name='[Calculation_2306054160526520320]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 10]&#10;WHEN &apos;group&apos; THEN [Calculation_997125120674897924]&#10;WHEN &apos;raw&apos; THEN IFNULL([acquirer_raw_response], [Calculation_997125120674897924])&#10;ELSE Null&#10;END' />
      </column>
      <column caption='PSP Operation Status - raw' datatype='string' name='[Calculation_2306054160532103169]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([acquirer_raw_response], [Calculation_997125120674897924])&#10;//[PSP Operation Status]+ IFNULL(&apos;: &apos; + [acquirer_raw_response], &apos;&apos;)' />
      </column>
      <column caption='Latency Max seconds' datatype='real' name='[Calculation_2684286140945162240]' role='measure' type='quantitative'>
