      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='payment_revamp_analytics (rl_fintech)' name='federated.1gjkgdu1nvthsy1drx84c0ydjpaa' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Daily' caption='Select a timeframe' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;day&quot;'>
              <calculation class='tableau' formula='&quot;day&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
            <column alias='Region' caption='Breakdown by' datatype='string' name='[Parameter 7]' param-domain-type='list' role='measure' type='nominal' value='&quot;region&quot;'>
              <calculation class='tableau' formula='&quot;region&quot;' />
              <aliases>
                <alias key='&quot;device&quot;' value='Device' />
                <alias key='&quot;entity&quot;' value='Global Entity ID' />
                <alias key='&quot;pm&quot;' value='Payment Method' />
                <alias key='&quot;region&quot;' value='Region' />
              </aliases>
            </column>
            <column alias='Average' caption='Latency Aggregation' datatype='integer' name='[Parameter 8]' param-domain-type='list' role='measure' type='quantitative' value='0'>
              <calculation class='tableau' formula='0' />
              <aliases>
                <alias key='0' value='Average' />
                <alias key='1' value='Max' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1gjkgdu1nvthsy1drx84c0ydjpaa'>
            <column caption='Breakdown categories' datatype='string' name='[Calculation_1432355811156230145]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#10;WHEN &apos;entity&apos; THEN [global_entity_id]&#10;WHEN &apos;pm&apos; THEN [payment_method]&#10;WHEN &apos;region&apos; THEN [region]&#10;WHEN &apos;device&apos; THEN [order_device]&#10;ELSE null&#10;END' />
            </column>
            <column caption='Order Date - timeframe' datatype='date' datatype-customized='true' name='[Calculation_215891311842963457]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parameter 1], [order_date], &apos;Monday&apos;))' />
            </column>
            <column caption='Latency Max seconds' datatype='real' name='[Calculation_2684286140945162240]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX([max_latency])/1000' />
            </column>
            <column caption='Latency' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2684286140946534401]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 8]&#10;WHEN 0 then [Calculation_409616482262999040]&#10;WHEN 1 then [Calculation_2684286140945162240]&#10;ELSE Null&#10;END' />
            </column>
            <column caption='Avg Payment Latency seconds' datatype='real' name='[Calculation_409616482262999040]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='( SUM(ZN([latency]))/SUM(ZN([total_order])) ) / 1000' />
            </column>
            <column caption='Order Date - timeframe STR' datatype='string' datatype-customized='true' name='[Order Date - timeframe (copy)_215891312204046349]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;day&apos; THEN STR(DAY([order_date]))+&apos;.&apos;+ LEFT(DATENAME(&apos;month&apos;, [order_date]),3) +&apos;.&apos;+ RIGHT(DATENAME(&apos;year&apos;, [order_date]),2)&#10;WHEN &apos;week&apos; THEN &apos;W&apos;+DATENAME(&apos;week&apos;,[order_date],&apos;Monday&apos;) + &apos; &apos; + DATENAME(&apos;year&apos;, [order_date])&#10;WHEN &apos;month&apos; THEN LEFT(DATENAME(&apos;month&apos;, [order_date]),3) + &apos; &apos; + DATENAME(&apos;year&apos;, [order_date])&#10;ELSE Null&#10;END' />
            </column>
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column datatype='integer' name='[latency]' role='measure' type='quantitative' />
            <column datatype='integer' name='[max_latency]' role='measure' type='quantitative' />
