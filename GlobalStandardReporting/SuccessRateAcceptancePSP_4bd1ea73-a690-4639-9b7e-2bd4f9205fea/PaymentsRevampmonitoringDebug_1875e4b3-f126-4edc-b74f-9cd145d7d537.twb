              <calculation class='tableau' formula='&quot;day&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
            <column alias='Region' caption='Discrepancy breakdown 1' datatype='string' name='[Parameter 9]' param-domain-type='list' role='measure' type='nominal' value='&quot;region&quot;'>
              <calculation class='tableau' formula='&quot;region&quot;' />
              <aliases>
                <alias key='&quot;device&quot;' value='Device' />
                <alias key='&quot;id&quot;' value='Global Entity Id' />
                <alias key='&quot;pm&quot;' value='Payment Method' />
                <alias key='&quot;region&quot;' value='Region' />
                <alias key='&quot;vertical&quot;' value='Vertical' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1gjkgdu1nvthsy1drx84c0ydjpaa'>
            <column caption='Fraud Transactions Filter' datatype='string' name='[Calculation_132011790018703361]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [operation_status] = &apos;FRAUD_RISK&apos; THEN &apos;Fraud Transactions&apos; ELSE &apos;Non Fraud Transactions&apos; END' />
            </column>
            <column caption='Order Date - timeframe' datatype='date' datatype-customized='true' name='[Calculation_215891311842963457]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parameter 1], [order_date], &apos;Monday&apos;))' />
            </column>
            <column caption='Discrepancy category 1' datatype='string' name='[Calculation_2684286140983611396]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 9]&#10;WHEN &apos;id&apos; THEN [global_entity_id]&#10;WHEN &apos;region&apos; THEN [region]&#10;WHEN &apos;pm&apos; THEN [Payment Method (group)]&#10;WHEN &apos;device&apos; THEN [order_device]&#10;WHEN &apos;vertical&apos; THEN [vertical]&#10;ELSE Null&#10;END' />
            </column>
            <column caption='DB missing orders' datatype='integer' name='[Calculation_2684286140989067271]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_order])-SUM([backflow_order_cnt])' />
            </column>
            <column caption='DB missing orders - Non-zero' datatype='boolean' name='[Calculation_2684286140994433032]' role='measure' type='nominal'>
              <calculation class='tableau' formula='[Calculation_2684286140989067271]&gt;0' />
            </column>
            <column caption='DB mismatch %' datatype='real' default-format='p0.00%' name='[Completeness % (copy)_2684286140955312131]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-(SUM([backflow_order_cnt])/SUM([total_order]))' />
            </column>
            <column caption='Discrepancy category 2' datatype='string' name='[Discrepancy category 1 (copy)_2684286140984176646]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Discrepancy breakdown 1 (copy)_2684286140984135685]&#10;WHEN &apos;id&apos; THEN [global_entity_id]&#10;WHEN &apos;region&apos; THEN [region]&#10;WHEN &apos;pm&apos; THEN [Payment Method (group)]&#10;WHEN &apos;device&apos; THEN [order_device]&#10;WHEN &apos;vertical&apos; THEN [vertical]&#10;ELSE Null&#10;END' />
            </column>
            <column caption='Order Date - timeframe STR' datatype='string' datatype-customized='true' name='[Order Date - timeframe (copy)_215891312204046349]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;day&apos; THEN STR(DAY([order_date]))+&apos;.&apos;+ LEFT(DATENAME(&apos;month&apos;, [order_date]),3) +&apos;.&apos;+ RIGHT(DATENAME(&apos;year&apos;, [order_date]),2)&#10;WHEN &apos;week&apos; THEN &apos;W&apos;+DATENAME(&apos;week&apos;,[order_date],&apos;Monday&apos;) + &apos; &apos; + DATENAME(&apos;year&apos;, [order_date])&#10;WHEN &apos;month&apos; THEN LEFT(DATENAME(&apos;month&apos;, [order_date]),3) + &apos; &apos; + DATENAME(&apos;year&apos;, [order_date])&#10;ELSE Null&#10;END' />
            </column>
