      <column caption='Breakdown categories' datatype='string' name='[Calculation_1432355811156230145]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#10;WHEN &apos;entity&apos; THEN [global_entity_id]&#10;WHEN &apos;pm&apos; THEN [payment_method]&#10;WHEN &apos;region&apos; THEN [region]&#10;WHEN &apos;device&apos; THEN [order_device]&#10;ELSE null&#10;END' />
