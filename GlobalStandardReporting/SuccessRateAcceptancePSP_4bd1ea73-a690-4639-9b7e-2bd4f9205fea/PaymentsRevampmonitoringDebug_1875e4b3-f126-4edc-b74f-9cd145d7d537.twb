        <calculation class='tableau' formula='CASE [Parameters].[Decline Metrics (copy)_1432355811231178759]&#10;WHEN &apos;count&apos; THEN SUM([recovery_order_count])&#10;WHEN &apos;dist&apos; THEN ROUND([Decline reasons distribution (copy)_1432355811231465481]*100,2)&#10;WHEN &apos;rate&apos; THEN ROUND([Decline Rate over Totals (copy)_1432355811231678474]*100,2)&#10;ELSE Null&#10;END'>
