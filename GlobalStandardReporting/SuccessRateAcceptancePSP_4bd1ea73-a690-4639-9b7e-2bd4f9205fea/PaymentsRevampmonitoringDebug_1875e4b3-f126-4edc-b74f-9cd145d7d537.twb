        <calculation class='tableau' formula='CASE [Parameters].[Discrepancy breakdown 1 (copy)_2684286140984135685]&#10;WHEN &apos;id&apos; THEN [global_entity_id]&#10;WHEN &apos;region&apos; THEN [region]&#10;WHEN &apos;pm&apos; THEN [Payment Method (group)]&#10;WHEN &apos;device&apos; THEN [order_device]&#10;WHEN &apos;vertical&apos; THEN [vertical]&#10;ELSE Null&#10;END' />
