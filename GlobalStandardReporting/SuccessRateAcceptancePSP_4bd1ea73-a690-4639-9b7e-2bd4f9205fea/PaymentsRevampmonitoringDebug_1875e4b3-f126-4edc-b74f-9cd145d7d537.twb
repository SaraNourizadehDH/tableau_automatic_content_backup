      <column caption='Period x previous Period' datatype='string' name='[Calculation_215891311851241480]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_215891311842963457] = [Parameters].[Parameter 2]&#10;THEN &apos;Reporting period&apos;&#10;ELSEIF [Calculation_215891311842963457] = DATEADD([Parameters].[Parameter 1], -1, [Parameters].[Parameter 2])&#10;THEN &apos;Comparison period&apos;&#10;ELSE &apos;Not used&apos;&#10;END' />
      </column>
      <column caption='MAX Order Date - timeframe' datatype='date' name='[Calculation_215891312211312654]' role='dimension' type='ordinal'>
