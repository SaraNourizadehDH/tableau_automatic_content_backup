      <column caption='Decline metrics' datatype='real' default-format='N' name='[Calculation_997125120954744838]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;WHEN &apos;count&apos; THEN SUM([fail_order_count])&#10;WHEN &apos;dist&apos; THEN ROUND([Calculation1]*100,2)&#10;WHEN &apos;rate&apos; THEN ROUND([Calculation_997125120634564608]*100,2)&#10;ELSE Null&#10;END'>
