          <alias key='&quot;[federated.11abnlf178f05s124aw5c0e1j5fp].[usr:Calculation_672795622903320579:qk]&quot;' value='Trx Success Rate %' />
        </aliases>
      </column>
      <column caption='Record Datetime CET' datatype='datetime' name='[Calculation_359725080374370304]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF DATEPART(&apos;month&apos;,TODAY() ) &gt;= 4 AND DATEPART(&apos;month&apos;,TODAY() ) &lt;= 10&#10;THEN DATEADD(&apos;hour&apos;,2,[record_datetime])&#10;ELSE DATEADD(&apos;hour&apos;,1,[record_datetime])&#10;END' />
      </column>
      <column caption='Datetime CET.Max.Fixed' datatype='datetime' name='[Calculation_359725080377122817]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{MAX([Calculation_359725080374370304])}' />
      </column>
      <column caption='Trx.Success' datatype='integer' default-format='N' name='[Calculation_672795622902788097]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(&#10;    IIF([operation_status]=&apos;SUCCESS&apos;,[transaction_id], Null)&#10;)' />
      </column>
      <column caption='Trx.Total' datatype='integer' default-format='N' name='[Calculation_672795622903095298]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([transaction_id])' />
      </column>
      <column caption='Trx.SuccessRate' datatype='real' default-format='p0.00%' name='[Calculation_672795622903320579]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_672795622902788097]/[Calculation_672795622903095298]' />
      </column>
      <column caption='Datetime CET' datatype='datetime' name='[Calculation_672795622903668740]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN 1440 THEN [Calculation_359725080374370304]&#10;ELSE DATETIME((INT(FLOAT([Calculation_359725080374370304])*[Parameters].[Parameter 2]))/[Parameters].[Parameter 2])&#10;END' />
      </column>
      <column caption='User Entitlements' datatype='boolean' name='[Calculation_672795622914408453]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]=USERNAME()' />
      </column>
      <column caption='Issuer.troubleshoot' datatype='string' name='[Calculation_672795622916517894]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([operation_status]=&apos;SUCCESS&apos;,&apos;&apos;,[issuer])' />
      </column>
      <column caption='Time Detail.Size' datatype='real' name='[Calculation_672795622923485191]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// 1/[Time detail]&#10;1/[Parameters].[Parameter 2] * 0.8' />
      </column>
      <column caption='dummy' datatype='string' name='[Calculation_672795622934507530]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;&quot;' />
      </column>
      <column caption='Trx.Total.LOD' datatype='integer' default-format='N' name='[Trx.Total (copy)_672795622931546121]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED &#10;    [Calculation_672795622903668740]&#10;    , [global_entity_id]&#10;    , [issuer]&#10;    , [operation_status]&#10;    , [payment_method]&#10;    , [provider]&#10;: [Calculation_672795622903095298] }' />
      </column>
