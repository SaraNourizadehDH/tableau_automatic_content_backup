              <calculation class='tableau' formula='IF [is_mixed_payment] = TRUE THEN &quot;Mixed Payment&quot;&#13;&#10;ELSEIF [is_mixed_payment] = FALSE THEN &quot;Non Mixed Payment&quot;&#13;&#10;ELSE &quot;Unknown&quot;&#13;&#10;END' />
