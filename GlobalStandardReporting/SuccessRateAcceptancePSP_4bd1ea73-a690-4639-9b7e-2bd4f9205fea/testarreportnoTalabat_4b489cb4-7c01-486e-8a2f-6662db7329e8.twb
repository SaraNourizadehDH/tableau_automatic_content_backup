            <column caption='Timeframe_overview' datatype='string' name='[Calculation_1443755529957752832]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Timeframe (copy)_4814066545021415430]&#10;    WHEN 1 then DATENAME(&apos;day&apos;,[order_date]) + &quot; &quot; + LEFT(DATENAME(&apos;month&apos;,[order_date]),3) + &quot; &quot; + RIGHT(DATENAME(&apos;year&apos;,[order_date]),2)&#10;    WHEN 2 then &quot;W&quot; + DATENAME(&apos;week&apos;,[order_date]) + &quot; &quot; + DATENAME(&apos;year&apos;,[order_date])&#10;    WHEN 3 then LEFT(DATENAME(&apos;month&apos;,[order_date]),3) + &quot; &quot; + DATENAME(&apos;year&apos;,[order_date])&#10;    WHEN 6 then &quot;Q&quot; + DATENAME(&apos;quarter&apos;,[order_date]) + &quot; &quot; + DATENAME(&apos;year&apos;,[order_date])        &#10;    WHEN 5 then DATENAME(&apos;year&apos;,[order_date])&#10;    WHEN 4 then LEFT(DATENAME(&apos;weekday&apos;, [order_date]),3)&#10;END' />
            </column>
            <column caption='% Success with single attempt' datatype='real' name='[Calculation_1443755529983361025]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([success_single_order_count]) / sum([Calculation_4049369388694994945])' />
            </column>
            <column caption='Display sheet' datatype='integer' name='[Calculation_1443755529984954374]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 2]' />
            </column>
            <column caption='Order Count (excl. others)' datatype='integer' name='[Calculation_4049369388694994945]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[order_count]' />
            </column>
            <column caption='CC VS APM' datatype='string' name='[Calculation_707346634586460160]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [first_payment_method] IN (&#10;    &quot;credit_card&quot;,&#10;    &quot;adyen&quot;,&#10;    &quot;generic_creditcard&quot;,&#10;    &quot;cybersource_creditcard&quot;,&#10;    &quot;credit card&quot;,&#10;    &quot;yemekpay_creditcard&quot;,&#10;    &quot;CARD&quot;,&#10;    &quot;card&quot;,&#10;    &quot;apple pay&quot;,&#10;    &quot;applepay&quot;,&#10;    &quot;cybersource_applepay&quot;,&#10;    &quot;generic_applepay&quot;,&#10;    &quot;generic_googlepay&quot;,&#10;    &quot;googlepay&quot;,&#10;    &quot;card_chin_chin&quot;,&#10;    &quot;card_dlocal_wallet&quot;,&#10;    &quot;card_edenred&quot;,&#10;    &quot;card_mach_pay&quot;,&#10;    &quot;card_oca&quot;,&#10;    &quot;card_plexo&quot;,&#10;    &quot;card_spreedly&quot;,&#10;    &quot;card_tigo_money&quot;,&#10;    &quot;card_visanet&quot;,&#10;    &quot;card_webpay&quot;,&#10;) THEN &quot;Credit Card&quot;&#13;&#10;ELSE &quot;Alternative Payment Method&quot;&#13;&#10;END' />
            </column>
            <column caption='Date_sorting' datatype='integer' name='[Calculation_796996406131531776]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN 4 THEN DATEPART(&apos;weekday&apos;, [order_date])&#10;//WHEN 4 THEN INT(MIN(ISOWEEKDAY([order_date])))&#10;ELSE datediff(&apos;day&apos;,[Parameters].[order_date Parameter],[order_date])&#10;END' />
            </column>
            <column caption='Max Date - 30' datatype='datetime' hidden='true' name='[Max Date (copy)_4814066546419576839]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{DATEADD(&apos;day&apos;,-30,Max([order_date]))}' />
            </column>
            <column caption='Timeframe_deep_dive' datatype='string' name='[Timeframe_overview (copy)_740771790869983246]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN 1 then DATENAME(&apos;day&apos;,[order_date]) + &quot; &quot; + LEFT(DATENAME(&apos;month&apos;,[order_date]),3) + &quot; &quot; + RIGHT(DATENAME(&apos;year&apos;,[order_date]),2)&#10;    WHEN 2 then &quot;W&quot; + DATENAME(&apos;week&apos;,[order_date]) + &quot; &quot; + DATENAME(&apos;year&apos;,[order_date])&#10;    WHEN 3 then LEFT(DATENAME(&apos;month&apos;,[order_date]),3) + &quot; &quot; + DATENAME(&apos;year&apos;,[order_date])&#10;    WHEN 5 then DATENAME(&apos;year&apos;,[order_date])&#10;    WHEN 4 then LEFT(DATENAME(&apos;weekday&apos;, [order_date]),3)&#10;END' />
            </column>
