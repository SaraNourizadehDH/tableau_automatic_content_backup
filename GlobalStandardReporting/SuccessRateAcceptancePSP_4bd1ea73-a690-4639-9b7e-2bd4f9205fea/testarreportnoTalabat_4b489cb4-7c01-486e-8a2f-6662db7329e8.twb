      <table>
        <view>
          <datasources>
            <datasource caption='acceptance_rate (rl_fintech)' name='federated.0ap3g4p0rjqr2r18w7ejp17fnlmd' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Last 7 days' caption='Compare to' datatype='integer' name='[End Date (copy)]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='Last 7 days' />
                <alias key='2' value='Last 30 days' />
                <alias key='3' value='Last Month / previous' />
                <alias key='4' value='Last Month / same on prev. year' />
                <alias key='5' value='Last Quarter / previous' />
                <alias key='6' value='Last Quarter / same on prev. year' />
                <alias key='7' value='YtD' />
              </aliases>
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0ap3g4p0rjqr2r18w7ejp17fnlmd].[Calculation_2246311067492134913]' caption='End Date' datatype='date' name='[Start Date (copy)_2246311067492012032]' param-domain-type='any' role='measure' type='quantitative' value='#2024-08-18#'>
              <calculation class='tableau' formula='#2024-08-18#' />
            </column>
            <column alias='Daily' caption='Timeframe_Overview' datatype='integer' datatype-customized='true' name='[Timeframe (copy)_4814066545021415430]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='Daily' />
                <alias key='2' value='Weekly' />
                <alias key='3' value='Monthly' />
                <alias key='4' value='Weekday' />
                <alias key='6' value='Quarterly' />
              </aliases>
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0ap3g4p0rjqr2r18w7ejp17fnlmd].[Max Date (copy)_4814066546419576839]' caption='Start Date' datatype='date' default-format='*' name='[order_date Parameter]' param-domain-type='any' role='measure' type='quantitative' value='#2022-09-03#'>
              <calculation class='tableau' formula='#2022-09-03#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ap3g4p0rjqr2r18w7ejp17fnlmd'>
            <column caption='% Acceptance' datatype='real' name='[% Success (copy)_1443755530655637512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([success_order_count]) + SUM([recovery_order_count])) / SUM([Calculation_4049369388694994945])' />
            </column>
            <column caption='Mixed Payment Filter' datatype='string' name='[Calculation_1019220903817031680]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_mixed_payment] = TRUE THEN &quot;Mixed Payment&quot;&#13;&#10;ELSEIF [is_mixed_payment] = FALSE THEN &quot;Non Mixed Payment&quot;&#13;&#10;ELSE &quot;Unknown&quot;&#13;&#10;END' />
            </column>
            <column caption='Is Tokenised?' datatype='string' name='[Calculation_1039276010793304064]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE LOWER([payment_instrument_status])&#10;WHEN &apos;new&apos; THEN &apos;No&apos;&#10;WHEN &apos;existing&apos; THEN &apos;Yes&apos;&#10;WHEN &apos;null&apos; THEN &apos;Unknown&apos;&#10;WHEN Null THEN &apos;Unknown&apos;&#10;END' />
            </column>
            <column caption='Timeframe_overview' datatype='string' name='[Calculation_1443755529957752832]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Timeframe (copy)_4814066545021415430]&#10;    WHEN 1 then DATENAME(&apos;day&apos;,[order_date]) + &quot; &quot; + LEFT(DATENAME(&apos;month&apos;,[order_date]),3) + &quot; &quot; + RIGHT(DATENAME(&apos;year&apos;,[order_date]),2)&#10;    WHEN 2 then &quot;W&quot; + DATENAME(&apos;week&apos;,[order_date]) + &quot; &quot; + DATENAME(&apos;year&apos;,[order_date])&#10;    WHEN 3 then LEFT(DATENAME(&apos;month&apos;,[order_date]),3) + &quot; &quot; + DATENAME(&apos;year&apos;,[order_date])&#10;    WHEN 6 then &quot;Q&quot; + DATENAME(&apos;quarter&apos;,[order_date]) + &quot; &quot; + DATENAME(&apos;year&apos;,[order_date])        &#10;    WHEN 5 then DATENAME(&apos;year&apos;,[order_date])&#10;    WHEN 4 then LEFT(DATENAME(&apos;weekday&apos;, [order_date]),3)&#10;END' />
            </column>
            <column caption='Max Date' datatype='date' name='[Calculation_2246311067492134913]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{Max([order_date])}' />
            </column>
            <column caption='Order Count (excl. others)' datatype='integer' name='[Calculation_4049369388694994945]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[order_count]' />
            </column>
            <column caption='CC VS APM' datatype='string' name='[Calculation_707346634586460160]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [first_payment_method] IN (&#10;    &quot;credit_card&quot;,&#10;    &quot;adyen&quot;,&#10;    &quot;generic_creditcard&quot;,&#10;    &quot;cybersource_creditcard&quot;,&#10;    &quot;credit card&quot;,&#10;    &quot;yemekpay_creditcard&quot;,&#10;    &quot;CARD&quot;,&#10;    &quot;card&quot;,&#10;    &quot;apple pay&quot;,&#10;    &quot;applepay&quot;,&#10;    &quot;cybersource_applepay&quot;,&#10;    &quot;generic_applepay&quot;,&#10;    &quot;generic_googlepay&quot;,&#10;    &quot;googlepay&quot;,&#10;    &quot;card_chin_chin&quot;,&#10;    &quot;card_dlocal_wallet&quot;,&#10;    &quot;card_edenred&quot;,&#10;    &quot;card_mach_pay&quot;,&#10;    &quot;card_oca&quot;,&#10;    &quot;card_plexo&quot;,&#10;    &quot;card_spreedly&quot;,&#10;    &quot;card_tigo_money&quot;,&#10;    &quot;card_visanet&quot;,&#10;    &quot;card_webpay&quot;,&#10;) THEN &quot;Credit Card&quot;&#13;&#10;ELSE &quot;Alternative Payment Method&quot;&#13;&#10;END' />
            </column>
            <column caption='Date_sorting_overview' datatype='integer' name='[Date_sorting (copy)_740771790474399744]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Timeframe (copy)_4814066545021415430]&#10;WHEN 4 THEN DATEPART(&apos;weekday&apos;, [order_date])&#10;//WHEN 4 THEN INT(MIN(ISOWEEKDAY([order_date])))&#10;ELSE datediff(&apos;day&apos;,[Parameters].[order_date Parameter],[order_date])&#10;END' />
            </column>
            <column caption='Max Date - 30' datatype='datetime' hidden='true' name='[Max Date (copy)_4814066546419576839]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{DATEADD(&apos;day&apos;,-30,Max([order_date]))}' />
            </column>
            <column caption='New Order Date (copy)' datatype='string' name='[New Order Date (copy)_2246311067499266054]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[End Date (copy)]&#10;WHEN 1 THEN&#10;IF&#10;[order_date]&gt;=DATEADD(&apos;year&apos;,-1,[Parameters].[order_date Parameter])&#10;AND&#10;[order_date]&lt;=DATEADD(&apos;year&apos;,-1,[Parameters].[Start Date (copy)_2246311067492012032])&#10;THEN&#10;CASE [Parameters].[Timeframe (copy)_4814066545021415430]&#10;    WHEN 1 THEN DATENAME(&apos;day&apos;,DATEADD(&apos;year&apos;,1,[order_date])) + &quot; &quot; + LEFT(DATENAME(&apos;month&apos;,DATEADD(&apos;year&apos;,1,[order_date])),3)&#10;    WHEN 2 THEN &quot;W &quot; + DATENAME(&apos;week&apos;,DATEADD(&apos;year&apos;,1,[order_date])) &#10;    //WHEN &apos;Quarter&apos; THEN &quot;Q&quot; + DATENAME(&apos;quarter&apos;,[order_date]) &#10;    WHEN 4 THEN DATENAME(&apos;weekday&apos;, DATEADD(&apos;year&apos;,1,[order_date]))&#10;    ELSE DATENAME(&apos;month&apos;,DATEADD(&apos;year&apos;,1,[order_date]))&#10;    END&#10;&#10;ELSE&#10;CASE [Parameters].[Timeframe (copy)_4814066545021415430]&#10;    WHEN 1 THEN DATENAME(&apos;day&apos;,[order_date]) + &quot; &quot; + LEFT(DATENAME(&apos;month&apos;,[order_date]),3)&#10;    WHEN 2 THEN &quot;W &quot; + DATENAME(&apos;week&apos;,[order_date]) &#10;    //WHEN &apos;Quarter&apos; THEN &quot;Q&quot; + DATENAME(&apos;quarter&apos;,[order_date]) &#10;    WHEN 4 THEN DATENAME(&apos;weekday&apos;, [order_date])&#10;    ELSE DATENAME(&apos;month&apos;,[order_date])&#10;    END&#10;END&#10;WHEN 2 THEN&#10;IF&#10;[order_date]&gt;=DATEADD(&apos;day&apos;,DATEDIFF(&apos;day&apos;,[Parameters].[Start Date (copy)_2246311067492012032],[Parameters].[order_date Parameter])-1,[Parameters].[order_date Parameter])&#10;AND&#10;[order_date]&lt;=DATEADD(&apos;day&apos;,-1,[Parameters].[order_date Parameter])&#10;THEN&#10;CASE [Parameters].[Timeframe (copy)_4814066545021415430]&#10;    WHEN 1 THEN DATENAME(&apos;day&apos;,DATEADD(&apos;day&apos;,DATEDIFF(&apos;day&apos;,[Parameters].[order_date Parameter],[Parameters].[Start Date (copy)_2246311067492012032])+1,[order_date])) + &quot; &quot; + LEFT(DATENAME(&apos;month&apos;,DATEADD(&apos;day&apos;,DATEDIFF(&apos;day&apos;,[Parameters].[order_date Parameter],[Parameters].[Start Date (copy)_2246311067492012032])+1,[order_date])),3)&#10;    WHEN 2 THEN &quot;W &quot; + DATENAME(&apos;week&apos;,DATEADD(&apos;day&apos;,DATEDIFF(&apos;day&apos;,[Parameters].[order_date Parameter],[Parameters].[Start Date (copy)_2246311067492012032])+1,[order_date])) &#10;    //WHEN &apos;Quarter&apos; THEN &quot;Q&quot; + DATENAME(&apos;quarter&apos;,[order_date]) &#10;    WHEN 4 THEN DATENAME(&apos;weekday&apos;, DATEADD(&apos;day&apos;,DATEDIFF(&apos;day&apos;,[Parameters].[order_date Parameter],[Parameters].[Start Date (copy)_2246311067492012032])+1,[order_date]))&#10;    ELSE DATENAME(&apos;month&apos;,DATEADD(&apos;day&apos;,DATEDIFF(&apos;day&apos;,[Parameters].[order_date Parameter],[Parameters].[Start Date (copy)_2246311067492012032])+1,[order_date]))&#10;    END&#10;&#10;ELSE &#10;CASE [Parameters].[Timeframe (copy)_4814066545021415430]&#10;    WHEN 1 THEN DATENAME(&apos;day&apos;,[order_date]) + &quot; &quot; + LEFT(DATENAME(&apos;month&apos;,[order_date]),3)&#10;    WHEN 2 THEN &quot;W &quot; + DATENAME(&apos;week&apos;,[order_date]) &#10;    //WHEN &apos;Quarter&apos; THEN &quot;Q&quot; + DATENAME(&apos;quarter&apos;,[order_date]) &#10;    WHEN 4 THEN DATENAME(&apos;weekday&apos;, [order_date])&#10;    ELSE DATENAME(&apos;month&apos;,[order_date])&#10;    END&#10;END&#10;END' />
            </column>
