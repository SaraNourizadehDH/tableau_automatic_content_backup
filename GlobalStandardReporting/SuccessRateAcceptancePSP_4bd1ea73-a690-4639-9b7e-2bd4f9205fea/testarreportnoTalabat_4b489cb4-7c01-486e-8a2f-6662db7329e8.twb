  <worksheets>
    <worksheet name='AR Indicator_v3'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Bold' fontsize='12'>What is the Acceptance Rate in this period?</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='acceptance_rate (rl_fintech)' name='federated.0ap3g4p0rjqr2r18w7ejp17fnlmd' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Last 7 days' caption='Compare to' datatype='integer' name='[End Date (copy)]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='Last 7 days' />
                <alias key='2' value='Last 30 days' />
                <alias key='3' value='Last Month / previous' />
                <alias key='4' value='Last Month / same on prev. year' />
                <alias key='5' value='Last Quarter / previous' />
                <alias key='6' value='Last Quarter / same on prev. year' />
                <alias key='7' value='YtD' />
              </aliases>
            </column>
            <column alias='Daily' caption='Timeframe' datatype='integer' datatype-customized='true' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='Daily' />
                <alias key='2' value='Weekly' />
                <alias key='3' value='Monthly' />
                <alias key='4' value='Weekday' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ap3g4p0rjqr2r18w7ejp17fnlmd'>
            <column caption='% Acceptance' datatype='real' name='[% Success (copy)_1443755530655637512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([success_order_count]) + SUM([recovery_order_count])) / SUM([Calculation_4049369388694994945])' />
            </column>
            <column caption='Mixed Payment Filter' datatype='string' name='[Calculation_1019220903817031680]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_mixed_payment] = TRUE THEN &quot;Mixed Payment&quot;&#13;&#10;ELSEIF [is_mixed_payment] = FALSE THEN &quot;Non Mixed Payment&quot;&#13;&#10;ELSE &quot;Unknown&quot;&#13;&#10;END' />
            </column>
            <column caption='Is Tokenised?' datatype='string' name='[Calculation_1039276010793304064]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE LOWER([payment_instrument_status])&#10;WHEN &apos;new&apos; THEN &apos;No&apos;&#10;WHEN &apos;existing&apos; THEN &apos;Yes&apos;&#10;WHEN &apos;null&apos; THEN &apos;Unknown&apos;&#10;WHEN Null THEN &apos;Unknown&apos;&#10;END' />
            </column>
            <column caption='Max Date' datatype='date' name='[Calculation_2246311067492134913]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{Max([order_date])}' />
            </column>
            <column caption='Order Count (excl. others)' datatype='integer' name='[Calculation_4049369388694994945]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[order_count]' />
            </column>
            <column caption='CC VS APM' datatype='string' name='[Calculation_707346634586460160]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [first_payment_method] IN (&#10;    &quot;credit_card&quot;,&#10;    &quot;adyen&quot;,&#10;    &quot;generic_creditcard&quot;,&#10;    &quot;cybersource_creditcard&quot;,&#10;    &quot;credit card&quot;,&#10;    &quot;yemekpay_creditcard&quot;,&#10;    &quot;CARD&quot;,&#10;    &quot;card&quot;,&#10;    &quot;apple pay&quot;,&#10;    &quot;applepay&quot;,&#10;    &quot;cybersource_applepay&quot;,&#10;    &quot;generic_applepay&quot;,&#10;    &quot;generic_googlepay&quot;,&#10;    &quot;googlepay&quot;,&#10;    &quot;card_chin_chin&quot;,&#10;    &quot;card_dlocal_wallet&quot;,&#10;    &quot;card_edenred&quot;,&#10;    &quot;card_mach_pay&quot;,&#10;    &quot;card_oca&quot;,&#10;    &quot;card_plexo&quot;,&#10;    &quot;card_spreedly&quot;,&#10;    &quot;card_tigo_money&quot;,&#10;    &quot;card_visanet&quot;,&#10;    &quot;card_webpay&quot;,&#10;) THEN &quot;Credit Card&quot;&#13;&#10;ELSE &quot;Alternative Payment Method&quot;&#13;&#10;END' />
            </column>
            <column caption='Last full month' datatype='boolean' name='[Calculation_740771790483537922]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT(DATETRUNC(&apos;month&apos;,[order_date]) &lt;&gt; DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,{FIXED: MAX([order_date])})))' />
            </column>
            <column caption='Date range string' datatype='string' name='[Calculation_894949694139518997]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN 1 THEN //DAY&#10;(str(day(min([order_date])))+&quot;/&quot;+&#10;str(month(min([order_date])))+&quot;/&quot;+&#10;str(year(min([order_date])))+&quot; to &quot;+&#10;str(day(max([order_date])))+&quot;/&quot;+&#10;str(month(max([order_date])))+&quot;/&quot;+&#10;str(year(max([order_date]))) &#10;)&#10;WHEN 2 THEN //WEEK&#10;&apos;W&apos;+(STR(LEFT(DATENAME(&quot;week&quot;,min([order_date])),3))+&quot; &quot;+&#10;str(year(min([order_date])))+&quot; to &quot;+&#10;&apos;W&apos;+STR(LEFT(DATENAME(&quot;week&quot;,max([order_date])),3))+&quot; &quot;+&#10;str(year(max([order_date])))&#10;)&#10;WHEN 3 THEN //MONTH&#10;(STR(LEFT(DATENAME(&quot;month&quot;,min([order_date])),3))+&quot; &quot;+&#10;str(year(min([order_date])))+&quot; to &quot;+&#10;STR(LEFT(DATENAME(&quot;month&quot;,max([order_date])),3))+&quot; &quot;+&#10;str(year(max([order_date])))&#10;)&#10;WHEN 6 THEN //QUARTER&#10;&quot;Q&quot;+(STR(DATEPART(&quot;quarter&quot;,min([order_date])))+&quot; &quot;+&#10;str(year(min([order_date])))+&quot; to &quot;+&#10;&quot;Q&quot;+STR(DATEPART(&quot;quarter&quot;,max([order_date])))+&quot; &quot;+&#10;str(year(max([order_date])))&#10;)&#10;WHEN 5 THEN //YEAR&#10;str(year(min([order_date])))+&quot; to &quot;+str(year(max([order_date])))&#10;END' />
            </column>
            <column caption='Last full month_previous' datatype='boolean' name='[Last full month (copy)_740771790485823491]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT(DATETRUNC(&apos;month&apos;,[order_date]) &lt;&gt; DATEADD(&apos;month&apos;,-2,DATETRUNC(&apos;month&apos;,{FIXED: MAX([order_date])})))' />
            </column>
            <column caption='Last full quarter' datatype='boolean' name='[Last full month (copy)_740771790510256134]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT(DATETRUNC(&apos;quarter&apos;,[order_date]) &lt;&gt; DATEADD(&apos;quarter&apos;,-1,DATETRUNC(&apos;quarter&apos;,{FIXED: MAX([order_date])})))' />
            </column>
            <column caption='Year to date' datatype='boolean' name='[Last full month (copy)_740771790529298439]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT(DATETRUNC(&apos;year&apos;,[order_date]) &lt;&gt; {FIXED: DATETRUNC(&apos;year&apos;,(MAX([order_date])))})' />
            </column>
            <column caption='Last full quarter_prevYear' datatype='boolean' name='[Last full month_prevYear (copy)_740771790844641292]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT(DATETRUNC(&apos;quarter&apos;,[order_date]) &lt;&gt; DATEADD(&apos;quarter&apos;,-5,DATETRUNC(&apos;quarter&apos;,{FIXED: MAX([order_date])})))' />
            </column>
            <column caption='Last full month_prevYear' datatype='boolean' name='[Last full month_previous (copy)_740771790486106116]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT(DATETRUNC(&apos;month&apos;,[order_date]) &lt;&gt; DATEADD(&apos;month&apos;,-13,DATETRUNC(&apos;month&apos;,{FIXED: MAX([order_date])})))' />
            </column>
            <column caption='Last full quarter_previous' datatype='boolean' name='[Last full month_previous (copy)_740771790797627403]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT(DATETRUNC(&apos;quarter&apos;,[order_date]) &lt;&gt; DATEADD(&apos;quarter&apos;,-2,DATETRUNC(&apos;quarter&apos;,{FIXED: MAX([order_date])})))' />
            </column>
            <column caption='Max Date - 365' datatype='datetime' name='[Max Date - 30 (copy)_740771790533046281]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{DATEADD(&apos;year&apos;,-1,Max([order_date]))}' />
            </column>
            <column caption='Period_KPI' datatype='string' name='[Period (copy)_740771790478880769]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[End Date (copy)]&#10;WHEN 1 THEN // LAST 7 DAYS x PREV 7 DAYS&#10;    IF&#10;    [order_date] &gt;= DATEADD(&apos;day&apos;, -6, [Calculation_2246311067492134913])&#10;    THEN &quot;Reporting period&quot;&#10;    ELSEIF&#10;    [order_date] &lt; DATEADD(&apos;day&apos;, -6, [Calculation_2246311067492134913]) AND&#10;    [order_date] &gt;= DATEADD(&apos;day&apos;, -13, [Calculation_2246311067492134913])&#10;    THEN &quot;Reference period&quot;&#10;    ELSE &quot;Other&quot;&#10;    END&#10;WHEN 2 THEN // LAST 30 DAYS x PREV 30 DAYS&#10;    IF&#10;    [order_date] &gt;= DATEADD(&apos;day&apos;, -29, [Calculation_2246311067492134913])&#10;    THEN &quot;Reporting period&quot;&#10;    ELSEIF&#10;    [order_date] &lt; DATEADD(&apos;day&apos;, -29, [Calculation_2246311067492134913]) AND&#10;    [order_date] &gt;= DATEADD(&apos;day&apos;, -59, [Calculation_2246311067492134913])&#10;    THEN &quot;Reference period&quot;&#10;    ELSE &quot;Other&quot;&#10;    END&#10;WHEN 3 THEN // LAST FULL MONTH x PREVIOUS MONTH&#10;    IF &#10;    [Calculation_740771790483537922]&#10;    THEN &quot;Reporting period&quot;&#10;    ELSEIF&#10;    [Last full month (copy)_740771790485823491]&#10;    THEN &quot;Reference period&quot;&#10;    ELSE &quot;Other&quot;&#10;    END&#10;WHEN 4 THEN // LAST FULL MONTH x SAME MONTH PREV YEAR&#10;    IF&#10;    [Calculation_740771790483537922]&#10;    THEN &quot;Reporting period&quot;&#10;    ELSEIF&#10;    [Last full month_previous (copy)_740771790486106116]&#10;    THEN &quot;Reference period&quot;&#10;    ELSE &quot;Other&quot;&#10;    END&#10;WHEN 5 THEN // LAST FULL QUARTER x PREVIOUS QUARTER&#10;    IF &#10;    [Last full month (copy)_740771790510256134]&#10;    THEN &quot;Reporting period&quot;&#10;    ELSEIF&#10;    [Last full month_previous (copy)_740771790797627403]&#10;    THEN &quot;Reference period&quot;&#10;    ELSE &quot;Other&quot;&#10;    END&#10;WHEN 6 THEN // LAST FULL QUARTER x SAME QUARTER PREV. YEAR&#10;    IF &#10;    [Last full month (copy)_740771790510256134]&#10;    THEN &quot;Reporting period&quot;&#10;    ELSEIF&#10;    [Last full month_prevYear (copy)_740771790844641292]&#10;    THEN &quot;Reference period&quot;&#10;    ELSE &quot;Other&quot;&#10;    END&#10;WHEN 7 THEN // Year to Date x Same period last year&#10;    IF&#10;    [Last full month (copy)_740771790529298439]&#10;    THEN &quot;Reporting period&quot;&#10;    ELSEIF&#10;    [Year to date (copy)_740771790530080776] AND&#10;    [order_date] &lt;= [Max Date - 30 (copy)_740771790533046281]&#10;    THEN &quot;Reference period&quot;&#10;    ELSE &quot;Other&quot;&#10;    END&#10;END' />
            </column>
            <column caption='Year to date_prev' datatype='boolean' name='[Year to date (copy)_740771790530080776]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT(DATETRUNC(&apos;year&apos;,[order_date]) &lt;&gt; (DATEADD(&apos;year&apos;,-1,{FIXED: DATETRUNC(&apos;year&apos;,(MAX([order_date])))})))' />
            </column>
