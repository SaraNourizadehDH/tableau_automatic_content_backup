            </column>
            <column caption='Measurement - rates' datatype='real' name='[Calculation_1081356510682882059]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN 1 THEN [% Success (copy)_1443755530655637512]&#10;WHEN 2 THEN [Calculation_1066367951845789696]&#10;WHEN 3 THEN [Calculation_1066367951845867521]&#10;ELSE [Calculation_1066367951846010882]&#10;END' />
            </column>
            <column caption='Max Date' datatype='date' name='[Calculation_2246311067492134913]' role='dimension' type='ordinal'>
