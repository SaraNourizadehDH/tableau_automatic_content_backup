          <formatted-text>
            <run bold='true' fontsize='12'><![CDATA[<[federated.0ap3g4p0rjqr2r18w7ejp17fnlmd].[none:country:nk]>]]></run>
            <run fontsize='12'><![CDATA[ - Acceptance Rate for customers prefering online payment (<[federated.0ap3g4p0rjqr2r18w7ejp17fnlmd].[none:first_payment_method:nk]>) - ]]></run>
            <run bold='true' fontcolor='#050038' fontsize='12'><![CDATA[<[federated.0ap3g4p0rjqr2r18w7ejp17fnlmd].[tmn:order_date:ok]>]]></run>
          </formatted-text>
        </title>
