      <column caption='Date range string' datatype='string' name='[Calculation_894949694139518997]' role='measure' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN 1 THEN //DAY&#10;(str(day(min([order_date])))+&quot;/&quot;+&#10;str(month(min([order_date])))+&quot;/&quot;+&#10;str(year(min([order_date])))+&quot; to &quot;+&#10;str(day(max([order_date])))+&quot;/&quot;+&#10;str(month(max([order_date])))+&quot;/&quot;+&#10;str(year(max([order_date]))) &#10;)&#10;WHEN 2 THEN //WEEK&#10;&apos;W&apos;+(STR(LEFT(DATENAME(&quot;week&quot;,min([order_date])),3))+&quot; &quot;+&#10;str(year(min([order_date])))+&quot; to &quot;+&#10;&apos;W&apos;+STR(LEFT(DATENAME(&quot;week&quot;,max([order_date])),3))+&quot; &quot;+&#10;str(year(max([order_date])))&#10;)&#10;WHEN 3 THEN //MONTH&#10;(STR(LEFT(DATENAME(&quot;month&quot;,min([order_date])),3))+&quot; &quot;+&#10;str(year(min([order_date])))+&quot; to &quot;+&#10;STR(LEFT(DATENAME(&quot;month&quot;,max([order_date])),3))+&quot; &quot;+&#10;str(year(max([order_date])))&#10;)&#10;WHEN 6 THEN //QUARTER&#10;&quot;Q&quot;+(STR(DATEPART(&quot;quarter&quot;,min([order_date])))+&quot; &quot;+&#10;str(year(min([order_date])))+&quot; to &quot;+&#10;&quot;Q&quot;+STR(DATEPART(&quot;quarter&quot;,max([order_date])))+&quot; &quot;+&#10;str(year(max([order_date])))&#10;)&#10;WHEN 5 THEN //YEAR&#10;str(year(min([order_date])))+&quot; to &quot;+str(year(max([order_date])))&#10;END' />
      </column>
