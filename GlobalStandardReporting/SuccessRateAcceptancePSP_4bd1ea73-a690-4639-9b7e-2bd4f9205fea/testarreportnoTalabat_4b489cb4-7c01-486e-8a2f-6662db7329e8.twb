      <aliases enabled='yes' />
      <column caption='% Acceptance - Reference period' datatype='real' name='[% Acceptance - Current Year (copy) (copy)_4814066545018171394]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;(SUM(IF &#10;[Period (copy)_740771790478880769] = &apos;Reference period&apos; &#10;THEN [success_order_count] &#10;ELSE 0 END) &#10;+ &#10;SUM(IF &#10;[Period (copy)_740771790478880769] = &apos;Reference period&apos; &#10;THEN [recovery_order_count] &#10;ELSE 0 END)) &#10;/ &#10;(SUM(IF &#10;[Period (copy)_740771790478880769] = &apos;Reference period&apos; &#10;THEN [Calculation_4049369388694994945] &#10;ELSE 0 END))&#10;)' />
      </column>
      <column caption='% Acceptance - Reporting period' datatype='real' name='[% Acceptance - Current Year (copy)_4814066545017982977]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;(SUM(IF &#10;[Period (copy)_740771790478880769] = &apos;Reporting period&apos; &#10;THEN [success_order_count] &#10;ELSE 0 END) &#10;+ &#10;SUM(IF &#10;[Period (copy)_740771790478880769] = &apos;Reporting period&apos; &#10;THEN [recovery_order_count] &#10;ELSE 0 END)) &#10;/ &#10;(SUM(IF &#10;[Period (copy)_740771790478880769] = &apos;Reporting period&apos; &#10;THEN [Calculation_4049369388694994945] &#10;ELSE 0 END))&#10;)' />
      </column>
      <column caption='total declines over total' datatype='real' name='[% Decline reason based on failed orders (copy) (copy)_975873777497448454]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_975873777484967937] / &#10;TOTAL( &#10;    &#10;        sum([fail_order_count] + [recovery_order_count] + [success_order_count]) &#10;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% Decline reason based on failed orders (copy)' datatype='real' name='[% Decline reason based on failed orders (copy)_894949693715521542]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fail_order_count]) / &#10;TOTAL( &#10;    &#10;        sum([fail_order_count] + [recovery_order_count] + [success_order_count]) &#10;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% Fail with single attempt' datatype='real' name='[% Fail (copy)_1443755529983602691]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fail_single_order_count])/SUM([Calculation_4049369388694994945])' />
      </column>
      <column caption='% Fail over Total Orders' datatype='real' default-format='p0.00%' name='[% Fail (copy)_894949693703020549]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fail_order_count])/TOTAL(SUM([Calculation_4049369388694994945]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% Fail with multiple attempts' datatype='real' name='[% Fail with single attempt (copy)_1443755529983725572]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([fail_multiple_order_count]) + SUM([fail_different_pm_order_count]))/SUM([Calculation_4049369388694994945])' />
      </column>
      <column caption='% Recovery over Total Orders' datatype='real' default-format='p0.00%' name='[% Recovery  (copy)_894949693690789888]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([recovery_order_count]) / TOTAL(SUM([Calculation_4049369388694994945]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% Acceptance' datatype='real' name='[% Success (copy)_1443755530655637512]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([success_order_count]) + SUM([recovery_order_count])) / SUM([Calculation_4049369388694994945])' />
      </column>
      <column caption='% Success with multiple attempts' datatype='real' name='[% Success with single attempt (copy)_1443755529983516674]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([success_multiple_order_count]) / sum([Calculation_4049369388694994945])' />
      </column>
      <column caption='Mixed Payment Filter' datatype='string' name='[Calculation_1019220903817031680]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_mixed_payment] = TRUE THEN &quot;Mixed Payment&quot;&#13;&#10;ELSEIF [is_mixed_payment] = FALSE THEN &quot;Non Mixed Payment&quot;&#13;&#10;ELSE &quot;Unknown&quot;&#13;&#10;END' />
      </column>
      <column caption='Is Tokenised?' datatype='string' name='[Calculation_1039276010793304064]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE LOWER([payment_instrument_status])&#10;WHEN &apos;new&apos; THEN &apos;No&apos;&#10;WHEN &apos;existing&apos; THEN &apos;Yes&apos;&#10;WHEN &apos;null&apos; THEN &apos;Unknown&apos;&#10;WHEN Null THEN &apos;Unknown&apos;&#10;END' />
      </column>
      <column caption='% Success' datatype='real' name='[Calculation_1066367951845789696]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([success_order_count]) / SUM([Calculation_4049369388694994945])' />
      </column>
      <column caption='% Recovery ' datatype='real' name='[Calculation_1066367951845867521]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([recovery_order_count]) / SUM([Calculation_4049369388694994945])' />
      </column>
      <column caption='% Fail' datatype='real' name='[Calculation_1066367951846010882]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fail_order_count])/SUM([Calculation_4049369388694994945])' />
      </column>
      <column caption='View by' datatype='string' name='[Calculation_1081356510576779272]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4] &#10;    WHEN 3 THEN [first_payment_method]&#10;    //ELSEIF [Parameters].[View by] = &apos;Year&apos; THEN STR(YEAR([order_date]))&#10;    WHEN 1 THEN &apos;Total&apos;&#10;    WHEN 2 THEN [country]&#10;    WHEN 4 THEN [order_device]&#10;    WHEN 5 THEN [is_alfred (copy)_2205919413846179840]&#13;&#10;    WHEN 6 THEN [Calculation_859906103427592192]&#13;&#10;    WHEN 7 THEN [Calculation_912823357508780032]&#10;    WHEN 8 THEN [Calculation_1039276010793304064]&#13;&#10;    WHEN 9 THEN [Calculation_707346634586460160]&#10;    ELSE NULL&#10;END' />
      </column>
      <column caption='Measurement - rates' datatype='real' name='[Calculation_1081356510682882059]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN 1 THEN [% Success (copy)_1443755530655637512]&#10;WHEN 2 THEN [Calculation_1066367951845789696]&#10;WHEN 3 THEN [Calculation_1066367951845867521]&#10;ELSE [Calculation_1066367951846010882]&#10;END' />
      </column>
      <column caption='Timeframe_overview' datatype='string' name='[Calculation_1443755529957752832]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Timeframe (copy)_4814066545021415430]&#10;    WHEN 1 then DATENAME(&apos;day&apos;,[order_date]) + &quot; &quot; + LEFT(DATENAME(&apos;month&apos;,[order_date]),3) + &quot; &quot; + RIGHT(DATENAME(&apos;year&apos;,[order_date]),2)&#10;    WHEN 2 then &quot;W&quot; + DATENAME(&apos;week&apos;,[order_date]) + &quot; &quot; + DATENAME(&apos;year&apos;,[order_date])&#10;    WHEN 3 then LEFT(DATENAME(&apos;month&apos;,[order_date]),3) + &quot; &quot; + DATENAME(&apos;year&apos;,[order_date])&#10;    WHEN 6 then &quot;Q&quot; + DATENAME(&apos;quarter&apos;,[order_date]) + &quot; &quot; + DATENAME(&apos;year&apos;,[order_date])        &#10;    WHEN 5 then DATENAME(&apos;year&apos;,[order_date])&#10;    WHEN 4 then LEFT(DATENAME(&apos;weekday&apos;, [order_date]),3)&#10;END' />
      </column>
      <column caption='% Success with single attempt' datatype='real' name='[Calculation_1443755529983361025]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([success_single_order_count]) / sum([Calculation_4049369388694994945])' />
      </column>
      <column caption='Display sheet' datatype='integer' name='[Calculation_1443755529984954374]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 2]' />
      </column>
      <column caption='Hide' datatype='string' name='[Calculation_1443755530658811918]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;title&apos;' />
      </column>
      <column caption='Max Date' datatype='date' name='[Calculation_2246311067492134913]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{Max([order_date])}' />
      </column>
      <column caption='Period' datatype='string' name='[Calculation_2246311067493167106]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF&#10;    [order_date]&gt;=[Parameters].[order_date Parameter]&#10;    AND&#10;    [order_date]&lt;= [Parameters].[Start Date (copy)_2246311067492012032]&#10;    THEN &quot;Reporting period&quot;&#10;    //ELSEIF&#10;    //order_date]&gt;=DATEADD(&apos;year&apos;,-1,[Start Date])&#10;    //AND&#10;    //[order_date]&lt;=DATEADD(&apos;year&apos;,-1,[End Date])&#10;    //THEN &quot;Previous year&quot;&#10;    ELSE &quot;Other&quot;&#10;END' />
      </column>
      <column caption='attempts/orders' datatype='real' name='[Calculation_4003137182591664128]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([order_attempts])/sum([order_count])' />
      </column>
      <column caption='dimension selection' datatype='string' name='[Calculation_4003137182596845571]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6] &#10;WHEN 2 then [psp_operation_status]&#10;//WHEN &apos;Authotization status&apos; then [psp_authorization_status]&#10;WHEN 3 then [global_entity_id]&#10;WHEN 4 then [psp_payment_method]&#10;WHEN 5 then [psp_acquirer_response]&#10;//WHEN 6 then [psp_threeds_flag]&#10;WHEN 1 then &apos;All&apos;&#10;end' />
      </column>
      <column caption='Order Count (excl. others)' datatype='integer' name='[Calculation_4049369388694994945]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[order_count]' />
      </column>
      <column caption='lower(first_payment_method)' datatype='real' hidden='true' name='[Calculation_4342525586685837313]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='' />
      </column>
      <column caption='% Acceptance - diff' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_4814066545018605571]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([% Acceptance - Current Year (copy)_4814066545017982977] - [% Acceptance - Current Year (copy) (copy)_4814066545018171394]) * 100' />
      </column>
      <column caption='dummy' datatype='string' name='[Calculation_4814066546434699273]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;&apos;' />
      </column>
      <column caption='User Entitlements' datatype='boolean' hidden='true' name='[Calculation_538883856591585280]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='CC VS APM' datatype='string' name='[Calculation_707346634586460160]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [first_payment_method] IN (&#10;    &quot;credit_card&quot;,&#10;    &quot;adyen&quot;,&#10;    &quot;generic_creditcard&quot;,&#10;    &quot;cybersource_creditcard&quot;,&#10;    &quot;credit card&quot;,&#10;    &quot;yemekpay_creditcard&quot;,&#10;    &quot;CARD&quot;,&#10;    &quot;card&quot;,&#10;    &quot;apple pay&quot;,&#10;    &quot;applepay&quot;,&#10;    &quot;cybersource_applepay&quot;,&#10;    &quot;generic_applepay&quot;,&#10;    &quot;generic_googlepay&quot;,&#10;    &quot;googlepay&quot;,&#10;    &quot;card_chin_chin&quot;,&#10;    &quot;card_dlocal_wallet&quot;,&#10;    &quot;card_edenred&quot;,&#10;    &quot;card_mach_pay&quot;,&#10;    &quot;card_oca&quot;,&#10;    &quot;card_plexo&quot;,&#10;    &quot;card_spreedly&quot;,&#10;    &quot;card_tigo_money&quot;,&#10;    &quot;card_visanet&quot;,&#10;    &quot;card_webpay&quot;,&#10;) THEN &quot;Credit Card&quot;&#13;&#10;ELSE &quot;Alternative Payment Method&quot;&#13;&#10;END' />
      </column>
      <column caption='Last full month' datatype='boolean' name='[Calculation_740771790483537922]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='NOT(DATETRUNC(&apos;month&apos;,[order_date]) &lt;&gt; DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,{FIXED: MAX([order_date])})))' />
      </column>
      <column caption='Comparison_string' datatype='string' name='[Calculation_740771790849933325]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[End Date (copy)]&#10;WHEN 1 THEN &quot;in the last 7 days&quot;&#10;WHEN 2 THEN &quot;in the last 30 days&quot;&#10;WHEN 3 THEN &quot;last month&quot;&#10;WHEN 4 THEN &quot;last month&quot;&#10;WHEN 5 THEN &quot;last quarter&quot;&#10;WHEN 6 THEN &quot;last quarter&quot;&#10;WHEN 7 THEN &quot;in the year to date&quot;&#10;END' />
      </column>
