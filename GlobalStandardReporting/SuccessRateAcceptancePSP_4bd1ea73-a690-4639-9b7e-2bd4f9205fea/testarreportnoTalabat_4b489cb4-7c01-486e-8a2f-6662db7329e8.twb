            <column caption='Is Cyprus' datatype='integer' name='[is_cyprus]' role='measure' type='quantitative' />
            <column datatype='boolean' name='[is_mixed_payment]' role='dimension' type='nominal' />
            <column caption='Last Payment Method' datatype='string' name='[last_payment_method]' role='dimension' type='nominal' />
