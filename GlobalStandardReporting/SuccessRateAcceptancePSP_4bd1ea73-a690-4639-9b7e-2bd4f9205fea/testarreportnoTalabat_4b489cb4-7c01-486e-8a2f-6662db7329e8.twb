              <aliases>
                <alias key='1' value='Acceptance Rate' />
                <alias key='2' value='Success Rate' />
                <alias key='3' value='Recovery Rate' />
                <alias key='4' value='Fail Rate' />
              </aliases>
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0ap3g4p0rjqr2r18w7ejp17fnlmd].[Calculation_2246311067492134913]' caption='End Date' datatype='date' name='[Start Date (copy)_2246311067492012032]' param-domain-type='any' role='measure' type='quantitative' value='#2024-08-18#'>
              <calculation class='tableau' formula='#2024-08-18#' />
