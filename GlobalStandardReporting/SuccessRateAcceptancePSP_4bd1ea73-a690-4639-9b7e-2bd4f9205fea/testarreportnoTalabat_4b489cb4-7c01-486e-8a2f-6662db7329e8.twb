            </column>
            <column caption='Period' datatype='string' name='[Calculation_2246311067493167106]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF&#10;    [order_date]&gt;=[Parameters].[order_date Parameter]&#10;    AND&#10;    [order_date]&lt;= [Parameters].[Start Date (copy)_2246311067492012032]&#10;    THEN &quot;Reporting period&quot;&#10;    //ELSEIF&#10;    //order_date]&gt;=DATEADD(&apos;year&apos;,-1,[Start Date])&#10;    //AND&#10;    //[order_date]&lt;=DATEADD(&apos;year&apos;,-1,[End Date])&#10;    //THEN &quot;Previous year&quot;&#10;    ELSE &quot;Other&quot;&#10;END' />
            </column>
