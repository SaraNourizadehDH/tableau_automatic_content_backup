            <run bold='true' fontcolor='#666666' fontsize='11'>Point of contact: </run>
            <run fontcolor='#000000' fontsize='11'>fintech_data_payments@deliveryhero.com</run>
            <run fontcolor='#666666' fontsize='11'>Æ </run>
            <run bold='true' fontcolor='#666666' fontsize='11'>- </run>
            <run fontcolor='#666666' fontsize='11'>Fintech Data Analytics team</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#666666' fontsize='11'>Update schedule: </run>
            <run fontcolor='#666666' fontsize='11'>daily</run>
          </formatted-text>
        </title>
      </layout-options>
