        <column caption='Acquirer Response (Lower Case )' datatype='string' name='[Calculation_1271985451424149504]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='LOWER([acquirer_response])' />
        </column>
        <column caption='3DS Flag' datatype='string' name='[Calculation_1649443410164654086]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [threeds_flag] = 1 THEN &quot;3DS&quot; ELSE &quot;non-3DS&quot; END' />
        </column>
        <column caption='Authorization Type' datatype='string' name='[Calculation_244038841428213760]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [authorization_type] = &apos;Non-recurring&apos; THEN &apos;Non-Recurring&apos; ELSE [authorization_type] END' />
        </column>
        <column caption='Checkout APAC vertical' datatype='string' name='[Calculation_674695548730904576]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='REPLACE(LEFT([processing_channel_name], FIND([processing_channel_name], &quot;:&quot;)),&quot;:&quot;,&quot;&quot;)' />
        </column>
        <column caption='Network Token Used' datatype='boolean' name='[Calculation_705376321443598337]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [network_token_used] = TRUE THEN TRUE ELSE FALSE END' />
