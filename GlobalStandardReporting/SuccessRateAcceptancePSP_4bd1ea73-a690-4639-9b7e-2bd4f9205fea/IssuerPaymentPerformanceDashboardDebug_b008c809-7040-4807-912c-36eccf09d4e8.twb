      </column>
      <column caption='BIN (copy)' datatype='string' hidden='true' name='[BIN (copy)_1649443410173186062]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[card_bin]' />
      </column>
      <column caption='Acquirer Response (Lower Case )' datatype='string' name='[Calculation_1271985451424149504]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LOWER([acquirer_response])' />
      </column>
      <column caption='3DS Flag' datatype='string' name='[Calculation_1649443410164654086]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [threeds_flag] = 1 THEN &quot;3DS&quot; ELSE &quot;non-3DS&quot; END' />
      </column>
      <column caption='Timeframe' datatype='string' name='[Calculation_1649443410166300681]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &apos;day&apos; THEN DATENAME(&apos;day&apos;,[psp_date]) + &quot; &quot; + DATENAME(&apos;month&apos;,[psp_date]) + &quot; &quot; + DATENAME(&apos;year&apos;,[psp_date])&#13;&#10;WHEN &apos;week&apos; THEN &quot;Week &quot; + DATENAME(&apos;week&apos;,[psp_date])&#13;&#10;ELSE DATENAME(&apos;month&apos;,[psp_date]) + &quot; &quot; + DATENAME(&apos;year&apos;,[psp_date])&#13;&#10;END' />
      </column>
      <column caption='Authorization Type' datatype='string' name='[Calculation_244038841428213760]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [authorization_type] = &apos;Non-recurring&apos; THEN &apos;Non-Recurring&apos; ELSE [authorization_type] END' />
      </column>
      <column caption='% Trx Success' datatype='real' name='[Calculation_244038841429467137]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([successful_trx_count]) / SUM([trx_count])' />
      </column>
      <column caption='Max Date' datatype='date' name='[Calculation_317785276477497345]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED : MAX( { MAX( [psp_date] ) } ) }' />
      </column>
      <column caption='Trx Count Max Date' datatype='integer' name='[Calculation_317785276480950275]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [psp_date] = [Calculation_317785276477497345] AND [Parameters].[Parameter 2] = &quot;day&quot; THEN [trx_count] &#13;&#10;ELSEIF &quot;Week &quot; + DATENAME(&apos;week&apos;,[psp_date]) = &quot;Week &quot; + DATENAME(&apos;week&apos;,[Calculation_317785276477497345]) AND [Parameters].[Parameter 2] = &quot;week&quot; THEN [trx_count] &#13;&#10;ELSEIF DATENAME(&apos;month&apos;,[psp_date]) + &quot; &quot; + DATENAME(&apos;year&apos;,[psp_date]) = DATENAME(&apos;month&apos;,[Calculation_317785276477497345]) + &quot; &quot; + DATENAME(&apos;year&apos;,[Calculation_317785276477497345]) AND [Parameters].[Parameter 2] = &quot;month&quot; THEN [trx_count]&#13;&#10;END' />
      </column>
      <column caption='% User Success' datatype='real' name='[Calculation_331366452973727746]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([successful_user_count])/SUM([user_count])' />
      </column>
      <column caption='% Fraud' datatype='real' hidden='true' name='[Calculation_331366452976226307]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fraud_trx_count])/SUM([trx_count])' />
      </column>
      <column caption='Day' datatype='date' datatype-customized='true' hidden='true' name='[Calculation_331366453271031814]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATENAME(&apos;day&apos;,[psp_date]) + &quot; &quot; + DATENAME(&apos;month&apos;,[psp_date]) + &quot; &quot; + DATENAME(&apos;year&apos;,[psp_date]))' />
      </column>
      <column caption='Total' datatype='integer' name='[Calculation_6668775568882061313]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = 1 THEN [trx_count] ELSE [user_count] END' />
      </column>
      <column caption='% SR' datatype='real' name='[Calculation_6668775568882290690]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_244038841429467137]' />
