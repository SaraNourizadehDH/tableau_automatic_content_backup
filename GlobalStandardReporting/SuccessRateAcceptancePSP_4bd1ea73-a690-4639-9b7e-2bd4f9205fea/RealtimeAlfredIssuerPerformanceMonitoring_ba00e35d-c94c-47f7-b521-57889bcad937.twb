              <calculation class='tableau' formula='IF DATEPART(&apos;month&apos;,TODAY() ) &gt;= 4 AND DATEPART(&apos;month&apos;,TODAY() ) &lt;= 10&#10;THEN DATEADD(&apos;hour&apos;,2,[record_datetime])&#10;ELSE DATEADD(&apos;hour&apos;,1,[record_datetime])&#10;END' />
            </column>
            <column caption='Datetime CET.Max.Fixed' datatype='datetime' name='[Calculation_359725080377122817]' role='dimension' type='ordinal'>
