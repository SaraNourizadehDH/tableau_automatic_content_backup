            </column>
            <column caption='Trx.Success' datatype='integer' default-format='N' name='[Calculation_672795622902788097]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;    IIF(UPPER([Status])=&apos;SUCCESS&apos;,[count_of_transactions], 0)&#10;)' />
            </column>
            <column caption='Trx.Total' datatype='integer' default-format='N' name='[Calculation_672795622903095298]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_of_transactions])' />
            </column>
            <column caption='Trx.SuccessRate' datatype='real' default-format='p0.00%' name='[Calculation_672795622903320579]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_672795622902788097]+[Trx.Success (copy)_1390204936148787200])/[Calculation_672795622903095298]' />
            </column>
            <column caption='Datetime CET' datatype='datetime' name='[Calculation_672795622903668740]' role='dimension' type='ordinal'>
