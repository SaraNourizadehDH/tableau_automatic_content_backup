      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1hx6md00ltc1h61er5cy70g9bbyj].[pcto:usr:Calculation_672795622903095298:qk]&quot;' value='% of Total Trx.Total' />
