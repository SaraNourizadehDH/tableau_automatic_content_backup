      <column caption='User Entitlements' datatype='boolean' hidden='true' name='[Calculation_217298697931345920]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]=USERNAME()' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_294915453509705728]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]=USERNAME()' />
      </column>
      <column caption='Record Datetime CET' datatype='datetime' name='[Calculation_359725080374370304]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF DATEPART(&apos;month&apos;,TODAY() ) &gt;= 4 AND DATEPART(&apos;month&apos;,TODAY() ) &lt;= 10&#10;THEN DATEADD(&apos;hour&apos;,2,[record_datetime])&#10;ELSE DATEADD(&apos;hour&apos;,1,[record_datetime])&#10;END' />
      </column>
      <column caption='Datetime CET.Max.Fixed' datatype='datetime' name='[Calculation_359725080377122817]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{MAX([Calculation_359725080374370304])}' />
      </column>
      <column caption='Trx.Total.minusPending' datatype='integer' name='[Calculation_5097019265687085056]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Status]!= &apos;Pending&apos;,[count_of_transactions],0)' />
      </column>
      <column caption='Trx.Success' datatype='integer' default-format='N' name='[Calculation_672795622902788097]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IIF(UPPER([Status])=&apos;SUCCESS&apos;,[count_of_transactions], 0)&#10;)' />
      </column>
      <column caption='Trx.Total' datatype='integer' default-format='N' name='[Calculation_672795622903095298]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_of_transactions])' />
      </column>
      <column caption='Trx.SuccessRate' datatype='real' default-format='p0.00%' name='[Calculation_672795622903320579]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_672795622902788097]+[Trx.Success (copy)_1390204936148787200])/[Calculation_672795622903095298]' />
      </column>
      <column caption='Datetime CET' datatype='datetime' name='[Calculation_672795622903668740]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 2]=288,[Calculation_359725080374370304],&#10;    DATETIME((INT(FLOAT([Calculation_359725080374370304])*[Parameters].[Parameter 2]))/[Parameters].[Parameter 2])&#10;)' />
      </column>
      <column caption='Issuer.troubleshoot' datatype='string' name='[Calculation_672795622916517894]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF(UPPER([Status])=&apos;SUCCESS&apos;,&apos;&apos;,[issuer])' />
      </column>
      <column caption='Time Detail.Size' datatype='real' name='[Calculation_672795622923485191]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// 1/[Time detail]&#10;1/[Parameters].[Parameter 2] * 0.8' />
      </column>
      <column caption='dummy' datatype='string' name='[Calculation_672795622934507530]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;&quot;' />
      </column>
      <column caption='Min.Datetime CET' datatype='datetime' hidden='true' name='[Calculation_865183723479269388]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(MIN([Calculation_672795622903668740]),0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Record Datetime (copy)' datatype='datetime' name='[Record Datetime (copy)_681239850912923648]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[record_datetime]' />
      </column>
      <column datatype='string' name='[Status]' role='dimension' type='nominal' />
      <column caption='Trx.Pending' datatype='integer' default-format='N' name='[Trx.Success (copy)_1390204936148787200]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IIF(UPPER([Status])=&apos;PENDING&apos;,[count_of_transactions], 0)&#10;)' />
      </column>
      <column caption='Trx.Total.LOD' datatype='integer' default-format='N' name='[Trx.Total (copy)_672795622931546121]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED &#10;    [Calculation_672795622903668740]&#10;    , [global_entity_id]&#10;    , [issuer]&#10;    , [Status]&#10;    , [type]&#10;: [Calculation_672795622903095298] }' />
      </column>
