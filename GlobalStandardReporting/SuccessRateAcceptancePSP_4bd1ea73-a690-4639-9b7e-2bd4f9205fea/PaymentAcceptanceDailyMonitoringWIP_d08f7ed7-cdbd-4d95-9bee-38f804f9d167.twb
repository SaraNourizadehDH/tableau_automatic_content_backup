            <column caption='AR - Success Order Count Benchmark' datatype='integer' name='[AR - Success Order Count Reporting (copy)_536209889881264132]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Calculation_536209889880920066] AND [report_name] IN (&apos;acceptance_rate&apos;, &apos;base_data&apos;),[metric1],Null)' />
