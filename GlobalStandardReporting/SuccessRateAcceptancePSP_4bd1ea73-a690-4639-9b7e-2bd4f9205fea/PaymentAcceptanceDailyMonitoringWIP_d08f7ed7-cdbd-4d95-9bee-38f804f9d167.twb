            </column>
            <column caption='SA SR - Single Attempt Manual Threshold (Entity)' datatype='real' name='[Trx - SR Manual Threshold (Entity) (copy)_1366279605361053703]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Parameters].[Parameter 3]/100' />
