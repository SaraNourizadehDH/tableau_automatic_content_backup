            <column caption='AR - % Recovery Reporting' datatype='real' name='[Calculation_1066367951845867521]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1346013391165173767]) / SUM([Calculation_4049369388694994945])' />
