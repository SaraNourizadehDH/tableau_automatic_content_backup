            <column caption='AR - Success Order Count Benchmark' datatype='integer' name='[AR - Success Order Count Reporting (copy)_536209889881264132]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Calculation_536209889880920066] AND [report_name] IN (&apos;acceptance_rate&apos;, &apos;base_data&apos;),[metric1],Null)' />
            </column>
            <column caption='AR - Recovery Threshold  Category' datatype='string' name='[AR - Success Treshold  Category (Entity) (copy)_929711907711881237]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [AR - % Acceptance Diff (copy)_929711907685957651] &lt;= -1*MIN([AR - Success Manual Treshold (Entity) (copy)_929711907686273044]) THEN &quot;Anomly Drop&quot;&#13;&#10;ELSEIF  [AR - % Acceptance Diff (copy)_929711907685957651] &gt; MIN([AR - Success Manual Treshold (Entity) (copy)_929711907686273044]) THEN &quot;Anomaly Improve&quot;&#13;&#10;ELSEIF  [AR - % Acceptance Diff (copy)_929711907685957651] &lt; 0 THEN &quot;Drop&quot;&#13;&#10;ELSE &quot;Improve&quot;&#13;&#10;END' />
