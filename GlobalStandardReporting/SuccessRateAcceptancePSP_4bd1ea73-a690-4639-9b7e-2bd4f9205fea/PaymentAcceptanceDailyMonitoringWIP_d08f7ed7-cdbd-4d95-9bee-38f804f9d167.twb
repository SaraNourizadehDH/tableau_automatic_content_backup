            </column>
            <column caption='AR - Order Count Daily Reporting' datatype='integer' name='[AR - Order Count Reporting (copy)_552535446714175497]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Calculation_536209889870340096] AND [report_name] IN (&apos;acceptance_rate&apos;, &apos;base_data&apos;),&#13;&#10;{ FIXED [report_name], [Calculation_1346013391162667013], [global_entity_id], [Calculation_1346013391160000516] : SUM([metric3]) }&#13;&#10;,Null)' />
            </column>
