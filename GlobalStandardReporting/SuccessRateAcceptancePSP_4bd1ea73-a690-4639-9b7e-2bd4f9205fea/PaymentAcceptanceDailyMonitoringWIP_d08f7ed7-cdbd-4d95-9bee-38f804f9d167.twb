      </column>
      <column caption='is_report_date' datatype='boolean' name='[Calculation_536209889870340096]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//This just checks the basic condition if the date is/not the reporting period&#13;&#10;IF [Parameters].[Parameter 1] = 1 THEN&#13;&#10;    [date] = [Parameters].[Parameter 8]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = 2 THEN&#13;&#10;    DATETRUNC(&apos;week&apos;,[date], &apos;Monday&apos;) = DATETRUNC(&apos;week&apos;,[Parameters].[Parameter 8], &apos;Monday&apos;)&#13;&#10;ELSEIF [Parameters].[Parameter 1] = 3 THEN&#13;&#10;    DATETRUNC(&apos;month&apos;,[date]) = DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 8])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = 4 THEN&#13;&#10;    [date] = [Parameters].[Parameter 8]&#13;&#10;END' />
      </column>
      <column caption='AR - Acceptance Manual Threshold (Entity)' datatype='real' name='[Calculation_536209889871589377]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [global_entity_id] &#13;&#10; WHEN &apos;FP_BD&apos; THEN [Parameters].[Parameter 3]/100&#13;&#10;/* WHEN &apos;FP_HK&apos; THEN 0.01&#13;&#10;WHEN &apos;FP_KH&apos; THEN 0.002&#13;&#10;WHEN &apos;FP_MM&apos; THEN 0.01&#13;&#10;WHEN &apos;FP_LA&apos; THEN 0.06&#13;&#10;WHEN &apos;FP_PH&apos; THEN 0.02&#13;&#10;WHEN &apos;FP_SG&apos; THEN 0.03&#13;&#10;WHEN &apos;DJ_CZ&apos; THEN 0.005&#13;&#10;WHEN &apos;TB_BH&apos; THEN 0.002&#13;&#10;WHEN &apos;TB_JO&apos; THEN 0.001 */&#13;&#10;ELSE [Parameters].[Parameter 3]/100&#13;&#10;END' />
      </column>
      <column caption='is_comparison_period' datatype='boolean' name='[Calculation_536209889880920066]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//this encapsulates the benchmark logic as a Boolean&#13;&#10;IF [Parameters].[Parameter 1] = 1 THEN&#13;&#10;    [Calculation_1346013391162667013] &gt;= DATEADD(&apos;day&apos;,-[Parameters].[Parameter 2],[Parameters].[Parameter 8])&#13;&#10;    AND [Calculation_1346013391162667013] &lt; [Parameters].[Parameter 8]&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 1] = 2 THEN&#13;&#10;    [Calculation_1346013391162667013] &gt;= DATETRUNC(&apos;week&apos;,DATEADD(&apos;week&apos;, ([Parameters].[Parameter 2]*-1), [Parameters].[Parameter 8]),&apos;Monday&apos;) &#13;&#10;    AND [Calculation_1346013391162667013] &lt; DATETRUNC(&apos;week&apos;, DATEADD(&apos;week&apos;, 0, [Parameters].[Parameter 8]), &apos;Monday&apos;)&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 1] = 3 THEN&#13;&#10;    [Calculation_1346013391162667013] &gt;= DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;, ([Parameters].[Parameter 2]*-1)-7, [Parameters].[Parameter 8])) &#13;&#10;    AND [Calculation_1346013391162667013] &lt; DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, 0, [Parameters].[Parameter 8]))&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 1] = 4 THEN&#13;&#10;    [Calculation_1346013391162667013] &gt;= [Parameters].[Parameter 8] - ([Parameters].[Parameter 2] * 7) &#13;&#10;    AND [Calculation_1346013391162667013] &lt; [Parameters].[Parameter 8] &#13;&#10;    AND [Calculation_383650447852658690] = TRUE&#13;&#10;END' />
      </column>
      <column caption='Index &lt;=5' datatype='boolean' name='[Calculation_694539569863299072]' role='measure' type='nominal'>
        <calculation class='tableau' formula='INDEX()&lt;=5'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='AR - % Acceptance' datatype='real' default-format='p0.0%' name='[Calculation_694539569865441285]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='( SUM([AR - Success Order Count Reporting (copy)_694539569865342980])+SUM([AR - Recovery Order Count Reporting (copy)_694539569865216003]) )/SUM([AR - Order Count Reporting (copy)_694539569865121794])' />
      </column>
      <column caption='Last 14 Days Display' datatype='boolean' name='[Calculation_765893476163231749]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1346013391162667013] &gt; [Parameters].[Parameter 8] - 14 and [Calculation_1346013391162667013] &lt;= [Parameters].[Parameter 8] THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='AR - % Acceptance Benchmark' datatype='real' name='[Calculation_966022179612631040]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([AR - Success Order Count Reporting (copy)_536209889881264132]) + SUM([AR - Recovery Order Count Reporting (copy)_536209889881468933])) / SUM([AR - Order Count Reporting (copy)_536209889881104387])' />
      </column>
      <column caption='AR - % Acceptance Diff' datatype='real' name='[Calculation_966022179615682561]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[% Success (copy)_1443755530655637512] - [Calculation_966022179612631040]' />
      </column>
      <column caption='Display Outliers - overall' datatype='boolean' name='[Calculation_978407080024940547]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF &#13;&#10;    [Parameters].[Parameter 7] = FALSE THEN FALSE &#13;&#10;ELSEIF     &#13;&#10;    [Parameters].[Parameter 7] = TRUE &#13;&#10;    AND &#13;&#10;    (&#13;&#10;        IIF([Acceptance Treshold  Category (PM) (copy)_1371627603789869058] = &quot;Anomaly Drop&quot;,1,0)&#13;&#10;        +&#13;&#10;        IIF([AR - Acceptance Treshold  Category (Entity) (copy)_929711907678982152] = &quot;Anomaly Drop&quot;,1,0)&#13;&#10;        +&#13;&#10;        IIF([AR - Success Treshold  Category (Entity) (copy)_929711907711881237] = &quot;Anomaly Improve&quot;,1,0)&#13;&#10;        +&#13;&#10;        IIF([Trx - SR Treshold Category (PM) (copy)_697213571638386690] = &quot;Anomaly Drop&quot;,1,0)&#13;&#10;        +&#13;&#10;        IIF([Trx - SR Threshold Category (Entity) (copy)_1366279605361467401] = &quot;Anomaly Drop&quot;,1,0)&#13;&#10;    )&#13;&#10;    &gt; 0&#13;&#10;    THEN FALSE&#13;&#10;ELSE TRUE&#13;&#10;END' />
      </column>
      <column caption='AR - non nulls' datatype='boolean' name='[Calculation_978407080034037766]' role='measure' type='nominal'>
