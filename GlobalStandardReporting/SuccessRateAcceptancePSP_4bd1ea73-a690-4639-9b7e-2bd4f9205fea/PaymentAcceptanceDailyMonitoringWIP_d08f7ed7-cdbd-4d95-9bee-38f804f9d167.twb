      <column caption='Date Range' datatype='string' name='[Calculation_1346013391157317634]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//based on the Boolean check, we can simplify this Timeframe logic&#13;&#10;IF [Calculation_536209889870340096] THEN&#13;&#10;    IF [Parameters].[Parameter 1] = 1 THEN&#13;&#10;            DATENAME(&apos;day&apos;,[date]) + &quot; &quot; + DATENAME(&apos;month&apos;,[date]) + &quot; &quot; + DATENAME(&apos;year&apos;,[date])&#13;&#10;    ELSEIF [Parameters].[Parameter 1] = 2 THEN&#13;&#10;            &quot;Week &quot; + DATENAME(&apos;week&apos;,[date]) + &quot; &quot; + DATENAME(&apos;year&apos;,[date])&#13;&#10;    ELSEIF [Parameters].[Parameter 1] = 3 THEN&#13;&#10;            DATENAME(&apos;month&apos;,[date]) + &quot; &quot; + DATENAME(&apos;year&apos;,[date])&#13;&#10;    ELSEIF [Parameters].[Parameter 1] = 4 THEN&#13;&#10;            DATENAME(&apos;day&apos;,[date]) + &quot; &quot; + DATENAME(&apos;month&apos;,[date]) + &quot; &quot; + DATENAME(&apos;year&apos;,[date])&#13;&#10;    END&#13;&#10;END' />
      </column>
