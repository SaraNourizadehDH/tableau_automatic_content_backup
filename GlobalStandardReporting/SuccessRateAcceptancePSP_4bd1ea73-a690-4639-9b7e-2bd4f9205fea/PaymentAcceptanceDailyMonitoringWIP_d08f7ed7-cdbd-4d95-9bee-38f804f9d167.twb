            </column>
            <column caption='Weekdays filter' datatype='boolean' name='[Calculation_383650447852658690]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = 4 AND [Calculation_1346013391162667013] &gt;= [Parameters].[Parameter 8] - ([Parameters].[Parameter 2] * 8) AND [Calculation_1346013391162667013] &lt;= [Parameters].[Parameter 8] AND DATENAME(&apos;weekday&apos;, [Parameters].[Parameter 8]) = DATENAME(&apos;weekday&apos;, [Calculation_1346013391162667013]) THEN TRUE&#13;&#10;ELSEIF [Parameters].[Parameter 1] IN (3,2,1) THEN TRUE&#13;&#10;ELSE FALSE&#13;&#10;END' />
            </column>
