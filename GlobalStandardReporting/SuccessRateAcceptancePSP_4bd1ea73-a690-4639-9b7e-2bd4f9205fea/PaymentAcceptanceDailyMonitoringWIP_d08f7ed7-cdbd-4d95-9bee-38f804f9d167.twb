            <column caption='Display Outliers' datatype='boolean' name='[Parameter 7]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.14aznjx13mpxtq12jbz5614pdtq1].[Calculation_1365998103500529665]' caption='Based Date' datatype='date' name='[Parameter 8]' param-domain-type='any' role='measure' type='quantitative' value='#2023-09-10#'>
              <calculation class='tableau' formula='#2023-09-10#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.14aznjx13mpxtq12jbz5614pdtq1'>
            <column caption='AR - % Acceptance Reporting' datatype='real' name='[% Success (copy)_1443755530655637512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_1346013391165304840]) + SUM([Calculation_1346013391165173767])) / SUM([Calculation_4049369388694994945])' />
            </column>
            <column caption='AR - % Success  Benchmark' datatype='real' name='[% Success -  Benchmark (PM) (copy)_728738764396863498]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([AR - Success Order Count Reporting (copy)_536209889881264132]) / SUM([AR - Order Count Reporting (copy)_536209889881104387])' />
            </column>
            <column caption='AR - % Success Diff' datatype='real' name='[AR - % Acceptance Diff (copy)_929711907646169088]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1066367951845789696] - [% Success -  Benchmark (PM) (copy)_728738764396863498]' />
            </column>
            <column caption='AR - % Recovery Diff' datatype='real' name='[AR - % Acceptance Diff (copy)_929711907685957651]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1066367951845867521] - [AR - % Recovery Reporting (copy)_929711907685797906]' />
            </column>
            <column caption='SA SR - % Single Attempt Reporting' datatype='real' name='[AR - % Acceptance Reporting (copy)_1366279605360521221]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([SA SR - Order Count Reporting (copy)_1366279605360123907]) / SUM([AR - Order Count Reporting (copy)_1366279605359673345])' />
            </column>
            <column caption='AR - % Recovery Benchmark' datatype='real' name='[AR - % Recovery Reporting (copy)_929711907685797906]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([AR - Recovery Order Count Reporting (copy)_536209889881468933]) / SUM([AR - Order Count Reporting (copy)_536209889881104387])' />
            </column>
            <column caption='SA SR - % Single Attempt Diff' datatype='real' name='[AR - % Success Diff (copy)_1366279605361283080]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[AR - % Acceptance Reporting (copy)_1366279605360521221] - [SA SR - % Single Attempt Reporting (copy)_1366279605360865286]' />
            </column>
            <column caption='AR - Success Manual Threshold (Entity)' datatype='real' name='[AR - Acceptance Manual Treshold (Entity) (copy)_929711907679526921]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Parameters].[Parameter 3]/100' />
            </column>
            <column caption='AR - Success Threshold  Category' datatype='string' name='[AR - Acceptance Treshold  Category (Entity) (copy)_929711907678982152]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [AR - % Acceptance Diff (copy)_929711907646169088] &lt;= -1*MIN([AR - Acceptance Manual Treshold (Entity) (copy)_929711907679526921]) THEN &quot;Anomaly Drop&quot;&#13;&#10;ELSEIF  [AR - % Acceptance Diff (copy)_929711907646169088] &gt;= MIN([AR - Acceptance Manual Treshold (Entity) (copy)_929711907679526921]) THEN &quot;Anomaly Improve&quot;&#13;&#10;ELSEIF  [AR - % Acceptance Diff (copy)_929711907646169088] &lt; 0 THEN &quot;Drop&quot;&#13;&#10;ELSE &quot;Improve&quot;&#13;&#10;END' />
            </column>
            <column caption='SA SR - Order Count Benchmark' datatype='integer' name='[AR - Order Count Benchmark (copy)_1366279605359943682]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Calculation_536209889880920066] AND [report_name] IN (&apos;single_attempt_success_rate&apos;, &apos;base_data&apos;),[metric2],Null)' />
            </column>
            <column caption='SA SR - Order Count Reporting' datatype='integer' name='[AR - Order Count Reporting (copy)_1366279605359673345]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Calculation_536209889870340096] AND [report_name] IN (&apos;single_attempt_success_rate&apos;, &apos;base_data&apos;),[metric2],Null)' />
            </column>
            <column caption='AR - Order Count Benchmark' datatype='integer' name='[AR - Order Count Reporting (copy)_536209889881104387]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Calculation_536209889880920066] AND [report_name] IN (&apos;acceptance_rate&apos;, &apos;base_data&apos;),[metric3],Null)' />
            </column>
            <column caption='AR - Recovery Order Count Benchmark' datatype='integer' name='[AR - Recovery Order Count Reporting (copy)_536209889881468933]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Calculation_536209889880920066] AND [report_name] IN (&apos;acceptance_rate&apos;, &apos;base_data&apos;),[metric2],Null)' />
            </column>
            <column caption='AR - Recovery Manual Threshold (Entity)' datatype='real' name='[AR - Success Manual Treshold (Entity) (copy)_929711907686273044]' role='measure' type='quantitative'>
