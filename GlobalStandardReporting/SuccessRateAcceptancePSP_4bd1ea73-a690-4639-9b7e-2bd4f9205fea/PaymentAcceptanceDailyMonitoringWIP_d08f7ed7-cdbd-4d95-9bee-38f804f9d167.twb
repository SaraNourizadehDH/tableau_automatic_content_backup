              <calculation class='tableau' formula='[Calculation_1346013391206109198] - [Trx - SR Reporting (copy)_929711907718500376]' />
            </column>
            <column caption='SA SR - Single Attempt Threshold Category (Entity)' datatype='string' name='[Trx - SR Threshold Category (Entity) (copy)_1366279605361467401]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [AR - % Success Diff (copy)_1366279605361283080] &lt;= -1*MIN([Trx - SR Manual Threshold (Entity) (copy)_1366279605361053703]) THEN &quot;Anomaly Drop&quot;&#13;&#10;ELSEIF  [AR - % Success Diff (copy)_1366279605361283080] &gt;= MIN([Trx - SR Manual Threshold (Entity) (copy)_1366279605361053703]) THEN &quot;Anomaly Improve&quot;&#13;&#10;ELSEIF  [AR - % Success Diff (copy)_1366279605361283080] &lt; 0 THEN &quot;Drop&quot;&#13;&#10;ELSE &quot;Improve&quot;&#13;&#10;END' />
            </column>
