        <calculation class='tableau' formula='SUM(IIF([report_name] IN (&apos;decline_reason&apos;, &apos;base_data&apos;),[metric1],Null))/MAX(IIF([report_name] IN (&apos;decline_reason&apos;, &apos;base_data&apos;),[metric2],Null))' />
