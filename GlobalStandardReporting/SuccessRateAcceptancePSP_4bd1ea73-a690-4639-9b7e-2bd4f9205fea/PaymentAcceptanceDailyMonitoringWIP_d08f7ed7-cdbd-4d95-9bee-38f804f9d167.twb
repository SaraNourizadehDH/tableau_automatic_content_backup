            <column caption='Max Date LOD' datatype='date' name='[Calculation_1365998103500529665]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED : MAX([Calculation_1346013391162667013]) }' />
            </column>
            <column caption='Weekdays filter' datatype='boolean' name='[Calculation_383650447852658690]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = 4 AND [Calculation_1346013391162667013] &gt;= [Parameters].[Parameter 8] - ([Parameters].[Parameter 2] * 8) AND [Calculation_1346013391162667013] &lt;= [Parameters].[Parameter 8] AND DATENAME(&apos;weekday&apos;, [Parameters].[Parameter 8]) = DATENAME(&apos;weekday&apos;, [Calculation_1346013391162667013]) THEN TRUE&#13;&#10;ELSEIF [Parameters].[Parameter 1] IN (3,2,1) THEN TRUE&#13;&#10;ELSE FALSE&#13;&#10;END' />
            </column>
            <column caption='AR - Order Count Reporting' datatype='integer' name='[Calculation_4049369388694994945]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Calculation_536209889870340096] AND [report_name] IN (&apos;acceptance_rate&apos;, &apos;base_data&apos;),[metric3],Null)' />
            </column>
            <column caption='is_report_date' datatype='boolean' name='[Calculation_536209889870340096]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//This just checks the basic condition if the date is/not the reporting period&#13;&#10;IF [Parameters].[Parameter 1] = 1 THEN&#13;&#10;    [date] = [Parameters].[Parameter 8]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = 2 THEN&#13;&#10;    DATETRUNC(&apos;week&apos;,[date], &apos;Monday&apos;) = DATETRUNC(&apos;week&apos;,[Parameters].[Parameter 8], &apos;Monday&apos;)&#13;&#10;ELSEIF [Parameters].[Parameter 1] = 3 THEN&#13;&#10;    DATETRUNC(&apos;month&apos;,[date]) = DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 8])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = 4 THEN&#13;&#10;    [date] = [Parameters].[Parameter 8]&#13;&#10;END' />
            </column>
            <column caption='AR - Acceptance Manual Threshold (Entity)' datatype='real' name='[Calculation_536209889871589377]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [global_entity_id] &#13;&#10; WHEN &apos;FP_BD&apos; THEN [Parameters].[Parameter 3]/100&#13;&#10;/* WHEN &apos;FP_HK&apos; THEN 0.01&#13;&#10;WHEN &apos;FP_KH&apos; THEN 0.002&#13;&#10;WHEN &apos;FP_MM&apos; THEN 0.01&#13;&#10;WHEN &apos;FP_LA&apos; THEN 0.06&#13;&#10;WHEN &apos;FP_PH&apos; THEN 0.02&#13;&#10;WHEN &apos;FP_SG&apos; THEN 0.03&#13;&#10;WHEN &apos;DJ_CZ&apos; THEN 0.005&#13;&#10;WHEN &apos;TB_BH&apos; THEN 0.002&#13;&#10;WHEN &apos;TB_JO&apos; THEN 0.001 */&#13;&#10;ELSE [Parameters].[Parameter 3]/100&#13;&#10;END' />
            </column>
            <column caption='is_comparison_period' datatype='boolean' name='[Calculation_536209889880920066]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//this encapsulates the benchmark logic as a Boolean&#13;&#10;IF [Parameters].[Parameter 1] = 1 THEN&#13;&#10;    [Calculation_1346013391162667013] &gt;= DATEADD(&apos;day&apos;,-[Parameters].[Parameter 2],[Parameters].[Parameter 8])&#13;&#10;    AND [Calculation_1346013391162667013] &lt; [Parameters].[Parameter 8]&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 1] = 2 THEN&#13;&#10;    [Calculation_1346013391162667013] &gt;= DATETRUNC(&apos;week&apos;,DATEADD(&apos;week&apos;, ([Parameters].[Parameter 2]*-1), [Parameters].[Parameter 8]),&apos;Monday&apos;) &#13;&#10;    AND [Calculation_1346013391162667013] &lt; DATETRUNC(&apos;week&apos;, DATEADD(&apos;week&apos;, 0, [Parameters].[Parameter 8]), &apos;Monday&apos;)&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 1] = 3 THEN&#13;&#10;    [Calculation_1346013391162667013] &gt;= DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;, ([Parameters].[Parameter 2]*-1)-7, [Parameters].[Parameter 8])) &#13;&#10;    AND [Calculation_1346013391162667013] &lt; DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, 0, [Parameters].[Parameter 8]))&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 1] = 4 THEN&#13;&#10;    [Calculation_1346013391162667013] &gt;= [Parameters].[Parameter 8] - ([Parameters].[Parameter 2] * 7) &#13;&#10;    AND [Calculation_1346013391162667013] &lt; [Parameters].[Parameter 8] &#13;&#10;    AND [Calculation_383650447852658690] = TRUE&#13;&#10;END' />
            </column>
            <column caption='min(1)' datatype='integer' name='[Calculation_929711907676778501]' role='measure' type='quantitative' user:unnamed='AR - Entity'>
              <calculation class='tableau' formula='min(1)' />
            </column>
            <column caption='AR - % Acceptance Benchmark' datatype='real' name='[Calculation_966022179612631040]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([AR - Success Order Count Reporting (copy)_536209889881264132]) + SUM([AR - Recovery Order Count Reporting (copy)_536209889881468933])) / SUM([AR - Order Count Reporting (copy)_536209889881104387])' />
            </column>
            <column caption='AR - % Acceptance Diff' datatype='real' name='[Calculation_966022179615682561]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[% Success (copy)_1443755530655637512] - [Calculation_966022179612631040]' />
            </column>
            <column caption='Display Outliers - overall' datatype='boolean' name='[Calculation_978407080024940547]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;    [Parameters].[Parameter 7] = FALSE THEN FALSE &#13;&#10;ELSEIF     &#13;&#10;    [Parameters].[Parameter 7] = TRUE &#13;&#10;    AND &#13;&#10;    (&#13;&#10;        IIF([Acceptance Treshold  Category (PM) (copy)_1371627603789869058] = &quot;Anomaly Drop&quot;,1,0)&#13;&#10;        +&#13;&#10;        IIF([AR - Acceptance Treshold  Category (Entity) (copy)_929711907678982152] = &quot;Anomaly Drop&quot;,1,0)&#13;&#10;        +&#13;&#10;        IIF([AR - Success Treshold  Category (Entity) (copy)_929711907711881237] = &quot;Anomaly Improve&quot;,1,0)&#13;&#10;        +&#13;&#10;        IIF([Trx - SR Treshold Category (PM) (copy)_697213571638386690] = &quot;Anomaly Drop&quot;,1,0)&#13;&#10;        +&#13;&#10;        IIF([Trx - SR Threshold Category (Entity) (copy)_1366279605361467401] = &quot;Anomaly Drop&quot;,1,0)&#13;&#10;    )&#13;&#10;    &gt; 0&#13;&#10;    THEN FALSE&#13;&#10;ELSE TRUE&#13;&#10;END' />
            </column>
            <column caption='AR - non nulls' datatype='boolean' name='[Calculation_978407080034037766]' role='measure' type='nominal'>
              <calculation class='tableau' formula='[% Success (copy)_1443755530655637512] &gt; 0' />
            </column>
            <column caption='Trx SR - non-nulls' datatype='boolean' name='[Calculation_978407080034177031]' role='measure' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1346013391206109198] &gt; 0' />
            </column>
            <column caption='non-nulls' datatype='boolean' name='[Calculation_978407080034340872]' role='measure' type='nominal'>
              <calculation class='tableau' formula='[Calculation_978407080034177031] OR [Calculation_978407080034037766]' />
            </column>
            <column caption='&quot;&quot;' datatype='string' name='[Calculation_978407080073846807]' role='dimension' type='nominal' user:unnamed='Trx SR - PM'>
              <calculation class='tableau' formula='&quot;&quot;' />
            </column>
            <column caption='SA SR - % Single Attempt Benchmark' datatype='real' name='[SA SR - % Single Attempt Reporting (copy)_1366279605360865286]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([SA SR - Success Count Reporting (copy)_1366279605360295940]) / SUM([AR - Order Count Benchmark (copy)_1366279605359943682])' />
            </column>
            <column caption='SA SR - Success Count Reporting' datatype='integer' name='[SA SR - Order Count Reporting (copy)_1366279605360123907]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Calculation_536209889870340096] AND [report_name] IN (&apos;single_attempt_success_rate&apos;, &apos;base_data&apos;),[metric1],Null)' />
            </column>
            <column caption='SA SR - Success Count Benchmark' datatype='integer' name='[SA SR - Success Count Reporting (copy)_1366279605360295940]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Calculation_536209889880920066] AND [report_name] IN (&apos;single_attempt_success_rate&apos;, &apos;base_data&apos;),[metric1],Null)' />
            </column>
            <column caption='Trx - All Trx Benchmark' datatype='integer' name='[Trx - All Trx Reporting (copy)_929711907718385687]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Calculation_536209889880920066] AND [report_name] IN (&apos;transaction_success_rate&apos;, &apos;base_data&apos;),[metric2],Null)' />
            </column>
            <column caption='SA SR - Single Attempt Manual Threshold (Entity)' datatype='real' name='[Trx - SR Manual Threshold (Entity) (copy)_1366279605361053703]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Parameters].[Parameter 3]/100' />
            </column>
            <column caption='Trx - % SR Benchmark' datatype='real' name='[Trx - SR Reporting (copy)_929711907718500376]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Trx - Success Reporting (copy)_929711907717947414])/SUM([Trx - All Trx Reporting (copy)_929711907718385687])' />
            </column>
            <column caption='Trx - % SR Diff' datatype='real' name='[Trx - SR Reporting (copy)_929711907718791193]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1346013391206109198] - [Trx - SR Reporting (copy)_929711907718500376]' />
            </column>
            <column caption='SA SR - Single Attempt Threshold Category (Entity)' datatype='string' name='[Trx - SR Threshold Category (Entity) (copy)_1366279605361467401]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [AR - % Success Diff (copy)_1366279605361283080] &lt;= -1*MIN([Trx - SR Manual Threshold (Entity) (copy)_1366279605361053703]) THEN &quot;Anomaly Drop&quot;&#13;&#10;ELSEIF  [AR - % Success Diff (copy)_1366279605361283080] &gt;= MIN([Trx - SR Manual Threshold (Entity) (copy)_1366279605361053703]) THEN &quot;Anomaly Improve&quot;&#13;&#10;ELSEIF  [AR - % Success Diff (copy)_1366279605361283080] &lt; 0 THEN &quot;Drop&quot;&#13;&#10;ELSE &quot;Improve&quot;&#13;&#10;END' />
            </column>
            <column caption='Trx - SR Threshold Category (Entity)' datatype='string' name='[Trx - SR Treshold Category (PM) (copy)_697213571638386690]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Trx - SR Reporting (copy)_929711907718791193] &lt;= -1*MIN([AR - Success Manual Treshold (Entity) (copy)_929711907719491610]) THEN &quot;Anomaly Drop&quot;&#13;&#10;ELSEIF  [Trx - SR Reporting (copy)_929711907718791193] &gt;= MIN([AR - Success Manual Treshold (Entity) (copy)_929711907719491610]) THEN &quot;Anomaly Improve&quot;&#13;&#10;ELSEIF  [Trx - SR Reporting (copy)_929711907718791193] &lt; 0 THEN &quot;Drop&quot;&#13;&#10;ELSE &quot;Improve&quot;&#13;&#10;END' />
            </column>
            <column caption='Trx - Success Benchmark' datatype='integer' name='[Trx - Success Reporting (copy)_929711907717947414]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Calculation_536209889880920066] AND [report_name] IN (&apos;transaction_success_rate&apos;, &apos;base_data&apos;),[metric1],Null)' />
