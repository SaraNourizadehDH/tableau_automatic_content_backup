            <column caption='AR - Order Count Daily Threshold  Category - Entity' datatype='string' name='[AR - Success Threshold  Category (copy)_552535446730108952]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [AR - Order Count Daily Benchmark (copy)_552535446723588113] &lt; 0 THEN &quot;Drop&quot;&#13;&#10;ELSE &quot;Improve&quot;&#13;&#10;END' />
