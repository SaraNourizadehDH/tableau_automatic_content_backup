      <column caption='Time to Read' datatype='string' name='[Calculation_52213654559453186]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [time_to_read]+1 &lt; [Parameters].[Parameter 4 1] &#10;THEN STR([time_to_read]+1)&#10;ELSE &apos;&gt;= &apos; + STR([Parameters].[Parameter 4 1])&#10;END' />
      </column>
      <column caption='_breakdown' datatype='string' name='[Calculation_706220755988180993]' role='dimension' type='nominal'>
