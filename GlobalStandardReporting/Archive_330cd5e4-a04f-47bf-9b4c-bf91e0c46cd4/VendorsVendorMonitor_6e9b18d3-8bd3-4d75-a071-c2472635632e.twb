            <column caption='No Vendors Actioned (fixed)' datatype='integer' name='[Calculation_551690995997212683]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// rule tye = &apos;All&apos;&#10;// is enabled = &apos;All&apos;&#10;// is real time = &apos;All&apos;&#10;// deployment type = &apos;All&apos;&#10;// close vendor = &apos;All&apos;&#10;// salesforce cases = &apos;All&apos;&#10;// send inbox = &apos;All&apos;&#10;IF ([Parameters].[Parameter 8] = &apos;All&apos;&#10;    AND [Parameters].[Choose Rule Type (copy)_551690996833644557] = &apos;All&apos;&#10;    AND [Parameters].[Choose Rule Type (copy) (copy)_551690996833652750] = &apos;All&apos;&#10;    AND [Parameters].[Choose Rule Type (copy) (copy) (copy)_551690996833669135] = &apos;All&apos;&#10;    AND [Parameters].[Choose Is Realtime (copy)_6056145272653144064] = &apos;All&apos;&#10;    AND [Parameters].[Choose Is Realtime (copy) (copy)_6056145272653156353] = &apos;All&apos;&#10;    AND [Parameters].[Choose Is Realtime (copy) (copy) (copy)_6056145272653164546] = &apos;All&apos;&#10;   )&#10;  THEN SUM([no_vendors_actioned])&#10;&#10;//////////////////////// LEVEL 1 ////////////////////////&#10;// rule tye = any&#10;// is enabled = &apos;All&apos;&#10;// is real time = &apos;All&apos;&#10;// deployment type = &apos;All&apos;&#10;// close vendor = &apos;All&apos;&#10;// salesforce cases = &apos;All&apos;&#10;// send inbox = &apos;All&apos;&#10;ELSEIF ([Parameters].[Parameter 8] = [Parameters].[Parameter 8]&#10;        AND [Parameters].[Choose Rule Type (copy)_551690996833644557] = &apos;All&apos;&#10;        AND [Parameters].[Choose Rule Type (copy) (copy)_551690996833652750] = &apos;All&apos;&#10;        AND [Parameters].[Choose Rule Type (copy) (copy) (copy)_551690996833669135] = &apos;All&apos;&#10;        AND [Parameters].[Choose Is Realtime (copy)_6056145272653144064] = &apos;All&apos;&#10;        AND [Parameters].[Choose Is Realtime (copy) (copy)_6056145272653156353] = &apos;All&apos;&#10;        AND [Parameters].[Choose Is Realtime (copy) (copy) (copy)_6056145272653164546] = &apos;All&apos;&#10;       )&#10;  THEN SUM(&#10;        IF ([type] = [Parameters].[Parameter 8] OR [type] = NULL)&#10;        THEN [no_vendors_actioned]&#10;        END)&#10;&#10;// rule tye = &apos;All&apos;&#10;// is enabled = any&#10;// is real time = &apos;All&apos;&#10;// deployment type = &apos;All&apos;&#10;// close vendor = &apos;All&apos;&#10;// salesforce cases = &apos;All&apos;&#10;// send inbox = &apos;All&apos;&#10;ELSEIF ([Parameters].[Parameter 8] = &apos;All&apos;&#10;        AND [Parameters].[Choose Rule Type (copy)_551690996833644557] = [Parameters].[Choose Rule Type (copy)_551690996833644557]&#10;        AND [Parameters].[Choose Rule Type (copy) (copy)_551690996833652750] = &apos;All&apos;&#10;        AND [Parameters].[Choose Rule Type (copy) (copy) (copy)_551690996833669135] = &apos;All&apos;&#10;        AND [Parameters].[Choose Is Realtime (copy)_6056145272653144064] = &apos;All&apos;&#10;        AND [Parameters].[Choose Is Realtime (copy) (copy)_6056145272653156353] = &apos;All&apos;&#10;        AND [Parameters].[Choose Is Realtime (copy) (copy) (copy)_6056145272653164546] = &apos;All&apos;&#10;       )&#10;  THEN SUM(&#10;        IF (LOWER(STR([is_enabled])) = LOWER([Parameters].[Choose Rule Type (copy)_551690996833644557]) OR [is_enabled] = NULL)&#10;        THEN [no_vendors_actioned]&#10;        END)&#10;&#10;// rule tye = &apos;All&apos;&#10;// is enabled = &apos;All&apos;&apos;&#10;// is real time = any&#10;// deployment type = &apos;All&apos;&#10;// close vendor = &apos;All&apos;&#10;// salesforce cases = &apos;All&apos;&#10;// send inbox = &apos;All&apos;&#10;ELSEIF ([Parameters].[Parameter 8] = &apos;All&apos;&#10;        AND [Parameters].[Choose Rule Type (copy)_551690996833644557] = &apos;All&apos;&#10;        AND [Parameters].[Choose Rule Type (copy) (copy)_551690996833652750] = [Parameters].[Choose Rule Type (copy) (copy)_551690996833652750]&#10;        AND [Parameters].[Choose Rule Type (copy) (copy) (copy)_551690996833669135] = &apos;All&apos;&#10;        AND [P