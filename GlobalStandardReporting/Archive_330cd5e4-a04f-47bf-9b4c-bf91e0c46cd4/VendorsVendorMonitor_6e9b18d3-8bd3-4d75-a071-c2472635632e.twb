              <calculation class='tableau' formula='SUM([monitor_rule_availability_events_online_by_client]) / SUM([monitor_rule_availability_events])' />
            </column>
            <column caption='% Monitor Rule Vendor Late Realtime Events Online By Client' datatype='real' name='[% Monitor Rule Unreachable Events Online By Client (copy) (copy)_1485765688492662807]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([monitor_rule_vendor_late_realtime_events_online_by_client]) / SUM([monitor_rule_vendor_late_realtime_events])' />
