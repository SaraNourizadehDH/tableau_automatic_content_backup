      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[none:read_state:nk]' palette='tableau20_10_0' type='palette'>
            <map to='#59a14f'>
              <bucket>&quot;read once&quot;</bucket>
            </map>
            <map to='#a0cbe8'>
              <bucket>&quot;read&quot;</bucket>
            </map>
            <map to='#bab0ac'>
              <bucket>&quot;not read&quot;</bucket>
            </map>
            <map to='#f1ce63'>
              <bucket>&quot;read more than once&quot;</bucket>
            </map>
          </encoding>
          <encoding attr='color' field='[none:Calculation_362258336543363081:nk]' type='palette'>
            <map to='#59a14f'>
              <bucket>&quot;read&quot;</bucket>
            </map>
            <map to='#bab0ac'>
              <bucket>&quot;not read&quot;</bucket>
            </map>
          </encoding>
