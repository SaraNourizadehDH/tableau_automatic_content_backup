    <worksheet name='Offline Metrics - % Duration Offline - Monitor Rule Categories'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='10'>% Offline Duration Reasons</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='vendor_gsr_monitor_offline (rl)' name='federated.1o6emvd1e0vajj15qj77a05sdpq1' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose Offline Dimension (A)' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Region&quot;'>
              <calculation class='tableau' formula='&quot;Region&quot;' />
            </column>
            <column caption='Choose Offline Dimension (B)' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country Name&quot;'>
              <calculation class='tableau' formula='&quot;Country Name&quot;' />
            </column>
            <column caption='Offline Tabular Dimension Parameter' datatype='string' name='[Parameter 7]' param-domain-type='list' role='measure' type='nominal' value='&quot;Time Dimension&quot;'>
              <calculation class='tableau' formula='&quot;Time Dimension&quot;' />
            </column>
            <column caption='Y-Right Metric Parameter - Vendors with Offline events' datatype='string' name='[Y-Right Metric Parameter - Offline Duration (copy)_3099743203202977837]' param-domain-type='list' role='measure' type='nominal' value='&quot;None&quot;'>
              <calculation class='tableau' formula='&quot;None&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1o6emvd1e0vajj15qj77a05sdpq1'>
            <column caption='% Offline Duration - Client Reasons' datatype='real' name='[% Offline Duration - Busy (copy)_3099743203077566466]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([client_offline_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - Monitor Rule' datatype='real' name='[% Offline Duration - Busy Checkin (copy) (copy) (copy) (copy) (copy) (copy)_1891582220811886602]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([monitor_rule_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - Courier Delayed' datatype='real' name='[% Offline Duration - Busy Checkin (copy) (copy) (copy) (copy) (copy)_1891582220811350025]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([courier_delayed_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - Churn' datatype='real' name='[% Offline Duration - Busy Checkin (copy) (copy) (copy)_1891582220811333639]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([churn_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - Checkin' datatype='real' name='[% Offline Duration - Busy Checkin (copy) (copy)_1891582220811321350]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([checkin_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - Vendor Late Real-Time rules' datatype='real' name='[% Offline Duration - Updates in Menu (copy) (copy) (copy) (copy) (copy)_3099743203093069834]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([monitor_rule_vendor_late_realtime_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - Vendor Late Compliance rules' datatype='real' name='[% Offline Duration - Updates in Menu (copy) (copy) (copy) (copy)_3099743203093053449]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([monitor_rule_vendor_late_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - Unreachable Compliance rules' datatype='real' name='[% Offline Duration - Updates in Menu (copy) (copy) (copy)_3099743203093041160]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([monitor_rule_unreachable_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - Order Failure Compliance rules' datatype='real' name='[% Offline Duration - Updates in Menu (copy) (copy)_3099743203093024775]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([monitor_rule_order_failure_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - Order Failure Real-Time rules' datatype='real' name='[% Offline Duration - Updates in Menu (copy)_3099743203093012486]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([monitor_rule_order_failure_realtime_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - Availability Compliance rules' datatype='real' name='[% Updates in Menu Events - Client Online (copy)_3099743203094024203]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([monitor_rule_availability_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='Schedule Duration (min)' datatype='real' name='[Calculation_1891582220807364610]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([schedule_duration]) / 60, 0)' />
            </column>
            <column caption='% Offline Duration' datatype='real' name='[Calculation_1891582220810272771]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([offline_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='Dimension (A)' datatype='string' name='[Calculation_1891582221181055015]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Region&apos; THEN [region]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Brand Name&apos; THEN [brand_name]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Country Name&apos; THEN [country_name]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Vertical Type&apos; THEN [vertical_type]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Vendor Grade&apos; THEN [vendor_grade]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Transmission Flow&apos; THEN [transmission_flow]&#10;END' />
            </column>
            <column caption='_Offline Table Display Sheet' datatype='string' name='[Calculation_360850943926923264]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 7]' />
            </column>
            <column caption='_Exclude Today' datatype='boolean' name='[Calculation_949344769977401344]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[created_date] &lt; TODAY()' />
            </column>
            <column caption='Dimension (B)' datatype='string' name='[Offline Dimension (A) (copy)_1891582221181382696]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;All&apos; THEN &apos;&apos;&#10;ELSEIF  [Parameters].[Parameter 5] = &apos;Region&apos; THEN [region]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Brand Name&apos; THEN [brand_name]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Country Name&apos; THEN [country_name]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Vertical Type&apos; THEN [vertical_type]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Vendor Grade&apos; THEN [vendor_grade]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Transmission Flow&apos; THEN [transmission_flow]&#10;END' />
            </column>
