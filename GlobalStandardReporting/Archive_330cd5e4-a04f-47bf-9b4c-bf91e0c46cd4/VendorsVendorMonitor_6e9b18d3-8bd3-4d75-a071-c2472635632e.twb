              <calculation class='tableau' formula='&quot;Deployment Time&quot;' />
            </column>
            <column caption='Rule KPI Parameter' datatype='string' name='[Y-Left Metric Parameter (copy)_551690995988103169]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% Vendor Fail-Rate&quot;'>
              <calculation class='tableau' formula='&quot;% Vendor Fail-Rate&quot;' />
