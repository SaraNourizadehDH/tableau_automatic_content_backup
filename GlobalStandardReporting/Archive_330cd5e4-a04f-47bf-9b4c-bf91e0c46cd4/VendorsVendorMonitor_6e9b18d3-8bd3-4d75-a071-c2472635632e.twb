            <column caption='Client Reopen Metric Parameter' datatype='string' name='[Y-Right Metric Parameter - Offline Duration (copy)_360850943961858056]' param-domain-type='list' role='measure' type='nominal' value='&quot;Offline events&quot;'>
              <calculation class='tableau' formula='&quot;Offline events&quot;' />
