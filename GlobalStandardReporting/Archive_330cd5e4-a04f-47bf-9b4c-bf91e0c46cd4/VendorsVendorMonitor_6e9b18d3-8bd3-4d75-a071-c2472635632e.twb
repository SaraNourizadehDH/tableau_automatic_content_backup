          <datasource-dependencies datasource='Parameters'>
            <column caption='Y-Right Metric Parameter - Offline Duration' datatype='string' name='[Offline Metric Parameter (copy)_6959468821152006154]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% Offline Duration&quot;'>
              <calculation class='tableau' formula='&quot;% Offline Duration&quot;' />
            </column>
            <column caption='Choose Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
            <column caption='Choose Offline Dimension (A)' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Region&quot;'>
              <calculation class='tableau' formula='&quot;Region&quot;' />
            </column>
            <column caption='Choose Offline Dimension (B)' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country Name&quot;'>
              <calculation class='tableau' formula='&quot;Country Name&quot;' />
            </column>
            <column caption='Offline Tabular Dimension Parameter' datatype='string' name='[Parameter 7]' param-domain-type='list' role='measure' type='nominal' value='&quot;Time Dimension&quot;'>
              <calculation class='tableau' formula='&quot;Time Dimension&quot;' />
            </column>
            <column caption='Y-Right Metric Parameter - Vendors with Offline events' datatype='string' name='[Y-Right Metric Parameter - Offline Duration (copy)_3099743203202977837]' param-domain-type='list' role='measure' type='nominal' value='&quot;None&quot;'>
              <calculation class='tableau' formula='&quot;None&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1o6emvd1e0vajj15qj77a05sdpq1'>
            <column caption='% Vendors - Offline Duration events' datatype='real' name='[% Offline Duration (copy)_3099743203193679894]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_with_offline_events]) / SUM([vendors_with_schedule])' />
            </column>
            <column caption='% Vendors - Availability Compliance rules events' datatype='real' name='[% Offline Duration - Availability Compliance rules (copy)_3099743203193712663]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_with_monitor_rule_availability_events]) / SUM([vendors_with_schedule])' />
            </column>
            <column caption='% Offline Duration - No Drivers' datatype='real' default-format='p0.00%' name='[% Offline Duration - Bad Weather (copy)_1600466734714085376]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([too_busy_no_drivers_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Vendors - Bad Weather events' datatype='real' name='[% Offline Duration - Bad Weather (copy)_3099743203193741336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_with_bad_weather_events]) / SUM([vendors_with_schedule])' />
            </column>
            <column caption='% Offline Duration - MUO' datatype='real' name='[% Offline Duration - Busy (copy)_1891582220812873741]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([unreachable_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - Special Day' datatype='real' name='[% Offline Duration - Busy (copy)_1891582220817903630]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([special_day_duration]) / SUM([schedule_duration])' />
