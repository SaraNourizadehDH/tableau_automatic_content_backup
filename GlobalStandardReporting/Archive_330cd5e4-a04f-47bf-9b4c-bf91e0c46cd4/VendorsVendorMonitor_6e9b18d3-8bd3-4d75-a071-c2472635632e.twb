            </column>
            <column caption='Date Granularity' datatype='string' name='[Calculation_1891582220807041025]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&apos;Daily&apos; THEN STR([created_date])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Weekly&apos; THEN [created_week]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Monthly&apos; THEN [created_month]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Quarterly&apos; THEN STR(DATE(DATETRUNC(&apos;quarter&apos;,[created_date])))&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Yearly&apos; THEN STR([created_year])&#10;END' />
            </column>
            <column caption='_Exclude Today' datatype='boolean' name='[Calculation_949344769977401344]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[created_date] &lt; TODAY()' />
            </column>
            <column caption=' Dimension (A)' datatype='string' name='[Offline Dimension (A) (copy)_6959468820951724037]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Choose Offline Dimension (A) (copy)_6959468820950552579] = &apos;Region&apos; THEN [region]&#10;ELSEIF [Parameters].[Choose Offline Dimension (A) (copy)_6959468820950552579] = &apos;Brand Name&apos; THEN [brand_name]&#10;ELSEIF [Parameters].[Choose Offline Dimension (A) (copy)_6959468820950552579] = &apos;Country Name&apos; THEN [country_name]&#10;ELSEIF [Parameters].[Choose Offline Dimension (A) (copy)_6959468820950552579] = &apos;Vertical Type&apos; THEN [vertical_type]&#10;ELSEIF [Parameters].[Choose Offline Dimension (A) (copy)_6959468820950552579] = &apos;Vendor Grade&apos; THEN [vendor_grade]&#10;ELSEIF [Parameters].[Choose Offline Dimension (A) (copy)_6959468820950552579] = &apos;Transmission Flow&apos; THEN [transmission_flow]&#10;END' />
            </column>
            <column caption=' Dimension (B)' datatype='string' name='[Offline Dimension (B) (copy)_6959468820951744518]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Choose Offline Dimension (B) (copy)_6959468820950568964] = &apos;All&apos; THEN &apos;&apos;&#10;ELSEIF [Parameters].[Choose Offline Dimension (B) (copy)_6959468820950568964]= &apos;Region&apos; THEN [region]&#10;ELSEIF [Parameters].[Choose Offline Dimension (B) (copy)_6959468820950568964] = &apos;Brand Name&apos; THEN [brand_name]&#10;ELSEIF [Parameters].[Choose Offline Dimension (B) (copy)_6959468820950568964] = &apos;Country Name&apos; THEN [country_name]&#10;ELSEIF [Parameters].[Choose Offline Dimension (B) (copy)_6959468820950568964] = &apos;Vertical Type&apos; THEN [vertical_type]&#10;ELSEIF [Parameters].[Choose Offline Dimension (B) (copy)_6959468820950568964] = &apos;Vendor Grade&apos; THEN [vendor_grade]&#10;ELSEIF [Parameters].[Choose Offline Dimension (B) (copy)_6959468820950568964] = &apos;Transmission Flow&apos; THEN [transmission_flow]&#10;END' />
            </column>
            <column caption='Y-Left - # Offline Events' datatype='integer' name='[Y - % Client Reopen (copy)_360850943966580746]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Y-Right Metric Parameter - Offline Duration (copy)_360850943961858056] = &apos;Offline events&apos; THEN SUM([offline_events])&#10;&#10;ELSEIF [Parameters].[Y-Right Metric Parameter - Offline Duration (copy)_360850943961858056] = &apos;Offline events - Client Reasons&apos; THEN SUM([client_offline_events])&#10;ELSEIF [Parameters].[Y-Right Metric Parameter - Offline Duration (copy)_360850943961858056] = &apos;.    Offline events - Client Reasons&apos; THEN SUM([client_offline_events])&#10;ELSEIF [Parameters].[Y-Right Metric Parameter - Offline Duration (copy)_360850943961858056] = &apos;.    Offline events - Bad Weather&apos; THEN SUM([bad_weather_events])&#10;ELSEIF [Parameters].[Y-Right Metric Parameter - Offline Duration (copy)_360850943961858056] = &apos;.    Offline events - Busy&apos; THEN SUM([busy_events])&#10;ELSEIF [Parameters].[Y-Right Metric Parameter - Offline Duration (copy)_360850943961858056] = &apos;.    Offline events - Closed&apos; THEN SUM([closed_events])&#10;ELSEIF [Parameters].[Y-Right Metric Parameter - Offline Duration (copy)_360850943961858056] = &apos;.    Offline events - Holiday&apos; THEN SUM([holiday_events])&#10;ELSEIF [Parameters].[Y-Right Metric Parameter - Offline Duration (copy)_360850943961858056] = &apos;.    Offline events - Other&apos; THEN SUM([other_events])&#10;ELSEIF [Parameters].[Y-Right Metric Parameter - Offline Duration (copy)_360850943961858056] = &apos;.    Offline events - Refurbishment&apos; THEN SUM([refurbishment_events])&#10;ELSEIF [Parameters].[Y-Right Metric Parameter - Offline Duration (copy)_360850943961858056] = &apos;.    Offline events - Tech Problem&apos; THEN SUM([tech_problem_events])&#10;ELSEIF [Parameters].[Y-Right Metric Parameter - Offline Duration (copy)_360850943961858056] = &apos;.    Offline events - Updates in Menu&apos; THEN SUM([updates_in_menu_events])&#10;&#10;ELSEIF [Parameters].[Y-Right Metric Parameter - Offline Duration (copy)_360850943961858056] = &apos;.    Offline events - Monitor Reasons&apos; THEN SUM([monitor_offline_events])&#10;ELSEIF [Parameters].[Y-Right Metric Parameter - Offline Duration (copy)_360850943961858056] = &apos;.    Offline events - Checkin&apos; THEN SUM([checkin_events])&#10;ELSEIF [Parameters].[Y-Right Metric Parameter - Offline Duration (copy)_360850943961858056] = &apos;.    Offline events - Churn&apos; THEN SUM([churn_events])&#10;ELSEIF [Parameters].[Y-Right Metric Parameter - Offline Duration (copy)_360850943961858056] = &apos;.    Offline events - Courier Delayed&apos; THEN SUM([courier_delayed_events])&#10;ELSEIF [Parameters].[Y-Right Metric Parameter - Offline Duration (copy)_360850943961858056] = &apos;.    Offline events - Monitor Rule&apos; THEN SUM([monitor_rule_events])&#10;ELSEIF [Parameters].[Y-Right Metric Parameter - Offline Duration (copy)_360850943961858056] = &apos;.    Offline events - MUO&apos; THEN SUM([unreachable_events])&#10;&#10;ELSEIF [Parameters].[Y-Right Metric Parameter - Offline Duration (copy)_360850943961858056] = &apos;Offline events - Monitor Rule&apos; THEN SUM([monitor_rule_events])&#10;ELSEIF [Parameters].[Y-Right Metric Parameter - Offline Duration (copy)_360850943961858056] = &apos;.    Offline events - Order Failure Real-Time rules&apos; THEN SUM([monitor_rule_order_failure_realtime_events])&#10;ELSEIF [Parameters].[Y-Right Metric Parameter - Offline Duration (copy)_360850943961858056] = &apos;.    Offline events - Order Failure Compliance rules&apos; THEN SUM([monitor_rule_order_failure_events])&#10;ELSEIF [Parameters].[Y-Right Metric Parameter - Offline Duration (copy)_360850943961858056] = &apos;.    Offline events - Unreachable Compliance rules&apos; THEN SUM([monitor_rule_unreachable_events])&#10;ELSEIF [Parameters].[Y-Right Metric Parameter - Offline Duration (copy)_360850943961858056] = &apos;.    Offline events - Vendor Late Real-Time rules&apos; THEN SUM([monitor_rule_vendor_late_realtime_events])&#10;ELSEIF [Parameters].[Y-Right Metric Parameter - Offline Duration (copy)_360850943961858056] = &apos;.    Offline events - Vendor Late Compliance rules&apos; THEN SUM([monitor_rule_vendor_late_events])&#10;ELSEIF [Parameters].[Y-Right Metric Parameter - Offline Duration (copy)_360850943961858056] = &apos;.    Offline events - Availability Compliance rules&apos; THEN SUM([monitor_rule_availability_events])&#10;&#10;END' />
            </column>
            <column caption='Y-Right - % Client Reopen' datatype='real' name='[Y-Right Metric - Offline Duration (copy)_360850943963164681]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Y-Right Metric Parameter - Offline Duration (copy)_360850943961858056] = &apos;Offline events&apos; THEN [Calculation_1485765688460652546]&#10;&#10;ELSEIF [Parameters].[Y-Right Metric Parameter - Offline Duration (copy)_360850943961858056] = &apos;Offline events - Client Reasons&apos; THEN [% Offline Events Online By Client (copy)_1485765688461029379]&#10;ELSEIF [Parameters].[Y-Right Metric Parameter - Offline Duration (copy)_360850943961858056] = &apos;.    Offline events - Client Reasons&apos; THEN [% Offline Events Online By Client (copy)_1485765688461029379]&#10;ELSEIF [Parameters].[Y-Right Metric Parameter - Offline Duration (copy)_360850943961858056] = &apos;.    Offline events - Bad Weather&apos; THEN [% Client Offline Events Online By Client (copy)_1485765688461258756]&#10;ELSEIF [Parameters].[Y-Right Metric Parameter - Offline Duration (copy)_360850943961858056] = &apos;.    Offline events - Busy&apos; THEN [% Client Offline Events Online By Client (copy) (copy)_1485765688461283333]&#10;ELSEIF [Parameters].[Y-Right Metric Parameter - Offline Duration (copy)_360850943961858056] = &apos;.    Offline events - Closed&apos; THEN [% Client Offline Events Online By Client (copy) (copy) (copy)_1485765688461307910]&#10;ELSEIF [Parameters].[Y-Right Metric Parameter - Offline Duration (copy)_360850943961858056] = &apos;.    Offline events - Holiday&apos; THEN [% Client Offline Events Online By Client (copy) (copy) (copy) (copy)_1485765688461328391]&#10;ELSEIF [Parameters].[Y-Right Metric Parameter - Offline Duration (copy)_360850943961858056] = &apos;.    Offline events - Other&apos; THEN [% Client Offline Events Online By Client (copy) (copy) (copy) (copy) (copy)_1485765688461373448]&#10;ELSEIF [Parameters].[Y-Right Metric Parameter - Offline Duration (copy)_360850943961858056] = &apos;.    Offline events - Refurbishment&apos; THEN [% Client Offline Events Online By Client (copy) (copy) (copy) (copy