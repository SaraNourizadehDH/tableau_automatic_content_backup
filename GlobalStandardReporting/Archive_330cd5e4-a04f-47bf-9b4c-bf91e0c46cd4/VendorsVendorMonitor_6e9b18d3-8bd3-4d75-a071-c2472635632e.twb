          </datasource-dependencies>
          <datasource-dependencies datasource='federated.16pyb111i524rl1bl9ihr0bqasbj'>
            <column caption='% CLOSED Fail-Rate' datatype='real' name='[% Vendor Fail-Rate (copy) (copy) (copy) (copy) (copy)_551690995989864455]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_orders_closed_ct])/SUM([orders_ct])' />
            </column>
            <column caption='% NO_RESPONSE Fail-Rate' datatype='real' name='[% Vendor Fail-Rate (copy) (copy) (copy) (copy)_551690995989856262]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_orders_no_response_ct])/SUM([orders_ct])' />
            </column>
            <column caption='% ITEM_UNAVAILABLE Fail-Rate' datatype='real' name='[% Vendor Fail-Rate (copy) (copy) (copy)_551690995989843973]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_orders_item_unavailable_ct])/SUM([orders_ct])' />
            </column>
            <column caption='% TOO_BUSY Fail-Rate' datatype='real' name='[% Vendor Fail-Rate (copy) (copy)_551690995989835780]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_orders_too_busy_ct])/SUM([orders_ct])' />
            </column>
            <column caption='% UNREACHABLE Fail-Rate' datatype='real' name='[% Vendor Fail-Rate (copy)_551690995989823491]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_orders_unreachable_ct])/SUM([orders_ct])' />
            </column>
            <column caption='% Vendor Late &gt; 15' datatype='real' name='[% Vendor Late &gt; 5 (copy) (copy)_551690995991527434]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_over_15_count]) / SUM([vendor_late_all_count])' />
            </column>
            <column caption='% Vendor Late &gt; 10' datatype='real' name='[% Vendor Late &gt; 5 (copy)_551690995991515145]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_over_10_count]) / SUM([vendor_late_all_count])' />
            </column>
            <column caption='% Vendor Fail-Rate' datatype='real' name='[Calculation_551690995986907136]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_orders_vendor_ct])/SUM([orders_ct])' />
            </column>
            <column caption='Rule KPI Metric' datatype='real' name='[Calculation_551690995989598210]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Y-Left Metric Parameter (copy)_551690995988103169] = &apos;% Vendor Fail-Rate&apos; THEN [Calculation_551690995986907136]&#10;ELSEIF [Parameters].[Y-Left Metric Parameter (copy)_551690995988103169] = &apos;.    % UNREACHABLE Fail-Rate&apos; THEN [% Vendor Fail-Rate (copy)_551690995989823491]&#10;ELSEIF [Parameters].[Y-Left Metric Parameter (copy)_551690995988103169] = &apos;.    % TOO_BUSY Fail-Rate&apos; THEN [% Vendor Fail-Rate (copy) (copy)_551690995989835780]&#10;ELSEIF [Parameters].[Y-Left Metric Parameter (copy)_551690995988103169] = &apos;.    % ITEM_UNAVAILABLE Fail-Rate&apos; THEN [% Vendor Fail-Rate (copy) (copy) (copy)_551690995989843973]&#10;ELSEIF [Parameters].[Y-Left Metric Parameter (copy)_551690995988103169] = &apos;.    % NO_RESPONSE Fail-Rate&apos; THEN [% Vendor Fail-Rate (copy) (copy) (copy) (copy)_551690995989856262]&#10;ELSEIF [Parameters].[Y-Left Metric Parameter (copy)_551690995988103169] = &apos;.    % CLOSED Fail-Rate&apos; THEN [% Vendor Fail-Rate (copy) (copy) (copy) (copy) (copy)_551690995989864455]&#10;ELSEIF [Parameters].[Y-Left Metric Parameter (copy)_551690995988103169] = &apos;.    % Vendor Late &gt; 5&apos; THEN [Calculation_551690995991396360]&#10;ELSEIF [Parameters].[Y-Left Metric Parameter (copy)_551690995988103169] = &apos;.    % Vendor Late &gt; 10&apos; THEN [% Vendor Late &gt; 5 (copy)_551690995991515145]&#10;ELSEIF [Parameters].[Y-Left Metric Parameter (copy)_551690995988103169] = &apos;.    % Vendor Late &gt; 15&apos; THEN [% Vendor Late &gt; 5 (copy) (copy)_551690995991527434]&#10;END' />
            </column>
            <column caption='% Vendor Late &gt; 5' datatype='real' name='[Calculation_551690995991396360]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_over_5_count]) / SUM([vendor_late_all_count])' />
            </column>
            <column caption='No Vendors Actioned (fixed)' datatype='integer' name='[Calculation_551690995997212683]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// rule tye = &apos;All&apos;&#10;// is enabled = &apos;All&apos;&#10;// is real time = &apos;All&apos;&#10;// deployment type = &apos;All&apos;&#10;// close vendor = &apos;All&apos;&#10;// salesforce cases = &apos;All&apos;&#10;// send inbox = &apos;All&apos;&#10;IF ([Parameters].[Parameter 8] = &apos;All&apos;&#10;    AND [Parameters].[Choose Rule Type (copy)_551690996833644557] = &apos;All&apos;&#10;    AND [Parameters].[Choose Rule Type (copy) (copy)_551690996833652750] = &apos;All&apos;&#10;    AND [Parameters].[Choose Rule Type (copy) (copy) (copy)_551690996833669135] = &apos;All&apos;&#10;    AND [Parameters].[Choose Is Realtime (copy)_6056145272653144064] = &apos;All&apos;&#10;    AND [Parameters].[Choose Is Realtime (copy) (copy)_6056145272653156353] = &apos;All&apos;&#10;    AND [Parameters].[Choose Is Realtime (copy) (copy) (copy)_6056145272653164546] = &apos;All&apos;&#10;   )&#10;  THEN SUM([no_vendors_actioned])&#10;&#10;//////////////////////// LEVEL 1 ////////////////////////&#10;// rule tye = any&#10;// is enabled = &apos;All&apos;&#10;// is real time = &apos;All&apos;&#10;// deployment type = &apos;All&apos;&#10;// close vendor = &apos;All&apos;&#10;// salesforce cases = &apos;All&apos;&#10;// send inbox = &apos;All&apos;&#10;ELSEIF ([Parameters].[Parameter 8] = [Parameters].[Parameter 8]&#10;        AND [Parameters].[Choose Rule Type (copy)_551690996833644557] = &apos;All&apos;&#10;        AND [Parameters].[Choose Rule Type (copy) (copy)_551690996833652750] = &apos;All&apos;&#10;        AND [Parameters].[Choose Rule Type (copy) (copy) (copy)_551690996833669135] = &apos;All&apos;&#10;        AND [Parameters].[Choose Is Realtime (copy)_6056145272653144064] = &apos;All&apos;&#10;        AND [Parameters].[Choose Is Realtime (copy) (copy)_6056145272653156353] = &apos;All&apos;&#10;        AND [Parameters].[Choose Is Realtime (copy) (copy) (copy)_6056145272653164546] = &apos;All&apos;&#10;       )&#10;