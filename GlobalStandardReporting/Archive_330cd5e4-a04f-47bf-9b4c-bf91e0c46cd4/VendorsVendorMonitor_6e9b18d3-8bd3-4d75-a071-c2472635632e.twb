            </column>
            <column caption='% Offline Duration - Availability Compliance rules' datatype='real' name='[% Updates in Menu Events - Client Online (copy)_3099743203094024203]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([monitor_rule_availability_duration]) / SUM([schedule_duration])' />
