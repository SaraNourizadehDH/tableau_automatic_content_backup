 (copy) (copy)_3099743203091996677]&#10;ELSEIF [Parameters].[Offline Metric Parameter (copy)_6959468821152006154] = &apos;.    % Offline Duration - Tech Problem&apos; THEN [% Offline Duration - Busy (copy)_1891582220818677775]&#10;ELSEIF [Parameters].[Offline Metric Parameter (copy)_6959468821152006154] = &apos;.    % Offline Duration - Updates in Menu&apos; THEN [% Offline Duration - Tech Problem (copy)_1891582220851888154]&#10;&#10;ELSEIF [Parameters].[Offline Metric Parameter (copy)_6959468821152006154] = &apos;.    % Offline Duration - Checkin&apos; THEN [% Offline Duration - Busy Checkin (copy) (copy)_1891582220811321350]&#10;ELSEIF [Parameters].[Offline Metric Parameter (copy)_6959468821152006154] = &apos;.    % Offline Duration - Churn&apos; THEN [% Offline Duration - Busy Checkin (copy) (copy) (copy)_1891582220811333639]&#10;ELSEIF [Parameters].[Offline Metric Parameter (copy)_6959468821152006154] = &apos;.    % Offline Duration - Courier Delayed&apos; THEN [% Offline Duration - Busy Checkin (copy) (copy) (copy) (copy) (copy)_1891582220811350025]&#10;ELSEIF [Parameters].[Offline Metric Parameter (copy)_6959468821152006154] = &apos;.    % Offline Duration - Monitor Rule&apos; THEN [% Offline Duration - Busy Checkin (copy) (copy) (copy) (copy) (copy) (copy)_1891582220811886602]&#10;ELSEIF [Parameters].[Offline Metric Parameter (copy)_6959468821152006154] = &apos;.    % Offline Duration - MUO&apos; THEN [% Offline Duration - Busy (copy)_1891582220812873741]&#10;&#10;ELSEIF [Parameters].[Offline Metric Parameter (copy)_6959468821152006154] = &apos;.    % Offline Duration - Order Failure Real-Time rules&apos; THEN [% Offline Duration - Updates in Menu (copy)_3099743203093012486]&#10;ELSEIF [Parameters].[Offline Metric Parameter (copy)_6959468821152006154] = &apos;.    % Offline Duration - Order Failure Compliance rules&apos; THEN [% Offline Duration - Updates in Menu (copy) (copy)_3099743203093024775]&#10;ELSEIF [Parameters].[Offline Metric Parameter (copy)_6959468821152006154] = &apos;.    % Offline Duration - Unreachable Compliance rules&apos; THEN [% Offline Duration - Updates in Menu (copy) (copy) (copy)_3099743203093041160]&#10;ELSEIF [Parameters].[Offline Metric Parameter (copy)_6959468821152006154] = &apos;.    % Offline Duration - Vendor Late Real-Time rules&apos; THEN [% Offline Duration - Updates in Menu (copy) (copy) (copy) (copy) (copy)_3099743203093069834]&#10;ELSEIF [Parameters].[Offline Metric Parameter (copy)_6959468821152006154] = &apos;.    % Offline Duration - Vendor Late Compliance rules&apos; THEN [% Offline Duration - Updates in Menu (copy) (copy) (copy) (copy)_3099743203093053449]&#10;ELSEIF [Parameters].[Offline Metric Parameter (copy)_6959468821152006154] = &apos;.    % Offline Duration - Availability Compliance rules&apos; THEN [% Updates in Menu Events - Client Online (copy)_3099743203094024203]&#10;&#10;END' />
