            </column>
            <column caption='Y-Right Metric Parameter - Vendors with Offline events' datatype='string' name='[Y-Right Metric Parameter - Offline Duration (copy)_3099743203202977837]' param-domain-type='list' role='measure' type='nominal' value='&quot;None&quot;'>
              <calculation class='tableau' formula='&quot;None&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1o6emvd1e0vajj15qj77a05sdpq1'>
            <column caption='% Vendors - Offline Duration events' datatype='real' name='[% Offline Duration (copy)_3099743203193679894]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_with_offline_events]) / SUM([vendors_with_schedule])' />
            </column>
            <column caption='% Vendors - Checkin events' datatype='real' name='[% Offline Duration - Checkin (copy)_3099743203193778202]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_with_checkin_events]) / SUM([vendors_with_schedule])' />
            </column>
            <column caption='% Vendors - Churn events' datatype='real' name='[% Offline Duration - Churn (copy)_3099743203193794587]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_with_churn_events]) / SUM([vendors_with_schedule])' />
            </column>
            <column caption='% Vendors - Client Reasons events' datatype='real' name='[% Offline Duration - Client Reasons (copy)_3099743203193806876]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_with_client_offline_events]) / SUM([vendors_with_schedule])' />
            </column>
            <column caption='% Vendors - Courier Delayed events' datatype='real' name='[% Offline Duration - Courier Delayed (copy)_3099743203193843742]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_with_courier_delayed_events]) / SUM([vendors_with_schedule])' />
            </column>
            <column caption='% Vendors - MUO events' datatype='real' name='[% Offline Duration - MUO (copy)_3099743203193962530]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_with_unreachable_events]) / SUM([vendors_with_schedule])' />
            </column>
            <column caption='% Vendors - Monitor Rule events' datatype='real' name='[% Offline Duration - Monitor Rule (copy)_3099743203193946145]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_with_monitor_rule_events]) / SUM([vendors_with_schedule])' />
