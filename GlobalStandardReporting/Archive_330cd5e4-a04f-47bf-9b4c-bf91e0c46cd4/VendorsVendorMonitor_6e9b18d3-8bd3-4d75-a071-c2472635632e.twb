          <datasource-dependencies datasource='federated.1o6emvd1e0vajj15qj77a05sdpq1'>
            <column caption='% Courier Delayed Offline Events Online By Client' datatype='real' name='[% Bad Weather Offline Events Online By Client (copy) (copy) (copy) (copy) (copy) (copy)_1485765688462639119]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([courier_delayed_events_online_by_client]) / SUM([courier_delayed_events])' />
            </column>
            <column caption='% Churn Events Online By Client' datatype='real' name='[% Bad Weather Offline Events Online By Client (copy) (copy) (copy) (copy) (copy)_1485765688462614542]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([churn_events_online_by_client]) / SUM([churn_events])' />
            </column>
            <column caption='% Checkin Events Online By Client' datatype='real' name='[% Bad Weather Offline Events Online By Client (copy) (copy) (copy) (copy)_1485765688462594061]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([checkin_events_online_by_client]) / SUM([checkin_events])' />
            </column>
            <column caption='% Updates in Menu Events Online By Client' datatype='real' name='[% Bad Weather Offline Events Online By Client (copy) (copy)_1485765688462549003]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([updates_in_menu_events_online_by_client]) / SUM([updates_in_menu_events])' />
