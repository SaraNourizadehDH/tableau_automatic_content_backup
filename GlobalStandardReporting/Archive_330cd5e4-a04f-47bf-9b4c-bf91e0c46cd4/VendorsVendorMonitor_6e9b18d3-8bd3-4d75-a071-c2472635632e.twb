    <worksheet name='Schedule_Vendors - Categories Vendors'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='10'>% Offline Duration Reasons</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='vendor_gsr_monitor_offline (rl)' name='federated.1o6emvd1e0vajj15qj77a05sdpq1' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
            <column caption='Y-Left Metric Parameter' datatype='string' name='[Y-Left Metric Parameter (copy)_3099743203065294848]' param-domain-type='list' role='measure' type='nominal' value='&quot;\# Schedule Duration (min)&quot;'>
              <calculation class='tableau' formula='&quot;# Schedule Duration (min)&quot;' />
            </column>
            <column caption='Y-Right Metric Parameter - Vendors with Offline events' datatype='string' name='[Y-Right Metric Parameter - Offline Duration (copy)_3099743203202977837]' param-domain-type='list' role='measure' type='nominal' value='&quot;None&quot;'>
              <calculation class='tableau' formula='&quot;None&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1o6emvd1e0vajj15qj77a05sdpq1'>
            <column caption='% Offline Duration - MUO' datatype='real' name='[% Offline Duration - Busy (copy)_1891582220812873741]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([unreachable_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - Special Day' datatype='real' name='[% Offline Duration - Busy (copy)_1891582220817903630]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([special_day_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - Client Reasons' datatype='real' name='[% Offline Duration - Busy (copy)_3099743203077566466]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([client_offline_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - Monitor Rule' datatype='real' name='[% Offline Duration - Busy Checkin (copy) (copy) (copy) (copy) (copy) (copy)_1891582220811886602]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([monitor_rule_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - Courier Delayed' datatype='real' name='[% Offline Duration - Busy Checkin (copy) (copy) (copy) (copy) (copy)_1891582220811350025]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([courier_delayed_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - Churn' datatype='real' name='[% Offline Duration - Busy Checkin (copy) (copy) (copy)_1891582220811333639]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([churn_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - Checkin' datatype='real' name='[% Offline Duration - Busy Checkin (copy) (copy)_1891582220811321350]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([checkin_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Vendors - Checkin events' datatype='real' name='[% Offline Duration - Checkin (copy)_3099743203193778202]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_with_checkin_events]) / SUM([vendors_with_schedule])' />
            </column>
            <column caption='% Vendors - Churn events' datatype='real' name='[% Offline Duration - Churn (copy)_3099743203193794587]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_with_churn_events]) / SUM([vendors_with_schedule])' />
            </column>
            <column caption='% Vendors - Client Reasons events' datatype='real' name='[% Offline Duration - Client Reasons (copy)_3099743203193806876]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_with_client_offline_events]) / SUM([vendors_with_schedule])' />
            </column>
            <column caption='% Vendors - Courier Delayed events' datatype='real' name='[% Offline Duration - Courier Delayed (copy)_3099743203193843742]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_with_courier_delayed_events]) / SUM([vendors_with_schedule])' />
            </column>
            <column caption='% Vendors - MUO events' datatype='real' name='[% Offline Duration - MUO (copy)_3099743203193962530]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_with_unreachable_events]) / SUM([vendors_with_schedule])' />
            </column>
            <column caption='% Vendors - Monitor Rule events' datatype='real' name='[% Offline Duration - Monitor Rule (copy)_3099743203193946145]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_with_monitor_rule_events]) / SUM([vendors_with_schedule])' />
            </column>
            <column caption='% Vendors - Special Day' datatype='real' name='[% Offline Duration - Special Day (copy)_3099743203194052647]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_with_special_day]) / SUM([vendors_with_schedule])' />
            </column>
            <column caption='Date Granularity' datatype='string' name='[Calculation_1891582220807041025]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&apos;Daily&apos; THEN STR([created_date])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Weekly&apos; THEN [created_week]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Monthly&apos; THEN [created_month]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Quarterly&apos; THEN STR(DATE(DATETRUNC(&apos;quarter&apos;,[created_date])))&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Yearly&apos; THEN STR([created_year])&#10;END' />
            </column>
            <column caption='Schedule Duration (min)' datatype='real' name='[Calculation_1891582220807364610]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([schedule_duration]) / 60, 0)' />
            </column>
            <column caption='_Exclude Today' datatype='boolean' name='[Calculation_949344769977401344]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[created_date] &lt; TODAY()' />
            </column>
            <column caption='Y-Left Metric - #' datatype='real' name='[Y-Left Metric (copy)_3099743203065524225]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Y-Left Metric Parameter (copy)_3099743203065294848] = &apos;# Schedule Duration (min)&apos; THEN [Calculation_1891582220807364610]&#10;ELSEIF [Parameters].[Y-Left Metric Parameter (copy)_3099743203065294848] = &apos;# Vendors with Schedules&apos; THEN SUM([vendors_with_schedule])&#10;END' />
            </column>
            <column caption='_Y-Left Display Sheet' datatype='string' name='[_Y-Right Offline Display Sheet (copy)_3099743203156873237]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Y-Left Metric Parameter (copy)_3099743203065294848]' />
            </column>
            <column caption='_Y-Right Vendors Display Sheet' datatype='string' name='[_Y-Right Offline Display Sheet (copy)_3099743203205070894]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Y-Right Metric Parameter - Offline Duration (copy)_3099743203202977837]' />
            </column>
            <column caption='Brand Name' datatype='string' name='[brand_name]' role='dimension' type='nominal' />
            <column caption='Checkin Duration' datatype='integer' name='[checkin_duration]' role='measure' type='quantitative' />
            <column caption='Churn Duration' datatype='integer' name='[churn_duration]' role='measure' type='quantitative' />
            <column caption='Client Offline Duration' datatype='integer' name='[client_offline_duration]' role='measure' type='quantitative' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Courier Delayed Duration' datatype='integer' name='[courier_delayed_duration]' role='measure' type='quantitative' />
            <column caption='Created Date' datatype='date' name='[created_date]' role='dimension' type='ordinal' />
            <column caption='Created Month' datatype='string' name='[created_month]' role='dimension' type='nominal' />
            <column caption='Created Week' datatype='string' name='[created_week]' role='dimension' type='nominal' />
            <column caption='Created Year' datatype='integer' name='[created_year]' role='dimension' type='quantitative' />
            <column caption='Has Any Order Last 28 Days' datatype='boolean' name='[has_orders_last_28_days_all]' role='dimension' type='nominal' />
            <column caption='Has Successful Orders Last 28 Days' datatype='boolean' name='[has_orders_last_28_days_successful]' role='dimension' type='nominal' />
            <column caption='Is Dormant Vendor' datatype='boolean' name='[is_dormant_vendor]' role='dimension' type='nominal' />
            <column caption='Is Inoperative Vendor' datatype='boolean' name='[is_inoperative_vendor]' role='dimension' type='nominal' />
            <column caption='Is New Vendor' datatype='boolean' name='[is_new_vendor]' role='dimension' type='nominal' />
