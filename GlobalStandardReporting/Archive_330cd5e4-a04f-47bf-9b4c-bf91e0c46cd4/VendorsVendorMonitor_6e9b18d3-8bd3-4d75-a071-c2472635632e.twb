            </column>
            <column caption='Y-Left Metric Parameter' datatype='string' name='[Y-Left Metric Parameter (copy)_3099743203065294848]' param-domain-type='list' role='measure' type='nominal' value='&quot;\# Schedule Duration (min)&quot;'>
              <calculation class='tableau' formula='&quot;# Schedule Duration (min)&quot;' />
            </column>
            <column caption='Y-Right Metric Parameter - Vendors with Offline events' datatype='string' name='[Y-Right Metric Parameter - Offline Duration (copy)_3099743203202977837]' param-domain-type='list' role='measure' type='nominal' value='&quot;None&quot;'>
              <calculation class='tableau' formula='&quot;None&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1o6emvd1e0vajj15qj77a05sdpq1'>
            <column caption='% Offline Duration - No Drivers' datatype='real' default-format='p0.00%' name='[% Offline Duration - Bad Weather (copy)_1600466734714085376]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([too_busy_no_drivers_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - MUO' datatype='real' name='[% Offline Duration - Busy (copy)_1891582220812873741]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([unreachable_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - Special Day' datatype='real' name='[% Offline Duration - Busy (copy)_1891582220817903630]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([special_day_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - Tech Problem' datatype='real' name='[% Offline Duration - Busy (copy)_1891582220818677775]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([tech_problem_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - Client Reasons' datatype='real' name='[% Offline Duration - Busy (copy)_3099743203077566466]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([client_offline_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - Other' datatype='real' name='[% Offline Duration - Busy Checkin (copy) (copy) (copy) (copy) (copy) (copy) (copy)_1891582220811894795]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([other_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - Monitor Rule' datatype='real' name='[% Offline Duration - Busy Checkin (copy) (copy) (copy) (copy) (copy) (copy)_1891582220811886602]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([monitor_rule_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - Courier Delayed' datatype='real' name='[% Offline Duration - Busy Checkin (copy) (copy) (copy) (copy) (copy)_1891582220811350025]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([courier_delayed_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - Closed' datatype='real' name='[% Offline Duration - Busy Checkin (copy) (copy) (copy) (copy)_1891582220811341832]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([closed_duration]) / SUM([schedule_duration])' />
            </column>
