    <worksheet name='Rules Tabular - Time Evolution %'>
      <table>
        <view>
          <datasources>
            <datasource caption='vendor_gsr_monitor_rules_vendor_level (rl)' name='federated.0st4yxp10t457319cj4j219w6hih' />
            <datasource caption='vendor_gsr_monitor_rules_hourly (rl)' name='federated.16pyb111i524rl1bl9ihr0bqasbj' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose Rule Dimension (A)' datatype='string' name='[Choose Issues Dimension (A) (copy)_2666693973167345669]' param-domain-type='list' role='measure' type='nominal' value='&quot;Region&quot;'>
              <calculation class='tableau' formula='&quot;Region&quot;' />
            </column>
            <column caption='Choose Rule Dimension (C)' datatype='string' name='[Choose Rule Dimension (A) (copy) (copy)_2666693973168357385]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column caption='Choose Rule Dimension (B)' datatype='string' name='[Choose Rule Dimension (A) (copy)_2666693973168332808]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country Name&quot;'>
              <calculation class='tableau' formula='&quot;Country Name&quot;' />
            </column>
            <column caption='Choose Rules Table Dimension' datatype='string' name='[Choose Time Dimension (copy)_2666693973184524311]' param-domain-type='list' role='measure' type='nominal' value='&quot;Agg. Metrics&quot;'>
              <calculation class='tableau' formula='&quot;Agg. Metrics&quot;' />
            </column>
            <column caption='Rules Metric Parameter' datatype='string' name='[Issues Metric Parameter (copy)_2666693973175271445]' param-domain-type='list' role='measure' type='nominal' value='&quot;\# Active Rules&quot;'>
              <calculation class='tableau' formula='&quot;# Active Rules&quot;' />
            </column>
            <column caption='Choose Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0st4yxp10t457319cj4j219w6hih'>
            <column caption='% ITEM_UNAVAILABLE Fail-Rate' datatype='real' name='[% UNREACHABLE Fail-Rate (copy) (copy 2)_4384606124875960326]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_orders_item_unavailable_ct]) / SUM([orders_ct])' />
            </column>
            <column caption='% CLOSED Fail-Rate' datatype='real' name='[% UNREACHABLE Fail-Rate (copy) (copy) (copy)_4384606124875939845]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_orders_closed_ct]) / SUM([orders_ct])' />
            </column>
            <column caption='% NO_RESPONSE Fail-Rate' datatype='real' name='[% UNREACHABLE Fail-Rate (copy) (copy)_4384606124875931652]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_orders_no_response_ct]) / SUM([orders_ct])' />
            </column>
            <column caption='% TOO_BUSY Fail-Rate' datatype='real' name='[% UNREACHABLE Fail-Rate (copy)_4384606124875919363]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_orders_too_busy_ct]) / SUM([orders_ct])' />
            </column>
            <column caption='% UNREACHABLE Fail-Rate' datatype='real' name='[% Vendor Fail Rate (copy)_4384606124874330114]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_orders_unreachable_ct]) / SUM([orders_ct])' />
            </column>
            <column caption='% Vendor Late &gt; 5' datatype='real' name='[% Vendor Fail-Rate (copy)_4384606124876312583]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_over_5_count]) / SUM([vendor_late_all_count])' />
            </column>
            <column caption='% Vendor Late &gt; 15' datatype='real' name='[% Vendor Late &gt; 5 (copy) (copy)_4384606124876443657]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_over_15_count]) / SUM([vendor_late_all_count])' />
            </column>
            <column caption='% Vendor Late &gt; 10' datatype='real' name='[% Vendor Late &gt; 5 (copy)_4384606124876431368]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_over_10_count]) / SUM([vendor_late_all_count])' />
            </column>
            <column caption='Dimension (A)' datatype='string' name='[Calculation_2666693973168885770]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Choose Issues Dimension (A) (copy)_2666693973167345669] = &apos;Region&apos; THEN [region] &#10;ELSEIF [Parameters].[Choose Issues Dimension (A) (copy)_2666693973167345669] = &apos;Brand Name&apos; THEN [brand_name]&#10;ELSEIF [Parameters].[Choose Issues Dimension (A) (copy)_2666693973167345669] = &apos;Country Name&apos; THEN [country_name] &#10;ELSEIF [Parameters].[Choose Issues Dimension (A) (copy)_2666693973167345669] = &apos;Rule Id&apos; THEN [rule_id]&#10;ELSEIF [Parameters].[Choose Issues Dimension (A) (copy)_2666693973167345669] = &apos;Rule Title&apos; THEN [title]&#10;ELSEIF [Parameters].[Choose Issues Dimension (A) (copy)_2666693973167345669] = &apos;Is Realtime&apos; THEN STR([is_realtime])&#10;ELSEIF [Parameters].[Choose Issues Dimension (A) (copy)_2666693973167345669] = &apos;Rule Type&apos; THEN [type]&#10;ELSEIF [Parameters].[Choose Issues Dimension (A) (copy)_2666693973167345669] = &apos;Deployment Type&apos; THEN [deployment_type]&#10;ELSEIF [Parameters].[Choose Issues Dimension (A) (copy)_2666693973167345669] = &apos;Close Vendor&apos; THEN STR([close_vendor])&#10;ELSEIF [Parameters].[Choose Issues Dimension (A) (copy)_2666693973167345669] = &apos;Salesforce Case&apos; THEN STR([salesforce_case])&#10;ELSEIF [Parameters].[Choose Issues Dimension (A) (copy)_2666693973167345669] = &apos;Inbox Message&apos; THEN STR([inbox_message])&#10;END' />
            </column>
            <column caption='Date Granularity' datatype='string' name='[Calculation_2666693973171965967]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&apos;Daily&apos; THEN STR([created_date])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Weekly&apos; THEN [created_week]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Monthly&apos; THEN [created_month]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Quarterly&apos; THEN STR(DATE(DATETRUNC(&apos;quarter&apos;,[created_date])))&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Yearly&apos; THEN STR([created_year])&#10;END' />
            </column>
            <column caption='Active Rules' datatype='integer' name='[Calculation_2666693973173510160]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    IF [is_enabled] = True&#10;     THEN ([country_iso] + [rule_id])&#10;    ELSE NULL&#10;    END&#10;)' />
            </column>
            <column caption='Vendors Detected' datatype='integer' name='[Calculation_2666693973174366226]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    IF [no_issues] &gt; 0&#10;     THEN ([country_iso] + [rule_id] + [vendor_code])&#10;    ELSE NULL&#10;    END&#10;)' />
            </column>
            <column caption='Rules Metrics' datatype='real' name='[Calculation_2666693973175795734]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Issues Metric Parameter (copy)_2666693973175271445] = &apos;# Active Rules&apos; THEN [Calculation_2666693973173510160]&#10;ELSEIF [Parameters].[Issues Metric Parameter (copy)_2666693973175271445] = &apos;# Vendors Detected&apos; THEN [Calculation_2666693973174366226]&#10;ELSEIF [Parameters].[Issues Metric Parameter (copy)_2666693973175271445] = &apos;# Vendors Actioned&apos; THEN [Vendors Detected (copy)_2666693973174685715]&#10;ELSEIF [Parameters].[Issues Metric Parameter (copy)_2666693973175271445] = &apos;% Vendor Fail-Rate&apos; THEN [Calculation_4384606124873138177]&#10;ELSEIF [Parameters].[Issues Metric Parameter (copy)_2666693973175271445] = &apos;.   % UNREACHABLE Fail-Rate&apos; THEN [% Vendor Fail Rate (copy)_4384606124874330114]&#10;ELSEIF [Parameters].[Issues Metric Parameter (copy)_2666693973175271445] = &apos;.   % TOO_BUSY Fail-Rate&apos; THEN [% UNREACHABLE Fail-Rate (copy)_4384606124875919363]&#10;ELSEIF [Parameters].[Issues Metric Parameter (copy)_2666693973175271445] = &apos;.   % ITEM_UNAVAILABLE Fail-Rate&apos; THEN [% UNREACHABLE Fail-Rate (copy) (copy 2)_4384606124875960326]&#10;ELSEIF [Parameters].[Issues Metric Parameter (copy)_2666693973175271445] = &apos;.   % NO_RESPONSE Fail-Rate&apos; THEN [% UNREACHABLE Fail-Rate (copy) (copy)_4384606124875931652]&#10;ELSEIF [Parameters].[Issues Metric Parameter (copy)_2666693973175271445] = &apos;.   % CLOSED Fail-Rate&apos; THEN [% UNREACHABLE Fail-Rate (copy) (copy) (copy)_4384606124875939845]&#10;ELSEIF [Parameters].[Issues Metric Parameter (copy)_2666693973175271445] = &apos;% Vendor Late &gt; 5&apos; THEN [% Vendor Fail-Rate (copy)_4384606124876312583]&#10;ELSEIF [Parameters].[Issues Metric Parameter (copy)_2666693973175271445] = &apos;% Vendor Late &gt; 10&apos; THEN [% Vendor Late &gt; 5 (copy)_4384606124876431368]&#10;ELSEIF [Parameters].[Issues Metric Parameter (copy)_2666693973175271445] = &apos;% Vendor Late &gt; 15&apos; THEN [% Vendor Late &gt; 5 (copy) (copy)_4384606124876443657]&#10;END' />
            </column>
            <column caption='_Rule Table Display Sheet' datatype='string' name='[Calculation_2666693973185114136]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Choose Time Dimension (copy)_2666693973184524311]' />
            </column>
            <column caption='% Vendor Fail-Rate' datatype='real' name='[Calculation_4384606124873138177]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_orders_vendor_ct]) / SUM([orders_ct])' />
