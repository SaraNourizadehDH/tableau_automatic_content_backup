              <calculation class='tableau' formula='SUM([vendors_with_monitor_rule_vendor_late_events]) / SUM([vendors_with_schedule])' />
            </column>
            <column caption='% Vendors - Vendor Late Real-Time rules events' datatype='real' name='[% Offline Duration - Vendor Late Real-Time rules (copy)_3099743203194150956]' role='measure' type='quantitative'>
