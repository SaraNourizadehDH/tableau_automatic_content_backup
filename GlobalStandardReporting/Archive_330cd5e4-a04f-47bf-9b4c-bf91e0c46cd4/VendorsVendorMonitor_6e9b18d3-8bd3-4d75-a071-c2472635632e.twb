    <worksheet name='Schedule_Vendors - Categories Client Reasons Vendors'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='10'>% Offline Duration Reasons</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='vendor_gsr_monitor_offline (rl)' name='federated.1o6emvd1e0vajj15qj77a05sdpq1' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
            <column caption='Y-Left Metric Parameter' datatype='string' name='[Y-Left Metric Parameter (copy)_3099743203065294848]' param-domain-type='list' role='measure' type='nominal' value='&quot;\# Schedule Duration (min)&quot;'>
              <calculation class='tableau' formula='&quot;# Schedule Duration (min)&quot;' />
            </column>
            <column caption='Y-Right Metric Parameter - Vendors with Offline events' datatype='string' name='[Y-Right Metric Parameter - Offline Duration (copy)_3099743203202977837]' param-domain-type='list' role='measure' type='nominal' value='&quot;None&quot;'>
              <calculation class='tableau' formula='&quot;None&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1o6emvd1e0vajj15qj77a05sdpq1'>
            <column caption='% Vendors - Bad Weather events' datatype='real' name='[% Offline Duration - Bad Weather (copy)_3099743203193741336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_with_bad_weather_events]) / SUM([vendors_with_schedule])' />
            </column>
            <column caption='% Vendors - Busy events' datatype='real' name='[% Offline Duration - Busy (copy)_3099743203193757721]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_with_busy_events]) / SUM([vendors_with_schedule])' />
            </column>
            <column caption='% Vendors - Closed events' datatype='real' name='[% Offline Duration - Closed (copy)_3099743203193827357]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_with_closed_events]) / SUM([vendors_with_schedule])' />
            </column>
            <column caption='% Vendors - Holiday events' datatype='real' name='[% Offline Duration - Holiday (copy)_3099743203193917471]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_with_holiday_events]) / SUM([vendors_with_schedule])' />
            </column>
            <column caption='% Vendors - Other events' datatype='real' name='[% Offline Duration - Other (copy)_3099743203194019877]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_with_other_events]) / SUM([vendors_with_schedule])' />
            </column>
            <column caption='% Vendors - Refurbishment events' datatype='real' name='[% Offline Duration - Refurbishment (copy)_3099743203194036262]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_with_refurbishment_events]) / SUM([vendors_with_schedule])' />
            </column>
            <column caption='% Vendors - Tech Problem events' datatype='real' name='[% Offline Duration - Tech Problem (copy)_3099743203194073128]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_with_tech_problem_events]) / SUM([vendors_with_schedule])' />
            </column>
            <column caption='% Vendors - Updates in Menu events' datatype='real' name='[% Offline Duration - Updates in Menu (copy)_3099743203194114090]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_with_updates_in_menu_events]) / SUM([vendors_with_schedule])' />
            </column>
            <column caption='Date Granularity' datatype='string' name='[Calculation_1891582220807041025]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&apos;Daily&apos; THEN STR([created_date])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Weekly&apos; THEN [created_week]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Monthly&apos; THEN [created_month]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Quarterly&apos; THEN STR(DATE(DATETRUNC(&apos;quarter&apos;,[created_date])))&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Yearly&apos; THEN STR([created_year])&#10;END' />
            </column>
            <column caption='Schedule Duration (min)' datatype='real' name='[Calculation_1891582220807364610]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([schedule_duration]) / 60, 0)' />
            </column>
            <column caption='_Exclude Today' datatype='boolean' name='[Calculation_949344769977401344]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[created_date] &lt; TODAY()' />
            </column>
            <column caption='Y-Left Metric - #' datatype='real' name='[Y-Left Metric (copy)_3099743203065524225]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Y-Left Metric Parameter (copy)_3099743203065294848] = &apos;# Schedule Duration (min)&apos; THEN [Calculation_1891582220807364610]&#10;ELSEIF [Parameters].[Y-Left Metric Parameter (copy)_3099743203065294848] = &apos;# Vendors with Schedules&apos; THEN SUM([vendors_with_schedule])&#10;END' />
            </column>
            <column caption='_Y-Left Display Sheet' datatype='string' name='[_Y-Right Offline Display Sheet (copy)_3099743203156873237]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Y-Left Metric Parameter (copy)_3099743203065294848]' />
            </column>
            <column caption='_Y-Right Vendors Display Sheet' datatype='string' name='[_Y-Right Offline Display Sheet (copy)_3099743203205070894]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Y-Right Metric Parameter - Offline Duration (copy)_3099743203202977837]' />
            </column>
