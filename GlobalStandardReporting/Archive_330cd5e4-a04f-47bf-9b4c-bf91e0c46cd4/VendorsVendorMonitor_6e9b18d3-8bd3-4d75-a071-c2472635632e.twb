            <column caption='Is New Vendor' datatype='boolean' name='[is_new_vendor]' role='dimension' type='nominal' />
            <column caption='Is Unengaged Vendor' datatype='boolean' name='[is_unengaged_vendor]' role='dimension' type='nominal' />
