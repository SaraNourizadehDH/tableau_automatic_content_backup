          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose Offline Dimension (A)' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Region&quot;'>
              <calculation class='tableau' formula='&quot;Region&quot;' />
            </column>
            <column caption='Choose Offline Dimension (B)' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country Name&quot;'>
              <calculation class='tableau' formula='&quot;Country Name&quot;' />
            </column>
            <column caption='Offline Tabular Dimension Parameter' datatype='string' name='[Parameter 7]' param-domain-type='list' role='measure' type='nominal' value='&quot;Time Dimension&quot;'>
              <calculation class='tableau' formula='&quot;Time Dimension&quot;' />
            </column>
            <column caption='Y-Right Metric Parameter - Vendors with Offline events' datatype='string' name='[Y-Right Metric Parameter - Offline Duration (copy)_3099743203202977837]' param-domain-type='list' role='measure' type='nominal' value='&quot;None&quot;'>
              <calculation class='tableau' formula='&quot;None&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1o6emvd1e0vajj15qj77a05sdpq1'>
            <column caption='% Offline Duration - MUO' datatype='real' name='[% Offline Duration - Busy (copy)_1891582220812873741]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([unreachable_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - Special Day' datatype='real' name='[% Offline Duration - Busy (copy)_1891582220817903630]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([special_day_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - Client Reasons' datatype='real' name='[% Offline Duration - Busy (copy)_3099743203077566466]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([client_offline_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - Monitor Rule' datatype='real' name='[% Offline Duration - Busy Checkin (copy) (copy) (copy) (copy) (copy) (copy)_1891582220811886602]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([monitor_rule_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - Courier Delayed' datatype='real' name='[% Offline Duration - Busy Checkin (copy) (copy) (copy) (copy) (copy)_1891582220811350025]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([courier_delayed_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - Churn' datatype='real' name='[% Offline Duration - Busy Checkin (copy) (copy) (copy)_1891582220811333639]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([churn_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - Checkin' datatype='real' name='[% Offline Duration - Busy Checkin (copy) (copy)_1891582220811321350]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([checkin_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='Schedule Duration (min)' datatype='real' name='[Calculation_1891582220807364610]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([schedule_duration]) / 60, 0)' />
            </column>
            <column caption='% Offline Duration' datatype='real' name='[Calculation_1891582220810272771]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([offline_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='Dimension (A)' datatype='string' name='[Calculation_1891582221181055015]' role='dimension' type='nominal'>
