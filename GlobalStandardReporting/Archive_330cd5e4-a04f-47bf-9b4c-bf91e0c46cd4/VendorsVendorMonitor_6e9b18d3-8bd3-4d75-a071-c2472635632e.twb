        <column caption='Rule Dimension' datatype='string' name='[Calculation_6056145273542254598]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [Parameters].[Parameter 9] = &apos;All&apos; THEN &apos;&apos; &#10;ELSEIF [Parameters].[Parameter 9] = &apos;Rule Type&apos; THEN [type]&#10;ELSEIF [Parameters].[Parameter 9] = &apos;Is Realtime&apos; THEN STR([is_realtime])&#10;ELSEIF [Parameters].[Parameter 9] = &apos;Deployment Time&apos; THEN [deployment_type]&#10;ELSEIF [Parameters].[Parameter 9] = &apos;Close Vendor&apos; THEN STR([close_vendor])&#10;ELSEIF [Parameters].[Parameter 9] = &apos;Create Salesforce Case&apos; THEN STR([salesforce_case])&#10;ELSEIF [Parameters].[Parameter 9] = &apos;Send Inbox Message&apos; THEN STR([inbox_message])&#10;ELSEIF [Parameters].[Parameter 9] = &apos;Recurrent Vendors Actions (past 28 days)&apos; THEN STR([same_action_prev_weeks]) &#10;END' />
          <aliases>
            <alias key='&quot;&quot;' value='All' />
            <alias key='&quot;0&quot;' value='no fails in previous 4 weeks' />
            <alias key='&quot;1&quot;' value='failed in 1 of 4 previous weeks' />
            <alias key='&quot;2&quot;' value='failed in 2 of 4 previous weeks' />
            <alias key='&quot;3&quot;' value='failed in 3 of 4 previous weeks' />
            <alias key='&quot;4&quot;' value='failed in 4 of 4 previous weeks' />
          </aliases>
