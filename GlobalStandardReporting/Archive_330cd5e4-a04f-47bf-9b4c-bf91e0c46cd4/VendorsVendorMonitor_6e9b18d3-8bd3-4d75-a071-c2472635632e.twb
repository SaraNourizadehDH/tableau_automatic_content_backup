              <calculation class='tableau' formula='SUM([vendors_with_monitor_rule_order_failure_events]) / SUM([vendors_with_schedule])' />
            </column>
            <column caption='% Vendors - Order Failure Real-Time rules events' datatype='real' name='[% Offline Duration - Order Failure Real-Time rules (copy)_3099743203194007588]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_with_monitor_rule_order_failure_realtime_events]) / SUM([vendors_with_schedule])' />
            </column>
