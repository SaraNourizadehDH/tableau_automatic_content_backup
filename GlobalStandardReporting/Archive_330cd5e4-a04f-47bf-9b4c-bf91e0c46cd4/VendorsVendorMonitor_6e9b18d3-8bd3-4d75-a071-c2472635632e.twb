    <worksheet name='Offline Metrics - % Duration Vendors - Monitor Rule Categories'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='10'>% Offline Duration Reasons</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='vendor_gsr_monitor_offline (rl)' name='federated.1o6emvd1e0vajj15qj77a05sdpq1' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose Offline Dimension (A)' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Region&quot;'>
              <calculation class='tableau' formula='&quot;Region&quot;' />
            </column>
            <column caption='Choose Offline Dimension (B)' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country Name&quot;'>
              <calculation class='tableau' formula='&quot;Country Name&quot;' />
            </column>
            <column caption='Offline Tabular Dimension Parameter' datatype='string' name='[Parameter 7]' param-domain-type='list' role='measure' type='nominal' value='&quot;Time Dimension&quot;'>
              <calculation class='tableau' formula='&quot;Time Dimension&quot;' />
            </column>
            <column caption='Y-Right Metric Parameter - Vendors with Offline events' datatype='string' name='[Y-Right Metric Parameter - Offline Duration (copy)_3099743203202977837]' param-domain-type='list' role='measure' type='nominal' value='&quot;None&quot;'>
              <calculation class='tableau' formula='&quot;None&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1o6emvd1e0vajj15qj77a05sdpq1'>
            <column caption='% Vendors - Offline Duration events' datatype='real' name='[% Offline Duration (copy)_3099743203193679894]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_with_offline_events]) / SUM([vendors_with_schedule])' />
            </column>
            <column caption='% Vendors - Availability Compliance rules events' datatype='real' name='[% Offline Duration - Availability Compliance rules (copy)_3099743203193712663]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_with_monitor_rule_availability_events]) / SUM([vendors_with_schedule])' />
            </column>
            <column caption='% Vendors - Order Failure Compliance rules events' datatype='real' name='[% Offline Duration - Order Failure Compliance rules (copy)_3099743203193987107]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_with_monitor_rule_order_failure_events]) / SUM([vendors_with_schedule])' />
            </column>
            <column caption='% Vendors - Order Failure Real-Time rules events' datatype='real' name='[% Offline Duration - Order Failure Real-Time rules (copy)_3099743203194007588]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_with_monitor_rule_order_failure_realtime_events]) / SUM([vendors_with_schedule])' />
            </column>
            <column caption='% Vendors - Unreachable Compliance rules events' datatype='real' name='[% Offline Duration - Unreachable Compliance rules (copy)_3099743203194097705]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_with_monitor_rule_unreachable_events]) / SUM([vendors_with_schedule])' />
            </column>
            <column caption='% Vendors - Vendor Late Compliance rules events' datatype='real' name='[% Offline Duration - Vendor Late Compliance rules (copy)_3099743203194134571]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_with_monitor_rule_vendor_late_events]) / SUM([vendors_with_schedule])' />
            </column>
            <column caption='% Vendors - Vendor Late Real-Time rules events' datatype='real' name='[% Offline Duration - Vendor Late Real-Time rules (copy)_3099743203194150956]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_with_monitor_rule_vendor_late_realtime_events]) / SUM([vendors_with_schedule])' />
            </column>
            <column caption='Dimension (A)' datatype='string' name='[Calculation_1891582221181055015]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Region&apos; THEN [region]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Brand Name&apos; THEN [brand_name]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Country Name&apos; THEN [country_name]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Vertical Type&apos; THEN [vertical_type]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Vendor Grade&apos; THEN [vendor_grade]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Transmission Flow&apos; THEN [transmission_flow]&#10;END' />
            </column>
            <column caption='_Offline Table Display Sheet' datatype='string' name='[Calculation_360850943926923264]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 7]' />
            </column>
            <column caption='_Exclude Today' datatype='boolean' name='[Calculation_949344769977401344]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[created_date] &lt; TODAY()' />
            </column>
            <column caption='Dimension (B)' datatype='string' name='[Offline Dimension (A) (copy)_1891582221181382696]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;All&apos; THEN &apos;&apos;&#10;ELSEIF  [Parameters].[Parameter 5] = &apos;Region&apos; THEN [region]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Brand Name&apos; THEN [brand_name]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Country Name&apos; THEN [country_name]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Vertical Type&apos; THEN [vertical_type]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Vendor Grade&apos; THEN [vendor_grade]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Transmission Flow&apos; THEN [transmission_flow]&#10;END' />
            </column>
            <column caption='_Y-Right Vendors Display Sheet' datatype='string' name='[_Y-Right Offline Display Sheet (copy)_3099743203205070894]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Y-Right Metric Parameter - Offline Duration (copy)_3099743203202977837]' />
            </column>
            <column caption='Brand Name' datatype='string' name='[brand_name]' role='dimension' type='nominal' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
