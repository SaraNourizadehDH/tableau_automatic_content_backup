              <calculation class='tableau' formula='SUM([client_offline_events_online_by_client]) / SUM([client_offline_events])' />
            </column>
            <column caption='% Offline Events Online By Client' datatype='real' name='[Calculation_1485765688460652546]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([offline_events_online_by_client]) / SUM([offline_events])' />
            </column>
            <column caption='Date Granularity' datatype='string' name='[Calculation_1891582220807041025]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&apos;Daily&apos; THEN STR([created_date])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Weekly&apos; THEN [created_week]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Monthly&apos; THEN [created_month]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Quarterly&apos; THEN STR(DATE(DATETRUNC(&apos;quarter&apos;,[created_date])))&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Yearly&apos; THEN STR([created_year])&#10;END' />
            </column>
            <column caption='_Exclude Today' datatype='boolean' name='[Calculation_949344769977401344]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[created_date] &lt; TODAY()' />
