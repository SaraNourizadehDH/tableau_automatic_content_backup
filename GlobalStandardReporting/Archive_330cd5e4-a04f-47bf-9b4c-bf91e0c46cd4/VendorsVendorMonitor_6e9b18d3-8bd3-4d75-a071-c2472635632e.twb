            <column caption='Unique Vendor' datatype='string' name='[Calculation_2666693972978118658]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='([entity_id]&#10; + [vendor_code]&#10;)' />
            </column>
            <column caption='Issues Dates' datatype='integer' name='[Calculation_6061282192738836480]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='{FIXED [Calculation_2666693972978118658]&#10;       , [is_realtime]&#10;       , [type]&#10;       , [close_vendor]&#10;       , [salesforce_case]&#10;       , [inbox_message]&#10;       , [rule_id]&#10;       , [title] : COUNTD([issue_created_date])}' />
