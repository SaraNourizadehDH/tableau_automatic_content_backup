      <table>
        <view>
          <datasources>
            <datasource caption='vendor_gsr_monitor_offline (rl)' name='federated.1o6emvd1e0vajj15qj77a05sdpq1' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose MUO Dimension (A)' datatype='string' name='[Choose Overview Dimension (A) (copy)_1891582221218406444]' param-domain-type='list' role='measure' type='nominal' value='&quot;Region&quot;'>
              <calculation class='tableau' formula='&quot;Region&quot;' />
            </column>
            <column caption='Choose MUO Dimension (B)' datatype='string' name='[Choose Overview Dimension (B) (copy)_1891582221218422829]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country Name&quot;'>
              <calculation class='tableau' formula='&quot;Country Name&quot;' />
            </column>
            <column caption='Choose Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
            <column caption='MUO Metric Parameter' datatype='string' name='[Vendor Monitor Metric Parameter (copy)_949344770093748243]' param-domain-type='list' role='measure' type='nominal' value='&quot;\# Schedule Duration (min)&quot;'>
              <calculation class='tableau' formula='&quot;# Schedule Duration (min)&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1o6emvd1e0vajj15qj77a05sdpq1'>
            <column caption='% Offline Duration - MUO' datatype='real' name='[% Offline Duration - Busy (copy)_1891582220812873741]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([unreachable_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% MUO Events end of slot' datatype='real' name='[% Unreachable Events 5min (copy) (copy) (copy) (copy) (copy)_949344770089754642]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([unreachable_events_end_of_slot]) / SUM([unreachable_events])' />
            </column>
            <column caption='% MUO Events 120min' datatype='real' name='[% Unreachable Events 5min (copy) (copy) (copy) (copy)_949344770089742353]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([unreachable_events_120min]) / SUM([unreachable_events])' />
            </column>
            <column caption='% MUO Events 60min' datatype='real' name='[% Unreachable Events 5min (copy) (copy) (copy)_949344770089730064]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([unreachable_events_60min]) / SUM([unreachable_events])' />
            </column>
            <column caption='% MUO Events 30min' datatype='real' name='[% Unreachable Events 5min (copy) (copy)_949344770089713679]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([unreachable_events_30min]) / SUM([unreachable_events])' />
            </column>
            <column caption='% MUO Events 15min' datatype='real' name='[% Unreachable Events 5min (copy)_949344770089701390]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([unreachable_events_15min]) / SUM([unreachable_events])' />
            </column>
            <column caption='% Vendors with over 10 MUO events' datatype='real' name='[% Vendors with 1 unreachable event (copy) (copy) (copy) (copy)_949344770086649868]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_over_10_unreachable_events]) / SUM([vendors_with_unreachable_events])' />
            </column>
            <column caption='% Vendors with 6 to 10 MUO events' datatype='real' name='[% Vendors with 1 unreachable event (copy) (copy) (copy)_949344770086637579]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_with_10_unreachable_events]) / SUM([vendors_with_unreachable_events])' />
            </column>
            <column caption='% Vendors with 3 to 5 MUO events' datatype='real' name='[% Vendors with 1 unreachable event (copy) (copy)_949344770086621194]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_with_5_unreachable_events]) / SUM([vendors_with_unreachable_events])' />
            </column>
            <column caption='% Vendors with 2 MUO events' datatype='real' name='[% Vendors with 1 unreachable event (copy)_949344770086604809]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_with_2_unreachable_events]) / SUM([vendors_with_unreachable_events])' />
            </column>
            <column caption='Date Granularity' datatype='string' name='[Calculation_1891582220807041025]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&apos;Daily&apos; THEN STR([created_date])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Weekly&apos; THEN [created_week]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Monthly&apos; THEN [created_month]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Quarterly&apos; THEN STR(DATE(DATETRUNC(&apos;quarter&apos;,[created_date])))&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Yearly&apos; THEN STR([created_year])&#10;END' />
            </column>
            <column caption='Schedule Duration (min)' datatype='real' name='[Calculation_1891582220807364610]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([schedule_duration]) / 60, 0)' />
            </column>
            <column caption='MUO Duration (min)' datatype='real' name='[Calculation_6959468820965081096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([unreachable_duration]) / 60' />
            </column>
            <column caption='_Exclude Today' datatype='boolean' name='[Calculation_949344769977401344]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[created_date] &lt; TODAY()' />
            </column>
            <column caption='% Vendors with 1 MUO event' datatype='real' name='[Calculation_949344770086408200]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_with_1_unreachable_events]) / SUM([vendors_with_unreachable_events])' />
            </column>
            <column caption='% MUO Events 5min' datatype='real' name='[Calculation_949344770089517069]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([unreachable_events_5min]) / SUM([unreachable_events])' />
            </column>
