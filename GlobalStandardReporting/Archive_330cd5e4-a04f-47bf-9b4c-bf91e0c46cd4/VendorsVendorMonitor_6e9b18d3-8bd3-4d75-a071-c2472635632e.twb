      <column caption='% Offline Events Online By Client' datatype='real' name='[Calculation_1485765688460652546]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([offline_events_online_by_client]) / SUM([offline_events])' />
      </column>
      <column caption='_placeholder' datatype='string' name='[Calculation_181762492613369856]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos; &apos;' />
      </column>
      <column caption='Date Granularity' datatype='string' name='[Calculation_1891582220807041025]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&apos;Daily&apos; THEN STR([created_date])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Weekly&apos; THEN [created_week]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Monthly&apos; THEN [created_month]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Quarterly&apos; THEN STR(DATE(DATETRUNC(&apos;quarter&apos;,[created_date])))&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Yearly&apos; THEN STR([created_year])&#10;END' />
      </column>
      <column caption='Schedule Duration (min)' datatype='real' name='[Calculation_1891582220807364610]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([schedule_duration]) / 60, 0)' />
      </column>
      <column caption='% Offline Duration' datatype='real' name='[Calculation_1891582220810272771]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([offline_duration]) / SUM([schedule_duration])' />
      </column>
      <column caption='Dimension (A)' datatype='string' name='[Calculation_1891582221181055015]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Region&apos; THEN [region]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Brand Name&apos; THEN [brand_name]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Country Name&apos; THEN [country_name]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Vertical Type&apos; THEN [vertical_type]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Vendor Grade&apos; THEN [vendor_grade]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Transmission Flow&apos; THEN [transmission_flow]&#10;END' />
      </column>
      <column caption='% Vendor Fail-Rate' datatype='real' name='[Calculation_3099743203153358862]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([no_fail_orders_vendor]) / SUM([no_orders])' />
      </column>
      <column caption='_Offline Table Display Sheet' datatype='string' name='[Calculation_360850943926923264]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 7]' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_4628996749257883648]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='MUO Duration (min)' datatype='real' name='[Calculation_6959468820965081096]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([unreachable_duration]) / 60' />
      </column>
      <column caption='_Exclude Today' datatype='boolean' name='[Calculation_949344769977401344]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[created_date] &lt; TODAY()' />
      </column>
      <column caption='% Vendors with 1 MUO event' datatype='real' name='[Calculation_949344770086408200]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendors_with_1_unreachable_events]) / SUM([vendors_with_unreachable_events])' />
      </column>
      <column caption='% MUO Events 5min' datatype='real' name='[Calculation_949344770089517069]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([unreachable_events_5min]) / SUM([unreachable_events])' />
      </column>
      <column caption='MUO Metrics' datatype='real' name='[Calculation_949344770097569812]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IF [Parameters].[Vendor Monitor Metric Parameter (copy)_949344770093748243] = &apos;# Schedule Duration (min)&apos; THEN [Calculation_1891582220807364610]&#10;ELSEIF [Parameters].[Vendor Monitor Metric Parameter (copy)_949344770093748243] = &apos;# MUO Duration (min)&apos; THEN [Calculation_6959468820965081096]&#10;ELSEIF [Parameters].[Vendor Monitor Metric Parameter (copy)_949344770093748243] = &apos;% MUO Duration&apos; THEN [% Offline Duration - Busy (copy)_1891582220812873741]&#10;ELSEIF [Parameters].[Vendor Monitor Metric Parameter (copy)_949344770093748243] = &apos;# Vendors with MUO events&apos; THEN SUM([vendors_with_unreachable_events])&#10;ELSEIF [Parameters].[Vendor Monitor Metric Parameter (copy)_949344770093748243] = &apos;# Vendors with 1 MUO event&apos; THEN SUM([vendors_with_1_unreachable_events])&#10;ELSEIF [Parameters].[Vendor Monitor Metric Parameter (copy)_949344770093748243] = &apos;# Vendors with 2 MUO events&apos; THEN SUM([vendors_with_2_unreachable_events])&#10;ELSEIF [Parameters].[Vendor Monitor Metric Parameter (copy)_949344770093748243] = &apos;# Vendors with 3 to 5 MUO events&apos; THEN SUM([vendors_with_5_unreachable_events])&#10;ELSEIF [Parameters].[Vendor Monitor Metric Parameter (copy)_949344770093748243] = &apos;# Vendors with 6 to 10 MUO events&apos; THEN SUM([vendors_with_10_unreachable_events])&#10;ELSEIF [Parameters].[Vendor Monitor Metric Parameter (copy)_949344770093748243] = &apos;# Vendors with over 10 MUO events&apos; THEN SUM([vendors_over_10_unreachable_events])&#10;ELSEIF [Parameters].[Vendor Monitor Metric Parameter (copy)_949344770093748243] = &apos;% Vendors with 1 MUO event&apos; THEN [Calculation_949344770086408200]&#10;ELSEIF [Parameters].[Vendor Monitor Metric Parameter (copy)_949344770093748243] = &apos;% Vendors with 2 MUO events&apos; THEN [% Vendors with 1 unreachable event (copy)_949344770086604809]&#10;ELSEIF [Parameters].[Vendor Monitor Metric Parameter (copy)_949344770093748243] = &apos;% Vendors with 3 to 5 MUO events&apos; THEN [% Vendors with 1 unreachable event (copy) (copy)_949344770086621194]&#10;ELSEIF [Parameters].[Vendor Monitor Metric Parameter (copy)_949344770093748243] = &apos;% Vendors with 6 to 10 MUO events&apos; THEN [% Vendors with 1 unreachable event (copy) (copy) (copy)_949344770086637579]&#10;ELSEIF [Parameters].[Vendor Monitor Metric Parameter (copy)_949344770093748243] = &apos;% Vendors with over 10 MUO events&apos; THEN [% Vendors with 1 unreachable event (copy) (copy) (copy) (copy)_949344770086649868]&#10;&#10;ELSEIF [Parameters].[Vendor Monitor Metric Parameter (copy)_949344770093748243] = &apos;# MUO events&apos; THEN SUM([unreachable_events])&#10;ELSEIF [Parameters].[Vendor Monitor Metric Parameter (copy)_949344770093748243] = &apos;# MUO events 5min&apos; THEN SUM([unreachable_events_5min])&#10;ELSEIF [Parameters].[Vendor Monitor Metric Parameter (copy)_949344770093748243] = &apos;# MUO events 15min&apos; THEN SUM([unreachable_events_15min])&#10;ELSEIF [Parameters].[Vendor Monitor Metric Parameter (copy)_949344770093748243] = &apos;# MUO events 30min&apos; THEN SUM([unreachable_events_30min])&#10;ELSEIF [Parameters].[Vendor Monitor Metric Parameter (copy)_949344770093748243] = &apos;# MUO events 60min&apos; THEN SUM([unreachable_events_60min])&#10;ELSEIF [Parameters].[Vendor Monitor Metric Parameter (copy)_949344770093748243] = &apos;# MUO events 120min&apos; THEN SUM([unreachable_events_120min])&#10;ELSEIF [Parameters].[Vendor Monitor Metric Parameter (copy)_949344770093748243] = &apos;# MUO events end of slot&apos; THEN SUM([unreachable_events_end_of_slot])&#10;ELSEIF [Parameters].[Vendor Monitor Metric Parameter (copy)_949344770093748243] = &apos;% MUO events 5min&apos; THEN [Calculation_949344770089517069]&#10;ELSEIF [Parameters].[Vendor Monitor Metric Parameter (copy)_949344770093748243] = &apos;% MUO events 15min&apos; THEN [% Unreachable Events 5min (copy)_949344770089701390]&#10;ELSEIF [Parameters].[Vendor Monitor Metric Parameter (copy)_949344770093748243] = &apos;% MUO events 30min&apos; THEN [% Unreachable Events 5min (copy) (copy)_949344770089713679]&#10;ELSEIF [Parameters].[Vendor Monitor Metric Parameter (copy)_949344770093748243] = &apos;% MUO events 60min&apos; THEN [% Unreachable Events 5min (copy) (copy) (copy)_949344770089730064]&#10;ELSEIF [Parameters].[Vendor Monitor Metric Parameter (copy)_949344770093748243] = &apos;% MUO events 120min&apos; THEN [% Unreachable Events 5min (copy) (copy) (copy) (copy)_949344770089742353]&#10;ELSEIF [Parameters].[Vendor Monitor Metric Parameter (copy)_949344770093748243] = &apos;% MUO events end of slot&apos; THEN [% Unreachable Events 5min (copy) (copy) (copy) (copy) (copy)_949344770089754642]&#10;&#10;END' />
      </column>
