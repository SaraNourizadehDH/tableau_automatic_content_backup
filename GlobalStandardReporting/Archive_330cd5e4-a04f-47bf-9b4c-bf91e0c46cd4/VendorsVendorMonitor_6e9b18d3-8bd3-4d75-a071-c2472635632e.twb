      <table>
        <view>
          <datasources>
            <datasource caption='vendor_gsr_monitor_offline (rl)' name='federated.1o6emvd1e0vajj15qj77a05sdpq1' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Y-Right Metric Parameter - Offline Duration' datatype='string' name='[Offline Metric Parameter (copy)_6959468821152006154]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% Offline Duration&quot;'>
              <calculation class='tableau' formula='&quot;% Offline Duration&quot;' />
            </column>
            <column caption='Choose Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
            <column caption='Y-Left Metric Parameter' datatype='string' name='[Y-Left Metric Parameter (copy)_3099743203065294848]' param-domain-type='list' role='measure' type='nominal' value='&quot;\# Schedule Duration (min)&quot;'>
              <calculation class='tableau' formula='&quot;# Schedule Duration (min)&quot;' />
            </column>
            <column caption='Y-Right Metric Parameter - Vendors with Offline events' datatype='string' name='[Y-Right Metric Parameter - Offline Duration (copy)_3099743203202977837]' param-domain-type='list' role='measure' type='nominal' value='&quot;None&quot;'>
              <calculation class='tableau' formula='&quot;None&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1o6emvd1e0vajj15qj77a05sdpq1'>
            <column caption='% Offline Duration - No Drivers' datatype='real' default-format='p0.00%' name='[% Offline Duration - Bad Weather (copy)_1600466734714085376]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([too_busy_no_drivers_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - MUO' datatype='real' name='[% Offline Duration - Busy (copy)_1891582220812873741]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([unreachable_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - Special Day' datatype='real' name='[% Offline Duration - Busy (copy)_1891582220817903630]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([special_day_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - Tech Problem' datatype='real' name='[% Offline Duration - Busy (copy)_1891582220818677775]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([tech_problem_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - Client Reasons' datatype='real' name='[% Offline Duration - Busy (copy)_3099743203077566466]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([client_offline_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - Other' datatype='real' name='[% Offline Duration - Busy Checkin (copy) (copy) (copy) (copy) (copy) (copy) (copy)_1891582220811894795]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([other_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - Monitor Rule' datatype='real' name='[% Offline Duration - Busy Checkin (copy) (copy) (copy) (copy) (copy) (copy)_1891582220811886602]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([monitor_rule_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - Courier Delayed' datatype='real' name='[% Offline Duration - Busy Checkin (copy) (copy) (copy) (copy) (copy)_1891582220811350025]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([courier_delayed_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - Closed' datatype='real' name='[% Offline Duration - Busy Checkin (copy) (copy) (copy) (copy)_1891582220811341832]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([closed_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - Churn' datatype='real' name='[% Offline Duration - Busy Checkin (copy) (copy) (copy)_1891582220811333639]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([churn_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - Checkin' datatype='real' name='[% Offline Duration - Busy Checkin (copy) (copy)_1891582220811321350]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([checkin_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - Busy' datatype='real' name='[% Offline Duration - Busy Checkin (copy)_1891582220811313157]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([busy_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - Refurbishment' datatype='real' name='[% Offline Duration - Client Reasons (copy) (copy) (copy)_3099743203091996677]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([refurbishment_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - Holiday' datatype='real' name='[% Offline Duration - Client Reasons (copy) (copy)_3099743203091980292]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([holiday_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - Bad Weather' datatype='real' name='[% Offline Duration - Client Reasons (copy)_3099743203091963907]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([bad_weather_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - Updates in Menu' datatype='real' name='[% Offline Duration - Tech Problem (copy)_1891582220851888154]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([updates_in_menu_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - Vendor Late Real-Time rules' datatype='real' name='[% Offline Duration - Updates in Menu (copy) (copy) (copy) (copy) (copy)_3099743203093069834]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([monitor_rule_vendor_late_realtime_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - Vendor Late Compliance rules' datatype='real' name='[% Offline Duration - Updates in Menu (copy) (copy) (copy) (copy)_3099743203093053449]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([monitor_rule_vendor_late_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - Unreachable Compliance rules' datatype='real' name='[% Offline Duration - Updates in Menu (copy) (copy) (copy)_3099743203093041160]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([monitor_rule_unreachable_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - Order Failure Compliance rules' datatype='real' name='[% Offline Duration - Updates in Menu (copy) (copy)_3099743203093024775]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([monitor_rule_order_failure_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - Order Failure Real-Time rules' datatype='real' name='[% Offline Duration - Updates in Menu (copy)_3099743203093012486]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([monitor_rule_order_failure_realtime_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='% Offline Duration - Availability Compliance rules' datatype='real' name='[% Updates in Menu Events - Client Online (copy)_3099743203094024203]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([monitor_rule_availability_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='Date Granularity' datatype='string' name='[Calculation_1891582220807041025]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&apos;Daily&apos; THEN STR([created_date])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Weekly&apos; THEN [created_week]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Monthly&apos; THEN [created_month]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Quarterly&apos; THEN STR(DATE(DATETRUNC(&apos;quarter&apos;,[created_date])))&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Yearly&apos; THEN STR([created_year])&#10;END' />
            </column>
            <column caption='Schedule Duration (min)' datatype='real' name='[Calculation_1891582220807364610]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([schedule_duration]) / 60, 0)' />
            </column>
            <column caption='% Offline Duration' datatype='real' name='[Calculation_1891582220810272771]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([offline_duration]) / SUM([schedule_duration])' />
            </column>
            <column caption='_Exclude Today' datatype='boolean' name='[Calculation_949344769977401344]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[created_date] &lt; TODAY()' />
            </column>
            <column caption='Y-Right Metric - Offline Duration' datatype='real' name='[Offline Metric (copy)_6959468821151801353]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Offline Metric Parameter (copy)_6959468821152006154] = &apos;% Offline Duration&apos; THEN [Calculation_1891582220810272771]&#10;ELSEIF [Parameters].[Offline Metric Parameter (copy)_6959468821152006154] = &apos;.    % Offline Duration - Special Day&apos; THEN [% Offline Duration - Busy (copy)_1891582220817903630]&#10;&#10;ELSEIF [Parameters].[Offline Metric Parameter (copy)_6959468821152006154] = &apos;.    % Offline Duration - Client Reasons&apos; THEN [% Offline Duration - Busy (copy)_3099743203077566466]&#10;ELSEIF [Parameters].[Offline Metric Parameter (copy)_6959468821152006154] = &apos;.    % Offline Duration - Bad Weather&apos; THEN [% Offline Duration - Client Reasons (copy)_3099743203091963907]&#10;ELSEIF [Parameters].[Offline Metric Parameter (copy)_6959468821152006154] = &apos;.    % Offline Duration - Busy&apos; THEN [% Offline Duration - Busy Checkin (copy)_1891582220811313157]&#10;ELSEIF [Parameters].[Offline Metric Parameter (copy)_6959468821152006154] = &apos;.    % Offline Duration - Closed&apos; THEN [% Offline Duration - Busy Checkin (copy) (copy) (copy) (copy)_1891582220811341832]&#10;ELSEIF [Parameters].[Offline Metric Parameter (copy)_6959468821152006154] = &apos;.    % Offline Duration - Holiday&apos; THEN [% Offline Duration - Client Reasons (copy) (copy)_3099743203091980292]&#10;ELSEIF [Parameters].[Offline Metric Parameter (copy)_6959468821152006154] = &apos;.    % Offline Duration - No Drivers&apos; THEN [% Offline Duration - Bad Weather (copy)_1600466734714085376]&#10;ELSEIF [Parameters].[Offline Metric Parameter (copy)_6959468821152006154] = &apos;.    % Offline Duration - Other&apos; THEN [% Offline Duration - Busy Checkin (copy) (copy) (copy) (copy) (copy) (copy) (copy)_1891582220811894795]&#10;ELSEIF [Parameters].[Offline Metric Parameter (copy)_6959468821152006154] = &apos;.    % Offline Duration - Refurbishment&apos; THEN [% Offline Duration - Client Reasons (copy) (copy) (copy)_3099743203091996677]&#10;ELSEIF [Parameters].[Offline Metric Parameter (copy)_6959468821152006154] = &apos;.    % Offline Duration - Tech Problem&apos; THEN [% Offline Duration - Busy (copy)_1891582220818677775]&#10;ELSEIF [Parameters].[Offline Metric Parameter (copy)_6959468821152006154] = &apos;.    % Offline Duration - Updates in Menu&apos; THEN [% Offline Duration - Tech Problem (copy)_1891582220851888154]&#10;&#10;ELSEIF [Parameters].[Offline Metric Parameter (copy)_6959468821152006154] = &apos;.    % Offline Duration - Checkin&apos; THEN [% Offline Duration - Busy Checkin (copy) (copy)_1891582220811321350]&#10;ELSEIF [Parameters].[Offline Metric Parameter (copy)_6959468821152006154] = &apos;.    % Offline Duration - Churn&apos; THEN [% Offline Duration - Busy Checkin (copy) (copy) (copy)_1891582220811333639]&#10;ELSEIF [Parameters].[Offline Metric Parameter (copy)_6959468821152006154] = &apos;.    % Offline Duration - Courier Delayed&apos; THEN [% Offline Duration - Busy Checkin (copy) (copy) (copy) (copy) (copy)_1891582220811350025]&#10;ELSEIF [Parameters].[Offline Metric Parameter (copy)_6959468821152006154] = &apos;.    % Offline Duration - Monitor Rule&apos; THEN [% Offline Duration - Busy Checkin (copy) (copy) (copy) (copy) (copy) (copy)_1891582220811886602]&#10;ELSEIF [Parameters].[Offline Metric Parameter (copy)_6959468821152006154] = &apos;.    % Offline Duration - MUO&apos; THEN [% Offline Duration - Busy (copy)_1891582220812873741]&#10;&#10;ELSEIF [Parameters].[Offline Metric Parameter (copy)_6959468821152006154] = &apos;.    % Offline Duration - Order Failure Real-Time rules&apos; THEN [% Offline Duration - Updates in Menu (copy)_3099743203093012486]&#10;ELSEIF [Parameters].[Offline Metric Parameter (copy)_6959468821152006154] = &apos;.    % Offline Duration - Order Failure Compliance rules&apos; THEN [% Offline Duration - Updates in Menu (copy) (copy)_3099743203093024775]&#10;ELSEIF [Parameters].[Offline Metric Parameter (copy)_6959468821152006154] = &apos;.    % Offline Duration - Unreachable Compliance rules&apos; THEN [% Offline Duration - Updates in Menu (copy) (copy) (copy)_3099743203093041160]&#10;ELSEIF [Parameters].[Offline Metric Parameter (copy)_6959468821152006154] = &apos;.    % Offline Duration - Vendor Late Real-Time rules&apos; THEN [% Offline Duration - Updates in Menu (copy) (copy) (copy) (copy) (copy)_3099743203093069834]&#10;ELSEIF [Parameters].[Offline Metric Parameter (copy)_6959468821152006154] = &apos;.    % Offline Duration - Vendor Late Compliance rules&apos; THEN [% Offline Duration - Updates in Menu (copy) (copy) (copy) (copy)_3099743203093053449]&#10;ELSEIF [Parameters].[Offline Metric Parameter (copy)_6959468821152006154] = &apos;.    % Offline Duration - Availability Compliance rules&apos; THEN [% Updates in Menu Events - Client Online (copy)_3099743203094024203]&#10;&#10;END' />
            </column>
            <column caption='Y-Left Metric - #' datatype='real' name='[Y-Left Metric (copy)_3099743203065524225]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Y-Left Metric Parameter (copy)_3099743203065294848] = &apos;# Schedule Duration (min)&apos; THEN [Calculation_1891582220807364610]&#10;ELSEIF [Parameters].[Y-Left Metric Parameter (copy)_3099743203065294848] = &apos;# Vendors with Schedules&apos; THEN SUM([vendors_with_schedule])&#10;END' />
