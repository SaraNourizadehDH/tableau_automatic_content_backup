            </column>
            <column caption='Dimension (C)' datatype='string' name='[Dimension (B) (copy)_2666693973170241549]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Choose Rule Dimension (A) (copy) (copy)_2666693973168357385] = &apos;All&apos; THEN &apos;&apos; &#10;ELSEIF [Parameters].[Choose Rule Dimension (A) (copy) (copy)_2666693973168357385] = &apos;Region&apos; THEN [region] &#10;ELSEIF [Parameters].[Choose Rule Dimension (A) (copy) (copy)_2666693973168357385] = &apos;Brand Name&apos; THEN [brand_name]&#10;ELSEIF [Parameters].[Choose Rule Dimension (A) (copy) (copy)_2666693973168357385] = &apos;Country Name&apos; THEN [country_name] &#10;ELSEIF [Parameters].[Choose Rule Dimension (A) (copy) (copy)_2666693973168357385] = &apos;Rule Id&apos; THEN [rule_id]&#10;ELSEIF [Parameters].[Choose Rule Dimension (A) (copy) (copy)_2666693973168357385] = &apos;Rule Title&apos; THEN [title]&#10;ELSEIF [Parameters].[Choose Rule Dimension (A) (copy) (copy)_2666693973168357385] = &apos;Is Realtime&apos; THEN STR([is_realtime])&#10;ELSEIF [Parameters].[Choose Rule Dimension (A) (copy) (copy)_2666693973168357385] = &apos;Rule Type&apos; THEN [type]&#10;ELSEIF [Parameters].[Choose Rule Dimension (A) (copy) (copy)_2666693973168357385] = &apos;Deployment Type&apos; THEN [deployment_type]&#10;ELSEIF [Parameters].[Choose Rule Dimension (A) (copy) (copy)_2666693973168357385] = &apos;Close Vendor&apos; THEN STR([close_vendor])&#10;ELSEIF [Parameters].[Choose Rule Dimension (A) (copy) (copy)_2666693973168357385] = &apos;Salesforce Case&apos; THEN STR([salesforce_case])&#10;ELSEIF [Parameters].[Choose Rule Dimension (A) (copy) (copy)_2666693973168357385] = &apos;Inbox Message&apos; THEN STR([inbox_message])&#10;END' />
