      <column caption='_indicator' datatype='boolean' name='[Calculation_130674760109076480]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Choose Breakdown (copy)] = &apos;Message&apos; THEN TRUE&#10;ELSE FALSE&#10;END' />
