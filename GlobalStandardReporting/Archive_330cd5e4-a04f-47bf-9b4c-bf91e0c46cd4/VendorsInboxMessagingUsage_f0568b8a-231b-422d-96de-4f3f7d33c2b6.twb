                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='ZN(SUM([Message Cnt])) / LOOKUP(ZN(SUM([Message Cnt])), FIRST...' datatype='real' name='[Calculation_1838594587630444549]' role='measure' type='quantitative' user:unnamed='Sheet 3'>
              <calculation class='tableau' formula='ZN(SUM([message_cnt])) / LOOKUP(ZN(SUM([message_cnt])), FIRST())/2'>
