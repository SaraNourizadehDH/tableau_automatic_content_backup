    <worksheet name='impact_line_pctg'>
      <table>
        <view>
          <datasources>
            <datasource caption='vendor_gsr_inbox_metrics (rl)' name='federated.0gpcud30k13z0w1gs5v2q13avj8p' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose Metrics to Show' datatype='string' name='[Parameter 3 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% Vendor Late &gt; 15 seconds&quot;'>
              <calculation class='tableau' formula='&quot;% Vendor Late &gt; 15 seconds&quot;' />
              <aliases>
                <alias key='&quot;Closed Fail-rate&quot;' value='% Closed Fail-rate' />
                <alias key='&quot;Fail-rate&quot;' value='% Fail-rate' />
                <alias key='&quot;Item Unavailability Fail-rate&quot;' value='% Item Unavailability Fail-rate' />
                <alias key='&quot;No Response Fail-rate&quot;' value='% No Response Fail-rate' />
                <alias key='&quot;Too Busy Fail-rate&quot;' value='% Too Busy Fail-rate' />
                <alias key='&quot;Unknown Fail-rate&quot;' value='% Unknown Fail-rate' />
                <alias key='&quot;Unreachable Fail-rate&quot;' value='% Unreachable Fail-rate' />
                <alias key='&quot;Vendor Fail-rate&quot;' value='% Vendor Fail-rate' />
              </aliases>
            </column>
            <column caption='Choose Date Granularity 1' datatype='string' name='[Parameter 6 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0gpcud30k13z0w1gs5v2q13avj8p'>
            <column caption='% Vendor Late &gt; 5 seconds' datatype='real' default-format='p0.0%' name='[Calculation_1773010935744552960]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_over_5_count])/SUM([vendor_late_cnt])' />
            </column>
            <column caption='% Vendor Late &gt; 10 seconds' datatype='real' default-format='p0.0%' name='[Calculation_1773010935744798721]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_over_10_count])/SUM([vendor_late_cnt])' />
            </column>
            <column caption='% Vendor Late &gt; 15 seconds' datatype='real' default-format='p0.0%' name='[Calculation_1773010935744946178]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_over_15_count])/SUM([vendor_late_cnt])' />
            </column>
            <column caption='_chosen metrics filter' datatype='boolean' name='[Calculation_2089670275681632257]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3 1] &#10;WHEN &apos;Avg. Vendor Late (second)&apos; THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='_title color name' datatype='string' name='[Calculation_2089670275703328770]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;All&apos;' />
            </column>
            <column caption='is_today?' datatype='boolean' name='[Calculation_2089670275951562755]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATE([created_date]) = DATE(TODAY())' />
            </column>
            <column caption='_chosen metrics' datatype='real' default-format='p0.0%' name='[Calculation_2861756130036178946]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3 1]&#10;WHEN &apos;Fail-rate&apos; THEN [Calculation_362258336124194816]&#10;WHEN &apos;Vendor Fail-rate&apos; THEN [Calculation_362258336124362753]&#10;WHEN &apos;No Response Fail-rate&apos; THEN [Calculation_362258336159232004]&#10;WHEN &apos;Too Busy Fail-rate&apos; THEN [Calculation_362258336159682565]&#10;WHEN &apos;Unreachable Fail-rate&apos; THEN [Calculation_362258336160903175]&#10;WHEN &apos;Closed Fail-rate&apos; THEN [Calculation_362258336155357186]&#10;WHEN &apos;Item Unavailability Fail-rate&apos; THEN [Calculation_362258336159084547]&#10;WHEN &apos;Unknown Fail-rate&apos; THEN [Calculation_362258336160534534]&#10;WHEN &apos;% Vendor Late &gt; 5 seconds&apos; THEN [Calculation_1773010935744552960]&#10;WHEN &apos;% Vendor Late &gt; 10 seconds&apos; THEN [Calculation_1773010935744798721]&#10;WHEN &apos;% Vendor Late &gt; 15 seconds&apos; THEN [Calculation_1773010935744946178]&#10;END' />
            </column>
            <column caption='_all chosen metrics' datatype='real' default-format='p0.0%' name='[Calculation_2861756130043551748]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{EXCLUDE [read_state] : [Calculation_2861756130036178946]}' />
            </column>
            <column caption='Fail-rate' datatype='real' name='[Calculation_362258336124194816]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_orders_cnt])/SUM([orders_cnt])' />
            </column>
            <column caption='Vendor Fail-rate' datatype='real' name='[Calculation_362258336124362753]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_fail_orders_cnt])/SUM([orders_cnt])' />
            </column>
            <column caption='Closed Fail-rate' datatype='real' name='[Calculation_362258336155357186]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([closed_fail_orders_cnt])/SUM([orders_cnt])' />
            </column>
            <column caption='Item Unavailability Fail-rate' datatype='real' name='[Calculation_362258336159084547]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([item_unavailability_fail_orders_cnt])/SUM([orders_cnt])' />
            </column>
            <column caption='No Response Fail-rate' datatype='real' name='[Calculation_362258336159232004]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_response_fail_orders_cnt])/SUM([orders_cnt])' />
            </column>
            <column caption='Too Busy Fail-rate' datatype='real' name='[Calculation_362258336159682565]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([too_busy_fail_orders_cnt])/SUM([orders_cnt])' />
            </column>
            <column caption='Unknown Fail-rate' datatype='real' name='[Calculation_362258336160534534]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([unknown_fail_orders_cnt])/SUM([orders_cnt])' />
            </column>
            <column caption='Unreachable Fail-rate' datatype='real' name='[Calculation_362258336160903175]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([unreachable_fail_orders_cnt])/SUM([orders_cnt])' />
            </column>
            <column caption='Read State simple' datatype='string' name='[Calculation_362258336543363081]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [read_state] &#10;WHEN &apos;read more than once&apos; THEN &apos;read&apos;&#10;WHEN &apos;read once&apos; THEN &apos;read&apos;&#10;ELSE [read_state]&#10;END' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_99219976719560704]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6 1]&#10;    WHEN &apos;Daily&apos; THEN STR([created_date])&#10;WHEN &apos;Weekly&apos; THEN [Calculation_99219976720781314]&#10;WHEN &apos;Monthly&apos; THEN [Calculation_99219976719769601]&#10;WHEN &apos;Quarterly&apos; THEN STR(DATE(DATETRUNC(&apos;quarter&apos;,[created_date])))&#10;END' />
            </column>
            <column caption='Created Date Month' datatype='string' name='[Calculation_99219976719769601]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;&apos; &#10;+  STR(YEAR([created_date]))&#10;+ &apos;-&apos; &#10;+  IF( MONTH([created_date]) &gt; 9) THEN STR(MONTH([created_date]))&#10;ELSE   &apos;0&apos; +  STR(MONTH([created_date]))&#10;END' />
            </column>
            <column caption='Created Date Week' datatype='string' name='[Calculation_99219976720781314]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;&apos; &#10;+ STR(YEAR([created_date]))&#10;+ &apos;-&apos; &#10;+ IF( WEEK([created_date]) &gt; 9) THEN STR(WEEK([created_date]))&#10;ELSE   &apos;0&apos; +  STR(WEEK([created_date]))&#10;END' />
            </column>
