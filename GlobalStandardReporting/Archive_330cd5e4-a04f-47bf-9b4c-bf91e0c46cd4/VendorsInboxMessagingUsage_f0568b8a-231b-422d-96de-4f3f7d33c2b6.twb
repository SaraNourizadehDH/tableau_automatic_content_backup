            <column caption='ZN(SUM([Message Cnt])) / LOOKUP(ZN(SUM([Message Cnt])), FIRST...' datatype='real' name='[Calculation_1838594587630391300]' role='measure' type='quantitative' user:unnamed='Sheet 3'>
