      <aliases enabled='yes' />
      <column caption='Active Bookings: AM' datatype='integer' default-format='n#,##0;-#,##0' name='[Active Bookings (copy)_1128433218334892042]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [booking_source] = &quot;agent&quot; THEN [campaign_id] END)' />
      </column>
      <column caption='Active Bookings: Self Serve' datatype='integer' default-format='n#,##0;-#,##0' name='[Active Bookings: AM (copy)_1128433218335006731]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [booking_source] = &quot;vendor&quot; THEN [campaign_id] END)' />
      </column>
      <column caption='Active Bookings: AM Self Serve Share' datatype='real' default-format='p0.0%' name='[Active Bookings: AM Self Serve (copy)_1128433218335096844]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Active Bookings: AM (copy)_1128433218335006731] / [Total Vendor Acquisitions (copy)_1128433218334724105]' />
      </column>
      <column caption='Avg Booked Budget: Self Serve' datatype='real' default-format='c#,##0&quot; €&quot;;-#,##0&quot; €&quot;' name='[Avg Booked Budget: AM (copy)_1128433218336624662]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [booking_source] = &quot;vendor&quot; THEN [budget] END)' />
      </column>
      <column caption='New Avg Booked Budget: AM' datatype='real' default-format='c#,##0&quot; €&quot;;-#,##0&quot; €&quot;' name='[Avg Booked Budget: AM (copy)_1128433218336862231]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [is_acquisition] = TRUE AND[booking_source] = &quot;agent&quot; THEN [budget] END)' />
      </column>
      <column caption='CPC Revenue: Self Serve' datatype='real' default-format='p0.0%' name='[CPC Revenue: AM (copy)_1128433218337550365]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [booking_source] = &quot;vendor&quot; THEN [cpc_revenue] END)' />
