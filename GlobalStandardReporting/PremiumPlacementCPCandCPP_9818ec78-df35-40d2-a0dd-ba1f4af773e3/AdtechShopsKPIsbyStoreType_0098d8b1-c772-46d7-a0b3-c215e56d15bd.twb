      <column caption='Total Advertising Revenue over GMV %' datatype='real' name='[Calculation_730427615967993857]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(zn([total_ncr_revenue]))/sum(zn([gmv_eur]))' />
      </column>
      <column caption='CPC Churn %' datatype='real' name='[Calculation_960392667776983040]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(zn([cpc_churn]))/sum(zn([cpc_advertisers_pm]))' />
      </column>
      <column caption='CPC Penetration %' datatype='real' name='[Calculation_960392667777196033]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(zn([cpc_vendor]))/sum(zn([total_online_vendors]))' />
      </column>
