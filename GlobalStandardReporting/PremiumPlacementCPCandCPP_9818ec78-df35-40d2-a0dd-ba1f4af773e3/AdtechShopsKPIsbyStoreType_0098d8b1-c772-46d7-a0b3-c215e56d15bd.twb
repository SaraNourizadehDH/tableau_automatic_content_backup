      <aliases enabled='yes' />
      <column caption='Data up to' datatype='date' default-format='*mmmm d, yyyy' name='[Calculation_1253126645300985859]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MAX([data_up_to])' />
      </column>
      <column caption='Rev % of GMV' datatype='real' default-format='p0.0%' name='[Calculation_1275363158236573697]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([cpc_revenue])/SUM([cpc_all_gmv_eur]))' />
      </column>
      <column caption='CPC Type' datatype='string' name='[Calculation_1512646572307587072]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if  CONTAINS([type],&apos;placements&apos;) then &apos;Premium Placement&apos;&#13;&#10;ELSEIF [type]=&apos;kwords_placements&apos; then &apos;Kwords Placement&apos; &#13;&#10;ELSEIF [type]=&apos;featured_products&apos; then &apos;Feature Product&apos; &#13;&#10;ELSEIF [type]=&apos;kwords_search&apos; then &apos;Kwords Search&apos; &#13;&#10;END' />
      </column>
      <column caption='% Budget Achieved' datatype='real' name='[Calculation_1512646572325818379]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(ZN([cpc_revenue]))/sum(ZN([budget_excl_outliers]))' />
      </column>
      <column caption='vendor unique id' datatype='string' name='[Calculation_182677308571000832]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[vendor_id]+[global_entity_id]' />
      </column>
      <column caption='Total vendors' datatype='integer' name='[Calculation_182677308571340803]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_182677308571000832])' />
      </column>
      <column caption='Vendors w/active booking' datatype='integer' name='[Calculation_182677308571492356]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(if [last_status]=&apos;open&apos; then ([vendor_id]+[global_entity_id]) end)' />
      </column>
      <column caption='Open Bookings' datatype='integer' hidden='true' name='[Calculation_182677308572966917]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [last_status]=&apos;open&apos; then [booking_id] end)' />
      </column>
      <column caption='distinct bookings' datatype='integer' name='[Calculation_182677308573200390]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([booking_id])' />
      </column>
      <column caption='Vendors' datatype='integer' name='[Calculation_1998472372129169409]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1]=&apos;Exclude&apos; then [Calculation_182677308571492356] ELSE [Calculation_182677308571340803] END' />
      </column>
      <column caption='Bookings' datatype='integer' name='[Calculation_1998472372129337346]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&apos;Exclude&apos; then [Calculation_182677308572966917] ELSE [Calculation_182677308573200390] END' />
      </column>
      <column caption='Management Entity Filtered Data' datatype='string' name='[Calculation_1998472372134903811]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Management Entity Parameter] = &quot;All&quot; THEN &quot;True&quot;&#13;&#10;     ELSEIF [management_entity] = [Parameters].[Management Entity Parameter] THEN &quot;True&quot;&#13;&#10;     ELSE &quot;False&quot;&#13;&#10;     END' />
      </column>
      <column caption='Dynamic Clicks by Vertical  Type' datatype='integer' name='[Calculation_1998472372135337988]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [vertical_type]:SUM(IF [Calculation_1998472372134903811]  = &apos;True&apos; &#13;&#10;THEN [cpc_clicks] ELSE 0 END)}' />
      </column>
      <column caption='Vertical Type w Other' datatype='string' name='[Calculation_1998472372135776261]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [Vertical Type Set]&#13;&#10;THEN [vertical_type]&#13;&#10;ELSE  &quot;Other&quot;&#13;&#10;END' />
      </column>
