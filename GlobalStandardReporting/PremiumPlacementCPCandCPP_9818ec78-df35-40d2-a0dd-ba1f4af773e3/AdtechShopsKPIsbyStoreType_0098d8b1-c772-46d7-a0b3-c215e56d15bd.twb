            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_116249197748547592]' derivation='None' name='[none:Calculation_116249197748547592:nk]' pivot='key' type='nominal' />
