            <column caption='Sub Entity' datatype='string' name='[sub_entity]' role='dimension' type='nominal' />
            <column-instance column='[cpc_clicks]' derivation='Sum' name='[sum:cpc_clicks:qk]' pivot='key' type='quantitative' />
            <column-instance column='[partition_date]' derivation='Day-Trunc' name='[tdy:partition_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[partition_date]' derivation='Month-Trunc' name='[tmn:partition_date:ok]' pivot='key' type='ordinal' />
