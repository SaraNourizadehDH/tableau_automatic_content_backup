            <column caption='Local Shops NCR % of targets achieved' datatype='real' name='[Calculation_890868353504522240]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(zn([cpc_revenue]))/SUM(zn([shops_ncr_revenue_target]))' />
            </column>
            <column datatype='real' name='[cpc_revenue]' role='measure' type='quantitative' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
