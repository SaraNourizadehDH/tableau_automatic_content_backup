            <column-instance column='[sub_entity]' derivation='None' name='[none:sub_entity:nk]' pivot='key' type='nominal' />
            <column caption='Partition Date' datatype='date' name='[partition_date]' role='dimension' type='ordinal' />
            <column caption='Placement Screen' datatype='string' name='[placement_screen]' role='dimension' type='nominal' />
            <column caption='Platform' datatype='string' name='[platform]' role='dimension' type='nominal' />
            <column caption='Premium Shops Clicked' datatype='integer' name='[premium_shops_clicked]' role='measure' type='quantitative' />
