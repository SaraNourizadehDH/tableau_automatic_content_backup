            <column caption='Store Type' datatype='string' name='[store_type]' role='dimension' type='nominal' />
            <column caption='Sub Entity' datatype='string' name='[sub_entity]' role='dimension' type='nominal' />
            <column-instance column='[all_clicks]' derivation='Sum' name='[sum:all_clicks:qk]' pivot='key' type='quantitative' />
            <column-instance column='[cpc_clicks]' derivation='Sum' name='[sum:cpc_clicks:qk]' pivot='key' type='quantitative' />
