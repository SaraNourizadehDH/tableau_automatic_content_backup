          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/AdtechPremiumPlacement-Islam/CPCROASPerStoreType?rev=' id='CPCROASPerStoreType' path='/t/GlobalStandardReporting/workbooks/AdtechPremiumPlacement-Islam' revision='' site='GlobalStandardReporting' />
      <table>
        <view>
          <datasources>
            <datasource caption='adtech_shops_kpis_by_store_type' name='federated.022dr361tf0btd175mgt51ch8qhi' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Management Entity Filter' datatype='string' name='[Management Entity Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column caption='Clicks Performing Metric' datatype='string' name='[Parameter 14]' param-domain-type='list' role='measure' type='nominal' value='&quot;CPC Clicks&quot;'>
              <calculation class='tableau' formula='&quot;CPC Clicks&quot;' />
            </column>
            <column caption='Max Position' datatype='integer' name='[Parameter 8]' param-domain-type='range' role='measure' type='quantitative' value='3'>
              <calculation class='tableau' formula='3' />
              <range granularity='1' max='10' min='1' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.022dr361tf0btd175mgt51ch8qhi'>
            <column caption='Management Entity Filtered Data' datatype='string' name='[Calculation_116249197748547592]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Management Entity Parameter] = &quot;All&quot; THEN &quot;True&quot;&#13;&#10;     ELSEIF [management_entity] = [Parameters].[Management Entity Parameter] THEN &quot;True&quot;&#13;&#10;     ELSE &quot;False&quot;&#13;&#10;     END' />
            </column>
            <column caption='% CPC CVR' datatype='real' name='[Calculation_1462332893039792135]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(((SUM([cpc_orders])/SUM([cpc_clicks]))*100),2)' />
            </column>
            <column caption='Clicks Performing Metric' datatype='real' name='[Calculation_1462332893039890440]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 14]&#10;    WHEN &apos;ROAS&apos; THEN [Calculation_85005463232663552]&#10;    WHEN &apos;CPC Clicks&apos; THEN SUM([cpc_clicks])&#10;    WHEN &apos;CPC CVR&apos; THEN [Calculation_1462332893039792135]&#13;&#10;    WHEN  &apos;All Clicks&apos; THEN SUM([all_clicks])&#13;&#10;WHEN &apos;CPC GMV Eur&apos; THEN SUM([cpc_gmv_eur])&#13;&#10;WHEN &apos;CPC Revenue&apos; THEN SUM([cpc_revenue])&#13;&#10;WHEN &apos;Click Utilisation Rate&apos; THEN ROUND([Calculation_85005463235727361],2)&#13;&#10;WHEN &apos;CPC Orders&apos; THEN SUM([cpc_orders])&#13;&#10;END' />
            </column>
            <column caption='Dynamic Clicks by Store Type' datatype='integer' name='[Calculation_185773517183660032]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [store_type]: SUM(IF [Calculation_116249197748547592]  = &apos;True&apos; THEN [cpc_clicks] ELSE 0 END)}' />
            </column>
            <column caption='Store Type with Other' datatype='string' name='[Calculation_185773517184696323]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  [Store Type (Adtech Shops By Store Type V2) Set]&#13;&#10;&#13;&#10;THEN [store_type]&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
            </column>
            <column caption='ROAS' datatype='real' name='[Calculation_85005463232663552]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cpc_gmv_eur])/SUM([cpc_revenue])' />
            </column>
            <column caption='CPC Utilization Rate' datatype='real' default-format='p0.0%' name='[Calculation_85005463235727361]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(((SUM([cpc_clicks])/SUM([all_clicks]))*100),2)' />
            </column>
            <column caption='All Clicks' datatype='integer' name='[all_clicks]' role='measure' type='quantitative' />
            <column caption='Cpc Clicks' datatype='integer' name='[cpc_clicks]' role='measure' type='quantitative' />
            <column caption='Cpc Gmv Eur' datatype='real' name='[cpc_gmv_eur]' role='measure' type='quantitative' />
            <column caption='Cpc Orders' datatype='integer' name='[cpc_orders]' role='measure' type='quantitative' />
