  <worksheets>
    <worksheet name='Cohorts Abs'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Chart Example</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/AdTechTemplate/sheet_sample?rev=' id='sheet_sample' path='/t/GlobalStandardReporting/workbooks/AdTechTemplate' revision='' site='GlobalStandardReporting' />
      <table>
        <view>
          <datasources>
            <datasource caption='ad_credits (prod)' name='federated.0es998f0ytef0t1931fsr06b787o' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='KPI' datatype='string' datatype-customized='true' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Retention&quot;'>
              <calculation class='tableau' formula='&quot;Retention&quot;' />
            </column>
            <column caption='Split dimension' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;No split&quot;'>
              <calculation class='tableau' formula='&quot;No split&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0es998f0ytef0t1931fsr06b787o'>
            <column caption='Source' datatype='string' name='[Calculation_2000301967984840704]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [source] = &quot;central&quot; THEN &quot;Ad Credits Central&quot;&#10;ELSEIF [source] = &quot;entities&quot; THEN &quot;Ad Credits Entities&quot;&#10;ELSEIF [source] = &quot;organic&quot; THEN &quot;Organic&quot;&#10;END' />
            </column>
            <column caption='All Entities' datatype='string' name='[Calculation_3103543138802262017]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column caption='Month diff' datatype='integer' name='[Calculation_5741667355578920961]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [cohort_month], [date_month])' />
            </column>
            <column caption='KPI' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_5741667355581087747]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='//IF [Parameters].[KPI] = &quot;Budget per vendor&quot; THEN STR(ROUND([Budget per vendor]))+&quot;€&quot;&#10;//ELSEIF [Parameters].[KPI] = &quot;CPC Revenue&quot; THEN STR(ROUND(SUM([Cpc Revenue])))+&quot;€&quot;&#10;//ELSEIF [Parameters].[KPI] = &quot;Net Revenue&quot; THEN STR(ROUND(SUM([Net Revenue])))+&quot;€&quot;&#10;//ELSEIF [Parameters].[KPI] = &quot;ROAS&quot; THEN STR(SUM([Cpc Gmv]) / SUM([Cpc Revenue]))&#10;//END&#10;&#10;IF [Parameters].[Parameter 1] = &quot;Budget per vendor&quot; THEN SUM([budget]) / COUNTD([Vendor Id + GE ID (copy)_967218433246281731])&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Budget&quot; THEN SUM([budget])&#10;ELSEIF [Parameters].[Parameter 1] = &quot;CPC Revenue per vendor&quot; THEN SUM([cpc_revenue]) / COUNTD([Vendor Id + GE ID (copy)_967218433246281731])&#10;ELSEIF [Parameters].[Parameter 1] = &quot;CPC Revenue&quot; THEN SUM([cpc_revenue])&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Net Revenue per vendor&quot; THEN SUM([net_revenue]) / COUNTD([Vendor Id + GE ID (copy)_967218433246281731])&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Net Revenue&quot; THEN SUM([net_revenue])&#10;ELSEIF [Parameters].[Parameter 1] = &quot;ROAS&quot; THEN SUM([cpc_gmv]) / SUM([cpc_revenue])&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Retention&quot; THEN COUNTD([Vendor Id + GE ID (copy)_967218433246281731])&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Credits consumed&quot; THEN SUM([credit_consumed (ad_credits_cohorts_fct)])&#10;END' />
            </column>
            <column caption='Split dimension Cohorts' datatype='string' name='[Calculation_5741667356314677261]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;No split&quot; THEN &quot;&quot;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Accounts Segment&quot; THEN [accounts_segment]&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Vendor Class&quot; THEN [vendor_class]&#10;END' />
            </column>
            <column caption='Cohort Month (copy)' datatype='date' name='[Cohort Month (copy)_2000301967998062594]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[cohort_month]' />
            </column>
            <column caption='Vendor Class Cohort' datatype='boolean' name='[Vendor Class Cohort (copy)_4894709152077651971]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [credit_month] = [cohort_month] AND [Calculation_2000301967984840704] != &quot;organic&quot; THEN TRUE &#10;ELSEIF [Calculation_2000301967984840704] = &quot;Organic&quot; THEN TRUE &#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='Vendor Id Cohorts + GE ID Cohorts' datatype='string' name='[Vendor Id + GE ID (copy)_967218433246281731]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[vendor_id (ad_credits_cohorts_fct)]+&quot; &quot;+[global_entity_id (ad_credits_cohorts_fct)]' />
