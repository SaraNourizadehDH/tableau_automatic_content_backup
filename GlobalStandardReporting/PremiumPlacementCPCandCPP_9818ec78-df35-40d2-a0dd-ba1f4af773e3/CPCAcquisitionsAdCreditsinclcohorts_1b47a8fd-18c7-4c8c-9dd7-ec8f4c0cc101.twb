                <zone forceUpdate='true' h='8743' id='91' type-v2='text' w='92370' x='4222' y='3686'>
                  <formatted-text>
                    <run bold='true' fontcolor='#1d1c1d' fontsize='11' lmargin='420'>Vendors acquired: </run>
                    <run fontcolor='#1d1c1d' fontsize='11' lmargin='420'>defined as vendors who were Active in the previous month but not CPC advertisers. Zombies who had a campaign booked and became Active are not considered, this is the only difference vs MBR dashboard</run>
                    <run lmargin='420'>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1d1c1d' fontsize='11' lmargin='420'>Budget</run>
                    <run fontcolor='#1d1c1d' fontsize='11' lmargin='420'>: booked budget of acquired vendors</run>
                    <run lmargin='420'>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1d1c1d' fontsize='11' lmargin='420'>Credits consumed</run>
                    <run fontcolor='#1d1c1d' fontsize='11' lmargin='420'>: monetary value of ad credits used</run>
                    <run lmargin='420'>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1d1c1d' fontsize='11' lmargin='420'>Net revenue</run>
                    <run fontcolor='#1d1c1d' fontsize='11' lmargin='420'>: CPC revenue - Credits consumed</run>
                    <run lmargin='420'>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1d1c1d' fontsize='11' lmargin='420'>Sources</run>
                    <run lmargin='840'>Æ&#10;</run>
                    <run fontcolor='#474747' fontsize='11' lmargin='840'>• </run>
                    <run fontcolor='#1d1c1d' fontsize='11' lmargin='840'>Ad Credits Central: vendors acquired through the Central initiative (no CPC campaign in the last 6 months)</run>
                    <run lmargin='840'>Æ&#10;</run>
                    <run fontcolor='#474747' fontsize='11' lmargin='840'>• </run>
                    <run fontcolor='#1d1c1d' fontsize='11' lmargin='840'>Ad Credits Entities: all other vendors acquired through an Ad Credit</run>
                    <run lmargin='840'>Æ&#10;</run>
                    <run fontcolor='#474747' fontsize='11' lmargin='840'>• </run>
                    <run fontcolor='#1d1c1d' fontsize='11' lmargin='840'>Organic: vendors acquired without an Ad Credit</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
