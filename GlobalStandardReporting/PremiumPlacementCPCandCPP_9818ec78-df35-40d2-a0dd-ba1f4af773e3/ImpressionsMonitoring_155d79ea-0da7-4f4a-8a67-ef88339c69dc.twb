              <calculation class='tableau' formula='IF ISNULL(SUM([organic_impressions])) OR SUM([organic_impressions]) = 0 THEN&#10;    SUM([sponsored_impressions]) / SUM([sponsored_impressions])&#10;ELSE&#10;    SUM([sponsored_impressions]) / (SUM([sponsored_impressions]) + SUM([organic_impressions]))&#10;END' />
