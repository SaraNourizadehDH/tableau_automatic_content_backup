      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0bvjc3d08x66jh1dw9zs50rofo2v].[sum:cpc_impression:qk]&quot;' value='CPC Impressions' />
        </aliases>
      </column>
      <column caption='Impression with Valid Token' datatype='integer' name='[Calculation_1856397906799902720]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [valid_ncr_request_token] = 1 THEN [cpc_impression] ELSE 0 END)' />
      </column>
      <column caption='Clicks to Impressions' datatype='real' name='[Calculation_1856397906800869377]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cpc_clicks]) / SUM([cpc_impression])' />
      </column>
      <column caption='% Valid Token Impressions' datatype='real' name='[Calculation_1856397906802233348]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [valid_ncr_request_token] = 1 THEN [cpc_impression] END)/SUM([cpc_impression])' />
      </column>
      <column caption='Impressions per Vendor' datatype='real' name='[Calculation_1856397906802802693]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cpc_impression]) / SUM([vendors])' />
      </column>
      <column caption='Position' datatype='string' name='[Calculation_1856397906831781894]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF NOT ISNULL([position_impression]) AND [position_impression] != &quot;na&quot; THEN&#10;    IF INT([position_impression]) &gt;= 0 AND INT([position_impression]) &lt;= 20 THEN&#10;        STR([position_impression])&#10;    ELSE&#10;        &quot;20+&quot;&#10;    END&#10;END' />
      </column>
      <column caption='Ranking Strategy' datatype='string' name='[Calculation_1856397906840178695]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS(LOWER([ranking_strategy_name]), &quot;falcon&quot;) THEN&#10;    &quot;Falcon&quot;&#10;ELSEIF CONTAINS(LOWER([ranking_strategy_name]), &quot;loki v0&quot;) OR CONTAINS(LOWER([ranking_strategy_name]), &quot;loki_v0&quot;) THEN&#10;    &quot;Loki v0&quot;&#10;ELSEIF CONTAINS(LOWER([ranking_strategy_name]), &quot;loki v4&quot;) OR CONTAINS(LOWER([ranking_strategy_name]), &quot;loki_v4&quot;) THEN&#10;    &quot;Loki v4&quot;&#10;ELSEIF CONTAINS(LOWER([ranking_strategy_name]), &quot;loki v6&quot;) OR CONTAINS(LOWER([ranking_strategy_name]), &quot;loki_v6&quot;) THEN&#10;    &quot;Loki v6&quot;&#10;ELSEIF CONTAINS(LOWER([ranking_strategy_name]), &quot;phoenix&quot;) THEN&#10;    &quot;Phoenix&quot;&#10;ELSEIF CONTAINS(LOWER([ranking_strategy_name]), &quot;vishnu&quot;) THEN&#10;    &quot;Vishnu&quot;&#10;ELSEIF CONTAINS(LOWER([ranking_strategy_name]), &quot;vision&quot;) THEN&#10;    &quot;Vision&quot;&#10;ELSE &quot;Other&quot;&#10;END' />
      </column>
      <column caption='Avg. Impressions ' datatype='real' name='[Calculation_2419066352585412610]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_2419066352585707523] * [cpc_impression]) / SUM([cpc_impression])' />
      </column>
      <column caption='Impression Position Cleaned' datatype='integer' name='[Calculation_2419066352585707523]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF INT([Calculation_2419066352590098437]) &gt;= 0 THEN [Position Impression (copy)_2419066352585240577] &#10;ELSE 0 END' />
      </column>
      <column aggregation='CountD' caption='Cleaned Position' datatype='integer' datatype-customized='true' name='[Calculation_2419066352590098437]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(IF STR(([position_impression])) = &apos;na&apos; OR STR([position_impression]) = &apos;null&apos; OR ISNULL([position_impression]) THEN &apos;0&apos; ELSE [position_impression] END)' />
      </column>
      <column aggregation='CountD' caption='Impression Position' datatype='integer' datatype-customized='true' name='[Position Impression (copy)_2419066352585240577]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT([position_impression])' />
      </column>
