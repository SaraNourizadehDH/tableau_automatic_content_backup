      <aliases enabled='yes' />
      <column caption='Fill Rate' datatype='real' name='[Calculation_4582975600872656896]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([loaded_vendors]) / SUM([available_slots])' />
      </column>
      <column caption='Viewability %' datatype='real' name='[Calculation_5823576561147715584]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([viewed_vendors]) / SUM([loaded_vendors])' />
      </column>
