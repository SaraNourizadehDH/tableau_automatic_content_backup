                <zone fixed-size='149' forceUpdate='true' h='6923' id='41' type-v2='text' w='98908' x='546' y='2558'>
                  <formatted-text>
                    <run bold='true' fontcolor='#9e0000' fontname='Verdana' fontsize='14'>Definition &amp; Use Guidelines:</run>
                    <run fontcolor='#9e0000' fontname='Verdana' fontsize='14'>Æ </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#555555' fontname='Verdana'>CPC Loaded Slots (%)</run>
                    <run fontcolor='#555555' fontname='Verdana'>: for each slot (1,2,3...)</run>
