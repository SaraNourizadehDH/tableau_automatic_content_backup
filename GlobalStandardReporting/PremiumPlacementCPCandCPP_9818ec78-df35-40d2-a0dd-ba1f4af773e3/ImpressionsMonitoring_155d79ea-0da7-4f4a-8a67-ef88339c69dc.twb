                    <zone fixed-size='149' forceUpdate='true' h='7978' id='41' is-fixed='true' type-v2='text' w='98908' x='546' y='2948'>
                      <formatted-text>
                        <run bold='true' fontcolor='#9e0000' fontname='Verdana' fontsize='14'>Definition &amp; Use Guidelines:</run>
                        <run fontcolor='#9e0000' fontname='Verdana' fontsize='14'>Æ </run>
                        <run>Æ&#10;&#10;</run>
                        <run bold='true' fontcolor='#555555' fontname='Verdana'>CPC Viewability (%)</run>
                        <run fontcolor='#555555' fontname='Verdana'>: (# of viewed impressions)/(# of loaded impressions); shows the share of vendors viewed by the user, of those loaded</run>
                        <run>Æ&#10;&#10;</run>
                        <run fontcolor='#555555' fontname='Verdana'>As of Q2 2024; Implementation covers majorly &apos;Food&apos; vertical. Local Shops aren&apos;t completely implemented across all screens. Additionally, impressions from &apos;Web&apos; are not completely implemented for all entities.</run>
                        <run>Æ&#10;&#10;</run>
                        <run bold='true' fontcolor='#9e0000' fontname='Verdana' fontsize='12'>Filters:</run>
                        <run>Æ&#10;&#10;&#10;&#10;</run>
