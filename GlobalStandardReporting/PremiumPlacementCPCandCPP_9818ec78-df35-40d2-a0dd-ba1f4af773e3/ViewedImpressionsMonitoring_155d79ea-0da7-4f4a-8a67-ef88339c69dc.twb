          <datasource-dependencies datasource='federated.0ynl8sv1oxqsod1gvp8vv0de3y7p'>
            <column caption='Management Entity' datatype='string' name='[Calculation_2569655452108865536]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [global_entity_id] = &apos;BM_KR&apos; THEN &apos;Baemin&apos;&#10;ELSEIF [global_entity_id] = &apos;HS_SA&apos; THEN &apos;Hungerstation&apos;&#10;ELSEIF [global_entity_id] = &apos;EF_GR&apos; THEN &apos;DH Greece&apos;&#10;ELSEIF [global_entity_id] IN (&apos;DJ_CZ&apos;, &apos;FO_NO&apos;, &apos;FP_SK&apos;, &apos;HN_DK&apos;, &apos;MJM_AT&apos;, &apos;NP_HU&apos;, &apos;OP_SE&apos;, &apos;PO_FI&apos;, &apos;YS_TR&apos;) THEN &apos;DH Europe&apos;&#10;ELSEIF LEFT([global_entity_id], 3) = &apos;FP_&apos; THEN &apos;Foodpanda APAC&apos;&#10;ELSEIF LEFT([global_entity_id], 3) = &apos;PY_&apos; OR [global_entity_id] = &apos;AP_PA&apos; THEN &apos;Pedidosya&apos;&#10;ELSEIF LEFT([global_entity_id], 3) = &apos;TB_&apos; OR [global_entity_id] = &apos;HF_EG&apos; THEN &apos;Talabat&apos;&#10;END' />
            </column>
            <column caption='Loaded Impressions  Coverage' datatype='real' name='[Calculation_2569655452110012417]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([loaded_impression_exists]) / SUM([cpc_clicks])' />
            </column>
