                      <zone fixed-size='216' forceUpdate='true' h='8723' id='41' is-fixed='true' type-v2='text' w='98908' x='546' y='2259'>
                        <formatted-text>
                          <run bold='true' fontcolor='#9e0000' fontname='Verdana' fontsize='14'>Definition &amp; Use Guidelines:</run>
                          <run fontcolor='#9e0000' fontname='Verdana' fontsize='14'>Æ </run>
                          <run>Æ&#10;&#10;</run>
                          <run fontcolor='#555555' fontname='Verdana'>Fill Rate is defined on the volume of loaded impressions, which vary by placement, depending on current implementation by entities. Please only consider placements where the loaded impressions coverage is </run>
                          <run bold='true' fontcolor='#555555' fontname='Verdana'>at least 90%</run>
                          <run fontcolor='#555555' fontname='Verdana'> (see &apos;Implementation Monitoring sheet), to consider Fill Rate &amp; View Rate Metrics. Some values will be &gt;100% owing to incomplete implementation</run>
                          <run>Æ&#10;</run>
                          <run bold='true' fontcolor='#555555' fontname='Verdana'>Fill Rate (%)</run>
                          <run fontcolor='#555555' fontname='Verdana'>: (# of loaded impressions)/(# of hermes responses)</run>
                          <run>Æ&#10;</run>
                          <run bold='true' fontcolor='#555555' fontname='Verdana'>View Rate (%)</run>
                          <run fontcolor='#555555' fontname='Verdana'>: (# of viewed impressions)/(# of loaded impressions)</run>
                          <run>Æ&#10;</run>
                          <run fontcolor='#555555' fontname='Verdana'>As of Q2 2024; Implementation covers majorly &apos;Food&apos; vertical. Local Shops aren&apos;t included so far. Also, Web is not a part of current implementation.</run>
                          <run>Æ&#10;&#10;</run>
                          <run bold='true' fontcolor='#9e0000' fontname='Verdana' fontsize='12'>Filters:</run>
                          <run>Æ&#10;&#10;&#10;&#10;</run>
                        </formatted-text>
                        <zone-style>
                          <format attr='border-color' value='#000000' />
                          <format attr='border-style' value='none' />
                          <format attr='border-width' value='0' />
                          <format attr='margin' value='4' />
