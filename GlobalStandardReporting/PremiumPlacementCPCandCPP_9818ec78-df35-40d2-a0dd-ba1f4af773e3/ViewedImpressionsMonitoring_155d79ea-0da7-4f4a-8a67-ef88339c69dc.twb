      <table>
        <view>
          <datasources>
            <datasource caption='viewed_impressions_monitoring (analytics)' name='federated.0bvjc3d08x66jh1dw9zs50rofo2v' />
          </datasources>
          <datasource-dependencies datasource='federated.0bvjc3d08x66jh1dw9zs50rofo2v'>
            <column caption='Impression with Valid Token' datatype='integer' name='[Calculation_1856397906799902720]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [valid_ncr_request_token] = 1 THEN [cpc_impression] ELSE 0 END)' />
            </column>
            <column caption='CTR' datatype='real' name='[Calculation_1856397906800869377]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([cpc_impression]) = 0 THEN 0 ELSE SUM([cpc_clicks]) / SUM([cpc_impression]) END' />
            </column>
            <column caption='% Valid Token Impressions' datatype='real' name='[Calculation_1856397906802233348]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [valid_ncr_request_token] = 1 THEN [cpc_impression] END)/SUM([cpc_impression])' />
            </column>
            <column caption='CPC Impressions per CPC Vendor' datatype='real' name='[Calculation_1856397906802802693]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cpc_impression]) / SUM([vendors])' />
            </column>
            <column caption='Ranking Strategy' datatype='string' name='[Calculation_1856397906840178695]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS(LOWER([ranking_strategy_name]), &quot;falcon&quot;) THEN&#10;    &quot;Falcon&quot;&#10;ELSEIF CONTAINS(LOWER([ranking_strategy_name]), &quot;loki v0&quot;) OR CONTAINS(LOWER([ranking_strategy_name]), &quot;loki_v0&quot;) THEN&#10;    &quot;Loki v0&quot;&#10;ELSEIF CONTAINS(LOWER([ranking_strategy_name]), &quot;loki v4&quot;) OR CONTAINS(LOWER([ranking_strategy_name]), &quot;loki_v4&quot;) THEN&#10;    &quot;Loki v4&quot;&#10;ELSEIF CONTAINS(LOWER([ranking_strategy_name]), &quot;loki v6&quot;) OR CONTAINS(LOWER([ranking_strategy_name]), &quot;loki_v6&quot;) THEN&#10;    &quot;Loki v6&quot;&#10;ELSEIF CONTAINS(LOWER([ranking_strategy_name]), &quot;phoenix&quot;) THEN&#10;    &quot;Phoenix&quot;&#10;ELSEIF CONTAINS(LOWER([ranking_strategy_name]), &quot;vishnu&quot;) THEN&#10;    &quot;Vishnu&quot;&#10;ELSEIF CONTAINS(LOWER([ranking_strategy_name]), &quot;vision&quot;) THEN&#10;    &quot;Vision&quot;&#10;ELSE &quot;Other&quot;&#10;END' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Cpc Clicks' datatype='integer' name='[cpc_clicks]' role='measure' type='quantitative' />
