    <worksheet name='Breakdown by Ranking Strategy'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#9e0000' fontname='Verdana'>&lt;Sheet Name&gt;</run>
          </formatted-text>
