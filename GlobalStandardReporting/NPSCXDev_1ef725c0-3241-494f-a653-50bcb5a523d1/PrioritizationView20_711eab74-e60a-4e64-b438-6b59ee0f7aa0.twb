      <aliases enabled='yes' />
      <column caption='%Detractors' datatype='real' default-format='p0%' name='[%First Order Retention (copy)_2742058907490713604]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nps_detractors])/SUM([nps_responses])' />
      </column>
      <column caption='$Validation - Dynamic Field' datatype='string' name='[Calculation_2742058907486814208]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Lifecycle Segment Old&apos; Then [lifecycle_segment]&#10;WHEN &apos;Lifecycle Segment New&apos; Then [customer_segment]&#10;WHEN &apos;HVC Segment&apos; Then [DS_VALUE_SEGMENT]&#10;End' />
      </column>
      <column caption='Sort By - Field' datatype='real' name='[Calculation_4488259296032333824]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;When &apos;Responses&apos; then Sum([nps_responses])&#10;When &apos;%Detractors&apos; Then [%First Order Retention (copy)_2742058907490713604]&#10;End' />
      </column>
      <column caption='NPS Subreason Label' datatype='string' name='[Calculation_5031787476393746432]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[nps_reason] + &apos; -&gt; &apos; + [nps_sub_reason]' />
      </column>
      <column caption='S.No' datatype='integer' name='[Calculation_5031787476395470849]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='NPS Reason without Nulls' datatype='string' name='[Calculation_5883812176645070848]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [nps_reason] != &quot;No Reason&quot; then [nps_reason] END' />
      </column>
      <column caption='NPS Reason Filter' datatype='string' name='[Calculation_5883812176645689346]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = True&#10;THEN [nps_reason]&#10;ELSE [Calculation_5883812176645070848]&#10;End' />
      </column>
      <column caption='Ds Value Segment' datatype='string' name='[DS_VALUE_SEGMENT]' role='dimension' type='nominal' />
      <column caption='NPS Sub Reason Filter' datatype='string' name='[NPS Reason Filter (copy)_5883812176645988355]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = True&#10;THEN [nps_sub_reason]&#10;ELSE [NPS Reason without Nulls (copy)_5883812176645214209]&#10;End' />
      </column>
      <column caption='NPS Sub Reason without Nulls' datatype='string' name='[NPS Reason without Nulls (copy)_5883812176645214209]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [nps_sub_reason] != &quot;No reason&quot; then [nps_sub_reason] END' />
      </column>
