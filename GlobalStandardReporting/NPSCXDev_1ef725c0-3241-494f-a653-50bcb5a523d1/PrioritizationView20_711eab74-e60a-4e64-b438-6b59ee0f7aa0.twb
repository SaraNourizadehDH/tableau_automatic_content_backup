      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Validation - Field' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;HVC Segment&quot;'>
          <calculation class='tableau' formula='&quot;HVC Segment&quot;' />
        </column>
        <column caption='Sort by - Parameter' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Responses&quot;'>
          <calculation class='tableau' formula='&quot;Responses&quot;' />
        </column>
        <column caption='Include NAs/Null NPS Reason Parameter' datatype='boolean' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='true'>
          <calculation class='tableau' formula='true' />
        </column>
      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='prioritization_view' id='prioritization_view_03DD4E79EE5A48478151E50EC799CE16'>
            <properties context=''>
              <relation connection='bigquery.0yo25hu1axbcj51dzb03w0admoml' name='Custom SQL Query' type='text'><![CDATA[--Run the first 2 commands to delete exiting and create new table from scratch
--Run the third line for backfilling past data

-- INSERT INTO fulfillment-dwh-production.cl_cx.tactical_view_new_v2

-- DROP TABLE IF EXISTS fulfillment-dwh-production.cl_cx.prioritization_view;
-- CREATE TABLE fulfillment-dwh-production.cl_cx.prioritization_view AS

With 

--nps responses in the last 6 months (reporting_date is previous)
--customer_id, external_id are not needed in this script
--filters to exclude null (junk) entries are no longer needed as data table is excluding junk entries while importing to bigquery

nps_DH as ( 
SELECT 
  n.global_entity_id,
  ge.management_entity,
  ge.sub_entity,
  n.response_id,
  n.created_date,
  If(n.nps_reason is null or n.nps_reason='N/A', 'No Reason',n.nps_reason) AS nps_reason,
  coalesce(n.reason_finding_app_choice, n.reason_pricing, n.reason_delivery, n.reason_quality_accuracy, 
    n.reason_service_support, n.reason_deals_discount, 'No reason') AS nps_sub_reason,
  n.nps_score,
  n.analytical_customer_id,
  --n.customer_id,
FROM 
  `fulfillment-dwh-production.curated_data_shared_cx.nps_relational_all_survey_responses_all_markets` AS n
JOIN fulfillment-dwh-production.curated_data_shared_coredata.global_entities  AS ge
  ON n.global_entity_id = ge.global_entity_id
  AND ge.is_reporting_enabled
WHERE
  n.created_date Between Date_trunc(current_date-180, month) and Date_trunc(current_date, month)-1
  -- AND nps_score is not null
  -- AND nps_reason <<>> 'N/A'
  -- AND (external_id is not null AND n.global_entity_id is not null)
  -- AND customer_id is not null
),

--manually map global entity id for glovo nps data
glovo_mapping AS (
  Select 'AM' AS country, 'GV_AM' AS global_entity_id, 'GV - Armenia' AS sub_entity
  UNION ALL Select 'BA' AS country, 'GV_BA' AS global_entity_id, 'GV - Bosnia and Herzegovina' AS sub_entity
  UNION ALL Select 'BG' AS country, 'GV_BG' AS global_entity_id, 'GV - Bulgaria' AS sub_entity
  UNION ALL Select 'CI' AS country, 'GV_CI' AS global_entity_id, 'GV - Ivory Coast' AS sub_entity
  UNION ALL Select 'ES' AS country, 'GV_ES' AS global_entity_id, 'GV - Spain' AS sub_entity
  UNION ALL Select 'GE' AS country, 'GV_GE' AS global_entity_id, 'GV - Georgia' AS sub_entity
  UNION ALL Select 'HR' AS country, 'GV_HR' AS global_entity_id, 'GV - Croatia' AS sub_entity
  UNION ALL Select 'IT' AS country, 'GV_IT' AS global_entity_id, 'GV - Italy' AS sub_entity
  UNION ALL Select 'KE' AS country, 'GV_KE' AS global_entity_id, 'GV - Kenya' AS sub_entity
  UNION ALL Select 'KG' AS country, 'GV_KG' AS global_entity_id, 'GV - Kyrgyzstan' AS sub_entity
  UNION ALL Select 'KZ' AS country, 'GV_KZ' AS global_entity_id, 'GV - Kazakhstan' AS sub_entity
  UNION ALL Select 'MA' AS country, 'GV_MA' AS global_entity_id, 'GV - Morocco' AS sub_entity
  UNION ALL Select 'MD' AS country, 'GV_MD' AS global_entity_id, 'GV - Moldova' AS sub_entity
  UNION ALL Select 'ME' AS country, 'GV_ME' AS global_entity_id, 'GV - Montenegro' AS sub_entity
  UNION ALL Select 'NG' AS country, 'GV_NG' AS global_entity_id, 'GV - Nigeria' AS sub_entity
  UNION ALL Select 'PL' AS country, 'GV_PL' AS global_entity_id, 'GV - Poland' AS sub_entity
  UNION ALL Select 'PT' AS country, 'GV_PT' AS global_entity_id, 'GV - Portugal' AS sub_entity
  UNION ALL Select 'RO' AS country, 'GV_RO' AS global_entity_id, 'GV - Romania' AS sub_entity
  UNION ALL Select 'RS' AS country, 'GV_RS' AS global_entity_id, 'GV - Serbia' AS sub_entity
  UNION ALL Select 'TN' AS country, 'GV_TN' AS global_entity_id, 'GV - Tunisia' AS sub_entity
  UNION ALL Select 'UA' AS country, 'GV_UA' AS global_entity_id, 'GV - Ukraine' AS sub_entity
  UNION ALL Select 'UG' AS country, 'GV_UG' AS global_entity_id, 'GV - Uganda' AS sub_entity
),

--nps responses in the last 6 months (reporting_date is previous)
--filters added to exclude any potential junk entry
nps_glovo AS (
Select 
  m.global_entity_id,
  'Glovo' as management_entity,
  m.sub_entity,
  n.RESPONSE_ID,
  n.created_date,
  Coalesce(n.q2_area_dissatisfaction, 'No Reason') AS q2_area_dissatisfaction,
  Coalesce(n.detail_reason, 'No Reason') AS detail_reason,
  n.q1_nps_score,
  eam.ANALYTICAL_CUSTOMER_ID,
  --n.USER_ID,
from
  fulfillment-dwh-production.curated_data_shared_glovo.nps_ua_answers n
Join 
  glovo_mapping m 
  on n.country=m.country
JOIN fulfillment-dwh-production.curated_data_shared_mkt.braze_external_id_map eam
  ON m.global_entity_id = eam.global_entity_id
  AND Cast(n.user_id as String) = eam.customer_id
  AND Date(eam.LAST_ORDER_TIMESTAMP) >>= Date_trunc(current_date-270, month)
WHERE
  n.created_date  Between Date_trunc(current_date-180, month) and Date_trunc(current_date, month)-1
  AND n.q1_nps_score is not null
  AND (n.country is not null AND n.USER_ID is not null)
  --AND n.q2_area_dissatisfaction is not null
),

--combined nps data
DH_glovo_nps_union as (
SELECT 
  global_entity_id,
  management_entity,
  sub_entity,
  response_id,
  created_date,
  nps_reason,
  nps_sub_reason,
  nps_score,
  analytical_customer_id
FROM 
  nps_DH
UNION ALL
Select 
  global_entity_id,
  management_entity,
  sub_entity,
  RESPONSE_ID,
  created_date,
  q2_area_dissatisfaction,
  detail_reason,
  q1_nps_score,
  ANALYTICAL_CUSTOMER_ID,  
from
  nps_glovo 
),

--remove duplicate nps responses
nps_final as (
Select 
  * 
From (
  SELECT
    d.*,
    Row_number() Over (PARTITION BY d.global_entity_id, d.analytical_customer_id order by d.created_date desc) rnk
  FROM
    DH_glovo_nps_union d
  ) T
where 
  rnk=1
),

-- this one is a heavy join
-- LC Old segment and LC New Segment is available for daily snapshot. For a given nps response, we pull nps_date + 1 = snapshot_date
-- HVC Segment is available only for 1 day EOM. For a given nps response, we pull the previous most recent snapshot
user_profile as(
  Select
    n.*,
    Coalesce(u.segment.lifecycle_segment.all_verts, "Not Available") AS lifecycle_segment,
    Coalesce(u.segment.customer_segment.all_verts, "Not Available") AS customer_segment,
    Coalesce(hvc.DS_VALUE_SEGMENT, "Not Available") DS_VALUE_SEGMENT
  FROM
    nps_final n
  LEFT JOIN 
    `fulfillment-dwh-production.curated_data_shared_coda_datamart.user_feed_non_pii_historization_view` u
    ON n.global_entity_id = u.global_entity_id
    AND n.analytical_customer_id =  u.analytical_customer_id
    AND u.snapshot_date Between Date_trunc(current_date-180, month) and Date_trunc(current_date, month)
    AND u.snapshot_date = n.created_date + 1 
    --below filter is mandatory for querying
    AND u.snapshot_date Between Date_trunc(current_date-180, month) and Date_trunc(current_date, month)
    
  LEFT JOIN fulfillment-dwh-production.curated_data_shared_mkt.bima_customer_value_segmentation hvc
    ON hvc.global_entity_id = n.global_entity_id
    AND hvc.analytical_customer_id = n.analytical_customer_id 
    AND Date(hvc.snapshot_date) between Date_trunc(current_date-210, month) and Date_trunc(current_date, month)
    AND Date(hvc.snapshot_date)= date_trunc(n.created_date,month)-1
),

-- Select 
--   Management_entity,
--   Date_trunc(created_date,month) created_date,
--   count(*) records, 
--   count(response_id) responses, 
--   count(Case when customer_segment <<>> "Not Available" then customer_segment End) customer_segment, 
--   count(Case when lifecycle_segment <<>> "Not Available" then lifecycle_segment End) lifecycle_segment, 
--   count(Case when DS_VALUE_SEGMENT <<>> "Not Available" then DS_VALUE_SEGMENT End) DS_VALUE_SEGMENT
-- from user_profile
-- Group by 1,2
-- Order by 1,2


--The below block is excluded as retention related metrics and not being looked into currently
/*
--pull all the orders for NPS respondents and only those after NPS response date
--only include successful orders
--exclude gmv outliers
orders_nps_combined as (
Select 
  d.management_entity,
  d.sub_entity,
  d.global_entity_id,
  --d.customer_id,
  d.analytical_customer_id, 
  d.lifecycle_segment,
  d.customer_segment,
  d.DS_VALUE_SEGMENT,

  --nps information
  d.response_id,
  d.nps_score,
  d.nps_reason,
  d.nps_sub_reason,
  
  --order information
  o.order_id,
  --o.customer_account_id,
  d.created_date as nps_date,
  o.partition_date_local AS order_1, --next order date
  Date(Lead(partition_date_local,1) Over (Partition by o.global_entity_id, o.customer_id Order by o.partition_date_local)) order_2,  -- +2 order date
  Case
    When order_id is not null then
      Row_Number() Over (Partition by o.global_entity_id, o.customer_id Order by o.partition_date_local)
    Else null
  End order_no
  --Count(*) Over (Partition by o.global_entity_id, o.customer_id ) total_orders,
from
  user_profile d
LEFT JOIN
  `fulfillment-dwh-production.curated_data_shared_coredata_business.orders` AS o
  ON o.global_entity_id = d.global_entity_id
  AND o.analytical_customer_id = d.analytical_customer_id
  AND o.partition_date_local Between Date_trunc(current_date-270, month) and Date_trunc(current_date, month)
  AND o.partition_date_local >>= d.created_date    
  AND o.is_successful
  AND (o.value.order.gmv_eur << 2000 OR o.value.order.gmv_eur IS NULL)
  and o.customer_id is not null
),


--capture only 1 nps response per customer and compute the order days for the next 2 orders
--include those customers as well who never really came back after nps response
temp AS (
Select 
  o.* except (order_no),
  DATE_DIFF(o.order_1, o.nps_date, DAY) Reorder_1_days,
  DATE_DIFF(o.order_2, o.order_1, DAY) Reorder_2_days, 
from 
  orders_nps_combined o
where
  order_no = 1 or order_no is null
Order by 
  management_entity,
  sub_entity,
  global_entity_id,
  customer_id,
  order_no
),

--1000 is just a placeholder to ensure formula runs correctly
final as (
SELECT
  t.*,
  If(Coalesce(Reorder_1_days,1000)<<=28,1,0) AS first_order_retention,   
  If(Coalesce(Reorder_1_days,1000)<<=28 and Coalesce(Reorder_2_days,1000)<<=28,1,0) AS second_order_retention,
  If(nps_score<<=3,1,0) churners_0to3,
  Case
    When management_entity='Glovo' and Coalesce(Reorder_1_days,1000)>>69 then 1 
    When management_entity='Talabat' and Coalesce(Reorder_1_days,1000)>>52 then 1 
    When management_entity='Pedidosya' and Coalesce(Reorder_1_days,1000)>>68 then 1 
    When management_entity='DH Greece' and sub_entity in ('eFood','Foody') and Coalesce(Reorder_1_days,1000)>>46 then 1
    When management_entity='DH Europe' and sub_entity ='Yemeksepeti' and Coalesce(Reorder_1_days,1000)>>70 then 1 
    When management_entity='DH Europe' and Coalesce(Reorder_1_days,1000)>>75 then 1 
    When management_entity='Foodpanda APAC' and Coalesce(Reorder_1_days,1000)>>63 then 1 
    When management_entity='HungerStation' and Coalesce(Reorder_1_days,1000)>>70 then 1 
    Else 0
  End As churn_by_retention_team,
  If(order_1 is null,1,0) churn_permanent
From
  temp t
),
*/

final_aggregated AS (
Select  
  n.management_entity,
  n.sub_entity,
  n.global_entity_id,
  n.lifecycle_segment,
  n.customer_segment,
  n.DS_VALUE_SEGMENT,
  n.nps_reason,
  n.nps_sub_reason,
  Date_trunc(n.created_date,month) AS reporting_month,
  SUM(CASE WHEN n.nps_score >> 8 THEN 1 ELSE 0 END) nps_promoters, 
  SUM(CASE WHEN n.nps_score <<= 6 THEN 1 ELSE 0 END) nps_detractors,   
  SUM(CASE WHEN n.nps_score IS NOT NULL THEN 1 ELSE 0 END) nps_responses,
  SUM(CASE WHEN n.nps_score <<= 3 THEN 1 ELSE 0 END) churners_0to3,

  /*
  Sum(first_order_retention) first_order_retention,
  Sum(second_order_retention) second_order_retention,
  Sum(churners_0to3) churners_0to3,
  Sum(churn_by_retention_team) churn_by_retention_team,
  Sum(churn_permanent) churn_permanent,
  */
from
  user_profile n
Group by 1,2,3,4,5,6,7,8,9
Order by 1,2,3,4,5,6,7,8,9
)

Select * from final_aggregated]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='For Validation purpose'>
      <table>
        <view>
          <datasources>
            <datasource caption='prioritization_view (cl_cx)' name='federated.0fistks17bt8w11awerwu1cl7dy8' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Validation - Field' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;HVC Segment&quot;'>
              <calculation class='tableau' formula='&quot;HVC Segment&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0fistks17bt8w11awerwu1cl7dy8'>
            <column caption='$Validation - Dynamic Field' datatype='string' name='[Calculation_2742058907486814208]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Lifecycle Segment Old&apos; Then [lifecycle_segment]&#10;WHEN &apos;Lifecycle Segment New&apos; Then [customer_segment]&#10;WHEN &apos;HVC Segment&apos; Then [DS_VALUE_SEGMENT]&#10;End' />
            </column>
            <column caption='Ds Value Segment' datatype='string' name='[DS_VALUE_SEGMENT]' role='dimension' type='nominal' />
            <column caption='Customer Segment' datatype='string' name='[customer_segment]' role='dimension' type='nominal' />
            <column caption='Lifecycle Segment' datatype='string' name='[lifecycle_segment]' role='dimension' type='nominal' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2742058907486814208]' derivation='None' name='[none:Calculation_2742058907486814208:nk]' pivot='key' type='nominal' />
            <column-instance column='[DS_VALUE_SEGMENT]' derivation='None' name='[none:DS_VALUE_SEGMENT:nk]' pivot='key' type='nominal' />
            <column-instance column='[customer_segment]' derivation='None' name='[none:customer_segment:nk]' pivot='key' type='nominal' />
            <column-instance column='[lifecycle_segment]' derivation='None' name='[none:lifecycle_segment:nk]' pivot='key' type='nominal' />
            <column-instance column='[management_entity]' derivation='None' name='[none:management_entity:nk]' pivot='key' type='nominal' />
            <column-instance column='[nps_reason]' derivation='None' name='[none:nps_reason:nk]' pivot='key' type='nominal' />
            <column-instance column='[nps_sub_reason]' derivation='None' name='[none:nps_sub_reason:nk]' pivot='key' type='nominal' />
            <column-instance column='[reporting_month]' derivation='None' name='[none:reporting_month:qk]' pivot='key' type='quantitative' />
            <column-instance column='[sub_entity]' derivation='None' name='[none:sub_entity:nk]' pivot='key' type='nominal' />
            <column caption='Nps Detractors' datatype='integer' name='[nps_detractors]' role='measure' type='quantitative' />
            <column caption='Nps Reason' datatype='string' name='[nps_reason]' role='dimension' type='nominal' />
            <column caption='Nps Responses' datatype='integer' name='[nps_responses]' role='measure' type='quantitative' />
            <column caption='Nps Sub Reason' datatype='string' name='[nps_sub_reason]' role='dimension' type='nominal' />
            <column caption='Reporting Month' datatype='date' name='[reporting_month]' role='dimension' type='ordinal' />
            <column caption='Sub Entity' datatype='string' name='[sub_entity]' role='dimension' type='nominal' />
            <column-instance column='[nps_detractors]' derivation='Sum' name='[sum:nps_detractors:qk]' pivot='key' type='quantitative' />
            <column-instance column='[nps_responses]' derivation='Sum' name='[sum:nps_responses:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0fistks17bt8w11awerwu1cl7dy8].[:Measure Names]'>
            <groupfilter function='union' user:op='manual'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0fistks17bt8w11awerwu1cl7dy8].[sum:nps_responses:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0fistks17bt8w11awerwu1cl7dy8].[sum:nps_detractors:qk]&quot;' />
            </groupfilter>
          </filter>
          <manual-sort column='[federated.0fistks17bt8w11awerwu1cl7dy8].[:Measure Names]' direction='ASC'>
            <dictionary>
              <bucket>&quot;[federated.0fistks17bt8w11awerwu1cl7dy8].[sum:nps_responses:qk]&quot;</bucket>
              <bucket>&quot;[federated.0fistks17bt8w11awerwu1cl7dy8].[sum:first_order_retention:qk]&quot;</bucket>
              <bucket>&quot;[federated.0fistks17bt8w11awerwu1cl7dy8].[sum:second_order_retention:qk]&quot;</bucket>
              <bucket>&quot;[federated.0fistks17bt8w11awerwu1cl7dy8].[sum:nps_detractors:qk]&quot;</bucket>
              <bucket>&quot;[federated.0fistks17bt8w11awerwu1cl7dy8].[sum:churn_by_retention_team:qk]&quot;</bucket>
              <bucket>&quot;[federated.0fistks17bt8w11awerwu1cl7dy8].[sum:churn_permanent:qk]&quot;</bucket>
