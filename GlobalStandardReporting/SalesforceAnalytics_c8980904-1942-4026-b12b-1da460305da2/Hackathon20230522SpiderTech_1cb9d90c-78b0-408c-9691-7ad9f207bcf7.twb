      <aliases enabled='yes' />
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([successful_orders])) - LOOKUP(ZN(SUM([successful_orders])), -1)) / ABS(LOOKUP(ZN(SUM([successful_orders])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Shape Size' datatype='real' name='[Calculation_1829587377449205761]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &quot;Population&quot;&#13;&#10;THEN [h8_population]&#13;&#10;ELSE [successful_orders]&#13;&#10;END' />
      </column>
      <column caption='Null Exclusion' datatype='string' name='[Calculation_1829587377481007108]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF NOT ISNULL([name]) THEN  &apos;NULL&apos; ELSE &apos;NOT NULL&apos; END' />
      </column>
      <column caption='Total Orders wo Catg' datatype='real' name='[Calculation_1829587377785606149]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{Fixed [global_entity_id],[city],[id],[report_week (copy)_1829587377479430147]: sum([successful_orders])}' />
      </column>
      <column caption='City Rank' datatype='string' name='[Calculation_1829587377809592328]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [source_table]=&apos;Vendor&apos; THEN  [city_orders_rank] ELSE  &apos;Lead&apos; END' />
      </column>
      <column caption='Total Partners' datatype='integer' name='[Calculation_1829587377825038345]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd([salesforce_grid_id])' />
      </column>
      <column caption='(ZN(SUM([Total Orders])) - LOOKUP(ZN(SUM([Total Orders])), -1...' datatype='real' name='[Calculation_1829587377840115724]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([successful_orders])) - LOOKUP(ZN(SUM([successful_orders])), -1)) / ABS(LOOKUP(ZN(SUM([successful_orders])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='NULL' datatype='integer' name='[Calculation_1829587378454761499]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(NULL)' />
      </column>
      <column caption='Orders' datatype='real' name='[Cell Monthly Orders (copy)_1829587377457307650]' role='measure' type='quantitative'>
