              <calculation class='tableau' formula='CASE [Parameters].[Column by (copy)_208221114819080202]&#10;WHEN &apos;-&apos; THEN &apos;&apos;&#10;WHEN &apos;date&apos; THEN STR([date])&#10;WHEN &apos;ai_experience&apos; THEN STR([ai_experince])&#10;WHEN &apos;launch_phase&apos; THEN STR([launch_phase])&#10;WHEN &apos;day_tag&apos; THEN STR([day_tag])&#10;WHEN &apos;at_least_1i_accepted&apos; THEN &apos;&apos;&#10;WHEN &apos;brand_name&apos; THEN STR([brand_name])&#10;WHEN &apos;country_name&apos; THEN STR([country_name])&#10;WHEN &apos;gid&apos; THEN STR([global_entity_id])&#10;WHEN &apos;vendor_class&apos; THEN STR([vendor_class])&#10;WHEN &apos;master_category&apos; THEN &apos;&apos;&#10;WHEN &apos;norm_dish&apos; THEN &apos;&apos;&#10;WHEN &apos;class_prob&apos; THEN &apos;&apos;&#10;WHEN &apos;has_description&apos; THEN &apos;&apos;&#10;WHEN &apos;has_description_5s&apos; THEN &apos;&apos;&#10;WHEN &apos;empty_prod_share&apos; THEN STR([empty_products_share])&#10;WHEN &apos;empty_prod_cnt&apos; THEN STR([empty_products_cnt])&#10;WHEN &apos;suggested_image_score&apos; THEN STR([image_suggested_score_avg])&#10;WHEN &apos;accepted_image_score&apos; THEN &apos;&apos;&#10;END' />
            </column>
