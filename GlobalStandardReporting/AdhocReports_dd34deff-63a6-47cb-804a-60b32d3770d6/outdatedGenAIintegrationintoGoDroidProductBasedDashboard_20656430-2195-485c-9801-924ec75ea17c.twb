            <column caption='Period (funnel)' datatype='datetime' name='[Calculation_208221114824335378]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Period (copy)_208221114824290321]&#10;WHEN &apos;day&apos; THEN DATE([date])&#10;WHEN &apos;week&apos; THEN DATETRUNC(&apos;week&apos;, DATE([date]))&#10;WHEN &apos;month&apos; THEN DATETRUNC(&apos;month&apos;, DATE([date]))&#10;WHEN &apos;quarter&apos; THEN DATETRUNC(&apos;quarter&apos;, DATE([date]))&#10;WHEN &apos;all_time&apos; THEN DATE(&apos;2024-03-05&apos;)&#10;END' />
