          <datasource-dependencies datasource='federated.0kk4iw107oxc540zpa4891wx6my6'>
            <column caption='Period' datatype='datetime' name='[Calculation_208221114735542272]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;day&apos; THEN DATE([date])&#10;WHEN &apos;week&apos; THEN DATETRUNC(&apos;week&apos;, DATE([date]))&#10;WHEN &apos;month&apos; THEN DATETRUNC(&apos;month&apos;, DATE([date]))&#10;WHEN &apos;quarter&apos; THEN DATETRUNC(&apos;quarter&apos;, DATE([date]))&#10;WHEN &apos;all_time&apos; THEN DATE(&apos;2024-02-01&apos;)&#10;END' />
            </column>
            <column caption='Column by' datatype='string' name='[Calculation_208221114750218242]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Column by (copy)_208221114749448193]&#10;WHEN &apos;-&apos; THEN &apos;&apos;&#10;WHEN &apos;day_tag&apos; THEN STR([day_tag])&#10;WHEN &apos;ai_experience&apos; THEN STR([ai_experince_group])&#10;WHEN &apos;at_least_1i_accepted&apos; THEN STR([image_accepted_group])&#10;WHEN &apos;brand_name&apos; THEN STR([brand_name])&#10;WHEN &apos;country_name&apos; THEN STR([country_name])&#10;WHEN &apos;gid&apos; THEN STR([global_entity_id])&#10;WHEN &apos;vendor_class&apos; THEN STR([vendor_class])&#10;WHEN &apos;empty_prod_share&apos; THEN STR([empty_products_share])&#10;WHEN &apos;platform&apos; THEN STR([platform])&#10;END' />
            </column>
            <column caption='Number of Vendors' datatype='real' name='[Calculation_460211587369205760]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_cnt])/COUNTD([platform])' />
            </column>
            <column caption='Vendor Page Opened' datatype='real' name='[Calculation_460211587369390081]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;conversion&apos; THEN SUM([vendor_opened])/SUM([vendor_opened]) * 100&#10;ELSE SUM([vendor_opened])/[Calculation_460211587370188802]&#10;END' />
            </column>
            <column caption='Metric Value' datatype='real' name='[Calculation_460211587370188802]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;total&apos; THEN 1&#10;WHEN &apos;per_vendor&apos; THEN [Calculation_460211587369205760]&#10;END' />
            </column>
            <column caption='Number of Orders' datatype='real' name='[Number of Ordered Products (copy)_460211587371053062]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;conversion&apos; THEN SUM([order_cnt])/SUM([vendor_opened]) * 100&#10;ELSE SUM([order_cnt])/[Calculation_460211587370188802]&#10;END' />
            </column>
            <column caption='GMV (in euro)' datatype='real' name='[Number of Orders (copy)_208221114760716292]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_eur])/[Calculation_460211587370188802]' />
