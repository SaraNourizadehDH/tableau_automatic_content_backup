      <aliases enabled='yes' />
      <column caption='rating_avg' datatype='real' name='[Calculation_537335770695086080]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([rating_sum])/SUM([rating_cnt])' />
      </column>
      <column caption='Period' datatype='datetime' name='[Calculation_898257053909143552]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;day&apos; THEN DATE([event_date])&#10;WHEN &apos;week&apos; THEN DATETRUNC(&apos;week&apos;, DATE([event_date]))&#10;WHEN &apos;month&apos; THEN DATETRUNC(&apos;month&apos;, DATE([event_date]))&#10;WHEN &apos;quarter&apos; THEN DATETRUNC(&apos;quarter&apos;, DATE([event_date]))&#10;WHEN &apos;all_time&apos; THEN {FIXED: MIN([event_date])}&#10;END' />
      </column>
      <column caption='shown_to_opened' datatype='real' name='[Calculation_898257053909303297]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([product_opened])/SUM([vendor_is_shown])' />
      </column>
      <column caption='column_by' datatype='string' name='[Calculation_898257053915815940]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &apos;-&apos; THEN STR(&apos;&apos;)&#10;    WHEN &apos;dh_platform&apos; THEN STR([dh_platform])&#10;    WHEN &apos;gid&apos; THEN STR([global_entity_id])&#10;    WHEN &apos;is_chain&apos; THEN STR([is_chain])&#10;    WHEN &apos;master_category&apos; THEN STR([master_category])&#10;    WHEN &apos;has_image&apos; THEN STR([has_image])&#10;    WHEN &apos;has_description&apos; THEN STR([has_description])&#10;    WHEN &apos;platform&apos; THEN STR([platform])&#10;    WHEN &apos;gen_ai_total&apos; THEN STR([accepted_gen_ai_image_total])&#10;    WHEN &apos;gen_ai_by_day&apos; THEN STR([accepted_gen_ai_image_by_that_day])&#10;END' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='product_level_data' datatype='table' name='[__tableau_internal_object_id__].[okr_dashboard_q1_2024_data_EE10F4F5732F4645BAB64BB7003E97DB]' role='measure' type='quantitative' />
