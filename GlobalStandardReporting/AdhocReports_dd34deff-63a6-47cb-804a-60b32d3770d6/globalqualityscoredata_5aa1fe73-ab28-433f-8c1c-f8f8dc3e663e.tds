<!-- build 20231.24.0118.1101                               -->
<datasource formatted-name='federated.1szwm1z0kuzxio1dgl5pe0ba85zl' inline='true' source-platform='linux' version='18.1' xml:base='http://tableau.deliveryhero.net' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <document-format-change-manifest>
