<!-- build 20231.24.0118.1101                               -->
<datasource formatted-name='federated.1f4ujqa01nqx3816y2ptc1sbglxj' inline='true' source-platform='linux' version='18.1' xml:base='http://tableau.deliveryhero.net' xmlns:user='http://www.tableausoftware.com/xml/user'>
