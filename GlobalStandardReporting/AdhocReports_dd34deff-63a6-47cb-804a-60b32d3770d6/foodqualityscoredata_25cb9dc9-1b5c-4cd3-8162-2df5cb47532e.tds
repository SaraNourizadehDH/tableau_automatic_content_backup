  <object-graph>
    <objects>
      <object caption='food_quality_score_data' id='_51F68DF64A7A441BBE6AD8453BB5EF5A'>
        <properties context=''>
          <relation connection='bigquery.0inyjfk0ti663w1gdko7c1tkyopr' name='Custom SQL Query' type='text'>WITH&#10;vendors_data AS(&#10;  SELECT&#10;    vkm.global_entity_id,&#10;    vkm.vendor_id,&#10;    vkm.vendor_class&#10;  FROM `fulfillment-dwh-production.curated_data_shared_coredata_business.agg_vendor_kpis_monthly` vkm&#10;  WHERE vkm.vendor_class IS NOT NULL&#10;  QUALIFY ROW_NUMBER() OVER(PARTITION BY vkm.global_entity_id, vkm.vendor_id ORDER BY report_month DESC) = 1&#10;),&#10;product_images_data AS(&#10;  SELECT&#10;    p.global_entity_id,&#10;    COALESCE(p._platform_vendor_id, p.vendor_id) AS vendor_id,&#10;    p.product_id,&#10;    MAX(LOWER(p.name)) AS name,&#10;    MAX(LOWER(p.description)) AS description,&#10;    MAX(img.url) AS image_url&#10;  FROM `fulfillment-dwh-production.curated_data_shared_data_stream.products` p&#10;  JOIN `fulfillment-dwh-production.curated_data_shared_coredata_business.vendors` v&#10;    ON 1=1&#10;    -- AND p.metadata.source IN (&apos;PANDORA&apos;,&apos;TB&apos;,&apos;PY&apos;,&apos;HS&apos;,&apos;EFOOD&apos;,&apos;FOODY&apos;)&#10;    AND p.global_entity_id = v.global_entity_id&#10;    AND COALESCE(p._platform_vendor_id, p.vendor_id) = v.vendor_id&#10;    AND v.is_test_vendor = FALSE&#10;    AND NOT REGEXP_CONTAINS(LOWER(v.vendor_name), &quot;test&quot;)&#10;    AND v.is_available = TRUE&#10;    AND v.vertical_type = &apos;restaurants&apos;&#10;  LEFT JOIN&#10;    UNNEST(image_urls) AS img&#10;  WHERE p.active = TRUE&#10;    AND LENGTH(p.name) &gt;&gt; 1&#10;    AND (p.created_at IS NOT NULL OR p.global_entity_id IN (&apos;HS_SA&apos;, &apos;HS_BH&apos;))&#10;    AND p.global_entity_id IN (SELECT global_entity_id FROM `fulfillment-dwh-production.curated_data_shared_coredata.global_entities` WHERE is_reporting_enabled)&#10;  GROUP BY 1,2,3&#10;),&#10;mapping AS (&#10;  SELECT &apos;FO_NO&apos; AS global_entity_id, &apos;fd-no&apos; AS code UNION ALL&#10;  SELECT &apos;FP_BD&apos; AS global_entity_id, &apos;fd-bd&apos; AS code UNION ALL&#10;  SELECT &apos;FP_HK&apos; AS global_entity_id, &apos;fd-hk&apos; AS code UNION ALL&#10;  SELECT &apos;FP_KH&apos; AS global_entity_id, &apos;fd-kh&apos; AS code UNION ALL&#10;  SELECT &apos;FP_LA&apos; AS global_entity_id, &apos;fd-la&apos; AS code UNION ALL&#10;  SELECT &apos;FP_MM&apos; AS global_entity_id, &apos;fd-mm&apos; AS code UNION ALL&#10;  SELECT &apos;FP_MY&apos; AS global_entity_id, &apos;fd-my&apos; AS code UNION ALL&#10;  SELECT &apos;FP_PH&apos; AS global_entity_id, &apos;fd-ph&apos; AS code UNION ALL&#10;  SELECT &apos;FP_PK&apos; AS global_entity_id, &apos;fd-pk&apos; AS code UNION ALL&#10;  SELECT &apos;FP_SG&apos; AS global_entity_id, &apos;fd-sg&apos; AS code UNION ALL&#10;  SELECT &apos;FP_SK&apos; AS global_entity_id, &apos;fd-sk&apos; AS code UNION ALL&#10;  SELECT &apos;FP_TH&apos; AS global_entity_id, &apos;fd-th&apos; AS code UNION ALL&#10;  SELECT &apos;FP_TW&apos; AS global_entity_id, &apos;fd-tw&apos; AS code UNION ALL&#10;  SELECT &apos;HN_DK&apos; AS global_entity_id, &apos;fd-dk&apos; AS code UNION ALL&#10;  SELECT &apos;MJM_AT&apos; AS global_entity_id, &apos;fd-mj&apos; AS code UNION ALL&#10;  SELECT &apos;NP_HU&apos; AS global_entity_id, &apos;fd-hu&apos; AS code UNION ALL&#10;  SELECT &apos;OP_SE&apos; AS global_entity_id, &apos;fd-op&apos; AS code UNION ALL&#10;  SELECT &apos;PO_FI&apos; AS global_entity_id, &apos;fd-po&apos; AS code UNION ALL&#10;  SELECT &apos;DJ_CZ&apos; AS global_entity_id, &apos;fd-cz&apos; AS code UNION ALL&#10;  SELECT &apos;YS_TR&apos; AS global_entity_id, &apos;fd-tr&apos; AS code&#10;),&#10;vendor_images_data AS(&#10;  SELECT&#10;    v.global_entity_id,&#10;    v.vendor_id,&#10;    CASE WHEN MAX(v.chain_id IS NOT NULL) = TRUE THEN &apos;Is Chain&apos; ELSE &apos;Not Chain&apos; END AS is_chain,&#10;    MAX(CASE WHEN c.is_main_category = TRUE THEN c.category_name END) AS main_category_name,&#10;    MAX(CASE&#10;          WHEN v.metadata.stream_source = &apos;PANDORA&apos;THEN CONCAT(&apos;https://images.deliveryhero.io/image/&apos;, m.code, &apos;/LH/&apos;, v.vendor_id, &apos;-listing.jpg&apos;)&#10;          WHEN v.global_entity_id LIKE &apos;HS_%&apos; THEN COALESCE(mhs.android_cover_photo_url, images_urls.header)&#10;          ELSE images_urls.header&#10;        END) AS image_url,&#10;    MAX(CASE&#10;          WHEN v.global_entity_id LIKE &apos;HS_%&apos; THEN COALESCE(mhs.ios_cover_photo_url, images_urls.header)&#10;          ELSE NULL&#10;        END) AS image_url_2&#10;  FROM `fulfillment-dwh-production.curated_data_shared_coredata_business.vendors` v&#10;  LEFT JOIN&#10;    UNNEST(categories) c&#10;  LEFT JOIN mapping m&#10;    ON v.global_entity_id = m.global_entity_id&#10;  LEFT JOIN `dh-codapro-analytics-2460.test_aleksei.hs_vendor_header_image_2023_02_23` mhs&#10;    ON v.global_entity_id LIKE &apos;HS_%&apos;&#10;    AND v.vendor_id = mhs.branch_id&#10;  WHERE 1=1&#10;    -- AND v.metadata.stream_source IN (&apos;PANDORA&apos;,&apos;TB&apos;,&apos;PY&apos;,&apos;HS&apos;,&apos;EFOOD&apos;,&apos;FOODY&apos;)&#10;    AND v.is_test_vendor = FALSE&#10;    AND NOT REGEXP_CONTAINS(LOWER(v.vendor_name), &quot;test&quot;)&#10;    AND v.is_available = TRUE&#10;    AND v.vertical_type = &apos;restaurants&apos;&#10;    AND v.global_entity_id IN (SELECT global_entity_id FROM `fulfillment-dwh-production.curated_data_shared_coredata.global_entities` WHERE is_reporting_enabled)&#10;  GROUP BY 1,2&#10;),&#10;images_data AS(&#10;  SELECT&#10;    CASE&#10;      WHEN CONTAINS_SUBSTR(image_url, &quot;fd-au/efood&quot;) OR CONTAINS_SUBSTR(image_url, &quot;fd-au/FY_CY&quot;)&#10;        THEN JSON_VALUE(labels, &apos;$.original_url&apos;)&#10;      ELSE image_url&#10;    END AS image_url,&#10;    CAST(quality_score AS FLOAT64) AS quality_score,&#10;    insert_date&#10;  FROM `dhh-images.quality_us.images`&#10;  WHERE CASE&#10;          WHEN CONTAINS_SUBSTR(image_url, &quot;fd-au/efood&quot;) OR CONTAINS_SUBSTR(image_url, &quot;fd-au/FY_CY&quot;)&#10;            THEN JSON_VALUE(labels, &apos;$.original_url&apos;)&#10;          ELSE image_url&#10;        END IN(SELECT image_url FROM product_images_data)&#10;        OR&#10;        CASE&#10;          WHEN CONTAINS_SUBSTR(image_url, &quot;fd-au/efood&quot;) OR CONTAINS_SUBSTR(image_url, &quot;fd-au/FY_CY&quot;)&#10;            THEN JSON_VALUE(labels, &apos;$.original_url&apos;)&#10;          ELSE image_url&#10;        END IN(SELECT image_url FROM vendor_images_data)&#10;  QUALIFY ROW_NUMBER() OVER(PARTITION BY CASE&#10;                              WHEN CONTAINS_SUBSTR(image_url, &quot;fd-au/efood&quot;) OR CONTAINS_SUBSTR(image_url, &quot;fd-au/FY_CY&quot;)&#10;                                THEN JSON_VALUE(labels, &apos;$.original_url&apos;)&#10;                              ELSE image_url&#10;                            END ORDER BY insert_date DESC) = 1&#10;),&#10;product_images_data_fin AS(&#10;  SELECT&#10;    p.global_entity_id,&#10;    p.vendor_id,&#10;    AVG(CASE WHEN id.quality_score IS NOT NULL THEN id.quality_score END) AS product_image_quality,&#10;    SAFE_DIVIDE(COUNT(DISTINCT CASE WHEN p.image_url IS NOT NULL AND p.image_url &lt;&lt;&gt;&gt; &apos;&apos; THEN p.product_id END),&#10;      COUNT(DISTINCT p.product_id)) AS product_image_coverage,&#10;    SAFE_DIVIDE(COUNT(DISTINCT CASE WHEN p.description IS NOT NULL AND LENGTH(p.description) &gt;&gt; 0 THEN p.product_id END),&#10;      COUNT(DISTINCT p.product_id)) AS product_description_coverage,&#10;    SAFE_DIVIDE(COUNT(DISTINCT CASE WHEN (p.description IS NOT NULL AND LENGTH(p.description) &gt;&gt; 0) AND LENGTH(p.description) &gt;&gt;= 5 AND p.description &lt;&lt;&gt;&gt; p.name THEN p.product_id END),&#10;      COUNT(DISTINCT CASE WHEN p.description IS NOT NULL AND LENGTH(p.description) &gt;&gt; 0 THEN p.product_id END)) AS product_description_quality,&#10;    SAFE_DIVIDE(COUNT(DISTINCT CASE WHEN (p.description IS NOT NULL AND LENGTH(p.description) &gt;&gt; 0) AND LENGTH(p.description) &gt;&gt;= 5 THEN p.product_id END),&#10;      COUNT(DISTINCT CASE WHEN p.description IS NOT NULL AND LENGTH(p.description) &gt;&gt; 0 THEN p.product_id END)) AS product_description_quality_more_5s,&#10;    SAFE_DIVIDE(COUNT(DISTINCT CASE WHEN (p.description IS NOT NULL AND LENGTH(p.description) &gt;&gt; 0) AND p.description &lt;&lt;&gt;&gt; p.name THEN p.product_id END),&#10;      COUNT(DISTINCT CASE WHEN p.description IS NOT NULL AND LENGTH(p.description) &gt;&gt; 0 THEN p.product_id END)) AS product_description_quality_no_match,&#10;    SAFE_DIVIDE(COUNT(DISTINCT CASE WHEN (p.image_url IS NOT NULL AND p.image_url &lt;&lt;&gt;&gt; &apos;&apos;) AND id.quality_score IS NOT NULL THEN p.product_id END),&#10;      COUNT(DISTINCT CASE WHEN p.image_url IS NOT NULL AND p.image_url &lt;&lt;&gt;&gt; &apos;&apos; THEN p.product_id END)) AS product_image_score_coverage&#10;  FROM product_images_data p&#10;  LEFT JOIN images_data id&#10;    ON p.image_url = id.image_url&#10;  GROUP BY 1,2&#10;),&#10;vendor_images_data_fin AS(&#10;  SELECT&#10;    v.global_entity_id,&#10;    v.vendor_id,&#10;    v.is_chain,&#10;    v.main_category_name,&#10;    AVG(CASE WHEN COALESCE(id.quality_score, id_2.quality_score) IS NOT NULL THEN COALESCE(id.quality_score, id_2.quality_score) END) AS vendor_image_quality,&#10;    MAX(CASE WHEN COALESCE(id.quality_score, id_2.quality_score) IS NOT NULL THEN 1 ELSE 0 END) AS vendor_image_score_coverage,&#10;    MAX(CASE WHEN v.image_url IS NOT NULL THEN 1 ELSE 0 END) AS vendor_image_coverage&#10;  FROM vendor_images_data v&#10;  LEFT JOIN images_data id&#10;    ON v.image_url = id.image_url&#10;  LEFT JOIN images_data id_2&#10;    ON v.image_url = id_2.image_url&#10;  GROUP BY 1,2,3,4&#10;)&#10;SELECT&#10;  v.global_entity_id,&#10;  v.vendor_id,&#10;  IFNULL(vd.vendor_class, &apos;Z&apos;) AS vendor_class,&#10;  v.is_chain,&#10;  v.main_category_name,&#10;  ge.country_name,&#10;  ge.management_entity,&#10;  CASE&#10;    WHEN v.global_entity_id = &apos;YS_TR&apos; THEN &apos;Yemeksepeti&apos;&#10;    WHEN ge.brand_name IN (&apos;Foody&apos;, &apos;eFood&apos;) THEN &apos;eFood&apos;&#10;    ELSE ge.brand_name&#10;  END AS brand_name,&#10;  ge.sub_entity,&#10;  ge.segment,&#10;  v.vendor_image_quality,&#10;  p.product_image_coverage,&#10;  p.product_image_quality,&#10;  p.product_description_coverage,&#10;  p.product_description_quality,&#10;  p.product_description_quality_more_5s,&#10;  p.product_description_quality_no_match,&#10;  IFNULL(p.product_image_score_coverage, 0) AS product_image_score_coverage,&#10;  IFNULL(v.vendor_image_score_coverage, 0) AS vendor_image_score_coverage,&#10;  vendor_image_coverage,&#10;  CURRENT_TIMESTAMP AS last_updated_at&#10;FROM vendor_images_data_fin v&#10;JOIN `fulfillment-dwh-production.curated_data_shared_coredata.global_entities` ge&#10;  ON v.global_entity_id = ge.global_entity_id&#10;  AND ge.is_reporting_enabled&#10;JOIN product_images_data_fin p&#10;  ON v.global_entity_id = p.global_entity_id&#10;  AND v.vendor_id = p.vendor_id&#10;LEFT JOIN vendors_data vd&#10;  ON v.global_entity_id = vd.global_entity_id&#10;  AND v.vendor_id = vd.vendor_id</relation>
        </properties>
        <properties context='extract'>
          <relation name='Extract' table='[Extract].[Extract]' type='table' />
        </properties>
      </object>
    </objects>
  </object-graph>
</datasource>
