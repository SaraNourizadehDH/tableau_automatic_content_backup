  <column caption='Vendor Product Images Status' datatype='string' name='[Calculation_140315325227569152]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF [product_image_score_coverage] &gt; 0 THEN &apos;Has Scored Images&apos;&#10;ELSE &apos;No Scored Images&apos;&#10;END' />
  </column>
  <column caption='score' datatype='real' name='[Calculation_390476209677545472]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='[product_image_coverage] * 0.2&#10;+&#10;[product_image_quality] * 0.16&#10;+&#10;[vendor_image_quality] * 0.24&#10;+&#10;[product_description_coverage] * 0.2&#10;+&#10;[product_description_quality] * 0.2' />
  </column>
  <column caption='Column by' datatype='string' name='[Calculation_390476209680023553]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;-&apos; THEN &apos;&apos;&#10;    WHEN &apos;vendor_class&apos; THEN STR([vendor_class])&#10;    WHEN &apos;segment&apos; THEN STR([segment])&#10;    WHEN &apos;management_entity&apos; THEN STR([management_entity])&#10;    WHEN &apos;brand_name&apos; THEN STR([brand_name])&#10;    WHEN &apos;gid&apos; THEN STR([global_entity_id])&#10;    WHEN &apos;country_name&apos; THEN STR([country_name])&#10;    WHEN &apos;sub_entity&apos; THEN STR([sub_entity])&#10;    WHEN &apos;is_chain&apos; THEN STR([is_chain])&#10;    WHEN &apos;main_category_name&apos; THEN STR([main_category_name])&#10;END' />
  </column>
  <column caption='Image Rounded' datatype='real' name='[Calculation_390476209686151172]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &apos;coverage&apos; THEN ROUND([Image Quality (copy)_505810581423054850], 1)&#10;    WHEN &apos;quality&apos; THEN ROUND([Calculation_505810581422813185], 1)&#10;END' />
  </column>
  <column caption='vendor_key' datatype='string' name='[Calculation_390476209710243845]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='[global_entity_id] + [vendor_id]' />
  </column>
  <column caption='Image Quality' datatype='real' name='[Calculation_505810581422813185]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN &apos;product_level&apos; THEN [product_image_quality]&#10;    WHEN &apos;vendor_level&apos; THEN [vendor_image_quality]&#10;END' />
  </column>
  <column caption='Row by' datatype='string' name='[Column by (copy)_390476209685250051]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='CASE [Parameters].[Column by (copy)_390476209685204994]&#10;    WHEN &apos;-&apos; THEN &apos;&apos;&#10;    WHEN &apos;vendor_class&apos; THEN STR([vendor_class])&#10;    WHEN &apos;segment&apos; THEN STR([segment])&#10;    WHEN &apos;management_entity&apos; THEN STR([management_entity])&#10;    WHEN &apos;brand_name&apos; THEN STR([brand_name])&#10;    WHEN &apos;gid&apos; THEN STR([global_entity_id])&#10;    WHEN &apos;country_name&apos; THEN STR([country_name])&#10;    WHEN &apos;sub_entity&apos; THEN STR([sub_entity])&#10;    WHEN &apos;is_chain&apos; THEN STR([is_chain])&#10;    WHEN &apos;main_category_name&apos; THEN STR([main_category_name])&#10;END' />
  </column>
  <column caption='Image Coverage' datatype='real' name='[Image Quality (copy)_505810581423054850]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN &apos;product_level&apos; THEN [product_image_coverage]&#10;    WHEN &apos;vendor_level&apos; THEN [vendor_image_coverage]&#10;END' />
  </column>
  <column caption='Description Quality' datatype='real' name='[Image Quality (copy)_505810581426860035]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='CASE [Parameters].[Image Type (copy)_505810581426974724]&#10;    WHEN &apos;both&apos; THEN [product_description_quality]&#10;    WHEN &apos;more_5s&apos; THEN [product_description_quality_more_5s]&#10;    WHEN &apos;no_match&apos; THEN [product_description_quality_no_match]&#10;END' />
  </column>
  <column caption='Product Description Rounded' datatype='real' name='[Product Image Coverage Rounded (copy)_505810581420216320]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &apos;coverage&apos; THEN ROUND([product_description_coverage], 1)&#10;    WHEN &apos;quality&apos; THEN ROUND([Image Quality (copy)_505810581426860035], 1)&#10;END' />
