      <column caption='Metric Axis 2' datatype='string' name='[Metric Axis 1 (copy)_2736921965322264582]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Comparison Metric 1 (copy)_2736921965310873603]&#10;    WHEN &apos;All Confirmed Orders&apos; THEN &apos;All Confirmed Orders&apos;&#10;    WHEN &apos;All Gmv Eur&apos; THEN &apos;All Gmv Eur&apos;&#10;    WHEN &apos;All Gmv Local Currency&apos; THEN &apos;All Gmv Local Currency&apos;&#10;    WHEN &apos;All Total Orders&apos; THEN &apos;All Total Orders&apos;&#10;    WHEN &apos;Joker Acquisition&apos; THEN &apos;Joker Acquisition&apos;&#10;    WHEN &apos;Joker Acquisition Sum&apos; THEN &apos;Joker Acquisition Sum&apos;&#10;    WHEN &apos;Joker Available&apos; THEN &apos;Joker Available&apos;&#10;    WHEN &apos;Joker Available With Offers&apos; THEN &apos;Joker Available With Offers&apos;&#10;    WHEN &apos;Joker CVR&apos; THEN &apos;Joker CVR&apos;&#10;    WHEN &apos;Joker Confirmed Orders&apos; THEN &apos;Joker Confirmed Orders&apos;&#10;    WHEN &apos;Joker Offered Vendor&apos; THEN &apos;Joker Offered Vendor&apos;&#10;    WHEN &apos;Joker Order Gmv Eur&apos; THEN &apos;Joker Order Gmv Eur&apos;&#10;    WHEN &apos;Joker Order Gmv Local Currency&apos; THEN &apos;Joker Order Gmv Local Currency&apos;&#10;    WHEN &apos;Joker Revenue Eur&apos; THEN &apos;Joker Revenue Eur&apos;&#10;    WHEN &apos;Joker Revenue Local Currency&apos; THEN &apos;Joker Revenue Local Currency&apos;&#10;    WHEN &apos;Joker Self Booking Confirmed Orders&apos; THEN &apos;Joker Self Booking Confirmed Orders&apos;&#10;    WHEN &apos;Joker Self Booking Order Gmv Eur&apos; THEN &apos;Joker Self Booking Order Gmv Eur&apos;&#10;    WHEN &apos;Joker Self Booking Order Gmv Local Currency&apos; THEN &apos;Joker Self Booking Order Gmv Local Currency&apos;&#10;    WHEN &apos;Joker Self Booking Revenue Eur&apos; THEN &apos;Joker Self Booking Revenue Eur&apos;&#10;    WHEN &apos;Joker Self Booking Revenue Local Currency&apos; THEN &apos;Joker Self Booking Revenue Local Currency&apos;&#10;    WHEN &apos;Joker Total Offers&apos; THEN &apos;Joker Total Offers&apos;&#10;    WHEN &apos;Joker Total Offers Sum&apos; THEN &apos;Joker Total Offers Sum&apos;&#10;    WHEN &apos;Joker Total Orders&apos; THEN &apos;Joker Total Orders&apos;&#10;    WHEN &apos;Joker Vendors&apos; THEN &apos;Joker Vendors&apos;&#10;    WHEN &apos;Online Vendors&apos; THEN &apos;Online Vendors&apos;&#10;    WHEN &apos;Self Booking Joker Available&apos; THEN &apos;Self Booking Joker Available&apos;&#10;    WHEN &apos;Self Booking Joker Available With Offers&apos; THEN &apos;Self Booking Joker Available With Offers&apos;&#10;    WHEN &apos;All Sessions&apos; THEN &apos;All Sessions&apos;&#10;    WHEN &apos;% Joker Revenue over GMV&apos; THEN &apos;% Joker Revenue over GMV&apos;&#10;    WHEN &apos;% Joker Orders over Total Orders&apos; THEN &apos;% Joker Orders over Total Orders&apos;&#10;END' />
