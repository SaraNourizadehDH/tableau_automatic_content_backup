            <column caption='Metric' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Joker Orders&quot;'>
              <calculation class='tableau' formula='&quot;Joker Orders&quot;' />
            </column>
            <column caption='Comparison Metric 1' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Joker Confirmed Orders&quot;'>
              <calculation class='tableau' formula='&quot;Joker Confirmed Orders&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1oby9ie0t3rv8315ksfr41ppltd5'>
            <column caption='Joker Offers' datatype='real' name='[Calculation_1575134033939132416]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], [report_date] : MAX([joker_total_offers]) }' />
            </column>
            <column caption='Comparison Metric 1' datatype='real' name='[Calculation_2736921965305163778]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;    WHEN &apos;All Confirmed Orders&apos; THEN SUM([all_confirmed_orders])&#10;    WHEN &apos;All Gmv Eur&apos; THEN SUM([all_gmv_eur])&#10;    WHEN &apos;All Gmv Local Currency&apos; THEN SUM([all_gmv_local_currency])&#10;    WHEN &apos;All Total Orders&apos; THEN SUM([all_total_orders])&#10;    //WHEN &apos;Joker Acquisition&apos; THEN SUM([joker_acquisition])&#10;    //WHEN &apos;Joker Acquisition Sum&apos; THEN SUM([joker_acquisition_sum])&#10;    WHEN &apos;Joker Available&apos; THEN SUM([joker_available])&#10;    WHEN &apos;Joker Available With Offers&apos; THEN SUM([joker_available_with_offers])&#10;    WHEN &apos;Joker Confirmed Orders&apos; THEN SUM([joker_confirmed_orders])&#10;    WHEN &apos;Joker Offered Vendor&apos; THEN SUM([joker_offered_vendor])&#10;    WHEN &apos;Joker Order Gmv Eur&apos; THEN SUM([joker_order_gmv_eur])&#10;    WHEN &apos;Joker Order Gmv Local Currency&apos; THEN SUM([joker_order_gmv_local_currency])&#10;    WHEN &apos;Joker Revenue Eur&apos; THEN SUM([joker_revenue_eur])&#10;    WHEN &apos;Joker Revenue Local Currency&apos; THEN SUM([joker_revenue_local_currency])&#10;    WHEN &apos;Joker Self Booking Confirmed Orders&apos; THEN SUM([joker_self_booking_confirmed_orders])&#10;    WHEN &apos;Joker Self Booking Order Gmv Eur&apos; THEN SUM([joker_self_booking_order_gmv_eur])&#10;    WHEN &apos;Joker Self Booking Order Gmv Local Currency&apos; THEN SUM([joker_self_booking_order_gmv_local_currency])&#10;    WHEN &apos;Joker Self Booking Revenue Eur&apos; THEN SUM([joker_self_booking_revenue_eur])&#10;    WHEN &apos;Joker Self Booking Revenue Local Currency&apos; THEN SUM([joker_self_booking_revenue_local_currency])&#10;    WHEN &apos;Joker Total Offers&apos; THEN AVG([Calculation_1575134033939132416])&#10;    WHEN &apos;Joker Total Orders&apos; THEN SUM([joker_total_orders])&#10;    WHEN &apos;Joker Vendors&apos; THEN SUM([joker_vendors])&#10;    WHEN &apos;Online Vendors&apos; THEN SUM([online_vendors])&#10;    WHEN &apos;Self Booking Joker Available&apos; THEN SUM([sb_joker_available])&#10;    WHEN &apos;Self Booking Joker Available With Offers&apos; THEN SUM([sb_joker_available_with_offers])&#10;    WHEN &apos;All Sessions&apos; THEN SUM([all_sessions])&#10;    WHEN &apos;% Joker Revenue over GMV&apos; THEN [Calculation_4043739918090756100]&#10;    WHEN &apos;% Joker Orders over Total Orders&apos; THEN [Calculation_4897734967582916608]&#10;END' />
            </column>
            <column caption='Metric Axis 1' datatype='string' name='[Calculation_2736921965322145797]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;    WHEN &apos;All Confirmed Orders&apos; THEN &apos;All Confirmed Orders&apos;&#10;    WHEN &apos;All Gmv Eur&apos; THEN &apos;All Gmv Eur&apos;&#10;    WHEN &apos;All Gmv Local Currency&apos; THEN &apos;All Gmv Local Currency&apos;&#10;    WHEN &apos;All Total Orders&apos; THEN &apos;All Total Orders&apos;&#10;    WHEN &apos;Joker Acquisition&apos; THEN &apos;Joker Acquisition&apos;&#10;    WHEN &apos;Joker Acquisition Sum&apos; THEN &apos;Joker Acquisition Sum&apos;&#10;    WHEN &apos;Joker Available&apos; THEN &apos;Joker Available&apos;&#10;    WHEN &apos;Joker Available With Offers&apos; THEN &apos;Joker Available With Offers&apos;&#10;    WHEN &apos;Joker CVR&apos; THEN &apos;Joker CVR&apos;&#10;    WHEN &apos;Joker Confirmed Orders&apos; THEN &apos;Joker Confirmed Orders&apos;&#10;    WHEN &apos;Joker Offered Vendor&apos; THEN &apos;Joker Offered Vendor&apos;&#10;    WHEN &apos;Joker Order Gmv Eur&apos; THEN &apos;Joker Order Gmv Eur&apos;&#10;    WHEN &apos;Joker Order Gmv Local Currency&apos; THEN &apos;Joker Order Gmv Local Currency&apos;&#10;    WHEN &apos;Joker Revenue Eur&apos; THEN &apos;Joker Revenue Eur&apos;&#10;    WHEN &apos;Joker Revenue Local Currency&apos; THEN &apos;Joker Revenue Local Currency&apos;&#10;    WHEN &apos;Joker Self Booking Confirmed Orders&apos; THEN &apos;Joker Self Booking Confirmed Orders&apos;&#10;    WHEN &apos;Joker Self Booking Order Gmv Eur&apos; THEN &apos;Joker Self Booking Order Gmv Eur&apos;&#10;    WHEN &apos;Joker Self Booking Order Gmv Local Currency&apos; THEN &apos;Joker Self Booking Order Gmv Local Currency&apos;&#10;    WHEN &apos;Joker Self Booking Revenue Eur&apos; THEN &apos;Joker Self Booking Revenue Eur&apos;&#10;    WHEN &apos;Joker Self Booking Revenue Local Currency&apos; THEN &apos;Joker Self Booking Revenue Local Currency&apos;&#10;    WHEN &apos;Joker Total Offers&apos; THEN &apos;Joker Total Offers&apos;&#10;    WHEN &apos;Joker Total Offers Sum&apos; THEN &apos;Joker Total Offers Sum&apos;&#10;    WHEN &apos;Joker Total Orders&apos; THEN &apos;Joker Total Orders&apos;&#10;    WHEN &apos;Joker Vendors&apos; THEN &apos;Joker Vendors&apos;&#10;    WHEN &apos;Online Vendors&apos; THEN &apos;Online Vendors&apos;&#10;    WHEN &apos;Self Booking Joker Available&apos; THEN &apos;Self Booking Joker Available&apos;&#10;    WHEN &apos;Self Booking Joker Available With Offers&apos; THEN &apos;Self Booking Joker Available With Offers&apos;&#10;    WHEN &apos;All Sessions&apos; THEN &apos;All Sessions&apos;&#10;    WHEN &apos;% Joker Revenue over GMV&apos; THEN &apos;% Joker Revenue over GMV&apos;&#10;    WHEN &apos;% Joker Orders over Total Orders&apos; THEN &apos;% Joker Orders over Total Orders&apos;&#10;END' />
            </column>
            <column caption='% Joker Revenue Over GMV' datatype='real' default-format='p0.0%' name='[Calculation_4043739918090756100]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(zn([joker_revenue_eur]))/SUM(ZN([all_gmv_eur]))' />
            </column>
            <column caption='% Joker Orders Over Total Orders' datatype='real' default-format='p0.0%' name='[Calculation_4897734967582916608]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([joker_confirmed_orders]))/sum(ZN([all_confirmed_orders]))' />
            </column>
            <column caption='Comparison Metric 2' datatype='real' name='[Comparison Metric 1 (copy)_2736921965318561796]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Comparison Metric 1 (copy)_2736921965310873603]&#10;    WHEN &apos;All Confirmed Orders&apos; THEN SUM([all_confirmed_orders])&#10;    WHEN &apos;All Gmv Eur&apos; THEN SUM([all_gmv_eur])&#10;    WHEN &apos;All Gmv Local Currency&apos; THEN SUM([all_gmv_local_currency])&#10;    WHEN &apos;All Total Orders&apos; THEN SUM([all_total_orders])&#10;    //WHEN &apos;Joker Acquisition&apos; THEN SUM([joker_acquisition])&#10;    //WHEN &apos;Joker Acquisition Sum&apos; THEN SUM([joker_acquisition_sum])&#10;    WHEN &apos;Joker Available&apos; THEN SUM([joker_available])&#10;    WHEN &apos;Joker Available With Offers&apos; THEN SUM([joker_available_with_offers])&#10;    WHEN &apos;Joker Confirmed Orders&apos; THEN SUM([joker_confirmed_orders])&#10;    WHEN &apos;Joker Offered Vendor&apos; THEN SUM([joker_offered_vendor])&#10;    WHEN &apos;Joker Order Gmv Eur&apos; THEN SUM([joker_order_gmv_eur])&#10;    WHEN &apos;Joker Order Gmv Local Currency&apos; THEN SUM([joker_order_gmv_local_currency])&#10;    WHEN &apos;Joker Revenue Eur&apos; THEN SUM([joker_revenue_eur])&#10;    WHEN &apos;Joker Revenue Local Currency&apos; THEN SUM([joker_revenue_local_currency])&#10;    WHEN &apos;Joker Self Booking Confirmed Orders&apos; THEN SUM([joker_self_booking_confirmed_orders])&#10;    WHEN &apos;Joker Self Booking Order Gmv Eur&apos; THEN SUM([joker_self_booking_order_gmv_eur])&#10;    WHEN &apos;Joker Self Booking Order Gmv Local Currency&apos; THEN SUM([joker_self_booking_order_gmv_local_currency])&#10;    WHEN &apos;Joker Self Booking Revenue Eur&apos; THEN SUM([joker_self_booking_revenue_eur])&#10;    WHEN &apos;Joker Self Booking Revenue Local Currency&apos; THEN SUM([joker_self_booking_revenue_local_currency])&#10;    WHEN &apos;Joker Total Offers&apos; THEN AVG([Calculation_1575134033939132416])&#10;    WHEN &apos;Joker Total Orders&apos; THEN SUM([joker_total_orders])&#10;    WHEN &apos;Joker Vendors&apos; THEN SUM([joker_vendors])&#10;    WHEN &apos;Online Vendors&apos; THEN SUM([online_vendors])&#10;    WHEN &apos;Self Booking Joker Available&apos; THEN SUM([sb_joker_available])&#10;    WHEN &apos;Self Booking Joker Available With Offers&apos; THEN SUM([sb_joker_available_with_offers])&#10;    WHEN &apos;All Sessions&apos; THEN SUM([all_sessions])&#10;    WHEN &apos;% Joker Revenue over GMV&apos; THEN [Calculation_4043739918090756100]&#10;    WHEN &apos;% Joker Orders over Total Orders&apos; THEN [Calculation_4897734967582916608]&#10;END' />
            </column>
