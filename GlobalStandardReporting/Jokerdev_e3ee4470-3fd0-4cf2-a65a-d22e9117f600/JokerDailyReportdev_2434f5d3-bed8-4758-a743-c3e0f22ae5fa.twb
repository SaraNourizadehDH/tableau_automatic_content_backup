      <column caption='Metric label' datatype='real' name='[Metric (copy)_6608117686277087244]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;    WHEN &apos;Joker Orders&apos; THEN SUM([joker_total_orders])&#10;    WHEN &apos;Joker Offers&apos; THEN SUM([Calculation_1575134033939132416])&#10;    WHEN &apos;Joker CVR&apos; THEN -[Calculation_6608117686274936843]&#10;    WHEN &apos;Joker Available&apos; THEN SUM([joker_available])&#10;    WHEN &apos;Total Orders&apos; THEN SUM([all_total_orders])&#10;END' />
