    <worksheet name='Summary breakdown'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='8'>Æ </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='adtech_il_joker_monthly+ (analytics)' name='federated.0f8lxop0mbwp0q1dkk2ez17vnynh' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Last n Months' datatype='integer' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='3'>
              <calculation class='tableau' formula='3' />
              <range granularity='1' max='14' min='1' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0f8lxop0mbwp0q1dkk2ez17vnynh'>
            <column caption='MoM Revenue Eur' datatype='real' default-format='p0.00%' name='[Calculation2]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM(if DATETRUNC(&apos;month&apos;,[run_date])=[report_month] then null else [joker_revenue_eur]END)) &#10;- LOOKUP((SUM(if DATETRUNC(&apos;month&apos;,[run_date])=[report_month] then null else [joker_revenue_eur]END)), -1)) &#10;&#10;/ ABS(LOOKUP((SUM(if DATETRUNC(&apos;month&apos;,[run_date])=[report_month]then null else [joker_revenue_eur]END)), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Last Months' datatype='boolean' name='[Calculation_2918543687711260672]' role='measure' type='nominal'>
              <calculation class='tableau' formula='LAST()&lt; [Parameters].[Parameter 1]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='% Self Booking Revenue' datatype='real' default-format='p0.0%' name='[Calculation_333407173243453440]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([joker_self_booking_revenue_eur]))/SUM(ZN([joker_revenue_eur]))' />
            </column>
            <column caption='AOV' datatype='real' name='[Calculation_3348918915374039040]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(zn([all_gmv_eur]))/sum(ZN([all_confirmed_orders]))' />
            </column>
            <column caption='filter non active countries' datatype='integer' name='[Calculation_3961971437340237824]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], YEAR([report_month])&#10;:SUM([joker_available])}' />
            </column>
            <column caption='Joker CVR' datatype='real' name='[Calculation_4043739918087868416]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(zn([joker_confirmed_orders]))/sum(zn([joker_total_offers]))' />
            </column>
            <column caption='Inventory Sold' datatype='real' name='[Calculation_4043739918088368129]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(ZN([joker_confirmed_orders]))/sum(zn([joker_available]))' />
            </column>
            <column caption='Joker Penetration' datatype='real' name='[Calculation_4043739918089752578]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(zn([joker_vendors]))/sum(ZN([online_vendors]))' />
            </column>
            <column caption='% Revenue Over GMV' datatype='real' name='[Calculation_4043739918090756100]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(zn([joker_revenue_eur]))/SUM(ZN([all_gmv_eur]))' />
            </column>
            <column caption='% Self Booking Joker Available' datatype='real' name='[Calculation_4043739918091161605]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(zn([sb_joker_available]))/sum(zn([joker_available]))' />
            </column>
            <column caption='Joker Orders Over Totall Orders' datatype='real' default-format='p0.0%' name='[Calculation_4897734967582916608]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([joker_confirmed_orders]))/sum(ZN([all_confirmed_orders]))' />
            </column>
            <column caption='Inventory Sold Over Joker w/Offers' datatype='real' name='[Calculation_4985766298830254080]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(zn([joker_confirmed_orders]))/sum(zn([joker_available_with_offers]))' />
            </column>
            <column caption='% Joker CTO (CVR)' datatype='real' default-format='p0.0%' name='[Calculation_6636476280527040512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([joker_confirmed_orders]) / SUM([joker_clicks])' />
            </column>
            <column caption='% Joker CTR' datatype='real' default-format='p0.0%' name='[Calculation_6636476280527216641]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([joker_clicks]) / SUM([joker_offered_vendor])' />
            </column>
            <column caption='Inventory Sold without Zombies' datatype='real' name='[Inventory Sold (copy)_5222627460554784775]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(ZN([joker_confirmed_orders]))/sum(zn([joker_available_without_zombies]))' />
            </column>
            <column caption='Joker Vendor CVR' datatype='real' default-format='p0.00%' name='[Joker CVR (copy)_647322103429246977]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(zn([joker_confirmed_orders]))/sum(zn([joker_offered_vendor]))' />
            </column>
            <column caption='Joker Penetration without Zombies' datatype='real' default-format='p0.0%' name='[Joker Penetration (copy)_5222627460553629702]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(zn([non_zombie_joker_vendors]))/sum(ZN([online_vendors]))' />
            </column>
            <column caption='All Confirmed Orders' datatype='integer' name='[all_confirmed_orders]' role='measure' type='quantitative' />
