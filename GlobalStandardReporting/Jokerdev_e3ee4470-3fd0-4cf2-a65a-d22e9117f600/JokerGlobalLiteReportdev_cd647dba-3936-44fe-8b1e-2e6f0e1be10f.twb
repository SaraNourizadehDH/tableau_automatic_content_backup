      <aliases enabled='yes' />
      <column caption='Joker AOV' datatype='real' name='[AOV (copy)_3348918915375316995]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([joker_order_gmv_eur]))/SUM(ZN([joker_confirmed_orders]))' />
      </column>
      <column caption='WoW Revenue Eur' datatype='real' default-format='p0.00%' name='[Calculation2]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((SUM(if DATETRUNC(&apos;week&apos;,[run_date])=[date_week] then null else [joker_revenue_eur]END)) &#10;- LOOKUP((SUM(if DATETRUNC(&apos;week&apos;,[run_date])=[date_week] then null else [joker_revenue_eur]END)), -1)) &#10;&#10;/ ABS(LOOKUP((SUM(if DATETRUNC(&apos;week&apos;,[run_date])=[date_week]then null else [joker_revenue_eur]END)), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Last Months' datatype='boolean' name='[Calculation_2918543687711260672]' role='measure' type='nominal'>
        <calculation class='tableau' formula='LAST()&lt; [Parameters].[Parameter 1]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='AOV' datatype='real' name='[Calculation_3348918915375161346]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([all_gmv_eur]))/SUM(ZN([all_confirmed_orders]))' />
      </column>
      <column caption='filter non active countries' datatype='integer' name='[Calculation_3961971437340237824]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [global_entity_id], YEAR([date_week])&#10;:SUM([joker_available])}' />
      </column>
      <column caption='Joker CVR' datatype='real' name='[Calculation_4043739918087868416]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(zn([joker_confirmed_orders]))/sum(zn([joker_total_offers]))' />
      </column>
      <column caption='Inventory Sold' datatype='real' name='[Calculation_4043739918088368129]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(ZN([joker_confirmed_orders]))/sum(zn([joker_available]))' />
      </column>
      <column caption='Joker orders Over Total Orders' datatype='real' default-format='p0.0%' name='[Calculation_4897734967583911937]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([joker_confirmed_orders]))/SUM(ZN([all_confirmed_orders]))' />
      </column>
      <column caption='% Self Booking Revenue' datatype='real' default-format='p0.0%' name='[Calculation_4897734967584464898]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(zn([joker_self_booking_revenue_eur]))/SUM(ZN([joker_revenue_eur]))' />
      </column>
      <column caption='Inventory Sold Over Joker w/Offers' datatype='real' name='[Calculation_4985766298836213763]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(zn([joker_confirmed_orders]))/sum(zn([joker_available_with_offers]))' />
      </column>
      <column caption='% Churn' datatype='real' name='[Calculation_4985766298855837700]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(ZN([joker_churn]))/sum(ZN([joker_vendors]))' />
      </column>
      <column caption='% Self Booking Joker Available' datatype='real' name='[Calculation_4985766298856697861]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(ZN([sb_joker_available]))/sum(zn([joker_available]))' />
      </column>
      <column caption='% Joker Vendor Penetration without Zombies' datatype='real' name='[Calculation_5222627460191653892]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([non_zombie_joker_vendors])) / SUM(ZN([online_vendors]))' />
      </column>
      <column caption='% Joker Utilisation without Zombies' datatype='real' name='[Calculation_5222627460208336901]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([joker_confirmed_orders])) / SUM(ZN([joker_available_without_zombies]))' />
      </column>
      <column caption='Joker Revenue Over Joker GMV' datatype='real' default-format='p0.0%' name='[Calculation_6065504329330987008]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(ZN([joker_revenue_eur]))/sum(ZN([joker_order_gmv_eur]))' />
      </column>
      <column caption='% Joker Zombies' datatype='real' default-format='p0.0%' name='[Calculation_6617195239424790528]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([joker_zombie_vendors]))/SUM(ZN([joker_vendors]))' />
      </column>
      <column caption='% Joker CTO (CVR)' datatype='real' default-format='p0.0%' name='[Calculation_6636476280527040512]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([joker_confirmed_orders]) / SUM([joker_clicks])' />
      </column>
      <column caption='% Joker CTR' datatype='real' default-format='p0.0%' name='[Calculation_6636476280527216641]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([joker_clicks]) / SUM([joker_offered_vendor])' />
      </column>
      <column caption='Joker Vendor CVR' datatype='real' default-format='p0.00%' name='[Joker CVR (copy)_647322103429566466]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(zn([joker_confirmed_orders]))/sum(zn([joker_offered_vendor]))' />
      </column>
