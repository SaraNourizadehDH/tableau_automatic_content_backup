              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;Global&apos; THEN  AVG([global_weighted_content_score])&#10;WHEN &apos;Region&apos; THEN AVG([region_weighted_content_score])&#10;WHEN &apos;Country&apos; THEN AVG([country_weighted_content_score])&#10;WHEN &apos;Global - Product Type&apos; THEN AVG([prod_type_weighted_content_score])&#10;WHEN &apos;Country - Product Type&apos; THEN AVG([country_product_weighted_content_score])&#10;WHEN &apos;Management Entity&apos; THEN AVG([mgmt_entity_weighted_content_score])&#10;// ELSE [Total Cust Count (vendor level)]&#10;END' />
