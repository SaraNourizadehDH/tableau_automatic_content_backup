    <worksheet name='Historical view - Sub score table'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#ffffff' fontname='Tableau Regular' fontsize='12'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='_tableau_content_score_detailed_v3' name='federated.096rqwk0bo8m8113smce20wuat16' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Geo-granularity' datatype='string' datatype-customized='true' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Management Entity&quot;'>
              <calculation class='tableau' formula='&quot;Management Entity&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.096rqwk0bo8m8113smce20wuat16'>
            <column caption='Count Distinct  Master Code' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg. Content Score Aggregated [H]] (copy)_6265421903205900288]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;Global&apos; THEN  AVG([global_dist_product_count])&#10;WHEN &apos;Region&apos; THEN AVG([region_dist_product_count])&#10;WHEN &apos;Country&apos; THEN AVG([country_dist_product_count])&#10;WHEN &apos;Global - Product Type&apos; THEN AVG([prod_type_dist_product_count])&#10;WHEN &apos;Country - Product Type&apos; THEN AVG([country_product_dist_product_count])&#10;WHEN &apos;Management Entity&apos; THEN AVG([mgmt_entity_dist_product_count])&#10;// ELSE [Total Cust Count (vendor level)]&#10;END' />
            </column>
            <column caption='Avg Quality Score Title' datatype='real' name='[Avg. Quality Score Piece Barcode [H]] (copy)_6993527315126300672]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;Global&apos; THEN  AVG([global_quality_score_title])&#10;WHEN &apos;Region&apos; THEN AVG([region_quality_score_title])&#10;WHEN &apos;Country&apos; THEN AVG([country_quality_score_title])&#10;WHEN &apos;Global - Product Type&apos; THEN AVG([prod_type_quality_score_title])&#10;WHEN &apos;Country - Product Type&apos; THEN AVG([country_product_quality_score_title])&#10;WHEN &apos;Management Entity&apos; THEN AVG([mgmt_entity_quality_score_title])&#10;END' />
            </column>
            <column caption='Avg Quality Score Image' datatype='real' name='[Avg. Quality Score Title [H]] (copy)_6993527315127074817]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;Global&apos; THEN  AVG([global_quality_score_image])&#10;WHEN &apos;Region&apos; THEN AVG([region_quality_score_image])&#10;WHEN &apos;Country&apos; THEN AVG([country_quality_score_image])&#10;WHEN &apos;Global - Product Type&apos; THEN AVG([prod_type_quality_score_image])&#10;WHEN &apos;Country - Product Type&apos; THEN AVG([country_product_quality_score_image])&#10;WHEN &apos;Management Entity&apos; THEN AVG([mgmt_entity_quality_score_image])&#10;END' />
            </column>
            <column caption='Avg Completeness Score Brand Name' datatype='real' name='[Calculation_4512114251344019457]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;Global&apos; THEN  AVG([global_completeness_score_brand_name])&#10;WHEN &apos;Region&apos; THEN AVG([region_completeness_score_brand_name])&#10;WHEN &apos;Country&apos; THEN AVG([country_completeness_score_brand_name])&#10;WHEN &apos;Global - Product Type&apos; THEN AVG([prod_type_completeness_score_brand_name])&#10;WHEN &apos;Country - Product Type&apos; THEN AVG([country_product_completeness_score_brand_name])&#10;WHEN &apos;Management Entity&apos; THEN AVG([mgmt_entity_completeness_score_brand_name])&#10;// ELSE [Total Cust Count (vendor level)]&#10;END' />
            </column>
            <column caption='Avg Weighted Content Score [100%]' datatype='real' name='[Calculation_6443665940136374273]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;Global&apos; THEN  AVG([global_weighted_content_score])&#10;WHEN &apos;Region&apos; THEN AVG([region_weighted_content_score])&#10;WHEN &apos;Country&apos; THEN AVG([country_weighted_content_score])&#10;WHEN &apos;Global - Product Type&apos; THEN AVG([prod_type_weighted_content_score])&#10;WHEN &apos;Country - Product Type&apos; THEN AVG([country_product_weighted_content_score])&#10;WHEN &apos;Management Entity&apos; THEN AVG([mgmt_entity_weighted_content_score])&#10;// ELSE [Total Cust Count (vendor level)]&#10;END' />
            </column>
            <column caption='Avg User Experience Completeness Score [50%]' datatype='real' name='[Calculation_6443665940136718338]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;Global&apos; THEN  AVG([global_completeness_user_experience_score])&#10;WHEN &apos;Region&apos; THEN AVG([region_completeness_user_experience_score])&#10;WHEN &apos;Country&apos; THEN AVG([country_completeness_user_experience_score])&#10;WHEN &apos;Global - Product Type&apos; THEN AVG([prod_type_completeness_user_experience_score])&#10;WHEN &apos;Country - Product Type&apos; THEN AVG([country_product_completeness_user_experience_score])&#10;WHEN &apos;Management Entity&apos; THEN AVG([mgmt_entity_completeness_user_experience_score])&#10;// ELSE [Total Cust Count (vendor level)]&#10;END' />
            </column>
            <column caption='Avg Operations Completeness Score [20%]' datatype='real' name='[Calculation_6443665940136968195]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;Global&apos; THEN  AVG([global_completeness_operations_score])&#10;WHEN &apos;Region&apos; THEN AVG([region_completeness_operations_score])&#10;WHEN &apos;Country&apos; THEN AVG([country_completeness_operations_score])&#10;WHEN &apos;Global - Product Type&apos; THEN AVG([prod_type_completeness_operations_score])&#10;WHEN &apos;Country - Product Type&apos; THEN AVG([country_product_completeness_operations_score])&#10;WHEN &apos;Management Entity&apos; THEN AVG([mgmt_entity_completeness_operations_score])&#10;// ELSE [Total Cust Count (vendor level)]&#10;END' />
            </column>
            <column caption='Avg Content Quality Score [30%]' datatype='real' name='[Calculation_6443665940137299972]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;Global&apos; THEN  AVG([global_content_quality_score])&#10;WHEN &apos;Region&apos; THEN AVG([region_content_quality_score])&#10;WHEN &apos;Country&apos; THEN AVG([country_content_quality_score])&#10;WHEN &apos;Global - Product Type&apos; THEN AVG([prod_type_content_quality_score])&#10;WHEN &apos;Country - Product Type&apos; THEN AVG([country_product_content_quality_score])&#10;WHEN &apos;Management Entity&apos; THEN AVG([mgmt_entity_content_quality_score])&#10;// ELSE [Total Cust Count (vendor level)]&#10;END' />
