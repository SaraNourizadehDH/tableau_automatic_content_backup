          </datasource-dependencies>
          <datasource-dependencies datasource='federated.096rqwk0bo8m8113smce20wuat16'>
            <column caption='Count Distinct  Master Code' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg. Content Score Aggregated [H]] (copy)_6265421903205900288]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;Global&apos; THEN  AVG([global_dist_product_count])&#10;WHEN &apos;Region&apos; THEN AVG([region_dist_product_count])&#10;WHEN &apos;Country&apos; THEN AVG([country_dist_product_count])&#10;WHEN &apos;Global - Product Type&apos; THEN AVG([prod_type_dist_product_count])&#10;WHEN &apos;Country - Product Type&apos; THEN AVG([country_product_dist_product_count])&#10;WHEN &apos;Management Entity&apos; THEN AVG([mgmt_entity_dist_product_count])&#10;// ELSE [Total Cust Count (vendor level)]&#10;END' />
            </column>
            <column caption='Avg Quality Score Title' datatype='real' name='[Avg. Quality Score Piece Barcode [H]] (copy)_6993527315126300672]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;Global&apos; THEN  AVG([global_quality_score_title])&#10;WHEN &apos;Region&apos; THEN AVG([region_quality_score_title])&#10;WHEN &apos;Country&apos; THEN AVG([country_quality_score_title])&#10;WHEN &apos;Global - Product Type&apos; THEN AVG([prod_type_quality_score_title])&#10;WHEN &apos;Country - Product Type&apos; THEN AVG([country_product_quality_score_title])&#10;WHEN &apos;Management Entity&apos; THEN AVG([mgmt_entity_quality_score_title])&#10;END' />
