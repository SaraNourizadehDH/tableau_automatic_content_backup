            <column caption='Avg Quality Subscore Title No Invalid String' datatype='real' name='[Calculation_102597697085030400]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;Global&apos; THEN  AVG([global_quality_subscore_title_no_invalid_string])&#10;WHEN &apos;Region&apos; THEN AVG([region_quality_subscore_title_no_invalid_string])&#10;WHEN &apos;Country&apos; THEN AVG([country_quality_subscore_title_no_invalid_string])&#10;WHEN &apos;Global - Product Type&apos; THEN AVG([prod_type_quality_subscore_title_no_invalid_string])&#10;WHEN &apos;Country - Product Type&apos; THEN AVG([country_product_quality_subscore_title_no_invalid_string])&#10;WHEN &apos;Management Entity&apos; THEN AVG([mgmt_entity_quality_subscore_title_no_invalid_string])&#10;// ELSE [Total Cust Count (vendor level)]&#10;END' />
