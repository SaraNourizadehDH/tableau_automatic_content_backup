    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='SKU Level Scores'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#ffffff' fontname='Tableau Regular' fontsize='15'>Latest week SKU level Scores and Sub-scores</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/WIPContentScoringv3/SKULevelScores?rev=' id='SKULevelScores' path='/t/GlobalStandardReporting/workbooks/testContentScoringv3-skulevel' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='table'>
          <format attr='background-color' value='#f2f2f2' />
        </style-rule>
        <style-rule element='dash-title'>
          <format attr='background-color' value='#eb1800' />
