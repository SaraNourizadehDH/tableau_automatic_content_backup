    <worksheet name='capital_vs_ent'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#000000' fontname='Tableau Bold' fontsize='11'>vs</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#000000' fontname='Tableau Bold' fontsize='11'>Æ </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='competition_benchmark (rl_intl_markets)' name='federated.1nu2wp6012ad171bqvtdl1ji6uf1' />
          </datasources>
          <datasource-dependencies datasource='federated.1nu2wp6012ad171bqvtdl1ji6uf1'>
            <column caption='% of items with desc DH  capital' datatype='real' default-format='p0%' name='[% of items with desc DH  (copy)_1546001320692654092]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([items_w_desc_dh_capital])/SUM([items_dh_capital])' />
            </column>
            <column caption='% of items with picture DH capital' datatype='real' default-format='p0%' name='[% of items with picture DH (copy)_911134505668161540]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([items_w_img_dh_capital])/SUM([items_dh_capital])' />
            </column>
            <column caption='4 5 Rated Restos' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[4 5 Rated Restos  (copy)_5529716668742750209]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dh_rating_4_5_restaus]) / SUM([comp_rating_4_5_restaus])' />
            </column>
            <column caption='MOV Rate' datatype='real' default-format='p0.0%' name='[Calculation_144959642556702720]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([common_vendors_dh_mov_higher]) / SUM([common_vendors_dh_mov])' />
            </column>
            <column caption='DF Rate' datatype='real' default-format='p0.0%' name='[Calculation_144959642556854273]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([common_vendors_dh_df_higher]) / SUM([common_vendors_dh_df])' />
            </column>
            <column caption='comparison markup' datatype='integer' name='[Calculation_1546001320694550541]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF [Vendors with mark up % (copy)_1546001320690819079] &lt;= [Calculation_4436116061724573703] THEN 1 ELSE 0 END' />
            </column>
            <column caption='blank' datatype='real' name='[Calculation_4436116061723099140]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='FLOAT(NULL)' />
            </column>
            <column caption='Vendors with mark up %' datatype='real' default-format='p0.0%' name='[Calculation_4436116061724573703]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([markup_vendors]) / SUM([markup_vendor_universe])' />
            </column>
            <column caption='Items with mark up %' datatype='real' default-format='p0.0%' name='[Calculation_4436116061724983304]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([markup_items]) / SUM([markup_item_universe])' />
            </column>
            <column caption='4 5 Rated Restos Capital' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_5529716668742615040]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dh_rating_4_5_restaus_capital]) / SUM([comp_rating_4_5_restaus_capital])' />
            </column>
            <column caption='hours rate' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_5529716668763406342]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([hours_higher_or_equal_vendors])/SUM([hours_vendors])' />
            </column>
            <column caption='Last 3 Months' datatype='boolean' name='[Calculation_5641954855490854914]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [report_month], TODAY()) &lt;= 3 &#10;AND DATEPART(&apos;month&apos;, TODAY()) != DATEPART(&apos;month&apos;, [report_month])' />
            </column>
            <column caption='DF Rate Capital' datatype='real' default-format='p0.0%' name='[DF Rate (copy)_1546001320691167241]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([common_vendors_dh_df_higher_capital]) / SUM([common_vendors_dh_df_capital])' />
            </column>
            <column caption='Items with mark up % capital' datatype='real' default-format='p0.0%' name='[Items with mark up % (copy)_1546001320690905096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([item_count_markup_capital]) / SUM([count_item_capital])' />
            </column>
            <column caption='MOV Rate capital' datatype='real' default-format='p0.0%' name='[MOV Rate (copy)_1546001320691372042]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([common_vendors_dh_mov_higher_capital]) / SUM([common_vendors_dh_mov_capital])' />
            </column>
            <column caption='Vendors with Mark up Capital' datatype='integer' name='[Vendors with Mark up (copy)_1546001320690728966]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_count_markup_capital]) + SUM([vendor_count_cons_markup_capital])' />
            </column>
            <column caption='Vendors with mark up % Capital' datatype='real' default-format='p0.0%' name='[Vendors with mark up % (copy)_1546001320690819079]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Vendors with Mark up (copy)_1546001320690728966]) / SUM([count_unique_vendor_capital])' />
