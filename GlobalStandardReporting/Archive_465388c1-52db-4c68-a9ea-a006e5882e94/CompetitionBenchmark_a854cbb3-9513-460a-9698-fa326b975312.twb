            <zone fixed-size='811' h='52800' hidden-by-user='true' id='1002' is-fixed='true' param='vert' type-v2='layout-flow' w='50688' x='21000' y='200'>
              <zone fixed-size='107' forceUpdate='true' h='11500' hidden-by-user='true' id='1004' is-fixed='true' type-v2='text' w='50688' x='21000' y='200'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontsize='11'>--&gt; Graph shows the historical entity count for</run>
                  <run bold='true' fontcolor='#a2faa3' fontsize='11'>Æ </run>
                  <run bold='true' fontcolor='#59a14f' fontsize='11'>Ahead,</run>
                  <run bold='true' fontcolor='#a2faa3' fontsize='11'>Æ </run>
                  <run bold='true' fontcolor='#ffbe7d' fontsize='11'>Contested</run>
                  <run bold='true' fontcolor='#a2faa3' fontsize='11'>Æ </run>
                  <run bold='true' fontcolor='#000000' fontsize='11'>and</run>
                  <run bold='true' fontcolor='#a2faa3' fontsize='11'>Æ </run>
                  <run bold='true' fontcolor='#d61f26' fontsize='11'>Behind.</run>
                  <run>Æ&#10;</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#e6e6e6' />
                </zone-style>
              </zone>
              <zone fixed-size='171' forceUpdate='true' h='17900' hidden-by-user='true' id='999' is-fixed='true' type-v2='text' w='50688' x='21000' y='11700'>
                <formatted-text>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='11' underline='true'>Month Selection: </run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#360ceb' fontsize='11' underline='true'>Selected</run>
                  <run bold='true' fontcolor='#000000' fontsize='11'> --&gt; Only shows the selected month, momentum</run>
                  <run bold='true' fontcolor='#000000' fontsize='11' italic='true'> (green/red arrows)</run>
                  <run bold='true' fontcolor='#000000' fontsize='11'> compares to the previous month.</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#360ceb' fontsize='11' underline='true'>L3M</run>
                  <run bold='true' fontcolor='#000000' fontsize='11'> --&gt; Shows L3M Averages. Momentum</run>
                  <run bold='true' fontcolor='#000000' fontsize='11' italic='true'> (green/red arrows)</run>
                  <run bold='true' fontcolor='#000000' fontsize='11'> compares to previous L3M. </run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#e6e6e681' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='23400' hidden-by-user='true' id='1006' type-v2='text' w='50688' x='21000' y='29600'>
                <formatted-text>
                  <run bold='true' fontcolor='#a2faa3' fontsize='11' underline='true'>Score Calculation:</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='11'>For each country; we are looking 10 different metrics.</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#a2faa3' fontsize='11'>If the metric</run>
                  <run bold='true' fontcolor='#d61f26' fontsize='11'> is red --&gt; bad</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#a2faa3' fontsize='11'>If green --&gt; good</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='11'>If white --&gt; no effect</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='11'>Then we are calculating the score. If we are</run>
                  <run bold='true' fontcolor='#a2faa3' fontsize='11'> good(green) </run>
                  <run bold='true' fontcolor='#ffffff' fontsize='11'>in 5 metrics and</run>
                  <run bold='true' fontcolor='#d61f26' fontsize='11'> bad(red) </run>
                  <run bold='true' fontcolor='#ffffff' fontsize='11'>in 5 metrics then the score is 50%. </run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='11'>Score &gt; 0.6  ==  Ahead</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='11'><![CDATA[Score <= 0.6 AND Score > 0.4 == Contested]]></run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='11'>Score &lt;= 0.4  == Behind</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#333333' />
                </zone-style>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='background-color' value='#ffffffc6' />
              </zone-style>
            </zone>
            <zone forceUpdate='true' h='52800' hidden-by-user='true' id='1010' type-v2='text' w='28312' x='71688' y='200'>
              <formatted-text>
                <run bold='true' fontcolor='#000000' fontsize='11'>This view is filtered with the </run>
                <run bold='true' fontcolor='#000000' fontsize='11' underline='true'>cities</run>
                <run bold='true' fontcolor='#000000' fontsize='11'> that either DH or Competiton has more than </run>
                <run bold='true' fontcolor='#d61f26' fontsize='11'>50 vendors</run>
                <run bold='true' fontcolor='#000000' fontsize='11'>. In order to see full view, please click &quot;show all cities&quot;. However city counts are very high in that view. We are currently working on it.</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
                <format attr='background-color' value='#ffffffce' />
              </zone-style>
            </zone>
          </zone>
        </zone>
