      <datasource-dependencies datasource='federated.1in45pt0whh00q1ds0u0r139acdt'>
        <column caption='Date Granularity' datatype='string' name='[Calculation_517843633631232002]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&apos;Daily&apos; THEN STR([Calculation_4008555566098100234])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Weekly&apos; THEN [order_week]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Monthly&apos; THEN [order_month]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Quarterly&apos; THEN STR(DATE(DATETRUNC(&apos;quarter&apos;,[order_date])))&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Yearly&apos; THEN STR([order_year])&#10;END' />
        </column>
        <column caption='_yoy date lookup filter' datatype='datetime' name='[Calculation_834643688969678849]' role='measure' type='ordinal'>
          <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Monthly&apos;&#10;        THEN IF(ABS(DATEDIFF(&apos;day&apos;,[Date Granularity (copy)_763571249941708801], TODAY())) &lt; 30 ) &#10;                THEN DATEADD(&apos;day&apos;, 30 - ABS(DATEDIFF(&apos;day&apos;,[Date Granularity (copy)_763571249941708801], TODAY())), [Date Granularity (copy)_763571249941708801]) ELSE [Date Granularity (copy)_763571249941708801] END&#10;    WHEN &apos;Quarterly&apos;&#10;        THEN IF(ABS(DATEDIFF(&apos;day&apos;,[Date Granularity (copy)_763571249941708801], TODAY())) &lt; 90 ) &#10;                THEN DATEADD(&apos;day&apos;,90 - ABS(DATEDIFF(&apos;day&apos;,[Date Granularity (copy)_763571249941708801], TODAY())), [Date Granularity (copy)_763571249941708801]) ELSE [Date Granularity (copy)_763571249941708801] END&#10;    WHEN &apos;Yearly&apos;&#10;        THEN IF(ABS(DATEDIFF(&apos;day&apos;,[Date Granularity (copy)_763571249941708801], TODAY())) &lt; 364 ) &#10;                THEN DATEADD(&apos;day&apos;,364 - ABS(DATEDIFF(&apos;day&apos;,[Date Granularity (copy)_763571249941708801], TODAY())),[Date Granularity (copy)_763571249941708801]) ELSE [Date Granularity (copy)_763571249941708801] END&#10;    ELSE [Date Granularity (copy)_763571249941708801]&#10; END'>
            <table-calc ordering-type='Rows' />
          </calculation>
        </column>
        <column caption='POS Chain Name' datatype='string' name='[application_chain_name]' role='dimension' type='nominal' />
        <column caption='App Client' datatype='string' name='[application_client_name]' role='dimension' type='nominal' />
        <column caption='App Client Wrapper' datatype='string' name='[application_client_wrapper_type]' role='dimension' type='nominal' />
        <column caption='POS Integration Name' datatype='string' name='[application_integration_name]' role='dimension' type='nominal' />
        <column caption='POS Integration Type' datatype='string' name='[application_integration_type]' role='dimension' type='nominal' />
        <column caption='Brand Name' datatype='string' name='[brand_name]' role='dimension' type='nominal' />
