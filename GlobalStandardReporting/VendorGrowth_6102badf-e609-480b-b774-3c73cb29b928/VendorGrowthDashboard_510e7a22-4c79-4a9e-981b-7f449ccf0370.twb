              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1in45pt0whh00q1ds0u0r139acdt'>
            <column caption='% Partially Accepted Orders' datatype='real' name='[% GoDroid Orders (copy 2)_1937533002520137728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_modified_orders])/SUM([no_orders])' />
            </column>
            <column caption='% GoWin Orders' datatype='real' name='[% GoDroid Orders (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_orders_gowin])/SUM([no_orders])' />
            </column>
            <column caption='% POS Orders' datatype='real' name='[% GoWin Orders (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_orders_pos])/SUM([no_orders])' />
            </column>
            <column caption='% OMA Orders' datatype='real' default-format='p0.0%' name='[% OMA Fail Rate (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_oma_orders])/SUM([no_orders])' />
            </column>
            <column caption='% PU Fail Rate' datatype='real' default-format='p0.00%' name='[% VD Fail Rate (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_fail_orders_pu])/SUM([no_orders_pu])' />
            </column>
            <column caption='% OD Orders' datatype='real' name='[Calculation_2036260364225028099]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_orders_od])/SUM([no_orders])' />
