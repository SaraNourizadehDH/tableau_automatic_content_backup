      <column caption='% Fail-Rate (VLOG)' datatype='real' name='[% Fail-Rate (C-DWH) (copy)_2554596537325629441]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vlog_failed_orders]) / SUM([vlog_orders])' />
      </column>
      <column caption='% Vendor Fail-Rate (C-DWH)' datatype='real' name='[% Fail-Rate (C-DWH) (copy)_5812176811885916160]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dwh_vendor_failed_orders]) / SUM([dwh_orders])' />
      </column>
      <column caption='% Vendor Fail-Rate (VLOG)' datatype='real' name='[% Fail-Rate (VLOG) (copy)_5812176811885928449]' role='measure' type='quantitative'>
