              <calculation class='tableau' formula='CASE [Parameters].[# OMA Orders Parameter 1]&#10;    WHEN &quot;# Orders&quot;&#10;        THEN SUM([no_orders])&#10;    WHEN &quot;% OMA Orders&quot;&#10;        THEN [% OMA Fail Rate (copy)]&#10;    WHEN &quot;% NGT Orders&quot;&#10;        THEN [Calculation_235313128092143616]&#10;    WHEN &quot;% Vendor Fail-rate&quot;&#10;        THEN [Calculation_4090042567939112963]&#10;    WHEN &quot;% CLOSED Vendor Fail-rate&quot;&#10;        THEN [% VD Fail Rate - UNREACHABLE (copy) (copy) (copy) (copy)_6587710776611438596]&#10;    WHEN &quot;% ITEM_UNAVAILABLE Vendor Fail-rate&quot;&#10;        THEN [% VD Fail Rate - UNREACHABLE (copy) (copy)_6587710776611418114]&#10;    WHEN &quot;% NO_RESPONSE Vendor Fail-rate&quot;&#10;        THEN [% VD Fail Rate - UNREACHABLE (copy) (copy) (copy)_6587710776611430403]&#10;    WHEN &quot;% TOO_BUSY Vendor Fail-rate&quot;&#10;        THEN [% VD Fail Rate - UNREACHABLE (copy)_6587710776611409921]&#10;    WHEN &quot;% UNKNOWN Vendor Fail-rate&quot;&#10;        THEN [% VD Fail Rate - UNREACHABLE (copy) (copy) (copy) (copy) (copy)_6587710776611479557]&#10;    WHEN &quot;% UNREACHABLE Vendor Fail-rate&quot;&#10;        THEN [% VD Fail Rate (copy 2)_6587710776611098624]&#10;    WHEN &quot;% Fail-rate&quot;&#10;        THEN [Calculation_517843633630994432]&#10;    WHEN &quot;% GoDroid Orders&quot;&#10;        THEN [Calculation_4090042570176884744]&#10;    WHEN &quot;% GoWin Orders&quot;&#10;        THEN [% GoDroid Orders (copy)]&#10;    WHEN &quot;% POS Orders&quot;&#10;        THEN [% GoWin Orders (copy)]&#10;    WHEN &quot;# POS Orders&quot;&#10;        THEN SUM([no_orders_pos])&#10;    WHEN &quot;% Partially Accepted Orders&quot;&#10;        THEN [% GoDroid Orders (copy 2)_1937533002520137728]&#10;END' />
