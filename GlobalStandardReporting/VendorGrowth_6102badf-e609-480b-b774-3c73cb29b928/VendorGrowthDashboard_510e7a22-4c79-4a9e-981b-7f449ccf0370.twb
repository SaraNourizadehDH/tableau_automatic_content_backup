            <column caption='% NGT Orders' datatype='real' default-format='p0.0%' name='[Calculation_235313128092143616]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_ngt_orders]) / SUM([no_orders])' />
            </column>
            <column caption='% OD Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_4008555566074580993]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_fail_orders_od])/SUM([no_orders_od])' />
            </column>
            <column caption='% VD Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_4008555566076235778]' role='measure' type='quantitative'>
