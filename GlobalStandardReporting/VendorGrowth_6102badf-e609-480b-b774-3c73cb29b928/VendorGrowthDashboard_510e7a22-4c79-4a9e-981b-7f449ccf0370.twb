            <column caption='Order Date (day and month)' datatype='date' datatype-customized='true' name='[Calculation_4008555566098100234]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[order_date]' />
            </column>
            <column caption='Manufacturer Cleaned' datatype='string' name='[Calculation_406309176525737984]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([Set 1]) OR NOT [Set 1]&#10;OR ISNULL([manufacturer]) THEN &apos;(Others)&apos;&#10;ELSE (&#10;    IF LEFT([manufacturer], 7)  =  &apos;SAMSUNG&apos; THEN &apos;SAMSUNG&apos;&#10;    ELSE TRIM([manufacturer])&#10;    END&#10;) END' />
            </column>
            <column caption='% Vendor Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_4090042567939112963]' role='measure' type='quantitative'>
