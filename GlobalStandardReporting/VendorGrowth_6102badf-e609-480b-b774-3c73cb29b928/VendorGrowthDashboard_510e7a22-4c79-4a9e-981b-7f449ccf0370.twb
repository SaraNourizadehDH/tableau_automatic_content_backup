      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0tzedlm0gbv1uy1ch7v1z13r1f2t].[sum:dwh_orders:qk]&quot;' value='C-DWH Orders' />
          <alias key='&quot;[federated.0tzedlm0gbv1uy1ch7v1z13r1f2t].[sum:vlog_orders:qk]&quot;' value='VLOG Orders' />
        </aliases>
      </column>
      <column caption='% Fail-Rate (C-DWH)' datatype='real' name='[Calculation_2554596537325363200]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dwh_failed_orders]) / SUM([dwh_orders])' />
      </column>
      <column caption='% VLOG Share' datatype='real' name='[Calculation_2554596537325916162]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vlog_orders]) / SUM([all_orders])' />
      </column>
      <column caption='Date Granularity' datatype='string' name='[Calculation_2554596537326182403]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Daily&apos;&#10;        THEN STR([order_date])&#10;    WHEN &apos;Weekly&apos;&#10;        THEN STR(YEAR([order_date])) + &quot;-&quot; + STR(WEEK([order_date]))&#10;    WHEN &apos;Monthly&apos;&#10;        THEN STR(YEAR([order_date])) + &quot;-&quot; + STR(MONTH([order_date]))&#10;    WHEN &apos;Quarterly&apos;&#10;        THEN STR(YEAR([order_date])) + &quot;-&quot; + STR(QUARTER([order_date]))&#10;    WHEN &apos;Yearly&apos;&#10;        THEN STR(YEAR([order_date]))&#10;END' />
      </column>
      <column caption='_BEFORE_YESTERDAY' datatype='boolean' name='[Calculation_2554596537330884612]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[order_date] &lt; DATEADD(&apos;day&apos;, -1, TODAY())' />
      </column>
      <column caption='Dimension (A)' datatype='string' name='[Calculation_2554596537356349447]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Choose Dimension (A) (copy)_2554596537355771909] = &apos;Region&apos; THEN [region]&#10;ELSEIF [Parameters].[Choose Dimension (A) (copy)_2554596537355771909] = &apos;Brand Name&apos; THEN [brand_name]&#10;ELSEIF [Parameters].[Choose Dimension (A) (copy)_2554596537355771909] = &apos;Country&apos; THEN [country_name]&#10;END' />
