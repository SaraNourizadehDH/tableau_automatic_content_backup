        <calculation class='tableau' formula='IF [Parameters].[Choose Fail Metric (red) (copy)] = &apos;Owner&apos; THEN [cancellation_owner]&#10;ELSEIF [Parameters].[Choose Fail Metric (red) (copy)] = &apos;Reason&apos; THEN [cancellation_reason]&#10;ELSEIF [Parameters].[Choose Fail Metric (red) (copy)] = &apos;Source&apos; THEN [cancellation_source]&#10;ELSEIF [Parameters].[Choose Fail Metric (red) (copy)] = &apos;Stage&apos; THEN [cancellation_stage]&#10;ELSEIF [Parameters].[Choose Fail Metric (red) (copy)] = &apos;Is upcoming order cancelled&apos; THEN STR([cancellation_is_upcoming_order])&#10;ELSEIF [Parameters].[Choose Fail Metric (red) (copy)] = &apos;(All)&apos; THEN &apos;&apos;&#10;END' />
