      <aliases enabled='yes' />
      <column caption='# Unreachable Fail Orders' datatype='integer' name='[# VD Fail Orders (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [cancellation_reason] = &apos;UNREACHABLE&apos; then  [no_orders] end)' />
      </column>
      <column caption='% Vendor Fail Rate (YoY Growth)' datatype='real' default-format='p0.0%' name='[% Fail Rate (YoY Growth) (copy)_377035738533511170]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(   [Calculation_4090042567939112963]&#10;    -&#10;    [% Fail Rate (prev. Year) (copy)_377035738533351425]&#10;)&#10;/&#10;    [% Fail Rate (prev. Year) (copy)_377035738533351425]'>
          <table-calc ordering-field='[federated.1in45pt0whh00q1ds0u0r139acdt].[Calculation_517843633631232002]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='% Vendor Fail Rate (Prev. Year)' datatype='real' default-format='p0.00%' name='[% Fail Rate (prev. Year) (copy)_377035738533351425]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Weekly&apos; THEN LOOKUP([Calculation_4090042567939112963],-53)&#10;WHEN &apos;Monthly&apos; THEN LOOKUP([Calculation_4090042567939112963],-12)&#10;WHEN &apos;Quarterly&apos; THEN LOOKUP([Calculation_4090042567939112963],-4)&#10;WHEN &apos;Yearly&apos; THEN LOOKUP([Calculation_4090042567939112963],-1)&#10;END'>
