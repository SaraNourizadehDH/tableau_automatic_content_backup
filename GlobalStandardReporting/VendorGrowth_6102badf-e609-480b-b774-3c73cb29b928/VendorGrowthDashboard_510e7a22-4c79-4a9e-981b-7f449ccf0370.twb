    <worksheet name='Fails Table by Cancel Reason'>
      <table>
        <view>
          <datasources>
            <datasource caption='rps_gsr_daily_dashboard_orders (rl)' name='federated.1in45pt0whh00q1ds0u0r139acdt' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose Fail Dimension (B)' datatype='string' name='[Choose Fail Metric (red) (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;Reason&quot;'>
              <calculation class='tableau' formula='&quot;Reason&quot;' />
            </column>
            <column caption='Choose Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
            <column caption='Choose Fail Metric' datatype='string' name='[Parameter 4 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Share Of Fails (\%)&quot;'>
              <calculation class='tableau' formula='&quot;Share Of Fails (%)&quot;' />
            </column>
            <column caption='Choose Fail Dimension (A)' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Owner&quot;'>
              <calculation class='tableau' formula='&quot;Owner&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1in45pt0whh00q1ds0u0r139acdt'>
            <column caption='Fail Rate (by Cancel Owner)' datatype='real' default-format='p0.00%' name='[Calculation_3351663342814912512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_fail_orders]) / sum({fixed [Calculation_517843633631232002]: SUM([no_orders])} )' />
            </column>
            <column caption='Order Date (day and month)' datatype='date' datatype-customized='true' name='[Calculation_4008555566098100234]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[order_date]' />
            </column>
            <column caption='Date Granularity' datatype='string' name='[Calculation_517843633631232002]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&apos;Daily&apos; THEN STR([Calculation_4008555566098100234])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Weekly&apos; THEN [order_week]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Monthly&apos; THEN [order_month]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Quarterly&apos; THEN STR(DATE(DATETRUNC(&apos;quarter&apos;,[order_date])))&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Yearly&apos; THEN STR([order_year])&#10;END' />
            </column>
            <column caption='Fail Metric' datatype='integer' name='[Calculation_639440833040257024]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4 1] = &apos;Share Of Fails (%)&apos;&#10;    THEN SUM([no_fail_orders])&#10;    ELSE SUM([no_orders]) &#10;END' />
            </column>
            <column caption='Cancellation Dimension (A)' datatype='string' name='[Calculation_639440833043079169]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Owner&apos; THEN [cancellation_owner]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Reason&apos; THEN [cancellation_reason]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Source&apos; THEN [cancellation_source]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Stage&apos; THEN [cancellation_stage]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Is upcoming order cancelled&apos; THEN STR([cancellation_is_upcoming_order])&#10;END' />
            </column>
            <column caption='Cancellation Dimension (B)' datatype='string' name='[Cancellation Metric 1 (copy)_639440833043345410]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Choose Fail Metric (red) (copy)] = &apos;Owner&apos; THEN [cancellation_owner]&#10;ELSEIF [Parameters].[Choose Fail Metric (red) (copy)] = &apos;Reason&apos; THEN [cancellation_reason]&#10;ELSEIF [Parameters].[Choose Fail Metric (red) (copy)] = &apos;Source&apos; THEN [cancellation_source]&#10;ELSEIF [Parameters].[Choose Fail Metric (red) (copy)] = &apos;Stage&apos; THEN [cancellation_stage]&#10;ELSEIF [Parameters].[Choose Fail Metric (red) (copy)] = &apos;Is upcoming order cancelled&apos; THEN STR([cancellation_is_upcoming_order])&#10;ELSEIF [Parameters].[Choose Fail Metric (red) (copy)] = &apos;(All)&apos; THEN &apos;&apos;&#10;END' />
            </column>
            <column caption='POS Chain Name' datatype='string' name='[application_chain_name]' role='dimension' type='nominal' />
            <column caption='App Client' datatype='string' name='[application_client_name]' role='dimension' type='nominal' />
            <column caption='POS Integration Name' datatype='string' name='[application_integration_name]' role='dimension' type='nominal' />
            <column caption='POS Integration Type' datatype='string' name='[application_integration_type]' role='dimension' type='nominal' />
            <column caption='Brand Name' datatype='string' name='[brand_name]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[cancellation_is_upcoming_order]' role='dimension' type='nominal'>
              <aliases>
                <alias key='%null%' value='N/A' />
              </aliases>
            </column>
            <column caption='Cancellation Owner' datatype='string' name='[cancellation_owner]' role='dimension' type='nominal' />
            <column caption='Cancellation Reason' datatype='string' name='[cancellation_reason]' role='dimension' type='nominal' />
            <column caption='Cancellation Source' datatype='string' name='[cancellation_source]' role='dimension' type='nominal' />
