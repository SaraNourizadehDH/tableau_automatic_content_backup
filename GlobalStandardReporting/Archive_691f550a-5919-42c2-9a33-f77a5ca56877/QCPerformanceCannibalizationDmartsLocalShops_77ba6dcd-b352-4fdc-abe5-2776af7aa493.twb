    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='5. Next Month Retention '>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff'>  &lt;Sheet Name&gt;</run>
            <run>Æ&#10;</run>
            <run fontcolor='#ffffff' fontsize='14'>  Are our customers leaving us to a specific vertical/chain or they are also inactive at QC level?</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/CannibalizationDmartsLocalShops/5_NextMonthRetention?rev=' id='5_NextMonthRetention' path='/t/GlobalStandardReporting/workbooks/CannibalizationDmartsLocalShops' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='1000' maxwidth='1200' minheight='1000' minwidth='1200' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='BigQuery' name='federated.0vuz0ri1edcs6s161cmpx172y5vw' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Granularity' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Vertical Parent&quot;'>
          <calculation class='tableau' formula='&quot;Vertical Parent&quot;' />
          <members>
            <member value='&quot;Vertical Parent&quot;' />
            <member value='&quot;Vertical Type&quot;' />
            <member value='&quot;Chain&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.0vuz0ri1edcs6s161cmpx172y5vw'>
        <column caption='Element 1 (filter)' datatype='string' name='[Calculation_1259319082411319298]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;    WHEN &quot;Vertical Parent&quot; THEN IF [granularity] = &quot;vertical_parent&quot; THEN [element_1] END&#13;&#10;    WHEN &quot;Vertical Type&quot; THEN IF [granularity] = &quot;vertical_type&quot; THEN [element_1] END&#13;&#10;    WHEN &quot;Chain&quot; THEN IF [granularity] = &quot;chain&quot; THEN [element_1] END&#13;&#10;END' />
        </column>
        <column caption='Element 2 (filter)' datatype='string' name='[Element 1 (filter) (copy)_1259319082411917315]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;    WHEN &quot;Vertical Parent&quot; THEN IF [granularity] = &quot;vertical_parent&quot; THEN [element_2] END&#13;&#10;    WHEN &quot;Vertical Type&quot; THEN IF [granularity] = &quot;vertical_type&quot; THEN [element_2] END&#13;&#10;    WHEN &quot;Chain&quot; THEN IF [granularity] = &quot;chain&quot; THEN [element_2] END&#13;&#10;END' />
        </column>
        <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
        <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
        <column caption='Month' datatype='date' default-format='*MMM-YY' name='[month]' role='dimension' type='ordinal' />
        <column-instance column='[Calculation_1259319082411319298]' derivation='None' name='[none:Calculation_1259319082411319298:nk]' pivot='key' type='nominal' />
        <column-instance column='[Element 1 (filter) (copy)_1259319082411917315]' derivation='None' name='[none:Element 1 (filter) (copy)_1259319082411917315:nk]' pivot='key' type='nominal' />
        <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
        <column-instance column='[management_entity]' derivation='None' name='[none:management_entity:nk]' pivot='key' type='nominal' />
        <column-instance column='[month]' derivation='None' name='[none:month:qk]' pivot='key' type='quantitative' />
        <column-instance column='[segment]' derivation='None' name='[none:segment:nk]' pivot='key' type='nominal' />
        <column caption='Segment' datatype='string' name='[segment]' role='dimension' type='nominal' />
      </datasource-dependencies>
