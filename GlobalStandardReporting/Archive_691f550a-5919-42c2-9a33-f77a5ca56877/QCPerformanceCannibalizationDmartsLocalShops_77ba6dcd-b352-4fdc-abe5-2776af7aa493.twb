              <button action='' active-visual-state-index='1' button-type='text'>
                <toggle-action>tabdoc:toggle-button-click-action window-id=&quot;{669C8797-2AC0-4E57-B1DB-9D65B94208C1}&quot; zone-id=&quot;108&quot; zone-ids=[107]</toggle-action>
