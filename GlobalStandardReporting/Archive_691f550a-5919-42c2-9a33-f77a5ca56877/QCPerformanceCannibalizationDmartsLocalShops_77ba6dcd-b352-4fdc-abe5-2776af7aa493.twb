                <zone fixed-size='207' h='21500' id='75' is-fixed='true' is-scaled='1' param='Image/DM __ LS cannibalization_ driver tree (5).jpg' type-v2='bitmap' w='98666' x='667' y='9000'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
