      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <layout-options>
            <title>
              <formatted-text>
                <run bold='true' fontcolor='#ffffff'>  &lt;Sheet Name&gt;</run>
                <run>Æ&#10;</run>
                <run fontcolor='#ffffff' fontsize='14'>  Are our customers leaving us to a specific vertical/chain or they are also inactive at QC level?</run>
              </formatted-text>
            </title>
          </layout-options>
          <size maxheight='1450' minheight='1450' sizing-mode='vscroll' />
