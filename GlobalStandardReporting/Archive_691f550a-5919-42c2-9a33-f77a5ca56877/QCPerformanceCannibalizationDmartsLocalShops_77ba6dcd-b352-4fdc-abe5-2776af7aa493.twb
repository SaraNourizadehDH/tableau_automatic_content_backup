            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Top X LS Chains (cleaned)' datatype='real' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='10.'>
              <calculation class='tableau' formula='10.' />
              <range max='50.0' />
            </column>
            <column caption='Color' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Vertical Parent&quot;'>
              <calculation class='tableau' formula='&quot;Vertical Parent&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ugmhcu1b16e1n13buiqw1qju4r5'>
            <column caption='Chain Name Cleaned (parametrized)' datatype='string' name='[Calculation_164944371490619392]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([Parameters].[Parameter 1] &gt;= [chain_cleaned_rank] OR ISNULL([chain_cleaned_rank])) THEN [chain_name_cleaned] ELSE &quot;Other&quot; END' />
            </column>
            <column caption='Color' datatype='string' name='[Calculation_164944371491061762]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]    &#13;&#10;    WHEN &quot;Vertical Parent&quot; THEN [vertical_parent]&#13;&#10;    WHEN &quot;Vertical Type&quot; THEN [vertical_type]&#13;&#10;    WHEN &quot;Chain&quot; THEN [Calculation_164944371490619392]&#13;&#10;END' />
            </column>
            <column caption='Sorting Colors' datatype='integer' name='[Calculation_164944371491520515]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_164944371491061762] = &quot;Dmarts&quot; THEN 99&#13;&#10;ELSEIF [Calculation_164944371491061762] = &quot;Other&quot; THEN 1&#13;&#10;ELSE 2&#13;&#10;END' />
            </column>
            <column caption='GBV previous 3M p/customer' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_631348407606419456]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gbv_prev_3m])/AVG([mau])' />
            </column>
            <column-instance column='[Calculation_164944371491520515]' derivation='Avg' name='[avg:Calculation_164944371491520515:qk]' pivot='key' type='quantitative' />
