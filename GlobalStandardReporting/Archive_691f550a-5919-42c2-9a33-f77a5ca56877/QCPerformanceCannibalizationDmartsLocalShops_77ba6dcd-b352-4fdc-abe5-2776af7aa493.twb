    <worksheet name='Pricing/Incentives '>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#d30000' fontname='Tableau Bold' fontsize='18'>Is there any Pricing or Incentives reason why customers have been migrating?</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='pede_cannibalization_overall (dev_dmart)' name='federated.0j8xv4n0tloldk19w97z5089jsqq' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Top X LS Chains (cleaned)' datatype='real' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='10.'>
              <calculation class='tableau' formula='10.' />
              <range max='50.0' />
            </column>
            <column caption='Vouchers' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Total&quot;'>
              <calculation class='tableau' formula='&quot;Total&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0j8xv4n0tloldk19w97z5089jsqq'>
            <column caption='Chain Name Cleaned (Parametrized)' datatype='string' name='[Calculation_1112389142492692482]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([Parameters].[Parameter 1] &gt;= [chain_cleaned_rank] OR ISNULL([chain_cleaned_rank])) THEN [chain_name_cleaned] ELSE &quot;Other&quot; END' />
            </column>
            <column caption='Granularity (field)' datatype='string' name='[Calculation_1112389142493032451]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [granularity] = &quot;chain&quot; THEN [Calculation_1112389142492692482]&#13;&#10;ELSEIF [granularity] = &quot;vertical_parent&quot; THEN [vertical_parent]&#13;&#10;ELSEIF [granularity] = &quot;vertical_type&quot; THEN [vertical_type]&#13;&#10;END' />
            </column>
            <column caption='Sorting colors' datatype='integer' name='[Calculation_1112389142501163012]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_1112389142493032451] = &quot;Dmarts&quot; THEN 99&#13;&#10;ELSEIF [Calculation_1112389142493032451] = &quot;Other&quot; THEN 1&#13;&#10;ELSE 2&#13;&#10;END' />
            </column>
            <column caption='Nominal DF p/o' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_423056936163868672]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([df])/SUM([orders]-[orders_wo_df])' />
            </column>
            <column caption='Price Index' datatype='real' default-format='p0.0%' name='[Calculation_423056936167702534]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([index_x_products])/SUM([products])' />
            </column>
            <column caption='Vouchers as % of GBV' datatype='real' default-format='p0.0%' name='[Calculation_423056936167890951]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#13;&#10;    WHEN &quot;DH&quot; THEN [Nominal DF p/o (copy)_423056936164302851]&#13;&#10;    WHEN &quot;Other&quot; THEN [Vouchers DH as % of GBV (copy)_423056936164446212]&#13;&#10;    ELSE [Vouchers Other as % of GBV (copy)_423056936164519941]&#13;&#10;END' />
            </column>
            <column caption='% Orders w/FDF' datatype='real' default-format='p0.0%' name='[Nominal DF p/o (copy)_423056936164007937]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_wo_df])/SUM([orders])' />
            </column>
            <column caption='Vouchers DH as % of GBV' datatype='real' name='[Nominal DF p/o (copy)_423056936164302851]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vouchers_dh])/SUM([gbv])' />
            </column>
            <column caption='Vouchers Other as % of GBV' datatype='real' name='[Vouchers DH as % of GBV (copy)_423056936164446212]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vouchers_other])/SUM([gbv])' />
            </column>
            <column caption='Vouchers Total as % of GBV' datatype='real' name='[Vouchers Other as % of GBV (copy)_423056936164519941]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vouchers_total])/SUM([gbv])' />
            </column>
            <column-instance column='[Calculation_1112389142501163012]' derivation='Avg' name='[avg:Calculation_1112389142501163012:qk]' pivot='key' type='quantitative' />
            <column aggregation='Sum' caption='Chain Cleaned Rank' datatype='integer' name='[chain_cleaned_rank]' role='dimension' type='ordinal' />
            <column caption='Chain Name Cleaned' datatype='string' name='[chain_name_cleaned]' role='dimension' type='nominal' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='real' name='[df]' role='measure' type='quantitative' />
            <column caption='GBV' datatype='real' default-format='*#,##0,&quot;K&quot;' name='[gbv]' role='measure' type='quantitative' />
            <column caption='Granularity' datatype='string' name='[granularity]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;chain&quot;' value='Chain' />
