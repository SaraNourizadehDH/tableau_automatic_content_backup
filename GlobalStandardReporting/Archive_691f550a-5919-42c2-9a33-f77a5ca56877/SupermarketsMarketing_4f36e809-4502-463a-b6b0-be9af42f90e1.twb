        <calculation class='tableau' formula='SUM([dmart_mau])' />
      </column>
      <column caption='Dmart MAU who also shop at Supermarket' datatype='integer' default-format='n#,##0,.0K;-#,##0,.0K' name='[Calculation_1876312232897912839]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([supermarket_and_dmart_mau])' />
      </column>
      <column caption='% Dmart MAU that shop at Supermarket' datatype='real' default-format='p0.0%' name='[Calculation_1876312232898191368]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1876312232897912839]/[Calculation_1876312232897695750]' />
      </column>
