        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.07zcnq31ojnppy172q6nu0o3oazs' name='Custom SQL Query' type='text'>SELECT&#13;
    overall.*&#13;
  , t0&#13;
  , r0&#13;
  , t1&#13;
  , r1&#13;
  , t3&#13;
  , r3&#13;
  , t6&#13;
  , r6&#13;
  , t12&#13;
  , r12&#13;
  , non_trials_orders&#13;
  , non_trials_users&#13;
  , orders_1m&#13;
  , users_1m&#13;
  , orders_3m&#13;
  , users_3m&#13;
  , orders_6m&#13;
  , users_6m&#13;
  , vouchers_spend_on_trialists&#13;
  , vouchers_spend_on_existing_customers&#13;
  , vouchers_spend_on_trial_orders&#13;
  , vouchers_spend_on_acquisitions_orders&#13;
  , vouchers_spend_on_x_trials_orders&#13;
  , supermarket_mau&#13;
  , supermarket_only_mau&#13;
  , dmart_mau&#13;
  , dmart_only_mau&#13;
  , supermarket_and_dmart_mau&#13;
  , supermarket_orders&#13;
  , dmart_orders&#13;
  , dmart_orders_by_supermarket_mau&#13;
  , supermarket_orders_by_dmart_mau&#13;
  &#13;
FROM `dh-darkstores-stg.dev_dmart.fw_ls_sm_marketing_pt1_overall` overall&#13;
&#13;
LEFT JOIN `dh-darkstores-stg.dev_dmart.marketing_dm_pt2_prospects` prospects&#13;
  ON overall.global_entity_id = prospects.global_entity_id&#13;
    AND overall.month = prospects.month&#13;
LEFT JOIN `dh-darkstores-stg.dev_dmart.fw_ls_sm_marketing_pt3_retention` retention&#13;
  ON overall.global_entity_id = retention.global_entity_id&#13;
    AND overall.month = retention.order_month&#13;
LEFT JOIN `dh-darkstores-stg.dev_dmart.fw_ls_sm_marketing_pt4_frequency` frequency&#13;
  ON overall.global_entity_id = frequency.global_entity_id&#13;
    AND overall.month = frequency.order_month&#13;
LEFT JOIN `dh-darkstores-stg.dev_dmart.fw_ls_sm_marketing_pt5_incentives_usage` incentives&#13;
  ON overall.global_entity_id = incentives.global_entity_id&#13;
    AND overall.month = incentives.order_month&#13;
LEFT JOIN `dh-darkstores-stg.dev_dmart.fw_ls_sm_marketing_pt6_complementation` complementation&#13;
  ON overall.global_entity_id = complementation.global_entity_id&#13;
    AND overall.month = complementation.month</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
