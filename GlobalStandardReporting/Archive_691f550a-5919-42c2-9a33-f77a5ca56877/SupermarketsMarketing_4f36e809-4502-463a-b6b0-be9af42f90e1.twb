        <calculation class='tableau' formula='SUM([supermarket_and_dmart_mau])' />
      </column>
      <column caption='% Supermarket MAU that shop at Dmarts' datatype='real' default-format='p0.0%' name='[Calculation_1876312232896458755]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1876312232896180225]/[Calculation_1876312232895655936]' />
      </column>
      <column caption='Orders by Supermarket MAUs at Dmarts' datatype='integer' default-format='n#,##0,.0K;-#,##0,.0K' name='[Calculation_1876312232896827396]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dmart_orders_by_supermarket_mau])' />
      </column>
