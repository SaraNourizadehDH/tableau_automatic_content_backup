    <worksheet name='2. Trials'>
      <repository-location id='2_Trials' path='/t/GlobalStandardReporting/workbooks/Supermarkets-Marketing' revision='' site='GlobalStandardReporting' />
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='16'>&lt;Sheet Name&gt;:</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='14'>1. How many trials do we drive for QC?</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='14'>2. How many orders do we drive for QC?</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='14'>3. How many of our MAU are trialists?</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='14'>4. How much are we vouchering trialists?</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='14'>5. How much of our spend goes to trialists?</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (curated_data_shared_dmart)' name='federated.101buhy02v0q1918az8jf1b58522' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Color' datatype='string' name='[Structure (copy)_278941737201823751]' param-domain-type='list' role='measure' type='nominal' value='&quot;Management Entity&quot;'>
              <calculation class='tableau' formula='&quot;Management Entity&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.101buhy02v0q1918az8jf1b58522'>
            <column caption='QC Trials at Dmarts / QC Trials' datatype='real' default-format='p0.0%' name='[Calculation_1060034802633187328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qc_dm_trials])/SUM([qc_trials])' />
            </column>
            <column caption='X-trials w/o vouchers' datatype='integer' name='[Calculation_1089871145508843520]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(x_trials - [x_trials_w_voucher])' />
            </column>
            <column caption='QC Trials at Supermarket / QC Trials' datatype='real' default-format='p0.0%' name='[Calculation_1106478173364375552]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(qc_vt_trials)/SUM([qc_trials])' />
            </column>
            <column caption='Supermarket Orders / QC Orders' datatype='real' default-format='p0.0%' name='[Calculation_1106478173396979713]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(orders)/SUM(qc_orders)' />
            </column>
            <column caption='Trials / MAU' datatype='real' default-format='p0.0%' name='[Calculation_278941737201319942]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([trials])/SUM([mau])' />
            </column>
            <column caption='% Trials w/vouchers' datatype='real' default-format='p0.0%' name='[Calculation_278941737202257929]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([trials_w_voucher])/SUM([trials])' />
            </column>
            <column caption='% Voucher spend on trialists' datatype='real' default-format='p0.0%' name='[Calculation_399694502978637824]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vouchers_spend_on_trialists])/SUM([vouchers_spend_on_trialists] + [vouchers_spend_on_existing_customers])' />
            </column>
            <column caption='Color' datatype='string' name='[Structure (copy)_278941737201922056]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Structure (copy)_278941737201823751]&#13;&#10;    WHEN &quot;DH Group&quot; THEN &quot;DH Group&quot;&#13;&#10;    WHEN &quot;Segment&quot; THEN [segment]&#13;&#10;    WHEN &quot;Management Entity&quot; THEN [management_entity]&#13;&#10;    WHEN &quot;Country&quot; THEN [country_name]&#13;&#10;END' />
            </column>
            <column caption='X-trials w/voucher' datatype='integer' name='[X-trials w/o vouchers (copy)_1089871145509068801]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([x_trials_w_voucher])' />
            </column>
            <column caption='Acquisitions w/o vouchers' datatype='integer' name='[X-trials w/o vouchers (copy)_1089871145509208066]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([acquisitions] - [acquisitions_w_voucher])' />
            </column>
            <column caption='Acquisitions w/voucher' datatype='integer' name='[X-trials w/voucher (copy)_1089871145509326851]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([acquisitions_w_voucher])' />
            </column>
            <column caption='Acquisitions' datatype='integer' name='[acquisitions]' role='measure' type='quantitative' />
            <column datatype='integer' name='[acquisitions_w_voucher]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
