      <column caption='Reorder Rate' datatype='real' default-format='p0.0%' name='[Calculation_278941737226194968]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;    WHEN &quot;1M&quot; THEN [Calculation_278941737223696405]&#13;&#10;    WHEN &quot;3M&quot; THEN [Reorder Rate 1M (copy)_278941737223823382]&#13;&#10;    WHEN &quot;6M&quot; THEN [Reorder Rate 3M (copy)_278941737223893015]&#13;&#10;END' />
