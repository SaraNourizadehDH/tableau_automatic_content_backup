        </calculation>
      </column>
      <column caption='Structure' datatype='string' name='[Calculation_278941737197064195]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;DH Group&quot; THEN &quot;DH Group&quot;&#13;&#10;    WHEN &quot;Segment&quot; THEN [segment]&#13;&#10;    WHEN &quot;Management Entity&quot; THEN [management_entity]&#13;&#10;    WHEN &quot;Country&quot; THEN [country_name]&#13;&#10;END' />
      </column>
      <column caption='Trials / MAU' datatype='real' default-format='p0.0%' name='[Calculation_278941737201319942]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([trials])/SUM([mau])' />
      </column>
      <column caption='% Trials w/vouchers' datatype='real' default-format='p0.0%' name='[Calculation_278941737202257929]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([trials_w_voucher])/SUM([trials])' />
      </column>
      <column caption='Avg. Dmart lifetime order w/voucher' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_278941737202569226]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([avg_vouchered_order_rank])' />
      </column>
      <column caption='X-trials / Prospects' datatype='real' default-format='p0.0%' name='[Calculation_278941737208406028]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([x_trials])/SUM([prospect_mau])' />
      </column>
      <column caption='% X-trials w/vouchers' datatype='real' default-format='p0.0%' name='[Calculation_278941737208803341]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([x_trials_w_voucher])/SUM([x_trials])' />
      </column>
      <column caption='Avg. # of orders in Platform at X trial moment' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_278941737209188366]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([avg_order_rank_for_xtrial])' />
      </column>
      <column caption='Months to X sell all Covered Prospects' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_278941737212698639]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([prospect_mau_covered])/SUM([x_trials]-0) &lt; 0 THEN -1 ELSE SUM([prospect_mau_covered])/SUM([x_trials]-0) END' />
      </column>
      <column caption='Covered Prospects' datatype='real' default-format='p0.0%' name='[Calculation_278941737217273872]' role='measure' type='quantitative'>
