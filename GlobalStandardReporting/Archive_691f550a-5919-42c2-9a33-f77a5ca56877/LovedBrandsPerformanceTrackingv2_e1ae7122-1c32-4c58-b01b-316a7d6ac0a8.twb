    <worksheet name='LB Categorization Tracking'>
      <layout-options>
        <title>
          <formatted-text>
            <run>LB Categorization Tracking</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run bold='true'>Category Definitions:</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#e15759' fontname='Tableau Bold'>Churning -</run>
            <run fontcolor='#e15759'> Vendor that was a loved brand in the previous pipeline run but is classified as a Non Loved Brand in the current pipeline run. </run>
            <run>Æ&#10;</run>
            <run fontcolor='#76b7b2' fontname='Tableau Bold'>Existing LB -</run>
            <run fontcolor='#76b7b2'> Vendor that was a loved brand in the previous pipeline run and is classified as a Loved Brand in the current pipeline run. </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#59a14f' fontname='Tableau Bold'>New LB - </run>
            <run bold='true' fontcolor='#59a14f'>Vendor that was never previously classified as a loved brand and is classed as a loved brand in the current pipeline.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#b07aa1' fontname='Tableau Bold'>Returning - </run>
            <run bold='true' fontcolor='#b07aa1'>Vendor that was a Non Loved Brand in the previous pipeline run but is classed as a Loved Brand in the current pipeline run. To be classified as returning, the vendor must have </run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#f28e2b' fontname='Tableau Bold'>Existing NLB -</run>
            <run bold='true' fontcolor='#f28e2b'> Vendor that had been a NLB in the previous pipeline run and continued to be a NLB in the current pipeline. </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#edc948' fontname='Tableau Bold'>New NLB </run>
            <run bold='true' fontcolor='#edc948'>- Vendor previously not included in LB pipeline and is a Non-Loved Brand in its first pipeline run. </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#b4b4b4' fontname='Tableau Bold'>UNKNOWN -</run>
            <run bold='true' fontcolor='#b4b4b4'> Vendor did not meet any existing performance categorization criteria.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='orders_lb_performance_tracking' name='federated.1t6ubz51fmf46b1f301eu1ps8ico' />
          </datasources>
          <datasource-dependencies datasource='federated.1t6ubz51fmf46b1f301eu1ps8ico'>
            <column caption='Category' datatype='string' name='[category]' role='dimension' type='nominal' />
            <column-instance column='[category]' derivation='Count' name='[cnt:category:qk]' pivot='key' type='quantitative' />
            <column caption='Entity Id (Final Vendor Categorized Performance All Data Loved Brands Scaled Code)' datatype='string' name='[entity_id (final_vendor_categorized_performance_all_data_loved_brands_scaled_code)]' role='dimension' type='nominal' />
            <column caption='Master Asa Id' datatype='integer' name='[master_asa_id]' role='dimension' type='ordinal' />
