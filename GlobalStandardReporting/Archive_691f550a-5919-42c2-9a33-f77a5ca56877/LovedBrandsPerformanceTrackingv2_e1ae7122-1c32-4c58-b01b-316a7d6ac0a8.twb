              <calculation class='tableau' formula='{FIXED [entity_id], [asa_common_name]: SUM(IF [Calculation_146648470136025099] = &quot;Pre-Period&quot; THEN [gmv_local] ELSE 0 END)}' />
            </column>
            <column caption='period' datatype='string' name='[Calculation_146648470136025099]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [created_date_utc] &gt;= [Parameters].[Parameter 1] AND [created_date_utc] &lt; [Parameters].[pre_period_begin (copy)_146648470135615497] THEN &apos;Pre-Period&apos;&#13;&#10;ELSEIF [created_date_utc] &gt;= [Parameters].[pre_period_begin (copy)_146648470135615497] AND [created_date_utc] &lt; [Parameters].[pre_period_end_post_period_begin (copy)_146648470135787530] THEN &apos;Post-Period&apos;&#13;&#10;END' />
            </column>
            <column caption='Order Count Post Period' datatype='integer' name='[GMV Local Post Period (copy)_146648470137712653]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [entity_id], [asa_common_name]: COUNTD(IF [Calculation_146648470136025099] = &quot;Post-Period&quot; THEN [platform_order_code] END)}' />
            </column>
            <column caption='GMV Local Uplift' datatype='real' default-format='p0.0%' name='[GMV Local Post Period (copy)_146648470139019278]' role='measure' type='quantitative'>
