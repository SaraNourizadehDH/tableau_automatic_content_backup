    <worksheet name='Combined ASA Performance Data Table - Pre/Post Stats'>
      <layout-options>
        <title>
          <formatted-text>
            <run>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='orders_lb_performance_tracking' name='federated.1t6ubz51fmf46b1f301eu1ps8ico' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='pre_period_begin' datatype='date' name='[Parameter 1]' param-domain-type='any' role='measure' type='quantitative' value='#2023-01-01#'>
              <calculation class='tableau' formula='#2023-01-01#' />
            </column>
            <column caption='pre_period_end_post_period_begin' datatype='date' name='[pre_period_begin (copy)_146648470135615497]' param-domain-type='any' role='measure' type='quantitative' value='#2023-01-30#'>
              <calculation class='tableau' formula='#2023-01-30#' />
            </column>
            <column caption='post_period_end' datatype='date' name='[pre_period_end_post_period_begin (copy)_146648470135787530]' param-domain-type='any' role='measure' type='quantitative' value='#2023-02-28#'>
              <calculation class='tableau' formula='#2023-02-28#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1t6ubz51fmf46b1f301eu1ps8ico'>
            <column caption='GMV Local Pre Period' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_146648470133448711]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [entity_id], [asa_common_name]: SUM(IF [Calculation_146648470136025099] = &quot;Pre-Period&quot; THEN [gmv_local] ELSE 0 END)}' />
            </column>
            <column caption='period' datatype='string' name='[Calculation_146648470136025099]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [created_date_utc] &gt;= [Parameters].[Parameter 1] AND [created_date_utc] &lt; [Parameters].[pre_period_begin (copy)_146648470135615497] THEN &apos;Pre-Period&apos;&#13;&#10;ELSEIF [created_date_utc] &gt;= [Parameters].[pre_period_begin (copy)_146648470135615497] AND [created_date_utc] &lt; [Parameters].[pre_period_end_post_period_begin (copy)_146648470135787530] THEN &apos;Post-Period&apos;&#13;&#10;END' />
            </column>
            <column caption='Order Count Post Period' datatype='integer' name='[GMV Local Post Period (copy)_146648470137712653]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [entity_id], [asa_common_name]: COUNTD(IF [Calculation_146648470136025099] = &quot;Post-Period&quot; THEN [platform_order_code] END)}' />
            </column>
            <column caption='Gross Profit Local Post Period' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[GMV Local Post Period (copy)_146648470142435345]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [entity_id], [asa_common_name]: SUM(IF [Calculation_146648470136025099] = &quot;Post-Period&quot; THEN [gross_profit_local] ELSE 0 END)}' />
            </column>
            <column caption='Order Count Pre Period' datatype='integer' name='[GMV Local Pre Period (copy)_146648470137712652]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [entity_id], [asa_common_name]: COUNTD(IF [Calculation_146648470136025099] = &quot;Pre-Period&quot; THEN [platform_order_code] END)}' />
            </column>
            <column caption='Gross Profit Local Pre Period' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[GMV Local Pre Period (copy)_146648470142537746]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [entity_id], [asa_common_name]: SUM(IF [Calculation_146648470136025099] = &quot;Pre-Period&quot; THEN [gross_profit_local] ELSE 0 END)}' />
            </column>
            <column caption='GMV Local Uplift_agg' datatype='real' default-format='p0.0%' name='[GMV Local Uplift (copy)_113715898125365248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([GMV Pre Period (copy)_146648470134845448]) / SUM([Calculation_146648470133448711]) - 1' />
            </column>
            <column caption='GMV Local Post Period' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[GMV Pre Period (copy)_146648470134845448]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [entity_id], [asa_common_name]: SUM(IF [Calculation_146648470136025099] = &quot;Post-Period&quot; THEN [gmv_local] ELSE 0 END)}' />
            </column>
            <column caption='Gross Profit Local Uplift_agg' datatype='real' default-format='p0.0%' name='[Gross Profit Local Uplift (copy)_113715898125553665]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([GMV Local Post Period (copy)_146648470142435345]) / SUM([GMV Local Pre Period (copy)_146648470142537746]) - 1' />
            </column>
            <column caption='Order Count Uplift_agg' datatype='real' default-format='p0.0%' name='[Order Count Uplift (copy)_113715898129215490]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([GMV Local Post Period (copy)_146648470137712653]) / SUM([GMV Local Pre Period (copy)_146648470137712652]) - 1' />
            </column>
