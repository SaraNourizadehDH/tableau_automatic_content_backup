      <aliases enabled='yes' />
      <column caption='AAA Chain' datatype='string' name='[AAA_Chain]' role='dimension' type='nominal' />
      <column caption='CVR2' datatype='real' name='[CVR1 (copy)_259801447856136192]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL([transaction_and_shop_list_loaded],0))/SUM([shop_list_loaded])' />
      </column>
      <column caption='Search Usage' datatype='real' name='[Calculation_1049338726733070336]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([search_result_sessions])/SUM([shop_details_loaded])' />
      </column>
      <column caption='Search CVR' datatype='real' name='[Calculation_1049338726734766081]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([transaction_search_sessions])/SUM([search_result_sessions])' />
      </column>
      <column caption='Search Transaction Share' datatype='real' name='[Calculation_1049338726735265794]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([transaction_search_sessions])/SUM([transactions])' />
      </column>
      <column caption='Sessions' datatype='integer' name='[Calculation_108367912195743744]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [granularity]=&apos;Vertical Parent&apos; and [vertical_parent]=&apos;Dmarts&apos;&#13;&#10;then [total_sessions]&#13;&#10;elseif [granularity]=&apos;Vertical Parent&apos; and [vertical_parent]=&apos;Local Shops&apos;&#13;&#10;then [total_sessions]&#13;&#10;elseif [granularity]=&apos;Country&apos; then [total_sessions]&#13;&#10;END' />
      </column>
      <column caption='CVR1' datatype='real' name='[Calculation_1148699421812264960]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL([transaction_and_qchomescreen_loaded],0))/SUM([qcHomescreen])' />
      </column>
      <column caption='CVR3' datatype='real' name='[Calculation_1148699421812817921]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([transaction_and_shop_details_loaded])/SUM([shop_details_loaded])' />
      </column>
      <column caption='mCVR1' datatype='real' name='[Calculation_1148699421819211778]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([shop_list_loaded_and_qchomescreen_loaded])/SUM([qcHomescreen])' />
      </column>
      <column caption='mCVR3' datatype='real' name='[Calculation_1148699421819342851]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([checkout_and_shop_details_loaded])/SUM([shop_details_loaded])' />
      </column>
      <column caption='mCVR4' datatype='real' name='[Calculation_1148699421819482116]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([transaction_and_checkout])/SUM([checkout])' />
      </column>
      <column caption='Rank_Chain' datatype='boolean' name='[Calculation_1395271523166253058]' role='measure' type='nominal'>
        <calculation class='tableau' formula='RANK_UNIQUE(SUM({FIXED [AAA_Chain],[global_entity_id]:SUM([total_sessions])}),&apos;desc&apos;)&lt;=[Parameters].[Parameter 9]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='CVR' datatype='real' name='[Calculation_259801448005726212]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 8]=&apos;CVR1&apos; THEN [Calculation_1148699421812264960]&#13;&#10;ELSEIF [Parameters].[Parameter 8]=&apos;CVR2&apos; THEN [CVR1 (copy)_259801447856136192]&#13;&#10;ELSEIF [Parameters].[Parameter 8]=&apos;CVR3&apos; THEN [Calculation_1148699421812817921]&#13;&#10;ELSEIF [Parameters].[Parameter 8]=&apos;mCVR1&apos; THEN [Calculation_1148699421819211778]&#13;&#10;ELSEIF [Parameters].[Parameter 8]=&apos;mCVR2&apos; THEN [mCVR2 (copy)_259801447892439041]&#13;&#10;ELSEIF [Parameters].[Parameter 8]=&apos;mCVR3&apos; THEN [Calculation_1148699421819342851]&#13;&#10;ELSEIF [Parameters].[Parameter 8]=&apos;mCVR4&apos; THEN [Calculation_1148699421819482116]&#13;&#10;END' />
      </column>
      <column caption='Zero Search Result ' datatype='integer' name='[Calculation_571675695072628736]' role='measure' type='quantitative'>
