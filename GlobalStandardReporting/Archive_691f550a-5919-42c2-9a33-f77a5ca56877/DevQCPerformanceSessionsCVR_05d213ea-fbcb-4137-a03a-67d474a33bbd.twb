            <column caption='CVR Granularity' datatype='string' name='[Parameter 8]' param-domain-type='list' role='measure' type='nominal' value='&quot;CVR2&quot;'>
              <calculation class='tableau' formula='&quot;CVR2&quot;' />
            </column>
