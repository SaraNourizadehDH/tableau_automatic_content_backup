      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0lny8lp1vzskh914l74b5104eqrk].[ctd:platform_order_code:qk]&quot;' value='Order Count' />
          <alias key='&quot;[federated.0lny8lp1vzskh914l74b5104eqrk].[cum:sum:gmv_eur:qk]&quot;' value='Running Sum of Gmv Eur' />
          <alias key='&quot;[federated.0lny8lp1vzskh914l74b5104eqrk].[cum:usr:Calculation_3374603499258478602:qk]&quot;' value='Running Sum of % of Tot Vert Gmv' />
        </aliases>
      </column>
      <column caption='GP Diff Eur' datatype='real' name='[Calculation_3374603499215503360]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_809240566383202309] - SUM([gross_profit_eur])' />
      </column>
      <column caption='Gmv Eur_Vendor' datatype='real' name='[Calculation_3374603499233239041]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [entity_id], [vendor_id]: SUM([gmv_eur])}' />
      </column>
      <column caption='Tot Gmv Eur_Vert' datatype='real' name='[Calculation_3374603499258023945]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [region], [entity_id], [vertical_type]: SUM([gmv_eur])}' />
      </column>
      <column caption='% of Tot Vert Gmv' datatype='real' name='[Calculation_3374603499258478602]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gmv_eur])/SUM([Calculation_3374603499258023945])' />
      </column>
      <column caption='Gmv Per Order Eur' datatype='real' name='[Calculation_809240566376611840]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gmv_eur])/COUNTD([platform_order_code])' />
      </column>
      <column caption='Gpo Cf Eur' datatype='real' name='[Calculation_809240566377787393]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gross_profit_eur_cf])/COUNTD([platform_order_code])' />
