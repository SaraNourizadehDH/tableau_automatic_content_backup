          <relation connection='bigquery.0gzf8wv133ity017xslk91ukf4e9' name='Custom SQL Query' type='text'><![CDATA[WITH
dates AS (
SELECT
DATE("2019-07-01") from_date,
DATE_ADD(CURRENT_DATE,INTERVAL -1 DAY) AS thru_date),

dmart_entities AS (
SELECT
DISTINCT
global_entity_id

FROM `fulfillment-dwh-production.curated_data_shared_dmart.customer_orders`

WHERE is_dmart AND global_entity_id NOT IN ('BM_KR') AND country_name NOT IN ('Germany','Japan','Romania')),

dmart_customers AS (
SELECT
DISTINCT
global_entity_id,
"DH Group" AS dh_group,
CASE
WHEN s.region = "America" THEN "Americas"
ELSE s.region
END AS segment,
CASE
WHEN LOWER(management_entity) = "hungerstation" THEN "Hungerstation"
WHEN LOWER(management_entity) IN ("dh nordics","dh cee","dh austria") THEN "EU Pandora"
WHEN LOWER(management_entity) IN ("dh greece") THEN "EU eFood"
ELSE management_entity
END AS management_entity,
common_name,
DATE_TRUNC(DATE(order_placed_localtime_at),QUARTER) quarter,
analytical_customer_id

FROM `fulfillment-dwh-production.curated_data_shared_dmart.customer_orders` c

INNER JOIN `fulfillment-dwh-production.curated_data_shared_dmart.sources` s USING (global_entity_id)

INNER JOIN dmart_entities USING (global_entity_id)

WHERE is_dmart AND is_sent AND DATE(order_placed_localtime_at) BETWEEN (SELECT from_date FROM dates) AND (SELECT thru_date FROM dates)),

platform_customers AS (
SELECT
DISTINCT
o.global_entity_id,
"DH Group" AS dh_group,
CASE
WHEN s.region = "America" THEN "Americas"
ELSE s.region
END AS segment,
CASE
WHEN LOWER(management_entity) = "hungerstation" THEN "Hungerstation"
WHEN LOWER(management_entity) IN ("dh nordics","dh cee","dh austria") THEN "EU Pandora"
WHEN LOWER(management_entity) IN ("dh greece") THEN "EU eFood"
ELSE management_entity
END AS management_entity,
common_name,
DATE_TRUNC(DATE(placed_at_local),QUARTER) quarter,
analytical_customer_id

FROM `fulfillment-dwh-production.curated_data_shared_central_dwh.orders` o

INNER JOIN `fulfillment-dwh-production.curated_data_shared_dmart.sources` s USING (global_entity_id)

INNER JOIN dmart_entities USING (global_entity_id)

WHERE o.is_sent AND DATE(placed_at_local) BETWEEN (SELECT from_date FROM dates) AND (SELECT thru_date FROM dates))

SELECT
p.global_entity_id,
p.dh_group,
p.segment,
p.management_entity,
p.common_name,
p.quarter,
COUNT(DISTINCT CASE WHEN d.analytical_customer_id IS NULL THEN p.analytical_customer_id END) AS prospect_users

FROM platform_customers p

LEFT JOIN dmart_customers d ON
d.global_entity_id = p.global_entity_id AND d.analytical_customer_id = p.analytical_customer_id AND d.quarter <<= p.quarter

GROUP BY 1,2,3,4,5,6]]></relation>
          <relation connection='bigquery.0gzf8wv133ity017xslk91ukf4e9' name='Custom SQL Query1' type='text'>WITH&#13;
dates AS (&#13;
SELECT&#13;
DATE(&quot;2019-07-01&quot;) from_date,&#13;
DATE_ADD(CURRENT_DATE,INTERVAL -1 DAY) AS thru_date),&#13;
&#13;
dmart_entities AS (&#13;
SELECT&#13;
DISTINCT&#13;
global_entity_id&#13;
&#13;
FROM `fulfillment-dwh-production.curated_data_shared_dmart.customer_orders`&#13;
&#13;
WHERE is_dmart AND global_entity_id NOT IN (&apos;BM_KR&apos;) AND country_name NOT IN (&apos;Germany&apos;,&apos;Japan&apos;,&apos;Romania&apos;)),&#13;
&#13;
dmart_adopters AS (&#13;
WITH lifetime_orders AS (&#13;
WITH orders_by_customer AS (&#13;
&#13;
WITH&#13;
quarter_customers AS (&#13;
&#13;
WITH&#13;
dates_customer AS (&#13;
SELECT&#13;
DATE(&apos;2018-01-01&apos;) AS from_date),&#13;
&#13;
list_quarters AS (&#13;
SELECT DISTINCT&#13;
DATE_TRUNC(order_placed_localtime_at,QUARTER) AS quarter&#13;
&#13;
FROM `fulfillment-dwh-production.curated_data_shared_dmart.customer_orders`&#13;
&#13;
WHERE is_dmart AND is_sent AND DATE(order_placed_localtime_at) BETWEEN (SELECT from_date FROM dates_customer) AND CURRENT_DATE()),&#13;
&#13;
list_customers AS (&#13;
SELECT DISTINCT&#13;
DATE_TRUNC(order_placed_localtime_at,QUARTER) AS quarter,&#13;
analytical_customer_id&#13;
&#13;
FROM `fulfillment-dwh-production.curated_data_shared_dmart.customer_orders`&#13;
&#13;
WHERE is_dmart AND is_sent AND analytical_customer_id IS NOT NULL AND DATE(order_placed_localtime_at) BETWEEN (SELECT from_date FROM dates_customer) AND CURRENT_DATE())&#13;
&#13;
&#13;
SELECT&#13;
DISTINCT&#13;
q.quarter,&#13;
c.analytical_customer_id&#13;
&#13;
FROM list_quarters q&#13;
CROSS JOIN list_customers c&#13;
&#13;
GROUP BY 1,2&#13;
ORDER BY 2,1),&#13;
&#13;
customer_orders AS (&#13;
SELECT DISTINCT&#13;
DATE_TRUNC(order_placed_localtime_at,QUARTER) AS quarter,&#13;
analytical_customer_id,&#13;
COUNT(DISTINCT order_id) AS orders&#13;
&#13;
FROM `fulfillment-dwh-production.curated_data_shared_dmart.customer_orders`&#13;
&#13;
WHERE is_dmart AND is_sent AND analytical_customer_id IS NOT NULL&#13;
GROUP BY 1,2)&#13;
&#13;
SELECT&#13;
q.quarter,&#13;
q.analytical_customer_id,&#13;
COALESCE(SUM(orders),0) AS orders_per_customer&#13;
&#13;
FROM quarter_customers q&#13;
&#13;
LEFT JOIN customer_orders c ON q.quarter = c.quarter AND q.analytical_customer_id = c.analytical_customer_id&#13;
&#13;
GROUP BY 1,2)&#13;
&#13;
SELECT&#13;
quarter,&#13;
analytical_customer_id,&#13;
orders_per_customer,&#13;
SUM(orders_per_customer) OVER (PARTITION BY analytical_customer_id ORDER BY quarter) AS cumulative_orders_per_customer&#13;
&#13;
FROM orders_by_customer&#13;
&#13;
ORDER BY 2,1),&#13;
&#13;
active_customers AS (&#13;
SELECT&#13;
DISTINCT&#13;
global_entity_id,&#13;
DATE_TRUNC(DATE(order_placed_localtime_at),QUARTER) quarter,&#13;
analytical_customer_id&#13;
&#13;
FROM `fulfillment-dwh-production.curated_data_shared_dmart.customer_orders` c&#13;
&#13;
INNER JOIN `fulfillment-dwh-production.curated_data_shared_dmart.sources` s USING (global_entity_id)&#13;
&#13;
INNER JOIN dmart_entities USING (global_entity_id)&#13;
&#13;
WHERE is_dmart AND is_sent AND DATE(order_placed_localtime_at) BETWEEN (SELECT from_date FROM dates) AND (SELECT thru_date FROM dates))&#13;
&#13;
SELECT&#13;
global_entity_id,&#13;
ac.quarter,&#13;
COUNT(DISTINCT CASE WHEN cumulative_orders_per_customer &gt;&gt;= 3 THEN ac.analytical_customer_id END) AS active_adopters&#13;
&#13;
FROM active_customers ac&#13;
LEFT JOIN lifetime_orders lo USING (quarter,analytical_customer_id)&#13;
&#13;
GROUP BY 1,2),&#13;
&#13;
dmart_orders AS (&#13;
SELECT&#13;
global_entity_id,&#13;
DATE_TRUNC(DATE(order_placed_localtime_at),QUARTER) quarter,&#13;
COUNT(DISTINCT order_id) dmart_orders,&#13;
COUNT(DISTINCT analytical_customer_id) dmart_users,&#13;
COUNT(DISTINCT CASE WHEN is_acquisition_backend THEN analytical_customer_id END) dmart_acquisitions&#13;
&#13;
FROM `fulfillment-dwh-production.curated_data_shared_dmart.customer_orders` c&#13;
&#13;
INNER JOIN `fulfillment-dwh-production.curated_data_shared_dmart.sources` s USING (global_entity_id)&#13;
&#13;
INNER JOIN dmart_entities USING (global_entity_id)&#13;
&#13;
WHERE is_dmart AND is_sent AND DATE(order_placed_localtime_at) BETWEEN (SELECT from_date FROM dates) AND (SELECT thru_date FROM dates)&#13;
&#13;
GROUP BY 1,2),&#13;
&#13;
platform_orders AS (&#13;
SELECT&#13;
global_entity_id,&#13;
&quot;DH Group&quot; AS dh_group,&#13;
CASE&#13;
WHEN s.region = &quot;America&quot; THEN &quot;Americas&quot;&#13;
ELSE s.region&#13;
END AS segment,&#13;
CASE&#13;
WHEN LOWER(management_entity) = &quot;hungerstation&quot; THEN &quot;Hungerstation&quot;&#13;
WHEN LOWER(management_entity) IN (&quot;dh nordics&quot;,&quot;dh cee&quot;,&quot;dh austria&quot;) THEN &quot;EU Pandora&quot;&#13;
WHEN LOWER(management_entity) IN (&quot;dh greece&quot;) THEN &quot;EU eFood&quot;&#13;
ELSE management_entity&#13;
END AS management_entity,&#13;
common_name,&#13;
DATE_TRUNC(DATE(placed_at_local),QUARTER) quarter,&#13;
COUNT(DISTINCT order_id) platform_orders,&#13;
COUNT(DISTINCT analytical_customer_id) platform_users,&#13;
COUNT(DISTINCT CASE WHEN is_acquisition THEN analytical_customer_id END) platform_acquisitions&#13;
&#13;
FROM `fulfillment-dwh-production.curated_data_shared_central_dwh.orders` o&#13;
&#13;
INNER JOIN `fulfillment-dwh-production.curated_data_shared_dmart.sources` s USING (global_entity_id)&#13;
&#13;
INNER JOIN dmart_entities USING (global_entity_id)&#13;
&#13;
WHERE is_sent AND DATE(placed_at_local) BETWEEN (SELECT from_date FROM dates) AND (SELECT thru_date FROM dates)&#13;
&#13;
GROUP BY 1,2,3,4,5,6)&#13;
&#13;
SELECT&#13;
p.*,&#13;
d.dmart_orders,&#13;
d.dmart_users,&#13;
d.dmart_acquisitions,&#13;
a.active_adopters&#13;
&#13;
FROM platform_orders p&#13;
&#13;
LEFT JOIN dmart_orders d ON&#13;
p.global_entity_id = d.global_entity_id AND&#13;
p.quarter = d.quarter&#13;
&#13;
LEFT JOIN dmart_adopters a ON&#13;
p.global_entity_id = a.global_entity_id AND&#13;
p.quarter = a.quarter</relation>
          <relation connection='bigquery.0gzf8wv133ity017xslk91ukf4e9' name='Custom SQL Query2' type='text'>WITH&#13;
dates AS (&#13;
