      <datasource-dependencies datasource='Parameters'>
        <column caption='Structure' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Management Entity&quot;'>
          <calculation class='tableau' formula='&quot;Management Entity&quot;' />
