          <relation connection='bigquery.16d9ogc1tn8n2s1abp18q0kig7vq' name='Custom SQL Query2' type='text'>WITH&#13;
dates AS (&#13;
SELECT&#13;
DATE(&quot;2019-07-01&quot;) from_date,&#13;
DATE_ADD(CURRENT_DATE,INTERVAL -1 DAY) AS thru_date),&#13;
&#13;
qc_entities AS (&#13;
SELECT&#13;
DISTINCT&#13;
global_entity_id&#13;
&#13;
FROM `fulfillment-dwh-production.curated_data_shared_dmart.customer_orders`&#13;
&#13;
WHERE global_entity_id NOT LIKE &apos;BM_%%&apos; AND global_entity_id NOT LIKE &apos;IN_%%&apos; AND country_name NOT IN (&apos;Germany&apos;,&apos;Japan&apos;,&apos;Romania&apos;)),&#13;
&#13;
qc_customers AS (&#13;
SELECT&#13;
DISTINCT&#13;
global_entity_id,&#13;
&quot;DH Group&quot; AS dh_group,&#13;
CASE&#13;
WHEN s.region = &quot;America&quot; THEN &quot;Americas&quot;&#13;
ELSE s.region&#13;
END AS segment,&#13;
CASE&#13;
WHEN LOWER(management_entity) = &quot;hungerstation&quot; THEN &quot;Hungerstation&quot;&#13;
WHEN LOWER(management_entity) IN (&quot;dh nordics&quot;,&quot;dh cee&quot;,&quot;dh austria&quot;) THEN &quot;EU Pandora&quot;&#13;
WHEN LOWER(management_entity) IN (&quot;dh greece&quot;) THEN &quot;EU eFood&quot;&#13;
ELSE management_entity&#13;
END AS management_entity,&#13;
common_name,&#13;
DATE_TRUNC(DATE(order_placed_localtime_at),QUARTER) quarter,&#13;
analytical_customer_id&#13;
&#13;
FROM `fulfillment-dwh-production.curated_data_shared_dmart.customer_orders` c&#13;
&#13;
INNER JOIN `fulfillment-dwh-production.curated_data_shared_dmart.sources` s USING (global_entity_id)&#13;
&#13;
INNER JOIN qc_entities USING (global_entity_id)&#13;
&#13;
WHERE is_sent AND DATE(order_placed_localtime_at) BETWEEN (SELECT from_date FROM dates) AND (SELECT thru_date FROM dates)),&#13;
&#13;
non_qc_customers AS (&#13;
SELECT&#13;
DISTINCT&#13;
o.global_entity_id,&#13;
&quot;DH Group&quot; AS dh_group,&#13;
CASE&#13;
WHEN s.region = &quot;America&quot; THEN &quot;Americas&quot;&#13;
ELSE s.region&#13;
END AS segment,&#13;
CASE&#13;
WHEN LOWER(management_entity) = &quot;hungerstation&quot; THEN &quot;Hungerstation&quot;&#13;
WHEN LOWER(management_entity) IN (&quot;dh nordics&quot;,&quot;dh cee&quot;,&quot;dh austria&quot;) THEN &quot;EU Pandora&quot;&#13;
WHEN LOWER(management_entity) IN (&quot;dh greece&quot;) THEN &quot;EU eFood&quot;&#13;
ELSE management_entity&#13;
END AS management_entity,&#13;
common_name,&#13;
DATE_TRUNC(DATE(placed_at_local),QUARTER) quarter,&#13;
CASE&#13;
WHEN c.order_id IS NOT NULL THEN NULL&#13;
ELSE o.analytical_customer_id&#13;
END analytical_customer_id&#13;
&#13;
FROM `fulfillment-dwh-production.curated_data_shared_central_dwh.orders` o&#13;
&#13;
INNER JOIN `fulfillment-dwh-production.curated_data_shared_dmart.sources` s USING (global_entity_id)&#13;
&#13;
INNER JOIN qc_entities USING (global_entity_id)&#13;
&#13;
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_dmart.customer_orders` c ON&#13;
o.global_entity_id = c.global_entity_id AND&#13;
o.order_id = c.order_id&#13;
&#13;
WHERE o.is_sent AND DATE(placed_at_local) BETWEEN (SELECT from_date FROM dates) AND (SELECT thru_date FROM dates))&#13;
&#13;
SELECT&#13;
d.global_entity_id,&#13;
d.dh_group,&#13;
d.segment,&#13;
d.management_entity,&#13;
d.common_name,&#13;
d.quarter,&#13;
COUNT(DISTINCT CASE WHEN ndc.analytical_customer_id IS NULL THEN d.analytical_customer_id END) AS only_dmart_users&#13;
&#13;
FROM qc_customers d&#13;
&#13;
LEFT JOIN non_qc_customers ndc ON&#13;
d.global_entity_id = ndc.global_entity_id AND d.quarter = ndc.quarter AND d.analytical_customer_id = ndc.analytical_customer_id&#13;
&#13;
GROUP BY 1,2,3,4,5,6</relation>
          <relation connection='bigquery.16d9ogc1tn8n2s1abp18q0kig7vq' name='Custom SQL Query1' type='text'>WITH&#13;
dates AS (&#13;
SELECT&#13;
DATE(&quot;2019-07-01&quot;) from_date,&#13;
DATE_ADD(CURRENT_DATE,INTERVAL -1 DAY) AS thru_date),&#13;
&#13;
qc_entities AS (&#13;
SELECT&#13;
DISTINCT&#13;
global_entity_id&#13;
&#13;
FROM `fulfillment-dwh-production.curated_data_shared_dmart.customer_orders`&#13;
&#13;
WHERE global_entity_id NOT LIKE &apos;BM_%%&apos; AND global_entity_id NOT LIKE &apos;IN_%%&apos; AND country_name NOT IN (&apos;Germany&apos;,&apos;Japan&apos;,&apos;Romania&apos;)),&#13;
&#13;
qc_adopters AS (&#13;
WITH lifetime_orders AS (&#13;
WITH orders_by_customer AS (&#13;
&#13;
WITH&#13;
quarter_customers AS (&#13;
&#13;
WITH&#13;
dates_customer AS (&#13;
SELECT&#13;
DATE(&apos;2018-01-01&apos;) AS from_date),&#13;
&#13;
list_quarters AS (&#13;
SELECT DISTINCT&#13;
DATE_TRUNC(order_placed_localtime_at,QUARTER) AS quarter&#13;
&#13;
FROM `fulfillment-dwh-production.curated_data_shared_dmart.customer_orders`&#13;
&#13;
WHERE is_sent AND DATE(order_placed_localtime_at) BETWEEN (SELECT from_date FROM dates_customer) AND CURRENT_DATE()),&#13;
&#13;
list_customers AS (&#13;
SELECT DISTINCT&#13;
DATE_TRUNC(order_placed_localtime_at,QUARTER) AS quarter,&#13;
analytical_customer_id&#13;
&#13;
FROM `fulfillment-dwh-production.curated_data_shared_dmart.customer_orders`&#13;
&#13;
WHERE is_sent AND analytical_customer_id IS NOT NULL AND DATE(order_placed_localtime_at) BETWEEN (SELECT from_date FROM dates_customer) AND CURRENT_DATE())&#13;
&#13;
&#13;
SELECT&#13;
DISTINCT&#13;
q.quarter,&#13;
c.analytical_customer_id&#13;
&#13;
FROM list_quarters q&#13;
CROSS JOIN list_customers c&#13;
&#13;
GROUP BY 1,2&#13;
ORDER BY 2,1),&#13;
&#13;
customer_orders AS (&#13;
SELECT DISTINCT&#13;
DATE_TRUNC(order_placed_localtime_at,QUARTER) AS quarter,&#13;
analytical_customer_id,&#13;
COUNT(DISTINCT order_id) AS orders&#13;
&#13;
FROM `fulfillment-dwh-production.curated_data_shared_dmart.customer_orders`&#13;
&#13;
WHERE is_sent AND analytical_customer_id IS NOT NULL&#13;
GROUP BY 1,2)&#13;
&#13;
SELECT&#13;
q.quarter,&#13;
q.analytical_customer_id,&#13;
COALESCE(SUM(orders),0) AS orders_per_customer&#13;
&#13;
FROM quarter_customers q&#13;
&#13;
LEFT JOIN customer_orders c ON q.quarter = c.quarter AND q.analytical_customer_id = c.analytical_customer_id&#13;
&#13;
GROUP BY 1,2)&#13;
&#13;
SELECT&#13;
quarter,&#13;
analytical_customer_id,&#13;
orders_per_customer,&#13;
SUM(orders_per_customer) OVER (PARTITION BY analytical_customer_id ORDER BY quarter) AS cumulative_orders_per_customer&#13;
&#13;
FROM orders_by_customer&#13;
&#13;
ORDER BY 2,1),&#13;
&#13;
active_customers AS (&#13;
SELECT&#13;
DISTINCT&#13;
global_entity_id,&#13;
DATE_TRUNC(DATE(order_placed_localtime_at),QUARTER) quarter,&#13;
analytical_customer_id&#13;
&#13;
FROM `fulfillment-dwh-production.curated_data_shared_dmart.customer_orders` c&#13;
&#13;
INNER JOIN `fulfillment-dwh-production.curated_data_shared_dmart.sources` s USING (global_entity_id)&#13;
&#13;
INNER JOIN qc_entities USING (global_entity_id)&#13;
&#13;
WHERE is_sent AND DATE(order_placed_localtime_at) BETWEEN (SELECT from_date FROM dates) AND (SELECT thru_date FROM dates))&#13;
&#13;
SELECT&#13;
global_entity_id,&#13;
ac.quarter,&#13;
COUNT(DISTINCT CASE WHEN cumulative_orders_per_customer &gt;&gt;= 3 THEN ac.analytical_customer_id END) AS active_adopters&#13;
&#13;
FROM active_customers ac&#13;
LEFT JOIN lifetime_orders lo USING (quarter,analytical_customer_id)&#13;
&#13;
GROUP BY 1,2),&#13;
&#13;
qc_orders AS (&#13;
SELECT&#13;
global_entity_id,&#13;
DATE_TRUNC(DATE(order_placed_localtime_at),QUARTER) quarter,&#13;
COUNT(DISTINCT order_id) qc_orders,&#13;
COUNT(DISTINCT analytical_customer_id) qc_users,&#13;
COUNT(DISTINCT CASE WHEN is_acquisition_backend THEN analytical_customer_id END) qc_acquisitions&#13;
&#13;
FROM `fulfillment-dwh-production.curated_data_shared_dmart.customer_orders` c&#13;
&#13;
INNER JOIN `fulfillment-dwh-production.curated_data_shared_dmart.sources` s USING (global_entity_id)&#13;
&#13;
INNER JOIN qc_entities USING (global_entity_id)&#13;
&#13;
WHERE is_sent AND DATE(order_placed_localtime_at) BETWEEN (SELECT from_date FROM dates) AND (SELECT thru_date FROM dates)&#13;
&#13;
GROUP BY 1,2),&#13;
&#13;
platform_orders AS (&#13;
SELECT&#13;
global_entity_id,&#13;
&quot;DH Group&quot; AS dh_group,&#13;
CASE&#13;
WHEN s.region = &quot;America&quot; THEN &quot;Americas&quot;&#13;
ELSE s.region&#13;
END AS segment,&#13;
CASE&#13;
WHEN LOWER(management_entity) = &quot;hungerstation&quot; THEN &quot;Hungerstation&quot;&#13;
WHEN LOWER(management_entity) IN (&quot;dh nordics&quot;,&quot;dh cee&quot;,&quot;dh austria&quot;) THEN &quot;EU Pandora&quot;&#13;
WHEN LOWER(management_entity) IN (&quot;dh greece&quot;) THEN &quot;EU eFood&quot;&#13;
ELSE management_entity&#13;
END AS management_entity,&#13;
common_name,&#13;
DATE_TRUNC(DATE(placed_at_local),QUARTER) quarter,&#13;
COUNT(DISTINCT order_id) platform_orders,&#13;
COUNT(DISTINCT analytical_customer_id) platform_users,&#13;
COUNT(DISTINCT CASE WHEN is_acquisition THEN analytical_customer_id END) platform_acquisitions&#13;
&#13;
FROM `fulfillment-dwh-production.curated_data_shared_central_dwh.orders` o&#13;
&#13;
INNER JOIN `fulfillment-dwh-production.curated_data_shared_dmart.sources` s USING (global_entity_id)&#13;
&#13;
INNER JOIN qc_entities USING (global_entity_id)&#13;
&#13;
WHERE is_sent AND DATE(placed_at_local) BETWEEN (SELECT from_date FROM dates) AND (SELECT thru_date FROM dates)&#13;
&#13;
GROUP BY 1,2,3,4,5,6)&#13;
&#13;
SELECT&#13;
p.*,&#13;
d.qc_orders,&#13;
d.qc_users,&#13;
d.qc_acquisitions,&#13;
a.active_adopters&#13;
&#13;
FROM platform_orders p&#13;
&#13;
LEFT JOIN qc_orders d ON&#13;
p.global_entity_id = d.global_entity_id AND&#13;
p.quarter = d.quarter&#13;
&#13;
LEFT JOIN qc_adopters a ON&#13;
p.global_entity_id = a.global_entity_id AND&#13;
p.quarter = a.quarter</relation>
        </_.fcp.ObjectModelEncapsulateLegacy.true...relation>
