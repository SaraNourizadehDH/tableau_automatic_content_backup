            <column caption='Trial Successful Month' datatype='date' name='[trial_successful_month]' role='dimension' type='ordinal' />
            <column-instance column='[M1 Retention Rate_Qty (copy)_597852905191055380]' derivation='User' name='[usr:M1 Retention Rate_Qty (copy)_597852905191055380:qk]' pivot='key' type='quantitative' />
