      <aliases enabled='yes' />
      <column caption='Retention Rate' datatype='real' name='[Calculation_1335317356914110469]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 5]=&apos;1&apos; and [Parameters].[Parameter 6]=&apos;1&apos; THEN SUM([return_user_30])/SUM([trial_base])&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;2&apos; and [Parameters].[Parameter 6]=&apos;1&apos; THEN SUM([return_user_90])/SUM([trial_base])&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;3&apos; and [Parameters].[Parameter 6]=&apos;1&apos; THEN SUM([return_user_120])/SUM([trial_base])&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;1&apos; and [Parameters].[Parameter 6]=&apos;2&apos; THEN SUM([return_user_30_organic])/SUM([trial_base])&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;2&apos; and [Parameters].[Parameter 6]=&apos;2&apos; THEN SUM([return_user_90_organic])/SUM([trial_base])&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;3&apos; and [Parameters].[Parameter 6]=&apos;2&apos; THEN SUM([return_user_120_organic])/SUM([trial_base])&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;1&apos; and [Parameters].[Parameter 6]=&apos;3&apos; THEN SUM([return_user_30_voucher])/SUM([trial_base])&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;2&apos; and [Parameters].[Parameter 6]=&apos;3&apos; THEN SUM([return_user_90_voucher])/SUM([trial_base])&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;3&apos; and [Parameters].[Parameter 6]=&apos;3&apos; THEN SUM([return_user_120_voucher])/SUM([trial_base])&#13;&#10;END' />
      </column>
      <column caption='Retention Rate_Organic' datatype='real' name='[Retention Rate (copy)_1335317358001168392]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 5]=&apos;1&apos; THEN SUM([return_user_30_organic])/SUM([trial_base])&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;2&apos; THEN SUM([return_user_90_organic])/SUM([trial_base])&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;3&apos; THEN SUM([return_user_120_organic])/SUM([trial_base])&#13;&#10;END' />
