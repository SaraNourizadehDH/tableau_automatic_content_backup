            <column caption='Buckets' datatype='integer' name='[Calculation_143552290415976457]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;ABV&quot; THEN [trial_order_gbv_eur]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Quantity Ordered&quot; THEN [trial_order_qty]&#13;&#10;END' />
            </column>
            <column caption='Dimension' datatype='string' name='[Calculation_143552290416033802]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Dimension (copy)_143552290420776973] = &quot;Split Trial Order&quot; THEN &#13;&#10;    IF [trial_order_is_split_order] THEN &quot;Is Split Trial Order&quot; ELSE &quot;Is not Split Trial Order&quot; END&#13;&#10;ELSEIF [Parameters].[Dimension (copy)_143552290420776973] = &quot;Stacked Trial Order&quot; THEN&#13;&#10;    IF [trial_order_is_stacked_order] THEN &quot;Is Stacked Trial Order&quot; ELSE &quot;Is not Stacked Trial Order&quot; END&#13;&#10;END' />
            </column>
            <column caption='Retention Rate 30d' datatype='real' default-format='p0%' name='[Calculation_143552290416656395]' role='measure' type='quantitative'>
