    <worksheet name='Q1 Retention-SO'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#aa0000' fontsize='16'>How do </run>
            <run bold='true' fontcolor='#aa0000' fontname='Tableau Bold' fontsize='16'>&lt;[Parameters].[Parameter 3]&gt;</run>
            <run bold='true' fontcolor='#aa0000' fontsize='16'> impact </run>
            <run bold='true' fontcolor='#aa0000' fontname='Tableau Bold' fontsize='16'>&lt;[Parameters].[Parameter 2]&gt; </run>
            <run bold='true' fontcolor='#aa0000' fontsize='16'>retention?</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontsize='13'><![CDATA[<[Parameters].[Parameter 2]> Retention Rate]]></run>
            <run fontsize='13'> split between customers</run>
            <run bold='true' fontsize='13'><![CDATA[ who received and didn't receive <[Parameters].[Parameter 3]>]]></run>
            <run fontsize='13'><![CDATA[ before <[Parameters].[Parameter 2]>.]]></run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='13'><![CDATA[Bucketed by Average <[Parameters].[Parameter 1]>]]></run>
            <run fontsize='13'><![CDATA[  of orders placed before <[Parameters].[Parameter 2]>.]]></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='pede_customer_retention_operation_kpis_fede_q12' name='federated.0i0ovze0kq8ms41efx7bb0e7upp9' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Bucket by' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Quantity Ordered&quot;'>
              <calculation class='tableau' formula='&quot;Quantity Ordered&quot;' />
            </column>
            <column caption='Retention Rate' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;M1&quot;'>
              <calculation class='tableau' formula='&quot;M1&quot;' />
            </column>
            <column caption='Dimension' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Stacked Orders&quot;'>
              <calculation class='tableau' formula='&quot;Stacked Orders&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0i0ovze0kq8ms41efx7bb0e7upp9'>
            <column caption='M1 Retention Rate' datatype='real' default-format='p0.00%' name='[Calculation_1197113128148434944]' role='measure' type='quantitative'>
