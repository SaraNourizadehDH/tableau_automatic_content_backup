    <worksheet name='M1 Retention-Partial Order Trend'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#aa0000'>M1 Retention Trend </run>
            <run>Æ&#10;</run>
            <run fontcolor='#aa0000' fontsize='14'><![CDATA[Bucketed By <[Parameters].[Parameter 4]>  in Month 0]]></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Partial Orders(Q1,2)' name='federated.1r3lr4d06x100a0znd2m5108t2pn' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Order Count' caption='Retention Bucket' datatype='integer' name='[Parameter 4]' param-domain-type='list' role='measure' type='quantitative' value='2'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='1' value='Avg Order Quantity' />
                <alias key='2' value='Order Count' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1r3lr4d06x100a0znd2m5108t2pn'>
            <column caption='Bucket' datatype='string' name='[Calculation_1649724893510455300]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4]=1 THEN [m0_avg_qty] ELSE [m0_orders] END' />
            </column>
            <column caption='M0 Category' datatype='string' name='[Calculation_1649724893537890310]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [m0_has_partial_orders]=TRUE and [m0_count_with_replacement_orders]=TRUE&#13;&#10;THEN &apos;Partial w/Item Replacement&apos;&#13;&#10;ELSEIF [m0_has_partial_orders]=TRUE and &#13;&#10;([m0_count_with_replacement_orders]=FALSE OR [m0_count_with_replacement_orders]=NULL)&#13;&#10;THEN &apos;Partial w/o Item Replacement&apos;&#13;&#10;ELSEIF [m0_has_partial_orders]=FALSE and [m0_count_with_replacement_orders]=TRUE&#13;&#10;THEN &apos;Non-Partial w/Item Replacement&apos;&#13;&#10;ELSEIF [m0_has_partial_orders]=FALSE and &#13;&#10;([m0_count_with_replacement_orders]=FALSE OR [m0_count_with_replacement_orders]=NULL)&#13;&#10;THEN &apos;Non-Partial w/o Item Replacement&apos;&#13;&#10;END' />
            </column>
            <column caption='M1 Retention Rate' datatype='real' name='[M1 Retention Rate_Qty (copy)_597852905191055380]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([m1_retained])/SUM([m0_base])' />
            </column>
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='M0 Avg Qty' datatype='string' name='[m0_avg_qty]' role='dimension' type='nominal' />
            <column caption='M0 Base' datatype='integer' name='[m0_base]' role='measure' type='quantitative' />
            <column caption='M0 Partial Orders with Replacement' datatype='boolean' name='[m0_count_with_replacement_orders]' role='dimension' type='nominal'>
              <aliases>
                <alias key='false' value='Without Replacement' />
                <alias key='true' value='With Replacement' />
              </aliases>
            </column>
            <column caption='M0 Has Partial Orders' datatype='boolean' name='[m0_has_partial_orders]' role='dimension' type='nominal'>
              <aliases>
                <alias key='false' value='No Partial Order' />
                <alias key='true' value='Partial Order' />
              </aliases>
            </column>
            <column caption='#Orders M0' datatype='string' name='[m0_orders]' role='dimension' type='nominal' />
            <column caption='M1 Retained' datatype='integer' name='[m1_retained]' role='measure' type='quantitative' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1649724893510455300]' derivation='None' name='[none:Calculation_1649724893510455300:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1649724893537890310]' derivation='None' name='[none:Calculation_1649724893537890310:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
