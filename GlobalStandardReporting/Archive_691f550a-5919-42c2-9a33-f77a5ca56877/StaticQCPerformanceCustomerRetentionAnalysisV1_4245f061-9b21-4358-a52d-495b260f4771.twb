            <column caption='Dimension' datatype='string' name='[Calculation_1197113128200908809]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &quot;Split Orders&quot; AND [Parameters].[Parameter 2] = &quot;M1&quot; THEN&#13;&#10;    IF [m0_has_split_orders] = TRUE THEN &quot;Has Split before &quot;+[Parameters].[Parameter 2] ELSE &quot;Has No Split before &quot;+[Parameters].[Parameter 2] END&#13;&#10;ELSEIF [Parameters].[Parameter 3] = &quot;Split Orders&quot; AND [Parameters].[Parameter 2] = &quot;M3&quot; THEN&#13;&#10;    IF [m012_has_split_orders] = TRUE THEN &quot;Has Split before &quot;+[Parameters].[Parameter 2] ELSE &quot;Has No Split before &quot;+[Parameters].[Parameter 2] END&#13;&#10;ELSEIF [Parameters].[Parameter 3] = &quot;Stacked Orders&quot; AND [Parameters].[Parameter 2] = &quot;M1&quot; THEN&#13;&#10;    IF [m0_has_stacked_orders] = TRUE THEN &quot;Has Stacked before &quot;+[Parameters].[Parameter 2] ELSE &quot;Has No Stacked before &quot;+[Parameters].[Parameter 2] END&#13;&#10;ELSEIF [Parameters].[Parameter 3] = &quot;Stacked Orders&quot; AND [Parameters].[Parameter 2] = &quot;M3&quot; THEN &#13;&#10;    IF [m012_has_stacked_orders] = TRUE THEN &quot;Has Stacked before &quot;+[Parameters].[Parameter 2] ELSE &quot;Has No Stacked before &quot;+[Parameters].[Parameter 2] END&#13;&#10;END' />
            </column>
            <column caption='Buckets' datatype='integer' name='[Calculation_1197113128201695243]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;ABV&quot; AND [Parameters].[Parameter 2] = &quot;M1&quot; THEN [m0_avg_gbv]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;ABV&quot; AND [Parameters].[Parameter 2] = &quot;M3&quot; THEN [m012_avg_gbv]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Quantity Ordered&quot; AND [Parameters].[Parameter 2] = &quot;M1&quot; THEN [m0_avg_qty]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Quantity Ordered&quot; AND [Parameters].[Parameter 2] = &quot;M3&quot; THEN [m012_avg_qty]&#13;&#10;END' />
            </column>
            <column caption='(SUM([Trial Base]) / TOTAL(SUM([Trial Base])))*1' datatype='real' name='[Calculation_1197113128220016655]' role='measure' type='quantitative' user:unnamed='Q1,2 Trial Base (3)'>
              <calculation class='tableau' formula='(SUM([m0_base]) / TOTAL(SUM([m0_base])))*1'>
