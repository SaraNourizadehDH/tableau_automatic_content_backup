    <worksheet name='M3 Retention-Partial Order Trend'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#aa0000'>M3 Retention Trend</run>
            <run>Æ&#10;</run>
            <run fontcolor='#aa0000' fontsize='14'><![CDATA[Bucketed By <[Parameters].[Parameter 4]> In Months 0,1&2]]></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Partial Orders(Q1,2)' name='federated.1r3lr4d06x100a0znd2m5108t2pn' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Order Count' caption='Retention Bucket' datatype='integer' name='[Parameter 4]' param-domain-type='list' role='measure' type='quantitative' value='2'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='1' value='Avg Order Quantity' />
                <alias key='2' value='Order Count' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1r3lr4d06x100a0znd2m5108t2pn'>
            <column caption='Bucket _012' datatype='string' name='[Bucket (copy)_1649724893541556232]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4]=1 THEN [m012_avg_qty] ELSE [m012_orders] END' />
            </column>
            <column caption='M0,1,2 Category' datatype='string' name='[M0 Category (copy)_1649724893539467271]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [m012_has_partial_orders]=TRUE and [m012_count_with_replacement_orders]=TRUE&#13;&#10;THEN &apos;Partial w/Item Replacement&apos;&#13;&#10;ELSEIF [m012_has_partial_orders]=TRUE and &#13;&#10;([m012_count_with_replacement_orders]=FALSE OR [m012_count_with_replacement_orders]=NULL)&#13;&#10;THEN &apos;Partial w/o Item Replacement&apos;&#13;&#10;ELSEIF [m012_has_partial_orders]=FALSE and [m012_count_with_replacement_orders]=TRUE&#13;&#10;THEN &apos;Non-Partial w/Item Replacement&apos;&#13;&#10;ELSEIF [m012_has_partial_orders]=FALSE and &#13;&#10;([m012_count_with_replacement_orders]=FALSE OR [m012_count_with_replacement_orders]=NULL)&#13;&#10;THEN &apos;Non-Partial w/o Item Replacement&apos;&#13;&#10;END' />
            </column>
            <column caption='M3 Retention Rate' datatype='real' name='[M1 Retention Rate (copy)_597852905310548001]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([m3_retained])/SUM([m0_base])' />
            </column>
