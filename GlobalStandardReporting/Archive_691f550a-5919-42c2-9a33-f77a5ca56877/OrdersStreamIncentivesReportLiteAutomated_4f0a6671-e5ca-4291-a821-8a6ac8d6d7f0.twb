    <worksheet name='Main Report'>
      <table>
        <view>
          <datasources>
            <datasource caption='monthly_incentive_report' name='federated.1y7j3uv0wxi9dn19dvemy12jyebx' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Breakdown Segments' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Regional&quot;'>
              <calculation class='tableau' formula='&quot;Regional&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1y7j3uv0wxi9dn19dvemy12jyebx'>
            <column caption='% Avg Discount Depth [Vendor - Joker]' datatype='real' name='[% Avg Discount Depth [Vendor + Joker]] (copy)_6976357350286774276]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([inct_amt_vfd_wo_jk_eur])/SUM([inct_vf_gbv_eur])' />
            </column>
            <column caption='% Avg Discount Depth [Total Inct]' datatype='real' name='[% Avg Discount Depth [Vendor]] (copy)_6498272072114745346]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([inct_amt_total_eur])/SUM([inct_gbv_eur])' />
            </column>
            <column caption='% Incentivised Orders [VFD Inc. Joker]' datatype='real' name='[% Incentivised Orders (copy)_2591610492759400452]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([inct_vf_only_orders])) / SUM([total_orders])' />
            </column>
            <column caption='% Incentivised Orders [VFD Ex. Joker]' datatype='real' name='[% Incentivised Orders [Vendor Inc. Joker]] (copy)_6976357350294478855]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([inct_vf_only_wo_jk_orders])) / SUM([total_orders])' />
            </column>
            <column caption='% Incentivised Orders [DH]' datatype='real' name='[% Incentivised Orders [Vendor]] (copy)_2591610492759683077]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([inct_dh_orders]) / SUM([total_orders])' />
            </column>
            <column caption='% VFD / GMV (Inc. Joker)' datatype='real' name='[% VFD / GMV (copy)_6976357350285455363]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([inct_amt_vfd_w_jk_eur]) / SUM([total_gmv_eur])' />
            </column>
            <column caption='% VFD Vendors [Ex. Joker]' datatype='real' name='[% Vendors w Vendor Incentives (copy)_6976357350534471690]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vfd_vendors_wo_jk])/SUM([total_online_vendors])' />
            </column>
            <column caption='Breakdown Segments' datatype='string' name='[Calculation_2591610492746412032]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Global&apos; THEN [Calculation_2591610492748181505]&#10;WHEN &apos;Regional&apos; THEN [management_entity]&#10;WHEN &apos;Brand&apos; THEN [brand_name]&#10;WHEN &apos;Country&apos; THEN [sub_entity]&#10;WHEN &apos;City&apos; THEN [Calculation_2591610492748382210]&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='Global Entity' datatype='string' name='[Calculation_2591610492748181505]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;Global&apos;' />
            </column>
            <column caption='City Level' datatype='string' name='[Calculation_2591610492748382210]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[country_name] + &apos; - &apos; + [city]' />
            </column>
            <column caption='% Incentivised Orders [Total]' datatype='real' name='[Calculation_2591610492758925315]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([inct_all_orders]) / SUM([total_orders])' />
            </column>
            <column caption='% VFD Vendors [Inc. Joker]' datatype='real' name='[Calculation_2591610492762750984]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vfd_vendors])/SUM([total_online_vendors])' />
            </column>
            <column caption='% VFD / GMV (Ex. Joker)' datatype='real' name='[Calculation_2591610492766208010]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([inct_amt_vfd_wo_jk_eur]) / SUM([total_gmv_eur])' />
            </column>
            <column caption='% DHF / GMV' datatype='real' name='[Calculation_2591610492767395852]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([inct_amt_dhf_eur])/SUM([total_gmv_eur])' />
            </column>
            <column caption='Is Key Account?' datatype='string' name='[Calculation_2591610492778995725]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_key_account] THEN &apos;True&apos; ELSE &apos;False&apos; END' />
