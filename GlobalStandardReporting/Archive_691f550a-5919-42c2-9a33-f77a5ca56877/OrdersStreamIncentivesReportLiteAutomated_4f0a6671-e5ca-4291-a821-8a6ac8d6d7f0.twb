  , SUM(gfv_vfd_w_jk_eur) inct_vf_gbv_eur
  , SUM(gfv_vfd_wo_jk_eur) inct_vf_wo_gbv_eur

FROM `fulfillment-dwh-production.cl_vendor.vfd_vendors_daily_incentive_orders` main
  LEFT JOIN vendors v
