        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.13kuz7e187rn5815n2fez1mvrsi8' name='Custom SQL Query' type='text'>SELECT
  COALESCE(py_order_date, DATE(cit_order_placed_at)) order_date
