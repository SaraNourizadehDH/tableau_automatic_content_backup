      </column>
      <column caption='Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_334110855404244995]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([federated.0zs5t390z61j6a1aonsgc0b1rod1].[orders_failed])/SUM([federated.0zs5t390z61j6a1aonsgc0b1rod1].[orders_total])' />
