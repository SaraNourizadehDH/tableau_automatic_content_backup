      <column caption='Active Warehouses (copy)' datatype='integer' name='[Active Warehouses (copy)_299489432914157577]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [orders_confirmed] &gt; 0 THEN [store_id] END)' />
      </column>
      <column caption='Avg SKUs Listed' datatype='real' name='[Avg SKUs Available (copy)_1053560894826471425]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([avg_skus_listed_monthly])' />
      </column>
      <column caption='Avg SKUs Available' datatype='real' name='[Calculation_1053560894826377216]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([avg_skus_inventory_active_monthly])' />
      </column>
      <column caption='Active Warehouses' datatype='integer' name='[Calculation_1053560894827134979]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [orders_confirmed] &gt; 0 THEN [store_id] END)' />
      </column>
      <column caption='Daily Orders per Store' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1053560894827261956]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(AVG([orders_confirmed_daily]))' />
      </column>
      <column aggregation='Sum' caption='Store Age (Current Month)' datatype='integer' name='[Calculation_1053560894829027334]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;Store&quot;&#13;&#10;    THEN&#13;&#10;        DATEDIFF(&apos;month&apos;,[store_first_order_date],NOW())&#13;&#10;    ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='Structure' datatype='string' name='[Calculation_1053560894829350919]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;DH Group&quot; THEN &quot;DH Group&quot;&#13;&#10;    WHEN &quot;Region&quot; THEN [region]&#13;&#10;    WHEN &quot;Management Entity&quot; THEN [management_entity]&#13;&#10;    WHEN &quot;Country&quot; THEN [country_name]&#13;&#10;    WHEN &quot;Store&quot; THEN [store_name]&#13;&#10;END' />
      </column>
      <column caption='Structure ' datatype='string' name='[Calculation_1053560894846377996]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;    WHEN TRUE THEN [Calculation_1053560894829350919]&#13;&#10;    ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='Frequency' datatype='real' name='[Calculation_1053560894860681232]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_confirmed])/SUM([customers_dmart])' />
      </column>
      <column caption='DMart MAUs' datatype='real' default-format='n#,##0,.0K;-#,##0,.0K' name='[Calculation_1053560894860963857]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([customers_dmart])' />
      </column>
      <column caption='+/- X D/O/S' datatype='string' name='[Calculation_1053560894863626259]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1053560894827261956] &lt;= [Parameters].[Parameter 5] THEN &quot;-&quot;+STR([Parameters].[Parameter 5])+&quot; D/O/S&quot;&#13;&#10;&#13;&#10;ELSEIF [Calculation_1053560894827261956] &gt; [Parameters].[Parameter 5] THEN &quot;+&quot;+STR([Parameters].[Parameter 5])+&quot; D/O/S&quot;&#13;&#10;&#13;&#10;ELSE NULL&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='days' datatype='real' name='[Calculation_299489432912703496]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG({FIXED [date_trunc_month] : AVG([days_online])})' />
      </column>
      <column caption='Penetration' datatype='real' default-format='p0.0%' name='[Calculation_299489432918249482]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([customers_dmart])/SUM([customers_covered])' />
      </column>
      <column caption='Share of Incentivized Orders' datatype='real' default-format='p0.0%' name='[Calculation_299489432926388235]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#13;&#10;    WHEN &quot;Vouchers&quot; THEN SUM([orders_w_vouchers])/SUM([orders_confirmed])&#13;&#10;    WHEN &quot;Free Delivery Fee&quot; THEN SUM([orders_w_fdf])/SUM([orders_confirmed])&#13;&#10;    WHEN &quot;Discounts&quot; THEN SUM([orders_w_discounts])/SUM([orders_confirmed])&#13;&#10;    WHEN &quot;Any&quot; THEN SUM([orders_incentivized])/SUM([orders_confirmed])&#13;&#10;END' />
      </column>
      <column caption='CVR3' datatype='real' default-format='p0.0%' name='[Calculation_299489432950800396]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([conversions])/SUM([sessions])' />
      </column>
      <column caption='Sessions/Covered MAUs' datatype='real' name='[Calculation_334110855368974336]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sessions])/SUM([customers_covered])' />
      </column>
      <column caption='Coverage' datatype='real' name='[Calculation_334110855393845250]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([customers_covered])' />
      </column>
      <column caption='Retention Rate 30d' datatype='real' default-format='p0.0%' name='[Calculation_695524724791033858]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_customers_reorder_30d])/SUM([total_customers_prev_month])' />
      </column>
      <column caption='Avg. Delivery Time' datatype='real' default-format='n#,##0.0&quot;&apos;&quot;;-#,##0.0&quot;&apos;&quot;' name='[Calculation_744219906047602688]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([delivery_time])/SUM([orders_w_delivery_time])' />
      </column>
      <column caption='Avg. Dropoff Distance' datatype='real' default-format='n#,##0,.00K;-#,##0,.00K' name='[Calculation_744219906047717377]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dropoff_distance])/SUM([orders_w_dropoff_distance])' />
      </column>
      <column caption='Color' datatype='string' name='[Color (copy)_299489432904306695]' role='measure' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Structure (copy)_1053560894862991378]&#13;&#10;    WHEN &quot;DH Group&quot; THEN ATTR(&quot;DH Group&quot;)&#13;&#10;    WHEN &quot;Region&quot; THEN ATTR([region])&#13;&#10;    WHEN &quot;Management Entity&quot; THEN ATTR([management_entity])&#13;&#10;    WHEN &quot;Country&quot; THEN ATTR([country_name])&#13;&#10;    WHEN &quot;Store&quot; THEN ATTR([store_name])&#13;&#10;    WHEN &quot;+/- 300 D/O/S&quot; THEN [Calculation_1053560894863626259]&#13;&#10;END' />
      </column>
      <column caption='Trials' datatype='real' default-format='n#,##0,.0K;-#,##0,.0K' name='[DMart MAUs (copy)_1053560894873432086]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([customers_trials])' />
      </column>
      <column aggregation='Sum' caption='Daily Orders per Store (copy)' datatype='real' default-format='n#,##0;-#,##0' name='[Daily Orders per Store (copy)_334110855477485593]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [store_name] : ROUND(AVG([orders_confirmed_daily]))}' />
      </column>
