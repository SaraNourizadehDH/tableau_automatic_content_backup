      <datasource-dependencies datasource='federated.0zs5t390z61j6a1aonsgc0b1rod1'>
        <column caption='Daily Orders per Store' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1053560894827261956]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='ROUND(AVG([orders_confirmed_daily]))' />
        </column>
        <column caption='DMart MAUs' datatype='real' default-format='n#,##0,.0K;-#,##0,.0K' name='[Calculation_1053560894860963857]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='AVG([customers_dmart])' />
        </column>
        <column caption='Penetration' datatype='real' default-format='p0.0%' name='[Calculation_299489432918249482]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='SUM([customers_dmart])/SUM([customers_covered])' />
        </column>
        <column caption='Coverage' datatype='real' name='[Calculation_334110855393845250]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='AVG([customers_covered])' />
        </column>
        <column caption='Trials' datatype='real' default-format='n#,##0,.0K;-#,##0,.0K' name='[DMart MAUs (copy)_1053560894873432086]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='AVG([customers_trials])' />
        </column>
