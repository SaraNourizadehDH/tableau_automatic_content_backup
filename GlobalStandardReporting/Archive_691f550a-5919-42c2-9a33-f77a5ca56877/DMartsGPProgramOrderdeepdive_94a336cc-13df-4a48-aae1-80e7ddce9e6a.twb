    <worksheet name='Sheet 8'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#d71d24' fontname='Tableau Bold' fontsize='16'>Heatmap &amp; Tracker</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='10'>Color coding based on Global Median for +300 D/O/S stores</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Query v1' name='federated.0zs5t390z61j6a1aonsgc0b1rod1' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Structure' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Store&quot;'>
              <calculation class='tableau' formula='&quot;Store&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0zs5t390z61j6a1aonsgc0b1rod1'>
            <column caption='Daily Orders per Store' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1053560894827261956]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(AVG([orders_confirmed_daily]))' />
            </column>
            <column caption='Frequency' datatype='real' name='[Calculation_1053560894860681232]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_confirmed])/SUM([customers_dmart])' />
            </column>
            <column caption='DMart MAUs' datatype='real' default-format='n#,##0,.0K;-#,##0,.0K' name='[Calculation_1053560894860963857]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([customers_dmart])' />
            </column>
            <column caption='Penetration' datatype='real' default-format='p0.0%' name='[Calculation_299489432918249482]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([customers_dmart])/SUM([customers_covered])' />
            </column>
            <column caption='CVR3' datatype='real' default-format='p0.0%' name='[Calculation_299489432950800396]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([conversions])/SUM([sessions])' />
            </column>
            <column caption='Sessions/Covered MAUs' datatype='real' name='[Calculation_334110855368974336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sessions])/SUM([customers_covered])' />
            </column>
            <column caption='Coverage' datatype='real' name='[Calculation_334110855393845250]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([customers_covered])' />
            </column>
            <column caption='Retention Rate 30d' datatype='real' default-format='p0.0%' name='[Calculation_695524724791033858]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_customers_reorder_30d])/SUM([total_customers_prev_month])' />
            </column>
            <column caption='Avg. Delivery Time' datatype='real' default-format='n#,##0.0&quot;&apos;&quot;;-#,##0.0&quot;&apos;&quot;' name='[Calculation_744219906047602688]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_time])/SUM([orders_w_delivery_time])' />
            </column>
            <column caption='Avg. Dropoff Distance' datatype='real' default-format='n#,##0,.00K;-#,##0,.00K' name='[Calculation_744219906047717377]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dropoff_distance])/SUM([orders_w_dropoff_distance])' />
            </column>
            <column caption='Trials' datatype='real' default-format='n#,##0,.0K;-#,##0,.0K' name='[DMart MAUs (copy)_1053560894873432086]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([customers_trials])' />
            </column>
            <column aggregation='Sum' caption='Store Age' datatype='integer' name='[Store Age (Current Month) (copy)_821906999987240960]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;Store&quot;&#13;&#10;    THEN&#13;&#10;        DATEDIFF(&apos;month&apos;,[store_first_order_date],NOW())&#13;&#10;    ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='City' datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column datatype='real' name='[conversions]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='integer' name='[customers_covered]' role='measure' type='quantitative' />
            <column datatype='integer' name='[customers_dmart]' role='measure' type='quantitative' />
            <column datatype='integer' name='[customers_trials]' role='measure' type='quantitative' />
            <column caption='Month' datatype='date' name='[date_trunc_month]' role='dimension' type='ordinal' />
            <column datatype='real' name='[delivery_time]' role='measure' type='quantitative' />
            <column datatype='integer' name='[dropoff_distance]' role='measure' type='quantitative' />
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
