      <column caption='Delivery Time' datatype='real' default-format='n#,##0.0&quot;&apos;&quot;;-#,##0.0&quot;&apos;&quot;' name='[Calculation_334110855405072389]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([federated.0zs5t390z61j6a1aonsgc0b1rod1].[delivery_time])/SUM([federated.0zs5t390z61j6a1aonsgc0b1rod1].[orders_w_delivery_time])' />
      </column>
      <column caption='NPS' datatype='real' name='[Calculation_334110855407747080]' role='measure' type='quantitative'>
