            <_.fcp.ObjectModelEncapsulateLegacy.true...object-id>[_E817A9859E96408282B39E01E934081B]</_.fcp.ObjectModelEncapsulateLegacy.true...object-id>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>store_age_reporting_month</remote-name>
            <remote-type>20</remote-type>
            <local-name>[store_age_reporting_month]</local-name>
            <parent-name>[Custom SQL Query]</parent-name>
            <remote-alias>store_age_reporting_month</remote-alias>
            <local-type>integer</local-type>
            <aggregation>Sum</aggregation>
            <contains-null>true</contains-null>
            <_.fcp.ObjectModelEncapsulateLegacy.true...object-id>[_E817A9859E96408282B39E01E934081B]</_.fcp.ObjectModelEncapsulateLegacy.true...object-id>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>is_franchise</remote-name>
            <remote-type>11</remote-type>
            <local-name>[is_franchise]</local-name>
            <parent-name>[Custom SQL Query]</parent-name>
            <remote-alias>is_franchise</remote-alias>
            <local-type>boolean</local-type>
