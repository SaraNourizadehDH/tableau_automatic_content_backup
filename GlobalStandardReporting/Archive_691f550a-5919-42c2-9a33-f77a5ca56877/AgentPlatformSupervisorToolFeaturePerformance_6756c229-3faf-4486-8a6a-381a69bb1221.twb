      <column caption='Selected KPI' datatype='integer' default-format='n#,##0.0;-#,##0.0' name='[Calculation_645633282135740467]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;  WHEN &apos;Total Clicks&apos; THEN [Calculation_645633282063671297]&#10;  WHEN &apos;Clicks on Agent Monitor tab&apos; THEN [Count Events (copy)_645633282067345412]&#10;  WHEN &apos;Clicks on Queue Monitor tab&apos; THEN [Agent Monitor Tab Events (copy)_645633282068324357]&#10;  WHEN &apos;Clicks on Active Cases tab&apos; THEN [Queue Monitor Tab Events (copy)_645633282068525062]&#10;  WHEN &apos;Unique Clicks * All 3 tabs combined&apos; THEN [Calculation_645633282130960433]&#10;  WHEN &apos;Unique Clicks on Agent Monitor tab&apos; THEN [Unique Clicks (copy)_4364902838990458880]&#10;  WHEN &apos;Unique Clicks on Queue Monitor tab&apos; THEN [Unique Clicks on Agent Monitor tab (copy)_4364902838990995457]&#10;  WHEN &apos;Unique Clicks on Active Cases tab&apos; THEN [Unique Clicks on Queue Monitor tab (copy)_4364902838991159298]&#10;END' />
      </column>
