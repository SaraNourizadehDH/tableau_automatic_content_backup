          <datasource-dependencies datasource='federated.0ne8l650hv19b61d08edk1nkajcj'>
            <column caption='Total Clicks % chg' datatype='real' default-format='p0.0%' name='[Active Cases Events % chg (copy)_5531616666054766600]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Active Cases Events current (copy)_5531616666054766603])-SUM([Active Cases Events previous (copy)_5531616666054766604]))/SUM([Active Cases Events previous (copy)_5531616666054766604])' />
            </column>
            <column caption='Total Clicks Negative % Diff' datatype='string' name='[Active Cases Events Negative % Diff (copy)_5531616666054766601]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Active Cases Events % chg (copy)_5531616666054766600] &lt; 0&#13;&#10;THEN &quot;▼&quot;&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
            </column>
            <column caption='Total Clicks Positive % Diff' datatype='string' name='[Active Cases Events Positive % Diff (copy)_5531616666054766602]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Active Cases Events % chg (copy)_5531616666054766600] &gt; 0&#13;&#10;THEN &quot;▲&quot;&#13;&#10;ELSE &quot;&quot;&#13;&#10;END' />
            </column>
            <column caption='Total Clicks current' datatype='integer' default-format='n#,##0;-#,##0' name='[Active Cases Events current (copy)_5531616666054766603]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Week&apos;&#10;then &#10;    {EXCLUDE [Calculation_645633282073948167]: &#10;    SUM(&#10;    IF [Calculation_672443783518289922]&#10;    THEN [count_events] END&#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos;&#10;then &#10;    {EXCLUDE [Calculation_645633282073948167]: &#10;    SUM(&#10;    IF [is_max_month (copy)_352899259462545410]&#10;    THEN[count_events] END &#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month&apos;&#10;then &#10;    {EXCLUDE [Calculation_645633282073948167]: &#10;    SUM(&#10;    IF [is_max_week (copy)_352899259461615616]&#10;    THEN[count_events] END &#10;    )&#10;    }&#10;end' />
            </column>
            <column caption='Total Clicks previous' datatype='integer' default-format='n#,##0;-#,##0' name='[Active Cases Events previous (copy)_5531616666054766604]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Week&apos;&#10;then &#10;    {EXCLUDE [Calculation_645633282073948167]: &#10;    SUM(&#10;    IF [is_max_week (copy)_672443783520116739]&#10;    THEN [count_events] END&#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos;&#10;then &#10;    {EXCLUDE [Calculation_645633282073948167]: &#10;    SUM(&#10;    IF [is_max_date (copy)_352899259463598083]&#10;    THEN[count_events] END &#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month&apos;&#10;then &#10;    {EXCLUDE [Calculation_645633282073948167]: &#10;    SUM(&#10;    IF [is_max_week_minus_one (copy)_352899259461959681]&#10;    THEN[count_events] END &#10;    )&#10;    }&#10;end' />
            </column>
            <column caption='Total Clicks' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_645633282063671297]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//COUNT([event_id])&#10;&#10;SUM([count_events])' />
            </column>
            <column caption='Date Granularity' datatype='string' name='[Calculation_645633282073948167]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;  WHEN &apos;Day&apos; THEN STR([report_date])&#10;  WHEN &apos;Week&apos; THEN [week]&#10;  WHEN &apos;Month&apos; THEN [month]&#10;END' />
            </column>
            <column caption='Unique Clicks * All 3 tabs combined' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_645633282130960433]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_unique_supervisors])' />
            </column>
            <column caption='is_max_week' datatype='boolean' name='[Calculation_672443783518289922]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{FIXED [week]: MAX([Date Range (copy)_645633282075136008])} = {FIXED: MAX([Date Range (copy)_645633282075136008])}' />
            </column>
            <column caption='Report Date' datatype='date' name='[Date Range (copy)_645633282075136008]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[report_date]' />
            </column>
