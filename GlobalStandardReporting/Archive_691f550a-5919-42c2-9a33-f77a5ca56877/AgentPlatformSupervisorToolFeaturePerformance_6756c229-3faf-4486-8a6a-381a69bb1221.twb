              <calculation class='tableau' formula='IF [Total Clicks % chg (copy)_5531616666056499213] &gt; 0&#13;&#10;THEN &quot;▲&quot;&#13;&#10;ELSE &quot;&quot;&#13;&#10;END' />
            </column>
            <column caption='Unique Clicks current' datatype='integer' default-format='n#,##0;-#,##0' name='[Total Clicks current (copy)_5531616666056499216]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Week&apos;&#10;then &#10;    {EXCLUDE [Calculation_645633282073948167]: &#10;    SUM(&#10;    IF [Calculation_672443783518289922]&#10;    THEN [count_unique_supervisors] END&#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos;&#10;then &#10;    {EXCLUDE [Calculation_645633282073948167]: &#10;    SUM(&#10;    IF [is_max_month (copy)_352899259462545410]&#10;    THEN[count_unique_supervisors] END &#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month&apos;&#10;then &#10;    {EXCLUDE [Calculation_645633282073948167]: &#10;    SUM(&#10;    IF [is_max_week (copy)_352899259461615616]&#10;    THEN[count_unique_supervisors] END &#10;    )&#10;    }&#10;end' />
            </column>
            <column caption='Unique Clicks previous' datatype='integer' default-format='n#,##0;-#,##0' name='[Total Clicks previous (copy)_5531616666056499217]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Week&apos;&#10;then &#10;    {EXCLUDE [Calculation_645633282073948167]: &#10;    SUM(&#10;    IF [is_max_week (copy)_672443783520116739]&#10;    THEN [count_unique_supervisors] END&#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos;&#10;then &#10;    {EXCLUDE [Calculation_645633282073948167]: &#10;    SUM(&#10;    IF [is_max_date (copy)_352899259463598083]&#10;    THEN[count_unique_supervisors] END &#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month&apos;&#10;then &#10;    {EXCLUDE [Calculation_645633282073948167]: &#10;    SUM(&#10;    IF [is_max_week_minus_one (copy)_352899259461959681]&#10;    THEN[count_unique_supervisors] END &#10;    )&#10;    }&#10;end' />
