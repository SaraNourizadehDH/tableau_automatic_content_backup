            </column>
            <column caption='Unique Clicks Negative % Diff' datatype='string' name='[Total Clicks Negative % Diff (copy)_5531616666056499214]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Total Clicks % chg (copy)_5531616666056499213] &lt; 0&#13;&#10;THEN &quot;▼&quot;&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
            </column>
