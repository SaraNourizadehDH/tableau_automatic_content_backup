      </semantic-values>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_906AA5D6E3DB4AEDAD26C19F69238917'>
            <properties context=''>
              <relation connection='bigquery.0hos8ky0gjo06n1e2oe8q1j33cnu' name='Custom SQL Query' type='text'>WITH deal_types AS (
  SELECT
    *
    ,CASE
      WHEN (cit_discount_incentive_type IN (&apos;amount&apos;, &apos;percentage&apos;) AND cit_discount_num_products = 0 OR cit_discount_num_products IS NULL) THEN &apos;Full Menu&apos;
      WHEN (cit_discount_incentive_type IN (&apos;amount&apos;, &apos;percentage&apos;, &apos;composite&apos;) AND cit_discount_num_products &gt;&gt; 0) THEN &apos;Item Level&apos;
      ELSE cit_voucher_incentive_type
    END discount_incentive_type
    ,CASE
      WHEN (cit_voucher_incentive_type IN (&apos;amount&apos;, &apos;percentage&apos;) AND cit_voucher_num_products = 0 OR cit_discount_num_products IS NULL) THEN &apos;Full Menu&apos;
      WHEN (cit_voucher_incentive_type IN (&apos;amount&apos;, &apos;percentage&apos;, &apos;composite&apos;) AND cit_voucher_num_products &gt;&gt; 0) THEN &apos;Item Level&apos;
      ELSE cit_voucher_incentive_type
    END voucher_incentive_type
  FROM `dhh-ncr-stg.dev_sales_revenue.pandora_apac_vs_cit_stream_sr_ver`
)

, discounts AS (
  SELECT
    COALESCE(DATE(pd_created_at_utc), DATE(cit_order_placed_utc)) created_date_utc
    ,COALESCE(pd_global_entity_id, cit_global_entity_id) global_entity_id
    ,discount_incentive_type incentive_type
    ,&apos;Discounts&apos; incentive_category
    
    ,COUNT(DISTINCT COALESCE(pd_order_id, cit_order_id)) any_orders
    
    -- ORDERS COMPARISON
    ,COUNT(DISTINCT pd_order_id) pd_orders
    ,COUNT(DISTINCT cit_order_id) cit_orders
    ,COUNT(DISTINCT CASE WHEN is_matched_order THEN pd_order_id END) matched_order_counts

    ,SUM(pd_gmv_local) pd_gmv_local
    ,SUM(cit_gmv_local) cit_gmv_local

    ,SUM(pd_gmv_eur) pd_gmv_eur
    ,SUM(cit_gmv_eur) cit_gmv_eur

    ,SUM(pd_gfv_local) pd_gfv_local
    ,SUM(cit_gfv_local) cit_gfv_local

    ,SUM(pd_gfv_eur) pd_gfv_eur
    ,SUM(cit_gfv_eur) cit_gfv_eur
    
    -- SPONSORSHIP RATIO
    ,COUNT(DISTINCT CASE WHEN pd_platform_discount_ratio = cit_platform_discount_ratio THEN COALESCE(pd_discount_id, cit_discount_incentive_code) END) matched_inct_dh_sponsor_ratio
    ,COUNT(DISTINCT CASE WHEN pd_vendor_discount_ratio = cit_vendor_discount_ratio THEN COALESCE(pd_discount_id, cit_discount_incentive_code) END) matched_inct_vendor_sponsor_ratio

    -- DISCOUNTS COMPARISON --
    ,COUNT(DISTINCT pd_discount_id) pd_incts
    ,COUNT(DISTINCT cit_discount_incentive_code) cit_incts
    ,COUNT(DISTINCT CASE WHEN is_matched_discount THEN pd_discount_id END) matched_inct_counts
    
    -- VENDOR FUNDED VALUES
    ,SUM(pd_vf_discount_local) pd_vf_inct_local
    ,SUM(cit_vf_discount_local) cit_vf_inct_local

    ,SUM(pd_vf_discount_eur) pd_vf_inct_eur
    ,SUM(cit_vf_discount_eur) cit_vf_inct_eur

    -- DH FUNDED VALUES
    ,SUM(pd_pf_discount_local) pd_pf_inct_local
    ,SUM(cit_pf_discount_local) cit_pf_inct_local

    ,SUM(pd_pf_discount_eur) pd_pf_inct_eur
    ,SUM(cit_pf_discount_eur) cit_pf_inct_eur

  FROM deal_types
  WHERE (cit_discount_incentive_code IS NOT NULL)
    AND COALESCE(pd_discount_id, cit_discount_incentive_code) IS NOT NULL
    AND vertical_type = &apos;restaurants&apos;
  GROUP BY 1,2,3
)

, vouchers AS (
  SELECT
    COALESCE(DATE(pd_created_at_utc), DATE(cit_order_placed_utc)) created_date_utc
    ,COALESCE(pd_global_entity_id, cit_global_entity_id) global_entity_id
    ,voucher_incentive_type incentive_type
    ,&apos;Vouchers&apos; incentive_category
    
    ,COUNT(DISTINCT COALESCE(pd_order_id, cit_order_id)) any_orders
    
    -- ORDERS COMPARISON
    ,COUNT(DISTINCT pd_order_id) pd_orders
    ,COUNT(DISTINCT cit_order_id) cit_orders
    ,COUNT(DISTINCT CASE WHEN is_matched_order THEN pd_order_id END) matched_order_counts

    ,SUM(pd_gmv_local) pd_gmv_local
    ,SUM(cit_gmv_local) cit_gmv_local

    ,SUM(pd_gmv_eur) pd_gmv_eur
    ,SUM(cit_gmv_eur) cit_gmv_eur

    ,SUM(pd_gfv_local) pd_gfv_local
    ,SUM(cit_gfv_local) cit_gfv_local

    ,SUM(pd_gfv_eur) pd_gfv_eur
    ,SUM(cit_gfv_eur) cit_gfv_eur
    
    -- SPONSORSHIP RATIO
    ,COUNT(DISTINCT CASE WHEN pd_platform_voucher_ratio = cit_platform_voucher_ratio THEN COALESCE(pd_voucher_id, cit_voucher_incentive_code) END) matched_voucher_dh_sponsor_ratio
    ,COUNT(DISTINCT CASE WHEN pd_vendor_voucher_ratio = cit_vendor_voucher_ratio THEN COALESCE(pd_voucher_id, cit_voucher_incentive_code) END) matched_voucher_vendor_sponsor_ratio

    -- vouchers COMPARISON --
    ,COUNT(DISTINCT pd_voucher_id) pd_vouchers
    ,COUNT(DISTINCT cit_voucher_incentive_code) cit_vouchers
    ,COUNT(DISTINCT CASE WHEN is_matched_voucher THEN pd_voucher_id END) matched_voucher_counts
    
    -- VENDOR FUNDED VALUES
    ,SUM(pd_vf_voucher_local) pd_vf_voucher_local
    ,SUM(cit_vf_voucher_local) cit_vf_voucher_local

    ,SUM(pd_vf_voucher_eur) pd_vf_voucher_eur
    ,SUM(cit_vf_voucher_eur) cit_vf_voucher_eur

    -- DH FUNDED VALUES
    ,SUM(pd_pf_voucher_local) pd_pf_voucher_local
    ,SUM(cit_pf_voucher_local) cit_pf_voucher_local

    ,SUM(pd_pf_voucher_eur) pd_pf_voucher_eur
    ,SUM(cit_pf_voucher_eur) cit_pf_voucher_eur

  FROM deal_types
  WHERE (cit_voucher_incentive_code IS NOT NULL)
    AND COALESCE(pd_voucher_id, cit_voucher_incentive_code) IS NOT NULL
    AND vertical_type = &apos;restaurants&apos;
  GROUP BY 1,2,3
)

SELECT * FROM discounts
UNION ALL
SELECT * FROM vouchers</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='Data Quality by Deal Type' inline='true' name='federated.1wy20ay11fzcko1fxxov212430i4' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.15iycnt1lilnki1711ffw0x9e2d9'>
            <connection CATALOG='dhh-ncr-stg' EXECCATALOG='dhh-ncr-stg' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='dhh-ncr-stg' schema='dev_sales_revenue' server-oauth='' username='yexi.yuan@foodpanda.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.15iycnt1lilnki1711ffw0x9e2d9' name='Custom SQL Query' type='text'>SELECT
    COALESCE(DATE(pd_created_at_utc), DATE(cit_order_placed_utc)) created_date_utc
    ,COALESCE(pd_global_entity_id, cit_global_entity_id) global_entiy_id

    -- INCENTIVE TYPE --
    --DISCOUNT
    --FULL MENU
    ,COUNT(DISTINCT 
      CASE WHEN cit_discount_incentive_type IN (&apos;amount&apos;, &apos;percentage&apos;) 
      AND cit_discount_num_products = 0 
      THEN pd_discount_id END
    ) pd_full_menu_discounts
    ,COUNT(DISTINCT 
      CASE WHEN cit_discount_incentive_type IN (&apos;amount&apos;, &apos;percentage&apos;) 
      AND cit_discount_num_products = 0 
      THEN cit_discount_incentive_code END
    ) cit_full_menu_discounts
    ,COUNT(DISTINCT 
      CASE WHEN cit_discount_incentive_type IN (&apos;amount&apos;, &apos;percentage&apos;) 
      AND cit_discount_num_products = 0 
      AND is_matched_discount
      THEN pd_discount_id END
    ) matched_full_menu_discount_counts
    ,SUM(
      CASE WHEN cit_discount_incentive_type IN (&apos;amount&apos;, &apos;percentage&apos;) 
      AND cit_discount_num_products = 0 
      THEN pd_vf_discount_eur END
    ) pd_vf_full_menu_discount_eur
    ,SUM(
      CASE WHEN cit_discount_incentive_type IN (&apos;amount&apos;, &apos;percentage&apos;) 
      AND cit_discount_num_products = 0 
      THEN cit_vf_discount_eur END
    ) cit_vf_full_menu_discount_eur
    ,SUM(
      CASE WHEN cit_discount_incentive_type IN (&apos;amount&apos;, &apos;percentage&apos;) 
      AND cit_discount_num_products = 0 
      THEN pd_pf_discount_eur END
    ) pd_pf_full_menu_discount_eur
    ,SUM(
      CASE WHEN cit_discount_incentive_type IN (&apos;amount&apos;, &apos;percentage&apos;) 
      AND cit_discount_num_products = 0 
      THEN cit_pf_discount_eur END
    ) cit_pf_full_menu_discount_eur
    --ITEM-LEVEL
    ,COUNT(DISTINCT 
      CASE WHEN cit_discount_incentive_type IN (&apos;amount&apos;, &apos;percentage&apos;, &apos;composite&apos;) 
      AND cit_discount_num_products &gt;&gt; 0 
      THEN pd_discount_id END
    ) pd_item_level_discounts
    ,COUNT(DISTINCT 
      CASE WHEN cit_discount_incentive_type IN (&apos;amount&apos;, &apos;percentage&apos;, &apos;composite&apos;) 
      AND cit_discount_num_products &gt;&gt; 0 
      THEN cit_discount_incentive_code END
    ) cit_item_level_discounts
    ,COUNT(DISTINCT 
      CASE WHEN cit_discount_incentive_type IN (&apos;amount&apos;, &apos;percentage&apos;, &apos;composite&apos;) 
      AND cit_discount_num_products &gt;&gt; 0 
      AND is_matched_discount
      THEN pd_discount_id END
    ) matched_item_level_discount_counts
    ,SUM(
      CASE WHEN cit_discount_incentive_type IN (&apos;amount&apos;, &apos;percentage&apos;, &apos;composite&apos;) 
      AND cit_discount_num_products &gt;&gt; 0 
      THEN pd_vf_discount_eur END
    ) pd_vf_item_level_discount_eur
    ,SUM(
      CASE WHEN cit_discount_incentive_type IN (&apos;amount&apos;, &apos;percentage&apos;, &apos;composite&apos;) 
      AND cit_discount_num_products &gt;&gt; 0 
      THEN cit_vf_discount_eur END
    ) cit_vf_item_level_discount_eur
    ,SUM(
      CASE WHEN cit_discount_incentive_type IN (&apos;amount&apos;, &apos;percentage&apos;, &apos;composite&apos;) 
      AND cit_discount_num_products &gt;&gt; 0 
      THEN pd_pf_discount_eur END
    ) pd_pf_item_level_discount_eur
    ,SUM(
      CASE WHEN cit_discount_incentive_type IN (&apos;amount&apos;, &apos;percentage&apos;, &apos;composite&apos;) 
      AND cit_discount_num_products &gt;&gt; 0 
      THEN cit_pf_discount_eur END
    ) cit_pf_item_level_discount_eur
    -- DELIVERY FEE
    ,COUNT(DISTINCT 
      CASE WHEN cit_discount_incentive_type = &apos;delivery_fee&apos;
      THEN pd_discount_id END
    ) pd_delivery_fee_discounts
    ,COUNT(DISTINCT 
      CASE WHEN cit_discount_incentive_type = &apos;delivery_fee&apos;
      THEN cit_discount_incentive_code END
    ) cit_delivery_fee_discounts
    ,COUNT(DISTINCT 
      CASE WHEN cit_discount_incentive_type = &apos;delivery_fee&apos;
      AND is_matched_discount
      THEN pd_discount_id END
    ) matched_delivery_fee_discount_counts
    ,SUM(
      CASE WHEN cit_discount_incentive_type = &apos;delivery_fee&apos;
      THEN pd_vf_discount_eur END
    ) pd_vf_delivery_fee_discount_eur
    ,SUM(
      CASE WHEN cit_discount_incentive_type = &apos;delivery_fee&apos;
      THEN cit_vf_discount_eur END
    ) cit_vf_delivery_fee_discount_eur
    ,SUM(
      CASE WHEN cit_discount_incentive_type = &apos;delivery_fee&apos;
      THEN pd_pf_discount_eur END
    ) pd_pf_delivery_fee_discount_eur
    ,SUM(
      CASE WHEN cit_discount_incentive_type = &apos;delivery_fee&apos;
      THEN cit_pf_discount_eur END
    ) cit_pf_delivery_fee_discount_eur
    -- NULL
    ,COUNT(DISTINCT 
      CASE WHEN cit_discount_incentive_type IS NULL
      THEN pd_discount_id END
    ) pd_null_type_discounts
    ,COUNT(DISTINCT 
      CASE WHEN cit_discount_incentive_type IS NULL
      THEN cit_discount_incentive_code END
    ) cit_null_type_discounts
    ,COUNT(DISTINCT 
      CASE WHEN cit_discount_incentive_type IS NULL
      AND is_matched_discount
      THEN pd_discount_id END
    ) matched_null_type_discount_counts
    ,SUM(
      CASE WHEN cit_discount_incentive_type IS NULL
      THEN pd_vf_discount_eur END
    ) pd_vf_null_type_discount_eur
    ,SUM(
      CASE WHEN cit_discount_incentive_type IS NULL
      THEN cit_vf_discount_eur END
    ) cit_vf_null_type_discount_eur
    ,SUM(
      CASE WHEN cit_discount_incentive_type IS NULL
      THEN pd_pf_discount_eur END
    ) pd_pf_null_type_discount_eur
    ,SUM(
      CASE WHEN cit_discount_incentive_type IS NULL
      THEN cit_pf_discount_eur END
    ) cit_pf_null_type_discount_eur

    --DISCOUNT
    --FULL MENU
    ,COUNT(DISTINCT 
      CASE WHEN cit_voucher_incentive_type IN (&apos;amount&apos;, &apos;percentage&apos;) 
      AND cit_voucher_num_products = 0 
      THEN pd_voucher_id END
    ) pd_full_menu_vouchers
    ,COUNT(DISTINCT 
      CASE WHEN cit_voucher_incentive_type IN (&apos;amount&apos;, &apos;percentage&apos;) 
      AND cit_voucher_num_products = 0 
      THEN cit_voucher_incentive_code END
    ) cit_full_menu_vouchers
    ,COUNT(DISTINCT 
      CASE WHEN cit_voucher_incentive_type IN (&apos;amount&apos;, &apos;percentage&apos;) 
      AND cit_voucher_num_products = 0 
      AND is_matched_voucher
      THEN pd_voucher_id END
    ) matched_full_menu_voucher_counts
    ,SUM(
      CASE WHEN cit_voucher_incentive_type IN (&apos;amount&apos;, &apos;percentage&apos;) 
      AND cit_voucher_num_products = 0 
      THEN pd_vf_voucher_eur END
    ) pd_vf_full_menu_voucher_eur
    ,SUM(
      CASE WHEN cit_voucher_incentive_type IN (&apos;amount&apos;, &apos;percentage&apos;) 
      AND cit_voucher_num_products = 0 
      THEN cit_vf_voucher_eur END
    ) cit_vf_full_menu_voucher_eur
    ,SUM(
      CASE WHEN cit_voucher_incentive_type IN (&apos;amount&apos;, &apos;percentage&apos;) 
      AND cit_voucher_num_products = 0 
      THEN pd_pf_voucher_eur END
    ) pd_pf_full_menu_voucher_eur
    ,SUM(
      CASE WHEN cit_voucher_incentive_type IN (&apos;amount&apos;, &apos;percentage&apos;) 
      AND cit_voucher_num_products = 0 
      THEN cit_pf_voucher_eur END
    ) cit_pf_full_menu_voucher_eur
    --ITEM-LEVEL
    ,COUNT(DISTINCT 
      CASE WHEN cit_voucher_incentive_type IN (&apos;amount&apos;, &apos;percentage&apos;, &apos;composite&apos;) 
      AND cit_voucher_num_products &gt;&gt; 0 
      THEN pd_voucher_id END
    ) pd_item_level_vouchers
    ,COUNT(DISTINCT 
      CASE WHEN cit_voucher_incentive_type IN (&apos;amount&apos;, &apos;percentage&apos;, &apos;composite&apos;) 
      AND cit_voucher_num_products &gt;&gt; 0 
      THEN cit_voucher_incentive_code END
    ) cit_item_level_vouchers
    ,COUNT(DISTINCT 
      CASE WHEN cit_voucher_incentive_type IN (&apos;amount&apos;, &apos;percentage&apos;, &apos;composite&apos;) 
      AND cit_voucher_num_products &gt;&gt; 0 
      AND is_matched_voucher
      THEN pd_voucher_id END
    ) matched_item_level_voucher_counts
    ,SUM(
      CASE WHEN cit_voucher_incentive_type IN (&apos;amount&apos;, &apos;percentage&apos;, &apos;composite&apos;) 
      AND cit_voucher_num_products &gt;&gt; 0 
      THEN pd_vf_voucher_eur END
    ) pd_vf_item_level_voucher_eur
    ,SUM(
      CASE WHEN cit_voucher_incentive_type IN (&apos;amount&apos;, &apos;percentage&apos;, &apos;composite&apos;) 
      AND cit_voucher_num_products &gt;&gt; 0 
      THEN cit_vf_voucher_eur END
    ) cit_vf_item_level_voucher_eur
    ,SUM(
      CASE WHEN cit_voucher_incentive_type IN (&apos;amount&apos;, &apos;percentage&apos;, &apos;composite&apos;) 
      AND cit_voucher_num_products &gt;&gt; 0 
      THEN pd_pf_voucher_eur END
    ) pd_pf_item_level_voucher_eur
    ,SUM(
      CASE WHEN cit_voucher_incentive_type IN (&apos;amount&apos;, &apos;percentage&apos;, &apos;composite&apos;) 
      AND cit_voucher_num_products &gt;&gt; 0 
      THEN cit_pf_voucher_eur END
    ) cit_pf_item_level_voucher_eur
    -- DELIVERY FEE
    ,COUNT(DISTINCT 
