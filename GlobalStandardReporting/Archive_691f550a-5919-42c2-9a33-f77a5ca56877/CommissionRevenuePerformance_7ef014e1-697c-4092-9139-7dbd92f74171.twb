    <worksheet name='DIM Selector (3)'>
      <layout-options>
        <title>
          <formatted-text>
            <run>DIM Selector</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='master_comm_report (sales_reports)' name='federated.05u51qi1f3outg1aee7xu0xhe5e5' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='KPI 3' datatype='string' name='[KPI 1 (copy) (copy)_2093329402330943535]' param-domain-type='list' role='measure' type='nominal' value='&quot;Orders&quot;'>
              <calculation class='tableau' formula='&quot;Orders&quot;' />
              <aliases>
                <alias key='&quot;Acq Comm Rate&quot;' value='Acq Comm Rate (%)' />
                <alias key='&quot;Comm Rate&quot;' value='Comm Rate (%)' />
                <alias key='&quot;Floor Compliance&quot;' value='Floor Compliance (%)' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.05u51qi1f3outg1aee7xu0xhe5e5'>
            <column caption='Acq Comm Rate Dash' datatype='real' datatype-customized='true' name='[Acq Comm Rate (copy)_192528943020306435]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([new_intake_commission_eur])/SUM([new_intake_commission_base_eur]))*100' />
            </column>
            <column datatype='integer' name='[Acquisitions]' role='measure' type='quantitative' />
            <column caption='Avg Monthly Recurring' datatype='real' name='[Avg One Time (copy)_2093329402323337241]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([tot_monthlyrecurring])/SUM([New_Intake_total])' />
            </column>
            <column caption='Avg One Time' datatype='real' name='[Calculation_2093329402321747988]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([tot_onetime])/SUM([New_Intake_total])' />
            </column>
            <column caption='Recurring Fees, all inventory: Avg fees charged - basis SF' datatype='real' name='[Calculation_2093329402327326760]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_renewal_recurring_fees])/SUM([total_vendors])' />
            </column>
            <column caption='Avg Comm Rev per Vendor' datatype='real' name='[Calculation_3286079622900871169]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([commission_eur])/SUM([total_vendors])' />
            </column>
            <column caption='AFV' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_3286079622902603782]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([commission_base_eur])/SUM([orders])' />
            </column>
            <column caption='Avg Order per Ven' datatype='real' name='[Calculation_3286079622903676937]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders])/SUM([total_vendors])' />
            </column>
            <column caption='Date Filter' datatype='boolean' name='[Calculation_616359894184873984]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[YearMonth]&lt; [Test (copy)_616359894189690883]' />
            </column>
            <column caption='Test' datatype='date' default-format='*yyyymm' name='[Calculation_616359894186373121]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='TODAY()' />
            </column>
            <column caption='Commission signed all vendors' datatype='real' name='[Calculation_738731142071963648]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([EFFECTIVE_COMM_RATE]*[vendors])/SUM([vendors]))*100' />
            </column>
            <column caption='Commission signed new acquisitions' datatype='real' name='[Calculation_738731142072078337]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([new_intake_commission_rate]*[New_Intake_total])/SUM([New_Intake_total]))*100' />
            </column>
            <column caption='Comm Rate Dash' datatype='real' datatype-customized='true' name='[Comm Rate (copy)_192528943019425792]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([commission_eur])/SUM([commission_base_eur]))*100' />
            </column>
            <column datatype='real' name='[EFFECTIVE_COMM_RATE]' role='measure' type='quantitative' />
            <column caption='Floor Compliance Dash' datatype='real' name='[Floor Compliance (copy)_192528943020380164]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//(1.00 - SUM([vendors_below_floor])/SUM([Total Vendors]))*100&#10;&#10;(1.00 - SUM([total_vendors_below_floor])/SUM([total_vendors]))*100&#10;&#10;//AVG([floor_compliance])*100' />
            </column>
            <column caption='KPI 3' datatype='real' name='[KPI 1 (copy) (copy)_4034451223610867722]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[KPI 1 (copy) (copy)_2093329402330943535] = &apos;Acquisitions&apos; THEN SUM([Acquisitions])&#10;ELSEIF [Parameters].[KPI 1 (copy) (copy)_2093329402330943535] = &apos;Trial Acquisitions&apos; THEN SUM([Trial_Acquisitions])&#10;&#10;ELSEIF [Parameters].[KPI 1 (copy) (copy)_2093329402330943535] = &apos;Floor Compliance&apos; THEN [Floor Compliance (copy)_192528943020380164]&#10;ELSEIF [Parameters].[KPI 1 (copy) (copy)_2093329402330943535] = &apos;Comm Rev&apos; THEN SUM([commission_eur])&#10;ELSEIF [Parameters].[KPI 1 (copy) (copy)_2093329402330943535] = &apos;Comm Base&apos; THEN SUM([commission_base_eur])&#10;ELSEIF [Parameters].[KPI 1 (copy) (copy)_2093329402330943535] = &apos;Comm Rate&apos; THEN [Comm Rate (copy)_192528943019425792]&#10;ELSEIF [Parameters].[KPI 1 (copy) (copy)_2093329402330943535] = &apos;Acq Comm Rate&apos; THEN [Acq Comm Rate (copy)_192528943020306435]&#10;ELSEIF [Parameters].[KPI 1 (copy) (copy)_2093329402330943535] = &apos;Active Vendors&apos; THEN SUM([active_vendors])&#10;ELSEIF [Parameters].[KPI 1 (copy) (copy)_2093329402330943535] = &apos;Avg Comm Rev per Vendor&apos; THEN [Calculation_3286079622900871169]&#10;ELSEIF [Parameters].[KPI 1 (copy) (copy)_2093329402330943535] = &apos;AFV&apos; THEN [Calculation_3286079622902603782]&#10;&#10;ELSEIF [Parameters].[KPI 1 (copy) (copy)_2093329402330943535] = &apos;One Time Fees from Acqs: % Compliance - basis SF&apos; THEN [One Time Fees Compliance (copy)_2093329402318962689]&#10;ELSEIF [Parameters].[KPI 1 (copy) (copy)_2093329402330943535] = &apos;One Time Fees from Acqs: Avg fees charged - basis SF&apos; THEN [Calculation_2093329402321747988]&#10;ELSEIF [Parameters].[KPI 1 (copy) (copy)_2093329402330943535] = &apos;One Time Fees from Acqs: Total fees charged - basis SF&apos; THEN SUM([tot_onetime])&#10;&#10;ELSEIF [Parameters].[KPI 1 (copy) (copy)_2093329402330943535] = &apos;Recurring Fees from Acqs: % Compliance - basis SF&apos; THEN [One Time Fees Compliance Dash (copy)_2093329402319151107]&#10;ELSEIF [Parameters].[KPI 1 (copy) (copy)_2093329402330943535] = &apos;Recurring Fees from Acqs: Avg fees charged - basis SF&apos; THEN [Avg One Time (copy)_2093329402323337241]&#10;ELSEIF [Parameters].[KPI 1 (copy) (copy)_2093329402330943535] = &apos;Recurring Fees from Acqs: Total fees charged - basis SF&apos; THEN SUM([tot_monthlyrecurring])&#10;&#10;ELSEIF [Parameters].[KPI 1 (copy) (copy)_2093329402330943535] = &apos;Recurring Fees, all inventory: % Compliance - basis SF&apos; THEN [Recurring Fees, all inventory: % Compliance - basis SF (copy)_2093329402329755693]&#10;ELSEIF [Parameters].[KPI 1 (copy) (copy)_2093329402330943535] = &apos;Recurring Fees, all inventory: Avg fees charged - basis SF&apos; THEN [Calculation_2093329402327326760]&#10;ELSEIF [Parameters].[KPI 1 (copy) (copy)_2093329402330943535] = &apos;Recurring Fees, all inventory: Total fees charged - basis SF&apos; THEN SUM([total_renewal_recurring_fees])&#10;&#10;ELSEIF [Parameters].[KPI 1 (copy) (copy)_2093329402330943535] = &apos;Commission signed all vendors&apos; THEN [Calculation_738731142071963648]&#10;ELSEIF [Parameters].[KPI 1 (copy) (copy)_2093329402330943535] = &apos;Commission signed new acquisitions&apos; THEN [Calculation_738731142072078337]&#10;&#10;ELSEIF [Parameters].[KPI 1 (copy) (copy)_2093329402330943535] = &apos;Acquisitions Comm Rev&apos; THEN SUM([new_intake_commission_eur])&#10;ELSEIF [Parameters].[KPI 1 (copy) (copy)_2093329402330943535] = &apos;Acquisitions GFV&apos; THEN SUM([new_intake_commission_base_eur])&#10;ELSEIF [Parameters].[KPI 1 (copy) (copy)_2093329402330943535] = &apos;Orders&apos; THEN SUM([orders])&#10;ELSEIF [Parameters].[KPI 1 (copy) (copy)_2093329402330943535] = &apos;Avg Orders per Vendor&apos; THEN [Calculation_3286079622903676937]&#10;END' />
            </column>
            <column datatype='integer' name='[New_Intake_total]' role='measure' type='quantitative' />
            <column caption='One Time Fees Compliance Dash' datatype='real' name='[One Time Fees Compliance (copy)_2093329402318962689]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([tot_onetime_compliant])/SUM([New_Intake_total]))*100' />
            </column>
            <column caption='Recurring Fees Compliance Dash' datatype='real' name='[One Time Fees Compliance Dash (copy)_2093329402319151107]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([tot_monthlyrecurring_compliant])/SUM([New_Intake_total]))*100' />
            </column>
            <column caption='Recurring Fees, all inventory: % Compliance - basis SF Dash' datatype='real' name='[Recurring Fees, all inventory: % Compliance - basis SF (copy)_2093329402329755693]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([total_vendors_paying_renewal_recurring])/SUM([total_vendors]))*100' />
