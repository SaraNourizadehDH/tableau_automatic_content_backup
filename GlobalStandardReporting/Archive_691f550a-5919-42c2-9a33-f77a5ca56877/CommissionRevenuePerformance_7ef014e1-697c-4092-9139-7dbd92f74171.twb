      <column caption='Delta date filter' datatype='boolean' name='[Calculation_3992300398648520704]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Year Month (copy)_2293598913785802752]=dateadd(&apos;month&apos;,-6,datetrunc(&apos;month&apos;, today()))&#10;&#10;or&#10;&#10;[Year Month (copy)_2293598913785802752]=dateadd(&apos;month&apos;,-1,datetrunc(&apos;month&apos;, today()))' />
      </column>
      <column caption='Calculation1' datatype='boolean' name='[Calculation_3992300398649602049]' role='measure' type='nominal'>
