            <column caption='Recurring Fees Compliance Dash' datatype='real' name='[One Time Fees Compliance Dash (copy)_2093329402319151107]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([tot_monthlyrecurring_compliant])/SUM([New_Intake_total]))*100' />
