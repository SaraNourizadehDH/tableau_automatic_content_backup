      <column caption='Recurring Fees, all inventory: % Compliance - basis SF' datatype='real' name='[Calculation_2093329402324860959]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_vendors_paying_renewal_recurring])/SUM([total_vendors])' />
