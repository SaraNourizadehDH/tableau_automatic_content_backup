    <worksheet name='DIM Selector (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run>DIM Selector</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='master_comm_report (sales_reports)' name='federated.05u51qi1f3outg1aee7xu0xhe5e5' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='DIM 2' datatype='string' name='[DIM 1 (copy)_372039564450799622]' param-domain-type='list' role='measure' type='nominal' value='&quot;Vendor Sub Category&quot;'>
              <calculation class='tableau' formula='&quot;Vendor Sub Category&quot;' />
            </column>
            <column caption='KPI 8' datatype='string' name='[KPI 1 (copy) (copy) (copy) (copy) (copy) (copy) (copy)_2093329402331000884]' param-domain-type='list' role='measure' type='nominal' value='&quot;Acquisitions Comm Rev&quot;'>
              <calculation class='tableau' formula='&quot;Acquisitions Comm Rev&quot;' />
              <aliases>
                <alias key='&quot;Acq Comm Rate&quot;' value='Acq Comm Rate (%)' />
                <alias key='&quot;Comm Rate&quot;' value='Comm Rate (%)' />
                <alias key='&quot;Floor Compliance&quot;' value='Floor Compliance (%)' />
              </aliases>
            </column>
            <column caption='KPI 7' datatype='string' name='[KPI 1 (copy) (copy) (copy) (copy) (copy) (copy)_2093329402330992691]' param-domain-type='list' role='measure' type='nominal' value='&quot;Avg Comm Rev per Vendor&quot;'>
              <calculation class='tableau' formula='&quot;Avg Comm Rev per Vendor&quot;' />
              <aliases>
                <alias key='&quot;Acq Comm Rate&quot;' value='Acq Comm Rate (%)' />
                <alias key='&quot;Comm Rate&quot;' value='Comm Rate (%)' />
                <alias key='&quot;Floor Compliance&quot;' value='Floor Compliance (%)' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.05u51qi1f3outg1aee7xu0xhe5e5'>
            <column caption='Acq Comm Rate Dash' datatype='real' datatype-customized='true' name='[Acq Comm Rate (copy)_192528943020306435]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([new_intake_commission_eur])/SUM([new_intake_commission_base_eur]))*100' />
            </column>
            <column datatype='integer' name='[Acquisitions]' role='measure' type='quantitative' />
            <column caption='Avg Monthly Recurring' datatype='real' name='[Avg One Time (copy)_2093329402323337241]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([tot_monthlyrecurring])/SUM([New_Intake_total])' />
            </column>
            <column caption='Avg One Time' datatype='real' name='[Calculation_2093329402321747988]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([tot_onetime])/SUM([New_Intake_total])' />
            </column>
            <column caption='Recurring Fees, all inventory: Avg fees charged - basis SF' datatype='real' name='[Calculation_2093329402327326760]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_renewal_recurring_fees])/SUM([total_vendors])' />
            </column>
            <column caption='Avg Comm Rev per Vendor' datatype='real' name='[Calculation_3286079622900871169]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([commission_eur])/SUM([total_vendors])' />
            </column>
            <column caption='AFV' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_3286079622902603782]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([commission_base_eur])/SUM([orders])' />
            </column>
            <column caption='Avg Order per Ven' datatype='real' name='[Calculation_3286079622903676937]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders])/SUM([total_vendors])' />
            </column>
            <column caption='Date Filter' datatype='boolean' name='[Calculation_616359894184873984]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[YearMonth]&lt; [Test (copy)_616359894189690883]' />
            </column>
            <column caption='Test' datatype='date' default-format='*yyyymm' name='[Calculation_616359894186373121]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='TODAY()' />
            </column>
            <column caption='Commission signed all vendors' datatype='real' name='[Calculation_738731142071963648]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([EFFECTIVE_COMM_RATE]*[vendors])/SUM([vendors]))*100' />
            </column>
            <column caption='Commission signed new acquisitions' datatype='real' name='[Calculation_738731142072078337]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([new_intake_commission_rate]*[New_Intake_total])/SUM([New_Intake_total]))*100' />
            </column>
            <column caption='Comm Rate Dash' datatype='real' datatype-customized='true' name='[Comm Rate (copy)_192528943019425792]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([commission_eur])/SUM([commission_base_eur]))*100' />
            </column>
            <column caption='DIMENSION 2' datatype='string' name='[DIM 1 (copy)_372039564451090439]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[DIM 1 (copy)_372039564450799622]&#10;WHEN &quot;Vendor Sub Category&quot; THEN [ka_sub_category]&#10;//WHEN &apos;Above_Below_Floor&apos; THEN [below_floor]&#10;//WHEN &apos;Preferred Partnership&apos; THEN [is_preferred_partner]&#10;WHEN &apos;Entity&apos; THEN [management_entity]&#10;WHEN &apos;Market&apos; THEN [display_name]&#10;WHEN &apos;Vertical Segment&apos; THEN [vertical_segment_c]&#10;WHEN &apos;Year Month&apos; THEN [YearMonth]&#10;END' />
            </column>
            <column datatype='real' name='[EFFECTIVE_COMM_RATE]' role='measure' type='quantitative' />
            <column caption='Floor Compliance Dash' datatype='real' name='[Floor Compliance (copy)_192528943020380164]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//(1.00 - SUM([vendors_below_floor])/SUM([Total Vendors]))*100&#10;&#10;(1.00 - SUM([total_vendors_below_floor])/SUM([total_vendors]))*100&#10;&#10;//AVG([floor_compliance])*100' />
