    <worksheet name='Order Shares After Every Filtering Step'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='12'>Order Shares After Every Filtering Step and Rev Uplift Simulation</run>
            <run>Æ&#10;</run>
            <run fontcolor='#e15759' fontsize='9' italic='true'>The table is sorted in descending order of ASA order share of entity</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='final_vendor_list_all_data_loved_brands_scaled_code' name='federated.10zi8hj0anoft51bxei8u08xc653' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='3%' caption='Order Drop %' datatype='real' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='0.03'>
              <calculation class='tableau' formula='0.03' />
              <aliases>
                <alias key='0.01' value='1%' />
                <alias key='0.03' value='3%' />
                <alias key='0.05' value='5%' />
                <alias key='0.075' value='7.5%' />
                <alias key='0.1' value='10%' />
              </aliases>
            </column>
            <column alias='5%' caption='Avg DF Increase %' datatype='real' name='[Parameter 2]' param-domain-type='list' role='measure' type='quantitative' value='0.05'>
              <calculation class='tableau' formula='0.05' />
              <aliases>
                <alias key='0.05' value='5%' />
                <alias key='0.075' value='7.5%' />
                <alias key='0.1' value='10%' />
                <alias key='0.125' value='12.5%' />
                <alias key='0.15' value='15%' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.10zi8hj0anoft51bxei8u08xc653'>
            <column caption='Last Month DF Rev_Eur' datatype='real' name='[Calculation_2266436572591542273]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([asa_orders_after_lb_logic]) * AVG([avg_df_asa_eur])' />
            </column>
            <column caption='New DF Rev After Dilution_Eur' datatype='real' name='[Calculation_2266436572592480258]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// We assume a 3% loss in orders and a 5% increase in avg DF&#13;&#10;(AVG([asa_orders_after_lb_logic])*(1-[Parameters].[Parameter 1]))&#13;&#10;* (AVG([avg_df_asa_eur]) * (1 + [Parameters].[Parameter 2]))' />
            </column>
            <column caption='CumSum_Asa Order Share of Entity' datatype='real' name='[Calculation_2266436572626665488]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_SUM(AVG([asa_order_share_of_entity]), First(), 0)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='DF Rev Uplift After Dilution_Eur' datatype='real' name='[DF Rev Uplift After Dilution_Eur_LM (copy)_1925851815723769863]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2266436572592480258] - [Calculation_2266436572591542273]' />
            </column>
            <column caption='Asa Id' datatype='integer' name='[asa_id]' role='dimension' type='ordinal' />
            <column caption='Asa Order Share After All Initial Filters' datatype='real' default-format='p0.0%' name='[asa_order_share_after_all_initial_filters]' role='measure' type='quantitative' />
            <column caption='Asa Order Share After Visits And Orders Filters' datatype='real' default-format='p0.0%' name='[asa_order_share_after_visits_and_orders_filters]' role='measure' type='quantitative' />
            <column caption='Asa Order Share After Visits Filter' datatype='real' default-format='p0.0%' name='[asa_order_share_after_visits_filter]' role='measure' type='quantitative' />
            <column caption='Asa Order Share Of Entity' datatype='real' default-format='p0.0%' name='[asa_order_share_of_entity]' role='measure' type='quantitative' />
            <column datatype='integer' name='[asa_orders_after_lb_logic]' role='measure' type='quantitative' />
            <column-instance column='[asa_order_share_after_all_initial_filters]' derivation='Avg' name='[avg:asa_order_share_after_all_initial_filters:vtsum:qk]' pivot='key' type='quantitative' visual-totals='Sum' />
            <column-instance column='[asa_order_share_after_visits_and_orders_filters]' derivation='Avg' name='[avg:asa_order_share_after_visits_and_orders_filters:vtsum:qk]' pivot='key' type='quantitative' visual-totals='Sum' />
            <column-instance column='[asa_order_share_after_visits_filter]' derivation='Avg' name='[avg:asa_order_share_after_visits_filter:vtsum:qk]' pivot='key' type='quantitative' visual-totals='Sum' />
            <column-instance column='[asa_order_share_of_entity]' derivation='Avg' name='[avg:asa_order_share_of_entity:vtsum:qk]' pivot='key' type='quantitative' visual-totals='Sum' />
            <column-instance column='[avg_df_asa_eur]' derivation='Avg' name='[avg:avg_df_asa_eur:vtavg:qk]' pivot='key' type='quantitative' visual-totals='Avg' />
            <column caption='Avg Df Asa Eur' datatype='real' name='[avg_df_asa_eur]' role='measure' type='quantitative' />
            <column caption='Entity Id' datatype='string' name='[entity_id]' role='dimension' type='nominal' />
            <column-instance column='[update_timestamp]' derivation='MDY' name='[md:update_timestamp:ok]' pivot='key' type='ordinal' />
            <column-instance column='[asa_id]' derivation='None' name='[none:asa_id:ok]' pivot='key' type='ordinal' />
