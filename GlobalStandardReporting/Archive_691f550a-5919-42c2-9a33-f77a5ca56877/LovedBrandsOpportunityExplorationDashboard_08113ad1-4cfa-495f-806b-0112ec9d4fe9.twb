            <column-instance column='[vendor_count_remaining_after_lb_logic_lm]' derivation='Avg' name='[avg:vendor_count_remaining_after_lb_logic_lm:vtsum:qk]' pivot='key' type='quantitative' visual-totals='Sum' />
            <column-instance column='[vendor_count_remaining_after_visits_and_orders_filters]' derivation='Avg' name='[avg:vendor_count_remaining_after_visits_and_orders_filters:qk]' pivot='key' type='quantitative' />
