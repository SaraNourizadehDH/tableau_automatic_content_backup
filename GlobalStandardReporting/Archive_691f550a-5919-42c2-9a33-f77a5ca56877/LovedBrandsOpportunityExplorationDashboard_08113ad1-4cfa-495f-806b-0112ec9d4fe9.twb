      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='12'><![CDATA[<Sheet Name> (Uses the Linear Model Approach to Curate LBs)]]></run>
            <run>Æ&#10;</run>
            <run fontcolor='#e15759' fontsize='10' italic='true'>(Select particular bubbles to dynamically filter the tables below)</run>
            <run>Æ&#10;&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='final_vendor_list_all_data_loved_brands_scaled_code' name='federated.10zi8hj0anoft51bxei8u08xc653' />
          </datasources>
          <datasource-dependencies datasource='federated.10zi8hj0anoft51bxei8u08xc653'>
            <column caption='Quintile Legend_LM' datatype='string' name='[Calculation_2011420243979419652]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF AVG([asa_order_share_after_lb_logic_lm]) &lt;= WINDOW_PERCENTILE(AVG([asa_order_share_after_lb_logic_lm]), 0.2)&#13;&#10;THEN &apos;&lt;= 20th Ntile&apos;&#13;&#10;ELSEIF &#13;&#10;    AVG([asa_order_share_after_lb_logic_lm]) &gt; WINDOW_PERCENTILE(AVG([asa_order_share_after_lb_logic_lm]), 0.2) &#13;&#10;    AND&#13;&#10;    AVG([asa_order_share_after_lb_logic_lm]) &lt;= WINDOW_PERCENTILE(AVG([asa_order_share_after_lb_logic_lm]), 0.4)&#13;&#10;THEN &apos;&gt; 20th &amp; &lt;= 40th Ntile&apos;&#13;&#10;ELSEIF &#13;&#10;    AVG([asa_order_share_after_lb_logic_lm]) &gt; WINDOW_PERCENTILE(AVG([asa_order_share_after_lb_logic_lm]), 0.4) &#13;&#10;    AND&#13;&#10;    AVG([asa_order_share_after_lb_logic_lm]) &lt;= WINDOW_PERCENTILE(AVG([asa_order_share_after_lb_logic_lm]), 0.6)&#13;&#10;THEN &apos;&gt; 40th &amp; &lt;= 60th Ntile&apos;&#13;&#10;ELSEIF &#13;&#10;    AVG([asa_order_share_after_lb_logic_lm]) &gt; WINDOW_PERCENTILE(AVG([asa_order_share_after_lb_logic_lm]), 0.6) &#13;&#10;    AND&#13;&#10;    AVG([asa_order_share_after_lb_logic_lm]) &lt;= WINDOW_PERCENTILE(AVG([asa_order_share_after_lb_logic_lm]), 0.8)&#13;&#10;THEN &apos;&gt; 60th &amp; &lt;= 80th Ntile&apos;&#13;&#10;ELSEIF &#13;&#10;    AVG([asa_order_share_after_lb_logic_lm]) &gt; WINDOW_PERCENTILE(AVG([asa_order_share_after_lb_logic_lm]), 0.8) &#13;&#10;    AND&#13;&#10;    AVG([asa_order_share_after_lb_logic_lm]) &lt;= WINDOW_PERCENTILE(AVG([asa_order_share_after_lb_logic_lm]), 1)&#13;&#10;THEN &apos;&gt; 80th &amp; &lt;= 100th Ntile&apos;&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Asa Id' datatype='integer' name='[asa_id]' role='dimension' type='ordinal' />
            <column datatype='real' default-format='p0.0%' name='[asa_order_share_after_lb_logic_lm]' role='measure' type='quantitative' />
