    <worksheet name='LBs/NLBs Order Share Within ASA Combo'>
      <layout-options>
        <title>
          <formatted-text>
            <run>&lt;Sheet Name&gt;&#10;</run>
            <run bold='true' fontcolor='#ff0000' fontsize='8' italic='true'>N.B. </run>
            <run fontcolor='#ff0000' fontsize='8' italic='true'>The bars on the left-hand side show the LB/NLB </run>
            <run bold='true' fontcolor='#ff0000' fontsize='8' italic='true' underline='true'>order share</run>
            <run fontcolor='#ff0000' fontsize='8' italic='true'> of non-clustered ASAs (i.e., ASAs that do </run>
            <run bold='true' fontcolor='#ff0000' fontsize='8' italic='true'>NOT</run>
            <run fontcolor='#ff0000' fontsize='8' italic='true'> have live LB setups). The bars on the right-hand side show the LB/NLB </run>
            <run bold='true' fontcolor='#ff0000' fontsize='8' italic='true' underline='true'>order share</run>
            <run fontcolor='#ff0000' fontsize='8' italic='true'> of clustered ASAs (i.e., ASAs that have live LB setups).</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#ff0000' fontsize='8' italic='true'>One would read the chart on the </run>
            <run bold='true' fontcolor='#ff0000' fontsize='8' italic='true' underline='true'>left-hand side</run>
            <run bold='true' fontcolor='#ff0000' fontsize='8' italic='true'> as follows: </run>
            <run fontcolor='#ff0000' fontsize='8' italic='true'>The </run>
            <run bold='true' fontcolor='#ff0000' fontsize='8' italic='true'>Loved Brands</run>
