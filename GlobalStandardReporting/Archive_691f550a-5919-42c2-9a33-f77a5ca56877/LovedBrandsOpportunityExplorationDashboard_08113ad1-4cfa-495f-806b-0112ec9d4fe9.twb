      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.10zi8hj0anoft51bxei8u08xc653].[avg:asa_order_share_after_all_initial_filters:vtsum:qk]&quot;' value='~ After All Initial Filters' />
          <alias key='&quot;[federated.10zi8hj0anoft51bxei8u08xc653].[avg:asa_order_share_after_lb_logic (final_vendor_list_all_data_loved_brands_scaled_code):vtsum:qk]&quot;' value='~ After LB Logic' />
          <alias key='&quot;[federated.10zi8hj0anoft51bxei8u08xc653].[avg:asa_order_share_after_lb_logic_lm:vtsum:qk]&quot;' value='~ After LB Logic_LM' />
          <alias key='&quot;[federated.10zi8hj0anoft51bxei8u08xc653].[avg:asa_order_share_after_visits_and_orders_filters:vtsum:qk]&quot;' value='~ After Visits and Orders Filters' />
          <alias key='&quot;[federated.10zi8hj0anoft51bxei8u08xc653].[avg:asa_order_share_after_visits_filter:vtsum:qk]&quot;' value='~ After Visits Filter' />
          <alias key='&quot;[federated.10zi8hj0anoft51bxei8u08xc653].[avg:asa_order_share_of_entity:vtsum:qk]&quot;' value='ASA Order Share Of Entity' />
          <alias key='&quot;[federated.10zi8hj0anoft51bxei8u08xc653].[avg:asa_orders_after_lb_logic (final_vendor_list_all_data_loved_brands_scaled_code):vtsum:qk]&quot;' value='ASA Orders After LB Logic' />
          <alias key='&quot;[federated.10zi8hj0anoft51bxei8u08xc653].[avg:asa_orders_after_lb_logic_lm:vtsum:qk]&quot;' value='ASA Orders After LB Logic_LM' />
          <alias key='&quot;[federated.10zi8hj0anoft51bxei8u08xc653].[avg:avg_df_asa_eur:vtavg:qk]&quot;' value='Avg DF ASA_Eur' />
          <alias key='&quot;[federated.10zi8hj0anoft51bxei8u08xc653].[avg:vendor_count_caught_by_asa:vtsum:qk]&quot;' value='Vendor Count Caught By ASA' />
          <alias key='&quot;[federated.10zi8hj0anoft51bxei8u08xc653].[avg:vendor_count_remaining_after_all_initial_filters:vtsum:qk]&quot;' value='// After All Initial Filters' />
          <alias key='&quot;[federated.10zi8hj0anoft51bxei8u08xc653].[avg:vendor_count_remaining_after_lb_logic_lm:vtsum:qk]&quot;' value='// After LB Logic_LM' />
          <alias key='&quot;[federated.10zi8hj0anoft51bxei8u08xc653].[avg:vendor_count_remaining_after_visits_and_orders_filters:vtsum:qk]&quot;' value='// After Visits and Orders Filters' />
          <alias key='&quot;[federated.10zi8hj0anoft51bxei8u08xc653].[avg:vendor_count_remaining_after_visits_filter:vtsum:qk]&quot;' value='// After Visits Filter' />
          <alias key='&quot;[federated.10zi8hj0anoft51bxei8u08xc653].[usr:Calculation_2266436572626665488:vtnone:qk]&quot;' value='CumSum_Previous Col' />
        </aliases>
      </column>
      <column caption='Quintile Legend_LM' datatype='string' name='[Calculation_2011420243979419652]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF AVG([asa_order_share_after_lb_logic_lm]) &lt;= WINDOW_PERCENTILE(AVG([asa_order_share_after_lb_logic_lm]), 0.2)&#13;&#10;THEN &apos;&lt;= 20th Ntile&apos;&#13;&#10;ELSEIF &#13;&#10;    AVG([asa_order_share_after_lb_logic_lm]) &gt; WINDOW_PERCENTILE(AVG([asa_order_share_after_lb_logic_lm]), 0.2) &#13;&#10;    AND&#13;&#10;    AVG([asa_order_share_after_lb_logic_lm]) &lt;= WINDOW_PERCENTILE(AVG([asa_order_share_after_lb_logic_lm]), 0.4)&#13;&#10;THEN &apos;&gt; 20th &amp; &lt;= 40th Ntile&apos;&#13;&#10;ELSEIF &#13;&#10;    AVG([asa_order_share_after_lb_logic_lm]) &gt; WINDOW_PERCENTILE(AVG([asa_order_share_after_lb_logic_lm]), 0.4) &#13;&#10;    AND&#13;&#10;    AVG([asa_order_share_after_lb_logic_lm]) &lt;= WINDOW_PERCENTILE(AVG([asa_order_share_after_lb_logic_lm]), 0.6)&#13;&#10;THEN &apos;&gt; 40th &amp; &lt;= 60th Ntile&apos;&#13;&#10;ELSEIF &#13;&#10;    AVG([asa_order_share_after_lb_logic_lm]) &gt; WINDOW_PERCENTILE(AVG([asa_order_share_after_lb_logic_lm]), 0.6) &#13;&#10;    AND&#13;&#10;    AVG([asa_order_share_after_lb_logic_lm]) &lt;= WINDOW_PERCENTILE(AVG([asa_order_share_after_lb_logic_lm]), 0.8)&#13;&#10;THEN &apos;&gt; 60th &amp; &lt;= 80th Ntile&apos;&#13;&#10;ELSEIF &#13;&#10;    AVG([asa_order_share_after_lb_logic_lm]) &gt; WINDOW_PERCENTILE(AVG([asa_order_share_after_lb_logic_lm]), 0.8) &#13;&#10;    AND&#13;&#10;    AVG([asa_order_share_after_lb_logic_lm]) &lt;= WINDOW_PERCENTILE(AVG([asa_order_share_after_lb_logic_lm]), 1)&#13;&#10;THEN &apos;&gt; 80th &amp; &lt;= 100th Ntile&apos;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Last Month DF Rev_Eur' datatype='real' name='[Calculation_2266436572591542273]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([asa_orders_after_lb_logic]) * AVG([avg_df_asa_eur])' />
      </column>
      <column caption='New DF Rev After Dilution_Eur' datatype='real' name='[Calculation_2266436572592480258]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// We assume a 3% loss in orders and a 5% increase in avg DF&#13;&#10;(AVG([asa_orders_after_lb_logic])*(1-[Parameters].[Parameter 1]))&#13;&#10;* (AVG([avg_df_asa_eur]) * (1 + [Parameters].[Parameter 2]))' />
      </column>
      <column caption='DF Rev Uplift After Dilution_Eur_LM' datatype='real' name='[Calculation_2266436572593467396]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[New DF Rev After Dilution_Eur (copy)_1925851815723102213] - [Last Month DF Rev_Eur (copy)_1925851815723180038]' />
      </column>
      <column caption='CumSum_Asa Order Share of Entity' datatype='real' name='[Calculation_2266436572626665488]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_SUM(AVG([asa_order_share_of_entity]), First(), 0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='DF Rev Uplift After Dilution_Eur' datatype='real' name='[DF Rev Uplift After Dilution_Eur_LM (copy)_1925851815723769863]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2266436572592480258] - [Calculation_2266436572591542273]' />
      </column>
      <column caption='Last Month DF Rev_Eur_LM' datatype='real' name='[Last Month DF Rev_Eur (copy)_1925851815723180038]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([asa_orders_after_lb_logic_lm]) * AVG([avg_df_asa_eur])' />
      </column>
      <column caption='New DF Rev After Dilution_Eur_LM' datatype='real' name='[New DF Rev After Dilution_Eur (copy)_1925851815723102213]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// We assume a 3% loss in orders and a 5% increase in avg DF&#13;&#10;(AVG([asa_orders_after_lb_logic_lm])*(1-[Parameters].[Parameter 1]))&#13;&#10;* (AVG([avg_df_asa_eur]) * (1 + [Parameters].[Parameter 2]))' />
      </column>
      <column caption='Quintile Legend' datatype='string' name='[Quintile Legend_LM (copy)_1925851815722524673]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF AVG([asa_order_share_after_lb_logic]) &lt;= WINDOW_PERCENTILE(AVG([asa_order_share_after_lb_logic]), 0.2)&#13;&#10;THEN &apos;&lt;= 20th Ntile&apos;&#13;&#10;ELSEIF &#13;&#10;    AVG([asa_order_share_after_lb_logic]) &gt; WINDOW_PERCENTILE(AVG([asa_order_share_after_lb_logic]), 0.2) &#13;&#10;    AND&#13;&#10;    AVG([asa_order_share_after_lb_logic]) &lt;= WINDOW_PERCENTILE(AVG([asa_order_share_after_lb_logic]), 0.4)&#13;&#10;THEN &apos;&gt; 20th &amp; &lt;= 40th Ntile&apos;&#13;&#10;ELSEIF &#13;&#10;    AVG([asa_order_share_after_lb_logic]) &gt; WINDOW_PERCENTILE(AVG([asa_order_share_after_lb_logic]), 0.4) &#13;&#10;    AND&#13;&#10;    AVG([asa_order_share_after_lb_logic]) &lt;= WINDOW_PERCENTILE(AVG([asa_order_share_after_lb_logic]), 0.6)&#13;&#10;THEN &apos;&gt; 40th &amp; &lt;= 60th Ntile&apos;&#13;&#10;ELSEIF &#13;&#10;    AVG([asa_order_share_after_lb_logic]) &gt; WINDOW_PERCENTILE(AVG([asa_order_share_after_lb_logic]), 0.6) &#13;&#10;    AND&#13;&#10;    AVG([asa_order_share_after_lb_logic]) &lt;= WINDOW_PERCENTILE(AVG([asa_order_share_after_lb_logic]), 0.8)&#13;&#10;THEN &apos;&gt; 60th &amp; &lt;= 80th Ntile&apos;&#13;&#10;ELSEIF &#13;&#10;    AVG([asa_order_share_after_lb_logic]) &gt; WINDOW_PERCENTILE(AVG([asa_order_share_after_lb_logic]), 0.8) &#13;&#10;    AND&#13;&#10;    AVG([asa_order_share_after_lb_logic]) &lt;= WINDOW_PERCENTILE(AVG([asa_order_share_after_lb_logic]), 1)&#13;&#10;THEN &apos;&gt; 80th &amp; &lt;= 100th Ntile&apos;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
