            <column caption='Quintile Legend' datatype='string' name='[Quintile Legend_LM (copy)_1925851815722524673]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF AVG([asa_order_share_after_lb_logic]) &lt;= WINDOW_PERCENTILE(AVG([asa_order_share_after_lb_logic]), 0.2)&#13;&#10;THEN &apos;&lt;= 20th Ntile&apos;&#13;&#10;ELSEIF &#13;&#10;    AVG([asa_order_share_after_lb_logic]) &gt; WINDOW_PERCENTILE(AVG([asa_order_share_after_lb_logic]), 0.2) &#13;&#10;    AND&#13;&#10;    AVG([asa_order_share_after_lb_logic]) &lt;= WINDOW_PERCENTILE(AVG([asa_order_share_after_lb_logic]), 0.4)&#13;&#10;THEN &apos;&gt; 20th &amp; &lt;= 40th Ntile&apos;&#13;&#10;ELSEIF &#13;&#10;    AVG([asa_order_share_after_lb_logic]) &gt; WINDOW_PERCENTILE(AVG([asa_order_share_after_lb_logic]), 0.4) &#13;&#10;    AND&#13;&#10;    AVG([asa_order_share_after_lb_logic]) &lt;= WINDOW_PERCENTILE(AVG([asa_order_share_after_lb_logic]), 0.6)&#13;&#10;THEN &apos;&gt; 40th &amp; &lt;= 60th Ntile&apos;&#13;&#10;ELSEIF &#13;&#10;    AVG([asa_order_share_after_lb_logic]) &gt; WINDOW_PERCENTILE(AVG([asa_order_share_after_lb_logic]), 0.6) &#13;&#10;    AND&#13;&#10;    AVG([asa_order_share_after_lb_logic]) &lt;= WINDOW_PERCENTILE(AVG([asa_order_share_after_lb_logic]), 0.8)&#13;&#10;THEN &apos;&gt; 60th &amp; &lt;= 80th Ntile&apos;&#13;&#10;ELSEIF &#13;&#10;    AVG([asa_order_share_after_lb_logic]) &gt; WINDOW_PERCENTILE(AVG([asa_order_share_after_lb_logic]), 0.8) &#13;&#10;    AND&#13;&#10;    AVG([asa_order_share_after_lb_logic]) &lt;= WINDOW_PERCENTILE(AVG([asa_order_share_after_lb_logic]), 1)&#13;&#10;THEN &apos;&gt; 80th &amp; &lt;= 100th Ntile&apos;&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
