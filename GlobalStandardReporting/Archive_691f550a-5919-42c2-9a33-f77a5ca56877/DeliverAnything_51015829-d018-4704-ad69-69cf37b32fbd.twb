    <dashboard name='Glossary'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/DeliverAnything/Glossary?rev=' id='Glossary' path='/t/GlobalStandardReporting/workbooks/DeliverAnything' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='400' maxwidth='1000' minheight='400' minwidth='1000' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='85471' id='3' type-v2='text' w='98400' x='800' y='12529'>
            <formatted-text>
              <run bold='true' fontalignment='1' fontcolor='#333333' fontsize='15'>GLOSSARY</run>
              <run fontalignment='1'>Æ&#10;&#10;</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#333333' fontsize='12'>Successful orders</run>
              <run fontcolor='#333333' fontsize='12'>: delivered orders</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#333333' fontsize='12'>Active Vendors: </run>
              <run fontcolor='#333333' fontsize='12'>vendors that placed at least one succesful order in the time period</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#333333' fontsize='12'>AVG Delivery fee incl. VAT: </run>
              <run fontcolor='#333333' fontsize='12'>delivery fee for succesful orders including taxes (VAT)</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#333333' fontsize='12'>AVG Delivery fee excl. VAT: </run>
              <run fontcolor='#333333' fontsize='12'>delivery fee for succesful orders excluding taxes (VAT)</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#333333' fontsize='12'>Revenue</run>
              <run fontcolor='#333333' fontsize='12'>:  Sum of delivery fee of Successful Orders</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#333333' fontsize='12'>Gross Profit: </run>
              <run fontcolor='#333333' fontsize='12'>Revenue - Delivery costs</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#333333' fontsize='12'>Penetration - Platform: </run>
              <run fontcolor='#333333' fontsize='12'>DA</run>
              <run bold='true' fontcolor='#333333' fontsize='12'>Æ </run>
              <run fontcolor='#333333' fontsize='12'>Succesful orders over Platform successful orders</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#333333' fontsize='12'>Penetration - Qcommerce: </run>
              <run fontcolor='#333333' fontsize='12'>DA</run>
              <run bold='true' fontcolor='#333333' fontsize='12'>Æ </run>
              <run fontcolor='#333333' fontsize='12'>Successful orders over  Qcommerce successful orders</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#333333' fontsize='12'>Fail Rate: </run>
              <run fontcolor='#333333' fontsize='12'>Failed orders over Total orders (successful and not) </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#333333' fontsize='12'>AVG Delivery Time (min): </run>
              <run fontcolor='#333333' fontsize='12'>Average delivery time in Minutes of DA successful orders</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#333333' fontsize='12'>AVG Delivery Time Platform (min): </run>
              <run fontcolor='#333333' fontsize='12'>Average delivery time in Minutes of successful orders from Platform</run>
              <run>Æ&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone h='10529' id='21' name='title' show-title='false' w='98400' x='800' y='2000'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
