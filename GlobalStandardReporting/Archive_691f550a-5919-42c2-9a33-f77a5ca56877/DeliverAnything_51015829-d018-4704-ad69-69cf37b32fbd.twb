            <column caption='Revenue ' datatype='real' name='[Calculation_1955054871563100160]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;EUR&apos; THEN SUM([revenue_eur]) &#10;ELSE SUM([revenue_lc])&#10;END' />
            </column>
            <column caption='KPI selector' datatype='real' name='[Calculation_1955054871841861639]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;Successful Orders&apos; THEN SUM([successful_orders])&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Active Vendors&apos; THEN SUM([active_vendors])&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Revenue&apos; THEN [Calculation_1955054871563100160] &#10;ELSEIF [Parameters].[Parameter 2] = &apos;Gross Profit&apos; THEN [Gross Profit (copy)_1955054871571632134]&#10;ELSE NULL END' />
            </column>
            <column caption='Gross Profit' datatype='real' name='[Gross Profit (copy)_1955054871571632134]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;EUR&apos; THEN &#10;&#10;SUM([gross_profit_eur])&#10;&#10;ELSE SUM([gross_profit_lc])&#10;&#10;END' />
            </column>
