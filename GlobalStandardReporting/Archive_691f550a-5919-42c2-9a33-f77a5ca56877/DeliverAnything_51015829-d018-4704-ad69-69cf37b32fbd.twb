      <aliases enabled='yes' />
      <column caption='AVG Delivery Time - Platform (min)' datatype='real' name='[AVG Delivery Time (min) (copy)_1955054871564226562]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([eff_delivery_time_m_platform]) / SUM([successful_orders_platform])' />
      </column>
      <column caption='AVG delivery fee excl. VAT' datatype='real' name='[AVG delivery fee (copy)_3063292210837377024]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;EUR&apos; THEN SUM([delivery_fee_eur_wo_vat]) / SUM([successful_orders])&#10;ELSE SUM([delivery_fee_lc_wo_vat])/ SUM([successful_orders])  END' />
      </column>
      <column caption='Revenue ' datatype='real' name='[Calculation_1955054871563100160]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;EUR&apos; THEN SUM([revenue_eur]) &#10;ELSE SUM([revenue_lc])&#10;END' />
      </column>
      <column caption='AVG Delivery Time (min)' datatype='real' name='[Calculation_1955054871563882497]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([eff_delivery_time_m]) / SUM([successful_orders])' />
      </column>
      <column caption='AVG GPO' datatype='real' name='[Calculation_1955054871566286851]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;EUR&apos; THEN &#10;&#10;SUM([gross_profit_eur]) / SUM([successful_orders])&#10;&#10;ELSE SUM([gross_profit_lc]) / SUM([successful_orders])&#10;&#10;END' />
      </column>
      <column caption='KPI selector' datatype='real' name='[Calculation_1955054871841861639]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;Successful Orders&apos; THEN SUM([successful_orders])&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Active Vendors&apos; THEN SUM([active_vendors])&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Revenue&apos; THEN [Calculation_1955054871563100160] &#10;ELSEIF [Parameters].[Parameter 2] = &apos;Gross Profit&apos; THEN [Gross Profit (copy)_1955054871571632134]&#10;ELSE NULL END' />
      </column>
      <column caption='Fail Rate' datatype='real' name='[Calculation_3063292210857504769]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([failed_orders]) / SUM([total_orders])' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_360569446126108672]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]=USERNAME()' />
      </column>
      <column caption='GMV' datatype='real' name='[Calculation_5008354666187812865]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;EUR&apos; THEN [gmv_eur] ELSE [gmv_lc] END' />
      </column>
      <column caption='Penetration - Platform' datatype='real' name='[Calculation_5008354666894663686]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([successful_orders]) / SUM([Successful orders Qcommerce FIXED (copy)_5008354668615737356])' />
      </column>
      <column caption='Successful orders Qcommerce FIXED' datatype='integer' name='[Calculation_5008354666921598985]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [city] ,[time_period]: SUM([successful_orders_qcommerce])}' />
      </column>
      <column caption='report title' datatype='string' name='[Calculation_5008354666926829578]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;DELIVER ANYTHING REPORT&quot;' />
      </column>
      <column caption='AVG delivery fee incl. VAT' datatype='real' name='[GMV (copy)_5008354666188472322]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;EUR&apos; THEN SUM([delivery_fee_eur]) / SUM([successful_orders])&#10;ELSE SUM([delivery_fee_lc])/ SUM([successful_orders])  END' />
      </column>
      <column caption='Gross Profit' datatype='real' name='[Gross Profit (copy)_1955054871571632134]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;EUR&apos; THEN &#10;&#10;SUM([gross_profit_eur])&#10;&#10;ELSE SUM([gross_profit_lc])&#10;&#10;END' />
      </column>
      <column caption='Penetration - Qcommerce' datatype='real' name='[Penetration - Platform (copy)_5008354666895048711]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([successful_orders]) / SUM([Calculation_5008354666921598985])' />
      </column>
      <column caption='Successful orders Platform FIXED' datatype='integer' name='[Successful orders Qcommerce FIXED (copy)_5008354668615737356]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [city] ,[time_period]: SUM([successful_orders_platform])}' />
      </column>
