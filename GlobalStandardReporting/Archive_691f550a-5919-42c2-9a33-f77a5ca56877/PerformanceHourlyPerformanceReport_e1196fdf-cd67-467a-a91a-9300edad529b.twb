      <aliases enabled='yes' />
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_1257348721933115392]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]=USERNAME()' />
      </column>
      <column caption='AVG Picking Minutes' datatype='real' name='[Calculation_2152650276656009220]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_5255841560794447872]) / SUM([orders_with_picking_times])' />
      </column>
      <column caption='Calculation1' datatype='integer' name='[Calculation_2152650276657676293]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEPART(&apos;weekday&apos;,[order_date],&apos;monday&apos;)' />
      </column>
      <column caption='AOV' datatype='real' name='[Calculation_2861193161861439488]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([amt_gmv_eur]) / SUM([orders])' />
      </column>
      <column caption='Items per Order' datatype='real' name='[Calculation_2861193161861484545]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([items_sold]) / SUM([orders])' />
      </column>
      <column caption='KPI 1' datatype='real' default-format='N' name='[Calculation_497084855893405697]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Orders&apos;                                   THEN SUM([orders])&#13;&#10;WHEN &apos;Items Sold&apos;                               THEN SUM([items_sold])&#13;&#10;WHEN &apos;Amt GMV&apos;                                  THEN ROUND(SUM([amt_gmv_eur]))&#10;WHEN &apos;Failed Orders&apos;                            THEN SUM([failed_orders])&#10;WHEN &apos;Failed Orders before Transmission&apos;        THEN SUM([failed_orders_before_transmission])&#10;WHEN &apos;Failed Orders after Transmission&apos;         THEN SUM([failed_orders_after_transmission])&#10;WHEN &apos;AVG Picking Minutes&apos;                      THEN ROUND(SUM([Calculation_5255841560794447872])/SUM([orders_with_picking_times]), 2)&#10;WHEN &apos;Items sold per Order&apos;                     THEN ROUND([Calculation_2861193161861484545], 2)&#10;WHEN &apos;AOV&apos;                                      THEN ROUND([Calculation_2861193161861439488], 2)&#13;&#10;END' />
      </column>
      <column caption='Picking Time Minutes' datatype='real' name='[Calculation_5255841560794447872]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[seconds_picking_time]/60' />
      </column>
      <column caption='Date (original) (copy)' datatype='date' name='[Date (copy)_1188950325802815490]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[order_date]' />
      </column>
      <column caption='Hour Interval' datatype='integer' name='[Hour (copy)]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='[order_hour]' />
      </column>
      <column datatype='string' name='[Hour (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[order_hour]' new-bin='true'>
          <bin default-name='false' value='&quot;0-10&quot;'>
            <value>0</value>
            <value>1</value>
            <value>2</value>
            <value>3</value>
            <value>4</value>
            <value>5</value>
            <value>6</value>
            <value>7</value>
            <value>8</value>
            <value>9</value>
            <value>10</value>
          </bin>
          <bin default-name='false' value='&quot;11-14&quot;'>
            <value>11</value>
            <value>12</value>
            <value>13</value>
            <value>14</value>
          </bin>
          <bin default-name='false' value='&quot;15-18&quot;'>
            <value>15</value>
            <value>16</value>
            <value>17</value>
            <value>18</value>
          </bin>
          <bin default-name='false' value='&quot;19-23&quot;'>
            <value>19</value>
            <value>20</value>
            <value>21</value>
            <value>22</value>
            <value>23</value>
          </bin>
        </calculation>
      </column>
      <column caption='KPI 2' datatype='real' default-format='N' name='[KPI (copy)_2152650276652883970]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[KPI Switcher (copy)_2152650276652920835]&#10;WHEN &apos;Orders&apos;                                   THEN SUM([orders])&#13;&#10;WHEN &apos;Items Sold&apos;                               THEN SUM([items_sold])&#13;&#10;WHEN &apos;Amt GMV&apos;                                  THEN ROUND(SUM([amt_gmv_eur]))&#10;WHEN &apos;Failed Orders&apos;                            THEN INT(SUM([failed_orders]))&#10;WHEN &apos;Failed Orders before Transmission&apos;        THEN INT(SUM([failed_orders_before_transmission]))&#10;WHEN &apos;Failed Orders after Transmission&apos;         THEN INT(SUM([failed_orders_after_transmission]))&#10;WHEN &apos;AVG Picking Minutes&apos;                      THEN ROUND(SUM([Calculation_5255841560794447872])/SUM([orders_with_picking_times]), 2)&#10;WHEN &apos;Items sold per Order&apos;                     THEN ROUND([Calculation_2861193161861484545], 2)&#10;WHEN &apos;AOV&apos;                                      THEN ROUND([Calculation_2861193161861439488], 2)&#13;&#10;END' />
      </column>
      <column datatype='string' name='[WeekDay]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[Calculation_2152650276657676293]' new-bin='true'>
          <bin default-name='false' value='&quot;Friday&quot;'>
            <value>5</value>
          </bin>
          <bin default-name='false' value='&quot;Monday&quot;'>
            <value>1</value>
