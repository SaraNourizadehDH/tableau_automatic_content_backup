  <worksheets>
    <worksheet name='Hourly Comparison Sheet'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#ffffff'>Hourly </run>
            <run bold='true' fontalignment='1' fontcolor='#ffffff'>&lt;[Parameters].[Parameter 1]&gt;</run>
            <run fontalignment='1' fontcolor='#ffffff'> Analysis</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='rl_dmart' name='federated.0mjybiv06rvkxs193bqbo18svm08' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='KPI Switcher - 1' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Orders&quot;'>
              <calculation class='tableau' formula='&quot;Orders&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0mjybiv06rvkxs193bqbo18svm08'>
            <column caption='Calculation1' datatype='integer' name='[Calculation_2152650276657676293]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEPART(&apos;weekday&apos;,[order_date],&apos;monday&apos;)' />
            </column>
            <column caption='AOV' datatype='real' name='[Calculation_2861193161861439488]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([amt_gmv_eur]) / SUM([orders])' />
            </column>
            <column caption='Items per Order' datatype='real' name='[Calculation_2861193161861484545]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([items_sold]) / SUM([orders])' />
            </column>
            <column caption='KPI 1' datatype='real' default-format='N' name='[Calculation_497084855893405697]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Orders&apos;                                   THEN SUM([orders])&#13;&#10;WHEN &apos;Items Sold&apos;                               THEN SUM([items_sold])&#13;&#10;WHEN &apos;Amt GMV&apos;                                  THEN ROUND(SUM([amt_gmv_eur]))&#10;WHEN &apos;Failed Orders&apos;                            THEN SUM([failed_orders])&#10;WHEN &apos;Failed Orders before Transmission&apos;        THEN SUM([failed_orders_before_transmission])&#10;WHEN &apos;Failed Orders after Transmission&apos;         THEN SUM([failed_orders_after_transmission])&#10;WHEN &apos;AVG Picking Minutes&apos;                      THEN ROUND(SUM([Calculation_5255841560794447872])/SUM([orders_with_picking_times]), 2)&#10;WHEN &apos;Items sold per Order&apos;                     THEN ROUND([Calculation_2861193161861484545], 2)&#10;WHEN &apos;AOV&apos;                                      THEN ROUND([Calculation_2861193161861439488], 2)&#13;&#10;END' />
            </column>
            <column caption='Picking Time Minutes' datatype='real' name='[Calculation_5255841560794447872]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[seconds_picking_time]/60' />
            </column>
            <column datatype='string' name='[WeekDay]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[Calculation_2152650276657676293]' new-bin='true'>
                <bin default-name='false' value='&quot;Friday&quot;'>
                  <value>5</value>
                </bin>
                <bin default-name='false' value='&quot;Monday&quot;'>
                  <value>1</value>
                </bin>
                <bin default-name='false' value='&quot;Saturday&quot;'>
                  <value>6</value>
                </bin>
                <bin default-name='false' value='&quot;Sunday&quot;'>
                  <value>7</value>
                </bin>
                <bin default-name='false' value='&quot;Thursday&quot;'>
                  <value>4</value>
                </bin>
                <bin default-name='false' value='&quot;Tuesday&quot;'>
                  <value>2</value>
                </bin>
                <bin default-name='false' value='&quot;Wednesday&quot;'>
                  <value>3</value>
                </bin>
              </calculation>
            </column>
            <column datatype='real' name='[amt_gmv_eur]' role='measure' type='quantitative' />
            <column caption='Common Name' datatype='string' name='[common_name]' role='dimension' type='nominal' />
            <column caption='Display Name' datatype='string' name='[display_name]' role='dimension' type='nominal' />
            <column datatype='integer' name='[failed_orders]' role='measure' type='quantitative' />
            <column datatype='integer' name='[failed_orders_after_transmission]' role='measure' type='quantitative' />
            <column datatype='integer' name='[failed_orders_before_transmission]' role='measure' type='quantitative' />
            <column datatype='integer' name='[items_sold]' role='measure' type='quantitative' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column-instance column='[common_name]' derivation='None' name='[none:common_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[display_name]' derivation='None' name='[none:display_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[management_entity]' derivation='None' name='[none:management_entity:nk]' pivot='key' type='nominal' />
            <column-instance column='[order_date]' derivation='None' name='[none:order_date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[order_date]' derivation='None' name='[none:order_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[order_hour]' derivation='None' name='[none:order_hour:ok]' pivot='key' type='ordinal' />
            <column-instance column='[warehouse_name]' derivation='None' name='[none:warehouse_name:nk]' pivot='key' type='nominal' />
            <column caption='Date' datatype='date' name='[order_date]' role='dimension' type='ordinal' />
            <column aggregation='Sum' caption='Hour' datatype='integer' name='[order_hour]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[orders]' role='measure' type='quantitative' />
            <column datatype='integer' name='[orders_with_picking_times]' role='measure' type='quantitative' />
            <column datatype='real' name='[seconds_picking_time]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_497084855893405697]' derivation='User' name='[usr:Calculation_497084855893405697:qk]' pivot='key' type='quantitative' />
            <column caption='Store' datatype='string' name='[warehouse_name]' role='dimension' type='nominal' />
