              <calculation class='tableau' formula='&quot;Orders&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0mjybiv06rvkxs193bqbo18svm08'>
            <column caption='AVG Picking Minutes' datatype='real' name='[Calculation_2152650276656009220]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_5255841560794447872]) / SUM([orders_with_picking_times])' />
            </column>
            <column caption='AOV' datatype='real' name='[Calculation_2861193161861439488]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([amt_gmv_eur]) / SUM([orders])' />
            </column>
            <column caption='Items per Order' datatype='real' name='[Calculation_2861193161861484545]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([items_sold]) / SUM([orders])' />
            </column>
            <column caption='KPI 1' datatype='real' default-format='N' name='[Calculation_497084855893405697]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Orders&apos;                                   THEN SUM([orders])&#13;&#10;WHEN &apos;Items Sold&apos;                               THEN SUM([items_sold])&#13;&#10;WHEN &apos;Amt GMV&apos;                                  THEN ROUND(SUM([amt_gmv_eur]))&#10;WHEN &apos;Failed Orders&apos;                            THEN SUM([failed_orders])&#10;WHEN &apos;Failed Orders before Transmission&apos;        THEN SUM([failed_orders_before_transmission])&#10;WHEN &apos;Failed Orders after Transmission&apos;         THEN SUM([failed_orders_after_transmission])&#10;WHEN &apos;AVG Picking Minutes&apos;                      THEN ROUND(SUM([Calculation_5255841560794447872])/SUM([orders_with_picking_times]), 2)&#10;WHEN &apos;Items sold per Order&apos;                     THEN ROUND([Calculation_2861193161861484545], 2)&#10;WHEN &apos;AOV&apos;                                      THEN ROUND([Calculation_2861193161861439488], 2)&#13;&#10;END' />
            </column>
            <column caption='Picking Time Minutes' datatype='real' name='[Calculation_5255841560794447872]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[seconds_picking_time]/60' />
            </column>
            <column caption='Hour Interval' datatype='integer' name='[Hour (copy)]' role='dimension' type='quantitative'>
