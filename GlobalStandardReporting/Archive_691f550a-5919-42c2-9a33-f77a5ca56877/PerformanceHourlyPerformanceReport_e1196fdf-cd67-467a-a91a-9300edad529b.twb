              <table-calc ordering-type='Rows' type='PctTotal' />
            </column-instance>
            <column datatype='real' name='[seconds_picking_time]' role='measure' type='quantitative' />
            <column-instance column='[KPI (copy)_2152650276652883970]' derivation='User' name='[usr:KPI (copy)_2152650276652883970:qk]' pivot='key' type='quantitative' />
            <column caption='Store' datatype='string' name='[warehouse_name]' role='dimension' type='nominal' />
          </datasource-dependencies>
