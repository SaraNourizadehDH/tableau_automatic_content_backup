  <worksheets>
    <worksheet name='CCR on Agent Level'>
      <table>
        <view>
          <datasources>
            <datasource caption='contact_reason_agent_report' name='federated.1crx6vq1udqfsi14qxbr00xfdjd8' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Weekly' caption='Chose Dimension (D/W/M)' datatype='string' name='[Chose Dimension (Columns) (copy)_526358231437660160]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
              <aliases>
                <alias key='&quot;Date&quot;' value='Daily' />
                <alias key='&quot;Month&quot;' value='Monthly' />
                <alias key='&quot;Week&quot;' value='Weekly' />
              </aliases>
            </column>
            <column caption='KPIs (Agents)' datatype='string' name='[KPIs (copy)_1264385618995630081]' param-domain-type='list' role='measure' type='nominal' value='&quot;\# Resolved Cases&quot;'>
              <calculation class='tableau' formula='&quot;# Resolved Cases&quot;' />
              <aliases>
                <alias key='&quot;Avg. Full Resolution Time&quot;' value='Avg. Full Resolution Time (h)' />
                <alias key='&quot;QA Score&quot;' value='QA Score (In percentage)' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1crx6vq1udqfsi14qxbr00xfdjd8'>
            <column caption='Chat AHT (m)' datatype='real' name='[Calculation_1194016888929374213]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(&#10;    CASE [channel] WHEN &apos;Chat&apos; THEN [handling_time_secs]&#10;    ELSE 0 END &#10;   )&#10;/&#10;SUM(&#10;    CASE [channel] WHEN &apos;Chat&apos; THEN [resolved_contact_ind]&#10;    ELSE 0 END &#10;   )&#10;)/60' />
            </column>
            <column caption='Avg. Full Resolution Time (h)' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1515179817555480578]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([full_resolution_time_min])&#10;&#10; / SUM([resolved_contact_ind])/60' />
            </column>
            <column caption='KPIs' datatype='real' name='[Calculation_201254636165591040]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF   [Parameters].[KPIs (copy)_1264385618995630081]=&apos;# Resolved Cases&apos; THEN sum([resolved_contact_ind])&#10;ELSEIF  [Parameters].[KPIs (copy)_1264385618995630081]=&apos;Case AHT Non-Live (h)&apos; THEN ROUND([Case AHT (h) (copy)_1194016888909897728],1)&#10;ELSEIF  [Parameters].[KPIs (copy)_1264385618995630081]=&apos;Case AHT Live (m)&apos; THEN ROUND([Non Chat Case AHT (hours) (copy)_1194016888913399811],1)&#10;ELSEIF  [Parameters].[KPIs (copy)_1264385618995630081]=&apos;Chat AHT (m)&apos; THEN ROUND([Calculation_1194016888929374213],1)&#10;ELSEIF  [Parameters].[KPIs (copy)_1264385618995630081]=&apos;Chat Avg. Wrap Time (m)&apos; THEN ROUND([Chat AHT (m) (copy)_5870160642277855235],1)&#10;ELSEIF  [Parameters].[KPIs (copy)_1264385618995630081]=&apos;Chat Avg. THT (m)&apos; THEN ROUND([Chat AHT (m) (copy) (copy)_5870160642277867524],1)&#13;&#10;ELSEIF  [Parameters].[KPIs (copy)_1264385618995630081]=&apos;Avg. Full Resolution Time&apos; THEN ROUND([Calculation_1515179817555480578],1)&#13;&#10;// commented out as part of RA-1134&#10;// ELSEIF  [KPIs (Agents)]=&apos;AC NPS&apos; THEN ROUND([AC NPS],0)&#10;ELSEIF  [Parameters].[KPIs (copy)_1264385618995630081]=&apos;CSAT (in percentage)&apos; THEN ROUND([Calculation_338121849628798976],0)&#13;&#10;ELSEIF  [Parameters].[KPIs (copy)_1264385618995630081]=&apos;QA Score&apos; THEN ROUND([Calculation_526358231823593487],0)&#13;&#10;END' />
            </column>
            <column caption='CSAT (in percentage)' datatype='real' name='[Calculation_338121849628798976]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_ac_csat_4_5]) / SUM([count_ac_csat_responses]) *100' />
            </column>
            <column caption='QA Score' datatype='real' name='[Calculation_526358231823593487]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM([score_avg]),0)/(IFNULL(SUM([evaluations]),0))' />
            </column>
            <column caption='Chosen Dimension' datatype='string' name='[Calculation_6291880589560791042]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF[Parameters].[Chose Dimension (Columns) (copy)_526358231437660160]=&apos;Month&apos; THEN STR([month])&#10;ELSEIF [Parameters].[Chose Dimension (Columns) (copy)_526358231437660160]=&apos;Week&apos; THEN STR([week])&#10;ELSEIF [Parameters].[Chose Dimension (Columns) (copy)_526358231437660160]=&apos;Date&apos; THEN STR([report_date])&#10;END' />
            </column>
            <column caption='Case AHT Non-Live (h)' datatype='real' default-format='n#,##0;-#,##0' name='[Case AHT (h) (copy)_1194016888909897728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//Non Chat Case AHT (hours)&#10;SUM(&#10;    CASE [channel] WHEN &apos;Chat&apos; THEN 0&#10;    ELSE [handling_time_secs] END &#10;   )&#10;/&#10;SUM(&#10;    CASE [channel] WHEN &apos;Chat&apos; THEN 0&#10;    ELSE [resolved_contact_ind] END &#10;   )' />
            </column>
            <column caption='Chat Avg. Total HT (m)' datatype='real' name='[Chat AHT (m) (copy) (copy)_5870160642277867524]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(&#10;    CASE [channel] WHEN &apos;Chat&apos; THEN ZN([handling_time_secs]) + ZN([wrap_up_time_secs])&#10;    ELSE 0 END &#10;   )&#10;/&#10;SUM(&#10;    CASE [channel] WHEN &apos;Chat&apos; THEN [resolved_contact_ind]&#10;    ELSE 0 END &#10;   )&#10;)/60' />
            </column>
            <column caption='Chat Avg. Wrap Time (m)' datatype='real' name='[Chat AHT (m) (copy)_5870160642277855235]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(&#10;    CASE [channel] WHEN &apos;Chat&apos; THEN [wrap_up_time_secs]&#10;    ELSE 0 END &#10;   )&#10;/&#10;SUM(&#10;    CASE [channel] WHEN &apos;Chat&apos; THEN [resolved_contact_ind]&#10;    ELSE 0 END &#10;   )&#10;)/60' />
            </column>
            <column caption='Case AHT Live (m)' datatype='real' default-format='n#,##0;-#,##0' name='[Non Chat Case AHT (hours) (copy)_1194016888913399811]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Chat Case (m)&#10;&#10;(SUM(&#10;    CASE [channel] WHEN &apos;Chat&apos; THEN [handling_time_secs]&#10;    ELSE 0 END &#10;   )&#10; /&#10;SUM(&#10;    CASE [channel] WHEN &apos;Chat&apos; THEN [resolved_contact_ind]&#10;    ELSE 0 END &#10;   )&#10;)' />
            </column>
            <column caption='Report Date' datatype='date' name='[Report Date (copy)_4447937979075530752]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[report_date]' />
            </column>
            <column caption='Agent Email' datatype='string' name='[agent_email]' role='dimension' type='nominal' />
