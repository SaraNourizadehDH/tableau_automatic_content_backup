      <aliases enabled='yes' />
      <column caption='Fixed Sum N Skus' datatype='integer' name='[Calculation_1590333626507247616]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [warehouse_id], [warehouse_name], [month], [availability_bucket], [days_on_hand_bucket (group)], [sales_bucket_warehouse]: SUM([n_skus])}' />
      </column>
      <column caption='Count Warehouses' datatype='integer' name='[Calculation_1590333626510254082]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ EXCLUDE [days_on_hand_bucket (group)]: COUNTD([warehouse_id])}' />
      </column>
      <column caption='Fixed Avg N Skus Warehouse Level' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1590333626515484675]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1590333626507247616] / [Calculation_1590333626510254082]' />
      </column>
      <column caption='Avg Stock On hand' datatype='real' name='[Calculation_1707356907244490752]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([avg_on_hand_numerator]) / SUM([n_days])' />
      </column>
      <column caption='Average daily sales' datatype='real' name='[Calculation_1707356907244896257]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([qty_sold]) / SUM([n_days])' />
      </column>
      <column caption='Days on hand proxy' datatype='real' name='[Calculation_1707356907247247362]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([avg_on_hand_numerator]) / SUM([qty_sold])' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='_tableau_assortment_doh' datatype='table' name='[__tableau_internal_object_id__].[_tableau_assortment_doh_C1ECD490916C43DB8A5E383D9521B0A0]' role='measure' type='quantitative' />
