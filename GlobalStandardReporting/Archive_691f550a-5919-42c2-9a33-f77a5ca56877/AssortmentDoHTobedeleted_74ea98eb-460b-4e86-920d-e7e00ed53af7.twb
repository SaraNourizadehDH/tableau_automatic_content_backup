          <zone forceUpdate='true' h='18000' id='5' type-v2='text' w='99100' x='400' y='6125'>
            <formatted-text>
              <run bold='true'>Sales Bucket</run>
              <run><![CDATA[: Percentile of daily average sales the sku belongs to within it's warehouse. 
A value of <10 indicates skus that belong to the botom 10% of sellers within their warehouse.
]]></run>
              <run bold='true'>Days on hand bucket:</run>
              <run> Days on hand calculated as </run>
              <run bold='true'>avg stock on hand / avg daily sales. </run>
              <run>This is used to bucket skus.&#10;</run>
              <run bold='true'>Availability</run>
              <run>: Average monthly availability buckets. 10 means less than 10%

</run>
              <run bold='true'>Assortment Distribution: </run>
              <run>% of skus in each sales bucket&#10;</run>
              <run bold='true'>Sales Contribution: </run>
              <run>% of monthly sales contributed by skus in sales bucket
</run>
              <run bold='true'>Avg on hand qty:</run>
              <run> Average number of units in hand during the month</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
        </zone>
      </zones>
