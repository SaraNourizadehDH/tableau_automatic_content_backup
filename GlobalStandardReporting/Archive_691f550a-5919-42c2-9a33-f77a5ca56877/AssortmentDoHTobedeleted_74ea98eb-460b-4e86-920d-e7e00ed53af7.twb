      <group caption='Action (Days On Hand,MONTH(Month))' hidden='true' name='[Action (Days On Hand,MONTH(Month))]' name-style='unqualified' user:auto-column='sheet_link'>
        <groupfilter function='crossjoin'>
          <groupfilter function='level-members' level='[days_on_hand_bucket (group)]' />
          <groupfilter function='level-members' level='[tmn:month:ok]' />
