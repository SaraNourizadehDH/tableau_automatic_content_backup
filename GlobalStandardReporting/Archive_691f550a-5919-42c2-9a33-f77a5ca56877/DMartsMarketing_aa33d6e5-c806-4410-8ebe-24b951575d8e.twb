    <worksheet name='4.2. Frequency table'>
      <repository-location id='4_2_Frequencytable' path='/t/GlobalStandardReporting/workbooks/DMarts-Marketing' revision='' site='GlobalStandardReporting' />
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='16'>&lt;Sheet Name&gt;:</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='14'>1. Frequency Non Trials: frequency of non trials for actual month</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='14'>2. Frequency 1M: frequency of trials from previous month</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='14'>3. Frequency 3M: frequency of trials from 3 months ago</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='14'>4. Frequency 6M: frequency of trials from 6 months ago</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (curated_data_shared_dmart)' name='federated.101buhy02v0q1918az8jf1b58522' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Structure' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
              <calculation class='tableau' formula='&quot;Country&quot;' />
            </column>
            <column caption='Frequency' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Non Trials&quot;'>
              <calculation class='tableau' formula='&quot;Non Trials&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.101buhy02v0q1918az8jf1b58522'>
            <column caption='Structure' datatype='string' name='[Calculation_278941737197064195]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;DH Group&quot; THEN &quot;DH Group&quot;&#13;&#10;    WHEN &quot;Segment&quot; THEN [segment]&#13;&#10;    WHEN &quot;Management Entity&quot; THEN [management_entity]&#13;&#10;    WHEN &quot;Country&quot; THEN [country_name]&#13;&#10;END' />
            </column>
            <column caption='Frequency 6M' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Frequency 1M (copy)_278941737262231580]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_6m])/SUM([users_6m])' />
            </column>
            <column caption='Frequency 3M' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Frequency 1M (copy)_278941737262301213]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_3m])/SUM([users_3m])' />
            </column>
            <column caption='Frequency Non Trials' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Frequency 1M (copy)_278941737262366750]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([non_trials_orders])/SUM([non_trials_users])' />
            </column>
            <column caption='Pre-Pre-Structure' datatype='string' name='[Pre-Structure (copy)_278941737197494277]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;DH Group&quot; THEN NULL&#13;&#10;    WHEN &quot;Segment&quot; THEN NULL&#13;&#10;    WHEN &quot;Management Entity&quot; THEN &quot;DH Group&quot;&#13;&#10;    WHEN &quot;Country&quot; THEN [segment]&#13;&#10;END' />
            </column>
            <column caption='Rank percentile Frequency' datatype='real' default-format='n#,##0;-#,##0' name='[Rank percentile Reorder Rate (copy)_278941737262948383]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK_PERCENTILE([Reorder Rate (copy)_278941737262972960])*100'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Frequency' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Reorder Rate (copy)_278941737262972960]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;    WHEN &quot;Non Trials&quot; THEN [Frequency 1M (copy)_278941737262366750]&#13;&#10;    WHEN &quot;1M&quot; THEN [Reorder Rate 1M (copy)_278941737262108699]&#13;&#10;    WHEN &quot;3M&quot; THEN [Frequency 1M (copy)_278941737262301213]&#13;&#10;    WHEN &quot;6M&quot; THEN [Frequency 1M (copy)_278941737262231580]&#13;&#10;END' />
            </column>
            <column caption='Frequency 1M' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Reorder Rate 1M (copy)_278941737262108699]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_1m])/SUM([users_1m])' />
            </column>
            <column caption='Pre-Structure' datatype='string' name='[Structure (copy)_278941737197305860]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;DH Group&quot; THEN NULL&#13;&#10;    WHEN &quot;Segment&quot; THEN &quot;DH Group&quot;&#13;&#10;    WHEN &quot;Management Entity&quot; THEN [segment]&#13;&#10;    WHEN &quot;Country&quot; THEN [management_entity]&#13;&#10;END' />
