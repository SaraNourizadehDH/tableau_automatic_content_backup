  , users_3m&#13;
  , orders_6m&#13;
  , users_6m&#13;
  , vouchers_spend_on_trialists&#13;
  , vouchers_spend_on_existing_customers&#13;
  , vouchers_spend_on_trial_orders&#13;
  , vouchers_spend_on_acquisitions_orders&#13;
  , vouchers_spend_on_x_trials_orders&#13;
  , user_base.x_trials user_base_x_trials&#13;
  , user_base.acquisitions user_base_acquisitions&#13;
  , reorder_last_month&#13;
  , reorder_reactivated&#13;
  , inactive_active_last_month_active_qc&#13;
  , inactive_active_last_month_inactive_qc_active_platform&#13;
  , inactive_active_last_month_inactive_qc_inactive_platform&#13;
  , inactive_inactive_last_month&#13;
  , inactive_inactive_last_2_months&#13;
  , inactive_inactive_last_3_months&#13;
  &#13;
FROM `dh-darkstores-stg.dev_dmart.marketing_dm_pt1_overall` overall&#13;
&#13;
LEFT JOIN `dh-darkstores-stg.dev_dmart.marketing_dm_pt2_prospects` prospects&#13;
  ON overall.global_entity_id = prospects.global_entity_id&#13;
    AND overall.month = prospects.month&#13;
LEFT JOIN `dh-darkstores-stg.dev_dmart.marketing_dm_pt3_retention` retention&#13;
  ON overall.global_entity_id = retention.global_entity_id&#13;
    AND overall.month = retention.order_month&#13;
LEFT JOIN `dh-darkstores-stg.dev_dmart.marketing_dm_pt4_frequency` frequency&#13;
  ON overall.global_entity_id = frequency.global_entity_id&#13;
    AND overall.month = frequency.order_month&#13;
LEFT JOIN `dh-darkstores-stg.dev_dmart.marketing_dm_pt5_incentives_usage` incentives&#13;
  ON overall.global_entity_id = incentives.global_entity_id&#13;
    AND overall.month = incentives.order_month&#13;
LEFT JOIN `dh-darkstores-stg.dev_dmart.marketing_dm_pt9_user_base` user_base&#13;
  ON overall.global_entity_id = user_base.global_entity_id&#13;
    AND overall.month = user_base.month</relation>
            </properties>
