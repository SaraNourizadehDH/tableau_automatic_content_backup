    <worksheet name='5.1. Frequency N3M'>
      <repository-location id='5_1_FrequencyN3M' path='/t/GlobalStandardReporting/workbooks/DMarts-Marketing' revision='' site='GlobalStandardReporting' />
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>&lt;Sheet Name&gt;</run>
            <run>Æ&#10;</run>
            <run bold='true'>How many monthly orders did each MAU make in the next 3 calendar months?</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true'>*excluding MAU after January due to lower chances to have high frequency</run>
            <run>Æ&#10;</run>
            <run bold='true'>** 9 includes +9 orders in the next 3 calendar months</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (curated_data_shared_dmart) (3)' name='federated.1dy6dlh1m4lwu713g4f2j1xjzuqn' />
            <datasource caption='Custom SQL Query (curated_data_shared_dmart)' name='federated.101buhy02v0q1918az8jf1b58522' />
          </datasources>
          <datasource-dependencies datasource='federated.101buhy02v0q1918az8jf1b58522'>
            <column caption='Month' datatype='date' name='[month]' role='dimension' type='ordinal' />
            <column-instance column='[month]' derivation='None' name='[none:month:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1dy6dlh1m4lwu713g4f2j1xjzuqn'>
            <column caption='Orders in the next 3 months' datatype='string' name='[Calculation_493144199317200907]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [running_orders_next_three] = 0 THEN STR([running_orders_next_three])&#13;&#10;ELSEIF [running_orders_next_three] &gt;= 1 AND [running_orders_next_three] &lt;=2 THEN &quot;1-2&quot;&#13;&#10;ELSEIF [running_orders_next_three] &gt;= 3 AND [running_orders_next_three] &lt;=5 THEN &quot;3-5&quot;&#13;&#10;ELSEIF [running_orders_next_three] &gt;= 6 AND [running_orders_next_three] &lt;=8 THEN &quot;6-8&quot;&#13;&#10;ELSEIF [running_orders_next_three] &gt;= 9 THEN &quot;9&quot;&#13;&#10;END' />
            </column>
            <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column datatype='integer' name='[mau_per_bucket]' role='measure' type='quantitative' />
            <column caption='Month' datatype='date' name='[month]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_493144199317200907]' derivation='None' name='[none:Calculation_493144199317200907:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[management_entity]' derivation='None' name='[none:management_entity:nk]' pivot='key' type='nominal' />
            <column-instance column='[month]' derivation='None' name='[none:month:qk]' pivot='key' type='quantitative' />
            <column-instance column='[segment]' derivation='None' name='[none:segment:nk]' pivot='key' type='nominal' />
            <column-instance column='[mau_per_bucket]' derivation='Sum' name='[pcto:sum:mau_per_bucket:qk:2]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Columns' type='PctTotal' />
            </column-instance>
            <column aggregation='Sum' datatype='integer' name='[running_orders_next_three]' role='dimension' type='ordinal' />
            <column datatype='string' name='[segment]' role='dimension' type='nominal' />
            <column-instance column='[mau_per_bucket]' derivation='Sum' name='[sum:mau_per_bucket:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <natural-sort column='[federated.1dy6dlh1m4lwu713g4f2j1xjzuqn].[none:Calculation_493144199317200907:nk]' direction='DESC' />
          <filter class='categorical' column='[federated.1dy6dlh1m4lwu713g4f2j1xjzuqn].[none:country_name:nk]'>
            <groupfilter from='&quot;Argentina&quot;' function='range' level='[none:country_name:nk]' to='&quot;Uruguay&quot;' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.1dy6dlh1m4lwu713g4f2j1xjzuqn].[none:management_entity:nk]'>
            <groupfilter function='level-members' level='[none:management_entity:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='quantitative' column='[federated.1dy6dlh1m4lwu713g4f2j1xjzuqn].[none:month:qk]' included-values='in-range'>
            <min>#2021-01-01#</min>
