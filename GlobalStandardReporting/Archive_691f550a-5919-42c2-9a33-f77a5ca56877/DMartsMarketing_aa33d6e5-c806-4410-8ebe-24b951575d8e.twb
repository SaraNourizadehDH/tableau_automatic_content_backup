      <aliases enabled='yes' />
      <column caption='Trials / Covered prospects' datatype='real' name='[Calculation_1402871320340553734]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([x_trials_warehouse])/SUM([dmart_covered_prospect_mau])' />
      </column>
      <column caption='MAU / Covered MAU' datatype='real' default-format='p0%' name='[Calculation_1402871320340709383]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([users_warehouse])/SUM([dmart_covered_mau])' />
      </column>
      <column aggregation='Sum' caption='Age' datatype='integer' name='[Calculation_1402871320342319112]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,[first_order],NOW())' />
      </column>
      <column caption='Covered MAU &gt;25K' datatype='boolean' name='[Calculation_1402871320350777353]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[dmart_covered_mau] &gt; 25000' />
      </column>
      <column caption='X sells / Prospects' datatype='real' name='[Calculation_1402871320350961674]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([x_trials_warehouse])/SUM([dmart_covered_prospect_mau])' />
      </column>
      <column caption='Prospect Covered MAU / Covered MAU' datatype='real' default-format='p0%' name='[Calculation_1402871320351485963]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dmart_covered_prospect_mau])/SUM([dmart_covered_mau])' />
      </column>
      <column caption='Prospects / X trials' datatype='real' name='[Calculation_1402871320353099788]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dmart_covered_prospect_mau])/SUM([x_trials_warehouse])' />
      </column>
      <column caption='Age +12' datatype='boolean' name='[Calculation_1520246389861134336]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1402871320342319112] &gt;=12' />
      </column>
      <column caption='Penetration' datatype='real' name='[Calculation_1520246389892829185]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[users_warehouse]/[dmart_covered_mau]' />
      </column>
