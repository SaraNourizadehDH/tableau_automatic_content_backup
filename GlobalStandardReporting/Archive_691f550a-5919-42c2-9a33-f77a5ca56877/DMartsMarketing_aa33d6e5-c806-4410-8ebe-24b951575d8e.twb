    <worksheet name='2.1. X-trials'>
      <repository-location id='2_1_X-trials' path='/t/GlobalStandardReporting/workbooks/DMarts-Marketing' revision='' site='GlobalStandardReporting' />
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='16'>&lt;Sheet Name&gt;:</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='14'>1. How many of our prospects do we X-sell to DMarts?</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='14'>2. How much are we vouchering x-trialists?</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='14'>3. How many platform orders have been placed before x-trial?</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='14'>4. How many months do we have left to X-sell all Prospects? (assuming 0 Platform Acquisitions)</run>
            <run>Æ&#10;&#10;</run>
            <run fontsize='11'>Caveat:</run>
            <run>Æ&#10;</run>
            <run fontsize='11'>- Avg. # of orders in Platform at trial moment only works when country-level granularity is selected</run>
            <run>Æ&#10;</run>
            <run fontsize='11'>- Prospects calculated considering trials from Jan&apos;20</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (curated_data_shared_dmart)' name='federated.101buhy02v0q1918az8jf1b58522' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Color' datatype='string' name='[Structure (copy)_278941737201823751]' param-domain-type='list' role='measure' type='nominal' value='&quot;Management Entity&quot;'>
              <calculation class='tableau' formula='&quot;Management Entity&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.101buhy02v0q1918az8jf1b58522'>
            <column caption='X-trials / Prospects' datatype='real' default-format='p0.0%' name='[Calculation_278941737208406028]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([x_trials])/SUM([prospect_mau])' />
            </column>
            <column caption='% X-trials w/vouchers' datatype='real' default-format='p0.0%' name='[Calculation_278941737208803341]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([x_trials_w_voucher])/SUM([x_trials])' />
            </column>
            <column caption='Avg. # of orders in Platform at X trial moment' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_278941737209188366]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([avg_order_rank_for_xtrial])' />
            </column>
            <column caption='Color' datatype='string' name='[Structure (copy)_278941737201922056]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Structure (copy)_278941737201823751]&#13;&#10;    WHEN &quot;DH Group&quot; THEN &quot;DH Group&quot;&#13;&#10;    WHEN &quot;Segment&quot; THEN [segment]&#13;&#10;    WHEN &quot;Management Entity&quot; THEN [management_entity]&#13;&#10;    WHEN &quot;Country&quot; THEN [country_name]&#13;&#10;END' />
            </column>
            <column datatype='real' name='[avg_order_rank_for_xtrial]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Mgmt. Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column caption='Month' datatype='date' name='[month]' role='dimension' type='ordinal' />
            <column-instance column='[Structure (copy)_278941737201922056]' derivation='None' name='[none:Structure (copy)_278941737201922056:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[management_entity]' derivation='None' name='[none:management_entity:nk]' pivot='key' type='nominal' />
            <column-instance column='[month]' derivation='None' name='[none:month:ok]' pivot='key' type='ordinal' />
            <column-instance column='[month]' derivation='None' name='[none:month:qk]' pivot='key' type='quantitative' />
            <column-instance column='[segment]' derivation='None' name='[none:segment:nk]' pivot='key' type='nominal' />
