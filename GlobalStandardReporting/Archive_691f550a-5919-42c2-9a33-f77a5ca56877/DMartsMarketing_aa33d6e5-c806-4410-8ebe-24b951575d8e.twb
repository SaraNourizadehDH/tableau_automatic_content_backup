      <column caption='X-trials w/o vouchers' datatype='integer' name='[Calculation_1089871145508843520]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(x_trials - [x_trials_w_voucher])' />
      </column>
      <column caption='Trials per Warehouse' datatype='real' default-format='n#,##0,.0K;-#,##0,.0K' name='[Calculation_1402871320331911171]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([trials])/SUM([warehouses])' />
      </column>
      <column caption='Real Adopters / MAU' datatype='real' default-format='p0.0%' name='[Calculation_1402871320338817029]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([mau_active_3])/SUM([mau])' />
      </column>
      <column caption='X-trials / Platform Acquisitions' datatype='real' default-format='p0.0%' name='[Calculation_192528919695310849]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([x_trials])/SUM([platform_acquisitions])' />
      </column>
      <column caption='Acquisitions w/voucher vs. Platform' datatype='real' default-format='p0.0%' name='[Calculation_192528919698849794]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_278941737221537811] / (SUM([platform_acquisitions_w_voucher])/SUM([platform_acquisitions]))' />
      </column>
      <column caption='Dif in mau' datatype='integer' name='[Calculation_278941737189142528]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([mau])) - LOOKUP(ZN(SUM([mau])), -3)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Sum 3 trials' datatype='integer' name='[Calculation_278941737189724161]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_SUM(SUM([trials]), -2, 0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Durian' datatype='real' default-format='p0.0%' name='[Calculation_278941737190289410]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_278941737189142528]/[Calculation_278941737189724161]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Structure' datatype='string' name='[Calculation_278941737197064195]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;DH Group&quot; THEN &quot;DH Group&quot;&#13;&#10;    WHEN &quot;Segment&quot; THEN [segment]&#13;&#10;    WHEN &quot;Management Entity&quot; THEN [management_entity]&#13;&#10;    WHEN &quot;Country&quot; THEN [country_name]&#13;&#10;END' />
      </column>
      <column caption='Trials / MAU' datatype='real' default-format='p0.0%' name='[Calculation_278941737201319942]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([trials])/SUM([mau])' />
      </column>
      <column caption='% Trials w/vouchers' datatype='real' default-format='p0.0%' name='[Calculation_278941737202257929]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([trials_w_voucher])/SUM([trials])' />
      </column>
      <column caption='Avg. Dmart lifetime order w/voucher' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_278941737202569226]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([avg_vouchered_order_rank])' />
      </column>
      <column caption='X-trials / Prospects' datatype='real' default-format='p0.0%' name='[Calculation_278941737208406028]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([x_trials])/SUM([prospect_mau])' />
      </column>
      <column caption='% X-trials w/vouchers' datatype='real' default-format='p0.0%' name='[Calculation_278941737208803341]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([x_trials_w_voucher])/SUM([x_trials])' />
      </column>
      <column caption='Avg. # of orders in Platform at X trial moment' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_278941737209188366]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([avg_order_rank_for_xtrial])' />
      </column>
      <column caption='Months to X sell all Covered Prospects' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_278941737212698639]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([prospect_mau_covered])/SUM([x_trials]-0) &lt; 0 THEN -1 ELSE SUM([prospect_mau_covered])/SUM([x_trials]-0) END' />
      </column>
      <column caption='Covered Prospects' datatype='real' default-format='p0.0%' name='[Calculation_278941737217273872]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([prospect_mau_covered])/SUM([prospect_mau])' />
      </column>
      <column caption='Prospect / Platform MAU' datatype='real' default-format='p0.0%' name='[Calculation_278941737218813970]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([prospect_mau])/SUM([platform_mau])' />
      </column>
      <column caption='% Acquisitions w/vouchers' datatype='real' default-format='p0.0%' name='[Calculation_278941737221537811]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([acquisitions_w_voucher])/SUM([acquisitions])' />
      </column>
      <column caption='Acquisitions / Platform Acquisitions' datatype='real' default-format='p0.0%' name='[Calculation_278941737221664788]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([acquisitions])/SUM([platform_acquisitions])' />
      </column>
      <column caption='Reorder Rate 1M' datatype='real' default-format='p0.0%' name='[Calculation_278941737223696405]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([r1])/SUM([t1])' />
      </column>
      <column caption='Reorder Rate' datatype='real' default-format='p0.0%' name='[Calculation_278941737226194968]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;    WHEN &quot;1M&quot; THEN [Calculation_278941737223696405]&#13;&#10;    WHEN &quot;3M&quot; THEN [Reorder Rate 1M (copy)_278941737223823382]&#13;&#10;    WHEN &quot;6M&quot; THEN [Reorder Rate 3M (copy)_278941737223893015]&#13;&#10;END' />
      </column>
      <column caption='Rank percentile Reorder Rate' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_278941737243717657]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_PERCENTILE([Calculation_278941737226194968])*100'>
          <table-calc ordering-type='Rows' />
