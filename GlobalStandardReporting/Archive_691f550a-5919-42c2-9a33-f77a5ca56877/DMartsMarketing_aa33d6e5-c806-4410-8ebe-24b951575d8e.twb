  <worksheets>
    <worksheet name='1. Durian'>
      <repository-location id='1_Durian' path='/t/GlobalStandardReporting/workbooks/DMarts-Marketing' revision='' site='GlobalStandardReporting' />
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='16'>&lt;Sheet Name&gt;:</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='14'>How much do our trials contribute to an increase in MAU?</run>
            <run>Æ&#10;&#10;</run>
            <run fontsize='11'>Rolling calculation: (MAU actual month - MAU -3 month) / (Trials last 3 complete months -incl. actual-)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (curated_data_shared_dmart)' name='federated.101buhy02v0q1918az8jf1b58522' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Structure' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
              <calculation class='tableau' formula='&quot;Country&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.101buhy02v0q1918az8jf1b58522'>
            <column caption='Dif in mau' datatype='integer' name='[Calculation_278941737189142528]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([mau])) - LOOKUP(ZN(SUM([mau])), -3)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Sum 3 trials' datatype='integer' name='[Calculation_278941737189724161]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_SUM(SUM([trials]), -2, 0)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Durian' datatype='real' default-format='p0.0%' name='[Calculation_278941737190289410]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_278941737189142528]/[Calculation_278941737189724161]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Structure' datatype='string' name='[Calculation_278941737197064195]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;DH Group&quot; THEN &quot;DH Group&quot;&#13;&#10;    WHEN &quot;Segment&quot; THEN [segment]&#13;&#10;    WHEN &quot;Management Entity&quot; THEN [management_entity]&#13;&#10;    WHEN &quot;Country&quot; THEN [country_name]&#13;&#10;END' />
            </column>
            <column caption='Pre-Pre-Structure' datatype='string' name='[Pre-Structure (copy)_278941737197494277]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;DH Group&quot; THEN NULL&#13;&#10;    WHEN &quot;Segment&quot; THEN NULL&#13;&#10;    WHEN &quot;Management Entity&quot; THEN &quot;DH Group&quot;&#13;&#10;    WHEN &quot;Country&quot; THEN [segment]&#13;&#10;END' />
            </column>
            <column caption='Pre-Structure' datatype='string' name='[Structure (copy)_278941737197305860]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;DH Group&quot; THEN NULL&#13;&#10;    WHEN &quot;Segment&quot; THEN &quot;DH Group&quot;&#13;&#10;    WHEN &quot;Management Entity&quot; THEN [segment]&#13;&#10;    WHEN &quot;Country&quot; THEN [management_entity]&#13;&#10;END' />
            </column>
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Mgmt. Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column caption='MAU' datatype='integer' name='[mau]' role='measure' type='quantitative' />
            <column caption='Month' datatype='date' name='[month]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_278941737197064195]' derivation='None' name='[none:Calculation_278941737197064195:nk]' pivot='key' type='nominal' />
            <column-instance column='[Pre-Structure (copy)_278941737197494277]' derivation='None' name='[none:Pre-Structure (copy)_278941737197494277:nk]' pivot='key' type='nominal' />
            <column-instance column='[Structure (copy)_278941737197305860]' derivation='None' name='[none:Structure (copy)_278941737197305860:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[management_entity]' derivation='None' name='[none:management_entity:nk]' pivot='key' type='nominal' />
            <column-instance column='[month]' derivation='None' name='[none:month:ok]' pivot='key' type='ordinal' />
            <column-instance column='[month]' derivation='None' name='[none:month:qk]' pivot='key' type='quantitative' />
            <column-instance column='[segment]' derivation='None' name='[none:segment:nk]' pivot='key' type='nominal' />
            <column caption='Segment' datatype='string' name='[segment]' role='dimension' type='nominal' />
            <column caption='Trials' datatype='integer' default-format='n#,##0,.0K;-#,##0,.0K' name='[trials]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_278941737190289410]' derivation='User' name='[usr:Calculation_278941737190289410:qk:2]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Table' />
              <table-calc field='[federated.101buhy02v0q1918az8jf1b58522].[Calculation_278941737189142528]' ordering-type='Table' />
              <table-calc field='[federated.101buhy02v0q1918az8jf1b58522].[Calculation_278941737189724161]' ordering-type='Table' />
            </column-instance>
            <column-instance column='[Calculation_278941737190289410]' derivation='User' name='[usr:Calculation_278941737190289410:qk:5]' pivot='key' type='quantitative'>
              <table-calc ordering-field='[federated.101buhy02v0q1918az8jf1b58522].[none:month:qk]' ordering-type='Field' />
              <table-calc field='[federated.101buhy02v0q1918az8jf1b58522].[Calculation_278941737189142528]' ordering-field='[federated.101buhy02v0q1918az8jf1b58522].[none:month:qk]' ordering-type='Field' />
              <table-calc field='[federated.101buhy02v0q1918az8jf1b58522].[Calculation_278941737189724161]' ordering-field='[federated.101buhy02v0q1918az8jf1b58522].[none:month:qk]' ordering-type='Field' />
            </column-instance>
            <column-instance column='[Calculation_278941737190289410]' derivation='User' name='[usr:Calculation_278941737190289410:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' />
              <table-calc field='[federated.101buhy02v0q1918az8jf1b58522].[Calculation_278941737189142528]' ordering-type='Rows' />
              <table-calc field='[federated.101buhy02v0q1918az8jf1b58522].[Calculation_278941737189724161]' ordering-type='Rows' />
            </column-instance>
          </datasource-dependencies>
          <filter class='quantitative' column='[federated.101buhy02v0q1918az8jf1b58522].[usr:Calculation_278941737190289410:qk]' included-values='non-null' />
          <slices>
            <column>[federated.101buhy02v0q1918az8jf1b58522].[none:month:qk]</column>
            <column>[federated.101buhy02v0q1918az8jf1b58522].[usr:Calculation_278941737190289410:qk]</column>
            <column>[federated.101buhy02v0q1918az8jf1b58522].[none:segment:nk]</column>
            <column>[federated.101buhy02v0q1918az8jf1b58522].[none:management_entity:nk]</column>
            <column>[federated.101buhy02v0q1918az8jf1b58522].[none:country_name:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
