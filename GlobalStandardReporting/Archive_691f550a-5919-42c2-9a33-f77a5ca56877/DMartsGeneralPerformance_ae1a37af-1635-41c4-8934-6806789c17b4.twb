      <aliases enabled='yes' />
      <column caption='AMT Voucher' datatype='real' default-format='n#,##0;-#,##0' name='[AMT GMV (copy)_2624754208946434052]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;1&apos; THEN [amt_voucher_eur]&#10;WHEN &apos;2&apos; THEN [amt_voucher_lc]&#10;WHEN &apos;3&apos; THEN 0&#10;END' />
      </column>
      <column caption='Acquisition (DS) Share' datatype='real' default-format='p0.00%' name='[Acquisition (Backend) Share (copy)_955466858568765440]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([acquisitions_darkstores]) / SUM([orders])' />
      </column>
      <column caption='Ø Idle Time Picking Start (Min.)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg. Picking Time (Min.) (copy)_2624754208936095746]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([seconds_picking_time]) / 60)&#10;/ SUM([orders_with_picking_times])' />
      </column>
      <column caption='Basket Value (Net)' datatype='real' name='[Basket Value (copy)_5781918286865481735]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5781918286857838597] + [Profit (copy)] + [AMT GMV (copy)_2624754208946434052]' />
      </column>
      <column datatype='integer' name='[Calculation1 (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if MAX([Calculation_2676334485427712002]) = DATE(TODAY() - 16) then 1&#10;else null&#10;end' />
      </column>
      <column caption='COGS (%)' datatype='real' name='[Calculation_1092122933732511744]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Discount Other (copy)]) / SUM([Discount (copy)])' />
      </column>
      <column caption='Discount DH' datatype='real' name='[Calculation_1092122933748383746]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#13;&#10;WHEN &apos;1&apos; THEN [amt_discount_dh_eur]&#13;&#10;WHEN &apos;2&apos; THEN [amt_discount_dh_lc]&#13;&#10;WHEN &apos;3&apos; THEN 0&#13;&#10;END' />
      </column>
      <column caption='Discount Other' datatype='real' name='[Calculation_1092122933748633603]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#13;&#10;WHEN &apos;1&apos; THEN [amt_discount_other_eur]&#13;&#10;WHEN &apos;2&apos; THEN [amt_discount_other_lc]&#13;&#10;WHEN &apos;3&apos; THEN 0&#13;&#10;END' />
      </column>
      <column caption='Profit' datatype='real' name='[Calculation_1092122933749198852]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#13;&#10;WHEN &apos;1&apos; THEN [amt_profit_eur]&#13;&#10;WHEN &apos;2&apos; THEN [amt_profit_lc]&#13;&#10;WHEN &apos;3&apos; THEN 0&#13;&#10;END' />
      </column>
      <column caption='UTR' datatype='real' name='[Calculation_1092122933749567493]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(0) / SUM(1)' />
      </column>
      <column caption='Share of Total Failed Orders' datatype='real' name='[Calculation_1092122933750812678]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([failed_orders])&#13;&#10;/&#13;&#10;(SUM([orders]) + SUM([failed_orders]))' />
      </column>
      <column caption='Share of Total Acquisitions' datatype='real' name='[Calculation_1092122933750927367]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5843350178456989702]/SUM([total_acquisitions])' />
      </column>
      <column caption='Share of Total GMV [€]' datatype='real' name='[Calculation_1092122933751218184]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders])/SUM(1)' />
      </column>
      <column caption='Share of Total Orders' datatype='real' name='[Calculation_1092122933751308297]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders])/SUM([total_orders])' />
      </column>
      <column caption='Dimension Analysis' datatype='string' name='[Calculation_1154821510835761153]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN 1 THEN [region]&#10;WHEN 2 THEN [common_name]&#10;WHEN 3 THEN [Store (copy)]&#10;WHEN 4 THEN [city]&#10;END' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_131448869316947968]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]=USERNAME()' />
      </column>
      <column caption='Calculation1' datatype='integer' name='[Calculation_1387249477414879232]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if MAX([Calculation_2676334485427712002]) = DATE(TODAY() - 16) then WINDOW_SUM(SUM([orders]))&#10;else null&#10;end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Voucher Share' datatype='real' default-format='p0.00%' name='[Calculation_2624754208942391299]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([voucher_orders]) / SUM([orders])' />
      </column>
      <column caption='Ø GMV' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2676334485427433472]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Discount (copy)]) / SUM([orders])' />
      </column>
      <column caption='Date x' datatype='datetime' default-format='*YYYY-MM-DD' name='[Calculation_2676334485427712002]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC([Parameters].[Parameter 1], [order_date], &apos;monday&apos;)' />
      </column>
      <column caption='Ø Delivery Time (Min.)' datatype='real' name='[Calculation_2676334485447655428]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([minutes_delivery_time]) / SUM([orders])' />
      </column>
      <column caption='Sales Price w/o Tax' datatype='real' name='[Calculation_2962313086769049600]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[amt_total_price_paid_net_eur]' />
      </column>
      <column caption='Ø Picking Time (Min.)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_4429712485855227905]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([seconds_picking_time]) / 60)&#10;/ SUM([orders_with_picking_times])' />
      </column>
      <column caption='Ø Items' datatype='real' name='[Calculation_4429712485855424514]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([items_sold]) / SUM([orders])' />
      </column>
      <column caption='Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_4429712485874511875]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([failed_orders]) / (SUM([orders]) + SUM([failed_orders]))' />
      </column>
      <column caption='Net Margin' datatype='real' default-format='p0.00%' name='[Calculation_4429712485936824326]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_5781918286857838597]) - SUM(IFNULL([Discount Other (copy)], 0)))&#10;/ &#10;SUM([Calculation_5781918286857838597])' />
      </column>
      <column caption='Net Sales' datatype='real' name='[Calculation_5781918285118914562]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Basket Value (copy)_5781918286865481735] - [Calculation_5781918285119528963])' />
      </column>
      <column caption='Delivery Fee' datatype='real' name='[Calculation_5781918285119528963]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;1&apos; THEN [amt_delivery_fee_eur]&#10;WHEN &apos;2&apos; THEN [amt_delivery_fee_lc]&#10;WHEN &apos;3&apos; THEN 0&#10;END' />
      </column>
      <column caption='Total Price Paid Net' datatype='real' name='[Calculation_5781918286857838597]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;1&apos; THEN [amt_total_price_paid_net_eur]&#10;WHEN &apos;2&apos; THEN [amt_total_price_paid_net_lc]&#10;WHEN &apos;3&apos; THEN 0&#10;END' />
      </column>
      <column caption='Total Price Paid' datatype='real' name='[Calculation_5781918286858014726]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;1&apos; THEN [amt_total_price_paid_eur]&#10;WHEN &apos;2&apos; THEN [amt_total_price_paid_lc]&#10;WHEN &apos;3&apos; THEN 0&#10;END' />
      </column>
      <column caption='Front Margin (w/o DF)' datatype='real' default-format='p0.0%' name='[Calculation_5781918286872211465]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_5781918285118914562]) - SUM(IFNULL([Discount Other (copy)],0))) / SUM([Calculation_5781918285118914562])' />
      </column>
      <column caption='Today Exclude' datatype='boolean' name='[Calculation_5843350178390622208]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='TODAY()-1 = [order_date]' />
      </column>
      <column caption='Age of DS' datatype='real' name='[Calculation_5843350178442231810]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='ROUND(DATEDIFF(&apos;day&apos;, [warehouse_first_order_date], [order_date])/7)' />
      </column>
      <column caption='Acquisition (Backend) Share' datatype='real' default-format='p0.00%' name='[Calculation_5843350178456989702]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([acquisitions_backend]) / SUM([orders])' />
      </column>
      <column caption='Average Orders per Interval' datatype='real' name='[Calculation_5843350178460487687]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders]) / COUNTD([order_date])' />
      </column>
      <column caption='0' datatype='integer' name='[Calculation_6674545772229693442]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
