      <column caption='Gross Margin (Back Margin)' datatype='real' default-format='p0.00%' name='[Net Margin (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_5781918286858014726]) - SUM([Discount Other (copy)]))/SUM([Calculation_5781918286858014726])&#10;&#10;//(SUM([AMT GMV]) + SUM([Discount]) - SUM([COGS])) / (SUM([AMT GMV]) + SUM([Discount]))' />
      </column>
