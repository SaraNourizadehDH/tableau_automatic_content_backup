            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Business_KPIs_Param' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Absolute&quot;'>
              <calculation class='tableau' formula='&quot;Absolute&quot;' />
            </column>
            <column caption='Total/Per Order' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Total&quot;'>
              <calculation class='tableau' formula='&quot;Total&quot;' />
            </column>
            <column caption='Adjusted Totals Flag' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Use Adjusted Totals&quot;'>
              <calculation class='tableau' formula='&quot;Use Adjusted Totals&quot;' />
            </column>
            <column caption='Adjusted Totals Granularity' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Experiment&quot;'>
              <calculation class='tableau' formula='&quot;Experiment&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0mx6f3d1k4rxbi14xk31h1xj032n'>
            <column caption='count_users_exp_lvl' datatype='integer' name='[Calculation_1201053766634201088]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [entity_id], [test_id], [variant]: COUNTD([perseus_client_id])}' />
            </column>
            <column caption='corr_factor_exp_lvl' datatype='real' default-format='p0.00%' name='[Calculation_1201053766637412354]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[count_users_exp_lvl (copy)_1201053766635827201] / [Calculation_1201053766634201088] - 1' />
            </column>
            <column caption='corr_factor_ts_n_lvl' datatype='real' default-format='p0.00%' name='[corr_factor_exp_lvl (copy)_1201053766641586183]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[count_users_control_ts_y_lvl (copy)_1201053766641446918] / [count_users_ts_y_lvl (copy)_1201053766639136772] - 1' />
            </column>
            <column caption='corr_factor_tg_two_lvl' datatype='real' default-format='p0.00%' name='[corr_factor_tg_one_lvl (copy)_1201053766646128654]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[count_users_control_tg_one_lvl (copy)_1201053766645886989] / [count_users_tg_one_lvl (copy)_1201053766643982346] - 1' />
            </column>
            <column caption='corr_factor_ts_y_lvl' datatype='real' default-format='p0.00%' name='[corr_factor_ts_n_lvl (copy)_1201053766641741832]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[count_users_ts_y_lvl (copy)_1201053766640824325] / [count_users_exp_lvl (copy)_1201053766637715459] - 1' />
            </column>
            <column caption='corr_factor_tg_one_lvl' datatype='real' default-format='p0.00%' name='[corr_factor_ts_n_lvl (copy)_1201053766645661707]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[count_users_tg_one_lvl (copy)_1201053766645731340] / [count_users_ts_n_lvl (copy)_1201053766643650569] - 1' />
