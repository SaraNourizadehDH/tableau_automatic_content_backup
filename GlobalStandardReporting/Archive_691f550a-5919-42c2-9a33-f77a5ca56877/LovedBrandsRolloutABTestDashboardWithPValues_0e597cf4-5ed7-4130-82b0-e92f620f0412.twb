  <worksheets>
    <worksheet name='Business KPIs'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Business KPIs&#10;</run>
            <run bold='true' fontcolor='#ff0000' fontsize='10' italic='true'>Note 1: </run>
            <run fontcolor='#ff0000' fontsize='10' italic='true'>The color legend corresponds to each column independently</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#1b1b1b' fontsize='10' italic='true'>Note 2: </run>
            <run fontcolor='#1b1b1b' fontsize='10' italic='true'>The corr_factor used to compute the adjusted totals</run>
            <run>Æ&#10;</run>
            <run fontcolor='#1b1b1b' fontsize='10' italic='true'>is calculated on the experiment level based on the number of users per variant</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='orders_cleaned_lb_rollout_tests' name='federated.0z0jmwh16b4w731afnsf91wibia5' />
