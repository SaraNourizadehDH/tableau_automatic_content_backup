very_costs_local]) / COUNTD([order_id])) - LOOKUP(ZN(SUM([delivery_costs_local]) / COUNTD([order_id])))) / ABS(LOOKUP(ZN(SUM([delivery_costs_local]) / COUNTD([order_id])))) ) * 100&#13;&#10;        END&#13;&#10;    END&#13;&#10;END'>
