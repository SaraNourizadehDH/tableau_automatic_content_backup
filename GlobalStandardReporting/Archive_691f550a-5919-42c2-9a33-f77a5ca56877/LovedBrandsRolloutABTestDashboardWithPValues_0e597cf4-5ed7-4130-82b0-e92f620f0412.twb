            <column caption='count_users_control_tg_two_lvl' datatype='integer' name='[count_users_control_tg_one_lvl (copy)_1201053766645886989]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [entity_id], [test_id]: COUNTD(IF [target_group_bi] = &apos;Target Group 2&apos; AND [variant] = &apos;Control&apos; THEN [perseus_client_id] END)}' />
