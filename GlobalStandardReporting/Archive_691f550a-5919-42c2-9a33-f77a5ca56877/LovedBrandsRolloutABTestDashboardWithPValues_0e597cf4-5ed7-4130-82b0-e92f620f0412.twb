            <column caption='Orders' datatype='real' name='[Calculation_1513772461743828993]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Dont Use Adjusted Totals&apos; THEN&#13;&#10;    IF [Parameters].[Parameter 2] = &apos;Total&apos; THEN&#13;&#10;        CASE [Parameters].[Parameter 1]&#13;&#10;            WHEN &apos;Absolute&apos; THEN COUNTD([order_id])&#13;&#10;            WHEN &apos;% Delta (Var-Control)&apos; THEN ( (ZN(COUNTD([order_id])) - LOOKUP(ZN(COUNTD([order_id])))) / ABS(LOOKUP(ZN(COUNTD([order_id])))) ) * 100&#13;&#10;        END&#13;&#10;    ELSE &#13;&#10;        CASE [Parameters].[Parameter 1]&#13;&#10;            WHEN &apos;Absolute&apos; THEN COUNTD([order_id])&#13;&#10;            WHEN &apos;% Delta (Var-Control)&apos; THEN ( (ZN(COUNTD([order_id])) - LOOKUP(ZN(COUNTD([order_id])))) / ABS(LOOKUP(ZN(COUNTD([order_id])))) ) * 100&#13;&#10;        END&#13;&#10;    END&#13;&#10;&#13;&#10;ELSE // If Adjusted Totals Flag != Dont Use Adjusted Totals&#13;&#10;    IF [Parameters].[Parameter 5] = &apos;Experiment&apos; THEN&#13;&#10;        IF [Parameters].[Parameter 2] = &apos;Total&apos; THEN&#13;&#10;            CASE [Parameters].[Parameter 1]&#13;&#10;                WHEN &apos;Absolute&apos; THEN COUNTD([order_id]) * (1 + SUM([federated.0mx6f3d1k4rxbi14xk31h1xj032n].[Calculation_1201053766637412354]))&#13;&#10;                WHEN &apos;% Delta (Var-Control)&apos; THEN ( (ZN(COUNTD([order_id]) * (1 + SUM([federated.0mx6f3d1k4rxbi14xk31h1xj032n].[Calculation_1201053766637412354]))) - LOOKUP(ZN(COUNTD([order_id]) * (1 + SUM([federated.0mx6f3d1k4rxbi14xk31h1xj032n].[Calculation_1201053766637412354]))))) / ABS(LOOKUP(ZN(COUNTD([order_id]) * (1 + SUM([federated.0mx6f3d1k4rxbi14xk31h1xj032n].[Calculation_1201053766637412354]))))) ) * 100&#13;&#10;            END&#13;&#10;        ELSE &#13;&#10;            CASE [Parameters].[Parameter 1]&#13;&#10;                WHEN &apos;Absolute&apos; THEN COUNTD([order_id]) * (1 + SUM([federated.0mx6f3d1k4rxbi14xk31h1xj032n].[Calculation_1201053766637412354]))&#13;&#10;                WHEN &apos;% Delta (Var-Control)&apos; THEN ( (ZN(COUNTD([order_id]) * (1 + SUM([federated.0mx6f3d1k4rxbi14xk31h1xj032n].[Calculation_1201053766637412354]))) - LOOKUP(ZN(COUNTD([order_id]) * (1 + SUM([federated.0mx6f3d1k4rxbi14xk31h1xj032n].[Calculation_1201053766637412354]))))) / ABS(LOOKUP(ZN(COUNTD([order_id]) * (1 + SUM([federated.0mx6f3d1k4rxbi14xk31h1xj032n].[Calculation_1201053766637412354]))))) ) * 100&#13;&#10;            END&#13;&#10;        END&#13;&#10;    ELSEIF  [Parameters].[Parameter 5] = &apos;Treatment Scope&apos; THEN&#13;&#10;        IF [Parameters].[Parameter 2] = &apos;Total&apos; THEN&#13;&#10;            CASE [Parameters].[Parameter 1]&#13;&#10;                WHEN &apos;Absolute&apos; THEN COUNTD([order_id]) * (1 + SUM([federated.0mx6f3d1k4rxbi14xk31h1xj032n].[corr_factor_ts_n_lvl (copy)_1201053766641741832]))&#13;&#10;                WHEN &apos;% Delta (Var-Control)&apos; THEN ( (ZN(COUNTD([order_id]) * (1 + SUM([federated.0mx6f3d1k4rxbi14xk31h1xj032n].[corr_factor_ts_n_lvl (copy)_1201053766641741832]))) - LOOKUP(ZN(COUNTD([order_id]) * (1 + SUM([federated.0mx6f3d1k4rxbi14xk31h1xj032n].[corr_factor_ts_n_lvl (copy)_1201053766641741832]))))) / ABS(LOOKUP(ZN(COUNTD([order_id]) * (1 + SUM([federated.0mx6f3d1k4rxbi14xk31h1xj032n].[corr_factor_ts_n_lvl (copy)_1201053766641741832]))))) ) * 100&#13;&#10;            END&#13;&#10;        ELSE &#13;&#10;            CASE [Parameters].[Parameter 1]&#13;&#10;                WHEN &apos;Absolute&apos; THEN COUNTD([order_id]) * (1 + SUM([federated.0mx6f3d1k4rxbi14xk31h1xj032n].[corr_factor_ts_n_lvl (copy)_1201053766641741832]))&#13;&#10;                WHEN &apos;% Delta (Var-Control)&apos; THEN ( (ZN(COUNTD([order_id]) * (1 + SUM([federated.0mx6f3d1k4rxbi14xk31h1xj032n].[corr_factor_ts_n_lvl (copy)_1201053766641741832]))) - LOOKUP(ZN(COUNTD([order_id]) * (1 + SUM([federated.0mx6f3d1k4rxbi14xk31h1xj032n].[corr_factor_ts_n_lvl (copy)_1201053766641741832]))))) / ABS(LOOKUP(ZN(COUNTD([ord