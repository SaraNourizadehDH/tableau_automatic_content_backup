    <worksheet name='Treatment Dynamic Explanation'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='dps_ab_test_significance_dataset_v2' name='federated.1pu7wmd181yc111ags2hq081num9' />
          </datasources>
          <datasource-dependencies datasource='federated.1pu7wmd181yc111ags2hq081num9'>
            <column caption='Treatment Dynamic Explanation (copy)' datatype='string' name='[ANOVA Dynamic Explanation (copy)_397653784156893184]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [treatment] = &quot;All&quot;&#10;    THEN &quot;Treatment = All means that all sessions that are part of the experiment are taken into account, including sessions that ended up with transactions from vendors that are not a part of the experiment.&quot;&#10;ELSEIF [treatment] = &quot;True&quot;&#10;    THEN &quot;Treatment = True means that only sessions that are associated with vendors that participate in the experiment are taken into account. Sessions that are not associated with a specific vendor (such as sessions in the listing page) cannot be assigned a treatment value (since the treatment refers to spefici vendors). For this reason some KPIs are not available when choosing this option. Please check the guide for more details.&quot;&#10;ELSE &quot;&quot;&#10;END' />
            </column>
            <column caption='KPI Label (Aliases)' datatype='string' name='[Calculation_2041749161529237504]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [kpi_label] = &quot;cvr&quot; THEN &quot;Conversion Rate&quot;&#10;ELSEIF [kpi_label] = &quot;mcvr2&quot; THEN &quot;mcvr2&quot;&#10;ELSEIF [kpi_label] = &quot;mcvr3&quot; THEN &quot;mcvr3&quot;&#10;ELSEIF [kpi_label] = &quot;mcvr4&quot; THEN &quot;mcvr4&quot;&#10;ELSEIF [kpi_label] = &quot;delivery_fee_eur&quot; THEN &quot;Delivery Fee (Euro)&quot;&#10;ELSEIF [kpi_label] = &quot;delivery_fee_local&quot; THEN &quot;Delivery Fee (Local)&quot;&#10;ELSEIF [kpi_label] = &quot;gfv_eur&quot; THEN &quot;GFV (Euro)&quot;&#10;ELSEIF [kpi_label]= &quot;gfv_local&quot; THEN &quot;GFV (Local)&quot;&#10;ELSEIF [kpi_label] = &quot;travel_time&quot; THEN &quot;Travel Time&quot;&#10;ELSEIF [kpi_label] = &quot;delivery_costs_eur&quot; THEN &quot;Delivery Costs (Euro)&quot;&#10;ELSEIF [kpi_label] = &quot;profit_eur&quot; THEN &quot;Profit (Euro)&quot;&#10;ELSEIF [kpi_label] = &quot;revenue_eur&quot; THEN &quot;Revenue (Euro)&quot;&#10;ELSEIF [kpi_label] = &quot;delivery_costs_local&quot; THEN &quot;Delivery Costs (Local)&quot;&#10;ELSEIF [kpi_label] = &quot;profit_local&quot; THEN &quot;Profit (Local)&quot;&#10;ELSEIF [kpi_label] = &quot;revenue_local&quot; THEN &quot;Revenue (Local)&quot;&#10;ELSEIF [kpi_label] = &quot;fleet_delay&quot; THEN &quot;Fleet Delay&quot;&#10;ELSEIF [kpi_label] = &quot;delivery_distance&quot; THEN &quot;Delivery Distance&quot;&#10;ELSEIF [kpi_label] = &quot;user_cvr&quot; THEN &quot;User CVR&quot;&#10;ELSEIF [kpi_label] = &quot;orders_per_customer&quot; THEN &quot;Orders per Customer&quot;&#10;ELSEIF [kpi_label] = &quot;orders_per_user&quot; THEN &quot;Orders per User&quot;&#10;END' />
            </column>
            <column caption='Kpi Label' datatype='string' name='[kpi_label]' role='dimension' type='nominal' />
            <column-instance column='[ANOVA Dynamic Explanation (copy)_397653784156893184]' derivation='None' name='[none:ANOVA Dynamic Explanation (copy)_397653784156893184:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2041749161529237504]' derivation='None' name='[none:Calculation_2041749161529237504:nk]' pivot='key' type='nominal' />
            <column-instance column='[test_name]' derivation='None' name='[none:test_name:nk]' pivot='key' type='nominal' />
