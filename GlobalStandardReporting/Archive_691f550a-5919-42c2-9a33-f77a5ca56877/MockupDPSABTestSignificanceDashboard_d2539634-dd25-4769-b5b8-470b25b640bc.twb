      <table>
        <view>
          <datasources>
            <datasource caption='dps_ab_test_significance_dataset_v2' name='federated.1pu7wmd181yc111ags2hq081num9' />
          </datasources>
          <datasource-dependencies datasource='federated.1pu7wmd181yc111ags2hq081num9'>
            <column caption='KPI Definitions' datatype='string' name='[Calculation_917467696436420610]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [KPI Label (Aliases) (copy)_796503826216357888] = &apos;Delivery Costs&apos;&#10;    THEN &apos;The total riders costs per order. Obtained by summing the weekly costs by city and repartitioning them per delivery based on the total time spent on that single delivery including the idle_time, then summing up the cost of all deliveries for order.&apos;&#10;ELSEIF [KPI Label (Aliases) (copy)_796503826216357888] = &apos;Delivery Distance&apos;&#10;    THEN &apos;The Manhattan distance (km) between the vendor location coordinates and customer location coordinates. This distance does not take into account potential stacked deliveries, and it is not the traveled distance. This KPI is only available for OD orders.&apos;&#10;ELSEIF [KPI Label (Aliases) (copy)_796503826216357888] = &apos;Delivery Fee&apos;&#10;    THEN &apos;The supposed-to-be-paid delivery fee of the order placed from the backend. This may differ from the actual delivery fee paid in the case of local marketing campaigns that are not signalled in central-dwh.orders.&apos;&#10;ELSEIF [KPI Label (Aliases) (copy)_796503826216357888] = &apos;GFV&apos;&#10;    THEN &apos;Gross Food Value of the order placed from the backend.&apos;&#10;ELSEIF [KPI Label (Aliases) (copy)_796503826216357888] = &apos;Revenue&apos;&#10;    THEN &apos;The total income of an order. It’s the sum of the delivery fee (including VAT), commission and the vendor fee.&apos;&#10;ELSEIF [KPI Label (Aliases) (copy)_796503826216357888] = &apos;Profit&apos;&#10;    THEN &apos;The revenue of an order, after deducting the delivery costs.&apos;&#10;ELSEIF [KPI Label (Aliases) (copy)_796503826216357888] = &apos;Travel Time&apos;&#10;    THEN &apos;The time (min) it takes the rider to travel from vendor location coordinates to the customers. This KPI is only available for OD orders.&apos;&#10;ELSEIF [KPI Label (Aliases) (copy)_796503826216357888] = &apos;User CVR&apos;&#10;    THEN &apos;Fraction of the users that ended up turning into customers. Calculated as the number of distinct customers divided by the number of distinct users.&apos;&#10;ELSEIF [KPI Label (Aliases) (copy)_796503826216357888] = &apos;Orders per User&apos;&#10;    THEN &apos;Number of orders divided by number of distinct users.&apos;&#10;ELSEIF [KPI Label (Aliases) (copy)_796503826216357888] = &apos;Orders per Customer&apos;&#10;    THEN &apos;Number of orders divided by number of distinct customers.&apos;&#10;ELSEIF [KPI Label (Aliases) (copy)_796503826216357888] = &apos;Conversion Rate&apos;&#10;    THEN &apos;Fraction of sessions that ended in a successful transaction. Calculated as the number of distinct transactions divided by the number of distinct session_id’s.&apos;&#10;ELSEIF [KPI Label (Aliases) (copy)_796503826216357888] = &apos;mcvr2&apos;&#10;    THEN &apos;Fraction of sessions that ended in the menu page out of the sessions that visited the listing page.&apos;&#10;ELSEIF [KPI Label (Aliases) (copy)_796503826216357888] = &apos;mcvr3&apos;&#10;    THEN &apos;Fraction of sessions that ended in the checkout page out of the sessions that visited the menu page.&apos;&#10;ELSEIF [KPI Label (Aliases) (copy)_796503826216357888] = &apos;mcvr4&apos;&#10;    THEN &apos;Fraction of sessions that ended in a successful transaction out of the sessions that visited the checkout page.&apos;&#10;ELSEIF [KPI Label (Aliases) (copy)_796503826216357888] = &apos;Fleet Delay&apos;&#10;    THEN &apos;Average lateness in minutes of an order.&apos;&#10;END' />
            </column>
            <column caption='KPI Label (Dynamic Definition)' datatype='string' name='[KPI Label (Aliases) (copy)_796503826216357888]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [kpi_label] = &quot;cvr&quot; THEN &quot;Conversion Rate&quot;&#10;ELSEIF [kpi_label] = &quot;mcvr2&quot; THEN &quot;mcvr2&quot;&#10;ELSEIF [kpi_label] = &quot;mcvr3&quot; THEN &quot;mcvr3&quot;&#10;ELSEIF [kpi_label] = &quot;mcvr4&quot; THEN &quot;mcvr4&quot;&#10;ELSEIF STARTSWITH([kpi_label], &quot;delivery_fee&quot;) THEN &quot;Delivery Fee&quot;&#10;ELSEIF STARTSWITH([kpi_label], &quot;gfv&quot;) THEN &quot;GFV&quot;&#10;ELSEIF [kpi_label] = &quot;travel_time&quot; THEN &quot;Travel Time&quot;&#10;ELSEIF STARTSWITH([kpi_label], &quot;delivery_costs&quot;) THEN &quot;Delivery Costs&quot;&#10;ELSEIF STARTSWITH([kpi_label], &quot;profit_eur&quot;) THEN &quot;Profit&quot;&#10;ELSEIF STARTSWITH([kpi_label], &quot;revenue_eur&quot;) THEN &quot;Revenue&quot;&#10;ELSEIF [kpi_label] = &quot;fleet_delay&quot; THEN &quot;Fleet Delay&quot;&#10;ELSEIF [kpi_label] = &quot;delivery_distance&quot; THEN &quot;Delivery Distance&quot;&#10;ELSEIF [kpi_label] = &quot;user_cvr&quot; THEN &quot;User CVR&quot;&#10;ELSEIF [kpi_label] = &quot;orders_per_customer&quot; THEN &quot;Orders per Customer&quot;&#10;ELSE &quot;Orders per User&quot;&#10;END' />
            </column>
            <column caption='Kpi Label' datatype='string' name='[kpi_label]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_917467696436420610]' derivation='None' name='[none:Calculation_917467696436420610:nk]' pivot='key' type='nominal' />
            <column-instance column='[KPI Label (Aliases) (copy)_796503826216357888]' derivation='None' name='[none:KPI Label (Aliases) (copy)_796503826216357888:nk]' pivot='key' type='nominal' />
            <column-instance column='[test_name]' derivation='None' name='[none:test_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[treatment]' derivation='None' name='[none:treatment:nk]' pivot='key' type='nominal' />
            <column caption='Test Name' datatype='string' name='[test_name]' role='dimension' type='nominal' />
            <column caption='Treatment' datatype='string' name='[treatment]' role='dimension' type='nominal' />
          </datasource-dependencies>
