      <column caption='Treatment Dynamic Explanation (copy)' datatype='string' name='[ANOVA Dynamic Explanation (copy)_397653784156893184]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [treatment] = &quot;All&quot;&#10;    THEN &quot;Treatment = All means that all sessions that are part of the experiment are taken into account, including sessions that ended up with transactions from vendors that are not a part of the experiment.&quot;&#10;ELSEIF [treatment] = &quot;True&quot;&#10;    THEN &quot;Treatment = True means that only sessions that are associated with vendors that participate in the experiment are taken into account. Sessions that are not associated with a specific vendor (such as sessions in the listing page) cannot be assigned a treatment value (since the treatment refers to spefici vendors). For this reason some KPIs are not available when choosing this option. Please check the guide for more details.&quot;&#10;ELSE &quot;&quot;&#10;END' />
      </column>
      <column caption='Friendly Guide' datatype='string' name='[Calculation_1263541234825424896]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Hypothesis Testing - A Friendly Guide&quot;' />
      </column>
      <column caption='KPI Label (Aliases)' datatype='string' name='[Calculation_2041749161529237504]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [kpi_label] = &quot;cvr&quot; THEN &quot;Conversion Rate&quot;&#10;ELSEIF [kpi_label] = &quot;mcvr2&quot; THEN &quot;mcvr2&quot;&#10;ELSEIF [kpi_label] = &quot;mcvr3&quot; THEN &quot;mcvr3&quot;&#10;ELSEIF [kpi_label] = &quot;mcvr4&quot; THEN &quot;mcvr4&quot;&#10;ELSEIF [kpi_label] = &quot;delivery_fee_eur&quot; THEN &quot;Delivery Fee (Euro)&quot;&#10;ELSEIF [kpi_label] = &quot;delivery_fee_local&quot; THEN &quot;Delivery Fee (Local)&quot;&#10;ELSEIF [kpi_label] = &quot;gfv_eur&quot; THEN &quot;GFV (Euro)&quot;&#10;ELSEIF [kpi_label]= &quot;gfv_local&quot; THEN &quot;GFV (Local)&quot;&#10;ELSEIF [kpi_label] = &quot;travel_time&quot; THEN &quot;Travel Time&quot;&#10;ELSEIF [kpi_label] = &quot;delivery_costs_eur&quot; THEN &quot;Delivery Costs (Euro)&quot;&#10;ELSEIF [kpi_label] = &quot;profit_eur&quot; THEN &quot;Profit (Euro)&quot;&#10;ELSEIF [kpi_label] = &quot;revenue_eur&quot; THEN &quot;Revenue (Euro)&quot;&#10;ELSEIF [kpi_label] = &quot;delivery_costs_local&quot; THEN &quot;Delivery Costs (Local)&quot;&#10;ELSEIF [kpi_label] = &quot;profit_local&quot; THEN &quot;Profit (Local)&quot;&#10;ELSEIF [kpi_label] = &quot;revenue_local&quot; THEN &quot;Revenue (Local)&quot;&#10;ELSEIF [kpi_label] = &quot;fleet_delay&quot; THEN &quot;Fleet Delay&quot;&#10;ELSEIF [kpi_label] = &quot;delivery_distance&quot; THEN &quot;Delivery Distance&quot;&#10;ELSEIF [kpi_label] = &quot;user_cvr&quot; THEN &quot;User CVR&quot;&#10;ELSEIF [kpi_label] = &quot;orders_per_customer&quot; THEN &quot;Orders per Customer&quot;&#10;ELSEIF [kpi_label] = &quot;orders_per_user&quot; THEN &quot;Orders per User&quot;&#10;END' />
      </column>
      <column caption='Alpha Tooltip' datatype='string' name='[Calculation_265712398065946625]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Alpha is the upper threshold of P-Value, above which the result is considered insignificant&quot;' />
      </column>
      <column caption='P Values - ANOVA Title' datatype='string' name='[Calculation_3388958737982304260]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF NOT ISNULL([anova_p_value]) THEN &apos;ANOVA - P Values&apos; ELSE &apos;&apos; END' />
      </column>
      <column caption='ANOVA Dynamic Explanation' datatype='string' name='[Calculation_3701466333685420032]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([anova_p_value]) THEN &quot;&quot; ELSE &quot;Please note that both the ANOVA and the final P-Values are necessary to determine significance of the result. For more detailed explanation, please refer to the notes tab or to the more detailed friendly guide (linked above)&quot; END' />
      </column>
      <column caption='Significance Bottom Line' datatype='string' name='[Calculation_3751287402078126081]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF&#10;  (&#10;     (&#10;        [p_value] &lt;= [Parameters].[Parameter 4]&#10;        AND&#10;        [anova_p_value] &lt;= [Parameters].[Parameter 4]&#10;     )&#10;      OR &#10;     (&#10;        [p_value] &lt;= [Parameters].[Parameter 4]&#10;        AND&#10;        ISNULL([anova_p_value])&#10;     )&#10;  )&#10;THEN &quot;Statistically Significant&quot;&#10;ELSE &quot;Statistically Insignificant&quot;&#10;END' />
      </column>
      <column caption='Currency View KPI Filter' datatype='boolean' name='[Calculation_397653784191987715]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([Calculation_556335294232023042] = &quot;Euro&quot; AND NOT ENDSWITH ([Calculation_2041749161529237504], &quot;(Local)&quot;)) THEN TRUE&#10;ELSEIF ([Calculation_556335294232023042] = &quot;Local&quot; AND NOT ENDSWITH ([Calculation_2041749161529237504], &quot;(Euro)&quot;)) THEN TRUE&#10;END' />
      </column>
      <column caption='P Values - ANOVA Bottom Line' datatype='string' name='[Calculation_4974014701203705856]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [anova_p_value] &lt;= [Parameters].[Parameter 4] THEN &quot;Significance&quot; ELSE &quot;Insignificant&quot; END' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_5347250524662693888]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Currency View' datatype='string' name='[Calculation_556335294232023042]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 5]' />
      </column>
      <column caption='Selected test status' datatype='boolean' name='[Calculation_5843420528886534145]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 6] = [status]' />
      </column>
      <column caption='Type of Analysis' datatype='string' name='[Calculation_5874805028430352384]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
      </column>
      <column caption='Variant Count' datatype='integer' name='[Calculation_681732403392458758]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([variant_a])' />
      </column>
      <column caption='Dummy Field' datatype='integer' name='[Calculation_796503826225192962]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF FALSE THEN 0 ELSE NULL END' />
      </column>
      <column caption='P Value Exists' datatype='boolean' name='[Calculation_796503826246000643]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF NOT ISNULL([p_value]) THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Mean Delta (Percent)' datatype='real' name='[Calculation_917467696420880385]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [variant_a] &lt;&gt; [variant_b] THEN 100*([mean_b]-[mean_a])/ABS([mean_b]) END' />
      </column>
      <column caption='KPI Definitions' datatype='string' name='[Calculation_917467696436420610]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [KPI Label (Aliases) (copy)_796503826216357888] = &apos;Delivery Costs&apos;&#10;    THEN &apos;The total riders costs per order. Obtained by summing the weekly costs by city and repartitioning them per delivery based on the total time spent on that single delivery including the idle_time, then summing up the cost of all deliveries for order.&apos;&#10;ELSEIF [KPI Label (Aliases) (copy)_796503826216357888] = &apos;Delivery Distance&apos;&#10;    THEN &apos;The Manhattan distance (km) between the vendor location coordinates and customer location coordinates. This distance does not take into account potential stacked deliveries, and it is not the traveled distance. This KPI is only available for OD orders.&apos;&#10;ELSEIF [KPI Label (Aliases) (copy)_796503826216357888] = &apos;Delivery Fee&apos;&#10;    THEN &apos;The supposed-to-be-paid delivery fee of the order placed from the backend. This may differ from the actual delivery fee paid in the case of local marketing campaigns that are not signalled in central-dwh.orders.&apos;&#10;ELSEIF [KPI Label (Aliases) (copy)_796503826216357888] = &apos;GFV&apos;&#10;    THEN &apos;Gross Food Value of the order placed from the backend.&apos;&#10;ELSEIF [KPI Label (Aliases) (copy)_796503826216357888] = &apos;Revenue&apos;&#10;    THEN &apos;The total income of an order. It’s the sum of the delivery fee (including VAT), commission and the vendor fee.&apos;&#10;ELSEIF [KPI Label (Aliases) (copy)_796503826216357888] = &apos;Profit&apos;&#10;    THEN &apos;The revenue of an order, after deducting the delivery costs.&apos;&#10;ELSEIF [KPI Label (Aliases) (copy)_796503826216357888] = &apos;Travel Time&apos;&#10;    THEN &apos;The time (min) it takes the rider to travel from vendor location coordinates to the customers. This KPI is only available for OD orders.&apos;&#10;ELSEIF [KPI Label (Aliases) (copy)_796503826216357888] = &apos;User CVR&apos;&#10;    THEN &apos;Fraction of the users that ended up turning into customers. Calculated as the number of distinct customers divided by the number of distinct users.&apos;&#10;ELSEIF [KPI Label (Aliases) (copy)_796503826216357888] = &apos;Orders per User&apos;&#10;    THEN &apos;Number of orders divided by number of distinct users.&apos;&#10;ELSEIF [KPI Label (Aliases) (copy)_796503826216357888] = &apos;Orders per Customer&apos;&#10;    THEN &apos;Number of orders divided by number of distinct customers.&apos;&#10;ELSEIF [KPI Label (Aliases) (copy)_796503826216357888] = &apos;Conversion Rate&apos;&#10;    THEN &apos;Fraction of sessions that ended in a successful transaction. Calculated as the number of distinct transactions divided by the number of distinct session_id’s.&apos;&#10;ELSEIF [KPI Label (Aliases) (copy)_796503826216357888] = &apos;mcvr2&apos;&#10;    THEN &apos;Fraction of sessions that ended in the menu page out of the sessions that visited the listing page.&apos;&#10;ELSEIF [KPI Label (Aliases) (copy)_796503826216357888] = &apos;mcvr3&apos;&#10;    THEN &apos;Fraction of sessions that ended in the checkout page out of the sessions that visited the menu page.&apos;&#10;ELSEIF [KPI Label (Aliases) (copy)_796503826216357888] = &apos;mcvr4&apos;&#10;    THEN &apos;Fraction of sessions that ended in a successful transaction out of the sessions that visited the checkout page.&apos;&#10;ELSEIF [KPI Label (Aliases) (copy)_796503826216357888] = &apos;Fleet Delay&apos;&#10;    THEN &apos;Average lateness in minutes of an order.&apos;&#10;END' />
      </column>
      <column caption='KPI Label (Dynamic Definition)' datatype='string' name='[KPI Label (Aliases) (copy)_796503826216357888]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [kpi_label] = &quot;cvr&quot; THEN &quot;Conversion Rate&quot;&#10;ELSEIF [kpi_label] = &quot;mcvr2&quot; THEN &quot;mcvr2&quot;&#10;ELSEIF [kpi_label] = &quot;mcvr3&quot; THEN &quot;mcvr3&quot;&#10;ELSEIF [kpi_label] = &quot;mcvr4&quot; THEN &quot;mcvr4&quot;&#10;ELSEIF STARTSWITH([kpi_label], &quot;delivery_fee&quot;) THEN &quot;Delivery Fee&quot;&#10;ELSEIF STARTSWITH([kpi_label], &quot;gfv&quot;) THEN &quot;GFV&quot;&#10;ELSEIF [kpi_label] = &quot;travel_time&quot; THEN &quot;Travel Time&quot;&#10;ELSEIF STARTSWITH([kpi_label], &quot;delivery_costs&quot;) THEN &quot;Delivery Costs&quot;&#10;ELSEIF STARTSWITH([kpi_label], &quot;profit_eur&quot;) THEN &quot;Profit&quot;&#10;ELSEIF STARTSWITH([kpi_label], &quot;revenue_eur&quot;) THEN &quot;Revenue&quot;&#10;ELSEIF [kpi_label] = &quot;fleet_delay&quot; THEN &quot;Fleet Delay&quot;&#10;ELSEIF [kpi_label] = &quot;delivery_distance&quot; THEN &quot;Delivery Distance&quot;&#10;ELSEIF [kpi_label] = &quot;user_cvr&quot; THEN &quot;User CVR&quot;&#10;ELSEIF [kpi_label] = &quot;orders_per_customer&quot; THEN &quot;Orders per Customer&quot;&#10;ELSE &quot;Orders per User&quot;&#10;END' />
      </column>
      <column caption='P-value vs Alpha (copy)' datatype='string' name='[P-value vs Alpha (copy)_4554335559267631105]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [p_value] &lt;= [Parameters].[Parameter 4] then &apos;green&apos; else &apos;red&apos; end' />
      </column>
      <column caption='Alpha (α)' datatype='string' name='[Selected Test Name (copy)_3390295792716660737]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Alpha (α)&apos;' />
      </column>
