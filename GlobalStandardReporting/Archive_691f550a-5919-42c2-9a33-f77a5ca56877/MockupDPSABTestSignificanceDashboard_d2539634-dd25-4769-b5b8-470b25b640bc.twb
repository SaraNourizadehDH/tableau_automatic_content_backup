              <calculation class='tableau' formula='IF [kpi_label] = &quot;cvr&quot; THEN &quot;Conversion Rate&quot;&#10;ELSEIF [kpi_label] = &quot;mcvr2&quot; THEN &quot;mcvr2&quot;&#10;ELSEIF [kpi_label] = &quot;mcvr3&quot; THEN &quot;mcvr3&quot;&#10;ELSEIF [kpi_label] = &quot;mcvr4&quot; THEN &quot;mcvr4&quot;&#10;ELSEIF [kpi_label] = &quot;delivery_fee_eur&quot; THEN &quot;Delivery Fee (Euro)&quot;&#10;ELSEIF [kpi_label] = &quot;delivery_fee_local&quot; THEN &quot;Delivery Fee (Local)&quot;&#10;ELSEIF [kpi_label] = &quot;gfv_eur&quot; THEN &quot;GFV (Euro)&quot;&#10;ELSEIF [kpi_label]= &quot;gfv_local&quot; THEN &quot;GFV (Local)&quot;&#10;ELSEIF [kpi_label] = &quot;travel_time&quot; THEN &quot;Travel Time&quot;&#10;ELSEIF [kpi_label] = &quot;delivery_costs_eur&quot; THEN &quot;Delivery Costs (Euro)&quot;&#10;ELSEIF [kpi_label] = &quot;profit_eur&quot; THEN &quot;Profit (Euro)&quot;&#10;ELSEIF [kpi_label] = &quot;revenue_eur&quot; THEN &quot;Revenue (Euro)&quot;&#10;ELSEIF [kpi_label] = &quot;delivery_costs_local&quot; THEN &quot;Delivery Costs (Local)&quot;&#10;ELSEIF [kpi_label] = &quot;profit_local&quot; THEN &quot;Profit (Local)&quot;&#10;ELSEIF [kpi_label] = &quot;revenue_local&quot; THEN &quot;Revenue (Local)&quot;&#10;ELSEIF [kpi_label] = &quot;fleet_delay&quot; THEN &quot;Fleet Delay&quot;&#10;ELSEIF [kpi_label] = &quot;delivery_distance&quot; THEN &quot;Delivery Distance&quot;&#10;ELSEIF [kpi_label] = &quot;user_cvr&quot; THEN &quot;User CVR&quot;&#10;ELSEIF [kpi_label] = &quot;orders_per_customer&quot; THEN &quot;Orders per Customer&quot;&#10;ELSEIF [kpi_label] = &quot;orders_per_user&quot; THEN &quot;Orders per User&quot;&#10;END' />
