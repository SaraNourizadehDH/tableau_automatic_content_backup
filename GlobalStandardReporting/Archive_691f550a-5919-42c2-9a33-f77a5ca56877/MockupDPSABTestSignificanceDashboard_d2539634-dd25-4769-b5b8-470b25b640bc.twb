    <worksheet name='KPI Dynamic Definition'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='12'>&lt;</run>
            <run bold='true' fontsize='12'>[federated.1pu7wmd181yc111ags2hq081num9].[none:KPI Label (Aliases) (copy)_796503826216357888:nk]</run>
            <run bold='true' fontsize='12'>&gt;:</run>
