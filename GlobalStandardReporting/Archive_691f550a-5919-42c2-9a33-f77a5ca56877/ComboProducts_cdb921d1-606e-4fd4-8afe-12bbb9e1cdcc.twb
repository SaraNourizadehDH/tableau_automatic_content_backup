      <column caption='partition_date' datatype='string' name='[Calculation_146789255784677377]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;WHEN &apos;Day&apos; THEN &#10;    STR(DATEPART(&apos;year&apos;, [date])) + STR(&apos;-&apos;) + STR(DATEPART(&apos;month&apos;, [date])) + STR(&apos;-&apos;) + STR(DATEPART(&apos;day&apos;, [date]))&#10;&#9;&#10;WHEN &apos;Week&apos; THEN &#10;&#9;STR(DATEPART(&apos;year&apos;, DATETRUNC(&apos;week&apos;,[date]))) + STR(&quot;-W&quot;) &#10;&#9;+ STR(DATEPART(&apos;week&apos;,[date]))&#10;&#10;WHEN &apos;Month&apos; THEN STR(DATEPART(&apos;year&apos;, [date])) &#10;&#9;+ STR(&quot;-&quot;) &#10;&#9;+ IF DATEPART(&apos;month&apos;, [date]) &lt; 10 THEN STR(&quot;0&quot;) ELSE STR(&quot;&quot;) END&#10;&#9;+ STR(DATEPART(&apos;month&apos;, [date]))&#10;&#10;WHEN &apos;Quarter&apos; THEN STR(DATEPART(&apos;year&apos;, [date])) + STR(&quot;-Q&quot;) + STR(DATEPART(&apos;quarter&apos;, [date]))&#10;WHEN &apos;Year&apos; THEN STR(DATEPART(&apos;year&apos;, [date]))&#10;END' />
      </column>
