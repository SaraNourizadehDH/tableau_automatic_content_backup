      </column>
      <column caption='Shade Calculation' datatype='integer' name='[Calculation_1993265082771169282]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX(IIF([session_datetimehour]&gt;=DATEADD(&apos;hour&apos;,-48,NOW()),1,NULL))' />
      </column>
      <column caption='p75 6h mavg' datatype='real' name='[Calculation_4494944315560947712]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(AVG([pct75_load_time]), -6, 0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Date in param range' datatype='boolean' name='[Calculation_4494944315564818436]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[session_date]&gt;=[Parameters].[95th Pctl (copy)]&#10;and &#10;[session_date]&lt;=[Parameters].[Date from (copy)_4494944315563782147]' />
      </column>
      <column caption='Datediff Flag' datatype='boolean' name='[Calculation_5845813079397289985]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,DATEADD(&apos;hour&apos;,1, [session_datetimehour]), TODAY())&gt;=1' />
      </column>
      <column caption='Sessions Error, %' datatype='real' name='[Calculation_6088655626611642368]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IIF(CONTAINS([end_load_event],&apos;failed&apos;), [sessions], 0))/sum([sessions])' />
      </column>
