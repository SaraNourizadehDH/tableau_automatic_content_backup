          </datasources>
          <datasource-dependencies datasource='federated.1mztzvx0vxvva0187mnn31ap9vjx'>
            <column caption='Sessions Fail Rate %' datatype='real' name='[Calculation_4204462132141334528]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([end_load_event] = &apos;plugin_load_failed&apos;, [sessions], 0))&#10;/&#10;sum([sessions])' />
            </column>
            <column caption='[MoM Current month 50pct median]/[MoM Prev month 50pct median]-1' datatype='real' name='[Calculation_4204462132151734293]' role='measure' type='quantitative' user:unnamed='pct50-MoM'>
              <calculation class='tableau' formula='[WoW Current week 50pct median (copy)_4204462132150804495]/[MoM Current month 50pct median (copy)_4204462132151201810]-1' />
            </column>
            <column caption='MoM Current Month Flag ' datatype='boolean' name='[Current Week Flag (copy)_4204462132144431107]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[session_date],TODAY())&lt;=30' />
            </column>
            <column caption='MoM Prev month 50pct median' datatype='real' name='[MoM Current month 50pct median (copy)_4204462132151201810]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MEDIAN(iif([WoW Prev Week Flag  (copy)_4204462132144611332],[pct50_load_time],NULL))' />
            </column>
            <column caption='MoM Current month 50pct median' datatype='real' name='[WoW Current week 50pct median (copy)_4204462132150804495]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MEDIAN(iif([Current Week Flag (copy)_4204462132144431107],[pct50_load_time],NULL))' />
            </column>
            <column caption='MoM Prev Month Flag  ' datatype='boolean' name='[WoW Prev Week Flag  (copy)_4204462132144611332]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[session_date],TODAY())&gt;30 and DATEDIFF(&apos;day&apos;,[session_date],TODAY())&lt;=60' />
            </column>
