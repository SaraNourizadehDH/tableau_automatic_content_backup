      <table>
        <view>
          <datasources>
            <datasource caption='vp_ga_performance_agg_rl v1' name='federated.1mztzvx0vxvva0187mnn31ap9vjx' />
          </datasources>
          <datasource-dependencies datasource='federated.1mztzvx0vxvva0187mnn31ap9vjx'>
            <column caption='Sessions Fail Rate %' datatype='real' name='[Calculation_4204462132141334528]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([end_load_event] = &apos;plugin_load_failed&apos;, [sessions], 0))&#10;/&#10;sum([sessions])' />
            </column>
            <column caption='WoW Current Week Flag' datatype='boolean' name='[Calculation_4204462132144054273]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[session_date],TODAY())&lt;=7' />
            </column>
            <column caption='WoW Current week 50pct median' datatype='real' name='[Calculation_4204462132144820229]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MEDIAN(iif([Calculation_4204462132144054273],[pct50_load_time],NULL))' />
            </column>
            <column caption='[WoW Current week 50pct median]/[WoW Prev week 50pct median]-1' datatype='real' name='[Calculation_4204462132149092364]' role='measure' type='quantitative' user:unnamed='Overall - Stats (2)'>
              <calculation class='tableau' formula='[Calculation_4204462132144820229]/[WoW Current week 50pct median (copy)_4204462132145811464]-1' />
            </column>
            <column caption='WoW Prev Week Flag ' datatype='boolean' name='[Current Week Flag (copy)_4204462132144275458]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[session_date],TODAY())&gt;7 and DATEDIFF(&apos;day&apos;,[session_date],TODAY())&lt;=14' />
            </column>
            <column caption='WoW Prev week 50pct median' datatype='real' name='[WoW Current week 50pct median (copy)_4204462132145811464]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MEDIAN(iif([Current Week Flag (copy)_4204462132144275458],[pct50_load_time],NULL))' />
            </column>
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Device Category' datatype='string' name='[device_category]' role='dimension' type='nominal' />
            <column caption='End Load Event' datatype='string' name='[end_load_event]' role='dimension' type='nominal' />
            <column datatype='string' name='[event_source]' role='dimension' type='nominal' />
