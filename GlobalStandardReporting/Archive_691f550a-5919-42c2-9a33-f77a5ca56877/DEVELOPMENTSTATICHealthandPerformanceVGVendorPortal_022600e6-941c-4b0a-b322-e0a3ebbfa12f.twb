            <column-instance column='[MoM Prev month 95pct median (copy)_2904258868213452801]' derivation='User' name='[usr:MoM Prev month 95pct median (copy)_2904258868213452801:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1mztzvx0vxvva0187mnn31ap9vjx].[Exclusions (First Load Flag,HOUR(Session Datetimehour))]'>
            <groupfilter function='except' user:ui-domain='database' user:ui-enumeration='exclusive' user:ui-marker='enumerate'>
              <groupfilter function='crossjoin'>
