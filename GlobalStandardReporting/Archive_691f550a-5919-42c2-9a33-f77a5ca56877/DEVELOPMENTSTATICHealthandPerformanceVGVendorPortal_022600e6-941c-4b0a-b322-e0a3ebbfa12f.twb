      <column caption='Shade_Calculation' datatype='integer' name='[Calculation_1823113459265548289]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX(IIF([session_datetimehour]&gt;=DATEADD(&apos;hour&apos;,-48,NOW()),1,NULL))' />
      </column>
      <column caption='Sessions Fail Rate %' datatype='real' name='[Calculation_4204462132141334528]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(iif([end_load_event] = &apos;plugin_load_failed&apos;, [sessions], 0))&#10;/&#10;sum([sessions])' />
      </column>
      <column caption='WoW Current Week Flag' datatype='boolean' name='[Calculation_4204462132144054273]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[session_date],TODAY())&lt;=7' />
      </column>
      <column caption='WoW Current week 50pct median' datatype='real' name='[Calculation_4204462132144820229]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MEDIAN(iif([Calculation_4204462132144054273],[pct50_load_time],NULL))' />
      </column>
      <column caption='Meta - Created by' datatype='string' name='[Calculation_4204462132157345817]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Created by:&quot;' />
      </column>
      <column caption='p75 sec group' datatype='string' name='[Calculation_4233242951649247232]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF MEDIAN([pct75_load_time]) &lt;= 1.5 then &apos;0-1.5sec&apos;&#10;ELSEIF  MEDIAN([pct75_load_time]) &lt;= 2.5 then &apos;1.5-2.5sec&apos;&#10;ELSEIF MEDIAN([pct75_load_time]) &lt;= 5 then &apos;2.5-5sec&apos;&#10;ELSE &apos;more than 5 sec&apos;&#10;END' />
      </column>
      <column caption='Date in param range' datatype='boolean' name='[Calculation_4494944315566206981]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[session_date]&gt;=[Parameters].[95th Pctl (copy)]&#10;and &#10;[session_date]&lt;=[Parameters].[Date from (copy)_4494944315563782147]' />
      </column>
      <column caption='Meta - Creation date' datatype='string' name='[Created by: (copy)_4204462132157763610]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Creation date:&quot;' />
      </column>
      <column caption='WoW Prev Week Flag ' datatype='boolean' name='[Current Week Flag (copy)_4204462132144275458]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[session_date],TODAY())&gt;7 and DATEDIFF(&apos;day&apos;,[session_date],TODAY())&lt;=14' />
      </column>
      <column caption='MoM Current Month Flag ' datatype='boolean' name='[Current Week Flag (copy)_4204462132144431107]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[session_date],TODAY())&lt;=30' />
