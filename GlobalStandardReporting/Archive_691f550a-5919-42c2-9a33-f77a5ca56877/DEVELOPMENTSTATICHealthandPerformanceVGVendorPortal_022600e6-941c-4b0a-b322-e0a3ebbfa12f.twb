              <calculation class='tableau' formula='MAX(IIF([session_datetimehour]&gt;=DATEADD(&apos;hour&apos;,-48,NOW()),1,NULL))' />
            </column>
            <column caption='WINDOW_AVG(MEDIAN([pct90_load_time]), -12, 0)' datatype='real' name='[Calculation_2904258868213002240]' role='measure' type='quantitative' user:unnamed='Overall - Stats'>
              <calculation class='tableau' formula='WINDOW_AVG(MEDIAN([pct90_load_time]), -12, 0)'>
                <table-calc ordering-type='Rows' />
