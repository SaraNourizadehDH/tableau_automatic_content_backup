          <datasource-dependencies datasource='federated.1mztzvx0vxvva0187mnn31ap9vjx'>
            <column caption='[WoW Current week 90pct median]/[WoW Prev week 90pct median]-1' datatype='real' name='[Calculation_2904258868213936133]' role='measure' type='quantitative' user:unnamed='pct95-WoW'>
              <calculation class='tableau' formula='[WoW Current week 95pct median (copy)_2904258868213616643]/[WoW Prev week 95pct median (copy)_2904258868213686276]-1' />
            </column>
            <column caption='WoW Current Week Flag' datatype='boolean' name='[Calculation_4204462132144054273]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[session_date],TODAY())&lt;=7' />
            </column>
            <column caption='WoW Prev Week Flag ' datatype='boolean' name='[Current Week Flag (copy)_4204462132144275458]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[session_date],TODAY())&gt;7 and DATEDIFF(&apos;day&apos;,[session_date],TODAY())&lt;=14' />
            </column>
            <column caption='WoW Current week 90pct median' datatype='real' name='[WoW Current week 95pct median (copy)_2904258868213616643]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MEDIAN(iif([Calculation_4204462132144054273],[pct90_load_time],NULL))' />
            </column>
            <column caption='WoW Prev week 90pct median' datatype='real' name='[WoW Prev week 95pct median (copy)_2904258868213686276]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MEDIAN(iif([Current Week Flag (copy)_4204462132144275458],[pct90_load_time],NULL))' />
            </column>
