          <datasource-dependencies datasource='federated.1i7j65y19p2e641cwqnkl0de5p1b'>
            <column caption='% Final Delivery Fee Not Dps' datatype='real' name='[Calculation_1290562833035808768]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([final_delivery_fee_not_dps]) / SUM([total_orders])' />
            </column>
            <column caption='% Final Service Fee Not Dps' datatype='real' name='[Calculation_51228506652872704]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([final_service_fee_not_dps]) / SUM([total_orders])' />
            </column>
            <column caption='% Dps Not Called For Delivery Fee' datatype='real' name='[Calculation_51228506653028353]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dps_not_called_for_delivery_fee]) / SUM([total_orders])' />
            </column>
            <column caption='% Dps Not Called For Delivery Fee Vendor Delivery' datatype='real' name='[Calculation_51228506653212674]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dps_not_called_for_delivery_fee_vendor_delivery]) / SUM([total_orders])' />
            </column>
            <column caption='% Dps Delivery Fee Overwritten' datatype='real' name='[Calculation_51228506653650947]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dps_delivery_fee_overwritten]) / SUM([total_orders])' />
            </column>
            <column caption='% Non Dps Delivery Fee Discount' datatype='real' name='[Calculation_51228506653810692]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([non_dps_delivery_fee_discount]) / SUM([total_orders])' />
            </column>
            <column caption='% Joker Discount' datatype='real' name='[Calculation_51228506653978629]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([joker_discount]) / SUM([total_orders])' />
            </column>
            <column caption='% Non Dps Increase Py Prio Fee' datatype='real' name='[Calculation_51228506654146566]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([non_dps_increase_py_prio_fee]) / SUM([total_orders])' />
            </column>
            <column caption='% Non Dps Delivery Fee Increase' datatype='real' name='[Calculation_51228506654277639]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([non_dps_delivery_fee_increase]) / SUM([total_orders])' />
