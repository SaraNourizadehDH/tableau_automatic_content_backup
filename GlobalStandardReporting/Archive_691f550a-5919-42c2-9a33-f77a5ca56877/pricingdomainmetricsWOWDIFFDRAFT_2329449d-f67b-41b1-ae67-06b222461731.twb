          </datasources>
          <datasource-dependencies datasource='federated.1i7j65y19p2e641cwqnkl0de5p1b'>
            <column caption='Share spent on HVA-s' datatype='real' name='[Calculation_1157284424741978117]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([marketing_discount] - [vf_total_discount]) = 0 THEN 0 ELSE &#10;SUM([Calculation_1664713431330885635]) / SUM([marketing_discount]  - [vf_total_discount]) END' />
            </column>
            <column caption='Fdnc Discount ' datatype='real' name='[Calculation_1290562833053220865]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1664713431330885635]' />
            </column>
            <column caption='Spent on HVA-s' datatype='real' name='[Calculation_1664713431330885635]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[hva_discount]' />
            </column>
            <column caption='fdnc discount bool 2' datatype='boolean' name='[Calculation_302867137646379026]' role='measure' type='nominal'>
              <calculation class='tableau' formula='SUM([fdnc_discount]) &gt; 0' />
            </column>
            <column caption='VF Marketing Discount Share' datatype='real' name='[Calculation_54113622665175042]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([marketing_discount]) = 0 THEN 0 ELSE SUM([vf_marketing_discount]) / SUM([marketing_discount]) END' />
            </column>
            <column caption='VF Subscriber discount share' datatype='real' name='[Calculation_54113622665592835]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([vf_subscriber_discount]) = 0 THEN 0&#10;ELSE SUM([vf_subscriber_discount]) / SUM([subscriber_discounts] )&#10;END' />
            </column>
            <column caption='VF Total Discount yearly run rate' datatype='real' name='[Calculation_54113622689775622]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[vf_total_discount]*52' />
            </column>
