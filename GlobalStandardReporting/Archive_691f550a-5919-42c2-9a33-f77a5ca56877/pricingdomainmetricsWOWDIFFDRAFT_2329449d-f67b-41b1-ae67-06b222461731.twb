    <worksheet name='HVA w-o-w chart'>
      <layout-options>
        <title>
          <formatted-text>
            <run>HVA Week over Week Difference</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='dps_incentive_metrics (rl)' name='federated.1i7j65y19p2e641cwqnkl0de5p1b' />
          </datasources>
          <datasource-dependencies datasource='federated.1i7j65y19p2e641cwqnkl0de5p1b'>
            <column caption='Spent on HVA-s' datatype='real' name='[Calculation_1664713431330885635]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[hva_discount]' />
            </column>
            <column caption='Non zero wow difference filter' datatype='boolean' name='[Calculation_6380404408248692738]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ZN(SUM([total_spent_on_incentives])) - LOOKUP(ZN(SUM([total_spent_on_incentives])), 1) &gt; 0&#10;OR ZN(SUM([Calculation_1664713431330885635])) - LOOKUP(ZN(SUM([Calculation_1664713431330885635])), 1) &gt; 0&#10;OR ZN(SUM([subscriber_discounts])) - LOOKUP(ZN(SUM([subscriber_discounts])), 1) &gt; 0&#10;OR ZN(SUM([vf_total_discount])) - LOOKUP(ZN(SUM([vf_total_discount])), 1) &gt; 0 THEN TRUE END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Created Date Local' datatype='date' name='[created_date_local]' role='dimension' type='ordinal' />
