        <calculation class='tableau' formula='// real (negative) value for revenue breakdown&#10;- [Calculation_1664713431330885635]' />
      </column>
      <column caption='Share spent on HVA-s' datatype='real' name='[Calculation_1157284424741978117]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([marketing_discount] - [vf_total_discount]) = 0 THEN 0 ELSE &#10;SUM([Calculation_1664713431330885635]) / SUM([marketing_discount]  - [vf_total_discount]) END' />
      </column>
      <column caption='% Final Delivery Fee Not Dps' datatype='real' name='[Calculation_1290562833035808768]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([final_delivery_fee_not_dps]) / SUM([total_orders])' />
      </column>
      <column caption='Fdnc Discount ' datatype='real' name='[Calculation_1290562833053220865]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1664713431330885635]' />
      </column>
      <column caption='Spent on HVA-s' datatype='real' name='[Calculation_1664713431330885635]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[hva_discount]' />
      </column>
      <column caption='Total Spent On Incentives &gt; 0 BOOL' datatype='integer' datatype-customized='true' name='[Calculation_302867137636409347]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(IF SUM([total_spent_on_incentives]) &gt; 0 THEN TRUE ELSE FALSE END)' />
      </column>
      <column caption='Spent on HVA-s &gt; 0 BOOL' datatype='integer' datatype-customized='true' name='[Calculation_302867137637122053]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(IF SUM([Calculation_1664713431330885635]) &gt; 0 THEN TRUE ELSE FALSE END)' />
      </column>
      <column caption='VF Total Discount &gt; 0 BOOL' datatype='integer' datatype-customized='true' name='[Calculation_302867137638211597]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(IF SUM([vf_total_discount]) &gt; 0 THEN TRUE ELSE FALSE END)' />
      </column>
      <column caption='fdnc discount bool 2' datatype='boolean' name='[Calculation_302867137646379026]' role='measure' type='nominal'>
        <calculation class='tableau' formula='SUM([fdnc_discount]) &gt; 0' />
      </column>
      <column caption='Entities' datatype='string' name='[Calculation_3506122682470948864]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1664713431330885635] &gt; 0 THEN [entity_id]&#10;ELSEIF [vf_total_discount] &gt; 0 THEN [entity_id]&#10;ELSEIF [total_spent_on_incentives] &gt; 0  THEN [entity_id]&#10;ELSEIF [subscriber_discounts] &gt; 0 THEN [entity_id]&#10;ELSE &apos;&apos; END' />
      </column>
      <column caption='% Final Service Fee Not Dps' datatype='real' name='[Calculation_51228506652872704]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([final_service_fee_not_dps]) / SUM([total_orders])' />
      </column>
      <column caption='% Dps Not Called For Delivery Fee' datatype='real' name='[Calculation_51228506653028353]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dps_not_called_for_delivery_fee]) / SUM([total_orders])' />
      </column>
      <column caption='% Dps Not Called For Delivery Fee Vendor Delivery' datatype='real' name='[Calculation_51228506653212674]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dps_not_called_for_delivery_fee_vendor_delivery]) / SUM([total_orders])' />
      </column>
      <column caption='% Dps Delivery Fee Overwritten' datatype='real' name='[Calculation_51228506653650947]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dps_delivery_fee_overwritten]) / SUM([total_orders])' />
      </column>
      <column caption='% Non Dps Delivery Fee Discount' datatype='real' name='[Calculation_51228506653810692]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([non_dps_delivery_fee_discount]) / SUM([total_orders])' />
      </column>
      <column caption='% Joker Discount' datatype='real' name='[Calculation_51228506653978629]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([joker_discount]) / SUM([total_orders])' />
      </column>
      <column caption='% Non Dps Increase Py Prio Fee' datatype='real' name='[Calculation_51228506654146566]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([non_dps_increase_py_prio_fee]) / SUM([total_orders])' />
      </column>
      <column caption='% Non Dps Delivery Fee Increase' datatype='real' name='[Calculation_51228506654277639]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([non_dps_delivery_fee_increase]) / SUM([total_orders])' />
