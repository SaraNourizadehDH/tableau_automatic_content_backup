      <column caption='% Dps Service Fee Not Present' datatype='real' name='[Calculation_51228506654580745]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dps_service_fee_not_present]) / SUM([total_orders])' />
      </column>
      <column caption='Subscriber Discounts &gt; 0 BOOL' datatype='integer' name='[Calculation_51932197924843520]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(IF SUM([subscriber_discounts]) != 0 THEN TRUE ELSE FALSE END)' />
      </column>
      <column caption='Absolute Value of Total FDNC Discount' datatype='real' name='[Calculation_52354406213824512]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ABS([fdnc_discount])' />
      </column>
      <column caption='VF Marketing Discount Share' datatype='real' name='[Calculation_54113622665175042]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([marketing_discount]) = 0 THEN 0 ELSE SUM([vf_marketing_discount]) / SUM([marketing_discount]) END' />
      </column>
      <column caption='VF Subscriber discount share' datatype='real' name='[Calculation_54113622665592835]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([vf_subscriber_discount]) = 0 THEN 0&#10;ELSE SUM([vf_subscriber_discount]) / SUM([subscriber_discounts] )&#10;END' />
      </column>
      <column caption='VF Total Discount yearly run rate' datatype='real' name='[Calculation_54113622689775622]' role='measure' type='quantitative'>
