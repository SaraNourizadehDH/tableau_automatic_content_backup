      <column caption='Non zero wow difference filter' datatype='boolean' name='[Calculation_6380404408248692738]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ZN(SUM([total_spent_on_incentives])) - LOOKUP(ZN(SUM([total_spent_on_incentives])), 1) &gt; 0&#10;OR ZN(SUM([Calculation_1664713431330885635])) - LOOKUP(ZN(SUM([Calculation_1664713431330885635])), 1) &gt; 0&#10;OR ZN(SUM([subscriber_discounts])) - LOOKUP(ZN(SUM([subscriber_discounts])), 1) &gt; 0&#10;OR ZN(SUM([vf_total_discount])) - LOOKUP(ZN(SUM([vf_total_discount])), 1) &gt; 0 THEN TRUE END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
