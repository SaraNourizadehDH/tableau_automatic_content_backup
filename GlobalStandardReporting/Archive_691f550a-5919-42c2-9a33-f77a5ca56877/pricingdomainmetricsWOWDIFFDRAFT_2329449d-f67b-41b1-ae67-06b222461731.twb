      <column caption='DPS not called for DF %' datatype='real' name='[Calculation_54113622995431433]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dps_not_called_for_delivery_fee]) / SUM([total_orders])' />
