                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='606' forceUpdate='true' h='17077' id='37' type-v2='text' w='49120' x='880' y='81770'>
                  <formatted-text>
                    <run bold='true' fontcolor='#434343' fontname='Montserrat' fontsize='14'>Terminology</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#434343' fontname='Montserrat' fontsize='5'>​</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#434343' fontname='Montserrat' fontsize='8'>Bad Ids %</run>
                    <run fontcolor='#434343' fontname='Montserrat' fontsize='8'>: % of Session and Client Ids with wrong data e.g. </run>
                    <run fontcolor='#434343' fontname='Montserrat' fontsize='8' italic='true'>0, 1, anonymous, {{PerseusSessionId}}, NA, undefined</run>
                    <run fontcolor='#434343' fontname='Montserrat' fontsize='8'> etc.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#434343' fontname='Montserrat' fontsize='8'>Regex Unmatch %</run>
                    <run fontcolor='#434343' fontname='Montserrat' fontsize='8'>: Percent of unmatched session and client ids based on </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#434343' fontname='Montserrat' fontsize='8' italic='true'>{posixtimestamp}.{random_number_10digit}.{10char_random_string_lowercase}</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#434343' fontname='Montserrat' fontsize='8'>No Frontend Match %</run>
                    <run fontcolor='#434343' fontname='Montserrat' fontsize='8'>: % Backend session/client ids that were not matched with Frontend Perseus session/client ids</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#434343' fontname='Montserrat' fontsize='8'>Metrics are computed at the </run>
                    <run bold='true' fontcolor='#434343' fontname='Montserrat' fontsize='8'>request</run>
                    <run fontcolor='#434343' fontname='Montserrat' fontsize='8'> level. A session can have many request. &quot;Unique&quot; prefix calculates the metric at the </run>
                    <run bold='true' fontcolor='#434343' fontname='Montserrat' fontsize='8'>session</run>
                    <run fontcolor='#434343' fontname='Montserrat' fontsize='8'> level. Equivalent to No Fronted Match but uses a disctinct count of session ID.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2384' id='38' type-v2='text' w='50880' x='50000' y='81770'>
                  <formatted-text>
                    <run bold='true' fontcolor='#434343' fontname='Montserrat' fontsize='14'>Domain specific dashboards</run>
                  </formatted-text>
