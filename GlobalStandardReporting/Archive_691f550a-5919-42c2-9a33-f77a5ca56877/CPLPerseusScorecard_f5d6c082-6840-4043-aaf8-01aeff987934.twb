    <worksheet name='Compliance Timeline'>
      <table>
        <view>
          <datasources>
            <datasource caption='cpl_perseus_match_scorecard (cl)' name='federated.0a3v9zj0arqkyh14773qo19cixgx' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Overall' caption='Trend Switch' datatype='string' datatype-customized='true' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Overall&quot;'>
              <calculation class='tableau' formula='&quot;Overall&quot;' />
              <aliases>
                <alias key='&quot;Clients&quot;' value='Clients' />
                <alias key='&quot;Overall&quot;' value='Overall' />
                <alias key='&quot;Sessions&quot;' value='Sessions' />
              </aliases>
            </column>
            <column caption='Detail' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Platform&quot;'>
              <calculation class='tableau' formula='&quot;Platform&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0a3v9zj0arqkyh14773qo19cixgx'>
            <column caption='INCORRECT (Bad+NULL) Session %' datatype='real' default-format='p0.00%' name='[Calculation_3201426026013990914]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([bad_session_ids])+SUM([null_session_ids]))/SUM([request_count])' />
            </column>
            <column caption='Invalid %' datatype='real' default-format='p0.00%' name='[Calculation_4098416411883413508]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG( {INCLUDE [platform]: MAX([No Frontend Sessions matched % (copy)_3201426026017275914], [REGEX Sessions Mismatch % (copy)_3201426026016698376]) })' />
            </column>
            <column caption='Chosen Chart' datatype='string' name='[Calculation_4314448456575672349]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 2]' />
            </column>
            <column caption='Axis' datatype='string' name='[Calculation_4462926506797101056]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &quot;User Agent&quot; THEN [user_agent]&#10;WHEN &quot;Platform&quot; THEN [platform]&#10;WHEN &quot;Global&quot; THEN &quot;All&quot;&#10;ELSE &quot;All&quot;&#10;END' />
            </column>
            <column caption='REGEX Sessions Mismatch %' datatype='real' default-format='p0.00%' name='[INCORRECT (Bad+NULL) Session % (copy)_3201426026016358407]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([requests_session_non_regex])/SUM([request_count])' />
            </column>
            <column caption='No Frontend Clients matched %' datatype='real' default-format='p0.00%' name='[No Frontend Sessions matched % (copy)_3201426026017275914]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_frontend_client_matched])/SUM([request_count])' />
            </column>
            <column caption='No Frontend Sessions matched %' datatype='real' default-format='p0.00%' name='[REGEX Sessions Mismatch % (copy)_3201426026016698376]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_frontend_session_matched])/SUM([request_count])' />
            </column>
            <column caption='Bad Session Ids' datatype='integer' name='[bad_session_ids]' role='measure' type='quantitative' />
            <column caption='Created Date' datatype='date' name='[created_date]' role='dimension' type='ordinal' />
