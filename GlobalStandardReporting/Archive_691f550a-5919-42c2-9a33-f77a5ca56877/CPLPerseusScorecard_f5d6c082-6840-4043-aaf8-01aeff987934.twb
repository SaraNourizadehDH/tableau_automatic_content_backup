                <zone h='692' id='159' name='Unique Invalids' pane-specification-id='5' param='[federated.0a3v9zj0arqkyh14773qo19cixgx].[:Measure Names]' show-title='false' type-v2='color' w='26563' x='74317' y='23768'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
