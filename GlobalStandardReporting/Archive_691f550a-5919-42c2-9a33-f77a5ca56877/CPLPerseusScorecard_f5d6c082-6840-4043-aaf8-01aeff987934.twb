      <column caption='Invalid %' datatype='real' default-format='p0.00%' name='[Calculation_4098416411883413508]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG( {INCLUDE [platform]: MAX([No Frontend Sessions matched % (copy)_3201426026017275914], [REGEX Sessions Mismatch % (copy)_3201426026016698376]) })' />
