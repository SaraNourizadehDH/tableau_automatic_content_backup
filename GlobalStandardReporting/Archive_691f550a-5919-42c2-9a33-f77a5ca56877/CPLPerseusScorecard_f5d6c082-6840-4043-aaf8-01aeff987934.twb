      <column caption='1_L2W_No Frontend Client Matched' datatype='integer' name='[1_LW_No Frontend Client Matched (copy)_4314448456560889876]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [created_date] = [Last Week (copy)_4314448456553697283] THEN &#10;[no_frontend_client_matched] &#10;END' />
      </column>
      <column caption='1_L2W_No Frontend Session Matched' datatype='integer' name='[1_LW_No Frontend Session Matched (copy)_4314448456560889878]' role='measure' type='quantitative'>
