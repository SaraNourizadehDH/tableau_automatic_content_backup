      </column>
      <column caption='1_L2W_Request ID Count' datatype='integer' name='[1_LW_Request ID Count (copy)_4314448456560889880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [created_date] = [Last Week (copy)_4314448456553697283] &#10;THEN [request_count] &#10;END' />
      </column>
      <column caption='2_L2W_No Frontend Clients matched %' datatype='real' default-format='p0.00%' name='[2_LW_No Frontend Clients matched % (copy)_4314448456560889877]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([1_LW_No Frontend Client Matched (copy)_4314448456560889876])/SUM([1_LW_Request ID Count (copy)_4314448456560889880])' />
      </column>
      <column caption='2_L2W_No Frontend Sessions matched %' datatype='real' default-format='p0.00%' name='[2_LW_No Frontend Sessions matched % (copy)_4314448456560889879]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([1_LW_No Frontend Session Matched (copy)_4314448456560889878])/SUM([1_LW_Request ID Count (copy)_4314448456560889880])' />
      </column>
      <column caption='3_L2W_Compliance' datatype='real' default-format='p0.00%' name='[3_LW_Compliance (copy)_4314448456560889875]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG( {INCLUDE [platform]: MAX([2_LW_No Frontend Sessions matched % (copy)_4314448456560889879], [2_LW_No Frontend Clients matched % (copy)_4314448456560889877]) })' />
      </column>
      <column caption='4_WoW' datatype='real' default-format='p0.00%' name='[3_LW_Compliance (copy)_4314448456561889305]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Compliance (copy)_4314448456554377221] - [Today_Compliance (copy)_4314448456559124494]' />
      </column>
      <column caption='4_Wo2W' datatype='real' default-format='p0.00%' name='[3_WoW (copy)_4314448456562077723]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Compliance (copy)_4314448456554377221] - [3_LW_Compliance (copy)_4314448456560889875]' />
      </column>
