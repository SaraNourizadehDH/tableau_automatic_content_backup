          <datasource-dependencies datasource='Parameters'>
            <column caption='Color Slicer' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Stakeholder&quot;'>
              <calculation class='tableau' formula='&quot;Stakeholder&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.17dd36b1eydtyv12dlwrd01ub0cq'>
            <column caption='Contact Rate' datatype='real' default-format='p0.00%' name='[Calculation_1401675024322973702]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Volume of Contacts (copy)_1401675024322899973] / SUM([Orders (copy)_1401675024297992193])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Volume of Contacts' datatype='integer' name='[Calculation_1733815494038659073]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([contact_id])' />
            </column>
            <column caption='Color Slicer' datatype='string' name='[Calculation_1925781428173271041]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10; WHEN &apos;Global&apos; THEN [Calculation_1925781428175118340]&#10; WHEN &apos;Ownership&apos; THEN [ownership]&#10; WHEN &apos;Stakeholder&apos; THEN [stakeholder]&#10; WHEN &apos;Channel&apos; THEN [channel]&#10; WHEN &apos;CR Level 1&apos; THEN [contact_reason_l1]&#10; WHEN &apos;CR Level 2&apos; THEN [contact_reason_l2]&#10; WHEN &apos;CR Level 3&apos; THEN [contact_reason_l3]&#10;END' />
            </column>
            <column caption='Global' datatype='string' name='[Calculation_1925781428175118340]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;Global&apos;' />
            </column>
            <column caption='Contact Time Since Order Placed Buckets (in mins) ' datatype='string' name='[Contact Time Since Order Placed Buckets (in mins) (copy)_2652760924590317568]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [contact_time_since_order_placed_mins] &gt;= 120&#10;   THEN &apos;&gt;120&apos;&#10;ELSEIF [contact_time_since_order_placed_mins] &lt; -10&#10;   THEN &apos;&lt;-10&apos;&#10;  ELSE STR([contact_time_since_order_placed_buckets])&#10;END' />
            </column>
            <column caption='Orders per month per entity' datatype='integer' name='[Orders (copy)_1401675024297992193]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED MONTH([created_date_localtime]), [management_entity_group] : COUNTD([order_id])}' />
            </column>
            <column caption='Running_SUM(Volume of Contacts)' datatype='integer' name='[Volume of Contacts (copy)_1401675024322899973]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM(COUNT([contact_id]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
