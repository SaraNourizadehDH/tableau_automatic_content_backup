          <datasource-dependencies datasource='Clipboard_20220324T151630'>
            <column caption='% GMV uplift pre-post' datatype='real' default-format='p0.00%' name='[% Frequency uplift pre-post (copy)_456200577868668936]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#10;[Parameters].[Region Parameter] in (&quot;None&quot;, &quot;Region&quot;, &quot;Management Entity&quot;, &quot;Entity&quot;) then SUM([gmv_after]) / SUM([gmv_before]) - 1&#10;else NULL&#10;END' />
            </column>
            <column caption='Basket Value' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg Basket Value (copy)_2148779990289604609]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gbv_local]/[Calculation_461900456972935170])/[Calculation_1701375551519641600]' />
            </column>
