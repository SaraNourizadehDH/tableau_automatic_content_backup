              <calculation class='tableau' formula='IF &#13;&#10;[Parameters].[Region Parameter] = &apos;None&apos; THEN &apos;All&apos;&#13;&#10;ELSEIF [Parameters].[Region Parameter] = &apos;Business&apos; THEN [vertical_parent (group)]&#13;&#10;ELSEIF [Parameters].[Region Parameter] = &apos;Vertical Parent&apos; THEN [vertical_parent]&#13;&#10;ELSEIF [Parameters].[Region Parameter] = &apos;Vertical&apos; THEN [vertical_type]&#10;ELSEIF  [Parameters].[Region Parameter] = &quot;Management Entity&quot; then [management_entity]&#13;&#10;ELSEIF [Parameters].[Region Parameter] = &apos;Region&apos; THEN [region]&#13;&#10;ELSEIF [Parameters].[Region Parameter] = &apos;Entity&apos; THEN [global_entity_id]&#13;&#10;ELSEIF [Parameters].[Region Parameter] = &apos;Is own delivery&apos; THEN STR([is_own_delivery])&#10;END' />
