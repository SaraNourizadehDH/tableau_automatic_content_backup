          <datasource-dependencies datasource='Clipboard_20220324T151630'>
            <column caption='% Frequency uplift pre-post M-0' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[% Frequency uplift pre-post (copy)_649503545726369792]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#10;[Parameters].[Region Parameter] in (&quot;None&quot;, &quot;Region&quot;, &quot;Management Entity&quot;, &quot;Entity&quot;) then SUM([orders_after]*[Calculation_6845471467919159297]) / SUM([orders_before]*[Calculation_6845471467919159297]) - 1&#10;else NULL&#10;END&#10;//SUM(0)' />
            </column>
            <column caption='% Frequency uplift pre-post M-1' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[% Frequency uplift pre-post M-0 (copy)_649503545726545921]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#10;[Parameters].[Region Parameter] in (&quot;None&quot;, &quot;Region&quot;, &quot;Management Entity&quot;, &quot;Entity&quot;) then SUM([orders_after]*[is_current_month (copy)_6845471467919855618]) / SUM([orders_before]*[is_current_month (copy)_6845471467919855618]) - 1&#10;else NULL&#10;END&#10;//SUM(0)' />
            </column>
            <column caption='% Frequency uplift pre-post MoM' datatype='real' default-format='*#,##0.00%▲;-#,##0.00%▼' name='[% Frequency uplift pre-post M-1 (copy)_649503545726660611]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([% Frequency uplift pre-post (copy)_649503545726369792]) - ZN([% Frequency uplift pre-post M-0 (copy)_649503545726545921])' />
            </column>
            <column caption='% GMV uplift pre-post MoM' datatype='real' default-format='*#,##0.00%▲;-#,##0.00%▼' name='[% Frequency uplift pre-post MoM (copy)_649503545727180805]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([% GMV uplift pre-post (copy)_649503545726627842]) - ZN([% GMV uplift pre-post M-0 (copy)_649503545727037444])' />
            </column>
            <column caption='% GMV uplift pre-post M-0' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[% GMV uplift pre-post (copy)_649503545726627842]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#10;[Parameters].[Region Parameter] in (&quot;None&quot;, &quot;Region&quot;, &quot;Management Entity&quot;, &quot;Entity&quot;) &#10;then SUM([gmv_after]*[Calculation_6845471467919159297]) / SUM([gmv_before]*[Calculation_6845471467919159297]) - 1&#10;else NULL&#10;END' />
            </column>
            <column caption='% GMV uplift pre-post M-1' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[% GMV uplift pre-post M-0 (copy)_649503545727037444]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#10;[Parameters].[Region Parameter] in (&quot;None&quot;, &quot;Region&quot;, &quot;Management Entity&quot;, &quot;Entity&quot;) &#10;then SUM([gmv_after]*[is_current_month (copy)_6845471467919855618]) / SUM([gmv_before]*[is_current_month (copy)_6845471467919855618]) - 1&#10;else NULL&#10;END' />
            </column>
            <column caption='Avg. Fees per Order M-0' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg. Fees per Order (copy)_6605654790182129693]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Total Revenue Fees (copy 2)_6605654790181625882]*[Calculation_1701375551519641600]) / [Orders (copy)_6605654790178205700]' />
            </column>
            <column caption='Avg. Fees per Order M-1' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg. Fees per Order M-0 (copy)_6605654790182318110]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Total Revenue Fees M-0 (copy)_6605654790181769243]*[Calculation_1701375551519641600]) / [Orders M-0 (copy)_6605654790178332677]' />
            </column>
            <column caption='Basket Value M-0' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Basket Value (copy)_6605654790184312872]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gbv_local]/[Calculation_461900456972935170]*[Calculation_6845471467919159297])/[Calculation_1701375551519641600]' />
            </column>
            <column caption='Basket Value M-1' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Basket Value M-0 (copy)_6605654790184427561]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gbv_local]/[Calculation_461900456972935170]*[is_current_month (copy)_6845471467919855618])/[Calculation_1701375551519641600]' />
            </column>
            <column caption='Blank 3' datatype='integer' name='[Blank 2 (copy)_6644146490754879488]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF FALSE THEN 0 ELSE NULL END' />
            </column>
            <column caption='Blank 2' datatype='integer' name='[Blank DF (copy)_6595380917993209867]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF FALSE THEN 0 ELSE NULL END' />
            </column>
            <column caption='Aggregation' datatype='integer' name='[Calculation_1701375551519641600]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Include sales rev (copy)] THEN 1 ELSE SUM([orders]) END' />
            </column>
            <column caption='Choose a Brand Filter' datatype='boolean' name='[Calculation_411657190379372546]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 8] = &quot;All&quot; THEN TRUE&#10;ELSE [Parameters].[Parameter 8] = [management_entity]&#10;END' />
            </column>
            <column caption='Currency' datatype='real' name='[Calculation_461900456972935170]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Eur&apos; THEN [fx_rate_eur] ELSE 1 END' />
            </column>
            <column caption='Blank' datatype='integer' name='[Calculation_6595380917826830342]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF FALSE THEN 0 ELSE NULL END' />
            </column>
            <column caption='Last 12 month' datatype='date' name='[Calculation_6845471467918602240]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF &#10;[month] &gt;= DATEADD(&quot;month&quot;, -12, { MAX([month])}) &#10;THEN [month] &#10;END' />
            </column>
            <column caption='is_current_month' datatype='integer' name='[Calculation_6845471467919159297]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [month] = [Parameters].[Parameter 5] then 1 else 0 END' />
            </column>
            <column caption='Is_current_or_last_month' datatype='boolean' name='[Calculation_6845471467920150531]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_6845471467919159297] = 1 OR [is_current_month (copy)_6845471467919855618] = 1 THEN TRUE END' />
            </column>
            <column caption='MoM Label' datatype='string' name='[Calculation_6845471467925147656]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;MoM&quot;' />
            </column>
            <column caption='Churn Rate M-0' datatype='real' default-format='p0.00%' name='[Churn Rate (copy)_411657190383558666]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#10;[Parameters].[Region Parameter] in (&quot;None&quot;, &quot;Region&quot;, &quot;Management Entity&quot;, &quot;Entity&quot;) then AVG([churn_rate]*[Calculation_6845471467919159297])&#10;else NULL&#10;END' />
