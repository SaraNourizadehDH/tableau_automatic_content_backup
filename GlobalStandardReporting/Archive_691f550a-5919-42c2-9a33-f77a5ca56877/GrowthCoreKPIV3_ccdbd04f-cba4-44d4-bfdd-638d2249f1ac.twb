              <calculation class='tableau' formula='if [Parameters].[Parameter 3] = &quot;LucaNet&quot;&#10;THEN SUM([subscriber_order_gpo]/[Calculation_461900456972935170])/[GPO (copy)_1203657373197090822]&#10;ELSE NULL &#10;END' />
            </column>
            <column caption='Orders - % Subscribers ' datatype='real' default-format='p0.0%' name='[Orders - % Unprofitable (copy)_467670677587361792]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([subscriber_orders]) = 0 THEN NULL ELSE SUM([subscriber_orders])/[Calculation_1203657373982105622] END' />
            </column>
            <column caption='% Frequency uplift pre-post' datatype='real' default-format='p0.00%' name='[__% Frequency uplift pre-post (copy)_456200577861742599]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#10;[Parameters].[Region Parameter] in (&quot;None&quot;, &quot;Region&quot;, &quot;Management Entity&quot;, &quot;Entity&quot;) then SUM([orders_after]) / SUM([orders_before]) - 1&#10;else NULL&#10;END&#10;//SUM(0)' />
            </column>
