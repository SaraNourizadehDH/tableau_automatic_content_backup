    <worksheet name='FPAPAC-M0'>
      <table>
        <view>
          <datasources>
            <datasource caption='growth_report_monthy_orders_kpis' name='Clipboard_20220324T151630' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Clipboard_20220324T151630'>
            <column caption='Basket Value' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg Basket Value (copy)_2148779990289604609]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gbv_local]/[Calculation_461900456972935170])/[Calculation_1701375551519641600]' />
            </column>
            <column caption='Blank 3' datatype='integer' name='[Blank 2 (copy)_6644146490754879488]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF FALSE THEN 0 ELSE NULL END' />
            </column>
            <column caption='Blank 2' datatype='integer' name='[Blank DF (copy)_6595380917993209867]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF FALSE THEN 0 ELSE NULL END' />
            </column>
            <column caption='Subscription Users' datatype='integer' name='[Calculation_1203657373196431364]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//SUM(IF [is_subscriber_user] = TRUE THEN [customer_count] END)&#10;SUM(0)' />
            </column>
            <column caption='Incentivized Orders' datatype='integer' name='[Calculation_1203657373295960075]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([incentivized_orders])' />
            </column>
            <column caption='Orders_old' datatype='integer' name='[Calculation_1203657373982105622]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders])' />
            </column>
            <column caption='Aggregation' datatype='integer' name='[Calculation_1701375551519641600]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Include sales rev (copy)] THEN 1 ELSE SUM([orders]) END' />
            </column>
            <column caption='Total Revenue Fees' datatype='real' default-format='c#,##0&quot; €&quot;;-#,##0&quot; €&quot;' name='[Calculation_2125136128920334336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn([Calculation_461900456974057475])+zn([Delivery Fee (copy)_8398298537691168768])+zn([Calculation_461900456974262276])' />
            </column>
            <column caption='Orders - %' datatype='real' name='[Calculation_2522156532228009986]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='[Calculation_1203657373982105622]/ TOTAL([Calculation_1203657373982105622])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='inCPA' datatype='real' default-format='C1031%' name='[Calculation_456200577842241536]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_456200577842855937]/ [Calculation_456200577843027970]' />
            </column>
            <column caption='Total DH Incentives - Acquisition' datatype='real' name='[Calculation_456200577842855937]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([acquisition_carc_incentives]/[Calculation_461900456972935170])' />
            </column>
            <column caption='Incentivized Orders - Acquisition' datatype='integer' name='[Calculation_456200577843027970]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum([acquisition_incentivized_orders])' />
            </column>
            <column caption='Currency' datatype='real' name='[Calculation_461900456972935170]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Eur&apos; THEN [fx_rate_eur] ELSE 1 END' />
            </column>
            <column caption='MOV Fee' datatype='real' default-format='c#,##0&quot; €&quot;;-#,##0&quot; €&quot;' name='[Calculation_461900456974057475]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([mov_fee_local]/[Calculation_461900456972935170])/[Calculation_1701375551519641600]' />
            </column>
            <column caption='Service Fee' datatype='real' default-format='c#,##0&quot; €&quot;;-#,##0&quot; €&quot;' name='[Calculation_461900456974262276]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([service_fee_local]/[Calculation_461900456972935170])/[Calculation_1701375551519641600]' />
            </column>
            <column caption='GPO' datatype='real' default-format='c#,##0&quot; €&quot;;-#,##0&quot; €&quot;' name='[Calculation_496240410231099393]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &quot;Orders Profitability&quot;&#10;then  SUM([gpo_local]/[Calculation_461900456972935170])/[Calculation_1701375551519641600] &#10;else null end' />
            </column>
            <column caption='Take-in' datatype='real' default-format='c#,##0&quot; €&quot;;-#,##0&quot; €&quot;' name='[Calculation_4984288538969358336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &quot;Orders Profitability&quot;&#10;THEN SUM([take_in_local]/[Calculation_461900456972935170])/[Calculation_1701375551519641600]&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Orders - % with Service Fee' datatype='real' default-format='p0.0%' name='[Calculation_5180758103918157824]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_with_service_fee])/SUM([orders])' />
            </column>
            <column caption='Blank' datatype='integer' name='[Calculation_6595380917826830342]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF FALSE THEN 0 ELSE NULL END' />
            </column>
            <column caption='Last 12 month' datatype='date' name='[Calculation_6845471467918602240]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF &#10;[month] &gt;= DATEADD(&quot;month&quot;, -12, { MAX([month])}) &#10;THEN [month] &#10;END' />
            </column>
            <column caption='is_current_month' datatype='integer' name='[Calculation_6845471467919159297]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [month] = [Parameters].[Parameter 5] then 1 else 0 END' />
            </column>
            <column caption='Is_current_or_last_month' datatype='boolean' name='[Calculation_6845471467920150531]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_6845471467919159297] = 1 OR [is_current_month (copy)_6845471467919855618] = 1 THEN TRUE END' />
            </column>
            <column caption='Delivery Fee DH' datatype='real' default-format='c#,##0&quot; €&quot;;-#,##0&quot; €&quot;' name='[Delivery Fee (copy)_8398298537691168768]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_own_delivery] THEN [delivery_fee_local] ELSE 0 END/[Calculation_461900456972935170])/[Calculation_1701375551519641600]' />
            </column>
            <column caption='GMV' datatype='real' default-format='c#,##0&quot; €&quot;;-#,##0&quot; €&quot;' name='[FLGPO (copy)_6595380917824872451]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_local]/[Calculation_461900456972935170])/[Calculation_1701375551519641600]' />
            </column>
            <column caption='Subscription Orders' datatype='integer' default-format='n#,##0.00;-#,##0.00' name='[GPO (copy)_1203657373197090822]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([subscriber_orders])' />
            </column>
            <column caption='GPO Incentivized Orders' datatype='real' default-format='c#,##0.00&quot; €&quot;;-#,##0.00&quot; €&quot;' name='[GPO (copy)_6595380917828739080]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 3] = &quot;LucaNet&quot;&#10;then SUM([gpo_incentivized]/[Calculation_461900456972935170])/sum([incentivized_orders])&#10;else null &#10;end' />
            </column>
            <column caption='GPO Subscriber Orders' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[GPO Incentivized (copy)_467670677589696513]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 3] = &quot;LucaNet&quot;&#10;THEN SUM([subscriber_order_gpo]/[Calculation_461900456972935170])/[GPO (copy)_1203657373197090822]&#10;ELSE NULL &#10;END' />
            </column>
            <column caption='Revenue Reductions' datatype='real' default-format='c#,##0&quot; €&quot;;-#,##0&quot; €&quot;' name='[Incentives DH (copy)_625367030720004097]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([revenue_reductions_local]/[Calculation_461900456972935170])/[Calculation_1701375551519641600]' />
            </column>
            <column caption='Total DH Incentives/GMV (%) ' datatype='real' default-format='p0.0%' name='[Incentives DH/BV (%) (copy)_6595380917827588103]' role='measure' type='quantitative'>
