            <column caption='Churn Rate' datatype='real' default-format='p0.00%' name='[Calculation_160862963160846336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#10;[Parameters].[Region Parameter] in (&quot;None&quot;, &quot;Region&quot;, &quot;Management Entity&quot;, &quot;Entity&quot;) then AVG([churn_rate])&#10;else NULL&#10;END' />
            </column>
            <column caption='Aggregation' datatype='integer' name='[Calculation_1701375551519641600]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Include sales rev (copy)] THEN 1 ELSE SUM([orders]) END' />
            </column>
            <column caption='Total Revenue Fees' datatype='real' default-format='c#,##0&quot; €&quot;;-#,##0&quot; €&quot;' name='[Calculation_2125136128920334336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn([Calculation_461900456974057475])+zn([Delivery Fee (copy)_8398298537691168768])+zn([Calculation_461900456974262276])' />
            </column>
            <column caption='Orders - % Subscribers v2' datatype='real' default-format='p0.00%' name='[Calculation_2366641628522790916]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([subscription_orders_v2])/sum([market_orders_v2])' />
