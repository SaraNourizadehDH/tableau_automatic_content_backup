      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Retention rates' id='_5A024E536ADD4EBBAFDA429D8064408B'>
            <properties context=''>
              <relation connection='bigquery.1mr1fkn0pxu8xv1d61cry122x6yn' name='Custom SQL Query1' type='text'>WITH
retention_rate AS (
--retention = 
SELECT
  global_entity_id,
  date_month,
  COUNT(distinct CASE WHEN subscription_status = &apos;Subscriber&apos; AND NOT is_new_user THEN customer_id END) AS eom_active_subs,
  COUNT(distinct CASE WHEN NOT is_new_user THEN customer_id END) AS som_active_subs,
  COUNT(distinct customer_id) AS month_all_subs
FROM
  fulfillment-dwh-production.cl_mkt.bima_subscriptions_monthly
GROUP BY
  global_entity_id,
  date_month
)
SELECT
  retention_rate.global_entity_id,
  retention_rate.date_month,
  retention_rate.eom_active_subs,
  retention_rate.som_active_subs,
  retention_rate.month_all_subs,
  retention_rate.eom_active_subs / retention_rate.som_active_subs AS retention_rate,
  1 - (retention_rate.eom_active_subs / retention_rate.som_active_subs) AS churn_rate
FROM
  retention_rate
WHERE
  retention_rate.som_active_subs != 0 --excluding to avoid division errors when calculating the retention rates</relation>
            </properties>
            <properties context='extract'>
              <relation name='Custom SQL Query1' table='[Extract].[Custom SQL Query1]' type='table' />
            </properties>
          </object>
          <object caption='Subs Uplift' id='_8B7C9E33F1A0432AA01776CFA875EC8A'>
            <properties context=''>
              <relation connection='bigquery.01ti51m1e3eir313hy4zd05zgp38' name='Custom SQL Query2' type='text'>SELECT
  
  global_entity_id,
  cohort_month,
  MAX(customers) AS cohort_size,
  SUM(IF(period BETWEEN -3 AND -1, orders, 0)) AS orders_before,
  SUM(IF(period BETWEEN 0 AND 2, orders, 0)) AS orders_after,
  SUM(IF(period BETWEEN -3 AND -1, gmv, 0)) AS gmv_before,
  SUM(IF(period BETWEEN 0 AND 2, gmv, 0)) AS gmv_after
  FROM `fulfillment-dwh-production.rl_mkt.bima_subscriptions_monthly_uplift`
  WHERE DATE_DIFF(DATE_TRUNC(CURRENT_DATE(), MONTH), cohort_month, MONTH) &gt;&gt;= 3
  GROUP BY 1, 2</relation>
            </properties>
            <properties context='extract'>
              <relation name='Custom SQL Query2' table='[Extract].[Custom SQL Query2]' type='table' />
            </properties>
          </object>
          <object caption='Subscriptions Query V2' id='_A9AFC6AC914B468FB2159F5E648A781B'>
            <properties context=''>
              <relation connection='bigquery.1mr1fkn0pxu8xv1d61cry122x6yn' name='Custom SQL Query3' type='text'>SELECT
  date_month,
  segment,
  management_entity,
  global_entity_id,
  sub_entity,
  sum(subscription_flgpo_eur + monthly_subscription_fee_eur) as flgp_v2,
  sum(new_users + retained_users + returning_users) AS subscription_users_v2,
  sum(subscription_orders) AS subscription_orders_v2,
  sum(orders) AS market_orders_v2
FROM
  fulfillment-dwh-production.rl_mkt.bima_subscriptions_monthly_reporting
WHERE
  date_month &gt;&gt;= (&apos;2022-01-01&apos;)
GROUP BY
  date_month,
  segment,
  management_entity,
  global_entity_id,
  sub_entity</relation>
            </properties>
            <properties context='extract'>
              <relation name='Custom SQL Query3' table='[Extract].[Custom SQL Query3]' type='table' />
            </properties>
          </object>
          <object caption='growth_report_monthy_orders_kpis1' id='growth_report_monthy_orders_kpis_D4CBFE88316F456F9B955A58867C5E10'>
            <properties context=''>
              <relation join='inner' type='join'>
                <clause type='join'>
                  <expression op='='>
                    <expression op='[sl_growth_dashboard].[global_entity_id]' />
                    <expression op='[tableau_gsr_entitlements_marketing_management_global_entity_id].[global_entity_id]' />
