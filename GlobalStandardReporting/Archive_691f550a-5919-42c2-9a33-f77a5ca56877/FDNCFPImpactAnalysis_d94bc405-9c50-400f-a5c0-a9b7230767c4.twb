      <aliases enabled='yes' />
      <column caption='FP_Rate_Agg' datatype='real' name='[Calculation_747879046705537025]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Incorrectly_Granted_FDNC_Order_Count])/(SUM([Correctly_Identified_Old_Cust_Mult_FDNC])+SUM([Incorrectly_Granted_FDNC_Order_Count]))' />
      </column>
      <column caption='FP_Ratio_Agg' datatype='real' name='[Calculation_747879046705688578]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Incorrectly_Granted_FDNC_Order_Count])/(SUM([New_Customer_Order_Count]) - SUM([Incorrectly_Granted_FDNC_Order_Count]))' />
      </column>
      <column caption='FDNC_Vendor_Share' datatype='real' hidden='true' name='[Calculation_833447432184676352]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([FDNC_OD_resto_vendors]) / SUM([Total_OD_resto_vendors])' />
      </column>
      <column caption='DF_Rev_Lost_On_Incorrectly_Granted_FDNC_Orders' datatype='real' name='[Calculation_833447432185626625]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Total_DF_Non_FD_Orders])/SUM([Order_Count_Non_FD_Orders])) * SUM([Incorrectly_Granted_FDNC_Order_Count])' />
      </column>
      <column caption='Incorrectly_Granted_FDNC_%_of_New_Cust_Orders' datatype='real' name='[Calculation_833447432198291460]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Incorrectly_Granted_FDNC_Order_Count])/SUM([New_Customer_Order_Count])' />
      </column>
      <column caption='Correctly Granted FDNC Order Count' datatype='integer' name='[Calculation_833447432199233541]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([New_Customer_Order_Count])-SUM([Incorrectly_Granted_FDNC_Order_Count])' />
      </column>
      <column caption='New_Cust_Order_Share' datatype='real' name='[Calculation_833447432204386311]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([New_Customer_Order_Count])/SUM([Total_Order_Count])' />
      </column>
      <column caption='Order_Count_from_Correctly_Identified_Old_Cust' datatype='integer' name='[Correctly_Identified_Old_Cust_Mult_FDNC]' role='measure' type='quantitative' />
      <column caption='Avg_DF_Non_FD_Orders' datatype='real' hidden='true' name='[DF_Rev_Lost_On_Incorrectly_Granted_FDNC_Orders (copy)_833447432187539459]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Total_DF_Non_FD_Orders])/SUM([Order_Count_Non_FD_Orders]))' />
      </column>
