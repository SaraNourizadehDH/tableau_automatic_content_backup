            <zone h='4416' id='398' param='horz' type-v2='layout-flow' w='49506' x='49994' y='28917'>
              <zone forceUpdate='true' h='4416' id='348' type-v2='text' w='49506' x='49994' y='28917'>
                <formatted-text>
                  <run bold='true' fontcolor='#ffffff' fontsize='12'>Cumulative Difference in Metrics</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#ffffff'><![CDATA[NOTE : Cumulative difference is the % change in the selected metric vs its value in the first concurrency bin of <[Parameters].[Parameter 6]>]]></run>
