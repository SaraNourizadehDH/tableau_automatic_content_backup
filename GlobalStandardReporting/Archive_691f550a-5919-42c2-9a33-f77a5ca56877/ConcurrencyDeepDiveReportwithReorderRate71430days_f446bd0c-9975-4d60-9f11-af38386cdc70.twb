          <alias key='&quot;[federated.0euc7081n4mg4414w0bgq06s35uk].[usr:chat_total_duration_min_avg (copy)_274719636442181638:qk]&quot;' value='Agent FRT non-live (min)' />
          <alias key='&quot;[federated.0euc7081n4mg4414w0bgq06s35uk].[usr:chat_total_duration_min_avg (copy)_274719636449738759:qk]&quot;' value='AHT non-live (min)' />
          <alias key='&quot;[federated.0euc7081n4mg4414w0bgq06s35uk].[usr:chat_work_items_num (copy)_857091363024715784:qk]&quot;' value='% Chats' />
          <alias key='&quot;[federated.0euc7081n4mg4414w0bgq06s35uk].[usr:chat_work_items_share (copy)_857091363024957449:qk]&quot;' value='% Calls' />
          <alias key='&quot;[federated.0euc7081n4mg4414w0bgq06s35uk].[usr:chat_wrap_up_time_min_avg (copy)_274719636440633348:qk]&quot;' value='AWUT inbound calls (min)' />
        </aliases>
      </column>
      <column caption='Agent Active Hours' datatype='real' name='[Agent Working Hours (copy)_5066901481138745365]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[total_active_sec] / 60 / 60' />
      </column>
      <column caption='Team Chat Concurrency' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg. Team Chat Concurrency (copy)_1956884421649215488]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// -- calculated as the average of team chat concurrency&#10;//(SUM([sum_duration_secs] * [sum_chats]) / SUM([sum_duration_secs]))&#10;&#10;SUM(sum_concurrency_numerator) / SUM(sum_concurrency_denominator)' />
      </column>
      <column caption='Avg. CSAT' datatype='real' name='[CSAT (copy)_471752127164534812]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(SUM([sum_csat])/SUM([count_cs_csat_responses]),0)' />
      </column>
      <column caption='1st Dimension' datatype='string' name='[Calculation_1316458531746291713]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;    WHEN &apos;Global&apos; THEN &apos;Global&apos;&#13;&#10;    WHEN &apos;Management Entity&apos; THEN [management_entity_group]&#13;&#10;    WHEN &apos;Contact Center&apos; THEN [contact_center]&#13;&#10;    WHEN &apos;Department&apos; THEN [department_name]&#13;&#10;    WHEN &apos;Team&apos; THEN [team_name]&#10;    WHEN &apos;Skill&apos; THEN [skill_name]&#13;&#10;END' />
      </column>
      <column caption='weekday' datatype='string' name='[Calculation_1414974773172178944]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;,[created_date], &apos;monday&apos;)' />
      </column>
      <column caption='Productivity' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_274719636456574988]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL((&#10;SUM(IFNULL([Call Work Items Num (copy)_5066901480862969856],0)) +&#10;SUM(IFNULL([count_served_chats],0)) +&#10;SUM(IFNULL([count_l1_close],0))&#10;)&#10; / SUM([all_work_item_num (copy)_5066901480878055433]),0)' />
      </column>
      <column caption='Row Level Concurrency' datatype='real' default-format='n#,##0.00;-#,##0.00' hidden='true' name='[Calculation_2902147785133543425]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[sum_concurrency_numerator] / [sum_concurrency_denominator]' />
      </column>
      <column caption='7 Day Reorder Rate' datatype='real' name='[Calculation_338966297512251392]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_next_order_in_7_days]) / SUM([count_orders])' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_49750764073873408]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Cumulative Difference in your chosen First Metric' datatype='real' default-format='*0%▲;0%▼' name='[Calculation_6865737672623943689]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10; WHEN &apos;CSAT(in %)&apos;          THEN RUNNING_SUM(ZN([Calculation_6865737672627888139]) - LOOKUP(ZN([Calculation_6865737672627888139]), -1))&#10; WHEN &apos;AHT chats (min)&apos;     THEN RUNNING_SUM(ZN([Calculation_6865737672627888139]) - LOOKUP(ZN([Calculation_6865737672627888139]), -1)) / LOOKUP(ZN([Calculation_6865737672627888139]), FIRST())&#10; WHEN &apos;AWUT chats (min)&apos;    THEN RUNNING_SUM(ZN([Calculation_6865737672627888139]) - LOOKUP(ZN([Calculation_6865737672627888139]), -1)) / LOOKUP(ZN([Calculation_6865737672627888139]), FIRST())&#10; WHEN &apos;ATHT chats (min)&apos;    THEN RUNNING_SUM(ZN([Calculation_6865737672627888139]) - LOOKUP(ZN([Calculation_6865737672627888139]), -1)) / LOOKUP(ZN([Calculation_6865737672627888139]), FIRST())&#10; WHEN &apos;Productivity&apos;        THEN RUNNING_SUM(ZN([Calculation_6865737672627888139]) - LOOKUP(ZN([Calculation_6865737672627888139]), -1)) / LOOKUP(ZN([Calculation_6865737672627888139]), FIRST())&#10; WHEN &apos;7 Day Reorder Rate&apos;  THEN RUNNING_SUM(ZN([Calculation_6865737672627888139]) - LOOKUP(ZN([Calculation_6865737672627888139]), -1))&#10; WHEN &apos;14 Day Reorder Rate&apos; THEN RUNNING_SUM(ZN([Calculation_6865737672627888139]) - LOOKUP(ZN([Calculation_6865737672627888139]), -1))&#10; WHEN &apos;30 Day Reorder Rate&apos; THEN RUNNING_SUM(ZN([Calculation_6865737672627888139]) - LOOKUP(ZN([Calculation_6865737672627888139]), -1))&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Concurrency Bins' datatype='real' name='[Calculation_6865737672626335754]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='//FLOOR([Sum Concurrency Numerator] / [Sum Concurrency Denominator] / 0.25) * 0.25&#10;&#10;FLOOR([sum_concurrency_numerator] / [sum_concurrency_denominator] / [Parameters].[Parameter 6]) * [Parameters].[Parameter 6]' />
      </column>
      <column caption='Your Chosen First Metric' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6865737672627888139]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;  WHEN &apos;CSAT(in %)&apos; THEN [Coaching Achievement (copy)_471752127164174363]&#10;  WHEN &apos;AHT chats (min)&apos; THEN [Calculation_857091363022221313]&#10;  WHEN &apos;AWUT chats (min)&apos; THEN [chat_aht_min (copy)_857091363023646725]&#10;  WHEN &apos;ATHT chats (min)&apos; THEN [Chat AHT min (copy)_1976587697339854848]&#10;  WHEN &apos;Productivity&apos; THEN [Calculation_274719636456574988]&#10;  WHEN &apos;7 Day Reorder Rate&apos; THEN [Calculation_338966297512251392]&#10;  WHEN &apos;14 Day Reorder Rate&apos; THEN [7 Day Reorder Rate (copy)_338966297512529921]&#10;  WHEN &apos;30 Day Reorder Rate&apos; THEN [7 Day Reorder Rate (copy)_338966297512603650]&#10;END' />
      </column>
      <column caption='Granularity Level' datatype='string' datatype-customized='true' name='[Calculation_820781064851783688]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Daily&apos; THEN STR([created_date])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN [week]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN [month]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;30min interval&apos; THEN STR([interval_start_at])&#10;END' />
      </column>
      <column caption='All Work Items' datatype='real' name='[Calculation_857091363021508608]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([count_served_chats], 0)&#13;&#10;+ IFNULL([Call Work Items Num (copy)_5066901480862969856], 0)&#13;&#10;+ IFNULL([Non Live Work Item Num (copy)_5066901480863780865], 0)' />
      </column>
      <column caption='Chat AHT (secs)' datatype='real' default-format='n#,##0;-#,##0' hidden='true' name='[Calculation_857091363022221313 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL((SUM(ZN([sum_handling_time_chat_sec]) + ZN([sum_wrap_up_time_chat_sec])))&#10;/&#10;SUM([count_served_chats]),0)' />
      </column>
      <column caption='Chat AHT min' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_857091363022221313]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL((SUM([sum_handling_time_chat_sec])/60) / SUM([count_served_chats]),0)' />
      </column>
      <column caption='Call Within SLA 30s' datatype='real' default-format='p0%' name='[Call Within SLA 60s (copy)_3783023724556238849]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(SUM([count_sla_30s_calls]) / SUM([count_served_calls]),0)' />
      </column>
      <column caption='Call Work Items Num' datatype='integer' name='[Call Work Items Num (copy)_5066901480862969856]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IFNULL([count_served_calls], 0) + IFNULL([count_outbound_call_success], 0)' />
      </column>
      <column caption='Chat ATHT min' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Chat AHT min (copy)_1976587697339854848]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(IFNULL(SUM([sum_handling_time_chat_sec]),0) + IFNULL(SUM([sum_wrap_up_time_chat_sec]),0))&#10;/&#10;SUM([count_served_chats])/60' />
      </column>
      <column caption='Call Within SLA 60s' datatype='real' default-format='p0%' name='[Chat Within SLA 60s (copy)_3783023724556062720]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(SUM([count_sla_60s_calls]) / SUM([count_served_calls]),0)' />
      </column>
      <column caption='Your Chosen Second Metric' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Choose your Metric (copy)_148337353439948801]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Choose your Metric 1 (copy)_148337353439703040]&#10;  WHEN &apos;CSAT(in %)&apos; THEN [Coaching Achievement (copy)_471752127164174363]&#10;  WHEN &apos;AHT chats (min)&apos; THEN [Calculation_857091363022221313]&#10;  WHEN &apos;AWUT chats (min)&apos; THEN [chat_aht_min (copy)_857091363023646725]&#10;  WHEN &apos;ATHT chats (min)&apos; THEN [Chat AHT min (copy)_1976587697339854848]&#10;  WHEN &apos;Productivity&apos; THEN [Calculation_274719636456574988]&#10;  WHEN &apos;7 Day Reorder Rate&apos; THEN [Calculation_338966297512251392]&#10;  WHEN &apos;14 Day Reorder Rate&apos; THEN [7 Day Reorder Rate (copy)_338966297512529921]&#10;  WHEN &apos;30 Day Reorder Rate&apos; THEN [7 Day Reorder Rate (copy)_338966297512603650]&#10;END' />
      </column>
      <column caption='CSAT' datatype='real' default-format='p0%' name='[Coaching Achievement (copy)_471752127164174363]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_cs_csat_4_5]) / SUM([count_cs_csat_responses])' />
      </column>
      <column caption='Count L1s' datatype='real' name='[Count L1 Close (copy)_5597059600489926657]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([count_l1_close], 0) + IFNULL([count_l1_escalated], 0)' />
      </column>
      <column caption='# Served Calls' datatype='integer' name='[Count Served Calls (copy)_6881359560495292420]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([count_served_calls],0)' />
      </column>
      <column caption='# Served Chats' datatype='integer' name='[Count Served Chats (copy)_6881359560490577920]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([count_served_chats],0)' />
      </column>
      <column caption='Count Call SLA 30s' datatype='integer' hidden='true' name='[Count Sla 30S Calls (copy)_6881359560495001602]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([count_sla_30s_calls],0)' />
      </column>
      <column caption='Count Call SLA 60s' datatype='integer' hidden='true' name='[Count Sla 60S Calls (copy)_6881359560495198211]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([count_sla_60s_calls],0)' />
      </column>
      <column caption='Date Range' datatype='date' name='[Created Date (copy)_817403393340694528]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[created_date]' />
      </column>
      <column caption='Cumulative Difference in your chosen Second Metric' datatype='real' default-format='*0%▲;0%▼' name='[Cumulative Difference in Metric (copy)_148337353440288770]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Choose your Metric 1 (copy)_148337353439703040]&#10; WHEN &apos;CSAT(in %)&apos;       THEN RUNNING_SUM(ZN([Choose your Metric (copy)_148337353439948801]) - LOOKUP(ZN([Choose your Metric (copy)_148337353439948801]), -1))&#10; WHEN &apos;AHT chats (min)&apos;  THEN RUNNING_SUM(ZN([Choose your Metric (copy)_148337353439948801]) - LOOKUP(ZN([Choose your Metric (copy)_148337353439948801]), -1)) / LOOKUP(ZN([Choose your Metric (copy)_148337353439948801]), FIRST())&#10; WHEN &apos;AWUT chats (min)&apos; THEN RUNNING_SUM(ZN([Choose your Metric (copy)_148337353439948801]) - LOOKUP(ZN([Choose your Metric (copy)_148337353439948801]), -1)) / LOOKUP(ZN([Choose your Metric (copy)_148337353439948801]), FIRST())&#10; WHEN &apos;ATHT chats (min)&apos; THEN RUNNING_SUM(ZN([Choose your Metric (copy)_148337353439948801]) - LOOKUP(ZN([Choose your Metric (copy)_148337353439948801]), -1)) / LOOKUP(ZN([Choose your Metric (copy)_148337353439948801]), FIRST())&#10; WHEN &apos;Productivity&apos;     THEN RUNNING_SUM(ZN([Choose your Metric (copy)_148337353439948801]) - LOOKUP(ZN([Choose your Metric (copy)_148337353439948801]), -1)) / LOOKUP(ZN([Choose your Metric (copy)_148337353439948801]), FIRST())&#10; WHEN &apos;7 Day Reorder Rate&apos;  THEN RUNNING_SUM(ZN([Choose your Metric (copy)_148337353439948801]) - LOOKUP(ZN([Choose your Metric (copy)_148337353439948801]), -1))&#10; WHEN &apos;14 Day Reorder Rate&apos; THEN RUNNING_SUM(ZN([Choose your Metric (copy)_148337353439948801]) - LOOKUP(ZN([Choose your Metric (copy)_148337353439948801]), -1))&#10; WHEN &apos;30 Day Reorder Rate&apos; THEN RUNNING_SUM(ZN([Choose your Metric (copy)_148337353439948801]) - LOOKUP(ZN([Choose your Metric (copy)_148337353439948801]), -1))&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Chart Dimension' datatype='string' name='[Granularity Level (copy)_5066901481221890102]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Granularity Level (copy)_5066901481221500980] = &apos;BPO&apos; THEN [bpo_name]&#10;ELSEIF [Parameters].[Granularity Level (copy)_5066901481221500980] = &apos;Management Entity&apos; THEN [management_entity_group]&#10;ELSEIF [Parameters].[Granularity Level (copy)_5066901481221500980] = &apos;Contact Center&apos; THEN [contact_center]&#10;ELSEIF [Parameters].[Granularity Level (copy)_5066901481221500980] = &apos;Team&apos; THEN [team_name]&#10;ELSEIF [Parameters].[Granularity Level (copy)_5066901481221500980] = &apos;Department&apos; THEN [department_name]&#10;ELSEIF [Parameters].[Granularity Level (copy)_5066901481221500980] = &apos;Skill&apos; THEN [skill_name]&#10;ELSEIF [Parameters].[Granularity Level (copy)_5066901481221500980] = &apos;Global&apos; THEN &apos;Global&apos;&#10;END' />
      </column>
      <column caption='Metrics' datatype='real' name='[Granularity Level (copy)_5066901481589715006]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Granularity Level (copy)_5066901481578168379]&#10;WHEN &apos;Productivity&apos; THEN [Calculation_274719636456574988]&#10;WHEN &apos;# Work Items&apos; THEN SUM([Calculation_857091363021508608])&#10;WHEN &apos;% Chats&apos; THEN [chat_work_items_num (copy)_857091363024715784]&#10;WHEN &apos;# Served Chats&apos; THEN SUM([count_served_chats])&#10;WHEN &apos;Agent SLA Chat 5s&apos; THEN [chat_aht_min (copy)_857091363022782466]&#10;WHEN &apos;Agent SLA Chat 30s&apos; THEN [chat_sla_10_avg (copy)_857091363023339523]&#10;WHEN &apos;Agent SLA Chat 60s&apos; THEN [chat_sla_30_avg (copy)_857091363023450116]&#10;WHEN &apos;AHT Chats (min)&apos; THEN [Calculation_857091363022221313]&#10;WHEN &apos;AWUT Chats (min)&apos; THEN [chat_aht_min (copy)_857091363023646725]&#10;WHEN &apos;ATHT Chats (min)&apos; THEN [chat_duration_min_avg (copy)_857091363023953926]&#10;WHEN &apos;% Calls&apos; THEN [chat_work_items_share (copy)_857091363024957449]&#10;WHEN &apos;# Served Calls&apos; THEN SUM([count_served_calls])&#10;WHEN &apos;# Missed Calls&apos; THEN SUM([count_missed_calls])&#10;WHEN &apos;# Outbound Calls&apos; THEN SUM([count_outbound_calls])&#10;WHEN &apos;# Outbound Successful Calls&apos; THEN SUM([count_outbound_call_success])&#10;WHEN &apos;AHT Inbound Calls (min)&apos; THEN [chat_duration_min_avg (copy)_274719636438257666]&#10;WHEN &apos;AHT Outbound Calls (min)&apos; THEN [call_inbound_handling_time_min_avg (copy)_5357172551339106305]&#10;WHEN &apos;# Calls Inbound Less Than 3min&apos; THEN SUM([count_outbound_less_3min_call])&#10;WHEN &apos;Queue Time Served Call (min)&apos; THEN AVG([sum_queue_time_served_call_sec])&#10;WHEN &apos;SLA 30s Calls&apos; THEN SUM([count_sla_30s_calls])&#10;WHEN &apos;SLA 60s Calls&apos; THEN SUM([count_sla_60s_calls])&#10;WHEN &apos;AWUT Calls (min)&apos; THEN [chat_wrap_up_time_min_avg (copy)_274719636440633348]&#10;WHEN &apos;# Non Live L1 Escalated&apos; THEN SUM([count_l1_escalated])&#10;WHEN &apos;# Non Live L1 Close&apos; THEN SUM([count_l1_close])&#10;WHEN &apos;# Non Live L2&apos; THEN SUM([count_l2])&#10;WHEN &apos;Non Live AHT L1 Escalated (min)&apos; THEN AVG([sum_ht_l1_escalated_sec] / 60)&#10;WHEN &apos;Non Live AHT L1 Close (min)&apos; THEN AVG([sum_ht_l1_close_sec] / 60)&#10;WHEN &apos;Non Live AHT L2 (min)&apos; THEN AVG([sum_ht_l2_sec] / 60)&#10;WHEN &apos;Non Live FRT L1 Escalated&apos; THEN AVG([sum_first_reply_time_l1_escalated_sec] / 60)&#10;WHEN &apos;Non Live FRT L1 Close&apos; THEN AVG([sum_first_reply_time_l1_close_sec] / 60)&#10;WHEN &apos;Non Live FRT L2&apos; THEN AVG([sum_first_reply_time_l2_sec] / 60)&#10;WHEN &apos;Non Live SLA L1 Escalated&apos; THEN SUM([count_within_sla_l1_escalated])&#10;WHEN &apos;Non Live SLA L1 Close&apos; THEN SUM([count_within_sla_l1_close])&#10;WHEN &apos;Non Live SLA L2&apos; THEN SUM([count_within_sla_l2])&#10;WHEN &apos;# Non Live L1s&apos; THEN SUM([count_l2])&#10;ELSE 0&#10;END' />
      </column>
      <column caption='Day Interval' datatype='string' name='[Interval Start At (copy)_5066901480891465741]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(DATEPART(&apos;hour&apos;, [interval_start_at])) + &quot;:&quot; +&#10;IF STR(DATEPART(&apos;minute&apos;, [interval_start_at])) = &apos;0&apos; THEN &apos;00&apos;&#10;ELSE &apos;30&apos; END' />
      </column>
      <column caption='Month1' datatype='integer' hidden='true' name='[Month (copy)_5597059600467283968]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='MONTH([created_date])' />
      </column>
      <column caption='Non Live Work Item First Reply Time' datatype='real' hidden='true' name='[Non Live Work Item First Reply Time (copy)_5066901480864026626]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([sum_first_reply_time_l1_close_sec],0) &#10;+ IFNULL([sum_first_reply_time_l1_escalated_sec],0) &#10;+ IFNULL([sum_first_reply_time_l2_sec],0)' />
      </column>
      <column caption='Non Live Work Item Handling Time' datatype='integer' hidden='true' name='[Non Live Work Item Handling Time (copy)_5066901480864256003]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([sum_outbound_ht_call_sec], 0) + IFNULL([sum_inbound_ht_call_sec], 0)' />
      </column>
      <column caption='Non Live Work Item Num' datatype='real' name='[Non Live Work Item Num (copy)_5066901480863780865]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IFNULL([count_l1_close],0) + IFNULL([count_l1_escalated], 0) + IFNULL([count_l2],0)' />
      </column>
      <column caption='Non Live Work Item Sla 24 H' datatype='integer' hidden='true' name='[Non Live Work Item Sla 24 H (copy)_5066901480864268292]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([count_within_sla_l1_close],0)&#10;+ IFNULL([count_within_sla_l1_escalated], 0)&#10;+ IFNULL([count_within_sla_l2], 0)' />
      </column>
      <column caption='Overtime Hours' datatype='real' hidden='true' name='[Overtime Hours % (copy)_5066901481164820506]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(IIF([total_active_sec] - [scheduled_sec] &gt; 0,&#10;[total_active_sec] - [scheduled_sec],&#10;0) / 60 / 60)' />
      </column>
      <column caption='Shrinkage Hours %' datatype='real' name='[Overtime Hours (copy)_5066901481126088720]' role='measure' type='quantitative'>
