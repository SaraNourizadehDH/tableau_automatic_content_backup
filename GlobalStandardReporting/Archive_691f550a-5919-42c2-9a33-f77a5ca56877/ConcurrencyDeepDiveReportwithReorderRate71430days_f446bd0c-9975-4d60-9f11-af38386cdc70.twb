    <worksheet name='Cumulative Difference (2 metrics)'>
      <table>
        <view>
          <datasources>
            <datasource caption='team_interval_metrics_report' name='federated.0euc7081n4mg4414w0bgq06s35uk' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose your Second Metric' datatype='string' name='[Choose your Metric 1 (copy)_148337353439703040]' param-domain-type='list' role='measure' type='nominal' value='&quot;7 Day Reorder Rate&quot;'>
              <calculation class='tableau' formula='&quot;7 Day Reorder Rate&quot;' />
            </column>
            <column caption='Choose your First Metric' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;AHT chats (min)&quot;'>
              <calculation class='tableau' formula='&quot;AHT chats (min)&quot;' />
            </column>
            <column caption='Choose your Bin Size' datatype='real' datatype-customized='true' name='[Parameter 6]' param-domain-type='list' role='measure' type='quantitative' value='0.2'>
              <calculation class='tableau' formula='0.2' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0euc7081n4mg4414w0bgq06s35uk'>
            <column caption='14 Day Reorder Rate' datatype='real' name='[7 Day Reorder Rate (copy)_338966297512529921]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_next_order_in_14_days]) / SUM([count_orders])' />
            </column>
            <column caption='30 Day Reorder Rate' datatype='real' name='[7 Day Reorder Rate (copy)_338966297512603650]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_next_order_in_30_days]) / SUM([count_orders])' />
            </column>
            <column caption='Productivity' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_274719636456574988]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL((&#10;SUM(IFNULL([Call Work Items Num (copy)_5066901480862969856],0)) +&#10;SUM(IFNULL([count_served_chats],0)) +&#10;SUM(IFNULL([count_l1_close],0))&#10;)&#10; / SUM([all_work_item_num (copy)_5066901480878055433]),0)' />
            </column>
            <column caption='7 Day Reorder Rate' datatype='real' name='[Calculation_338966297512251392]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_next_order_in_7_days]) / SUM([count_orders])' />
            </column>
            <column caption='Cumulative Difference in your chosen First Metric' datatype='real' default-format='*0%▲;0%▼' name='[Calculation_6865737672623943689]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10; WHEN &apos;CSAT(in %)&apos;          THEN RUNNING_SUM(ZN([Calculation_6865737672627888139]) - LOOKUP(ZN([Calculation_6865737672627888139]), -1))&#10; WHEN &apos;AHT chats (min)&apos;     THEN RUNNING_SUM(ZN([Calculation_6865737672627888139]) - LOOKUP(ZN([Calculation_6865737672627888139]), -1)) / LOOKUP(ZN([Calculation_6865737672627888139]), FIRST())&#10; WHEN &apos;AWUT chats (min)&apos;    THEN RUNNING_SUM(ZN([Calculation_6865737672627888139]) - LOOKUP(ZN([Calculation_6865737672627888139]), -1)) / LOOKUP(ZN([Calculation_6865737672627888139]), FIRST())&#10; WHEN &apos;ATHT chats (min)&apos;    THEN RUNNING_SUM(ZN([Calculation_6865737672627888139]) - LOOKUP(ZN([Calculation_6865737672627888139]), -1)) / LOOKUP(ZN([Calculation_6865737672627888139]), FIRST())&#10; WHEN &apos;Productivity&apos;        THEN RUNNING_SUM(ZN([Calculation_6865737672627888139]) - LOOKUP(ZN([Calculation_6865737672627888139]), -1)) / LOOKUP(ZN([Calculation_6865737672627888139]), FIRST())&#10; WHEN &apos;7 Day Reorder Rate&apos;  THEN RUNNING_SUM(ZN([Calculation_6865737672627888139]) - LOOKUP(ZN([Calculation_6865737672627888139]), -1))&#10; WHEN &apos;14 Day Reorder Rate&apos; THEN RUNNING_SUM(ZN([Calculation_6865737672627888139]) - LOOKUP(ZN([Calculation_6865737672627888139]), -1))&#10; WHEN &apos;30 Day Reorder Rate&apos; THEN RUNNING_SUM(ZN([Calculation_6865737672627888139]) - LOOKUP(ZN([Calculation_6865737672627888139]), -1))&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Concurrency Bins' datatype='real' name='[Calculation_6865737672626335754]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='//FLOOR([Sum Concurrency Numerator] / [Sum Concurrency Denominator] / 0.25) * 0.25&#10;&#10;FLOOR([sum_concurrency_numerator] / [sum_concurrency_denominator] / [Parameters].[Parameter 6]) * [Parameters].[Parameter 6]' />
            </column>
            <column caption='Your Chosen First Metric' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6865737672627888139]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;  WHEN &apos;CSAT(in %)&apos; THEN [Coaching Achievement (copy)_471752127164174363]&#10;  WHEN &apos;AHT chats (min)&apos; THEN [Calculation_857091363022221313]&#10;  WHEN &apos;AWUT chats (min)&apos; THEN [chat_aht_min (copy)_857091363023646725]&#10;  WHEN &apos;ATHT chats (min)&apos; THEN [Chat AHT min (copy)_1976587697339854848]&#10;  WHEN &apos;Productivity&apos; THEN [Calculation_274719636456574988]&#10;  WHEN &apos;7 Day Reorder Rate&apos; THEN [Calculation_338966297512251392]&#10;  WHEN &apos;14 Day Reorder Rate&apos; THEN [7 Day Reorder Rate (copy)_338966297512529921]&#10;  WHEN &apos;30 Day Reorder Rate&apos; THEN [7 Day Reorder Rate (copy)_338966297512603650]&#10;END' />
            </column>
            <column caption='Chat AHT min' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_857091363022221313]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL((SUM([sum_handling_time_chat_sec])/60) / SUM([count_served_chats]),0)' />
            </column>
            <column caption='Call Work Items Num' datatype='integer' name='[Call Work Items Num (copy)_5066901480862969856]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IFNULL([count_served_calls], 0) + IFNULL([count_outbound_call_success], 0)' />
            </column>
            <column caption='Chat ATHT min' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Chat AHT min (copy)_1976587697339854848]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IFNULL(SUM([sum_handling_time_chat_sec]),0) + IFNULL(SUM([sum_wrap_up_time_chat_sec]),0))&#10;/&#10;SUM([count_served_chats])/60' />
            </column>
            <column caption='Your Chosen Second Metric' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Choose your Metric (copy)_148337353439948801]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Choose your Metric 1 (copy)_148337353439703040]&#10;  WHEN &apos;CSAT(in %)&apos; THEN [Coaching Achievement (copy)_471752127164174363]&#10;  WHEN &apos;AHT chats (min)&apos; THEN [Calculation_857091363022221313]&#10;  WHEN &apos;AWUT chats (min)&apos; THEN [chat_aht_min (copy)_857091363023646725]&#10;  WHEN &apos;ATHT chats (min)&apos; THEN [Chat AHT min (copy)_1976587697339854848]&#10;  WHEN &apos;Productivity&apos; THEN [Calculation_274719636456574988]&#10;  WHEN &apos;7 Day Reorder Rate&apos; THEN [Calculation_338966297512251392]&#10;  WHEN &apos;14 Day Reorder Rate&apos; THEN [7 Day Reorder Rate (copy)_338966297512529921]&#10;  WHEN &apos;30 Day Reorder Rate&apos; THEN [7 Day Reorder Rate (copy)_338966297512603650]&#10;END' />
            </column>
            <column caption='CSAT' datatype='real' default-format='p0%' name='[Coaching Achievement (copy)_471752127164174363]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_cs_csat_4_5]) / SUM([count_cs_csat_responses])' />
