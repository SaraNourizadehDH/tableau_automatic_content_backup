              <calculation class='tableau' formula='([unproductive_break_sec] / 60 / 60) / [Agent Working Hours (copy)_5066901481138745365]' />
            </column>
            <column caption='Agent Working Hours' datatype='real' name='[all_work_item_num (copy)_5066901480878055433]' role='measure' type='quantitative'>
