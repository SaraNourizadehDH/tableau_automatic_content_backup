          <datasource-dependencies datasource='federated.0euc7081n4mg4414w0bgq06s35uk'>
            <column caption='weekday' datatype='string' name='[Calculation_1414974773172178944]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;,[created_date], &apos;monday&apos;)' />
            </column>
            <column caption='Productivity' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_274719636456574988]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL((&#10;SUM(IFNULL([Call Work Items Num (copy)_5066901480862969856],0)) +&#10;SUM(IFNULL([count_served_chats],0)) +&#10;SUM(IFNULL([count_l1_close],0))&#10;)&#10; / SUM([all_work_item_num (copy)_5066901480878055433]),0)' />
            </column>
            <column caption='All Work Items' datatype='real' name='[Calculation_857091363021508608]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([count_served_chats], 0)&#13;&#10;+ IFNULL([Call Work Items Num (copy)_5066901480862969856], 0)&#13;&#10;+ IFNULL([Non Live Work Item Num (copy)_5066901480863780865], 0)' />
            </column>
            <column caption='Chat AHT min' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_857091363022221313]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL((SUM([sum_handling_time_chat_sec])/60) / SUM([count_served_chats]),0)' />
            </column>
            <column caption='Call Work Items Num' datatype='integer' name='[Call Work Items Num (copy)_5066901480862969856]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IFNULL([count_served_calls], 0) + IFNULL([count_outbound_call_success], 0)' />
            </column>
            <column caption='Date Range' datatype='date' name='[Created Date (copy)_817403393340694528]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[created_date]' />
            </column>
            <column caption='Metrics' datatype='real' name='[Granularity Level (copy)_5066901481589715006]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Granularity Level (copy)_5066901481578168379]&#10;WHEN &apos;Productivity&apos; THEN [Calculation_274719636456574988]&#10;WHEN &apos;# Work Items&apos; THEN SUM([Calculation_857091363021508608])&#10;WHEN &apos;% Chats&apos; THEN [chat_work_items_num (copy)_857091363024715784]&#10;WHEN &apos;# Served Chats&apos; THEN SUM([count_served_chats])&#10;WHEN &apos;Agent SLA Chat 5s&apos; THEN [chat_aht_min (copy)_857091363022782466]&#10;WHEN &apos;Agent SLA Chat 30s&apos; THEN [chat_sla_10_avg (copy)_857091363023339523]&#10;WHEN &apos;Agent SLA Chat 60s&apos; THEN [chat_sla_30_avg (copy)_857091363023450116]&#10;WHEN &apos;AHT Chats (min)&apos; THEN [Calculation_857091363022221313]&#10;WHEN &apos;AWUT Chats (min)&apos; THEN [chat_aht_min (copy)_857091363023646725]&#10;WHEN &apos;ATHT Chats (min)&apos; THEN [chat_duration_min_avg (copy)_857091363023953926]&#10;WHEN &apos;% Calls&apos; THEN [chat_work_items_share (copy)_857091363024957449]&#10;WHEN &apos;# Served Calls&apos; THEN SUM([count_served_calls])&#10;WHEN &apos;# Missed Calls&apos; THEN SUM([count_missed_calls])&#10;WHEN &apos;# Outbound Calls&apos; THEN SUM([count_outbound_calls])&#10;WHEN &apos;# Outbound Successful Calls&apos; THEN SUM([count_outbound_call_success])&#10;WHEN &apos;AHT Inbound Calls (min)&apos; THEN [chat_duration_min_avg (copy)_274719636438257666]&#10;WHEN &apos;AHT Outbound Calls (min)&apos; THEN [call_inbound_handling_time_min_avg (copy)_5357172551339106305]&#10;WHEN &apos;# Calls Inbound Less Than 3min&apos; THEN SUM([count_outbound_less_3min_call])&#10;WHEN &apos;Queue Time Served Call (min)&apos; THEN AVG([sum_queue_time_served_call_sec])&#10;WHEN &apos;SLA 30s Calls&apos; THEN SUM([count_sla_30s_calls])&#10;WHEN &apos;SLA 60s Calls&apos; THEN SUM([count_sla_60s_calls])&#10;WHEN &apos;AWUT Calls (min)&apos; THEN [chat_wrap_up_time_min_avg (copy)_274719636440633348]&#10;WHEN &apos;# Non Live L1 Escalated&apos; THEN SUM([count_l1_escalated])&#10;WHEN &apos;# Non Live L1 Close&apos; THEN SUM([count_l1_close])&#10;WHEN &apos;# Non Live L2&apos; THEN SUM([count_l2])&#10;WHEN &apos;Non Live AHT L1 Escalated (min)&apos; THEN AVG([sum_ht_l1_escalated_sec] / 60)&#10;WHEN &apos;Non Live AHT L1 Close (min)&apos; THEN AVG([sum_ht_l1_close_sec] / 60)&#10;WHEN &apos;Non Live AHT L2 (min)&apos; THEN AVG([sum_ht_l2_sec] / 60)&#10;WHEN &apos;Non Live FRT L1 Escalated&apos; THEN AVG([sum_first_reply_time_l1_escalated_sec] / 60)&#10;WHEN &apos;Non Live FRT L1 Close&apos; THEN AVG([sum_first_reply_time_l1_close_sec] / 60)&#10;WHEN &apos;Non Live FRT L2&apos; THEN AVG([sum_first_reply_time_l2_sec] / 60)&#10;WHEN &apos;Non Live SLA L1 Escalated&apos; THEN SUM([count_within_sla_l1_escalated])&#10;WHEN &apos;Non Live SLA L1 Close&apos; THEN SUM([count_within_sla_l1_close])&#10;WHEN &apos;Non Live SLA L2&apos; THEN SUM([count_within_sla_l2])&#10;WHEN &apos;# Non Live L1s&apos; THEN SUM([count_l2])&#10;ELSE 0&#10;END' />
            </column>
            <column caption='Day Interval' datatype='string' name='[Interval Start At (copy)_5066901480891465741]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(DATEPART(&apos;hour&apos;, [interval_start_at])) + &quot;:&quot; +&#10;IF STR(DATEPART(&apos;minute&apos;, [interval_start_at])) = &apos;0&apos; THEN &apos;00&apos;&#10;ELSE &apos;30&apos; END' />
            </column>
            <column caption='Non Live Work Item Num' datatype='real' name='[Non Live Work Item Num (copy)_5066901480863780865]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IFNULL([count_l1_close],0) + IFNULL([count_l1_escalated], 0) + IFNULL([count_l2],0)' />
            </column>
            <column caption='Agent Working Hours' datatype='real' name='[all_work_item_num (copy)_5066901480878055433]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([total_active_sec] - [unproductive_break_sec]) / 60 / 60' />
            </column>
            <column caption='Bpo Name' datatype='string' name='[bpo_name]' role='dimension' type='nominal' />
            <column caption='Call outbound AHT min' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[call_inbound_handling_time_min_avg (copy)_5357172551339106305]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([sum_outbound_ht_call_sec])/60) / SUM([count_served_calls])' />
            </column>
            <column caption='Chat Within SLA 5s ' datatype='real' default-format='p0%' name='[chat_aht_min (copy)_857091363022782466]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM([count_sla_5s_chat]) / SUM([count_served_chats]),0)' />
            </column>
            <column caption='Chat AWUT min' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[chat_aht_min (copy)_857091363023646725]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL((SUM([sum_wrap_up_time_chat_sec])/60) / SUM([count_served_chats]),0)' />
            </column>
            <column caption='Call Inbound AHT min ' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[chat_duration_min_avg (copy)_274719636438257666]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL((SUM([sum_inbound_ht_call_sec])/60) / SUM([count_served_calls]),0)' />
            </column>
            <column caption='Chat Avg, Duration  min' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[chat_duration_min_avg (copy)_857091363023953926]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL((SUM(IFNULL([sum_handling_time_chat_sec], 0) + IFNULL([sum_wrap_up_time_chat_sec], 0))/60) / SUM([count_served_chats]),0)' />
            </column>
            <column caption='Chat Within SLA 30s' datatype='real' default-format='p0%' name='[chat_sla_10_avg (copy)_857091363023339523]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM([count_sla_30s_chat]) / SUM([count_served_chats]),0)' />
            </column>
            <column caption='Chat Within SLA 60s' datatype='real' default-format='p0%' name='[chat_sla_30_avg (copy)_857091363023450116]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM([count_sla_60s_chat]) / SUM([count_served_chats]),0)' />
            </column>
            <column caption='Chat Work Items Share %' datatype='real' default-format='p0%' name='[chat_work_items_num (copy)_857091363024715784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_served_chats]) / SUM([Calculation_857091363021508608])' />
            </column>
            <column caption='Call Work Items Share %' datatype='real' default-format='p0%' name='[chat_work_items_share (copy)_857091363024957449]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Call Work Items Num (copy)_5066901480862969856]) / SUM([Calculation_857091363021508608])' />
            </column>
            <column caption='Call Inbound AWUT min' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[chat_wrap_up_time_min_avg (copy)_274719636440633348]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL((SUM([sum_wrap_up_time_call_sec])/60) / SUM([count_served_calls]),0)' />
            </column>
