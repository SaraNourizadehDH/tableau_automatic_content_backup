            </column>
            <column caption='Chart Dimension' datatype='string' name='[Granularity Level (copy)_5066901481221890102]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Granularity Level (copy)_5066901481221500980] = &apos;BPO&apos; THEN [bpo_name]&#10;ELSEIF [Parameters].[Granularity Level (copy)_5066901481221500980] = &apos;Management Entity&apos; THEN [management_entity_group]&#10;ELSEIF [Parameters].[Granularity Level (copy)_5066901481221500980] = &apos;Contact Center&apos; THEN [contact_center]&#10;ELSEIF [Parameters].[Granularity Level (copy)_5066901481221500980] = &apos;Team&apos; THEN [team_name]&#10;ELSEIF [Parameters].[Granularity Level (copy)_5066901481221500980] = &apos;Department&apos; THEN [department_name]&#10;ELSEIF [Parameters].[Granularity Level (copy)_5066901481221500980] = &apos;Skill&apos; THEN [skill_name]&#10;ELSEIF [Parameters].[Granularity Level (copy)_5066901481221500980] = &apos;Global&apos; THEN &apos;Global&apos;&#10;END' />
            </column>
            <column caption='Shrinkage Hours %' datatype='real' name='[Overtime Hours (copy)_5066901481126088720]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([unproductive_other_sec] / 60 / 60) / [Agent Working Hours (copy)_5066901481138745365]' />
            </column>
            <column caption='Overtime Hours %' datatype='real' name='[Scheduled Hours (copy)_5066901480882221067]' role='measure' type='quantitative'>
