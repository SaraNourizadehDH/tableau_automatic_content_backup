              <calculation class='tableau' formula='&quot;Global&quot;' />
            </column>
            <column caption='Granularity Level' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0euc7081n4mg4414w0bgq06s35uk'>
            <column caption='Agent Active Hours' datatype='real' name='[Agent Working Hours (copy)_5066901481138745365]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_active_sec] / 60 / 60' />
            </column>
            <column caption='Productivity' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_274719636456574988]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL((&#10;SUM(IFNULL([Call Work Items Num (copy)_5066901480862969856],0)) +&#10;SUM(IFNULL([count_served_chats],0)) +&#10;SUM(IFNULL([count_l1_close],0))&#10;)&#10; / SUM([all_work_item_num (copy)_5066901480878055433]),0)' />
            </column>
            <column caption='Granularity Level' datatype='string' datatype-customized='true' name='[Calculation_820781064851783688]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Daily&apos; THEN STR([created_date])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN [week]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN [month]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;30min interval&apos; THEN STR([interval_start_at])&#10;END' />
            </column>
            <column caption='Call Work Items Num' datatype='integer' name='[Call Work Items Num (copy)_5066901480862969856]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IFNULL([count_served_calls], 0) + IFNULL([count_outbound_call_success], 0)' />
            </column>
            <column caption='Date Range' datatype='date' name='[Created Date (copy)_817403393340694528]' role='dimension' type='ordinal'>
