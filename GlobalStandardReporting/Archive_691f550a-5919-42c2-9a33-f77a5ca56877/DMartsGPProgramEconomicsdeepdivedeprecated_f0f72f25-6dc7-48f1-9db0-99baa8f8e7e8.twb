    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Vouchers'>
      <repository-location id='Vouchers' path='/t/GlobalStandardReporting/workbooks/DMarts-EconomicsdeepdiveWIP' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='parameter-ctrl'>
          <format attr='background-color' value='#ffaa0081' />
        </style-rule>
      </style>
      <size sizing-mode='automatic' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='Custom SQL Query (curated_data_shared_dmart)' name='federated.1kqu49p19gbt3b1d7org91ku68ok' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Structure' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Management Entity&quot;'>
          <calculation class='tableau' formula='&quot;Management Entity&quot;' />
          <members>
            <member value='&quot;DH Group&quot;' />
            <member value='&quot;Region&quot;' />
            <member value='&quot;Management Entity&quot;' />
            <member value='&quot;Country&quot;' />
            <member value='&quot;Store&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.1kqu49p19gbt3b1d7org91ku68ok'>
        <column caption='Avg. Voucher Value / Avg. Price p/Item' datatype='real' name='[Calculation_1122803746483826688]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='(SUM([vouchers])/SUM([voucher_orders]))&#13;&#10;/&#13;&#10;(SUM([gbv_gross_of_vat_orders_table])/SUM([qty_sold_orders_table]))' />
        </column>
        <column aggregation='Sum' caption='Store Current Age' datatype='integer' name='[Calculation_133700674115506184]' role='dimension' type='quantitative'>
          <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,[warehouse_first_order_date],NOW())' />
        </column>
        <column aggregation='Sum' caption='Store Age in Reporting Month' datatype='integer' name='[Calculation_133700674115698697]' role='dimension' type='quantitative'>
          <calculation class='tableau' formula='MAX(DATEDIFF(&apos;month&apos;,[warehouse_first_order_date],[date_trunc_month]),0)' />
        </column>
        <column caption='Vouchers (% of GBV+DF)' datatype='real' default-format='p0.00%' name='[Calculation_725642550296264704]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='SUM([vouchers])/SUM([gbv_gross_of_vat_2]+[df])' />
        </column>
        <column caption='Daily Orders per Store' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_725642550296616961]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='AVG([daily_orders_per_store])' />
        </column>
        <column caption='Avg. DMart Voucher Order Rank' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_725642550307139587]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='IF SUM([customer_dmart_voucher_order_rank])/SUM([customer_dmart_voucher_order_rank_orders]) &lt;=100 THEN &#13;&#10;SUM([customer_dmart_voucher_order_rank])/SUM([customer_dmart_voucher_order_rank_orders])&#13;&#10;ELSE NULL END' />
        </column>
