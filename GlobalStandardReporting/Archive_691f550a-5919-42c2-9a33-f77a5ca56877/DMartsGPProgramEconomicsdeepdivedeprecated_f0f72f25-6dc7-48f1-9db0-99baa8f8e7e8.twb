    <worksheet name='DF 2'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontsize='12'>#2 - Drivers</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (curated_data_shared_dmart)' name='federated.1kqu49p19gbt3b1d7org91ku68ok' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Structure' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Management Entity&quot;'>
              <calculation class='tableau' formula='&quot;Management Entity&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1kqu49p19gbt3b1d7org91ku68ok'>
            <column caption='Realized DF (% of Food)' datatype='real' default-format='p0.00%' name='[ABV (% of Food) (copy)_133700674173112344]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Food - ABV (copy)_133700674172923927] &gt; 0.1 THEN &#13;&#10;&#13;&#10;[ABV (copy)_133700674172489750]/[Food - ABV (copy)_133700674172923927]&#13;&#10;&#13;&#10;ELSE NULL END' />
            </column>
            <column caption='Realized DF' datatype='real' default-format='c#,##0.00&quot; €&quot;;-#,##0.00&quot; €&quot;' name='[ABV (copy)_133700674172489750]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([df])/SUM([confirmed_orders])' />
            </column>
            <column caption='ABV' datatype='real' default-format='c#,##0.00&quot; €&quot;;-#,##0.00&quot; €&quot;' name='[Avg. Price per Item (copy)_133700674111868934]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gbv_gross_of_vat_2])/SUM([confirmed_orders])' />
            </column>
            <column caption='Structure' datatype='string' name='[Calculation_133700674110947329]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;DH Group&quot; THEN &quot;DH Group&quot;&#13;&#10;    WHEN &quot;Region&quot; THEN [region]&#13;&#10;    WHEN &quot;Management Entity&quot; THEN [management_entity]&#13;&#10;    WHEN &quot;Country&quot; THEN [country_name]&#13;&#10;    WHEN &quot;Store&quot; THEN [store_name]&#13;&#10;END' />
            </column>
            <column aggregation='Sum' caption='Store Current Age' datatype='integer' name='[Calculation_133700674115506184]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,[warehouse_first_order_date],NOW())' />
            </column>
            <column aggregation='Sum' caption='Store Age in Reporting Month' datatype='integer' name='[Calculation_133700674115698697]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='MAX(DATEDIFF(&apos;month&apos;,[warehouse_first_order_date],[date_trunc_month]),0)' />
            </column>
            <column caption='Realized DF (% of ABV)' datatype='real' default-format='p0.00%' name='[Calculation_133700674173546521]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[ABV (copy)_133700674172489750]/[Avg. Price per Item (copy)_133700674111868934]' />
            </column>
            <column caption='% Orders w/DF &gt; 0' datatype='real' default-format='p0.00%' name='[Calculation_133700674177273885]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([w_df_orders])/SUM([confirmed_orders])' />
            </column>
            <column caption='Food - Realized DF' datatype='real' name='[Food - ABV (copy)_133700674172923927]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([food_delivery_fee])/SUM([food_od_orders])' />
            </column>
            <column caption='Food - Nominal DF' datatype='real' name='[Food - Realized DF (copy)_133700674174517275]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([food_delivery_fee])/SUM([food_w_df_orders])' />
            </column>
            <column caption='Nominal DF (% of Food)' datatype='real' default-format='p0.00%' name='[Realized DF (% of Food) (copy)_133700674176737308]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Realized DF (copy)_133700674174369818]/[Food - Realized DF (copy)_133700674174517275]' />
            </column>
            <column caption='Nominal DF' datatype='real' default-format='c#,##0.00&quot; €&quot;;-#,##0.00&quot; €&quot;' name='[Realized DF (copy)_133700674174369818]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([df])/SUM([w_df_orders])' />
            </column>
            <column datatype='integer' name='[confirmed_orders]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Month' datatype='date' name='[date_trunc_month]' role='dimension' type='ordinal' />
            <column datatype='real' name='[df]' role='measure' type='quantitative' />
            <column datatype='real' name='[food_delivery_fee]' role='measure' type='quantitative' />
            <column datatype='integer' name='[food_od_orders]' role='measure' type='quantitative' />
            <column datatype='integer' name='[food_w_df_orders]' role='measure' type='quantitative' />
            <column datatype='real' name='[gbv_gross_of_vat_2]' role='measure' type='quantitative' />
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
