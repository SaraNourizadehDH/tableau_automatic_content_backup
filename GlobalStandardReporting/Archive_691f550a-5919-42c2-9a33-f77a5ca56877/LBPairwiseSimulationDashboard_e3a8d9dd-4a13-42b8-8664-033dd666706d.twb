      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='lb_model_results' name='federated.1i0f06x1apl86110hwrds00zfijs' />
            <datasource caption='lb_raw_results' name='federated.171tgtz1syb29216yvr0n11yvapi' />
          </datasources>
          <datasource-dependencies datasource='federated.171tgtz1syb29216yvr0n11yvapi'>
            <column caption='Median Exp LM Elasticity Non-LBs' datatype='real' name='[Avg Exp LM Elasticity LBs (copy)_833165964886773763]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [entity_id], [master_asa_id]: AVG(IF [is_lb_lm] = &apos;N&apos; THEN [exp_elasticity] ELSE NULL END)}' />
            </column>
            <column caption='Median Elasticity LBs' datatype='real' name='[Avg Exp LM Elasticity LBs (copy)_833165964887670789]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [entity_id], [master_asa_id]: AVG(IF [is_lb_lm] = &apos;Y&apos; THEN [median_cluster_elasticity] ELSE NULL END)}' />
            </column>
            <column caption='Median Exp LM Elasticity LBs' datatype='real' name='[Calculation_833165964883955712]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [entity_id], [master_asa_id]: AVG(IF [is_lb_lm] = &apos;Y&apos; THEN [exp_elasticity] ELSE NULL END)}' />
            </column>
            <column caption='Order Share LBs' datatype='real' name='[Calculation_833165964885467138]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Order Count Non-LBs (copy)_833165964889325576] / ([Order Count Non-LBs (copy)_833165964889325576] + [Order Count LBs (copy)_833165964884508673])' />
