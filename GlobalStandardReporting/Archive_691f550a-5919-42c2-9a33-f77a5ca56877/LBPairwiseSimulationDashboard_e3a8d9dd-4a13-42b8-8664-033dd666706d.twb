    <worksheet name='GMV Eur Projection'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='11'>GMV Delta Projection From Current Price Setup Eur</run>
            <run>Æ&#10;&#10;</run>
