      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1davst71sud8m71car03c1757gc8].[sum:failed_orders_after_transmission:qk]&quot;' value='failed after transmission' />
          <alias key='&quot;[federated.1davst71sud8m71car03c1757gc8].[sum:failed_orders_before_transmission:qk]&quot;' value='failed before transmission' />
          <alias key='&quot;[federated.1davst71sud8m71car03c1757gc8].[sum:failed_orders:qk]&quot;' value='failed orders' />
          <alias key='&quot;[federated.1davst71sud8m71car03c1757gc8].[sum:orders_total:qk]&quot;' value='orders total' />
        </aliases>
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([failed_orders]) / TOTAL(SUM([failed_orders]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation2]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_total]) / TOTAL(SUM([orders_total]))'>
          <table-calc ordering-type='Columns' />
        </calculation>
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_1567534212566732800]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]=USERNAME()' />
      </column>
      <column caption='Vertical Type' datatype='string' name='[Calculation_1754996487577251840]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='Case  [is_dmart] &#10;    WHEN TRUE THEN &apos;Dmart&apos;&#10;WHEN FALSE THEN &apos;Local_stores&apos;&#10;END' />
      </column>
      <column caption='Date' datatype='date' datatype-customized='true' default-format='*YYYY-MM-DD' name='[Calculation_2592877147384442880]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parameter 1], [order_date], &apos;monday&apos;))' />
