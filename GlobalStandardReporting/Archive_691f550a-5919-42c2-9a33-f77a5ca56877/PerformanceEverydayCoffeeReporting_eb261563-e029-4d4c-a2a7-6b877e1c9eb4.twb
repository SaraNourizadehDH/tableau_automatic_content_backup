      <aliases enabled='yes' />
      <column caption='AOV (Vendor)' datatype='real' default-format='n#,##0.0&quot; €&quot;;-#,##0.0&quot; €&quot;' name='[AOV (Total) (copy)_428193809393545227]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Dmart AOV (copy)_428193809393242122]/[Calculation_428193809390440450]' />
      </column>
      <column caption='AOV (Dmart)' datatype='real' default-format='n#,##0.0&quot; €&quot;;-#,##0.0&quot; €&quot;' name='[AOV Vendor (copy)_428193809393668108]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_428193809392979977]/[Vendor Orders (copy)_428193809391169540]' />
      </column>
      <column caption='Avg Delivery Time (Vendor)' datatype='real' name='[Avg Delivery Time (Dmart) (copy)_3105091272063922179]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  [store_type]= &apos;Vendor&apos;&#10;THEN [avg_delivery_time_minutes]&#10;END' />
      </column>
      <column caption='Fail Rate (Dmart)' datatype='real' name='[Avg Delivery Time (Dmart) (copy)_3105091272064249860]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  [store_type]= &apos;Dmart&apos;&#10;THEN [fail_rate]&#10;END' />
      </column>
      <column caption='Basket Penetration' datatype='real' name='[Calculation_1476899271029125120]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [store_type]=&apos;Dmart&apos; THEN [successful_orders] ELSE NULL END )/SUM(IF [store_type]=&apos;Dmart&apos; THEN [penetration_denominator] ELSE NULL END)' />
      </column>
      <column caption='Discount € (Dmart)' datatype='real' name='[Calculation_1476899271031816195]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [store_type] WHEN &apos;Dmart&apos; THEN [amt_discount_eur] ELSE NULL END' />
      </column>
      <column caption='Discount € (Vendor)' datatype='real' name='[Calculation_1476899271032238085]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [store_type] WHEN &apos;Vendor&apos; THEN [amt_discount_eur] ELSE NULL END' />
      </column>
      <column caption='Date Granularity filter' datatype='boolean' name='[Calculation_291185925390733312]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN [time_level] = &apos;weekly&apos;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN [time_level] = &apos;monthly&apos;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Daily&apos; THEN  [time_level] = &apos;daily&apos;&#10;END' />
      </column>
      <column caption='Items per Order (Vendor)' datatype='real' name='[Calculation_3105091270678093824]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  [store_type]= &apos;Vendor&apos;&#10;THEN [items_qty_sold]/[successful_orders]&#10;END' />
      </column>
      <column caption='Basket Penetration(OLD)' datatype='real' name='[Calculation_3105091272086335496]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([successful_orders])/ SUM([penetration_denominator])' />
      </column>
      <column caption='Orders (Vendor)' datatype='integer' name='[Calculation_428193809390440450]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [store_type] = &apos;Vendor&apos; THEN [successful_orders] END)' />
      </column>
      <column caption='Dmart %' datatype='real' default-format='p0%' name='[Calculation_428193809391255557]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Vendor Orders (copy)_428193809391169540]/SUM([successful_orders])' />
      </column>
      <column caption='AOV (Total)' datatype='real' default-format='n#,##0.0&quot; €&quot;;-#,##0.0&quot; €&quot;' name='[Calculation_428193809392381959]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([amt_gbv_eur_evd_items])/SUM([successful_orders])' />
      </column>
      <column caption='Dmart GBV Euro' datatype='real' name='[Calculation_428193809392979977]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF store_type = &apos;Dmart&apos; THEN [amt_gbv_eur_evd_items] END)' />
      </column>
      <column caption='Delivery Fee(Dmart)' datatype='real' name='[Calculation_438819500169814017]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [store_type] WHEN &apos;Dmart&apos; THEN [amt_delivery_fee_eur] ELSE NULL END' />
      </column>
      <column caption='Delivery Fee(Vendor)' datatype='real' name='[Calculation_438819500169932802]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [store_type] WHEN &apos;Vendor&apos; THEN [amt_delivery_fee_eur] ELSE NULL END' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_934496970415378432]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]=USERNAME()' />
      </column>
      <column caption='Vendor %' datatype='real' default-format='p0%' name='[Dmart % (copy)_428193809391702022]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_428193809390440450]/SUM([successful_orders])' />
      </column>
      <column caption='Vendor GBV Euro' datatype='real' name='[Dmart AOV (copy)_428193809393242122]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [store_type] = &apos;Vendor&apos; THEN [amt_gbv_eur_evd_items] END)' />
      </column>
      <column caption='Fail Rate (Vendor)' datatype='real' name='[Fail Rate (Dmart) (copy)_3105091272064565253]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  [store_type]= &apos;Vendor&apos;&#10;THEN [fail_rate]&#10;END' />
      </column>
      <column caption='NPS (Dmart)' datatype='real' name='[Fail Rate (Dmart) (copy)_3105091272065081350]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  [store_type]= &apos;Dmart&apos;&#10;THEN [ao_nps]&#10;END' />
      </column>
      <column caption='Avg Delivery Time (Dmart)' datatype='real' name='[Items per Order (Dmart) (copy)_3105091272063553538]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  [store_type]= &apos;Dmart&apos;&#10;THEN [avg_delivery_time_minutes]&#10;END' />
      </column>
      <column caption='Items per Order (Dmart)' datatype='real' name='[Items per Order (Vendor) (copy)_3105091270680047617]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  [store_type]= &apos;Dmart&apos;&#10;THEN [items_qty_sold]/[successful_orders]&#10;END' />
      </column>
      <column caption='NPS (Vendor)' datatype='real' name='[NPS (Dmart) (copy)_3105091272065392647]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  [store_type]= &apos;Vendor&apos;&#10;THEN [ao_nps]&#10;END' />
      </column>
      <column caption='Ord/st./day' datatype='real' name='[Ord/st./day (copy)_1732478549265506305]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF (SUM([count_warehouses]) &gt;= SUM([count_vendors]) AND [Parameters].[Parameter 1] = &apos;Weekly&apos;)&#10;THEN SUM([successful_orders])/ SUM([count_warehouses]) / 7&#10;&#10;ELSEIF (SUM([count_warehouses]) &gt;= SUM([count_vendors]) AND [Parameters].[Parameter 1] = &apos;Monthly&apos;)&#10;THEN SUM([successful_orders])/ SUM([count_warehouses]) / 30&#10;&#10;ELSEIF (SUM([count_warehouses]) &gt;= SUM([count_vendors]) AND [Parameters].[Parameter 1] = &apos;Daily&apos; )&#10;THEN SUM([successful_orders])/ SUM([count_warehouses])&#10;&#10;ELSEIF (SUM([count_warehouses]) &lt; SUM([count_vendors]) AND [Parameters].[Parameter 1] = &apos;Weekly&apos;)&#10;THEN SUM([successful_orders])/ SUM([count_vendors]) / 7&#10;&#10;ELSEIF (SUM([count_warehouses]) &lt; SUM([count_vendors]) AND [Parameters].[Parameter 1] = &apos;Monthly&apos;)&#10;THEN SUM([successful_orders])/ SUM([count_vendors]) / 30&#10;&#10;ELSE SUM([successful_orders])/ SUM([count_vendors])&#10;&#10;END' />
      </column>
      <column caption='Orders (Dmart)' datatype='integer' name='[Vendor Orders (copy)_428193809391169540]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [store_type] = &apos;Dmart&apos; THEN [successful_orders] END)' />
      </column>
