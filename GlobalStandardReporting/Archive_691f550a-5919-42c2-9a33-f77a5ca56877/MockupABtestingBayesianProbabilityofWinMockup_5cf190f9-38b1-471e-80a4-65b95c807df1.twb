      <aliases enabled='yes' />
      <column caption='% bayesian mean (upper)' datatype='real' default-format='*+0.0%;-0.0%;-' name='[% bayesian mean (copy)_1105633722148393073]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([Calculation_1988620734895140871])) - LOOKUP(ZN(SUM([Calculation_1988620734893367297])))) / ABS(LOOKUP(ZN(SUM([Calculation_1988620734893367297]))))'>
          <table-calc ordering-field='[federated.07gqhgo1hwjxes1db78jk00rw6rb].[Calculation_1105633722119082085]' ordering-type='Field' tc-options='Fixed'>
            <address>
              <value>&quot;Control&quot;</value>
            </address>
          </table-calc>
        </calculation>
      </column>
      <column caption='% bayesian mean (lower)' datatype='real' default-format='*+0.0%;-0.0%;-' name='[% bayesian mean (upper) (copy)_1105633722148503666]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([Calculation_1988620734894678021])) - LOOKUP(ZN(SUM([Calculation_1988620734893367297])))) / ABS(LOOKUP(ZN(SUM([Calculation_1988620734893367297]))))'>
          <table-calc ordering-field='[federated.07gqhgo1hwjxes1db78jk00rw6rb].[Calculation_1105633722119082085]' ordering-type='Field' tc-options='Fixed'>
            <address>
