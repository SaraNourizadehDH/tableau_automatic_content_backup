            </address>
          </table-calc>
        </calculation>
      </column>
      <column caption='Bottom (copy)' datatype='real' default-format='c&quot;€&quot;#,##0.00;(&quot;€&quot;#,##0.00)' name='[Bottom (copy)_1489002645140209683]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [% bayesian mean (upper) (copy)_1105633722148503666] &gt; 0 AND LOOKUP([% bayesian mean (copy)_1105633722148393073],-1) &lt; 0 THEN 0&#13;&#10;ELSEIF [% bayesian mean (upper) (copy)_1105633722148503666] &gt; 0 THEN [% bayesian mean (upper) (copy)_1105633722148503666]&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% Uplift' datatype='real' default-format='*+0.0%;-0.0%;-' name='[Calculation2]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([Calculation_1988620734893367297])) - LOOKUP(ZN(SUM([Calculation_1988620734893367297])))) / ABS(LOOKUP(ZN(SUM([Calculation_1988620734893367297]))))'>
          <table-calc ordering-field='[federated.07gqhgo1hwjxes1db78jk00rw6rb].[Calculation_1105633722119082085]' ordering-type='Field' tc-options='Fixed'>
            <address>
              <value>&quot;Control&quot;</value>
            </address>
          </table-calc>
        </calculation>
      </column>
      <column caption='Day' datatype='integer' name='[Calculation_1105633721874739229]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[test_start_date],[analysed_date])' />
      </column>
      <column caption='Band' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1105633721891233825]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ABS([Calculation_1988620734894485508] - [Calculation_1988620734894227459])' />
      </column>
      <column caption='Top' datatype='real' default-format='c&quot;€&quot;#,##0.00;(&quot;€&quot;#,##0.00)' name='[Calculation_1105633721955364910]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF MIN([Calculation_1988620734895140871]) &gt; 0 AND LOOKUP(MIN([Calculation_1988620734895140871]),-1) &lt; 0 &#13;&#10;    THEN LOOKUP(MIN([Calculation_1988620734895140871]),0)&#13;&#10;ELSEIF MIN([Calculation_1988620734895140871]) &lt; 0&#13;&#10;    THEN MIN([Calculation_1988620734895140871])&#13;&#10;//ELSE 0&#13;&#10;END&#13;&#10;&#13;&#10;//[Bottom]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Result' datatype='string' name='[Calculation_1105633722100957284]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='(IF [Calculation_1105633721874739229] &gt; 3 AND [p_var_greater_all] &gt; 0.8 THEN &apos;Winning&apos; &#13;&#10;ELSEIF [Calculation_1105633721874739229] &gt; 3 AND [p_var_greater_all] &gt; 0.4 THEN &apos;Contender&apos; &#13;&#10;ELSE &apos;-&apos;  END)' />
      </column>
      <column caption='Variant' datatype='string' name='[Calculation_1105633722119082085]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='REPLACE([variant],&apos;iation&apos;,&apos;&apos;)' />
      </column>
      <column caption='Entitlement' datatype='boolean' name='[Calculation_1105633722126995563]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]=USERNAME()' />
      </column>
      <column caption='Tests' datatype='boolean' name='[Calculation_1105633722173251701]' role='measure' type='nominal'>
        <calculation class='tableau' formula='TOTAL(COUNTD([test_id]))=1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Rank' datatype='real' name='[Calculation_1489002645121884169]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [last_output] THEN &#13;&#10;[Calculation_1988620734893367297] / ABS({ FIXED [entity_id], [test_id], [target_kpi] : MAX(IF [last_output] AND [Calculation_1105633722119082085] = &apos;Control&apos; THEN [Calculation_1988620734893367297] END) }) - 1&#13;&#10;END' />
