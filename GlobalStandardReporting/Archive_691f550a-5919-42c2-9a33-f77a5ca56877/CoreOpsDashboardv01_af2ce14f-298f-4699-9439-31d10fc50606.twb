      <column caption='Country' datatype='string' name='[Calculation_5426204248439414784]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [country_code]=&quot;ar&quot; then &quot;Argentina&quot;&#10;ELSEIF [country_code]=&quot;cl&quot; then &quot;Chile&quot;&#10;ELSEIF [country_code]=&quot;ec&quot; then &quot;Ecuador&quot;&#10;ELSEIF [country_code]=&quot;kw&quot; then &quot;Kuwait&quot;&#10;ELSEIF [country_code]=&quot;pe&quot; then &quot;Peru&quot;&#10;ELSEIF [country_code]=&quot;tr&quot; then &quot;Turkey&quot;&#10;ELSEIF [country_code]=&quot;bd&quot; then &quot;Bangladesh&quot;&#10;ELSEIF [country_code]=&quot;hk&quot; then &quot;Hong Kong&quot;&#10;ELSEIF [country_code]=&quot;ph&quot; then &quot;Philippinnes&quot;&#10;ELSEIF [country_code]=&quot;pk&quot; then &quot;Pakistan&quot;&#10;ELSEIF [country_code]=&quot;sg&quot; then &quot;Singapore&quot;&#10;ELSEIF [country_code]=&quot;tw&quot; then &quot;Taiwan&quot;&#10;ELSEIF [country_code]=&quot;my&quot; then &quot;Malaysia&quot;&#10;END' />
      </column>
      <column caption='DC2Dmart Fill Rate' datatype='real' name='[Calculation_5426204248453414913]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([received_qty])/SUM([requested_qty])' />
      </column>
