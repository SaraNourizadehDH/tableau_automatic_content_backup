      <column caption='Avg. Inbounding Time/SKU (ST)' datatype='real' name='[Avg. Receiving Time/SKU (copy)_7015482347734155264]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dest_reciveing_time_s])/60/SUM([dest_st_sku_count])' />
      </column>
      <column caption='Avg, PO Receiving Time (m)' datatype='real' name='[Calculation_1153906692360093696]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([receiving_time_specific_hour_s])/60/ SUM([purchase_orders])' />
      </column>
      <column caption='Avg. Receiving Time/SKU (PO)' datatype='real' name='[Calculation_2168835089978281985]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([receiving_time_specific_hour_s])/60/SUM([purchase_order_skus])' />
      </column>
      <column caption='Avg. #SKUs/PO' datatype='real' name='[Calculation_2168835089985089538]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([purchase_order_skus])/SUM([purchase_orders])' />
      </column>
      <column caption='AJ - ST Orders' datatype='integer' name='[Calculation_2168835090461466627]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [src_st_sku_count]&gt; 0 and [src_st_received_qty]&gt; 0 then 1 else 0 end' />
      </column>
      <column caption='Is Preorder' datatype='boolean' name='[Calculation_2168835091793571845]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [preorders] &gt; 1 THEN TRUE &#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='Global Entity' datatype='string' name='[Calculation_2168835091865878534]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='left([global_entity_id],2)' />
      </column>
      <column caption='Region_Correct' datatype='string' name='[Calculation_2168835091870109703]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [region]=&apos;America&apos; then &apos;Americas&apos; else [region] END' />
      </column>
      <column caption='Country_Filter' datatype='string' name='[Calculation_2168835092129222664]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[country]' />
      </column>
      <column caption='Avg. #SKUs/ST' datatype='real' name='[Calculation_2168835092144611337]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([src_st_sku_count])/sum([src_store_transfer])' />
      </column>
      <column caption='Avg. Store Transfer Time' datatype='real' name='[Calculation_2168835092153708554]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([dest_reciveing_time_s])/60/sum([dest_store_transfer])' />
      </column>
