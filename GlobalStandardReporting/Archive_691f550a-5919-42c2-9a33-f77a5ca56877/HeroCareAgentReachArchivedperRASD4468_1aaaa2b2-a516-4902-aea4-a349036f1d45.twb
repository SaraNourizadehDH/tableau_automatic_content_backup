      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='1350' minheight='1350' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='189' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='84000' id='188' param='vert' type-v2='layout-flow' w='84000' x='8000' y='8000'>
                <zone alt-text='DH Logistics Logo' fixed-size='101' h='7591' id='15' is-fixed='true' is-scaled='1' param='Image/DH Logistics Logo.png' type-v2='bitmap' w='11013' x='468' y='810'>
                  <zone-style>
