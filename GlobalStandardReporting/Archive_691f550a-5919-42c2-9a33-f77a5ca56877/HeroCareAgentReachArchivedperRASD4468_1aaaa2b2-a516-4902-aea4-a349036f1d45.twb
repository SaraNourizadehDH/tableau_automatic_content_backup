      <column caption='% non-Herocare Agents (globally)' datatype='real' name='[Herocare Agents Total (copy)_579838460978884608]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([active_agents_count]-[herocare_agents_total]))&#13;&#10;/&#13;&#10;MAX( { FIXED [resolved_week]: SUM([active_agents_count])})' />
