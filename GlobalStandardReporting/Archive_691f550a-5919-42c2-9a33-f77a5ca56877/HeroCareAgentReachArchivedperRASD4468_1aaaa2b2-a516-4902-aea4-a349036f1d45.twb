      <aliases enabled='yes' />
      <column caption='% HeroCare Agents (globally)' datatype='real' name='[% HeroCare Agents (copy)_579838460984254466]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([herocare_agents_total])&#13;&#10;/ &#13;&#10;MAX({ FIXED [resolved_week]: SUM([active_agents_count])})' />
      </column>
      <column caption='% non-HeroCare Agents' datatype='real' name='[% HeroCare Agents (copy)_63894831211442177]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([active_agents_count])-SUM([herocare_agents_total]))&#13;&#10;/ &#13;&#10;SUM([active_agents_count])' />
      </column>
      <column caption='% OneView Agents' datatype='real' name='[% HeroCare Agents (copy)_738308866195996673]' role='measure' type='quantitative'>
