      <column caption='% HeroCare Agents' datatype='real' name='[Active Agents Count (copy)_738308866195701760]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([herocare_agents_total])&#13;&#10;/ &#13;&#10;SUM([active_agents_count])' />
      </column>
      <column caption='Metric' datatype='real' name='[Calculation_1018657943284723712]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  [Parameters].[Parameter 1] = &quot;% HeroCare Agents&quot; THEN [Active Agents Count (copy)_738308866195701760]&#13;&#10;ELSEIF   [Parameters].[Parameter 1] = &quot;% Agent Platform Agents&quot; THEN [% OneView Agents (copy)_738308866196160514]&#13;&#10;ELSEIF   [Parameters].[Parameter 1] = &quot;% OneView Agents&quot; THEN [% HeroCare Agents (copy)_738308866195996673]&#13;&#10;ELSEIF   [Parameters].[Parameter 1] = &quot;# Active Agents&quot; THEN SUM([active_agents_count])&#13;&#10;END' />
      </column>
      <column caption='Dimension 1' datatype='string' name='[Calculation_1174313605472231424]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [Parameters].[Parameter 2] = &quot;Management Entity Group&quot; THEN [management_entity_group]&#13;&#10;ELSEIF   [Parameters].[Parameter 2] = &quot;Stakeholder&quot; THEN [stakeholder]&#13;&#10;ELSEIF   [Parameters].[Parameter 2] = &quot;Contact Center&quot; THEN [contact_center]&#13;&#10;ELSEIF   [Parameters].[Parameter 2] = &quot;Global&quot; THEN &quot;Global&quot;&#13;&#10;END' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_172825638438617096]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Dimension 2' datatype='string' name='[Dimension 1 (copy)_1174313605473775618]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [Parameters].[Dimension 1 (copy)_1174313605473480705] = &quot;Management Entity Group&quot; THEN [management_entity_group]&#13;&#10;ELSEIF   [Parameters].[Dimension 1 (copy)_1174313605473480705] = &quot;Stakeholder&quot; THEN [stakeholder]&#13;&#10;ELSEIF   [Parameters].[Dimension 1 (copy)_1174313605473480705] = &quot;Contact Center&quot; THEN [contact_center]&#13;&#10;END' />
