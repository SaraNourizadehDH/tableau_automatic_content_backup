            <zone fixed-size='135' h='13910' id='120' is-fixed='true' layout-strategy-id='distribute-evenly' param='horz' type-v2='layout-flow' w='98988' x='506' y='14786'>
              <zone forceUpdate='true' h='13132' id='117' type-v2='text' w='32827' x='759' y='15175'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Definitions</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#898989' fontsize='10'>Active Agen</run>
                  <run fontcolor='#898989' fontsize='10'>t</run>
                  <run fontcolor='#000000' fontsize='10'> = Agent who resolved at least one contact (chat, call, email, form, other non-live) in Salesforce, Freshchat, Freshdesk or HeroCare ib the given period (week).</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#d50f16' fontsize='10'>Agent Platform Agent</run>
                  <run fontcolor='#000000' fontsize='10'> = Active agent who ever faced agent platform (communication module of HeroCare on the left side of the application) in the given period (week) or before</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#f5f5f5' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='13132' id='118' type-v2='text' w='32828' x='33586' y='15175'>
                <formatted-text>
                  <run bold='true' fontcolor='#ffbe7d' fontsize='10'>Oneview Agent</run>
                  <run fontcolor='#000000' fontsize='10'> = Active agent who ever faced OneView (data manipulation module of HeroCare on the right side of the application) in the given period (week) or before</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>HeroCare Agent</run>
                  <run fontcolor='#000000' fontsize='10'> = Agent who is a Oneview Agent and an Agent Platform Agent</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#f5f5f5' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='13132' id='119' type-v2='text' w='32827' x='66414' y='15175'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Metrics</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>% HeroCare Agents</run>
                  <run fontcolor='#000000' fontsize='10'> = # Herocare agents / # Active agents</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#d50f16' fontsize='10'>% Agent Platform Agents</run>
                  <run fontcolor='#000000' fontsize='10'> =  # Agent platform agents / # Active agents</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffbe7d' fontsize='10'>% OneView Agents</run>
                  <run fontcolor='#000000' fontsize='10'> = # Oneview agents / # Active agents</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#f5f5f5' />
                </zone-style>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone fixed-size='231' h='22471' id='19' is-fixed='true' param='horz' type-v2='layout-flow' w='98988' x='506' y='28696'>
