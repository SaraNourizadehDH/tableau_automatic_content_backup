        <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Week&apos;&#10;then &#10;    {EXCLUDE [Calculation_5628795904920092674]: &#10;    SUM(&#10;    IF [Calculation_672443783518289922]&#10;    THEN [CSAT 4_5 RR used and not accepted (copy)_5628795906622255144]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [Calculation_672443783518289922]&#10;    THEN [Count CSAT Responses RR used and not accepted (copy)_5628795906622836781]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos;&#10;then &#10;  {EXCLUDE [Calculation_5628795904920092674]: &#10;    SUM(&#10;    IF [is_max_month (copy)_352899259462545410]&#10;    THEN [CSAT 4_5 RR used and not accepted (copy)_5628795906622255144]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [is_max_month (copy)_352899259462545410]&#10;    THEN [Count CSAT Responses RR used and not accepted (copy)_5628795906622836781]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month&apos;&#10;then &#10;  {EXCLUDE [Calculation_5628795904920092674]: &#10;    SUM(&#10;    IF [is_max_week (copy)_352899259461615616]&#10;    THEN [CSAT 4_5 RR used and not accepted (copy)_5628795906622255144]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [is_max_week (copy)_352899259461615616]&#10;    THEN [Count CSAT Responses RR used and not accepted (copy)_5628795906622836781]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;end' />
