        <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Week&apos;&#10;then &#10;    {EXCLUDE [Calculation_5628795904920092674]: &#10;    SUM(&#10;    IF [is_max_week (copy)_672443783520116739]&#10;    THEN [CSAT 4_5 RR used and fully accepted (copy)_5628795906622140455]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [is_max_week (copy)_672443783520116739]&#10;    THEN [Count CSAT Responses RR used and fully accepted (copy)_5628795906622758956]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos;&#10;then &#10;  {EXCLUDE [Calculation_5628795904920092674]: &#10;    SUM(&#10;    IF [is_max_date (copy)_352899259463598083]&#10;    THEN [CSAT 4_5 RR used and fully accepted (copy)_5628795906622140455]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [is_max_date (copy)_352899259463598083]&#10;    THEN [Count CSAT Responses RR used and fully accepted (copy)_5628795906622758956]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month&apos;&#10;then &#10;  {EXCLUDE [Calculation_5628795904920092674]: &#10;    SUM(&#10;    IF [is_max_week_minus_one (copy)_352899259461959681]&#10;    THEN [CSAT 4_5 RR used and fully accepted (copy)_5628795906622140455]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [is_max_week_minus_one (copy)_352899259461959681]&#10;    THEN [Count CSAT Responses RR used and fully accepted (copy)_5628795906622758956]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;end' />
