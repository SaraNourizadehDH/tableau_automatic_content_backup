        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;CSAT (in %)&apos; THEN (&#10;     CASE [Parameters].[Parameter 3]&#10;       WHEN &apos;RR used and fully accepted&apos; THEN ROUND(LOOKUP(ZN([CSAT RR used (copy)_5628795906623733808]), FIRST())*100,1)&#10;       WHEN &apos;RR used and partially accepted&apos; THEN ROUND(LOOKUP(ZN([CSAT RR used and not accepted (copy)_5628795906623942706]), FIRST())*100,1)&#10;     END&#10;     )&#10;WHEN &apos;RR Acceptance Rate&apos; THEN (&#10;     CASE [Parameters].[Parameter 3]&#10;       WHEN &apos;RR used and fully accepted&apos; THEN ROUND(LOOKUP(ZN([% of partially accepted (copy)_5628795906306863121]), FIRST())*100,1)&#10;       WHEN &apos;RR used and partially accepted&apos; THEN ROUND(LOOKUP(ZN([Count Served Chats RR used and partially accepted (copy)_5628795906306400272]), FIRST())*100,1)&#10;     END&#10;     )&#10;WHEN &apos;RR Adoption&apos; THEN (&#10;     CASE [Parameters].[Parameter 3]&#10;       WHEN &apos;RR used and fully accepted&apos; THEN ROUND(LOOKUP(ZN([RR Adoption (copy)_2564377780659953666]), FIRST())*100,1)&#10;       WHEN &apos;RR used and partially accepted&apos; THEN ROUND(LOOKUP(ZN([Adoption RR used and fully accepted (copy)_2564377780674392068]), FIRST())*100,1)&#10;     END&#10;     )&#10;WHEN &apos;AHT (in mins)&apos; THEN (&#10;     CASE [Parameters].[Parameter 3]&#10;       WHEN &apos;RR used and fully accepted&apos; THEN ROUND(LOOKUP(ZN([AHT RR not used (in mins) (copy)_5628795906611908639]), FIRST()),1)&#10;       WHEN &apos;RR used and partially accepted&apos; THEN ROUND(LOOKUP(ZN([AHT RR used and not accepted (in mins) (copy)_5628795906612215841]), FIRST()),1)&#10;     END&#10;     )&#10;END'>
