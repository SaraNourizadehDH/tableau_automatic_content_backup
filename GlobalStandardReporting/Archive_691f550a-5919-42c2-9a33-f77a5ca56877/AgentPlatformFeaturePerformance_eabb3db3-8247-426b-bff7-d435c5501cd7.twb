            </column>
            <column caption='Select KPI - Trend' datatype='real' default-format='*0.0%▲;-0.0%▼' name='[Calculation_2464172743945846784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;  // -- for % value KPIs&#10;  WHEN &apos;CSAT (in %)&apos; THEN (&#10;    CASE [Parameters].[Parameter 3]&#10;      WHEN &apos;RR used and fully accepted&apos; THEN IF ISNULL(LOOKUP(ZN([CSAT RR used (copy)_5628795906623733808]),-1)) THEN 0 ELSE RUNNING_SUM(ZN([CSAT RR used (copy)_5628795906623733808]) - LOOKUP(ZN([CSAT RR used (copy)_5628795906623733808]), -1)) END&#10;      WHEN &apos;RR used and partially accepted&apos; THEN IF ISNULL(LOOKUP(ZN([CSAT RR used and not accepted (copy)_5628795906623942706]),-1)) THEN 0 ELSE RUNNING_SUM(ZN([CSAT RR used and not accepted (copy)_5628795906623942706]) - LOOKUP(ZN([CSAT RR used and not accepted (copy)_5628795906623942706]), -1)) END&#10;    END&#10;  )&#10;  WHEN &apos;RR Acceptance Rate&apos; THEN (&#10;    CASE [Parameters].[Parameter 3]&#10;      WHEN &apos;RR used and fully accepted&apos; THEN IF ISNULL(LOOKUP(ZN([% of partially accepted (copy)_5628795906306863121]),-1)) THEN 0 ELSE RUNNING_SUM(ZN([% of partially accepted (copy)_5628795906306863121]) - LOOKUP(ZN([% of partially accepted (copy)_5628795906306863121]), -1)) END&#10;      WHEN &apos;RR used and partially accepted&apos; THEN IF ISNULL(LOOKUP(ZN([Count Served Chats RR used and partially accepted (copy)_5628795906306400272]),-1)) THEN 0 ELSE RUNNING_SUM(ZN([Count Served Chats RR used and partially accepted (copy)_5628795906306400272]) - LOOKUP(ZN([Count Served Chats RR used and partially accepted (copy)_5628795906306400272]), -1)) END&#10;    END&#10;  )&#10;  WHEN &apos;RR Adoption&apos; THEN (&#10;    CASE [Parameters].[Parameter 3]&#10;      WHEN &apos;RR used and fully accepted&apos; THEN IF ISNULL(LOOKUP(ZN([RR Adoption (copy)_2564377780659953666]),-1)) THEN 0 ELSE RUNNING_SUM(ZN([RR Adoption (copy)_2564377780659953666]) - LOOKUP(ZN([RR Adoption (copy)_2564377780659953666]), -1)) END&#10;      WHEN &apos;RR used and partially accepted&apos; THEN IF ISNULL(LOOKUP(ZN([Adoption RR used and fully accepted (copy)_2564377780674392068]),-1)) THEN 0 ELSE RUNNING_SUM(ZN([Adoption RR used and fully accepted (copy)_2564377780674392068]) - LOOKUP(ZN([Adoption RR used and fully accepted (copy)_2564377780674392068]), -1)) END&#10;    END&#10;  )&#10;  // -- for decimal value KPIs&#10;  WHEN &apos;AHT (in mins)&apos; THEN (&#10;    CASE [Parameters].[Parameter 3]&#10;      WHEN &apos;RR used and fully accepted&apos; THEN IF ISNULL(LOOKUP(ZN([AHT RR not used (in mins) (copy)_5628795906611908639]),-1)) THEN 0 ELSE RUNNING_SUM(ZN(ROUND([AHT RR not used (in mins) (copy)_5628795906611908639],1)) - LOOKUP(ZN(ROUND([AHT RR not used (in mins) (copy)_5628795906611908639],1)), -1)) / LOOKUP(ZN(ROUND([AHT RR not used (in mins) (copy)_5628795906611908639],1)), FIRST()) END&#10;      WHEN &apos;RR used and partially accepted&apos; THEN IF ISNULL(LOOKUP(ZN([AHT RR used and not accepted (in mins) (copy)_5628795906612215841]),-1)) THEN 0 ELSE RUNNING_SUM(ZN(ROUND([AHT RR used and not accepted (in mins) (copy)_5628795906612215841],1)) - LOOKUP(ZN(ROUND([AHT RR used and not accepted (in mins) (copy)_5628795906612215841],1)), -1)) / LOOKUP(ZN(ROUND([AHT RR used and not accepted (in mins) (copy)_5628795906612215841],1)), FIRST()) END&#10;      END&#10;  )&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Date Granularity' datatype='string' name='[Calculation_5628795904920092674]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&apos;Day&apos; THEN STR([report_date])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Week&apos; THEN [week]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Month&apos; THEN [month]&#10;END' />
            </column>
            <column caption='Count CSAT Responses RR used and fully accepted' datatype='integer' name='[Count CSAT Responses RR used (copy)_5628795906622652459]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [rr_funnel] = &apos;RR used and fully accepted&apos; THEN[count_csat_responses] END' />
            </column>
            <column caption='Count CSAT Responses RR used and partially accepted' datatype='integer' name='[Count CSAT Responses RR used and not accepted (copy)_5628795906622836781]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [rr_funnel] = &apos;RR used and partially accepted&apos; THEN[count_csat_responses] END' />
            </column>
            <column caption='Count Served Chats RR used and not accepted' datatype='integer' name='[Count Served Chats (copy)_5628795906289303560]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [rr_funnel] = &apos;RR used and not accepted&apos; THEN[count_served_chats] END' />
            </column>
            <column caption='Count Served Chats RR used' datatype='integer' name='[Count Served Chats RR not used (copy)_5628795906302361614]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([Count Served Chats (copy)_5628795906289303560],0)) +&#10;SUM(IFNULL([Count Served Chats RR used and partially accepted (copy)_5628795906291351562],0)) +&#10;SUM(IFNULL([Count Served Chats RR used and not accepted (copy)_5628795906290397193],0))' />
            </column>
            <column caption='HT Served Chats RR used and fully accepted' datatype='real' name='[Count Served Chats RR used and fully accepted (copy)_5628795906308890648]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [rr_funnel] = &apos;RR used and fully accepted&apos; THEN[handling_time_secs] END' />
            </column>
            <column caption='Count Served Chats RR used and partially accepted' datatype='integer' name='[Count Served Chats RR used and not accepted (copy)_5628795906290397193]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [rr_funnel] = &apos;RR used and partially accepted&apos; THEN[count_served_chats] END' />
            </column>
            <column caption='Count Served Chats RR used and fully accepted' datatype='integer' name='[Count Served Chats RR used and partially accepted (copy)_5628795906291351562]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [rr_funnel] = &apos;RR used and fully accepted&apos; THEN[count_served_chats] END' />
            </column>
            <column caption='RR Acceptance Rate - used partially accepted' datatype='real' default-format='p0.0%' name='[Count Served Chats RR used and partially accepted (copy)_5628795906306400272]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Count Served Chats RR used and not accepted (copy)_5628795906290397193])/ [Count Served Chats RR not used (copy)_5628795906302361614]' />
            </column>
            <column caption='HT Served Chats RR used and partially accepted' datatype='real' name='[Count Served Chats RR used and partially accepted (copy)_5628795906308890647]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [rr_funnel] = &apos;RR used and partially accepted&apos; THEN[handling_time_secs] END' />
            </column>
            <column caption='RR Adoption - used and fully accepted' datatype='real' default-format='p0.0%' name='[RR Adoption (copy)_2564377780659953666]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Count Served Chats RR used and partially accepted (copy)_5628795906291351562]) / SUM([count_served_chats])' />
            </column>
            <column caption='Report Date Range' datatype='date' name='[Report Date (copy)_5628795904927301635]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[report_date]' />
            </column>
            <column caption='Date Granularity - lookup first value' datatype='string' default-format='*0.0%▲;-0.0%▼' name='[Select KPI - lookup previous value (copy)_2770276781324017666]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Month&apos; THEN STR(LOOKUP(MIN([month]),FIRST()))&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Week&apos; THEN STR(LOOKUP(MIN([week]),FIRST()))&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos; THEN STR(LOOKUP(MIN([report_date]),FIRST()))&#10;&#10;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Select KPI - lookup current value' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Select KPI - lookup previous value (copy)_2770276781330673670]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;CSAT (in %)&apos; THEN (&#10;     CASE [Parameters].[Parameter 3]&#10;       WHEN &apos;RR used and fully accepted&apos; THEN ROUND(LOOKUP(ZN([CSAT RR used (copy)_5628795906623733808]), 0)*100,1)&#10;       WHEN &apos;RR used and partially accepted&apos; THEN ROUND(LOOKUP(ZN([CSAT RR used and not accepted (copy)_5628795906623942706]), 0)*100,1)&#10;     END&#10;     )&#10;WHEN &apos;RR Acceptance Rate&apos; THEN (&#10;     CASE [Parameters].[Parameter 3]&#10;       WHEN &apos;RR used and fully accepted&apos; THEN ROUND(LOOKUP(ZN([% of partially accepted (copy)_5628795906306863121]), 0)*100,1)&#10;       WHEN &apos;RR used and partially accepted&apos; THEN ROUND(LOOKUP(ZN([Count Served Chats RR used and partially accepted (copy)_5628795906306400272]), 0)*100,1)&#10;     END&#10;     )&#10;WHEN &apos;RR Adoption&apos; THEN (&#10;     CASE [Parameters].[Parameter 3]&#10;       WHEN &apos;RR used and fully accepted&apos; THEN ROUND(LOOKUP(ZN([RR Adoption (copy)_2564377780659953666]), 0)*100,1)&#10;       WHEN &apos;RR used and partially accepted&apos; THEN ROUND(LOOKUP(ZN([Adoption RR used and fully accepted (copy)_2564377780674392068]), 0)*100,1)&#10;     END&#10;     )&#10;WHEN &apos;AHT (in mins)&apos; THEN (&#10;     CASE [Parameters].[Parameter 3]&#10;       WHEN &apos;RR used and fully accepted&apos; THEN ROUND(LOOKUP(ZN([AHT RR not used (in mins) (copy)_5628795906611908639]), 0),1)&#10;       WHEN &apos;RR used and partially accepted&apos; THEN ROUND(LOOKUP(ZN([AHT RR used and not accepted (in mins) (copy)_5628795906612215841]), 0),1)&#10;     END&#10;     )&#10;END'>
