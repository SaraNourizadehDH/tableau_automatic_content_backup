    <worksheet name='Vertical - Table'>
      <repository-location id='Vertical-Table' path='/t/GlobalStandardReporting/workbooks/StaticQC-Performance-Incrementality' revision='' site='GlobalStandardReporting' />
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#d30000' fontname='Tableau Bold' fontsize='18'><![CDATA[<[Parameters].[Parameter 2]> GBV Uplift of <[Parameters].[Parameter 1]>: 6M post-trial vs. 6M pre-trial]]></run>
            <run>Æ&#10;</run>
            <run bold='true' fontname='Tableau Book' fontsize='12'><![CDATA[Filtering only cross-selled LS<>DM users from Jan'22 to Jan'23 that have tried the first vertical 6 months before trying the second one.]]></run>
            <run>Æ&#10;</run>
            <run bold='true' fontname='Tableau Book' fontsize='12'>For simplicity: QC = Dmarts + Shops</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (curated_data_shared_central_dwh) (3)' name='federated.1vttx4m1hwa2sp14t9ppj0p8atv3' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Trial Direction' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Existing in DM &gt; Tried LS&quot;'>
              <calculation class='tableau' formula='&quot;Existing in DM &gt; Tried LS&quot;' />
            </column>
            <column caption='GBV / Customer' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;DM&quot;'>
              <calculation class='tableau' formula='&quot;DM&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1vttx4m1hwa2sp14t9ppj0p8atv3'>
            <column caption='DM - Total GBV / Customer' datatype='real' name='[Calculation_903816209434984453]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dm_total_gbv])/SUM([dm_cohort_size])' />
            </column>
            <column caption='GBV / Customer' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_903816209436094477]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;Total&quot; AND [Parameters].[Parameter 1] = &quot;Existing in LS &gt; Tried DM&quot; THEN [Calculation_903816209434984453]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;QC&quot; AND [Parameters].[Parameter 1] = &quot;Existing in LS &gt; Tried DM&quot; THEN [DM - LS GBV / Customer (copy)_903816209435426824]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;DM&quot; AND [Parameters].[Parameter 1] = &quot;Existing in LS &gt; Tried DM&quot; THEN [DM - Total GBV / Customer (copy)_903816209435181062]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;LS&quot; AND [Parameters].[Parameter 1] = &quot;Existing in LS &gt; Tried DM&quot; THEN [DM - DM GBV / Customer (copy)_903816209435299847]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Total&quot; AND [Parameters].[Parameter 1] = &quot;Existing in DM &gt; Tried LS&quot; THEN [DM - Total GBV / Customer (copy)_903816209435635721]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;QC&quot; AND [Parameters].[Parameter 1] = &quot;Existing in DM &gt; Tried LS&quot; THEN [DM - QC GBV / Customer (copy)_903816209435635723]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;DM&quot; AND [Parameters].[Parameter 1] = &quot;Existing in DM &gt; Tried LS&quot; THEN [DM - DM GBV / Customer (copy)_903816209435635724]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;LS&quot; AND [Parameters].[Parameter 1] = &quot;Existing in DM &gt; Tried LS&quot; THEN [DM - LS GBV / Customer (copy)_903816209435635722]&#13;&#10;END' />
            </column>
            <column caption='Cohort Size' datatype='integer' name='[Calculation_903816209454714898]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;Existing in DM &gt; Tried LS&quot; THEN [ls_cohort_size]&#13;&#10;    ELSE [dm_cohort_size]&#13;&#10;END' />
            </column>
            <column caption='DM - LS GBV / Customer' datatype='real' name='[DM - DM GBV / Customer (copy)_903816209435299847]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dm_ls_gbv])/SUM([dm_cohort_size])' />
            </column>
            <column caption='LS - DM GBV / Customer' datatype='real' name='[DM - DM GBV / Customer (copy)_903816209435635724]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ls_dm_gbv])/SUM([ls_cohort_size])' />
            </column>
            <column caption='DM - QC GBV / Customer' datatype='real' name='[DM - LS GBV / Customer (copy)_903816209435426824]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([dm_ls_gbv],0)+IFNULL([dm_dm_gbv],0))/SUM([dm_cohort_size])' />
            </column>
            <column caption='LS - LS GBV / Customer' datatype='real' name='[DM - LS GBV / Customer (copy)_903816209435635722]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ls_ls_gbv])/SUM([ls_cohort_size])' />
            </column>
            <column caption='LS - QC GBV / Customer' datatype='real' name='[DM - QC GBV / Customer (copy)_903816209435635723]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([ls_ls_gbv],0)+IFNULL([ls_dm_gbv],0))/SUM([ls_cohort_size])' />
            </column>
            <column caption='DM - DM GBV / Customer' datatype='real' name='[DM - Total GBV / Customer (copy)_903816209435181062]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dm_dm_gbv])/SUM([dm_cohort_size])' />
