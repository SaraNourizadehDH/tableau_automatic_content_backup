      <aliases enabled='yes' />
      <column caption='Histogram_KPI' datatype='integer' name='[Calculation_74590909761396736]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;    WHEN &apos;p_d_dist&apos; THEN COUNTD([rel_chng_p_d_dist])&#13;&#10;    WHEN &apos;mean_delay&apos; THEN COUNTD([rel_chng_mean_delay])&#13;&#10;    WHEN &apos;dps_mean_delay&apos; THEN COUNTD([rel_chng_dps_mean_delay])&#13;&#10;    WHEN &apos;delivery_time&apos; THEN COUNTD([rel_chng_delivery_time])&#13;&#10;END' />
      </column>
      <column caption='Custom_Bins_With_Limits_UNUSED' datatype='string' name='[Custom_Bins_Wout_Limits (copy)_1546986515134345222]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;    WHEN &apos;p_d_dist&apos; THEN &#13;&#10;        IF [rel_chng_p_d_dist_upper_lim] THEN STR([Parameters].[Parameter 3]) + &apos; to &apos; + STR({FIXED: MAX([Histogram_KPI (copy)_1546986515123216384])})&#13;&#10;        ELSEIF [rel_chng_p_d_dist_upper_lim (copy)] THEN STR([Parameters].[group_everything_above (copy)_1546986515131064321]) + &apos; to &apos; + STR({FIXED: MIN([Histogram_KPI (copy)_1546986515123216384])})&#13;&#10;        ELSE STR([Histogram_KPI (copy)_1546986515123216384])&#13;&#10;        END&#13;&#10;    WHEN &apos;mean_delay&apos; THEN&#13;&#10;        IF [rel_chng_mean_delay_upper_lim] THEN STR([Parameters].[Parameter 3]) + &apos; to &apos; + STR({FIXED: MAX([Histogram_KPI (copy)_1546986515123216384])})&#13;&#10;        ELSEIF [rel_chng_mean_delay_upper_lim (copy)] THEN STR([Parameters].[group_everything_above (copy)_1546986515131064321]) + &apos; to &apos; + STR({FIXED: MIN([Histogram_KPI (copy)_1546986515123216384])})&#13;&#10;        ELSE STR([Histogram_KPI (copy)_1546986515123216384])&#13;&#10;        END&#13;&#10;    WHEN &apos;dps_mean_delay&apos; THEN&#13;&#10;        IF [rel_chng_dps_mean_delay_upper_lim] THEN STR([Parameters].[Parameter 3]) + &apos; to &apos; + STR({FIXED: MAX([Histogram_KPI (copy)_1546986515123216384])})&#13;&#10;        ELSEIF [rel_chng_dps_mean_delay_upper_lim (copy)] THEN STR([Parameters].[group_everything_above (copy)_1546986515131064321]) + &apos; to &apos; + STR({FIXED: MIN([Histogram_KPI (copy)_1546986515123216384])})&#13;&#10;        ELSE STR([Histogram_KPI (copy)_1546986515123216384])&#13;&#10;        END&#13;&#10;    WHEN &apos;delivery_time&apos; THEN&#13;&#10;        IF [rel_chng_delivery_time_upper_lim] THEN STR([Parameters].[Parameter 3]) + &apos; to &apos; + STR({FIXED: MAX([Histogram_KPI (copy)_1546986515123216384])})&#13;&#10;        ELSEIF [rel_chng_delivery_time_upper_lim (copy)] THEN STR([Parameters].[group_everything_above (copy)_1546986515131064321]) + &apos; to &apos; + STR({FIXED: MIN([Histogram_KPI (copy)_1546986515123216384])})&#13;&#10;        ELSE STR([Histogram_KPI (copy)_1546986515123216384])&#13;&#10;        END&#13;&#10;END' />
      </column>
      <column caption='Custom_Bins_Wout_Limits' datatype='real' name='[Histogram_KPI (copy)_1546986515123216384]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;    WHEN &apos;p_d_dist&apos; THEN &#13;&#10;        IF [rel_chng_p_d_dist] &gt;= 0 THEN INT([rel_chng_p_d_dist]/[Parameters].[Parameter 1]) * [Parameters].[Parameter 1]&#13;&#10;        ELSE (INT([rel_chng_p_d_dist]/[Parameters].[Parameter 1]) - 1) * [Parameters].[Parameter 1]&#13;&#10;        END&#13;&#10;    WHEN &apos;mean_delay&apos; THEN&#13;&#10;        IF [rel_chng_mean_delay] &gt;= 0 THEN INT([rel_chng_mean_delay]/[Parameters].[Parameter 1]) * [Parameters].[Parameter 1]&#13;&#10;        ELSE (INT([rel_chng_mean_delay]/[Parameters].[Parameter 1]) - 1) * [Parameters].[Parameter 1]&#13;&#10;        END&#13;&#10;    WHEN &apos;dps_mean_delay&apos; THEN&#13;&#10;        IF [rel_chng_dps_mean_delay] &gt;= 0 THEN INT([rel_chng_dps_mean_delay]/[Parameters].[Parameter 1]) * [Parameters].[Parameter 1]&#13;&#10;        ELSE (INT([rel_chng_dps_mean_delay]/[Parameters].[Parameter 1]) - 1) * [Parameters].[Parameter 1]&#13;&#10;        END&#13;&#10;    WHEN &apos;delivery_time&apos; THEN&#13;&#10;        IF [rel_chng_delivery_time] &gt;= 0 THEN INT([rel_chng_delivery_time]/[Parameters].[Parameter 1]) * [Parameters].[Parameter 1]&#13;&#10;        ELSE (INT([rel_chng_delivery_time]/[Parameters].[Parameter 1]) - 1) * [Parameters].[Parameter 1]&#13;&#10;        END&#13;&#10;END' />
      </column>
      <column caption='KPI_for_Ver_Limits_Ref' datatype='real' name='[Histogram_KPI (copy)_1546986515146219529]' role='measure' type='quantitative'>
