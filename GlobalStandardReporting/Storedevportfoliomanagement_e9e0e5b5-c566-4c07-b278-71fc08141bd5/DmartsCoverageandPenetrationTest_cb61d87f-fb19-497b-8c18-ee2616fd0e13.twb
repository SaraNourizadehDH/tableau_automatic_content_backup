            <column caption='Metric 1' datatype='real' name='[Calculation_3756213227509387276]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE  [Parameters].[Parameter 4]&#10;when 1 then Sum([platform_mau])&#10;when 2 then Sum([prospect_mau])&#10;when 3 then sum([od_platform_mau])&#10;when 4 then  Sum([dmart_covered_prospect_mau])*100/Sum([prospect_mau])&#10;when 5 then Sum([prospect_mau])*100/Sum([platform_mau])&#10;WHEN 6 THEN SUM([dmart_mau])&#10;WHEN 7 THEN SUM([dmart_covered_mau])&#10;WHEN 8 THEN SUM([dmart_covered_prospect_mau])&#10;WHEN 9 THEN SUM([dmart_covered_mau])*100/SUM([platform_mau])&#10;WHEN 10 THEN SUM([od_covered_mau])*100/SUM([od_platform_mau])&#10;WHEN 11 THEN SUM([dmart_mau])*100/SUM([dmart_covered_mau])&#10;WHEN 12 THEN SUM([dmart_covered_prospect_mau])*100/SUM([dmart_covered_mau])&#10;&#10;END' />
            </column>
