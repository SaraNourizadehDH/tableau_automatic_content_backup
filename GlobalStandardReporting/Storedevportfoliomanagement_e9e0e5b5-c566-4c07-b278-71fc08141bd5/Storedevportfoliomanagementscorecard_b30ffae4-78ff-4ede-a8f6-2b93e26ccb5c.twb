      <column caption='Overall' datatype='string' name='[Calculation_4248653730729271310]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Score %&quot;' />
      </column>
      <column caption='Score - Monthly rpsm ' datatype='integer' name='[Cost to Serve score (copy)_2172212825360658442]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_2172212825380294678] &lt; 4.35 THEN 5&#10;ELSEIF [Calculation_2172212825380294678] &gt;= 4.36 AND [Calculation_2172212825380294678] &lt; 4.83 THEN 4&#10;ELSEIF [Calculation_2172212825380294678] &gt;= 4.84 AND [Calculation_2172212825380294678] &lt; 5.44 THEN 3&#10;ELSEIF [Calculation_2172212825380294678] &gt;= 5.45 AND [Calculation_2172212825380294678] &lt; 6.16 THEN 2&#10;ELSEIF [Calculation_2172212825380294678] &gt;= 6.17 AND [Calculation_2172212825380294678] &lt; 6.65 THEN 1&#10;ELSE 0&#10;END' />
