      <aliases enabled='yes' />
      <column caption='Score - Covered mau &gt; 40k' datatype='integer' name='[Calculation_2172212825349394438]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_2172212825352208392] &lt; 5 THEN 0&#10;ELSEIF [Calculation_2172212825352208392] &gt;= 5 AND [Calculation_2172212825352208392] &lt; 10 THEN 1&#10;ELSEIF [Calculation_2172212825352208392] &gt;= 10 AND [Calculation_2172212825352208392] &lt; 15 THEN 2&#10;ELSEIF [Calculation_2172212825352208392] &gt;= 15 AND [Calculation_2172212825352208392] &lt; 20 THEN 3&#10;ELSEIF [Calculation_2172212825352208392] &gt;= 20 AND [Calculation_2172212825352208392] &lt; 30 THEN 4&#10;ELSE 5&#10;END' />
      </column>
      <column caption='Stores greater than 40k' datatype='real' name='[Calculation_2172212825352208392]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF [dmart_more_than_40000] = &quot;greater&quot; THEN 1 ELSE 0 END)/COUNTD([warehouse_name]))*100' />
      </column>
      <column caption='Avg picking time per sec' datatype='real' name='[Calculation_2172212825367408654]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([picking_time_per_item_sec])/COUNTD([warehouse_name])' />
      </column>
      <column caption='Avg delivery time' datatype='real' name='[Calculation_2172212825369837588]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([delivery_time_per_order_min])/COUNTD([warehouse_name])' />
      </column>
      <column caption='Avg Cost serve' datatype='real' name='[Calculation_2172212825376489493]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([cost_to_serve])' />
      </column>
      <column caption='Avg (Avg rpsm )' datatype='real' name='[Calculation_2172212825380294678]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([avg_rpsm])/COUNTD([warehouse_name])' />
      </column>
      <column caption=' Share of stores &gt;40K MAU covered' datatype='real' name='[Calculation_2172212825747681306]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2172212825349394438]/([Calculation_2172212825349394438]+[Cost to Serve score (copy)_2172212825368518672]+[Covered mau &gt; 40k score (copy)_2172212825357754377])' />
      </column>
      <column caption=' Delivery time' datatype='real' name='[Calculation_2172212825749065755]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Cost to Serve score (copy)_2172212825368518672]/([Calculation_2172212825349394438]+[Cost to Serve score (copy)_2172212825368518672]+[Covered mau &gt; 40k score (copy)_2172212825357754377])' />
      </column>
      <column caption=' Cost to Serve ((Store Rent+OPEX)/1000 MAU)' datatype='real' name='[Calculation_2172212825749516316]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Covered mau &gt; 40k score (copy)_2172212825357754377]/([Calculation_2172212825349394438]+[Cost to Serve score (copy)_2172212825368518672]+[Covered mau &gt; 40k score (copy)_2172212825357754377])' />
      </column>
      <column caption=' Picking time per unit' datatype='real' name='[Calculation_2172212825751044126]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Cost to Serve score (copy)_2172212825364299789]/([Cost to Serve score (copy)_2172212825364299789]+[Cost to Serve score (copy)_2172212825360658442])' />
      </column>
      <column caption=' Monthly average rent per sqm' datatype='real' name='[Calculation_2172212825766895647]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Cost to Serve score (copy)_2172212825360658442]/([Cost to Serve score (copy)_2172212825360658442]+[Cost to Serve score (copy)_2172212825364299789])' />
      </column>
      <column caption='Avg Dmart Covered Mau' datatype='real' name='[Calculation_2172212825775804448]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [dmart_more_than_40000] = &quot;greater&quot; THEN 1 ELSE 0 END) /COUNTD([warehouse_name])' />
      </column>
      <column caption='Avg SKU density ' datatype='real' name='[Calculation_2172212826392178721]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([SKU_density])/COUNTD([warehouse_name])' />
      </column>
      <column caption=' SKU density %' datatype='real' name='[Calculation_2172212826404347938]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Cost to Serve score (copy)_2172212825363333132]/([Cost to Serve score (copy)_2172212825364299789]+[Cost to Serve score (copy)_2172212825363333132])' />
      </column>
      <column caption='Dmart more than 40000 greater' datatype='integer' name='[Calculation_4248653730720600067]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='If [dmart_more_than_40000] = &quot;greater&quot; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Location Intelligence' datatype='real' name='[Calculation_4248653730725462023]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((33/100)*[Calculation_2172212825747681306])+((33/100)*[Calculation_2172212825749065755])+((33/100)*[Calculation_2172212825749516316])' />
      </column>
      <column caption='portfolio' datatype='real' name='[Calculation_4248653730726035464]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((33/100)*[Calculation_2172212825766895647])' />
      </column>
      <column caption='Store Dev + Automation' datatype='real' name='[Calculation_4248653730726371340]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((33/100)*[Calculation_2172212826404347938])+((33/100)*[Calculation_2172212825751044126])' />
      </column>
      <column caption='Overall score' datatype='real' name='[Calculation_4248653730727108621]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_4248653730725462023]+[Calculation_4248653730726035464]+[Calculation_4248653730726371340]' />
