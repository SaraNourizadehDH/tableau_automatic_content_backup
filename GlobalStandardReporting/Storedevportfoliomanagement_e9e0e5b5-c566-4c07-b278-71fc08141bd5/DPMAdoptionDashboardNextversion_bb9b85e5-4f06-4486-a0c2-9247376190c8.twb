    <worksheet name='Not(30 days) Login History Country'>
      <table>
        <view>
          <datasources>
            <datasource caption='dpm_adoption_CG (dev_dmart)' name='federated.0mqbmg01j9oesu18r67um0eisn7j' />
          </datasources>
          <datasource-dependencies datasource='federated.0mqbmg01j9oesu18r67um0eisn7j'>
            <column caption='not logged in(yes/no)' datatype='string' name='[Calculation_3830030032798658561]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([lastlogindate]) THEN &quot; &quot; ELSE (IF DATEDIFF(&apos;day&apos;, [lastlogindate], TODAY()) &lt;= 30 THEN &quot;Yes&quot; ELSE &quot;No&quot; END) END' />
            </column>
            <column caption='Country name' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
