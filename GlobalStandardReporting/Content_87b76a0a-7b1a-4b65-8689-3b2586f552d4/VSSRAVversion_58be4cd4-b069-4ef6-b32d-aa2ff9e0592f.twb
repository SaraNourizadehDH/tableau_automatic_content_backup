      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_631CF8FD392D44B181C821BE684AD4C9'>
            <properties context=''>
              <relation connection='bigquery.08qh8q51padxtd16lb5vx1s858p2' name='Custom SQL Query' type='text'>SELECT 
global_entity_id
, date day
, week
, FORMAT_DATE(&apos;%Y-%m&apos;, date) month
, FORMAT_DATE(&apos;%Y-Q%Q&apos;, date) quarter
, is_pos
, stream_source
, week_end
, week_start
, change_type
, service
, source
, persona
, vertical_type
, vertical_parent
, brand_name
, management_entity
, country_name
, CURRENT_DATETIME() update_time
, total_count
, ss_count
, ss_nonportal_count
, ss_portal_count
, nonss_count
, nonss_backoffice_count
, nonss_other_count
, null_count
FROM (
    SELECT 
    &apos;Include POS&apos; is_pos
    , * 
    FROM fulfillment-dwh-production.cl_vendor.vp_vssr_product_daily_rl
    --FROM dhh-ncr-stg.dbt_sales_revenue_local.vp_vssr_product_daily_rl

    UNION ALL 
   
    SELECT 
    &apos;Exclude POS &amp; Untagged&apos; is_pos
    , * 
    FROM fulfillment-dwh-production.cl_vendor.vp_vssr_product_daily_rl_exclude_pos
    --FROM dhh-ncr-stg.dbt_sales_revenue_local.vp_vssr_product_daily_rl_exclude_pos
) agg</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
