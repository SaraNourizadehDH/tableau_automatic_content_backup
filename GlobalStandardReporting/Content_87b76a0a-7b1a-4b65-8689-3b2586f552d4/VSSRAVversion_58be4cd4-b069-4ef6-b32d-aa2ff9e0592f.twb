      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_9474A602BFFF42F3831F5D998503C50D'>
            <properties context=''>
              <relation connection='bigquery.0tlqo8v0dfizzg11v2df30es5up3' name='Custom SQL Query' type='text'>WITH mapping AS (
SELECT 
mapped_type_of_change
, master_type_of_change 
FROM fulfillment-dwh-production.cl_sales_revenue.mss_change_type_mapping
)

SELECT 
agg.*
,mapping.master_type_of_change
,CURRENT_DATETIME() update_time
FROM (
    SELECT 
    &apos;Include POS&apos; is_pos
    , *
   FROM fulfillment-dwh-production.cl_vendor.vp_vssr_product_weekly_rl
   --FROM dhh-ncr-stg.dbt_sales_revenue_local.vp_vssr_product_weekly_rl
    
    UNION ALL 

    SELECT 
    &apos;Exclude POS &amp; Untagged&apos; is_pos
    , *
    FROM fulfillment-dwh-production.cl_vendor.vp_vssr_product_weekly_rl_exclude_pos
    --FROM dhh-ncr-stg.dbt_sales_revenue_local.vp_vssr_product_weekly_rl_exclude_pos
) agg
LEFT JOIN mapping
ON mapping.mapped_type_of_change = agg.changetype</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
