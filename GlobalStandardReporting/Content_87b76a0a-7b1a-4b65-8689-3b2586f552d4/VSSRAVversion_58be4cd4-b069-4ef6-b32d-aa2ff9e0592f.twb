    <datasource caption='vp_vssr_product_weekly_rl' inline='true' name='federated.08gk1fq1jwdyki18bukdu05qkoun' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0tlqo8v0dfizzg11v2df30es5up3'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhh-ncr-live' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='rl_sales_revenue' server-oauth='' username='dilys.ong@foodpanda.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0tlqo8v0dfizzg11v2df30es5up3' name='Custom SQL Query' type='text'>WITH mapping AS (
SELECT 
mapped_type_of_change
, master_type_of_change 
FROM fulfillment-dwh-production.cl_sales_revenue.mss_change_type_mapping
)

SELECT 
agg.*
,mapping.master_type_of_change
,CURRENT_DATETIME() update_time
FROM (
    SELECT 
    &apos;Include POS&apos; is_pos
    , *
   FROM fulfillment-dwh-production.cl_vendor.vp_vssr_product_weekly_rl
   --FROM dhh-ncr-stg.dbt_sales_revenue_local.vp_vssr_product_weekly_rl
    
    UNION ALL 

    SELECT 
    &apos;Exclude POS &amp; Untagged&apos; is_pos
    , *
    FROM fulfillment-dwh-production.cl_vendor.vp_vssr_product_weekly_rl_exclude_pos
    --FROM dhh-ncr-stg.dbt_sales_revenue_local.vp_vssr_product_weekly_rl_exclude_pos
) agg
LEFT JOIN mapping
ON mapping.mapped_type_of_change = agg.changetype</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0tlqo8v0dfizzg11v2df30es5up3' name='Custom SQL Query' type='text'>WITH mapping AS (
SELECT 
mapped_type_of_change
, master_type_of_change 
FROM fulfillment-dwh-production.cl_sales_revenue.mss_change_type_mapping
)

SELECT 
agg.*
,mapping.master_type_of_change
,CURRENT_DATETIME() update_time
FROM (
    SELECT 
    &apos;Include POS&apos; is_pos
    , *
   FROM fulfillment-dwh-production.cl_vendor.vp_vssr_product_weekly_rl
   --FROM dhh-ncr-stg.dbt_sales_revenue_local.vp_vssr_product_weekly_rl
    
    UNION ALL 

    SELECT 
    &apos;Exclude POS &amp; Untagged&apos; is_pos
    , *
    FROM fulfillment-dwh-production.cl_vendor.vp_vssr_product_weekly_rl_exclude_pos
    --FROM dhh-ncr-stg.dbt_sales_revenue_local.vp_vssr_product_weekly_rl_exclude_pos
) agg
LEFT JOIN mapping
ON mapping.mapped_type_of_change = agg.changetype</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
