            <run bold='true' fontsize='12'>Summary</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location id='VSSR-ProductsSummary' path='/t/GlobalStandardReporting/workbooks/VG-VendorSelfService' revision='' site='GlobalStandardReporting' />
      <table>
        <view>
          <datasources>
            <datasource caption='vp_vssr_product_weekly_rl' name='federated.08gk1fq1jwdyki18bukdu05qkoun' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Entity Granularity' datatype='string' name='[Period Granularity (copy)_1896226601799151619]' param-domain-type='list' role='measure' type='nominal' value='&quot;Brand&quot;'>
              <calculation class='tableau' formula='&quot;Brand&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.08gk1fq1jwdyki18bukdu05qkoun'>
            <column caption='%  Untagged Vendors' datatype='real' name='[% Non-SS (Backoffice) Changes (copy)_1838313077441658896]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([nullonly_vendors])/SUM([vendors])' />
            </column>
            <column caption='% SS (Vendor Client) Changes' datatype='real' name='[% Non-SS Changes (copy)_1838313076482301962]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ss_nonportal_count])/SUM([total_count])' />
            </column>
            <column caption='% Both SS &amp; Non-SS Vendors' datatype='real' name='[% Non-SS Only Vendors (copy)_1838313077443518483]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([both_tagged_vendors])/SUM([vendors])' />
            </column>
            <column caption='% SS Only Vendors' datatype='real' name='[% Null Vendors (copy)_1838313077443260433]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ssonly_tagged_vendors])/SUM([vendors])' />
            </column>
            <column caption='% SS (Vendor Portal) Changes' datatype='real' name='[% SS (Vendor Client) Changes (copy)_1838313076482560011]' role='measure' type='quantitative'>
