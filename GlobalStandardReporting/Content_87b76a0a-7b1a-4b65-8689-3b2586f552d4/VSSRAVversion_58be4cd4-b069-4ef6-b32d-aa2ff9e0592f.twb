                <zone fixed-size='187' forceUpdate='true' h='6094' id='17' is-fixed='true' type-v2='text' w='93750' x='3125' y='3854'>
                  <formatted-text>
                    <run fontcolor='#da1320' fontname='Tableau Bold' fontsize='22'>Vendor Self Service Ratio (Products)</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#000000'>Notes:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>1. SS = Self Service</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>2.Source Table: fulfillment-dwh-production.cl_sales_revenue.vssr_product_stream</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>3. SS / Non-SS Tagging is based on the service tagged for event</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>     - </run>
                    <run bold='true' fontcolor='#000000'>SS </run>
                    <run fontcolor='#000000'>&gt; (&apos;VENDOR_CLIENT&apos;,&apos;VENDOR_PORTAL&apos;); </run>
                    <run bold='true' fontcolor='#000000'>Non-SS</run>
                    <run fontcolor='#000000'> &gt; (&apos;BACK_OFFICE&apos;, &apos;OTHER&apos;); </run>
                    <run bold='true' fontcolor='#000000'>Untagged </run>
                    <run fontcolor='#000000'>&gt; (NULL)</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>4. Week starts on Monday</run>
                  </formatted-text>
