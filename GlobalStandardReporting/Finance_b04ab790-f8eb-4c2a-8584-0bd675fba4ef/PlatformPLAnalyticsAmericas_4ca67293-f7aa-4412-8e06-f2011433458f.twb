                  <add-in add-in-id='com.graphomate.matrix' extension-url='https://api.graphomate.com/tableau/matrix/shop/' extension-version='v2021.2.0' instance-id='2961CAAA180B43798665CCEFDD09F95D'>
                    <instance-settings>
                      <setting key='cflRules' value='[{&quot;enabled&quot;:true,&quot;name&quot;:&quot;delete overall&quot;,&quot;script&quot;:&quot;if (cell.getDataRowIndex() === 0) {\n   cell.appendStyle(\&quot;root\&quot;, {\n       display: \&quot;none\&quot;\n   })\n}&quot;},{&quot;enabled&quot;:true,&quot;name&quot;:&quot;data lines coloring&quot;,&quot;script&quot;:&quot;// Crear una lista global para almacenar las filas objetivo\nif (!window.targetRows) {\n  window.targetRows = [];\n}\n\n// Identificar las lineas que queremos pintar\nvar lines = [&apos;Gross profit&apos;,&apos;Adjusted EBITDA incl. Group Cost&apos;,\&quot;Adjusted EBITDA\&quot;,&apos;Profit &amp; loss attributable to shareholders&apos;];\n\nif (cell.getCellType() === &apos;HEADER&apos; &amp;&amp; cell.getHeaderAxis() === &apos;ROWS&apos;) {\n  if (lines.includes(cell.getText())) {\n    var text = cell.getText();\n    var linePosition = lines.indexOf(text);\n    var rowIndex = cell.getDataRowIndex();\n    if (window.targetRows.length &lt; 3) {\n      window.targetRows.push(rowIndex)\n    } else {\n      window.targetRows[linePosition] = rowIndex\n    }\n  }\n};\n\nif (window.targetRows.includes(cell.getDataRowIndex()) &amp;&amp; cell.getDataRowHierarchyLevel() === 1) {  \n  cell.appendStyle(&apos;root&apos;, { backgroundColor: &apos;#bbdefb&apos; });  \n}&quot;},{&quot;enabled&quot;:true,&quot;name&quot;:&quot;hierarchy (manual)&quot;,&quot;script&quot;:&quot;\nconst linesToHide = [\&quot;Gross profit\&quot;,\&quot;Group cost\&quot;,\&quot;Adjusted EBITDA incl. Group Cost\&quot;,\&quot;Depreciation &amp; amortization\&quot;,\&quot;Normalization\&quot;,\&quot;Net interest result\&quot;,\&quot;Other financial result\&quot;,\&quot;Other income and expenses\&quot;,\&quot;Income tax\&quot;,\&quot;Profit &amp; loss attributable to shareholders\&quot;,\&quot;General cost\&quot;,\&quot;Tech\&quot;,\&quot;Product\&quot;,\&quot;Marketing\&quot;,\&quot;Kitchen\&quot;,\&quot;Cost of sales general\&quot;,\&quot;Adjusted EBITDA\&quot;]\n\nif (cell.getCellType() === &apos;HEADER&apos; &amp;&amp; cell.getHeaderAxis() === &apos;ROWS&apos; &amp;&amp; linesToHide.includes(cell.getText())) {\n\n  if (cell.isResultCell()) {\n    // alter cursor style to be a pointer\n    cell.appendStyle(&apos;root&apos;, {\n      cursor: &apos;&apos;,\n      paddingTop: &apos;3px&apos;,\n    });\n    cell.setIndicatorSign(&apos;&apos;);\n  }\n}\n&quot;}]' />
