          <relation connection='bigquery.0mh8gbf1htmn1x179ydt50gkidoj' name='Custom SQL Query' type='text'><![CDATA[--- ACUTAL: source rl_sap_pnl_america
SELECT
  posting_month,
  posting_date,
  company_code,
  dim_country.country_name,
  dim_country.region,
  vertical,
  accounting_account, 
  --document
  is_hyperinflation,
  -- document_number,
  -- reference_document_number,
  -- document_type,
  -- item_text,
  --functional_area
  functional_area,
  --cost_center
  cost_center_id,
  SUBSTR(cost_center_id,6,4) AS ceco_key,
  dim_cost_center.user_responsible_name,
  dim_cost_center.cost_center_category,
  dim_cost_center.cost_center_name,
  dim_cost_center.area,
  dim_cost_center.sub_area,
  dim_cost_center.sector,
  dim_cost_center.sub_sector,
  --apolo
  dim_accounting_account.apolo_category,
  dim_accounting_account.apolo_sub_category,
  --onestream
  dim_onestream.os_account,
  dim_onestream.os_account_description,
  dim_onestream.IC,
  dim_onestream.ud1,
  dim_onestream.cUD3,
  dim_onestream.cUD4,
  dim_onestream.cUD5,
  --vendor
  -- vendor_id,
  -- dim_vendor.vendor_name,
  --hierarchy_pnl
  CASE
    WHEN dim_onestream.local_hier_acc_pnl_pf.Level_3_DESC = "Gross profit" THEN dim_onestream.local_hier_acc_pnl_pf.Level_4_DESC 
    WHEN dim_onestream.local_hier_acc_pnl_pf.Level_3_DESC IN ("Other income","Other expenses") THEN "Other income and expenses"
    ELSE dim_onestream.local_hier_acc_pnl_pf.Level_3_DESC 
  END Level_1,
  CASE 
    WHEN dim_onestream.local_hier_acc_pnl_pf.Level_4_DESC = "Revenue" THEN dim_onestream.local_hier_acc_pnl_pf.Level_7_DESC
    WHEN dim_onestream.local_hier_acc_pnl_pf.Level_4_DESC = "Cost of sales" THEN dim_onestream.local_hier_acc_pnl_pf.Level_5_DESC
    WHEN dim_onestream.local_hier_acc_pnl_pf.Level_3_DESC = dim_onestream.local_hier_acc_pnl_pf.Level_4_DESC THEN ""
    ELSE dim_onestream.local_hier_acc_pnl_pf.Level_4_DESC 
  END AS Level_2,
  CASE 
    WHEN dim_onestream.local_hier_acc_pnl_pf.Level_4_DESC = "Revenue" THEN dim_onestream.local_hier_acc_pnl_pf.Level_8_DESC
    WHEN dim_onestream.local_hier_acc_pnl_pf.Level_4_DESC = "Cost of sales" THEN dim_onestream.local_hier_acc_pnl_pf.Level_6_DESC
    WHEN dim_onestream.local_hier_acc_pnl_pf.Level_4_DESC = "Sales activities" THEN  dim_onestream.local_hier_acc_pnl_pf.Level_5_DESC
    WHEN dim_onestream.local_hier_acc_pnl_pf.Level_3_DESC IN ("Support, general & administrative") THEN  dim_onestream.local_hier_acc_pnl_pf.Level_6_DESC
    ELSE "" 
  END AS Level_3,
  SUM(value_lc) AS value_lc,
  SUM(value_eur) AS value_eur
FROM `fulfillment-dwh-production.rl_fsa.rl_sap_pnl_america`
WHERE posting_month >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE(),MONTH), INTERVAL 3 MONTH)
AND value_lc <<>> 0
GROUP BY ALL]]></relation>
          <relation connection='bigquery.0mh8gbf1htmn1x179ydt50gkidoj' name='Custom SQL Query1' type='text'>SELECT*&#13;
FROM fulfillment-dwh-production.acl_fsa.v_sol_auth_entity&#13;
WHERE solution = &quot;S0204 - LATAM - Platforms P&amp;L&quot;</relation>
