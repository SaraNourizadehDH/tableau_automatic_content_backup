      <aliases enabled='yes' />
      <column caption='is_scenario_filter' datatype='string' name='[Calculation_1244682395227734016]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1994531733077852161] AND [scenario] = &quot;ACTUAL&quot; THEN &quot;TRUE&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 1] = [scenario] AND [Calculation_1994531733077852161] = FALSE THEN &quot;TRUE&quot;&#13;&#10;END' />
      </column>
      <column caption='User Entitlements' datatype='boolean' name='[Calculation_1915718728379240448]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[User_Email] = USERNAME()' />
      </column>
      <column caption='is_actual' datatype='boolean' name='[Calculation_1994531733077852161]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [month_date] &lt;= {FIXED: MAX(IF [scenario] = &apos;ACTUAL&apos; THEN [month_date] ELSE NULL END)}&#13;&#10;    THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Forecast Scenario' datatype='string' name='[Calculation_2211548925685235712]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF LEFT([scenario], 2) = &quot;BE&quot; OR [scenario] = &quot;BUDGET2025AI&quot; THEN [scenario] END' />
      </column>
      <column caption='Period_filter' datatype='string' name='[Calculation_2211548925686550529]' role='dimension' type='nominal'>
