              <calculation class='tableau' formula='{ FIXED : MAX(IF year = [Parameters].[Parameter 9] &#13;&#10;AND [Scenario] != &quot;ACTUAL&quot;&#13;&#10;AND NOT CONTAINS([Scenario], &quot;_APY&quot;)&#13;&#10;AND NOT CONTAINS([Scenario], &quot;_BCY&quot;)&#13;&#10;AND NOT CONTAINS([Scenario], &quot;_FCY&quot;)&#13;&#10;AND NOT CONTAINS([Scenario], &quot;ACTUAL&quot;)&#13;&#10;AND CONTAINS([Scenario], &quot;AI&quot;)&#13;&#10;THEN [Scenario]&#13;&#10; END )}' />
