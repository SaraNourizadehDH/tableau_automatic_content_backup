              <calculation class='tableau' formula='IF year = [Parameters].[Parameter 9] &#13;&#10;AND [Scenario] != &quot;ACTUAL&quot;&#13;&#10;AND NOT CONTAINS([Scenario], &quot;_APY&quot;)&#13;&#10;AND NOT CONTAINS([Scenario], &quot;_BCY&quot;)&#13;&#10;AND NOT CONTAINS([Scenario], &quot;_FCY&quot;)&#13;&#10;AND CONTAINS([Scenario], &quot;BUDGET&quot;)&#13;&#10;THEN [Scenario]&#13;&#10;ELSE  &quot;ACTUAL_&quot; + STR([Parameters].[Parameter 9] - 1)&#13;&#10;&#13;&#10; END' />
