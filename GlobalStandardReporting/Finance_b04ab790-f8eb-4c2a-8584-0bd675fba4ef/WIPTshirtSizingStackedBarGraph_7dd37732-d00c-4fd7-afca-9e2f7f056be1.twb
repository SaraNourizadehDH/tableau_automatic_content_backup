      <column caption='Actual / Plan' datatype='string' name='[Calculation_1266355951785172993]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Pivot Field Names] = &quot;Actual Effort External SolDesign (hrs)&quot; OR [Pivot Field Names] = &quot;Actual Effort External Dev (hrs)&quot; OR  [Pivot Field Names] = &quot;Actual Effort External Testing (hrs)&quot; THEN &quot;Actual Effort&quot;&#13;&#10;ELSEIF [Pivot Field Names] = &quot;Planned Effort External SolDesign (hrs)&quot; OR [Pivot Field Names] = &quot;Planned Effort External Dev (hrs)&quot; OR  [Pivot Field Names] = &quot;Planned Effort External Testing (hrs)&quot; THEN &quot;Planned Effort&quot;&#13;&#10;END' />
