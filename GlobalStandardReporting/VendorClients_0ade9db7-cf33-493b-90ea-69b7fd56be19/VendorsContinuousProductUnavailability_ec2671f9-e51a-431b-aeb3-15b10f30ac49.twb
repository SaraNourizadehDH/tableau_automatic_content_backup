          <style-rule element='gridline'>
            <format attr='stroke-size' scope='rows' value='0' />
            <format attr='line-visibility' scope='rows' value='off' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Shape' />
            <encodings>
              <lod column='[federated.05kgc8d14xgoz21903tdd0gtat7i].[sum:Number of Records:qk]' />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run>After an order failed with the  reason Item Unavailable, there could be </run>
                <run underline='true'>4 possibilities afterward</run>
                <run>:

1, The next order from the same Vendor with the same product is </run>
                <run bold='true'>completed  successfully</run>
                <run>;
2, The next order from the same Vendor with the same product </run>
                <run bold='true'>also fails, again with the reason Item Unavailable</run>
                <run>; 
3, The next order from the same Vendor with the same product </run>
                <run bold='true'>also fails, but with different cancellation reason</run>
                <run>; &#10;4, There is </run>
                <run bold='true'>no new order</run>
                <run> from the same Vendor with the same product afterward. 

P.S. Only Item Unavailability by Vendor orders  having orders within </run>
                <run bold='true'>the next 7 days</run>
                <run> (EXCLUDING the same day) are taken into consideration. Due to the same reason, orders with less than full 7 days data will not be shown in the chart.
</run>
              </formatted-text>
            </customized-tooltip>
            <style>
              <style-rule element='mark'>
                <format attr='shape' value='Icons/information_icon.png' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
      <simple-id uuid='{2B1B6A88-64E1-4BDC-95A0-9B52ED000050}' />
