    <worksheet name='_Next Order (in N7D) after a Vendor Item Unavailable Fail Order - %'>
      <table>
        <view>
          <datasources>
            <datasource caption='rps_gsr_continuous_product_unavailability (rl)' name='federated.05kgc8d14xgoz21903tdd0gtat7i' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Show Percentage or Absolute Number - Next Day' datatype='string' name='[Show Percentage or Absolute Number (copy)_432415939074961414]' param-domain-type='list' role='measure' type='nominal' value='&quot;Percent&quot;'>
              <calculation class='tableau' formula='&quot;Percent&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.05kgc8d14xgoz21903tdd0gtat7i'>
            <column caption='# Total Fail Orders (Item Unavailable) by Vendor' datatype='integer' name='[# Total Orders next day (copy)_432415939136532488]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[orders_having_completed_order_afterward_ct]&#10;+ [orders_having_fail_order_item_unavailable_by_vendor_afterward_ct]&#10;+ [orders_having_fail_order_not_item_unavailable_by_vendor_afterward_ct]&#10;+ [orders_having_no_order_afterward_ct]' />
            </column>
            <column caption='% Orders having no order next day' datatype='real' name='[% Orders having completed order next day (copy)_432415939067478018]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_having_no_order_in_next_1_day_ct])/SUM([Calculation_432415939066638336])' />
            </column>
            <column caption='% Orders having fail order (Non Item Unavailable) next day' datatype='real' name='[% Orders having fail order (Item Unavailable) next day (copy)_432415939067670532]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_having_fail_order_not_item_unavailable_by_vendor_in_next_1_day_ct])/SUM([Calculation_432415939066638336])' />
            </column>
            <column caption='% Orders having fail order (Item Unavailable) next day' datatype='real' name='[% Orders having no order next day (copy)_432415939067588611]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_having_fail_order_item_unavailable_by_vendor_in_next_1_day_ct])/SUM([Calculation_432415939066638336])' />
            </column>
            <column caption='date' datatype='string' name='[Calculation_3263280146152939522]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([created_date])' />
            </column>
            <column caption='# Total Orders next day' datatype='integer' name='[Calculation_432415939066638336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[orders_having_completed_order_in_next_1_day_ct]&#10;+ [orders_having_fail_order_item_unavailable_by_vendor_in_next_1_day_ct]&#10;+ [orders_having_fail_order_not_item_unavailable_by_vendor_in_next_1_day_ct]&#10;+ [orders_having_no_order_in_next_1_day_ct]' />
            </column>
            <column caption='% Orders having completed order next day' datatype='real' name='[Calculation_432415939067371521]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_having_completed_order_in_next_1_day_ct])/SUM([Calculation_432415939066638336])' />
            </column>
            <column caption='% Orders having completed order afterward' datatype='real' name='[Calculation_432415939136872457]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_having_completed_order_afterward_ct])/SUM([# Total Orders next day (copy)_432415939136532488])' />
