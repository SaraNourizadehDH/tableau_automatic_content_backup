        <calculation class='tableau' formula='CASE [Parameters].[created_date Parameter]&#10;    WHEN &apos;Daily&apos;&#10;        THEN [Calculation_3263280146152939522]&#10;    WHEN &apos;Hourly&apos;&#10;        THEN [created_hour]&#10;END' />
