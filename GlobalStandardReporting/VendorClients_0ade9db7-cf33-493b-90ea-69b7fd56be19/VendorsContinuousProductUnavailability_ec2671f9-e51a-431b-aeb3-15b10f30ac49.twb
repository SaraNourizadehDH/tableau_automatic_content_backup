            <column>[federated.05kgc8d14xgoz21903tdd0gtat7i].[none:is_preorder:nk]</column>
            <column>[federated.05kgc8d14xgoz21903tdd0gtat7i].[none:client_name:nk]</column>
            <column>[federated.05kgc8d14xgoz21903tdd0gtat7i].[none:client_version:nk]</column>
            <column>[federated.05kgc8d14xgoz21903tdd0gtat7i].[none:fixed_is_dormant_vendor:nk]</column>
