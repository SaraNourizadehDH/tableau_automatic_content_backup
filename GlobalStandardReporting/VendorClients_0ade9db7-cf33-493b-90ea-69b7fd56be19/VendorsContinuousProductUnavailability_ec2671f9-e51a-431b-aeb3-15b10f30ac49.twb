      <column caption='% Next Fail Order (Item Unavailable) with the same product (Same day)' datatype='real' name='[Calculation_3263280146154225669]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fail_next_order_in_same_day_ct])/SUM([fail_orders_ct])' />
