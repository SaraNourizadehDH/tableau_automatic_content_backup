      <aliases enabled='yes' />
      <column caption='# Total Fail Orders (Item Unavailable) by Vendor' datatype='integer' name='[# Total Orders next day (copy)_432415939136532488]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[orders_having_completed_order_afterward_ct]&#10;+ [orders_having_fail_order_item_unavailable_by_vendor_afterward_ct]&#10;+ [orders_having_fail_order_not_item_unavailable_by_vendor_afterward_ct]&#10;+ [orders_having_no_order_afterward_ct]' />
      </column>
      <column caption='% Next Fail Order (Item Unavailable) with the same product (15 - 30 min)' datatype='real' default-format='p0.0%' name='[% Next Fail Order (Item Unavailable) with the same product (1 - 15 min) (copy)_79516684878401542]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fail_next_order_in_30_min_ct])/SUM([fail_next_order_ct])' />
      </column>
      <column caption='% Next Fail Order (Item Unavailable) with the same product (30 - 60 min)' datatype='real' name='[% Next Fail Order (Item Unavailable) with the same product (15 - 30 min) (copy)_79516684878561287]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fail_next_order_in_60_min_ct])/SUM([fail_next_order_ct])' />
      </column>
      <column caption='% Next Fail Order (Item Unavailable) with the same product (&gt;= 60 min same day)' datatype='real' name='[% Next Fail Order (Item Unavailable) with the same product (30 - 60 min) (copy)_79516684878811144]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fail_next_order_over_60_min_same_day_ct])/SUM([fail_next_order_ct])' />
      </column>
      <column caption='% Next Fail Order (Item Unavailable) with the same product (After next 1 day)' datatype='real' name='[% Next Fail Order (Item Unavailable) with the same product (30 - 60 min) (copy)_79516684878999561]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fail_next_order_after_x_day_ct])/SUM([fail_next_order_ct])' />
      </column>
      <column caption='% Next Fail Order (Item Unavailable) with the same product (Next day)' datatype='real' name='[% Next Fail Order (Item Unavailable) with the same product (Next day) (copy)_79516684884054028]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fail_next_order_in_next_1_day_ct])/SUM([fail_orders_ct])' />
      </column>
      <column caption='% Next Fail Order (Item Unavailable) with the same product (1 - 15 min)' datatype='real' name='[% Next Fail Order (Item Unavailable) with the same product (within 1 min) (copy)_79516684878020613]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fail_next_order_in_15_min_ct])/SUM([fail_next_order_ct])' />
      </column>
      <column caption='% Next Fail Order (Item Unavailable) with the same product (Next day) (table)' datatype='real' name='[% Next Fail Order(Item Unavailable) with the same product (same day) (copy)_79516684607770624]' role='measure' type='quantitative'>
