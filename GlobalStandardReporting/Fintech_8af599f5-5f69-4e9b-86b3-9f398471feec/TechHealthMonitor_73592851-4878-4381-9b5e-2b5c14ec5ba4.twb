        </calculation>
      </column>
      <column caption='TF - month' datatype='boolean' name='[Calculation_1514757605826330680]' role='measure' type='nominal'>
        <calculation class='tableau' formula='INDEX() = (IF min([Calculation_828451244470579221])=[Calculation_3775072039616880650] THEN INDEX() END)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Duration over incidents' datatype='real' name='[Calculation_1514757605829713985]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_1514757605822210097])/count([__tableau_internal_object_id__].[scorecard_indicent_3F94F39E38C94AB8B82067773B8C09DB])' />
      </column>
      <column caption='timeframe_selector_month' datatype='string' name='[Calculation_3775072039616880650]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &apos;Week&apos; then (IF DATEPART(&apos;week&apos;,[Parameters].[Month selector  (copy)_1514757605723406344])&gt;10 THEN &quot;W&quot; + DATENAME(&apos;iso-week&apos;,[Parameters].[Month selector  (copy)_1514757605723406344]) + &quot; &quot; + DATENAME(&apos;year&apos;,[Parameters].[Month selector  (copy)_1514757605723406344]) ELSE &quot;W&quot; +&quot;0&quot;+ DATENAME(&apos;iso-week&apos;,[Parameters].[Month selector  (copy)_1514757605723406344]) + &quot; &quot; + DATENAME(&apos;year&apos;,[Parameters].[Month selector  (copy)_1514757605723406344]) END )&#10;    WHEN &apos;Month&apos; then LEFT(DATENAME(&apos;month&apos;,[Parameters].[Month selector  (copy)_1514757605723406344]),3) + &quot; &quot; + DATENAME(&apos;year&apos;,[Parameters].[Month selector  (copy)_1514757605723406344])&#10;    WHEN &apos;Quarter&apos; then &quot;Q&quot; + DATENAME(&apos;quarter&apos;,[Parameters].[Month selector  (copy)_1514757605723406344]) + &quot; &quot; + DATENAME(&apos;year&apos;,[Parameters].[Month selector  (copy)_1514757605723406344])&#10;    WHEN &apos;Year&apos; then &quot;Y&quot; + DATENAME(&apos;year&apos;,[Parameters].[Month selector  (copy)_1514757605723406344])      &#10;END' />
      </column>
      <column caption='lost orders highlight' datatype='integer' name='[Calculation_3775072039618719755]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Calculation_1514757605826330680],sum([LostOrders]),Null)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='variation over string' datatype='string' name='[Calculation_3775072039621668879]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if &#10;[Parameters].[Parameter 2] = &apos;Month&apos; then &apos;MoM&apos;&#10;elseif&#10;[Parameters].[Parameter 2] = &apos;Week&apos; then &apos;WoW&apos;&#10;elseif&#10;[Parameters].[Parameter 2] = &apos;Quarter&apos; then &apos;QoQ&apos;&#10;elseif&#10;[Parameters].[Parameter 2] = &apos;Year&apos; then &apos;YoY&apos;&#10;end' />
      </column>
      <column caption='date min' datatype='datetime' name='[Calculation_3775072039628800016]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;Month&apos; THEN&#10;DATETRUNC(&apos;month&apos;,[StartDatetime])&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Week&apos; THEN &#10;DATETRUNC(&apos;iso-week&apos;,[StartDatetime])&#10;END' />
      </column>
      <column caption='total orders (copy)' datatype='integer' name='[Calculation_4268427284513689601]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([federated.09i16fv0xxd6os1940vnm1bzwokl].[order_qty])' />
      </column>
      <column caption='is_period_filtered' datatype='boolean' name='[Calculation_4483826016802291714]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 9] &lt;= DATE([StartDatetime])&#10;AND&#10;[Parameters].[Start Date - incidents (copy)_4483826016802000896] &gt;= DATE([StartDatetime])' />
      </column>
      <column caption='Lost Orders - filtered period' datatype='integer' name='[Calculation_4483826016802721795]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Calculation_4483826016802291714],[LostOrders],Null)' />
      </column>
      <column caption='Incident Count - filtered period' datatype='integer' name='[Calculation_4483826016805797894]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Calculation_4483826016802291714],1,Null)' />
      </column>
      <column caption='MTTR (min) - filtered period' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_4483826016810680330]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Duration (copy 2)_4483826016809971720])/SUM([Calculation_4483826016805797894])' />
      </column>
      <column caption='Mitigation detection - filtered period' datatype='integer' name='[Calculation_4483826016813117452]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Calculation_4483826016802291714],[MTTD (min) calculated (copy)_4483826016812838923],Null)' />
      </column>
      <column caption='End date - last Sunday' datatype='date' name='[Calculation_4483826016840953871]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;, TODAY(), &apos;Sunday&apos;))' />
      </column>
      <column caption='Component group' datatype='string' name='[Calculation_4483826017124270099]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF STARTSWITH([Component],&apos;Alfred&apos;) THEN &apos;Alfred&apos;&#10;ELSEIF  STARTSWITH([Component],&apos;Third&apos;) THEN &apos;Third Party&apos;&#10;ELSE &apos;Other&apos;&#10;END' />
      </column>
      <column caption='Is duration valid' datatype='boolean' name='[Calculation_5912030049670115328]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[StartDatetime]&lt;=[EndDatetime]&#10;AND [DetectionDatetime]&lt;=[EndDatetime]&#10;AND [StartDatetime]&lt;=[DetectionDatetime]' />
      </column>
      <column caption='incidents' datatype='integer' name='[Calculation_828451244466069519]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([__tableau_internal_object_id__].[scorecard_indicent_3F94F39E38C94AB8B82067773B8C09DB])' />
      </column>
      <column caption='timeframe_selector_date' datatype='date' datatype-customized='true' name='[Calculation_828451244470394900]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 2]&#10;    WHEN &apos;Week&apos; then DATETRUNC(&apos;iso-week&apos;,[StartDatetime])&#10;    WHEN &apos;Month&apos; then DATETRUNC(&apos;month&apos;,[StartDatetime])&#10;    WHEN &apos;Quarter&apos; then DATETRUNC(&apos;quarter&apos;,[StartDatetime])&#10;    WHEN &apos;Year&apos; Then DATETRUNC(&apos;year&apos;, [StartDatetime])&#10;END)' />
      </column>
      <column caption='timeframe_selector' datatype='string' name='[Calculation_828451244470579221]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &apos;Week&apos; then &quot;W&quot; + DATENAME(&apos;iso-week&apos;,[StartDatetime]) + &quot; &quot; + DATENAME(&apos;year&apos;,[StartDatetime])&#10;    WHEN &apos;Month&apos; then LEFT(DATENAME(&apos;month&apos;,[StartDatetime]),3) + &quot; &quot; + DATENAME(&apos;year&apos;,[StartDatetime])&#10;    WHEN &apos;Quarter&apos; then &quot;Q&quot; + DATENAME(&apos;quarter&apos;,[StartDatetime]) + &quot; &quot; + DATENAME(&apos;year&apos;,[StartDatetime])&#10;    WHEN &apos;Year&apos; then &quot;Y&quot; + DATENAME(&apos;year&apos;,[StartDatetime])        &#10;END' />
