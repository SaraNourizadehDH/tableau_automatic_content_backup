      <aliases enabled='yes' />
      <column caption='Calculation1' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_2821997810574893056]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [timeframe]&#10;WHEN &apos;Week&apos; THEN &quot;Week &quot; + DATENAME(&apos;iso-week&apos;,[first_date_timeframe]) &#10;WHEN &apos;Month&apos; THEN DATENAME(&apos;month&apos;,[first_date_timeframe])&#10;WHEN &apos;quarter&apos; THEN &quot;Q&quot; + DATENAME(&apos;quarter&apos;,[first_date_timeframe]) &#10;END' />
      </column>
      <column caption='max date' datatype='date' name='[Calculation_3366862950697488385]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='max([first_date_timeframe])' />
      </column>
      <column caption='GMV %' datatype='real' name='[Calculation_353602982872539136]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if sum([alfred_gmv_eur])/sum([gmv_eur])&gt;1 then 1 &#10;else sum([alfred_gmv_eur])/sum([gmv_eur])&#10;end' />
      </column>
      <column caption='order %' datatype='real' name='[Calculation_353602982872621057]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if sum([alfred_order_qty])/sum([order_qty]) &gt;1 then 1&#10;else sum([alfred_order_qty])/sum([order_qty]) &#10;end' />
      </column>
      <column caption='Timeframe selection' datatype='string' name='[Calculation_353602982872879106]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [timeframe]&#10;WHEN &apos;Week&apos; THEN &quot;W&quot; + DATENAME(&apos;iso-week&apos;,[first_date_timeframe]) +&apos; &apos;+ STR(YEAR([first_date_timeframe]))&#10;WHEN &apos;Month&apos; THEN LEFT(DATENAME(&apos;month&apos;,[first_date_timeframe]),3) +&apos;.&apos;+ STR(YEAR([first_date_timeframe]))&#10;WHEN &apos;Quarter&apos; THEN &quot;Q&quot; + DATENAME(&apos;quarter&apos;,[first_date_timeframe]) +&apos; &apos;+ STR(YEAR([first_date_timeframe]))&#10;WHEN &apos;Year&apos; THEN STR(YEAR([first_date_timeframe]))&#10;END' />
      </column>
      <column caption='Timeframe selection 2' datatype='string' name='[Calculation_4268427284523212803]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [timeframe]&#10;    WHEN &apos;Week&apos; then &quot;W&quot; + DATENAME(&apos;iso-week&apos;,[first_date_timeframe]) + &quot; &quot; + DATENAME(&apos;year&apos;,[first_date_timeframe])&#10;    WHEN &apos;Month&apos; then LEFT(DATENAME(&apos;month&apos;,[first_date_timeframe]),3) + &quot; &quot; + DATENAME(&apos;year&apos;,[first_date_timeframe])&#10;    WHEN &apos;Quarter&apos; then &quot;Q&quot; + DATENAME(&apos;quarter&apos;,[first_date_timeframe]) + &quot; &quot; + DATENAME(&apos;year&apos;,[first_date_timeframe]) &#10;    WHEN &apos;Year&apos; then &quot;Y&quot; + DATENAME(&apos;year&apos;,[first_date_timeframe])        &#10;END' />
      </column>
      <column caption='is_period_filtered' datatype='boolean' name='[Calculation_4483826016802291714]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 9] &lt;= [first_date_timeframe]&#10;AND&#10;[Parameters].[Start Date - incidents (copy)_4483826016802000896] &gt;= [first_date_timeframe]' />
      </column>
      <column caption='Order Qty - filtered period' datatype='integer' name='[Calculation_4483826016803581956]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Calculation_4483826016802291714] AND [timeframe]=&apos;Day&apos;,[order_qty],Null)' />
      </column>
      <column caption='Tribe' datatype='string' name='[Calculation_4483826016808054791]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Fintech&quot;' />
      </column>
      <column caption='Timeframe selection min date' datatype='string' name='[Timeframe selection (copy)_3366862950696501248]' role='measure' type='nominal'>
        <calculation class='tableau' formula='CASE MIN([timeframe])&#10;    WHEN &apos;Week&apos; then &quot;W&quot; + DATENAME(&apos;iso-week&apos;,[max date (copy)_3366862950697672706]) + &quot; &quot; + DATENAME(&apos;year&apos;,[max date (copy)_3366862950697672706])&#10;    WHEN &apos;Month&apos; then LEFT(DATENAME(&apos;month&apos;,[max date (copy)_3366862950697672706]),3) + &quot; &quot; + DATENAME(&apos;year&apos;,[max date (copy)_3366862950697672706])&#10;    WHEN &apos;Quarter&apos; then &quot;Q&quot; + DATENAME(&apos;quarter&apos;,[max date (copy)_3366862950697672706]) + &quot; &quot; + DATENAME(&apos;year&apos;,[max date (copy)_3366862950697672706]) &#10;    WHEN &apos;Year&apos; then &quot;Y&quot; + DATENAME(&apos;year&apos;,[max date (copy)_3366862950697672706])        &#10;END' />
