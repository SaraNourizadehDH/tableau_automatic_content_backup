          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.06vjsq01kzlmgb17kw5ve0v7zlvo].[Calculation_273453000766267396]' caption='Cloud Costs.End' datatype='date' default-format='*d.mmm.yyyy' name='[Cloud Costs.Start (copy)_273453000766210051]' param-domain-type='any' role='measure' type='quantitative' value='#2024-09-09#'>
              <calculation class='tableau' formula='#2024-09-09#' />
            </column>
            <column alias='Cloud Provider' caption='Cloud Costs - breakdown by' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;provider&quot;'>
              <calculation class='tableau' formula='&quot;provider&quot;' />
              <aliases>
                <alias key='&quot;cost_center&quot;' value='Cloud Cost Center' />
                <alias key='&quot;provider&quot;' value='Cloud Provider' />
                <alias key='&quot;region&quot;' value='Region' />
                <alias key='&quot;squad&quot;' value='DH Squad' />
                <alias key='&quot;total&quot;' value='Total' />
                <alias key='&quot;tribe&quot;' value='DH Tribe' />
              </aliases>
            </column>
            <column alias='Week' caption='Timeframe' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
              <calculation class='tableau' formula='&quot;week&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Day' />
                <alias key='&quot;month&quot;' value='Month' />
                <alias key='&quot;quarter&quot;' value='Quarter' />
                <alias key='&quot;week&quot;' value='Week' />
                <alias key='&quot;year&quot;' value='Year' />
              </aliases>
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.06vjsq01kzlmgb17kw5ve0v7zlvo].[Calculation_273453000766369797]' caption='Cloud Costs.Start' datatype='date' default-format='*d.mmm.yyyy' name='[Parameter 3]' param-domain-type='any' role='measure' type='quantitative' value='#2024-08-10#'>
              <calculation class='tableau' formula='#2024-08-10#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.06vjsq01kzlmgb17kw5ve0v7zlvo'>
            <column caption='Cloud Costs breakdown' datatype='string' name='[Calculation_273453000721653760]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;provider&apos; THEN [cloud_provider]&#10;    WHEN &apos;cost_center&apos; THEN [Cost Center Name (group)]&#10;    WHEN &apos;squad&apos; THEN [dh_squad]&#10;    WHEN &apos;tribe&apos; THEN [dh_tribe]&#10;    WHEN &apos;region&apos; THEN [region]&#10;ELSE &apos;Total&apos;&#10;END' />
            </column>
            <column caption='Date.Timeframe' datatype='string' datatype-customized='true' name='[Calculation_273453000763768833]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;day&apos; THEN STR([date])&#10;WHEN &apos;week&apos; THEN STR(YEAR([date]))+&apos; W&apos;+ STR(WEEK([date]))&#10;WHEN &apos;month&apos; THEN LEFT(DATENAME(&apos;month&apos;, [date]),3) + &apos; &apos; + STR(YEAR([date]))&#10;WHEN &apos;quarter&apos; THEN STR(YEAR([date]))+&apos; Q&apos;+STR(QUARTER([date])) &#10;WHEN &apos;year&apos; THEN STR(YEAR([date]))&#10;ELSE NULL END' />
            </column>
            <column caption='Date.MAX' datatype='date' name='[Calculation_273453000766267396]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{MAX([date])}' />
            </column>
            <column caption='Date.MAX-30' datatype='datetime' datatype-customized='true' name='[Calculation_273453000766369797]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{MAX(DATEADD(&apos;day&apos;,-30,[date]))}' />
            </column>
            <column caption='is_period_filtered' datatype='boolean' name='[Calculation_4483826016802291714]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 3] &lt;= DATE([date])&#10;AND&#10;[Parameters].[Cloud Costs.Start (copy)_273453000766210051] &gt;= DATE([date])' />
            </column>
            <column datatype='string' name='[Cost Center Name (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[cost_center_name]' new-bin='true'>
                <bin default-name='false' value='&quot;Fintech G&amp;A&quot;'>
                  <value>&quot;FinTech - G&amp;A&quot;</value>
                  <value>&quot;Fintech G&amp;A&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='Cloud Provider' datatype='string' name='[cloud_provider]' role='dimension' type='nominal' />
            <column caption='Cost Center Name' datatype='string' name='[cost_center_name]' role='dimension' type='nominal' />
