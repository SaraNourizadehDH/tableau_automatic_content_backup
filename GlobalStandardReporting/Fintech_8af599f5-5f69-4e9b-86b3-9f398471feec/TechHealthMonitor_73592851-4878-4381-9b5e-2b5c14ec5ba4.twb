      <column caption='Duration resolution' datatype='integer' name='[Calculation_1514757605822210097]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='datediff(&apos;minute&apos;,[StartDatetime],[EndDatetime])' />
      </column>
      <column caption='incients_arrow_up' datatype='string' name='[Calculation_1514757605825462326]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IIF( ZN(COUNT([__tableau_internal_object_id__].[scorecard_indicent_3F94F39E38C94AB8B82067773B8C09DB])) - LOOKUP(ZN(COUNT([__tableau_internal_object_id__].[scorecard_indicent_3F94F39E38C94AB8B82067773B8C09DB])), -1) &gt;0, &apos;▲&apos;, NULL)'>
