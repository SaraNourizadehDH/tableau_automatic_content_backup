  <worksheets>
    <worksheet name='DoI - global'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#898989' fontname='Tableau Medium' fontsize='9'>MTTR (min) per incident</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#898989' fontname='Tableau Medium' fontsize='8'>Average resolution time </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='scorecard_indicent (rl_fintech)' name='federated.10qsyua07d0vo518o8cwq0u0b3sf' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Week' caption='Timeframe' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
              <calculation class='tableau' formula='&quot;week&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Day' />
                <alias key='&quot;month&quot;' value='Month' />
                <alias key='&quot;quarter&quot;' value='Quarter' />
                <alias key='&quot;week&quot;' value='Week' />
                <alias key='&quot;year&quot;' value='Year' />
              </aliases>
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.10qsyua07d0vo518o8cwq0u0b3sf].[End date - last Sunday (copy)_4483826016842747921]' caption='Start Date - incidents' datatype='date' default-format='*d.mmm.yyyy' name='[Parameter 9]' param-domain-type='any' role='measure' type='quantitative' value='#2024-09-09#'>
              <calculation class='tableau' formula='#2024-09-09#' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.10qsyua07d0vo518o8cwq0u0b3sf].[Calculation_4483826016840953871]' caption='End Date - incidents' datatype='date' default-format='*d.mmm.yyyy' name='[Start Date - incidents (copy)_4483826016802000896]' param-domain-type='any' role='measure' type='quantitative' value='#2024-09-22#'>
              <calculation class='tableau' formula='#2024-09-22#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.10qsyua07d0vo518o8cwq0u0b3sf'>
            <column caption='Duration resolution' datatype='integer' name='[Calculation_1514757605822210097]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='datediff(&apos;minute&apos;,[StartDatetime],[EndDatetime])' />
            </column>
            <column caption='Duration over incidents' datatype='real' name='[Calculation_1514757605829713985]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_1514757605822210097])/count([__tableau_internal_object_id__].[scorecard_indicent_3F94F39E38C94AB8B82067773B8C09DB])' />
            </column>
            <column caption='ZN([Duration over incidents]) - LOOKUP(ZN([Duration over inci...' datatype='real' name='[Calculation_1514757605829922882]' role='measure' type='quantitative' user:unnamed='DoI - global'>
              <calculation class='tableau' formula='ZN([Calculation_1514757605829713985]) - LOOKUP(ZN([Calculation_1514757605829713985]), -1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='variation over string' datatype='string' name='[Calculation_3775072039621668879]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if &#10;[Parameters].[Parameter 2] = &apos;Month&apos; then &apos;MoM&apos;&#10;elseif&#10;[Parameters].[Parameter 2] = &apos;Week&apos; then &apos;WoW&apos;&#10;elseif&#10;[Parameters].[Parameter 2] = &apos;Quarter&apos; then &apos;QoQ&apos;&#10;elseif&#10;[Parameters].[Parameter 2] = &apos;Year&apos; then &apos;YoY&apos;&#10;end' />
            </column>
            <column caption='is_period_filtered' datatype='boolean' name='[Calculation_4483826016802291714]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 9] &lt;= DATE([StartDatetime])&#10;AND&#10;[Parameters].[Start Date - incidents (copy)_4483826016802000896] &gt;= DATE([StartDatetime])' />
            </column>
            <column caption='Incident Count - filtered period' datatype='integer' name='[Calculation_4483826016805797894]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Calculation_4483826016802291714],1,Null)' />
            </column>
            <column caption='MTTR (min) - filtered period' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_4483826016810680330]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Duration (copy 2)_4483826016809971720])/SUM([Calculation_4483826016805797894])' />
            </column>
            <column caption='End date - last Sunday' datatype='date' name='[Calculation_4483826016840953871]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;, TODAY(), &apos;Sunday&apos;))' />
            </column>
            <column caption='Is duration valid' datatype='boolean' name='[Calculation_5912030049670115328]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[StartDatetime]&lt;=[EndDatetime]&#10;AND [DetectionDatetime]&lt;=[EndDatetime]&#10;AND [StartDatetime]&lt;=[DetectionDatetime]' />
