      <column caption='Jump Score' datatype='real' name='[Calculation_547187374284783616]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_median_jumps]) / sum([num_orders_more_2_request])' />
      </column>
      <column caption='Upside Jump Score' datatype='real' name='[Calculation_547187374287196161]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_median_upside_jumps]) / SUM([num_orders_more_2_request])' />
      </column>
      <column caption='Downside Jump Score' datatype='real' name='[Calculation_547187374349398018]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_median_downside_jumps]) / SUM([num_orders_more_2_request])' />
      </column>
      <column caption='MAE' datatype='real' name='[Calculation_547187374398730243]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_median_prediction_absolute_error]) / SUM([total_requests])' />
      </column>
      <column caption='Mean jump count per requests' datatype='real' name='[Calculation_547187374451277828]' role='measure' type='quantitative'>
