    <worksheet name='Metrics View (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontname='Tableau Bold'>By Metric</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Main View' name='federated.0965k5209q4hca1ajl5wr149z2ip' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Entity' caption='Entity or Country' datatype='string' name='[Date Granularity (copy 2)]' param-domain-type='list' role='measure' type='nominal' value='&quot;1&quot;'>
              <calculation class='tableau' formula='&quot;1&quot;' />
              <aliases>
                <alias key='&quot;1&quot;' value='Entity' />
                <alias key='&quot;2&quot;' value='Country' />
              </aliases>
            </column>
            <column caption='# of Periods' datatype='integer' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='7'>
              <calculation class='tableau' formula='7' />
              <range max='15' min='1' />
            </column>
            <column caption='Vendor Id' datatype='string' name='[Parameter 3]' param-domain-type='any' role='measure' type='nominal' value='&quot;&quot;'>
              <calculation class='tableau' formula='&quot;&quot;' />
            </column>
            <column alias='In' caption='In / Out' datatype='boolean' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
              <aliases>
                <alias key='false' value='Out' />
                <alias key='true' value='In' />
              </aliases>
            </column>
            <column alias='Chain Name without Id (curated data)' caption='Chain Name' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;1&quot;'>
              <calculation class='tableau' formula='&quot;1&quot;' />
              <aliases>
                <alias key='&quot;1&quot;' value='Chain Name without Id (curated data)' />
                <alias key='&quot;2&quot;' value='Chain Name with Id (non curated data)' />
              </aliases>
            </column>
            <column caption='Granularity' datatype='string' name='[Parameter 7]' param-domain-type='list' role='measure' type='nominal' value='&quot;None&quot;'>
              <calculation class='tableau' formula='&quot;None&quot;' />
              <aliases>
                <alias key='&quot;daily&quot;' value='Daily' />
                <alias key='&quot;monthly&quot;' value='Monthly' />
                <alias key='&quot;quarterly&quot;' value='Quarterly' />
                <alias key='&quot;semiannually&quot;' value='Semiannually' />
                <alias key='&quot;weekly&quot;' value='Weekly' />
              </aliases>
            </column>
            <column caption='Show last period' datatype='boolean' name='[Replacements Metric (copy)]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
            </column>
            <column caption='Chain Id' datatype='string' name='[Vendor Id (copy)_2410622133502861314]' param-domain-type='any' role='measure' type='nominal' value='&quot;&quot;'>
              <calculation class='tableau' formula='&quot;&quot;' />
            </column>
            <column alias='Only with Replacements' caption='Replacements Metric' datatype='string' name='[Vendor Id Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;2&quot;'>
              <calculation class='tableau' formula='&quot;2&quot;' />
              <aliases>
                <alias key='&quot;1&quot;' value='All Vendors' />
                <alias key='&quot;2&quot;' value='Only with Replacements' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0965k5209q4hca1ajl5wr149z2ip'>
            <column caption='% Partial Orders' datatype='real' default-format='p0.00%' name='[% Items Not Delivered (copy)_1694901632218554378]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([partial_orders_pelican]) &#10;/ SUM([confirmed_orders])' />
            </column>
            <column caption='% Items Not Processed' datatype='real' default-format='p0.00%' name='[% Items Not Delivered (copy)_1694901632219320331]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    SUM([not_processed_pelican_items])&#10;) / &#10;(&#10;    SUM([in_cart_pelican_items])&#10;    + SUM([not_found_pelican_items])&#10;    + SUM([not_processed_pelican_items])&#10;    + SUM([replaced_pelican_items])&#10;)' />
            </column>
            <column caption='% Items Replaced from eligible (only active replacements) Sub' datatype='real' default-format='p0.00%' name='[% Items Replaced from eligible (copy)_6108007057010683904]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [has_replacements_in_last_30_days] THEN [replacements_pelican_items] ELSE 0 END)&#10;/&#10;(&#10;    (&#10;        SUM(IF [has_replacements_in_last_30_days] THEN [in_cart_pelican_items] ELSE 0 END) &#10;        - SUM(IF [has_replacements_in_last_30_days] THEN [in_cart_pelican_items_sold] ELSE 0 END)&#10;    )&#10;    + SUM(IF [has_replacements_in_last_30_days] THEN [not_found_pelican_items] ELSE 0 END)&#10;    + SUM(IF [has_replacements_in_last_30_days] THEN [qty_failed_due_to_oos] ELSE 0 END)&#10;    + (&#10;        SUM(IF [has_replacements_in_last_30_days] THEN [replaced_pelican_items] ELSE 0 END) &#10;        - SUM(IF [has_replacements_in_last_30_days] THEN [replaced_pelican_items_sold] ELSE 0 END)&#10;    )&#10;)' />
            </column>
            <column caption='% Items Replaced' datatype='real' default-format='p0.00%' name='[% Items Replaced from eligible Sub (copy)_6108007057033035780]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Vendor Id Parameter]&#10;WHEN &quot;1&quot; THEN [Calculation_1694901632481710095]&#10;WHEN &quot;2&quot; THEN [% Items Replaced from eligible (copy)_6108007057010683904]&#10;END' />
            </column>
            <column caption='Partial Orders - Score' datatype='real' default-format='n#,##0;-#,##0' name='[% Perc Items Not Delivered - Score (copy)_1694901632212475908]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(&#10;    (&#10;    (SUM( [perc_partial_orders_pelican_score] * [gmv_net_eur]))&#10;    / (SUM([gmv_net_eur]))&#10;    ) * 10&#10;,0)' />
            </column>
            <column caption='Not Processed Items - Score' datatype='real' default-format='n#,##0;-#,##0' name='[% Perc Partial Orders - Score (copy) (copy)_1694901632213233670]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(&#10;    (&#10;    (SUM( [perc_percent_not_processed_items_score] * [gmv_net_eur]))&#10;    / (SUM([gmv_net_eur]))&#10;    ) * 10&#10;,0)' />
            </column>
            <column caption='OOS Fail Rate - Score' datatype='real' default-format='n#,##0;-#,##0' name='[% Perc Partial Orders - Score (copy)_1694901632213221381]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(&#10;    (&#10;    (SUM( [perc_oos_fr_score] * [gmv_net_eur]))&#10;    / (SUM([gmv_net_eur]))&#10;    ) * 10&#10;,0)' />
            </column>
            <column caption='Replaced Items - Score' datatype='real' default-format='n#,##0;-#,##0' name='[% Perc Partial Orders - Score (copy)_1694901632213848071]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(&#10;    (&#10;    (SUM( IF [has_replacements_in_last_30_days] THEN &#10;        ([perc_replaced_items_from_eligible_score] * [gmv_net_eur])&#10;    ELSE NULL END&#10;    )&#10;    )&#10;    / (SUM(IF [has_replacements_in_last_30_days] THEN [gmv_net_eur] ELSE NULL END))&#10;    ) * 10&#10;,0)' />
            </column>
            <column caption='OTHER METRICS' datatype='integer' name='[BY SCORE TYPE (copy)_2410622133474406401]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(NULL)' />
            </column>
            <column caption='Entity' datatype='string' name='[Calculation_1694901632198844416]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF LOWER([country]) = &apos;turkey&apos; THEN &quot;Yemeksepeti&quot; ELSE [management_entity] END' />
            </column>
            <column caption='General Score ' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1694901632199659521]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(&#10;    (SUM([general_score] * [gmv_net_eur]))&#10;    / (SUM([gmv_net_eur]))&#10;,0)' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_1694901632200732674]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [granularity]&#10;    WHEN &apos;daily&apos; THEN RIGHT(STR(DATE([local_date])),5) + &quot;  &quot; + LEFT(DATENAME(&apos;weekday&apos;, [local_date]), 3)&#10;    WHEN &apos;weekly&apos; THEN RIGHT(STR(DATE(DATETRUNC(&apos;week&apos;,[local_date], &apos;monday&apos;))),8)&#10;    WHEN &apos;monthly&apos; THEN LEFT(RIGHT(STR(DATE(DATETRUNC(&apos;month&apos;,[local_date]))),8), 5)&#10;    WHEN &apos;quarterly&apos; THEN LEFT(RIGHT(STR(DATE(DATETRUNC(&apos;quarter&apos;,[local_date]))),8), 5)&#13;&#10;    WHEN &apos;semiannually&apos; THEN LEFT(RIGHT(STR(DATE(DATETRUNC(&apos;month&apos;,[local_date]))),8), 5)&#10;END' />
            </column>
            <column caption='% Items Not Delivered' datatype='real' default-format='p0.00%' name='[Calculation_1694901632217317385]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    (SUM([in_cart_pelican_items]) - SUM([in_cart_pelican_items_sold]))&#10;    + (SUM([not_found_pelican_items]))&#10;    + ((SUM([replaced_pelican_items])) - (SUM([replaced_pelican_items_sold])) - (SUM([replacements_pelican_items])))&#10;    + (SUM([qty_failed_due_to_oos]))&#10;) / &#10;(&#10;    SUM([in_cart_pelican_items])&#10;    + SUM([not_found_pelican_items])&#10;    + SUM([replaced_pelican_items])&#10;    + SUM([not_processed_pelican_items])&#10;    + SUM([qty_failed_due_to_oos])&#10;)' />
            </column>
            <column caption='% Items Replaced from eligible Sub' datatype='real' default-format='p0.00%' name='[Calculation_1694901632481710095]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([replacements_pelican_items])&#10;/ &#10;(&#10;    (SUM([in_cart_pelican_items]) - SUM([in_cart_pelican_items_sold]))&#10;    + SUM([not_found_pelican_items])&#10;    + SUM([qty_failed_due_to_oos])&#10;    + (SUM([replaced_pelican_items]) - SUM([replaced_pelican_items_sold]))&#10;)' />
            </column>
            <column caption='# of Vendors' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_178525566770700291]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([vendor_id])' />
            </column>
            <column caption='# of Chains' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_178525566770810884]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([chain_id])' />
            </column>
            <column caption='Entity or Country' datatype='string' name='[Calculation_2164894478748835840]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF {FIXED : COUNTD([Calculation_1694901632198844416])} &gt; 1 THEN&#10;    CASE [Parameters].[Date Granularity (copy 2)]&#10;    WHEN &quot;1&quot; THEN  [Calculation_1694901632198844416]&#10;    ELSE [country]&#10;    END&#10;ELSE [country]&#10;END' />
            </column>
            <column caption='Show Last Period' datatype='boolean' name='[Calculation_2164894478752309252]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Replacements Metric (copy)] = FALSE THEN &#10;    IF [period_num] = 1 THEN FALSE ELSE TRUE END&#10;    ELSE TRUE&#10;END' />
            </column>
            <column caption='Vendor Name ' datatype='string' name='[Calculation_2196349307412434944]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[vendor_name] + &quot; (&quot; + [vendor_id] + &quot;)&quot;' />
            </column>
            <column caption='BY SCORE TYPE' datatype='integer' name='[Calculation_2410622133474054144]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(NULL)' />
            </column>
            <column caption='Chain List to Filter Calc' datatype='boolean' name='[Calculation_2410622133506789379]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4] THEN&#10;    IF [Parameters].[Vendor Id (copy)_2410622133502861314] != &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Vendor Id (copy)_2410622133502861314], [chain_id]) THEN TRUE ELSE FALSE END&#10;        ELSE TRUE&#10;    END&#10;ELSE&#10;    IF [Parameters].[Vendor Id (copy)_2410622133502861314]!= &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Vendor Id (copy)_2410622133502861314], [chain_id]) THEN FALSE ELSE TRUE END&#10;        ELSE TRUE&#10;    END&#10;END' />
            </column>
            <column caption='Filter Outliers' datatype='string' name='[Calculation_3480367782758166528]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [granularity]&#10;WHEN &quot;daily&quot; THEN IF [confirmed_orders] &gt; 1 THEN &quot;Non outlier&quot; ELSE &quot;Outlier&quot; END&#10;WHEN &quot;weekly&quot; THEN IF [confirmed_orders] &gt; 7 THEN &quot;Non outlier&quot; ELSE &quot;Outlier&quot; END&#10;WHEN &quot;monthly&quot; THEN IF [confirmed_orders] &gt; 30 THEN &quot;Non outlier&quot; ELSE &quot;Outlier&quot; END&#10;WHEN &quot;quarterly&quot; THEN IF [confirmed_orders] &gt; 45 THEN &quot;Non outlier&quot; ELSE &quot;Outlier&quot; END&#13;&#10;WHEN &quot;semiannually&quot; THEN IF [confirmed_orders] &gt; 90 THEN &quot;Non outlier&quot; ELSE &quot;Outlier&quot; END&#10;END' />
            </column>
            <column caption='% OOS FR' datatype='real' default-format='p0.00%' name='[Calculation_6108007057037611013]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_due_to_oos]) / SUM([total_orders])' />
            </column>
            <column caption='Chain Name ' datatype='string' name='[Calculation_6359786428643655681]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &quot;1&quot; THEN [chain_name] + &quot; (&quot; + [country_code] + &quot;)&quot;&#10;ELSE [chain_id] + &quot; - &quot; + [chain_name]&#10;END' />
            </column>
            <column caption='Vendor List to Filter Calc' datatype='boolean' name='[Chain List to Filter Calc (copy)_2410622133507145732]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4] THEN&#10;    IF [Parameters].[Parameter 3] != &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Parameter 3], [vendor_id]) THEN TRUE ELSE FALSE END&#10;        ELSE TRUE&#10;    END&#10;ELSE&#10;    IF [Parameters].[Parameter 3]!= &quot;&quot; THEN&#10;        IF CONTAINS([Parameters].[Parameter 3], [vendor_id]) THEN FALSE ELSE TRUE END&#10;        ELSE TRUE&#10;    END&#10;END' />
            </column>
            <column caption='Entity or Country Code' datatype='string' name='[Entity or Country (copy)_4435201273267986433]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='tableau' formula='IF {FIXED : COUNTD([Calculation_1694901632198844416])} &gt; 1 THEN&#10;    CASE [Parameters].[Date Granularity (copy 2)]&#10;    WHEN &quot;1&quot; THEN  [Calculation_1694901632198844416]&#10;    ELSE [global_entity_id]&#10;    END&#10;ELSE [country]&#10;END' />
            </column>
            <column caption='Items Not Delivered - Score' datatype='real' default-format='n#,##0;-#,##0' name='[General Score  (copy)_1694901632206094339]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(&#10;    (&#10;    (SUM([perc_items_not_delivered_score] * [gmv_net_eur]))&#10;    / (SUM([gmv_net_eur]))&#10;    ) * 10&#10;,0)' />
            </column>
            <column caption='OTHER METRICS 2' datatype='integer' name='[OTHER METRICS (copy)_3480367782765244420]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(NULL)' />
            </column>
            <column caption='SFTP Score' datatype='real' name='[OTHER METRICS 3 (copy)_3480367782765412358]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(&#10;    (SUM(If [has_sftp_jobs] THEN [sftp_score] ELSE NULL END * If [has_sftp_jobs] THEN [gmv_net_eur]  ELSE NULL END))&#10;    / (SUM(If [has_sftp_jobs] THEN [gmv_net_eur] ELSE NULL END))&#10;,0)' />
            </column>
            <column caption='Picker Score' datatype='integer' name='[OTHER METRICS 3 (copy)_3480367782765445127]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0' />
            </column>
