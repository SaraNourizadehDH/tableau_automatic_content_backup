        </style-rule>
      </style>
      <size maxheight='2500' maxwidth='1360' minheight='2500' minwidth='1360' sizing-mode='fixed' />
      <zones>
        <zone forceUpdate='true' h='4600' id='3' type-v2='text' w='73971' x='368' y='560'>
          <formatted-text>
            <run bold='true' fontcolor='#d5001f' fontname='Tableau Bold' fontsize='28'>Getting Started with the OOS Performance Scorecard</run>
          </formatted-text>
        </zone>
        <zone h='4600' id='6' param='horz' type-v2='layout-flow' w='22941' x='76029' y='400'>
          <zone fixed-size='387' forceUpdate='true' h='4600' id='4' is-fixed='true' type-v2='text' w='15147' x='76029' y='400'>
            <formatted-text>
              <run bold='true' fontalignment='2' fontcolor='#d61f26' fontsize='24'>Local Shops</run>
              <run fontalignment='2'>Æ&#10;</run>
              <run bold='true' fontalignment='2' fontcolor='#606b76' fontsize='10'>QUICK-COMMERCE</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone fixed-size='98' h='4600' id='5' is-fixed='true' is-scaled='1' param='Image/Delivery-Hero-Comet.png' type-v2='bitmap' w='7794' x='91176' y='400'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
        </zone>
        <zone forceUpdate='true' h='94200' id='878' type-v2='text' w='99265' x='368' y='5600'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Tableau Semibold' fontsize='14'>1. Overview </run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontsize='11'>The </run>
            <run bold='true' fontcolor='#000000' fontsize='11'>OOS Performance Scorecard</run>
            <run fontcolor='#000000' fontsize='11'> dashboard is designed to analyze out-of-stock (OOS) performance metrics across various dimensions such as vendors, chains, and countries. It provides insights into order fulfillment and failure rates due to OOS issues, while allowing users to view performance by selected periods. This dashboard is highly useful for tracking OOS-related vendor performance across different time granularities, such as daily, weekly, or monthly intervals. It features views based on both individual periods and multiple periods, showing trends and detailed performance metrics, allowing users to identify areas where improvements are needed. </run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontsize='11'>Important Note: this dash only show info from pelican orders.</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Semibold' fontsize='14'>2. Available Filters</run>
            <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='14'>Æ </run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='11'>- Entity</run>
            <run fontcolor='#000000' fontsize='11'>: Filters the data by the entity type (e.g., vendor categories or business units). </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='11'>- Country</run>
            <run fontcolor='#000000' fontsize='11'>: Filters data based on the selected country. </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='11'>- City</run>
            <run fontcolor='#000000' fontsize='11'>: Filters the data by specific cities. </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='11'>- Account Manager</run>
            <run fontcolor='#000000' fontsize='11'>: Filters based on the assigned account manager for vendors. </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='11'>- Store Type L1</run>
            <run fontcolor='#000000' fontsize='11'>: Filters the data by store classification at the L1 level. </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='11'>- Is AAA Supermarket</run>
            <run fontcolor='#000000' fontsize='11'>: Filters to include only supermarkets that are classified as AAA. </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='11'>- Chain Name Format</run>
            <run fontcolor='#000000' fontsize='11'>: Allows the filtering of chains by the chain name format. </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='11'>- Chain Name</run>
            <run fontcolor='#000000' fontsize='11'>: Filters by the chain name. </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='11'>- Vendor Name</run>
            <run fontcolor='#000000' fontsize='11'>: Filters data by vendor names. </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='11'>- In/Out</run>
            <run fontcolor='#000000' fontsize='11'>: Determines whether to include or exclude specific vendors or chains based on an ID list. </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='11'>- Chain IDs</run>
            <run fontcolor='#000000' fontsize='11'>: Filter specific chains by entering a list of chain IDs. </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='11'>- Vendor IDs</run>
            <run fontcolor='#000000' fontsize='11'>: Filter specific vendors by entering a list of vendor IDs. </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='11'>- Has Weighted Items</run>
            <run fontcolor='#000000' fontsize='11'>: Filters by vendors or chains that have weighted items. </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='11'>- Filter Outliers</run>
            <run fontcolor='#000000' fontsize='11'>: Removes vendors or chains with very low transaction counts or extreme data points to avoid skewing the performance scores. </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='11'>- Selected Period</run>
            <run fontcolor='#000000' fontsize='11'>: Allows users to choose the time period to analyze performance (daily, weekly, quarterly, etc.). </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='11'>- Granularity</run>
            <run fontcolor='#000000' fontsize='11'>: Defines the time intervals for data analysis (daily, weekly, monthly, quarterly, semi-annually). </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='11'>- KPI View</run>
            <run fontcolor='#000000' fontsize='11'>: Toggle between viewing the score or the metric itself. </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='11'>- Replacements Metric</run>
            <run fontcolor='#000000' fontsize='11'>: Controls whether the replacements metric is shown for all vendors or only those with replacements. </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='11'>- Score to Analyze</run>
            <run fontcolor='#000000' fontsize='11'>: Choose which metric or score to analyze, such as: General Score</run>
            <run bold='true' fontcolor='#000000' fontsize='11'>, </run>
            <run fontcolor='#000000' fontsize='11'>Items Not Delivered</run>
            <run bold='true' fontcolor='#000000' fontsize='11'>, </run>
            <run fontcolor='#000000' fontsize='11'>Items Not Processed</run>
            <run bold='true' fontcolor='#000000' fontsize='11'>, </run>
            <run fontcolor='#000000' fontsize='11'>Items Replaced</run>
            <run bold='true' fontcolor='#000000' fontsize='11'>, </run>
            <run fontcolor='#000000' fontsize='11'>Partial Orders</run>
            <run bold='true' fontcolor='#000000' fontsize='11'>, </run>
            <run fontcolor='#000000' fontsize='11'>OOS Fail Rate. </run>
            <run>Æ&#10;&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Semibold' fontsize='14'>3. Key Metrics</run>
            <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='14'>Æ </run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontsize='11'>Important note: all scores are calculated at the vendor level. The aggregations of these scores are weighted averages by GMV. For example, to calculate the score of a country: SUM(Score of each vendor in the country * GMV of each vendor in that country) / SUM(GMV of each vendor in that country). In this way, vendors with higher GMV have a greater weight in each of the scores.</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='11'>- % Items Not Delivered - </run>
            <run fontcolor='#000000' fontsize='11'>Percentage of ordered items not delivered to the user due to OOS of Confirmed Orders or OOS Failed Orders. </run>
            <run fontcolor='#000000' fontsize='11' underline='true'>Formula: Unfulfilled item calculations based on different order statuses and items from OOS failed orders, divided by the total Ordered Items from confirmed orders.</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='11'>- % Items Not Processed - </run>
            <run fontcolor='#000000' fontsize='11'>Percentage of items tagged as not processed in the order. </run>
            <run fontcolor='#000000' fontsize='11' underline='true'>Formula: Items flagged as NOT_PROCESSED, divided by the total Ordered Items from confirmed orders.</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='11'>- % Items Replaced - </run>
            <run fontcolor='#000000' fontsize='11'>Percentage of items replaced in the orders. </run>
            <run fontcolor='#000000' fontsize='11' underline='true'>Formula: Replacements, divided by all Not Delivered Items &amp; Items from OOS Failed Orders.</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='11'>- % Partial Orders - </run>
            <run fontcolor='#000000' fontsize='11'>Percentage of orders in which the number of Sold Items is less than the number of Ordered Items. </run>
            <run fontcolor='#000000' fontsize='11' underline='true'>Formula: number of confirmed orders where the number of Sold Items is less than the number of Ordered Items, divided by the number of confirmed orders.</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='11'>- % OOS Failed Rate - </run>
            <run fontcolor='#000000' fontsize='11'>Percentage of orders failed due to out-of-stock (OOS) issues. </run>
            <run fontcolor='#000000' fontsize='11' underline='true'>Formula: OOS Failed Orders / Total Orders.</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='11'>- SFTP Score - </run>
            <run fontcolor='#000000' fontsize='11'>Is the SFTP Score from the </run>
            <run fontcolor='#000000' fontsize='11' underline='true'>LS - Operations - Fulfilment Operations - SFTP Dashboard</run>
            <run fontcolor='#000000' fontsize='11'>.</run>
            <run>Æ&#10;&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Semibold' fontsize='14'>4. </run>
            <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='14'>Scores</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='11'>General Score (if replacements &gt; 0) =</run>
            <run fontcolor='#000000' fontsize='11'> (((A * 2) + B + C + (D * 2) + (E * 2)) / 5) * 10</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='11'>General Score (if replacements = 0) =</run>
            <run fontcolor='#000000' fontsize='11'> (((A * 2) + B + (D * 2) + (E * 2)) / 4) * 10</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='11'>Any other Score =</run>
            <run fontcolor='#000000' fontsize='11'> Score * 10</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='11'>A. % Items Not Delivered</run>
            <run fontcolor='#000000' fontsize='11'>:</run>
            <run>Æ&#10;</run>
            <run fontcolor='#ffffff' fontsize='11'>Æ        </run>
            <run fontcolor='#000000' fontsize='11'>WHEN</run>
            <run fontcolor='#ffffff' fontsize='11'>Æ </run>
            <run fontcolor='#000000' fontsize='11'>&gt;</run>
            <run fontcolor='#ffffff' fontsize='11'>Æ </run>
            <run fontcolor='#000000' fontsize='11'>20.0%</run>
            <run fontcolor='#ffffff' fontsize='11'>Æ </run>
            <run fontcolor='#000000' fontsize='11'>THEN</run>
            <run fontcolor='#ffffff' fontsize='11'>Æ </run>
            <run fontcolor='#000000' fontsize='11'>0</run>
            <run>Æ&#10;</run>
            <run fontcolor='#ffffff' fontsize='11'>Æ        </run>
            <run fontcolor='#000000' fontsize='11'>WHEN</run>
            <run fontcolor='#ffffff' fontsize='11'>Æ </run>
            <run fontcolor='#000000' fontsize='11'>&gt;</run>
            <run fontcolor='#ffffff' fontsize='11'>Æ </run>
            <run fontcolor='#000000' fontsize='11'>14.0%</run>
            <run fontcolor='#ffffff' fontsize='11'>Æ </run>
            <run fontcolor='#000000' fontsize='11'>THEN</run>
            <run fontcolor='#ffffff' fontsize='11'>Æ </run>
            <run fontcolor='#000000' fontsize='11'>25</run>
            <run>Æ&#10;</run>
            <run fontcolor='#ffffff' fontsize='11'>Æ        </run>
