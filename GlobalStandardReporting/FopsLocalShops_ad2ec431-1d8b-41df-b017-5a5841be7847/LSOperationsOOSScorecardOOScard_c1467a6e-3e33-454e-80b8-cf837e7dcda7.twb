  <dashboards>
    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='OOScard - Getting Started'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/LS-Operations-FulfilmentOperations-OOSScorecard/OOScard-GettingStarted?rev=' id='OOScard-GettingStarted' path='/t/GlobalStandardReporting/workbooks/LS-Operations-FulfilmentOperations-OOSScorecard' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='dash-text'>
          <format attr='wrap' id='dash-text_1874' value='auto' />
          <format attr='wrap' id='dash-text_1012' value='on' />
          <format attr='text-align' id='dash-text_1012' value='left' />
