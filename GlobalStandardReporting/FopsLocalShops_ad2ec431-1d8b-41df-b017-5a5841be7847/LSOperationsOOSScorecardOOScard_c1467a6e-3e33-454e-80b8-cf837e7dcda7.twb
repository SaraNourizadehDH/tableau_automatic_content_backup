      </column>
      <column caption='% OOS FR' datatype='real' default-format='p0.00%' name='[Calculation_6108007057037611013]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([failed_due_to_oos]) / SUM([total_orders])' />
      </column>
      <column caption='Chain Name ' datatype='string' name='[Calculation_6359786428643655681]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &quot;1&quot; THEN [chain_name] + &quot; (&quot; + [country_code] + &quot;)&quot;&#10;ELSE [chain_id] + &quot; - &quot; + [chain_name]&#10;END' />
      </column>
      <column caption='Selected Period' datatype='real' name='[Calculation_6373226857024163844]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [period_num] = [Parameters].[# of Periods (copy)] THEN 1 ELSE INT(NULL) END)' />
      </column>
      <column caption='&quot;Selected Period&quot;' datatype='string' name='[Calculation_6373226857025949702]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Selected &#10;Period&quot;' />
