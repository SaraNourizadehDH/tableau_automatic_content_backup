                <zone fixed-size='76' h='4200' id='363' is-centered='0' is-fixed='true' is-scaled='1' param='Image/Delivery-Hero-Comet.png' type-v2='bitmap' w='8603' x='90588' y='500'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
