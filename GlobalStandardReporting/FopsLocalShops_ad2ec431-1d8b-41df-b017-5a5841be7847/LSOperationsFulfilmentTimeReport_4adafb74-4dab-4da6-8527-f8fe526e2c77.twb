          <datasource-dependencies datasource='federated.00hjioa1mi9lda132m1kj0cxud0u'>
            <column caption='Switch View' datatype='string' name='[Calculation_1273674323392266248]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 12] = &quot;1&quot; THEN &quot;1&quot; &#13;&#10;ELSEIF [Parameters].[Parameter 12] = &quot;2&quot; THEN &quot;2&quot; &#13;&#10;ELSEIF [Parameters].[Parameter 12] = &quot;3&quot; THEN &quot;3&quot; &#13;&#10;END' />
            </column>
            <column caption='Dynamic Field 1' datatype='string' name='[Calculation_129197067099435008]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='REPLACE(&#13;&#10;CASE [Parameters].[Parameter 11]&#13;&#10;WHEN &quot;0&quot; THEN &quot;&quot;&#13;&#10;WHEN &quot;1&quot; THEN STR([Calculation_2580844109258727425])&#13;&#10;WHEN &quot;2&quot; THEN STR([Calculation_2580844109639041047])&#13;&#10;WHEN &quot;3&quot; THEN STR([country])&#13;&#10;WHEN &quot;4&quot; THEN STR([city])&#13;&#10;WHEN &quot;5&quot; THEN STR([account_manager])&#13;&#10;WHEN &quot;6&quot; THEN STR([is_aaa_supermarket])&#13;&#10;WHEN &quot;7&quot; THEN STR([store_type_l1])&#13;&#10;WHEN &quot;8&quot; THEN STR([store_type_l2])&#13;&#10;WHEN &quot;17&quot; THEN STR([store_type_l3])&#13;&#10;WHEN &quot;9&quot; THEN STR([chain_name_adjusted])&#13;&#10;WHEN &quot;10&quot; THEN STR([Calculation_2934095208553451529])&#13;&#10;WHEN &quot;12&quot; THEN STR([contract_type])&#13;&#10;WHEN &quot;13&quot; THEN STR([has_replacements_in_last_30_days])&#13;&#10;WHEN &quot;14&quot; THEN STR([confirmed_orders_with_replacements])&#13;&#10;WHEN &quot;15&quot; THEN STR([is_preorder])&#13;&#10;WHEN &quot;16&quot; THEN STR([has_weighted_products])&#13;&#10;WHEN &quot;18&quot; THEN STR([has_scanned_items])&#13;&#10;END, &quot;_&quot;,&quot; &quot;)' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_2580844109258727425]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [granularity]&#13;&#10;WHEN &quot;daily&quot; THEN RIGHT(STR([local_date]), 5)&#13;&#10;WHEN &quot;weekly&quot; THEN RIGHT(STR([local_date]), 8)&#13;&#10;WHEN &quot;monthly&quot; THEN MID(STR([local_date]), 3, 5)&#13;&#10;WHEN &quot;quarterly&quot; THEN MID(STR([local_date]), 3, 5)&#13;&#10;ELSE STR([local_date])&#13;&#10;END' />
            </column>
            <column caption='Entity' datatype='string' name='[Calculation_2580844109639041047]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF LOWER([country]) = &quot;turkey&quot; THEN &quot;Yemeksepeti&quot; ELSE [management_entity] END' />
            </column>
            <column caption='# of Periods to Show Filter' datatype='boolean' name='[Calculation_2721581600030965763]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF INT([period_num]) &lt;= [Parameters].[Parameter 4] THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='granularity Filter' datatype='boolean' name='[Calculation_2721581600409817092]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [granularity] WHEN &quot;weekday&quot; THEN FALSE ELSE TRUE END' />
            </column>
            <column caption='Pelican Items' datatype='real' name='[Calculation_2905947710943956992]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[in_cart_pelican_items] + [not_found_pelican_items] + [replaced_pelican_items] + [replacements_pelican_items] + [not_processed_pelican_items]' />
            </column>
            <column caption='Average Orders per Day' datatype='real' name='[Calculation_2934095208532836359]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([confirmed_orders])/MAX([num_of_days])' />
            </column>
            <column caption='More than x Order Filter' datatype='boolean' name='[Calculation_2934095208539262984]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;ROUND({ FIXED [Calculation_2580844109258727425], [Calculation_2934095208553451529] : [Calculation_2934095208532836359]}, 0)&#13;&#10;&gt;= [Parameters].[Parameter 7] THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Vendor Name' datatype='string' name='[Calculation_2934095208553451529]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[vendor_id] + &quot; - &quot; + [vendor_name]' />
            </column>
            <column caption='Chain Id Filter' datatype='boolean' name='[Calculation_2934095208586162186]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] THEN&#13;&#10;    IF [Parameters].[Parameter 6] != &quot;&quot; THEN&#13;&#10;        IF CONTAINS([Parameters].[Parameter 6], [chain_id]) THEN TRUE ELSE FALSE END&#13;&#10;        ELSE TRUE&#13;&#10;    END&#13;&#10;ELSE&#13;&#10;    IF [Parameters].[Parameter 6] != &quot;&quot; THEN&#13;&#10;        IF CONTAINS([Parameters].[Parameter 6], [chain_id]) THEN FALSE ELSE TRUE END&#13;&#10;        ELSE TRUE&#13;&#10;    END&#13;&#10;END' />
            </column>
            <column caption='Vendor Id Filter' datatype='boolean' name='[Calculation_2934095208586338315]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] THEN&#13;&#10;    IF [Parameters].[Chain IDs Filter (copy)_2934095208519184388] != &quot;&quot; THEN&#13;&#10;        IF CONTAINS([Parameters].[Chain IDs Filter (copy)_2934095208519184388], [vendor_id]) THEN TRUE ELSE FALSE END&#13;&#10;        ELSE TRUE&#13;&#10;    END&#13;&#10;ELSE&#13;&#10;    IF [Parameters].[Chain IDs Filter (copy)_2934095208519184388] != &quot;&quot; THEN&#13;&#10;        IF CONTAINS([Parameters].[Chain IDs Filter (copy)_2934095208519184388], [vendor_id]) THEN FALSE ELSE TRUE END&#13;&#10;        ELSE TRUE&#13;&#10;    END&#13;&#10;END' />
            </column>
            <column caption='Basket Size' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_328481358681141249]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([in_cart_pelican_items] + [not_found_pelican_items] + [not_processed_pelican_items] + [replaced_pelican_items] ) &#13;&#10;/ SUM([confirmed_orders])' />
            </column>
            <column caption='Metric #1' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_884957381770379286]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Picker Time Metric (copy)_884957381769052180]&#13;&#10;WHEN &quot;1&quot; THEN [Fulfilment Time (copy)_1273674323388223495]&#13;&#10;WHEN &quot;2&quot; THEN [Transmission Time (copy)_1273674323386720257]&#13;&#10;WHEN &quot;3&quot; THEN [Hold Back Time (copy)_1273674323386720261]&#13;&#10;WHEN &quot;4&quot; THEN [Started Time (copy)_1273674323386720259]&#13;&#10;WHEN &quot;5&quot; THEN [Picking Time (copy)_1273674323386720260]&#13;&#10;WHEN &quot;7&quot; THEN [Ready to Pickup Time (copy)_1273674323386720258]&#13;&#10;WHEN &quot;20&quot; THEN [Calculation_328481358681141249]&#13;&#10;WHEN &quot;21&quot; THEN [Calculation_884957382007349272]&#13;&#10;WHEN &quot;22&quot; THEN [Calculation_884957382007455769]&#13;&#10;END' />
            </column>
            <column caption='% Items Not Delivered' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_884957382007349272]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;    (&#13;&#10;        SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [in_cart_pelican_items] ELSE 0 END) &#13;&#10;        - SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [in_cart_pelican_items_sold] ELSE 0 END)&#13;&#10;    )&#13;&#10;    + SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [not_found_pelican_items] ELSE 0 END)&#13;&#10;    + (&#13;&#10;        SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [replaced_pelican_items] ELSE 0 END) &#13;&#10;        - SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [replaced_pelican_items_sold] ELSE 0 END) &#13;&#10;        - SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [replacements_pelican_items] ELSE 0 END) &#13;&#10;    )&#13;&#10;    + SUM(IF [is_failed_due_to_out_of_stock] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [qty_ordered] ELSE 0 END)&#13;&#10;) / &#13;&#10;(&#13;&#10;    SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [in_cart_pelican_items] ELSE 0 END)&#13;&#10;    + SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [not_found_pelican_items] ELSE 0 END)&#13;&#10;    + SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [not_processed_pelican_items] ELSE 0 END)&#13;&#10;    + SUM(IF [is_sent] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [replaced_pelican_items] ELSE 0 END)&#13;&#10;    + SUM(IF [is_failed_due_to_out_of_stock] = TRUE AND [vendor_app] = &apos;pelican&apos; THEN [qty_ordered] ELSE 0 END)&#13;&#10;) * 100' />
            </column>
            <column caption='% Items Not Found' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_884957382007455769]' role='measure' type='quantitative'>
