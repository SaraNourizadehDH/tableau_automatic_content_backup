  <dashboards>
    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Fulfilment Time - Getting Started'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/testing_dashboard_08_12_24/FulfilmentTime-GettingStarted?rev=' id='FulfilmentTime-GettingStarted' path='/t/GlobalStandardReporting/workbooks/testing_dashboard_08_12_24' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='dash-text'>
          <format attr='vertical-align' id='dash-text_879' value='top' />
          <format attr='text-align' id='dash-text_879' value='left' />
