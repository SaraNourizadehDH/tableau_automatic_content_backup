      <table>
        <view>
          <datasources>
            <datasource caption='ls_ops_rt_fulfilment_time' name='federated.00hjioa1mi9lda132m1kj0cxud0u' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Vendor IDs Filter' datatype='string' name='[Chain IDs Filter (copy)_2934095208519184388]' param-domain-type='any' role='measure' type='nominal' value='&quot;&quot;'>
              <calculation class='tableau' formula='&quot;&quot;' />
            </column>
            <column caption='Include Ready to Pickup Time' datatype='boolean' name='[Include Transmission Time (copy) (copy) (copy) (copy)_810366517800480771]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
            </column>
            <column caption='Include Picking Time' datatype='boolean' name='[Include Transmission Time (copy) (copy) (copy)_810366517800460290]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
            </column>
            <column caption='Include Started Time' datatype='boolean' name='[Include Transmission Time (copy) (copy)_810366517800452097]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
            </column>
            <column caption='Include Hold Back Time' datatype='boolean' name='[Include Transmission Time (copy)_810366517800443904]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
            </column>
            <column alias='None' caption='Granularity' datatype='string' name='[Parameter 10]' param-domain-type='list' role='measure' type='nominal' value='&quot;none&quot;'>
              <calculation class='tableau' formula='&quot;none&quot;' />
              <aliases>
                <alias key='&quot;daily&quot;' value='Daily' />
                <alias key='&quot;monthly&quot;' value='Monthly' />
                <alias key='&quot;none&quot;' value='None' />
                <alias key='&quot;quarterly&quot;' value='Quarterly' />
                <alias key='&quot;semiannually&quot;' value='Semiannually' />
                <alias key='&quot;weekly&quot;' value='Weekly' />
              </aliases>
            </column>
            <column caption='Include Transmission Time' datatype='boolean' name='[Parameter 13]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
            </column>
            <column alias='Minutes' caption='Unit' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;2&quot;'>
              <calculation class='tableau' formula='&quot;2&quot;' />
              <aliases>
                <alias key='&quot;1&quot;' value='Seconds' />
                <alias key='&quot;2&quot;' value='Minutes' />
              </aliases>
            </column>
            <column alias='Fulfilment Time' caption='Picker Time Metric' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;1&quot;'>
              <calculation class='tableau' formula='&quot;1&quot;' />
              <aliases>
                <alias key='&quot;0&quot;' value='Fulfilment Time Full' />
                <alias key='&quot;1&quot;' value='Fulfilment Time' />
                <alias key='&quot;2&quot;' value='Transmission Time' />
                <alias key='&quot;3&quot;' value='Hold Back Time' />
                <alias key='&quot;4&quot;' value='Started Time' />
                <alias key='&quot;5&quot;' value='Picking Time' />
                <alias key='&quot;7&quot;' value='Ready to Pickup Time' />
              </aliases>
            </column>
            <column caption='# of Periods' datatype='integer' default-format='N' name='[Parameter 4]' param-domain-type='range' role='measure' type='quantitative' value='7'>
              <calculation class='tableau' formula='7' />
              <range max='15' min='1' />
            </column>
            <column alias='In' caption='In / Out (Chain &amp; Vendor IDs Filters)' datatype='boolean' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
              <aliases>
                <alias key='false' value='Out' />
                <alias key='true' value='In' />
              </aliases>
            </column>
            <column caption='Chain IDs Filter' datatype='string' name='[Parameter 6]' param-domain-type='any' role='measure' type='nominal' value='&quot;&quot;'>
              <calculation class='tableau' formula='&quot;&quot;' />
            </column>
            <column caption='Avg Daily Order &gt;=' datatype='integer' name='[Parameter 7]' param-domain-type='range' role='measure' type='quantitative' value='0'>
              <calculation class='tableau' formula='0' />
              <range granularity='10' max='1000' min='0' />
            </column>
            <column alias='Order' caption='Times Measured by' datatype='string' name='[Parameter 9]' param-domain-type='list' role='measure' type='nominal' value='&quot;1&quot;'>
              <calculation class='tableau' formula='&quot;1&quot;' />
              <aliases>
                <alias key='&quot;1&quot;' value='Order' />
