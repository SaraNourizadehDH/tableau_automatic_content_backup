      <aliases enabled='yes' />
      <column caption='# Ordered Items by Picker per Hour' datatype='real' default-format='n#,##0;-#,##0' name='[# Orders by Picker per Hour (copy)_2934095208171499520]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;    (&#13;&#10;        SUM([in_cart_pelican_items] + [not_found_pelican_items] + [replaced_pelican_items] + [replacements_pelican_items] + [not_processed_pelican_items]) &#13;&#10;        / [Calculation_2721581600462766086]&#13;&#10;    ) / COUNTD([local_hour])&#13;&#10;)' />
      </column>
      <column caption='# of Vendors' datatype='integer' hidden='true' name='[Calculation_1273674322773577728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([vendor_id])' />
      </column>
      <column caption='Switch View' datatype='string' name='[Calculation_1273674323392266248]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 12] = &quot;1&quot; THEN &quot;1&quot; &#13;&#10;ELSEIF [Parameters].[Parameter 12] = &quot;2&quot; THEN &quot;2&quot; &#13;&#10;ELSEIF [Parameters].[Parameter 12] = &quot;3&quot; THEN &quot;3&quot; &#13;&#10;END' />
      </column>
      <column caption='Dynamic Field 1' datatype='string' name='[Calculation_129197067099435008]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='REPLACE(&#13;&#10;CASE [Parameters].[Parameter 11]&#13;&#10;WHEN &quot;0&quot; THEN &quot;&quot;&#13;&#10;WHEN &quot;1&quot; THEN STR([Calculation_2580844109258727425])&#13;&#10;WHEN &quot;2&quot; THEN STR([Calculation_2580844109639041047])&#13;&#10;WHEN &quot;3&quot; THEN STR([country])&#13;&#10;WHEN &quot;4&quot; THEN STR([city])&#13;&#10;WHEN &quot;5&quot; THEN STR([account_manager])&#13;&#10;WHEN &quot;6&quot; THEN STR([is_aaa_supermarket])&#13;&#10;WHEN &quot;7&quot; THEN STR([store_type_l1])&#13;&#10;WHEN &quot;8&quot; THEN STR([store_type_l2])&#13;&#10;WHEN &quot;17&quot; THEN STR([store_type_l3])&#13;&#10;WHEN &quot;9&quot; THEN STR([chain_name_adjusted])&#13;&#10;WHEN &quot;10&quot; THEN STR([Calculation_2934095208553451529])&#13;&#10;WHEN &quot;12&quot; THEN STR([contract_type])&#13;&#10;WHEN &quot;13&quot; THEN STR([has_replacements_in_last_30_days])&#13;&#10;WHEN &quot;14&quot; THEN STR([confirmed_orders_with_replacements])&#13;&#10;WHEN &quot;15&quot; THEN STR([is_preorder])&#13;&#10;WHEN &quot;16&quot; THEN STR([has_weighted_products])&#13;&#10;WHEN &quot;18&quot; THEN STR([has_scanned_items])&#13;&#10;END, &quot;_&quot;,&quot; &quot;)' />
      </column>
      <column caption='Date' datatype='string' name='[Calculation_2580844109258727425]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [granularity]&#13;&#10;WHEN &quot;daily&quot; THEN RIGHT(STR([local_date]), 5)&#13;&#10;WHEN &quot;weekly&quot; THEN RIGHT(STR([local_date]), 8)&#13;&#10;WHEN &quot;monthly&quot; THEN MID(STR([local_date]), 3, 5)&#13;&#10;WHEN &quot;quarterly&quot; THEN MID(STR([local_date]), 3, 5)&#13;&#10;ELSE STR([local_date])&#13;&#10;END' />
      </column>
      <column caption='Transmission Time' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_2580844109264052226]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 9] = &quot;1&quot; THEN&#13;&#10;    IF [Parameters].[Parameter 3] = &quot;1&quot; OR [Parameters].[Parameter 3] = &quot;2&quot; THEN&#13;&#10;        (SUM(IF [is_sent] AND [Parameters].[Parameter 13] THEN [transmission_time_s] ELSE 0 END)&#13;&#10;        / SUM(IF [is_sent] AND [Parameters].[Parameter 13] THEN [total_orders] ELSE 0 END))&#13;&#10;        / IF [Parameters].[Parameter 1] = &quot;1&quot; THEN 1 ELSE 60 END&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;ELSE&#13;&#10;    IF [Parameters].[Parameter 3] = &quot;1&quot; OR [Parameters].[Parameter 3] = &quot;2&quot; THEN&#13;&#10;        (SUM(IF [is_sent] AND [Parameters].[Parameter 13] THEN [transmission_time_s] ELSE 0 END)&#13;&#10;        / SUM(IF [is_sent] AND [Parameters].[Parameter 13] THEN [Calculation_2905947710943956992] ELSE 0 END))&#13;&#10;        / IF [Parameters].[Parameter 1] = &quot;1&quot; THEN 1 ELSE 60 END&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;END' />
      </column>
      <column caption='Fulfilment Time' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_2580844109336137748]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 9] = &quot;1&quot; THEN&#13;&#10;    IF [Parameters].[Parameter 3] = &quot;0&quot; THEN&#13;&#10;        (&#13;&#10;        (SUM(IF [is_sent] AND [Parameters].[Parameter 13] THEN [transmission_time_s] ELSE 0 END)&#13;&#10;        / SUM(IF [is_sent] THEN [total_orders] ELSE 0 END))&#13;&#10;     &#13;&#10;        +(SUM(IF [is_sent] AND [Parameters].[Include Transmission Time (copy)_810366517800443904] THEN [hold_time_s] ELSE 0 END)&#13;&#10;        / SUM(IF [is_sent] THEN [total_orders] ELSE 0 END)) &#13;&#10;&#13;&#10;        +(SUM(IF [is_sent] AND [Parameters].[Include Transmission Time (copy) (copy)_810366517800452097] THEN [started_time_s] ELSE 0 END)&#13;&#10;        / SUM(IF [is_sent] THEN [total_orders] ELSE 0 END)) &#13;&#10;&#13;&#10;        +(SUM(IF [is_sent] AND [Parameters].[Include Transmission Time (copy) (copy) (copy)_810366517800460290] THEN [picking_time_s] ELSE 0 END)&#13;&#10;        / SUM(IF [is_sent] THEN [total_orders] ELSE 0 END)) &#13;&#10;&#13;&#10;        +(SUM(IF [is_sent] AND [Parameters].[Include Transmission Time (copy) (copy) (copy) (copy)_810366517800480771] THEN [ready_to_pickup_time_s] ELSE 0 END)&#13;&#10;        / SUM(IF [is_sent] THEN [total_orders] ELSE 0 END)&#13;&#10;        ) &#13;&#10;&#13;&#10;        )/ IF [Parameters].[Parameter 1] = &quot;1&quot; THEN 1 ELSE 60 END&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;ELSE&#13;&#10;    IF [Parameters].[Parameter 3] = &quot;0&quot; THEN&#13;&#10;        (&#13;&#10;        (SUM(IF [is_sent] AND [Parameters].[Parameter 13] THEN [transmission_time_s] ELSE 0 END)&#13;&#10;        / SUM(IF [is_sent] THEN [Calculation_2905947710943956992] ELSE 0 END))&#13;&#10;     &#13;&#10;        +(SUM(IF [is_sent] AND [Parameters].[Include Transmission Time (copy)_810366517800443904] THEN [hold_time_s] ELSE 0 END)&#13;&#10;        / SUM(IF [is_sent] THEN [Calculation_2905947710943956992] ELSE 0 END)) &#13;&#10;&#13;&#10;        +(SUM(IF [is_sent] AND [Parameters].[Include Transmission Time (copy) (copy)_810366517800452097] THEN [started_time_s] ELSE 0 END)&#13;&#10;        / SUM(IF [is_sent] THEN [Calculation_2905947710943956992] ELSE 0 END)) &#13;&#10;&#13;&#10;        +(SUM(IF [is_sent] AND [Parameters].[Include Transmission Time (copy) (copy) (copy)_810366517800460290] THEN [picking_time_s] ELSE 0 END)&#13;&#10;        / SUM(IF [is_sent] THEN [Calculation_2905947710943956992] ELSE 0 END)) &#13;&#10;&#13;&#10;        +(SUM(IF [is_sent] AND [Parameters].[Include Transmission Time (copy) (copy) (copy) (copy)_810366517800480771] THEN [ready_to_pickup_time_s] ELSE 0 END)&#13;&#10;        / SUM(IF [is_sent] THEN [Calculation_2905947710943956992] ELSE 0 END)&#13;&#10;        ) &#13;&#10;&#13;&#10;        )/ IF [Parameters].[Parameter 1] = &quot;1&quot; THEN 1 ELSE 60 END&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;END' />
      </column>
      <column caption='Granularity Text' datatype='string' name='[Calculation_2580844109636452374]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [granularity]&#13;&#10;WHEN &quot;daily&quot; THEN &quot;Day&quot;&#13;&#10;WHEN &quot;weekly&quot; THEN &quot;Week&quot;&#13;&#10;WHEN &quot;monthly&quot; THEN &quot;Month&quot;&#13;&#10;WHEN &quot;quarterly&quot; THEN &quot;Quarter&quot;&#13;&#10;WHEN &quot;semiannually&quot; THEN &quot;Semester&quot;&#13;&#10;END' />
      </column>
      <column caption='Entity' datatype='string' name='[Calculation_2580844109639041047]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF LOWER([country]) = &quot;turkey&quot; THEN &quot;Yemeksepeti&quot; ELSE [management_entity] END' />
      </column>
      <column caption='# of Periods to Show Filter' datatype='boolean' name='[Calculation_2721581600030965763]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF INT([period_num]) &lt;= [Parameters].[Parameter 4] THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='granularity Filter' datatype='boolean' name='[Calculation_2721581600409817092]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [granularity] WHEN &quot;weekday&quot; THEN FALSE ELSE TRUE END' />
      </column>
      <column caption='# of Pickers' datatype='integer' name='[Calculation_2721581600462766086]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([picker_id])' />
      </column>
      <column caption='# Orders by Picker per Hour' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_2721581600494665744]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([confirmed_orders]) / [Calculation_2721581600462766086]) / COUNTD([local_hour])' />
      </column>
      <column caption='Pelican Items' datatype='real' name='[Calculation_2905947710943956992]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[in_cart_pelican_items] + [not_found_pelican_items] + [replaced_pelican_items] + [replacements_pelican_items] + [not_processed_pelican_items]' />
