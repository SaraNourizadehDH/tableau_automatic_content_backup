    <worksheet name='P. By Day and Hour'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontname='Tableau Medium'><![CDATA[<[Parameters].[Parameter 3]> (<[Parameters].[Parameter 1]> per <[Parameters].[Parameter 9]>) ]]></run>
            <run fontname='Tableau Medium'>by Weekday and Hour | Only for the last 4 Weeks </run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>(unchangeable date range)</run>
            <run>Æ&#10;</run>
            <run fontcolor='#555555' fontsize='9'>[Orders per Picker per Hour - Items Picked per Picker per Hour]</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='ls_ops_rt_fulfilment_time' name='federated.00hjioa1mi9lda132m1kj0cxud0u' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Vendor IDs Filter' datatype='string' name='[Chain IDs Filter (copy)_2934095208519184388]' param-domain-type='any' role='measure' type='nominal' value='&quot;&quot;'>
              <calculation class='tableau' formula='&quot;&quot;' />
            </column>
            <column caption='Include Ready to Pickup Time' datatype='boolean' name='[Include Transmission Time (copy) (copy) (copy) (copy)_810366517800480771]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
            </column>
            <column caption='Include Picking Time' datatype='boolean' name='[Include Transmission Time (copy) (copy) (copy)_810366517800460290]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
            </column>
            <column caption='Include Started Time' datatype='boolean' name='[Include Transmission Time (copy) (copy)_810366517800452097]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
            </column>
            <column caption='Include Hold Back Time' datatype='boolean' name='[Include Transmission Time (copy)_810366517800443904]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
            </column>
            <column alias='None' caption='Granularity' datatype='string' name='[Parameter 10]' param-domain-type='list' role='measure' type='nominal' value='&quot;none&quot;'>
              <calculation class='tableau' formula='&quot;none&quot;' />
              <aliases>
                <alias key='&quot;daily&quot;' value='Daily' />
                <alias key='&quot;monthly&quot;' value='Monthly' />
                <alias key='&quot;none&quot;' value='None' />
                <alias key='&quot;quarterly&quot;' value='Quarterly' />
                <alias key='&quot;semiannually&quot;' value='Semiannually' />
                <alias key='&quot;weekly&quot;' value='Weekly' />
              </aliases>
            </column>
            <column caption='Include Transmission Time' datatype='boolean' name='[Parameter 13]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
            </column>
            <column alias='Minutes' caption='Unit' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;2&quot;'>
              <calculation class='tableau' formula='&quot;2&quot;' />
              <aliases>
                <alias key='&quot;1&quot;' value='Seconds' />
                <alias key='&quot;2&quot;' value='Minutes' />
              </aliases>
            </column>
            <column alias='Fulfilment Time' caption='Picker Time Metric' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;1&quot;'>
              <calculation class='tableau' formula='&quot;1&quot;' />
              <aliases>
                <alias key='&quot;0&quot;' value='Fulfilment Time Full' />
                <alias key='&quot;1&quot;' value='Fulfilment Time' />
                <alias key='&quot;2&quot;' value='Transmission Time' />
                <alias key='&quot;3&quot;' value='Hold Back Time' />
                <alias key='&quot;4&quot;' value='Started Time' />
                <alias key='&quot;5&quot;' value='Picking Time' />
                <alias key='&quot;7&quot;' value='Ready to Pickup Time' />
              </aliases>
            </column>
            <column alias='In' caption='In / Out (Chain &amp; Vendor IDs Filters)' datatype='boolean' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
              <aliases>
                <alias key='false' value='Out' />
                <alias key='true' value='In' />
              </aliases>
            </column>
            <column caption='Chain IDs Filter' datatype='string' name='[Parameter 6]' param-domain-type='any' role='measure' type='nominal' value='&quot;&quot;'>
              <calculation class='tableau' formula='&quot;&quot;' />
            </column>
            <column caption='Avg Daily Order &gt;=' datatype='integer' name='[Parameter 7]' param-domain-type='range' role='measure' type='quantitative' value='0'>
              <calculation class='tableau' formula='0' />
              <range granularity='10' max='1000' min='0' />
            </column>
            <column alias='Order' caption='Times Measured by' datatype='string' name='[Parameter 9]' param-domain-type='list' role='measure' type='nominal' value='&quot;1&quot;'>
              <calculation class='tableau' formula='&quot;1&quot;' />
              <aliases>
                <alias key='&quot;1&quot;' value='Order' />
                <alias key='&quot;2&quot;' value='Item' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.00hjioa1mi9lda132m1kj0cxud0u'>
            <column caption='# Ordered Items by Picker per Hour' datatype='real' default-format='n#,##0;-#,##0' name='[# Orders by Picker per Hour (copy)_2934095208171499520]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;    (&#13;&#10;        SUM([in_cart_pelican_items] + [not_found_pelican_items] + [replaced_pelican_items] + [replacements_pelican_items] + [not_processed_pelican_items]) &#13;&#10;        / [Calculation_2721581600462766086]&#13;&#10;    ) / COUNTD([local_hour])&#13;&#10;)' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_2580844109258727425]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [granularity]&#13;&#10;WHEN &quot;daily&quot; THEN RIGHT(STR([local_date]), 5)&#13;&#10;WHEN &quot;weekly&quot; THEN RIGHT(STR([local_date]), 8)&#13;&#10;WHEN &quot;monthly&quot; THEN MID(STR([local_date]), 3, 5)&#13;&#10;WHEN &quot;quarterly&quot; THEN MID(STR([local_date]), 3, 5)&#13;&#10;ELSE STR([local_date])&#13;&#10;END' />
            </column>
            <column caption='Entity' datatype='string' name='[Calculation_2580844109639041047]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF LOWER([country]) = &quot;turkey&quot; THEN &quot;Yemeksepeti&quot; ELSE [management_entity] END' />
            </column>
            <column caption='# of Pickers' datatype='integer' name='[Calculation_2721581600462766086]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([picker_id])' />
            </column>
            <column caption='# Orders by Picker per Hour' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_2721581600494665744]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([confirmed_orders]) / [Calculation_2721581600462766086]) / COUNTD([local_hour])' />
            </column>
            <column caption='Pelican Items' datatype='real' name='[Calculation_2905947710943956992]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[in_cart_pelican_items] + [not_found_pelican_items] + [replaced_pelican_items] + [replacements_pelican_items] + [not_processed_pelican_items]' />
            </column>
            <column caption='Average Orders per Day' datatype='real' name='[Calculation_2934095208532836359]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([confirmed_orders])/MAX([num_of_days])' />
            </column>
            <column caption='More than x Order Filter' datatype='boolean' name='[Calculation_2934095208539262984]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;ROUND({ FIXED [Calculation_2580844109258727425], [Calculation_2934095208553451529] : [Calculation_2934095208532836359]}, 0)&#13;&#10;&gt;= [Parameters].[Parameter 7] THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Vendor Name' datatype='string' name='[Calculation_2934095208553451529]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[vendor_id] + &quot; - &quot; + [vendor_name]' />
            </column>
            <column caption='Chain Id Filter' datatype='boolean' name='[Calculation_2934095208586162186]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] THEN&#13;&#10;    IF [Parameters].[Parameter 6] != &quot;&quot; THEN&#13;&#10;        IF CONTAINS([Parameters].[Parameter 6], [chain_id]) THEN TRUE ELSE FALSE END&#13;&#10;        ELSE TRUE&#13;&#10;    END&#13;&#10;ELSE&#13;&#10;    IF [Parameters].[Parameter 6] != &quot;&quot; THEN&#13;&#10;        IF CONTAINS([Parameters].[Parameter 6], [chain_id]) THEN FALSE ELSE TRUE END&#13;&#10;        ELSE TRUE&#13;&#10;    END&#13;&#10;END' />
            </column>
            <column caption='Vendor Id Filter' datatype='boolean' name='[Calculation_2934095208586338315]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] THEN&#13;&#10;    IF [Parameters].[Chain IDs Filter (copy)_2934095208519184388] != &quot;&quot; THEN&#13;&#10;        IF CONTAINS([Parameters].[Chain IDs Filter (copy)_2934095208519184388], [vendor_id]) THEN TRUE ELSE FALSE END&#13;&#10;        ELSE TRUE&#13;&#10;    END&#13;&#10;ELSE&#13;&#10;    IF [Parameters].[Chain IDs Filter (copy)_2934095208519184388] != &quot;&quot; THEN&#13;&#10;        IF CONTAINS([Parameters].[Chain IDs Filter (copy)_2934095208519184388], [vendor_id]) THEN FALSE ELSE TRUE END&#13;&#10;        ELSE TRUE&#13;&#10;    END&#13;&#10;END' />
            </column>
            <column caption='Ordered Items' datatype='real' name='[Calculation_599823231750098945]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([in_cart_pelican_items] + [not_found_pelican_items] + [replaced_pelican_items] + [replacements_pelican_items] + [not_processed_pelican_items])' />
