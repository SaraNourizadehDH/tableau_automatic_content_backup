      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1oljgb51y8ybir1g89co30w0y1z8].[pcto:usr:Calculation_4380876591505035269:qk]&quot;' value='Loss GMV due Not Found $ (Share)' />
          <alias key='&quot;[federated.1oljgb51y8ybir1g89co30w0y1z8].[pcto:usr:Calculation_4380876591878647827:qk:1]&quot;' value='% Share' />
          <alias key='&quot;[federated.1oljgb51y8ybir1g89co30w0y1z8].[sum:confirmed_orders:qk]&quot;' value='Orders with this Item' />
          <alias key='&quot;[federated.1oljgb51y8ybir1g89co30w0y1z8].[usr:Calculation_4380876591505035269:qk]&quot;' value='Loss GMV due Not Found $' />
          <alias key='&quot;[federated.1oljgb51y8ybir1g89co30w0y1z8].[usr:Calculation_4380876591506259974:qk]&quot;' value='Loss GMV due to Not Found %' />
          <alias key='&quot;[federated.1oljgb51y8ybir1g89co30w0y1z8].[usr:Calculation_4380876591878647827:qk]&quot;' value='# of Products' />
        </aliases>
      </column>
      <column caption='Fill Rate' datatype='real' default-format='p0.0%' name='[Calculation_4380876591471239169]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_sent] and LOWER([vendor_app]) = &apos;pelican&apos; THEN [item_qty_sold] ELSE NULL END)&#10;/SUM(IF [is_sent] and LOWER([vendor_app]) = &apos;pelican&apos; THEN [item_qty_ordered] ELSE NULL END)' />
      </column>
      <column caption='Unit Price Listed' datatype='real' name='[Calculation_4380876591497289730]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;EUR&quot; THEN [unit_price_listed_eur] ELSE [unit_price_listed_lc] END' />
      </column>
      <column aggregation='Sum' caption='Product Name LEN' datatype='integer' name='[Calculation_4380876591501275140]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='LEN([product_name])' />
      </column>
      <column caption='Loss GMV due to OOS #' datatype='real' name='[Calculation_4380876591505035269]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Unit Price Listed (copy)_4380876591497469955]) * (SUM([item_qty_ordered]) - SUM([item_qty_sold]))' />
      </column>
      <column caption='Loss GMV due to OOS %' datatype='real' default-format='p0.0%' name='[Calculation_4380876591506259974]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_4380876591505035269] / SUM([item_qty_ordered] * [Unit Price Listed (copy)_4380876591497469955])' />
      </column>
      <column caption='Picking App' datatype='string' name='[Calculation_4380876591556268042]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF UPPER([vendor_app]) = &apos;GODROID&apos; THEN &apos;GoDroid&apos;&#10;ELSEIF UPPER([integration_pos_type]) = &apos;POS_INDIRECT_INTEGRATED&apos; THEN &apos;POS Indirect&apos; &#10;ELSEIF UPPER([integration_pos_type]) = &apos;POS_DIRECT_INTEGRATED&apos; THEN &apos;POS Direct&apos;  &#10;ELSE &apos;Pelican&apos; &#10;END' />
      </column>
      <column caption='Entity' datatype='string' name='[Calculation_4380876591790735371]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [brand] = &apos;Yemeksepeti&apos; THEN &apos;Yemeksepeti&apos; ELSE [management_entity] END' />
      </column>
      <column caption='Count of Products' datatype='integer' name='[Calculation_4380876591878647827]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([product_name])' />
      </column>
      <column caption='Date Month' datatype='date' datatype-customized='true' name='[Calculation_4380876591931355161]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;,[local_date]))' />
      </column>
      <column caption='Show Tables' datatype='boolean' name='[Calculation_6958624428851769346]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='If [Parameters].[Parameter 3] = True THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Count Chains' datatype='integer' name='[Calculation_6958624428856254468]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [country], [chain_name (fulfilment_ops_ls_vendors)] : COUNTD([chain_name]) }&#10;//IF SUM({ FIXED [Country], [Chain Name] : COUNTD([Chain Name]) }) &gt; 1 THEN FALSE ELSE TRUE END' />
      </column>
      <column caption='Not Found Rate' datatype='real' default-format='p0.0%' name='[Fill Rate (copy)_4380876591841337358]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - (SUM([item_qty_sold])/SUM([item_qty_ordered]))' />
      </column>
      <column caption='Not Found Rate per Product' datatype='string' default-format='n#,##0.0;-#,##0.0' name='[Not Found Rate (copy)_4380876591868846096]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED &#10;DATETRUNC(&apos;month&apos;,[local_date])&#10;, [country]&#10;, [chain_name (fulfilment_ops_ls_vendors)]&#10;, [vendor_name (fulfilment_ops_ls_vendors)]&#10;, [product_name]&#10;, [order_status]&#10;: STR(ROUND(1 - ((SUM([item_qty_sold])/SUM([item_qty_ordered]))), 2))}' />
      </column>
      <column caption='Not Found Rate per Product (copy) (copy)' datatype='string' default-format='n#,##0.0;-#,##0.0' name='[Not Found Rate per Product (copy) (copy)_6958624428828569600]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED &#10;DATETRUNC(&apos;month&apos;,[local_date])&#10;, [country]&#10;, [chain_name (fulfilment_ops_ls_vendors)]&#10;, [vendor_name (fulfilment_ops_ls_vendors)]&#10;, [product_name]&#10;, [order_status]&#10;: STR(SUM([item_qty_sold]))}' />
      </column>
      <column caption='Not Found Rate per Product (filter)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Not Found Rate per Product (copy)_4380876591902838805]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='{ INCLUDE [product_name] : (ROUND((ROUND(1 - IFNULL((SUM([item_qty_sold])/SUM([item_qty_ordered])),1), 2) * 10),1))}' />
      </column>
      <column caption='Not Found Rate per Product (copy)' datatype='string' default-format='n#,##0.0;-#,##0.0' name='[Not Found Rate per Product (copy)_4380876591928737816]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED &#10;DATETRUNC(&apos;month&apos;,[local_date])&#10;, [country]&#10;, [chain_name (fulfilment_ops_ls_vendors)]&#10;, [vendor_name (fulfilment_ops_ls_vendors)]&#10;, [product_name]&#10;, [order_status]&#10;: STR(SUM([item_qty_ordered]))}' />
      </column>
