    <worksheet name='Items per Vendor'>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_sku_analytics_for_ls_v2 (dev_dmart)' name='federated.1oljgb51y8ybir1g89co30w0y1z8' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;EUR&quot;'>
              <calculation class='tableau' formula='&quot;EUR&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1oljgb51y8ybir1g89co30w0y1z8'>
            <column aggregation='Sum' caption='Product Name LEN' datatype='integer' name='[Calculation_4380876591501275140]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='LEN([product_name])' />
            </column>
            <column caption='Loss GMV due to OOS #' datatype='real' name='[Calculation_4380876591505035269]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Unit Price Listed (copy)_4380876591497469955]) * (SUM([item_qty_ordered]) - SUM([item_qty_sold]))' />
            </column>
            <column caption='Picking App' datatype='string' name='[Calculation_4380876591556268042]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF UPPER([vendor_app]) = &apos;GODROID&apos; THEN &apos;GoDroid&apos;&#10;ELSEIF UPPER([integration_pos_type]) = &apos;POS_INDIRECT_INTEGRATED&apos; THEN &apos;POS Indirect&apos; &#10;ELSEIF UPPER([integration_pos_type]) = &apos;POS_DIRECT_INTEGRATED&apos; THEN &apos;POS Direct&apos;  &#10;ELSE &apos;Pelican&apos; &#10;END' />
            </column>
            <column caption='Entity' datatype='string' name='[Calculation_4380876591790735371]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [brand] = &apos;Yemeksepeti&apos; THEN &apos;Yemeksepeti&apos; ELSE [management_entity] END' />
            </column>
            <column caption='Count Chains' datatype='integer' name='[Calculation_6958624428856254468]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [country], [chain_name (fulfilment_ops_ls_vendors)] : COUNTD([chain_name]) }&#10;//IF SUM({ FIXED [Country], [Chain Name] : COUNTD([Chain Name]) }) &gt; 1 THEN FALSE ELSE TRUE END' />
            </column>
            <column caption='Not Found Rate' datatype='real' default-format='p0.0%' name='[Fill Rate (copy)_4380876591841337358]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - (SUM([item_qty_sold])/SUM([item_qty_ordered]))' />
            </column>
            <column caption='Unit Price Paid' datatype='real' name='[Unit Price Listed (copy)_4380876591497469955]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;EUR&quot; THEN [unit_price_paid_eur] ELSE [unit_price_paid_lc] END' />
            </column>
            <column caption='Acc Manager' datatype='string' name='[acc_manager]' role='dimension' type='nominal' />
            <column-instance column='[barcodes]' derivation='Attribute' name='[attr:barcodes:nk]' pivot='key' type='nominal' />
            <column caption='Barcodes' datatype='string' name='[barcodes]' role='dimension' type='nominal' />
            <column caption='Brand' datatype='string' name='[brand]' role='dimension' type='nominal' />
            <column caption='Brand Name' datatype='string' name='[brand_name]' role='dimension' type='nominal' />
            <column caption='Chain Name (Fulfilment Ops Ls Vendors)' datatype='string' name='[chain_name (fulfilment_ops_ls_vendors)]' role='dimension' type='nominal' />
            <column caption='Chain Name' datatype='string' name='[chain_name]' role='dimension' type='nominal' />
            <column caption='City' datatype='string' name='[city]' role='dimension' semantic-role='' type='nominal' />
            <column caption='Confirmed Orders' datatype='integer' name='[confirmed_orders]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='' type='nominal' />
            <column caption='Integration Pos Type' datatype='string' name='[integration_pos_type]' role='dimension' type='nominal' />
            <column caption='is fresh SKU' datatype='boolean' name='[is_fresh_SKU]' role='dimension' type='nominal' />
