              <calculation class='tableau' formula='IF UPPER([vendor_app]) = &apos;GODROID&apos; THEN &apos;GoDroid&apos;&#10;ELSEIF UPPER([integration_pos_type]) = &apos;POS_INDIRECT_INTEGRATED&apos; THEN &apos;POS Indirect&apos; &#10;ELSEIF UPPER([integration_pos_type]) = &apos;POS_DIRECT_INTEGRATED&apos; THEN &apos;POS Direct&apos;  &#10;ELSE &apos;Pelican&apos; &#10;END' />
            </column>
            <column caption='Entity' datatype='string' name='[Calculation_4380876591790735371]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [brand] = &apos;Yemeksepeti&apos; THEN &apos;Yemeksepeti&apos; ELSE [management_entity] END' />
            </column>
            <column caption='Count of Products' datatype='integer' name='[Calculation_4380876591878647827]' role='measure' type='quantitative'>
