              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;&#10;    WHEN &quot;quarter&quot; THEN MID(STR(DATE(DATETRUNC(&apos;quarter&apos;,[local_date]))),3,LEN(STR(DATE(DATETRUNC(&apos;quarter&apos;,[local_date]))))-5)&#10;    WHEN &quot;month&quot; THEN MID(STR(DATE(DATETRUNC(&apos;month&apos;,[local_date]))),3,LEN(STR(DATE(DATETRUNC(&apos;month&apos;,[local_date]))))-5)&#10;    WHEN &quot;week&quot; THEN MID(STR(DATE(DATETRUNC(&apos;week&apos;,[local_date]))),3,LEN(STR(DATE(DATETRUNC(&apos;week&apos;,[local_date]))))-0)&#10;    WHEN &quot;day&quot; THEN MID(STR(DATE(DATETRUNC(&apos;day&apos;,[local_date]))),3,LEN(STR(DATE(DATETRUNC(&apos;day&apos;,[local_date]))))-0)&#10;&#10;END' />
