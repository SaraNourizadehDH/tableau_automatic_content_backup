            <column caption='Master Category Parent English' datatype='string' name='[master_category_parent_english]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2696037751860756487]' derivation='None' name='[none:Calculation_2696037751860756487:nk]' pivot='key' type='nominal' />
