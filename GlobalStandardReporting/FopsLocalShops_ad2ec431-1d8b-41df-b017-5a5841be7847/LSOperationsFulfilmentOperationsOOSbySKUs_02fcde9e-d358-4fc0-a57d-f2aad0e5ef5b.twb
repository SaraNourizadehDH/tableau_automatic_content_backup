    <worksheet name='Title'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#cc061e' fontname='Tableau Book' fontsize='26'>Out of Stock Analytics</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='true' fontalignment='1' fontcolor='#1b1b1b' fontname='Tableau Book' fontsize='14'>&lt;[Parameters].[Parameter 2]&gt;</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='true' fontalignment='1' fontcolor='#898989' fontname='Tableau Book' fontsize='10'><![CDATA[<[federated.19c7j48011z3sc12x8anw1fchkp6].[none:KPI (copy)_644577764205858816:nk]>]]></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_sku_analytics_for_ls (cl_dmart)' name='federated.19c7j48011z3sc12x8anw1fchkp6' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Dynamic Dimension Full' datatype='string' name='[Dynamic Dimension (copy)_1336795098794364929]' param-domain-type='list' role='measure' type='nominal' value='&quot;Entity&quot;'>
              <calculation class='tableau' formula='&quot;Entity&quot;' />
              <aliases>
                <alias key='&quot;Last Source of Update (grouped)&quot;' value='Last Source of Update (grouped)' />
                <alias key='&quot;Nr Days Job (grouped)&quot;' value='Nr Days Job (grouped)' />
              </aliases>
            </column>
            <column alias='Week' caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
              <calculation class='tableau' formula='&quot;week&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Day' />
                <alias key='&quot;month&quot;' value='Month' />
                <alias key='&quot;quarter&quot;' value='Quarter' />
                <alias key='&quot;week&quot;' value='Week' />
              </aliases>
            </column>
            <column caption='Selected KPI' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;\# of ordered SKUs&quot;'>
              <calculation class='tableau' formula='&quot;# of ordered SKUs&quot;' />
              <aliases>
                <alias key='&quot;$ GMV (delivered SKUs)&quot;' value='$ GBV (delivered SKUs)' />
                <alias key='&quot;$ GMV (ordered SKUs)&quot;' value='$ GBV (ordered SKUs)' />
                <alias key='&quot;$ GMV (sold SKUs)&quot;' value='$ GBV (sold SKUs)' />
              </aliases>
            </column>
            <column caption='Product Name Language' datatype='string' name='[Parameter 7]' param-domain-type='list' role='measure' type='nominal' value='&quot;English&quot;'>
              <calculation class='tableau' formula='&quot;English&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.19c7j48011z3sc12x8anw1fchkp6'>
            <column caption='NR Days Job Grouped' datatype='string' name='[Calculation_1336795098457948160]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [nr_days_jobs_active_update_product] &lt; 1 THEN &apos;0&apos;&#10;    ELSEIF [nr_days_jobs_active_update_product] &lt;= 10 THEN &apos;1 - 10&apos;&#10;        ELSEIF [nr_days_jobs_active_update_product] &lt;= 20 THEN &apos;10 - 20&apos;&#10;            ELSEIF [nr_days_jobs_active_update_product] &lt;= 30 THEN &apos;20 - 30&apos;&#10;                ELSEIF [nr_days_jobs_active_update_product] = 31 THEN &apos;31&apos;END' />
            </column>
            <column caption='Product Name Dynamic' datatype='string' name='[Calculation_1765903702981738497]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#10;WHEN &apos;English&apos; THEN [product_name] ELSE [product_name_local] END' />
            </column>
            <column caption='City Ajusted' datatype='string' name='[Calculation_2262284824446779392]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='UPPER([country_code])+&apos; - &apos;+[city]' />
            </column>
            <column caption='Date' datatype='string' datatype-customized='true' name='[Calculation_2696037751860756487]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;&#10;    WHEN &quot;quarter&quot; THEN MID(STR(DATE(DATETRUNC(&apos;quarter&apos;,[local_date]))),3,LEN(STR(DATE(DATETRUNC(&apos;quarter&apos;,[local_date]))))-5)&#10;    WHEN &quot;month&quot; THEN MID(STR(DATE(DATETRUNC(&apos;month&apos;,[local_date]))),3,LEN(STR(DATE(DATETRUNC(&apos;month&apos;,[local_date]))))-5)&#10;    WHEN &quot;week&quot; THEN MID(STR(DATE(DATETRUNC(&apos;week&apos;,[local_date]))),3,LEN(STR(DATE(DATETRUNC(&apos;week&apos;,[local_date]))))-0)&#10;    WHEN &quot;day&quot; THEN MID(STR(DATE(DATETRUNC(&apos;day&apos;,[local_date]))),3,LEN(STR(DATE(DATETRUNC(&apos;day&apos;,[local_date]))))-0)&#10;&#10;END' />
            </column>
            <column caption='has_barcode' datatype='boolean' name='[Calculation_6007450122175467544]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [barcodes]&#10;&#10;    WHEN NULL THEN FALSE&#10;&#10;    ELSE TRUE&#10;&#10;END' />
            </column>
            <column caption='Is a Complete Time Period' datatype='boolean' name='[Calculation_6007450122181996570]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[local_date] &lt; {MAX(DATETRUNC([Parameters].[Parameter 1],[local_date]))}' />
            </column>
            <column caption='User Entitlement' datatype='boolean' name='[Calculation_6578351687994761216]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[username] = USERNAME()' />
            </column>
            <column caption='Pelican Status Ajusted' datatype='string' name='[Calculation_824369903072198657]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;    ISNULL([pelican_status]) AND [item_qty_sold] = [item_qty_ordered] &#10;        THEN &apos;IN_CART&apos; &#10;        ELSE &#10;            If ISNULL([pelican_status]) &#10;                THEN &apos;NOT_PROCESSED&apos;&#10;                ELSE [pelican_status]&#10;            END&#10;END' />
            </column>
            <column caption='Dynamic Dimension Full' datatype='string' name='[Dynamic Dimension (copy)_1336795098794819586]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Dynamic Dimension (copy)_1336795098794364929]&#10;&#10;    WHEN &apos;Region&apos;&#10;    THEN [region]&#10;&#10;    WHEN &apos;Entity&apos;&#10;    THEN [entity]&#10;&#10;    WHEN &apos;Country&apos;&#10;    THEN [country_name]&#10;&#10;    WHEN &apos;City&apos;&#10;    THEN [city]&#10;&#10;    WHEN &apos;Weekday&apos;&#10;    THEN [order_Weekday]&#10;&#10;    WHEN &apos;Is Weekend&apos;&#10;    THEN STR([is_weekend])&#10;&#10;    WHEN &apos;Vendor Type 1&apos;&#10;    THEN [store_type_l1]&#10;&#10;    WHEN &apos;Vendor Type 2&apos;&#10;    THEN [store_type_l2]&#10;&#10;    WHEN &apos;Product Category&apos;&#10;    THEN [Master Category Parent English (group)]&#10;&#10;    WHEN &apos;Pelican Status&apos;&#10;    THEN [Calculation_824369903072198657]&#10;&#10;    WHEN &apos;Has Barcode&apos;&#10;    THEN STR([Calculation_6007450122175467544])&#10;&#10;    WHEN &apos;Failure Owner&apos;&#10;    THEN [failure_owner]&#10;&#10;    WHEN &apos;Payment Type&apos;&#10;    THEN [payment_type]&#10;&#10;    WHEN &apos;Nr Days Job (grouped)&apos;&#10;    THEN [Calculation_1336795098457948160]&#10;&#10;    //WHEN &apos;Last Source of Update (grouped)&apos;&#10;    //THEN [last_source_of_upload (group)]&#10;&#10;    WHEN &apos;Is Confirmed Checkout&apos;&#10;    THEN STR([is_checkout_confirmed])&#10;&#10;    WHEN &apos;Is Modified Quantity&apos;&#10;    THEN STR([is_modified_quantity])&#10;&#10;    WHEN &apos;Is Cancelled&apos;&#10;    THEN STR([is_cancelled])&#10;&#10;    WHEN &apos;Is Failed&apos;&#10;    THEN STR([is_failed])&#10;&#10;    WHEN &apos;Is Failed Before Transaction&apos;&#10;    THEN STR([is_failed_before_transmission])&#10;&#10;    WHEN &apos;Is Own Delivery&apos;&#10;    THEN STR([is_own_delivery])&#10;&#10;    WHEN &apos;Is Preorder&apos;&#10;    THEN STR([is_preorder])&#10;&#10;    WHEN &apos;Is Voucher&apos;&#10;    THEN STR([is_voucher])&#10;&#10;    WHEN &apos;Is Modified Order&apos;&#10;    THEN STR([is_modified_order])&#10;&#10;END' />
            </column>
            <column caption='KPI description' datatype='string' name='[KPI (copy)_644577764205858816]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;&#10;        WHEN &apos;# of orders&apos;&#10;        THEN &apos;is the COUNT of unique orders_id in the dataset.&apos;&#10;&#10;        WHEN &apos;# of ordered SKUs&apos;&#10;        THEN &apos;is the SUM of items ordered&apos;&#10;&#10;        WHEN &apos;# of delivered SKUs&apos;&#10;        THEN &apos;is the SUM of items delivered&apos;&#10;&#10;        WHEN &apos;# of sold SKUs&apos;&#10;        THEN &apos;is the SUM of items sold&apos;&#10;&#10;        WHEN &apos;# SKUs (sold - ordered)&apos;&#10;        THEN &apos;is the difference between sold SKUs and ordered SKUs&apos;&#10;&#10;        WHEN &apos;# SKUs (sold - delivered)&apos;&#10;        THEN &apos;is the difference between sold SKUs and delivered SKUs&apos;&#10;&#10;        WHEN &apos;% SKUs (sold / ordered)&apos;&#10;        THEN &apos;is the % of sold SKUs over the total ordered SKUs&apos;&#10;&#10;        WHEN &apos;% SKUs (sold / delivered)&apos;&#10;        THEN &apos;is the % of sold SKUs over the total delivered SKUs&apos;&#10;&#10;        WHEN &apos;$ GMV (ordered SKUs)&apos;&#10;        THEN &apos;is the SUM of the GBV of the ordered SKUs&apos;&#10;&#10;        WHEN &apos;$ GMV (delivered SKUs)&apos;&#10;        THEN &apos;is the SUM of the GBV of the delivered SKUs&apos;&#10;&#10;        WHEN &apos;$ GMV (sold SKUs)&apos;&#10;        THEN &apos;is the SUM of the GBV of the sold SKUs&apos;&#10;&#10;        WHEN &apos;$ GMV (sold - ordered)&apos;&#10;        THEN &apos;is the difference between the GBV of sold SKUs and ordered SKUs&apos;&#10;&#10;        WHEN &apos;$ GMV (sold - delivered)&apos;&#10;        THEN &apos;is the difference between the GBV of sold SKUs and delivered SKUs&apos;&#10;&#10;        WHEN &apos;% GMV (sold / ordered)&apos;&#10;        THEN &apos;is the % of sold GBV over the total GBV ordered&apos;&#10;&#10;        WHEN &apos;% GMV (sold / delivered)&apos;&#10;        THEN &apos;is the % of sold GBV over the total GBV delivered&apos;&#10;&#10;    END' />
            </column>
            <column datatype='string' name='[Master Category Parent English (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[master_category_parent_english]' new-bin='true'>
                <bin default-name='true' value='&quot;Atıştırmalıklar &amp; Snacks&quot;'>
                  <value>&quot;Atıştırmalıklar&quot;</value>
                  <value>&quot;Snacks&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Home / Pet&quot;'>
                  <value>&quot;Ev / Evcil Hayvan&quot;</value>
                  <value>&quot;Home / Pet&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Others&quot;'>
                  <value>%null%</value>
                </bin>
              </calculation>
            </column>
