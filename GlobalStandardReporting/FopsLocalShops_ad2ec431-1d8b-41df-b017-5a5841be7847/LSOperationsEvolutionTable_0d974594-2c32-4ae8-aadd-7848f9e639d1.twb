            <column caption='Date' datatype='date' name='[Calculation_1279022341663531008]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3] &#13;&#10;WHEN &quot;Weekly&quot; THEN [report_week]&#13;&#10;WHEN &quot;Quarterly&quot; then [report_quarter]&#13;&#10;ELSE [report_month]&#13;&#10;END' />
