          <datasource-dependencies datasource='federated.1kilve60d9a8mv142ar8q0rpkclw'>
            <column caption='% Pelican Vendors (over Active)' datatype='real' default-format='p0.0%' name='[% Pelican Orders (copy)_1409908200077238272]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(CASE [is_pelican] WHEN TRUE THEN [vendor_id] END)/[Online Vendors (copy)_631911363457712133]' />
            </column>
            <column caption='Pelican Total Orders' datatype='integer' default-format='p0.0%' name='[% Pelican Orders (copy)_1715308528265842691]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(CASE  [is_pelican] WHEN TRUE THEN [total_orders] ELSE 0 END)' />
            </column>
            <column caption='ABV Gross (gross of VAT)' datatype='real' default-format='c#,##0.00&quot; €&quot;;-#,##0.00&quot; €&quot;' name='[APV Gross (gross of VAT) (copy)_1053560845601157120]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gbv_gross_of_vat_2])/SUM([confirmed_orders])' />
            </column>
            <column caption='Avg. Picking Time' datatype='real' default-format='n#,##0.0&quot;&apos;&quot;;-#,##0.0&quot;&apos;&quot;' name='[AVG DT (copy)_1053560845755940892]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([picking_time_seconds])/SUM([has_picking_time_orders])/60' />
            </column>
            <column caption='% Orders w/ Delivery Time &gt;45&apos;' datatype='real' default-format='p0.00%' name='[Avg Delivery Time (copy)_1053560845816639522]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders_dt_higher_45])&#13;&#10;/&#13;&#10;sum([confirmed_orders])' />
            </column>
            <column caption='Avg. Realized DF' datatype='real' default-format='c#,##0.00&quot; €&quot;;-#,##0.00&quot; €&quot;' name='[Avg. Nominal DF (copy)_915638144251662338]' role='measure' type='quantitative'>
