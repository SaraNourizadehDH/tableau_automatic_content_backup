    <worksheet name='TabSLP'>
      <table>
        <view>
          <datasources>
            <datasource caption='Queries' name='federated.1kilve60d9a8mv142ar8q0rpkclw' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Periodicity' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1kilve60d9a8mv142ar8q0rpkclw'>
            <column caption='% Pelican Vendors (over Active)' datatype='real' default-format='p0.0%' name='[% Pelican Orders (copy)_1409908200077238272]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(CASE [is_pelican] WHEN TRUE THEN [vendor_id] END)/[Online Vendors (copy)_631911363457712133]' />
            </column>
            <column caption='% Churned' datatype='real' default-format='p0.0%' name='[% Zombies (copy)_915638144269328394]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[New Online Vendors (copy)_915638144251207681]/[Calculation_631911363457060868]' />
            </column>
            <column caption='DF (% of Food)' datatype='real' default-format='p0.0%' name='[ABV (% of Food) (copy)_1117737142140084238]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1118863095866163205]/[ABV Gross (gross of VAT) - Food (copy)_1117737142114504706]' />
            </column>
            <column caption='ABV (% of DMart)' datatype='real' default-format='p0.0%' name='[ABV (% of Food) (copy)_631911363453644800]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[APV Gross (gross of VAT) (copy)_1053560845601157120]/[ABV Gross (gross of VAT) - Food (copy)_631911363453759489]' />
            </column>
            <column caption='Items per Order (% of DMart)' datatype='real' default-format='p0.0%' name='[ABV (% of Food) (copy)_915638144252461061]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1118863095866515462]/[ABV Gross (gross of VAT) - DMart (copy)_915638144252276740]' />
            </column>
            <column caption='Avg. Items per Order - DMart' datatype='real' default-format='p0.0%' name='[ABV Gross (gross of VAT) - DMart (copy)_915638144252276740]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ds_quantity])/sum([ds_orders])' />
            </column>
            <column caption='DF Gross (gross of VAT) - Food' datatype='real' name='[ABV Gross (gross of VAT) - Food (copy)_1117737142114504706]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([food_delivery_fee])/sum([food_w_df_orders])' />
            </column>
            <column caption='ABV Gross (gross of VAT) - DMart' datatype='real' default-format='p0.0%' name='[ABV Gross (gross of VAT) - Food (copy)_631911363453759489]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ds_gbv])/sum([ds_orders])' />
            </column>
            <column caption='ABV Gross (gross of VAT)' datatype='real' default-format='c#,##0.00&quot; €&quot;;-#,##0.00&quot; €&quot;' name='[APV Gross (gross of VAT) (copy)_1053560845601157120]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gbv_gross_of_vat_2])/SUM([confirmed_orders])' />
            </column>
            <column caption='Avg. Picking Time' datatype='real' default-format='n#,##0.0&quot;&apos;&quot;;-#,##0.0&quot;&apos;&quot;' name='[AVG DT (copy)_1053560845755940892]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([picking_time_seconds])/SUM([has_picking_time_orders])/60' />
            </column>
            <column caption='% Orders w/ Delivery Time &gt;45&apos;' datatype='real' default-format='p0.00%' name='[Avg Delivery Time (copy)_1053560845816639522]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders_dt_higher_45])&#13;&#10;/&#13;&#10;sum([confirmed_orders])' />
            </column>
            <column caption='Avg. Realized DF' datatype='real' default-format='c#,##0.00&quot; €&quot;;-#,##0.00&quot; €&quot;' name='[Avg. Nominal DF (copy)_915638144251662338]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([df])/sum([confirmed_orders])' />
            </column>
            <column caption='Blank (copy) (copy) (copy)' datatype='integer' name='[Blank (copy) (copy) (copy)_1093811783884279811]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(NULL)' />
            </column>
            <column caption='Blank (copy) (copy)' datatype='integer' name='[Blank (copy) (copy)_1093811783884259330]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(NULL)' />
            </column>
            <column caption='Blank (copy)' datatype='integer' name='[Blank (copy)_1093811783883096064]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(NULL)' />
            </column>
            <column caption='Customers' datatype='integer' name='[COMMERCIAL (copy)_467248484820471824]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(NULL)' />
            </column>
            <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN([Avg. Nominal DF (copy)_915638144251662338]) - LOOKUP(ZN([Avg. Nominal DF (copy)_915638144251662338]), -1)) / ABS(LOOKUP(ZN([Avg. Nominal DF (copy)_915638144251662338]), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='real' default-format='p0.00%' name='[Calculation3]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN([AVG DT (copy)_1053560845755940892]) - LOOKUP(ZN([AVG DT (copy)_1053560845755940892]), -1)) / ABS(LOOKUP(ZN([AVG DT (copy)_1053560845755940892]), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='GMV Gross (gross of VAT) (old)' datatype='real' default-format='c#,##0&quot; €&quot;;-#,##0&quot; €&quot;' name='[Calculation_1053560845626101763]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gbv_gross_of_vat_2])+SUM([df])' />
