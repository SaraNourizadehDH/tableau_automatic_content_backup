      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Queries' name='federated.1kilve60d9a8mv142ar8q0rpkclw' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Periodicity' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1kilve60d9a8mv142ar8q0rpkclw'>
            <column caption='ABV Gross (gross of VAT)' datatype='real' default-format='c#,##0.00&quot; €&quot;;-#,##0.00&quot; €&quot;' name='[APV Gross (gross of VAT) (copy)_1053560845601157120]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gbv_gross_of_vat_2])/SUM([confirmed_orders])' />
            </column>
            <column caption='GMV Gross (gross of VAT) (old)' datatype='real' default-format='c#,##0&quot; €&quot;;-#,##0&quot; €&quot;' name='[Calculation_1053560845626101763]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gbv_gross_of_vat_2])+SUM([df])' />
            </column>
            <column caption='Avg. Items per Order' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1118863095866515462]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([qty_sold])/SUM([confirmed_orders])' />
            </column>
            <column caption='Date' datatype='date' name='[Calculation_1279022341663531008]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3] &#13;&#10;WHEN &quot;Weekly&quot; THEN [report_week]&#13;&#10;WHEN &quot;Quarterly&quot; then [report_quarter]&#13;&#10;ELSE [report_month]&#13;&#10;END' />
            </column>
            <column caption='IS API' datatype='string' name='[Calculation_1361775992800034816]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [is_api] WHEN &apos;API&apos; THEN &apos;API&apos; ELSE &apos;NON API&apos; END' />
            </column>
            <column caption='Partial Fulfillment (new)' datatype='real' name='[Calculation_1715308528772108298]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([is_partially_fulfilled])/[Pelican Total Orders (copy)_1715308528267173893]' />
            </column>
            <column caption='Items Replaced Rate' datatype='real' name='[Calculation_1715308528773804044]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([has_replacements])/[Pelican Total Orders (copy)_1715308528267173893]' />
            </column>
            <column caption='GBV OOS Failure Loss' datatype='real' name='[Calculation_1715308528784728080]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gbv_partial_fulfillment_loss_eur]) + SUM([gbv_failed_oos_loss])' />
            </column>
            <column caption='OOS GBV Loss Rate' datatype='real' name='[Calculation_1715308528788381713]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1715308528784728080]/SUM([gbv_gross_of_vat_2])' />
            </column>
            <column caption='SFTP' datatype='string' name='[Calculation_4516266047899996160]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [is_sftp]&#13;&#10;WHEN 1 THEN &quot;SFTP&quot;&#13;&#10;ELSE &quot;NON-SFTP&quot;&#13;&#10;END' />
            </column>
            <column caption='Partial Fulfillment' datatype='real' default-format='p0.0%' name='[Calculation_915638144269778956]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([partial_orders])/[Pelican Total Orders (copy)_1715308528267173893]' />
            </column>
            <column caption='Vendor Fail Rate' datatype='real' default-format='p0.00%' name='[Fail Rate (copy)_1053560845661458451]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_failed_orders])/SUM([total_orders])' />
            </column>
            <column caption='Fail Rate (FR)' datatype='real' default-format='p0.00%' name='[Fail Rate (copy)_1346576337753276422]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([failed_orders])/sum([total_orders])' />
            </column>
            <column caption='Fail Rate due to Out of Stock' datatype='real' default-format='p0.00%' name='[Fail Rate (copy)_631911363459440648]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([failed_orders_due_to_out_of_stock])/sum([total_orders])' />
            </column>
            <column caption='Active Vendors' datatype='integer' name='[Online Vendors (copy)_631911363457712133]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [confirmed_orders] &gt; 0 THEN [platform_vendor_id] ELSE NULL END)' />
            </column>
            <column caption='Partial Fulfillment Godroid' datatype='real' default-format='p0.0%' name='[Partial Fulfillment (copy)_2924806514372071425]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(INT([godroid_partial_fulfillment]))/[Pelican Confirmed Orders (copy)_2924806514371936256])*MIN(IF [segment (Custom_SQL_Query)] &lt;&gt; &apos;Asia&apos; THEN 0 ELSE 1 END)' />
            </column>
            <column caption='Partial Fulfillment Godroid APAC only' datatype='real' default-format='p0.0%' name='[Partial Fulfillment Godroid (copy)_2924806514372485122]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Partial Fulfillment (copy)_2924806514372071425]&#13;&#10;WHEN 0 THEN NULL&#13;&#10;ELSE [Partial Fulfillment (copy)_2924806514372071425]&#13;&#10;END' />
            </column>
            <column caption='Godroid Confirmed Orders' datatype='integer' default-format='p0.0%' name='[Pelican Confirmed Orders (copy)_2924806514371936256]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(CASE  [is_pelican] WHEN FALSE THEN [confirmed_orders] ELSE 0 END)' />
            </column>
            <column caption='Pelican Confirmed Orders' datatype='integer' default-format='p0.0%' name='[Pelican Total Orders (copy)_1715308528267173893]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(CASE  [is_pelican] WHEN TRUE THEN [confirmed_orders] ELSE 0 END)' />
            </column>
