              <calculation class='tableau' formula='sum([seamless_order])/[% Pelican Orders (copy)_1715308528265842691]' />
            </column>
            <column caption='Modified Orders due to OOS %' datatype='real' name='[Calculation_1715308528771362825]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([seamless_false])/[Pelican Total Orders (copy)_1715308528267173893]' />
