        <calculation class='tableau' formula='[confirmed_orders]' />
      </column>
      <column caption='Last&lt;=N' datatype='boolean' name='[Calculation_1093811783956054047]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1093811783897702404]&lt;=[Parameters].[Parameter 1]-1'>
          <table-calc ordering-type='Rows' />
