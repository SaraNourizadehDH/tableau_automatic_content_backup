      <column caption='Vouchers (% of GMV)' datatype='real' default-format='p0.0%' name='[Calculation_1053560845626388484]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vouchers])/[Calculation_1053560845626101763]' />
      </column>
      <column caption='% Orders w/Vouchers' datatype='real' default-format='p0.0%' name='[Calculation_1053560845646405642]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([voucher_orders])/sum([confirmed_orders])' />
      </column>
      <column caption='‎‎' datatype='real' name='[Calculation_1053560845654679565]' role='measure' type='quantitative'>
