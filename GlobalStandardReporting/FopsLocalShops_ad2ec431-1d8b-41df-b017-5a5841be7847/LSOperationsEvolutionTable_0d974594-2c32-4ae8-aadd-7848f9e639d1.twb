            <column caption='Seamless Orders %' datatype='real' name='[Calculation_1715308528262303744]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([seamless_order])/[% Pelican Orders (copy)_1715308528265842691]' />
            </column>
            <column caption='Modified Orders due to OOS %' datatype='real' name='[Calculation_1715308528771362825]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([seamless_false])/[Pelican Total Orders (copy)_1715308528267173893]' />
            </column>
            <column caption='Partial Fulfillment (new)' datatype='real' name='[Calculation_1715308528772108298]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([is_partially_fulfilled])/[Pelican Total Orders (copy)_1715308528267173893]' />
            </column>
            <column caption='OOS Net Orders' datatype='real' name='[Calculation_1715308528772546571]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1715308528772108298]+[Fail Rate (copy)_631911363459440648]' />
            </column>
            <column caption='Items Replaced Rate' datatype='real' name='[Calculation_1715308528773804044]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([has_replacements])/[Pelican Total Orders (copy)_1715308528267173893]' />
            </column>
            <column caption='GBV Pelican' datatype='real' name='[Calculation_1715308528779722767]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_pelican] THEN [gbv_gross_of_vat_2] ELSE 0 END' />
            </column>
            <column caption='GBV OOS Failure Loss' datatype='real' name='[Calculation_1715308528784728080]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gbv_partial_fulfillment_loss_eur]) + SUM([gbv_failed_oos_loss])' />
            </column>
            <column caption='OOS GBV Loss Rate' datatype='real' name='[Calculation_1715308528788381713]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1715308528784728080]/SUM([gbv_gross_of_vat_2])' />
            </column>
            <column caption='NPS' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_2506253207934418946]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([nps_promoters])-SUM([nps_detractors]))/SUM([nps_responses])*100' />
            </column>
            <column caption='SFTP' datatype='string' name='[Calculation_4516266047899996160]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [is_sftp]&#13;&#10;WHEN 1 THEN &quot;SFTP&quot;&#13;&#10;ELSE &quot;NON-SFTP&quot;&#13;&#10;END' />
            </column>
            <column caption='% FDF' datatype='real' default-format='p0.0%' name='[Calculation_467248483710910464]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([w_fdf_orders])/SUM([confirmed_orders])' />
            </column>
            <column caption='Dimension' datatype='string' name='[Calculation_6165076082767515648]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;    WHEN &apos;Region&apos; THEN [segment (Custom_SQL_Query)]&#10;    WHEN &apos;Management Entity&apos; THEN [management_entity]&#10;    WHEN &apos;Country Name&apos; THEN [country_name]&#10;    WHEN &apos;Store Type L1&apos; THEN [store_type_1]&#10;    WHEN &apos;Store Type L2&apos; THEN [store_type_2]&#10;    WHEN &apos;Store Type L3&apos; THEN [store_type_3]&#10;    WHEN &apos;Chain Name&apos; THEN [chain_name]&#10;    WHEN &apos;Vendor Name&apos; THEN [vendor_name]&#10;    WHEN &apos;Vendor App&apos; THEN IF [is_pelican] = TRUE THEN &apos;pelican&apos; ELSE &apos;godroid&apos; END&#10;    WHEN &apos;New Online&apos; THEN STR([new_online])&#10;    WHEN &apos;Is API&apos; THEN STR([Calculation_1361775992800034816])&#10;    WHEN &apos;Is SFTP&apos; THEN STR([Calculation_4516266047899996160])&#10;    WHEN &apos;by Fail Rate OOS [vendor level]&apos; THEN STR([Fail Rate due to Out of Stock (copy)_5647373212841783297])&#10;    WHEN &apos;by Fail Rate OOS (GROUPED) [vendor level]&apos; THEN STR([FR by OOS GROUPS (group)])&#10;    WHEN &apos;by Basket Size [vendor level]&apos; THEN STR([Avg. Items per Order (copy)_5647373212846059522])&#10;    WHEN &apos;by Basket Size (GROUPED) [vendor level]&apos; THEN STR([BS GROUP (group)])&#10;    WHEN &apos;by Partial Fulfilment (new) [vendor level]&apos; THEN STR([FR by OOS GROUPS (copy)_5647373213800951827])&#10;    WHEN &apos;by Partial Fulfilment (new) (GROUPED) [vendor level]&apos; THEN STR([PF by OOS GROUPS (group)])&#10;    WHEN &apos;by NPS [vendor level]&apos; THEN STR([NPS Group (group)])&#10;    WHEN &apos;by Avg. Orders per Week [vendor level]&apos; THEN STR([BS GROUP (copy)_2335609006887907328])&#10;    WHEN &apos;by Avg. Orders per Week (GROUPED) [vendor level]&apos; THEN STR([Avg Daily Orders per Vendor (group)])&#10;END' />
            </column>
            <column caption='Online Vendors' datatype='integer' name='[Calculation_631911363457060868]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(CASE [is_online] WHEN TRUE THEN [vendor_id] ELSE NULL END)' />
