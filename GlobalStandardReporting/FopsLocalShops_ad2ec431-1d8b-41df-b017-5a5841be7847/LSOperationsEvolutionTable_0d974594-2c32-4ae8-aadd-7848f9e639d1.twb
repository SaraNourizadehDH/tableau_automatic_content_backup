        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;DH Group&quot; THEN &#13;&#10;&#13;&#10;{FIXED [global_entity_id],[Calculation_1279022341663531008] : &#13;&#10;&#13;&#10;&#13;&#10;COUNTD([analytical_customer_id (Custom_SQL_Query4)])}&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Region&quot; THEN &#13;&#10;&#13;&#10;{FIXED [global_entity_id],[Calculation_1279022341663531008] : &#13;&#10;&#13;&#10;&#13;&#10;COUNTD([analytical_customer_id (Custom_SQL_Query4)])}&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Mgmt. Entity&quot; THEN &#13;&#10;&#13;&#10;{FIXED [global_entity_id],[Calculation_1279022341663531008] : &#13;&#10;&#13;&#10;&#13;&#10;COUNTD([analytical_customer_id (Custom_SQL_Query4)])}&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Country&quot; THEN &#13;&#10;&#13;&#10;{FIXED [global_entity_id],[Calculation_1279022341663531008] : &#13;&#10;&#13;&#10;&#13;&#10;COUNTD([analytical_customer_id (Custom_SQL_Query4)])}&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Chain&quot; THEN NULL&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Vendor&quot; THEN NULL&#13;&#10;&#13;&#10;END' />
