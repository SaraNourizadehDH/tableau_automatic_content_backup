      <column datatype='real' default-format='p0.00%' name='[Calculation2]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([nps_responses])) - LOOKUP(ZN(SUM([nps_responses])), -1)) / ABS(LOOKUP(ZN(SUM([nps_responses])), -1))'>
