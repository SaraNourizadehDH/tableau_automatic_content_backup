      <column caption='DF (% of Food)' datatype='real' default-format='p0.0%' name='[ABV (% of Food) (copy)_1117737142140084238]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1118863095866163205]/[ABV Gross (gross of VAT) - Food (copy)_1117737142114504706]' />
      </column>
      <column caption='ABV (% of DMart)' datatype='real' default-format='p0.0%' name='[ABV (% of Food) (copy)_631911363453644800]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[APV Gross (gross of VAT) (copy)_1053560845601157120]/[ABV Gross (gross of VAT) - Food (copy)_631911363453759489]' />
      </column>
      <column caption='Items per Order (% of DMart)' datatype='real' default-format='p0.0%' name='[ABV (% of Food) (copy)_915638144252461061]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1118863095866515462]/[ABV Gross (gross of VAT) - DMart (copy)_915638144252276740]' />
      </column>
      <column caption='ABV Gross (gross of VAT) (Scorecard)' datatype='real' default-format='c#,##0.00&quot; €&quot;;-#,##0.00&quot; €&quot;' name='[ABV Gross (gross of VAT) (copy)_432627049344426010]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(&#13;&#10;CASE [country_name]&#13;&#10;    WHEN &quot;Austria&quot; THEN NULL&#13;&#10;    WHEN &quot;Romania&quot; THEN NULL&#13;&#10;    WHEN &quot;Czech Republic&quot; THEN NULL&#13;&#10;    WHEN &quot;Greece&quot; THEN NULL&#13;&#10;    WHEN &quot;Germany&quot; THEN NULL&#13;&#10;    ELSE [gbv_gross_of_vat_2]&#13;&#10;    END)&#13;&#10;/&#13;&#10;sum(CASE [country_name]&#13;&#10;    WHEN &quot;Austria&quot; THEN NULL&#13;&#10;    WHEN &quot;Romania&quot; THEN NULL&#13;&#10;    WHEN &quot;Czech Republic&quot; THEN NULL&#13;&#10;    WHEN &quot;Greece&quot; THEN NULL&#13;&#10;    WHEN &quot;Germany&quot; THEN NULL&#13;&#10;    ELSE [confirmed_orders]&#13;&#10;END)' />
      </column>
      <column caption='Avg. Items per Order - DMart' datatype='real' default-format='p0.0%' name='[ABV Gross (gross of VAT) - DMart (copy)_915638144252276740]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ds_quantity])/sum([ds_orders])' />
      </column>
      <column caption='DF Gross (gross of VAT) - Food' datatype='real' name='[ABV Gross (gross of VAT) - Food (copy)_1117737142114504706]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([food_delivery_fee])/sum([food_w_df_orders])' />
      </column>
      <column caption='ABV Gross (gross of VAT) - DMart' datatype='real' default-format='p0.0%' name='[ABV Gross (gross of VAT) - Food (copy)_631911363453759489]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ds_gbv])/sum([ds_orders])' />
      </column>
      <column caption='ABV Gross (gross of VAT)' datatype='real' default-format='c#,##0.00&quot; €&quot;;-#,##0.00&quot; €&quot;' name='[APV Gross (gross of VAT) (copy)_1053560845601157120]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gbv_gross_of_vat_2])/SUM([confirmed_orders])' />
      </column>
      <column caption='Avg. Picking Time' datatype='real' default-format='n#,##0.0&quot;&apos;&quot;;-#,##0.0&quot;&apos;&quot;' name='[AVG DT (copy)_1053560845755940892]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([picking_time_seconds])/SUM([has_picking_time_orders])/60' />
      </column>
