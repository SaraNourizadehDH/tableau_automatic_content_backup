      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN([Avg. Nominal DF (copy)_915638144251662338]) - LOOKUP(ZN([Avg. Nominal DF (copy)_915638144251662338]), -1)) / ABS(LOOKUP(ZN([Avg. Nominal DF (copy)_915638144251662338]), -1))'>
