      <column caption='% Orders w/ Delivery Time &gt;45&apos;' datatype='real' default-format='p0.00%' name='[Avg Delivery Time (copy)_1053560845816639522]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([orders_dt_higher_45])&#13;&#10;/&#13;&#10;sum([confirmed_orders])' />
      </column>
      <column caption='Avg. DT' datatype='real' default-format='n#,##0.0&quot;&apos;&quot;;-#,##0.0&quot;&apos;&quot;' name='[Avg. Delivery Time (copy)_1346576337753092100]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([delivery_time_minutes])/SUM([has_delivery_time_orders])' />
      </column>
      <column caption='BS GROUP' datatype='string' default-format='n#,##0.0;-#,##0.0' name='[Avg. Items per Order (copy)_5647373212846059522]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [vendor_id] : STR(ROUND(sum([qty_sold])/SUM([confirmed_orders]),0)) }' />
      </column>
      <column caption='Avg. Realized DF' datatype='real' default-format='c#,##0.00&quot; €&quot;;-#,##0.00&quot; €&quot;' name='[Avg. Nominal DF (copy)_915638144251662338]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([df])/sum([confirmed_orders])' />
      </column>
      <column caption='Avg. Daily Orders per Vendor ' datatype='real' name='[Avg. Orders per Vendor  (copy)_5647373213098295309]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG({FIXED vendor_id: SUM([total_orders])})/90' />
      </column>
      <column caption='Avg. PT' datatype='real' default-format='n#,##0.0&quot;&apos;&quot;;-#,##0.0&quot;&apos;&quot;' name='[Avg. Picking Time (copy)_1346576337753174021]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([picking_time_seconds])/SUM([has_picking_time_orders])/60' />
      </column>
      <column caption='Avg Daily Orders per Vendor' datatype='integer' default-format='n#,##0.0;-#,##0.0' name='[BS GROUP (copy)_2335609006887907328]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='(CEILING({ FIXED [vendor_id] : [Avg. Orders per Vendor  (copy)_5647373213098295309]}))' />
      </column>
      <column aggregation='Sum' caption='NPS Group' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[BS GROUP (copy)_5647373213923823636]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='ROUND({ FIXED [vendor_id] : [Calculation_2506253207934418946]}, -1)' />
      </column>
