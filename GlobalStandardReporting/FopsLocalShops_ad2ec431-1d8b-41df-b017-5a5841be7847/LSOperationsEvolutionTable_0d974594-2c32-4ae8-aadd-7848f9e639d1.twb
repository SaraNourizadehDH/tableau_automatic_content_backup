      </column>
      <column caption='Avg. Delivery Time' datatype='real' default-format='n#,##0.0&quot;&apos;&quot;;-#,##0.0&quot;&apos;&quot;' name='[Calculation_1053560845706698778]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([delivery_time_minutes])/SUM([has_delivery_time_orders])' />
