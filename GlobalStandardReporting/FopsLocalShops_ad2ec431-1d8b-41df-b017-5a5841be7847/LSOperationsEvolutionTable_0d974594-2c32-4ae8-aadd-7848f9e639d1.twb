      <size maxheight='10000' maxwidth='1700' minheight='10000' minwidth='1700' preset-index='0' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='Queries' name='federated.1kilve60d9a8mv142ar8q0rpkclw' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Last N periods' datatype='integer' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='8'>
          <calculation class='tableau' formula='8' />
          <range max='13' min='1' />
        </column>
        <column caption='Periodicity' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
          <calculation class='tableau' formula='&quot;Weekly&quot;' />
          <members>
            <member value='&quot;Weekly&quot;' />
            <member value='&quot;Monthly&quot;' />
            <member value='&quot;Quarterly&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.1kilve60d9a8mv142ar8q0rpkclw'>
        <column caption='Date' datatype='date' name='[Calculation_1279022341663531008]' role='dimension' type='ordinal'>
          <calculation class='tableau' formula='CASE [Parameters].[Parameter 3] &#13;&#10;WHEN &quot;Weekly&quot; THEN [report_week]&#13;&#10;WHEN &quot;Quarterly&quot; then [report_quarter]&#13;&#10;ELSE [report_month]&#13;&#10;END' />
        </column>
        <column caption='IS API' datatype='string' name='[Calculation_1361775992800034816]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='CASE [is_api] WHEN &apos;API&apos; THEN &apos;API&apos; ELSE &apos;NON API&apos; END' />
        </column>
        <column caption='replacements_binary' datatype='boolean' name='[Calculation_1982428327752630283]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='case [has_replacements] &#13;&#10;    when 0 then FALSE&#13;&#10;    when null then FALSE&#13;&#10;else TRUE end' />
        </column>
        <column caption='SFTP' datatype='string' name='[Calculation_4516266047899996160]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='CASE [is_sftp]&#13;&#10;WHEN 1 THEN &quot;SFTP&quot;&#13;&#10;ELSE &quot;NON-SFTP&quot;&#13;&#10;END' />
