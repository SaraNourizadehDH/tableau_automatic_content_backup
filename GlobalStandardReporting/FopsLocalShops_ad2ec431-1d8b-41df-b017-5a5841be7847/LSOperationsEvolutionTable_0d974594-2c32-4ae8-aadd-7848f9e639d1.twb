            <column caption='Partial Fulfillment' datatype='real' default-format='p0.0%' name='[Calculation_915638144269778956]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([partial_orders])/[Pelican Total Orders (copy)_1715308528267173893]' />
