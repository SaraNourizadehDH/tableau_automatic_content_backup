    <worksheet name='SCD - Perf'>
      <table>
        <view>
          <datasources>
            <datasource caption='Queries' name='federated.1kilve60d9a8mv142ar8q0rpkclw' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Open by Chain' datatype='string' name='[Parameter 2 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;No&quot;'>
              <calculation class='tableau' formula='&quot;No&quot;' />
            </column>
            <column caption='Structure' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
              <calculation class='tableau' formula='&quot;Country&quot;' />
            </column>
            <column caption='Periodicity' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
            <column caption='Top N (Structure-level)' datatype='real' name='[Parameter 4]' param-domain-type='range' role='measure' type='quantitative' value='1000.'>
              <calculation class='tableau' formula='1000.' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1kilve60d9a8mv142ar8q0rpkclw'>
            <column caption='DH Group' datatype='string' name='[Calculation_1053560845625098242]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;DH Group&apos;' />
            </column>
            <column caption='% Orders w/Vouchers' datatype='real' default-format='p0.0%' name='[Calculation_1053560845646405642]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([voucher_orders])/sum([confirmed_orders])' />
            </column>
            <column caption='Date' datatype='date' name='[Calculation_1279022341663531008]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3] &#13;&#10;WHEN &quot;Weekly&quot; THEN [report_week]&#13;&#10;WHEN &quot;Quarterly&quot; then [report_quarter]&#13;&#10;ELSE [report_month]&#13;&#10;END' />
            </column>
            <column caption='Daily Orders per Active Vendor' datatype='real' name='[Calculation_1346576337742401538]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([confirmed_orders])/MAX(DATEPART(&quot;day&quot;,[m_date]))/COUNTD([platform_vendor_id])' />
            </column>
            <column caption='Rank Orders' datatype='boolean' name='[Calculation_1346576337760686092]' role='measure' type='nominal'>
              <calculation class='tableau' formula='RANK(SUM([confirmed_orders])) &lt;= [Parameters].[Parameter 4]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='IS API' datatype='string' name='[Calculation_1361775992800034816]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [is_api] WHEN &apos;API&apos; THEN &apos;API&apos; ELSE &apos;NON API&apos; END' />
            </column>
            <column caption='SFTP' datatype='string' name='[Calculation_4516266047899996160]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [is_sftp]&#13;&#10;WHEN 1 THEN &quot;SFTP&quot;&#13;&#10;ELSE &quot;NON-SFTP&quot;&#13;&#10;END' />
            </column>
            <column caption='Perf' datatype='string' name='[Calculation_467248484370923523]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;Performance&quot;' />
            </column>
            <column caption='Online Vendors' datatype='integer' name='[Calculation_631911363457060868]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(CASE [is_online] WHEN TRUE THEN [vendor_id] ELSE NULL END)' />
            </column>
            <column caption='Zombies' datatype='integer' name='[Calculation_631911363458002950]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_631911363457060868]-[Online Vendors (copy)_631911363457712133]' />
            </column>
            <column caption='% Zombies' datatype='real' default-format='p0.0%' name='[Calculation_631911363458138119]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_631911363458002950]/[Calculation_631911363457060868]' />
            </column>
            <column caption='Pre-Structure' datatype='string' name='[Color/Sort (only for view 1) (copy)_646548030125666307]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;DH Group&quot; THEN NULL&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Region&quot; THEN [Calculation_1053560845625098242]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Mgmt. Entity&quot; THEN [segment (Custom_SQL_Query)]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Country&quot; THEN [management_entity]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Chain&quot; THEN [country_name]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Vendor&quot; THEN&#13;&#10;        CASE [Parameters].[Parameter 2 1]&#13;&#10;            WHEN &quot;Yes&quot; THEN [chain_name]&#13;&#10;            WHEN &quot;No&quot; THEN NULL&#13;&#10;        END&#13;&#10;END' />
            </column>
            <column caption='Structure' datatype='string' name='[Date (copy)_1286059231031123969]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;DH Group&quot; THEN [Calculation_1053560845625098242]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Region&quot; THEN [segment (Custom_SQL_Query)]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Mgmt. Entity&quot; THEN [management_entity]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Country&quot; THEN [country_name]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Chain&quot; THEN [chain_name]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Vendor&quot; THEN [vendor_name]&#13;&#10;END' />
            </column>
            <column caption='Active Vendors' datatype='integer' name='[Online Vendors (copy)_631911363457712133]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [confirmed_orders] &gt; 0 THEN [platform_vendor_id] ELSE NULL END)' />
            </column>
            <column caption='Pre-Pre-Structure' datatype='string' name='[Pre-Structure (copy)_1346576337737904128]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;DH Group&quot; THEN NULL&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Region&quot; THEN NULL&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Mgmt. Entity&quot; THEN [Calculation_1053560845625098242]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Country&quot; THEN [segment (Custom_SQL_Query)]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Chain&quot; THEN [management_entity]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Vendor&quot; THEN [country_name]&#13;&#10;END' />
            </column>
