          <datasource-dependencies datasource='federated.1kilve60d9a8mv142ar8q0rpkclw'>
            <column caption='DF (% of Food)' datatype='real' default-format='p0.0%' name='[ABV (% of Food) (copy)_1117737142140084238]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1118863095866163205]/[ABV Gross (gross of VAT) - Food (copy)_1117737142114504706]' />
            </column>
            <column caption='DF Gross (gross of VAT) - Food' datatype='real' name='[ABV Gross (gross of VAT) - Food (copy)_1117737142114504706]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([food_delivery_fee])/sum([food_w_df_orders])' />
            </column>
            <column caption='ABV Gross (gross of VAT)' datatype='real' default-format='c#,##0.00&quot; €&quot;;-#,##0.00&quot; €&quot;' name='[APV Gross (gross of VAT) (copy)_1053560845601157120]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gbv_gross_of_vat_2])/SUM([confirmed_orders])' />
            </column>
            <column caption='Avg. Nominal DF' datatype='real' default-format='c#,##0.00&quot; €&quot;;-#,##0.00&quot; €&quot;' name='[Calculation_1118863095866163205]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([df])/sum([w_df_orders])' />
            </column>
            <column caption='Avg. Items per Order' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1118863095866515462]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([qty_sold])/SUM([confirmed_orders])' />
