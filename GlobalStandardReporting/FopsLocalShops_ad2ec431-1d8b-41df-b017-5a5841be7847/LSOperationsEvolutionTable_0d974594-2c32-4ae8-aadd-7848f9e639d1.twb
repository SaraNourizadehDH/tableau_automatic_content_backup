            <column caption='Vendor Fail Rate' datatype='real' default-format='p0.00%' name='[Fail Rate (copy)_1053560845661458451]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_failed_orders])/SUM([total_orders])' />
            </column>
            <column caption='Fail Rate due to Out of Stock' datatype='real' default-format='p0.00%' name='[Fail Rate (copy)_631911363459440648]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([failed_orders_due_to_out_of_stock])/sum([total_orders])' />
