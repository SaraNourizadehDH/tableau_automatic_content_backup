            <column caption='Logistics FR' datatype='real' default-format='p0.00%' name='[Logistics Fail Rate (copy)_1346576337753382919]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([transport_failed_orders])/sum([total_orders])' />
