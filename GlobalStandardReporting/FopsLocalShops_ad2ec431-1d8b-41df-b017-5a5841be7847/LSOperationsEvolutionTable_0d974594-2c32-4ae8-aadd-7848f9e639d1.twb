              <calculation class='tableau' formula='sum([voucher_orders])/sum([confirmed_orders])' />
            </column>
            <column caption='Avg. Delivery Time' datatype='real' default-format='n#,##0.0&quot;&apos;&quot;;-#,##0.0&quot;&apos;&quot;' name='[Calculation_1053560845706698778]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_time_minutes])/SUM([has_delivery_time_orders])' />
            </column>
            <column caption='Orders Confirmed RR' datatype='integer' default-format='n#,##0,.0K;-#,##0,.0K' name='[Calculation_1093811783930581018]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[confirmed_orders]' />
            </column>
            <column caption='Avg. Nominal DF' datatype='real' default-format='c#,##0.00&quot; €&quot;;-#,##0.00&quot; €&quot;' name='[Calculation_1118863095866163205]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([df])/sum([w_df_orders])' />
            </column>
            <column caption='Avg. Items per Order' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1118863095866515462]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([qty_sold])/SUM([confirmed_orders])' />
            </column>
            <column caption='Date' datatype='date' name='[Calculation_1279022341663531008]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3] &#13;&#10;WHEN &quot;Weekly&quot; THEN [report_week]&#13;&#10;WHEN &quot;Quarterly&quot; then [report_quarter]&#13;&#10;ELSE [report_month]&#13;&#10;END' />
            </column>
            <column caption='IS API' datatype='string' name='[Calculation_1361775992800034816]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [is_api] WHEN &apos;API&apos; THEN &apos;API&apos; ELSE &apos;NON API&apos; END' />
            </column>
            <column caption='NPS' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_2506253207934418946]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([nps_promoters])-SUM([nps_detractors]))/SUM([nps_responses])*100' />
            </column>
            <column caption='SFTP' datatype='string' name='[Calculation_4516266047899996160]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [is_sftp]&#13;&#10;WHEN 1 THEN &quot;SFTP&quot;&#13;&#10;ELSE &quot;NON-SFTP&quot;&#13;&#10;END' />
            </column>
            <column caption='% FDF' datatype='real' default-format='p0.0%' name='[Calculation_467248483710910464]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([w_fdf_orders])/SUM([confirmed_orders])' />
            </column>
            <column caption='Online Vendors' datatype='integer' name='[Calculation_631911363457060868]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(CASE [is_online] WHEN TRUE THEN [vendor_id] ELSE NULL END)' />
            </column>
            <column caption='Zombies' datatype='integer' name='[Calculation_631911363458002950]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_631911363457060868]-[Online Vendors (copy)_631911363457712133]' />
            </column>
            <column caption='% Zombies' datatype='real' default-format='p0.0%' name='[Calculation_631911363458138119]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_631911363458002950]/[Calculation_631911363457060868]' />
            </column>
            <column caption='% Pelican Orders' datatype='real' default-format='p0.0%' name='[Calculation_631911363459702793]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(CASE  [is_pelican] WHEN TRUE THEN [confirmed_orders] ELSE 0 END)/&#13;&#10;SUM([confirmed_orders])' />
            </column>
            <column caption='Acquisitions' datatype='integer' name='[Calculation_915638144268410888]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([platform_acq])' />
            </column>
            <column caption='Commission Rate' datatype='real' default-format='p0.0%' name='[Calculation_915638144269549579]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([commission])/SUM([commission_base])' />
