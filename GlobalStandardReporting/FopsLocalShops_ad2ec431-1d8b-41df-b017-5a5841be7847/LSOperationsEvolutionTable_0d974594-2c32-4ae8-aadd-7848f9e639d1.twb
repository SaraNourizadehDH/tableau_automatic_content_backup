      </column>
      <column caption='ABV Gross (gross of VAT) - Food' datatype='real' default-format='p0.0%' name='[Calculation_1117737142114283521]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([food_gbv])/sum([food_orders])' />
      </column>
      <column caption='ABV (% of Food)' datatype='real' default-format='p0.0%' name='[Calculation_1117737142114656259]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[APV Gross (gross of VAT) (copy)_1053560845601157120]/[Calculation_1117737142114283521]' />
      </column>
      <column caption='Avg. Nominal DF' datatype='real' default-format='c#,##0.00&quot; €&quot;;-#,##0.00&quot; €&quot;' name='[Calculation_1118863095866163205]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([df])/sum([w_df_orders])' />
      </column>
      <column caption='Avg. Items per Order' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1118863095866515462]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([qty_sold])/SUM([confirmed_orders])' />
      </column>
      <column caption='Date' datatype='date' name='[Calculation_1279022341663531008]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3] &#13;&#10;WHEN &quot;Weekly&quot; THEN [report_week]&#13;&#10;WHEN &quot;Quarterly&quot; then [report_quarter]&#13;&#10;ELSE [report_month]&#13;&#10;END' />
      </column>
      <column caption='Daily Orders per Active Vendor' datatype='real' name='[Calculation_1346576337742401538]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([confirmed_orders])/MAX(DATEPART(&quot;day&quot;,[m_date]))/COUNTD([platform_vendor_id])' />
      </column>
      <column caption='Rank Orders' datatype='boolean' name='[Calculation_1346576337760686092]' role='measure' type='nominal'>
        <calculation class='tableau' formula='RANK(SUM([confirmed_orders])) &lt;= [Parameters].[Parameter 4]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='IS API' datatype='string' name='[Calculation_1361775992800034816]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [is_api] WHEN &apos;API&apos; THEN &apos;API&apos; ELSE &apos;NON API&apos; END' />
      </column>
      <column caption='Partial Fulfillment Reduced Qty' datatype='real' name='[Calculation_1464232852741136384]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([partial_fulfillment_reduced_quantity])/[Pelican Total Orders (copy)_1715308528267173893]' />
      </column>
      <column caption='Has not processed Items %' datatype='real' name='[Calculation_1464232853499498497]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([not_proccesed])/[Pelican Total Orders (copy)_1715308528267173893]-0.019' />
      </column>
      <column caption='Seamless Orders %' datatype='real' name='[Calculation_1715308528262303744]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([seamless_order])/[% Pelican Orders (copy)_1715308528265842691]' />
