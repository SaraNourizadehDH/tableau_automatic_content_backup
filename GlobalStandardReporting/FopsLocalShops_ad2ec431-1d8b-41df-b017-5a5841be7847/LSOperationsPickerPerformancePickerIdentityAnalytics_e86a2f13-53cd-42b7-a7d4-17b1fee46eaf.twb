    <worksheet name='Adoption (2)'>
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Adoption' name='federated.0ssh9xq09r963w1fpxhpm1lr0mvp' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='#Pickers' caption='Select Adoption KPIs' datatype='string' name='[Select KPI (copy)_800022299977277442]' param-domain-type='list' role='measure' type='nominal' value='&quot;1&quot;'>
              <calculation class='tableau' formula='&quot;1&quot;' />
              <aliases>
                <alias key='&quot;1&quot;' value='#Pickers' />
                <alias key='&quot;2&quot;' value='#Vendors' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ssh9xq09r963w1fpxhpm1lr0mvp'>
            <column caption='# UVendors' datatype='integer' name='[# Pickers (copy)_800022299975421953]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//COUNTD([picker_id])&#10;COUNTD([global_entity_id] + [vendor_id])&#10;&#10;//SUM(IF ISNULL([Global Entity Id] + [Vendor Id]) THEN 0 ELSE 1 END)' />
            </column>
            <column caption='# Pickers' datatype='integer' name='[Calculation_198439925956890624]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//COUNTD([picker_id])&#10;SUM([picker_count])' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_198439925962489858]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([local_date])' />
            </column>
            <column caption='Entity' datatype='string' name='[Calculation_198439925967745027]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF LOWER([country]) = &apos;turkey&apos; THEN &quot;Yemeksepeti&quot; ELSE [management_entity] END' />
            </column>
            <column caption='Secondary axis' datatype='real' name='[Calculation_5932718493214277634]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1.01' />
            </column>
            <column caption='AAA SuperMarket' datatype='string' name='[Calculation_800022299972825088]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_aaa_supermarket] then &apos;AAA SuperMarket&apos;&#10;ELSE &apos;Non-AAA SuperMarket&apos; END' />
