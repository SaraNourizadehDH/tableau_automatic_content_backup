      <aliases enabled='yes' />
      <column caption='# Orders' datatype='integer' default-format='n#,##0;-#,##0' name='[# GMV Eur (copy)_2624261629459402754]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([confirmed_orders])' />
      </column>
      <column caption='# Pickers per Vendor' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[# Pickers (copy)_6855745327684739072]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([picker_id_coalesce]) / COUNTD([vendor_id])' />
      </column>
      <column caption='# Orders per Picker' datatype='real' default-format='n#,##0;-#,##0' name='[# Pickers per Vendor (copy)_6855745327688339457]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([confirmed_orders]) / COUNTD([picker_id_coalesce])' />
      </column>
      <column caption='Local week' datatype='string' name='[Calculation_119838038354944000]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(DATE(DATETRUNC(&apos;week&apos;,[local_date],&apos;MONDAY&apos;)))' />
      </column>
      <column caption='# Pickers' datatype='integer' name='[Calculation_1393371555961368576]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([picker_id_coalesce])' />
      </column>
      <column caption='# GMV Eur' datatype='real' default-format='n&quot;€ &quot;#,##0;-&quot;€ &quot;#,##0' name='[Calculation_1393371555971620871]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gmv_gross_eur])' />
      </column>
      <column caption='Date' datatype='string' name='[Calculation_1393371556019441685]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([local_date])' />
      </column>
      <column caption='Metric symbol' datatype='string' name='[Calculation_152418765141266439]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF INT([Parameters].[Parameter 1]) &lt;= 3&#10;THEN &quot;%&quot;&#10;ELSE &quot;&quot;&#10;END' />
      </column>
      <column caption='Entity' datatype='string' name='[Calculation_5596004066529976320]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF LOWER([country]) = &apos;turkey&apos; THEN &quot;Yemeksepeti&quot; ELSE [management_entity] END' />
      </column>
      <column caption='Entity Plus' datatype='string' name='[Calculation_5596004066539806721]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='If ({FIXED : COUNTD([Calculation_5596004066529976320])}) = 1 THEN [country] ELSE [Calculation_5596004066529976320] END' />
      </column>
      <column caption='Picker id null' datatype='boolean' name='[Calculation_634092754249498624]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='ISNULL([Calculation_81346321464938502])' />
      </column>
      <column caption='Dynamic KPI select' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_76701996078669825]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;WHEN &apos;1&apos;  THEN [percent_oos_fr]*100&#10;WHEN &apos;2&apos; THEN [percent_partial_orders]*100&#10;WHEN &apos;3&apos; THEN [share_within_vendor]*100&#10;WHEN &apos;4&apos; THEN [confirmed_orders]&#10;WHEN &apos;5&apos; THEN [partial_orders_pelican]&#10;WHEN &apos;6&apos; THEN [avg_picking_time]&#10;END' />
      </column>
      <column caption='AAA Supermarket' datatype='string' name='[Calculation_800022300006686724]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_aaa_supermarket] then &apos;AAA SuperMarket&apos;&#10;ELSE &apos;Non-AAA SuperMarket&apos; END' />
      </column>
      <column caption='Chain id plus chain name' datatype='string' name='[Calculation_81346321460809732]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[chain_name] + &quot; (&quot; + LEFT(LOWER([country]), 2) + &quot;)&quot;' />
      </column>
      <column caption='Vendor id plus vendor name' datatype='string' name='[Calculation_81346321462902789]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[vendor_id] + &apos; - &apos; + [vendor_name]' />
      </column>
      <column caption='Picker ID &amp; Picker Name' datatype='string' name='[Calculation_81346321464938502]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='str([picker_id_coalesce]) + &apos; - &apos; + [picker_name_coalesce]' />
      </column>
      <column caption='# Count chain' datatype='integer' name='[Calculation_81346321466159111]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_81346321460809732])' />
      </column>
      <column caption='picker plus vendor' datatype='string' name='[Picker id plus picker name (copy)_81346321467084808]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='str([picker_id_coalesce]) + &apos; - &apos; + [picker_name_coalesce] + &apos; (&apos; + [vendor_id] + &apos;)&apos;' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='picker_identity_metrics' datatype='table' name='[__tableau_internal_object_id__].[ls_ops_rt_picker_scorecard_tableau_A752498CA7B04658AAADA98372688D31]' role='measure' type='quantitative' />
      <column caption='Acc Manager' datatype='string' name='[acc_manager]' role='dimension' type='nominal' />
