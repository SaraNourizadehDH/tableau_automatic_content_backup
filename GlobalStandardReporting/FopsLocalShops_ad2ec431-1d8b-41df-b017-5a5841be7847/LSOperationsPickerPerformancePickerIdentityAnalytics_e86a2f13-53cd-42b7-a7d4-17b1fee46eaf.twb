            <column-instance column='[vendor_name]' derivation='None' name='[none:vendor_name:nk]' pivot='key' type='nominal' />
            <column caption='Vendor Login Flow' datatype='string' name='[vendor_login_flow]' role='dimension' type='nominal' />
            <column caption='Vendor Name' datatype='string' name='[vendor_name]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <slices>
            <column>[federated.0ssh9xq09r963w1fpxhpm1lr0mvp].[none:vendor_login_flow:nk]</column>
            <column>[federated.0ssh9xq09r963w1fpxhpm1lr0mvp].[none:granularity:nk]</column>
            <column>[federated.0ssh9xq09r963w1fpxhpm1lr0mvp].[none:local_date:qk]</column>
            <column>[federated.0ssh9xq09r963w1fpxhpm1lr0mvp].[none:Calculation_800022299972825088:nk]</column>
            <column>[federated.0ssh9xq09r963w1fpxhpm1lr0mvp].[none:management_entity:nk]</column>
            <column>[federated.0ssh9xq09r963w1fpxhpm1lr0mvp].[none:country:nk]</column>
            <column>[federated.0ssh9xq09r963w1fpxhpm1lr0mvp].[none:chain_name:nk]</column>
            <column>[federated.0ssh9xq09r963w1fpxhpm1lr0mvp].[none:vendor_name:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='height' value='124' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-disallow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Shape' />
            <encodings>
              <shape column='[federated.0ssh9xq09r963w1fpxhpm1lr0mvp].[none:Calculation_121456520101380096:nk]' />
            </encodings>
            <customized-tooltip show-buttons='false'>
              <formatted-text>
                <run bold='true' fontcolor='#4e79a7' fontname='Tableau Medium' fontsize='11'>Operational Metrics</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontname='Tableau Medium'>New login and Old login</run>
                <run fontname='Tableau Medium'> informs that metric corresponds to a new picker account (that is using a new flow) or an old picker account (that is using the old flow for login).</run>
                <run>Æ&#10;&#10;</run>
                <run fontname='Tableau Medium'>We have </run>
                <run bold='true' fontname='Tableau Medium'>five</run>
                <run fontname='Tableau Medium'> different metrics available so far:</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontname='Tableau Medium'>#Confirmed orders</run>
                <run fontname='Tableau Medium'>: Number of orders that the picker picked within that period.</run>
                <run>Æ&#10;</run>
                <run fontname='Tableau Medium'>Æ&#9;&#9;         </run>
                <run fontname='Tableau Medium' italic='true'>Formula: SUM(Confirmed Orders)</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontname='Tableau Medium'>#Partial orders</run>
                <run fontname='Tableau Medium'>: Number of orders delivered partially picked by that picker. A partial order is one in which the quantity of items delivered is lower than the quantity of items ordered.</run>
                <run>Æ&#10;</run>
                <run fontname='Tableau Medium'>Æ&#9;&#9;         </run>
                <run fontname='Tableau Medium' italic='true'>Formula: SUM(Partial Orders)</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontname='Tableau Medium'>%Partial orders</run>
                <run fontname='Tableau Medium'>: Ratio of partially delivered orders and the confirmed orders.</run>
                <run>Æ&#10;</run>
                <run fontname='Tableau Medium'>Æ&#9;&#9;         </run>
                <run fontname='Tableau Medium' italic='true'>Formula: SUM(Partial Orders)/SUM(Confirmed Orders)</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontname='Tableau Medium'>%Failed due to out-of-stock orders</run>
                <run fontname='Tableau Medium'>: Ratio between canceled orders due to out-of-stock and confirmed orders. Canceled orders are those that the customer opts to cancel because one product is missing.</run>
                <run>Æ&#10;</run>
                <run fontname='Tableau Medium'>Æ&#9;&#9;         </run>
                <run fontname='Tableau Medium' italic='true'>Formula: SUM(Fail due to OOS orders)/SUM(Confirmed Orders)</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontname='Tableau Medium'>%Orders within vendor</run>
                <run fontname='Tableau Medium'>: Ratio between orders done by that picker and the total orders within his/her vendor</run>
                <run>Æ&#10;</run>
                <run fontname='Tableau Medium'>Æ&#9;&#9;         </run>
                <run fontname='Tableau Medium' italic='true'>Formula: SUM(Confirmed orders [picker])/SUM(Confirmed orders [vendor])</run>
                <run>Æ&#10;</run>
                <run fontname='Tableau Medium' fontsize='9' italic='true'>Note: they might not totalize 100% because part of the orders are attributed to null picker ids.</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontname='Tableau Medium'>Average picking time (seconds)</run>
                <run fontname='Tableau Medium'>: Picking in time, in seconds, that the picker takes to, on average, pick each item.</run>
                <run>Æ&#10;</run>
                <run fontname='Tableau Medium'>Æ&#9;&#9;         </run>
                <run fontname='Tableau Medium' italic='true'>Formula: SUM(Picking time (s))/SUM(qty_delivered)</run>
              </formatted-text>
            </customized-tooltip>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-cull' value='true' />
                <format attr='shape' value='Bug Tracking/light.png' />
                <format attr='mark-labels-show' value='false' />
              </style-rule>
              <style-rule element='pane'>
                <format attr='minheight' value='-1' />
                <format attr='maxheight' value='-1' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows />
        <cols />
        <tooltip-style tooltip-mode='sticky' />
      </table>
