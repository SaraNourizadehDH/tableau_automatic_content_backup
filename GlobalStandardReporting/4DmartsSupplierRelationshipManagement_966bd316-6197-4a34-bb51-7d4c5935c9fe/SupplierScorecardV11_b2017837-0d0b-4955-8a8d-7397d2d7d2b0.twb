        <calculation class='tableau' formula='IFNULL(([Calculation_3058084900170260483] / [Net_Sales_LC]),0)' />
      </column>
      <column caption='Calculation2' datatype='real' name='[Calculation_3200933452071653376]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='' />
      </column>
      <column caption='Level Name' datatype='string' name='[Calculation_3200933452072046593]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [supplier_level]&#10;    WHEN &quot;supplier&quot; THEN [supplier_name]&#10;    WHEN &quot;level_one&quot; THEN [level_one]&#10;    WHEN &quot;level_two&quot; THEN [level_two]&#10;    WHEN &quot;level_three&quot; THEN [level_three]&#10;    ELSE &quot;Unknown&quot;&#10;END' />
      </column>
      <column aggregation='Sum' caption='YoY GPV Growth ' datatype='real' name='[Calculation_3244843545646804992]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Euros&quot; THEN ([YoY_GPV_Growth_EUR]) &#10;ELSEIF [Parameters].[Parameter 1] = &quot;Local Currency&quot; THEN ([YoY_GPV_Growth_LC]) END' />
      </column>
      <column aggregation='Sum' caption='Promo GPV Contribution' datatype='real' name='[Calculation_3244843545647345665]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Euros&quot; THEN ([Promo_GPV_contribution_eur]) &#10;ELSEIF [Parameters].[Parameter 1] = &quot;Local Currency&quot; THEN ([Promo_GPV_contribution_LC]) END' />
      </column>
      <column caption='Calculation1' datatype='boolean' name='[Calculation_3244843545663184898]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='NULL' />
      </column>
      <column caption='Supplier Funding' datatype='real' name='[Calculation_3244843545663262723]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Euros&quot; THEN ([total_supplier_funding_eur]) &#10;ELSEIF [Parameters].[Parameter 1] = &quot;Local Currency&quot; THEN ([total_supplier_funding_lc]) END' />
      </column>
      <column aggregation='Sum' caption='Net Profit' datatype='real' name='[Calculation_3244843545664708613]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Euros&quot; THEN &#10;    NULL&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Local Currency&quot; THEN &#10;    IF [Parameters].[Parameter 2] = &quot;Including Warehouse Allowance&quot; THEN&#10;        [Net_Sales_LC] * ([Back_Margin_LC] + [Front_Margin_LC])&#10;    ELSEIF [Parameters].[Parameter 2] = &quot;Excluding Warehouse Allowance&quot; THEN&#10;        [Net_Sales_LC] * ([Back_Margin_LC_WO_WA] + [Front_Margin_LC])&#10;    END&#10;&#10;END' />
      </column>
      <column caption='BLANK' datatype='boolean' name='[Calculation_391531725582979072]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='NULL' />
      </column>
      <column caption='Total_Margin_Avg' datatype='real' name='[Calculation_4051480503714336797]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Net_Sales_LC]) + SUM([total_supplier_funding_lc]) - SUM([COGS_lc]) + SUM([back_margin_wo_dist_allowance_amt_lc]) ) / SUM([Net_Sales_LC])' />
      </column>
      <column caption='Availability_Average' datatype='real' name='[Calculation_4051480503714463774]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([availability_num]) / SUM([availability_den])' />
      </column>
      <column caption='Supplier_funding_%_average' datatype='real' name='[Calculation_4051480503714656287]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_supplier_funding_lc]) / SUM([total_discount_lc])' />
      </column>
      <column caption='Warehouse_Allowance_%_Average' datatype='real' name='[Calculation_4051480503714816032]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_3058084900170260483]) / SUM([Net_Sales_LC])' />
      </column>
      <column caption='fill_rate_average' datatype='real' name='[Calculation_4051480503715074081]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(total_received_qty_per_po_order)/SUM([total_demanded_plus_supplier_non_fulfilled_order_qty])' />
      </column>
      <column caption='OTD_Average' datatype='real' name='[Calculation_4051480503715188770]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_on_time_orders]) / SUM([total_non_cancelled_plus_cancelled_po_orders])' />
      </column>
      <column caption='YoY_GPV_Growth_Average' datatype='real' name='[Calculation_4051480503715299363]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Net_Sales_LC]) - SUM([Net_Sales_LC_Last_Year])) / SUM([Net_Sales_LC_Last_Year])' />
      </column>
      <column caption='Promo_GPV_Contribution_Average' datatype='real' name='[Calculation_4051480503715459108]' role='measure' type='quantitative'>
