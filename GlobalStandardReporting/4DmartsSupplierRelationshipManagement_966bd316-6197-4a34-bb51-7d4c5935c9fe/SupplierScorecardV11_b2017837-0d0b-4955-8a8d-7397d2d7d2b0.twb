    <worksheet name='1.1.4 Supplier Seg (KPIs) - (Averages) (2)'>
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Segmentation - Rough' name='federated.0sxx26l0ari3lh18b5hb117a67t8' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Local Currency&quot;'>
              <calculation class='tableau' formula='&quot;Local Currency&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0sxx26l0ari3lh18b5hb117a67t8'>
            <column caption='Cogs Eur' datatype='real' name='[COGS_EUR]' role='measure' type='quantitative' />
            <column caption='Cogs Lc' datatype='real' name='[COGS_LC]' role='measure' type='quantitative' />
            <column caption='COGS' datatype='real' name='[Calculation_2467128180023123968]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Euros&quot; THEN SUM([COGS_EUR])&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Local Currency&quot; THEN SUM([COGS_LC])&#10;END' />
            </column>
            <column caption='Segmentation' datatype='string' name='[Calculation_2467128180420845573]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Euros&quot; THEN NULL&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Local Currency&quot; THEN [Segmentation_LC]&#10;END' />
            </column>
            <column caption='GPV' datatype='integer' datatype-customized='true' name='[Calculation_2890959146090885122]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(IF [Parameters].[Parameter 1] = &quot;Euros&quot; THEN SUM([Conditional_GPV_EUR])&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Local Currency&quot; THEN SUM([Conditional_GPV_LC])&#10;END)' />
            </column>
            <column caption='Warehouse ' datatype='real' name='[Calculation_381961562288209921]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([total_rebate_lc]) - ([total_rebate_wo_dist_allowance_lc])' />
            </column>
            <column caption='Supplier Funding %' datatype='real' name='[Calculation_381961562298478595]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(([total_supplier_funding_LC] / [total_discount_lc]),0)' />
            </column>
            <column caption='FM_Average' datatype='real' name='[Calculation_4051480503721033771]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Conditional_GPV_LC]) + sum([total_supplier_funding_LC]) - SUM([COGS_LC])) / SUM([Conditional_GPV_LC])' />
            </column>
            <column caption='BM_Average' datatype='real' name='[Calculation_4051480503721152556]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_rebate_wo_dist_allowance_lc]) / SUM([Conditional_GPV_LC])' />
            </column>
            <column caption='Total_Margin_Average' datatype='real' name='[Calculation_4051480503721263149]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Conditional_GPV_LC]) + sum([total_supplier_funding_LC]) - SUM([COGS_LC]) + SUM([total_rebate_wo_dist_allowance_lc]) )/ SUM([Conditional_GPV_LC])' />
            </column>
            <column caption='Availability_Average' datatype='real' name='[Calculation_4051480503721562158]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([availability_num])/SUM([availability_den])' />
            </column>
            <column caption='WH_Allowance_average' datatype='real' name='[Calculation_4051480503721832495]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_381961562288209921]) / SUM([Conditional_GPV_LC])' />
            </column>
            <column caption='Conditional GPV EUR' datatype='real' name='[Conditional_GPV_EUR]' role='measure' type='quantitative' />
            <column caption='Conditional GPV LC' datatype='real' name='[Conditional_GPV_LC]' role='measure' type='quantitative' />
            <column datatype='real' name='[Net_Purchases]' role='measure' type='quantitative' />
            <column caption='Segmentation LC' datatype='string' name='[Segmentation_LC]' role='dimension' type='nominal' />
            <column datatype='real' name='[availability_den]' role='measure' type='quantitative' />
            <column datatype='real' name='[availability_num]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_381961562298478595]' derivation='Avg' name='[avg:Calculation_381961562298478595:qk]' pivot='key' type='quantitative' />
            <column caption='Supplier Type' datatype='string' name='[division_type]' role='dimension' type='nominal' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
