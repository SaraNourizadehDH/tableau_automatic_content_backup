    <worksheet name='2.4.3 Supplier Scoring (KPIs) - Supplier Breakdown - (Averages) (4)'>
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Scoring (Rough)' name='federated.1sjlqvx0e9ueo816ei7wp1q8b8gz' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Local Currency&quot;'>
              <calculation class='tableau' formula='&quot;Local Currency&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1sjlqvx0e9ueo816ei7wp1q8b8gz'>
            <column caption='COGS lc' datatype='real' name='[COGS_lc]' role='measure' type='quantitative' />
            <column caption='Segmentation' datatype='string' name='[Calculation_2467128180420845573]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Euros&quot; THEN NULL&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Local Currency&quot; THEN [Segmentation_LC]&#10;END' />
            </column>
            <column caption='blank' datatype='real' datatype-customized='true' name='[Calculation_2890959146105106440]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='FLOAT(null)' />
            </column>
            <column caption='fill_rate_average' datatype='real' name='[Calculation_4051480503715074081]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(total_received_qty_per_po_order)/SUM([total_demanded_plus_supplier_non_fulfilled_order_qty])' />
            </column>
            <column caption='OTD_Average' datatype='real' name='[Calculation_4051480503715188770]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_on_time_orders]) / SUM([total_non_cancelled_plus_cancelled_po_orders])' />
            </column>
            <column caption='YoY_GPV_Growth_Average' datatype='real' name='[Calculation_4051480503715299363]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Net_Sales_LC]) - SUM([Net_Sales_LC_Last_Year])) / SUM([Net_Sales_LC_Last_Year])' />
            </column>
            <column caption='Promo_GPV_Contribution_Average' datatype='real' name='[Calculation_4051480503715459108]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([GPV_from_promo_lc]) / SUM([Net_Sales_LC])' />
            </column>
            <column caption='Back_margin_average' datatype='real' name='[Calculation_4051480503715590181]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([back_margin_wo_dist_allowance_amt_lc]) / SUM([Net_Sales_LC])' />
            </column>
            <column caption='Front_margin_Average' datatype='real' name='[Calculation_4051480503715676198]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Net_Sales_LC]) + SUM([total_supplier_funding_lc]) - SUM([COGS_lc])) / SUM([Net_Sales_LC])' />
            </column>
            <column caption='Supplier_level_filter' datatype='boolean' name='[Calculation_4441464047119048704]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[supplier_level] = &apos;supplier&apos;' />
            </column>
