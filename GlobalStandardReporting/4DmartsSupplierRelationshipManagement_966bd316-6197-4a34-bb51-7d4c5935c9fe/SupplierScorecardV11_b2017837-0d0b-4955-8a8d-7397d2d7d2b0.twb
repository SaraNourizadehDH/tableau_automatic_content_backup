      </column>
      <column aggregation='Sum' caption='Back-Margin' datatype='real' name='[Calculation_2467128180719628294]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;  WHEN &quot;Including Warehouse Allowance&quot; THEN [Back_Margin_LC]&#10;  WHEN &quot;Excluding Warehouse Allowance&quot; THEN [Back_Margin_LC_WO_WA]&#10;END' />
