    <worksheet name='2.5.4 Supplier Scoring (KPIs) (Average)'>
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Scoring (Rough)' name='federated.1sjlqvx0e9ueo816ei7wp1q8b8gz' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Local Currency&quot;'>
              <calculation class='tableau' formula='&quot;Local Currency&quot;' />
            </column>
            <column caption='Back-Margin' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Including Warehouse Allowance&quot;'>
              <calculation class='tableau' formula='&quot;Including Warehouse Allowance&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1sjlqvx0e9ueo816ei7wp1q8b8gz'>
            <column caption='Back Margin LC - Net Purchases' datatype='real' name='[Back Margin Amt Lc (copy)_6252051848941031425]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Net_Purchases]) = 0 THEN 0&#10;ELSE ROUND(SUM([back_margin_amt_lc]) / SUM([Net_Purchases]), 4)&#10;END' />
            </column>
            <column caption='Back Margin LC WO WA - Net Purchases' datatype='real' name='[Back Margin LC WO WA (copy)_6252051848941600770]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Net_Purchases]) = 0 THEN 0&#10;ELSE ROUND(SUM([back_margin_wo_dist_allowance_amt_lc]) / SUM([Net_Purchases]), 4)&#10;END' />
            </column>
            <column caption='Back-Margin Net Purchases' datatype='real' name='[Back-Margin (copy)_6252051849240174601]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;  WHEN &quot;Including Warehouse Allowance&quot; THEN [Back Margin Amt Lc (copy)_6252051848941031425]&#10;  WHEN &quot;Excluding Warehouse Allowance&quot; THEN [Back Margin LC WO WA (copy)_6252051848941600770]&#10;END' />
            </column>
            <column caption='COGS lc' datatype='real' name='[COGS_lc]' role='measure' type='quantitative' />
            <column caption='AVG([median_price_index]*100)' datatype='real' name='[Calculation_2194097480536125445]' role='measure' type='quantitative' user:unnamed='1.5.4 Supplier Scoring (KPIs) (Average)'>
              <calculation class='tableau' formula='AVG([median_price_index]*100)' />
            </column>
            <column caption='Segmentation' datatype='string' name='[Calculation_2467128180420845573]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Euros&quot; THEN NULL&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Local Currency&quot; THEN [Segmentation_LC]&#10;END' />
            </column>
            <column caption='GPV' datatype='real' name='[Calculation_2890959146090885122]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Euros&quot; THEN SUM([Net_Sales_EUR])&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Local Currency&quot; THEN SUM([Net_Sales_LC])&#10;END' />
            </column>
            <column caption='Warehouse Allowance' datatype='real' name='[Calculation_3058084900170260483]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[back_margin_amt_lc] - [back_margin_wo_dist_allowance_amt_lc]' />
            </column>
            <column caption='Availability_Average' datatype='real' name='[Calculation_4051480503714463774]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([availability_num]) / SUM([availability_den])' />
            </column>
            <column caption='Supplier_funding_%_average' datatype='real' name='[Calculation_4051480503714656287]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_supplier_funding_lc]) / SUM([total_discount_lc])' />
            </column>
            <column caption='Warehouse_Allowance_%_Average' datatype='real' name='[Calculation_4051480503714816032]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_3058084900170260483]) / SUM([Net_Sales_LC])' />
            </column>
            <column caption='Total_Margin_Average' datatype='real' name='[Calculation_4051480503715758119]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Net_Sales_LC]) + SUM([total_supplier_funding_lc]) - SUM([COGS_lc]) + SUM([back_margin_wo_dist_allowance_amt_lc]) ) / SUM([Net_Sales_LC])' />
            </column>
            <column caption='[GPV] / TOTAL([GPV])' datatype='real' name='[Calculation_4267794002028199944]' role='measure' type='quantitative' user:unnamed='1.5.4 Supplier Scoring (KPIs) (Average)'>
              <calculation class='tableau' formula='[Calculation_2890959146090885122] / TOTAL([Calculation_2890959146090885122])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='GPV1' datatype='real' name='[Calculation_4276941923983085580]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Euros&quot; THEN SUM([Net_Sales_EUR])&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Local Currency&quot; THEN SUM([Net_Sales_LC])&#10;END' />
            </column>
            <column caption='Supplier_level_filter' datatype='boolean' name='[Calculation_4441464047119048704]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[supplier_level] = &apos;supplier&apos;' />
            </column>
            <column caption='Net Purchases' datatype='real' name='[Net_Purchases]' role='measure' type='quantitative' />
