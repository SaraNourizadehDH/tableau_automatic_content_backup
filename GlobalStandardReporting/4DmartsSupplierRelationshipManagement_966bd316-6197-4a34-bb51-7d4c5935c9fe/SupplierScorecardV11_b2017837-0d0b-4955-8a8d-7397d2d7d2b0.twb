    <worksheet name='Supplier Scorecard Metrics MoM Delta WH View'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Scoring (Rough)' name='federated.1sjlqvx0e9ueo816ei7wp1q8b8gz' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Local Currency&quot;'>
              <calculation class='tableau' formula='&quot;Local Currency&quot;' />
            </column>
            <column caption='Back-Margin' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Including Warehouse Allowance&quot;'>
              <calculation class='tableau' formula='&quot;Including Warehouse Allowance&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1sjlqvx0e9ueo816ei7wp1q8b8gz'>
            <column caption='Back Margin LC' datatype='real' name='[Back_Margin_LC]' role='measure' type='quantitative' />
            <column caption='Back Margin LC WO WA' datatype='real' name='[Back_Margin_LC_WO_WA]' role='measure' type='quantitative' />
            <column caption='Cogs Eur' datatype='real' name='[COGS_EUR]' role='measure' type='quantitative' />
            <column caption='COGS lc' datatype='real' name='[COGS_lc]' role='measure' type='quantitative' />
            <column caption='fill_rate' datatype='real' name='[Calculation_1895382146405908480]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([fill_rate])' />
            </column>
            <column caption='OTD.' datatype='real' name='[Calculation_1895382146406088705]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([OTD])' />
            </column>
            <column caption='COGS' datatype='real' name='[Calculation_2467128180023123968]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Euros&quot; THEN SUM([COGS_EUR])&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Local Currency&quot; THEN SUM([COGS_lc])&#10;END' />
            </column>
            <column caption='Front-Margin' datatype='real' name='[Calculation_2467128180023402497]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Euros&quot; THEN [Front_Margin_EUR]&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Local Currency&quot; THEN [Front_Margin_LC]&#10;END' />
            </column>
            <column caption='Total Margin' datatype='real' name='[Calculation_2467128180418834436]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Euros&quot; THEN NULL&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Local Currency&quot; THEN [Total_Margin_LC]&#10;END' />
            </column>
            <column aggregation='Sum' caption='Back-Margin' datatype='real' name='[Calculation_2467128180719628294]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;  WHEN &quot;Including Warehouse Allowance&quot; THEN [Back_Margin_LC]&#10;  WHEN &quot;Excluding Warehouse Allowance&quot; THEN [Back_Margin_LC_WO_WA]&#10;END' />
            </column>
            <column caption='GPV' datatype='real' name='[Calculation_2890959146090885122]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Euros&quot; THEN SUM([Net_Sales_EUR])&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Local Currency&quot; THEN SUM([Net_Sales_LC])&#10;END' />
            </column>
            <column caption='Supplier Funding %' datatype='real' name='[Calculation_3058084900166074368]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(([total_supplier_funding_lc] / [total_discount_lc]),0)' />
            </column>
            <column caption='Warehouse Allowance' datatype='real' name='[Calculation_3058084900170260483]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[back_margin_amt_lc] - [back_margin_wo_dist_allowance_amt_lc]' />
            </column>
            <column caption='Warehouse Allowance %' datatype='real' name='[Calculation_3058084900170575876]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(([Calculation_3058084900170260483] / [Net_Sales_LC]),0)' />
            </column>
            <column aggregation='Sum' caption='YoY GPV Growth ' datatype='real' name='[Calculation_3244843545646804992]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Euros&quot; THEN ([YoY_GPV_Growth_EUR]) &#10;ELSEIF [Parameters].[Parameter 1] = &quot;Local Currency&quot; THEN ([YoY_GPV_Growth_LC]) END' />
            </column>
            <column aggregation='Sum' caption='Promo GPV Contribution' datatype='real' name='[Calculation_3244843545647345665]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Euros&quot; THEN ([Promo_GPV_contribution_eur]) &#10;ELSEIF [Parameters].[Parameter 1] = &quot;Local Currency&quot; THEN ([Promo_GPV_contribution_LC]) END' />
            </column>
            <column caption='YoY GPV Growth (EVO)' datatype='real' name='[Calculation_997195507716882433]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(AVG([Calculation_3244843545646804992]))' />
            </column>
            <column caption='Efficiency (EVO)' datatype='real' name='[Calculation_997195507717033986]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([perc_efficiency])' />
            </column>
            <column caption='Supplier Funding (EVO)' datatype='real' name='[Calculation_997195507717156867]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Calculation_3058084900166074368])' />
            </column>
            <column caption='Warehouse Allowance (EVO)' datatype='real' name='[Calculation_997195507717300228]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Calculation_3058084900170575876])' />
            </column>
            <column caption='Front-Margin (EVO)' datatype='real' name='[Calculation_997195507717459973]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Calculation_2467128180023402497])' />
            </column>
            <column caption='Back-Margin (EVO)' datatype='real' name='[Calculation_997195507717554182]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Calculation_2467128180719628294])' />
            </column>
            <column caption='Total-Margin (EVO)' datatype='real' name='[Calculation_997195507717697543]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Calculation_2467128180418834436])' />
            </column>
            <column caption='Availability (EVO)' datatype='real' name='[Calculation_997195507717849096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([availability])' />
            </column>
            <column caption='Promo GPV Cont (EVO)' datatype='real' name='[Calculation_997195507718021129]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Calculation_3244843545647345665])' />
            </column>
