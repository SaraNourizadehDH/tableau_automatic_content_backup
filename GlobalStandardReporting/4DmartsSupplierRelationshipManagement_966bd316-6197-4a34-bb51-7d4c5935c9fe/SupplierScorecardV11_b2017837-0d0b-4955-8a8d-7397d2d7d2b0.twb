    <worksheet name='4.1 Supplier Seg (Score)'>
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Segmentation - Rough' name='federated.0sxx26l0ari3lh18b5hb117a67t8' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Local Currency&quot;'>
              <calculation class='tableau' formula='&quot;Local Currency&quot;' />
            </column>
            <column caption='Back-Margin' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Including Warehouse Allowance&quot;'>
              <calculation class='tableau' formula='&quot;Including Warehouse Allowance&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0sxx26l0ari3lh18b5hb117a67t8'>
            <column caption='Abv Eur' datatype='real' name='[ABV_EUR]' role='measure' type='quantitative' />
            <column caption='Avg cat per order' datatype='real' name='[Avg_cat_per_order]' role='measure' type='quantitative' />
            <column caption='Back Margin LC' datatype='real' name='[Back_Margin_LC]' role='measure' type='quantitative' />
            <column caption='Back Margin LC WO WA' datatype='real' name='[Back_Margin_LC_WO_WA]' role='measure' type='quantitative' />
            <column caption='Basket penetration %' datatype='real' name='[Basket_penetration 1]' role='measure' type='quantitative' />
            <column caption='Cogs Eur' datatype='real' name='[COGS_EUR]' role='measure' type='quantitative' />
            <column caption='Cogs Lc' datatype='real' name='[COGS_LC]' role='measure' type='quantitative' />
            <column caption='COGS' datatype='real' name='[Calculation_2467128180023123968]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Euros&quot; THEN SUM([COGS_EUR])&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Local Currency&quot; THEN SUM([COGS_LC])&#10;END' />
            </column>
            <column aggregation='Sum' caption='Front-Margin' datatype='real' name='[Calculation_2467128180023402497]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Euros&quot; THEN [FM_EUR]&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Local Currency&quot; THEN [FM_LC]&#10;END' />
            </column>
            <column caption='Net Retail Profit ' datatype='real' name='[Calculation_2467128180024180739]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Euros&quot; THEN NULL&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Local Currency&quot; THEN [Net_profit_LC_WO_WA]&#10;END' />
            </column>
            <column aggregation='Sum' caption='Total-Margin' datatype='real' name='[Calculation_2467128180418834436]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Euros&quot; THEN NULL&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Local Currency&quot; THEN [Total_margin_LC]&#10;END' />
            </column>
            <column caption='Segmentation' datatype='string' name='[Calculation_2467128180420845573]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Euros&quot; THEN NULL&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Local Currency&quot; THEN [Segmentation_LC]&#10;END' />
            </column>
            <column aggregation='Sum' caption='Back-Margin' datatype='real' name='[Calculation_2467128180719628294]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;  WHEN &quot;Including Warehouse Allowance&quot; THEN [Back_Margin_LC]&#10;  WHEN &quot;Excluding Warehouse Allowance&quot; THEN [Back_Margin_LC_WO_WA]&#10;END' />
            </column>
            <column caption='INDEX' datatype='integer' name='[Calculation_2890959146026708992]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='INDEX()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='GPV' datatype='integer' datatype-customized='true' name='[Calculation_2890959146090885122]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(IF [Parameters].[Parameter 1] = &quot;Euros&quot; THEN SUM([Conditional_GPV_EUR])&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Local Currency&quot; THEN SUM([Conditional_GPV_LC])&#10;END)' />
            </column>
            <column caption='Warehouse ' datatype='real' name='[Calculation_381961562288209921]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([total_rebate_lc]) - ([total_rebate_wo_dist_allowance_lc])' />
            </column>
            <column caption='Warehouse Allowance %' datatype='real' name='[Calculation_381961562288939010]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IFNULL(([Calculation_381961562288209921] / ([Conditional_GPV_LC])),0)' />
            </column>
            <column caption='Supplier Funding %' datatype='real' name='[Calculation_381961562298478595]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(([total_supplier_funding_LC] / [total_discount_lc]),0)' />
            </column>
            <column caption='Net Retail Profit Score' datatype='real' name='[Calculation_5089912014553137155]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Euros&quot; THEN NULL&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Local Currency&quot; THEN [retail_profit_score_lc]&#10;END' />
            </column>
            <column aggregation='Sum' caption='ABV Score' datatype='real' name='[Calculation_5089912014558605316]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Euros&quot; THEN ([abv_score_eur]) &#10;ELSEIF [Parameters].[Parameter 1] = &quot;Local Currency&quot; THEN ([abv_score_lc]) END' />
            </column>
            <column caption='Supplier Importance Score' datatype='real' name='[Calculation_5089912014558814213]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Euros&quot; THEN ([supplier_importance_score_eur]) &#10;ELSEIF [Parameters].[Parameter 1] = &quot;Local Currency&quot; THEN ([supplier_importance_score_lc]) END' />
            </column>
            <column caption='Supplier Productivity Score' datatype='real' name='[Calculation_5089912014559150086]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Euros&quot; THEN ([supplier_productivity_score_eur]) &#10;ELSEIF [Parameters].[Parameter 1] = &quot;Local Currency&quot; THEN ([supplier_productivity_score_lc]) END' />
            </column>
            <column caption='Average X-Axis' datatype='integer' datatype-customized='true' name='[Calculation_6501579447484178432]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(AVG([x_axis_score]))' />
            </column>
            <column caption='Basket Penetration' datatype='real' name='[Calculation_791366904797646848]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Basket_penetration 1]/100' />
            </column>
            <column caption='Conditional GPV EUR' datatype='real' name='[Conditional_GPV_EUR]' role='measure' type='quantitative' />
            <column caption='Conditional GPV LC' datatype='real' name='[Conditional_GPV_LC]' role='measure' type='quantitative' />
