      <column caption='Calculation1' datatype='real' name='[Calculation_831125277876686848]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1 1]&#10;    WHEN &quot;AQS&quot; THEN [AQS]&#10;    WHEN &quot;Average Active SKUs&quot; THEN ([Gbv])/([total_orders])&#10;    WHEN &quot;Assortment Design Gap L1 p.p.&quot; THEN [Asst. Design Gap L1 p.p.]&#10;    WHEN &quot;Avg. Listed SKUs&quot; THEN [Listed Skus]&#10;    WHEN &quot;Content Score&quot; THEN [Content Score]&#10;    WHEN &quot;CVR&quot; THEN [CVR]*100&#10;    WHEN &quot;DOH&quot; THEN [Discontinued Book Value]*100&#10;    WHEN &quot;Efficiency %&quot; THEN [Efficiency %]*100&#10;    WHEN &quot;Frequency&quot; THEN [Calculation_1185854145204133891]&#10;    WHEN &quot;Availability %&quot; THEN [Availability %]*100&#10;    WHEN &quot;L3 Cat Cover. %&quot; THEN [L3 Cat Cover. %]*100&#10;    WHEN &quot;Newness %&quot; THEN [Efficient Listings %]*100&#10;    WHEN &quot;Spoilage %&quot; THEN [Availability %]*100&#10;    WHEN &quot;Ultrafresh GPV % contr.&quot; THEN [Ultrafresh BP % contr.]*100&#10;    WHEN &quot;ABS&quot; THEN ([Qty Sold])/([total_orders])&#10;    WHEN &quot;ODS&quot; THEN [ODS]&#10;    WHEN &quot;Distinct SKUs&quot; THEN [Dist Listed Skus]&#10;    WHEN &quot;MAU Penetration&quot; THEN ([Dmart Mau])/([Dmart Covered Mau])*100&#10;END' />
