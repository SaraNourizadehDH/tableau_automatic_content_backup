      <column caption='Warehouse Allowance %' datatype='real' name='[Calculation_381961562288939010]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IFNULL(([Calculation_381961562288209921] / ([Conditional_GPV_LC])),0)' />
