      <column caption='Count Active SKUs CF ' datatype='string' name='[Calculation_96123759926034432]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [count_active_skus] &lt;= 4499 THEN &quot;Poor&quot;&#10;ELSEIF [count_active_skus] &lt;= 8499 THEN &quot;Fair&quot;&#10;ELSEIF [count_active_skus] &lt;= 13499 THEN &quot;Good&quot;&#10;ELSE &quot;Excellent&quot;&#10;END' />
