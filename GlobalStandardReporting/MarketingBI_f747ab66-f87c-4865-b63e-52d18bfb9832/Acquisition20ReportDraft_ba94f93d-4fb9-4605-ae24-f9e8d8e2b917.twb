      <column caption='Cost [Target]' datatype='real' name='[Costs (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;month&apos; THEN&#10;    IF [Parameters].[Parameter 5] = &apos;EUR&apos; THEN [costs_eur_target]&#10;    ELSEIF [Parameters].[Parameter 5] = &apos;USD&apos; THEN [costs_usd_target]&#10;    ELSEIF [Parameters].[Parameter 5] = &apos;LC&apos; THEN [costs_lc_target]&#10;    END&#10;ELSE 0&#10;END' />
      </column>
      <column caption='Cost [Budget]' datatype='real' name='[Costs [Targets]] (copy)_2705185690679029760]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;month&apos; THEN&#10;    IF [Parameters].[Parameter 5] = &apos;EUR&apos; THEN [costs_eur_budget]&#10;    ELSEIF [Parameters].[Parameter 5] = &apos;USD&apos; THEN [costs_usd_budget]&#10;    ELSEIF [Parameters].[Parameter 5] = &apos;LC&apos; THEN [costs_lc_budget]&#10;    END&#10;ELSE 0 &#10;END' />
