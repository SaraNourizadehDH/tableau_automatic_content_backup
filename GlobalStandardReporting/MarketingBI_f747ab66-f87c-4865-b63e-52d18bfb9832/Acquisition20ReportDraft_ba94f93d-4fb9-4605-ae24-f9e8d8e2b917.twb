    <worksheet name='Retention Rate: Cohorts '>
      <layout-options>
        <title>
          <formatted-text>
            <run>&lt;Sheet Name&gt; &#10;</run>
            <run fontsize='11'>Share of Users that placed a Reorder X Month after Acquisition</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='bima_marketing_channel_cohorts_all+ (rl_mkt)' name='federated.1oyuq630vfjo0m14aa6gk0v7dyyb' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Reorder Rate' caption='Retention Rate Switch' datatype='integer' name='[Parameter 10]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='Reorder Rate' />
                <alias key='2' value='Reorder Rate Exc. Vouchers' />
                <alias key='3' value='Reorder Rate From Vouchers' />
              </aliases>
            </column>
            <column alias='Reorder Rate' caption='Retentionrate vs Total Numbers' datatype='string' name='[Parameter 4 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Retention Percentages&quot;'>
              <calculation class='tableau' formula='&quot;Retention Percentages&quot;' />
              <aliases>
                <alias key='&quot;Activity&quot;' value='Activity' />
                <alias key='&quot;Frequency&quot;' value='Frequency' />
                <alias key='&quot;Retention Percentages&quot;' value='Reorder Rate' />
                <alias key='&quot;Total Number of Orders&quot;' value='Orders' />
                <alias key='&quot;Total Numbers of Users&quot;' value='Customers' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1oyuq630vfjo0m14aa6gk0v7dyyb'>
            <column caption='Customers w/o Vouchers' datatype='integer' name='[Calculation_2330683197305225216]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([customers], 0) - IFNULL([customers_with_vouchers], 0)' />
            </column>
            <column caption='Date' datatype='date' default-format='*YYYY-MM-DD' name='[Calculation_665688354841157632]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[first_order_month]' />
            </column>
            <column caption='Acquisitions' datatype='integer' name='[Calculation_665688354841587713]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//IF [Return Month] = 0 THEN [Customers] ELSE 0 END&#13;&#10;LOOKUP(SUM([customers]), FIRST())'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Frequency' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_665688354841702402]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders]) / [Calculation_665688354841587713]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Activity' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_665688354842140675]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders]) / SUM([customers])' />
            </column>
            <column caption='Cohort KPI' datatype='real' name='[Calculation_665688354842316804]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4 1] = &apos;Retention Percentages&apos;           THEN ROUND([Calculation_665688354843394053] * 100, 2)&#13;&#10;ELSEIF [Parameters].[Parameter 4 1] = &apos;Activity&apos;                    THEN ROUND([Calculation_665688354842140675], 2)&#13;&#10;ELSEIF [Parameters].[Parameter 4 1] = &apos;Frequency&apos;                   THEN ROUND([Calculation_665688354841702402], 2)&#13;&#10;ELSEIF [Parameters].[Parameter 4 1] = &apos;Total Number of Orders&apos;      THEN SUM([orders])&#13;&#10;ELSEIF [Parameters].[Parameter 4 1] = &apos;Total Numbers of Users&apos;      THEN SUM([customers])&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Retention Rate' datatype='real' default-format='p0.00%' name='[Calculation_665688354843394053]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 10]&#10;WHEN 1 THEN SUM([customers])&#10;WHEN 2 THEN SUM([Calculation_2330683197305225216])&#10;WHEN 3 THEN SUM([customers_with_vouchers])&#10;END&#10;&#10; / [Calculation_665688354841587713]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Current Month - Filter' datatype='string' name='[Calculation_665688354848038918]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATEADD(&apos;month&apos;, [return_period], [Calculation_665688354841157632]) = TODAY()-DAY(TODAY())+1 THEN &apos;out&apos;&#13;&#10;ELSE &apos;in&apos;&#13;&#10;END' />
            </column>
            <column caption='Retention Rate Colouring' datatype='real' name='[Calculation_683702777411026946]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF AVG([return_period]) = 0 THEN 0&#13;&#10;ELSE ROUND([Calculation_665688354843394053] * 100, 2)&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='City' datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Cohort Type' datatype='string' name='[cohort_type]' role='dimension' type='nominal' />
            <column caption='Country Code' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Customers' datatype='integer' name='[customers]' role='measure' type='quantitative' />
            <column caption='Customers With Vouchers' datatype='integer' name='[customers_with_vouchers]' role='measure' type='quantitative' />
            <column caption='Display Name' datatype='string' name='[display_name]' role='dimension' type='nominal' />
            <column caption='First Order Month' datatype='date' name='[first_order_month]' role='dimension' type='ordinal' />
            <column caption='Is Voucher Acquisition' datatype='boolean' name='[is_voucher_acquisition]' role='dimension' type='nominal' />
