      <column caption='Costs [prev. 364 Days]' datatype='real' name='[Costs [prev. Year]] (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;EUR&apos; THEN [prev_364d_costs_eur]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;USD&apos; THEN [prev_364d_costs_usd]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;LC&apos; THEN [prev_364d_costs_lc]&#10;END' />
