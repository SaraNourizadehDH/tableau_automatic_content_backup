      <column caption='Costs**' datatype='real' default-format='c&quot;€&quot;#,##0;(&quot;€&quot;#,##0)' name='[Costs* (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [date] &gt;= [Parameters].[Interval 1: Start (copy)] AND [date] &lt;= [Parameters].[Interval 1: Start (copy) (copy)] THEN [Calculation_1779695940233924609] ELSE 0 END' />
      </column>
      <column datatype='datetime' name='[Date1 (copy)]' role='dimension' type='ordinal'>
