    <worksheet name='FLGPO'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#ffffff' fontsize='16'>Monthly Cohorts - Fully Loaded Gross Profit per order</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run bold='true' fontsize='8'>KPI Definitions</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontsize='8'>Reorder Rate: </run>
            <run fontsize='8'>Active customers divided by cohort acquisitions</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='8'>Reorder Rate Exc. Vouchers: </run>
            <run fontsize='8'>Active customers (not using a voucher within the month) divided by cohort acquisitions</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='8'>Reorder Rate From Vouchers: </run>
            <run fontsize='8'>Active customers (using a voucher within the month) divided by cohort acquisitions</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='8'>Cumulative Reorder Rate: </run>
            <run fontsize='8'>Cumulative unique active customers making reorders divided by cohort acquisitions</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='8'>Active Customers: </run>
            <run fontsize='8'>Number of unique users who ordered in the reporting month</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='8'>Acquisitions:</run>
            <run fontsize='8'> Number of customers who placed their first successful order during the period (For these cohorts, Month 0), where a customer is defined as a distinct Analytical Costumer ID,</run>
            <run fontcolor='#ffffff' fontsize='8'>Æ </run>
            <run auto-url='true' fontcolor='#ffffff' fontsize='8' hyperlink='tabdoc:load-url url=&amp;quot;https://docs.google.com/presentation/d/19zkaMmm42CPz9Os5sJZIEhlA1RPmbvFwThO2LR-9X9g&amp;quot;'>https://docs.google.com/presentation/d/19zkaMmm42CPz9Os5sJZIEhlA1RPmbvFwThO2LR-9X9g</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontsize='8'>NOTE: </run>
            <run fontsize='8'>Month 0 is not shown for reorder rate</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='cohorts_monthly_platform (curated_data_shared_intl_markets)' name='federated.1lhq6om014l7qn10oluge00qrlwo' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Cohort Granularity' datatype='string' name='[Parameter 7 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
            <column caption='Header Switch' datatype='string' name='[Parameter 8 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;DH Group&quot;'>
              <calculation class='tableau' formula='&quot;DH Group&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1lhq6om014l7qn10oluge00qrlwo'>
            <column caption='FLGPO' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_3118813123413127172]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([flgpo_eur])/SUM([orders_profit])' />
            </column>
            <column caption='Header' datatype='string' name='[Calculation_384917097103093761]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 8 2]&#10;WHEN &apos;DH Group&apos; THEN &apos;DH Group&apos;&#10;WHEN &apos;Management Entity&apos; THEN [management_entity]&#10;WHEN &apos;Sub Entity&apos; THEN [sub_entity]&#10;END' />
            </column>
            <column aggregation='Sum' caption='First Order Year' datatype='integer' name='[Calculation_5674605952235618304]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='YEAR([first_order_month])' />
            </column>
            <column caption='Acq. Date Switch' datatype='string' name='[Calculation_5674605952238977025]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 7 2] = &apos;Month&apos;, LEFT(str([first_order_month]), 7),&#10;IIF([Parameters].[Parameter 7 2] = &apos;Quarter&apos;, str([first_order_quarter]),&#10;IIF([Parameters].[Parameter 7 2] = &apos;Semester&apos;, str([first_order_semester]),&#10;str([Calculation_5674605952235618304]))))' />
            </column>
            <column caption='Management Entity (copy)' datatype='string' name='[Management Entity (copy)_433612248457695232]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[management_entity]' />
            </column>
            <column caption='First Order Month' datatype='date' name='[first_order_month]' role='dimension' type='ordinal' />
            <column caption='First Order Quarter' datatype='string' name='[first_order_quarter]' role='dimension' type='nominal' />
            <column caption='First Order Semester' datatype='string' name='[first_order_semester]' role='dimension' type='nominal' />
            <column caption='Flgpo Eur' datatype='real' name='[flgpo_eur]' role='measure' type='quantitative' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column caption='Month Number' datatype='integer' name='[month_number]' role='dimension' type='quantitative' />
            <column-instance column='[Calculation_384917097103093761]' derivation='None' name='[none:Calculation_384917097103093761:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_5674605952238977025]' derivation='None' name='[none:Calculation_5674605952238977025:nk]' pivot='key' type='nominal' />
            <column-instance column='[Management Entity (copy)_433612248457695232]' derivation='None' name='[none:Management Entity (copy)_433612248457695232:nk]' pivot='key' type='nominal' />
            <column-instance column='[first_order_month]' derivation='None' name='[none:first_order_month:qk]' pivot='key' type='quantitative' />
            <column-instance column='[month_number]' derivation='None' name='[none:month_number:ok]' pivot='key' type='ordinal' />
            <column caption='Orders Profit' datatype='integer' name='[orders_profit]' role='measure' type='quantitative' />
            <column caption='Sub Entity' datatype='string' name='[sub_entity]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_3118813123413127172]' derivation='User' name='[usr:Calculation_3118813123413127172:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1lhq6om014l7qn10oluge00qrlwo].[none:Management Entity (copy)_433612248457695232:nk]'>
            <groupfilter function='except' user:ui-domain='database' user:ui-enumeration='exclusive' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[none:Management Entity (copy)_433612248457695232:nk]' />
              <groupfilter function='member' level='[none:Management Entity (copy)_433612248457695232:nk]' member='&quot;Woowa&quot;' />
            </groupfilter>
          </filter>
          <filter class='relative-date' column='[federated.1lhq6om014l7qn10oluge00qrlwo].[none:first_order_month:qk]' filter-group='3' first-period='-19' include-future='true' include-null='false' last-period='0' period-type-v2='month' />
          <slices>
