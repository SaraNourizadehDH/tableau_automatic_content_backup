    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Description'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/Acquisition2_0ReportDraft/Description?rev=' id='Description' path='/t/GlobalStandardReporting/workbooks/Acquisition2_0ReportDraft' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='dash-text'>
          <format attr='vertical-align' id='dash-text_255' value='center' />
          <format attr='text-align' id='dash-text_255' value='left' />
        </style-rule>
      </style>
      <size maxheight='700' maxwidth='1500' minheight='700' minwidth='700' sizing-mode='range' />
      <zones>
        <zone h='98714' id='3' param='vert' type-v2='layout-flow' w='98933' x='533' y='1143'>
          <zone fixed-size='86' h='12286' id='15' is-fixed='true' param='horz' type-v2='layout-flow' w='98933' x='533' y='1143'>
            <zone fixed-size='242' h='12286' id='16' is-fixed='true' is-scaled='1' param='Image/DH BI Tableau logo.jpg' type-v2='bitmap' w='16666' x='533' y='1143'>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone forceUpdate='true' h='12286' id='17' type-v2='text' w='82267' x='17199' y='1143'>
              <formatted-text>
                <run bold='true' fontcolor='#ffffff' fontname='Tableau Regular' fontsize='24'>    Delivery Hero</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
                <format attr='background-color' value='#c60000' />
              </zone-style>
            </zone>
          </zone>
          <zone fixed-size='123' h='17571' id='195' is-fixed='true' type-v2='layout-basic' w='98933' x='533' y='13429'>
            <zone h='17571' id='194' param='horz' type-v2='layout-flow' w='16667' x='533' y='13429'>
              <zone fixed-size='339' h='17571' id='8' is-fixed='true' is-scaled='1' param='Image/delivery-hero.jpg' type-v2='bitmap' w='16667' x='533' y='13429'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
            </zone>
            <zone h='17571' id='196' param='horz' type-v2='layout-flow' w='82266' x='17200' y='13429'>
              <zone forceUpdate='true' h='17571' id='7' type-v2='text' w='82266' x='17200' y='13429'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='12'>Description:</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='8'>-</run>
                  <run fontcolor='#000000' fontsize='8'> The report uses Adjust for app and GA for web. Majority of our orders come from app (&gt; 90%).</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='8'>Adjust which tracks activities from app.</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='8'>GA4 which tracks activities from app and web</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='8'>- The Report is divided into 2 views one for the detailed Acquisitions and other for the funnel view journey of customers till acquisition</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
            </zone>
          </zone>
          <zone h='68857' id='192' param='horz' type-v2='layout-flow' w='98933' x='533' y='31000'>
            <zone fixed-size='1105' forceUpdate='true' h='67715' id='10' is-fixed='true' type-v2='text' w='74200' x='800' y='31571'>
              <formatted-text>
                <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='14'>Metric Definitions &amp; Info:</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- </run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Medium'>Impressions</run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>: </run>
                <run fontcolor='#000000' fontsize='8'>Number of times the ad cmapaigns has been displayed</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- </run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Medium'>Clicks</run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>: </run>
                <run fontcolor='#000000' fontsize='8'>Number of clicks on the ad campaigns</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- </run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Medium'>New Sessions</run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>: </run>
                <run fontcolor='#000000' fontsize='8'>Online new sessions of a users on Web(GA4) or App(Adjust)</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- </run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Medium'>Quality Sessions</run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>: </run>
                <run fontcolor='#000000' fontsize='8'>At least 2 rows per sessions(triggers to Adjust/GA4)</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- </run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Medium'>Shop List Loaded Sessions</run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>: </run>
                <run fontcolor='#000000' fontsize='8'>The sessions which explored the shop.vendor list before placing the order</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- </run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Medium'>Add to cart sessions:</run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Æ </run>
                <run fontcolor='#000000' fontsize='8'>The sessions which added items in the cart</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- </run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Medium'>Signup Sessions</run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>: </run>
                <run fontcolor='#000000' fontsize='8'>The sessions which lead to Signup of a user</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- </run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Medium'>Purchase sessions</run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>: </run>
                <run fontcolor='#000000' fontsize='8'>The sessions which lead to the placement of orders</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- </run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Medium'>Acquisitions</run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>: </run>
                <run fontcolor='#000000' fontsize='8'>The last click attribution model from the third party tools with a calibration factor in place based on the incrementality and factoring iOS missing numbers as apple post iOS 14.5 release</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- </run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Medium'>Costs</run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'> : </run>
                <run fontcolor='#000000' fontsize='8'>Marketing related costs(mostly PM spend excluding TOM)</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- </run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Medium'>CPA</run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'> : </run>
                <run fontcolor='#000000' fontsize='8'>Total Costs/ Acquisitions</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- </run>
                <run bold='true' fontcolor='#000000'>PM Acquisitions</run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>:</run>
                <run bold='true' fontcolor='#000000' fontsize='8'>Æ </run>
                <run fontcolor='#000000' fontsize='8'>Acquisitions through PM channels (APP_REACH/RMA, DISPLAY_REACH/RMA, PAIDSOCIAL_REACH/RMA, SEM_CATEGORY, SEM_COMPETITOR, SEM_GENERIC, SEM_VENDOR, SEO_NONBRAND)</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- </run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Medium'>Incentivized Acquistions</run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>:</run>
                <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Æ </run>
                <run fontcolor='#000000' fontsize='8'>Acquisitions through Incentives including vouchers</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- </run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Medium'>Benchmark KPI</run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'> - </run>
                <run fontcolor='#000000' fontsize='8'> All the benchmarks are average of past four data points(If weekly then 4 weeks and 4 Months in case of Monthly)</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#000000' fontsize='8'>We combine our Adjust Attribution, iOSFix14.5+ and Calibrate all our acquisitions using the Calibration Factor.</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='8'>This results in 4 types of models you may see in Data Tables:</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='8'>1. 40-20-20 Attribution Model (Vanilla Acquisitions Android, GA4 and optin iOS)</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='8'>2. 40-20-40 with iOS fix (Acquisitions from GA4, Android and optin users + optout extrapolation acquisitions_ios14fix from the skan extrapolation)</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='8'>3. 40-20-20 with Calibration (Acquisitions without iOS Fix but calibrated - multiplied with a calibration factor)</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='8'>4. Calibrated with iOS14.5Fix (Web Acquisitions + App Acquisitions + iosfix skan extrapolated acquisitions all multiplied with Calibration factors)</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#000000' fontsize='8'>The most commonly used model is </run>
                <run bold='true' fontcolor='#000000' fontsize='8'>Calibrated with iOS14.5Fix</run>
                <run fontcolor='#000000' fontsize='8'> which we are using in this report:</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontsize='8'>Acquisitions calibration ios14fix</run>
                <run fontcolor='#000000' fontsize='8'>  (All + iOS acquisitions with SKAN Extrapolations * Calibration Factors)</run>
                <run>Æ&#10;</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone h='67715' id='191' param='vert' type-v2='layout-flow' w='24199' x='75000' y='31571'>
              <zone h='37572' id='11' is-scaled='1' param='Image/Delivery_Hero_Trading_Update_Q12022-custom-cover.jpg' type-v2='bitmap' w='24199' x='75000' y='31571'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone fixed-size='203' h='30143' id='14' is-fixed='true' type-v2='text' w='24199' x='75000' y='69143'>
                <formatted-text>
                  <run fontcolor='#000000' fontname='Tableau Bold' fontsize='15'>For any comments or feedback related to data and the report.</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontname='Tableau Bold' fontsize='15'>Please reach out to our slack channel</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#4e79a7' fontname='Tableau Bold' fontsize='15'>#mkt_report_alerts</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
            </zone>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
        </zone>
      </zones>
