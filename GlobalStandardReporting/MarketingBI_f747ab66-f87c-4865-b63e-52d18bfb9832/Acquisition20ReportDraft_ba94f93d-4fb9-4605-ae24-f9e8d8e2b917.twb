      <column caption='YoY % Acquisitions' datatype='real' default-format='p0%' name='[YoY % Orders (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_4910471744090103808]) &#10;/ &#10;(&#10;IF [Parameters].[Parameter 1 1] = &apos;Monthly&apos; THEN SUM([Total Acquisitions (copy)])&#10;ELSEIF [Parameters].[Parameter 1 1] = &apos;Weekly&apos; THEN SUM([Total Acquisitions Prev Y (copy 2)])&#10;ELSE NULL&#10;END&#10;) - 1' />
      </column>
      <column caption='YoY % Active Customers' datatype='real' default-format='p0%' name='[YoY % Vendors Active (copy)_404972163928846342]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([active_customers]) &#10;/ &#10;(&#10;IF [Parameters].[Parameter 1 1] = &apos;Monthly&apos; THEN SUM([prev_y_active_customers])&#10;ELSEIF [Parameters].[Parameter 1 1] = &apos;Weekly&apos; THEN SUM([prev_364d_active_customers])&#10;ELSE NULL&#10;END&#10;) - 1' />
      </column>
      <column caption='YoY % Vendors Online' datatype='real' default-format='p0%' name='[YoY % Vendors Active (copy)_404972163930624010]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendors_online]) &#10;/ &#10;(&#10;IF [Parameters].[Parameter 1 1] = &apos;Monthly&apos; THEN SUM([prev_y_vendors_online])&#10;ELSEIF [Parameters].[Parameter 1 1] = &apos;Weekly&apos; THEN SUM([prev_364d_vendors_online])&#10;ELSE NULL&#10;END&#10;) - 1' />
