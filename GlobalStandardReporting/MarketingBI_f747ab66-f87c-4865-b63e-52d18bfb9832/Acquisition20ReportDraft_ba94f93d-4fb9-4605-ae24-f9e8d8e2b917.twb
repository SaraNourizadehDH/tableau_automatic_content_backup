              <calculation class='tableau' formula='DATE(IF [report_type] = &apos;Monthly&apos; THEN&#13;&#10;DATETRUNC(&apos;month&apos;, DATETRUNC(&apos;month&apos;, TODAY()) -1)&#13;&#10;END)' />
