      <aliases enabled='yes' />
      <column caption='Acquisitions [w/out Vouchers]' datatype='real' name='[Acquisitions [w/ Vouchers]]  (copy)_175781164109746179]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Sub - Entity Breakdown (copy)]&#10;WHEN 1 THEN [acq_no_voucher] &#10;WHEN 2 THEN [acq_no_voucher_calibrated]&#10;END' />
      </column>
      <column caption='MoM % Orders' datatype='real' default-format='p0.00%' name='[Calculation2]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([Calculation_4910471744098205697])) - LOOKUP(ZN(SUM([Calculation_4910471744098205697])), -1))&#13;&#10; / ABS(LOOKUP(ZN(SUM([Calculation_4910471744098205697])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_1375568252552593408]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]=USERNAME()' />
      </column>
      <column caption='% Restaurants with 0 Orders' datatype='real' name='[Calculation_175781164102397953]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([restaurants_online] - [restaurants_active]) / SUM([restaurants_online])' />
      </column>
      <column caption='Acquisitions [w/ Vouchers] ' datatype='real' name='[Calculation_175781164109176834]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Sub - Entity Breakdown (copy)]&#10;WHEN 1 THEN [acq_voucher] &#10;WHEN 2 THEN [acq_voucher_calibrated]&#10;END' />
      </column>
      <column caption='Prev 364D Hard Failed Orders' datatype='real' name='[Calculation_2331949855219793929]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[prev_364d_hard_failed_orders_no_voucher] + [prev_364d_hard_failed_orders_voucher]' />
      </column>
      <column caption='Prev Y Hard Failed Orders' datatype='real' name='[Calculation_2331949855219892234]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[prev_y_hard_failed_orders_no_voucher] + [prev_y_hard_failed_orders_voucher]' />
      </column>
      <column caption='Orders [w/ Vouchers]' datatype='real' name='[Calculation_269090110487564289]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[reorders_voucher]+ [Calculation_175781164109176834]' />
      </column>
      <column caption='Sorting param' datatype='real' name='[Calculation_2936487717488758784]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Case [Parameters].[Parameter 10 1]&#10;WHEN 1 THEN SUM([Calculation_4910471744090103808])&#10;WHEN 2 THEN SUM([Calculation_4910471744098205697])&#10;END' />
      </column>
      <column caption='Chosen KPI' datatype='real' name='[Calculation_3072792005786984448]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 7 1]&#10;WHEN &apos;Acquisitions&apos; THEN SUM([Calculation_4910471744090103808])&#10;WHEN &apos;Reorders&apos; THEN SUM([Calculation_4910471744098377730])&#10;WHEN &apos;Orders&apos; THEN SUM([Calculation_4910471744098205697])&#10;// Next three variables should be averaged over time.&#10;WHEN &apos;Active Customers&apos; THEN&#10;    CASE [Parameters].[Parameter 1 1] &#10;    WHEN &apos;Daily&apos; THEN SUM({FIXED [placed_at_local], [city]: SUM([active_customers])}) &#10;    WHEN &apos;Weekly&apos; THEN SUM({FIXED [placed_at_local], [city]: SUM([active_customers])}) / 7&#10;    WHEN &apos;Monthly&apos; THEN SUM({FIXED [placed_at_local], [city]: SUM([active_customers])}) / 30&#10;    END&#10;WHEN  &apos;Vendors Online&apos; THEN&#10;    CASE [Parameters].[Parameter 1 1] &#10;    WHEN &apos;Daily&apos; THEN SUM({FIXED [placed_at_local], [city]: SUM([vendors_online])}) &#10;    WHEN &apos;Weekly&apos; THEN SUM({FIXED [placed_at_local], [city]: SUM([vendors_online])}) / 7&#10;    WHEN &apos;Monthly&apos; THEN SUM({FIXED [placed_at_local], [city]: SUM([vendors_online])}) / 30&#10;    END&#10;WHEN &apos;Vendors Active&apos; THEN&#10;    CASE [Parameters].[Parameter 1 1] &#10;    WHEN &apos;Daily&apos; THEN SUM({FIXED [placed_at_local], [city]: SUM([vendors_active])}) &#10;    WHEN &apos;Weekly&apos; THEN SUM({FIXED [placed_at_local], [city]: SUM([vendors_active])}) / 7&#10;    WHEN &apos;Monthly&apos; THEN SUM({FIXED [placed_at_local], [city]: SUM([vendors_active])}) / 30&#10;    END&#10;END' />
      </column>
      <column caption='KPIs (Comparison Switch)' datatype='real' name='[Calculation_3330271224987414529]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 11]&#10;WHEN &apos;Month&apos; THEN [KPIs (copy)]&#10;WHEN &apos;Year&apos;  THEN [MoM KPIs (copy)]&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='MoM % Active Customers' datatype='real' name='[Calculation_404972163909754880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(AVG({FIXED [placed_at_local]: SUM([active_customers])})) - LOOKUP(ZN(AVG({FIXED [placed_at_local]: SUM([active_customers])})), -1))&#10; / ABS(LOOKUP(ZN(AVG({FIXED [placed_at_local]: SUM([active_customers])})), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='MoM % Vendors Online' datatype='real' name='[Calculation_404972163909980161]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(AVG({FIXED [placed_at_local]: SUM([vendors_online])})) - LOOKUP(ZN(AVG({FIXED [placed_at_local]: SUM([vendors_online])})), -1))&#10; / ABS(LOOKUP(ZN(AVG({FIXED [placed_at_local]: SUM([vendors_online])})), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='City &amp; Display Name' datatype='string' name='[Calculation_404972163954331666]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='UPPER([city] + &apos; - &apos; + [sub_entity])' />
      </column>
      <column caption='Active Customer Base' datatype='integer' name='[Calculation_404972163954827283]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [placed_at_local], [city]: SUM([active_customers])}' />
      </column>
      <column caption='Penetration' datatype='real' name='[Calculation_404972163955077140]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_404972164009279523] / MAX([population])' />
      </column>
      <column caption='Acquisition Velocity' datatype='real' name='[Calculation_404972163955388437]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([placed_at_local] &gt;= DATEADD(&apos;month&apos;, -1, TODAY()), [Calculation_4910471744090103808], 0)) / MAX([population])' />
      </column>
      <column caption='Orders / Restaurant Online' datatype='real' name='[Calculation_404972163955707926]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_4910471744098205697]) / AVG({FIXED [placed_at_local], [city]: SUM([restaurants_online])})' />
      </column>
      <column caption='Active Customer Base (Last 6 Months)' datatype='real' name='[Calculation_404972164009279523]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IIF([placed_at_local] &gt;= DATEADD(&apos;month&apos;, -6, TODAY()), [Calculation_404972163954827283], NULL))' />
      </column>
      <column caption='Own Delivery Orders %' datatype='real' name='[Calculation_404972164012072997]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([own_delivery_orders]) / SUM([Calculation_4910471744098205697])' />
      </column>
      <column caption='Chosen KPI (Chosen Period)' datatype='real' name='[Calculation_4393613318563164161]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 11]&#10;WHEN &apos;Month&apos; THEN&#10;    CASE [Parameters].[Parameter 7 1]&#10;    WHEN &apos;Acquisitions&apos; THEN [MoM % Orders (copy)]&#10;    WHEN &apos;Reorders&apos; THEN [MoM % Orders (copy 2)]&#10;    WHEN &apos;Orders&apos; THEN [Calculation2]&#10;    WHEN &apos;Active Customers&apos; THEN [Calculation_404972163909754880]&#10;    WHEN &apos;Vendors Online&apos; THEN [Calculation_404972163909980161]&#10;    WHEN &apos;Vendors Active&apos; THEN [MoM % Vendors Online (copy)_404972163910127619]&#10;    END&#10;WHEN &apos;Year&apos; THEN&#10;    CASE [Parameters].[Parameter 7 1]&#10;    WHEN &apos;Acquisitions&apos; THEN [YoY % Orders (copy)]&#10;    WHEN &apos;Reorders&apos; THEN [YoY % Orders (copy 2)]&#10;    WHEN &apos;Orders&apos; THEN [Calculation_502714371759747084]&#10;    WHEN &apos;Active Customers&apos; THEN [YoY % Vendors Active (copy)_404972163928846342]&#10;    WHEN &apos;Vendors Online&apos; THEN [YoY % Vendors Active (copy)_404972163930624010]&#10;    WHEN &apos;Vendors Active&apos; THEN [YoY % Acquisitions (copy 4)_404972163928678405]&#10;    END&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Date View' datatype='date' default-format='*yyyy-mm-dd' name='[Calculation_457678357363400717]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE( &#13;&#10;IF [Parameters].[Parameter 1 1] = &quot;Daily&quot; THEN [placed_at_local]&#13;&#10;ELSEIF [Parameters].[Parameter 1 1] = &quot;Weekly&quot; THEN DATETRUNC(&apos;week&apos;,[placed_at_local],&apos;monday&apos;)&#13;&#10;ELSEIF [Parameters].[Parameter 1 1] = &quot;Monthly&quot; THEN DATETRUNC(&apos;month&apos;,[placed_at_local],&apos;monday&apos;)&#13;&#10;END&#13;&#10;)' />
      </column>
      <column caption='Acquisitions' datatype='real' name='[Calculation_4910471744090103808]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5 1]&#10;WHEN &apos;Used&apos; THEN [Calculation_175781164109176834]&#10;WHEN &apos;Non-Used&apos; THEN [Acquisitions [w/ Vouchers]]  (copy)_175781164109746179]&#10;WHEN &apos;All&apos; THEN [Calculation_175781164109176834]+ [Acquisitions [w/ Vouchers]]  (copy)_175781164109746179]&#10;END' />
      </column>
      <column caption='Orders' datatype='real' name='[Calculation_4910471744098205697]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_4910471744090103808] + [Calculation_4910471744098377730]' />
      </column>
      <column caption='Total Reorders' datatype='real' name='[Calculation_4910471744098377730]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5 1]&#10;WHEN &apos;Used&apos; THEN [reorders_voucher]&#10;WHEN &apos;Non-Used&apos; THEN [reorders_no_voucher]&#10;WHEN &apos;All&apos; THEN [reorders_voucher] + [reorders_no_voucher]&#10;END' />
      </column>
      <column caption='Total Commission' datatype='real' name='[Calculation_4910471744126128131]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4 2]&#10;WHEN &apos;EUR&apos; THEN [GMV EUR (copy 2)]&#10;WHEN &apos;USD&apos; THEN [Comission EUR (copy)]&#10;WHEN &apos;Local Currency&apos; THEN [Comission EUR (copy) (copy)]&#10;END' />
      </column>
      <column caption='GMV ' datatype='real' name='[Calculation_4910471744126939141]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4 2]&#10;WHEN &apos;EUR&apos; THEN [Calculation_4910471746574725140]&#10;WHEN &apos;USD&apos; THEN [GMV EUR (copy)]&#10;WHEN &apos;Local Currency&apos; THEN [GMV USD (copy)]&#10;END' />
      </column>
      <column caption='Total Orders not Accepted' datatype='real' hidden='true' name='[Calculation_4910471744135360518]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5 1]&#10;WHEN &apos;True&apos; THEN [orders_not_accepted_voucher]&#10;WHEN &apos;False&apos; THEN [orders_not_accepted_no_voucher]&#10;WHEN &apos;All&apos; THEN [orders_not_accepted_no_voucher] + [orders_not_accepted_voucher]&#10;END' />
      </column>
      <column caption='Total Voucher ' datatype='real' name='[Calculation_4910471744149733383]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4 2]&#10;WHEN &apos;EUR&apos; THEN [amt_voucher_eur]&#10;WHEN &apos;USD&apos; THEN [amt_voucher_usd]&#10;WHEN &apos;Local Currency&apos; THEN [amt_voucher_lc]&#10;END' />
      </column>
      <column caption='Total Orders Not Sent' datatype='real' name='[Calculation_4910471744519241736]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5 1]&#10;WHEN &apos;True&apos; THEN [orders_not_sent_voucher]&#10;WHEN &apos;False&apos; THEN [orders_not_sent_no_voucher]&#10;WHEN &apos;All&apos; THEN [orders_not_sent_no_voucher] + [orders_not_sent_voucher]&#10;END' />
      </column>
      <column caption='Channel Analysis Dimension' datatype='string' name='[Calculation_4910471744845221899]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6 2]&#10;WHEN &apos;Management Entity&apos;        THEN [management_entity]&#10;WHEN &apos;Sub-Entity&apos;               THEN [sub_entity]&#10;WHEN &apos;Country&apos;                  THEN [country]&#10;WHEN &apos;City&apos;                     THEN [city]        &#10;WHEN &apos;Platform Type&apos;            THEN [platform_type]&#10;WHEN &apos;Device&apos;                   THEN [platform]&#10;WHEN &apos;Channel&apos;                  THEN [channel]&#10;WHEN &apos;Channel-Sub-Channel&apos;      THEN [channel_subchannel]&#10;END' />
      </column>
      <column caption='KPI Switch - delta' datatype='real' name='[Calculation_4910471745102675985]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_502714371734159362] / LOOKUP([Calculation_502714371734159362], -1) ) -1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='KPI Switch - delta shape' datatype='integer' name='[Calculation_4910471745103151122]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2 1] != &apos;Declines&apos; AND [Parameters].[Parameter 2 1] != &apos;Not Sent&apos; AND [Calculation_4910471745102675985] &gt; 0 THEN 2&#10;ELSEIF [Parameters].[Parameter 2 1] != &apos;Declines&apos; AND [Parameters].[Parameter 2 1] != &apos;Not Sent&apos; AND [Calculation_4910471745102675985] &lt; 0 then -2&#10;ELSEIF [Calculation_4910471745102675985] &gt; 0 THEN -1&#10;ELSEIF [Calculation_4910471745102675985] &lt; 0 then 1&#10;ELSE 0&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='1' datatype='integer' name='[Calculation_4910471745106702355]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='GMV EUR' datatype='real' name='[Calculation_4910471746574725140]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5 1]&#10;WHEN &apos;Used&apos; THEN [amt_gmv_voucher_eur]&#10;WHEN &apos;Non-Used&apos; THEN [amt_gmv_no_voucher_eur]&#10;WHEN &apos;All&apos; THEN [amt_gmv_no_voucher_eur] + [amt_gmv_voucher_eur]&#10;END' />
      </column>
      <column caption='Commission Rate' datatype='real' default-format='p0.0%' name='[Calculation_492299738402304000]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_4910471744126128131]) / SUM([Calculation_4910471744126939141])' />
      </column>
      <column caption='Average Order Value' datatype='real' name='[Calculation_492299738402779137]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_4910471744126939141]) / SUM([total_orders])' />
      </column>
      <column caption='Mobile Orders' datatype='real' name='[Calculation_492299738404122627]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [platform_type] = &apos;App&apos; THEN [Calculation_4910471744098205697] ELSE 0 END' />
      </column>
      <column caption='Mobile Orders Share' datatype='real' default-format='p0.0%' name='[Calculation_492299738404663300]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_492299738404122627]) /SUM([Calculation_4910471744098205697])' />
