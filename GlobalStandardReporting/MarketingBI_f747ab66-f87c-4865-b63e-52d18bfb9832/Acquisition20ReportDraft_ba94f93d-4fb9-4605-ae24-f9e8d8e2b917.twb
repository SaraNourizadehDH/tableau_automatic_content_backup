      <table>
        <view>
          <datasources>
            <datasource caption='bima_tableau_mkt_l2_report_detailed+ (rl_mkt)' name='federated.0pz7bgc1jje6a01aw3cr906e24gw (copy)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Weekly' caption='Select Date View' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
              <calculation class='tableau' formula='&quot;week&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;quarter&quot;' value='Quarterly' />
                <alias key='&quot;week&quot;' value='Weekly' />
                <alias key='&quot;year&quot;' value='Yearly' />
              </aliases>
            </column>
            <column caption='Acquisitions/Orders/Reorders/Session/New' datatype='string' name='[Parameter 3 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Acquisitions&quot;'>
              <calculation class='tableau' formula='&quot;Acquisitions&quot;' />
            </column>
            <column caption='Attribution Model' datatype='string' name='[Parameter 6 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Calibrated with iOS 14.5 Fix&quot;'>
              <calculation class='tableau' formula='&quot;Calibrated with iOS 14.5 Fix&quot;' />
              <desc>
                <formatted-text>
                  <run>Choose from two different methods of distributing </run>
                  <run bold='true'>Acquisitions (not Orders)</run>
                  <run> to channels. 40-20-40 uses only digital touchpoints in the click-chain, whereas Exit Polls take into account offline channels like TV/OOH etc. from the Exit Poll data.</run>
                </formatted-text>
              </desc>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0pz7bgc1jje6a01aw3cr906e24gw (copy)'>
            <column caption='week_daste' datatype='datetime' name='[Calculation_1488791557858840584]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF YEAR([date]) = 2017 THEN DATETRUNC(&apos;week&apos;, [date] - 7, &apos;monday&apos;)&#10;ELSE DATETRUNC(&apos;week&apos;, [date], &apos;monday&apos;)&#10;END' />
            </column>
            <column caption='Channel  ' datatype='string' name='[Calculation_152418765089320963]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[channel]' />
