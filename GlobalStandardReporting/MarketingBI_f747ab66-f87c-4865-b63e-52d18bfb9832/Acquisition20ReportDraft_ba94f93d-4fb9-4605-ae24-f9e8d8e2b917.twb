      <column caption='Switch: CPA/CPO/CPRO' datatype='real' default-format='c&quot;€&quot;#,##0.00;(&quot;€&quot;#,##0.00)' name='[Switch: Acquisitions/Orders (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3 1] = &apos;Acquisitions&apos; THEN [Calculation_239535208184770565]&#13;&#10;ELSEIF [Parameters].[Parameter 3 1] = &apos;Orders&apos; THEN [CPA (copy)]&#13;&#10;ELSEIF [Parameters].[Parameter 3 1] = &apos;Reorders&apos; THEN SUM([Calculation_1779695940233924609]) / SUM([reorders])&#13;&#10;END' />
      </column>
      <column caption='Switch: Acquisitions/Orders/Costs' datatype='real' name='[Switch: Acquisitions/Orders/Reorders (copy 2)_6110610676561911808]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Acquisitions/Orders/Reorders (copy 2)_6110610676562071553]&#13;&#10;WHEN &apos;Acquisitions&apos; THEN SUM([Calculation_5742089557526224896])&#13;&#10;WHEN &apos;Orders&apos; THEN SUM([orders])&#13;&#10;WHEN &apos;Costs&apos; THEN SUM([Calculation_1779695940233924609])&#13;&#10;WHEN &apos;Sessions&apos; THEN SUM([sessions])&#13;&#10;WHEN &apos;New Visits/Installs&apos; THEN SUM([new_sessions])&#13;&#10;END' />
      </column>
      <column caption='Switch: KPI Switch' datatype='real' name='[Switch: Acquisitions/Orders/Reorders (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Acquisitions/Orders/Reorders (copy)]&#10;WHEN &apos;Acquisitions&apos;     THEN [Calculation_3629056893959417856]&#10;WHEN &apos;Orders&apos;           THEN SUM([Switch: Voucher Switch (copy)_3629056893961940993])&#10;WHEN &apos;Reorders&apos;         THEN SUM([Switch: Orders Voucher Switch (copy)_3629056893962973186])&#10;WHEN &apos;Costs&apos;            THEN SUM([Calculation_1779695940233924609])&#10;WHEN &apos;CPA&apos;              THEN SUM([Calculation_1779695940233924609]) / SUM([Calculation_5742089557526224896])&#10;END' />
      </column>
      <column caption='Switch: Reorders Voucher Switch' datatype='real' name='[Switch: Orders Voucher Switch (copy)_3629056893962973186]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 9]&#10;WHEN &apos;Yes&apos;   THEN [reorders_with_voucher]&#10;WHEN &apos;No&apos;    THEN [reorders] - [reorders_with_voucher]&#10;WHEN &apos;(All)&apos; THEN [reorders]&#10;END' />
      </column>
      <column caption='Switch: Orders Voucher Switch' datatype='real' name='[Switch: Voucher Switch (copy)_3629056893961940993]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 9]&#10;WHEN &apos;Yes&apos;   THEN [orders_with_voucher]&#10;WHEN &apos;No&apos;    THEN [Acquisitions without Voucher (copy)]&#10;WHEN &apos;(All)&apos; THEN [orders]&#10;END' />
      </column>
      <column caption='Switch: KPI Switch - delta' datatype='real' default-format='p0.00%' name='[Switch: delta Acquisitions/Orders/Reorders (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Switch: Acquisitions/Orders/Reorders (copy)] / LOOKUP([Switch: Acquisitions/Orders/Reorders (copy)], -1) ) -1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Switch: KPI Switch - delta Shape' datatype='integer' name='[Switch: delta Shape (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Acquisitions/Orders/Reorders (copy)] != &apos;Costs&apos; AND [Parameters].[Acquisitions/Orders/Reorders (copy)] != &apos;CPA&apos; AND [Switch: delta Acquisitions/Orders/Reorders (copy)] &gt; 0 THEN 1&#13;&#10;ELSEIF [Parameters].[Acquisitions/Orders/Reorders (copy)] != &apos;Costs&apos; AND [Parameters].[Acquisitions/Orders/Reorders (copy)] != &apos;CPA&apos; AND [Switch: delta Acquisitions/Orders/Reorders (copy)] &lt; 0 then -1&#10;ELSEIF [Switch: delta Acquisitions/Orders/Reorders (copy)] &gt; 0 THEN -2&#10;ELSEIF [Switch: delta Acquisitions/Orders/Reorders (copy)] &lt; 0 then 2&#13;&#10;ELSE 0&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
