      <aliases enabled='yes' />
      <column caption='# Dif. Actuals vs Targets: Orders' datatype='real' name='[# Dif. Acquisitions: Actuals vs Targets (copy) (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders]) - SUM([orders_target])' />
      </column>
      <column caption='# Dif. Actuals vs Targets: Costs' datatype='real' name='[# Dif. Acquisitions: Actuals vs Targets (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1779695940233924609]) - SUM([Costs (copy)])' />
      </column>
      <column caption='% Dif. Actuals vs Targets: Acquisitions' datatype='real' name='[# Dif. Actuals vs Targets: Acquisitions (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_5742089557526224896]) - SUM([acquisitions_target])) / SUM([acquisitions_target])' />
      </column>
      <column caption='% Dif. Actuals vs Targets: CPA' datatype='real' hidden='true' name='[# Dif. Actuals vs Targets: CPA (copy 2)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_239535208184770565] - [Acquisitions [Target]] (switch) (copy)]) / [Acquisitions [Target]] (switch) (copy)]' />
      </column>
      <column caption='# Dif. Actuals vs Targets: CPO' datatype='real' name='[# Dif. Actuals vs Targets: CPA (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[CPA (copy)] - [CPA Target Overall (copy)]' />
      </column>
      <column caption='# Dif. Actuals vs Targets: CPA' datatype='real' hidden='true' name='[# Dif. Actuals vs Targets: Orders (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_239535208184770565] - [Acquisitions [Target]] (switch) (copy)]' />
      </column>
      <column caption='2. Dimension' datatype='string' name='[1. Dimension  (copy)]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[1. Dimension Switch (copy)]&#10;WHEN &apos;Date&apos;                     THEN STR(DATE([Calculation_671317880946876416]))&#13;&#10;WHEN &apos;Management Entity&apos;        THEN [management_entity]&#13;&#10;WHEN &apos;Display Name&apos;             THEN [display_name]&#13;&#10;WHEN &apos;Country&apos;                  THEN [country]&#13;&#10;WHEN &apos;Platform Type&apos;            THEN [platform_type]&#10;WHEN &apos;Platform&apos;                 THEN [platform]&#13;&#10;WHEN &apos;Channel&apos;                  THEN [Calculation_152418765089320963]&#13;&#10;WHEN &apos;Sub-Channel&apos;              THEN [Channel (U/EP) (copy)]&#13;&#10;WHEN &apos;Channel - Sub-Channel&apos;    THEN [Channel - Sub-Channel (copy)] &#13;&#10;WHEN &apos;Device&apos;                   THEN [platform_type]&#13;&#10;END' />
        <aliases>
          <alias key='&quot;SOCIALMEDIAENGAGEMENT&quot;' value='SOCIALMEDIA ENGAGEMENT' />
        </aliases>
      </column>
      <column caption='Acq. CVR**' datatype='real' default-format='p0.0%' name='[Acq. CVR* (copy 2)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Acquisitions* (copy 2)]) / SUM([Sessions* (copy)])' />
      </column>
      <column caption='Acq. Share*' datatype='real' default-format='p0.0%' name='[Acq. CVR* (copy 3)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_661466202874945536]) / SUM([Acquisitions* (copy)])' />
      </column>
      <column caption='Order CVR*' datatype='real' default-format='p0.0%' name='[Acq. CVR* (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Acquisitions* (copy)]) / SUM([Acquisitions* (copy) (copy)])' />
      </column>
      <column caption='Orders #YoY' datatype='real' name='[Acquisitions #YoY (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders])&#10;-&#10;SUM(IF [Parameters].[Parameter 1] = &apos;month&apos; THEN ([prev_y_reorders])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;week&apos; THEN ([prev_364d_reorders])&#10;ELSE NULL&#10;END)' />
      </column>
      <column caption='Orders *' datatype='real' name='[Acquisitions * (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders])-SUM([orders_with_voucher])' />
      </column>
      <column caption='CPA [Target] (switch)' datatype='real' name='[Acquisitions [Target]] (switch) (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Costs (copy)]) / SUM([acquisitions_target])' />
      </column>
      <column caption='Acquisitions without Voucher' datatype='real' name='[Acquisitions with Voucher (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Calculation_5742089557526224896], 0) - IFNULL([Calculation_2457065499950333953], 0)' />
      </column>
      <column caption='Orders without Voucher' datatype='real' name='[Acquisitions without Voucher (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([orders], 0) - IFNULL([orders_with_voucher], 0)' />
      </column>
      <column caption='Acquisitions**' datatype='real' name='[Acquisitions* (copy 2)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [date] &gt;= [Parameters].[Interval 1: Start (copy)] AND [date] &lt;= [Parameters].[Interval 1: Start (copy) (copy)] THEN [Calculation_5742089557526224896] ELSE 0 END' />
      </column>
      <column caption='Costs*' datatype='real' default-format='c&quot;€&quot;#,##0;(&quot;€&quot;#,##0)' name='[Acquisitions* (copy) (copy 2)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [date] &gt;= [Parameters].[Parameter 4] AND [date] &lt;= [Parameters].[Interval 1: Start (copy 2)] THEN [Calculation_1779695940233924609] ELSE 0 END' />
      </column>
      <column caption='CPA*' datatype='real' default-format='c&quot;€&quot;#,##0.00;(&quot;€&quot;#,##0.00)' name='[Acquisitions* (copy) (copy) (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Acquisitions* (copy) (copy 2)]) / SUM([Calculation_661466202874945536])' />
      </column>
      <column caption='Sessions*' datatype='integer' name='[Acquisitions* (copy) (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_671317880946876416] &gt;= [Parameters].[Parameter 4] AND [Calculation_671317880946876416] &lt;= [Parameters].[Interval 1: Start (copy 2)] THEN [sessions] ELSE 0 END' />
      </column>
      <column caption='Orders*' datatype='real' name='[Acquisitions* (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [date] &gt;= [Parameters].[Parameter 4] AND [date] &lt;= [Parameters].[Interval 1: Start (copy 2)] THEN [orders] ELSE 0 END' />
      </column>
      <column caption='CPO' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[CPA (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1779695940233924609]) / SUM([orders])' />
      </column>
      <column caption='CPO Target Overall' datatype='real' name='[CPA Target Overall (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL([Costs (copy)], 0))&#10;/&#10;SUM(IFNULL([orders_target],0))' />
      </column>
      <column caption='CPA YoY%' datatype='real' default-format='p0.00%' name='[CPA YoY% (copy)_5904782079013179393]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_239535208184770565]&#10;/ &#10;(&#10;IF [Parameters].[Parameter 1] = &apos;month&apos; THEN [Calculation_1488791557807788035]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;week&apos; THEN [CPA [prev. Year]] (copy)]&#10;ELSE NULL&#10;END&#10;) - 1' />
      </column>
      <column caption='CPA [Budget] (switch)' datatype='real' name='[CPA [Target]] (switch) (copy)_2705185690685894660]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Costs [Targets]] (copy)_2705185690679029760]) / SUM([acquisitions_budget])' />
      </column>
      <column caption='CPA [prev. 364 Days]' datatype='real' name='[CPA [prev. Year]] (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Costs [prev. Year]] (copy)]) / SUM([prev_364d_acquisitions])' />
      </column>
      <column caption='CPA**' datatype='real' default-format='c&quot;€&quot;#,##0.00;(&quot;€&quot;#,##0.00)' name='[CPA* (copy 2)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Costs* (copy)]) / SUM([Acquisitions* (copy 2)])' />
      </column>
      <column caption='Acq. CVR*' datatype='real' default-format='p0.0%' name='[CPA* (copy) (copy 2)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_661466202874945536]) / SUM([Acquisitions* (copy) (copy)])' />
      </column>
      <column caption='CPO*' datatype='real' default-format='c&quot;€&quot;#,##0.00;(&quot;€&quot;#,##0.00)' name='[CPA* (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Acquisitions* (copy) (copy 2)]) / SUM([Acquisitions* (copy)])' />
      </column>
      <column caption='CPO**' datatype='real' default-format='c&quot;€&quot;#,##0.00;(&quot;€&quot;#,##0.00)' name='[CPO* (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Costs* (copy)]) / SUM([Orders* (copy)])' />
      </column>
      <column caption='CVR' datatype='real' default-format='p0.0%' name='[CVR App (copy) (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([transactions]) / SUM([sessions])' />
      </column>
      <column caption='Platform 1' datatype='string' name='[Calculation_110338253990768641]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;1&apos;' />
        <aliases>
          <alias key='&quot;1&quot;' value='     ← Hover and Press  &quot;-&quot;  to aggregate all Platform Types and see overall CR --- Split out again by pressing  &quot;+&quot;' />
        </aliases>
      </column>
      <column caption='Voucher Share Acqs.' datatype='real' default-format='p0.00%' name='[Calculation_110338254237417474]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_2457065499950333953]) / SUM([Calculation_5742089557526224896])' />
      </column>
      <column caption='Voucher Share Orders' datatype='real' name='[Calculation_110338254239457283]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_with_voucher])/SUM([orders])' />
      </column>
      <column caption='CPA [prev. Year]' datatype='real' name='[Calculation_1488791557807788035]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1779695940238405635]) / SUM([prev_y_acquisitions])' />
      </column>
      <column caption='Switch: Acquisitions/Orders/Reorders Share' datatype='real' name='[Calculation_1488791557813526533]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//IF [Acquisitions/Orders/Reorders] = &apos;Acquisitions&apos; THEN SUM({FIXED [1. Dimension ], [Date]: SUM([Acquisition Attr.])}) / SUM({FIXED [Date]: SUM([Acquisition Attr.])})&#10;//ELSEIF [Acquisitions/Orders/Reorders] = &apos;Orders&apos; THEN SUM({FIXED [1. Dimension ], [Date]: SUM([Orders])}) / SUM({FIXED [Date]: SUM([Orders])})&#10;//ELSEIF [Acquisitions/Orders/Reorders] = &apos;Reorders&apos; THEN SUM({FIXED [1. Dimension ], [Date]: SUM([Reorders])}) / SUM({FIXED [Date]: SUM([Reorders])})&#10;//END&#10;&#10;IF [Parameters].[Parameter 3 1] = &apos;Acquisitions&apos; THEN SUM([Calculation_5742089557526224896]) / TOTAL(SUM([Calculation_5742089557526224896]))&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Absolute/Relative KPI' datatype='real' name='[Calculation_1488791557814456326]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 7] = &apos;absolute&apos; THEN [Calculation_540713433321926661]&#10;ELSEIF [Parameters].[Parameter 7] = &apos;relative&apos; then [Calculation_1488791557813526533]&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='week_daste' datatype='datetime' name='[Calculation_1488791557858840584]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF YEAR([date]) = 2017 THEN DATETRUNC(&apos;week&apos;, [date] - 7, &apos;monday&apos;)&#10;ELSE DATETRUNC(&apos;week&apos;, [date], &apos;monday&apos;)&#10;END' />
      </column>
      <column caption='graph 2.2 filter' datatype='boolean' name='[Calculation_152418764412493824]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Set 1]' />
      </column>
      <column caption='graph 2.1 title' datatype='string' name='[Calculation_152418764685488129]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;SEM NonBrand&apos;' />
      </column>
      <column caption='Channel  ' datatype='string' name='[Calculation_152418765089320963]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[channel]' />
      </column>
      <column caption='Calibration Start' datatype='datetime' name='[Calculation_1585618929684299777]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [is_calibrated] = 1 THEN [date] ELSE NULL END' />
      </column>
      <column caption='Calibration?' datatype='string' name='[Calculation_1585618929685217282]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM(IFNULL([is_calibrated], 0)) &gt; 0 THEN &apos;Yes&apos; ELSE &apos;No&apos; END' />
      </column>
      <column caption='Costs' datatype='real' name='[Calculation_1779695940233924609]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;EUR&apos; THEN [costs_eur]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;USD&apos; THEN [costs_usd]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;LC&apos; THEN [costs_lc]&#10;END' />
      </column>
      <column caption='Costs [prev. Year]' datatype='real' name='[Calculation_1779695940238405635]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;EUR&apos; THEN [prev_y_costs_eur]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;USD&apos; THEN [prev_y_costs_usd]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;LC&apos; THEN [prev_y_costs_lc]&#10;END' />
      </column>
      <column caption='GMV All' datatype='real' name='[Calculation_1779695940292497412]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;EUR&apos; THEN [amt_gmv_eur]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;USD&apos; THEN [amt_gmv_usd]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;LC&apos; THEN [amt_gmv_lc]&#10;END' />
      </column>
      <column caption='Voucher Amount' datatype='real' name='[Calculation_1779695940295733254]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;EUR&apos; THEN [amt_voucher_eur]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;USD&apos; THEN [amt_voucher_usd]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;LC&apos; THEN [amt_voucher_lc]&#10;END' />
      </column>
      <column caption='aCVR' datatype='real' default-format='p0.00%' name='[Calculation_231090960986861575]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//SUM([Acquisition Attr.]) / SUM([Sessions])&#10;SUM([Calculation_5742089557526224896]) / SUM([new_sessions])' />
      </column>
      <column caption='Acquisitions Share' datatype='real' default-format='p0.00%' name='[Calculation_231090961335713809]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_5742089557526224896]) / SUM([orders])' />
      </column>
      <column caption='Channel - Sub-Channel' datatype='string' name='[Calculation_239535208154656768]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[channel] + &quot; - &quot; + [sub_channel]' />
      </column>
      <column caption='1. Dimension' datatype='string' name='[Calculation_239535208155246593]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Date&apos;                     THEN STR(DATE([Calculation_671317880946876416]))&#10;WHEN &apos;Management Entity&apos;        THEN [management_entity]&#10;WHEN &apos;Display Name&apos;             THEN [display_name]&#10;WHEN &apos;Country&apos;                  THEN [country]&#10;WHEN &apos;Platform Type&apos;            THEN [platform_type]&#10;WHEN &apos;Platform&apos;                 THEN [platform]&#10;WHEN &apos;Channel&apos;                  THEN [Calculation_152418765089320963]&#10;WHEN &apos;Sub-Channel&apos;              THEN [Channel (U/EP) (copy)]&#10;WHEN &apos;Channel - Sub-Channel&apos;    THEN [Channel - Sub-Channel (copy)]&#10;END' />
        <aliases>
          <alias key='&quot;SOCIALMEDIAENGAGEMENT&quot;' value='SOCIALMEDIA ENGAGEMENT' />
        </aliases>
      </column>
      <column caption='CPA' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_239535208184770565]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1779695940233924609]) / SUM([Calculation_5742089557526224896])' />
      </column>
      <column caption='1' datatype='real' name='[Calculation_239535208187621384]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0.3' />
      </column>
      <column caption='Returning Visitors' datatype='integer' name='[Calculation_2457065499945586688]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL([sessions], 0)) - SUM(IFNULL([new_sessions], 0))' />
      </column>
      <column caption='Acquisitions with Voucher' datatype='real' name='[Calculation_2457065499950333953]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6 1]&#10;WHEN &apos;40-20-40&apos; THEN [acquisitions_with_voucher]&#10;WHEN &apos;Calibrated&apos; THEN [acquisitions_with_vouchers_calibration]&#10;END' />
      </column>
      <column caption='Acquisitions (no Voucher)' datatype='real' name='[Calculation_2457065499956469762]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_5742089557526224896]) - SUM([Calculation_2457065499950333953])' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_2707718907808944128]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Switch: Acquisitions Voucher Switch' datatype='real' name='[Calculation_3629056893959417856]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 9]&#10;WHEN &apos;Yes&apos;   THEN SUM([Calculation_2457065499950333953])&#10;WHEN &apos;No&apos;    THEN [Calculation_2457065499956469762]&#10;WHEN &apos;(All)&apos; THEN SUM([Calculation_5742089557526224896])&#10;END' />
      </column>
      <column caption='Date Filter' datatype='boolean' name='[Calculation_4301148783956627456]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_671317880946876416] &lt;= TODAY()' />
      </column>
      <column caption='Costs YoY%' datatype='real' name='[Calculation_463870774140096512]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_1779695940233924609])&#10;/ &#10;IF [Parameters].[Parameter 1] = &apos;month&apos; THEN SUM([Calculation_1779695940238405635])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;week&apos; THEN SUM([Costs [prev. Year]] (copy)])&#10;ELSE NULL&#10;END&#10;) - 1' />
      </column>
      <column caption='Orders YoY%' datatype='real' name='[Calculation_463870774141112321]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders]) / &#10;SUM(&#10;IF [Parameters].[Parameter 1] = &apos;month&apos; THEN ([prev_y_reorders])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;week&apos; THEN ([prev_364d_reorders])&#10;ELSE NULL&#10;END&#10;) - 1' />
      </column>
      <column caption='Acquisitions %YoY' datatype='real' name='[Calculation_4893442481246351360]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_5742089557526224896]) &#10;/ &#10;(&#10;IF [Parameters].[Parameter 1] = &apos;month&apos; THEN SUM([prev_y_acquisitions])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;week&apos; THEN SUM([prev_364d_acquisitions])&#10;ELSE NULL&#10;END&#10;) - 1' />
      </column>
      <column caption='Switch: Acquisitions/Orders/Reorders' datatype='real' name='[Calculation_540713433321926661]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3 1] = &apos;Acquisitions&apos; THEN SUM([Calculation_5742089557526224896])&#13;&#10;ELSEIF [Parameters].[Parameter 3 1] = &apos;Orders&apos; THEN SUM([orders])&#13;&#10;ELSEIF [Parameters].[Parameter 3 1] = &apos;Reorders&apos; THEN SUM([reorders])&#13;&#10;ELSEIF [Parameters].[Parameter 3 1] = &apos;Sessions&apos; THEN SUM([sessions])&#13;&#10;ELSEIF [Parameters].[Parameter 3 1] = &apos;New Visits/Installs&apos; THEN SUM([new_sessions])&#13;&#10;END' />
      </column>
      <column caption='Acquisitions Attr.' datatype='real' name='[Calculation_5742089557526224896]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6 1] &#13;&#10;WHEN &apos;40-20-40&apos; THEN [acquisitions]&#13;&#10;WHEN &apos;Calibrated&apos; THEN [acquisitions_calibration]&#13;&#10;WHEN &apos;40-20-40 with iOS 14.5 Fix&apos; THEN [acquisitions_ios14fix]&#13;&#10;WHEN &apos;Calibrated with iOS 14.5 Fix&apos; THEN [acquisitions_calibration_ios14fix]&#13;&#10;END' />
      </column>
      <column caption='Acquisitions #YoY' datatype='real' name='[Calculation_629729910394109952]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_5742089557526224896])&#10;-&#10;IF [Parameters].[Parameter 1] = &apos;month&apos; THEN SUM([prev_y_acquisitions])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;week&apos; THEN SUM([prev_364d_acquisitions])&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Channel Filter Targets --&gt; TRUE' datatype='boolean' name='[Calculation_629729910399922177]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[sub_channel] != &apos;&lt;Targets&gt;&apos;' />
      </column>
      <column caption='Noted' datatype='string' name='[Calculation_639511184137678854]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Note&quot;' />
        <aliases>
          <alias key='&quot;Note&quot;' value='Attribution Model INFO    &gt;&gt;' />
        </aliases>
      </column>
      <column caption='Acquisitions*' datatype='real' name='[Calculation_661466202874945536]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [date] &gt;= [Parameters].[Parameter 4] AND [date] &lt;= [Parameters].[Interval 1: Start (copy 2)] THEN [Calculation_5742089557526224896] ELSE 0 END' />
      </column>
      <column caption='Δ Acq.*' datatype='real' default-format='p0.0%' name='[Calculation_661466202879299585]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='( SUM([Calculation_661466202874945536]) / SUM([Acquisitions* (copy 2)]) ) - 1' />
      </column>
      <column caption='Calibration Tooltip' datatype='string' name='[Calculation_6709519053889019904]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 6 1] = &apos;Calibrated&apos; THEN&#10;    IF {COUNTD([country])} = 1&#10;        THEN &apos;Calibration Factor: &apos;+LEFT(STR({FIXED [Calculation_239535208154656768],[date] : MAX(IF [Calculation_1585618929684299777] = [date] THEN [calibration_factor] END)}),5)&#10;        ELSE &apos;Select a country to see the Calibration Factor&apos;&#10;    END&#10;END' />
      </column>
      <column caption='Date' datatype='datetime' default-format='*YY-MM-DD' name='[Calculation_671317880946876416]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATETRUNC([Parameters].[Parameter 1],[date],&apos;monday&apos;)' />
      </column>
      <column caption='CPA [Target]' datatype='real' hidden='true' name='[Calculation_7025615440671080450]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL([Costs (copy)], 0))&#10;/&#10;SUM([acquisitions_target])' />
      </column>
      <column caption='# Dif. Actuals vs Targets: Acquisitions' datatype='real' hidden='true' name='[Calculation_7025615440675168261]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_5742089557526224896]) - SUM([acquisitions_target])' />
      </column>
      <column caption='New Sessions/Acquisitions' datatype='real' name='[Calculation_7025615442075684870]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 8]&#10;WHEN 1 THEN [new_sessions]&#10;WHEN 2 THEN [Calculation_5742089557526224896]&#10;END' />
      </column>
      <column caption='Sub-Channel   ' datatype='string' name='[Channel (U/EP) (copy)]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[sub_channel]' />
      </column>
      <column datatype='string' name='[Channel - Sub-Channel (U/E) (copy)]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_152418765089320963] + &#10;IF [Channel (U/EP) (copy)] = &apos;&apos; THEN &apos;&apos;&#10;ELSEIF [channel] = &apos;SEM&apos; AND [Channel (U/EP) (copy)] = &apos;GENERIC&apos; THEN &quot; - &quot; + [Channel (U/EP) (copy)] + &quot; - &quot; + [platform_type]&#10;ELSE &quot; - &quot; + [Channel (U/EP) (copy)] END' />
        <aliases>
          <alias key='&quot;SEM - NONBRAND&quot;' value='  ' />
          <alias key='&quot;SEM - RESTAURANTS&quot;' value='SEM - REST.' />
        </aliases>
      </column>
      <column caption='Channel - Sub-Channel 1; EP FILTER' datatype='string' name='[Channel - Sub-Channel (copy 2)]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[channel] + &quot; - &quot; + IF [channel] = &apos;SEO&apos; AND [sub_channel] = &apos;&apos; THEN &apos;NONBRAND&apos; ELSE [sub_channel] END' />
      </column>
      <column caption='Channel - Sub-Channel ' datatype='string' name='[Channel - Sub-Channel (copy 3)]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[channel] + &quot; - &quot; + [sub_channel]' />
      </column>
      <column caption='Channel - Sub-Channel   ' datatype='string' name='[Channel - Sub-Channel (copy)]' role='dimension' type='nominal'>
