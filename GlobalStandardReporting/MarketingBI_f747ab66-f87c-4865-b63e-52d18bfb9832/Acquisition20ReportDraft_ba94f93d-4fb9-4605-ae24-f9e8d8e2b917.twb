      <column caption='Web Orders' datatype='real' name='[Mobile Orders (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [platform_type] = &apos;Web&apos; THEN [Calculation_4910471744098377730] ELSE 0 END' />
      </column>
      <column caption='Restaurants Online / 1000 Pop' datatype='real' name='[Online Restaurants per 1000 (copy)_404972163956113431]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG({FIXED [placed_at_local], [city]: SUM([restaurants_online])}) / (MAX([population])/1000)' />
      </column>
      <column caption='Share Reorders' datatype='real' default-format='p0.00%' name='[Share Acquisition (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_4910471744098377730]) / SUM([Calculation_4910471744098205697])' />
      </column>
      <column caption='Web Orders Share' datatype='real' default-format='p0.0%' name='[Share Mobile Orders (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Mobile Orders (copy)])/ SUM([Calculation_4910471744098377730])' />
      </column>
      <column caption='Share Unsuccessful Orders' datatype='real' default-format='p0.00%' name='[Share Reorders (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_4910471744519241736])/SUM([Calculation_4910471744098205697])' />
      </column>
      <column caption='Fail Rate' datatype='real' default-format='p0.00%' name='[Share Unsuccessful Orders (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Total Orders Not Sent (copy)]) / SUM([total_orders])' />
      </column>
      <column caption='City Country Share Acq' datatype='real' name='[Top 10 city share (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_4910471744090103808])/ SUM([Fixed brand Aquisitions (copy)])' />
      </column>
      <column caption='Total Acquisitions Prev Y' datatype='real' name='[Total Acquisitions (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Sub - Entity Breakdown (copy)]&#10;WHEN 1 THEN &#10;    CASE [Parameters].[Parameter 5 1]&#10;    WHEN &apos;True&apos; THEN [prev_y_acq_voucher]&#10;    WHEN &apos;False&apos; THEN [prev_y_acq_no_voucher]&#10;    WHEN &apos;All&apos; THEN [prev_y_acq_voucher]+[prev_y_acq_no_voucher]&#10;    END&#10;WHEN 2 THEN &#10;    CASE [Parameters].[Parameter 5 1]&#10;    WHEN &apos;True&apos; THEN [prev_y_acq_voucher_calibrated]&#10;    WHEN &apos;False&apos; THEN [prev_y_acq_no_voucher_calibrated]&#10;    WHEN &apos;All&apos; THEN [prev_y_acq_voucher_calibrated]+[prev_y_acq_no_voucher_calibrated]&#10;    END&#10;END' />
      </column>
      <column caption='Total Reorders Prev 364' datatype='real' name='[Total Acquisitions Prev 364 (copy 2)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5 1]&#10;WHEN &apos;True&apos; THEN [prev_364d_reorders_voucher]&#10;WHEN &apos;False&apos; THEN [prev_364d_reorders_no_voucher]&#10;WHEN &apos;All&apos; THEN [prev_364d_reorders_voucher]+[prev_364d_reorders_no_voucher]&#10;END' />
      </column>
      <column caption='Total Orders Prev 364' datatype='real' name='[Total Acquisitions Prev 364 (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Sub - Entity Breakdown (copy)]&#10;WHEN 1 THEN &#10;    CASE [Parameters].[Parameter 5 1]&#10;    WHEN &apos;True&apos; THEN [prev_364d_acq_voucher] + [prev_364d_reorders_voucher]&#10;    WHEN &apos;False&apos; THEN [prev_364d_acq_no_voucher] + [prev_364d_reorders_no_voucher]&#10;    WHEN &apos;All&apos; THEN [prev_364d_acq_voucher]+[prev_364d_acq_no_voucher] + [prev_364d_reorders_no_voucher] + [prev_364d_reorders_voucher]&#10;    END&#10;WHEN 2 THEN &#10;    CASE [Parameters].[Parameter 5 1]&#10;    WHEN &apos;True&apos; THEN [prev_364d_acq_voucher_calibrated] + [prev_364d_reorders_voucher]&#10;    WHEN &apos;False&apos; THEN [prev_364d_acq_no_voucher_calibrated] + [prev_364d_reorders_no_voucher]&#10;    WHEN &apos;All&apos; THEN [prev_364d_acq_voucher_calibrated]+[prev_364d_acq_no_voucher_calibrated] + [prev_364d_reorders_no_voucher] + [prev_364d_reorders_voucher]&#10;    END&#10;END' />
      </column>
      <column caption='Total Acquisitions Prev 364' datatype='real' name='[Total Acquisitions Prev Y (copy 2)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Sub - Entity Breakdown (copy)]&#10;WHEN 1 THEN &#10;    CASE [Parameters].[Parameter 5 1]&#10;    WHEN &apos;True&apos; THEN [prev_364d_acq_voucher]&#10;    WHEN &apos;False&apos; THEN [prev_364d_acq_no_voucher]&#10;    WHEN &apos;All&apos; THEN [prev_364d_acq_voucher]+[prev_364d_acq_no_voucher]&#10;    END&#10;WHEN 2 THEN &#10;    CASE [Parameters].[Parameter 5 1]&#10;    WHEN &apos;True&apos; THEN [prev_364d_acq_voucher_calibrated]&#10;    WHEN &apos;False&apos; THEN [prev_364d_acq_no_voucher_calibrated]&#10;    WHEN &apos;All&apos; THEN [prev_364d_acq_voucher_calibrated]+[prev_364d_acq_no_voucher_calibrated]&#10;    END&#10;END' />
      </column>
      <column caption='Total Orders Prev Y' datatype='real' name='[Total Acquisitions Prev Y (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Sub - Entity Breakdown (copy)]&#10;WHEN 1 THEN &#10;    CASE [Parameters].[Parameter 5 1]&#10;    WHEN &apos;True&apos; THEN [prev_y_acq_voucher] + [prev_y_reorders_voucher]&#10;    WHEN &apos;False&apos; THEN [prev_y_acq_no_voucher] + [prev_y_reorders_no_voucher]&#10;    WHEN &apos;All&apos; THEN [prev_y_acq_voucher]+[prev_y_acq_no_voucher] + [prev_y_reorders_no_voucher] + [prev_y_reorders_voucher]&#10;    END&#10;WHEN 2 THEN &#10;    CASE [Parameters].[Parameter 5 1]&#10;    WHEN &apos;True&apos; THEN [prev_y_acq_voucher_calibrated] + [prev_y_reorders_voucher]&#10;    WHEN &apos;False&apos; THEN [prev_y_acq_no_voucher_calibrated] + [prev_y_reorders_no_voucher]&#10;    WHEN &apos;All&apos; THEN [prev_y_acq_voucher_calibrated]+[prev_y_acq_no_voucher_calibrated] + [prev_y_reorders_no_voucher] + [prev_y_reorders_voucher]&#10;    END&#10;END' />
      </column>
      <column caption='Total Orders Hard Failed' datatype='real' name='[Total Orders Not Sent (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5 1]&#10;WHEN &apos;Used&apos; THEN [hard_failed_orders_voucher]&#10;WHEN &apos;Non-Used&apos; THEN [hard_failed_orders_no_voucher]&#10;WHEN &apos;All&apos; THEN [hard_failed_orders_no_voucher] + [hard_failed_orders_voucher]&#10;END' />
      </column>
      <column caption='Total Reorders Prev Y' datatype='real' name='[Total Orders Prev Y (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5 1]&#10;WHEN &apos;True&apos; THEN [prev_y_reorders_voucher]&#10;WHEN &apos;False&apos; THEN [prev_y_reorders_no_voucher]&#10;WHEN &apos;All&apos; THEN [prev_y_reorders_no_voucher]+[prev_y_reorders_voucher]&#10;END' />
      </column>
      <column caption='Total Voucher (DH)' datatype='real' name='[Total Voucher  (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4 2]&#10;WHEN &apos;EUR&apos; THEN [amt_voucher_dh_eur]&#10;WHEN &apos;USD&apos; THEN [amt_voucher_dh_usd]&#10;WHEN &apos;Local Currency&apos; THEN [amt_voucher_dh_lc]&#10;END' />
      </column>
      <column caption='Voucher Acq Share' datatype='real' name='[Voucher Acq (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_175781164109176834])/(SUM([Calculation_175781164109176834])+ SUM([Acquisitions [w/ Vouchers]]  (copy)_175781164109746179]))' />
      </column>
      <column caption='Voucher Orders Share' datatype='real' name='[Voucher Orders (copy 2)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_269090110487564289]) / SUM([Calculation_4910471744098205697])' />
      </column>
      <column caption='Orders [w/out Vouchers]' datatype='real' name='[Voucher Orders (copy 3)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[reorders_no_voucher] + [Acquisitions [w/ Vouchers]]  (copy)_175781164109746179]' />
      </column>
      <column caption='Voucher Acq' datatype='real' name='[Voucher Orders (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_175781164109176834]' />
      </column>
      <column caption='Voucher KPI Share ' datatype='real' name='[Voucher Orders Share (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Choosen KPI (No Voucher) (copy)]/([Choosen KPI (No Voucher) (copy)]+ [Choosen KPI (copy)])' />
      </column>
      <column caption='YoY % Vendors Active' datatype='real' default-format='p0%' name='[YoY % Acquisitions (copy 4)_404972163928678405]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendors_active]) &#10;/ &#10;(&#10;IF [Parameters].[Parameter 1 1] = &apos;Monthly&apos; THEN SUM([prev_y_vendors_active])&#10;ELSEIF [Parameters].[Parameter 1 1] = &apos;Weekly&apos; THEN SUM([prev_364d_vendors_active])&#10;ELSE NULL&#10;END&#10;) - 1' />
      </column>
      <column caption='YoY % Commission Revenue' datatype='real' default-format='p0.00%' name='[YoY % Acquisitions (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([Calculation_4910471744126128131])) - LOOKUP(ZN(SUM([Calculation_4910471744126128131])), -12)) &#13;&#10;/ ABS(LOOKUP(ZN(SUM([Calculation_4910471744126128131])), -12))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='YoY % Hard Failed Orders' datatype='real' default-format='p0.00%' name='[YoY % Declines (copy)_2331949855219122183]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Total Orders Not Sent (copy)]) &#10;/ &#10;(&#10;IF [Parameters].[Parameter 1 1] = &apos;Monthly&apos; THEN SUM([Calculation_2331949855219892234])&#10;ELSEIF [Parameters].[Parameter 1 1] = &apos;Weekly&apos; THEN SUM([Calculation_2331949855219793929])&#10;ELSE NULL&#10;END&#10;) - 1' />
      </column>
      <column caption='YoY % Reorders' datatype='real' default-format='p0.00%' name='[YoY % Orders (copy 2)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_4910471744098377730]) &#10;/ &#10;(&#10;IF [Parameters].[Parameter 1 1] = &apos;Monthly&apos; THEN SUM([Total Orders Prev Y (copy)])&#10;ELSEIF [Parameters].[Parameter 1 1] = &apos;Weekly&apos; THEN SUM([Total Acquisitions Prev 364 (copy 2)])&#10;ELSE NULL&#10;END&#10;) - 1' />
