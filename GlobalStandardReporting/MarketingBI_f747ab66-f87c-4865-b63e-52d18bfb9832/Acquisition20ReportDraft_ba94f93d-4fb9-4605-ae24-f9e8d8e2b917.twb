        <title>
          <formatted-text>
            <run>Acquisition Funnel</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='bima_tableau_funnel_view_metric_kpi+ (rl_mkt)' name='federated.0eq51qz0vdo7br1bc98sk0k3t5su' />
            <datasource name='Parameters' />
            <datasource caption='bima_tableau_acqv2_l2_detailed+ (rl_mkt) PM Copy' name='federated.144w9531328his1gjufxw0r74y3q (copy)' />
            <datasource caption='bima_tableau_acqv2_l2_detailed+ (rl_mkt)' name='federated.144w9531328his1gjufxw0r74y3q' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.144w9531328his1gjufxw0r74y3q (copy)].[report_type]' caption='KPI Selection' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0eq51qz0vdo7br1bc98sk0k3t5su'>
            <column caption='1. New Session' datatype='real' name='[2. Quality Session (copy)_1496602474965716992]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([funnel_type] = &apos;new_sessions&apos;)  &#13;&#10; OR LOOKUP(ATTR([funnel_type]),-1) = &apos;new_sessions&apos; &#13;&#10;THEN SUM([session_count])&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='6. Acquisitions' datatype='real' name='[5. Purchase Session (copy)_456270961130950656]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([funnel_type] = &apos;total_acquisitions&apos;)  &#13;&#10; OR LOOKUP(ATTR([funnel_type]),-1) = &apos;total_acquisitions&apos; &#13;&#10;THEN SUM([session_count])&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='test_funnel' datatype='string' name='[Calculation_1630303096244826130]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = &apos;Weekly&apos; THEN &quot;Weekly&quot;&#13;&#10;ELSEIF  [Parameters].[Parameter 6] = &apos;Monthly&apos; THEN &quot;Monthly&quot; end' />
            </column>
            <column aggregation='Sum' caption='Report Type custom Funnel' datatype='integer' name='[Calculation_1630303096245018643]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [report_type]&#13;&#10;WHEN &apos;Monthly&apos; THEN 1&#13;&#10;WHEN &apos;Weekly&apos; THEN 2&#13;&#10;END' />
            </column>
            <column caption='2. Quality Session' datatype='real' name='[Calculation_741686586342940673]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([funnel_type] = &apos;quality_session&apos;)  &#13;&#10; OR LOOKUP(ATTR([funnel_type]),-1) = &apos;quality_session&apos; &#13;&#10;THEN SUM([session_count])&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='3. Shop List added session' datatype='real' name='[Calculation_741686586343174146]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([funnel_type] = &apos;shop_list_loaded_session&apos;)  &#13;&#10; OR LOOKUP(ATTR([funnel_type]),-1) = &apos;shop_list_loaded_session&apos; &#13;&#10;THEN SUM([session_count])&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='4. Add To Cart Session' datatype='real' name='[Calculation_741686586343444483]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([funnel_type] = &apos;add_to_cart_session&apos;)  &#13;&#10; OR LOOKUP(ATTR([funnel_type]),-1) = &apos;add_to_cart_session&apos; &#13;&#10;THEN SUM([session_count])&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Session Change %' datatype='real' name='[Calculation_816558931578454075]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([session_count]-[session_count_delta])/SUM([session_count_delta])' />
            </column>
            <column caption='Session Benchmark %' datatype='real' name='[Calculation_816558931578642492]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([session_count]-[session_count_benchmark])/SUM([session_count_benchmark])' />
            </column>
