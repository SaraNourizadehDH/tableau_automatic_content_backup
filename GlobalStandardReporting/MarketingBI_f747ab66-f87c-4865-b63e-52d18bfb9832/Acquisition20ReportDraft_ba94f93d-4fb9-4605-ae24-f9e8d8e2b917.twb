      <column caption='Sessions/Orders' datatype='real' name='[New Sessions/Acquisitions (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 8]&#10;WHEN 1 THEN [sessions]&#10;WHEN 2 THEN [orders]&#10;END' />
