            <column-instance column='[display_name]' derivation='None' name='[none:display_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[is_voucher_acquisition]' derivation='None' name='[none:is_voucher_acquisition:nk]' pivot='key' type='nominal' />
            <column-instance column='[management_entity]' derivation='None' name='[none:management_entity:nk]' pivot='key' type='nominal' />
            <column-instance column='[return_period]' derivation='None' name='[none:return_period:ok]' pivot='key' type='ordinal' />
            <column-instance column='[return_period]' derivation='None' name='[none:return_period:qk]' pivot='key' type='quantitative' />
            <column caption='Orders' datatype='integer' name='[orders]' role='measure' type='quantitative' />
