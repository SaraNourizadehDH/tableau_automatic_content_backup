      <column caption='Share Acquisition' datatype='real' default-format='p0.00%' name='[Calculation_502714371732062209]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_4910471744090103808])/SUM([Calculation_4910471744098205697])' />
      </column>
      <column caption='KPIs' datatype='real' name='[Calculation_502714371734159362]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2 1]&#10;WHEN &apos;Acquisitions&apos; THEN SUM([Calculation_4910471744090103808])&#10;WHEN &apos;Reorders&apos; THEN SUM([Calculation_4910471744098205697])&#10;WHEN &apos;Orders&apos; THEN SUM([Calculation_4910471744098377730])&#10;//WHEN &apos;Declines&apos; THEN SUM([Total Orders not Accepted])&#13;&#10;//WHEN &apos;Declines %&apos; THEN SUM([Total Orders not Accepted]) / SUM([Total Reorders])&#13;&#10;//WHEN &apos;Not Sent&apos; THEN SUM([Total Orders Not Sent])&#13;&#10;WHEN &apos;Commission Revenue&apos; THEN SUM([Calculation_4910471744126128131])&#13;&#10;WHEN &apos;Hard Failed Orders&apos; THEN SUM([Total Orders Not Sent (copy)])&#10;END' />
      </column>
      <column caption='YoY % Orders' datatype='real' default-format='p0.00%' name='[Calculation_502714371759747084]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_4910471744098205697]) &#10;/ &#10;(&#10;IF [Parameters].[Parameter 1 1] = &apos;Monthly&apos; THEN SUM([Total Acquisitions Prev Y (copy)])&#10;ELSEIF [Parameters].[Parameter 1 1] = &apos;Weekly&apos; THEN SUM([Total Acquisitions Prev 364 (copy)])&#10;ELSE NULL&#10;END&#10;) - 1' />
      </column>
      <column caption='Exclude last period' datatype='boolean' name='[Calculation_63331889513631747]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1 1]&#10;WHEN &apos;Monthly&apos; THEN DATEDIFF(&apos;month&apos;, [Calculation_457678357363400717], TODAY()) &gt; 0&#10;                    //AND&#10;                   // DATEDIFF(&apos;year&apos;, [Date View], TODAY()) = 0&#10;WHEN &apos;Weekly&apos; THEN DATEDIFF(&apos;week&apos;, [Calculation_457678357363400717], TODAY()) &gt; 0&#10;                   //AND&#10;                   //DATEDIFF(&apos;year&apos;, [Date View], TODAY()) = 0&#10;WHEN &apos;Daily&apos; THEN DATEDIFF(&apos;day&apos;, [Calculation_457678357363400717], TODAY()) &gt; 0&#10;                  //AND&#10;                  //DATEDIFF(&apos;year&apos;, [Date View], TODAY()) = 0&#10;END' />
      </column>
      <column caption='User Entitlement Filter' datatype='boolean' hidden='true' name='[Calculation_791015118544150528]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]=USERNAME()' />
