      <aliases enabled='yes' />
      <column caption='aCVR' datatype='real' default-format='p0.0%' name='[Calculation_1124774024445345792]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_acquisitions])/SUM([new_sessions])' />
      </column>
      <column caption='Inc, Acq Share %' datatype='real' name='[Calculation_1320117658808954889]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([incentivised_acquisitions])/SUM([total_acquisitions])' />
      </column>
      <column caption='Inc. Acq CPA' datatype='real' name='[Calculation_1320117658813116426]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([incentivised_costs])/SUM([incentivised_acquisitions])' />
      </column>
