                <zone forceUpdate='true' h='17571' id='7' type-v2='text' w='82266' x='17200' y='13429'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='12'>Description:</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='8'>-</run>
                    <run fontcolor='#000000' fontsize='8'> The report uses Adjust for app and GA for web. Majority of our orders come from app (&gt; 90%).</run>
