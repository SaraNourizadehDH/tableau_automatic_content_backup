          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.144w9531328his1gjufxw0r74y3q (copy)].[report_type]' caption='KPI Selection' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.144w9531328his1gjufxw0r74y3q'>
            <column caption='Inc, Acq Share %' datatype='real' name='[Calculation_1320117658808954889]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([incentivised_acquisitions])/SUM([total_acquisitions])' />
            </column>
            <column caption='Inc. Acq Change % Up' datatype='real' default-format='*▲0.0 pp' name='[Calculation_1344043032615182336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Total Acq Change % (copy)_1320117658807373831] &gt; 0 THEN [Total Acq Change % (copy)_1320117658807373831] ELSE NULL END' />
            </column>
            <column caption='test' datatype='string' datatype-customized='true' name='[Calculation_1344043032618323972]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = &apos;Weekly&apos; THEN &quot;Weekly&quot;&#13;&#10;ELSEIF  [Parameters].[Parameter 6] = &apos;Monthly&apos; THEN &quot;Monthly&quot; end' />
            </column>
            <column caption='Inc, Acq Delta Share %' datatype='real' name='[Inc, Acq Share % (copy)_1698138553613525001]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([incentivised_acquisitions_delta])/SUM([total_acquisitions_delta])' />
            </column>
            <column caption='Inc. Acq Change % Zero' datatype='real' name='[Inc. Acq Change % Down (copy)_1344043032615665666]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Total Acq Change % (copy)_1320117658807373831] = 0 THEN [Total Acq Change % (copy)_1320117658807373831] ELSE NULL END' />
            </column>
            <column caption='Inc. Acq Change % Down' datatype='real' default-format='*▼ 0.0 pp' name='[Inc. Acq Change % Up (copy)_1344043032615559169]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Total Acq Change % (copy)_1320117658807373831] &lt; 0 THEN [Total Acq Change % (copy)_1320117658807373831] ELSE NULL END' />
            </column>
            <column caption='Report Type Selector' datatype='integer' datatype-customized='true' name='[KPI Week selector (copy)_1935140483333140482]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#13;&#10;WHEN &quot;Monthly&quot; THEN 1&#13;&#10;WHEN &quot;Weekly&quot; THEN 2&#13;&#10;END' />
            </column>
            <column caption='Report Type custom' datatype='integer' name='[Report Type (copy)_1935140483344252932]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [report_type]&#13;&#10;WHEN &apos;Monthly&apos; THEN 1&#13;&#10;WHEN &apos;Weekly&apos; THEN 2&#13;&#10;END' />
            </column>
            <column caption='Inc. Acq Change %' datatype='real' name='[Total Acq Change % (copy)_1320117658807373831]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100*([Calculation_1320117658808954889]- [Inc, Acq Share % (copy)_1698138553613525001])' />
