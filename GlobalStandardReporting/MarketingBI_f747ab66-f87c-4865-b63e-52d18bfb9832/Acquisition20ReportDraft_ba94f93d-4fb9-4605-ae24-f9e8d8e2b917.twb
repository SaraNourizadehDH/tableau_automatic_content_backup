      <aliases enabled='yes' />
      <column caption='test' datatype='string' datatype-customized='true' name='[Calculation_1344043032618323972]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = &apos;Weekly&apos; THEN &quot;Weekly&quot;&#13;&#10;ELSEIF  [Parameters].[Parameter 6] = &apos;Monthly&apos; THEN &quot;Monthly&quot; end' />
      </column>
      <column caption='KPI Month selector' datatype='date' datatype-customized='true' name='[Calculation_1935140483321434112]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(IF [report_type] = &apos;Monthly&apos; THEN&#13;&#10;DATETRUNC(&apos;month&apos;, DATETRUNC(&apos;month&apos;, TODAY()) -1)&#13;&#10;END)' />
      </column>
      <column caption='PM Acq Target %' datatype='real' name='[Calculation_2268406856099655681]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([pm_acquisitions])/SUM([pm_acquisitions_target])' />
      </column>
      <column caption='User Entitilment' datatype='boolean' name='[Calculation_43910108794445824]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='PM Acq CPA' datatype='real' name='[Inc. Acq CPA (copy)_1320117658818822161]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([pm_costs])/SUM([pm_acquisitions])' />
      </column>
      <column caption='PM Acq CPA Change' datatype='real' name='[Inc. Acq CPA Change (copy)_1320117658819383314]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([pm_costs_delta])/SUM([pm_acquisitions_delta])' />
      </column>
      <column caption='PM Acq CPA Change %' datatype='real' name='[Inc. Acq CPA Chnage % (copy)_1320117658819506195]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Inc. Acq CPA (copy)_1320117658818822161]-[Inc. Acq CPA Change (copy)_1320117658819383314])/[Inc. Acq CPA Change (copy)_1320117658819383314]' />
      </column>
      <column caption='KPI Week selector' datatype='date' datatype-customized='true' name='[KPI Month selector (copy)_1935140483330949121]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(IF [report_type] = &apos;Weekly&apos; AND [total_acquisitions] &gt; 0.0 THEN&#13;&#10;DATETRUNC(&apos;week&apos;, DATETRUNC(&apos;week&apos;, TODAY()) -2)&#13;&#10;END)' />
      </column>
      <column caption='KPI Month selector trend' datatype='date' datatype-customized='true' name='[KPI Month selector (copy)_1935140483350487046]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(IF [report_type] = &apos;Monthly&apos; THEN&#13;&#10;DATEADD(&apos;month&apos;,-5,DATETRUNC(&apos;month&apos;, DATETRUNC(&apos;month&apos;, TODAY()) -1))&#13;&#10;END)' />
      </column>
      <column caption='Report Type Selector' datatype='integer' datatype-customized='true' name='[KPI Week selector (copy)_1935140483333140482]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#13;&#10;WHEN &quot;Monthly&quot; THEN 1&#13;&#10;WHEN &quot;Weekly&quot; THEN 2&#13;&#10;END' />
      </column>
      <column caption='KPI Week selector trend' datatype='date' datatype-customized='true' name='[KPI Week selector (copy)_1935140483350560775]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(IF [report_type] = &apos;Weekly&apos; AND [total_acquisitions] &gt; 0.0 THEN&#13;&#10;DATEADD(&apos;week&apos;, -3, DATETRUNC(&apos;week&apos;, DATETRUNC(&apos;week&apos;, TODAY()) -2))&#13;&#10;END)' />
      </column>
      <column caption='Pm Acquisitions topline share %' datatype='real' name='[Pm Acquisitions (copy)_1698138553667977231]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[pm_acquisitions]' />
      </column>
      <column caption='Report Date Weekly' datatype='date' name='[Report Date (copy)_1698138553652183051]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = &apos;Weekly&apos; THEN [report_date] ELSE NULL END' />
      </column>
      <column caption='Report Date Parameter' datatype='date' name='[Report Date (copy)_1935140483335827459]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#13;&#10;WHEN &quot;Monthly&quot; THEN [Calculation_1935140483321434112]&#13;&#10;WHEN &quot;Weekly&quot; THEN [KPI Month selector (copy)_1935140483330949121]&#13;&#10;END' />
      </column>
      <column caption='Report Date Filter' datatype='date' name='[Report Date Parameter (copy)_1698138553656967181]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#13;&#10;WHEN &quot;Monthly&quot; THEN [Report Date Weekly (copy)_1698138553656803340]&#13;&#10;WHEN &quot;Weekly&quot; THEN [Report Date (copy)_1698138553652183051]&#13;&#10;END' />
      </column>
      <column caption='Report Date Parameter trend' datatype='date' name='[Report Date Parameter (copy)_1935140483350695944]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#13;&#10;WHEN &quot;Monthly&quot; THEN [KPI Month selector (copy)_1935140483350487046]&#13;&#10;WHEN &quot;Weekly&quot; THEN [KPI Week selector (copy)_1935140483350560775]&#13;&#10;END' />
