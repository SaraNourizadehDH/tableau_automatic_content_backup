      <aliases enabled='yes' />
      <column caption='User Check' datatype='boolean' name='[Calculation_2837690039619956736]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='USERNAME() =  [username]' />
      </column>
      <column caption='FLGPO' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_3118813123413127172]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([flgpo_eur])/SUM([orders_profit])' />
      </column>
      <column caption='Header' datatype='string' name='[Calculation_384917097103093761]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 8 2]&#10;WHEN &apos;DH Group&apos; THEN &apos;DH Group&apos;&#10;WHEN &apos;Management Entity&apos; THEN [management_entity]&#10;WHEN &apos;Sub Entity&apos; THEN [sub_entity]&#10;END' />
      </column>
      <column aggregation='Sum' caption='First Order Year' datatype='integer' name='[Calculation_5674605952235618304]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='YEAR([first_order_month])' />
      </column>
      <column caption='Acq. Date Switch' datatype='string' name='[Calculation_5674605952238977025]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 7 2] = &apos;Month&apos;, LEFT(str([first_order_month]), 7),&#10;IIF([Parameters].[Parameter 7 2] = &apos;Quarter&apos;, str([first_order_quarter]),&#10;IIF([Parameters].[Parameter 7 2] = &apos;Semester&apos;, str([first_order_semester]),&#10;str([Calculation_5674605952235618304]))))' />
      </column>
      <column caption='Management Entity (copy)' datatype='string' name='[Management Entity (copy)_433612248457695232]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[management_entity]' />
      </column>
