            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0eq51qz0vdo7br1bc98sk0k3t5su'>
            <column caption='1. New Session' datatype='real' name='[2. Quality Session (copy)_1496602474965716992]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([funnel_type] = &apos;new_sessions&apos;)  &#13;&#10; OR LOOKUP(ATTR([funnel_type]),-1) = &apos;new_sessions&apos; &#13;&#10;THEN SUM([session_count])&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
