      <column caption='Avg Cost in Compared Period (copy)' datatype='real' name='[Avg Cost in Compared Period (copy)_1022598637757698048]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_645140697911906305])/COUNTD([Acq in Compared Period (copy)_645140697912487939])' />
