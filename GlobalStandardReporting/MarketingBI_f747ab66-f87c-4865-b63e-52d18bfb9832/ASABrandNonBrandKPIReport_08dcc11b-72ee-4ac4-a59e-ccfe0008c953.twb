      <column caption='CPA Cost in Historical Period - after onboarding' datatype='real' name='[CPA Cost in Historical Period - before onboarding (copy)_6275062447080464392]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Is Active (copy)_6275062446342057987] AND [period_relative_to_onboarding] &lt;= [Parameters].[months before onboarding (copy)_645140697919369224] THEN [cost] END)&#10;    /SUM(IF [Is Active (copy)_6275062446342057987] AND [period_relative_to_onboarding] &lt;= [Parameters].[months before onboarding (copy)_645140697919369224] THEN [real_acquisition_0w] END)' />
