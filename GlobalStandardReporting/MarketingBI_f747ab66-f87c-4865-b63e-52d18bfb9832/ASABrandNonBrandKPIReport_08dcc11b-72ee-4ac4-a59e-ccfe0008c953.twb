        <calculation class='tableau' formula='IF&#10;([period_relative_to_onboarding] &gt;= -[Parameters].[Parameter 1] AND [period_relative_to_onboarding] &lt; 0)&#10;OR&#10;([period_relative_to_onboarding] &gt; 0 AND [period_relative_to_onboarding] &lt;= [Parameters].[months before onboarding (copy)_645140697919369224])&#10;THEN [period_relative_to_onboarding]&#10;END' />
