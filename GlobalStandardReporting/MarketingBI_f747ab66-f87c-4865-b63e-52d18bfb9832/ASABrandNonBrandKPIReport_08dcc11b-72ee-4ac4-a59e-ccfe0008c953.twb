        <calculation class='tableau' formula='SUM([Calculation_645140697911906305])/COUNTD([Acq in Compared Period (copy)_645140697912487939])' />
      </column>
      <column caption='Compared Period' datatype='string' name='[Compared Period (copy)_645140697912750085]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [period_relative_to_onboarding] &gt;= -12 AND [period_relative_to_onboarding] &lt; 0 THEN &apos;before onboarding&apos;&#10;ELSEIF [period_relative_to_onboarding] &gt; 0 AND [period_relative_to_onboarding] &lt;= 12 THEN &apos;after onboarding&apos;&#10;END' />
