          <datasource-dependencies datasource='federated.14q9asm1lb86rh12w9l2o1n3s8kf'>
            <column caption='Cost Previous Month' datatype='real' name='[Calculation_6275062446332760065]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF DATE([month]) = DATE(DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;, TODAY()))) THEN [cost_prev_month] ELSE NULL END' />
            </column>
            <column caption='Compared Period' datatype='string' name='[Compared Period (copy)_645140697912750085]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [period_relative_to_onboarding] &gt;= -12 AND [period_relative_to_onboarding] &lt; 0 THEN &apos;before onboarding&apos;&#10;ELSEIF [period_relative_to_onboarding] &gt; 0 AND [period_relative_to_onboarding] &lt;= 12 THEN &apos;after onboarding&apos;&#10;END' />
            </column>
            <column caption='Brand Name' datatype='string' name='[brand_name]' role='dimension' type='nominal' />
