      <column caption='Avg Cost in Historical Period - after onboarding' datatype='real' name='[Avg Cost in Compared Period (copy)_6275062446344429572]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [Is Active (copy)_6275062446342057987] AND [period_relative_to_onboarding] &lt;= [Parameters].[months before onboarding (copy)_645140697919369224] THEN [cost] END)' />
      </column>
      <column caption='CPA cost in Compared Period' datatype='real' name='[Avg Cost in Compared Period (copy)_645140697913290758]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_645140697911906305])/SUM([Cost in Compared Period (copy)_645140697912401922])' />
      </column>
      <column caption='Avg Cost in Historical Period - before onboarding' datatype='real' name='[Avg Cost in Historical Period - after onboarding (copy)_6275062447077957638]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [Is Active (copy)_6275062446342057987] AND [period_relative_to_onboarding] &lt;= [Parameters].[months before onboarding (copy)_645140697919369224] THEN [cost_last_month] END)' />
      </column>
      <column caption='CPA Cost in Historical Period - before onboarding' datatype='real' name='[Avg Cost in Historical Period - before onboarding (copy)_6275062447079743495]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Is Active (copy)_6275062446342057987] AND [period_relative_to_onboarding] &lt;= [Parameters].[months before onboarding (copy)_645140697919369224] THEN [cost_last_month] END)&#10;    /SUM(IF [Is Active (copy)_6275062446342057987] AND [period_relative_to_onboarding] &lt;= [Parameters].[months before onboarding (copy)_645140697919369224] THEN [real_acquisition_0w_last_month] END)' />
