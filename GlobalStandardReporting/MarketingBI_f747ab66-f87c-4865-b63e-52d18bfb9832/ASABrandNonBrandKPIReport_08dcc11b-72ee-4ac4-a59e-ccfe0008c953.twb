      <column caption='Uniform Initial Bids' datatype='boolean' name='[Calculation_1152640076590313472]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[uniform_ad_group_bids] AND [uniform_keyword_bids]' />
      </column>
      <column caption='Run Rate' datatype='real' name='[Calculation_1152640076591685633]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF cost_date = max_cost_date THEN cumulative_spend ELSE NULL END)&#13;&#10;/ &#13;&#10;SUM(IF cost_date = max_cost_date THEN planned_spend ELSE NULL END) - 1' />
      </column>
      <column caption='Distance to Target' datatype='real' name='[Calculation_1152640076592365570]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(cost_eur)/MIN(cost_target) - 1' />
      </column>
