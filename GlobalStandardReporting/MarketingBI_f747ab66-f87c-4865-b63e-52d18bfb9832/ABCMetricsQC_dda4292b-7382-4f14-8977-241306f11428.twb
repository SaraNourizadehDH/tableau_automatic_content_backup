          <datasource-dependencies datasource='Parameters'>
            <column caption='Shop Type' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0jzkwp61hk6my614c5hpk0mzs7jg'>
            <column caption='Voucher xsell VERT' datatype='real' name='[Acq Share VERT (copy)_5028269015419043845]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vou_qc_x_sell])/SUM([qc_x_sell_all])' />
            </column>
            <column caption='MAU DMart' datatype='real' name='[Calculation_4327114855121629185]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [vertical_types] = &apos;DMart&apos;&#10;then [qc_active_customers_shop]&#10;END' />
            </column>
            <column caption='Acq Share VERT' datatype='real' name='[Calculation_5028269015388295168]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qc_acq])/SUM([total_acq_all])' />
            </column>
            <column caption='Voucher Acq Share VERT' datatype='real' name='[Calculation_5028269015409356803]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qc_voucher_acq])/SUM([total_acq_all])' />
            </column>
            <column caption='Adoption Rate Orders VERT' datatype='real' name='[Calculation_5028269015452004359]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([adopter_orders])/SUM([total_ord_qc])' />
            </column>
            <column caption='Adoption Rate VERT' datatype='real' name='[Calculation_5028269015682527246]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([adopters])/sum([qc_active_customers_all])' />
            </column>
            <column caption='-' datatype='string' name='[Calculation_5028269015777099808]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;&apos;' />
            </column>
            <column caption='Filter DMart' datatype='boolean' name='[Calculation_5028269016822878242]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1] = &apos;DMart&apos;' />
            </column>
            <column caption='% Adopters / QC MAU VERT' datatype='real' name='[Calculation_5827165371162591239]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([adopters])/SUM([qc_active_customers_shop])' />
            </column>
            <column caption='Active Customers All Fixed' datatype='real' name='[QC Active Customers All Fixed (copy)_318629711771340800]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [sub_entity],[vertical_order_date]&#10;&#10;&#10;: AVG(&#10;[active_customers_mth_all]) }' />
            </column>
            <column caption='DMart MAU / MAU' datatype='real' name='[QC MAU / MAU (copy)_4327114855121514496]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_4327114855121629185])/sum([QC Active Customers All Fixed (copy)_318629711771340800])' />
            </column>
            <column caption='Active Customers Mth All' datatype='real' name='[active_customers_mth_all]' role='measure' type='quantitative' />
            <column caption='Adopter Orders' datatype='real' name='[adopter_orders]' role='measure' type='quantitative' />
            <column caption='Adopters' datatype='real' name='[adopters]' role='measure' type='quantitative' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
