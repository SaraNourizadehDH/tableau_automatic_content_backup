          <datasource-dependencies datasource='Parameters'>
            <column caption='Shop Type' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0jzkwp61hk6my614c5hpk0mzs7jg'>
            <column caption='Voucher xsell VERT' datatype='real' name='[Acq Share VERT (copy)_5028269015419043845]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vou_qc_x_sell])/SUM([qc_x_sell_all])' />
            </column>
            <column caption='Acq Share VERT' datatype='real' name='[Calculation_5028269015388295168]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qc_acq])/SUM([total_acq_all])' />
            </column>
            <column caption='Voucher Acq Share VERT' datatype='real' name='[Calculation_5028269015409356803]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qc_voucher_acq])/SUM([total_acq_all])' />
            </column>
            <column caption='Adoption Rate Orders VERT' datatype='real' name='[Calculation_5028269015452004359]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([adopter_orders])/SUM([total_ord_qc])' />
            </column>
            <column caption='Adoption Rate VERT' datatype='real' name='[Calculation_5028269015682527246]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([adopters])/sum([qc_active_customers_all])' />
            </column>
            <column caption='-' datatype='string' name='[Calculation_5028269015777099808]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;&apos;' />
            </column>
            <column caption='% Adopters / QC MAU VERT' datatype='real' name='[Calculation_5827165371162591239]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([adopters])/SUM([qc_active_customers_shop])' />
            </column>
            <column caption='LS MAU / MAU' datatype='real' name='[DMart MAU / MAU (copy)_4327114855123148803]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([MAU DMart (copy)_4327114855121772546])/sum([QC Active Customers All Fixed (copy)_318629711771340800])' />
            </column>
            <column caption='Filter Local Store' datatype='boolean' name='[Filter DMart (copy)_5028269016823017507]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1] = &apos;Local Store&apos;' />
            </column>
            <column caption='MAU Local Store' datatype='real' name='[MAU DMart (copy)_4327114855121772546]' role='measure' type='quantitative'>
