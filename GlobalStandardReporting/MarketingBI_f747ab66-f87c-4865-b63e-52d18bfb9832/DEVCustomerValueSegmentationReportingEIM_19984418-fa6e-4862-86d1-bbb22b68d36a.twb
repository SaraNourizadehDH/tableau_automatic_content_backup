    <worksheet name='ACD - SP - Monthly KPIs per User (3)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#0f1125' fontsize='8'>Monthly KPIs per User</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='bima_early_indicator_model_acq_cohort_performance (cl_mkt)' name='federated.0boflkl1dpfqaj174vcc81yuqy7f' />
            <datasource caption='bima_early_indicator_model_acq_cohort (cl_mkt)' name='federated.1faxw2b0mp7pdm198x9231aibkqn' />
          </datasources>
          <datasource-dependencies datasource='federated.0boflkl1dpfqaj174vcc81yuqy7f'>
            <column caption='AOV' datatype='real' name='[Calculation_4273353128907419649]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[gmv_eur]/[cnt_orders]' />
            </column>
            <column caption='Order Freq' datatype='real' name='[Calculation_4273353128907550722]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[cnt_orders]/[cnt_customers]' />
            </column>
            <column caption='FLGPO' datatype='real' name='[Calculation_4273353128908337155]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[flgp_eur]/[cnt_orders]' />
            </column>
            <column caption='Month after Acquisition' datatype='integer' datatype-customized='true' name='[Calculation_5988661647206002689]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(NULL)' />
            </column>
            <column caption='(ZN(SUM([Cnt Customers (copy)])) - LOOKUP(ZN(SUM([Cnt Custome...' datatype='real' name='[Calculation_5988661647207260166]' role='measure' type='quantitative' user:unnamed='ACD - SP - Monthly KPIs per User (3)'>
              <calculation class='tableau' formula='(ZN(SUM([Cnt Customers (copy)_5988661647206805507])) - LOOKUP(ZN(SUM([Cnt Customers (copy)_5988661647206805507])), FIRST())) / ABS(LOOKUP(ZN(SUM([Cnt Customers (copy)_5988661647206805507])), FIRST())) + 1'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Cnt Customers (copy)' datatype='integer' name='[Cnt Customers (copy)_5988661647206805507]' role='measure' type='quantitative'>
