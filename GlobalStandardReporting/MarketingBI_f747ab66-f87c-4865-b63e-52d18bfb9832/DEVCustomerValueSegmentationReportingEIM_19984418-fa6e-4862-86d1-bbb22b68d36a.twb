            <column caption='Trend End Date' datatype='boolean' name='[Calculation_1929159140141510724]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[snapshot_date] &lt;= [Parameters].[Parameter 2]' />
            </column>
            <column caption='Profitability &amp; Frequency Grouping' datatype='string' name='[Calculation_364299018553663488]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[flgpo_grp] + &quot; &quot; + [orders_grp]' />
            </column>
            <column caption='Customer Count per Snapshot Month (VSD)' datatype='integer' name='[Calculation_364299018557779971]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [management_entity], [sub_entity], [snapshot_date] : SUM([cnt_customers]) }&#10;&#10;// VSD = Value Segment Drivers' />
            </column>
            <column caption='Customer Count % based on Profitability &amp; Frequency per Snapshot Date' datatype='real' name='[Calculation_364299018558197764]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_364299018559328261])&#10;/&#10;SUM([Calculation_364299018557779971])' />
            </column>
            <column caption='Customer Count per Profitability &amp; Frequency Grp (VSD)' datatype='integer' name='[Calculation_364299018559328261]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [management_entity], [sub_entity], [snapshot_date], [Profitability &amp; Frequency Grouping (copy)_364299018555523073], [Profitability &amp; Frequency Grouping (copy)_364299018555785218] : SUM([cnt_customers]) }&#10;&#10;// VSD = Value Segment Drivers' />
            </column>
            <column caption='Profitability ' datatype='string' name='[Profitability &amp; Frequency Grouping (copy)_364299018555523073]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[flgpo_grp]' />
