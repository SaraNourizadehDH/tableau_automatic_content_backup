            </column>
            <column caption='Acq. Cohort (copy)' datatype='date' datatype-customized='true' default-format='*mmm yy' name='[Acq. Cohort (copy)_5710845847699206146]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;,[acq_cohort]))' />
            </column>
            <column caption='Acqs' datatype='integer' name='[Calculation_3927983342378381316]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [acq_cohort],[sub_entity] : MAX([total_acquisitions])}' />
            </column>
