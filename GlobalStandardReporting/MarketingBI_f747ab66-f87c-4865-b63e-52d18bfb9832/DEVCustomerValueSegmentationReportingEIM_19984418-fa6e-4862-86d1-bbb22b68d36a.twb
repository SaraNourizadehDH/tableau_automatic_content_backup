      <table>
        <view>
          <datasources>
            <datasource caption='Active Customers' name='federated.14b5ybu0xqawsh10kwxqb18t5hd7' />
            <datasource caption='bima_early_indicator_model_acq_cohort (cl_mkt)' name='federated.1faxw2b0mp7pdm198x9231aibkqn' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.14b5ybu0xqawsh10kwxqb18t5hd7].[Calculation_1337639522042474496]' caption='Snapshot Date' datatype='date' default-format='*MMM YYYY' name='[Parameter 2]' param-domain-type='list' role='measure' type='quantitative' value='#2025-04-30#'>
              <calculation class='tableau' formula='#2025-04-30#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.14b5ybu0xqawsh10kwxqb18t5hd7'>
            <column caption='Snapshot Date p' datatype='date' name='[Calculation_1337639522042474496]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[snapshot_date]' />
            </column>
            <column caption='Snapshot Date Filter' datatype='boolean' name='[Calculation_1929159140106391571]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 2] = [snapshot_date]' />
            </column>
            <column caption='GMVU (€)' datatype='real' name='[Calculation_1929159140119052321]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([gmv_eur_l3m]) / SUM([cnt_customers])) / 3' />
            </column>
            <column caption='FLGPU (€)' datatype='real' name='[Calculation_1929159140119527458]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([flgp_eur_l3m]) / SUM([cnt_customers])) / 3' />
            </column>
            <column caption='AOV' datatype='real' name='[Calculation_1929159140119986211]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_eur_l3m]) / SUM([cnt_orders_l3m])' />
            </column>
            <column caption='FLGPO' datatype='real' name='[Calculation_1929159140120313892]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([flgp_eur_l3m]) / SUM([cnt_orders_l3m])' />
            </column>
            <column caption='Incentivized Orders (%)' datatype='real' default-format='p0%' name='[Calculation_1929159140120621093]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([inc_orders_l3m]) / SUM([cnt_orders_l3m])' />
            </column>
            <column caption='Incentive Depth (%)' datatype='real' default-format='p0%' name='[Calculation_1929159140120961062]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_incentives_eur_l3m]) / SUM([gbv_eur_l3m])' />
            </column>
            <column caption='Order Frequency (#)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1929159140121350183]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([cnt_orders_l3m]) / SUM([cnt_customers])) / 3' />
            </column>
            <column caption='Subscriber Orders (#)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1929159140121620520]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([cnt_orders_l3m_subscribed]) / SUM([cnt_customers])) / 3' />
            </column>
