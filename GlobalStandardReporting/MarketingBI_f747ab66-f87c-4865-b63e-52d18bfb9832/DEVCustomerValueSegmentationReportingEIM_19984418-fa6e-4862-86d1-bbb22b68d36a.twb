      <column caption='Customer Count' datatype='real' name='[Calculation_1929159140062916616]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([cnt_customers]) &gt;= 1000000 THEN SUM([cnt_customers]) / 1000000&#10;ELSE SUM([cnt_customers]) / 1000&#10;END' />
