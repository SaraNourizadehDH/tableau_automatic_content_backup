N [Order Frequency (#) (Ratio to Mid) - SE (copy)_171277544301674558]&#10;            WHEN &quot;Subscriber Orders (#)&quot; THEN [Subscriber Orders (Ratio to Mid) - SE (copy)_171277544301887552]&#10;            WHEN &quot;QCommerce Orders (#)&quot; THEN [QCommerce Orders (Ratio to Mid) - SE (copy)_171277544301764671]&#10;        END&#10;END' />
