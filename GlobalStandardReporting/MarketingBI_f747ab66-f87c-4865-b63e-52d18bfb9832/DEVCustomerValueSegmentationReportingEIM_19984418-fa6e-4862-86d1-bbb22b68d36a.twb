        <calculation class='tableau' formula='//[Snapshot Date] = [Previous Year of Snapshot Date]&#10;// It&apos;s changed due to February&#10;&#10;(DATEPART(&apos;year&apos;, [snapshot_date])*100 + DATEPART(&apos;month&apos;, [snapshot_date]))&#10;=&#10;(DATEPART(&apos;year&apos;, [Calculation_1929159140105322512])*100 + DATEPART(&apos;month&apos;, [Calculation_1929159140105322512]))' />
