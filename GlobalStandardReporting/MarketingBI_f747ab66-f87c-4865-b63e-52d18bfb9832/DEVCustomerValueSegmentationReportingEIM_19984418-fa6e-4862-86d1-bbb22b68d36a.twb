            <column caption='% 5M HVC' datatype='real' name='[% 3M HVC (copy) (copy)_4135711865289429000]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [m] = &apos;m5&apos; AND [value_segment] = &apos;1_HVC&apos; THEN [cnt_active_customers] END)/SUM([Calculation_3927983342378381316])' />
