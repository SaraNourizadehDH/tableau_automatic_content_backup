            <column caption='Cnt Customers' datatype='integer' name='[cnt_customers]' role='measure' type='quantitative' />
            <column caption='Cnt Customers Negative Flgpu 3M' datatype='integer' name='[cnt_customers_negative_flgpu_3m]' role='measure' type='quantitative' />
