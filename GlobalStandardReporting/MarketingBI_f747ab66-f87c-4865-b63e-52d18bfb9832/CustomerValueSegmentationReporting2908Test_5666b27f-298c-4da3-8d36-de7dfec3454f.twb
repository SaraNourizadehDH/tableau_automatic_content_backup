            <column datatype='boolean' name='[is_dmarts_customer]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[is_food_customer]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[is_local_shops_customer]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[is_qcommerce_customer]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[is_qcommerce_trial_customer]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[is_subscriber_customer]' role='dimension' type='nominal' />
