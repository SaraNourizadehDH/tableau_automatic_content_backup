              <calculation class='tableau' formula='IF SUM([Calculation_171277544250069016]) = 1 THEN &quot;Sub Entity&quot;&#10;ELSEIF SUM([Calculation_171277544250069016]) &gt; 1 THEN &quot;Management Entity&quot;&#10;END' />
