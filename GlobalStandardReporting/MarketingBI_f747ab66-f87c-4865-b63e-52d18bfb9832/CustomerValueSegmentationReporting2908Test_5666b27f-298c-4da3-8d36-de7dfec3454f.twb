      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#666666' fontname='Tableau Bold' fontsize='10'>Value Segment Drivers</run>
            <run fontcolor='#666666' fontsize='10'> - Trends in Profitability and Order Frequency</run>
            <run>Æ&#10;</run>
            <run fontcolor='#666666' fontsize='9' italic='true'>% of active customers per month by profitability and order frequency group</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
