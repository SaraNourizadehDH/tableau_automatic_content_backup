    <worksheet name='Segment Performance Over Time'>
      <table>
        <view>
          <datasources>
            <datasource caption='Active Customers' name='federated.14b5ybu0xqawsh10kwxqb18t5hd7' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.14b5ybu0xqawsh10kwxqb18t5hd7].[Calculation_1337639522042474496]' caption='Snapshot Date' datatype='date' default-format='*MMM YYYY' name='[Parameter 2]' param-domain-type='list' role='measure' type='quantitative' value='#2025-06-30#'>
              <calculation class='tableau' formula='#2025-06-30#' />
            </column>
            <column alias='Customer (#)' caption='Segment Performance Over Time KPI' datatype='string' name='[Segment Breakdown Abs Totals KPI (copy)_364299018627850246]' param-domain-type='list' role='measure' type='nominal' value='&quot;Customer (\#)&quot;'>
              <calculation class='tableau' formula='&quot;Customer (#)&quot;' />
              <aliases>
                <alias key='&quot;Customer (\#)&quot;' value='Customer (#)' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.14b5ybu0xqawsh10kwxqb18t5hd7'>
            <column caption='Snapshot Date p' datatype='date' name='[Calculation_1337639522042474496]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[snapshot_date]' />
            </column>
            <column caption='GMVU (€)' datatype='real' name='[Calculation_1929159140119052321]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([gmv_eur_l3m]) / SUM([cnt_customers])) / 3' />
            </column>
            <column caption='FLGPU (€)' datatype='real' name='[Calculation_1929159140119527458]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([flgp_eur_l3m]) / SUM([cnt_customers])) / 3' />
            </column>
            <column caption='AOV' datatype='real' name='[Calculation_1929159140119986211]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_eur_l3m]) / SUM([cnt_orders_l3m])' />
            </column>
            <column caption='FLGPO' datatype='real' name='[Calculation_1929159140120313892]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([flgp_eur_l3m]) / SUM([cnt_orders_l3m])' />
            </column>
            <column caption='Incentivized Orders (%)' datatype='real' default-format='p0%' name='[Calculation_1929159140120621093]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([inc_orders_l3m]) / SUM([cnt_orders_l3m])' />
            </column>
            <column caption='Incentive Depth (%)' datatype='real' default-format='p0%' name='[Calculation_1929159140120961062]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_incentives_eur_l3m]) / SUM([gbv_eur_l3m])' />
            </column>
            <column caption='Order Frequency (#)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1929159140121350183]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([cnt_orders_l3m]) / SUM([cnt_customers])) / 3' />
            </column>
            <column caption='Subscriber Orders (#)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1929159140121620520]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([cnt_orders_l3m_subscribed]) / SUM([cnt_customers])) / 3' />
            </column>
            <column caption='Trend End Date' datatype='boolean' name='[Calculation_1929159140141510724]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[snapshot_date] &lt;= [Parameters].[Parameter 2]' />
            </column>
            <column caption='Segment Performance Over Time KPI' datatype='real' name='[Calculation_364299018629013511]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Segment Breakdown Abs Totals KPI (copy)_364299018627850246]&#10;    WHEN &quot;Customer (#)&quot; THEN SUM([cnt_customers])&#10;    WHEN &quot;Customer (#) FLGPU-&quot; THEN SUM([cnt_customers_negative_flgpu_3m])&#10;    WHEN &quot;Customer (#) FLGPU+&quot; THEN SUM([cnt_customers_positive_flgpu_3m])&#10;    WHEN &quot;GMV (€)&quot; THEN SUM([gmv_eur_l3m])&#10;    WHEN &quot;GMVU (€)&quot; THEN [Calculation_1929159140119052321]&#10;    WHEN &quot;GBV (€)&quot; THEN SUM([gbv_eur_l3m])&#10;    WHEN &quot;FLGP (€)&quot; THEN SUM([flgp_eur_l3m])    &#10;    WHEN &quot;FLGPU (€)&quot; THEN [Calculation_1929159140119527458]&#10;    WHEN &quot;FLGPO&quot; THEN [Calculation_1929159140120313892]&#10;    WHEN &quot;Orders (#)&quot; THEN SUM([cnt_orders_l3m])&#10;    WHEN &quot;Order Frequency (#)&quot; THEN [Calculation_1929159140121350183]&#10;    WHEN &quot;AOV&quot; THEN [Calculation_1929159140119986211]&#10;    WHEN &quot;Total Incentives (€)&quot; THEN SUM([total_incentives_eur_l3m])&#10;    WHEN &quot;Incentivized Orders (#)&quot; THEN SUM([inc_orders_l3m])&#10;    WHEN &quot;Incentivized Orders (%)&quot; THEN [Calculation_1929159140120621093]&#10;    WHEN &quot;Incentive Depth (%)&quot; THEN [Calculation_1929159140120961062]&#10;    WHEN &quot;Subscriber Orders (#)&quot; THEN SUM([cnt_orders_l3m_subscribed])&#10;    WHEN &quot;Subscriber Orders (#) per User&quot; THEN [Calculation_1929159140121620520]&#10;    WHEN &quot;QCommerce Orders (#)&quot; THEN SUM([cnt_orders_l3m_qcommerce])&#10;    WHEN &quot;QCommerce Orders (#) per User&quot; THEN [Subscriber Orders (#) (copy)_1929159140122488874] &#10;END' />
            </column>
            <column caption='Segment Performance Over Time KPI Label' datatype='real' name='[KPI Test (copy)_364299018636816395]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Segment Breakdown Abs Totals KPI (copy)_364299018627850246]&#10;    WHEN &quot;Customer (#)&quot; THEN ROUND(SUM([cnt_customers]) / 1000000, 1)&#10;    WHEN &quot;Customer (#) FLGPU-&quot; THEN ROUND(SUM([cnt_customers_negative_flgpu_3m]) / 1000000, 1)&#10;    WHEN &quot;Customer (#) FLGPU+&quot; THEN ROUND(SUM([cnt_customers_positive_flgpu_3m]) / 1000000, 1)&#10;    WHEN &quot;GMV (€)&quot; THEN ROUND(SUM([gmv_eur_l3m]) / 1000000, 1)&#10;    WHEN &quot;GMVU (€)&quot; THEN [Calculation_1929159140119052321]&#10;    WHEN &quot;GBV (€)&quot; THEN ROUND(SUM([gbv_eur_l3m]) / 1000000, 1)&#10;    WHEN &quot;FLGP (€)&quot; THEN ROUND(SUM([flgp_eur_l3m]) / 1000000, 1)&#10;    WHEN &quot;FLGPU (€)&quot; THEN [Calculation_1929159140119527458]&#10;    WHEN &quot;FLGPO&quot; THEN [Calculation_1929159140120313892]&#10;    WHEN &quot;Orders (#)&quot; THEN ROUND(SUM([cnt_orders_l3m]) / 1000000, 1)&#10;    WHEN &quot;Order Frequency (#)&quot; THEN [Calculation_1929159140121350183]&#10;    WHEN &quot;AOV&quot; THEN [Calculation_1929159140119986211]&#10;    WHEN &quot;Total Incentives (€)&quot; THEN ROUND(SUM([total_incentives_eur_l3m]) / 1000000, 1)&#10;    WHEN &quot;Incentivized Orders (#)&quot; THEN ROUND(SUM([inc_orders_l3m]) / 1000000, 1)&#10;    WHEN &quot;Incentivized Orders (%)&quot; THEN [Calculation_1929159140120621093]&#10;    WHEN &quot;Incentive Depth (%)&quot; THEN [Calculation_1929159140120961062]&#10;    WHEN &quot;Subscriber Orders (#)&quot; THEN ROUND(SUM([cnt_orders_l3m_subscribed]) / 1000000, 1)&#10;    WHEN &quot;Subscriber Orders (#) per User&quot; THEN [Calculation_1929159140121620520]&#10;    WHEN &quot;QCommerce Orders (#)&quot; THEN ROUND(SUM([cnt_orders_l3m_qcommerce]) / 1000000, 1)&#10;    WHEN &quot;QCommerce Orders (#) per User&quot; THEN [Subscriber Orders (#) (copy)_1929159140122488874] &#10;END' />
            </column>
            <column caption='Segment Performance Over Time KPI Title' datatype='string' name='[KPI Test Label (copy)_364299018637369356]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Segment Breakdown Abs Totals KPI (copy)_364299018627850246]&#10;    WHEN &quot;Customer (#)&quot; THEN &quot;Customer (#) (in Million)&quot;&#10;    WHEN &quot;Customer (#) FLGPU-&quot; THEN &quot;Customer (#) FLGPU- (in Million)&quot;&#10;    WHEN &quot;Customer (#) FLGPU+&quot; THEN &quot;Customer (#) FLGPU+ (in Million)&quot;&#10;    WHEN &quot;GMV (€)&quot; THEN &quot;GMV (€) (in Million)&quot;&#10;    WHEN &quot;GMVU (€)&quot; THEN &quot;GMVU (€)&quot;&#10;    WHEN &quot;GBV (€)&quot; THEN &quot;GBV (€) (in Million)&quot;&#10;    WHEN &quot;FLGP (€)&quot; THEN &quot;FLGP (€) (in Million)&quot;&#10;    WHEN &quot;FLGPU (€)&quot; THEN &quot;FLGPU (€)&quot;&#10;    WHEN &quot;FLGPO&quot; THEN &quot;FLGPO&quot;&#10;    WHEN &quot;Orders (#)&quot; THEN &quot;Orders (#) (in Million)&quot;&#10;    WHEN &quot;Order Frequency (#)&quot; THEN &quot;Order Frequency (#)&quot;&#10;    WHEN &quot;AOV&quot; THEN &quot;AOV&quot;&#10;    WHEN &quot;Total Incentives (€)&quot; THEN &quot;Total Incentives (€) (in Million)&quot;&#10;    WHEN &quot;Incentivized Orders (#)&quot; THEN &quot;Incentivized Orders (#) (in Million)&quot;&#10;    WHEN &quot;Incentivized Orders (%)&quot; THEN &quot;Incentivized Orders (%)&quot;&#10;    WHEN &quot;Incentive Depth (%)&quot; THEN &quot;Incentive Depth (%)&quot;&#10;    WHEN &quot;Subscriber Orders (#)&quot; THEN &quot;Subscriber Orders (#) (in Million)&quot;&#10;    WHEN &quot;Subscriber Orders (#) per User&quot; THEN &quot;Subscriber Orders (#) per User&quot;&#10;    WHEN &quot;QCommerce Orders (#)&quot; THEN &quot;QCommerce Orders (#) (in Million)&quot;&#10;    WHEN &quot;QCommerce Orders (#) per User&quot; THEN &quot;QCommerce Orders (#) per User&quot;&#10;END' />
            </column>
            <column caption='QCommerce Orders (#)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Subscriber Orders (#) (copy)_1929159140122488874]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([cnt_orders_l3m_qcommerce]) / SUM([cnt_customers])) / 3' />
            </column>
            <column caption='Trend Start Date' datatype='boolean' name='[Trend End Date (copy)_1929159140141666373]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[snapshot_date] &gt;= DATEADD(&apos;month&apos;, -12, [Parameters].[Parameter 2])' />
