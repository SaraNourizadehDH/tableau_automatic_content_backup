            <column caption='AOV (only Mid) - SE' datatype='real' name='[AOV (only MVC) (copy)_171277544150265865]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [management_entity], [sub_entity], [snapshot_date] : &#10;    SUM(IF [orders_grp] = &apos;Low&apos; AND [flgpo_grp] = &apos;Profitable-Low&apos; THEN [gmv_eur_l3m] ELSE 0 END)&#10;    /&#10;    SUM(IF [orders_grp] = &apos;Low&apos; AND [flgpo_grp] = &apos;Profitable-Low&apos; THEN [cnt_orders_l3m] ELSE 0 END)&#10;}' />
