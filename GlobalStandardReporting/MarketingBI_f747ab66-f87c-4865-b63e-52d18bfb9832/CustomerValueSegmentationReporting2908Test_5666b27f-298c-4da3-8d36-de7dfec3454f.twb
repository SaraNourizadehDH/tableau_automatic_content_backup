              </aliases>
            </column>
            <column caption='Trend Start Date' datatype='boolean' name='[Trend End Date (copy)_1929159140141666373]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[snapshot_date] &gt;= DATEADD(&apos;month&apos;, -12, [Parameters].[Parameter 2])' />
