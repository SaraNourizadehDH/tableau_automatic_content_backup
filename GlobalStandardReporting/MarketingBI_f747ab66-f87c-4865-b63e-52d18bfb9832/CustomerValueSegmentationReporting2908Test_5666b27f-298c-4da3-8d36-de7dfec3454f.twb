              <calculation class='tableau' formula='[Parameters].[Parameter 2] = [period_2]' />
            </column>
            <column caption='Active Customers (HVC) - SE' datatype='integer' name='[Calculation_625648570998734866]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{&#10;    FIXED [management_entity], [sub_entity], [period_2] : &#10;        SUM(&#10;            IF [active_customer_value_segment] = &quot;1_HVC&quot; THEN [customers_count] ELSE 0 END&#10;        )&#10;}' />
            </column>
            <column caption='Active Customers (Value Segment) for To Value Segment - SE' datatype='integer' name='[Calculation_625648571003478039]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [to_value_segment]&#10;WHEN &quot;1_HVC&quot; THEN [Calculation_625648570998734866]&#10;WHEN &quot;2_MVC&quot; THEN [Active Customers (HVC) (copy)_625648571017322520]&#10;WHEN &quot;3_LVC&quot; THEN [Active Customers (HVC) (copy)_625648571017437209]&#10;WHEN &quot;4_high_loss&quot; THEN [Active Customers (HVC) (copy)_625648571017519130]&#10;ELSE 0&#10;END' />
            </column>
            <column caption='Segment Movement % (From Part) - SE' datatype='real' default-format='p0%' name='[Calculation_625648571018321947]' role='measure' type='quantitative'>
