              <calculation class='tableau' formula='[Calculation_1929159140119986211] / SUM([AOV (only Mid) - SE (copy)_171277544298229805])' />
            </column>
            <column caption='Segment Breakdown per User KPI (only Mid)' datatype='real' name='[AOV (only MVC) (copy)_171277544144699395]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_171277544258830361] = &quot;Sub Entity&quot;&#10;    THEN CASE [Parameters].[Parameter 3]&#10;            WHEN &quot;GMVU (€)&quot; THEN [GMVU (€) (Ratio to MVC) (copy)_171277544145960965]&#10;            WHEN &quot;FLGPU (€)&quot; THEN [FLGPU (€) (Ratio to MVC) (copy)_171277544149794824]&#10;            WHEN &quot;AOV&quot; THEN [AOV (Ratio to MVC) (copy)_171277544150376458]&#10;            WHEN &quot;FLGPO&quot; THEN [FLGPO (Ratio to MVC) (copy)_171277544150810636]&#10;            WHEN &quot;Incentivized Orders (%)&quot; THEN [Incentivized Orders (%) (Ratio to MVC) (copy)_171277544151277582]&#10;            WHEN &quot;Incentive Depth (%)&quot; THEN [Incentive Depth (%) (Ratio to MVC) (copy)_171277544151666704]&#10;            WHEN &quot;Order Frequency (#)&quot; THEN [Order Frequency (#) (Ratio to MVC) (copy)_171277544152023058]&#10;            WHEN &quot;Subscriber Orders (#)&quot; THEN [Subscriber Orders (Ratio to MVC) (copy)_171277544152490006]&#10;            WHEN &quot;QCommerce Orders (#)&quot; THEN [QCommerce Orders (Ratio to MVC) (copy)_171277544152408085]&#10;        END&#10;ELSEIF [Calculation_171277544258830361] = &quot;Management Entity&quot;&#10;    THEN CASE [Parameters].[Parameter 3]&#10;            WHEN &quot;GMVU (€)&quot; THEN [GMVU (€) (Ratio to Mid) - SE (copy)_171277544301342779]&#10;            WHEN &quot;FLGPU (€)&quot; THEN [FLGPU (€) (Ratio to Mid) - SE (copy)_171277544301244474]&#10;            WHEN &quot;AOV&quot; THEN [AOV (Ratio to Mid) - SE (copy)_171277544301043768]&#10;            WHEN &quot;FLGPO&quot; THEN [FLGPO (Ratio to Mid) - SE (copy)_171277544301121593]&#10;            WHEN &quot;Incentivized Orders (%)&quot; THEN [Incentivized Orders (%) (Ratio to Mid) - SE (copy)_171277544301518909]&#10;            WHEN &quot;Incentive Depth (%)&quot; THEN [Incentive Depth (%) (Ratio to Mid) - SE (copy)_171277544301441084]&#10;            WHEN &quot;Order Frequency (#)&quot; THEN [Order Frequency (#) (Ratio to Mid) - SE (copy)_171277544301674558]&#10;            WHEN &quot;Subscriber Orders (#)&quot; THEN [Subscriber Orders (Ratio to Mid) - SE (copy)_171277544301887552]&#10;            WHEN &quot;QCommerce Orders (#)&quot; THEN [QCommerce Orders (Ratio to Mid) - SE (copy)_171277544301764671]&#10;        END&#10;END' />
