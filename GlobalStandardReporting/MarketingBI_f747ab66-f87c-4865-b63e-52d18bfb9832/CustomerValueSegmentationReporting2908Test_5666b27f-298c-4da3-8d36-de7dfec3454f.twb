          <datasource-dependencies datasource='federated.14b5ybu0xqawsh10kwxqb18t5hd7'>
            <column caption='AOV (Ratio to Mid) - SE' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[AOV (Ratio to MVC) (copy)_171277544150376458]' role='measure' type='quantitative'>
