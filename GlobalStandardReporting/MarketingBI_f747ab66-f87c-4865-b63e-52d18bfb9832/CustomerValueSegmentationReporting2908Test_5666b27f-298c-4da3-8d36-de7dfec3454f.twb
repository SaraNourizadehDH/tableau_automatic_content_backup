    <worksheet name='Value Segment Drivers - High Loss'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#666666' fontname='Tableau Bold' fontsize='10'>Value Segment Drivers</run>
            <run fontcolor='#666666' fontsize='10'> - Trends in Profitability and Order Frequency</run>
            <run>Æ&#10;</run>
            <run fontcolor='#666666' fontsize='9' italic='true'>% of active customers per month by profitability and order frequency group</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Active Customers' name='federated.14b5ybu0xqawsh10kwxqb18t5hd7' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.14b5ybu0xqawsh10kwxqb18t5hd7].[Calculation_1337639522042474496]' caption='Snapshot Date' datatype='date' default-format='*MMM YYYY' name='[Parameter 2]' param-domain-type='list' role='measure' type='quantitative' value='#2025-06-30#'>
              <calculation class='tableau' formula='#2025-06-30#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.14b5ybu0xqawsh10kwxqb18t5hd7'>
            <column caption='Snapshot Date p' datatype='date' name='[Calculation_1337639522042474496]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[snapshot_date]' />
            </column>
            <column caption='Trend End Date' datatype='boolean' name='[Calculation_1929159140141510724]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[snapshot_date] &lt;= [Parameters].[Parameter 2]' />
            </column>
            <column caption='Profitability &amp; Frequency Grouping' datatype='string' name='[Calculation_364299018553663488]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[flgpo_grp] + &quot; &quot; + [orders_grp]' />
            </column>
            <column caption='Customer Count per Snapshot Month (VSD)' datatype='integer' name='[Calculation_364299018557779971]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [management_entity], [sub_entity], [snapshot_date] : SUM([cnt_customers]) }&#10;&#10;// VSD = Value Segment Drivers' />
            </column>
            <column caption='Customer Count % based on Profitability &amp; Frequency per Snapshot Date' datatype='real' name='[Calculation_364299018558197764]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_364299018559328261])&#10;/&#10;SUM([Calculation_364299018557779971])' />
            </column>
            <column caption='Customer Count per Profitability &amp; Frequency Grp (VSD)' datatype='integer' name='[Calculation_364299018559328261]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [management_entity], [sub_entity], [snapshot_date], [Profitability &amp; Frequency Grouping (copy)_364299018555523073], [Profitability &amp; Frequency Grouping (copy)_364299018555785218] : SUM([cnt_customers]) }&#10;&#10;// VSD = Value Segment Drivers' />
            </column>
            <column caption='Profitability ' datatype='string' name='[Profitability &amp; Frequency Grouping (copy)_364299018555523073]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[flgpo_grp]' />
              <aliases>
                <alias key='%null%' value='No Segment' />
              </aliases>
            </column>
            <column caption='Frequency ' datatype='string' name='[Profitability &amp; Frequency Grouping (copy)_364299018555785218]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[orders_grp]' />
              <aliases>
                <alias key='%null%' value='No Segment' />
              </aliases>
            </column>
            <column caption='Trend Start Date' datatype='boolean' name='[Trend End Date (copy)_1929159140141666373]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[snapshot_date] &gt;= DATEADD(&apos;month&apos;, -12, [Parameters].[Parameter 2])' />
            </column>
            <column caption='Cnt Customers' datatype='integer' name='[cnt_customers]' role='measure' type='quantitative' />
