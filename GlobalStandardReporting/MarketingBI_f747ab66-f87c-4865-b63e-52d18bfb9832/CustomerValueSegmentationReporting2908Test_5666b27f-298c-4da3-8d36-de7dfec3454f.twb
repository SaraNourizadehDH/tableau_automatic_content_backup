    <worksheet name='To - Segment Movement (%) - ME'>
      <table>
        <view>
          <datasources>
            <datasource caption='Segment Movement' name='federated.0ubsy1w0u308o1160mcvs0thln73' />
            <datasource caption='Active Customers' name='federated.14b5ybu0xqawsh10kwxqb18t5hd7' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.14b5ybu0xqawsh10kwxqb18t5hd7].[Calculation_1337639522042474496]' caption='Snapshot Date' datatype='date' default-format='*MMM YYYY' name='[Parameter 2]' param-domain-type='list' role='measure' type='quantitative' value='#2025-06-30#'>
              <calculation class='tableau' formula='#2025-06-30#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ubsy1w0u308o1160mcvs0thln73'>
            <column caption='Active Customers (HVC) - ME' datatype='integer' name='[Active Customers (HVC) - SE (copy)_625648571032277027]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{&#10;    FIXED [management_entity], [period_2] : &#10;        SUM(&#10;            IF [active_customer_value_segment] = &quot;1_HVC&quot; THEN [customers_count] ELSE 0 END&#10;        )&#10;}' />
            </column>
            <column caption='Active Customers (High Loss) - ME' datatype='integer' name='[Active Customers (High Loss) - SE (copy)_625648571032260642]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{&#10;    FIXED [management_entity], [period_2] : &#10;        SUM(&#10;            IF [active_customer_value_segment] = &quot;4_high_loss&quot; THEN [customers_count] ELSE 0 END&#10;        )&#10;}' />
            </column>
            <column caption='Active Customers (LVC) - ME' datatype='integer' name='[Active Customers (LVC) - SE (copy)_625648571032289316]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{&#10;    FIXED [management_entity], [period_2] : &#10;        SUM(&#10;            IF [active_customer_value_segment] = &quot;3_LVC&quot; THEN [customers_count] ELSE 0 END&#10;        )&#10;}' />
            </column>
            <column caption='Active Customers (MVC) - ME' datatype='integer' name='[Active Customers (MVC) - SE (copy)_625648571032305701]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{&#10;    FIXED [management_entity], [period_2] : &#10;        SUM(&#10;            IF [active_customer_value_segment] = &quot;2_MVC&quot; THEN [customers_count] ELSE 0 END&#10;        )&#10;}' />
            </column>
            <column caption='Active Customers (Value Segment) for From Value Segment - ME' datatype='integer' name='[Active Customers (Value Segment) for From Value Segment - SE (copy)_625648571036164139]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [from_value_segment]&#10;WHEN &quot;1_HVC&quot; THEN [Active Customers (HVC) - SE (copy)_625648571032277027]&#10;WHEN &quot;2_MVC&quot; THEN [Active Customers (MVC) - SE (copy)_625648571032305701]&#10;WHEN &quot;3_LVC&quot; THEN [Active Customers (LVC) - SE (copy)_625648571032289316]&#10;WHEN &quot;4_high_loss&quot; THEN [Active Customers (High Loss) - SE (copy)_625648571032260642]&#10;ELSE 0&#10;END' />
            </column>
            <column caption='To Value Segment Group' datatype='string' name='[Calculation_625648570687115265]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [to_lc_stage]&#10;    WHEN &quot;inactive&quot; THEN &quot;Churn&quot;&#10;    ELSE [to_value_segment]&#10;END' />
              <aliases>
                <alias key='&quot;1_HVC&quot;' value='HVC' />
                <alias key='&quot;2_MVC&quot;' value='MVC' />
                <alias key='&quot;3_LVC&quot;' value='LVC' />
                <alias key='&quot;4_high_loss&quot;' value='High Loss' />
              </aliases>
            </column>
            <column caption='Snapshot Filter' datatype='boolean' name='[Calculation_625648570984587268]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 2] = [period_2]' />
            </column>
            <column caption='Sub Entity Count in Filter' datatype='integer' name='[Calculation_625648571031502880]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [management_entity], [Parameters].[Parameter 2], [sub_entity] : COUNTD([sub_entity]) }' />
            </column>
            <column caption='Management Entity / Sub Entity Filter' datatype='string' name='[Calculation_625648571031687201]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF SUM([Calculation_625648571031502880]) = 1 THEN &quot;Sub Entity&quot;&#10;ELSEIF SUM([Calculation_625648571031502880]) &gt; 1 THEN &quot;Management Entity&quot;&#10;END' />
            </column>
            <column caption='Segment Movement % (To Part) - ME' datatype='real' default-format='p0%' name='[Segment Movement % (To Part) - SE (copy)_625648571036041258]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([customers_count]) / MIN([Active Customers (Value Segment) for From Value Segment - SE (copy)_625648571036164139])' />
            </column>
            <column datatype='string' name='[active_customer_value_segment]' role='dimension' type='nominal'>
              <aliases>
                <alias key='%null%' value='No Segment' />
                <alias key='&quot;1_HVC&quot;' value='HVC' />
                <alias key='&quot;2_MVC&quot;' value='MVC' />
                <alias key='&quot;3_LVC&quot;' value='LVC' />
                <alias key='&quot;4_high_loss&quot;' value='High Loss' />
