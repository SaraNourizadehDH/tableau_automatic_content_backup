              <calculation class='tableau' formula='CASE [to_value_segment]&#10;WHEN &quot;1_HVC&quot; THEN [Active Customers (HVC) - SE (copy)_625648571032277027]&#10;WHEN &quot;2_MVC&quot; THEN [Active Customers (MVC) - SE (copy)_625648571032305701]&#10;WHEN &quot;3_LVC&quot; THEN [Active Customers (LVC) - SE (copy)_625648571032289316]&#10;WHEN &quot;4_high_loss&quot; THEN [Active Customers (High Loss) - SE (copy)_625648571032260642]&#10;ELSE 0&#10;END' />
