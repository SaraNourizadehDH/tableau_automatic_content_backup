      <table>
        <view>
          <datasources>
            <datasource caption='bima_tableau_mkt_l2_report_detailed+ (rl_mkt)' name='federated.024jiat0syqo0o19fhj8k0kx50p6' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Interval 1: End' datatype='date' folder-name='Intervals' name='[Interval 1: Start (copy 2)]' param-domain-type='range' role='measure' type='quantitative' value='#2020-04-30#'>
              <calculation class='tableau' formula='#2020-04-30#' />
            </column>
            <column caption='Interval 2: End' datatype='date' folder-name='Intervals' name='[Interval 1: Start (copy) (copy)]' param-domain-type='range' role='measure' type='quantitative' value='#2020-07-31#'>
              <calculation class='tableau' formula='#2020-07-31#' />
            </column>
            <column caption='Interval 2: Start' datatype='date' folder-name='Intervals' name='[Interval 1: Start (copy)]' param-domain-type='range' role='measure' type='quantitative' value='#2020-05-01#'>
              <calculation class='tableau' formula='#2020-05-01#' />
            </column>
            <column alias='Monthly' caption='Select Date View' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;quarter&quot;' value='Quarterly' />
                <alias key='&quot;week&quot;' value='Weekly' />
                <alias key='&quot;year&quot;' value='Yearly' />
              </aliases>
            </column>
            <column caption='1. Dimension Switch' datatype='string' folder-name='Dimension Switch' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Management Entity&quot;'>
              <calculation class='tableau' formula='&quot;Management Entity&quot;' />
            </column>
            <column caption='Interval 1: Start' datatype='date' folder-name='Intervals' name='[Parameter 4]' param-domain-type='range' role='measure' type='quantitative' value='#2020-02-01#'>
              <calculation class='tableau' formula='#2020-02-01#' />
            </column>
            <column caption='Currency' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;EUR&quot;'>
              <calculation class='tableau' formula='&quot;EUR&quot;' />
            </column>
            <column caption='Attribution Model' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Calibrated with iOS 14.5 Fix&quot;'>
              <calculation class='tableau' formula='&quot;Calibrated with iOS 14.5 Fix&quot;' />
              <desc>
                <formatted-text>
                  <run>Choose from two different methods of distributing </run>
                  <run bold='true'>Acquisitions (not Orders)</run>
                  <run> to channels. 40-20-40 uses only digital touchpoints in the click-chain, whereas Exit Polls take into account offline channels like TV/OOH etc. from the Exit Poll data.</run>
                </formatted-text>
              </desc>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.024jiat0syqo0o19fhj8k0kx50p6'>
            <column caption='Acq. CVR**' datatype='real' default-format='p0.0%' name='[Acq. CVR* (copy 2)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Acquisitions* (copy 2)]) / SUM([Sessions* (copy)])' />
            </column>
            <column caption='Acq. Share*' datatype='real' default-format='p0.0%' name='[Acq. CVR* (copy 3)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_661466202874945536]) / SUM([Acquisitions* (copy)])' />
            </column>
            <column caption='Order CVR*' datatype='real' default-format='p0.0%' name='[Acq. CVR* (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Acquisitions* (copy)]) / SUM([Acquisitions* (copy) (copy)])' />
            </column>
            <column caption='Acquisitions**' datatype='real' name='[Acquisitions* (copy 2)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [date] &gt;= [Parameters].[Interval 1: Start (copy)] AND [date] &lt;= [Parameters].[Interval 1: Start (copy) (copy)] THEN [Calculation_5742089557526224896] ELSE 0 END' />
            </column>
            <column caption='Costs*' datatype='real' default-format='c&quot;€&quot;#,##0;(&quot;€&quot;#,##0)' name='[Acquisitions* (copy) (copy 2)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [date] &gt;= [Parameters].[Parameter 4] AND [date] &lt;= [Parameters].[Interval 1: Start (copy 2)] THEN [Calculation_1779695940233924609] ELSE 0 END' />
            </column>
            <column caption='CPA*' datatype='real' default-format='c&quot;€&quot;#,##0.00;(&quot;€&quot;#,##0.00)' name='[Acquisitions* (copy) (copy) (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Acquisitions* (copy) (copy 2)]) / SUM([Calculation_661466202874945536])' />
            </column>
            <column caption='Sessions*' datatype='integer' name='[Acquisitions* (copy) (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [date] &gt;= [Parameters].[Parameter 4] AND [date] &lt;= [Parameters].[Interval 1: Start (copy 2)] THEN [sessions] ELSE 0 END' />
            </column>
            <column caption='Orders*' datatype='real' name='[Acquisitions* (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [date] &gt;= [Parameters].[Parameter 4] AND [date] &lt;= [Parameters].[Interval 1: Start (copy 2)] THEN [orders] ELSE 0 END' />
            </column>
            <column caption='CPA**' datatype='real' default-format='c&quot;€&quot;#,##0.00;(&quot;€&quot;#,##0.00)' name='[CPA* (copy 2)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Costs* (copy)]) / SUM([Acquisitions* (copy 2)])' />
            </column>
            <column caption='Acq. CVR*' datatype='real' default-format='p0.0%' name='[CPA* (copy) (copy 2)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_661466202874945536]) / SUM([Acquisitions* (copy) (copy)])' />
