    <worksheet name='Channel Analysis Table: Channel Analysis'>
      <table>
        <view>
          <datasources>
            <datasource caption='bima_tableau_mkt_l2_report_detailed+ (rl_mkt)' name='federated.024jiat0syqo0o19fhj8k0kx50p6' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Channel Analysis Dimension Switch' datatype='string' folder-name='Dimension Switch' name='[1. Dimension Switch (copy 2)]' param-domain-type='list' role='measure' type='nominal' value='&quot;Channel&quot;'>
              <calculation class='tableau' formula='&quot;Channel&quot;' />
            </column>
            <column caption='KPI Switch' datatype='string' name='[Acquisitions/Orders/Reorders (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;Acquisitions&quot;'>
              <calculation class='tableau' formula='&quot;Acquisitions&quot;' />
            </column>
            <column alias='Monthly' caption='Select Date View' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;quarter&quot;' value='Quarterly' />
                <alias key='&quot;week&quot;' value='Weekly' />
                <alias key='&quot;year&quot;' value='Yearly' />
              </aliases>
            </column>
            <column caption='Currency' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;EUR&quot;'>
              <calculation class='tableau' formula='&quot;EUR&quot;' />
            </column>
            <column caption='Attribution Model' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Calibrated with iOS 14.5 Fix&quot;'>
              <calculation class='tableau' formula='&quot;Calibrated with iOS 14.5 Fix&quot;' />
              <desc>
                <formatted-text>
                  <run>Choose from two different methods of distributing </run>
                  <run bold='true'>Acquisitions (not Orders)</run>
                  <run> to channels. 40-20-40 uses only digital touchpoints in the click-chain, whereas Exit Polls take into account offline channels like TV/OOH etc. from the Exit Poll data.</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='Voucher Usage' datatype='string' name='[Parameter 9]' param-domain-type='list' role='measure' type='nominal' value='&quot;(All)&quot;'>
              <calculation class='tableau' formula='&quot;(All)&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.024jiat0syqo0o19fhj8k0kx50p6'>
            <column caption='Channel Analysis Dimension' datatype='string' name='[1. Dimension  (copy)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[1. Dimension Switch (copy 2)]&#10;WHEN &apos;Date&apos;                     THEN STR(DATE([Calculation_671317880946876416]))&#13;&#10;WHEN &apos;Management Entity&apos;        THEN [management_entity]&#13;&#10;WHEN &apos;Display Name&apos;             THEN [display_name]&#13;&#10;WHEN &apos;Country&apos;                  THEN [country]&#13;&#10;WHEN &apos;Platform Type&apos;            THEN [platform_type]&#10;WHEN &apos;Platform&apos;                 THEN [platform]&#13;&#10;WHEN &apos;Channel&apos;                  THEN [Calculation_152418765089320963]&#13;&#10;WHEN &apos;Sub-Channel&apos;              THEN [Channel (U/EP) (copy)]&#13;&#10;WHEN &apos;Channel - Sub-Channel&apos;    THEN [Channel - Sub-Channel (copy)] &#13;&#10;WHEN &apos;Device&apos;                   THEN [platform_type]&#13;&#10;END' />
              <aliases>
                <alias key='&quot;SOCIALMEDIAENGAGEMENT&quot;' value='SOCIALMEDIA ENGAGEMENT' />
              </aliases>
            </column>
            <column caption='Orders without Voucher' datatype='real' name='[Acquisitions without Voucher (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([orders], 0) - IFNULL([orders_with_voucher], 0)' />
            </column>
            <column caption='Channel   ' datatype='string' name='[Calculation_152418765089320963]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[channel]' />
            </column>
            <column caption='Costs' datatype='real' name='[Calculation_1779695940233924609]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;EUR&apos; THEN [costs_eur]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;USD&apos; THEN [costs_usd]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;LC&apos; THEN [costs_lc]&#10;END' />
            </column>
            <column caption='Calibration?' datatype='string' name='[Calculation_2319142715812691971]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF SUM(IFNULL([is_calibrated], 0)) &gt; 0 THEN &apos;Yes&apos; ELSE &apos;No&apos; END' />
            </column>
            <column caption='1' datatype='real' name='[Calculation_239535208187621384]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0.3' />
            </column>
            <column caption='Acquisitions (no Voucher)' datatype='real' name='[Calculation_2457065499956469762]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_5742089557526224896]) - SUM([acquisitions_with_voucher])' />
            </column>
            <column caption='Switch: Acquisitions Voucher Switch' datatype='real' name='[Calculation_3631027218793607168]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 9]&#10;WHEN &apos;Yes&apos;   THEN SUM([acquisitions_with_voucher])&#10;WHEN &apos;No&apos;    THEN [Calculation_2457065499956469762]&#10;WHEN &apos;(All)&apos; THEN SUM([Calculation_5742089557526224896])&#10;END' />
            </column>
            <column caption='Date Filter' datatype='boolean' name='[Calculation_4301148783956627456]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[date] &lt;= TODAY()' />
            </column>
            <column caption='Acquisitions Attr.' datatype='real' name='[Calculation_5742089557526224896]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6] &#13;&#10;WHEN &apos;40-20-40&apos; THEN [acquisitions]&#13;&#10;WHEN &apos;Calibrated&apos; THEN [acquisitions_calibration]&#13;&#10;WHEN &apos;40-20-40 with iOS 14.5 Fix&apos; THEN [acquisitions_ios14fix]&#13;&#10;WHEN &apos;Calibrated with iOS 14.5 Fix&apos; THEN [acquisitions_calibration_ios14fix]&#13;&#10;END' />
            </column>
            <column caption='Date ' datatype='datetime' default-format='*YY-MM-DD' name='[Calculation_671317880946876416]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATETRUNC([Parameters].[Parameter 1],[date],&apos;monday&apos;)' />
            </column>
            <column caption='Sub-Channel   ' datatype='string' name='[Channel (U/EP) (copy)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[sub_channel]' />
            </column>
            <column caption='Channel - Sub-Channel   ' datatype='string' name='[Channel - Sub-Channel (copy)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_152418765089320963] + &#10;IF [Channel (U/EP) (copy)] = &apos;&apos; THEN &apos;&apos; ELSE &quot; - &quot; + [Channel (U/EP) (copy)] END' />
              <aliases>
                <alias key='&quot;SEM - RESTAURANTS&quot;' value='SEM - REST.' />
              </aliases>
            </column>
            <column caption='Filter: Sub-Channel -- TARGET' datatype='string' name='[Sub-Channel (copy)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[sub_channel]' />
              <aliases>
                <alias key='&quot;RESTAURANT MARKETING&quot;' value='REST. MKT' />
              </aliases>
            </column>
            <column caption='Switch: Orders Voucher Switch' datatype='real' name='[Switch: Acquisitions Voucher Switch (copy)_3631027218797948929]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 9]&#10;WHEN &apos;Yes&apos;   THEN [orders_with_voucher]&#10;WHEN &apos;No&apos;    THEN [Acquisitions without Voucher (copy)]&#10;WHEN &apos;(All)&apos; THEN [orders]&#10;END' />
            </column>
            <column caption='Switch: KPI Switch' datatype='real' name='[Switch: Acquisitions/Orders/Reorders (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Acquisitions/Orders/Reorders (copy)]&#10;WHEN &apos;Acquisitions&apos;     THEN [Calculation_3631027218793607168]&#13;&#10;WHEN &apos;Orders&apos;           THEN SUM([Switch: Acquisitions Voucher Switch (copy)_3631027218797948929])&#13;&#10;WHEN &apos;Reorders&apos;         THEN SUM([Switch: Orders Voucher Switch (copy)_3631027218799984643])&#10;WHEN &apos;Costs&apos;            THEN SUM([Calculation_1779695940233924609])&#10;WHEN &apos;CPA&apos;              THEN SUM([Calculation_1779695940233924609]) / SUM([Calculation_5742089557526224896])&#13;&#10;END' />
            </column>
            <column caption='Switch: Reorders Voucher Switch' datatype='real' name='[Switch: Orders Voucher Switch (copy)_3631027218799984643]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 9]&#10;WHEN &apos;Yes&apos;   THEN [reorders_with_voucher]&#10;WHEN &apos;No&apos;    THEN [reorders] - [reorders_with_voucher]&#10;WHEN &apos;(All)&apos; THEN [reorders]&#10;END' />
            </column>
            <column caption='Switch: KPI Switch - delta' datatype='real' default-format='p0.00%' name='[Switch: delta Acquisitions/Orders/Reorders (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Switch: Acquisitions/Orders/Reorders (copy)] / LOOKUP([Switch: Acquisitions/Orders/Reorders (copy)], -1) ) -1'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Switch: KPI Switch - delta Shape' datatype='integer' name='[Switch: delta Shape (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Acquisitions/Orders/Reorders (copy)] != &apos;Costs&apos; AND [Parameters].[Acquisitions/Orders/Reorders (copy)] != &apos;CPA&apos; AND [Switch: delta Acquisitions/Orders/Reorders (copy)] &gt; 0 THEN 1&#13;&#10;ELSEIF [Parameters].[Acquisitions/Orders/Reorders (copy)] != &apos;Costs&apos; AND [Parameters].[Acquisitions/Orders/Reorders (copy)] != &apos;CPA&apos; AND [Switch: delta Acquisitions/Orders/Reorders (copy)] &lt; 0 then -1&#10;ELSEIF [Switch: delta Acquisitions/Orders/Reorders (copy)] &gt; 0 THEN -2&#10;ELSEIF [Switch: delta Acquisitions/Orders/Reorders (copy)] &lt; 0 then 2&#13;&#10;ELSE 0&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Acquisitions' datatype='real' name='[acquisitions]' role='measure' type='quantitative' />
            <column caption='Acquisitions [Calibrated]' datatype='real' name='[acquisitions_calibration]' role='measure' type='quantitative' />
            <column caption='Acquisitions [Calibrated] [iOS 14.5 Fix]' datatype='real' name='[acquisitions_calibration_ios14fix]' role='measure' type='quantitative' />
