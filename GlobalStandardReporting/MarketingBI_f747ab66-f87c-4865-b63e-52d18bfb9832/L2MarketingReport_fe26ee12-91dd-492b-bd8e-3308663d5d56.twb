      <datasources>
        <datasource name='Parameters' />
        <datasource caption='bima_tableau_mkt_l2_report_detailed+ (rl_mkt)' name='federated.024jiat0syqo0o19fhj8k0kx50p6' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column alias='Monthly' caption='Select Date View' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
          <calculation class='tableau' formula='&quot;month&quot;' />
          <aliases>
            <alias key='&quot;day&quot;' value='Daily' />
            <alias key='&quot;month&quot;' value='Monthly' />
            <alias key='&quot;quarter&quot;' value='Quarterly' />
            <alias key='&quot;week&quot;' value='Weekly' />
            <alias key='&quot;year&quot;' value='Yearly' />
          </aliases>
          <members>
            <member alias='Daily' value='&quot;day&quot;' />
            <member alias='Weekly' value='&quot;week&quot;' />
            <member alias='Monthly' value='&quot;month&quot;' />
            <member alias='Quarterly' value='&quot;quarter&quot;' />
            <member alias='Yearly' value='&quot;year&quot;' />
          </members>
        </column>
        <column caption='Currency' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;EUR&quot;'>
          <calculation class='tableau' formula='&quot;EUR&quot;' />
          <members>
            <member value='&quot;EUR&quot;' />
            <member value='&quot;USD&quot;' />
            <member value='&quot;LC&quot;' />
          </members>
        </column>
        <column caption='Attribution Model' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Calibrated with iOS 14.5 Fix&quot;'>
          <calculation class='tableau' formula='&quot;Calibrated with iOS 14.5 Fix&quot;' />
          <desc>
            <formatted-text>
              <run>Choose from two different methods of distributing </run>
              <run bold='true'>Acquisitions (not Orders)</run>
              <run> to channels. 40-20-40 uses only digital touchpoints in the click-chain, whereas Exit Polls take into account offline channels like TV/OOH etc. from the Exit Poll data.</run>
            </formatted-text>
          </desc>
          <members>
            <member value='&quot;40-20-40&quot;' />
            <member value='&quot;Calibrated&quot;' />
            <member value='&quot;40-20-40 with iOS 14.5 Fix&quot;' />
            <member value='&quot;Calibrated with iOS 14.5 Fix&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.024jiat0syqo0o19fhj8k0kx50p6'>
        <column caption='Date ' datatype='datetime' default-format='*YY-MM-DD' name='[Calculation_671317880946876416]' role='dimension' type='quantitative'>
          <calculation class='tableau' formula='DATETRUNC([Parameters].[Parameter 1],[date],&apos;monday&apos;)' />
