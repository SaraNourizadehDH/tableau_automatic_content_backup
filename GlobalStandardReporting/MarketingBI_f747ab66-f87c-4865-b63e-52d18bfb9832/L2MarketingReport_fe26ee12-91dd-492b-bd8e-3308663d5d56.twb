    <worksheet name='Channel Drill Down: App'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='10'>&lt;Sheet Name&gt;</run>
            <run>Æ&#10;</run>
            <run fontcolor='#4e79a7' fontsize='9'>Reach</run>
            <run fontsize='9'> - </run>
            <run fontcolor='#e15759' fontsize='9'>RMA</run>
            <run fontsize='9'> - </run>
            <run fontcolor='#59a14f' fontsize='9'>RMO </run>
            <run fontcolor='#000000' fontsize='9'>-</run>
            <run fontcolor='#59a14f' fontsize='9'>Æ </run>
            <run fontcolor='#f28e2b' fontsize='9'>BRA</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='bima_tableau_mkt_l2_report_detailed+ (rl_mkt)' name='federated.024jiat0syqo0o19fhj8k0kx50p6' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Monthly' caption='Select Date View' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;quarter&quot;' value='Quarterly' />
                <alias key='&quot;week&quot;' value='Weekly' />
                <alias key='&quot;year&quot;' value='Yearly' />
              </aliases>
            </column>
            <column caption='Currency' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;EUR&quot;'>
              <calculation class='tableau' formula='&quot;EUR&quot;' />
            </column>
            <column caption='Attribution Model' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Calibrated with iOS 14.5 Fix&quot;'>
              <calculation class='tableau' formula='&quot;Calibrated with iOS 14.5 Fix&quot;' />
              <desc>
                <formatted-text>
                  <run>Choose from two different methods of distributing </run>
                  <run bold='true'>Acquisitions (not Orders)</run>
                  <run> to channels. 40-20-40 uses only digital touchpoints in the click-chain, whereas Exit Polls take into account offline channels like TV/OOH etc. from the Exit Poll data.</run>
                </formatted-text>
              </desc>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.024jiat0syqo0o19fhj8k0kx50p6'>
            <column caption='Channel   ' datatype='string' name='[Calculation_152418765089320963]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[channel]' />
            </column>
            <column caption='Costs' datatype='real' name='[Calculation_1779695940233924609]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;EUR&apos; THEN [costs_eur]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;USD&apos; THEN [costs_usd]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;LC&apos; THEN [costs_lc]&#10;END' />
            </column>
            <column caption='Calibration Start' datatype='date' name='[Calculation_2319142715775873025]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='IF [is_calibrated] = 1 THEN [date] ELSE NULL END' />
            </column>
            <column caption='Channel - Sub Channel' datatype='string' name='[Calculation_239535208154656768]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[channel] + &quot; - &quot; + [sub_channel]' />
            </column>
            <column caption='CPA' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_239535208184770565]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1779695940233924609]) / SUM([Calculation_5742089557526224896])' />
            </column>
            <column caption='Date Filter' datatype='boolean' name='[Calculation_4301148783956627456]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[date] &lt;= TODAY()' />
            </column>
            <column caption='Acquisitions Attr.' datatype='real' name='[Calculation_5742089557526224896]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6] &#13;&#10;WHEN &apos;40-20-40&apos; THEN [acquisitions]&#13;&#10;WHEN &apos;Calibrated&apos; THEN [acquisitions_calibration]&#13;&#10;WHEN &apos;40-20-40 with iOS 14.5 Fix&apos; THEN [acquisitions_ios14fix]&#13;&#10;WHEN &apos;Calibrated with iOS 14.5 Fix&apos; THEN [acquisitions_calibration_ios14fix]&#13;&#10;END' />
            </column>
            <column caption='Date ' datatype='datetime' default-format='*YY-MM-DD' name='[Calculation_671317880946876416]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATETRUNC([Parameters].[Parameter 1],[date],&apos;monday&apos;)' />
            </column>
            <column caption='Calibration Tooltip' datatype='string' name='[Calculation_6814016639007252480]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = &apos;Calibrated&apos; THEN&#10;    IF {COUNTD([country])} = 1&#10;        THEN &apos;Calibration Factor: &apos;+LEFT(STR({FIXED [Calculation_239535208154656768],[date] : MAX(IF [Calculation_2319142715775873025] = [date] THEN [calibration_factor] END)}),5)&#10;        ELSE &apos;Select a country to see the Calibration Factor&apos;&#10;    END&#10;END' />
            </column>
            <column caption='Filter: Sub-Channel -- TARGET' datatype='string' name='[Sub-Channel (copy)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[sub_channel]' />
              <aliases>
                <alias key='&quot;RESTAURANT MARKETING&quot;' value='REST. MKT' />
              </aliases>
            </column>
            <column caption='Acquisitions' datatype='real' name='[acquisitions]' role='measure' type='quantitative' />
            <column caption='Acquisitions [Calibrated]' datatype='real' name='[acquisitions_calibration]' role='measure' type='quantitative' />
            <column caption='Acquisitions [Calibrated] [iOS 14.5 Fix]' datatype='real' name='[acquisitions_calibration_ios14fix]' role='measure' type='quantitative' />
            <column caption='Acquisitions [iOS 14.5 Fix]' datatype='real' name='[acquisitions_ios14fix]' role='measure' type='quantitative' />
            <column caption='Calibration Factor' datatype='real' name='[calibration_factor]' role='measure' type='quantitative' />
            <column caption='Channel' datatype='string' name='[channel]' role='dimension' type='nominal' />
            <column caption='Costs (EUR)' datatype='real' name='[costs_eur]' role='measure' type='quantitative' />
            <column caption='Costs (LC)' datatype='real' name='[costs_lc]' role='measure' type='quantitative' />
            <column caption='Costs (USD)' datatype='real' name='[costs_usd]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column caption='Display Name' datatype='string' name='[display_name]' role='dimension' type='nominal' />
            <column caption='Is Calibrated' datatype='integer' name='[is_calibrated]' role='measure' type='quantitative' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_152418765089320963]' derivation='None' name='[none:Calculation_152418765089320963:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_4301148783956627456]' derivation='None' name='[none:Calculation_4301148783956627456:nk]' pivot='key' type='nominal' />
