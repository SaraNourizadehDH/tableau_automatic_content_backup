    <worksheet name='Overall Efficiency Curves: Graph'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='8'>Note:</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Verdana,sans-serif' fontsize='8'>· </run>
            <run fontsize='8'>dependant on the date view the dots represent days/weeks/months/quarters/years</run>
