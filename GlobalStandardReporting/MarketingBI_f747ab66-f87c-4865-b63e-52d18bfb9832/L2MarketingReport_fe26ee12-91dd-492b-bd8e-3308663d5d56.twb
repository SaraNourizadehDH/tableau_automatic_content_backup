              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;EUR&apos; THEN [amt_voucher_eur]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;USD&apos; THEN [amt_voucher_usd]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;LC&apos; THEN [amt_voucher_lc]&#10;END' />
            </column>
            <column caption='aCVR' datatype='real' default-format='p0.00%' name='[Calculation_231090960986861575]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//SUM([Acquisition Attr.]) / SUM([Sessions])&#10;SUM([Calculation_5742089557526224896]) / SUM([new_sessions])' />
            </column>
            <column caption='Acquisitions Share' datatype='real' default-format='p0.00%' name='[Calculation_231090961335713809]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_5742089557526224896]) / SUM([orders])' />
