            <column caption='Com. Revenue All' datatype='real' default-format='c&quot;€&quot;#,##0;(&quot;€&quot;#,##0)' name='[Com. Revenue (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;EUR&apos; THEN [amt_commission_eur]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;USD&apos; THEN [amt_commission_usd]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;LC&apos; THEN [amt_commission_lc]&#10;END' />
            </column>
            <column caption='Cost [Target]' datatype='real' name='[Costs (copy)]' role='measure' type='quantitative'>
