    <worksheet name='Overview Graphs: CPA Bar Chart'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000'>CPA </run>
            <run bold='true' fontcolor='#000000' fontsize='8'>and YoY % changes</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='bima_tableau_mkt_l2_report_detailed+ (rl_mkt)' name='federated.024jiat0syqo0o19fhj8k0kx50p6' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Monthly' caption='Select Date View' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;quarter&quot;' value='Quarterly' />
                <alias key='&quot;week&quot;' value='Weekly' />
                <alias key='&quot;year&quot;' value='Yearly' />
              </aliases>
            </column>
            <column caption='Currency' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;EUR&quot;'>
              <calculation class='tableau' formula='&quot;EUR&quot;' />
            </column>
            <column caption='Attribution Model' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Calibrated with iOS 14.5 Fix&quot;'>
              <calculation class='tableau' formula='&quot;Calibrated with iOS 14.5 Fix&quot;' />
              <desc>
                <formatted-text>
                  <run>Choose from two different methods of distributing </run>
                  <run bold='true'>Acquisitions (not Orders)</run>
                  <run> to channels. 40-20-40 uses only digital touchpoints in the click-chain, whereas Exit Polls take into account offline channels like TV/OOH etc. from the Exit Poll data.</run>
                </formatted-text>
              </desc>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.024jiat0syqo0o19fhj8k0kx50p6'>
            <column caption='CPA [Target]' datatype='real' datatype-customized='true' name='[Acquisitions [Target]] (switch) (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Costs (copy)]) / SUM([acquisitions_target])' />
            </column>
            <column caption='CPA YoY%' datatype='real' default-format='p0.00%' name='[CPA (copy 2)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_239535208184770565]&#10;/ &#10;(&#10;IF [Parameters].[Parameter 1] = &apos;month&apos; THEN [Calculation_1488791557807788035]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;week&apos; THEN [CPA [prev. Year]] (copy)]&#10;ELSE NULL&#10;END&#10;) - 1' />
            </column>
            <column caption='CPA [Budget]' datatype='real' datatype-customized='true' name='[CPA [Target]] (switch) (copy)_3483604738990882818]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Costs (copy 2)_3483604738989252608]) / SUM([acquisitions_budget])' />
            </column>
            <column caption='CPA [prev. 364 Days]' datatype='real' name='[CPA [prev. Year]] (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Costs [prev. Year]] (copy)]) / SUM([prev_364d_acquisitions])' />
            </column>
            <column caption='CPA [prev. Year]' datatype='real' name='[Calculation_1488791557807788035]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1779695940238405635]) / SUM([prev_y_acquisitions])' />
            </column>
            <column caption='Channel   ' datatype='string' name='[Calculation_152418765089320963]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[channel]' />
            </column>
            <column caption='Costs' datatype='real' name='[Calculation_1779695940233924609]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;EUR&apos; THEN [costs_eur]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;USD&apos; THEN [costs_usd]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;LC&apos; THEN [costs_lc]&#10;END' />
            </column>
            <column caption='Costs [prev. Year]' datatype='real' name='[Calculation_1779695940238405635]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;EUR&apos; THEN [prev_y_costs_eur]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;USD&apos; THEN [prev_y_costs_usd]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;LC&apos; THEN [prev_y_costs_lc]&#10;END' />
            </column>
            <column caption='CPA' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_239535208184770565]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1779695940233924609]) / SUM([Calculation_5742089557526224896])' />
            </column>
            <column caption='Date Filter' datatype='boolean' name='[Calculation_4301148783956627456]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[date] &lt;= TODAY()' />
            </column>
            <column caption='Acquisitions Attr.' datatype='real' name='[Calculation_5742089557526224896]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6] &#13;&#10;WHEN &apos;40-20-40&apos; THEN [acquisitions]&#13;&#10;WHEN &apos;Calibrated&apos; THEN [acquisitions_calibration]&#13;&#10;WHEN &apos;40-20-40 with iOS 14.5 Fix&apos; THEN [acquisitions_ios14fix]&#13;&#10;WHEN &apos;Calibrated with iOS 14.5 Fix&apos; THEN [acquisitions_calibration_ios14fix]&#13;&#10;END' />
            </column>
            <column caption='Date ' datatype='datetime' default-format='*YY-MM-DD' name='[Calculation_671317880946876416]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATETRUNC([Parameters].[Parameter 1],[date],&apos;monday&apos;)' />
            </column>
            <column caption='Sub-Channel   ' datatype='string' name='[Channel (U/EP) (copy)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[sub_channel]' />
            </column>
            <column caption='Channel - Sub-Channel   ' datatype='string' name='[Channel - Sub-Channel (copy)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_152418765089320963] + &#10;IF [Channel (U/EP) (copy)] = &apos;&apos; THEN &apos;&apos; ELSE &quot; - &quot; + [Channel (U/EP) (copy)] END' />
              <aliases>
