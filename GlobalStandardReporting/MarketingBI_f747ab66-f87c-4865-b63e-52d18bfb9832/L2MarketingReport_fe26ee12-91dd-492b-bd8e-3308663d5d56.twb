    <worksheet name='Overall Actuals vs Targets Monthly: Graph'>
      <table>
        <view>
          <datasources>
            <datasource caption='bima_tableau_mkt_l2_report_detailed+ (rl_mkt)' name='federated.024jiat0syqo0o19fhj8k0kx50p6' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Monthly' caption='Select Date View' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;quarter&quot;' value='Quarterly' />
                <alias key='&quot;week&quot;' value='Weekly' />
                <alias key='&quot;year&quot;' value='Yearly' />
              </aliases>
            </column>
            <column caption='Currency' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;EUR&quot;'>
              <calculation class='tableau' formula='&quot;EUR&quot;' />
            </column>
            <column caption='Attribution Model' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Calibrated with iOS 14.5 Fix&quot;'>
              <calculation class='tableau' formula='&quot;Calibrated with iOS 14.5 Fix&quot;' />
              <desc>
                <formatted-text>
                  <run>Choose from two different methods of distributing </run>
                  <run bold='true'>Acquisitions (not Orders)</run>
                  <run> to channels. 40-20-40 uses only digital touchpoints in the click-chain, whereas Exit Polls take into account offline channels like TV/OOH etc. from the Exit Poll data.</run>
                </formatted-text>
              </desc>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.024jiat0syqo0o19fhj8k0kx50p6'>
            <column caption='% Dif. Actuals vs Targets: Acquisitions' datatype='real' name='[# Dif. Actuals vs Targets: Acquisitions (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_5742089557526224896]) - SUM([acquisitions_target])) / SUM([acquisitions_target])' />
            </column>
            <column caption='% Dif. Actuals vs Targets: CPA' datatype='real' name='[# Dif. Actuals vs Targets: CPA (copy 2)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_239535208184770565] - [Acquisitions [Target]] (switch) (copy)]) / [Acquisitions [Target]] (switch) (copy)]' />
            </column>
            <column caption='CPA [Target]' datatype='real' datatype-customized='true' name='[Acquisitions [Target]] (switch) (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Costs (copy)]) / SUM([acquisitions_target])' />
            </column>
            <column caption='CPA YoY%' datatype='real' default-format='p0.00%' name='[CPA (copy 2)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_239535208184770565]&#10;/ &#10;(&#10;IF [Parameters].[Parameter 1] = &apos;month&apos; THEN [Calculation_1488791557807788035]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;week&apos; THEN [CPA [prev. Year]] (copy)]&#10;ELSE NULL&#10;END&#10;) - 1' />
            </column>
            <column caption='CPA [prev. 364 Days]' datatype='real' name='[CPA [prev. Year]] (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Costs [prev. Year]] (copy)]) / SUM([prev_364d_acquisitions])' />
            </column>
            <column caption='CPA [prev. Year]' datatype='real' name='[Calculation_1488791557807788035]' role='measure' type='quantitative'>
