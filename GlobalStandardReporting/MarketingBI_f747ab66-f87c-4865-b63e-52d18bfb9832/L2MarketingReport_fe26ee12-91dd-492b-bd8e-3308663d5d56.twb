            </column>
            <column caption='Channel - Sub-Channel 1; EP FILTER' datatype='string' name='[Channel - Sub-Channel (copy 2)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[channel] + &quot; - &quot; + IF [channel] = &apos;SEO&apos; AND [sub_channel] = &apos;&apos; THEN &apos;NONBRAND&apos; ELSE [sub_channel] END' />
