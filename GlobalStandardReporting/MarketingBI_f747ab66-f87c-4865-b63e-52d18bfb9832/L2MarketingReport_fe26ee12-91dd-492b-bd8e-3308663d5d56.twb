    <dashboard name='Marketing Mix'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/L2MarketingReport_0/MarketingMix?rev=' id='MarketingMix' path='/t/GlobalStandardReporting/workbooks/L2MarketingReport_17436861162930' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='parameter-ctrl'>
          <format attr='background-color' value='#ffffff' />
        </style-rule>
      </style>
      <size maxheight='1400' maxwidth='2000' minheight='700' minwidth='1350' sizing-mode='range' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='bima_tableau_mkt_l2_report_detailed+ (rl_mkt)' name='federated.024jiat0syqo0o19fhj8k0kx50p6' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Acquisitions/Costs/Sessions/New Visits' datatype='string' name='[Acquisitions/Orders/Reorders (copy 2)_1963358352671772675]' param-domain-type='list' role='measure' type='nominal' value='&quot;Acquisitions&quot;'>
          <calculation class='tableau' formula='&quot;Acquisitions&quot;' />
          <members>
            <member value='&quot;Acquisitions&quot;' />
            <member value='&quot;Cost&quot;' />
            <member value='&quot;Sessions&quot;' />
            <member value='&quot;New Visits/Installs&quot;' />
          </members>
        </column>
        <column caption='Acquisitions/Session/New' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Acquisitions&quot;'>
          <calculation class='tableau' formula='&quot;Acquisitions&quot;' />
          <members>
            <member value='&quot;Acquisitions&quot;' />
            <member value='&quot;Orders&quot;' />
            <member value='&quot;Reorders&quot;' />
            <member value='&quot;Sessions&quot;' />
            <member value='&quot;New Visits/Installs&quot;' />
          </members>
        </column>
        <column caption='Attribution Model' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Calibrated with iOS 14.5 Fix&quot;'>
          <calculation class='tableau' formula='&quot;Calibrated with iOS 14.5 Fix&quot;' />
          <desc>
            <formatted-text>
              <run>Choose from two different methods of distributing </run>
              <run bold='true'>Acquisitions (not Orders)</run>
              <run> to channels. 40-20-40 uses only digital touchpoints in the click-chain, whereas Exit Polls take into account offline channels like TV/OOH etc. from the Exit Poll data.</run>
            </formatted-text>
          </desc>
          <members>
            <member value='&quot;40-20-40&quot;' />
            <member value='&quot;Calibrated&quot;' />
            <member value='&quot;40-20-40 with iOS 14.5 Fix&quot;' />
            <member value='&quot;Calibrated with iOS 14.5 Fix&quot;' />
          </members>
        </column>
