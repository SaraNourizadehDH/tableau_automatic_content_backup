      </connection>
      <aliases enabled='yes' />
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_145311516515344384]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='USERNAME()=[username]' />
      </column>
      <column caption='Channel' datatype='string' name='[Calculation_1988128189455618048]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='UPPER([Calculation_6654490674906275840])' />
      </column>
      <column caption='Churning (-)' datatype='integer' name='[Calculation_2330683197569777665]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[churning] * -1' />
      </column>
      <column caption='New Inactive Customers (-)' datatype='integer' name='[Calculation_2330683197569896450]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[new_inactive_customers] * -1' />
      </column>
      <column caption='Activity Rate' datatype='real' name='[Calculation_2330683197582618627]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders]) / SUM([Calculation_3515059544965722113])' />
      </column>
      <column caption='Help me button label' datatype='string' name='[Calculation_2484087089488359424]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;?&quot;' />
      </column>
      <column caption='Boolean: Current Month' datatype='boolean' name='[Calculation_3339841340074151938]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, TODAY()) = [month_date]' />
      </column>
      <column caption='Active Customer' datatype='integer' name='[Calculation_3515059544965722113]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([retained_customers], 0) + &#10;IFNULL([acquisitions], 0) + &#10;IFNULL([reactivated_customers], 0) +&#10;IFNULL([almost_churned_customers], 0)' />
      </column>
      <column caption='NPS AO' datatype='real' name='[Calculation_3769794429203070976]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100 * (sum([nps_ao_promoters]) - sum([nps_ao_detractors])) / sum([nps_ao_responses])' />
      </column>
      <column caption='CVR' datatype='real' default-format='p0.0%' name='[Calculation_3769794429203402753]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='( sum([transactions_new])+sum([transactions_returning]) ) / (sum([sessions_new]) + sum([sessions_returning]))' />
      </column>
      <column caption='Hard Fail Rate' datatype='real' default-format='p0.0%' name='[Calculation_3769794429203632130]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([hard_failed_orders]) / sum( [total_orders_exc_call] )' />
      </column>
      <column caption='Net Base Growth' datatype='integer' name='[Calculation_5963539986990718976]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[acquisitions] + [retained_customers] + &#10;[almost_churned_customers] + [reactivated_customers] + &#10;[Calculation_2330683197569896450] + [Calculation_2330683197569777665]' />
      </column>
      <column caption='Channel (old)' datatype='string' name='[Calculation_6654490674906275840]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Placeholder&apos;' />
      </column>
