        <calculation class='tableau' formula='([Calculation_1779695940233924609])&#10;-&#10;IF [Parameters].[Parameter 1] = &apos;month&apos; THEN ([Calculation_1779695940238405635])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;week&apos; THEN ([Costs [prev. Year]] (copy)])&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Orders**' datatype='real' name='[Orders* (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [date] &gt;= [Parameters].[Interval 1: Start (copy)] AND [date] &lt;= [Parameters].[Interval 1: Start (copy) (copy)] THEN [orders] ELSE 0 END' />
      </column>
      <column datatype='string' name='[Platform (copy)]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[platform]' />
      </column>
      <column datatype='string' name='[Platform Type (copy)]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[platform_type]' />
      </column>
      <column caption='Sessions**' datatype='integer' name='[Sessions* (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [date] &gt;= [Parameters].[Interval 1: Start (copy)] AND [date] &lt;= [Parameters].[Interval 1: Start (copy) (copy)] THEN [sessions] ELSE 0 END' />
      </column>
      <column caption='Filter: Sub-Channel -- TARGET' datatype='string' name='[Sub-Channel (copy)]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[sub_channel]' />
        <aliases>
          <alias key='&quot;RESTAURANT MARKETING&quot;' value='REST. MKT' />
        </aliases>
      </column>
      <column caption='Switch: Orders Voucher Switch' datatype='real' name='[Switch: Acquisitions Voucher Switch (copy)_3631027218797948929]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 9]&#10;WHEN &apos;Yes&apos;   THEN [orders_with_voucher]&#10;WHEN &apos;No&apos;    THEN [Acquisitions without Voucher (copy)]&#10;WHEN &apos;(All)&apos; THEN [orders]&#10;END' />
      </column>
      <column caption='Switch: Acquisitions/Sessions/New Sessions' datatype='real' name='[Switch: Acquisitions/Orders/Reorders (copy 2)_1287466582192930816]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Acquisitions&apos; THEN SUM([Calculation_5742089557526224896])&#13;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Sessions&apos; THEN SUM([sessions])&#13;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;New Visits/Installs&apos; THEN SUM([new_sessions])&#13;&#10;END' />
      </column>
      <column caption='Switch: Acquisitions/Costs' datatype='real' name='[Switch: Acquisitions/Orders/Reorders (copy 2)_1963358352671531010]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Acquisitions/Orders/Reorders (copy 2)_1963358352671772675] &#13;&#10;WHEN &apos;Acquisitions&apos; THEN SUM([Calculation_5742089557526224896])&#13;&#10;WHEN &apos;Costs&apos; THEN SUM([costs_eur])&#13;&#10;WHEN &apos;Sessions&apos; THEN SUM([sessions])&#13;&#10;WHEN &apos;New Visits/Installs&apos; THEN SUM([new_sessions])&#13;&#10;END' />
      </column>
      <column caption='Switch: KPI Switch' datatype='real' name='[Switch: Acquisitions/Orders/Reorders (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Acquisitions/Orders/Reorders (copy)]&#10;WHEN &apos;Acquisitions&apos;     THEN [Calculation_3631027218793607168]&#13;&#10;WHEN &apos;Orders&apos;           THEN SUM([Switch: Acquisitions Voucher Switch (copy)_3631027218797948929])&#13;&#10;WHEN &apos;Reorders&apos;         THEN SUM([Switch: Orders Voucher Switch (copy)_3631027218799984643])&#10;WHEN &apos;Costs&apos;            THEN SUM([Calculation_1779695940233924609])&#10;WHEN &apos;CPA&apos;              THEN SUM([Calculation_1779695940233924609]) / SUM([Calculation_5742089557526224896])&#13;&#10;END' />
      </column>
      <column caption='Switch: Reorders Voucher Switch' datatype='real' name='[Switch: Orders Voucher Switch (copy)_3631027218799984643]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 9]&#10;WHEN &apos;Yes&apos;   THEN [reorders_with_voucher]&#10;WHEN &apos;No&apos;    THEN [reorders] - [reorders_with_voucher]&#10;WHEN &apos;(All)&apos; THEN [reorders]&#10;END' />
      </column>
      <column caption='Switch: KPI Switch - delta' datatype='real' default-format='p0.00%' name='[Switch: delta Acquisitions/Orders/Reorders (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Switch: Acquisitions/Orders/Reorders (copy)] / LOOKUP([Switch: Acquisitions/Orders/Reorders (copy)], -1) ) -1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Switch: KPI Switch - delta Shape' datatype='integer' name='[Switch: delta Shape (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Acquisitions/Orders/Reorders (copy)] != &apos;Costs&apos; AND [Parameters].[Acquisitions/Orders/Reorders (copy)] != &apos;CPA&apos; AND [Switch: delta Acquisitions/Orders/Reorders (copy)] &gt; 0 THEN 1&#13;&#10;ELSEIF [Parameters].[Acquisitions/Orders/Reorders (copy)] != &apos;Costs&apos; AND [Parameters].[Acquisitions/Orders/Reorders (copy)] != &apos;CPA&apos; AND [Switch: delta Acquisitions/Orders/Reorders (copy)] &lt; 0 then -1&#10;ELSEIF [Switch: delta Acquisitions/Orders/Reorders (copy)] &gt; 0 THEN -2&#10;ELSEIF [Switch: delta Acquisitions/Orders/Reorders (copy)] &lt; 0 then 2&#13;&#10;ELSE 0&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
