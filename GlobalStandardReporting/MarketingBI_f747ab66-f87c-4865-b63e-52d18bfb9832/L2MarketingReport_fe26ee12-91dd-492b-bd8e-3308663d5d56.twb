      <column caption='Push Orders' datatype='real' name='[Calculation_1143703232707870720]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([push_orders]) *&#10;(SUM([push_direct_opens]) / SUM([push_opens]))' />
      </column>
      <column caption='Multi Orders' datatype='real' name='[Calculation_1143703232709758977]' role='measure' type='quantitative'>
