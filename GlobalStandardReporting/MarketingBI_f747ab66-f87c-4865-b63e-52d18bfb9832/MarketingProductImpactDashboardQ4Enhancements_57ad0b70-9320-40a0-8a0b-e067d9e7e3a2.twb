            <column-instance column='[Calculation_4816247957960028173]' derivation='None' name='[none:Calculation_4816247957960028173:nk]' pivot='key' type='nominal' />
            <column-instance column='[date_type]' derivation='None' name='[none:date_type:nk]' pivot='key' type='nominal' />
            <column caption='Product' datatype='string' name='[product]' role='dimension' type='nominal' />
