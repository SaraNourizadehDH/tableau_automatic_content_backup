        <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 4]&#10;    WHEN &apos;Monthly&apos; THEN DATEADD(&apos;month&apos;, 0,  DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 3]))&#10;    WHEN &apos;Quarterly&apos; THEN DATEADD(&apos;quarter&apos;, 0,  DATETRUNC(&apos;quarter&apos;,[Parameters].[Parameter 3]))&#10;END)' />
