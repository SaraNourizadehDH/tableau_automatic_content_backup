    <worksheet name='EL - Experiment Level with Significancy'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#d61f26' fontsize='8' italic='true'>**This numbers include only product related significant treatments (not included Control and Status Quo results)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='bima_tableau_eze_experiment_outputs+ (rl_mkt)' name='federated.0hbiz6j0zyer8q12wtksp1w84c48' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Experiment Level with Significancy' caption='Report View' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;ELS&quot;'>
              <calculation class='tableau' formula='&quot;ELS&quot;' />
              <aliases>
                <alias key='&quot;EL&quot;' value='Experiment Level' />
                <alias key='&quot;ELS&quot;' value='Experiment Level with Significancy' />
                <alias key='&quot;TL&quot;' value='Treatment Level' />
                <alias key='&quot;TLA&quot;' value='Treatment Level - All KPIs' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0hbiz6j0zyer8q12wtksp1w84c48'>
            <column caption='tg_users (canvas level)' datatype='integer' name='[Calculation_1110207733341941760]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [brand_name], [country_name], [test_name], [Calculation_1110207733344739329]: SUM(IF LOWER([treatment_name]) &lt;&gt; &apos;control&apos; THEN [tg_users] ELSE 0 END)}' />
            </column>
            <column caption='Canvas Name / Churn Period' datatype='string' name='[Calculation_1110207733344739329]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([canvas_name]) = TRUE THEN [churn_period] ELSE [canvas_name] END' />
            </column>
            <column caption='Product Effect for Agg' datatype='boolean' name='[Calculation_2277414097531424768]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [product] &lt;&gt; &apos;Null&apos; THEN TRUE&#10;ELSEIF [product] = &apos;Null&apos; THEN FALSE&#10;END' />
            </column>
            <column caption='Report View Filter' datatype='string' name='[Calculation_335377491508072457]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;TL&apos; THEN &apos;Treatment Level - Main KPIs&apos;&#10;WHEN &apos;TLA&apos; THEN &apos;Treatment Level - All KPIs&apos;&#10;WHEN &apos;EL&apos; THEN &apos;Experiment Level - Main KPIs&apos;&#10;WHEN &apos;ELS&apos; THEN &apos;Experiment Level - Main KPIs with Significancy&apos;&#10;END' />
            </column>
            <column caption='Incremental Orders Proportion (only sign - canvas level)' datatype='real' default-format='p0.0%' name='[Calculation_3736298896969064451]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Incremental Orders for All Sign (copy)_3736298896968757250]) / SUM([tg_users (canvas level) (copy)_1286762912500678656])' />
            </column>
            <column caption='Incremental Cost Proportion (only sign - canvas level)' datatype='real' default-format='p0.0%' name='[Incremental Activation Prorportion (copy)_3736298896981385229]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Incremental Cost for All Sign (copy)_3736298896973664268]) / SUM([tg_users (canvas level) (copy)_1286762912502280194])' />
            </column>
            <column caption='Incremental Activation for only Sign' datatype='real' name='[Incremental Activation for All Sign (copy)_3736298896971407365]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], [brand_name], [country_name], [test_name], [Calculation_1110207733344739329], [treatment_name], [product]:&#10;SUM(IF ISNULL([control_name]) = FALSE AND [activation_rate_sign_ab] = 1&#10;    THEN ([tg_users] / [tg_receivers] - [cg_users] / [cg_receivers]) * [tg_receivers]&#10;ELSE 0&#10;END)&#10;}' />
            </column>
            <column caption='Incremental Cost for only Sign' datatype='real' default-format='c#,##0&quot; €&quot;;-#,##0&quot; €&quot;' name='[Incremental Cost for All Sign (copy)_3736298896973664268]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], [brand_name], [country_name], [test_name], [Calculation_1110207733344739329], [treatment_name], [product]:&#10;SUM(IF ISNULL([control_name]) = FALSE AND [dh_voucher_cost_sign_ab] = 1&#10;    THEN ([tg_dh_voucher_cost] / [tg_receivers] - [cg_dh_voucher_cost] / [cg_receivers]) * [tg_receivers]&#10;ELSE 0&#10;END)&#10;}' />
            </column>
            <column caption='Incremental Activation Proportion (only sign - canvas level)' datatype='real' default-format='p0.0%' name='[Incremental Orders Prorportion (copy)_3736298896971886598]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Incremental Activation for All Sign (copy)_3736298896971407365]) / SUM([Calculation_1110207733341941760])' />
            </column>
            <column caption='Incremental GMV Proportion (only sign - canvas level)' datatype='real' default-format='p0.0%' name='[Incremental Orders Prorportion (copy)_3736298896973045770]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Incremental Orders for only Sign (copy)_3736298896972877833]) / SUM([tg_users (canvas level) (copy)_1286762912501014529])' />
            </column>
            <column caption='Incremental Orders for only Sign' datatype='real' default-format='n#,##0;-#,##0' name='[Incremental Orders for All Sign (copy)_3736298896968757250]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], [brand_name], [country_name], [test_name], [Calculation_1110207733344739329], [treatment_name], [product]:&#10;SUM(IF ISNULL([control_name]) = FALSE AND [orders_sign_ab] = 1&#10;    THEN ([tg_orders] / [tg_receivers] - [cg_orders] / [cg_receivers]) * [tg_receivers]&#10;ELSE 0&#10;END)&#10;}' />
            </column>
            <column caption='Incremental GMV for only Sign' datatype='real' default-format='c#,##0&quot; €&quot;;-#,##0&quot; €&quot;' name='[Incremental Orders for only Sign (copy)_3736298896972877833]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], [brand_name], [country_name], [test_name], [Calculation_1110207733344739329], [treatment_name], [product]:&#10;SUM(IF ISNULL([control_name]) = FALSE AND [gmv_sign_ab] = 1&#10;    THEN ([tg_gmv_eur] / [tg_receivers] - [cg_gmv_eur] / [cg_receivers]) * [tg_receivers]&#10;ELSE 0&#10;END)&#10;}' />
            </column>
            <column caption='Product Filter' datatype='string' name='[Report View Filter (copy)_2251729509861462026]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;TL&apos; //&apos;Treatment Level - Main KPIs&apos;&#10;    THEN &apos;-&apos;&#10;WHEN &apos;TLA&apos; //&apos;Treatment Level - All KPIs&apos;&#10;    THEN &apos;-&apos; &#10;ELSE //&apos;T&apos;-&apos;Experiment Level - Main KPIs&apos; OR &apos;TS&apos;-&apos;Experiment Level - Main KPIs with Significancy&apos;&#10;    IFNULL([product], &apos;Non-Product&apos;)&#10;END' />
            </column>
            <column datatype='integer' name='[activation_rate_sign_ab]' role='measure' type='quantitative' />
            <column caption='Brand Name' datatype='string' name='[brand_name]' role='dimension' type='nominal' />
            <column caption='Canvas Name' datatype='string' name='[canvas_name]' role='dimension' type='nominal' />
            <column datatype='real' name='[cg_dh_voucher_cost]' role='measure' type='quantitative' />
            <column datatype='real' default-format='c#,##0.00&quot; €&quot;;-#,##0.00&quot; €&quot;' name='[cg_gmv_eur]' role='measure' type='quantitative' />
            <column datatype='integer' name='[cg_orders]' role='measure' type='quantitative' />
            <column datatype='integer' name='[cg_receivers]' role='measure' type='quantitative' />
            <column datatype='integer' name='[cg_users]' role='measure' type='quantitative' />
            <column caption='Churn Period' datatype='string' name='[churn_period]' role='dimension' type='nominal' />
