        <_.fcp.ObjectModelEncapsulateLegacy.false...relation join='left' type='join'>
          <clause type='join'>
            <expression op='AND'>
              <expression op='='>
                <expression op='[bima_tableau_eze_experiment_summary1].[date_type]' />
                <expression op='[Custom SQL Query].[date_type]' />
