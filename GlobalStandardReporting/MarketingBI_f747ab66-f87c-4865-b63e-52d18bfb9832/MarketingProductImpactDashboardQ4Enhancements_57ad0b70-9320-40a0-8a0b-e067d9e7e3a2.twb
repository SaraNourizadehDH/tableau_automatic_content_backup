    <worksheet name='Experiment Level'>
      <table>
        <view>
          <datasources>
            <datasource caption='fulfillment-dwh-staging' name='federated.0zmtmnq0gng9se17erxg104lwzl5' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Experiment Level with Significancy' caption='Report View' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;ELS&quot;'>
              <calculation class='tableau' formula='&quot;ELS&quot;' />
              <aliases>
                <alias key='&quot;EL&quot;' value='Experiment Level' />
                <alias key='&quot;ELS&quot;' value='Experiment Level with Significancy' />
                <alias key='&quot;TL&quot;' value='Treatment Level' />
                <alias key='&quot;TLA&quot;' value='Treatment Level - All KPIs' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0zmtmnq0gng9se17erxg104lwzl5'>
            <column caption='Product Filter' datatype='string' name='[Calculation_3747417136848285696]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;TL&apos; //&apos;Treatment Level - Main KPIs&apos;&#10;    THEN &apos;-&apos;&#10;WHEN &apos;TLA&apos; //&apos;Treatment Level - All KPIs&apos;&#10;    THEN &apos;-&apos; &#10;ELSE //&apos;EL&apos;-&apos;Experiment Level - Main KPIs&apos; OR &apos;ELS&apos;-&apos;Experiment Level - Main KPIs with Significancy&apos;&#10;    IFNULL([product], &apos;Non-Product&apos;)&#10;END' />
            </column>
            <column caption='Product Impact (Experiment Level)' datatype='boolean' name='[Calculation_3747417136984465410]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([product]) = FALSE THEN TRUE&#10;ELSEIF ISNULL([product]) = TRUE THEN FALSE&#10;END' />
            </column>
            <column caption='Canvas Name / Churn Period' datatype='string' name='[Calculation_4174203569213632512]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([canvas_name]) = TRUE THEN [churn_period] ELSE [canvas_name] END' />
            </column>
            <column caption='Report View Filter' datatype='string' name='[Calculation_4174203569290506257]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;TL&apos; THEN &apos;Treatment Level&apos;&#10;WHEN &apos;TLA&apos; THEN &apos;Treatment Level - All KPIs&apos;&#10;WHEN &apos;EL&apos; THEN &apos;Experiment Level&apos;&#10;WHEN &apos;ELS&apos; THEN &apos;Experiment Level with Significancy&apos;&#10;END' />
            </column>
            <column caption='iActivation Report Month Proportion' datatype='real' default-format='p0.0%' name='[Significant iActivation Report Month Proportion (copy)_4174203569254633482]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([iactivation_report_date]) / SUM([bl_activation_report_date])' />
            </column>
            <column caption='iCPA Report Date' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Significant iCPA Report Date (copy)_4174203569287966734]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([icost_report_date]) / SUM([iactivation_report_date]))' />
            </column>
            <column caption='iCPG Report Date' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Significant iCPG Report Date (copy)_4174203569288085519]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([icost_report_date]) / SUM([igmv_report_date]))' />
            </column>
            <column caption='iCPO Report Date' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Significant iCPO Report Date (copy)_4174203569288646672]' role='measure' type='quantitative'>
