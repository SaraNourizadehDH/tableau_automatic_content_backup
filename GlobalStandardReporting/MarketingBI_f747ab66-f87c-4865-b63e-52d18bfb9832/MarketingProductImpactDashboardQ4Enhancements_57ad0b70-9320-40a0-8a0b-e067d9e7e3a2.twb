      <column caption='tg_users (canvas level)' datatype='integer' name='[Calculation_1110207733341941760]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [brand_name], [country_name], [test_name], [Calculation_1110207733344739329]: SUM(IF LOWER([treatment_name]) &lt;&gt; &apos;control&apos; THEN [tg_users] ELSE 0 END)}' />
      </column>
      <column caption='Canvas Name / Churn Period' datatype='string' name='[Calculation_1110207733344739329]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([canvas_name]) = TRUE THEN [churn_period] ELSE [canvas_name] END' />
      </column>
      <column caption='Control Name ' datatype='string' name='[Calculation_1110207733345071106]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([control_name]) THEN &quot; &quot; ELSE [control_name] END' />
      </column>
      <column caption='Start Date for RM Calculations' datatype='date' datatype-customized='true' name='[Calculation_1811995226589982720]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 4]&#10;    WHEN &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 3])&#10;    WHEN &apos;Quarterly&apos; THEN DATETRUNC(&apos;quarter&apos;,[Parameters].[Parameter 3])&#10;END)' />
      </column>
      <column caption='DATE VIEW TEST' datatype='string' name='[Calculation_1811995226590433281]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;    WHEN &apos;Monthly&apos; THEN &apos;Monthly&apos;&#10;    WHEN &apos;Quarterly&apos; THEN &apos;Quarterly&apos;&#10;END' />
      </column>
      <column caption='Product Effect for Agg' datatype='boolean' name='[Calculation_2277414097531424768]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [product] &lt;&gt; &apos;Null&apos; THEN TRUE&#10;ELSEIF [product] = &apos;Null&apos; THEN FALSE&#10;END' />
      </column>
      <column caption='RM - Incremental Activation for only Sign' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_2277414097534894081]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [canvas_name], [global_entity_id], [treatment_name], [product], [brand_name], [country_name]:&#10;SUM(IF ISNULL([control_name]) = FALSE AND [activation_rate_sign_ab] = 1&#10;        AND ([start_date] &gt;= [Calculation_1811995226589982720] AND [start_date] &lt; [DATE TEST (copy)_1811995226591174658])&#10;    THEN ([tg_users] / [tg_receivers] - [cg_users] / [cg_receivers]) * [tg_receivers]&#10;ELSE 0&#10;END)&#10;}' />
      </column>
      <column caption='MoM - Incremental Cost for only Sign' datatype='real' default-format='*▲ 0.0 pp; ▼ -0.0 pp; 0.0 pp' name='[Calculation_2277414097548865551]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(CASE &#10;SUM([Incremental Cost for only Sign (copy)_2277414097539756043]) &gt;= SUM([RM - Incremental Cost for only Sign (copy)_2277414097548062734])&#10;WHEN TRUE &#10;    THEN ABS(ABS(SUM([Incremental Cost for only Sign (copy)_2277414097539756043]) - SUM([RM - Incremental Cost for only Sign (copy)_2277414097548062734])) / ABS(SUM([RM - Incremental Cost for only Sign (copy)_2277414097548062734])))&#10;WHEN FALSE &#10;    THEN ABS(ABS(SUM([Incremental Cost for only Sign (copy)_2277414097539756043]) - SUM([RM - Incremental Cost for only Sign (copy)_2277414097548062734])) / ABS(SUM([RM - Incremental Cost for only Sign (copy)_2277414097548062734]))) * -1&#10;END)' />
      </column>
      <column caption='MoM - Incremental Activation for only Sign' datatype='real' default-format='*▲ 0.0 pp; ▼ -0.0 pp; 0.0 pp' name='[Calculation_2277414097555005457]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(CASE SUM([Calculation_2277414097534894081]) &gt;= SUM([RM - Incremental Activation for only Sign (copy)_2277414097541083149])&#10;WHEN TRUE &#10;    THEN ABS(ABS(SUM([Calculation_2277414097534894081]) - SUM([RM - Incremental Activation for only Sign (copy)_2277414097541083149])) / ABS(SUM([RM - Incremental Activation for only Sign (copy)_2277414097541083149])))&#10;WHEN FALSE &#10;    THEN ABS(ABS(SUM([Calculation_2277414097534894081]) - SUM([RM - Incremental Activation for only Sign (copy)_2277414097541083149])) / ABS(SUM([RM - Incremental Activation for only Sign (copy)_2277414097541083149]))) * -1&#10;END)' />
      </column>
      <column caption='Report Date Filter' datatype='boolean' datatype-customized='true' default-format='*MMM YYYY' name='[Calculation_2968435165544280080]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;    WHEN &apos;Monthly&apos; THEN [Parameters].[Parameter 3] = DATETRUNC(&apos;month&apos;, [start_date])&#10;    WHEN &apos;Quarterly&apos; THEN DATETRUNC(&apos;quarter&apos;, [Parameters].[Parameter 3]) = DATETRUNC(&apos;quarter&apos;, [start_date])&#10;END' />
      </column>
      <column caption='SOB in Report Date' datatype='real' name='[Calculation_331085009883627524]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [date_type_agg] = [Parameters].[Parameter 4]&#10;AND [reporting_month_agg] = [Parameters].[Parameter 3]&#10;THEN { FIXED [key_exp], [date_type_agg], [reporting_month_agg] : MIN([report_month_sob])}&#10;ELSE 0 &#10;END' />
      </column>
      <column caption='TEST' datatype='boolean' name='[Calculation_331085009888665606]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[date_type_agg] = [Parameters].[Parameter 4]' />
      </column>
      <column caption='iCPA (all sign -  treatment level)' datatype='real' default-format='c#,##0.0&quot; €&quot;;-#,##0.0&quot; €&quot;' name='[Calculation_335377491505254402]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Incremental GMV for All Sign (copy)_3736298896973471755]) / SUM([Incremental Orders for All Sign (copy)_3736298896971104260])' />
      </column>
      <column caption='iCPO (all sign - treatment level)' datatype='real' default-format='c#,##0.0&quot; €&quot;;-#,##0.0&quot; €&quot;' name='[Calculation_335377491506200579]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Incremental GMV for All Sign (copy)_3736298896973471755]) / SUM([Calculation_3736298896965513217])' />
      </column>
      <column caption='Report View Filter' datatype='string' name='[Calculation_335377491508072457]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;TL&apos; THEN &apos;Treatment Level - Main KPIs&apos;&#10;WHEN &apos;TLA&apos; THEN &apos;Treatment Level - All KPIs&apos;&#10;WHEN &apos;EL&apos; THEN &apos;Experiment Level - Main KPIs&apos;&#10;WHEN &apos;ELS&apos; THEN &apos;Experiment Level - Main KPIs with Significancy&apos;&#10;END' />
      </column>
      <column caption='Activation Rate %' datatype='real' default-format='p0.00%' name='[Calculation_335377491553730577]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([tg_users]) / SUM([tg_receivers])' />
      </column>
      <column caption='Order per Receiver' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_335377491555082258]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([tg_orders]) / SUM([tg_receivers])' />
      </column>
      <column caption='Incentivised Rate %' datatype='real' default-format='p0.00%' name='[Calculation_335377491557777429]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([tg_is_dh_voucher]) / SUM([tg_receivers])' />
      </column>
      <column caption='Incremental Orders for All Sign' datatype='real' name='[Calculation_3736298896965513217]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [global_entity_id], [brand_name], [country_name], [test_name], [Calculation_1110207733344739329], [treatment_name], [product]:&#10;SUM(IF ISNULL([control_name]) = FALSE&#10;    THEN ([tg_orders] / [tg_receivers] - [cg_orders] / [cg_receivers]) * [tg_receivers]&#10;ELSE 0&#10;END)&#10;}' />
      </column>
      <column caption='Incremental Orders Proportion (only sign - canvas level)' datatype='real' default-format='p0.0%' name='[Calculation_3736298896969064451]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Incremental Orders for All Sign (copy)_3736298896968757250]) / SUM([tg_users (canvas level) (copy)_1286762912500678656])' />
      </column>
      <column caption='User Entitilment' datatype='boolean' name='[Calculation_43910108797423618]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Total Experiment Count' datatype='integer' name='[Calculation_4573898063963459587]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_1110207733344739329])' />
      </column>
      <column caption='Experiment Count with Activation Sign' datatype='integer' name='[Calculation_4573898063963717636]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//if [activation_rate_sign_ab] = 1 AND [Product Effect for Agg] then 1 else 0 end&#10;&#10;COUNTD(IF [activation_rate_sign_ab] = 1 AND [Calculation_2277414097531424768] THEN [Calculation_1110207733344739329] END)' />
      </column>
      <column caption='row filter' datatype='boolean' name='[Calculation_4573898063978319884]' role='measure' type='nominal'>
        <calculation class='tableau' formula='(SUM(ZN([Incremental Activation for All Sign (copy)_3736298896971407365]))&#10;+&#10;SUM(ZN([Incremental Orders for All Sign (copy)_3736298896968757250]))&#10;+&#10;SUM(ZN([Incremental Orders for only Sign (copy)_3736298896972877833]))&#10;+&#10;SUM(ZN([Incremental Cost for All Sign (copy)_3736298896973664268]))&#10;&lt;&gt;&#10;0)&#10;OR [Total Experiment Count (copy)_331085009819250690] &gt; 0' />
      </column>
      <column caption='KPI Selection for Page 0' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_4573898063980572685]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;    WHEN &quot;iActivation&quot; THEN SUM([Incremental Activation for All Sign (copy)_3736298896971407365])&#10;    WHEN &quot;iActivation Proportion (%)&quot; THEN [Incremental Orders Prorportion (copy)_3736298896971886598]*100&#10;    WHEN &quot;iOrders&quot; THEN SUM([Incremental Orders for All Sign (copy)_3736298896968757250])&#10;    WHEN &quot;iOrders Proportion (%)&quot; THEN [Calculation_3736298896969064451] * 100&#10;    WHEN &quot;iGMV (€)&quot; THEN SUM([Incremental Orders for only Sign (copy)_3736298896972877833])&#10;    WHEN &quot;iGMV Proportion (%)&quot; THEN [Incremental Orders Prorportion (copy)_3736298896973045770] * 100&#10;    WHEN &quot;iCost (€)&quot; THEN SUM([Incremental Cost for All Sign (copy)_3736298896973664268])&#10;    WHEN &quot;iCost Proportion (%)&quot; THEN [Incremental Activation Prorportion (copy)_3736298896981385229] * 100&#10;END' />
      </column>
      <column caption='KPI Selection for Page 0 - KPI Name' datatype='string' name='[Calculation_4573898063982284814]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 5]' />
      </column>
      <column caption='MoM / QoQ' datatype='string' name='[Calculation_4941222908603375616]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;    WHEN &quot;Monthly&quot; THEN &quot;MoM&quot;&#10;    WHEN &quot;Quarterly&quot; THEN &quot;QoQ&quot;&#10;END' />
      </column>
      <column caption='Report Date' datatype='string' name='[Calculation_759419544326291461]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;Monthly&apos; THEN (DATENAME(&apos;month&apos;, [Parameters].[Parameter 3]) + &quot; &quot; + DATENAME(&apos;year&apos;, [Parameters].[Parameter 3]))&#10;WHEN &apos;Quarterly&apos; THEN &quot;Q&quot; +(DATENAME(&apos;quarter&apos;, [Parameters].[Parameter 3]) + &quot; &quot; + DATENAME(&apos;year&apos;, [Parameters].[Parameter 3]))&#10;END' />
      </column>
      <column caption='End Date for RM Calculations' datatype='date' datatype-customized='true' name='[DATE TEST (copy)_1811995226591174658]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 4]&#10;    WHEN &apos;Monthly&apos; THEN DATEADD(&apos;month&apos;, 1,  DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 3]))&#10;    WHEN &apos;Quarterly&apos; THEN DATEADD(&apos;quarter&apos;, 1,  DATETRUNC(&apos;quarter&apos;,[Parameters].[Parameter 3]))&#10;END)' />
      </column>
