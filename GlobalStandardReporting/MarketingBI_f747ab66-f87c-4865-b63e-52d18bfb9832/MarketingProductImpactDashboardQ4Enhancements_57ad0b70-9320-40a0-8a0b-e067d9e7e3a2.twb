      </column>
      <column caption='Warning for Experiment List' datatype='string' name='[Report View Filter (copy)_2251729509865005067]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;T&apos; // &apos;Experiment Level - Main KPIs&apos;&#10;    THEN &quot;This view includes only product-related (not including Control and Status Quo results) treatments (both significant and insignificant). Bias not be considered.&quot;&#10;WHEN &apos;TS&apos; // &apos;Experiment Level - Main KPIs with Significancy&apos;&#10;    THEN &quot;This view includes only product-related (not including Control and Status Quo results) significant treatments. Bias not be considered.&quot;&#10;ELSE &quot; &quot;&#10;END' />
      </column>
