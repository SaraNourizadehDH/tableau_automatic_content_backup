  <worksheets>
    <worksheet name='EL - Experiment Level'>
      <table>
        <view>
          <datasources>
            <datasource caption='bima_tableau_eze_experiment_outputs+ (rl_mkt)' name='federated.0hbiz6j0zyer8q12wtksp1w84c48' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Experiment Level with Significancy' caption='Report View' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;ELS&quot;'>
              <calculation class='tableau' formula='&quot;ELS&quot;' />
              <aliases>
                <alias key='&quot;EL&quot;' value='Experiment Level' />
                <alias key='&quot;ELS&quot;' value='Experiment Level with Significancy' />
                <alias key='&quot;TL&quot;' value='Treatment Level' />
                <alias key='&quot;TLA&quot;' value='Treatment Level - All KPIs' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0hbiz6j0zyer8q12wtksp1w84c48'>
            <column caption='tg_users (canvas level)' datatype='integer' name='[Calculation_1110207733341941760]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [brand_name], [country_name], [test_name], [Calculation_1110207733344739329]: SUM(IF LOWER([treatment_name]) &lt;&gt; &apos;control&apos; THEN [tg_users] ELSE 0 END)}' />
            </column>
            <column caption='Canvas Name / Churn Period' datatype='string' name='[Calculation_1110207733344739329]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([canvas_name]) = TRUE THEN [churn_period] ELSE [canvas_name] END' />
            </column>
            <column caption='Product Effect for Agg' datatype='boolean' name='[Calculation_2277414097531424768]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [product] &lt;&gt; &apos;Null&apos; THEN TRUE&#10;ELSEIF [product] = &apos;Null&apos; THEN FALSE&#10;END' />
            </column>
            <column caption='iCPA (all sign -  treatment level)' datatype='real' default-format='c#,##0.0&quot; €&quot;;-#,##0.0&quot; €&quot;' name='[Calculation_335377491505254402]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Incremental GMV for All Sign (copy)_3736298896973471755]) / SUM([Incremental Orders for All Sign (copy)_3736298896971104260])' />
            </column>
            <column caption='iCPO (all sign - treatment level)' datatype='real' default-format='c#,##0.0&quot; €&quot;;-#,##0.0&quot; €&quot;' name='[Calculation_335377491506200579]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Incremental GMV for All Sign (copy)_3736298896973471755]) / SUM([Calculation_3736298896965513217])' />
            </column>
            <column caption='Report View Filter' datatype='string' name='[Calculation_335377491508072457]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;TL&apos; THEN &apos;Treatment Level - Main KPIs&apos;&#10;WHEN &apos;TLA&apos; THEN &apos;Treatment Level - All KPIs&apos;&#10;WHEN &apos;EL&apos; THEN &apos;Experiment Level - Main KPIs&apos;&#10;WHEN &apos;ELS&apos; THEN &apos;Experiment Level - Main KPIs with Significancy&apos;&#10;END' />
            </column>
            <column caption='Incremental Orders for All Sign' datatype='real' name='[Calculation_3736298896965513217]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], [brand_name], [country_name], [test_name], [Calculation_1110207733344739329], [treatment_name], [product]:&#10;SUM(IF ISNULL([control_name]) = FALSE&#10;    THEN ([tg_orders] / [tg_receivers] - [cg_orders] / [cg_receivers]) * [tg_receivers]&#10;ELSE 0&#10;END)&#10;}' />
            </column>
            <column caption='Incremental Order Proportion (all sign - canvas level)' datatype='real' default-format='p0.0%' name='[Incremental Activation Proportion (canvas level) (copy)_335377491530313739]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_3736298896965513217]) / SUM([tg_users (canvas level) (copy)_1286762912500678656])' />
            </column>
            <column caption='Incremental GMV Proportion (all sign - canvas level)' datatype='real' default-format='p0.0%' name='[Incremental Activation Proportion (canvas level) (copy)_335377491533225996]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Incremental Orders for All Sign (copy)_3736298896972742664]) / SUM([tg_users (canvas level) (copy)_1286762912501014529])' />
            </column>
            <column caption='Incremental Activation Proportion (all sign - canvas level)' datatype='real' default-format='p0.0%' name='[Incremental Activation Proportion (sign - canvas level) (copy)_335377491528773642]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Incremental Orders for All Sign (copy)_3736298896971104260]) / SUM([Calculation_1110207733341941760])' />
            </column>
            <column caption='Incremental Cost Proportion (all sign - canvas level)' datatype='real' default-format='p0.0%' name='[Incremental GMV Proportion (canvas level) (copy)_335377491534131213]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Incremental GMV for All Sign (copy)_3736298896973471755]) / SUM([tg_users (canvas level) (copy)_1286762912502280194])' />
            </column>
            <column caption='Incremental Cost for All Sign' datatype='real' default-format='c#,##0&quot; €&quot;;-#,##0&quot; €&quot;' name='[Incremental GMV for All Sign (copy)_3736298896973471755]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], [brand_name], [country_name], [test_name], [Calculation_1110207733344739329], [treatment_name], [product]:&#10;SUM(IF ISNULL([control_name]) = FALSE&#10;    THEN ([tg_dh_voucher_cost] / [tg_receivers] - [cg_dh_voucher_cost] / [cg_receivers]) * [tg_receivers]&#10;ELSE 0&#10;END)&#10;}' />
            </column>
            <column caption='Incremental Activation for All Sign' datatype='real' name='[Incremental Orders for All Sign (copy)_3736298896971104260]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], [brand_name], [country_name], [test_name], [Calculation_1110207733344739329], [treatment_name], [product]:&#10;SUM(IF ISNULL([control_name]) = FALSE&#10;    THEN ([tg_users] / [tg_receivers] - [cg_users] / [cg_receivers]) * [tg_receivers]&#10;ELSE 0&#10;END)&#10;}' />
            </column>
