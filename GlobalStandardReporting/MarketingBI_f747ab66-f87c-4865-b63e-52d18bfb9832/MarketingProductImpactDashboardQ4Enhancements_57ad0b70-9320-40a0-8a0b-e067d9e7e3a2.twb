            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='integer' name='[dh_voucher_cost_sign_ab]' role='measure' type='quantitative' />
            <column datatype='date' name='[end_date]' role='dimension' type='ordinal' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column datatype='integer' name='[gmv_sign_ab]' role='measure' type='quantitative' />
            <column caption='iCPA (only sign -  treatment level)' datatype='real' default-format='c#,##0.0&quot; €&quot;;-#,##0.0&quot; €&quot;' name='[iCPA (all sign -  treatment level) (copy)_759419544308420608]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Incremental Cost for All Sign (copy)_3736298896973664268]) / SUM([Incremental Activation for All Sign (copy)_3736298896971407365])' />
            </column>
            <column caption='iCPG (only sign - treatment level)' datatype='real' default-format='c#,##0.0&quot; €&quot;;-#,##0.0&quot; €&quot;' name='[iCPG (all sign - treatment level) (copy)_759419544310644737]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Incremental Cost for All Sign (copy)_3736298896973664268]) / SUM([Incremental Orders for only Sign (copy)_3736298896972877833])' />
            </column>
            <column caption='iCPO (only sign - treatment level)' datatype='real' default-format='c#,##0.0&quot; €&quot;;-#,##0.0&quot; €&quot;' name='[iCPO (all sign - treatment level) (copy)_759419544313724930]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Incremental Cost for All Sign (copy)_3736298896973664268]) / SUM([Incremental Orders for All Sign (copy)_3736298896968757250])' />
            </column>
