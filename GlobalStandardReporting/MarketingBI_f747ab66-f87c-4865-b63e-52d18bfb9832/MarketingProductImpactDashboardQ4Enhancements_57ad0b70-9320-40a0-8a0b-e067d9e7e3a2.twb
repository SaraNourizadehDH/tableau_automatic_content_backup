          </datasources>
          <datasource-dependencies datasource='federated.04ocir9070umr417yxvpx0fvbdgp'>
            <column caption='Product Effect for Agg' datatype='boolean' name='[Calculation_4816247957955637254]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [product] &lt;&gt; &apos;Null&apos; THEN TRUE&#10;ELSEIF [product] = &apos;Null&apos; THEN FALSE&#10;END' />
            </column>
            <column caption='MoM - Incremental Activation' datatype='real' default-format='*▲ 0.0 pp; ▼ -0.0 pp; 0.0 pp' name='[Calculation_4816247957957378056]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(CASE SUM([iactivation_os]) &gt;= SUM([iactivation_os_pd])&#10;WHEN TRUE &#10;    THEN ABS(ABS(SUM([iactivation_os]) - SUM([iactivation_os_pd])) / ABS(SUM([iactivation_os_pd])))&#10;WHEN FALSE &#10;    THEN ABS(ABS(SUM([iactivation_os]) - SUM([iactivation_os_pd])) / ABS(SUM([iactivation_os_pd]))) * -1&#10;END)' />
            </column>
            <column caption='Incremental Activation Proportion' datatype='real' default-format='p0.0%' name='[Calculation_4816247958204260378]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([iactivation_os]) / sum([total_exp_tg_users])' />
            </column>
            <column caption='MoM - Incremental Activation Proportion' datatype='real' default-format='*▲ 0.0 pp; ▼ -0.0 pp; 0.0 pp' name='[Calculation_4816247958206341147]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_4816247958204260378] &#10;- [Incremental Activation Proportion (copy)_4816247958208507932])&#10;* 100' />
            </column>
            <column caption='Incremental Cost Proportion' datatype='real' default-format='p0.0%' name='[Incremental Activation Proportion (copy)_193021465771712512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([icost_os]) / sum([total_exp_tg_dh_voucher_cost])' />
            </column>
            <column caption='PM - Incremental Activation Proportion' datatype='real' default-format='p0.0%' name='[Incremental Activation Proportion (copy)_4816247958208507932]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([iactivation_os_pd]) / sum([total_exp_tg_users_pd])' />
            </column>
            <column caption='Incremental Orders Proportion' datatype='real' default-format='p0.0%' name='[Incremental Cost Proportion (copy)_193021465873145860]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([iorders_os]) / sum([total_exp_tg_orders])' />
