      <column caption='iActivation Report Date - Significant Selection' datatype='real' default-format='n#,##0,.0K;-#,##0,.0K' name='[Calculation_2258907092688117762]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#10;    WHEN &apos;Significant Experiments&apos; THEN [sign_iactivation_report_date]&#10;    WHEN &apos;All Experiments&apos; THEN [iactivation_report_date]&#10;END' />
      </column>
      <column caption='Product Filter' datatype='string' name='[Calculation_3747417136848285696]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;TL&apos; //&apos;Treatment Level - Main KPIs&apos;&#10;    THEN &apos;-&apos;&#10;WHEN &apos;TLA&apos; //&apos;Treatment Level - All KPIs&apos;&#10;    THEN &apos;-&apos; &#10;ELSE //&apos;EL&apos;-&apos;Experiment Level - Main KPIs&apos; OR &apos;ELS&apos;-&apos;Experiment Level - Main KPIs with Significancy&apos;&#10;    IFNULL([product], &apos;Non-Product&apos;)&#10;END' />
      </column>
      <column caption='Product Impact (Experiment Level)' datatype='boolean' name='[Calculation_3747417136984465410]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([product]) = FALSE THEN TRUE&#10;ELSEIF ISNULL([product]) = TRUE THEN FALSE&#10;END' />
      </column>
      <column caption='Incentivised Rate %' datatype='real' default-format='p0.0%' name='[Calculation_3747417137002917891]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_of_dh_voucher]) / SUM([receivers_report_date])' />
      </column>
      <column caption='Activation Rate %' datatype='real' default-format='p0.0%' name='[Calculation_3747417137003343876]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([activation_report_date]) / SUM([receivers_report_date])' />
      </column>
      <column caption='DH Cost per Receiver' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_3747417137003888645]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dh_voucher_cost_report_date]) / SUM([receivers_report_date])' />
      </column>
      <column caption='Significant iCost Report Date 2' datatype='real' name='[Calculation_3747417137024446473]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [dh_voucher_cost_sign_ab] = 1 THEN [sign_icost_report_date] ELSE 0 END' />
      </column>
      <column caption='KPI Selection' datatype='real' name='[Calculation_3747417137061396490]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;WHEN &apos;iCost&apos; THEN [sign_icost_report_date]&#10;WHEN &apos;iOrders&apos; THEN [sign_iorders_report_date]&#10;WHEN &apos;iGMV&apos; THEN [sign_igmv_report_date]&#10;WHEN &apos;iActivation&apos; THEN [sign_iactivation_report_date]&#10;END' />
      </column>
      <column caption='Total KPI Selection (for monthly trend)' datatype='real' name='[Calculation_3747417137062891531]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [report_date], [date_type] : SUM([Calculation_3747417137061396490]) }' />
      </column>
      <column caption='Canvas Name / Churn Period' datatype='string' name='[Calculation_4174203569213632512]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([canvas_name]) = TRUE THEN [churn_period] ELSE [canvas_name] END' />
      </column>
      <column caption='Significant iActivation Report Month Proportion' datatype='real' default-format='p0.0%' name='[Calculation_4174203569216835585]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sign_iactivation_report_date]) / SUM([bl_activation_report_date])' />
      </column>
      <column caption='Significant iCPA Report Date' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_4174203569246879751]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([sign_icost_report_date]) / SUM([sign_iactivation_report_date]))' />
      </column>
      <column caption='Report View Filter' datatype='string' name='[Calculation_4174203569290506257]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;TL&apos; THEN &apos;Treatment Level&apos;&#10;WHEN &apos;TLA&apos; THEN &apos;Treatment Level - All KPIs&apos;&#10;WHEN &apos;EL&apos; THEN &apos;Experiment Level&apos;&#10;WHEN &apos;ELS&apos; THEN &apos;Experiment Level with Significancy&apos;&#10;END' />
      </column>
      <column caption='GMV per Receiver' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[DH Cost per Receiver (copy)_3747417137004740614]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gmv_eur_report_date]) / SUM([receivers_report_date])' />
      </column>
      <column caption='Orders  per Receiver' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[GMV per Receiver (copy)_3747417137004986375]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_report_date]) / SUM([receivers_report_date])' />
      </column>
      <column caption='Significant iOrders Report Month Proportion' datatype='real' default-format='p0.0%' name='[Significant iActivation Report Month Proportion (copy)_4174203569223876610]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sign_iorders_report_date]) / SUM([bl_orders_report_date])' />
      </column>
      <column caption='Significant iGMV Report Month Proportion' datatype='real' default-format='p0.0%' name='[Significant iActivation Report Month Proportion (copy)_4174203569224744963]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sign_igmv_report_date]) / SUM([bl_gmv_eur_report_date])' />
      </column>
      <column caption='iActivation Report Month Proportion' datatype='real' default-format='p0.0%' name='[Significant iActivation Report Month Proportion (copy)_4174203569254633482]' role='measure' type='quantitative'>
