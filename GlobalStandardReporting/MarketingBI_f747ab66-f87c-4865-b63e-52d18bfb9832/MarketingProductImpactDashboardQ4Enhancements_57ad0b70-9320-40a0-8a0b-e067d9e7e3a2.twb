      <column caption='MoM - Incremental Cost' datatype='real' default-format='*▲ 0.0 pp; ▼ -0.0 pp; 0.0 pp' name='[MoM - Incremental Orders (copy)_4816247958190891030]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(CASE SUM([icost_os]) &gt;= SUM([icost_os_pd])&#10;WHEN TRUE &#10;    THEN ABS(ABS(SUM([icost_os]) - SUM([icost_os_pd])) / ABS(SUM([icost_os_pd])))&#10;WHEN FALSE &#10;    THEN ABS(ABS(SUM([icost_os]) - SUM([icost_os_pd])) / ABS(SUM([icost_os_pd]))) * -1&#10;END)' />
      </column>
      <column caption='MoM - Incremental GMV Proportion' datatype='real' default-format='*▲ 0.0 pp; ▼ -0.0 pp; 0.0 pp' name='[MoM - Incremental Orders Proportion (copy)_193021465876553736]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Incremental Orders Proportion (copy)_193021465876307974] &#10;- [PM - Incremental Orders Proportion (copy)_193021465876430855])&#10;* 100' />
      </column>
      <column caption='MoM - Incremental Orders - arrow up' datatype='real' default-format='*▲ 0.0 pp; ▼ -0.0 pp; 0.0 pp' name='[MoM - Incremental Orders for only Sign - arrow down (copy)_4816247958182932496]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IF [MoM - Incremental Activation (copy)_4816247958181335054] &gt; 0 THEN [MoM - Incremental Activation (copy)_4816247958181335054] ELSE NULL END' />
      </column>
      <column caption='M / Q' datatype='string' name='[MoM/QoQ (copy)_193021465880649737]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [date_type]&#10;    WHEN &quot;Monthly&quot; THEN &quot;Monthly&quot;&#10;    WHEN &quot;Quarterly&quot; THEN &quot;Quarterly&quot;&#10;    WHEN &quot;Quarterly Planning&quot; THEN &quot;Quarterly&quot;&#10;END' />
      </column>
      <column caption='PM - Incremental Cost Proportion' datatype='real' default-format='p0.0%' name='[PM - Incremental Activation Proportion (copy)_193021465871192066]' role='measure' type='quantitative'>
