          </datasources>
          <datasource-dependencies datasource='federated.04ocir9070umr417yxvpx0fvbdgp'>
            <column caption='Product Effect for Agg' datatype='boolean' name='[Calculation_4816247957955637254]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [product] &lt;&gt; &apos;Null&apos; THEN TRUE&#10;ELSEIF [product] = &apos;Null&apos; THEN FALSE&#10;END' />
            </column>
            <column caption='MoM/QoQ' datatype='string' name='[Calculation_4816247957960028173]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [date_type]&#10;    WHEN &quot;Monthly&quot; THEN &quot;MoM&quot;&#10;    WHEN &quot;Quarterly&quot; THEN &quot;QoQ&quot;&#10;    WHEN &quot;Quarterly Planning&quot; THEN &quot;QoQ&quot;&#10;END' />
            </column>
            <column caption='MoM - Incremental Orders' datatype='real' default-format='*▲ 0.0 pp; ▼ -0.0 pp; 0.0 pp' name='[MoM - Incremental Activation (copy)_4816247958181335054]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(CASE SUM([iorders_os]) &gt;= SUM([iorders_os_pd])&#10;WHEN TRUE &#10;    THEN ABS(ABS(SUM([iorders_os]) - SUM([iorders_os_pd])) / ABS(SUM([iorders_os_pd])))&#10;WHEN FALSE &#10;    THEN ABS(ABS(SUM([iorders_os]) - SUM([iorders_os_pd])) / ABS(SUM([iorders_os_pd]))) * -1&#10;END)' />
            </column>
            <column caption='MoM - Incremental Orders - arrow down' datatype='real' default-format='*▲ 0.0 pp; ▼ -0.0 pp; 0.0 pp' name='[MoM - Incremental Activation for only Sign - arrow down (copy)_4816247958181986319]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF [MoM - Incremental Activation (copy)_4816247958181335054] &lt; 0 THEN [MoM - Incremental Activation (copy)_4816247958181335054] ELSE NULL END' />
            </column>
            <column caption='MoM - Incremental Orders - for zero' datatype='integer' default-format='*▲ 0.0 pp; ▼ -0.0 pp; 0.0 pp' name='[MoM - Incremental Activation for only Sign - for zero (copy)_4816247958183014417]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF [MoM - Incremental Activation (copy)_4816247958181335054] = 0 THEN 0 ELSE NULL END' />
            </column>
            <column caption='MoM - Incremental Orders - arrow up' datatype='real' default-format='*▲ 0.0 pp; ▼ -0.0 pp; 0.0 pp' name='[MoM - Incremental Orders for only Sign - arrow down (copy)_4816247958182932496]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF [MoM - Incremental Activation (copy)_4816247958181335054] &gt; 0 THEN [MoM - Incremental Activation (copy)_4816247958181335054] ELSE NULL END' />
            </column>
            <column caption='Date Type' datatype='string' name='[date_type]' role='dimension' type='nominal'>
