    <worksheet name='Page0-KPICard - iActivation'>
      <table>
        <view>
          <datasources>
            <datasource caption='bima_tableau_eze_experiment_summary' name='federated.04ocir9070umr417yxvpx0fvbdgp' />
          </datasources>
          <datasource-dependencies datasource='federated.04ocir9070umr417yxvpx0fvbdgp'>
            <column caption='Product Effect for Agg' datatype='boolean' name='[Calculation_4816247957955637254]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [product] &lt;&gt; &apos;Null&apos; THEN TRUE&#10;ELSEIF [product] = &apos;Null&apos; THEN FALSE&#10;END' />
            </column>
            <column caption='MoM - Incremental Activation' datatype='real' default-format='*▲ 0.0 pp; ▼ -0.0 pp; 0.0 pp' name='[Calculation_4816247957957378056]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(CASE SUM([iactivation_os]) &gt;= SUM([iactivation_os_pd])&#10;WHEN TRUE &#10;    THEN ABS(ABS(SUM([iactivation_os]) - SUM([iactivation_os_pd])) / ABS(SUM([iactivation_os_pd])))&#10;WHEN FALSE &#10;    THEN ABS(ABS(SUM([iactivation_os]) - SUM([iactivation_os_pd])) / ABS(SUM([iactivation_os_pd]))) * -1&#10;END)' />
            </column>
            <column caption='MoM - Incremental Activation - arrow down' datatype='real' default-format='*▲ 0.0 pp; ▼ -0.0 pp; 0.0 pp' name='[Calculation_4816247957959528458]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF [Calculation_4816247957957378056] &lt; 0 THEN [Calculation_4816247957957378056] ELSE NULL END' />
            </column>
            <column caption='MoM/QoQ' datatype='string' name='[Calculation_4816247957960028173]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [date_type]&#10;    WHEN &quot;Monthly&quot; THEN &quot;MoM&quot;&#10;    WHEN &quot;Quarterly&quot; THEN &quot;QoQ&quot;&#10;    WHEN &quot;Quarterly Planning&quot; THEN &quot;QoQ&quot;&#10;END' />
            </column>
            <column caption='MoM - Incremental Activation - arrow up' datatype='real' default-format='*▲ 0.0 pp; ▼ -0.0 pp; 0.0 pp' name='[MoM - Incremental Activation for only Sign - arrow down (copy)_4816247957959692299]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF [Calculation_4816247957957378056] &gt; 0 THEN [Calculation_4816247957957378056] ELSE NULL END' />
            </column>
            <column caption='MoM - Incremental Activation - for zero' datatype='integer' default-format='*▲ 0.0 pp; ▼ -0.0 pp; 0.0 pp' name='[MoM - Incremental Activation for only Sign - arrow up (copy)_4816247957959839756]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF [Calculation_4816247957957378056] = 0 THEN 0 ELSE NULL END' />
            </column>
            <column caption='Date Type' datatype='string' name='[date_type]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;monthly&quot;' value='Monthly' />
                <alias key='&quot;quarterly&quot;' value='Quarterly' />
