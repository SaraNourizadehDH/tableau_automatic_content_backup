                  <relation connection='bigquery.05oj6cd0qa3bkz14i8wet0n5h5zy' name='bima_tableau_eze_experiment_summary1' table='[fulfillment-dwh-staging.rl_mkt].[bima_tableau_eze_experiment_summary]' type='table' />
                  <relation connection='bigquery.00sec3m0qfijc20ztef7n0og7k2l' name='tableau_gsr_entitlements_marketing_global_entity_id' table='[fulfillment-dwh-production.rl_mkt].[tableau_gsr_entitlements_marketing_global_entity_id]' type='table' />
                </relation>
                <relation connection='bigquery.05oj6cd0qa3bkz14i8wet0n5h5zy' name='Custom SQL Query' type='text'>SELECT
&apos;Monthly&apos; AS date_type,
reporting_month,
product, 
global_entity_id,
count(distinct key_exp) AS number_of_experiments
FROM `fulfillment-dwh-staging.staging_mkt.bima_eze_experiment_monthly_agg` AS ea
LEFT JOIN fulfillment-dwh-production.curated_data_shared_coredata.dates AS dt
  ON iso_date BETWEEN DATE_ADD(current_date(), INTERVAL -2 YEAR) AND DATE_ADD(CURRENT_DATE(), INTERVAL 4 YEAR)
    AND ea.reporting_month = dt.first_day_of_month
WHERE TRUE
  AND LOWER(treatment_name) NOT IN (&apos;control&apos;, &apos;status_quo&apos;)
  AND product IS NOT NULL 
GROUP BY 1, 2, 3, 4

UNION ALL

SELECT
&apos;Quarterly&apos; AS date_type,
DATE_TRUNC(iso_date, QUARTER) AS reporting_month,
product, 
global_entity_id,
count(distinct key_exp) AS number_of_experiments
FROM `fulfillment-dwh-staging.staging_mkt.bima_eze_experiment_monthly_agg` AS ea
LEFT JOIN fulfillment-dwh-production.curated_data_shared_coredata.dates AS dt
  ON iso_date BETWEEN DATE_ADD(current_date(), INTERVAL -2 YEAR) AND DATE_ADD(CURRENT_DATE(), INTERVAL 4 YEAR)
    AND ea.reporting_month = dt.first_day_of_month
WHERE TRUE
  AND LOWER(treatment_name) NOT IN (&apos;control&apos;, &apos;status_quo&apos;)
  AND product IS NOT NULL 
GROUP BY 1, 2, 3, 4

UNION ALL

SELECT
&apos;Quarterly Planning&apos; AS date_type,
CASE
  WHEN month IN (3, 6, 9, 12) THEN DATE_ADD(first_day_of_month, INTERVAL 1 MONTH)
  ELSE DATE_TRUNC(iso_date, QUARTER)
END AS reporting_month,
product, 
global_entity_id,
count(distinct key_exp) AS number_of_experiments
FROM `fulfillment-dwh-staging.staging_mkt.bima_eze_experiment_monthly_agg` AS ea
LEFT JOIN fulfillment-dwh-production.curated_data_shared_coredata.dates AS dt
  ON iso_date BETWEEN DATE_ADD(current_date(), INTERVAL -2 YEAR) AND DATE_ADD(CURRENT_DATE(), INTERVAL 4 YEAR)
    AND ea.reporting_month = dt.first_day_of_month
WHERE TRUE
  AND LOWER(treatment_name) NOT IN (&apos;control&apos;, &apos;status_quo&apos;)
  AND product IS NOT NULL 
GROUP BY 1, 2, 3, 4
ORDER BY 1, 2, 3, 4</relation>
              </relation>
            </properties>
          </object>
        </objects>
