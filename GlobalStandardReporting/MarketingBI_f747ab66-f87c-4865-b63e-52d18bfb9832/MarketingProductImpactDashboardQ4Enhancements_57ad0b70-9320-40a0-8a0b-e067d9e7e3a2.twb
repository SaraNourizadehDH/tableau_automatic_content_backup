      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='_bima_eze_experiment_list_file' id='_bima_eze_experiment_list_file_05BF275F26274B819056FBEA35389C5E'>
            <properties context=''>
              <relation join='inner' type='join'>
                <clause type='join'>
                  <expression op='='>
                    <expression op='[Custom SQL Query].[global_entity_id]' />
                    <expression op='[tableau_gsr_entitlements_marketing_global_entity_id].[global_entity_id]' />
                  </expression>
                </clause>
                <relation connection='bigquery.0wy4t631tvphzg11k4rlo1cm63dx' name='Custom SQL Query' type='text'>SELECT 
  DISTINCT
    input_list.*,
    CASE WHEN key_variant_output_list IS NULL THEN &apos;Non-Executed&apos; ELSE &apos;Executed&apos; END AS executed_flag,
    CASE WHEN receivers_output_list IS NULL THEN &apos;Error&apos; ELSE &apos;OK&apos; END AS executed_with_error_flag
FROM `fulfillment-dwh-production.cl_mkt._bima_eze_experiment_list_file` AS input_list
LEFT JOIN (
  SELECT 
    input.key_variant AS key_variant_input_list,
    output.key_variant AS key_variant_output_list,
    output.tg_receivers AS receivers_output_list
  FROM `fulfillment-dwh-production.cl_mkt._bima_eze_experiment_list_file` AS input
  LEFT JOIN `fulfillment-dwh-production.rl_mkt.bima_tableau_eze_experiment_outputs` AS output
    ON input.key_variant = output.key_variant
  GROUP BY input.key_variant, output.key_variant, output.tg_receivers
) AS exec_list
ON input_list.key_variant = exec_list.key_variant_input_list</relation>
                <relation connection='bigquery.0wy4t631tvphzg11k4rlo1cm63dx' name='tableau_gsr_entitlements_marketing_global_entity_id' table='[fulfillment-dwh-production.rl_mkt].[tableau_gsr_entitlements_marketing_global_entity_id]' type='table' />
              </relation>
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
