    <worksheet name='N Retention Northstar All KPI - Country Level Segmentation'>
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Retetention Performance' name='Staging Trial (local copy) | Project : Marketing BI (local copy)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Brand Segment' caption='Northstar View' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Brand Seg&quot;'>
              <calculation class='tableau' formula='&quot;Brand Seg&quot;' />
              <aliases>
                <alias key='&quot;Brand&quot;' value='Brand' />
                <alias key='&quot;Brand Seg&quot;' value='Brand Segment' />
                <alias key='&quot;Country &quot;' value='Country' />
                <alias key='&quot;Country Seg&quot;' value='Country Segment' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='Staging Trial (local copy) | Project : Marketing BI (local copy)'>
            <column caption='Group' datatype='string' name='[Calculation_18788511551684611]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_gcg] = 1 THEN &quot;GCG&quot; ELSE &quot;TG&quot; END' />
            </column>
            <column caption='Frequency' datatype='real' name='[Calculation_349099360917381122]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_month])/SUM([cust_month])' />
            </column>
            <column caption='Filter Northstar View' datatype='string' name='[Calculation_6505871932034596864]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 6]' />
            </column>
            <column caption='Country Name  (N)' datatype='string' name='[Calculation_6505871932038885378]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = &quot;Brand&quot; THEN &quot;-&quot; ELSE [country_name] END' />
            </column>
            <column caption='Gcg Version (copy)' datatype='string' name='[Gcg Version (copy)_3910672629249826819]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[gcg_version]' />
              <aliases>
                <alias key='&quot;2.0 CRM&quot;' value='2.0 CRM (Prelimenary)' />
