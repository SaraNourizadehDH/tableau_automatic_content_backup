    <worksheet name='Eng - In-App Metric'>
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Retetention Performance' name='Staging Trial (local copy) | Project : Marketing BI (local copy)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Push Metric' caption='Select Metrics' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Push&quot;'>
              <calculation class='tableau' formula='&quot;Push&quot;' />
              <aliases>
                <alias key='&quot;Adhoc/Lifecyle&quot;' value='Ad-hoc/Lifecycle Metric' />
                <alias key='&quot;Email&quot;' value='Email Metric' />
                <alias key='&quot;InApp&quot;' value='In-App Metric' />
                <alias key='&quot;Push&quot;' value='Push Metric' />
                <alias key='&quot;Push IOS/Android&quot;' value='Push Detail iOS/Android Metric' />
                <alias key='&quot;Push+Email&quot;' value='General (Push + Email) Metric' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='Staging Trial (local copy) | Project : Marketing BI (local copy)'>
            <column caption='% Contacted Customer' datatype='real' name='[% Push Concated Customer (copy)_1253619179084382213]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_recipients_push_email])/sum([total_reachable])' />
            </column>
            <column caption='% InApp Click Rate' datatype='real' name='[% Push Open Rate (copy)_3279042748123099137]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_inappmsg_click])/SUM([total_inappmsg_impression])' />
            </column>
            <column caption='% Reachable ' datatype='real' name='[% Reachable Push (copy)_1253619179083558914]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_reachable])/SUM([total_active_users])' />
            </column>
            <column caption='Average Delivery Frequency' datatype='real' name='[Average Email Delivery Frequency (copy)_1253619179095052303]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_delivery])/SUM([total_recipients_push_email])' />
            </column>
            <column caption='Average Open Frequency' datatype='real' name='[Average Email Open Frequency (copy)_1253619179095072784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_open])/SUM([total_recipients_push_email])' />
            </column>
            <column caption='Select Metric' datatype='string' name='[Calculation_347551268650622981]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
            </column>
            <column caption='Region2' datatype='string' name='[Calculation_4177440507508240400]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[segment]' />
            </column>
            <column caption='Brand' datatype='string' name='[brand]' role='dimension' type='nominal' />
            <column caption='Campaign Vertical' datatype='string' name='[campaign_vertical]' role='dimension' type='nominal' />
