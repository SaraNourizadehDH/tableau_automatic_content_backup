              <calculation class='tableau' formula='SUM([total_delivery_ac])/SUM([total_delivery_lc]+[total_delivery_ac])' />
            </column>
            <column caption='(Adhoc) Total Push Delivery' datatype='integer' name='[(Lifecycle) Total Push Delivery (copy)_3279042748137406480]' role='measure' type='quantitative'>
