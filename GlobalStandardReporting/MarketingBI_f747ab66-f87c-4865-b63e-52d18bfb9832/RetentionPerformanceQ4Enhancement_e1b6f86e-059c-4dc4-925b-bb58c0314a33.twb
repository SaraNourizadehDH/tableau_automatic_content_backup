            <datasource caption='Retetention Performance' name='Staging Trial (local copy) | Project : Marketing BI (local copy)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Push Metric' caption='Select Metrics' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Push&quot;'>
              <calculation class='tableau' formula='&quot;Push&quot;' />
              <aliases>
                <alias key='&quot;Adhoc/Lifecyle&quot;' value='Ad-hoc/Lifecycle Metric' />
                <alias key='&quot;Email&quot;' value='Email Metric' />
                <alias key='&quot;InApp&quot;' value='In-App Metric' />
                <alias key='&quot;Push&quot;' value='Push Metric' />
                <alias key='&quot;Push IOS/Android&quot;' value='Push Detail iOS/Android Metric' />
                <alias key='&quot;Push+Email&quot;' value='General (Push + Email) Metric' />
              </aliases>
            </column>
