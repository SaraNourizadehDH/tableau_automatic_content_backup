      </column>
      <column caption='% Anonymus' datatype='real' name='[Calculation_4564750075826298885]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([anonymus_lifecylce_segmentation])/(SUM([register_lifecylce_segmentation])+SUM([anonymus_lifecylce_segmentation])+ sum([dormant_lifecylce_segmentation]))' />
