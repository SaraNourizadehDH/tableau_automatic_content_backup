      <column caption='Contact Frequency RM' datatype='real' name='[Average Delivery Frequency (copy)_4651585133633069056]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM (IF [date_month]=[Parameters].[Parameter 3] and [campaign_vertical]=&quot;ALL&quot; then [total_delivery] END)&#10;/&#10;SUM (IF [date_month]=[Parameters].[Parameter 3] and [campaign_vertical]=&quot;ALL&quot; then [total_recipients_push_email] END)' />
      </column>
      <column caption='Average Email Open Frequency' datatype='real' name='[Average Email Delivery Frequency (copy)_1253619179089711115]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_email_open])/SUM([total_email_recipients])' />
      </column>
      <column caption='Average Delivery Frequency' datatype='real' name='[Average Email Delivery Frequency (copy)_1253619179095052303]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_delivery])/SUM([total_recipients_push_email])' />
      </column>
      <column caption='Average Open Frequency' datatype='real' name='[Average Email Open Frequency (copy)_1253619179095072784]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_open])/SUM([total_recipients_push_email])' />
      </column>
      <column caption='Average Push Open Frequency' datatype='real' name='[Average Push Delivery (copy)_1253619179088797703]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_push_open])/SUM([total_push_recipients])' />
      </column>
      <column caption='Average Email Delivery Frequency' datatype='real' name='[Average Push Delivery Frequency (copy)_1253619179089534986]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_email_delivery])/SUM([total_email_recipients])' />
      </column>
      <column caption='(Android) Average Push Delivery Frequency' datatype='real' name='[Average Push Delivery Frequency (copy)_3279042748130451468]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[(Android) Total Push Send (copy)_3279042748124405763] /SUM([total_push_recipients_android])' />
      </column>
      <column caption='% Push Open Rate' datatype='real' name='[Average Push Open Frequency (copy)_1253619179089248265]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_push_open])/SUM([total_push_delivery])' />
      </column>
      <column caption='Average Email Click Frequency' datatype='real' name='[Average Push Open Frequency (copy)_1253619179090018317]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_email_click])/SUM([total_email_recipients])' />
      </column>
      <column caption='(Android) Average Push Open Frequency' datatype='real' name='[Average Push Open Frequency (copy)_3279042748129730570]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[(Android) Total Push Delivery (copy)_3279042748124557316]/sum([total_push_recipients_android])' />
      </column>
      <column caption='(Lifecycle) Total Push Delivery' datatype='integer' name='[Average Push Open Frequency (copy)_3279042748137066511]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_push_delivery_android_lc]) + SUM([total_push_delivery_ios_lc])' />
      </column>
      <column caption='Order Uplift MOM' datatype='real' name='[CLV Uplift MOM (copy)_252412744909295636]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100*([Incr Order RM (copy)_252412744906428432] - SUM(IF [vertical_parent]=&quot;All&quot; and [date_month]=DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 3]) AND [customer_segment] =&quot;All&quot;  then [order_uplift] END))' />
      </column>
      <column caption='CLV Uplift YoY' datatype='real' name='[CLV Uplift MOM (copy)_6811835239087607822]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100*([Order Uplift RM (copy)_252412744906969106] - SUM(IF [vertical_parent]=&quot;All&quot; and [date_month]=DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 3]) AND [customer_segment] =&quot;All&quot; then [clv_uplift] END))' />
      </column>
      <column caption='CLV Uplift MOM' datatype='real' name='[CLV Uplift RM  (copy)_252412744908230675]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100*([Order Uplift RM (copy)_252412744906969106] - SUM(IF [vertical_parent]=&quot;All&quot; and [date_month]=DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 3]) AND [customer_segment] =&quot;All&quot; then [clv_uplift] END))' />
      </column>
      <column caption='Cost Per User' datatype='real' name='[Calculation_100838421258764288]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([voucher_eur])/SUM([cust_month])' />
      </column>
      <column caption='Basket Value' datatype='real' name='[Calculation_100838421268033546]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gbv_eur])/SUM([orders_month])' />
      </column>
      <column caption='Vertical Parent (N)' datatype='string' name='[Calculation_100838421282250774]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//IFNULL([Campaign Vertical],[Vertical Parent])&#10;IF [campaign_vertical] IN (&quot;ALL&quot;,&quot;0. All&quot;) THEN &quot;All&quot;&#10;ELSEIF  [campaign_vertical] IN (&quot;Dmarts&quot;,&quot;DMart&quot;) THEN &quot;Dmarts&quot;&#10;ELSEIF  [campaign_vertical] IN (&quot;Local Shops&quot;,&quot;Local Shop&quot;) THEN &quot;Local Shops&quot;&#10;ELSEIF  [campaign_vertical] IN (&quot;QCommerce&quot;,&quot;QC&quot;) THEN &quot;QCommerce&quot;&#10;ELSEIF  [campaign_vertical] IN (&quot;Restaurant&quot;) THEN &quot;Restaurant (Eng)&quot;&#10;ELSEIF  [campaign_vertical] IN (&quot;Undefined&quot;) THEN &quot;Undefined (Eng)&quot;&#10;ELSEIF  [campaign_vertical] IN (&quot;Restaurant + MIX&quot;) THEN &quot;Restaurant + MIX (Eng)&quot;&#10;ELSEIF  [campaign_vertical] IN (&quot;QC + MIX&quot;) THEN &quot;QC + MIX (Eng)&quot;&#10;ELSEIF  [campaign_vertical] IN (&quot;MIX&quot;) THEN &quot;MIX (Eng)&quot;&#10;ELSE IFNULL([campaign_vertical],[vertical_parent])&#10;END' />
      </column>
      <column caption='Months to display' datatype='boolean' name='[Calculation_1041527819171205122]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&quot;month&quot;,[date_month],[Parameters].[Parameter 3])&lt;= [Parameters].[Parameter 2]&#10;AND &#10;DATEDIFF(&quot;month&quot;,[date_month],[Parameters].[Parameter 3])&gt;= 0' />
      </column>
      <column caption='MoM Column Name' datatype='string' name='[Calculation_1041527819211477001]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;MoM&quot;' />
      </column>
      <column caption='# Retention Metric NG' datatype='real' name='[Calculation_1041527819222405131]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 4]=1  then&#10;SUM (IF  [campaign_vertical 1]=&quot;ALL&quot; then [total_delivery 1] END)&#10;/&#10;SUM (IF  [campaign_vertical 1]=&quot;ALL&quot; then [total_recipients_push_email 1] END)&#10;&#10;ELSEIF  [Parameters].[Parameter 4]=2 then &#10;SUM (IF [campaign_vertical 1]=&quot;ALL&quot; then [total_delivery_lc 1] END)&#10;/&#10;SUM (IF [campaign_vertical 1]=&quot;ALL&quot; then [total_recipients_push_email 1] END)&#10;ELSEIF  [Parameters].[Parameter 4]=3 then&#10;SUM (IF  [campaign_vertical 1]=&quot;QC&quot; then [total_delivery 1] END)&#10;/&#10;SUM (IF [campaign_vertical 1]=&quot;ALL&quot; then [total_recipients_push_email 1] END)&#10;ELSEIF  [Parameters].[Parameter 4]=4 then&#10;SUM (IF [campaign_vertical 1]=&quot;ALL&quot;  then [total_active_users 1] END)&#10;ELSEIF  [Parameters].[Parameter 4]=5 then&#10;SUM (IF [campaign_vertical 1]=&quot;ALL&quot;  then [total_sends 1] END)&#10;ELSEIF  [Parameters].[Parameter 4]=7 then&#10;SUM (IF [campaign_vertical 1]=&quot;QC&quot;  then [total_sends 1] END)&#10;ELSEIF  [Parameters].[Parameter 4]=6 then&#10;SUM (IF [campaign_vertical 1]=&quot;ALL&quot;  then [total_sends_lc 1] END)&#10;ELSEIF  [Parameters].[Parameter 4] = 8 then &#10;(&#10;    SUM(IF  [campaign_vertical 1]=&quot;ALL&quot; then[total_delivery_lc 1] end)&#10;)&#10;/&#10;(&#10;    (&#10;        SUM(IF   [campaign_vertical 1]=&quot;ALL&quot; then [total_delivery_lc 1] end)&#10;    )&#10;    +&#10;    (&#10;        SUM(IF [campaign_vertical 1]=&quot;ALL&quot; then [total_delivery_ac 1] end)&#10;    )   &#10;)&#10;ELSEIF  [Parameters].[Parameter 4] =9 then &#10;(&#10;(&#10;    (&#10;       &#10;        SUM(IF [vertical_parent 1]=&quot;All&quot; and [is_gcg]=0 then [orders_month] END)&#10;        /SUM(IF [vertical_parent 1]=&quot;All&quot;  and [is_gcg]=0 then [cust_month] END)&#10;        &#10;    )&#10;    -&#10;    (&#10;        &#10;        SUM(IF [vertical_parent 1]=&quot;All&quot; and [is_gcg]=1 then [orders_month] END)&#10;        /       &#10;        SUM(IF [vertical_parent 1]=&quot;All&quot; and [is_gcg]=1 then [cust_month] END)&#10;&#10;    )&#10;) * SUM(IF [vertical_parent 1]=&quot;All&quot;  and [is_gcg]=0 then [cust_month] END)&#10;)/&#10;        SUM(IF [vertical_parent 1]=&quot;All&quot; and [is_gcg]=0 then [orders_month] END)&#10;ELSEIF  [Parameters].[Parameter 4]=10 then &#10;(&#10;(&#10;    (&#10;       &#10;        SUM(IF [vertical_parent 1]=&quot;All&quot;  and [is_gcg]=0 then [gmv_eur_month] END)&#10;        /SUM(IF [vertical_parent 1]=&quot;All&quot; and [is_gcg]=0 then [cust_month] END)&#10;        &#10;    )&#10;    -&#10;    (&#10;        &#10;        SUM(IF [vertical_parent 1]=&quot;All&quot; and [is_gcg]=1 then [gmv_eur_month] END)&#10;        /       &#10;        SUM(IF [vertical_parent 1]=&quot;All&quot;  and [is_gcg]=1 then [cust_month] END)&#10;&#10;    )&#10;) * SUM(IF [vertical_parent 1]=&quot;All&quot; and[is_gcg]=0 then [cust_month] END)&#10;)/&#10;        SUM(IF [vertical_parent 1]=&quot;All&quot; and  [is_gcg]=0 then [gmv_eur_month] END)&#10;ELSEIF  [Parameters].[Parameter 4] =11 then &#10;(&#10;(&#10;    (&#10;       &#10;        SUM(IF [vertical_parent 1]=&quot;All&quot;  and [is_gcg]=0 then [clv] END)&#10;        /SUM(IF [vertical_parent 1]=&quot;All&quot;  and [is_gcg]=0 then [cust_month] END)&#10;        &#10;    )&#10;    -&#10;    (&#10;        &#10;        SUM(IF [vertical_parent 1]=&quot;All&quot; and [is_gcg]=1 then [clv] END)&#10;        /       &#10;        SUM(IF [vertical_parent 1]=&quot;All&quot; and [is_gcg]=1 then [cust_month] END)&#10;&#10;    )&#10;) * SUM(IF [vertical_parent 1]=&quot;All&quot;  and [is_gcg]=0 then [cust_month] END)&#10;)/&#10;        SUM(IF [vertical_parent 1]=&quot;All&quot;  and [is_gcg]=0 then [clv] END)&#10;ELSEIF  [Parameters].[Parameter 4]=12 then&#10;(&#10;(&#10;    (&#10;       &#10;        SUM(IF [vertical_parent 1]=&quot;All&quot;  and [is_gcg]=0 then [gbv_eur 1] END)&#10;        /SUM(IF [vertical_parent 1]=&quot;All&quot;  and [is_gcg]=0 then [cust_month] END)&#10;        &#10;    )&#10;    -&#10;    (&#10;        &#10;        SUM(IF [vertical_parent 1]=&quot;All&quot;  and [is_gcg]=1 then [gbv_eur 1] END)&#10;        /       &#10;        SUM(IF [vertical_parent 1]=&quot;All&quot;  and [is_gcg]=1 then [cust_month] END)&#10;&#10;    )&#10;) * SUM(IF [vertical_parent 1]=&quot;All&quot;  and [is_gcg]=0 then [cust_month] END)&#10;)/&#10;        SUM(IF [vertical_parent 1]=&quot;All&quot;  and [is_gcg]=0 then [gbv_eur 1] END)&#10;ELSEIF  [Parameters].[Parameter 4]= 13 then&#10;&#10;&#10;SUM (IF [campaign_vertical 1]=&quot;ALL&quot;  then [total_reachable 1] END)&#10;/SUM (IF  [campaign_vertical 1]=&quot;ALL&quot;  then [total_active_users 1] END)&#10;ELSEIF  [Parameters].[Parameter 4]= 13.1 then&#10;&#10;&#10;SUM (IF [campaign_vertical 1]=&quot;ALL&quot;  then [total_push_reachable 1] END)&#10;/SUM (IF  [campaign_vertical 1]=&quot;ALL&quot;  then [total_active_users 1] END)&#10;ELSEIF  [Parameters].[Parameter 4]= 13.2 then&#10;&#10;&#10;SUM (IF [campaign_vertical 1]=&quot;ALL&quot;  then [total_email_reachable 1] END)&#10;/SUM (IF  [campaign_vertical 1]=&quot;ALL&quot;  then [total_active_users 1] END)&#10;ELSEIF  [Parameters].[Parameter 4]= 14 then&#10;&#10;&#10;SUM (IF  [campaign_vertical 1]=&quot;ALL&quot;  then [total_recipients_push_email 1] END)&#10;/SUM (IF  [campaign_vertical 1]=&quot;ALL&quot;  then [total_reachable 1] END)&#10;ELSEIF  [Parameters].[Parameter 4]= 15 then&#10;SUM (IF  [vertical_parent 1]=&quot;All&quot; then [cust_month] END)&#10;&#10;ELSEIF  [Parameters].[Parameter 4]= 16 then&#10;&#10;&#10;SUM (IF  [vertical_parent 1]=&quot;All&quot; then [orders_month] END)&#10;/&#10;SUM (IF  [vertical_parent 1]=&quot;All&quot; then [cust_month] END)&#10;&#10;ELSEIF  [Parameters].[Parameter 4]= 17 then&#10;SUM (IF  [vertical_parent 1]=&quot;All&quot; then [orders_month] END)&#10;&#10;ELSEIF  [Parameters].[Parameter 4]= 18 then&#10;&#10;&#10;SUM (IF  [vertical_parent 1]=&quot;All&quot; then [gbv_eur 1] END)&#10;/&#10;SUM (IF  [vertical_parent 1]=&quot;All&quot; then [orders_month] END)&#10;&#10;ELSEIF  [Parameters].[Parameter 4]= 19 then&#10;SUM (IF  [vertical_parent 1]=&quot;All&quot; then [gbv_eur 1] END)&#10;&#10;ELSEIF  [Parameters].[Parameter 4]= 20 then&#10;&#10;SUM (IF  [vertical_parent 1]=&quot;All&quot; then [voucher_eur] END)&#10;&#10;ELSEIF  [Parameters].[Parameter 4]= 21 then&#10;SUM (IF  [vertical_parent 1]=&quot;All&quot; then [delivery_fee_eur 1] END)&#10;&#10;ELSEIF  [Parameters].[Parameter 4]= 22 then&#10;SUM (IF  [vertical_parent 1]=&quot;All&quot; then [gmv_eur_month] END)&#10;&#10;END' />
      </column>
      <column caption='% Reachable Push' datatype='real' name='[Calculation_1253619179083063296]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_push_reachable])/SUM([total_active_users])' />
      </column>
      <column caption='% Push Contacted Customer' datatype='real' name='[Calculation_1253619179083792387]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_push_recipients])/sum([total_push_reachable])' />
      </column>
      <column caption='Average Push Delivery Frequency' datatype='real' name='[Calculation_1253619179084812294]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_push_delivery])/SUM([total_push_recipients])' />
      </column>
      <column caption='Filter Table View' datatype='real' name='[Calculation_1253619179177439251]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 4]' />
      </column>
      <column caption='Level' datatype='real' name='[Calculation_1474788197918187521]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='' />
      </column>
      <column caption='Group' datatype='string' name='[Calculation_18788511551684611]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_gcg] = 1 THEN &quot;GCG&quot; ELSE &quot;TG&quot; END' />
      </column>
      <column caption='ROI RM' datatype='real' name='[Calculation_18788511556472837]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3]&lt;DATE(&quot;2024-01-01&quot;) then null else  ([Calculation_18788511560286215]+[incr GMV ROI RM (copy)_18788511560548360])/ [incr GMV ROI RM (copy) (copy)_18788511560560649] end' />
      </column>
      <column caption='ST  iGMV RM' datatype='real' name='[Calculation_18788511560286215]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [vertical_parent]=&quot;All&quot; and [date_month]=[Parameters].[Parameter 3] AND [customer_segment] = &quot;All&quot; Then [incr_gmv] END)' />
      </column>
      <column caption='MoM ROI' datatype='real' name='[Calculation_18788511703072778]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;[Calculation_18788511556472837] -&#10;    (&#10;       ([MoM Incr GMV RM  (copy)_18788511703543819]+[MoM Incr GMV ROI (copy)_18788511704059916])/ [MoM Incr HVA ROI  (copy)_18788511704256525]&#10;    )&#10;)&#10;/&#10;(&#10;     ([MoM Incr GMV RM  (copy)_18788511703543819]+[MoM Incr GMV ROI (copy)_18788511704059916])/ [MoM Incr HVA ROI  (copy)_18788511704256525]&#10;)' />
      </column>
      <column caption='TG Users - Fixed' datatype='integer' name='[Calculation_223842987122339840]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_gcg] = 0 THEN&#10;[cust_month]&#10;END' />
      </column>
      <column caption='GCG Users - Fixed' datatype='integer' name='[Calculation_223842987122421761]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_gcg] = 1 THEN&#10;[cust_month]&#10;END' />
      </column>
      <column caption='Total Users - Fixed' datatype='integer' name='[Calculation_223842987124682755]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[cust_month]' />
      </column>
      <column caption='(Android) Total Push Send' datatype='integer' name='[Calculation_3279042748123881474]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_push_sends_android_ac])+SUM([total_push_sends_android_lc])' />
      </column>
      <column caption='% (Lifecycle) Total' datatype='real' name='[Calculation_3279042748139364369]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_delivery_lc])/SUM([total_delivery_lc]+[total_delivery_ac])' />
      </column>
      <column caption='Select Metric' datatype='string' name='[Calculation_347551268650622981]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
      </column>
      <column caption='MAU' datatype='integer' name='[Calculation_349099360915161088]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gcg_cust_month 1])+SUM([tg_cust_month 1])' />
      </column>
      <column caption='Frequency' datatype='real' name='[Calculation_349099360917381122]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_month])/SUM([cust_month])' />
      </column>
      <column caption='GBV/ Order' datatype='real' name='[Calculation_3910672628955234305]' role='measure' type='quantitative'>
