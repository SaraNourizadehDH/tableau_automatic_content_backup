      </column>
      <column caption='Retention Metric MoM' datatype='real' name='[Retention Metric (copy)_1041527819472748561]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 4]=1 then &#10;&#10;(&#10;        SUM(IF [date_month]=[Parameters].[Parameter 3] THEN [Calculation_223842987124682755] END)&#10;        -&#10;        SUM(if [date_month] = DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 3]) THEN [Calculation_223842987124682755]  END )&#10;)&#10;        /&#10;        SUM(if [date_month] = DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 3]) THEN [Calculation_223842987124682755]  END )&#10;ELSEIF  [Parameters].[Parameter 4]=5 THEN &#10;(&#10;        SUM(IF [date_month]=[Parameters].[Parameter 3] THEN [gbv_eur 1] END)&#10;        -&#10;        SUM(if [date_month] = DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 3]) THEN [gbv_eur 1]  END )&#10;)&#10;        /&#10;        SUM(if [date_month] = DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 3]) THEN [gbv_eur 1]  END )&#10;END' />
      </column>
