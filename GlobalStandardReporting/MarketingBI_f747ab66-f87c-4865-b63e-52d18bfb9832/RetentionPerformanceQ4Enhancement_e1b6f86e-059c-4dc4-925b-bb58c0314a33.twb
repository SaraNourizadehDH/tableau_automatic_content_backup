      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Retetention Performance' name='Staging Trial (local copy) | Project : Marketing BI (local copy)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...source-field='[Staging Trial (local copy) | Project : Marketing BI (local copy)].[date_month]' caption='Reporting month (p)' datatype='date' default-format='*mmm yyyy' name='[Parameter 3]' param-domain-type='list' role='measure' type='quantitative' value='#2024-06-01#'>
              <calculation class='tableau' formula='#2024-06-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='Staging Trial (local copy) | Project : Marketing BI (local copy)'>
            <column caption='LC Comms Share RM' datatype='real' name='[% (Lifecycle) Total (copy)_4651585133638758402]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    SUM(IF [date_month]=[Parameters].[Parameter 3] and [campaign_vertical]=&quot;ALL&quot; then[total_delivery_lc] end)&#10;)&#10;/&#10;(&#10;    (&#10;        SUM(IF [date_month]=[Parameters].[Parameter 3] and [campaign_vertical]=&quot;ALL&quot; then [total_delivery_lc] end)&#10;    )&#10;    +&#10;    (&#10;        SUM(IF [date_month]=[Parameters].[Parameter 3]  and [campaign_vertical]=&quot;ALL&quot; then [total_delivery_ac] end)&#10;    )   &#10;)&#10;///SUM([total_delivery_lc]+[total_delivery_ac])' />
            </column>
            <column caption='Contact Frequency QC RM' datatype='real' name='[Contact Frequency RM (copy)_4651585133742198820]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM (IF [date_month]=[Parameters].[Parameter 3] and [campaign_vertical]=&quot;QC&quot; then [total_delivery] END)&#10;/&#10;SUM (IF [date_month]=[Parameters].[Parameter 3] and [campaign_vertical]=&quot;ALL&quot; then [total_recipients_push_email] END)' />
            </column>
            <column caption='MoM LC Comms Share RM' datatype='real' name='[LC Comms Share RM (copy)_4651585133640200195]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100 * &#10;(&#10;    [% (Lifecycle) Total (copy)_4651585133638758402] -&#10;    (&#10;        (&#10;            SUM(IF [date_month]= DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 3]) and [campaign_vertical]=&quot;ALL&quot; then[total_delivery_lc] end)&#10;        )&#10;        /&#10;        (&#10;            (&#10;                SUM(IF [date_month]= DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 3]) and [campaign_vertical]=&quot;ALL&quot; then [total_delivery_lc] end)&#10;            )&#10;            +&#10;            (&#10;                SUM(IF [date_month]= DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 3]) and [campaign_vertical]=&quot;ALL&quot; then [total_delivery_ac] end)&#10;            )   &#10;        )&#10;    )&#10;)' />
            </column>
            <column caption='MOM Contact Frequency QC RM' datatype='real' name='[MOM Contact Frequency RM  (copy)_4651585133742657573]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;[Contact Frequency RM (copy)_4651585133742198820] -&#10;    (&#10;    SUM (IF [date_month]=DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 3]) and [campaign_vertical]=&quot;QC&quot; then [total_delivery] END) &#10;&#10;    /&#10;&#10;    SUM (IF [date_month]=DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 3]) and [campaign_vertical]=&quot;ALL&quot; then [total_recipients_push_email] END)&#10;    )&#10;)&#10;/&#10;(&#10;    SUM (IF [date_month]=DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 3]) and [campaign_vertical]=&quot;QC&quot;then [total_delivery] END) &#10;&#10;    /&#10;&#10;    SUM (IF [date_month]=DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 3]) and [campaign_vertical]=&quot;ALL&quot; then [total_recipients_push_email] END)&#10;    )' />
            </column>
            <column caption='MOM Reachable RM Email' datatype='real' name='[MOM Reachable RM  (copy)_252412744889954311]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100*&#10;(&#10;    [Reachable RM  (copy)_252412744867471365] -&#10;    (&#10;        SUM (IF [date_month]=DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 3]) and [campaign_vertical]=&quot;ALL&quot;  then [total_email_reachable] END)&#10;        /SUM (IF [date_month]=DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 3])  and [campaign_vertical]=&quot;ALL&quot;  then [total_active_users] END)&#10;    )&#10;)' />
            </column>
            <column caption='MOM Contacted Customer RM' datatype='real' name='[MOM Reachable RM  (copy)_4651585133729816603]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100*&#10;(&#10;    [Reachable RM  (copy)_4651585133729292314] -&#10;    (&#10;        SUM (IF [date_month]=DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 3]) and [campaign_vertical]=&quot;ALL&quot;  then [total_recipients_push_email] END)&#10;        /SUM (IF [date_month]=DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 3])  and [campaign_vertical]=&quot;ALL&quot;  then [total_reachable] END)&#10;    )&#10;)' />
            </column>
            <column caption='MOM Reachable RM Push' datatype='real' name='[MOM Reachable RM Email (copy)_252412744896614409]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100*&#10;(&#10;    [Reachable Email RM (copy)_252412744867901446] -&#10;    (&#10;        SUM (IF [date_month]=DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 3]) and [campaign_vertical]=&quot;ALL&quot;  then [total_push_reachable] END)&#10;        /SUM (IF [date_month]=DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 3])  and [campaign_vertical]=&quot;ALL&quot;  then [total_active_users] END)&#10;    )&#10;)' />
            </column>
            <column caption='debug' datatype='integer' name='[MOM Reachable RM Email (copy)_252412744980553755]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM (IF [date_month]=DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 3]) and [campaign_vertical]=&quot;ALL&quot;  then [total_email_reachable] END)' />
            </column>
            <column caption='Reachable Push RM ' datatype='real' name='[Reachable Email RM (copy)_252412744867901446]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM (IF [date_month]=[Parameters].[Parameter 3] and [campaign_vertical]=&quot;ALL&quot;  then [total_push_reachable] END)&#10;/SUM (IF [date_month]=[Parameters].[Parameter 3] and [campaign_vertical]=&quot;ALL&quot;  then [total_active_users] END)' />
            </column>
            <column caption='Reachable Email RM' datatype='real' name='[Reachable RM  (copy)_252412744867471365]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM (IF [date_month]=[Parameters].[Parameter 3] and [campaign_vertical]=&quot;ALL&quot;  then [total_email_reachable] END)&#10;/SUM (IF [date_month]=[Parameters].[Parameter 3] and [campaign_vertical]=&quot;ALL&quot;  then [total_active_users] END)' />
            </column>
            <column caption='MOM Reachable RM ' datatype='real' name='[Reachable RM  (copy)_4651585133727952920]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100*&#10;(&#10;    [Total Active User (12M) RM (copy)_4651585133727363095] -&#10;    (&#10;        SUM (IF [date_month]=DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 3]) and [campaign_vertical]=&quot;ALL&quot;  then [total_reachable] END)&#10;        /SUM (IF [date_month]=DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 3])  and [campaign_vertical]=&quot;ALL&quot;  then [total_active_users] END)&#10;    )&#10;)' />
