                <alias key='&quot;Brand&quot;' value='Brand' />
                <alias key='&quot;Brand Seg&quot;' value='Brand Segment' />
                <alias key='&quot;Country &quot;' value='Country' />
                <alias key='&quot;Country Seg&quot;' value='Country Segment' />
