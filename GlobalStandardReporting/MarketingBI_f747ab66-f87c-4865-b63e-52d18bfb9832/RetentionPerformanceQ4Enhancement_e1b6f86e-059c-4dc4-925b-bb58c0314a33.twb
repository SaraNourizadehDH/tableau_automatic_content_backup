            <customized-tooltip>
              <formatted-text>
                <run bold='true' fontname='Tableau bold' fontsize='9'>RETENTION ROI</run>
                <run>Æ&#10;</run>
                <run bold='true' fontsize='9'>--Formula--</run>
                <run>Æ&#10;</run>
                <run bold='true' fontname='bold' fontsize='9'>- ROI: </run>
                <run bold='true' fontsize='9'>(ST iGMV + LT iGMV) / iCost</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontsize='9'>--Abbreviations--</run>
                <run>Æ&#10;</run>
                <run bold='true' fontname='bold' fontsize='9'>- ST iGMV:</run>
                <run bold='true' fontsize='9'> Short Term iGMV similar to iGMV</run>
                <run>Æ&#10;</run>
                <run bold='true' fontname='bold' fontsize='9'>- LT iGMV:</run>
                <run bold='true' fontsize='9'> Long Term iGMV similar to iHVA (incremental high value action)</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontname='Tableau Bold' fontsize='9'>CRM Engagement</run>
                <run>Æ&#10;</run>
                <run bold='true' fontsize='9'>--Formula--</run>
                <run>Æ&#10;</run>
                <run bold='true' fontname='bold ' fontsize='9'>- Reachable Email %: </run>
                <run bold='true' fontsize='9'>Total Reachable Email / Total Active User</run>
                <run>Æ&#10;</run>
                <run bold='true' fontname='bold ' fontsize='9'>- Reachable Push %: </run>
                <run bold='true' fontsize='9'>Total Reachable Push / Total Active User</run>
                <run>Æ&#10;</run>
                <run bold='true' fontname='bold ' fontsize='9'>- Contacted Customer %: </run>
                <run bold='true' fontsize='9'>Total Recipent Push or email / Total Active User</run>
                <run>Æ&#10;</run>
                <run bold='true' fontname='bold' fontsize='9'>- Frequency:</run>
                <run bold='true' fontsize='9'> Total Delivery / Total Recipent Push or email</run>
                <run>Æ&#10;</run>
                <run bold='true' fontname='bold' fontsize='9'>- Frequency QC only: </run>
                <run bold='true' fontsize='9'>Total QC Delivery / Total Recipent Push or email </run>
                <run>Æ&#10;</run>
                <run bold='true' fontname='bold' fontsize='9'>- Share of Automation %: </run>
                <run bold='true' fontsize='9'>Total Lifecyle Delivery / Total Delivery</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontname='bold ' fontsize='9'>Caviet:</run>
                <run bold='true' fontsize='9'> There is a formula discrepancy on &quot;Frequency QC only&quot; in Retention engagement whereas the &quot;</run>
                <run bold='true' fontname='Tableau Bold' fontsize='9'>denominator&quot;</run>
                <run bold='true' fontsize='9'> on retention engagement page use &quot;Total Recipent Push or email on QC&quot; instead of &quot;Total Recipent Push or email&quot;</run>
              </formatted-text>
            </customized-tooltip>
