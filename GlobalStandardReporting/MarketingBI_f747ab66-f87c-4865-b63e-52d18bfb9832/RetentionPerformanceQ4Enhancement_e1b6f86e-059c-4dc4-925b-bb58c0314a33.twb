            <column caption='Vertical Parent (N)' datatype='string' name='[Calculation_100838421282250774]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//IFNULL([Campaign Vertical],[Vertical Parent])&#10;IF [campaign_vertical] IN (&quot;ALL&quot;,&quot;0. All&quot;) THEN &quot;All&quot;&#10;ELSEIF  [campaign_vertical] IN (&quot;Dmarts&quot;,&quot;DMart&quot;) THEN &quot;Dmarts&quot;&#10;ELSEIF  [campaign_vertical] IN (&quot;Local Shops&quot;,&quot;Local Shop&quot;) THEN &quot;Local Shops&quot;&#10;ELSEIF  [campaign_vertical] IN (&quot;QCommerce&quot;,&quot;QC&quot;) THEN &quot;QCommerce&quot;&#10;ELSEIF  [campaign_vertical] IN (&quot;Restaurant&quot;) THEN &quot;Restaurant (Eng)&quot;&#10;ELSEIF  [campaign_vertical] IN (&quot;Undefined&quot;) THEN &quot;Undefined (Eng)&quot;&#10;ELSEIF  [campaign_vertical] IN (&quot;Restaurant + MIX&quot;) THEN &quot;Restaurant + MIX (Eng)&quot;&#10;ELSEIF  [campaign_vertical] IN (&quot;QC + MIX&quot;) THEN &quot;QC + MIX (Eng)&quot;&#10;ELSEIF  [campaign_vertical] IN (&quot;MIX&quot;) THEN &quot;MIX (Eng)&quot;&#10;ELSE IFNULL([campaign_vertical],[vertical_parent])&#10;END' />
            </column>
            <column caption='Months to display' datatype='boolean' name='[Calculation_1041527819171205122]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&quot;month&quot;,[date_month],[Parameters].[Parameter 3])&lt;= [Parameters].[Parameter 2]&#10;AND &#10;DATEDIFF(&quot;month&quot;,[date_month],[Parameters].[Parameter 3])&gt;= 0' />
            </column>
            <column caption='Filter Table View' datatype='real' name='[Calculation_1253619179177439251]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 4]' />
            </column>
            <column caption='Group' datatype='string' name='[Calculation_18788511551684611]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_gcg] = 1 THEN &quot;GCG&quot; ELSE &quot;TG&quot; END' />
            </column>
            <column caption='Brand' datatype='string' name='[brand]' role='dimension' type='nominal' />
