      <column caption='YoY LC Comms Share RM' datatype='real' name='[MoM LC Comms Share RM (copy)_6811835239086002187]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100 * &#10;(&#10;    [% (Lifecycle) Total (copy)_4651585133638758402] -&#10;    (&#10;        (&#10;            SUM(IF [date_month]= DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 3]) and [campaign_vertical]=&quot;ALL&quot; then[total_delivery_lc] end)&#10;        )&#10;        /&#10;        (&#10;            (&#10;                SUM(IF [date_month]= DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 3]) and [campaign_vertical]=&quot;ALL&quot; then [total_delivery_lc] end)&#10;            )&#10;            +&#10;            (&#10;                SUM(IF [date_month]= DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 3]) and [campaign_vertical]=&quot;ALL&quot; then [total_delivery_ac] end)&#10;            )   &#10;        )&#10;    )&#10;)' />
