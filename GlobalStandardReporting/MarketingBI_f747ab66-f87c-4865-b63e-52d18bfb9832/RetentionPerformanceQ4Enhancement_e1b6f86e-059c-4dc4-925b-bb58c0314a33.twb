      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Tableau Bold'>RETENTION ROI</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Retetention Performance' name='Staging Trial (local copy) | Project : Marketing BI (local copy)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...source-field='[Staging Trial (local copy) | Project : Marketing BI (local copy)].[date_month]' caption='Reporting month (p)' datatype='date' default-format='*mmm yyyy' name='[Parameter 3]' param-domain-type='list' role='measure' type='quantitative' value='#2024-06-01#'>
              <calculation class='tableau' formula='#2024-06-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='Staging Trial (local copy) | Project : Marketing BI (local copy)'>
            <column caption='ROI RM' datatype='real' name='[Calculation_18788511556472837]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3]&lt;DATE(&quot;2024-01-01&quot;) then null else  ([Calculation_18788511560286215]+[incr GMV ROI RM (copy)_18788511560548360])/ [incr GMV ROI RM (copy) (copy)_18788511560560649] end' />
            </column>
            <column caption='ST  iGMV RM' datatype='real' name='[Calculation_18788511560286215]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [vertical_parent]=&quot;All&quot; and [date_month]=[Parameters].[Parameter 3] AND [customer_segment] = &quot;All&quot; Then [incr_gmv] END)' />
            </column>
            <column caption='MoM ROI' datatype='real' name='[Calculation_18788511703072778]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;[Calculation_18788511556472837] -&#10;    (&#10;       ([MoM Incr GMV RM  (copy)_18788511703543819]+[MoM Incr GMV ROI (copy)_18788511704059916])/ [MoM Incr HVA ROI  (copy)_18788511704256525]&#10;    )&#10;)&#10;/&#10;(&#10;     ([MoM Incr GMV RM  (copy)_18788511703543819]+[MoM Incr GMV ROI (copy)_18788511704059916])/ [MoM Incr HVA ROI  (copy)_18788511704256525]&#10;)' />
            </column>
            <column caption='iCOst Sign RM ' datatype='integer' name='[GMV Sign RM  (copy) (copy)_252412744564842500]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [vertical_parent]=&quot;All&quot; and [date_month]=[Parameters].[Parameter 3] and [is_gcg]=0 AND [customer_segment] = &quot;All&quot; then [cost_significancy] END' />
            </column>
            <column caption='HVA Sign RM  ' datatype='integer' name='[GMV Sign RM  (copy)_252412744564834307]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [vertical_parent]=&quot;All&quot; and [date_month]=[Parameters].[Parameter 3] and [is_gcg]=0 AND [customer_segment] =&quot;All&quot; then [hva_significancy] END' />
            </column>
            <column caption='Incr Cost ROI  PY' datatype='real' name='[Incr Cost ROI  PM (copy)_6811835239069593602]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='SUM(IF [vertical_parent]=&quot;All&quot; and [date_month]=DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 3]) then [incr_cost] END)' />
            </column>
            <column caption='GMV Sign RM ' datatype='integer' name='[Incr GMV RM  (copy)_252412744564371458]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [vertical_parent]=&quot;All&quot; and [date_month]=[Parameters].[Parameter 3] and [is_gcg]=0 AND [customer_segment] = &quot;All&quot; then [gmv_significancy] END' />
            </column>
            <column caption='Incr GMV ROI PY' datatype='real' name='[Incr GMV ROI PM (copy)_6811835239069847555]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [vertical_parent]=&quot;All&quot; and [date_month]=DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 3])  then [incr_gmv] END)' />
            </column>
            <column caption='Incr HVA ROI PY' datatype='real' name='[Incr HVA ROI PM (copy)_6811835239069859844]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [vertical_parent]=&quot;All&quot; and [date_month]=DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 3])  then [incr_hva] END)' />
            </column>
            <column caption='Incr GMV ROI PM' datatype='real' name='[MoM Incr GMV RM  (copy)_18788511703543819]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [vertical_parent]=&quot;All&quot; and [date_month]=DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 3])  then [incr_gmv] END)' />
            </column>
            <column caption='Incr HVA ROI PM' datatype='real' name='[MoM Incr GMV ROI (copy)_18788511704059916]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [vertical_parent]=&quot;All&quot; and [date_month]=DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 3])  then [incr_hva] END)' />
            </column>
            <column caption='Incr Cost ROI  PM' datatype='real' name='[MoM Incr HVA ROI  (copy)_18788511704256525]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [vertical_parent]=&quot;All&quot; and [date_month]=DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 3]) then [incr_cost] END)' />
            </column>
            <column caption='YoY                      ' datatype='real' name='[MoM ROI (copy)_6811835239069360129]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;[Calculation_18788511556472837] -&#10;    (&#10;       ([Incr GMV ROI PM (copy)_6811835239069847555]+[Incr HVA ROI PM (copy)_6811835239069859844])/ [Incr Cost ROI  PM (copy)_6811835239069593602]&#10;    )&#10;)&#10;/&#10;(&#10;     ([Incr GMV ROI PM (copy)_6811835239069847555]+[Incr HVA ROI PM (copy)_6811835239069859844])/ [Incr Cost ROI  PM (copy)_6811835239069593602]&#10;)' />
            </column>
