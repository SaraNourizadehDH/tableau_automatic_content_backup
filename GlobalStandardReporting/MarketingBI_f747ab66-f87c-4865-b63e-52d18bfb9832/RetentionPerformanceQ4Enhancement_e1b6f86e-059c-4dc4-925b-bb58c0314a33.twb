            </column>
            <column caption='incr HVA ROI RM ' datatype='real' name='[incr GMV ROI RM (copy)_18788511560548360]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    (&#10;       &#10;        SUM(IF [vertical_parent]=&quot;All&quot; and [date_month]=[Parameters].[Parameter 3] and [is_gcg]=0 AND [customer_segment] = &quot;All&quot; then [hva_eur_month] END)&#10;        /SUM(IF [vertical_parent]=&quot;All&quot; and [date_month]=[Parameters].[Parameter 3] and [is_gcg]=0 AND [customer_segment] = &quot;All&quot;then [cust_month] END)&#10;        &#10;    )&#10;    -&#10;    (&#10;        &#10;        SUM(IF [vertical_parent]=&quot;All&quot; and [date_month]=[Parameters].[Parameter 3] and [is_gcg]=1 AND [customer_segment] = &quot;All&quot; then [hva_eur_month] END)&#10;        /       &#10;        SUM(IF [vertical_parent]=&quot;All&quot; and [date_month]=[Parameters].[Parameter 3] and [is_gcg]=1 AND [customer_segment] = &quot;All&quot; then [cust_month] END)&#10;&#10;    )&#10;) * SUM(IF [vertical_parent]=&quot;All&quot; and [date_month]=[Parameters].[Parameter 3] and [is_gcg]=0 AND [customer_segment] = &quot;All&quot; then [cust_month] END)' />
            </column>
