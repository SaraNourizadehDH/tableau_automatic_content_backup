                <alias key='13.2' value='% Reachable Email' />
                <alias key='14.' value='% Contacted Customer' />
                <alias key='15.' value='GCG vs TG - Total User' />
                <alias key='16.' value='GCG vs TG - Order Frequency' />
                <alias key='17.' value='GCG vs TG - Orders' />
                <alias key='18.' value='GCG vs TG - Basket Value' />
                <alias key='19.' value='GCG vs TG - GBV' />
