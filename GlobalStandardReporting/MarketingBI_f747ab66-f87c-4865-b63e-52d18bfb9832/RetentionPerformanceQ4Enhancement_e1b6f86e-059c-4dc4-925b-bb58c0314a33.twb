            <column-instance column='[Calculation_18788511703072778]' derivation='User' name='[usr:Calculation_18788511703072778:qk]' pivot='key' type='quantitative' />
            <column-instance column='[incr GMV ROI RM (copy) (copy)_18788511560560649]' derivation='User' name='[usr:incr GMV ROI RM (copy) (copy)_18788511560560649:qk]' pivot='key' type='quantitative' />
            <column-instance column='[incr GMV ROI RM (copy)_18788511560548360]' derivation='User' name='[usr:incr GMV ROI RM (copy)_18788511560548360:qk]' pivot='key' type='quantitative' />
            <column caption='Vertical Parent' datatype='string' name='[vertical_parent]' role='dimension' type='nominal' />
          </datasource-dependencies>
