            <column caption='Cust Month' datatype='integer' name='[cust_month]' role='dimension' type='quantitative' />
            <column caption='Customer Segment' datatype='string' name='[customer_segment]' role='dimension' type='nominal'>
              <aliases>
                <alias key='%null%' value='Unsegment' />
                <alias key='&quot;1-er&quot;' value='1-ers' />
                <alias key='&quot;Churned&quot;' value='Churned' />
                <alias key='&quot;high frequency&quot;' value='High Frequency' />
                <alias key='&quot;Inactive&quot;' value='Inactive' />
                <alias key='&quot;Lost&quot;' value='Reacquired' />
                <alias key='&quot;low frequency&quot;' value='Low Frequency' />
                <alias key='&quot;mid frequency&quot;' value='Mid Frequency' />
                <alias key='&quot;new_customer&quot;' value='Acquisition' />
