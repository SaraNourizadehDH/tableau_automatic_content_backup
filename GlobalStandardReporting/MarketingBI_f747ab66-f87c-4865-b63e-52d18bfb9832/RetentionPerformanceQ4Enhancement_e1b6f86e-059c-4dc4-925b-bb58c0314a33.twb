      <column caption='MoM Incr GBV RM' datatype='real' name='[MoM Incr CLV RM (copy)_4651585133710127124]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100*(&#10;[Incr CLV RM  (copy)_4651585133708906515] -&#10;     (&#10;        (&#10;&#10;            (&#10;                (&#10;                   &#10;                    SUM(IF [vertical_parent]=&quot;All&quot; and [date_month]=DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 3])  then [tg_gbv_eur] END)&#10;                    /SUM(IF [vertical_parent]=&quot;All&quot; and [date_month]=DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 3]) then [tg_cust_month] END)&#10;                    &#10;                )&#10;                -&#10;                (&#10;                    &#10;                    SUM(IF [vertical_parent]=&quot;All&quot; and [date_month]=DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 3]) then [gcg_gbv_eur] END)&#10;                    /       &#10;                    SUM(IF [vertical_parent]=&quot;All&quot; and [date_month]=DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 3])  then [gcg_cust_month] END)&#10;&#10;                )&#10;            ) * SUM(IF [vertical_parent]=&quot;All&quot; and [date_month]=DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 3])  then [tg_cust_month] END)&#10;&#10;        )/SUM(IF [vertical_parent]=&quot;All&quot; and [date_month]=DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 3]) then [tg_gbv_eur] END)&#10;    )&#10;)' />
