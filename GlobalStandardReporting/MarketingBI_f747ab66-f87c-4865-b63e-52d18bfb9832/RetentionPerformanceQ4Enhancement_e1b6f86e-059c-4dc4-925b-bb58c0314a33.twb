              <calculation class='tableau' formula='#2024-06-01#' />
            </column>
            <column alias='GCG vs TG - Total User' caption='Retention Metric' datatype='real' name='[Parameter 4]' param-domain-type='list' role='measure' type='quantitative' value='15.'>
