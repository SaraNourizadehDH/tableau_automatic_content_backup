      </column>
      <column caption='Incr cost/ Incr ord' datatype='real' name='[Calculation_675891789253529621]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Incremental GMV (copy)_4177440502932320256]/([Calculation_675891856491171845])' />
      </column>
      <column caption='Incremental GMV' datatype='real' name='[Calculation_675891791177891869]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([tg_gmv_eur_month]) / sum([tg_cust_month]) - sum([gcg_gmv_eur_month]) / sum([gcg_cust_month])) * sum([tg_cust_month])' />
      </column>
      <column caption='GCG GMV' datatype='real' name='[Calculation_675891791178104862]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_gcg] = 1 THEN&#10;[gmv_eur_month]&#10;END' />
      </column>
      <column caption='Gcg FLGP' datatype='real' name='[Calculation_675891791188443172]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_gcg] = 1 THEN&#10;[flgp]&#10;END' />
      </column>
      <column caption='Incremental FLGP' datatype='real' name='[Calculation_675891791188631589]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Calculation_554153889626951681],[segment 1], [country_name], [date_month], [brand], [sub_entity] : &#10;(SUM([tg_flgp])/SUM([Calculation_223842987122339840]) - SUM([Calculation_675891791188443172])/SUM([Calculation_223842987122421761])) * SUM([Calculation_223842987122339840])&#10;}' />
      </column>
      <column caption='% flgp' datatype='real' name='[Calculation_675891856486412288]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_675891791188631589])/SUM([Calculation_223842987122339840])' />
      </column>
      <column caption='Freq. Uplift #' datatype='real' name='[Calculation_675891856487727105]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_675891856488230914]-[Calculation_675891856488378371]' />
      </column>
