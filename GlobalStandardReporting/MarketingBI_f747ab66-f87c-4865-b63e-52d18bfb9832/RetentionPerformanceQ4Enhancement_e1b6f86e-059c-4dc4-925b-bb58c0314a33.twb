    <worksheet name='Retention Northstar All KPI - Brand Level (3)'>
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Retetention Performance' name='Staging Trial (local copy) | Project : Marketing BI (local copy)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...source-field='[Staging Trial (local copy) | Project : Marketing BI (local copy)].[date_month]' caption='Reporting month (p)' datatype='date' default-format='*mmm yyyy' name='[Parameter 3]' param-domain-type='list' role='measure' type='quantitative' value='#2024-06-01#'>
              <calculation class='tableau' formula='#2024-06-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='Staging Trial (local copy) | Project : Marketing BI (local copy)'>
            <column caption='%  (iOS) Push Open Rate' datatype='real' name='[%  (Android) Push Open Rate (copy)_3279042748126236681]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[(Android) Total Push Open (copy)_3279042748124930054] /[(Android) Total Push Send (copy)_3279042748124958727]' />
            </column>
            <column caption='% (Ad-hoc) Total ' datatype='real' name='[% (Lifecycle) Total (copy)_3279042748139692050]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_delivery_ac])/SUM([total_delivery_lc]+[total_delivery_ac])' />
            </column>
            <column caption='LC Comms Share RM' datatype='real' name='[% (Lifecycle) Total (copy)_4651585133638758402]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    SUM(IF [date_month]=[Parameters].[Parameter 3] and [campaign_vertical]=&quot;ALL&quot; then[total_delivery_lc] end)&#10;)&#10;/&#10;(&#10;    (&#10;        SUM(IF [date_month]=[Parameters].[Parameter 3] and [campaign_vertical]=&quot;ALL&quot; then [total_delivery_lc] end)&#10;    )&#10;    +&#10;    (&#10;        SUM(IF [date_month]=[Parameters].[Parameter 3]  and [campaign_vertical]=&quot;ALL&quot; then [total_delivery_ac] end)&#10;    )   &#10;)&#10;///SUM([total_delivery_lc]+[total_delivery_ac])' />
            </column>
            <column caption='% Email Click Rate' datatype='real' name='[% Email  Open Rate (copy)_1253619179090227214]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_email_click])/SUM([total_email_open])' />
            </column>
            <column caption='% Email Contacted Customer' datatype='real' name='[% Push Concated Customer (copy)_1253619179084136452]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_email_recipients])/sum([total_email_reachable])' />
            </column>
            <column caption='% Contacted Customer' datatype='real' name='[% Push Concated Customer (copy)_1253619179084382213]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_recipients_push_email])/sum([total_reachable])' />
            </column>
            <column caption='% Email Open Rate' datatype='real' name='[% Push Open Rate (copy)_1253619179089833996]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_email_open])/SUM([total_email_delivery])' />
            </column>
            <column caption='% InApp Click Rate' datatype='real' name='[% Push Open Rate (copy)_3279042748123099137]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_inappmsg_click])/SUM([total_inappmsg_impression])' />
            </column>
            <column caption='%  (Android) Push Open Rate' datatype='real' name='[% Push Open Rate (copy)_3279042748125704200]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[(Android) Total Push Delivery (copy)_3279042748124557316]/[Calculation_3279042748123881474]' />
            </column>
            <column caption='% Reachable Email' datatype='real' name='[% Reachable Push (copy)_1253619179083456513]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_email_reachable])/SUM([total_active_users])' />
            </column>
            <column caption='% Reachable ' datatype='real' name='[% Reachable Push (copy)_1253619179083558914]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_reachable])/SUM([total_active_users])' />
            </column>
            <column caption='(iOS) Average Push Delivery Frequency' datatype='real' name='[(Android) Average Push Delivery Frequency (copy)_3279042748130697230]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[(Android) Total Push Delivery (copy)_3279042748124819461] /SUM([total_push_recipients_ios])' />
            </column>
            <column caption='(iOS) Average Push Open Frequency ' datatype='real' name='[(Android) Average Push Open Frequency (copy)_3279042748130021387]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[(Android) Total Push Open (copy)_3279042748124930054]/sum([total_push_recipients_ios])' />
            </column>
            <column caption='(Android) Total Push Open' datatype='integer' name='[(Android) Total Push Delivery (copy)_3279042748124557316]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_push_open_android_ac])+SUM([total_push_open_android_lc])' />
            </column>
            <column caption='(iOS) Total Push Delivery' datatype='integer' name='[(Android) Total Push Delivery (copy)_3279042748124819461]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_push_delivery_ios_ac])+SUM([total_push_delivery_ios_lc])' />
            </column>
            <column caption='(iOS) Total Push Open' datatype='integer' name='[(Android) Total Push Open (copy)_3279042748124930054]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_push_open_ios_ac])+SUM([total_push_open_ios_lc])' />
