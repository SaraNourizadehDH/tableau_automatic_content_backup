            </column>
            <column caption='(ZN(SUM([Total Delivery Lc])) - LOOKUP(ZN(SUM([Total Delivery...' datatype='real' name='[Calculation_100838421355135035]' role='measure' type='quantitative' user:unnamed='% Trend - G - Total LC Sends'>
              <calculation class='tableau' formula='(ZN(SUM([total_delivery_lc])) - LOOKUP(ZN(SUM([total_delivery_lc])), -1)) / ABS(LOOKUP(ZN(SUM([total_delivery_lc])), -1))'>
                <table-calc ordering-type='Rows' />
