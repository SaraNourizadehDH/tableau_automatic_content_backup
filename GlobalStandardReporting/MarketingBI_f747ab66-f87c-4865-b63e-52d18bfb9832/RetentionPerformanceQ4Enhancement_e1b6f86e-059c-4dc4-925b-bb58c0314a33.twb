            <customized-tooltip>
              <formatted-text>
                <run bold='true'>GCG Version:</run>
                <run>&#10;- </run>
                <run bold='true'>CRM 1.0 </run>
                <run>Æ&#10;</run>
                <run bold='true' fontsize='9'>Total Actice User : </run>
                <run fontsize='9'>User who placed an order for the first time in the past </run>
                <run bold='true' fontsize='9'>one year</run>
                <run fontsize='9'> and created their profile since 23 Feb 2022 (Initated GCG feature implemented) and reachable in reporting month</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontsize='9'>Scenario :</run>
                <run>Æ&#10;</run>
                <run bold='true' fontsize='9'>On Jan 2024 Order Report total active user come from user who placed and order within Jan 23 - Dec 23 , and their profile created since 22 Feb 2022 and Reachable on Jan 24, </run>
                <run>&#10;&#10;- </run>
                <run bold='true'>CRM 2.0 : </run>
                <run>Æ&#10;</run>
                <run bold='true' fontsize='9'>Total Actice User : </run>
                <run fontsize='9'>User who created their profile and placed an order for the first time in the past </run>
                <run bold='true' fontsize='9'>7 months</run>
                <run fontsize='9'> and reachable in reporting month</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontsize='9'>Scenario :</run>
                <run>Æ&#10;</run>
                <run bold='true' fontsize='9'>On May 2024 Order Report total active user come from user who created their profile (register) and placed an order within Jan 23 - Dec 23,</run>
                <run>Æ&#10;</run>
              </formatted-text>
            </customized-tooltip>
