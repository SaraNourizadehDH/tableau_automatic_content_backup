        <calculation class='tableau' formula='SUM([tg_order_month])/sum([tg_cust_month])' />
      </column>
      <column caption='Orders_per_cust_GCG' datatype='real' name='[Calculation_675891856488378371]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gcg_order_month])/SUM([gcg_cust_month])' />
      </column>
      <column caption='Freq. Uplift %' datatype='real' name='[Calculation_675891856488820740]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_675891856487727105] / [Calculation_675891856488230914]' />
      </column>
      <column caption='Incr. orders #' datatype='real' name='[Calculation_675891856491171845]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([tg_order_month])/SUM([tg_cust_month]) - SUM([gcg_order_month])/SUM([gcg_cust_month])) * SUM([tg_cust_month])' />
      </column>
      <column caption='Incr. Orders %' datatype='real' name='[Calculation_675891856503660556]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_675891856491171845])/SUM([tg_order_month])' />
      </column>
      <column caption='GMV Uplift %' datatype='real' name='[Calculation_675891856508542989]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_675891791177891869]) / sum([tg_gmv_eur_month])' />
