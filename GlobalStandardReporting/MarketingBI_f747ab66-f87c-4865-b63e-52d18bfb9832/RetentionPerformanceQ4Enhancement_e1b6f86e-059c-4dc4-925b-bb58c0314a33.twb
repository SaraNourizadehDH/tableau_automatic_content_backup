      <column caption='Read Me' datatype='string' name='[Calculation_6811835239052685312]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Read Me&quot;' />
      </column>
      <column caption='RM - EP All Recipent' datatype='integer' name='[Calculation_781656076773974016]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [date_month]=[Parameters].[Parameter 3] AND [campaign_vertical] = &quot;0. All&quot; then [total_recipients_push_email] END' />
      </column>
      <column caption='MOM - EP All Recipients' datatype='real' name='[Calculation_781656076783693827]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((SUM([Calculation_781656076773974016]) - SUM(IF [campaign_vertical]=&quot;0. All&quot; and [date_month]=DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 3]) then [total_recipients_push_email] END))&#10;/SUM(IF [campaign_vertical]=&quot;0. All&quot; and [date_month]=DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 3]) then [total_recipients_push_email] END))' />
      </column>
