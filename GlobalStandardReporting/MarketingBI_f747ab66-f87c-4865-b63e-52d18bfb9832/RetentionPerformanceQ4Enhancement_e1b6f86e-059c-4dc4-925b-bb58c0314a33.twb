      </column>
      <column caption='Contact Frequency QC RM' datatype='real' name='[Contact Frequency RM (copy)_4651585133742198820]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM (IF [date_month]=[Parameters].[Parameter 3] and [campaign_vertical]=&quot;QC&quot; then [total_delivery] END)&#10;/&#10;SUM (IF [date_month]=[Parameters].[Parameter 3] and [campaign_vertical]=&quot;ALL&quot; then [total_recipients_push_email] END)' />
      </column>
      <column caption='Total Users  RM' datatype='integer' name='[Contact Frequency RM (copy)_4651585133992988710]' role='measure' type='quantitative'>
