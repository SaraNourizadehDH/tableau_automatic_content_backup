    <worksheet name='Retention Northstar All KPI - Brand Level (2)'>
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Retetention Performance' name='Staging Trial (local copy) | Project : Marketing BI (local copy)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Brand Segment' caption='Northstar View' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Brand Seg&quot;'>
              <calculation class='tableau' formula='&quot;Brand Seg&quot;' />
              <aliases>
                <alias key='&quot;Brand&quot;' value='Brand' />
                <alias key='&quot;Brand Seg&quot;' value='Brand Segment' />
                <alias key='&quot;Country &quot;' value='Country' />
                <alias key='&quot;Country Seg&quot;' value='Country Segment' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='Staging Trial (local copy) | Project : Marketing BI (local copy)'>
            <column caption='Cost Per User' datatype='real' name='[Calculation_100838421258764288]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([voucher_eur])/SUM([cust_month])' />
            </column>
            <column caption='Basket Value' datatype='real' name='[Calculation_100838421268033546]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gbv_eur])/SUM([orders_month])' />
            </column>
            <column caption='Group' datatype='string' name='[Calculation_18788511551684611]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_gcg] = 1 THEN &quot;GCG&quot; ELSE &quot;TG&quot; END' />
            </column>
            <column caption='Frequency' datatype='real' name='[Calculation_349099360917381122]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_month])/SUM([cust_month])' />
            </column>
            <column caption='Filter Northstar View' datatype='string' name='[Calculation_6505871932034596864]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 6]' />
            </column>
            <column caption='Country Name  (N)' datatype='string' name='[Calculation_6505871932038885378]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = &quot;Brand&quot; THEN &quot;-&quot; ELSE [country_name] END' />
            </column>
            <column caption='ROI' datatype='real' name='[ROI RM (copy)_100838421261398018]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//IF [Reporting month (p)]&lt;DATE(&quot;2024-01-01&quot;) then null else  ([ST  iGMV RM]+[incr HVA ROI RM ])/ [incr Cost ROI RM] end&#10;SUM([incr_gmv] + [incr_hva])/SUM([incr_cost])' />
            </column>
            <column datatype='real' name='[activation_month]' role='measure' type='quantitative' />
            <column datatype='integer' name='[activation_significancy]' role='measure' type='quantitative' />
            <column datatype='real' name='[activation_uplift]' role='measure' type='quantitative' />
            <column caption='Brand' datatype='string' name='[brand]' role='dimension' type='nominal' />
            <column caption='Clv Eur Month' datatype='real' name='[clv_eur_month]' role='dimension' type='quantitative' />
            <column datatype='integer' name='[clv_significancy]' role='measure' type='quantitative' />
            <column datatype='real' name='[clv_uplift]' role='measure' type='quantitative' />
            <column caption='Cost Significancy' datatype='integer' datatype-customized='true' name='[cost_significancy]' role='dimension' type='ordinal' />
            <column datatype='real' name='[cost_uplift]' role='measure' type='quantitative' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <aliases>
