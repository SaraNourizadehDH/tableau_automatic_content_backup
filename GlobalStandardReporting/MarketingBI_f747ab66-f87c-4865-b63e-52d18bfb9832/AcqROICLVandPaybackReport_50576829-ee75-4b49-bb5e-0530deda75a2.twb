      <column caption='CLV of Year' datatype='real' name='[Calculation_2420403363539996672]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;1 Year CLV&quot; THEN [first_year_clv]&#13;&#10;WHEN &quot;3 Year CLV&quot; THEN [third_year_clv]&#13;&#10;WHEN &quot;5 Year CLV&quot; THEN [fifth_year_clv]&#13;&#10;WHEN &quot;10 Year CLV&quot; THEN [tenth_year_clv] &#13;&#10;END' />
      </column>
