      <aliases enabled='yes' />
      <column caption='Over-forecast Orders %' datatype='real' default-format='p0%' name='[-Ve Delta Orders (copy)_2331035037491281921]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [orders_day_delta] &lt; 0 THEN&#10;[orders_day_delta]&#10;ELSE NULL END' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1ll7n0h0dhinh51a9s3my187si30].[avg:target_units_utr:qk]&quot;' value='Target Units Utr' />
          <alias key='&quot;[federated.1ll7n0h0dhinh51a9s3my187si30].[usr:Model compliance (copy)_7034200435291131908:vtavg:qk]&quot;' value='Order Forecast Accuracy rate' />
        </aliases>
      </column>
      <column caption='AT Peak (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[AT (min) (copy)_1244400883154857986]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sum_at_peak]) / SUM([orders_excl_preorder_with_at_peak])' />
      </column>
      <column caption='Picking Time Actual' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[AT (min) (copy)_2057511774827188224]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([picking_time_seconds]) / SUM([orders])' />
      </column>
      <column caption='Assigned Shifts from SOS Shifts' datatype='real' name='[Assigned Shifts (copy)_5212142537417101314]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[sos_shifts_day]/24' />
      </column>
      <column caption='Avg Basket Size - Actual' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg SKU per Order - Actual (copy)_1252493281290940416]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([units_outbound])/ SUM([orders])' />
      </column>
      <column caption='AT (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Baseline AT (copy)_6734288821562212355]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sum_at]) / SUM([orders_excl_preorder])' />
      </column>
      <column caption='UTR+' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Baseline Inbound-Outbound UTR (copy)_6734288821576409093]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([units_inbound_outbound]) / SUM([mhs_actual])' />
      </column>
      <column caption='Units UTR' datatype='real' name='[Baseline Units UTR (copy)_6734288821576048644]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([units_outbound]) / SUM([mhs_actual])' />
      </column>
      <column caption='Date Granularity' datatype='datetime' datatype-customized='true' name='[Calculation_1788492015365472256]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;WHEN &apos;hour&apos; THEN DATETIME([shift_ts])&#10;WHEN &apos;day&apos; THEN (DATE(DATETRUNC(&apos;day&apos;, [shift_date])) )&#10;WHEN &apos;week&apos; THEN (DATETRUNC(&apos;week&apos;, [shift_date]))&#10;WHEN &apos;month&apos; THEN (DATETRUNC(&apos;month&apos;, [shift_date]))&#10;END' />
      </column>
      <column caption='Check Model' datatype='string' name='[Calculation_2946268999919403011]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF  [Delta Orders (copy)_3538281215359561728] = (&apos;less&apos;) &#10;OR [Delta Orders (copy)_3538281215359561728] = &apos;more&apos;&#10;OR ([Delta Orders (copy)_3538281215359561728] = &apos;equal&apos; &#10;   AND [Calculation_3538281215729995778] = &apos;equal&apos;&#10;   AND [Calculation_3538281215732457475] = &apos;bad&apos; )&#10;OR ([Delta Orders (copy)_3538281215359561728] = &apos;equal&apos; &#10;   AND [Calculation_3538281215729995778] = &apos;equal&apos;&#10;   AND [Units UTR checker (copy)_3538281215755608068] = &apos;bad&apos;)&#10;OR ([Delta Orders (copy)_3538281215359561728] = &apos;equal&apos; &#10;   AND [Calculation_3538281215729995778] = &apos;less&apos;&#10;   AND [Calculation_3538281215732457475] = &apos;good&apos; &#10;    AND [Units UTR checker (copy)_3538281215755608068] = &apos;good&apos;)&#10;THEN &apos;CHECK&apos; ELSE &apos;OK&apos; END' />
      </column>
