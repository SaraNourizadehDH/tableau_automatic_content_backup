    <worksheet name='correlation CO delta - MHS (DEV)'>
      <layout-options>
        <title>
          <formatted-text>
            <run>&lt;Sheet Name&gt;&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Regular' fontsize='10'>MHS Day Deviation</run>
            <run fontcolor='#000000' fontname='Tableau Regular' fontsize='10'> = (mhs_day_actual - mhs_day_predicted) / mhs_day_predicted</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='10'>Delta Orders: </run>
            <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='10'>difference in % between Orders - Predicted and Orders - Actual, as: ( Orders Actual - Orders Predicted) / Orders Actual * 100</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Regular' fontsize='10'>excl. August 2023, as CO forecast in intermidiate tables are not accurate</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location id='correlationCOdelta-MHSdev' path='/t/GlobalStandardReporting/workbooks/PickerSchedulingKPIDashboard' revision='' site='GlobalStandardReporting' />
      <table>
        <view>
          <datasources>
            <datasource caption='wfm_kpis_report (picker_scheduling_prod)' name='federated.1ll7n0h0dhinh51a9s3my187si30' />
          </datasources>
          <datasource-dependencies datasource='federated.1ll7n0h0dhinh51a9s3my187si30'>
            <column caption='Units UTR' datatype='real' name='[Baseline Units UTR (copy)_6734288821576048644]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([units_outbound]) / SUM([mhs_actual])' />
            </column>
            <column caption='Delta Orders' datatype='real' default-format='p0.0%' name='[Delta DT (copy)_3509570756897918976]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders]) / SUM([orders_predicted]) - 1' />
            </column>
            <column-instance column='[warehouse_name]' derivation='Attribute' name='[attr:warehouse_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[mhs_day_deviation]' derivation='Avg' name='[avg:mhs_day_deviation:qk]' pivot='key' type='quantitative' />
