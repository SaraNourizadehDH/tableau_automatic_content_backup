    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Definitions'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/PickerSchedulingKPIDashboard/Definitions?rev=' id='Definitions' path='/t/GlobalStandardReporting/workbooks/PickerSchedulingKPIDashboard-Suhardya' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='2405' maxwidth='1300' minheight='2405' minwidth='1300' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='15967' id='3' type-v2='text' w='98770' x='615' y='12931'>
            <formatted-text>
              <run bold='true' fontcolor='#333333' fontname='Tableau Regular' fontsize='12'>MASTER DASHBOARD</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#333333' fontname='Tableau Regular'>Unit UTR </run>
              <run fontcolor='#333333' fontname='Tableau Regular'>(also = Picker Item UTR) =  Utilization Rate, computed as: Outbound Units / MHS</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#333333' fontname='Tableau Regular'>UTR+ </run>
              <run fontcolor='#333333' fontname='Tableau Regular'>(also = Inbound-Outbound UTR</run>
              <run bold='true' fontcolor='#333333' fontname='Tableau Regular'>)</run>
              <run fontcolor='#333333' fontname='Tableau Regular'> = ( Inbound Units + Outbound Units ) / MHS</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontname='Tableau Regular'>Where:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontname='Tableau Regular'> - Outbound Units: Quantity of items delivered to the customers as part of Customer Orders (should be the same as Units ordered, unless partial fulfillment of the order i.e. due to out-of-stock SKUs)</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontname='Tableau Regular'> -Inbound Units : Quantity of items received from the suppliers and DCs as part of POs and Store transfers</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontname='Tableau Regular'> - MHS: Man-hours: #Pickers * #Hours worked</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#333333' fontname='Tableau Regular'>Delta Unit UTR =</run>
              <run fontcolor='#333333' fontname='Tableau Regular'>  difference between Units UTR and baseline Units UTR</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#333333' fontname='Tableau Regular'>Delta UTR+ =</run>
              <run fontcolor='#333333' fontname='Tableau Regular'>  difference between UTR+ and baseline UTR+</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#333333' fontname='Tableau Regular'>Assigment Time</run>
              <run fontcolor='#333333' fontname='Tableau Regular'> (m) = AT excl. preorder / COs excl. preorder</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontname='Tableau Regular'>Where:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontname='Tableau Regular'> - (m): Assigment time shown in minutes</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontname='Tableau Regular'> - COs excl. preorder: Total successful Customer Orders, excluding the preorders.  </run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontname='Tableau Regular'> - AT excl. preorder: Summation of Individual AT(s) of all the successful COs (excl. preorders) where individual AT can be defined as the time difference between the following two events:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontname='Tableau Regular'>       1) CO ready to be assigned in the Pelican app </run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontname='Tableau Regular'>       2) Picker gets assigned to the CO</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#333333' fontname='Tableau Regular'>Delta AT =</run>
              <run fontcolor='#333333' fontname='Tableau Regular'>  difference between AT and baseline AT</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#333333'>ODS</run>
              <run fontcolor='#333333'> = Average  daily Successful Orders per Store of past 30 days</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
              <format attr='background-color' value='#f5f5f5' />
            </zone-style>
          </zone>
          <zone h='3908' id='23' is-centered='0' is-scaled='1' param='Image/Q-Commerce_Team-Logo_WhiteBG.png' type-v2='bitmap' w='18174' x='81211' y='333'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='3908' id='24' type-v2='text' w='61830' x='19381' y='333'>
            <formatted-text>
              <run bold='true' fontalignment='1' fontcolor='#e00012' fontname='Tableau Bold' fontsize='18'>Definitions</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone h='3908' id='25' type-v2='empty' w='18766' x='615' y='333'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='6944' id='158' type-v2='text' w='98770' x='615' y='4241'>
            <formatted-text>
              <run bold='true' fontcolor='#333333' fontname='Tableau Regular' fontsize='10'>The Picker Scheduling Optimization Model</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#333333' fontname='Tableau Regular'>The Store Operations Data Science Team (SOS) built a linear optimization model that recommends the optimal number of shifts for a given weekday, and the optimal number of pickers required for that shift.</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontname='Tableau Regular'>For the optimization, the model primarily takes into account the computation of historical Men Hours demand and all possible shifts in a given warehouse, along with some additional manual business inputs related to the activities carried out by the pickers in the warehouse.</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#333333' fontname='Tableau Regular'>Baseline</run>
              <run fontcolor='#333333' fontname='Tableau Regular'> = is considered as the avg value of the KPI, that has been recorded in the 12 months prior rollout/adoption date in that specific country. This is constant for all the warehouses in the country. </run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#333333' fontname='Tableau Regular'>Target</run>
              <run fontcolor='#333333' fontname='Tableau Regular'>: is the goal set in the country for the given period for all the warehouses in a given country</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
              <format attr='background-color' value='#f5f5f5' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='1746' id='159' type-v2='text' w='98770' x='615' y='11185'>
            <formatted-text>
              <run bold='true' fontalignment='1' fontcolor='#e00012' fontname='Tableau Bold' fontsize='16'>KPI Glossary</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='34387' id='428' type-v2='text' w='98770' x='615' y='38628'>
            <formatted-text>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='12'>FORECAST ACCURACY</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Orders - Predicted : </run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular'>Nr. of orders predicted by the model for a certain Dmart/period</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Orders - Actual: </run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular'>Nr. of orders placed in a certain Dmart/period</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Delta Orders (Aggregated): </run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular'>difference in % between total </run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Orders - Predicted</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular'> and total </run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Orders - Actual</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular'>, of the selected period, as: ( Orders - Actual - Orders Predicted) / Orders Actual * 100</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Under-forecast Orders %: </run>
              <run fontcolor='#000000' fontname='Tableau Regular'><![CDATA[average value of Delta Orders Day, for the days in which Delta Orders is < 0 (meaning SOS predicted lower Orders than the actual)]]></run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Over-forecast Orders %: </run>
              <run fontcolor='#000000' fontname='Tableau Regular'>average value of Delta Orders Day, for the days in which Delta Orders is &gt; 0 (meaning SOS predicted higher Orders than the actual)</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Picking Time/Order - Predicted: </run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular'>Average Picking Time per Order predicted by the model for a certain Dmart/period</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Picking Time/Order - Actual: </run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular'>Average Picking Time per Order in a certain Dmart/period</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Delta Picking Time/Order:</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular'> difference in % between Picking Time/Order - Predicted and Picking Time/Order - Actual, as: ( Picking Time/Order - Actual - Picking Time/Order - Predicted) / Picking Time/Order - Actual * 100</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Avg Basket Size - Actual: </run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular'>Average number of Units outbounded per Order in a certain Country/Dmart/period</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>#SKUs Received PO - Predicted: </run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular'>Nr. of SKUs predicted by the model to be received via Purchase order in a certain Dmart/period</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>#SKUs Received PO - Actual: </run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular'>Nr. of SKUs received via Purchase Order in a certain Dmart/period</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Delta #SKUs Received PO: </run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular'>difference in % between #SKUs Received PO - Predicted and #SKUs Received PO - Actual, as: ( #SKUs Received PO - Actual - #SKUs Received PO - Predicted) / #SKUs Received PO - Actual * 100</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Receiving Time/SKU PO - Predicted: </run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular'>Average Receiving Time per SKU received via Purchase Order predicted by the model for a certain Dmart/period</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Receiving Time/SKU PO - Actual: </run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular'>Average Receiving Time per SKU received via Purchase Order in a certain Dmart/period</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Delta Receiving Time/SKU PO: </run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular'>difference in % between Receiving Time/SKU PO - Predicted and Receiving Time/SKU PO - Actual, as: ( Receiving Time/SKU PO - Actual - Receiving Time/SKU PO - Predicted) / Receiving Time/SKU PO - Actual * 100</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>#SKUs Received ST - Predicted: </run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular'>Nr. of SKUs predicted by the model to be received via Store Transfer in a certain Dmart/period</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>#SKUs Received ST - Actual: </run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular'>Nr. of SKUs received via Store Transfer in a certain Dmart/period</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Delta #SKUs Received ST: </run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular'>difference in % between #SKUs Received ST - Predicted and #SKUs Received ST - Actual, as: ( #SKUs Received ST - Actual - #SKUs Received ST - Predicted) / #SKUs Received ST - Actual * 100</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Receiving Time/SKU ST - Predicted: </run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular'>Average Receiving Time per SKU received via Store Transfer predicted by the model for a certain Dmart/period</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Receiving Time/SKU ST - Actual: </run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular'>Average Receiving Time per SKU received via Store Transfer in a certain Dmart/period</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Delta Receiving Time/SKU ST: </run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular'>difference in % between Receiving Time/SKU ST - Predicted and Receiving Time/SKU ST - Actual, as: ( Receiving Time/SKU ST - Actual - Receiving Time/SKU ST - Predicted) / Receiving Time/SKU ST - Actual * 100</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>SKU cycle count - Predicted: </run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular'>Nr. of SKUs predicted by the model to be undergoing Cycle count in a certain Dmart/period</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>SKU cycle count - Actual: </run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular'>Nr. of SKUs undergoing Cycle count in a certain Dmart/period</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Delta SKU cycle count: </run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular'>difference in % between SKU cycle count - Predicted and SKU cycle count - Actual, as: ( SKU cycle count - Actual - SKU cycle count - Predicted) / SKU cycle count - Actual * 100</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>CC Time/SKU - Predicted: </run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular'>Average Cycle Count Time per SKU predicted by the model for a certain Dmart/period</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>MHS Predicted: </run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular'>Men Hours recommended by Picker Optimiazion Model</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>MHS Actual: </run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular'>Actual Men Hours worked on ground (incl. overtime, pickers starting late)</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Delta MHS %: </run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular'>difference in % between MHS Predicted and MHS Actual</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Æ </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Target Unit UTR:</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular'> is the goal Unit UTR set in the country for a specific month of the current year for all the warehouses in a given country</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Units UTR: </run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular'>(also &quot;Picker Item UTR&quot;) = Outbound Units / MHS</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Delta Units UTR - Target: </run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular'>difference in % between Units UTR and Target Unit UTR</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Threshold AT (min): </run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular'>is the acceptable threshold in Average Assignment Time per Order set in the country for the current year. It is the same value for all the warehouses in a given country</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>AT (min): </run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular'>AT excl. preorder / COs excl. preorder</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Delta AT - Threshold: </run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular'>difference in % between AT (min) and Threshold AT (min)</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Threshold AT Peak (min): </run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular'>is the acceptable threshold in Average Assignment Time per Order in Peak Hours, set in the country for the current year. It is the same value for all the warehouses in a given country</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>AT Peak (min): </run>
              <run fontcolor='#333333' fontname='Tableau Regular'> Assignment time excl. preorder in Peak hours / COs excl. preorder in Peak hours, where:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontname='Tableau Regular'> - (m): Assigment time shown in minutes</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontname='Tableau Regular'> - COs excl. preorder in Peak hours: Total successful Customer Orders, excluding the preorders being placed in the peak hours.  </run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontname='Tableau Regular'> - AT excl. preorder in Peak hours: Summation of Individual AT(s) of all the successful COs (excl. preorders) being placed in the peak hours where individual AT can be defined as the time difference between the following two events:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontname='Tableau Regular'>       1) CO ready to be assigned in the Pelican app </run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontname='Tableau Regular'>       2) Picker gets assigned to the CO</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Delta AT Peak - Threshold: </run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular'>difference in % between AT Peak (min) and Threshold AT Peak (min)</run>
              <run>Æ&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
              <format attr='background-color' value='#f5f5f5' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='9730' id='467' type-v2='text' w='98770' x='615' y='28898'>
            <formatted-text>
              <run bold='true' fontcolor='#333333' fontname='Tableau Regular' fontsize='12'>SHIFT DEVIATION</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#333333' fontname='Tableau Regular'>MHS Predicted</run>
              <run fontcolor='#333333' fontname='Tableau Regular'>: MHS recommended by SOS Schedule</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#333333' fontname='Tableau Regular'>MHS Actua</run>
              <run fontcolor='#333333' fontname='Tableau Regular'>l: Actual MHS worked on ground (incl. overtime, pickers starting late)</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Regular'>Delta MHS %</run>
              <run fontcolor='#000000' fontname='Tableau Regular'>: difference in % between MHS Predicted and MHS Actual </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Regular'>Delta MHS (ABS)</run>
              <run fontcolor='#000000' fontname='Tableau Regular'>: average Deviation from recommended Daily #MHS in absolute value: AVG(ABS(MHS Day Deviation))</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Regular'>Where:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Regular'>MHS Day Deviation = (mhs_day_actual - mhs_day_predicted) / mhs_day_predicted</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Regular'>-ve Deviation MHS</run>
              <run fontcolor='#000000' fontname='Tableau Regular'><![CDATA[: average value of MHS Day Deviation, for the days in which this is < 0 (meaning SOS predicted higher MHS than what has been actually implemented)]]></run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Regular'>+ve Deviation MHS</run>
              <run fontcolor='#000000' fontname='Tableau Regular'>: average value of MHS Day Deviation, for the days in which this is &gt; 0 (meaning SOS predicted lower MHS than what has been actually implemented) </run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
              <format attr='background-color' value='#f5f5f5' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='18212' id='610' type-v2='text' w='98770' x='615' y='73015'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontname='Tableau Regular' fontsize='12'>COMPLIANCE CHECKER</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Forecast Orders Flag:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>- </run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>More</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'> if </run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>(</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'><![CDATA[Actual Orders - Predicted Orders) < -X * #DAYS in period]]></run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>- </run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Less</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'> if </run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>(</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Actual Orders - Predicted Orders) &gt; X * #DAYS in period</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>- </run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Equal</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'> if </run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>(</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Actual Orders - Predicted Orders) BETWEEN X * #DAYS in period AND -X * #DAYS in period</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Where X (Threshold order forecast error) is defined based on mechanism described in the following</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular'>Æ </run>
              <run fontcolor='#4996b2' fontname='Arial, sans-serif' fontsize='8' underline='true'>1-Pager</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Hours worked used:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>- </run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>More</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'> if </run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>(</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Actual MHS - Predicted MHS) &gt; 4MHS* #DAYS in period</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>- </run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Less</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'> if </run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>(</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'><![CDATA[Actual MHS - Predicted MHS) < -4MHS* #DAYS in period]]></run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>- </run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Equal</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'> if </run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>(</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Actual MHS - Predicted MHS) BETWEEN -(4MHS* #DAYS in period ) AND (4MHS* #DAYS in period)</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Productivity checker:</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>- good </run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>if Units UTR &gt;= Target Units UTR</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>- </run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>bad</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'> if Units</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Æ </run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>UTR &lt; Target Units UTR</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>AT checker:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>- </run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>good</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'> if AT &lt;= threshold</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>- </run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>bad</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'> if AT &gt; threshold </run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Input Forecast Accuracy Rate: </run>
              <run fontcolor='#1f1f1f' fontname='Tableau Regular' fontsize='8'>instances where we matched actuals (F[Forecast Orders Flag] = &apos;equal&apos;) /all instances</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Model Compliance: </run>
              <run fontcolor='#000000' fontname='Tableau Regular' fontsize='8'>cases where we matched actuals for Inputs &amp; where Hours worked matches model suggestion / cases where we matched actuals for Inputs</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Operational Compliance: </run>
              <run fontcolor='#000000' fontname='Tableau Regular' fontsize='8'>cases where Store has both good productivity and good Assignment time/ total istances</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
              <format attr='background-color' value='#f5f5f5' />
            </zone-style>
          </zone>
          <zone h='8440' id='721' type-v2='empty' w='98770' x='615' y='91227'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='783' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='84000' id='782' param='vert' type-v2='layout-flow' w='84000' x='8000' y='8000'>
                <zone forceUpdate='true' h='3908' id='24' type-v2='text' w='61830' x='19381' y='333'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontcolor='#e00012' fontname='Tableau Bold' fontsize='18'>Definitions</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='86' h='3908' id='23' is-centered='0' is-fixed='true' is-scaled='1' param='Image/Q-Commerce_Team-Logo_WhiteBG.png' type-v2='bitmap' w='18174' x='81211' y='333'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='6944' id='158' type-v2='text' w='98770' x='615' y='4241'>
                  <formatted-text>
                    <run bold='true' fontcolor='#333333' fontname='Tableau Regular' fontsize='10'>The Picker Scheduling Optimization Model</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#333333' fontname='Tableau Regular'>The Store Operations Data Science Team (SOS) built a linear optimization model that recommends the optimal number of shifts for a given weekday, and the optimal number of pickers required for that shift.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#333333' fontname='Tableau Regular'>For the optimization, the model primarily takes into account the computation of historical Men Hours demand and all possible shifts in a given warehouse, along with some additional manual business inputs related to the activities carried out by the pickers in the warehouse.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#333333' fontname='Tableau Regular'>Baseline</run>
                    <run fontcolor='#333333' fontname='Tableau Regular'> = is considered as the avg value of the KPI, that has been recorded in the 12 months prior rollout/adoption date in that specific country. This is constant for all the warehouses in the country. </run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#333333' fontname='Tableau Regular'>Target</run>
                    <run fontcolor='#333333' fontname='Tableau Regular'>: is the goal set in the country for the given period for all the warehouses in a given country</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#f5f5f5' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='1746' id='159' type-v2='text' w='98770' x='615' y='11185'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontcolor='#e00012' fontname='Tableau Bold' fontsize='16'>KPI Glossary</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='15967' id='3' type-v2='text' w='98770' x='615' y='12931'>
                  <formatted-text>
                    <run bold='true' fontcolor='#333333' fontname='Tableau Regular' fontsize='12'>MASTER DASHBOARD</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#333333' fontname='Tableau Regular'>Unit UTR </run>
                    <run fontcolor='#333333' fontname='Tableau Regular'>(also = Picker Item UTR) =  Utilization Rate, computed as: Outbound Units / MHS</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#333333' fontname='Tableau Regular'>UTR+ </run>
                    <run fontcolor='#333333' fontname='Tableau Regular'>(also = Inbound-Outbound UTR</run>
                    <run bold='true' fontcolor='#333333' fontname='Tableau Regular'>)</run>
                    <run fontcolor='#333333' fontname='Tableau Regular'> = ( Inbound Units + Outbound Units ) / MHS</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#333333' fontname='Tableau Regular'>Where:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#333333' fontname='Tableau Regular'> - Outbound Units: Quantity of items delivered to the customers as part of Customer Orders (should be the same as Units ordered, unless partial fulfillment of the order i.e. due to out-of-stock SKUs)</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#333333' fontname='Tableau Regular'> -Inbound Units : Quantity of items received from the suppliers and DCs as part of POs and Store transfers</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#333333' fontname='Tableau Regular'> - MHS: Man-hours: #Pickers * #Hours worked</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#333333' fontname='Tableau Regular'>Delta Unit UTR =</run>
                    <run fontcolor='#333333' fontname='Tableau Regular'>  difference between Units UTR and baseline Units UTR</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#333333' fontname='Tableau Regular'>Delta UTR+ =</run>
                    <run fontcolor='#333333' fontname='Tableau Regular'>  difference between UTR+ and baseline UTR+</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#333333' fontname='Tableau Regular'>Assigment Time</run>
                    <run fontcolor='#333333' fontname='Tableau Regular'> (m) = AT excl. preorder / COs excl. preorder</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#333333' fontname='Tableau Regular'>Where:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#333333' fontname='Tableau Regular'> - (m): Assigment time shown in minutes</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#333333' fontname='Tableau Regular'> - COs excl. preorder: Total successful Customer Orders, excluding the preorders.  </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#333333' fontname='Tableau Regular'> - AT excl. preorder: Summation of Individual AT(s) of all the successful COs (excl. preorders) where individual AT can be defined as the time difference between the following two events:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#333333' fontname='Tableau Regular'>       1) CO ready to be assigned in the Pelican app </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#333333' fontname='Tableau Regular'>       2) Picker gets assigned to the CO</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#333333' fontname='Tableau Regular'>Delta AT =</run>
                    <run fontcolor='#333333' fontname='Tableau Regular'>  difference between AT and baseline AT</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#333333'>ODS</run>
                    <run fontcolor='#333333'> = Average  daily Successful Orders per Store of past 30 days</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#f5f5f5' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='9730' id='467' type-v2='text' w='98770' x='615' y='28898'>
                  <formatted-text>
                    <run bold='true' fontcolor='#333333' fontname='Tableau Regular' fontsize='12'>SHIFT DEVIATION</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#333333' fontname='Tableau Regular'>MHS Predicted</run>
                    <run fontcolor='#333333' fontname='Tableau Regular'>: MHS recommended by SOS Schedule</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#333333' fontname='Tableau Regular'>MHS Actua</run>
                    <run fontcolor='#333333' fontname='Tableau Regular'>l: Actual MHS worked on ground (incl. overtime, pickers starting late)</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Regular'>Delta MHS %</run>
                    <run fontcolor='#000000' fontname='Tableau Regular'>: difference in % between MHS Predicted and MHS Actual </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Regular'>Delta MHS (ABS)</run>
                    <run fontcolor='#000000' fontname='Tableau Regular'>: average Deviation from recommended Daily #MHS in absolute value: AVG(ABS(MHS Day Deviation))</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Regular'>Where:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Regular'>MHS Day Deviation = (mhs_day_actual - mhs_day_predicted) / mhs_day_predicted</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Regular'>-ve Deviation MHS</run>
                    <run fontcolor='#000000' fontname='Tableau Regular'><![CDATA[: average value of MHS Day Deviation, for the days in which this is < 0 (meaning SOS predicted higher MHS than what has been actually implemented)]]></run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Regular'>+ve Deviation MHS</run>
                    <run fontcolor='#000000' fontname='Tableau Regular'>: average value of MHS Day Deviation, for the days in which this is &gt; 0 (meaning SOS predicted lower MHS than what has been actually implemented) </run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#f5f5f5' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='34387' id='428' type-v2='text' w='98770' x='615' y='38628'>
                  <formatted-text>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='12'>FORECAST ACCURACY</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Orders - Predicted : </run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular'>Nr. of orders predicted by the model for a certain Dmart/period</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Orders - Actual: </run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular'>Nr. of orders placed in a certain Dmart/period</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Delta Orders (Aggregated): </run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular'>difference in % between total </run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Orders - Predicted</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular'> and total </run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Orders - Actual</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular'>, of the selected period, as: ( Orders - Actual - Orders Predicted) / Orders Actual * 100</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Under-forecast Orders %: </run>
                    <run fontcolor='#000000' fontname='Tableau Regular'><![CDATA[average value of Delta Orders Day, for the days in which Delta Orders is < 0 (meaning SOS predicted lower Orders than the actual)]]></run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Over-forecast Orders %: </run>
                    <run fontcolor='#000000' fontname='Tableau Regular'>average value of Delta Orders Day, for the days in which Delta Orders is &gt; 0 (meaning SOS predicted higher Orders than the actual)</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Picking Time/Order - Predicted: </run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular'>Average Picking Time per Order predicted by the model for a certain Dmart/period</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Picking Time/Order - Actual: </run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular'>Average Picking Time per Order in a certain Dmart/period</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Delta Picking Time/Order:</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular'> difference in % between Picking Time/Order - Predicted and Picking Time/Order - Actual, as: ( Picking Time/Order - Actual - Picking Time/Order - Predicted) / Picking Time/Order - Actual * 100</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Avg Basket Size - Actual: </run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular'>Average number of Units outbounded per Order in a certain Country/Dmart/period</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>#SKUs Received PO - Predicted: </run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular'>Nr. of SKUs predicted by the model to be received via Purchase order in a certain Dmart/period</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>#SKUs Received PO - Actual: </run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular'>Nr. of SKUs received via Purchase Order in a certain Dmart/period</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Delta #SKUs Received PO: </run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular'>difference in % between #SKUs Received PO - Predicted and #SKUs Received PO - Actual, as: ( #SKUs Received PO - Actual - #SKUs Received PO - Predicted) / #SKUs Received PO - Actual * 100</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Receiving Time/SKU PO - Predicted: </run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular'>Average Receiving Time per SKU received via Purchase Order predicted by the model for a certain Dmart/period</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Receiving Time/SKU PO - Actual: </run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular'>Average Receiving Time per SKU received via Purchase Order in a certain Dmart/period</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Delta Receiving Time/SKU PO: </run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular'>difference in % between Receiving Time/SKU PO - Predicted and Receiving Time/SKU PO - Actual, as: ( Receiving Time/SKU PO - Actual - Receiving Time/SKU PO - Predicted) / Receiving Time/SKU PO - Actual * 100</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>#SKUs Received ST - Predicted: </run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular'>Nr. of SKUs predicted by the model to be received via Store Transfer in a certain Dmart/period</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>#SKUs Received ST - Actual: </run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular'>Nr. of SKUs received via Store Transfer in a certain Dmart/period</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Delta #SKUs Received ST: </run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular'>difference in % between #SKUs Received ST - Predicted and #SKUs Received ST - Actual, as: ( #SKUs Received ST - Actual - #SKUs Received ST - Predicted) / #SKUs Received ST - Actual * 100</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Receiving Time/SKU ST - Predicted: </run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular'>Average Receiving Time per SKU received via Store Transfer predicted by the model for a certain Dmart/period</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Receiving Time/SKU ST - Actual: </run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular'>Average Receiving Time per SKU received via Store Transfer in a certain Dmart/period</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Delta Receiving Time/SKU ST: </run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular'>difference in % between Receiving Time/SKU ST - Predicted and Receiving Time/SKU ST - Actual, as: ( Receiving Time/SKU ST - Actual - Receiving Time/SKU ST - Predicted) / Receiving Time/SKU ST - Actual * 100</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>SKU cycle count - Predicted: </run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular'>Nr. of SKUs predicted by the model to be undergoing Cycle count in a certain Dmart/period</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>SKU cycle count - Actual: </run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular'>Nr. of SKUs undergoing Cycle count in a certain Dmart/period</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Delta SKU cycle count: </run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular'>difference in % between SKU cycle count - Predicted and SKU cycle count - Actual, as: ( SKU cycle count - Actual - SKU cycle count - Predicted) / SKU cycle count - Actual * 100</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>CC Time/SKU - Predicted: </run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular'>Average Cycle Count Time per SKU predicted by the model for a certain Dmart/period</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>MHS Predicted: </run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular'>Men Hours recommended by Picker Optimiazion Model</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>MHS Actual: </run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular'>Actual Men Hours worked on ground (incl. overtime, pickers starting late)</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Delta MHS %: </run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular'>difference in % between MHS Predicted and MHS Actual</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Æ </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Target Unit UTR:</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular'> is the goal Unit UTR set in the country for a specific month of the current year for all the warehouses in a given country</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Units UTR: </run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular'>(also &quot;Picker Item UTR&quot;) = Outbound Units / MHS</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Delta Units UTR - Target: </run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular'>difference in % between Units UTR and Target Unit UTR</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Threshold AT (min): </run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular'>is the acceptable threshold in Average Assignment Time per Order set in the country for the current year. It is the same value for all the warehouses in a given country</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>AT (min): </run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular'>AT excl. preorder / COs excl. preorder</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Delta AT - Threshold: </run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular'>difference in % between AT (min) and Threshold AT (min)</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Threshold AT Peak (min): </run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular'>is the acceptable threshold in Average Assignment Time per Order in Peak Hours, set in the country for the current year. It is the same value for all the warehouses in a given country</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>AT Peak (min): </run>
                    <run fontcolor='#333333' fontname='Tableau Regular'> Assignment time excl. preorder in Peak hours / COs excl. preorder in Peak hours, where:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#333333' fontname='Tableau Regular'> - (m): Assigment time shown in minutes</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#333333' fontname='Tableau Regular'> - COs excl. preorder in Peak hours: Total successful Customer Orders, excluding the preorders being placed in the peak hours.  </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#333333' fontname='Tableau Regular'> - AT excl. preorder in Peak hours: Summation of Individual AT(s) of all the successful COs (excl. preorders) being placed in the peak hours where individual AT can be defined as the time difference between the following two events:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#333333' fontname='Tableau Regular'>       1) CO ready to be assigned in the Pelican app </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#333333' fontname='Tableau Regular'>       2) Picker gets assigned to the CO</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular'>Delta AT Peak - Threshold: </run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular'>difference in % between AT Peak (min) and Threshold AT Peak (min)</run>
                    <run>Æ&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#f5f5f5' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='18212' id='610' type-v2='text' w='98770' x='615' y='73015'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Regular' fontsize='12'>COMPLIANCE CHECKER</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Forecast Orders Flag:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>- </run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>More</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'> if </run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>(</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'><![CDATA[Actual Orders - Predicted Orders) < -X * #DAYS in period]]></run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>- </run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Less</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'> if </run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>(</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Actual Orders - Predicted Orders) &gt; X * #DAYS in period</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>- </run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Equal</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'> if </run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>(</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Actual Orders - Predicted Orders) BETWEEN X * #DAYS in period AND -X * #DAYS in period</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Where X (Threshold order forecast error) is defined based on mechanism described in the following</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular'>Æ </run>
                    <run fontcolor='#4996b2' fontname='Arial, sans-serif' fontsize='8' underline='true'>1-Pager</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Hours worked used:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>- </run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>More</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'> if </run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>(</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Actual MHS - Predicted MHS) &gt; 4MHS* #DAYS in period</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>- </run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Less</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'> if </run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>(</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'><![CDATA[Actual MHS - Predicted MHS) < -4MHS* #DAYS in period]]></run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>- </run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Equal</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'> if </run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>(</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Actual MHS - Predicted MHS) BETWEEN -(4MHS* #DAYS in period ) AND (4MHS* #DAYS in period)</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Productivity checker:</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>- good </run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>if Units UTR &gt;= Target Units UTR</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>- </run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>bad</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'> if Units</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Æ </run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>UTR &lt; Target Units UTR</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>AT checker:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>- </run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>good</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'> if AT &lt;= threshold</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>- </run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>bad</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'> if AT &gt; threshold </run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Input Forecast Accuracy Rate: </run>
                    <run fontcolor='#1f1f1f' fontname='Tableau Regular' fontsize='8'>instances where we matched actuals (F[Forecast Orders Flag] = &apos;equal&apos;) /all instances</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Model Compliance: </run>
                    <run fontcolor='#000000' fontname='Tableau Regular' fontsize='8'>cases where we matched actuals for Inputs &amp; where Hours worked matches model suggestion / cases where we matched actuals for Inputs</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Operational Compliance: </run>
                    <run fontcolor='#000000' fontname='Tableau Regular' fontsize='8'>cases where Store has both good productivity and good Assignment time/ total istances</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#f5f5f5' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
      <simple-id uuid='{FD488D3A-2E43-43A8-A448-04E072DE12BA}' />
    </dashboard>
    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Feedback Dash'>
