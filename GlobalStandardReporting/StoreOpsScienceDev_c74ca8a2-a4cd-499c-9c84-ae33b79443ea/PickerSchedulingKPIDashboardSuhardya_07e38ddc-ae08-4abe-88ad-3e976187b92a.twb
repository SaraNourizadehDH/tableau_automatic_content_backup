  <worksheets>
    <worksheet name='Compliance Checker (data)'>
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='wfm_kpis_report (picker_scheduling_prod)' name='federated.1ll7n0h0dhinh51a9s3my187si30' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Weekly' caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
              <calculation class='tableau' formula='&quot;week&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ll7n0h0dhinh51a9s3my187si30'>
            <column caption='AT (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Baseline AT (copy)_6734288821562212355]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_at]) / SUM([orders_excl_preorder])' />
            </column>
            <column caption='Units UTR' datatype='real' name='[Baseline Units UTR (copy)_6734288821576048644]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([units_outbound]) / SUM([mhs_actual])' />
            </column>
            <column caption='Date Granularity' datatype='datetime' datatype-customized='true' name='[Calculation_1788492015365472256]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;WHEN &apos;hour&apos; THEN DATETIME([shift_ts])&#10;WHEN &apos;day&apos; THEN (DATE(DATETRUNC(&apos;day&apos;, [shift_date])) )&#10;WHEN &apos;week&apos; THEN (DATETRUNC(&apos;week&apos;, [shift_date]))&#10;WHEN &apos;month&apos; THEN (DATETRUNC(&apos;month&apos;, [shift_date]))&#10;END' />
            </column>
            <column caption='Check Model' datatype='string' name='[Calculation_2946268999919403011]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF  [Delta Orders (copy)_3538281215359561728] = (&apos;less&apos;) &#10;OR [Delta Orders (copy)_3538281215359561728] = &apos;more&apos;&#10;OR ([Delta Orders (copy)_3538281215359561728] = &apos;equal&apos; &#10;   AND [Calculation_3538281215729995778] = &apos;equal&apos;&#10;   AND [Calculation_3538281215732457475] = &apos;bad&apos; )&#10;OR ([Delta Orders (copy)_3538281215359561728] = &apos;equal&apos; &#10;   AND [Calculation_3538281215729995778] = &apos;equal&apos;&#10;   AND [Units UTR checker (copy)_3538281215755608068] = &apos;bad&apos;)&#10;OR ([Delta Orders (copy)_3538281215359561728] = &apos;equal&apos; &#10;   AND [Calculation_3538281215729995778] = &apos;less&apos;&#10;   AND [Calculation_3538281215732457475] = &apos;good&apos; &#10;    AND [Units UTR checker (copy)_3538281215755608068] = &apos;good&apos;)&#10;THEN &apos;CHECK&apos; ELSE &apos;OK&apos; END' />
            </column>
            <column caption='Hours worked used' datatype='string' name='[Calculation_3538281215729995778]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF     [Delta MHS (ABS) (copy)_3538281215651688449]&gt; (4*[Calculation_3538281216836194320]) THEN &apos;more&apos; &#10;ELSEIF [Delta MHS (ABS) (copy)_3538281215651688449]&lt; -(4*[Calculation_3538281216836194320]) THEN &apos;less&apos; &#10;ELSE &apos;equal&apos; END' />
            </column>
            <column caption='Productivity checker' datatype='string' name='[Calculation_3538281215732457475]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Baseline Units UTR (copy)_6734288821576048644] &gt;= AVG([target_units_utr]) THEN &apos;good&apos; &#10;ELSE &apos;bad&apos; END' />
            </column>
            <column caption='Productivity &amp; Serviceability compliance?' datatype='string' name='[Calculation_3538281216801968142]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_3538281215732457475] = &apos;bad&apos; OR [Units UTR checker (copy)_3538281215755608068] = &apos;bad&apos; &#10;THEN &apos;CHECK&apos; &#10;ELSE &apos;OK&apos;&#10;END' />
            </column>
            <column caption='Check with Local SM?' datatype='string' name='[Calculation_3538281216822259727]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Delta Orders (copy)_3538281215359561728] = &apos;equal&apos; AND [Calculation_3538281215729995778] != &apos;equal&apos;&#10;                                    AND ([Units UTR checker (copy)_3538281215755608068] = &apos;bad&apos; &#10;                                         OR [Calculation_3538281215732457475]  = &apos;bad&apos; &#10;                                         OR [Calculation_3538281215729995778] = &apos;more&apos;)&#10;&#10;THEN &apos;CHECK&apos; ELSE &apos;OK&apos;&#10;END' />
            </column>
            <column caption='COUNTD days' datatype='integer' name='[Calculation_3538281216836194320]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([shift_date])' />
            </column>
            <column caption='Delta Orders' datatype='real' default-format='p0.0%' name='[Delta DT (copy)_3509570756897918976]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders]) / SUM([orders_predicted]) - 1' />
            </column>
            <column caption='Delta MHS #' datatype='real' default-format='n#,##0;-#,##0' name='[Delta MHS (ABS) (copy)_3538281215651688449]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([mhs_actual]) - SUM([mhs_predicted])' />
            </column>
            <column caption='Delta Orders #' datatype='real' default-format='n#,##0;-#,##0' name='[Delta Orders % (copy)_3538281217503727633]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders]) - SUM([orders_predicted])' />
            </column>
            <column caption='Forecast Orders Flag' datatype='string' datatype-customized='true' default-format='p0.0%' name='[Delta Orders (copy)_3538281215359561728]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ([Delta Orders % (copy)_3538281217503727633]) &gt; (AVG([threshold_order_forecast_error])*[Calculation_3538281216836194320]) THEN &apos;less&apos; &#10;ELSEIF([Delta Orders % (copy)_3538281217503727633]) &lt; -(AVG([threshold_order_forecast_error])*[Calculation_3538281216836194320])  THEN &apos;more&apos; &#10;ELSE &apos;equal&apos;&#10;END' />
            </column>
            <column caption='AT checker' datatype='string' name='[Units UTR checker (copy)_3538281215755608068]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Baseline AT (copy)_6734288821562212355] &lt;= AVG([threshold_at]) THEN &apos;good&apos; &#10;ELSE &apos;bad&apos; END' />
            </column>
