                              <format attr='margin' value='4' />
                            </zone-style>
                          </zone>
                          <zone h='24048' id='882' type-v2='text' w='98796' x='602' y='44110'>
                            <formatted-text>
                              <run bold='true' fontcolor='#000000' fontname='Tableau Regular' fontsize='12'>COMPLIANCE CHECKER</run>
                              <run>Æ&#10;&#10;</run>
                              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Forecast Orders Flag:</run>
                              <run>Æ&#10;</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>- </run>
                              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>More</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'> if </run>
                              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>(</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'><![CDATA[Actual Orders - Predicted Orders) < -X * #DAYS in period]]></run>
                              <run>Æ&#10;</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>- </run>
                              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Less</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'> if </run>
                              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>(</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Actual Orders - Predicted Orders) &gt; X * #DAYS in period</run>
                              <run>Æ&#10;</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>- </run>
                              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Equal</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'> if </run>
                              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>(</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Actual Orders - Predicted Orders) BETWEEN X * #DAYS in period AND -X * #DAYS in period</run>
                              <run>Æ&#10;</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Where X (Threshold order forecast error) is defined based on mechanism described in the following</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular'>Æ </run>
                              <run fontcolor='#4996b2' fontname='Arial, sans-serif' fontsize='8' underline='true'>1-Pager</run>
                              <run>Æ&#10;&#10;</run>
                              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Hours worked used:</run>
                              <run>Æ&#10;</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>- </run>
                              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>More</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'> if </run>
                              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>(</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Actual MHS - Predicted MHS) &gt; 4MHS* #DAYS in period</run>
                              <run>Æ&#10;</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>- </run>
                              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Less</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'> if </run>
                              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>(</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'><![CDATA[Actual MHS - Predicted MHS) < -4MHS* #DAYS in period]]></run>
                              <run>Æ&#10;</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>- </run>
                              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Equal</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'> if </run>
                              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>(</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Actual MHS - Predicted MHS) BETWEEN -(4MHS* #DAYS in period ) AND (4MHS* #DAYS in period)</run>
                              <run>Æ&#10;&#10;</run>
                              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Productivity checker:</run>
                              <run>Æ&#10;</run>
                              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>- good </run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>if Units UTR &gt;= Target Units UTR</run>
                              <run>Æ&#10;</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>- </run>
                              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>bad</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'> if Units</run>
                              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Æ </run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>UTR &lt; Target Units UTR</run>
                              <run>Æ&#10;&#10;</run>
                              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>AT checker:</run>
                              <run>Æ&#10;</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>- </run>
                              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>good</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'> if AT &lt;= threshold</run>
                              <run>Æ&#10;</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>- </run>
                              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>bad</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'> if AT &gt; threshold </run>
                              <run>Æ&#10;&#10;</run>
                              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Input Forecast Accuracy Rate: </run>
                              <run fontcolor='#1f1f1f' fontname='Tableau Regular' fontsize='8'>instances where we matched actuals (F[Forecast Orders Flag] = &apos;equal&apos;) /all instances</run>
                              <run>Æ&#10;</run>
                              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Model Compliance: </run>
                              <run fontcolor='#000000' fontname='Tableau Regular' fontsize='8'>cases where we matched actuals for Inputs &amp; where Hours worked matches model suggestion / cases where we matched actuals for Inputs</run>
                              <run>Æ&#10;</run>
                              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Operational Compliance: </run>
                              <run fontcolor='#000000' fontname='Tableau Regular' fontsize='8'>cases where Store has both good productivity and good Assignment time/ total istances</run>
                            </formatted-text>
                            <zone-style>
                              <format attr='border-color' value='#000000' />
                              <format attr='border-style' value='none' />
                              <format attr='border-width' value='0' />
                              <format attr='margin' value='4' />
                              <format attr='background-color' value='#f5f5f5' />
                            </zone-style>
                          </zone>
                          <zone h='5901' id='889' mode='checkdropdown' name='Compliance Checker - overview' param='[federated.1ll7n0h0dhinh51a9s3my187si30].[usr:Calculation_3538281216801968142:nk]' show-apply='true' type-v2='filter' values='database' w='21746' x='77652' y='38209'>
