                <zone h='9046' id='719' type-v2='text' w='84421' x='615' y='889'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontcolor='#e00012' fontname='Tableau Regular' fontsize='20'>Shift Adoption</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='100' h='11990' id='20' is-fixed='true' is-scaled='1' param='Image/Q-Commerce_Team-Logo_WhiteBG.png' type-v2='bitmap' w='14349' x='85036' y='889'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='19954' id='738' type-v2='text' w='84421' x='615' y='9935'>
                  <formatted-text>
                    <run bold='true' fontcolor='#555555' fontname='Tableau Regular' lmargin='420'>- Total Assigned Shifts On-Ground: </run>
                    <run fontcolor='#555555' fontname='Tableau Regular' lmargin='420'>Number of total shifts assigned and evaluated (worked) in a certain period in a given Dmart or a Country</run>
                    <run lmargin='420'>Æ&#10;</run>
                    <run bold='true' fontcolor='#555555' fontname='Tableau Regular' lmargin='420'>- Assigned Shifts from Rooster</run>
                    <run fontcolor='#555555' fontname='Tableau Regular' lmargin='420'>: Number of “Total Assigned Shifts On-Ground” that is directly from Rooster where the schedule is pushed by the Central team.</run>
                    <run lmargin='420'>Æ&#10;</run>
                    <run bold='true' fontcolor='#555555' fontname='Tableau Regular' lmargin='420'>- Assigned Shifts from Manual:</run>
                    <run fontcolor='#555555' fontname='Tableau Regular' lmargin='420'> Number of “Total Assigned Shifts On-Ground” that is due to Manual Assignment on-ground. For these, the shifts on Rooster generated by the Central team might or might not have been looked into for recommendations.</run>
                    <run lmargin='420'>Æ&#10;</run>
                    <run bold='true' fontcolor='#555555' fontname='Tableau Regular' lmargin='420'>- Assigned Shifts from Bulk Upload:</run>
                    <run fontcolor='#555555' fontname='Tableau Regular' lmargin='420'> Number of “Total Assigned Shifts On-Ground” that is due to CSV Bulk-upload on-ground. For these, the shifts on Rooster generated by the Central team might or might not have been looked into for recommendations.</run>
                    <run lmargin='420'>Æ&#10;</run>
                    <run bold='true' fontcolor='#555555' fontname='Tableau Regular' lmargin='420'>- Adoption % of Shifts from Rooster: </run>
                    <run fontcolor='#555555' fontname='Tableau Regular' lmargin='420'>Percentage share of “Total Assigned Shifts On-Ground” that is directly from Rooster where the schedule is pushed by the Central team.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#f5f5f5' />
                  </zone-style>
                </zone>
