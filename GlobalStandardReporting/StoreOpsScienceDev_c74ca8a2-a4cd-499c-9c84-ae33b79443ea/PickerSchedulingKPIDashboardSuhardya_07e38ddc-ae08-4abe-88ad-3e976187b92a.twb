                <zone forceUpdate='true' h='14300' id='323' type-v2='text' w='84748' x='667' y='800'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontcolor='#e00012' fontsize='20'>Feedback Dasboard</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#333333' fontname='Arial' fontsize='10'>- MHS Predicted: MHS recommended by SOS Schedule</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#333333' fontname='Arial' fontsize='10'>- MHS Actual: Actual MHS worked on ground (incl. overtime, pickers starting late)</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#333333' fontname='Arial' fontsize='10'>- FTE: Full-time Equivalent. </run>
                    <run fontcolor='#202124' fontname='Arial' fontsize='10'>A full-time employee (working 8 hours a day) is equal to one FTE</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#000000' fontname='Arial' fontsize='10'>A deviation from the proposed schedule between 1% to 5% is considered as acceptable, as it can be justified by circumstances such as overtime or late arrival from the picker.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
