    <worksheet name='Prediction Assestment (2)'>
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='wfm_kpis_report (picker_scheduling_prod)' name='federated.1ll7n0h0dhinh51a9s3my187si30' />
          </datasources>
          <datasource-dependencies datasource='federated.1ll7n0h0dhinh51a9s3my187si30'>
            <column caption='Over-forecast Orders %' datatype='real' default-format='p0%' name='[-Ve Delta Orders (copy)_2331035037491281921]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [orders_day_delta] &lt; 0 THEN&#10;[orders_day_delta]&#10;ELSE NULL END' />
            </column>
            <column caption='AT Peak (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[AT (min) (copy)_1244400883154857986]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_at_peak]) / SUM([orders_excl_preorder_with_at_peak])' />
            </column>
            <column caption='Picking Time Actual' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[AT (min) (copy)_2057511774827188224]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([picking_time_seconds]) / SUM([orders])' />
            </column>
            <column caption='Avg Basket Size - Actual' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg SKU per Order - Actual (copy)_1252493281290940416]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([units_outbound])/ SUM([orders])' />
            </column>
            <column caption='AT (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Baseline AT (copy)_6734288821562212355]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_at]) / SUM([orders_excl_preorder])' />
            </column>
            <column caption='Units UTR' datatype='real' name='[Baseline Units UTR (copy)_6734288821576048644]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([units_outbound]) / SUM([mhs_actual])' />
            </column>
            <column caption='Delta AT Peak - Threshold' datatype='real' default-format='p0%' name='[Delta AT - Threshold (copy)_2645231526973263872]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[AT (min) (copy)_1244400883154857986]&#10; / AVG([threshold_at_peak]) - 1' />
            </column>
            <column caption='Delta Orders' datatype='real' default-format='p0.0%' name='[Delta DT (copy)_3509570756897918976]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders]) / SUM([orders_predicted]) - 1' />
            </column>
            <column caption='Under-forecast Orders %' datatype='real' default-format='p0%' name='[Delta MHS (ABS) (copy)_2331035037483159552]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [orders_day_delta] &gt; 0 THEN&#10;[orders_day_delta]&#10;ELSE NULL END' />
            </column>
            <column caption='-ve Deviation MHS' datatype='real' default-format='p0%' name='[Delta MHS (ABS) (copy)_2575636779456356352 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//AVG(ABS([Mhs Day Deviation]))&#10;IF [mhs_day_deviation] &lt; 0 THEN&#10;[mhs_day_deviation]&#10;ELSE NULL END' />
            </column>
            <column caption='Delta MHS (ABS)' datatype='real' default-format='p0%' name='[Delta MHS (copy)_2325053688607948801]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ABS(SUM([mhs_actual]) / SUM([mhs_predicted]) - 1)' />
            </column>
            <column caption='Delta SKU received PO' datatype='real' default-format='p0.0%' name='[Delta Orders (copy)_3509570757965516805 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sku_received_po])  /SUM([sku_received_po_predicted]) - 1' />
            </column>
            <column caption='Delta Receiving Time ST' datatype='real' default-format='p0.0%' name='[Delta Receiving Time PO  (copy)_2057511774829932549]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([receiving_time_sku_st])  /AVG([receiving_time_sku_st_predicted]) - 1' />
            </column>
            <column caption='Delta picking time' datatype='real' default-format='p0.0%' name='[Delta SKU cycle count (copy)_2057511774828023810]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([AT (min) (copy)_2057511774827188224])  /AVG([picking_time_order_predicted]) - 1' />
            </column>
            <column caption='Delta SKU cycle count' datatype='real' default-format='p0.0%' name='[Delta SKU received (copy)_1244400882912284672]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cc_sku_actual])  /SUM([cc_sku_predicted]) - 1' />
            </column>
            <column caption='Delta SKU received ST' datatype='real' default-format='p0%' name='[Delta SKU received PO (copy)_2057511774828904451]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sku_received_st])  /SUM([sku_received_st_predicted]) - 1' />
            </column>
            <column caption='Delta Receiving Time PO ' datatype='real' default-format='p0%' name='[Delta SKU received PO (copy)_2057511774829666308]' role='measure' type='quantitative'>
