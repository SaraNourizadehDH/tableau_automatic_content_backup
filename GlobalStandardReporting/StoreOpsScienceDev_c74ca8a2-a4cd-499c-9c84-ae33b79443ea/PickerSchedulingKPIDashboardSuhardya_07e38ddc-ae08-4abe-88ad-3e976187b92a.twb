    <worksheet name='Prediction Assestment'>
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='wfm_kpis_report (picker_scheduling_prod)' name='federated.1ll7n0h0dhinh51a9s3my187si30' />
          </datasources>
          <datasource-dependencies datasource='federated.1ll7n0h0dhinh51a9s3my187si30'>
            <column caption='AT Peak (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[AT (min) (copy)_1244400883154857986]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_at_peak]) / SUM([orders_excl_preorder_with_at_peak])' />
            </column>
            <column caption='AT (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Baseline AT (copy)_6734288821562212355]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_at]) / SUM([orders_excl_preorder])' />
            </column>
            <column caption='UTR+' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Baseline Inbound-Outbound UTR (copy)_6734288821576409093]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([units_inbound_outbound]) / SUM([mhs_actual])' />
            </column>
            <column caption='Units UTR' datatype='real' name='[Baseline Units UTR (copy)_6734288821576048644]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([units_outbound]) / SUM([mhs_actual])' />
            </column>
            <column caption='FTEs Predicted' datatype='real' name='[Calculation_3509570756905336834]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[mhs_predicted] / 8' />
            </column>
            <column caption='Separator - accuracy assestment' datatype='integer' name='[Calculation_4486922257095876608]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='Delta Units UTR' datatype='real' default-format='p0.0%' name='[Calculation_5858409063865950209]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Baseline Units UTR (copy)_6734288821576048644]&#10; / AVG([baseline_units_utr]) - 1' />
            </column>
            <column caption='Avg SKU per Order - Actual' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_6798394787745964032]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([skus_delivered])/ SUM([orders])' />
            </column>
            <column caption='Delta AT Peak' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Delta AT % (copy)_1244400883159224324]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[AT (min) (copy)_1244400883154857986] - AVG([baseline_at_peak])' />
            </column>
            <column caption='Delta AT' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Delta AT % (copy)_1244400883195924485]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Baseline AT (copy)_6734288821562212355] - AVG([baseline_at])' />
            </column>
            <column caption='Delta MHS %' datatype='real' default-format='p0.0%' name='[Delta AT (copy)_934215456738418688]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([mhs_actual]) / SUM([mhs_predicted]) - 1' />
            </column>
            <column caption='Delta Orders' datatype='real' default-format='p0.0%' name='[Delta DT (copy)_3509570756897918976]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders]) / SUM([orders_predicted]) - 1' />
            </column>
            <column caption='Delta SKU received PO' datatype='real' default-format='p0.0%' name='[Delta Orders (copy)_3509570757965516805 1]' role='measure' type='quantitative'>
