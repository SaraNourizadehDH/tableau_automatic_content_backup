                <zone fixed-size='135' h='14300' id='20' is-fixed='true' is-scaled='1' param='Image/Q-Commerce_Team-Logo_WhiteBG.png' type-v2='bitmap' w='13918' x='85415' y='800'>
                  <zone-style>
