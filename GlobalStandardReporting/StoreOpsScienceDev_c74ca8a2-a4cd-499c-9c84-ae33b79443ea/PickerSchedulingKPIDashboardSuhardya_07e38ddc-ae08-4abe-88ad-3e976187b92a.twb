    <worksheet name='schedule deviation'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#e00012' fontname='Tableau Medium' fontsize='20'>Shift Deviation</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run>Æ&#10;</run>
            <run bold='true' fontname='Arial' fontsize='10'>MHS Predicted</run>
            <run fontname='Arial' fontsize='10'>: MHS recommended by SOS Schedule</run>
            <run>Æ&#10;</run>
            <run bold='true' fontname='Arial' fontsize='10'>MHS Actua</run>
            <run fontname='Arial' fontsize='10'>l: Actual MHS worked on ground (incl. overtime, pickers starting late)</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='10'>Delta MHS %</run>
            <run fontcolor='#000000' fontname='Arial' fontsize='10'>: difference in % between MHS Predicted and MHS Actual </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='10'>Delta MHS (ABS)</run>
            <run fontcolor='#000000' fontname='Arial' fontsize='10'>: </run>
            <run fontcolor='#000000' fontname='Helvetica Neue' fontsize='10'>average Deviation from recommended Daily #MHS in absolute value: AVG(ABS(MHS Day Deviation))</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Helvetica Neue' fontsize='10'>Where:</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Helvetica Neue' fontsize='10'>MHS Day Deviation = (mhs_day_actual - mhs_day_predicted) / mhs_day_predicted</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Helvetica Neue' fontsize='10'>-ve Deviation MHS</run>
            <run fontcolor='#000000' fontname='Helvetica Neue' fontsize='10'><![CDATA[: average value of MHS Day Deviation, for the days in which this is < 0 (meaning SOS predicted higher MHS than what has been actually implemented)]]></run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Helvetica Neue' fontsize='10'>+ve Deviation MHS</run>
            <run fontcolor='#000000' fontname='Helvetica Neue' fontsize='10'>: average value of MHS Day Deviation, for the days in which this is &gt; 0 (meaning SOS predicted lower MHS than what has been actually implemented)</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Æ </run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontname='Arial' fontsize='10'>*when shifts are overlapping over 2 days --&gt; the MHS are split between the 2 days: the MHS used in day1, are counted as part of day1, while the MHS used in day2, are counted as part of day2</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='wfm_kpis_report (picker_scheduling_prod)' name='federated.1ll7n0h0dhinh51a9s3my187si30' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Weekly' caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
              <calculation class='tableau' formula='&quot;week&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ll7n0h0dhinh51a9s3my187si30'>
            <column caption='Date Granularity' datatype='datetime' datatype-customized='true' name='[Calculation_1788492015365472256]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;WHEN &apos;hour&apos; THEN DATETIME([shift_ts])&#10;WHEN &apos;day&apos; THEN (DATE(DATETRUNC(&apos;day&apos;, [shift_date])) )&#10;WHEN &apos;week&apos; THEN (DATETRUNC(&apos;week&apos;, [shift_date]))&#10;WHEN &apos;month&apos; THEN (DATETRUNC(&apos;month&apos;, [shift_date]))&#10;END' />
            </column>
            <column caption='Deviation acceptance' datatype='string' name='[Calculation_934215456818618369]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ([Delta MHS (copy)_2325053688607948801]) &gt; 0.055 THEN &apos;NOT VALID&apos;&#10;ELSE &apos;VALID&apos;&#10;END' />
            </column>
            <column caption='Delta MHS %' datatype='real' default-format='p0.0%' name='[Delta AT (copy)_934215456738418688]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([mhs_actual]) / SUM([mhs_predicted]) - 1' />
            </column>
            <column caption='Delta Pickers' datatype='real' default-format='n#,##0;-#,##0' name='[Delta MHS % (copy)_707417026908139520]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([pickers_day_actual])  - AVG([pickers_day_predicted])' />
            </column>
            <column caption='-ve Deviation MHS' datatype='real' default-format='p0%' name='[Delta MHS (ABS) (copy)_2575636779456356352 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//AVG(ABS([Mhs Day Deviation]))&#10;IF [mhs_day_deviation] &lt; 0 THEN&#10;[mhs_day_deviation]&#10;ELSE NULL END' />
            </column>
            <column caption='Delta MHS (ABS)' datatype='real' default-format='p0%' name='[Delta MHS (copy)_2325053688607948801]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ABS(SUM([mhs_actual]) / SUM([mhs_predicted]) - 1)' />
            </column>
            <column caption='+ve Deviation MHS' datatype='real' default-format='p0%' name='[NEGATIVE Deviation MHS (copy)_2575636779457167361 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [mhs_day_deviation] &gt; 0 THEN&#10;[mhs_day_deviation]&#10;ELSE NULL END' />
            </column>
            <column-instance column='[Delta MHS (ABS) (copy)_2575636779456356352 1]' derivation='Avg' name='[avg:Delta MHS (ABS) (copy)_2575636779456356352 1:qk]' pivot='key' type='quantitative' />
            <column-instance column='[NEGATIVE Deviation MHS (copy)_2575636779457167361 1]' derivation='Avg' name='[avg:NEGATIVE Deviation MHS (copy)_2575636779457167361 1:qk]' pivot='key' type='quantitative' />
