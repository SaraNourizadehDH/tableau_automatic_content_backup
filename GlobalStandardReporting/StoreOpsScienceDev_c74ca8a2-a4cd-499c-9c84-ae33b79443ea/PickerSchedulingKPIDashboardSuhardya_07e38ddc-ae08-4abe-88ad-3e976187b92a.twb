  <dashboards>
    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Compliance Checker'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/PickerSchedulingKPIDashboard/ComplianceChecker?rev=' id='ComplianceChecker' path='/t/GlobalStandardReporting/workbooks/PickerSchedulingKPIDashboard-Suhardya' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='1005' maxwidth='1329' minheight='1005' minwidth='1329' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='wfm_kpis_report (picker_scheduling_prod)' name='federated.1ll7n0h0dhinh51a9s3my187si30' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column alias='Weekly' caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
          <calculation class='tableau' formula='&quot;week&quot;' />
          <aliases>
            <alias key='&quot;day&quot;' value='Daily' />
            <alias key='&quot;month&quot;' value='Monthly' />
            <alias key='&quot;week&quot;' value='Weekly' />
          </aliases>
          <members>
            <member alias='Daily' value='&quot;day&quot;' />
            <member alias='Weekly' value='&quot;week&quot;' />
            <member alias='Monthly' value='&quot;month&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.1ll7n0h0dhinh51a9s3my187si30'>
        <column caption='Check Model' datatype='string' name='[Calculation_2946268999919403011]' role='measure' type='nominal'>
          <calculation class='tableau' formula='IF  [Delta Orders (copy)_3538281215359561728] = (&apos;less&apos;) &#10;OR [Delta Orders (copy)_3538281215359561728] = &apos;more&apos;&#10;OR ([Delta Orders (copy)_3538281215359561728] = &apos;equal&apos; &#10;   AND [Calculation_3538281215729995778] = &apos;equal&apos;&#10;   AND [Calculation_3538281215732457475] = &apos;bad&apos; )&#10;OR ([Delta Orders (copy)_3538281215359561728] = &apos;equal&apos; &#10;   AND [Calculation_3538281215729995778] = &apos;equal&apos;&#10;   AND [Units UTR checker (copy)_3538281215755608068] = &apos;bad&apos;)&#10;OR ([Delta Orders (copy)_3538281215359561728] = &apos;equal&apos; &#10;   AND [Calculation_3538281215729995778] = &apos;less&apos;&#10;   AND [Calculation_3538281215732457475] = &apos;good&apos; &#10;    AND [Units UTR checker (copy)_3538281215755608068] = &apos;good&apos;)&#10;THEN &apos;CHECK&apos; ELSE &apos;OK&apos; END' />
        </column>
        <column caption='Productivity &amp; Serviceability compliance?' datatype='string' name='[Calculation_3538281216801968142]' role='measure' type='nominal'>
          <calculation class='tableau' formula='IF [Calculation_3538281215732457475] = &apos;bad&apos; OR [Units UTR checker (copy)_3538281215755608068] = &apos;bad&apos; &#10;THEN &apos;CHECK&apos; &#10;ELSE &apos;OK&apos;&#10;END' />
        </column>
        <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
        <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
        <column-instance column='[region]' derivation='None' name='[none:region:nk]' pivot='key' type='nominal' />
        <column-instance column='[shift_date]' derivation='None' name='[none:shift_date:qk]' pivot='key' type='quantitative' />
        <column-instance column='[warehouse_name]' derivation='None' name='[none:warehouse_name:nk]' pivot='key' type='nominal' />
        <column caption='Region' datatype='string' name='[region]' role='dimension' type='nominal' />
        <column caption='Shift Date' datatype='date' name='[shift_date]' role='dimension' type='ordinal' />
        <column-instance column='[Calculation_2946268999919403011]' derivation='User' name='[usr:Calculation_2946268999919403011:nk]' pivot='key' type='nominal' />
        <column-instance column='[Calculation_3538281216801968142]' derivation='User' name='[usr:Calculation_3538281216801968142:nk]' pivot='key' type='nominal' />
        <column caption='Warehouse Name' datatype='string' name='[warehouse_name]' role='dimension' type='nominal' />
      </datasource-dependencies>
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98408' id='888' param='horz' type-v2='layout-flow' w='98796' x='602' y='796'>
            <zone h='98408' id='851' type-v2='layout-basic' w='98796' x='602' y='796'>
              <zone h='91845' id='666' param='horz' type-v2='layout-flow' w='98796' x='602' y='7359'>
                <zone h='91845' id='402' type-v2='layout-basic' w='98796' x='602' y='7359'>
                  <zone h='91845' id='315' param='horz' type-v2='layout-flow' w='98796' x='602' y='7359'>
                    <zone h='91845' id='118' type-v2='layout-basic' w='98796' x='602' y='7359'>
                      <zone h='91845' id='104' param='horz' type-v2='layout-flow' w='98796' x='602' y='7359'>
                        <zone h='91845' id='102' type-v2='layout-basic' w='98796' x='602' y='7359'>
                          <zone forceUpdate='true' h='36751' id='323' type-v2='text' w='49812' x='27840' y='7359'>
                            <formatted-text>
                              <run bold='true' fontcolor='#000000' fontname='Tableau Regular' fontsize='8'>Check model?</run>
                              <run>Æ&#10;</run>
                              <run fontcolor='#000000' fontname='Tableau Regular' fontsize='8'>OK, when:</run>
                              <run>Æ&#10;</run>
                              <run fontcolor='#000000' fontname='Tableau Regular' fontsize='8'>- Order forecast = ‘equal’ AND that, IF </run>
                              <run>Æ&#10;</run>
                              <run fontcolor='#000000' fontname='Tableau Regular' fontsize='8'>1) hours worked used = ‘equal’ to the hours recommended, that both producitivity and AT were good</run>
                              <run>Æ&#10;</run>
                              <run fontcolor='#000000' fontname='Tableau Regular' fontsize='8'>2) hours worked used = ‘less’ than recommended, that either or both AT and Productivity were bad </run>
                              <run>Æ&#10;</run>
                              <run fontcolor='#000000' fontname='Tableau Regular' fontsize='8'>CHECK, when:</run>
                              <run>Æ&#10;</run>
                              <run fontcolor='#000000' fontname='Tableau Regular' fontsize='8'>- Order forecast = ‘less/more’</run>
                              <run>Æ&#10;</run>
                              <run fontcolor='#000000' fontname='Tableau Regular' fontsize='8'>- OR (Order forecast = ‘equal’ AND Hours worked Used = ‘equal’ AND either/both Productivity &amp; Assignment Time = ‘Bad’)</run>
                              <run>Æ&#10;</run>
                              <run fontcolor='#000000' fontname='Tableau Regular' fontsize='8'>- OR (Order forecast = ‘equal’ AND Hours worked Used = ‘Less’ AND both Productivity &amp; Assignment Time = ‘Good’)</run>
                              <run>Æ&#10;&#10;</run>
                              <run bold='true' fontcolor='#000000' fontname='Tableau Regular' fontsize='8'>Productivity &amp; Serviceability compliance?</run>
                              <run>Æ&#10;</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular'>OK, when both &apos;</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>good&apos; productivity &amp; &apos;good&apos; Assignment time</run>
                              <run>Æ&#10;</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>CHECK, when either/both</run>
                              <run fontcolor='#000000' fontname='Tableau Regular' fontsize='8'> Productivity = ‘bad’ &amp; Assignment Time = &apos;bad&apos; </run>
                              <run>Æ&#10;&#10;</run>
                              <run bold='true' fontcolor='#000000' fontname='Tableau Regular' fontsize='8'>Check with Local SM?</run>
                              <run>Æ&#10;</run>
                              <run fontcolor='#000000' fontname='Tableau Regular' fontsize='8'>CHECK when:</run>
                              <run>Æ&#10;</run>
                              <run fontcolor='#000000' fontname='Tableau Regular' fontsize='8'>- Order forecast = ‘equal’ AND Hours worked used != &apos;equal&apos; AND</run>
                              <run>Æ&#10;</run>
                              <run fontcolor='#000000' fontname='Tableau Regular' fontsize='8'>- (Assignment Time = ‘bad’ AND/OR Productivity = ‘bad’)</run>
                              <run>Æ&#10;</run>
                              <run fontcolor='#000000' fontname='Tableau Regular' fontsize='8'>- OR Hours worked Used = more </run>
                            </formatted-text>
                            <zone-style>
                              <format attr='border-color' value='#000000' />
                              <format attr='border-style' value='none' />
                              <format attr='border-width' value='0' />
                              <format attr='margin' value='4' />
                              <format attr='background-color' value='#f5f5f5' />
                            </zone-style>
                          </zone>
                          <zone h='21693' id='660' name='Compliance Checker (data)' w='98796' x='602' y='77511'>
                            <zone-style>
                              <format attr='border-color' value='#000000' />
                              <format attr='border-style' value='none' />
                              <format attr='border-width' value='0' />
                              <format attr='margin' value='4' />
                            </zone-style>
                          </zone>
                          <zone h='5671' id='668' mode='checkdropdown' name='Compliance Checker (data)' param='[federated.1ll7n0h0dhinh51a9s3my187si30].[none:warehouse_name:nk]' type-v2='filter' values='cascading' w='21746' x='77652' y='27662'>
                            <zone-style>
                              <format attr='border-color' value='#000000' />
                              <format attr='border-style' value='none' />
                              <format attr='border-width' value='0' />
                              <format attr='margin' value='4' />
                            </zone-style>
                          </zone>
                          <zone h='5769' id='672' mode='compact' param='[Parameters].[Parameter 1]' type-v2='paramctrl' w='21746' x='77652' y='7359'>
                            <zone-style>
                              <format attr='border-color' value='#000000' />
                              <format attr='border-style' value='none' />
                              <format attr='border-width' value='0' />
                              <format attr='margin' value='4' />
                            </zone-style>
                          </zone>
                          <zone h='6275' id='669' name='Compliance Checker (data)' param='[federated.1ll7n0h0dhinh51a9s3my187si30].[none:shift_date:qk]' type-v2='filter' values='database' w='21746' x='77652' y='13128'>
                            <zone-style>
                              <format attr='border-color' value='#000000' />
                              <format attr='border-style' value='none' />
                              <format attr='border-width' value='0' />
                              <format attr='margin' value='4' />
                            </zone-style>
                          </zone>
                          <zone forceUpdate='true' h='36751' id='713' type-v2='text' w='27238' x='602' y='7359'>
                            <formatted-text>
                              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Forecast Orders Flag:</run>
                              <run>Æ&#10;</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>- </run>
                              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>More</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'> if </run>
                              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>(</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'><![CDATA[Actual Orders - Predicted Orders) < -X * #DAYS in period]]></run>
                              <run>Æ&#10;</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>- </run>
                              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Less</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'> if </run>
                              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>(</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Actual Orders - Predicted Orders) &gt; X * #DAYS in period</run>
                              <run>Æ&#10;</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>- </run>
                              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Equal</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'> if </run>
                              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>(</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Actual Orders - Predicted Orders) BETWEEN X * #DAYS in period AND -X * #DAYS in period</run>
                              <run>Æ&#10;</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Where X (Threshold order forecast error) is defined based on mechanism described in the following</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular'>Æ </run>
                              <run fontcolor='#4996b2' fontname='Arial, sans-serif' fontsize='8' underline='true'>1-Pager</run>
                              <run>Æ&#10;&#10;</run>
                              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Hours worked used:</run>
                              <run>Æ&#10;</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>- </run>
                              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>More</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'> if </run>
                              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>(</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Actual MHS - Predicted MHS) &gt; 4MHS* #DAYS in period</run>
                              <run>Æ&#10;</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>- </run>
                              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Less</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'> if </run>
                              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>(</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'><![CDATA[Actual MHS - Predicted MHS) < -4MHS* #DAYS in period]]></run>
                              <run>Æ&#10;</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>- </run>
                              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Equal</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'> if </run>
                              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>(</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Actual MHS - Predicted MHS) BETWEEN -(4MHS* #DAYS in period ) AND (4MHS* #DAYS in period)</run>
                              <run>Æ&#10;&#10;</run>
                              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Productivity checker:</run>
                              <run>Æ&#10;</run>
                              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>- good </run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>if Units UTR &gt;= Target Units UTR</run>
                              <run>Æ&#10;</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>- </run>
                              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>bad</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'> if Units</run>
                              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>Æ </run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>UTR &lt; Target Units UTR</run>
                              <run>Æ&#10;&#10;</run>
                              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>AT checker:</run>
                              <run>Æ&#10;</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>- </run>
                              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>good</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'> if AT &lt;= threshold</run>
                              <run>Æ&#10;</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>- </run>
                              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'>bad</run>
                              <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='8'> if AT &gt; threshold </run>
                            </formatted-text>
                            <zone-style>
                              <format attr='border-color' value='#000000' />
                              <format attr='border-style' value='none' />
                              <format attr='border-width' value='0' />
                              <format attr='margin' value='4' />
                              <format attr='background-color' value='#f5f5f5' />
                            </zone-style>
                          </zone>
                          <zone h='5075' id='664' mode='checkdropdown' name='Compliance Checker (data)' param='[federated.1ll7n0h0dhinh51a9s3my187si30].[none:global_entity_id:nk]' show-apply='true' type-v2='filter' values='cascading' w='21746' x='77652' y='22587'>
                            <zone-style>
                              <format attr='border-color' value='#000000' />
                              <format attr='border-style' value='none' />
