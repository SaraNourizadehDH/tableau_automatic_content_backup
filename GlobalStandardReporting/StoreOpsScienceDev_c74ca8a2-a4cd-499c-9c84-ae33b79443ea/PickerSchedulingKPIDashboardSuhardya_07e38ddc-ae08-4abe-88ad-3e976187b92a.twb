    <worksheet name='Summary KPIs (Dmarts)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Warehouse view</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='wfm_kpis_report (picker_scheduling_prod)' name='federated.1ll7n0h0dhinh51a9s3my187si30' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Weekly' caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
              <calculation class='tableau' formula='&quot;week&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ll7n0h0dhinh51a9s3my187si30'>
            <column caption='AT (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Baseline AT (copy)_6734288821562212355]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_at]) / SUM([orders_excl_preorder])' />
            </column>
            <column caption='UTR+' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Baseline Inbound-Outbound UTR (copy)_6734288821576409093]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([units_inbound_outbound]) / SUM([mhs_actual])' />
            </column>
            <column caption='Units UTR' datatype='real' name='[Baseline Units UTR (copy)_6734288821576048644]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([units_outbound]) / SUM([mhs_actual])' />
            </column>
            <column caption='Date Granularity' datatype='datetime' datatype-customized='true' name='[Calculation_1788492015365472256]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;WHEN &apos;hour&apos; THEN DATETIME([shift_ts])&#10;WHEN &apos;day&apos; THEN (DATE(DATETRUNC(&apos;day&apos;, [shift_date])) )&#10;WHEN &apos;week&apos; THEN (DATETRUNC(&apos;week&apos;, [shift_date]))&#10;WHEN &apos;month&apos; THEN (DATETRUNC(&apos;month&apos;, [shift_date]))&#10;END' />
            </column>
            <column caption='Delta Units UTR' datatype='real' default-format='p0.0%' name='[Calculation_5858409063865950209]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Baseline Units UTR (copy)_6734288821576048644]&#10; / AVG([baseline_units_utr]) - 1' />
            </column>
            <column caption='Delta AT %' datatype='real' default-format='p0.0%' name='[Delta Units UTR (copy)_5858409063908724739]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Baseline AT (copy)_6734288821562212355] / AVG([baseline_at]) - 1' />
            </column>
            <column caption='Delta UTR+' datatype='real' default-format='p0.0%' name='[Delta Units UTR (copy)_5858409063909011460]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Baseline Inbound-Outbound UTR (copy)_6734288821576409093] / avg([baseline_utr_plus]) - 1' />
            </column>
            <column-instance column='[target_utr_plus]' derivation='Attribute' name='[attr:target_utr_plus:qk]' pivot='key' type='quantitative' />
            <column-instance column='[baseline_at]' derivation='Avg' name='[avg:baseline_at:qk]' pivot='key' type='quantitative' />
            <column-instance column='[baseline_units_utr]' derivation='Avg' name='[avg:baseline_units_utr:qk]' pivot='key' type='quantitative' />
