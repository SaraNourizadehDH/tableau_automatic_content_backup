                <zone fixed-size='58' h='6563' id='20' is-centered='0' is-fixed='true' is-scaled='1' param='Image/Q-Commerce_Team-Logo_WhiteBG.png' type-v2='bitmap' w='16377' x='83021' y='796'>
                  <zone-style>
