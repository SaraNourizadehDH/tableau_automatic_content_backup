        <calculation class='tableau' formula='ABS(sum([acquisitions_adopted])&#13;&#10;- sum([acquisitions_recommended])&#13;&#10;)&#13;&#10;/sum([acquisitions_adopted])' />
      </column>
      <column caption='Acquisitions Diff = Actual - Recommended' datatype='real' name='[Calculation_1275081686451236882]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([acquisitions_adopted]-[acquisitions_recommended])' />
      </column>
      <column caption='Error Rate = ABS(Diff) / Acquisitions Actual' datatype='real' name='[Calculation_1275081686451380243]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ABS(sum([acquisitions_adopted])&#13;&#10;- sum([acquisitions_recommended])&#13;&#10;)&#13;&#10;/sum([acquisitions_adopted])' />
      </column>
      <column caption='Is Adopted Country Recommendation (Final Result)' datatype='boolean' name='[Calculation_1275081686476603415]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[rank_gl_entity_stage_3] = 1 and [rank_gl_entity_stage_1] = 1' />
        <aliases>
