      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1hi72kz0dsmz7l1fkdlbr0uj7fdl].[sum:Calculation_1275081686455193620:qk]&quot;' value='Stage 2 - Country Adopt. Rate' />
          <alias key='&quot;[federated.1hi72kz0dsmz7l1fkdlbr0uj7fdl].[sum:rank_gl_entity_stage_1:qk]&quot;' value='Stage 1 - Rank' />
          <alias key='&quot;[federated.1hi72kz0dsmz7l1fkdlbr0uj7fdl].[sum:rank_gl_entity_stage_3:qk]&quot;' value='Stage 2 - Rank' />
          <alias key='&quot;[federated.1hi72kz0dsmz7l1fkdlbr0uj7fdl].[sum:spend_actual_gl_entity:qk]&quot;' value='Spend Actual' />
          <alias key='&quot;[federated.1hi72kz0dsmz7l1fkdlbr0uj7fdl].[sum:spend_adopted_gl_entity:qk]&quot;' value='Spend Adopted' />
          <alias key='&quot;[federated.1hi72kz0dsmz7l1fkdlbr0uj7fdl].[sum:spend_diff_gl_entity:qk]&quot;' value='Stage 1-Spend Diff [Recomm.-Actual]' />
          <alias key='&quot;[federated.1hi72kz0dsmz7l1fkdlbr0uj7fdl].[sum:spend_planned_gl_entity:qk]&quot;' value='Spend Planned [Target Budget*Multiplier]' />
          <alias key='&quot;[federated.1hi72kz0dsmz7l1fkdlbr0uj7fdl].[sum:spend_recommended_gl_entity:qk]&quot;' value='Spend Recommended' />
        </aliases>
      </column>
      <column caption='Adoption Rate' datatype='real' name='[Calculation_1275081686455193620]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[spend_adopted_gl_entity]/[spend_actual_gl_entity]' />
      </column>
      <column caption='is the best optimisation run for the country' datatype='string' name='[Calculation_1275081686457085973]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [rank_gl_entity_stage_1] = 1 THEN &quot;best run stage 1&quot; ELSE &quot;-&quot; END' />
      </column>
      <column caption='Is Adopted (Final Result)' datatype='boolean' name='[Calculation_1275081686465437718]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[rank_gl_entity_stage_3] = 1 AND [rank_gl_entity_stage_1] = 1' />
        <aliases>
          <alias key='true' value='True🟢' />
