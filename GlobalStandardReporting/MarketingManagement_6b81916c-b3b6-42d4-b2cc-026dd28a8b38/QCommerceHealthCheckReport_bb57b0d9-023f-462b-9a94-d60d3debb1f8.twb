      <column caption='QC lvl - Active QC Adopters' datatype='real' name='[Active QC Adopters (copy)_167759101637795847]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[active_vert_adopters_mth]' />
      </column>
      <column caption='QC lvl - Active QC Adopters / MAU' datatype='real' default-format='p0.0%' name='[Active QC Adopters / MAU (copy)_167759101640810510]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Active QC Adopters (copy)_167759101637795847])/SUM([Calculation_3777534929596280837])' />
      </column>
      <column caption='Acquisition Platform Dedupped' datatype='real' name='[Calculation_115334376667746304]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [sub_entity],[vertical_order_date]&#10;&#10;&#10;: AVG(&#10;[acquisition_platform]) }' />
      </column>
      <column caption='Cross-Sell Trials' datatype='real' name='[Calculation_167759101364142081]' role='measure' type='quantitative'>
