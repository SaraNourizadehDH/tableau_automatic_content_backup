              <calculation class='tableau' formula='AVG(IF [Calculation_2978638619448938505]  = [vertical_order_date]&#10;THEN [Calculation_2978638619462410270] END) - &#10;AVG(IF DATEADD(&apos;week&apos;,1,DATETRUNC(&apos;week&apos;,DATETRUNC(&apos;year&apos;,[Calculation_2978638619448938505]))) = [vertical_order_date]&#10;THEN [Calculation_2978638619462410270] END)' />
            </column>
            <column caption='Last YTD - Trials' datatype='real' name='[YTD - Trials (copy)_2978638619449380874]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF DATETRUNC(&apos;year&apos;,[Calculation_2978638619448938505]) &lt;= [vertical_order_date] AND [vertical_order_date] &lt;= [Calculation_2978638619448938505]&#10;THEN [new_trials] END)' />
