            <column caption='Current Week - Selected' datatype='datetime' datatype-customized='true' name='[Calculation_2741425582764371971]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 6]&#10;//DATE(DATETRUNC(&apos;week&apos;,[Last Date of Data]))' />
            </column>
            <column caption='Last Year Current Week' datatype='date' datatype-customized='true' name='[Calculation_2978638619448938505]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;,DATEADD(&apos;year&apos;,-1,[Calculation_2741425582764371971])))' />
            </column>
            <column caption='Metric Selected' datatype='real' name='[Calculation_2978638619462410270]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;QC Adopters&apos;&#10;THEN ([Calculation_196680689632034829])&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Active QC Adopters 4&apos;&#10;THEN ([active_qc_adopters_4])&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Active QC Adopters 8&apos;&#10;THEN ([active_qc_adopters_8])&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Early QC Adopters&apos;&#10;THEN ([early_qc_adopters])&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Early Loyal QC Adopters&apos;&#10;THEN ([early_loyal_qc_adopters])&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Active &amp; Frequent Adopters&apos;&#10;THEN NULL&#10;END' />
            </column>
            <column caption='Filter Metric Table' datatype='boolean' name='[Calculation_4455115611183710222]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 5] = &apos;New Trials&apos;' />
            </column>
