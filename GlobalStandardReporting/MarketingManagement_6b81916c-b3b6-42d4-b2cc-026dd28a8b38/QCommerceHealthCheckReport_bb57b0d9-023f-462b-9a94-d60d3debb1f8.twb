      </column>
      <column caption='QC Acquisiton Share' datatype='real' default-format='p0.0%' name='[Calculation_3777534929589489665]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([acquisitions])/[Calculation_3777534929589370880]' />
      </column>
      <column caption='Filter Month' datatype='boolean' name='[Calculation_3777534929592029186]' role='dimension' type='nominal'>
