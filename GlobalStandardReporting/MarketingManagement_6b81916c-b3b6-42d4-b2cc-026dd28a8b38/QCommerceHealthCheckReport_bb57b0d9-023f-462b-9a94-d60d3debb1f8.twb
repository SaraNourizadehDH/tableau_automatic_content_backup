              <calculation class='tableau' formula='SUM([QC Adopters (copy)_196680689632559119])/SUM([Calculation_196680689623293954])' />
            </column>
            <column caption='Ratio QC Adopters - Early Loyal' datatype='real' default-format='p0.00%' name='[Ratio QC Adopters - Early (copy)_196680689633042452]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([QC Adopters - Early (copy)_196680689632915474])/SUM([Calculation_196680689623293954])' />
