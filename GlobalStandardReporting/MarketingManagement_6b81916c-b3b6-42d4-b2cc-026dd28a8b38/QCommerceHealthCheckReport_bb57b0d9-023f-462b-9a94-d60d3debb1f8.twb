            <column caption='Ratio QC Adopters - Early' datatype='real' default-format='p0.00%' name='[Ratio QC Adopters - Good (copy)_196680689632972819]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([QC Adopters - Good (copy)_196680689632849937])/SUM([Calculation_196680689623293954])' />
