          <datasource-dependencies datasource='federated.19tycmy1bs7sgv1fvdbox1y08pf9'>
            <column caption='Ratio Trial - ALL' datatype='real' default-format='p0.00%' name='[Calculation_196680689622630401]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([new_trials])/SUM([Calculation_196680689623293954])' />
            </column>
            <column caption='Total Active Selected' datatype='real' name='[Calculation_196680689623293954]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [sub_entity],[vertical_order_date]&#10;&#10;&#10;: AVG(&#10;&#10;IF [Parameters].[Parameter 8] = &apos;ALL&apos;&#10;THEN &#10;[active_customers_all]&#10;ELSE&#10;[qc_active_customers_all]&#10;END ) }' />
            </column>
            <column caption='QC Adopters' datatype='real' name='[Calculation_196680689632034829]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [sub_entity],[vertical_order_date]&#10;&#10;&#10;: AVG(&#10;[qc_adopters] ) }' />
            </column>
            <column caption='Lapsing' datatype='real' default-format='p0.0%' name='[Calculation_2741425582760968192]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(AVG([qc_adopters])-AVG([active_qc_adopters_4]))/AVG([qc_adopters])' />
            </column>
            <column caption='Lapsing QComm' datatype='real' default-format='p0.0%' name='[Lapsing (copy)_2741425582761111553]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(AVG([qc_adopters])-AVG([active_qc_adopters_8]))/AVG([qc_adopters])' />
            </column>
            <column caption='QC Adopters - Good' datatype='real' name='[QC Adopters (copy)_196680689632559119]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [sub_entity],[vertical_order_date]&#10;&#10;&#10;: AVG(&#10;[qc_adopters_good] ) }' />
            </column>
            <column caption='QC Adopters - Early Loyal' datatype='real' name='[QC Adopters - Early (copy)_196680689632915474]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [sub_entity],[vertical_order_date]&#10;&#10;&#10;: AVG(&#10;[early_loyal_qc_adopters] ) }' />
            </column>
            <column caption='QC Adopters - Early' datatype='real' name='[QC Adopters - Good (copy)_196680689632849937]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [sub_entity],[vertical_order_date]&#10;&#10;&#10;: AVG(&#10;[early_qc_adopters] ) }' />
            </column>
