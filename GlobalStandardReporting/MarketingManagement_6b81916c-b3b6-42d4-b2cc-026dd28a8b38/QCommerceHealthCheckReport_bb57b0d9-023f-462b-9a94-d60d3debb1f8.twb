              <calculation class='tableau' formula='SUM(IF [vertical_type] = &apos;DMart&apos; THEN [new_trials] END)&#10;/&#10;SUM(IF [vertical_type] = &apos;DMart&apos;THEN [Total Active Selected (copy)_196680689625063428] END)' />
