            <column caption='QC Adopters' datatype='real' name='[Calculation_196680689632034829]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [sub_entity],[vertical_order_date]&#10;&#10;&#10;: AVG(&#10;[qc_adopters] ) }' />
            </column>
            <column caption='Last Date of Data' datatype='datetime' name='[Calculation_2741425582764236802]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{MAX([vertical_order_date])}' />
            </column>
            <column caption='Orders' datatype='real' name='[Calculation_285486018181201920]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders])' />
            </column>
            <column caption='Country Name' datatype='string' name='[Country (copy)_6315665212218163201]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='tableau' formula='[country_name]' />
            </column>
            <column caption='Current Complete Week - Actual' datatype='date' datatype-customized='true' name='[Current Week (copy)_3309019873628389376]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATEADD(&apos;week&apos;,-1,DATETRUNC(&apos;week&apos;,[Calculation_2741425582764236802])))' />
            </column>
            <column caption='Filter - Only Complete Weeks' datatype='boolean' name='[Filter - TW (copy)_4455115611204825117]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[vertical_order_date] &lt;= [Current Week (copy)_3309019873628389376]' />
            </column>
            <column caption='Metric Selected - Line Chart' datatype='real' name='[Metric Selected (copy)_6499468372045557760]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;QC Adopters&apos;&#10;THEN SUM([Calculation_196680689632034829])&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Active QC Adopters 4&apos;&#10;THEN SUM([active_qc_adopters_4])&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Active QC Adopters 8&apos;&#10;THEN SUM([active_qc_adopters_8])&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Early QC Adopters&apos;&#10;THEN SUM([early_qc_adopters])&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Early Loyal QC Adopters&apos;&#10;THEN SUM([early_loyal_qc_adopters])&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Active &amp; Frequent Adopters&apos;&#10;THEN NULL&#10;END' />
            </column>
            <column caption='Metric Selected - Difference Line chart' datatype='real' name='[Metric Selected - Difference (copy)_6499468372045852673]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;New Trials&apos;&#10;THEN SUM([new_trials])&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Orders&apos;&#10;THEN [Calculation_285486018181201920]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Orders Vouchers&apos;&#10;THEN [Orders (copy)_285486018181316609]&#10;ELSE &#10;ZN([Metric Selected (copy)_6499468372045557760]) - LOOKUP(ZN([Metric Selected (copy)_6499468372045557760]), -1)&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Orders Vouchers' datatype='real' name='[Orders (copy)_285486018181316609]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_v])' />
