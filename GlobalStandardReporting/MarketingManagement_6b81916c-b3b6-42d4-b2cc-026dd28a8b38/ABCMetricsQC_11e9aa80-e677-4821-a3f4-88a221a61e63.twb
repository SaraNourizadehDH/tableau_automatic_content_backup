              <calculation class='tableau' formula='SUM([Session ALL Fixed (copy)_4327114855754862596])/SUM([Session w trans ALL Fixed (copy)_5028269015707254803])' />
            </column>
            <column caption='% Sessions w trans ALL' datatype='real' name='[% Sessions w trans VERT (copy)_5028269015706587153]' role='measure' type='quantitative'>
