      <table>
        <view>
          <datasources>
            <datasource caption='bima_result_mth (cl_mkt) (2)' name='federated.0jzkwp61hk6my614c5hpk0mzs7jg' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Shop Type' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0jzkwp61hk6my614c5hpk0mzs7jg'>
            <column caption='% Adopters / QC MAU All' datatype='real' name='[% Adopters / QC MAU VERT (copy)_5827165371163144200]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Acid ALL Fixed (copy)_5028269015681904653])/SUM([Calculation_5827165371142836229])' />
            </column>
            <column caption='Adopters all Fixed' datatype='real' name='[Acid ALL Fixed (copy)_5028269015681904653]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [sub_entity],[vertical_order_date]&#10;&#10;&#10;: AVG(&#10;[adopter_all]) }' />
            </column>
            <column caption='Voucher Acq Share ALL' datatype='real' name='[Acq Share ALL (copy)_5028269015409643524]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qc_voucher_acq])/SUM([total_acq])' />
            </column>
            <column caption='Acq Share ALL' datatype='real' name='[Acq Share VERT (copy)_5028269015403311106]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qc_acq])/SUM([total_acq])' />
            </column>
            <column caption='Adoption Rate Orders ALL' datatype='real' name='[Adoption Rate Orders VERT (copy)_5028269015452221448]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([adopter_orders])/SUM([total_ord_qc])' />
