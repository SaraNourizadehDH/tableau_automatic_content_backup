    <worksheet name='Data Quality Table'>
      <table>
        <view>
          <datasources>
            <datasource caption='Data Availability &amp; Quality' name='federated.1lu9i861m2kujv1fh20081u857x7' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Daily' caption='Date View' datatype='string' datatype-customized='true' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;day&quot;'>
              <calculation class='tableau' formula='&quot;day&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;quarter&quot;' value='Quarterly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
            <column alias='Order Data Mismatch on CIT' caption='Data Validity Parameter' datatype='string' datatype-customized='true' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;1&quot;'>
              <calculation class='tableau' formula='&quot;1&quot;' />
              <aliases>
                <alias key='&quot;1&quot;' value='Order Data Mismatch on CIT' />
                <alias key='&quot;2&quot;' value='Value Inaccuracy' />
                <alias key='&quot;3&quot;' value='Incentive Data Mismatch on CI' />
                <alias key='&quot;4&quot;' value='Incomplete Marketing Channel Information' />
                <alias key='&quot;5&quot;' value='Invalid Usage Outside Valid Period' />
                <alias key='&quot;6&quot;' value='Invalid Stacked Usage' />
                <alias key='&quot;7&quot;' value='Missing Monetary Data On CI' />
                <alias key='&quot;8&quot;' value='Missing Monetary Data On CIT' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1lu9i861m2kujv1fh20081u857x7'>
            <column caption='Value Accuracy (Amount/Percentage Incentives)' datatype='real' name='[Calculation_1329124874046976002]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([incentive_type] IN (&apos;amount&apos;, &apos;percentage&apos;) AND [incentive_value_matches], [order_count], 0)) / &#13;&#10;SUM(IIF([incentive_type] IN (&apos;amount&apos;, &apos;percentage&apos;), [order_count], 0))' />
            </column>
            <column caption='Incomplete Marketing Channel (Incentive Purpose) Information' datatype='real' name='[Calculation_1329124874048778244]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([is_marketing_spend] AND NOT [is_marketing_channel_available], [order_count], 0)) / SUM(IIF([is_marketing_spend], [order_count], 0))' />
            </column>
            <column caption='Invalid Stacked Usage' datatype='real' name='[Calculation_1329124874049171461]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([is_incentive_cit] AND [is_stacked] AND NOT [is_stackable], [order_count], 0)) &#13;&#10;/ SUM(IIF([is_incentive_cit], [order_count], 0))' />
            </column>
            <column caption='Incentive Data Mismatch on CI' datatype='real' name='[Calculation_1329124874049720328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([is_incentive_cit] AND [is_ci_data_available] != TRUE, [order_count], 0)) / SUM(IIF([is_incentive_cit], [order_count], 0))' />
            </column>
            <column caption='Date View' datatype='date' datatype-customized='true' name='[Calculation_447826713072431109]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parameter 3], [created_date], &apos;monday&apos;))' />
            </column>
            <column caption='Data Validity Variable' datatype='real' name='[Calculation_447826713089142790]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#13;&#10;WHEN &apos;1&apos;  THEN [Missing CI Data (copy)_1329124874049875977]&#13;&#10;WHEN &apos;2&apos;  THEN 1 - [Calculation_1329124874046976002]&#13;&#10;WHEN &apos;3&apos;  THEN [Calculation_1329124874049720328]&#13;&#10;WHEN &apos;4&apos;  THEN [Calculation_1329124874048778244]&#13;&#10;WHEN &apos;5&apos;  THEN [Readiness Score (copy)_1005710128253882369]&#13;&#10;WHEN &apos;6&apos;  THEN [Calculation_1329124874049171461]&#13;&#10;WHEN &apos;7&apos;  THEN [Missing CI Data (copy)_704813376456777728]&#13;&#10;WHEN &apos;8&apos;  THEN [Missing CIT Data (copy)_704813376456802305]&#13;&#10;END' />
            </column>
            <column caption='Order Data Mismatch on CIT' datatype='real' name='[Missing CI Data (copy)_1329124874049875977]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([is_incentive_ord] AND [is_incentive_cit] != TRUE, [order_count], 0)) / SUM(IIF([is_incentive_ord], [order_count], 0))' />
            </column>
            <column caption='Missing Monetary Data On CI' datatype='real' name='[Missing CI Data (copy)_704813376456777728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([is_incentive_cit] AND [is_ci_monetary_data_available] != TRUE, [order_count], 0)) / SUM(IIF([is_incentive_cit], [order_count], 0))' />
            </column>
            <column caption='Missing Monetary Data On CIT' datatype='real' name='[Missing CIT Data (copy)_704813376456802305]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([is_incentive_cit] AND [is_cit_monetary_data_available] != TRUE, [order_count], 0)) / SUM(IIF([is_incentive_cit], [order_count], 0))' />
            </column>
            <column caption='Invalid Usage Outside Valid Period' datatype='real' name='[Readiness Score (copy)_1005710128253882369]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([is_incentive_cit] AND [is_within_valid_period] = FALSE, [order_count], 0)) / &#13;&#10;SUM(IIF([is_incentive_cit], [order_count], 0))' />
            </column>
