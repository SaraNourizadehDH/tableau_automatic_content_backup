    <worksheet name='Executive Sheet'>
      <table>
        <view>
          <datasources>
            <datasource caption='Data Availability &amp; Quality' name='federated.1lu9i861m2kujv1fh20081u857x7' />
          </datasources>
          <datasource-dependencies datasource='federated.1lu9i861m2kujv1fh20081u857x7'>
            <column caption='Value Accuracy (Amount/Percentage Incentives)' datatype='real' name='[Calculation_1329124874046976002]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([incentive_type] IN (&apos;amount&apos;, &apos;percentage&apos;) AND [incentive_value_matches], [order_count], 0)) / &#13;&#10;SUM(IIF([incentive_type] IN (&apos;amount&apos;, &apos;percentage&apos;), [order_count], 0))' />
            </column>
            <column caption='Data Validity' datatype='real' name='[Calculation_1329124874047315971]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([is_incentive_cit] AND&#13;&#10;        [is_cit_monetary_data_available] AND&#13;&#10;        [is_ci_data_available] AND &#13;&#10;        [is_ci_monetary_data_available] AND&#13;&#10;        ([is_within_valid_period] OR ISNULL([is_within_valid_period])) AND&#13;&#10;        NOT ([is_stacked] AND NOT [is_stackable]) AND&#13;&#10;        NOT (NOT [is_marketing_channel_available] AND [is_marketing_spend]),&#13;&#10;        [order_count],&#13;&#10;        0)) &#13;&#10;/ &#13;&#10;SUM(IIF([is_incentive_cit], [order_count], 0))' />
            </column>
            <column caption='Wallet Inc. Tracked' datatype='string' name='[Calculation_3787105101319311360]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IIF(IFNULL(MAX([has_wallet_inc]), FALSE) = TRUE, &apos;YES&apos;, &apos;NO&apos;)' />
            </column>
            <column caption='% of Orders w/ Incentives' datatype='real' name='[Calculation_890305385699037193]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF(ISNULL([is_incentive_cit]), IIF([is_incentive_ord], [order_count], 0), IIF([is_incentive_cit], [order_count], 0))) /&#10;SUM([order_count])' />
            </column>
            <column caption='Incentive Readiness' datatype='string' name='[Calculation_890305385699651594]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF     [Readiness Score (copy)_1174946934568509441] &gt; 0.9 THEN &apos;YES&apos;&#13;&#10;ELSEIF [Readiness Score (copy)_1174946934568509441] &gt; 0.5 THEN &apos;PARTIAL&apos;&#13;&#10;ELSEIF [Readiness Score (copy)_1174946934568509441] &gt; 0.3 THEN &apos;LOW&apos;&#13;&#10;ELSE &apos;NO&apos;&#13;&#10;END' />
            </column>
            <column caption='Discounts Tracked ' datatype='string' name='[Calculation_890305385702445068]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IIF(IFNULL(MAX([has_discount]), FALSE) = TRUE, &apos;YES&apos;, &apos;NO&apos;)' />
            </column>
            <column caption='Item Incentives Tracked' datatype='string' name='[Discounts Tracked  (copy)_625437433275138053]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IIF(IFNULL(MAX([has_item_inc]), FALSE) = TRUE, &apos;YES&apos;, &apos;NO&apos;)' />
            </column>
            <column caption='Delivery Fee Incentives Tracked' datatype='string' name='[Discounts Tracked  (copy)_890305385702920205]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IIF(IFNULL(MAX([has_deliveryfee_inc]), FALSE) = TRUE, &apos;YES&apos;, &apos;NO&apos;)' />
            </column>
            <column caption='Vouchers Tracked ' datatype='string' name='[Discounts Tracked  (copy)_890305385703096334]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IIF(IFNULL(MAX([has_voucher]), FALSE) = TRUE, &apos;YES&apos;, &apos;NO&apos;)' />
            </column>
            <column caption='Readiness Score' datatype='real' name='[Readiness Score (copy)_1174946934568509441]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Value Accuracy (Amount/Percentage Incentives) (copy)_1174946934567362560] * [Calculation_1329124874047315971] * 0.7) + (&#13;&#10;    IIF(SUM(IIF([has_voucher],1,0)) &gt; 0, 0.1, 0) + &#13;&#10;    IIF(SUM(IIF([has_discount], 1,0)) &gt; 0, 0.1, 0) + &#13;&#10;    IIF(SUM(IIF([has_deliveryfee_inc], 1, 0)) &gt; 0, 0.05, 0) + &#13;&#10;    IIF(SUM(IIF([has_item_inc], 1, 0)) &gt; 0, 0.05, 0)&#13;&#10;)' />
            </column>
            <column caption='Value Accuracy' datatype='real' name='[Value Accuracy (Amount/Percentage Incentives) (copy)_1174946934567362560]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([incentive_type] != &apos;No Incentive&apos; AND [incentive_value_matches], [order_count], 0)) / &#10;SUM(IIF([incentive_type] != &apos;No Incentive&apos;, [order_count], 0))' />
            </column>
            <column caption='Brand' datatype='string' name='[brand]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Order Date' datatype='date' name='[created_date]' role='dimension' type='ordinal' />
            <column caption='Display Name' datatype='string' name='[display_name]' role='dimension' type='nominal' />
            <column caption='Has Deliveryfee Inc' datatype='boolean' name='[has_deliveryfee_inc]' role='dimension' type='nominal' />
            <column caption='Has Discount' datatype='boolean' name='[has_discount]' role='dimension' type='nominal' />
            <column caption='Has Item Inc' datatype='boolean' name='[has_item_inc]' role='dimension' type='nominal' />
            <column caption='Has Voucher' datatype='boolean' name='[has_voucher]' role='dimension' type='nominal' />
            <column caption='Has Wallet Inc.' datatype='boolean' name='[has_wallet_inc]' role='dimension' type='nominal' />
            <column caption='Incentive Type (on Order Level)' datatype='string' name='[incentive_type]' role='dimension' type='nominal' />
            <column caption='Incentive Value Matches' datatype='boolean' name='[incentive_value_matches]' role='dimension' type='nominal' />
