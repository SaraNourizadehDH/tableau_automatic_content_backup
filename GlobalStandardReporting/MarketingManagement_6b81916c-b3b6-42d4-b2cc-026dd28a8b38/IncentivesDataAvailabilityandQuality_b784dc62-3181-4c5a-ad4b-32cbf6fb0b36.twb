    <worksheet name='Sanity Variable Explanation'>
      <table>
        <view>
          <datasources>
            <datasource caption='Data Availability &amp; Quality' name='federated.1lu9i861m2kujv1fh20081u857x7' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Order Data Mismatch on CIT' caption='Data Validity Parameter' datatype='string' datatype-customized='true' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;1&quot;'>
              <calculation class='tableau' formula='&quot;1&quot;' />
              <aliases>
                <alias key='&quot;1&quot;' value='Order Data Mismatch on CIT' />
                <alias key='&quot;2&quot;' value='Value Inaccuracy' />
                <alias key='&quot;3&quot;' value='Incentive Data Mismatch on CI' />
                <alias key='&quot;4&quot;' value='Incomplete Marketing Channel Information' />
                <alias key='&quot;5&quot;' value='Invalid Usage Outside Valid Period' />
                <alias key='&quot;6&quot;' value='Invalid Stacked Usage' />
                <alias key='&quot;7&quot;' value='Missing Monetary Data On CI' />
                <alias key='&quot;8&quot;' value='Missing Monetary Data On CIT' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1lu9i861m2kujv1fh20081u857x7'>
            <column caption='Data Validity Variable Explanation' datatype='string' name='[Sanity Variable Explanation (copy)_217861658891972609]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#13;&#10;WHEN &apos;1&apos; THEN &apos;We assume Order Stream to be the ground truth. This variable checks if each order with an incentive on ORD stream has a corresponding entry on CIT stream, or not.&apos;&#13;&#10;WHEN &apos;2&apos; THEN &apos;We assume Order Stream to be the ground truth. This variable checks if the matching orders between ORD and CIT streams have matching incentive totals, or not.&apos;&#13;&#10;WHEN &apos;3&apos; THEN &apos;We expect each incentive usage on CIT to have a corresponding entry on CI stream in order to retrieve details. This variable checks the share of incentive usages on CIT that misses CI entries.&apos;&#13;&#10;WHEN &apos;4&apos; THEN &apos;We expect to know the marketing channel of each incentivised order by the marketing team. This variable checks the share of orders missing that information.&apos; &#13;&#10;WHEN &apos;5&apos; THEN &apos;Each incentive is defined with a validity period. This variable checks activations outside the validity period.&apos;&#13;&#10;WHEN &apos;6&apos; THEN &apos;Each incentive comes with a rule stating if they can be stacked, or not. This variable checks the share of Orders which are Stacked according to CIT but the rule stating otherwise.&apos;&#13;&#10;WHEN &apos;7&apos; THEN &apos;Checks if sponsorships ratios was supplied in the definition of an incentive on CI stream. This helps us to define who paid the incentive.&apos;&#13;&#10;WHEN &apos;8&apos; THEN &apos;Checks if actual incentive amount was supplied with the incentive transaction on CIT stream.&apos;&#13;&#10;END' />
            </column>
            <column caption='Brand' datatype='string' name='[brand]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Order Date' datatype='date' name='[created_date]' role='dimension' type='ordinal' />
            <column caption='Display Name' datatype='string' name='[display_name]' role='dimension' type='nominal' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column-instance column='[Sanity Variable Explanation (copy)_217861658891972609]' derivation='None' name='[none:Sanity Variable Explanation (copy)_217861658891972609:nk]' pivot='key' type='nominal' />
            <column-instance column='[brand]' derivation='None' name='[none:brand:nk]' pivot='key' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column-instance column='[created_date]' derivation='None' name='[none:created_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[display_name]' derivation='None' name='[none:display_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[management_entity]' derivation='None' name='[none:management_entity:nk]' pivot='key' type='nominal' />
            <column-instance column='[segment]' derivation='None' name='[none:segment:nk]' pivot='key' type='nominal' />
            <column caption='Segment' datatype='string' name='[segment]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <slices>
            <column>[federated.1lu9i861m2kujv1fh20081u857x7].[none:management_entity:nk]</column>
            <column>[federated.1lu9i861m2kujv1fh20081u857x7].[none:display_name:nk]</column>
            <column>[federated.1lu9i861m2kujv1fh20081u857x7].[none:segment:nk]</column>
            <column>[federated.1lu9i861m2kujv1fh20081u857x7].[none:brand:nk]</column>
            <column>[federated.1lu9i861m2kujv1fh20081u857x7].[none:country:nk]</column>
            <column>[federated.1lu9i861m2kujv1fh20081u857x7].[none:created_date:qk]</column>
          </slices>
          <aggregation value='true' />
        </view>
