  <worksheets>
    <worksheet name='Breakdown by Type'>
      <table>
        <view>
          <datasources>
            <datasource caption='Data Availability &amp; Quality' name='federated.1lu9i861m2kujv1fh20081u857x7' />
          </datasources>
          <datasource-dependencies datasource='federated.1lu9i861m2kujv1fh20081u857x7'>
            <column caption='% of Orders w/ Incentives (Percentage)' datatype='real' name='[% of Orders w/ Incentives (copy) (copy) (copy) (copy)_625437433272000516]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([incentive_type] = &apos;percentage&apos;, [order_count], 0)) / SUM([order_count])' />
            </column>
            <column caption='% of Orders w/ Incentives (Item Incentives)' datatype='real' name='[% of Orders w/ Incentives (copy) (copy) (copy)_625437433271988227]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([incentive_type] IN (&apos;bxgy&apos;, &apos;free_gift&apos;), [order_count], 0)) / SUM([order_count])' />
            </column>
            <column caption='% of Orders w/ Incentives (Delivery Fee)' datatype='real' name='[% of Orders w/ Incentives (copy) (copy)_625437433271975938]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([incentive_type] = &apos;delivery_fee&apos;, [order_count], 0)) / SUM([order_count])' />
            </column>
            <column caption='% of Orders w/ Incentives (Amount)' datatype='real' name='[% of Orders w/ Incentives (copy)_625437433271963649]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([incentive_type] = &apos;amount&apos; , [order_count], 0)) / SUM([order_count])' />
            </column>
            <column caption='Value Accuracy (Amount/Percentage Incentives)' datatype='real' name='[Calculation_1329124874046976002]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([incentive_type] IN (&apos;amount&apos;, &apos;percentage&apos;) AND [incentive_value_matches], [order_count], 0)) / &#13;&#10;SUM(IIF([incentive_type] IN (&apos;amount&apos;, &apos;percentage&apos;), [order_count], 0))' />
            </column>
            <column caption='Data Validity (Delivery Fee)' datatype='real' name='[Data Validity (Vouchers) (copy) (copy)_890305385695498247]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([incentive_type] = &apos;delivery_fee&apos; AND&#13;&#10;        [is_incentive_cit] AND&#13;&#10;        [is_cit_monetary_data_available] AND&#13;&#10;        [is_ci_data_available] AND &#13;&#10;        [is_ci_monetary_data_available] AND&#13;&#10;        NOT ([is_stacked] AND NOT [is_stackable]) AND&#13;&#10;        NOT (NOT [is_marketing_channel_available] AND [is_marketing_spend]),&#13;&#10;        [order_count],&#13;&#10;        0)) &#13;&#10;/ &#13;&#10;SUM(IIF([incentive_type] = &apos;delivery_fee&apos; AND [is_incentive_cit], [order_count], 0))' />
            </column>
            <column caption='Data Validity (Item Incentives)' datatype='real' name='[Data Validity (Vouchers) (copy)_625437433270079488]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([incentive_type] IN (&apos;bxgy&apos;, &apos;free_gift&apos;) AND &#13;&#10;        [is_incentive_cit] AND&#13;&#10;        [is_cit_monetary_data_available] AND&#13;&#10;        [is_ci_data_available] AND &#13;&#10;        [is_ci_monetary_data_available] AND&#13;&#10;        NOT ([is_stacked] AND NOT [is_stackable]) AND&#13;&#10;        NOT (NOT [is_marketing_channel_available] AND [is_marketing_spend]),&#13;&#10;        [order_count],&#13;&#10;        0)) &#13;&#10;/ &#13;&#10;SUM(IIF([incentive_type] IN (&apos;bxgy&apos;, &apos;free_gift&apos;) AND [is_incentive_cit], [order_count], 0))' />
            </column>
            <column caption='Data Validity (Amount)' datatype='real' name='[Data Validity (Vouchers) (copy)_890305385695395846]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([incentive_type] = &apos;amount&apos; AND &#13;&#10;        [is_incentive_cit] AND&#13;&#10;        [is_cit_monetary_data_available] AND&#13;&#10;        [is_ci_data_available] AND &#13;&#10;        [is_ci_monetary_data_available] AND&#13;&#10;        NOT ([is_stacked] AND NOT [is_stackable]) AND&#13;&#10;        NOT (NOT [is_marketing_channel_available] AND [is_marketing_spend]),&#13;&#10;        [order_count],&#13;&#10;        0)) &#13;&#10;/ &#13;&#10;SUM(IIF([incentive_type] = &apos;amount&apos;  AND [is_incentive_cit], [order_count], 0))' />
            </column>
            <column caption='Data Validity (Percentage)' datatype='real' name='[Data Validity (copy)_890305385695346693]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([incentive_type] = &apos;percentage&apos; AND &#13;&#10;        [is_incentive_cit] AND&#13;&#10;        [is_cit_monetary_data_available] AND&#13;&#10;        [is_ci_data_available] AND &#13;&#10;        [is_ci_monetary_data_available] AND&#13;&#10;        NOT ([is_stacked] AND NOT [is_stackable]) AND&#13;&#10;        NOT (NOT [is_marketing_channel_available] AND [is_marketing_spend]),&#13;&#10;        [order_count],&#13;&#10;        0)) &#13;&#10;/ &#13;&#10;SUM(IIF([incentive_type] = &apos;percentage&apos;  AND [is_incentive_cit], [order_count], 0))' />
            </column>
            <column caption='Value Accuracy (Amount)' datatype='real' name='[Value Accuracy (Vouchers) (copy)_890305385695174659]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([incentive_type] = &apos;amount&apos; AND [incentive_value_matches], [order_count], 0)) / SUM(IIF([incentive_type] = &apos;amount&apos;, [order_count], 0))' />
            </column>
            <column caption='Value Accuracy (Percentage)' datatype='real' name='[Value Accuracy (copy)_890305385695137794]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([incentive_type] = &apos;percentage&apos; AND [incentive_value_matches], [order_count], 0)) / &#13;&#10;SUM(IIF([incentive_type] = &apos;percentage&apos;, [order_count], 0))' />
            </column>
