    <worksheet name='Sanity Variable Formulae'>
      <table>
        <view>
          <datasources>
            <datasource caption='Data Availability &amp; Quality' name='federated.1lu9i861m2kujv1fh20081u857x7' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Order Data Mismatch on CIT' caption='Data Validity Parameter' datatype='string' datatype-customized='true' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;1&quot;'>
              <calculation class='tableau' formula='&quot;1&quot;' />
              <aliases>
                <alias key='&quot;1&quot;' value='Order Data Mismatch on CIT' />
                <alias key='&quot;2&quot;' value='Value Inaccuracy' />
                <alias key='&quot;3&quot;' value='Incentive Data Mismatch on CI' />
                <alias key='&quot;4&quot;' value='Incomplete Marketing Channel Information' />
                <alias key='&quot;5&quot;' value='Invalid Usage Outside Valid Period' />
                <alias key='&quot;6&quot;' value='Invalid Stacked Usage' />
                <alias key='&quot;7&quot;' value='Missing Monetary Data On CI' />
                <alias key='&quot;8&quot;' value='Missing Monetary Data On CIT' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1lu9i861m2kujv1fh20081u857x7'>
            <column caption='Data Validity Variable Formulae' datatype='string' name='[Sanity Variable (copy)_217861658891132928]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#13;&#10;WHEN &apos;1&apos; THEN &apos;Orders which have an incentive on ORD but not on CIT / Orders which have an incentive on ORD&apos;&#13;&#10;WHEN &apos;2&apos; THEN &apos;Orders with Incentives that does not share the same total incentive amount on CIT and ORD / Orders which have an incentive on ORD&apos;&#13;&#10;WHEN &apos;3&apos; THEN &apos;Orders which have an incentive on CIT but no matching incentive on CI / Orders which have an incentive on CIT&apos;&#13;&#10;WHEN &apos;4&apos; THEN &apos;Orders with CARC Incentives without a valid marketing channel / Orders with CARC Incentives&apos;&#13;&#10;WHEN &apos;5&apos; THEN &apos;Orders which have an incentive on CIT with incentive(s) outside their validity period / Orders which have an incentive on CIT&apos;&#13;&#10;WHEN &apos;6&apos; THEN &apos;Invalid Stacked Usage on CIT / Orders which have an incentive on CIT&apos;&#13;&#10;WHEN &apos;7&apos; THEN &apos;Orders which have an incentive on CIT but does not have sponsorship information on CI / Orders which have an incentive on CIT&apos;&#13;&#10;WHEN &apos;8&apos; THEN &apos;Orders which are incentivised on ORD but lacks incentive amount information (NULL) on CIT / Orders which have an incentive on ORD&apos;&#13;&#10;END' />
            </column>
            <column caption='Brand' datatype='string' name='[brand]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
