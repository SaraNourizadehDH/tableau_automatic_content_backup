      <aliases enabled='yes' />
      <column caption='% of Orders w/ Incentives (Percentage)' datatype='real' name='[% of Orders w/ Incentives (copy) (copy) (copy) (copy)_625437433272000516]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([incentive_type] = &apos;percentage&apos;, [order_count], 0)) / SUM([order_count])' />
      </column>
      <column caption='% of Orders w/ Incentives (Item Incentives)' datatype='real' name='[% of Orders w/ Incentives (copy) (copy) (copy)_625437433271988227]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([incentive_type] IN (&apos;bxgy&apos;, &apos;free_gift&apos;), [order_count], 0)) / SUM([order_count])' />
      </column>
      <column caption='% of Orders w/ Incentives (Delivery Fee)' datatype='real' name='[% of Orders w/ Incentives (copy) (copy)_625437433271975938]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([incentive_type] = &apos;delivery_fee&apos;, [order_count], 0)) / SUM([order_count])' />
      </column>
      <column caption='% of Orders w/ Incentives (Amount)' datatype='real' name='[% of Orders w/ Incentives (copy)_625437433271963649]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([incentive_type] = &apos;amount&apos; , [order_count], 0)) / SUM([order_count])' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1lu9i861m2kujv1fh20081u857x7].[usr:Calculation_1329124874046976002:qk]&quot;' value='Value Accuracy   ( Amount / Percentage Inc)' />
        </aliases>
      </column>
      <column caption='Incentivised Orders per Day' datatype='real' hidden='true' name='[Calculation_1005710128226926592]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([is_incentive_ord], [order_count], 0)) / COUNTD([created_date])' />
      </column>
      <column caption='Value Accuracy (Amount/Percentage Incentives)' datatype='real' name='[Calculation_1329124874046976002]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([incentive_type] IN (&apos;amount&apos;, &apos;percentage&apos;) AND [incentive_value_matches], [order_count], 0)) / &#13;&#10;SUM(IIF([incentive_type] IN (&apos;amount&apos;, &apos;percentage&apos;), [order_count], 0))' />
      </column>
      <column caption='Data Validity' datatype='real' name='[Calculation_1329124874047315971]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([is_incentive_cit] AND&#13;&#10;        [is_cit_monetary_data_available] AND&#13;&#10;        [is_ci_data_available] AND &#13;&#10;        [is_ci_monetary_data_available] AND&#13;&#10;        ([is_within_valid_period] OR ISNULL([is_within_valid_period])) AND&#13;&#10;        NOT ([is_stacked] AND NOT [is_stackable]) AND&#13;&#10;        NOT (NOT [is_marketing_channel_available] AND [is_marketing_spend]),&#13;&#10;        [order_count],&#13;&#10;        0)) &#13;&#10;/ &#13;&#10;SUM(IIF([is_incentive_cit], [order_count], 0))' />
      </column>
      <column caption='Incomplete Marketing Channel (Incentive Purpose) Information' datatype='real' name='[Calculation_1329124874048778244]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([is_marketing_spend] AND NOT [is_marketing_channel_available], [order_count], 0)) / SUM(IIF([is_marketing_spend], [order_count], 0))' />
      </column>
      <column caption='Invalid Stacked Usage' datatype='real' name='[Calculation_1329124874049171461]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([is_incentive_cit] AND [is_stacked] AND NOT [is_stackable], [order_count], 0)) &#13;&#10;/ SUM(IIF([is_incentive_cit], [order_count], 0))' />
      </column>
      <column caption='Incentive Data Mismatch on CI' datatype='real' name='[Calculation_1329124874049720328]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([is_incentive_cit] AND [is_ci_data_available] != TRUE, [order_count], 0)) / SUM(IIF([is_incentive_cit], [order_count], 0))' />
      </column>
      <column caption='Go to Documentation' datatype='string' name='[Calculation_282319444169326592]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Please klick here to access&#13;&#10; dashboard documentation.&apos;' />
      </column>
      <column caption='Wallet Inc. Tracked' datatype='string' name='[Calculation_3787105101319311360]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IIF(IFNULL(MAX([has_wallet_inc]), FALSE) = TRUE, &apos;YES&apos;, &apos;NO&apos;)' />
      </column>
      <column caption='Date View' datatype='date' datatype-customized='true' name='[Calculation_447826713072431109]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parameter 3], [created_date], &apos;monday&apos;))' />
      </column>
      <column caption='Data Validity Variable' datatype='real' name='[Calculation_447826713089142790]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#13;&#10;WHEN &apos;1&apos;  THEN [Missing CI Data (copy)_1329124874049875977]&#13;&#10;WHEN &apos;2&apos;  THEN 1 - [Calculation_1329124874046976002]&#13;&#10;WHEN &apos;3&apos;  THEN [Calculation_1329124874049720328]&#13;&#10;WHEN &apos;4&apos;  THEN [Calculation_1329124874048778244]&#13;&#10;WHEN &apos;5&apos;  THEN [Readiness Score (copy)_1005710128253882369]&#13;&#10;WHEN &apos;6&apos;  THEN [Calculation_1329124874049171461]&#13;&#10;WHEN &apos;7&apos;  THEN [Missing CI Data (copy)_704813376456777728]&#13;&#10;WHEN &apos;8&apos;  THEN [Missing CIT Data (copy)_704813376456802305]&#13;&#10;END' />
      </column>
      <column caption='Last Day Filter' datatype='boolean' hidden='true' name='[Calculation_890305385681014784]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([created_date] = DATEADD(&apos;day&apos;, -1, TODAY()), TRUE, FALSE)' />
      </column>
      <column caption='% of Orders w/ Incentives' datatype='real' name='[Calculation_890305385699037193]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF(ISNULL([is_incentive_cit]), IIF([is_incentive_ord], [order_count], 0), IIF([is_incentive_cit], [order_count], 0))) /&#10;SUM([order_count])' />
      </column>
      <column caption='Incentive Readiness' datatype='string' name='[Calculation_890305385699651594]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF     [Readiness Score (copy)_1174946934568509441] &gt; 0.9 THEN &apos;YES&apos;&#13;&#10;ELSEIF [Readiness Score (copy)_1174946934568509441] &gt; 0.5 THEN &apos;PARTIAL&apos;&#13;&#10;ELSEIF [Readiness Score (copy)_1174946934568509441] &gt; 0.3 THEN &apos;LOW&apos;&#13;&#10;ELSE &apos;NO&apos;&#13;&#10;END' />
      </column>
      <column caption='% of Orders with Invalid Data' datatype='real' name='[Calculation_890305385701433355]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - [Calculation_1329124874047315971]' />
      </column>
      <column caption='Discounts Tracked ' datatype='string' name='[Calculation_890305385702445068]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IIF(IFNULL(MAX([has_discount]), FALSE) = TRUE, &apos;YES&apos;, &apos;NO&apos;)' />
      </column>
      <column caption='Data Validity (Delivery Fee)' datatype='real' name='[Data Validity (Vouchers) (copy) (copy)_890305385695498247]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([incentive_type] = &apos;delivery_fee&apos; AND&#13;&#10;        [is_incentive_cit] AND&#13;&#10;        [is_cit_monetary_data_available] AND&#13;&#10;        [is_ci_data_available] AND &#13;&#10;        [is_ci_monetary_data_available] AND&#13;&#10;        NOT ([is_stacked] AND NOT [is_stackable]) AND&#13;&#10;        NOT (NOT [is_marketing_channel_available] AND [is_marketing_spend]),&#13;&#10;        [order_count],&#13;&#10;        0)) &#13;&#10;/ &#13;&#10;SUM(IIF([incentive_type] = &apos;delivery_fee&apos; AND [is_incentive_cit], [order_count], 0))' />
      </column>
      <column caption='Data Validity (Item Incentives)' datatype='real' name='[Data Validity (Vouchers) (copy)_625437433270079488]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([incentive_type] IN (&apos;bxgy&apos;, &apos;free_gift&apos;) AND &#13;&#10;        [is_incentive_cit] AND&#13;&#10;        [is_cit_monetary_data_available] AND&#13;&#10;        [is_ci_data_available] AND &#13;&#10;        [is_ci_monetary_data_available] AND&#13;&#10;        NOT ([is_stacked] AND NOT [is_stackable]) AND&#13;&#10;        NOT (NOT [is_marketing_channel_available] AND [is_marketing_spend]),&#13;&#10;        [order_count],&#13;&#10;        0)) &#13;&#10;/ &#13;&#10;SUM(IIF([incentive_type] IN (&apos;bxgy&apos;, &apos;free_gift&apos;) AND [is_incentive_cit], [order_count], 0))' />
      </column>
      <column caption='Data Validity (Amount)' datatype='real' name='[Data Validity (Vouchers) (copy)_890305385695395846]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([incentive_type] = &apos;amount&apos; AND &#13;&#10;        [is_incentive_cit] AND&#13;&#10;        [is_cit_monetary_data_available] AND&#13;&#10;        [is_ci_data_available] AND &#13;&#10;        [is_ci_monetary_data_available] AND&#13;&#10;        NOT ([is_stacked] AND NOT [is_stackable]) AND&#13;&#10;        NOT (NOT [is_marketing_channel_available] AND [is_marketing_spend]),&#13;&#10;        [order_count],&#13;&#10;        0)) &#13;&#10;/ &#13;&#10;SUM(IIF([incentive_type] = &apos;amount&apos;  AND [is_incentive_cit], [order_count], 0))' />
      </column>
      <column caption='Data Validity (Percentage)' datatype='real' name='[Data Validity (copy)_890305385695346693]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([incentive_type] = &apos;percentage&apos; AND &#13;&#10;        [is_incentive_cit] AND&#13;&#10;        [is_cit_monetary_data_available] AND&#13;&#10;        [is_ci_data_available] AND &#13;&#10;        [is_ci_monetary_data_available] AND&#13;&#10;        NOT ([is_stacked] AND NOT [is_stackable]) AND&#13;&#10;        NOT (NOT [is_marketing_channel_available] AND [is_marketing_spend]),&#13;&#10;        [order_count],&#13;&#10;        0)) &#13;&#10;/ &#13;&#10;SUM(IIF([incentive_type] = &apos;percentage&apos;  AND [is_incentive_cit], [order_count], 0))' />
