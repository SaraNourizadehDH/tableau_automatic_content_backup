      </column>
      <column caption='Missing Monetary Data On CIT' datatype='real' name='[Missing CIT Data (copy)_704813376456802305]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([is_incentive_cit] AND [is_cit_monetary_data_available] != TRUE, [order_count], 0)) / SUM(IIF([is_incentive_cit], [order_count], 0))' />
      </column>
      <column caption='Invalid Usage Outside Valid Period' datatype='real' name='[Readiness Score (copy)_1005710128253882369]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([is_incentive_cit] AND [is_within_valid_period] = FALSE, [order_count], 0)) / &#13;&#10;SUM(IIF([is_incentive_cit], [order_count], 0))' />
      </column>
      <column caption='Readiness Score' datatype='real' name='[Readiness Score (copy)_1174946934568509441]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Value Accuracy (Amount/Percentage Incentives) (copy)_1174946934567362560] * [Calculation_1329124874047315971] * 0.7) + (&#13;&#10;    IIF(SUM(IIF([has_voucher],1,0)) &gt; 0, 0.1, 0) + &#13;&#10;    IIF(SUM(IIF([has_discount], 1,0)) &gt; 0, 0.1, 0) + &#13;&#10;    IIF(SUM(IIF([has_deliveryfee_inc], 1, 0)) &gt; 0, 0.05, 0) + &#13;&#10;    IIF(SUM(IIF([has_item_inc], 1, 0)) &gt; 0, 0.05, 0)&#13;&#10;)' />
      </column>
      <column caption='Data Validity Variable Formulae' datatype='string' name='[Sanity Variable (copy)_217861658891132928]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#13;&#10;WHEN &apos;1&apos; THEN &apos;Orders which have an incentive on ORD but not on CIT / Orders which have an incentive on ORD&apos;&#13;&#10;WHEN &apos;2&apos; THEN &apos;Orders with Incentives that does not share the same total incentive amount on CIT and ORD / Orders which have an incentive on ORD&apos;&#13;&#10;WHEN &apos;3&apos; THEN &apos;Orders which have an incentive on CIT but no matching incentive on CI / Orders which have an incentive on CIT&apos;&#13;&#10;WHEN &apos;4&apos; THEN &apos;Orders with CARC Incentives without a valid marketing channel / Orders with CARC Incentives&apos;&#13;&#10;WHEN &apos;5&apos; THEN &apos;Orders which have an incentive on CIT with incentive(s) outside their validity period / Orders which have an incentive on CIT&apos;&#13;&#10;WHEN &apos;6&apos; THEN &apos;Invalid Stacked Usage on CIT / Orders which have an incentive on CIT&apos;&#13;&#10;WHEN &apos;7&apos; THEN &apos;Orders which have an incentive on CIT but does not have sponsorship information on CI / Orders which have an incentive on CIT&apos;&#13;&#10;WHEN &apos;8&apos; THEN &apos;Orders which are incentivised on ORD but lacks incentive amount information (NULL) on CIT / Orders which have an incentive on ORD&apos;&#13;&#10;END' />
      </column>
      <column caption='Data Validity Variable Explanation' datatype='string' name='[Sanity Variable Explanation (copy)_217861658891972609]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#13;&#10;WHEN &apos;1&apos; THEN &apos;We assume Order Stream to be the ground truth. This variable checks if each order with an incentive on ORD stream has a corresponding entry on CIT stream, or not.&apos;&#13;&#10;WHEN &apos;2&apos; THEN &apos;We assume Order Stream to be the ground truth. This variable checks if the matching orders between ORD and CIT streams have matching incentive totals, or not.&apos;&#13;&#10;WHEN &apos;3&apos; THEN &apos;We expect each incentive usage on CIT to have a corresponding entry on CI stream in order to retrieve details. This variable checks the share of incentive usages on CIT that misses CI entries.&apos;&#13;&#10;WHEN &apos;4&apos; THEN &apos;We expect to know the marketing channel of each incentivised order by the marketing team. This variable checks the share of orders missing that information.&apos; &#13;&#10;WHEN &apos;5&apos; THEN &apos;Each incentive is defined with a validity period. This variable checks activations outside the validity period.&apos;&#13;&#10;WHEN &apos;6&apos; THEN &apos;Each incentive comes with a rule stating if they can be stacked, or not. This variable checks the share of Orders which are Stacked according to CIT but the rule stating otherwise.&apos;&#13;&#10;WHEN &apos;7&apos; THEN &apos;Checks if sponsorships ratios was supplied in the definition of an incentive on CI stream. This helps us to define who paid the incentive.&apos;&#13;&#10;WHEN &apos;8&apos; THEN &apos;Checks if actual incentive amount was supplied with the incentive transaction on CIT stream.&apos;&#13;&#10;END' />
      </column>
      <column caption='Value Accuracy' datatype='real' name='[Value Accuracy (Amount/Percentage Incentives) (copy)_1174946934567362560]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([incentive_type] != &apos;No Incentive&apos; AND [incentive_value_matches], [order_count], 0)) / &#10;SUM(IIF([incentive_type] != &apos;No Incentive&apos;, [order_count], 0))' />
      </column>
      <column caption='Value Accuracy (Amount)' datatype='real' name='[Value Accuracy (Vouchers) (copy)_890305385695174659]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([incentive_type] = &apos;amount&apos; AND [incentive_value_matches], [order_count], 0)) / SUM(IIF([incentive_type] = &apos;amount&apos;, [order_count], 0))' />
      </column>
      <column caption='Value Accuracy (Percentage)' datatype='real' name='[Value Accuracy (copy)_890305385695137794]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([incentive_type] = &apos;percentage&apos; AND [incentive_value_matches], [order_count], 0)) / &#13;&#10;SUM(IIF([incentive_type] = &apos;percentage&apos;, [order_count], 0))' />
      </column>
