              <calculation class='tableau' formula='if [Parameters].[Parameter 4]=1  then&#10;SUM (IF  [campaign_vertical]=&quot;ALL&quot; then [total_delivery] END)&#10;/&#10;SUM (IF  [campaign_vertical]=&quot;ALL&quot; then [total_recipients_push_email] END)&#10;&#10;ELSEIF  [Parameters].[Parameter 4]=2 then &#10;SUM (IF [campaign_vertical]=&quot;ALL&quot; then [total_delivery_lc] END)&#10;/&#10;SUM (IF [campaign_vertical]=&quot;ALL&quot; then [total_recipients_push_email] END)&#10;ELSEIF  [Parameters].[Parameter 4]=3 then&#10;SUM (IF  [campaign_vertical]=&quot;QC&quot; then [total_delivery] END)&#10;/&#10;SUM (IF [campaign_vertical]=&quot;ALL&quot; then [total_recipients_push_email] END)&#10;ELSEIF  [Parameters].[Parameter 4]=4 then&#10;SUM (IF [campaign_vertical]=&quot;ALL&quot;  then [total_active_users] END)&#10;ELSEIF  [Parameters].[Parameter 4]=5 then&#10;SUM (IF [campaign_vertical]=&quot;ALL&quot;  then [total_sends] END)&#10;ELSEIF  [Parameters].[Parameter 4]=7 then&#10;SUM (IF [campaign_vertical]=&quot;QC&quot;  then [total_sends] END)&#10;ELSEIF  [Parameters].[Parameter 4]=6 then&#10;SUM (IF [campaign_vertical]=&quot;ALL&quot;  then [total_sends_lc] END)&#10;ELSEIF  [Parameters].[Parameter 4] = 8 then &#10;(&#10;    SUM(IF  [campaign_vertical]=&quot;ALL&quot; then[total_delivery_lc] end)&#10;)&#10;/&#10;(&#10;    (&#10;        SUM(IF   [campaign_vertical]=&quot;ALL&quot; then total_delivery_lc end)&#10;    )&#10;    +&#10;    (&#10;        SUM(IF [campaign_vertical]=&quot;ALL&quot; then total_delivery_ac end)&#10;    )   &#10;)&#10;ELSEIF  [Parameters].[Parameter 4] =9 then &#10;(&#10;(&#10;    (&#10;       &#10;        SUM(IF [vertical_parent]=&quot;All&quot; and [is_gcg]=0 then [orders_month] END)&#10;        /SUM(IF [vertical_parent]=&quot;All&quot;  and [is_gcg]=0 then [cust_month] END)&#10;        &#10;    )&#10;    -&#10;    (&#10;        &#10;        SUM(IF [vertical_parent]=&quot;All&quot; and [is_gcg]=1 then [orders_month] END)&#10;        /    