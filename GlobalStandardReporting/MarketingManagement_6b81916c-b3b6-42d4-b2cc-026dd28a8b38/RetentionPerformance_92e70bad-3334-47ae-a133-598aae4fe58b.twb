              <calculation class='tableau' formula='SUM (IF [date_month]=[Parameters].[Parameter 3] and [campaign_vertical]=&quot;ALL&quot; then [total_delivery_lc] END)&#10;/&#10;SUM (IF [date_month]=[Parameters].[Parameter 3] and [campaign_vertical]=&quot;ALL&quot; then [total_recipients_push_email] END)' />
