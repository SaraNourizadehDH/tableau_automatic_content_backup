            <column _.fcp.ParameterDefaultValues.true...source-field='[sqlproxy.1a6ix4l1y9vzat1bd5xdu14s2jja].[date_month]' caption='Reporting month (p)' datatype='date' default-format='*mmm-yy' name='[Parameter 3]' param-domain-type='list' role='measure' type='quantitative' value='#2023-08-01#'>
              <calculation class='tableau' formula='#2023-08-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.1a6ix4l1y9vzat1bd5xdu14s2jja'>
            <column aggregation='User' caption='LC Comms Share RM' datatype='real' default-type='quantitative' layered='true' name='[% (Lifecycle) Total (copy)_4651585133638758402]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='(&#10;    SUM(IF [date_month]=[Parameters].[Parameter 3] and [campaign_vertical]=&quot;ALL&quot; then[total_delivery_lc] end)&#10;)&#10;/&#10;(&#10;    (&#10;        SUM(IF [date_month]=[Parameters].[Parameter 3] and [campaign_vertical]=&quot;ALL&quot; then total_delivery_lc end)&#10;    )&#10;    +&#10;    (&#10;        SUM(IF [date_month]=[Parameters].[Parameter 3]  and [campaign_vertical]=&quot;ALL&quot; then total_delivery_ac end)&#10;    )   &#10;)&#10;///SUM([total_delivery_lc]+[total_delivery_ac])' />
            </column>
            <column aggregation='User' caption='Contact Frequency RM' datatype='real' default-type='quantitative' layered='true' name='[Average Delivery Frequency (copy)_4651585133633069056]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='SUM (IF [date_month]=[Parameters].[Parameter 3] and [campaign_vertical]=&quot;ALL&quot; then [total_delivery] END)&#10;/&#10;SUM (IF [date_month]=[Parameters].[Parameter 3] and [campaign_vertical]=&quot;ALL&quot; then [total_recipients_push_email] END)' />
            </column>
            <column aggregation='Count' caption='Months to display' datatype='boolean' default-type='nominal' layered='true' name='[Calculation_1041527819171205122]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default'>
              <calculation class='tableau' formula='DATEDIFF(&quot;month&quot;,[date_month],[Parameters].[Parameter 3])&lt;= [Parameters].[Parameter 2]&#10;AND &#10;DATEDIFF(&quot;month&quot;,[date_month],[Parameters].[Parameter 3])&gt;= 0' />
            </column>
            <column aggregation='Count' caption='User Entitlements' datatype='boolean' default-type='nominal' layered='true' name='[Calculation_554153889626951681]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default' />
            <column aggregation='User' caption='MOM Contact Frequency RM ' datatype='real' default-type='quantitative' layered='true' name='[Contact Frequency RM (copy)_4651585133634396161]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='(&#10;[Average Delivery Frequency (copy)_4651585133633069056] -&#10;    (&#10;    SUM (IF [date_month]=DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 3]) and [campaign_vertical]=&quot;ALL&quot; then [total_delivery] END) &#10;&#10;    /&#10;&#10;    SUM (IF [date_month]=DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 3]) and [campaign_vertical]=&quot;ALL&quot; then [total_recipients_push_email] END)&#10;    )&#10;)&#10;/&#10;(&#10;    SUM (IF [date_month]=DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 3]) and [campaign_vertical]=&quot;ALL&quot;then [total_delivery] END) &#10;&#10;    /&#10;&#10;    SUM (IF [date_month]=DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 3]) and [campaign_vertical]=&quot;ALL&quot; then [total_recipients_push_email] END)&#10;    )' />
