          <datasource-dependencies datasource='Parameters'>
            <column alias='Last 6 months' caption='Months to show' datatype='integer' name='[Parameter 2]' param-domain-type='list' role='measure' type='quantitative' value='5'>
              <calculation class='tableau' formula='5' />
