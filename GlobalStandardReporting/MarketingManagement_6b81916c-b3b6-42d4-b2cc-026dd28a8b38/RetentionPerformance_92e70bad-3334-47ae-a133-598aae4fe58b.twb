      <column aggregation='User' caption='%  (iOS) Push Open Rate' datatype='real' default-type='quantitative' layered='true' name='[%  (Android) Push Open Rate (copy)_3279042748126236681]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
