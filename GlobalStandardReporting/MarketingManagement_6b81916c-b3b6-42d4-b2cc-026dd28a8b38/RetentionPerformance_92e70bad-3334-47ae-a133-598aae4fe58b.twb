0;        &#10;    )&#10;    -&#10;    (&#10;        &#10;        SUM(IF [vertical_parent]=&quot;All&quot;  and [is_gcg]=1 then [gbv_eur] END)&#10;        /       &#10;        SUM(IF [vertical_parent]=&quot;All&quot;  and [is_gcg]=1 then [cust_month] END)&#10;&#10;    )&#10;) * SUM(IF [vertical_parent]=&quot;All&quot;  and [is_gcg]=0 then [cust_month] END)&#10;)/&#10;        SUM(IF [vertical_parent]=&quot;All&quot;  and [is_gcg]=0 then [gbv_eur] END)&#10;ELSEIF  [Parameters].[Parameter 4]= 13 then&#10;&#10;&#10;SUM (IF [campaign_vertical]=&quot;ALL&quot;  then [total_reachable] END)&#10;/SUM (IF  [campaign_vertical]=&quot;ALL&quot;  then [total_active_users] END)&#10;ELSEIF  [Parameters].[Parameter 4]= 13.1 then&#10;&#10;&#10;SUM (IF [campaign_vertical]=&quot;ALL&quot;  then [total_push_reachable] END)&#10;/SUM (IF  [campaign_vertical]=&quot;ALL&quot;  then [total_active_users] END)&#10;ELSEIF  [Parameters].[Parameter 4]= 13.2 then&#10;&#10;&#10;SUM (IF [campaign_vertical]=&quot;ALL&quot;  then [total_email_reachable] END)&#10;/SUM (IF  [campaign_vertical]=&quot;ALL&quot;  then [total_active_users] END)&#10;ELSEIF  [Parameters].[Parameter 4]= 14 then&#10;&#10;&#10;SUM (IF  [campaign_vertical]=&quot;ALL&quot;  then [total_recipients_push_email] END)&#10;/SUM (IF  [campaign_vertical]=&quot;ALL&quot;  then [total_reachable] END)&#10;ELSEIF  [Parameters].[Parameter 4]= 15 then&#10;SUM (IF  [vertical_parent]=&quot;All&quot; then [cust_month] END)&#10;&#10;ELSEIF  [Parameters].[Parameter 4]= 16 then&#10;&#10;&#10;SUM (IF  [vertical_parent]=&quot;All&quot; then [orders_month] END)&#10;/&#10;SUM (IF  [vertical_parent]=&quot;All&quot; then [cust_month] END)&#10;&#10;ELSEIF  [Parameters].[Parameter 4]= 17 then&#10;SUM (IF  [vertical_parent]=&quot;All&quot; then [orders_month] END)&#10;&#10;ELSEIF  [Parameters].[Parameter 4]= 18 then&#10;&#10;&#10;SUM (IF  [vertical_parent]=&quot;All&quot; then [gbv_eur] END)&#10;/&#10;SUM (IF  [vertical_parent]=&quot;All&quot; then [orders_month] END)&#10;&#10;ELSEIF  [Parameters].[Parameter 4]= 19 then&#10;SUM (IF  [vertical_parent]=&quot;All&quot; then [gbv_eur] END)&#10;&#10;ELSEIF  [Parameters].[Parameter 4]= 20 then&#10;&#10;SUM (IF  [vertical_parent]=&quot;All&quot; then [voucher_eur] END)&#10;&#10;ELSEIF  [Parameters].[Parameter 4]= 21 then&#10;SUM (IF  [vertical_parent]=&quot;All&quot; then [delivery_fee_eur] END)&#10;&#10;ELSEIF  [Parameters].[Parameter 4]= 22 then&#10;SUM (IF  [vertical_parent]=&quot;All&quot; then [gmv_eur_month] END)&#10;&#10;END' />
      </column>
