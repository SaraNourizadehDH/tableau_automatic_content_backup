              <calculation class='tableau' formula='(sum([tg_gmv_eur_month]) / sum([Calculation_223842987122339840]) - sum([Calculation_675891791178104862]) / sum([Calculation_223842987122421761])) * sum([Calculation_223842987122339840])' />
