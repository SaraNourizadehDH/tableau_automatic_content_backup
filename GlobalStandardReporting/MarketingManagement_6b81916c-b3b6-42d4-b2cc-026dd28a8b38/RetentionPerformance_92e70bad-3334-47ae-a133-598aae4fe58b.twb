              <calculation class='tableau' formula='(&#10;(&#10;    (&#10;       &#10;        SUM(IF [vertical_parent]=&quot;All&quot; and [date_month]=[Parameters].[Parameter 3] and [is_gcg]=0 then [gbv_eur] END)&#10;        /SUM(IF [vertical_parent]=&quot;All&quot; and [date_month]=[Parameters].[Parameter 3] and [is_gcg]=0 then [cust_month] END)&#10;        &#10;    )&#10;    -&#10;    (&#10;        &#10;        SUM(IF [vertical_parent]=&quot;All&quot; and [date_month]=[Parameters].[Parameter 3] and [is_gcg]=1 then [gbv_eur] END)&#10;        /       &#10;        SUM(IF [vertical_parent]=&quot;All&quot; and [date_month]=[Parameters].[Parameter 3] and [is_gcg]=1 then [cust_month] END)&#10;&#10;    )&#10;) * SUM(IF [vertical_parent]=&quot;All&quot; and [date_month]=[Parameters].[Parameter 3] and [is_gcg]=0 then [cust_month] END)&#10;)/&#10;        SUM(IF [vertical_parent]=&quot;All&quot; and [date_month]=[Parameters].[Parameter 3] and [is_gcg]=0 then [gbv_eur] END)' />
