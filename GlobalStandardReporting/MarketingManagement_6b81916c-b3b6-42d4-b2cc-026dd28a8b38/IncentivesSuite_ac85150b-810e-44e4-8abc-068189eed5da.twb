    <worksheet name='Depth by Incentivisation Rates% (IR%) (CARC)'>
      <table>
        <view>
          <datasources>
            <datasource caption='Incentive Clusters by Orders' name='federated.0guwcdn07dyky51bbq1ib0frz1o4' />
            <datasource name='Parameters' />
            <datasource caption='Incentive Clusters by Customers' name='federated.0fvkmvl1645ere1az7bl10p5ljtj' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Monthly' caption='Analysis Frequency' datatype='string' name='[Parameter 1 1 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;quarter&quot;' value='Quarterly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0fvkmvl1645ere1az7bl10p5ljtj'>
            <column caption='Vertical Type (Grouped)' datatype='string' name='[Calculation_6568711231061143552]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [vertical_type]&#10;WHEN &apos;Darkstores / Dmarts&apos; THEN [vertical_type]&#10;WHEN &apos;Restaurant / Food&apos;   THEN [vertical_type]&#10;WHEN &apos;Untracked&apos;           THEN &apos;Restaurant / Food&apos;&#10;ELSE &apos;Local Shops&apos;&#10;END' />
            </column>
            <column caption='Order Date' datatype='date' name='[created_date]' role='dimension' type='ordinal' />
            <column caption='Display Name' datatype='string' name='[display_name]' role='dimension' type='nominal' />
            <column caption='Incentive Category' datatype='string' name='[incentive_category]' role='dimension' type='nominal' />
            <column caption='Incentive Type' datatype='string' name='[incentive_type]' role='dimension' type='nominal' />
            <column caption='Is Acquisition' datatype='boolean' name='[is_acquisition]' role='dimension' type='nominal' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column caption='Segment' datatype='string' name='[segment]' role='dimension' type='nominal' />
            <column caption='Vertical Type' datatype='string' name='[vertical_type]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0guwcdn07dyky51bbq1ib0frz1o4'>
            <column caption='Report Date' datatype='date' datatype-customized='true' name='[Calculation_2044563928713375744]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parameter 1 1 1], [created_date]))' />
            </column>
            <column caption='Which Orders to Include?' datatype='string' name='[Calculation_252060844759683072]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([is_acquisition], &apos;Acquisitions Only&apos;, &apos;Reorders Only&apos;)' />
            </column>
            <column caption='Vertical Type (Grouped)' datatype='string' name='[Calculation_6568711231061143552]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [vertical_type]&#10;WHEN &apos;Dmarts&apos; THEN [vertical_type]&#10;WHEN &apos;Food&apos;   THEN [vertical_type]&#10;WHEN &apos;Courier&apos; THEN [vertical_type]&#10;ELSE &apos;Local Shops&apos;&#10;END&#10;/*&#10;Previous Version: based on vertical_type_mkt&#10;CASE [Vertical Type]&#10;WHEN &apos;Darkstores / Dmarts&apos; THEN [Vertical Type]&#10;WHEN &apos;Restaurant&apos;          THEN [Vertical Type]&#10;WHEN &apos;Courier Service&apos;     THEN [Vertical Type]&#10;WHEN &apos;Other Food Delivery&apos; THEN &apos;Restaurant&apos;&#10;ELSE &apos;Local Shops&apos;&#10;END&#10;*/' />
            </column>
            <column caption='Incentives per GMV' datatype='real' name='[Calculation_6568711231082655746]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_incentives_eur]) / SUM([gmv_eur])' />
            </column>
            <column caption='Inc&apos;d Orders with MOV Rule (%)' datatype='real' name='[Calculation_6568711231099621380]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([has_mov] AND [incentivisation_bin] &lt;&gt; &apos;A: %0&apos;, [orders], 0)) / &#10;SUM(IIF([incentivisation_bin] &lt;&gt; &apos;A: %0&apos;, [orders], 0))' />
            </column>
            <column caption='AOV (€)' datatype='real' name='[Calculation_6568711231126474757]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gbv_eur]) / SUM([orders])' />
            </column>
            <column caption='Order Date' datatype='date' name='[created_date]' role='dimension' type='ordinal' />
            <column caption='DH Incentives (€)' datatype='real' name='[dh_contribution_eur]' role='measure' type='quantitative' />
