            </column>
            <column caption='Incentive Type' datatype='string' name='[incentive_type]' role='dimension' type='nominal' />
            <column-instance column='[Notes.QoA/QCT (copy) (copy) (copy)_2773865573769277444]' derivation='None' name='[none:Notes.QoA/QCT (copy) (copy) (copy)_2773865573769277444:nk]' pivot='key' type='nominal' />
            <column-instance column='[incentive_type]' derivation='None' name='[none:incentive_type:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.06b8ia20c36l9e11i63851fqsdgf].[none:incentive_type:nk]'>
            <groupfilter function='union' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:incentive_type:nk]' member='&quot;amount&quot;' />
              <groupfilter function='member' level='[none:incentive_type:nk]' member='&quot;bxgy&quot;' />
              <groupfilter function='member' level='[none:incentive_type:nk]' member='&quot;delivery_fee&quot;' />
              <groupfilter function='member' level='[none:incentive_type:nk]' member='&quot;fixed_price&quot;' />
              <groupfilter function='member' level='[none:incentive_type:nk]' member='&quot;free_gift&quot;' />
              <groupfilter function='member' level='[none:incentive_type:nk]' member='&quot;multi_level&quot;' />
