    <worksheet name='Funding (2)'>
      <table>
        <view>
          <datasources>
            <datasource caption='RDF' name='federated.1lyipm9007npkg1h4cy2m1525r1j' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='CARC Only' caption='Which Incentives?' datatype='real' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='1.'>
              <calculation class='tableau' formula='1.' />
              <aliases>
                <alias key='1.' value='CARC Only' />
                <alias key='2.' value='LT DF + CARCwithoutCC' />
                <alias key='3.' value='All' />
              </aliases>
            </column>
            <column alias='GBV + DF' caption='Monetisation Parameter' datatype='real' name='[Parameter 2]' param-domain-type='list' role='measure' type='quantitative' value='3.'>
              <calculation class='tableau' formula='3.' />
              <aliases>
                <alias key='1.' value='GMV' />
                <alias key='2.' value='GBV' />
                <alias key='3.' value='GBV + DF' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1lyipm9007npkg1h4cy2m1525r1j'>
            <column caption='DH CARC Spend (in mil. Euros)' datatype='real' name='[Calculation_1202250043427987457]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[dh_incentive_spend_of_customers_with_carc_incentives (bima_incentives_rdf)] / 1000000' />
            </column>
            <column caption='DH Funded Incentives per Monetisation' datatype='real' name='[Calculation_6015472144112660480]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Vendor Funded Incentive Spend (copy)_6015472144122855430]) / &#10;SUM(&#10;CASE [Parameters].[Parameter 2]&#10;WHEN 1 THEN [gmv]&#10;WHEN 2 THEN [gbv]&#10;WHEN 3 THEN [Calculation_6015472144123568136]&#10;END&#10;)' />
            </column>
            <column caption='Customers with Incentives' datatype='integer' name='[Calculation_6015472144112955393]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN 1 THEN [customers_with_carc_incentives (bima_incentives_rdf)]&#10;WHEN 2 THEN [customers_with_consistent_carc_incentives (bima_incentives_rdf)]&#10;WHEN 3 THEN [customers_with_incentives]&#10;END' />
            </column>
            <column caption='% Incentivised Customers' datatype='real' name='[Calculation_6015472144116781061]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_6015472144112955393]) / SUM ([customers])' />
            </column>
            <column caption='GBV + DF' datatype='real' name='[Calculation_6015472144123568136]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[gbv] + [delivery_fee]' />
            </column>
            <column caption='% Incentivised of Incentivised Customers' datatype='real' name='[Calculation_6015472144124362764]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Customers with Incentives (copy) (copy)_6015472144115195907]) / &#10;SUM([Customers with Incentives (copy)_6015472144115187714])' />
            </column>
            <column caption='Incentive Spend over Monetisation (Inct&apos;d Orders)' datatype='real' name='[Calculation_6015472144124825613]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Vendor Funded Incentive Spend (copy)_6015472144123121671]) / &#10;SUM(&#10;CASE [Parameters].[Parameter 2]&#10;WHEN 1 THEN [GBV of Inc&apos;d Orders fro Incentivised Customers (copy)_5029817159357677569]&#10;WHEN 2 THEN [GBV of Incentivised Customers (copy)_5029817159357411328]&#10;WHEN 3 THEN [GBV of Incentivised Customers (copy)_5029817159357411328] + [GBV of Inc&apos;d Orders from Incentivised Customers (copy)_5029817159358197762]&#10;END&#10;)' />
            </column>
            <column caption='% DH Funded' datatype='real' name='[Calculation_6015472144125054990]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Vendor Funded Incentive Spend (copy)_6015472144122855430]) / &#10;SUM([Vendor Funded Incentive Spend (copy)_6015472144123121671])' />
            </column>
            <column caption='Orders per Person' datatype='real' name='[Calculation_6015472144125370384]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders]) / SUM([customers])' />
            </column>
            <column caption='Orders per Person (Incentivised)' datatype='real' name='[Calculation_6015472144125444113]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Customers with Incentives (copy)_6015472144115187714]) /&#10;SUM([Calculation_6015472144112955393])' />
            </column>
            <column caption='Orders per Person Comparison' datatype='real' name='[Calculation_6015472144125550610]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6015472144125444113] /&#10;[Calculation_6015472144125370384]' />
            </column>
            <column caption='Monetisation per Person Comparison' datatype='real' name='[Calculation_6162965031923351554]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN 1 THEN [Orders per Person (Incentivised) (copy)_6015472144126042132] / [Orders per Person (copy)_6015472144126042131]&#10;WHEN 2 THEN [GMV per Person (Incentivised) (copy)_6162965031923232768] / [GMV per Person (copy)_6162965031923232769]&#10;WHEN 3 THEN [GBV per Person (Incentivised) (copy)_6162965031923683331] / [GBV per Person (copy)_6162965031923683332]&#10;END' />
            </column>
            <column caption='Incentivised Orders from Customers with Incentives' datatype='integer' name='[Customers with Incentives (copy) (copy)_6015472144115195907]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN 1 THEN [orders_with_incentives_from_customers_with_carc_incentives (bima_incentives_rdf)]&#10;WHEN 2 THEN [orders_with_incentives_from_customers_with_consistent_carc_incentives (bima_incentives_rdf)]&#10;WHEN 3 THEN [orders_with_incentives_from_customers_with_incentives]&#10;END' />
            </column>
            <column caption='Orders from Customers with Incentives' datatype='integer' name='[Customers with Incentives (copy)_6015472144115187714]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN 1 THEN [orders_from_customers_with_carc_incentives (bima_incentives_rdf)]&#10;WHEN 2 THEN [orders_from_customers_with_consistent_carc_incentives (bima_incentives_rdf)]&#10;WHEN 3 THEN [orders_from_customers_with_incentives]&#10;END' />
            </column>
            <column caption='GMV of Inc&apos;d Orders from Incentivised Customers' datatype='real' name='[GBV of Inc&apos;d Orders fro Incentivised Customers (copy)_5029817159357677569]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN 1 THEN [gmv_of_incentivised_orders_from_customers_with_carc_incentives (bima_incentives_rdf)]&#10;WHEN 2 THEN [gmv_of_incentivised_orders_from_customers_with_consistent_carc_incentives (bima_incentives_rdf)]&#10;WHEN 3 THEN [gmv_of_incentivised_orders_from_customers_with_incentives]&#10;END' />
            </column>
            <column caption='DF of Inc&apos;d Orders from Incentivised Customers' datatype='real' name='[GBV of Inc&apos;d Orders from Incentivised Customers (copy)_5029817159358197762]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN 1 THEN [delivery_fee_of_incentivised_orders_from_customers_with_carc_incentives (bima_incentives_rdf)]&#10;WHEN 2 THEN [delivery_fee_of_incentivised_orders_from_customers_with_consistent_carc_incentives (bima_incentives_rdf)]&#10;WHEN 3 THEN [delivery_fee_of_incentivised_orders_from_customers_with_incentives]&#10;END' />
            </column>
            <column caption='GBV of Inc&apos;d Orders from Incentivised Customers' datatype='real' name='[GBV of Incentivised Customers (copy)_5029817159357411328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN 1 THEN [gbv_of_incentivised_orders_from_customers_with_carc_incentives (bima_incentives_rdf)]&#10;WHEN 2 THEN [gbv_of_incentivised_orders_from_customers_with_consistent_carc_incentives (bima_incentives_rdf)]&#10;WHEN 3 THEN [gbv_of_incentivised_orders_from_customers_with_incentives]&#10;END' />
            </column>
            <column caption='GBV + DF per Order (Incentivised)' datatype='real' name='[GBV per Person (Incentivised) (copy)_6162965031923683331]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([GBV of Incentivised Customers (copy)_5029817159357411328] + [GBV of Inc&apos;d Orders from Incentivised Customers (copy)_5029817159358197762]) /&#10;SUM([Customers with Incentives (copy) (copy)_6015472144115195907])' />
            </column>
            <column caption='GBV + DF per Order' datatype='real' name='[GBV per Person (copy)_6162965031923683332]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_6015472144123568136]) / SUM([orders])' />
            </column>
            <column caption='GBV per Order (Incentivised)' datatype='real' name='[GMV per Person (Incentivised) (copy)_6162965031923232768]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([GBV of Incentivised Customers (copy)_5029817159357411328]) /&#10;SUM([Customers with Incentives (copy) (copy)_6015472144115195907])' />
            </column>
            <column caption='GBV per Order' datatype='real' name='[GMV per Person (copy)_6162965031923232769]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gbv]) / SUM([orders])' />
