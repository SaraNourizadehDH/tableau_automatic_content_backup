    <worksheet name='Channel Performance Sheet'>
      <table>
        <view>
          <datasources>
            <datasource caption='Incentives HLR' name='federated.06b8ia20c36l9e11i63851fqsdgf' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Monthly' caption='Analysis Frequency  ' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
            <column alias='All' caption='Funding' datatype='string' name='[Source of Cost (copy)_1219138539526680576]' param-domain-type='list' role='measure' type='nominal' value='&quot;3&quot;'>
              <calculation class='tableau' formula='&quot;3&quot;' />
              <aliases>
                <alias key='&quot;1&quot;' value='DH-Only' />
                <alias key='&quot;2&quot;' value='VF-Only' />
                <alias key='&quot;3&quot;' value='All' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.06b8ia20c36l9e11i63851fqsdgf'>
            <column caption='QC Trials' datatype='real' name='[Acquisitions (copy)_1768507325393768448]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([is_qc_trial], [orders], 0)' />
            </column>
            <column caption='% DH Funded' datatype='real' name='[Calculation_1219138539529060354]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dh_contribution_eur]) / SUM([total_incentives_eur])' />
            </column>
            <column caption='Incentive Channel' datatype='string' name='[Calculation_1612570191526498305]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF     UPPER([channel_subchannel]) = &apos;WOM_RAF&apos; THEN &apos;Refer a friend&apos;&#13;&#10;ELSEIF UPPER([channel_subchannel]) = &apos;CRM_RMA&apos; THEN &apos;CRM RMA - Vouchers&apos;&#13;&#10;ELSEIF UPPER([channel_subchannel]) = &apos;CRM_RMO&apos; THEN &apos;CRM RMO - Vouchers&apos;&#13;&#10;ELSEIF UPPER([channel_subchannel]) = &apos;OTHER_SUBSIDIES&apos; AND     [is_acquisition] THEN &apos;DH funded Discounts - Acquisition&apos;&#13;&#10;ELSEIF UPPER([channel_subchannel]) = &apos;OTHER_SUBSIDIES&apos; AND NOT [is_acquisition] THEN &apos;DH funded Discounts - Retention&apos;&#13;&#10;ELSEIF UPPER([channel_subchannel]) IN (&apos;OTHER_CUSTOMERCOMPENSATION&apos;, &apos;OTHER_AUTOCOMP&apos;) THEN &apos;Customer compensation - Vouchers / Wallet&apos;&#13;&#10;ELSEIF UPPER([channel_subchannel]) = &apos;OTHER_DELIVERY FEE&apos; THEN &apos;Delivery Fee Incentives&apos;&#13;&#10;ELSEIF UPPER([channel_subchannel]) = &apos;WALLET_INCENTIVES&apos; THEN &apos;Wallet Incentives&apos;&#13;&#10;ELSEIF NOT ISNULL([channel_subchannel]) AND     [is_acquisition] THEN &apos;Vouchers Generic - Acquisition&apos;&#13;&#10;ELSEIF NOT ISNULL([channel_subchannel]) AND NOT [is_acquisition] THEN &apos;Vouchers Generic - Retention&apos;&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='Which Orders?' datatype='string' name='[Calculation_1787929114010013696]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([is_acquisition], &apos;Acquisitions Only&apos;, &apos;Reorders Only&apos;)' />
            </column>
            <column caption='IIF([Is Acquisition], [Orders], 0)' datatype='real' name='[Calculation_3663256143813529603]' role='measure' type='quantitative' user:unnamed='Channel Performance Sheet'>
              <calculation class='tableau' formula='IIF([is_acquisition], [orders], 0)' />
            </column>
            <column caption='Report Date' datatype='date' name='[Calculation_6152761569167699973]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parameter 6],[created_date], &apos;monday&apos;))' />
            </column>
            <column caption='inCPGMV' datatype='real' name='[Calculation_6204201113617321984]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Source of Cost (copy)_1219138539526680576]&#10;WHEN &apos;1&apos; THEN SUM([dh_contribution_eur]) &#10;WHEN &apos;2&apos; THEN SUM([vendor_contribution_eur] + [thirdparty_contribution_eur])  &#10;WHEN &apos;3&apos; THEN SUM([total_incentives_eur]) &#10;END&#10;/ SUM([gmv_eur])' />
            </column>
            <column caption='inCPO' datatype='real' name='[Calculation_6204201113617412097]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Source of Cost (copy)_1219138539526680576]&#10;WHEN &apos;1&apos; THEN SUM([dh_contribution_eur]) &#10;WHEN &apos;2&apos; THEN SUM([vendor_contribution_eur] + [thirdparty_contribution_eur])  &#10;WHEN &apos;3&apos; THEN SUM([total_incentives_eur]) &#10;END&#10;/ SUM([orders])' />
            </column>
            <column caption='Incentive Spend' datatype='real' name='[Calculation_6204201113622073347]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Source of Cost (copy)_1219138539526680576]&#10;WHEN &apos;1&apos; THEN SUM([dh_contribution_eur]) &#10;WHEN &apos;2&apos; THEN SUM([vendor_contribution_eur] + [thirdparty_contribution_eur])  &#10;WHEN &apos;3&apos; THEN SUM([total_incentives_eur]) &#10;END' />
            </column>
            <column caption='Channel Subchannel' datatype='string' name='[channel_subchannel]' role='dimension' type='nominal' />
            <column caption='Channels For Reporting' datatype='string' name='[channels_for_reporting]' role='dimension' type='nominal' />
            <column caption='Created Date' datatype='date' name='[created_date]' role='dimension' type='ordinal' />
            <column caption='Dh Contribution Eur' datatype='real' name='[dh_contribution_eur]' role='measure' type='quantitative' />
            <column caption='Display Name' datatype='string' name='[display_name]' role='dimension' type='nominal' />
            <column caption='Gmv Eur' datatype='real' name='[gmv_eur]' role='measure' type='quantitative' />
            <column caption='inCPT' datatype='real' name='[incentive cost per Acq (copy)_1780188536929902592]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;IIF([is_qc_trial], &#10;    CASE [Parameters].[Source of Cost (copy)_1219138539526680576]&#10;    WHEN &apos;1&apos; THEN [dh_contribution_eur]&#10;    WHEN &apos;2&apos; THEN [vendor_contribution_eur] + [thirdparty_contribution_eur]  &#10;    WHEN &apos;3&apos; THEN [total_incentives_eur]&#10;    END,&#10;0))&#10;/ SUM(IIF([is_qc_trial], [orders], 0))' />
            </column>
            <column caption='inCPA' datatype='real' name='[incentive cost per Order (copy)_1219138539587080196]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;IIF([is_acquisition], &#10;    CASE [Parameters].[Source of Cost (copy)_1219138539526680576]&#10;    WHEN &apos;1&apos; THEN [dh_contribution_eur]&#10;    WHEN &apos;2&apos; THEN [vendor_contribution_eur] + [thirdparty_contribution_eur]  &#10;    WHEN &apos;3&apos; THEN [total_incentives_eur]&#10;    END,&#10;0))&#10;/ SUM(IIF([is_acquisition], [orders], 0))' />
            </column>
            <column caption='Incentive Type' datatype='string' name='[incentive_type]' role='dimension' type='nominal' />
            <column caption='Is Acquisition' datatype='boolean' name='[is_acquisition]' role='dimension' type='nominal' />
            <column caption='Is Qc Trial' datatype='boolean' name='[is_qc_trial]' role='dimension' type='nominal' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1787929114010013696]' derivation='None' name='[none:Calculation_1787929114010013696:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_6152761569167699973]' derivation='None' name='[none:Calculation_6152761569167699973:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_6152761569167699973]' derivation='None' name='[none:Calculation_6152761569167699973:qk]' pivot='key' type='quantitative' />
            <column-instance column='[channels_for_reporting]' derivation='None' name='[none:channels_for_reporting:nk]' pivot='key' type='nominal' />
            <column-instance column='[display_name]' derivation='None' name='[none:display_name:nk]' pivot='key' type='nominal' />
