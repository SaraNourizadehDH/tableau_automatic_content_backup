    <worksheet name='Cohort Size / Retention (Left)'>
      <layout-options>
        <title>
          <formatted-text>
            <run>&lt;Sheet Name&gt; </run>
            <run fontsize='10'>: Cohort Size only works when Returning Vertical is All Orders.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Cohorts' name='federated.19foiec14b6mc012id41t04c7hgb' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='All Orders' caption='Vertical Selection' datatype='string' name='[Parameter 5 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;1&quot;'>
              <calculation class='tableau' formula='&quot;1&quot;' />
              <aliases>
                <alias key='&quot;1&quot;' value='All Orders' />
                <alias key='&quot;2&quot;' value='Restaurant Orders' />
                <alias key='&quot;3&quot;' value='DMart Orders' />
                <alias key='&quot;4&quot;' value='Local Shop Orders' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.19foiec14b6mc012id41t04c7hgb'>
            <column caption='Retention-Text' datatype='string' name='[Calculation_3300434886521446400]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IIF([Calculation_5554205023555784708] == 1, &#10;    STR(ROUND(SUM([returning_customers] / 1000), 0)) + &apos;K&apos;,&#10;    STR(ROUND([Calculation_5554205023555784708] * 100, 1)) + &apos;%&apos;)' />
            </column>
            <column caption='Retention Rate' datatype='real' name='[Calculation_5554205023555784708]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;CASE [Parameters].[Parameter 5 2]&#10;WHEN &apos;1&apos; THEN [returning_customers]&#10;WHEN &apos;2&apos; THEN [returning_customers_food]&#10;WHEN &apos;3&apos; THEN [returning_customers_dmarts]&#10;WHEN &apos;4&apos; THEN [returning_customers_localshops]&#10;END&#10;)&#10;/ &#10;SUM([customers])' />
            </column>
            <column caption='Frequency' datatype='real' name='[Calculation_5554205023556071429]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;CASE [Parameters].[Parameter 5 2]&#10;WHEN &apos;1&apos; THEN [orders]&#10;WHEN &apos;2&apos; THEN [orders_food]&#10;WHEN &apos;3&apos; THEN [orders_dmarts]&#10;WHEN &apos;4&apos; THEN [orders_localshops]&#10;END&#10;)&#10;/ &#10;SUM([customers])' />
            </column>
            <column caption='Activity' datatype='real' name='[Calculation_5554205023556276230]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;CASE [Parameters].[Parameter 5 2]&#10;WHEN &apos;1&apos; THEN [orders]&#10;WHEN &apos;2&apos; THEN [orders_food]&#10;WHEN &apos;3&apos; THEN [orders_dmarts]&#10;WHEN &apos;4&apos; THEN [orders_localshops]&#10;END)&#10;/ &#10;SUM(CASE [Parameters].[Parameter 5 2]&#10;WHEN &apos;1&apos; THEN [returning_customers]&#10;WHEN &apos;2&apos; THEN [returning_customers_food]&#10;WHEN &apos;3&apos; THEN [returning_customers_dmarts]&#10;WHEN &apos;4&apos; THEN [returning_customers_localshops]&#10;END)' />
            </column>
            <column caption='Incentivised?' datatype='boolean' name='[Calculation_5554205023622008841]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([first_order_channel] == &apos;No Incentive&apos;, FALSE, TRUE)' />
            </column>
            <column caption='Return Period (Filter)' datatype='real' name='[Return Period (copy)_5554205023561461768]' role='dimension' type='quantitative'>
