      <table>
        <view>
          <datasources>
            <datasource caption='Incentives HLR' name='federated.06b8ia20c36l9e11i63851fqsdgf' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='QC Trials' caption='QC Trials / GMV ' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;1&quot;'>
              <calculation class='tableau' formula='&quot;1&quot;' />
              <aliases>
                <alias key='&quot;1&quot;' value='QC Trials' />
                <alias key='&quot;2&quot;' value='GMV' />
              </aliases>
            </column>
            <column alias='Monthly' caption='Analysis Frequency  ' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.06b8ia20c36l9e11i63851fqsdgf'>
            <column caption='QC Trials' datatype='real' name='[Acquisitions (copy)_1768507325393768448]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([is_qc_trial], [orders], 0)' />
            </column>
            <column caption='Incentive Channel' datatype='string' name='[Calculation_1612570191526498305]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF     UPPER([channel_subchannel]) = &apos;WOM_RAF&apos; THEN &apos;Refer a friend&apos;&#13;&#10;ELSEIF UPPER([channel_subchannel]) = &apos;CRM_RMA&apos; THEN &apos;CRM RMA - Vouchers&apos;&#13;&#10;ELSEIF UPPER([channel_subchannel]) = &apos;CRM_RMO&apos; THEN &apos;CRM RMO - Vouchers&apos;&#13;&#10;ELSEIF UPPER([channel_subchannel]) = &apos;OTHER_SUBSIDIES&apos; AND     [is_acquisition] THEN &apos;DH funded Discounts - Acquisition&apos;&#13;&#10;ELSEIF UPPER([channel_subchannel]) = &apos;OTHER_SUBSIDIES&apos; AND NOT [is_acquisition] THEN &apos;DH funded Discounts - Retention&apos;&#13;&#10;ELSEIF UPPER([channel_subchannel]) IN (&apos;OTHER_CUSTOMERCOMPENSATION&apos;, &apos;OTHER_AUTOCOMP&apos;) THEN &apos;Customer compensation - Vouchers / Wallet&apos;&#13;&#10;ELSEIF UPPER([channel_subchannel]) = &apos;OTHER_DELIVERY FEE&apos; THEN &apos;Delivery Fee Incentives&apos;&#13;&#10;ELSEIF UPPER([channel_subchannel]) = &apos;WALLET_INCENTIVES&apos; THEN &apos;Wallet Incentives&apos;&#13;&#10;ELSEIF NOT ISNULL([channel_subchannel]) AND     [is_acquisition] THEN &apos;Vouchers Generic - Acquisition&apos;&#13;&#10;ELSEIF NOT ISNULL([channel_subchannel]) AND NOT [is_acquisition] THEN &apos;Vouchers Generic - Retention&apos;&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='QC Trial GMV' datatype='real' name='[Calculation_1815654386760212483]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([is_qc_trial], [gmv_eur], 0)' />
            </column>
            <column caption='Is Incentivised' datatype='string' name='[Calculation_1815654386761457668]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([incentive_type] == &apos;No Incentive&apos;, &apos;Not Incentivised&apos;, &apos;Incentivised&apos;)' />
            </column>
            <column caption='Reach: QC Trial Variable' datatype='real' name='[Calculation_1815654386783666183]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &apos;1&apos; THEN [Acquisitions (copy)_1768507325393768448]&#10;WHEN &apos;2&apos; THEN [Calculation_1815654386760212483]&#10;END' />
            </column>
            <column caption='Report Date' datatype='date' name='[Calculation_6152761569167699973]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parameter 6],[created_date], &apos;monday&apos;))' />
            </column>
            <column caption='Reach: QC Trial Variable (Text)' datatype='string' name='[Left-Graph Variable (copy)_1815654386783948808]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &apos;1&apos; THEN &apos;QC Trials&apos;&#10;WHEN &apos;2&apos; THEN &apos;GMV of QC Trials&apos;&#10;END' />
            </column>
