      <column caption='Analysis Period' datatype='date' name='[Calculation_6152761569167699973 1]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parameter 1 1 1],[created_date], &apos;monday&apos;))' />
