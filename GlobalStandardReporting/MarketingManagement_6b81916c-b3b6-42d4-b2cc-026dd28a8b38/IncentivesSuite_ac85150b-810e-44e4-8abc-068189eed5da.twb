            <column caption='GMV per Order (Incentivised)' datatype='real' name='[Orders per Person (Incentivised) (copy)_6015472144126042132]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([GBV of Inc&apos;d Orders fro Incentivised Customers (copy)_5029817159357677569]) /&#10;SUM([Customers with Incentives (copy) (copy)_6015472144115195907])' />
            </column>
            <column caption='GMV per Order' datatype='real' name='[Orders per Person (copy)_6015472144126042131]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv]) / SUM([orders])' />
