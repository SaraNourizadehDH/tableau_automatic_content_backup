      <aliases enabled='yes' />
      <column caption='User Entitlement Filter' datatype='boolean' name='[Calculation_1099300584155578372]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]=USERNAME()' />
      </column>
      <column caption='Acqs / QC Trials' datatype='real' hidden='true' name='[Calculation_1270929933247164417]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2 1]&#10;WHEN &apos;1&apos; THEN [acquisitions]&#10;WHEN &apos;2&apos; THEN [trials]&#10;END' />
      </column>
      <column caption='Cost on Voucher' datatype='real' name='[Calculation_1270929933247578115]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1 1]&#10;WHEN &apos;1&apos; THEN [dh_incentive_cost] - [stacked_other_dh_cost]&#10;WHEN &apos;2&apos; THEN [incentive_cost] - [stacked_other_cost]&#10;END' />
      </column>
      <column caption='inCPO (€) (Voucher Only)' datatype='real' name='[Calculation_2681471407786409987]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1270929933247578115]) / SUM([orders])' />
      </column>
      <column caption='% Stacked' datatype='real' name='[Calculation_2681471407786536964]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([stacked_orders]) / SUM([orders])' />
      </column>
      <column caption='inCPGMV % (Voucher Only)' datatype='real' name='[Calculation_2681471407787237381]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1270929933247578115]) / SUM([gmv] - [gmv_share_of_stacked])' />
      </column>
      <column caption='Incentive Cost (€)' datatype='real' hidden='true' name='[Calculation_2681471407787646982]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1 1]&#10;WHEN &apos;1&apos; THEN [dh_incentive_cost]&#10;WHEN &apos;2&apos; THEN [incentive_cost]&#10;END' />
      </column>
      <column caption='Other Stacked Incentive Cost (€)' datatype='real' hidden='true' name='[Calculation_2681471407787888647]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1 1]&#10;WHEN &apos;1&apos; THEN [stacked_other_dh_cost]&#10;WHEN &apos;2&apos; THEN [stacked_other_cost]&#10;END' />
      </column>
      <column caption='% Stacked Cost' datatype='real' hidden='true' name='[Calculation_2681471407789002760]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_2681471407787888647]) / SUM([Calculation_2681471407787646982])' />
