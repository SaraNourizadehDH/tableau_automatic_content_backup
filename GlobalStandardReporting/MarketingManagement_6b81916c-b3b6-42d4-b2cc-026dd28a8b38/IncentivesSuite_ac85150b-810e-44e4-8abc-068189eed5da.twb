      <aliases enabled='yes' />
      <column caption='User Entitlement Filter' datatype='boolean' name='[Calculation_1169739697105276929]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]=USERNAME()' />
      </column>
      <column caption='Report Date' datatype='date' datatype-customized='true' name='[Calculation_2044563928713375744]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parameter 1 1 1], [created_date]))' />
      </column>
      <column caption='Which Orders to Include?' datatype='string' name='[Calculation_252060844759683072]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([is_acquisition], &apos;Acquisitions Only&apos;, &apos;Reorders Only&apos;)' />
      </column>
      <column caption='Notes.DIR' datatype='string' name='[Calculation_2522226956632645632]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Please Hover Here for More Info&quot;' />
      </column>
      <column caption='Vertical Type (Grouped)' datatype='string' name='[Calculation_6568711231061143552]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [vertical_type]&#10;WHEN &apos;Dmarts&apos; THEN [vertical_type]&#10;WHEN &apos;Food&apos;   THEN [vertical_type]&#10;WHEN &apos;Courier&apos; THEN [vertical_type]&#10;ELSE &apos;Local Shops&apos;&#10;END&#10;/*&#10;Previous Version: based on vertical_type_mkt&#10;CASE [Vertical Type]&#10;WHEN &apos;Darkstores / Dmarts&apos; THEN [Vertical Type]&#10;WHEN &apos;Restaurant&apos;          THEN [Vertical Type]&#10;WHEN &apos;Courier Service&apos;     THEN [Vertical Type]&#10;WHEN &apos;Other Food Delivery&apos; THEN &apos;Restaurant&apos;&#10;ELSE &apos;Local Shops&apos;&#10;END&#10;*/' />
      </column>
      <column caption='Incentives per GMV' datatype='real' name='[Calculation_6568711231082655746]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_incentives_eur]) / SUM([gmv_eur])' />
      </column>
      <column caption='Inc&apos;d Orders with MOV Rule (%)' datatype='real' name='[Calculation_6568711231099621380]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([has_mov] AND [incentivisation_bin] &lt;&gt; &apos;A: %0&apos;, [orders], 0)) / &#10;SUM(IIF([incentivisation_bin] &lt;&gt; &apos;A: %0&apos;, [orders], 0))' />
      </column>
      <column caption='AOV (€)' datatype='real' name='[Calculation_6568711231126474757]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gbv_eur]) / SUM([orders])' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='bima_incentives_cluster_by_orders' datatype='table' hidden='true' name='[__tableau_internal_object_id__].[bima_incentives_cluster_by_orders_945B11F1C96C4237AB9A90F94C6A2B40]' role='measure' type='quantitative' />
      <column caption='Brand' datatype='string' hidden='true' name='[brand]' role='dimension' type='nominal' />
