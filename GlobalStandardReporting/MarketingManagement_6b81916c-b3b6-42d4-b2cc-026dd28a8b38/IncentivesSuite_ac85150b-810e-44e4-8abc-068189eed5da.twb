      </column>
      <column caption='Report Date' datatype='date' datatype-customized='true' name='[Calculation_2044563928713375744]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parameter 1 1 1], [created_date]))' />
      </column>
      <column caption='Chart Variable' datatype='real' hidden='true' name='[Calculation_2044563928717406211]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4 1]&#10;WHEN 1 THEN [orders]&#10;WHEN 2 THEN [gbv_eur]&#10;WHEN 3 THEN [gmv_eur]&#10;WHEN 4 THEN [dh_contribution_eur]&#10;WHEN 5 THEN [dh_revenue_eur]&#10;WHEN 6 THEN [total_incentives_eur]&#10;WHEN 7 THEN [gross_profit_eur]&#10;WHEN 8 THEN [fl_gross_profit_eur]&#10;END' />
      </column>
      <column caption='Chart Variable (%)' datatype='real' hidden='true' name='[Calculation_2147091188994113536]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_2044563928717406211]) / SUM({FIXED [Calculation_2044563928713375744] : SUM([Calculation_2044563928717406211])})' />
      </column>
      <column caption='Which Orders to Include?' datatype='string' name='[Calculation_252060844759683072]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([is_acquisition], &apos;Acquisitions Only&apos;, &apos;Reorders Only&apos;)' />
      </column>
      <column caption='DH Only Incentives' datatype='real' hidden='true' name='[Calculation_4235846558632517635]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([incentive_source_of_funding] = &apos;DH Funded&apos;, [dh_contribution_eur], 0)' />
      </column>
      <column caption='Vertical Type (Grouped)' datatype='string' name='[Calculation_6568711231061143552]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [vertical_type]&#10;WHEN &apos;Darkstores / Dmarts&apos; THEN [vertical_type]&#10;WHEN &apos;Restaurant / Food&apos;   THEN [vertical_type]&#10;WHEN &apos;Untracked&apos;           THEN &apos;Restaurant / Food&apos;&#10;ELSE &apos;Local Shops&apos;&#10;END' />
      </column>
      <column caption='AOV (€)' datatype='real' hidden='true' name='[Calculation_6568711231126474757]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gbv_eur]) / SUM([orders])' />
      </column>
      <column caption='Co-Funded Vendor Paid Incentives' datatype='real' hidden='true' name='[Co-Funded DH Incentives (copy)_4235846558633099269]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([incentive_source_of_funding] = &apos;Co-Funded&apos;, [total_incentives_eur] - [dh_contribution_eur], 0)' />
      </column>
      <column caption='Co-Funded DH Paid Incentives' datatype='real' hidden='true' name='[DH Only DH Incentives (copy)_4235846558632804356]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([incentive_source_of_funding] = &apos;Co-Funded&apos;, [dh_contribution_eur], 0)' />
      </column>
      <column caption='Vendor Only Incentives' datatype='real' hidden='true' name='[DH Only DH Incentives (copy)_4235846558633340934]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([incentive_source_of_funding] = &apos;Vendor Funded&apos;, [total_incentives_eur], 0)' />
      </column>
