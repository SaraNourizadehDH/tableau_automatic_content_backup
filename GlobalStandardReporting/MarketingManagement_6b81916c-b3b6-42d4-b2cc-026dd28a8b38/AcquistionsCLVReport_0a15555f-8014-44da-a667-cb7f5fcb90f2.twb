      <table>
        <view>
          <datasources>
            <datasource caption='bima_tableau_clv_cpa_final_country_vs_pm_and_nonpm_level+ (rl_mkt)' name='federated.1ewq6h007qlpue18z049k0192ve8' />
            <datasource caption='bima_tableau_acquisition_clv_cpa+ (rl_mkt)' name='federated.1q2tf2y1oig5ar1ck3d9a0gfgn1t' />
          </datasources>
          <datasource-dependencies datasource='federated.1ewq6h007qlpue18z049k0192ve8'>
            <column caption='CPA' datatype='real' name='[Calculation_1238771382058573824]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM(cost_eur)/SUM(acquisitions_calibration_ios14fix), 2)' />
            </column>
            <column caption='Revenue 30D' datatype='real' name='[Calculation_1238771382060777473]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM(customer_lifetime_revenue_30_days_eur_actual)/SUM(adjusted_acquisitions),2)' />
            </column>
            <column caption='Revenue 30D/CPA' datatype='real' name='[Calculation_1238771382061359106]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND([Calculation_1238771382060777473]/[Calculation_1238771382058573824],4)' />
            </column>
            <column caption='CPA(C)' datatype='real' name='[Calculation_1326028657800171522]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM(cost_eur)/SUM(acquisitions_calibration_ios14fix), 2)' />
            </column>
            <column caption='Revenue 30D/CPA(C)' datatype='real' name='[Calculation_1326028657810034722]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND([Revenue 180D(C) (copy)_1326028657809514526]/[Calculation_1326028657800171522],4)' />
            </column>
            <column caption='User Entitlements' datatype='boolean' name='[Calculation_1961317677683200001]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[username]=USERNAME()' />
            </column>
            <column caption='Revenue 30D Delta' datatype='real' name='[Calculation_971933154368618496]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1238771382061359106] / LOOKUP([Calculation_1238771382061359106], 1) ) -1'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Revenue 30D Delta Switch' datatype='integer' name='[Calculation_971933154368876545]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_971933154368618496] &gt; 0 THEN 1&#13;&#10;ELSEIF [Calculation_971933154368618496] &lt; 0 then -1&#13;&#10;ELSEIF [Calculation_971933154368618496] &gt; 0 THEN -2&#13;&#10;ELSEIF [Calculation_971933154368618496] &lt; 0 then 2&#13;&#10;ELSE 0&#13;&#10;END'>
