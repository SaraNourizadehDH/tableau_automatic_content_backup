    <worksheet name='MoM Evolution'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Roboto' fontsize='14'>MoM Evolution of Revenue 30D/CPA and GMV 30D/CPA (</run>
            <run bold='true' fontalignment='1' fontcolor='#c62b13' fontname='Roboto' fontsize='10'>Please select the (Revenue30D/CPA) / (GMV 30D/CPA) Parameter from filter</run>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Roboto' fontsize='14'>)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='bima_tableau_acquisition_clv_cpa+ (rl_mkt)' name='federated.1q2tf2y1oig5ar1ck3d9a0gfgn1t' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Revenue 30D Parameter' datatype='string' name='[Revenue 30D/CPA Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Revenue 30D/CPA&quot;'>
              <calculation class='tableau' formula='&quot;Revenue 30D/CPA&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1q2tf2y1oig5ar1ck3d9a0gfgn1t'>
            <column caption='CPA' datatype='real' name='[Calculation_1238771382058573824]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM(cost_eur)/SUM(acquisitions_calibration_ios14fix), 2)' />
            </column>
            <column caption='Revenue 30D' datatype='real' name='[Calculation_1238771382060777473]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM(customer_lifetime_revenue_30_days_eur_actual)/SUM(adjusted_acquisitions),2)' />
            </column>
            <column caption='Revenue 30D/CPA' datatype='real' name='[Calculation_1238771382061359106]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND([Calculation_1238771382060777473]/[Calculation_1238771382058573824],4)' />
            </column>
            <column caption='GMV 30D' datatype='real' name='[Calculation_1238771382062137349]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM(customer_lifetime_gmv_30_days_eur_actual)/SUM(adjusted_acquisitions),2)' />
            </column>
            <column caption='GMV 30D/CPA' datatype='real' name='[Calculation_1238771382062272518]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND([Calculation_1238771382062137349]/[Calculation_1238771382058573824],4)' />
            </column>
            <column caption='Revenue/GMV Switch' datatype='real' name='[Calculation_396598301945171969]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Revenue 30D/CPA Parameter]&#13;&#10;WHEN &quot;Revenue 30D/CPA&quot; THEN [Calculation_1238771382061359106]&#13;&#10;WHEN &quot;GMV 30D/CPA&quot; THEN [Calculation_1238771382062272518]&#13;&#10;END' />
            </column>
            <column caption='Revenue/GMV Delta' datatype='real' name='[Calculation_396598301951975427]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_396598301945171969] / LOOKUP([Calculation_396598301945171969], 1) ) -1'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Revenue GMV Switch Delta Shape' datatype='integer' name='[Calculation_396598301952225284]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_396598301951975427] &gt; 0 THEN 1&#13;&#10;ELSEIF [Calculation_396598301951975427] &lt; 0 then -1&#13;&#10;ELSEIF [Calculation_396598301951975427] &gt; 0 THEN -2&#13;&#10;ELSEIF [Calculation_396598301951975427] &lt; 0 then 2&#13;&#10;ELSE 0&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Channel Subchannel ' datatype='string' name='[Channel Subchannel (copy)_1148699437253976070]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[channel_subchannel]' />
            </column>
            <column aggregation='Sum' datatype='integer' name='[Date (Days)]' role='dimension' type='ordinal' user:agg-type='Day' user:base-field='date' user:ui-builder='date-bin-builder'>
              <calculation class='tableau' formula='DATEPART(&apos;day&apos;, [date])' />
            </column>
            <column aggregation='Sum' caption='Months' datatype='integer' name='[Date (Month / Year)]' role='dimension' type='ordinal' user:agg-type='Month' user:base-field='date' user:ui-builder='date-bin-builder'>
              <calculation class='tableau' formula='DATEPART(&apos;month&apos;, [date])' scope-isolation='false' />
            </column>
            <column caption='Quarters' datatype='date' name='[Date (Quarters)]' role='dimension' type='ordinal' user:agg-type='Quarter-Trunc' user:base-field='date' user:ui-builder='date-bin-builder'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;quarter&apos;, [date]))' scope-isolation='false' />
            </column>
            <column caption='Display Name ' datatype='string' name='[Display Name (copy)_1148699437253885957]' role='dimension' type='nominal'>
