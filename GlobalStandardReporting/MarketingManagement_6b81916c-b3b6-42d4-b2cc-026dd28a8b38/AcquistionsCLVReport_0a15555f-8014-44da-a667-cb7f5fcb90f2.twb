      <table>
        <view>
          <datasources>
            <datasource caption='bima_tableau_clv_cpa_final_country_vs_pm_and_nonpm_level+ (rl_mkt)' name='federated.1ewq6h007qlpue18z049k0192ve8' />
            <datasource caption='bima_tableau_acquisition_clv_cpa+ (rl_mkt)' name='federated.1q2tf2y1oig5ar1ck3d9a0gfgn1t' />
          </datasources>
          <datasource-dependencies datasource='federated.1ewq6h007qlpue18z049k0192ve8'>
            <column caption='CPA Non-PM' datatype='real' name='[Calculation_1326028657801633796]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM(CASE level WHEN &apos;Non-PM&apos; THEN cost_eur ELSE 0 END)/SUM(CASE level WHEN &apos;Non-PM&apos; THEN acquisitions_calibration_ios14fix ELSE 0 END), 2)' />
            </column>
            <column caption='GMV 30D/CPA Non-PM' datatype='real' name='[Calculation_1326028657805664272]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[GMV 180D Non-PM (copy)_1326028657804341260]/[Calculation_1326028657801633796]' />
            </column>
            <column caption='Revenue 180D Country' datatype='real' name='[Calculation_1326028657808830491]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM(CASE level WHEN &apos;Country&apos; THEN customer_lifetime_revenue_180_days_eur_actual ELSE 0 END)/SUM(CASE level WHEN &apos;Country&apos; THEN adjusted_acquisitions ELSE 0 END),2)' />
            </column>
            <column caption='Revenue 180D Non-PM' datatype='real' name='[Calculation_1326028657809063964]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM(CASE level WHEN &apos;Non-PM&apos; THEN customer_lifetime_revenue_180_days_eur_actual ELSE 0 END)/SUM(CASE level WHEN &apos;Non-PM&apos; THEN adjusted_acquisitions ELSE 0 END),2)' />
            </column>
            <column caption='Revenue 180D PM' datatype='real' name='[Calculation_1326028657809272861]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM(CASE level WHEN &apos;PM&apos; THEN customer_lifetime_revenue_180_days_eur_actual ELSE 0 END)/SUM(CASE level WHEN &apos;PM&apos; THEN adjusted_acquisitions ELSE 0 END),2)' />
            </column>
            <column caption='User Entitlements' datatype='boolean' name='[Calculation_1961317677683200001]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[username]=USERNAME()' />
            </column>
            <column caption='GMV 30D Non-PM' datatype='real' name='[GMV 180D Non-PM (copy)_1326028657804341260]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM(CASE [level] WHEN &apos;Non-PM&apos; THEN [customer_lifetime_gmv_30_days_eur_actual] ELSE 0 END)/SUM(CASE [level] WHEN &apos;Non-PM&apos; THEN [adjusted_acquisitions] ELSE 0 END),2)' />
