    <worksheet name='Country Actuals Revenue/GMV sheet '>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Roboto' fontsize='14'>Country Actuals Revenue/GMV</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='bima_tableau_clv_cpa_final_country_vs_pm_and_nonpm_level+ (rl_mkt)' name='federated.1ewq6h007qlpue18z049k0192ve8' />
            <datasource caption='bima_tableau_acquisition_clv_cpa+ (rl_mkt)' name='federated.1q2tf2y1oig5ar1ck3d9a0gfgn1t' />
          </datasources>
          <datasource-dependencies datasource='federated.1ewq6h007qlpue18z049k0192ve8'>
            <column caption='cal. Acq iOSFix' datatype='real' name='[Calculation_1238771382061924355]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM(acquisitions_calibration_ios14fix),0)' />
            </column>
            <column caption='cal. Acq iOS fix(Country)' datatype='real' name='[Calculation_1326028657799942145]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM(acquisitions_calibration_ios14fix),0)' />
            </column>
            <column caption='CPA Country' datatype='real' name='[Calculation_1326028657800413187]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM(CASE level WHEN &apos;Country&apos; THEN cost_eur ELSE 0 END)/SUM(CASE level WHEN &apos;Country&apos; THEN acquisitions_calibration_ios14fix ELSE 0 END), 2)' />
            </column>
            <column caption='CPA Non-PM' datatype='real' name='[Calculation_1326028657801633796]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM(CASE level WHEN &apos;Non-PM&apos; THEN cost_eur ELSE 0 END)/SUM(CASE level WHEN &apos;Non-PM&apos; THEN acquisitions_calibration_ios14fix ELSE 0 END), 2)' />
            </column>
            <column caption='CPA PM' datatype='real' name='[Calculation_1326028657801859077]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM(CASE level WHEN &apos;PM&apos; THEN cost_eur ELSE 0 END)/SUM(CASE level WHEN &apos;PM&apos; THEN acquisitions_calibration_ios14fix ELSE 0 END), 2)' />
            </column>
            <column caption='GMV 30D/CPA Country' datatype='real' name='[Calculation_1326028657805496335]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[GMV 180D Country (copy)_1326028657804353549]/[Calculation_1326028657800413187]' />
            </column>
            <column caption='GMV 30D/CPA Non-PM' datatype='real' name='[Calculation_1326028657805664272]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[GMV 180D Non-PM (copy)_1326028657804341260]/[Calculation_1326028657801633796]' />
            </column>
            <column caption='GMV 30D/CPA PM' datatype='real' name='[Calculation_1326028657805918225]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[GMV 180D PM (copy)_1326028657804328971]/[Calculation_1326028657801859077]' />
            </column>
            <column caption='Revenue 30D/CPA Country' datatype='real' name='[Calculation_1326028657810567203]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Revenue 180D Country (copy)_1326028657809571873]/[Calculation_1326028657800413187]' />
            </column>
            <column caption='Revenue 30D/CPA Non-PM' datatype='real' name='[Calculation_1326028657810722852]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Revenue 180D Non-PM (copy)_1326028657809551392]/[Calculation_1326028657801633796]' />
            </column>
            <column caption='Revenue 30D/CPA PM' datatype='real' name='[Calculation_1326028657810944037]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Revenue 180D PM (copy)_1326028657809539103]/[Calculation_1326028657801859077]' />
            </column>
            <column caption='User Entitlements' datatype='boolean' name='[Calculation_1961317677683200001]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[username]=USERNAME()' />
            </column>
