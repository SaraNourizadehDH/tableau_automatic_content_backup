      <table>
        <view>
          <datasources>
            <datasource caption='bima_tableau_acquisition_clv_cpa+ (rl_mkt)' name='federated.1q2tf2y1oig5ar1ck3d9a0gfgn1t' />
          </datasources>
          <datasource-dependencies datasource='federated.1q2tf2y1oig5ar1ck3d9a0gfgn1t'>
            <column caption='CPA' datatype='real' name='[Calculation_1238771382058573824]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM(cost_eur)/SUM(acquisitions_calibration_ios14fix), 2)' />
            </column>
            <column caption='cal. Acq iOSFix' datatype='real' name='[Calculation_1238771382061924355]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM(acquisitions_calibration_ios14fix),0)' />
