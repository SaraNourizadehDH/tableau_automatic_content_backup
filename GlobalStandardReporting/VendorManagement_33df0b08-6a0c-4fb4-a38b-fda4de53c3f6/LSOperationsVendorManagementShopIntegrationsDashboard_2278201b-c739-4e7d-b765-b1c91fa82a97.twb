      <column caption='Vendor Fail Rate %' datatype='real' name='[Calculation_4359202970880548866]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendor_failed_orders])/SUM([total_orders])' />
      </column>
      <column caption='OOS Fail Rate %' datatype='real' name='[Calculation_4359202971119726595]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([failed_orders_due_to_out_of_stock])/sum([total_orders])' />
