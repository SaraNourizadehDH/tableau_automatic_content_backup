            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Month' caption='Period Level Parameter' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Report Month&quot;'>
              <calculation class='tableau' formula='&quot;Report Month&quot;' />
              <aliases>
                <alias key='&quot;Report Month&quot;' value='Month' />
                <alias key='&quot;Report Quarter&quot;' value='Quarter' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0m8ly051g9my5t13ok5191h1q0ia'>
            <column caption='Blank Measure 2' datatype='integer' name='[Blank Measure 1 (copy)_4359202973098532885]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MIN(0)= 1 THEN 0 ELSE 0 END' />
            </column>
            <column caption='Blank Measure 3' datatype='integer' name='[Blank Measure 2 (copy)_4359202973100916758]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MIN(0)= 1 THEN 0 ELSE 0 END' />
            </column>
            <column caption='Blank Measure 4' datatype='integer' name='[Blank Measure 3 (copy)_1335246932549722113]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MIN(0)= 1 THEN 0 ELSE 0 END' />
            </column>
            <column caption='Online Vendors' datatype='integer' name='[Calculation_1335246932549251072]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(CASE [is_online] WHEN TRUE THEN ([global_entity_id] + [vendor_id]) ELSE NULL END)' />
            </column>
            <column caption='New Online Vendors' datatype='integer' name='[Calculation_1335246932551106564]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(CASE [new_online] WHEN TRUE THEN ([global_entity_id]+[vendor_id]) ELSE NULL END)' />
            </column>
            <column caption='Active Vendors' datatype='integer' name='[Calculation_1335246932552298501]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [confirmed_orders] &gt; 0 THEN ([global_entity_id] + [vendor_id]) ELSE NULL END)' />
            </column>
            <column caption='% Orders w/Vouchers' datatype='real' name='[Calculation_1335246932553056262]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([voucher_orders])/SUM([confirmed_orders])' />
            </column>
            <column caption='Fail Rate %' datatype='real' name='[Calculation_4359202970879410177]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_orders])/SUM([total_orders])' />
            </column>
            <column caption='Vendor Fail Rate %' datatype='real' name='[Calculation_4359202970880548866]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_failed_orders])/SUM([total_orders])' />
            </column>
            <column caption='OOS Fail Rate %' datatype='real' name='[Calculation_4359202971119726595]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_orders_due_to_out_of_stock])/sum([total_orders])' />
            </column>
            <column caption='OOS GMV Loss %' datatype='real' name='[Calculation_4359202971218739208]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_lost_oos_pf])/SUM([gmv_gross_of_vat_2])' />
            </column>
            <column caption='Period' datatype='date' name='[Calculation_4359202973043875849]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Report Month&quot; THEN [report_month]&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Report Quarter&quot; THEN [report_quarter]&#10;END' />
            </column>
            <column caption='Spacer Measure 1' datatype='integer' name='[Calculation_4359202973075021840]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MIN(0)= 1 THEN 0 ELSE 0 END' />
            </column>
            <column caption='Header Measure 2' datatype='integer' name='[Calculation_4359202973079691282]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MIN(0)= 1 THEN 0 ELSE 0 END' />
            </column>
            <column caption='GMV Delivered Pelican' datatype='real' name='[Calculation_4359202973080371219]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF STR([is_pelican]) = &apos;true&apos; THEN [gmv_gross_of_vat_2] ELSE 0 END' />
            </column>
            <column caption='% Pelican Orders' datatype='real' name='[Calculation_4359202973108453401]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(CASE  [is_pelican] WHEN TRUE THEN [confirmed_orders] ELSE 0 END)/SUM([confirmed_orders])' />
            </column>
            <column caption='SFTP' datatype='string' name='[Calculation_4359202973114613787]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [is_sftp]&#10;WHEN TRUE THEN &quot;SFTP&quot;&#10;ELSE &quot;NON-SFTP&quot;&#10;END' />
            </column>
            <column caption='Blank Measure 1' datatype='integer' name='[Header Measure 2 (copy)_4359202973098156052]' role='measure' type='quantitative'>
