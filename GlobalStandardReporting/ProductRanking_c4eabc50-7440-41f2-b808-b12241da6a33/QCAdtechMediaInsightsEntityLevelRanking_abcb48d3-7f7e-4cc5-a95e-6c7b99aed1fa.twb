    <worksheet name='Boxplot overall'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#ffffff'>Rank variation box plot overall</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='_tableau_category_product_ranking_entity_level_report (cl_data_science_qcommerce)' name='federated.1x1hc3x168tzbm1bicgl50cesi5r' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Metric' datatype='string' name='[Compare Metric 1 (copy)_2241948253276737539]' param-domain-type='list' role='measure' type='nominal' value='&quot;AOV&quot;'>
              <calculation class='tableau' formula='&quot;AOV&quot;' />
              <aliases>
                <alias key='&quot;ATC Non Boosted Time (avg)&quot;' value='ATC Time Non-Boosted' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1x1hc3x168tzbm1bicgl50cesi5r'>
            <column caption='Ranking variation' datatype='string' name='[Calculation_325385089029566465]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;[global_entity_id] IN (&apos;FP_DE&apos;,&apos;FP_BD&apos;,&apos;FP_PK&apos;,&apos;NP_HU&apos;,&apos;TB_KW&apos;)&#10;THEN [rank_variation]&#10;ELSE&#10;[rank_variation]&#10;END' />
              <aliases>
                <alias key='&quot;rank_score_alphabetical&quot;' value='Alphabetical_score' />
                <alias key='&quot;rank_score_brand_focused&quot;' value='Brand_focused' />
                <alias key='&quot;rank_score_novelty_focused&quot;' value='Novelty_focused' />
                <alias key='&quot;rank_score_popularity_focused&quot;' value='Popularity_focused' />
                <alias key='&quot;reorder_score&quot;' value='Reorder_score' />
              </aliases>
            </column>
            <column caption='Metrics' datatype='real' name='[Mertic 1 (copy)_2241948253277782020]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE   [Parameters].[Compare Metric 1 (copy)_2241948253276737539]&#10;// Backend Metrics&#13;&#10;WHEN &apos;AOV&apos;  THEN AVG([gmv_eur_order_avg])&#13;&#10;WHEN &apos;ABS&apos;  THEN SUM([qty_sold_order_avg])&#10;&#10;&#10;// Frontend Metrics Boosted&#10;WHEN &apos;ATC Non Boosted Time (avg)&apos;      THEN AVG([add_to_cart_rank_boosted_abs_avg])&#10;WHEN &apos;ATC Rank Boosted Absolute (median)&apos;   THEN AVG([add_to_cart_rank_boosted_abs_median])&#10;WHEN &apos;ATC Rank Boosted Normalized (avg)&apos;    THEN AVG([add_to_cart_rank_boosted_norm_avg])&#10;WHEN &apos;ATC Rank Boosted Normalized (median)&apos; THEN AVG([add_to_cart_rank_boosted_norm_median])&#10;WHEN &apos;ATC Boosted Time (avg)&apos;               THEN AVG([add_to_cart_time_boosted_avg])&#10;&#13;&#10;// Frontend Metrics Non Boosted&#13;&#10;WHEN &apos;ATC Rank Non Boosted Absolute (avg)&apos;      THEN AVG([add_to_cart_rank_non_boosted_abs_avg])&#13;&#10;WHEN &apos;ATC Rank Non Boosted Absolute (median)&apos;   THEN AVG([add_to_cart_rank_non_boosted_abs_median])&#13;&#10;WHEN &apos;ATC Rank Non Boosted Normalized (avg)&apos;    THEN AVG([add_to_cart_rank_non_boosted_norm_avg])&#13;&#10;WHEN &apos;ATC Rank Non Boosted Normalized (median)&apos; THEN AVG([add_to_cart_rank_non_boosted_norm_median])&#10;WHEN &apos;ATC Non Boosted Time (avg)&apos;               THEN AVG([add_to_cart_time_non_boosted_avg])&#10;&#13;&#10;// Others&#13;&#10;WHEN &apos;Customers&apos;            THEN SUM([customer_countd])&#13;&#10;WHEN &apos;Orders&apos;               THEN SUM([order_countd])&#13;&#10;WHEN &apos;Order Product Countd&apos; THEN SUM([products_distinct_order_avg])&#10;WHEN &apos;Vendors&apos;              THEN SUM([vendor_countd])&#10;WHEN &apos;Warehouse&apos;            THEN SUM([warehouse_countd])&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Add To Cart Rank Boosted Abs Avg' datatype='real' name='[add_to_cart_rank_boosted_abs_avg]' role='measure' type='quantitative' />
            <column caption='Add To Cart Rank Boosted Abs Median' datatype='real' name='[add_to_cart_rank_boosted_abs_median]' role='measure' type='quantitative' />
            <column caption='Add To Cart Rank Boosted Norm Avg' datatype='real' name='[add_to_cart_rank_boosted_norm_avg]' role='measure' type='quantitative' />
            <column caption='Add To Cart Rank Boosted Norm Median' datatype='real' name='[add_to_cart_rank_boosted_norm_median]' role='measure' type='quantitative' />
            <column caption='Add To Cart Rank Non Boosted Abs Avg' datatype='real' name='[add_to_cart_rank_non_boosted_abs_avg]' role='measure' type='quantitative' />
            <column caption='Add To Cart Rank Non Boosted Abs Median' datatype='real' name='[add_to_cart_rank_non_boosted_abs_median]' role='measure' type='quantitative' />
            <column caption='Add To Cart Rank Non Boosted Norm Avg' datatype='real' name='[add_to_cart_rank_non_boosted_norm_avg]' role='measure' type='quantitative' />
            <column caption='Add To Cart Rank Non Boosted Norm Median' datatype='real' name='[add_to_cart_rank_non_boosted_norm_median]' role='measure' type='quantitative' />
            <column caption='Add To Cart Time Boosted Avg' datatype='real' name='[add_to_cart_time_boosted_avg]' role='measure' type='quantitative' />
            <column caption='Add To Cart Time Non Boosted Avg' datatype='real' name='[add_to_cart_time_non_boosted_avg]' role='measure' type='quantitative' />
            <column caption='Customer Countd' datatype='integer' name='[customer_countd]' role='measure' type='quantitative' />
            <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Gmv Eur Order Avg' datatype='real' name='[gmv_eur_order_avg]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_325385089029566465]' derivation='None' name='[none:Calculation_325385089029566465:nk]' pivot='key' type='nominal' />
            <column-instance column='[date]' derivation='None' name='[none:date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
            <column caption='Order Countd' datatype='integer' name='[order_countd]' role='measure' type='quantitative' />
            <column caption='Products Distinct Order Avg' datatype='real' name='[products_distinct_order_avg]' role='measure' type='quantitative' />
            <column caption='Qty Sold Order Avg' datatype='real' name='[qty_sold_order_avg]' role='measure' type='quantitative' />
            <column caption='Rank Variation' datatype='string' name='[rank_variation]' role='dimension' type='nominal' />
            <column-instance column='[date]' derivation='Day-Trunc' name='[tdy:date:qk]' pivot='key' type='quantitative' />
