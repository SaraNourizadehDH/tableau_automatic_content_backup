    <worksheet name='Daily Metrics Table'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff'>Table: All Metrics by Day</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='_tableau_category_product_ranking_entity_level_report (cl_data_science_qcommerce)' name='federated.1x1hc3x168tzbm1bicgl50cesi5r' />
          </datasources>
          <datasource-dependencies datasource='federated.1x1hc3x168tzbm1bicgl50cesi5r'>
            <column caption='Weekday/Weekend' datatype='string' name='[Calculation_2241948253234556929]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATENAME(&apos;weekday&apos;,[date])=&quot;Sunday&quot; OR&#10;&#10;   DATENAME(&apos;weekday&apos;,[date])=&quot;Saturday&quot; THEN &quot;Weekend&quot;&#10;&#10;ELSE &quot;Weekday&quot;&#10;&#10;END' />
