      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1x1hc3x168tzbm1bicgl50cesi5r].[pcdf:usr:Mertic 1 (copy)_2241948253277782020:qk:2]&quot;' value='% Difference in Metrics along Ranking variation' />
        </aliases>
      </column>
      <column caption='Last 7 days' datatype='string' name='[Calculation_1131881264925564929]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;[date]&lt;TODAY()-1 THEN &quot;T&quot; ELSE &quot;F&quot; END' />
      </column>
      <column caption='Weekday/Weekend' datatype='string' name='[Calculation_2241948253234556929]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATENAME(&apos;weekday&apos;,[date])=&quot;Sunday&quot; OR&#10;&#10;   DATENAME(&apos;weekday&apos;,[date])=&quot;Saturday&quot; THEN &quot;Weekend&quot;&#10;&#10;ELSE &quot;Weekday&quot;&#10;&#10;END' />
      </column>
      <column caption='Ranking variation' datatype='string' name='[Calculation_325385089029566465]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;[global_entity_id] IN (&apos;FP_DE&apos;,&apos;FP_BD&apos;,&apos;FP_PK&apos;,&apos;NP_HU&apos;,&apos;TB_KW&apos;)&#10;THEN [rank_variation]&#10;ELSE&#10;[rank_variation]&#10;END' />
        <aliases>
          <alias key='&quot;rank_score_alphabetical&quot;' value='Alphabetical_score' />
          <alias key='&quot;rank_score_brand_focused&quot;' value='Brand_focused' />
          <alias key='&quot;rank_score_novelty_focused&quot;' value='Novelty_focused' />
          <alias key='&quot;rank_score_popularity_focused&quot;' value='Popularity_focused' />
          <alias key='&quot;reorder_score&quot;' value='Reorder_score' />
        </aliases>
      </column>
      <column caption='Launch Date-Note' datatype='string' datatype-customized='true' name='[Calculation_325385089048465410]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;[global_entity_id] IN (&apos;FP_DE&apos;,&apos;NP_HU&apos;) THEN [global_entity_id] + &quot;- Switch back test valid and POP_Rank Launch date 17.08.2021&quot;&#10;ELSEIF &#10;[global_entity_id] IN (&apos;FP_PK&apos;,&apos;FP_BD&apos;) THEN [global_entity_id] + &quot;- Switch back test valid and POP_Rank Launch date 08.09.2021&quot;&#10;ELSE&#10;&quot;To be launched&quot;&#10;END' />
      </column>
      <column caption='Metrics' datatype='real' name='[Mertic 1 (copy)_2241948253277782020]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE   [Parameters].[Compare Metric 1 (copy)_2241948253276737539]&#10;// Backend Metrics&#13;&#10;WHEN &apos;AOV&apos;  THEN AVG([gmv_eur_order_avg])&#13;&#10;WHEN &apos;ABS&apos;  THEN SUM([qty_sold_order_avg])&#10;&#10;&#10;// Frontend Metrics Boosted&#10;WHEN &apos;ATC Non Boosted Time (avg)&apos;      THEN AVG([add_to_cart_rank_boosted_abs_avg])&#10;WHEN &apos;ATC Rank Boosted Absolute (median)&apos;   THEN AVG([add_to_cart_rank_boosted_abs_median])&#10;WHEN &apos;ATC Rank Boosted Normalized (avg)&apos;    THEN AVG([add_to_cart_rank_boosted_norm_avg])&#10;WHEN &apos;ATC Rank Boosted Normalized (median)&apos; THEN AVG([add_to_cart_rank_boosted_norm_median])&#10;WHEN &apos;ATC Boosted Time (avg)&apos;               THEN AVG([add_to_cart_time_boosted_avg])&#10;&#13;&#10;// Frontend Metrics Non Boosted&#13;&#10;WHEN &apos;ATC Rank Non Boosted Absolute (avg)&apos;      THEN AVG([add_to_cart_rank_non_boosted_abs_avg])&#13;&#10;WHEN &apos;ATC Rank Non Boosted Absolute (median)&apos;   THEN AVG([add_to_cart_rank_non_boosted_abs_median])&#13;&#10;WHEN &apos;ATC Rank Non Boosted Normalized (avg)&apos;    THEN AVG([add_to_cart_rank_non_boosted_norm_avg])&#13;&#10;WHEN &apos;ATC Rank Non Boosted Normalized (median)&apos; THEN AVG([add_to_cart_rank_non_boosted_norm_median])&#10;WHEN &apos;ATC Non Boosted Time (avg)&apos;               THEN AVG([add_to_cart_time_non_boosted_avg])&#10;&#13;&#10;// Others&#13;&#10;WHEN &apos;Customers&apos;            THEN SUM([customer_countd])&#13;&#10;WHEN &apos;Orders&apos;               THEN SUM([order_countd])&#13;&#10;WHEN &apos;Order Product Countd&apos; THEN SUM([products_distinct_order_avg])&#10;WHEN &apos;Vendors&apos;              THEN SUM([vendor_countd])&#10;WHEN &apos;Warehouse&apos;            THEN SUM([warehouse_countd])&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Metric 2' datatype='real' name='[Metric_Catg 1 (copy) (copy)_1992561419984523268]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Daily Metric (copy) (copy)_1992561419983814658]&#13;&#10;&#13;&#10;WHEN &apos;AOV&apos;  THEN AVG([gmv_eur_order_avg])&#13;&#10;WHEN &apos;ABS&apos;  THEN SUM([qty_sold_order_avg])&#13;&#10;&#13;&#10;WHEN &apos;ATC Rank Absolute (avg)&apos;      THEN AVG([add_to_cart_rank_non_boosted_abs_avg])&#13;&#10;WHEN &apos;ATC Rank Absolute (median)&apos;   THEN AVG([add_to_cart_rank_non_boosted_abs_median])&#13;&#10;WHEN &apos;ATC Rank Normalized (avg)&apos;    THEN AVG([add_to_cart_rank_non_boosted_norm_avg])&#13;&#10;WHEN &apos;ATC Rank Normalized (median)&apos; THEN AVG([add_to_cart_rank_non_boosted_norm_median])&#13;&#10;&#13;&#10;WHEN &apos;ATC Time (avg)&apos;               THEN AVG([add_to_cart_time_non_boosted_avg])&#13;&#10;&#13;&#10;WHEN &apos;Customers&apos;            THEN SUM([customer_countd])&#13;&#10;WHEN &apos;Orders&apos;               THEN SUM([order_countd])&#13;&#10;WHEN &apos;Order Product Countd&apos; THEN SUM([products_distinct_order_avg])&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Metric 1' datatype='real' name='[Metric_Catg 1 (copy)_1992561419984117763]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Daily Metric (copy)_1992561419983802369]&#13;&#10;&#10;WHEN &apos;AOV&apos;  THEN AVG([gmv_eur_order_avg])&#13;&#10;WHEN &apos;ABS&apos;  THEN SUM([qty_sold_order_avg])&#13;&#10;&#13;&#10;WHEN &apos;ATC Rank Absolute (avg)&apos;      THEN AVG([add_to_cart_rank_non_boosted_abs_avg])&#13;&#10;WHEN &apos;ATC Rank Absolute (median)&apos;   THEN AVG([add_to_cart_rank_non_boosted_abs_median])&#13;&#10;WHEN &apos;ATC Rank Normalized (avg)&apos;    THEN AVG([add_to_cart_rank_non_boosted_norm_avg])&#13;&#10;WHEN &apos;ATC Rank Normalized (median)&apos; THEN AVG([add_to_cart_rank_non_boosted_norm_median])&#13;&#10;&#13;&#10;WHEN &apos;ATC Time (avg)&apos;               THEN AVG([add_to_cart_time_non_boosted_avg])&#13;&#10;&#13;&#10;WHEN &apos;Customers&apos;            THEN SUM([customer_countd])&#13;&#10;WHEN &apos;Orders&apos;               THEN SUM([order_countd])&#13;&#10;WHEN &apos;Order Product Countd&apos; THEN SUM([products_distinct_order_avg])&#13;&#10;&#13;&#10;END' />
      </column>
