          <datasource-dependencies datasource='federated.1x1hc3x168tzbm1bicgl50cesi5r'>
            <column caption='Metric 2' datatype='real' name='[Metric_Catg 1 (copy) (copy)_1992561419984523268]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Daily Metric (copy) (copy)_1992561419983814658]&#13;&#10;&#13;&#10;WHEN &apos;AOV&apos;  THEN AVG([gmv_eur_order_avg])&#13;&#10;WHEN &apos;ABS&apos;  THEN SUM([qty_sold_order_avg])&#13;&#10;&#13;&#10;WHEN &apos;ATC Rank Absolute (avg)&apos;      THEN AVG([add_to_cart_rank_non_boosted_abs_avg])&#13;&#10;WHEN &apos;ATC Rank Absolute (median)&apos;   THEN AVG([add_to_cart_rank_non_boosted_abs_median])&#13;&#10;WHEN &apos;ATC Rank Normalized (avg)&apos;    THEN AVG([add_to_cart_rank_non_boosted_norm_avg])&#13;&#10;WHEN &apos;ATC Rank Normalized (median)&apos; THEN AVG([add_to_cart_rank_non_boosted_norm_median])&#13;&#10;&#13;&#10;WHEN &apos;ATC Time (avg)&apos;               THEN AVG([add_to_cart_time_non_boosted_avg])&#13;&#10;&#13;&#10;WHEN &apos;Customers&apos;            THEN SUM([customer_countd])&#13;&#10;WHEN &apos;Orders&apos;               THEN SUM([order_countd])&#13;&#10;WHEN &apos;Order Product Countd&apos; THEN SUM([products_distinct_order_avg])&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Metric 1' datatype='real' name='[Metric_Catg 1 (copy)_1992561419984117763]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Daily Metric (copy)_1992561419983802369]&#13;&#10;&#10;WHEN &apos;AOV&apos;  THEN AVG([gmv_eur_order_avg])&#13;&#10;WHEN &apos;ABS&apos;  THEN SUM([qty_sold_order_avg])&#13;&#10;&#13;&#10;WHEN &apos;ATC Rank Absolute (avg)&apos;      THEN AVG([add_to_cart_rank_non_boosted_abs_avg])&#13;&#10;WHEN &apos;ATC Rank Absolute (median)&apos;   THEN AVG([add_to_cart_rank_non_boosted_abs_median])&#13;&#10;WHEN &apos;ATC Rank Normalized (avg)&apos;    THEN AVG([add_to_cart_rank_non_boosted_norm_avg])&#13;&#10;WHEN &apos;ATC Rank Normalized (median)&apos; THEN AVG([add_to_cart_rank_non_boosted_norm_median])&#13;&#10;&#13;&#10;WHEN &apos;ATC Time (avg)&apos;               THEN AVG([add_to_cart_time_non_boosted_avg])&#13;&#10;&#13;&#10;WHEN &apos;Customers&apos;            THEN SUM([customer_countd])&#13;&#10;WHEN &apos;Orders&apos;               THEN SUM([order_countd])&#13;&#10;WHEN &apos;Order Product Countd&apos; THEN SUM([products_distinct_order_avg])&#13;&#10;&#13;&#10;END' />
