    <dashboard name='Weekday Metrics'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='16'>Weekday Metrics Table</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/EntityLevelRanking/WeekdayMetrics?rev=' id='WeekdayMetrics' path='/t/GlobalStandardReporting/workbooks/EntityLevelRanking' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='table'>
          <format attr='background-color' value='#555555' />
        </style-rule>
        <style-rule element='dash-title'>
          <format attr='background-color' value='#1b1b1b' />
        </style-rule>
      </style>
      <size sizing-mode='automatic' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='_tableau_category_product_ranking_entity_level_report (cl_data_science_qcommerce)' name='federated.1x1hc3x168tzbm1bicgl50cesi5r' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Select Metric' datatype='string' name='[Compare Metric 1 (copy)_2241948253276737539]' param-domain-type='list' role='measure' type='nominal' value='&quot;AOV&quot;'>
          <calculation class='tableau' formula='&quot;AOV&quot;' />
          <aliases>
            <alias key='&quot;ATC Non Boosted Time (avg)&quot;' value='ATC Time Non-Boosted' />
          </aliases>
          <members>
            <member value='&quot;AOV&quot;' />
            <member value='&quot;ABS&quot;' />
            <member value='&quot;ATC Rank Non Boosted Absolute (avg)&quot;' />
            <member value='&quot;ATC Rank Non Boosted Absolute (median)&quot;' />
            <member value='&quot;ATC Rank Non Boosted Normalized (avg)&quot;' />
            <member value='&quot;ATC Rank Non Boosted Normalized (median)&quot;' />
            <member alias='ATC Time Non-Boosted' value='&quot;ATC Non Boosted Time (avg)&quot;' />
            <member value='&quot;Customers&quot;' />
            <member value='&quot;Orders&quot;' />
            <member value='&quot;Order Product Countd&quot;' />
            <member value='&quot;Vendors&quot;' />
            <member value='&quot;Warehouses&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.1x1hc3x168tzbm1bicgl50cesi5r'>
        <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
        <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
        <column-instance column='[date]' derivation='None' name='[none:date:qk]' pivot='key' type='quantitative' />
        <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
      </datasource-dependencies>
      <zones>
