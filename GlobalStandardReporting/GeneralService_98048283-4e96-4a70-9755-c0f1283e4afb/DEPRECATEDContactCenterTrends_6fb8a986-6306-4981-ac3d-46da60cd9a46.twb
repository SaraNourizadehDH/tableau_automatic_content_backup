      <column caption='GST Regions' datatype='string' name='[Calculation_104145778124697602]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[gcc_region]' />
      </column>
      <column caption='QUALITY Header' datatype='string' name='[Calculation_1093811782759759872]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Calculation_126523021110427648]) = FALSE THEN &apos;QUALITY&apos; END' />
      </column>
      <column caption='Signed Rate' datatype='real' default-format='p0%' name='[Calculation_113927057677742080]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([signed_evaluations])/ sum([evaluations])' />
      </column>
      <column caption='Chats %' datatype='real' name='[Calculation_1206120335650996224]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL([incoming_chats], 0))/&#13;&#10;SUM([Calculation_126523021110427648])' />
      </column>
      <column caption='Inbound Emails %' datatype='real' name='[Calculation_1206120335651475457]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([incoming_cases])/sum([Calculation_126523021110427648])' />
      </column>
      <column caption='AHT' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1206120335674859525]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  [Parameters].[Parameter 7]=&apos;AHT for Live&apos; then [Calculation_2355664125622820864] &#13;&#10;ELSEIF [Parameters].[Parameter 7]=&apos;AHT non Live&apos; then [AHT Chat (copy)]&#13;&#10;END' />
      </column>
      <column caption='CS  CPC' datatype='real' name='[Calculation_1228356847421263874]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1327999001393680386])/sum([Total Contact Disptching (copy)])' />
      </column>
      <column caption='KPIS 1' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1237926992845287424]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 3]=&apos;Productivity&apos; THEN [Calculation_286893405478703106]&#13;&#10;ELSEIF  [Parameters].[Parameter 3]=&apos;Shrinkage&apos; then [2nd Level Request Answer Rate (copy 5)]*100&#13;&#10;ELSEIF  [Parameters].[Parameter 3]=&apos;AC NPS&apos; THEN [Calculation_502995822125400064]&#13;&#10;ELSEIF  [Parameters].[Parameter 3]=&apos;% Audited Issues&apos; THEN [Calculation_615796940107870208]*100&#13;&#10;END' />
      </column>
      <column caption='Net Orders' datatype='integer' default-format='n#,##0,.0K;-#,##0,.0K' name='[Calculation_126523021110427648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [global_entity_id],[created_date], [vertical], [delivery_type], [is_subscription]: max([successful_orders])}&#13;&#10;&#13;&#10;//  fixes to avoid duplications' />
      </column>
      <column caption='CS Costs EUR' datatype='real' name='[Calculation_1327999001393680386]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [global_entity_id],[month], [vertical], [delivery_type]: max([sum_end_customer_service_eur])}' />
      </column>
      <column caption='PS Costs EUR' datatype='real' name='[Calculation_1327999001394638851]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [global_entity_id],[month], [vertical], [delivery_type]: max([sum_restaurant_services_eur])}' />
      </column>
      <column caption='RS Costs EUR' datatype='real' name='[Calculation_1327999001395548164]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [global_entity_id],[month], [vertical], [delivery_type]: max([sum_dispatching_costs_eur])}' />
      </column>
      <column caption='Issue Rate' datatype='real' default-format='p0.0%' name='[Calculation_1359101970151641088]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_530791456112443392])/ SUM([Calculation_126523021110427648])' />
      </column>
      <column caption='RS Cost per Order (CPO)' datatype='real' name='[Calculation_135952462903009281]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1327999001395548164])/SUM([Calculation_126523021110427648])' />
      </column>
      <column caption='Hide LAST MONTH' datatype='boolean' name='[Calculation_1373597947888529409]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[report_date]) &lt;=  {MAX(DATETRUNC(&apos;month&apos;,[report_date])-1)}' />
      </column>
      <column caption='Issues DP' datatype='integer' name='[Calculation_1442840798434844673]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [stakeholder]=&apos;Rider&apos; THEN [Calculation_530791456112443392] END' />
      </column>
      <column caption='RS OD Issue Rate' datatype='real' default-format='p0.0%' name='[Calculation_1442840798456725509]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1442840798434844673])/SUM([Orders (copy 2)_1442840798455828483])' />
      </column>
      <column caption='Total Contact Rate' datatype='real' default-format='p0.0%' name='[Calculation_1499135771098468353]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IFNULL([inbound_calls],0))&#13;&#10;+SUM(IFNULL([incoming_chats],0))&#13;&#10;+sum(IFNULL([incoming_cases],0)) //includes SoME&#13;&#10;)&#13;&#10;/&#10;SUM([Calculation_852587732229459968])' />
      </column>
      <column caption='1' datatype='integer' name='[Calculation_1679561242900000768]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Score financial' datatype='real' name='[Calculation_171629421912485891]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;IFNULL([Score cost/revenue (copy)],0) +&#10;IFNULL([Calculation_366128629720432642],0)&#10;)/ &#10;(&#10;IF ISNULL([Score cost/revenue (copy)]) THEN 0 ELSE 1 END +&#10;IF ISNULL([Calculation_366128629720432642]) THEN 0 ELSE 1 END &#10;)' />
      </column>
      <column caption='Rank' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1728256411808526336]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Cost per order (CPO)' datatype='real' name='[Calculation_1728256411809554433]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_costs_eur]) /SUM([Calculation_126523021110427648])' />
      </column>
      <column caption='Total  CPC' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1728256412141338628]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_1327999001393680386])+sum([Calculation_1327999001394638851])+sum([Calculation_1327999001395548164])+sum([RS Costs EUR (copy)]))/sum([Total Contact CS (copy)])' />
      </column>
      <column caption='date - d' datatype='string' hidden='true' name='[Calculation_184155067128008704]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF len(STR(DATEPART(&apos;day&apos;,[report_date]))) == 1 THEN &apos;0&apos; + str(DATEPART(&apos;day&apos;,[report_date]))&#10;ELSE str(DATEPART(&apos;day&apos;,[report_date]))&#10;END' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_1900659842198413312]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='all shifts' datatype='integer' name='[Calculation_1936125657671262210]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(SUM([evaluated]),0)+IFNULL(sum(punched),0)+IFNULL(sum([no_evaluation]),0)' />
      </column>
      <column caption='% 1-time contacts' datatype='real' default-format='p0%' name='[Calculation_1993405800907108353]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([count_first_contact_resolution])/sum([count_contacts_related_to_order])' />
      </column>
      <column caption='Total Cost per order (CPO)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2113314170671042562]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(ifnull([Calculation_1327999001393680386],0) +&#10;ifnull([Calculation_1327999001394638851],0) +&#10;ifnull([Calculation_1327999001395548164],0) +&#10;ifnull([RS Costs EUR (copy)],0)&#10;)/SUM([Calculation_126523021110427648])' />
      </column>
      <column caption='PS  Cost per order (CPO)' datatype='real' name='[Calculation_2113314170681819144]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_1327999001394638851])/SUM([Calculation_126523021110427648])' />
      </column>
      <column caption='SF  Cost per order (CPO)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2113314170687021073]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([RS Costs EUR (copy)])/SUM([Calculation_126523021110427648])' />
      </column>
      <column caption='Total Costs' datatype='real' name='[Calculation_2113314170689699864]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Calculation_1327999001393680386],0)+IFNULL([Calculation_1327999001395548164],0)+IFNULL([Calculation_1327999001394638851],0)+IFNULL([RS Costs EUR (copy)],0)' />
      </column>
      <column caption='% CS cost' datatype='real' default-format='p0.0%' name='[Calculation_2113314170689908761]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_1327999001393680386])/sum([Calculation_2113314170689699864])' />
      </column>
      <column caption='Contact Center' datatype='string' name='[Calculation_222857857467572224]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF 1 = 1 then [contact_center] END&#10;&#10;// IF [Management Entity] = &apos;Carriage&apos; THEN &apos;SSC Carriage&apos;&#10;// ELSEIF [Management Entity] = &apos;Talabat&apos; THEN &apos;SSC TalabatOtlob&apos;&#10;// ELSEIF [Display Name] = &apos;FP - Pakistan&apos; THEN &apos;Pakistan&apos;&#10;// ELSEIF [Management Entity] = &apos;Pedidosya&apos; THEN &apos;SSC PedidosYa&apos;&#10;// ELSEIF [Management Entity] = &apos;Yemeksepeti&apos; THEN &apos;Turkey&apos;&#10;// ELSEIF [Management Entity] = &apos;Donesi&apos; THEN &apos;Balkans&apos;&#10;// ELSEIF [Display Name] = &apos;FP - Bangladesh&apos; THEN &apos;Bangladesh&apos;&#10;// ELSEIF [Management Entity] = &apos;HungerStation&apos; THEN &apos;Saudi Arabia&apos;&#10;// ELSEIF [Management Entity] = &apos;Foodora&apos; THEN &apos;Canada&apos; &#10;// ELSEIF [Management Entity] = &apos;ClickDelivery&apos; THEN &apos;SSC Domicilios&apos;&#10;// ELSEIF [Management Entity] = &apos;DH Greece&apos; THEN &apos;Greece&apos;&#10;// ELSEIF [Management Entity] = &apos;Foodpanda APAC&apos; THEN &apos;SSC APAC&apos;&#10;// ELSEIF [Management Entity] = &apos;Pauza&apos; THEN &apos;Croatia&apos;&#10;// ELSEIF [Management Entity] = &apos;DH Korea&apos; THEN &apos;South Korea&apos;&#10;// ELSEIF [Management Entity] = &apos;DH Austria&apos; THEN &apos;Austria&apos;&#10;// ELSEIF  [Display Name] = &apos;FD - Finland&apos; THEN &apos;Finland&apos;&#10;// ELSEIF  [Display Name] = &apos;Pizza-Online Finland&apos; THEN &apos;Finland&apos;&#10;// ELSEIF  [Display Name] = &apos;Onlinepizza Sweden&apos; THEN &apos;Sweden&apos;&#10;// ELSEIF  [Display Name] = &apos;FD - Sweden&apos; THEN &apos;Sweden&apos;&#10;// ELSEIF  [Display Name] = &apos;FD - Norway&apos; THEN &apos;Norway&apos;&#10;&#10;&#10;// ELSEIF  [Display Name] = &apos;FP - Romania&apos; THEN &apos;Romania&apos;&#10;// ELSEIF  [Display Name] = &apos;HipMenu - RO&apos; THEN &apos;Romania&apos;&#10;&#10;&#10;// ELSEIF  [Display Name] = &apos;Damejidlo&apos; THEN &apos;Czech Republic&apos;&#10;&#10;// ELSEIF  [Display Name] = &apos;Hungary&apos; THEN &apos;Hungary&apos;&#10;// ELSEIF  [Display Name] = &apos;FP - Bulgaria&apos; THEN &apos;Bulgaria&apos;&#10;// END' />
      </column>
      <column caption='Eligibility' datatype='string' name='[Calculation_235313134952333312]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if &#10;    (&#10;    if ISNULL([AC NPS (copy)]) then 0 else 1 end&#10;    +&#10;    if ISNULL([Score financial (copy 2)]) then 0 else 1 end&#10;    +&#10;    if ISNULL([Overall Service Level Agreement (copy)]) then 0 else 1 end&#10;    +&#10;    if ISNULL([Score Productivity (copy 3)]) then 0 else 1 end&#10;    +&#10;    if ISNULL([Score Productivity (copy 4)]) then 0 else 1 end&#10;    +&#10;    if ISNULL([Score Productivity (copy)]) then 0 else 1 end&#10;    ) &gt; 1&#10;THEN &apos;Yes&apos; ELSE &apos;No&apos; END' />
      </column>
      <column caption='AHT for Live' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_2355664125622820864]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5239727116595236865]+[Calculation_5239727116595089408]' />
      </column>
      <column caption='Score quality' datatype='real' name='[Calculation_246431395838017536]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;IFNULL([AC NPS (copy)],0) +&#10;IFNULL([Score financial (copy 2)],0) + &#10;IFNULL([Overall Service Level Agreement (copy)],0)&#10;)/ &#10;(&#10;IF ISNULL([AC NPS (copy)]) THEN 0 ELSE 1 END +&#10;IF ISNULL([Score financial (copy 2)]) THEN 0 ELSE 1 END + &#10;IF ISNULL([Overall Service Level Agreement (copy)]) THEN 0 ELSE 1 END&#10;)' />
      </column>
      <column caption='issue total mom %' datatype='real' name='[Calculation_285415687538565120]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;SUM([issues_total]) - SUM([issues_total_mom])&#10;)&#10;/ &#10;SUm([issues_total_mom])' />
      </column>
      <column caption='Productivity' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_286893405478703106]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(  [Calculation_530791456113037313])&#13;&#10;&#13;&#10;/&#13;&#10;(&#13;&#10;&#13;&#10; SUM([hours_clocked_net])&#13;&#10;)' />
      </column>
      <column caption='KPI' datatype='string' name='[Calculation_293578448056033281]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
      </column>
      <column caption='Score quality weight' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_366128629716828161]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([Calculation_246431395838017536]) THEN 0 &#10;ELSE [Parameters].[Parameter 2] END' />
      </column>
      <column caption='Score cost/revenue' datatype='integer' datatype-customized='true' name='[Calculation_366128629720432642]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(NULL)' />
      </column>
      <column caption='Score volume' datatype='real' name='[Calculation_366128629723848708]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;IFNULL([Score Productivity (copy 2)],0) + &#10;IFNULL([Score inbound contact rate (copy)],0) +&#10;IFNULL([Score inbound contact rate (copy 2)],0)&#10;) &#10;/&#10;(&#10;IF ISNULL([Score Productivity (copy 2)]) THEN 0 ELSE 1 END +&#10;IF ISNULL([Score inbound contact rate (copy)]) THEN 0 ELSE 1 END +&#10;IF ISNULL([Score inbound contact rate (copy 2)]) THEN 0 ELSE 1 END&#10;)' />
      </column>
      <column caption='total score' datatype='real' name='[Calculation_366128629724884997]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_366128629716828161] + [Score quality weight (copy)] + [Score financial (copy)]' />
      </column>
      <column caption='Score quality weight %' datatype='real' default-format='p0.0%' name='[Calculation_366128629727199238]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_366128629716828161]/ [Calculation_366128629724884997]' />
      </column>
      <column caption='final score' datatype='real' name='[Calculation_366128629744963592]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_235313134952333312]=&apos;Yes&apos; THEN&#10;(IFNULL(([Calculation_246431395838017536] * [Calculation_366128629727199238]),0) +&#10;IFNULL(([Score quality (copy)] * [Score quality weight % (copy)]),0) +&#10;IFNULL(([Calculation_171629421912485891] * [Score WFM weight % (copy)]),0)&#10;) END' />
      </column>
      <column caption='AC NPS' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_502995822125400064]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF zn(SUM([nps_ac_responses])) = 0 THEN NULL &#10;ELSE&#10;100* (zn(SUM([nps_ac_promoters])) - zn(SUM([nps_ac_detractors])))/SUM([nps_ac_responses])&#10;END' />
      </column>
      <column caption='Total CPC capped' datatype='real' name='[Calculation_506021652331597824]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_1327999001393680386])+sum([Calculation_1327999001394638851])+sum([Calculation_1327999001395548164])+sum([RS Costs EUR (copy)]))/sum([Total Contact CS (copy)])' />
      </column>
      <column caption='AHT Phone' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_5239727116595089408]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//IFNULL([Inbound AVG After Call Handling Time Sec],0)+&#10;IFNULL([Fake Chat Occupancy Rate (copy)],0)&#10;//+IFNULL([Inbound AVG Call Waiting Time Sec],0))&#10;/60&#10;&#10;// -- corrected to align with GCC Report' />
      </column>
      <column caption='AHT Chat' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_5239727116595236865]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//(IFNULL([Inbound AVG After Chat Handling Time Sec],0)+&#13;&#10;//IFNULL([Inbound AVG Chat Waiting Time Sec],0) +&#10;IFNULL([Outbound AVG Call Time Sec (copy 2)],0)&#10;&#10; / 60' />
      </column>
      <column caption='Own Delivery Rate' datatype='real' default-format='p0.0%' name='[Calculation_530158182333104128]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([od_orders])&#10;/&#10;SUM([total_orders])' />
      </column>
      <column caption='issues Total' datatype='integer' default-format='n#,##0,.00K;-#,##0,.00K' name='[Calculation_530791456112443392]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL ([incoming_cases] ,0) + //includes S0Me&#13;&#10;IFNULL ([incoming_chats] ,0) +&#13;&#10;IFNULL ([inbound_calls] ,0) +&#13;&#10;IFNULL([outbound_calls], 0)' />
      </column>
      <column caption='issues Completed' datatype='real' name='[Calculation_530791456113037313]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([served_calls] ,0) + // same as served_calls&#13;&#10;IFNULL([served_chats],0)  + // same as served_chats&#13;&#10;IFNULL([working_items_l1] ,0)' />
      </column>
      <column caption='Audits / Contacts' datatype='real' default-format='p0.0%' name='[Calculation_615796940107870208]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([evaluations])&#10; /&#10;(&#10;ZN(SUM([inbound_calls]))&#10;+ZN(SUM([served_chats]))&#10;+ZN(SUM([working_items_l1]))&#10;)&#10;//this part is just added to create NULLS for the cases that there is no evaluation at all (as an oppose to 0)&#10;*(sum([evaluations])/sum([evaluations]))' />
      </column>
      <column caption='QA Score' datatype='real' default-format='p0%' name='[Calculation_615796940115410945]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([qa_score])&#10;/(sum([evaluations])* 100)' />
      </column>
      <column caption='Outbound Call Rate' datatype='real' default-format='p0.0%' name='[Calculation_624663386307125248]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL([outbound_calls], 0))/&#10;SUM([Calculation_852587732229459968])' />
      </column>
      <column caption='DH Regions' datatype='string' name='[Calculation_707909601279090688]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[dh_region]' />
      </column>
      <column caption='Display sheet' datatype='string' name='[Calculation_760263935662714882]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 8]' />
      </column>
      <column caption='Productivity (contacts) capped' datatype='real' name='[Calculation_760263935687176196]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Productivity (copy 2)_1046594352216743940] &gt;= 80 THEN 80&#13;&#10;ELSE [Productivity (copy 2)_1046594352216743940]&#13;&#10;END' />
      </column>
      <column caption='Date Range' datatype='date' name='[Calculation_786441134205132801]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[created_date]' />
      </column>
      <column caption='New CSAT' datatype='real' default-format='p0%' name='[Calculation_807551745868529664]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(zn(SUM([count_csat_4])) + zn(SUM([count_csat_5])) )&#13;&#10;/&#13;&#10;SUM([csat_responses])' />
      </column>
      <column caption='Contact Deflection Rate' datatype='real' default-format='p0%' name='[Calculation_807551745954127873]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Contact deflection rate from HC Report:&#13;&#10;//1 - [Contacts]/sum([Successful Sessions])&#13;&#10;&#13;&#10;&#13;&#10;// contacts defined as:&#13;&#10;//([Valid Chats])+sum([Tickets Created])&#13;&#10;&#13;&#10;// valid chats defined as:&#13;&#10;//sum([Chats Created]) - ([Accidental Chats])&#13;&#10;&#13;&#10;//chats creatd:&#13;&#10;//sum_chats_created&#13;&#10;&#13;&#10;// accidental chats:&#13;&#10;//SUM([sum_dropped_chats_5s]) &gt;&gt; same as [Accidental Chats]&#13;&#10;//SUM([Accidental Chats])&#13;&#10;&#13;&#10;//put it all together&#13;&#10;//1 - (((sum([Sum Chats Created]) - SUM([Is Own Delivery])))+SUM([Tickets Created]))/SUM([Successful Sessions])&#10;&#10;&#10;// RA-3650 : Updating HC contact deflection rate calculation based on new formula : 1 - (# Contacts / # Successful Sessions)&#10;1 - ((SUM([sum_chats_created]) + SUM([tickets_created])) / SUM([successful_sessions]))' />
      </column>
      <column caption='Date' datatype='string' name='[Calculation_850898904035840001]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if  [Parameters].[Parameter 5]=&apos;Daily&apos; then  str([created_date])&#13;&#10;ELSEIF  [Parameters].[Parameter 5]=&apos;Weekly&apos; then  [week]&#13;&#10;ELSEif [Parameters].[Parameter 5]=&apos;Monthly&apos; then [month]&#13;&#10;elseif [Parameters].[Parameter 5]=&apos;Quarterly&apos; then  &apos;Q&apos;+str([date - m (copy)])&#13;&#10;END' />
      </column>
      <column caption='Outbound Calls AHT' datatype='real' name='[Calculation_850898904054214659]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([total_outbound_call_time_sec])/SUM([outbound_calls]))/60' />
      </column>
      <column caption='Inbound Calls - AHT' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_850898904066105349]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//(IFNULL([Inbound AVG After Call Handling Time Sec],0)+&#13;&#10;IFNULL([Fake Chat Occupancy Rate (copy)],0)&#10;//+IFNULL([Inbound AVG Call Waiting Time Sec],0))&#10;&#10;/60' />
      </column>
      <column caption='# Non-Live' datatype='real' name='[Calculation_850898904087347206]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[inbound_emails]' />
      </column>
      <column caption='Non Live SLA 8h' datatype='real' default-format='p0.0%' name='[Calculation_850898904105181192]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([answered_emails_in8hrs])/sum([inbound_emails])' />
      </column>
      <column caption='Gross Orders' datatype='integer' name='[Calculation_852587732229459968]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [global_entity_id],[created_date], [vertical], [delivery_type], [is_subscription], [is_preorder]: max([total_orders])}&#10;&#13;&#10;&#13;&#10;//  fixes to avoid duplications' />
      </column>
      <column caption='2019 Filter' datatype='integer' name='[Calculation_970244308479684608]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [report_date] &gt;= #2019-01-01# THEN 1 ELSE 0 END' />
      </column>
      <column caption='filter - AC NPS for APAC' datatype='string' name='[Calculation_986288336523313152]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// remove AC NPS for APAC from 1st June 2020 onwards&#13;&#10;&#13;&#10;IF [Calculation_104145778124697602] = &apos;Asia Pacific&apos; and [report_date] &gt;= #2020-06-01# THEN &apos;out&apos;&#13;&#10;ELSE &apos;in&apos;&#13;&#10;END' />
      </column>
      <column caption='Inbound Call Contact Rate' datatype='real' default-format='p0.0%' name='[Call Service Level  (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([inbound_calls])&#10;/SUM([Calculation_852587732229459968])' />
      </column>
      <column caption='Overall Service Level Agreement' datatype='real' default-format='p0%' name='[Call Service Level -30 sec (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;SUM(IFNULL([count_sla_30s_calls],0))+&#10;SUM (IFNULL([count_sla_30s_chat],0)) +&#10;SUM(IFNULL([case_within_sla],0))&#10;) &#10;/&#10;(&#10;SUM(IFNULL([inbound_calls],0))+&#10;sum(IFNULL([incoming_chats],0))+&#10;SUM(IFNULL([incoming_cases],0))&#10;)' />
      </column>
      <column caption='Cost per order (CPO) (copy)' datatype='real' name='[Cost per order (CPO) (copy)_4758053050924359681]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({FIXED [global_entity_id],[created_date], [vertical], [delivery_type]: max([total_costs_eur])}) //-- fix to remove duplication' />
      </column>
      <column caption='GENERAL - Issue Rate - RS (OD only)' datatype='real' default-format='p0.0%' name='[DP OD I/O (copy)_1308295699744178177]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1442840798434844673])/SUM([Orders (copy 2)_1442840798455828483])' />
      </column>
      <column caption='Relative Date' datatype='date' name='[Date Range (copy)_5806195471106363395]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[created_date]' />
      </column>
      <column caption='Inbound AVG Call Time Sec' datatype='real' default-format='n#,##0.0' name='[Fake Chat Occupancy Rate (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([inbund_ht_call])/SUM([served_calls])' />
      </column>
      <column caption='Granularity Level ()' datatype='string' name='[Granularity Level (copy)]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if  [Parameters].[Parameter 5]=&apos;Daily&apos; then  str([created_date])&#13;&#10;ELSEIF  [Parameters].[Parameter 5]=&apos;Weekly&apos; then  [week]&#13;&#10;ELSEif [Parameters].[Parameter 5]=&apos;Monthly&apos; then [month]&#13;&#10;elseif [Parameters].[Parameter 5]=&apos;Quarterly&apos; then  &apos;Q&apos;+str([date - m (copy)])&#13;&#10;END' />
      </column>
      <column caption='Gross Orders- not formatted' datatype='integer' default-format='n#,##0;-#,##0' name='[Gross Orders (copy)_2497949687351554049]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [global_entity_id],[created_date], [vertical], [delivery_type], [is_subscription]: max([total_orders])}&#13;&#10;&#13;&#10;//  fixes to avoid duplications' />
      </column>
      <column caption='Inbound AVG Total Chat Handling Time Sec' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Inbound AVG After Chat Handling Time Sec (copy)_5806195470337642496]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;IFNULL([wrap_up_time_chat],0)&#10;+ IFNULL([handling_time_chat],0)&#10;)&#10;/SUM([served_chats])&#10;/60' />
      </column>
      <column caption='Inbound AVG Call Waiting Time Sec' datatype='real' default-format='n#,##0.0' name='[Inbound AVG Call Time Sec (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([queue_time_served_call])/SUM([served_calls])' />
      </column>
      <column caption='Inbound AVG After Call Handling Time Sec' datatype='real' default-format='n#,##0.0' name='[Inbound AVG Call Waiting Time Sec (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//SUM([total_inbound_after_call_handling_time_sec])/SUM([served_calls])&#10;&#10;SUM([wrap_up_time_call])/SUM([served_calls])' />
      </column>
      <column caption='Inbound AVG Chat Waiting Time Sec' datatype='real' name='[Inbound AVG Chat Time Sec (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_inbound_chat_waiting_time_sec])/SUM([accepted_chats])' />
      </column>
      <column caption='Inbound AVG After Chat Handling Time Sec' datatype='real' name='[Inbound AVG Chat Waiting Time Sec (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_inbound_after_chat_handling_time_sec])/SUM([accepted_chats])' />
      </column>
      <column caption='GENERAL - Issue Rate - All dept. (OD+VD)' datatype='real' default-format='p0.0%' name='[Issue Rate (copy)_1308295699743903744]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_530791456112443392])/ SUM([Calculation_126523021110427648])' />
      </column>
      <column caption='Dimensions' datatype='string' default-format='n#,##0.0;-#,##0.0' name='[KPIS 1 (copy)]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 6]=&apos;Country&apos; THEN [country]&#13;&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;DH Regions&apos; THEN [Calculation_707909601279090688]&#13;&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Contact Center&apos; THEN [contact_center]&#13;&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Management Entity&apos; THEN [management_entity_group]&#13;&#10;//ELSEIF  [Parameters].[Dimensions]=&apos;Display Name&apos; THEN [display_name]&#13;&#10;//ELSEIF  [Parameters].[Dimensions]=&apos;Global&apos; THEN [Global]&#13;&#10;&#13;&#10;END' />
      </column>
      <column datatype='string' name='[Management Entity (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[management_entity_group]' new-bin='true'>
          <bin default-name='true' value='&quot;ClickDelivery &amp; Pedidosya&quot;'>
            <value>&quot;ClickDelivery&quot;</value>
            <value>&quot;Pedidosya&quot;</value>
          </bin>
          <bin default-name='true' value='&quot;DH Greece, Donesi, Pauza&quot;'>
            <value>&quot;DH Greece&quot;</value>
            <value>&quot;Donesi&quot;</value>
            <value>&quot;Pauza&quot;</value>
          </bin>
        </calculation>
      </column>
      <column caption='Management Entity Group ' datatype='string' hidden='true' name='[Management Entity Group (copy)]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[management_entity_group]' />
      </column>
      <column caption='OD  Orders' datatype='integer' default-format='n#,##0.0;-#,##0.0' name='[Orders (copy 2)_1442840798455828483]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [global_entity_id],[created_date], [vertical], [delivery_type], [is_subscription]: max([od_orders])}' />
      </column>
      <column caption='Inbound AVG Chat Time Sec' datatype='real' name='[Outbound AVG Call Time Sec (copy 2)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([handling_time_chat])/SUM([served_chats])' />
