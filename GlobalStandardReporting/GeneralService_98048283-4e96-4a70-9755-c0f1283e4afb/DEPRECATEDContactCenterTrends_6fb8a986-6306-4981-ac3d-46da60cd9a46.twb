            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
            <column caption='Dimensions' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;DH Regions&quot;'>
