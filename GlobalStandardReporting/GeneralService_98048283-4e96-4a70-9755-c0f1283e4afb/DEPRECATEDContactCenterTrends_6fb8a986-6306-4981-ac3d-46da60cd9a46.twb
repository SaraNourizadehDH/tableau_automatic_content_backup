            </column>
            <column caption='Dimensions' datatype='string' default-format='n#,##0.0;-#,##0.0' name='[KPIS 1 (copy)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 6]=&apos;Country&apos; THEN [country]&#13;&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;DH Regions&apos; THEN [Calculation_707909601279090688]&#13;&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Contact Center&apos; THEN [contact_center]&#13;&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Management Entity&apos; THEN [management_entity_group]&#13;&#10;//ELSEIF  [Parameters].[Dimensions]=&apos;Display Name&apos; THEN [display_name]&#13;&#10;//ELSEIF  [Parameters].[Dimensions]=&apos;Global&apos; THEN [Global]&#13;&#10;&#13;&#10;END' />
