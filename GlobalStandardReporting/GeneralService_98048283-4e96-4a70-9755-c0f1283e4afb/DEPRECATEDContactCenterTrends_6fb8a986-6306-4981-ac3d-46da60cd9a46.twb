            </column>
            <column caption='Granularity Level ()' datatype='string' name='[Granularity Level (copy)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if  [Parameters].[Parameter 5]=&apos;Daily&apos; then  str([created_date])&#13;&#10;ELSEIF  [Parameters].[Parameter 5]=&apos;Weekly&apos; then  [week]&#13;&#10;ELSEif [Parameters].[Parameter 5]=&apos;Monthly&apos; then [month]&#13;&#10;elseif [Parameters].[Parameter 5]=&apos;Quarterly&apos; then  &apos;Q&apos;+str([date - m (copy)])&#13;&#10;END' />
            </column>
            <column caption='Dimensions' datatype='string' default-format='n#,##0.0;-#,##0.0' name='[KPIS 1 (copy)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 6]=&apos;Country&apos; THEN [country]&#13;&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;DH Regions&apos; THEN [Calculation_707909601279090688]&#13;&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Contact Center&apos; THEN [contact_center]&#13;&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Management Entity&apos; THEN [management_entity_group]&#13;&#10;//ELSEIF  [Parameters].[Dimensions]=&apos;Display Name&apos; THEN [display_name]&#13;&#10;//ELSEIF  [Parameters].[Dimensions]=&apos;Global&apos; THEN [Global]&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Total  Cost per Hour' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Total  CPC (copy)_1046594352193667072]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_costs_eur])/(SUM([hours_clocked_net]))' />
