            </column>
            <column caption='GCC Region' datatype='string' name='[Calculation_836262206650597405]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[gcc_region]&#10;&#10;//IF [Brand] = &apos;Yemeksepeti&apos; OR [Brand] = &apos;eFood&apos; THEN &apos;MENA&apos;&#13;&#10;//ELSE&#13;&#10;//[Region]&#13;&#10;//END' />
            </column>
