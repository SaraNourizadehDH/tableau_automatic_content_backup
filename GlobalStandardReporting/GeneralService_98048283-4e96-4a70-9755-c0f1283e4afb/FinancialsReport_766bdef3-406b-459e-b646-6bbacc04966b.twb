      <column caption='Relative' datatype='real' default-format='p0%' name='[Absolute (copy)_836262206645108759]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  [Parameters].[Parameter 1 2]=&apos;Personnel&apos; then [Calculation_836262206636806152]&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;Non Personnel&apos; then [Non Personnel (copy)_836262206637965323]&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;Overhead&apos; then [Calculation_836262206647537689]&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;Total&apos; then [Calculation_836262206742216736]&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;CC - Total&apos; then [% Total Costs (copy)_1369938767416520711]&#13;&#10;&#13;&#10;END'>
