        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Shape' />
            <mark-sizing mark-sizing-setting='marks-scaling-off' />
            <encodings>
              <lod column='[federated.1hcs3yh06ekl371cd9nc21w00ff1].[none:Calculation_4367436167953297408:nk]' />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run bold='true' fontcolor='#000000' fontsize='11'>Definitions</run>
                <run fontcolor='#000000'>: Graularity = Order_id</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>&#9;1.</run>
                <run bold='true' fontcolor='#000000'>Self Service Refund CPO =   </run>
                <run fontcolor='#000000'>Sum(EUR refunded  by HelpCenter)/ #Total Orders</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>&#9;2. </run>
                <run bold='true' fontcolor='#000000'>Self Service Compensation CPO =   </run>
                <run fontcolor='#000000'>Sum(EUR compensated  by HelpCenter)/ #Total Orders</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>&#9;3. </run>
                <run bold='true' fontcolor='#000000'>Self Service CPO = </run>
                <run bold='true' fontcolor='#12109d'>Self Service Refund CPO + Self Service Compensation CPO</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>Æ&#9;</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>&#9;4. </run>
                <run bold='true' fontcolor='#000000'>Agent Refund CPO =   </run>
                <run fontcolor='#000000'>Sum(EUR refunded  by OneView)/ #Total Orders</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>&#9;5. </run>
                <run bold='true' fontcolor='#000000'>Agent Compensation CPO =   </run>
                <run fontcolor='#000000'>Sum(EUR compensated  by OneView)/ #Total Orders</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>&#9;6. </run>
                <run bold='true' fontcolor='#000000'>Agent CPO =</run>
                <run bold='true' fontcolor='#12109d'> Agent Refund CPO + AgentCompensation CPO</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#12109d'>Æ&#9;</run>
                <run bold='true' fontcolor='#000000'>7. Service CPO = </run>
                <run fontcolor='#000000'>Æ </run>
                <run bold='true' fontcolor='#12109d'>Self Service CPO + Agent CPO</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000'>&#9;8. Refund CPO  = </run>
                <run bold='true' fontcolor='#12109d'>Self Service Refund CPO + Agent Refund CPO </run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000'>&#9;9. Compensation CPO  = </run>
                <run bold='true' fontcolor='#12109d'>Self Service Compensation CPO + Agent Compensation CPO </run>
                <run>Æ&#10;&#10;</run>
              </formatted-text>
            </customized-tooltip>
            <style>
              <style-rule element='mark'>
                <format attr='shape' value='Bug Tracking/light.png' />
                <format attr='size' value='1.5052486658096313' />
              </style-rule>
