            <column-instance column='[30D Cut Off (copy)_1529957237252063253]' derivation='User' name='[usr:30D Cut Off (copy)_1529957237252063253:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_5449074129769705479]' derivation='User' name='[usr:Calculation_5449074129769705479:qk]' pivot='key' type='quantitative' />
