    <worksheet name='CPC Details Tab'>
      <table>
        <view>
          <datasources>
            <datasource caption='financial_report' name='federated.0dl06ts1741pt512lww560iwffnr (copy)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Total' caption='Cost Type' datatype='string' name='[Parameter 1 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;CC - Total&quot;'>
              <calculation class='tableau' formula='&quot;CC - Total&quot;' />
              <aliases>
                <alias key='&quot;CC - Total&quot;' value='Total' />
                <alias key='&quot;Non Personnel&quot;' value='Non-Personnel Costs' />
                <alias key='&quot;Overhead&quot;' value='Overheads Costs' />
                <alias key='&quot;Personnel&quot;' value='Personnel Costs' />
              </aliases>
            </column>
            <column alias='Absolute Costs EUR' caption='KPIs' datatype='string' name='[Parameter 2 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Absolute&quot;'>
              <calculation class='tableau' formula='&quot;Absolute&quot;' />
              <aliases>
                <alias key='&quot;Absolute&quot;' value='Absolute Costs EUR' />
                <alias key='&quot;CPC&quot;' value='Cost per Contact (CPC) EUR' />
                <alias key='&quot;Relative&quot;' value='Percentage of Costs (Relative))' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0dl06ts1741pt512lww560iwffnr (copy)'>
            <column caption='CPC Overhead' datatype='real' name='[% Overhead (copy)_836262206647697434]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([sum_overheads_eur])/sum([Calculation_836262206630805507])' />
            </column>
            <column caption='CPC All' datatype='real' name='[% Total Costs (copy) (copy)_836262206742360098]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_836262206633590790])/sum([Calculation_836262206630805507])' />
            </column>
            <column caption='% CC - Total Costs' datatype='real' name='[% Total Costs (copy)_1369938767416520711]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM( [Total Costs (copy)_1369938767416520710]) / TOTAL(SUM([Total Costs (copy)_1369938767416520710]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='CPO All' datatype='real' name='[% Total Costs (copy)_836262206742347809]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_836262206633590790])/[Calculation_836262206626512897]' />
            </column>
            <column caption='Relative' datatype='real' default-format='p0%' name='[Absolute (copy)_836262206645108759]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Parameters].[Parameter 1 2]=&apos;Personnel&apos; then [Calculation_836262206636806152]&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;Non Personnel&apos; then [Non Personnel (copy)_836262206637965323]&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;Overhead&apos; then [Calculation_836262206647537689]&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;Total&apos; then [Calculation_836262206742216736]&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;CC - Total&apos; then [% Total Costs (copy)_1369938767416520711]&#13;&#10;&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='CPO' datatype='real' name='[CPC (copy)_836262206641778705]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Parameters].[Parameter 1 2]=&apos;Personnel&apos; then [Calculation_836262206631686148]&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;Non Personnel&apos; then [CPC Non Personnel (copy)_836262206637867018]&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;Overhead&apos; then [CPC Overhead (copy)_836262206647816219]&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;Total&apos; then [% Total Costs (copy)_836262206742347809]&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;CC - Total&apos; then [CPO All (copy)_1369938767416520709]&#10;&#10;// -- related to Dispatching OD Orders ONLY&#10;ELSEIF [Parameters].[Parameter 1 2] = &apos;RS OD - Personnel Costs&apos; THEN [CPO personnel  (copy)_3264757920249004035]&#10;ELSEIF [Parameters].[Parameter 1 2] = &apos;RS OD - Non-Personnel Costs&apos; THEN [CPO Non Personnel  (copy)_3264757920249540612]&#10;ELSEIF [Parameters].[Parameter 1 2] = &apos;RS OD -  Overheads Costs&apos; THEN [CPO Overhead (copy)_3264757920253382662]&#13;&#10;END' />
            </column>
            <column caption='Absolute' datatype='real' name='[CPC (copy)_836262206643036182]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Parameters].[Parameter 1 2]=&apos;Personnel&apos; then sum([sum_personnel_costs_eur])&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;Non Personnel&apos; then sum([sum_non_personnel_eur])&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;Overhead&apos; then sum([sum_overheads_eur])&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;Total&apos; then sum([Calculation_836262206633590790])&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;CC - Total&apos; then sum([Total Costs (copy)_1369938767416520710])&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='CC - CPC All' datatype='real' name='[CPC All (copy)_1369938767416520708]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Total Costs (copy)_1369938767416520710])/sum([Calculation_836262206630805507])' />
            </column>
            <column caption='CPO Non Personnel ' datatype='real' name='[CPC Non Personnel (copy)_836262206637867018]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_non_personnel_eur])/[Calculation_836262206626512897]' />
            </column>
            <column caption='CPO Overhead' datatype='real' name='[CPC Overhead (copy)_836262206647816219]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([sum_overheads_eur])/[Calculation_836262206626512897]' />
            </column>
            <column caption='CC - CPO All' datatype='real' name='[CPO All (copy)_1369938767416520709]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Total Costs (copy)_1369938767416520710])/[Calculation_836262206626512897]' />
            </column>
            <column caption='CPO Non Personnel - RS OD' datatype='real' name='[CPO Non Personnel  (copy)_3264757920249540612]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [stakeholder] = &apos;Rider&apos; THEN [sum_non_personnel_eur] END)&#10;/ &#10;SUM({FIXED [global_entity_id],[month]: max([od_total_successful_orders])})' />
            </column>
            <column caption='CPO Overhead - RS OD' datatype='real' name='[CPO Overhead (copy)_3264757920253382662]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [stakeholder] = &apos;Rider&apos; THEN [sum_overheads_eur] END)&#10;/ &#10;SUM({FIXED [global_entity_id],[month]: max([od_total_successful_orders])})' />
            </column>
            <column caption='CPO Personnel - RS OD' datatype='real' name='[CPO personnel  (copy)_3264757920249004035]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [stakeholder] = &apos;Rider&apos; THEN [sum_personnel_costs_eur] END)&#10;/ &#10;SUM({FIXED [global_entity_id],[month]: max([od_total_successful_orders])})' />
            </column>
            <column caption='CPC personnel' datatype='real' name='[CPO personnel  (copy)_836262206632566789]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_personnel_costs_eur])/sum([Calculation_836262206630805507])' />
            </column>
            <column caption='Global' datatype='string' name='[Calculation_836262206554877952]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;Global&apos;' />
            </column>
            <column caption='Successful orders' datatype='integer' name='[Calculation_836262206626512897]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({FIXED [global_entity_id],[month]: max([total_successful_orders])})' />
            </column>
            <column caption='All contacts ' datatype='integer' name='[Calculation_836262206630805507]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [stakeholder]=&apos;Support Function&apos; then {FIXED [global_entity_id],[month]: max([all_contacts])}&#13;&#10;ELSE&#13;&#10;[all_contacts]&#13;&#10;END' />
            </column>
            <column caption='CPO personnel ' datatype='real' name='[Calculation_836262206631686148]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_personnel_costs_eur])/[Calculation_836262206626512897]' />
            </column>
            <column caption='Total Costs' datatype='real' name='[Calculation_836262206633590790]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//IF  [Department]=&apos;Customer&apos; then &#13;&#10;//IFNULL([Personnel],0) +IFNULL([Overhead],0) +IFNULL([Non Personnel],0) &#13;&#10;//ELSE IFNULL([Personnel],0) + IFNULL([Overhead],0) +IFNULL([Non Personnel],0) END&#10;&#10;IFNULL([sum_personnel_costs_eur],0) + IFNULL([sum_overheads_eur],0) +IFNULL([sum_non_personnel_eur],0)' />
            </column>
            <column caption='% Personnel' datatype='real' name='[Calculation_836262206636806152]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_personnel_costs_eur]) / TOTAL(SUM([sum_personnel_costs_eur]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='CPC Non Personnel' datatype='real' name='[Calculation_836262206637330441]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_non_personnel_eur])/sum([Calculation_836262206630805507])' />
            </column>
            <column caption='CPC' datatype='real' name='[Calculation_836262206640726032]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Parameters].[Parameter 1 2]=&apos;Personnel&apos; then [CPO personnel  (copy)_836262206632566789]&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;Non Personnel&apos; then [Calculation_836262206637330441]&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;Overhead&apos; then [% Overhead (copy)_836262206647697434]&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;Total&apos; then [% Total Costs (copy) (copy)_836262206742360098]&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;CC - Total&apos; then [CPC All (copy)_1369938767416520708]&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='KPIs' datatype='real' default-format='N' name='[Calculation_836262206642098196]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 2 1]=&apos;CPO&apos; THEN round([CPC (copy)_836262206641778705],3)&#13;&#10;ELSEIF  [Parameters].[Parameter 2 1]=&apos;CPC&apos; THEN ROUND([Calculation_836262206640726032],3)&#13;&#10;ELSEIF  [Parameters].[Parameter 2 1]=&apos;Absolute&apos; THEN ROUND([CPC (copy)_836262206643036182],0)&#13;&#10;ELSEIF  [Parameters].[Parameter 2 1]=&apos;Relative&apos; THEN ROUND([Absolute (copy)_836262206645108759],2)*100&#10;//ELSEIF [Parameters].[KPIs]=&apos;CS Contacts&apos; THEN SUM([CS Contacts])&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='% Overhead' datatype='real' name='[Calculation_836262206647537689]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_overheads_eur]) / TOTAL(SUM([sum_overheads_eur]))'>
