    <worksheet name='Trend Deep Dive: Self Service'>
      <table>
        <view>
          <datasources>
            <datasource caption='cpo_contribution_report (rl)' name='federated.1hcs3yh06ekl371cd9nc21w00ff1' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Week' caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
              <aliases>
                <alias key='&quot;Date&quot;' value='Date' />
                <alias key='&quot;Month&quot;' value='Month' />
                <alias key='&quot;Week&quot;' value='Week' />
              </aliases>
            </column>
            <column caption='Select Metric' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;CPO&quot;'>
              <calculation class='tableau' formula='&quot;CPO&quot;' />
            </column>
            <column caption='Dimension' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Management Entity Group&quot;'>
              <calculation class='tableau' formula='&quot;Management Entity Group&quot;' />
            </column>
            <column caption='Segments' datatype='integer' name='[Parameter 5]' param-domain-type='range' role='measure' type='quantitative' value='10'>
              <calculation class='tableau' formula='10' />
              <range max='10' min='1' />
            </column>
            <column caption='Select Self Service Metric ' datatype='string' name='[Select Metric (copy)_1321736178205773835]' param-domain-type='list' role='measure' type='nominal' value='&quot;Self Service CPO&quot;'>
              <calculation class='tableau' formula='&quot;Self Service CPO&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1hcs3yh06ekl371cd9nc21w00ff1'>
            <column caption='Compensation CPO' datatype='real' name='[CPO (copy) (copy)_5449074129771008013]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//SUM([Compensation CPO_enum]) / IFNULL(SUM([Total Orders]), 1)&#10;IFNULL([Calculation_5449074129769553925],0) + IFNULL([Calculation_5449074129757630465],0)' />
            </column>
            <column caption='Self Service CPO' datatype='real' name='[CPO (copy)_5449074129769975816]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//SUM([Self Service CPO_enum]) / IFNULL(SUM([Total Orders]), 1)&#10;IFNULL([Calculation_5449074129769635846],0) + IFNULL([Calculation_5449074129769553925],0)' />
            </column>
            <column caption='Agent CPO' datatype='real' name='[CPO (copy)_5449074129770082313]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//([Agent CPO_enum_with_agent_cost]) / IFNULL(SUM([Total Orders]), 1)&#10;IFNULL([Calculation_5449074129769394180],0) + IFNULL([Calculation_5449074129757630465],0)' />
            </column>
            <column caption='Refund CPO' datatype='real' name='[CPO (copy)_5449074129770975244]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//SUM([Refund CPO_enum]) / IFNULL(SUM([Total Orders]), 1)&#10;IFNULL([Calculation_5449074129769635846],0) +  IFNULL([Calculation_5449074129769394180],0)' />
            </column>
            <column caption='Agent Claims' datatype='integer' name='[Calculation_5449074129757548544]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [refund_compensation_source] = &apos;OneView&apos; then [compensation_refund_claims] else 0 end)' />
            </column>
            <column caption='Agent Compensation CPO' datatype='real' name='[Calculation_5449074129757630465]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND((SUM(IF [refund_compensation_source] = &apos;OneView&apos; &#10;then [compensation_value_eur] END)&#10;+ [Calculation_5449074129757712386])&#10;/IFNULL(SUM([Calculation_5449074129768910851]), 1),3)' />
            </column>
            <column caption='Agent Cost' datatype='real' name='[Calculation_5449074129757712386]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5449074129757548544] * &#10;IFNULL(AVG([cost_per_contact]) * (-1),1)' />
            </column>
            <column caption='Total Orders' datatype='integer' name='[Calculation_5449074129768910851]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [global_entity_id],[created_date], [delivery_type],[vertical], &#10;[contact_reason_l3], [customer_maturity], [customer_loyalty_status], [brand], [country]&#10;: SUM([order_count])}&#10;&#10;//{FIXED [Global Entity Id],[Created Date] : SUM([Order Count])}' />
            </column>
            <column caption='Agent Partial Refund CPO' datatype='real' name='[Calculation_5449074129769394180]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND((SUM(IF [refund_compensation_source] = &apos;OneView&apos; &#10;then [refund_value_eur] END) &#10;+  [Calculation_5449074129757712386])/IFNULL(SUM([Calculation_5449074129768910851]), 1),3)' />
            </column>
            <column caption='Self Service Compensation CPO' datatype='real' name='[Calculation_5449074129769553925]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM(IF [refund_compensation_source] = &apos;Help Center&apos; &#10;then [compensation_value_eur] END)/IFNULL(SUM([Calculation_5449074129768910851]), 1),3)' />
            </column>
            <column caption='Self Service Partial Refund CPO' datatype='real' name='[Calculation_5449074129769635846]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM(IF [refund_compensation_source] = &apos;Help Center&apos; then [refund_value_eur] END)&#10;/IFNULL(SUM([Calculation_5449074129768910851]), 1),3)' />
            </column>
            <column caption='CPO' datatype='real' name='[Calculation_5449074129769705479]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//([CPO_enum (copy)]) / SUM([Total Orders])&#10;&#10;IFNULL([CPO (copy)_5449074129770082313],0) + IFNULL([CPO (copy)_5449074129769975816],0)' />
            </column>
            <column caption='Date Granularity' datatype='string' name='[Calculation_5449074130058059790]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Date&quot; THEN STR([created_date])&#10;WHEN &quot;Week&quot; THEN [created_week]&#10;WHEN &quot;Month&quot; THEN [created_month]&#10;END' />
            </column>
            <column caption='Select Metric ' datatype='real' name='[Calculation_6702130357658759187]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;CPO&apos; THEN [Calculation_5449074129769705479]&#10;WHEN &apos;Agent CPO&apos; THEN [CPO (copy)_5449074129770082313]&#10;WHEN &apos;Agent Refund CPO&apos; THEN [Calculation_5449074129769394180]&#10;WHEN &apos;Agent Compensation CPO&apos; THEN [Calculation_5449074129757630465]&#10;WHEN &apos;Self Service CPO&apos; THEN [CPO (copy)_5449074129769975816]&#10;WHEN &apos;Self Service Refund CPO&apos; THEN [Calculation_5449074129769635846]&#10;WHEN &apos;Self Service Compensation CPO&apos; THEN [Calculation_5449074129769553925]&#10;WHEN &apos;Refund CPO&apos; THEN [CPO (copy)_5449074129770975244]&#10;WHEN &apos;Compensation CPO&apos; THEN [CPO (copy) (copy)_5449074129771008013]&#10;END' />
            </column>
            <column caption='Select Dimension' datatype='string' name='[Calculation_6702130357670830100]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Management Entity Group&apos; THEN [management_entity_group]&#10;    ELSEIF [Parameters].[Parameter 4] = &apos;Contact Reason L3&apos; THEN [contact_reason_l3]&#10;    ELSEIF [Parameters].[Parameter 4] = &apos;Global Entity Id&apos; THEN [global_entity_id]&#10;    ELSEIF [Parameters].[Parameter 4] = &apos;Country&apos; THEN [country]&#10;    ELSEIF [Parameters].[Parameter 4] = &apos;Brabd&apos; THEN [brand]&#10;    ELSEIF [Parameters].[Parameter 4] = &apos;Customer Maturity&apos; THEN [customer_maturity]&#10;    ELSEIF [Parameters].[Parameter 4] = &apos;Customer Loyalty Status&apos; THEN [customer_loyalty_status]&#10;    ELSEIF [Parameters].[Parameter 4] = &apos;Request Refund Method&apos; THEN [request_refund_method]&#10;    ELSEIF [Parameters].[Parameter 4] = &apos;Delivery Type&apos; THEN [delivery_type]&#10;    ELSEIF [Parameters].[Parameter 4] = &apos;Vertical&apos; THEN [vertical]&#10;ELSE &quot;Total&quot;&#10;END' />
            </column>
            <column caption='Top Segments' datatype='string' name='[Calculation_6702130357676744725]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Select Dimension Set] THEN [Calculation_6702130357670830100]ELSE &quot;Others&quot; END' />
            </column>
            <column caption='Relative Date' datatype='date' name='[Created Date (copy)_6702130357651972113]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[created_date]' />
            </column>
            <column caption='Date Range' datatype='date' name='[Created Date (copy)_6702130357652553746]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[created_date]' />
            </column>
            <column caption='Select Self Service Metric' datatype='real' name='[Select Metric  (copy)_1321736178206486541]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Select Metric (copy)_1321736178205773835]&#10;WHEN &apos;Overall CPO&apos; THEN [Calculation_5449074129769705479]&#10;WHEN &apos;Self Service CPO&apos; THEN [CPO (copy)_5449074129769975816]&#10;WHEN &apos;Self Service Refund CPO&apos; THEN [Calculation_5449074129769635846]&#10;WHEN &apos;Self Service Compensation CPO&apos; THEN [Calculation_5449074129769553925]&#10;WHEN &apos;Refund CPO&apos; THEN [CPO (copy)_5449074129770975244]&#10;WHEN &apos;Compensation CPO&apos; THEN [CPO (copy) (copy)_5449074129771008013]&#10;END' />
            </column>
