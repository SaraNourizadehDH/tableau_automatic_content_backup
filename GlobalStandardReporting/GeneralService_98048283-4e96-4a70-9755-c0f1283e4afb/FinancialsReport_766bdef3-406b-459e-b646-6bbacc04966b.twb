        <calculation class='tableau' formula='{ &#10;(SUM(IF [refund_compensation_source] = &apos;OneView&apos; &#10;AND [Calculation_1529957237031669760]&#10;then [refund_value_eur] END)&#10;+ [Calculation_1529957237032173571])&#10;/ &#10;IFNULL(SUM(&#10;    IF [Calculation_1529957237031669760] &#10;    THEN ([order_count]) &#10;END&#10;),1)&#10;}' />
      </column>
      <column caption='Agent Partial Refund CPO_enum_total' datatype='real' name='[Calculation_1529957237032665095]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF [refund_compensation_source] = &apos;OneView&apos; &#10;then [refund_value_eur] END) &#10;+  [Calculation_5449074129757712386])' />
