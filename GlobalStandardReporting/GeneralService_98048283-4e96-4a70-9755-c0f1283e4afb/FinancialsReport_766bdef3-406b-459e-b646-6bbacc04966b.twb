    <worksheet name='playground'>
      <table>
        <view>
          <datasources>
            <datasource caption='cpo_contribution_report (rl)' name='federated.1hcs3yh06ekl371cd9nc21w00ff1' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Week' caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
              <aliases>
                <alias key='&quot;Date&quot;' value='Date' />
                <alias key='&quot;Month&quot;' value='Month' />
                <alias key='&quot;Week&quot;' value='Week' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1hcs3yh06ekl371cd9nc21w00ff1'>
            <column caption='Agent CPO_enum' datatype='real' name='[Agent CPO (copy)_6702130357758013467]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Agent Partial Refund CPO (copy)_6702130357757403162] &#10;+ [Agent Compensation CPO (copy)_6702130357758218268]' />
            </column>
            <column caption='Agent Compensation CPO_enum' datatype='real' name='[Agent Compensation CPO (copy)_6702130357758218268]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IF [refund_compensation_source] = &apos;OneView&apos; &#10;then [compensation_value_eur] END)' />
            </column>
            <column caption='Agent Partial Refund CPO_enum' datatype='real' name='[Agent Partial Refund CPO (copy)_6702130357757403162]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IF [refund_compensation_source] = &apos;OneView&apos; &#10;then [refund_value_eur] END)' />
            </column>
            <column caption='Agent Comp CPO % Chng' datatype='real' name='[Agent Refund CPO % Chng (copy)_1321736178189766661]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ROUND(SUM([Agent Refund Current CPO (copy)_1321736178189795336]),3)- ROUND(SUM([Agent Refund Prev CPO (copy)_1321736178189807625]),3))&#10;/&#10;//ROUND(SUM([Agent Comp Prev CPO]),2)&#10;&#10;ROUND(IFNULL(SUM([Agent Refund Prev CPO (copy)_1321736178189807625]), 1), 3)' />
            </column>
            <column caption='Agent Compensation Current CPO' datatype='real' name='[Agent Refund Current CPO (copy)_1321736178189795336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Date&apos;&#10;then &#10;{ EXCLUDE [Calculation_5449074130058059790]:&#10;    SUM(&#10;    IF [Calculation_332492372333899804]&#10;    THEN [Agent Compensation CPO (copy)_6702130357758218268]&#10;    END&#10;    )&#10;/ &#10;    SUM(&#10;    {FIXED &#10;    (IF [Calculation_332492372333899804] THEN  [Calculation_5449074129768910851] END) &#10;    : MIN&#10;    (IF [Calculation_332492372333899804] THEN [Calculation_5449074129768910851]END)&#10;    }&#10;    )&#10;}&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Week&apos;&#10;THEN &#10;{ EXCLUDE [Calculation_5449074130058059790]:&#10;    SUM(&#10;    IF [Calculation_332492372334174238]&#10;    THEN [Agent Compensation CPO (copy)_6702130357758218268]&#10;    END&#10;    )&#10;/ &#10; SUM(&#10;    IF [Calculation_332492372334174238] &#10;    THEN [Calculation_5449074129768910851]&#10;    END&#10;    )&#10;}&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month&apos;&#10;THEN &#10;{ EXCLUDE [Calculation_5449074130058059790]:&#10;    SUM(&#10;    IF [Calculation_332492372334067741]&#10;    THEN [Agent Compensation CPO (copy)_6702130357758218268]&#10;    END&#10;    )&#10;/ &#10; SUM(&#10;    IF [Calculation_332492372334067741]&#10;    THEN [Calculation_5449074129768910851]&#10;    END&#10;    )&#10;}&#10;END' />
            </column>
            <column caption='Agent Comp Prev CPO' datatype='real' name='[Agent Refund Prev CPO (copy)_1321736178189807625]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Date&apos;&#10;then &#10;{ EXCLUDE [Calculation_5449074130058059790]:&#10;    SUM(&#10;    IF [Calculation_332492372334260255]&#10;    THEN [Agent Compensation CPO (copy)_6702130357758218268]&#10;    END&#10;    )&#10;/ &#10;&#10; SUM(&#10;{FIXED &#10;    (IF [Calculation_332492372334260255] THEN  [Calculation_5449074129768910851] END) &#10;: MIN&#10;    (IF [Calculation_332492372334260255] THEN [Calculation_5449074129768910851]END)&#10;}&#10;    )&#10;&#10;}&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Week&apos;&#10;THEN &#10;{ EXCLUDE [Calculation_5449074130058059790]:&#10;    SUM(&#10;    IF [Calculation_332492372334448673]&#10;    THEN [Agent Compensation CPO (copy)_6702130357758218268]&#10;    END&#10;    )&#10;/ &#10; SUM(&#10;    IF [Calculation_332492372334448673]&#10;    THEN [Calculation_5449074129768910851]&#10;    END&#10;    )&#10;}&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month&apos;&#10;THEN &#10;{ EXCLUDE [Calculation_5449074130058059790]:&#10;    SUM(&#10;    IF [Calculation_332492372334350368]&#10;    THEN [Agent Compensation CPO (copy)_6702130357758218268]&#10;    END&#10;    )&#10;/ &#10; SUM(&#10;    IF [Calculation_332492372334350368]&#10;    THEN [Calculation_5449074129768910851]&#10;    END&#10;    )&#10;}&#10;END' />
            </column>
            <column caption='Self Service CPO' datatype='real' name='[CPO (copy)_5449074129769975816]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//SUM([Self Service CPO_enum]) / IFNULL(SUM([Total Orders]), 1)&#10;IFNULL([Calculation_5449074129769635846],0) + IFNULL([Calculation_5449074129769553925],0)' />
            </column>
            <column caption='Agent CPO' datatype='real' name='[CPO (copy)_5449074129770082313]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//([Agent CPO_enum_with_agent_cost]) / IFNULL(SUM([Total Orders]), 1)&#10;IFNULL([Calculation_5449074129769394180],0) + IFNULL([Calculation_5449074129757630465],0)' />
            </column>
            <column caption='CPO_enum' datatype='real' name='[CPO (copy)_6702130357760253987]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Self Service CPO (copy)_6702130357758717983]) + ZN([Agent CPO (copy)_6702130357758013467])' />
            </column>
            <column caption='current date orders' datatype='integer' name='[Calculation_2607232400752189443]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED &#10;    (IF [Calculation_332492372333899804] THEN  [Calculation_5449074129768910851] END) &#10;: MIN&#10;    (IF [Calculation_332492372333899804] THEN [Calculation_5449074129768910851]END)&#10;}' />
            </column>
            <column caption='is_current_date' datatype='boolean' name='[Calculation_332492372333899804]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;day&apos;,[created_date]) = &#10;&#10;{MAX(DATETRUNC(&apos;day&apos;,[created_date]))}' />
            </column>
            <column caption='is_current_month' datatype='boolean' name='[Calculation_332492372334067741]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{FIXED [created_month]: MAX([created_date])} = {FIXED: MAX([created_date])}' />
            </column>
            <column caption='is_current_week' datatype='boolean' name='[Calculation_332492372334174238]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{FIXED [created_week]: MAX([created_date])} = {FIXED: MAX([created_date])}' />
            </column>
            <column caption='is_prev_date' datatype='boolean' name='[Calculation_332492372334260255]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;day&apos;,[created_date]) = &#10;&#10;{MAX(DATETRUNC(&apos;day&apos;,[created_date]))} - 1' />
            </column>
            <column caption='is_prev_month' datatype='boolean' name='[Calculation_332492372334350368]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT [Calculation_332492372334067741]&#10;AND&#10;{FIXED [created_month]: MAX([created_date])} = &#10;{FIXED [Calculation_332492372334067741]: MAX([created_date])}' />
            </column>
            <column caption='is_prev_week' datatype='boolean' name='[Calculation_332492372334448673]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT [Calculation_332492372334174238]&#10;AND&#10;{FIXED [created_week]: MAX([created_date])} = {FIXED [Calculation_332492372334174238]: MAX([created_date])}' />
            </column>
            <column caption='CPO Current ' datatype='real' name='[Calculation_332492372334604322]' role='measure' type='quantitative'>
