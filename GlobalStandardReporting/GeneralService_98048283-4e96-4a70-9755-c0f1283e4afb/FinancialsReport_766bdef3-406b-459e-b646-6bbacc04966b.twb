      <column caption='Self Service Partial Refund CPO 30D' datatype='real' name='[Calculation_1529957237033394185]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ &#10;ROUND(SUM(IF [refund_compensation_source] = &apos;Help Center&apos; &#10;AND [Calculation_1529957237031669760]&#10;then [refund_value_eur] END)&#10;/ &#10;IFNULL(SUM(&#10;    IF [Calculation_1529957237031669760] &#10;    THEN ([order_count]) &#10;END&#10;),1)&#10;,3)&#10;}' />
