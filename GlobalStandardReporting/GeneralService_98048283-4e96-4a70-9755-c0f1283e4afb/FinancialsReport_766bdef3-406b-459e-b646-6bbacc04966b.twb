      <column caption='CPC' datatype='real' name='[Calculation_836262206640726032]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  [Parameters].[Parameter 1 2]=&apos;Personnel&apos; then [CPO personnel  (copy)_836262206632566789]&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;Non Personnel&apos; then [Calculation_836262206637330441]&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;Overhead&apos; then [% Overhead (copy)_836262206647697434]&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;Total&apos; then [% Total Costs (copy) (copy)_836262206742360098]&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;CC - Total&apos; then [CPC All (copy)_1369938767416520708]&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='KPIs' datatype='real' default-format='N' name='[Calculation_836262206642098196]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 2 1]=&apos;CPO&apos; THEN round([CPC (copy)_836262206641778705],3)&#13;&#10;ELSEIF  [Parameters].[Parameter 2 1]=&apos;CPC&apos; THEN ROUND([Calculation_836262206640726032],3)&#13;&#10;ELSEIF  [Parameters].[Parameter 2 1]=&apos;Absolute&apos; THEN ROUND([CPC (copy)_836262206643036182],0)&#13;&#10;ELSEIF  [Parameters].[Parameter 2 1]=&apos;Relative&apos; THEN ROUND([Absolute (copy)_836262206645108759],2)*100&#10;//ELSEIF [Parameters].[KPIs]=&apos;CS Contacts&apos; THEN SUM([CS Contacts])&#13;&#10;END'>
