      <column caption='is_current_full_period_minus_1' datatype='boolean' name='[is_current_week_minus_2 (copy)_5238108607357255689]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Daily&apos; THEN &#10;STR([created_date]) = STR(TODAY()-2)&#10;&#10;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Weekly&apos; THEN &#10;[week] = STR(YEAR(TODAY()-21)) + &apos;-&apos; + STR(WEEK(TODAY()-21)) &#10;// subtracting 21 as &quot;week&quot; function in Tableau uses US format,&#10;// while in the script we use iso format, and the goal is to have a week before last week that has finished&#10;&#10;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Monthly&apos; THEN &#10;IF MONTH(DATEADD(&apos;month&apos;, -2, TODAY())) &lt; 10&#10;THEN&#10;[month] = STR(YEAR(DATEADD(&apos;month&apos;, -2, TODAY()))) + &apos;-&apos; +  &apos;0&apos; + STR(MONTH(DATEADD(&apos;month&apos;, -2, TODAY())))&#10;ELSE [month] = STR(YEAR(DATEADD(&apos;month&apos;, -2, TODAY()))) + &apos;-&apos; + STR(MONTH(DATEADD(&apos;month&apos;, -2, TODAY())))&#10;END&#10;// we want the last month that is finished&#10;END' />
      </column>
