      <column caption='CPC Order Damaged' datatype='real' name='[CPC Refund (copy)_1020628317627645953]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Refund (copy)_1020628317627645954])/sum([All contacts  (copy)_1020628317643350020])' />
