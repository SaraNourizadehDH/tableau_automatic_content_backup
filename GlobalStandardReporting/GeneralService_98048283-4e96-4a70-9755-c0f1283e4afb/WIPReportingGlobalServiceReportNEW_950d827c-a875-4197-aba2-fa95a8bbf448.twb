            <column caption='Shrinkage ' datatype='real' default-format='p0.0%' name='[Productivity  (copy)_1590615107444408324]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if &#10; ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;DH Regions&apos; )&#10;or  ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;GST Regions&apos; )&#10;or ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;Global&apos; )&#10;or ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;Management Entity&apos; )&#10;or ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;Contact Center&apos; )&#10;or ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;Country&apos; and attr(left([Calculation_222857857467572224],3)) != &apos;SSC&apos; )&#10;or ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;Display Name&apos; and attr(left([Calculation_222857857467572224],3)) != &apos;SSC&apos; )&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249] = &apos;Daily&apos; )&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249] = &apos;Weekly&apos; )&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249] = &apos;Monthly&apos; )&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249] = &apos;Quarterly&apos; )&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249] = &apos;Global Entity Id&apos; )&#10;&#10;then [2nd Level Request Answer Rate (copy 5)]&#10;&#10;else null&#10;end' />
            </column>
            <column caption='Productivity CS/PS' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Productivity (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [Team (group)] = &apos;Customer Service&apos; or [Team (group)] = &apos;Partner Service&apos; then [Calculation_530791456113037313] end) &#10;/ &#10;SUM(if [Team (group)] = &apos;Customer Service&apos; or [Team (group)] = &apos;Partner Service&apos; then [hours_clocked] end)' />
            </column>
            <column caption='Productivity DP' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Productivity CS/PS (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [Team (group)] = &apos;Dispatching&apos; then [Calculation_530791456113037313] end)&#10;/ &#10;SUM(if [Team (group)] = &apos;Dispatching&apos; then [hours_clocked] end)' />
            </column>
            <column caption='Audits / Contacts ' datatype='real' name='[QA Score  (copy)_1590615107448864775]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if &#10; ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;DH Regions&apos; )&#10;or ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;Global&apos; )&#10;or  ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;GST Regions&apos; )&#10;or ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;Management Entity&apos; )&#10;or ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;Contact Center&apos; )&#10;or ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;Country&apos; and attr(left([Calculation_222857857467572224],3)) != &apos;SSC&apos; )&#10;or ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;Display Name&apos; and attr(left([Calculation_222857857467572224],3)) != &apos;SSC&apos; )&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249] = &apos;Daily&apos; )&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249] = &apos;Weekly&apos; )&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249] = &apos;Monthly&apos; )&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249] = &apos;Quarterly&apos; )&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249] = &apos;Global Entity Id&apos; )&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249] = &apos;Stakeholder&apos; )&#13;&#10;&#10;then [Calculation_615796940107870208]&#10;&#10;else null&#10;end' />
            </column>
            <column caption='Score inbound contact rate' datatype='integer' default-format='n#,##0.00;-#,##0.00' name='[Score Productivity (copy 2)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='If [Calculation_1499135771098468353] &gt; ([Parameters].[Shrinkage |-&gt; (copy)] - ([Parameters].[Productivity CS/PS |-| (copy 2)] * 0)) THEN 0 &#10;ELSEIF [Calculation_1499135771098468353] &lt; ([Parameters].[Shrinkage |-&gt; (copy)] - ([Parameters].[Productivity CS/PS |-| (copy 2)] * 0)) and [Calculation_1499135771098468353] &gt; ([Parameters].[Shrinkage |-&gt; (copy)] - ([Parameters].[Productivity CS/PS |-| (copy 2)] * 1)) THEN 1&#10;ELSEIF [Calculation_1499135771098468353] &lt; ([Parameters].[Shrinkage |-&gt; (copy)] - ([Parameters].[Productivity CS/PS |-| (copy 2)] * 1)) and [Calculation_1499135771098468353] &gt; ([Parameters].[Shrinkage |-&gt; (copy)] - ([Parameters].[Productivity CS/PS |-| (copy 2)] * 2)) THEN 2&#10;ELSEIF [Calculation_1499135771098468353] &lt; ([Parameters].[Shrinkage |-&gt; (copy)] - ([Parameters].[Productivity CS/PS |-| (copy 2)] * 2)) and [Calculation_1499135771098468353] &gt; ([Parameters].[Shrinkage |-&gt; (copy)] - ([Parameters].[Productivity CS/PS |-| (copy 2)] * 3)) THEN 3&#10;ELSEIF [Calculation_1499135771098468353] &lt; ([Parameters].[Shrinkage |-&gt; (copy)] - ([Parameters].[Productivity CS/PS |-| (copy 2)] * 3)) and [Calculation_1499135771098468353] &gt; ([Parameters].[Shrinkage |-&gt; (copy)] - ([Parameters].[Productivity CS/PS |-| (copy 2)] * 4)) THEN 4&#10;ELSEIF [Calculation_1499135771098468353] &lt; ([Parameters].[Shrinkage |-&gt; (copy)] - ([Parameters].[Productivity CS/PS |-| (copy 2)] * 4)) and [Calculation_1499135771098468353] &gt; ([Parameters].[Shrinkage |-&gt; (copy)] - ([Parameters].[Productivity CS/PS |-| (copy 2)] * 5)) THEN 5&#10;ELSEIF [Calculation_1499135771098468353] &lt; ([Parameters].[Shrinkage |-&gt; (copy)] - ([Parameters].[Productivity CS/PS |-| (copy 2)] * 5)) and [Calculation_1499135771098468353] &gt; ([Parameters].[Shrinkage |-&gt; (copy)] - ([Parameters].[Productivity CS/PS |-| (copy 2)] * 6)) THEN 6&#10;ELSEIF [Calculation_1499135771098468353] &lt; ([Parameters].[Shrinkage |-&gt; (copy)] - ([Parameters].[Productivity CS/PS |-| (copy 2)] * 6)) and [Calculation_1499135771098468353] &gt; ([Parameters].[Shrinkage |-&gt; (copy)] - ([Parameters].[Productivity CS/PS |-| (copy 2)] * 7)) THEN 7&#10;ELSEIF [Calculation_1499135771098468353] &lt; ([Parameters].[Shrinkage |-&gt; (copy)] - ([Parameters].[Productivity CS/PS |-| (copy 2)] * 7)) and [Calculation_1499135771098468353] &gt; ([Parameters].[Shrinkage |-&gt; (copy)] - ([Parameters].[Productivity CS/PS |-| (copy 2)] * 8)) THEN 8&#10;ELSEIF [Calculation_1499135771098468353] &lt; ([Parameters].[Shrinkage |-&gt; (copy)] - ([Parameters].[Productivity CS/PS |-| (copy 2)] * 8)) and [Calculation_1499135771098468353] &gt; ([Parameters].[Shrinkage |-&gt; (copy)] - ([Parameters].[Productivity CS/PS |-| (copy 2)] * 9)) THEN 9&#10;ELSEIF [Calculation_1499135771098468353] &lt; ([Parameters].[Shrinkage |-&gt; (copy)] - ([Parameters].[Productivity CS/PS |-| (copy 2)] * 9)) THEN 10&#10;END' />
            </column>
