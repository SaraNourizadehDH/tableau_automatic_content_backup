      <column caption='Contacts' datatype='integer' name='[Calculation_1022457871126609920]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1022457871126609920 1]' />
      </column>
      <column caption='DH Regions' datatype='string' name='[Calculation_104145778124697602]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[dh_region]' />
