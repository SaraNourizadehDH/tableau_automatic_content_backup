      <column caption='Total Costs' datatype='real' name='[Calculation_836262206633590790]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  [stakeholder]=&apos;Customer&apos; then &#13;&#10;IFNULL([sum_personnel_costs_eur],0) +IFNULL([sum_overheads_eur],0) +IFNULL([sum_non_personnel_eur],0) +IFNULL([Calculation_836262206633660423 1],0)&#13;&#10;ELSE&#13;&#10;IFNULL([sum_personnel_costs_eur],0) + IFNULL([sum_overheads_eur],0) +IFNULL([sum_non_personnel_eur],0)&#13;&#10;END' />
      </column>
      <column caption='Refund' datatype='real' name='[Calculation_836262206633660423 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([sum_costs_late_spilled_food],0) +IFNULL([sum_costs_late_spilled_food_old],0) + IFNULL([sum_costs_order_damaged],0)+ &#10;IFNULL([sum_costs_order_damaged_old],0)' />
