        <calculation class='tableau' formula='sum([signed_evaluations])/ sum([evaluations])' />
      </column>
      <column caption='AHT - parameter' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1206120335674859525]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  [Parameters].[Parameter 7]=&apos;AHT for Live&apos; then [Calculation_2355664125622820864] &#13;&#10;ELSEIF [Parameters].[Parameter 7]=&apos;AHT non Live&apos; then [AHT Chat (copy)]&#13;&#10;END' />
      </column>
      <column caption='CS  CPC' datatype='real' name='[Calculation_1228356847421263874]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1327999001393680386])/sum([Total Contact Disptching (copy)])' />
      </column>
      <column caption='KPIS 1 - parameter' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1237926992845287424]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 3]=&apos;Productivity&apos; THEN [Calculation_286893405478703106]&#13;&#10;ELSEIF  [Parameters].[Parameter 3]=&apos;Shrinkage&apos; then [2nd Level Request Answer Rate (copy 5)]*100&#13;&#10;ELSEIF  [Parameters].[Parameter 3]=&apos;% Audited Issues&apos; THEN [Calculation_615796940107870208]*100&#10;ELSEIF  [Parameters].[Parameter 3]=&apos;% No Contact CSAT&apos; THEN [Calculation_1993405800873082880]*100&#10;//ELSEIF  [KPIS 1]=&apos;AC NPS&apos; THEN [AC NPS not formatted ]&#13;&#10;END' />
      </column>
      <column caption='Gross Orders' datatype='integer' default-format='n#,##0,.0K;-#,##0,.0K' name='[Calculation_126523021110427648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL({FIXED [global_entity_id],[created_date], [vertical], [delivery_type], [is_subscription], [is_corporate], [is_preorder], [Calculation_222857857467572224],&#10;[country], [brand] : max([total_orders])}&#13;&#10;,0)&#13;&#10;//  fixes to avoid duplications' />
      </column>
      <column caption='CS Costs EUR' datatype='real' name='[Calculation_1327999001393680386]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [global_entity_id],[month]: max([sum_end_customer_service_eur])}' />
      </column>
      <column caption='PS Costs EUR' datatype='real' name='[Calculation_1327999001394638851]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [global_entity_id],[month]: max([sum_restaurant_services_eur])}' />
      </column>
      <column caption='RS Costs EUR' datatype='real' name='[Calculation_1327999001395548164]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [global_entity_id],[month]: max([sum_dispatching_costs_eur])}' />
      </column>
      <column caption='Issue Rate' datatype='real' default-format='p0.0%' name='[Calculation_1359101970151641088]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([issues Total (copy)_1139973706829881344])/ SUM([Calculation_126523021110427648])' />
      </column>
      <column caption='RS Cost per Order (CPO)' datatype='real' name='[Calculation_135952462903009281]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1327999001395548164])/SUM([Gross Orders (copy)_410249839433949184])' />
      </column>
      <column caption='# Outbound Calls (ratio)' datatype='integer' name='[Calculation_1369938767393751041]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if ISNULL([Calculation_126523021110427648]) THEN 0&#13;&#10;ELSE [outbound_calls]&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Hide LAST MONTH' datatype='boolean' name='[Calculation_1373597947888529409]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[created_date]) &lt;=  {MAX(DATETRUNC(&apos;month&apos;,[created_date])-1)}' />
      </column>
      <column caption='Issues RS/SH' datatype='integer' name='[Calculation_1442840798434844673]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [stakeholder]=&apos;Rider&apos; OR [stakeholder] = &apos;Shopper&apos; THEN [issues Total (copy)_1139973706829881344] END' />
      </column>
      <column caption='RS/SH OD Issue Rate' datatype='real' default-format='p0.0%' name='[Calculation_1442840798456725509]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1442840798434844673])/SUM([Orders (copy 2)_1442840798455828483])' />
      </column>
      <column caption='Total Contacts per Order' datatype='real' default-format='p0.0%' name='[Calculation_1499135771098468353]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IFNULL([inbound_calls],0))&#13;&#10;+SUM(IFNULL([incoming_chats],0))&#13;&#10;+sum(IFNULL([incoming_cases],0)) //includes SoME&#13;&#10;)&#13;&#10;/SUM([Calculation_126523021110427648])' />
      </column>
      <column caption='Service Index' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1554867821100556288]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF IFNULL([Calculation_610026677072920578],0)=0 THEN FLOAT(NULL)&#10;ELSE [Calculation_1590615107356774403] * [Calculation_610026677072920578]&#10;END' />
      </column>
      <column caption='Productivity ' datatype='real' name='[Calculation_1590615107356774403]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if (&#10; ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;DH Regions&apos; )&#10;or ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;Global&apos; )&#10;or  ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;GST Regions&apos; )&#10;or ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;Management Entity&apos; )&#10;or ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;Contact Center&apos; )&#10;or ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;Country&apos; and attr(left([Calculation_222857857467572224],3)) != &apos;SSC&apos; )&#10;or ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;Display Name&apos; and attr(left([Calculation_222857857467572224],3)) != &apos;SSC&apos;)&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249] = &apos;Daily&apos; )&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249] = &apos;Weekly&apos; )&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249] = &apos;Monthly&apos; )&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249] = &apos;Quarterly&apos; )&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249] = &apos;Global Entity Id&apos; )&#10;&#10;)&#10; &#10;then [Calculation_286893405478703106]&#10;&#10;else null&#10;end' />
      </column>
      <column caption='% Missed Chats' datatype='real' default-format='p0.0%' name='[Calculation_1615384907849322497]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([missed_chat_ind])/sum([incoming_chats])' />
      </column>
      <column caption='Score financial' datatype='real' name='[Calculation_171629421912485891]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;IFNULL([Score cost/revenue (copy)],0) +&#10;IFNULL([Calculation_366128629720432642],0)&#10;)/ &#10;(&#10;IF ISNULL([Score cost/revenue (copy)]) THEN 0 ELSE 1 END +&#10;IF ISNULL([Calculation_366128629720432642]) THEN 0 ELSE 1 END &#10;)' />
      </column>
      <column caption='Rank' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1728256411808526336]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Total  CPC' datatype='real' name='[Calculation_1728256412141338628]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum(ifnull([Calculation_1327999001393680386],0)) +sum(ifnull([Calculation_1327999001394638851],0)) +sum(ifnull([Calculation_1327999001395548164],0)) +sum(ifnull([RS Costs EUR (copy)],0)))&#13;&#10;/sum(IFNULL([inbound_calls],0)+IFNULL([incoming_chats],0)+IFNULL([inbound_emails],0)+IFNULL([inbound_socialmedia_posts],0))' />
      </column>
      <column caption='date - d' datatype='string' name='[Calculation_184155067128008704]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF len(STR(DATEPART(&apos;day&apos;,[created_date]))) == 1 THEN &apos;0&apos; + str(DATEPART(&apos;day&apos;,[created_date]))&#10;ELSE str(DATEPART(&apos;day&apos;,[created_date]))&#10;END' />
      </column>
      <column caption='% Punched + Evaluated Shifts' datatype='real' default-format='p0.0%' name='[Calculation_1858297811711619072]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if &#10; ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;DH Regions&apos; )&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;GCC Regions&apos; )&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;Global&apos; )&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;Management Entity&apos; )&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;Contact Center&apos; )&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;Country&apos; and attr(left([Calculation_222857857467572224],3)) != &apos;SSC&apos; )&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;Display Name&apos; and attr(left([Calculation_222857857467572224],3)) != &apos;SSC&apos; )&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249] = &apos;Daily&apos; )&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249] = &apos;Weekly&apos; )&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249] = &apos;Monthly&apos; )&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249] = &apos;Quarterly&apos; )&#10;&#10;then [% Punched + Evaluated Shifts (copy)_4725401937840865280]&#10;&#10;else null&#10;end' />
      </column>
      <column caption='RS Outbound Calls' datatype='integer' name='[Calculation_1858297811721146373]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [stakeholder]=&apos;Rider&apos; THEN [outbound_calls] END' />
      </column>
      <column caption='all shifts' datatype='integer' name='[Calculation_1936125657671262210]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(SUM([evaluated]),0)+IFNULL(sum(punched),0)+IFNULL(sum([no_evaluation]),0)' />
      </column>
      <column caption='HC - No Contact CSAT' datatype='real' default-format='p0%' name='[Calculation_1993405800873082880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([count_csat_4_5])/sum([count_responses])' />
      </column>
      <column caption='% 1-time contacts' datatype='real' default-format='p0.0%' name='[Calculation_1993405800907108353]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([count_first_contact_resolution])/sum([count_contacts_related_to_order])' />
      </column>
      <column caption='Total Cost per order (CPO)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2113314170671042562]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum(ifnull([Calculation_1327999001393680386],0)) +sum(ifnull([Calculation_1327999001394638851],0)) +sum(ifnull([Calculation_1327999001395548164],0)) +sum(ifnull([RS Costs EUR (copy)],0)))&#13;&#10;/SUM([Gross Orders (copy)_410249839433949184])' />
      </column>
      <column caption='PS  Cost per order (CPO)' datatype='real' name='[Calculation_2113314170681819144]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_1327999001394638851])/sum([Gross Orders (copy)_410249839433949184])' />
      </column>
      <column caption='SF  Cost per order (CPO)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2113314170687021073]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([RS Costs EUR (copy)])/SUM({FIXED [global_entity_id],[created_date], [vertical], [delivery_type]: max([successful_orders])})' />
      </column>
      <column caption='Total Costs' datatype='real' name='[Calculation_2113314170689699864]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Calculation_1327999001393680386],0)+IFNULL([Calculation_1327999001395548164],0)+IFNULL([Calculation_1327999001394638851],0)+IFNULL([RS Costs EUR (copy)],0)' />
      </column>
      <column caption='% CS cost' datatype='real' default-format='p0.0%' name='[Calculation_2113314170689908761]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_1327999001393680386])/sum([Calculation_2113314170689699864])' />
      </column>
      <column caption='Contact Center' datatype='string' name='[Calculation_222857857467572224]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF 1 = 1 then [contact_center] END&#10;&#10;// IF [Management Entity] = &apos;Carriage&apos; THEN &apos;SSC Carriage&apos;&#10;// ELSEIF [Management Entity] = &apos;Talabat&apos; THEN &apos;SSC TalabatOtlob&apos;&#10;// ELSEIF [Display Name] = &apos;FP - Pakistan&apos; THEN &apos;Pakistan&apos;&#10;// ELSEIF [Management Entity] = &apos;Pedidosya&apos; THEN &apos;SSC PedidosYa&apos;&#10;// ELSEIF [Management Entity] = &apos;Yemeksepeti&apos; THEN &apos;Turkey&apos;&#10;// ELSEIF [Management Entity] = &apos;Donesi&apos; THEN &apos;Balkans&apos;&#10;// ELSEIF [Display Name] = &apos;FP - Bangladesh&apos; THEN &apos;Bangladesh&apos;&#10;// ELSEIF [Management Entity] = &apos;HungerStation&apos; THEN &apos;Saudi Arabia&apos;&#10;// ELSEIF [Management Entity] = &apos;Foodora&apos; THEN &apos;Canada&apos; &#10;// ELSEIF [Management Entity] = &apos;ClickDelivery&apos; THEN &apos;SSC Domicilios&apos;&#10;// ELSEIF [Management Entity] = &apos;DH Greece&apos; THEN &apos;Greece&apos;&#10;// ELSEIF [Management Entity] = &apos;Foodpanda APAC&apos; THEN &apos;SSC APAC&apos;&#10;// ELSEIF [Management Entity] = &apos;Pauza&apos; THEN &apos;Croatia&apos;&#10;// ELSEIF [Management Entity] = &apos;DH Korea&apos; THEN &apos;South Korea&apos;&#10;// ELSEIF [Management Entity] = &apos;DH Austria&apos; THEN &apos;Austria&apos;&#10;// ELSEIF  [Display Name] = &apos;FD - Finland&apos; THEN &apos;Finland&apos;&#10;// ELSEIF  [Display Name] = &apos;Pizza-Online Finland&apos; THEN &apos;Finland&apos;&#10;// ELSEIF  [Display Name] = &apos;Onlinepizza Sweden&apos; THEN &apos;Sweden&apos;&#10;// ELSEIF  [Display Name] = &apos;FD - Sweden&apos; THEN &apos;Sweden&apos;&#10;// ELSEIF  [Display Name] = &apos;FD - Norway&apos; THEN &apos;Norway&apos;&#10;&#10;&#10;// ELSEIF  [Display Name] = &apos;FP - Romania&apos; THEN &apos;Romania&apos;&#10;// ELSEIF  [Display Name] = &apos;HipMenu - RO&apos; THEN &apos;Romania&apos;&#10;&#10;&#10;// ELSEIF  [Display Name] = &apos;Damejidlo&apos; THEN &apos;Czech Republic&apos;&#10;&#10;// ELSEIF  [Display Name] = &apos;Hungary&apos; THEN &apos;Hungary&apos;&#10;// ELSEIF  [Display Name] = &apos;FP - Bulgaria&apos; THEN &apos;Bulgaria&apos;&#10;// END' />
      </column>
      <column caption='Eligibility' datatype='string' hidden='true' name='[Calculation_235313134952333312]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if &#10;    (&#10;    if ISNULL([AC NPS (copy)]) then 0 else 1 end&#10;    +&#10;    if ISNULL([Score financial (copy 2)]) then 0 else 1 end&#10;    +&#10;    if ISNULL([Overall Service Level Agreement (copy)]) then 0 else 1 end&#10;    +&#10;    if ISNULL([Score Productivity (copy 3)]) then 0 else 1 end&#10;    +&#10;    if ISNULL([Score Productivity (copy 4)]) then 0 else 1 end&#10;    +&#10;    if ISNULL([Score Productivity (copy)]) then 0 else 1 end&#10;    ) &gt; 1&#10;THEN &apos;Yes&apos; ELSE &apos;No&apos; END' />
      </column>
      <column caption='AHT for Live' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_2355664125622820864]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;&#13;&#10;(&#13;&#10;SUM(IFNULL([handling_time_chat],0))+&#13;&#10;SUM(IFNULL([inbund_ht_call],0))&#13;&#10;)&#13;&#10;/&#13;&#10;(&#13;&#10;SUM(IFNULL([served_chats],0))+&#13;&#10;SUM(IFNULL([inbound_calls],0))&#13;&#10;)&#13;&#10;&#13;&#10;)&#13;&#10;/60' />
      </column>
      <column caption='Score quality' datatype='real' hidden='true' name='[Calculation_246431395838017536]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;IFNULL([AC NPS (copy)],0) +&#10;IFNULL([Score financial (copy 2)],0) + &#10;IFNULL([Overall Service Level Agreement (copy)],0)&#10;)/ &#10;(&#10;IF ISNULL([AC NPS (copy)]) THEN 0 ELSE 1 END +&#10;IF ISNULL([Score financial (copy 2)]) THEN 0 ELSE 1 END + &#10;IF ISNULL([Overall Service Level Agreement (copy)]) THEN 0 ELSE 1 END&#10;)' />
      </column>
      <column caption='issue total mom %' datatype='real' hidden='true' name='[Calculation_285415687538565120]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;SUM([Calculation_530791456112443392]) - SUM([issues_total_mom])&#10;)&#10;/ &#10;SUm([issues_total_mom])' />
      </column>
      <column caption='Productivity - Not formatted' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_286893405478703106]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(  [Calculation_530791456113037313])&#13;&#10;/ &#13;&#10;(&#13;&#10;&#13;&#10; SUM([hours_clocked_net])&#13;&#10;)' />
      </column>
      <column caption='KPI' datatype='string' name='[Calculation_293578448056033281]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
      </column>
      <column caption='Non Live SLA 48h' datatype='real' name='[Calculation_333477514140073984]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_222857857467572224] = &apos;HungerStation&apos; THEN 0 ELSE [case_within_sla_48h] END)/sum([incoming_cases])&#10;&#10;//we remove HungerStation as zendesk is not giving the SLA 48hrs so the KPI would not be relevant' />
      </column>
      <column caption='Score quality weight' datatype='real' default-format='n#,##0;-#,##0' hidden='true' name='[Calculation_366128629716828161]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([Calculation_246431395838017536]) THEN 0 &#10;ELSE [Parameters].[Parameter 2] END' />
      </column>
      <column caption='Score cost/revenue' datatype='integer' datatype-customized='true' name='[Calculation_366128629720432642]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(NULL)' />
      </column>
      <column caption='Score volume' datatype='real' hidden='true' name='[Calculation_366128629723848708]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;IFNULL([Score Productivity (copy 2)],0) + &#10;IFNULL([Score inbound contact rate (copy)],0) +&#10;IFNULL([Score inbound contact rate (copy 2)],0)&#10;) &#10;/&#10;(&#10;IF ISNULL([Score Productivity (copy 2)]) THEN 0 ELSE 1 END +&#10;IF ISNULL([Score inbound contact rate (copy)]) THEN 0 ELSE 1 END +&#10;IF ISNULL([Score inbound contact rate (copy 2)]) THEN 0 ELSE 1 END&#10;)' />
      </column>
      <column caption='total score' datatype='real' hidden='true' name='[Calculation_366128629724884997]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_366128629716828161] + [Score quality weight (copy)] + [Score financial (copy)]' />
      </column>
      <column caption='Score quality weight %' datatype='real' default-format='p0.0%' hidden='true' name='[Calculation_366128629727199238]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_366128629716828161]/ [Calculation_366128629724884997]' />
      </column>
      <column caption='final score' datatype='real' hidden='true' name='[Calculation_366128629744963592]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_235313134952333312]=&apos;Yes&apos; THEN&#10;(IFNULL(([Calculation_246431395838017536] * [Calculation_366128629727199238]),0) +&#10;IFNULL(([Score quality (copy)] * [Score quality weight % (copy)]),0) +&#10;IFNULL(([Calculation_171629421912485891] * [Score WFM weight % (copy)]),0)&#10;) END' />
      </column>
      <column caption='Incoming contacts' datatype='integer' name='[Calculation_39687987645595648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL([inbound_calls],0))&#10;+SUM(IFNULL([incoming_chats],0))&#10;+sum(IFNULL([incoming_cases],0))' />
      </column>
      <column caption='KPI Dimension' datatype='string' name='[Calculation_39687987674001409]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 9] = &apos;Stakeholder&apos; THEN [stakeholder]&#10;ELSEIF  [Parameters].[Parameter 9] = &apos;Delivery Type&apos; THEN [delivery_type]&#10;ELSEIF [Parameters].[Parameter 9] = &apos;Vertical&apos; THEN [vertical]&#10;ELSEIF [Parameters].[Parameter 9] = &apos;Country&apos; THEN [country]&#10;END' />
      </column>
      <column caption='CSAT/No Contact CSAT - parameter-based' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_457396860660420613]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 8] = &apos;CSAT&apos; THEN ([Calculation_610026677072920578] * 100)&#10;ELSEIF [Parameters].[Parameter 8] = &apos;No Contact CSAT&apos; THEN ([Calculation_1993405800873082880] * 100)&#10;//ELSEIF [CSAT/No Contact CSAT selector] = &apos;AC NPS&apos; THEN [AC NPS not formatted ]&#13;&#10;END' />
      </column>
      <column caption='AC NPS not formatted ' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_502995822125400064]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL([nps_ac_promoters],0)-IFNULL([nps_ac_detractors],0))&#10;/&#13;&#10;SUM(IFNULL([nps_ac_responses],0))*100' />
      </column>
      <column caption='is_escalated?' datatype='integer' name='[Calculation_5040935405400313856]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([is_escalated], 0)' />
      </column>
      <column caption='is_current_full_period' datatype='boolean' name='[Calculation_5238108607331725312]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Daily&apos; THEN &#10;STR([created_date]) = STR(TODAY()-1)&#10;&#10;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Weekly&apos; THEN &#10;[week] = STR(YEAR(TODAY()-14)) + &apos;-&apos; + STR(WEEK(TODAY()-14)) &#10;// subtracting 14 as &quot;week&quot; function in Tableau uses US format,&#10;// while in the script we use iso format, and the goal is to have last week that has finished&#10;&#10;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Monthly&apos; THEN &#10;[month] = STR(YEAR(DATEADD(&apos;month&apos;, -1, TODAY()))) + &apos;-&apos; + STR(MONTH(DATEADD(&apos;month&apos;, -1, TODAY())))&#10;// we want the last month that is finished&#10;END' />
      </column>
      <column caption='Left alignment' datatype='real' name='[Calculation_5238108607359541260]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0.08&#10;// from https://technowhisp.com/tableau-tip-aligning-text-and-shape-inside-a-single-cell-kpi-indicators/' />
      </column>
      <column caption='Right alignment' datatype='real' name='[Calculation_5238108607359627277]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0.12' />
      </column>
      <column caption='AHT Chat (m)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_5239727116595236865]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//(IFNULL([Inbound AVG After Chat Handling Time Sec],0)+&#13;&#10;//IFNULL([Inbound AVG Chat Waiting Time Sec],0) +&#10;IFNULL([Outbound AVG Call Time Sec (copy 2)],0)&#10;&#10; / 60' />
      </column>
      <column caption='Own Delivery Rate' datatype='real' default-format='p0.0%' name='[Calculation_530158182333104128]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([od_orders])&#10;/&#10;SUM([total_orders])' />
      </column>
      <column caption='issues Total' datatype='integer' default-format='n#,##0,.00K;-#,##0,.00K' name='[Calculation_530791456112443392]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL ([incoming_cases] ,0) + //includes S0Me&#13;&#10;IFNULL ([incoming_chats] ,0) +&#13;&#10;IFNULL ([inbound_calls] ,0) +&#13;&#10;IFNULL([outbound_calls], 0)' />
      </column>
      <column caption='Completed Contacts' datatype='real' name='[Calculation_530791456113037313]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([served_calls] ,0) +&#13;&#10;IFNULL([served_chats],0)  +&#13;&#10;IFNULL([working_items_l1] ,0)' />
      </column>
      <column caption='CPO Contacts' datatype='integer' name='[Calculation_5473773571003998208]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ifnull([served_calls],0) + ifnull([served_chats],0) + IFNULL([resolved_cases],0)' />
      </column>
      <column caption='HC Contact Rate current week' datatype='real' name='[Calculation_5644769579990196228]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;IF [Calculation_5238108607331725312]&#10;THEN&#10;[sum_chats_created] + [tickets_created]&#10;ELSE 0&#10;END)&#10;&#10;/&#10;&#10;SUM(IF [Calculation_5238108607331725312]&#10;THEN [successful_sessions]&#10;ELSE 0&#10;END)' />
      </column>
      <column caption='Index' datatype='integer' name='[Calculation_5644769586412036131]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Last' datatype='integer' name='[Calculation_5644769586413047845]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LAST()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Data up to today' datatype='boolean' name='[Calculation_5644769586430570541]' role='measure' type='nominal'>
        <calculation class='tableau' formula='MAX([created_date]) &lt;= TODAY()' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_608900805311193088]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Global' datatype='string' name='[Calculation_610026676822482944]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Global&apos;' />
      </column>
      <column caption='Avg. CSAT' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_610026676837158913]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sum_csat]) /SUM([csat_responses])' />
      </column>
      <column caption='QTK - CSAT' datatype='real' default-format='p0%' name='[Calculation_610026677072920578]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL([count_csat_4], 0) +IFNULL([count_csat_5], 0) )&#10;/&#10;SUM([csat_responses])' />
      </column>
      <column caption='Audits / Contacts - not formatted' datatype='real' default-format='p0.00%' name='[Calculation_615796940107870208]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([evaluations])&#10;/ &#10;(&#10;SUM(IFNULL([served_calls],0))&#10;+SUM(IFNULL([served_chats],0))&#10;+SUM(IFNULL([resolved_cases],0))&#10;)&#10;//this part is just added to create NULLS for the cases that there is no evaluation at all (as an oppose to 0)&#10;*(sum([evaluations])/sum([evaluations]))' />
      </column>
      <column caption='QA Score - Not formatted ' datatype='real' default-format='p0%' name='[Calculation_615796940115410945]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([qa_score])&#10;/(sum([evaluations])* 100)' />
      </column>
      <column caption='Outbound Call Rate' datatype='real' default-format='p0.0%' name='[Calculation_624663386307125248]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL([Calculation_1369938767393751041], 0))/&#10;SUM([Calculation_126523021110427648])' />
      </column>
      <column caption='Date Range' datatype='date' name='[Calculation_786441134205132801]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[created_date]' />
      </column>
      <column caption='Date' datatype='string' name='[Calculation_850898904035840001]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if  [Parameters].[Parameter 5]=&apos;Daily&apos; then  str([created_date])&#13;&#10;ELSEIF  [Parameters].[Parameter 5]=&apos;Weekly&apos; then  [week]&#13;&#10;ELSEif [Parameters].[Parameter 5]=&apos;Monthly&apos; then [month]&#13;&#10;elseif [Parameters].[Parameter 5]=&apos;Quarterly&apos; then  str([date - m (copy)])&#13;&#10;END' />
      </column>
      <column caption='Outbound Calls AHT' datatype='real' name='[Calculation_850898904054214659]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([outbound_ht_call])/SUM([outbound_calls]))/60' />
      </column>
      <column caption='Inbound Calls - AHT (m)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_850898904066105349]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//(IFNULL([Inbound AVG After Call Handling Time Sec],0)+&#13;&#10;IFNULL([Fake Chat Occupancy Rate (copy)],0)&#10;//+IFNULL([Inbound AVG Call Waiting Time Sec],0))&#10;&#10;/60' />
      </column>
      <column caption='# Non-Live' datatype='integer' name='[Calculation_850898904087347206]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[incoming_cases]' />
      </column>
      <column caption='Non Live SLA 8h' datatype='real' default-format='p0.0%' name='[Calculation_850898904105181192]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([case_within_sla])/sum([incoming_cases])&#10;&#10;&#10;// We removed the underlying attempt to solve cosmetic issues but could create errors&#10;&#10;//IF ISNUll([Answered Emails In8Hrs]) = TRUE THEN NULL&#10;//ELSE [Inbound Cases]&#10;//end&#10;//)' />
      </column>
      <column caption='2019 Filter' datatype='integer' name='[Calculation_970244308479684608]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [created_date] &gt;= #2019-01-01# THEN 1 ELSE 0 END' />
      </column>
      <column caption='Inbound Call Contact Rate' datatype='real' default-format='p0.0%' name='[Call Service Level  (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL([# Inbound Valid Calls (copy)_1369938767393132544],0))&#10;/SUM(IFNULL([Calculation_126523021110427648],0))' />
      </column>
      <column caption='Overall Service Level Agreement' datatype='real' default-format='p0.0%' name='[Call Service Level -30 sec (copy)]' role='measure' type='quantitative'>
