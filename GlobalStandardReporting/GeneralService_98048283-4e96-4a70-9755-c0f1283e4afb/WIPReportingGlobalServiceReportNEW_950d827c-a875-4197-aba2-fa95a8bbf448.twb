      <aliases enabled='yes' />
      <column caption='CPC Overhead' datatype='real' name='[% Overhead (copy)_836262206647697434]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([sum_overheads_eur])/sum([Calculation_836262206630805507])' />
      </column>
      <column caption='% Order Damaged' datatype='real' name='[% Refund  (copy)_1020628317627645955]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Refund (copy)_1020628317627645954]) / TOTAL(SUM([Refund (copy)_1020628317627645954]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='CPO  Refund' datatype='real' name='[% Refund and Compensation (copy) (copy)_836262206743875621 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_836262206633660423 1])/[Calculation_836262206626512897]' />
      </column>
      <column caption='CPO  Late - Spilled Order' datatype='real' name='[% Refund and Compensation (copy) (copy)_836262206743875621]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_836262206633660423])/[Calculation_836262206626512897]' />
      </column>
      <column caption='CPC Refund' datatype='real' name='[% Refund and Compensation (copy)_836262206743855140 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//sum([Refund])/sum([CS Costs])&#10;&#10;sum([Calculation_836262206633660423 1])/sum([All contacts  (copy)_1020628317643350020])' />
      </column>
      <column caption='CPC Late - Spilled Order' datatype='real' name='[% Refund and Compensation (copy)_836262206743855140]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_836262206633660423])/sum([All contacts  (copy)_1020628317643350020])' />
      </column>
      <column caption='CPC All' datatype='real' name='[% Total Costs (copy) (copy)_836262206742360098]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_836262206633590790])/sum([Calculation_836262206630805507])' />
      </column>
      <column caption='% CC - Total Costs' datatype='real' name='[% Total Costs (copy)_1369938767416520711]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( [Total Costs (copy)_1369938767416520710]) / TOTAL(SUM([Total Costs (copy)_1369938767416520710]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='CPO All' datatype='real' name='[% Total Costs (copy)_836262206742347809]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_836262206633590790])/[Calculation_836262206626512897]' />
      </column>
      <column caption='Relative' datatype='real' default-format='p0%' name='[Absolute (copy)_836262206645108759]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  [Parameters].[Parameter 1 2]=&apos;Personnel&apos; then [Calculation_836262206636806152]&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;Non Personnel&apos; then [Non Personnel (copy)_836262206637965323]&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;Overhead&apos; then [Calculation_836262206647537689]&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;Total&apos; then [Calculation_836262206742216736]&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;CC - Total&apos; then [% Total Costs (copy)_1369938767416520711]&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;Late - Spilled Order&apos; then [Calculation_836262206741766175]&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;Order Damged&apos; then [% Refund  (copy)_1020628317627645955]&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;Refund&apos; then [Calculation_836262206741766175 1]&#13;&#10;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='CS Contacts' datatype='integer' default-format='n#,##0;-#,##0' name='[All contacts  (copy)_1020628317643350020]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  [stakeholder]=&apos;Customer&apos; then &#13;&#10;[all_contacts]&#13;&#10;END' />
      </column>
      <column caption='CPO' datatype='real' name='[CPC (copy)_836262206641778705]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  [Parameters].[Parameter 1 2]=&apos;Personnel&apos; then [Calculation_836262206631686148]&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;Non Personnel&apos; then [CPC Non Personnel (copy)_836262206637867018]&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;Overhead&apos; then [CPC Overhead (copy)_836262206647816219]&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;Total&apos; then [% Total Costs (copy)_836262206742347809]&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;CC - Total&apos; then [CPO All (copy)_1369938767416520709]&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;Late - Spilled Order&apos; then [% Refund and Compensation (copy) (copy)_836262206743875621]&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;Order Damged&apos; then [CPO  Refund (copy)_1020628317627645952]&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;Refund&apos; then [% Refund and Compensation (copy) (copy)_836262206743875621 1]&#10;&#10;// -- related to Dispatching OD Orders ONLY&#10;ELSEIF [Parameters].[Parameter 1 2] = &apos;RS OD - Personnel Costs&apos; THEN [CPO personnel  (copy)_3264757920249004035]&#10;ELSEIF [Parameters].[Parameter 1 2] = &apos;RS OD - Non-Personnel Costs&apos; THEN [CPO Non Personnel  (copy)_3264757920249540612]&#10;ELSEIF [Parameters].[Parameter 1 2] = &apos;RS OD -  Overheads Costs&apos; THEN [CPO Overhead (copy)_3264757920253382662]&#13;&#10;END' />
      </column>
      <column caption='Absolute' datatype='real' name='[CPC (copy)_836262206643036182]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  [Parameters].[Parameter 1 2]=&apos;Personnel&apos; then sum([sum_personnel_costs_eur])&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;Non Personnel&apos; then sum([sum_non_personnel_eur])&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;Overhead&apos; then sum([sum_overheads_eur])&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;Total&apos; then sum([Calculation_836262206633590790])&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;CC - Total&apos; then sum([Total Costs (copy)_1369938767416520710])&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;Late - Spilled Order&apos; then sum([Calculation_836262206633660423])&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;Order Damged&apos; then sum([Refund (copy)_1020628317627645954])&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;Refund&apos; then sum([Calculation_836262206633660423 1])&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='CC - CPC All' datatype='real' name='[CPC All (copy)_1369938767416520708]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Total Costs (copy)_1369938767416520710])/sum([Calculation_836262206630805507])' />
