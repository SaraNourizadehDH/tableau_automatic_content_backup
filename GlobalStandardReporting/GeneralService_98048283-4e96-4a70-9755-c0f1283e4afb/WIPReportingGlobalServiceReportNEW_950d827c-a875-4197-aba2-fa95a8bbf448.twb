      <column caption='Contacts per Order' datatype='real' default-format='p0.0%' name='[Total Contact Rate (copy 2)_1068760529939554304]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1499135771098468353]' />
      </column>
      <column caption='Total Contact Rate - current week' datatype='real' default-format='p0.0%' name='[Total Contact Rate (copy 2)_5644769580021702666]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(&#10;IF [Calculation_5238108607331725312] &#10;THEN IFNULL([inbound_calls],0)&#10;ELSE 0 END)&#13;&#10;+&#10;SUM(&#10;IF [Calculation_5238108607331725312] &#10;THEN IFNULL([incoming_chats],0)&#10;ELSE 0 END)&#10;+&#10;SUM(&#10;IF [Calculation_5238108607331725312] &#10;THEN IFNULL([incoming_cases],0)&#10;ELSE 0 END) //includes SoME&#13;&#10;)&#13;&#10;/&#10;SUM(&#10;[Gross Orders (copy)_5644769579984502784]&#10;)' />
      </column>
      <column caption='Total Contact RS' datatype='real' default-format='n#,##0;-#,##0' name='[Total Contact Rate (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if  [stakeholder]=&apos;Dispatching&apos;&#13;&#10;THEN&#13;&#10;IFNULL([inbound_calls],0)&#13;&#10;+IFNULL([incoming_chats],0)&#13;&#10;+IFNULL([inbound_emails],0)&#13;&#10;+IFNULL([inbound_socialmedia_posts],0)&#13;&#10;END' />
      </column>
      <column caption='Total Contact Rate - current week minus 1' datatype='real' default-format='p0.0%' name='[Total Contact Rate - current week (copy)_5644769580022366219]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(&#10;IF [is_current_week_minus_2 (copy)_5238108607357255689] &#10;THEN IFNULL([inbound_calls],0)&#10;ELSE 0 END)&#10;+&#10;SUM(&#10;IF [is_current_week_minus_2 (copy)_5238108607357255689] &#10;THEN IFNULL([incoming_chats],0)&#10;ELSE 0 END)&#10;+&#10;SUM(&#10;IF [is_current_week_minus_2 (copy)_5238108607357255689] &#10;THEN IFNULL([incoming_cases],0)&#10;ELSE 0 END) //includes SoME&#10;)&#10;/&#10;SUM(&#10;[Gross Orders - current week (copy)_5644769579984850945]&#10;)' />
      </column>
      <column caption='Total Contact Rate - current week WoW value' datatype='real' default-format='p0.0%' name='[Total Contact Rate - current week WoW (copy)_5644769580022566925]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Total Contact Rate (copy 2)_5644769580021702666] * 100 - [Total Contact Rate - current week (copy)_5644769580022366219] * 100' />
      </column>
      <column caption='Total Contact Rate - current week WoW' datatype='boolean' default-format='p0.0%' name='[Total Contact Rate - current week minus 1 (copy)_5644769580022485004]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[Total Contact Rate (copy 2)_5644769580021702666] &gt; [Total Contact Rate - current week (copy)_5644769580022366219]' />
      </column>
      <column caption='CS Cost per order (CPO)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Total Cost per order (CPO) (copy)_799107464059478016]' role='measure' type='quantitative'>
