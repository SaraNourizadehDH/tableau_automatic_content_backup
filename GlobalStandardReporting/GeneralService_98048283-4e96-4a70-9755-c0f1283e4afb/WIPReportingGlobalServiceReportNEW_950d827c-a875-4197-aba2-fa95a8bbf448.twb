    <worksheet name='Overview sheet'>
      <repository-location id='Overviewsheet' path='/t/GlobalStandardReporting/workbooks/NewGlobalContactCenterReport' revision='' site='GlobalStandardReporting' />
      <table>
        <view>
          <datasources>
            <datasource caption='global_service_report' name='federated.009wyn518bsb7519nypj01x4mu8t' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Dimension 2' datatype='string' name='[Dimensions (copy)_3333015627648565249]' param-domain-type='list' role='measure' type='nominal' value='&quot;Management Entity&quot;'>
              <calculation class='tableau' formula='&quot;Management Entity&quot;' />
              <aliases>
                <alias key='&quot;Contact Center&quot;' value='Contact Center' />
                <alias key='&quot;Delivery Type&quot;' value='Delivery Type' />
              </aliases>
            </column>
            <column caption='Date Granularity' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
            <column caption='Dimension 1' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
              <aliases>
                <alias key='&quot;Contact Center&quot;' value='Contact Center' />
                <alias key='&quot;Delivery Type&quot;' value='Delivery Type' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.009wyn518bsb7519nypj01x4mu8t'>
            <column caption='# Inbound Valid Calls (ratio)' datatype='integer' name='[# Inbound Valid Calls (copy)_1369938767393132544]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if ISNULL([Calculation_126523021110427648]) THEN 0&#13;&#10;ELSE IFNULL([inbound_calls],0)&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='# Incoming Chats (ratio)' datatype='integer' name='[# Incoming Chats (copy)_1369938767394148354]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if ISNULL([Calculation_126523021110427648]) THEN 0&#13;&#10;ELSE [incoming_chats]&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Shrinkage - not formatted' datatype='real' default-format='p0.0%' name='[2nd Level Request Answer Rate (copy 5)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - (SUM(IFNULL([hours_clocked_within_schedule],0))/SUM(IFNULL([hours_scheduled_all],0)))' />
            </column>
            <column caption='Chat Contact Rate' datatype='real' default-format='p0.0%' name='[A Call Acceptance Rate (copy 2)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([# Incoming Chats (copy)_1369938767394148354])&#10;/SUM([Calculation_126523021110427648])' />
            </column>
            <column caption='Non-Live  Rate' datatype='real' default-format='p0.0%' name='[A Call Acceptance Rate (copy 4) 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([Inbound Cases (copy)_1369938767394500611],0))&#13;&#10;/SUM([Calculation_126523021110427648])' />
            </column>
            <column caption='Chat Service Level -30 sec' datatype='real' default-format='p0.0%' name='[A Call Acceptance Rate (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_sla_30s_chat])&#10;/SUM(IFNULL([incoming_chats],0)) &#10;   // - IFNULL([bot_chats], 0) &#10;  //  - IFNULL([chats_with_issues], 0))))&#10;&#10;// Removed this attempt to solve cosmetic issues for Balkans&#10;//IF ISNUll([Answered Chats Within30Sec]) = TRUE THEN NULL&#10;//ELSE (IFNULL([# Incoming Chats],0) &#10;//    - IFNULL([Bot Chats -  Intercom only], 0) &#10;//    - IFNULL([Chats with Issues - Intercom only], 0))&#10;//end)&#10;//)&#10;//)' />
            </column>
            <column caption='Call Service Level -30 sec' datatype='real' default-format='p0.0%' name='[AA Back Office Task Rate (copy) (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_sla_30s_calls])&#10;/SUM(&#10;&#10;IF ISNUll([count_sla_30s_calls]) = TRUE THEN NULL&#10;ELSE [inbound_calls]&#10;&#10;end&#10;&#10;)' />
            </column>
            <column caption='QA Score ' datatype='real' name='[AC NPS  (copy)_1590615107448315910]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if &#10; ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;DH Regions&apos; )&#10;or  ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;GST Regions&apos; )&#10;or ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;Global&apos; )&#10;or ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;Management Entity&apos; )&#10;or ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;Contact Center&apos; )&#10;or ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;Country&apos; and attr(left([Calculation_222857857467572224],3)) != &apos;SSC&apos; )&#10;or ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;Display Name&apos; and attr(left([Calculation_222857857467572224],3)) != &apos;SSC&apos; )&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249] = &apos;Daily&apos; )&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249] = &apos;Weekly&apos; )&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249] = &apos;Monthly&apos; )&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249] = &apos;Quarterly&apos; )&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249] = &apos;Global Entity Id&apos; )&#13;&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249] = &apos;Stakeholder&apos; )&#10;then [Calculation_615796940115410945]&#10;&#10;else null&#10;end' />
            </column>
            <column caption='Non Live AHT' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[AHT Chat (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([Total Email Handling Time Sec (copy)_908882701739511808],0))/SUM([resolved_cases])' />
            </column>
            <column caption='DH Regions' datatype='string' name='[Calculation_104145778124697602]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[dh_region]' />
            </column>
            <column caption='Gross Orders' datatype='integer' default-format='n#,##0,.0K;-#,##0,.0K' name='[Calculation_126523021110427648]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL({FIXED [global_entity_id],[created_date], [vertical], [delivery_type], [is_subscription], [is_corporate], [is_preorder], [Calculation_222857857467572224],&#10;[country], [brand] : max([total_orders])}&#13;&#10;,0)&#13;&#10;//  fixes to avoid duplications' />
            </column>
            <column caption='Issue Rate' datatype='real' default-format='p0.0%' name='[Calculation_1359101970151641088]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([issues Total (copy)_1139973706829881344])/ SUM([Calculation_126523021110427648])' />
            </column>
            <column caption='# Outbound Calls (ratio)' datatype='integer' name='[Calculation_1369938767393751041]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if ISNULL([Calculation_126523021110427648]) THEN 0&#13;&#10;ELSE [outbound_calls]&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Issues RS/SH' datatype='integer' name='[Calculation_1442840798434844673]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [stakeholder]=&apos;Rider&apos; OR [stakeholder] = &apos;Shopper&apos; THEN [issues Total (copy)_1139973706829881344] END' />
            </column>
            <column caption='RS/SH OD Issue Rate' datatype='real' default-format='p0.0%' name='[Calculation_1442840798456725509]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1442840798434844673])/SUM([Orders (copy 2)_1442840798455828483])' />
            </column>
            <column caption='Total Contacts per Order' datatype='real' default-format='p0.0%' name='[Calculation_1499135771098468353]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IFNULL([inbound_calls],0))&#13;&#10;+SUM(IFNULL([incoming_chats],0))&#13;&#10;+sum(IFNULL([incoming_cases],0)) //includes SoME&#13;&#10;)&#13;&#10;/SUM([Calculation_126523021110427648])' />
            </column>
            <column caption='Service Index' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1554867821100556288]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF IFNULL([Calculation_610026677072920578],0)=0 THEN FLOAT(NULL)&#10;ELSE [Calculation_1590615107356774403] * [Calculation_610026677072920578]&#10;END' />
            </column>
            <column caption='Productivity ' datatype='real' name='[Calculation_1590615107356774403]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if (&#10; ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;DH Regions&apos; )&#10;or ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;Global&apos; )&#10;or  ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;GST Regions&apos; )&#10;or ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;Management Entity&apos; )&#10;or ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;Contact Center&apos; )&#10;or ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;Country&apos; and attr(left([Calculation_222857857467572224],3)) != &apos;SSC&apos; )&#10;or ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;Display Name&apos; and attr(left([Calculation_222857857467572224],3)) != &apos;SSC&apos;)&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249] = &apos;Daily&apos; )&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249] = &apos;Weekly&apos; )&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249] = &apos;Monthly&apos; )&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249] = &apos;Quarterly&apos; )&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249] = &apos;Global Entity Id&apos; )&#10;&#10;)&#10; &#10;then [Calculation_286893405478703106]&#10;&#10;else null&#10;end' />
            </column>
            <column caption='HC - No Contact CSAT' datatype='real' default-format='p0%' name='[Calculation_1993405800873082880]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([count_csat_4_5])/sum([count_responses])' />
            </column>
            <column caption='Contact Center' datatype='string' name='[Calculation_222857857467572224]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF 1 = 1 then [contact_center] END&#10;&#10;// IF [Management Entity] = &apos;Carriage&apos; THEN &apos;SSC Carriage&apos;&#10;// ELSEIF [Management Entity] = &apos;Talabat&apos; THEN &apos;SSC TalabatOtlob&apos;&#10;// ELSEIF [Display Name] = &apos;FP - Pakistan&apos; THEN &apos;Pakistan&apos;&#10;// ELSEIF [Management Entity] = &apos;Pedidosya&apos; THEN &apos;SSC PedidosYa&apos;&#10;// ELSEIF [Management Entity] = &apos;Yemeksepeti&apos; THEN &apos;Turkey&apos;&#10;// ELSEIF [Management Entity] = &apos;Donesi&apos; THEN &apos;Balkans&apos;&#10;// ELSEIF [Display Name] = &apos;FP - Bangladesh&apos; THEN &apos;Bangladesh&apos;&#10;// ELSEIF [Management Entity] = &apos;HungerStation&apos; THEN &apos;Saudi Arabia&apos;&#10;// ELSEIF [Management Entity] = &apos;Foodora&apos; THEN &apos;Canada&apos; &#10;// ELSEIF [Management Entity] = &apos;ClickDelivery&apos; THEN &apos;SSC Domicilios&apos;&#10;// ELSEIF [Management Entity] = &apos;DH Greece&apos; THEN &apos;Greece&apos;&#10;// ELSEIF [Management Entity] = &apos;Foodpanda APAC&apos; THEN &apos;SSC APAC&apos;&#10;// ELSEIF [Management Entity] = &apos;Pauza&apos; THEN &apos;Croatia&apos;&#10;// ELSEIF [Management Entity] = &apos;DH Korea&apos; THEN &apos;South Korea&apos;&#10;// ELSEIF [Management Entity] = &apos;DH Austria&apos; THEN &apos;Austria&apos;&#10;// ELSEIF  [Display Name] = &apos;FD - Finland&apos; THEN &apos;Finland&apos;&#10;// ELSEIF  [Display Name] = &apos;Pizza-Online Finland&apos; THEN &apos;Finland&apos;&#10;// ELSEIF  [Display Name] = &apos;Onlinepizza Sweden&apos; THEN &apos;Sweden&apos;&#10;// ELSEIF  [Display Name] = &apos;FD - Sweden&apos; THEN &apos;Sweden&apos;&#10;// ELSEIF  [Display Name] = &apos;FD - Norway&apos; THEN &apos;Norway&apos;&#10;&#10;&#10;// ELSEIF  [Display Name] = &apos;FP - Romania&apos; THEN &apos;Romania&apos;&#10;// ELSEIF  [Display Name] = &apos;HipMenu - RO&apos; THEN &apos;Romania&apos;&#10;&#10;&#10;// ELSEIF  [Display Name] = &apos;Damejidlo&apos; THEN &apos;Czech Republic&apos;&#10;&#10;// ELSEIF  [Display Name] = &apos;Hungary&apos; THEN &apos;Hungary&apos;&#10;// ELSEIF  [Display Name] = &apos;FP - Bulgaria&apos; THEN &apos;Bulgaria&apos;&#10;// END' />
            </column>
            <column caption='Productivity - Not formatted' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_286893405478703106]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(  [Calculation_530791456113037313])&#13;&#10;/ &#13;&#10;(&#13;&#10;&#13;&#10; SUM([hours_clocked_net])&#13;&#10;)' />
            </column>
            <column caption='is_escalated?' datatype='integer' name='[Calculation_5040935405400313856]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([is_escalated], 0)' />
            </column>
            <column caption='AHT Chat (m)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_5239727116595236865]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//(IFNULL([Inbound AVG After Chat Handling Time Sec],0)+&#13;&#10;//IFNULL([Inbound AVG Chat Waiting Time Sec],0) +&#10;IFNULL([Outbound AVG Call Time Sec (copy 2)],0)&#10;&#10; / 60' />
            </column>
            <column caption='Own Delivery Rate' datatype='real' default-format='p0.0%' name='[Calculation_530158182333104128]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([od_orders])&#10;/&#10;SUM([total_orders])' />
            </column>
            <column caption='issues Total' datatype='integer' default-format='n#,##0,.00K;-#,##0,.00K' name='[Calculation_530791456112443392]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL ([incoming_cases] ,0) + //includes S0Me&#13;&#10;IFNULL ([incoming_chats] ,0) +&#13;&#10;IFNULL ([inbound_calls] ,0) +&#13;&#10;IFNULL([outbound_calls], 0)' />
            </column>
            <column caption='Completed Contacts' datatype='real' name='[Calculation_530791456113037313]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([served_calls] ,0) +&#13;&#10;IFNULL([served_chats],0)  +&#13;&#10;IFNULL([working_items_l1] ,0)' />
            </column>
            <column caption='Global' datatype='string' name='[Calculation_610026676822482944]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;Global&apos;' />
            </column>
            <column caption='QTK - CSAT' datatype='real' default-format='p0%' name='[Calculation_610026677072920578]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([count_csat_4], 0) +IFNULL([count_csat_5], 0) )&#10;/&#10;SUM([csat_responses])' />
            </column>
            <column caption='Audits / Contacts - not formatted' datatype='real' default-format='p0.00%' name='[Calculation_615796940107870208]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([evaluations])&#10;/ &#10;(&#10;SUM(IFNULL([served_calls],0))&#10;+SUM(IFNULL([served_chats],0))&#10;+SUM(IFNULL([resolved_cases],0))&#10;)&#10;//this part is just added to create NULLS for the cases that there is no evaluation at all (as an oppose to 0)&#10;*(sum([evaluations])/sum([evaluations]))' />
            </column>
            <column caption='QA Score - Not formatted ' datatype='real' default-format='p0%' name='[Calculation_615796940115410945]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([qa_score])&#10;/(sum([evaluations])* 100)' />
            </column>
            <column caption='Outbound Call Rate' datatype='real' default-format='p0.0%' name='[Calculation_624663386307125248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([Calculation_1369938767393751041], 0))/&#10;SUM([Calculation_126523021110427648])' />
            </column>
            <column caption='Date Range' datatype='date' name='[Calculation_786441134205132801]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[created_date]' />
            </column>
            <column caption='Inbound Calls - AHT (m)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_850898904066105349]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//(IFNULL([Inbound AVG After Call Handling Time Sec],0)+&#13;&#10;IFNULL([Fake Chat Occupancy Rate (copy)],0)&#10;//+IFNULL([Inbound AVG Call Waiting Time Sec],0))&#10;&#10;/60' />
            </column>
            <column caption='Non Live SLA 8h' datatype='real' default-format='p0.0%' name='[Calculation_850898904105181192]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([case_within_sla])/sum([incoming_cases])&#10;&#10;&#10;// We removed the underlying attempt to solve cosmetic issues but could create errors&#10;&#10;//IF ISNUll([Answered Emails In8Hrs]) = TRUE THEN NULL&#10;//ELSE [Inbound Cases]&#10;//end&#10;//)' />
            </column>
            <column caption='Inbound Call Contact Rate' datatype='real' default-format='p0.0%' name='[Call Service Level  (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([# Inbound Valid Calls (copy)_1369938767393132544],0))&#10;/SUM(IFNULL([Calculation_126523021110427648],0))' />
            </column>
            <column caption='Overall Service Level Agreement' datatype='real' default-format='p0.0%' name='[Call Service Level -30 sec (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM(IFNULL([count_sla_30s_calls],0))+&#10;SUM (IFNULL([count_sla_30s_chat],0)) +&#10;SUM(IFNULL([case_within_sla],0))&#10;) &#10;/&#10;(&#10;SUM(IFNULL([inbound_calls],0))+&#10;sum(IFNULL([incoming_chats],0))+&#10;SUM(IFNULL([incoming_cases],0))&#10;)' />
            </column>
            <column caption='Dimension 2' datatype='string' default-format='n#,##0.0;-#,##0.0' name='[Dimensions (copy)_3333015627648552960]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Dimensions (copy)_3333015627648565249]&#10;    WHEN &apos;DH Regions&apos; THEN [Calculation_104145778124697602]&#10;    WHEN &apos;Contact Center&apos; THEN [Calculation_222857857467572224]&#10;    WHEN &apos;Management Entity&apos; THEN [management_entity_group]&#10;    WHEN &apos;Global&apos; THEN [Calculation_610026676822482944]&#10;    WHEN &apos;Delivery Type&apos; THEN [delivery_type]&#10;    WHEN &apos;Stakeholder&apos; THEN [stakeholder]&#13;&#10;    WHEN &apos;Daily&apos; then  str([created_date])&#10;    WHEN &apos;Weekly&apos; then  [week]&#10;    WHEN &apos;Monthly&apos; then [month]&#10;    WHEN &apos;Quarterly&apos; then  str([date - m (copy)])&#10;    WHEN &apos;Global Entity Id&apos; THEN [global_entity_id]&#10;END' />
            </column>
            <column caption='Inbound AVG Call Time Sec' datatype='real' default-format='n#,##0.0' name='[Fake Chat Occupancy Rate (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([inbund_ht_call])/SUM([served_calls])' />
            </column>
            <column caption='Granularity Level ()' datatype='string' name='[Granularity Level (copy)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if  [Parameters].[Parameter 5]=&apos;Daily&apos; then  str([created_date])&#13;&#10;ELSEIF  [Parameters].[Parameter 5]=&apos;Weekly&apos; then  [week]&#13;&#10;ELSEif [Parameters].[Parameter 5]=&apos;Monthly&apos; then [month]&#13;&#10;elseif [Parameters].[Parameter 5]=&apos;Quarterly&apos; then  str([date - m (copy)])&#13;&#10;END' />
            </column>
            <column caption='Inbound Cases (ratio)' datatype='integer' name='[Inbound Cases (copy)_1369938767394500611]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if ISNULL([Calculation_126523021110427648]) THEN 0&#13;&#10;ELSE [incoming_cases]&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Dimension 1' datatype='string' default-format='n#,##0.0;-#,##0.0' name='[KPIS 1 (copy)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;    WHEN &apos;DH Regions&apos; THEN [Calculation_104145778124697602]&#10;    WHEN &apos;Contact Center&apos; THEN [Calculation_222857857467572224]&#10;    WHEN &apos;Management Entity&apos; THEN [management_entity_group]&#10;    WHEN &apos;Global&apos; THEN [Calculation_610026676822482944]&#10;    WHEN &apos;Delivery Type&apos; THEN [delivery_type]&#10;    WHEN &apos;Stakeholder&apos; THEN [stakeholder]&#10;    WHEN &apos;Daily&apos; then  str([created_date])&#10;    WHEN &apos;Weekly&apos; then  [week]&#10;    WHEN &apos;Monthly&apos; then [month]&#10;    WHEN &apos;Quarterly&apos; then  str([date - m (copy)])&#10;    WHEN &apos;Global Entity Id&apos; THEN [global_entity_id]&#10;END' />
            </column>
            <column caption='OD  Orders' datatype='integer' default-format='n#,##0.0;-#,##0.0' name='[Orders (copy 2)_1442840798455828483]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL({FIXED [global_entity_id],[created_date], [vertical], [delivery_type], [is_subscription], [is_corporate], [is_preorder]: max([od_orders])}&#10;,0)' />
            </column>
            <column caption='Inbound AVG Chat Time Sec' datatype='real' name='[Outbound AVG Call Time Sec (copy 2)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([handling_time_chat])/SUM(&#10;[served_chats])' />
            </column>
            <column caption='Shrinkage ' datatype='real' default-format='p0.0%' name='[Productivity  (copy)_1590615107444408324]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if &#10; ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;DH Regions&apos; )&#10;or  ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;GST Regions&apos; )&#10;or ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;Global&apos; )&#10;or ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;Management Entity&apos; )&#10;or ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;Contact Center&apos; )&#10;or ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;Country&apos; and attr(left([Calculation_222857857467572224],3)) != &apos;SSC&apos; )&#10;or ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;Display Name&apos; and attr(left([Calculation_222857857467572224],3)) != &apos;SSC&apos; )&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249] = &apos;Daily&apos; )&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249] = &apos;Weekly&apos; )&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249] = &apos;Monthly&apos; )&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249] = &apos;Quarterly&apos; )&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249] = &apos;Global Entity Id&apos; )&#10;&#10;then [2nd Level Request Answer Rate (copy 5)]&#10;&#10;else null&#10;end' />
            </column>
            <column caption='Audits / Contacts ' datatype='real' name='[QA Score  (copy)_1590615107448864775]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if &#10; ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;DH Regions&apos; )&#10;or ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;Global&apos; )&#10;or  ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;GST Regions&apos; )&#10;or ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;Management Entity&apos; )&#10;or ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;Contact Center&apos; )&#10;or ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;Country&apos; and attr(left([Calculation_222857857467572224],3)) != &apos;SSC&apos; )&#10;or ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;Display Name&apos; and attr(left([Calculation_222857857467572224],3)) != &apos;SSC&apos; )&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249] = &apos;Daily&apos; )&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249] = &apos;Weekly&apos; )&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249] = &apos;Monthly&apos; )&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249] = &apos;Quarterly&apos; )&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249] = &apos;Global Entity Id&apos; )&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249] = &apos;Stakeholder&apos; )&#13;&#10;&#10;then [Calculation_615796940107870208]&#10;&#10;else null&#10;end' />
