      <column caption='% Personnel' datatype='real' name='[Calculation_836262206636806152]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sum_personnel_costs_eur]) / TOTAL(SUM([sum_personnel_costs_eur]))'>
