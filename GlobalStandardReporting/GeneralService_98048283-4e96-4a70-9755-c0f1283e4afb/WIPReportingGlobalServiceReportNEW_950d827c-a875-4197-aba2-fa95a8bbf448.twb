      <column caption='Chat Contact Rate' datatype='real' default-format='p0.0%' name='[A Call Acceptance Rate (copy 2)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([# Incoming Chats (copy)_1369938767394148354])&#10;/SUM([Calculation_126523021110427648])' />
      </column>
      <column caption='Non-Live  Rate' datatype='real' default-format='p0.0%' name='[A Call Acceptance Rate (copy 4) 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL([Inbound Cases (copy)_1369938767394500611],0))&#13;&#10;/SUM([Calculation_126523021110427648])' />
      </column>
      <column caption='Chat Service Level -30 sec' datatype='real' default-format='p0.0%' name='[A Call Acceptance Rate (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_sla_30s_chat])&#10;/SUM(IFNULL([incoming_chats],0)) &#10;   // - IFNULL([bot_chats], 0) &#10;  //  - IFNULL([chats_with_issues], 0))))&#10;&#10;// Removed this attempt to solve cosmetic issues for Balkans&#10;//IF ISNUll([Answered Chats Within30Sec]) = TRUE THEN NULL&#10;//ELSE (IFNULL([# Incoming Chats],0) &#10;//    - IFNULL([Bot Chats -  Intercom only], 0) &#10;//    - IFNULL([Chats with Issues - Intercom only], 0))&#10;//end)&#10;//)&#10;//)' />
      </column>
      <column caption='Call Service Level -30 sec' datatype='real' default-format='p0.0%' name='[AA Back Office Task Rate (copy) (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_sla_30s_calls])&#10;/SUM(&#10;&#10;IF ISNUll([count_sla_30s_calls]) = TRUE THEN NULL&#10;ELSE [inbound_calls]&#10;&#10;end&#10;&#10;)' />
      </column>
      <column caption='QA Score ' datatype='real' name='[AC NPS  (copy)_1590615107448315910]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if &#10; ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;DH Regions&apos; )&#10;or  ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;GST Regions&apos; )&#10;or ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;Global&apos; )&#10;or ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;Management Entity&apos; )&#10;or ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;Contact Center&apos; )&#10;or ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;Country&apos; and attr(left([Calculation_222857857467572224],3)) != &apos;SSC&apos; )&#10;or ([Parameters].[Dimensions (copy)_3333015627648565249]=&apos;Display Name&apos; and attr(left([Calculation_222857857467572224],3)) != &apos;SSC&apos; )&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249] = &apos;Daily&apos; )&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249] = &apos;Weekly&apos; )&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249] = &apos;Monthly&apos; )&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249] = &apos;Quarterly&apos; )&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249] = &apos;Global Entity Id&apos; )&#13;&#10;OR ([Parameters].[Dimensions (copy)_3333015627648565249] = &apos;Stakeholder&apos; )&#10;then [Calculation_615796940115410945]&#10;&#10;else null&#10;end' />
      </column>
      <column caption='Score AC NPS' datatype='integer' default-format='n#,##0.00;-#,##0.00' hidden='true' name='[AC NPS (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='If [Calculation_502995822125400064] &lt; [Parameters].[Parameter 1 1] THEN 0 &#10;ELSEIF [Calculation_502995822125400064] &gt; [Parameters].[Parameter 1 1] + (0 * [Parameters].[AC NPS |-&gt; (copy)]) and [Calculation_502995822125400064] &lt; [Parameters].[Parameter 1 1] + (1 * [Parameters].[AC NPS |-&gt; (copy)]) THEN 1&#10;ELSEIF [Calculation_502995822125400064] &gt; [Parameters].[Parameter 1 1] + (1 * [Parameters].[AC NPS |-&gt; (copy)]) and [Calculation_502995822125400064] &lt; [Parameters].[Parameter 1 1] + (2 * [Parameters].[AC NPS |-&gt; (copy)]) THEN 2&#10;ELSEIF [Calculation_502995822125400064] &gt; [Parameters].[Parameter 1 1] + (2 * [Parameters].[AC NPS |-&gt; (copy)]) and [Calculation_502995822125400064] &lt; [Parameters].[Parameter 1 1] + (3 * [Parameters].[AC NPS |-&gt; (copy)]) THEN 3&#10;ELSEIF [Calculation_502995822125400064] &gt; [Parameters].[Parameter 1 1] + (3 * [Parameters].[AC NPS |-&gt; (copy)]) and [Calculation_502995822125400064] &lt; [Parameters].[Parameter 1 1] + (4 * [Parameters].[AC NPS |-&gt; (copy)]) THEN 4&#10;ELSEIF [Calculation_502995822125400064] &gt; [Parameters].[Parameter 1 1] + (4 * [Parameters].[AC NPS |-&gt; (copy)]) and [Calculation_502995822125400064] &lt; [Parameters].[Parameter 1 1] + (5 * [Parameters].[AC NPS |-&gt; (copy)]) THEN 5&#10;ELSEIF [Calculation_502995822125400064] &gt; [Parameters].[Parameter 1 1] + (5 * [Parameters].[AC NPS |-&gt; (copy)]) and [Calculation_502995822125400064] &lt; [Parameters].[Parameter 1 1] + (6 * [Parameters].[AC NPS |-&gt; (copy)]) THEN 6&#10;ELSEIF [Calculation_502995822125400064] &gt; [Parameters].[Parameter 1 1] + (6 * [Parameters].[AC NPS |-&gt; (copy)]) and [Calculation_502995822125400064] &lt; [Parameters].[Parameter 1 1] + (7 * [Parameters].[AC NPS |-&gt; (copy)]) THEN 7&#10;ELSEIF [Calculation_502995822125400064] &gt; [Parameters].[Parameter 1 1] + (7 * [Parameters].[AC NPS |-&gt; (copy)]) and [Calculation_502995822125400064] &lt; [Parameters].[Parameter 1 1] + (8 * [Parameters].[AC NPS |-&gt; (copy)]) THEN 8&#10;ELSEIF [Calculation_502995822125400064] &gt; [Parameters].[Parameter 1 1] + (8 * [Parameters].[AC NPS |-&gt; (copy)]) and [Calculation_502995822125400064] &lt; [Parameters].[Parameter 1 1] + (9 * [Parameters].[AC NPS |-&gt; (copy)]) THEN 9&#10;ELSEIF [Calculation_502995822125400064] &gt; [Parameters].[Parameter 1 1] + (9 * [Parameters].[AC NPS |-&gt; (copy)]) THEN 10&#10;END' />
      </column>
      <column caption='Non Live AHT' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[AHT Chat (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL([Total Email Handling Time Sec (copy)_908882701739511808],0))/SUM([resolved_cases])' />
