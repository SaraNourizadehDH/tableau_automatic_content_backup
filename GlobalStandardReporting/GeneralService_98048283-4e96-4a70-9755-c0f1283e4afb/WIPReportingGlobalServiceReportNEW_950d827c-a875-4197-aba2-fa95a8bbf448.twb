        <calculation class='tableau' formula='If [Call Service Level -30 sec (copy)] &lt; ([Parameters].[AC NPS |-&gt; (copy 2)] + ([Parameters].[AC NPS |-| (copy)] * 0)) THEN 0 &#10;ELSEIF [Call Service Level -30 sec (copy)] &gt; ([Parameters].[AC NPS |-&gt; (copy 2)] + ([Parameters].[AC NPS |-| (copy)] * 0)) and [Call Service Level -30 sec (copy)] &lt; ([Parameters].[AC NPS |-&gt; (copy 2)] + ([Parameters].[AC NPS |-| (copy)] * 1)) THEN 1&#10;ELSEIF [Call Service Level -30 sec (copy)] &gt; ([Parameters].[AC NPS |-&gt; (copy 2)] + ([Parameters].[AC NPS |-| (copy)] * 1)) and [Call Service Level -30 sec (copy)] &lt; ([Parameters].[AC NPS |-&gt; (copy 2)] + ([Parameters].[AC NPS |-| (copy)] * 2)) THEN 2&#10;ELSEIF [Call Service Level -30 sec (copy)] &gt; ([Parameters].[AC NPS |-&gt; (copy 2)] + ([Parameters].[AC NPS |-| (copy)] * 2)) and [Call Service Level -30 sec (copy)] &lt; ([Parameters].[AC NPS |-&gt; (copy 2)] + ([Parameters].[AC NPS |-| (copy)] * 3)) THEN 3&#10;ELSEIF [Call Service Level -30 sec (copy)] &gt; ([Parameters].[AC NPS |-&gt; (copy 2)] + ([Parameters].[AC NPS |-| (copy)] * 3)) and [Call Service Level -30 sec (copy)] &lt; ([Parameters].[AC NPS |-&gt; (copy 2)] + ([Parameters].[AC NPS |-| (copy)] * 4)) THEN 4&#10;ELSEIF [Call Service Level -30 sec (copy)] &gt; ([Parameters].[AC NPS |-&gt; (copy 2)] + ([Parameters].[AC NPS |-| (copy)] * 4)) and [Call Service Level -30 sec (copy)] &lt; ([Parameters].[AC NPS |-&gt; (copy 2)] + ([Parameters].[AC NPS |-| (copy)] * 5)) THEN 5&#10;ELSEIF [Call Service Level -30 sec (copy)] &gt; ([Parameters].[AC NPS |-&gt; (copy 2)] + ([Parameters].[AC NPS |-| (copy)] * 5)) and [Call Service Level -30 sec (copy)] &lt; ([Parameters].[AC NPS |-&gt; (copy 2)] + ([Parameters].[AC NPS |-| (copy)] * 6)) THEN 6&#10;ELSEIF [Call Service Level -30 sec (copy)] &gt; ([Parameters].[AC NPS |-&gt; (copy 2)] + ([Parameters].[AC NPS |-| (copy)] * 6)) and [Call Service Level -30 sec (copy)] &lt; ([Parameters].[AC NPS |-&gt; (copy 2)] + ([Parameters].[AC NPS |-| (copy)] * 7)) THEN 7&#10;ELSEIF [Call Service Level -30 sec (copy)] &gt; ([Parameters].[AC NPS |-&gt; (copy 2)] + ([Parameters].[AC NPS |-| (copy)] * 7)) and [Call Service Level -30 sec (copy)] &lt; ([Parameters].[AC NPS |-&gt; (copy 2)] + ([Parameters].[AC NPS |-| (copy)] * 8)) THEN 8&#10;ELSEIF [Call Service Level -30 sec (copy)] &gt; ([Parameters].[AC NPS |-&gt; (copy 2)] + ([Parameters].[AC NPS |-| (copy)] * 8)) and [Call Service Level -30 sec (copy)] &lt; ([Parameters].[AC NPS |-&gt; (copy 2)] + ([Parameters].[AC NPS |-| (copy)] * 9)) THEN 9&#10;ELSEIF [Call Service Level -30 sec (copy)] &gt; ([Parameters].[AC NPS |-&gt; (copy 2)] + ([Parameters].[AC NPS |-| (copy)] * 9)) THEN 10&#10;END' />
