      <column caption='CPC' datatype='real' name='[Calculation_836262206640726032]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  [Parameters].[Parameter 1 2]=&apos;Personnel&apos; then [CPO personnel  (copy)_836262206632566789]&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;Non Personnel&apos; then [Calculation_836262206637330441]&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;Overhead&apos; then [% Overhead (copy)_836262206647697434]&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;Total&apos; then [% Total Costs (copy) (copy)_836262206742360098]&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;CC - Total&apos; then [CPC All (copy)_1369938767416520708]&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;Late - Spilled Order&apos; then [% Refund and Compensation (copy)_836262206743855140]&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;Order Damged&apos; then [CPC Refund (copy)_1020628317627645953]&#13;&#10;ELSEIF [Parameters].[Parameter 1 2]=&apos;Refund&apos; then [% Refund and Compensation (copy)_836262206743855140 1]&#13;&#10;&#13;&#10;END' />
