        </calculation>
      </column>
      <column caption='Total Contact ' datatype='real' default-format='n#,##0;-#,##0' name='[Total Contact CS (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([inbound_calls],0)&#13;&#10;+IFNULL([incoming_chats],0)&#13;&#10;+IFNULL([inbound_emails],0)&#13;&#10;+IFNULL([inbound_socialmedia_posts],0)' />
      </column>
      <column caption='Total Contact PS' datatype='real' default-format='n#,##0;-#,##0' name='[Total Contact Disptching (copy) (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if  [stakeholder]=&apos;Partner Service&apos;&#13;&#10;THEN&#13;&#10;IFNULL([inbound_calls],0)&#13;&#10;+IFNULL([incoming_chats],0)&#13;&#10;+IFNULL([inbound_emails],0)&#13;&#10;+IFNULL([inbound_socialmedia_posts],0)&#13;&#10;END' />
      </column>
      <column caption='Total Contact CS' datatype='real' default-format='n#,##0;-#,##0' name='[Total Contact Disptching (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if  [stakeholder]=&apos;Customer Service&apos;&#13;&#10;THEN&#13;&#10;IFNULL([inbound_calls],0)&#13;&#10;+IFNULL([incoming_chats],0)&#13;&#10;+IFNULL([inbound_emails],0)&#13;&#10;+IFNULL([inbound_socialmedia_posts],0)&#13;&#10;END' />
