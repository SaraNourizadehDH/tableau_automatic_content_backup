      <column caption='Successful Sessions - current week' datatype='integer' name='[Successful Sessions (copy)_5644769580026925074]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_5238108607331725312] &#10;THEN &#10;[successful_sessions]&#10;ELSE 0 END&#10;)' />
      </column>
      <column caption='Successful Sessions - current week minus 1' datatype='integer' name='[Successful Sessions - current week (copy)_5644769580027006995]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_current_week_minus_2 (copy)_5238108607357255689] &#10;THEN &#10;[successful_sessions]&#10;ELSE 0 END&#10;)' />
      </column>
      <column caption='Successful Sessions - current week WoW value' datatype='integer' name='[Successful Sessions - current week WoW (copy)_5644769580027318293]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Successful Sessions (copy)_5644769580026925074] - [Successful Sessions - current week (copy)_5644769580027006995]' />
      </column>
      <column caption='Successful Sessions - current week WoW' datatype='boolean' name='[Successful Sessions - current week minus 1 (copy)_5644769580027211796]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[Successful Sessions (copy)_5644769580026925074] &gt; [Successful Sessions - current week (copy)_5644769580027006995]' />
      </column>
      <column caption='Team ' datatype='string' name='[Team (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[stakeholder]' new-bin='true'>
          <bin default-name='false' value='&quot;Customer Service&quot;'>
