      <aliases enabled='yes' />
      <column caption='# Inbound Valid Calls (ratio)' datatype='integer' name='[# Inbound Valid Calls (copy)_1369938767393132544]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if ISNULL([Calculation_126523021110427648]) THEN 0&#13;&#10;ELSE IFNULL([inbound_calls],0)&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='# Incoming Chats (ratio)' datatype='integer' name='[# Incoming Chats (copy)_1369938767394148354]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if ISNULL([Calculation_126523021110427648]) THEN 0&#13;&#10;ELSE [incoming_chats]&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='RS # Incoming Chats' datatype='integer' name='[# Incoming Chats (copy)_1858297811719806978]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [stakeholder]=&apos;Rider Service&apos; then [incoming_chats] END' />
      </column>
      <column caption='% Total  cost' datatype='real' default-format='p0.0%' name='[% CS cost (copy 2)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_2113314170689699864])/sum([Calculation_2113314170689699864])' />
      </column>
      <column caption='% SF cost' datatype='real' default-format='p0.0%' name='[% CS cost (copy) (copy) (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([RS Costs EUR (copy)])/sum([Calculation_2113314170689699864])' />
      </column>
      <column caption='% RS cost ' datatype='real' default-format='p0.0%' name='[% CS cost (copy) (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_1327999001395548164])/sum([Calculation_2113314170689699864])' />
      </column>
      <column caption='% PS cost' datatype='real' default-format='p0.0%' name='[% CS cost (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_1327999001394638851])/sum([Calculation_2113314170689699864])' />
      </column>
      <column caption='% No- Evaluation Shifts' datatype='real' default-format='p0%' name='[% Evaluated Shifts (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([no_evaluation]) /([Calculation_1936125657671262210])' />
      </column>
      <column caption='% Punched + Evaluated Shifts - not formatted' datatype='real' default-format='p0.0%' name='[% Punched + Evaluated Shifts (copy)_4725401937840865280]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([punched])&#10;&#10;+sum( [evaluated])&#10;&#10;&#10;&#10;&#10;&#10;)/[Calculation_1936125657671262210]' />
      </column>
      <column caption='Shrinkage - not formatted' datatype='real' default-format='p0.0%' name='[2nd Level Request Answer Rate (copy 5)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - (SUM(IFNULL([hours_clocked_within_schedule],0))/SUM(IFNULL([hours_scheduled_all],0)))' />
      </column>
