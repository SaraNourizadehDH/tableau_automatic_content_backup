            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0c47mzy0dvrbpc1ex7ckp0piqs8i].[Calculation_75435338057429001]' caption='Time Threshold' datatype='date' name='[Parameter 1 1]' param-domain-type='any' role='measure' type='quantitative' value='#2025-09-04#'>
