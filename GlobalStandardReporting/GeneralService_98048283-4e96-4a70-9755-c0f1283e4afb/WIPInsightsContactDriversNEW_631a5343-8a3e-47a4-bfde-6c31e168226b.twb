    <worksheet name='Cancellation Reason '>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontname='Tableau Regular'>Cancellation Reason</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='contact_drivers_report (rl)' name='federated.0c47mzy0dvrbpc1ex7ckp0piqs8i' />
            <datasource name='Parameters' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Dimension 3' datatype='string' name='[Dimension 4 (copy)_4373206408654553128]' param-domain-type='list' role='measure' type='nominal' value='&quot;Time Between Contact And Promised Delivery Time Minutes&quot;'>
              <calculation class='tableau' formula='&quot;Time Between Contact And Promised Delivery Time Minutes&quot;' />
              <aliases>
                <alias key='&quot;helpcenter_automation_resolution&quot;' value='Helpcenter Automation Resolution' />
                <alias key='&quot;helpcenter_automation_type&quot;' value='Helpcenter Automation Type' />
                <alias key='&quot;order_status_at_contact_raw&quot;' value='Order Status At Contact' />
              </aliases>
            </column>
            <column caption='#Segments (Max 50)' datatype='integer' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='41'>
              <calculation class='tableau' formula='41' />
              <range max='50' min='1' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0c47mzy0dvrbpc1ex7ckp0piqs8i'>
            <column caption='P2P Initiated By' datatype='string' name='[Calculation_2512516013730054159]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_p2p_rider_chat] AND [is_p2p_rider_message_read]&#10;    THEN &quot;Rider Initiated and Read&quot;&#10;ELSEIF [is_p2p_rider_chat] AND [is_p2p_chat_missed_chat]&#10;    THEN &quot;Rider Initiated and Ignored&quot;&#10;ELSEIF [is_p2p_rider_chat] = FALSE AND [is_p2p_chat_missed_chat] = FALSE&#10;    THEN &quot;Customer Initiated and Read&quot;&#10;ELSEIF [is_p2p_rider_chat] = FALSE AND [is_p2p_chat_missed_chat]&#10;    THEN &quot;Customer Initiated and Ignored&quot;&#10;ELSE &quot;N/A&quot;&#10;END' />
            </column>
            <column caption='#Contacts with time diff between contact and cancellation' datatype='integer' name='[Calculation_2798846496436719620]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF ([time_between_contact_and_cancellation]) = &quot;After&quot; THEN [total_contacts] &#10;    ELSEIF ([time_between_contact_and_cancellation]) = &quot;Before&quot; THEN [total_contacts] &#10;    ELSEIF ([time_between_contact_and_cancellation]) = &quot;During&quot; THEN [total_contacts] &#10;END)' />
            </column>
            <column caption='Cancellation Reason Top Segment' datatype='string' name='[Calculation_2798846496456892428]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Cancellation Reason Set] THEN [cancellation_reason] ELSE &quot;Others&quot; END' />
            </column>
            <column caption='Canceled Status' datatype='string' name='[Calculation_4373206408658251822]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_order_cancelled]&lt;&gt;TRUE THEN &quot;Not Cancelled&quot;&#10;    ELSEIF ([time_between_contact_and_cancellation]) = &quot;After&quot; THEN &quot;Canceled After Contact&quot;&#10;    ELSEIF ([time_between_contact_and_cancellation]) = &quot;During&quot; THEN &quot;Canceled During Contact&quot;&#10;    ELSEIF ([time_between_contact_and_cancellation]) = &quot;Before&quot; THEN &quot;Canceled Before Contact&quot;&#10;ELSE &quot;N/A&quot;&#10;END' />
            </column>
            <column caption='Contact Reason Cluster' datatype='string' name='[Contact Reason Cluster (copy)_4373206408358666260]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([contact_reason_cluster]) THEN &quot;Unassigned&quot; ELSE [contact_reason_cluster] END' />
            </column>
            <column caption='Created Date' datatype='date' name='[Created Date (copy) (copy)_4373206408327352327]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[created_date]' />
            </column>
            <column caption='Date Range' datatype='date' name='[Created Date (copy)_4373206408320057349]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[Created Date (copy) (copy)_4373206408327352327]' />
            </column>
            <column caption='Relative Date' datatype='date' name='[Date Range (copy)_4373206408333262858]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[Created Date (copy) (copy)_4373206408327352327]' />
            </column>
            <column caption='Delivery Type' datatype='string' name='[Delivery Type (copy)_4373206408968511545]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([delivery_type]) THEN &quot;Unknown&quot; ELSE [delivery_type] END' />
            </column>
            <column caption='Select Dimension 3' datatype='string' name='[Dimension 4 (copy)_4373206408655405098]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Dimension 4 (copy)_4373206408654553128] = &apos;Time Between Contact And Promised Delivery Time Minutes&apos; THEN [time_between_contact_and_promised_delivery_time_minutes]&#10;    ELSEIF [Parameters].[Dimension 4 (copy)_4373206408654553128]= &apos;Order Status Before Contact&apos; THEN [order_status_before_contact]&#10;    ELSEIF [Parameters].[Dimension 4 (copy)_4373206408654553128] = &apos;Canceled Status&apos; THEN [Calculation_4373206408658251822]&#10;    ELSEIF [Parameters].[Dimension 4 (copy)_4373206408654553128] = &apos;order_status_at_contact_raw&apos; THEN [order_status_before_contact_raw]&#10;    ELSEIF [Parameters].[Dimension 4 (copy)_4373206408654553128] = &quot;Time between Order And Contact Creation  Minutes&quot; THEN [time_reference_order_placed_minutes]&#10;    ELSEIF [Parameters].[Dimension 4 (copy)_4373206408654553128] = &apos;Time Since Last Order Progress&apos; THEN [time_segment_between_contact_and_order_status_before]&#10;    ELSEIF [Parameters].[Dimension 4 (copy)_4373206408654553128] = &apos;P2P Initiated By&apos; THEN [Calculation_2512516013730054159]&#10;    ELSEIF [Parameters].[Dimension 4 (copy)_4373206408654553128] = &apos;P2P Interaction Type&apos; THEN [p2p_interaction_type]&#10;    ELSEIF [Parameters].[Dimension 4 (copy)_4373206408654553128] = &apos;helpcenter_automation_resolution&apos; THEN [helpcenter_automation_resolution]&#10;    ELSEIF [Parameters].[Dimension 4 (copy)_4373206408654553128] = &apos;helpcenter_automation_type&apos; THEN [helpcenter_automation_type]&#10;END' />
            </column>
