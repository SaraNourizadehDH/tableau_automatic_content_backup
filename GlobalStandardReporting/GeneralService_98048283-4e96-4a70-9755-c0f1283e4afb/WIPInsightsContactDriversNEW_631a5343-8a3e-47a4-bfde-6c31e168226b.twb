            <column caption='Delivery Type' datatype='string' name='[Delivery Type (copy)_4373206408968511545]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([delivery_type]) THEN &quot;Unknown&quot; ELSE [delivery_type] END' />
            </column>
            <column caption='Trend Details Dimension 1' datatype='string' name='[Dimension 3 (copy)_4373206408654602281]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Dimension 3 (copy)_4373206408651976738] = &apos;Time Between Contact And Promised Delivery Time Minutes&apos; THEN [time_between_contact_and_promised_delivery_time_minutes]&#10;    ELSEIF [Parameters].[Dimension 3 (copy)_4373206408651976738]= &apos;Order Status Before Contact&apos; THEN [order_status_before_contact]&#10;    ELSEIF [Parameters].[Dimension 3 (copy)_4373206408651976738] = &apos;Canceled Status&apos; THEN [Calculation_4373206408658251822]&#10;    ELSEIF [Parameters].[Dimension 3 (copy)_4373206408651976738] = &apos;order_status_at_contact_raw&apos; THEN [order_status_before_contact_raw]&#10;    ELSEIF [Parameters].[Dimension 3 (copy)_4373206408651976738] = &apos;Time between Order And Contact Creation  Minutes&apos; THEN [time_reference_order_placed_minutes]&#10;    ELSEIF [Parameters].[Dimension 3 (copy)_4373206408651976738] = &apos;Time Since Last Order Progress&apos; THEN [time_segment_between_contact_and_order_status_before]&#10;   // ELSEIF [Parameters].[Deep Dive Dimension 3] = &apos;P2P Initiated By&apos; THEN [P2P Initiated By]&#10;    //ELSEIF [Parameters].[Deep Dive Dimension 3] = &apos;P2P Interaction Type&apos; THEN [P2P Interaction Type]&#10;END' />
            </column>
            <column caption='Trend Details Dimension 1 Top Segments' datatype='string' name='[Dimension 3 Top Segments (copy)_4373206408655679531]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Dimension 4 Set]&#10; THEN [Dimension 3 (copy)_4373206408654602281] ELSE &quot;Others&quot; END' />
