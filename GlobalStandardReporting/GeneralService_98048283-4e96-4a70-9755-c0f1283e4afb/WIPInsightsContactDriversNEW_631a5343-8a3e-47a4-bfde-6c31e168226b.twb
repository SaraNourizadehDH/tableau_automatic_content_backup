      <aliases enabled='yes' />
      <column caption='% Contact with Comp &amp; Refund Triggered' datatype='real' name='[% Compensation Triggered During Contact  (copy)_4373206408605442075]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='SUM(IF ([is_order_compensated]  &#10;    OR  [is_order_refunded]) &#10;    AND [time_between_contact_and_refund_compensation] = &apos;During&apos;&#10;    THEN [total_contacts] &#10;END)&#10;/SUM([total_contacts])' />
      </column>
      <column caption='% Contact With Multiple Agent Action' datatype='real' name='[% Compensation&amp;Refund  Triggered During Contact (copy)_4373206408608419869]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='//SUM(IF [Has Multiple Agent Actions] THEN [Total Contacts] END)&#10;&#10;SUM(IF((is_order_refunded or is_order_compensated) &#10;    AND time_between_contact_and_refund_compensation = &apos;During&apos;) &#10;    AND (is_order_cancelled and time_between_contact_and_cancellation =&apos;During&apos;) THEN [total_contacts] &#10;END)&#10;/SUM([total_contacts])' />
      </column>
      <column caption='# Contact with Comp &amp; Refund Triggered' datatype='integer' name='[% Contact with Comp &amp; Refund Triggered (copy) (copy)_2512516013716951054]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF ([is_order_compensated]  &#10;    OR  [is_order_refunded]) &#10;    THEN [total_contacts] &#10;END)' />
      </column>
      <column caption='# Contact with Comp &amp; Refund Triggered During Contact' datatype='integer' name='[% Contact with Comp &amp; Refund Triggered (copy)_2512516013706219531]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF ([is_order_compensated]  &#10;    OR  [is_order_refunded]) &#10;    AND [time_between_contact_and_refund_compensation] = &apos;During&apos; &#10;    THEN [total_contacts] &#10;END)' />
      </column>
      <column caption='# Contact with Comp &amp; Refund Triggered Before Contact' datatype='integer' name='[% Contact with Comp &amp; Refund Triggered During Contact (copy)_2512516013708840972]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF ([is_order_compensated]  &#10;    OR  [is_order_refunded]) &#10;    AND [time_between_contact_and_refund_compensation] = &apos;Before&apos; &#10;    THEN [total_contacts] &#10;END)' />
      </column>
      <column caption='%No Action Triggered ' datatype='real' name='[%No Action Triggered (copy)_4373206408610668575]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='//SUM(IF [Has No Agent Action] THEN [Total Contacts] END)/SUM([Total Contacts])//&#10;&#10;SUM(IF ((is_order_refunded = FALSE AND is_order_compensated = FALSE) &#10;    OR time_between_contact_and_refund_compensation &lt;&gt; &apos;During&apos;) &#10;AND (is_order_cancelled = FALSE OR time_between_contact_and_cancellation &lt;&gt;&apos;During&apos;) &#10;    THEN [total_contacts] END)&#10;/SUM([total_contacts])' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0c47mzy0dvrbpc1ex7ckp0piqs8i].[pcto:sum:total_contacts:qk:1]&quot;' value='%Contacts Share' />
          <alias key='&quot;[federated.0c47mzy0dvrbpc1ex7ckp0piqs8i].[pcto:sum:total_contacts:qk:6]&quot;' value='% Contacts Share across Management Entity Group' />
          <alias key='&quot;[federated.0c47mzy0dvrbpc1ex7ckp0piqs8i].[sum:total_contacts:qk]&quot;' value='#Total Contacts' />
          <alias key='&quot;[federated.0c47mzy0dvrbpc1ex7ckp0piqs8i].[usr:\% Compensation Triggered During Contact  (copy)_4373206408605442075:qk]&quot;' value='%Contacts with Comp &amp; Refund Triggered' />
          <alias key='&quot;[federated.0c47mzy0dvrbpc1ex7ckp0piqs8i].[usr:\% Compensation&amp;Refund  Triggered During Contact (copy)_4373206408608419869:qk]&quot;' value='%Contacts With Multiple Agent Action' />
          <alias key='&quot;[federated.0c47mzy0dvrbpc1ex7ckp0piqs8i].[usr:Time Between Contact And Cancellation (copy)_4373206408601423896:qk]&quot;' value='%Order Cancellation During Contact' />
        </aliases>
      </column>
      <column caption='is_post_threshold' datatype='boolean' name='[Calculation_195906614596726790]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Created Date (copy) (copy)_4373206408327352327] &gt;= [Parameters].[Parameter 1 1]' />
      </column>
      <column caption='P2P Initiated By' datatype='string' name='[Calculation_2512516013730054159]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_p2p_rider_chat] AND [is_p2p_rider_message_read]&#10;    THEN &quot;Rider Initiated and Read&quot;&#10;ELSEIF [is_p2p_rider_chat] AND [is_p2p_chat_missed_chat]&#10;    THEN &quot;Rider Initiated and Ignored&quot;&#10;ELSEIF [is_p2p_rider_chat] = FALSE AND [is_p2p_chat_missed_chat] = FALSE&#10;    THEN &quot;Customer Initiated and Read&quot;&#10;ELSEIF [is_p2p_rider_chat] = FALSE AND [is_p2p_chat_missed_chat]&#10;    THEN &quot;Customer Initiated and Ignored&quot;&#10;ELSE &quot;N/A&quot;&#10;END' />
      </column>
      <column caption='Dot Indicator' datatype='integer' name='[Calculation_2512516013777743894]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF MAX([created_date]) = WINDOW_MAX(MAX([created_date])) THEN SUM([total_contacts]) END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Dot Color' datatype='boolean' name='[Calculation_2512516013780013079]' role='measure' type='nominal'>
        <calculation class='tableau' formula='WINDOW_MAX(IF LAST() = 0 THEN SUM([total_contacts]) END)&#10;&gt;&#10;WINDOW_MAX(IF LAST() = 1 THEN SUM([total_contacts]) END)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Label' datatype='string' name='[Calculation_2519201103038017536]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Label&quot;' />
      </column>
      <column caption='#Contacts with time diff between contact and cancellation' datatype='integer' name='[Calculation_2798846496436719620]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF ([time_between_contact_and_cancellation]) = &quot;After&quot; THEN [total_contacts] &#10;    ELSEIF ([time_between_contact_and_cancellation]) = &quot;Before&quot; THEN [total_contacts] &#10;    ELSEIF ([time_between_contact_and_cancellation]) = &quot;During&quot; THEN [total_contacts] &#10;END)' />
      </column>
      <column caption='Cancellation Reason Top Segment' datatype='string' name='[Calculation_2798846496456892428]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Cancellation Reason Set] THEN [cancellation_reason] ELSE &quot;Others&quot; END' />
      </column>
      <column caption='is_current_date' datatype='boolean' name='[Calculation_4373206408318910464]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;day&apos;,[Created Date (copy) (copy)_4373206408327352327]) = &#10;    {MAX(DATETRUNC(&apos;day&apos;,[Created Date (copy) (copy)_4373206408327352327]))}' />
      </column>
      <column caption='is_prev_date' datatype='boolean' name='[Calculation_4373206408319291394]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;day&apos;,[Created Date (copy) (copy)_4373206408327352327]) = &#10;&#10;{MAX(DATETRUNC(&apos;day&apos;,[Created Date (copy) (copy)_4373206408327352327]))} - 1' />
      </column>
      <column caption='Date Granularity' datatype='string' name='[Calculation_4373206408319934468]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Created Date&quot; THEN STR([Created Date (copy) (copy)_4373206408327352327])&#10;WHEN &quot;Created Week&quot; THEN [created_week]&#10;WHEN &quot;Created Month&quot; THEN [created_month]&#10;WHEN &quot;Created Quarter&quot; THEN [created_quarter]&#10;WHEN &quot;Created Year&quot; THEN [created_year]&#10;END' />
      </column>
      <column caption='is_current_year' datatype='boolean' name='[Calculation_4373206408329469960]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{FIXED [created_year]: MAX([Created Date (copy) (copy)_4373206408327352327])} = {FIXED: MAX([Created Date (copy) (copy)_4373206408327352327])}' />
      </column>
      <column caption='Dimension 1' datatype='string' name='[Calculation_4373206408352604176]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Management Entity Group&apos; THEN [management_entity_group]&#10;    ELSEIF [Parameters].[Parameter 4]= &apos;Global Entity Id&apos; THEN [global_entity_id]&#10;END' />
      </column>
      <column caption='Dimension 1 Top Segments' datatype='string' name='[Calculation_4373206408355049490]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Dimension 1 Set]&#10; THEN [Calculation_4373206408352604176] ELSE &quot;Others&quot; END' />
      </column>
      <column aggregation='Attribute' caption='Current Conatcts' datatype='integer' name='[Calculation_4373206408566362133]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Created Date&apos;&#10;then &#10;{ EXCLUDE [Calculation_4373206408319934468]:&#10;    SUM(&#10;    IF [Calculation_4373206408318910464]&#10;    THEN [total_contacts]&#10;    END&#10;    )&#10;&#10;&#10;}&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Created Week&apos;&#10;THEN &#10;{ EXCLUDE [Calculation_4373206408319934468]:&#10;    SUM(&#10;    IF [is_current_date (copy)_4373206408319094785]&#10;    THEN [total_contacts]&#10;    END&#10;    )&#10;}&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Created Month&apos;&#10;THEN &#10;{ EXCLUDE [Calculation_4373206408319934468]:&#10;    SUM(&#10;    IF [is_current_year (copy)_4373206408329547785]&#10;    THEN [total_contacts]&#10;    END&#10;    )&#10;}&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Created Quarter&apos;&#10;THEN &#10;{ EXCLUDE [Calculation_4373206408319934468]:&#10;    SUM(&#10;    IF [is_current_year (copy)_4373206408566624278]&#10;    THEN [total_contacts]&#10;    END&#10;    )&#10;}&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Created Year&apos;&#10;THEN &#10;{ EXCLUDE [Calculation_4373206408319934468]:&#10;    SUM(&#10;    IF [Calculation_4373206408329469960]&#10;    THEN [total_contacts]&#10;    END&#10;    )&#10;}&#10;END' />
      </column>
      <column caption='Top And bottom' datatype='boolean' name='[Calculation_4373206408652406819]' role='measure' type='nominal'>
        <calculation class='tableau' formula='RANK( SUM( [total_contacts] ), &apos;desc&apos; ) &lt;= [Parameters].[Parameter 2]&#10;&#10;OR&#10;&#10;RANK( SUM( [total_contacts] ), &apos;asc&apos; ) &lt;= [Parameters].[Parameter 2]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Canceled Status' datatype='string' name='[Calculation_4373206408658251822]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_order_cancelled]&lt;&gt;TRUE THEN &quot;Not Cancelled&quot;&#10;    ELSEIF ([time_between_contact_and_cancellation]) = &quot;After&quot; THEN &quot;Canceled After Contact&quot;&#10;    ELSEIF ([time_between_contact_and_cancellation]) = &quot;During&quot; THEN &quot;Canceled During Contact&quot;&#10;    ELSEIF ([time_between_contact_and_cancellation]) = &quot;Before&quot; THEN &quot;Canceled Before Contact&quot;&#10;ELSE &quot;N/A&quot;&#10;END' />
      </column>
