            <column caption='Canceled Status' datatype='string' name='[Calculation_4373206408658251822]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_order_cancelled]&lt;&gt;TRUE THEN &quot;Not Cancelled&quot;&#10;    ELSEIF ([time_between_contact_and_cancellation]) = &quot;After&quot; THEN &quot;Canceled After Contact&quot;&#10;    ELSEIF ([time_between_contact_and_cancellation]) = &quot;During&quot; THEN &quot;Canceled During Contact&quot;&#10;    ELSEIF ([time_between_contact_and_cancellation]) = &quot;Before&quot; THEN &quot;Canceled Before Contact&quot;&#10;ELSE &quot;N/A&quot;&#10;END' />
            </column>
