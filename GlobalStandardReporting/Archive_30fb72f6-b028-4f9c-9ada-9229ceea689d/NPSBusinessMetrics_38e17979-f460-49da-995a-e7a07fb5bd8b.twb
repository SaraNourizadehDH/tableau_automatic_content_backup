                <relation connection='bigquery.1saaprg1y9p06110z4bdh09j9phc (copy)' name='Custom SQL Query' type='text'>with nps_final as
(WITH nps_2 as
(with cleaned as
(with nps_1 as
(with entities as
(SELECT DATE_TRUNC(DATE(recorded_at_utc),MONTH) as nps_month,
management_entity_group as management_entity,
global_entity_id, shop_id,
COALESCE(REGEXP_EXTRACT(va.shop_id  ,r&apos;;(.*)&apos;),shop_id) AS vendor_id

,va.nps_score FROM `fulfillment-dwh-production.cl_vendor.qualtrics_responses_existing_vendor` as va  
WHERE management_entity_group IN (&apos;Foodpanda APAC&apos;,&apos;Pedidosya&apos;,&apos;Talabat&apos;) and global_entity_id NOT IN (&apos;PY_CL&apos;,&apos;FP_JP&apos;)) 
SELECT nps_month,
management_entity,global_entity_id,shop_id,vendor_id,nps_score
from entities 
WHERE vendor_id NOT IN (&apos;undefined&apos;) )

SELECT management_entity,global_entity_id,shop_id,nps_month, CASE
        WHEN REGEXP_CONTAINS(vendor_id, &apos;_&apos; ) THEN NULL ELSE vendor_id END AS vendors,nps_score
FROM nps_1
WHERE vendor_id NOT IN (&apos;undefined&apos;) and management_entity IN (&apos;Foodpanda APAC&apos;,&apos;Talabat&apos;,&apos;Pedidosya&apos; ))

 SELECT management_entity,global_entity_id,shop_id,nps_month,nps_score,vendors,
 CASE WHEN vendors IS NULL THEN LEFT(shop_id,4 ) ELSE vendors END as vendors_cleaned
FROM cleaned)

SELECT management_entity,global_entity_id,nps_month,nps_score,vendors_cleaned
FROM nps_2) , 

orders as 
(SELECT vkm.report_month,vkm.global_entity_id
,vkm.vendor_id,CASE WHEN vkm.successful_orders BETWEEN 1 AND 29 THEN &apos;low&apos; WHEN vkm.successful_orders BETWEEN 30 AND 99 THEN &apos;normal&apos; WHEN 
 vkm.successful_orders= 0 THEN &apos;zombie&apos; when vkm.successful_orders&gt;&gt;= 100 THEN &apos;high&apos; END as order_group,vkm.vendor_class
 FROM `fulfillment-dwh-production.curated_data_shared_coredata_business.agg_vendor_kpis_monthly` as vkm 
WHERE vkm.report_month &gt;&gt;=&apos;2021-06-01&apos; and is_online is true) 

SELECT nps_month,order_group,vendor_class,n.management_entity,n.global_entity_id,nps_score,count(distinct n.vendors_cleaned) as vendors
FROM nps_final as n
JOIN orders as o
ON o.report_month=n.nps_month AND n.vendors_cleaned=o.vendor_id and n.global_entity_id=o.global_entity_id 
GROUP BY 1,2,3,4,5,6</relation>
                <relation connection='bigquery.1saaprg1y9p06110z4bdh09j9phc (copy)' name='tableau_gsr_entitlements_global_entity_id' table='[fulfillment-dwh-production.curated_data_shared_govops].[tableau_gsr_entitlements_global_entity_id]' type='table' />
              </relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='Custom SQL Query+ (curated_data_shared_govops)' inline='true' name='federated.1ikh0xh0y5my2q13ru7pz1mflkje' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1wlhflv1po071d14f4yr002dudnl'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhh-ncr-stg' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='curated_data_shared_govops' server-oauth='' username='beyazit.egilli@deliveryhero.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation join='inner' type='join'>
          <clause type='join'>
            <expression op='='>
              <expression op='[Custom SQL Query].[global_entity_id]' />
              <expression op='[tableau_gsr_entitlements_global_entity_id].[global_entity_id]' />
            </expression>
          </clause>
          <relation connection='bigquery.1wlhflv1po071d14f4yr002dudnl' name='Custom SQL Query' type='text'>WITH nps_final AS (
  WITH nps_2 AS (
    WITH cleaned AS (
      WITH nps_1 AS (
        WITH entities AS (
          SELECT
            DATE_TRUNC(DATE(recorded_at_utc),MONTH) AS nps_month,
            management_entity_group AS management_entity,
            global_entity_id,
            shop_id,
            COALESCE(REGEXP_EXTRACT(va.shop_id,r&apos;;(.*)&apos;),shop_id) AS vendor_id,
            va.nps_score
          FROM `fulfillment-dwh-production.cl_vendor.qualtrics_responses_existing_vendor` AS va
          WHERE
            management_entity_group IN (&apos;Foodpanda APAC&apos;,&apos;Pedidosya&apos;,&apos;Talabat&apos;)
            AND global_entity_id NOT IN (&apos;PY_CL&apos;,&apos;FP_JP&apos;)
        )
        SELECT
          nps_month,
          management_entity,
          global_entity_id,
          shop_id,
          vendor_id,
          nps_score
        FROM entities
        WHERE vendor_id NOT IN (&apos;undefined&apos;)
      )
      SELECT
        management_entity,
        global_entity_id,
        shop_id,
        nps_month,
        CASE WHEN REGEXP_CONTAINS(vendor_id, &apos;_&apos; ) THEN NULL
        ELSE vendor_id
        END AS vendors,
        nps_score
      FROM nps_1
      WHERE
        vendor_id NOT IN (&apos;undefined&apos;)
        AND management_entity IN (&apos;Foodpanda APAC&apos;,&apos;Talabat&apos;,&apos;Pedidosya&apos;)
    )
    SELECT
      management_entity,
      global_entity_id,
      shop_id,
      nps_month,
      nps_score,
      vendors,
      CASE WHEN vendors IS NULL THEN LEFT(shop_id, 4)
      ELSE vendors
      END AS vendors_cleaned
    FROM cleaned
  )
  SELECT
    management_entity,
    global_entity_id,
    nps_month,
    nps_score,
    vendors_cleaned
  FROM nps_2
),
cpc AS (
  SELECT
    date_month AS cpc_month,
    cpc.global_entity_id,
    cpc.vendor_id,
  FROM
    dhh-ncr-live.analytics.ad_tech_il_cpc AS cpc
    group by 1,2,3
)
SELECT
  cpc_month,
  nps_month,
  management_entity,
  cpc.global_entity_id,
  nps_score,
  COUNT(DISTINCT vendors_cleaned) AS vendors
FROM cpc
JOIN nps_final as n
ON
cpc.global_entity_id=n.global_entity_id
AND cpc.vendor_id=n.vendors_cleaned
WHERE
  cpc_month &gt;&gt;=&apos;2021-06-01&apos;
  AND nps_month BETWEEN cpc_month
  AND DATE_SUB(cpc_month, INTERVAL -3 MONTH)
GROUP BY 1,2,3,4,5</relation>
