          <named-connection caption='BigQuery' name='bigquery.1fi5g820c3xb7f13241gl00bi5a5'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhh-ncr-stg' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='cl_sales_revenue' server-oauth='' username='beyazit.egilli@deliveryhero.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation join='inner' type='join'>
          <clause type='join'>
            <expression op='='>
              <expression op='[Custom SQL Query].[global_entity_id]' />
              <expression op='[tableau_gsr_entitlements_global_entity_id].[global_entity_id]' />
            </expression>
          </clause>
          <relation connection='bigquery.1fi5g820c3xb7f13241gl00bi5a5' name='Custom SQL Query' type='text'>WITH nps_final AS (
  WITH nps_2 AS (
    WITH cleaned AS (
      WITH nps_1 AS (
        WITH entities AS (
          SELECT
            DATE_TRUNC(DATE(recorded_at_utc),MONTH) AS nps_month,
            management_entity_group AS management_entity,
            global_entity_id,
            shop_id,
            COALESCE(REGEXP_EXTRACT(va.shop_id,r&apos;;(.*)&apos;),shop_id) AS vendor_id,
            va.nps_score
          FROM `fulfillment-dwh-production.cl_vendor.qualtrics_responses_existing_vendor` AS va
          WHERE
            management_entity_group IN (&apos;Foodpanda APAC&apos;,&apos;Pedidosya&apos;,&apos;Talabat&apos;)
            AND global_entity_id NOT IN (&apos;PY_CL&apos;,&apos;FP_JP&apos;)
        )
        SELECT
          nps_month,
          management_entity,
          global_entity_id,
          shop_id,
          vendor_id,
          nps_score
        FROM entities
        WHERE vendor_id NOT IN (&apos;undefined&apos;)
      )
      SELECT
        management_entity,
        global_entity_id,
        shop_id,
        nps_month,
        CASE WHEN REGEXP_CONTAINS(vendor_id, &apos;_&apos; ) THEN NULL
        ELSE vendor_id
        END AS vendors,
        nps_score
      FROM nps_1
      WHERE
        vendor_id NOT IN (&apos;undefined&apos;)
        AND management_entity IN (&apos;Foodpanda APAC&apos;,&apos;Talabat&apos;,&apos;Pedidosya&apos;)
    )
    SELECT
      management_entity,
      global_entity_id,
      shop_id,
      nps_month,
      nps_score,
      vendors,
      CASE WHEN vendors IS NULL THEN LEFT(shop_id, 4)
      ELSE vendors
      END AS vendors_cleaned
    FROM cleaned
  )
  SELECT
    management_entity,
    global_entity_id,
    nps_month,
    nps_score,
    vendors_cleaned
  FROM nps_2
),
cpp AS (
  SELECT
    date_month AS cpp_month,
    cpp.global_entity_id,
    cpp.vendor_id,
  FROM
    dhh-ncr-live.analytics.ad_tech_il_cpp AS cpp
    group by 1,2,3
)
SELECT
  cpp_month,
  nps_month,
  management_entity,
  cpp.global_entity_id,
  nps_score,
  COUNT(DISTINCT vendors_cleaned) AS vendors
FROM cpp
JOIN nps_final as n
ON
cpp.global_entity_id=n.global_entity_id
AND cpp.vendor_id=n.vendors_cleaned
WHERE
  cpp_month &gt;&gt;=&apos;2021-06-01&apos;
  AND nps_month BETWEEN cpp_month
  AND DATE_SUB(cpp_month, INTERVAL -3 MONTH)
GROUP BY 1,2,3,4,5</relation>
          <relation connection='bigquery.1fi5g820c3xb7f13241gl00bi5a5' name='tableau_gsr_entitlements_global_entity_id' table='[fulfillment-dwh-production.curated_data_shared_govops].[tableau_gsr_entitlements_global_entity_id]' type='table' />
        </_.fcp.ObjectModelEncapsulateLegacy.false...relation>
