      <column caption='Promoters' datatype='integer' name='[Calculation_1815443266400923648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [nps_score] &gt;8 THEN [vendors] END)' />
      </column>
      <column caption='Detractors' datatype='integer' name='[Calculation_1815443266401226753]' role='measure' type='quantitative'>
