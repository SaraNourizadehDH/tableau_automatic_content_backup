              <calculation class='tableau' formula='SUM([no_response_out_of_budget])/ SUM(&#10;[winning_campaign]&#10;+[no_response_inactive_campaign]&#10;+ [no_response_productsnotfound] &#10;+ [active_campaign] &#10;+[products_not_found]&#10;+ [inactive_campaign]&#10;+[out_of_budget]&#10;+[no_response_out_of_budget]&#10;)' />
            </column>
            <column caption='% No_Response_Inactive_Campaign' datatype='real' name='[% Active  Campaign (copy) (copy) (copy) (copy) (copy)_147774399185952773]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_response_inactive_campaign])/ SUM(&#10;[winning_campaign]&#10;+[no_response_inactive_campaign]&#10;+ [no_response_productsnotfound] &#10;+ [active_campaign] &#10;+[products_not_found]&#10;+ [inactive_campaign]&#10;+[out_of_budget]&#10;+[no_response_out_of_budget]&#10;)' />
