    <worksheet name='Click vs Impressions'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff'>CTR-Impression Share</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='_qcpa_dh_ads_adengine_performance (cl_dmart)' name='federated.05sbinp1tyedor15n77jb03chwr3' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Select' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
              <calculation class='tableau' formula='&quot;Day&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.05sbinp1tyedor15n77jb03chwr3'>
            <column caption='Datetime' datatype='datetime' name='[Calculation_582442124524773377]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETIME( STR([stamp_date]) + &quot; &quot; + [hour] + &apos;:00:00&apos;)' />
            </column>
            <column caption='Date Selection' datatype='string' name='[Calculation_582442125679353867]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10; WHEN &apos;Month&apos; THEN DATENAME(&apos;month&apos;, [stamp_date]) + &apos; &apos; + STR(DATEPART(&apos;year&apos;, [stamp_date]))&#10;WHEN &apos;Week&apos; THEN &apos;W&apos; + STR(DATEPART(&apos;week&apos;, [stamp_date])) + &apos; &apos; + STR(DATEPART(&apos;year&apos;, [stamp_date]))&#10;WHEN &apos;Day&apos; THEN STR([stamp_date])&#10;WHEN &apos;Hour&apos; THEN STR([hour])&#10;END' />
            </column>
            <column caption='CTR' datatype='real' name='[Calculation_582442125685415948]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([clicks])/SUM([impressions])' />
            </column>
            <column caption='Total Impressions' datatype='integer' name='[Calculation_6906199692373012481]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Calculation_582442125679353867],[category_english]: SUM([impressions])}' />
            </column>
            <column caption='Impression Share' datatype='real' name='[Calculation_6906199692411326471]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([impressions])/sum([Calculation_6906199692373012481])' />
