              <calculation class='tableau' formula='SUM([no_response_productsnotfound])/ SUM(&#10;[winning_campaign]&#10;+[no_response_inactive_campaign]&#10;+ [no_response_productsnotfound] &#10;+ [active_campaign] &#10;+[products_not_found]&#10;+ [inactive_campaign]&#10;+[out_of_budget]&#10;+[no_response_out_of_budget]&#10;)' />
