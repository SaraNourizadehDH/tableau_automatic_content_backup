      <aliases enabled='yes' />
      <column caption='% No_Response_ProductsNotFound' datatype='real' name='[% Active  Campaign (copy) (copy) (copy) (copy) (copy) (copy 2)_147774399188672520]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([no_response_productsnotfound])/ SUM(&#10;[winning_campaign]&#10;+[no_response_inactive_campaign]&#10;+ [no_response_productsnotfound] &#10;+ [active_campaign] &#10;+[products_not_found]&#10;+ [inactive_campaign]&#10;+[out_of_budget]&#10;+[no_response_out_of_budget]&#10;)' />
      </column>
      <column caption='% No_Response_OutofBudget' datatype='real' name='[% Active  Campaign (copy) (copy) (copy) (copy) (copy) (copy)_147774399185960966]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([no_response_out_of_budget])/ SUM(&#10;[winning_campaign]&#10;+[no_response_inactive_campaign]&#10;+ [no_response_productsnotfound] &#10;+ [active_campaign] &#10;+[products_not_found]&#10;+ [inactive_campaign]&#10;+[out_of_budget]&#10;+[no_response_out_of_budget]&#10;)' />
      </column>
      <column caption='% No_Response_Inactive_Campaign' datatype='real' name='[% Active  Campaign (copy) (copy) (copy) (copy) (copy)_147774399185952773]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([no_response_inactive_campaign])/ SUM(&#10;[winning_campaign]&#10;+[no_response_inactive_campaign]&#10;+ [no_response_productsnotfound] &#10;+ [active_campaign] &#10;+[products_not_found]&#10;+ [inactive_campaign]&#10;+[out_of_budget]&#10;+[no_response_out_of_budget]&#10;)' />
      </column>
      <column caption='% InactiveCampaign' datatype='real' name='[% Active  Campaign (copy) (copy) (copy) (copy)_147774399185940484]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([inactive_campaign])/ SUM(&#10;[winning_campaign]&#10;+[no_response_inactive_campaign]&#10;+ [no_response_productsnotfound] &#10;+ [active_campaign] &#10;+[products_not_found]&#10;+ [inactive_campaign]&#10;+[out_of_budget]&#10;+[no_response_out_of_budget]&#10;)' />
      </column>
      <column caption='% OutofBudget' datatype='real' name='[% Active  Campaign (copy) (copy) (copy)_147774399185932291]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([out_of_budget])/ SUM(&#10;[winning_campaign]&#10;+[no_response_inactive_campaign]&#10;+ [no_response_productsnotfound] &#10;+ [active_campaign] &#10;+[products_not_found]&#10;+ [inactive_campaign]&#10;+[out_of_budget]&#10;+[no_response_out_of_budget]&#10;)' />
      </column>
      <column caption='% ProductsNotFound' datatype='real' name='[% Active  Campaign (copy) (copy)_147774399185920002]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([products_not_found])/ SUM(&#10;[winning_campaign]&#10;+[no_response_inactive_campaign]&#10;+ [no_response_productsnotfound] &#10;+ [active_campaign]&#10;+[products_not_found]&#10;+ [inactive_campaign]&#10;+[out_of_budget]&#10;+[no_response_out_of_budget]&#10;)' />
      </column>
      <column caption='% Winning campaing' datatype='real' name='[% Active  Campaign (copy)_147774399185899521]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([winning_campaign])/ SUM(&#10;[winning_campaign]&#10;+[no_response_inactive_campaign]&#10;+ [no_response_productsnotfound] &#10;+ [active_campaign] &#10;+[products_not_found]&#10;+ [inactive_campaign]&#10;+[out_of_budget]&#10;+[no_response_out_of_budget]&#10;)' />
      </column>
      <column caption='% Failed Auction' datatype='real' name='[% Successful Auction (copy) (copy)_147774399190016012]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([no_response_inactive_campaign]+[no_response_out_of_budget]&#10;+[no_response_productsnotfound])/ SUM(&#10;[winning_campaign]&#10;+[no_response_inactive_campaign]&#10;+ [no_response_productsnotfound] &#10;+ [active_campaign] &#10;+[products_not_found]&#10;+ [inactive_campaign]&#10;+[out_of_budget]&#10;+[no_response_out_of_budget]&#10;+[no_auction]&#10;)' />
      </column>
      <column caption='% No Auction' datatype='real' name='[% Successful Auction (copy)_147774399189999627]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([no_auction])/ SUM(&#10;[winning_campaign]&#10;+[no_response_inactive_campaign]&#10;+ [no_response_productsnotfound] &#10;+ [active_campaign] &#10;+[products_not_found]&#10;+ [inactive_campaign]&#10;+[out_of_budget]&#10;+[no_response_out_of_budget]&#10;+[no_auction]&#10;)' />
      </column>
      <column caption='% Successful Auction' datatype='real' name='[% Winning campaing (copy)_147774399189704714]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([active_campaign]+[winning_campaign]&#10;+[products_not_found]+[out_of_budget]+[inactive_campaign])&#10;&#10;/ SUM(&#10;[winning_campaign]&#10;+[no_response_inactive_campaign]&#10;+ [no_response_productsnotfound] &#10;+ [active_campaign] &#10;+[products_not_found]&#10;+ [inactive_campaign]&#10;+[out_of_budget]&#10;+[no_response_out_of_budget]&#10;+[no_auction]&#10;)' />
      </column>
      <column caption='Datetime' datatype='datetime' name='[Calculation_582442124524773377]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETIME( STR([stamp_date]) + &quot; &quot; + [hour] + &apos;:00:00&apos;)' />
      </column>
      <column caption='Metric' datatype='integer' name='[Calculation_582442124528603138]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Impressions&quot; THEN [impressions]&#10;WHEN &quot;Clicks&quot; THEN [clicks]&#10;&#10;END' />
      </column>
      <column caption='Participation' datatype='integer' name='[Calculation_582442124552802308]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[position_1] + [position_2] + [position_3]' />
      </column>
      <column caption='% Active  Campaign' datatype='real' name='[Calculation_582442124601561094]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([active_campaign])/ SUM(&#10;[winning_campaign]&#10;+[no_response_inactive_campaign]&#10;+ [no_response_productsnotfound] &#10;+ [active_campaign] &#10;+[products_not_found]&#10;+ [inactive_campaign]&#10;+[out_of_budget]&#10;+[no_response_out_of_budget]&#10;)' />
      </column>
      <column caption='Date Selection' datatype='string' name='[Calculation_582442125679353867]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10; WHEN &apos;Month&apos; THEN DATENAME(&apos;month&apos;, [stamp_date]) + &apos; &apos; + STR(DATEPART(&apos;year&apos;, [stamp_date]))&#10;WHEN &apos;Week&apos; THEN &apos;W&apos; + STR(DATEPART(&apos;week&apos;, [stamp_date])) + &apos; &apos; + STR(DATEPART(&apos;year&apos;, [stamp_date]))&#10;WHEN &apos;Day&apos; THEN STR([stamp_date])&#10;WHEN &apos;Hour&apos; THEN STR([hour])&#10;END' />
      </column>
      <column caption='CTR' datatype='real' name='[Calculation_582442125685415948]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([clicks])/SUM([impressions])' />
      </column>
      <column caption='Total Impressions' datatype='integer' name='[Calculation_6906199692373012481]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Calculation_582442125679353867],[category_english]: SUM([impressions])}' />
      </column>
      <column caption='Impression Share' datatype='real' name='[Calculation_6906199692411326471]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([impressions])/sum([Calculation_6906199692373012481])' />
      </column>
