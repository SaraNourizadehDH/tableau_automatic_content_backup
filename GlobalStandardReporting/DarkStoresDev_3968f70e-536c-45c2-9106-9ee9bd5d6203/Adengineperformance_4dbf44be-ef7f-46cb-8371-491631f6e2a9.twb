            <column caption='% InactiveCampaign' datatype='real' name='[% Active  Campaign (copy) (copy) (copy) (copy)_147774399185940484]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([inactive_campaign])/ SUM(&#10;[winning_campaign]&#10;+[no_response_inactive_campaign]&#10;+ [no_response_productsnotfound] &#10;+ [active_campaign] &#10;+[products_not_found]&#10;+ [inactive_campaign]&#10;+[out_of_budget]&#10;+[no_response_out_of_budget]&#10;)' />
            </column>
            <column caption='% OutofBudget' datatype='real' name='[% Active  Campaign (copy) (copy) (copy)_147774399185932291]' role='measure' type='quantitative'>
