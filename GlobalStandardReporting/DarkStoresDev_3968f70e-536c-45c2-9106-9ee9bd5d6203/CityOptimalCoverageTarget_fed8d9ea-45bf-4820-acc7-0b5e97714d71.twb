      <aliases enabled='yes' />
      <column caption='Avg no of order per City' datatype='real' name='[Avg no of order per region (copy)_2885962938208444419]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orderz])/COUNTD([warehouse_id])' />
      </column>
      <column caption='iso_c' datatype='integer' name='[Calculation_1504554178200342528]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([iso_date])' />
      </column>
      <column caption='sum of order within the parameter ramge provided' datatype='integer' name='[Calculation_1713478986434293763]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='SUM(IF [iso_date] &gt;= [Parameters].[Parameter 1] AND [iso_date] &lt;= [Parameters].[Parameter 2] THEN [orderz] ELSE 0 END)' />
      </column>
      <column caption='order at city level, used fixed, depends on the parameter' datatype='integer' name='[Calculation_1713478986436685830]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [city]: [Calculation_1713478986434293763]}' />
      </column>
      <column caption='Business day' datatype='string' name='[Calculation_1713478986449260554]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEPART(&apos;weekday&apos;,[iso_date]) = 1 THEN &quot;Sunday&quot; ELSEIF&#10; DATEPART(&apos;weekday&apos;,[iso_date]) = 7 THEN &quot;Saturday&quot; ELSE &quot;&quot; END' />
      </column>
      <column caption='ZN' datatype='integer' name='[Calculation_257549657340145665]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(LOOKUP(SUM([orderz]),0))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Number of warehouses with zero orders' datatype='integer' name='[Calculation_257549657347575810]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Calculation_257549657340145665] WHEN 0 THEN 1 ELSE 0 END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='sum of ZN' datatype='integer' name='[Calculation_257549657376870403]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_257549657347575810]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Avg # of orders' datatype='real' name='[Calculation_2787657802571096064]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orderz])/COUNTD([warehouse_id])' />
      </column>
      <column caption='No of City' datatype='string' name='[Calculation_2787657802577854465]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATE([iso_date]) = DATE([order_date]) THEN &quot;YES&quot; ELSE &quot;NO&quot; END' />
      </column>
      <column caption='No of warehouses' datatype='integer' name='[Calculation_2885962938199773184]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([warehouse_id])' />
      </column>
      <column caption='Region &amp; Country &amp; City' datatype='string' name='[Calculation_2885962938485751814]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='UPPER(LEFT([region],2)) + &quot; - &quot; + UPPER(LEFT([country_name],2)) + &quot; - &quot; + [city]' />
      </column>
      <column caption='# of stores' datatype='integer' name='[Calculation_4315152183480799232]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([warehouse_id])' />
      </column>
      <column caption='Avg platform covered mau per city' datatype='real' name='[Calculation_4807451867308302336]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dmart_covered_mau])/COUNTD([warehouse_id (e_c)])' />
      </column>
      <column caption='AVG dmart mau per city' datatype='real' name='[Calculation_4807451867309236225]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dmart_mau])/COUNTD([warehouse_id (e_c)])' />
      </column>
      <column caption='Avg dmart penetration Per City' datatype='real' name='[Calculation_4807451867309522946]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_4807451867309236225]/[Calculation_4807451867308302336]' />
      </column>
      <column caption='Country name   ' datatype='string' name='[Country name (copy)_2885962938479108100]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
