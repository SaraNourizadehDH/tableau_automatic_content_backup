    <worksheet name='AVG ORDER PROGRESSION OVER TIME GRAPH'>
      <table>
        <view>
          <datasources>
            <datasource caption='RAW (order purchasing trend)' name='federated.1dqv7dw0ck9uro1fagbdu0zhl6ua' />
          </datasources>
          <datasource-dependencies datasource='federated.1dqv7dw0ck9uro1fagbdu0zhl6ua'>
            <column caption='Avg # of orders' datatype='real' name='[Calculation_2787657802571096064]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orderz])/COUNTD([warehouse_id])' />
            </column>
            <column caption='No of City' datatype='string' name='[Calculation_2787657802577854465]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATE([iso_date]) = DATE([order_date]) THEN &quot;YES&quot; ELSE &quot;NO&quot; END' />
            </column>
            <column caption='No of warehouses' datatype='integer' name='[Calculation_2885962938199773184]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([warehouse_id])' />
            </column>
            <column caption='Region &amp; Country &amp; City' datatype='string' name='[Calculation_2885962938485751814]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='UPPER(LEFT([region],2)) + &quot; - &quot; + UPPER(LEFT([country_name],2)) + &quot; - &quot; + [city]' />
            </column>
            <column caption='# of stores' datatype='integer' name='[Calculation_4315152183480799232]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([warehouse_id])' />
            </column>
            <column caption='City' datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Country name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
