    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='DEFINITIONS'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/PastweekOrders/DEFINITIONS?rev=' id='DEFINITIONS' path='/t/GlobalStandardReporting/workbooks/CityOptimalCoverage' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='800' maxwidth='1100' minheight='800' minwidth='1100' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='98000' id='3' type-v2='text' w='98546' x='727' y='1000'>
            <formatted-text>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#4e79a7' fontsize='15'>GOAL OF THE DASHBOARD:</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#4e79a7' fontsize='15'>DEFINITIONS:</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Avg # of orders: </run>
              <run fontcolor='#000000' fontsize='10'> Sum of the orders/# of warehouses.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>% of Dmart Penetration Per City: </run>
              <run fontcolor='#000000' fontsize='10'>Avg dmart mau/ Avg covered mau</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Orders Frequency: </run>
              <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>It refers to the number of times a unique customer places an order within a specific period(month)</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#4e79a7' fontsize='15'>NOTES:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10'>- Currently, the </run>
              <run bold='true' fontcolor='#418c66' fontsize='10'>data analysis</run>
              <run fontcolor='#000000' fontsize='10'> is for the period </run>
              <run bold='true' fontcolor='#068219' fontsize='10'> June 1st 2022 to present</run>
              <run fontcolor='#068219' fontsize='10'>. </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10'>- Dimensions can be drilled down from </run>
              <run bold='true' fontcolor='#068219' fontsize='10'>Region-&gt;Country name-&gt;City </run>
              <run fontcolor='#000000' fontsize='10'>for the tables Avg # of Orders progression over time</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10'>- Below test  stores are excluded from the analysis</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true'>test stores:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#898989'>EC_17_TiendaPick-Up Oficina</run>
              <run>Æ&#10;</run>
              <run fontcolor='#898989'>Pandabiz Go</run>
              <run>Æ&#10;</run>
              <run fontcolor='#898989'>Pandamart (office)</run>
              <run>Æ&#10;</run>
              <run fontcolor='#898989'>Pandamart (For Business)</run>
              <run>Æ&#10;</run>
              <run fontcolor='#898989'>Pandamart (B2B)</run>
              <run>Æ&#10;</run>
              <run fontcolor='#898989'>Pandamart - Business 1 (KHI)</run>
              <run>Æ&#10;</run>
              <run fontcolor='#898989'>Pandamart - Corporate</run>
              <run>Æ&#10;</run>
              <run fontcolor='#898989'>foodora market pop-up</run>
              <run>Æ&#10;</run>
              <run fontcolor='#898989'>RD_12_Torre OV</run>
              <run>Æ&#10;</run>
              <run fontcolor='#898989'>test warehouse</run>
              <run>Æ&#10;</run>
              <run fontcolor='#898989'>Pandamart (B2B) (Hong Kong)</run>
              <run>Æ&#10;</run>
              <run fontcolor='#898989'>Pandamart (Dolores)</run>
              <run>Æ&#10;</run>
              <run fontcolor='#898989'>PA_9_Midtown</run>
              <run>Æ&#10;</run>
              <run fontcolor='#898989'>SV_6_Torre Futura</run>
              <run>Æ&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
