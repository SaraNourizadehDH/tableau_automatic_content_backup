      <aliases enabled='yes' />
      <column caption='% Book Value incl. DC' datatype='real' default-format='p0.00%' name='[% Book Value (copy)_3102487610581073920]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([closing_balance_inventory_incl_dc]/{fixed [country], [store_id], MONTH([stock_month]), YEAR([stock_month]): SUM([closing_balance_inventory_incl_dc])})' />
      </column>
      <column caption='DSI' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1697716362461667328]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([store_avg_stock_past3months]/[store_avg_cogs_past3months]*30)' />
      </column>
      <column caption='% Store orders' datatype='real' name='[Calculation_2189382744433639424]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([orders_warehouse]/[orders_country])' />
      </column>
      <column caption='% Book Value' datatype='real' default-format='p0.00%' name='[Calculation_6972275949670330370]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([Closing Balance Inventory (copy)_6972275949667471361]/{fixed [country], [store_id], MONTH([stock_month]), YEAR([stock_month]): SUM([Closing Balance Inventory (copy)_6972275949667471361])})' />
      </column>
