      <table>
        <view>
          <datasources>
            <datasource caption='step6 (dev_dmart)' name='federated.0uoyij70fh2r011bxo9bl0lqckv6' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Enter Platform Covered mau threshold' datatype='integer' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='12000'>
              <calculation class='tableau' formula='12000' />
              <range min='0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0uoyij70fh2r011bxo9bl0lqckv6'>
            <column caption='Dmart Penetration' datatype='real' name='[Calculation_5368501871062593536]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dmart_mau]) / SUM([dmart_covered_mau])' />
            </column>
            <column caption='Platform Covered Users Margin' datatype='integer' name='[Calculation_6873055994582794242]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
            </column>
            <column caption='Filter Dmart Covered maus' datatype='string' name='[Calculation_901986569147797518]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [dmart_covered_mau]&gt;[Calculation_6873055994582794242] THEN &quot;Greater than entered threshold&quot; ELSE &quot;Less than or equal to entered threshold&quot; end' />
            </column>
