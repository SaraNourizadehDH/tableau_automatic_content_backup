    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='STORE INVENTORY &amp; ASSEST UTLIZATION'>
      <repository-location id='STOREINVENTORYASSESTUTLIZATION' path='/t/GlobalStandardReporting/workbooks/StoreInventoryAssestUtilization-devversion' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='dash-text'>
          <format attr='text-align' id='dash-text_24' value='left' />
        </style-rule>
        <style-rule element='parameter-ctrl'>
          <format attr='background-color' value='#f5f5f5' />
          <format attr='border-style' value='solid' />
          <format attr='border-color' value='#e6e6e6' />
        </style-rule>
      </style>
      <size maxheight='2700' maxwidth='1400' minheight='2700' minwidth='1400' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='tableau_salesforce_portfolio_management' name='federated.0km19an1s7tarw10sml6a1211kq6' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Select KPI' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Installed Capacity&quot;'>
          <calculation class='tableau' formula='&quot;Installed Capacity&quot;' />
          <members>
            <member value='&quot;Not Consumed Capacity&quot;' />
            <member value='&quot;Not Consumed Capacity \%&quot;' />
            <member value='&quot;Consumed Capacity&quot;' />
            <member value='&quot;Consumed Capacity \%&quot;' />
            <member value='&quot;Installed Capacity&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.0km19an1s7tarw10sml6a1211kq6'>
        <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
