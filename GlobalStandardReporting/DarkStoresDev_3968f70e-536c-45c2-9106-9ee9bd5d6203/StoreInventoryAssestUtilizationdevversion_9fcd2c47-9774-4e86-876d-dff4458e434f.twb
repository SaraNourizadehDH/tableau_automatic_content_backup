      </column>
      <column caption='KPI' datatype='real' name='[Calculation_2000161188601737235]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] WHEN &quot;Not Consumed Capacity&quot; THEN SUM([Calculation_122019406116179979])&#10; WHEN &quot;Consumed Capacity&quot; THEN SUM([Calculation_122019406114938890])&#10; WHEN &quot;Not Consumed Capacity %&quot; THEN [Calculation_1330672956412903424] *100&#10; WHEN &quot;Consumed Capacity %&quot; THEN [Calculation_122019406090108934] * 100&#10; WHEN &quot;Installed Capacity&quot; THEN SUM([installed_capacity])&#10; ELSE 0 END' />
      </column>
      <column caption='KPI consumed capacity %' datatype='string' name='[Calculation_2000161188604629013]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] WHEN &quot;Not Consumed Capacity %&quot; THEN &quot;%&quot; &#10;WHEN &quot;Consumed Capacity %&quot; THEN &quot;%&quot; ELSE &quot;&quot; END' />
      </column>
      <column caption='Not Utilized Floorspace' datatype='integer' name='[Calculation_2000161188673486871]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2000161188591181842]-[Calculation_2000161188587155459]' />
      </column>
      <column caption='Not Utilized Space  ' datatype='real' name='[Calculation_2000161188681519129]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_122019406079811587] - [gross_leased_area]' />
      </column>
      <column caption='sum of area' datatype='real' name='[Calculation_244179607752777729]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[depth_cm]*[width]*0.01' />
      </column>
      <column caption='Calculation1' datatype='real' name='[Calculation_244179607761874947]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_244179607752777729]/[no_shelves]' />
      </column>
      <column caption='Volume' datatype='real' name='[Calculation_251427583379152911]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([height_cm]*[width]*[depth_cm])*0.01' />
      </column>
      <column caption='Warehouse Count' datatype='integer' name='[Calculation_2834945616757682176]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([warehouse_id])' />
      </column>
      <column caption='closed or live' datatype='string' name='[Calculation_3108891142025121793]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_5814921199807127552] = &quot;Dmart Live&quot; THEN &quot;store live&quot; &#10;ELSE IF [Calculation_5814921199807127552] = &quot;Permanently Closed&quot; Then &quot;closed&quot; &#10;ELSE IF [Calculation_5814921199807127552] = &quot;temporarily closed&quot; Then &quot;closed&quot;&#10;ELSE &quot;others&quot; END END END' />
      </column>
      <column caption='Overall number of stores in the month end' datatype='integer' name='[Calculation_3108891142041411590]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP((ZN([Calculation_3522237161287335937])),LAST()) - LOOKUP(ZN(([Calculation_3522237161287335937])),FIRST())'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Live stores at the beginning of a month' datatype='integer' name='[Calculation_3108891142156861452]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL(Lookup( [Calculation_3108891142342828047], -1)) THEN Lookup( [Calculation_3108891142342828047], -2) ELSE Lookup( [Calculation_3108891142342828047], -1) END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='live-perstatus' datatype='integer' name='[Calculation_3108891142173044750]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[no_live_status]-[no_permanently_closed_status] - [no_temp_closed_status]' />
      </column>
      <column caption='C Calculated' datatype='integer' name='[Calculation_3108891142342828047]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_3108891142173044750]) + PREVIOUS_VALUE(0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Store Status Calculated' datatype='string' name='[Calculation_3451235086328442880]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Calculation_5814921199807127552] WHEN &quot;Property Identified stores&quot; THEN &quot;Property Identified Stores&quot;&#10;WHEN &quot;Legal and Ops Reviewed stores&quot; THEN &quot;Legal and Ops Reviewed Stores&quot;&#10;WHEN &quot;in Contract Negotiation status&quot; THEN &quot;Contract Negotiation Status&quot;&#10;WHEN &quot;under Construction&quot; THEN &quot;Under Construction&quot;&#10;WHEN &quot;stores in Set-up and Inbounding status&quot; THEN &quot;Set-up and Inbounding&quot;&#10;WHEN &quot;opened stores&quot; THEN &quot;Opened Stores&quot;&#10;WHEN &quot;Permanently Closed stores&quot; THEN &quot;Permanently Closed Stores&quot;&#10;WHEN &quot;Rejected stores&quot; THEN &quot;Rejected Stores&quot;&#10;WHEN &quot;Temporarily Closed&quot; THEN &quot;Temporarily Closed&quot;&#10;ELSE &quot;Others&quot;&#10;END' />
      </column>
      <column caption='Number of stores per month c' datatype='integer' name='[Calculation_3522237161287335937]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([store_id])' />
      </column>
      <column caption='No of Stores' datatype='integer' name='[Calculation_3619346028263387136]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([store_id])' />
      </column>
      <column caption='Avg monthly rent' datatype='integer' datatype-customized='true' name='[Calculation_4788874564732735488]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(AVG([monthly_rent_lc]))' />
      </column>
      <column caption='Avg rent per sqm' datatype='integer' datatype-customized='true' name='[Calculation_4788874564732833793]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT([Calculation_4788874564732735488]/SUM([gross_leased_area]))' />
      </column>
      <column caption='Avg rent per store' datatype='integer' datatype-customized='true' name='[Calculation_4788874564732977154]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT([Calculation_4788874564732735488]/[Calculation_3619346028263387136])' />
      </column>
      <column caption='Store Status' datatype='string' name='[Calculation_5814921199807127552]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [store_status] WHEN &quot;Construction&quot; THEN &quot;under Construction&quot;&#10;WHEN &quot;Contract Negotiation&quot; THEN &quot;in Contract Negotiation status&quot;&#10;WHEN &quot;Dmart Live&quot; THEN &quot;opened stores&quot;&#10;WHEN &quot;Legal and Ops Review&quot; THEN &quot;Legal and Ops Reviewed stores&quot;&#10;WHEN &quot;Permanently Closed&quot; THEN &quot;Permanently Closed stores&quot;&#10;WHEN &quot;Property Identification&quot; THEN &quot;Property Identified stores&quot;&#10;WHEN &quot;Rejected&quot; THEN &quot;Rejected stores&quot;&#10;WHEN &quot;Store Set-up and Inbounding&quot; THEN &quot;stores in Set-up and Inbounding status&quot;&#10;WHEN &quot;Rejected&quot; THEN &quot;Rejected stores&quot;&#10;WHEN &quot;Temporarily Closed&quot; THEN &quot;Temporarily Closed&quot;&#10;ELSE &quot;Others&quot;&#10;END' />
      </column>
      <column caption='Dmart Live Calculated' datatype='integer' name='[Calculation_6481242851471888386]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_3108891142025121793] = &quot;Dmart Live&quot; THEN 1 ELSE 0 END)' />
      </column>
