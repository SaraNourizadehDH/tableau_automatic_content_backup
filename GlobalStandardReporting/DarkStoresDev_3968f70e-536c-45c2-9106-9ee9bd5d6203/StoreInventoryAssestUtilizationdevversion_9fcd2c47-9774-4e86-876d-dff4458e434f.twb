    <worksheet name='Region KPI'>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_salesforce_portfolio_management' name='federated.0km19an1s7tarw10sml6a1211kq6' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select KPI' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Installed Capacity&quot;'>
              <calculation class='tableau' formula='&quot;Installed Capacity&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0km19an1s7tarw10sml6a1211kq6'>
            <column caption='Consumed Capacity %' datatype='real' name='[Calculation_122019406090108934]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_122019406114938890])/SUM([installed_capacity])' />
            </column>
            <column caption='Consumed Capacity' datatype='integer' name='[Calculation_122019406114938890]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [warehouse_name] = &quot;AR_1_Gurruchaga&quot; THEN 50 ELSE (IF [warehouse_name] = &quot;AR_10_La Plata&quot; THEN 10 ELSE (IF [warehouse_name] = &quot;AR_176_Caballito_Norte&quot; THEN 35 ELSE (IF [warehouse_name] = &quot;BO_1_Equipetrol&quot; THEN 50 ELSE (IF [warehouse_name] = &quot;BO_2_NORTE&quot; THEN 110 ELSE (IF [warehouse_name] = &quot;BO_3_Cochabamba&quot; THEN 200 ELSE (IF [warehouse_name] = &quot;BO_5_Sopocachi&quot; THEN 65 ELSE (IF [warehouse_name] = &quot;BO_6_Sur&quot; THEN 120 ELSE (IF [warehouse_name] = &quot;BO_7_Sucre&quot; THEN 107 ELSE (IF [warehouse_name] = &quot;Pandamart (Angeles)&quot; THEN 45 ELSE (IF [warehouse_name] = &quot;Pandamart (Cabanatuan)&quot; THEN 23 ELSE (IF [warehouse_name] = &quot;Pandamart (Lipa)&quot; THEN 15 ELSE (IF [warehouse_name] = &quot;Pandamart(Malolos)&quot; THEN 15 ELSE (IF [warehouse_name] = &quot;Pandamart (Pasay)&quot; THEN 15 ELSE (IF [warehouse_name] = &quot;Panadamart (San Fernando)&quot; THEN 12 ELSE (IF [warehouse_name] = &quot;Pandamart (Taguig)&quot;  THEN 15 ELSE (IF [warehouse_name] = &quot;Pandamart - Bahria Town (LHR)&quot; THEN 12 ELSE (IF [warehouse_name] = &quot;pandamart (Boon Lay)&quot; THEN 570 ELSE (IF [warehouse_name] = &quot;pandamart (Outram)&quot; THEN 12 ELSE (IF [warehouse_name] = &quot;pandamart (Punggol)&quot; THEN 10 ELSE 0 END) END) END) END) END) END) END) END) END) END) END ) END) END) END) END) END) END) END) END) END' />
            </column>
            <column caption='Not Consumed Capacity' datatype='real' name='[Calculation_122019406116179979]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[installed_capacity]-[Calculation_122019406114938890]' />
            </column>
            <column caption='Not Consumed Capacity %' datatype='real' name='[Calculation_1330672956412903424]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_122019406116179979])/SUM([installed_capacity])' />
            </column>
            <column caption='KPI' datatype='real' name='[Calculation_2000161188601737235]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] WHEN &quot;Not Consumed Capacity&quot; THEN SUM([Calculation_122019406116179979])&#10; WHEN &quot;Consumed Capacity&quot; THEN SUM([Calculation_122019406114938890])&#10; WHEN &quot;Not Consumed Capacity %&quot; THEN [Calculation_1330672956412903424] *100&#10; WHEN &quot;Consumed Capacity %&quot; THEN [Calculation_122019406090108934] * 100&#10; WHEN &quot;Installed Capacity&quot; THEN SUM([installed_capacity])&#10; ELSE 0 END' />
            </column>
            <column caption='KPI consumed capacity %' datatype='string' name='[Calculation_2000161188604629013]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] WHEN &quot;Not Consumed Capacity %&quot; THEN &quot;%&quot; &#10;WHEN &quot;Consumed Capacity %&quot; THEN &quot;%&quot; ELSE &quot;&quot; END' />
            </column>
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Installed Capacity' datatype='real' name='[installed_capacity]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_2000161188604629013]' derivation='None' name='[none:Calculation_2000161188604629013:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
