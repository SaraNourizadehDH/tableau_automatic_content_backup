      <column caption='ABV_country_level_and_above' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[ABS_country_level_and_above (copy)_481040742100037647]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_481040742038011906])/SUM([ABS_country_level_and_above (copy)_481040742089379853])' />
      </column>
      <column caption='ABV_brand_supp_level' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[ABV_category_level (copy)_1080300967882518547]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_481040742038011906])/([category_view_orders (copy)_1080300967881961489])' />
      </column>
      <column caption='ABV_category_level' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[ABV_country_level_and_above (copy)_1080300967812313096]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_481040742038011906])/([Calculation_1080300967811284998])' />
      </column>
      <column caption='Calculation1' datatype='real' name='[Calculation_1035405752931414016]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  [Parameters].[Granularity (copy 2)_1080300967807762432] = &apos;Level Zero&apos; THEN [Calculation_1080300967903318037]/[Calculation_1080300967903916055]&#10;//ELSEIF [Granularity_supp_brand_view] = &apos;Brand&apos; THEN [country_month_brand_gmv]/[country_month_gmv]&#10;END' />
      </column>
      <column caption='category_view_orders' datatype='real' name='[Calculation_1080300967811284998]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Granularity (copy 2)_1080300967807762432] = &apos;Level Zero&apos; THEN SUM([country_orders_monthly_avg (copy)_1080300967810670595])&#13;&#10;ELSEIF [Parameters].[Granularity (copy 2)_1080300967807762432] = &apos;Level One&apos; THEN SUM([level_zero_orders_monthly_avg (copy)_1080300967810961412])&#13;&#10;ELSEIF [Parameters].[Granularity (copy 2)_1080300967807762432] = &apos;Level Two&apos; THEN SUM([level_zero_orders_monthly_avg (copy)_1080300967811063813])&#13;&#10;ELSEIF [Parameters].[Granularity (copy 2)_1080300967807762432] = &apos;Level Three&apos; THEN SUM([level_two_orders_monthly_avg (copy)_618682023375454211])&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='country_month_supplier_gmv' datatype='real' name='[Calculation_1080300967903318037]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [country_name],[month_number],[supplier_name] : SUM([Calculation_481040742038011906])}' />
      </column>
      <column caption='country_month_gmv' datatype='real' name='[Calculation_1080300967903916055]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [country_name],[month_number] : SUM([Calculation_481040742038011906])}' />
      </column>
      <column caption='gmv_contribution_to_country_gmv' datatype='real' default-format='p0.00%' name='[Calculation_1080300967904034840]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  [Parameters].[Granularity_category_view (copy)_1080300967872364554] = &apos;Supplier&apos; THEN [Calculation_1080300967903318037]/[Calculation_1080300967903916055]&#13;&#10;ELSEIF [Parameters].[Granularity_category_view (copy)_1080300967872364554] = &apos;Brand&apos; THEN [country_month_supplier_gmv (copy)_1080300967903502358]/[Calculation_1080300967903916055]&#13;&#10;END' />
      </column>
      <column caption='Comp_abs_calculated_field' datatype='boolean' name='[Calculation_1637621446105632768]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Metric_Selector_comparison_view (copy)] = &quot;Absolute&quot; THEN&#13;&#10;    TRUE&#13;&#10;ELSE&#13;&#10;    FALSE&#13;&#10;END' />
      </column>
      <column caption='granularity_column' datatype='string' name='[Calculation_263460585116618752]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] WHEN &apos;Global&apos; THEN &apos;&apos; &#13;&#10;WHEN &apos;Region&apos; THEN &apos;&apos;&#13;&#10;WHEN &apos;Country&apos; THEN [segment] END' />
      </column>
      <column caption='Granularity_filter' datatype='string' name='[Calculation_481040742036426752]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] WHEN &apos;Global&apos; THEN &apos;Global&apos; &#13;&#10;WHEN &apos;Region&apos; THEN [segment]&#13;&#10;ELSE [country_name] END' />
      </column>
      <column caption='euros_and_lc' datatype='string' name='[Calculation_481040742037471233]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Granularity (copy)]= &apos;Euros&apos; THEN &quot;€&quot; ELSE [currency_code] END' />
      </column>
      <column caption='GMV' datatype='real' name='[Calculation_481040742038011906]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Granularity (copy)] = &quot;Euros&quot; THEN ([gmv_eur]) &#13;&#10;ELSEIF [Parameters].[Granularity (copy)] = &quot;Local Currency&quot; THEN ([gmv_lc]) END' />
      </column>
      <column caption='Promo_gmv' datatype='real' name='[Calculation_481040742039343107]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Granularity (copy)] = &quot;Euros&quot; THEN ([promo_gmv_eur]) &#13;&#10;ELSEIF [Parameters].[Granularity (copy)] = &quot;Local Currency&quot; THEN ([promo_gmv_lc]) END' />
      </column>
      <column caption='Perc_front_margin' datatype='real' default-format='p0.0%' name='[Calculation_481040742039474180]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_481040742040113157])/SUM([Calculation_481040742038011906])' />
      </column>
      <column caption='front_margin' datatype='real' name='[Calculation_481040742040113157]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Granularity (copy)] = &quot;Euros&quot; THEN ([front_margin_eur]) &#13;&#10;ELSEIF [Parameters].[Granularity (copy)] = &quot;Local Currency&quot; THEN ([front_margin_lc]) END' />
      </column>
      <column caption='ASP' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_481040742040801287]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_481040742038011906])/SUM([units_sold])' />
      </column>
      <column caption='Yr_Mon' datatype='string' name='[Calculation_481040742042247177]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Yr]+&quot;-&quot;+[Mon]' />
      </column>
      <column caption='Chart_Calculations' datatype='real' name='[Calculation_481040742049091594]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] =&apos;GMV&apos; THEN SUM([Calculation_481040742038011906])&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Units Sold&apos; THEN SUM([units_sold])&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Promo Countribution&apos; THEN (SUM([Calculation_481040742039343107])*100)/SUM([Calculation_481040742038011906])&#13;&#10;ELSEIF  [Parameters].[Parameter 2] = &apos;Front Margin&apos; THEN SUM([Calculation_481040742040113157])&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;% Front Margin&apos; THEN (SUM([Calculation_481040742040113157])*100)/SUM([Calculation_481040742038011906])&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Average Selling Price&apos; THEN SUM([Calculation_481040742038011906])/SUM([units_sold])&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;ABS&apos; THEN SUM([units_sold])/SUM([ABS_country_level_and_above (copy)_481040742089379853])&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Orders&apos; THEN SUM([ABS_country_level_and_above (copy)_481040742089379853])&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;ABV&apos; THEN SUM([Calculation_481040742038011906])/SUM([ABS_country_level_and_above (copy)_481040742089379853])&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='L12M' datatype='boolean' name='[Calculation_618682023336996864]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,DATE([month_number]),TODAY())&gt;=0&#13;&#10;AND DATEDIFF(&apos;month&apos;,DATE([month_number]),TODAY())&lt;=12' />
