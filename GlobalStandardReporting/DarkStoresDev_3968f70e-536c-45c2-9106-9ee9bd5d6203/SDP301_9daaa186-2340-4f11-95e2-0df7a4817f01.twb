            <column caption='Supplier Orders' datatype='integer' name='[supplier_orders]' role='measure' type='quantitative' />
            <column caption='brand_orders_monthly_avg' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[suppliers_orders_monthly_avg (copy)_1080300967881781264]' role='measure' type='quantitative'>
