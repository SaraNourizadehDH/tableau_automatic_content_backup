          <datasource-dependencies datasource='Parameters'>
            <column caption='Granularity_category_view' datatype='string' name='[Granularity (copy 2)_1080300967807762432]' param-domain-type='list' role='measure' type='nominal' value='&quot;Level Zero&quot;'>
              <calculation class='tableau' formula='&quot;Level Zero&quot;' />
            </column>
            <column caption='Currency' datatype='string' name='[Granularity (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;Euros&quot;'>
              <calculation class='tableau' formula='&quot;Euros&quot;' />
