    <worksheet name='brand_supp_Chart'>
      <table>
        <view>
          <datasources>
            <datasource caption='an_supp_per_db_2_base_v2 (dev_dmart)' name='federated.0nh2h0113g4ipm0zr1jxv1jmzxjy' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Granularity (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;Euros&quot;'>
              <calculation class='tableau' formula='&quot;Euros&quot;' />
            </column>
            <column caption='Granularity_supp_brand_view' datatype='string' name='[Granularity_category_view (copy)_1080300967872364554]' param-domain-type='list' role='measure' type='nominal' value='&quot;Brand&quot;'>
              <calculation class='tableau' formula='&quot;Brand&quot;' />
            </column>
            <column caption='Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
              <calculation class='tableau' formula='&quot;Country&quot;' />
            </column>
            <column caption='Metric_Selector' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Front Margin&quot;'>
              <calculation class='tableau' formula='&quot;Front Margin&quot;' />
              <aliases>
                <alias key='&quot;ABS&quot;' value='Average Basket Size (Units)' />
                <alias key='&quot;ABV&quot;' value='Average Basket Value' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0nh2h0113g4ipm0zr1jxv1jmzxjy'>
            <column caption='Granularity_filter' datatype='string' name='[Calculation_481040742036426752]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] WHEN &apos;Global&apos; THEN &apos;Global&apos; &#13;&#10;WHEN &apos;Region&apos; THEN [segment]&#13;&#10;ELSE [country_name] END' />
            </column>
            <column caption='GMV' datatype='real' name='[Calculation_481040742038011906]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Granularity (copy)] = &quot;Euros&quot; THEN ([gmv_eur]) &#13;&#10;ELSEIF [Parameters].[Granularity (copy)] = &quot;Local Currency&quot; THEN ([gmv_lc]) END' />
            </column>
            <column caption='Promo_gmv' datatype='real' name='[Calculation_481040742039343107]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Granularity (copy)] = &quot;Euros&quot; THEN ([promo_gmv_eur]) &#13;&#10;ELSEIF [Parameters].[Granularity (copy)] = &quot;Local Currency&quot; THEN ([promo_gmv_lc]) END' />
            </column>
            <column caption='front_margin' datatype='real' name='[Calculation_481040742040113157]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Granularity (copy)] = &quot;Euros&quot; THEN ([front_margin_eur]) &#13;&#10;ELSEIF [Parameters].[Granularity (copy)] = &quot;Local Currency&quot; THEN ([front_margin_lc]) END' />
            </column>
            <column caption='Yr_Mon' datatype='string' name='[Calculation_481040742042247177]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Yr]+&quot;-&quot;+[Mon]' />
            </column>
            <column caption='L12M' datatype='boolean' name='[Calculation_618682023336996864]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,DATE([month_number]),TODAY())&gt;=0&#13;&#10;AND DATEDIFF(&apos;month&apos;,DATE([month_number]),TODAY())&lt;=12' />
            </column>
            <column caption='Chart_Calculations_supp_brand_view' datatype='real' name='[Chart_Calculations_category_view (copy)_1080300967896473620]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] =&apos;GMV&apos; THEN SUM([Calculation_481040742038011906])&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Units Sold&apos; THEN SUM([units_sold])&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Promo Countribution&apos; THEN (SUM([Calculation_481040742039343107])*100)/SUM([Calculation_481040742038011906])&#13;&#10;ELSEIF  [Parameters].[Parameter 2] = &apos;Front Margin&apos; THEN SUM([Calculation_481040742040113157])&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;% Front Margin&apos; THEN (SUM([Calculation_481040742040113157])*100)/SUM([Calculation_481040742038011906])&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Average Selling Price&apos; THEN SUM([Calculation_481040742038011906])/SUM([units_sold])&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;ABS&apos; THEN SUM([units_sold])/([category_view_orders (copy)_1080300967881961489])&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Orders&apos; THEN ([category_view_orders (copy)_1080300967881961489])&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;ABV&apos; THEN SUM([Calculation_481040742038011906])/([category_view_orders (copy)_1080300967881961489])&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Granularity_filter_supp_brand' datatype='string' name='[Granularity_filter_categories (copy)_1080300967872925709]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Granularity_category_view (copy)_1080300967872364554] WHEN &apos;Supplier&apos; THEN [supplier_name]&#13;&#10;WHEN &apos;Brand&apos; THEN [brand_name]&#13;&#10;END' />
            </column>
            <column datatype='string' name='[Mon]' role='dimension' type='nominal' />
            <column datatype='string' name='[Yr]' role='dimension' type='nominal' />
            <column caption='Brand Name' datatype='string' name='[brand_name]' role='dimension' type='nominal' />
            <column caption='Brand Orders' datatype='integer' name='[brand_orders]' role='measure' type='quantitative' />
            <column caption='supp_brand_view_orders' datatype='real' name='[category_view_orders (copy)_1080300967881961489]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Granularity_category_view (copy)_1080300967872364554] = &apos;Supplier&apos; THEN SUM([level_zero_orders_monthly_avg (copy)_1080300967881486351])&#13;&#10;ELSEIF [Parameters].[Granularity_category_view (copy)_1080300967872364554] = &apos;Brand&apos; THEN SUM([suppliers_orders_monthly_avg (copy)_1080300967881781264])&#13;&#10;END' />
            </column>
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Perc_symbol' datatype='string' name='[euros_and_lc (copy)_481040742080229387]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2] &#13;&#10;WHEN &apos;Promo Countribution&apos; THEN &quot;%&quot;&#13;&#10;WHEN &apos;% Front Margin&apos; THEN &quot;%&quot;&#13;&#10;//WHEN &apos;GMV&apos; THEN &quot;M&quot;&#13;&#10;//WHEN &apos;Units Sold&apos; THEN &quot;M&quot;&#13;&#10;//WHEN &apos;Orders&apos; THEN &quot;M&quot;&#13;&#10;//WHEN &apos;Front Margin&apos; THEN &quot;M&quot;&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
            </column>
            <column caption='Front Margin Eur' datatype='real' name='[front_margin_eur]' role='measure' type='quantitative' />
            <column caption='Front Margin Lc' datatype='real' name='[front_margin_lc]' role='measure' type='quantitative' />
            <column caption='Gmv Eur' datatype='real' name='[gmv_eur]' role='measure' type='quantitative' />
            <column caption='Gmv Lc' datatype='real' name='[gmv_lc]' role='measure' type='quantitative' />
            <column caption='Level Cero' datatype='string' name='[level_cero]' role='dimension' type='nominal' />
            <column caption='Level One' datatype='string' name='[level_one]' role='dimension' type='nominal' />
            <column caption='Level Two' datatype='string' name='[level_two]' role='dimension' type='nominal' />
            <column caption='suppliers_orders_monthly_avg' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[level_zero_orders_monthly_avg (copy)_1080300967881486351]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='({Fixed [country_name],[Calculation_481040742042247177],[level_cero],[level_one],[level_two],[supplier_name]: avg([supplier_orders])})' />
            </column>
            <column caption='Month Number' datatype='date' name='[month_number]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_481040742036426752]' derivation='None' name='[none:Calculation_481040742036426752:nk]' pivot='key' type='nominal' />
