      <column caption='ABS_brand_supp_level' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[ABS_category_level (copy)_1080300967882330130]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([units_sold])/([category_view_orders (copy)_1080300967881961489])' />
      </column>
      <column caption='ABS_category_level' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[ABS_country_level_and_above (copy)_1080300967812169735]' role='measure' type='quantitative'>
