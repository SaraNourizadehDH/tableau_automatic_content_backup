      <column caption='Calculation1' datatype='string' name='[Calculation_2524971279627624452]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF &#10;(ZN([Calculation_2524971279558127616]) - LOOKUP(ZN([Calculation_2524971279558127616]), -1)) / ABS(LOOKUP(ZN([Calculation_2524971279558127616]), -1)) &gt; 0&#10;THEN &quot;POSITIVE&quot;&#10;ELSEIF &#10;(ZN([Calculation_2524971279558127616]) - LOOKUP(ZN([Calculation_2524971279558127616]), -1)) / ABS(LOOKUP(ZN([Calculation_2524971279558127616]), -1)) &lt; 0&#10;THEN &quot;NEGATIVE&quot;&#10;ELSE&#10;NULL&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Front Margin' datatype='real' name='[Calculation_3894909995859537920]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gbv_net_of_vat]) + SUM([total_supplier_funding_eur])-SUM([cogs])' />
