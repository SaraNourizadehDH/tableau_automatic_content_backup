      <aliases enabled='yes' />
      <column caption='Total Scheduled daily hours' datatype='real' datatype-customized='true' name='[Calculation_1194931682161197056]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[duration] / 3600' />
      </column>
      <column caption='sum' datatype='real' name='[Calculation_2064196788231733250]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[duration]/3600' />
      </column>
      <column caption='Exact day month' datatype='string' name='[Calculation_2064196788557185028]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATE([iso_date]) &gt;= #2023-05-01# AND DATE([iso_date]) &lt; #2023-06-01# THEN &quot;May 2023&quot;&#10;ELSEIF DATE([iso_date]) &gt;= #2023-06-01# AND DATE([iso_date]) &lt; #2023-07-01# THEN &quot;June 2023&quot;&#10;ELSEIF DATE([iso_date]) &gt;= #2023-07-01# AND DATE([iso_date]) &lt; #2023-08-01# THEN &quot;July 2023&quot;&#10;ELSE &quot;0&quot;&#10;END' />
      </column>
      <column caption='number of days' datatype='integer' name='[Calculation_2064196788560187397]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_2064196788557185028] = &quot;May 2023&quot; THEN&#10;   31&#10;ELSEIF [Calculation_2064196788557185028] = &quot;June 2023&quot; THEN&#10;   30&#10;ELSE&#10;   0&#10;END' />
      </column>
      <column caption='Number of orders' datatype='real' name='[Calculation_2064196788565270535]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([number_of_orderz_last_month])' />
      </column>
      <column caption=' Offine daily hours' datatype='real' datatype-customized='true' name='[Calculation_2160039004421701632]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([offline_duration] / 3600)' />
      </column>
      <column caption='Calculation1' datatype='integer' name='[Calculation_2160039005435662342]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([warehouse_name])' />
      </column>
      <column caption='Total Offline hours' datatype='string' name='[Calculation_2827486551666593793]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Total Offline hours&quot;' />
      </column>
      <column caption='Special day' datatype='string' name='[Calculation_6139954443539341312]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_special_day] = TRUE THEN &quot;TRUE&quot; ELSE &quot;FALSE&quot; END' />
      </column>
      <column caption='Lost(orders) per day' datatype='real' datatype-customized='true' name='[Calculation_6139954443873562630]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([number_of_orderz_last_month])/AVG([Calculation_2064196788560187397])' />
      </column>
      <column caption='number of days last month' datatype='integer' name='[Calculation_6139954443880284169]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DAY(DATEADD(&apos;day&apos;,-1,DATEADD(&apos;month&apos;,1,DATETRUNC(&apos;month&apos;,TODAY()))))' />
      </column>
      <column caption='# of Offline events' datatype='integer' name='[Calculation_6139954443914911754]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='COUNT(IF [offline_reason] &lt;&gt; &quot;DEVICE_CONNECTIVITY&quot; THEN [offline_reason] END)' />
      </column>
      <column caption='Offline hours%' datatype='integer' datatype-customized='true' name='[Calculation_6139954443918475276]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(SUM([Calculation_2160039004421701632])/SUM([Calculation_1194931682161197056]))' />
      </column>
      <column caption='Total Online hours' datatype='real' datatype-customized='true' name='[Calculation_6139954443918888973]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1194931682161197056] - IF ISNULL([Calculation_2160039004421701632]) THEN 0 ELSE [Calculation_2160039004421701632] END)' />
      </column>
      <column caption='Online hours %' datatype='real' datatype-customized='true' name='[Calculation_6139954443919093774]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_6139954443918888973])/SUM([Calculation_1194931682161197056])' />
      </column>
      <column caption='Loss Revenue WIP' datatype='real' name='[Calculation_6139954445645975567]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([number_of_orderz_last_month])*AVG([AOV])/AVG([Calculation_2064196788560187397])' />
      </column>
      <column caption='Metric' datatype='real' datatype-customized='true' name='[Calculation_6139954445686861841]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Offline hours&quot; THEN SUM([Calculation_2160039004421701632]) ELSEIF &#10;[Parameters].[Parameter 1] = &quot;Lost Orders&quot; THEN [Calculation_6139954443873562630] ELSEIF &#10;[Parameters].[Parameter 1] = &quot;Lost Revenue&quot; THEN [Calculation_6139954445645975567] ELSE 0 END' />
      </column>
      <column caption='Index' datatype='integer' name='[Calculation_6609102886094688258]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Calculation2' datatype='integer' name='[Calculation_6912603258141093889]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MONTH([iso_date])' />
      </column>
      <column caption='pervious month orders' datatype='integer' name='[Calculation_6939765593405698049]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF MIN(DATEPART(&apos;month&apos;, [iso_date])) = 6 THEN 0 ELSE SUM([number_of_orderz_last_month]) END' />
      </column>
      <column caption='previous month number of days' datatype='integer' name='[Calculation_6939765593413857282]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, DATEADD(&apos;month&apos;, -1, [iso_date]), [iso_date])' />
      </column>
      <column caption='avg lost order per day' datatype='real' name='[Calculation_6939765593413931011]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_6939765593405698049]) / SUM([Calculation_6939765593413857282])' />
      </column>
      <column caption='Total Unreachable hours' datatype='real' name='[Calculation_6939765593430200327]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[unreachable_online_duration]/3600' />
      </column>
      <column caption='Metric Name' datatype='string' name='[Metric (copy)_6139954445707358226]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Offline hours&quot; THEN &quot;Offline hours&quot; ELSEIF &#10;[Parameters].[Parameter 1] = &quot;Lost Orders&quot; THEN &quot;Lost Orders&quot; ELSEIF &#10;[Parameters].[Parameter 1] = &quot;Lost Revenue&quot; THEN &quot;Lost Revenue&quot; ELSE &quot;&quot; END' />
      </column>
      <column caption='Total Offine  hours' datatype='real' datatype-customized='true' name='[Total Offine  hours (copy)_2827486551655374848]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([offline_duration] / 3600)' />
      </column>
