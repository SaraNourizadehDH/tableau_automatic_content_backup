      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[usr:Calculation_6139954443919093774:ok]' type='palette'>
            <map to='#f28e2b'>
              <bucket>1.0</bucket>
            </map>
            <map to='#ffbe7d'>
              <bucket>0.0</bucket>
            </map>
          </encoding>
          <encoding attr='color' field='[none:offline_reason:nk]' type='palette'>
            <map to='#499894'>
              <bucket>&quot;HOLIDAY_SPECIAL_DAY&quot;</bucket>
            </map>
            <map to='#4e79a7'>
              <bucket>%null%</bucket>
            </map>
            <map to='#4e79a7'>
              <bucket>&quot;AREA_DISRUPTION&quot;</bucket>
            </map>
            <map to='#4e79a7'>
              <bucket>&quot;UNREACHABLE&quot;</bucket>
            </map>
            <map to='#59a14f'>
              <bucket>&quot;CLOSED&quot;</bucket>
            </map>
            <map to='#79706e'>
