  <dashboards>
    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='DEFINTIONS'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/Nonoperatinghourlywithreasons/DEFINTIONS?rev=' id='DEFINTIONS' path='/t/GlobalStandardReporting/workbooks/Nonoperatinghourlywithreasons' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='800' maxwidth='1000' minheight='800' minwidth='1000' />
      <zones>
        <zone h='100000' id='8' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='98000' id='7' type-v2='text' w='98400' x='800' y='1000'>
            <formatted-text>
              <run>Æ&#10;&#10;&#10;&#10;&#10;</run>
              <run bold='true' fontsize='10'>DEFINITIONS:</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#1b1b1b'>Offline hours</run>
              <run fontcolor='#1b1b1b'> - The duration, in seconds, that the vendor was offline on platform during the given schedule slot. The sum of offline_duration_seconds and device_unreachable_duration_seconds may add up to a value greater than slot_duration_seconds as these columns are not mutually exclusive</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#1b1b1b'>Scheduled hours</run>
              <run fontcolor='#1b1b1b'> - The duration, in seconds, for the given schedule slot.  A slot is a period of time that the vendor is available for receiving orders.</run>
              <run>Æ&#10;&#10;&#10;</run>
              <run bold='true' fontcolor='#1b1b1b'>Total Unreachable hours</run>
              <run fontcolor='#1b1b1b'> - The duration, in seconds, for which the vendor&apos;s device was not reachable during the given schedule slot. The sum of offline_duration_seconds and device_unreachable_duration_seconds may add up to a value greater than slot_duration_seconds as these columns are not mutually exclusive</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#1b1b1b'>Offline reason </run>
              <run fontcolor='#1b1b1b'>- The reason for the given unavailable event. If the vendor is offline on platform (is_offline_on_platform = TRUE), this specifies the reason why by Monitor or Client.</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#1b1b1b'>Lost orders per day </run>
              <run fontcolor='#1b1b1b'>- To find this, we add up the orders from the month before the one we&apos;re interested in (as determined by the exact day month filter) and divide that total by the number of days in the chosen month.</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000'>Offline reasons:</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#4a4a4a' fontname='Roboto' fontsize='12'>Closed Reason Mapping        Messages that will appear</run>
              <run>Æ&#10;</run>
              <run fontcolor='#4a4a4a' fontname='Roboto'>TOO_BUSY_NO_DRIVERS        --- Self-closed due to lack of your own riders</run>
              <run>Æ&#10;</run>
              <run fontcolor='#4a4a4a' fontname='Roboto'>TOO_BUSY_KITCHEN               ---  You are too busy</run>
              <run>Æ&#10;</run>
              <run fontcolor='#4a4a4a' fontname='Roboto'>UPDATES_IN_MENU                 ---     Due to menu updates</run>
              <run>Æ&#10;</run>
              <run fontcolor='#4a4a4a' fontname='Roboto'>TECHNICAL_PROBLEM             ---         Due to technical issues</run>
              <run>Æ&#10;</run>
              <run fontcolor='#4a4a4a' fontname='Roboto'>CLOSED                                      ---         You will not receive orders during this period</run>
              <run>Æ&#10;</run>
              <run fontcolor='#4a4a4a' fontname='Roboto'>OTHER                                        ---      You will not receive orders during this period</run>
              <run>Æ&#10;</run>
              <run fontcolor='#4a4a4a' fontname='Roboto'>TOO_MANY_REJECTED_ORDERS       ---    You have been declining orders</run>
              <run>Æ&#10;</run>
              <run fontcolor='#4a4a4a' fontname='Roboto'>UNREACHABLE                          ---     You had connectivity issues</run>
              <run>Æ&#10;</run>
              <run fontcolor='#4a4a4a' fontname='Roboto'>ORDER_FAILURE                        ---       You have been declining orders</run>
              <run>Æ&#10;</run>
              <run fontcolor='#4a4a4a' fontname='Roboto'>COURIER_DELAYED_AT_PICKUP    ---     You kept riders waiting for too long</run>
              <run>Æ&#10;</run>
              <run fontcolor='#4a4a4a' fontname='Roboto'>RESTRICTED_VISIBILITY           ---   You will not receive orders during this period</run>
              <run>Æ&#10;</run>
              <run fontcolor='#4a4a4a' fontname='Roboto'>BAD_WEATHER                         ---     Due to bad weather</run>
              <run>Æ&#10;</run>
              <run fontcolor='#4a4a4a' fontname='Roboto'>HOLIDAY_SPECIAL_SCHEDULE        ---    There is a change in your schedule</run>
              <run>Æ&#10;</run>
              <run fontcolor='#4a4a4a' fontname='Roboto'>REFURBISHMENT                       ---      You will not receive orders during this period</run>
              <run>Æ&#10;</run>
              <run fontcolor='#4a4a4a' fontname='Roboto'>CHECK_IN_REQUIRED               ---    You did not check-in</run>
              <run>Æ&#10;</run>
              <run fontcolor='#4a4a4a' fontname='Roboto'>CHECK_IN_FAILED                     ---    You have been unavailable at the end of the day</run>
              <run>Æ&#10;</run>
              <run fontcolor='#4a4a4a' fontname='Roboto'>AREA_DISRUPTION                    ---      Due to area disruption</run>
              <run>Æ&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='16' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='98000' id='15' param='vert' type-v2='layout-flow' w='98400' x='800' y='1000'>
                <zone forceUpdate='true' h='98000' id='7' type-v2='text' w='98400' x='800' y='1000'>
                  <formatted-text>
                    <run>Æ&#10;&#10;&#10;&#10;&#10;</run>
                    <run bold='true' fontsize='10'>DEFINITIONS:</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b'>Offline hours</run>
                    <run fontcolor='#1b1b1b'> - The duration, in seconds, that the vendor was offline on platform during the given schedule slot. The sum of offline_duration_seconds and device_unreachable_duration_seconds may add up to a value greater than slot_duration_seconds as these columns are not mutually exclusive</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b'>Scheduled hours</run>
                    <run fontcolor='#1b1b1b'> - The duration, in seconds, for the given schedule slot.  A slot is a period of time that the vendor is available for receiving orders.</run>
                    <run>Æ&#10;&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b'>Total Unreachable hours</run>
                    <run fontcolor='#1b1b1b'> - The duration, in seconds, for which the vendor&apos;s device was not reachable during the given schedule slot. The sum of offline_duration_seconds and device_unreachable_duration_seconds may add up to a value greater than slot_duration_seconds as these columns are not mutually exclusive</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b'>Offline reason </run>
                    <run fontcolor='#1b1b1b'>- The reason for the given unavailable event. If the vendor is offline on platform (is_offline_on_platform = TRUE), this specifies the reason why by Monitor or Client.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b'>Lost orders per day </run>
                    <run fontcolor='#1b1b1b'>- To find this, we add up the orders from the month before the one we&apos;re interested in (as determined by the exact day month filter) and divide that total by the number of days in the chosen month.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000'>Offline reasons:</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#4a4a4a' fontname='Roboto' fontsize='12'>Closed Reason Mapping        Messages that will appear</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#4a4a4a' fontname='Roboto'>TOO_BUSY_NO_DRIVERS        --- Self-closed due to lack of your own riders</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#4a4a4a' fontname='Roboto'>TOO_BUSY_KITCHEN               ---  You are too busy</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#4a4a4a' fontname='Roboto'>UPDATES_IN_MENU                 ---     Due to menu updates</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#4a4a4a' fontname='Roboto'>TECHNICAL_PROBLEM             ---         Due to technical issues</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#4a4a4a' fontname='Roboto'>CLOSED                                      ---         You will not receive orders during this period</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#4a4a4a' fontname='Roboto'>OTHER                                        ---      You will not receive orders during this period</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#4a4a4a' fontname='Roboto'>TOO_MANY_REJECTED_ORDERS       ---    You have been declining orders</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#4a4a4a' fontname='Roboto'>UNREACHABLE                          ---     You had connectivity issues</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#4a4a4a' fontname='Roboto'>ORDER_FAILURE                        ---       You have been declining orders</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#4a4a4a' fontname='Roboto'>COURIER_DELAYED_AT_PICKUP    ---     You kept riders waiting for too long</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#4a4a4a' fontname='Roboto'>RESTRICTED_VISIBILITY           ---   You will not receive orders during this period</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#4a4a4a' fontname='Roboto'>BAD_WEATHER                         ---     Due to bad weather</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#4a4a4a' fontname='Roboto'>HOLIDAY_SPECIAL_SCHEDULE        ---    There is a change in your schedule</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#4a4a4a' fontname='Roboto'>REFURBISHMENT                       ---      You will not receive orders during this period</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#4a4a4a' fontname='Roboto'>CHECK_IN_REQUIRED               ---    You did not check-in</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#4a4a4a' fontname='Roboto'>CHECK_IN_FAILED                     ---    You have been unavailable at the end of the day</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#4a4a4a' fontname='Roboto'>AREA_DISRUPTION                    ---      Due to area disruption</run>
                    <run>Æ&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
