          <datasource-dependencies datasource='federated.0m9j49t08lxn7w1a2otdt1jgqn7i'>
            <column caption='Lost Platform Covered mau' datatype='integer' name='[Calculation_273030790326022146]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([lastest_platform_c]) - SUM([lastmonth_platform_c])' />
            </column>
            <column caption='Active stores' datatype='integer' name='[Calculation_273030790387470340]' role='measure' type='quantitative'>
