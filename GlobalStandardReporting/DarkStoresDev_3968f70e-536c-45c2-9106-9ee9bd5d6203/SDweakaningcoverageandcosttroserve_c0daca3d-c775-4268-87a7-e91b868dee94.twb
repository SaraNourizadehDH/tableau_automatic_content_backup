    <worksheet name='Regional city closure and reductions'>
      <table>
        <view>
          <datasources>
            <datasource caption='clsosed_st (dev_dmart)' name='federated.0m9j49t08lxn7w1a2otdt1jgqn7i' />
          </datasources>
          <datasource-dependencies datasource='federated.0m9j49t08lxn7w1a2otdt1jgqn7i'>
            <column caption=' Cities with reductions(20%-99%) at city level' datatype='real' name='[% of Cities with 100% Closures (copy)_1423207914207457297]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[% of Dmart footprint 100% 1 city level (copy)_1423207914207367184]/[Calculation_1423207914203721739]' />
            </column>
            <column caption=' Cities with minimal reductions(&lt;20%) at city level' datatype='real' name='[% of Cities with reductions(20%-99%) at city level (copy)_1423207914208358422]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[% of Dmart footprint 20-990% 1 city level (copy)_1423207914208161813]/[Calculation_1423207914203721739]' />
            </column>
            <column caption='% of Dmart footprint 20-99% 1_1 city, region' datatype='integer' name='[% of Dmart footprint 100% 1 city level (copy)_1423207914207367184]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({ FIXED [region],[city] : ([% of Dmart footprint 100% 1_0 (copy)_1423207914207166479])})' />
            </column>
            <column caption='% of Dmart footprint 20-99% 1_0 city,region' datatype='integer' name='[% of Dmart footprint 100% 1_0 (copy)_1423207914207166479]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_273030790388916231] &gt;= 0.2 AND [Calculation_273030790388916231] &lt;= 0.9  THEN COUNTD([city]) ELSE 0 END' />
            </column>
            <column caption='% of Dmart footprint &lt;20% 1_0 city,region' datatype='integer' name='[% of Dmart footprint 20-99% 1_0 (copy)_1423207914208002068]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_273030790388916231] &lt; 0.2  THEN COUNTD([city]) ELSE 0 END' />
            </column>
            <column caption='% of Dmart footprint &lt;20% 1_1 city, region' datatype='integer' name='[% of Dmart footprint 20-990% 1 city level (copy)_1423207914208161813]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({ FIXED [region],[city] : ([% of Dmart footprint 20-99% 1_0 (copy)_1423207914208002068])})' />
            </column>
            <column caption='% of Dmart footprint 100% 1_0 city, region' datatype='integer' name='[Calculation_1423207914188562432]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_273030790388916231] = 1 THEN COUNTD([city]) ELSE 0 END' />
            </column>
            <column caption='% of Dmart footprint 100% 1_1 city,region' datatype='integer' name='[Calculation_1423207914192384001]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({ FIXED [region],[city] : ([Calculation_1423207914188562432])})' />
            </column>
            <column caption='No of cities with closed stores' datatype='integer' name='[Calculation_1423207914203721739]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([city])' />
            </column>
            <column caption='  Cities with 100% Closures' datatype='real' name='[Calculation_1423207914206519310]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1423207914192384001]/[Calculation_1423207914203721739]' />
            </column>
            <column caption='Active stores' datatype='integer' name='[Calculation_273030790387470340]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([opened_order_date])' />
            </column>
            <column caption='Closed stores' datatype='integer' name='[Calculation_273030790387605509]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([closed_order_date])' />
            </column>
            <column caption='Warehouse count' datatype='integer' name='[Calculation_273030790388695046]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_273030790387470340]) + ([Calculation_273030790387605509])' />
            </column>
            <column caption=' Dmart footprint closed' datatype='real' name='[Calculation_273030790388916231]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_273030790387605509]/[Calculation_273030790388695046]' />
            </column>
