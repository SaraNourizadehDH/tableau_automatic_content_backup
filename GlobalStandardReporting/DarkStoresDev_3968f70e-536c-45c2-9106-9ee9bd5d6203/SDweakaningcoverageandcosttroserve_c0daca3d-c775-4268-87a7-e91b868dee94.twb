              <calculation class='tableau' formula='IF [Calculation_273030790388916231] &gt;= 0.2 AND [Calculation_273030790388916231] &lt;= 0.9  THEN COUNTD([city]) ELSE 0 END' />
            </column>
            <column caption='% of Dmart footprint 100% 1_1 global' datatype='integer' name='[% of Dmart footprint 100% 1_1 city,region (copy)_2156942810248069122]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({ FIXED [city] : ([Calculation_1423207914188562432])})' />
            </column>
            <column caption='% of Dmart footprint &lt;20% 1_0 city,region' datatype='integer' name='[% of Dmart footprint 20-99% 1_0 (copy)_1423207914208002068]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_273030790388916231] &lt; 0.2  THEN COUNTD([city]) ELSE 0 END' />
            </column>
            <column caption='% of Dmart footprint 20-99% 1_1 global' datatype='integer' name='[% of Dmart footprint 20-99% 1_1 city, region (copy)_2156942810248175619]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({ FIXED [city] : ([% of Dmart footprint 100% 1_0 (copy)_1423207914207166479])})' />
