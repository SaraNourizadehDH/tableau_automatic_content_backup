            </column>
            <column caption='Wallet Orders Share - diff' datatype='real' name='[Wallet GMV - diff (copy)_3979141431016235029]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1172343312228970502])/([Wallet Transactions Share - reporting p. (copy)_3979141431016071188])-1' />
            </column>
            <column caption='Wallet Successful Orders - previous p.' datatype='integer' name='[Wallet Successful Purchases - reporting p. (copy)_3979141431013138446]' role='measure' type='quantitative'>
