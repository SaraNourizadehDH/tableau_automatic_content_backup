              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;Daily&apos; THEN (str(DATEPART(&apos;day&apos;, [topup_date])) + &quot;.&quot; + str(DATEPART(&apos;month&apos;, [topup_date])) + &quot;.&quot; + str(DATEPART(&apos;year&apos;, [topup_date])))&#10;WHEN &apos;Weekly&apos; THEN (str(DATE(DATETRUNC(&apos;week&apos;, [topup_date], &apos;Sunday&apos;))))&#10;WHEN &apos;Monthly&apos; THEN (str(LEFT(DATENAME(&apos;month&apos;, [topup_date]),3)) + &quot; &quot; + str(DATEPART(&apos;year&apos;, [topup_date])))&#10;WHEN &apos;Quarterly&apos; THEN (&quot;Q&quot; + str(DATEPART(&apos;quarter&apos;, [topup_date])) + &quot; &quot; + str(DATEPART(&apos;year&apos;, [topup_date])))&#10;WHEN &apos;Yearly&apos; THEN str(DATEPART(&apos;year&apos;, [topup_date]))&#10;END' />
