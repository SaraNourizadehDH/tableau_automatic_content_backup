      <aliases enabled='yes' />
      <column caption='% wallet refunds (PP)' datatype='real' name='[% wallet refunds (TP) (copy)_377809839358734357]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Total # Refunds (PP) (copy)_377809839336034320]/[Total # Refunds (TP) (copy)_377809839315013639]' />
      </column>
      <column caption='% wallet refunds (TP)' datatype='real' name='[% wallet refunds line (copy)_377809839357427732]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Total # Refunds (TP) (copy)_377809839336034323]/[Total Refund TPV (copy)_4996251255114166274]' />
      </column>
      <column caption='Avg TPV p. Refund (PP)' datatype='real' name='[Avg TPV p. Refund (TP) (copy)_377809839319343117]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Total Refund TPV (TP) (copy)_377809839314063366]/[Total # Refunds (TP) (copy)_377809839315013639]' />
      </column>
      <column caption='Avg TPV p. Refund (comp.)' datatype='real' name='[Avg TPV p. Refund (comp.) (copy)_377809839359471638]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Avg TPV p. Refund Line (copy)_377809839319207948]/[Avg TPV p. Refund (TP) (copy)_377809839319343117]-1' />
      </column>
      <column caption='Avg TPV p. Refund (TP)' datatype='real' name='[Avg TPV p. Refund Line (copy)_377809839319207948]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_4996251255109521408]/[Total Refund TPV (copy)_4996251255114166274]' />
      </column>
      <column caption='Date Level' datatype='string' name='[Calculation_1172343312207818756]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;Daily&apos; THEN (str(DATEPART(&apos;day&apos;, [refund_date])) + &quot;.&quot; + str(DATEPART(&apos;month&apos;, [refund_date])) + &quot;.&quot; + str(DATEPART(&apos;year&apos;, [refund_date])))&#10;WHEN &apos;Weekly&apos; THEN (str(DATE(DATETRUNC(&apos;week&apos;, [refund_date], &apos;Sunday&apos;))))&#10;WHEN &apos;Monthly&apos; THEN (str(LEFT(DATENAME(&apos;month&apos;, [refund_date]),3)) + &quot; &quot; + str(DATEPART(&apos;year&apos;, [refund_date])))&#10;WHEN &apos;Quarterly&apos; THEN (&quot;Q&quot; + str(DATEPART(&apos;quarter&apos;, [refund_date])) + &quot; &quot; + str(DATEPART(&apos;year&apos;, [refund_date])))&#10;WHEN &apos;Yearly&apos; THEN str(DATEPART(&apos;year&apos;, [refund_date]))&#10;END' />
      </column>
      <column caption='Date Range String' datatype='string' name='[Calculation_1172343312430047241]' role='measure' type='nominal'>
        <calculation class='tableau' formula='(&#10;str(day(min([Parameters].[Parameter 5])))+&quot;/&quot;+&#10;str(month(min([Parameters].[Parameter 5])))+&quot;/&quot;+&#10;str(year(min([Parameters].[Parameter 5])))+&quot; to &quot;+&#10;str(day(max([Parameters].[From: (copy)_377809839310106625])))+&quot;/&quot;+&#10;str(month(max([Parameters].[From: (copy)_377809839310106625])))+&quot;/&quot;+&#10;str(year(max([Parameters].[From: (copy)_377809839310106625])))&#10;)' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_1172343312897859599]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='This Period' datatype='boolean' name='[Calculation_377809839310938114]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[refund_date] &gt;= [Parameters].[Parameter 5] and [refund_date] &lt;= [Parameters].[From: (copy)_377809839310106625]' />
      </column>
      <column caption='Last Period' datatype='boolean' name='[Calculation_377809839311937540]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[refund_date] &gt;= DATEADD([Parameters].[Parameter 6], -1, [Parameters].[Parameter 5]) and [refund_date] &lt;= DATEADD([Parameters].[Parameter 6], -1, [Parameters].[From: (copy)_377809839310106625])' />
      </column>
      <column caption='Period Filter' datatype='boolean' name='[Calculation_377809839313043461]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_377809839311937540] or [Calculation_377809839310938114]' />
      </column>
      <column caption='Refunds Active Users Liine' datatype='real' name='[Calculation_4904912626928287744]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;    WHEN &apos;Daily&apos; THEN SUM({FIXED [global_entity_id], [refund_date] : AVG([num_customers_daily])})&#10;    WHEN &apos;Weekly&apos; THEN SUM({FIXED [global_entity_id], [refund_week] : AVG([num_customers_weekly])})&#10;    WHEN &apos;Monthly&apos; THEN SUM({FIXED [global_entity_id], [refund_month] : AVG([num_customers_monthly])})&#10;    WHEN &apos;Quarterly&apos; THEN SUM({FIXED [global_entity_id], [refund_quarter] : AVG([num_customers_quartery])})&#10;    WHEN &apos;Yearly&apos; THEN SUM({FIXED [global_entity_id], [refund_year] : AVG([num_customers_yearly])})&#10;END' />
