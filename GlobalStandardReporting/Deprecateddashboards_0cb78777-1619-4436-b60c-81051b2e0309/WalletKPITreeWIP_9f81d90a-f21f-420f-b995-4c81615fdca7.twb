            <column caption='To' datatype='date' name='[From: (copy)_377809839310106625]' param-domain-type='range' role='measure' type='quantitative' value='#2023-06-30#'>
              <calculation class='tableau' formula='#2023-06-30#' />
              <range min='#2023-01-01#' />
            </column>
            <column caption='From' datatype='date' name='[Parameter 5]' param-domain-type='range' role='measure' type='quantitative' value='#2023-06-01#'>
