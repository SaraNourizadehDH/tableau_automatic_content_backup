            <column alias='previous month' caption='Previous Period' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='previous day' />
                <alias key='&quot;month&quot;' value='previous month' />
