            <column caption='Wallet Successful Orders - reporting p.' datatype='integer' name='[Calculation_3979141431012823053]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Calculation_3979141431003664385],[n_wallet_successful_purchases],Null)' />
