              <calculation class='tableau' formula='DATEADD(&apos;day&apos;,([Calculation_3979141431003877379]+1)*-1,[Parameters].[Parameter 3]) &lt;= [date]&#10;AND&#10;DATEADD(&apos;day&apos;,([Calculation_3979141431003877379]+1)*-1,[Parameters].[Start Date (copy)_1950058650536071168]) &gt;= [date]' />
            </column>
            <column caption='period_length' datatype='integer' name='[Calculation_3979141431003877379]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Parameters].[Parameter 3], [Parameters].[Start Date (copy)_1950058650536071168])' />
            </column>
            <column caption='Wallet GMV - reporting p.' datatype='real' name='[Calculation_3979141431004774404]' role='measure' type='quantitative'>
