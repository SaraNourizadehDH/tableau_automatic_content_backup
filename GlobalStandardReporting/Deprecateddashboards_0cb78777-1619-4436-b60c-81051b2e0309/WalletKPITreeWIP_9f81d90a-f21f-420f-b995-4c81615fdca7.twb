      <aliases enabled='yes' />
      <column caption='Date Level' datatype='string' name='[Calculation_5498332246219292673]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;Daily&apos; THEN (str(DATEPART(&apos;day&apos;, [topup_date])) + &quot;.&quot; + str(DATEPART(&apos;month&apos;, [topup_date])) + &quot;.&quot; + str(DATEPART(&apos;year&apos;, [topup_date])))&#10;WHEN &apos;Weekly&apos; THEN (str(DATE(DATETRUNC(&apos;week&apos;, [topup_date], &apos;Sunday&apos;))))&#10;WHEN &apos;Monthly&apos; THEN (str(LEFT(DATENAME(&apos;month&apos;, [topup_date]),3)) + &quot; &quot; + str(DATEPART(&apos;year&apos;, [topup_date])))&#10;WHEN &apos;Quarterly&apos; THEN (&quot;Q&quot; + str(DATEPART(&apos;quarter&apos;, [topup_date])) + &quot; &quot; + str(DATEPART(&apos;year&apos;, [topup_date])))&#10;WHEN &apos;Yearly&apos; THEN str(DATEPART(&apos;year&apos;, [topup_date]))&#10;END' />
      </column>
      <column caption='ATV' datatype='real' name='[Calculation_5498332246227361794]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([amount_eur])/sum([topup_txns])' />
      </column>
      <column caption='Success Rate' datatype='real' name='[Calculation_5498332246230446083]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([completed_trx_count])/SUM([topup_trx_count])' />
      </column>
      <column caption='Active Customers' datatype='integer' name='[Calculation_5498332246234357765]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;    WHEN &apos;Daily&apos; THEN SUM({FIXED [global_entity_id], [topup_date] : MAX([n_customers])})&#10;    WHEN &apos;Weekly&apos; THEN SUM({FIXED [global_entity_id], [Calculation_6167609365991493634] : MAX([n_customers_weekly])})&#10;    WHEN &apos;Monthly&apos; THEN SUM({FIXED [global_entity_id], [Purchase Week (copy)_6167609365992333316] : MAX([n_customers_monthly])})&#10;    WHEN &apos;Quarterly&apos; THEN SUM({FIXED [global_entity_id], [Purchase Month (copy)_6167609365992673285] : MAX([n_customers_quarterly])})&#10;    WHEN &apos;Yearly&apos; THEN SUM({FIXED [global_entity_id], [Purchase Quarter (copy)_6167609365992775686] : MAX([n_customers_yearly])})&#10;END' />
      </column>
      <column caption='Week' datatype='date' name='[Calculation_6167609365991493634]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;, [topup_date], &apos;Sunday&apos;))' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_6872211618189869056]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Quarter' datatype='date' name='[Purchase Month (copy)_6167609365992673285]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;quarter&apos;, [topup_date]))' />
      </column>
      <column caption='Year' datatype='date' name='[Purchase Quarter (copy)_6167609365992775686]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;year&apos;, [topup_date]))' />
      </column>
      <column caption='Month' datatype='date' name='[Purchase Week (copy)_6167609365992333316]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [topup_date]))' />
      </column>
