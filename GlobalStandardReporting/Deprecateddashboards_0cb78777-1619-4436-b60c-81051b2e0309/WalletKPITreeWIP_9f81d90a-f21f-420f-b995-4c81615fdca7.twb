              <calculation class='tableau' formula='(ZN(SUM([Calculation_3979141431012823053])) - LOOKUP(ZN(SUM([Calculation_3979141431012823053])), -1)) / ABS(LOOKUP(ZN(SUM([Calculation_3979141431012823053])), -1))'>
