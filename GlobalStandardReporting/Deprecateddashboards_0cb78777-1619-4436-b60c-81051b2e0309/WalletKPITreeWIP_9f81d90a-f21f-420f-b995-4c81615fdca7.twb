      <aliases enabled='yes' />
      <column caption='Wallet AOF - reporting p. ' datatype='real' name='[Average Wallet Active Customers (copy)_6167609366045655051]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;    WHEN &apos;Daily&apos; THEN ({FIXED [global_entity_id], [date] : SUM([Calculation_3979141431012823053])})/({FIXED [global_entity_id], [date] : MAX([n_wallet_customers_daily])})&#10;    WHEN &apos;Weekly&apos; THEN ({FIXED [global_entity_id], [Calculation_6167609365991493634] : SUM([Calculation_3979141431012823053])})/({FIXED [global_entity_id], [Calculation_6167609365991493634] : MAX([n_wallet_customers_weekly])})&#10;    WHEN &apos;Monthly&apos; THEN ({FIXED [global_entity_id], [Purchase Week (copy)_6167609365992333316] : SUM([Calculation_3979141431012823053])})/({FIXED [global_entity_id], [Purchase Week (copy)_6167609365992333316] : MAX([n_wallet_customers_monthly])})&#10;    WHEN &apos;Quarterly&apos; THEN ({FIXED [global_entity_id], [Purchase Month (copy)_6167609365992673285] : SUM([Calculation_3979141431012823053])})/({FIXED [global_entity_id], [Purchase Month (copy)_6167609365992673285] : MAX([n_wallet_customers_quarterly])})&#10;    WHEN &apos;Yearly&apos; THEN ({FIXED [global_entity_id], [Purchase Quarter (copy)_6167609365992775686] : SUM([Calculation_3979141431012823053])})/({FIXED [global_entity_id], [Purchase Quarter (copy)_6167609365992775686] : MAX([n_wallet_customers_yearly])})&#10;END' />
      </column>
      <column caption='Wallet Customers with Balance - reporting p.' datatype='real' name='[Average Wallet Active Customers (copy)_6167609366057869326]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;    WHEN &apos;Daily&apos; THEN AVG({FIXED [global_entity_id], [date] : MAX(IIF([Calculation_3979141431003664385],[n_wallets_w_balance_daily],Null))}) * COUNTD([global_entity_id])&#10;    WHEN &apos;Weekly&apos; THEN AVG({FIXED [global_entity_id], [Calculation_6167609365991493634] : MAX(IIF([Calculation_3979141431003664385],[n_wallets_w_balance_weekly],Null))}) * COUNTD([global_entity_id])&#10;    WHEN &apos;Monthly&apos; THEN AVG({FIXED [global_entity_id], [Purchase Week (copy)_6167609365992333316] : MAX(IIF([Calculation_3979141431003664385],[n_wallets_w_balance_monthly],Null))}) * COUNTD([global_entity_id])&#10;    WHEN &apos;Quarterly&apos; THEN AVG({FIXED [global_entity_id], [Purchase Month (copy)_6167609365992673285] : MAX(IIF([Calculation_3979141431003664385],[n_wallets_w_balance_quarterly],Null))}) * COUNTD([global_entity_id])&#10;    WHEN &apos;Yearly&apos; THEN AVG({FIXED [global_entity_id], [Purchase Quarter (copy)_6167609365992775686] : MAX(IIF([Calculation_3979141431003664385],[n_wallets_w_balance_yearly],Null))}) * COUNTD([global_entity_id])&#10;END' />
      </column>
      <column caption='Average Wallet Active Customers - previous p.' datatype='real' name='[Average Wallet Active Customers - reporting p. (copy)_3979141431393607710]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;    WHEN &apos;Daily&apos; THEN AVG({FIXED [global_entity_id], [date] : MAX(IIF([Calculation_3979141431003758594],[n_new_wallet_customers_daily],Null))}) * COUNTD([global_entity_id])&#10;    WHEN &apos;Weekly&apos; THEN AVG({FIXED [global_entity_id], [Calculation_6167609365991493634] : MAX(IIF([Calculation_3979141431003758594],[n_new_wallet_customers_weekly],Null))}) * COUNTD([global_entity_id])&#10;    WHEN &apos;Monthly&apos; THEN AVG({FIXED [global_entity_id], [Purchase Week (copy)_6167609365992333316] : MAX(IIF([Calculation_3979141431003758594],[n_new_wallet_customers_monthly],Null))}) * COUNTD([global_entity_id])&#10;    WHEN &apos;Quarterly&apos; THEN AVG({FIXED [global_entity_id], [Purchase Month (copy)_6167609365992673285] : MAX(IIF([Calculation_3979141431003758594],[n_new_wallet_customers_quarterly],Null))}) * COUNTD([global_entity_id])&#10;    WHEN &apos;Yearly&apos; THEN AVG({FIXED [global_entity_id], [Purchase Quarter (copy)_6167609365992775686] : MAX(IIF([Calculation_3979141431003758594],[n_new_wallet_customers_yearly],Null))}) * COUNTD([global_entity_id])&#10;END' />
      </column>
      <column caption='Period over period string' datatype='string' name='[Average Wallet Customers with Balance - reporting p. (copy)_3979141431397720098]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;    WHEN &apos;Daily&apos; THEN &apos;DoD&apos;&#10;    WHEN &apos;Weekly&apos; THEN &apos;WoW&apos;&#10;    WHEN &apos;Monthly&apos; THEN &apos;MoM&apos;&#10;    WHEN &apos;Quarterly&apos; THEN &apos;QoQ&apos;&#10;    WHEN &apos;Yearly&apos; THEN &apos;YoY&apos;&#10;END' />
      </column>
      <column caption='Date Level' datatype='string' name='[Calculation_1172343312207818756]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;Daily&apos; THEN (str(DATEPART(&apos;day&apos;, [date])) + &quot;.&quot; + str(DATEPART(&apos;month&apos;, [date])) + &quot;.&quot; + str(DATEPART(&apos;year&apos;, [date])))&#10;WHEN &apos;Weekly&apos; THEN (str(DATE(DATETRUNC(&apos;week&apos;, [date], &apos;Sunday&apos;))))&#10;WHEN &apos;Monthly&apos; THEN (str(LEFT(DATENAME(&apos;month&apos;, [date]),3)) + &quot; &quot; + str(DATEPART(&apos;year&apos;, [date])))&#10;WHEN &apos;Quarterly&apos; THEN (&quot;Q&quot; + str(DATEPART(&apos;quarter&apos;, [date])) + &quot; &quot; + str(DATEPART(&apos;year&apos;, [date])))&#10;WHEN &apos;Yearly&apos; THEN str(DATEPART(&apos;year&apos;, [date]))&#10;END' />
      </column>
      <column caption='Wallet Orders Share - reporting p.' datatype='real' name='[Calculation_1172343312228970502]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_3979141431012823053]) / SUM([Wallet Successful Purchases - reporting p. (copy)_3979141431015735314])' />
      </column>
      <column caption='Wallet Orders Success Rate - reporting p.' datatype='real' name='[Calculation_1172343312234401800]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_3979141431012823053]) / SUM([Wallet Successful Purchases - reporting p. (copy)_3979141431242428439])' />
      </column>
      <column caption='Date Range String' datatype='string' name='[Calculation_1172343312430047241]' role='measure' type='nominal'>
        <calculation class='tableau' formula='(&#10;str(day(min([date])))+&quot;/&quot;+&#10;str(month(min([date])))+&quot;/&quot;+&#10;str(year(min([date])))+&quot; to &quot;+&#10;str(day(max([date])))+&quot;/&quot;+&#10;str(month(max([date])))+&quot;/&quot;+&#10;str(year(max([date])))&#10;)' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_1172343312897859599]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Wallet AOV - reporting p.' datatype='real' name='[Calculation_1172343313218686992]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_3979141431004774404])/SUM([Calculation_3979141431012823053])' />
      </column>
      <column caption='is_reporting_period' datatype='boolean' name='[Calculation_3979141431003664385]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 3] &lt;=  [date]&#10;AND&#10;[Parameters].[Start Date (copy)_1950058650536071168] &gt;= [date]' />
      </column>
      <column caption='is_previous_period' datatype='boolean' name='[Calculation_3979141431003758594]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEADD(&apos;day&apos;,([Calculation_3979141431003877379]+1)*-1,[Parameters].[Parameter 3]) &lt;= [date]&#10;AND&#10;DATEADD(&apos;day&apos;,([Calculation_3979141431003877379]+1)*-1,[Parameters].[Start Date (copy)_1950058650536071168]) &gt;= [date]' />
      </column>
      <column caption='period_length' datatype='integer' name='[Calculation_3979141431003877379]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Parameters].[Parameter 3], [Parameters].[Start Date (copy)_1950058650536071168])' />
      </column>
      <column caption='Wallet GMV - reporting p.' datatype='real' name='[Calculation_3979141431004774404]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Calculation_3979141431003664385],[wallet_successful_gmv_eur],Null)' />
      </column>
      <column caption='Wallet GMV - diff' datatype='real' name='[Calculation_3979141431005855750]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_3979141431004774404])/SUM([Wallet GMV - reporting p. (copy)_3979141431004868613])-1' />
