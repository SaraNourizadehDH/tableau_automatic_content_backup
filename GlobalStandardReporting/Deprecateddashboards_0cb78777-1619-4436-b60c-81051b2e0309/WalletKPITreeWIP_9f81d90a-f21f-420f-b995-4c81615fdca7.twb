              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;Daily&apos; THEN (str(DATEPART(&apos;day&apos;, [refund_date])) + &quot;.&quot; + str(DATEPART(&apos;month&apos;, [refund_date])) + &quot;.&quot; + str(DATEPART(&apos;year&apos;, [refund_date])))&#10;WHEN &apos;Weekly&apos; THEN (str(DATE(DATETRUNC(&apos;week&apos;, [refund_date], &apos;Sunday&apos;))))&#10;WHEN &apos;Monthly&apos; THEN (str(LEFT(DATENAME(&apos;month&apos;, [refund_date]),3)) + &quot; &quot; + str(DATEPART(&apos;year&apos;, [refund_date])))&#10;WHEN &apos;Quarterly&apos; THEN (&quot;Q&quot; + str(DATEPART(&apos;quarter&apos;, [refund_date])) + &quot; &quot; + str(DATEPART(&apos;year&apos;, [refund_date])))&#10;WHEN &apos;Yearly&apos; THEN str(DATEPART(&apos;year&apos;, [refund_date]))&#10;END' />
            </column>
            <column caption='Total # Refunds Line' datatype='integer' name='[Total # Refunds (TP) (copy)_377809839318896651]' role='measure' type='quantitative'>
