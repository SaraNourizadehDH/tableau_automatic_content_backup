          <datasource-dependencies datasource='federated.1lurkx306xdkqg1acz96416olnny'>
            <column caption='Wallet Customers with Balance - reporting p.' datatype='real' name='[Average Wallet Active Customers (copy)_6167609366057869326]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;    WHEN &apos;Daily&apos; THEN AVG({FIXED [global_entity_id], [date] : MAX(IIF([Calculation_3979141431003664385],[n_wallets_w_balance_daily],Null))}) * COUNTD([global_entity_id])&#10;    WHEN &apos;Weekly&apos; THEN AVG({FIXED [global_entity_id], [Calculation_6167609365991493634] : MAX(IIF([Calculation_3979141431003664385],[n_wallets_w_balance_weekly],Null))}) * COUNTD([global_entity_id])&#10;    WHEN &apos;Monthly&apos; THEN AVG({FIXED [global_entity_id], [Purchase Week (copy)_6167609365992333316] : MAX(IIF([Calculation_3979141431003664385],[n_wallets_w_balance_monthly],Null))}) * COUNTD([global_entity_id])&#10;    WHEN &apos;Quarterly&apos; THEN AVG({FIXED [global_entity_id], [Purchase Month (copy)_6167609365992673285] : MAX(IIF([Calculation_3979141431003664385],[n_wallets_w_balance_quarterly],Null))}) * COUNTD([global_entity_id])&#10;    WHEN &apos;Yearly&apos; THEN AVG({FIXED [global_entity_id], [Purchase Quarter (copy)_6167609365992775686] : MAX(IIF([Calculation_3979141431003664385],[n_wallets_w_balance_yearly],Null))}) * COUNTD([global_entity_id])&#10;END' />
            </column>
            <column caption='Period over period string' datatype='string' name='[Average Wallet Customers with Balance - reporting p. (copy)_3979141431397720098]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;    WHEN &apos;Daily&apos; THEN &apos;DoD&apos;&#10;    WHEN &apos;Weekly&apos; THEN &apos;WoW&apos;&#10;    WHEN &apos;Monthly&apos; THEN &apos;MoM&apos;&#10;    WHEN &apos;Quarterly&apos; THEN &apos;QoQ&apos;&#10;    WHEN &apos;Yearly&apos; THEN &apos;YoY&apos;&#10;END' />
            </column>
            <column caption='Date Level' datatype='string' name='[Calculation_1172343312207818756]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;Daily&apos; THEN (str(DATEPART(&apos;day&apos;, [date])) + &quot;.&quot; + str(DATEPART(&apos;month&apos;, [date])) + &quot;.&quot; + str(DATEPART(&apos;year&apos;, [date])))&#10;WHEN &apos;Weekly&apos; THEN (str(DATE(DATETRUNC(&apos;week&apos;, [date], &apos;Sunday&apos;))))&#10;WHEN &apos;Monthly&apos; THEN (str(LEFT(DATENAME(&apos;month&apos;, [date]),3)) + &quot; &quot; + str(DATEPART(&apos;year&apos;, [date])))&#10;WHEN &apos;Quarterly&apos; THEN (&quot;Q&quot; + str(DATEPART(&apos;quarter&apos;, [date])) + &quot; &quot; + str(DATEPART(&apos;year&apos;, [date])))&#10;WHEN &apos;Yearly&apos; THEN str(DATEPART(&apos;year&apos;, [date]))&#10;END' />
            </column>
            <column caption='is_reporting_period' datatype='boolean' name='[Calculation_3979141431003664385]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 3] &lt;=  [date]&#10;AND&#10;[Parameters].[Start Date (copy)_1950058650536071168] &gt;= [date]' />
            </column>
            <column caption='Week' datatype='date' name='[Calculation_6167609365991493634]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;, [date], &apos;Sunday&apos;))' />
            </column>
            <column caption='Quarter' datatype='date' name='[Purchase Month (copy)_6167609365992673285]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;quarter&apos;, [date]))' />
            </column>
            <column caption='Year' datatype='date' name='[Purchase Quarter (copy)_6167609365992775686]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;year&apos;, [date]))' />
            </column>
            <column caption='Month' datatype='date' name='[Purchase Week (copy)_6167609365992333316]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [date]))' />
            </column>
            <column caption='Wallet Customers with Balance - % diff period over period' datatype='real' name='[Wallet Active Customers - % diff period over period (copy)_3979141431404101677]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(([Average Wallet Active Customers (copy)_6167609366057869326])) - LOOKUP(ZN(([Average Wallet Active Customers (copy)_6167609366057869326])), -1)) / ABS(LOOKUP(ZN(([Average Wallet Active Customers (copy)_6167609366057869326])), -1))'>
                <table-calc ordering-type='Rows' />
