              <calculation class='tableau' formula='DATEADD(&apos;day&apos;,([Calculation_3979141431003877379]+1)*-1,[Parameters].[Parameter 3]) &lt;= [date]&#10;AND&#10;DATEADD(&apos;day&apos;,([Calculation_3979141431003877379]+1)*-1,[Parameters].[Start Date (copy)_1950058650536071168]) &gt;= [date]' />
