            </column>
            <column-instance column='[Average Wallet Customers with Balance - reporting p. (copy)_3979141431397720098]' derivation='Attribute' name='[attr:Average Wallet Customers with Balance - reporting p. (copy)_3979141431397720098:nk]' pivot='key' type='nominal' />
