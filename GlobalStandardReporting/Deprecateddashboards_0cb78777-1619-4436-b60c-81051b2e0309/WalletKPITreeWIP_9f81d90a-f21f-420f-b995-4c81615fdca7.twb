            <column caption='Average Wallet Active Customers - reporting p.' datatype='real' name='[Wallet Active Customers (copy)_6167609365994885128]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;    WHEN &apos;Daily&apos; THEN AVG({FIXED [global_entity_id], [date] : MAX(IIF([Calculation_3979141431003664385],[n_new_wallet_customers_daily],Null))}) * COUNTD([global_entity_id])&#10;    WHEN &apos;Weekly&apos; THEN AVG({FIXED [global_entity_id], [Calculation_6167609365991493634] : MAX(IIF([Calculation_3979141431003664385],[n_new_wallet_customers_weekly],Null))}) * COUNTD([global_entity_id])&#10;    WHEN &apos;Monthly&apos; THEN AVG({FIXED [global_entity_id], [Purchase Week (copy)_6167609365992333316] : MAX(IIF([Calculation_3979141431003664385],[n_new_wallet_customers_monthly],Null))}) * COUNTD([global_entity_id])&#10;    WHEN &apos;Quarterly&apos; THEN AVG({FIXED [global_entity_id], [Purchase Month (copy)_6167609365992673285] : MAX(IIF([Calculation_3979141431003664385],[n_new_wallet_customers_quarterly],Null))}) * COUNTD([global_entity_id])&#10;    WHEN &apos;Yearly&apos; THEN AVG({FIXED [global_entity_id], [Purchase Quarter (copy)_6167609365992775686] : MAX(IIF([Calculation_3979141431003664385],[n_new_wallet_customers_yearly],Null))}) * COUNTD([global_entity_id])&#10;END' />
