            </column>
            <column caption='Wallet Orders Share - reporting p.' datatype='real' name='[Calculation_1172343312228970502]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_3979141431012823053]) / SUM([Wallet Successful Purchases - reporting p. (copy)_3979141431015735314])' />
            </column>
            <column caption='is_reporting_period' datatype='boolean' name='[Calculation_3979141431003664385]' role='dimension' type='nominal'>
