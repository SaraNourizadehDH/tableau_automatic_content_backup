          <datasource-dependencies datasource='federated.18k7k8k0z2ho3h15j7bd90qmqip7'>
            <column caption='Discount rate' datatype='string' name='[Calculation_1642125060188758025]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [filtered_discount_rate] &lt; 0.1 THEN &apos; &lt;10%&apos;&#13;&#10;ELSEIF [filtered_discount_rate] &lt; 0.2 THEN &apos;10-20%&apos;&#13;&#10;ELSEIF [filtered_discount_rate] &lt; 0.3 THEN &apos;20-30%&apos;&#13;&#10;ELSEIF [filtered_discount_rate] &lt; 0.4 THEN &apos;30-40%&apos;&#13;&#10;ELSEIF [filtered_discount_rate] &lt; 0.5 THEN &apos;40-50%&apos;&#13;&#10;ELSE &apos;50% +&apos;&#13;&#10;END' />
            </column>
            <column caption='record qty' datatype='integer' name='[Calculation_273030773109665792]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='count([sku])' />
