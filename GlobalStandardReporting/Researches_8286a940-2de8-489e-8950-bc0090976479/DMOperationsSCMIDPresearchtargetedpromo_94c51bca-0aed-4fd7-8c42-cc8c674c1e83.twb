            <column caption='BIAS baseline, all' datatype='real' default-format='p0%' name='[BIAS baseline (copy)_917045520219058176]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [target_audience] = &apos;ALL&apos; THEN [predicted_qty_baseline_filtered] END) &#13;&#10;/&#13;&#10;SUM(IF [target_audience] = &apos;ALL&apos; THEN [sold_qty_filtered] END)' />
