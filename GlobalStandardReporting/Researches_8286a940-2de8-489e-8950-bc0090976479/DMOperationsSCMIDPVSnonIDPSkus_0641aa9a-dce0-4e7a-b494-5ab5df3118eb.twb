            </column>
            <column caption='IDP PO  lines' datatype='integer' name='[Calculation_923800881694531584]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [idp_recommendation_flag] THEN [po_lines] ELSE 0 END)' />
