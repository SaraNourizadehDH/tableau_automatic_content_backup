      <aliases enabled='yes' />
      <column caption='Availability hourly simulated, % ' datatype='real' default-format='p0.0%' name='[Availability hourly initial, % (copy)_923800881696280578]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([available_hours_simulated]) / SUM([potential_hours])' />
      </column>
      <column caption='Initial fill rate, %' datatype='real' default-format='p0%' name='[Calculation_236720464554725376]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([quantity_delivered])/SUM([quantity_ordered])' />
      </column>
      <column caption='Availability hourly diff %' datatype='real' default-format='p0.0%' name='[Calculation_236720464620871681]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_923800881696382979]/[Calculation_923800881695141889]' />
      </column>
      <column caption='Sales diff gmv  EURO' datatype='real' name='[Calculation_400538899997925376]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sales_simulated_gmv]) - SUM([sales_initial_gmv])' />
      </column>
      <column caption='IDP adoption, %' datatype='real' default-format='p0%' name='[Calculation_412923798942064640]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_923800881694531584] / SUM([po_lines])' />
      </column>
      <column caption='IDP PO  lines' datatype='integer' name='[Calculation_923800881694531584]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [idp_recommendation_flag] THEN [po_lines] ELSE 0 END)' />
      </column>
      <column caption='Availability hourly initial, %' datatype='real' default-format='p0.0%' name='[Calculation_923800881695141889]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([available_hours_initial]) / SUM([potential_hours])' />
      </column>
      <column caption='Availability hourly diff pp' datatype='real' default-format='p0.0%' name='[Calculation_923800881696382979]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Availability hourly initial, % (copy)_923800881696280578]-[Calculation_923800881695141889]' />
      </column>
      <column caption='IDP po correction rate, %' datatype='real' default-format='p0%' name='[IDP adoption, % (copy)_412923798942347265]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([idp_corrected_po_lines])/[Calculation_923800881694531584]' />
