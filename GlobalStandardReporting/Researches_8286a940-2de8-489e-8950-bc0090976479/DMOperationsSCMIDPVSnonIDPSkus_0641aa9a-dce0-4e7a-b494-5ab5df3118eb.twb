              <calculation class='tableau' formula='[Availability hourly simulated, %  (copy)_470344699495817216]-[Calculation_923800881695141889]' />
            </column>
            <column caption='Availability hourly simulated, % ' datatype='real' default-format='p0.0%' name='[Availability hourly initial, % (copy)_923800881696280578]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([available_hours_simulated]) / SUM([potential_hours])' />
            </column>
            <column caption='Availability hourly simulated expiry, % ' datatype='real' default-format='p0.0%' name='[Availability hourly simulated, %  (copy)_470344699495817216]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([available_hours_simulated_expiry]) / SUM([potential_hours])' />
            </column>
            <column caption='Initial fill rate, %' datatype='real' default-format='p0%' name='[Calculation_236720464554725376]' role='measure' type='quantitative'>
