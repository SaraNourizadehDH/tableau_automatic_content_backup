        <calculation class='tableau' formula='//IF [Posting Month] &lt;= {FIXED: MAX(IF [scenario] = &apos;ACTUAL&apos; THEN  DATEADD(&quot;month&quot;,-1,[Posting Month]) ELSE NULL END)}&#13;&#10;//AND [scenario] &lt;&gt; &quot;BUDGET2025AI&quot;&#13;&#10;//THEN TRUE ELSE FALSE END&#13;&#10;&#13;&#10;IF [scenario] in (&apos;BE02&apos;) AND MONTH([posting_month]) &lt;= 2 THEN 2&#13;&#10;ELSEIF [scenario] in (&apos;BE03&apos;,&quot;ACTUAL&quot;) AND MONTH([posting_month]) &lt;= 3 THEN 3&#13;&#10;ELSEIF [scenario] in (&apos;BE04&apos;,&quot;ACTUAL&quot;) AND MONTH([posting_month]) &lt;= 4 THEN 4&#13;&#10;ELSEIF [scenario] in (&apos;BE05&apos;,&quot;ACTUAL&quot;) AND MONTH([posting_month]) &lt;= 5 THEN 5&#13;&#10;ELSEIF [scenario] in (&apos;BE06&apos;,&quot;ACTUAL&quot;) AND MONTH([posting_month]) &lt;= 6 THEN 6&#13;&#10;ELSEIF [scenario] in (&apos;BE07&apos;,&quot;ACTUAL&quot;) AND MONTH([posting_month]) &lt;= 7 THEN 7&#13;&#10;ELSEIF [scenario] in (&apos;BE08&apos;,&quot;ACTUAL&quot;) AND MONTH([posting_month]) &lt;= 8 THEN 8&#13;&#10;ELSEIF [scenario] in (&apos;BE09&apos;,&quot;ACTUAL&quot;) AND MONTH([posting_month]) &lt;= 9 THEN 9&#13;&#10;ELSEIF [scenario] in (&apos;BE10&apos;,&quot;ACTUAL&quot;) AND MONTH([posting_month]) &lt;= 10 THEN 10&#13;&#10;ELSEIF [scenario] in (&apos;BE11&apos;,&quot;ACTUAL&quot;) AND MONTH([posting_month]) &lt;= 11 THEN 11&#13;&#10;&#13;&#10;END' />
