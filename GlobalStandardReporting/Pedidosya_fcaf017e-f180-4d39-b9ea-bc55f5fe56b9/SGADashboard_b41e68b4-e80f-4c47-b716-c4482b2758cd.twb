      <column caption='Delta scenario' datatype='real' name='[Calculation_1489284143163203589]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = &quot;1st vs 2nd&quot; THEN ([Calculation_1489284142918938627]) - zn([Calculation_366761955968897026]) &#13;&#10;ELSEIF [Parameters].[Parameter 6] = &quot;2nd vs 1st&quot; THEN ([Calculation_366761955968897026]) - zn([Calculation_1489284142918938627])  &#13;&#10;ELSEIF [Parameters].[Parameter 6] = &quot;1st vs 3rd&quot; THEN ([Calculation_1489284142918938627]) - zn([Amount scenario 2 (copy)_1071856748108935169]) &#13;&#10;ELSEIF [Parameters].[Parameter 6] = &quot;3rd vs 2nd&quot; THEN ([Amount scenario 2 (copy)_1071856748108935169]) - zn([Calculation_366761955968897026]) &#13;&#10;ELSEIF [Parameters].[Parameter 6] = &quot;3rd vs 1st&quot; THEN ([Amount scenario 2 (copy)_1071856748108935169]) - zn([Calculation_1489284142918938627]) &#13;&#10;ELSEIF [Parameters].[Parameter 6] = &quot;2nd vs 3rd&quot; THEN ([Calculation_366761955968897026]) - zn([Amount scenario 2 (copy)_1071856748108935169]) &#13;&#10;END' />
      </column>
      <column caption='Achievement' datatype='real' name='[Calculation_1489284143163752454]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 7] = &quot;Actual / Scenario 2&quot; THEN&#13;&#10;    IF SUM([Calculation_366761955968897026]) = 0 AND SUM([Calculation_1489284142918938627]) &lt;&gt; 0 THEN 1&#13;&#10;    ELSE ABS(SUM([Calculation_1489284142918938627])) / ABS(SUM([Calculation_366761955968897026]))&#13;&#10;    END&#13;&#10;ELSEIF [Parameters].[Parameter 7] = &quot;Actual / Scenario 3&quot; THEN &#13;&#10;    IF SUM([Amount scenario 2 (copy)_1071856748108935169]) = 0 AND SUM([Calculation_1489284142918938627]) &lt;&gt; 0 THEN 1&#13;&#10;    ELSE ABS(SUM([Calculation_1489284142918938627])) / ABS(SUM([Amount scenario 2 (copy)_1071856748108935169]))&#13;&#10;    END&#13;&#10;END' />
      </column>
