          <datasource-dependencies datasource='federated.0otdxbv0r7c2sj1g9rz5d0w3zniz'>
            <column caption='Amount scenario 3' datatype='real' name='[Amount scenario 2 (copy)_1071856748108935169]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Forecast Scenario 2 (copy)_1071856748108853248] = &quot;BUDGET2025AI&quot; AND [scenario] = &quot;BUDGET2025AI&quot; THEN [Calculation_1489284142918762497]&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Forecast Scenario 2 (copy)_1071856748108853248]  = &quot;FORECAST&quot; AND YEAR([posting_month]) = 2025 AND MONTH([posting_month]) &lt;= 2 AND [scenario] = &quot;BUDGET2025AI&quot; THEN [Calculation_1489284142918762497]&#13;&#10;ELSEIF [Parameters].[Forecast Scenario 2 (copy)_1071856748108853248]  = &quot;FORECAST&quot; AND YEAR([posting_month]) = 2025 AND MONTH([posting_month]) &gt; 2 AND MONTH([posting_month]) &lt;= 5 AND [scenario] = &quot;BE02&quot; THEN [Calculation_1489284142918762497]&#13;&#10;ELSEIF [Parameters].[Forecast Scenario 2 (copy)_1071856748108853248]  = &quot;FORECAST&quot; AND YEAR([posting_month]) = 2025 AND MONTH([posting_month]) &gt;= 6 AND [scenario] = &quot;BE05&quot; THEN [Calculation_1489284142918762497]&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Forecast Scenario 2 (copy)_1071856748108853248] = &quot;BE02&quot; THEN&#13;&#10;   (IF [scenario] = &quot;ACTUAL&quot; AND YEAR([posting_month]) = 2025  AND MONTH([posting_month]) &lt;= 2 THEN [Calculation_1489284142918762497]&#13;&#10;   ELSEIF [scenario] = &quot;BE02&quot; AND YEAR([posting_month]) = 2025 AND MONTH([posting_month]) &gt;= 3 THEN [Calculation_1489284142918762497]&#13;&#10;   ELSE 0 END)&#13;&#10;ELSEIF [Parameters].[Forecast Scenario 2 (copy)_1071856748108853248]  = &quot;BE05&quot; THEN&#13;&#10;   (IF [scenario] = &quot;ACTUAL&quot; AND YEAR([posting_month]) = 2025  AND MONTH([posting_month]) &lt;= 5 THEN [Calculation_1489284142918762497]&#13;&#10;   ELSEIF [scenario] = &quot;BE05&quot; AND YEAR([posting_month]) = 2025  AND MONTH([posting_month]) &gt;= 6 THEN [Calculation_1489284142918762497]&#13;&#10;   ELSE 0 END)&#13;&#10;ELSEIF [Parameters].[Forecast Scenario 2 (copy)_1071856748108853248] = &quot;ACTUAL&quot; THEN&#13;&#10;   (IF [scenario] = &quot;ACTUAL&quot; THEN [Calculation_1489284142918762497]&#13;&#10;   ELSE 0 END)&#13;&#10;ELSE&#13;&#10;   0&#13;&#10;END' />
            </column>
            <column caption='Amount' datatype='real' name='[Calculation_1489284142918762497]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;Local currency&quot; THEN [value_lc]&#13;&#10;ELSE [value_eur]&#13;&#10;END' />
            </column>
            <column caption='Amount scenario 1' datatype='real' name='[Calculation_1489284142918938627]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [scenario] = &quot;ACTUAL&quot; THEN [Calculation_1489284142918762497]&#13;&#10;   ELSE 0 END' />
            </column>
            <column caption='Delta scenario' datatype='real' name='[Calculation_1489284143163203589]' role='measure' type='quantitative'>
