      <aliases enabled='yes' />
      <column caption='Delta Actual vs Forecast' datatype='real' name='[Calculation_1280429701298819074]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1844505531854503936])-SUM([Store Opex (copy)_1280429701288980481])' />
      </column>
      <column caption='Store Opex' datatype='real' name='[Calculation_1844505531854503936]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [level_1] = &quot;Store Opex&quot; AND [scenario] = &quot;ACTUAL&quot; THEN [Calculation_716916794956075008]&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='% Over Retail Sales' datatype='real' name='[Calculation_1844505531855982594]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1844505531854503936])/SUM([Store Opex (copy)_1844505531854794753])' />
      </column>
      <column caption='Date Month' datatype='string' name='[Calculation_1844505531856363523]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(YEAR([posting_month])) + &apos;-&apos; + RIGHT(&apos;0&apos; + STR(MONTH([posting_month])), 2)' />
      </column>
      <column caption='Date Filter' datatype='boolean' name='[Calculation_1844505531879092232]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [posting_month] &gt;= [Parameters].[Parameter 1] AND [posting_month] &lt;= [Parameters].[Parameter 2] THEN TRUE&#13;&#10;ELSE FALSE END' />
      </column>
      <column caption='is_provision' datatype='boolean' name='[Calculation_2891310975582093312]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF UPPER([reference_document_number]) = &quot;PROVISION&quot; THEN TRUE&#13;&#10;ELSEIF LEFT([item_text],4) = &quot;Prov&quot; THEN TRUE&#13;&#10;ELSE FALSE&#13;&#10;END' />
      </column>
      <column caption='Value to Currency' datatype='real' name='[Calculation_716916794956075008]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;    WHEN &quot;EUR&quot; THEN [value_eur]&#13;&#10;    ELSE [value_lc]&#13;&#10;END' />
      </column>
      <column caption='Retail Sales (copy)' datatype='real' name='[Retail Sales (copy)_1844505531865030662]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [level_1] = &quot;Retail Sales&quot; THEN [value_eur]&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='Store Opex - Forecast Scenario' datatype='real' name='[Store Opex (copy)_1280429701288980481]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [level_1] = &quot;Store Opex&quot; AND [scenario] = [Parameters].[Parameter 4] THEN [Calculation_716916794956075008]&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='Retail Sales' datatype='real' name='[Store Opex (copy)_1844505531854794753]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [level_1] = &quot;Retail Sales&quot; THEN [Calculation_716916794956075008]&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='Store Opex (EUR)' datatype='real' name='[Store Opex (copy)_716916794958565377]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [level_1] = &quot;Store Opex&quot; AND [scenario] = &quot;ACTUAL&quot; THEN [value_eur]&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
