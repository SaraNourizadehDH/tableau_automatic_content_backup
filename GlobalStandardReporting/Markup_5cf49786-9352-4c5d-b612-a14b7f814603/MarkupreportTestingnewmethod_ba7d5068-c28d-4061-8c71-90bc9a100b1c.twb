              <calculation class='tableau' formula='IF [Parameters].[Choice Selection (copy)] = &apos;# Orders Delivered&apos; THEN &#10;(&#10;IF ABS(([Calculation_5234801314462896133])) &gt;= 1000 THEN&#10;//round for thousands&#10;STR(ROUND(([Calculation_5234801314462896133] / 1000), 1)) + &quot; K Orders&quot;&#10;ELSE&#10;STR(ROUND(([Calculation_5234801314462896133]),1))&#10;END&#10;)&#10;ELSEIF [Parameters].[Choice Selection (copy)] = &apos;# GMV Eur Generated&apos; THEN &#10;(&#10;IF ABS(([Calculation_5234801314462896133])) &gt;= 1000000 THEN&#10;//round for thousands&#10;STR(ROUND(([Calculation_5234801314462896133] / 1000000), 1)) + &quot; M Euros&quot;&#10;ELSEIF ABS(([Calculation_5234801314462896133])) &gt;= 1000 THEN&#10;//round for thousands&#10;STR(ROUND(([Calculation_5234801314462896133] / 1000), 1)) + &quot; K Euros&quot;&#10;ELSE&#10;STR(ROUND(([Calculation_5234801314462896133]),1))&#10;END&#10;)&#10;ELSEIF [Parameters].[Choice Selection (copy)] = &apos;# Cuisines Offered By DH Restaurants [Unique Total]&apos; THEN&#10;IF [Parameters].[Choice Selection (copy 2)] = &apos;Sub Entity&apos; THEN (STR(ROUND(([Calculation_5234801314462896133]),0)) + &apos; Cuisine(s)&apos;)&#10;ELSEIF [Parameters].[Choice Selection (copy 2)] = &apos;City&apos; THEN (STR(ROUND(([Calculation_5234801314462896133]),0)) + &apos; Cuisine(s)&apos;)&#10;ELSEIF [Parameters].[Choice Selection (copy 2)] = &apos;Area Name&apos; THEN (STR(ROUND(([Calculation_5234801314462896133]),0)) + &apos; Cuisine(s)&apos;)&#10;ELSEIF [Parameters].[Choice Selection (copy 2)] = &apos;~400m Hex ID&apos; THEN (STR(ROUND(([Calculation_5234801314462896133]),0)) + &apos; Cuisine(s)&apos;)&#10;END&#10;ELSEIF [Parameters].[Choice Selection (copy)] = &apos;# Comp Vendors With Positive Review Velocity&apos; THEN &#10;(&#10;IF ABS(([Calculation_5234801314462896133])) &gt;= 1000 THEN&#10;//round for thousands&#10;STR(ROUND(([Calculation_5234801314462896133] / 1000), 1)) + &quot; Highly engaged competitor vendors&quot;&#10;ELSE&#10;STR(ROUND(([Calculation_5234801314462896133]),1))&#10;END&#10;)&#10;END' />
