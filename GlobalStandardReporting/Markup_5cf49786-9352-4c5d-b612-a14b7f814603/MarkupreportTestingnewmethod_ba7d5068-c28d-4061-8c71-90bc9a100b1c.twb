      <aliases enabled='yes' />
      <column caption='@Previous Small Area Vendors ' datatype='integer' name='[@Current Small Area Vendors (copy)_1840142672126881796]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [report_date]= [Calculation_5625347788230742019] THEN [Calculation_3331115618793783296] END)' />
      </column>
      <column caption='DH Size Flagging' datatype='string' name='[Calculation_102034684143988741]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;[size_bucket] = &apos;+70% Smaller on DH&apos;&#10;OR [size_bucket] = &apos;50-70% Smaller on DH&apos;&#10;OR [size_bucket] = &apos;30-50% Smaller on DH&apos;&#10;OR [size_bucket] = &apos;10-30% Smaller on DH&apos;&#10;OR [size_bucket] = &apos;Smaller on DH&apos;&#10;THEN &apos;Smaller Area on DH&apos;&#10;ELSEIF &#10;[size_bucket] = &apos;+70% Bigger on DH&apos;&#10;OR [size_bucket] = &apos;50-70% Bigger on DH&apos;&#10;OR [size_bucket] = &apos;30-50% Bigger on DH&apos;&#10;OR [size_bucket] = &apos;10-30% Bigger on DH&apos;&#10;OR [size_bucket] = &apos;Higher on DH&apos;&#10;THEN &apos;Bigger Area on DH&apos;&#10;ELSE [size_bucket] END' />
        <aliases>
          <alias key='&quot;At Par With DH&quot;' value='At Par' />
          <alias key='&quot;Bigger Area on DH&quot;' value='DH Larger Area' />
          <alias key='&quot;Smaller Area on DH&quot;' value='DH Smaller Area' />
        </aliases>
      </column>
      <column caption='@Total Small Area Change' datatype='real' name='[Calculation_1840142672126984197]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_6220174783901872135] - [@Current Small Area Vendors (copy)_1840142672126881796])/[@Current Small Area Vendors (copy)_1840142672126881796]' />
      </column>
      <column caption='Vendors with small area on DH' datatype='integer' name='[Calculation_3331115618793783296]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_102034684143988741] = &apos;Smaller Area on DH&apos; THEN [vendor_count] END' />
      </column>
      <column caption='Vendors with small area on DH %' datatype='real' default-format='p0.0%' name='[Calculation_3331115618793930753]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_3331115618793783296])&#10;/&#10;SUM([vendor_count])' />
      </column>
      <column caption='Date Selector' datatype='boolean' name='[Calculation_4410009203572224020]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[report_date] = [Parameters].[Parameter 1 1]' />
