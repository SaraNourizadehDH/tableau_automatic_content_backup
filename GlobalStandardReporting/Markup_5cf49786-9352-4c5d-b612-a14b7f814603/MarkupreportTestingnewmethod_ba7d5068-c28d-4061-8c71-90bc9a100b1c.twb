            </column>
            <column caption='Performance Categorisation' datatype='string' name='[Calculation_5234801314472230920]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_5234801314462756868] = 2 AND [Customer-Driven Selection Rank (copy)_5234801314471993351] = 2&#10;&#10;THEN (&apos;High&apos;+&apos; &apos;+[Parameters].[Geo View (copy)]+&apos; - High &apos;+[Parameters].[Choice Selection (copy)])&#10;&#10;ELSEIF  [Calculation_5234801314462756868] =2 AND [Customer-Driven Selection Rank (copy)_5234801314471993351] = 1&#10;&#10;THEN (&apos;High&apos;+&apos; &apos;+[Parameters].[Geo View (copy)]+&apos; - Low &apos;+[Parameters].[Choice Selection (copy)])&#10;ELSEIF  [Calculation_5234801314462756868] =1 AND [Customer-Driven Selection Rank (copy)_5234801314471993351] = 2&#10;&#10;THEN (&apos;Low&apos;+&apos; &apos;+[Parameters].[Geo View (copy)]+&apos; - High &apos;+[Parameters].[Choice Selection (copy)])&#10;&#10;ELSE (&apos;Low&apos;+&apos; &apos;+[Parameters].[Geo View (copy)]+&apos; - Low &apos;+[Parameters].[Choice Selection (copy)])&#10;END'>
