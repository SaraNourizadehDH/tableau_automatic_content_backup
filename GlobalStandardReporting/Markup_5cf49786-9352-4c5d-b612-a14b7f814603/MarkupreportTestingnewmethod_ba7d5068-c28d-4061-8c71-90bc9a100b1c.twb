  <worksheets>
    <worksheet name='AAAAAFinal Aggregation Table'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontsize='16'>LOCATION INTEL AGGREGATION</run>
            <run fontcolor='#000000' fontname='Tableau Medium'><![CDATA[ : <[federated.0q3tydo03le8hd1bs39bd161wj03].[tmn:report_date:ok]>]]></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Location Intel: New' name='federated.0q3tydo03le8hd1bs39bd161wj03' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Sub Entity' caption='Level Of Geographic Drill Down' datatype='string' folder-name='Param.Location Intel' name='[Choice Selection (copy 2)]' param-domain-type='list' role='measure' type='nominal' value='&quot;Sub Entity&quot;'>
              <calculation class='tableau' formula='&quot;Sub Entity&quot;' />
              <aliases>
                <alias key='&quot;~400m Hex ID&quot;' value='~400m Hex ID' />
                <alias key='&quot;Area Name&quot;' value='Area Name' />
                <alias key='&quot;City&quot;' value='City' />
                <alias key='&quot;Sub Entity&quot;' value='Sub Entity' />
              </aliases>
            </column>
            <column caption='Customer-Driven Selection' datatype='string' folder-name='Param.Location Intel' name='[Choice Selection (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;\# Cuisines Offered By DH Restaurants [Unique Total]&quot;'>
              <calculation class='tableau' formula='&quot;# Cuisines Offered By DH Restaurants [Unique Total]&quot;' />
              <aliases>
                <alias key='&quot;\# GMV Eur Generated&quot;' value='# GMV Eur Generated' />
                <alias key='&quot;\# Orders Delivered&quot;' value='# Orders Delivered' />
              </aliases>
            </column>
            <column alias='# Competitor Branches [Total]' caption='Choice Selection' datatype='string' folder-name='Param.Location Intel' name='[Geo View (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;\# Competitor Branches [Total]&quot;'>
              <calculation class='tableau' formula='&quot;# Competitor Branches [Total]&quot;' />
              <aliases>
                <alias key='&quot;\# Competitor Branches [Only]&quot;' value='# Competitor Branches [Only]' />
                <alias key='&quot;\# Competitor Branches [Total]&quot;' value='# Competitor Branches [Total]' />
                <alias key='&quot;\# DH Branches [Only]&quot;' value='# DH Branches [Only]' />
                <alias key='&quot;\# DH Branches [Shared]&quot;' value='# DH Branches [Shared]' />
                <alias key='&quot;\# DH Branches [Total]&quot;' value='# DH Branches [Total]' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0q3tydo03le8hd1bs39bd161wj03'>
            <column caption='Choice Selection' datatype='integer' name='[Calculation_5234801314462044162]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Geo View (copy)] = &apos;# Competitor Branches [Total]&apos; THEN [Comp_universe_tot]&#10;ELSEIF [Parameters].[Geo View (copy)] = &apos;# DH Branches [Total]&apos; THEN [DH_universe_tot]&#10;ELSEIF [Parameters].[Geo View (copy)] = &apos;# Competitor Branches [Only]&apos; THEN [Comp_universe_only] &#10;ELSEIF [Parameters].[Geo View (copy)] = &apos;# DH Branches [Only]&apos; THEN [DH_universe_only]&#10;ELSEIF [Parameters].[Geo View (copy)] = &apos;# DH Branches [Shared]&apos; THEN [DH_universe_shared]&#10;ELSEIF [Parameters].[Geo View (copy)] = &apos;# Competitor Branches A &amp; B Graded [Only]&apos; THEN [Comp_universe_ab_only]&#10;END' />
            </column>
            <column caption='Choice Selection Rank' datatype='real' name='[Calculation_5234801314462617603]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK_PERCENTILE(IF SUM([Calculation_5234801314462044162]) = 0 THEN 0 ELSE SUM([Calculation_5234801314462044162]) END)'>
                <table-calc ordering-field='[federated.0q3tydo03le8hd1bs39bd161wj03].[Calculation_5234801314472935436]' ordering-type='Field' />
              </calculation>
            </column>
            <column caption='Choice Selection Rank Score' datatype='integer' name='[Calculation_5234801314462756868]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF IFNULL([Calculation_5234801314462617603],0)&lt;= 0.50 THEN 1&#10;ELSEIF [Calculation_5234801314462617603] &gt; 0.5 THEN 2&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Customer-Driven Selection' datatype='real' name='[Calculation_5234801314462896133]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Choice Selection (copy)] = &apos;# Orders Delivered&apos; THEN SUM([orders_generated])&#10;ELSEIF [Parameters].[Choice Selection (copy)] = &apos;# GMV Eur Generated&apos; THEN SUM([monthly_gmv])&#10;ELSEIF [Parameters].[Choice Selection (copy)] = &apos;# Cuisines Offered By DH Restaurants [Unique Total]&apos; THEN&#10;IF [Parameters].[Choice Selection (copy 2)] = &apos;Sub Entity&apos; THEN AVG([dh_vendor_cuisine_count_subentity])&#10;ELSEIF [Parameters].[Choice Selection (copy 2)] = &apos;City&apos; THEN AVG([dh_vendor_cuisine_count_city])&#10;ELSEIF [Parameters].[Choice Selection (copy 2)] = &apos;Area Name&apos; THEN AVG([dh_vendor_cuisine_count_area])&#10;ELSEIF [Parameters].[Choice Selection (copy 2)] = &apos;~400m Hex ID&apos; THEN SUM([dh_vendor_cuisine_count_hex])&#10;END&#10;ELSEIF [Parameters].[Choice Selection (copy)] = &apos;# Comp Vendors With Positive Review Velocity&apos; THEN SUM([Comp_universe_positive_review_only])&#10;END' />
            </column>
            <column caption='Customer-Driven Selection Rank' datatype='real' name='[Calculation_5234801314471874566]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK_PERCENTILE(IF [Calculation_5234801314462896133] = 0 THEN 0 ELSE [Calculation_5234801314462896133] END)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Performance Categorisation' datatype='string' name='[Calculation_5234801314472230920]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_5234801314462756868] = 2 AND [Customer-Driven Selection Rank (copy)_5234801314471993351] = 2&#10;&#10;THEN (&apos;High&apos;+&apos; &apos;+[Parameters].[Geo View (copy)]+&apos; - High &apos;+[Parameters].[Choice Selection (copy)])&#10;&#10;ELSEIF  [Calculation_5234801314462756868] =2 AND [Customer-Driven Selection Rank (copy)_5234801314471993351] = 1&#10;&#10;THEN (&apos;High&apos;+&apos; &apos;+[Parameters].[Geo View (copy)]+&apos; - Low &apos;+[Parameters].[Choice Selection (copy)])&#10;ELSEIF  [Calculation_5234801314462756868] =1 AND [Customer-Driven Selection Rank (copy)_5234801314471993351] = 2&#10;&#10;THEN (&apos;Low&apos;+&apos; &apos;+[Parameters].[Geo View (copy)]+&apos; - High &apos;+[Parameters].[Choice Selection (copy)])&#10;&#10;ELSE (&apos;Low&apos;+&apos; &apos;+[Parameters].[Geo View (copy)]+&apos; - Low &apos;+[Parameters].[Choice Selection (copy)])&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Row Number' datatype='integer' name='[Calculation_5234801314472484874]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='INDEX()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Level Of Geographic Drill Down' datatype='string' name='[Calculation_5234801314472935436]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Choice Selection (copy 2)] = &apos;Sub Entity&apos; THEN [sub_entity]&#10;ELSEIF [Parameters].[Choice Selection (copy 2)] = &apos;City&apos; THEN [city_name]&#10;ELSEIF [Parameters].[Choice Selection (copy 2)] = &apos;Area Name&apos; THEN [zone_name]&#10;ELSEIF [Parameters].[Choice Selection (copy 2)] = &apos;~400m Hex ID&apos; THEN [h3_level_8_index]&#10;END' />
            </column>
            <column caption='Cuisine Selection' datatype='real' name='[Calculation_5234801314499477521]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Choice Selection (copy 2)] = &apos;Sub Entity&apos; THEN AVG([dh_vendor_cuisine_count_subentity])&#10;ELSEIF [Parameters].[Choice Selection (copy 2)] = &apos;City&apos; THEN AVG([dh_vendor_cuisine_count_city])&#10;ELSEIF [Parameters].[Choice Selection (copy 2)] = &apos;Area Name&apos; THEN AVG([dh_vendor_cuisine_count_area])&#10;ELSEIF [Parameters].[Choice Selection (copy 2)] = &apos;~400m Hex ID&apos; THEN SUM([dh_vendor_cuisine_count_hex])&#10;END' />
            </column>
            <column caption='Comp Universe Grade A &amp; B [Only]' datatype='integer' name='[Comp_universe_ab_only]' role='measure' type='quantitative' />
            <column caption='Comp Universe Grade A &amp; B Positive RV 30D  [Only]' datatype='integer' name='[Comp_universe_ab_positive_review_only]' role='measure' type='quantitative' />
            <column caption='Comp Universe [Only]' datatype='integer' name='[Comp_universe_only]' role='measure' type='quantitative' />
            <column caption='Comp Universe Positive RV 30D [Only]' datatype='integer' name='[Comp_universe_positive_review_only]' role='measure' type='quantitative' />
