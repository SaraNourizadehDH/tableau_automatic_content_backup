            <column caption='Level Of Geographic Drill Down Table' datatype='string' name='[Level Of Geographic Drill Down (copy)_5234801314473119757]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Choice Selection (copy 2)] = &apos;Sub Entity&apos; THEN [sub_entity]&#10;ELSEIF [Parameters].[Choice Selection (copy 2)] = &apos;City&apos; THEN [sub_entity]+&apos;-&apos;+[city_name] &#10;ELSEIF [Parameters].[Choice Selection (copy 2)] = &apos;Area Name&apos; THEN [sub_entity]+&apos;-&apos;+[city_name] + &apos;-&apos;+[zone_name]&#10;END' />
            </column>
            <column caption='Performance Categorisation Colour' datatype='integer' name='[Performance Categorisation (copy)_5234801314472357897]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF  [Calculation_5234801314472230920] = (&apos;High&apos;+&apos; &apos;+[Parameters].[Geo View (copy)]+&apos; - High &apos;+[Parameters].[Choice Selection (copy)]) THEN 1&#10;&#10;ELSEIF  [Calculation_5234801314472230920] =  (&apos;High&apos;+&apos; &apos;+[Parameters].[Geo View (copy)]+&apos; - Low &apos;+[Parameters].[Choice Selection (copy)]) THEN 2&#10;ELSEIF  [Calculation_5234801314472230920] =  (&apos;Low&apos;+&apos; &apos;+[Parameters].[Geo View (copy)]+&apos; - High &apos;+[Parameters].[Choice Selection (copy)]) THEN 3&#10;&#10;ELSE 4&#10;END'>
