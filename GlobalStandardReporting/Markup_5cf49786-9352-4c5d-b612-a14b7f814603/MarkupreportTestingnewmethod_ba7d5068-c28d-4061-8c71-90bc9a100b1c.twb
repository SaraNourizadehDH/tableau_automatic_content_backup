            <column caption='Customer-Driven Selection' datatype='real' name='[Calculation_5234801314462896133]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Choice Selection (copy)] = &apos;# Orders Delivered&apos; THEN SUM([orders_generated])&#10;ELSEIF [Parameters].[Choice Selection (copy)] = &apos;# GMV Eur Generated&apos; THEN SUM([monthly_gmv])&#10;ELSEIF [Parameters].[Choice Selection (copy)] = &apos;# Cuisines Offered By DH Restaurants [Unique Total]&apos; THEN&#10;IF [Parameters].[Choice Selection (copy 2)] = &apos;Sub Entity&apos; THEN AVG([dh_vendor_cuisine_count_subentity])&#10;ELSEIF [Parameters].[Choice Selection (copy 2)] = &apos;City&apos; THEN AVG([dh_vendor_cuisine_count_city])&#10;ELSEIF [Parameters].[Choice Selection (copy 2)] = &apos;Area Name&apos; THEN AVG([dh_vendor_cuisine_count_area])&#10;ELSEIF [Parameters].[Choice Selection (copy 2)] = &apos;~400m Hex ID&apos; THEN SUM([dh_vendor_cuisine_count_hex])&#10;END&#10;ELSEIF [Parameters].[Choice Selection (copy)] = &apos;# Comp Vendors With Positive Review Velocity&apos; THEN SUM([Comp_universe_positive_review_only])&#10;END' />
            </column>
