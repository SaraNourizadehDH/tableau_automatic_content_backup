      <column caption='Level Of Geographic Drill Down' datatype='string' name='[Calculation_5234801314472935436]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Choice Selection (copy 2)] = &apos;Sub Entity&apos; THEN [sub_entity]&#10;ELSEIF [Parameters].[Choice Selection (copy 2)] = &apos;City&apos; THEN [city_name]&#10;ELSEIF [Parameters].[Choice Selection (copy 2)] = &apos;Area Name&apos; THEN [zone_name]&#10;ELSEIF [Parameters].[Choice Selection (copy 2)] = &apos;~400m Hex ID&apos; THEN [h3_level_8_index]&#10;END' />
