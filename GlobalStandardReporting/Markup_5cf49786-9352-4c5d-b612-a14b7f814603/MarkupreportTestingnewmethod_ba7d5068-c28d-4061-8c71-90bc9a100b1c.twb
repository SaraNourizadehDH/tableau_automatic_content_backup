            <run>Æ&#10;</run>
            <run fontcolor='#ffffff' fontsize='9'>Oman, Egypt, Romania, </run>
            <run fontcolor='#ffffff' fontname='Roboto,  sans-serif' fontsize='9'>Morocco</run>
            <run fontcolor='#ffffff' fontsize='9'>, </run>
            <run fontcolor='#ffffff' fontname='Roboto,  sans-serif' fontsize='9'>Ukraine</run>
            <run fontcolor='#ffffff' fontsize='9'>, </run>
            <run fontcolor='#ffffff' fontname='Roboto,  sans-serif' fontsize='9'>Ivory Coast</run>
            <run fontcolor='#ffffff' fontsize='9'> &amp; </run>
            <run fontcolor='#ffffff' fontname='Roboto,  sans-serif' fontsize='9'>Kyrgyzstan</run>
            <run fontcolor='#ffffff' fontsize='9'> are excluded from Online markups calculations.</run>
          </formatted-text>
        </zone>
        <zone forceUpdate='true' h='3000' id='982' type-v2='text' w='35000' x='64000' y='4800'>
          <formatted-text>
            <run><![CDATA[New method is applied for share of vendors with item < 15% markup]]></run>
            <run>Æ&#10;</run>
            <run>(</run>
            <run fontcolor='#666666' fontname='Slack-Lato, Slack-Fractions, appleLogo, sans-serif' fontsize='9'>a vendor is non-compliant if they have 3 or more items &gt; 15% markup)</run>
          </formatted-text>
        </zone>
      </zones>
