          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Last N Months' datatype='integer' name='[Parameter 7]' param-domain-type='list' role='measure' type='quantitative' value='3'>
              <calculation class='tableau' formula='3' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0aojulh00506xl18ssb3e1wtgnnt'>
            <column aggregation='Sum' caption='DH logo filter' datatype='integer' name='[Calculation_1716012229274083351]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='Delivery Hero' />
              </aliases>
            </column>
            <column caption='Last N Months' datatype='boolean' name='[Calculation_2544885665558810627]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_2946972666874032132] &gt; DATEADD(&apos;month&apos;, -[Parameters].[Parameter 7], {MAX([Calculation_2946972666874032132])})&#10;AND [Calculation_2946972666874032132] &lt;= {MAX([Calculation_2946972666874032132])}' />
            </column>
            <column caption='Markup weighted by GBV %' datatype='real' name='[Calculation_2736851596373852162]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([item_GBV_markup_sum])/SUM([total_item_GBV_sum])' />
            </column>
            <column caption='Calculated report_month' datatype='date' datatype-customized='true' name='[Calculation_2946972666874032132]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATEPARSE ( &quot;MMM yy&quot;, LEFT(DATENAME(&apos;month&apos;, [report_month]), 3) + &quot; &quot; + RIGHT(STR(YEAR([report_month])), 2) )) ' />
            </column>
            <column caption='User Entitlement' datatype='boolean' name='[Calculation_3559110407244439552]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[username]=USERNAME()' />
            </column>
            <column caption='Exclusion for online markups' datatype='boolean' name='[Calculation_5789025518332420116]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [global_entity_id] = &apos;HF_EG&apos; and [markup_type] = &apos;Online&apos;&#10;THEN TRUE &#10;ELSEIF [global_entity_id] = &apos;TB_OM&apos; and [markup_type] = &apos;Online&apos;&#10;THEN TRUE&#10;ELSEIF [global_entity_id] = &apos;GV_RO&apos; and [markup_type] = &apos;Online&apos;&#10;THEN TRUE&#10;ELSEIF [global_entity_id] = &apos;GV_MA&apos; and [markup_type] = &apos;Online&apos;&#10;THEN TRUE&#10;ELSEIF [global_entity_id] = &apos;GV_CI&apos; and [markup_type] = &apos;Online&apos;&#10;THEN TRUE&#10;ELSEIF [global_entity_id] = &apos;GV_UA&apos; and [markup_type] = &apos;Online&apos;&#10;THEN TRUE&#10;ELSEIF [global_entity_id] = &apos;GV_KG&apos; and [markup_type] = &apos;Online&apos;&#10;THEN TRUE&#10;ELSEIF [global_entity_id] = &apos;PY_AR&apos; and [markup_type] = &apos;Online&apos;&#10;THEN TRUE&#10;ELSEIF [source_platform] = &apos;mrsool&apos; and [markup_type] = &apos;Online&apos;&#10;THEN TRUE &#10;ELSEIF [source_platform] = &apos;fork&apos; and [markup_type] = &apos;Online&apos;&#10;THEN TRUE &#10;else FALSE END' />
            </column>
