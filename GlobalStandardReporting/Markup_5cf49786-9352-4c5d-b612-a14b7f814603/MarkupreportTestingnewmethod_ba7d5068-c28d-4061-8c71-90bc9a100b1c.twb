        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Shape' />
            <customized-tooltip>
              <formatted-text>
                <run bold='true' fontalignment='1' fontsize='12' underline='true'>Online Markups</run>
                <run fontalignment='1'>Æ&#10;&#10;</run>
                <run bold='true' fontalignment='1'># branches</run>
                <run>Æ&#10;</run>
                <run fontcolor='#1d1c1d' fontsize='8'>The chart depicts # of branches where the price comparison on the DH platform versus the selected competitor:</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#1d1c1d' fontsize='8'>1. </run>
                <run bold='true' fontcolor='#1d1c1d' fontsize='8'>Marked up:</run>
                <run fontcolor='#1d1c1d' fontsize='8'> # of vendors where the price of at least 1 item on the DH platform exceeds the price of the same item on another competitor platform</run>
                <run>Æ&#10;</run>
                <run fontcolor='#1d1c1d' fontsize='8'>2. </run>
                <run bold='true' fontcolor='#1d1c1d' fontsize='8'>At Par:</run>
                <run fontcolor='#1d1c1d' fontsize='8'> # of vendors with prices difference within 5% between menu items on DH vs the competition </run>
                <run>Æ&#10;</run>
                <run fontcolor='#1d1c1d' fontsize='8'>3. </run>
                <run bold='true' fontcolor='#1d1c1d' fontsize='8'>Marked Down:</run>
                <run fontcolor='#1d1c1d' fontsize='8'> # of vendors with lower price of menu items vs the competition (condition : prices for at least 1 are lower and all other items are at par)</run>
                <run>Æ&#10;&#10;&#10;&#10;</run>
                <run bold='true' fontcolor='#c53530' fontsize='8'>Please Note:</run>
                <run fontcolor='#c53530' fontsize='8'> In order to consider inventory under markup evaluation following criteria should be fulfilled</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#c53530' fontsize='8'>1.</run>
                <run fontcolor='#c53530' fontsize='8'> Vendors should be consecutively markups</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#c53530' fontsize='8'>2. </run>
                <run fontcolor='#c53530' fontsize='8'>% markups should be greater than 5%</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#c53530' fontsize='8'>3.</run>
                <run fontcolor='#c53530' fontsize='8'> 80% of the GMV sold for the item should be marked up</run>
                <run>Æ&#10;</run>
                <run fontalignment='1'>Æ&#10;</run>
                <run bold='true' fontalignment='1'># items</run>
                <run fontalignment='1'>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run fontcolor='#1d1c1d' fontsize='8'>The chart depicts # of items where the price comparison on the DH platform versus the selected competitor:</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#1d1c1d' fontsize='8'>1. </run>
                <run bold='true' fontcolor='#1d1c1d' fontsize='8'>Marked up:</run>
                <run fontcolor='#1d1c1d' fontsize='8'> # of items where the price of the item on the DH platform exceeds the price of the same item on another competitor platform</run>
                <run>Æ&#10;</run>
                <run fontcolor='#1d1c1d' fontsize='8'>2. </run>
                <run bold='true' fontcolor='#1d1c1d' fontsize='8'>At Par:</run>
                <run fontcolor='#1d1c1d' fontsize='8'> # of items with prices difference within 5% between DH vs the competition </run>
                <run>Æ&#10;</run>
                <run fontcolor='#1d1c1d' fontsize='8'>3. </run>
                <run bold='true' fontcolor='#1d1c1d' fontsize='8'>Marked Down:</run>
                <run fontcolor='#1d1c1d' fontsize='8'> # of items with lower price on DH vs the competition</run>
              </formatted-text>
            </customized-tooltip>
