    <worksheet name='Trend Customer Demand Selection'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#f5f5f5' fontname='Tableau Medium' fontsize='9'><![CDATA[<[Parameters].[Choice Selection (copy)]>]]></run>
            <run>Æ&#10;</run>
            <run fontcolor='#f5f5f5' fontname='Tableau Medium' fontsize='8'>Trends, Last 3 Months </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Location Intel: New' name='federated.0q3tydo03le8hd1bs39bd161wj03' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Sub Entity' caption='Level Of Geographic Drill Down' datatype='string' folder-name='Param.Location Intel' name='[Choice Selection (copy 2)]' param-domain-type='list' role='measure' type='nominal' value='&quot;Sub Entity&quot;'>
              <calculation class='tableau' formula='&quot;Sub Entity&quot;' />
              <aliases>
                <alias key='&quot;~400m Hex ID&quot;' value='~400m Hex ID' />
                <alias key='&quot;Area Name&quot;' value='Area Name' />
                <alias key='&quot;City&quot;' value='City' />
                <alias key='&quot;Sub Entity&quot;' value='Sub Entity' />
              </aliases>
            </column>
            <column caption='Customer-Driven Selection' datatype='string' folder-name='Param.Location Intel' name='[Choice Selection (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;\# Cuisines Offered By DH Restaurants [Unique Total]&quot;'>
              <calculation class='tableau' formula='&quot;# Cuisines Offered By DH Restaurants [Unique Total]&quot;' />
              <aliases>
                <alias key='&quot;\# GMV Eur Generated&quot;' value='# GMV Eur Generated' />
                <alias key='&quot;\# Orders Delivered&quot;' value='# Orders Delivered' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0q3tydo03le8hd1bs39bd161wj03'>
            <column caption='Customer-Driven Selection' datatype='real' name='[Calculation_5234801314462896133]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Choice Selection (copy)] = &apos;# Orders Delivered&apos; THEN SUM([orders_generated])&#10;ELSEIF [Parameters].[Choice Selection (copy)] = &apos;# GMV Eur Generated&apos; THEN SUM([monthly_gmv])&#10;ELSEIF [Parameters].[Choice Selection (copy)] = &apos;# Cuisines Offered By DH Restaurants [Unique Total]&apos; THEN&#10;IF [Parameters].[Choice Selection (copy 2)] = &apos;Sub Entity&apos; THEN AVG([dh_vendor_cuisine_count_subentity])&#10;ELSEIF [Parameters].[Choice Selection (copy 2)] = &apos;City&apos; THEN AVG([dh_vendor_cuisine_count_city])&#10;ELSEIF [Parameters].[Choice Selection (copy 2)] = &apos;Area Name&apos; THEN AVG([dh_vendor_cuisine_count_area])&#10;ELSEIF [Parameters].[Choice Selection (copy 2)] = &apos;~400m Hex ID&apos; THEN SUM([dh_vendor_cuisine_count_hex])&#10;END&#10;ELSEIF [Parameters].[Choice Selection (copy)] = &apos;# Comp Vendors With Positive Review Velocity&apos; THEN SUM([Comp_universe_positive_review_only])&#10;END' />
            </column>
            <column caption='Last 6 Filter' datatype='boolean' name='[Calculation_5234801314472607755]' role='measure' type='nominal'>
              <calculation class='tableau' formula='LAST() &lt; 3'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Comp Universe Positive RV 30D [Only]' datatype='integer' name='[Comp_universe_positive_review_only]' role='measure' type='quantitative' />
            <column caption='Customer-Driven Selection Modified' datatype='string' name='[Customer-Driven Selection (copy)_5234801314476838927]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Choice Selection (copy)] = &apos;# Orders Delivered&apos; THEN &#10;(&#10;IF ABS(([Calculation_5234801314462896133])) &gt;= 1000 THEN&#10;//round for thousands&#10;STR(ROUND(([Calculation_5234801314462896133] / 1000), 1)) + &quot; K Orders&quot;&#10;ELSE&#10;STR(ROUND(([Calculation_5234801314462896133]),1))&#10;END&#10;)&#10;ELSEIF [Parameters].[Choice Selection (copy)] = &apos;# GMV Eur Generated&apos; THEN &#10;(&#10;IF ABS(([Calculation_5234801314462896133])) &gt;= 1000000 THEN&#10;//round for thousands&#10;STR(ROUND(([Calculation_5234801314462896133] / 1000000), 1)) + &quot; M Euros&quot;&#10;ELSEIF ABS(([Calculation_5234801314462896133])) &gt;= 1000 THEN&#10;//round for thousands&#10;STR(ROUND(([Calculation_5234801314462896133] / 1000), 1)) + &quot; K Euros&quot;&#10;ELSE&#10;STR(ROUND(([Calculation_5234801314462896133]),1))&#10;END&#10;)&#10;ELSEIF [Parameters].[Choice Selection (copy)] = &apos;# Cuisines Offered By DH Restaurants [Unique Total]&apos; THEN&#10;IF [Parameters].[Choice Selection (copy 2)] = &apos;Sub Entity&apos; THEN (STR(ROUND(([Calculation_5234801314462896133]),0)) + &apos; Cuisine(s)&apos;)&#10;ELSEIF [Parameters].[Choice Selection (copy 2)] = &apos;City&apos; THEN (STR(ROUND(([Calculation_5234801314462896133]),0)) + &apos; Cuisine(s)&apos;)&#10;ELSEIF [Parameters].[Choice Selection (copy 2)] = &apos;Area Name&apos; THEN (STR(ROUND(([Calculation_5234801314462896133]),0)) + &apos; Cuisine(s)&apos;)&#10;ELSEIF [Parameters].[Choice Selection (copy 2)] = &apos;~400m Hex ID&apos; THEN (STR(ROUND(([Calculation_5234801314462896133]),0)) + &apos; Cuisine(s)&apos;)&#10;END&#10;ELSEIF [Parameters].[Choice Selection (copy)] = &apos;# Comp Vendors With Positive Review Velocity&apos; THEN &#10;(&#10;IF ABS(([Calculation_5234801314462896133])) &gt;= 1000 THEN&#10;//round for thousands&#10;STR(ROUND(([Calculation_5234801314462896133] / 1000), 1)) + &quot; Highly engaged competitor vendors&quot;&#10;ELSE&#10;STR(ROUND(([Calculation_5234801314462896133]),1))&#10;END&#10;)&#10;END' />
            </column>
            <column datatype='string' name='[city_name (hex_map_choice_kpi_agg)]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Competitor Name' datatype='string' name='[competitor_name]' role='dimension' type='nominal' />
            <column datatype='integer' name='[dh_vendor_cuisine_count_area]' role='measure' type='quantitative' />
            <column datatype='integer' name='[dh_vendor_cuisine_count_city]' role='measure' type='quantitative' />
            <column datatype='integer' name='[dh_vendor_cuisine_count_hex]' role='measure' type='quantitative' />
            <column datatype='integer' name='[dh_vendor_cuisine_count_subentity]' role='measure' type='quantitative' />
            <column datatype='string' name='[logistics_area_name]' role='dimension' type='nominal' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column caption='Monthly GMV Eur' datatype='real' name='[monthly_gmv]' role='measure' type='quantitative' />
            <column-instance column='[city_name (hex_map_choice_kpi_agg)]' derivation='None' name='[none:city_name (hex_map_choice_kpi_agg):nk]' pivot='key' type='nominal' />
            <column-instance column='[competitor_name]' derivation='None' name='[none:competitor_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[logistics_area_name]' derivation='None' name='[none:logistics_area_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[management_entity]' derivation='None' name='[none:management_entity:nk]' pivot='key' type='nominal' />
            <column-instance column='[region]' derivation='None' name='[none:region:nk]' pivot='key' type='nominal' />
            <column-instance column='[report_date]' derivation='None' name='[none:report_date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[sub_entity]' derivation='None' name='[none:sub_entity:nk]' pivot='key' type='nominal' />
            <column caption='Monthly Orders' datatype='integer' name='[orders_generated]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_5234801314462896133]' derivation='User' name='[pcdf:usr:Calculation_5234801314462896133:qk]' pivot='key' type='quantitative'>
              <table-calc diff-options='Relative' ordering-type='Rows' type='PctDiff'>
