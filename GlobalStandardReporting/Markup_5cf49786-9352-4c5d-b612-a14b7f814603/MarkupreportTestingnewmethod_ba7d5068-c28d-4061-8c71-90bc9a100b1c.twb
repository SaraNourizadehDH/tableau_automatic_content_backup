        <calculation class='tableau' formula='IF &#10;[size_bucket] = &apos;+70% Lower on DH&apos;&#10;OR [size_bucket] = &apos;50-70% Lower on DH&apos;&#10;OR [size_bucket] = &apos;30-50% Lower on DH&apos;&#10;OR [size_bucket] = &apos;5-30% Lower on DH&apos;&#10;THEN &apos;Lower Fee on DH&apos;&#10;ELSEIF &#10;[size_bucket] = &apos;+70% Higher on DH&apos;&#10;OR [size_bucket] = &apos;50-70% Higher on DH&apos;&#10;OR [size_bucket] = &apos;30-50% Higher on DH&apos;&#10;OR [size_bucket] = &apos;5-30% Higher on DH&apos;&#10;&#10;//[size_bucket] = &apos;100% More on DH&apos;&#10;//OR [size_bucket] = &apos;99% More on DH&apos;&#10;//OR [size_bucket] = &apos;98% More on DH&apos;&#10;//OR [size_bucket] = &apos;97% More on DH&apos;&#10;//OR [size_bucket] = &apos;96% More on DH&apos;&#10;//OR [size_bucket] = &apos;90-95% More on DH&apos;&#10;//OR [size_bucket] = &apos;80-90% More on DH&apos;&#10;//OR [size_bucket] = &apos;50-80% More on DH&apos;&#10;//OR [size_bucket] = &apos;10-90% More on DH&apos;&#10;THEN &apos;Higher Fee on DH&apos;&#10;ELSE [size_bucket] END' />
