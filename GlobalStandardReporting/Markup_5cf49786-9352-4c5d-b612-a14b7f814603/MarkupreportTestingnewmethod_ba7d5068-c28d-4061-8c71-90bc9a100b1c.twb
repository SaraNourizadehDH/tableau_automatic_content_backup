      <table>
        <view>
          <datasources>
            <datasource caption='Overview: KPI table' name='federated.0534hh707x036w1d393jl0jz6l96 (copy)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Addressable' caption='Addressable gap' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;addressable&quot;'>
              <calculation class='tableau' formula='&quot;addressable&quot;' />
              <aliases>
                <alias key='&quot;addressable&quot;' value='Addressable' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0534hh707x036w1d393jl0jz6l96 (copy)'>
            <column caption='MoM KPI' datatype='real' default-format='p0.00%' name='[Calculation3]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN([Calculation_5949395887582617601]) - LOOKUP(ZN([Calculation_5949395887582617601]), -1)) / ABS(LOOKUP(ZN([Calculation_5949395887582617601]), -1))'>
                <table-calc ordering-type='RowInPane' />
              </calculation>
            </column>
            <column caption='City' datatype='string' name='[Calculation_1821987571375423493]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([Sub Entity Set],[city_name], &quot;&quot;)' />
            </column>
            <column caption='KPI modified' datatype='string' name='[Calculation_2496190507736731662]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ABS(([Calculation_5949395887582617601])) &gt;= 1000 THEN&#10;//round for thousands&#10;STR(ROUND(([Calculation_5949395887582617601] / 1000), 1)) + &quot;K&quot;&#10;ELSE&#10;STR(ROUND(([Calculation_5949395887582617601]),1))&#10;END' />
            </column>
            <column caption='MoM KPI Last' datatype='real' name='[Calculation_2665005124888551425]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='If LAST() = 0 THEN ROUND([Calculation3] * 100, 2) END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Shape MoM KPI' datatype='string' name='[Calculation_2665005124889157634]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_2665005124888551425] &gt; 0 THEN &apos;▲&apos; ELSEIF [Calculation_2665005124888551425] &lt; 0 THEN &apos;▼&apos; END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Colour MoM KPI' datatype='string' name='[Calculation_2665005125014769674]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;    (ATTR([kpi_name]) = &quot;MARKED UP VENDORS&quot; OR  &#10;    ATTR([kpi_name]) = &quot;MARKED UP ITEMS&quot;    OR&#10;    ATTR([kpi_name]) = &quot;COMPETITOR VENDORS&quot; OR&#10;    ATTR([kpi_name]) = &quot;COMPETITOR ONLY VENDORS&quot; OR&#10;    ATTR([kpi_name]) = &quot;SMALLER DELIVERY COVERAGE DH&quot; OR&#10;    ATTR([kpi_name]) = &quot;COMP SCHEDULED AVAILABILITY&quot;) &#10;                                        AND [Calculation_2665005124889157634] = &quot;▲&quot; then &quot;Red&quot; &#10;ELSEIF &#10;    (ATTR([kpi_name]) = &quot;BETTER DELIVERY FEE DH&quot; OR&#10;     ATTR([kpi_name]) = &quot;DH VENDORS&quot;             OR&#10;     ATTR([kpi_name]) = &quot;DH ONLY VENDORS&quot;        OR&#10;     ATTR([kpi_name]) = &quot;VENDOR SCHEDULED AVAILABILITY&quot; OR&#10;    ATTR([kpi_name]) = &quot;BETTER MOV DH&quot; OR &#10;    ATTR([kpi_name]) = &quot;BETTER DEALS DH&quot; OR&#10;    ATTR([kpi_name]) = &quot;DH SCHEDULED AVAILABILITY&quot;) &#10;                                        AND [Calculation_2665005124889157634] = &quot;▲&quot; then &quot;Green&quot;&#10;ELSEIF &#10;    (ATTR([kpi_name]) = &quot;MARKED UP VENDORS&quot; OR  &#10;    ATTR([kpi_name]) = &quot;MARKED UP ITEMS&quot;    OR&#10;    ATTR([kpi_name]) = &quot;COMPETITOR VENDORS&quot; OR&#10;    ATTR([kpi_name]) = &quot;COMPETITOR ONLY VENDORS&quot; OR&#10;    ATTR([kpi_name]) = &quot;SMALLER DELIVERY COVERAGE DH&quot;  OR&#10;    ATTR([kpi_name]) = &quot;COMP SCHEDULED AVAILABILITY&quot;) &#10;                                        AND [Calculation_2665005124889157634] = &quot;▼&quot; then &quot;Green&quot;&#10;ELSEIF &#10;    (ATTR([kpi_name]) = &quot;BETTER DELIVERY FEE DH&quot; OR&#10;    ATTR([kpi_name]) = &quot;DH VENDORS&quot;             OR&#10;    ATTR([kpi_name]) = &quot;DH ONLY VENDORS&quot;        OR&#10;     ATTR([kpi_name]) = &quot;VENDOR SCHEDULED AVAILABILITY&quot; OR &#10;    ATTR([kpi_name]) = &quot;BETTER MOV DH&quot; OR &#10;    ATTR([kpi_name]) = &quot;BETTER DEALS DH&quot; OR&#10;    ATTR([kpi_name]) = &quot;DH SCHEDULED AVAILABILITY&quot;)&#10;                                        AND [Calculation_2665005124889157634] = &quot;▼&quot; then &quot;Red&quot;  &#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='City Name Lower' datatype='string' name='[Calculation_3236962289556901891]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='Lower([city_name])' />
            </column>
            <column caption='KPI' datatype='real' name='[Calculation_5949395887582617601]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_6040593796466909185])/2)/&#10;(IF SUM(IF ISNULL([Calculation_6040593796467404802]) OR [Calculation_6040593796467404802] = 0 THEN 0 ELSE ([Calculation_6040593796467404802])/2 END) = 0 THEN 1&#10;ELSE SUM(IF ISNULL([Calculation_6040593796467404802]) OR [Calculation_6040593796467404802] = 0 THEN 0 ELSE ([Calculation_6040593796467404802])/2 END) END)' />
            </column>
            <column caption='KPI 1 M' datatype='real' name='[Calculation_6040593796466909185]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = &apos;addressable&apos; AND [kpi_name] = &apos;COMPETITOR ONLY VENDORS&apos;&#10;THEN &#10;(IF [gap_type] = &apos;addressable&apos; THEN [kpi_1] END)&#10;ELSE &#10;[kpi_1]&#10;END' />
            </column>
            <column caption='KPI 2 M' datatype='integer' name='[Calculation_6040593796467404802]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = &apos;addressable&apos; AND [kpi_name] = &apos;COMPETITOR ONLY VENDORS&apos;&#10;THEN &#10;(IF [gap_type] = &apos;addressable&apos; THEN [kpi_2] END)&#10;ELSE &#10;[kpi_2]&#10;END' />
            </column>
