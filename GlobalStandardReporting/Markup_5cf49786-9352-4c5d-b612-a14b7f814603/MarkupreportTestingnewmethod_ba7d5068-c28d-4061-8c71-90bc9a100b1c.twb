            </view>
            <mark class='Shape' />
            <customized-tooltip>
              <formatted-text>
                <run bold='true' fontalignment='1' fontsize='12' underline='true'>Avg.markup weighted by GBV</run>
                <run fontalignment='1'>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run fontcolor='#172b4d' fontname='-apple-system' fontsize='9'>The average markup weighted by the gross booking value (GBV).</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#172b4d' fontname='-apple-system' fontsize='9'>Formula</run>
                <run fontcolor='#172b4d' fontname='-apple-system' fontsize='9'>: </run>
                <run fontcolor='#172b4d' fontname='SFMono-Medium' fontsize='9'>SUM(item markup where markup &gt; 0% * 30D GBV of item) / SUM(30D GBV of all items matched to competition)</run>
                <run>Æ&#10;</run>
              </formatted-text>
            </customized-tooltip>
