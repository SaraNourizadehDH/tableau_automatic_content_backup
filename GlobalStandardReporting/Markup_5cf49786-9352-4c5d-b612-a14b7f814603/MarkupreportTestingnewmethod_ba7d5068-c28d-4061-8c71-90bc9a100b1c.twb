            <column caption='Customer-Driven Selection Rank Score' datatype='integer' name='[Customer-Driven Selection Rank (copy)_5234801314471993351]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF IFNULL([Calculation_5234801314471874566],0) &lt;= 0.50 THEN 1&#10;ELSEIF [Calculation_5234801314471874566] &gt; 0.5 THEN 2&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='DH Universe [Only]' datatype='integer' name='[DH_universe_only]' role='measure' type='quantitative' />
            <column caption='DH Universe [Shared]' datatype='integer' name='[DH_universe_shared]' role='measure' type='quantitative' />
