      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0aojulh00506xl18ssb3e1wtgnnt].[usr:Calculation_2736851596373852162:qk]:1&quot;' value='Delivery Hero' />
          <alias key='&quot;[federated.0aojulh00506xl18ssb3e1wtgnnt].[usr:Calculation_2946972666503282688:qk]:1&quot;' value='Delivery Hero ' />
        </aliases>
      </column>
      <column caption='Calculated report_month (country performance)' datatype='date' datatype-customized='true' name='[Calculated report_month (copy)_7684900221559934982]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATEPARSE ( &quot;MMM yy&quot;, LEFT(DATENAME(&apos;month&apos;, [report_month]), 3) + &quot; &quot; + RIGHT(STR(YEAR([report_month])), 2) ))' />
      </column>
      <column datatype='integer' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF MAX([Calculation_8966596522392367203]) THEN&#10;  RANK_UNIQUE([Calculation_2736851596373852162], &apos;desc&apos;)&#10;ELSE&#10;  NULL&#10;END'>
          <table-calc ordering-field='[federated.0aojulh00506xl18ssb3e1wtgnnt].[sub_entity]' ordering-type='Field' />
        </calculation>
      </column>
      <column aggregation='Sum' caption='DH logo filter' datatype='integer' name='[Calculation_1716012229274083351]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='1' />
        <aliases>
          <alias key='1' value='Delivery Hero' />
        </aliases>
      </column>
      <column caption='Last N Months' datatype='boolean' name='[Calculation_2544885665558810627]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_2946972666874032132] &gt; DATEADD(&apos;month&apos;, -[Parameters].[Parameter 7], {MAX([Calculation_2946972666874032132])})&#10;AND [Calculation_2946972666874032132] &lt;= {MAX([Calculation_2946972666874032132])}' />
      </column>
      <column caption='Markup weighted by GBV %' datatype='real' name='[Calculation_2736851596373852162]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([item_GBV_markup_sum])/SUM([total_item_GBV_sum])' />
      </column>
      <column caption='Offline % of vendors with all items &lt;15% markup' datatype='real' name='[Calculation_2946972666503282688]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendors_with_less_15_markup_collected] + [vendors_with_less_15_markup_uncollected])/SUM([Calculation_515662191038328832])' />
      </column>
      <column caption='Markup age calculated' datatype='string' name='[Calculation_2946972666570596354]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [markup_age] WHEN  &apos;1-2M&apos; THEN &apos;0-2 Months&apos;&#10;WHEN &apos;New Case&apos; THEN &apos;0-2 Months&apos;&#10;ELSE &apos;3M+&apos; END' />
      </column>
      <column caption='Calculated report_month' datatype='date' datatype-customized='true' name='[Calculation_2946972666874032132]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATEPARSE ( &quot;MMM yy&quot;, LEFT(DATENAME(&apos;month&apos;, [report_month]), 3) + &quot; &quot; + RIGHT(STR(YEAR([report_month])), 2) )) ' />
      </column>
      <column caption='previous percentage offline markups (offline)' datatype='real' name='[Calculation_2946972666884263942]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN([Calculation_2946972666503282688]) - LOOKUP(ZN([Calculation_2946972666503282688]), -1)) / ABS(LOOKUP(ZN([Calculation_2946972666503282688]), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='color effective (online)' datatype='string' name='[Calculation_2946972666903535623]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [previous percentage effective (online) (copy)_1488510077202276352] &gt; 0 THEN &apos;Red&apos;&#10;ELSEIF [previous percentage effective (online) (copy)_1488510077202276352] &lt; 0 THEN &apos;Green&apos;&#10;ELSE &apos;Yellow&apos;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_3559110407244439552]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]=USERNAME()' />
      </column>
      <column caption='Calculated_online_vendors' datatype='integer' name='[Calculation_515662191038328832]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [report_month], [global_entity_id], [cohort_month] : MIN([online_vendors_count])}' />
      </column>
      <column caption='percentage of total (markup GBV)' datatype='real' name='[Calculation_5789025515483484164]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_5789025515483635717]) / TOTAL(SUM([Calculation_5789025515483635717]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='markup_gbv_last_month' datatype='real' name='[Calculation_5789025515483635717]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF DATEDIFF(&apos;month&apos;, [Calculation_2946972666874032132], TODAY()) &lt;= 1 THEN [item_GBV_markup_sum]&#10; END' />
      </column>
      <column caption='Total_vendors_with_less_than_15' datatype='real' name='[Calculation_5789025515485958152]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([vendors_with_less_15_markup_collected] + [vendors_with_less_15_markup_uncollected])' />
      </column>
      <column caption='Exclusion for online markups' datatype='boolean' name='[Calculation_5789025518332420116]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [global_entity_id] = &apos;HF_EG&apos; and [markup_type] = &apos;Online&apos;&#10;THEN TRUE &#10;ELSEIF [global_entity_id] = &apos;TB_OM&apos; and [markup_type] = &apos;Online&apos;&#10;THEN TRUE&#10;ELSEIF [global_entity_id] = &apos;GV_RO&apos; and [markup_type] = &apos;Online&apos;&#10;THEN TRUE&#10;ELSEIF [global_entity_id] = &apos;GV_MA&apos; and [markup_type] = &apos;Online&apos;&#10;THEN TRUE&#10;ELSEIF [global_entity_id] = &apos;GV_CI&apos; and [markup_type] = &apos;Online&apos;&#10;THEN TRUE&#10;ELSEIF [global_entity_id] = &apos;GV_UA&apos; and [markup_type] = &apos;Online&apos;&#10;THEN TRUE&#10;ELSEIF [global_entity_id] = &apos;GV_KG&apos; and [markup_type] = &apos;Online&apos;&#10;THEN TRUE&#10;ELSEIF [global_entity_id] = &apos;PY_AR&apos; and [markup_type] = &apos;Online&apos;&#10;THEN TRUE&#10;ELSEIF [source_platform] = &apos;mrsool&apos; and [markup_type] = &apos;Online&apos;&#10;THEN TRUE &#10;ELSEIF [source_platform] = &apos;fork&apos; and [markup_type] = &apos;Online&apos;&#10;THEN TRUE &#10;else FALSE END' />
      </column>
      <column caption='max month' datatype='boolean' name='[Calculation_8966596522392367203]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[report_month] = {FIXED : MAX([report_month])}' />
      </column>
      <column caption='Total' datatype='real' name='[Calculation_8966596522397065320]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_SUM([Calculation_2736851596373852162])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Markup weighted by GBV % (markup age breakdown)' datatype='real' name='[Markup weighted by GBV % (copy)_2946972666858254339]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([item_GBV_markup_sum]) / SUM({FIXED [report_month] : SUM([total_item_GBV_sum])})' />
      </column>
      <column caption='offline items &lt;15 % (markup age breakdown)' datatype='real' name='[Markup weighted by GBV % (markup age breakdown) (copy)_4751930958330916864]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendors_with_less_15_markup_collected] + [vendors_with_less_15_markup_uncollected]) / SUM({FIXED [report_month] : SUM([Calculation_515662191038328832])})' />
      </column>
