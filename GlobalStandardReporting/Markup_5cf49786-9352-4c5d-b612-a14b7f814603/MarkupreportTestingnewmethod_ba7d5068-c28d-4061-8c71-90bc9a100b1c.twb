      <column caption='@Total Better Fee PoP' datatype='real' name='[@Previous vendor count better fee (copy)_5625347788231061508]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(([Calculation_5625347788230254593]-[@current vendor count better fee (copy)_5625347788230500354])/[@current vendor count better fee (copy)_5625347788230500354],4)' />
      </column>
      <column caption='@Previous vendor count better fee' datatype='integer' name='[@current vendor count better fee (copy)_5625347788230500354]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [report_date] = [Calculation_5625347788230742019] AND [Calculation_4410009203522232328] = &apos;Lower Fee on DH&apos; THEN [vendor_count] END)' />
      </column>
      <column caption='Vendor % Higher Fee on DH' datatype='real' name='[Calculation_3628212459242700801]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_4410009203522232328] = &apos;Higher Fee on DH&apos; THEN [vendor_count] END)/&#10;SUM([vendor_count])' />
      </column>
      <column caption='Delivery Fee Flag' datatype='string' name='[Calculation_4410009203522232328]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;[size_bucket] = &apos;+70% Lower on DH&apos;&#10;OR [size_bucket] = &apos;50-70% Lower on DH&apos;&#10;OR [size_bucket] = &apos;30-50% Lower on DH&apos;&#10;OR [size_bucket] = &apos;5-30% Lower on DH&apos;&#10;THEN &apos;Lower Fee on DH&apos;&#10;ELSEIF &#10;[size_bucket] = &apos;+70% Higher on DH&apos;&#10;OR [size_bucket] = &apos;50-70% Higher on DH&apos;&#10;OR [size_bucket] = &apos;30-50% Higher on DH&apos;&#10;OR [size_bucket] = &apos;5-30% Higher on DH&apos;&#10;&#10;//[size_bucket] = &apos;100% More on DH&apos;&#10;//OR [size_bucket] = &apos;99% More on DH&apos;&#10;//OR [size_bucket] = &apos;98% More on DH&apos;&#10;//OR [size_bucket] = &apos;97% More on DH&apos;&#10;//OR [size_bucket] = &apos;96% More on DH&apos;&#10;//OR [size_bucket] = &apos;90-95% More on DH&apos;&#10;//OR [size_bucket] = &apos;80-90% More on DH&apos;&#10;//OR [size_bucket] = &apos;50-80% More on DH&apos;&#10;//OR [size_bucket] = &apos;10-90% More on DH&apos;&#10;THEN &apos;Higher Fee on DH&apos;&#10;ELSE [size_bucket] END' />
        <aliases>
          <alias key='&quot;At Par With DH&quot;' value='At Par' />
        </aliases>
      </column>
      <column caption='Date Selector' datatype='boolean' name='[Calculation_4410009203572015123]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[report_date] = [Parameters].[Parameter 1 1]' />
      </column>
      <column caption='Size_bucket_Alias' datatype='string' name='[Calculation_4649051833961480192]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [size_bucket] = &apos;10-30% Higher on DH&apos; Then &apos;10-30%&apos;&#10;ELSEIF [size_bucket] = &apos;30-50% Higher on DH&apos; Then &apos;30-50%&apos;&#10;ELSEIF [size_bucket] = &apos;50-70% Higher on DH&apos; Then &apos;50-70%&apos;&#10;ELSEIF [size_bucket] = &apos;+70% Higher on DH&apos; Then &apos;+70%&apos;&#10;END' />
      </column>
