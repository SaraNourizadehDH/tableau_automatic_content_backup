      <aliases enabled='yes' />
      <column caption='CVR' datatype='real' name='[Calculation_1161225044643995648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sessions_with_orders])/SUM([sessions])' />
      </column>
      <column caption='Session Color Dimension' datatype='string' name='[Calculation_1231241945111834624]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Visit Type&apos;&#10;THEN STR([visit_type])&#10;ELSEIF  [Parameters].[Parameter 1] = &apos;is_logged_in&apos;&#10;THEN STR([is_logged_in])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;address_submitted_event&apos;&#10;THEN STR([address_submitted_event])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;shop_list_updated&apos;&#10;THEN STR([shop_list_updated]) END' />
      </column>
      <column caption='mCVR1' datatype='real' name='[Calculation_1262204192555864068]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([mcvr1_total])/SUM([mocvr1_count])' />
      </column>
      <column caption='mCVR2' datatype='real' name='[Calculation_1262204192556363781]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([mcvr2_total])/SUM([mocvr2_count])' />
      </column>
      <column caption='mCVR3' datatype='real' name='[Calculation_1262204192556548102]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([mcvr3_total])/SUM([mocvr3_count])' />
      </column>
      <column caption='mCVR4' datatype='real' name='[Calculation_1262204192556699655]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([mcvr4_total])/SUM([mocvr4_count])' />
      </column>
      <column caption='m0CVR1' datatype='real' name='[Calculation_1262204192557113352]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([mocvr1_total])/SUM([mocvr1_count])' />
      </column>
      <column caption='Time to Order' datatype='real' default-format='*hh:mm:ss' name='[Calculation_1262204192572346381]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([time_to_order_total])/SUM([sessions_with_orders]))/86400' />
      </column>
      <column caption='Time Home' datatype='real' default-format='*hh:mm:ss' name='[Calculation_1262204192579231760]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([time_home_total])/SUM([time_home_count]))/86400' />
      </column>
      <column caption='Time List' datatype='real' default-format='*hh:mm:ss' name='[Calculation_1262204192579588113]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([time_list_total])/SUM([time_list_count]))/86400' />
      </column>
      <column caption='ISO-Week' datatype='string' name='[Calculation_1598003839837859840]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;W&apos;+str(If datepart(&apos;week&apos;,[report_date])=53 then 1 else datepart(&apos;week&apos;,[report_date]) end)' />
      </column>
      <column caption='Year' datatype='integer' name='[Calculation_1598003839838646273]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='If datepart(&apos;week&apos;,[report_date])=53 then datepart(&apos;year&apos;,[report_date])+1 else datepart(&apos;year&apos;,[report_date]) end' />
      </column>
      <column caption='Mobile Filter' datatype='boolean' name='[Calculation_2233081756287938560]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[platform] IN (&apos;Android&apos;,&apos;iOS&apos;,&apos;mWeb&apos;)' />
      </column>
      <column caption='Time Menu' datatype='real' default-format='*hh:mm:ss' name='[Time List (copy)_1262204192580214802]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([time_menu_total])/SUM([time_menu_count]))/86400' />
