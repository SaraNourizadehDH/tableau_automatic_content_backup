  <worksheets>
    <worksheet name='% Sessions by App Version'>
      <layout-options>
        <title>
          <formatted-text>
            <run>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tech_dash_v7' name='federated.082hdba1st72hr17zl4ue0x3ytsb' />
          </datasources>
          <datasource-dependencies datasource='federated.082hdba1st72hr17zl4ue0x3ytsb'>
            <column caption='CVR' datatype='real' name='[Calculation_2233081756289437698]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sessions_with_orders])/SUM([sessions])' />
            </column>
            <column caption='Mobile App filter' datatype='boolean' name='[Calculation_2233081756289728515]' role='dimension' type='nominal'>
