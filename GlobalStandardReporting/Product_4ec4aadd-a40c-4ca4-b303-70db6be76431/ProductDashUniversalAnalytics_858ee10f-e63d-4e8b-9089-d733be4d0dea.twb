    <worksheet name='Microconversions'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Microconversions (</run>
            <run bold='true' fontcolor='#dc4a51'>CY</run>
            <run bold='true'> vs </run>
            <run bold='true' fontcolor='#b5aaa6'>PY</run>
            <run bold='true'>)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='weekly_product_dash' name='federated.1xd144q13m69uq1gmu2xb126k117' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' datatype-customized='true' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;weekly&quot;'>
              <calculation class='tableau' formula='&quot;weekly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1xd144q13m69uq1gmu2xb126k117'>
            <column caption='Sessions CY' datatype='integer' name='[Calculation_281404640477655040]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF YEAR([report_date]) = YEAR(TODAY()) THEN [sessions] end)' />
            </column>
            <column caption='CVR CY' datatype='real' name='[Calculation_281404640479170564]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF YEAR([report_date]) = YEAR(TODAY()) THEN [sessions_with_orders] end)/[Calculation_281404640477655040]' />
            </column>
            <column caption='Date Granular' datatype='string' datatype-customized='true' name='[Calculation_281404640480833545]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;weekly&apos;&#10;THEN &apos;W&apos;+ STR(WEEK([report_date]))&#10;ELSEIF [Parameters].[Parameter 2] = &apos;monthly&apos;&#10;THEN DATENAME(&apos;month&apos;,[report_date])&#10;END' />
            </column>
