    <worksheet name='mCVR comparison with previous year'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>mCVRs % Change vs PY</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='weekly_product_dash' name='federated.1xd144q13m69uq1gmu2xb126k117' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' datatype-customized='true' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;weekly&quot;'>
              <calculation class='tableau' formula='&quot;weekly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1xd144q13m69uq1gmu2xb126k117'>
            <column caption='Sessions CY' datatype='integer' name='[Calculation_281404640477655040]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF YEAR([report_date]) = YEAR(TODAY()) THEN [sessions] end)' />
            </column>
            <column caption='Date Granular' datatype='string' datatype-customized='true' name='[Calculation_281404640480833545]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;weekly&apos;&#10;THEN &apos;W&apos;+ STR(WEEK([report_date]))&#10;ELSEIF [Parameters].[Parameter 2] = &apos;monthly&apos;&#10;THEN DATENAME(&apos;month&apos;,[report_date])&#10;END' />
            </column>
            <column caption='mCVR1 CY' datatype='real' name='[Calculation_335940417254281220]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([mcvr1_total])/SUM([mocvr1_count])' />
            </column>
            <column caption='mCVR1 % Change' datatype='real' name='[Calculation_335940417261019148]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_335940417254281220] - [mCVR1 CY (copy)_335940417254916104])/[mCVR1 CY (copy)_335940417254916104]' />
            </column>
            <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='mCVR4 % Change' datatype='real' name='[mCVR1 % Change (copy) (copy) (copy)_335940417261232143]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([mCVR1 CY (copy) (copy) (copy)_335940417254445063] - [mCVR3 PY (copy)_335940417255546891])/[mCVR3 PY (copy)_335940417255546891]' />
            </column>
            <column caption='mCVR3 % Change' datatype='real' name='[mCVR1 % Change (copy) (copy)_335940417261228046]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([mCVR1 CY (copy) (copy)_335940417254436870] - [mCVR2 PY (copy)_335940417255460874])/[mCVR2 PY (copy)_335940417255460874]' />
