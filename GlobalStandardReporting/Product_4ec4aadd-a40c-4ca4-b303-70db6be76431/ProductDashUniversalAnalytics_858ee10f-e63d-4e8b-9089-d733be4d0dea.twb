      <column caption='Sessions CY' datatype='integer' name='[Calculation_281404640477655040]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF YEAR([report_date]) = YEAR(TODAY()) THEN [sessions] end)' />
      </column>
      <column caption='Total Orders CY' datatype='integer' name='[Calculation_281404640478699523]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF YEAR([report_date]) = YEAR(TODAY()) THEN [total_orders] end)' />
      </column>
