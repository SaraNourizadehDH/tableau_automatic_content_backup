      <aliases enabled='yes' />
      <column caption='Campaign Start' datatype='string' name='[Calculation_6623669201784127488]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(DATE(DATETRUNC(&apos;day&apos;, [campaign_start_date])))' />
      </column>
      <column caption='index' datatype='integer' name='[Calculation_6623669201785446401]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Campaign Duration in Days' datatype='string' name='[Calculation_6623669201785634818]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(DATEDIFF(&apos;day&apos;, DATE(DATETRUNC(&apos;day&apos;, [campaign_start_date])), DATE(DATETRUNC(&apos;day&apos;, [campaign_end_date]))))' />
      </column>
      <column caption='Customers During' datatype='integer' name='[Calculation_6623669201787748355]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [campaign_name]: COUNTD([customer_id])}' />
      </column>
      <column caption='Total Number of Campaigns' datatype='integer' name='[Calculation_6623669201799127045]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([campaign_name])' />
      </column>
      <column caption='Campaign End' datatype='string' name='[Calculation_6623669201800208390]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(DATE(DATETRUNC(&apos;day&apos;, [campaign_end_date])))' />
      </column>
      <column caption='Incentivisation' datatype='string' name='[Calculation_6623669201806344200]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([voucher_code]) THEN &apos;Non Incentivised&apos;&#10;ELSE &apos;Incentivised&apos;&#10;END' />
      </column>
