            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1xxntdh1rzp55g13hiuys0hfxu5c'>
            <column caption='€ Avg. cohort revenue' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[# Avg. cohort GMV (copy)_335518197480730632]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([revenue_eur_7day]) / SUM([triggers_in_scope_num])' />
            </column>
            <column caption='€ Avg. cohort GMV' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[# Avg. cohort orders (copy)_335518197480607751]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_eur_7day]) / SUM([triggers_in_scope_num])' />
            </column>
            <column caption='% Redemption rate (#)' datatype='real' default-format='p0.0%' name='[% Compensation rate (copy)_335518197478211585]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([redeemed_voucher_num]) / SUM([voucher_num])' />
            </column>
            <column caption='% Reorder rate' datatype='real' default-format='p0.0%' name='[% Compensation rate (copy)_335518197479485445]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([customers_7day]) / SUM([triggers_in_scope_num])' />
            </column>
            <column caption='% Redemption rate (€)' datatype='real' default-format='p0.0%' name='[% Redemption rate (#) (copy)_1906781874087415808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([redeemed_voucher_value_eur]) / SUM([voucher_value_eur])' />
            </column>
            <column caption='€ Avg. treatment cost' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[% Reorder rate (copy)_64739271176708106]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([redeemed_voucher_value_eur]) / SUM([events_num (copy)_1347983689758314496 1])' />
            </column>
            <column caption='€ Avg. voucher value' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg. entity GMV (copy)_335518197478842372]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([voucher_value_eur]) / SUM([voucher_num])' />
            </column>
            <column caption='% Seamless' datatype='real' name='[Calculation_1906781874109194241]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [sox_order_experience] = &quot;Seamless&quot; THEN [events_num (copy)_1347983689758314496 1] ELSE 0 END) &#10;/ &#10;SUM([events_num (copy)_1347983689758314496 1])' />
            </column>
            <column caption='Contacts Different Reason' datatype='integer' name='[Calculation_2650438766790189057]' role='measure' type='quantitative'>
