          <datasource-dependencies datasource='federated.1xxntdh1rzp55g13hiuys0hfxu5c'>
            <column caption='% Redemption rate (#)' datatype='real' default-format='p0.0%' name='[% Compensation rate (copy)_335518197478211585]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([redeemed_voucher_num]) / SUM([voucher_num])' />
            </column>
            <column caption='% Treatment compensation rate' datatype='real' default-format='p0%' name='[% Compensation rate (copy)_64739271178317835]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([voucher_num]) / SUM([events_num (copy)_1347983689758314496 1])' />
            </column>
            <column caption='% Redemption rate (€)' datatype='real' default-format='p0.0%' name='[% Redemption rate (#) (copy)_1906781874087415808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([redeemed_voucher_value_eur]) / SUM([voucher_value_eur])' />
