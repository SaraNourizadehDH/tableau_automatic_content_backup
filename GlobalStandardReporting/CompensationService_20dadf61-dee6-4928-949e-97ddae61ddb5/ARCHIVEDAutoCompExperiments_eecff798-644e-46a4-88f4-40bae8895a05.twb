      </column>
      <column caption='Metric ' datatype='real' name='[Calculation_64739271234220055]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;    WHEN &apos;# In-scope triggers&apos; THEN SUM([triggers_in_scope_num])&#13;&#10;    WHEN &apos;# Treatment triggers&apos; THEN SUM([events_num (copy)_1347983689758314496 1])&#13;&#10;    WHEN &apos;# Control triggers&apos; THEN SUM([events_num (copy)_1347983689758314496])&#13;&#10;    WHEN &apos;% Treated&apos; THEN [% In-scope (copy)_818529261346951170]&#13;&#10;    WHEN &apos;% Compensation rate&apos; THEN [Calculation_335518197477593088]&#13;&#10;    WHEN &apos;% Treatment compensation rate&apos; THEN [% Compensation rate (copy)_64739271178317835]&#13;&#10;    WHEN &apos;€ Avg. voucher value&apos; THEN [Avg. entity GMV (copy)_335518197478842372]&#13;&#10;    WHEN &apos;% Redemption rate&apos; THEN [% Compensation rate (copy)_335518197478211585]&#13;&#10;    WHEN &apos;€ Avg. Treatment cost&apos; THEN [% Reorder rate (copy)_64739271176708106]&#13;&#10;    WHEN &apos;% Reorder rate&apos; THEN [% Compensation rate (copy)_335518197479485445]&#13;&#10;    WHEN &apos;% Incremental reorder rate&apos; THEN [% Control reorder rate (copy)_1347983689770242053]&#13;&#10;    WHEN &apos;# Avg. cohort orders&apos; THEN [€ Avg. entity GMV (copy)_335518197480439814]&#13;&#10;    WHEN &apos;€ Avg. cohort GMV&apos; THEN [# Avg. cohort orders (copy)_335518197480607751]&#13;&#10;    WHEN &apos;€ Avg. cohort revenue&apos; THEN [# Avg. cohort GMV (copy)_335518197480730632]&#13;&#10;    WHEN &apos;€ Avg. incremental revenue&apos; THEN [% Incremental reorder rate (copy)_64739271176318985]&#13;&#10;    WHEN &apos;€ Avg. incremental revenue per cost&apos; THEN [€ Avg. incremental revenue (copy)_64739271178780684]&#13;&#10;END' />
      </column>
      <column caption='% Related contact rate' datatype='real' default-format='p0.0%' name='[Calculation_6508686643787911168]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([contacts_after_event_same_reason]+[contacts_before_event_same_reason]) / SUM([triggers_in_scope_num])' />
      </column>
      <column caption='% Unrelated contact rate' datatype='real' default-format='p0.0%' name='[Calculation_6508686643788353537]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([contacts_before_event_different_reason]+[contacts_after_event_different_reason]) / SUM([triggers_in_scope_num])' />
      </column>
      <column caption='% Contact rate before (customer-based)' datatype='real' default-format='p0.0%' name='[Calculation_6508686644131504130]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([contacts_before_event_same_reason] + [contacts_before_event_different_reason]) / SUM([triggers_in_scope_num])' />
      </column>
      <column caption='% Contact rate after (customer-based)' datatype='real' default-format='p0.0%' name='[Calculation_6508686644135055363]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([contacts_after_event_different_reason]+[contacts_after_event_same_reason]) / SUM([triggers_in_scope_num])' />
      </column>
      <column caption='Dimension 1 ' datatype='string' name='[Calculation_767300813839069195]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#13;&#10;    WHEN &apos;Total&apos; THEN &apos;Total&apos;&#13;&#10;    WHEN &apos;GST region&apos; THEN [region]&#13;&#10;    WHEN &apos;Contact center&apos; THEN  [contact_center]&#13;&#10;    WHEN &apos;Management entity&apos; THEN [management_entity_group (copy)_64739271228715027]&#13;&#10;    WHEN &apos;Country&apos; THEN [country]&#13;&#10;    WHEN &apos;Brand&apos; THEN [brand]&#13;&#10;    WHEN &apos;Event type&apos; THEN [event_type]&#13;&#10;END' />
      </column>
      <column caption='Experiment group' datatype='string' name='[Calculation_767300813850083344]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [is_control_group]&#13;&#10;&#13;&#10;    WHEN TRUE THEN &apos;control&apos; // combine RBM and DSM control groups&#13;&#10;&#13;&#10;ELSE&#13;&#10;&#13;&#10;    CASE [Parameters].[Parameter 5]&#13;&#10;    WHEN &apos;Combine&apos; THEN &apos;treatment&apos;&#13;&#10;    ELSE [treatment_name] END&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Metric is zero' datatype='boolean' name='[Calculation_818529261359890435]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IFNULL([Calculation_64739271234220055], 0) = 0' />
      </column>
      <column caption='Date range relative' datatype='date' name='[Date (copy)_1929299920424243202]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[event_date]' />
      </column>
      <column caption='incomplete cohort filter' datatype='boolean' name='[Date (copy)_64739271235239960]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{FIXED [Calculation_64739271233048598]: MAX([event_date])}+ 7 &lt; TODAY() OR [Parameters].[Parameter 3] = &apos;Display&apos;' />
      </column>
      <column caption='Dimension 2 ' datatype='string' name='[Dimension 1 param (copy)_767300813839425548]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Dimension 1 (copy)_767300813838934026]&#13;&#10;    WHEN &apos;Total&apos; THEN &apos;Total&apos;&#13;&#10;    WHEN &apos;GST region&apos; THEN [region]&#13;&#10;    WHEN &apos;Contact center&apos; THEN  [contact_center]&#13;&#10;    WHEN &apos;Management entity&apos; THEN [management_entity_group (copy)_64739271228715027]&#13;&#10;    WHEN &apos;Country&apos; THEN [country]&#13;&#10;    WHEN &apos;Brand&apos; THEN [brand]&#13;&#10;    WHEN &apos;Event type&apos; THEN [event_type]&#13;&#10;END' />
      </column>
      <column caption='Event type 1VU filter' datatype='string' name='[Event type (copy)_957014965163237376]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[event_type]' />
      </column>
      <column caption='Experiment group (fixed)' datatype='string' name='[Experiment group (copy)_4809140732974182411]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [is_control_group]&#13;&#10;&#13;&#10;    WHEN TRUE THEN &apos;control&apos; // combine RBM and DSM control groups&#13;&#10;&#13;&#10;ELSE&#13;&#10;&#13;&#10;&apos;treatment&apos;&#13;&#10;   &#13;&#10;&#13;&#10;END' />
      </column>
