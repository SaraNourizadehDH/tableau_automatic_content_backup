      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='autocomp_performance' name='federated.1xxntdh1rzp55g13hiuys0hfxu5c' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Reorder rate' caption='Rate' datatype='string' name='[Date granularity (copy)_4809140732987396108]' param-domain-type='list' role='measure' type='nominal' value='&quot;Reorder Rate&quot;'>
              <calculation class='tableau' formula='&quot;Reorder Rate&quot;' />
              <aliases>
                <alias key='&quot;Contact Rate&quot;' value='Contact rate' />
                <alias key='&quot;Reorder Rate&quot;' value='Reorder rate' />
              </aliases>
            </column>
            <column caption='Date granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1xxntdh1rzp55g13hiuys0hfxu5c'>
            <column caption='€ Avg. cohort revenue' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[# Avg. cohort GMV (copy)_335518197480730632]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([revenue_eur_7day]) / SUM([triggers_in_scope_num])' />
            </column>
            <column caption='€ Avg. cohort GMV' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[# Avg. cohort orders (copy)_335518197480607751]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_eur_7day]) / SUM([triggers_in_scope_num])' />
            </column>
            <column caption='% Reorder rate' datatype='real' default-format='p0.0%' name='[% Compensation rate (copy)_335518197479485445]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([customers_7day]) / SUM([triggers_in_scope_num])' />
            </column>
            <column caption='% Reorder rate upper bound' datatype='real' default-format='p0.0%' name='[% Reorder rate (copy)_767300813853888529]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF 2 * SQRT([% Compensation rate (copy)_335518197479485445] * (1-[% Compensation rate (copy)_335518197479485445]) * SUM([triggers_in_scope_num])) / SUM([triggers_in_scope_num]) + [% Compensation rate (copy)_335518197479485445] &gt;= 1 THEN 1&#10;ELSE 2 * SQRT([% Compensation rate (copy)_335518197479485445] * (1-[% Compensation rate (copy)_335518197479485445]) * SUM([triggers_in_scope_num])) / SUM([triggers_in_scope_num]) + [% Compensation rate (copy)_335518197479485445] END' />
            </column>
            <column caption='% Reorder rate lower bound' datatype='real' default-format='p0.0%' name='[% Reorder rate upper bound (copy)_767300813854765074]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF - 2 * SQRT([% Compensation rate (copy)_335518197479485445] * (1-[% Compensation rate (copy)_335518197479485445]) * SUM([triggers_in_scope_num])) / SUM([triggers_in_scope_num]) + [% Compensation rate (copy)_335518197479485445] &lt;= 0 THEN 0&#10;ELSE - 2 * SQRT([% Compensation rate (copy)_335518197479485445] * (1-[% Compensation rate (copy)_335518197479485445]) * SUM([triggers_in_scope_num])) / SUM([triggers_in_scope_num]) + [% Compensation rate (copy)_335518197479485445] END' />
            </column>
            <column caption='Contacts Different Reason' datatype='integer' name='[Calculation_2650438766790189057]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[contacts_after_event_different_reason] + [contacts_before_event_different_reason]' />
            </column>
            <column caption='Contacts Same Reason' datatype='integer' name='[Calculation_2650438766790316034]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[contacts_after_event_same_reason] + [contacts_before_event_same_reason]' />
            </column>
            <column caption='All Contacts' datatype='integer' name='[Calculation_2650438766790664195]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2650438766790189057] + [Calculation_2650438766790316034]' />
            </column>
            <column caption='% Overall contact rate (customer-based)' datatype='real' default-format='p0.0%' name='[Calculation_2650438766790799364]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2650438766790664195]) / SUM([triggers_in_scope_num])' />
            </column>
            <column caption='Experiment &amp; # Events' datatype='string' name='[Calculation_2650438766853160967]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[experiment_name (copy)_64739271228944404] + &quot; - &quot; + STR({FIXED [experiment_name (copy)_64739271228944404]: SUM([triggers_in_scope_num])}) + &quot; events&quot;' />
            </column>
            <column caption='# Events' datatype='integer' name='[Calculation_3395010481474605057]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([events_num (copy)_1347983689758314496]) = 0 THEN SUM([events_num (copy)_1347983689758314496 1]) ELSEIF SUM([events_num (copy)_1347983689758314496 1]) = 0 THEN SUM([events_num (copy)_1347983689758314496]) END' />
            </column>
            <column caption='reorder_or_contact' datatype='real' default-format='p0.0%' name='[Calculation_4809140732987682829]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Date granularity (copy)_4809140732987396108] = &apos;Reorder Rate&apos; THEN [% Compensation rate (copy)_335518197479485445] ELSE [Calculation_2650438766790799364] END' />
            </column>
            <column caption='Date range' datatype='string' datatype-customized='true' name='[Calculation_64739271233048598]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &apos;Daily&apos; THEN STR([event_date])&#13;&#10;    WHEN &apos;Weekly&apos; THEN [event_week]&#13;&#10;    WHEN &apos;Monthly&apos; THEN [event_month]&#13;&#10;END' />
            </column>
            <column caption='Experiment group (fixed)' datatype='string' name='[Experiment group (copy)_4809140732974182411]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [is_control_group]&#13;&#10;&#13;&#10;    WHEN TRUE THEN &apos;control&apos; // combine RBM and DSM control groups&#13;&#10;&#13;&#10;ELSE&#13;&#10;&#13;&#10;&apos;treatment&apos;&#13;&#10;   &#13;&#10;&#13;&#10;END' />
            </column>
