            </column>
            <column caption='% Overall contact rate (customer-based)' datatype='real' default-format='p0.0%' name='[Calculation_2650438766790799364]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2650438766790664195]) / SUM([triggers_in_scope_num])' />
            </column>
            <column caption='% Compensation rate' datatype='real' default-format='p0.0%' name='[Calculation_335518197477593088]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([voucher_num]) / SUM([triggers_in_scope_num])' />
            </column>
            <column caption='% Contact rate before (customer-based)' datatype='real' default-format='p0.0%' name='[Calculation_6508686644131504130]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([contacts_before_event_same_reason] + [contacts_before_event_different_reason]) / SUM([triggers_in_scope_num])' />
