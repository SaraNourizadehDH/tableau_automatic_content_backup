    <worksheet name='Experiments_'>
      <table>
        <view>
          <datasources>
            <datasource caption='autocomp_performance' name='federated.1xxntdh1rzp55g13hiuys0hfxu5c' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Dimension 2' datatype='string' name='[Dimension 1 (copy)_767300813838934026]' param-domain-type='list' role='measure' type='nominal' value='&quot;Total&quot;'>
              <calculation class='tableau' formula='&quot;Total&quot;' />
            </column>
            <column caption='Dimension 1' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Total&quot;'>
              <calculation class='tableau' formula='&quot;Total&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1xxntdh1rzp55g13hiuys0hfxu5c'>
            <column caption='€ Avg. Treatment GMV' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[# Avg. Treatment orders (copy)_64739271175180292]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([# Treatment cohort orders (copy)_64739271169519617]) / SUM([events_num (copy)_1347983689758314496 1])' />
            </column>
            <column caption='# Avg. Control orders' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[# Avg. Treatment orders (copy)_64739271175675912]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([# Treatment customers (copy)_64739271169437696 1]) / SUM([events_num (copy)_1347983689758314496])' />
            </column>
            <column caption='# Treatment customers' datatype='integer' name='[# Control events (copy)_1347983689765011458 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [is_control_group] WHEN FALSE THEN [customers_7day] ELSE 0 END' />
            </column>
            <column caption='# Control customers' datatype='integer' name='[# Control events (copy)_1347983689765011458]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [is_control_group] WHEN TRUE THEN [customers_7day] ELSE 0 END' />
            </column>
            <column caption='# Control cohort GMV' datatype='real' name='[# Treatment cohort orders (copy)_64739271169519617 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [is_control_group] WHEN TRUE THEN [gmv_eur_7day] ELSE 0 END' />
            </column>
            <column caption='€ Treatment cohort GMV' datatype='real' name='[# Treatment cohort orders (copy)_64739271169519617]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [is_control_group] WHEN FALSE THEN [gmv_eur_7day] ELSE 0 END' />
            </column>
            <column caption='# Control cohort orders' datatype='integer' name='[# Treatment customers (copy)_64739271169437696 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [is_control_group] WHEN TRUE THEN [orders_7day] ELSE 0 END' />
            </column>
            <column caption='# Treatment cohort orders' datatype='integer' name='[# Treatment customers (copy)_64739271169437696]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [is_control_group] WHEN FALSE THEN [orders_7day] ELSE 0 END' />
            </column>
            <column caption='% Redemption rate (#)' datatype='real' default-format='p0.0%' name='[% Compensation rate (copy)_335518197478211585]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([redeemed_voucher_num]) / SUM([voucher_num])' />
            </column>
            <column caption='% Treatment compensation rate' datatype='real' default-format='p0%' name='[% Compensation rate (copy)_64739271178317835]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([voucher_num]) / SUM([events_num (copy)_1347983689758314496 1])' />
            </column>
            <column caption='% Incremental reorder rate' datatype='real' default-format='p0.0%' name='[% Control reorder rate (copy)_1347983689770242053]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[% Reorder rate (copy)_335518197481312265 1] - [% Reorder rate (copy)_335518197481312265]' />
            </column>
            <column caption='% Redemption rate (€)' datatype='real' default-format='p0.0%' name='[% Redemption rate (#) (copy)_1906781874087415808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([redeemed_voucher_value_eur]) / SUM([voucher_value_eur])' />
            </column>
            <column caption='% Treatment reorder rate' datatype='real' default-format='p0.0%' name='[% Reorder rate (copy)_335518197481312265 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([# Control events (copy)_1347983689765011458 1]) / SUM([events_num (copy)_1347983689758314496 1])' />
            </column>
            <column caption='% Control reorder rate' datatype='real' default-format='p0.0%' name='[% Reorder rate (copy)_335518197481312265]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([# Control events (copy)_1347983689765011458]) / SUM([events_num (copy)_1347983689758314496])' />
            </column>
            <column caption='€ Avg. treatment cost' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[% Reorder rate (copy)_64739271176708106]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([redeemed_voucher_value_eur]) / SUM([events_num (copy)_1347983689758314496 1])' />
