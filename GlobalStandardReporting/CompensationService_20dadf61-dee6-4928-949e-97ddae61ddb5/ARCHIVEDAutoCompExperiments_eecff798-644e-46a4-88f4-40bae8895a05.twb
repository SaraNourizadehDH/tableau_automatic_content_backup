    <dashboard name='Experiment details'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/AutoCompperformance/Experimentdetails?rev=' id='Experimentdetails' path='/t/GlobalStandardReporting/workbooks/AutoCompperformance' revision='' site='GlobalStandardReporting' />
      <style>
