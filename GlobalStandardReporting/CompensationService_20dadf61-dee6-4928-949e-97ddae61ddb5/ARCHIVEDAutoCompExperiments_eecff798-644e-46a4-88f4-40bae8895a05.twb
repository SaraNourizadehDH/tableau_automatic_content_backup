        <calculation class='tableau' formula='IF - 2 * SQRT([% Compensation rate (copy)_335518197479485445] * (1-[% Compensation rate (copy)_335518197479485445]) * SUM([triggers_in_scope_num])) / SUM([triggers_in_scope_num]) + [% Compensation rate (copy)_335518197479485445] &lt;= 0 THEN 0&#10;ELSE - 2 * SQRT([% Compensation rate (copy)_335518197479485445] * (1-[% Compensation rate (copy)_335518197479485445]) * SUM([triggers_in_scope_num])) / SUM([triggers_in_scope_num]) + [% Compensation rate (copy)_335518197479485445] END' />
      </column>
