          <format attr='background-color' value='#343846' />
        </style-rule>
        <style-rule element='parameter-ctrl-title'>
          <format attr='text-align' value='center' />
          <format attr='color' value='#ffffff' />
        </style-rule>
      </style>
      <size maxheight='1200' maxwidth='1400' minheight='1200' minwidth='1400' preset-index='17' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='autocomp_performance' name='federated.1xxntdh1rzp55g13hiuys0hfxu5c' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Date granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
          <calculation class='tableau' formula='&quot;Daily&quot;' />
          <members>
            <member value='&quot;Daily&quot;' />
            <member value='&quot;Weekly&quot;' />
            <member value='&quot;Monthly&quot;' />
          </members>
        </column>
        <column caption='Incomplete cohorts' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Display&quot;'>
          <calculation class='tableau' formula='&quot;Display&quot;' />
          <members>
            <member value='&quot;Display&quot;' />
            <member value='&quot;Hide&quot;' />
          </members>
        </column>
        <column caption='Treatment groups' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Split&quot;'>
          <calculation class='tableau' formula='&quot;Split&quot;' />
          <members>
            <member value='&quot;Combine&quot;' />
            <member value='&quot;Split&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.1xxntdh1rzp55g13hiuys0hfxu5c'>
        <column caption='Date range' datatype='string' datatype-customized='true' name='[Calculation_64739271233048598]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &apos;Daily&apos; THEN STR([event_date])&#13;&#10;    WHEN &apos;Weekly&apos; THEN [event_week]&#13;&#10;    WHEN &apos;Monthly&apos; THEN [event_month]&#13;&#10;END' />
        </column>
        <column caption='Experiment group' datatype='string' name='[Calculation_767300813850083344]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='CASE [is_control_group]&#13;&#10;&#13;&#10;    WHEN TRUE THEN &apos;control&apos; // combine RBM and DSM control groups&#13;&#10;&#13;&#10;ELSE&#13;&#10;&#13;&#10;    CASE [Parameters].[Parameter 5]&#13;&#10;    WHEN &apos;Combine&apos; THEN &apos;treatment&apos;&#13;&#10;    ELSE [treatment_name] END&#13;&#10;&#13;&#10;END' />
        </column>
        <column caption='Brand' datatype='string' name='[brand]' role='dimension' type='nominal' />
