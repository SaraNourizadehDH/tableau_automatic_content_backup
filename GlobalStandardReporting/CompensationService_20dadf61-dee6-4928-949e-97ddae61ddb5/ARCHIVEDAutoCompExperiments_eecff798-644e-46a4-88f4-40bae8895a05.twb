        <calculation class='tableau' formula='SUM([# Treatment cohort orders (copy)_64739271169519617 1]) / SUM([events_num (copy)_1347983689758314496])' />
      </column>
      <column caption='€ Avg. Control revenue' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[€ Avg. Treatment revenue (copy)_64739271175675910]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([# Treatment cohort GMV (copy)_64739271169617922 1]) / SUM([events_num (copy)_1347983689758314496])' />
      </column>
      <column caption='# Avg. cohort orders' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[€ Avg. entity GMV (copy)_335518197480439814]' role='measure' type='quantitative'>
