            <column caption='€ Avg. Incremental GMV' datatype='real' name='[Actual Incremental Orders (copy)_4121075165543301125]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Avg. Test Orders (copy)_4121075165543071747] - [Avg. Test GMV (copy)_4121075165543161860]' />
            </column>
            <column caption='€ Avg. Control GMV' datatype='real' name='[Avg. Test GMV (copy)_4121075165543161860]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_with_voucher_eur_monthly_control]) / SUM([count_customers_monthly_control])' />
            </column>
            <column caption='€ Avg. Test GMV' datatype='real' name='[Avg. Test Orders (copy)_4121075165543071747]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_with_voucher_eur_monthly_test]) / SUM([count_customers_monthly_test])' />
