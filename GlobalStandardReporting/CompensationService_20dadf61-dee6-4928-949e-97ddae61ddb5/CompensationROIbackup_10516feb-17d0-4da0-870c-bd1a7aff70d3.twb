          <alias key='&quot;[federated.1grionh0477i1v17zrr621iain8z].[usr:Avg. Test GMV (copy)_4121075165543161860:qk]&quot;' value='€ Avg. Control GMV per Customer' />
          <alias key='&quot;[federated.1grionh0477i1v17zrr621iain8z].[usr:Avg. Test Orders (copy)_4121075165543071747:qk]&quot;' value='€ Avg. Test GMV per Customer' />
        </aliases>
      </column>
      <column caption='€ Avg. Incremental GMV' datatype='real' name='[Actual Incremental Orders (copy)_4121075165543301125]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Avg. Test Orders (copy)_4121075165543071747] - [Avg. Test GMV (copy)_4121075165543161860]' />
      </column>
      <column caption='€ Avg. Control GMV' datatype='real' name='[Avg. Test GMV (copy)_4121075165543161860]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gmv_with_voucher_eur_monthly_control]) / SUM([count_customers_monthly_control])' />
      </column>
      <column caption='Avg. Control Orders' datatype='real' name='[Avg. Test Orders (copy)_4121075165542703105]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_control_orders]) / SUM([count_customers_monthly_control])' />
      </column>
      <column caption='€ Avg. Test GMV' datatype='real' name='[Avg. Test Orders (copy)_4121075165543071747]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gmv_with_voucher_eur_monthly_test]) / SUM([count_customers_monthly_test])' />
      </column>
      <column caption='Dimension' datatype='string' name='[Calculation_1798554766387728397]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Management Entity Group&apos; THEN [management_entity_group]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Global Entity Id&apos; THEN [global_entity_id]&#10;END' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_2523986150197456898]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Avg. Test Orders' datatype='real' name='[Calculation_4121075165542600704]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_test_orders]) / SUM([count_customers_monthly_test])' />
      </column>
      <column caption='Actual Incremental Orders' datatype='real' name='[Calculation_4121075165542817794]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_4121075165542600704] - [Avg. Test Orders (copy)_4121075165542703105]) * SUM([count_customers_monthly_test])' />
      </column>
      <column caption='Month Date' datatype='date' name='[Calculation_4121075165547626503]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(STR([target_month]) + &apos;-&apos; + &apos;01&apos;)' />
      </column>
      <column caption='Is current month finished' datatype='boolean' name='[Calculation_4121075165550288904]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF YEAR([Calculation_4121075165547626503])  = YEAR(TODAY()) AND MONTH([Calculation_4121075165547626503]) = MONTH(TODAY())&#10;THEN FALSE&#10;ELSE TRUE&#10;END' />
      </column>
      <column caption='Measure Name Chart' datatype='real' name='[Calculation_4121075165556539402]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;# Actual Incremental Orders (8w)&apos; THEN [Calculation_4121075165542817794]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;€ Avg. Incremental GMV per Customer&apos; THEN [Actual Incremental Orders (copy)_4121075165543301125]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;€ Cost (Actuals)&apos; THEN SUM([redeemed_compensation_value_eur_monthly_test])&#10;ELSEIF [Parameters].[Parameter 5] = &apos;€ GMV (Actuals)&apos; THEN [€ Cost (copy)_4121075165544865798]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;GMV ROI&apos; THEN MAX([roi_monthly])&#10;END' />
      </column>
      <column caption='GMV ROI - MEG' datatype='real' name='[GMV ROI (copy)_1798554766384181260]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(([€ Test GMV (copy)_1798554766381711366] / [# Test Customers (copy)_1798554766381379587] - [€ Control GMV (copy)_1798554766381568005] / [# Control Customers (copy)_1798554766381477892]) * [# Test Customers (copy)_1798554766381379587]) / [€ Cost (copy)_1798554766382608391] - 1' />
      </column>
      <column caption='ROI metric choice ' datatype='real' name='[ROI dimension choice (copy)_1798554766388895758]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Management Entity Group&apos; THEN [GMV ROI (copy)_1798554766384181260]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Global Entity Id&apos; THEN [roi_monthly]&#10;END' />
      </column>
