            </column>
            <column caption='Is current month finished' datatype='boolean' name='[Calculation_4121075165550288904]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF YEAR([Calculation_4121075165547626503])  = YEAR(TODAY()) AND MONTH([Calculation_4121075165547626503]) = MONTH(TODAY())&#10;THEN FALSE&#10;ELSE TRUE&#10;END' />
            </column>
            <column datatype='integer' name='[count_customers_monthly_control]' role='measure' type='quantitative' />
            <column datatype='integer' name='[count_customers_monthly_test]' role='measure' type='quantitative' />
