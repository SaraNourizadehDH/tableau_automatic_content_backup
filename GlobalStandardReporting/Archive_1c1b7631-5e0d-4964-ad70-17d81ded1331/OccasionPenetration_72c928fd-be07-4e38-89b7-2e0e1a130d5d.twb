            <column alias='Yes' caption='Resize by response count' datatype='integer' name='[Parameter 3]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='Yes' />
                <alias key='2' value='No' />
              </aliases>
            </column>
