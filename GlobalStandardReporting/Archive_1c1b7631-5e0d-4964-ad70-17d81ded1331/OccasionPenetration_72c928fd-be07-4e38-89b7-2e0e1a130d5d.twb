          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Enter City Name' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;​&quot;'>
              <calculation class='tableau' formula='&quot;​&quot;' />
            </column>
            <column alias='Yes' caption='Resize by response count' datatype='integer' name='[Parameter 3]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='Yes' />
                <alias key='2' value='No' />
              </aliases>
            </column>
            <column caption='Minimum Orders Count' datatype='integer' name='[Parameter 4]' param-domain-type='any' role='measure' type='quantitative' value='2000'>
              <calculation class='tableau' formula='2000' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1xa4sq903s9hyu1b8x6tn0ba5thf'>
            <column caption='Selected vs all others' datatype='string' name='[Calculation_1360579674695983110]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 2]=[city] then &quot;Selected&quot; else &quot;All Others&quot; END' />
            </column>
            <column caption='Sizer' datatype='real' name='[Calculation_1360579674699415562]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 3]=2 then &#10;  if [Parameters].[Parameter 2]=[city] then 2.5 else .4 END&#10;&#10;else float([total_orders]) END' />
            </column>
            <column caption='Min Orders Count' datatype='boolean' name='[Calculation_1360579674965278732]' role='measure' type='nominal'>
              <calculation class='tableau' formula='SUM([total_orders])&gt;=[Parameters].[Parameter 4]' />
            </column>
            <column caption='Total number of cities' datatype='integer' name='[Calculation_1360579674977304589]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_COUNT(count([city]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='RANDOM()*4' datatype='real' name='[Calculation_1360579675008356370]' role='measure' type='quantitative' user:unnamed='Sheet 14'>
              <calculation class='tableau' formula='RANDOM()*4' />
            </column>
            <column caption='Frequency' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_3914754025982672896]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_orders] / [first_time_no_acq_acum]' />
            </column>
            <column caption='Selected City Frequency' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_4045006528205516810]' role='measure' type='quantitative'>
