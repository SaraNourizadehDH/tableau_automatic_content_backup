          <datasource-dependencies datasource='federated.1xa4sq903s9hyu1b8x6tn0ba5thf'>
            <column caption='Selected City Active Frequency' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1360579674694934530]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='If [Parameters].[Parameter 2]=[city] then [active_frequency]&#10;END' />
            </column>
            <column caption='Rank Active Frequency' datatype='integer' name='[Calculation_1360579674695475205]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK_UNIQUE(MAX([active_frequency]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Selected vs all others' datatype='string' name='[Calculation_1360579674695983110]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 2]=[city] then &quot;Selected&quot; else &quot;All Others&quot; END' />
            </column>
            <column caption='Rank Percentile Active Frequency' datatype='real' default-format='p0.0%' name='[Calculation_1360579674696175623]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK_PERCENTILE(AVG([active_frequency]))'>
