      <column caption='Online Rests with AffIndex' datatype='integer' name='[Calculation_1342213435824979998]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [Calculation_1342213435818049541] &gt; 0 THEN [vendor_id] END)' />
