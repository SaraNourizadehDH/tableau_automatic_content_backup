      <aliases enabled='yes' />
      <column caption='Avg Unit Price X' datatype='real' default-format='n#,##0.00&quot;x&quot;;-#,##0.00&quot;x&quot;' name='[Average Unit Price X (copy)_517843622968410118]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[item_price_mean]&#10;/&#10;[bmi_lc_interpolated]' />
      </column>
      <column caption='Breakdown' datatype='string' name='[Calculation_1342213435816292352]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &apos;Entity&apos; THEN [global_entity_id]&#10;    WHEN &apos;City&apos; THEN [city]&#10;    WHEN &apos;Restaurant&apos; THEN [vendor_name] + &apos; | &apos; + [vendor_id]&#10;    WHEN &apos;Sub Entity&apos; THEN [sub_entity]&#10;END' />
      </column>
      <column caption='Has Data Last Month' datatype='boolean' name='[Calculation_1342213435816861697]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{&#10;    FIXED [Calculation_1342213435816292352], [global_entity_id]:&#10;    MAX([report_month])&#10;}&#10;=&#10;{&#10;    FIXED :&#10;    MAX([report_month])&#10;}' />
      </column>
      <column caption='Is Active' datatype='boolean' name='[Calculation_1342213435817177090]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[successful_orders] &gt; 0' />
      </column>
      <column caption='Is Latest Month' datatype='boolean' name='[Calculation_1342213435817299971]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[report_month]&#10;=&#10;{&#10;    FIXED :&#10;    MAX([report_month])&#10;}' />
      </column>
      <column caption='Last Month AffInd Filter' datatype='boolean' name='[Calculation_1342213435817672708]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 6]&#10;    THEN&#10;        [latest_affordability_index] &gt;= [Parameters].[Parameter 3]&#10;        AND&#10;        [latest_affordability_index] &lt;= [Parameters].[Parameter 4]&#10;ELSE TRUE&#10;END' />
      </column>
      <column caption='Affordability Index (row-level only)' datatype='real' name='[Calculation_1342213435818049541]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[item_price_mean]&#10;/&#10;[bmi_lc_interpolated]' />
      </column>
      <column caption='Last Month Orders Filter' datatype='boolean' name='[Calculation_1342213435819896838]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[latest_successful_orders] &gt;= [Parameters].[Parameter 5]' />
      </column>
      <column caption='Area' datatype='string' name='[Calculation_1342213435820478471]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([city], &apos;NoCity&apos;) + &apos; | &apos; + IFNULL(STR([main_area_name]), &quot;NoAreaName&quot;)' />
      </column>
      <column caption='Rest PKey' datatype='string' name='[Calculation_1342213435820826632]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[global_entity_id]&#10;+&#10;&apos; &apos;&#10;+&#10;[vendor_id]' />
      </column>
      <column caption='Active Rests with AffIndex' datatype='integer' name='[Calculation_1342213435821027337]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Calculation_1342213435818049541] &gt; 0 AND [Calculation_1342213435817177090] THEN [vendor_id] END)' />
      </column>
      <column caption='Active Rests Included %' datatype='real' default-format='p0%' name='[Calculation_1342213435821203466]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1342213435821027337]&#10;/&#10;[Calculation_1342213435821309963]' />
      </column>
      <column caption='Rests Active' datatype='integer' name='[Calculation_1342213435821309963]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Calculation_1342213435817177090] THEN [Calculation_1342213435820826632] END)' />
      </column>
      <column caption='Aff Bucket' datatype='string' default-format='p0%' name='[Calculation_1342213435821461516]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1342213435818049541] &lt; 0.5 THEN &apos;0-0.5&apos;&#10;ELSEIF [Calculation_1342213435818049541] &lt; 1 THEN &apos;0.5-1&apos;&#10;ELSEIF [Calculation_1342213435818049541] &lt; 1.5 THEN &apos;1-1.5&apos;&#10;ELSEIF [Calculation_1342213435818049541] &lt; 2 THEN &apos;1.5-2&apos;&#10;ELSEIF [Calculation_1342213435818049541] &lt; 2.5 THEN &apos;2-2.5&apos;&#10;ELSEIF [Calculation_1342213435818049541] &lt; 3 THEN &apos;2.5-3&apos;&#10;ELSEIF [Calculation_1342213435818049541] &lt; 3.5 THEN &apos;3-3.5&apos;&#10;ELSEIF [Calculation_1342213435818049541] &lt; 4 THEN &apos;3.5-4&apos;&#10;ELSEIF [Calculation_1342213435818049541] &lt; 4.5 THEN &apos;4-4.5&apos;&#10;ELSEIF [Calculation_1342213435818049541] &lt; 5 THEN &apos;4.5-5&apos;&#10;ELSEIF [Calculation_1342213435818049541] &gt;= 5 THEN &apos;5+&apos;&#10;ELSE &apos;No Data&apos;&#10;END' />
      </column>
      <column caption='Avg. Unit Price X' datatype='real' default-format='n#,##0.00&quot;x&quot;;-#,##0.00&quot;x&quot;' name='[Calculation_1342213435821568013]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1342213435823222807]&#10;/&#10;ATTR([bmi_lc_interpolated])' />
      </column>
      <column caption='Affordability Index' datatype='real' default-format='n#,##0.00&quot;x&quot;;-#,##0.00&quot;x&quot;' name='[Calculation_1342213435821899791]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([successful_orders] * [Calculation_1342213435818049541])&#10;/&#10;SUM(&#10;    IF NOT ISNULL([Calculation_1342213435818049541])&#10;    THEN&#10;    [successful_orders]&#10;    END&#10;)' />
      </column>
      <column caption='AFV LC' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1342213435822002192]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gross_food_value_lc])&#10;/&#10;SUM([successful_orders])' />
