      <column aggregation='Sum' caption='Affordability Index' datatype='real' default-format='n#,##0.00&quot;x&quot;;-#,##0.00&quot;x&quot;' name='[Calculation_2091077611378905088]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[item_price_mean]&#10;/&#10;[local_price_interpolated]' />
