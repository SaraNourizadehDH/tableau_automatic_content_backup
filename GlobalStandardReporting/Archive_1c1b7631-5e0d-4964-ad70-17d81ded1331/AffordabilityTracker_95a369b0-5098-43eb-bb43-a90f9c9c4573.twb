            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Breakdown Level' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Sub Entity&quot;'>
              <calculation class='tableau' formula='&quot;Sub Entity&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.062rd3u0xuvaz217ieyop0r16t8a'>
            <column caption='Breakdown' datatype='string' name='[Calculation_1342213435816292352]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &apos;Entity&apos; THEN [global_entity_id]&#10;    WHEN &apos;City&apos; THEN [city]&#10;    WHEN &apos;Restaurant&apos; THEN [vendor_name] + &apos; | &apos; + [vendor_id]&#10;    WHEN &apos;Sub Entity&apos; THEN [sub_entity]&#10;END' />
            </column>
            <column caption='Has Data Last Month' datatype='boolean' name='[Calculation_1342213435816861697]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{&#10;    FIXED [Calculation_1342213435816292352], [global_entity_id]:&#10;    MAX([report_month])&#10;}&#10;=&#10;{&#10;    FIXED :&#10;    MAX([report_month])&#10;}' />
            </column>
            <column caption='Is Active' datatype='boolean' name='[Calculation_1342213435817177090]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[successful_orders] &gt; 0' />
            </column>
            <column caption='Affordability Index (row-level only)' datatype='real' name='[Calculation_1342213435818049541]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[item_price_mean]&#10;/&#10;[bmi_lc_interpolated]' />
            </column>
            <column caption='Area' datatype='string' name='[Calculation_1342213435820478471]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([city], &apos;NoCity&apos;) + &apos; | &apos; + IFNULL(STR([main_area_name]), &quot;NoAreaName&quot;)' />
            </column>
            <column caption='Rest PKey' datatype='string' name='[Calculation_1342213435820826632]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[global_entity_id]&#10;+&#10;&apos; &apos;&#10;+&#10;[vendor_id]' />
            </column>
            <column caption='Active Rests with AffIndex' datatype='integer' name='[Calculation_1342213435821027337]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [Calculation_1342213435818049541] &gt; 0 AND [Calculation_1342213435817177090] THEN [vendor_id] END)' />
            </column>
            <column caption='Active Rests Included %' datatype='real' default-format='p0%' name='[Calculation_1342213435821203466]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1342213435821027337]&#10;/&#10;[Calculation_1342213435821309963]' />
            </column>
            <column caption='Rests Active' datatype='integer' name='[Calculation_1342213435821309963]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [Calculation_1342213435817177090] THEN [Calculation_1342213435820826632] END)' />
            </column>
            <column caption='AFV LC' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1342213435822002192]' role='measure' type='quantitative'>
