      <column caption='Included' datatype='boolean' name='[Calculation_2091077611379073026]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [unit_price_mean] &lt; [lower_bound] or [unit_price_mean] &gt; [upper_bound] then FALSE else true end' />
