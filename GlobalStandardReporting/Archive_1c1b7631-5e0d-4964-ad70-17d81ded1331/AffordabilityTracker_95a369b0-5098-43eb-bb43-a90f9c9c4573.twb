    <dashboard name='Item Price Distribution'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/AffordabilityTracker_16632398031120/ItemPriceDistribution?rev=' id='ItemPriceDistribution' path='/t/GlobalStandardReporting/workbooks/AffordabilityTracker_16632398031120' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='1000' maxwidth='1300' minheight='1000' minwidth='1300' sizing-mode='fixed' />
      <datasources>
        <datasource caption='affordability_product_price_distributions_order_based+ (cl_intl_markets)' name='federated.1ejq8oe1ss6j9j1c59ouk0afr6go' />
      </datasources>
      <datasource-dependencies datasource='federated.1ejq8oe1ss6j9j1c59ouk0afr6go'>
