            <column caption='Avg. Promotion' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1342213435822526484]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    SUM([discount_dh_local]) + SUM([discount_other_local])&#10;    +&#10;    SUM([voucher_dh_local]) + SUM([voucher_other_local])&#10;)&#10;/&#10;SUM([gross_food_value_lc])' />
            </column>
            <column caption='Avg. Promotion X' datatype='real' default-format='n#,##0.00&quot;x&quot;;-#,##0.00&quot;x&quot;' name='[Calculation_1342213435822833685]' role='measure' type='quantitative'>
