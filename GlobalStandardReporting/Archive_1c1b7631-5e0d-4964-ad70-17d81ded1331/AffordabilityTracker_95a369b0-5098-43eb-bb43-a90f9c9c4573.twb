            <column-instance column='[Calculation_1342213435821461516]' derivation='None' name='[none:Calculation_1342213435821461516:nk]' pivot='key' type='nominal' />
            <column-instance column='[city]' derivation='None' name='[none:city:nk]' pivot='key' type='nominal' />
            <column-instance column='[display_name]' derivation='None' name='[none:display_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[main_cuisine_group_global]' derivation='None' name='[none:main_cuisine_group_global:nk]' pivot='key' type='nominal' />
            <column-instance column='[report_month]' derivation='None' name='[none:report_month:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_1342213435821309963]' derivation='User' name='[pcto:usr:Calculation_1342213435821309963:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-field='[federated.062rd3u0xuvaz217ieyop0r16t8a].[none:Calculation_1342213435821461516:nk]' ordering-type='Field' type='PctTotal' />
            </column-instance>
            <column caption='Report Month' datatype='date' default-format='*MM-YYYY' name='[report_month]' role='dimension' type='ordinal' />
            <column caption='Sub Entity' datatype='string' name='[sub_entity]' role='dimension' type='nominal' />
            <column caption='Orders' datatype='integer' name='[successful_orders]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1342213435825336353]' derivation='Sum' name='[sum:Calculation_1342213435825336353:qk]' pivot='key' type='quantitative' />
