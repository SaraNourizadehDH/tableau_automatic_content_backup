    <worksheet name='Sheet 54'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='0' fontname='Tableau Book'>The Orders Target used in this report is:</run>
            <run bold='true' fontalignment='0'><![CDATA[  <[federated.17s9i4u1l5ew2x13fgegz16vfmlo].[sum:successful_orders:qk]> ]]></run>
            <run fontalignment='0' fontname='Tableau Book'>while the total target is</run>
            <run bold='true' fontalignment='0'><![CDATA[ <[federated.17s9i4u1l5ew2x13fgegz16vfmlo].[sum:total_orders:qk]>]]></run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontname='Tableau Book'>The difference is because</run>
            <run fontalignment='0'>Æ </run>
            <run bold='true' fontalignment='0'>Insta Shop</run>
            <run fontalignment='0'>Æ </run>
            <run fontalignment='0' fontname='Tableau Book'>and</run>
            <run fontalignment='0'>Æ </run>
            <run bold='true' fontalignment='0'>Glovo</run>
            <run fontalignment='0'>Æ </run>
            <run fontalignment='0' fontname='Tableau Book'>are still not integrated in our DWH</run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run fontalignment='0' fontname='Tableau Book'>The Orders Target used in this report is </run>
            <run bold='true' fontalignment='0'><![CDATA[<[federated.17s9i4u1l5ew2x13fgegz16vfmlo].[sum:successful_orders:qk]>]]></run>
            <run fontalignment='0' fontname='Tableau Book'>, whereas the Lucanet Orders Target is </run>
            <run bold='true' fontalignment='0'><![CDATA[<[federated.17s9i4u1l5ew2x13fgegz16vfmlo].[sum:total_orders:qk]>]]></run>
            <run bold='true' fontalignment='0' fontname='Tableau Book'>.</run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run fontalignment='0' fontname='Tableau Book'>The difference of </run>
            <run bold='true' fontalignment='0'><![CDATA[<[federated.17s9i4u1l5ew2x13fgegz16vfmlo].[usr:Calculation_119275087727861760:qk]>]]></run>
            <run fontalignment='0' fontname='Tableau Book'> orders is due to Glovo (Peru, Ecuador, Costa Rica, Guatemala, Honduras), InstaShop (UAE, Egypt, Bahrain, Lebanon, Qatar), budgeted new launch markets (El Salvador) and any broken data identified in the email.</run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run fontalignment='0' fontname='Tableau Book'>Daily order data is not yet available for these entities in Central systems (DWH/Data Hub)</run>
            <run fontalignment='0'>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='custom sql query (dwh_bl)' name='federated.17s9i4u1l5ew2x13fgegz16vfmlo' />
          </datasources>
          <datasource-dependencies datasource='federated.17s9i4u1l5ew2x13fgegz16vfmlo'>
            <column caption='Difference' datatype='real' name='[Calculation_119275087727861760]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_orders]) - SUM([successful_orders])' />
            </column>
            <column caption='Difference BE' datatype='real' name='[Difference (copy)_4737435020360355840]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_orders]) - SUM([successful_orders_be])' />
            </column>
            <column caption='Acquisitions' datatype='real' name='[acquisitions]' role='measure' type='quantitative' />
            <column datatype='real' name='[acquisitions_be]' role='measure' type='quantitative' />
