            <customized-label>
              <formatted-text>
                <run fontalignment='0' fontcolor='#000000' fontname='Tableau Book' fontsize='8'>Orders Target</run>
                <run bold='false' fontalignment='0' fontcolor='#000000' fontname='Tableau Book' fontsize='8'> used in this report is </run>
