      <column caption='30 days last year' datatype='integer' name='[Calculation1 (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [report_date]&lt;=[Calculation_3840655741165600769] then [Order Succ Last 7 Days last year (copy)] else 0 end' />
      </column>
      <column caption='AOV' datatype='real' name='[Calculation_1683994467049533440]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gmv_eur] ) / SUM([ord_succ])' />
      </column>
      <column caption='GMV YoY Growth' datatype='real' name='[Calculation_1839298285487165440]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gmv_eur])/SUM([d_yoy_gmv_eur_ttl])-1' />
      </column>
      <column caption='New Daily GMV Budget  ' datatype='real' name='[Calculation_2264395827852136449]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Sum({fixed [Calculation_3916865044458033152], [segment], [data_status], [global_entity_id]: [Daily GMV Budget (copy)_2413929409241272320]})' />
      </column>
      <column caption='Order Succ Last 7 Days' datatype='integer' name='[Calculation_295830214181986304]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if DATEDIFF(&apos;day&apos;,[report_date],[Calculation_3840655741165600769])&lt;7 then [ord_succ] end' />
      </column>
      <column caption='7 days last year' datatype='integer' name='[Calculation_295830214210449409]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [report_date]&lt;=[Calculation_3840655741165600769] then [Order Succ Last 7 Days (copy 2)] else 0 end' />
      </column>
      <column caption='Orders Last 30d YoY' datatype='real' default-format='p0.0%' name='[Calculation_295830214211473410]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF sum([Order Succ Last 7 Days (copy)])/sum([Calculation1 (copy)])-1 &gt; 100 THEN NULL &#10;ELSE sum([Order Succ Last 7 Days (copy)])/sum([Calculation1 (copy)])-1 END' />
      </column>
      <column caption='YoY Orders' datatype='real' name='[Calculation_3236821506574270464]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM(IIF([report_date] = [Calculation_3840655741165600769], [ord_succ],0))&#10;/SUM(IIF([report_date] = [Calculation_3840655741165600769], [d_yoy_ord_succ_ttl], 0))-1 &gt; 100 THEN NULL &#10;ELSE SUM(IIF([report_date] = [Calculation_3840655741165600769], [ord_succ],0))&#10;/SUM(IIF([report_date] = [Calculation_3840655741165600769], [d_yoy_ord_succ_ttl], 0))-1 END' />
      </column>
      <column caption='Y GMV Eur w C2C' datatype='real' name='[Calculation_3712795741099884546]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[y_gmv_eur] + IFNULL([y_gmv_c2c_eur],0)' />
      </column>
      <column caption='Date with Actuals' datatype='date' name='[Calculation_3840655741164920832]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF ISNULL([ord]) THEN NULL ELSE [report_date] END' />
      </column>
      <column caption='MaxDate with Actuals' datatype='date' name='[Calculation_3840655741165600769]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED : MAX([Calculation_3840655741164920832])}' />
      </column>
      <column caption='MTD' datatype='boolean' name='[Calculation_3916865044458033152]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [report_date] &lt;= [Calculation_3840655741165600769]&#10;AND DATETRUNC(&quot;month&quot;, [report_date]) = DATETRUNC(&quot;month&quot;, [Calculation_3840655741165600769])&#10;THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='DoD orders' datatype='real' default-format='p0.0%' name='[Calculation_392376131947868161]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(Sum([y_ord_succ])/SUM([ypw_ord_succ]))-1' />
      </column>
      <column caption='DoD Acq' datatype='real' name='[Calculation_392376131950149634]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([y_acq])/sum([ypw_acq]))-1' />
      </column>
      <column caption='Monthly RR YoY Orders' datatype='real' default-format='p0.0%' name='[Calculation_392376131972837382]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF (sum([Calculation_3929461081970151433])/sum([current month orders (copy 3)]))-1 &gt; 100 THEN NULL &#10;ELSE (sum([Calculation_3929461081970151433])/sum([current month orders (copy 3)]))-1 END' />
      </column>
      <column caption='Y YoY Orders' datatype='integer' name='[Calculation_3929461081929383936]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([report_date] = [Calculation_3840655741165600769], [d_yoy_ord_succ_ttl], 0))' />
      </column>
      <column caption='YoY Acq Shapes' datatype='integer' name='[Calculation_3929461081933017089]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [YoY Orders (copy)] &lt; 0 then 0 else 1  end' />
      </column>
      <column caption='YoY Orders Shape w C2C' datatype='integer' name='[Calculation_3929461081933185026]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [YoY Orders (copy 3)_5977332299557203979]&lt;0 then 0 else 1 end' />
