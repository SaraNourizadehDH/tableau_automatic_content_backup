              <zone forceUpdate='true' h='48332' id='3' type-v2='text' w='49359' x='640' y='1667'>
                <formatted-text>
                  <run fontalignment='0' fontsize='8'>To automate this report, there is an in-built check for data quality. If data is not available due to problems with the market&apos;s systems, it will be flagged in a table to the right of this text. </run>
                  <run fontalignment='0'>Æ&#10;&#10;</run>
                  <run fontalignment='0' fontsize='8'>The broken market will also be removed from the main daily report table below so as to give us good WoW numbers at a global level.</run>
                  <run fontalignment='0'>Æ&#10;&#10;</run>
                  <run fontalignment='0' fontsize='8'>If </run>
                  <run bold='true' fontalignment='0' fontsize='8'>Target Values</run>
                  <run fontalignment='0' fontsize='8'> have been updated since the prior report, the field on the top right will indicate that, otherwise it will be B</run>
                  <run bold='true' fontalignment='0' fontsize='8'>lank</run>
                  <run fontalignment='0'>Æ&#10;</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
            </zone>
          </zone>
          <zone h='48334' id='8' name='Sheet 54' show-title='false' w='98720' x='640' y='49999'>
