                <run bold='false' fontalignment='0' fontcolor='#000000' fontname='Tableau Book' fontsize='8'>and</run>
                <run fontalignment='0' fontcolor='#000000' fontname='Tableau Book' fontsize='8'>Æ </run>
                <run bold='false' fontalignment='0' fontcolor='#000000' fontname='Tableau Book' fontsize='8'>GMV is</run>
                <run fontalignment='0' fontcolor='#000000' fontname='Tableau Book' fontsize='8'><![CDATA[ <[federated.17s9i4u1l5ew2x13fgegz16vfmlo].[sum:total_gmv:qk]>.]]></run>
                <run fontalignment='0'>Æ&#10;&#10;</run>
                <run bold='false' fontalignment='0' fontcolor='#000000' fontname='Tableau Book' fontsize='8'>The difference</run>
                <run fontalignment='0' fontcolor='#000000' fontname='Tableau Book' fontsize='8'>Æ </run>
                <run bold='false' fontalignment='0' fontcolor='#000000' fontname='Tableau Book' fontsize='8'>in</run>
                <run fontalignment='0' fontcolor='#000000' fontname='Tableau Book' fontsize='8'>Æ </run>
                <run bold='false' fontalignment='0' fontcolor='#000000' fontname='Tableau Book' fontsize='8'>orders compared to Targets and Best Estimates is due to Tabsquare (SG), Instashop (SA) and any broken data identified in the email. </run>
                <run fontalignment='0'>Æ&#10;</run>
                <run bold='false' fontalignment='0' fontcolor='#000000' fontname='Tableau Book' fontsize='8'>Daily order data is not available for these entities in Central systems (DWH/Data Hub).</run>
                <run fontalignment='0'>Æ&#10;&#10;&#10;&#10;</run>
                <run bold='false' fontalignment='0' fontcolor='#000000' fontname='Tableau Book' fontsize='8'>Woowa KR daily orders and runrates include Click-to-Call (C2C) orders and GMV. C2C Acquisitions are not available.</run>
                <run fontalignment='0'>Æ&#10;</run>
              </formatted-text>
            </customized-label>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
