        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0s9d82v05gcoom17j1vkl1wlin2t' name='Custom SQL Query' type='text'>WITH target_check AS 
(
SELECT
            CURRENT_DATE as insert_date,
            bud.target_month as budget_month,
            sum(bud.successful_orders) as ord_succ
FROM `fulfillment-dwh-production.curated_data_shared_intl_markets.lucanet_targets` bud
WHERE bud.target_month = DATE_TRUNC(CURRENT_DATE-1,MONTH)
GROUP BY 1,2
)
SELECT 
a.insert_date,
a.budget_month,
a.ord_succ,
CASE WHEN (a.ord_succ - b.ord_succ) = 0 THEN &apos;didnt change&apos; ELSE &apos;changed&apos; END AS data_check 
FROM target_check a 
LEFT JOIN target_check b ON 
a.insert_date = b.insert_date + 1 AND a.budget_month = b.budget_month</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0s9d82v05gcoom17j1vkl1wlin2t' name='Custom SQL Query' type='text'>WITH target_check AS 
