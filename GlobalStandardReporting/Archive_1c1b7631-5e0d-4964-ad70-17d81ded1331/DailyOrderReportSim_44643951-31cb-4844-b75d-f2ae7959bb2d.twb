            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='tabsquare-data-4857' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='cl_intl_markets' server-oauth='' username='radu.maftei@deliveryhero.com' workgroup-auth-mode='prompt' />
