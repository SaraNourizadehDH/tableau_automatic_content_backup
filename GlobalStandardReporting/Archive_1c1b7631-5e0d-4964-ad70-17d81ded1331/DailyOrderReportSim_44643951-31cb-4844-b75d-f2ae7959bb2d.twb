      <column caption='Difference' datatype='real' name='[Calculation_119275087727861760]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_orders]) - SUM([successful_orders])' />
      </column>
      <column caption='Difference GMV' datatype='real' name='[Calculation_2073203965096898560]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_gmv]) - SUM([amt_gmv_eur])' />
