              <calculation class='tableau' formula='{FIXED : MAX([Calculation_3840655741164920832])}' />
            </column>
            <column caption='GMV Eur w C2C' datatype='real' name='[Calculation_5977332299559321620]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[gmv_eur] + IFNULL([gmv_c2c_eur],0)' />
            </column>
            <column caption='Ord Succ w C2C' datatype='integer' name='[Calculation_5977332299559747607]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[ord_succ] + IFNULL([c2c_orders],0)' />
            </column>
            <column caption='Successful Orders YoY Growth' datatype='real' name='[Calculation_927952675063754755]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ord_succ])/SUM([d_yoy_ord_succ_ttl])-1' />
            </column>
            <column caption='L8D' datatype='string' name='[Calculation_927952675416662028]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [report_date] &gt; DATEADD(&quot;day&quot;,-8,[Calculation_3840655741165600769]) AND [report_date] &lt;= [Calculation_3840655741165600769] &#10;THEN &quot;l8d&quot;&#10;END' />
            </column>
            <column caption='GMV YoY Growth w C2C' datatype='real' name='[GMV YoY Growth (copy)_5977332299559505941]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_eur]+IFNULL([gmv_c2c_eur],0))/SUM([d_yoy_gmv_eur_ttl]+IFNULL([d_yoy_gmv_c2c_eur_ttl],0))-1' />
            </column>
