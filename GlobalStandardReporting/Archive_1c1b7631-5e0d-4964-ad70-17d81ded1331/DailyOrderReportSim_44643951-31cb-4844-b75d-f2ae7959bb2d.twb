        <view>
          <datasources>
            <datasource caption='tableau_global_kpi_report_n (bi_global_dev.tableau_global_kpi_report_n) (bi_global_dev)' name='federated.15oo0u10yuvszn1d571yk0jwb6he' />
          </datasources>
          <datasource-dependencies datasource='federated.15oo0u10yuvszn1d571yk0jwb6he'>
            <column caption='30 days last year w C2C' datatype='integer' name='[30 days last year (copy)_5977332299558019086]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [report_date]&lt;=[Calculation_3840655741165600769] then [Order Succ Last 30 Days last year (copy)_5977332299558080527] else 0 end' />
            </column>
            <column caption='Y GMV Eur w C2C' datatype='real' name='[Calculation_3712795741099884546]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[y_gmv_eur] + IFNULL([y_gmv_c2c_eur],0)' />
            </column>
            <column caption='Date with Actuals' datatype='date' name='[Calculation_3840655741164920832]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF ISNULL([ord]) THEN NULL ELSE [report_date] END' />
            </column>
            <column caption='MaxDate with Actuals' datatype='date' name='[Calculation_3840655741165600769]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED : MAX([Calculation_3840655741164920832])}' />
            </column>
            <column caption='DoD Acq' datatype='real' name='[Calculation_392376131950149634]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([y_acq])/sum([ypw_acq]))-1' />
            </column>
            <column caption='Ypw GMV Eur w C2C' datatype='real' name='[Calculation_5977332299554992128]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[ypw_gmv_eur] + IFNULL([ypw_gmv_c2c_eur],0)' />
            </column>
            <column caption='Y Ord Succ w C2C' datatype='integer' name='[Calculation_5977332299556655111]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[y_ord_succ] + IFNULL([y_c2c_orders],0)' />
            </column>
            <column caption='Ypw Ord Succ w C2C' datatype='integer' name='[Calculation_5977332299557031946]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[ypw_ord_succ] + IFNULL([ypw_c2c_orders],0)' />
            </column>
            <column caption='DoD GMV w C2C' datatype='real' default-format='p0.0%' name='[DoD GMV (copy)_5977332299555266561]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([Calculation_3712795741099884546])/sum(IFNULL([Calculation_5977332299554992128],0)))-1' />
            </column>
            <column caption='DoD orders w C2C' datatype='real' default-format='p0.0%' name='[DoD orders (copy)_5977332299556921352]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(Sum([Calculation_5977332299556655111])/SUM(IFNULL([Calculation_5977332299557031946],0)))-1' />
            </column>
            <column caption='Monthly RR YoY GMV w C2C' datatype='real' default-format='p0.0%' name='[Monthly RR YoY GMV (copy)_5977332299556028420]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF (sum([current month GMV (copy)_5977332299555852291])/sum([current month gmv yoy (copy)_5977332299556155397]))-1 &gt; 100 THEN NULL &#10;ELSE (sum([current month GMV (copy)_5977332299555852291])/sum([current month gmv yoy (copy)_5977332299556155397]))-1 END' />
            </column>
            <column caption='Monthly RR YoY Orders w C2C' datatype='real' default-format='p0.0%' name='[Monthly RR YoY Orders (copy 2)_5977332299558555665]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF (sum([current month orders (copy 5)_5977332299558379536])/sum([current month orders yoy (copy 2)_5977332299558641682]))-1 &gt; 100 THEN NULL &#10;ELSE (sum([current month orders (copy 5)_5977332299558379536])/sum([current month orders yoy (copy 2)_5977332299558641682]))-1 END' />
            </column>
            <column caption='Order Succ Last 30 Days w C2C' datatype='integer' name='[Order Succ Last 30 Days (copy)_5977332299557781517]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if DATEDIFF(&apos;day&apos;,[report_date],[Calculation_3840655741165600769])&lt;30 then [ord_succ]+IFNULL([c2c_orders],0) end' />
            </column>
            <column caption='Order Succ Last 30 Days last year w C2C' datatype='integer' name='[Order Succ Last 30 Days last year (copy)_5977332299558080527]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if DATEDIFF(&apos;day&apos;,[report_date],[Calculation_3840655741165600769])&lt;30 then [d_yoy_ord_succ_ttl]+IFNULL([d_yoy_c2c_orders_ttl],0) end' />
            </column>
            <column caption='Orders Last 30d YoY w C2C' datatype='real' default-format='p0.0%' name='[Orders Last 30d YoY (copy)_5977332299557613580]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF sum([Order Succ Last 30 Days (copy)_5977332299557781517])/sum([30 days last year (copy)_5977332299558019086])-1 &gt; 100 THEN NULL &#10;ELSE sum([Order Succ Last 30 Days (copy)_5977332299557781517])/sum([30 days last year (copy)_5977332299558019086])-1 END' />
            </column>
            <column caption='RR GMV vs Budget w C2C' datatype='real' name='[RR GMV vs Budget (copy)_5977332299556376582]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([current month GMV (copy)_5977332299555852291])/SUM([current month bud orders (copy 2)]))-1' />
            </column>
            <column caption='RR_YoY Acq' datatype='real' default-format='p0.0%' name='[RR_YoY orders (Kopie)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([current month orders (copy)])/sum([current month acq (copy)]))-1' />
            </column>
            <column caption='RR_acq vs budget' datatype='real' name='[RR_ord vs budget (Kopie 2)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([current month orders (copy)])/SUM([current month bud orders (copy)]))-1' />
            </column>
            <column caption='RR_ord vs budget w C2C' datatype='real' name='[RR_ord vs budget (copy 3)_5977332299558883347]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([current month orders (copy 5)_5977332299558379536])/SUM([current month orders (copy 2)]))-1' />
            </column>
            <column caption='Segment (For Filter)' datatype='string' name='[Segment (copy)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[segment]' />
            </column>
            <column caption='YoY GMV w C2c' datatype='real' default-format='p0.0%' name='[YoY GMV (copy)_5977332299555569666]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM(IIF([report_date] = [Calculation_3840655741165600769], [gmv_eur]+IFNULL([gmv_c2c_eur],0),0))&#10;/SUM(IIF([report_date] = [Calculation_3840655741165600769], [d_yoy_gmv_eur_ttl]+IFNULL([d_yoy_gmv_c2c_eur_ttl],0), 0))-1 &gt; 100 THEN NULL &#10;ELSE SUM(IIF([report_date] = [Calculation_3840655741165600769], [gmv_eur]+IFNULL([gmv_c2c_eur],0),0))&#10;/SUM(IIF([report_date] = [Calculation_3840655741165600769], [d_yoy_gmv_eur_ttl]+IFNULL([d_yoy_gmv_c2c_eur_ttl],0), 0))-1 END' />
            </column>
            <column caption='YoY Orders w C2C' datatype='real' name='[YoY Orders (copy 3)_5977332299557203979]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM(IIF([report_date] = [Calculation_3840655741165600769], [ord_succ]+IFNULL([c2c_orders],0),0))&#10;/SUM(IIF([report_date] = [Calculation_3840655741165600769], [d_yoy_ord_succ_ttl]+IFNULL([d_yoy_c2c_orders_ttl],0), 0))-1 &gt; 100 THEN NULL &#10;ELSE SUM(IIF([report_date] = [Calculation_3840655741165600769], [ord_succ]+IFNULL([c2c_orders],0),0))&#10;/SUM(IIF([report_date] = [Calculation_3840655741165600769], [d_yoy_ord_succ_ttl]+IFNULL([d_yoy_c2c_orders_ttl],0), 0))-1 END' />
            </column>
            <column caption='YoY Acq' datatype='real' name='[YoY Orders (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM(IIF([report_date] = [Calculation_3840655741165600769], [acq],0))&#10;/SUM(IIF([report_date] = [Calculation_3840655741165600769], [d_yoy_acq_ttl], 0))-1 &gt; 100 THEN NULL&#10;ELSE SUM(IIF([report_date] = [Calculation_3840655741165600769], [acq],0))&#10;/SUM(IIF([report_date] = [Calculation_3840655741165600769], [d_yoy_acq_ttl], 0))-1&#10;END' />
            </column>
