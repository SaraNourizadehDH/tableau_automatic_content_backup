      </column>
      <column caption='Text' datatype='string' name='[Calculation_6615999025081847808]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&apos;The Orders Target used in this report is:&apos; +&quot; &quot;+ STR(SUM([successful_orders]))+&quot; &quot;+&apos;while the total target is:&apos;+&quot; &quot;+STR(SUM([total_orders]))+&quot;.&quot;+&quot; &quot;+&#10;&#10;&apos;The difference is because Insta Shop and Glovo are still not integrated in our DWH&apos;' />
      </column>
      <column caption='Calculation1' datatype='boolean' name='[Calculation_6633520842392707072]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[budget_month]) = DATETRUNC(&apos;month&apos;,today()-1)' />
      </column>
      <column caption='Calculation2' datatype='date' name='[Calculation_6633520842393030657]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='today()-1' />
      </column>
      <column caption='Difference BE' datatype='real' name='[Difference (copy)_4737435020360355840]' role='measure' type='quantitative'>
