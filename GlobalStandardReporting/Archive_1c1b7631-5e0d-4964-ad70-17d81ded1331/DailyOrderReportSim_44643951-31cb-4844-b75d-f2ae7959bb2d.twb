    <worksheet name='America WS'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='0' fontsize='14'>America</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_global_kpi_report_n (bi_global_dev.tableau_global_kpi_report_n) (bi_global_dev)' name='federated.15oo0u10yuvszn1d571yk0jwb6he' />
          </datasources>
          <datasource-dependencies datasource='federated.15oo0u10yuvszn1d571yk0jwb6he'>
            <column caption='30 days last year' datatype='integer' name='[Calculation1 (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [report_date]&lt;=[Calculation_3840655741165600769] then [Order Succ Last 7 Days last year (copy)] else 0 end' />
            </column>
            <column caption='Orders Last 30d YoY' datatype='real' default-format='p0.0%' name='[Calculation_295830214211473410]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF sum([Order Succ Last 7 Days (copy)])/sum([Calculation1 (copy)])-1 &gt; 100 THEN NULL &#10;ELSE sum([Order Succ Last 7 Days (copy)])/sum([Calculation1 (copy)])-1 END' />
            </column>
            <column caption='YoY Orders' datatype='real' name='[Calculation_3236821506574270464]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM(IIF([report_date] = [Calculation_3840655741165600769], [ord_succ],0))&#10;/SUM(IIF([report_date] = [Calculation_3840655741165600769], [d_yoy_ord_succ_ttl], 0))-1 &gt; 100 THEN NULL &#10;ELSE SUM(IIF([report_date] = [Calculation_3840655741165600769], [ord_succ],0))&#10;/SUM(IIF([report_date] = [Calculation_3840655741165600769], [d_yoy_ord_succ_ttl], 0))-1 END' />
            </column>
            <column caption='Date with Actuals' datatype='date' name='[Calculation_3840655741164920832]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF ISNULL([ord]) THEN NULL ELSE [report_date] END' />
            </column>
            <column caption='MaxDate with Actuals' datatype='date' name='[Calculation_3840655741165600769]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED : MAX([Calculation_3840655741164920832])}' />
            </column>
            <column caption='DoD orders' datatype='real' default-format='p0.0%' name='[Calculation_392376131947868161]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(Sum([y_ord_succ])/SUM([ypw_ord_succ]))-1' />
            </column>
            <column caption='DoD Acq' datatype='real' name='[Calculation_392376131950149634]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([y_acq])/sum([ypw_acq]))-1' />
            </column>
            <column caption='Monthly RR YoY Orders' datatype='real' default-format='p0.0%' name='[Calculation_392376131972837382]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF (sum([Calculation_3929461081970151433])/sum([current month orders (copy 3)]))-1 &gt; 100 THEN NULL &#10;ELSE (sum([Calculation_3929461081970151433])/sum([current month orders (copy 3)]))-1 END' />
            </column>
            <column caption='current month orders' datatype='real' name='[Calculation_3929461081970151433]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if DATETRUNC(&apos;month&apos;,[report_date]) = DATETRUNC(&apos;month&apos;,[Calculation_3840655741165600769]) then [rr_ord_succ] end' />
            </column>
            <column caption='DoD GMV' datatype='real' default-format='p0.0%' name='[DoD Acq (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([y_gmv_eur])/sum([ypw_gmv_eur]))-1' />
            </column>
            <column caption='Monthly RR YoY GMV' datatype='real' default-format='p0.0%' name='[Monthly RR YoY Orders (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF (sum([current month orders (copy 4)])/sum([current month orders yoy (copy)]))-1 &gt; 100 THEN NULL &#10;ELSE (sum([current month orders (copy 4)])/sum([current month orders yoy (copy)]))-1 END' />
            </column>
            <column caption='Order Succ Last 30 Days' datatype='integer' name='[Order Succ Last 7 Days (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if DATEDIFF(&apos;day&apos;,[report_date],[Calculation_3840655741165600769])&lt;30 then [ord_succ] end' />
            </column>
            <column caption='Order Succ Last 30 Days last year' datatype='integer' name='[Order Succ Last 7 Days last year (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if DATEDIFF(&apos;day&apos;,[report_date],[Calculation_3840655741165600769])&lt;30 then [d_yoy_ord_succ_ttl] end' />
            </column>
            <column caption='RR_YoY Acq' datatype='real' default-format='p0.0%' name='[RR_YoY orders (Kopie)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([current month orders (copy)])/sum([current month acq (copy)]))-1' />
            </column>
            <column caption='RR_acq vs budget' datatype='real' name='[RR_ord vs budget (Kopie 2)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([current month orders (copy)])/SUM([current month bud orders (copy)]))-1' />
            </column>
            <column caption='RR_ord vs budget' datatype='real' name='[RR_ord vs budget (Kopie)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_3929461081970151433])/SUM([current month orders (copy 2)]))-1' />
            </column>
            <column caption='RR GMV vs Budget' datatype='real' name='[RR_ord vs budget (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([current month orders (copy 4)])/SUM([current month bud orders (copy 2)]))-1' />
            </column>
            <column caption='Segment (For Filter)' datatype='string' name='[Segment (copy)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[segment]' />
            </column>
            <column caption='YoY GMV' datatype='real' default-format='p0.0%' name='[YoY Orders (copy 2)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM(IIF([report_date] = [Calculation_3840655741165600769], [gmv_eur],0))&#10;/SUM(IIF([report_date] = [Calculation_3840655741165600769], [d_yoy_gmv_eur_ttl], 0))-1 &gt; 100 THEN NULL ELSE SUM(IIF([report_date] = [Calculation_3840655741165600769], [gmv_eur],0))&#10;/SUM(IIF([report_date] = [Calculation_3840655741165600769], [d_yoy_gmv_eur_ttl], 0))-1 END' />
            </column>
            <column caption='YoY Acq' datatype='real' name='[YoY Orders (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM(IIF([report_date] = [Calculation_3840655741165600769], [acq],0))&#10;/SUM(IIF([report_date] = [Calculation_3840655741165600769], [d_yoy_acq_ttl], 0))-1 &gt; 100 THEN NULL&#10;ELSE SUM(IIF([report_date] = [Calculation_3840655741165600769], [acq],0))&#10;/SUM(IIF([report_date] = [Calculation_3840655741165600769], [d_yoy_acq_ttl], 0))-1&#10;END' />
            </column>
            <column caption='Acq' datatype='integer' name='[acq]' role='measure' type='quantitative' />
