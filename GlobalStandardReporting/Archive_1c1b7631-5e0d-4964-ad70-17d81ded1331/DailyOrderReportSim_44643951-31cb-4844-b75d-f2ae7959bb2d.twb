                <run bold='false' fontalignment='0' fontcolor='#000000' fontname='Tableau Book' fontsize='8'>and</run>
                <run fontalignment='0' fontcolor='#000000' fontname='Tableau Book' fontsize='8'>Æ </run>
                <run bold='false' fontalignment='0' fontcolor='#000000' fontname='Tableau Book' fontsize='8'>GMV is </run>
                <run fontalignment='0' fontcolor='#000000' fontname='Tableau Book' fontsize='8'><![CDATA[ <[federated.17s9i4u1l5ew2x13fgegz16vfmlo].[sum:amt_gmv_eur:qk]> ]]></run>
                <run fontalignment='0'>Æ&#10;</run>
                <run fontalignment='0' fontcolor='#000000' fontname='Tableau Book' fontsize='8'><![CDATA[<[federated.17s9i4u1l5ew2x13fgegz16vfmlo].[none:be_version:nk]> ]]></run>
                <run bold='false' fontalignment='0' fontcolor='#000000' fontname='Tableau Book' fontsize='8'> comparable expected orders are </run>
                <run fontalignment='0' fontcolor='#000000' fontname='Tableau Book' fontsize='8'><![CDATA[<[federated.17s9i4u1l5ew2x13fgegz16vfmlo].[sum:successful_orders_be:qk]> ]]></run>
