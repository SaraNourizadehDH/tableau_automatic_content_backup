                <run bold='false' fontalignment='0' fontcolor='#000000' fontname='Tableau Book' fontsize='8'>GMV is</run>
                <run fontalignment='0' fontcolor='#000000' fontname='Tableau Book' fontsize='8'><![CDATA[ <[federated.17s9i4u1l5ew2x13fgegz16vfmlo].[sum:amt_gmv_eur_be:qk]>]]></run>
                <run bold='false' fontalignment='0' fontcolor='#000000' fontname='Tableau Book' fontsize='8'>.</run>
                <run fontalignment='0'>Æ&#10;&#10;</run>
                <run bold='false' fontalignment='0' fontcolor='#000000' fontname='Tableau Book' fontsize='8'>Lucanet platform orders target is </run>
