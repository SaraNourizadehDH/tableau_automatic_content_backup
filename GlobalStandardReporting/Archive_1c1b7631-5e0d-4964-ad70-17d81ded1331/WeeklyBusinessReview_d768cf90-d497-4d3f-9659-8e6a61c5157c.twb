            </column>
            <column caption='Orders RR YoY ' datatype='real' default-format='n#,##0.0&quot;%&quot;;-#,##0.0&quot;%&quot;' name='[GMV RR YoY (%) (copy)_3956834546270752774]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([mon_orders_rr]) / SUM([mon_orders_rr_yoy]) - 1' />
            </column>
            <column caption='RR Acq YoY' datatype='real' name='[RR Ord YoY (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([mon_acquisitions_rr]) / sum([mon_acquisitions_rr_yoy]) -1' />
