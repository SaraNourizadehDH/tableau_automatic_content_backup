            <column caption='Pickup AFV % DH Incentives WoW' datatype='real' default-format='p0.0%' name='[Pickup AFV % DH Incentives (copy)_1588222571807571981]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IFNULL(SUM([pickup_voucher_dh_eur_wow]),0) + IFNULL(SUM([pickup_discount_dh_eur_wow]),0)) / (IFNULL(SUM([pickup_gmv_eur_wow]),0) + IFNULL(SUM([pickup_voucher_dh_eur_wow]),0) + IFNULL(SUM([pickup_discount_dh_eur_wow]),0) + IFNULL(SUM([pickup_joker_fee_eur_wow]),0))' />
