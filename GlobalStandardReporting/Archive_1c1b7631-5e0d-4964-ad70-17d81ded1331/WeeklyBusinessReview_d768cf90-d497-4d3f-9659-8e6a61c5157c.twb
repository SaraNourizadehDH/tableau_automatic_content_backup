      </column>
      <column caption='Target Achieved RR 2 Weeks ago' datatype='real' name='[Target Achieved RR LW (copy)_3360318685468614661]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IFNULL([restaurants_new_online_mp_rr_2w],0)) + SUM(IFNULL([restaurants_new_online_od_rr_2w],0)))&#10;/ (SUM(IFNULL([restaurants_new_online_target_mp],0)) + SUM(IFNULL([restaurants_new_online_target_od],0)))' />
