      </column>
      <column caption='Multiplier LW' datatype='real' hidden='true' name='[Calculation_3564247273925267501]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IFNULL(total_cltv_wow,0)) / SUM(IFNULL(cltv_acquisitions_wow,0)))&#10;    / (SUM(IFNULL(marketing_costs_eur_monthly_wow,0)) / SUM(IFNULL(acquisitions_marketing_wow,0)))' />
      </column>
      <column caption='Multiplier WoW' datatype='real' hidden='true' name='[Calculation_3564247273925566510]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3564247273924599850] - [Calculation_3564247273925267501]' />
      </column>
      <column caption='Multiplier WoW Trend' datatype='string' hidden='true' name='[Calculation_3564247273925701679]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_3564247273925566510] &lt; 0 THEN &apos;Negative&apos; &#10;ELSEIF ISNULL([Calculation_3564247273925566510]) THEN &apos;No Data&apos; &#10;ELSE &apos;Positive&apos; END' />
      </column>
      <column caption='AO NPS M' datatype='real' name='[Calculation_3564247273927356467]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(nps_ao_promoters_m) - SUM(nps_ao_detractors_m))/ &#10;SUM(IFNULL(nps_ao_responses_m,0))' />
      </column>
      <column caption='Mon Orders Rr Color' datatype='string' hidden='true' name='[Calculation_3564247273955979318]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [mon_orders_rr] &lt; 0 THEN &apos;Negative&apos; ELSE &apos;Positive&apos; END' />
      </column>
      <column caption='RR Ord vs Bud Color' datatype='string' name='[Calculation_3564247273956843575]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_4348225507495657475] &lt; 0 THEN &apos;Negative&apos; ELSE &apos;Positive&apos; END' />
      </column>
      <column caption='GMV vs BDG Color' datatype='string' name='[Calculation_3564247273960357944]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_3564247273898360855] &lt; 0 THEN &apos;Negative&apos; ELSE &apos;Positive&apos; END' />
      </column>
      <column caption='RR GMV vs Budget Color' datatype='string' name='[Calculation_3564247273965969466]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_3564247273921159207] &lt; 0 THEN &apos;Negative&apos; ELSE &apos;Positive&apos; END' />
      </column>
      <column caption='RR Acq vs Bud Color' datatype='string' name='[Calculation_3564247273966391355]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [RR Ord vs Bud (copy)] &lt; 0 THEN &apos;Negative&apos; ELSE &apos;Positive&apos; END' />
      </column>
      <column caption='RR Acq YoY Color' datatype='string' name='[Calculation_3564247273966911548]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [RR Ord YoY (copy)] &lt; 0 THEN &apos;Negative&apos; ELSE &apos;Positive&apos; END' />
      </column>
      <column caption='Acquisitions M-1 YoY Color' datatype='string' hidden='true' name='[Calculation_3564247273967333437]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_3564247273921859624] &lt; 0 THEN &apos;Negative&apos; ELSE &apos;Positive&apos; END' />
      </column>
      <column caption='RR Acq vs Bud (Diff) Color' datatype='string' name='[Calculation_3564247273982734398]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [RR Acq vs Bud (copy)] &lt; 0 THEN &apos;Negative&apos; ELSE &apos;Positive&apos; END' />
      </column>
      <column caption='Rests Below Comm Floor OD' datatype='real' name='[Calculation_3564247274287812671]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(rest_below_comm_floor_od_sf)/(IFNULL(SUM(mon_newly_signed_restaurants_od_sf),0))' />
      </column>
      <column caption='OD Commission Lucanet' datatype='real' name='[Calculation_3564247274296606788]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(lucanet_comm_od_eur) / SUM(IFNULL(lucanet_gfv_od_eur,0))' />
      </column>
      <column caption='Delta vs Bdg Lucanet Commission OD' datatype='real' name='[Calculation_3564247274308186183]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((SUM(lucanet_comm_od_eur)/ SUM(IFNULL(lucanet_gfv_od_eur,0))) )&#10;     - (((IFNULL(SUM([amt_commission_od_eur_bud_m]),0)) / IFNULL(SUM([amt_gfv_od_eur_bud_m]),0)))' />
      </column>
      <column caption='Uplift Month OD Color' datatype='string' name='[Calculation_3564247274311733322]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [mon_uplift_month_vs_plan_od_percent] &lt; 0 THEN &apos;Negative&apos; ELSE &apos;Positive&apos; END' />
      </column>
      <column caption='Delta vs BDG Lucanet OD Comm Color' datatype='string' name='[Calculation_3564247274313424972]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Delta vs Bdg Lucanet Commission OD  LM (copy)_210895140343873541] &lt; 0 THEN &apos;Negative&apos;&#10;ELSEIF ISNULL([Delta vs Bdg Lucanet Commission OD  LM (copy)_210895140343873541]) THEN &apos;No Data&apos;&#10;ELSE &apos;Positive&apos; END' />
      </column>
      <column caption='AFV 28d' datatype='real' name='[Calculation_3564247274318778450]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(amt_cv_eur_mp_28_d) + IFNULL(SUM(amt_cv_eur_od_28_d),0))/SUM(IFNULL(orders_succ_28_d,0))' />
      </column>
      <column caption='AFV' datatype='real' name='[Calculation_3564247274319016019]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(cv_eur_mp) + IFNULL(SUM(cv_eur_od),0)) / IFNULL(SUM([orders_succ]), 0)' />
      </column>
      <column caption='AFV BDG' datatype='real' name='[Calculation_3564247274319413334]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(IFNULL(SUM(mon_gfv_mp_eur_bud),0) + IFNULL(SUM(mon_gfv_od_eur_bud),0)) / IFNULL(SUM([mon_orders_bud]),0)' />
      </column>
      <column caption='Avg. Delivery Fee' datatype='real' name='[Calculation_3564247274321154137]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([delivery_fee_eur_sum]) / SUM([delivery_fee_eur_count])' />
      </column>
      <column caption='Customer Contact Rate ' datatype='real' default-format='p0.0%' name='[Calculation_3564247274324164698]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='( &#10;    IFNULL(SUM([inbound_emails_customers_weekly]),0)&#10;    + IFNULL(SUM([offered_calls_customers_weekly]),0) &#10;    + IFNULL(SUM([offered_chats_customers_weekly]),0)&#10;) &#10;/ SUM(IFNULL([orders_total_weekly],0))' />
      </column>
      <column caption='Contact Cost' datatype='real' name='[Calculation_3564247274324492379]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL(lucanet_support_function_cc_eur,0)) + SUM(IFNULL(lucanet_dispatching_costs_eur,0))&#10;    + SUM(IFNULL(lucanet_restaurants_services_eur,0)) + SUM(IFNULL(lucanet_customer_service_eur,0))' />
      </column>
      <column caption='Restaurants Online Total' datatype='integer' name='[Calculation_3564247274579148895]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(restaurants_online_mp) + SUM(restaurants_online_od)' />
      </column>
      <column caption='Restaurants Online YoY (%)' datatype='real' name='[Calculation_3564247274579640416]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(restaurants_online) / SUM(IFNULL(restaurants_online_yoy, 0)) - 1' />
      </column>
      <column caption='Restaurants OD WoW (%) pp' datatype='real' name='[Calculation_3564247274581200997]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([restaurants_online_od]) / [Calculation_3564247274579148895]) &#10;- (SUM([restaurants_online_od_wow]) / [Restaurants Online Total (copy)_3564247274582143078])' />
      </column>
      <column caption='Restaurants Online % &lt;7 Orders' datatype='real' name='[Calculation_3564247274595037299]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(restaurants_online_od_less_7_orders) + SUM(restaurants_online_mp_less_7_orders))&#10; / (IFNULL(SUM([restaurants_online_mp]) + SUM([restaurants_online_od]),0))' />
      </column>
      <column caption='Restaurants Online % &lt;7 Orders WoW (%) pp Food' datatype='real' name='[Calculation_3564247274595790965]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Restaurants Online % &lt;7 Orders (copy)_35114010587897867] - [Restaurants Online % &lt;7 Orders WoW (copy)_35114010588352524]' />
      </column>
      <column caption='Restaurants Online % &lt;7 Orders WoW (%) pp Trend Food' datatype='string' name='[Calculation_3564247274596229240]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_3564247274595790965] &lt; 0 THEN &apos;Decreased&apos; ELSE &apos;Increased&apos; END' />
      </column>
      <column caption='Restaurants Online OD Share ' datatype='real' name='[Calculation_3564247274598215806]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([restaurants_online_od]) / [Calculation_3564247274579148895]' />
      </column>
      <column caption='Orders / Restaurant' datatype='real' name='[Calculation_3564247274605162635]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(orders_succ) / IFNULL(SUM(restaurants_online_mp) + SUM(restaurants_online_od),0)' />
      </column>
      <column caption='Orders / Restaurant Trend WoW' datatype='string' name='[Calculation_3564247274607120527]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Orders / Restaurant (copy)_3564247274606477454] &lt; 0 THEN &apos;Decreased&apos; ELSE &apos;Increased&apos; END' />
      </column>
      <column caption='Restaurants Signed MTD' datatype='integer' name='[Calculation_3564247274608636048]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IFNULL([restaurants_new_online_mp_mtd],0)) + sum(IFNULL([restaurants_new_online_od_mtd],0))' />
      </column>
      <column caption='Reorder Rate W1' datatype='real' name='[Calculation_3582050600510779392]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([customers_1week])/SUM([customers_0week])' />
      </column>
      <column caption='Orders Week/Active Customer' datatype='real' name='[Calculation_3582050600511848449]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_1week]) / SUM([customers_1week])' />
      </column>
      <column caption='Reorder Rate M1' datatype='real' default-format='p0.00%' name='[Calculation_3582050600512593922]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([users_1m]) / SUM([acquisitions_1m])&#10;&#10;//Acquisitions means total number of acq since initial month' />
      </column>
      <column caption='Orders/Month/Active Cust m1' datatype='real' name='[Calculation_3582050600513355779]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_1m])/SUM([users_1m])' />
      </column>
      <column caption='Reorder Rate M6' datatype='real' default-format='p0.0%' name='[Calculation_3582050600514142212]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([users_6m])/SUM([acquisitions_6m])' />
      </column>
      <column caption='SLAOverall' datatype='real' name='[Calculation_3909546756162965508]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;SUM([answered_calls_within30sec_weekly])&#10;+SUM ([answered_chats_within30sec_weekly]) &#10;+ SUM([answered_emails_in8hrs_weekly])&#10;) &#10;/&#10;(&#10;SUM([offered_chats_weekly])+&#10;SUM ([offered_calls_weekly])+&#10;SUM([inbound_emails_weekly])&#10;) * 100' />
      </column>
      <column caption='SLAOverall_Corrected' datatype='real' name='[Calculation_3909546756194115591]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Calculation_3909546756162965508]&#10;WHEN 0 THEN NULL&#10;ELSE [Calculation_3909546756162965508]&#10;END' />
      </column>
      <column caption='Group' datatype='string' name='[Calculation_3956834545939652608]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [segment] = &apos;Asia&apos; AND [management_entity] = &apos;Woowa&apos; THEN &apos;Woowa&apos;&#10;ELSEIF [segment] = &apos;Asia&apos; AND [management_entity] &lt;&gt; &apos;Woowa&apos;  THEN &apos;APAC&apos;&#10;ELSEIF [segment] = &apos;America&apos;   THEN &apos;LATAM&apos;&#10; ELSE [segment] END' />
      </column>
      <column caption='OD %' datatype='real' default-format='p0%' name='[Calculation_4029525406734790656]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([orders_own_delivery])/sum([orders_succ])' />
      </column>
      <column caption='UTR 2' datatype='real' name='[Calculation_4029525406740946945]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([orders_delivered])/sum([rider_hours])' />
      </column>
      <column caption='AVG DT' datatype='real' name='[Calculation_4029525406744764419]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([delivery_time_m_sum])/sum([delivery_time_m_count])' />
      </column>
      <column caption='Delay &gt;10m' datatype='real' default-format='p0%' name='[Calculation_4029525406747791364]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([orders_delivery_delay_10m])/sum([delivery_time_m_count])' />
      </column>
      <column caption='Issue Rate Weekly_Customers (%)' datatype='real' hidden='true' name='[Calculation_4149293000653348871]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([issues_total_last_week_customers]) / SUM([orders_total_weekly]) * 100' />
      </column>
      <column caption='IndexIssuesDistribution' datatype='boolean' name='[Calculation_4149293000666837028]' role='measure' type='nominal'>
        <calculation class='tableau' formula='index()!=4'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Label' datatype='string' hidden='true' name='[Calculation_4149293000738619454]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Customer     Vendor       Rider&apos;' />
      </column>
      <column caption='Issue Rate Shapes Contact Center' datatype='string' name='[Calculation_4149293067677130757]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ROUND([Issue Rate (copy 2)],1) = ROUND(LOOKUP([Issue Rate (copy 2)],-1),1) &#10;OR ROUND([Issue Rate (copy 2)],1) = ROUND(LOOKUP([Issue Rate (copy 2)],1),1) &#10;THEN &apos;Same&apos;&#10;ELSEIF [Issue Rate (copy 2)] &lt; LOOKUP([Issue Rate (copy 2)],1) THEN &apos;DOWN&apos;&#10;ELSEIF [Issue Rate (copy 2)] &gt; LOOKUP([Issue Rate (copy 2)],1) THEN &apos;UP&apos;&#10;ELSEIF [Issue Rate (copy 2)] &gt; LOOKUP([Issue Rate (copy 2)],-1) THEN &apos;UPCurrentWeek&apos;&#10;ELSEIF [Issue Rate (copy 2)] &lt; LOOKUP([Issue Rate (copy 2)],-1) THEN &apos;DOWNCurrentWeek&apos;&#10;ELSEIF ISNULL([Issue Rate (copy 2)]) THEN &apos;NA&apos;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Monthly Rest Orders Filtered' datatype='integer' name='[Calculation_4277504876104978433]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  MIN([sub_entity]) =&apos;Pizza.de&apos; OR MIN([sub_entity]) = &apos;FD - Germany&apos; or MIN([sub_entity])=&apos;ClickDeliveryGreece&apos;&#10;or MIN([sub_entity])=&apos;FOC - UAE&apos;&#10;or MIN([sub_entity])=&apos;Baedaltong&apos;&#10;or MIN([sub_entity])=&apos;Deliveras&apos;&#10;THEN 0 &#10;else [Calculation_825636476500873216]&#10;END' />
      </column>
      <column caption='OD Fail Rate' datatype='real' default-format='p0.0%' name='[Calculation_4347803260235378688]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([orders_fail_od])/ sum([orders_total_od])' />
      </column>
      <column caption='New Res Fail Rate' datatype='real' default-format='p0.0%' name='[Calculation_4347803260237537281]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([restaurants_new_fail_orders])/sum(restaurants_new_total_orders)' />
      </column>
      <column caption='Calendar week for filtering' datatype='datetime' name='[Calculation_4348225507491082241]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{max([calendar_week])}' />
      </column>
      <column caption='Last Week Filter' datatype='boolean' name='[Calculation_4348225507491762178]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[calendar_week] = [Calculation_4348225507491082241]' />
      </column>
      <column caption='RR Ord vs Bud' datatype='real' name='[Calculation_4348225507495657475]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([mon_orders_rr]) / sum([mon_orders_bud]) - 1' />
      </column>
      <column caption='Fail Rate 28d' datatype='real' name='[Calculation_4348225507498610692]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([orders_fail_28_d]) / sum ([orders_total_28_d])' />
      </column>
      <column caption='Fail Rate YoY' datatype='real' name='[Calculation_4348225507498962949]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_4348225507498610692] - [Fail Rate (copy)])*100' />
      </column>
      <column caption='NPS 28 D' datatype='real' name='[Calculation_4348225507506737158]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([nps_ao_promoters_28_d])-sum([nps_ao_detractors_28_d]))/sum([nps_ao_responses_28_d])' />
      </column>
      <column caption='NPS 28 YoY' datatype='real' name='[Calculation_4348225507507138567]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_4348225507506737158] - [NPS (copy)])*100' />
      </column>
      <column caption='Acq WoW' datatype='real' name='[Calculation_4348225507523715080]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([acquisitions]) / sum([acquisitions_wow]) -1' />
      </column>
      <column caption='Orders YoY' datatype='real' name='[Calculation_4348225507523899401]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([orders_succ]) / sum([orders_succ_yoy]) -1' />
      </column>
      <column caption='Fail Rate Weekly' datatype='real' name='[Calculation_4348225507529023498]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([orders_fail])/sum([orders_total])' />
      </column>
      <column caption='YoY' datatype='string' name='[Calculation_4348225507538153483]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;YoY&apos;' />
      </column>
      <column caption='Attribute' datatype='integer' name='[Calculation_4348225507550466060]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Monthly Target Restaurants' datatype='integer' name='[Calculation_4701898781003743232]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IFNULL([mon_res_new_online_target_mp],0))+sum(IFNULL([mon_res_new_online_target_od],0))' />
      </column>
      <column caption='Monthly Target Achieved' datatype='real' default-format='p0%' name='[Calculation_4701898781004062721]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([mon_new_restaurants_online])/[Calculation_4701898781003743232]' />
      </column>
      <column caption='Free Delivery OD Share' datatype='real' default-format='p0%' name='[Calculation_5136777619079245824]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_succ_free_delivery_od_food]) / SUM([orders_succ_od_food])' />
      </column>
      <column caption='Total Res Online Monthly No Duplication' datatype='integer' name='[Calculation_5380605309139656705 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF MIN([Entity (group)]) = MAX([Entity (group)])&#10;    THEN IF MIN([sub_entity]) = MAX([sub_entity]) &#10;        THEN [Calculation_825636476500873216]&#10;        ELSE IF  MIN([Entity (group)]) = &apos;DH Germany&apos; or MIN([Entity (group)]) = &apos;DH Greece&apos; or MIN([Entity (group)]) = &apos;DH Korea&apos;&#10;        THEN MAX({fixed [calendar_week],[sub_entity] : ([Calculation_825636476500873216])})&#10;        ELSE SUM({fixed [calendar_week],[sub_entity] : ([Calculation_825636476500873216])})&#10;    END&#10;    END&#10;    ELSE SUM({FIXED [calendar_week], [sub_entity] : [Calculation_4277504876104978433]})&#10;END' />
      </column>
      <column caption='Multiplier DATE' datatype='string' datatype-customized='true' default-format='L' name='[Calculation_5515783661184126976]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF NOT ISNULL(SUM([total_cltv])) THEN MAX({FIXED :MIN([report_week])}) END' />
      </column>
      <column caption='Multiplier Date Month' datatype='string' name='[Calculation_5515783661191249921]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL(SUM([total_cltv])) THEN &apos;M-2&apos;&#10;ELSEIF NOT ISNULL(SUM([total_cltv]))  THEN&apos;M-1&apos;&#10;ELSEIF ISNULL(SUM([total_cltv])) AND ISNULL(SUM([total_cltv_wow])) THEN &apos;Not Available (Data older than M-2)&apos; &#10;END' />
      </column>
      <column caption='Multiplier Flag' datatype='boolean' name='[Calculation_5515783661193940994]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Calculation_5515783661184126976]) THEN FALSE ELSE TRUE END' />
      </column>
      <column caption='Report Week MIN' datatype='string' hidden='true' name='[Calculation_5515783661223153668]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{MIN([report_week])}' />
      </column>
      <column caption='Mon Darkstores GMV BDG' datatype='integer' name='[Calculation_5515783661470994438]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[mon_afv_darkstores_bud] * [mon_orders_darkstores_bud]' />
      </column>
      <column caption='Darkstores AFV BDG' datatype='real' name='[Calculation_5515783661471354887]' role='measure' type='quantitative'>
