          <datasource-dependencies datasource='federated.1x0d0dz0mvxafa10k0g1v1o8302d'>
            <column caption='% Deals Orders Darkstore' datatype='real' default-format='p0.0%' name='[Calculation_1508002201969250324]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_succ_darkstores_deals_dh]) / SUM([orders_succ_darkstores])' />
            </column>
            <column caption='Calendar week for filtering' datatype='datetime' name='[Calculation_4348225507491082241]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{max([calendar_week])}' />
            </column>
            <column caption='Last Week Filter' datatype='boolean' name='[Calculation_4348225507491762178]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[calendar_week] = [Calculation_4348225507491082241]' />
            </column>
            <column caption='Order Share Darkstores' datatype='real' name='[Calculation_5732660126773530667]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(orders_succ_darkstores) / SUM([orders_succ])' />
            </column>
            <column caption='Orders Darkstores WoW (%)' datatype='real' name='[Calculation_5732660126789251125]' role='measure' type='quantitative'>
