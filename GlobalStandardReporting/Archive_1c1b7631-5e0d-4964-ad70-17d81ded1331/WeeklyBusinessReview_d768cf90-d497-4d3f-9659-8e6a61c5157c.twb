      <column caption='Target Achieved RR Trend Food' datatype='string' name='[Target Achieved RR Trend (copy)_35114010597023759]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Target Achieved RR (copy)_35114010590187534]*100 &lt;25 THEN &apos;Dark Red&apos;&#10;ELSEIF [Target Achieved RR (copy)_35114010590187534]*100 &gt;=25 AND [Target Achieved RR (copy)_35114010590187534]*100 &lt; 50 THEN &apos;Medium Red&apos;&#10;ELSEIF [Target Achieved RR (copy)_35114010590187534]*100 &gt;=50 AND [Target Achieved RR (copy)_35114010590187534]*100 &lt;75 THEN &apos;Light Red&apos;&#10;ELSEIF [Target Achieved RR (copy)_35114010590187534]*100 &gt;= 75 THEN &apos;Gray&apos;&#10;END' />
      </column>
      <column caption='Target Achieved RR Trend NV' datatype='string' name='[Target Achieved RR Trend (copy)_35114010600583189]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Target Achieved RR Food (copy)_35114010600083476]*100 &lt;25 THEN &apos;Dark Red&apos;&#10;ELSEIF [Target Achieved RR Food (copy)_35114010600083476]*100 &gt;=25 AND [Target Achieved RR Food (copy)_35114010600083476]*100 &lt; 50 THEN &apos;Medium Red&apos;&#10;ELSEIF [Target Achieved RR Food (copy)_35114010600083476]*100 &gt;=50 AND [Target Achieved RR Food (copy)_35114010600083476]*100 &lt;75 THEN &apos;Light Red&apos;&#10;ELSEIF [Target Achieved RR Food (copy)_35114010600083476]*100 &gt;= 75 THEN &apos;Gray&apos;&#10;END' />
