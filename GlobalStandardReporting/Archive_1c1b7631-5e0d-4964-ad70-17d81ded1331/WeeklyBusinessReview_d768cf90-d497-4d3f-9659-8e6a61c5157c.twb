      <column caption='Time To Order Shape' datatype='integer' hidden='true' name='[Time To Order (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_1622281029409574920] &gt; [Parameters].[3M Threshold (copy)] then 1 end' />
