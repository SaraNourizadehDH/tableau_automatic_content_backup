    <worksheet name='Speed DT vs PT'>
      <table>
        <view>
          <datasources>
            <datasource caption='dwh_bl.tableau_weekly_performance_report' name='federated.1x0d0dz0mvxafa10k0g1v1o8302d' />
          </datasources>
          <datasource-dependencies datasource='federated.1x0d0dz0mvxafa10k0g1v1o8302d'>
            <column caption='AVG DT 28D' datatype='real' name='[AVG DT (copy 2)_5732660126526423078]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([delivery_time_m_sum_28_d])/sum([delivery_time_m_count_28_d])' />
            </column>
            <column caption='DT vs PT L28D' datatype='real' name='[Calculation_1508002201690193933]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[AVG DT (copy 2)_5732660126526423078] -  (SUM([promised_eta_m_sum_28_d])/SUM([promised_eta_m_count_28_d]))' />
            </column>
            <column caption='DT vs PT 28D Color' datatype='string' name='[Calculation_1508002201692012560]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [AVG DT (copy 2)_5732660126526423078] &gt; SUM([promised_eta_m_sum_28_d])/SUM([promised_eta_m_count_28_d]) THEN &apos;red&apos;&#10;else &apos;gray&apos; END' />
            </column>
            <column caption='Calendar week for filtering' datatype='datetime' name='[Calculation_4348225507491082241]' role='dimension' type='ordinal'>
