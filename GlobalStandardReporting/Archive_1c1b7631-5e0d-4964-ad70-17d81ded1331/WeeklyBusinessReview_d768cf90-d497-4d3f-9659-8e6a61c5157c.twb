              <calculation class='tableau' formula='[Calculation_5732660126492065806] - [Calculation_6871507936923197440]' />
            </column>
            <column caption='Calendar week for filtering' datatype='datetime' name='[Calculation_4348225507491082241]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{max([calendar_week])}' />
            </column>
            <column caption='Last Week Filter' datatype='boolean' name='[Calculation_4348225507491762178]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[calendar_week] = [Calculation_4348225507491082241]' />
            </column>
            <column caption='Fail Rate' datatype='real' name='[Calculation_5732660126492065806]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_fail]) / SUM([orders_total])' />
            </column>
            <column caption='Fail Rate Trend %pp' datatype='string' name='[Calculation_5732660126492446737]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1296262651973197849] &gt; 0.01 THEN &apos;Positive&apos; ELSE &apos;Negative&apos; END' />
