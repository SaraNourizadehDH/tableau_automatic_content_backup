    <dashboard name='Choice'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/WeeklyBusinessReview_0/Choice?rev=' id='Choice' path='/t/GlobalStandardReporting/workbooks/WeeklyBusinessReview_0' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='900' maxwidth='1500' minheight='900' minwidth='1500' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98222' id='712' param='horz' type-v2='layout-flow' w='98934' x='533' y='889'>
