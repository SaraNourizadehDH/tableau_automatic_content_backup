    <worksheet name='RR Acquisition'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='9'>Acquisitions </run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='7'>(&apos;000)</run>
            <run fontalignment='1'>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='dwh_bl.tableau_weekly_performance_report' name='federated.1x0d0dz0mvxafa10k0g1v1o8302d' />
          </datasources>
          <datasource-dependencies datasource='federated.1x0d0dz0mvxafa10k0g1v1o8302d'>
            <column caption='Acq WoW Color' datatype='string' name='[Calculation_3564247273914187805]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_4348225507523715080] &lt; 0 THEN &apos;Negative&apos; ELSE &apos;Positive&apos; END' />
            </column>
            <column caption='Acquisitions Voucher Share (%)' datatype='real' name='[Calculation_3564247273914470430]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(acquisitions_voucher) / SUM(IFNULL(acquisitions, 0))' />
            </column>
            <column caption='RR Acq vs Bud Color' datatype='string' name='[Calculation_3564247273966391355]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [RR Ord vs Bud (copy)] &lt; 0 THEN &apos;Negative&apos; ELSE &apos;Positive&apos; END' />
            </column>
            <column caption='RR Acq YoY Color' datatype='string' name='[Calculation_3564247273966911548]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [RR Ord YoY (copy)] &lt; 0 THEN &apos;Negative&apos; ELSE &apos;Positive&apos; END' />
            </column>
            <column caption='RR Acq vs Bud (Diff) Color' datatype='string' name='[Calculation_3564247273982734398]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [RR Acq vs Bud (copy)] &lt; 0 THEN &apos;Negative&apos; ELSE &apos;Positive&apos; END' />
            </column>
            <column caption='Calendar week for filtering' datatype='datetime' name='[Calculation_4348225507491082241]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{max([calendar_week])}' />
            </column>
            <column caption='Last Week Filter' datatype='boolean' name='[Calculation_4348225507491762178]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[calendar_week] = [Calculation_4348225507491082241]' />
            </column>
            <column caption='Acq WoW' datatype='real' name='[Calculation_4348225507523715080]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([acquisitions]) / sum([acquisitions_wow]) -1' />
            </column>
            <column caption='Attr (1)' datatype='integer' name='[Calculation_6376182346401984512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Entity ' datatype='string' name='[Entity (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[management_entity]' new-bin='true'>
                <bin default-name='false' value='&quot;Pandora&quot;'>
                  <value>&quot;DH Austria&quot;</value>
                  <value>&quot;DH CEE&quot;</value>
                  <value>&quot;DH Nordics&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='RR Acq vs Bud (diff)' datatype='real' name='[RR Acq vs Bud (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([mon_acquisitions_rr]) - sum([mon_acquisitions_bud])' />
            </column>
            <column caption='RR Acq YoY' datatype='real' name='[RR Ord YoY (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([mon_acquisitions_rr]) / sum([mon_acquisitions_rr_yoy]) -1' />
            </column>
            <column caption='RR Acq vs Bud' datatype='real' name='[RR Ord vs Bud (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([mon_acquisitions_rr]) / sum([mon_acquisitions_bud]) - 1' />
