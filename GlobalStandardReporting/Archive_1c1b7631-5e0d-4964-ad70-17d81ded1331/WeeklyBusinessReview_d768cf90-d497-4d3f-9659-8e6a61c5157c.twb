      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='dwh_bl.tableau_weekly_performance_report' name='federated.1x0d0dz0mvxafa10k0g1v1o8302d' />
          </datasources>
          <datasource-dependencies datasource='federated.1x0d0dz0mvxafa10k0g1v1o8302d'>
            <column caption='GMV Eur' datatype='real' name='[Calculation_3564247273894346769]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([gmv_eur_mp],0)) + SUM(IFNULL([gmv_eur_od],0))' />
            </column>
            <column caption='GMV WoW (%)' datatype='real' name='[Calculation_3564247273895415827]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3564247273894346769] / [GMV Eur (copy)_3564247273895338002] - 1' />
            </column>
            <column caption='GMV WoW (%) Color' datatype='string' name='[Calculation_3564247273895919636]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_3564247273895415827] &lt; 0 THEN &apos;Negative&apos; ELSE &apos;Positive&apos; END' />
            </column>
            <column caption='GMV vs BDG ' datatype='real' name='[Calculation_3564247273898360855]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(mon_gmv_eur_rr) - SUM(mon_gmv_eur_bud)' />
            </column>
            <column caption='GMV RR YoY (%)' datatype='real' default-format='n#,##0.0&quot;%&quot;;-#,##0.0&quot;%&quot;' name='[Calculation_3564247273901133848]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([mon_gmv_eur_rr]) / SUM([mon_gmv_eur_rr_yoy]) - 1' />
            </column>
            <column caption='GMV RR YoY (%) Color' datatype='string' name='[Calculation_3564247273903206425]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_3564247273901133848] &lt; 0 THEN &apos;Negative&apos; ELSE &apos;Positive&apos; END' />
            </column>
            <column caption='RR GMV vs Budget' datatype='real' default-format='p0.0%' name='[Calculation_3564247273921159207]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(mon_gmv_eur_rr) / SUM(IFNULL(mon_gmv_eur_bud, 0)) - 1' />
            </column>
            <column caption='GMV vs BDG Color' datatype='string' name='[Calculation_3564247273960357944]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_3564247273898360855] &lt; 0 THEN &apos;Negative&apos; ELSE &apos;Positive&apos; END' />
            </column>
            <column caption='RR GMV vs Budget Color' datatype='string' name='[Calculation_3564247273965969466]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_3564247273921159207] &lt; 0 THEN &apos;Negative&apos; ELSE &apos;Positive&apos; END' />
            </column>
            <column caption='Calendar week for filtering' datatype='datetime' name='[Calculation_4348225507491082241]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{max([calendar_week])}' />
