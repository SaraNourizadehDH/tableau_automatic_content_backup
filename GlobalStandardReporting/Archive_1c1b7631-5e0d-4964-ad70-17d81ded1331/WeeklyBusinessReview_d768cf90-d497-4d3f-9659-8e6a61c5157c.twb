      <column caption='Total Res Online Last Month' datatype='integer' name='[Total Res Online Monthly (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([restaurants_online_mp_monthly_wow]) + sum([restaurants_online_od_monthly_wow])' />
      </column>
      <column caption='Total Res Online Monthly MoM No Duplication' datatype='real' name='[Total Res Online Monthly MoM (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5380605309139656705 1] / [Total Res Online Monthly No Duplication (copy)] -1' />
      </column>
      <column caption='Total Res Online Monthly YoY No Duplication' datatype='real' hidden='true' name='[Total Res Online Monthly MoM No Duplication (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5380605309139656705 1] / [Total Res Online Monthly No Duplication LM (copy 2)] -1' />
      </column>
      <column caption='Restaurants New Online MP No Duplication' datatype='integer' hidden='true' name='[Total Res Online Monthly No Duplication (copy 2)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF MIN([Entity (group)]) = MAX([Entity (group)])&#10;    THEN IF MIN([sub_entity]) = MAX([sub_entity]) &#10;        THEN sum([restaurants_new_online_mp])&#10;        ELSE IF  MIN([Entity (group)]) = &apos;DH Germany&apos; or MIN([Entity (group)]) = &apos;DH Greece&apos; or MIN([Entity (group)]) = &apos;DH Korea&apos;&#10;        THEN MAX({fixed [calendar_week],[sub_entity] : sum([restaurants_new_online_mp])})&#10;        ELSE SUM({fixed [calendar_week],[sub_entity] : sum([restaurants_new_online_mp])})&#10;    END&#10;    END&#10;    ELSE SUM({FIXED [calendar_week], [sub_entity] : ([Monthly Rest New Online OD Filtered (copy)])})&#10;END' />
      </column>
      <column caption='Total Res Online Weekly No Duplication' datatype='integer' name='[Total Res Online Monthly No Duplication (copy 3)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF MIN([Entity (group)]) = MAX([Entity (group)])&#10;    THEN IF MIN([sub_entity]) = MAX([sub_entity]) &#10;        THEN Sum([restaurants_online])&#10;        ELSE IF  MIN([Entity (group)]) = &apos;DH Germany&apos; or MIN([Entity (group)]) = &apos;DH Greece&apos; or MIN([Entity (group)]) = &apos;DH Korea&apos;&#10;        THEN MAX({fixed [calendar_week],[sub_entity] : Sum([restaurants_online])})&#10;        ELSE SUM({fixed [calendar_week],[sub_entity] : Sum([restaurants_online])})&#10;    END&#10;    END&#10;    ELSE SUM({FIXED [calendar_week], [sub_entity] : ([Monthly Rest Orders Filtered (copy 3)])})&#10;END' />
      </column>
      <column caption='Total Res Online Monthly No Duplication LM' datatype='integer' name='[Total Res Online Monthly No Duplication (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF MIN([Entity (group)]) = MAX([Entity (group)])&#10;    THEN IF MIN([sub_entity]) = MAX([sub_entity]) &#10;        THEN [Total Res Online Monthly (copy)]&#10;        ELSE IF  MIN([Entity (group)]) = &apos;DH Germany&apos; or MIN([Entity (group)]) = &apos;DH Greece&apos; or MIN([Entity (group)]) = &apos;DH Korea&apos;&#10;        THEN MAX({fixed [calendar_week],[sub_entity] : ([Total Res Online Monthly (copy)])})&#10;        ELSE SUM({fixed [calendar_week],[sub_entity] : ([Total Res Online Monthly (copy)])})&#10;    END&#10;    END&#10;    ELSE SUM({FIXED [calendar_week], [sub_entity] : [Monthly Rest Orders Filtered (copy)]})&#10;END' />
      </column>
      <column caption='Total Res Online Monthly No Duplication LY' datatype='integer' hidden='true' name='[Total Res Online Monthly No Duplication LM (copy 2)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF MIN([Entity (group)]) = MAX([Entity (group)])&#10;    THEN IF MIN([sub_entity]) = MAX([sub_entity]) &#10;        THEN [Total Res Online Monthly (copy)]&#10;        ELSE IF  MIN([Entity (group)]) = &apos;DH Germany&apos; or MIN([Entity (group)]) = &apos;DH Greece&apos; or MIN([Entity (group)]) = &apos;DH Korea&apos;&#10;        THEN MAX({fixed [calendar_week],[sub_entity] : sum([restaurants_online_yoy])})&#10;        ELSE SUM({fixed [calendar_week],[sub_entity] : sum([restaurants_online_yoy])})&#10;    END&#10;    END&#10;    ELSE SUM({FIXED [calendar_week], [sub_entity] : [Monthly Rest Orders Filtered LM (copy 2)]})&#10;END' />
      </column>
      <column caption='Total Res Online Weekly No Duplication LY' datatype='integer' name='[Total Res Online Monthly No Duplication LM (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF MIN([Entity (group)]) = MAX([Entity (group)])&#10;    THEN IF MIN([sub_entity]) = MAX([sub_entity]) &#10;        THEN sum([restaurants_online_yoy])&#10;        ELSE IF  MIN([Entity (group)]) = &apos;DH Germany&apos; or MIN([Entity (group)]) = &apos;DH Greece&apos; or MIN([Entity (group)]) = &apos;DH Korea&apos;&#10;        THEN MAX({fixed [calendar_week],[sub_entity] : sum([restaurants_online_yoy])})&#10;        ELSE SUM({fixed [calendar_week],[sub_entity] : sum([restaurants_online_yoy])})&#10;    END&#10;    END&#10;    ELSE SUM({FIXED [calendar_week], [sub_entity] : [Monthly Rest Orders Filtered LM (copy)]})&#10;END' />
      </column>
      <column caption='UTR ' datatype='real' name='[UTR 28D (copy)_5732660126525775909]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(orders_delivered)/ IFNULL(SUM(rider_hours),0)' />
