              <calculation class='tableau' formula='[calendar_week] = [Calculation_4348225507491082241]' />
            </column>
            <column caption='Attr (1)' datatype='integer' name='[Calculation_6376182346401984512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Darkstores Orders / Store Daily' datatype='real' name='[Darkstores Orders / Store  (copy)_1508002201696976914]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(orders_succ_darkstores)/IFNULL(SUM(darkstores_online),0) / 7' />
