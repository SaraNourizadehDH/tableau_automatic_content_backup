    <worksheet name='Group GMV Yearly'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='6'>Orders</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='dwh_bl.tableau_weekly_performance_report' name='federated.1x0d0dz0mvxafa10k0g1v1o8302d' />
          </datasources>
          <datasource-dependencies datasource='federated.1x0d0dz0mvxafa10k0g1v1o8302d'>
            <column caption='GMV RR YoY (%)' datatype='real' default-format='n#,##0.0&quot;%&quot;;-#,##0.0&quot;%&quot;' name='[Calculation_3564247273901133848]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([mon_gmv_eur_rr]) / SUM([mon_gmv_eur_rr_yoy]) - 1' />
            </column>
            <column caption='Group' datatype='string' name='[Calculation_3956834545939652608]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [segment] = &apos;Asia&apos; AND [management_entity] = &apos;Woowa&apos; THEN &apos;Woowa&apos;&#10;ELSEIF [segment] = &apos;Asia&apos; AND [management_entity] &lt;&gt; &apos;Woowa&apos;  THEN &apos;APAC&apos;&#10;ELSEIF [segment] = &apos;America&apos;   THEN &apos;LATAM&apos;&#10; ELSE [segment] END' />
            </column>
            <column caption='GMV RR YoY  Yearly' datatype='real' default-format='n#,##0.0&quot;%&quot;;-#,##0.0&quot;%&quot;' name='[GMV RR YoY (%) (copy)_3956834546273030155]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_eur_rr_yearly]) / SUM([gmv_last_year]) - 1' />
            </column>
            <column caption='RR GMV vs BE Yearly' datatype='real' default-format='p0.0%' name='[RR GMV vs BE (copy)_3956834546272604170]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_eur_rr_yearly]) / SUM(IFNULL([gmv_eur_be_y], 0)) - 1' />
            </column>
            <column caption='RR GMV vs Budget Yearly' datatype='real' default-format='p0.0%' name='[RR GMV vs Budget (copy)_3956834546272043017]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_eur_rr_yearly]) / SUM(IFNULL([gmv_eur_bud_y], 0)) - 1' />
            </column>
            <column datatype='real' name='[gmv_eur_be_y]' role='measure' type='quantitative' />
            <column datatype='real' name='[gmv_eur_bud_y]' role='measure' type='quantitative' />
            <column datatype='real' name='[gmv_eur_rr_yearly]' role='measure' type='quantitative' />
            <column datatype='real' name='[gmv_last_year]' role='measure' type='quantitative' />
            <column caption='Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column caption='Mon Gmv Eur Rr' datatype='real' default-format='*#,##0,' name='[mon_gmv_eur_rr]' role='measure' type='quantitative' />
            <column caption='Mon Gmv Eur Rr Yoy' datatype='real' name='[mon_gmv_eur_rr_yoy]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_3956834545939652608]' derivation='None' name='[none:Calculation_3956834545939652608:nk]' pivot='key' type='nominal' />
