      <column caption='Total Gap Addressable WoW' datatype='real' default-format='p0%' name='[Total Gap WoW (copy)_4898579423346311169]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([addressable_gap]) / SUM([addressable_gap_wow]) - 1' />
