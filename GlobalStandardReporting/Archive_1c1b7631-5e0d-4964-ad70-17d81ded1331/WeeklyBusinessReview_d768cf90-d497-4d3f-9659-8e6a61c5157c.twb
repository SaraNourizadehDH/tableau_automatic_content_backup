    <worksheet name='SOE MP Fail Rate '>
      <table>
        <view>
          <datasources>
            <datasource caption='dwh_bl.tableau_weekly_performance_report' name='federated.1x0d0dz0mvxafa10k0g1v1o8302d' />
          </datasources>
          <datasource-dependencies datasource='federated.1x0d0dz0mvxafa10k0g1v1o8302d'>
            <column caption='Calendar week for filtering' datatype='datetime' name='[Calculation_4348225507491082241]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{max([calendar_week])}' />
            </column>
            <column caption='Last Week Filter' datatype='boolean' name='[Calculation_4348225507491762178]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[calendar_week] = [Calculation_4348225507491082241]' />
            </column>
            <column caption='Attr (1)' datatype='integer' name='[Calculation_6376182346401984512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Entity ' datatype='string' name='[Entity (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[management_entity]' new-bin='true'>
                <bin default-name='false' value='&quot;Pandora&quot;'>
                  <value>&quot;DH Austria&quot;</value>
                  <value>&quot;DH CEE&quot;</value>
                  <value>&quot;DH Nordics&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='Fail Rate MP  Color ' datatype='string' name='[Fail Rate OD  Color  (copy)_1508002201610260487]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Fail Rate OD (copy)_5732660126495182873] &lt; 0.02 THEN &apos;Gray&apos;&#10;ELSEIF [Fail Rate OD (copy)_5732660126495182873] &gt;= 0.02 AND [Fail Rate OD (copy)_5732660126495182873] &lt;= 0.04 THEN &apos;Light Red&apos;&#10;ELSEIF [Fail Rate OD (copy)_5732660126495182873]&gt;0.04 AND [Fail Rate OD (copy)_5732660126495182873] &lt;=0.05 THEN &apos;Medium Red&apos;&#10;ELSEIF ISNULL([Fail Rate OD (copy)_5732660126495182873]) THEN &apos;Gray&apos;&#10;ELSE &apos;Dark Red&apos;&#10;END' />
            </column>
            <column caption='Fail Rate MP' datatype='real' name='[Fail Rate OD (copy)_5732660126495182873]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_fail_mp]) / SUM(IFNULL([orders_total_mp],0))' />
            </column>
            <column caption='Fail Rate MP 28 D' datatype='real' name='[Fail Rate OD 28 D (copy)_5732660126495182872]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(orders_fail_mp_28_d) / SUM(IFNULL(orders_total_mp_28_d,0))' />
            </column>
            <column caption='Fail Rate MP 28D Color' datatype='string' name='[Fail Rate OD 28D Color (copy)_1508002201610772488]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Fail Rate OD 28 D (copy)_5732660126495182872]  &lt; 0.02 THEN &apos;Gray&apos;&#10;ELSEIF [Fail Rate OD 28 D (copy)_5732660126495182872] &gt;= 0.02 AND [Fail Rate OD 28 D (copy)_5732660126495182872] &lt;= 0.04 THEN &apos;Light Red&apos;&#10;ELSEIF [Fail Rate OD 28 D (copy)_5732660126495182872] &gt;0.04 AND [Fail Rate OD 28 D (copy)_5732660126495182872] &lt;=0.05 THEN &apos;Medium Red&apos;&#10;ELSEIF ISNULL([Fail Rate OD 28 D (copy)_5732660126495182872])  THEN &apos;Gray&apos;&#10;ELSE &apos;Dark Red&apos;&#10;END' />
            </column>
            <column datatype='string' name='[Segment (copy)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[segment]' />
            </column>
            <column-instance column='[Calculation_6376182346401984512]' derivation='Attribute' name='[attr:Calculation_6376182346401984512:qk]' pivot='key' type='quantitative' />
            <column caption='Calendar Week' datatype='datetime' datatype-customized='true' name='[calendar_week]' role='dimension' type='ordinal' />
            <column caption='Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column caption='Mon Orders Rr' datatype='real' name='[mon_orders_rr]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_4348225507491762178]' derivation='None' name='[none:Calculation_4348225507491762178:nk]' pivot='key' type='nominal' />
            <column-instance column='[Segment (copy)]' derivation='None' name='[none:Segment (copy):nk]' pivot='key' type='nominal' />
            <column-instance column='[sub_entity]' derivation='None' name='[none:sub_entity:nk]' pivot='key' type='nominal' />
            <column caption='Orders Fail Mp' datatype='integer' name='[orders_fail_mp]' role='measure' type='quantitative' />
            <column datatype='integer' name='[orders_fail_mp_28_d]' role='measure' type='quantitative' />
            <column caption='Orders Total Mp' datatype='integer' name='[orders_total_mp]' role='measure' type='quantitative' />
            <column datatype='integer' name='[orders_total_mp_28_d]' role='measure' type='quantitative' />
            <column caption='Segment' datatype='string' name='[segment]' role='dimension' type='nominal' />
