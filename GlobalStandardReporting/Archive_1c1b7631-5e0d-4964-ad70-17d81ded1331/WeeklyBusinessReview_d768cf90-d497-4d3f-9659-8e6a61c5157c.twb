          <datasource-dependencies datasource='federated.1x0d0dz0mvxafa10k0g1v1o8302d'>
            <column caption='&quot;L5M Trend&quot;' datatype='string' name='[Calculation_1918885336485048327]' role='dimension' type='nominal' user:unnamed='L5M Trend AO NPS 28D LS'>
              <calculation class='tableau' formula='&quot;L5M Trend&quot;' />
            </column>
            <column caption='AC CSAT' datatype='real' name='[Calculation_5732660126504919069]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ac_support_top2) / SUM([ac_support_resp])' />
