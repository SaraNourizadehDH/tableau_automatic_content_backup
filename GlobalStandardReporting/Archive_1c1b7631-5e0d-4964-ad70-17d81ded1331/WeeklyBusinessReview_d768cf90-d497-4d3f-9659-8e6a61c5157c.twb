      </column>
      <column caption='SLAOverall_Corrected_Shapes' datatype='string' name='[SLAOverall_Corrected (copy)]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ROUND([Calculation_3909546756194115591],1) = ROUND(LOOKUP([Calculation_3909546756194115591],-1),1)&#10;OR ROUND([Calculation_3909546756194115591],1) = ROUND(LOOKUP([Calculation_3909546756194115591],1),1) &#10;THEN &apos;Same&apos;&#10;ELSEIF [Calculation_3909546756194115591] &lt; LOOKUP([Calculation_3909546756194115591],1) THEN &apos;DOWN&apos;&#10;ELSEIF [Calculation_3909546756194115591] &gt; LOOKUP([Calculation_3909546756194115591],1) THEN &apos;UP&apos;&#10;ELSEIF [Calculation_3909546756194115591] &gt; LOOKUP([Calculation_3909546756194115591],-1) THEN &apos;UPCurrentWeek&apos;&#10;ELSEIF [Calculation_3909546756194115591] &lt; LOOKUP([Calculation_3909546756194115591],-1) THEN &apos;DOWNCurrentWeek&apos;&#10;ELSEIF ISNULL([Calculation_3909546756194115591]) THEN &apos;NA&apos;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='SLAOverall_Colors_Threshold' datatype='string' name='[SLAOverall_Corrected_Shapes (copy)]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ROUND([Calculation_3909546756194115591],1) &gt; 70 THEN &apos;green&apos; // 71 - 100&#10;elseif ROUND([Calculation_3909546756194115591],1) &gt; 60 AND ROUND([Calculation_3909546756194115591],1) &lt;= 70 THEN &apos;light red&apos; // 61 - 70&#13;elseif ROUND([Calculation_3909546756194115591],1) &gt; 40 AND ROUND([Calculation_3909546756194115591],1) &lt;= 60 THEN &apos;medium red&apos; // 41 - 60&#10;elseif ROUND([Calculation_3909546756194115591],1) &gt; 20 AND ROUND([Calculation_3909546756194115591],1) &lt;= 40 THEN &apos;red&apos; // 21 - 40&#10;elseif ROUND([Calculation_3909546756194115591],1) &lt;= 20 THEN &apos;dark red&apos; // 0 - 20&#10;end' />
      </column>
      <column datatype='string' name='[Segment (copy)]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[segment]' />
      </column>
