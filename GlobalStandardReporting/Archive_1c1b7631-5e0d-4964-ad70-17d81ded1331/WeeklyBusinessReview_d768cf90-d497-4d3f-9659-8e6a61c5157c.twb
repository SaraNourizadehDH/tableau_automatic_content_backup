    <dashboard name='Appendix'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/WeeklyBusinessReview_0/Appendix?rev=' id='Appendix' path='/t/GlobalStandardReporting/workbooks/WeeklyBusinessReview_0' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='1200' maxwidth='1400' minheight='1200' minwidth='1400' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='98666' id='1' type-v2='text' w='98858' x='571' y='667'>
            <formatted-text>
              <run>Notes :
   - The currency of this report is EURO 
  -  Budget Forecast will be known as Target
   - Some KPI&apos;s which are marked with &quot;*&quot;  after the KPI name have some special condition regarding their availability. The latest available dates for those can be seen on the bottom left of the respective dashboard

</run>
              <run bold='true' fontcolor='#000000' fontsize='12' underline='true'>Abbreviations:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='12'>Æ         </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>RR:</run>
              <run fontcolor='#000000' fontsize='12'>           Runrate</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>BDG:</run>
              <run fontcolor='#000000' fontsize='12'>        Budget</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>RW:</run>
              <run fontcolor='#000000' fontsize='12'>          Rolling week</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>RM:</run>
              <run fontcolor='#000000' fontsize='12'>          Rolling month</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>CW:</run>
              <run fontcolor='#000000' fontsize='12'>          Calendar week</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>CM:</run>
              <run fontcolor='#000000' fontsize='12'>          Calendar month</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>YoY:</run>
              <run fontcolor='#000000' fontsize='12'>         Year over year</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>WoW:</run>
              <run fontcolor='#000000' fontsize='12'>      Week over week</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>MTD:  </run>
              <run fontcolor='#000000' fontsize='12'>     Month to date</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>L5W:  </run>
              <run fontcolor='#000000' fontsize='12'>      Last 5 Weeks</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>L5M:  </run>
              <run fontcolor='#000000' fontsize='12'>      Last 5 Months</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>W-1: </run>
              <run fontcolor='#000000' fontsize='12'>        Last Week</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>LW: </run>
              <run fontcolor='#000000' fontsize='12'>          Last Week</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>M-1:</run>
              <run fontcolor='#000000' fontsize='12'>         Last Month</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>LN:  </run>
              <run fontcolor='#000000' fontsize='12'>          LucaNet (Financial Software)</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>CF:  </run>
              <run fontcolor='#000000' fontsize='12'>          Commission Floor</run>
              <run>Æ&#10;&#10;&#10;</run>
              <run fontcolor='#000000' fontsize='12'>Æ          </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12' underline='true'>KPI Definition:</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>Orders</run>
              <run fontcolor='#000000' fontsize='12'> :                                                              Successful Orders</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>CPA</run>
              <run fontcolor='#000000' fontsize='12'> :                                                                    Marketing Costs / Marketing Acquisitions</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>Multiplier CLTV</run>
              <run fontcolor='#000000' fontsize='12'> :                                           CLTV 10years / CPA</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'><![CDATA[Restos. Signed < Commission Floor]]></run>
              <run fontcolor='#000000' fontsize='12'> : According to GSheet provided by Sales. Commission Floor by city and delivery type (Key accounts Excluded)</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>MTD Restos reneg./uplift vs plan.</run>
              <run fontcolor='#000000' fontsize='12'> :    According to the plan provided by NCR team</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>OD Commission :</run>
              <run fontcolor='#000000' fontsize='12'>                                           Lucanet Commission OD / Lucanet GFV OD</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>MP Commission :</run>
              <run fontcolor='#000000' fontsize='12'>                                           Lucanet Commission MP / Lucanet GMV MP</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>AFV</run>
              <run fontcolor='#000000' fontsize='12'> :                                                                     Commissionable Value / Orders</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>Contact Rate</run>
              <run fontcolor='#000000' fontsize='12'> :                                                 (Inbound SocialMedia Posts + Inbound Emails + Offered Calls + Offered Chats) / Total Orders</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>Contact Cost (All from LN)</run>
              <run fontcolor='#000000' fontsize='12'> :                     Support Function + Dispatching Costs + Restaurants Services + Customer Service</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>Kitchens</run>
              <run fontcolor='#000000' fontsize='12'> :                                                           All the restaurants flagged as kitchens</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>Concepts</run>
              <run fontcolor='#000000' fontsize='12'> :                                                         All the restaurants flagged as concepts</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>Darkstores:                                                      </run>
              <run fontcolor='#000000' fontsize='12'>All restaurants flagged as darkstores</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>Fail Rate</run>
              <run fontcolor='#000000' fontsize='12'> :                                                          Orders Failed / Total Orders</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>Personalization:                                            </run>
              <run fontcolor='#000000' fontsize='12'>Orders coming from SwimLanes</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>Conversion Rate :                                          </run>
              <run fontcolor='#000000' fontsize='12'>Transactions / Sessions</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>CSAT</run>
              <run fontcolor='#000000' fontsize='12'> :                                                                  (ac_support_top2 + ao_delivery_top2 + ao_foodexp_top2 + ao_ordering_top2) / (ac_support_resp + ao_delivery_resp + ao_foodexp_resp + ao_ordering_resp)</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>UTR </run>
              <run fontcolor='#000000' fontsize='12'>:                                                                    Orders Delivered / Rider Hours</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>Pick Up</run>
              <run fontcolor='#000000' fontsize='12'> :                                                             Orders flagged as takeaway</run>
              <run>Æ&#10;&#10;&#10;&#10;&#10;&#10;&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
