      </column>
      <column caption='Res Online Monthly Non-Special Entities' datatype='integer' hidden='true' name='[Res Online Monthly Special Entities (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if min([Entity (group)]) != &apos;DH Germany&apos; and min([Entity (group)]) != &apos;DH Greece&apos; and min([Entity (group)]) != &apos;DH Korea&apos;&#10;THEN [Calculation_825636476500873216]&#10;END' />
      </column>
      <column caption='Restaurants New Online OD No Duplication' datatype='integer' hidden='true' name='[Restaurants New Online MP No Duplication (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF MIN([Entity (group)]) = MAX([Entity (group)])&#10;    THEN IF MIN([sub_entity]) = MAX([sub_entity]) &#10;        THEN sum([restaurants_new_online_od])&#10;        ELSE IF  MIN([Entity (group)]) = &apos;DH Germany&apos; or MIN([Entity (group)]) = &apos;DH Greece&apos; or MIN([Entity (group)]) = &apos;DH Korea&apos;&#10;        THEN MAX({fixed [calendar_week],[sub_entity] : sum([restaurants_new_online_od])})&#10;        ELSE SUM({fixed [calendar_week],[sub_entity] : sum([restaurants_new_online_od])})&#10;    END&#10;    END&#10;    ELSE SUM({FIXED [calendar_week], [sub_entity] : ([Monthly Rest Orders Filtered (copy 2)])})&#10;END' />
      </column>
      <column datatype='integer' hidden='true' name='[Restaurants New Online Target Mtd (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum(ifnull([restaurants_new_online_target_mp],0))+sum(IFNULL([restaurants_new_online_target_od],0)))' />
      </column>
      <column caption='Restaurants Online % &lt;7 Orders Food' datatype='real' default-format='p0.0%' name='[Restaurants Online % &lt;7 Orders (copy)_35114010587897867]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(restaurants_online_od_less_7_orders_food) + SUM(restaurants_online_mp_less_7_orders_food))&#10; / (IFNULL(SUM([restaurants_online_food_2m]),0))&#10;&#10;// We need 2m restaurants because we are looking only for restos which are for at least 2 months online' />
      </column>
      <column caption='Restaurants Online % &lt;7 Orders WoW' datatype='real' name='[Restaurants Online % &lt;7 Orders (copy)_3564247274595668084]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(restaurants_online_od_less_7_orders_wow) + SUM(restaurants_online_mp_less_7_orders_wow))&#10; / (IFNULL(SUM([restaurants_online_mp_wow]) + SUM([restaurants_online_od_wow]),0))' />
      </column>
      <column caption='Restaurants Online % 0 Orders ' datatype='real' name='[Restaurants Online % &lt;7 Orders (copy)_3564247274602328194]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(restaurants_online_od_0_orders) + SUM(restaurants_online_mp_0_orders))&#10; / (IFNULL(SUM([restaurants_online_mp]) + SUM([restaurants_online_od]),0))' />
      </column>
      <column caption='Restaurants Online % 0 Orders WoW %pp' datatype='real' name='[Restaurants Online % &lt;7 Orders WoW (%) pp (copy)_3564247274602328195]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Restaurants Online % &lt;7 Orders (copy)_3564247274602328194] - [Restaurants Online % &lt;7 Orders WoW (copy)_3564247274602328197]' />
      </column>
      <column caption='Restaurants Online % 0 Orders WoW Trend' datatype='string' name='[Restaurants Online % &lt;7 Orders WoW (%) pp Trend (copy)_3564247274602328196]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Restaurants Online % &lt;7 Orders WoW (%) pp (copy)_3564247274602328195] &lt; 0 THEN &apos;Decreased&apos; ELSE &apos;Increased&apos; END' />
      </column>
      <column caption='Restaurants Online % &lt;7 Orders WoW Food' datatype='real' name='[Restaurants Online % &lt;7 Orders WoW (copy)_35114010588352524]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(restaurants_online_od_less_7_orders_wow_food) + SUM(restaurants_online_mp_less_7_orders_wow_food))&#10; / (IFNULL(SUM(restaurants_online_mp_wow_food) + SUM(restaurants_online_od_wow_food),0))' />
      </column>
      <column caption='Restaurants Online % 0 Orders WoW' datatype='real' name='[Restaurants Online % &lt;7 Orders WoW (copy)_3564247274602328197]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(restaurants_online_od_0_orders_wow) + SUM(restaurants_online_mp_0_orders_wow))&#10; / (IFNULL(SUM([restaurants_online_mp_wow]) + SUM([restaurants_online_od_wow]),0))' />
      </column>
