    <worksheet name='Choice Restaurants'>
      <table>
        <view>
          <datasources>
            <datasource caption='dwh_bl.tableau_weekly_performance_report' name='federated.1x0d0dz0mvxafa10k0g1v1o8302d' />
          </datasources>
          <datasource-dependencies datasource='federated.1x0d0dz0mvxafa10k0g1v1o8302d'>
            <column caption='[Restaurants Online Total Food]/1000' datatype='real' name='[Calculation_35114010580422657]' role='measure' type='quantitative' user:unnamed='Choice Restaurants'>
              <calculation class='tableau' formula='[Restaurants Online Total (copy)_35114010580267008]/1000' />
            </column>
            <column caption='[Restaurants Online Total Food]/1000' datatype='real' name='[Calculation_35114010580484098]' role='measure' type='quantitative' user:unnamed='Choice Restaurants'>
              <calculation class='tableau' formula='[Restaurants Online Total (copy)_35114010580267008]/1000' />
            </column>
            <column caption='Restos Food Delta vs Target' datatype='real' default-format='p0.0%' name='[Calculation_35114010581360644]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Restaurants Online Total (copy)_35114010580267008] / SUM([restaurants_online_bud]) - 1' />
            </column>
            <column caption='Food Target Colors' datatype='string' name='[Calculation_35114010583547913]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_35114010581360644] &lt; 0 THEN &apos;Negative&apos; &#10;ELSEIF ISNULL([Calculation_35114010581360644]) THEN &apos;No Data&apos;&#10;ELSE &apos;Positive&apos;&#10;END' />
            </column>
            <column caption='Calendar week for filtering' datatype='datetime' name='[Calculation_4348225507491082241]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{max([calendar_week])}' />
            </column>
            <column caption='Last Week Filter' datatype='boolean' name='[Calculation_4348225507491762178]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[calendar_week] = [Calculation_4348225507491082241]' />
            </column>
            <column caption='Restaurants Online Food Wow %' datatype='real' default-format='p0.0%' name='[Calculation_5739767409326350343]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Restaurants Online Total (copy)_35114010580267008]/[Restaurants Online Total Food (copy)_5739767409325760518])-1' />
            </column>
            <column caption='Attr (1)' datatype='integer' name='[Calculation_6376182346401984512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Entity ' datatype='string' name='[Entity (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[management_entity]' new-bin='true'>
                <bin default-name='false' value='&quot;Pandora&quot;'>
                  <value>&quot;DH Austria&quot;</value>
                  <value>&quot;DH CEE&quot;</value>
                  <value>&quot;DH Nordics&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='Restaurants Online % &lt;7 Orders Food' datatype='real' default-format='p0.0%' name='[Restaurants Online % &lt;7 Orders (copy)_35114010587897867]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(restaurants_online_od_less_7_orders_food) + SUM(restaurants_online_mp_less_7_orders_food))&#10; / (IFNULL(SUM([restaurants_online_food_2m]),0))&#10;&#10;// We need 2m restaurants because we are looking only for restos which are for at least 2 months online' />
            </column>
            <column caption='Restaurants Online OD Share Food' datatype='real' default-format='p0.0%' name='[Restaurants Online OD Share  (copy)_35114010587254794]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(restaurants_online_od_food) / [Restaurants Online Total (copy)_35114010580267008]' />
            </column>
            <column caption='Restaurants Online Total Food' datatype='integer' name='[Restaurants Online Total (copy)_35114010580267008]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([restaurants_online_mp_food]) + SUM([restaurants_online_od_food])' />
            </column>
            <column caption='Restaurants Online WoW Food ' datatype='integer' name='[Restaurants Online Total Food (copy)_5739767409325760518]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([restaurants_online_mp_wow_food]) + SUM([restaurants_online_od_wow_food])' />
            </column>
            <column caption='Restos Food Delta vs Target Sales' datatype='real' default-format='p0.0%' name='[Restos Food Delta vs Target (copy)_4898579423345344512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Restaurants Online Total (copy)_35114010580267008] / SUM([online_restaurant_target]) - 1' />
            </column>
            <column datatype='string' name='[Segment (copy)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[segment]' />
            </column>
            <column-instance column='[Calculation_6376182346401984512]' derivation='Attribute' name='[attr:Calculation_6376182346401984512:qk]' pivot='key' type='quantitative' />
            <column caption='Calendar Week' datatype='datetime' datatype-customized='true' name='[calendar_week]' role='dimension' type='ordinal' />
