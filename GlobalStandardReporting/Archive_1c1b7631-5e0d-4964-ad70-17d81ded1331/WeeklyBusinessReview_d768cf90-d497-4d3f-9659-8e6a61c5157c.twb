      <column caption='Rests Below Comm Floor OD Color' datatype='string' name='[Rests Below Comm Floor OD (copy)_5732660126477807616]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_3564247274287812671]*100 &lt; 15 THEN &apos;Gray&apos;&#10;ELSEIF [Calculation_3564247274287812671]*100 &gt;=15 AND [Calculation_3564247274287812671]*100 &lt; 30 THEN &apos;Light Red&apos;&#10;ELSEIF [Calculation_3564247274287812671]*100 &gt;=30 AND [Calculation_3564247274287812671]*100 &lt; 50 THEN &apos;Medium Red&apos;&#10;ELSEIF [Calculation_3564247274287812671]*100 &gt;= 50 THEN &apos;Dark Red&apos;&#10;END' />
