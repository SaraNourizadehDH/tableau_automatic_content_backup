    <worksheet name='Affordability SF+DF/AOV (2)'>
      <table>
        <view>
          <datasources>
            <datasource caption='dwh_bl.tableau_weekly_performance_report (2)' name='federated.1x0d0dz0mvxafa10k0g1v1o8302d (copy)' />
          </datasources>
          <datasource-dependencies datasource='federated.1x0d0dz0mvxafa10k0g1v1o8302d (copy)'>
            <column caption='Avg. Delivery Fee Food OD' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg. Delivery Fee Food (copy)_1918885336850231352]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_fee_eur_sum_food_od]) / SUM([delivery_fee_eur_count_food_od])' />
            </column>
            <column caption='Avg. Delivery Fee Food 28D OD' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg. Delivery Fee Food 28D (copy)_1918885336850006071]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_fee_eur_sum_food_od_28_d]) / SUM([delivery_fee_eur_count_food_od_28_d])' />
            </column>
            <column caption='Avg. Service Fee Food 28D OD' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg. Delivery Fee Food 28D OD (copy)_6106881147730677761]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([service_fee_eur_sum_food_od_28_d]) / SUM([service_fee_eur_count_food_od_28_d])' />
            </column>
            <column caption='Avg. Service Fee Food OD' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg. Delivery Fee Food OD (copy)_6106881147732099075]' role='measure' type='quantitative'>
