    <worksheet name='DF Groceries'>
      <table>
        <view>
          <datasources>
            <datasource caption='dwh_bl.tableau_weekly_performance_report' name='federated.1x0d0dz0mvxafa10k0g1v1o8302d' />
          </datasources>
          <datasource-dependencies datasource='federated.1x0d0dz0mvxafa10k0g1v1o8302d'>
            <column caption='Avg. Delivery Fee Groceries WoW' datatype='real' default-format='p0.0%' name='[Avg. Delivery Fee Groceries (copy)_3091861945228226581]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3091861945228038164] /  (SUM([delivery_fee_eur_sum_groceries_wow])/SUM([delivery_fee_eur_count_groceries_wow])) - 1' />
            </column>
            <column caption='Avg. Delivery Fee Groceries' datatype='real' name='[Calculation_3091861945228038164]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_fee_eur_sum_groceries]) / SUM([delivery_fee_eur_count_groceries])' />
            </column>
            <column caption='Avg. Delivery Fee Groceries WoW Trend' datatype='string' name='[Calculation_3091861945228439574]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Avg. Delivery Fee Groceries (copy)_3091861945228226581] &lt; 0 THEN &apos;Negative&apos; ELSE &apos;Positive&apos; END' />
            </column>
            <column caption='Calendar week for filtering' datatype='datetime' name='[Calculation_4348225507491082241]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{max([calendar_week])}' />
            </column>
            <column caption='Last Week Filter' datatype='boolean' name='[Calculation_4348225507491762178]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[calendar_week] = [Calculation_4348225507491082241]' />
            </column>
            <column caption='Attr (1)' datatype='integer' name='[Calculation_6376182346401984512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Entity ' datatype='string' name='[Entity (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[management_entity]' new-bin='true'>
                <bin default-name='false' value='&quot;Pandora&quot;'>
                  <value>&quot;DH Austria&quot;</value>
                  <value>&quot;DH CEE&quot;</value>
                  <value>&quot;DH Nordics&quot;</value>
                </bin>
              </calculation>
            </column>
            <column datatype='string' name='[Segment (copy)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[segment]' />
            </column>
            <column-instance column='[Calculation_6376182346401984512]' derivation='Attribute' name='[attr:Calculation_6376182346401984512:qk]' pivot='key' type='quantitative' />
            <column caption='Calendar Week' datatype='datetime' datatype-customized='true' name='[calendar_week]' role='dimension' type='ordinal' />
