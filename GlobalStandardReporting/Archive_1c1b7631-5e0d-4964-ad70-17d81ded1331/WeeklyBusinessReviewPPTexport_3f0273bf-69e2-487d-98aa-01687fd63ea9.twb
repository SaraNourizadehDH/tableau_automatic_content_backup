            <column caption='Reorder Rate M1' datatype='real' default-format='p0.00%' name='[Calculation_3582050600512593922]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([users_1m]) / SUM([acquisitions_1m])&#10;&#10;//Acquisitions means total number of acq since initial month' />
