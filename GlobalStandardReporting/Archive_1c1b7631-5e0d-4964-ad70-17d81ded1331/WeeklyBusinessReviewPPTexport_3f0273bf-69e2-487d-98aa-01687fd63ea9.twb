        <calculation class='tableau' formula='&apos;End Date&apos; +&apos;:&apos; +&apos;  &apos;+&apos; &apos; +  str(date(dateparse(&quot;yyyyMMdd&quot;,str([Last Day  (Month / Day / Year)]))))' />
      </column>
