              <calculation class='tableau' formula='([Avg. Delivery Fee Food 28D (copy)_1918885336850006071]+[Avg. Delivery Fee Food 28D OD (copy)_6106881147730677761]) / (SUM([amt_gmv_eur_od_food_28_d])/SUM([succ_orders_food_od_28_d]))' />
