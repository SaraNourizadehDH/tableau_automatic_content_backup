        <calculation class='tableau' formula='[Calculation_1588222571781967880] - [Pickup Net Commission Rate (copy)_1588222571807428620]' />
      </column>
      <column caption='Net Commission Color' datatype='string' name='[Calculation_1588222571813163026]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1588222571781967880] &lt; 0 THEN &apos;Red&apos; ELSE &apos;Gray&apos; END' />
      </column>
      <column caption='Fail Rate Pickup Color' datatype='string' name='[Calculation_1588222571837014036]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1342213449673367575] &lt; 0.02 THEN &apos;Gray&apos;&#10;ELSEIF [Calculation_1342213449673367575] &gt;= 0.02 AND [Calculation_1342213449673367575] &lt;0.04 THEN &apos;Light Red&apos;&#10;ELSEIF [Calculation_1342213449673367575] &gt;= 0.04 AND [Calculation_1342213449673367575] &lt;0.05 THEN &apos;Medium Red&apos;&#10;ELSEIF [Calculation_1342213449673367575] &gt;=0.05 THEN &apos;Dark Red&apos;&#10;ELSE &apos;Gray&apos;&#10;END' />
      </column>
      <column caption='% 3M' datatype='real' hidden='true' name='[Calculation_1622281029390299138]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([restaurants_online_new_3m_good])/sum([restaurants_online_new_3m])' />
