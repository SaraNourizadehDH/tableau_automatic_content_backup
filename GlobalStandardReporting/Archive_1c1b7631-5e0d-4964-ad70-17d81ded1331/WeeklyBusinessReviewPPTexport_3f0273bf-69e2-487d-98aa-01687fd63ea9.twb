    <worksheet name='Breakdown Orders Pharmacy (2)'>
      <table>
        <view>
          <datasources>
            <datasource caption='dwh_bl.tableau_weekly_performance_report (2)' name='federated.1x0d0dz0mvxafa10k0g1v1o8302d (copy)' />
          </datasources>
          <datasource-dependencies datasource='federated.1x0d0dz0mvxafa10k0g1v1o8302d (copy)'>
            <column caption='Orders Pharma WoW' datatype='real' default-format='p0.0%' name='[Calculation_3091861945220845574]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_succ_pharmacies]) / SUM([orders_succ_pharmacies_wow]) - 1' />
            </column>
            <column caption='Orders Pharma WoW Trend' datatype='string' name='[Calculation_3091861945221021703]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_3091861945220845574] &lt; 0 THEN &apos;Negative&apos; ELSE &apos;Positive&apos; END' />
            </column>
            <column caption='Calendar week for filtering' datatype='datetime' name='[Calculation_4348225507491082241]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{max([calendar_week])}' />
            </column>
            <column caption='Last Week Filter' datatype='boolean' name='[Calculation_4348225507491762178]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[calendar_week] = [Calculation_4348225507491082241]' />
            </column>
            <column caption='Attr (1)' datatype='integer' name='[Calculation_6376182346401984512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Entity ' datatype='string' name='[Entity (group)]' role='dimension' type='nominal'>
