    <worksheet name='AFV Coffee (4)'>
      <table>
        <view>
          <datasources>
            <datasource caption='dwh_bl.tableau_weekly_performance_report' name='federated.1x0d0dz0mvxafa10k0g1v1o8302d' />
          </datasources>
          <datasource-dependencies datasource='federated.1x0d0dz0mvxafa10k0g1v1o8302d'>
            <column caption='AFV Coffee' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[AFV Groceries (copy)_3091861945227395087]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cv_eur_coffee]) / SUM([orders_succ_coffee])' />
            </column>
            <column caption='AFV Coffee WoW ' datatype='real' default-format='p0.0%' name='[AFV Groceries WoW (copy)_3091861945227395086]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[AFV Groceries (copy)_3091861945227395087] / (SUM([cv_eur_coffee_wow]) / SUM([orders_succ_coffee_wow])) - 1' />
            </column>
            <column caption='AFV Coffee WoW Trend' datatype='string' name='[AFV Groceries WoW Trend (copy)_3091861945227395088]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [AFV Groceries WoW (copy)_3091861945227395086] &lt; 0 THEN &apos;Negative&apos; ELSE &apos;Positive&apos; END' />
            </column>
            <column caption='Calendar week for filtering' datatype='datetime' name='[Calculation_4348225507491082241]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{max([calendar_week])}' />
            </column>
            <column caption='Last Week Filter' datatype='boolean' name='[Calculation_4348225507491762178]' role='dimension' type='nominal'>
