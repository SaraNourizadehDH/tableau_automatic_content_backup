              <calculation class='tableau' formula='IF [Calculation_5732660126482817027]*100 &lt;25 THEN &apos;Dark Red&apos;&#10;ELSEIF [Calculation_5732660126482817027]*100 &gt;=25 AND [Calculation_5732660126482817027]*100 &lt; 50 THEN &apos;Medium Red&apos;&#10;ELSEIF [Calculation_5732660126482817027]*100 &gt;=50 AND [Calculation_5732660126482817027]*100 &lt;75 THEN &apos;Light Red&apos;&#10;ELSEIF [Calculation_5732660126482817027]*100 &gt;= 75 THEN &apos;Gray&apos;&#10;END' />
            </column>
