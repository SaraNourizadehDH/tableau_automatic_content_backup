  <worksheets>
    <worksheet name='&lt;7 Orders Sparkline'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='8'>L5W Trend</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='dwh_bl.tableau_weekly_performance_report' name='federated.1x0d0dz0mvxafa10k0g1v1o8302d' />
          </datasources>
          <datasource-dependencies datasource='federated.1x0d0dz0mvxafa10k0g1v1o8302d'>
            <column caption='&quot;L5W Trend&quot;' datatype='string' name='[Calculation_197102867490336773]' role='dimension' type='nominal' user:unnamed='Restaurants Below CF OD Sparkline'>
              <calculation class='tableau' formula='&quot;L5W Trend&quot;' />
            </column>
            <column caption='Entity ' datatype='string' name='[Entity (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[management_entity]' new-bin='true'>
                <bin default-name='false' value='&quot;Pandora&quot;'>
                  <value>&quot;DH Austria&quot;</value>
                  <value>&quot;DH CEE&quot;</value>
                  <value>&quot;DH Nordics&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='Restaurants Online % &lt;7 Orders Food' datatype='real' default-format='p0.0%' name='[Restaurants Online % &lt;7 Orders (copy)_35114010587897867]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(restaurants_online_od_less_7_orders_food) + SUM(restaurants_online_mp_less_7_orders_food))&#10; / (IFNULL(SUM([restaurants_online_food_2m]),0))&#10;&#10;// We need 2m restaurants because we are looking only for restos which are for at least 2 months online' />
            </column>
            <column datatype='string' name='[Segment (copy)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[segment]' />
            </column>
            <column caption='Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column caption='Mon Orders Rr' datatype='real' name='[mon_orders_rr]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_197102867490336773]' derivation='None' name='[none:Calculation_197102867490336773:nk]' pivot='key' type='nominal' />
            <column-instance column='[Segment (copy)]' derivation='None' name='[none:Segment (copy):nk]' pivot='key' type='nominal' />
            <column-instance column='[report_week]' derivation='None' name='[none:report_week:nk]' pivot='key' type='nominal' />
            <column-instance column='[sub_entity]' derivation='None' name='[none:sub_entity:nk]' pivot='key' type='nominal' />
            <column caption='Report Week' datatype='string' name='[report_week]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;W-1&quot;' value='CW-1' />
                <alias key='&quot;W-2&quot;' value='CW-2' />
                <alias key='&quot;W-3&quot;' value='CW-3' />
                <alias key='&quot;W-4&quot;' value='CW-4' />
                <alias key='&quot;W-5&quot;' value='CW-5' />
                <alias key='&quot;W-6&quot;' value='CW-6' />
              </aliases>
            </column>
            <column datatype='integer' name='[restaurants_online_food_2m]' role='measure' type='quantitative' />
            <column datatype='integer' name='[restaurants_online_mp_less_7_orders_food]' role='measure' type='quantitative' />
            <column datatype='integer' name='[restaurants_online_od_less_7_orders_food]' role='measure' type='quantitative' />
            <column caption='Segment' datatype='string' name='[segment]' role='dimension' type='nominal' />
            <column caption='Sub Entity' datatype='string' name='[sub_entity]' role='dimension' type='nominal' />
            <column-instance column='[mon_orders_rr]' derivation='Sum' name='[sum:mon_orders_rr:qk]' pivot='key' type='quantitative' />
