    <worksheet name='New Occasions Pickup KPIs (3)'>
      <table>
        <view>
          <datasources>
            <datasource caption='dwh_bl.tableau_weekly_performance_report (3)' name='federated.1x0d0dz0mvxafa10k0g1v1o8302d (copy 2)' />
          </datasources>
          <datasource-dependencies datasource='federated.1x0d0dz0mvxafa10k0g1v1o8302d (copy 2)'>
            <column caption='Orders Pickup WoW' datatype='real' name='[Calculation_1342213449664765952]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_orders_pickup]) / sum([total_orders_pickup_wow]) -1' />
            </column>
            <column caption='Orders Pickup Color' datatype='string' name='[Calculation_1342213449665069057]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([Calculation_1342213449664765952]) THEN &apos;No Data&apos;&#10;ELSEIF [Calculation_1342213449664765952] &lt; 0 THEN &apos;Negative&apos;&#10;ELSE &apos;Positive&apos; END' />
            </column>
            <column caption='Orders Pickup % Total' datatype='real' name='[Calculation_1342213449665753090]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_successful_pickup]) / SUM([orders_successful_p])' />
            </column>
            <column caption='Orders Pickup % Total WoW pp' datatype='real' name='[Calculation_1342213449666195459]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1342213449665753090] - ( SUM([orders_successful_pickup_wow])/SUM([orders_successful_p_wow]))' />
            </column>
            <column caption='Orders Pickup % Total WoW Trend' datatype='string' name='[Calculation_1342213449666424836]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1342213449666195459] &lt; 0 THEN &apos;Negative&apos;&#10;ELSEIF ISNULL([Calculation_1342213449666195459]) THEN &apos;No Data&apos;&#10;ELSE &apos;Positive&apos; END' />
            </column>
            <column caption='pickup restaurants WoW' datatype='real' name='[Calculation_1342213449668988936]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pickup_restaurants]) / SUM([pickup_restaurants_wow]) - 1' />
            </column>
            <column caption='Pickup Restaurants WoW Trend' datatype='string' name='[Calculation_1342213449669156873]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1342213449668988936] &lt; 0 THEN &apos;Negative&apos;&#10;ELSEIF ISNULL([Calculation_1342213449668988936]) THEN &apos;No Data&apos;&#10;ELSE &apos;Positive&apos; END' />
            </column>
            <column caption='Pickup Restos. %' datatype='real' name='[Calculation_1342213449670643727]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pickup_restaurants]) / SUM([total_restaurants_p])' />
            </column>
            <column caption='Restos Pickup % WoW pp' datatype='real' name='[Calculation_1342213449671368722]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1342213449670643727] -  ( SUM([pickup_restaurants_wow]) / SUM([total_restaurants_p_wow]) )' />
            </column>
            <column caption='Restos Pickup % WoW Trend' datatype='string' name='[Calculation_1342213449671618579]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1342213449671368722] &lt; 0 THEN &apos;Negative&apos;&#10;ELSEIF ISNULL([Calculation_1342213449671368722]) THEN &apos;No Data&apos;&#10;ELSE &apos;Positive&apos; END' />
            </column>
            <column caption='FailRate Pickup' datatype='real' default-format='p0.0%' name='[Calculation_1342213449673367575]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([total_orders_pickup]) - SUM([orders_successful_pickup])) / SUM([total_orders_pickup])' />
            </column>
            <column caption='Pickup Gross Comm Rate' datatype='real' default-format='p0.0%' name='[Calculation_1588222571779330048]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM([pickup_commission_eur]),0) / (IFNULL(SUM([pickup_gmv_eur]),0) + IFNULL(SUM([pickup_voucher_dh_eur]),0) + IFNULL(SUM([pickup_discount_dh_eur]),0) + IFNULL(SUM([pickup_joker_fee_eur]),0))' />
            </column>
            <column caption='Pickup AFV % DH Incentives' datatype='real' default-format='p0.0%' name='[Calculation_1588222571781095428]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IFNULL(SUM([pickup_voucher_dh_eur]),0) + IFNULL(SUM([pickup_discount_dh_eur]),0)) / (IFNULL(SUM([pickup_gmv_eur]),0) + IFNULL(SUM([pickup_voucher_dh_eur]),0) + IFNULL(SUM([pickup_discount_dh_eur]),0) + IFNULL(SUM([pickup_joker_fee_eur]),0))' />
            </column>
            <column caption='Pickup Net Commission Rate' datatype='real' default-format='p0.0%' name='[Calculation_1588222571781967880]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1588222571779330048] - [Calculation_1588222571781095428]' />
