    <worksheet name='Breakdown Orders Drinks'>
      <table>
        <view>
          <datasources>
            <datasource caption='dwh_bl.tableau_weekly_performance_report' name='federated.1x0d0dz0mvxafa10k0g1v1o8302d' />
          </datasources>
          <datasource-dependencies datasource='federated.1x0d0dz0mvxafa10k0g1v1o8302d'>
            <column caption='Orders Drinks WoW' datatype='real' default-format='p0.0%' name='[Calculation_3091861945219555330]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_succ_drinks]) / SUM([orders_succ_drinks_wow]) - 1' />
            </column>
            <column caption='Order Drinks Trend' datatype='string' name='[Calculation_3091861945219768323]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_3091861945219555330] &lt; 0 THEN &apos;Negative&apos; ELSE &apos;Positive&apos; END' />
