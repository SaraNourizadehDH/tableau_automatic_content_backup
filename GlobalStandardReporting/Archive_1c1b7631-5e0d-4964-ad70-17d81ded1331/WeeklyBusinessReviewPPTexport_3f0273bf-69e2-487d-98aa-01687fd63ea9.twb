          <datasource-dependencies datasource='federated.1x0d0dz0mvxafa10k0g1v1o8302d'>
            <column caption='Orders Coffee WoW' datatype='real' default-format='p0.0%' name='[Calculation_3091861945220292612]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_succ_coffee]) / SUM([orders_succ_coffee_wow]) - 1' />
            </column>
            <column caption='Orders Coffee WoW Trend' datatype='string' name='[Calculation_3091861945220513797]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_3091861945220292612] &lt;0 THEN &apos;Negative&apos; ELSE &apos;Positive&apos; END' />
            </column>
            <column caption='Calendar week for filtering' datatype='datetime' name='[Calculation_4348225507491082241]' role='dimension' type='ordinal'>
