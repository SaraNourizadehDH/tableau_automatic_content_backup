      <column caption='Target Achieved RR LW NV' datatype='real' name='[Target Achieved RR LW Food (copy)_35114010601410584]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IFNULL([restaurants_new_online_mp_rr_lw_new_verticals],0)) + SUM(IFNULL([restaurants_new_online_od_rr_lw_new_verticals],0)))&#10;/ (SUM(IFNULL([restaurants_new_online_target_nv_mp],0)) + SUM(IFNULL([restaurants_new_online_target_nv_od],0)))' />
