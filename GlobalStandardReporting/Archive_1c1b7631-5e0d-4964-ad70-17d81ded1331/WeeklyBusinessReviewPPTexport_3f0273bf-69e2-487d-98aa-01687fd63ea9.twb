    <worksheet name='AFV Pharma'>
      <table>
        <view>
          <datasources>
            <datasource caption='dwh_bl.tableau_weekly_performance_report' name='federated.1x0d0dz0mvxafa10k0g1v1o8302d' />
          </datasources>
          <datasource-dependencies datasource='federated.1x0d0dz0mvxafa10k0g1v1o8302d'>
            <column caption='AFV Pharma' datatype='real' name='[AFV Groceries (copy)_3091861945227644946]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cv_eur_pharmacies]) / SUM([orders_succ_pharmacies])' />
            </column>
            <column caption='AFV Pharma WoW ' datatype='real' default-format='p0.0%' name='[AFV Groceries WoW (copy)_3091861945227644945]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[AFV Groceries (copy)_3091861945227644946] / (SUM([cv_eur_pharmacies_wow]) / SUM([orders_succ_pharmacies_wow])) - 1' />
            </column>
            <column caption='AFV Pharma WoW Trend ' datatype='string' name='[AFV Groceries WoW Trend (copy)_3091861945227644947]' role='measure' type='nominal'>
