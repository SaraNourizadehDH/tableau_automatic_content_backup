            <column caption='% of resto orders with all basket incentives' datatype='real' default-format='p0%' name='[Calculation_1695394209572917248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([succesful_orders_incentives_food]) / SUM([succ_orders_food])' />
            </column>
            <column caption='Calendar week for filtering' datatype='datetime' name='[Calculation_4348225507491082241]' role='dimension' type='ordinal'>
