            </column>
            <column caption='Rests Below Comm Floor MP Color L28 ' datatype='string' name='[Rests Below Comm Floor OD Color L28 (copy)_1918885336505143314]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Rests Below Comm Floor OD L28D (copy)_1918885336505016337]*100 &lt; 15 THEN &apos;Gray&apos;&#10;ELSEIF [Rests Below Comm Floor OD L28D (copy)_1918885336505016337]*100 &gt;=15 AND [Rests Below Comm Floor OD L28D (copy)_1918885336505016337]*100 &lt; 30 THEN &apos;Light Red&apos;&#10;ELSEIF [Rests Below Comm Floor OD L28D (copy)_1918885336505016337]*100 &gt;=30 AND [Rests Below Comm Floor OD L28D (copy)_1918885336505016337]*100 &lt; 50 THEN &apos;Medium Red&apos;&#10;ELSEIF [Rests Below Comm Floor OD L28D (copy)_1918885336505016337]*100 &gt;= 50 THEN &apos;Dark Red&apos;&#10;END' />
            </column>
            <column caption='Rests Below Comm Floor MP L28D ' datatype='real' default-format='p0.0%' name='[Rests Below Comm Floor OD L28D (copy)_1918885336505016337]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rest_below_comm_floor_mp_sf_28d])/(IFNULL(SUM([mon_newly_signed_restaurants_mp_sf_28d]),0))' />
            </column>
            <column datatype='string' name='[Segment (copy)]' role='dimension' type='nominal'>
