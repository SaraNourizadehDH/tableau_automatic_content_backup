            <column caption='Restaurants Signed MTD Food' datatype='integer' name='[Restaurants Signed MTD (copy)_35114010589995021]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IFNULL([restaurants_new_online_mp_mtd_food],0)) + sum(IFNULL([restaurants_new_online_od_mtd_food],0))' />
