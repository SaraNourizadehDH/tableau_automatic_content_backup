      <column caption='Target Achieved RR LW Food' datatype='real' name='[Target Achieved RR LW (copy)_35114010597969937]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IFNULL([restaurants_new_online_mp_rr_lw_food],0)) + SUM(IFNULL([restaurants_new_online_od_rr_lw_food],0)))&#10;/ (SUM(IFNULL([restaurants_new_online_target_mp],0)) + SUM(IFNULL([restaurants_new_online_target_od],0)))' />
