            <column caption='Avg. Delivery Fee Drinks WoW ' datatype='real' default-format='p0.0%' name='[Avg. Delivery Fee Groceries WoW (copy)_3091861945228648471]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Avg. Delivery Fee Groceries (copy)_3091861945228648472] /  (SUM([delivery_fee_eur_sum_drinks_wow])/SUM([delivery_fee_eur_count_drinks_wow])) - 1' />
            </column>
