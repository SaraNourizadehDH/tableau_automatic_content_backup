          </datasources>
          <datasource-dependencies datasource='federated.1x0d0dz0mvxafa10k0g1v1o8302d'>
            <column caption='Group' datatype='string' name='[Calculation_3956834545939652608]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [segment] = &apos;Asia&apos; AND [management_entity] = &apos;Woowa&apos; THEN &apos;Woowa&apos;&#10;ELSEIF [segment] = &apos;Asia&apos; AND [management_entity] &lt;&gt; &apos;Woowa&apos;  THEN &apos;APAC&apos;&#10;ELSEIF [segment] = &apos;America&apos;   THEN &apos;LATAM&apos;&#10; ELSE [segment] END' />
            </column>
            <column caption='Orders RR YoY  Yearly' datatype='real' default-format='n#,##0.0&quot;%&quot;;-#,##0.0&quot;%&quot;' name='[Orders RR YoY  (copy)_3956834546278776846]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_rr_yearly]) / SUM([orders_last_year]) - 1' />
            </column>
            <column caption='RR Ord vs Bud Yearly' datatype='real' name='[RR Ord vs Bud (copy 4)_3956834546278313996]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders_rr_yearly]) / sum([orders_bud_y]) - 1' />
