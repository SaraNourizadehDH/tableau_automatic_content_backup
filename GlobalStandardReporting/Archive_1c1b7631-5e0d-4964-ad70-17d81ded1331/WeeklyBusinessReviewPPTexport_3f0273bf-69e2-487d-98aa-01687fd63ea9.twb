        <calculation class='tableau' formula='IF [Calculation_3564247273867292676] &lt; 0 THEN &apos;Negative&apos; ELSE &apos;Positive&apos; END' />
      </column>
      <column caption='RR Ord YoY Color' datatype='string' name='[RR Ord YoY (copy 2)_3564247273947045941]' role='measure' type='nominal'>
