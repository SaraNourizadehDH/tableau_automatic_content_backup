            </column>
            <column caption='Order Share Darkstores' datatype='real' name='[Calculation_5732660126773530667]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(orders_succ_darkstores) / SUM([orders_succ])' />
            </column>
            <column caption='Orders Darkstores WoW (%)' datatype='real' name='[Calculation_5732660126789251125]' role='measure' type='quantitative'>
