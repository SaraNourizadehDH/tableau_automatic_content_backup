      <column caption='Multiplier' datatype='real' name='[Calculation_3564247273924599850]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(total_cltv)&#10; /(SUM(IFNULL(marketing_costs_eur_monthly,0)) / SUM(IFNULL(acquisitions_marketing,0)))&#10;&#10;// total_cltv = cltv_10years' />
      </column>
      <column caption='Multiplier LW' datatype='real' hidden='true' name='[Calculation_3564247273925267501]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IFNULL(total_cltv_wow,0)) / SUM(IFNULL(cltv_acquisitions_wow,0)))&#10;    / (SUM(IFNULL(marketing_costs_eur_monthly_wow,0)) / SUM(IFNULL(acquisitions_marketing_wow,0)))' />
      </column>
      <column caption='Multiplier WoW' datatype='real' hidden='true' name='[Calculation_3564247273925566510]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3564247273924599850] - [Calculation_3564247273925267501]' />
