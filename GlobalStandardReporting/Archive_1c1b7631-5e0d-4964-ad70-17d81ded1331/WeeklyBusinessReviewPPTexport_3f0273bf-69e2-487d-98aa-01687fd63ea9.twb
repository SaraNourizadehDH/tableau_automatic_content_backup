          <datasource-dependencies datasource='federated.1x0d0dz0mvxafa10k0g1v1o8302d'>
            <column caption='Avg. Delivery Fee Coffee' datatype='real' name='[Avg. Delivery Fee Groceries (copy)_3091861945229234206]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_fee_eur_sum_coffee]) / SUM([delivery_fee_eur_count_coffee])' />
            </column>
            <column caption='Avg. Delivery Fee Coffee WoW ' datatype='real' default-format='p0.0%' name='[Avg. Delivery Fee Groceries WoW (copy)_3091861945229234205]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Avg. Delivery Fee Groceries (copy)_3091861945229234206] /  (SUM([delivery_fee_eur_sum_coffee_wow])/SUM([delivery_fee_eur_count_coffee_wow])) - 1' />
            </column>
            <column caption='Avg. Delivery Fee Coffee  WoW Trend' datatype='string' name='[Avg. Delivery Fee Groceries WoW Trend (copy)_3091861945229234207]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Avg. Delivery Fee Groceries WoW (copy)_3091861945229234205] &lt; 0 THEN &apos;Negative&apos; ELSE &apos;Positive&apos; END' />
            </column>
            <column caption='Calendar week for filtering' datatype='datetime' name='[Calculation_4348225507491082241]' role='dimension' type='ordinal'>
