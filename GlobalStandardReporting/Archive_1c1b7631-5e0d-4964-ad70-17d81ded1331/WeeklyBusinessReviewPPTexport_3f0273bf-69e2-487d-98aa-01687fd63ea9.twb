    <worksheet name='Group Acquisitions Monthly'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='6'>Orders</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='dwh_bl.tableau_weekly_performance_report' name='federated.1x0d0dz0mvxafa10k0g1v1o8302d' />
          </datasources>
          <datasource-dependencies datasource='federated.1x0d0dz0mvxafa10k0g1v1o8302d'>
            <column caption='Group' datatype='string' name='[Calculation_3956834545939652608]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [segment] = &apos;Asia&apos; AND [management_entity] = &apos;Woowa&apos; THEN &apos;Woowa&apos;&#10;ELSEIF [segment] = &apos;Asia&apos; AND [management_entity] &lt;&gt; &apos;Woowa&apos;  THEN &apos;APAC&apos;&#10;ELSEIF [segment] = &apos;America&apos;   THEN &apos;LATAM&apos;&#10; ELSE [segment] END' />
            </column>
            <column caption='Calendar week for filtering' datatype='datetime' name='[Calculation_4348225507491082241]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{max([calendar_week])}' />
            </column>
            <column caption='Last Week Filter' datatype='boolean' name='[Calculation_4348225507491762178]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[calendar_week] = [Calculation_4348225507491082241]' />
            </column>
            <column caption='Orders RR YoY ' datatype='real' default-format='n#,##0.0&quot;%&quot;;-#,##0.0&quot;%&quot;' name='[GMV RR YoY (%) (copy)_3956834546270752774]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([mon_orders_rr]) / SUM([mon_orders_rr_yoy]) - 1' />
            </column>
            <column caption='RR Acq YoY' datatype='real' name='[RR Ord YoY (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([mon_acquisitions_rr]) / sum([mon_acquisitions_rr_yoy]) -1' />
            </column>
            <column caption='RR Acq vs Bud' datatype='real' name='[RR Ord vs Bud (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([mon_acquisitions_rr]) / sum([mon_acquisitions_bud]) - 1' />
            </column>
            <column caption='RR Acq vs BE  ' datatype='real' default-format='p0.0%' name='[RR Orders vs BE  (copy)_3956834546271436808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([mon_acquisitions_rr]) / SUM(IFNULL([acquisitions_be_m], 0)) - 1' />
            </column>
            <column datatype='real' name='[acquisitions_be_m]' role='measure' type='quantitative' />
            <column caption='Calendar Week' datatype='datetime' datatype-customized='true' name='[calendar_week]' role='dimension' type='ordinal' />
            <column caption='Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column caption='Mon Acquisitions Bud' datatype='real' name='[mon_acquisitions_bud]' role='measure' type='quantitative' />
            <column caption='Mon Acquisitions Rr' datatype='real' name='[mon_acquisitions_rr]' role='measure' type='quantitative' />
            <column caption='Mon Acquisitions Rr Yoy' datatype='real' name='[mon_acquisitions_rr_yoy]' role='measure' type='quantitative' />
            <column caption='Mon Orders Rr' datatype='real' name='[mon_orders_rr]' role='measure' type='quantitative' />
            <column caption='Mon Orders Rr Yoy' datatype='real' name='[mon_orders_rr_yoy]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_3956834545939652608]' derivation='None' name='[none:Calculation_3956834545939652608:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_4348225507491762178]' derivation='None' name='[none:Calculation_4348225507491762178:nk]' pivot='key' type='nominal' />
            <column-instance column='[sub_entity]' derivation='None' name='[none:sub_entity:nk]' pivot='key' type='nominal' />
            <column caption='Segment' datatype='string' name='[segment]' role='dimension' type='nominal' />
