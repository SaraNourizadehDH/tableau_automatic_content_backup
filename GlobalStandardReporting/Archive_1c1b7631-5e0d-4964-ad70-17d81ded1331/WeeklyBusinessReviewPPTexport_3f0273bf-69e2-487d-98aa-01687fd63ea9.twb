    <worksheet name='Local Shops Avg DF Trend'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='9'>L5W Trend</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='dwh_bl.tableau_weekly_performance_report' name='federated.1x0d0dz0mvxafa10k0g1v1o8302d' />
          </datasources>
          <datasource-dependencies datasource='federated.1x0d0dz0mvxafa10k0g1v1o8302d'>
            <column caption='Avg. Delivery Fee Dmarts NV' datatype='real' name='[Avg. Delivery Fee Dmarts (copy)_5087660230672007169]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_fee_eur_sum_new_verticals]) / SUM([delivery_fee_eur_count_new_verticals])' />
            </column>
            <column caption='&quot;L5W Trend&quot;' datatype='string' name='[Calculation_197102867490574343]' role='dimension' type='nominal' user:unnamed='Affordablity Avg Delivery Fee Sparkline'>
