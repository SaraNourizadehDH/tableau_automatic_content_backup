    <worksheet name='Choice Sales Performance 2 Food (3)'>
      <table>
        <view>
          <datasources>
            <datasource caption='dwh_bl.tableau_weekly_performance_report (3)' name='federated.1x0d0dz0mvxafa10k0g1v1o8302d (copy 2)' />
          </datasources>
          <datasource-dependencies datasource='federated.1x0d0dz0mvxafa10k0g1v1o8302d (copy 2)'>
            <column caption='ATTR(1)' datatype='integer' name='[Calculation_33425187549245443]' role='measure' type='quantitative' user:unnamed='Choice Sales Performance 2 Food'>
              <calculation class='tableau' formula='ATTR(1)' />
            </column>
            <column caption='ATTR(1)' datatype='integer' name='[Calculation_33425187549294597]' role='measure' type='quantitative' user:unnamed='Choice Sales Performance 2 Food'>
              <calculation class='tableau' formula='ATTR(1)' />
            </column>
            <column caption='Calendar week for filtering' datatype='datetime' name='[Calculation_4348225507491082241]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{max([calendar_week])}' />
            </column>
            <column caption='Last Week Filter' datatype='boolean' name='[Calculation_4348225507491762178]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[calendar_week] = [Calculation_4348225507491082241]' />
            </column>
            <column caption='Target Achieved RR' datatype='real' name='[Calculation_5732660126482817027]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IFNULL([mon_restaurants_new_online_mp_rr],0)) + SUM(IFNULL([mon_restaurants_new_online_od_rr],0)))&#10;/ (SUM(IFNULL([restaurants_new_online_target],0)))' />
            </column>
            <column caption='Attr (1)' datatype='integer' name='[Calculation_6376182346401984512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Entity ' datatype='string' name='[Entity (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[management_entity]' new-bin='true'>
                <bin default-name='false' value='&quot;Pandora&quot;'>
                  <value>&quot;DH Austria&quot;</value>
                  <value>&quot;DH CEE&quot;</value>
                  <value>&quot;DH Nordics&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='Restaurants Signed MTD Food' datatype='integer' name='[Restaurants Signed MTD (copy)_35114010589995021]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IFNULL([restaurants_new_online_mp_mtd_food],0)) + sum(IFNULL([restaurants_new_online_od_mtd_food],0))' />
            </column>
            <column datatype='string' name='[Segment (copy)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[segment]' />
