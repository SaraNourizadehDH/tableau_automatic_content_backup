              <calculation class='tableau' formula='SUM(restaurants_online_od_food) / [Restaurants Online Total (copy)_35114010580267008]' />
            </column>
            <column caption='Restaurants Online Total Food' datatype='integer' name='[Restaurants Online Total (copy)_35114010580267008]' role='measure' type='quantitative'>
