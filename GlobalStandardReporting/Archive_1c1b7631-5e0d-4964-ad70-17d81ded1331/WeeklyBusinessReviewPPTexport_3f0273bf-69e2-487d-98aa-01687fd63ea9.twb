        <view>
          <datasources>
            <datasource caption='dwh_bl.tableau_weekly_performance_report (2)' name='federated.1x0d0dz0mvxafa10k0g1v1o8302d (copy)' />
          </datasources>
          <datasource-dependencies datasource='federated.1x0d0dz0mvxafa10k0g1v1o8302d (copy)'>
            <column caption='AFV Food' datatype='real' name='[AFV (copy)_1918885336703586350]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gbv_eur_food]) / IFNULL(SUM([succ_orders_food]), 0)' />
            </column>
            <column caption='AFV 28d Food' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[AFV 28d (copy)_1918885336703270957]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([gbv_eur_food_28_d]))/SUM(IFNULL([succ_orders_food_28_d],0))' />
            </column>
            <column caption='AFV Food M' datatype='real' name='[AFV Food (copy)_4516547481019699201]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cv_eur_food_m]) / IFNULL(SUM([succ_orders_food_m]), 0)' />
            </column>
            <column caption='AFV Target' datatype='real' name='[Calculation_3375236880116699149]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IFNULL([od_restaurant_gfv_bud_m],0))+SUM(IFNULL([mp_restaurant_gfv_bud_m],0))) / (SUM(IFNULL([od_restaurant_orders_bud_m],0)) + SUM(IFNULL([mp_restaurant_orders_bud_m],0)))' />
            </column>
            <column caption='AFV Food Actual vs Target' datatype='real' name='[Calculation_3375236880116977678]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[AFV Food (copy)_4516547481019699201] - [Calculation_3375236880116699149]' />
            </column>
            <column caption='AFV Food Actual vs Target Color' datatype='string' name='[Calculation_3375236880119431184]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_3375236880116977678] &lt; 0 THEN &apos;Red&apos; ELSE &apos;Gray&apos; END' />
            </column>
            <column caption='Calendar week for filtering' datatype='datetime' name='[Calculation_4348225507491082241]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{max([calendar_week])}' />
