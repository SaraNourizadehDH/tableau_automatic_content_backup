              <calculation class='tableau' formula='IF [Fail Rate OD (copy)_5732660126495182873] &lt; 0.02 THEN &apos;Gray&apos;&#10;ELSEIF [Fail Rate OD (copy)_5732660126495182873] &gt;= 0.02 AND [Fail Rate OD (copy)_5732660126495182873] &lt;= 0.04 THEN &apos;Light Red&apos;&#10;ELSEIF [Fail Rate OD (copy)_5732660126495182873]&gt;0.04 AND [Fail Rate OD (copy)_5732660126495182873] &lt;=0.05 THEN &apos;Medium Red&apos;&#10;ELSEIF ISNULL([Fail Rate OD (copy)_5732660126495182873]) THEN &apos;Gray&apos;&#10;ELSE &apos;Dark Red&apos;&#10;END' />
            </column>
            <column caption='Fail Rate MP' datatype='real' name='[Fail Rate OD (copy)_5732660126495182873]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_fail_mp]) / SUM(IFNULL([orders_total_mp],0))' />
