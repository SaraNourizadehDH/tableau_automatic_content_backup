      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='dwh_bl.tableau_weekly_performance_report' name='federated.1x0d0dz0mvxafa10k0g1v1o8302d' />
          </datasources>
          <datasource-dependencies datasource='federated.1x0d0dz0mvxafa10k0g1v1o8302d'>
            <column caption='rest below comm floor color od' datatype='string' name='[Calculation_1856679358105645057]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if ISNULL(SUM([rest_below_comm_floor_od_sf])) THEN &apos;No Data&apos;&#10;ELSEIF NOT ISNULL(SUM([rest_below_comm_floor_od_sf])) THEN &apos;With Data&apos;&#10;END' />
            </column>
            <column caption='Calendar week for filtering' datatype='datetime' name='[Calculation_4348225507491082241]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{max([calendar_week])}' />
            </column>
            <column caption='Last Week Filter' datatype='boolean' name='[Calculation_4348225507491762178]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[calendar_week] = [Calculation_4348225507491082241]' />
            </column>
            <column caption='Attr (1)' datatype='integer' name='[Calculation_6376182346401984512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Entity ' datatype='string' name='[Entity (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[management_entity]' new-bin='true'>
                <bin default-name='false' value='&quot;Pandora&quot;'>
                  <value>&quot;DH Austria&quot;</value>
                  <value>&quot;DH CEE&quot;</value>
                  <value>&quot;DH Nordics&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='Rests Below Comm Floor OD L28D' datatype='real' default-format='p0.0%' name='[Rests Below Comm Floor OD (copy)_1918885336504135695]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rest_below_comm_floor_od_sf_28d])/(IFNULL(SUM([mon_newly_signed_restaurants_od_sf_28d]),0))' />
            </column>
            <column caption='Rests Below Comm Floor OD Color L28' datatype='string' name='[Rests Below Comm Floor OD Color (copy)_1918885336504500240]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Rests Below Comm Floor OD (copy)_1918885336504135695]*100 &lt; 15 THEN &apos;Gray&apos;&#10;ELSEIF [Rests Below Comm Floor OD (copy)_1918885336504135695]*100 &gt;=15 AND [Rests Below Comm Floor OD (copy)_1918885336504135695]*100 &lt; 30 THEN &apos;Light Red&apos;&#10;ELSEIF [Rests Below Comm Floor OD (copy)_1918885336504135695]*100 &gt;=30 AND [Rests Below Comm Floor OD (copy)_1918885336504135695]*100 &lt; 50 THEN &apos;Medium Red&apos;&#10;ELSEIF [Rests Below Comm Floor OD (copy)_1918885336504135695]*100 &gt;= 50 THEN &apos;Dark Red&apos;&#10;END' />
            </column>
            <column datatype='string' name='[Segment (copy)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[segment]' />
            </column>
