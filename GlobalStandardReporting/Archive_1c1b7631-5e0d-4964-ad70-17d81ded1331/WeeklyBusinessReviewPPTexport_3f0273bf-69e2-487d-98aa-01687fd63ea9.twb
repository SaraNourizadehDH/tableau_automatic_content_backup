          <datasource-dependencies datasource='federated.1x0d0dz0mvxafa10k0g1v1o8302d'>
            <column caption='Avg. Delivery Fee Pharma' datatype='real' name='[Avg. Delivery Fee Groceries (copy)_3091861945228886043]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_fee_eur_sum_pharmacies]) / SUM([delivery_fee_eur_count_pharmacies])' />
            </column>
            <column caption='Avg. Delivery Fee Pharma WoW ' datatype='real' default-format='p0.0%' name='[Avg. Delivery Fee Groceries WoW (copy)_3091861945228886042]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Avg. Delivery Fee Groceries (copy)_3091861945228886043] /  (SUM([delivery_fee_eur_sum_pharmacies_wow])/SUM([delivery_fee_eur_count_pharmacies_wow])) - 1' />
            </column>
            <column caption='Avg. Delivery Fee Pharma WoW Trend ' datatype='string' name='[Avg. Delivery Fee Groceries WoW Trend (copy)_3091861945228886044]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Avg. Delivery Fee Groceries WoW (copy)_3091861945228886042] &lt; 0 THEN &apos;Negative&apos; ELSE &apos;Positive&apos; END' />
