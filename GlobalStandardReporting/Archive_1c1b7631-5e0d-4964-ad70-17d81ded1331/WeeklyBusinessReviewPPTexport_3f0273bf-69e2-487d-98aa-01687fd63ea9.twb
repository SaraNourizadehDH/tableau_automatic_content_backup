          <datasource-dependencies datasource='federated.1x0d0dz0mvxafa10k0g1v1o8302d'>
            <column caption='rest below comm floor color od' datatype='string' name='[Calculation_1856679358105645057]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if ISNULL(SUM([rest_below_comm_floor_od_sf])) THEN &apos;No Data&apos;&#10;ELSEIF NOT ISNULL(SUM([rest_below_comm_floor_od_sf])) THEN &apos;With Data&apos;&#10;END' />
            </column>
            <column caption='Calendar week for filtering' datatype='datetime' name='[Calculation_4348225507491082241]' role='dimension' type='ordinal'>
