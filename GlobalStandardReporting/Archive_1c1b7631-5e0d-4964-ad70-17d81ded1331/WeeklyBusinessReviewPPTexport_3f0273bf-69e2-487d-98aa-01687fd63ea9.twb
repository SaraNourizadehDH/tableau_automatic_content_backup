    <worksheet name='SOE OD Fail Rate (4)'>
      <table>
        <view>
          <datasources>
            <datasource caption='dwh_bl.tableau_weekly_performance_report' name='federated.1x0d0dz0mvxafa10k0g1v1o8302d' />
          </datasources>
          <datasource-dependencies datasource='federated.1x0d0dz0mvxafa10k0g1v1o8302d'>
            <column caption='Fail Rate OD 28D Color' datatype='string' name='[Calculation_1508002201598623747]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_5732660126494093332] &lt; 0.02 THEN &apos;Gray&apos;&#10;ELSEIF [Calculation_5732660126494093332] &gt;= 0.02 AND [Calculation_5732660126494093332] &lt;= 0.04 THEN &apos;Light Red&apos;&#10;ELSEIF [Calculation_5732660126494093332] &gt;0.04 AND [Calculation_5732660126494093332] &lt;=0.05 THEN &apos;Medium Red&apos;&#10;ELSEIF ISNULL([Calculation_5732660126494093332]) THEN &apos;Gray&apos;&#10;ELSE &apos;Dark Red&apos;&#10;END' />
            </column>
            <column caption='Calendar week for filtering' datatype='datetime' name='[Calculation_4348225507491082241]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{max([calendar_week])}' />
            </column>
            <column caption='Last Week Filter' datatype='boolean' name='[Calculation_4348225507491762178]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[calendar_week] = [Calculation_4348225507491082241]' />
            </column>
            <column caption='Fail Rate OD 28 D' datatype='real' name='[Calculation_5732660126494093332]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(orders_fail_od_28_d) / SUM(IFNULL(orders_total_od_28_d,0))' />
            </column>
            <column caption='Fail Rate OD' datatype='real' name='[Calculation_5732660126494502933]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(orders_fail_od) / SUM(IFNULL(orders_total_od,0))' />
            </column>
            <column caption='Attr (1)' datatype='integer' name='[Calculation_6376182346401984512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Entity ' datatype='string' name='[Entity (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[management_entity]' new-bin='true'>
                <bin default-name='false' value='&quot;Pandora&quot;'>
                  <value>&quot;DH Austria&quot;</value>
                  <value>&quot;DH CEE&quot;</value>
                  <value>&quot;DH Nordics&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='Fail Rate OD  Color ' datatype='string' name='[Fail Rate OD 28D Color (copy)_1508002201609723910]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_5732660126494502933] &lt; 0.02 THEN &apos;Gray&apos;&#10;ELSEIF [Calculation_5732660126494502933] &gt;= 0.02 AND [Calculation_5732660126494502933] &lt;= 0.04 THEN &apos;Light Red&apos;&#10;ELSEIF [Calculation_5732660126494502933]&gt;0.04 AND [Calculation_5732660126494502933] &lt;=0.05 THEN &apos;Medium Red&apos;&#10;ELSEIF ISNULL([Calculation_5732660126494502933]) THEN &apos;Gray&apos;&#10;ELSE &apos;Dark Red&apos;&#10;END' />
            </column>
