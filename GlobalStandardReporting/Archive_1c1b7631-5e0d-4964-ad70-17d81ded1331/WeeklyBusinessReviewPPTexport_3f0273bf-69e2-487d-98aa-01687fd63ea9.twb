    <worksheet name='AFV Drinks'>
      <table>
        <view>
          <datasources>
            <datasource caption='dwh_bl.tableau_weekly_performance_report' name='federated.1x0d0dz0mvxafa10k0g1v1o8302d' />
          </datasources>
          <datasource-dependencies datasource='federated.1x0d0dz0mvxafa10k0g1v1o8302d'>
            <column caption='AFV Drinks' datatype='real' name='[AFV Groceries (copy)_3091861945227100172]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cv_eur_drinks]) / SUM([orders_succ_drinks])' />
            </column>
            <column caption='AFV Drinks WoW ' datatype='real' default-format='p0.0%' name='[AFV Groceries WoW (copy)_3091861945227100171]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[AFV Groceries (copy)_3091861945227100172] / (SUM([cv_eur_drinks_wow]) / SUM([orders_succ_drinks_wow])) - 1' />
            </column>
            <column caption='AFV Drinks WoW Trend ' datatype='string' name='[AFV Groceries WoW Trend (copy)_3091861945227100173]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [AFV Groceries WoW (copy)_3091861945227100171] &lt; 0 THEN &apos;Negative&apos; ELSE &apos;Positive&apos; END' />
            </column>
            <column caption='Calendar week for filtering' datatype='datetime' name='[Calculation_4348225507491082241]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{max([calendar_week])}' />
            </column>
            <column caption='Last Week Filter' datatype='boolean' name='[Calculation_4348225507491762178]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[calendar_week] = [Calculation_4348225507491082241]' />
            </column>
            <column caption='Attr (1)' datatype='integer' name='[Calculation_6376182346401984512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Entity ' datatype='string' name='[Entity (group)]' role='dimension' type='nominal'>
