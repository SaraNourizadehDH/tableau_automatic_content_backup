        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1uo5g1006xnegg1e8v3wm15cxxtq' name='Custom SQL Query' type='text'>WITH x AS 
(
SELECT 
DISTINCT
REPLACE(e.DataLevelName,&apos;Best Estimate&apos;,&apos;&apos;) as DataLevelName
    FROM `int-per-data-team.lucanet.ln_s3_facts` a
LEFT JOIN `int-per-data-team.lucanet.ln_s3_data_level` e
    ON CAST(e.DataLevelID AS STRING) = a.DataLevelID
WHERE a.value is not null 
AND e.DataLevelName LIKE &apos;Best%&apos;
AND a.DisplayCurrency NOT IN (&apos;EUR YTD&apos;)
AND e.DataLevelID = 
(
  SELECT 
MAX(e.DataLevelID) as latestBE
    FROM `int-per-data-team.lucanet.ln_s3_facts` a
LEFT JOIN `int-per-data-team.lucanet.ln_s3_data_level` e
    ON CAST(e.DataLevelID AS STRING) = a.DataLevelID
WHERE a.value is not null 
AND e.DataLevelName LIKE &apos;Best%&apos;
AND a.DisplayCurrency NOT IN (&apos;EUR YTD&apos;)
)
)
SELECT DataLevelName FROM x</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
