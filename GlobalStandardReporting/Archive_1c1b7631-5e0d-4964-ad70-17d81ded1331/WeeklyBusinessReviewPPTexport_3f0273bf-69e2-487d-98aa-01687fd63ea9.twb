    <worksheet name='Affordability Avg Delivery Fee (2)'>
      <table>
        <view>
          <datasources>
            <datasource caption='dwh_bl.tableau_weekly_performance_report (2)' name='federated.1x0d0dz0mvxafa10k0g1v1o8302d (copy)' />
          </datasources>
          <datasource-dependencies datasource='federated.1x0d0dz0mvxafa10k0g1v1o8302d (copy)'>
            <column caption='Avg. Delivery Fee Food OD' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg. Delivery Fee Food (copy)_1918885336850231352]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_fee_eur_sum_food_od]) / SUM([delivery_fee_eur_count_food_od])' />
            </column>
            <column caption='Avg. Delivery Fee Food 28D OD' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg. Delivery Fee Food 28D (copy)_1918885336850006071]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_fee_eur_sum_food_od_28_d]) / SUM([delivery_fee_eur_count_food_od_28_d])' />
            </column>
            <column caption='Avg. Delivery Fee Food OD M' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg. Delivery Fee Food OD (copy)_4516547481018839040]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_fee_eur_sum_food_od_m]) / SUM([delivery_fee_eur_count_food_od_m])' />
            </column>
            <column caption='ATTR(1)' datatype='integer' name='[Calculation_3375236880076124166]' role='measure' type='quantitative' user:unnamed='Affordability Avg Delivery Fee'>
              <calculation class='tableau' formula='ATTR(1)' />
            </column>
            <column caption='ATTR(1)' datatype='integer' name='[Calculation_3375236880076156936]' role='measure' type='quantitative' user:unnamed='Affordability Avg Delivery Fee'>
              <calculation class='tableau' formula='ATTR(1)' />
            </column>
            <column caption='L28D DF/AOV OD' datatype='real' name='[Calculation_3375236880086122505]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Avg. Delivery Fee Food 28D (copy)_1918885336850006071] / (SUM([amt_gmv_eur_od_food_28_d])/SUM([succ_orders_food_od_28_d]))' />
            </column>
            <column caption='Delivery Fee Target OD' datatype='real' name='[Calculation_3375236880120606737]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([od_restaurant_delivery_fees_bud_m]) / SUM([od_restaurant_orders_bud_m])' />
            </column>
            <column caption='Delivery Fee Actual vs Target OD' datatype='real' name='[Calculation_3375236880120991762]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Avg. Delivery Fee Food OD (copy)_4516547481018839040] -  [Calculation_3375236880120606737]' />
            </column>
            <column caption='Calendar week for filtering' datatype='datetime' name='[Calculation_4348225507491082241]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{max([calendar_week])}' />
            </column>
            <column caption='Last Week Filter' datatype='boolean' name='[Calculation_4348225507491762178]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[calendar_week] = [Calculation_4348225507491082241]' />
            </column>
            <column caption='Attr (1)' datatype='integer' name='[Calculation_6376182346401984512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Delivery Fee Actual vs Target OD Color' datatype='string' name='[Delivery Fee Actual vs Target OD (copy)_3375236880121282579]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_3375236880120991762] &lt; 0 THEN &apos;Red&apos; ELSE &apos;Gray&apos; END' />
            </column>
            <column caption='Entity ' datatype='string' name='[Entity (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[management_entity]' new-bin='true'>
                <bin default-name='false' value='&quot;Pandora&quot;'>
                  <value>&quot;DH Austria&quot;</value>
                  <value>&quot;DH CEE&quot;</value>
                  <value>&quot;DH Nordics&quot;</value>
                </bin>
              </calculation>
            </column>
            <column datatype='string' name='[Segment (copy)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[segment]' />
            </column>
            <column datatype='real' name='[amt_gmv_eur_od_food_28_d]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_6376182346401984512]' derivation='Attribute' name='[attr:Calculation_6376182346401984512:qk]' pivot='key' type='quantitative' />
            <column caption='Calendar Week' datatype='datetime' datatype-customized='true' name='[calendar_week]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[delivery_fee_eur_count_food_od]' role='measure' type='quantitative' />
            <column datatype='integer' name='[delivery_fee_eur_count_food_od_28_d]' role='measure' type='quantitative' />
