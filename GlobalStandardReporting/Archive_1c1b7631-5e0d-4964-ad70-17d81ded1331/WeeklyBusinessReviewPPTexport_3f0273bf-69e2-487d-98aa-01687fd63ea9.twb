            <column caption='GMV Eur' datatype='real' name='[Calculation_3564247273894346769]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([gmv_eur_mp],0)) + SUM(IFNULL([gmv_eur_od],0))' />
            </column>
