            <connection CATALOG='int-per-data-team' EXECCATALOG='int-per-data-team' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='Int-Per-Data-Team' schema='lucanet' server-oauth='' username='radu.maftei@deliveryhero.com' workgroup-auth-mode='prompt' />
