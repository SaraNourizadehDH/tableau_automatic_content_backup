    <worksheet name='RR Orders (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='9'>Orders </run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='7'>(&apos;000)</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='dwh_bl.tableau_weekly_performance_report (2)' name='federated.1x0d0dz0mvxafa10k0g1v1o8302d (copy)' />
          </datasources>
          <datasource-dependencies datasource='federated.1x0d0dz0mvxafa10k0g1v1o8302d (copy)'>
            <column caption='Orders WoW (%)' datatype='real' name='[Calculation_2125276823239274502]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND((SUM(orders_succ) / SUM(IFNULL(orders_succ_wow, 0)) - 1) * 100,1)' />
            </column>
            <column caption='Orders WoW Color' datatype='string' name='[Calculation_2125276823240019975]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_2125276823239274502] &lt; 0 THEN &apos;Negative&apos; ELSE &apos;Positive&apos; END' />
            </column>
            <column caption='Orders Voucher Share (%)' datatype='real' name='[Calculation_3564247273865674755]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(orders_voucher) / SUM(IFNULL(orders_succ, 0)) * 100' />
            </column>
            <column caption='RR Ord vs Bud Color' datatype='string' name='[Calculation_3564247273956843575]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_4348225507495657475] &lt; 0 THEN &apos;Negative&apos; ELSE &apos;Positive&apos; END' />
            </column>
            <column caption='Calendar week for filtering' datatype='datetime' name='[Calculation_4348225507491082241]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{max([calendar_week])}' />
            </column>
            <column caption='Last Week Filter' datatype='boolean' name='[Calculation_4348225507491762178]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[calendar_week] = [Calculation_4348225507491082241]' />
            </column>
            <column caption='RR Ord vs Bud' datatype='real' name='[Calculation_4348225507495657475]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([mon_orders_rr]) / sum([mon_orders_bud]) - 1' />
            </column>
            <column caption='RR Ord YoY' datatype='real' name='[Calculation_6353242135795662848]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([mon_orders_rr]) / sum([mon_orders_rr_yoy]) -1' />
            </column>
            <column caption='Attr (1)' datatype='integer' name='[Calculation_6376182346401984512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Entity ' datatype='string' name='[Entity (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[management_entity]' new-bin='true'>
                <bin default-name='false' value='&quot;Pandora&quot;'>
                  <value>&quot;DH Austria&quot;</value>
                  <value>&quot;DH CEE&quot;</value>
                  <value>&quot;DH Nordics&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='RR Ord YoY Color' datatype='string' name='[RR Ord YoY (copy 2)_3564247273947045941]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_6353242135795662848] &lt; 0 THEN &apos;Negative&apos; ELSE &apos;Positive&apos; END' />
            </column>
            <column caption='RR Ord vs Bud (diff)' datatype='real' name='[RR Ord vs Bud (copy 2)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([mon_orders_rr]) - sum([mon_orders_bud])' />
            </column>
            <column datatype='string' name='[Segment (copy)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[segment]' />
