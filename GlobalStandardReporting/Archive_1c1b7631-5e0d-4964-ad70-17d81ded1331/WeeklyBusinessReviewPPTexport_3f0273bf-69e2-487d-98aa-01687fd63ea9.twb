              <calculation class='tableau' formula='[Calculation_4029525406744764419] / [UTR 28D (copy)_5732660126525775909]' />
            </column>
            <column caption='&quot;L5W Trend&quot;' datatype='string' name='[Calculation_197102867493052441]' role='dimension' type='nominal' user:unnamed='Speed DT Average Sparkline 5 Weeks'>
              <calculation class='tableau' formula='&quot;L5W Trend&quot;' />
            </column>
            <column caption='AVG DT' datatype='real' name='[Calculation_4029525406744764419]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([delivery_time_m_sum])/sum([delivery_time_m_count])' />
