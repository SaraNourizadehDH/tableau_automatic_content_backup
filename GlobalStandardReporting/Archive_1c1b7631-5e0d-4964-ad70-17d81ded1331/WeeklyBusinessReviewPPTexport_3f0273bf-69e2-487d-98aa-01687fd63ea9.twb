      <aliases enabled='yes' />
      <column caption='% 3M LW' datatype='real' hidden='true' name='[% 3M (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([restaurants_online_new_3m_good_wow])/sum([restaurants_online_new_3m_wow])' />
      </column>
      <column caption='% Calls Chats (30s) Shape' datatype='integer' hidden='true' name='[% Calls Chats (30s) (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_6871507937005486092] &lt; [Parameters].[Voucher Acquisitions Threshold (copy)] then 1 end' />
      </column>
      <column caption='% Deals Orders NV' datatype='real' default-format='p0.0%' name='[% Deals Orders Darkstore (copy)_1508002201973473305]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_succ_new_verticals_deals_dh]) / SUM([orders_succ_new_verticals])' />
      </column>
      <column caption='% Hard fail rate LW' datatype='real' default-format='p0.0%' hidden='true' name='[% Hard fail rate (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([orders_fail_wow])/SUM([orders_total_wow])' />
      </column>
      <column caption='% Restos W\O  LW' datatype='real' hidden='true' name='[% Restos W\O  (copy 2)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([restaurants_online_zero_orders_wow]) / sum([restaurants_online_wow])' />
      </column>
      <column caption='% Restos W\O  Mon' datatype='real' hidden='true' name='[% Restos W\O  (copy 3)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([restaurants_online_zero_orders_monthly]) / ([Calculation_825636476500873216])' />
      </column>
      <column caption='% Restos W\O  Shape' datatype='integer' hidden='true' name='[% Restos W\O  (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_825636476542877701] &gt; [Parameters].[Voucher Acquisitions Threshold (copy 2)] then 1 end' />
      </column>
      <column caption='% Restos W\O  WoW' datatype='real' hidden='true' name='[% Restos W\O  LW (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_825636476542877701] - [% Restos W\O  (copy 2)])*100' />
      </column>
      <column caption='% Restos W\O  LM' datatype='real' hidden='true' name='[% Restos W\O  Mon (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(restaurants_online_zero_orders_monthly_wow) / [Total Res Online Monthly (copy)]' />
      </column>
      <column caption='% Restos W\O  Mon Shape' datatype='integer' hidden='true' name='[% Restos W\O  Shape (copy 2)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [% Restos W\O  (copy 3)] &gt; [Parameters].[Restos W\O Threshold (copy 3)] then 1 end' />
      </column>
      <column caption='% Orders D Restos Shape' datatype='integer' name='[% Restos W\O  Shape (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_830210451929882625] &gt; [Parameters].[Restos W\O Threshold (copy 2)]  then 1 end' />
      </column>
      <column caption='% Restos W\O  MoM' datatype='real' hidden='true' name='[% Restos W\O  WoW (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([% Restos W\O  (copy 3)] - [% Restos W\O  Mon (copy)])*100' />
      </column>
      <column caption='% of resto orders with VFI basket incentives ' datatype='real' default-format='p0%' name='[% of resto orders with DH basket incentives (copy)_1695394210194874370]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([succesful_orders_incentives_other_food]) / SUM([succ_orders_food])' />
      </column>
      <column caption='% of resto  with VFI ' datatype='real' default-format='p0%' name='[% of resto orders with VFI basket incentives  (copy)_1695394210208989187]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([restaurants_online_vfi_incentives_food]) / (SUM([restaurants_online_od_food]) + SUM([restaurants_online_mp_food]))' />
      </column>
      <column caption='Avg. resto DH funded incentive (EUR)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[% of resto orders with VFI basket incentives  (copy)_1695394210210447364]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IFNULL([amt_discount_eur_dh_food],0))+SUM(IFNULL([amt_voucher_eur_dh_food],0))) / SUM([succesful_orders_incentives_dh_food])' />
      </column>
      <column caption='% of resto orders with DH basket incentives' datatype='real' default-format='p0%' name='[% of resto orders with all basket incentives (copy)_1695394210172715009]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([succesful_orders_incentives_dh_food]) / SUM([succ_orders_food])' />
      </column>
      <column caption='Well Dispatched %' datatype='real' hidden='true' name='[9C % (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([orders_well_dispatched])/sum([orders_total])' />
      </column>
