    <worksheet name='RR GMV (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='9'>GMV </run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='7'>(&apos;000)</run>
            <run fontalignment='1'>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='dwh_bl.tableau_weekly_performance_report (2)' name='federated.1x0d0dz0mvxafa10k0g1v1o8302d (copy)' />
          </datasources>
          <datasource-dependencies datasource='federated.1x0d0dz0mvxafa10k0g1v1o8302d (copy)'>
            <column caption='GMV Eur' datatype='real' name='[Calculation_3564247273894346769]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([gmv_eur_mp],0)) + SUM(IFNULL([gmv_eur_od],0))' />
            </column>
            <column caption='GMV WoW (%)' datatype='real' name='[Calculation_3564247273895415827]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3564247273894346769] / [GMV Eur (copy)_3564247273895338002] - 1' />
            </column>
            <column caption='GMV WoW (%) Color' datatype='string' name='[Calculation_3564247273895919636]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_3564247273895415827] &lt; 0 THEN &apos;Negative&apos; ELSE &apos;Positive&apos; END' />
            </column>
            <column caption='GMV vs BDG ' datatype='real' name='[Calculation_3564247273898360855]' role='measure' type='quantitative'>
