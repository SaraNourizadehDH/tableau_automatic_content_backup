            <column caption='VFI Funded incentives as % of total resto GMV' datatype='real' default-format='p0.0%' name='[DH Funded incentives as % of total resto GMV (copy)_1695394210239549465]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IFNULL([amt_discount_eur_other_food],0)) &#10;+ SUM(IFNULL([amt_voucher_eur_other_food],0))) / SUM(IFNULL([gmv_eur_food],0))' />
