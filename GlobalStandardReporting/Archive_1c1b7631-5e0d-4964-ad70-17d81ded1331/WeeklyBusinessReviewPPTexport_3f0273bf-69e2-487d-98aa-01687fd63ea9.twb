      <column caption='Target Achieved WoW RR Color NV' datatype='string' name='[Target Achieved WoW RR Color (copy)_35114010602184730]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Target Achived RR WoW Food (copy)_35114010601201686]) THEN &apos;No Data&apos; ELSE &apos;With Data&apos; END' />
      </column>
      <column caption='Target Achived RR WoW Food' datatype='real' default-format='p0.0%' name='[Target Achived RR WoW (copy)_35114010597920784]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Target Achieved RR LW (copy)_35114010597969937] - [Target Achieved RR 2 Weeks ago (copy)_35114010598424594]' />
