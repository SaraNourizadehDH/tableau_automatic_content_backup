            <column caption='Target Achieved RR' datatype='real' name='[Calculation_5732660126482817027]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IFNULL([mon_restaurants_new_online_mp_rr],0)) + SUM(IFNULL([mon_restaurants_new_online_od_rr],0)))&#10;/ (SUM(IFNULL([restaurants_new_online_target],0)))' />
            </column>
            <column caption='Attr (1)' datatype='integer' name='[Calculation_6376182346401984512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Entity ' datatype='string' name='[Entity (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[management_entity]' new-bin='true'>
