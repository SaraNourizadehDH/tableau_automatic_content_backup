            </column>
            <column caption='Target Achieved RR' datatype='real' name='[Calculation_5732660126482817027]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IFNULL([mon_restaurants_new_online_mp_rr],0)) + SUM(IFNULL([mon_restaurants_new_online_od_rr],0)))&#10;/ (SUM(IFNULL([restaurants_new_online_target],0)))' />
            </column>
