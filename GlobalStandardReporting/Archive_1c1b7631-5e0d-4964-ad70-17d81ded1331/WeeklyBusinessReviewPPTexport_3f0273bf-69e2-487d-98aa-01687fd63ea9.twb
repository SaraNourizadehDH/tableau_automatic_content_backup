      <column caption='NPS L28 OD Food' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1918885336482377728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([nps_ao_promoters_28_d_food_od])-SUM([nps_ao_detractors_28_d_food_od]))/SUM([nps_ao_responses_28_d_food_od])*100' />
      </column>
      <column caption='NPS AC 28D' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1918885336485752841]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([nps_promoters_ac28d]) - SUM([nps_detractors_ac28d])) / SUM([nps_responses_ac28d])*100' />
      </column>
      <column caption='LN CR 1 Actuals' datatype='real' default-format='p0.0%' name='[Calculation_1918885336507928597]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([lucanet_od_restaurant_comission]) / SUM([lucanet_od_restaurant_gfv_sales_definition_cr_base])' />
      </column>
      <column caption='LN CR 1 Budget' datatype='real' name='[Calculation_1918885336509702171]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([od_restaurant_commission_m]) / SUM([od_restaurant_gfv_sales_definition_cr_base_m])' />
      </column>
      <column caption='LN Delta CR1' datatype='real' default-format='p0.0%' name='[Calculation_1918885336510603293]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1918885336507928597] - [Calculation_1918885336509702171]' />
      </column>
      <column caption='LN Delta CR2' datatype='real' default-format='p0.0%' name='[Calculation_1918885336510672926]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[LN CR 1 (copy)_1918885336508346390] -  [LN CR 2 Actuals (copy)_1918885336510427164]' />
      </column>
      <column caption='NCR as % of GMV(restos) W-1' datatype='real' default-format='p0.0%' name='[Calculation_1918885336695345193]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([amt_premium_fee_food]) + SUM([amt_joker_eur_food])) / SUM([gmv_eur_food])' />
      </column>
      <column caption='AO NPS L28 Color' datatype='string' name='[Calculation_1918885336781701173]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1918885336482377728] &lt; [NPS L28 OD Food (copy)_1918885336483319809] THEN &apos;Red&apos; ELSE &apos;Gray&apos; END' />
      </column>
      <column caption='Restaurants Online 28D' datatype='integer' name='[Calculation_1918885336800219190]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([restaurants_online_od_28d])+SUM(restaurants_online_mp_28d)' />
      </column>
      <column caption='Target Achieved WoW RR Color' datatype='string' name='[Calculation_1943021810009264128]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Calculation_3360318685446705155]) THEN &apos;No Data&apos; ELSE &apos;With Data&apos; END' />
      </column>
      <column caption='Contact Cost Condition' datatype='real' name='[Calculation_197102867468517376]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([Calculation_3564247274296606788]) OR [Calculation_3564247274296606788] = 0 THEN [Contact Cost (copy)_114419593034366976] ELSE [Calculation_3564247274324492379] END' />
      </column>
      <column caption='MTD Fill Level ' datatype='string' name='[Calculation_1998683472040419328]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_1287748032673755140] &lt;0.8 then &apos;0&apos;&#10;elseif [Calculation_1287748032673755140] &gt;1.2 then &apos;1&apos; &#10;else &apos;2&apos; &#10;end' />
      </column>
      <column caption='OD Comission Lucanet Condition' datatype='real' name='[Calculation_210895140342906883]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([Calculation_3564247274296606788]) THEN [OD Commission Lucanet (copy)_210895140342755330] ELSE [Calculation_3564247274296606788] END' />
      </column>
      <column caption='Latest Lucanet Flag' datatype='string' name='[Calculation_210895140349022218]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_3564247274296606788] = 0 OR ISNULL([Calculation_3564247274296606788]) THEN &apos;M-2&apos; ELSE &apos;M-1&apos; END' />
      </column>
      <column caption='Orders WoW (%)' datatype='real' name='[Calculation_2125276823239274502]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND((SUM(orders_succ) / SUM(IFNULL(orders_succ_wow, 0)) - 1) * 100,1)' />
      </column>
      <column caption='Orders WoW Color' datatype='string' name='[Calculation_2125276823240019975]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_2125276823239274502] &lt; 0 THEN &apos;Negative&apos; ELSE &apos;Positive&apos; END' />
      </column>
      <column caption='bdg wow' datatype='real' hidden='true' name='[Calculation_2324983327982153728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((IFNULL(SUM(mon_commission_od_eur_bud_wow),0)) / IFNULL(SUM(mon_gfv_od_eur_bud_wow),0))' />
      </column>
      <column caption='ln od' datatype='real' hidden='true' name='[Calculation_2324983327982403586]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(lucanet_comm_od_eur)/ SUM(IFNULL(lucanet_gmv_od_eur,0)))' />
      </column>
      <column caption='Start Date' datatype='string' name='[Calculation_2373889596536709121]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Start Date&apos; +&apos;:&apos; +&apos; &apos;+ str(date(DATETRUNC(&apos;day&apos;, [calendar_week])))' />
      </column>
      <column caption='Last Day ' datatype='datetime' name='[Calculation_2396900172654157824]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEADD(&apos;day&apos;,6,[calendar_week])' />
      </column>
      <column caption='Commission Rate PickUp WoW pp' datatype='real' name='[Calculation_2437643690630094848]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1342213449672896534] - ( SUM([pickup_commission_eur_wow]) / SUM([pickup_gmv_eur_wow]) )' />
      </column>
      <column caption='days' datatype='integer' hidden='true' name='[Calculation_255157112087527424]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed DATETRUNC(&apos;month&apos;,today()) : max(day(today()))}' />
      </column>
      <column caption='Restos Closed (%)' datatype='real' name='[Calculation_2610258205069393920]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([bux_restaurant_closed])/sum([ga_orders])' />
      </column>
      <column caption='Login &amp; Signup Errors' datatype='real' default-format='p0%' name='[Calculation_2610258205086035969]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([new_cus_bux_signup_error]) + sum([new_cus_bux_login_error]))/sum([ga_orders])' />
      </column>
      <column caption='Payment Error' datatype='real' default-format='p0%' name='[Calculation_2610258205089533954]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([new_cus_bux_payment_error]) / sum([ga_orders])' />
      </column>
      <column caption='Voucher Error %' datatype='real' default-format='p0%' name='[Calculation_2610258205096599555]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([new_cus_bux_voucher_error])/sum([ga_orders])' />
      </column>
      <column caption='High MOV &amp; DF' datatype='real' default-format='p0%' name='[Calculation_2610258205097832452]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([new_cus_bux_high_mov])+sum([new_cus_bux_high_df]))/sum([ga_orders])' />
      </column>
      <column caption='Personalization Swimlanes' datatype='real' name='[Calculation_2724537057744781313]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([swimlane_orders]) / SUM([swimlane_total_orders])' />
      </column>
      <column caption='Personalization Swimlanes WoW pp' datatype='real' name='[Calculation_2724537057745231874]' role='measure' type='quantitative'>
