    <worksheet name='City Trend Line'>
      <table>
        <view>
          <datasources>
            <datasource caption='city_profitability_daily (rl_intl_markets)' name='federated.0vsoy3a1elnygz14dw6f71t9faaz' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='City KPIs Selector ' datatype='string' name='[Analytical View KPIs Selector (copy)_5593611523773886472]' param-domain-type='list' role='measure' type='nominal' value='&quot;GP&quot;'>
              <calculation class='tableau' formula='&quot;GP&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.0vsoy3a1elnygz14dw6f71t9faaz].[Calculation_3215147949526245377]' caption='Reference Week' datatype='datetime' default-format='*dd - mmm - yy' name='[Parameter 6]' param-domain-type='list' role='measure' type='quantitative' value='#2021-05-31 00:00:00#'>
              <calculation class='tableau' formula='#2021-05-31 00:00:00#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0vsoy3a1elnygz14dw6f71t9faaz'>
            <column caption='# of Cities Fully loaded GP positive (5 weeks)' datatype='integer' name='[# of Cities Fully loaded GP positive (with Date Selector switch)  (copy)_962644471567228944]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//{fixed country,city, DATETRUNC(&apos;month&apos;, [report_date]) : ([Positive Gross Profit  Needed])}&#10;{fixed [geo_view],[selected_view], &#10;           [currency_view],[management_entity],&#10;           [sub_entity],&#10;           [city_name],&#10;           [Weeks to show 2 (copy)_962644471521251332]: &#10;&#10;([Positive Gross Profit  Needed (copy)_5593611523761954819])}' />
            </column>
            <column caption='# of Cities GP positive  (5 weeks)' datatype='integer' name='[# of Cities GP positive  (one week selection) (copy)_962644471569297429]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//{fixed country,city, DATETRUNC(&apos;month&apos;, [report_date]) : ([Positive Gross Profit  Needed])}&#10;{fixed [geo_view],[selected_view], &#10;           [currency_view],[management_entity],&#10;           [sub_entity],&#10;           [city_name],&#10;           [Weeks to show 2 (copy)_962644471521251332]: &#10;([Calculation_587227172037701634])}' />
            </column>
            <column caption='% of Cities Fully loaded GP positive (5 weeks) ' datatype='real' name='[% of Cities Fully loaded GP positive (with Date Selector switch) (copy)_962644471568146449]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='sum([# of Cities Fully loaded GP positive (with Date Selector switch)  (copy)_962644471567228944])/COUNTD([city (copy)_587227172036841472])' />
            </column>
            <column caption='% of Cities GP positive (5 weeks)' datatype='real' name='[% of Cities GP positive (with Date Selector switch) (copy)_962644471568146451]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='sum([# of Cities GP positive  (one week selection) (copy)_962644471569297429] )/COUNTD([city (copy)_587227172036841472])' />
            </column>
            <column caption='Week ' datatype='datetime' name='[Calculation_11259024976678914]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;,[report_date])' />
            </column>
            <column caption='Weeks to show' datatype='boolean' name='[Calculation_11259024977764355]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[report_date],[Parameters].[Parameter 6]) &lt;= 28&#10;and DATEDIFF(&apos;day&apos;,[report_date],[Parameters].[Parameter 6]) &gt; -7' />
            </column>
            <column caption='&apos;L5W Trend&apos;' datatype='string' name='[Calculation_149322525838106627]' role='dimension' type='nominal' user:unnamed='City Trend Line'>
              <calculation class='tableau' formula='&apos;L5W Trend&apos;' />
            </column>
            <column caption='Weeks   ' datatype='datetime' datatype-customized='true' name='[Calculation_3215147949526245377]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if (not ISNULL((IF DATEPART(&apos;weekday&apos;, ([report_date])) = 7 THEN ([Calculation_11259024976678914]) end)) = True)&#10;&#10;then ([Calculation_11259024976678914])&#10;&#10;end' />
            </column>
            <column caption='Positive GP  (Analytical View)' datatype='integer' name='[Calculation_587227172037701634]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Gross Profit (per Order) (Switch) (copy)_1545438416102940673] &gt; 0 THEN 1&#10;ELSE 0&#10;END' />
            </column>
            <column caption='City KPIs Selector % L5W' datatype='real' name='[City KPIs Selector % (copy)_962644471572123672]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Analytical View KPIs Selector (copy)_5593611523773886472]&#10;WHEN &quot;GP&quot; THEN [% of Cities GP positive (with Date Selector switch) (copy)_962644471568146451]&#10;WHEN &quot;Fully Loaded GP&quot; THEN  [% of Cities Fully loaded GP positive (with Date Selector switch) (copy)_962644471568146449]&#10;END' />
            </column>
            <column caption='Fully Loaded GP (Analytical View)' datatype='real' name='[GP (Analytical View) (copy)_1545438416111218693]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([flgp])' />
            </column>
            <column caption='GP (Analytical View)' datatype='real' name='[Gross Profit (per Order) (Switch) (copy)_1545438416102940673]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([gp])' />
            </column>
            <column caption='Positive Fully loaded GP (Analytical View)' datatype='integer' name='[Positive Gross Profit  Needed (copy)_5593611523761954819]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [GP (Analytical View) (copy)_1545438416111218693] &gt; 0 THEN 1&#10;ELSE 0&#10;END' />
            </column>
            <column caption='Vertical no dmart no kitchen' datatype='string' name='[Vertical (copy)_2428214264070807552]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[vertical]' />
            </column>
            <column caption='Weeks to show 1' datatype='integer' name='[Weeks to show 2 (copy)_962644471521251332]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEPART(&apos;week&apos;,DATETRUNC(&apos;week&apos;,[Parameters].[Parameter 6])) - DATEPART(&apos;week&apos;,DATETRUNC(&apos;week&apos;,[Calculation_11259024976678914]))' />
            </column>
            <column caption='# city' datatype='string' default-role='measure' default-type='quantitative' name='[city (copy)_587227172036841472]' role='dimension' semantic-role='[City].[Name]' type='nominal'>
              <calculation class='tableau' formula='[city_name]' />
