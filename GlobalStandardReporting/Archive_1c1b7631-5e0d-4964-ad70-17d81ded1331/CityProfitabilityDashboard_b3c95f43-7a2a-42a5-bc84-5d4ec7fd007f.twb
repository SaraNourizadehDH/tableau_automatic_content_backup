      <column caption='Weeks to show 2' datatype='boolean' name='[Weeks to show (copy 2)_1588785532656971776]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[report_date],[Parameters].[Parameter 6]) &lt;= 7&#10;and DATEDIFF(&apos;day&apos;,[report_date],[Parameters].[Parameter 6]) &gt; -7' />
      </column>
      <column caption='Weeks to show 1 (copy 2)' datatype='boolean' name='[Weeks to show 1 (copy 2)_4963740855190470666]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;week&apos;,DATETRUNC(&apos;week&apos;,[Calculation_11259024976678914]),DATETRUNC(&apos;week&apos;,[Parameters].[Parameter 6])) = 0' />
      </column>
      <column caption='Weeks to show 1' datatype='integer' name='[Weeks to show 2 (copy)_962644471521251332]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEPART(&apos;week&apos;,DATETRUNC(&apos;week&apos;,[Parameters].[Parameter 6])) - DATEPART(&apos;week&apos;,DATETRUNC(&apos;week&apos;,[Calculation_11259024976678914]))' />
      </column>
