      <table>
        <view>
          <datasources>
            <datasource caption='city_profitability_daily (rl_intl_markets)' name='federated.0vsoy3a1elnygz14dw6f71t9faaz' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='City KPIs Selector ' datatype='string' name='[Analytical View KPIs Selector (copy)_5593611523773886472]' param-domain-type='list' role='measure' type='nominal' value='&quot;GP&quot;'>
              <calculation class='tableau' formula='&quot;GP&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.0vsoy3a1elnygz14dw6f71t9faaz].[Calculation_3215147949526245377]' caption='Reference Week' datatype='datetime' default-format='*dd - mmm - yy' name='[Parameter 6]' param-domain-type='list' role='measure' type='quantitative' value='#2021-05-31 00:00:00#'>
              <calculation class='tableau' formula='#2021-05-31 00:00:00#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0vsoy3a1elnygz14dw6f71t9faaz'>
            <column caption='# of Zones GP positive  (one week selection)' datatype='integer' name='[# of Cities GP positive (with Date Selecto switch) (copy)_3091369306615062535]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//{fixed country,city, zone, DATETRUNC(&apos;month&apos;, [report_date]) : ([Positive Gross Profit  Needed])}&#10;{fixed [geo_view],[selected_view], &#10;           [currency_view],[management_entity],&#10;           [sub_entity],&#10;           [city_name],&#10;           [zone_name],&#10;           [Weeks to show 2 (copy)_962644471521251332]: &#10; ([Calculation_587227172037701634])}' />
            </column>
            <column caption='# of Zones Fully loaded GP positive  (one week selection)' datatype='integer' name='[# of Zones GP positive (with Date Selecto switch) (copy)_5593611523769729030]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [geo_view],[selected_view], &#10;           [currency_view],[management_entity],&#10;           [sub_entity],&#10;           [city_name],&#10;           [zone_name],&#10;           [Weeks to show 2 (copy)_962644471521251332]:&#10; ([Positive Gross Profit  Needed (copy)_5593611523761954819])}' />
            </column>
            <column caption='% of Zones Fully loaded GP positive  (one week selection)' datatype='real' name='[% of Cities Fully loaded GP positive (with Date Selector switch) (copy)_5593611523770134535]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='sum([# of Zones GP positive (with Date Selecto switch) (copy)_5593611523769729030])/COUNTD([zone (copy)_587227172036984833])' />
            </column>
            <column caption='% of Zones GP positive  (one week selection)' datatype='real' name='[% of Zones Fully loaded GP positive (with Date Selector switch) (copy)_5593611523939962891]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='sum([# of Cities GP positive (with Date Selecto switch) (copy)_3091369306615062535])/COUNTD([zone (copy)_587227172036984833])' />
            </column>
            <column caption='Week ' datatype='datetime' name='[Calculation_11259024976678914]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;,[report_date])' />
            </column>
            <column caption='Weeks to show' datatype='boolean' name='[Calculation_11259024977764355]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[report_date],[Parameters].[Parameter 6]) &lt;= 28&#10;and DATEDIFF(&apos;day&apos;,[report_date],[Parameters].[Parameter 6]) &gt; -7' />
            </column>
            <column caption='&apos;% Cities Positive&apos;' datatype='string' name='[Calculation_216665413488955417]' role='dimension' type='nominal' user:unnamed='GP - GP Positive %'>
