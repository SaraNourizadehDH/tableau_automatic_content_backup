    <dashboard name='City View (Reconciled vs Back-End)'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#ffffff'>City View: Reconciled vs Back-End</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/CityProfitabilityDashboard/CityViewReconciledvsBack-End?rev=' id='CityViewReconciledvsBack-End' path='/t/GlobalStandardReporting/workbooks/CityProfitabilityDashboard' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='dash-title'>
          <format attr='background-color' value='#d8232a' />
        </style-rule>
      </style>
      <size maxheight='1100' maxwidth='1600' minheight='1100' minwidth='1600' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='city_profitability_daily (rl_intl_markets)' name='federated.0vsoy3a1elnygz14dw6f71t9faaz' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Date Level Selector' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
          <calculation class='tableau' formula='&quot;Monthly&quot;' />
          <members>
            <member value='&quot;Yearly&quot;' />
            <member value='&quot;Monthly&quot;' />
            <member value='&quot;Weekly&quot;' />
            <member value='&quot;Daily&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.0vsoy3a1elnygz14dw6f71t9faaz'>
        <column caption='Date Selector (switch)' datatype='date' name='[Date Selector (copy)_1254604363509874698]' role='dimension' type='quantitative'>
          <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 4]&#10;WHEN &apos;Daily&apos; THEN DATETRUNC(&apos;day&apos;,DATE([report_date] ))&#10;WHEN &apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;,DATE([report_date] ))&#10;WHEN &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;,DATE([report_date] ))&#10;WHEN &apos;Yearly&apos; THEN DATETRUNC(&apos;year&apos;,DATE([report_date] ))&#10;END)' />
        </column>
        <column caption='City Name' datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
        <column caption='Currency View' datatype='string' name='[currency_view]' role='dimension' type='nominal' />
        <column caption='Is Own Delivery' datatype='boolean' name='[is_own_delivery]' role='dimension' type='nominal' />
        <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
        <column-instance column='[Date Selector (copy)_1254604363509874698]' derivation='MDY' name='[md:Date Selector (copy)_1254604363509874698:ok]' pivot='key' type='ordinal' />
        <column-instance column='[city_name]' derivation='None' name='[none:city_name:nk]' pivot='key' type='nominal' />
        <column-instance column='[currency_view]' derivation='None' name='[none:currency_view:nk]' pivot='key' type='nominal' />
        <column-instance column='[is_own_delivery]' derivation='None' name='[none:is_own_delivery:nk]' pivot='key' type='nominal' />
        <column-instance column='[management_entity]' derivation='None' name='[none:management_entity:nk]' pivot='key' type='nominal' />
        <column-instance column='[sub_entity]' derivation='None' name='[none:sub_entity:nk]' pivot='key' type='nominal' />
        <column caption='Sub Entity' datatype='string' name='[sub_entity]' role='dimension' type='nominal' />
      </datasource-dependencies>
