                </zone-style>
              </zone>
              <zone h='2078' id='680' type-v2='text' w='37062' x='62438' y='211'>
                <formatted-text>
                  <run bold='true' fontsize='14'>This report will be archived by the end of Q3-2023, please reach out to us on Slack (#data-hub-intl-markets) for alternatives.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
