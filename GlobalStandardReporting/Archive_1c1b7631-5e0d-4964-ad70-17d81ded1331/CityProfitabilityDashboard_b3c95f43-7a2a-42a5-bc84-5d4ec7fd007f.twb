      <column caption='Delivery Fee per Order' datatype='real' name='[AFV (Switch) (copy)_3091369308845862951]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF max([is_own_delivery]) = TRUE &#10;THEN &#10;zn(sum([Calculation_4934819329570529281])) /zn(sum([cnt_order]))&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='AFV' datatype='real' name='[AFV Needed with adj (copy)_3091369308836245539]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn(sum(gfv)) / zn(sum([cnt_order]))' />
      </column>
      <column caption='Adj. Delivery Fee % of GFV' datatype='real' name='[Adj. Commission Revenue % of GFV (copy)_5553219878710108161]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//SUM(zn([Delivery Fee Revenue Needed adj])) / SUM(zn([GFV - Reconciled (Needed)]))&#10;&#10;(SUM(IF [selected_view] = &apos;Reconciled&apos; THEN [delivery_fee_net] ELSE 0 END)&#10;-SUM(IF [selected_view] = &apos;Back-End&apos; THEN [delivery_fee_net] ELSE 0 END))&#10;/ (SUM(IF [selected_view] = &apos;Reconciled&apos; THEN [delivery_fee_net] ELSE 0 END))' />
      </column>
      <column caption='Adj. Full CM-I % of GFV ' datatype='real' name='[Adj. Delivery Cost % of GFV (copy) (copy)_5553219878784036879]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//( zn([Full CM-I - Reconciled]) - zn([Full CM-I]) )/ [Full CM-I - Reconciled]&#10;&#10;(SUM(IF [selected_view] = &apos;Reconciled&apos; THEN &#10;      zn(([Profit Contribution  Needed (copy)_3833759610179297321])) &#10;    + zn(([payment])) &#10;    + zn(([food_delivery_accident]))&#10; ELSE 0 END)&#10;-SUM(IF [selected_view] = &apos;Back-End&apos; THEN &#10;      zn(([Profit Contribution  Needed (copy)_3833759610179297321])) &#10;    + zn(([payment])) &#10;    + zn(([food_delivery_accident]))&#10;ELSE 0 END))&#10;/ SUM(IF [selected_view] = &apos;Reconciled&apos; THEN &#10;      zn(([Profit Contribution  Needed (copy)_3833759610179297321])) &#10;    + zn(([payment])) &#10;    + zn(([food_delivery_accident]))&#10; ELSE 0 END)' />
      </column>
      <column caption='Adj. CM-II % of GFV ' datatype='real' name='[Adj. Delivery Cost % of GFV (copy)_5553219878784028686]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF [selected_view] = &apos;Reconciled&apos; THEN &#10;      zn(([Profit Contribution  Needed (copy)_3833759610179297321])) &#10;    + zn(([payment])) &#10;    + zn(([food_delivery_accident]))&#10;    + zn(([semi_variable_delivery])) &#10;    + zn(([shopper_costs]))&#10; ELSE 0 END)&#10;-SUM(IF [selected_view] = &apos;Back-End&apos; THEN &#10;      zn(([Profit Contribution  Needed (copy)_3833759610179297321])) &#10;    + zn(([payment])) &#10;    + zn(([food_delivery_accident]))&#10;    + zn(([semi_variable_delivery])) &#10;    + zn(([shopper_costs]))&#10;ELSE 0 END))&#10;/ SUM(IF [selected_view] = &apos;Reconciled&apos; THEN &#10;      zn(([Profit Contribution  Needed (copy)_3833759610179297321])) &#10;    + zn(([payment])) &#10;    + zn(([food_delivery_accident]))&#10;    + zn(([semi_variable_delivery])) &#10;    + zn(([shopper_costs]))&#10; ELSE 0 END)' />
      </column>
      <column caption='Adj. Total Revenue % of GFV' datatype='real' name='[Adj. Delivery Fee % of GFV (copy)_5553219878710382594]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF [selected_view] = &apos;Reconciled&apos; THEN &#10;      zn([delivery_fee_net]) &#10;    + zn([commission]) &#10;    + zn([card_fee_revenue]) &#10;    + zn([other_revenue])&#10; ELSE 0 END)&#10;-SUM(IF [selected_view] = &apos;Back-End&apos; THEN &#10;      zn([delivery_fee_net]) &#10;    + zn([commission]) &#10;    + zn([card_fee_revenue]) &#10;    + zn([other_revenue])&#10; ELSE 0 END))&#10;/ SUM(IF [selected_view] = &apos;Reconciled&apos; THEN &#10;      zn([delivery_fee_net]) &#10;    + zn([commission]) &#10;    + zn([card_fee_revenue]) &#10;    + zn([other_revenue])&#10; ELSE 0 END)' />
      </column>
      <column caption='Adj. Delivery Cost % of GFV' datatype='real' name='[Adj. Delivery Fee % of GFV (copy)_5553219878710980611]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF [selected_view] = &apos;Reconciled&apos; THEN [delivery_costs] ELSE 0 END)&#10;-SUM(IF [selected_view] = &apos;Back-End&apos; THEN [delivery_costs] ELSE 0 END))&#10;/ (SUM(IF [selected_view] = &apos;Reconciled&apos; THEN [delivery_costs] ELSE 0 END))' />
      </column>
      <column caption='Adj. GFV % of GFV' datatype='real' name='[Adj. Delivery Fee % of GFV (copy)_5553219879088361494]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF [selected_view] = &apos;Reconciled&apos; THEN [gfv] ELSE 0 END)&#10;-SUM(IF [selected_view] = &apos;Back-End&apos; THEN [gfv] ELSE 0 END))&#10;/ (SUM(IF [selected_view] = &apos;Reconciled&apos; THEN [gfv] ELSE 0 END))&#10;&#10;//zn([GFV Needed adj])&#10;// / zn(SUM([GFV - Reconciled (Needed)]))' />
      </column>
      <column caption='Adj.Gross Profit % of GFV ' datatype='real' name='[Adj. Full CM-I % of GFV  (copy)_5553219878785245202]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF [selected_view] = &apos;Reconciled&apos; THEN [gp] ELSE 0 END)&#10;-SUM(IF [selected_view] = &apos;Back-End&apos; THEN [gp] ELSE 0 END))&#10;/ (SUM(IF [selected_view] = &apos;Reconciled&apos; THEN [gp] ELSE 0 END))' />
      </column>
      <column caption='Other Revenue Per Order' datatype='real' name='[Average Delivery Fee Needed adj (copy)_5296162856167690244]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn(sum([other_revenue])) / zn(sum([cnt_order]))' />
      </column>
      <column caption='Avg. Commission Rate (GFV)' datatype='real' name='[Avg commission rate EUR org (copy)_3833759610137182228]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM ([commission]) /sum([gfv])' />
      </column>
      <column caption='Avg. Commission Rate (Commissionable Base)' datatype='real' default-format='p0.0%' name='[Avg. Commission Rate (GFV) (copy)_4045147310892630016]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM ([commission]) / sum([commission_base_sales_def])' />
      </column>
      <column caption='CM-II' datatype='real' name='[CM-II  (copy)_3833759609837899786]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn(([Full CM-I  (copy)_3833759609837535240])) + ZN(SUM([Calculation_4934819329849868300])) &#10;+ zn(sum([shopper_costs])) &#10;//we sub the cost as in the calculation cost are negative' />
      </column>
      <column caption='Week ' datatype='datetime' name='[Calculation_11259024976678914]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;,[report_date])' />
      </column>
      <column caption='Weeks to show' datatype='boolean' name='[Calculation_11259024977764355]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[report_date],[Parameters].[Parameter 6]) &lt;= 28&#10;and DATEDIFF(&apos;day&apos;,[report_date],[Parameters].[Parameter 6]) &gt; -7' />
      </column>
      <column caption='other_fees_cpo_eur CPO' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1343902313344737280]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([other_fees_cpo_eur])) / (sum([cnt_order]))' />
      </column>
      <column caption='Gross Profit as % of GMV' datatype='real' name='[Calculation_1462966202855686144]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn(sum([gp])) /  ( zn(sum([gfv])) + zn(sum([delivery_fee_net])))' />
      </column>
      <column caption='CountD # Zones' datatype='integer' name='[Calculation_1495265484256653312]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF MAX([is_own_delivery]) = TRUE &#10;THEN &#10;COUNTD([ Zone   (copy)_1905937459924090885])&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Index' datatype='integer' name='[Calculation_1588785532657373185]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='Last()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='GFV LC - Reconciled' datatype='real' name='[Calculation_1680968623136358406]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED &#10;[management_entity], &#10;[sub_entity], &#10;[city_name], &#10;[zone_name],&#10;[city_tier], &#10;[Date Selector (copy)_1254604363509874698], &#10;[vertical] : &#10;&#10;IF sum([GFV LC org. (copy)_3833759610153431067]) = 0 &#10;THEN 0 &#10;ELSEIF sum([GFV LC org. (copy)_3833759610153431067])!= 0 &#10;THEN &#10;zn(SUM([amt_commissionable_value_lc])) + zn(sum([GFV LC org. (copy)_3833759610153431067]))&#10;END&#10;}' />
      </column>
      <column caption='Orders / 1k inhabitants (logistic_zone_population)' datatype='real' name='[Calculation_194569609263448064]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([cnt_order]) / sum([Calculation_194569609370009605]) * 1000' />
      </column>
      <column caption='logistic_zone_population_calc' datatype='real' name='[Calculation_194569609370009605]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF &#10;{FIXED &#10;[global_entity_id],&#10;[zone_name] , &#10;[is_own_delivery],&#10;[currency_view],&#10;[selected_view], &#10;[geo_view]&#10;:max([zone_population])} = 0 THEN NULL&#10;ELSE &#10;{FIXED &#10;[global_entity_id],&#10;[zone_name] , &#10;[is_own_delivery],&#10;[currency_view],&#10;[selected_view], &#10;[geo_view]&#10;:max([zone_population])} &#10;END' />
      </column>
      <column caption='logistic_city_addressable_population_calc' datatype='real' name='[Calculation_194569609370644486]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF {FIXED &#10;[global_entity_id],&#10;[city_name], &#10;[is_own_delivery],&#10;[currency_view],&#10;[selected_view], &#10;[geo_view]&#10;:max(zn([city_addressable_population]))} = 0 THEN NULL &#10;ELSE &#10;{FIXED &#10;[global_entity_id],&#10;[city_name], &#10;[is_own_delivery],&#10;[currency_view],&#10;[selected_view], &#10;[geo_view]&#10;:max(zn([city_addressable_population]))}&#10;END' />
      </column>
      <column caption='UTR' datatype='real' name='[Calculation_2073485444705660930]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([delivered_orders])/ sum([working_hours])' />
      </column>
      <column caption='&apos;No. of Cities&apos;' datatype='string' name='[Calculation_216665413705412652]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;No. of Cities&apos;' />
      </column>
      <column caption='empty' datatype='integer' name='[Calculation_2169609146468577283]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF FALSE THEN 0 ELSE NULL END' />
      </column>
      <column caption='City / Zone   ' datatype='string' name='[Calculation_218424607868891139]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 5] = &apos;City&apos; then [city_name] &#10;elseif [Parameters].[Parameter 5] = &apos;Zone&apos; then [zone_name]&#10;end' />
      </column>
      <column caption='AOV' datatype='real' name='[Calculation_2480709378783600640]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gmv])/sum([cnt_order])' />
      </column>
      <column caption='Weeks   ' datatype='datetime' datatype-customized='true' name='[Calculation_3215147949526245377]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if (not ISNULL((IF DATEPART(&apos;weekday&apos;, ([report_date])) = 7 THEN ([Calculation_11259024976678914]) end)) = True)&#10;&#10;then ([Calculation_11259024976678914])&#10;&#10;end' />
      </column>
      <column caption='&apos;1&apos;' datatype='string' name='[Calculation_3560939995295969281]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;1&apos;' />
      </column>
      <column caption='is_competitive_calculation' datatype='string' name='[Calculation_357754726944247809]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF str([is_competitive]) = &apos;1&apos; then &apos;Yes*&apos;&#10;elseif str([is_competitive]) = &apos;0&apos; then &apos;No*&apos;&#10;ELSE &apos;N/A&apos;&#10;END' />
      </column>
      <column caption='GFV - Reconciled (Needed)' datatype='real' name='[Calculation_3603513031715676161]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 2]=&apos;Eur&apos; then [GFV LC (copy)_4144015355732361226] &#10;elseif [Parameters].[Parameter 2]=&apos;LC&apos; then [Calculation_1680968623136358406]&#10;end' />
      </column>
      <column caption='Payment CPO' datatype='real' name='[Calculation_4351603169876963328]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([payment]))/ (sum([cnt_order]))' />
      </column>
      <column caption='Food Delivery Accident CPO ' datatype='real' name='[Calculation_4351603169877245953]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([Calculation_4934819329849315339])) / (sum([cnt_order]))' />
      </column>
      <column caption='Semi Variable Delivery CPO' datatype='real' name='[Calculation_4351603169877401602]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([Calculation_4934819329849868300]))/ (sum([cnt_order]))' />
      </column>
      <column caption='Other Non Specific Delivery CPO' datatype='real' name='[Calculation_4351603169877561347]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([other_non_specific_delivery])) / (sum([cnt_order]))' />
      </column>
      <column caption='% Delivery Costs' datatype='real' name='[Calculation_4587619968230539264]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF [selected_view] = &apos;Reconciled&apos; THEN [delivery_costs] ELSE 0 END)&#10;-SUM(IF [selected_view] = &apos;Back-End&apos; THEN [delivery_costs] ELSE 0 END))&#10;/ SUM(IF [selected_view] = &apos;Back-End&apos; THEN [delivery_costs] ELSE 0 END)' />
      </column>
      <column caption='Delivery Fee Revenue (Net)' datatype='real' name='[Calculation_4934819329570529281]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_own_delivery] = TRUE &#10;THEN [delivery_fee_net]&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Commission Revenue (Gross)' datatype='real' name='[Calculation_4934819329572790275]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn(sum([commission])) - zn(sum([dh_pick_up_incentives]))' />
      </column>
      <column caption='Vendor Delivery Fee per Order' datatype='real' name='[Calculation_4934819329574486020]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Delivery Fee Revenue (Net) (copy)_4934819329570955266]) / sum([cnt_order])' />
      </column>
      <column caption='DH Pickup Incentives per Order' datatype='real' name='[Calculation_4934819329575370759]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([dh_pick_up_incentives]) / sum([cnt_order])' />
      </column>
      <column caption='DH Basket Incentives per Order' datatype='real' name='[Calculation_4934819329576456200]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_4934819329845710857]) / sum([cnt_order])' />
      </column>
      <column caption='Dh Incentives No Pick Up calc' datatype='real' name='[Calculation_4934819329845710857]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-[dh_incentives_no_pick_up]' />
      </column>
      <column caption='Food Delivery Accident Calc' datatype='real' name='[Calculation_4934819329849315339]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_own_delivery] = TRUE &#10;THEN [food_delivery_accident]&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Semi Variable Delivery Calc' datatype='real' name='[Calculation_4934819329849868300]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_own_delivery] = TRUE &#10;THEN [semi_variable_delivery]&#10;ELSE NULL &#10;END' />
      </column>
      <column caption='CPH' datatype='real' name='[Calculation_5059583122401681408]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF zn(-[Take-in Per Order (Switch) (copy)_3091369308851376170]) != 0 &#10;THEN zn(-[Take-in Per Order (Switch) (copy)_3091369308851376170])*zn([Calculation_2073485444705660930])&#10;else NULL&#10;end' />
      </column>
      <column caption='Vendor Density' datatype='real' name='[Calculation_5059583122405412865]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//1/sum([Area Size])&#10;[Calculation_5059583122728914952]/sum([Calculation_6559915127270592516])' />
      </column>
      <column caption='Vendor Count (1)' datatype='real' name='[Calculation_5059583122728914952]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(ifnull([vendor_count],0) )/ countd((DATETRUNC(&apos;day&apos;,[report_date])))' />
      </column>
      <column caption='Adj. Commission Revenue % of GFV' datatype='real' name='[Calculation_5553219878709542912]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//SUM(zn([Commission Revenue Needed adj.]) )&#10;/// SUM(zn([GFV - Reconciled (Needed)]))&#10;&#10;(SUM(IF [selected_view] = &apos;Reconciled&apos; THEN [commission] ELSE 0 END)&#10;-SUM(IF [selected_view] = &apos;Back-End&apos; THEN [commission] ELSE 0 END))&#10;/ (SUM(IF [selected_view] = &apos;Reconciled&apos; THEN [commission] ELSE 0 END))' />
      </column>
      <column caption='DH Basket Incentives (per Order) (Switch)' datatype='real' name='[Calculation_5593611522887880705]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[DH Basket Incentives - Backend (Needed) (copy)_1516235341512081413]' />
      </column>
      <column caption='Use' datatype='real' name='[Calculation_570338729417379840]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='' />
      </column>
      <column caption='Username Filter' datatype='boolean' name='[Calculation_570338729417424897]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='USERNAME() = [username]' />
      </column>
      <column caption='% Orders Succ' datatype='real' name='[Calculation_5714997592194273281]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([cnt_order]) / TOTAL (sum([cnt_order]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Attr' datatype='integer' name='[Calculation_5825335771760947270]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Avg Delivery Time' datatype='real' name='[Calculation_582582863738773504]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn(sum([delivery_time_m_sum])) / zn(sum([delivery_time_m_count]))' />
      </column>
      <column caption='Positive GP  (Analytical View)' datatype='integer' name='[Calculation_587227172037701634]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Gross Profit (per Order) (Switch) (copy)_1545438416102940673] &gt; 0 THEN 1&#10;ELSE 0&#10;END' />
      </column>
      <column caption='p. Show/Hide Cities' datatype='string' name='[Calculation_6423399768648433664]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 7]' />
      </column>
      <column caption='Area Size' datatype='real' name='[Calculation_6559915127270592516]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF &#10;{FIXED &#10;[global_entity_id],&#10;[zone_name], &#10;[is_own_delivery],&#10;[currency_view],&#10;[selected_view], &#10;[geo_view]&#10;:max([area_size])} = 0 THEN NULL&#10;ELSE &#10;{FIXED &#10;[global_entity_id],&#10;[zone_name] , &#10;[is_own_delivery],&#10;[currency_view],&#10;[selected_view], &#10;[geo_view]&#10;:max([area_size])} &#10;END' />
      </column>
      <column caption='% Orders with DH Incentives' datatype='real' name='[Calculation_765400863819730944]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([is_dh_combined_v_d_ct]) / sum([cnt_order])' />
      </column>
      <column caption='DH Incentives % GMV' datatype='real' name='[Calculation_765400863820546050]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn(sum([dh_incentives])) / (zn(sum([gfv])) + zn(SUM([delivery_fee_net])))' />
      </column>
      <column caption='DH Incentives % Total Revenue' datatype='real' name='[Calculation_765400863820750851]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn(sum([dh_incentives])) / zn(sum([take_in]))' />
      </column>
      <column caption='City KPIs Selector #' datatype='integer' name='[City KPIs Selector  (copy)_216665413481431045]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Analytical View KPIs Selector (copy)_5593611523773886472]&#10;WHEN &quot;GP&quot; THEN sum([# of Cities GP positive (copy)_3091369306610024450])&#10;WHEN &quot;Fully Loaded GP&quot; THEN  sum([# of Cities GP positive (with Date Selector switch) (copy)_5593611523762737156])&#10;end' />
      </column>
      <column caption='KPIs Selector (&lt; 0) - City' datatype='integer' name='[City KPIs Selector # orde level (copy)_6986279346524332032]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Analytical View KPIs Selector (copy)_5593611523773886472]&#10;WHEN &quot;GP&quot; THEN ([Positive Gross Profit  Needed (copy)_3091369306618204168])&#10;WHEN &quot;Fully Loaded GP&quot; THEN  ([GPO (&lt; 0) - City (copy)_216665413702361131])&#10;end' />
      </column>
      <column caption='City KPIs Selector % L5W' datatype='real' name='[City KPIs Selector % (copy)_962644471572123672]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Analytical View KPIs Selector (copy)_5593611523773886472]&#10;WHEN &quot;GP&quot; THEN [% of Cities GP positive (with Date Selector switch) (copy)_962644471568146451]&#10;WHEN &quot;Fully Loaded GP&quot; THEN  [% of Cities Fully loaded GP positive (with Date Selector switch) (copy)_962644471568146449]&#10;END' />
      </column>
      <column caption='City Name Hierarchy' datatype='string' name='[City Name (copy)_2453898909309128705]' role='dimension' semantic-role='[City].[Name]' type='nominal'>
        <calculation class='tableau' formula='[city_name]' />
      </column>
      <column caption='City Name   ' datatype='string' name='[City Name1 (copy)_6683623364927692803]' role='dimension' semantic-role='[City].[Name]' type='nominal'>
        <calculation class='tableau' formula='[city_name 1]' />
      </column>
      <column caption='Commission Rev. per Order (Gross)' datatype='real' name='[Commission Rev. per Order (Net) (copy)_4934819329575120902]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn(([Calculation_4934819329572790275])) / zn(sum([cnt_order]))' />
      </column>
      <column caption='Take-in Per Order' datatype='real' name='[Commission Rev. per Order (Switch) (copy)_3091369308847800361]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn(sum([take_in])) / zn(sum([cnt_order]))' />
      </column>
      <column caption='Commissionable Base per Order (copy)' datatype='real' name='[Commission Rev. per Order (copy)_4149855986091880448]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn(sum([commission_base_sales_def])) / zn(sum([cnt_order]))' />
      </column>
      <column caption='Vendor Funded Incentives. per Order' datatype='real' name='[Commission Rev. per Order (copy)_4149855986092122113]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn(sum([incentives_other_incl_joker])) / zn(sum([cnt_order]))' />
      </column>
      <column caption='Commission Rev. per Order (Net)' datatype='real' name='[Commission Rev. per Order - Reconciled (Needed) (copy)_3091369308838834212]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn(sum([commission])) / zn(sum([cnt_order]))' />
      </column>
      <column caption='Contribution Margin %' datatype='real' name='[Contribution Margin % Needed (copy)_3833759610179059752]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Profit Contribution  Needed (copy)_3833759610179297321])/ sum([take_in])' />
      </column>
      <column caption='DH Basket Incentives (per Order) - Backend (Needed)' datatype='real' name='[DH Basket Incentives - Backend (Needed) (copy)_1516235341512081413]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Delivery Cost - Backend (Needed) (copy)_1516235341502976001] / sum([cnt_order])' />
      </column>
      <column caption='Vendor Funded Incentives % GMV' datatype='real' name='[DH Incentives % GMV (copy)_765400863828398090]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn(sum([incentives_other_incl_joker])) / (zn(sum([gfv])) + zn(SUM([delivery_fee_net])))' />
      </column>
      <column caption='Vendor Funded Incentives % Total Revenue' datatype='real' name='[DH Incentives % Total Revenue (copy)_765400863827808265]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn(sum([incentives_other_incl_joker])) / zn(sum([take_in]))' />
      </column>
      <column caption='Date Selector (switch)' datatype='date' name='[Date Selector (copy)_1254604363509874698]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 4]&#10;WHEN &apos;Daily&apos; THEN DATETRUNC(&apos;day&apos;,DATE([report_date] ))&#10;WHEN &apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;,DATE([report_date] ))&#10;WHEN &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;,DATE([report_date] ))&#10;WHEN &apos;Yearly&apos; THEN DATETRUNC(&apos;year&apos;,DATE([report_date] ))&#10;END)' />
      </column>
      <column caption='Profit Contribution per Order' datatype='real' name='[Delivery CPO (Switch) (copy)_3091369308851650603]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn(sum([Profit Contribution  Needed (copy)_3833759610179297321])) / zn(sum([cnt_order]))' />
      </column>
      <column caption='Delivery Cost negative' datatype='real' name='[Delivery Cost (copy)_6559915127277359109]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-[delivery_costs]' />
      </column>
      <column caption='DH Basket Incentives - Backend (Needed)' datatype='real' name='[Delivery Cost - Backend (Needed) (copy)_1516235341502976001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn(sum([dh_incentives]))' />
      </column>
      <column caption='Delivery Fee Revenue  LC adj  ' datatype='real' name='[Delivery Fee Revenue  EUR adj  (copy)_4587619968256208898]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED &#10;[management_entity], &#10;[sub_entity], &#10;[city_name], &#10;[zone_name],&#10;[city_tier], &#10;[Date Selector (copy)_1254604363509874698], &#10;[vertical] : &#10;zn(min([diff_delivery_fee_per_order_lc])) * zn(sum([cnt_order]))&#10;}' />
      </column>
      <column caption='Vendor Delivery Fee Revenue' datatype='real' name='[Delivery Fee Revenue (Net) (copy)_4934819329570955266]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_own_delivery] = FALSE &#10;THEN [delivery_fee_net]&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Delivery Fee Revenue Needed adj' datatype='real' name='[Delivery Fee Revenue Needed (copy)_3833759610157453343]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 2]=&apos;Eur&apos; then [Delivery Fee Revenue Needed adj (copy)_4587619968256053249]&#10;elseif [Parameters].[Parameter 2]=&apos;LC&apos; then [Delivery Fee Revenue  EUR adj  (copy)_4587619968256208898]&#10;end' />
      </column>
      <column caption='Delivery Fee Revenue  EUR adj ' datatype='real' name='[Delivery Fee Revenue Needed adj (copy)_4587619968256053249]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED &#10;[management_entity], &#10;[sub_entity], &#10;[city_name], &#10;[zone_name],&#10;[city_tier], &#10;[Date Selector (copy)_1254604363509874698], &#10;[vertical] : &#10;zn(min([diff_delivery_fee_per_order_eur])) * zn(sum([cnt_order]))&#10;}' />
      </column>
      <column caption='Full CM-I' datatype='real' name='[Full CM-I  (copy)_3833759609837535240]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn(sum([Profit Contribution  Needed (copy)_3833759610179297321])) + zn(sum([payment])) + zn(sum([food_delivery_accident]))&#10;//we sub the cost as in the calculation cost are negative' />
      </column>
      <column caption='CM-II (per Order) ' datatype='real' name='[Full CM-I  (per Order) (Switch) (copy)_3091369308853289007]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn([Profit Contribution per Order (Switch) (copy) (copy)_3091369308852039724]) - (-[Calculation_4351603169877401602]) - (-[Semi Variable Delivery CPO (Needed) (copy)_2648538851876663297])' />
      </column>
      <column caption='Fully Loaded GPO (0 - 0.5) - Zone' datatype='integer' name='[Fully Loaded GPO (0 - 0.5) - City (copy)_216665413714808879]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(IF max([is_own_delivery])= True &#10;THEN  &#10;sum({fixed [geo_view],[selected_view], &#10;           [currency_view],[management_entity],&#10;           [sub_entity],[is_own_delivery],&#10;           [city_name],&#10;           [zone_name],&#10;           [Weeks to show 2 (copy)_962644471521251332]: &#10;    IF (&#10;    Round(SUM([flgp])/ sum([cnt_order]), 2)   &gt;= 0 &#10;    AND &#10;    Round(SUM([flgp])/ sum([cnt_order]), 2)  &lt; 0.5  )&#10;    THEN &#10;        1&#10;    ELSE 0&#10;    END &#10;})&#10;ELSE NULL&#10;END )' />
      </column>
      <column caption='Fully Loaded GPO (0.5 - 1) - Zone' datatype='integer' name='[Fully Loaded GPO (0.5 - 1) - City (copy)_216665413714808880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(IF max([is_own_delivery])= True &#10;THEN  &#10;sum({fixed [geo_view],[selected_view], &#10;           [currency_view],[management_entity],&#10;           [sub_entity],[is_own_delivery],&#10;           [city_name],&#10;           [zone_name],&#10;           [Weeks to show 2 (copy)_962644471521251332]: &#10;    IF (&#10;     Round(SUM([flgp])/ sum([cnt_order]), 2)  &gt;= 0.5&#10;    AND  &#10;     Round(SUM([flgp])/ sum([cnt_order]), 2)  &lt; 1   )&#10;    THEN &#10;        1&#10;    ELSE 0&#10;    END &#10;})&#10;ELSE NULL&#10;END )' />
      </column>
      <column caption='Fully Loaded GPO (&lt; 0) - Zone' datatype='integer' name='[Fully Loaded GPO (&lt; 0) - City (copy)_216665413714808881]' role='measure' type='quantitative'>
