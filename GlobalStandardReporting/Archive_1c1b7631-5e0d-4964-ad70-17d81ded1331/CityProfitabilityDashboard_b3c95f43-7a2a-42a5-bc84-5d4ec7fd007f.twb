    <worksheet name='City - Zone Analytics - Sheet'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Tableau Regular' fontsize='16'>Unit Economics City View</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='city_profitability_daily (rl_intl_markets)' name='federated.0vsoy3a1elnygz14dw6f71t9faaz' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Level Selector' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0vsoy3a1elnygz14dw6f71t9faaz'>
            <column caption='AFV' datatype='real' name='[AFV Needed with adj (copy)_3091369308836245539]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(sum(gfv)) / zn(sum([cnt_order]))' />
            </column>
            <column caption='Avg. Commission Rate (GFV)' datatype='real' name='[Avg commission rate EUR org (copy)_3833759610137182228]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM ([commission]) /sum([gfv])' />
            </column>
            <column caption='UTR' datatype='real' name='[Calculation_2073485444705660930]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([delivered_orders])/ sum([working_hours])' />
            </column>
            <column caption='CPH' datatype='real' name='[Calculation_5059583122401681408]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF zn(-[Take-in Per Order (Switch) (copy)_3091369308851376170]) != 0 &#10;THEN zn(-[Take-in Per Order (Switch) (copy)_3091369308851376170])*zn([Calculation_2073485444705660930])&#10;else NULL&#10;end' />
            </column>
            <column caption='Vendor Density' datatype='real' name='[Calculation_5059583122405412865]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//1/sum([Area Size])&#10;[Calculation_5059583122728914952]/sum([Calculation_6559915127270592516])' />
            </column>
            <column caption='Vendor Count (1)' datatype='real' name='[Calculation_5059583122728914952]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(ifnull([vendor_count],0) )/ countd((DATETRUNC(&apos;day&apos;,[report_date])))' />
            </column>
            <column caption='DH Basket Incentives (per Order) (Switch)' datatype='real' name='[Calculation_5593611522887880705]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[DH Basket Incentives - Backend (Needed) (copy)_1516235341512081413]' />
            </column>
            <column caption='% Orders Succ' datatype='real' name='[Calculation_5714997592194273281]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cnt_order]) / TOTAL (sum([cnt_order]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Attr' datatype='integer' name='[Calculation_5825335771760947270]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Area Size' datatype='real' name='[Calculation_6559915127270592516]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#10;{FIXED &#10;[global_entity_id],&#10;[zone_name], &#10;[is_own_delivery],&#10;[currency_view],&#10;[selected_view], &#10;[geo_view]&#10;:max([area_size])} = 0 THEN NULL&#10;ELSE &#10;{FIXED &#10;[global_entity_id],&#10;[zone_name] , &#10;[is_own_delivery],&#10;[currency_view],&#10;[selected_view], &#10;[geo_view]&#10;:max([area_size])} &#10;END' />
            </column>
            <column caption='DH Basket Incentives (per Order) - Backend (Needed)' datatype='real' name='[DH Basket Incentives - Backend (Needed) (copy)_1516235341512081413]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Delivery Cost - Backend (Needed) (copy)_1516235341502976001] / sum([cnt_order])' />
            </column>
            <column caption='Date Selector (switch)' datatype='date' name='[Date Selector (copy)_1254604363509874698]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 4]&#10;WHEN &apos;Daily&apos; THEN DATETRUNC(&apos;day&apos;,DATE([report_date] ))&#10;WHEN &apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;,DATE([report_date] ))&#10;WHEN &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;,DATE([report_date] ))&#10;WHEN &apos;Yearly&apos; THEN DATETRUNC(&apos;year&apos;,DATE([report_date] ))&#10;END)' />
            </column>
            <column caption='DH Basket Incentives - Backend (Needed)' datatype='real' name='[Delivery Cost - Backend (Needed) (copy)_1516235341502976001]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(sum([dh_incentives]))' />
            </column>
            <column caption='Fully loaded GP0 ' datatype='real' name='[Fully loaded GP (Switch) (copy)_1516235341512515590]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(sum([flgp])) / zn(sum([cnt_order]))' />
            </column>
            <column caption='Delivery Costs Per Order' datatype='real' name='[Take-in Per Order (Switch) (copy)_3091369308851376170]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF max([is_own_delivery]) = TRUE &#10;THEN&#10;-(zn(sum([delivery_costs])) / zn(sum([cnt_order])))&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Gross Profit (per Order)' datatype='real' name='[Take-in Per Order (Switch) (copy)_3091369308860710960]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(sum([gp])) / zn(sum([cnt_order]))' />
            </column>
            <column caption='days in report' datatype='integer' name='[Vendor Density (copy)_5059583122406895618]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd((DATETRUNC(&apos;day&apos;,[report_date])))' />
            </column>
            <column caption='Order Density' datatype='real' name='[Vendor Density (copy)_5059583123116474382]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cnt_order])/sum([Calculation_6559915127270592516])/[Vendor Density (copy)_5059583122406895618]' />
            </column>
            <column caption='Vertical no dmart no kitchen' datatype='string' name='[Vertical (copy)_2428214264070807552]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[vertical]' />
            </column>
