    <worksheet name='Table Analytical'>
      <table>
        <view>
          <datasources>
            <datasource caption='city_profitability_daily (rl_intl_markets)' name='federated.0vsoy3a1elnygz14dw6f71t9faaz' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Analytical View KPIs Selector' datatype='string' name='[KPI&apos;s Selector (copy)_796292735376162816]' param-domain-type='list' role='measure' type='nominal' value='&quot;Gross Profit per Order&quot;'>
              <calculation class='tableau' formula='&quot;Gross Profit per Order&quot;' />
              <aliases>
                <alias key='&quot;Commission Rate&quot;' value='Commission Rate % (GFV Base)' />
              </aliases>
            </column>
            <column caption='City / Zone Selector' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;City&quot;'>
              <calculation class='tableau' formula='&quot;City&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.0vsoy3a1elnygz14dw6f71t9faaz].[Calculation_3215147949526245377]' caption='Reference Week' datatype='datetime' default-format='*dd - mmm - yy' name='[Parameter 6]' param-domain-type='list' role='measure' type='quantitative' value='#2021-05-31 00:00:00#'>
              <calculation class='tableau' formula='#2021-05-31 00:00:00#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0vsoy3a1elnygz14dw6f71t9faaz'>
            <column caption='# Order' datatype='integer' name='[# Order (label) (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(SUM([cnt_order]))' />
            </column>
            <column caption='AFV' datatype='real' name='[AFV Needed with adj (copy)_3091369308836245539]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(sum(gfv)) / zn(sum([cnt_order]))' />
            </column>
            <column caption='Avg. Commission Rate (GFV)' datatype='real' name='[Avg commission rate EUR org (copy)_3833759610137182228]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM ([commission]) /sum([gfv])' />
            </column>
            <column caption='Week ' datatype='datetime' name='[Calculation_11259024976678914]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;,[report_date])' />
            </column>
            <column caption='Weeks to show' datatype='boolean' name='[Calculation_11259024977764355]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[report_date],[Parameters].[Parameter 6]) &lt;= 28&#10;and DATEDIFF(&apos;day&apos;,[report_date],[Parameters].[Parameter 6]) &gt; -7' />
            </column>
            <column caption='UTR' datatype='real' name='[Calculation_2073485444705660930]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([delivered_orders])/ sum([working_hours])' />
            </column>
            <column caption='City / Zone   ' datatype='string' name='[Calculation_218424607868891139]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 5] = &apos;City&apos; then [city_name] &#10;elseif [Parameters].[Parameter 5] = &apos;Zone&apos; then [zone_name]&#10;end' />
            </column>
            <column caption='Weeks   ' datatype='datetime' datatype-customized='true' name='[Calculation_3215147949526245377]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if (not ISNULL((IF DATEPART(&apos;weekday&apos;, ([report_date])) = 7 THEN ([Calculation_11259024976678914]) end)) = True)&#10;&#10;then ([Calculation_11259024976678914])&#10;&#10;end' />
            </column>
            <column caption='CPH' datatype='real' name='[Calculation_5059583122401681408]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF zn(-[Take-in Per Order (Switch) (copy)_3091369308851376170]) != 0 &#10;THEN zn(-[Take-in Per Order (Switch) (copy)_3091369308851376170])*zn([Calculation_2073485444705660930])&#10;else NULL&#10;end' />
            </column>
            <column caption='Avg Delivery Time' datatype='real' name='[Calculation_582582863738773504]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(sum([delivery_time_m_sum])) / zn(sum([delivery_time_m_count]))' />
            </column>
            <column caption='Take-in Per Order' datatype='real' name='[Commission Rev. per Order (Switch) (copy)_3091369308847800361]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(sum([take_in])) / zn(sum([cnt_order]))' />
            </column>
            <column caption='Fully loaded GP0 ' datatype='real' name='[Fully loaded GP (Switch) (copy)_1516235341512515590]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(sum([flgp])) / zn(sum([cnt_order]))' />
            </column>
            <column caption='Is Own Delivery (copy)' datatype='boolean' name='[Is Own Delivery (copy)_6683623364923576320]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[is_own_delivery]' />
            </column>
            <column caption='Selector for KPI Analytical View Label' datatype='string' name='[Selector for KPI Analytical View (copy)_796292735423205379]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[KPI&apos;s Selector (copy)_796292735376162816]&#10;WHEN &quot;AFV&quot; THEN  STR(ROUND([AFV Needed with adj (copy)_3091369308836245539],2))&#10;WHEN &quot;Commission Rate&quot; THEN  STR(ROUND([Avg commission rate EUR org (copy)_3833759610137182228]*100,2))+ &apos; %&apos;&#10;WHEN &quot;Take-in per Order&quot; THEN  STR(ROUND([Commission Rev. per Order (Switch) (copy)_3091369308847800361],2))&#10;WHEN &quot;Delivery CPO&quot; THEN STR(ROUND([Take-in Per Order (Switch) (copy)_3091369308851376170],2))&#10;WHEN &quot;UTR&quot; THEN  STR(ROUND([Calculation_2073485444705660930],2))&#10;WHEN &quot;Implied CPH&quot; THEN  STR(ROUND([Calculation_5059583122401681408],2))&#10;WHEN &quot;DT Average (Min)&quot; THEN  STR(ROUND([Calculation_582582863738773504],0))&#10;WHEN &quot;Gross Profit per Order&quot; THEN  STR(ROUND([Take-in Per Order (Switch) (copy)_3091369308860710960],2))&#10;WHEN &quot;Fully Loaded GPO&quot; THEN STR(ROUND([Fully loaded GP (Switch) (copy)_1516235341512515590],2))&#10;WHEN &quot;Orders&quot; THEN STR(ROUND([# Order (label) (copy)],0))&#10;//WHEN &quot;Incentives Per Order&quot; then STR(ROUND([DH Basket Incentives (per Order) (Switch) - WoW Operational Performance],2))&#10;END&#10;&#10;&#10;//if [Joker KPIs]=&apos;Joker Sold&apos; then STR(sum([Joker Sold]))&#10;//elseif [Joker KPIs]=&apos;% Of Total Orders&apos; then STR(ROUND([Sold Joker/Orders]*100,2))+ &apos; %&apos;&#10;//elseif [Joker KPIs]=&apos;Joker GMV&apos; then STR(ROUND(sum([Joker Gmv Eur]),0))+&apos; &apos;+ &apos;€&apos;&#10;//elseif [Joker KPIs]=&apos;Joker Revenue&apos; then STR(ROUND(sum([Amt Joker Eur]),0))+&apos; &apos;+ &apos;€&apos;&#10;//elseif [Joker KPIs]=&apos;% Total Revenue&apos; then STR(ROUND([Joker Revenue / Total Revenue]*100,2))+ &apos; %&apos;&#10;//elseif [Joker KPIs]=&apos;% Total GMV&apos; then STR(ROUND([Joker / GMV]*100,2))+ &apos; %&apos;&#10;//elseif [Joker KPIs]=&apos;Joker Restaurant&apos; then STR(sum([Joker Resto]))&#10;//elseif [Joker KPIs]=&apos;% Total Restaurant&apos; then STR(ROUND([Joker Resto / Total Resto]*100,2))+ &apos; %&apos;&#10;//elseif [Joker KPIs]=&apos;% Inventory Sold&apos; then STR(ROUND([% Inventory Sold]*100,2))+ &apos; %&apos;&#10;//elseif [Joker KPIs]=&apos;Lightboxes&apos; then STR(sum([Lightbox Count]))&#10;//elseif [Joker KPIs]=&apos;Offers Per Lightbox&apos; then STR(ROUND([Promotions / Light Box],0))&#10;//elseif [Joker KPIs]=&apos;CVR&apos; then STR(ROUND([Joker CVR]*100,2))+ &apos; %&apos;&#10;//END' />
            </column>
            <column caption='Delivery Costs Per Order' datatype='real' name='[Take-in Per Order (Switch) (copy)_3091369308851376170]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF max([is_own_delivery]) = TRUE &#10;THEN&#10;-(zn(sum([delivery_costs])) / zn(sum([cnt_order])))&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Gross Profit (per Order)' datatype='real' name='[Take-in Per Order (Switch) (copy)_3091369308860710960]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(sum([gp])) / zn(sum([cnt_order]))' />
            </column>
            <column caption='Vertical no dmart no kitchen' datatype='string' name='[Vertical (copy)_2428214264070807552]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[vertical]' />
            </column>
