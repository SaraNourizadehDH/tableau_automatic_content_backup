    <worksheet name='KPI Comparison - Sheet'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#364246' fontname='.Al Nile PUA' fontsize='20'>Unit Economics</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='city_profitability_daily (rl_intl_markets)' name='federated.0vsoy3a1elnygz14dw6f71t9faaz' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Level Selector' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
            <column caption='KPI&apos;s Selector' datatype='string' name='[Placeholder 1 Selector (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;Fully Loaded GPO&quot;'>
              <calculation class='tableau' formula='&quot;Fully Loaded GPO&quot;' />
              <aliases>
                <alias key='&quot;Commission Rate&quot;' value='Commission Rate % (GFV Base)' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0vsoy3a1elnygz14dw6f71t9faaz'>
            <column caption='Delivery Fee per Order' datatype='real' name='[AFV (Switch) (copy)_3091369308845862951]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF max([is_own_delivery]) = TRUE &#10;THEN &#10;zn(sum([Calculation_4934819329570529281])) /zn(sum([cnt_order]))&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='AFV' datatype='real' name='[AFV Needed with adj (copy)_3091369308836245539]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(sum(gfv)) / zn(sum([cnt_order]))' />
            </column>
            <column caption='Other Revenue Per Order' datatype='real' name='[Average Delivery Fee Needed adj (copy)_5296162856167690244]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(sum([other_revenue])) / zn(sum([cnt_order]))' />
            </column>
            <column caption='Avg. Commission Rate (GFV)' datatype='real' name='[Avg commission rate EUR org (copy)_3833759610137182228]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM ([commission]) /sum([gfv])' />
            </column>
            <column caption='UTR' datatype='real' name='[Calculation_2073485444705660930]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([delivered_orders])/ sum([working_hours])' />
            </column>
            <column caption='Payment CPO' datatype='real' name='[Calculation_4351603169876963328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([payment]))/ (sum([cnt_order]))' />
            </column>
            <column caption='Food Delivery Accident CPO ' datatype='real' name='[Calculation_4351603169877245953]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([Calculation_4934819329849315339])) / (sum([cnt_order]))' />
            </column>
            <column caption='Semi Variable Delivery CPO' datatype='real' name='[Calculation_4351603169877401602]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([Calculation_4934819329849868300]))/ (sum([cnt_order]))' />
            </column>
            <column caption='Other Non Specific Delivery CPO' datatype='real' name='[Calculation_4351603169877561347]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([other_non_specific_delivery])) / (sum([cnt_order]))' />
            </column>
            <column caption='Delivery Fee Revenue (Net)' datatype='real' name='[Calculation_4934819329570529281]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_own_delivery] = TRUE &#10;THEN [delivery_fee_net]&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Food Delivery Accident Calc' datatype='real' name='[Calculation_4934819329849315339]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_own_delivery] = TRUE &#10;THEN [food_delivery_accident]&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Semi Variable Delivery Calc' datatype='real' name='[Calculation_4934819329849868300]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_own_delivery] = TRUE &#10;THEN [semi_variable_delivery]&#10;ELSE NULL &#10;END' />
            </column>
            <column caption='CPH' datatype='real' name='[Calculation_5059583122401681408]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF zn(-[Take-in Per Order (Switch) (copy)_3091369308851376170]) != 0 &#10;THEN zn(-[Take-in Per Order (Switch) (copy)_3091369308851376170])*zn([Calculation_2073485444705660930])&#10;else NULL&#10;end' />
            </column>
            <column caption='Avg Delivery Time' datatype='real' name='[Calculation_582582863738773504]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(sum([delivery_time_m_sum])) / zn(sum([delivery_time_m_count]))' />
            </column>
            <column caption='Area Size' datatype='real' name='[Calculation_6559915127270592516]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#10;{FIXED &#10;[global_entity_id],&#10;[zone_name], &#10;[is_own_delivery],&#10;[currency_view],&#10;[selected_view], &#10;[geo_view]&#10;:max([area_size])} = 0 THEN NULL&#10;ELSE &#10;{FIXED &#10;[global_entity_id],&#10;[zone_name] , &#10;[is_own_delivery],&#10;[currency_view],&#10;[selected_view], &#10;[geo_view]&#10;:max([area_size])} &#10;END' />
            </column>
            <column caption='Take-in Per Order' datatype='real' name='[Commission Rev. per Order (Switch) (copy)_3091369308847800361]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(sum([take_in])) / zn(sum([cnt_order]))' />
            </column>
            <column caption='Commission Rev. per Order (Net)' datatype='real' name='[Commission Rev. per Order - Reconciled (Needed) (copy)_3091369308838834212]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(sum([commission])) / zn(sum([cnt_order]))' />
            </column>
            <column caption='Date Selector (switch)' datatype='date' name='[Date Selector (copy)_1254604363509874698]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 4]&#10;WHEN &apos;Daily&apos; THEN DATETRUNC(&apos;day&apos;,DATE([report_date] ))&#10;WHEN &apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;,DATE([report_date] ))&#10;WHEN &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;,DATE([report_date] ))&#10;WHEN &apos;Yearly&apos; THEN DATETRUNC(&apos;year&apos;,DATE([report_date] ))&#10;END)' />
            </column>
            <column caption='Profit Contribution per Order' datatype='real' name='[Delivery CPO (Switch) (copy)_3091369308851650603]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(sum([Profit Contribution  Needed (copy)_3833759610179297321])) / zn(sum([cnt_order]))' />
            </column>
            <column caption='Full CM-I' datatype='real' name='[Full CM-I  (copy)_3833759609837535240]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(sum([Profit Contribution  Needed (copy)_3833759610179297321])) + zn(sum([payment])) + zn(sum([food_delivery_accident]))&#10;//we sub the cost as in the calculation cost are negative' />
            </column>
            <column caption='CM-II (per Order) ' datatype='real' name='[Full CM-I  (per Order) (Switch) (copy)_3091369308853289007]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn([Profit Contribution per Order (Switch) (copy) (copy)_3091369308852039724]) - (-[Calculation_4351603169877401602]) - (-[Semi Variable Delivery CPO (Needed) (copy)_2648538851876663297])' />
            </column>
            <column caption='Fully loaded GP0 ' datatype='real' name='[Fully loaded GP (Switch) (copy)_1516235341512515590]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(sum([flgp])) / zn(sum([cnt_order]))' />
            </column>
            <column caption='Card Fee Revenue Per Order' datatype='real' name='[Other Revenue Per Order Needed (copy)_5296162856167972869]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(sum([card_fee_revenue])) / zn(sum([cnt_order]))' />
            </column>
            <column caption='Selector for KPI' datatype='real' name='[Placeholder 1 (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Placeholder 1 Selector (copy)]&#10;WHEN &quot;AFV&quot; THEN  [AFV Needed with adj (copy)_3091369308836245539]&#10;WHEN &quot;Commission Revenue per Order&quot; THEN  [Commission Rev. per Order - Reconciled (Needed) (copy)_3091369308838834212]&#10;WHEN &quot;Commission Rate&quot; THEN  [Avg commission rate EUR org (copy)_3833759610137182228]*100&#10;WHEN &quot;Delivery Fee per Order&quot; THEN [AFV (Switch) (copy)_3091369308845862951]&#10;WHEN &quot;Card Fee Revenue per Order&quot; THEN [Other Revenue Per Order Needed (copy)_5296162856167972869]&#10;WHEN &quot;Other Revenue per Order&quot; THEN [Average Delivery Fee Needed adj (copy)_5296162856167690244]&#10;WHEN &quot;Take-in per Order&quot; THEN  [Commission Rev. per Order (Switch) (copy)_3091369308847800361]&#10;WHEN &quot;Delivery CPO&quot; THEN [Take-in Per Order (Switch) (copy)_3091369308851376170]&#10;WHEN &quot;UTR&quot; THEN  [Calculation_2073485444705660930]&#10;WHEN &quot;Implied CPH&quot; THEN  [Calculation_5059583122401681408]&#10;WHEN &quot;DT Average (Min)&quot; THEN  [Calculation_582582863738773504]&#10;WHEN &quot;CM I Per Order&quot; THEN [Delivery CPO (Switch) (copy)_3091369308851650603]&#10;WHEN &quot;Payment CPO&quot; THEN  [Calculation_4351603169876963328]&#10;WHEN &quot;Food Delivery Accident CPO&quot; THEN [Calculation_4351603169877245953]&#10;WHEN &quot;Full CM-I (per Order)&quot; THEN [Profit Contribution per Order (Switch) (copy) (copy)_3091369308852039724]&#10;WHEN &quot;Semi Variable Delivery CPO&quot; THEN [Calculation_4351603169877401602]&#10;WHEN &quot;Shoper Cost CPO&quot; THEN [Semi Variable Delivery CPO (Needed) (copy)_2648538851876663297]&#10;WHEN &quot;CM-II (per Order)&quot; THEN [Full CM-I  (per Order) (Switch) (copy)_3091369308853289007]&#10;WHEN &quot;Other Non Specific Delivery CPO&quot; THEN [Calculation_4351603169877561347]&#10;WHEN &quot;Gross Profit per Order&quot; THEN  [Take-in Per Order (Switch) (copy)_3091369308860710960]&#10;WHEN &quot;Fully Loaded GPO&quot; THEN [Fully loaded GP (Switch) (copy)_1516235341512515590]&#10;//WHEN &quot;Vendor Density&quot; THEN [Vendor Density]&#10;WHEN &quot;Order Density&quot; THEN [Vendor Density (copy)_5059583123116474382]&#10;END' />
            </column>
            <column caption='Profit Contribution' datatype='real' name='[Profit Contribution  Needed (copy)_3833759610179297321]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn([take_in]) + zn(-([delivery_costs]))&#10;//we sub the cost as in the calculation cost are negative' />
            </column>
            <column caption='Full CM-I  (per Order) ' datatype='real' name='[Profit Contribution per Order (Switch) (copy) (copy)_3091369308852039724]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(([Full CM-I  (copy)_3833759609837535240])) / zn(sum([cnt_order]))' />
            </column>
            <column caption='Shoper Cost CPO' datatype='real' name='[Semi Variable Delivery CPO (Needed) (copy)_2648538851876663297]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([shopper_costs]))/ (sum([cnt_order]))' />
            </column>
            <column caption='Delivery Costs Per Order' datatype='real' name='[Take-in Per Order (Switch) (copy)_3091369308851376170]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF max([is_own_delivery]) = TRUE &#10;THEN&#10;-(zn(sum([delivery_costs])) / zn(sum([cnt_order])))&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Gross Profit (per Order)' datatype='real' name='[Take-in Per Order (Switch) (copy)_3091369308860710960]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(sum([gp])) / zn(sum([cnt_order]))' />
            </column>
            <column caption='days in report' datatype='integer' name='[Vendor Density (copy)_5059583122406895618]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd((DATETRUNC(&apos;day&apos;,[report_date])))' />
            </column>
            <column caption='Order Density' datatype='real' name='[Vendor Density (copy)_5059583123116474382]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cnt_order])/sum([Calculation_6559915127270592516])/[Vendor Density (copy)_5059583122406895618]' />
            </column>
            <column caption='Vertical no dmart no kitchen' datatype='string' name='[Vertical (copy)_2428214264070807552]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[vertical]' />
            </column>
            <column caption='Area Size Old' datatype='real' name='[area_size]' role='measure' type='quantitative' />
            <column caption='Card Fee Revenue' datatype='real' name='[card_fee_revenue]' role='measure' type='quantitative' />
            <column caption='City Name' datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='City Tier' datatype='integer' name='[city_tier]' role='measure' type='quantitative' />
            <column caption='Cnt Order' datatype='integer' name='[cnt_order]' role='measure' type='quantitative' />
            <column caption='Commission' datatype='real' name='[commission]' role='measure' type='quantitative' />
            <column caption='Currency View' datatype='string' name='[currency_view]' role='dimension' type='nominal' />
            <column caption='Delivered Orders' datatype='integer' name='[delivered_orders]' role='measure' type='quantitative' />
            <column caption='Delivery Cost' datatype='real' name='[delivery_costs]' role='measure' type='quantitative' />
            <column caption='Delivery Fee Net' datatype='real' name='[delivery_fee_net]' role='measure' type='quantitative' />
            <column caption='Delivery Time M Count' datatype='real' name='[delivery_time_m_count]' role='measure' type='quantitative' />
            <column caption='Delivery Time M Sum' datatype='real' name='[delivery_time_m_sum]' role='measure' type='quantitative' />
            <column caption='Delivery Type' datatype='string' name='[delivery_type]' role='dimension' type='nominal' />
            <column caption='Flgp' datatype='real' name='[flgp]' role='measure' type='quantitative' />
            <column caption='Food Delivery Accident' datatype='real' name='[food_delivery_accident]' role='measure' type='quantitative' />
            <column caption='Geo View' datatype='string' name='[geo_view]' role='dimension' type='nominal' />
            <column caption='Gfv' datatype='real' name='[gfv]' role='measure' type='quantitative' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Gp' datatype='real' name='[gp]' role='measure' type='quantitative' />
            <column caption='Is Own Delivery' datatype='boolean' name='[is_own_delivery]' role='dimension' type='nominal' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column-instance column='[Date Selector (copy)_1254604363509874698]' derivation='MDY' name='[md:Date Selector (copy)_1254604363509874698:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Date Selector (copy)_1254604363509874698]' derivation='None' name='[none:Date Selector (copy)_1254604363509874698:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Vertical (copy)_2428214264070807552]' derivation='None' name='[none:Vertical (copy)_2428214264070807552:nk]' pivot='key' type='nominal' />
            <column-instance column='[city_name]' derivation='None' name='[none:city_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[city_tier]' derivation='None' name='[none:city_tier:ok]' pivot='key' type='ordinal' />
            <column-instance column='[currency_view]' derivation='None' name='[none:currency_view:nk]' pivot='key' type='nominal' />
            <column-instance column='[delivery_type]' derivation='None' name='[none:delivery_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[is_own_delivery]' derivation='None' name='[none:is_own_delivery:nk]' pivot='key' type='nominal' />
            <column-instance column='[management_entity]' derivation='None' name='[none:management_entity:nk]' pivot='key' type='nominal' />
            <column-instance column='[selected_view]' derivation='None' name='[none:selected_view:nk]' pivot='key' type='nominal' />
            <column-instance column='[sub_entity]' derivation='None' name='[none:sub_entity:nk]' pivot='key' type='nominal' />
            <column-instance column='[vertical]' derivation='None' name='[none:vertical:nk]' pivot='key' type='nominal' />
            <column-instance column='[zone_name]' derivation='None' name='[none:zone_name:nk]' pivot='key' type='nominal' />
