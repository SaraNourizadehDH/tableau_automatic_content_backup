    <worksheet name='City View (UE) (Switch) - Sheet (showcity)'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Tableau Regular' fontsize='16'>Unit Economics City View</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='city_profitability_daily (rl_intl_markets)' name='federated.0vsoy3a1elnygz14dw6f71t9faaz' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Level Selector' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
            <column caption='Show/Hide Cities' datatype='string' name='[Parameter 7]' param-domain-type='list' role='measure' type='nominal' value='&quot;Hide Cities&quot;'>
              <calculation class='tableau' formula='&quot;Hide Cities&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0vsoy3a1elnygz14dw6f71t9faaz'>
            <column caption='Delivery Fee per Order' datatype='real' name='[AFV (Switch) (copy)_3091369308845862951]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF max([is_own_delivery]) = TRUE &#10;THEN &#10;zn(sum([Calculation_4934819329570529281])) /zn(sum([cnt_order]))&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='AFV' datatype='real' name='[AFV Needed with adj (copy)_3091369308836245539]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(sum(gfv)) / zn(sum([cnt_order]))' />
            </column>
            <column caption='Other Revenue Per Order' datatype='real' name='[Average Delivery Fee Needed adj (copy)_5296162856167690244]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(sum([other_revenue])) / zn(sum([cnt_order]))' />
            </column>
            <column caption='Avg. Commission Rate (GFV)' datatype='real' name='[Avg commission rate EUR org (copy)_3833759610137182228]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM ([commission]) /sum([gfv])' />
            </column>
            <column caption='Avg. Commission Rate (Commissionable Base)' datatype='real' default-format='p0.0%' name='[Avg. Commission Rate (GFV) (copy)_4045147310892630016]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM ([commission]) / sum([commission_base_sales_def])' />
            </column>
            <column caption='UTR' datatype='real' name='[Calculation_2073485444705660930]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([delivered_orders])/ sum([working_hours])' />
            </column>
            <column caption='AOV' datatype='real' name='[Calculation_2480709378783600640]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv])/sum([cnt_order])' />
            </column>
            <column caption='is_competitive_calculation' datatype='string' name='[Calculation_357754726944247809]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF str([is_competitive]) = &apos;1&apos; then &apos;Yes*&apos;&#10;elseif str([is_competitive]) = &apos;0&apos; then &apos;No*&apos;&#10;ELSE &apos;N/A&apos;&#10;END' />
            </column>
            <column caption='Payment CPO' datatype='real' name='[Calculation_4351603169876963328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([payment]))/ (sum([cnt_order]))' />
            </column>
            <column caption='Food Delivery Accident CPO ' datatype='real' name='[Calculation_4351603169877245953]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([Calculation_4934819329849315339])) / (sum([cnt_order]))' />
            </column>
            <column caption='Semi Variable Delivery CPO' datatype='real' name='[Calculation_4351603169877401602]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([Calculation_4934819329849868300]))/ (sum([cnt_order]))' />
            </column>
            <column caption='Other Non Specific Delivery CPO' datatype='real' name='[Calculation_4351603169877561347]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([other_non_specific_delivery])) / (sum([cnt_order]))' />
            </column>
            <column caption='Delivery Fee Revenue (Net)' datatype='real' name='[Calculation_4934819329570529281]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_own_delivery] = TRUE &#10;THEN [delivery_fee_net]&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Commission Revenue (Gross)' datatype='real' name='[Calculation_4934819329572790275]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(sum([commission])) - zn(sum([dh_pick_up_incentives]))' />
            </column>
            <column caption='Vendor Delivery Fee per Order' datatype='real' name='[Calculation_4934819329574486020]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Delivery Fee Revenue (Net) (copy)_4934819329570955266]) / sum([cnt_order])' />
            </column>
            <column caption='DH Pickup Incentives per Order' datatype='real' name='[Calculation_4934819329575370759]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([dh_pick_up_incentives]) / sum([cnt_order])' />
            </column>
            <column caption='DH Basket Incentives per Order' datatype='real' name='[Calculation_4934819329576456200]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_4934819329845710857]) / sum([cnt_order])' />
            </column>
            <column caption='Dh Incentives No Pick Up calc' datatype='real' name='[Calculation_4934819329845710857]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-[dh_incentives_no_pick_up]' />
            </column>
            <column caption='Food Delivery Accident Calc' datatype='real' name='[Calculation_4934819329849315339]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_own_delivery] = TRUE &#10;THEN [food_delivery_accident]&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Semi Variable Delivery Calc' datatype='real' name='[Calculation_4934819329849868300]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_own_delivery] = TRUE &#10;THEN [semi_variable_delivery]&#10;ELSE NULL &#10;END' />
            </column>
            <column caption='CPH' datatype='real' name='[Calculation_5059583122401681408]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF zn(-[Take-in Per Order (Switch) (copy)_3091369308851376170]) != 0 &#10;THEN zn(-[Take-in Per Order (Switch) (copy)_3091369308851376170])*zn([Calculation_2073485444705660930])&#10;else NULL&#10;end' />
            </column>
            <column caption='Avg Delivery Time' datatype='real' name='[Calculation_582582863738773504]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(sum([delivery_time_m_sum])) / zn(sum([delivery_time_m_count]))' />
            </column>
            <column caption='p. Show/Hide Cities' datatype='string' name='[Calculation_6423399768648433664]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 7]' />
            </column>
            <column caption='City Name Hierarchy' datatype='string' name='[City Name (copy)_2453898909309128705]' role='dimension' semantic-role='[City].[Name]' type='nominal'>
              <calculation class='tableau' formula='[city_name]' />
            </column>
            <column caption='Commission Rev. per Order (Gross)' datatype='real' name='[Commission Rev. per Order (Net) (copy)_4934819329575120902]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(([Calculation_4934819329572790275])) / zn(sum([cnt_order]))' />
            </column>
            <column caption='Take-in Per Order' datatype='real' name='[Commission Rev. per Order (Switch) (copy)_3091369308847800361]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(sum([take_in])) / zn(sum([cnt_order]))' />
            </column>
            <column caption='Commissionable Base per Order (copy)' datatype='real' name='[Commission Rev. per Order (copy)_4149855986091880448]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(sum([commission_base_sales_def])) / zn(sum([cnt_order]))' />
            </column>
            <column caption='Vendor Funded Incentives. per Order' datatype='real' name='[Commission Rev. per Order (copy)_4149855986092122113]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(sum([incentives_other_incl_joker])) / zn(sum([cnt_order]))' />
            </column>
            <column caption='Commission Rev. per Order (Net)' datatype='real' name='[Commission Rev. per Order - Reconciled (Needed) (copy)_3091369308838834212]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(sum([commission])) / zn(sum([cnt_order]))' />
            </column>
            <column caption='Date Selector (switch)' datatype='date' name='[Date Selector (copy)_1254604363509874698]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 4]&#10;WHEN &apos;Daily&apos; THEN DATETRUNC(&apos;day&apos;,DATE([report_date] ))&#10;WHEN &apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;,DATE([report_date] ))&#10;WHEN &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;,DATE([report_date] ))&#10;WHEN &apos;Yearly&apos; THEN DATETRUNC(&apos;year&apos;,DATE([report_date] ))&#10;END)' />
            </column>
            <column caption='Profit Contribution per Order' datatype='real' name='[Delivery CPO (Switch) (copy)_3091369308851650603]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(sum([Profit Contribution  Needed (copy)_3833759610179297321])) / zn(sum([cnt_order]))' />
            </column>
            <column caption='Vendor Delivery Fee Revenue' datatype='real' name='[Delivery Fee Revenue (Net) (copy)_4934819329570955266]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_own_delivery] = FALSE &#10;THEN [delivery_fee_net]&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Full CM-I' datatype='real' name='[Full CM-I  (copy)_3833759609837535240]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(sum([Profit Contribution  Needed (copy)_3833759610179297321])) + zn(sum([payment])) + zn(sum([food_delivery_accident]))&#10;//we sub the cost as in the calculation cost are negative' />
            </column>
            <column caption='CM-II (per Order) ' datatype='real' name='[Full CM-I  (per Order) (Switch) (copy)_3091369308853289007]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn([Profit Contribution per Order (Switch) (copy) (copy)_3091369308852039724]) - (-[Calculation_4351603169877401602]) - (-[Semi Variable Delivery CPO (Needed) (copy)_2648538851876663297])' />
            </column>
            <column caption='Fully Loaded GPO as % of GMV (copy)' datatype='real' name='[Fully Loaded GPO as % of GMV (copy)_2480709378787393537]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(sum(flgp)) / (zn(sum([gfv])) + zn(sum([delivery_fee_net])))' />
            </column>
            <column caption='Fully loaded GP0 ' datatype='real' name='[Fully loaded GP (Switch) (copy)_1516235341512515590]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(sum([flgp])) / zn(sum([cnt_order]))' />
            </column>
            <column caption='Gross Profit per Order as % of GMV' datatype='real' name='[Gross Profit as % of GMV (copy)_1462966202858930179]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn([Take-in Per Order (Switch) (copy)_3091369308860710960] )/  zn( [AFV Needed with adj (copy)_3091369308836245539] + [AFV (Switch) (copy)_3091369308845862951])' />
            </column>
            <column caption='Card Fee Revenue Per Order' datatype='real' name='[Other Revenue Per Order Needed (copy)_5296162856167972869]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(sum([card_fee_revenue])) / zn(sum([cnt_order]))' />
            </column>
            <column caption='Profit Contribution' datatype='real' name='[Profit Contribution  Needed (copy)_3833759610179297321]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn([take_in]) + zn(-([delivery_costs]))&#10;//we sub the cost as in the calculation cost are negative' />
            </column>
            <column caption='Full CM-I  (per Order) ' datatype='real' name='[Profit Contribution per Order (Switch) (copy) (copy)_3091369308852039724]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(([Full CM-I  (copy)_3833759609837535240])) / zn(sum([cnt_order]))' />
            </column>
            <column caption='Shoper Cost CPO' datatype='real' name='[Semi Variable Delivery CPO (Needed) (copy)_2648538851876663297]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([shopper_costs]))/ (sum([cnt_order]))' />
