      <column caption='Explanation' datatype='string' name='[Reconciled (copy)_3091369307669782561]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [selected_view]= &apos;Back-End&apos; Then &apos;&quot;Back-End&quot; denotes a view in which back-end order-level data is displayed without adjustments, hence aggregate data does not match Lucanet exactly.&apos;&#10;Else &apos;&quot;Reconciled&quot; denotes a view in which country-level per order adjustments have been applied to each order-level data item from the back end, to match Lucanet aggregate country-level figures.&apos;&#10;END' />
      </column>
      <column caption='Select Sheet 2' datatype='string' name='[Select Sheet   (copy)_216665413486784536]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Analytical View KPIs Selector (copy)_5593611523773886472]&#10;WHEN &quot;GP&quot; THEN &quot;Gross Profit&quot;&#10;WHEN &quot;Fully Loaded GP&quot; THEN  &quot;Fully loaded GP&quot; &#10;end' />
      </column>
      <column caption='Selector for KPI Analytical View' datatype='real' name='[Selector for KPI (copy)_796292735378178049]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[KPI&apos;s Selector (copy)_796292735376162816]&#10;WHEN &quot;AFV&quot; THEN  [AFV Needed with adj (copy)_3091369308836245539]&#10;WHEN &quot;Commission Rate&quot; THEN  [Avg commission rate EUR org (copy)_3833759610137182228]*100&#10;WHEN &quot;Take-in per Order&quot; THEN  [Commission Rev. per Order (Switch) (copy)_3091369308847800361]&#10;WHEN &quot;Delivery CPO&quot; THEN [Take-in Per Order (Switch) (copy)_3091369308851376170]&#10;WHEN &quot;UTR&quot; THEN  [Calculation_2073485444705660930]&#10;WHEN &quot;Implied CPH&quot; THEN  [Calculation_5059583122401681408]&#10;WHEN &quot;DT Average (Min)&quot; THEN  [Calculation_582582863738773504]&#10;WHEN &quot;Gross Profit per Order&quot; THEN  [Take-in Per Order (Switch) (copy)_3091369308860710960]&#10;WHEN &quot;Fully Loaded GPO&quot; THEN [Fully loaded GP (Switch) (copy)_1516235341512515590]&#10;WHEN &quot;Orders&quot; THEN [# Order (label) (copy)]&#10;//WHEN &quot;Incentives Per Order&quot; then [DH Basket Incentives (per Order) - Backend (Needed)]&#10;END' />
      </column>
      <column caption='City KPIs Selector %' datatype='real' name='[Selector for KPI Analytical View (copy)_5593611523775336457]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Analytical View KPIs Selector (copy)_5593611523773886472]&#10;WHEN &quot;GP&quot; THEN [% of Cities Fully loaded GP positive (with Date Selector switch) (copy)_5593611523934699530]&#10;WHEN &quot;Fully Loaded GP&quot; THEN  [# of Cities Fully loaded GP positive (with Date Selector switch)  (copy)_5593611523763707909]end' />
      </column>
      <column caption='Selector for KPI Analytical View Label' datatype='string' name='[Selector for KPI Analytical View (copy)_796292735423205379]' role='measure' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[KPI&apos;s Selector (copy)_796292735376162816]&#10;WHEN &quot;AFV&quot; THEN  STR(ROUND([AFV Needed with adj (copy)_3091369308836245539],2))&#10;WHEN &quot;Commission Rate&quot; THEN  STR(ROUND([Avg commission rate EUR org (copy)_3833759610137182228]*100,2))+ &apos; %&apos;&#10;WHEN &quot;Take-in per Order&quot; THEN  STR(ROUND([Commission Rev. per Order (Switch) (copy)_3091369308847800361],2))&#10;WHEN &quot;Delivery CPO&quot; THEN STR(ROUND([Take-in Per Order (Switch) (copy)_3091369308851376170],2))&#10;WHEN &quot;UTR&quot; THEN  STR(ROUND([Calculation_2073485444705660930],2))&#10;WHEN &quot;Implied CPH&quot; THEN  STR(ROUND([Calculation_5059583122401681408],2))&#10;WHEN &quot;DT Average (Min)&quot; THEN  STR(ROUND([Calculation_582582863738773504],0))&#10;WHEN &quot;Gross Profit per Order&quot; THEN  STR(ROUND([Take-in Per Order (Switch) (copy)_3091369308860710960],2))&#10;WHEN &quot;Fully Loaded GPO&quot; THEN STR(ROUND([Fully loaded GP (Switch) (copy)_1516235341512515590],2))&#10;WHEN &quot;Orders&quot; THEN STR(ROUND([# Order (label) (copy)],0))&#10;//WHEN &quot;Incentives Per Order&quot; then STR(ROUND([DH Basket Incentives (per Order) (Switch) - WoW Operational Performance],2))&#10;END&#10;&#10;&#10;//if [Joker KPIs]=&apos;Joker Sold&apos; then STR(sum([Joker Sold]))&#10;//elseif [Joker KPIs]=&apos;% Of Total Orders&apos; then STR(ROUND([Sold Joker/Orders]*100,2))+ &apos; %&apos;&#10;//elseif [Joker KPIs]=&apos;Joker GMV&apos; then STR(ROUND(sum([Joker Gmv Eur]),0))+&apos; &apos;+ &apos;€&apos;&#10;//elseif [Joker KPIs]=&apos;Joker Revenue&apos; then STR(ROUND(sum([Amt Joker Eur]),0))+&apos; &apos;+ &apos;€&apos;&#10;//elseif [Joker KPIs]=&apos;% Total Revenue&apos; then STR(ROUND([Joker Revenue / Total Revenue]*100,2))+ &apos; %&apos;&#10;//elseif [Joker KPIs]=&apos;% Total GMV&apos; then STR(ROUND([Joker / GMV]*100,2))+ &apos; %&apos;&#10;//elseif [Joker KPIs]=&apos;Joker Restaurant&apos; then STR(sum([Joker Resto]))&#10;//elseif [Joker KPIs]=&apos;% Total Restaurant&apos; then STR(ROUND([Joker Resto / Total Resto]*100,2))+ &apos; %&apos;&#10;//elseif [Joker KPIs]=&apos;% Inventory Sold&apos; then STR(ROUND([% Inventory Sold]*100,2))+ &apos; %&apos;&#10;//elseif [Joker KPIs]=&apos;Lightboxes&apos; then STR(sum([Lightbox Count]))&#10;//elseif [Joker KPIs]=&apos;Offers Per Lightbox&apos; then STR(ROUND([Promotions / Light Box],0))&#10;//elseif [Joker KPIs]=&apos;CVR&apos; then STR(ROUND([Joker CVR]*100,2))+ &apos; %&apos;&#10;//END' />
      </column>
      <column caption='Shoper Cost CPO' datatype='real' name='[Semi Variable Delivery CPO (Needed) (copy)_2648538851876663297]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([shopper_costs]))/ (sum([cnt_order]))' />
      </column>
      <column caption='Sub Entity hierarchy' datatype='string' name='[Sub Entity (copy)_2453898909309046784]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[sub_entity]' />
      </column>
      <column caption='Delivery Costs Per Order' datatype='real' name='[Take-in Per Order (Switch) (copy)_3091369308851376170]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF max([is_own_delivery]) = TRUE &#10;THEN&#10;-(zn(sum([delivery_costs])) / zn(sum([cnt_order])))&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Gross Profit (per Order)' datatype='real' name='[Take-in Per Order (Switch) (copy)_3091369308860710960]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn(sum([gp])) / zn(sum([cnt_order]))' />
      </column>
      <column caption='days in report' datatype='integer' name='[Vendor Density (copy)_5059583122406895618]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd((DATETRUNC(&apos;day&apos;,[report_date])))' />
      </column>
      <column caption='Order Density' datatype='real' name='[Vendor Density (copy)_5059583123116474382]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([cnt_order])/sum([Calculation_6559915127270592516])/[Vendor Density (copy)_5059583122406895618]' />
      </column>
      <column caption='Joker Incentives per Order ' datatype='real' name='[Vendor Funded Incentives. per Order (copy)_4934819328504410112]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([joker_vendor_fee])) / (sum([cnt_order]))' />
      </column>
      <column caption='Vertical no dmart no kitchen' datatype='string' name='[Vertical (copy)_2428214264070807552]' role='dimension' type='nominal'>
