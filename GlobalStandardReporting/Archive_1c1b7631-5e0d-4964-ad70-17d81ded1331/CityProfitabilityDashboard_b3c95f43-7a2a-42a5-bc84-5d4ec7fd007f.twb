      <column caption='Orders % (DWH vs Lucanet)' datatype='real' name='[Calculation_2544533834726666243]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum(zn([cnt_order])) -sum(zn([lucanet_cnt_order])))/sum(zn([lucanet_cnt_order]))' />
      </column>
      <column caption='GFV % EUR' datatype='real' name='[Calculation_2544533834727030788]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum(zn([gfv])) -sum(zn([lucanet_gfv])))/sum(zn([lucanet_gfv]))' />
      </column>
      <column caption='Comm. Rev. % EUR' datatype='real' name='[Calculation_2544533834728112133]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum(zn([commission])) -sum(zn([lucanet_commission])))/sum(zn([lucanet_commission]))' />
      </column>
      <column caption='Delivery Fee % EUR' datatype='real' name='[Calculation_2544533834728607750]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum(zn([delivery_fee_net])) -sum(zn([lucanet_delivery_fee_net])))/sum(zn([lucanet_delivery_fee_net]))' />
      </column>
      <column caption='Delivery cost % EUR' datatype='real' name='[Calculation_2544533834728775687]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum(([delivery_costs])) -sum(([lucanet_delivery_costs])))/sum(([lucanet_delivery_costs]))' />
      </column>
      <column caption='Basket Incentives % (Needed)' datatype='real' name='[Calculation_2544533834728980488]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((zn([dh_basket_incentives])) -(zn([lucanet_dh_basket_incentives])))/(zn([lucanet_dh_basket_incentives]))' />
      </column>
      <column caption='Vendor Funded Incentives % (Needed)' datatype='real' name='[Calculation_2544533834729148425]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((zn([incentives_other])) -(zn([lucanet_vendor_funded_incentives])))/(zn([lucanet_vendor_funded_incentives]))' />
      </column>
      <column caption='Joker Discount %' datatype='real' name='[Calculation_2544533834729304074]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum(zn([joker_customer_discount])) -sum(zn([lucanet_joker_discounts])))/sum(zn([lucanet_joker_discounts]))' />
      </column>
      <column caption='Username Filter' datatype='boolean' name='[Calculation_5933351828577058816]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='USERNAME() = [username]' />
      </column>
      <column caption='Management Entity Group' datatype='string' name='[Management Entity (copy)_6303280260505456644]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[management_entity]' />
      </column>
      <column caption='Vertical no kitchen no dmarts' datatype='string' name='[Vertical (copy)_2428214264071884801]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[vertical]' />
      </column>
