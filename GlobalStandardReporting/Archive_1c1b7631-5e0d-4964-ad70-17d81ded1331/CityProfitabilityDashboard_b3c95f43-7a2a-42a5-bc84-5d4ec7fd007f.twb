    <worksheet name='Cities Bucket (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Tableau Regular' fontsize='16'>Aggregate City View</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='city_profitability_daily (rl_intl_markets)' name='federated.0vsoy3a1elnygz14dw6f71t9faaz' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='City KPIs Selector ' datatype='string' name='[Analytical View KPIs Selector (copy)_5593611523773886472]' param-domain-type='list' role='measure' type='nominal' value='&quot;GP&quot;'>
              <calculation class='tableau' formula='&quot;GP&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.0vsoy3a1elnygz14dw6f71t9faaz].[Calculation_3215147949526245377]' caption='Reference Week' datatype='datetime' default-format='*dd - mmm - yy' name='[Parameter 6]' param-domain-type='list' role='measure' type='quantitative' value='#2021-05-31 00:00:00#'>
              <calculation class='tableau' formula='#2021-05-31 00:00:00#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0vsoy3a1elnygz14dw6f71t9faaz'>
            <column caption='Week ' datatype='datetime' name='[Calculation_11259024976678914]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;,[report_date])' />
            </column>
            <column caption='Weeks to show' datatype='boolean' name='[Calculation_11259024977764355]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[report_date],[Parameters].[Parameter 6]) &lt;= 28&#10;and DATEDIFF(&apos;day&apos;,[report_date],[Parameters].[Parameter 6]) &gt; -7' />
            </column>
            <column caption='&apos;No. of Cities with Fully Loaded / GPO&apos;' datatype='string' name='[Calculation_216665413486415895]' role='dimension' type='nominal' user:unnamed='GP - GP Positive #'>
              <calculation class='tableau' formula='&apos;No. of Cities with Fully Loaded / GPO&apos;' />
            </column>
            <column caption='&apos;No. of Cities&apos;' datatype='string' name='[Calculation_216665413705412652]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;No. of Cities&apos;' />
            </column>
            <column caption='Weeks   ' datatype='datetime' datatype-customized='true' name='[Calculation_3215147949526245377]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if (not ISNULL((IF DATEPART(&apos;weekday&apos;, ([report_date])) = 7 THEN ([Calculation_11259024976678914]) end)) = True)&#10;&#10;then ([Calculation_11259024976678914])&#10;&#10;end' />
            </column>
            <column caption='KPIs Selector (&lt; 0) - City' datatype='integer' name='[City KPIs Selector # orde level (copy)_6986279346524332032]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Analytical View KPIs Selector (copy)_5593611523773886472]&#10;WHEN &quot;GP&quot; THEN ([Positive Gross Profit  Needed (copy)_3091369306618204168])&#10;WHEN &quot;Fully Loaded GP&quot; THEN  ([GPO (&lt; 0) - City (copy)_216665413702361131])&#10;end' />
            </column>
            <column caption='Fully Loaded GPO (0 - 0.5) - City' datatype='integer' name='[GPO (0 - 0.5) - City (copy)_216665413702361128]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({fixed [geo_view],[selected_view], &#10;           [currency_view],[management_entity],&#10;           [sub_entity],[is_own_delivery],&#10;           [city_name],&#10;           [Weeks to show 2 (copy)_962644471521251332]: &#10;    IF (&#10;     Round(SUM([flgp])/ sum([cnt_order]), 2)  &gt;= 0 &#10;    AND &#10;     Round(SUM([flgp])/ sum([cnt_order]), 2)   &lt; 0.5  )&#10;     THEN &#10;           1 &#10;    ELSE 0&#10;    END &#10;})' />
            </column>
            <column caption='Fully Loaded GPO (0.5 - 1) - City' datatype='integer' name='[GPO (0.5 - 1) - City (copy)_216665413702361130]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({fixed [geo_view],[selected_view], &#10;           [currency_view],[management_entity],&#10;           [sub_entity],[is_own_delivery],&#10;           [city_name],&#10;           [Weeks to show 2 (copy)_962644471521251332]: &#10;    IF (&#10;  Round(SUM([flgp])/ sum([cnt_order]), 2)   &gt;= 0.5&#10;    AND  &#10;  Round(SUM([flgp])/ sum([cnt_order]), 2)   &lt; 1   )&#10;     &#10;    THEN &#10;           1 &#10;    ELSE 0&#10;    END &#10;})' />
            </column>
            <column caption='Fully Loaded GPO (&lt; 0) - City' datatype='integer' name='[GPO (&lt; 0) - City (copy)_216665413702361131]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({fixed [geo_view],[selected_view], &#10;           [currency_view],[management_entity],&#10;           [sub_entity],[is_own_delivery],&#10;           [city_name],&#10;           [Weeks to show 2 (copy)_962644471521251332]: &#10;    IF (&#10;        Round(SUM([flgp])/ sum([cnt_order]), 2)  &lt; 0 )&#10;&#10;    THEN &#10;           1 &#10;    ELSE 0&#10;    END &#10;})' />
            </column>
            <column caption='GPO (&lt; 0) - City (copy)' datatype='integer' name='[GPO (&lt; 0) - City (copy)_2480709379143430147]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({fixed [geo_view],[selected_view], &#10;           [currency_view],[management_entity],&#10;           [sub_entity],[is_own_delivery],&#10;           [city_name],&#10;           [Weeks to show 2 (copy)_962644471521251332]: &#10;    IF (&#10;        Round(SUM([gp])/ sum([cnt_order]), 2) &lt; 0 )&#10;    THEN &#10;          1 &#10;    ELSE 0&#10;    END &#10;})' />
            </column>
            <column caption='Fully Loaded GPO (&gt;=1) - City' datatype='integer' name='[GPO (&gt;=1) - City (copy)_216665413702361129]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({fixed [geo_view],[selected_view], &#10;           [currency_view],[management_entity],&#10;           [sub_entity],[is_own_delivery],&#10;           [city_name],&#10;           [Weeks to show 2 (copy)_962644471521251332]: &#10;    IF (&#10;     Round(SUM([flgp])/ sum([cnt_order]), 2)   &gt;= 1 )&#10;    THEN &#10;           1 &#10;    ELSE 0&#10;    END &#10;})' />
