      <column caption='% Delivery Fee  (copy) (copy)' datatype='real' name='[% Delivery Fee  (copy) (copy)_4437664131370450953]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [selected_view] = &apos;Back-End&apos; THEN [delivery_fee_net] ELSE 0 END)' />
      </column>
      <column caption='% Delivery Fee  (copy)' datatype='real' name='[% Delivery Fee  (copy)_4437664131370438664]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [selected_view] = &apos;Reconciled&apos; THEN [delivery_fee_net] ELSE 0 END)' />
      </column>
      <column caption='% Total Revenue ' datatype='real' name='[% Delivery Fee  Needed (copy)_4587619968652914722]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF [selected_view] = &apos;Reconciled&apos; THEN &#10;      zn([delivery_fee_net]) &#10;    + zn([commission]) &#10;    + zn([card_fee_revenue]) &#10;    + zn([other_revenue])&#10; ELSE 0 END)&#10;-SUM(IF [selected_view] = &apos;Back-End&apos; THEN &#10;      zn([delivery_fee_net]) &#10;    + zn([commission]) &#10;    + zn([card_fee_revenue]) &#10;    + zn([other_revenue])&#10; ELSE 0 END))&#10;/ SUM(IF [selected_view] = &apos;Back-End&apos; THEN &#10;      zn([delivery_fee_net]) &#10;    + zn([commission]) &#10;    + zn([card_fee_revenue]) &#10;    + zn([other_revenue])&#10; ELSE 0 END)' />
      </column>
      <column caption='% Commission Revenue' datatype='real' name='[% Delivery Fee  Needed (copy)_4587619968656035880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF [selected_view] = &apos;Reconciled&apos; THEN [commission] ELSE 0 END) &#10;-SUM(IF [selected_view] = &apos;Back-End&apos; THEN [commission] ELSE 0 END))&#10;/ SUM(IF [selected_view] = &apos;Back-End&apos; THEN [commission] ELSE 0 END)' />
      </column>
      <column caption='% CM-II ' datatype='real' name='[% Full CM-I Needed  (copy)_4587619968653746214]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF [selected_view] = &apos;Reconciled&apos; THEN &#10;      zn(([Profit Contribution  Needed (copy)_3833759610179297321])) &#10;    + zn(([payment])) &#10;    + zn(([food_delivery_accident]))&#10;    + zn(([semi_variable_delivery])) &#10;    + zn(([shopper_costs]))&#10; ELSE 0 END)&#10;-SUM(IF [selected_view] = &apos;Back-End&apos; THEN &#10;      zn(([Profit Contribution  Needed (copy)_3833759610179297321])) &#10;    + zn(([payment])) &#10;    + zn(([food_delivery_accident]))&#10;    + zn(([semi_variable_delivery])) &#10;    + zn(([shopper_costs]))&#10;ELSE 0 END))&#10;/ SUM(IF [selected_view] = &apos;Back-End&apos; THEN &#10;      zn(([Profit Contribution  Needed (copy)_3833759610179297321])) &#10;    + zn(([payment])) &#10;    + zn(([food_delivery_accident]))&#10;    + zn(([semi_variable_delivery])) &#10;    + zn(([shopper_costs]))&#10;ELSE 0 END)' />
      </column>
      <column caption='% Delivery Fee ' datatype='real' name='[% GFV Needed  (copy)_4587619968652787745]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF [selected_view] = &apos;Reconciled&apos; THEN [delivery_fee_net] ELSE 0 END)&#10;-SUM(IF [selected_view] = &apos;Back-End&apos; THEN [delivery_fee_net] ELSE 0 END))&#10;/ SUM(IF [selected_view] = &apos;Back-End&apos; THEN [delivery_fee_net] ELSE 0 END)' />
      </column>
      <column caption='% Full CM-I' datatype='real' name='[% GFV Needed  (copy)_4587619968653586469]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//( zn([Full CM-I - Reconciled]) - zn([Full CM-I]) )/ [Full CM-I - Reconciled]&#10;&#10;(SUM(IF [selected_view] = &apos;Reconciled&apos; THEN &#10;      zn(([Profit Contribution  Needed (copy)_3833759610179297321])) &#10;    + zn(([payment])) &#10;    + zn(([food_delivery_accident]))&#10; ELSE 0 END)&#10;-SUM(IF [selected_view] = &apos;Back-End&apos; THEN &#10;      zn(([Profit Contribution  Needed (copy)_3833759610179297321])) &#10;    + zn(([payment])) &#10;    + zn(([food_delivery_accident]))&#10;ELSE 0 END))&#10;/ SUM(IF [selected_view] = &apos;Back-End&apos; THEN &#10;      zn(([Profit Contribution  Needed (copy)_3833759610179297321])) &#10;    + zn(([payment])) &#10;    + zn(([food_delivery_accident]))&#10;ELSE 0 END)' />
      </column>
      <column caption='% Orders with Vendor funded incentives' datatype='real' name='[% Orders with DH Incentives (copy)_765400863827677192]' role='measure' type='quantitative'>
