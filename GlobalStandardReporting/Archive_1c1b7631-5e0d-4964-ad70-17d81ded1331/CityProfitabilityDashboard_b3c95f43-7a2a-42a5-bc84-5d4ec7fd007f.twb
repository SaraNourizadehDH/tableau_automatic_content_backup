        <calculation class='tableau' formula='sum({fixed [geo_view],[selected_view], &#10;           [currency_view],[management_entity],&#10;           [sub_entity],[is_own_delivery],&#10;           [city_name],&#10;           [Weeks to show 2 (copy)_962644471521251332]: &#10;    IF (&#10;      Round(SUM([gp])/ sum([cnt_order]), 2)  &gt;= 0.5&#10;    AND &#10;      Round(SUM([gp])/ sum([cnt_order]), 2)  &lt; 1   )&#10;    THEN &#10;        1&#10;    ELSE 0&#10;    END &#10;})' />
