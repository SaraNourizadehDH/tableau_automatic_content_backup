            <column caption='Explanation' datatype='string' name='[Reconciled (copy)_3091369307669782561]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [selected_view]= &apos;Back-End&apos; Then &apos;&quot;Back-End&quot; denotes a view in which back-end order-level data is displayed without adjustments, hence aggregate data does not match Lucanet exactly.&apos;&#10;Else &apos;&quot;Reconciled&quot; denotes a view in which country-level per order adjustments have been applied to each order-level data item from the back end, to match Lucanet aggregate country-level figures.&apos;&#10;END' />
            </column>
            <column caption='Vertical no dmart no kitchen' datatype='string' name='[Vertical (copy)_2428214264070807552]' role='dimension' type='nominal'>
