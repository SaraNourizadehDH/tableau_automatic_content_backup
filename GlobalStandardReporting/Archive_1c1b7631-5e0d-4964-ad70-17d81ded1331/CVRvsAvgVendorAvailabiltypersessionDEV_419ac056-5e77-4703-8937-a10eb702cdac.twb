      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/CVRvsAvgVendorAvailabiltypersession_DEV/WeeklyTrend?rev=' id='WeeklyTrend' path='/t/GlobalStandardReporting/workbooks/CVRvsAvgVendorAvailabiltypersession_DEV' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='1100' maxwidth='1400' minheight='1100' minwidth='1400' sizing-mode='fixed' />
      <datasources>
        <datasource caption='vendor_availability_and_cvr (adhoc_analysis)' name='federated.0d9dz8a15qx9rb1ch23810kbhr9s' />
      </datasources>
      <datasource-dependencies datasource='federated.0d9dz8a15qx9rb1ch23810kbhr9s'>
        <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
        <column caption='Hexagon Area Name' datatype='string' name='[hexagon_area_name]' role='dimension' type='nominal' />
        <column caption='Hexagon City Name' datatype='string' name='[hexagon_city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
        <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
        <column-instance column='[hexagon_area_name]' derivation='None' name='[none:hexagon_area_name:nk]' pivot='key' type='nominal' />
        <column-instance column='[hexagon_city_name]' derivation='None' name='[none:hexagon_city_name:nk]' pivot='key' type='nominal' />
        <column-instance column='[week_m]' derivation='None' name='[none:week_m:qk]' pivot='key' type='quantitative' />
        <column caption='Report Week' datatype='date' name='[week_m]' role='dimension' type='ordinal' />
      </datasource-dependencies>
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98546' id='7' param='horz' type-v2='layout-flow' w='98858' x='571' y='727'>
            <zone h='98546' id='5' type-v2='layout-basic' w='87429' x='571' y='727'>
              <zone h='44146' id='3' name='Weekly Sessions and Converted Sessions' w='87429' x='571' y='55127'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone h='39582' id='10' name='CVR vs Vendor Availabilty' w='87429' x='571' y='15545'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='14818' id='32' type-v2='text' w='87429' x='571' y='727'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontsize='15'>Weekly Trend for CVR and Vendor availability</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='12'>This view shows the realtion between average Vendors available per sessions vs CVR performance of that week. </run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Average available Vendors per Session</run>
                  <run fontcolor='#000000' fontsize='10'> is calculated by using the cd_91 field in ga_events table. This field shows vendors available during the session. KPI is consolidated</run>
                  <run bold='true' fontcolor='#000000' fontsize='10'> first by session_id&apos;s</run>
                  <run fontcolor='#000000' fontsize='10'>, then taken average only if the specific session has numeric value in that field. Due to this situation </run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>some sessions</run>
                  <run fontcolor='#000000' fontsize='10'> which don&apos;t have applicable value </run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>is taken out of the sample</run>
                  <run fontcolor='#000000' fontsize='10'>.</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#555555'>Note</run>
                  <run fontcolor='#555555'>: There is an unexplained sessions peak starting in 21.11.2022 for Jordan, Oman, Bahrain, UAE and Iraq. Which reflects as a great dip in the CVR. We have contacted with the Product team and waiting an update from their side.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
            </zone>
            <zone fixed-size='160' h='98546' id='13' is-fixed='true' type-v2='layout-basic' w='11429' x='88000' y='727'>
              <zone h='49273' id='6' param='vert' type-v2='layout-flow' w='11429' x='88000' y='727'>
