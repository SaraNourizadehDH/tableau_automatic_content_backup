    <worksheet name='Group view  (2)'>
      <table>
        <view>
          <datasources>
            <datasource caption='Local - Production' name='federated.1hy3d39034kucd1azkkp000ih9y1' />
            <datasource caption='Central based pipeline' name='federated.0p33fiq005s9rk1b8m01l19ra505' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.0p33fiq005s9rk1b8m01l19ra505].[Reporting_month]' caption='Reporting Month' datatype='datetime' default-format='*mmm yy' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2024-04-01 00:00:00#'>
              <calculation class='tableau' formula='#2024-04-01 00:00:00#' />
            </column>
            <column caption='Months to show' datatype='integer' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='28'>
              <calculation class='tableau' formula='28' />
              <range max='100' min='1' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0p33fiq005s9rk1b8m01l19ra505'>
            <column caption='Reporting month' datatype='date' default-format='*mmm-yy' name='[Reporting_month]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1hy3d39034kucd1azkkp000ih9y1'>
            <column caption='Months to display' datatype='boolean' name='[Calculation_1098526511620268032]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&quot;month&quot;,[Reporting_month],[Parameters].[Parameter 1])&lt;= [Parameters].[Parameter 2]-1&#10;AND &#10;DATEDIFF(&quot;month&quot;,[Reporting_month],[Parameters].[Parameter 1])&gt;= 0' />
            </column>
            <column caption='Benefits ratio (Subs vs. all)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2383600472022896641]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM([Total_subscription_benefits_eur]) / SUM([Subscribers_total_month])&#10;)&#10;/&#10;(&#10;(&#10;    SUM([total_spend]) - SUM([Total_subscription_benefits_eur])&#10;)&#10;/&#10;SUM( [Monthly_active_users])&#10;)' />
            </column>
            <column caption='Total market orders' datatype='real' name='[Calculation_4902379349621710849]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Subscription_orders])&#10;+&#10;sum([Non_subscription_orders])' />
            </column>
            <column caption='Total market GMV' datatype='real' name='[Calculation_4902379349623664642]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([GMV_eur_subscribers])&#10;+&#10;sum([GMV_eur_non_subscribers])' />
            </column>
            <column caption='% Subscribers GMV' datatype='real' default-format='p0.0%' name='[Calculation_4902379349623861251]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([GMV_eur_subscribers])&#10;/&#10;[Calculation_4902379349623664642]' />
            </column>
            <column caption='Benefits per subscriber, €' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_4902379349671854099]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Total_subscription_benefits_eur])&#10;/&#10;sum([Subscribers_total_month])' />
            </column>
            <column caption='% Subscribers' datatype='real' default-format='p0.0%' name='[Calculation_5059723858758057984]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Susbcribers_EOM])&#10;/&#10;sum([Monthly_active_users])' />
            </column>
            <column caption='New Subscribers (% of MAU)' datatype='real' default-format='p0.0%' name='[Calculation_5059723858759852033]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([New_subscribers])&#10;/&#10;sum([Monthly_active_users])' />
            </column>
            <column caption='% Subscriber Orders' datatype='real' default-format='p0.0%' name='[Calculation_5059723858762743810]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Subscription_orders])&#10;/&#10;[Calculation_4902379349621710849]' />
            </column>
            <column caption='Churn Rate (1m)' datatype='real' default-format='p0.0%' name='[Calculation_5059723858763411459]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Churned_subscribers])&#10;/&#10;sum([Previous_month_subscribers])' />
            </column>
            <column caption='Subscribers Frequency' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_5059723858763735044]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Subscription_orders 1])&#10;/&#10;sum([Subscribers_total_month 1])' />
            </column>
            <column caption='Weighted post subs frequency 30d after' datatype='real' name='[Calculation_5059723858766929925]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(&#10;([Post_subs_frequency_30d_after])&#10;*&#10;([Subscribers_total_month])&#10;)&#10;/&#10;sum([Subscribers_total_month])' />
            </column>
            <column caption='Frequency Incrementality (%)' datatype='real' default-format='p0%' name='[Calculation_5059723858767507463]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;[Calculation_5059723858766929925]&#10;-&#10;[Weighted current frequency (copy)_5059723858767192070]&#10;)&#10;/&#10;[Calculation_5059723858766929925]' />
            </column>
            <column caption='FLGPU (subscribers)' datatype='real' default-format='c&quot;€&quot;#,##0.00;-&quot;€&quot;#,##0.00' name='[Calculation_5059723858768297995]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([FLGP_subscribers_eur])&#10;/&#10;sum([Subscribers_total_month])' />
            </column>
            <column caption='Order Profitability Comparison' datatype='real' default-format='p0%' name='[Calculation_5059723858770231308]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;[FLGPU (subscribers) (copy)_5059723858772602894]&#10;-&#10;[Calculation_5059723858770554893]&#10;)&#10;/&#10;[Calculation_5059723858770554893]' />
            </column>
            <column caption='Weighted FLGPO (non-subs)' datatype='real' name='[Calculation_5059723858770554893]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(&#10;([FLGP_non_subscribers_eur]/[Non_subscription_orders])&#10;*&#10;[Subscription_orders]&#10;)&#10;/&#10;SUM([Subscription_orders])' />
            </column>
            <column caption='% of Benefits Funded by Vendor' datatype='real' default-format='p0.0%' name='[Calculation_5059723858779201553]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Vendor_funded_subscription_benefits_eur])&#10;/&#10;sum([Total_subscription_benefits_eur])' />
            </column>
            <column caption='Churned subscribers' datatype='real' name='[Churned_subscribers]' role='measure' type='quantitative' />
            <column caption='FLGPO (subscribers)' datatype='real' default-format='c&quot;€&quot;#,##0.00;-&quot;€&quot;#,##0.00' name='[FLGPU (subscribers) (copy)_5059723858772602894]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([FLGP_subscribers_eur])&#10;/&#10;sum([Subscription_orders])' />
            </column>
            <column caption='FLGP non subscribers eur' datatype='real' name='[FLGP_non_subscribers_eur]' role='measure' type='quantitative' />
            <column caption='FLGP subscribers eur' datatype='real' name='[FLGP_subscribers_eur]' role='measure' type='quantitative' />
            <column caption='AFV Uplift (%)' datatype='real' default-format='p0%' name='[Frequency Uplift (%) (copy)_5059723858767953930]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;[Weighted current frequency (copy)_5059723858767745032]&#10;-&#10;[Weighted current AFV (copy)_5059723858767859721]&#10;)&#10;/&#10;[Weighted current AFV (copy)_5059723858767859721]' />
            </column>
            <column caption='GMV eur non subscribers' datatype='real' name='[GMV_eur_non_subscribers]' role='measure' type='quantitative' />
            <column caption='GMV eur subscribers' datatype='real' name='[GMV_eur_subscribers]' role='measure' type='quantitative' />
            <column caption='M 1 months cohort AFV this month' datatype='real' name='[M_1_months_cohort_AFV_this_month]' role='dimension' type='quantitative' />
            <column caption='M 1 months cohort AFV two months ago' datatype='real' name='[M_1_months_cohort_AFV_two_months_ago]' role='measure' type='quantitative' />
            <column caption='Monthly active users (&apos;000)' datatype='real' name='[Monthly active users (copy)_4302767283696463880]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Monthly_active_users 1]/1000' />
            </column>
            <column caption='Monthly active non subscribers' datatype='real' name='[Monthly_active_non_subscribers]' role='measure' type='quantitative' />
            <column caption='Monthly active users (1)' datatype='integer' name='[Monthly_active_users 1]' role='measure' type='quantitative' />
            <column caption='Monthly active users' datatype='real' name='[Monthly_active_users]' role='measure' type='quantitative' />
            <column caption='New subscribers' datatype='real' name='[New_subscribers]' role='measure' type='quantitative' />
            <column caption='Non subscription orders' datatype='real' name='[Non_subscription_orders]' role='measure' type='quantitative' />
            <column caption='User Profitability Comparison' datatype='real' default-format='p0%' name='[Order Profitability Comparison (copy)_5059723858774077455]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;[Calculation_5059723858768297995]&#10;-&#10;[Weighted FLGPO (non-subs) (copy)_5059723858774319120]&#10;)&#10;/&#10;[Weighted FLGPO (non-subs) (copy)_5059723858774319120]' />
            </column>
            <column caption='Post subs frequency 30d after' datatype='real' name='[Post_subs_frequency_30d_after]' role='measure' type='quantitative' />
            <column caption='Pre subs frequency 30d before' datatype='real' name='[Pre_subs_frequency_30d_before]' role='measure' type='quantitative' />
            <column caption='Previous month subscribers' datatype='real' name='[Previous_month_subscribers]' role='measure' type='quantitative' />
            <column caption='Reporting month' datatype='date' datatype-customized='true' name='[Reporting_month]' role='dimension' type='ordinal' />
            <column caption='Subscribers total month' datatype='real' name='[Subscribers_total_month]' role='dimension' type='quantitative' />
            <column caption='Subscription orders (&apos;000)' datatype='real' default-format='n#,##0;-#,##0' name='[Subscription orders (copy)_4302767283686297601]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Subscription_orders]/1000' />
            </column>
            <column caption='Subscription orders' datatype='real' name='[Subscription_orders]' role='measure' type='quantitative' />
            <column caption='Susbcribers EOM (&apos;000)' datatype='real' default-format='n#,##0;-#,##0' name='[Susbcribers EOM (copy)_4302767283686072320]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Susbcribers_EOM]/1000' />
            </column>
            <column caption='Susbcribers EOM' datatype='real' name='[Susbcribers_EOM]' role='measure' type='quantitative' />
            <column caption='Total subscription benefits eur' datatype='real' name='[Total_subscription_benefits_eur]' role='measure' type='quantitative' />
            <column caption='Vendor funded subscription benefits eur' datatype='real' name='[Vendor_funded_subscription_benefits_eur]' role='measure' type='quantitative' />
            <column caption='Weighted FLGPU (non-subs)' datatype='real' name='[Weighted FLGPO (non-subs) (copy)_5059723858774319120]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(&#10;([FLGP_non_subscribers_eur]/[Monthly_active_non_subscribers])&#10;*&#10;[Subscribers_total_month]&#10;)&#10;/&#10;SUM([Subscribers_total_month])' />
            </column>
            <column caption='Weighted previous AFV' datatype='real' name='[Weighted current AFV (copy)_5059723858767859721]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(&#10;[M_1_months_cohort_AFV_two_months_ago]&#10;*&#10;[Subscribers_total_month]&#10;)&#10;/&#10;sum([Subscribers_total_month])' />
