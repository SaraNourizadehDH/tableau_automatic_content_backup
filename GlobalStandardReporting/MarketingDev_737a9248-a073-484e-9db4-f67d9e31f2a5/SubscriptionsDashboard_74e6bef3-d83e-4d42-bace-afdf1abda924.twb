              <calculation class='tableau' formula='SUM(IF [Reporting_month]=DATEADD(&apos;month&apos;, -1, [Parameters].[Parameter 1]) THEN [Total_subscription_benefits_eur] END)' />
            </column>
            <column caption='Reporting Month-1 FLGPO (subscribers)' datatype='real' name='[Reporting Month-1 FLGPU (subscribers) (copy)_3016285902218072069]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Reporting Month-1 Churned Subscribers (copy)_239324150188023858]&#10;/&#10;[Reporting Month-1 Monthly Active Users (copy)_239324150166335501]' />
            </column>
            <column caption='Reporting Month-1 AFV Uplift (%)' datatype='real' name='[Reporting Month-1 Frequency Uplift (%) (copy)_239324150185087023]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;[Reporting Month-1 Weighted Current Frequency (copy)_239324150184615980]&#10;-&#10;[Reporting Month-1 Weighted Previous Frequency (copy)_239324150184681517]&#10;)&#10;/&#10;ABS([Reporting Month-1 Weighted Previous Frequency (copy)_239324150184681517])' />
            </column>
            <column caption='Reporting Month-1 New Subscribers' datatype='real' name='[Reporting Month-1 Monthly Active Users (copy)_239324150162706440]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Reporting_month]=DATEADD(&apos;month&apos;, -1, [Parameters].[Parameter 1]) THEN [New_subscribers] END)' />
            </column>
            <column caption='Reporting Month-1 Subscription Orders' datatype='real' name='[Reporting Month-1 Monthly Active Users (copy)_239324150166335501]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Reporting_month]=DATEADD(&apos;month&apos;, -1, [Parameters].[Parameter 1]) THEN [Subscription_orders] END)' />
            </column>
            <column caption='Reporting Month-1 Total Market Orders' datatype='real' name='[Reporting Month-1 Monthly Active Users (copy)_239324150168109072]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Reporting_month]=DATEADD(&apos;month&apos;, -1, [Parameters].[Parameter 1]) THEN ([Subscription_orders]+[Non_subscription_orders]) END)' />
            </column>
            <column caption='Reporting Month-1 Total Market GMV' datatype='real' name='[Reporting Month-1 Monthly Active Users (copy)_4302767283694813188]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Reporting_month]=DATEADD(&apos;month&apos;, -1, [Parameters].[Parameter 1]) THEN ([GMV_eur_non_subscribers]+[GMV_eur_subscribers]) END)' />
            </column>
            <column caption='Reporting Month-1 Churned Subscribers' datatype='real' name='[Reporting Month-1 New Subscribers (copy)_239324150171865109]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Reporting_month]=DATEADD(&apos;month&apos;, -1, [Parameters].[Parameter 1]) THEN [Churned_subscribers] END)' />
            </column>
            <column caption='Reporting Month-1 Monthly Active Users' datatype='real' name='[Reporting Month-1 Subscribers EOM (copy)_239324150160728066]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Reporting_month]=DATEADD(&apos;month&apos;, -1, [Parameters].[Parameter 1]) THEN [Monthly_active_users] END)' />
            </column>
            <column caption='Reporting Month-1 Subscribers Total Month' datatype='real' name='[Reporting Month-1 Subscribers EOM (copy)_239324150176030751]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Reporting_month]=DATEADD(&apos;month&apos;, -1, [Parameters].[Parameter 1]) THEN [Subscribers_total_month] END)' />
            </column>
            <column caption='Reporting Month-1 GMV Subscribers' datatype='real' name='[Reporting Month-1 Total Market GMV (copy)_4302767283695239174]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Reporting_month]=DATEADD(&apos;month&apos;, -1, [Parameters].[Parameter 1]) THEN ([GMV_eur_subscribers]) END)' />
            </column>
            <column caption='Reporting Month-1 Total Vendor Funded Benefits Eur' datatype='real' name='[Reporting Month-1 Total Subscription Benefits Eur (copy)_239324150193913919]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Reporting_month]=DATEADD(&apos;month&apos;, -1, [Parameters].[Parameter 1]) THEN [Vendor_funded_subscription_benefits_eur] END)' />
            </column>
            <column caption='Reporting Month-1 Order Profitability Comparison' datatype='real' default-format='p0%' name='[Reporting Month-1 User Profitability Comparison (copy)_3016285902217179138]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;[Reporting Month-1 FLGPU (subscribers) (copy)_3016285902218072069]&#10;-&#10;[Reporting Month-1 Weighted FLGPU (non-subs) (copy)_3016285902218797062]&#10;)&#10;/&#10;[Reporting Month-1 Weighted FLGPU (non-subs) (copy)_3016285902218797062]' />
            </column>
            <column caption='Reporting 30d Weighted Previous Frequency' datatype='real' name='[Reporting Month-1 Weighted Current Frequency (copy)_239324150182277158]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;IF [Reporting_month] = DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1]) THEN&#10;([Pre_subs_frequency_30d_before])&#10;*&#10;([Subscribers_total_month])&#10;END)&#10;/&#10;SUM(if [Reporting_month] = DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1]) THEN [Subscribers_total_month] END)' />
            </column>
            <column caption='Reporting Month-1 Weighted Current AFV' datatype='real' name='[Reporting Month-1 Weighted Current Frequency (copy)_239324150184615980]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;IF [Reporting_month] = DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1]) THEN&#10;([M_1_months_cohort_AFV_this_month])&#10;*&#10;([Subscribers_total_month])&#10;END)&#10;/&#10;SUM(if [Reporting_month] = DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1]) THEN [Subscribers_total_month] END)' />
            </column>
            <column caption='Reporting Month-1 Weighted FLGPO (non-subs)' datatype='real' name='[Reporting Month-1 Weighted FLGPU (non-subs) (copy)_3016285902218797062]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;sum(&#10;    (if [Reporting_month] = DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1]) THEN ([FLGP_non_subscribers_eur]/[Non_subscription_orders]) END)&#10;    *&#10;    (if [Reporting_month] = DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1]) THEN [Subscription_orders] END)&#10;)&#10;/&#10;sum(if [Reporting_month] = DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1]) THEN [Subscription_orders] END)&#10;)' />
            </column>
            <column caption='Reporting Month-1 Weighted Previous AFV' datatype='real' name='[Reporting Month-1 Weighted Previous Frequency (copy)_239324150184681517]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;IF [Reporting_month] = DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1]) THEN&#10;([M_1_months_cohort_AFV_two_months_ago])&#10;*&#10;([Subscribers_total_month])&#10;END)&#10;/&#10;SUM(if [Reporting_month] = DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1]) THEN [Subscribers_total_month] END)' />
            </column>
            <column caption='Reporting month' datatype='date' datatype-customized='true' name='[Reporting_month]' role='dimension' type='ordinal' />
            <column caption='Subscribers total month' datatype='real' name='[Subscribers_total_month]' role='dimension' type='quantitative' />
