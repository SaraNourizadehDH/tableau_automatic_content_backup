            </column>
            <column caption='MoM FLGPO (vs non subscribers)' datatype='real' default-format='p0.0%' name='[MoM FLGPU (subscribers) (copy)_427067921514905624]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100*&#10;(&#10;(&#10;[Reporting Month Weighted FLGPU (non-subs) (copy)_3016285902219751431]&#10;-&#10;[Reporting Month-1 Weighted FLGPU (non-subs) (copy)_3016285902218797062]&#10;)&#10;/&#10;[Reporting Month-1 Weighted FLGPU (non-subs) (copy)_3016285902218797062]&#10;)' />
