          <datasource-dependencies datasource='federated.0p33fiq005s9rk1b8m01l19ra505'>
            <column caption='Reporting month' datatype='date' default-format='*mmm-yy' name='[Reporting_month]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1hy3d39034kucd1azkkp000ih9y1'>
            <column caption='Reporting Month Benefits ratio (Subs vs. all)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Benefits ratio (Subs vs. all) (copy)_2383600472026312706]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Reporting Month Benefits ratio (Subs vs. all) (copy)_2383600472343117829]&#10;/&#10;[Non Sub Benefits per users, € (copy)_2383600472345001992]' />
            </column>
            <column caption='Months to display' datatype='boolean' name='[Calculation_1098526511620268032]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&quot;month&quot;,[Reporting_month],[Parameters].[Parameter 1])&lt;= [Parameters].[Parameter 2]-1&#10;AND &#10;DATEDIFF(&quot;month&quot;,[Reporting_month],[Parameters].[Parameter 1])&gt;= 0' />
            </column>
            <column caption='Reporting Month Subscribers EOM' datatype='real' name='[Calculation_1098526511821881346]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Reporting_month]=[Parameters].[Parameter 1] THEN [Susbcribers_EOM] END)' />
            </column>
            <column caption='MoM Subscribers EOM' datatype='real' default-format='p0.0%' name='[Calculation_1098526511822643204]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1098526511821881346]&#10;-&#10;[Reporting Month Subscribers EOM (copy)_1098526511822471171])&#10;/&#10;[Reporting Month Subscribers EOM (copy)_1098526511822471171]' />
            </column>
            <column caption='MoM Column Header' datatype='string' name='[Calculation_1098526511824371717]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;MoM&quot;' />
            </column>
            <column caption='MoM % Subscribers' datatype='real' default-format='n#,##0.0&quot;pp&quot;;-#,##0.0&quot;pp&quot;' name='[Calculation_239324150161707014]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100*&#10;(&#10;[Reporting Month Monthly Active Users (copy)_239324150161133572]&#10;-&#10;[Reporting Month % Subscribers (copy)_2668664308102115328]&#10;)' />
            </column>
            <column caption='MoM New Subscribers (% of MAU)' datatype='real' default-format='n#,##0.0&quot;pp&quot;;-#,##0.0&quot;pp&quot;' name='[Calculation_239324150163484683]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100*&#10;(&#10;[Reporting Month % subscribers (copy)_239324150162907145]&#10;-&#10;[Reporting Month-1 % subscribers (copy)_239324150163345418]&#10;)' />
            </column>
            <column caption='MoM Subscription Orders' datatype='real' default-format='p0.0%' name='[Calculation_239324150166474766]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;[Reporting Month Monthly Active Users (copy)_239324150166188044]&#10;-&#10;[Reporting Month-1 Monthly Active Users (copy)_239324150166335501]&#10;)&#10;/&#10;[Reporting Month-1 Monthly Active Users (copy)_239324150166335501]' />
            </column>
            <column caption='Reporting Month % Subscriber Orders' datatype='real' name='[Calculation_239324150168559633]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Reporting Month Monthly Active Users (copy)_239324150166188044]&#10;/&#10;[Reporting Month Monthly Active Users (copy)_239324150167330831]' />
            </column>
            <column caption='MoM % Subscriber Orders' datatype='real' default-format='n#,##0.0&quot;pp&quot;;-#,##0.0&quot;pp&quot;' name='[Calculation_239324150168911891]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100*&#10;(&#10;[Calculation_239324150168559633]&#10;-&#10;[Reporting Month % Subscriber Orders (copy)_239324150168846354]&#10;)' />
            </column>
            <column caption='MoM Churned Subscribers' datatype='real' default-format='p0.0%' name='[Calculation_239324150172147734]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;[Reporting Month New Subscribers (copy)_239324150171766804]&#10;-&#10;[Reporting Month-1 New Subscribers (copy)_239324150171865109]&#10;)&#10;/&#10;[Reporting Month-1 New Subscribers (copy)_239324150171865109]' />
            </column>
            <column caption='Reporting Month Churn Rate (1m)' datatype='real' name='[Calculation_239324150173069337]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Reporting Month New Subscribers (copy)_239324150171766804]&#10;/&#10;[Reporting Month Churned Subscribers (copy)_239324150172762135]' />
            </column>
            <column caption='MoM Churn Rate (1m)' datatype='real' default-format='n#,##0.0&quot;pp&quot;;-#,##0.0&quot;pp&quot;' name='[Calculation_239324150173491227]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100*&#10;(&#10;[Calculation_239324150173069337]&#10;-&#10;[Reporting Month Churn Rate (1m) (copy)_239324150173323290]&#10;)' />
            </column>
            <column caption='Reporting Month Subscribers Frequency' datatype='real' name='[Calculation_239324150174474268]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Reporting Month Monthly Active Users (copy)_239324150166188044]&#10;/&#10;[Reporting Month Subscribers EOM (copy)_239324150175551517]' />
            </column>
            <column caption='MoM Subscribers Frequency' datatype='real' default-format='p0.0%' name='[Calculation_239324150177550369]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;[Calculation_239324150174474268]&#10;-&#10;[Reporting Month Subscribers Frequency (copy)_239324150177443872]&#10;)&#10;/&#10;[Reporting Month Subscribers Frequency (copy)_239324150177443872]' />
            </column>
            <column caption='Reporting Month Weighted post subs frequency 30d after' datatype='real' name='[Calculation_239324150180315170]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;IF [Reporting_month] = [Parameters].[Parameter 1] THEN&#10;([Post_subs_frequency_30d_after])&#10;*&#10;([Subscribers_total_month])&#10;END)&#10;/&#10;SUM(IF [Reporting_month]=[Parameters].[Parameter 1] THEN [Subscribers_total_month] END)' />
            </column>
            <column caption='Reporting 30d Weighted Post Frequency' datatype='real' name='[Calculation_239324150181138467]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;IF [Reporting_month] = DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1]) THEN&#10;([Post_subs_frequency_30d_after])&#10;*&#10;([Subscribers_total_month])&#10;END)&#10;/&#10;SUM(if [Reporting_month] = DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1]) THEN [Subscribers_total_month] END)' />
            </column>
            <column caption='Reporting Month Frequency Incrementality (%)' datatype='real' name='[Calculation_239324150182613031]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;[Calculation_239324150180315170]&#10;-&#10;[Reporting Month Weighted Current Frequency (copy)_239324150182191141]&#10;)&#10;/&#10;ABS([Calculation_239324150180315170])' />
            </column>
            <column caption='MoM Frequency Incrementality (%)' datatype='real' default-format='n#,##0.0&quot;pp&quot;;-#,##0.0&quot;pp&quot;' name='[Calculation_239324150182961193]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100*&#10;(&#10;[Calculation_239324150182613031]&#10;-&#10;[Reporting Month Frequency Uplift (%) (copy)_239324150182789160]&#10;)' />
            </column>
            <column caption='Reporting Month Weighted FLGPU (non-subs)' datatype='real' name='[Calculation_239324150190784566]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;sum(&#10;    (if [Reporting_month] = DATE([Parameters].[Parameter 1]) THEN ([FLGP_non_subscribers_eur]/[Monthly_active_non_subscribers]) END)&#10;    *&#10;    (if [Reporting_month] = DATE([Parameters].[Parameter 1]) THEN [Subscribers_total_month] END)&#10;)&#10;/&#10;sum(if [Reporting_month] = DATE([Parameters].[Parameter 1]) THEN [Subscribers_total_month] END)&#10;)' />
            </column>
            <column caption='Reporting Month-1 Weighted FLGPU (non-subs)' datatype='real' name='[Calculation_239324150191026231]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//Weighted FLGPO (non subs)&#10;(&#10;sum(&#10;    (if [Reporting_month] = DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1]) THEN ([FLGP_non_subscribers_eur]/[Monthly_active_non_subscribers]) END)&#10;    *&#10;    (if [Reporting_month] = DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1]) THEN [Subscribers_total_month] END)&#10;)&#10;/&#10;sum(if [Reporting_month] = DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1]) THEN [Subscribers_total_month] END)&#10;)' />
            </column>
            <column caption='MoM User Profitability Comparison' datatype='real' default-format='n#,##0.0&quot;pp&quot;;-#,##0.0&quot;pp&quot;' name='[Calculation_239324150192427066]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100*(&#10;[User Profitability Comparison (copy)_239324150192164920]&#10;-&#10;[Reporting Month User Profitability Comparison (copy)_239324150192345145])' />
            </column>
            <column caption='Reporting Month % of Benefits Funded by Vendor' datatype='real' name='[Calculation_239324150194679872]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Reporting Month Total Subscription Benefits Eur (copy)_239324150193807422]&#10;/&#10;[Reporting Month Subscription Orders (copy)_239324150193233979]' />
            </column>
            <column caption='MoM % of Benefits Funded by Vendor' datatype='real' default-format='n#,##0.0&quot;pp&quot;;-#,##0.0&quot;pp&quot;' name='[Calculation_239324150195937346]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100*&#10;(&#10;[Calculation_239324150194679872]&#10;-&#10;[Reporting Month % of Benefits Funded by Vendor (copy)_239324150195425345]&#10;)' />
            </column>
            <column caption='Churned subscribers' datatype='real' name='[Churned_subscribers]' role='measure' type='quantitative' />
