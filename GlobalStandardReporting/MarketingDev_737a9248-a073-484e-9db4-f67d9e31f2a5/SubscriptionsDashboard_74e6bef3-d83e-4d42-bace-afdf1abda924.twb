      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontname='Tableau Bold'>      MBR Country Performance</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Local - Production' name='federated.1hy3d39034kucd1azkkp000ih9y1' />
            <datasource caption='Central based pipeline' name='federated.0p33fiq005s9rk1b8m01l19ra505' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.0p33fiq005s9rk1b8m01l19ra505].[Reporting_month]' caption='Reporting Month' datatype='datetime' default-format='*mmm yy' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2024-04-01 00:00:00#'>
              <calculation class='tableau' formula='#2024-04-01 00:00:00#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0p33fiq005s9rk1b8m01l19ra505'>
            <column caption='Reporting month' datatype='date' default-format='*mmm-yy' name='[Reporting_month]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1hy3d39034kucd1azkkp000ih9y1'>
            <column caption='Reporting Month Subscribers EOM' datatype='real' name='[Calculation_1098526511821881346]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Reporting_month]=[Parameters].[Parameter 1] THEN [Susbcribers_EOM] END)' />
            </column>
            <column caption='MoM % Subscribers' datatype='real' default-format='n#,##0.0&quot;pp&quot;;-#,##0.0&quot;pp&quot;' name='[Calculation_239324150161707014]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100*&#10;(&#10;[Reporting Month Monthly Active Users (copy)_239324150161133572]&#10;-&#10;[Reporting Month % Subscribers (copy)_2668664308102115328]&#10;)' />
            </column>
            <column caption='MoM New Subscribers (% of MAU)' datatype='real' default-format='n#,##0.0&quot;pp&quot;;-#,##0.0&quot;pp&quot;' name='[Calculation_239324150163484683]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100*&#10;(&#10;[Reporting Month % subscribers (copy)_239324150162907145]&#10;-&#10;[Reporting Month-1 % subscribers (copy)_239324150163345418]&#10;)' />
            </column>
            <column caption='Reporting Month Churn Rate (1m)' datatype='real' name='[Calculation_239324150173069337]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Reporting Month New Subscribers (copy)_239324150171766804]&#10;/&#10;[Reporting Month Churned Subscribers (copy)_239324150172762135]' />
            </column>
            <column caption='MoM Churn Rate (1m)' datatype='real' default-format='n#,##0.0&quot;pp&quot;;-#,##0.0&quot;pp&quot;' name='[Calculation_239324150173491227]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100*&#10;(&#10;[Calculation_239324150173069337]&#10;-&#10;[Reporting Month Churn Rate (1m) (copy)_239324150173323290]&#10;)' />
            </column>
            <column caption='Reporting Month Weighted post subs frequency 30d after' datatype='real' name='[Calculation_239324150180315170]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;IF [Reporting_month] = [Parameters].[Parameter 1] THEN&#10;([Post_subs_frequency_30d_after])&#10;*&#10;([Subscribers_total_month])&#10;END)&#10;/&#10;SUM(IF [Reporting_month]=[Parameters].[Parameter 1] THEN [Subscribers_total_month] END)' />
            </column>
            <column caption='Reporting 30d Weighted Post Frequency' datatype='real' name='[Calculation_239324150181138467]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;IF [Reporting_month] = DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1]) THEN&#10;([Post_subs_frequency_30d_after])&#10;*&#10;([Subscribers_total_month])&#10;END)&#10;/&#10;SUM(if [Reporting_month] = DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1]) THEN [Subscribers_total_month] END)' />
            </column>
            <column caption='Reporting Month Frequency Incrementality (%)' datatype='real' name='[Calculation_239324150182613031]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;[Calculation_239324150180315170]&#10;-&#10;[Reporting Month Weighted Current Frequency (copy)_239324150182191141]&#10;)&#10;/&#10;ABS([Calculation_239324150180315170])' />
            </column>
            <column caption='MoM Frequency Incrementality (%)' datatype='real' default-format='n#,##0.0&quot;pp&quot;;-#,##0.0&quot;pp&quot;' name='[Calculation_239324150182961193]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100*&#10;(&#10;[Calculation_239324150182613031]&#10;-&#10;[Reporting Month Frequency Uplift (%) (copy)_239324150182789160]&#10;)' />
            </column>
            <column caption='Reporting Month Weighted FLGPU (non-subs)' datatype='real' name='[Calculation_239324150190784566]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;sum(&#10;    (if [Reporting_month] = DATE([Parameters].[Parameter 1]) THEN ([FLGP_non_subscribers_eur]/[Monthly_active_non_subscribers]) END)&#10;    *&#10;    (if [Reporting_month] = DATE([Parameters].[Parameter 1]) THEN [Subscribers_total_month] END)&#10;)&#10;/&#10;sum(if [Reporting_month] = DATE([Parameters].[Parameter 1]) THEN [Subscribers_total_month] END)&#10;)' />
            </column>
            <column caption='Reporting Month-1 Weighted FLGPU (non-subs)' datatype='real' name='[Calculation_239324150191026231]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//Weighted FLGPO (non subs)&#10;(&#10;sum(&#10;    (if [Reporting_month] = DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1]) THEN ([FLGP_non_subscribers_eur]/[Monthly_active_non_subscribers]) END)&#10;    *&#10;    (if [Reporting_month] = DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1]) THEN [Subscribers_total_month] END)&#10;)&#10;/&#10;sum(if [Reporting_month] = DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1]) THEN [Subscribers_total_month] END)&#10;)' />
            </column>
            <column caption='Weighted post subs frequency 30d after' datatype='real' name='[Calculation_5059723858766929925]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(&#10;([Post_subs_frequency_30d_after])&#10;*&#10;([Subscribers_total_month])&#10;)&#10;/&#10;sum([Subscribers_total_month])' />
            </column>
            <column caption='Frequency Incrementality (%)' datatype='real' default-format='p0%' name='[Calculation_5059723858767507463]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;[Calculation_5059723858766929925]&#10;-&#10;[Weighted current frequency (copy)_5059723858767192070]&#10;)&#10;/&#10;[Calculation_5059723858766929925]' />
