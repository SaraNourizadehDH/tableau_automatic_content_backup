              <calculation class='tableau' formula='(&#10;[Reporting Month New Subscribers (% of MAU) (copy)_239324150188970035]&#10;-&#10;[Calculation_239324150190784566]&#10;)&#10;/&#10;[Calculation_239324150190784566]' />
