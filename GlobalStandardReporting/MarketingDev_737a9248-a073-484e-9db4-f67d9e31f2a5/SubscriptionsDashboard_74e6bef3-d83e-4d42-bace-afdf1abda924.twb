    <worksheet name='Manual - Data Table v'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontname='Tableau Bold'>Manual Data Table</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Local - Production' name='federated.1hy3d39034kucd1azkkp000ih9y1' />
          </datasources>
          <datasource-dependencies datasource='federated.1hy3d39034kucd1azkkp000ih9y1'>
            <column caption='Non Sub Benefits per users, €' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Benefits per subscriber, € (copy)_2383600472344322055]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([total_spend])&#10;- sum([Total_subscription_benefits_eur])&#10;)&#10;/&#10;sum([Monthly_active_users 1])' />
            </column>
            <column caption='Benefits ratio (Subs vs. all)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2383600472022896641]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM([Total_subscription_benefits_eur]) / SUM([Subscribers_total_month])&#10;)&#10;/&#10;(&#10;(&#10;    SUM([total_spend]) - SUM([Total_subscription_benefits_eur])&#10;)&#10;/&#10;SUM( [Monthly_active_users])&#10;)' />
            </column>
            <column caption='New subscribers (% of subscribers)' datatype='real' name='[Calculation_4902379349621223424]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([New_subscribers]) &#10;/ &#10;sum([Susbcribers_EOM])' />
            </column>
            <column caption='Total market orders' datatype='real' name='[Calculation_4902379349621710849]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Subscription_orders])&#10;+&#10;sum([Non_subscription_orders])' />
            </column>
            <column caption='Total market GMV' datatype='real' name='[Calculation_4902379349623664642]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([GMV_eur_subscribers])&#10;+&#10;sum([GMV_eur_non_subscribers])' />
            </column>
            <column caption='% Subscribers GMV' datatype='real' default-format='p0.0%' name='[Calculation_4902379349623861251]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([GMV_eur_subscribers])&#10;/&#10;[Calculation_4902379349623664642]' />
            </column>
            <column caption='All Users Frequency' datatype='real' name='[Calculation_4902379349624639492]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4902379349621710849]&#10;/&#10;sum([Monthly_active_users])' />
            </column>
            <column caption='Non Subscribers Frequency' datatype='real' name='[Calculation_4902379349626531845]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Non_subscription_orders])&#10;/&#10;sum([Monthly_active_non_subscribers])' />
            </column>
            <column caption='Gross Profit (all users)' datatype='real' name='[Calculation_4902379349628436486]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Gross_profit_subscriber_orders_eur])&#10;+&#10;sum([Gross_profit_non_subscriber_orders_eur])' />
            </column>
            <column caption='GPO (all users), €' datatype='real' name='[Calculation_4902379349628825607]' role='measure' type='quantitative'>
