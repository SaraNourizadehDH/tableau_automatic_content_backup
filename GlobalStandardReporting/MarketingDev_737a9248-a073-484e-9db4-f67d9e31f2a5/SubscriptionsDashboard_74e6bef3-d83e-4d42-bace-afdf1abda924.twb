              <calculation class='tableau' formula='(&#10;[Calculation_239324150180315170]&#10;-&#10;[Reporting Month Weighted Current Frequency (copy)_239324150182191141]&#10;)&#10;/&#10;ABS([Calculation_239324150180315170])' />
            </column>
            <column caption='MoM Frequency Incrementality (%)' datatype='real' default-format='n#,##0.0&quot;pp&quot;;-#,##0.0&quot;pp&quot;' name='[Calculation_239324150182961193]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100*&#10;(&#10;[Calculation_239324150182613031]&#10;-&#10;[Reporting Month Frequency Uplift (%) (copy)_239324150182789160]&#10;)' />
            </column>
            <column caption='Reporting Month Weighted FLGPU (non-subs)' datatype='real' name='[Calculation_239324150190784566]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;sum(&#10;    (if [Reporting_month] = DATE([Parameters].[Parameter 1]) THEN ([FLGP_non_subscribers_eur]/[Monthly_active_non_subscribers]) END)&#10;    *&#10;    (if [Reporting_month] = DATE([Parameters].[Parameter 1]) THEN [Subscribers_total_month] END)&#10;)&#10;/&#10;sum(if [Reporting_month] = DATE([Parameters].[Parameter 1]) THEN [Subscribers_total_month] END)&#10;)' />
            </column>
            <column caption='Reporting Month-1 Weighted FLGPU (non-subs)' datatype='real' name='[Calculation_239324150191026231]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//Weighted FLGPO (non subs)&#10;(&#10;sum(&#10;    (if [Reporting_month] = DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1]) THEN ([FLGP_non_subscribers_eur]/[Monthly_active_non_subscribers]) END)&#10;    *&#10;    (if [Reporting_month] = DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1]) THEN [Subscribers_total_month] END)&#10;)&#10;/&#10;sum(if [Reporting_month] = DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1]) THEN [Subscribers_total_month] END)&#10;)' />
