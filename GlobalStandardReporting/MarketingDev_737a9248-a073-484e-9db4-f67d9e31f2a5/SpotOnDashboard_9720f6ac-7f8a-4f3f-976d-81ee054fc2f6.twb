      <column caption='Legend Label' datatype='string' name='[Calculation_1700390344515067912]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Calculation_1916281709175377932]&#13;&#10;    WHEN &quot;Go&quot; THEN &quot;Go SpotOn score ≥ 50th and Messaging ≥ 66th&quot;&#13;&#10;    WHEN &quot;Adjust&quot; THEN &quot;Adjust SpotOn score ≥ 30th and Messaging ≥ 30th&quot;&#13;&#10;    WHEN &quot;Re-work&quot; THEN &quot;Re-work SpotOn score &lt; 30th or Messaging &lt; 30th&quot;&#13;&#10;END' />
      </column>
      <column caption='Legend Anchor' datatype='string' name='[Calculation_1700390344520028169]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Legend&quot;' />
      </column>
      <column caption='top5_spoton_score' datatype='integer' name='[Calculation_1916281709102313476]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_UNIQUE(SUM([ptile_spoton_score]),&apos;DESC&apos;)'>
          <table-calc ordering-field='[federated.1c29i0807nvcz011ax50l1mvdpoe].[country]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='spoton_messaging_color' datatype='string' name='[Calculation_1916281709175377932]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [ptile_spoton_score] &gt;= 50 AND [ptile_messaging] &gt;= 66 THEN &quot;Go&quot;&#13;&#10;ELSEIF [ptile_spoton_score] &gt;= 30 AND [ptile_messaging] &gt;= 30 THEN &quot;Adjust&quot;&#13;&#10;ELSEIF [ptile_spoton_score] &lt; 30 OR [ptile_messaging] &lt; 30 THEN &quot;Re-work&quot;&#13;&#10;END' />
      </column>
      <column caption='Item count' datatype='integer' name='[Calculation_540150489747415041]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_COUNT(COUNTD([adname]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Show Label?' datatype='string' name='[Calculation_540150489747521538]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] THEN STR([shortname])+ &quot;, &quot; + STR([length_ad]) ELSE &quot;&quot; END' />
      </column>
      <column caption='Cusotme sort for percentile view' datatype='string' name='[Calculation_662873576812412929]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [brand] = &quot;BaeMin(배달의민족)&quot; THEN &quot;0BaeMin(배달의민족)&quot;&#13;&#10;ELSEIF [brand] = &quot;foodora&quot; THEN &quot;0foodora&quot;&#13;&#10;ELSEIF [brand] = &quot;foodpanda&quot; THEN &quot;0foodpanda&quot;&#13;&#10;ELSEIF [brand] = &quot;Foody&quot; THEN &quot;0Foody&quot;&#13;&#10;ELSEIF [brand] = &quot;Glovo&quot; THEN &quot;0Glovo&quot;&#13;&#10;ELSEIF [brand] = &quot;Hungerstation&quot; THEN &quot;0Hungerstation&quot; &#13;&#10;ELSEIF [brand] = &quot;PedidosYa&quot; THEN &quot;00PedidosYa&quot;&#13;&#10;ELSEIF [brand] = &quot;talabat&quot; THEN &quot;00talabat&quot;&#13;&#10;ELSEIF [brand] = &quot;Yemeksepeti&quot; THEN &quot;0Yemeksepeti&quot;&#13;&#10;ELSEIF [brand] = &quot;mjam&quot; THEN &quot;0mjam&quot;&#13;&#10;ELSEIF [brand] = &quot;Dame jídlo&quot; THEN &quot;0Dame jídlo&quot;&#13;&#10;ELSEIF [brand] = &quot;Netpincer&quot; THEN &quot;0Netpincer&quot;&#13;&#10;ELSE [brand] END' />
      </column>
