      <column caption='Custome sort for weightage view' datatype='string' name='[Calculation_662873576799121408]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [brand] = &quot;BaeMin(배달의민족)&quot; THEN &quot;0BaeMin(배달의민족)&quot;&#13;&#10;ELSEIF [brand] = &quot;foodora&quot; THEN &quot;0foodora&quot;&#13;&#10;ELSEIF [brand] = &quot;foodpanda&quot; THEN &quot;0foodpanda&quot;&#13;&#10;ELSEIF [brand] = &quot;Foody&quot; THEN &quot;0Foody&quot;&#13;&#10;ELSEIF [brand] = &quot;Glovo&quot; THEN &quot;0Glovo&quot;&#13;&#10;ELSEIF [brand] = &quot;Hungerstation&quot; THEN &quot;0Hungerstation&quot; &#13;&#10;ELSEIF [brand] = &quot;PedidosYa&quot; THEN &quot;00PedidosYa&quot;&#13;&#10;ELSEIF [brand] = &quot;talabat&quot; THEN &quot;00talabat&quot;&#13;&#10;ELSEIF [brand] = &quot;Yemeksepeti&quot; THEN &quot;0Yemeksepeti&quot;&#13;&#10;ELSEIF [brand] = &quot;mjam&quot; THEN &quot;0mjam&quot;&#13;&#10;ELSEIF [brand] = &quot;Dame jídlo&quot; THEN &quot;0Dame jídlo&quot;&#13;&#10;ELSEIF [brand] = &quot;Netpincer&quot; THEN &quot;0Netpincer&quot;&#13;&#10;ELSE [brand] END' />
      </column>
      <column caption='spotonscore_%tage' datatype='real' name='[Calculation_665406853480132608]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[spoton_score]*100' />
      </column>
