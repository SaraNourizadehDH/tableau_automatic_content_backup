      <column caption='Spotonscore' datatype='real' name='[Calculation_1903896796494675969]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0.3*[brand_recall] + 0.2*[brandfit] + 0.4* ([relevance])' />
      </column>
      <column caption='diff_spoton_score' datatype='real' name='[Calculation_2325827733266087937]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([spoton_score]-[avg_spoton_score])*100' />
      </column>
      <column caption='placeholder' datatype='integer' name='[Calculation_2325827733300154372]' role='measure' type='quantitative'>
