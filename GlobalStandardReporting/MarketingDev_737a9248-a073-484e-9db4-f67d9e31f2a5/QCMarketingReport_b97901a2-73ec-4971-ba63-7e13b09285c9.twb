      <column caption='QC Order Frequency' datatype='real' name='[Calculation_117093638886019182]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[orders]/[customers_qc]' />
      </column>
      <column caption='QC MAU/Overall MAU' datatype='real' name='[Calculation_117093638886510704]' role='measure' type='quantitative'>
