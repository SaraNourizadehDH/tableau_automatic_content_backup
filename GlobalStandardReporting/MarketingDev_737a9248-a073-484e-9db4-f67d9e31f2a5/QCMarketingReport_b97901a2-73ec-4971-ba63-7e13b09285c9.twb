    <worksheet name='QC Overall'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='12'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='bima_qc_mkt_report (rl_mkt)' name='federated.11hgijf0ztey0w14nw3pd0hu5mnq' />
          </datasources>
          <datasource-dependencies datasource='federated.11hgijf0ztey0w14nw3pd0hu5mnq'>
            <column caption='% QC Orders with Vouchers All' datatype='real' name='[% QC Orders with Vouchers (copy)_1138003385872711715]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [breakdown] = &apos;All&apos; then [voucher_orders] end)/sum(if [breakdown] = &apos;All&apos; then [orders] end)' />
            </column>
            <column caption='% QC Orders with Vouchers LS' datatype='real' name='[% QC Orders with Vouchers All (copy) (copy)_1138003385873580070]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [breakdown] = &apos;Local Shops&apos; then [voucher_orders] end)/sum(if [breakdown] = &apos;Local Shops&apos; then [orders] end)' />
            </column>
            <column caption='% QC Orders with Vouchers Dmart' datatype='real' name='[% QC Orders with Vouchers All (copy)_1138003385873563685]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [breakdown] = &apos;Dmarts&apos; then [voucher_orders] end)/sum(if [breakdown] = &apos;Dmarts&apos; then [orders] end)' />
            </column>
            <column caption='QC Order Share (of Platform)' datatype='real' name='[Calculation_1140536658212634624]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders])/sum([platform_orders])' />
            </column>
            <column caption='Cross Sell/QC MAU' datatype='real' name='[Calculation_1140536659221938180]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF  [level] = &quot;xsell&quot; AND [breakdown]=&quot;All&quot;  then  [qc_cust] end) / sum(IF  [level] = &quot;topline&quot; AND [breakdown]=&quot;All&quot;  then [customers_qc] end)' />
            </column>
            <column caption='SKU/Order' datatype='real' name='[Calculation_117093638890057847]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sku])/SUM([orders])' />
            </column>
            <column caption='QC Sessions/Total Sessions' datatype='real' name='[Calculation_117093638893011064]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qc_sessions])/SUM([total_sessions])' />
            </column>
            <column caption='ATC Users' datatype='integer' name='[Calculation_117093638893531257]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [level] = &quot;add_to_cart_users&quot; then [users] END' />
            </column>
            <column caption='Filter Future Dates' datatype='boolean' name='[Calculation_1541638499278020615]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='TODAY()&gt;= [datemonth]' />
            </column>
            <column caption='Cross Sell/Prospect ALL' datatype='real' name='[Cross Sell/Prospect (copy)_1214846054078181377]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF  [level] = &quot;xsell&quot; AND [breakdown] = &quot;All&quot; THEN    [qc_cust] end) / sum(IF  [level] = &quot;topline&quot; AND [breakdown] = &quot;All&quot; THEN  [prospect] end)' />
            </column>
            <column caption='Cross Sell/Prospect LS' datatype='real' name='[Cross Sell/Prospect ALL (copy) (copy)_1214846054078861315]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF  [level] = &quot;xsell&quot; AND [breakdown] = &quot;Local Shops&quot; THEN    [qc_cust] end) / sum(IF  [level] = &quot;topline&quot; AND [breakdown] = &quot;Local Shops&quot; THEN  [prospect] end)' />
            </column>
            <column caption='Cross Sell/Prospect Dmart' datatype='real' name='[Cross Sell/Prospect ALL (copy)_1214846054078844930]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF  [level] = &quot;xsell&quot; AND [breakdown] = &quot;Dmarts&quot; THEN    [qc_cust] end) / sum(IF  [level] = &quot;topline&quot; AND [breakdown] = &quot;Dmarts&quot; THEN  [prospect] end)' />
            </column>
            <column caption='Cross Sell/QC MAU Dmarts' datatype='real' name='[Cross Sell/QC MAU (copy)_1214846054081437700]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF  [level] = &quot;xsell&quot; AND [breakdown]=&quot;Dmarts&quot;  then  [qc_cust] end) / sum(IF  [level] = &quot;topline&quot; AND [breakdown]=&quot;Dmarts&quot;  then [customers_qc] end)' />
