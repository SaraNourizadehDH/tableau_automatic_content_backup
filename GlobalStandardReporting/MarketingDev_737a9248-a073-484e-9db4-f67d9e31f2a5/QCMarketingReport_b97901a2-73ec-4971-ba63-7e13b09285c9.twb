    <worksheet name='QC Acquisition'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='12'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='bima_qc_mkt_report (rl_mkt)' name='federated.11hgijf0ztey0w14nw3pd0hu5mnq' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Table Selector' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Repeat&quot;'>
              <calculation class='tableau' formula='&quot;Repeat&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.11hgijf0ztey0w14nw3pd0hu5mnq'>
            <column caption='Free Delivery Order %' datatype='real' name='[Calculation_1140536659228864518]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([qc_orders_free_delivery]) / sum([qc_orders])' />
            </column>
            <column caption='% Orders with Vouchers' datatype='real' name='[Calculation_1140536659258552327]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([voucher_qc_ct_orders])/sum([qc_orders])' />
            </column>
            <column caption='Discount/GBV' datatype='real' name='[Calculation_1140536659259232264]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([qc_discount_dh_eur])/sum([sum_qc_gbv])' />
            </column>
            <column caption='(ZN(SUM([GMV])) - LOOKUP(ZN(SUM([GMV])), -1)) / ABS(LOOKUP(ZN...' datatype='real' name='[Calculation_117093637465636902]' role='measure' type='quantitative' user:unnamed='QC Acquisition'>
              <calculation class='tableau' formula='(ZN(SUM([sum_qc_gmv])) - LOOKUP(ZN(SUM([sum_qc_gmv])), -1)) / ABS(LOOKUP(ZN(SUM([sum_qc_gmv])), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='(ZN(SUM([GBV])) - LOOKUP(ZN(SUM([GBV])), -1)) / ABS(LOOKUP(ZN...' datatype='real' name='[Calculation_117093637465690152]' role='measure' type='quantitative' user:unnamed='QC Acquisition'>
              <calculation class='tableau' formula='(ZN(SUM([sum_qc_gbv])) - LOOKUP(ZN(SUM([sum_qc_gbv])), -1)) / ABS(LOOKUP(ZN(SUM([sum_qc_gbv])), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
