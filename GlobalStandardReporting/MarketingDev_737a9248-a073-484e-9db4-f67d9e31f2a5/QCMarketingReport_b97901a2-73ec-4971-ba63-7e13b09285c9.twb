      <column caption='QC Order Share (of Platform)' datatype='real' name='[Calculation_1140536658212634624]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([orders])/sum([platform_orders])' />
      </column>
      <column caption='QC Free Delivery %' datatype='real' name='[Calculation_1140536659183501313]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([free_delivery_orders]) / sum([orders])' />
      </column>
      <column caption='QC Voucher/Platform Voucher' datatype='real' name='[Calculation_1140536659184377858]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([voucher_value]) / sum([voucher_dh_eur])' />
      </column>
      <column caption='Cross Sell/QC MAU' datatype='real' name='[Calculation_1140536659221938180]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF  [level] = &quot;xsell&quot; AND [breakdown]=&quot;All&quot;  then  [qc_cust] end) / sum(IF  [level] = &quot;topline&quot; AND [breakdown]=&quot;All&quot;  then [customers_qc] end)' />
      </column>
      <column caption='Discount/GMV' datatype='real' name='[Calculation_1140536659223814149]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([qc_discount_dh_eur])/ sum([sum_qc_gmv])' />
      </column>
      <column caption='Free Delivery Order %' datatype='real' name='[Calculation_1140536659228864518]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([qc_orders_free_delivery]) / sum([qc_orders])' />
      </column>
      <column caption='% Orders with Vouchers' datatype='real' name='[Calculation_1140536659258552327]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([voucher_qc_ct_orders])/sum([qc_orders])' />
      </column>
      <column caption='Discount/GBV' datatype='real' name='[Calculation_1140536659259232264]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([qc_discount_dh_eur])/sum([sum_qc_gbv])' />
      </column>
      <column caption='user_entitlement' datatype='boolean' name='[Calculation_117093637928157292]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
