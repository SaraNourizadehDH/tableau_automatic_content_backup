      <column caption='% QC Orders with Vouchers All' datatype='real' name='[% QC Orders with Vouchers (copy)_1138003385872711715]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [breakdown] = &apos;All&apos; then [voucher_orders] end)/sum(if [breakdown] = &apos;All&apos; then [orders] end)' />
      </column>
      <column caption='% QC Orders with Vouchers LS' datatype='real' name='[% QC Orders with Vouchers All (copy) (copy)_1138003385873580070]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [breakdown] = &apos;Local Shops&apos; then [voucher_orders] end)/sum(if [breakdown] = &apos;Local Shops&apos; then [orders] end)' />
      </column>
