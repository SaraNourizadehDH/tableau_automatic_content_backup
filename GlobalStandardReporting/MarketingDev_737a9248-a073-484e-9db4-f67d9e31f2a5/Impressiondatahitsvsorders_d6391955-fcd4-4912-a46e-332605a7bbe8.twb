              <expression op='='>
                <expression op='[fee]' />
                <expression op='[delivery_fee_local]' />
              </expression>
              <expression op='='>
                <expression op='[global_entity_id]' />
                <expression op='[entity_id]' />
              </expression>
            </expression>
            <first-end-point object-id='_84CD925C74D94B01AF0D0ED5705A5C70' />
            <second-end-point object-id='_33D3C35AFEFB4F70987ED29592AB1C42' />
          </relationship>
        </relationships>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
