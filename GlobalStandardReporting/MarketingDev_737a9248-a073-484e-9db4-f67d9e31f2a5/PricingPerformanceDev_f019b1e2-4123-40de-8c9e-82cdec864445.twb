              <calculation class='tableau' formula='ROUND(SUM(IF [has_dps_incentive] THEN dps_standard_fee_eur ELSE dps_delivery_fee_eur END)/[Aggregation (copy)_1846475850361638916],2)' />
            </column>
            <column caption='Is Total' datatype='boolean' name='[Is Distance Bucket Selected (2/3) (copy)_3085810177987194924]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1] = &quot;Total&quot;&#13;&#10;OR [Parameters].[Parameter 1] = &quot;Total (M)&quot;&#13;&#10;OR [Parameters].[Parameter 1] = &quot;Total (k)&quot;&#13;&#10;OR [Parameters].[Aggregation (copy)_3085810177976442919] = &quot;Total&quot;&#13;&#10;OR [Parameters].[Aggregation (copy)_3085810177976442919] = &quot;Total (M)&quot;&#13;&#10;OR [Parameters].[Aggregation (copy)_3085810177976442919] = &quot;Total (k)&quot;' />
