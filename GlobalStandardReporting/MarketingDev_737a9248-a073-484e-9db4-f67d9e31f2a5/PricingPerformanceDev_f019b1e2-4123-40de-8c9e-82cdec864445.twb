            <column caption='Vendor Subsidies (per order)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Customer Fees Paid (per order) (copy)_2515260399178711056]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([customer_fees_other_funded]&#13;&#10;+ [subscription_vendor_subsidy_net]&#13;&#10;+ [vendor_funded_delivery_fee_subsidy_net])&#13;&#10;/COUNT([__tableau_internal_object_id__].[pricing_framework_31443A764E8F4C8ABB81B0659FA41FC5])' />
            </column>
