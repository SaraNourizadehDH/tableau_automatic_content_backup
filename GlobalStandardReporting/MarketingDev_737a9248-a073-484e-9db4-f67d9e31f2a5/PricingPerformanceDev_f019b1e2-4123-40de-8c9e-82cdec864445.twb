            <column caption='Operational Metric 3' datatype='string' name='[Metric 3 (copy)_3085810177973952550]' param-domain-type='list' role='measure' type='nominal' value='&quot;Profitable Orders&quot;'>
              <calculation class='tableau' formula='&quot;Profitable Orders&quot;' />
