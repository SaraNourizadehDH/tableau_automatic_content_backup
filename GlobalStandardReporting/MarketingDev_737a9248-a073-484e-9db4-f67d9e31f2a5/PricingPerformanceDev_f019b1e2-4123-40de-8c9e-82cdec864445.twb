      <table>
        <view>
          <datasources>
            <datasource caption='pricing_framework (growth_pricing)' name='federated.16xq89b15ombu418amgk303gpxk5' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Reference' datatype='string' name='[Aggregation (copy)_166351713677688839]' param-domain-type='list' role='measure' type='nominal' value='&quot;Orders&quot;'>
              <calculation class='tableau' formula='&quot;Orders&quot;' />
            </column>
            <column caption='Basket Bucket Size (€)' datatype='real' name='[Basket Bucket Cap (copy)_166351713725837325]' param-domain-type='any' role='measure' type='quantitative' value='2.5'>
              <calculation class='tableau' formula='2.5' />
            </column>
            <column caption='Distance Bucket Cap (km)' datatype='real' name='[Basket Bucket Cap (copy)_166351713726308367]' param-domain-type='any' role='measure' type='quantitative' value='8.'>
              <calculation class='tableau' formula='8.' />
            </column>
            <column caption='Distance Bucket Size (km)' datatype='real' name='[Basket Bucket Size (copy)_166351713726308366]' param-domain-type='any' role='measure' type='quantitative' value='0.5'>
              <calculation class='tableau' formula='0.5' />
            </column>
            <column caption='Dimension (3)' datatype='string' name='[Dimension (copy) (copy)_3085810177783549974]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekday&quot;'>
              <calculation class='tableau' formula='&quot;Weekday&quot;' />
            </column>
            <column caption='Dimension (2)' datatype='string' name='[Dimension (copy)_3085810177783541781]' param-domain-type='list' role='measure' type='nominal' value='&quot;Time of Day&quot;'>
              <calculation class='tableau' formula='&quot;Time of Day&quot;' />
            </column>
            <column caption='Aggregation' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% Basket Value&quot;'>
              <calculation class='tableau' formula='&quot;% Basket Value&quot;' />
              <aliases>
                <alias key='&quot;Total (M)&quot;' value='Total (M)' />
              </aliases>
            </column>
            <column caption='Basket Bucket Cap (€)' datatype='real' name='[Parameter 3]' param-domain-type='any' role='measure' type='quantitative' value='35.'>
              <calculation class='tableau' formula='35.' />
            </column>
            <column caption='Reference (%)' datatype='string' name='[Reference (copy)_166351713693966345]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% of Orders&quot;'>
              <calculation class='tableau' formula='&quot;% of Orders&quot;' />
            </column>
            <column caption='Detail' datatype='string' name='[Vertical Type Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Brand Name&quot;'>
              <calculation class='tableau' formula='&quot;Brand Name&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.16xq89b15ombu418amgk303gpxk5'>
            <column caption='Reference (%)' datatype='real' default-format='p0.0%' name='[Aggregation (copy)_1139973721959792666]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Reference (copy)_166351713693966345]&#13;&#10;WHEN &apos;% of Orders&apos; THEN SUM(IF [is_successful] THEN 1 ELSE 0 END) / WINDOW_SUM(SUM(IF [is_successful] THEN 1 ELSE 0 END)) &#13;&#10;WHEN &apos;% of GMV&apos; THEN SUM([gmv_eur]) / WINDOW_SUM(SUM([gmv_eur]))&#13;&#10;WHEN &apos;% of Basket Value&apos; THEN SUM([basket_value_paid_eur]) / WINDOW_SUM(SUM([basket_value_paid_eur]))&#13;&#10;WHEN &apos;% of Total Fees Paid&apos; THEN SUM([total_fees_paid_eur]) / WINDOW_SUM(SUM([total_fees_paid_eur]))&#13;&#10;WHEN &apos;% of Total Fees Net&apos; THEN SUM([total_fees_paid_net_eur]) / WINDOW_SUM(SUM([total_fees_paid_net_eur]))&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='string' name='[Brand Name (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[brand_name]' new-bin='true'>
                <bin default-name='false' value='&quot;DH Greece&quot;'>
                  <value>&quot;Foody&quot;</value>
                  <value>&quot;eFood&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='Distance Buckets (km)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1139973721946095621]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(&#13;&#10;    IF [delivery_distance] &gt; [Parameters].[Basket Bucket Cap (copy)_166351713726308367] THEN [Parameters].[Basket Bucket Cap (copy)_166351713726308367]&#13;&#10;    //ELSEIF [Delivery Distance] &gt; 9 THEN ROUND([Delivery Distance] / 1) * 1&#13;&#10;    //ELSEIF [Delivery Distance] &gt; 6 THEN ROUND([Delivery Distance] / 0.75) * 0.75&#13;&#10;    ELSE ROUND([delivery_distance] / [Parameters].[Basket Bucket Size (copy)_166351713726308366]) * [Parameters].[Basket Bucket Size (copy)_166351713726308366]&#13;&#10;    END&#13;&#10;,2)' />
            </column>
            <column caption='Subscription Status' datatype='boolean' name='[Calculation_2890748014811713536]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([is_subscriber] = &apos;subscriber&apos;, FALSE)' />
              <aliases>
                <alias key='false' value='Non-Subscriber' />
                <alias key='true' value='Subscriber' />
              </aliases>
            </column>
            <column caption='&apos;&apos;' datatype='string' name='[Calculation_3085810177784967192]' role='dimension' type='nominal' user:unnamed='Reference (Distance) (2)'>
              <calculation class='tableau' formula='&apos;&apos;' />
            </column>
            <column aggregation='Sum' caption='Time of Day' datatype='integer' name='[Calculation_3085810177788899355]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [occasion_time_of_day]&#13;&#10;    WHEN &apos;breakfast&apos; THEN 1&#13;&#10;    WHEN &apos;lunch&apos; THEN 2&#13;&#10;    WHEN &apos;afternoon&apos; THEN 3&#13;&#10;    WHEN &apos;dinner&apos; THEN 4&#13;&#10;    WHEN &apos;late_night&apos; THEN 5&#13;&#10;END' />
            </column>
            <column aggregation='Sum' caption='Day of Week' datatype='integer' name='[Calculation_3085810177789280284]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [occasion_day_of_week]&#13;&#10;WHEN &apos;weekday&apos; THEN 1&#13;&#10;WHEN &apos;weekend&apos; THEN 2&#13;&#10;END' />
            </column>
            <column aggregation='Sum' caption='Weekday (#)' datatype='integer' name='[Calculation_3085810177798340641]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEPART(&apos;weekday&apos;, [order_placed_at] - 1)' />
            </column>
            <column aggregation='Sum' caption='Dimension (3)' datatype='real' name='[Dimension (copy) (copy)_3085810177783488532]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Dimension (copy) (copy)_3085810177783549974]&#13;&#10;WHEN &apos;Basket Bucket&apos; THEN [Distance Buckets (Km) (copy)_1139973722194489382]&#13;&#10;WHEN &apos;Distance Bucket&apos; THEN [Calculation_1139973721946095621]&#13;&#10;WHEN &apos;Month&apos; THEN DATEDIFF(&apos;month&apos;,TODAY(), [order_placed_at])&#13;&#10;WHEN &apos;Week&apos; THEN DATEDIFF(&apos;week&apos;,TODAY(), [order_placed_at])&#13;&#10;WHEN &apos;Day&apos; THEN DATEDIFF(&apos;day&apos;,TODAY(), [order_placed_at])&#13;&#10;WHEN &apos;Weekday&apos; THEN [Calculation_3085810177798340641] // makes Monday the first day&#13;&#10;WHEN &apos;Time of Day&apos; THEN [Calculation_3085810177788899355]&#13;&#10;WHEN &apos;Day of Week&apos; THEN [Calculation_3085810177789280284]&#13;&#10;WHEN &apos;Unhealthy Score&apos; THEN ROUND([customer_unhealthy_score]/0.1)*0.1&#13;&#10;WHEN &apos;Delivery Fee Score&apos; THEN ROUND([customer_delivery_fee_score]/0.1)*0.1&#13;&#10;WHEN &apos;Reorder Probability within 28d&apos; THEN ROUND([customer_reorder_probability_all_verts_general_28_days]/10)*10&#13;&#10;END' />
            </column>
            <column aggregation='Sum' caption='Dimension (2)' datatype='real' name='[Dimension (copy)_3085810177783472147]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Dimension (copy)_3085810177783541781]&#13;&#10;WHEN &apos;Basket Bucket&apos; THEN [Distance Buckets (Km) (copy)_1139973722194489382]&#13;&#10;WHEN &apos;Distance Bucket&apos; THEN [Calculation_1139973721946095621]&#13;&#10;WHEN &apos;Month&apos; THEN DATEDIFF(&apos;month&apos;,TODAY(), [order_placed_at])&#13;&#10;WHEN &apos;Week&apos; THEN DATEDIFF(&apos;week&apos;,TODAY(), [order_placed_at])&#13;&#10;WHEN &apos;Day&apos; THEN DATEDIFF(&apos;day&apos;,TODAY(), [order_placed_at])&#13;&#10;WHEN &apos;Weekday&apos; THEN [Calculation_3085810177798340641] // makes Monday the first day&#13;&#10;WHEN &apos;Time of Day&apos; THEN [Calculation_3085810177788899355]&#13;&#10;WHEN &apos;Day of Week&apos; THEN [Calculation_3085810177789280284]&#13;&#10;WHEN &apos;Unhealthy Score&apos; THEN ROUND([customer_unhealthy_score]/0.1)*0.1&#13;&#10;WHEN &apos;Delivery Fee Score&apos; THEN ROUND([customer_delivery_fee_score]/0.1)*0.1&#13;&#10;WHEN &apos;Reorder Probability within 28d&apos; THEN ROUND([customer_reorder_probability_all_verts_general_28_days]/10)*10&#13;&#10;END' />
            </column>
            <column caption='Basket Buckets' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Distance Buckets (Km) (copy)_1139973722194489382]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(IF [basket_value_paid_eur] &gt; [Parameters].[Parameter 3] THEN [Parameters].[Parameter 3]&#13;&#10;ELSEIF [basket_value_paid_eur] &gt; [Parameters].[Basket Bucket Cap (copy)_166351713725837325] THEN ROUND([basket_value_paid_eur] / [Parameters].[Basket Bucket Cap (copy)_166351713725837325]) * [Parameters].[Basket Bucket Cap (copy)_166351713725837325]&#13;&#10;ELSE 0&#13;&#10;END,2)' />
            </column>
            <column caption='Reference' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Volume (copy)_139330180158468118]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Aggregation (copy)_166351713677688839]&#13;&#10;WHEN &apos;Orders&apos; THEN SUM(IF [is_successful] THEN 1 ELSE 0 END)&#13;&#10;WHEN &apos;Orders (M)&apos; THEN SUM(IF [is_successful] THEN 1 ELSE 0 END) / 1000000&#13;&#10;WHEN &apos;Customer Accounts&apos; THEN COUNTD([global_entity_id] + &apos;-&apos; + [customer_account_id])&#13;&#10;WHEN &apos;Customer Accounts (M)&apos; THEN COUNTD([global_entity_id] + &apos;-&apos; + [customer_account_id]) / 1000000&#13;&#10;WHEN &apos;Analytical Customers&apos; THEN COUNTD([global_entity_id] + &apos;-&apos; + [analytical_customer_id])&#13;&#10;WHEN &apos;Analytical Customers (M)&apos; THEN COUNTD([global_entity_id] + &apos;-&apos; + [analytical_customer_id]) / 1000000&#13;&#10;WHEN &apos;Vendors&apos; THEN COUNTD([global_entity_id] + &apos;-&apos; + [vendor_id])&#13;&#10;WHEN &apos;Vendors (M)&apos; THEN COUNTD([global_entity_id] + &apos;-&apos; + [vendor_id]) / 1000000&#13;&#10;WHEN &apos;GMV&apos; THEN SUM([gmv_eur])&#13;&#10;WHEN &apos;GMV (M)&apos; THEN SUM([gmv_eur]) / 1000000&#13;&#10;WHEN &apos;Basket Value&apos; THEN SUM([basket_value_paid_eur])&#13;&#10;WHEN &apos;Basket Value (M)&apos; THEN SUM([basket_value_paid_eur]) / 1000000&#13;&#10;WHEN &apos;Total Fees Paid&apos; THEN SUM([total_fees_paid_eur])&#13;&#10;WHEN &apos;Total Fees Paid (M)&apos; THEN SUM([total_fees_paid_eur]) / 1000000&#13;&#10;WHEN &apos;Total Fees Net&apos; THEN SUM([total_fees_paid_net_eur])&#13;&#10;WHEN &apos;Total Fees Net (M)&apos; THEN SUM([total_fees_paid_net_eur]) / 1000000&#13;&#10;END' />
            </column>
