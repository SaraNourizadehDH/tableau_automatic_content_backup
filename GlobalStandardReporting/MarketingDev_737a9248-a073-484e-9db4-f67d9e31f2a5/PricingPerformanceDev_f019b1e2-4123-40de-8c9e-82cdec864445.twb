            </column>
            <column caption='Financial Metric 3' datatype='string' name='[Metric 2 (copy)_3085810177778315281]' param-domain-type='list' role='measure' type='nominal' value='&quot;Analytical Profit&quot;'>
              <calculation class='tableau' formula='&quot;Analytical Profit&quot;' />
