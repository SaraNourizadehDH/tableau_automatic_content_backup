              <calculation class='tableau' formula='SUM(IF &#13;&#10;    NOT ISNULL([service_fee_component_id]) &#13;&#10;    //AND IFNULL([service_fee],0) + IFNULL([min_service_fee],0) &lt;&gt; 0 &#13;&#10;THEN 1 ELSE 0 END)' />
            </column>
            <column caption='Surge Fee Enabled' datatype='integer' name='[Service Fee Enabled (copy)_3085810177978617898]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF &#13;&#10;    NOT ISNULL([surge_fee_component_id]) &#13;&#10;THEN 1 ELSE 0 END)' />
            </column>
            <column caption='Delivery Fee Net' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Service Fee Net (copy)_1139973722152026141]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([delivery_fee_net])/[Calculation_1139973721956712471],2)' />
            </column>
            <column caption='Priority Fee Net' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Service Fee Net (copy)_1139973722152595486]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([priority_fee_net])/[Calculation_1139973721956712471],2)' />
            </column>
            <column caption='Small Basket Fee Net' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Service Fee Net (copy)_1139973722153009183]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([small_basket_fee_net])/[Calculation_1139973721956712471],2)' />
