            <column caption='Vendor Subsidies (% of BV) MoM pp' datatype='real' default-format='*0.0 pp;-0.0 pp;-' name='[Customer Fees Paid (% of BV) MoM pp (copy)_2515260399179210769]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN([Customer Fees Paid (% of BV) (copy)_2515260399178633231]) - LOOKUP(ZN([Customer Fees Paid (% of BV) (copy)_2515260399178633231]), -1)) * 100'>
                <table-calc ordering-type='Rows' />
