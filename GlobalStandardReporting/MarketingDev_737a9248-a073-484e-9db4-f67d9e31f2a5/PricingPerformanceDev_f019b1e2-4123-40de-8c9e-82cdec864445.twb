            </column>
            <column caption='Vendor Subsidies (% of BV) YoY pp' datatype='real' default-format='*0.0 pp;-0.0 pp;-' name='[Customer Fees Paid (% of BV) YoY pp (copy)_2515260399179288594]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN([Customer Fees Paid (% of BV) (copy)_2515260399178633231]) - LOOKUP(ZN([Customer Fees Paid (% of BV) (copy)_2515260399178633231]), -12)) * 100'>
