        <calculation class='tableau' formula='SUM(IF &#13;&#10;    NOT ISNULL([service_fee_component_id]) &#13;&#10;    //AND IFNULL([service_fee],0) + IFNULL([min_service_fee],0) &lt;&gt; 0 &#13;&#10;THEN 1 ELSE 0 END)' />
