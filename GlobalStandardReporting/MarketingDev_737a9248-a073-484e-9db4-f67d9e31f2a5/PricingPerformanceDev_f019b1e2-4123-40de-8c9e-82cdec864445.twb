            <column caption='Bad Weather Fee Net' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Delivery Fee Net (copy)_1139973722153857056]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([bad_weather_fee_net])/[Calculation_1139973721956712471],2)' />
