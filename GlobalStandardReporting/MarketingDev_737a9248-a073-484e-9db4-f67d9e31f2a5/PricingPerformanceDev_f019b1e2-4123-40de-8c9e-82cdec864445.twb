              <calculation class='tableau' formula='ROUND(IF [basket_value_paid_eur] &gt; [Parameters].[Parameter 3] THEN [Parameters].[Parameter 3]&#13;&#10;ELSEIF [basket_value_paid_eur] &gt; [Parameters].[Basket Bucket Cap (copy)_166351713725837325] THEN ROUND([basket_value_paid_eur] / [Parameters].[Basket Bucket Cap (copy)_166351713725837325]) * [Parameters].[Basket Bucket Cap (copy)_166351713725837325]&#13;&#10;ELSE 0&#13;&#10;END,2)' />
            </column>
