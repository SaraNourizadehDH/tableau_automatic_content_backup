              <calculation class='tableau' formula='ROUND(SUM([gmv_eur])/[Calculation_1139973721956712471],2)' />
            </column>
            <column caption='Delivery Fee Paid' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Delivery Fee Gross (copy)_5755600392051531834]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([delivery_fee_eur])/[Calculation_1139973721956712471],2)' />
