      <column caption='Reference (%)' datatype='real' default-format='p0.0%' name='[Aggregation (copy)_1139973721959792666]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Reference (copy)_166351713693966345]&#13;&#10;WHEN &apos;% of Orders&apos; THEN SUM(IF [is_successful] THEN 1 ELSE 0 END) / WINDOW_SUM(SUM(IF [is_successful] THEN 1 ELSE 0 END)) &#13;&#10;WHEN &apos;% of GMV&apos; THEN SUM([gmv_eur]) / WINDOW_SUM(SUM([gmv_eur]))&#13;&#10;WHEN &apos;% of Basket Value&apos; THEN SUM([basket_value_paid_eur]) / WINDOW_SUM(SUM([basket_value_paid_eur]))&#13;&#10;WHEN &apos;% of Total Fees Paid&apos; THEN SUM([total_fees_paid_eur]) / WINDOW_SUM(SUM([total_fees_paid_eur]))&#13;&#10;WHEN &apos;% of Total Fees Net&apos; THEN SUM([total_fees_paid_net_eur]) / WINDOW_SUM(SUM([total_fees_paid_net_eur]))&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='DPS Aggregation' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Aggregation (copy)_1846475850361638916]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Total&apos; THEN 1&#13;&#10;WHEN &apos;Total (M)&apos; THEN 1000000&#13;&#10;WHEN &apos;Total (k)&apos; THEN 1000&#13;&#10;WHEN &apos;Per Order&apos; THEN SUM(IF [is_dps] THEN 1 END)&#13;&#10;WHEN &apos;Per Customer Account&apos; THEN COUNTD(IF [is_dps] THEN [customer_account_id] END)&#13;&#10;WHEN &apos;Per Analyt. Customer&apos; THEN COUNTD(IF [is_dps] THEN [analytical_customer_id] END)&#13;&#10;WHEN &apos;Per Day&apos; THEN COUNTD(IF [is_dps] THEN [order_placed_at] END)&#13;&#10;/**&#13;&#10;WHEN &apos;Per Day&apos; THEN &#13;&#10;&#9;MAX(IF DATETRUNC(&apos;month&apos;,[Order Placed At]) &lt; DATETRUNC(&apos;month&apos;, TODAY())&#13;&#10;    &#9;THEN DATEPART(&apos;day&apos;,(DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,1,[Order Placed At])) - 1))&#13;&#10;&#9;&#9;ELSE DATEPART(&apos;day&apos;,[Order Placed At])&#13;&#10;&#9;END)&#13;&#10;**/&#13;&#10;WHEN &apos;% GMV&apos; THEN SUM(IF [is_dps] THEN [gmv_eur] END) / 100&#13;&#10;WHEN &apos;% Basket Value&apos; THEN SUM(IF [is_dps] THEN [basket_value_paid_eur] END) / 100&#13;&#10;WHEN &apos;% Total Fees&apos; THEN SUM(IF [is_dps] THEN [total_fees_paid_eur] END) / 100&#13;&#10;WHEN &apos;% Total Fees Net&apos; THEN SUM(IF [is_dps] THEN [total_fees_paid_net_eur] END) / 100&#13;&#10;//WHEN &apos;% of Orders&apos; THEN WINDOW_SUM(COUNT([pricing_framework])) / 100&#13;&#10;END' />
      </column>
      <column caption='Aggregation (ops)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Aggregation (copy)_3085810177976483880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Aggregation (copy)_3085810177976442919]&#13;&#10;WHEN &apos;Total&apos; THEN 1&#13;&#10;WHEN &apos;Total (M)&apos; THEN 1000000&#13;&#10;WHEN &apos;Total (k)&apos; THEN 1000&#13;&#10;WHEN &apos;Per Cent&apos; THEN COUNT([__tableau_internal_object_id__].[pricing_framework_31443A764E8F4C8ABB81B0659FA41FC5]) / 100&#13;&#10;WHEN &apos;Per Order&apos; THEN COUNT([__tableau_internal_object_id__].[pricing_framework_31443A764E8F4C8ABB81B0659FA41FC5])&#13;&#10;WHEN &apos;Per Customer Account&apos; THEN COUNTD([customer_account_id])&#13;&#10;WHEN &apos;Per Analyt. Customer&apos; THEN COUNTD([analytical_customer_id])&#13;&#10;WHEN &apos;Per Day&apos; THEN COUNTD([order_placed_at])&#13;&#10;/**&#13;&#10;WHEN &apos;Per Day&apos; THEN &#13;&#10;&#9;MAX(IF DATETRUNC(&apos;month&apos;,[Order Placed At]) &lt; DATETRUNC(&apos;month&apos;, TODAY())&#13;&#10;    &#9;THEN DATEPART(&apos;day&apos;,(DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,1,[Order Placed At])) - 1))&#13;&#10;&#9;&#9;ELSE DATEPART(&apos;day&apos;,[Order Placed At])&#13;&#10;&#9;END)&#13;&#10;**/&#13;&#10;WHEN &apos;% GMV&apos; THEN SUM([gmv_eur]) / 100&#13;&#10;WHEN &apos;% Basket Value&apos; THEN SUM([basket_value_paid_eur]) / 100&#13;&#10;WHEN &apos;% Total Fees&apos; THEN SUM([total_fees_paid_eur]) / 100&#13;&#10;WHEN &apos;% Total Fees Net&apos; THEN SUM([total_fees_paid_net_eur]) / 100&#13;&#10;//WHEN &apos;% of Orders&apos; THEN WINDOW_SUM(COUNT([pricing_framework])) / 100&#13;&#10;END' />
      </column>
      <column caption='Customer Fees Paid (% of BV)' datatype='real' default-format='p0.0%' name='[Analytical Profit (% of GMV) (copy)_1132936785223794730]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Total Fees Paid (M) (copy)_1132936785172168721]/[Basket Value Paid (copy)_1132936785174761494]' />
      </column>
      <column caption='Analytical Profit (% of GMV) YoY pp' datatype='real' default-format='*0.0 pp;-0.0 pp;-' name='[Analytical Profit (% of GMV) MoM % (copy)_1132936785200848933]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN([Analytical Profit (copy)_1132936785200119842]) - LOOKUP(ZN([Analytical Profit (copy)_1132936785200119842]), -12)) * 100'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Customer Fees Paid (% of BV) MoM pp' datatype='real' default-format='*0.0 pp;-0.0 pp;-' name='[Analytical Profit (% of GMV) MoM pp (copy)_1132936785223794731]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN([Analytical Profit (% of GMV) (copy)_1132936785223794730]) - LOOKUP(ZN([Analytical Profit (% of GMV) (copy)_1132936785223794730]), -1)) * 100'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Customer Fees Paid (% of BV) YoY pp' datatype='real' default-format='*0.0 pp;-0.0 pp;-' name='[Analytical Profit (% of GMV) YoY pp (copy)_1132936785223794729]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN([Analytical Profit (% of GMV) (copy)_1132936785223794730]) - LOOKUP(ZN([Analytical Profit (% of GMV) (copy)_1132936785223794730]), -12)) * 100'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Analytical Profit (% of GMV)' datatype='real' default-format='p0.0%' name='[Analytical Profit (copy)_1132936785200119842]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([analytical_profit]) / SUM([gmv_eur]) / [Calculation_1132936785236541487]' />
      </column>
      <column caption='Bad Weather Fee Paid' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Bad Weather Fee Net (copy)_5755600392040185896]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([bad_weather_fee_eur])/[Calculation_1139973721956712471],2)' />
      </column>
      <column caption='Basket Value Nominal' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Bad Weather Fee Net (copy)_5755600392040370217]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([basket_value_nominal_eur])/[Calculation_1139973721956712471],2)' />
      </column>
      <column caption='Basket Value Paid' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Basket Value Nominal (copy)_5755600392040484906]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([basket_value_paid_eur])/[Calculation_1139973721956712471],2)' />
      </column>
      <column caption='Basket Value Paid (per order)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Basket Value Paid (copy)_1132936785174761494]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([basket_value_paid_eur])/COUNT([__tableau_internal_object_id__].[pricing_framework_31443A764E8F4C8ABB81B0659FA41FC5]),8)' />
      </column>
      <column caption='Commission Fee Net' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Basket Value Paid (copy)_5755600392040583211]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([commission_fee_net])/[Calculation_1139973721956712471],2)' />
      </column>
      <column caption='Analytical Profit (% of GMV) MoM pp' datatype='real' default-format='*0.0 pp;-0.0 pp;-' name='[Basket Value Paid (per order) MoM % (copy)_1132936785200381987]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN([Analytical Profit (copy)_1132936785200119842]) - LOOKUP(ZN([Analytical Profit (copy)_1132936785200119842]), -1)) * 100'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='string' name='[Brand Name (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[brand_name]' new-bin='true'>
          <bin default-name='false' value='&quot;DH Greece&quot;'>
            <value>&quot;Foody&quot;</value>
            <value>&quot;eFood&quot;</value>
          </bin>
        </calculation>
      </column>
      <column caption='Breakdown ungrouped' datatype='string' name='[Breakdown (copy)_1132936785213071400]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Sub-Detail (copy)_1132936785167228938]&#13;&#10;WHEN &apos;Brand Name&apos; THEN [Brand Name (group)]&#13;&#10;WHEN &apos;Chain Name&apos; THEN [chain_name]&#13;&#10;WHEN &apos;Channel&apos; THEN [channel]&#13;&#10;WHEN &apos;City Name&apos; THEN [city_name] + &quot; (&quot; + [country_code] + &quot;)&quot;&#13;&#10;WHEN &apos;Country Code&apos; THEN [country_code]&#13;&#10;WHEN &apos;Global Entity Id&apos; THEN [global_entity_id]&#13;&#10;WHEN &apos;Has DPS Incentive&apos; THEN STR([has_dps_incentive])&#13;&#10;WHEN &apos;Is Preorder&apos; THEN STR([is_preorder])&#13;&#10;WHEN &apos;Is Subscriber&apos; THEN STR([Calculation_2890748014811713536])&#13;&#10;WHEN &apos;Market Archetype&apos; THEN [market_archetype]&#13;&#10;WHEN &apos;Segment&apos; THEN [segment]&#13;&#10;WHEN &apos;Sub-Segment&apos; THEN [Global Entity Id (group)]&#13;&#10;WHEN &apos;Sub Entity&apos; THEN [sub_entity]&#13;&#10;WHEN &apos;Vendor Name&apos; THEN [vendor_name]&#13;&#10;WHEN &apos;Vertical Parent&apos; THEN [vertical_parent]&#13;&#10;WHEN &apos;Vertical Type&apos; THEN [vertical_type]&#13;&#10;WHEN &apos;Holdout&apos; THEN&#13;&#10;    CASE [is_customer_holdout]&#13;&#10;    WHEN TRUE THEN &apos;Holdout&apos;&#13;&#10;    WHEN FALSE THEN &apos;Usual&apos;&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Occasion - Time of Day&apos; THEN [occasion_time_of_day]&#13;&#10;WHEN &apos;Occasion - Day of Week&apos; THEN [occasion_day_of_week]&#13;&#10;WHEN &apos;Online Payment&apos; THEN&#13;&#10;    CASE [is_paid_online]&#13;&#10;    WHEN TRUE THEN &apos;Online&apos;&#13;&#10;    WHEN FALSE THEN &apos;Offline&apos;&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Key Account Category&apos; THEN [key_account_category]&#13;&#10;WHEN &apos;Meal for One&apos; THEN&#13;&#10;    CASE [is_meal_for_one]&#13;&#10;    WHEN TRUE THEN &apos;MFO&apos;&#13;&#10;    WHEN FALSE THEN &apos;Normal&apos;&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Vendor Class&apos; THEN [vendor_class]&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
      </column>
      <column caption='Delivery Fee Net MoM %' datatype='real' default-format='p0.0%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN([Delivery Fee Net (copy)_1132936785174052885]) - LOOKUP(ZN([Delivery Fee Net (copy)_1132936785174052885]), -1)) / ABS(LOOKUP(ZN([Delivery Fee Net (copy)_1132936785174052885]), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Months Elapsed' datatype='boolean' name='[Calculation_1132936785160491009]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,[Parameters].[Parameter 5], [Calculation_1139973722200334376]) = 0' />
      </column>
      <column caption='Delivery Fee Net YoY%' datatype='real' default-format='p0.0%' name='[Calculation_1132936785161998342]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN([Delivery Fee Net (copy)_1132936785174052885]) - LOOKUP(ZN([Delivery Fee Net (copy)_1132936785174052885]), -12)) / ABS(LOOKUP(ZN([Delivery Fee Net (copy)_1132936785174052885]), -12))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Orders (M)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1132936785171419150]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([__tableau_internal_object_id__].[pricing_framework_31443A764E8F4C8ABB81B0659FA41FC5]) / 1000000 / [Calculation_1132936785236541487]' />
      </column>
      <column caption='Default month' datatype='date' datatype-customized='true' name='[Calculation_1132936785207181350]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ MAX(DATE(DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, [order_placed_at])))) }' />
      </column>
      <column caption='Scaling Adjustment' datatype='real' name='[Calculation_1132936785236541487]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 6] THEN &#13;&#10;DATEPART(&apos;day&apos;, MAX([order_placed_at])) &#13;&#10;//COUNTD([Order Placed At])&#13;&#10;/ 30 ELSE 1 END' />
      </column>
      <column caption='Distance Buckets (km)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1139973721946095621]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(&#13;&#10;    IF [delivery_distance] &gt; [Parameters].[Basket Bucket Cap (copy)_166351713726308367] THEN [Parameters].[Basket Bucket Cap (copy)_166351713726308367]&#13;&#10;    //ELSEIF [Delivery Distance] &gt; 9 THEN ROUND([Delivery Distance] / 1) * 1&#13;&#10;    //ELSEIF [Delivery Distance] &gt; 6 THEN ROUND([Delivery Distance] / 0.75) * 0.75&#13;&#10;    ELSE ROUND([delivery_distance] / [Parameters].[Basket Bucket Size (copy)_166351713726308366]) * [Parameters].[Basket Bucket Size (copy)_166351713726308366]&#13;&#10;    END&#13;&#10;,2)' />
      </column>
      <column caption='Total Fees DPS' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1139973721946988551]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([total_fees_dps_eur])/[Aggregation (copy)_1846475850361638916],2)' />
      </column>
      <column caption='Customer Fees Paid' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1139973721947025416]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([customer_fees_paid_eur])/[Calculation_1139973721956712471],2)' />
      </column>
      <column caption='Total Fees Paid Net' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1139973721947041801]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([total_fees_paid_net_eur])/[Calculation_1139973721956712471],2)' />
      </column>
      <column caption='Analytical Profit' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1139973721947475979]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([analytical_profit])/[Calculation_1139973721956712471],2)' />
      </column>
      <column caption='Is Profitable' datatype='boolean' name='[Calculation_1139973721947762704]' role='measure' type='nominal'>
        <calculation class='tableau' formula='SUM([analytical_profit])/COUNT([__tableau_internal_object_id__].[pricing_framework_31443A764E8F4C8ABB81B0659FA41FC5])&gt;=0' />
      </column>
      <column caption='Detail Ungrouped' datatype='string' name='[Calculation_1139973721954193430]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Vertical Type Parameter]&#13;&#10;WHEN &apos;Brand Name&apos; THEN [Brand Name (group)]&#13;&#10;WHEN &apos;Chain Name&apos; THEN [chain_name]&#13;&#10;WHEN &apos;Channel&apos; THEN [channel]&#13;&#10;WHEN &apos;City Name&apos; THEN [city_name] + &quot; (&quot; + [country_code] + &quot;)&quot;&#13;&#10;WHEN &apos;Country Code&apos; THEN [country_code]&#13;&#10;WHEN &apos;Global Entity Id&apos; THEN [global_entity_id]&#13;&#10;WHEN &apos;Has DPS Incentive&apos; THEN STR([has_dps_incentive])&#13;&#10;WHEN &apos;Is Preorder&apos; THEN STR([is_preorder])&#13;&#10;WHEN &apos;Is Subscriber&apos; THEN STR([Calculation_2890748014811713536])&#13;&#10;WHEN &apos;Market Archetype&apos; THEN [market_archetype]&#13;&#10;WHEN &apos;Segment&apos; THEN [segment]&#13;&#10;WHEN &apos;Sub-Segment&apos; THEN [Global Entity Id (group)]&#13;&#10;WHEN &apos;Sub Entity&apos; THEN [sub_entity]&#13;&#10;WHEN &apos;Vendor Name&apos; THEN [vendor_name]&#13;&#10;WHEN &apos;Vertical Parent&apos; THEN [vertical_parent]&#13;&#10;WHEN &apos;Vertical Type&apos; THEN [vertical_type]&#13;&#10;WHEN &apos;Holdout&apos; THEN&#13;&#10;    CASE [is_customer_holdout]&#13;&#10;    WHEN TRUE THEN &apos;Holdout&apos;&#13;&#10;    WHEN FALSE THEN &apos;Usual&apos;&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Occasion - Time of Day&apos; THEN [occasion_time_of_day]&#13;&#10;WHEN &apos;Occasion - Day of Week&apos; THEN [occasion_day_of_week]&#13;&#10;WHEN &apos;Online Payment&apos; THEN&#13;&#10;    CASE [is_paid_online]&#13;&#10;    WHEN TRUE THEN &apos;Online&apos;&#13;&#10;    WHEN FALSE THEN &apos;Offline&apos;&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Key Account Category&apos; THEN [key_account_category]&#13;&#10;WHEN &apos;Meal for One&apos; THEN&#13;&#10;    CASE [is_meal_for_one]&#13;&#10;    WHEN TRUE THEN &apos;MFO&apos;&#13;&#10;    WHEN FALSE THEN &apos;Normal&apos;&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Vendor Class&apos; THEN [vendor_class]&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
      </column>
      <column caption='Aggregation' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1139973721956712471]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Total&apos; THEN 1&#13;&#10;WHEN &apos;Total (M)&apos; THEN 1000000&#13;&#10;WHEN &apos;Total (k)&apos; THEN 1000&#13;&#10;WHEN &apos;Per Order&apos; THEN COUNT([__tableau_internal_object_id__].[pricing_framework_31443A764E8F4C8ABB81B0659FA41FC5])&#13;&#10;WHEN &apos;Per Customer Account&apos; THEN COUNTD([customer_account_id])&#13;&#10;WHEN &apos;Per Analyt. Customer&apos; THEN COUNTD([analytical_customer_id])&#13;&#10;WHEN &apos;Per Day&apos; THEN COUNTD([order_placed_at])&#13;&#10;/**&#13;&#10;WHEN &apos;Per Day&apos; THEN &#13;&#10;&#9;MAX(IF DATETRUNC(&apos;month&apos;,[Order Placed At]) &lt; DATETRUNC(&apos;month&apos;, TODAY())&#13;&#10;    &#9;THEN DATEPART(&apos;day&apos;,(DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,1,[Order Placed At])) - 1))&#13;&#10;&#9;&#9;ELSE DATEPART(&apos;day&apos;,[Order Placed At])&#13;&#10;&#9;END)&#13;&#10;**/&#13;&#10;WHEN &apos;% GMV&apos; THEN SUM([gmv_eur]) / 100&#13;&#10;WHEN &apos;% Basket Value&apos; THEN SUM([basket_value_paid_eur]) / 100&#13;&#10;WHEN &apos;% Total Fees&apos; THEN SUM([total_fees_paid_eur]) / 100&#13;&#10;WHEN &apos;% Total Fees Net&apos; THEN SUM([total_fees_paid_net_eur]) / 100&#13;&#10;//WHEN &apos;% of Orders&apos; THEN WINDOW_SUM(COUNT([pricing_framework])) / 100&#13;&#10;END' />
      </column>
      <column caption='Customer Fees Other Funded' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1139973722179629090]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([customer_fees_other_funded])/[Calculation_1139973721956712471],2)' />
      </column>
      <column caption='Customer Fees Third Party Funded' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1139973722179649571]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([customer_fees_third_party_funded])/[Calculation_1139973721956712471],2)' />
      </column>
      <column caption='Customer Fees DH Funded' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1139973722179665956]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([customer_fees_dh_funded])/[Calculation_1139973721956712471],2)' />
      </column>
      <column caption='Customer Fees Nominal' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1139973722183237669]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([customer_fees_paid_eur])/[Calculation_1139973721956712471],2) + [Calculation_2515823408474148870]' />
      </column>
      <column aggregation='Sum' caption='Dimension (1)' datatype='real' name='[Calculation_1139973722196611111]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &apos;Basket Bucket&apos; THEN [Distance Buckets (Km) (copy)_1139973722194489382]&#13;&#10;WHEN &apos;Distance Bucket&apos; THEN [Calculation_1139973721946095621]&#13;&#10;WHEN &apos;Month&apos; THEN DATEDIFF(&apos;month&apos;,TODAY(), [order_placed_at])&#13;&#10;WHEN &apos;Week&apos; THEN DATEDIFF(&apos;week&apos;,TODAY(), [order_placed_at])&#13;&#10;WHEN &apos;Day&apos; THEN DATEDIFF(&apos;day&apos;,TODAY(), [order_placed_at])&#13;&#10;WHEN &apos;Weekday&apos; THEN [Calculation_3085810177798340641] // makes Monday the first day&#13;&#10;WHEN &apos;Time of Day&apos; THEN [Calculation_3085810177788899355]&#13;&#10;WHEN &apos;Day of Week&apos; THEN [Calculation_3085810177789280284]&#13;&#10;WHEN &apos;Unhealthy Score&apos; THEN ROUND([customer_unhealthy_score]/0.1)*0.1&#13;&#10;WHEN &apos;Delivery Fee Score&apos; THEN ROUND([customer_delivery_fee_score]/0.1)*0.1&#13;&#10;WHEN &apos;Reorder Probability within 28d&apos; THEN ROUND([customer_reorder_probability_all_verts_general_28_days]/10)*10&#13;&#10;END' />
      </column>
      <column caption='Month' datatype='date' datatype-customized='true' default-format='*mmm&apos;yy' name='[Calculation_1139973722200334376]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [order_placed_at]))' />
      </column>
      <column caption='Sub-Detail' datatype='string' name='[Calculation_139330180155559956]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Sub-Detail Set] THEN [Detail (copy)_8643885495196205074] ELSE &apos;[Others]&apos; END' />
      </column>
      <column caption='Legend Current' datatype='string' name='[Calculation_166351713654349825]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Current&apos;' />
      </column>
      <column caption='Legend Reference' datatype='string' name='[Calculation_166351713655070726]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Reference&quot;' />
      </column>
      <column caption='Metric 2' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1846475850324656128]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Metric 1 (copy)_1846475850326323201]&#13;&#10;//WHEN &apos;Aggregation&apos; THEN [Aggregation]&#13;&#10;WHEN &apos;Analytical Profit&apos; THEN [Calculation_1139973721947475979]&#13;&#10;WHEN &apos;Bad Weather Fee Net&apos; THEN [Delivery Fee Net (copy)_1139973722153857056]&#13;&#10;WHEN &apos;Bad Weather Fee Paid&apos; THEN [Bad Weather Fee Net (copy)_5755600392040185896]&#13;&#10;//WHEN &apos;Basket Buckets&apos; THEN [Basket Buckets]&#13;&#10;WHEN &apos;Basket Value Nominal&apos; THEN [Bad Weather Fee Net (copy)_5755600392040370217]&#13;&#10;WHEN &apos;Basket Value Paid&apos; THEN [Basket Value Nominal (copy)_5755600392040484906]&#13;&#10;WHEN &apos;Commission Fee Net&apos; THEN [Basket Value Paid (copy)_5755600392040583211]&#13;&#10;WHEN &apos;Count of Orders&apos; THEN SUM(1)&#13;&#10;WHEN &apos;Customer Fees DH Funded&apos; THEN [Calculation_1139973722179665956]&#13;&#10;WHEN &apos;Customer Fees Nominal&apos; THEN [Calculation_1139973722183237669]&#13;&#10;WHEN &apos;Customer Fees Other Funded&apos; THEN [Calculation_1139973722179629090]&#13;&#10;WHEN &apos;Customer Fees Paid&apos; THEN [Calculation_1139973721947025416]&#13;&#10;WHEN &apos;Customer Fees Third Party Funded&apos; THEN [Calculation_1139973722179649571]&#13;&#10;WHEN &apos;Customer Service Fee&apos; THEN [Service Fee Net (copy)_5755600392050638902]&#13;&#10;WHEN &apos;Customer Service Fee Net&apos; THEN [Customer Fees Paid (copy)_1139973722151665692]&#13;&#10;WHEN &apos;DPS Bad Weather Fee&apos; THEN [DPS Delivery Fee (copy)_6532541696563433535]&#13;&#10;WHEN &apos;DPS Delivery Fee&apos; THEN [DPS Delivery Fee (inc. Std) (copy)_5648006582348574733]&#13;&#10;WHEN &apos;DPS Delivery Fee (inc. Std)&apos; THEN [GMV (copy)_5755600392050266164]&#13;&#10;WHEN &apos;DPS Incentive&apos; THEN [Calculation_2515823408474148870]&#13;&#10;WHEN &apos;DPS Priority Fee&apos; THEN [DPS Service Fee (copy)_6532541696563617857]&#13;&#10;WHEN &apos;DPS Priority Fee (opted-in)&apos; THEN [DPS Priority Fee (copy)_5755600392125005885]&#13;&#10;WHEN &apos;DPS Service Fee&apos; THEN [DPS Bad Weather Fee (copy)_6532541696563535936]&#13;&#10;WHEN &apos;DPS Small Basket Fee&apos; THEN [DPS Priority Fee (copy)_6532541696563712066]&#13;&#10;WHEN &apos;DPS Standard Fee&apos; THEN [DPS Delivery Fee (copy)_5755600392050372661]&#13;&#10;WHEN &apos;Delivery Costs&apos; THEN [Customer Service Fee (copy)_5755600392049983538]&#13;&#10;//WHEN &apos;Delivery Distance (km)&apos; THEN [Delivery Distance (km)]&#13;&#10;WHEN &apos;Delivery Fee Net&apos; THEN [Service Fee Net (copy)_1139973722152026141]&#13;&#10;WHEN &apos;Delivery Fee Net (Core)&apos; THEN [Delivery Fee Net (copy)_5755600392050769975]&#13;&#10;WHEN &apos;Delivery Fee Nominal&apos; THEN [Delivery Fee Net (copy)_5755600392051003448]&#13;&#10;WHEN &apos;Delivery Fee Paid&apos; THEN [Delivery Fee Gross (copy)_5755600392051531834]&#13;&#10;//WHEN &apos;Dimension&apos; THEN [Dimension]&#13;&#10;//WHEN &apos;Distance Buckets (km)&apos; THEN [Distance Buckets (km)]&#13;&#10;WHEN &apos;GMV&apos; THEN [Delivery Costs (copy)_5755600392050180147]&#13;&#10;WHEN &apos;Other DH Reductions&apos; THEN [Customer Fees DPS (copy)_1139973722258194473]&#13;&#10;WHEN &apos;Other Reductions&apos; THEN [Other DH Reductions (copy)_2515823408475398152]&#13;&#10;WHEN &apos;Priority Fee Net&apos; THEN [Service Fee Net (copy)_1139973722152595486]&#13;&#10;WHEN &apos;Priority Fee Paid&apos; THEN [Delivery Fee Net (copy)_5755600392041246766]&#13;&#10;//WHEN &apos;Reference&apos; THEN [Reference]&#13;&#10;//WHEN &apos;Reference (%)&apos; THEN [Reference (%)]&#13;&#10;WHEN &apos;Service Fee Net&apos; THEN [Customer Fees Paid (copy)_1139973722151665692]&#13;&#10;WHEN &apos;Service Fee Paid&apos; THEN [Service Fee Net (copy)_5755600392050638902]&#13;&#10;WHEN &apos;Small Basket Fee Net&apos; THEN [Service Fee Net (copy)_1139973722153009183]&#13;&#10;WHEN &apos;Small Basket Fee Paid&apos; THEN [Small Basket Fee Net (copy)_5755600392052346940]&#13;&#10;WHEN &apos;Subscription Vendor Subsidy Net&apos; THEN [Small Basket Net (copy)_1139973722288521258]&#13;&#10;//WHEN &apos;Taxes&apos; THEN [Taxes]&#13;&#10;WHEN &apos;Total Fees DPS&apos; THEN [Calculation_1139973721946988551]&#13;&#10;//WHEN &apos;Total Fees DPS (exc. Std)&apos; THEN [Total Fees DPS (exc. Std)]&#13;&#10;WHEN &apos;Total Fees Paid&apos; THEN [Total Fees Paid Net (copy)_5755600392043515951]&#13;&#10;WHEN &apos;Total Fees Paid Net&apos; THEN [Calculation_1139973721947041801]&#13;&#10;//WHEN &apos;Vendor Age (Days)&apos; THEN [Vendor Age (Days)]&#13;&#10;WHEN &apos;Vendor Fees Paid&apos; THEN [Vendor Funded Delivery Fee Subsidy Net (copy)_5755600392051896379]&#13;&#10;WHEN &apos;Vendor Funded Delivery Fee Subsidy Net&apos; THEN [Subscription Vendor Subsidy Net (copy)_1139973722288619563]&#13;&#10;END' />
      </column>
      <column caption='Promo Range %' datatype='real' default-format='p0.0%' name='[Calculation_2515260398881148928]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([promo_price_range_eur])/SUM([avg_basket_eur])' />
      </column>
      <column caption='mean_acceptable_price_range_eur' datatype='real' name='[Calculation_2515260399165648906]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([min_acceptable_price_range_eur]+[max_acceptable_price_range_eur])/2' />
      </column>
      <column caption='DH Incentives' datatype='real' name='[Calculation_2515260399196712986]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND([DPS Incentives (copy)_2515260399195922457] / [Calculation_1139973721956712471], 2)' />
      </column>
      <column caption='VW Range' datatype='string' name='[Calculation_2515823408463073283]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [customer_fees_paid_eur] = 0 THEN &apos;Free&apos;&#13;&#10;ELSEIF [customer_fees_paid_eur] &lt;= [promo_price_range_eur] THEN &apos;Very Cheap&apos;&#13;&#10;ELSEIF [customer_fees_paid_eur] &lt;= [min_acceptable_price_range_eur] THEN &apos;Cheap&apos;&#13;&#10;ELSEIF [customer_fees_paid_eur] &lt;= [Calculation_2515260399165648906] THEN &apos;Middle point&apos;&#13;&#10;ELSEIF [customer_fees_paid_eur] &lt;= [max_acceptable_price_range_eur] THEN &apos;Expensive&apos;&#13;&#10;ELSEIF [customer_fees_paid_eur] &lt;= [long_price_range_eur] THEN &apos;Too Expensive&apos;&#13;&#10;ELSEIF [customer_fees_paid_eur] &gt; [long_price_range_eur] THEN &apos;Not Acceptable&apos;&#13;&#10;ELSE &apos;Unknown&apos;&#13;&#10;END' />
      </column>
      <column caption='Taxes' datatype='integer' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2515823408472817669]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(0)' />
      </column>
      <column caption='DPS Incentives' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2515823408474148870]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF [has_dps_incentive] THEN [dps_standard_fee_eur] ELSE [dps_delivery_fee_eur] END) &#10;- SUM([dps_delivery_fee_eur])) &#10;/ [Aggregation (copy)_1846475850361638916]' />
      </column>
      <column caption='Order Type' datatype='string' name='[Calculation_2635168734501298176]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF NULL THEN NULL&#13;&#10;ELSEIF [Calculation_2890748014811713536] AND [total_fees_paid_eur] = 0 THEN &apos;No fees Sub&apos;&#13;&#10;ELSEIF [Calculation_2890748014811713536] AND [total_fees_paid_eur] &gt; 0 THEN &apos;Paying Sub&apos;&#13;&#10;ELSEIF [channel] = &apos;Pick-up&apos; AND [total_fees_paid_eur] = 0 THEN &apos;No fees PU&apos;&#13;&#10;ELSEIF [channel] = &apos;Pick-up&apos; AND [total_fees_paid_eur] &gt; 0 THEN &apos;Paying PU&apos;&#13;&#10;ELSEIF [channel] = &apos;Vendor Delivery&apos; AND [delivery_fee_eur] = 0 THEN &apos;Free DF VD&apos;&#13;&#10;ELSEIF [channel] = &apos;Vendor Delivery&apos; THEN &apos;Paid DF VD&apos;&#13;&#10;ELSEIF [has_dps_incentive] THEN &apos;Incentivized&apos;&#13;&#10;ELSEIF [delivery_fee_eur] = 0 THEN &apos;Free DF OD&apos;&#13;&#10;ELSE &apos;Regular&apos;&#13;&#10;END' />
      </column>
      <column caption='Subscription Status' datatype='boolean' name='[Calculation_2890748014811713536]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([is_subscriber] = &apos;subscriber&apos;, FALSE)' />
        <aliases>
          <alias key='false' value='Non-Subscriber' />
          <alias key='true' value='Subscriber' />
        </aliases>
      </column>
      <column caption='Profitable Orders' datatype='integer' name='[Calculation_3085810177769197570]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_successful] AND [analytical_profit] &gt;= 0 THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Successful Orders' datatype='integer' name='[Calculation_3085810177769836549]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_successful] THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Is Basket Bucket Selected (2/3)' datatype='boolean' name='[Calculation_3085810177785458713]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Dimension (copy)_3085810177783541781] = &quot;Basket Bucket&quot; OR [Parameters].[Dimension (copy) (copy)_3085810177783549974] = &quot;Basket Bucket&quot;' />
      </column>
      <column aggregation='Sum' caption='Time of Day' datatype='integer' name='[Calculation_3085810177788899355]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [occasion_time_of_day]&#13;&#10;    WHEN &apos;breakfast&apos; THEN 1&#13;&#10;    WHEN &apos;lunch&apos; THEN 2&#13;&#10;    WHEN &apos;afternoon&apos; THEN 3&#13;&#10;    WHEN &apos;dinner&apos; THEN 4&#13;&#10;    WHEN &apos;late_night&apos; THEN 5&#13;&#10;END' />
      </column>
      <column aggregation='Sum' caption='Day of Week' datatype='integer' name='[Calculation_3085810177789280284]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [occasion_day_of_week]&#13;&#10;WHEN &apos;weekday&apos; THEN 1&#13;&#10;WHEN &apos;weekend&apos; THEN 2&#13;&#10;END' />
      </column>
      <column aggregation='Sum' caption='Weekday (#)' datatype='integer' name='[Calculation_3085810177798340641]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEPART(&apos;weekday&apos;, [order_placed_at] - 1)' />
      </column>
      <column caption='Is Financial' datatype='boolean' name='[Calculation_3085810177973600292]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 7] = &apos;Financial&apos;' />
      </column>
      <column caption='Is Operational' datatype='boolean' name='[Calculation_3085810177973698597]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 7]=&quot;Operational&quot;' />
      </column>
      <column caption='Months on Book' datatype='integer' name='[Calculation_3085810178731069492]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='//FLOOR(&#13;&#10;DATEDIFF(&apos;month&apos;,&#13;&#10;    DATETRUNC(&apos;month&apos;, [first_associated_order_placed_at_utc]),&#13;&#10;    DATETRUNC(&apos;month&apos;, [order_placed_at])&#13;&#10;)&#13;&#10;///30)' />
      </column>
      <column caption='[Months on Book] &gt;= 0' datatype='boolean' name='[Calculation_3085810178955874367]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_3085810178731069492] &gt;= 0 AND [Calculation_3085810178731069492] &lt; 16' />
      </column>
      <column caption='[Months on Book (copy)]&lt;16' datatype='boolean' name='[Calculation_3085810178957115458]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Months on Book (copy)_3085810178956902465]&lt;16' />
      </column>
      <column caption='Reference Date' datatype='datetime' name='[Calculation_5564126972833857571]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [Calculation_5564126972853960759] AND DATEADD(&apos;week&apos;, -[Parameters].[Weeks Displayed (copy)_5564126972860436536], [order_placed_at]) &lt;= { FIXED : MAX([order_placed_at])}&#10;THEN DATETRUNC(&apos;day&apos;, DATEADD(&apos;week&apos;, -[Parameters].[Weeks Displayed (copy)_5564126972860436536], [order_placed_at]))&#10;END' />
      </column>
      <column caption='Current Date' datatype='datetime' name='[Calculation_5564126972838146096]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [order_placed_at] &gt;= DATEADD(&apos;week&apos;,-[Parameters].[Channel Parameter], { FIXED : MAX([order_placed_at])}) &#10;THEN DATETRUNC(&apos;day&apos;, [order_placed_at]) &#10;END' />
      </column>
      <column caption='Weekday' datatype='string' name='[Calculation_5564126972843753524]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;,[order_placed_at])' />
      </column>
      <column caption='Weeks Displayed' datatype='boolean' name='[Calculation_5564126972853960759]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEADD(&apos;week&apos;, -[Parameters].[Weeks Displayed (copy)_5564126972860436536], [order_placed_at]) &#10;&gt;= DATEADD(&apos;week&apos;,-[Parameters].[Channel Parameter], { FIXED : MAX([order_placed_at])})' />
      </column>
      <column caption='Other DH Reductions' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Customer Fees DPS (copy)_1139973722258194473]' role='measure' type='quantitative'>
