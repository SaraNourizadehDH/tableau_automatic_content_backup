              <calculation class='tableau' formula='ROUND(SUM([dps_surge_fee_eur])/[Aggregation (copy)_1846475850361638916],2)' />
            </column>
            <column caption='DPS Priority Fee' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[DPS Service Fee (copy)_6532541696563617857]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([dps_priority_fee_eur])/[Aggregation (copy)_1846475850361638916],2)' />
            </column>
            <column caption='DPS Travel Time Fee' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[DPS Surge Fee (copy)_3085810177997971507]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([dps_travel_time_fee_eur])/[Aggregation (copy)_1846475850361638916],2)' />
