            <column caption='Vendor Subsidies(% of BV)' datatype='real' default-format='p0.0%' name='[Customer Fees Paid (% of BV) (copy)_2515260399178633231]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Customer Fees Paid (per order) (copy)_2515260399178711056]/[Basket Value Paid (copy)_1132936785174761494]' />
