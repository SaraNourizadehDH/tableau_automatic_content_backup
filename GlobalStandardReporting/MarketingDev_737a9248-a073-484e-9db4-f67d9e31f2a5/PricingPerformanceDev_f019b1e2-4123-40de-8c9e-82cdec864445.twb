        <cols>([federated.16xq89b15ombu418amgk303gpxk5].[none:Calculation_1139973722200334376:ok] / ([federated.16xq89b15ombu418amgk303gpxk5].[none:Calculation_1132936785160491009:nk] / [federated.16xq89b15ombu418amgk303gpxk5].[:Measure Names]))</cols>
