            <column caption='Priority Fee Paid' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Delivery Fee Net (copy)_5755600392041246766]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([delivery_priority_fee_eur])/[Calculation_1139973721956712471],2)' />
