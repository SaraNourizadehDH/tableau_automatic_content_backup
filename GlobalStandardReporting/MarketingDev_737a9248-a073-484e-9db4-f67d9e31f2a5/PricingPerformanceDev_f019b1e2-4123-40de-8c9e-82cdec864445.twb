    <worksheet name='Orders'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='pricing_framework (growth_pricing)' name='federated.16xq89b15ombu418amgk303gpxk5' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Reference' datatype='string' name='[Aggregation (copy)_166351713677688839]' param-domain-type='list' role='measure' type='nominal' value='&quot;Orders&quot;'>
              <calculation class='tableau' formula='&quot;Orders&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.16xq89b15ombu418amgk303gpxk5].[Calculation_1132936785207181350]' caption='Month Analyzed' datatype='date' default-format='*mmm-yyyy' name='[Parameter 5]' param-domain-type='list' role='measure' type='quantitative' value='#2025-04-01#'>
              <calculation class='tableau' formula='#2025-04-01#' />
            </column>
            <column alias='Days recorded' caption='Scale' datatype='boolean' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='false'>
              <calculation class='tableau' formula='false' />
              <aliases>
                <alias key='false' value='Days recorded' />
                <alias key='true' value='30-day equivalent' />
              </aliases>
            </column>
            <column caption='Breakdown' datatype='string' name='[Sub-Detail (copy)_1132936785167228938]' param-domain-type='list' role='measure' type='nominal' value='&quot;Sub-Segment&quot;'>
              <calculation class='tableau' formula='&quot;Sub-Segment&quot;' />
            </column>
            <column caption='Detail' datatype='string' name='[Vertical Type Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Brand Name&quot;'>
              <calculation class='tableau' formula='&quot;Brand Name&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.16xq89b15ombu418amgk303gpxk5'>
            <column datatype='string' name='[Brand Name (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[brand_name]' new-bin='true'>
                <bin default-name='false' value='&quot;DH Greece&quot;'>
                  <value>&quot;Foody&quot;</value>
                  <value>&quot;eFood&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='Breakdown ungrouped' datatype='string' name='[Breakdown (copy)_1132936785213071400]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Sub-Detail (copy)_1132936785167228938]&#13;&#10;WHEN &apos;Brand Name&apos; THEN [Brand Name (group)]&#13;&#10;WHEN &apos;Chain Name&apos; THEN [chain_name]&#13;&#10;WHEN &apos;Channel&apos; THEN [channel]&#13;&#10;WHEN &apos;City Name&apos; THEN [city_name] + &quot; (&quot; + [country_code] + &quot;)&quot;&#13;&#10;WHEN &apos;Country Code&apos; THEN [country_code]&#13;&#10;WHEN &apos;Global Entity Id&apos; THEN [global_entity_id]&#13;&#10;WHEN &apos;Has DPS Incentive&apos; THEN STR([has_dps_incentive])&#13;&#10;WHEN &apos;Is Preorder&apos; THEN STR([is_preorder])&#13;&#10;WHEN &apos;Is Subscriber&apos; THEN STR([Calculation_2890748014811713536])&#13;&#10;WHEN &apos;Market Archetype&apos; THEN [market_archetype]&#13;&#10;WHEN &apos;Segment&apos; THEN [segment]&#13;&#10;WHEN &apos;Sub-Segment&apos; THEN [Global Entity Id (group)]&#13;&#10;WHEN &apos;Sub Entity&apos; THEN [sub_entity]&#13;&#10;WHEN &apos;Vendor Name&apos; THEN [vendor_name]&#13;&#10;WHEN &apos;Vertical Parent&apos; THEN [vertical_parent]&#13;&#10;WHEN &apos;Vertical Type&apos; THEN [vertical_type]&#13;&#10;WHEN &apos;Holdout&apos; THEN&#13;&#10;    CASE [is_customer_holdout]&#13;&#10;    WHEN TRUE THEN &apos;Holdout&apos;&#13;&#10;    WHEN FALSE THEN &apos;Usual&apos;&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Occasion - Time of Day&apos; THEN [occasion_time_of_day]&#13;&#10;WHEN &apos;Occasion - Day of Week&apos; THEN [occasion_day_of_week]&#13;&#10;WHEN &apos;Online Payment&apos; THEN&#13;&#10;    CASE [is_paid_online]&#13;&#10;    WHEN TRUE THEN &apos;Online&apos;&#13;&#10;    WHEN FALSE THEN &apos;Offline&apos;&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Key Account Category&apos; THEN [key_account_category]&#13;&#10;WHEN &apos;Meal for One&apos; THEN&#13;&#10;    CASE [is_meal_for_one]&#13;&#10;    WHEN TRUE THEN &apos;MFO&apos;&#13;&#10;    WHEN FALSE THEN &apos;Normal&apos;&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Vendor Class&apos; THEN [vendor_class]&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
            </column>
            <column caption='Delivery Fee Net MoM %' datatype='real' default-format='p0.0%' name='[Calculation1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN([Delivery Fee Net (copy)_1132936785174052885]) - LOOKUP(ZN([Delivery Fee Net (copy)_1132936785174052885]), -1)) / ABS(LOOKUP(ZN([Delivery Fee Net (copy)_1132936785174052885]), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Months Elapsed' datatype='boolean' name='[Calculation_1132936785160491009]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,[Parameters].[Parameter 5], [Calculation_1139973722200334376]) = 0' />
            </column>
            <column caption='Delivery Fee Net YoY%' datatype='real' default-format='p0.0%' name='[Calculation_1132936785161998342]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN([Delivery Fee Net (copy)_1132936785174052885]) - LOOKUP(ZN([Delivery Fee Net (copy)_1132936785174052885]), -12)) / ABS(LOOKUP(ZN([Delivery Fee Net (copy)_1132936785174052885]), -12))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Orders (M)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1132936785171419150]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([__tableau_internal_object_id__].[pricing_framework_31443A764E8F4C8ABB81B0659FA41FC5]) / 1000000 / [Calculation_1132936785236541487]' />
            </column>
            <column caption='Default month' datatype='date' datatype-customized='true' name='[Calculation_1132936785207181350]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ MAX(DATE(DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, [order_placed_at])))) }' />
            </column>
            <column caption='Scaling Adjustment' datatype='real' name='[Calculation_1132936785236541487]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 6] THEN &#13;&#10;DATEPART(&apos;day&apos;, MAX([order_placed_at])) &#13;&#10;//COUNTD([Order Placed At])&#13;&#10;/ 30 ELSE 1 END' />
            </column>
            <column caption='Detail Ungrouped' datatype='string' name='[Calculation_1139973721954193430]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Vertical Type Parameter]&#13;&#10;WHEN &apos;Brand Name&apos; THEN [Brand Name (group)]&#13;&#10;WHEN &apos;Chain Name&apos; THEN [chain_name]&#13;&#10;WHEN &apos;Channel&apos; THEN [channel]&#13;&#10;WHEN &apos;City Name&apos; THEN [city_name] + &quot; (&quot; + [country_code] + &quot;)&quot;&#13;&#10;WHEN &apos;Country Code&apos; THEN [country_code]&#13;&#10;WHEN &apos;Global Entity Id&apos; THEN [global_entity_id]&#13;&#10;WHEN &apos;Has DPS Incentive&apos; THEN STR([has_dps_incentive])&#13;&#10;WHEN &apos;Is Preorder&apos; THEN STR([is_preorder])&#13;&#10;WHEN &apos;Is Subscriber&apos; THEN STR([Calculation_2890748014811713536])&#13;&#10;WHEN &apos;Market Archetype&apos; THEN [market_archetype]&#13;&#10;WHEN &apos;Segment&apos; THEN [segment]&#13;&#10;WHEN &apos;Sub-Segment&apos; THEN [Global Entity Id (group)]&#13;&#10;WHEN &apos;Sub Entity&apos; THEN [sub_entity]&#13;&#10;WHEN &apos;Vendor Name&apos; THEN [vendor_name]&#13;&#10;WHEN &apos;Vertical Parent&apos; THEN [vertical_parent]&#13;&#10;WHEN &apos;Vertical Type&apos; THEN [vertical_type]&#13;&#10;WHEN &apos;Holdout&apos; THEN&#13;&#10;    CASE [is_customer_holdout]&#13;&#10;    WHEN TRUE THEN &apos;Holdout&apos;&#13;&#10;    WHEN FALSE THEN &apos;Usual&apos;&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Occasion - Time of Day&apos; THEN [occasion_time_of_day]&#13;&#10;WHEN &apos;Occasion - Day of Week&apos; THEN [occasion_day_of_week]&#13;&#10;WHEN &apos;Online Payment&apos; THEN&#13;&#10;    CASE [is_paid_online]&#13;&#10;    WHEN TRUE THEN &apos;Online&apos;&#13;&#10;    WHEN FALSE THEN &apos;Offline&apos;&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Key Account Category&apos; THEN [key_account_category]&#13;&#10;WHEN &apos;Meal for One&apos; THEN&#13;&#10;    CASE [is_meal_for_one]&#13;&#10;    WHEN TRUE THEN &apos;MFO&apos;&#13;&#10;    WHEN FALSE THEN &apos;Normal&apos;&#13;&#10;    ELSE NULL&#13;&#10;    END&#13;&#10;WHEN &apos;Vendor Class&apos; THEN [vendor_class]&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
