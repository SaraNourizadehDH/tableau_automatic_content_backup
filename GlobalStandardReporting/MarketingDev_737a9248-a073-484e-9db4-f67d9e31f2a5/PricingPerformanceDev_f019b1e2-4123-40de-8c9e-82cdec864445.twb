              <calculation class='tableau' formula='ROUND(SUM([delivery_fee_net_core])/[Calculation_1139973721956712471],2)' />
            </column>
            <column caption='Delivery Fee Nominal' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Delivery Fee Net (copy)_5755600392051003448]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([delivery_fee_before_discount_eur])/[Calculation_1139973721956712471],2)' />
            </column>
            <column aggregation='Sum' caption='Dimension (3)' datatype='real' name='[Dimension (copy) (copy)_3085810177783488532]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Dimension (copy) (copy)_3085810177783549974]&#13;&#10;WHEN &apos;Basket Bucket&apos; THEN [Distance Buckets (Km) (copy)_1139973722194489382]&#13;&#10;WHEN &apos;Distance Bucket&apos; THEN [Calculation_1139973721946095621]&#13;&#10;WHEN &apos;Month&apos; THEN DATEDIFF(&apos;month&apos;,TODAY(), [order_placed_at])&#13;&#10;WHEN &apos;Week&apos; THEN DATEDIFF(&apos;week&apos;,TODAY(), [order_placed_at])&#13;&#10;WHEN &apos;Day&apos; THEN DATEDIFF(&apos;day&apos;,TODAY(), [order_placed_at])&#13;&#10;WHEN &apos;Weekday&apos; THEN [Calculation_3085810177798340641] // makes Monday the first day&#13;&#10;WHEN &apos;Time of Day&apos; THEN [Calculation_3085810177788899355]&#13;&#10;WHEN &apos;Day of Week&apos; THEN [Calculation_3085810177789280284]&#13;&#10;WHEN &apos;Unhealthy Score&apos; THEN ROUND([customer_unhealthy_score]/0.1)*0.1&#13;&#10;WHEN &apos;Delivery Fee Score&apos; THEN ROUND([customer_delivery_fee_score]/0.1)*0.1&#13;&#10;WHEN &apos;Reorder Probability within 28d&apos; THEN ROUND([customer_reorder_probability_all_verts_general_28_days]/10)*10&#13;&#10;END' />
            </column>
            <column aggregation='Sum' caption='Dimension (2)' datatype='real' name='[Dimension (copy)_3085810177783472147]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Dimension (copy)_3085810177783541781]&#13;&#10;WHEN &apos;Basket Bucket&apos; THEN [Distance Buckets (Km) (copy)_1139973722194489382]&#13;&#10;WHEN &apos;Distance Bucket&apos; THEN [Calculation_1139973721946095621]&#13;&#10;WHEN &apos;Month&apos; THEN DATEDIFF(&apos;month&apos;,TODAY(), [order_placed_at])&#13;&#10;WHEN &apos;Week&apos; THEN DATEDIFF(&apos;week&apos;,TODAY(), [order_placed_at])&#13;&#10;WHEN &apos;Day&apos; THEN DATEDIFF(&apos;day&apos;,TODAY(), [order_placed_at])&#13;&#10;WHEN &apos;Weekday&apos; THEN [Calculation_3085810177798340641] // makes Monday the first day&#13;&#10;WHEN &apos;Time of Day&apos; THEN [Calculation_3085810177788899355]&#13;&#10;WHEN &apos;Day of Week&apos; THEN [Calculation_3085810177789280284]&#13;&#10;WHEN &apos;Unhealthy Score&apos; THEN ROUND([customer_unhealthy_score]/0.1)*0.1&#13;&#10;WHEN &apos;Delivery Fee Score&apos; THEN ROUND([customer_delivery_fee_score]/0.1)*0.1&#13;&#10;WHEN &apos;Reorder Probability within 28d&apos; THEN ROUND([customer_reorder_probability_all_verts_general_28_days]/10)*10&#13;&#10;END' />
            </column>
            <column caption='Basket Buckets' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Distance Buckets (Km) (copy)_1139973722194489382]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(IF [basket_value_paid_eur] &gt; [Parameters].[Parameter 3] THEN [Parameters].[Parameter 3]&#13;&#10;ELSEIF [basket_value_paid_eur] &gt; [Parameters].[Basket Bucket Cap (copy)_166351713725837325] THEN ROUND([basket_value_paid_eur] / [Parameters].[Basket Bucket Cap (copy)_166351713725837325]) * [Parameters].[Basket Bucket Cap (copy)_166351713725837325]&#13;&#10;ELSE 0&#13;&#10;END,2)' />
            </column>
            <column caption='DPS Delivery Fee (inc. Std)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[GMV (copy)_5755600392050266164]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM(IF [has_dps_incentive] THEN dps_standard_fee_eur ELSE dps_delivery_fee_eur END)/[Aggregation (copy)_1846475850361638916],2)' />
            </column>
            <column caption='Is Total' datatype='boolean' name='[Is Distance Bucket Selected (2/3) (copy)_3085810177987194924]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1] = &quot;Total&quot;&#13;&#10;OR [Parameters].[Parameter 1] = &quot;Total (M)&quot;&#13;&#10;OR [Parameters].[Parameter 1] = &quot;Total (k)&quot;&#13;&#10;OR [Parameters].[Aggregation (copy)_3085810177976442919] = &quot;Total&quot;&#13;&#10;OR [Parameters].[Aggregation (copy)_3085810177976442919] = &quot;Total (M)&quot;&#13;&#10;OR [Parameters].[Aggregation (copy)_3085810177976442919] = &quot;Total (k)&quot;' />
            </column>
            <column caption='Metric 3' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Metric 2 (copy)_3085810177778368530]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 7] = &apos;Financial&apos; THEN&#13;&#10;    CASE [Parameters].[Metric 2 (copy)_3085810177778315281]&#13;&#10;        WHEN &apos;Analytical Profit&apos; THEN [Calculation_1139973721947475979]&#13;&#10;        WHEN &apos;Bad Weather Fee Net&apos; THEN [Delivery Fee Net (copy)_1139973722153857056]&#13;&#10;        WHEN &apos;Bad Weather Fee Paid&apos; THEN [Bad Weather Fee Net (copy)_5755600392040185896]&#13;&#10;        WHEN &apos;Basket Value Nominal&apos; THEN [Bad Weather Fee Net (copy)_5755600392040370217]&#13;&#10;        WHEN &apos;Basket Value Paid&apos; THEN [Basket Value Nominal (copy)_5755600392040484906]&#13;&#10;        WHEN &apos;Commission Fee Net&apos; THEN [Basket Value Paid (copy)_5755600392040583211]&#13;&#10;        WHEN &apos;Customer Fees DH Funded&apos; THEN [Calculation_1139973722179665956]&#13;&#10;        WHEN &apos;Customer Fees Nominal&apos; THEN [Calculation_1139973722183237669]&#13;&#10;        WHEN &apos;Customer Fees Other Funded&apos; THEN [Calculation_1139973722179629090]&#13;&#10;        WHEN &apos;Customer Fees Paid&apos; THEN [Calculation_1139973721947025416]&#13;&#10;        WHEN &apos;Customer Fees Third Party Funded&apos; THEN [Calculation_1139973722179649571]&#13;&#10;        WHEN &apos;Customer Service Fee&apos; THEN [Service Fee Net (copy)_5755600392050638902]&#13;&#10;        WHEN &apos;Customer Service Fee Net&apos; THEN [Customer Fees Paid (copy)_1139973722151665692]&#13;&#10;        WHEN &apos;Count of Orders&apos; THEN COUNT([__tableau_internal_object_id__].[pricing_framework_31443A764E8F4C8ABB81B0659FA41FC5]) / [Calculation_1139973721956712471]&#13;&#10;        WHEN &apos;DPS Bad Weather Fee&apos; THEN [DPS Delivery Fee (copy)_6532541696563433535]&#13;&#10;        WHEN &apos;DPS Delivery Fee&apos; THEN [DPS Delivery Fee (inc. Std) (copy)_5648006582348574733]&#13;&#10;        WHEN &apos;DPS Delivery Fee (inc. Std)&apos; THEN [GMV (copy)_5755600392050266164]&#13;&#10;        WHEN &apos;DPS Incentive&apos; THEN [Calculation_2515823408474148870]&#13;&#10;        WHEN &apos;DPS Priority Fee&apos; THEN [DPS Service Fee (copy)_6532541696563617857]&#13;&#10;        WHEN &apos;DPS Priority Fee (opted-in)&apos; THEN [DPS Priority Fee (copy)_5755600392125005885]&#13;&#10;        WHEN &apos;DPS Service Fee&apos; THEN [DPS Bad Weather Fee (copy)_6532541696563535936]&#13;&#10;        WHEN &apos;DPS Small Basket Fee&apos; THEN [DPS Priority Fee (copy)_6532541696563712066]&#13;&#10;        WHEN &apos;DPS Standard Fee&apos; THEN [DPS Delivery Fee (copy)_5755600392050372661]&#13;&#10;        WHEN &apos;DPS Surge Fee&apos; THEN [DPS Service Fee (copy)_3085810177990914094]&#13;&#10;        WHEN &apos;DPS Travel Time Fee&apos; THEN [DPS Surge Fee (copy)_3085810177997971507]&#13;&#10;        WHEN &apos;Delivery Costs&apos; THEN [Customer Service Fee (copy)_5755600392049983538]&#13;&#10;        WHEN &apos;Delivery Fee Net&apos; THEN [Service Fee Net (copy)_1139973722152026141]&#13;&#10;        WHEN &apos;Delivery Fee Net (Core)&apos; THEN [Delivery Fee Net (copy)_5755600392050769975]&#13;&#10;        WHEN &apos;Delivery Fee Nominal&apos; THEN [Delivery Fee Net (copy)_5755600392051003448]&#13;&#10;        WHEN &apos;Delivery Fee Paid&apos; THEN [Delivery Fee Gross (copy)_5755600392051531834]&#13;&#10;        WHEN &apos;GMV&apos; THEN [Delivery Costs (copy)_5755600392050180147]&#13;&#10;        WHEN &apos;Other DH Reductions&apos; THEN [Customer Fees DPS (copy)_1139973722258194473]&#13;&#10;        WHEN &apos;Other Reductions&apos; THEN [Other DH Reductions (copy)_2515823408475398152]&#13;&#10;        WHEN &apos;Priority Fee Net&apos; THEN [Service Fee Net (copy)_1139973722152595486]&#13;&#10;        WHEN &apos;Priority Fee Paid&apos; THEN [Delivery Fee Net (copy)_5755600392041246766]&#13;&#10;        WHEN &apos;Service Fee Net&apos; THEN [Customer Fees Paid (copy)_1139973722151665692]&#13;&#10;        WHEN &apos;Service Fee Paid&apos; THEN [Service Fee Net (copy)_5755600392050638902]&#13;&#10;        WHEN &apos;Small Basket Fee Net&apos; THEN [Service Fee Net (copy)_1139973722153009183]&#13;&#10;        WHEN &apos;Small Basket Fee Paid&apos; THEN [Small Basket Fee Net (copy)_5755600392052346940]&#13;&#10;        WHEN &apos;Subscription Vendor Subsidy Net&apos; THEN [Small Basket Net (copy)_1139973722288521258]&#13;&#10;        //WHEN &apos;Taxes&apos; THEN [Taxes]&#13;&#10;        WHEN &apos;Total Fees DPS&apos; THEN [Calculation_1139973721946988551]&#13;&#10;        WHEN &apos;Total Fees DPS (exc. Std)&apos; THEN [Total Fees DPS (copy)_5648006582351069198]&#13;&#10;        WHEN &apos;Total Fees Paid&apos; THEN [Total Fees Paid Net (copy)_5755600392043515951]&#13;&#10;        WHEN &apos;Total Fees Paid Net&apos; THEN [Calculation_1139973721947041801]&#13;&#10;        WHEN &apos;Vendor Fees Paid&apos; THEN [Vendor Funded Delivery Fee Subsidy Net (copy)_5755600392051896379]&#13;&#10;    WHEN &apos;Vendor Funded Delivery Fee Subsidy Net&apos; THEN [Subscription Vendor Subsidy Net (copy)_1139973722288619563]&#13;&#10;    END&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 7] = &apos;Operational&apos; THEN&#13;&#10;    CASE [Parameters].[Metric 3 (copy)_3085810177973952550]&#13;&#10;        WHEN &apos;Orders&apos; THEN COUNT([__tableau_internal_object_id__].[pricing_framework_31443A764E8F4C8ABB81B0659FA41FC5])/[Aggregation (copy)_3085810177976483880]&#13;&#10;        WHEN &apos;Successful Orders&apos; THEN [Calculation_3085810177769836549]/[Aggregation (copy)_3085810177976483880]&#13;&#10;        WHEN &apos;Distance (km)&apos; THEN SUM([delivery_distance])/[Aggregation (copy)_3085810177976483880]&#13;&#10;        WHEN &apos;Vendor Age&apos; THEN SUM([days_since_activation])/[Aggregation (copy)_3085810177976483880]&#13;&#10;        WHEN &apos;Profitable Orders&apos; THEN [Calculation_3085810177769197570]/[Aggregation (copy)_3085810177976483880]&#13;&#10;        // DPS components&#13;&#10;        WHEN &apos;Service Fee Enabled&apos; THEN [Profitable Orders (copy)_3085810177970946083]/[DPS Aggregation (copy)_3085810177977397289]&#13;&#10;        WHEN &apos;Surge Fee Enabled&apos; THEN [Service Fee Enabled (copy)_3085810177978617898]/[DPS Aggregation (copy)_3085810177977397289]&#13;&#10;    END&#13;&#10;END' />
            </column>
            <column caption='Other Reductions' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Other DH Reductions (copy)_2515823408475398152]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX([Calculation_1139973721946988551] - ([Calculation_2515823408474148870] + [Calculation_1139973721947041801]),0)' />
