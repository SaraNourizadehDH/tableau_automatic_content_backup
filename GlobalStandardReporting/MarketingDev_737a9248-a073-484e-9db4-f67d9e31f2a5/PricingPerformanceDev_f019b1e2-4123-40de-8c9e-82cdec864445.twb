              <calculation class='tableau' formula='(ZN([Orders (M) (copy)_1132936785172951058]) - LOOKUP(ZN([Orders (M) (copy)_1132936785172951058]), -1)) / ABS(LOOKUP(ZN([Orders (M) (copy)_1132936785172951058]), -1))'>
