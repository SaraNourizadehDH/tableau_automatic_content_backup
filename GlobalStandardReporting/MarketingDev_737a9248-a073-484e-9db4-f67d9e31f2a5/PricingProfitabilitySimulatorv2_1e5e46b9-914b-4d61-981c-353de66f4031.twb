            <column caption='New ADF' datatype='real' default-format='C1033%' name='[DF (manual) (copy)_2379378411277004810]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(([Calculation_1354950172190437377])*[Parameters].[% Tier 1 (copy)_671880815140675584]*[Parameters].[formula Parameter]  +&#13;&#10;   ([Calculation_1354950172190437377])*[Parameters].[$ Tier 1 (copy 2)_671880815140880387]*([Parameters].[% Tier 1 (copy)_332984935647199258]-[Parameters].[formula Parameter])+&#13;&#10;   ([Calculation_1354950172190437377])*[Parameters].[$ Tier 1 (copy 2) (copy)_671880815140900868]*([Parameters].[% Tier 1 (copy) (copy)_332984935647207451]-[Parameters].[% Tier 1 (copy)_332984935647199258]) +&#13;&#10;   ([Calculation_1354950172190437377])*[Parameters].[$ Tier 1 (copy 3)_671880815140900871]*([Parameters].[% Tier 1 (copy) (copy) (copy)_332984935647215644]-[Parameters].[% Tier 1 (copy) (copy)_332984935647207451])+&#13;&#10;   ([Calculation_1354950172190437377])*[Parameters].[$ Tier 1 (copy)_671880815140864001]*([Parameters].[% Tier 1 (copy) (copy) (copy) (copy)_332984935647223837]-[Parameters].[% Tier 1 (copy) (copy) (copy)_332984935647215644]) +&#13;&#10;   ([Calculation_1354950172190437377])*[Parameters].[$ Tier 1 (copy) (copy 2)_671880815140900870]*([Parameters].[% Tier 5 (copy)_332984935647637534]-[Parameters].[% Tier 1 (copy) (copy) (copy) (copy)_332984935647223837])  +&#13;&#10;   ([Calculation_1354950172190437377])*[Parameters].[$ Tier 1 (copy) (copy)_671880815140880386]*([Parameters].[% Tier 4 (copy)_332984935647719456]-[Parameters].[% Tier 5 (copy)_332984935647637534])+&#13;&#10;   ([Calculation_1354950172190437377])*[Parameters].[$ Tier 1 (copy) (copy) (copy)_671880815140900869]*([Parameters].[% Tier 5 (copy)_332984935647719455]-[Parameters].[% Tier 4 (copy)_332984935647719456]) +&#13;&#10;   ([Calculation_1354950172190437377])*[Parameters].[$ Tier 1 (copy) (copy) (copy) (copy)_671880815140917256]*([Parameters].[% Tier 6 (copy)_332984935647719457]-[Parameters].[% Tier 5 (copy)_332984935647719455])&#13;&#10;)/ ([Calculation_1354950172190437377]) * (1-[Parameters].[% Commission (c