            <column caption='New vs Current ADF' datatype='real' name='[Calculation_6246492688386166786]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([DF (manual) (copy)_2379378411277004810]/[Lin. distance (copy)_2460091335157727242])-1'>
                <table-calc ordering-type='Rows' />
