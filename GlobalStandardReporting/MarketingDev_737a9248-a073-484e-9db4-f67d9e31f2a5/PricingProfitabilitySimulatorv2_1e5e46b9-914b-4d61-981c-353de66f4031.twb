            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Dimension' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Linear Distance&quot;'>
              <calculation class='tableau' formula='&quot;Linear Distance&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1stljo71m89xh31d2k82t15aoq9k'>
            <column caption='Share of orders' datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM(SUM([orders])) / TOTAL(SUM([orders]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='No distance data' datatype='boolean' name='[Calculation_1488158251165884418]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='ISNULL([linear_distance])' />
            </column>
            <column caption='Travel time Current' datatype='real' default-format='*nn\&apos;ss\&quot;' name='[Calculation_2460091335139860484]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_982910654516989965])/SUM([orders])/60/60/24' />
            </column>
            <column caption='Current Distance' datatype='real' default-format='n#,##0,.00K&quot;m&quot;;-#,##0,.00K&quot;m&quot;' name='[Calculation_2460091335157096456]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([linear_distance]*[orders])/SUM([orders])' />
            </column>
            <column caption='Dimension' datatype='real' name='[Calculation_2460091335208255520]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;Linear Distance&apos; THEN [linear_distance]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Travel Time&apos; THEN [Calculation_982910654516989965]&#13;&#10;END' />
            </column>
            <column caption='Travel time (sec)' datatype='real' name='[Calculation_982910654516989965]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[linear_distance]*[formula]' />
