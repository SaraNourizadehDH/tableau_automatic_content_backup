            <column caption='New Orders' datatype='real' name='[Calculation_1354950172190437377]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(-[Parameters].[% DF VAT (copy)_5538864642923565057]*(([Lin. distance (copy)_2460091335157727242]-[Calculation_2214645163262603287])/[Lin. distance (copy)_2460091335157727242])+1)*SUM([orders])'>
