            <column caption='Share selected' datatype='real' default-format='p0.0%' name='[DF (copy)_1481402853566353425]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [tier_number_scheme] WHEN 1 THEN [Parameters].[formula Parameter] &#10;WHEN 2 THEN [Parameters].[% Tier 1 (copy)_332984935647199258] - [Parameters].[formula Parameter] &#10;WHEN 3 THEN [Parameters].[% Tier 1 (copy) (copy)_332984935647207451] - [Parameters].[% Tier 1 (copy)_332984935647199258] &#10;WHEN 4 THEN [Parameters].[% Tier 1 (copy) (copy) (copy)_332984935647215644] - [Parameters].[% Tier 1 (copy) (copy)_332984935647207451] &#10;WHEN 5 THEN [Parameters].[% Tier 1 (copy) (copy) (copy) (copy)_332984935647223837] - [Parameters].[% Tier 1 (copy) (copy) (copy)_332984935647215644]  &#10;WHEN 6 THEN [Parameters].[% Tier 5 (copy)_332984935647637534] - [Parameters].[% Tier 1 (copy) (copy) (copy) (copy)_332984935647223837]&#10;WHEN 7 THEN [Parameters].[% Tier 4 (copy)_332984935647719456] - [Parameters].[% Tier 5 (copy)_332984935647637534]&#10;WHEN 8 THEN [Parameters].[% Tier 5 (copy)_332984935647719455] - [Parameters].[% Tier 4 (copy)_332984935647719456] &#10;WHEN 9 THEN [Parameters].[% Tier 6 (copy)_332984935647719457] - [Parameters].[% Tier 5 (copy)_332984935647719455] &#10;&#10;END' />
