      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='subscriptions_intelligence_v1' id='subscriptions_intelligence_v1_0915969B6118485899B6A3AC31EF6E01'>
            <properties context=''>
              <relation join='left' type='join'>
                <clause type='join'>
                  <expression op='AND'>
                    <expression op='='>
                      <expression op='[subscriptions_intelligence_v1].[Global_entity_ID]' />
                      <expression op='[Custom SQL Query].[global_entity_id]' />
                    </expression>
                    <expression op='='>
                      <expression op='DATE([subscriptions_intelligence_v1].[Reporting_month])' />
                      <expression op='[Custom SQL Query].[date_month]' />
                    </expression>
                  </expression>
                </clause>
                <relation connection='bigquery.130zy8n0y2r0d01afddi817st82l' name='subscriptions_intelligence_v1' table='[dh-marketing-analytics.rl_mkt].[subscriptions_intelligence_v1]' type='table' />
                <relation connection='bigquery.130zy8n0y2r0d01afddi817st82l' name='Custom SQL Query' type='text'>SELECT
    ge.global_entity_id,
    DATE_TRUNC(created_date, MONTH) AS date_month,
    SUM(isp.total_incentives_eur) AS total_spend
  FROM `fulfillment-dwh-production.cl_mkt.bima_incentives_reporting` AS bir
  LEFT JOIN UNNEST (incentive_spend) AS isp
  INNER JOIN `fulfillment-dwh-production.curated_data_shared_coredata.global_entities` AS ge
    ON bir.global_entity_id = ge.global_entity_id 
      AND ge.is_reporting_enabled
  WHERE bir.created_date &gt;&gt;= &quot;2022-08-01&quot; 
  GROUP BY 1, 2</relation>
              </relation>
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
