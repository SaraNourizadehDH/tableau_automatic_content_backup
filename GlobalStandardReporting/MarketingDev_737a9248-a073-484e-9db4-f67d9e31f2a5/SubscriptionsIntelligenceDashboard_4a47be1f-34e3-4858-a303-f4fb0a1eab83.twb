            </column>
            <column caption='Overall Country Filter' datatype='boolean' name='[Calculation_578923716884656128]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [country] = &apos;Sweden&apos; &#10;    OR [country] = &apos;Myanmar&apos; &#10;    OR [country] = &apos;Laos&apos; &#10;    OR ([country] = &apos;Norway&apos; AND [Reporting_month] &lt; DATE(&apos;2023-07-01&apos;))&#10;    THEN FALSE&#10;ELSE &#10; TRUE&#10;END' />
