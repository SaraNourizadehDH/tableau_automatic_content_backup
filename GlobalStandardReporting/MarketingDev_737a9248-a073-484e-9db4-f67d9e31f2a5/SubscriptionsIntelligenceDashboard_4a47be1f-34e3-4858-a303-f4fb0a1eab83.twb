            </column>
            <column caption='DH-funded benefits' datatype='real' name='[Calculation_4902379349670862866]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Total_subscription_benefits_eur])&#10;-&#10;sum([Vendor_funded_subscription_benefits_eur])' />
            </column>
            <column caption='Benefits per subscriber, €' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_4902379349671854099]' role='measure' type='quantitative'>
