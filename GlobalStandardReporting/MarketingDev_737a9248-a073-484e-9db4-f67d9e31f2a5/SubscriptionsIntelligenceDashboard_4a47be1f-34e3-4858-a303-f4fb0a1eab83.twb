            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.1cokzdv1bpohwc102y1080frep9o].[date_month]' caption='Reporting Month' datatype='datetime' default-format='*mmm yy' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2023-10-01 00:00:00#'>
              <calculation class='tableau' formula='#2023-10-01 00:00:00#' />
