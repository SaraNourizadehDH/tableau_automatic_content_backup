      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1cokzdv1bpohwc102y1080frep9o].[sum:FLGPU_subscribers_eur:qk]&quot;' value='FLGPU (subscribers)' />
