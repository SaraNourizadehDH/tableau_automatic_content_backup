            </column>
            <column caption='FLGPO (non subscribers), €' datatype='real' default-format='c&quot;€&quot;#,##0.00;-&quot;€&quot;#,##0.00' name='[FLGPO (subscribers) (copy)_4902379349678989335]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([FLGP_non_subscribers_eur])&#10;/&#10;sum([Non_subscription_orders])' />
            </column>
            <column caption='FLGPU (non subscribers), €' datatype='real' default-format='c&quot;€&quot;#,##0.00;-&quot;€&quot;#,##0.00' name='[FLGPU (subscribers) (copy)_4902379349676879894]' role='measure' type='quantitative'>
