              <calculation class='tableau' formula='SUM(&#10;IF [Reporting_month] = [Parameters].[Parameter 1] THEN&#10;([Pre_subs_frequency_30d_before])&#10;*&#10;([Subscribers_total_month])&#10;END)&#10;/&#10;SUM(IF [Reporting_month]=[Parameters].[Parameter 1] THEN [Subscribers_total_month] END)' />
            </column>
