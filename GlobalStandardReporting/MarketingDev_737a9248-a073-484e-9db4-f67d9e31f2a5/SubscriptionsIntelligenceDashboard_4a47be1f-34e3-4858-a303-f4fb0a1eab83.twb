        <calculation class='tableau' formula='100*&#10;(&#10;[Reporting Month Monthly Active Users (copy)_239324150161133572]&#10;-&#10;[Reporting Month % Subscribers (copy)_2668664308102115328]&#10;)' />
      </column>
