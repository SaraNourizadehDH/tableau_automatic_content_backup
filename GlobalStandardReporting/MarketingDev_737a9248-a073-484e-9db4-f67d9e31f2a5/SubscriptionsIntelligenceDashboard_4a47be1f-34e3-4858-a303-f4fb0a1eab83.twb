            <column caption='Months to show' datatype='integer' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='3'>
              <calculation class='tableau' formula='3' />
              <range max='100' min='1' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1cokzdv1bpohwc102y1080frep9o'>
            <column caption='Non Sub Benefits per users, €' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Benefits per subscriber, € (copy)_2383600472344322055]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([total_spend])&#10;- sum([Total_subscription_benefits_eur])&#10;)&#10;/&#10;sum([Monthly_active_users])' />
            </column>
            <column caption='Months to display' datatype='boolean' name='[Calculation_1098526511620268032]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&quot;month&quot;,[Reporting_month],[Parameters].[Parameter 1])&lt;= [Parameters].[Parameter 2]-1&#10;AND &#10;DATEDIFF(&quot;month&quot;,[Reporting_month],[Parameters].[Parameter 1])&gt;= 0' />
            </column>
            <column caption='Benefits ratio (Subs vs. all)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2383600472022896641]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM([Total_subscription_benefits_eur]) / SUM([Subscribers_total_month])&#10;)&#10;/&#10;(&#10;(&#10;    SUM([total_spend]) - SUM([Total_subscription_benefits_eur])&#10;)&#10;/&#10;SUM( [Monthly_active_users])&#10;)' />
            </column>
            <column caption='Total market orders' datatype='integer' name='[Calculation_4902379349621710849]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Subscription_orders])&#10;+&#10;sum([Non_subscription_orders])' />
            </column>
            <column caption='Total market GMV' datatype='real' name='[Calculation_4902379349623664642]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([GMV_eur_subscribers])&#10;+&#10;sum([GMV_eur_non_subscribers])' />
            </column>
            <column caption='% Subscribers GMV' datatype='real' default-format='p0.0%' name='[Calculation_4902379349623861251]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([GMV_eur_subscribers])&#10;/&#10;[Calculation_4902379349623664642]' />
            </column>
            <column caption='Benefits per subscriber, €' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_4902379349671854099]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Total_subscription_benefits_eur])&#10;/&#10;sum([Subscribers_total_month])' />
            </column>
            <column caption='% Subscribers' datatype='real' default-format='p0.0%' name='[Calculation_5059723858758057984]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Susbcribers_EOM])&#10;/&#10;sum([Monthly_active_users])' />
            </column>
            <column caption='New Subscribers (% of MAU)' datatype='real' default-format='p0.0%' name='[Calculation_5059723858759852033]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([New_subscribers])&#10;/&#10;sum([Monthly_active_users])' />
            </column>
            <column caption='% Subscriber Orders' datatype='real' default-format='p0.0%' name='[Calculation_5059723858762743810]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Subscription_orders])&#10;/&#10;[Calculation_4902379349621710849]' />
            </column>
            <column caption='Churn Rate (1m)' datatype='real' default-format='p0.0%' name='[Calculation_5059723858763411459]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Churned_subscribers])&#10;/&#10;sum([Previous_month_subscribers])' />
            </column>
            <column caption='Subscribers Frequency' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_5059723858763735044]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Subscription_orders])&#10;/&#10;sum([Subscribers_total_month])' />
            </column>
            <column caption='Weighted post subs frequency 30d after' datatype='real' name='[Calculation_5059723858766929925]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(&#10;([Post_subs_frequency_30d_after])&#10;*&#10;([Subscribers_total_month])&#10;)&#10;/&#10;sum([Subscribers_total_month])' />
            </column>
            <column caption='Frequency Incrementality (%)' datatype='real' default-format='p0%' name='[Calculation_5059723858767507463]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;[Calculation_5059723858766929925]&#10;-&#10;[Weighted current frequency (copy)_5059723858767192070]&#10;)&#10;/&#10;[Calculation_5059723858766929925]' />
            </column>
            <column caption='FLGPU (subscribers)' datatype='real' default-format='c&quot;€&quot;#,##0.00;-&quot;€&quot;#,##0.00' name='[Calculation_5059723858768297995]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([FLGP_subscribers_eur])&#10;/&#10;sum([Subscribers_total_month])' />
