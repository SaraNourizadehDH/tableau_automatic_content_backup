    SAFE_DIVIDE(SUM(IFNULL(other_revenue_ln_local, 0) / IFNULL(lucanet_fx_rate,1)) , COUNT(CASE WHEN f.is_valid_order THEN 1 END)) other_revenue_ln,
    SAFE_DIVIDE(SUM(IFNULL(advertising_revenue_local, 0) / IFNULL(lucanet_fx_rate,1)) , COUNT(CASE WHEN f.is_valid_order THEN 1 END)) advertising_revenue,
    # costs
    SAFE_DIVIDE(SUM(-IFNULL(rider_cost_assumed_local, 0) / IFNULL(lucanet_fx_rate,1)) , COUNT(CASE WHEN f.is_valid_order THEN 1 END)) rider_cost_assumed,
    SAFE_DIVIDE(SUM(-IFNULL(wastage_cost_local, 0) / IFNULL(lucanet_fx_rate,1)) , COUNT(CASE WHEN f.is_valid_order THEN 1 END)) wastage_cost,
    SAFE_DIVIDE(SUM(-IFNULL(refund_cost_local, 0) / IFNULL(lucanet_fx_rate,1)) , COUNT(CASE WHEN f.is_valid_order THEN 1 END)) refund_cost,
    SAFE_DIVIDE(SUM(-IFNULL(customer_compensation_local, 0) / IFNULL(lucanet_fx_rate,1)) , COUNT(CASE WHEN f.is_valid_order THEN 1 END)) customer_compensation,
    SAFE_DIVIDE(SUM(IFNULL(transmission_cpo_ln_local, 0) / IFNULL(lucanet_fx_rate,1)) , COUNT(CASE WHEN f.is_valid_order THEN 1 END)) transmission_cpo_ln,
    SAFE_DIVIDE(SUM(IFNULL(contact_centre_cpo_ln_local, 0) / IFNULL(lucanet_fx_rate,1)) , COUNT(CASE WHEN f.is_valid_order THEN 1 END)) contact_centre_cpo_ln,
    SAFE_DIVIDE(SUM(IFNULL(payment_cost_cpo_ln_local, 0) / IFNULL(lucanet_fx_rate,1)) , COUNT(CASE WHEN f.is_valid_order THEN 1 END)) payment_cost_cpo_ln,
    SAFE_DIVIDE(SUM(IFNULL(semi_variable_delivery_cost_ln_local, 0) / IFNULL(lucanet_fx_rate,1)) , COUNT(CASE WHEN f.is_valid_order THEN 1 END)) semi_variable_delivery_cost_ln,
    SAFE_DIVIDE(SUM(IFNULL(other_cos_cpo_ln_local, 0) / IFNULL(lucanet_fx_rate,1)) , COUNT(CASE WHEN f.is_valid_order THEN 1 END)) other_cos_cpo_ln_local,
