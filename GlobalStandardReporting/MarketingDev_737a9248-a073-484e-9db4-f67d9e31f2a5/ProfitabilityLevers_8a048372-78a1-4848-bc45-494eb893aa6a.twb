      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_41F21228BA5747C69DC88B0BF3D3A3FD'>
            <properties context=''>
              <relation connection='bigquery.083u04z0j9wz9t13ljdd61ooc58x' name='Custom SQL Query' type='text'><![CDATA[SELECT
    f.country_name,
    f.global_entity_id,
    f.order_date,
    COUNT(CASE WHEN f.is_valid_order THEN 1 END) raw_orders,
    SAFE_DIVIDE(SUM((
    # revenues
      IFNULL(commission_net_local, 0)
    + IFNULL(delivery_fee_net_local, 0)
    + IFNULL(service_fee_local, 0)
    + IFNULL(difference_to_minimum_order_value_local, 0)
    + IFNULL(subscription_revenue_local, 0)
    + IFNULL(other_revenue_ln_local, 0)
    + IFNULL(advertising_revenue_local, 0)
    # costs
    - IFNULL(rider_cost_assumed_local, 0)
    - IFNULL(wastage_cost_local, 0)
    - IFNULL(refund_cost_local, 0)
    - IFNULL(customer_compensation_local, 0)
    + IFNULL(transmission_cpo_ln_local, 0)
    + IFNULL(contact_centre_cpo_ln_local, 0)
    + IFNULL(payment_cost_cpo_ln_local, 0)
    + IFNULL(semi_variable_delivery_cost_ln_local, 0)
    + IFNULL(other_cos_cpo_ln_local, 0)
    # incentives
    - IFNULL(dh_funded_non_delivery_voucher_value_local, 0)
    - IFNULL(dh_funded_non_delivery_discount_value_local, 0)
  ) / IFNULL(lucanet_fx_rate,1)) , COUNT(CASE WHEN f.is_valid_order THEN 1 END)) flgpo,
    # revenues
    SAFE_DIVIDE(SUM(IFNULL(commission_net_local, 0) / IFNULL(lucanet_fx_rate,1)) , COUNT(CASE WHEN f.is_valid_order THEN 1 END)) commission_net,
    SAFE_DIVIDE(SUM(IFNULL(delivery_fee_net_local, 0) / IFNULL(lucanet_fx_rate,1)) , COUNT(CASE WHEN f.is_valid_order THEN 1 END)) delivery_fee_net,
    SAFE_DIVIDE(SUM(IFNULL(service_fee_local, 0) / IFNULL(lucanet_fx_rate,1)) , COUNT(CASE WHEN f.is_valid_order THEN 1 END)) service_fee,
    SAFE_DIVIDE(SUM(IFNULL(difference_to_minimum_order_value_local, 0) / IFNULL(lucanet_fx_rate,1)) , COUNT(CASE WHEN f.is_valid_order THEN 1 END)) difference_to_minimum_order_value,
    SAFE_DIVIDE(SUM(IFNULL(subscription_revenue_local, 0) / IFNULL(lucanet_fx_rate,1)) , COUNT(CASE WHEN f.is_valid_order THEN 1 END)) subscription_revenue,
    SAFE_DIVIDE(SUM(IFNULL(other_revenue_ln_local, 0) / IFNULL(lucanet_fx_rate,1)) , COUNT(CASE WHEN f.is_valid_order THEN 1 END)) other_revenue_ln,
    SAFE_DIVIDE(SUM(IFNULL(advertising_revenue_local, 0) / IFNULL(lucanet_fx_rate,1)) , COUNT(CASE WHEN f.is_valid_order THEN 1 END)) advertising_revenue,
    # costs
    SAFE_DIVIDE(SUM(-IFNULL(rider_cost_assumed_local, 0) / IFNULL(lucanet_fx_rate,1)) , COUNT(CASE WHEN f.is_valid_order THEN 1 END)) rider_cost_assumed,
    SAFE_DIVIDE(SUM(-IFNULL(wastage_cost_local, 0) / IFNULL(lucanet_fx_rate,1)) , COUNT(CASE WHEN f.is_valid_order THEN 1 END)) wastage_cost,
    SAFE_DIVIDE(SUM(-IFNULL(refund_cost_local, 0) / IFNULL(lucanet_fx_rate,1)) , COUNT(CASE WHEN f.is_valid_order THEN 1 END)) refund_cost,
    SAFE_DIVIDE(SUM(-IFNULL(customer_compensation_local, 0) / IFNULL(lucanet_fx_rate,1)) , COUNT(CASE WHEN f.is_valid_order THEN 1 END)) customer_compensation,
    SAFE_DIVIDE(SUM(IFNULL(transmission_cpo_ln_local, 0) / IFNULL(lucanet_fx_rate,1)) , COUNT(CASE WHEN f.is_valid_order THEN 1 END)) transmission_cpo_ln,
    SAFE_DIVIDE(SUM(IFNULL(contact_centre_cpo_ln_local, 0) / IFNULL(lucanet_fx_rate,1)) , COUNT(CASE WHEN f.is_valid_order THEN 1 END)) contact_centre_cpo_ln,
    SAFE_DIVIDE(SUM(IFNULL(payment_cost_cpo_ln_local, 0) / IFNULL(lucanet_fx_rate,1)) , COUNT(CASE WHEN f.is_valid_order THEN 1 END)) payment_cost_cpo_ln,
    SAFE_DIVIDE(SUM(IFNULL(semi_variable_delivery_cost_ln_local, 0) / IFNULL(lucanet_fx_rate,1)) , COUNT(CASE WHEN f.is_valid_order THEN 1 END)) semi_variable_delivery_cost_ln,
    SAFE_DIVIDE(SUM(IFNULL(other_cos_cpo_ln_local, 0) / IFNULL(lucanet_fx_rate,1)) , COUNT(CASE WHEN f.is_valid_order THEN 1 END)) other_cos_cpo_ln_local,
    # incentives
    SAFE_DIVIDE(SUM(-IFNULL(dh_funded_non_delivery_voucher_value_local, 0) / IFNULL(lucanet_fx_rate,1)) , COUNT(CASE WHEN f.is_valid_order THEN 1 END)) dh_funded_non_delivery_voucher,
    SAFE_DIVIDE(SUM(-IFNULL(dh_funded_non_delivery_discount_value_local, 0) / IFNULL(lucanet_fx_rate,1)) , COUNT(CASE WHEN f.is_valid_order THEN 1 END)) dh_funded_non_delivery_discount,
FROM `dhh---analytics-eu.pandata_eu_finance.regional_eu_finance_order_level_rev_cost` f
WHERE f.order_date between current_date() - 180 and current_date()
  and f.delivery_type = <[Parameters].[Parameter 1]>
  and f.business_type = <[Parameters].[Parameter 2]>
GROUP BY ALL
ORDER BY 1]]></relation>
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
