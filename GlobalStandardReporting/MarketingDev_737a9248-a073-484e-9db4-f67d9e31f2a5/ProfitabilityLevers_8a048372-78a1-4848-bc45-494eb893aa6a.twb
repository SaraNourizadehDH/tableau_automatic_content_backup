  <worksheets>
    <worksheet name='Aggregated'>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (curated_data_shared)' name='federated.0n9z5q61nrixl517tuc2o0ow79m3' />
          </datasources>
          <datasource-dependencies datasource='federated.0n9z5q61nrixl517tuc2o0ow79m3'>
            <column caption='Commission Revenue' datatype='real' name='[Advertising Revenue (copy)_2037597421283323905]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([commission_net]*[raw_orders])/SUM([raw_orders])' />
            </column>
