              <calculation class='tableau' formula='IF (&#10;  NOT ISNULL([peya_df (Custom SQL Query)])&#10;  AND (&#10;    NOT ISNULL([rappi_df (Custom SQL Query)]) OR NOT ISNULL([ubereats_df (Custom SQL Query)])&#10;  )&#10;  OR (&#10;    ISNULL([peya_df (Custom SQL Query)])&#10;    AND (NOT ISNULL([foodpanda_df (Custom SQL Query)]) OR NOT ISNULL([grab_df (Custom SQL Query)]) OR NOT ISNULL([mena_competitor_df]))&#10;  )&#10;) THEN TRUE&#10;ELSE FALSE&#10;END' />
