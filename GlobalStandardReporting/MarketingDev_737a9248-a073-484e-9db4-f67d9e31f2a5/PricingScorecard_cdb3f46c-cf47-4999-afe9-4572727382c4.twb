            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ozbod3086u20j12geawb0gc5pzm'>
            <column caption='Aggregation Detail' datatype='string' name='[Aggregation (copy)_1963569459984224257]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Benchmark Threshold (copy)_1963569459984424962]=&quot;Market Archetype&quot; then [market_archetype]&#10;elseif [Parameters].[Benchmark Threshold (copy)_1963569459984424962] = &quot;Region&quot; then [region]&#13;&#10;elseif [Parameters].[Benchmark Threshold (copy)_1963569459984424962] = &quot;Entity&quot; then [entity_id]&#10;END' />
            </column>
            <column caption='Profitability weighted' datatype='real' name='[Calculation_1218857075327299584]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Benchmark Threshold (copy)_1963569459984424962] = &apos;Entity&apos; then&#10;sum([profitability_score]*[orders])&#10;ELSE&#10;sum([profitability_ma_score]*[orders])&#10;END' />
            </column>
            <column caption='Score' datatype='real' default-format='p0.0%' name='[Calculation_1963569459979329536]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Total Score&apos; THEN AVG([Total Score (copy)_1218857075340685323])&#13;&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Experimentation Score&apos; THEN [Penetration ponderated (copy) (copy)_1218857075338395656]&#13;&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Sophistication Score&apos; THEN [Profitability ponderated (copy)_1218857075339649034]&#13;&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Profitability Score&apos; THEN [Profitability ponderated (copy)_1218857075330011139]&#13;&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Penetration Score&apos; THEN [Profitability ponderated (copy)_1218857075335725061]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Affordability Score&apos; THEN [Experimentation ponderated (copy)_1561482497529569281]&#13;&#10;END' />
            </column>
            <column caption='Affordability ponderated' datatype='real' default-format='p0.0%' name='[Experimentation ponderated (copy)_1561482497529569281]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Experimentation weighted (copy)_1561482497529384960]/sum([orders])' />
            </column>
            <column caption='Affordability weighted' datatype='real' name='[Experimentation weighted (copy)_1561482497529384960]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Benchmark Threshold (copy)_1963569459984424962] = &apos;Entity&apos; then&#10;sum([affordability_score]*[orders])&#10;ELSE&#10;sum([affordability_ma_score]*[orders])&#10;END' />
            </column>
            <column caption='Experimentation ponderated' datatype='real' default-format='p0.0%' name='[Penetration ponderated (copy) (copy)_1218857075338395656]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Penetration weighted (copy)_1218857075338248199]/sum([orders])' />
            </column>
            <column caption='Experimentation weighted' datatype='real' name='[Penetration weighted (copy)_1218857075338248199]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Benchmark Threshold (copy)_1963569459984424962] = &apos;Entity&apos; then&#10;sum([experimentation_score]*[orders])&#10;ELSE&#10;sum([experimentation_ma_score]*[orders])&#10;END' />
            </column>
            <column caption='Profitability ponderated' datatype='real' default-format='p0.0%' name='[Profitability ponderated (copy)_1218857075330011139]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1218857075327299584]/sum([orders])' />
            </column>
            <column caption='Penetration ponderated' datatype='real' default-format='p0.0%' name='[Profitability ponderated (copy)_1218857075335725061]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Profitability weighted (copy)_1218857075335909382]/sum([orders])' />
            </column>
            <column caption='Sophistication ponderated' datatype='real' default-format='p0.0%' name='[Profitability ponderated (copy)_1218857075339649034]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Profitability weighted (copy)_1218857075339251721]/sum([orders])' />
            </column>
            <column caption='Penetration weighted' datatype='real' name='[Profitability weighted (copy)_1218857075335909382]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Benchmark Threshold (copy)_1963569459984424962] = &apos;Entity&apos; then&#10;sum([penetration_score]*[orders])&#10;ELSE&#10;sum([penetration_ma_score]*[orders])&#10;END' />
            </column>
            <column caption='Sophistication Weighted' datatype='real' name='[Profitability weighted (copy)_1218857075339251721]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([sophistication_score]*[orders])' />
            </column>
            <column caption='Total Score' datatype='real' name='[Total Score (copy)_1218857075340685323]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Benchmark Threshold (copy)_1963569459984424962] = &quot;Entity&quot;&#10;then&#10;(IFNULL(([profitability_score]*7),0)+IFNULL(([sophistication_score]*10),0)+ IFNULL(([experimentation_score]*2),0)+IFNULL(([penetration_score]*3),0)&#10;+IFNULL(([affordability_score]*4),0))/26&#10;ELSE&#10;(IFNULL(([profitability_ma_score]*7),0)+IFNULL(([sophistication_score]*10),0)+ IFNULL(([experimentation_ma_score]*2),0)&#10;+IFNULL(([penetration_ma_score]*3),0)+IFNULL(([affordability_ma_score]*4),0))/26&#10;END' />
