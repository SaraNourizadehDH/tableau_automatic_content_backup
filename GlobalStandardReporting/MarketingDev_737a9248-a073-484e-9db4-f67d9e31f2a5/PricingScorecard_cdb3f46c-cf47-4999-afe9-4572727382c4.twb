      <table>
        <view>
          <datasources>
            <datasource caption='Scorecard' name='federated.1ozbod3086u20j12geawb0gc5pzm' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Aggregation' datatype='string' name='[Benchmark Threshold (copy)_1963569459984424962]' param-domain-type='list' role='measure' type='nominal' value='&quot;Region&quot;'>
              <calculation class='tableau' formula='&quot;Region&quot;' />
            </column>
            <column caption='Score type' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Total Score&quot;'>
              <calculation class='tableau' formula='&quot;Total Score&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ozbod3086u20j12geawb0gc5pzm'>
            <column caption='Aggregation Detail' datatype='string' name='[Aggregation (copy)_1963569459984224257]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Benchmark Threshold (copy)_1963569459984424962]=&quot;Market Archetype&quot; then [market_archetype]&#10;elseif [Parameters].[Benchmark Threshold (copy)_1963569459984424962] = &quot;Region&quot; then [region]&#13;&#10;elseif [Parameters].[Benchmark Threshold (copy)_1963569459984424962] = &quot;Entity&quot; then [entity_id]&#10;END' />
            </column>
            <column caption='Orders' datatype='integer' name='[Calculation_1218857075332939780]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders])' />
            </column>
            <column caption='Restaurant Frequency' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_168744261028474918]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([od_restaurant_orders])/sum([od_restaurant_users])' />
            </column>
            <column caption='Is Penetration Selected' datatype='boolean' name='[Calculation_1963569459990511621]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 4]=&quot;Penetration Score&quot;' />
            </column>
            <column caption='User Penetration' datatype='real' default-format='p0.0%' name='[Calculation_5060849747308552194]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([od_restaurant_users])/sum([addressable_population])' />
            </column>
            <column caption='OD Order share' datatype='real' default-format='p0.0%' name='[Calculation_5060849747638079494]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([od_restaurant_orders])/sum([orders])' />
            </column>
            <column caption='Penetration Score' datatype='real' default-format='p0.0%' name='[Experimentation Score (copy)_2532922966586621959]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF [Parameters].[Benchmark Threshold (copy)_1963569459984424962] = &apos;Entity&apos; then&#10;{ FIXED [month], [entity_id] : SUM(([frequency_score] +[user_penetration_score]+[od_rest_orders_score]) / 3)}&#10;ELSE&#10;{ FIXED [month], [entity_id] : SUM(([frequency_ma_score]+[user_penetration_ma_score]+[od_rest_orders_ma_score]) / 3)}&#10;END)' />
            </column>
            <column caption='Penetration ponderated' datatype='real' default-format='p0.0%' name='[Profitability ponderated (copy)_1218857075335725061]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Profitability weighted (copy)_1218857075335909382]/sum([orders])' />
            </column>
            <column caption='Penetration weighted' datatype='real' name='[Profitability weighted (copy)_1218857075335909382]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Benchmark Threshold (copy)_1963569459984424962] = &apos;Entity&apos; then&#10;sum([penetration_score]*[orders])&#10;ELSE&#10;sum([penetration_ma_score]*[orders])&#10;END' />
            </column>
