    <worksheet name='Sophistication KPI'>
      <table>
        <view>
          <datasources>
            <datasource caption='Scorecard' name='federated.1ozbod3086u20j12geawb0gc5pzm' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Aggregation' datatype='string' name='[Benchmark Threshold (copy)_1963569459984424962]' param-domain-type='list' role='measure' type='nominal' value='&quot;Region&quot;'>
              <calculation class='tableau' formula='&quot;Region&quot;' />
            </column>
            <column caption='Score type' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Total Score&quot;'>
              <calculation class='tableau' formula='&quot;Total Score&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ozbod3086u20j12geawb0gc5pzm'>
            <column caption='Aggregation Detail' datatype='string' name='[Aggregation (copy)_1963569459984224257]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Benchmark Threshold (copy)_1963569459984424962]=&quot;Market Archetype&quot; then [market_archetype]&#10;elseif [Parameters].[Benchmark Threshold (copy)_1963569459984424962] = &quot;Region&quot; then [region]&#13;&#10;elseif [Parameters].[Benchmark Threshold (copy)_1963569459984424962] = &quot;Entity&quot; then [entity_id]&#10;END' />
            </column>
            <column caption='DBDF' datatype='real' default-format='p0.0%' name='[Calculation_5060849747696050188]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([dbdf_orders])/sum([order_qty])' />
            </column>
            <column caption='FDNC' datatype='real' default-format='p0.0%' name='[DBDF (copy 2)_5060849747697590290]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([fdnc_orders])/sum([order_qty])' />
            </column>
            <column caption='Customer Location' datatype='real' default-format='p0.0%' name='[DBDF (copy 2)_5060849747699400724]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([customer_location_orders])/sum([order_qty])' />
            </column>
            <column caption='Surge' datatype='real' default-format='p0.0%' name='[DBDF (copy) (copy)_5060849747696394254]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([surge_orders])/sum([order_qty])' />
            </column>
            <column caption='ToD' datatype='real' default-format='p0.0%' name='[DBDF (copy) (copy)_5060849747697291280]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([tod_orders])/sum([order_qty])' />
            </column>
            <column caption='DBMOV' datatype='real' default-format='p0.0%' name='[DBDF (copy)_5060849747696381965]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([variable_mov_orders])/sum([order_qty])' />
            </column>
            <column caption='Service Fee' datatype='real' default-format='p0.0%' name='[DBDF (copy)_5060849747697278991]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([service_fee_orders])/sum([order_qty])' />
            </column>
            <column caption='Surge MOV' datatype='real' default-format='p0.0%' name='[DBDF (copy)_5060849747697578001]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([surge_mov_orders])/sum([order_qty])' />
            </column>
            <column caption='SBF.' datatype='real' default-format='p0.0%' name='[DBDF (copy)_5060849747699388435]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([small_order_fee_orders])/sum([order_qty])' />
            </column>
            <column caption='Basket Value' datatype='real' default-format='p0.0%' name='[DBDF (copy)_5060849747700236309]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([basket_value_orders])/sum([order_qty])' />
            </column>
            <column caption='Is Sophistication Selected' datatype='boolean' name='[Is Penetration Selected (copy)_3252513747413225475]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 4]=&quot;Sophistication Score&quot;' />
            </column>
            <column caption='Sophistication Score' datatype='real' default-format='p0.0%' name='[Profitability Score  (copy) (copy)_2532922966570250244]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({ FIXED [month], [entity_id] : SUM(([dbdf_score]+ [variable_mov_score]+[service_fee_score]+[surge_score]+&#10;[small_order_fee_score]+[fdnc_score]+[tod_score]+[surge_mov_score]+[basket_value_score]+[customer_location_score]))/10})' />
            </column>
            <column caption='Sophistication ponderated' datatype='real' default-format='p0.0%' name='[Profitability ponderated (copy)_1218857075339649034]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Profitability weighted (copy)_1218857075339251721]/sum([orders])' />
            </column>
            <column caption='Sophistication Weighted' datatype='real' name='[Profitability weighted (copy)_1218857075339251721]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([sophistication_score]*[orders])' />
            </column>
            <column caption='Basket Value Orders' datatype='integer' name='[basket_value_orders]' role='measure' type='quantitative' />
            <column caption='Basket Value Score1' datatype='integer' name='[basket_value_score]' role='measure' type='quantitative' />
            <column caption='Customer Location Orders' datatype='integer' name='[customer_location_orders]' role='measure' type='quantitative' />
            <column caption='Customer Location Score1' datatype='integer' name='[customer_location_score]' role='measure' type='quantitative' />
            <column caption='Dbdf Orders' datatype='integer' name='[dbdf_orders]' role='measure' type='quantitative' />
