    when country="Republica Dominicana" then "Republica Dominicana"
    when country="El Salvador" then "El Salvador"
    when country="Guatemala" then "Guatemala"
    when country="Uruguay" then "Uruguay" end as country,
    CASE
        WHEN peya_dist_partner_address BETWEEN 0 AND 500 THEN 500
        WHEN peya_dist_partner_address BETWEEN 500 AND 1000 THEN 1000
        WHEN peya_dist_partner_address BETWEEN 1000 AND 1500 THEN 1500
        WHEN peya_dist_partner_address BETWEEN 1500 AND 2000 THEN 2000
        WHEN peya_dist_partner_address BETWEEN 2000 AND 2500 THEN 2500
        WHEN peya_dist_partner_address BETWEEN 2500 AND 3000 THEN 3000
        WHEN peya_dist_partner_address BETWEEN 3000 AND 3500 THEN 3500
        WHEN peya_dist_partner_address BETWEEN 3500 AND 4000 THEN 4000
        WHEN peya_dist_partner_address BETWEEN 4000 AND 5000 THEN 5000
        WHEN peya_dist_partner_address BETWEEN 5000 AND 6000 THEN 6000
        WHEN peya_dist_partner_address BETWEEN 6000 AND 7000 THEN 7000
        WHEN peya_dist_partner_address >> 7001 THEN 7001
      END AS distance_bucket,
      avg(peya_delivery_fee) peya_df,
      avg(rappi_delivery_fee) rappi_df,
      avg(ubereats_delivery_fee) ubereats_df,
      COUNT(*) obs,
    FROM
