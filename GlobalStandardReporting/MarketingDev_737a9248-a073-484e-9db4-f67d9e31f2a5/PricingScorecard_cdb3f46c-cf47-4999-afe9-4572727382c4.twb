            <connection CATALOG='logistics-data-storage-staging' EXECCATALOG='logistics-customer-staging' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='logistics-data-storage-staging' schema='long_term_pricing' server-oauth='' username='martin.fourcade@deliveryhero.com' workgroup-auth-mode='prompt' />
