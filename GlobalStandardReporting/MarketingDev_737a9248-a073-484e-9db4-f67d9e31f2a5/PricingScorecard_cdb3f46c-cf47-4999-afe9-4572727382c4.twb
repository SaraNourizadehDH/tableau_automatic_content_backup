    <worksheet name='Profitability KPI'>
      <table>
        <view>
          <datasources>
            <datasource caption='Scorecard' name='federated.1ozbod3086u20j12geawb0gc5pzm' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Aggregation' datatype='string' name='[Benchmark Threshold (copy)_1963569459984424962]' param-domain-type='list' role='measure' type='nominal' value='&quot;Region&quot;'>
              <calculation class='tableau' formula='&quot;Region&quot;' />
            </column>
            <column caption='Score type' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Total Score&quot;'>
              <calculation class='tableau' formula='&quot;Total Score&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ozbod3086u20j12geawb0gc5pzm'>
            <column caption='Aggregation Detail' datatype='string' name='[Aggregation (copy)_1963569459984224257]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Benchmark Threshold (copy)_1963569459984424962]=&quot;Market Archetype&quot; then [market_archetype]&#10;elseif [Parameters].[Benchmark Threshold (copy)_1963569459984424962] = &quot;Region&quot; then [region]&#13;&#10;elseif [Parameters].[Benchmark Threshold (copy)_1963569459984424962] = &quot;Entity&quot; then [entity_id]&#10;END' />
            </column>
            <column caption='Profitability weighted' datatype='real' name='[Calculation_1218857075327299584]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Benchmark Threshold (copy)_1963569459984424962] = &apos;Entity&apos; then&#10;sum([profitability_score]*[orders])&#10;ELSE&#10;sum([profitability_ma_score]*[orders])&#10;END' />
            </column>
            <column caption='Orders' datatype='integer' name='[Calculation_1218857075332939780]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders])' />
            </column>
            <column caption='Surge/DF' datatype='real' default-format='p0.0%' name='[Calculation_168744260949897217]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([surge_fee_eur])/sum([df_eur])' />
            </column>
            <column caption='%Profitable Orders' datatype='real' default-format='p0.0%' name='[Calculation_168744260951572482]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([profitable_orders])/sum([orders])' />
            </column>
            <column caption='SF/CF' datatype='real' default-format='p0.0%' name='[Calculation_168744260978552840]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([sf_eur])/sum([cf_eur])' />
            </column>
            <column caption='SBF/CF' datatype='real' default-format='p0.0%' name='[Calculation_168744260978724873]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([sbf_eur])/sum([cf_eur])' />
            </column>
            <column caption='MOV/AFV' datatype='real' default-format='p0.0%' name='[Calculation_168744260979417098]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([mov_eur])/sum([afv_eur])' />
            </column>
            <column caption='Free DF by Scheme' datatype='real' default-format='p0.0%' name='[Calculation_5060849747680972809]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([free_df_scheme_orders])/sum([orders])' />
            </column>
            <column caption='%Campaign Orders' datatype='real' default-format='p0.0%' name='[Calculation_5060849747681247242]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([campaign_orders])/sum(orders)' />
            </column>
            <column caption='Is Profitability Selected' datatype='boolean' name='[Is Penetration Selected (copy)_3252513747413135362]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 4]=&quot;Profitability Score&quot;' />
            </column>
            <column caption='Profitability Score' datatype='real' default-format='p0.0%' name='[Profitability Score  (copy)_4273282743393804292]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF [Parameters].[Benchmark Threshold (copy)_1963569459984424962] = &apos;Entity&apos; then&#10;{ FIXED [month], [entity_id] : SUM(([profitable_orders_score] + [free_df_scheme_score]+ [campaign_orders_score]+&#10;[mov_afv_score]+[surge_df_score]+[sf_cf_score] + [sbf_cf_score]) / 7)}&#10;ELSE&#10;{ FIXED [month], [entity_id] : SUM(([profitable_orders_ma_score]+[free_df_scheme_ma_score]+[campaign_orders_ma_score]+&#10;[sf_cf_ma_score]+[sbf_cf_ma_score]+[mov_afv_ma_score]+[surge_df_ma_score]) / 7)}&#10;END)' />
            </column>
            <column caption='Profitability Denominator' datatype='integer' default-format='N' name='[Profitability Score (copy)_1218857075327594497]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Parameters].[Benchmark Threshold (copy)_1963569459984424962] = &apos;Entity&apos; then&#10;{ FIXED [month], [region] : SUM([orders])}&#10;ELSE&#10;{ FIXED [month], [market_archetype] : SUM([orders])}&#10;END)' />
            </column>
            <column caption='Profitability ponderated' datatype='real' default-format='p0.0%' name='[Profitability ponderated (copy)_1218857075330011139]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1218857075327299584]/sum([orders])' />
            </column>
