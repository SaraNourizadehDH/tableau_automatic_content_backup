              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Service Requests&quot; THEN [Calculation_979744054999408642]&#10;WHEN &quot;Client Type&quot; THEN [client_name]&#10;END' />
              <aliases>
