              <calculation class='tableau' formula='IF [service_contacts_delivery_late] &gt; 0&#10;    AND [service_contacts_request_rider_eta] &lt; 1&#10;    THEN &quot;Delivery Late&quot;&#10;ELSEIF [service_contacts_delivery_late] &lt; 1&#10;    AND [service_contacts_request_rider_eta] &gt; 0&#10;    THEN &quot;Request Rider ETA Pickup&quot;&#10;ELSEIF [service_contacts_delivery_late] &gt; 0&#10;    AND [service_contacts_request_rider_eta] &gt; 0&#10;    THEN &quot;Delivery Late + Request Rider ETA Pickup&quot;&#10;ELSE &quot;No Contact&quot;&#10;END' />
