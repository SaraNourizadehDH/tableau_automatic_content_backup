      <aliases enabled='yes' />
      <column caption='RMV Orders' datatype='integer' name='[Calculation_157907492642967552]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='COUNTD([order_code])' />
      </column>
      <column caption='RMV Orders %' datatype='real' name='[Calculation_157907492643241985]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='[Calculation_157907492642967552] / [Calculation_157907492644278274]' />
      </column>
      <column caption='Total Orders' datatype='real' name='[Calculation_157907492644278274]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='SUM({ FIXED [entity_id]: AVG([orders])})' />
      </column>
      <column caption='Total Orders w/ SC %' datatype='real' name='[Calculation_157907492647780360]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='[RMV Orders (copy)_157907492646391813] / [Calculation_157907492644278274]' />
      </column>
      <column caption='Partition' datatype='string' name='[Calculation_282741645169774593]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Service Requests&quot; THEN [Calculation_979744054999408642]&#10;WHEN &quot;Client Type&quot; THEN [client_name]&#10;END' />
        <aliases>
          <alias key='%null%' value='Missing' />
        </aliases>
      </column>
      <column caption='Contacted Service' datatype='boolean' name='[Calculation_979744054998515713]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([service_contacts]) THEN FALSE ELSE TRUE END' />
      </column>
      <column caption='Contact Reason' datatype='string' name='[Calculation_979744054999408642]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [service_contacts_delivery_late] &gt; 0&#10;    AND [service_contacts_request_rider_eta] &lt; 1&#10;    THEN &quot;Delivery Late&quot;&#10;ELSEIF [service_contacts_delivery_late] &lt; 1&#10;    AND [service_contacts_request_rider_eta] &gt; 0&#10;    THEN &quot;Request Rider ETA Pickup&quot;&#10;ELSEIF [service_contacts_delivery_late] &gt; 0&#10;    AND [service_contacts_request_rider_eta] &gt; 0&#10;    THEN &quot;Delivery Late + Request Rider ETA Pickup&quot;&#10;ELSE &quot;No Contact&quot;&#10;END' />
