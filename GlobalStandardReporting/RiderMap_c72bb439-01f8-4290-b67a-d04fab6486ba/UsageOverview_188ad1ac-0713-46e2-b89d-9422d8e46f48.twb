      <column caption='Clicked On-time Orders (Clicks)' datatype='integer' name='[Clicked On-time Orders (copy)_675891814359904262]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[clicked_orders] - [clicked_delayed_orders]' />
