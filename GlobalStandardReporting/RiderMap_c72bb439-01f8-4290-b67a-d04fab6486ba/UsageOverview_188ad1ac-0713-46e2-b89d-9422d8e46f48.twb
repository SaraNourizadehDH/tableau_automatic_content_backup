      <column caption='Clicks per Clicked Order' datatype='real' name='[Clicks per Accept Order (copy)_5174917450204794882]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([clicks]) / SUM([clicked_orders])' />
      </column>
      <column caption='Metrics (D.2)' datatype='integer' name='[Metrics (D) (copy)_1266989266367225856]' role='measure' type='quantitative'>
