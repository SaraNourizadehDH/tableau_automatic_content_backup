          <datasource-dependencies datasource='federated.027fl421n2jyru1f2val90kq81v7'>
            <column caption='% Clicked / Delayed Orders' datatype='real' default-format='p0.0%' name='[% Clicked / Accepted Orders (copy)_675891814301392896]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([clicked_delayed_orders]) / SUM([delayed_orders])' />
            </column>
            <column caption='% Clicked / On-time Orders' datatype='real' default-format='p0.0%' name='[% Clicked / Delayed Orders (copy)_675891814314692611]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_675891814312017921] / [Clicked On-time Orders (copy)_675891814312734722]' />
            </column>
            <column caption='% Clicked / Accepted Orders' datatype='real' default-format='p0.0%' name='[Calculation_4666714443222126607]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([clicked_orders]) / SUM([accepted_orders])' />
            </column>
            <column caption='Clicks per Clicked Vendor' datatype='real' name='[Calculation_4666714443222294544]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([clicks]) / SUM([clicked_platdorm_vendors])' />
            </column>
            <column caption='% Clicked Map / Vendors Accepted Orders' datatype='real' default-format='p0.0%' name='[Calculation_4666714443222454289]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([clicked_platdorm_vendors]) / SUM([accepted_platform_vendors])' />
            </column>
            <column caption='Metric (B)' datatype='real' name='[Calculation_4666714443223658517]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Select Metric (copy)_4666714443215826957]&#10;WHEN &apos;clicked orders / accepted orders&apos; THEN [Calculation_4666714443222126607]&#10;WHEN &apos;clicked vendors / accepted vendors&apos; THEN [Calculation_4666714443222454289]&#10;WHEN &apos;clicked delayed orders / delayed orders&apos; THEN [% Clicked / Accepted Orders (copy)_675891814301392896]&#10;WHEN &apos;clicked on-time orders / on-time orders&apos; THEN [% Clicked / Delayed Orders (copy)_675891814314692611]&#10;WHEN &apos;clicks / clicked order&apos; THEN [Clicks per Accept Order (copy)_5174917450204794882]&#10;WHEN &apos;clicks / clicked vendor&apos; THEN [Calculation_4666714443222294544]&#10;//&#10;WHEN &apos;clicked orders&apos; THEN SUM([clicked_orders])&#10;WHEN &apos;clicked delayed orders&apos; THEN SUM([clicked_delayed_orders])&#10;WHEN &apos;delayed orders&apos; THEN SUM([delayed_orders])&#10;WHEN &apos;clicked on-time orders&apos; THEN [Calculation_675891814312017921]&#10;WHEN &apos;on-time orders&apos; THEN [Clicked On-time Orders (copy)_675891814312734722]&#10;WHEN &apos;accepted orders&apos; THEN SUM([accepted_orders])&#10;WHEN &apos;clicks&apos; THEN SUM([clicks])&#10;WHEN &apos;vendors clicked&apos; THEN SUM([clicked_platdorm_vendors])&#10;WHEN &apos;vendors accepted&apos; THEN SUM([accepted_platform_vendors])&#10;END' />
            </column>
            <column caption='Hours' datatype='integer' name='[Calculation_4666714443229249558]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='DATEPART(&apos;hour&apos;,[created_at])' />
            </column>
            <column caption='Is today?' datatype='boolean' name='[Calculation_4706120885732216833]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF TODAY() = [created_date] THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='After Dec 1' datatype='boolean' name='[Calculation_4726598180780052484]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[created_at] &gt;= DATE(&apos;2021-12-01&apos;)' />
            </column>
            <column caption='_view_' datatype='string' name='[Calculation_5355835555094163463]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Select Metric (copy)_4666714443215826957]' />
            </column>
            <column caption='Clicked On-time Orders' datatype='integer' name='[Calculation_675891814312017921]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([clicked_orders]) - SUM([clicked_delayed_orders])' />
            </column>
            <column caption='On-time Orders' datatype='integer' name='[Clicked On-time Orders (copy)_675891814312734722]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([accepted_orders]) - SUM([delayed_orders])' />
            </column>
            <column caption='Clicks per Clicked Order' datatype='real' name='[Clicks per Accept Order (copy)_5174917450204794882]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([clicks]) / SUM([clicked_orders])' />
