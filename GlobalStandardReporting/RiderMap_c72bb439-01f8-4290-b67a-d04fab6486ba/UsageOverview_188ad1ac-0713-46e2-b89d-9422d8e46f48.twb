          <datasource-dependencies datasource='federated.027fl421n2jyru1f2val90kq81v7'>
            <column caption='% Clicked / Delayed Orders' datatype='real' default-format='p0.0%' name='[% Clicked / Accepted Orders (copy)_675891814301392896]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([clicked_delayed_orders]) / SUM([delayed_orders])' />
            </column>
            <column caption='% Clicked / On-time Orders' datatype='real' default-format='p0.0%' name='[% Clicked / Delayed Orders (copy)_675891814314692611]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_675891814312017921] / [Clicked On-time Orders (copy)_675891814312734722]' />
            </column>
            <column caption='_granularity_filter' datatype='boolean' name='[Calculation_3801530733302657030]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;daily&apos; THEN [subtable] != &apos;weekly&apos; AND [subtable] != &apos;monthly&apos; &#10;WHEN &apos;weekly&apos; THEN [subtable] != &apos;daily&apos; AND [subtable] != &apos;monthly&apos; &#10;WHEN &apos;monthly&apos; THEN [subtable] != &apos;daily&apos; AND [subtable] != &apos;weekly&apos; &#10;END' />
            </column>
            <column caption='Created Date Month' datatype='string' name='[Calculation_3801530733303345159]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;&apos; &#10;+  STR(YEAR([Calculation_4666714443186110471]))&#10;+ &apos;-&apos; &#10;+  IF( MONTH([Calculation_4666714443186110471]) &gt; 9) THEN STR(MONTH([Calculation_4666714443186110471]))&#10;ELSE   &apos;0&apos; +  STR(MONTH([Calculation_4666714443186110471]))&#10;END' />
            </column>
            <column caption='Created Date Week' datatype='string' name='[Calculation_3801530733303418888]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;&apos; &#10;+ STR(YEAR([Calculation_4666714443186110471]))&#10;+ &apos;-&apos; &#10;+ IF( WEEK([Calculation_4666714443186110471]) &gt; 9) THEN STR(WEEK([Calculation_4666714443186110471]))&#10;ELSE   &apos;0&apos; +  STR(WEEK([Calculation_4666714443186110471]))&#10;END' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_3801530733303603209]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;daily&apos; THEN STR([Calculation_4666714443186110471])&#10;WHEN &apos;weekly&apos; THEN [Calculation_3801530733303418888]&#10;WHEN &apos;monthly&apos; THEN [Calculation_3801530733303345159]&#10;END' />
            </column>
            <column caption='Created Date (Date)' datatype='date' name='[Calculation_4666714443186110471]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE([created_at])' />
            </column>
            <column caption='Metrics (A)' datatype='integer' name='[Calculation_4666714443201671177]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;clicked delayed orders&apos; THEN SUM([clicked_delayed_orders])&#10;WHEN &apos;delayed orders&apos; THEN SUM([delayed_orders])&#10;WHEN &apos;clicked on-time orders&apos; THEN [Calculation_675891814312017921]&#10;WHEN &apos;on-time orders&apos; THEN [Clicked On-time Orders (copy)_675891814312734722]&#10;WHEN &apos;clicked orders&apos; THEN SUM([clicked_orders])&#10;WHEN &apos;accepted orders&apos; THEN SUM([accepted_orders])&#10;WHEN &apos;clicks&apos; THEN SUM([clicks])&#10;WHEN &apos;vendors clicked&apos; THEN SUM([clicked_platdorm_vendors])&#10;WHEN &apos;vendors accepted&apos; THEN SUM([accepted_platform_vendors])&#10;&#10;END' />
            </column>
            <column caption='% Clicked / Accepted Orders' datatype='real' default-format='p0.0%' name='[Calculation_4666714443222126607]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([clicked_orders]) / SUM([accepted_orders])' />
