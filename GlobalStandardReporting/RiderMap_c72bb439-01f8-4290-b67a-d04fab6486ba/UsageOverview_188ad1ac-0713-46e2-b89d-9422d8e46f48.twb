          <datasource-dependencies datasource='Parameters'>
            <column alias='% Clicked / Accepted Orders' caption='Select Metric (B)' datatype='string' name='[Select Metric (copy)_4666714443215826957]' param-domain-type='list' role='measure' type='nominal' value='&quot;clicked orders / accepted orders&quot;'>
              <calculation class='tableau' formula='&quot;clicked orders / accepted orders&quot;' />
              <aliases>
                <alias key='&quot;accepted orders&quot;' value='... # Accepted Orders' />
                <alias key='&quot;clicked delayed orders&quot;' value='... # Clicked Delayed Orders' />
