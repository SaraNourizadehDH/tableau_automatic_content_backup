            <column caption='Metric (B)' datatype='real' name='[Calculation_4666714443223658517]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Select Metric (copy)_4666714443215826957]&#10;WHEN &apos;clicked orders / accepted orders&apos; THEN [Calculation_4666714443222126607]&#10;WHEN &apos;clicked vendors / accepted vendors&apos; THEN [Calculation_4666714443222454289]&#10;WHEN &apos;clicked delayed orders / delayed orders&apos; THEN [% Clicked / Accepted Orders (copy)_675891814301392896]&#10;WHEN &apos;clicked on-time orders / on-time orders&apos; THEN [% Clicked / Delayed Orders (copy)_675891814314692611]&#10;WHEN &apos;clicks / clicked order&apos; THEN [Clicks per Accept Order (copy)_5174917450204794882]&#10;WHEN &apos;clicks / clicked vendor&apos; THEN [Calculation_4666714443222294544]&#10;//&#10;WHEN &apos;clicked orders&apos; THEN SUM([clicked_orders])&#10;WHEN &apos;clicked delayed orders&apos; THEN SUM([clicked_delayed_orders])&#10;WHEN &apos;delayed orders&apos; THEN SUM([delayed_orders])&#10;WHEN &apos;clicked on-time orders&apos; THEN [Calculation_675891814312017921]&#10;WHEN &apos;on-time orders&apos; THEN [Clicked On-time Orders (copy)_675891814312734722]&#10;WHEN &apos;accepted orders&apos; THEN SUM([accepted_orders])&#10;WHEN &apos;clicks&apos; THEN SUM([clicks])&#10;WHEN &apos;vendors clicked&apos; THEN SUM([clicked_platdorm_vendors])&#10;WHEN &apos;vendors accepted&apos; THEN SUM([accepted_platform_vendors])&#10;END' />
            </column>
