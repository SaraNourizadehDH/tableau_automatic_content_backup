            </column>
            <column caption='SKU Age' datatype='integer' name='[Parameter 3]' param-domain-type='range' role='measure' type='quantitative' value='90'>
              <calculation class='tableau' formula='90' />
              <range max='715' min='-5' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1z028g518i85hc195ajnw0vv87it'>
            <column caption='% of Slow Turners' datatype='real' name='[Calculation_2704904159602638850]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [Calculation_5629921749883879424] &lt; 1 THEN [sku] END)/COUNTD([sku])' />
            </column>
            <column caption='Assortment Efficiency' datatype='real' name='[Calculation_2704904159603363843]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-(COUNTD(IF [Calculation_5629921749884489729] &gt; 0 THEN [sku] END)/COUNTD([sku]))' />
            </column>
            <column caption='# of SKUs' datatype='integer' name='[Calculation_2704904159875198986]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([sku])' />
            </column>
            <column caption='Is Available' datatype='boolean' name='[Calculation_2704904160223404044]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [availability] &gt; 0 THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Avg Basket Size' datatype='real' name='[Calculation_272186317014470659]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [rank] = 1 THEN [qty_sold] END)/AVG([no_orders])' />
            </column>
            <column caption='Avg Basket Value' datatype='real' name='[Calculation_5330643491091763204]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5330643491094814726]/AVG([no_orders])' />
            </column>
            <column caption='GMV' datatype='real' name='[Calculation_5330643491094814726]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2] WHEN &apos;Euro&apos; &#10;THEN SUM(IF [rank] = 1 THEN [total_price_paid_eur] END)&#10;ELSE SUM(IF [rank] = 1 THEN [total_price_paid_lc] END) END' />
            </column>
            <column caption='Avg Velocity' datatype='real' name='[Calculation_5629921749883879424]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [sku], [month], [global_entity_id]: SUM([Calculation_5629921749891842051])/COUNTD([week])}' />
            </column>
            <column caption='# of 0 Velocity' datatype='integer' name='[Calculation_5629921749884489729]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [sku], [month], [global_entity_id]: SUM(IF [units_velocity_kpi] = 0 THEN 1 &#10;ELSEIF [units_velocity_kpi] &gt; 0 THEN 0 END)}' />
            </column>
            <column caption='Unit Velocity' datatype='real' name='[Calculation_5629921749891842051]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([units_velocity_kpi])' />
            </column>
            <column caption='Included SKUs (without Availability) ' datatype='string' name='[Included (with Availability) (copy)_2704904159602532353]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [month] = [Parameters].[Parameter 1] AND [sku_age] &gt;= [Parameters].[Parameter 3] AND [availability] &gt; 0 THEN [sku] END' />
            </column>
            <column caption='Included (without Availability)' datatype='boolean' name='[Included (with Availability) (copy)_2704904159930691595]' role='dimension' type='nominal'>
