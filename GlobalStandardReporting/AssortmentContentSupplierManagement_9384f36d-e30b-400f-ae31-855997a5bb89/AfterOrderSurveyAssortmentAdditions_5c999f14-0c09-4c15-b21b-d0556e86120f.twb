            <column-instance column='[l1_master_category]' derivation='None' name='[none:l1_master_category:nk]' pivot='key' type='nominal' />
            <column-instance column='[region]' derivation='None' name='[none:region:nk]' pivot='key' type='nominal' />
            <column-instance column='[survey_start_date]' derivation='None' name='[none:survey_start_date:qk]' pivot='key' type='quantitative' />
            <column caption='Region' datatype='string' name='[region]' role='dimension' type='nominal' />
            <column caption='Response Id' datatype='string' name='[response_id]' role='dimension' type='nominal' />
            <column caption='Survey Start Date' datatype='date' name='[survey_start_date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_78883372321718273]' derivation='User' name='[usr:Calculation_78883372321718273:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0x5jj4i07qvjas10h91r50zpb2k6].[User Filter 1]' context='true' />
          <filter class='categorical' column='[federated.0x5jj4i07qvjas10h91r50zpb2k6].[none:Calculation_134122846303260672:nk]'>
            <groupfilter function='except' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
