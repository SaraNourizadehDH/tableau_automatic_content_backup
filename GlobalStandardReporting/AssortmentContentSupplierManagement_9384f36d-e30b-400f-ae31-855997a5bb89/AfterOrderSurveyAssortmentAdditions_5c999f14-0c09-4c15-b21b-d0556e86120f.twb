    <worksheet name='2.1 L1 Categories'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Responses per L1 Category*</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='8'>*A single response can be assigned to multiple categories</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='_tableau_qc_qualtrics_data (cl_data_science_qcommerce)' name='federated.0x5jj4i07qvjas10h91r50zpb2k6' />
          </datasources>
          <datasource-dependencies datasource='federated.0x5jj4i07qvjas10h91r50zpb2k6'>
            <column caption='L2 Category' datatype='string' name='[Calculation_134122846303260672]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [l1_master_category] =&quot;Dairy / Chilled / Eggs&quot;&#10;AND [l2_master_category] IN (&quot;Dairy / Eggs&quot;, &quot;Deli / Snacking&quot;, &quot;Milk&quot;, &quot;Ready Meals&quot;)&#10;THEN [l2_master_category]&#10;ELSEIF &#10;[l1_master_category] IN (&quot;Beverage&quot;, &quot;Beverages&quot;)&#10;AND [l2_master_category] IN (&quot;Juice / Ice Tea / Sports / Energy&quot;, &quot;Soft Drinks / Mixers&quot;, &quot;Specialty&quot;, &quot;Water&quot;, &quot;Soft Drinks &amp; Mixers&quot;)&#10;THEN [l2_master_category] &#10;ELSEIF &#10;[l1_master_category] IN (&quot;Bread / Bakery&quot;)&#10;AND [l2_master_category] IN (&quot;Bread&quot;, &quot;Sweet Bakery&quot;)&#10;THEN [l2_master_category] &#10;ELSEIF &#10;[l1_master_category] IN (&quot;Bws&quot;)&#10;AND [l2_master_category] IN (&quot;Beer / Cider&quot;, &quot;Pre-Mixed&quot;, &quot;Spirits&quot;, &quot;Wine / Sparkling Wine&quot;)&#10;THEN [l2_master_category] &#10;ELSEIF &#10;[l1_master_category] IN (&quot;Frozen&quot;)&#10;AND [l2_master_category] IN (&quot;Frozen Convenience / Bakery&quot;, &quot;Frozen Fruit / Vegetables / Potato&quot;, &quot;Frozen Meat / Seafood&quot;, &quot;Ice&quot;, &quot;Ice Cream / Desserts&quot;)&#10;THEN [l2_master_category] &#10;ELSEIF &#10;[l1_master_category] IN (&quot;General Merchandise&quot;)&#10;AND [l2_master_category] IN (&quot;Apparel / Footwear / Sports Equipment&quot;,&quot;Books / Magazines&quot;,&quot;Electronics&quot;,&quot;Toys&quot;)&#10;THEN [l2_master_category] &#10;ELSEIF &#10;[l1_master_category] IN (&quot;Home / Pet&quot;)&#10;AND [l2_master_category] IN (&quot;Seasonal / Occasion&quot;,&quot;Pet&quot;,&quot;Household&quot;,&quot;Hardware / Misc&quot;,&quot;Disposables&quot;,&quot;Cleaning / Laundry&quot;)&#10;THEN [l2_master_category] &#10;ELSEIF &#10;[l1_master_category] IN (&quot;Meat / Seafood&quot;)&#10;AND [l2_master_category] IN (&quot;Fish / Seafood&quot;, &quot;Meat&quot;, &quot;Poultry&quot;)&#10;THEN [l2_master_category] &#10;ELSEIF &#10;[l1_master_category] IN (&quot;Packaged Foods&quot;)&#10;AND [l2_master_category] IN (&quot;Breakfast / Spreads&quot;, &quot;Canned / Jarred / Instant Meals&quot;,&quot;Cooking / Condiments / Baking / Herbs / Spices&quot;,&quot;Desserts&quot;,&quot;Pasta / Rice / Grains&quot;,&quot;Special Diet&quot;, &quot;Tea / Coffee&quot;)&#10;THEN [l2_master_category] &#10;ELSEIF &#10;[l1_master_category] IN (&quot;Personal Care / Baby / Health&quot;)&#10;AND [l2_master_category] IN (&quot;Baby&quot;, &quot;Health&quot;,&quot;Personal Care / Beauty&quot;)&#10;THEN [l2_master_category] &#10;ELSEIF &#10;[l1_master_category] IN (&quot;Produce&quot;)&#10;AND [l2_master_category] IN (&quot;Fruit&quot;,&quot;Prepared F&amp;V / Fresh Herbs&quot;,&quot;Vegetables&quot;)&#10;THEN [l2_master_category] &#10;ELSEIF &#10;[l1_master_category] IN (&quot;Ready To Consume&quot;)&#10;AND [l2_master_category] IN (&quot;Beverages&quot;,&quot;Food&quot;)&#10;THEN [l2_master_category] &#10;ELSEIF &#10;[l1_master_category] IN (&quot;Smoking / Tobacco&quot;)&#10;AND [l2_master_category] IN (&quot;E-Cigarettes / Accessories&quot;,&quot;Herbals / Cannabis / Accessories&quot;,&quot;Smoking Accessories&quot;,&quot;Tobacco&quot;)&#10;THEN [l2_master_category] &#10;ELSEIF &#10;[l1_master_category] IN (&quot;Snacks&quot;)&#10;AND [l2_master_category] IN (&quot;Confectionary&quot;,&quot;Other Snacks&quot;,&quot;Salty Snacks&quot;)&#10;THEN [l2_master_category] &#10;&#10;ELSE NULL END' />
            </column>
            <column caption='SUM Responses' datatype='integer' name='[Calculation_78883372321718273]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNt([response_id])' />
            </column>
            <column caption='Did you find all the products you were looking for?' datatype='string' name='[find_what_looking_for]' role='dimension' type='nominal' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='L1 Master Category' datatype='string' name='[l1_master_category]' role='dimension' type='nominal' />
            <column caption='L2 Master Category' datatype='string' name='[l2_master_category]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_134122846303260672]' derivation='None' name='[none:Calculation_134122846303260672:nk]' pivot='key' type='nominal' />
