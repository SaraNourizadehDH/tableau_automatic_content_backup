    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Desc. &amp; Introduction'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/LocalShopsContentScoring-Vendor/Desc_Introduction?rev=' id='Desc_Introduction' path='/t/GlobalStandardReporting/workbooks/LocalShopsContentScoring-Vendor' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='table'>
          <format attr='background-color' value='#666666' />
        </style-rule>
      </style>
      <size maxheight='1000' maxwidth='1566' minheight='1000' minwidth='1566' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98400' id='68' layout-strategy-id='distribute-evenly' param='vert' type-v2='layout-flow' w='98978' x='511' y='800'>
            <zone forceUpdate='true' h='98400' id='51' type-v2='text' w='98978' x='511' y='800'>
              <formatted-text>
                <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Tableau Medium' fontsize='20' underline='true'>Introduction</run>
                <run>Æ&#10;</run>
                <run fontcolor='#ffffff' fontname='Tableau Medium' fontsize='10'>Content Completeness dashboard shows the completeness and quality measurement of each SKU based on some product attributes such as Title, Brand name, Barcode, Volumetrics etc. One of the main purposes of this dashboard is to enable content managers and other stakeholders in taking actions for the improvement of overall content score.</run>
                <run>Æ&#10;</run>
                <run fontcolor='#ffffff' fontname='Tableau Medium' fontsize='10'>The scores are weekly updated every Saturday.</run>
                <run>Æ&#10;</run>
                <run fontcolor='#ffffff' fontname='Tableau Medium' fontsize='10'>Confluence page </run>
                <run fontcolor='#4996b2' fontname='Tableau Medium' fontsize='10' hyperlink='tabdoc:load-url url=&amp;quot;https://confluence.deliveryhero.com/display/DINV/Content+Completeness+Tableau+Dashboard+V2&amp;quot;'>LINK</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#ffffff' fontname='Tableau Medium' fontsize='10'>Please note that this dashboard must be used for weekly/vendor granulatiry!!! For different aggregations please refer to </run>
                <run bold='true' fontcolor='#4996b2' fontname='Tableau Medium' fontsize='10' hyperlink='tabdoc:load-url url=&amp;quot;https://tableau.deliveryhero.net/#/site/GlobalStandardReporting/workbooks/28615/views&amp;quot;'>[QCLS] Local Shops Content Vendor Performance</run>
                <run bold='true' fontcolor='#ffffff' fontname='Tableau Medium' fontsize='10'>Æ </run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run fontcolor='#ffffff' fontname='Tableau Medium' fontsize='10'>Below are the description for each dashboard pages :</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#ffffff' fontname='Tableau Medium' fontsize='15' underline='true'>Historical view Scores and Subscores</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run fontcolor='#ffffff' fontname='Tableau Medium' fontsize='10'>This page shows the Content Score with its Completeness and Quality score change with time in a tabular format. </run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#ffffff' fontname='Tableau Medium' fontsize='14' underline='true'>SKU Level Scores</run>
                <run>Æ&#10;</run>
                <run fontcolor='#ffffff' fontname='Tableau Medium' fontsize='10'>This Page shows the SKU level data with all scores associated with it in a tabular form. There are no dimensions used in this view. Usage of filters is the same as described in the previous two dashboard descriptions.</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#ffffff' fontname='Tableau Medium' fontsize='10' underline='true'>Note</run>
                <run fontcolor='#ffffff' fontname='Tableau Medium' fontsize='10'>: User must filter and select only one country at a time to see the all SKUs with their scores and subscores. </run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
                <format attr='background-color' value='#666666' />
              </zone-style>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
