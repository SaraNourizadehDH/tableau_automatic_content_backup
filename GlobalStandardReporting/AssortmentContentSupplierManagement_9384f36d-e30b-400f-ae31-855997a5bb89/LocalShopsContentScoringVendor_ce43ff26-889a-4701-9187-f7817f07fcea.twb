      <column caption='Avg. Completeness Score Brand Owner [H]  ' datatype='real' name='[Avg. Completeness Score Brand Name [H]]  (copy)_2348556857056178177]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;Global&apos; THEN  AVG([global_completeness_score_brand_owner])&#10;WHEN &apos;Region&apos; THEN AVG([region_completeness_score_brand_owner])&#10;WHEN &apos;Country&apos; THEN AVG([country_completeness_score_brand_owner])&#10;WHEN &apos;Global - Product Type&apos; THEN AVG([prod_type_completeness_score_brand_owner])&#10;WHEN &apos;Country - Product Type&apos; THEN AVG([country_product_completeness_score_brand_owner])&#10;// ELSE [Total Cust Count (vendor level)]&#10;END' />
      </column>
      <column caption='Avg. Completeness Score Aggregated [H] ' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg. Content Score Aggregated (copy)_3225210657190416385]' role='measure' type='quantitative'>
