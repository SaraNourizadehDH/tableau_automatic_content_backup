    <worksheet name='Table (2)'>
      <table>
        <view>
          <datasources>
            <datasource caption='_tableau_optimization_scores_rationalizer' name='federated.010rk66132xq971f6gqq80zez27o' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Euro&quot;'>
              <calculation class='tableau' formula='&quot;Euro&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.010rk66132xq971f6gqq80zez27o'>
            <column caption='% Spoilage' datatype='real' name='[Calculation_1106267090097602560]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([shrinkage_eur_expired])/SUM([gmv_eur])' />
            </column>
            <column caption='Days on Hand' datatype='real' name='[Calculation_1106267090097795073]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([book_value])/SUM([cogs_eur])' />
            </column>
            <column caption='GMV' datatype='real' name='[Calculation_150026164713431040]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2] WHEN &apos;Euro&apos; THEN [gmv_eur] ELSE [gmv_lc] END' />
            </column>
            <column caption='Avg Sales Price' datatype='real' name='[Calculation_155233515939696643]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2] WHEN &apos;Euro&apos; THEN [avg_price_eur] ELSE [avg_price_lc] END' />
            </column>
            <column caption='[SKU] Business Importance ' datatype='real' name='[Calculation_1776036737244864512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [global_entity_id], [sku]: SUM(([business_kpi]/[Calculation_827043916911169536])*100) }' />
            </column>
            <column caption='[SKU] Customer Importance' datatype='real' name='[Calculation_1776036737245331457]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [global_entity_id],[sku]: SUM(([sku_category3_trips_fraction_basket]/[Max Cat 3 Trip Fraction (copy)_827043916913201163])*100 )}' />
            </column>
            <column caption='[SUPPLIER] MAX Business' datatype='real' name='[Calculation_1776036737246195714]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [global_entity_id], [supplier_name]: MAX([Calculation_1776036737244864512])}' />
            </column>
            <column caption='Supplier Importance to Revenue' datatype='real' name='[Calculation_1776036737246408707]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1776036737244864512]/[Calculation_1776036737246195714]' />
            </column>
            <column caption='Filter SKU Days in Assortment' datatype='boolean' name='[Calculation_1898900564591628288]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF {FIXED [global_entity_id],[sku]: SUM([SKU_age])} &gt;=90&#10;THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Filter SKU Availability' datatype='boolean' name='[Calculation_1898900564592291842]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF {FIXED [global_entity_id],[sku]: SUM([availability])} &lt;=1&#10;THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Filter SKU Importance to Business' datatype='boolean' name='[Calculation_1898900564592836611]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF {FIXED [global_entity_id],[sku]: SUM([Calculation_1776036737244864512])} &lt;= 100&#10;THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Filter SKU Importance to Customers' datatype='boolean' name='[Calculation_1898900564593713156]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF {FIXED [global_entity_id],[sku]: SUM([Calculation_1776036737245331457])} &lt;= 100&#10;THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='[SUPPLIER] MAX Customer' datatype='real' name='[Calculation_1898900564595908614]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [global_entity_id], [supplier_name]: MAX([Calculation_1776036737245331457])}' />
            </column>
            <column caption='Supplier Importance to Customer' datatype='real' name='[Calculation_1898900564596101127]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1776036737245331457]/[Calculation_1898900564595908614]' />
            </column>
            <column caption='Supplier Combined Importance' datatype='real' name='[Calculation_1898900564596326408]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(0.5*[Calculation_1898900564596101127]) + (0.5*[Calculation_1776036737246408707])' />
            </column>
            <column caption='#SKU' datatype='integer' name='[Calculation_1898900564597399562]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([sku])' />
            </column>
            <column caption='Front Margin %' datatype='real' name='[Calculation_2980186753056079875]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(zn([total_sku_sales_eur_l6Mon]) - zn([cogs_eur]))/zn([total_sku_sales_eur_l6Mon])' />
            </column>
            <column caption='Total Listing Index' datatype='real' name='[Calculation_5905274644857675776]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[no_stores]/[no_all_stores]' />
            </column>
            <column caption='On Hand Quantity' datatype='real' name='[Calculation_7764839142388641792]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[on_hand_qty]/[total_days]' />
            </column>
            <column caption='Max Business Risk Score (L1)' datatype='real' name='[Calculation_827043916911169536]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], [category_level_one]: MAX([business_kpi]) }' />
            </column>
            <column caption='Max Cat 3 Trip Fraction Basket' datatype='real' name='[Max Cat 3 Trip Fraction (copy)_827043916913201163]' role='measure' type='quantitative'>
