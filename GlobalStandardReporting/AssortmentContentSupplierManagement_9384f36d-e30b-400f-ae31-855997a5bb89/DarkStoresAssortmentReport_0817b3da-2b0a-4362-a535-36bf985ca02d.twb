      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1gyrt2o0ztgctg10k3kn915yh9v2].[pcto:usr:Calculation_7012245425761312776:qk]&quot;' value='% of Total Earnings' />
          <alias key='&quot;[federated.1gyrt2o0ztgctg10k3kn915yh9v2].[pcto:usr:Est. GMV [€]] (copy)_807129516128673795:qk]&quot;' value='% of Total GMV' />
          <alias key='&quot;[federated.1gyrt2o0ztgctg10k3kn915yh9v2].[sum:Total Price Paid (copy)_1121396341922156546:qk]&quot;' value='Net Retail Revenue' />
          <alias key='&quot;[federated.1gyrt2o0ztgctg10k3kn915yh9v2].[sum:total_price_paid_eur:qk]&quot;' value='GMV EUR' />
          <alias key='&quot;[federated.1gyrt2o0ztgctg10k3kn915yh9v2].[sum:total_price_paid_net_eur:qk]&quot;' value='Net Retail Revenue EUR' />
        </aliases>
      </column>
      <column caption='Total Price Paid' datatype='real' name='[Calculation_1121396341921996801]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4] WHEN &apos;EUR&apos; THEN [total_price_paid_eur]&#10;ELSE [total_price_paid_lc] END' />
      </column>
      <column caption='Main-Category' datatype='string' name='[Calculation_3224225516229697536]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 5]&#10;when 1 then [reporting_category_parent]&#10;when 2 then [category_parent]&#10;end' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_3511963345652142080]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]= USERNAME()' />
      </column>
      <column caption='Row Number' datatype='integer' name='[Calculation_3730106393909723137]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='index()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='COGS' datatype='real' default-format='c#,##0.00&quot; €&quot;;-#,##0.00&quot; €&quot;' name='[Calculation_4429712485888225285]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4] WHEN &apos;EUR&apos; THEN SUM([cogs_eur])&#10;ELSE SUM([cogs_lc]) END' />
      </column>
      <column caption='Front Margin' datatype='real' name='[Calculation_7012245425737400321]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Total Price Paid (copy)_1121396341922156546]) - ([Calculation_4429712485888225285])) / SUM([Total Price Paid (copy)_1121396341922156546])' />
      </column>
      <column caption='Store Count' datatype='integer' name='[Calculation_7012245425739448322]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='{EXCLUDE [supplier_name]: COUNTD([warehouse_name])}' />
      </column>
      <column caption='ASP' datatype='real' name='[Calculation_7012245425753214979]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1121396341921996801]) / SUM([qty_sold])' />
      </column>
      <column caption='SKU Count' datatype='integer' name='[Calculation_7012245425757691909]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='COUNTD([sku])' />
      </column>
      <column caption='Front Margin Category' datatype='real' name='[Calculation_7012245425759248391]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Total Price Paid (copy)_1121396341922156546]) - ([Calculation_4429712485888225285])) / SUM([Total Price Paid (copy)_1121396341922156546])' />
      </column>
      <column caption='Earnings' datatype='real' name='[Calculation_7012245425761312776]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_7012245425759248391] * SUM([Total Price Paid (copy)_1121396341922156546])' />
      </column>
      <column caption='Basket Penetration' datatype='real' default-format='p0.00%' name='[Calculation_7012245425761734665]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders]) / SUM({EXCLUDE [category_parent], [category]:SUM([orders])})' />
      </column>
      <column caption='SKU Contribution' datatype='real' default-format='p0.00%' name='[Calculation_7012245425762324490]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([sku]) / SUM({EXCLUDE [category_parent], [category]: COUNTD([sku])})' />
      </column>
      <column caption='Sales Contribution' datatype='real' default-format='p0.00%' name='[Calculation_7012245425767596043]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_price_paid_eur]) / SUM({EXCLUDE [category_parent], [category]:SUM([total_price_paid_eur])})' />
      </column>
      <column caption='Qty Contribution' datatype='real' default-format='p0.00%' name='[Calculation_7012245425767833612]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([qty_sold]) / SUM({EXCLUDE [category_parent], [category]:SUM([qty_sold])})' />
      </column>
      <column caption='Est. Gross Margin' datatype='real' default-format='p0.00%' name='[Calculation_92464575008985095]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Est. GMV [€]] (copy)_807129516128673795] - ([Calculation_4429712485888225285])) / [Est. GMV [€]] (copy)_807129516128673795]' />
      </column>
      <column caption='SKUs per Store' datatype='real' name='[Calculation_999799135840112640]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG({FIXED [warehouse_name], [Calculation_3224225516229697536]: COUNTD([sku])})' />
      </column>
      <column caption='Date' datatype='datetime' name='[Calculation_999799135843692546]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC([Parameters].[Parameter 1], [order_date], &apos;monday&apos;)' />
      </column>
      <column caption='Items Sold (last 7d)' datatype='real' name='[Calculation_999799135874715653]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [order_date] &lt;= TODAY() - 1 AND [order_date] &gt;= TODAY() - 8 THEN [qty_sold] ELSE 0 END' />
      </column>
      <column caption='GMV' datatype='real' default-format='c&quot;€ &quot;#,##0.00;-&quot;€ &quot;#,##0.00' name='[Est. GMV [€]] (copy)_807129516128673795]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1121396341921996801])' />
      </column>
      <column caption='Items Sold (last 14d)' datatype='real' name='[Items Sold (last 30d) (copy)_999799135875022855]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [order_date] &lt;= TODAY() - 1 AND [order_date] &gt;= TODAY() - (1 + 14) THEN [qty_sold] ELSE 0 END' />
      </column>
      <column caption='Items Sold (last 30d)' datatype='real' name='[Items Sold (last 7d) (copy)_999799135874949126]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [order_date] &lt;= TODAY() - 1 AND [order_date] &gt;= TODAY() - (1 + 30) THEN [qty_sold] ELSE 0 END' />
      </column>
      <column caption='Sub-Category' datatype='string' name='[Main-Category (copy)_3224225516229857281]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 5]&#10;when 1 then [reporting_category]&#10;when 2 then [category]&#10;end' />
      </column>
      <column caption='Total Price Paid Net' datatype='real' name='[Total Price Paid (copy)_1121396341922156546]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4] WHEN &apos;EUR&apos; THEN [total_price_paid_net_eur]&#10;ELSE [total_price_paid_net_lc] END' />
