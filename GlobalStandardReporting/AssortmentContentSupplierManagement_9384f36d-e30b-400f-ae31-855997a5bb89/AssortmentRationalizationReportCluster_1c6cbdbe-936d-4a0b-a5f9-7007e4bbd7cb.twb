    <dashboard name='Tabular View'>
      <repository-location derived-from='http://ip-172-31-0-134:8463/t/GlobalStandardReporting/workbooks/WIPAssortmentRationalizationReportCluster/TabularView?rev=' id='TabularView' path='/t/GlobalStandardReporting/workbooks/WIPAssortmentRationalizationReportCluster' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='900' maxwidth='1500' minheight='900' minwidth='1500' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='_tableau_cluster_sku_optimization_scores' name='federated.010rk66132xq971f6gqq80zez27o' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Currency' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Euro&quot;'>
          <calculation class='tableau' formula='&quot;Euro&quot;' />
          <members>
            <member value='&quot;Euro&quot;' />
            <member value='&quot;Local Currency&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.010rk66132xq971f6gqq80zez27o'>
        <column caption='Combined Score (B1+C3B)' datatype='real' name='[Calculation_155233515938582529]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='(0.5*[Calculation_827043916911669251]) + (0.5*[Customer Risk Score (L3) (copy)_827043916914118676])' />
        </column>
        <column caption='Business Risk Score (L1)' datatype='real' name='[Calculation_827043916911669251]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='([business_kpi]/[Calculation_827043916911169536])*100' />
        </column>
        <column caption='Customer Risk Score (L3-Basket)' datatype='real' name='[Customer Risk Score (L3) (copy)_827043916914118676]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='([sku_category3_trips_fraction_basket]/[Max Cat 3 Trip Fraction (copy)_827043916913201163])*100' />
        </column>
        <column caption='Days in Assortment' datatype='integer' name='[SKU_age]' role='measure' type='quantitative' />
        <column caption='Availability' datatype='real' default-format='p0.0%' name='[availability]' role='measure' type='quantitative' />
        <column caption='Brand Name' datatype='string' name='[brand_name]' role='dimension' type='nominal' />
        <column caption='Category Level 1' datatype='string' name='[category_level_one]' role='dimension' type='nominal' />
        <column caption='Category Level 3' datatype='string' name='[category_level_three]' role='dimension' type='nominal' />
        <column caption='Category Level 2' datatype='string' name='[category_level_two]' role='dimension' type='nominal' />
        <column caption='Cluster Name' datatype='string' name='[cluster_name]' role='dimension' type='nominal' />
        <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
        <column caption='Item Type' datatype='string' name='[item_type]' role='dimension' type='nominal' />
        <column-instance column='[SKU_age]' derivation='None' name='[none:SKU_age:qk]' pivot='key' type='quantitative' />
        <column-instance column='[brand_name]' derivation='None' name='[none:brand_name:nk]' pivot='key' type='nominal' />
        <column-instance column='[category_level_one]' derivation='None' name='[none:category_level_one:nk]' pivot='key' type='nominal' />
        <column-instance column='[category_level_three]' derivation='None' name='[none:category_level_three:nk]' pivot='key' type='nominal' />
        <column-instance column='[category_level_two]' derivation='None' name='[none:category_level_two:nk]' pivot='key' type='nominal' />
        <column-instance column='[cluster_name]' derivation='None' name='[none:cluster_name:nk]' pivot='key' type='nominal' />
        <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
        <column-instance column='[item_type]' derivation='None' name='[none:item_type:nk]' pivot='key' type='nominal' />
        <column-instance column='[sku]' derivation='None' name='[none:sku:nk]' pivot='key' type='nominal' />
