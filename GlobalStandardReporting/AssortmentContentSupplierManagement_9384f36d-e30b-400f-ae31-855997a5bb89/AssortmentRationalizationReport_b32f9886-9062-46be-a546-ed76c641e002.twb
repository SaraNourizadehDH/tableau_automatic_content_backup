    <dashboard name='KPI Definitions'>
      <repository-location derived-from='http://ip-172-31-0-83:8292/t/GlobalStandardReporting/workbooks/SKUOptimizationWIP_16251254177330/KPIDefinitions?rev=' id='KPIDefinitions' path='/t/GlobalStandardReporting/workbooks/SKUOptimizationWIP_16251254177330' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='800' maxwidth='1000' minheight='800' minwidth='1000' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='86250' id='3' param='vert' type-v2='layout-flow' w='98400' x='800' y='12750'>
            <zone forceUpdate='true' h='84250' id='11' type-v2='text' w='98400' x='800' y='12750'>
              <formatted-text>
                <run bold='true' fontcolor='#000000' fontsize='10'>Importance to Business</run>
                <run fontcolor='#000000' fontsize='10'>: 0.5 * Unit Velocity + 0.5 * Sales Velocity</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='10'>Where </run>
                <run bold='true' fontcolor='#000000' fontsize='10'>Unit Velocity</run>
                <run fontcolor='#000000' fontsize='10'> is units sold per store per week for a specific product</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='10'> and </run>
                <run bold='true' fontcolor='#000000' fontsize='10'>Sales Velocity</run>
                <run fontcolor='#000000' fontsize='10'> is sales amount per store per week for a specific product</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontsize='10'>Importance to Customers</run>
                <run fontcolor='#000000' fontsize='10'>: Sum of (Customer total basket count for each item / Customer basket count for the Level 3 Category) * Customer total baskets</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='10'>The sum value of each product is then divided with the max value in the product&apos;s Level 3 Category</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='10'>For more detailed exemplanation about the importances calculations please check </run>
                <run fontcolor='#4996b2' fontsize='10' hyperlink='tabdoc:load-url url=&amp;quot;https://docs.google.com/presentation/d/143kl4xPhagweBHZs0FAbt9G4QenLuBkyeIbJUFDa2K8/edit#slide=id.p&amp;quot;'>here</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontsize='10'>Availability: </run>
                <run fontcolor='#000000' fontsize='10'># of hours a product is available / # of hours</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontsize='10'>Days in Assortment</run>
                <run fontcolor='#000000' fontsize='10'>: Number of days between the first day a product is in stock to today</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontsize='10'># of Stores</run>
                <run fontcolor='#000000' fontsize='10'>: # of stores the product was sold during the period of analysis</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontsize='10'>Total Listing Index</run>
                <run fontcolor='#000000' fontsize='10'>: # of Stores product is listed / Total # of stores in the entity </run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontsize='10'>Unit Velocity:</run>
                <run fontcolor='#000000' fontsize='10'> units sold per store per week for a specific product</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontsize='10'>Avg Sales Price</run>
                <run fontcolor='#000000' fontsize='10'>: GPV / units sold</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontsize='10'>GPV</run>
                <run fontcolor='#000000' fontsize='10'>: total price paid by customers to a specific product, excluding delivery fee and vouchers</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontsize='10'>Front Margin %</run>
                <run fontcolor='#000000' fontsize='10'> : (GPV - COGS) / GPV</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontsize='10'>Days on Hand</run>
                <run fontcolor='#000000' fontsize='10'> : Book Value / COGS</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontsize='10'>On Hand Quantity</run>
                <run fontcolor='#000000' fontsize='10'>: Daily on hand quantity</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontsize='10'>% Spoilage</run>
                <run fontcolor='#000000' fontsize='10'> : Shrinkage eur / GMV eur</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='10'>Use the </run>
                <run bold='true' fontcolor='#000000' fontsize='10'>item type</run>
                <run fontcolor='#000000' fontsize='10'> filter to selected the desired item type. The recommendation is to select only </run>
                <run fontcolor='#000000' fontsize='10' underline='true'>null</run>
                <run fontcolor='#000000' fontsize='10'> and </run>
                <run fontcolor='#000000' fontsize='10' underline='true'>regular</run>
                <run fontcolor='#000000' fontsize='10'> types.</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontname='Tableau Regular'>All KPIs are calculated using data from the past 6 months</run>
                <run>Æ&#10;</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
          </zone>
          <zone forceUpdate='true' h='11750' id='5' type-v2='text' w='98400' x='800' y='1000'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontname='Tableau Semibold' fontsize='14'>KPI Definitions</run>
              <run>Æ&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
