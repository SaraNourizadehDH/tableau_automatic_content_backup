          <calculation class='tableau' formula='([business_kpi1]/[Max Business Risk Score (L2)  (copy)_827043916911525890])*100' />
        </column>
        <column caption='Customer Risk Score (L3)' datatype='real' name='[Customer Risk Score (L2) (copy)_827043916914049043]' role='measure' type='quantitative'>
