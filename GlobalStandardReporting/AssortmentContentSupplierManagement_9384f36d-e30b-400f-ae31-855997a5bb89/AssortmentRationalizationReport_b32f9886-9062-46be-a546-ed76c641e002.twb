    <worksheet name='B1 - C3B'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' underline='true'>Importance to Revenue and Customer Distribution</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='_tableau_optimization_scores_rationalizer' name='federated.010rk66132xq971f6gqq80zez27o' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Cutoff Point (Percentile)' datatype='real' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='10.'>
              <calculation class='tableau' formula='10.' />
              <range max='100.0' min='0.0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.010rk66132xq971f6gqq80zez27o'>
            <column caption='Combined Score (B1+C3B)' datatype='real' name='[Calculation_155233515938582529]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(0.5*[Calculation_827043916911669251]) + (0.5*[Customer Risk Score (L3) (copy)_827043916914118676])' />
            </column>
            <column caption='Max Business Risk Score (L1)' datatype='real' name='[Calculation_827043916911169536]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], [category_level_one]: MAX([business_kpi]) }' />
            </column>
            <column caption='Business Risk Score (L1)' datatype='real' name='[Calculation_827043916911669251]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([business_kpi]/[Calculation_827043916911169536])*100' />
            </column>
            <column caption='Customer Risk Score (L3-Basket)' datatype='real' name='[Customer Risk Score (L3) (copy)_827043916914118676]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([sku_category3_trips_fraction_basket]/[Max Cat 3 Trip Fraction (copy)_827043916913201163])*100' />
            </column>
            <column caption='Max Cat 3 Trip Fraction Basket' datatype='real' name='[Max Cat 3 Trip Fraction (copy)_827043916913201163]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], [category_level_one], [category_level_two], [category_level_three]: MAX([sku_category3_trips_fraction_basket]) }' />
            </column>
            <column caption='Days in Assortment' datatype='integer' name='[SKU_age]' role='measure' type='quantitative' />
            <column caption='Availability' datatype='real' default-format='p0.0%' name='[availability]' role='measure' type='quantitative' />
