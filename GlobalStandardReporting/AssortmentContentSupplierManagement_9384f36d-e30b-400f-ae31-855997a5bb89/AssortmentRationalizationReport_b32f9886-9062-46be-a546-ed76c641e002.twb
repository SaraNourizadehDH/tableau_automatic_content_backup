      <column caption='SKUs by Country, Category 1' datatype='integer' name='[Calculation_2071233676040642560]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [global_entity_id],[category_level_one]: COUNTD([sku])}' />
      </column>
      <column caption='Front Margin Euro' datatype='real' name='[Calculation_2980186753055137792]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_sku_sales_eur_l6Mon]) - sum([cogs_eur])' />
      </column>
      <column caption='Front Margin' datatype='real' name='[Calculation_2980186753055703042]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE  [Parameters].[Parameter 2] WHEN &apos;Euro&apos; THEN [Calculation_2980186753055137792] ELSE [Front Margin Euro (copy)_2980186753055342593] END' />
      </column>
      <column caption='Front Margin %' datatype='real' name='[Calculation_2980186753056079875]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(zn([total_sku_sales_eur_l6Mon]) - zn([cogs_eur]))/zn([total_sku_sales_eur_l6Mon])' />
