      <aliases enabled='yes' />
      <column caption='Grouping by' datatype='string' name='[Average Error (copy)_333266404786270221]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#13;&#10;WHEN &apos;Region&apos;&#13;&#10;THEN [region]&#13;&#10;WHEN &apos;Country&apos; &#13;&#10;THEN [global_entity_id]&#13;&#10;WHEN &apos;Warehouse&apos;&#13;&#10;THEN [warehouse_name]&#13;&#10;END' />
      </column>
      <column caption='Avg ReadyForPO SKUs' datatype='real' name='[Avg Blocked SKUs (copy)_1774699773310205958]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([error_readypo_skus])/SUM([Calculation_333266404434817026])' />
