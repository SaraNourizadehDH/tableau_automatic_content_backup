      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Avg Listed SKUs (copy)_333266404435070980] / TOTAL([Avg Listed SKUs (copy)_333266404435070980])'>
          <table-calc ordering-type='Rows' />
        </calculation>
