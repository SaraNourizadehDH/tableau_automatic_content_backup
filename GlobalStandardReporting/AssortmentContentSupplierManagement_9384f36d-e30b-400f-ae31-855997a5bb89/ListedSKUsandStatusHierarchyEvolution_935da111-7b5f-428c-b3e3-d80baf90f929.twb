      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/ActiveSKUsCountsandDevelopment/MetricDefinition?rev=' id='MetricDefinition' path='/t/GlobalStandardReporting/workbooks/ActiveSKUsCountsandDevelopment' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='800' maxwidth='1000' minheight='800' minwidth='1000' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='84875' id='3' type-v2='text' w='98400' x='800' y='14125'>
            <formatted-text>
              <run>Æ&#10;&#10;&#10;</run>
              <run bold='true' fontname='Tableau Semibold' fontsize='16'>Avg Listed SKU- </run>
              <run bold='true' fontname='Tableau Light' fontsize='16'>Avg of daily (Active (in catalog) - Stale SKUs)

</run>
              <run bold='true' fontname='Tableau Semibold' fontsize='16'>Stale SKUs- </run>
              <run bold='true' fontname='Tableau Light' fontsize='16'>A SKU is considered stale on a given day if 1) It hasn&apos;t had any stock in the last 30 days
2) It has no open POs or inbound store transfers</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontname='Tableau Semibold' fontsize='16'>Mature Warehouse- </run>
              <run bold='true' fontname='Tableau Light' fontsize='16'>A warehouse which has customer orders and has been operating for more than 30 days</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontname='Tableau Semibold' fontsize='16'>Non-Mature Warehouse- </run>
              <run bold='true' fontname='Tableau Light' fontsize='16'>A warehouse which has customer orders and has been operating for less than 30 days</run>
              <run>Æ

































</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
