            <column caption='Avg Retired with PO SKUs' datatype='real' name='[Avg Blocked with PO SKUs (copy)_1905022694607638535]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([error_retired_with_po_skus])/SUM([Calculation_333266404434817026])' />
            </column>
            <column caption='Avg Retired w Stock' datatype='real' name='[Avg Discontinued w SalesBuf (copy)_333266404777607176]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([error_retired_with_stock])/SUM([Calculation_333266404434817026])' />
            </column>
            <column caption='Avg Blocked SKUs' datatype='real' name='[Avg Listed SKUs (copy)_333266404777271302]' role='measure' type='quantitative'>
