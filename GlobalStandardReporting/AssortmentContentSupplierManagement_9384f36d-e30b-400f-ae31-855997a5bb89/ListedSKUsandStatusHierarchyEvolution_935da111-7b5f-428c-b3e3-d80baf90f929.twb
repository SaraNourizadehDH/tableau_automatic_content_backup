            <column caption='Avg ReadyForPO SKUs' datatype='real' name='[Avg Blocked SKUs (copy)_1774699773310205958]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([error_readypo_skus])/SUM([Calculation_333266404434817026])' />
            </column>
            <column caption='Avg Discontinued w SalesBuf' datatype='real' name='[Avg Blocked SKUs (copy)_333266404777426951]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([error_disc_with_sales_buffer])/SUM([Calculation_333266404434817026])' />
            </column>
            <column caption='Avg Discontinued with PO SKUs' datatype='real' name='[Avg Blocked with PO SKUs (copy)_1905022694607187973]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([error_discontinued_with_po_skus])/SUM([Calculation_333266404434817026])' />
