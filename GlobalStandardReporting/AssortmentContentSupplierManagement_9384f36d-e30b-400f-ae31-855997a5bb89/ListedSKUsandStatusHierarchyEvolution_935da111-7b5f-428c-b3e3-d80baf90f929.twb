          <datasource-dependencies datasource='Parameters'>
            <column alias='Retired with Stock' caption='Error Type' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Retired&quot;'>
              <calculation class='tableau' formula='&quot;Retired&quot;' />
              <aliases>
                <alias key='&quot;Discontinued&quot;' value='Discontinued with Sales Buffer' />
                <alias key='&quot;OnHold with PO&quot;' value='On Hold with PO' />
                <alias key='&quot;Ready PO&quot;' value='Ready for PO' />
                <alias key='&quot;Retired&quot;' value='Retired with Stock' />
                <alias key='&quot;Retired with PO&quot;' value='Retired with PO' />
              </aliases>
            </column>
