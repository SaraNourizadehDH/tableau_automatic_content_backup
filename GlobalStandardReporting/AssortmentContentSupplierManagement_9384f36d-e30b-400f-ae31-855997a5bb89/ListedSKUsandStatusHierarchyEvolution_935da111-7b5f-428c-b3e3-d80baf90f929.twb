            <column caption='Average Error' datatype='real' name='[Calculation_333266404784480267]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3] &#13;&#10;WHEN &apos;Discontinued&apos;&#13;&#10;THEN [Avg Blocked SKUs (copy)_333266404777426951]&#13;&#10;WHEN &apos;Retired&apos; &#13;&#10;THEN [Avg Discontinued w SalesBuf (copy)_333266404777607176]&#13;&#10;WHEN &apos;Blocked&apos;&#13;&#10;THEN [Avg Listed SKUs (copy)_333266404777271302]&#13;&#10;WHEN &apos;Ready PO&apos;&#13;&#10;THEN [Avg Blocked SKUs (copy)_1774699773310205958]&#13;&#10;WHEN &apos;Retired with PO&apos;&#13;&#10;THEN [Avg Blocked with PO SKUs (copy)_1905022694607638535]&#13;&#10;WHEN &apos;OnHold with PO&apos;&#13;&#10;THEN [Avg Blocked with PO SKUs (copy)_1905022694607503366]&#13;&#10;WHEN &apos;Discontinued with PO&apos;&#13;&#10;THEN [Avg Blocked with PO SKUs (copy)_1905022694607187973]&#13;&#10;WHEN &apos;Blocked with PO&apos;&#13;&#10;THEN [Avg to be retired with PO SKUs (copy)_1905022694606946307]&#13;&#10;END' />
