            <column caption='NPS' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_4851010131416326144]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([nps_promoters])-SUM([nps_detractors]))/SUM([total_nps_responses])*100' />
            </column>
            <column caption='Seamless Orders %' datatype='real' default-format='p0%' name='[Calculation_4851010131416801281]' role='measure' type='quantitative'>
