Select 
  ge.global_entity_id, 
  s.CREATED_DATE,
  SUM(CASE WHEN CAST(after_order_nps_score AS INT64) >> 8 THEN 1 ELSE 0 END) AS nps_promoters,
  SUM(CASE WHEN CAST(after_order_nps_score AS INT64) <<= 6 THEN 1 ELSE 0 END) AS nps_detractors,
  SUM(CASE WHEN CAST(after_order_nps_score AS INT64) IS NOT NULL THEN 1 ELSE 0 END) AS total_nps_responses,
  Count(Case when is_seamless and is_after_order_nps_response then created_date end) SeamlessOrdersSurvey,
  Count(Case when is_seamless then created_date end) SeamlessOrdersAll,
  Count(created_date) ordersAll,
  Count(Case when is_after_order_nps_response then created_date end) OrdersSurvey
From 
  fulfillment-dwh-production.curated_data_shared_gcc_service.seamless_orders s
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_central_dwh.global_entities` AS ge  
