      <date-options start-of-week='monday' />
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_84109CB3A9534E79B718D8DBC7124075'>
            <properties context=''>
              <relation connection='bigquery.1ktos0g0jezl0513kvaz411pnvyt' name='Custom SQL Query' type='text'><![CDATA[With Combined AS (
Select 
  ge.global_entity_id,
  CASE 
    WHEN v.vertical_parent = 'Food' THEN 'Restaurants'
    WHEN v.vertical_parent ='Courier' THEN 'Deliver Anything'
    WHEN v.vertical_parent IS NULL THEN 'Unknown'
    ELSE v.vertical_parent
  END as vertical_type,
  Date_trunc(s.CREATED_DATE, week) Created_date,
  IF(s.is_seamless, 'Yes', 'No') is_seamless,
  If(s.is_cancellation_logistics, 'Yes', 'No') is_cancellation_logistics,
  If(s.is_order_not_on_time, 'Yes', 'No') is_order_not_on_time,
  If(s.is_contact,'Yes', 'No') is_contact,
  If(s.is_hc_session, 'Yes', 'No') is_hc_session,
  If(s.is_after_order_nps_response, 'Yes', 'No') is_after_order_nps_response,
  SUM(CASE WHEN CAST(after_order_nps_score AS INT64) >> 8 THEN 1 ELSE 0 END) AS nps_promoters,
  SUM(CASE WHEN CAST(after_order_nps_score AS INT64) <<= 6 THEN 1 ELSE 0 END) AS nps_detractors,
  SUM(CASE WHEN CAST(after_order_nps_score AS INT64) IS NOT NULL THEN 1 ELSE 0 END) AS total_nps_responses,
  Count(created_date) orders,
From 
  fulfillment-dwh-production.curated_data_shared.seamless_orders s
LEFT JOIN fulfillment-dwh-production.curated_data_shared_coredata.global_entities AS ge  
  ON s.global_entity_id = ge.global_entity_id and ge.is_reporting_enabled
LEFT JOIN fulfillment-dwh-production.curated_data_shared_coredata_business.vendors v 
  ON s.global_entity_id = v.global_entity_id and s.vendor_id = v.vendor_id
where 
  created_date>>= '2021-01-01' and Date_trunc(s.CREATED_DATE, week) << Date_trunc(current_date, week)
GROUP BY
  1,2,3,4,5,6,7,8,9
),   

--setting up the stage for final table which will pull data from the merged dataset
verticals AS 
(
    SELECT 'Dmarts' as vertical_type
    UNION ALL SELECT 'Restaurants'
    UNION ALL SELECT 'Local Shops' 
    UNION ALL SELECT 'Deliver Anything' 
    UNION ALL SELECT 'Unknown'
),

YesNo AS 
(
SELECT "Yes" as binary
UNION ALL SELECT "No"
),

--creating a placeholder table to have all possible combinations of the columns required especially all dates
construct AS 
(
SELECT distinct
  g.global_entity_id,
  g.segment,
  g.management_entity,
  g.sub_entity,
  Date_trunc(d.iso_date, week) iso_date,
  v.vertical_type,
  yn1.binary as is_seamless,
  yn2.binary as is_cancellation_logistics,
  yn3.binary as is_order_not_on_time,
  yn4.binary as is_contact,
  yn5.binary as is_hc_session,
  yn6.binary as is_after_order_nps_response
FROM `fulfillment-dwh-production.curated_data_shared_coredata.dates` d 
CROSS JOIN verticals v 
CROSS JOIN YesNo yn1
CROSS JOIN YesNo yn2
CROSS JOIN YesNo yn3
CROSS JOIN YesNo yn4
CROSS JOIN YesNo yn5
CROSS JOIN YesNo yn6
CROSS JOIN fulfillment-dwh-production.curated_data_shared_coredata.global_entities  g
WHERE 
  d.iso_date between '2021-01-01' and CURRENT_DATE 
  AND g.is_reporting_enabled IS TRUE
)

SELECT
  c.global_entity_id,
  c.segment,
  c.management_entity,
  c.sub_entity,
  c.vertical_type,
  c.iso_date CREATED_DATE,
  c.is_seamless,
  c.is_cancellation_logistics,
  c.is_order_not_on_time,
  c.is_contact,
  c.is_hc_session,
  c.is_after_order_nps_response,
  d.nps_promoters,
  d.nps_detractors,
  d.total_nps_responses,
  d.orders
FROM Construct c
LEFT JOIN Combined d on 
  c.global_entity_id  =d.global_entity_id AND
  c.vertical_type     =d.vertical_type AND
  c.iso_date          =d.Created_date AND
  c.is_seamless       =d.is_seamless AND
  c.is_cancellation_logistics =d.is_cancellation_logistics AND
  c.is_order_not_on_time      =d.is_order_not_on_time AND
  c.is_contact        =d.is_contact  AND
  c.is_hc_session     =d.is_hc_session AND
  c.is_after_order_nps_response = d.is_after_order_nps_response
where 
  c.global_entity_id in (Select distinct global_entity_id From Combined)


/*
Select distinct is_after_order_nps_response from (
  Select 
  ge.global_entity_id,
  CASE 
    WHEN v.vertical_type = 'darkstores' THEN 'Dmarts'
    WHEN v.vertical_type IN ('restaurants', 'coffee') THEN 'Restaurants'
    WHEN v.vendor_id IS NULL THEN 'Unknown'
    ELSE 'Local Stores'
  END as vertical_type,  
  Date_trunc(s.CREATED_DATE, month) Created_date,
  IF(s.is_seamless, 'Yes', 'No') is_seamless,
  If(s.is_cancellation_logistics, 'Yes', 'No') is_cancellation_logistics,
  If(s.is_order_not_on_time, 'Yes', 'No') is_order_not_on_time,
  If(s.is_contact,'Yes', 'No') is_contact,
  If(s.is_hc_session, 'Yes', 'No') is_hc_session,
  If(s.is_after_order_nps_response, 'Yes', 'No') is_after_order_nps_response,
  SUM(CASE WHEN CAST(after_order_nps_score AS INT64) >> 8 THEN 1 ELSE 0 END) AS nps_promoters,
  SUM(CASE WHEN CAST(after_order_nps_score AS INT64) <<= 6 THEN 1 ELSE 0 END) AS nps_detractors,
  SUM(CASE WHEN CAST(after_order_nps_score AS INT64) IS NOT NULL THEN 1 ELSE 0 END) AS total_nps_responses,
  Count(created_date) orders,
From 
  fulfillment-dwh-production.curated_data_shared_gcc_service.seamless_orders s
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_central_dwh.global_entities` AS ge  
  ON s.global_entity_id = ge.global_entity_id and ge.is_reporting_enabled
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_central_dwh.vendors` v 
  ON s.global_entity_id = v.global_entity_id and s.vendor_id = v.vendor_id
where 
  created_date>>= '2021-01-01'
GROUP BY
  1,2,3,4,5,6,7,8,9
)
*/]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
