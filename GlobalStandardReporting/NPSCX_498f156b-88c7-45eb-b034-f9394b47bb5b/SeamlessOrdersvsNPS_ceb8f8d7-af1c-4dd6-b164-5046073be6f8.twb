),   

--creating a placeholder table to have all possible combinations of the columns required especially all dates
construct AS 
(
SELECT distinct
  g.global_entity_id,
  g.segment,
  g.management_entity,
  g.sub_entity,
  d.iso_date
FROM `fulfillment-dwh-production.curated_data_shared_coredata.dates` d 
CROSS JOIN `fulfillment-dwh-production.curated_data_shared_central_dwh.global_entities` g
WHERE 
  d.iso_date between '2022-01-01' and CURRENT_DATE 
  AND g.is_reporting_enabled IS TRUE
)

SELECT
  c.global_entity_id,
  c.segment,
  c.management_entity,
  c.sub_entity,
  c.iso_date CREATED_DATE,
  d.nps_promoters,
  d.nps_detractors,
  d.total_nps_responses,
  --(d.nps_promoters-d.nps_detractors)/If(d.total_nps_responses=0,Null,total_nps_responses)*100 NPS,
  d.SeamlessOrdersSurvey,
  d.OrdersSurvey,
  d.SeamlessOrdersAll,
  d.OrdersAll,
  --d.SeamlessOrdersSurvey/If(d.OrdersSurvey=0,Null,OrdersSurvey) so_percent_survey,
  --d.SeamlessOrdersAll/If(d.OrdersAll=0,Null,OrdersAll) so_percent_all,
FROM Construct c
LEFT JOIN Combined d on 
  c.global_entity_id  =d.global_entity_id AND
  c.iso_date          =d.Created_date
where 
  c.global_entity_id in (Select distinct global_entity_id From Combined)]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='NPS vs SO_percent'>
