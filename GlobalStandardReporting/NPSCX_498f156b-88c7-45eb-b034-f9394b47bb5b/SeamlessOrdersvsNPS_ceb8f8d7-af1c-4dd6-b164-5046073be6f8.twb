    <datasource caption='New version' inline='true' name='federated.1mfod8403krtee1a4cwb406wgypa' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0ncgdbg159ljg01h59oj51jvw24z'>
            <connection CATALOG='publicdata' EXECCATALOG='global-cx' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='publicdata' schema='samples' server-oauth='' username='aakash.jaiswal@deliveryhero.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0ncgdbg159ljg01h59oj51jvw24z' name='Custom SQL Query' type='text'><![CDATA[With Combined AS (
Select 
  ge.global_entity_id, 
  s.CREATED_DATE,
  SUM(CASE WHEN CAST(after_order_nps_score AS INT64) >> 8 THEN 1 ELSE 0 END) AS nps_promoters,
  SUM(CASE WHEN CAST(after_order_nps_score AS INT64) <<= 6 THEN 1 ELSE 0 END) AS nps_detractors,
  SUM(CASE WHEN CAST(after_order_nps_score AS INT64) IS NOT NULL THEN 1 ELSE 0 END) AS total_nps_responses,
  Count(Case when is_seamless and is_after_order_nps_response then created_date end) SeamlessOrdersSurvey,
  Count(Case when is_seamless then created_date end) SeamlessOrdersAll,
  Count(created_date) ordersAll,
  Count(Case when is_after_order_nps_response then created_date end) OrdersSurvey
From 
  fulfillment-dwh-production.curated_data_shared_gcc_service.seamless_orders s
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_central_dwh.global_entities` AS ge  
  ON s.global_entity_id = ge.global_entity_id and ge.is_reporting_enabled
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_coredata_business.vendors` v 
  ON s.global_entity_id = v.global_entity_id and s.vendor_id = v.vendor_id
where 
  created_date>>= '2022-01-01'
GROUP BY
  1,2
),   

--creating a placeholder table to have all possible combinations of the columns required especially all dates
construct AS 
(
SELECT distinct
  g.global_entity_id,
  g.segment,
  g.management_entity,
  g.sub_entity,
  d.iso_date
FROM `fulfillment-dwh-production.curated_data_shared_coredata.dates` d 
CROSS JOIN `fulfillment-dwh-production.curated_data_shared_central_dwh.global_entities` g
WHERE 
  d.iso_date between '2022-01-01' and CURRENT_DATE 
  AND g.is_reporting_enabled IS TRUE
)

SELECT
  c.global_entity_id,
  c.segment,
  c.management_entity,
  c.sub_entity,
  c.iso_date CREATED_DATE,
  d.nps_promoters,
  d.nps_detractors,
  d.total_nps_responses,
  --(d.nps_promoters-d.nps_detractors)/If(d.total_nps_responses=0,Null,total_nps_responses)*100 NPS,
  d.SeamlessOrdersSurvey,
  d.OrdersSurvey,
  d.SeamlessOrdersAll,
  d.OrdersAll,
  --d.SeamlessOrdersSurvey/If(d.OrdersSurvey=0,Null,OrdersSurvey) so_percent_survey,
  --d.SeamlessOrdersAll/If(d.OrdersAll=0,Null,OrdersAll) so_percent_all,
FROM Construct c
LEFT JOIN Combined d on 
  c.global_entity_id  =d.global_entity_id AND
  c.iso_date          =d.Created_date
where 
  c.global_entity_id in (Select distinct global_entity_id From Combined)]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0ncgdbg159ljg01h59oj51jvw24z' name='Custom SQL Query' type='text'><![CDATA[With Combined AS (
Select 
  ge.global_entity_id, 
  s.CREATED_DATE,
  SUM(CASE WHEN CAST(after_order_nps_score AS INT64) >> 8 THEN 1 ELSE 0 END) AS nps_promoters,
  SUM(CASE WHEN CAST(after_order_nps_score AS INT64) <<= 6 THEN 1 ELSE 0 END) AS nps_detractors,
  SUM(CASE WHEN CAST(after_order_nps_score AS INT64) IS NOT NULL THEN 1 ELSE 0 END) AS total_nps_responses,
  Count(Case when is_seamless and is_after_order_nps_response then created_date end) SeamlessOrdersSurvey,
  Count(Case when is_seamless then created_date end) SeamlessOrdersAll,
  Count(created_date) ordersAll,
  Count(Case when is_after_order_nps_response then created_date end) OrdersSurvey
From 
  fulfillment-dwh-production.curated_data_shared_gcc_service.seamless_orders s
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_central_dwh.global_entities` AS ge  
  ON s.global_entity_id = ge.global_entity_id and ge.is_reporting_enabled
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_coredata_business.vendors` v 
  ON s.global_entity_id = v.global_entity_id and s.vendor_id = v.vendor_id
where 
  created_date>>= '2022-01-01'
GROUP BY
  1,2
),   

--creating a placeholder table to have all possible combinations of the columns required especially all dates
construct AS 
(
SELECT distinct
  g.global_entity_id,
  g.segment,
  g.management_entity,
  g.sub_entity,
  d.iso_date
FROM `fulfillment-dwh-production.curated_data_shared_coredata.dates` d 
CROSS JOIN `fulfillment-dwh-production.curated_data_shared_central_dwh.global_entities` g
WHERE 
  d.iso_date between '2022-01-01' and CURRENT_DATE 
  AND g.is_reporting_enabled IS TRUE
)

SELECT
  c.global_entity_id,
  c.segment,
  c.management_entity,
  c.sub_entity,
  c.iso_date CREATED_DATE,
  d.nps_promoters,
  d.nps_detractors,
  d.total_nps_responses,
  --(d.nps_promoters-d.nps_detractors)/If(d.total_nps_responses=0,Null,total_nps_responses)*100 NPS,
  d.SeamlessOrdersSurvey,
  d.OrdersSurvey,
  d.SeamlessOrdersAll,
  d.OrdersAll,
  --d.SeamlessOrdersSurvey/If(d.OrdersSurvey=0,Null,OrdersSurvey) so_percent_survey,
  --d.SeamlessOrdersAll/If(d.OrdersAll=0,Null,OrdersAll) so_percent_all,
FROM Construct c
LEFT JOIN Combined d on 
  c.global_entity_id  =d.global_entity_id AND
  c.iso_date          =d.Created_date
where 
  c.global_entity_id in (Select distinct global_entity_id From Combined)]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
