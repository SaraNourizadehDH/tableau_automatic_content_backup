    <worksheet name='NPS Agg'>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_after_order_survey_orders_aggregated (rl_govops)' name='federated.052vsby05gpaqh13g3vyq1dgublb' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Quarterly&quot;'>
              <calculation class='tableau' formula='&quot;Quarterly&quot;' />
            </column>
            <column alias='Segment' caption='Area Granularity' datatype='string' name='[Select Date Type (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;Region&quot;'>
              <calculation class='tableau' formula='&quot;Region&quot;' />
              <aliases>
                <alias key='&quot;Display Name&quot;' value='Sub-Entity' />
                <alias key='&quot;Management Entity Group&quot;' value='Management Entity' />
                <alias key='&quot;Region&quot;' value='Segment' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.052vsby05gpaqh13g3vyq1dgublb'>
            <column caption='% Responses' datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([responses]) / SUM([total order (copy)])' />
            </column>
            <column caption='Order Weighted NPS ' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation2 (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{include [Select Date   (copy)] : ([NPS (copy)])}' />
            </column>
            <column caption='total order' datatype='integer' name='[Calculation_125537881395253250]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED  [Calculation_450359973417844737], [report_date]: sum([orders])}' />
            </column>
            <column caption='Select Date' datatype='datetime' name='[Calculation_450359973417844737]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Daily&apos; THEN [report_date]&#10;WHEN &apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;,[report_date], &quot;monday&quot;)&#10;WHEN &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;,[report_date] )&#10;WHEN &apos;Quarterly&apos; THEN DATETRUNC(&apos;quarter&apos;,[report_date] )&#10;END' />
            </column>
            <column caption='NPS' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_467107729923129347]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100*(SUM([nps_promoters]) - SUM([nps_detractors]))/SUM([responses])' />
            </column>
            <column caption='% Orders' datatype='real' default-format='p0.00%' name='[Calculation_772648852152672256]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders]) / sum([Calculation_125537881395253250])' />
            </column>
            <column caption='Order Weighted NPS' datatype='real' default-format='n#,##0;-#,##0' name='[NPS (copy)]' role='measure' type='quantitative' visual-totals='Sum'>
              <calculation class='tableau' formula='[Calculation_467107729923129347] * [Calculation_772648852152672256]' />
            </column>
            <column caption='Responses Weighted NPS' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Order Weighted NPS (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_467107729923129347] * [Calculation1]' />
            </column>
            <column caption='Select Area' datatype='string' name='[Select Date   (copy)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Select Date Type (copy)]&#10;WHEN  &apos;Region&apos; THEN [segment]&#10;WHEN &apos;Management Entity Group&apos; THEN [management_entity]&#10;WHEN &apos;Country&apos; THEN [country]&#10;WHEN &apos;Display Name&apos; THEN [sub_entity]&#10;END' />
            </column>
            <column caption='Select Date  ' datatype='string' name='[Select Date (copy)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Daily&apos; THEN STR([report_date])&#10;WHEN &apos;Weekly&apos; THEN [Year Week (copy)_3336322921262452737]&#10;WHEN &apos;Monthly&apos; THEN [Year Month (copy)_3336322921261256704]&#10;WHEN &apos;Quarterly&apos; THEN [year_quarter (copy)_3336322921262698498]&#10;END' />
            </column>
            <column caption='Year Month' datatype='string' name='[Year Month (copy)_3336322921261256704]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(YEAR([report_date])) &#10;+ IF MONTH([report_date]) &lt; 10 THEN &quot;-0&quot; ELSE &quot;-&quot; END&#10;+ STR(MONTH([report_date]))' />
            </column>
            <column caption='Year Week' datatype='string' name='[Year Week (copy)_3336322921262452737]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(STR(DATETRUNC(&quot;week&quot;, [report_date], &quot;monday&quot;)), 10)' />
            </column>
