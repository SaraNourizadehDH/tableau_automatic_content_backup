    <worksheet name='NPS vs. Basket Size'>
      <layout-options>
        <title>
          <formatted-text>
            <run>After Order - </run>
            <run fontcolor='#59a14f'>NPS </run>
            <run fontcolor='#000000'>and </run>
            <run fontcolor='#4e79a7'>Response Volume</run>
            <run fontcolor='#000000'> vs. Basket Size (€)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='nps_after_order_survey (rl_govops)' name='federated.0kut7ri0sh55es13hyfrw0gpd7tc' />
          </datasources>
          <datasource-dependencies datasource='federated.0kut7ri0sh55es13hyfrw0gpd7tc'>
            <column aggregation='None' caption='Amt Gmv Eur (bin)' datatype='integer' name='[Amt Gmv Eur (bin)]' role='dimension' type='ordinal'>
              <calculation class='bin' decimals='0' formula='[amt_gmv_eur]' peg='0' size='1' />
            </column>
            <column caption='Date' datatype='date' name='[Calculation_183521725930618880]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE([date_submitted])' />
            </column>
            <column caption='Is Voucher Used' datatype='string' name='[Calculation_432486308605546497]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [amt_voucher_eur] = 0 THEN &quot;NO&quot; ELSE &quot;YES&quot; END' />
            </column>
            <column caption='NPS' datatype='real' default-format='n#,##0' name='[Calculation_762375040862162944]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100*(COUNT(IF [nps_score] &gt; 8 THEN [nps_score]END) - COUNT(IF [nps_score] &lt; 7 THEN [nps_score] END))/COUNT([nps_score])' />
            </column>
            <column caption='nps_valid' datatype='integer' name='[Calculation_762375040867725314]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [data_type]=&quot;nps&quot; THEN [nps_score] END' />
            </column>
            <column caption='Response Volume' datatype='integer' name='[Calculation_762375040868708355]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([Calculation_762375040867725314])' />
            </column>
            <column datatype='string' name='[Device Group (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[frontend_client]' new-bin='true'>
                <bin default-name='false' value='&quot;Other Devices&quot;'>
                  <value>&quot;Null&quot;</value>
                  <value>&quot;Other&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='Amt Gmv Eur' datatype='real' name='[amt_gmv_eur]' role='measure' type='quantitative' />
            <column caption='Amt Voucher Eur' datatype='real' name='[amt_voucher_eur]' role='measure' type='quantitative' />
