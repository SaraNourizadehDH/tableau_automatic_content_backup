      <column caption='Detractors' datatype='integer' name='[Calculation_267119759740076032]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_detractor] THEN [nps_score] END' />
      </column>
      <column caption='% Detractors' datatype='real' default-format='p0%' name='[Calculation_267119759740674049]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Calculation_267119759740076032])/COUNT([nps_score])' />
      </column>
      <column caption='Love Index' datatype='real' default-format='p0%' name='[Calculation_313774271901937664]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Detractors (copy 2)])/(COUNT([Calculation_267119759740076032])+COUNT([Detractors (copy)])+COUNT([Detractors (copy 2)]))' />
      </column>
      <column caption='NPS Score' datatype='real' default-format='n#,##0' name='[Calculation_34269581806936064]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;(COUNT([Detractors (copy 2)])-COUNT([Calculation_267119759740076032]))&#10;/&#10;(COUNT([Detractors (copy 2)])+COUNT([Detractors (copy)])+COUNT([Calculation_267119759740076032]))&#10;)*100' />
      </column>
      <column caption='Percentage Detractors' datatype='real' name='[Calculation_34269581808361476]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Calculation_267119759740076032])/(COUNT([Calculation_267119759740076032])+COUNT([Detractors (copy)])+COUNT([Detractors (copy 2)]))' />
      </column>
      <column caption='Week Number' datatype='string' name='[Calculation_36802872593694720]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='str(DATEPART(&apos;year&apos;,[date_submitted]))+ &quot;-&quot;+ str(DATEPART(&apos;week&apos;,[date_submitted],&apos;Monday&apos;)-1)' />
