              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Daily&apos; THEN [report_date]&#10;WHEN &apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;,[report_date], &quot;monday&quot;)&#10;WHEN &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;,[report_date] )&#10;WHEN &apos;Quarterly&apos; THEN DATETRUNC(&apos;quarter&apos;,[report_date] )&#10;END' />
            </column>
            <column caption='NPS' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_467107729923129347]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100*(SUM([nps_promoters]) - SUM([nps_detractors]))/SUM([responses])' />
            </column>
            <column caption='Select Date  ' datatype='string' name='[Select Date (copy)]' role='dimension' type='nominal'>
