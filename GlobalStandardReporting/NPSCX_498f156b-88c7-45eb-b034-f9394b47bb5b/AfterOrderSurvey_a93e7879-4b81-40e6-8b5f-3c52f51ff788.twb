      <column caption='Responses Weighted Love Index' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Responses Weighted NPS (copy 3)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_141019006792040449] * [Calculation1]' />
