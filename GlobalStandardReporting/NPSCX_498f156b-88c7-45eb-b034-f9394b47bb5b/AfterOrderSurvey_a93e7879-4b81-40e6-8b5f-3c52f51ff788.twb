      <column caption='NPS' datatype='real' default-format='n#,##0' name='[Calculation_762375040862162944]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100*(COUNT(IF [nps_score] &gt; 8 THEN [nps_score]END) - COUNT(IF [nps_score] &lt; 7 THEN [nps_score] END))/COUNT([nps_score])' />
