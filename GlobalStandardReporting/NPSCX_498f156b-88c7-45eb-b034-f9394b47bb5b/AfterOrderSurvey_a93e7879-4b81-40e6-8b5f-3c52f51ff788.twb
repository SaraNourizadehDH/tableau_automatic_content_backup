            <column caption='Frontend Client' datatype='string' name='[frontend_client]' role='dimension' type='nominal' />
            <column caption='Is Acquisition' datatype='boolean' name='[is_acquisition]' role='dimension' type='nominal'>
              <aliases>
                <alias key='%null%' value='No Data' />
                <alias key='false' value='Re-order' />
                <alias key='true' value='Acquisition' />
