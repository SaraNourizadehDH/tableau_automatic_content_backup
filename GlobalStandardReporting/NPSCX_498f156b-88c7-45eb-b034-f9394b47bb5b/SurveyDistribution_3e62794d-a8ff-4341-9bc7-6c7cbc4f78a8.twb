          <named-connection caption='BigQuery' name='bigquery.1yyecps06jvkt31bpyi4y0owep2q'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='global-cx' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='rl_cx' server-oauth='' username='aakash.jaiswal@deliveryhero.com' workgroup-auth-mode='prompt' />
