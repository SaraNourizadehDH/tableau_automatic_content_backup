        <objects>
          <object caption='Custom SQL Query' id='_29DFBB1AD30743CDBAF606C9191FA494'>
            <properties context=''>
              <relation join='inner' type='join'>
                <clause type='join'>
                  <expression op='='>
                    <expression op='[Custom SQL Query].[global_entity_id]' />
