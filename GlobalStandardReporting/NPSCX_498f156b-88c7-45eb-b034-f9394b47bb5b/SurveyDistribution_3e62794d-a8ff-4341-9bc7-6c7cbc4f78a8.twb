                  </expression>
                </clause>
                <relation connection='bigquery.1yyecps06jvkt31bpyi4y0owep2q' name='Custom SQL Query' type='text'><![CDATA[With verticals as
(
  Select 'Dmarts' vertical
  UNION ALL SELECT 'Restaurants'
  UNION ALL SELECT 'Local Stores'
  UNION ALL SELECT 'Mix'
  UNION ALL SELECT 'Local Stores/Dmarts'
),

-- now we will create separate SQL scripts for all platforms and union all them together
APAC_Foodpanda as (
SELECT
  Concat('Asia','_','Foodpanda APAC','_',country_code,'_',vertical,'_',Cast(time as string)) as Key,
  'Asia' Region,
  'Foodpanda APAC' Platform,
  T.*
From (
  Select 
    'FP APAC - All canvas consolidated due to data issues' canvas_name,
    --step_name,
    CASE 
      WHEN instr(canvas_name,'Vertical-Non-Darkstore')>>0 THEN 'Local Stores'
      WHEN instr(canvas_name,'Restaurants')>>0 THEN 'Restaurants'
      Else 'Dmarts'
    END vertical,
    Right(Left(step_name,9),2) country_code,
    date_trunc(reporting_date, month) time,
    Sum(sent) sent,
    Sum(impressions) impressions,
    Sum(total_opens) total_opens,
    Sum(second_button_clicks) second_button_clicks
  FROM 
    fulfillment-dwh-production.curated_data_shared_mkt.braze_aggregated_statistics_canvas_steps
  where 
    reporting_date >>='2021-01-01' and
    canvas_name in (
    '2009XX_APAC_FP_NPS_Vertical-Non-Darkstore-NPS_AfterOrderNPS_Canvas',
    '2009XX_APAC_FP_EG_Vertical-Non-Darkstore-NPS_AfterOrderNPS_Canvas',
    '2008XX_APAC_FP_NPS_Vertical-NPS_AfterOrderNPS_Canvas',
    '2008XX_APAC_FP_NPS_Resturants-NPS_AfterOrderNPS_Canvas',
    '2008XX_APAC_FP_NPS_Restaurants-NPS_AfterOrderNPS_Canvas',
    '2008XX_APAC_FP_EG_Vertical-NPS_AfterOrderNPS_Canvas',
    '2008XX_APAC_FP_EG_Restaurants-NPS_AfterOrderNPS_Canvas'
    ) and 
    step_name not in ('inappClicked_Verticals','Control','inappClicked_Restaurants')
  Group by 1,2,3,4
) T
WHERE country_code not in ('JP')
),

MENA_Yemeksepeti As(
Select 
  Concat(Region,'_',Platform,'_',country_code,'_',vertical,'_',Cast(time as string)) as Key, 
  *
From(
  Select 
    'MENA' Region,
    'Yemeksepeti' Platform,  
    canvas_name,
    --step_name,
    'Restaurants' vertical,
    'TR' country_code,
    date_trunc(reporting_date, month) time,
    Sum(sent) sent,
    Sum(impressions) impressions,
    Sum(total_opens) total_opens,
    Sum(second_button_clicks) second_button_clicks
  FROM 
    fulfillment-dwh-production.curated_data_shared_mkt.braze_aggregated_statistics_canvas_steps
  where 
    reporting_date >>='2021-01-01' and
    canvas_name in (
      'MIX_AUT_2204XX_TR_YS_EG_RestaurantAfterOrderNPS_Brand_Canvas',
      'EAT_AUT_2212XX_TR_YS_RestaurantAfterOrderNPS_Brand_Canvas'
    )
  Group by 1,2,3,4,5,6
) T
),

MENA_Banabi AS(
Select 
  Concat(Region,'_',Platform,'_',country_code,'_',vertical,'_',Cast(time as string)) as Key, 
  *
From(
  SELECT
    'MENA' Region,  
    'Yemeksepeti' Platform,  
    'Banabi - All campaigns consolidated due to data issues' as canvas_name,
    --'Banabi - Not Applicable as data pulled from campaign' step_name,
    'Dmarts' vertical,
    'TR' country_code,
    date_trunc(reporting_date, month) time, 
    Sum(sent) sent,
    Sum(impressions) impressions,
    Sum(total_opens) total_opens,
    Sum(second_button_clicks) second_button_clicks
  FROM 
    `fulfillment-dwh-production.curated_data_shared_mkt.braze_aggregated_statistics_campaign_statistics`
  where 
      reporting_date >>='2021-01-01' and
      lower(campaign_name) like '%nps%' and lower(campaign_name) like '%banabi%' and 
      lower(campaign_name) like '%dma%' and lower(campaign_name) not like '%copy%'
  Group by 1,2,3,4,5,6
) T
),

MENA_Talabat As(
Select 
  Concat(Region,'_',Platform,'_',country_code,'_',vertical,'_',Cast(time as string)) as Key, 
  *
From(
  Select 
    'MENA' Region,
    'Talabat' Platform,  
    'Talabat - All campaigns consolidated due to data issues' canvas_name,
    --step_name,
    'Mix' vertical,
    Right(Left(step_name,16),2) country_code,
    date_trunc(reporting_date, month) time,
    Sum(sent) sent,
    Sum(impressions) impressions,
    Sum(total_opens) total_opens,
    Sum(second_button_clicks) second_button_clicks
  FROM 
    fulfillment-dwh-production.curated_data_shared_mkt.braze_aggregated_statistics_canvas_steps
  where 
    reporting_date >>='2021-01-01' and
    canvas_name in (
      'MIX_AU_2107XX_GL_TAL_NPS_NPS-CX-AO-Survey_brand_Canvas',
      'MIX_AU_2209XX_GL_TAL_NPS_NPS-CX-AO-Survey_brand_Canvas'
    )
    and step_name <<>> 'inapp-Survey-Clicked_Restaurants'
  Group by 1,2,3,4,5,6
) T
where not (sent=0 and impressions=0 and total_opens=0 and second_button_clicks=0)
),

MENA_HS As(
Select 
  Concat(Region,'_',Platform,'_',country_code,'_',vertical,'_',Cast(time as string)) as Key, 
  *
From(
  Select 
    'MENA' Region,
    'HungerStation' Platform,  
    Case 
      When canvas_name = '2010XX_SA_HS_NPS_NPS-CX-AO-Survey-Verticals_brand_Canvas' 
        then '2010XX_SA_HS_NPS_NPS-CX-AO-Survey-Verticals_brand_Canvas'
      Else 'HS - All canvas for Dmarts/Local Stores consolidated due to data issues'
    End canvas_name,
    --step_name,
    Case 
      When canvas_name = '2010XX_SA_HS_NPS_NPS-CX-AO-Survey-Verticals_brand_Canvas' then 'Restaurants'
      Else 'Local Stores/Dmarts'
    End vertical,
    'SA' country_code,
    date_trunc(reporting_date, month) time,
    Sum(sent) sent,
    Sum(impressions) impressions,
    Sum(total_opens) total_opens,
    Sum(second_button_clicks) second_button_clicks
  FROM 
    fulfillment-dwh-production.curated_data_shared_mkt.braze_aggregated_statistics_canvas_steps
  where 
    reporting_date >>='2021-01-01' and
    lower(canvas_name) like '%nps%' and lower(canvas_name) like '%hs%'
  Group by 1,2,3,4,5,6
) T
),

EU_DHAustria_DHCEE As(
  Select 
  Concat(Region,'_',Platform,'_',country_code,'_',vertical,'_',Cast(time as string)) as Key, 
  *
From(
  Select 
    'Europe' Region,
    CASE 
      WHEN instr(canvas_name,'AT')>>0 THEN 'DH Europe' --DH Austria
      ELSE 'DH Europe'  --DH CEE
    END Platform,
    canvas_name,
    --step_name,
    CASE 
      WHEN instr(canvas_name,'CZ')>>0 THEN 'Mix'
      WHEN instr(canvas_name,'AT')>>0 THEN 'Mix'
      ELSE 'Restaurants'
    END vertical,
    CASE 
      WHEN instr(canvas_name,'SK')>>0 THEN 'SK'
      WHEN instr(canvas_name,'HU')>>0 THEN 'HU'
      WHEN instr(canvas_name,'CZ')>>0 THEN 'CZ'
      WHEN instr(canvas_name,'AT')>>0 THEN 'AT'
      ELSE 'Canvas name issue'
    END country_code,
    date_trunc(reporting_date, month) time,
    Sum(sent) sent,
    Sum(impressions) impressions,
    Sum(total_opens) total_opens,
    Sum(second_button_clicks) second_button_clicks
  FROM 
    fulfillment-dwh-production.curated_data_shared_mkt.braze_aggregated_statistics_canvas_steps
  where 
    reporting_date >>='2021-01-01' and
    canvas_name in (
      'MIX_AUT_2202XX_SK_FP_EG_RestaurantAfterOrderNPS_Brand_Canvas',
      'MIX_AUT_2109XX_HU_FP_EG_RestaurantAfterOrderNPS_Brand_Canvas',
      '2001XX_CZ_DJ_NPS_AfterOrderNPS_Canvas',
      'MIX_AUT_2202XX_AT_MJ_NPS_AfterOrderNPS_brand_CAN'
    )
  Group by 1,2,3,4,5,6
  Order by platform, time
) T
),

EU_Foodora As ( --Finland, Sweden, Norway, Denmark
Select 
  Concat(Region,'_',Platform,'_',country_code,'_',vertical,'_',Cast(time as string)) as Key, 
  *
From(
  Select 
    'Europe' Region,
    'DH Europe' Platform,  --DH Nordics
    'DH Nordics - All campaigns consolidated due to data issues' as canvas_name,
    --step_name,
    CASE 
      WHEN instr(canvas_name,'Vertical')>>0 THEN 'Dmarts'
      WHEN instr(canvas_name,'SE')>>0 THEN 'Mix'
      WHEN instr(canvas_name,'GL_FD')>>0 THEN 'Mix'
      ELSE 'Restaurants'
    END vertical,
    CASE 
      WHEN instr(canvas_name,'SE')>>0 THEN 'SE'
      WHEN instr(canvas_name,'FI')>>0 THEN 'FI'
      WHEN instr(canvas_name,'GL_FD')>>0 THEN 'NO'
      WHEN instr(canvas_name,'DK_FO')>>0 THEN 'DK'
    END country_code,
    date_trunc(reporting_date, month) time,
    Sum(sent) sent,
    Sum(impressions) impressions,
    Sum(total_opens) total_opens,
    Sum(second_button_clicks) second_button_clicks
  FROM 
    fulfillment-dwh-production.curated_data_shared_mkt.braze_aggregated_statistics_canvas_steps
  where 
    reporting_date >>='2021-01-01' and
    canvas_name in (
      '2001XX_FI_FO_NPS_Restaurants-NPS_AfterOrderNPS_Canvas',
      '2001XX_FI_FO_NPS_AfterOrderNPS_Canvas',
      '2102XX_FI_FO_NPS_Vertical-NPS_AfterOrderNPS_Canvas',
      '2102XX_FI_FO_EG_Vertical-NPS_AfterOrderNPS_Canvas',
      '1912XX_SE_FO_NPS_AfterOrderNPS_brand_Canvas',
      '1912XX_SE_FO_NPS_AfterOrderNPS_Canvas',
      '1904XX_GL_FD_NPS_AfterOrderNPS_brand_Canvas',
      '1904XX_GL_FD_NPS_AfterOrderNPS_Canvas',
      '1904XX_GL_FO_NPS_AfterOrderNPS_Canvas',
      '2209XX_DK_FO_NPS_AfterOrderNPS_brand_CAN'
    )
  Group by 1,2,3,4,5,6
) T
),

EU_DHGreece As (
Select 
  Concat(Region,'_',Platform,'_',country_code,'_',vertical,'_',Cast(time as string)) as Key, 
  *
From(
  Select 
    'Europe' Region,
    'DH Greece' Platform,  
    'DH Greece - All campaigns consolidated due to data issues' as canvas_name,
    --step_name,
    'Mix' vertical,
    CASE 
      WHEN instr(canvas_name,'CY')>>0 THEN 'CY'
      WHEN instr(canvas_name,'GR')>>0 THEN 'GR'
    END country_code,
    date_trunc(reporting_date, month) time,
    Sum(sent) sent,
    Sum(impressions) impressions,
    Sum(total_opens) total_opens,
    Sum(second_button_clicks) second_button_clicks
  FROM 
    fulfillment-dwh-production.curated_data_shared_mkt.braze_aggregated_statistics_canvas_steps
  where 
    reporting_date >>='2021-01-01' and
    canvas_name in (
      'MIX_AUT_2112xx_CY_FY_EG_NPSAfterOrder-Trigger_Brand_SEG',
      'MIX_AUT_2203xx_GR_EF_EG_NPSAfterOrder-All_Brand_MSG',
      'MIX_AUT_2212xx_GR_EF_TA_NPSAfterOrder-All_Brand_MSG',
      'MIX_AUT_2210xx_GR_EF_EG_NPSAfterOrder-All_Brand_MSG'
    )
  Group by 1,2,3,4,5,6
) T
),

LATAM_PeYA As(
Select 
  Concat(Region,'_',Platform,'_',country_code,'_',vertical,'_',Cast(time as string)) as Key,
  *
From(  
  SELECT 
    'America' Region,
    'Pedidosya' Platform,  
    canvas_name,
    CASE 
      WHEN instr(canvas_name,'Non-Food')>>0 THEN 'Local Stores/Dmarts'
      ELSE 'Restaurants'
    END vertical,
    Right(Left(canvas_step_name,9),2) country_code,
    Date(date_trunc(event_received, month)) time,
    Sum(IF(event_type in ('email_send','messages_content_card_send'),1,0)) sent,
    0 as impressions,
    0 as total_opens,
    0 as second_button_clicks
  FROM 
    `fulfillment-dwh-production.curated_data_shared_mkt.braze_currents_user_engagements` cu
  WHERE 
    event_received >>= '2021-01-01' --and event_received <<= '2022-01-31'
    AND cu.appgroup_name in ('pedidosya')
    AND event_type IN (
      'email_click',
      'email_open',
      'email_send',
      'messages_content_card_send'
    ) and
    lower(canvas_name) like '%nps-cx-ao%' 
    and lower(canvas_name) like '%py%' 
    and lower(canvas_name) like '%food%'
    and lower(canvas_name) not like '%test%' 
    and not (
      lower(canvas_step_name) like '%inapp_survey%' or 
      lower(canvas_step_name) like '%control%' or 
      lower(canvas_step_name) like '%webhook%'
    )
  Group by 1,2,3,4,5,6
) T
where not (sent=0 and impressions=0 and total_opens=0 and second_button_clicks=0)
),


distribution As(
  Select * from APAC_Foodpanda
  UNION ALL Select * from MENA_Yemeksepeti
  UNION ALL Select * from MENA_Banabi
  UNION ALL Select * from MENA_Talabat
  UNION ALL Select * from MENA_HS
  UNION ALL Select * from EU_DHAustria_DHCEE
  UNION ALL Select * from EU_Foodora
  UNION ALL Select * from EU_DHGreece
  UNION ALL Select * from LATAM_PeYA
),

NPS_temp AS(
  SELECT 
    c.segment,
    c.country_code,
    c.management_entity,
    c.global_entity_id,
    CASE 
      WHEN v.vertical_type = 'darkstores' THEN 'Dmarts'
      WHEN v.vertical_type IN ('restaurants', 'coffee') THEN 'Restaurants'
      WHEN v.vendor_id IS NULL THEN 'Unknown'
      ELSE 'Local Stores'
    END as vertical_type,
    Date_trunc(created_date, month) created_date,
    CAST(SUM(CASE WHEN CAST(n.nps_score AS INT64) >> 8 THEN 1 ELSE 0 END) AS FLOAT64) AS nps_promoters,
    CAST(SUM(CASE WHEN CAST(n.nps_score AS INT64) <<= 6 THEN 1 ELSE 0 END) AS FLOAT64) AS nps_detractors,
    CAST(SUM(CASE WHEN n.nps_score IS NOT NULL THEN 1 ELSE 0 END) AS FLOAT64) AS total_nps_responses,
    CAST(SUM(CASE WHEN CAST(n.progress as INT64) = 100 THEN 1 ELSE 0 END) AS FLOAT64) AS total_nps_responses_100,
    CAST(SUM(CASE WHEN CAST(n.progress as INT64)>>=80 THEN 1 ELSE 0 END) AS FLOAT64) AS total_nps_responses_80
  FROM 
    `fulfillment-dwh-production.curated_data_shared_cx.nps_after_order_all_survey_responses` AS n
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_central_dwh.global_entities` AS c
    ON n.global_entity_id = c.global_entity_id
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_central_dwh.orders` o 
    ON n.order_id = o.order_id and n.global_entity_id = o.global_entity_id 
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_central_dwh.vendors` v 
    ON o.global_entity_id = v.global_entity_id and o.vendor_id = v.vendor_id
  WHERE 
    n.created_date >>= '2021-01-01'AND o.placed_at_local >>= '2021-01-01'
    AND management_entity in ('Foodpanda APAC','Yemeksepeti','Talabat','HungerStation','DH Europe','DH Greece','Pedidosya') 
    AND c.is_reporting_enabled AND c.is_platform_online
  GROUP BY 1,2,3,4,5,6
),

NPS as(
SELECT
  *,
  Concat(segment,'_',management_entity,'_',country_code,'_',vertical_type_main,'_',Cast(created_date as string)) as Key,
From(
  Select 
    segment,
    country_code,
    management_entity,
    global_entity_id,
  CASE
    WHEN management_entity= 'Talabat' THEN 'Mix'
    WHEN management_entity= 'DH Greece' THEN 'Mix'
    WHEN management_entity= 'HungerStation' AND vertical_type in ('Dmarts','Local Stores') THEN 'Local Stores/Dmarts'
    WHEN management_entity= 'Pedidosya' AND vertical_type in ('Dmarts','Local Stores') THEN 'Local Stores/Dmarts'
    WHEN management_entity= 'DH Europe' and country_code='AT' THEN 'Mix' --management_entity= 'DH Austria' 
    WHEN management_entity= 'DH Europe' AND country_code= 'CZ' THEN 'Mix'   --management_entity= 'DH CEE'
    WHEN management_entity= 'DH Europe' and country_code in ('NO','SE') THEN 'Mix'   --management_entity= 'DH Nordics'
    WHEN management_entity= 'DH Europe' and country_code='FI' AND vertical_type ='Dmarts' THEN 'Dmarts'  --management_entity= 'DH Nordics'
    WHEN management_entity= 'DH Europe' and country_code='FI' AND vertical_type ='Restaurants' THEN 'Restaurants'  --management_entity= 'DH Nordics'
    WHEN management_entity= 'DH Europe' AND country_code in ('SK', 'HU', 'DK') THEN 'Restaurants'   
    ELSE vertical_type
  END vertical_type_main,
    created_date,
    Sum(nps_promoters) nps_promoters,
    Sum(nps_detractors) nps_detractors,
    Sum(total_nps_responses) total_nps_responses,
    Sum(total_nps_responses_100) total_nps_responses_100,
    Sum(total_nps_responses_80) total_nps_responses_80
  From NPS_temp
  Group by 1,2,3,4,5,6
) U
),

orders_temp As(
  SELECT 
    c.segment,
    c.country_code,
    c.management_entity,
    c.global_entity_id,
    CASE 
      WHEN v.vertical_type = 'darkstores' THEN 'Dmarts'
      WHEN v.vertical_type IN ('restaurants', 'coffee') THEN 'Restaurants'
      WHEN v.vendor_id IS NULL THEN 'Unknown'
      ELSE 'Local Stores'
    END as vertical_type,
    Date(Date_trunc(placed_at_local, month)) placed_at_local,
    COUNT(DISTINCT o.analytical_customer_id) unique_customers,
    COUNT(o.order_id) orders,
  FROM 
    `fulfillment-dwh-production.curated_data_shared_central_dwh.orders` AS o
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_central_dwh.global_entities` AS c
    ON o.global_entity_id = c.global_entity_id 
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_central_dwh.vendors` v 
    ON o.global_entity_id = v.global_entity_id and o.vendor_id = v.vendor_id
  WHERE 
    o.placed_at_local >>= '2021-01-01'
    and is_sent
    AND management_entity in ('Foodpanda APAC','Yemeksepeti','Talabat','HungerStation','DH Europe','DH Greece','Pedidosya') 
    AND c.is_reporting_enabled AND c.is_platform_online
  GROUP BY 1,2,3,4,5,6
),

orders As(
Select
  *,
  Concat(segment,'_',management_entity,'_',country_code,'_',vertical_type_main,'_',Cast(placed_at_local as string)) as Key
From ( 
Select 
  segment,
  country_code,
  management_entity,
  global_entity_id,
  CASE
    WHEN management_entity= 'Talabat' THEN 'Mix'
    WHEN management_entity= 'DH Greece' THEN 'Mix'
    WHEN management_entity= 'HungerStation' AND vertical_type in ('Dmarts','Local Stores') THEN 'Local Stores/Dmarts'
    WHEN management_entity= 'Pedidosya' AND vertical_type in ('Dmarts','Local Stores') THEN 'Local Stores/Dmarts'
    WHEN management_entity= 'DH Europe' and country_code='AT' THEN 'Mix' --management_entity= 'DH Austria' 
    WHEN management_entity= 'DH Europe' AND country_code= 'CZ' THEN 'Mix'   --management_entity= 'DH CEE'
    WHEN management_entity= 'DH Europe' and country_code in ('NO','SE') THEN 'Mix'   --management_entity= 'DH Nordics'
    WHEN management_entity= 'DH Europe' and country_code='FI' AND vertical_type ='Dmarts' THEN 'Dmarts'  --management_entity= 'DH Nordics'
    WHEN management_entity= 'DH Europe' and country_code='FI' AND vertical_type ='Restaurants' THEN 'Restaurants'  --management_entity= 'DH Nordics'
    WHEN management_entity= 'DH Europe' AND country_code in ('SK', 'HU', 'DK') THEN 'Restaurants'   
    ELSE vertical_type
  END vertical_type_main,
  placed_at_local,
  Sum(unique_customers) unique_customers,
  Sum(orders) orders,
From
  orders_temp
GROUP BY
  1,2,3,4,5,6
) U
),

Construct as(
  SELECT 
    DISTINCT
    Concat(g.segment,'_',management_entity,'_',country_code,'_',v.vertical,'_',Cast(date_trunc(d.iso_date, month) as string)) as Key,
    g.segment Region,
    g.management_entity Platform,
    g.global_entity_id,
    g.country_code,
    g.country_name,
    v.vertical,
    date_trunc(d.iso_date, month) iso_date
  FROM `fulfillment-dwh-production.curated_data_shared_central_dwh.dates` d 
  CROSS JOIN verticals v 
  CROSS JOIN `fulfillment-dwh-production.curated_data_shared_central_dwh.global_entities` g
  WHERE d.iso_date >>= '2021-01-01' and d.iso_date <<= current_date()
    AND g.management_entity in ('Foodpanda APAC','Yemeksepeti','Talabat','HungerStation','DH Europe','DH Greece','Pedidosya') 
  AND g.is_reporting_enabled AND g.is_platform_online
)


Select 
  c.Key,
  d.canvas_name,
  --d.step_name,
  c.vertical,
  c.Region,
  c.Platform,
  c.global_entity_id,
  c.country_code,
  c.country_name,
  c.iso_date,
  d.sent,
  d.impressions,
  d.total_opens,
  d.second_button_clicks,
  n.total_nps_responses,
  n.total_nps_responses_80,
  n.total_nps_responses_100,
  o.unique_customers,
  o.orders
From Construct c
Left JOIN (Select distinct * from Distribution) d ON c.key=d.key
Left JOIN NPS n ON c.key=n.key
Left JOIN Orders o ON c.key=o.key
where not(
  d.sent is null and
  d.impressions is null and
  d.total_opens is null and
  d.second_button_clicks is null and
  total_nps_responses is null and
  o.unique_customers is null and
  o.orders is null
)

/* 
-- previous version where there is data issue Nov-22 onwards
LATAM_PeYA As(
Select 
  Concat(Region,'_',Platform,'_',country_code,'_',vertical,'_',Cast(time as string)) as Key,
  *
From(
  Select 
    'America' Region,
    'Pedidosya' Platform,  
    canvas_name,
    --step_name,
    CASE 
      WHEN instr(canvas_name,'Non-Food')>>0 THEN 'Local Stores/Dmarts'
      ELSE 'Restaurants'
    END vertical,
    Right(Left(step_name,9),2) country_code,
    date_trunc(reporting_date, month) time,
    Sum(sent) sent,
    Sum(impressions) impressions,
    Sum(total_opens) total_opens,
    Sum(second_button_clicks) second_button_clicks
  FROM 
    fulfillment-dwh-production.curated_data_shared_mkt.braze_aggregated_statistics_canvas_steps
  where 
    reporting_date >>='2021-01-01' and
    lower(canvas_name) like '%nps-cx-ao%' and lower(canvas_name) like '%py%' and lower(canvas_name) like '%food%'
