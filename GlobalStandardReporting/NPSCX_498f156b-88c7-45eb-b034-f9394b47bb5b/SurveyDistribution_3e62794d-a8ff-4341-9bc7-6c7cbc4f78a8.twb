              <calculation class='tableau' formula='&quot;#Sent&quot;' />
            </column>
            <column caption='Calculation %' datatype='string' datatype-customized='true' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;\%Total Response by Sent&quot;'>
              <calculation class='tableau' formula='&quot;%Total Response by Sent&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0av79m70m454py1b2i61e1r3yljc'>
            <column caption='NPS/2nd button' datatype='real' default-format='p0.0%' name='[100% Res/Tot Res (copy)_4399242784529879040]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_nps_responses])/Sum([second_button_clicks])' />
            </column>
            <column caption='100% Res/Tot Res' datatype='real' default-format='p0.0%' name='[80% Res/Tot Res (copy)_4355262379630563339]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_nps_responses_100])/Sum([total_nps_responses])' />
            </column>
            <column caption='Tot #Res by Sent%' datatype='real' default-format='p0.0%' name='[Calculation_124904582073683968]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([total_nps_responses])/SUM([sent])&gt;1 then null        &#10;else SUM([total_nps_responses])/SUM([sent])&#10;END' />
            </column>
            <column caption='Calculation_type %' datatype='real' default-format='p0.0%' name='[Calculation_182255110984138752]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN  &apos;%Total Response by Sent&apos; THEN [Calculation_124904582073683968]&#10;    WHEN  &apos;%Total Response by Customers&apos; THEN [Response by Sent% (copy)_124904582121566209]&#10;    WHEN  &apos;%80 Response by Total Response&apos; THEN [Calculation_4355262379630161929]&#10;    WHEN  &apos;%100 Response by Total Response&apos; THEN [80% Res/Tot Res (copy)_4355262379630563339]&#10;    WHEN  &apos;NPS response by 2nd button clicks&apos; THEN [100% Res/Tot Res (copy)_4399242784529879040]&#10;END' />
            </column>
            <column caption='80% Res/Tot Res' datatype='real' default-format='p0.0%' name='[Calculation_4355262379630161929]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_nps_responses_80])/Sum([total_nps_responses])' />
            </column>
            <column datatype='string' name='[Platform]' role='dimension' type='nominal' />
            <column datatype='string' name='[Region]' role='dimension' type='nominal' />
            <column caption='Tot #Res by Cust%' datatype='real' default-format='p0.0%' name='[Response by Sent% (copy)_124904582121566209]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([total_nps_responses])/SUM([unique_customers])&gt;1 then null        &#10;else SUM([total_nps_responses])/SUM([unique_customers])&#10;END' />
            </column>
