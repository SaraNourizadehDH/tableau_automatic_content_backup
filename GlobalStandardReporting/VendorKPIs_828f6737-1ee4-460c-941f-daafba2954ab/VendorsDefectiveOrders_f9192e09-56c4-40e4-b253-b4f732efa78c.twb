            <column caption='Pre-Order' datatype='boolean' name='[is_preorder]' role='dimension' type='nominal' />
            <column caption='# Orders Failed before Vendor response (Customer and Platform)' datatype='integer' name='[no_cancelled_orders_before_vendor_response]' role='measure' type='quantitative' />
            <column caption='# Orders Failed to transmit to Vendor (Vendor and Transport)' datatype='integer' name='[no_failed_orders_transmit_to_vendor]' role='measure' type='quantitative' />
            <column caption='# Orders Failed without Vendor response (Vendor and Transport)' datatype='integer' name='[no_failed_orders_without_vendor_response]' role='measure' type='quantitative' />
            <column caption='# Orders Sent to Vendor' datatype='integer' name='[no_orders_sent_to_vendor]' role='measure' type='quantitative' />
