            <column caption='Cancellation Dimension - Rejected by the Vendor' datatype='string' name='[Cancellation Dimension - Failed to without Vendor response (copy)_812759060821205038]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Choose Cancellation Split - Failed to without Vendor response (copy)_812759060820901932] = &apos;Cancellation Owner&apos; THEN [cancellation_owner]&#10;ELSEIF [Parameters].[Choose Cancellation Split - Failed to without Vendor response (copy)_812759060820901932] = &apos;Cancellation Reason&apos; THEN [cancellation_reason]&#10;ELSEIF [Parameters].[Choose Cancellation Split - Failed to without Vendor response (copy)_812759060820901932] = &apos;No Split&apos; THEN &apos;ALL&apos;&#10;END' />
