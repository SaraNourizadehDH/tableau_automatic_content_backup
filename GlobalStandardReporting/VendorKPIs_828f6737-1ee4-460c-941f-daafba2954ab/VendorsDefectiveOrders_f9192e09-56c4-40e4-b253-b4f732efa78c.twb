        <calculation class='tableau' formula='SUM([no_orders_received_by_vendor_above_threshold]) / SUM([no_orders_received_by_vendor])' />
      </column>
      <column caption='% Orders with Vendor Response above 30sec' datatype='real' name='[Calculation_3283405654020866051]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([no_orders_with_vendor_response_above_threshold]) / SUM([no_orders_with_vendor_response])' />
      </column>
      <column caption='% OD Orders Failed to be sent to Hurrier (Vendor and Transport)' datatype='real' name='[Calculation_4360047438707666944]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([no_failed_orders_od_send_to_logistics]) / [Calculation_79657477607587841]' />
      </column>
      <column caption='Date Granularity' datatype='string' name='[Calculation_4360047438739648516]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&apos;Daily&apos; THEN str([order_date])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Weekly&apos; THEN [order_week]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Monthly&apos; THEN [order_month]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Quarterly&apos; THEN str(DATE(DATETRUNC(&apos;quarter&apos;,[order_date])))&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Yearly&apos; THEN str([order_year])&#10;END' />
      </column>
      <column caption='Order Date (day and month)' datatype='string' name='[Calculation_4360047438740250629]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;day&apos;,[order_date]) +  &apos; &apos;&#10;+ LEFT(DATENAME(&apos;month&apos;,[order_date]),3)' />
      </column>
      <column caption='Cancellation Dimension - Failed to be Sent to Hurrier' datatype='string' name='[Calculation_4360047438742933510]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;Cancellation Owner&apos; THEN [cancellation_owner]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Cancellation Reason&apos; THEN [cancellation_reason]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;No Split&apos; THEN &apos;ALL&apos;&#10;END' />
      </column>
      <column caption='Region Cleaned' datatype='string' name='[Calculation_4360047438756130823]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [region] = &apos;ap&apos; THEN &apos;Asia&apos; &#10;ELSEIF [region] = &apos;eu&apos; THEN &apos;Europe&apos; &#10;ELSEIF [region] = &apos;mena&apos; THEN &apos;MENA&apos;&#10;ELSEIF [region] = &apos;kr&apos; THEN &apos;Korea&apos; &#10;ELSEIF [region] = &apos;us&apos; THEN &apos;Americas&apos; &#10;END' />
      </column>
      <column caption='Brand Cleaned' datatype='string' name='[Calculation_4360047438757310472]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [brand_id] = &apos;AP&apos; THEN &apos;Appetito24&apos; &#10;ELSEIF [brand_id] = &apos;AR&apos; THEN &apos;Amrest&apos; &#10;ELSEIF [brand_id] = &apos;BK&apos; THEN &apos;Burger King&apos;&#10;ELSEIF [brand_id] = &apos;BO&apos; then &apos;Boozer&apos;&#10;ELSEIF [brand_id] = &apos;CD&apos; then &apos;Click Delivery&apos; &#10;ELSEIF [brand_id] = &apos;CG&apos; THEN &apos;Carriage&apos;&#10;ELSEIF [brand_id] = &apos;DJ&apos; THEN &apos;Damejidlo&apos;&#10;ELSEIF [brand_id] = &apos;DN&apos; THEN &apos;Donesi&apos;&#10;ELSEIF [brand_id] = &apos;EF&apos; THEN &apos;eFood&apos;&#10;ELSEIF [brand_id] = &apos;FO&apos; THEN &apos;Foodora&apos;&#10;ELSEIF [brand_id] = &apos;FOC&apos; then &apos;Talabat&apos;&#10;ELSEIF [brand_id] = &apos;FP&apos; THEN &apos;FoodPanda&apos;&#10;ELSEIF [brand_id] = &apos;HF&apos; THEN &apos;Talabat&apos;&#10;ELSEIF [brand_id] = &apos;HM&apos; THEN &apos;HipMenu&apos;&#10;ELSEIF [brand_id] = &apos;HS&apos; THEN &apos;HungerStation&apos;&#10;ELSEIF [brand_id] = &apos;KFC&apos; THEN &apos;KFC&apos;&#10;ELSEIF [brand_id] = &apos;LH&apos; THEN &apos;Lieferheld&apos;&#10;ELSEIF [brand_id] = &apos;MJM&apos; Then &apos;Mjam&apos; &#10;ELSEIF [brand_id] = &apos;NP&apos; THEN &apos;Net Pincer&apos; &#10;ELSEIF [brand_id] = &apos;ODR&apos; THEN &apos;On Demand Rider&apos; &#10;ELSEIF [brand_id] = &apos;OP&apos; Then &apos;Online Pizza&apos;&#10;ELSEIF [brand_id] = &apos;PDE&apos; THEN &apos;Pizza.de&apos;&#10;ELSEIF [brand_id] = &apos;PO&apos; THEN &apos;Pizza Online&apos;&#10;ELSEIF [brand_id] = &apos;PPP&apos; THEN &apos;Pizza Portal&apos;&#10;ELSEIF [brand_id] = &apos;PY&apos; THEN &apos;Pedidosya&apos; &#10;ELSEIF [brand_id] = &apos;PZ&apos; THEN &apos;Pauza&apos;&#10;ELSEIF [brand_id] = &apos;TB&apos; THEN &apos;Talabat&apos;&#10;ELSEIF [brand_id] = &apos;VP&apos; THEN &apos;Vapiano&apos;&#10;ELSEIF [brand_id] = &apos;WA&apos; THEN &apos;Wallmart&apos; &#10;ELSEIF [brand_id] = &apos;YO&apos; THEN &apos;YoGiYo&apos;&#10;ELSEIF [brand_id] = &apos;YS&apos; THEN &apos;Yemeksepeti&apos; &#10;ELSE [brand_id] END' />
      </column>
      <column caption='Region/Brand' datatype='string' name='[Calculation_4360047438757724169]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_4360047438756130823] + &quot; - &quot; + [Calculation_4360047438757310472]' />
      </column>
      <column caption='% OD Orders Failed before sent to Vendor (Customer and Platform)' datatype='real' name='[Calculation_4360047438779564046]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([no_cancelled_orders_od_before_send_to_vendor]) / [Calculation_79657477607587841]' />
      </column>
      <column caption='% Orders Failed to transmit to Vendor (Vendor and Transport)' datatype='real' name='[Calculation_4916875311504363532]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([no_failed_orders_transmit_to_vendor]) / [Calculation_79657477705535490]' />
      </column>
      <column caption='% Orders Failed without Vendor response (Vendor and Transport)' datatype='real' name='[Calculation_4916875311509205006]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([no_failed_orders_without_vendor_response]) / [# Orders Received by Vendor (copy)_812759060804173860]' />
      </column>
      <column caption='% Orders Failed before Vendor response (Customer and Platform)' datatype='real' name='[Calculation_4916875311511998479]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([no_cancelled_orders_before_vendor_response]) / [Calculation_79657477705535490]' />
      </column>
      <column caption='% Orders Rejected by the Vendor' datatype='real' name='[Calculation_4916875311670464537]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([no_orders_declined_by_vendor]) / SUM([no_orders_with_vendor_response])' />
      </column>
      <column caption='% Orders Modified by the Vendor' datatype='real' name='[Calculation_4916875311670804506]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([no_orders_modified_by_vendor]) / SUM([no_orders_with_vendor_response])' />
      </column>
      <column caption='% Orders Reconciled' datatype='real' name='[Calculation_4916875311673606171]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([no_orders_reconciled]) / SUM([no_orders_modified_by_vendor])' />
      </column>
      <column caption='% Orders Reconciled and Completed' datatype='real' name='[Calculation_4916875311676182556]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([no_orders_reconciled_and_completed]) / SUM([no_orders_modified_by_vendor])' />
      </column>
      <column caption='% Orders Implicit Accepted by Vendor' datatype='real' name='[Calculation_4916875311680798749]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([no_orders_implicitly_accepted_by_vendor]) / SUM([no_orders_od])' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_5075767925971066883]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='# OD Orders (fixed)' datatype='integer' name='[Calculation_79657477607587841]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({FIXED [order_date], [Calculation_4360047438756130823], [Calculation_4360047438757724169], [delivery_platform], [service], [is_preorder] : SUM([no_orders_od])})' />
      </column>
      <column caption='# Orders Sent to Vendor (fixed)' datatype='integer' name='[Calculation_79657477705535490]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({FIXED [order_date], [Calculation_4360047438756130823], [Calculation_4360047438757724169], [delivery_platform],[service],[is_preorder],[delivery_type],[application_client_name],[application_integration_flow],[application_client_wrapper_type] &#10;: SUM([no_orders_sent_to_vendor])})' />
      </column>
      <column caption='# Courier Assigned - Defective Orders' datatype='integer' name='[Calculation_812759060284592133]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[no_failed_orders_od_send_to_logistics] +&#10;[no_cancelled_orders_od_before_send_to_vendor] +&#10;[no_failed_orders_od_send_to_vendor] +&#10;[no_orders_od_sent_to_vendor_above_threshold]' />
      </column>
      <column caption='# Orders Long Estimated Time ' datatype='integer' name='[Calculation_812759061163257915]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[no_orders_od_preptime_above_c] + [no_orders_vd_eta_above_c]' />
      </column>
      <column caption='# OD/VD Orders' datatype='integer' name='[Calculation_812759061164027965]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[no_orders_od] + [no_orders_vd]' />
      </column>
      <column caption='% Orders Long Estimated Time' datatype='real' name='[Calculation_812759061164298302]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_812759061163257915]) / SUM([Calculation_812759061164027965])' />
      </column>
      <column caption='% OD Orders Sent to Hurrier and Failed to be sent to Vendor (Vendor and Transport)' datatype='real' name='[Calculation_87609153837744129]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([no_failed_orders_od_send_to_vendor]) / [# OD Orders Sent to Hurrier (copy)_812759060601671711]' />
      </column>
      <column caption='Cancellation Dimension - Cancelled before Vendor response' datatype='string' name='[Cancellation Dimension - Cancelled before sent to Vendor (copy)_812759060799787040]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Choose Cancellation Split - Cancelled before sent to Vendor (copy)_812759060800036897] = &apos;Cancellation Owner&apos; THEN [cancellation_owner]&#10;ELSEIF [Parameters].[Choose Cancellation Split - Cancelled before sent to Vendor (copy)_812759060800036897] = &apos;Cancellation Reason&apos; THEN [cancellation_reason]&#10;ELSEIF [Parameters].[Choose Cancellation Split - Cancelled before sent to Vendor (copy)_812759060800036897] = &apos;No Split&apos; THEN &apos;ALL&apos;&#10;END' />
      </column>
