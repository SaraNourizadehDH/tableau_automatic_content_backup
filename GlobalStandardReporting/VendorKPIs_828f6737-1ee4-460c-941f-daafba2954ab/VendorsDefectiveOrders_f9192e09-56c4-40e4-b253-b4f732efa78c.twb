            <run bold='true' fontcolor='#1b1b1b' fontsize='9'>vs. </run>
            <run bold='true' fontcolor='#ca011d' fontsize='9'>% Orders Failed before sent to Vendor (Customer and Platform)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='rps_gsr_daily_dashboard_defective_orders (rl)' name='federated.0d5lgbw0rq9an11748i1v19k4pdy' />
