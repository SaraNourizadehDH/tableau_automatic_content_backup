    <worksheet name='Overview Vendor Acceptance'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#535353' fontsize='9'># Orders with Vendor Response</run>
            <run bold='true' fontcolor='#ca011d' fontsize='9'>Æ </run>
            <run bold='true' fontcolor='#000000' fontsize='9'>vs.</run>
            <run bold='true' fontcolor='#ca011d' fontsize='9'> % Orders Rejected by the Vendor </run>
            <run bold='true' fontcolor='#1b1b1b' fontsize='9'>vs. </run>
            <run bold='true' fontcolor='#796272' fontsize='9'>% Orders Modified by the Vendor</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='rps_gsr_daily_dashboard_defective_orders (rl)' name='federated.0d5lgbw0rq9an11748i1v19k4pdy' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0d5lgbw0rq9an11748i1v19k4pdy'>
            <column caption='Date Granularity' datatype='string' name='[Calculation_4360047438739648516]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&apos;Daily&apos; THEN str([order_date])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Weekly&apos; THEN [order_week]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Monthly&apos; THEN [order_month]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Quarterly&apos; THEN str(DATE(DATETRUNC(&apos;quarter&apos;,[order_date])))&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Yearly&apos; THEN str([order_year])&#10;END' />
            </column>
            <column caption='Region Cleaned' datatype='string' name='[Calculation_4360047438756130823]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [region] = &apos;ap&apos; THEN &apos;Asia&apos; &#10;ELSEIF [region] = &apos;eu&apos; THEN &apos;Europe&apos; &#10;ELSEIF [region] = &apos;mena&apos; THEN &apos;MENA&apos;&#10;ELSEIF [region] = &apos;kr&apos; THEN &apos;Korea&apos; &#10;ELSEIF [region] = &apos;us&apos; THEN &apos;Americas&apos; &#10;END' />
            </column>
            <column caption='Brand Cleaned' datatype='string' name='[Calculation_4360047438757310472]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [brand_id] = &apos;AP&apos; THEN &apos;Appetito24&apos; &#10;ELSEIF [brand_id] = &apos;AR&apos; THEN &apos;Amrest&apos; &#10;ELSEIF [brand_id] = &apos;BK&apos; THEN &apos;Burger King&apos;&#10;ELSEIF [brand_id] = &apos;BO&apos; then &apos;Boozer&apos;&#10;ELSEIF [brand_id] = &apos;CD&apos; then &apos;Click Delivery&apos; &#10;ELSEIF [brand_id] = &apos;CG&apos; THEN &apos;Carriage&apos;&#10;ELSEIF [brand_id] = &apos;DJ&apos; THEN &apos;Damejidlo&apos;&#10;ELSEIF [brand_id] = &apos;DN&apos; THEN &apos;Donesi&apos;&#10;ELSEIF [brand_id] = &apos;EF&apos; THEN &apos;eFood&apos;&#10;ELSEIF [brand_id] = &apos;FO&apos; THEN &apos;Foodora&apos;&#10;ELSEIF [brand_id] = &apos;FOC&apos; then &apos;Talabat&apos;&#10;ELSEIF [brand_id] = &apos;FP&apos; THEN &apos;FoodPanda&apos;&#10;ELSEIF [brand_id] = &apos;HF&apos; THEN &apos;Talabat&apos;&#10;ELSEIF [brand_id] = &apos;HM&apos; THEN &apos;HipMenu&apos;&#10;ELSEIF [brand_id] = &apos;HS&apos; THEN &apos;HungerStation&apos;&#10;ELSEIF [brand_id] = &apos;KFC&apos; THEN &apos;KFC&apos;&#10;ELSEIF [brand_id] = &apos;LH&apos; THEN &apos;Lieferheld&apos;&#10;ELSEIF [brand_id] = &apos;MJM&apos; Then &apos;Mjam&apos; &#10;ELSEIF [brand_id] = &apos;NP&apos; THEN &apos;Net Pincer&apos; &#10;ELSEIF [brand_id] = &apos;ODR&apos; THEN &apos;On Demand Rider&apos; &#10;ELSEIF [brand_id] = &apos;OP&apos; Then &apos;Online Pizza&apos;&#10;ELSEIF [brand_id] = &apos;PDE&apos; THEN &apos;Pizza.de&apos;&#10;ELSEIF [brand_id] = &apos;PO&apos; THEN &apos;Pizza Online&apos;&#10;ELSEIF [brand_id] = &apos;PPP&apos; THEN &apos;Pizza Portal&apos;&#10;ELSEIF [brand_id] = &apos;PY&apos; THEN &apos;Pedidosya&apos; &#10;ELSEIF [brand_id] = &apos;PZ&apos; THEN &apos;Pauza&apos;&#10;ELSEIF [brand_id] = &apos;TB&apos; THEN &apos;Talabat&apos;&#10;ELSEIF [brand_id] = &apos;VP&apos; THEN &apos;Vapiano&apos;&#10;ELSEIF [brand_id] = &apos;WA&apos; THEN &apos;Wallmart&apos; &#10;ELSEIF [brand_id] = &apos;YO&apos; THEN &apos;YoGiYo&apos;&#10;ELSEIF [brand_id] = &apos;YS&apos; THEN &apos;Yemeksepeti&apos; &#10;ELSE [brand_id] END' />
            </column>
            <column caption='Region/Brand' datatype='string' name='[Calculation_4360047438757724169]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_4360047438756130823] + &quot; - &quot; + [Calculation_4360047438757310472]' />
            </column>
            <column caption='% Orders Rejected by the Vendor' datatype='real' name='[Calculation_4916875311670464537]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_orders_declined_by_vendor]) / SUM([no_orders_with_vendor_response])' />
            </column>
            <column caption='% Orders Modified by the Vendor' datatype='real' name='[Calculation_4916875311670804506]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_orders_modified_by_vendor]) / SUM([no_orders_with_vendor_response])' />
            </column>
            <column caption='Brand' datatype='string' name='[brand_id]' role='dimension' type='nominal' />
            <column caption='Delivery Type' datatype='string' name='[delivery_type]' role='dimension' type='nominal' />
            <column caption='# Orders Rejected by the Vendor' datatype='integer' name='[no_orders_declined_by_vendor]' role='measure' type='quantitative' />
            <column caption='# Orders Modified by the Vendor' datatype='integer' name='[no_orders_modified_by_vendor]' role='measure' type='quantitative' />
            <column caption='# Orders with Vendor Response' datatype='integer' name='[no_orders_with_vendor_response]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_4360047438739648516]' derivation='None' name='[none:Calculation_4360047438739648516:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_4360047438757724169]' derivation='None' name='[none:Calculation_4360047438757724169:nk]' pivot='key' type='nominal' />
            <column-instance column='[delivery_type]' derivation='None' name='[none:delivery_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[transmission_flow]' derivation='None' name='[none:transmission_flow:nk]' pivot='key' type='nominal' />
            <column-instance column='[vertical_type]' derivation='None' name='[none:vertical_type:nk]' pivot='key' type='nominal' />
            <column caption='Order Date' datatype='date' name='[order_date]' role='dimension' type='quantitative' />
            <column caption='Order Month' datatype='string' name='[order_month]' role='dimension' type='nominal' />
            <column caption='Order Week' datatype='string' name='[order_week]' role='dimension' type='nominal' />
            <column caption='Order Year' datatype='integer' name='[order_year]' role='dimension' type='quantitative' />
            <column caption='Region' datatype='string' name='[region]' role='dimension' type='nominal' />
            <column-instance column='[no_orders_declined_by_vendor]' derivation='Sum' name='[sum:no_orders_declined_by_vendor:qk]' pivot='key' type='quantitative' />
            <column-instance column='[no_orders_modified_by_vendor]' derivation='Sum' name='[sum:no_orders_modified_by_vendor:qk]' pivot='key' type='quantitative' />
            <column-instance column='[no_orders_with_vendor_response]' derivation='Sum' name='[sum:no_orders_with_vendor_response:qk]' pivot='key' type='quantitative' />
            <column caption='Transmission Flow' datatype='string' name='[transmission_flow]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_4916875311670464537]' derivation='User' name='[usr:Calculation_4916875311670464537:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_4916875311670804506]' derivation='User' name='[usr:Calculation_4916875311670804506:qk]' pivot='key' type='quantitative' />
            <column caption='Vertical Type' datatype='string' name='[vertical_type]' role='dimension' type='nominal' />
          </datasource-dependencies>
