      <aliases enabled='yes' />
      <column caption='% Courier Assigned - Defective Orders' datatype='real' name='[# Courier Assigned - Defective Orders (copy)_812759060286574598]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_812759060284592133]) / SUM([no_orders_od])' />
      </column>
      <column caption='# OD Orders Failed before sent to Vendor (Vendor and Transport)' datatype='integer' name='[# Courier Assigned - Defective Orders (copy)_812759060288630791]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[no_failed_orders_od_send_to_logistics] +&#10;[no_failed_orders_od_send_to_vendor]' />
      </column>
      <column caption='# Vendor Response - Defective Orders' datatype='integer' name='[# Courier Assigned - Defective Orders (copy)_812759060322844684]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[no_failed_orders_transmit_to_vendor] +&#10;[no_failed_orders_without_vendor_response] +&#10;[no_cancelled_orders_before_vendor_response] +&#10;[no_orders_received_by_vendor_above_threshold] +&#10;[no_orders_with_vendor_response_above_threshold]' />
      </column>
      <column caption='# Courier Assigned - Cancelled Orders' datatype='integer' name='[# Courier Assigned - Failed Orders (copy)_812759060289085448]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[no_cancelled_orders_od_before_send_to_vendor]' />
      </column>
      <column caption='# Failed Orders' datatype='integer' name='[# OD Orders (copy)_812759060205252611]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [status] = &apos;cancelled&apos; THEN [no_orders] ELSE NULL END' />
      </column>
      <column caption='# OD Orders Sent to Hurrier (fixed)' datatype='integer' name='[# OD Orders Sent to Hurrier (copy)_812759060601671711]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({FIXED [order_date], [Calculation_4360047438756130823], [Calculation_4360047438757724169], [delivery_platform], [service], [is_preorder] : SUM([no_orders_od_received_by_logistics])})' />
      </column>
      <column caption='# OD Orders Sent to Vendor (fixed)' datatype='integer' name='[# OD Orders Sent to Vendor (copy)_812759060803899427]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({FIXED [order_date], [Calculation_4360047438756130823], [Calculation_4360047438757724169], [delivery_platform], [service], [is_preorder] : SUM([no_orders_od_sent_to_vendor])})' />
      </column>
      <column caption='# OD Orders Sent to Vendor - Non Pre-Orders' datatype='integer' name='[# OD Orders Sent to Vendor (copy)_812759061126017072]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_preorder] = False THEN [no_orders_od_sent_to_vendor] ELSE NULL END' />
      </column>
      <column caption='# OD Orders Sent to Vendor above 8min - Non Pre-Orders' datatype='integer' name='[# OD Orders Sent to Vendor above threshold (copy 2)_812759061126459442]' role='measure' type='quantitative'>
