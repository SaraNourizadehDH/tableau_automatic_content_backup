      </column>
      <column caption='Cancellation Dimension - Failed to be transmitted to Vendor' datatype='string' name='[Cancellation Dimension - Failed to be Sent to Vendor (copy)_812759060805419048]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Choose Cancellation Split - Failed to be Sent to Vendor (copy)_812759060805152806] = &apos;Cancellation Owner&apos; THEN [cancellation_owner]&#10;ELSEIF [Parameters].[Choose Cancellation Split - Failed to be Sent to Vendor (copy)_812759060805152806] = &apos;Cancellation Reason&apos; THEN [cancellation_reason]&#10;ELSEIF [Parameters].[Choose Cancellation Split - Failed to be Sent to Vendor (copy)_812759060805152806] = &apos;No Split&apos; THEN &apos;ALL&apos;&#10;END' />
      </column>
      <column caption='Cancellation Dimension - Failed to without Vendor response' datatype='string' name='[Cancellation Dimension - Failed to be transmitted to Vendor (copy)_812759060809355307]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Choose Cancellation Split - Failed to be transmitted to Vendor (copy)_812759060809166889] = &apos;Cancellation Owner&apos; THEN [cancellation_owner]&#10;ELSEIF [Parameters].[Choose Cancellation Split - Failed to be transmitted to Vendor (copy)_812759060809166889] = &apos;Cancellation Reason&apos; THEN [cancellation_reason]&#10;ELSEIF [Parameters].[Choose Cancellation Split - Failed to be transmitted to Vendor (copy)_812759060809166889] = &apos;No Split&apos; THEN &apos;ALL&apos;&#10;END' />
