      <column caption='KPI Dimension' datatype='string' name='[Calculation_268527154039296004]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 12] WHEN &apos;All&apos; THEN &apos;All&apos;&#10;WHEN &apos;Region&apos; THEN [region]&#10;WHEN &apos;Brand Name&apos; THEN [brand_name]&#10;WHEN &apos;Country Name&apos; THEN [country_name]&#10;WHEN &apos;Delivery Type&apos; THEN [delivery_type]&#10;WHEN &apos;Vertical Type&apos; THEN [vertical_type]&#10;WHEN &apos;POS Integration Type&apos; THEN [application_integration_flow]&#10;WHEN &apos;Client&apos; THEN [application_client_name]&#10;WHEN &apos;Client Wrapper&apos; THEN [application_client_wrapper_type]&#10;WHEN &apos;Is NGT Device&apos; THEN STR([is_ngt_device])&#10;WHEN &apos;Is Pre-Order&apos; THEN STR([is_preorder])&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='KPI (bin)' datatype='string' name='[Calculation_268527154040938501]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR((FLOOR([Calculation_268527154036801537]/[Parameters].[Parameter 10])*[Parameters].[Parameter 10]))' />
      </column>
      <column caption='Total Orders' datatype='integer' name='[Calculation_268527154041675782]' role='measure' type='quantitative'>
