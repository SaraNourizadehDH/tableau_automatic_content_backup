            <column caption='Pre-Order' datatype='boolean' name='[is_preorder]' role='dimension' type='nominal' />
            <column-instance column='[order_date]' derivation='Max' name='[max:order_date:qk]' pivot='key' type='quantitative' />
            <column caption='# OD Orders Failed to be sent to Hurrier (Vendor and Transport)' datatype='integer' name='[no_failed_orders_od_send_to_logistics]' role='measure' type='quantitative' />
