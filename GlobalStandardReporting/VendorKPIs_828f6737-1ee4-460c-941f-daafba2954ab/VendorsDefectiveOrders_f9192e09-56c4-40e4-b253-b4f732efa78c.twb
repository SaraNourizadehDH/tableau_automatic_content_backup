    <worksheet name='Long Estimated Times - Table'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#1b1b1b' fontsize='9'>Vendor Acceptance - Table</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='rps_gsr_daily_dashboard_defective_orders (rl)' name='federated.0d5lgbw0rq9an11748i1v19k4pdy' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0d5lgbw0rq9an11748i1v19k4pdy'>
            <column caption='% OD Orders PrepTime above 20min' datatype='real' name='[% OD Orders with PrepTime above 10min (copy) (copy)_812759061147377719]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_orders_od_preptime_above_c]) / SUM([no_orders_od])' />
            </column>
            <column caption='% OD Orders PrepTime above 10min' datatype='real' name='[% OD Orders with PrepTime above 10min (copy)_812759061147361334]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_orders_od_preptime_above_b]) / SUM([no_orders_od])' />
            </column>
            <column caption='% VD Orders ETA above 60min' datatype='real' name='[% VD Orders ETA above 30min (copy) (copy)_812759061153480762]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_orders_vd_eta_above_c]) / SUM([no_orders_vd])' />
            </column>
            <column caption='% VD Orders ETA above 45min' datatype='real' name='[% VD Orders ETA above 30min (copy)_812759061153464377]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_orders_vd_eta_above_b]) / SUM([no_orders_vd])' />
            </column>
            <column caption='% OD Orders PrepTime above 5min' datatype='real' name='[Calculation_2443976914003169288]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_orders_od_preptime_above_a]) / SUM([no_orders_od])' />
            </column>
            <column caption='% VD Orders ETA above 30min' datatype='real' name='[Calculation_2443976914004627466]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_orders_vd_eta_above_a]) / SUM([no_orders_vd])' />
            </column>
            <column caption='% VD Orders On Time - GoDroid (&gt;4.5.0)' datatype='real' name='[Calculation_2443976914080104462]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_orders_vd_valid_godroid_version_on_time]) / SUM([no_orders_vd_valid_godroid_version])' />
            </column>
            <column caption='% VD Orders After - GoDroid (&gt;4.5.0)' datatype='real' name='[Calculation_2443976914080735247]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_orders_vd_valid_godroid_version_after]) / SUM([no_orders_vd_valid_godroid_version])' />
            </column>
            <column caption='% VD Orders Before - GoDroid (&gt;4.5.0)' datatype='real' name='[Calculation_2443976914081099792]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_orders_vd_valid_godroid_version_before]) / SUM([no_orders_vd_valid_godroid_version])' />
            </column>
            <column caption='Date Granularity' datatype='string' name='[Calculation_4360047438739648516]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&apos;Daily&apos; THEN str([order_date])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Weekly&apos; THEN [order_week]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Monthly&apos; THEN [order_month]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Quarterly&apos; THEN str(DATE(DATETRUNC(&apos;quarter&apos;,[order_date])))&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Yearly&apos; THEN str([order_year])&#10;END' />
            </column>
            <column caption='Region Cleaned' datatype='string' name='[Calculation_4360047438756130823]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [region] = &apos;ap&apos; THEN &apos;Asia&apos; &#10;ELSEIF [region] = &apos;eu&apos; THEN &apos;Europe&apos; &#10;ELSEIF [region] = &apos;mena&apos; THEN &apos;MENA&apos;&#10;ELSEIF [region] = &apos;kr&apos; THEN &apos;Korea&apos; &#10;ELSEIF [region] = &apos;us&apos; THEN &apos;Americas&apos; &#10;END' />
            </column>
            <column caption='Brand Cleaned' datatype='string' name='[Calculation_4360047438757310472]' role='dimension' type='nominal'>
