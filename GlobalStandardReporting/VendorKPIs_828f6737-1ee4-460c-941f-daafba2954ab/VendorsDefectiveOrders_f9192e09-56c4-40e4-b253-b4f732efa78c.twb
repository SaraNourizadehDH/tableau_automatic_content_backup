            <column caption='Order Date' datatype='date' name='[order_date]' role='dimension' type='quantitative' />
            <column caption='Order Month' datatype='string' name='[order_month]' role='dimension' type='nominal' />
            <column caption='Order Week' datatype='string' name='[order_week]' role='dimension' type='nominal' />
            <column caption='Order Year' datatype='integer' name='[order_year]' role='dimension' type='quantitative' />
            <column caption='Region' datatype='string' name='[region]' role='dimension' type='nominal' />
            <column-instance column='[no_orders_declined_by_vendor]' derivation='Sum' name='[sum:no_orders_declined_by_vendor:qk]' pivot='key' type='quantitative' />
            <column-instance column='[no_orders_modified_by_vendor]' derivation='Sum' name='[sum:no_orders_modified_by_vendor:qk]' pivot='key' type='quantitative' />
            <column-instance column='[no_orders_received_by_vendor]' derivation='Sum' name='[sum:no_orders_received_by_vendor:qk]' pivot='key' type='quantitative' />
            <column-instance column='[no_orders_with_vendor_response]' derivation='Sum' name='[sum:no_orders_with_vendor_response:qk]' pivot='key' type='quantitative' />
            <column caption='Transmission Flow' datatype='string' name='[transmission_flow]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_4916875311670464537]' derivation='User' name='[usr:Calculation_4916875311670464537:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_4916875311670804506]' derivation='User' name='[usr:Calculation_4916875311670804506:qk]' pivot='key' type='quantitative' />
            <column caption='Vertical Type' datatype='string' name='[vertical_type]' role='dimension' type='nominal' />
