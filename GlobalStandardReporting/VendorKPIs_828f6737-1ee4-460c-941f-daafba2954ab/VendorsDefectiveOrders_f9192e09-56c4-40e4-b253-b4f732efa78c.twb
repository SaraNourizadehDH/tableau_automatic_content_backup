          <datasource-dependencies datasource='federated.0d5lgbw0rq9an11748i1v19k4pdy'>
            <column caption='# Failed Orders' datatype='integer' name='[# OD Orders (copy)_812759060205252611]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [status] = &apos;cancelled&apos; THEN [no_orders] ELSE NULL END' />
            </column>
            <column caption='Region Cleaned' datatype='string' name='[Calculation_4360047438756130823]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [region] = &apos;ap&apos; THEN &apos;Asia&apos; &#10;ELSEIF [region] = &apos;eu&apos; THEN &apos;Europe&apos; &#10;ELSEIF [region] = &apos;mena&apos; THEN &apos;MENA&apos;&#10;ELSEIF [region] = &apos;kr&apos; THEN &apos;Korea&apos; &#10;ELSEIF [region] = &apos;us&apos; THEN &apos;Americas&apos; &#10;END' />
            </column>
            <column caption='Brand Cleaned' datatype='string' name='[Calculation_4360047438757310472]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [brand_id] = &apos;AP&apos; THEN &apos;Appetito24&apos; &#10;ELSEIF [brand_id] = &apos;AR&apos; THEN &apos;Amrest&apos; &#10;ELSEIF [brand_id] = &apos;BK&apos; THEN &apos;Burger King&apos;&#10;ELSEIF [brand_id] = &apos;BO&apos; then &apos;Boozer&apos;&#10;ELSEIF [brand_id] = &apos;CD&apos; then &apos;Click Delivery&apos; &#10;ELSEIF [brand_id] = &apos;CG&apos; THEN &apos;Carriage&apos;&#10;ELSEIF [brand_id] = &apos;DJ&apos; THEN &apos;Damejidlo&apos;&#10;ELSEIF [brand_id] = &apos;DN&apos; THEN &apos;Donesi&apos;&#10;ELSEIF [brand_id] = &apos;EF&apos; THEN &apos;eFood&apos;&#10;ELSEIF [brand_id] = &apos;FO&apos; THEN &apos;Foodora&apos;&#10;ELSEIF [brand_id] = &apos;FOC&apos; then &apos;Talabat&apos;&#10;ELSEIF [brand_id] = &apos;FP&apos; THEN &apos;FoodPanda&apos;&#10;ELSEIF [brand_id] = &apos;HF&apos; THEN &apos;Talabat&apos;&#10;ELSEIF [brand_id] = &apos;HM&apos; THEN &apos;HipMenu&apos;&#10;ELSEIF [brand_id] = &apos;HS&apos; THEN &apos;HungerStation&apos;&#10;ELSEIF [brand_id] = &apos;KFC&apos; THEN &apos;KFC&apos;&#10;ELSEIF [brand_id] = &apos;LH&apos; THEN &apos;Lieferheld&apos;&#10;ELSEIF [brand_id] = &apos;MJM&apos; Then &apos;Mjam&apos; &#10;ELSEIF [brand_id] = &apos;NP&apos; THEN &apos;Net Pincer&apos; &#10;ELSEIF [brand_id] = &apos;ODR&apos; THEN &apos;On Demand Rider&apos; &#10;ELSEIF [brand_id] = &apos;OP&apos; Then &apos;Online Pizza&apos;&#10;ELSEIF [brand_id] = &apos;PDE&apos; THEN &apos;Pizza.de&apos;&#10;ELSEIF [brand_id] = &apos;PO&apos; THEN &apos;Pizza Online&apos;&#10;ELSEIF [brand_id] = &apos;PPP&apos; THEN &apos;Pizza Portal&apos;&#10;ELSEIF [brand_id] = &apos;PY&apos; THEN &apos;Pedidosya&apos; &#10;ELSEIF [brand_id] = &apos;PZ&apos; THEN &apos;Pauza&apos;&#10;ELSEIF [brand_id] = &apos;TB&apos; THEN &apos;Talabat&apos;&#10;ELSEIF [brand_id] = &apos;VP&apos; THEN &apos;Vapiano&apos;&#10;ELSEIF [brand_id] = &apos;WA&apos; THEN &apos;Wallmart&apos; &#10;ELSEIF [brand_id] = &apos;YO&apos; THEN &apos;YoGiYo&apos;&#10;ELSEIF [brand_id] = &apos;YS&apos; THEN &apos;Yemeksepeti&apos; &#10;ELSE [brand_id] END' />
            </column>
            <column caption='Region/Brand' datatype='string' name='[Calculation_4360047438757724169]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_4360047438756130823] + &quot; - &quot; + [Calculation_4360047438757310472]' />
            </column>
            <column caption='Brand' datatype='string' name='[brand_id]' role='dimension' type='nominal' />
            <column caption='Delivery Type' datatype='string' name='[delivery_type]' role='dimension' type='nominal' />
            <column caption='# Orders' datatype='integer' name='[no_orders]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_4360047438757724169]' derivation='None' name='[none:Calculation_4360047438757724169:nk]' pivot='key' type='nominal' />
            <column-instance column='[delivery_type]' derivation='None' name='[none:delivery_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[transmission_flow]' derivation='None' name='[none:transmission_flow:nk]' pivot='key' type='nominal' />
            <column-instance column='[vertical_type]' derivation='None' name='[none:vertical_type:nk]' pivot='key' type='nominal' />
            <column caption='Region' datatype='string' name='[region]' role='dimension' type='nominal' />
            <column caption='Order Status' datatype='string' name='[status]' role='dimension' type='nominal' />
            <column-instance column='[# OD Orders (copy)_812759060205252611]' derivation='Sum' name='[sum:# OD Orders (copy)_812759060205252611:qk]' pivot='key' type='quantitative' />
            <column caption='Transmission Flow' datatype='string' name='[transmission_flow]' role='dimension' type='nominal' />
            <column caption='Vertical Type' datatype='string' name='[vertical_type]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0d5lgbw0rq9an11748i1v19k4pdy].[none:Calculation_4360047438757724169:nk]'>
            <groupfilter function='level-members' level='[none:Calculation_4360047438757724169:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.0d5lgbw0rq9an11748i1v19k4pdy].[none:Calculation_4360047438757724169:nk]</column>
            <column>[federated.0d5lgbw0rq9an11748i1v19k4pdy].[none:delivery_type:nk]</column>
            <column>[federated.0d5lgbw0rq9an11748i1v19k4pdy].[none:vertical_type:nk]</column>
            <column>[federated.0d5lgbw0rq9an11748i1v19k4pdy].[none:transmission_flow:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='height' value='159' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Shape' />
            <mark-sizing mark-sizing-setting='marks-scaling-off' />
            <encodings>
              <lod column='[federated.0d5lgbw0rq9an11748i1v19k4pdy].[sum:# OD Orders (copy)_812759060205252611:qk]' />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run fontcolor='#1b1b1b'>The </run>
                <run bold='true' fontcolor='#1b1b1b'>Vendor Response</run>
                <run fontcolor='#1b1b1b'> tab is related to the stages of the Order Flow after the order is sent to Vendor until it gets the Vendor response: </run>
                <run bold='true' fontcolor='#1b1b1b'>Sent to Vendor &gt; Received by Vendor &gt; Responded by Vendor.</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#1b1b1b'>A Vendor response is when the Vendor either </run>
                <run bold='true' fontcolor='#1b1b1b'>accepted the order</run>
                <run fontcolor='#1b1b1b'>, </run>
                <run bold='true' fontcolor='#1b1b1b'>modified the order</run>
                <run fontcolor='#1b1b1b'> (item modification) or </run>
                <run bold='true' fontcolor='#1b1b1b'>rejected the order via the device</run>
                <run fontcolor='#1b1b1b'>.</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#000000'>For better understanding of each metric it is encouraged to check the Definitions tab, as well as our documentation in Confluence:</run>
                <run>Æ&#10;</run>
                <run fontcolor='#0000ff' fontname='Benton Sans Book' underline='true'>https://confluence.deliveryhero.com/display/CPBI/Defective+Orders</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#000000'>Any further questions/suggestions reach out to </run>
                <run fontcolor='#000000' underline='true'>rps_bi@deliveryhero.com</run>
              </formatted-text>
            </customized-tooltip>
            <style>
              <style-rule element='mark'>
                <format attr='shape' value='Info Icon/icons-information.png' />
                <format attr='size' value='2' />
              </style-rule>
              <style-rule element='pane'>
                <format attr='minheight' value='-1' />
                <format attr='maxheight' value='-1' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
      <simple-id uuid='{370D0D13-F176-48C7-80D4-7241F879234F}' />
    </worksheet>
    <worksheet name='Vendor Response - Table'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontsize='9'>Vendor Response - KPIs</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='rps_gsr_daily_dashboard_defective_orders (rl)' name='federated.0d5lgbw0rq9an11748i1v19k4pdy' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0d5lgbw0rq9an11748i1v19k4pdy'>
            <column caption='# Orders Received by Vendor (fixed)' datatype='integer' name='[# Orders Received by Vendor (copy)_812759060804173860]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({FIXED [order_date], [Calculation_4360047438756130823], [Calculation_4360047438757724169], [delivery_platform], [service], [is_preorder] : SUM([no_orders_received_by_vendor])})' />
            </column>
            <column caption='% Orders Received by Vendor above 5sec' datatype='real' name='[Calculation_3283405654018367490]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_orders_received_by_vendor_above_threshold]) / SUM([no_orders_received_by_vendor])' />
            </column>
            <column caption='% Orders with Vendor Response above 30sec' datatype='real' name='[Calculation_3283405654020866051]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_orders_with_vendor_response_above_threshold]) / SUM([no_orders_with_vendor_response])' />
            </column>
            <column caption='Date Granularity' datatype='string' name='[Calculation_4360047438739648516]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&apos;Daily&apos; THEN str([order_date])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Weekly&apos; THEN [order_week]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Monthly&apos; THEN [order_month]&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Quarterly&apos; THEN str(DATE(DATETRUNC(&apos;quarter&apos;,[order_date])))&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Yearly&apos; THEN str([order_year])&#10;END' />
            </column>
            <column caption='Region Cleaned' datatype='string' name='[Calculation_4360047438756130823]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [region] = &apos;ap&apos; THEN &apos;Asia&apos; &#10;ELSEIF [region] = &apos;eu&apos; THEN &apos;Europe&apos; &#10;ELSEIF [region] = &apos;mena&apos; THEN &apos;MENA&apos;&#10;ELSEIF [region] = &apos;kr&apos; THEN &apos;Korea&apos; &#10;ELSEIF [region] = &apos;us&apos; THEN &apos;Americas&apos; &#10;END' />
            </column>
            <column caption='Brand Cleaned' datatype='string' name='[Calculation_4360047438757310472]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [brand_id] = &apos;AP&apos; THEN &apos;Appetito24&apos; &#10;ELSEIF [brand_id] = &apos;AR&apos; THEN &apos;Amrest&apos; &#10;ELSEIF [brand_id] = &apos;BK&apos; THEN &apos;Burger King&apos;&#10;ELSEIF [brand_id] = &apos;BO&apos; then &apos;Boozer&apos;&#10;ELSEIF [brand_id] = &apos;CD&apos; then &apos;Click Delivery&apos; &#10;ELSEIF [brand_id] = &apos;CG&apos; THEN &apos;Carriage&apos;&#10;ELSEIF [brand_id] = &apos;DJ&apos; THEN &apos;Damejidlo&apos;&#10;ELSEIF [brand_id] = &apos;DN&apos; THEN &apos;Donesi&apos;&#10;ELSEIF [brand_id] = &apos;EF&apos; THEN &apos;eFood&apos;&#10;ELSEIF [brand_id] = &apos;FO&apos; THEN &apos;Foodora&apos;&#10;ELSEIF [brand_id] = &apos;FOC&apos; then &apos;Talabat&apos;&#10;ELSEIF [brand_id] = &apos;FP&apos; THEN &apos;FoodPanda&apos;&#10;ELSEIF [brand_id] = &apos;HF&apos; THEN &apos;Talabat&apos;&#10;ELSEIF [brand_id] = &apos;HM&apos; THEN &apos;HipMenu&apos;&#10;ELSEIF [brand_id] = &apos;HS&apos; THEN &apos;HungerStation&apos;&#10;ELSEIF [brand_id] = &apos;KFC&apos; THEN &apos;KFC&apos;&#10;ELSEIF [brand_id] = &apos;LH&apos; THEN &apos;Lieferheld&apos;&#10;ELSEIF [brand_id] = &apos;MJM&apos; Then &apos;Mjam&apos; &#10;ELSEIF [brand_id] = &apos;NP&apos; THEN &apos;Net Pincer&apos; &#10;ELSEIF [brand_id] = &apos;ODR&apos; THEN &apos;On Demand Rider&apos; &#10;ELSEIF [brand_id] = &apos;OP&apos; Then &apos;Online Pizza&apos;&#10;ELSEIF [brand_id] = &apos;PDE&apos; THEN &apos;Pizza.de&apos;&#10;ELSEIF [brand_id] = &apos;PO&apos; THEN &apos;Pizza Online&apos;&#10;ELSEIF [brand_id] = &apos;PPP&apos; THEN &apos;Pizza Portal&apos;&#10;ELSEIF [brand_id] = &apos;PY&apos; THEN &apos;Pedidosya&apos; &#10;ELSEIF [brand_id] = &apos;PZ&apos; THEN &apos;Pauza&apos;&#10;ELSEIF [brand_id] = &apos;TB&apos; THEN &apos;Talabat&apos;&#10;ELSEIF [brand_id] = &apos;VP&apos; THEN &apos;Vapiano&apos;&#10;ELSEIF [brand_id] = &apos;WA&apos; THEN &apos;Wallmart&apos; &#10;ELSEIF [brand_id] = &apos;YO&apos; THEN &apos;YoGiYo&apos;&#10;ELSEIF [brand_id] = &apos;YS&apos; THEN &apos;Yemeksepeti&apos; &#10;ELSE [brand_id] END' />
            </column>
            <column caption='Region/Brand' datatype='string' name='[Calculation_4360047438757724169]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_4360047438756130823] + &quot; - &quot; + [Calculation_4360047438757310472]' />
            </column>
            <column caption='% Orders Failed to transmit to Vendor (Vendor and Transport)' datatype='real' name='[Calculation_4916875311504363532]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_failed_orders_transmit_to_vendor]) / [Calculation_79657477705535490]' />
            </column>
            <column caption='% Orders Failed without Vendor response (Vendor and Transport)' datatype='real' name='[Calculation_4916875311509205006]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_failed_orders_without_vendor_response]) / [# Orders Received by Vendor (copy)_812759060804173860]' />
