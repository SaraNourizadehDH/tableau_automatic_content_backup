      <column caption='Order Status Dimension' datatype='string' name='[Cancellation Dimension OD Failed Orders (copy)_2443976914029129741]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Yes&apos; THEN [status]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;No&apos; THEN &apos;ALL&apos;&#10;END' />
